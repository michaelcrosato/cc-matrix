{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk3kzxUzZJin15j3caQj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WzvmXhFXWHDytcsfaMHGGy","name":"Bash","input":{"command":"cat > src/input/devices.js <<'EOF'\n// Every input device, read per pad. The engine merges all pads into one and has no analog triggers,\n// so pads are polled here. Keys and mouse come from ctx.input. Also tracks the last device used (for\n// prompts) and any input at all (for attract mode).\nexport const PAD = { cross: 0, circle: 1, square: 2, triangle: 3, l1: 4, r1: 5, l2: 6, r2: 7, create: 8, options: 9, l3: 10, r3: 11, up: 12, down: 13, left: 14, right: 15 };\nconst DEAD = 0.18;\n\nconst newPad = () => ({ connected: false, values: new Array(17).fill(0), down: new Array(17).fill(false), edge: new Array(17).fill(false), up: new Array(17).fill(false), axes: [0, 0, 0, 0], actuator: null, id: '' });\n\nconst NAV_KEYS = {\n  up: ['ArrowUp', 'KeyW'], down: ['ArrowDown', 'KeyS'], left: ['ArrowLeft', 'KeyA'], right: ['ArrowRight', 'KeyD'],\n};\n\nexport class Devices {\n  constructor() {\n    this.pads = [newPad(), newPad(), newPad(), newPad()];\n    this.last = 'kbm';\n    this.frame = -1;\n    this.nav = { up: false, down: false, left: false, right: false, confirm: false, back: false, tabL: false, tabR: false, start: false, more: false };\n    this.navHeld = { up: 0, down: 0, left: 0, right: 0 };\n    this.any = false;\n    this.anyPress = false;\n    this.mouseMoved = false;\n    this.px = 0;\n    this.py = 0;\n    this.lastPointer = [0, 0];\n    this.keyEvent = false;\n    this.pressEvent = false;\n    this.moveEvent = false;\n    this.listening = false;\n    this.swallow = 0;\n    this.usedPad = false;\n    this.lastPadIndex = 0;\n  }\n\n  listen() {\n    if (this.listening || typeof window === 'undefined') return;\n    this.listening = true;\n    window.addEventListener('keydown', (e) => { if (!e.repeat) { this.keyEvent = true; } }, true);\n    window.addEventListener('pointerdown', (e) => { this.pressEvent = true; if (e.pointerType === 'touch') this.touchEvent = true; }, true);\n    window.addEventListener('pointermove', () => { this.moveEvent = true; }, true);\n    window.addEventListener('wheel', () => { this.moveEvent = true; }, { capture: true, passive: true });\n  }\n\n  poll(ctx) {\n    if (ctx.engine.frame === this.frame) return;\n    this.frame = ctx.engine.frame;\n    const dt = Math.min(0.1, this.dt ?? 1 / 60);\n    const input = ctx.input;\n    const got = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads() : [];\n    let padActive = false, padPress = false;\n    for (let i = 0; i < 4; i++) {\n      const src = got[i];\n      const p = this.pads[i];\n      if (!src || !src.connected) {\n        p.connected = false;\n        p.down.fill(false); p.edge.fill(false); p.up.fill(false); p.values.fill(0); p.axes.fill(0);\n        continue;\n      }\n      p.connected = true;\n      p.id = src.id;\n      p.actuator = src.vibrationActuator ?? null;\n      for (let b = 0; b < 17; b++) {\n        const btn = src.buttons[b];\n        const v = btn ? (typeof btn === 'object' ? btn.value : btn) : 0;\n        const dn = btn ? (typeof btn === 'object' ? btn.pressed || v > 0.5 : v > 0.5) : false;\n        p.edge[b] = dn && !p.down[b];\n        p.up[b] = !dn && p.down[b];\n        p.down[b] = dn;\n        p.values[b] = v;\n        if (p.edge[b]) { padPress = true; this.lastPadIndex = i; }\n        if (v > 0.1) padActive = true;\n      }\n      for (let a = 0; a < 4; a++) {\n        const raw = src.axes[a] ?? 0;\n        p.axes[a] = Math.abs(raw) < DEAD ? 0 : raw;\n        if (p.axes[a] !== 0) padActive = true;\n      }\n    }\n    if (padActive) { this.last = 'pad'; this.usedPad = true; }\n\n    // Pointer in art pixels.\n    const hud = ctx.hud;\n    const pt = input.pointer;\n    this.px = ((pt.x + 1) / 2) * hud.width;\n    this.py = ((1 - pt.y) / 2) * hud.height;\n    this.mouseMoved = this.moveEvent && (Math.abs(this.lastPointer[0] - pt.x) > 1e-3 || Math.abs(this.lastPointer[1] - pt.y) > 1e-3 || input.wheel !== 0);\n    this.lastPointer[0] = pt.x;\n    this.lastPointer[1] = pt.y;\n    const kbmNow = this.keyEvent || (this.pressEvent && !this.touchEvent) || this.mouseMoved;\n    if (kbmNow) this.last = 'kbm';\n    this.any = padActive || this.keyEvent || this.pressEvent || this.moveEvent;\n    this.anyPress = padPress || this.keyEvent || this.pressEvent;\n    this.keyEvent = false;\n    this.pressEvent = false;\n    this.moveEvent = false;\n    this.touchEvent = false;\n\n    // Menu navigation: edges with repeat, merged from every device.\n    const heldDir = {\n      up: NAV_KEYS.up.some((k) => input.isDown(k)),\n      down: NAV_KEYS.down.some((k) => input.isDown(k)),\n      left: NAV_KEYS.left.some((k) => input.isDown(k)),\n      right: NAV_KEYS.right.some((k) => input.isDown(k)),\n    };\n    let confirm = input.wasPressed('Enter') || input.wasPressed('Space');\n    let back = input.wasPressed('Escape');\n    let tabL = input.wasPressed('KeyQ');\n    let tabR = input.wasPressed('KeyE');\n    let start = false, more = input.wasPressed('KeyM');\n    for (const p of this.pads) {\n      if (!p.connected) continue;\n      if (p.down[PAD.up] || p.axes[1] < -0.5) heldDir.up = true;\n      if (p.down[PAD.down] || p.axes[1] > 0.5) heldDir.down = true;\n      if (p.down[PAD.left] || p.axes[0] < -0.5) heldDir.left = true;\n      if (p.down[PAD.right] || p.axes[0] > 0.5) heldDir.right = true;\n      // Create + Options belongs to the hub: ignore Options while Create is held.\n      confirm = confirm || p.edge[PAD.cross];\n      back = back || p.edge[PAD.circle];\n      tabL = tabL || p.edge[PAD.l1];\n      tabR = tabR || p.edge[PAD.r1];\n      start = start || (p.edge[PAD.options] && !p.down[PAD.create]);\n      more = more || p.edge[PAD.triangle];\n    }\n    for (const k of ['up', 'down', 'left', 'right']) {\n      const was = this.navHeld[k];\n      if (heldDir[k]) {\n        this.navHeld[k] = was + dt;\n        this.nav[k] = was === 0 || (was > 0.36 && Math.floor((was - 0.36) / 0.11) !== Math.floor((was + dt - 0.36) / 0.11));\n      } else {\n        this.navHeld[k] = 0;\n        this.nav[k] = false;\n      }\n    }\n    this.nav.confirm = confirm;\n    this.nav.back = back;\n    this.nav.tabL = tabL;\n    this.nav.tabR = tabR;\n    this.nav.start = start || input.wasPressed('Escape');\n    this.nav.more = more;\n    this.click = input.wasPressed('MouseLeft');\n    this.rightClick = input.wasPressed('MouseRight');\n    this.wheel = input.wheel;\n  }\n\n  rumble(index, { strong = 0.5, weak = 0.5, ms = 120 } = {}) {\n    const p = this.pads[index ?? this.lastPadIndex];\n    if (!p?.connected || !p.actuator?.playEffect) return false;\n    try { p.actuator.playEffect('dual-rumble', { duration: ms, strongMagnitude: strong, weakMagnitude: weak }); return true; } catch { return false; }\n  }\n}\nEOF\ncat > src/input/cursor.js <<'EOF'\n// One seat's hands: reads its device(s) and produces the sim's input. Stick and keys drive the same\n// integrator; the mouse puts the tip exactly where it points, on the surface, not on a plane.\nimport { THREE } from '../../pixel-engine.js';\nimport { clamp, pathHeading } from '../core/geom.js';\nimport { TOOLS, validTargets } from '../sim/entities.js';\nimport { PAD } from './devices.js';\n\nconst o = new THREE.Vector3(), d = new THREE.Vector3();\nconst AIM = { off: { slow: 1, damp: 1 }, low: { slow: null, damp: 0.5 }, high: { slow: 0.42, damp: 0.25 } };\n\nexport class SeatControl {\n  /** @param binding 'all' (keys, mouse and every pad), 'kbm', or a pad index */\n  constructor(app, seatId, binding = 'all') {\n    this.app = app;\n    this.seatId = seatId;\n    this.binding = binding;\n    this.x = 0; this.z = 0.5;\n    this.tool = null;\n    this.lastTool = null;\n    this.table = 0;\n    this.input = { x: 0, z: 0, tool: null, use: false, force: 1, gift: false, steady: false, a: false, b: false, rot: 0, tag: false, table: 0, drop: false };\n    this.mouseAim = binding === 'all' || binding === 'kbm';\n    this.quick = null;\n    this.wheelShown = 0;\n    this.frame = -1;\n    this.rotPending = 0;\n    this.giftToggle = false;\n    this.flickArmed = true;\n    this.reminder = false;\n    this.useWas = false;\n  }\n\n  hasKbm() { return this.binding === 'all' || this.binding === 'kbm'; }\n  pads() {\n    const all = this.app.devices.pads;\n    if (this.binding === 'all') return all.filter((p) => p.connected);\n    if (typeof this.binding === 'number') return all[this.binding]?.connected ? [all[this.binding]] : [];\n    return [];\n  }\n  primaryPad() { return this.pads()[0] ?? null; }\n\n  /** Edges: once per rendered frame. Selecting tools, tables, quick actions. */\n  frameEdges(ctx, sim) {\n    if (ctx.engine.frame === this.frame) return;\n    this.frame = ctx.engine.frame;\n    const seat = sim.seats.find((s) => s.id === this.seatId);\n    if (!seat) return;\n    const input = ctx.input;\n    const kb = this.hasKbm();\n    const pads = this.pads();\n    const unlocked = sim.tools;\n    const pick = (t) => {\n      if (!t || !unlocked.includes(t)) return false;\n      if (t !== this.tool) {\n        this.lastTool = this.tool;\n        this.tool = t;\n        this.app.sfx('click', { pitch: TOOLS.indexOf(t) });\n      }\n      this.quick = null;\n      return true;\n    };\n    if (!this.tool || !unlocked.includes(this.tool)) this.tool = seat.tool;\n    const holdingFragment = seat.grab && sim.ents.find((e) => e.id === seat.grab)?.rotTo != null;\n    this.rotPending = 0;\n    // Number keys, wheel, last tool.\n    if (kb) {\n      for (let i = 0; i < 8; i++) if (input.wasPressed(`Digit${i + 1}`)) pick(TOOLS[i]);\n      if (input.wheel && !holdingFragment) {\n        const list = TOOLS.filter((t) => unlocked.includes(t));\n        const i = list.indexOf(this.tool);\n        pick(list[(i + (input.wheel > 0 ? 1 : list.length - 1)) % list.length]);\n      }\n      if (holdingFragment) {\n        if (input.wheel) this.rotPending += input.wheel * 12;\n        if (input.isDown('KeyQ')) this.rotPending -= 3;\n        if (input.isDown('KeyE')) this.rotPending += 3;\n      } else if (input.wasPressed('KeyQ')) pick(this.lastTool);\n      if (input.wasPressed('KeyF')) this.quickSyringe(unlocked);\n      if (input.wasPressed('Tab')) this.nextTable(sim, 1);\n      if (input.wasPressed('KeyE') && !holdingFragment) this.tagOrRemind(sim);\n    }\n    for (const p of pads) {\n      const rx = p.axes[2], ry = p.axes[3];\n      const mag = Math.hypot(rx, ry);\n      if (holdingFragment) {\n        this.rotPending += rx * 3.2;\n      } else if (mag > 0.6) {\n        this.wheelShown = 0.8;\n        // 8 directions, clockwise from top.\n        const a = (Math.atan2(rx, -ry) + Math.PI * 2) % (Math.PI * 2);\n        const idx = Math.round(a / (Math.PI / 4)) % 8;\n        if (TOOLS[idx] !== this.tool && unlocked.includes(TOOLS[idx])) pick(TOOLS[idx]);\n      }\n      if (p.edge[PAD.r1]) pick(this.lastTool);\n      if (p.edge[PAD.square]) this.quickSyringe(unlocked);\n      if (p.edge[PAD.left]) this.nextTable(sim, -1);\n      if (p.edge[PAD.right]) this.nextTable(sim, 1);\n      if (p.edge[PAD.triangle]) this.tagOrRemind(sim);\n    }\n    this.wheelShown = Math.max(0, this.wheelShown - (this.app.frameDt ?? 1 / 60));\n    this.tagPressed = this.tagRequest ?? false;\n    this.tagRequest = false;\n  }\n  quickSyringe(unlocked) {\n    if (!unlocked.includes('syringe')) return;\n    if (this.tool === 'syringe' && this.quick) { this.tool = this.quick; this.quick = null; return; }\n    if (this.tool !== 'syringe') { this.quick = this.tool; this.lastTool = this.tool; this.tool = 'syringe'; this.app.sfx('click'); }\n  }\n  nextTable(sim, dir) {\n    if (sim.tables.length < 2) return;\n    this.table = (this.table + dir + sim.tables.length) % sim.tables.length;\n    this.input.table = this.table;\n  }\n  tagOrRemind(sim) {\n    if (sim.def?.partner) this.tagRequest = true;\n    else this.reminder = true;\n  }\n\n  /** Per fixed step: integrate the tip and build the sim input. */\n  step(ctx, sim, view, dt) {\n    const seat = sim.seats.find((s) => s.id === this.seatId);\n    if (!seat) return this.input;\n    this.frameEdges(ctx, sim);\n    const devices = this.app.devices;\n    const input = ctx.input;\n    const kb = this.hasKbm();\n    const pads = this.pads();\n    const cfg = this.app.config;\n    const settings = this.app.save.settings;\n    const aim = AIM[settings.aimAssist] ?? AIM.low;\n\n    // Sticks and keys.\n    let sx = 0, sy = 0;\n    let usedStick = false;\n    for (const p of pads) {\n      if (p.axes[0] || p.axes[1]) { sx += p.axes[0]; sy += p.axes[1]; usedStick = true; }\n    }\n    let keyMove = false;\n    if (kb) {\n      const r = input.isDown('KeyD', 'ArrowRight'), l = input.isDown('KeyA', 'ArrowLeft'), u = input.isDown('KeyW', 'ArrowUp'), dn = input.isDown('KeyS', 'ArrowDown');\n      if (r || l || u || dn) {\n        keyMove = true;\n        sx += (r ? 0.82 : 0) - (l ? 0.82 : 0);\n        sy += (dn ? 0.82 : 0) - (u ? 0.82 : 0);\n      }\n    }\n    const mag = Math.min(1, Math.hypot(sx, sy));\n    const steady = (kb && input.isDown('ShiftLeft', 'ShiftRight')) || pads.some((p) => p.down[PAD.l1]);\n    if (mag > 0) {\n      this.mouseAim = false;\n      const dirX = sx / (Math.hypot(sx, sy) || 1), dirY = sy / (Math.hypot(sx, sy) || 1);\n      let speed = cfg.cursorSpeed * settings.cursorSpeed * mag ** 2.2 * (steady ? cfg.steadyFactor : 1);\n      // Aim assist: a little drag near a valid target; drift off a stroke is damped.\n      let slow = 1;\n      if (settings.aimAssist !== 'off') {\n        const tool = seat.tool;\n        for (const t of validTargets(sim, seat, tool)) {\n          if (Math.hypot(t.x - this.x, t.z - this.z) < 0.6) { slow = aim.slow ?? cfg.aimAssist; break; }\n        }\n      }\n      speed *= slow;\n      let vx = dirX * speed, vz = dirY * speed;\n      const cutting = seat.cutting ? sim.ents.find((e) => e.id === seat.cutting) : null;\n      if (cutting && settings.aimAssist !== 'off') {\n        const h = pathHeading(cutting.path, cutting.s);\n        const ux = Math.cos(h), uz = Math.sin(h);\n        const along = vx * ux + vz * uz;\n        const perpX = vx - ux * along, perpZ = vz - uz * along;\n        vx = ux * along + perpX * aim.damp;\n        vz = uz * along + perpZ * aim.damp;\n      }\n      this.x = clamp(this.x + vx * dt, -8, 8);\n      this.z = clamp(this.z + vz * dt, -4.5, 4.5);\n    }\n    // The mouse: exactly where it points, on the surface.\n    if (kb && devices.mouseMoved) this.mouseAim = true;\n    if (kb && this.mouseAim && view && input.pointer) {\n      const cam = ctx.camera;\n      cam.rayAt(input.pointer.x, input.pointer.y, o, d);\n      const tv = view.tableViews?.[this.table];\n      const off = tv?.offsetX ?? 0;\n      let y = 0, wx = 0, wz = 0;\n      for (let i = 0; i < 4; i++) {\n        const t = (y - o.y) / d.y;\n        wx = o.x + d.x * t;\n        wz = o.z + d.z * t;\n        y = tv ? tv.heightAt(wx - off, wz) : 0;\n      }\n      this.x = clamp(wx - off, -8, 8);\n      this.z = clamp(wz, -4.5, 4.5);\n    }\n\n    // Buttons.\n    let useV = 0;\n    for (const p of pads) {\n      useV = Math.max(useV, p.values[PAD.r2], p.down[PAD.cross] ? 1 : 0);\n    }\n    const mouseL = kb && input.isDown('MouseLeft');\n    const mouseR = kb && input.isDown('MouseRight');\n    const j = kb && input.isDown('KeyJ'), k = kb && input.isDown('KeyK');\n    let use = useV > 0.12 || mouseL || j;\n    const force = mouseL || j ? 1 : Math.max(0.35, Math.min(1, useV * 1.15));\n    const drop = mouseR || k || pads.some((p) => p.down[PAD.circle]);\n    if (drop) use = false;\n    // Paddles and massage: both sides.\n    const a = pads.some((p) => p.values[PAD.l2] > 0.4) || mouseL || j;\n    const b = pads.some((p) => p.values[PAD.r2] > 0.4) || mouseR || k;\n    // Gift.\n    let gift = (kb && input.isDown('Space')) || pads.some((p) => p.values[PAD.l2] > 0.4);\n    if (settings.giftMode === 'toggle' && seat.gift === 'quiet') {\n      const edge = gift && !this.giftWasRaw;\n      this.giftWasRaw = gift;\n      if (edge) this.giftToggle = !this.giftToggle;\n      if (!sim.quiet && !edge && this.giftToggle && sim.composure < 20) this.giftToggle = false;\n      gift = this.giftToggle;\n    }\n    // Quick syringe: back to the old tool once the dose has been given.\n    if (this.quick && this.useWas && !use && this.tool === 'syringe') { this.tool = this.quick; this.quick = null; }\n    this.useWas = use;\n\n    const inp = this.input;\n    inp.x = this.x; inp.z = this.z;\n    inp.tool = this.tool;\n    inp.use = use;\n    inp.force = force;\n    inp.gift = gift;\n    inp.steady = steady;\n    inp.a = a;\n    inp.b = b;\n    inp.rot = this.rotPending;\n    inp.table = this.table;\n    inp.tag = this.tagPressed ?? false;\n    inp.drop = drop;\n    if (keyMove || usedStick) this.mouseAim = false;\n    return inp;\n  }\n\n  syncFromSeat(seat) {\n    this.x = seat.x;\n    this.z = seat.z;\n    this.tool = seat.tool;\n    this.table = seat.table;\n  }\n}\nEOF\ncat > src/content/icons.js <<'EOF'\n// Pixel-art HUD icons as data: the tool wheel and the button glyphs.\nexport const TOOL_ICONS = {\n  scalpel: { rows: ['..........w.', '.........wwm', '........wwm.', '.......wwm..', '......wwm...', '.....ssm....', '....ssm.....', '...ssm......', '..ssm.......', '.ssm........', 'ssm.........', '.m..........'], c: { w: 'white', m: 'mist', s: 'slate' } },\n  forceps: { rows: ['..m......m..', '..m......m..', '..mm....mm..', '...m....m...', '...mm..mm...', '....m..m....', '....mmmm....', '....ssss....', '.....ss.....', '.....ss.....', '.....ss.....', '.....ww.....'], c: { m: 'mist', s: 'slate', w: 'white' } },\n  suture: { rows: ['.....wwww...', '...ww....w..', '..w.......w.', '.w........w.', '.w.......w..', '.b......m...', '.b.....mm...', '..b...mm....', '..bb.mm.....', '....mm......', '...mm.......', '..mm........'], c: { w: 'white', b: 'sky', m: 'mist' } },\n  drain: { rows: ['..........nn', '.........nn.', '........nn..', '.......ss...', '......ss....', '.....ss.....', '....ss......', '...sws......', '..sws.......', '.wws........', 'www.........', '.w..........'], c: { w: 'white', s: 'sky', n: 'navy' } },\n  syringe: { rows: ['...........w', '..........w.', '.......mmw..', '......mccm..', '.....mccm...', '....mccm....', '...mccm.....', '..mmcm......', '.mm.mm......', 'mm..........', 'w...........', '............'], c: { w: 'white', m: 'mist', c: 'cyan' } },\n  gel: { rows: ['.....tt.....', '.....tt.....', '....tttt....', '...tttttt...', '...llllll...', '..llllllll..', '..lwwwwwll..', '..lwwwwwll..', '..lwwwwwll..', '..llllllll..', '..llllllll..', '...llllll...'], c: { t: 'teal', l: 'lime', w: 'white' } },\n  laser: { rows: ['r...........', 'rr..........', '.ro.........', '..oo........', '...nn.......', '....nn......', '.....nn.....', '......nn....', '.......nn...', '........nn..', '.........nn.', '..........nn'], c: { r: 'red', o: 'orange', n: 'mist' } },\n  scanner: { rows: ['...cccccc...', '..c......c..', '.c..c.....c.', '.c...c....c.', '.c....c...c.', '.c........c.', '..c......c..', '...cccccc...', '.....mm.....', '.....mm.....', '.....ss.....', '.....ss.....'], c: { c: 'cyan', m: 'mist', s: 'slate' } },\n  dressing: { rows: ['............', '...wwwwww...', '..wwwwwwww..', '.wwmmmmmmww.', '.wwm....mww.', '.wwm....mww.', '.wwm....mww.', '.wwmmmmmmww.', '..wwwwwwww..', '...wwwwwwww.', '..........ww', '............'], c: { w: 'white', m: 'mist' } },\n};\n\nconst C = { o: 'ink', x: 'white' };\nconst SHAPE = {\n  cross: ['..ooooo..', '.ooooooo.', 'ooxoooxoo', 'oooxoxooo', 'ooooxoooo', 'oooxoxooo', 'ooxoooxoo', '.ooooooo.', '..ooooo..'],\n  circle: ['..ooooo..', '.ooooooo.', 'oooxxxooo', 'ooxoooxoo', 'ooxoooxoo', 'ooxoooxoo', 'oooxxxooo', '.ooooooo.', '..ooooo..'],\n  square: ['..ooooo..', '.ooooooo.', 'ooxxxxxoo', 'ooxoooxoo', 'ooxoooxoo', 'ooxoooxoo', 'ooxxxxxoo', '.ooooooo.', '..ooooo..'],\n  triangle: ['..ooooo..', '.oooxooo.', 'oooxoxooo', 'oooxoxooo', 'ooxoooxoo', 'ooxoooxoo', 'oxxxxxxxo', '.ooooooo.', '..ooooo..'],\n  disc: ['..ooooo..', '.ooooooo.', 'ooooooooo', 'ooooooooo', 'ooooooooo', 'ooooooooo', 'ooooooooo', '.ooooooo.', '..ooooo..'],\n  dpad: ['...ooo...', '...oxo...', '...oxo...', 'oooooooo.', 'oxxxxxxo.', 'oooooooo.', '...oxo...', '...oxo...', '...ooo...'],\n  mouseL: ['..ooooo..', '.oxxoeeo.', '.oxxoeeo.', '.oxxoeeo.', '.ooooooo.', '.oeeeeeo.', '.oeeeeeo.', '.oeeeeeo.', '..ooooo..'],\n  mouseR: ['..ooooo..', '.oeeoxxo.', '.oeeoxxo.', '.oeeoxxo.', '.ooooooo.', '.oeeeeeo.', '.oeeeeeo.', '.oeeeeeo.', '..ooooo..'],\n  mouseM: ['..ooooo..', '.oeexeeo.', '.oeexeeo.', '.oeexeeo.', '.ooooooo.', '.oeeeeeo.', '.oeeeeeo.', '.oeeeeeo.', '..ooooo..'],\n};\nexport const GLYPHS = {\n  // PlayStation.\n  CROSS: { sprite: SHAPE.cross, c: { ...C, x: 0x7ab8ff } },\n  CIRCLE: { sprite: SHAPE.circle, c: { ...C, x: 0xff6b6b } },\n  SQUARE: { sprite: SHAPE.square, c: { ...C, x: 0xff9edb } },\n  TRIANGLE: { sprite: SHAPE.triangle, c: { ...C, x: 0x5fe0b0 } },\n  L1: { pill: 'L1' }, R1: { pill: 'R1' }, L2: { pill: 'L2' }, R2: { pill: 'R2' }, OPTIONS: { pill: 'OPT' },\n  // Xbox.\n  A: { sprite: SHAPE.disc, c: { o: 0x2f9e44 }, letter: 'A' }, B: { sprite: SHAPE.disc, c: { o: 0xd9363e }, letter: 'B' }, X: { sprite: SHAPE.disc, c: { o: 0x3b6fd9 }, letter: 'X' }, Y: { sprite: SHAPE.disc, c: { o: 0xd9a400 }, letter: 'Y' },\n  LB: { pill: 'LB' }, RB: { pill: 'RB' }, LT: { pill: 'LT' }, RT: { pill: 'RT' }, MENU: { pill: 'MENU' },\n  // Both.\n  LS: { pill: 'LS' }, RS: { pill: 'RS' }, DPAD: { sprite: SHAPE.dpad, c: { o: 'ink', x: 'white' } },\n  // Mouse.\n  LMB: { sprite: SHAPE.mouseL, c: { o: 'ink', x: 'sand', e: 'mist' } }, RMB: { sprite: SHAPE.mouseR, c: { o: 'ink', x: 'sand', e: 'mist' } }, WHEEL: { sprite: SHAPE.mouseM, c: { o: 'ink', x: 'sand', e: 'mist' } },\n};\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// Prompts follow the last input used: PlayStation glyphs (or Xbox, by setting) for the controller,\n// keycaps and mouse icons for keyboard and mouse. Data text carries tokens; nothing hardcodes a button.\nconst PAD_PS = { use: ['R2'], tool: ['RS'], gift: ['L2'], steady: ['L1'], confirm: ['CROSS'], back: ['CIRCLE'], drop: ['CIRCLE'], syringe: ['SQUARE'], table: ['DPAD'], tag: ['TRIANGLE'], rotate: ['RS'], last: ['R1'], paddles: ['L2', 'R2'], left: ['L2'], right: ['R2'], pause: ['OPTIONS'], remind: ['TRIANGLE'], more: ['TRIANGLE'], tabs: ['L1', 'R1'], move: ['LS'], skip: ['TRIANGLE'] };\nconst XB = { CROSS: 'A', CIRCLE: 'B', SQUARE: 'X', TRIANGLE: 'Y', L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', OPTIONS: 'MENU' };\nconst KBM = { use: ['LMB'], tool: ['KEY:1-8'], gift: ['KEY:SPACE'], steady: ['KEY:SHIFT'], confirm: ['KEY:ENTER'], back: ['KEY:ESC'], drop: ['RMB'], syringe: ['KEY:F'], table: ['KEY:TAB'], tag: ['KEY:E'], rotate: ['WHEEL'], last: ['KEY:Q'], paddles: ['LMB', 'RMB'], left: ['LMB'], right: ['RMB'], pause: ['KEY:ESC'], remind: ['KEY:E'], more: ['KEY:M'], tabs: ['KEY:Q', 'KEY:E'], move: ['KEY:WASD'], skip: ['KEY:ESC'] };\n\nexport const TOKENS = Object.keys(PAD_PS);\n\nexport function glyphsFor(action, device, glyphStyle) {\n  if (device === 'pad') {\n    const g = PAD_PS[action];\n    if (!g) return null;\n    return glyphStyle === 'xbox' ? g.map((id) => XB[id] ?? id) : g;\n  }\n  return KBM[action] ?? null;\n}\nEOF\ncat > src/ui/hud.js <<'EOF'\n// Everything on the HUD canvas goes through here: wrap, rich text with *highlights* and {button} tokens,\n// glyphs, panels, the 10-foot clipboard motif, and pointer hit tests.\nimport { GLYPHS } from '../content/icons.js';\nimport { glyphsFor } from './prompts.js';\n\nconst TOKEN = /\\{([a-z]+)\\}/g;\n\nexport class UI {\n  constructor(app, ctx) {\n    this.app = app;\n    this.ctx = ctx;\n    this.hud = ctx.hud;\n  }\n  get w() { return this.hud.width; }\n  get h() { return this.hud.height; }\n  get device() { return this.app.devices.last; }\n  get glyphStyle() { return this.app.save.settings.glyphs; }\n\n  text(x, y, s, o = {}) { this.hud.text(Math.round(x), Math.round(y), s, o); }\n  center(y, s, o = {}) {\n    const m = this.hud.measure(s, o.scale ?? 1);\n    this.hud.text(Math.round((this.w - m.width) / 2), Math.round(y), s, o);\n  }\n  right(x, y, s, o = {}) {\n    const m = this.hud.measure(s, o.scale ?? 1);\n    this.hud.text(Math.round(x - m.width), Math.round(y), s, o);\n  }\n  rect(x, y, w, h, c) { this.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), c); }\n  outline(x, y, w, h, c, t = 1) {\n    this.rect(x, y, w, t, c); this.rect(x, y + h - t, w, t, c); this.rect(x, y, t, h, c); this.rect(x + w - t, y, t, h, c);\n  }\n  panel(x, y, w, h, fill = 'night', border = 'mist') {\n    this.rect(x + 2, y + 2, w, h, 'ink');\n    this.rect(x, y, w, h, fill);\n    this.outline(x, y, w, h, border);\n  }\n  /** The clipboard: the game's chart and rubber-stamp motif instead of tables of data. */\n  clipboard(x, y, w, h) {\n    this.rect(x + 3, y + 3, w, h, 'ink');\n    this.rect(x, y, w, h, 0xe9e1cc);\n    this.outline(x, y, w, h, 0x8a7a5a);\n    this.rect(x, y, w, 6, 0x6d5a3a);\n    this.rect(x + w / 2 - 22, y - 5, 44, 11, 'slate');\n    this.outline(x + w / 2 - 22, y - 5, 44, 11, 'mist');\n    this.rect(x + w / 2 - 12, y - 2, 24, 3, 'white');\n  }\n  stamp(cx, cy, label, color, scale = 3) {\n    const m = this.hud.measure(label, scale);\n    const pad = 4;\n    const x = cx - m.width / 2 - pad, y = cy - m.height / 2 - pad, w = m.width + pad * 2, h = m.height + pad * 2;\n    this.outline(x, y, w, h, color, 2);\n    this.text(cx - m.width / 2, cy - m.height / 2, label, { color, scale, shadow: false });\n  }\n  hit(x, y, w, h) {\n    const d = this.app.devices;\n    return d.px >= x && d.px < x + w && d.py >= y && d.py < y + h;\n  }\n\n  // ------------------------------------------------------------ Glyphs\n  glyphWidth(id) {\n    if (id.startsWith('KEY:')) return this.hud.measure(id.slice(4), 1).width + 6;\n    const g = GLYPHS[id];\n    if (!g) return 0;\n    if (g.pill) return this.hud.measure(g.pill, 1).width + 6;\n    return 9;\n  }\n  glyph(x, y, id) {\n    x = Math.round(x); y = Math.round(y);\n    if (id.startsWith('KEY:')) {\n      const label = id.slice(4);\n      const w = this.glyphWidth(id);\n      this.rect(x, y, w, 9, 'mist');\n      this.rect(x, y + 8, w, 1, 'slate');\n      this.rect(x + 1, y + 1, w - 2, 7, 'white');\n      this.text(x + 3, y + 1, label, { color: 'ink', shadow: false });\n      return w;\n    }\n    const g = GLYPHS[id];\n    if (!g) return 0;\n    if (g.pill) {\n      const w = this.glyphWidth(id);\n      this.rect(x, y, w, 9, 'ink');\n      this.outline(x, y, w, 9, 'mist');\n      this.text(x + 3, y + 1, g.pill, { color: 'white', shadow: false });\n      return w;\n    }\n    this.hud.sprite(x, y, g.sprite, g.c);\n    if (g.letter) this.text(x + 2, y + 1, g.letter, { color: 'white', shadow: false });\n    return 9;\n  }\n  /** Draw an action's glyphs. Returns width. */\n  action(x, y, name) {\n    const list = glyphsFor(name, this.device, this.glyphStyle);\n    if (!list) return 0;\n    let cx = x;\n    list.forEach((id, i) => {\n      if (i) { this.text(cx, y + 1, '+', { color: 'white' }); cx += 7; }\n      cx += this.glyph(cx, y, id) + 1;\n    });\n    return cx - x - 1;\n  }\n  actionWidth(name) {\n    const list = glyphsFor(name, this.device, this.glyphStyle);\n    if (!list) return 0;\n    return list.reduce((a, id, i) => a + (i ? 7 : 0) + this.glyphWidth(id) + 1, -1);\n  }\n\n  // ------------------------------------------------------------ Rich text\n  /** Split into runs: { t: text, hi: bool } | { action: name } */\n  runs(str) {\n    const out = [];\n    let hi = false;\n    let last = 0;\n    const flush = (seg) => {\n      if (!seg) return;\n      const parts = seg.split('*');\n      parts.forEach((p, i) => {\n        if (i > 0) hi = !hi;\n        if (p) out.push({ t: p, hi });\n      });\n    };\n    str.replace(TOKEN, (m, name, idx) => {\n      flush(str.slice(last, idx));\n      out.push({ action: name });\n      last = idx + m.length;\n      return m;\n    });\n    flush(str.slice(last));\n    return out;\n  }\n  widthOf(str, scale = 1) {\n    let w = 0;\n    for (const r of this.runs(str)) w += r.action ? this.actionWidth(r.action) * scale : this.hud.measure(r.t, scale).width;\n    return w;\n  }\n  /** Greedy wrap that keeps tokens and highlights whole. */\n  wrap(str, maxW, scale = 1) {\n    const words = str.split(' ');\n    const lines = [];\n    let cur = '';\n    let hiOpen = false;\n    for (const word of words) {\n      const test = cur ? `${cur} ${word}` : word;\n      if (this.widthOf(test.replace(/\\*/g, ''), scale) > maxW && cur) {\n        lines.push(hiOpen ? `*${cur}` : cur);\n        const stars = (cur.match(/\\*/g) ?? []).length;\n        if (stars % 2) hiOpen = !hiOpen;\n        cur = word;\n      } else cur = test;\n    }\n    if (cur) lines.push(hiOpen ? `*${cur}` : cur);\n    return lines;\n  }\n  /** Rich text at (x, y). `chars` limits how many characters show (typewriter). Returns width. */\n  rich(x, y, str, o = {}) {\n    const color = o.color ?? 'white', hiColor = o.hi ?? 'sand', scale = o.scale ?? 1, shadow = o.shadow;\n    let cx = Math.round(x);\n    let left = o.chars ?? Infinity;\n    const lineH = this.hud.measure('A', scale).height;\n    for (const r of this.runs(str)) {\n      if (left <= 0) break;\n      if (r.action) {\n        const gw = this.actionWidth(r.action);\n        this.action(cx, Math.round(y + (lineH - 9) / 2), r.action);\n        cx += gw;\n        left -= 1;\n        continue;\n      }\n      const shown = left >= r.t.length ? r.t : r.t.slice(0, left);\n      left -= r.t.length;\n      const opts = { color: r.hi ? hiColor : color, scale };\n      if (shadow !== undefined) opts.shadow = shadow;\n      this.text(cx, y, shown, opts);\n      cx += this.hud.measure(r.t, scale).width;\n    }\n    return cx - x;\n  }\n  richCenter(y, str, o = {}) {\n    const w = this.widthOf(str, o.scale ?? 1);\n    return this.rich((this.w - w) / 2, y, str, o);\n  }\n  /** A row of [action, label] hints along the bottom. */\n  hints(list, y = null, align = 'right') {\n    const yy = y ?? this.h - 11;\n    let total = 0;\n    for (const [action, label] of list) total += this.actionWidth(action) + 3 + this.hud.measure(label, 1).width + 8;\n    let x = align === 'right' ? this.w - total - 2 : align === 'center' ? (this.w - total) / 2 : 6;\n    for (const [action, label] of list) {\n      x += this.action(x, yy, action) + 3;\n      this.text(x, yy + 1, label, { color: 'white' });\n      x += this.hud.measure(label, 1).width + 8;\n    }\n  }\n}\nEOF\ncat > src/ui/menu.js <<'EOF'\n// A vertical list you can drive with a pad, keys or a mouse: big focused item, bright marker, no tables.\nexport class Menu {\n  /**\n   * @param items [{ label, value?: ()=>string, onConfirm?, onLeft?, onRight?, disabled?, blurb? }]\n   */\n  constructor(app, items, o = {}) {\n    this.app = app;\n    this.items = items;\n    this.i = o.start ?? 0;\n    this.top = 0;\n    this.rows = o.rows ?? 8;\n    this.onBack = o.onBack ?? null;\n    this.rowH = o.rowH ?? 15;\n    this.scale = o.scale ?? 1;\n    this.x = o.x;\n    this.y = o.y ?? 60;\n    this.w = o.w ?? 240;\n    this.sound = o.sound ?? true;\n    this.fixFocus();\n  }\n  fixFocus() {\n    if (!this.items.length) return;\n    let guard = 0;\n    while (this.items[this.i]?.disabled && guard++ < this.items.length) this.i = (this.i + 1) % this.items.length;\n  }\n  move(dir) {\n    const n = this.items.length;\n    let k = this.i;\n    for (let g = 0; g < n; g++) {\n      k = (k + dir + n) % n;\n      if (!this.items[k].disabled) break;\n    }\n    if (k !== this.i) { this.i = k; this.app.sfx('uiMove'); }\n    this.keepVisible();\n  }\n  keepVisible() {\n    if (this.i < this.top) this.top = this.i;\n    if (this.i >= this.top + this.rows) this.top = this.i - this.rows + 1;\n  }\n  update(ui) {\n    const nav = this.app.devices.nav;\n    const dev = this.app.devices;\n    if (nav.up) this.move(-1);\n    if (nav.down) this.move(1);\n    const item = this.items[this.i];\n    if (item) {\n      if (nav.left && item.onLeft) { item.onLeft(); this.app.sfx('uiMove'); }\n      if (nav.right && item.onRight) { item.onRight(); this.app.sfx('uiMove'); }\n      if (nav.confirm && item.onConfirm && !item.disabled) { this.app.sfx('uiConfirm'); item.onConfirm(); return; }\n    }\n    if (nav.back && this.onBack) { this.app.sfx('uiBack'); this.onBack(); return; }\n    if (dev.rightClick && this.onBack) { this.app.sfx('uiBack'); this.onBack(); return; }\n    if (dev.wheel) {\n      if (this.items.length > this.rows) {\n        this.top = Math.max(0, Math.min(this.items.length - this.rows, this.top + (dev.wheel > 0 ? 1 : -1)));\n        if (this.i < this.top) this.i = this.top;\n        if (this.i >= this.top + this.rows) this.i = this.top + this.rows - 1;\n      }\n    }\n    // Mouse: hover moves focus, click confirms.\n    const x = this.xPos(ui);\n    const end = Math.min(this.items.length, this.top + this.rows);\n    for (let k = this.top; k < end; k++) {\n      const y = this.y + (k - this.top) * this.rowH;\n      if (ui.hit(x - 6, y - 3, this.w + 12, this.rowH)) {\n        const it = this.items[k];\n        if (dev.mouseMoved && !it.disabled && this.i !== k) { this.i = k; this.app.sfx('uiMove'); }\n        if (dev.click && !it.disabled) {\n          this.i = k;\n          if (it.onConfirm) { this.app.sfx('uiConfirm'); it.onConfirm(); return; }\n          if (it.onRight) {\n            // Click the left or right half to step a value.\n            if (dev.px < x + this.w / 2 && it.onLeft) it.onLeft(); else it.onRight();\n            this.app.sfx('uiMove');\n            return;\n          }\n        }\n      }\n    }\n  }\n  xPos(ui) { return this.x ?? (ui.w - this.w) / 2; }\n  draw(ui) {\n    const x = this.xPos(ui);\n    const end = Math.min(this.items.length, this.top + this.rows);\n    for (let k = this.top; k < end; k++) {\n      const it = this.items[k];\n      const y = this.y + (k - this.top) * this.rowH;\n      const focus = k === this.i;\n      if (focus) {\n        ui.rect(x - 6, y - 3, this.w + 12, this.rowH - 1, 'navy');\n        ui.outline(x - 6, y - 3, this.w + 12, this.rowH - 1, 'sand');\n        ui.rect(x - 11, y - 3, 3, this.rowH - 1, 'sand');\n      }\n      const color = it.disabled ? 'slate' : focus ? 'sand' : 'white';\n      ui.text(x, y, it.label, { color, scale: this.scale });\n      if (it.value) {\n        const v = it.value();\n        const vw = ui.hud.measure(v, this.scale).width;\n        const right = x + this.w;\n        ui.text(right - vw - (focus ? 8 : 0), y, v, { color: focus ? 'white' : 'mist', scale: this.scale });\n        if (focus && (it.onLeft || it.onRight)) {\n          ui.text(right - vw - 16, y, '<', { color: 'sand', scale: this.scale });\n          ui.text(right - 5, y, '>', { color: 'sand', scale: this.scale });\n        }\n      }\n    }\n    if (this.top > 0) ui.center(this.y - 11, '- MORE -', { color: 'mist' });\n    if (end < this.items.length) ui.center(this.y + this.rows * this.rowH - 2, '- MORE -', { color: 'mist' });\n    const cur = this.items[this.i];\n    if (cur?.blurb) {\n      const lines = ui.wrap(cur.blurb, ui.w - 40);\n      lines.slice(0, 2).forEach((l, n) => ui.richCenter(this.y + Math.min(this.items.length, this.rows) * this.rowH + 6 + n * 10, l, { color: 'mist' }));\n    }\n  }\n}\nEOF\necho ok","description":"Write input, prompts, HUD toolkit and menu widget"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9698,"cache_read_input_tokens":360287,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9698},"output_tokens":51,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"270eb7dc-aee7-4510-a829-175045ffc1f5","timestamp":"2026-11-05T15:53:41.213Z","request_id":"req_011Cgk3kzYBfJKJuEhJS3q4G","wire_tool_inputs":{"toolu_01WzvmXhFXWHDytcsfaMHGGy":{"command":"cat > src/input/devices.js <<'EOF'\n// Every input device, read per pad. The engine merges all pads into one and has no analog triggers,\n// so pads are polled here. Keys and mouse come from ctx.input. Also tracks the last device used (for\n// prompts) and any input at all (for attract mode).\nexport const PAD = { cross: 0, circle: 1, square: 2, triangle: 3, l1: 4, r1: 5, l2: 6, r2: 7, create: 8, options: 9, l3: 10, r3: 11, up: 12, down: 13, left: 14, right: 15 };\nconst DEAD = 0.18;\n\nconst newPad = () => ({ connected: false, values: new Array(17).fill(0), down: new Array(17).fill(false), edge: new Array(17).fill(false), up: new Array(17).fill(false), axes: [0, 0, 0, 0], actuator: null, id: '' });\n\nconst NAV_KEYS = {\n  up: ['ArrowUp', 'KeyW'], down: ['ArrowDown', 'KeyS'], left: ['ArrowLeft', 'KeyA'], right: ['ArrowRight', 'KeyD'],\n};\n\nexport class Devices {\n  constructor() {\n    this.pads = [newPad(), newPad(), newPad(), newPad()];\n    this.last = 'kbm';\n    this.frame = -1;\n    this.nav = { up: false, down: false, left: false, right: false, confirm: false, back: false, tabL: false, tabR: false, start: false, more: false };\n    this.navHeld = { up: 0, down: 0, left: 0, right: 0 };\n    this.any = false;\n    this.anyPress = false;\n    this.mouseMoved = false;\n    this.px = 0;\n    this.py = 0;\n    this.lastPointer = [0, 0];\n    this.keyEvent = false;\n    this.pressEvent = false;\n    this.moveEvent = false;\n    this.listening = false;\n    this.swallow = 0;\n    this.usedPad = false;\n    this.lastPadIndex = 0;\n  }\n\n  listen() {\n    if (this.listening || typeof window === 'undefined') return;\n    this.listening = true;\n    window.addEventListener('keydown', (e) => { if (!e.repeat) { this.keyEvent = true; } }, true);\n    window.addEventListener('pointerdown', (e) => { this.pressEvent = true; if (e.pointerType === 'touch') this.touchEvent = true; }, true);\n    window.addEventListener('pointermove', () => { this.moveEvent = true; }, true);\n    window.addEventListener('wheel', () => { this.moveEvent = true; }, { capture: true, passive: true });\n  }\n\n  poll(ctx) {\n    if (ctx.engine.frame === this.frame) return;\n    this.frame = ctx.engine.frame;\n    const dt = Math.min(0.1, this.dt ?? 1 / 60);\n    const input = ctx.input;\n    const got = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads() : [];\n    let padActive = false, padPress = false;\n    for (let i = 0; i < 4; i++) {\n      const src = got[i];\n      const p = this.pads[i];\n      if (!src || !src.connected) {\n        p.connected = false;\n        p.down.fill(false); p.edge.fill(false); p.up.fill(false); p.values.fill(0); p.axes.fill(0);\n        continue;\n      }\n      p.connected = true;\n      p.id = src.id;\n      p.actuator = src.vibrationActuator ?? null;\n      for (let b = 0; b < 17; b++) {\n        const btn = src.buttons[b];\n        const v = btn ? (typeof btn === 'object' ? btn.value : btn) : 0;\n        const dn = btn ? (typeof btn === 'object' ? btn.pressed || v > 0.5 : v > 0.5) : false;\n        p.edge[b] = dn && !p.down[b];\n        p.up[b] = !dn && p.down[b];\n        p.down[b] = dn;\n        p.values[b] = v;\n        if (p.edge[b]) { padPress = true; this.lastPadIndex = i; }\n        if (v > 0.1) padActive = true;\n      }\n      for (let a = 0; a < 4; a++) {\n        const raw = src.axes[a] ?? 0;\n        p.axes[a] = Math.abs(raw) < DEAD ? 0 : raw;\n        if (p.axes[a] !== 0) padActive = true;\n      }\n    }\n    if (padActive) { this.last = 'pad'; this.usedPad = true; }\n\n    // Pointer in art pixels.\n    const hud = ctx.hud;\n    const pt = input.pointer;\n    this.px = ((pt.x + 1) / 2) * hud.width;\n    this.py = ((1 - pt.y) / 2) * hud.height;\n    this.mouseMoved = this.moveEvent && (Math.abs(this.lastPointer[0] - pt.x) > 1e-3 || Math.abs(this.lastPointer[1] - pt.y) > 1e-3 || input.wheel !== 0);\n    this.lastPointer[0] = pt.x;\n    this.lastPointer[1] = pt.y;\n    const kbmNow = this.keyEvent || (this.pressEvent && !this.touchEvent) || this.mouseMoved;\n    if (kbmNow) this.last = 'kbm';\n    this.any = padActive || this.keyEvent || this.pressEvent || this.moveEvent;\n    this.anyPress = padPress || this.keyEvent || this.pressEvent;\n    this.keyEvent = false;\n    this.pressEvent = false;\n    this.moveEvent = false;\n    this.touchEvent = false;\n\n    // Menu navigation: edges with repeat, merged from every device.\n    const heldDir = {\n      up: NAV_KEYS.up.some((k) => input.isDown(k)),\n      down: NAV_KEYS.down.some((k) => input.isDown(k)),\n      left: NAV_KEYS.left.some((k) => input.isDown(k)),\n      right: NAV_KEYS.right.some((k) => input.isDown(k)),\n    };\n    let confirm = input.wasPressed('Enter') || input.wasPressed('Space');\n    let back = input.wasPressed('Escape');\n    let tabL = input.wasPressed('KeyQ');\n    let tabR = input.wasPressed('KeyE');\n    let start = false, more = input.wasPressed('KeyM');\n    for (const p of this.pads) {\n      if (!p.connected) continue;\n      if (p.down[PAD.up] || p.axes[1] < -0.5) heldDir.up = true;\n      if (p.down[PAD.down] || p.axes[1] > 0.5) heldDir.down = true;\n      if (p.down[PAD.left] || p.axes[0] < -0.5) heldDir.left = true;\n      if (p.down[PAD.right] || p.axes[0] > 0.5) heldDir.right = true;\n      // Create + Options belongs to the hub: ignore Options while Create is held.\n      confirm = confirm || p.edge[PAD.cross];\n      back = back || p.edge[PAD.circle];\n      tabL = tabL || p.edge[PAD.l1];\n      tabR = tabR || p.edge[PAD.r1];\n      start = start || (p.edge[PAD.options] && !p.down[PAD.create]);\n      more = more || p.edge[PAD.triangle];\n    }\n    for (const k of ['up', 'down', 'left', 'right']) {\n      const was = this.navHeld[k];\n      if (heldDir[k]) {\n        this.navHeld[k] = was + dt;\n        this.nav[k] = was === 0 || (was > 0.36 && Math.floor((was - 0.36) / 0.11) !== Math.floor((was + dt - 0.36) / 0.11));\n      } else {\n        this.navHeld[k] = 0;\n        this.nav[k] = false;\n      }\n    }\n    this.nav.confirm = confirm;\n    this.nav.back = back;\n    this.nav.tabL = tabL;\n    this.nav.tabR = tabR;\n    this.nav.start = start || input.wasPressed('Escape');\n    this.nav.more = more;\n    this.click = input.wasPressed('MouseLeft');\n    this.rightClick = input.wasPressed('MouseRight');\n    this.wheel = input.wheel;\n  }\n\n  rumble(index, { strong = 0.5, weak = 0.5, ms = 120 } = {}) {\n    const p = this.pads[index ?? this.lastPadIndex];\n    if (!p?.connected || !p.actuator?.playEffect) return false;\n    try { p.actuator.playEffect('dual-rumble', { duration: ms, strongMagnitude: strong, weakMagnitude: weak }); return true; } catch { return false; }\n  }\n}\nEOF\ncat > src/input/cursor.js <<'EOF'\n// One seat's hands: reads its device(s) and produces the sim's input. Stick and keys drive the same\n// integrator; the mouse puts the tip exactly where it points, on the surface, not on a plane.\nimport { THREE } from '../../pixel-engine.js';\nimport { clamp, pathHeading } from '../core/geom.js';\nimport { TOOLS, validTargets } from '../sim/entities.js';\nimport { PAD } from './devices.js';\n\nconst o = new THREE.Vector3(), d = new THREE.Vector3();\nconst AIM = { off: { slow: 1, damp: 1 }, low: { slow: null, damp: 0.5 }, high: { slow: 0.42, damp: 0.25 } };\n\nexport class SeatControl {\n  /** @param binding 'all' (keys, mouse and every pad), 'kbm', or a pad index */\n  constructor(app, seatId, binding = 'all') {\n    this.app = app;\n    this.seatId = seatId;\n    this.binding = binding;\n    this.x = 0; this.z = 0.5;\n    this.tool = null;\n    this.lastTool = null;\n    this.table = 0;\n    this.input = { x: 0, z: 0, tool: null, use: false, force: 1, gift: false, steady: false, a: false, b: false, rot: 0, tag: false, table: 0, drop: false };\n    this.mouseAim = binding === 'all' || binding === 'kbm';\n    this.quick = null;\n    this.wheelShown = 0;\n    this.frame = -1;\n    this.rotPending = 0;\n    this.giftToggle = false;\n    this.flickArmed = true;\n    this.reminder = false;\n    this.useWas = false;\n  }\n\n  hasKbm() { return this.binding === 'all' || this.binding === 'kbm'; }\n  pads() {\n    const all = this.app.devices.pads;\n    if (this.binding === 'all') return all.filter((p) => p.connected);\n    if (typeof this.binding === 'number') return all[this.binding]?.connected ? [all[this.binding]] : [];\n    return [];\n  }\n  primaryPad() { return this.pads()[0] ?? null; }\n\n  /** Edges: once per rendered frame. Selecting tools, tables, quick actions. */\n  frameEdges(ctx, sim) {\n    if (ctx.engine.frame === this.frame) return;\n    this.frame = ctx.engine.frame;\n    const seat = sim.seats.find((s) => s.id === this.seatId);\n    if (!seat) return;\n    const input = ctx.input;\n    const kb = this.hasKbm();\n    const pads = this.pads();\n    const unlocked = sim.tools;\n    const pick = (t) => {\n      if (!t || !unlocked.includes(t)) return false;\n      if (t !== this.tool) {\n        this.lastTool = this.tool;\n        this.tool = t;\n        this.app.sfx('click', { pitch: TOOLS.indexOf(t) });\n      }\n      this.quick = null;\n      return true;\n    };\n    if (!this.tool || !unlocked.includes(this.tool)) this.tool = seat.tool;\n    const holdingFragment = seat.grab && sim.ents.find((e) => e.id === seat.grab)?.rotTo != null;\n    this.rotPending = 0;\n    // Number keys, wheel, last tool.\n    if (kb) {\n      for (let i = 0; i < 8; i++) if (input.wasPressed(`Digit${i + 1}`)) pick(TOOLS[i]);\n      if (input.wheel && !holdingFragment) {\n        const list = TOOLS.filter((t) => unlocked.includes(t));\n        const i = list.indexOf(this.tool);\n        pick(list[(i + (input.wheel > 0 ? 1 : list.length - 1)) % list.length]);\n      }\n      if (holdingFragment) {\n        if (input.wheel) this.rotPending += input.wheel * 12;\n        if (input.isDown('KeyQ')) this.rotPending -= 3;\n        if (input.isDown('KeyE')) this.rotPending += 3;\n      } else if (input.wasPressed('KeyQ')) pick(this.lastTool);\n      if (input.wasPressed('KeyF')) this.quickSyringe(unlocked);\n      if (input.wasPressed('Tab')) this.nextTable(sim, 1);\n      if (input.wasPressed('KeyE') && !holdingFragment) this.tagOrRemind(sim);\n    }\n    for (const p of pads) {\n      const rx = p.axes[2], ry = p.axes[3];\n      const mag = Math.hypot(rx, ry);\n      if (holdingFragment) {\n        this.rotPending += rx * 3.2;\n      } else if (mag > 0.6) {\n        this.wheelShown = 0.8;\n        // 8 directions, clockwise from top.\n        const a = (Math.atan2(rx, -ry) + Math.PI * 2) % (Math.PI * 2);\n        const idx = Math.round(a / (Math.PI / 4)) % 8;\n        if (TOOLS[idx] !== this.tool && unlocked.includes(TOOLS[idx])) pick(TOOLS[idx]);\n      }\n      if (p.edge[PAD.r1]) pick(this.lastTool);\n      if (p.edge[PAD.square]) this.quickSyringe(unlocked);\n      if (p.edge[PAD.left]) this.nextTable(sim, -1);\n      if (p.edge[PAD.right]) this.nextTable(sim, 1);\n      if (p.edge[PAD.triangle]) this.tagOrRemind(sim);\n    }\n    this.wheelShown = Math.max(0, this.wheelShown - (this.app.frameDt ?? 1 / 60));\n    this.tagPressed = this.tagRequest ?? false;\n    this.tagRequest = false;\n  }\n  quickSyringe(unlocked) {\n    if (!unlocked.includes('syringe')) return;\n    if (this.tool === 'syringe' && this.quick) { this.tool = this.quick; this.quick = null; return; }\n    if (this.tool !== 'syringe') { this.quick = this.tool; this.lastTool = this.tool; this.tool = 'syringe'; this.app.sfx('click'); }\n  }\n  nextTable(sim, dir) {\n    if (sim.tables.length < 2) return;\n    this.table = (this.table + dir + sim.tables.length) % sim.tables.length;\n    this.input.table = this.table;\n  }\n  tagOrRemind(sim) {\n    if (sim.def?.partner) this.tagRequest = true;\n    else this.reminder = true;\n  }\n\n  /** Per fixed step: integrate the tip and build the sim input. */\n  step(ctx, sim, view, dt) {\n    const seat = sim.seats.find((s) => s.id === this.seatId);\n    if (!seat) return this.input;\n    this.frameEdges(ctx, sim);\n    const devices = this.app.devices;\n    const input = ctx.input;\n    const kb = this.hasKbm();\n    const pads = this.pads();\n    const cfg = this.app.config;\n    const settings = this.app.save.settings;\n    const aim = AIM[settings.aimAssist] ?? AIM.low;\n\n    // Sticks and keys.\n    let sx = 0, sy = 0;\n    let usedStick = false;\n    for (const p of pads) {\n      if (p.axes[0] || p.axes[1]) { sx += p.axes[0]; sy += p.axes[1]; usedStick = true; }\n    }\n    let keyMove = false;\n    if (kb) {\n      const r = input.isDown('KeyD', 'ArrowRight'), l = input.isDown('KeyA', 'ArrowLeft'), u = input.isDown('KeyW', 'ArrowUp'), dn = input.isDown('KeyS', 'ArrowDown');\n      if (r || l || u || dn) {\n        keyMove = true;\n        sx += (r ? 0.82 : 0) - (l ? 0.82 : 0);\n        sy += (dn ? 0.82 : 0) - (u ? 0.82 : 0);\n      }\n    }\n    const mag = Math.min(1, Math.hypot(sx, sy));\n    const steady = (kb && input.isDown('ShiftLeft', 'ShiftRight')) || pads.some((p) => p.down[PAD.l1]);\n    if (mag > 0) {\n      this.mouseAim = false;\n      const dirX = sx / (Math.hypot(sx, sy) || 1), dirY = sy / (Math.hypot(sx, sy) || 1);\n      let speed = cfg.cursorSpeed * settings.cursorSpeed * mag ** 2.2 * (steady ? cfg.steadyFactor : 1);\n      // Aim assist: a little drag near a valid target; drift off a stroke is damped.\n      let slow = 1;\n      if (settings.aimAssist !== 'off') {\n        const tool = seat.tool;\n        for (const t of validTargets(sim, seat, tool)) {\n          if (Math.hypot(t.x - this.x, t.z - this.z) < 0.6) { slow = aim.slow ?? cfg.aimAssist; break; }\n        }\n      }\n      speed *= slow;\n      let vx = dirX * speed, vz = dirY * speed;\n      const cutting = seat.cutting ? sim.ents.find((e) => e.id === seat.cutting) : null;\n      if (cutting && settings.aimAssist !== 'off') {\n        const h = pathHeading(cutting.path, cutting.s);\n        const ux = Math.cos(h), uz = Math.sin(h);\n        const along = vx * ux + vz * uz;\n        const perpX = vx - ux * along, perpZ = vz - uz * along;\n        vx = ux * along + perpX * aim.damp;\n        vz = uz * along + perpZ * aim.damp;\n      }\n      this.x = clamp(this.x + vx * dt, -8, 8);\n      this.z = clamp(this.z + vz * dt, -4.5, 4.5);\n    }\n    // The mouse: exactly where it points, on the surface.\n    if (kb && devices.mouseMoved) this.mouseAim = true;\n    if (kb && this.mouseAim && view && input.pointer) {\n      const cam = ctx.camera;\n      cam.rayAt(input.pointer.x, input.pointer.y, o, d);\n      const tv = view.tableViews?.[this.table];\n      const off = tv?.offsetX ?? 0;\n      let y = 0, wx = 0, wz = 0;\n      for (let i = 0; i < 4; i++) {\n        const t = (y - o.y) / d.y;\n        wx = o.x + d.x * t;\n        wz = o.z + d.z * t;\n        y = tv ? tv.heightAt(wx - off, wz) : 0;\n      }\n      this.x = clamp(wx - off, -8, 8);\n      this.z = clamp(wz, -4.5, 4.5);\n    }\n\n    // Buttons.\n    let useV = 0;\n    for (const p of pads) {\n      useV = Math.max(useV, p.values[PAD.r2], p.down[PAD.cross] ? 1 : 0);\n    }\n    const mouseL = kb && input.isDown('MouseLeft');\n    const mouseR = kb && input.isDown('MouseRight');\n    const j = kb && input.isDown('KeyJ'), k = kb && input.isDown('KeyK');\n    let use = useV > 0.12 || mouseL || j;\n    const force = mouseL || j ? 1 : Math.max(0.35, Math.min(1, useV * 1.15));\n    const drop = mouseR || k || pads.some((p) => p.down[PAD.circle]);\n    if (drop) use = false;\n    // Paddles and massage: both sides.\n    const a = pads.some((p) => p.values[PAD.l2] > 0.4) || mouseL || j;\n    const b = pads.some((p) => p.values[PAD.r2] > 0.4) || mouseR || k;\n    // Gift.\n    let gift = (kb && input.isDown('Space')) || pads.some((p) => p.values[PAD.l2] > 0.4);\n    if (settings.giftMode === 'toggle' && seat.gift === 'quiet') {\n      const edge = gift && !this.giftWasRaw;\n      this.giftWasRaw = gift;\n      if (edge) this.giftToggle = !this.giftToggle;\n      if (!sim.quiet && !edge && this.giftToggle && sim.composure < 20) this.giftToggle = false;\n      gift = this.giftToggle;\n    }\n    // Quick syringe: back to the old tool once the dose has been given.\n    if (this.quick && this.useWas && !use && this.tool === 'syringe') { this.tool = this.quick; this.quick = null; }\n    this.useWas = use;\n\n    const inp = this.input;\n    inp.x = this.x; inp.z = this.z;\n    inp.tool = this.tool;\n    inp.use = use;\n    inp.force = force;\n    inp.gift = gift;\n    inp.steady = steady;\n    inp.a = a;\n    inp.b = b;\n    inp.rot = this.rotPending;\n    inp.table = this.table;\n    inp.tag = this.tagPressed ?? false;\n    inp.drop = drop;\n    if (keyMove || usedStick) this.mouseAim = false;\n    return inp;\n  }\n\n  syncFromSeat(seat) {\n    this.x = seat.x;\n    this.z = seat.z;\n    this.tool = seat.tool;\n    this.table = seat.table;\n  }\n}\nEOF\ncat > src/content/icons.js <<'EOF'\n// Pixel-art HUD icons as data: the tool wheel and the button glyphs.\nexport const TOOL_ICONS = {\n  scalpel: { rows: ['..........w.', '.........wwm', '........wwm.', '.......wwm..', '......wwm...', '.....ssm....', '....ssm.....', '...ssm......', '..ssm.......', '.ssm........', 'ssm.........', '.m..........'], c: { w: 'white', m: 'mist', s: 'slate' } },\n  forceps: { rows: ['..m......m..', '..m......m..', '..mm....mm..', '...m....m...', '...mm..mm...', '....m..m....', '....mmmm....', '....ssss....', '.....ss.....', '.....ss.....', '.....ss.....', '.....ww.....'], c: { m: 'mist', s: 'slate', w: 'white' } },\n  suture: { rows: ['.....wwww...', '...ww....w..', '..w.......w.', '.w........w.', '.w.......w..', '.b......m...', '.b.....mm...', '..b...mm....', '..bb.mm.....', '....mm......', '...mm.......', '..mm........'], c: { w: 'white', b: 'sky', m: 'mist' } },\n  drain: { rows: ['..........nn', '.........nn.', '........nn..', '.......ss...', '......ss....', '.....ss.....', '....ss......', '...sws......', '..sws.......', '.wws........', 'www.........', '.w..........'], c: { w: 'white', s: 'sky', n: 'navy' } },\n  syringe: { rows: ['...........w', '..........w.', '.......mmw..', '......mccm..', '.....mccm...', '....mccm....', '...mccm.....', '..mmcm......', '.mm.mm......', 'mm..........', 'w...........', '............'], c: { w: 'white', m: 'mist', c: 'cyan' } },\n  gel: { rows: ['.....tt.....', '.....tt.....', '....tttt....', '...tttttt...', '...llllll...', '..llllllll..', '..lwwwwwll..', '..lwwwwwll..', '..lwwwwwll..', '..llllllll..', '..llllllll..', '...llllll...'], c: { t: 'teal', l: 'lime', w: 'white' } },\n  laser: { rows: ['r...........', 'rr..........', '.ro.........', '..oo........', '...nn.......', '....nn......', '.....nn.....', '......nn....', '.......nn...', '........nn..', '.........nn.', '..........nn'], c: { r: 'red', o: 'orange', n: 'mist' } },\n  scanner: { rows: ['...cccccc...', '..c......c..', '.c..c.....c.', '.c...c....c.', '.c....c...c.', '.c........c.', '..c......c..', '...cccccc...', '.....mm.....', '.....mm.....', '.....ss.....', '.....ss.....'], c: { c: 'cyan', m: 'mist', s: 'slate' } },\n  dressing: { rows: ['............', '...wwwwww...', '..wwwwwwww..', '.wwmmmmmmww.', '.wwm....mww.', '.wwm....mww.', '.wwm....mww.', '.wwmmmmmmww.', '..wwwwwwww..', '...wwwwwwww.', '..........ww', '............'], c: { w: 'white', m: 'mist' } },\n};\n\nconst C = { o: 'ink', x: 'white' };\nconst SHAPE = {\n  cross: ['..ooooo..', '.ooooooo.', 'ooxoooxoo', 'oooxoxooo', 'ooooxoooo', 'oooxoxooo', 'ooxoooxoo', '.ooooooo.', '..ooooo..'],\n  circle: ['..ooooo..', '.ooooooo.', 'oooxxxooo', 'ooxoooxoo', 'ooxoooxoo', 'ooxoooxoo', 'oooxxxooo', '.ooooooo.', '..ooooo..'],\n  square: ['..ooooo..', '.ooooooo.', 'ooxxxxxoo', 'ooxoooxoo', 'ooxoooxoo', 'ooxoooxoo', 'ooxxxxxoo', '.ooooooo.', '..ooooo..'],\n  triangle: ['..ooooo..', '.oooxooo.', 'oooxoxooo', 'oooxoxooo', 'ooxoooxoo', 'ooxoooxoo', 'oxxxxxxxo', '.ooooooo.', '..ooooo..'],\n  disc: ['..ooooo..', '.ooooooo.', 'ooooooooo', 'ooooooooo', 'ooooooooo', 'ooooooooo', 'ooooooooo', '.ooooooo.', '..ooooo..'],\n  dpad: ['...ooo...', '...oxo...', '...oxo...', 'oooooooo.', 'oxxxxxxo.', 'oooooooo.', '...oxo...', '...oxo...', '...ooo...'],\n  mouseL: ['..ooooo..', '.oxxoeeo.', '.oxxoeeo.', '.oxxoeeo.', '.ooooooo.', '.oeeeeeo.', '.oeeeeeo.', '.oeeeeeo.', '..ooooo..'],\n  mouseR: ['..ooooo..', '.oeeoxxo.', '.oeeoxxo.', '.oeeoxxo.', '.ooooooo.', '.oeeeeeo.', '.oeeeeeo.', '.oeeeeeo.', '..ooooo..'],\n  mouseM: ['..ooooo..', '.oeexeeo.', '.oeexeeo.', '.oeexeeo.', '.ooooooo.', '.oeeeeeo.', '.oeeeeeo.', '.oeeeeeo.', '..ooooo..'],\n};\nexport const GLYPHS = {\n  // PlayStation.\n  CROSS: { sprite: SHAPE.cross, c: { ...C, x: 0x7ab8ff } },\n  CIRCLE: { sprite: SHAPE.circle, c: { ...C, x: 0xff6b6b } },\n  SQUARE: { sprite: SHAPE.square, c: { ...C, x: 0xff9edb } },\n  TRIANGLE: { sprite: SHAPE.triangle, c: { ...C, x: 0x5fe0b0 } },\n  L1: { pill: 'L1' }, R1: { pill: 'R1' }, L2: { pill: 'L2' }, R2: { pill: 'R2' }, OPTIONS: { pill: 'OPT' },\n  // Xbox.\n  A: { sprite: SHAPE.disc, c: { o: 0x2f9e44 }, letter: 'A' }, B: { sprite: SHAPE.disc, c: { o: 0xd9363e }, letter: 'B' }, X: { sprite: SHAPE.disc, c: { o: 0x3b6fd9 }, letter: 'X' }, Y: { sprite: SHAPE.disc, c: { o: 0xd9a400 }, letter: 'Y' },\n  LB: { pill: 'LB' }, RB: { pill: 'RB' }, LT: { pill: 'LT' }, RT: { pill: 'RT' }, MENU: { pill: 'MENU' },\n  // Both.\n  LS: { pill: 'LS' }, RS: { pill: 'RS' }, DPAD: { sprite: SHAPE.dpad, c: { o: 'ink', x: 'white' } },\n  // Mouse.\n  LMB: { sprite: SHAPE.mouseL, c: { o: 'ink', x: 'sand', e: 'mist' } }, RMB: { sprite: SHAPE.mouseR, c: { o: 'ink', x: 'sand', e: 'mist' } }, WHEEL: { sprite: SHAPE.mouseM, c: { o: 'ink', x: 'sand', e: 'mist' } },\n};\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// Prompts follow the last input used: PlayStation glyphs (or Xbox, by setting) for the controller,\n// keycaps and mouse icons for keyboard and mouse. Data text carries tokens; nothing hardcodes a button.\nconst PAD_PS = { use: ['R2'], tool: ['RS'], gift: ['L2'], steady: ['L1'], confirm: ['CROSS'], back: ['CIRCLE'], drop: ['CIRCLE'], syringe: ['SQUARE'], table: ['DPAD'], tag: ['TRIANGLE'], rotate: ['RS'], last: ['R1'], paddles: ['L2', 'R2'], left: ['L2'], right: ['R2'], pause: ['OPTIONS'], remind: ['TRIANGLE'], more: ['TRIANGLE'], tabs: ['L1', 'R1'], move: ['LS'], skip: ['TRIANGLE'] };\nconst XB = { CROSS: 'A', CIRCLE: 'B', SQUARE: 'X', TRIANGLE: 'Y', L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', OPTIONS: 'MENU' };\nconst KBM = { use: ['LMB'], tool: ['KEY:1-8'], gift: ['KEY:SPACE'], steady: ['KEY:SHIFT'], confirm: ['KEY:ENTER'], back: ['KEY:ESC'], drop: ['RMB'], syringe: ['KEY:F'], table: ['KEY:TAB'], tag: ['KEY:E'], rotate: ['WHEEL'], last: ['KEY:Q'], paddles: ['LMB', 'RMB'], left: ['LMB'], right: ['RMB'], pause: ['KEY:ESC'], remind: ['KEY:E'], more: ['KEY:M'], tabs: ['KEY:Q', 'KEY:E'], move: ['KEY:WASD'], skip: ['KEY:ESC'] };\n\nexport const TOKENS = Object.keys(PAD_PS);\n\nexport function glyphsFor(action, device, glyphStyle) {\n  if (device === 'pad') {\n    const g = PAD_PS[action];\n    if (!g) return null;\n    return glyphStyle === 'xbox' ? g.map((id) => XB[id] ?? id) : g;\n  }\n  return KBM[action] ?? null;\n}\nEOF\ncat > src/ui/hud.js <<'EOF'\n// Everything on the HUD canvas goes through here: wrap, rich text with *highlights* and {button} tokens,\n// glyphs, panels, the 10-foot clipboard motif, and pointer hit tests.\nimport { GLYPHS } from '../content/icons.js';\nimport { glyphsFor } from './prompts.js';\n\nconst TOKEN = /\\{([a-z]+)\\}/g;\n\nexport class UI {\n  constructor(app, ctx) {\n    this.app = app;\n    this.ctx = ctx;\n    this.hud = ctx.hud;\n  }\n  get w() { return this.hud.width; }\n  get h() { return this.hud.height; }\n  get device() { return this.app.devices.last; }\n  get glyphStyle() { return this.app.save.settings.glyphs; }\n\n  text(x, y, s, o = {}) { this.hud.text(Math.round(x), Math.round(y), s, o); }\n  center(y, s, o = {}) {\n    const m = this.hud.measure(s, o.scale ?? 1);\n    this.hud.text(Math.round((this.w - m.width) / 2), Math.round(y), s, o);\n  }\n  right(x, y, s, o = {}) {\n    const m = this.hud.measure(s, o.scale ?? 1);\n    this.hud.text(Math.round(x - m.width), Math.round(y), s, o);\n  }\n  rect(x, y, w, h, c) { this.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), c); }\n  outline(x, y, w, h, c, t = 1) {\n    this.rect(x, y, w, t, c); this.rect(x, y + h - t, w, t, c); this.rect(x, y, t, h, c); this.rect(x + w - t, y, t, h, c);\n  }\n  panel(x, y, w, h, fill = 'night', border = 'mist') {\n    this.rect(x + 2, y + 2, w, h, 'ink');\n    this.rect(x, y, w, h, fill);\n    this.outline(x, y, w, h, border);\n  }\n  /** The clipboard: the game's chart and rubber-stamp motif instead of tables of data. */\n  clipboard(x, y, w, h) {\n    this.rect(x + 3, y + 3, w, h, 'ink');\n    this.rect(x, y, w, h, 0xe9e1cc);\n    this.outline(x, y, w, h, 0x8a7a5a);\n    this.rect(x, y, w, 6, 0x6d5a3a);\n    this.rect(x + w / 2 - 22, y - 5, 44, 11, 'slate');\n    this.outline(x + w / 2 - 22, y - 5, 44, 11, 'mist');\n    this.rect(x + w / 2 - 12, y - 2, 24, 3, 'white');\n  }\n  stamp(cx, cy, label, color, scale = 3) {\n    const m = this.hud.measure(label, scale);\n    const pad = 4;\n    const x = cx - m.width / 2 - pad, y = cy - m.height / 2 - pad, w = m.width + pad * 2, h = m.height + pad * 2;\n    this.outline(x, y, w, h, color, 2);\n    this.text(cx - m.width / 2, cy - m.height / 2, label, { color, scale, shadow: false });\n  }\n  hit(x, y, w, h) {\n    const d = this.app.devices;\n    return d.px >= x && d.px < x + w && d.py >= y && d.py < y + h;\n  }\n\n  // ------------------------------------------------------------ Glyphs\n  glyphWidth(id) {\n    if (id.startsWith('KEY:')) return this.hud.measure(id.slice(4), 1).width + 6;\n    const g = GLYPHS[id];\n    if (!g) return 0;\n    if (g.pill) return this.hud.measure(g.pill, 1).width + 6;\n    return 9;\n  }\n  glyph(x, y, id) {\n    x = Math.round(x); y = Math.round(y);\n    if (id.startsWith('KEY:')) {\n      const label = id.slice(4);\n      const w = this.glyphWidth(id);\n      this.rect(x, y, w, 9, 'mist');\n      this.rect(x, y + 8, w, 1, 'slate');\n      this.rect(x + 1, y + 1, w - 2, 7, 'white');\n      this.text(x + 3, y + 1, label, { color: 'ink', shadow: false });\n      return w;\n    }\n    const g = GLYPHS[id];\n    if (!g) return 0;\n    if (g.pill) {\n      const w = this.glyphWidth(id);\n      this.rect(x, y, w, 9, 'ink');\n      this.outline(x, y, w, 9, 'mist');\n      this.text(x + 3, y + 1, g.pill, { color: 'white', shadow: false });\n      return w;\n    }\n    this.hud.sprite(x, y, g.sprite, g.c);\n    if (g.letter) this.text(x + 2, y + 1, g.letter, { color: 'white', shadow: false });\n    return 9;\n  }\n  /** Draw an action's glyphs. Returns width. */\n  action(x, y, name) {\n    const list = glyphsFor(name, this.device, this.glyphStyle);\n    if (!list) return 0;\n    let cx = x;\n    list.forEach((id, i) => {\n      if (i) { this.text(cx, y + 1, '+', { color: 'white' }); cx += 7; }\n      cx += this.glyph(cx, y, id) + 1;\n    });\n    return cx - x - 1;\n  }\n  actionWidth(name) {\n    const list = glyphsFor(name, this.device, this.glyphStyle);\n    if (!list) return 0;\n    return list.reduce((a, id, i) => a + (i ? 7 : 0) + this.glyphWidth(id) + 1, -1);\n  }\n\n  // ------------------------------------------------------------ Rich text\n  /** Split into runs: { t: text, hi: bool } | { action: name } */\n  runs(str) {\n    const out = [];\n    let hi = false;\n    let last = 0;\n    const flush = (seg) => {\n      if (!seg) return;\n      const parts = seg.split('*');\n      parts.forEach((p, i) => {\n        if (i > 0) hi = !hi;\n        if (p) out.push({ t: p, hi });\n      });\n    };\n    str.replace(TOKEN, (m, name, idx) => {\n      flush(str.slice(last, idx));\n      out.push({ action: name });\n      last = idx + m.length;\n      return m;\n    });\n    flush(str.slice(last));\n    return out;\n  }\n  widthOf(str, scale = 1) {\n    let w = 0;\n    for (const r of this.runs(str)) w += r.action ? this.actionWidth(r.action) * scale : this.hud.measure(r.t, scale).width;\n    return w;\n  }\n  /** Greedy wrap that keeps tokens and highlights whole. */\n  wrap(str, maxW, scale = 1) {\n    const words = str.split(' ');\n    const lines = [];\n    let cur = '';\n    let hiOpen = false;\n    for (const word of words) {\n      const test = cur ? `${cur} ${word}` : word;\n      if (this.widthOf(test.replace(/\\*/g, ''), scale) > maxW && cur) {\n        lines.push(hiOpen ? `*${cur}` : cur);\n        const stars = (cur.match(/\\*/g) ?? []).length;\n        if (stars % 2) hiOpen = !hiOpen;\n        cur = word;\n      } else cur = test;\n    }\n    if (cur) lines.push(hiOpen ? `*${cur}` : cur);\n    return lines;\n  }\n  /** Rich text at (x, y). `chars` limits how many characters show (typewriter). Returns width. */\n  rich(x, y, str, o = {}) {\n    const color = o.color ?? 'white', hiColor = o.hi ?? 'sand', scale = o.scale ?? 1, shadow = o.shadow;\n    let cx = Math.round(x);\n    let left = o.chars ?? Infinity;\n    const lineH = this.hud.measure('A', scale).height;\n    for (const r of this.runs(str)) {\n      if (left <= 0) break;\n      if (r.action) {\n        const gw = this.actionWidth(r.action);\n        this.action(cx, Math.round(y + (lineH - 9) / 2), r.action);\n        cx += gw;\n        left -= 1;\n        continue;\n      }\n      const shown = left >= r.t.length ? r.t : r.t.slice(0, left);\n      left -= r.t.length;\n      const opts = { color: r.hi ? hiColor : color, scale };\n      if (shadow !== undefined) opts.shadow = shadow;\n      this.text(cx, y, shown, opts);\n      cx += this.hud.measure(r.t, scale).width;\n    }\n    return cx - x;\n  }\n  richCenter(y, str, o = {}) {\n    const w = this.widthOf(str, o.scale ?? 1);\n    return this.rich((this.w - w) / 2, y, str, o);\n  }\n  /** A row of [action, label] hints along the bottom. */\n  hints(list, y = null, align = 'right') {\n    const yy = y ?? this.h - 11;\n    let total = 0;\n    for (const [action, label] of list) total += this.actionWidth(action) + 3 + this.hud.measure(label, 1).width + 8;\n    let x = align === 'right' ? this.w - total - 2 : align === 'center' ? (this.w - total) / 2 : 6;\n    for (const [action, label] of list) {\n      x += this.action(x, yy, action) + 3;\n      this.text(x, yy + 1, label, { color: 'white' });\n      x += this.hud.measure(label, 1).width + 8;\n    }\n  }\n}\nEOF\ncat > src/ui/menu.js <<'EOF'\n// A vertical list you can drive with a pad, keys or a mouse: big focused item, bright marker, no tables.\nexport class Menu {\n  /**\n   * @param items [{ label, value?: ()=>string, onConfirm?, onLeft?, onRight?, disabled?, blurb? }]\n   */\n  constructor(app, items, o = {}) {\n    this.app = app;\n    this.items = items;\n    this.i = o.start ?? 0;\n    this.top = 0;\n    this.rows = o.rows ?? 8;\n    this.onBack = o.onBack ?? null;\n    this.rowH = o.rowH ?? 15;\n    this.scale = o.scale ?? 1;\n    this.x = o.x;\n    this.y = o.y ?? 60;\n    this.w = o.w ?? 240;\n    this.sound = o.sound ?? true;\n    this.fixFocus();\n  }\n  fixFocus() {\n    if (!this.items.length) return;\n    let guard = 0;\n    while (this.items[this.i]?.disabled && guard++ < this.items.length) this.i = (this.i + 1) % this.items.length;\n  }\n  move(dir) {\n    const n = this.items.length;\n    let k = this.i;\n    for (let g = 0; g < n; g++) {\n      k = (k + dir + n) % n;\n      if (!this.items[k].disabled) break;\n    }\n    if (k !== this.i) { this.i = k; this.app.sfx('uiMove'); }\n    this.keepVisible();\n  }\n  keepVisible() {\n    if (this.i < this.top) this.top = this.i;\n    if (this.i >= this.top + this.rows) this.top = this.i - this.rows + 1;\n  }\n  update(ui) {\n    const nav = this.app.devices.nav;\n    const dev = this.app.devices;\n    if (nav.up) this.move(-1);\n    if (nav.down) this.move(1);\n    const item = this.items[this.i];\n    if (item) {\n      if (nav.left && item.onLeft) { item.onLeft(); this.app.sfx('uiMove'); }\n      if (nav.right && item.onRight) { item.onRight(); this.app.sfx('uiMove'); }\n      if (nav.confirm && item.onConfirm && !item.disabled) { this.app.sfx('uiConfirm'); item.onConfirm(); return; }\n    }\n    if (nav.back && this.onBack) { this.app.sfx('uiBack'); this.onBack(); return; }\n    if (dev.rightClick && this.onBack) { this.app.sfx('uiBack'); this.onBack(); return; }\n    if (dev.wheel) {\n      if (this.items.length > this.rows) {\n        this.top = Math.max(0, Math.min(this.items.length - this.rows, this.top + (dev.wheel > 0 ? 1 : -1)));\n        if (this.i < this.top) this.i = this.top;\n        if (this.i >= this.top + this.rows) this.i = this.top + this.rows - 1;\n      }\n    }\n    // Mouse: hover moves focus, click confirms.\n    const x = this.xPos(ui);\n    const end = Math.min(this.items.length, this.top + this.rows);\n    for (let k = this.top; k < end; k++) {\n      const y = this.y + (k - this.top) * this.rowH;\n      if (ui.hit(x - 6, y - 3, this.w + 12, this.rowH)) {\n        const it = this.items[k];\n        if (dev.mouseMoved && !it.disabled && this.i !== k) { this.i = k; this.app.sfx('uiMove'); }\n        if (dev.click && !it.disabled) {\n          this.i = k;\n          if (it.onConfirm) { this.app.sfx('uiConfirm'); it.onConfirm(); return; }\n          if (it.onRight) {\n            // Click the left or right half to step a value.\n            if (dev.px < x + this.w / 2 && it.onLeft) it.onLeft(); else it.onRight();\n            this.app.sfx('uiMove');\n            return;\n          }\n        }\n      }\n    }\n  }\n  xPos(ui) { return this.x ?? (ui.w - this.w) / 2; }\n  draw(ui) {\n    const x = this.xPos(ui);\n    const end = Math.min(this.items.length, this.top + this.rows);\n    for (let k = this.top; k < end; k++) {\n      const it = this.items[k];\n      const y = this.y + (k - this.top) * this.rowH;\n      const focus = k === this.i;\n      if (focus) {\n        ui.rect(x - 6, y - 3, this.w + 12, this.rowH - 1, 'navy');\n        ui.outline(x - 6, y - 3, this.w + 12, this.rowH - 1, 'sand');\n        ui.rect(x - 11, y - 3, 3, this.rowH - 1, 'sand');\n      }\n      const color = it.disabled ? 'slate' : focus ? 'sand' : 'white';\n      ui.text(x, y, it.label, { color, scale: this.scale });\n      if (it.value) {\n        const v = it.value();\n        const vw = ui.hud.measure(v, this.scale).width;\n        const right = x + this.w;\n        ui.text(right - vw - (focus ? 8 : 0), y, v, { color: focus ? 'white' : 'mist', scale: this.scale });\n        if (focus && (it.onLeft || it.onRight)) {\n          ui.text(right - vw - 16, y, '<', { color: 'sand', scale: this.scale });\n          ui.text(right - 5, y, '>', { color: 'sand', scale: this.scale });\n        }\n      }\n    }\n    if (this.top > 0) ui.center(this.y - 11, '- MORE -', { color: 'mist' });\n    if (end < this.items.length) ui.center(this.y + this.rows * this.rowH - 2, '- MORE -', { color: 'mist' });\n    const cur = this.items[this.i];\n    if (cur?.blurb) {\n      const lines = ui.wrap(cur.blurb, ui.w - 40);\n      lines.slice(0, 2).forEach((l, n) => ui.richCenter(this.y + Math.min(this.items.length, this.rows) * this.rowH + 6 + n * 10, l, { color: 'mist' }));\n    }\n  }\n}\nEOF\necho ok","description":"Write input, prompts, HUD toolkit and menu widget"}}}
