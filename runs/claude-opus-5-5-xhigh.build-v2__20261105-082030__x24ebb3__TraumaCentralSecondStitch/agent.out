{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk3U8EZWQqxNBTtPWSc7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018KzjFgsGkyAFNPwmHEH4uo","name":"Bash","input":{"command":"cat > src/audio/voice.js <<'EOF'\n// Animalese/Simlish gibberish: syllables rendered in pure JS (a glottal pulse through three formants),\n// wrapped as WAV data URLs for the engine's buses. Letters pick syllables deterministically; punctuation\n// shapes rhythm and pitch. No audio files, no real words. Testable in Node.\nconst VOWELS = { a: [730, 1090, 2440], e: [530, 1840, 2480], i: [300, 2290, 3010], o: [570, 840, 2410], u: [320, 870, 2240] };\nconst ONSETS = ['v', 't', 'm']; // vowel, plosive, nasal\nexport const TIMBRES = {\n  low: { f0: 105, bright: 0.55, shift: 0.9 },\n  mid: { f0: 170, bright: 0.7, shift: 1 },\n  high: { f0: 250, bright: 0.85, shift: 1.12 },\n};\nconst RATE = 22050;\n\n/** One syllable, 120 ms, as Float32 samples in -1..1. */\nexport function renderSyllable(timbreId, vowel, onset) {\n  const T = TIMBRES[timbreId];\n  const n = Math.round(RATE * 0.12);\n  const out = new Float32Array(n);\n  const F = VOWELS[vowel].map((f) => f * T.shift);\n  const bw = [80, 110, 170];\n  const res = F.map((f, k) => {\n    const r = Math.exp((-Math.PI * bw[k]) / RATE);\n    return { a1: 2 * r * Math.cos((2 * Math.PI * f) / RATE), a2: -r * r, g: 1 - r, y1: 0, y2: 0 };\n  });\n  let phase = 0, seed = (timbreId.length * 31 + vowel.charCodeAt(0) * 7 + onset.charCodeAt(0)) | 0;\n  const noise = () => { seed = (seed * 1664525 + 1013904223) | 0; return ((seed >>> 16) & 0x7fff) / 16384 - 1; };\n  for (let i = 0; i < n; i++) {\n    const t = i / RATE;\n    phase += (T.f0 * (1 + 0.04 * Math.sin(t * 34))) / RATE;\n    if (phase >= 1) phase -= 1;\n    // A glottal pulse: quick rise, slow fall.\n    let g = phase < 0.4 ? Math.sin((phase / 0.4) * Math.PI) ** 2 : 0;\n    g -= 0.3 * T.bright * (phase < 0.08 ? 1 - phase / 0.08 : 0);\n    let voiced = 1;\n    if (onset === 't' && t < 0.014) { g = noise() * 0.9; voiced = 1; }\n    if (onset === 't' && t >= 0.014 && t < 0.03) voiced = 0.25;\n    if (onset === 'm' && t < 0.035) voiced = 0.4;\n    const input = g * voiced;\n    let s = 0;\n    res.forEach((f, k) => {\n      const y = input * f.g + f.a1 * f.y1 + f.a2 * f.y2;\n      f.y2 = f.y1;\n      f.y1 = y;\n      s += y * (k === 0 ? 1 : k === 1 ? 0.7 * T.bright + 0.15 : 0.3 * T.bright);\n    });\n    const env = Math.min(1, t / 0.008) * Math.min(1, (0.12 - t) / 0.04);\n    out[i] = s * env * 2.6;\n  }\n  let peak = 0;\n  for (let i = 0; i < n; i++) peak = Math.max(peak, Math.abs(out[i]));\n  if (peak > 0) for (let i = 0; i < n; i++) out[i] = (out[i] / peak) * 0.82;\n  return out;\n}\n\nexport function wavDataUrl(samples) {\n  const n = samples.length;\n  const buf = new Uint8Array(44 + n * 2);\n  const v = new DataView(buf.buffer);\n  const w = (o, s) => { for (let i = 0; i < s.length; i++) buf[o + i] = s.charCodeAt(i); };\n  w(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); w(8, 'WAVEfmt '); v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);\n  v.setUint32(24, RATE, true); v.setUint32(28, RATE * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true); w(36, 'data'); v.setUint32(40, n * 2, true);\n  for (let i = 0; i < n; i++) v.setInt16(44 + i * 2, Math.max(-1, Math.min(1, samples[i])) * 32767, true);\n  let bin = '';\n  for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode.apply(null, buf.subarray(i, i + 0x8000));\n  const b64 = typeof btoa === 'function' ? btoa(bin) : Buffer.from(buf).toString('base64');\n  return `data:audio/wav;base64,${b64}`;\n}\n\nexport const syllableName = (timbre, vowel, onset) => `syl-${timbre}-${vowel}-${onset}`;\nexport const ALL_SYLLABLES = Object.keys(TIMBRES).flatMap((t) => Object.keys(VOWELS).flatMap((v) => ONSETS.map((o) => ({ t, v, o, name: syllableName(t, v, o) }))));\n\n// Who sounds like what. basePitch in semitones on top of the timbre; range: how far the melody wanders.\nexport const VOICES = {\n  ilya: { timbre: 'high', basePitch: -2, speed: 1.25, range: 3.2, volume: 0.85 },\n  reyes: { timbre: 'mid', basePitch: -3, speed: 1.15, range: 1.6, volume: 0.95 },\n  sabine: { timbre: 'low', basePitch: 2, speed: 0.8, range: 0.8, volume: 0.8 },\n  bram: { timbre: 'low', basePitch: -4, speed: 0.7, range: 1.4, volume: 0.9 },\n  pem: { timbre: 'low', basePitch: 3, speed: 0.75, range: 3.8, volume: 0.8 },\n  hesper: { timbre: 'mid', basePitch: 0, speed: 0.72, range: 1.2, volume: 0.65 },\n  tomasz: { timbre: 'low', basePitch: 0, speed: 1, range: 2, volume: 0.85 },\n  zamboni: { timbre: 'mid', basePitch: 1, speed: 1.1, range: 4, volume: 0.85 },\n  anselm: { timbre: 'mid', basePitch: -1, speed: 0.8, range: 0.6, volume: 0.7 },\n  ottilie: { timbre: 'mid', basePitch: 2, speed: 0.85, range: 1.5, volume: 0.7 },\n  ollie: { timbre: 'high', basePitch: 1, speed: 1.2, range: 2.5, volume: 0.8 },\n};\n\nconst VOWEL_KEYS = Object.keys(VOWELS);\nconst isLetter = (c) => /[a-z]/i.test(c);\n\n/** What the voice does at character i of text: null, or a syllable to play. Pure and deterministic. */\nexport function syllableAt(whoId, text, i) {\n  const V = VOICES[whoId] ?? VOICES.reyes;\n  const c = text[i];\n  if (!c || !isLetter(c)) return null;\n  // A syllable every couple of letters, on a vowel where there is one.\n  const lower = c.toLowerCase();\n  const isV = 'aeiou'.includes(lower);\n  if (!isV && i % 3 !== 0) return null;\n  const code = lower.charCodeAt(0);\n  const vowel = isV ? lower : VOWEL_KEYS[code % 5];\n  const onset = ONSETS[(code + i) % 3];\n  // Melody: word position plus the sentence's end.\n  let end = text.length;\n  for (let k = i; k < text.length; k++) if ('.!?'.includes(text[k])) { end = k; break; }\n  const mark = text[end] ?? '.';\n  const toEnd = end - i;\n  let pitch = V.basePitch + Math.sin(i * 1.7 + code) * V.range;\n  let volume = V.volume;\n  if (mark === '!') { pitch += 2 + (toEnd < 6 ? 2 : 0); volume *= 1.15; }\n  if (mark === '?' && toEnd < 6) pitch += (6 - toEnd) * 0.9;\n  if (mark === '.' && toEnd < 4) pitch -= (4 - toEnd) * 0.5;\n  return { name: syllableName(V.timbre, vowel, onset), pitch, volume: Math.min(1, volume) };\n}\n/** Pause after a character, in characters of typewriter time. */\nexport function pauseAfter(c, text, i) {\n  if (c === '.' && text[i + 1] === '.') return 3;\n  if (c === '.' || c === '!' || c === '?') return 8;\n  if (c === ',' || c === ':' || c === ';') return 4;\n  if (c === '-') return 3;\n  return 0;\n}\nEOF\ncat > src/content/sfx.js <<'EOF'\n// Every sound effect, as engine SoundDef data.\nexport const SFX_DEFS = {\n  // Tools.\n  drainLoop: { wave: 'noise', freq: 2200, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.16, layers: [{ wave: 'square', duty: 0.25, freq: 70, freqEnd: 95, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.06, vibrato: { depth: 3, rate: 22 } }] },\n  slurp: { wave: 'triangle', freq: 180, freqEnd: 820, attack: 0.005, sustain: 0.08, decay: 0.08, volume: 0.3, layers: [{ wave: 'noise', freq: 4000, attack: 0.005, sustain: 0.05, decay: 0.07, volume: 0.12 }] },\n  click: { wave: 'square', duty: 0.125, freq: 1800, freqEnd: 900, decay: 0.03, volume: 0.22 },\n  hookPop: { wave: 'square', duty: 0.25, freq: 260, freqEnd: 1100, attack: 0.003, decay: 0.09, volume: 0.28, layers: [{ wave: 'noise', freq: 6000, decay: 0.03, volume: 0.1 }] },\n  dishTink: { wave: 'triangle', freq: 2640, decay: 0.28, volume: 0.3, layers: [{ wave: 'sine', freq: 3960, decay: 0.2, volume: 0.14 }, { wave: 'sine', freq: 1320, delay: 0.09, decay: 0.12, volume: 0.1 }] },\n  slice: { wave: 'noise', freq: 9000, freqEnd: 3200, attack: 0.01, sustain: 0.06, decay: 0.08, volume: 0.22 },\n  cutLoop: { wave: 'noise', freq: 7000, attack: 0.01, sustain: 0.4, decay: 0.01, volume: 0.05 },\n  stitch: { wave: 'triangle', freq: 660, decay: 0.08, volume: 0.32, layers: [{ wave: 'noise', freq: 8000, decay: 0.012, volume: 0.1 }] },\n  knot: { wave: 'square', duty: 0.25, freq: 520, freqEnd: 300, decay: 0.09, volume: 0.22, layers: [{ wave: 'triangle', delay: 0.07, freq: 880, decay: 0.12, volume: 0.25 }] },\n  laserLoop: { wave: 'saw', freq: 110, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.12, vibrato: { depth: 0.5, rate: 60 }, layers: [{ wave: 'square', duty: 0.125, freq: 1760, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.035 }] },\n  sizzle: { wave: 'noise', freq: 9000, attack: 0.005, sustain: 0.1, decay: 0.24, volume: 0.25, crush: 12 },\n  ping: { wave: 'sine', freq: 1568, decay: 0.32, volume: 0.32, arp: [0, 12], arpRate: 0.07 },\n  scanLoop: { wave: 'sine', freq: 620, attack: 0.05, sustain: 0.6, decay: 0.05, volume: 0.05, vibrato: { depth: 1.5, rate: 8 } },\n  gelLoop: { wave: 'noise', freq: 3400, attack: 0.03, sustain: 0.5, decay: 0.03, volume: 0.08, crush: 6 },\n  syringeDraw: { wave: 'sine', freq: 300, freqEnd: 900, attack: 0.02, sustain: 0.36, decay: 0.04, volume: 0.14 },\n  syringeReady: { wave: 'triangle', freq: 1320, decay: 0.08, volume: 0.25 },\n  inject: { wave: 'noise', freq: 5000, freqEnd: 600, attack: 0.01, sustain: 0.1, decay: 0.2, volume: 0.22, layers: [{ wave: 'sine', freq: 880, freqEnd: 330, decay: 0.3, volume: 0.2 }] },\n  grab: { wave: 'square', duty: 0.25, freq: 900, decay: 0.03, volume: 0.2, layers: [{ wave: 'square', duty: 0.125, delay: 0.03, freq: 1400, decay: 0.03, volume: 0.15 }] },\n  tick: { wave: 'square', duty: 0.125, freq: 240, decay: 0.05, volume: 0.22 },\n  dressing: { wave: 'noise', freq: 1600, attack: 0.02, sustain: 0.1, decay: 0.1, volume: 0.1 },\n  heal: { wave: 'triangle', freq: 660, decay: 0.2, volume: 0.2, arp: [0, 4, 7], arpRate: 0.05 },\n  // Ratings.\n  cleanA: { wave: 'triangle', freq: 880, decay: 0.2, volume: 0.28, arp: [0, 7], arpRate: 0.06 },\n  goodA: { wave: 'triangle', freq: 660, decay: 0.16, volume: 0.24 },\n  sloppyA: { wave: 'square', duty: 0.25, freq: 220, freqEnd: 160, decay: 0.18, volume: 0.2 },\n  mistakeA: { wave: 'saw', freq: 140, freqEnd: 70, attack: 0.005, decay: 0.34, volume: 0.32, layers: [{ wave: 'noise', freq: 1200, decay: 0.2, volume: 0.25 }] },\n  // Monitors and crisis.\n  ekg: { wave: 'sine', freq: 1046, attack: 0.002, sustain: 0.05, decay: 0.03, volume: 0.1 },\n  alarm: { wave: 'square', duty: 0.5, freq: 988, attack: 0.002, sustain: 0.12, decay: 0.02, volume: 0.1, layers: [{ wave: 'square', duty: 0.5, delay: 0.17, freq: 784, attack: 0.002, sustain: 0.12, decay: 0.02, volume: 0.1 }] },\n  flatline: { wave: 'sine', freq: 1046, attack: 0.005, sustain: 1.8, decay: 0.1, volume: 0.16 },\n  charge: { wave: 'sine', freq: 300, freqEnd: 2600, attack: 0.02, sustain: 1.1, decay: 0.02, volume: 0.14, layers: [{ wave: 'square', duty: 0.125, freq: 600, freqEnd: 5200, attack: 0.02, sustain: 1.1, decay: 0.02, volume: 0.03 }] },\n  clear: { wave: 'noise', freq: 900, freqEnd: 120, attack: 0.002, sustain: 0.04, decay: 0.34, volume: 0.6, layers: [{ wave: 'sine', freq: 140, freqEnd: 40, decay: 0.4, volume: 0.7 }] },\n  badShock: { wave: 'saw', freq: 90, freqEnd: 60, decay: 0.3, volume: 0.3, crush: 5 },\n  massage: { wave: 'sine', freq: 100, freqEnd: 50, decay: 0.16, volume: 0.65, layers: [{ wave: 'noise', freq: 400, decay: 0.05, volume: 0.1 }] },\n  // UI.\n  uiMove: { wave: 'square', duty: 0.125, freq: 880, decay: 0.025, volume: 0.13 },\n  uiConfirm: { wave: 'square', duty: 0.25, freq: 660, decay: 0.09, volume: 0.2, arp: [0, 7], arpRate: 0.04 },\n  uiBack: { wave: 'square', duty: 0.25, freq: 440, freqEnd: 300, decay: 0.09, volume: 0.17 },\n  stamp: { wave: 'noise', freq: 500, freqEnd: 90, attack: 0.001, sustain: 0.02, decay: 0.22, volume: 0.6, layers: [{ wave: 'sine', freq: 90, freqEnd: 42, decay: 0.26, volume: 0.7 }] },\n  tally: { wave: 'square', duty: 0.125, freq: 1320, decay: 0.03, volume: 0.13 },\n  // Gifts.\n  heartbeat: { wave: 'sine', freq: 62, freqEnd: 38, decay: 0.16, volume: 0.65, layers: [{ wave: 'sine', delay: 0.2, freq: 54, freqEnd: 34, decay: 0.16, volume: 0.42 }] },\n  inhale: { wave: 'noise', freq: 900, freqEnd: 3200, attack: 0.3, sustain: 0.2, decay: 0.1, volume: 0.1 },\n  droneLoop: { wave: 'saw', freq: 55, attack: 0.3, sustain: 0.8, decay: 0.2, volume: 0.05, vibrato: { depth: 0.2, rate: 3 } },\n  rewind: { wave: 'saw', freq: 1400, freqEnd: 160, attack: 0.01, sustain: 0.5, decay: 0.2, volume: 0.15, vibrato: { depth: 3, rate: 31 }, layers: [{ wave: 'noise', freq: 7000, freqEnd: 1600, attack: 0.02, sustain: 0.5, decay: 0.2, volume: 0.15 }] },\n  denied: { wave: 'square', duty: 0.5, freq: 196, decay: 0.12, volume: 0.15, layers: [{ wave: 'square', duty: 0.5, delay: 0.1, freq: 185, decay: 0.14, volume: 0.15 }] },\n  // Strains.\n  knock: { wave: 'triangle', freq: 110, freqEnd: 60, decay: 0.09, volume: 0.65, layers: [{ wave: 'triangle', delay: 0.18, freq: 110, freqEnd: 60, decay: 0.09, volume: 0.65 }, { wave: 'triangle', delay: 0.36, freq: 110, freqEnd: 60, decay: 0.09, volume: 0.65 }] },\n  weep: { wave: 'sine', freq: 1200, freqEnd: 480, decay: 0.2, volume: 0.17, vibrato: { depth: 2, rate: 14 } },\n  sob: { wave: 'saw', freq: 240, freqEnd: 120, attack: 0.05, sustain: 0.3, decay: 0.3, volume: 0.25, vibrato: { depth: 1, rate: 7 }, layers: [{ wave: 'noise', freq: 800, attack: 0.05, sustain: 0.25, decay: 0.3, volume: 0.12 }] },\n  sobWave: { wave: 'noise', freq: 400, freqEnd: 90, attack: 0.02, sustain: 0.2, decay: 0.5, volume: 0.45, layers: [{ wave: 'saw', freq: 110, freqEnd: 45, decay: 0.6, volume: 0.3 }] },\n  wrath: { wave: 'saw', freq: 82, freqEnd: 41, attack: 0.005, decay: 0.26, volume: 0.32, crush: 7 },\n  thump: { wave: 'sine', freq: 72, freqEnd: 34, attack: 0.002, decay: 0.14, volume: 0.45 },\n  strainHit: { wave: 'saw', freq: 700, freqEnd: 120, decay: 0.22, volume: 0.28, layers: [{ wave: 'noise', freq: 3000, decay: 0.14, volume: 0.22 }] },\n  strainDie: { wave: 'saw', freq: 600, freqEnd: 40, attack: 0.02, sustain: 0.5, decay: 0.7, volume: 0.3, vibrato: { depth: 4, rate: 11 }, layers: [{ wave: 'noise', freq: 2000, freqEnd: 200, attack: 0.02, sustain: 0.4, decay: 0.6, volume: 0.18 }] },\n  choir: { wave: 'saw', freq: 440, attack: 0.15, sustain: 0.5, decay: 0.5, volume: 0.1, vibrato: { depth: 0.3, rate: 5 }, layers: [{ wave: 'saw', freq: 660, attack: 0.15, sustain: 0.5, decay: 0.5, volume: 0.07 }] },\n  // Rooms.\n  rainLoop: { wave: 'noise', freq: 5200, attack: 0.3, sustain: 1, decay: 0.3, volume: 0.05, crush: 0 },\n  horn: { wave: 'saw', freq: 73, attack: 0.25, sustain: 1.4, decay: 0.8, volume: 0.14, layers: [{ wave: 'saw', freq: 110, attack: 0.3, sustain: 1.3, decay: 0.8, volume: 0.08 }] },\n  bell: { wave: 'triangle', freq: 1046, decay: 0.7, volume: 0.1, layers: [{ wave: 'sine', freq: 2093, decay: 0.4, volume: 0.05 }, { wave: 'triangle', delay: 0.5, freq: 1046, decay: 0.6, volume: 0.09 }] },\n  thunder: { wave: 'noise', freq: 220, freqEnd: 60, attack: 0.05, sustain: 0.6, decay: 1.2, volume: 0.28 },\n  reaction: { wave: 'square', duty: 0.25, freq: 1100, freqEnd: 1800, decay: 0.08, volume: 0.15 },\n};\nEOF\ncat > src/content/songs.js <<'EOF'\n// Every song is original, written here as engine Song data. No source music, no real requiem.\nconst LEAD = { wave: 'triangle', decay: 0.34, volume: 0.15 };\nconst SOFT = { wave: 'sine', decay: 0.5, volume: 0.13 };\nconst BASS = { wave: 'square', duty: 0.125, decay: 0.24, volume: 0.075 };\nconst PULSE = { wave: 'square', duty: 0.25, decay: 0.09, volume: 0.05 };\nconst HAT = { wave: 'noise', decay: 0.03, volume: 0.03 };\nconst KICK = { wave: 'sine', decay: 0.1, volume: 0.22 };\nconst SNARE = { wave: 'noise', decay: 0.08, volume: 0.06 };\nconst CHOIR = { wave: 'saw', attack: 0.08, decay: 0.7, volume: 0.05, vibrato: { depth: 0.25, rate: 5 } };\nconst CHOIR2 = { wave: 'saw', attack: 0.1, decay: 0.8, volume: 0.04, vibrato: { depth: 0.3, rate: 4.4 } };\nconst JAZZ = { wave: 'triangle', decay: 0.22, volume: 0.1 };\nconst WALK = { wave: 'triangle', decay: 0.18, volume: 0.11 };\nconst REST16 = '. . . . . . . . . . . . . . . .';\n\nexport const SONGS = {\n  title: {\n    bpm: 66,\n    tracks: { lead: LEAD, pulse: { ...PULSE, volume: 0.03 }, bass: BASS },\n    patterns: {\n      a: { lead: 'A4 - - - C5 - E5 - D5 - - - B4 - - -', pulse: 'A3 . E4 . A3 . E4 . G3 . D4 . G3 . D4 .', bass: 'A2 - - - - - - - G2 - - - - - - -' },\n      b: { lead: 'C5 - - - D5 - E5 - G5 - - - F5 - E5 -', pulse: 'F3 . C4 . F3 . C4 . C3 . G3 . C3 . G3 .', bass: 'F2 - - - - - - - C2 - - - - - - -' },\n      c: { lead: 'E5 - - - D5 - C5 - B4 - - - A4 - G4 -', pulse: 'F3 . C4 . F3 . C4 . E3 . B3 . E3 . B3 .', bass: 'F2 - - - - - - - E2 - - - - - - -' },\n      d: { lead: 'A4 - - - - - - - . . E4 - A4 - - -', pulse: 'A3 . E4 . A3 . E4 . A3 . E4 . A3 . E4 .', bass: 'A2 - - - - - - - A2 - - - - - - -' },\n    },\n    order: ['a', 'b', 'c', 'd'],\n  },\n  ward: {\n    bpm: 84, stepsPerBeat: 2,\n    tracks: { lead: JAZZ, walk: WALK, comp: { wave: 'square', duty: 0.25, decay: 0.1, volume: 0.03 } },\n    patterns: {\n      a: { lead: 'F5 . . A5 G5 . E5 . D5 . . F5 E5 . C5 .', walk: 'D3 F3 A3 C4 G3 B3 D4 F3 C3 E3 G3 B3 A2 C3 E3 G3', comp: '. D4 . . . F4 . . . E4 . . . C4 . .' },\n      b: { lead: 'D5 . F5 . A5 . G5 F5 E5 . . . C5 . D5 .', walk: 'D3 A3 F3 A3 G3 D4 B3 G3 C3 G3 E3 G3 A2 E3 C3 E3', comp: '. F4 . . . A4 . . . G4 . . . E4 . .' },\n    },\n    order: ['a', 'b'],\n  },\n  'or-calm': {\n    bpm: 96,\n    tracks: { lead: SOFT, pulse: { ...PULSE, volume: 0.035 }, bass: BASS, hat: { ...HAT, volume: 0.015 } },\n    patterns: {\n      a: { lead: 'D5 . . . . . F5 . E5 . . . . . C5 .', pulse: 'D4 . F4 . A4 . F4 . C4 . E4 . G4 . E4 .', bass: 'D2 . . . D2 . . . C2 . . . C2 . . .', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n      b: { lead: 'A4 . . . . . Bb4 . A4 . G4 . F4 . . .', pulse: 'Bb3 . D4 . F4 . D4 . A3 . C4 . E4 . C4 .', bass: 'Bb1 . . . Bb1 . . . A1 . . . A1 . . .', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'or-tense': {\n    bpm: 104,\n    tracks: { lead: LEAD, pulse: PULSE, bass: BASS, hat: HAT, kick: KICK },\n    patterns: {\n      a: { lead: 'D5 - . D5 F5 - . E5 - . C5 - . . . .', pulse: 'D4 F4 A4 F4 D4 F4 A4 F4 C4 E4 G4 E4 C4 E4 G4 E4', bass: 'D2 . D2 . . D2 . . C2 . C2 . . C2 . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .' },\n      b: { lead: 'A5 - . G5 F5 - E5 . D5 - . E5 F5 - . .', pulse: 'Bb3 D4 F4 D4 Bb3 D4 F4 D4 A3 C#4 E4 C#4 A3 C#4 E4 C#4', bass: 'Bb1 . Bb1 . . Bb1 . . A1 . A1 . . A1 . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'or-critical': {\n    bpm: 120,\n    tracks: { lead: { ...LEAD, volume: 0.17 }, pulse: { ...PULSE, volume: 0.06 }, bass: { ...BASS, volume: 0.09 }, hat: HAT, kick: KICK, snare: SNARE },\n    patterns: {\n      a: { lead: 'D5 D5 . F5 . D5 . G#5 - . F5 . D5 . . .', pulse: 'D4 A4 D5 A4 D4 A4 D5 A4 D4 Bb4 D5 Bb4 D4 Bb4 D5 Bb4', bass: 'D2 D2 . D2 D2 . D2 . D2 D2 . D2 D2 . D2 .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', snare: '. . . . C6 . . . . . . . C6 . . .' },\n      b: { lead: 'A5 . G#5 . A5 . D6 - . C6 . A5 . G#5 . .', pulse: 'C#4 A4 C#5 A4 C#4 A4 C#5 A4 D4 A4 D5 A4 D4 A4 D5 A4', bass: 'A1 A1 . A1 A1 . A1 . D2 D2 . D2 D2 . D2 .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', snare: '. . . . C6 . . . . . . . C6 . C6 .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-introit': {\n    bpm: 92,\n    tracks: { choir: CHOIR, choir2: CHOIR2, bass: { ...BASS, duty: 0.25, volume: 0.09 }, knock: { wave: 'triangle', decay: 0.08, volume: 0.18 }, hat: { ...HAT, volume: 0.02 } },\n    patterns: {\n      a: { choir: 'E4 - - - - - - - F4 - - - - - E4 -', choir2: 'B3 - - - - - - - C4 - - - - - B3 -', bass: 'E2 . . E2 . . E2 . F2 . . F2 . . E2 .', knock: 'E3 . . E3 . . E3 . . . . . . . . .', hat: REST16 },\n      b: { choir: 'G4 - - - A4 - - - Bb4 - - - A4 - G4 -', choir2: 'D4 - - - E4 - - - F4 - - - E4 - D4 -', bass: 'C2 . . C2 . . C2 . Bb1 . . Bb1 . . A1 .', knock: 'E3 . . E3 . . E3 . . . . . E3 E3 . E3', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-lacrimosa': {\n    bpm: 76,\n    tracks: { choir: CHOIR, choir2: CHOIR2, drip: { wave: 'sine', decay: 0.14, volume: 0.09 }, bass: { ...BASS, volume: 0.07 } },\n    patterns: {\n      a: { choir: 'C5 - - - B4 - - - Bb4 - - - A4 - - -', choir2: 'G4 - - - F#4 - - - F4 - - - E4 - - -', drip: 'C6 . . G6 . . E6 . C6 . . A5 . . E6 .', bass: 'C2 - - - B1 - - - Bb1 - - - A1 - - -' },\n      b: { choir: 'F4 - - - Ab4 - - - G4 - - - - - - -', choir2: 'C4 - - - Eb4 - - - D4 - - - B3 - - -', drip: 'F6 . . C6 . . Ab5 . G6 . . D6 . . B5 .', bass: 'F1 - - - Ab1 - - - G1 - - - G1 - - -' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-diesirae': {\n    bpm: 144, // two steps a beat of the heart at 72: the director restarts it with the heart's tempo\n    tracks: { choir: { ...CHOIR, volume: 0.06 }, choir2: CHOIR2, bass: { ...BASS, duty: 0.25, volume: 0.1 }, kick: { ...KICK, volume: 0.28 }, hat: HAT },\n    patterns: {\n      a: { choir: 'D5 - - - C5 - - - Bb4 - - - A4 - - -', choir2: 'F4 - - - F4 - - - F4 - - - E4 - - -', bass: 'D2 D2 . D2 . D2 D2 . Bb1 Bb1 . Bb1 A1 A1 . A1', kick: 'C2 . C2 . . . . . C2 . C2 . . . . .', hat: '. . C8 . . . C8 . . . C8 . . . C8 .' },\n      b: { choir: 'F5 - - - E5 - - - D5 - C#5 - D5 - - -', choir2: 'A4 - - - G4 - - - F4 - E4 - F4 - - -', bass: 'D2 D2 . D2 . D2 D2 . C#2 C#2 . C#2 D2 D2 . D2', kick: 'C2 . C2 . . . . . C2 . C2 . . . . .', hat: '. . C8 . . . C8 . . . C8 . . . C8 .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-libera': {\n    bpm: 60,\n    tracks: { choir: { ...CHOIR, volume: 0.05 }, high: { wave: 'sine', attack: 0.2, decay: 0.8, volume: 0.05 } },\n    patterns: {\n      a: { choir: 'C4 - - - - - - - G4 - - - - - - -', high: 'E5 - - - - - - - D5 - - - - - - -' },\n      b: { choir: 'Ab4 - - - - - - - G4 - - - - - - -', high: 'C5 - - - - - - - B4 - - - - - - -' },\n    },\n    order: ['a', 'b'],\n  },\n  'boss-libera2': {\n    bpm: 112,\n    tracks: { choir: CHOIR, choir2: CHOIR2, bass: { ...BASS, volume: 0.1 }, kick: KICK, snare: SNARE, hat: HAT, knock: { wave: 'triangle', decay: 0.08, volume: 0.12 } },\n    patterns: {\n      a: { choir: 'C5 - - - Bb4 - - - Ab4 - - - G4 - - -', choir2: 'Eb4 - - - D4 - - - C4 - - - B3 - - -', bass: 'C2 C2 . C2 . C2 . C2 Ab1 Ab1 . Ab1 G1 G1 . G1', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', snare: '. . . . C6 . . . . . . . C6 . . .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', knock: 'E3 . . E3 . . E3 . . . . . . . . .' },\n      b: { choir: 'Eb5 - - - D5 - - - C5 - - - B4 - - -', choir2: 'G4 - - - F4 - - - Eb4 - - - D4 - - -', bass: 'C2 C2 . C2 . C2 . C2 G1 G1 . G1 G1 . G1 G1', kick: 'C2 . . . C2 . . . C2 . . . C2 C2 . .', snare: '. . . . C6 . . . . . . . C6 . C6 .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', knock: REST16 },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-libera3': {\n    bpm: 72,\n    tracks: { choir: { ...CHOIR, volume: 0.07 }, choir2: { ...CHOIR2, volume: 0.05 }, high: { wave: 'triangle', attack: 0.02, decay: 0.6, volume: 0.08 }, bass: { ...BASS, volume: 0.05 } },\n    patterns: {\n      a: { choir: 'C5 - - - E5 - - - F5 - - - E5 - - -', choir2: 'G4 - - - G4 - - - A4 - - - G4 - - -', high: 'G5 . . . . . C6 . . . A5 . . . G5 .', bass: 'C2 - - - - - - - F2 - - - C2 - - -' },\n      b: { choir: 'D5 - - - F5 - - - E5 - - - D5 - - -', choir2: 'A4 - - - C5 - - - G4 - - - G4 - - -', high: 'F5 . . . A5 . . . G5 . E5 . D5 . . .', bass: 'D2 - - - - - - - G2 - - - G2 - - -' },\n    },\n    order: ['a', 'b'],\n  },\n  op10: {\n    bpm: 58,\n    tracks: { lead: { wave: 'sine', attack: 0.04, decay: 0.8, volume: 0.1 }, low: { wave: 'triangle', decay: 0.9, volume: 0.07 } },\n    patterns: {\n      a: { lead: 'E5 - - - . . . . G5 - - - . . . .', low: 'A3 - - - - - - - E3 - - - - - - -' },\n      b: { lead: 'F5 - - - . . E5 - D5 - - - . . . .', low: 'F3 - - - - - - - G3 - - - - - - -' },\n      c: { lead: 'C5 - - - . . . . E5 - - - D5 - - -', low: 'C3 - - - - - - - G3 - - - - - - -' },\n    },\n    order: ['a', 'b', 'c', 'b'],\n  },\n  'results-win': {\n    bpm: 108, loop: false,\n    tracks: { lead: LEAD, pulse: PULSE, bass: BASS },\n    patterns: { a: { lead: 'D5 . F5 . A5 . D6 - - - A5 . D6 - - -', pulse: 'D4 F4 A4 F4 D4 F4 A4 F4 G4 Bb4 D5 Bb4 A4 C#5 E5 C#5', bass: 'D2 . . . . . . . G2 . . . A2 . . .' }, b: { lead: 'F6 - - - E6 - D6 - - - - - . . . .', pulse: 'D4 F4 A4 D5 . . . . . . . . . . . .', bass: 'D2 - - - - - - - - - - - . . . .' } },\n    order: ['a', 'b'],\n  },\n  'results-sad': {\n    bpm: 72, loop: false,\n    tracks: { lead: SOFT, bass: BASS },\n    patterns: { a: { lead: 'A4 - - - G4 - - - F4 - - - E4 - - -', bass: 'D2 - - - C2 - - - Bb1 - - - A1 - - -' }, b: { lead: 'D4 - - - - - - - . . . . . . . .', bass: 'D2 - - - - - - - . . . . . . . .' } },\n    order: ['a', 'b'],\n  },\n  credits: {\n    bpm: 88,\n    tracks: { lead: LEAD, pulse: { ...PULSE, volume: 0.035 }, bass: BASS, hat: { ...HAT, volume: 0.015 } },\n    patterns: {\n      a: { lead: 'C5 - - E5 G5 - - - A5 - G5 - E5 - - -', pulse: 'C4 E4 G4 E4 C4 E4 G4 E4 F4 A4 C5 A4 C4 E4 G4 E4', bass: 'C2 - - - G2 - - - F2 - - - C2 - - -', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n      b: { lead: 'D5 - - F5 A5 - - - G5 - E5 - C5 - - -', pulse: 'D4 F4 A4 F4 D4 F4 A4 F4 G3 B3 D4 B3 C4 E4 G4 E4', bass: 'D2 - - - A2 - - - G2 - - - C2 - - -', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n    },\n    order: ['a', 'b', 'a', 'b'],\n  },\n};\n\nexport const stepsPerBar = (song) => 4 * (song.stepsPerBeat ?? 4);\nexport const barSeconds = (song) => (60 / song.bpm) * 4;\nEOF\ncat > src/audio/director.js <<'EOF'\n// The music director: changes tracks at bar lines, follows vitals in surgery, keeps Dies Irae on the\n// heart's tempo. `loadGame` clears music, so each stage calls `onStage()`.\nimport { barSeconds, SONGS } from '../content/songs.js';\n\nconst OR_FAMILY = new Set(['or-calm', 'or-tense', 'or-critical']);\n\nexport class MusicDirector {\n  constructor() {\n    this.audio = null;\n    this.current = null; // id playing\n    this.pending = null; // { id, song }\n    this.startedAt = 0;\n    this.clock = 0;\n    this.bpmOverride = null;\n    this.moodBase = null;\n  }\n  attach(audio) { this.audio = audio; }\n  onStage() {\n    // A level load stopped the music: bring back whatever we were playing, or what's pending.\n    if (this.pending) { this._start(this.pending.id, this.pending.song); this.pending = null; return; }\n    if (this.current) this._start(this.current, this._songFor(this.current));\n  }\n  _songFor(id) {\n    if (!id || id === 'silence') return null;\n    const s = SONGS[id];\n    if (!s) return null;\n    return this.bpmOverride && id === 'boss-diesirae' ? { ...s, bpm: this.bpmOverride } : s;\n  }\n  _start(id, song) {\n    this.current = id;\n    this.startedAt = this.clock;\n    this.currentSong = song;\n    this.audio?.playMusic(song ?? null, id ?? 'none');\n  }\n  /** Change music now (between stages) or at the next bar line. */\n  play(id, { now = false } = {}) {\n    if (id === this.current && !this.pending) return;\n    if (this.pending?.id === id) return;\n    const song = this._songFor(id);\n    if (now || !this.currentSong) { this.pending = null; this._start(id, song); return; }\n    this.pending = { id, song };\n  }\n  /** Follow the vitals inside the or-* family. */\n  mood(vitals) {\n    if (!OR_FAMILY.has(this.current) && !OR_FAMILY.has(this.pending?.id)) return;\n    const want = vitals < 22 ? 'or-critical' : vitals < 45 ? 'or-tense' : this.moodBase ?? this.current;\n    if (want !== (this.pending?.id ?? this.current)) this.play(want);\n  }\n  setBase(id) { this.moodBase = OR_FAMILY.has(id) ? id : null; }\n  /** The heart's tempo: two steps a heartbeat, restarted at bar lines. */\n  heartTempo(bpm) {\n    const b = Math.round(bpm * 2);\n    if (this.current !== 'boss-diesirae' || this.bpmOverride === b) return;\n    this.bpmOverride = b;\n    this.pending = { id: 'boss-diesirae', song: { ...SONGS['boss-diesirae'], bpm: b } };\n  }\n  update(dt) {\n    this.clock += dt;\n    if (!this.pending) return;\n    const song = this.currentSong;\n    const bar = song ? barSeconds(song) : 0;\n    const t = this.clock - this.startedAt;\n    if (!song || bar <= 0 || t % bar < dt * 1.5) {\n      const p = this.pending;\n      this.pending = null;\n      this._start(p.id, p.song);\n    }\n  }\n  stop() {\n    this.pending = null;\n    this.current = null;\n    this.currentSong = null;\n    this.bpmOverride = null;\n    this.audio?.playMusic(null);\n  }\n}\nEOF\ncat > src/core/save.js <<'EOF'\n// Saves and settings: guarded localStorage under a versioned key. In a hub session the client hands\n// the page an empty store; a replay or a test can swap the store.\nconst KEY = 'trauma-central-second-stitch:v1';\n\nexport const DEFAULT_SETTINGS = Object.freeze({\n  sound: 0.8, voices: 0.8, glyphs: 'playstation', aimAssist: 'low', cursorSpeed: 1, rumble: true, giftMode: 'hold', look: 'surgical', pixelSize: 1, shake: 1, reduceFlashes: false, textSpeed: 1, difficulty: 'resident',\n});\nexport const newProgress = () => ({ episode: 0, stage: 'scene', difficulty: 'resident', cleared: {}, finished: false, retries: {} });\n\nconst store = () => { try { return typeof localStorage === 'undefined' ? null : localStorage; } catch { return null; } };\n\nexport function loadSave() {\n  const s = store();\n  let data = null;\n  if (s) { try { data = JSON.parse(s.getItem(KEY) ?? 'null'); } catch { data = null; } }\n  return {\n    settings: { ...DEFAULT_SETTINGS, ...(data?.settings ?? {}) },\n    progress: data?.progress ? { ...newProgress(), ...data.progress } : null,\n    log: data?.log ?? {},\n    hasSave: !!data?.progress,\n  };\n}\nexport function writeSave(save) {\n  const s = store();\n  if (!s) return false;\n  try { s.setItem(KEY, JSON.stringify({ settings: save.settings, progress: save.progress, log: save.log })); return true; } catch { return false; }\n}\nexport const SAVE_KEY = KEY;\nEOF\ncat > src/sim/campaign.js <<'EOF'\n// The shift, as data and pure functions: which scene and which op follow which. Uses no engine.\nexport const EPISODES = [\n  { scene: 'ep1', op: 'op1' }, { scene: 'ep2', op: 'op2' }, { scene: 'ep3', op: 'op3' }, { scene: 'ep4', op: 'op4' }, { scene: 'ep5', op: 'op5' },\n  { scene: 'ep6', op: 'op6' }, { scene: 'ep7', op: 'op7' }, { scene: 'ep8', op: 'op8' }, { scene: 'ep9', op: 'op9' }, { scene: 'ep10', op: 'op10' },\n];\nexport const END_SCENE = 'end';\n\n/** After finishing the scene or op of `progress`, what comes next. */\nexport function advance(progress) {\n  if (progress.stage === 'scene') return { ...progress, stage: 'op' };\n  if (progress.stage === 'op') {\n    const n = progress.episode + 1;\n    if (n >= EPISODES.length) return { ...progress, stage: 'end', episode: n };\n    return { ...progress, stage: 'scene', episode: n };\n  }\n  return { ...progress, finished: true, stage: 'done' };\n}\nexport const currentStep = (progress) => {\n  if (progress.stage === 'end') return { kind: 'scene', id: END_SCENE };\n  if (progress.stage === 'done') return { kind: 'done' };\n  const ep = EPISODES[progress.episode];\n  return progress.stage === 'scene' ? { kind: 'scene', id: ep.scene, ep: progress.episode } : { kind: 'op', id: ep.op, ep: progress.episode };\n};\nEOF\necho done","description":"Write voices, sound effects, songs, director, saves, campaign"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17792,"cache_read_input_tokens":321226,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17792},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"29d94fce-aeea-4cf4-afae-669b46320fd6","timestamp":"2026-11-05T15:50:37.873Z","request_id":"req_011Cgk3U7om9ZtK3Y2NCkZeH","wire_tool_inputs":{"toolu_018KzjFgsGkyAFNPwmHEH4uo":{"command":"cat > src/audio/voice.js <<'EOF'\n// Animalese/Simlish gibberish: syllables rendered in pure JS (a glottal pulse through three formants),\n// wrapped as WAV data URLs for the engine's buses. Letters pick syllables deterministically; punctuation\n// shapes rhythm and pitch. No audio files, no real words. Testable in Node.\nconst VOWELS = { a: [730, 1090, 2440], e: [530, 1840, 2480], i: [300, 2290, 3010], o: [570, 840, 2410], u: [320, 870, 2240] };\nconst ONSETS = ['v', 't', 'm']; // vowel, plosive, nasal\nexport const TIMBRES = {\n  low: { f0: 105, bright: 0.55, shift: 0.9 },\n  mid: { f0: 170, bright: 0.7, shift: 1 },\n  high: { f0: 250, bright: 0.85, shift: 1.12 },\n};\nconst RATE = 22050;\n\n/** One syllable, 120 ms, as Float32 samples in -1..1. */\nexport function renderSyllable(timbreId, vowel, onset) {\n  const T = TIMBRES[timbreId];\n  const n = Math.round(RATE * 0.12);\n  const out = new Float32Array(n);\n  const F = VOWELS[vowel].map((f) => f * T.shift);\n  const bw = [80, 110, 170];\n  const res = F.map((f, k) => {\n    const r = Math.exp((-Math.PI * bw[k]) / RATE);\n    return { a1: 2 * r * Math.cos((2 * Math.PI * f) / RATE), a2: -r * r, g: 1 - r, y1: 0, y2: 0 };\n  });\n  let phase = 0, seed = (timbreId.length * 31 + vowel.charCodeAt(0) * 7 + onset.charCodeAt(0)) | 0;\n  const noise = () => { seed = (seed * 1664525 + 1013904223) | 0; return ((seed >>> 16) & 0x7fff) / 16384 - 1; };\n  for (let i = 0; i < n; i++) {\n    const t = i / RATE;\n    phase += (T.f0 * (1 + 0.04 * Math.sin(t * 34))) / RATE;\n    if (phase >= 1) phase -= 1;\n    // A glottal pulse: quick rise, slow fall.\n    let g = phase < 0.4 ? Math.sin((phase / 0.4) * Math.PI) ** 2 : 0;\n    g -= 0.3 * T.bright * (phase < 0.08 ? 1 - phase / 0.08 : 0);\n    let voiced = 1;\n    if (onset === 't' && t < 0.014) { g = noise() * 0.9; voiced = 1; }\n    if (onset === 't' && t >= 0.014 && t < 0.03) voiced = 0.25;\n    if (onset === 'm' && t < 0.035) voiced = 0.4;\n    const input = g * voiced;\n    let s = 0;\n    res.forEach((f, k) => {\n      const y = input * f.g + f.a1 * f.y1 + f.a2 * f.y2;\n      f.y2 = f.y1;\n      f.y1 = y;\n      s += y * (k === 0 ? 1 : k === 1 ? 0.7 * T.bright + 0.15 : 0.3 * T.bright);\n    });\n    const env = Math.min(1, t / 0.008) * Math.min(1, (0.12 - t) / 0.04);\n    out[i] = s * env * 2.6;\n  }\n  let peak = 0;\n  for (let i = 0; i < n; i++) peak = Math.max(peak, Math.abs(out[i]));\n  if (peak > 0) for (let i = 0; i < n; i++) out[i] = (out[i] / peak) * 0.82;\n  return out;\n}\n\nexport function wavDataUrl(samples) {\n  const n = samples.length;\n  const buf = new Uint8Array(44 + n * 2);\n  const v = new DataView(buf.buffer);\n  const w = (o, s) => { for (let i = 0; i < s.length; i++) buf[o + i] = s.charCodeAt(i); };\n  w(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); w(8, 'WAVEfmt '); v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);\n  v.setUint32(24, RATE, true); v.setUint32(28, RATE * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true); w(36, 'data'); v.setUint32(40, n * 2, true);\n  for (let i = 0; i < n; i++) v.setInt16(44 + i * 2, Math.max(-1, Math.min(1, samples[i])) * 32767, true);\n  let bin = '';\n  for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode.apply(null, buf.subarray(i, i + 0x8000));\n  const b64 = typeof btoa === 'function' ? btoa(bin) : Buffer.from(buf).toString('base64');\n  return `data:audio/wav;base64,${b64}`;\n}\n\nexport const syllableName = (timbre, vowel, onset) => `syl-${timbre}-${vowel}-${onset}`;\nexport const ALL_SYLLABLES = Object.keys(TIMBRES).flatMap((t) => Object.keys(VOWELS).flatMap((v) => ONSETS.map((o) => ({ t, v, o, name: syllableName(t, v, o) }))));\n\n// Who sounds like what. basePitch in semitones on top of the timbre; range: how far the melody wanders.\nexport const VOICES = {\n  ilya: { timbre: 'high', basePitch: -2, speed: 1.25, range: 3.2, volume: 0.85 },\n  reyes: { timbre: 'mid', basePitch: -3, speed: 1.15, range: 1.6, volume: 0.95 },\n  sabine: { timbre: 'low', basePitch: 2, speed: 0.8, range: 0.8, volume: 0.8 },\n  bram: { timbre: 'low', basePitch: -4, speed: 0.7, range: 1.4, volume: 0.9 },\n  pem: { timbre: 'low', basePitch: 3, speed: 0.75, range: 3.8, volume: 0.8 },\n  hesper: { timbre: 'mid', basePitch: 0, speed: 0.72, range: 1.2, volume: 0.65 },\n  tomasz: { timbre: 'low', basePitch: 0, speed: 1, range: 2, volume: 0.85 },\n  zamboni: { timbre: 'mid', basePitch: 1, speed: 1.1, range: 4, volume: 0.85 },\n  anselm: { timbre: 'mid', basePitch: -1, speed: 0.8, range: 0.6, volume: 0.7 },\n  ottilie: { timbre: 'mid', basePitch: 2, speed: 0.85, range: 1.5, volume: 0.7 },\n  ollie: { timbre: 'high', basePitch: 1, speed: 1.2, range: 2.5, volume: 0.8 },\n};\n\nconst VOWEL_KEYS = Object.keys(VOWELS);\nconst isLetter = (c) => /[a-z]/i.test(c);\n\n/** What the voice does at character i of text: null, or a syllable to play. Pure and deterministic. */\nexport function syllableAt(whoId, text, i) {\n  const V = VOICES[whoId] ?? VOICES.reyes;\n  const c = text[i];\n  if (!c || !isLetter(c)) return null;\n  // A syllable every couple of letters, on a vowel where there is one.\n  const lower = c.toLowerCase();\n  const isV = 'aeiou'.includes(lower);\n  if (!isV && i % 3 !== 0) return null;\n  const code = lower.charCodeAt(0);\n  const vowel = isV ? lower : VOWEL_KEYS[code % 5];\n  const onset = ONSETS[(code + i) % 3];\n  // Melody: word position plus the sentence's end.\n  let end = text.length;\n  for (let k = i; k < text.length; k++) if ('.!?'.includes(text[k])) { end = k; break; }\n  const mark = text[end] ?? '.';\n  const toEnd = end - i;\n  let pitch = V.basePitch + Math.sin(i * 1.7 + code) * V.range;\n  let volume = V.volume;\n  if (mark === '!') { pitch += 2 + (toEnd < 6 ? 2 : 0); volume *= 1.15; }\n  if (mark === '?' && toEnd < 6) pitch += (6 - toEnd) * 0.9;\n  if (mark === '.' && toEnd < 4) pitch -= (4 - toEnd) * 0.5;\n  return { name: syllableName(V.timbre, vowel, onset), pitch, volume: Math.min(1, volume) };\n}\n/** Pause after a character, in characters of typewriter time. */\nexport function pauseAfter(c, text, i) {\n  if (c === '.' && text[i + 1] === '.') return 3;\n  if (c === '.' || c === '!' || c === '?') return 8;\n  if (c === ',' || c === ':' || c === ';') return 4;\n  if (c === '-') return 3;\n  return 0;\n}\nEOF\ncat > src/content/sfx.js <<'EOF'\n// Every sound effect, as engine SoundDef data.\nexport const SFX_DEFS = {\n  // Tools.\n  drainLoop: { wave: 'noise', freq: 2200, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.16, layers: [{ wave: 'square', duty: 0.25, freq: 70, freqEnd: 95, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.06, vibrato: { depth: 3, rate: 22 } }] },\n  slurp: { wave: 'triangle', freq: 180, freqEnd: 820, attack: 0.005, sustain: 0.08, decay: 0.08, volume: 0.3, layers: [{ wave: 'noise', freq: 4000, attack: 0.005, sustain: 0.05, decay: 0.07, volume: 0.12 }] },\n  click: { wave: 'square', duty: 0.125, freq: 1800, freqEnd: 900, decay: 0.03, volume: 0.22 },\n  hookPop: { wave: 'square', duty: 0.25, freq: 260, freqEnd: 1100, attack: 0.003, decay: 0.09, volume: 0.28, layers: [{ wave: 'noise', freq: 6000, decay: 0.03, volume: 0.1 }] },\n  dishTink: { wave: 'triangle', freq: 2640, decay: 0.28, volume: 0.3, layers: [{ wave: 'sine', freq: 3960, decay: 0.2, volume: 0.14 }, { wave: 'sine', freq: 1320, delay: 0.09, decay: 0.12, volume: 0.1 }] },\n  slice: { wave: 'noise', freq: 9000, freqEnd: 3200, attack: 0.01, sustain: 0.06, decay: 0.08, volume: 0.22 },\n  cutLoop: { wave: 'noise', freq: 7000, attack: 0.01, sustain: 0.4, decay: 0.01, volume: 0.05 },\n  stitch: { wave: 'triangle', freq: 660, decay: 0.08, volume: 0.32, layers: [{ wave: 'noise', freq: 8000, decay: 0.012, volume: 0.1 }] },\n  knot: { wave: 'square', duty: 0.25, freq: 520, freqEnd: 300, decay: 0.09, volume: 0.22, layers: [{ wave: 'triangle', delay: 0.07, freq: 880, decay: 0.12, volume: 0.25 }] },\n  laserLoop: { wave: 'saw', freq: 110, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.12, vibrato: { depth: 0.5, rate: 60 }, layers: [{ wave: 'square', duty: 0.125, freq: 1760, attack: 0.02, sustain: 0.5, decay: 0.02, volume: 0.035 }] },\n  sizzle: { wave: 'noise', freq: 9000, attack: 0.005, sustain: 0.1, decay: 0.24, volume: 0.25, crush: 12 },\n  ping: { wave: 'sine', freq: 1568, decay: 0.32, volume: 0.32, arp: [0, 12], arpRate: 0.07 },\n  scanLoop: { wave: 'sine', freq: 620, attack: 0.05, sustain: 0.6, decay: 0.05, volume: 0.05, vibrato: { depth: 1.5, rate: 8 } },\n  gelLoop: { wave: 'noise', freq: 3400, attack: 0.03, sustain: 0.5, decay: 0.03, volume: 0.08, crush: 6 },\n  syringeDraw: { wave: 'sine', freq: 300, freqEnd: 900, attack: 0.02, sustain: 0.36, decay: 0.04, volume: 0.14 },\n  syringeReady: { wave: 'triangle', freq: 1320, decay: 0.08, volume: 0.25 },\n  inject: { wave: 'noise', freq: 5000, freqEnd: 600, attack: 0.01, sustain: 0.1, decay: 0.2, volume: 0.22, layers: [{ wave: 'sine', freq: 880, freqEnd: 330, decay: 0.3, volume: 0.2 }] },\n  grab: { wave: 'square', duty: 0.25, freq: 900, decay: 0.03, volume: 0.2, layers: [{ wave: 'square', duty: 0.125, delay: 0.03, freq: 1400, decay: 0.03, volume: 0.15 }] },\n  tick: { wave: 'square', duty: 0.125, freq: 240, decay: 0.05, volume: 0.22 },\n  dressing: { wave: 'noise', freq: 1600, attack: 0.02, sustain: 0.1, decay: 0.1, volume: 0.1 },\n  heal: { wave: 'triangle', freq: 660, decay: 0.2, volume: 0.2, arp: [0, 4, 7], arpRate: 0.05 },\n  // Ratings.\n  cleanA: { wave: 'triangle', freq: 880, decay: 0.2, volume: 0.28, arp: [0, 7], arpRate: 0.06 },\n  goodA: { wave: 'triangle', freq: 660, decay: 0.16, volume: 0.24 },\n  sloppyA: { wave: 'square', duty: 0.25, freq: 220, freqEnd: 160, decay: 0.18, volume: 0.2 },\n  mistakeA: { wave: 'saw', freq: 140, freqEnd: 70, attack: 0.005, decay: 0.34, volume: 0.32, layers: [{ wave: 'noise', freq: 1200, decay: 0.2, volume: 0.25 }] },\n  // Monitors and crisis.\n  ekg: { wave: 'sine', freq: 1046, attack: 0.002, sustain: 0.05, decay: 0.03, volume: 0.1 },\n  alarm: { wave: 'square', duty: 0.5, freq: 988, attack: 0.002, sustain: 0.12, decay: 0.02, volume: 0.1, layers: [{ wave: 'square', duty: 0.5, delay: 0.17, freq: 784, attack: 0.002, sustain: 0.12, decay: 0.02, volume: 0.1 }] },\n  flatline: { wave: 'sine', freq: 1046, attack: 0.005, sustain: 1.8, decay: 0.1, volume: 0.16 },\n  charge: { wave: 'sine', freq: 300, freqEnd: 2600, attack: 0.02, sustain: 1.1, decay: 0.02, volume: 0.14, layers: [{ wave: 'square', duty: 0.125, freq: 600, freqEnd: 5200, attack: 0.02, sustain: 1.1, decay: 0.02, volume: 0.03 }] },\n  clear: { wave: 'noise', freq: 900, freqEnd: 120, attack: 0.002, sustain: 0.04, decay: 0.34, volume: 0.6, layers: [{ wave: 'sine', freq: 140, freqEnd: 40, decay: 0.4, volume: 0.7 }] },\n  badShock: { wave: 'saw', freq: 90, freqEnd: 60, decay: 0.3, volume: 0.3, crush: 5 },\n  massage: { wave: 'sine', freq: 100, freqEnd: 50, decay: 0.16, volume: 0.65, layers: [{ wave: 'noise', freq: 400, decay: 0.05, volume: 0.1 }] },\n  // UI.\n  uiMove: { wave: 'square', duty: 0.125, freq: 880, decay: 0.025, volume: 0.13 },\n  uiConfirm: { wave: 'square', duty: 0.25, freq: 660, decay: 0.09, volume: 0.2, arp: [0, 7], arpRate: 0.04 },\n  uiBack: { wave: 'square', duty: 0.25, freq: 440, freqEnd: 300, decay: 0.09, volume: 0.17 },\n  stamp: { wave: 'noise', freq: 500, freqEnd: 90, attack: 0.001, sustain: 0.02, decay: 0.22, volume: 0.6, layers: [{ wave: 'sine', freq: 90, freqEnd: 42, decay: 0.26, volume: 0.7 }] },\n  tally: { wave: 'square', duty: 0.125, freq: 1320, decay: 0.03, volume: 0.13 },\n  // Gifts.\n  heartbeat: { wave: 'sine', freq: 62, freqEnd: 38, decay: 0.16, volume: 0.65, layers: [{ wave: 'sine', delay: 0.2, freq: 54, freqEnd: 34, decay: 0.16, volume: 0.42 }] },\n  inhale: { wave: 'noise', freq: 900, freqEnd: 3200, attack: 0.3, sustain: 0.2, decay: 0.1, volume: 0.1 },\n  droneLoop: { wave: 'saw', freq: 55, attack: 0.3, sustain: 0.8, decay: 0.2, volume: 0.05, vibrato: { depth: 0.2, rate: 3 } },\n  rewind: { wave: 'saw', freq: 1400, freqEnd: 160, attack: 0.01, sustain: 0.5, decay: 0.2, volume: 0.15, vibrato: { depth: 3, rate: 31 }, layers: [{ wave: 'noise', freq: 7000, freqEnd: 1600, attack: 0.02, sustain: 0.5, decay: 0.2, volume: 0.15 }] },\n  denied: { wave: 'square', duty: 0.5, freq: 196, decay: 0.12, volume: 0.15, layers: [{ wave: 'square', duty: 0.5, delay: 0.1, freq: 185, decay: 0.14, volume: 0.15 }] },\n  // Strains.\n  knock: { wave: 'triangle', freq: 110, freqEnd: 60, decay: 0.09, volume: 0.65, layers: [{ wave: 'triangle', delay: 0.18, freq: 110, freqEnd: 60, decay: 0.09, volume: 0.65 }, { wave: 'triangle', delay: 0.36, freq: 110, freqEnd: 60, decay: 0.09, volume: 0.65 }] },\n  weep: { wave: 'sine', freq: 1200, freqEnd: 480, decay: 0.2, volume: 0.17, vibrato: { depth: 2, rate: 14 } },\n  sob: { wave: 'saw', freq: 240, freqEnd: 120, attack: 0.05, sustain: 0.3, decay: 0.3, volume: 0.25, vibrato: { depth: 1, rate: 7 }, layers: [{ wave: 'noise', freq: 800, attack: 0.05, sustain: 0.25, decay: 0.3, volume: 0.12 }] },\n  sobWave: { wave: 'noise', freq: 400, freqEnd: 90, attack: 0.02, sustain: 0.2, decay: 0.5, volume: 0.45, layers: [{ wave: 'saw', freq: 110, freqEnd: 45, decay: 0.6, volume: 0.3 }] },\n  wrath: { wave: 'saw', freq: 82, freqEnd: 41, attack: 0.005, decay: 0.26, volume: 0.32, crush: 7 },\n  thump: { wave: 'sine', freq: 72, freqEnd: 34, attack: 0.002, decay: 0.14, volume: 0.45 },\n  strainHit: { wave: 'saw', freq: 700, freqEnd: 120, decay: 0.22, volume: 0.28, layers: [{ wave: 'noise', freq: 3000, decay: 0.14, volume: 0.22 }] },\n  strainDie: { wave: 'saw', freq: 600, freqEnd: 40, attack: 0.02, sustain: 0.5, decay: 0.7, volume: 0.3, vibrato: { depth: 4, rate: 11 }, layers: [{ wave: 'noise', freq: 2000, freqEnd: 200, attack: 0.02, sustain: 0.4, decay: 0.6, volume: 0.18 }] },\n  choir: { wave: 'saw', freq: 440, attack: 0.15, sustain: 0.5, decay: 0.5, volume: 0.1, vibrato: { depth: 0.3, rate: 5 }, layers: [{ wave: 'saw', freq: 660, attack: 0.15, sustain: 0.5, decay: 0.5, volume: 0.07 }] },\n  // Rooms.\n  rainLoop: { wave: 'noise', freq: 5200, attack: 0.3, sustain: 1, decay: 0.3, volume: 0.05, crush: 0 },\n  horn: { wave: 'saw', freq: 73, attack: 0.25, sustain: 1.4, decay: 0.8, volume: 0.14, layers: [{ wave: 'saw', freq: 110, attack: 0.3, sustain: 1.3, decay: 0.8, volume: 0.08 }] },\n  bell: { wave: 'triangle', freq: 1046, decay: 0.7, volume: 0.1, layers: [{ wave: 'sine', freq: 2093, decay: 0.4, volume: 0.05 }, { wave: 'triangle', delay: 0.5, freq: 1046, decay: 0.6, volume: 0.09 }] },\n  thunder: { wave: 'noise', freq: 220, freqEnd: 60, attack: 0.05, sustain: 0.6, decay: 1.2, volume: 0.28 },\n  reaction: { wave: 'square', duty: 0.25, freq: 1100, freqEnd: 1800, decay: 0.08, volume: 0.15 },\n};\nEOF\ncat > src/content/songs.js <<'EOF'\n// Every song is original, written here as engine Song data. No source music, no real requiem.\nconst LEAD = { wave: 'triangle', decay: 0.34, volume: 0.15 };\nconst SOFT = { wave: 'sine', decay: 0.5, volume: 0.13 };\nconst BASS = { wave: 'square', duty: 0.125, decay: 0.24, volume: 0.075 };\nconst PULSE = { wave: 'square', duty: 0.25, decay: 0.09, volume: 0.05 };\nconst HAT = { wave: 'noise', decay: 0.03, volume: 0.03 };\nconst KICK = { wave: 'sine', decay: 0.1, volume: 0.22 };\nconst SNARE = { wave: 'noise', decay: 0.08, volume: 0.06 };\nconst CHOIR = { wave: 'saw', attack: 0.08, decay: 0.7, volume: 0.05, vibrato: { depth: 0.25, rate: 5 } };\nconst CHOIR2 = { wave: 'saw', attack: 0.1, decay: 0.8, volume: 0.04, vibrato: { depth: 0.3, rate: 4.4 } };\nconst JAZZ = { wave: 'triangle', decay: 0.22, volume: 0.1 };\nconst WALK = { wave: 'triangle', decay: 0.18, volume: 0.11 };\nconst REST16 = '. . . . . . . . . . . . . . . .';\n\nexport const SONGS = {\n  title: {\n    bpm: 66,\n    tracks: { lead: LEAD, pulse: { ...PULSE, volume: 0.03 }, bass: BASS },\n    patterns: {\n      a: { lead: 'A4 - - - C5 - E5 - D5 - - - B4 - - -', pulse: 'A3 . E4 . A3 . E4 . G3 . D4 . G3 . D4 .', bass: 'A2 - - - - - - - G2 - - - - - - -' },\n      b: { lead: 'C5 - - - D5 - E5 - G5 - - - F5 - E5 -', pulse: 'F3 . C4 . F3 . C4 . C3 . G3 . C3 . G3 .', bass: 'F2 - - - - - - - C2 - - - - - - -' },\n      c: { lead: 'E5 - - - D5 - C5 - B4 - - - A4 - G4 -', pulse: 'F3 . C4 . F3 . C4 . E3 . B3 . E3 . B3 .', bass: 'F2 - - - - - - - E2 - - - - - - -' },\n      d: { lead: 'A4 - - - - - - - . . E4 - A4 - - -', pulse: 'A3 . E4 . A3 . E4 . A3 . E4 . A3 . E4 .', bass: 'A2 - - - - - - - A2 - - - - - - -' },\n    },\n    order: ['a', 'b', 'c', 'd'],\n  },\n  ward: {\n    bpm: 84, stepsPerBeat: 2,\n    tracks: { lead: JAZZ, walk: WALK, comp: { wave: 'square', duty: 0.25, decay: 0.1, volume: 0.03 } },\n    patterns: {\n      a: { lead: 'F5 . . A5 G5 . E5 . D5 . . F5 E5 . C5 .', walk: 'D3 F3 A3 C4 G3 B3 D4 F3 C3 E3 G3 B3 A2 C3 E3 G3', comp: '. D4 . . . F4 . . . E4 . . . C4 . .' },\n      b: { lead: 'D5 . F5 . A5 . G5 F5 E5 . . . C5 . D5 .', walk: 'D3 A3 F3 A3 G3 D4 B3 G3 C3 G3 E3 G3 A2 E3 C3 E3', comp: '. F4 . . . A4 . . . G4 . . . E4 . .' },\n    },\n    order: ['a', 'b'],\n  },\n  'or-calm': {\n    bpm: 96,\n    tracks: { lead: SOFT, pulse: { ...PULSE, volume: 0.035 }, bass: BASS, hat: { ...HAT, volume: 0.015 } },\n    patterns: {\n      a: { lead: 'D5 . . . . . F5 . E5 . . . . . C5 .', pulse: 'D4 . F4 . A4 . F4 . C4 . E4 . G4 . E4 .', bass: 'D2 . . . D2 . . . C2 . . . C2 . . .', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n      b: { lead: 'A4 . . . . . Bb4 . A4 . G4 . F4 . . .', pulse: 'Bb3 . D4 . F4 . D4 . A3 . C4 . E4 . C4 .', bass: 'Bb1 . . . Bb1 . . . A1 . . . A1 . . .', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'or-tense': {\n    bpm: 104,\n    tracks: { lead: LEAD, pulse: PULSE, bass: BASS, hat: HAT, kick: KICK },\n    patterns: {\n      a: { lead: 'D5 - . D5 F5 - . E5 - . C5 - . . . .', pulse: 'D4 F4 A4 F4 D4 F4 A4 F4 C4 E4 G4 E4 C4 E4 G4 E4', bass: 'D2 . D2 . . D2 . . C2 . C2 . . C2 . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .' },\n      b: { lead: 'A5 - . G5 F5 - E5 . D5 - . E5 F5 - . .', pulse: 'Bb3 D4 F4 D4 Bb3 D4 F4 D4 A3 C#4 E4 C#4 A3 C#4 E4 C#4', bass: 'Bb1 . Bb1 . . Bb1 . . A1 . A1 . . A1 . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'or-critical': {\n    bpm: 120,\n    tracks: { lead: { ...LEAD, volume: 0.17 }, pulse: { ...PULSE, volume: 0.06 }, bass: { ...BASS, volume: 0.09 }, hat: HAT, kick: KICK, snare: SNARE },\n    patterns: {\n      a: { lead: 'D5 D5 . F5 . D5 . G#5 - . F5 . D5 . . .', pulse: 'D4 A4 D5 A4 D4 A4 D5 A4 D4 Bb4 D5 Bb4 D4 Bb4 D5 Bb4', bass: 'D2 D2 . D2 D2 . D2 . D2 D2 . D2 D2 . D2 .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', snare: '. . . . C6 . . . . . . . C6 . . .' },\n      b: { lead: 'A5 . G#5 . A5 . D6 - . C6 . A5 . G#5 . .', pulse: 'C#4 A4 C#5 A4 C#4 A4 C#5 A4 D4 A4 D5 A4 D4 A4 D5 A4', bass: 'A1 A1 . A1 A1 . A1 . D2 D2 . D2 D2 . D2 .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', snare: '. . . . C6 . . . . . . . C6 . C6 .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-introit': {\n    bpm: 92,\n    tracks: { choir: CHOIR, choir2: CHOIR2, bass: { ...BASS, duty: 0.25, volume: 0.09 }, knock: { wave: 'triangle', decay: 0.08, volume: 0.18 }, hat: { ...HAT, volume: 0.02 } },\n    patterns: {\n      a: { choir: 'E4 - - - - - - - F4 - - - - - E4 -', choir2: 'B3 - - - - - - - C4 - - - - - B3 -', bass: 'E2 . . E2 . . E2 . F2 . . F2 . . E2 .', knock: 'E3 . . E3 . . E3 . . . . . . . . .', hat: REST16 },\n      b: { choir: 'G4 - - - A4 - - - Bb4 - - - A4 - G4 -', choir2: 'D4 - - - E4 - - - F4 - - - E4 - D4 -', bass: 'C2 . . C2 . . C2 . Bb1 . . Bb1 . . A1 .', knock: 'E3 . . E3 . . E3 . . . . . E3 E3 . E3', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-lacrimosa': {\n    bpm: 76,\n    tracks: { choir: CHOIR, choir2: CHOIR2, drip: { wave: 'sine', decay: 0.14, volume: 0.09 }, bass: { ...BASS, volume: 0.07 } },\n    patterns: {\n      a: { choir: 'C5 - - - B4 - - - Bb4 - - - A4 - - -', choir2: 'G4 - - - F#4 - - - F4 - - - E4 - - -', drip: 'C6 . . G6 . . E6 . C6 . . A5 . . E6 .', bass: 'C2 - - - B1 - - - Bb1 - - - A1 - - -' },\n      b: { choir: 'F4 - - - Ab4 - - - G4 - - - - - - -', choir2: 'C4 - - - Eb4 - - - D4 - - - B3 - - -', drip: 'F6 . . C6 . . Ab5 . G6 . . D6 . . B5 .', bass: 'F1 - - - Ab1 - - - G1 - - - G1 - - -' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-diesirae': {\n    bpm: 144, // two steps a beat of the heart at 72: the director restarts it with the heart's tempo\n    tracks: { choir: { ...CHOIR, volume: 0.06 }, choir2: CHOIR2, bass: { ...BASS, duty: 0.25, volume: 0.1 }, kick: { ...KICK, volume: 0.28 }, hat: HAT },\n    patterns: {\n      a: { choir: 'D5 - - - C5 - - - Bb4 - - - A4 - - -', choir2: 'F4 - - - F4 - - - F4 - - - E4 - - -', bass: 'D2 D2 . D2 . D2 D2 . Bb1 Bb1 . Bb1 A1 A1 . A1', kick: 'C2 . C2 . . . . . C2 . C2 . . . . .', hat: '. . C8 . . . C8 . . . C8 . . . C8 .' },\n      b: { choir: 'F5 - - - E5 - - - D5 - C#5 - D5 - - -', choir2: 'A4 - - - G4 - - - F4 - E4 - F4 - - -', bass: 'D2 D2 . D2 . D2 D2 . C#2 C#2 . C#2 D2 D2 . D2', kick: 'C2 . C2 . . . . . C2 . C2 . . . . .', hat: '. . C8 . . . C8 . . . C8 . . . C8 .' },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-libera': {\n    bpm: 60,\n    tracks: { choir: { ...CHOIR, volume: 0.05 }, high: { wave: 'sine', attack: 0.2, decay: 0.8, volume: 0.05 } },\n    patterns: {\n      a: { choir: 'C4 - - - - - - - G4 - - - - - - -', high: 'E5 - - - - - - - D5 - - - - - - -' },\n      b: { choir: 'Ab4 - - - - - - - G4 - - - - - - -', high: 'C5 - - - - - - - B4 - - - - - - -' },\n    },\n    order: ['a', 'b'],\n  },\n  'boss-libera2': {\n    bpm: 112,\n    tracks: { choir: CHOIR, choir2: CHOIR2, bass: { ...BASS, volume: 0.1 }, kick: KICK, snare: SNARE, hat: HAT, knock: { wave: 'triangle', decay: 0.08, volume: 0.12 } },\n    patterns: {\n      a: { choir: 'C5 - - - Bb4 - - - Ab4 - - - G4 - - -', choir2: 'Eb4 - - - D4 - - - C4 - - - B3 - - -', bass: 'C2 C2 . C2 . C2 . C2 Ab1 Ab1 . Ab1 G1 G1 . G1', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', snare: '. . . . C6 . . . . . . . C6 . . .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', knock: 'E3 . . E3 . . E3 . . . . . . . . .' },\n      b: { choir: 'Eb5 - - - D5 - - - C5 - - - B4 - - -', choir2: 'G4 - - - F4 - - - Eb4 - - - D4 - - -', bass: 'C2 C2 . C2 . C2 . C2 G1 G1 . G1 G1 . G1 G1', kick: 'C2 . . . C2 . . . C2 . . . C2 C2 . .', snare: '. . . . C6 . . . . . . . C6 . C6 .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', knock: REST16 },\n    },\n    order: ['a', 'a', 'b', 'a'],\n  },\n  'boss-libera3': {\n    bpm: 72,\n    tracks: { choir: { ...CHOIR, volume: 0.07 }, choir2: { ...CHOIR2, volume: 0.05 }, high: { wave: 'triangle', attack: 0.02, decay: 0.6, volume: 0.08 }, bass: { ...BASS, volume: 0.05 } },\n    patterns: {\n      a: { choir: 'C5 - - - E5 - - - F5 - - - E5 - - -', choir2: 'G4 - - - G4 - - - A4 - - - G4 - - -', high: 'G5 . . . . . C6 . . . A5 . . . G5 .', bass: 'C2 - - - - - - - F2 - - - C2 - - -' },\n      b: { choir: 'D5 - - - F5 - - - E5 - - - D5 - - -', choir2: 'A4 - - - C5 - - - G4 - - - G4 - - -', high: 'F5 . . . A5 . . . G5 . E5 . D5 . . .', bass: 'D2 - - - - - - - G2 - - - G2 - - -' },\n    },\n    order: ['a', 'b'],\n  },\n  op10: {\n    bpm: 58,\n    tracks: { lead: { wave: 'sine', attack: 0.04, decay: 0.8, volume: 0.1 }, low: { wave: 'triangle', decay: 0.9, volume: 0.07 } },\n    patterns: {\n      a: { lead: 'E5 - - - . . . . G5 - - - . . . .', low: 'A3 - - - - - - - E3 - - - - - - -' },\n      b: { lead: 'F5 - - - . . E5 - D5 - - - . . . .', low: 'F3 - - - - - - - G3 - - - - - - -' },\n      c: { lead: 'C5 - - - . . . . E5 - - - D5 - - -', low: 'C3 - - - - - - - G3 - - - - - - -' },\n    },\n    order: ['a', 'b', 'c', 'b'],\n  },\n  'results-win': {\n    bpm: 108, loop: false,\n    tracks: { lead: LEAD, pulse: PULSE, bass: BASS },\n    patterns: { a: { lead: 'D5 . F5 . A5 . D6 - - - A5 . D6 - - -', pulse: 'D4 F4 A4 F4 D4 F4 A4 F4 G4 Bb4 D5 Bb4 A4 C#5 E5 C#5', bass: 'D2 . . . . . . . G2 . . . A2 . . .' }, b: { lead: 'F6 - - - E6 - D6 - - - - - . . . .', pulse: 'D4 F4 A4 D5 . . . . . . . . . . . .', bass: 'D2 - - - - - - - - - - - . . . .' } },\n    order: ['a', 'b'],\n  },\n  'results-sad': {\n    bpm: 72, loop: false,\n    tracks: { lead: SOFT, bass: BASS },\n    patterns: { a: { lead: 'A4 - - - G4 - - - F4 - - - E4 - - -', bass: 'D2 - - - C2 - - - Bb1 - - - A1 - - -' }, b: { lead: 'D4 - - - - - - - . . . . . . . .', bass: 'D2 - - - - - - - . . . . . . . .' } },\n    order: ['a', 'b'],\n  },\n  credits: {\n    bpm: 88,\n    tracks: { lead: LEAD, pulse: { ...PULSE, volume: 0.035 }, bass: BASS, hat: { ...HAT, volume: 0.015 } },\n    patterns: {\n      a: { lead: 'C5 - - E5 G5 - - - A5 - G5 - E5 - - -', pulse: 'C4 E4 G4 E4 C4 E4 G4 E4 F4 A4 C5 A4 C4 E4 G4 E4', bass: 'C2 - - - G2 - - - F2 - - - C2 - - -', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n      b: { lead: 'D5 - - F5 A5 - - - G5 - E5 - C5 - - -', pulse: 'D4 F4 A4 F4 D4 F4 A4 F4 G3 B3 D4 B3 C4 E4 G4 E4', bass: 'D2 - - - A2 - - - G2 - - - C2 - - -', hat: 'C8 . . . C8 . . . C8 . . . C8 . . .' },\n    },\n    order: ['a', 'b', 'a', 'b'],\n  },\n};\n\nexport const stepsPerBar = (song) => 4 * (song.stepsPerBeat ?? 4);\nexport const barSeconds = (song) => (60 / song.bpm) * 4;\nEOF\ncat > src/audio/director.js <<'EOF'\n// The music director: changes tracks at bar lines, follows vitals in surgery, keeps Dies Irae on the\n// heart's tempo. `loadGame` clears music, so each stage calls `onStage()`.\nimport { barSeconds, SONGS } from '../content/songs.js';\n\nconst OR_FAMILY = new Set(['or-calm', 'or-tense', 'or-critical']);\n\nexport class MusicDirector {\n  constructor() {\n    this.audio = null;\n    this.current = null; // id playing\n    this.pending = null; // { id, song }\n    this.startedAt = 0;\n    this.clock = 0;\n    this.bpmOverride = null;\n    this.moodBase = null;\n  }\n  attach(audio) { this.audio = audio; }\n  onStage() {\n    // A level load stopped the music: bring back whatever we were playing, or what's pending.\n    if (this.pending) { this._start(this.pending.id, this.pending.song); this.pending = null; return; }\n    if (this.current) this._start(this.current, this._songFor(this.current));\n  }\n  _songFor(id) {\n    if (!id || id === 'silence') return null;\n    const s = SONGS[id];\n    if (!s) return null;\n    return this.bpmOverride && id === 'boss-diesirae' ? { ...s, bpm: this.bpmOverride } : s;\n  }\n  _start(id, song) {\n    this.current = id;\n    this.startedAt = this.clock;\n    this.currentSong = song;\n    this.audio?.playMusic(song ?? null, id ?? 'none');\n  }\n  /** Change music now (between stages) or at the next bar line. */\n  play(id, { now = false } = {}) {\n    if (id === this.current && !this.pending) return;\n    if (this.pending?.id === id) return;\n    const song = this._songFor(id);\n    if (now || !this.currentSong) { this.pending = null; this._start(id, song); return; }\n    this.pending = { id, song };\n  }\n  /** Follow the vitals inside the or-* family. */\n  mood(vitals) {\n    if (!OR_FAMILY.has(this.current) && !OR_FAMILY.has(this.pending?.id)) return;\n    const want = vitals < 22 ? 'or-critical' : vitals < 45 ? 'or-tense' : this.moodBase ?? this.current;\n    if (want !== (this.pending?.id ?? this.current)) this.play(want);\n  }\n  setBase(id) { this.moodBase = OR_FAMILY.has(id) ? id : null; }\n  /** The heart's tempo: two steps a heartbeat, restarted at bar lines. */\n  heartTempo(bpm) {\n    const b = Math.round(bpm * 2);\n    if (this.current !== 'boss-diesirae' || this.bpmOverride === b) return;\n    this.bpmOverride = b;\n    this.pending = { id: 'boss-diesirae', song: { ...SONGS['boss-diesirae'], bpm: b } };\n  }\n  update(dt) {\n    this.clock += dt;\n    if (!this.pending) return;\n    const song = this.currentSong;\n    const bar = song ? barSeconds(song) : 0;\n    const t = this.clock - this.startedAt;\n    if (!song || bar <= 0 || t % bar < dt * 1.5) {\n      const p = this.pending;\n      this.pending = null;\n      this._start(p.id, p.song);\n    }\n  }\n  stop() {\n    this.pending = null;\n    this.current = null;\n    this.currentSong = null;\n    this.bpmOverride = null;\n    this.audio?.playMusic(null);\n  }\n}\nEOF\ncat > src/core/save.js <<'EOF'\n// Saves and settings: guarded localStorage under a versioned key. In a hub session the client hands\n// the page an empty store; a replay or a test can swap the store.\nconst KEY = 'trauma-central-second-stitch:v1';\n\nexport const DEFAULT_SETTINGS = Object.freeze({\n  sound: 0.8, voices: 0.8, glyphs: 'playstation', aimAssist: 'low', cursorSpeed: 1, rumble: true, giftMode: 'hold', look: 'surgical', pixelSize: 1, shake: 1, reduceFlashes: false, textSpeed: 1, difficulty: 'resident',\n});\nexport const newProgress = () => ({ episode: 0, stage: 'scene', difficulty: 'resident', cleared: {}, finished: false, retries: {} });\n\nconst store = () => { try { return typeof localStorage === 'undefined' ? null : localStorage; } catch { return null; } };\n\nexport function loadSave() {\n  const s = store();\n  let data = null;\n  if (s) { try { data = JSON.parse(s.getItem(KEY) ?? 'null'); } catch { data = null; } }\n  return {\n    settings: { ...DEFAULT_SETTINGS, ...(data?.settings ?? {}) },\n    progress: data?.progress ? { ...newProgress(), ...data.progress } : null,\n    log: data?.log ?? {},\n    hasSave: !!data?.progress,\n  };\n}\nexport function writeSave(save) {\n  const s = store();\n  if (!s) return false;\n  try { s.setItem(KEY, JSON.stringify({ settings: save.settings, progress: save.progress, log: save.log })); return true; } catch { return false; }\n}\nexport const SAVE_KEY = KEY;\nEOF\ncat > src/sim/campaign.js <<'EOF'\n// The shift, as data and pure functions: which scene and which op follow which. Uses no engine.\nexport const EPISODES = [\n  { scene: 'ep1', op: 'op1' }, { scene: 'ep2', op: 'op2' }, { scene: 'ep3', op: 'op3' }, { scene: 'ep4', op: 'op4' }, { scene: 'ep5', op: 'op5' },\n  { scene: 'ep6', op: 'op6' }, { scene: 'ep7', op: 'op7' }, { scene: 'ep8', op: 'op8' }, { scene: 'ep9', op: 'op9' }, { scene: 'ep10', op: 'op10' },\n];\nexport const END_SCENE = 'end';\n\n/** After finishing the scene or op of `progress`, what comes next. */\nexport function advance(progress) {\n  if (progress.stage === 'scene') return { ...progress, stage: 'op' };\n  if (progress.stage === 'op') {\n    const n = progress.episode + 1;\n    if (n >= EPISODES.length) return { ...progress, stage: 'end', episode: n };\n    return { ...progress, stage: 'scene', episode: n };\n  }\n  return { ...progress, finished: true, stage: 'done' };\n}\nexport const currentStep = (progress) => {\n  if (progress.stage === 'end') return { kind: 'scene', id: END_SCENE };\n  if (progress.stage === 'done') return { kind: 'done' };\n  const ep = EPISODES[progress.episode];\n  return progress.stage === 'scene' ? { kind: 'scene', id: ep.scene, ep: progress.episode } : { kind: 'op', id: ep.op, ep: progress.episode };\n};\nEOF\necho done","description":"Write voices, sound effects, songs, director, saves, campaign"}}}
