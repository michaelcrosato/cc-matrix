d run it. */\n75:const serverMode = scenario === 'server';\n367:$('hide').onclick = () => {\n370:  $('hide').setAttribute('aria-pressed', String(current.hidden));\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n/**\n * bridge.js — the hub's end of one game frame in a session.\n *\n * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n * The bridge checks every message, enforces the limits, and routes it: control\n * messages (hello, ready, result, finish, error) to whoever coordinates the\n * round (lib/hub/round.js), game traffic straight to the other players, and a\n * game's answers on its own card to the page that holds it. What\n * comes back from the network is checked again before it reaches the game,\n * and anything from another round is dropped, so a slow packet can never land\n * in the next game.\n *\n * The network is anything with `send(toKey, envelope, {reliable})`: the\n * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n * WebRTC mesh. Envelopes:\n *   {k:'c', r, m}       to the coordinator: a message from this game\n *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n *   {k:'g', r, f, d}    game traffic from player id f\n *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n */\n\nexport const LIMITS = Object.freeze({\n  maxBytes: 16_384,\n  ratePerS: 20,\n  burst: 40,\n  queueMessages: 64,\n  queueBytes: 262_144,\n  /**\n   * progress() reaches the hub about once a second. Two closer than this are a\n   * report delivered late (a long task in the game) or a client misbehaving:\n38:export function modeOf(word) {\n52:export const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n55:  now: () => Date.now(),\n56:  setTimeout: (fn, ms) => setTimeout(fn, ms),\n57:  clearTimeout: (handle) => clearTimeout(handle),\n61:export function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n72:export function rankResults(results, ids) {\n82:  const groups = (list, order) => {\n83:    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\n90:    return out.map((g) => g.ids);\nvendor/harness.html:399:  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\nvendor/harness.html:400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\nvendor/harness.html:447:      for (const cell of players) poke(cell, 'Enter');","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01M2ntmyuRnh35T9sw7X352x","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk5MHwWSPn54C8SEu4hy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Spzg7AZCtXdXgEpWRm6cpC","name":"Bash","input":{"command":"cat > src/sim/codec.js <<'EOF'\n// The network's copy of the sim: fixed-point ints in positional arrays. Plain data only.\n// Keyframes (reliable, 1 Hz, whole state, <= 16 KB); snapshots (unreliable, 12 Hz, what moved, <= 1100\n// bytes); event batches (reliable, up to 4 Hz). The view reads a plain state object from either source.\nimport { TOOLS } from './entities.js';\nimport { GEL_COLS, GEL_ROWS } from './entities.js';\n\nconst I = (v) => Math.round(v * 100);\nconst TOOL_I = (t) => { const i = [...TOOLS, 'dressing'].indexOf(t); return i; };\nconst TOOL_N = (i) => [...TOOLS, 'dressing'][i] ?? null;\n\n// Fields of an entity that a client needs but that never change, by kind, are in the keyframe; these are the\n// two kind-specific numbers a snapshot carries.\nfunction ab(e) {\n  switch (e.k) {\n    case 'pool': case 'bleeder': return [I(e.r), 0];\n    case 'incision': case 'dressing': return [I(e.s), 0];\n    case 'laceration': return [e.next, e.flip];\n    case 'mask': return [Math.round((e.painted ?? 0) * 100), 0];\n    case 'polyp': case 'egg': case 'cyst': case 'eye': case 'halo': case 'clot': return [Math.round((e.heat ?? 0) * 100), (e.open ? 1 : 0) + (e.locked ? 2 : 0) + (e.scanned ? 4 : 0)];\n    case 'fragment': case 'clamp': case 'donor': return [Math.round(e.rot ?? 0), (e.placed ? 1 : 0) + ((e.holders ?? 0) ? 2 : 0)];\n    default: return [I(e.s ?? 0), (e.free ? 1 : 0) + ((e.holders ?? 0) ? 2 : 0) + (e.locked ? 4 : 0) + (e.hidden ? 8 : 0)];\n  }\n}\nfunction applyAb(e, a, b) {\n  switch (e.k) {\n    case 'pool': case 'bleeder': e.r = a / 100; break;\n    case 'incision': case 'dressing': e.s = a / 100; break;\n    case 'laceration': e.next = a; e.flip = b; break;\n    case 'mask': e.painted = a / 100; break;\n    case 'polyp': case 'egg': case 'cyst': case 'eye': case 'halo': case 'clot': e.heat = a / 100; e.open = !!(b & 1); e.locked = !!(b & 2); e.scanned = !!(b & 4); break;\n    case 'fragment': case 'clamp': case 'donor': e.rot = a; e.placed = !!(b & 1); e.holders = b & 2 ? 1 : 0; break;\n    default: e.s = a / 100; e.free = !!(b & 1); e.holders = b & 2 ? 1 : 0; e.locked = !!(b & 4); e.hidden = !!(b & 8); break;\n  }\n}\n\nfunction gelBits(gel) {\n  // A coarse bitset, as hex.\n  let s = '', nib = 0, n = 0;\n  for (let i = 0; i < gel.length; i++) {\n    nib = (nib << 1) | (gel[i] > 0 ? 1 : 0);\n    if (++n === 4) { s += nib.toString(16); nib = 0; n = 0; }\n  }\n  if (n) s += (nib << (4 - n)).toString(16);\n  return s.replace(/0+$/, '');\n}\nfunction gelApply(bits, gel) {\n  gel.fill(0);\n  for (let i = 0; i < bits.length; i++) {\n    const nib = parseInt(bits[i], 16);\n    for (let k = 0; k < 4; k++) if (nib & (8 >> k)) gel[i * 4 + k] = 8;\n  }\n}\n\nconst roundPath = (p) => (p ? p.map((q) => [Math.round(q[0] * 100) / 100, Math.round(q[1] * 100) / 100]) : p);\n\n/** Everything a late or lossy client needs. */\nexport function encodeKey(sim) {\n  return {\n    t: 'k', n: sim.tick, op: sim.opId, st: sim.status, c: I(sim.clock), c0: I(sim.clock0), s: sim.stage, o: sim.objective, x: sim.context, ctx: sim.mistakes, sc: sim.score, st2: sim.streak,\n    tools: sim.tools, gifts: sim.giftsUnlocked ? 1 : 0, comp: Math.round(sim.composure), d: sim.doses, m: sim.music, cold: sim.cold,\n    tb: sim.tables.map((t) => ({ i: t.i, a: t.arena, v: I(t.vitals), f: t.fake, r: t.ring, g: gelBits(t.gel), mk: t.marks.slice(-50).map((m) => ({ ...m, path: roundPath(m.path), cells: m.cells ? m.cells.slice(0, 12) : undefined })), n: t.name })),\n    e: sim.ents.filter((e) => !e.dead).map((e) => {\n      const { path, cells, ...rest } = e;\n      const out = { ...rest };\n      delete out.onDone; delete out.onReveal; delete out.onDead; delete out.home; delete out.wasted; delete out.age; delete out.devSum; delete out.devT; delete out.devLen; delete out.eyes; delete out.plates; delete out.halos; delete out.way;\n      if (path) out.path = roundPath(path);\n      if (cells) out.cells = cells;\n      if (e.home) out.home = e.home;\n      return out;\n    }),\n    p: sim.seats.map((s) => seatRow(s)), h: sim.heart ? [Math.round(sim.heart.bpm), Math.round(sim.heart.phase * 100), sim.heart.calm ? 1 : 0, sim.heart.systole ? 1 : 0] : null,\n    cb: sim.codeBlue, ms: sim.massage, q: sim.quiet ? 1 : 0, pr: sim.prompt, pain: sim.pain, g: sim.handGhost,\n  };\n}\nconst seatRow = (s) => [s.id, I(s.x), I(s.z), TOOL_I(s.tool), (s.act ? 1 : 0) + (s.onTarget ? 2 : 0) + (s.grab ? 4 : 0) + (s.gone ? 8 : 0), Math.round(s.score), s.table, s.gift === 'look' ? 2 : s.gift === 'quiet' ? 1 : 0, TOOL_I(s.act), Math.round((s.draw ?? 0) * 100)];\n\n/** What moved since `last`, a Map of the last values sent. */\nexport function encodeSnap(sim, last) {\n  const e = [];\n  for (const o of sim.ents) {\n    if (o.dead) continue;\n    const [a, b] = ab(o);\n    const row = [o.n, I(o.x), I(o.z), a, b];\n    const key = row.join(',');\n    if (last.get(o.n) !== key) { last.set(o.n, key); e.push(row); }\n  }\n  const msg = {\n    t: 's', n: sim.tick, c: I(sim.clock), v: sim.tables.map((t) => I(t.vitals)), comp: Math.round(sim.composure), d: sim.doses, sc: sim.score, q: sim.quiet ? 1 : 0, mi: sim.mistakes,\n    p: sim.seats.map((s) => seatRow(s)), e,\n  };\n  if (sim.drops.length) msg.dr = sim.drops.filter((d) => !d.dead).slice(0, 24).map((d) => [I(d.x), I(d.z)]);\n  if (sim.heart) msg.h = [Math.round(sim.heart.bpm), Math.round(sim.heart.phase * 100), sim.heart.calm ? 1 : 0, sim.heart.systole ? 1 : 0];\n  if (sim.codeBlue) msg.cb = [Math.round(sim.codeBlue.charge * 100), sim.codeBlue.shocks, Math.round(sim.codeBlue.t * 10), sim.codeBlue.charging ? 1 : 0];\n  if (sim.massage) msg.ms = [sim.massage.n, sim.massage.next === 'a' ? 0 : 1, Math.round(sim.massage.phase * 100)];\n  return msg;\n}\n\n/** A plain state object the view can read. */\nexport function emptyView(def, seats) {\n  return {\n    def, opId: def.id, tick: 0, status: 'playing', clock: def.time, clock0: def.time, stage: 0, objective: '', context: null, mistakes: 0, score: 0, streak: 0, tools: [...(def.tools ?? [])], giftsUnlocked: true, composure: 40, doses: def.doses ?? 3, music: def.music, cold: null,\n    tables: (def.tables ?? [{ arena: def.arena }]).map((t, i) => ({ i, arena: t.arena ?? def.arena, vitals: def.vitals.start, fake: null, ring: t.ring ?? def.ring ?? [-5.1, 2.1], gel: new Array(GEL_COLS * GEL_ROWS).fill(0), marks: [], name: t.name ?? null })),\n    ents: [], drops: [], seats: seats.map((s, i) => ({ id: i, x: 0, z: 0.5, tx: 0, tz: 0.5, table: 0, tool: 'drain', gift: i % 2 ? 'look' : 'quiet', surgeon: 'ilya', bot: null, act: null, onTarget: false, grab: null, score: 0, draw: 0, gone: false, name: s.name })),\n    heart: null, codeBlue: null, massage: null, quiet: false, prompt: null, pain: 0, handGhost: null, ghostPlay: null,\n  };\n}\n\nfunction applySeatRows(view, rows) {\n  for (const r of rows) {\n    const s = view.seats[r[0]];\n    if (!s) continue;\n    s.tx = r[1] / 100;\n    s.tz = r[2] / 100;\n    s.tool = TOOL_N(r[3]) ?? s.tool;\n    s.act = r[4] & 1 ? (TOOL_N(r[8]) ?? s.tool) : null;\n    s.onTarget = !!(r[4] & 2);\n    s.grab = r[4] & 4 ? 'held' : null;\n    s.gone = !!(r[4] & 8);\n    s.score = r[5];\n    s.table = r[6];\n    s.gift = r[7] === 2 ? 'look' : r[7] === 1 ? 'quiet' : null;\n    s.draw = (r[9] ?? 0) / 100;\n  }\n}\n\nexport function applyKey(view, k) {\n  view.tick = k.n;\n  view.status = k.st;\n  view.clock = k.c / 100;\n  view.stage = k.s;\n  view.objective = k.o;\n  view.context = k.x;\n  view.mistakes = k.ctx;\n  view.score = k.sc;\n  view.streak = k.st2;\n  view.tools = k.tools;\n  view.giftsUnlocked = !!k.gifts;\n  view.composure = k.comp;\n  view.doses = k.d;\n  view.music = k.m;\n  view.cold = k.cold;\n  view.quiet = !!k.q;\n  view.prompt = k.pr;\n  view.pain = k.pain;\n  view.handGhost = k.g;\n  k.tb.forEach((t) => {\n    const v = view.tables[t.i];\n    if (!v) return;\n    v.vitals = t.v / 100;\n    v.fake = t.f;\n    v.ring = t.r;\n    gelApply(t.g, v.gel);\n    v.marks = t.mk;\n  });\n  // Entities: replace, keeping interpolated positions of what's already here.\n  const old = new Map(view.ents.map((e) => [e.n, e]));\n  view.ents = k.e.map((e) => {\n    const o = old.get(e.n);\n    return { ...e, tx: e.x, tz: e.z, x: o ? o.x : e.x, z: o ? o.z : e.z };\n  });\n  applySeatRows(view, k.p);\n  setHeart(view, k.h);\n  view.codeBlue = k.cb;\n  view.massage = k.ms;\n  return view;\n}\nexport function applySnap(view, s) {\n  if (s.n < view.tick) return view;\n  view.tick = s.n;\n  view.clock = s.c / 100;\n  s.v.forEach((v, i) => { if (view.tables[i]) view.tables[i].vitals = v / 100; });\n  view.composure = s.comp;\n  view.doses = s.d;\n  view.score = s.sc;\n  view.quiet = !!s.q;\n  view.mistakes = s.mi;\n  applySeatRows(view, s.p);\n  for (const r of s.e) {\n    const e = view.ents.find((o) => o.n === r[0]);\n    if (!e) continue;\n    e.tx = r[1] / 100;\n    e.tz = r[2] / 100;\n    applyAb(e, r[3], r[4]);\n  }\n  view.drops = (s.dr ?? []).map((d) => ({ x: d[0] / 100, z: d[1] / 100, table: 0, dead: false }));\n  setHeart(view, s.h);\n  if (s.cb && view.codeBlue) { view.codeBlue.charge = s.cb[0] / 100; view.codeBlue.shocks = s.cb[1]; view.codeBlue.t = s.cb[2] / 10; view.codeBlue.charging = !!s.cb[3]; }\n  if (s.ms && view.massage) { view.massage.n = s.ms[0]; view.massage.next = s.ms[1] ? 'b' : 'a'; view.massage.phase = s.ms[2] / 100; }\n  return view;\n}\nfunction setHeart(view, h) {\n  if (!h) { view.heart = null; return; }\n  view.heart = view.heart ?? { beat: 0 };\n  view.heart.bpm = h[0];\n  view.heart.phase = h[1] / 100;\n  view.heart.calm = !!h[2];\n  view.heart.systole = !!h[3];\n}\n/** Glide positions toward the last received, about 120 ms behind. */\nexport function smoothView(view, dt) {\n  const k = Math.min(1, dt * 9);\n  for (const e of view.ents) { if (e.tx != null) { e.x += (e.tx - e.x) * k; e.z += (e.tz - e.z) * k; } }\n  for (const s of view.seats) { s.x += (s.tx - s.x) * Math.min(1, dt * 12); s.z += (s.tz - s.z) * Math.min(1, dt * 12); }\n}\nconst KEEP_EVENTS = new Set(['say', 'rating', 'mistake', 'grab', 'pop', 'dish', 'stitch', 'knot', 'cutDone', 'sizzle', 'ping', 'reveal', 'inject', 'doseWasted', 'heal', 'music', 'stage', 'quietOn', 'quietOff', 'rewind', 'codeBlue', 'clear', 'badShock', 'revived', 'massageStart', 'massagePress', 'massageDone', 'knock', 'coreOut', 'strainHit', 'strainDying', 'strainDead', 'eyeOpen', 'weeperCrawl', 'sob', 'sobWave', 'thump', 'bpm', 'flare', 'plateOff', 'round', 'arrest', 'fx', 'won', 'lost', 'toolUnlocked', 'wrongTool']);\nexport const netEvents = (evs) => evs.filter((e) => KEEP_EVENTS.has(e.e)).map((e) => {\n  const c = { ...e };\n  if (c.x != null) c.x = Math.round(c.x * 100) / 100;\n  if (c.z != null) c.z = Math.round(c.z * 100) / 100;\n  return c;\n});\nEOF\npython3 - <<'EOF'\np='src/sim/entities.js'; s=open(p).read()\ns=s.replace(\"const e = { ...spec, id: spec.id ?? `e${sim.nextId++}`, k: spec.k,\",\"const n = sim.nextId++;\\n  const e = { ...spec, n, id: spec.id ?? `e${n}`, k: spec.k,\")\nopen(p,'w').write(s)\nEOF\ncat > src/net/host.js <<'EOF'\n// The host's copy runs the sim on a timer, from AIHub.time(): a hidden tab must not stall it, and a server\n// copy has no renderer at all.\nimport { createConfig } from '../core/config.js';\nimport { OPS, SESSION_OPS } from '../content/ops/index.js';\nimport { encodeKey, encodeSnap, netEvents } from '../sim/codec.js';\nimport { createOp, DT, drainEvents, step } from '../sim/op.js';\n\nconst hub = () => window.AIHub;\n\nexport function chooseRound(info) {\n  return SESSION_OPS[(info.round ?? 0) % SESSION_OPS.length].id;\n}\n\nexport function sessionSeats(info) {\n  return info.players.map((p, i) => ({ id: i, surgeon: 'ilya', gift: i % 2 === 0 ? 'quiet' : 'look', name: p.name, playerId: p.id }));\n}\n\nexport class HostLoop {\n  constructor(info) {\n    this.info = info;\n    this.def = OPS[chooseRound(info)];\n    this.seats = sessionSeats(info);\n    const rng = hub().rng('deal');\n    const seed = Math.floor(rng() * 2147483646) + 1;\n    this.sim = createOp(this.def, { seed, seats: this.seats, difficulty: 'resident', config: createConfig() });\n    this.inputs = {};\n    this.seatByPlayer = new Map(info.players.map((p, i) => [p.id, i]));\n    this.localEvents = [];\n    this.sendQueue = [];\n    this.lastSnap = 0;\n    this.lastKey = -1e9;\n    this.lastEv = 0;\n    this.last = new Map();\n    this.finished = false;\n    this.running = false;\n    this.ticks = 0;\n    this.tokens = 40;\n    this.tokenAt = 0;\n  }\n  onInput(data, from) {\n    const seat = this.seatByPlayer.get(from);\n    if (seat == null || data.t !== 'i') return;\n    const prev = this.inputs[seat];\n    if (prev && data.n < prev.n) return;\n    this.inputs[seat] = { n: data.n, x: data.x / 100, z: data.z / 100, tool: data.tool, use: !!data.use, gift: !!data.gift, steady: !!data.steady, a: !!data.a, b: !!data.b, rot: data.rot ?? 0, force: 1 };\n  }\n  setLocalInput(seat, inp) { this.inputs[seat] = inp; }\n  retire(id) {\n    const seat = this.seatByPlayer.get(id);\n    if (seat == null) return;\n    const s = this.sim.seats[seat];\n    s.gone = true;\n    if (s.grab) { const e = this.sim.ents.find((o) => o.id === s.grab); if (e) e.holders = Math.max(0, (e.holders ?? 1) - 1); s.grab = null; }\n    delete this.inputs[seat];\n  }\n  start() {\n    if (this.running) return;\n    this.running = true;\n    this.timer = setInterval(() => this.pump(), 16);\n    this.snapTimer = setInterval(() => this.net(), 83);\n  }\n  stop() {\n    this.running = false;\n    clearInterval(this.timer);\n    clearInterval(this.snapTimer);\n  }\n  pump() {\n    const t = hub().time();\n    if (t === -Infinity) return;\n    if (t < 0) return;\n    const target = Math.floor(t / (DT * 1000));\n    let n = 0;\n    while (this.ticks < target && n < 180 && this.sim.status === 'playing') {\n      step(this.sim, this.inputs);\n      this.ticks++;\n      n++;\n      const evs = drainEvents(this.sim);\n      if (evs.length) { this.localEvents.push(...evs); this.sendQueue.push(...netEvents(evs)); }\n    }\n    if (this.sim.status !== 'playing' && !this.finished) this.finish(this.sim.status === 'won');\n  }\n  /** Token bucket: at most 17 messages a second. */\n  send(data, o) {\n    const now = performance.now();\n    this.tokens = Math.min(30, this.tokens + ((now - this.tokenAt) / 1000) * 18);\n    this.tokenAt = now;\n    if (this.tokens < 1) return false;\n    this.tokens -= 1;\n    return hub().send(data, o);\n  }\n  net() {\n    if (hub().time() === -Infinity || this.finished) return;\n    const now = performance.now();\n    this.send(encodeSnap(this.sim, this.last), { reliable: false });\n    if (now - this.lastKey >= 1000) {\n      this.lastKey = now;\n      const key = encodeKey(this.sim);\n      let text = JSON.stringify(key);\n      if (text.length > 16000) { key.tb.forEach((tb) => { tb.mk = tb.mk.slice(-20); }); text = JSON.stringify(key); }\n      this.send(key, { reliable: true });\n    }\n    if (this.sendQueue.length && now - this.lastEv >= 250) {\n      this.lastEv = now;\n      const ev = this.sendQueue.splice(0, 40);\n      this.send({ t: 'e', ev }, { reliable: true });\n    }\n  }\n  takeLocalEvents() { const e = this.localEvents; this.localEvents = []; return e; }\n  finish(won) {\n    if (this.finished) return;\n    this.finished = true;\n    const info = this.info;\n    const sim = this.sim;\n    const players = info.players.filter((p) => !sim.seats[this.seatByPlayer.get(p.id)]?.gone);\n    const rows = players.map((p) => ({ id: p.id, seat: sim.seats[this.seatByPlayer.get(p.id)] }));\n    rows.sort((a, b) => b.seat.score - a.seat.score);\n    const standings = [];\n    for (const r of rows) {\n      const last = standings[standings.length - 1];\n      if (last && sim.seats[this.seatByPlayer.get(last[0])].score === r.seat.score) last.push(r.id);\n      else standings.push([r.id]);\n    }\n    const scores = Object.fromEntries(rows.map((r) => [r.id, Math.max(0, Math.round(r.seat.score))]));\n    const stats = Object.fromEntries(rows.map((r) => [r.id, {\n      Clean: String(r.seat.stats.clean), Good: String(r.seat.stats.good), Sloppy: String(r.seat.stats.sloppy), Mistakes: String(r.seat.stats.mistakes), Stitches: String(r.seat.stats.stitches), Doses: String(r.seat.stats.doses),\n    }]));\n    const awards = [];\n    const best = (fn) => rows.slice().sort((a, b) => fn(b) - fn(a))[0];\n    const hand = rows.filter((r) => r.seat.stats.cuts > 0).sort((a, b) => a.seat.stats.cutDev / a.seat.stats.cuts - b.seat.stats.cutDev / b.seat.stats.cuts)[0];\n    if (hand) awards.push({ id: hand.id, title: 'STEADIEST HAND', detail: 'The straightest cuts at the table' });\n    const st = best((r) => r.seat.stats.stitches);\n    if (st && st.seat.stats.stitches > 0) awards.push({ id: st.id, title: 'MOST STITCHES', detail: `${st.seat.stats.stitches} stitches tied` });\n    const sv = best((r) => r.seat.stats.saves + r.seat.stats.doses);\n    if (sv && sv.seat.stats.saves + sv.seat.stats.doses > 0) awards.push({ id: sv.id, title: 'SAVED THE DAY', detail: 'Doses and paddles when it counted' });\n    const sl = best((r) => r.seat.stats.sloppy + r.seat.stats.mistakes * 2);\n    if (sl && sl.seat.stats.sloppy + sl.seat.stats.mistakes > 0) awards.push({ id: sl.id, title: 'SLOPPIEST', detail: 'Enthusiasm is also a skill' });\n    this.flushFinal();\n    hub().finish({ standings, scores, won, stats, awards });\n    this.stop();\n  }\n  flushFinal() {\n    if (this.sendQueue.length) hub().send({ t: 'e', ev: this.sendQueue.splice(0, 60) }, { reliable: true });\n  }\n}\nEOF\ncat > src/net/client.js <<'EOF'\n// Sources of state for the operation view: the host's own sim, or the network's copy. A client moves its\n// own tip locally at once and corrects gently; everything else draws from snapshots about 120 ms behind.\nimport { applyKey, applySnap, emptyView, smoothView } from '../sim/codec.js';\nimport { OPS } from '../content/ops/index.js';\nimport { SeatControl } from '../input/cursor.js';\nimport { App } from '../app.js';\nimport { chooseRound } from './host.js';\n\nconst hub = () => window.AIHub;\n\nexport class HostSource {\n  constructor(host, info) {\n    this.host = host;\n    this.state = host.sim;\n    this.seatIndex = host.seatByPlayer.get(info.me);\n    this.control = this.seatIndex != null ? new SeatControl(App, this.seatIndex, 'all') : null;\n  }\n  drain() { return this.host.takeLocalEvents(); }\n  fixed(ctx, stage, dt) {\n    if (!this.control || this.ended) return;\n    App.devices.poll(ctx);\n    this.control.frameEdges(ctx, this.state);\n    const inp = this.control.step(ctx, this.state, stage, dt);\n    this.host.setLocalInput(this.seatIndex, { ...inp });\n  }\n  localTip() { return this.control ? { x: this.control.x, z: this.control.z } : null; }\n}\n\nexport class ClientSource {\n  constructor(info) {\n    this.info = info;\n    this.def = OPS[chooseRound(info)];\n    this.state = emptyView(this.def, info.players);\n    this.state.seats.forEach((s) => { s.x = s.tx = (s.id % 2 ? 3 : -3); s.z = s.tz = s.id < 2 ? 0.5 : 1.5; });\n    this.seatIndex = info.players.findIndex((p) => p.id === info.me);\n    this.control = this.seatIndex >= 0 ? new SeatControl(App, this.seatIndex, 'all') : null;\n    if (this.control) { this.control.x = this.state.seats[this.seatIndex].x; this.control.z = this.state.seats[this.seatIndex].z; this.control.tool = this.state.tools[0]; }\n    this.events = [];\n    this.n = 0;\n    this.lastSend = 0;\n    this.gotKey = false;\n    this.timer = setInterval(() => this.sendInput(), 66);\n  }\n  onMessage(data) {\n    if (data.t === 'k') { applyKey(this.state, data); this.gotKey = true; }\n    else if (data.t === 's' && this.gotKey) applySnap(this.state, data);\n    else if (data.t === 'e') this.events.push(...data.ev);\n  }\n  drain() { const e = this.events; this.events = []; return e; }\n  fixed(ctx, stage, dt) {\n    smoothView(this.state, dt);\n    if (!this.control || this.ended) return;\n    App.devices.poll(ctx);\n    this.control.frameEdges(ctx, this.state);\n    this.inp = { ...this.control.step(ctx, this.state, stage, dt) };\n    // Gentle correction if the local tip has drifted over a unit from the host's view of it.\n    const s = this.state.seats[this.seatIndex];\n    if (s && Math.hypot(s.tx - this.control.x, s.tz - this.control.z) > 3) { this.control.x += (s.tx - this.control.x) * 0.02; this.control.z += (s.tz - this.control.z) * 0.02; }\n  }\n  localTip(seat) { return seat.id === this.seatIndex && this.control ? { x: this.control.x, z: this.control.z } : null; }\n  /** 15 Hz, always, even idle: the harness requires traffic both ways. */\n  sendInput() {\n    if (this.ended || hub().time() === -Infinity) return;\n    const i = this.inp ?? {};\n    const s = this.state.seats[this.seatIndex];\n    hub().send({ t: 'i', n: ++this.n, x: Math.round((i.x ?? s?.x ?? 0) * 100), z: Math.round((i.z ?? s?.z ?? 0) * 100), tool: i.tool ?? null, use: i.use ? 1 : 0, gift: i.gift ? 1 : 0, steady: i.steady ? 1 : 0, a: i.a ? 1 : 0, b: i.b ? 1 : 0, rot: i.rot ? Math.round(i.rot) : 0 }, { to: hub().host, reliable: false });\n  }\n  stop() { this.ended = true; clearInterval(this.timer); }\n}\nEOF\ncat > src/stages/card.js <<'EOF'\n// The game's own card before a round: OR-7 wide, one masked figure per player in their seat colour, the\n// title, who is ready, how to win, the controls for this player's device, the time left.\nimport { App } from '../app.js';\nimport { TITLE } from '../core/meta.js';\nimport { OPS } from '../content/ops/index.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { chooseRound } from '../net/host.js';\nimport { Stage } from './stage.js';\n\nconst SPOTS = [[-1.9, 0, -2.0, 0.9], [1.9, 0, -2.0, -0.9], [-1.4, 0, -4.1, 0.6], [1.4, 0, -4.1, -0.6]];\n\nexport class CardStage extends Stage {\n  name = 'card';\n  cameraConfig = { preset: 'fixed', position: [0, 3.6, 3.8], target: [0, 1.1, -3], fov: 44, minZoom: 1, maxZoom: 1 };\n  constructor(info, session) { super(); this.info = info; this.session = session; this.card = { left: null, ready: [], asked: false, asking: 0, paused: false, starting: false }; }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    applyLook(ctx.engine, App.save.settings);\n    const rnd = window.AIHub.rng('card');\n    this.def = OPS[chooseRound(this.info)];\n    this.figs = this.info.players.map((p, i) => {\n      const f = new Figure(ctx, 'extra', SPOTS[i].slice(0, 3), SPOTS[i][3], rnd() > 0.5 ? 'Idle' : 'IdleLook');\n      f.object.traverse((m) => { if (m.isMesh) { m.material = m.material.clone(); m.material.userData = { ...m.material.userData, shared: false }; m.material.color.setStyle(p.color); } });\n      return f;\n    });\n    App.director.play('or-calm', { now: true });\n  }\n  onReady(ctx) { this.session.engineReady?.(); }\n  frame(ctx, dt) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figs ?? []) f.update(dt);\n    const d = App.devices;\n    const hub = window.AIHub;\n    const pressedReady = ctx.input.wasPressed('Enter') || d.pads.some((p) => p.edge[0]);\n    const pressedMore = ctx.input.wasPressed('KeyM') || d.pads.some((p) => p.edge[3]);\n    if (pressedReady) { hub.answer('ready'); App.sfx('uiConfirm'); }\n    if (pressedMore) { hub.answer('more'); App.sfx('uiMove'); }\n    if (d.click && this.readyBox && this.ui.hit(...this.readyBox)) { hub.answer('ready'); App.sfx('uiConfirm'); }\n    if (d.click && this.moreBox && this.ui.hit(...this.moreBox)) { hub.answer('more'); App.sfx('uiMove'); }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    const c = this.card;\n    ui.center(8, TITLE, { color: 'white', scale: 3, shadow: 'plum' });\n    if (this.def) {\n      ui.center(35, this.def.title, { color: 'sand', scale: 2 });\n      const obj = ui.wrap(this.def.patient.objective, w - 60);\n      obj.slice(0, 2).forEach((l, i) => ui.center(54 + i * 10, l, { color: 'white' }));\n    }\n    const y = h - 88;\n    ui.rect(14, y, w - 28, 80, 'ink');\n    ui.outline(14, y, w - 28, 80, 'slate');\n    this.info.players.forEach((p, i) => {\n      const yy = y + 5 + i * 11;\n      const ready = c.ready?.includes(p.id);\n      const col = Number.parseInt(p.color.slice(1), 16);\n      ui.rect(20, yy, 8, 8, col);\n      ui.text(32, yy, p.name.slice(0, 18), { color: col, shadow: false });\n      if (ready) ui.text(140, yy, 'READY', { color: 'lime', shadow: false });\n    });\n    const dx = w / 2 + 6;\n    ui.text(dx, y + 5, 'CONTROLS', { color: 'sand', shadow: false });\n    let cx = dx;\n    cx += ui.action(cx, y + 15, 'move') + 3; ui.text(cx, y + 16, 'MOVE', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, y + 15, 'use') + 3; ui.text(cx, y + 16, 'USE', { color: 'white', shadow: false });\n    cx = dx;\n    cx += ui.action(cx, y + 27, 'tool') + 3; ui.text(cx, y + 28, 'TOOL', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, y + 27, 'gift') + 3; ui.text(cx, y + 28, 'GIFT', { color: 'white', shadow: false });\n    // Answers.\n    const by = y + 44;\n    const rw = 90, mw = 96;\n    this.readyBox = [dx, by, rw, 13];\n    this.moreBox = [dx + rw + 6, by, mw, 13];\n    ui.rect(dx, by, rw, 13, 'navy'); ui.outline(dx, by, rw, 13, 'lime');\n    let bx = dx + 4;\n    bx += ui.action(bx, by + 2, 'confirm') + 3;\n    ui.text(bx, by + 3, 'READY', { color: 'lime', shadow: false });\n    ui.rect(dx + rw + 6, by, mw, 13, 'navy'); ui.outline(dx + rw + 6, by, mw, 13, c.asked ? 'sand' : 'slate');\n    bx = dx + rw + 10;\n    bx += ui.action(bx, by + 2, 'more') + 3;\n    ui.text(bx, by + 3, 'MORE TIME', { color: c.asked ? 'sand' : 'white', shadow: false });\n    const leftS = c.left != null ? Math.ceil(c.left / 1000) : null;\n    const msg = c.starting ? 'STARTING' : c.paused ? 'PAUSED: MORE TIME' : leftS != null ? `STARTS IN ${leftS}` : '';\n    ui.text(dx, y + 64, msg, { color: 'white', shadow: false });\n  }\n  status() { return 'card'; }\n}\nEOF\ncat > src/net/session.js <<'EOF'\n// An AI Hub session: no title, menus, pause, saves, attract or dev mode. Rounds are the hub's.\nimport { App } from '../app.js';\nimport { CardStage } from '../stages/card.js';\nimport { OperationStage, OP_CAMERA } from '../stages/operation.js';\nimport { HostLoop } from './host.js';\nimport { ClientSource, HostSource } from './client.js';\n\nexport function runSession(info, { Engine, BASE_OPTIONS }) {\n  const hub = window.AIHub;\n  App.inSession = true;\n  const S = { info, host: null, source: null, stage: null, engine: null, started: false, ended: false };\n  if (hub.isHost) {\n    S.host = new HostLoop(info);\n    S.host.start();\n  }\n  hub.on('card', (c) => { if (S.card) S.card.card = c; S.lastCard = c; });\n  hub.on('start', () => beginCountdown(S));\n  hub.on('message', (data, from) => {\n    if (S.host) S.host.onInput(data, from);\n    else if (S.source) S.source.onMessage?.(data);\n    else (S.pending = S.pending ?? []).push(data);\n  });\n  hub.on('leave', ({ id }) => { if (S.host) S.host.retire(id); });\n  hub.on('time-up', () => { if (hub.isHost && S.host) S.host.finish(false); });\n  hub.on('end', () => stopEverything(S));\n\n  // A server copy never starts the engine.\n  if (info.server) { hub.ready(); return; }\n  if (!navigator.gpu) { hub.fail('WebGPU unavailable'); return; }\n  startEngine(S, Engine, BASE_OPTIONS);\n}\n\nasync function startEngine(S, Engine, BASE_OPTIONS) {\n  const hub = window.AIHub;\n  const card = new CardStage(S.info, { engineReady() { if (!S.readySent) { S.readySent = true; hub.ready(); } } });\n  S.card = card;\n  if (S.lastCard) card.card = S.lastCard;\n  S.source = S.host ? new HostSource(S.host, S.info) : new ClientSource(S.info);\n  if (S.pending) { for (const d of S.pending) S.source.onMessage?.(d); S.pending = null; }\n  try {\n    S.engine = await Engine.start(card, { ...BASE_OPTIONS, container: document.getElementById('app'), settings: { button: false, key: false }, camera: card.cameraConfig });\n  } catch (err) {\n    hub.fail(String(err?.message ?? err));\n    return;\n  }\n  if (S.startPending) beginCountdown(S);\n}\n\nfunction beginCountdown(S) {\n  if (S.started || S.info.server) return;\n  if (!S.engine) { S.startPending = true; return; }\n  S.started = true;\n  S.card = null;\n  S.source.silentMusic = false;\n  const stage = new OperationStage({\n    opId: S.host ? S.host.def.id : S.source.def.id,\n    mode: 'net',\n    source: S.source,\n    seats: [{ binding: 'all' }],\n    viewSeat: Math.max(0, S.source.seatIndex ?? 0),\n    drawExtra: (st, ctx, ui) => drawCountdown(ui),\n  });\n  S.stage = stage;\n  // The local tip's controller lives on the source, and the stage's table follows it.\n  stage.controls = [];\n  App.goto(stage, { kind: 'iris', duration: 0.2, camera: OP_CAMERA });\n}\n\nfunction drawCountdown(ui) {\n  const t = window.AIHub.time();\n  if (t === -Infinity || t >= 0) { if (t >= 0 && t < 900) ui.center(ui.h * 0.32, 'SCRUB IN!', { color: 'lime', scale: 3 }); return; }\n  ui.center(ui.h * 0.32, String(Math.ceil(-t / 1000)), { color: 'white', scale: 5 });\n}\n\nfunction stopEverything(S) {\n  if (S.ended) return;\n  S.ended = true;\n  S.host?.stop();\n  S.source?.stop?.();\n  if (S.source) S.source.ended = true;\n  try {\n    App.ctx?.audio.playMusic(null);\n    App.ctx?.audio.stopLoops();\n    App.director.stop();\n  } catch { /* the page is going away */ }\n}\nEOF\ncat > tests/browser/hub.mjs <<'EOF'\n// The hub's own checks: serve dist/ on an OS-picked port, run the harness scenarios, print failures.\nimport { spawn } from 'node:child_process';\nimport { join } from 'node:path';\nimport { launch, ROOT } from './lib.mjs';\n\nconst SCENARIOS = ['auto=1&players=2', 'auto=1&players=3&latency=150&jitter=50&loss=5', 'auto=1&players=4&latency=150&jitter=50&loss=5', 'auto=1&players=4&latency=150&jitter=50&loss=5&scenario=host-leave', 'auto=1&players=2&scenario=server'];\n\nexport async function runHub(only) {\n  const srv = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: join(ROOT, 'dist'), stdio: ['ignore', 'pipe', 'ignore'] });\n  const port = await new Promise((res, rej) => {\n    srv.stdout.on('data', (d) => { const m = String(d).match(/port (\\d+)/); if (m) res(Number(m[1])); });\n    setTimeout(() => rej(new Error('no port')), 8000);\n  });\n  const fails = [];\n  let count = 0;\n  const b = await launch(['--no-sandbox']);\n  try {\n    const list = only ? SCENARIOS.filter((s) => only.some((o) => s.includes(o))) : SCENARIOS;\n    for (const sc of list) {\n      count++;\n      const ctx = await b.newContext({ viewport: { width: 1600, height: 1000 } });\n      const page = await ctx.newPage();\n      await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${sc}`);\n      try {\n        await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 240000 });\n        const rep = await page.evaluate(() => window.__hubCheck);\n        if (!rep.pass) fails.push(`hub ${sc}: ${rep.checks.filter((c) => !c.pass).map((c) => `${c.name} [${c.detail}]`).join('; ')}`);\n      } catch (e) {\n        const rep = await page.evaluate(() => window.__hubCheck).catch(() => null);\n        fails.push(`hub ${sc}: timeout ${rep ? JSON.stringify(rep.checks.filter((c) => !c.pass)) : e.message}`);\n      }\n      await ctx.close();\n    }\n  } finally {\n    await b.close();\n    srv.kill();\n  }\n  return { count, fails };\n}\nif (process.argv[1]?.endsWith('hub.mjs')) {\n  const r = await runHub(process.argv.slice(2).length ? process.argv.slice(2) : null);\n  for (const f of r.fails) console.log(f);\n  console.log(`${r.count - r.fails.length}/${r.count} hub scenarios passed`);\n  process.exit(r.fails.length ? 1 : 0);\n}\nEOF\nnode tools/build.mjs | tail -1; node tests/browser/hub.mjs players=2 2>&1 | tail -8","description":"Write codec, host, client, card and session; run hub harness","timeout":560000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7938,"cache_read_input_tokens":525245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7938},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"597d3a1c-db2a-4749-a8fd-5a8ff36f0d78","uuid":"4839018d-ea05-4e1a-a47c-0dae25c0c060","timestamp":"2026-11-05T16:14:18.475Z","request_id":"req_011Cgk5MHS18KEVP3wJcsjWg","wire_tool_inputs":{"toolu_01Spzg7AZCtXdXgEpWRm6cpC":{"command":"cat > src/sim/codec.js <<'EOF'\n// The network's copy of the sim: fixed-point ints in positional arrays. Plain data only.\n// Keyframes (reliable, 1 Hz, whole state, <= 16 KB); snapshots (unreliable, 12 Hz, what moved, <= 1100\n// bytes); event batches (reliable, up to 4 Hz). The view reads a plain state object from either source.\nimport { TOOLS } from './entities.js';\nimport { GEL_COLS, GEL_ROWS } from './entities.js';\n\nconst I = (v) => Math.round(v * 100);\nconst TOOL_I = (t) => { const i = [...TOOLS, 'dressing'].indexOf(t); return i; };\nconst TOOL_N = (i) => [...TOOLS, 'dressing'][i] ?? null;\n\n// Fields of an entity that a client needs but that never change, by kind, are in the keyframe; these are the\n// two kind-specific numbers a snapshot carries.\nfunction ab(e) {\n  switch (e.k) {\n    case 'pool': case 'bleeder': return [I(e.r), 0];\n    case 'incision': case 'dressing': return [I(e.s), 0];\n    case 'laceration': return [e.next, e.flip];\n    case 'mask': return [Math.round((e.painted ?? 0) * 100), 0];\n    case 'polyp': case 'egg': case 'cyst': case 'eye': case 'halo': case 'clot': return [Math.round((e.heat ?? 0) * 100), (e.open ? 1 : 0) + (e.locked ? 2 : 0) + (e.scanned ? 4 : 0)];\n    case 'fragment': case 'clamp': case 'donor': return [Math.round(e.rot ?? 0), (e.placed ? 1 : 0) + ((e.holders ?? 0) ? 2 : 0)];\n    default: return [I(e.s ?? 0), (e.free ? 1 : 0) + ((e.holders ?? 0) ? 2 : 0) + (e.locked ? 4 : 0) + (e.hidden ? 8 : 0)];\n  }\n}\nfunction applyAb(e, a, b) {\n  switch (e.k) {\n    case 'pool': case 'bleeder': e.r = a / 100; break;\n    case 'incision': case 'dressing': e.s = a / 100; break;\n    case 'laceration': e.next = a; e.flip = b; break;\n    case 'mask': e.painted = a / 100; break;\n    case 'polyp': case 'egg': case 'cyst': case 'eye': case 'halo': case 'clot': e.heat = a / 100; e.open = !!(b & 1); e.locked = !!(b & 2); e.scanned = !!(b & 4); break;\n    case 'fragment': case 'clamp': case 'donor': e.rot = a; e.placed = !!(b & 1); e.holders = b & 2 ? 1 : 0; break;\n    default: e.s = a / 100; e.free = !!(b & 1); e.holders = b & 2 ? 1 : 0; e.locked = !!(b & 4); e.hidden = !!(b & 8); break;\n  }\n}\n\nfunction gelBits(gel) {\n  // A coarse bitset, as hex.\n  let s = '', nib = 0, n = 0;\n  for (let i = 0; i < gel.length; i++) {\n    nib = (nib << 1) | (gel[i] > 0 ? 1 : 0);\n    if (++n === 4) { s += nib.toString(16); nib = 0; n = 0; }\n  }\n  if (n) s += (nib << (4 - n)).toString(16);\n  return s.replace(/0+$/, '');\n}\nfunction gelApply(bits, gel) {\n  gel.fill(0);\n  for (let i = 0; i < bits.length; i++) {\n    const nib = parseInt(bits[i], 16);\n    for (let k = 0; k < 4; k++) if (nib & (8 >> k)) gel[i * 4 + k] = 8;\n  }\n}\n\nconst roundPath = (p) => (p ? p.map((q) => [Math.round(q[0] * 100) / 100, Math.round(q[1] * 100) / 100]) : p);\n\n/** Everything a late or lossy client needs. */\nexport function encodeKey(sim) {\n  return {\n    t: 'k', n: sim.tick, op: sim.opId, st: sim.status, c: I(sim.clock), c0: I(sim.clock0), s: sim.stage, o: sim.objective, x: sim.context, ctx: sim.mistakes, sc: sim.score, st2: sim.streak,\n    tools: sim.tools, gifts: sim.giftsUnlocked ? 1 : 0, comp: Math.round(sim.composure), d: sim.doses, m: sim.music, cold: sim.cold,\n    tb: sim.tables.map((t) => ({ i: t.i, a: t.arena, v: I(t.vitals), f: t.fake, r: t.ring, g: gelBits(t.gel), mk: t.marks.slice(-50).map((m) => ({ ...m, path: roundPath(m.path), cells: m.cells ? m.cells.slice(0, 12) : undefined })), n: t.name })),\n    e: sim.ents.filter((e) => !e.dead).map((e) => {\n      const { path, cells, ...rest } = e;\n      const out = { ...rest };\n      delete out.onDone; delete out.onReveal; delete out.onDead; delete out.home; delete out.wasted; delete out.age; delete out.devSum; delete out.devT; delete out.devLen; delete out.eyes; delete out.plates; delete out.halos; delete out.way;\n      if (path) out.path = roundPath(path);\n      if (cells) out.cells = cells;\n      if (e.home) out.home = e.home;\n      return out;\n    }),\n    p: sim.seats.map((s) => seatRow(s)), h: sim.heart ? [Math.round(sim.heart.bpm), Math.round(sim.heart.phase * 100), sim.heart.calm ? 1 : 0, sim.heart.systole ? 1 : 0] : null,\n    cb: sim.codeBlue, ms: sim.massage, q: sim.quiet ? 1 : 0, pr: sim.prompt, pain: sim.pain, g: sim.handGhost,\n  };\n}\nconst seatRow = (s) => [s.id, I(s.x), I(s.z), TOOL_I(s.tool), (s.act ? 1 : 0) + (s.onTarget ? 2 : 0) + (s.grab ? 4 : 0) + (s.gone ? 8 : 0), Math.round(s.score), s.table, s.gift === 'look' ? 2 : s.gift === 'quiet' ? 1 : 0, TOOL_I(s.act), Math.round((s.draw ?? 0) * 100)];\n\n/** What moved since `last`, a Map of the last values sent. */\nexport function encodeSnap(sim, last) {\n  const e = [];\n  for (const o of sim.ents) {\n    if (o.dead) continue;\n    const [a, b] = ab(o);\n    const row = [o.n, I(o.x), I(o.z), a, b];\n    const key = row.join(',');\n    if (last.get(o.n) !== key) { last.set(o.n, key); e.push(row); }\n  }\n  const msg = {\n    t: 's', n: sim.tick, c: I(sim.clock), v: sim.tables.map((t) => I(t.vitals)), comp: Math.round(sim.composure), d: sim.doses, sc: sim.score, q: sim.quiet ? 1 : 0, mi: sim.mistakes,\n    p: sim.seats.map((s) => seatRow(s)), e,\n  };\n  if (sim.drops.length) msg.dr = sim.drops.filter((d) => !d.dead).slice(0, 24).map((d) => [I(d.x), I(d.z)]);\n  if (sim.heart) msg.h = [Math.round(sim.heart.bpm), Math.round(sim.heart.phase * 100), sim.heart.calm ? 1 : 0, sim.heart.systole ? 1 : 0];\n  if (sim.codeBlue) msg.cb = [Math.round(sim.codeBlue.charge * 100), sim.codeBlue.shocks, Math.round(sim.codeBlue.t * 10), sim.codeBlue.charging ? 1 : 0];\n  if (sim.massage) msg.ms = [sim.massage.n, sim.massage.next === 'a' ? 0 : 1, Math.round(sim.massage.phase * 100)];\n  return msg;\n}\n\n/** A plain state object the view can read. */\nexport function emptyView(def, seats) {\n  return {\n    def, opId: def.id, tick: 0, status: 'playing', clock: def.time, clock0: def.time, stage: 0, objective: '', context: null, mistakes: 0, score: 0, streak: 0, tools: [...(def.tools ?? [])], giftsUnlocked: true, composure: 40, doses: def.doses ?? 3, music: def.music, cold: null,\n    tables: (def.tables ?? [{ arena: def.arena }]).map((t, i) => ({ i, arena: t.arena ?? def.arena, vitals: def.vitals.start, fake: null, ring: t.ring ?? def.ring ?? [-5.1, 2.1], gel: new Array(GEL_COLS * GEL_ROWS).fill(0), marks: [], name: t.name ?? null })),\n    ents: [], drops: [], seats: seats.map((s, i) => ({ id: i, x: 0, z: 0.5, tx: 0, tz: 0.5, table: 0, tool: 'drain', gift: i % 2 ? 'look' : 'quiet', surgeon: 'ilya', bot: null, act: null, onTarget: false, grab: null, score: 0, draw: 0, gone: false, name: s.name })),\n    heart: null, codeBlue: null, massage: null, quiet: false, prompt: null, pain: 0, handGhost: null, ghostPlay: null,\n  };\n}\n\nfunction applySeatRows(view, rows) {\n  for (const r of rows) {\n    const s = view.seats[r[0]];\n    if (!s) continue;\n    s.tx = r[1] / 100;\n    s.tz = r[2] / 100;\n    s.tool = TOOL_N(r[3]) ?? s.tool;\n    s.act = r[4] & 1 ? (TOOL_N(r[8]) ?? s.tool) : null;\n    s.onTarget = !!(r[4] & 2);\n    s.grab = r[4] & 4 ? 'held' : null;\n    s.gone = !!(r[4] & 8);\n    s.score = r[5];\n    s.table = r[6];\n    s.gift = r[7] === 2 ? 'look' : r[7] === 1 ? 'quiet' : null;\n    s.draw = (r[9] ?? 0) / 100;\n  }\n}\n\nexport function applyKey(view, k) {\n  view.tick = k.n;\n  view.status = k.st;\n  view.clock = k.c / 100;\n  view.stage = k.s;\n  view.objective = k.o;\n  view.context = k.x;\n  view.mistakes = k.ctx;\n  view.score = k.sc;\n  view.streak = k.st2;\n  view.tools = k.tools;\n  view.giftsUnlocked = !!k.gifts;\n  view.composure = k.comp;\n  view.doses = k.d;\n  view.music = k.m;\n  view.cold = k.cold;\n  view.quiet = !!k.q;\n  view.prompt = k.pr;\n  view.pain = k.pain;\n  view.handGhost = k.g;\n  k.tb.forEach((t) => {\n    const v = view.tables[t.i];\n    if (!v) return;\n    v.vitals = t.v / 100;\n    v.fake = t.f;\n    v.ring = t.r;\n    gelApply(t.g, v.gel);\n    v.marks = t.mk;\n  });\n  // Entities: replace, keeping interpolated positions of what's already here.\n  const old = new Map(view.ents.map((e) => [e.n, e]));\n  view.ents = k.e.map((e) => {\n    const o = old.get(e.n);\n    return { ...e, tx: e.x, tz: e.z, x: o ? o.x : e.x, z: o ? o.z : e.z };\n  });\n  applySeatRows(view, k.p);\n  setHeart(view, k.h);\n  view.codeBlue = k.cb;\n  view.massage = k.ms;\n  return view;\n}\nexport function applySnap(view, s) {\n  if (s.n < view.tick) return view;\n  view.tick = s.n;\n  view.clock = s.c / 100;\n  s.v.forEach((v, i) => { if (view.tables[i]) view.tables[i].vitals = v / 100; });\n  view.composure = s.comp;\n  view.doses = s.d;\n  view.score = s.sc;\n  view.quiet = !!s.q;\n  view.mistakes = s.mi;\n  applySeatRows(view, s.p);\n  for (const r of s.e) {\n    const e = view.ents.find((o) => o.n === r[0]);\n    if (!e) continue;\n    e.tx = r[1] / 100;\n    e.tz = r[2] / 100;\n    applyAb(e, r[3], r[4]);\n  }\n  view.drops = (s.dr ?? []).map((d) => ({ x: d[0] / 100, z: d[1] / 100, table: 0, dead: false }));\n  setHeart(view, s.h);\n  if (s.cb && view.codeBlue) { view.codeBlue.charge = s.cb[0] / 100; view.codeBlue.shocks = s.cb[1]; view.codeBlue.t = s.cb[2] / 10; view.codeBlue.charging = !!s.cb[3]; }\n  if (s.ms && view.massage) { view.massage.n = s.ms[0]; view.massage.next = s.ms[1] ? 'b' : 'a'; view.massage.phase = s.ms[2] / 100; }\n  return view;\n}\nfunction setHeart(view, h) {\n  if (!h) { view.heart = null; return; }\n  view.heart = view.heart ?? { beat: 0 };\n  view.heart.bpm = h[0];\n  view.heart.phase = h[1] / 100;\n  view.heart.calm = !!h[2];\n  view.heart.systole = !!h[3];\n}\n/** Glide positions toward the last received, about 120 ms behind. */\nexport function smoothView(view, dt) {\n  const k = Math.min(1, dt * 9);\n  for (const e of view.ents) { if (e.tx != null) { e.x += (e.tx - e.x) * k; e.z += (e.tz - e.z) * k; } }\n  for (const s of view.seats) { s.x += (s.tx - s.x) * Math.min(1, dt * 12); s.z += (s.tz - s.z) * Math.min(1, dt * 12); }\n}\nconst KEEP_EVENTS = new Set(['say', 'rating', 'mistake', 'grab', 'pop', 'dish', 'stitch', 'knot', 'cutDone', 'sizzle', 'ping', 'reveal', 'inject', 'doseWasted', 'heal', 'music', 'stage', 'quietOn', 'quietOff', 'rewind', 'codeBlue', 'clear', 'badShock', 'revived', 'massageStart', 'massagePress', 'massageDone', 'knock', 'coreOut', 'strainHit', 'strainDying', 'strainDead', 'eyeOpen', 'weeperCrawl', 'sob', 'sobWave', 'thump', 'bpm', 'flare', 'plateOff', 'round', 'arrest', 'fx', 'won', 'lost', 'toolUnlocked', 'wrongTool']);\nexport const netEvents = (evs) => evs.filter((e) => KEEP_EVENTS.has(e.e)).map((e) => {\n  const c = { ...e };\n  if (c.x != null) c.x = Math.round(c.x * 100) / 100;\n  if (c.z != null) c.z = Math.round(c.z * 100) / 100;\n  return c;\n});\nEOF\npython3 - <<'EOF'\np='src/sim/entities.js'; s=open(p).read()\ns=s.replace(\"const e = { ...spec, id: spec.id ?? `e${sim.nextId++}`, k: spec.k,\",\"const n = sim.nextId++;\\n  const e = { ...spec, n, id: spec.id ?? `e${n}`, k: spec.k,\")\nopen(p,'w').write(s)\nEOF\ncat > src/net/host.js <<'EOF'\n// The host's copy runs the sim on a timer, from AIHub.time(): a hidden tab must not stall it, and a server\n// copy has no renderer at all.\nimport { createConfig } from '../core/config.js';\nimport { OPS, SESSION_OPS } from '../content/ops/index.js';\nimport { encodeKey, encodeSnap, netEvents } from '../sim/codec.js';\nimport { createOp, DT, drainEvents, step } from '../sim/op.js';\n\nconst hub = () => window.AIHub;\n\nexport function chooseRound(info) {\n  return SESSION_OPS[(info.round ?? 0) % SESSION_OPS.length].id;\n}\n\nexport function sessionSeats(info) {\n  return info.players.map((p, i) => ({ id: i, surgeon: 'ilya', gift: i % 2 === 0 ? 'quiet' : 'look', name: p.name, playerId: p.id }));\n}\n\nexport class HostLoop {\n  constructor(info) {\n    this.info = info;\n    this.def = OPS[chooseRound(info)];\n    this.seats = sessionSeats(info);\n    const rng = hub().rng('deal');\n    const seed = Math.floor(rng() * 2147483646) + 1;\n    this.sim = createOp(this.def, { seed, seats: this.seats, difficulty: 'resident', config: createConfig() });\n    this.inputs = {};\n    this.seatByPlayer = new Map(info.players.map((p, i) => [p.id, i]));\n    this.localEvents = [];\n    this.sendQueue = [];\n    this.lastSnap = 0;\n    this.lastKey = -1e9;\n    this.lastEv = 0;\n    this.last = new Map();\n    this.finished = false;\n    this.running = false;\n    this.ticks = 0;\n    this.tokens = 40;\n    this.tokenAt = 0;\n  }\n  onInput(data, from) {\n    const seat = this.seatByPlayer.get(from);\n    if (seat == null || data.t !== 'i') return;\n    const prev = this.inputs[seat];\n    if (prev && data.n < prev.n) return;\n    this.inputs[seat] = { n: data.n, x: data.x / 100, z: data.z / 100, tool: data.tool, use: !!data.use, gift: !!data.gift, steady: !!data.steady, a: !!data.a, b: !!data.b, rot: data.rot ?? 0, force: 1 };\n  }\n  setLocalInput(seat, inp) { this.inputs[seat] = inp; }\n  retire(id) {\n    const seat = this.seatByPlayer.get(id);\n    if (seat == null) return;\n    const s = this.sim.seats[seat];\n    s.gone = true;\n    if (s.grab) { const e = this.sim.ents.find((o) => o.id === s.grab); if (e) e.holders = Math.max(0, (e.holders ?? 1) - 1); s.grab = null; }\n    delete this.inputs[seat];\n  }\n  start() {\n    if (this.running) return;\n    this.running = true;\n    this.timer = setInterval(() => this.pump(), 16);\n    this.snapTimer = setInterval(() => this.net(), 83);\n  }\n  stop() {\n    this.running = false;\n    clearInterval(this.timer);\n    clearInterval(this.snapTimer);\n  }\n  pump() {\n    const t = hub().time();\n    if (t === -Infinity) return;\n    if (t < 0) return;\n    const target = Math.floor(t / (DT * 1000));\n    let n = 0;\n    while (this.ticks < target && n < 180 && this.sim.status === 'playing') {\n      step(this.sim, this.inputs);\n      this.ticks++;\n      n++;\n      const evs = drainEvents(this.sim);\n      if (evs.length) { this.localEvents.push(...evs); this.sendQueue.push(...netEvents(evs)); }\n    }\n    if (this.sim.status !== 'playing' && !this.finished) this.finish(this.sim.status === 'won');\n  }\n  /** Token bucket: at most 17 messages a second. */\n  send(data, o) {\n    const now = performance.now();\n    this.tokens = Math.min(30, this.tokens + ((now - this.tokenAt) / 1000) * 18);\n    this.tokenAt = now;\n    if (this.tokens < 1) return false;\n    this.tokens -= 1;\n    return hub().send(data, o);\n  }\n  net() {\n    if (hub().time() === -Infinity || this.finished) return;\n    const now = performance.now();\n    this.send(encodeSnap(this.sim, this.last), { reliable: false });\n    if (now - this.lastKey >= 1000) {\n      this.lastKey = now;\n      const key = encodeKey(this.sim);\n      let text = JSON.stringify(key);\n      if (text.length > 16000) { key.tb.forEach((tb) => { tb.mk = tb.mk.slice(-20); }); text = JSON.stringify(key); }\n      this.send(key, { reliable: true });\n    }\n    if (this.sendQueue.length && now - this.lastEv >= 250) {\n      this.lastEv = now;\n      const ev = this.sendQueue.splice(0, 40);\n      this.send({ t: 'e', ev }, { reliable: true });\n    }\n  }\n  takeLocalEvents() { const e = this.localEvents; this.localEvents = []; return e; }\n  finish(won) {\n    if (this.finished) return;\n    this.finished = true;\n    const info = this.info;\n    const sim = this.sim;\n    const players = info.players.filter((p) => !sim.seats[this.seatByPlayer.get(p.id)]?.gone);\n    const rows = players.map((p) => ({ id: p.id, seat: sim.seats[this.seatByPlayer.get(p.id)] }));\n    rows.sort((a, b) => b.seat.score - a.seat.score);\n    const standings = [];\n    for (const r of rows) {\n      const last = standings[standings.length - 1];\n      if (last && sim.seats[this.seatByPlayer.get(last[0])].score === r.seat.score) last.push(r.id);\n      else standings.push([r.id]);\n    }\n    const scores = Object.fromEntries(rows.map((r) => [r.id, Math.max(0, Math.round(r.seat.score))]));\n    const stats = Object.fromEntries(rows.map((r) => [r.id, {\n      Clean: String(r.seat.stats.clean), Good: String(r.seat.stats.good), Sloppy: String(r.seat.stats.sloppy), Mistakes: String(r.seat.stats.mistakes), Stitches: String(r.seat.stats.stitches), Doses: String(r.seat.stats.doses),\n    }]));\n    const awards = [];\n    const best = (fn) => rows.slice().sort((a, b) => fn(b) - fn(a))[0];\n    const hand = rows.filter((r) => r.seat.stats.cuts > 0).sort((a, b) => a.seat.stats.cutDev / a.seat.stats.cuts - b.seat.stats.cutDev / b.seat.stats.cuts)[0];\n    if (hand) awards.push({ id: hand.id, title: 'STEADIEST HAND', detail: 'The straightest cuts at the table' });\n    const st = best((r) => r.seat.stats.stitches);\n    if (st && st.seat.stats.stitches > 0) awards.push({ id: st.id, title: 'MOST STITCHES', detail: `${st.seat.stats.stitches} stitches tied` });\n    const sv = best((r) => r.seat.stats.saves + r.seat.stats.doses);\n    if (sv && sv.seat.stats.saves + sv.seat.stats.doses > 0) awards.push({ id: sv.id, title: 'SAVED THE DAY', detail: 'Doses and paddles when it counted' });\n    const sl = best((r) => r.seat.stats.sloppy + r.seat.stats.mistakes * 2);\n    if (sl && sl.seat.stats.sloppy + sl.seat.stats.mistakes > 0) awards.push({ id: sl.id, title: 'SLOPPIEST', detail: 'Enthusiasm is also a skill' });\n    this.flushFinal();\n    hub().finish({ standings, scores, won, stats, awards });\n    this.stop();\n  }\n  flushFinal() {\n    if (this.sendQueue.length) hub().send({ t: 'e', ev: this.sendQueue.splice(0, 60) }, { reliable: true });\n  }\n}\nEOF\ncat > src/net/client.js <<'EOF'\n// Sources of state for the operation view: the host's own sim, or the network's copy. A client moves its\n// own tip locally at once and corrects gently; everything else draws from snapshots about 120 ms behind.\nimport { applyKey, applySnap, emptyView, smoothView } from '../sim/codec.js';\nimport { OPS } from '../content/ops/index.js';\nimport { SeatControl } from '../input/cursor.js';\nimport { App } from '../app.js';\nimport { chooseRound } from './host.js';\n\nconst hub = () => window.AIHub;\n\nexport class HostSource {\n  constructor(host, info) {\n    this.host = host;\n    this.state = host.sim;\n    this.seatIndex = host.seatByPlayer.get(info.me);\n    this.control = this.seatIndex != null ? new SeatControl(App, this.seatIndex, 'all') : null;\n  }\n  drain() { return this.host.takeLocalEvents(); }\n  fixed(ctx, stage, dt) {\n    if (!this.control || this.ended) return;\n    App.devices.poll(ctx);\n    this.control.frameEdges(ctx, this.state);\n    const inp = this.control.step(ctx, this.state, stage, dt);\n    this.host.setLocalInput(this.seatIndex, { ...inp });\n  }\n  localTip() { return this.control ? { x: this.control.x, z: this.control.z } : null; }\n}\n\nexport class ClientSource {\n  constructor(info) {\n    this.info = info;\n    this.def = OPS[chooseRound(info)];\n    this.state = emptyView(this.def, info.players);\n    this.state.seats.forEach((s) => { s.x = s.tx = (s.id % 2 ? 3 : -3); s.z = s.tz = s.id < 2 ? 0.5 : 1.5; });\n    this.seatIndex = info.players.findIndex((p) => p.id === info.me);\n    this.control = this.seatIndex >= 0 ? new SeatControl(App, this.seatIndex, 'all') : null;\n    if (this.control) { this.control.x = this.state.seats[this.seatIndex].x; this.control.z = this.state.seats[this.seatIndex].z; this.control.tool = this.state.tools[0]; }\n    this.events = [];\n    this.n = 0;\n    this.lastSend = 0;\n    this.gotKey = false;\n    this.timer = setInterval(() => this.sendInput(), 66);\n  }\n  onMessage(data) {\n    if (data.t === 'k') { applyKey(this.state, data); this.gotKey = true; }\n    else if (data.t === 's' && this.gotKey) applySnap(this.state, data);\n    else if (data.t === 'e') this.events.push(...data.ev);\n  }\n  drain() { const e = this.events; this.events = []; return e; }\n  fixed(ctx, stage, dt) {\n    smoothView(this.state, dt);\n    if (!this.control || this.ended) return;\n    App.devices.poll(ctx);\n    this.control.frameEdges(ctx, this.state);\n    this.inp = { ...this.control.step(ctx, this.state, stage, dt) };\n    // Gentle correction if the local tip has drifted over a unit from the host's view of it.\n    const s = this.state.seats[this.seatIndex];\n    if (s && Math.hypot(s.tx - this.control.x, s.tz - this.control.z) > 3) { this.control.x += (s.tx - this.control.x) * 0.02; this.control.z += (s.tz - this.control.z) * 0.02; }\n  }\n  localTip(seat) { return seat.id === this.seatIndex && this.control ? { x: this.control.x, z: this.control.z } : null; }\n  /** 15 Hz, always, even idle: the harness requires traffic both ways. */\n  sendInput() {\n    if (this.ended || hub().time() === -Infinity) return;\n    const i = this.inp ?? {};\n    const s = this.state.seats[this.seatIndex];\n    hub().send({ t: 'i', n: ++this.n, x: Math.round((i.x ?? s?.x ?? 0) * 100), z: Math.round((i.z ?? s?.z ?? 0) * 100), tool: i.tool ?? null, use: i.use ? 1 : 0, gift: i.gift ? 1 : 0, steady: i.steady ? 1 : 0, a: i.a ? 1 : 0, b: i.b ? 1 : 0, rot: i.rot ? Math.round(i.rot) : 0 }, { to: hub().host, reliable: false });\n  }\n  stop() { this.ended = true; clearInterval(this.timer); }\n}\nEOF\ncat > src/stages/card.js <<'EOF'\n// The game's own card before a round: OR-7 wide, one masked figure per player in their seat colour, the\n// title, who is ready, how to win, the controls for this player's device, the time left.\nimport { App } from '../app.js';\nimport { TITLE } from '../core/meta.js';\nimport { OPS } from '../content/ops/index.js';\nimport { Figure } from '../view/figure.js';\nimport { applyLook } from '../view/looks.js';\nimport { SetView } from '../view/sets.js';\nimport { chooseRound } from '../net/host.js';\nimport { Stage } from './stage.js';\n\nconst SPOTS = [[-1.9, 0, -2.0, 0.9], [1.9, 0, -2.0, -0.9], [-1.4, 0, -4.1, 0.6], [1.4, 0, -4.1, -0.6]];\n\nexport class CardStage extends Stage {\n  name = 'card';\n  cameraConfig = { preset: 'fixed', position: [0, 3.6, 3.8], target: [0, 1.1, -3], fov: 44, minZoom: 1, maxZoom: 1 };\n  constructor(info, session) { super(); this.info = info; this.session = session; this.card = { left: null, ready: [], asked: false, asking: 0, paused: false, starting: false }; }\n  async build(ctx) {\n    this.set = new SetView(ctx, 'or7');\n    applyLook(ctx.engine, App.save.settings);\n    const rnd = window.AIHub.rng('card');\n    this.def = OPS[chooseRound(this.info)];\n    this.figs = this.info.players.map((p, i) => {\n      const f = new Figure(ctx, 'extra', SPOTS[i].slice(0, 3), SPOTS[i][3], rnd() > 0.5 ? 'Idle' : 'IdleLook');\n      f.object.traverse((m) => { if (m.isMesh) { m.material = m.material.clone(); m.material.userData = { ...m.material.userData, shared: false }; m.material.color.setStyle(p.color); } });\n      return f;\n    });\n    App.director.play('or-calm', { now: true });\n  }\n  onReady(ctx) { this.session.engineReady?.(); }\n  frame(ctx, dt) {\n    this.set.update(dt, ctx.camera.camera.position);\n    for (const f of this.figs ?? []) f.update(dt);\n    const d = App.devices;\n    const hub = window.AIHub;\n    const pressedReady = ctx.input.wasPressed('Enter') || d.pads.some((p) => p.edge[0]);\n    const pressedMore = ctx.input.wasPressed('KeyM') || d.pads.some((p) => p.edge[3]);\n    if (pressedReady) { hub.answer('ready'); App.sfx('uiConfirm'); }\n    if (pressedMore) { hub.answer('more'); App.sfx('uiMove'); }\n    if (d.click && this.readyBox && this.ui.hit(...this.readyBox)) { hub.answer('ready'); App.sfx('uiConfirm'); }\n    if (d.click && this.moreBox && this.ui.hit(...this.moreBox)) { hub.answer('more'); App.sfx('uiMove'); }\n  }\n  draw(ctx, ui) {\n    const w = ui.w, h = ui.h;\n    const c = this.card;\n    ui.center(8, TITLE, { color: 'white', scale: 3, shadow: 'plum' });\n    if (this.def) {\n      ui.center(35, this.def.title, { color: 'sand', scale: 2 });\n      const obj = ui.wrap(this.def.patient.objective, w - 60);\n      obj.slice(0, 2).forEach((l, i) => ui.center(54 + i * 10, l, { color: 'white' }));\n    }\n    const y = h - 88;\n    ui.rect(14, y, w - 28, 80, 'ink');\n    ui.outline(14, y, w - 28, 80, 'slate');\n    this.info.players.forEach((p, i) => {\n      const yy = y + 5 + i * 11;\n      const ready = c.ready?.includes(p.id);\n      const col = Number.parseInt(p.color.slice(1), 16);\n      ui.rect(20, yy, 8, 8, col);\n      ui.text(32, yy, p.name.slice(0, 18), { color: col, shadow: false });\n      if (ready) ui.text(140, yy, 'READY', { color: 'lime', shadow: false });\n    });\n    const dx = w / 2 + 6;\n    ui.text(dx, y + 5, 'CONTROLS', { color: 'sand', shadow: false });\n    let cx = dx;\n    cx += ui.action(cx, y + 15, 'move') + 3; ui.text(cx, y + 16, 'MOVE', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, y + 15, 'use') + 3; ui.text(cx, y + 16, 'USE', { color: 'white', shadow: false });\n    cx = dx;\n    cx += ui.action(cx, y + 27, 'tool') + 3; ui.text(cx, y + 28, 'TOOL', { color: 'white', shadow: false }); cx += 32;\n    cx += ui.action(cx, y + 27, 'gift') + 3; ui.text(cx, y + 28, 'GIFT', { color: 'white', shadow: false });\n    // Answers.\n    const by = y + 44;\n    const rw = 90, mw = 96;\n    this.readyBox = [dx, by, rw, 13];\n    this.moreBox = [dx + rw + 6, by, mw, 13];\n    ui.rect(dx, by, rw, 13, 'navy'); ui.outline(dx, by, rw, 13, 'lime');\n    let bx = dx + 4;\n    bx += ui.action(bx, by + 2, 'confirm') + 3;\n    ui.text(bx, by + 3, 'READY', { color: 'lime', shadow: false });\n    ui.rect(dx + rw + 6, by, mw, 13, 'navy'); ui.outline(dx + rw + 6, by, mw, 13, c.asked ? 'sand' : 'slate');\n    bx = dx + rw + 10;\n    bx += ui.action(bx, by + 2, 'more') + 3;\n    ui.text(bx, by + 3, 'MORE TIME', { color: c.asked ? 'sand' : 'white', shadow: false });\n    const leftS = c.left != null ? Math.ceil(c.left / 1000) : null;\n    const msg = c.starting ? 'STARTING' : c.paused ? 'PAUSED: MORE TIME' : leftS != null ? `STARTS IN ${leftS}` : '';\n    ui.text(dx, y + 64, msg, { color: 'white', shadow: false });\n  }\n  status() { return 'card'; }\n}\nEOF\ncat > src/net/session.js <<'EOF'\n// An AI Hub session: no title, menus, pause, saves, attract or dev mode. Rounds are the hub's.\nimport { App } from '../app.js';\nimport { CardStage } from '../stages/card.js';\nimport { OperationStage, OP_CAMERA } from '../stages/operation.js';\nimport { HostLoop } from './host.js';\nimport { ClientSource, HostSource } from './client.js';\n\nexport function runSession(info, { Engine, BASE_OPTIONS }) {\n  const hub = window.AIHub;\n  App.inSession = true;\n  const S = { info, host: null, source: null, stage: null, engine: null, started: false, ended: false };\n  if (hub.isHost) {\n    S.host = new HostLoop(info);\n    S.host.start();\n  }\n  hub.on('card', (c) => { if (S.card) S.card.card = c; S.lastCard = c; });\n  hub.on('start', () => beginCountdown(S));\n  hub.on('message', (data, from) => {\n    if (S.host) S.host.onInput(data, from);\n    else if (S.source) S.source.onMessage?.(data);\n    else (S.pending = S.pending ?? []).push(data);\n  });\n  hub.on('leave', ({ id }) => { if (S.host) S.host.retire(id); });\n  hub.on('time-up', () => { if (hub.isHost && S.host) S.host.finish(false); });\n  hub.on('end', () => stopEverything(S));\n\n  // A server copy never starts the engine.\n  if (info.server) { hub.ready(); return; }\n  if (!navigator.gpu) { hub.fail('WebGPU unavailable'); return; }\n  startEngine(S, Engine, BASE_OPTIONS);\n}\n\nasync function startEngine(S, Engine, BASE_OPTIONS) {\n  const hub = window.AIHub;\n  const card = new CardStage(S.info, { engineReady() { if (!S.readySent) { S.readySent = true; hub.ready(); } } });\n  S.card = card;\n  if (S.lastCard) card.card = S.lastCard;\n  S.source = S.host ? new HostSource(S.host, S.info) : new ClientSource(S.info);\n  if (S.pending) { for (const d of S.pending) S.source.onMessage?.(d); S.pending = null; }\n  try {\n    S.engine = await Engine.start(card, { ...BASE_OPTIONS, container: document.getElementById('app'), settings: { button: false, key: false }, camera: card.cameraConfig });\n  } catch (err) {\n    hub.fail(String(err?.message ?? err));\n    return;\n  }\n  if (S.startPending) beginCountdown(S);\n}\n\nfunction beginCountdown(S) {\n  if (S.started || S.info.server) return;\n  if (!S.engine) { S.startPending = true; return; }\n  S.started = true;\n  S.card = null;\n  S.source.silentMusic = false;\n  const stage = new OperationStage({\n    opId: S.host ? S.host.def.id : S.source.def.id,\n    mode: 'net',\n    source: S.source,\n    seats: [{ binding: 'all' }],\n    viewSeat: Math.max(0, S.source.seatIndex ?? 0),\n    drawExtra: (st, ctx, ui) => drawCountdown(ui),\n  });\n  S.stage = stage;\n  // The local tip's controller lives on the source, and the stage's table follows it.\n  stage.controls = [];\n  App.goto(stage, { kind: 'iris', duration: 0.2, camera: OP_CAMERA });\n}\n\nfunction drawCountdown(ui) {\n  const t = window.AIHub.time();\n  if (t === -Infinity || t >= 0) { if (t >= 0 && t < 900) ui.center(ui.h * 0.32, 'SCRUB IN!', { color: 'lime', scale: 3 }); return; }\n  ui.center(ui.h * 0.32, String(Math.ceil(-t / 1000)), { color: 'white', scale: 5 });\n}\n\nfunction stopEverything(S) {\n  if (S.ended) return;\n  S.ended = true;\n  S.host?.stop();\n  S.source?.stop?.();\n  if (S.source) S.source.ended = true;\n  try {\n    App.ctx?.audio.playMusic(null);\n    App.ctx?.audio.stopLoops();\n    App.director.stop();\n  } catch { /* the page is going away */ }\n}\nEOF\ncat > tests/browser/hub.mjs <<'EOF'\n// The hub's own checks: serve dist/ on an OS-picked port, run the harness scenarios, print failures.\nimport { spawn } from 'node:child_process';\nimport { join } from 'node:path';\nimport { launch, ROOT } from './lib.mjs';\n\nconst SCENARIOS = ['auto=1&players=2', 'auto=1&players=3&latency=150&jitter=50&loss=5', 'auto=1&players=4&latency=150&jitter=50&loss=5', 'auto=1&players=4&latency=150&jitter=50&loss=5&scenario=host-leave', 'auto=1&players=2&scenario=server'];\n\nexport async function runHub(only) {\n  const srv = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: join(ROOT, 'dist'), stdio: ['ignore', 'pipe', 'ignore'] });\n  const port = await new Promise((res, rej) => {\n    srv.stdout.on('data', (d) => { const m = String(d).match(/port (\\d+)/); if (m) res(Number(m[1])); });\n    setTimeout(() => rej(new Error('no port')), 8000);\n  });\n  const fails = [];\n  let count = 0;\n  const b = await launch(['--no-sandbox']);\n  try {\n    const list = only ? SCENARIOS.filter((s) => only.some((o) => s.includes(o))) : SCENARIOS;\n    for (const sc of list) {\n      count++;\n      const ctx = await b.newContext({ viewport: { width: 1600, height: 1000 } });\n      const page = await ctx.newPage();\n      await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${sc}`);\n      try {\n        await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 240000 });\n        const rep = await page.evaluate(() => window.__hubCheck);\n        if (!rep.pass) fails.push(`hub ${sc}: ${rep.checks.filter((c) => !c.pass).map((c) => `${c.name} [${c.detail}]`).join('; ')}`);\n      } catch (e) {\n        const rep = await page.evaluate(() => window.__hubCheck).catch(() => null);\n        fails.push(`hub ${sc}: timeout ${rep ? JSON.stringify(rep.checks.filter((c) => !c.pass)) : e.message}`);\n      }\n      await ctx.close();\n    }\n  } finally {\n    await b.close();\n    srv.kill();\n  }\n  return { count, fails };\n}\nif (process.argv[1]?.endsWith('hub.mjs')) {\n  const r = await runHub(process.argv.slice(2).length ? process.argv.slice(2) : null);\n  for (const f of r.fails) console.log(f);\n  console.log(`${r.count - r.fails.length}/${r.count} hub scenarios passed`);\n  process.exit(r.fails.length ? 1 : 0);\n}\nEOF\nnode tools/build.mjs | tail -1; node tests/browser/hub.mjs players=2 2>&1 | tail -8","description":"Write codec, host, client, card and session; run hub harness","timeout":560000}}}
