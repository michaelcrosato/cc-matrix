d, el: e }));\n}\n/* monster traits: each species carries one passive */\nconst TRAITS = ['regen', 'swift', 'guard'], TRAIT_TEXT = { regen: 'Recovers 3 HP at the start of its phase.', swift: 'Moves one hex further.', guard: 'Takes 10% less damage.' };\nG.all('monster').forEach((m, i) => { m.passive = TRAITS[i % 3]; G.def('skill', 'p_' + m.id, { id: 'p_' + m.id, name: m.names[0] + ' trait', kind: 'passive', range: [0, 0], mp: 0, power: 0, text: TRAIT_TEXT[m.passive], base: 'p_' + m.id, target: 'self', radius: 0, mobile: true }); });\nG.TRAIT_TEXT = TRAIT_TEXT;\nEOF\npython3 - <<'EOF'\nimport re\n# stats: items add int/hp\np='src/01-data.js'; s=open(p).read()\ns=s.replace(\"return { hp: Math.round(L.hp * t * g * G.tune.hpMul), atk:\",\"const sum = k2 => ['w', 'a', 'c'].reduce((a, sl) => a + ((it(eq[sl])[k2]) || 0), 0);\\n  return { hp: Math.round(L.hp * t * g * G.tune.hpMul) + sum('hp'), atk:\")\ns=s.replace(\"def: Math.round(L.def * t * g) + (it(eq.a).def || 0), int: Math.round(L.int * t * g),\",\"def: Math.round(L.def * t * g) + sum('def'), int: Math.round(L.int * t * g) + sum('int'),\")\ns=s.replace(\"atk: Math.round(L.atk * t * g) + (it(eq.w).atk || 0)\",\"atk: Math.round(L.atk * t * g) + sum('atk')\")\ns=s.replace(\"mov: L.mov + (it(eq.c).mov || 0), mp:\",\"mov: L.mov + sum('mov'), mp:\").replace(\"bond: L.bond + Math.floor(k.lvl / 4) + (it(eq.c).bond || 0),\",\"bond: L.bond + Math.floor(k.lvl / 4) + sum('bond'),\")\n# monster stats: passives\ns=s.replace(\"return { hp: Math.round(spec.hp * t * g * hm), atk: Math.round(spec.atk * t * g), def: Math.round(spec.def * t * g), int: Math.round(spec.int * t * g), spd: spec.spd, mov: spec.mov + (form >= 2 ? 0 : 0),\",\"return { hp: Math.round(spec.hp * t * g * hm), atk: Math.round(spec.atk * t * g), def: Math.round(spec.def * t * g * (spec.passive === 'guard' ? 1.1 : 1)), int: Math.round(spec.int * t * g), spd: spec.spd, mov: spec.mov + (spec.passive === 'swift' ? 1 : 0),\")\nopen(p,'w').write(s)\n# sim: base ids, element, regen, skills per tier\np='src/20-sim-battle.js'; s=open(p).read()\ns=s.replace(\"akind = sk && (sk.kind === 'aoe' && sk.id === 'bolt') ? 'magic' : a.akind;\",\"akind = sk && (sk.kind === 'aoe' && sk.base === 'bolt') ? 'magic' : a.akind;\")\ns=s.replace(\"const ak = sk ? (sk.id === 'bolt' ? 'magic' : sk.id === 'cleave' ? 'melee' : 'ranged') : akind;\",\"const ak = sk ? (sk.base === 'bolt' ? 'magic' : sk.base === 'cleave' ? 'melee' : 'ranged') : akind;\")\ns=s.replace(\"const ak = sk.id === 'bolt' ? 'magic' : sk.id === 'volley' ? 'ranged' : 'melee';\",\"const ak = sk.base === 'bolt' ? 'magic' : sk.base === 'volley' ? 'ranged' : 'melee';\")\ns=s.replace(\"const dm = B.damage(S, u, t, sk.power, ak); t.hp -= dm;\",\"const dm = B.damage(S, u, t, sk.power, ak, sk.el !== undefined ? { el: sk.el } : {}); t.hp -= dm;\")\ns=s.replace(\"skills: L.skills.slice(), ref: { t: 'k'\",\"skills: B.skillsFor(k, L), ref: { t: 'k'\")\ns=s.replace(\"function mkKnight(k, side, troop) {\",\"B.skillsFor = (k, L) => { const suf = k.tier >= 2 ? '_3' : k.tier >= 1 ? '_2' : ''; const out = L.skills.map(s => s + suf); const el = G.REALMS[k.realm] ? G.REALMS[k.realm].season : 4; if (el < 4 && k.lvl >= 6) out.push(L.skills[0] + '_s' + el); return out; };\\nfunction mkKnight(k, side, troop) {\")\ns=s.replace(\"    if (u.fx.daze) { u.done = true; u.acted = u.moved = true; }\",\"    if (u.fx.daze) { u.done = true; u.acted = u.moved = true; }\\n    if (u.kind === 'mon' && G.get('monster', u.species).passive === 'regen' && u.hp < u.maxhp) { const h = Math.min(3, u.maxhp - u.hp); u.hp += h; ev.push({ k: 'heal', u: u.uid, by: u.uid, amt: h }); }\")\nopen(p,'w').write(s)\np='src/63-battle-view.js'; s=open(p).read()\ns=s.replace(\"G.sfx(['heal', 'mend'].includes(e.skill) ? 'heal' : 'magic');\",\"G.sfx(G.get('skill', e.skill).kind === 'heal' ? 'heal' : 'magic');\").replace(\"e.skill === 'mend' ? 'rise' : 'ring'\",\"G.get('skill', e.skill).kind === 'heal' ? 'rise' : 'ring'\")\ns=s.replace(\"if (u.skills.length) G.T(g, 'Skills: ' + u.skills.map(s => G.get('skill', s).name).join(', '), x + 10, y + 88, '#ffd870');\",\"if (u.skills.length) UI.text(g, 'Skills: ' + u.skills.map(s => G.get('skill', s).name).join(', '), x + 10, y + 86, w - 20, '#ffd870', 9); else if (u.kind === 'mon') G.T(g, 'Trait: ' + G.TRAIT_TEXT[G.get('monster', u.species).passive], x + 10, y + 88, '#ffd870');\")\ns=s.replace(\"(u.kind === 'knight' ? G.LINES[u.line].names[u.tier] : ELNAMES[el]\",\"(u.kind === 'knight' ? G.className({ id: u.id.slice(2), tier: u.tier, line: u.line }) : ELNAMES[el]\")\nopen(p,'w').write(s)\np='src/22-sim-campaign.js'; s=open(p).read()\ns=s.replace(\"pool = ['potion', 'ether', 'seed', 'writ', 'blade', 'shield', 'charm', 'boots'];\",\"pool = G.ITEM_IDS;\")\ns=s.replace(\"R.pick(S.rng, ['potion', 'ether', 'blade', 'shield', 'charm', 'boots'])\",\"R.pick(S.rng, G.ITEM_IDS.filter(i => !['seed', 'writ'].includes(i)))\")\ns=s.replace(\"if (d && ['w', 'a', 'c'].includes(d.slot) && !k.equip[d.slot]) C.equip(S, kid, it);\",\"if (d && ['w', 'a', 'c'].includes(d.slot) && !k.equip[d.slot]) C.equip(S, kid, it);\")\nopen(p,'w').write(s)\np='src/62-scene-campaign.js'; s=open(p).read()\ns=s.replace(\"G.LINES[k.line].names[k.tier]\",\"G.className(k)\")\nopen(p,'w').write(s)\np='tests/run.mjs'; s=open(p).read()\ns=s.replace(\"ok(G.EVENTS.length >= 40, 'events');\",\"ok(G.EVENTS.length >= 40, 'events'); ok(G.all('skill').length >= 90 && G.ITEM_IDS.length === 33 && G.CLASSES.length === 23, 'skill, item and class tables', G.all('skill').length + '/' + G.ITEM_IDS.length + '/' + G.CLASSES.length);\\nfor (const sk of G.all('skill')) ok(sk.base && sk.name, 'skill complete ' + sk.id);\\nfor (const m of G.all('monster')) ok(G.get('skill', 'p_' + m.id) && m.passive, 'trait ' + m.id);\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"G.LINES\\[.*names\\[\" src/*.js | cut -c1-120 | head; node tools/build.mjs --js && node tests/run.mjs 2>&1 | head"}}}
