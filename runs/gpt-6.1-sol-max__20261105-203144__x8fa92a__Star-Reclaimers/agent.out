:40px;height:40px;transform:translate(-50%,-50%);color:var(--yellow)}#reticle:before,#reticle:after{content:'';position:absolute;background:currentColor}#reticle:before{left:50%;top:38%;width:2px;height:25%}#reticle:after{left:38%;top:50%;height:2px;width:25%}#reticle i{display:block;position:absolute;inset:0;border:1px solid #f6e4a688;clip-path:polygon(0 0,30% 0,30% 10%,10% 10%,10% 30%,0 30%,0 0,100% 0,100% 30%,90% 30%,90% 10%,70% 10%,70% 0,100% 0,100% 100%,70% 100%,70% 90%,90% 90%,90% 70%,100% 70%,100% 100%,0 100%,0 70%,10% 70%,10% 90%,30% 90%,30% 100%,0 100%)}.damage-flash{position:fixed;inset:0;box-shadow:inset 0 0 18vw #e7505580;pointer-events:none;opacity:0}.jump-overlay{position:fixed;inset:0;background:radial-gradient(ellipse,transparent 10%,#78cecb99);mix-blend-mode:screen;pointer-events:none;opacity:0}.jump-text{position:fixed;top:37%;width:100%;text-align:center;pointer-events:none;text-transform:uppercase}.jump-text strong{font-family:Display,Impact,sans-serif;font-size:3.8rem;letter-spacing:.13em;display:block}.jump-text small{font-family:'Courier New',monospace;font-size:.7rem;letter-spacing:.28em}.attract-banner{position:fixed;bottom:2.5vh;left:50%;transform:translateX(-50%);text-align:center;background:var(--yellow);color:var(--ink);padding:.8em 2em;z-index:5;box-shadow:4px 4px var(--ink)}.attract-banner strong{font-size:.8rem;letter-spacing:.15em}.attract-banner small{display:block;font-size:.56rem;margin-top:.5em;letter-spacing:.15em}#modal{position:fixed;inset:0;background:rgba(8,13,24,.82);backdrop-filter:blur(12px);z-index:8;display:flex;align-items:center;justify-content:center;padding:4vh 5vw}.modal-card{width:100%;max-width:68em;max-height:91vh;display:flex;flex-direction:column;overflow:hidden;border-top:3px solid var(--yellow);background:linear-gradient(135deg,#1b2635f7,#101827f5);box-shadow:0 25px 80px #0008;padding:2em 2.4em;position:relative}.modal-card.narrow{max-width:30em}.modal-head{display:flex;justify-content:space-between;align-it