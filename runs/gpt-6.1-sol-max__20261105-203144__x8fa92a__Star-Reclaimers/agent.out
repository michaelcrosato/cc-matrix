);this.selectedSector=next?.id??4;this.ui.comms(next?'\"'Sector secured. Recover wreck energy or dock, then open your chart for the next patrol.':'Outer sectors secured. The command ship is exposed in Broken Crown. Chart your jump.',7)}}}\n addExplosion(pos,size){this.effects.push(explosion(this.scene,pos,size,this.gameRng))}\n hurt(amount){if(this.attract||this.devInvincible)return;this.stats.damageTaken+=amount;const p=this.player;p.lastHit=this.elapsed;let rest=amount;if(p.shields&&p.shield>0){const absorb=Math.min(p.shield,amount*.9);p.shield-=absorb;rest-=absorb}p.hp=Math.max(0,p.hp-rest);this.ui.damage=1;this.audio.fx('hit');if(p.hp<35&&this.cooldowns.bump<=0)this.ui.comms('Hull damage. Starbase repairs are advised. Strongly.',5)}\n spawnPickup(pos,cache=false){const root=glow(new THREE.OctahedronGeometry(cache?8:5),C.cyan);root.add(glow(new THREE.TorusGeometry(cache?13:8,.5,4,16),C.paper));root.position.copy(pos);this.field.add(root);this.pickups.push({pos,root,cache,taken:false})}\n collect(item){if(item.taken)return;item.taken=true;this.field.remove(item.root);this.player.energy=Math.min(100,this.player.energy+(item.cache?28:16));this.player.shield=Math.min(100,this.player.shield+8);this.stats.salvage++;this.score+=item.cache?100:35;this.audio.fx('ui');this.ui.notice('WRECK ENERGY RECOVERED +'+(item.cache?28:16)+' EU',2)}\n cycleTarget(){const living=this.enemies.filter(e=>e.alive);if(\"'!living.length){this.target=null;return}const i=living.indexOf(this.target);this.target=living[(i+1)%living.length];this.audio.fx('\"'ui')}\n toggleShield(){this.player.shields=\"'!this.player.shields;this.ui.notice('\"'SHIELD '+(this.player.shields?'ENABLED':'OFFLINE — conserving energy'),2);this.audio.fx('ui')}\n nova(){if(this.state\"'!=='\"'playing'||this.ui.blocksSimulation())return;if(this.player.nova<=0||this.cooldowns.nova>0||this.player.energy<18){this.ui.notice(this.player.nova<=0?'NOVA RACK EMPTY — rearm at a starbase':this.player.energy<18?'NOVA NEEDS 18 ENERGY':'NOVA RECHARGING',2);return}this.player.nova--;this.player.energy-=18;this.cooldowns.nova=7;this.stats.nova++;this.addExplosion(this.player.pos.clone(),110);this.audio.fx('nova');for(const e of this.enemies)if(e.alive&&e.pos.distanceTo(this.player.pos)<450)this.damageEnemy(e,150);for(const b of this.projectiles)if(\"'!b.friendly)b.life=0;this.ui.notice('\"'NOVA DISCHARGED / 450 m BLAST',2)}\n interaction(){if(this.docking)return {type:'docking',label:'DOCKING / REPAIRING'};if(this.dockPos&&this.player.pos.distanceTo(this.dockPos)<150){if(this.enemies.some(e=>e.alive))return {type:'blocked',label:'DOCK LOCKED / HOSTILES IN SECTOR'};if(vector(this.playerBody.linvel()).length()>90)return {type:'brake',label:'REDUCE SPEED TO DOCK'};return {type:'dock',label:'DOCK / REPAIR + REFUEL'}}const item=this.pickups.find(i=>\"'!i.taken&&i.pos.distanceTo(this.player.pos)<220);if(item)return {type:'\"'salvage',label:'TRACTOR WRECK ENERGY',item};return null}\n interact(){const act=this.interaction();if(act?.type==='dock'){this.docking={time:2.5};this.player.throttle=0;this.playerBody.setLinvel({x:0,y:0,z:0},true);this.audio.fx('dock');this.ui.comms('Docking clamps engaged. Welcome home, patrol.',4)}else if(act?.type==='salvage')this.collect(act.item);else if(act)this.ui.notice(act.label,3);else if(this.stationPos)this.ui.notice('Approach the cyan docking ring. Match speed below 90 m/s.',4);else this.ui.notice('No docking or salvage contact in range.',3)}\n unlocked(index){return index\"'!==4||this.campaign.slice(0,3).every(s=>s.cleared)||this.bossDefeated}\n jumpTo(index=this.selectedSector){if(this.state!=='\"'playing'||this.jump||this.docking)return false;if(\"'!this.unlocked(index)){this.ui.notice('\"'Clear Kestrel, Ember Belt and Picket to locate the Crown.',4);return false}if(index===this.sector){this.ui.notice('Already in this sector.',2);return false}if(this.player.energy<12&&\"'!this.attract){this.ui.notice('\"'HYPERSPACE NEEDS 12 ENERGY. Reactor reserve is charging.',4);return false}this.ui.closeModal();this.player.energy=Math.max(0,this.player.energy-12);this.jump={to:index,time:this.cfg.jumpTime,max:this.cfg.jumpTime};this.audio.fx('jump');return true}\n updateCamera(dt){const p=this.player;if(\"'!p)return;this.playerMesh.position.copy(p.pos);this.playerMesh.quaternion.copy(p.q);this.playerMesh.userData.mixer.update(dt);this.playerMesh.visible=!!this.chase;this.cockpit.visible=!this.chase;const desired=p.pos.clone();if(this.chase){desired.add(new V(0,18,65).applyQuaternion(p.q));this.camera.position.lerp(desired,Math.min(1,dt*8));this.camera.quaternion.slerp(p.q,Math.min(1,dt*9))}else{this.camera.position.copy(desired);this.camera.quaternion.copy(p.q);if(this.settings.shake&&this.ui.damage>.01){this.camera.position.x+=Math.sin(this.elapsed*97)*this.ui.damage*.7;this.camera.position.y+=Math.sin(this.elapsed*73)*this.ui.damage*.5}this.cockpit.rotation.z=THREE.MathUtils.lerp(this.cockpit.rotation.z,-this.inputs.strafe*.04,Math.min(1,dt*5))}this.camera.fov=67+(this.inputs.boost?8:0)+(this.jump?Math.sin((1-this.jump.time/this.jump.max)*Math.PI)*30:0);this.camera.updateProjectionMatrix()}\n autopilot(dt){const p=this.player;this.inputs.strafe=0;this.inputs.boost=false;this.inputs.fire=false;p.shields=true;if(this.attract)p.hp=p.energy=p.shield=100;if(this.jump||this.docking)return;let target=this.enemies.find(e=>e.alive&&e.kind==='\"'relay')||this.enemies.find(e=>e.alive);if(target){this.target=target;const dir=this.intercept(target);const q=new THREE.Quaternion().setFromUnitVectors(FORWARD,dir);const eu=new THREE.Euler().setFromQuaternion(q,'YXZ');p.yaw=eu.y;p.pitch=eu.x;p.roll=0;p.q.copy(q);p.throttle=target.pos.distanceTo(p.pos)>480?.3:0;this.inputs.fire=true;this.autoWait=0;if(this.attract&&this.elapsed>8&&p.nova>2&&target.pos.distanceTo(p.pos)<430)this.nova()}else{this.autoWait+=dt;if(this.autoWait<2)return;if(this.bossDefeated){if(this.sector\"'!==0){this.jumpTo(0);return}this.flyToDock(dt);return}const next=this.campaign.find(s=>s.required&&!s.cleared);if(next){this.jumpTo(next.id);this.autoWait=0}else if(this.autoStage===0&&this.attract){this.autoStage=1;this.jumpTo(3);this.autoWait=0}else if(this.sector===3&&this.stats.docks===0){this.flyToDock(dt)}else{this.jumpTo(4);this.autoWait=0}}}\n flyToDock(dt){if(!this.dockPos)return;const delta=this.dockPos.clone().sub(this.player.pos),distance=delta.length();const q=new THREE.Quaternion().setFromUnitVectors(FORWARD,delta.normalize());const eu=new THREE.Euler().setFromQuaternion(q,'\"'YXZ');this.player.yaw=eu.y;this.player.pitch=eu.x;this.player.roll=0;this.player.throttle=distance>170?.55:distance>110?.12:0;if(distance<150){this.playerBody.setLinvel({x:0,y:0,z:0},true);this.interact()}}\n finish(won){if(this.state\"'!=='\"'playing')return;if(this.attract){this.autoWait=0;this.start(true);return}this.state='debrief';this.inputs.fire=false;this.mouse.fire=false;this.won=won;if(won){this.score+=1000+Math.round(this.baseHull*5+this.player.hp*2);this.audio.fx('victory')}else this.audio.fx('warn');if(this.score>this.best&&\"'!this.hubActive){this.best=this.score;try{localStorage.setItem('\"'reclaimers-best',String(this.best))}catch{}}this.reportResult();if(\"'!this.hubActive)this.ui.debrief(won)}\n reportResult(){if(!this.hubActive||this.resultReported||this.hubEnded)return;this.resultReported=true;AIHub.result({score:this.score,stats:{Contacts:this.stats.kills,'\"'Hull intact':Math.round(this.player.hp),'Base intact':Math.round(this.baseHull),Jumps:this.stats.jumps,'Dock visits':this.stats.docks,Seconds:Math.round(this.elapsed)}})}\n ghostState(){return {sector:this.sector,p:this.player.pos.toArray().map(n=>Math.round(n*10)/10),q:this.player.q.toArray().map(n=>Math.round(n*1000)/1000),score:this.score,status:this.state,shots:this.stats.shots}}\n receiveGhost(state,id,name,color){this.ghosts.set(id,{...state,id,name,color,received:performance.now()});if(\"'!this.ghostMeshes.has(id)){const mesh=holoShip(new THREE.Color(color));this.scene.add(mesh);this.ghostMeshes.set(id,mesh)}}\n renderGhosts(dt){for(const [id,g] of this.ghosts){const m=this.ghostMeshes.get(id);if(!m)continue;m.visible=g.sector===this.sector&&this.state==='\"'playing'&&performance.now()-g.received<8000;if(m.visible){m.position.lerp(new V(...g.p),Math.min(1,dt*12));m.quaternion.slerp(new THREE.Quaternion(...g.q),Math.min(1,dt*12));m.userData.mixer?.update(dt)}}}\n resize(){if(\"'!this.renderer)return;this.camera.aspect=innerWidth/innerHeight;this.camera.updateProjectionMatrix();this.renderer.setSize(innerWidth,innerHeight);this.ui.resize()}\n saveSettings(){this.audio.apply();if(!this.hubActive)try{localStorage.setItem('\"'reclaimers-settings',JSON.stringify(this.settings))}catch{}}\n snapshot(){return {ready:this.ready,error:this.error,state:this.state,backend:this.backend,three:THREE.REVISION,rapier:RAPIER.version(),sector:this.sector,score:this.score,elapsed:this.elapsed,player:{hp:this.player.hp,shield:this.player.shield,energy:this.player.energy,shields:this.player.shields,nova:this.player.nova,heat:this.player.heat,pos:this.player.pos.toArray(),throttle:this.player.throttle},enemies:this.enemies.filter(e=>e.alive).map(e=>({id:e.id,kind:e.kind,hp:e.hp,pos:e.pos.toArray()})),campaign:this.campaign.map(s=>({name:s.name,cleared:s.cleared,visited:s.visited,docked:s.docked})),stats:{...this.stats},page:this.ui.page,attract:this.attract,chase:\"'!!this.chase,ghosts:[...this.ghosts.values()].map(g=>({id:g.id,sector:g.sector,score:g.score})),hubActive:this.hubActive,hubEnded:this.hubEnded,resultReported:this.resultReported,link:this.net.connected,music:this.settings.music,frameCount:this.frameCount}}\n expose(){window.__STAR_RECLAIMERS__={snapshot:()=>this.snapshot(),audioProof:()=>this.audio.proof()};if(new URLSearchParams(location.search).has('\"'test')){Object.assign(window.__STAR_RECLAIMERS__,{start:()=>this.start(),advance:n=>{for(let i=0;i<n;i++)if(this.state==='playing'&&\"'!this.ui.blocksSimulation())this.tick(1/60);this.updateCamera(1/60);this.ui.update(.1);return this.snapshot()},ai:value=>{this.ai=value},invincible:value=>{this.devInvincible=value},aim:id=>{const e=this.enemies.find(e=>e.id===id&&e.alive);if(e){this.target=e;const eu=new THREE.Euler().setFromQuaternion(new THREE.Quaternion().setFromUnitVectors(FORWARD,this.intercept(e)),'\"'YXZ');this.player.yaw=eu.y;this.player.pitch=eu.x}},action:(name,value)=>this.ui.command(name,value),idle:()=>{this.lastActivity=performance.now()-10001},set:(key,value)=>{if(key in this.cfg)this.cfg[key]=value},position:(x,y,z)=>{this.playerBody.setTranslation({x,y,z},true);this.player.pos.set(x,y,z)},refill:()=>{this.player.hp=this.player.shield=this.player.energy=100;this.player.nova=3},damage:n=>this.hurt(n),clear:()=>{for(const e of this.enemies)if(e.alive)this.damageEnemy(e,100000)},connectLocal:()=>this.net.local(),launchLinked:()=>this.net.launch(),offer:()=>this.net.offer(),answer:code=>this.net.answer(code),link:code=>this.net.finish(code),dev:()=>this.ui.dev()})}}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {THREE,C,ship,station,flagship,asteroid,createSky,createCockpit,explosion,glow,holoShip} from './visuals.js';\nimport {AudioSystem} from './audio.js';\nimport {WingLink} from './network.js';\nimport {UI} from './ui.js';\nexport const DEFAULTS={damage:28,enemyDamage:11,aggression:1,speed:150,fireInterval:.17,energyDrain:1,jumpTime:2.6};\nexport const SECTORS=[\n {name:'Kestrel',type:'STARBASE PERIMETER',symbol:'◇',brief:'Break the raid. Keep the base standing.',station:true,required:true,kinds:['fighter','fighter','fighter']},\n {name:'Ember Belt',type:'ASTEROID INTERDICTION',symbol:'◌',brief:'Sweep the belt. Watch the rocks.',required:true,kinds:['fighter','fighter','fighter','bomber'],rocks:22},\n {name:'Picket',type:'ENEMY RELAY',symbol:'⌁',brief:'Silence the raiders guarding the relay.',required:true,kinds:['bomber','fighter','bomber'],rocks:8},\n {name:'Haven',type:'REPAIR ANCHORAGE',symbol:'◇',brief:'A quiet dock. Repair, rearm, breathe.',station:true,kinds:[],rocks:5},\n {name:'Broken Crown',type:'COMMAND SHIP',symbol:'♜',brief:'Destroy both shield relays. Then the core.',boss:true,kinds:['boss','relay','relay','fighter','fighter']},\n {name:'Quiet Drift',type:'SALVAGE FIELD',symbol:'✧',brief:'Recover energy. Mind the old mines.',kinds:['mine','mine','mine'],rocks:14}\n];\nexport function rng(seed){let v=seed>>>0;return()=>{v=(1664525*v+1013904223)>>>0;return v/4294967296}}\nconst V=THREE.Vector3;const FORWARD=new V(0,0,-1);const UP=new V(0,1,0);\nfunction vector(p){return new V(p.x,p.y,p.z)}\nexport class Game{\n constructor(){this.state='boot';this.phase='title';this.hubActive=false;this.hubEnded=false;this.hubStarted=false;this.ready=false;this.cfg={...DEFAULTS};this.settings={master:.65,music:.1,sfx:.65,sensitivity:1,glyphs:'ps',invert:false,shake:true};try{Object.assign(this.settings,JSON.parse(localStorage.getItem('reclaimers-settings')||'{}'));this.best=Number(localStorage.getItem('reclaimers-best')||0)}catch{this.best=0}this.audio=new AudioSystem(this.settings);this.ui=new UI(this);this.net=new WingLink(this);this.ghosts=new Map();this.ghostMeshes=new Map();this.ghostClock=0;this.ghostSend=0;this.lastActivity=performance.now();this.elapsed=0;this.attract=false;this.ai=false;this.devInvincible=false;this.cooldowns={fire:0,nova:0,bump:0};this.inputs={thrust:0,strafe:0,lookX:0,lookY:0,roll:0,fire:false,boost:false};this.keys=new Set();this.mouse={x:0,y:0,active:false,fire:false};this.touch={left:null,right:null,x:0,y:0,lx:0,ly:0};this.inputMode='keyboard';this.padPrevious=[];this.padMenuTimer=0;this.hudClock=0;this.simAccumulator=0;this.rng=rng(8201982);this.configSeed=8201982;this.frameCount=0;this.stats={shots:0,hits:0,kills:0,jumps:0,docks:0,nova:0,salvage:0,rapierHits:0,damageTaken:0,relays:0};this.error=null;this.registerInput()}\n async init(){document.getElementById('load-status').textContent='Calibrating Rapier flight physics…';await RAPIER.init();this.scene=new THREE.Scene();this.scene.background=new THREE.Color(0x141d30);this.camera=new THREE.PerspectiveCamera(67,innerWidth/innerHeight,.1,5000);this.scene.add(this.camera);this.renderer=new THREE.WebGPURenderer({canvas:document.getElementById('world'),antialias:true,forceWebGL:new URLSearchParams(location.search).get('renderer')==='webgl'});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.setSize(innerWidth,innerHeight);this.renderer.outputColorSpace=THREE.SRGBColorSpace;this.renderer.toneMapping=THREE.ACESFilmicToneMapping;this.renderer.toneMappingExposure=1.28;document.getElementById('load-status').textContent='Opening the canopy. Initializing the renderer…';await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2';const ambient=new THREE.AmbientLight(0xb7b2d1,1.9);this.scene.add(ambient);this.sun=new THREE.DirectionalLight(0xffe3ad,3.1);this.sun.position.set(-400,500,300);this.scene.add(this.sun);const rim=new THREE.DirectionalLight(0x74b9c7,1.4);rim.position.set(300,-100,-500);this.scene.add(rim);this.sky=createSky(rng(203144));this.scene.add(this.sky);this.field=new THREE.Group();this.scene.add(this.field);this.effects=[];this.cockpit=createCockpit(this.camera);this.cockpit.visible=false;this.playerMesh=ship('fighter',true);this.scene.add(this.playerMesh);this.playerMesh.visible=false;this.titleHero=ship('fighter',true);this.titleHero.position.set(140,30,-210);this.titleHero.rotation.set(.1,-.55,-.22);this.titleHero.scale.setScalar(2.8);this.scene.add(this.titleHero);this.startCampaign();this.loadSector(0);this.ready=true;window.addEventListener('resize',()=>this.resize());this.resize();this.state='title';this.ui.title();const info=await AIHub.connect({mode:'ghost',seats:[1,4]});if(info){this.hubActive=true;this.hubInfo=info;this.configSeed=Number(info.seed)||8201982;this.rng=rng(this.configSeed);this.startCampaign();this.state='hub-wait';this.titleHero.visible=false;this.ui.setGameplay(true);this.ui.closeModal();document.getElementById('title-screen').classList.add('hide');this.loadSector(0);this.ui.comms('Stand by, pilot. Flight control has the clock.',10);AIHub.on('start',()=>{this.hubStarted=true});AIHub.on('message',(data,from)=>{if(data?.kind==='patrol'&&this.net.valid(data.state)){const p=AIHub.players.find(x=>x.id===from);this.receiveGhost(data.state,from,p?.name||'WINGMATE',p?.color||'#8bdaca')}});AIHub.on('leave',({id})=>{this.ghosts.delete(id);const m=this.ghostMeshes.get(id);if(m)m.visible=false});AIHub.on('time-up',()=>this.reportResult());AIHub.on('end',()=>{this.hubEnded=true;this.state='ended';this.audio.stop();this.inputs.fire=false;this.keys.clear();this.ui.closeModal();this.ui.comms('Patrol complete. Flight control has your report.',99999)});AIHub.ready()}\n this.lastFrame=performance.now();this.renderer.setAnimationLoop(t=>this.frame(t));document.getElementById('loading').classList.add('hide');this.ui.refreshPrompts();this.expose()}\n startCampaign(){this.campaign=SECTORS.map((s,i)=>({...s,id:i,visited:false,cleared:s.kinds.length===0,docked:false,enemies:s.kinds.map((kind,j)=>({id:i*100+j+1,kind,hp:kind==='boss'?720:kind==='relay'?140:kind==='bomber'?112:kind==='mine'?32:64,maxHp:kind==='boss'?720:kind==='relay'?140:kind==='bomber'?112:kind==='mine'?32:64,dead:false}))}));this.player={hp:100,shield:100,energy:100,shields:true,nova:3,heat:0,throttle:.24,pos:new V(0,0,90),q:new THREE.Quaternion(),yaw:0,pitch:0,roll:0,lastHit:-10};this.score=0;this.baseHull=100;this.elapsed=0;this.sector=0;this.selectedSector=1;this.target=null;this.jump=null;this.docking=null;this.bossDefeated=false;this.resultReported=false;this.autoStage=0;this.autoWait=0;this.stats={shots:0,hits:0,kills:0,jumps:0,docks:0,nova:0,salvage:0,rapierHits:0,damageTaken:0,relays:0};this.cooldowns={fire:0,nova:0,bump:0};this.gameRng=rng(this.configSeed)}\n loadSector(index){if(this.world)this.world.free();this.world=new RAPIER.World({x:0,y:0,z:0});this.world.timestep=1/60;this.events=new RAPIER.EventQueue(true);this.field.clear();for(const fx of this.effects||[])this.scene.remove(fx.root);this.effects=[];this.enemies=[];this.projectiles=[];this.rocks=[];this.pickups=[];this.hitMap=new Map();this.stationMesh=null;this.sector=index;this.campaign[index].visited=true;this.player.pos.set(0,0,100);this.player.yaw=0;this.player.pitch=0;this.player.roll=0;this.player.q.identity();this.playerBody=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,0,100).setLinearDamping(.1).setAngularDamping(10).setCcdEnabled(true));this.playerCol=this.world.createCollider(RAPIER.ColliderDesc.ball(4).setRestitution(.3).setCollisionGroups((1<<16)|26).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),this.playerBody);this.hitMap.set(this.playerCol.handle,{kind:'player'});const def=this.campaign[index];const random=rng(this.configSeed+index*901);if(def.stati