ding-tape{display:none}.touch .gauges{position:fixed;top:3.5vh;left:50%;transform:translateX(-50%);padding:.4em .8em;gap:1em;font-size:.8em}.touch .gauge{width:4em}.touch .gauge strong{font-size:1.2rem}.touch .sector-block h2{font-size:1rem}.touch .sector-block small,.touch .score-block{display:none}.touch .objective{top:12vh;font-size:.66rem;max-width:19em}.touch .objective small{font-size:.48rem}.touch .touch-action{position:fixed;bottom:2em;background:#142637d9;border:1px solid #b1c7bd;color:var(--paper);padding:.7em 1em;font-size:.72rem;pointer-events:auto}.touch #touch-chart{left:1.4em}.touch #touch-nova{right:1.4em}.touch .modal-card{padding:1.2em;max-height:94vh}.touch .modal-head h2{font-size:2rem}.touch .modal-head p{font-size:.68rem}.touch .modal-footer{margin-top:.8em}.touch .title-foot{font-size:.6rem}.touch .link-group{gap:1.2em}@media(max-width:900px){.title-side{max-width:15em;font-size:.9em;bottom:16vh}.intro-copy{font-size:.8rem}.actions{gap:1em;font-size:.56rem}.gauges{gap:.8em}.gauge{width:4.3em}.target-readout{width:11em}.comms{max-width:19em;font-size:.66rem}.instruction-cards{gap:1em}.modal-card{padding:1.4em}.dev-grid{gap:1.4em}.title-foot .mono{max-width:25em}.heading-tape{display:none}.title-body h1{font-size:clamp(60px,9.2vw,140px)}}@media(max-width:600px){.title-body{width:100%\"'!important}.title-buttons{width:22em}.title-body h1{font-size:17vw!important}.title-side,.coordinate,.edition{display:none}.intro-copy{font-size:.75rem}.title-foot .mono{display:none}.chart-grid{gap:.6em}.sector-card{padding:.75em;min-height:7.5em}.sector-card strong{font-size:.87rem}.sector-card .sector-symbol{display:none}.sector-card.selected{padding:calc(.75em - 1px)}.control-grid,.options-grid,.dev-grid,.net-columns{grid-template-columns:1fr}.instruction-cards{grid-template-columns:1fr;gap:0}.instruction-card{padding:.7em 0}.debrief-stats{grid-template-columns:1fr 1fr}.credits-grid{grid-template-columns:6.5em 1fr}.modal-head h2{font-size:2.2rem}.gauges{gap:.7em}.gauge{width:3.6em}.target-readout{display:none}.radar{width:6em;height:6em}.actions{font-size:.5rem;gap:.7em;flex-wrap:wrap}.objective{font-size:.7rem;max-width:20em}.comms{bottom:31vh}.hud-top{top:3vh}.score-block strong{font-size:1.5rem}.gauge strong{font-size:1.25rem}.modal-footer{flex-wrap:wrap}.title-kicker{font-size:.67rem}.touch .gauges{left:auto;right:4vw;transform:none}.touch-menu{top:auto;bottom:6.5em;right:1.3em}.touch .objective{top:13vh}.touch .title-body{margin-top:0}.touch .title-buttons{max-width:98%}}@media(prefers-reduced-motion:reduce){button{transition:none}#grain{opacity:.035}}\n</style>\n</head>\n<body>\n<canvas id=\"world\" aria-label=\"Star Reclaimers 3D space flight\"></canvas><div id=\"ink-wash\"></div><div id=\"grain\"></div>\n<div id=\"loading\"><div class=\"eyebrow\">KESTREL DEFENCE / FLIGHT SYSTEMS</div><strong>STAR RECLAIMERS</strong><div id=\"loading-bar\"><i></i></div><p id=\"load-status\">Starting the reactor. Preparing WebGPU and the flight computer…</p></div>\n<div id=\"title-screen\" class=\"hide\">\n<div class=\"topline\"><div class=\"brand-mark\"><svg viewBox=\"0 0 40 40\" fill=\"none\" aria-hidden=\"true\"><path d=\"M20 2 37 31H3Z\" stroke=\"#f5f0d7\" stroke-width=\"2\"/><path d=\"m20 9 6 17-6-4-6 4Z\" fill=\"#ffdf78\"/><path d=\"M1 36h38\" stroke=\"#8bdaca\" stroke-width=\"2\"/></svg>KESTREL / DEEP SPACE DIVISION</div><div class=\"edition\">FIELD MANUAL 082 &nbsp; / &nbsp; NOVEMBER 1982</div></div>\n<div class=\"title-body\"><span class=\"pill\"><i></i> SINGLE OPERATION · SIX SECTORS</span><h1>STAR<span>RECLAIMERS</span></h1><div class=\"title-kicker\">THE VOID DOESN’T PATROL ITSELF.</div><p class=\"intro-copy\">One ship. A very large sky. Keep the starbase standing, break the blockade, and bring yourself home.</p><div class=\"title-buttons\"><button class=\"menu-primary\" data-cmd=\"launch\"><span><span data-glyph=\"accept\"></span>Launch patrol</span><span class=\"right-arrow\">↗</span></button><button class=\"menu-secondary\" data-cmd=\"help\"><span>Flight briefing</span><span class=\"sub\">LEARN THE SHIP</span></button><button class=\"menu-secondary\" data-cmd=\"network\"><span>Wingmate link</span><span class=\"sub\">TWO-PILOT RACE</span></button></div></div>\n<div class=\"coordinate mono\">SECTOR 01 / KESTREL<br>RAIDER CONTACTS: 03<br><span style=\"color:var(--yellow)\">YOUR WATCH STARTS HERE.</span></div><div class=\"title-side\"><div class=\"eyebrow\">PATROL ORDER / 01</div><div class=\"side-number\">HOLD THE LINE.</div><p>Enemy transmissions detected beyond the Ember Belt. Your starbase has requested a volunteer.</p><div class=\"tiny mono\">THEY HAVE ALREADY VOLUNTEERED YOU.</div></div>\n<div class=\"title-foot\"><div class=\"link-group\"><button class=\"text-button\" data-cmd=\"settings\">Settings</button><span>/</span><button class=\"text-button\" data-cmd=\"about\">About & credits</button></div><span class=\"mono\" id=\"title-input\">MOUSE + KEYBOARD / CONTROLLER READY</span><span class=\"mono\" id=\"best-score\">PERSONAL BEST —</span></div>\n</div>\n<div id=\"hud\" class=\"hide\"><canvas id=\"hud-canvas\"></canvas><div class=\"screen-frame\"></div><div class=\"hud-top\"><div class=\"sector-block\"><div class=\"hud-label\">KESTREL DEFENCE / PATROL 082</div><h2 id=\"sector-name\">01 / KESTREL</h2><small id=\"sector-type\">STARBASE PERIMETER</small></div><div class=\"heading-tape mono\" id=\"heading-tape\">PORT &nbsp; · &nbsp; 000 &nbsp; · &nbsp; STARBOARD</div><div class=\"score-block\"><small>PATROL SCORE</small><strong id=\"hud-score\">00000</strong><small id=\"contacts\">3 HOSTILE CONTACTS</small></div></div><div class=\"objective\"><small id=\"objective-label\">PATROL ORDER</small><b id=\"objective-text\"></b></div><div class=\"comms hide\" id=\"comms\"><div class=\"eyebrow\">▰ ▱ ▰ &nbsp; OPS / MICA</div><p id=\"comms-text\"></p></div><div id=\"reticle\"><i></i></div><div class=\"cockpit-data\"><div class=\"radar-wrap\"><div><div class=\"radar\" id=\"radar\"><div class=\"radar-ring\"></div><div id=\"blips\"></div></div><div class=\"radar-label\">LONG-RANGE SCAN / 1200</div></div><div class=\"speed-display\"><strong id=\"speed\">00</strong><span>METRES / SEC</span><span id=\"throttle\">THRUST 25%</span></div></div><div class=\"gauges\"><div class=\"gauge hull\"><div class=\"stat-label\">HULL <span>HP</span></div><strong id=\"hull-value\">100</strong><div class=\"meter\"><i id=\"hull-meter\"></i></div></div><div class=\"gauge\"><div class=\"stat-label\">SHIELD <span id=\"shield-state\">ON</span></div><strong id=\"shield-value\">100</strong><div class=\"meter\"><i id=\"shield-meter\"></i></div></div><div class=\"gauge energy\"><div class=\"stat-label\">ENERGY <span>EU</span></div><strong id=\"energy-value\">100</strong><div class=\"meter\"><i id=\"energy-meter\"></i></div></div></div><div class=\"target-readout\"><small id=\"target-category\">TARGET COMPUTER</small><strong id=\"target-name\">SEARCHING…</strong><div class=\"target-detail\"><span id=\"target-range\">NO LOCK</span><span id=\"target-hp\">T TO CYCLE</span></div><div class=\"meter\"><i id=\"target-meter\"></i></div></div></div><button id=\"context-action\" class=\"context-action hide\" data-cmd=\"interact\"></button><div class=\"actions\" id=\"action-prompts\"></div><div id=\"wingmate-hud\" class=\"wingmate hide\"></div></div>\n<div class=\"damage-flash\" id=\"damage-flash\"></div><div class=\"jump-overlay\" id=\"jump-overlay\"></div><div class=\"jump-text hide\" id=\"jump-text\"><small>HYPERSPACE DRIVE / VECTOR ACQUIRED</small><strong id=\"jump-name\">EMBER BELT</strong><small id=\"jump-count\">SPOOLING</small></div><div class=\"attract-banner hide\" id=\"attract-banner\"><strong>AUTOPILOT EXHIBITION</strong><small>ANY INPUT TO TAKE THE WATCH</small></div><button class=\"touch-menu hide\" id=\"touch-menu\" data-cmd=\"pause\" aria-label=\"Pause\">Ⅱ</button><button class=\"touch-action hide\" id=\"touch-chart\" data-cmd=\"chart\">Sector chart</button><button class=\"touch-action hide\" id=\"touch-nova\" data-cmd=\"nova\">Nova × 3</button><div class=\"touch-hint hide\" id=\"touch-hint\"><span>THRUST / STRAFE</span><span>STEER / AUTO FIRE</span></div>\n<div id=\"modal\" class=\"hide\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Game menu\"></div><div id=\"notice\" class=\"notice hide\" role=\"status\"></div>\n<script>{{GAME_BUNDLE}}</script>\n</body></html>\nEOF\ncat > build.mjs <<'\"'EOF'\nimport {build} from 'esbuild';\nimport fs from 'node:fs/promises';\nimport path from 'node:path';\nconst root=path.basename(process.cwd());\nconst output=await build({entryPoints:['main.js'],bundle:true,write:false,format:'iife',target:'es2022',minify:true,legalComments:'inline',logLevel:'silent'});\nconst template=await fs.readFile('shell.html','utf8');\nconst hub=await fs.readFile('hub-session.js','utf8');\nconst js=output.outputFiles[0].text.replaceAll('</script','<\\\\\\\\/script');\nconst html=template.replace('{{HUB_CLIENT}}',()=>hub).replace('{{GAME_BUNDLE}}',()=>js);\nawait fs.writeFile('../'+root+'.html',html);\nawait fs.copyFile('hub-bridge.js','bridge.js');\nawait fs.copyFile('hub-round.js','round.js');\nconsole.log('Built '+root+'.html ('+(html.length/1048576).toFixed(2)+' MiB)');\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"agent_message","text":"The game structure is in place. The main progression is to defend Kestrel, break two patrol groups, destroy the Crown’s shield relays and core, then return to dock. I’m building the flight and combat systems next, alongside the cockpit, controller menus, and synthesized audio.\n"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > audio.js <<'EOF'\nconst NOTES=[110,164.8138,220,261.6256,146.8324,220,293.6648,329.6276];\nfunction envelope(ctx,gain,t,amp,duration){gain.gain.setValueAtTime(.0001,t);gain.gain.exponentialRampToValueAtTime(Math.max(.0002,amp),t+.012);gain.gain.exponentialRampToValueAtTime(.0001,t+duration)}\nfunction note(ctx,out,freq,t,duration=.3,amp=.1,type='triangle',end=freq){const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.setValueAtTime(freq,t);o.frequency.exponentialRampToValueAtTime(Math.max(10,end),t+duration);envelope(ctx,g,t,amp,duration);o.connect(g).connect(out);o.start(t);o.stop(t+duration+.02)}\nfunction noise(ctx,out,t,duration=.3,amp=.1,freq=800){const b=ctx.createBuffer(1,Math.ceil(ctx.sampleRate*duration),ctx.sampleRate),a=b.getChannelData(0);let r=127;for(let i=0;i<a.length;i++){r=(r*16807)%2147483647;a[i]=(r/2147483647*2-1)*(1-i/a.length)}const s=ctx.createBufferSource(),f=ctx.createBiquadFilter(),g=ctx.createGain();s.buffer=b;f.type='lowpass';f.frequency.setValueAtTime(freq,t);f.frequency.exponentialRampToValueAtTime(90,t+duration);envelope(ctx,g,t,amp,duration);s.connect(f).connect(g).connect(out);s.start(t);s.stop(t+duration+.02)}\nfunction voice(ctx,out,t,phrase=0){const vowels=[650,1100,430,890,1450,550];for(let i=0;i<7;i++){const at=t+i*.086;const o=ctx.createOscillator(),f=ctx.createBiquadFilter(),g=ctx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(135+((i*37+phrase*11)%75),at);o.frequency.linearRampToValueAtTime(155+((i*19)%55),at+.06);f.type='bandpass';f.frequency.value=vowels[(i+phrase)%vowels.length];f.Q.value=5;envelope(ctx,g,at,.11,.075);o.connect(f).connect(g).connect(out);o.start(at);o.stop(at+.08)}}\nexport class AudioSystem{\n constructor(settings){this.settings=settings;this.ctx=null;this.next=0;this.beat=0;this.counts={shot:0,hit:0,voice:0,music:0};this.stopped=false}\n init(){if(\"'!this.ctx){const C=window.AudioContext||window.webkitAudioContext;if(!C)return;this.ctx=new C();this.master=this.ctx.createGain();this.master.gain.value=this.settings.master;const limiter=this.ctx.createDynamicsCompressor();limiter.threshold.value=-10;limiter.ratio.value=8;this.master.connect(limiter).connect(this.ctx.destination);this.music=this.ctx.createGain();this.sfx=this.ctx.createGain();this.music.connect(this.master);this.sfx.connect(this.master);this.music.gain.value=this.settings.music;this.sfx.gain.value=this.settings.sfx;this.analyser=this.ctx.createAnalyser();this.master.connect(this.analyser);this.next=this.ctx.currentTime+.05}this.stopped=false;this.ctx.resume().catch(()=>{})}\n apply(){if(!this.ctx)return;const t=this.ctx.currentTime;this.master.gain.setTargetAtTime(this.stopped?0:this.settings.master,t,.03);this.music.gain.setTargetAtTime(this.settings.music,t,.03);this.sfx.gain.setTargetAtTime(this.settings.sfx,t,.03)}\n update(active=true){if(!this.ctx||this.stopped||this.ctx.state!=='\"'running')return;const c=this.ctx;let n=0;while(this.next<c.currentTime+.22&&n++<5){const t=Math.max(this.next,c.currentTime),step=this.beat%32,root=NOTES[Math.floor(step/8)*2];note(c,this.music,root/2,t,.9,.13,'sine');note(c,this.music,NOTES[(step%8)]*(step%4===3?2:1),t,.44,.12,'triangle');if(step%4===0)noise(c,this.music,t,.035,.045,2500);if(active&&step%8===4)note(c,this.music,root*2,t,1.15,.06,'sine');this.beat++;this.next=t+.26;this.counts.music++}}\n fx(type){if(\"'!this.ctx||this.stopped)return;const c=this.ctx,t=c.currentTime,o=this.sfx;switch(type){case'\"'shot':note(c,o,920,t,.105,.08,'sawtooth',160);note(c,o,1320,t,.07,.04,'triangle',360);this.counts.shot++;break;case'enemy':note(c,o,210,t,.18,.07,'square',85);break;case'hit':noise(c,o,t,.15,.2,1800);note(c,o,120,t,.12,.18,'triangle',38);this.counts.hit++;break;case'explode':noise(c,o,t,.65,.4,1500);note(c,o,72,t,.6,.3,'sine',18);break;case'jump':note(c,o,65,t,1.8,.16,'sawtooth',1600);note(c,o,68,t,1.7,.1,'triangle',2100);break;case'nova':noise(c,o,t,1.2,.4,3200);note(c,o,450,t,.8,.3,'sine',20);break;case'dock':for(let i=0;i<4;i++)note(c,o,[261.6,329.6,392,523.2][i],t+i*.14,.5,.12,'triangle');break;case'ui':note(c,o,660,t,.055,.045,'sine',880);break;case'warn':note(c,o,220,t,.2,.09,'square',180);break;case'victory':for(let i=0;i<8;i++)note(c,o,[261,329,392,523,392,523,659,784][i],t+i*.18,.6,.13,'triangle');break}}\n say(index=0){if(this.ctx&&\"'!this.stopped){voice(this.ctx,this.sfx,this.ctx.currentTime,index);this.counts.voice++}}\n stop(){this.stopped=true;if(this.ctx){this.master.gain.setTargetAtTime(0,this.ctx.currentTime,.02);this.ctx.suspend().catch(()=>{})}}\n async proof(){const C=window.OfflineAudioContext||window.webkitOfflineAudioContext;if(!C)return {available:false};const c=new C(1,48000,48000),g=c.createGain();g.gain.value=.4;g.connect(c.destination);note(c,g,220,0,.6,.12);note(c,g,920,.1,.1,.08,'\"'sawtooth',160);noise(c,g,.25,.25,.2);voice(c,g,.25,2);const b=await c.startRendering(),a=b.getChannelData(0);let peak=0,sum=0,nonzero=0;for(const x of a){peak=Math.max(peak,Math.abs(x));sum+=x*x;if(Math.abs(x)>.0001)nonzero++}return {available:true,peak,rms:Math.sqrt(sum/a.length),nonzero,samples:a.length,musicDefault:.1}}\n}\nEOF\ncat > network.js <<'EOF'\nexport class WingLink{\n constructor(game){this.game=game;this.channel=null;this.pc=null;this.dc=null;this.remote=null;this.id=crypto.randomUUID();this.connected=false;this.status='Fly together, compare patrol scores. Every pilot commands their own ship and operation.';this.last=0;this.mode='none'}\n changed(text){this.status=text;this.game.ui?.refreshNetwork()}\n receive(data){if(\"'!data||typeof data!=='\"'object'||data.id===this.id)return;if(data.kind==='hello'){this.connected=true;this.remote=data.id;this.changed('Wingmate linked. Launch the patrol on either screen.');this.send({kind:'ack'});return}if(data.kind==='ack'){this.connected=true;this.remote=data.id;this.changed('Wingmate linked. Launch the patrol on either screen.');return}if(data.kind==='start'){this.game.start(false,true);return}if(data.kind==='bye'){this.connected=false;this.game.ghosts.clear();this.changed('Wingmate disconnected. Your patrol can continue.');return}if(data.kind==='ghost'&&this.valid(data.state))this.game.receiveGhost(data.state,'standalone','WINGMATE','#8bdaca')}\n valid(s){return s&&Number.isInteger(s.sector)&&s.sector>=0&&s.sector<6&&Array.isArray(s.p)&&s.p.length===3&&s.p.every(Number.isFinite)&&Array.isArray(s.q)&&s.q.length===4&&s.q.every(Number.isFinite)&&Number.isFinite(s.score)}\n send(data){const packet={...data,id:this.id};if(this.mode==='local')this.channel?.postMessage(packet);else if(this.dc?.readyState==='open')this.dc.send(JSON.stringify(packet))}\n local(){this.close();this.mode='local';this.channel=new BroadcastChannel('star-reclaimers-wingmate-v1');this.channel.onmessage=e=>this.receive(e.data);this.send({kind:'hello'});this.changed('Local link open. Open this game in a second tab and select Local link there, too.')}\n setup(){this.close();this.mode='rtc';this.pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});this.pc.ondatachannel=e=>this.wire(e.channel);this.pc.onconnectionstatechange=()=>{if(['disconnected','failed','closed'].includes(this.pc?.connectionState)){this.connected=false;this.changed('Link interrupted. The patrol can continue solo.')}};return this.pc}\n wire(dc){this.dc=dc;dc.onopen=()=>{this.connected=true;this.changed('Wingmate linked. Launch the patrol on either screen.');this.send({kind:'hello'})};dc.onmessage=e=>{try{this.receive(JSON.parse(e.data))}catch{}};dc.onclose=()=>{this.connected=false}}\n async gathered(){const pc=this.pc;if(pc.iceGatheringState==='complete')return;await new Promise(resolve=>{const timer=setTimeout(done,5500);function done(){clearTimeout(timer);pc.removeEventListener('icegatheringstatechange',changed);resolve()}function changed(){if(pc.iceGatheringState==='complete')done()}pc.addEventListener('icegatheringstatechange',changed)})}\n encode(){return 'SR1-'+btoa(JSON.stringify(this.pc.localDescription)).replaceAll('+','-').replaceAll('/','_').replaceAll('=','')}\n decode(code){const c=code.trim();if(\"'!c.startsWith('\"'SR1-')||c.length>50000)throw Error('That is not a Star Reclaimers link code.');try{const d=JSON.parse(atob(c.slice(4).replaceAll('-','+').replaceAll('_','/')));if(\"'!['\"'offer','answer'].includes(d.type)||typeof d.sdp\"'!=='\"'string')throw Error();return d}catch{throw Error('The link code is incomplete. Copy the whole code.')}}\n async offer(){this.changed('Gathering a direct route…');const pc=this.setup();this.wire(pc.createDataChannel('patrol',{ordered:false,maxRetransmits:0}));await pc.setLocalDescription(await pc.createOffer());await this.gathered();this.changed('Send this offer code to your wingmate. Paste their reply, then connect.');return this.encode()}\n async answer(code){const desc=this.decode(code);if(desc.type\"'!=='\"'offer')throw Error('The join screen needs an offer code.');const pc=this.setup();await pc.setRemoteDescription(desc);await pc.setLocalDescription(await pc.createAnswer());await this.gathered();this.changed('Send this reply code to the first pilot. Waiting for them to connect…');return this.encode()}\n async finish(code){const desc=this.decode(code);if(desc.type\"'!=='\"'answer'||\"'!this.pc)throw Error('\"'Create an offer first, then paste the reply code.');await this.pc.setRemoteDescription(desc);this.changed('Connecting to your wingmate…')}\n launch(){if(this.connected)this.send({kind:'start'});this.game.start(false,true)}\n update(dt){if(\"'!this.connected||this.game.hubActive)return;this.last+=dt;if(this.last>.12){this.last=0;this.send({kind:'\"'ghost',state:this.game.ghostState()})}}\n close(){this.send({kind:'bye'});this.channel?.close();this.dc?.close();this.pc?.close();this.channel=null;this.dc=null;this.pc=null;this.connected=false;this.mode='none';this.game.ghosts?.clear()}\n}\nEOF\ncat > metadata.json <<'EOF'\n{\n  \\\"sourceInformation\\\": {\n    \\\"date\\\": \\\"2026-11-05 20:31:44\\\",\n    \\\"source\\\": \\\"Star Raiders (1982)\\\",\n    \\\"plan\\\": \\\"none\\\",\n    \\\"genre\\\": \\\"Space combat simulation; tactical arcade shooter\\\",\n    \\\"perspective\\\": \\\"First-person cockpit, with optional third-person chase camera\\\",\n    \\\"tech\\\": \\\"Three.js r180 (0.180.0), WebGPURenderer with native WebGL2 fallback; Rapier 0.19.3; Web Audio; Gamepad API; WebRTC; AI Hub Session Protocol v1 client 1.4.0; bundled single HTML\\\",\n    \\\"artDirection\\\": \\\"Procedural cel-shaded spacecraft and planets, ink outlines, print grain, ivory and amber flight instruments\\\",\n    \\\"animation\\\": \\\"Three.js AnimationMixer / AnimationClip keyframe tracks for station rings, enemy reactors, engine pulses, weapon recoil and explosions; procedural flight motion\\\",\n    \\\"audio\\\": \\\"Code-generated synthesizer music at 10% default music volume; synthesized effects; formant-filtered Animalese-style gibberish radio voices; no audio files\\\",\n    \\\"online\\\": \\\"AI Hub ghost patrol races for 1–4 pilots; standalone two-pilot WebRTC link-code race; BroadcastChannel same-browser link\\\",\n    \\\"testing\\\": \\\"Headless Chromium WebGPU and WebGL2; scripted operation playthrough; simulated standard gamepad; touch profiles; offline synthesized audio analysis; two-page multiplayer; official AI Hub harness\\\",\n    \\\"research\\\": \\\"none; no internet research. Downloaded only dependencies and the user-supplied AI Hub integration contract and harness\\\",\n    \\\"environment\\\": \\\"Codex CLI (headless); Linux\\\",\n    \\\"model\\\": \\\"OpenAI, gpt-6.1-sol, reasoning effort max\\\",\n    \\\"usage\\\": \\\"added on import\\\"\n  },\n  \\\"testingFeedback\\\": [\\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\"],\n  \\\"engineFeedback\\\": [\\\"Native scene graphs, toon materials and AnimationMixer support a consistent procedural art style.\\\", \\\"unknown\\\", \\\"The cockpit flight model, tactical campaign, combat systems, user interface and multiplayer race logic.\\\", \\\"Coordinating asynchronous WebGPU startup with the simulation and headless verification.\\\", \\\"none\\\", \\\"Provide a simpler first-frame readiness signal for headless WebGPU tests.\\\"],\n  \\\"promptFeedback\\\": [\\\"The source, controller-first constraints and complete vertical-slice requirement gave the game a clear identity.\\\", \\\"Standalone multiplayer transport was unspecified; I chose peer-to-peer link codes and an optional local tab link.\\\", \\\"Making tactical navigation, free flight, combat, docking and multiplayer feel coherent in one self-contained file.\\\", \\\"Specify whether standalone multiplayer needs automatic room discovery or whether manual peer-to-peer pairing is acceptable.\\\"],\n  \\\"aiHub\\\": {\n    \\\"name\\\": \\\"Star Reclaimers\\\",\n    \\\"tagline\\\": \\\"The void doesn’t patrol itself.\\\",\n    \\\"description\\\": \\\"Defend Kestrel in an ink-stroked space patrol. Manage energy, jump six sectors, dock for repairs, and tear down the Crown command ship; compare scores with wingmates in a ghost patrol race.\\\",\n    \\\"type\\\": \\\"Game\\\",\n    \\\"genre\\\": \\\"Flight\\\",\n    \\\"source\\\": \\\"Star Raiders (1982)\\\",\n    \\\"series\\\": \\\"\\\",\n    \\\"players\\\": \\\"1–4\\\",\n    \\\"controls\\\": \\\"Mouse aim, WASD fly, click/Space fire, Shift boost, C shield, X nova, T target, F dock, M chart, J jump, V camera, Esc pause; standard gamepad; assisted touch.\\\",\n    \\\"tags\\\": [\\\"3d\\\", \\\"sci-fi\\\", \\\"first-person\\\", \\\"arcade\\\", \\\"vehicles\\\", \\\"boss fights\\\"]\n  }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > audio.js <<'EOF'\nconst NOTES=[110,164.8138,220,261.6256,146.8324,220,293.6648,329.6276];\nfunction envelope(ctx,gain,t,amp,duration){gain.gain.setValueAtTime(.0001,t);gain.gain.exponentialRampToValueAtTime(Math.max(.0002,amp),t+.012);gain.gain.exponentialRampToValueAtTime(.0001,t+duration)}\nfunction note(ctx,out,freq,t,duration=.3,amp=.1,type='triangle',end=freq){const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.setValueAtTime(freq,t);o.frequency.exponentialRampToValueAtTime(Math.max(10,end),t+duration);envelope(ctx,g,t,amp,duration);o.connect(g).connect(out);o.start(t);o.stop(t+duration+.02)}\nfunction noise(ctx,out,t,duration=.3,amp=.1,freq=800){const b=ctx.createBuffer(1,Math.ceil(ctx.sampleRate*duration),ctx.sampleRate),a=b.getChannelData(0);let r=127;for(let i=0;i<a.length;i++){r=(r*16807)%2147483647;a[i]=(r/2147483647*2-1)*(1-i/a.length)}const s=ctx.createBufferSource(),f=ctx.createBiquadFilter(),g=ctx.createGain();s.buffer=b;f.type='lowpass';f.frequency.setValueAtTime(freq,t);f.frequency.exponentialRampToValueAtTime(90,t+duration);envelope(ctx,g,t,amp,duration);s.connect(f).connect(g).connect(out);s.start(t);s.stop(t+duration+.02)}\nfunction voice(ctx,out,t,phrase=0){const vowels=[650,1100,430,890,1450,550];for(let i=0;i<7;i++){const at=t+i*.086;const o=ctx.createOscillator(),f=ctx.createBiquadFilter(),g=ctx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(135+((i*37+phrase*11)%75),at);o.frequency.linearRampToValueAtTime(155+((i*19)%55),at+.06);f.type='bandpass';f.frequency.value=vowels[(i+phrase)%vowels.length];f.Q.value=5;envelope(ctx,g,at,.11,.075);o.connect(f).connect(g).connect(out);o.start(at);o.stop(at+.08)}}\nexport class AudioSystem{\n constructor(settings){this.settings=settings;this.ctx=null;this.next=0;this.beat=0;this.counts={shot:0,hit:0,voice:0,music:0};this.stopped=false}\n init(){if(\"'!this.ctx){const C=window.AudioContext||window.webkitAudioContext;if(!C)return;this.ctx=new C();this.master=this.ctx.createGain();this.master.gain.value=this.settings.master;const limiter=this.ctx.createDynamicsCompressor();limiter.threshold.value=-10;limiter.ratio.value=8;this.master.connect(limiter).connect(this.ctx.destination);this.music=this.ctx.createGain();this.sfx=this.ctx.createGain();this.music.connect(this.master);this.sfx.connect(this.master);this.music.gain.value=this.settings.music;this.sfx.gain.value=this.settings.sfx;this.analyser=this.ctx.createAnalyser();this.master.connect(this.analyser);this.next=this.ctx.currentTime+.05}this.stopped=false;this.ctx.resume().catch(()=>{})}\n apply(){if(!this.ctx)return;const t=this.ctx.currentTime;this.master.gain.setTargetAtTime(this.stopped?0:this.settings.master,t,.03);this.music.gain.setTargetAtTime(this.settings.music,t,.03);this.sfx.gain.setTargetAtTime(this.settings.sfx,t,.03)}\n update(active=true){if(!this.ctx||this.stopped||this.ctx.state!=='\"'running')return;const c=this.ctx;let n=0;while(this.next<c.currentTime+.22&&n++<5){const t=Math.max(this.next,c.currentTime),step=this.beat%32,root=NOTES[Math.floor(step/8)*2];note(c,this.music,root/2,t,.9,.13,'sine');note(c,this.music,NOTES[(step%8)]*(step%4===3?2:1),t,.44,.12,'triangle');if(step%4===0)noise(c,this.music,t,.035,.045,2500);if(active&&step%8===4)note(c,this.music,root*2,t,1.15,.06,'sine');this.beat++;this.next=t+.26;this.counts.music++}}\n fx(type){if(\"'!this.ctx||this.stopped)return;const c=this.ctx,t=c.currentTime,o=this.sfx;switch(type){case'\"'shot':note(c,o,920,t,.105,.08,'sawtooth',160);note(c,o,1320,t,.07,.04,'triangle',360);this.counts.shot++;break;case'enemy':note(c,o,210,t,.18,.07,'square',85);break;case'hit':noise(c,o,t,.15,.2,1800);note(c,o,120,t,.12,.18,'triangle',38);this.counts.hit++;break;case'explode':noise(c,o,t,.65,.4,1500);note(c,o,72,t,.6,.3,'sine',18);break;case'jump':note(c,o,65,t,1.8,.16,'sawtooth',1600);note(c,o,68,t,1.7,.1,'triangle',2100);break;case'nova':noise(c,o,t,1.2,.4,3200);note(c,o,450,t,.8,.3,'sine',20);break;case'dock':for(let i=0;i<4;i++)note(c,o,[261.6,329.6,392,523.2][i],t+i*.14,.5,.12,'triangle');break;case'ui':note(c,o,660,t,.055,.045,'sine',880);break;case'warn':note(c,o,220,t,.2,.09,'square',180);break;case'victory':for(let i=0;i<8;i++)note(c,o,[261,329,392,523,392,523,659,784][i],t+i*.18,.6,.13,'triangle');break}}\n say(index=0){if(this.ctx&&\"'!this.stopped){voice(this.ctx,this.sfx,this.ctx.currentTime,index);this.counts.voice++}}\n stop(){this.stopped=true;if(this.ctx){this.master.gain.setTargetAtTime(0,this.ctx.currentTime,.02);this.ctx.suspend().catch(()=>{})}}\n async proof(){const C=window.OfflineAudioContext||window.webkitOfflineAudioContext;if(!C)return {available:false};const c=new C(1,48000,48000),g=c.createGain();g.gain.value=.4;g.connect(c.destination);note(c,g,220,0,.6,.12);note(c,g,920,.1,.1,.08,'\"'sawtooth',160);noise(c,g,.25,.25,.2);voice(c,g,.25,2);const b=await c.startRendering(),a=b.getChannelData(0);let peak=0,sum=0,nonzero=0;for(const x of a){peak=Math.max(peak,Math.abs(x));sum+=x*x;if(Math.abs(x)>.0001)nonzero++}return {available:true,peak,rms:Math.sqrt(sum/a.length),nonzero,samples:a.length,musicDefault:.1}}\n}\nEOF\ncat > network.js <<'EOF'\nexport class WingLink{\n constructor(game){this.game=game;this.channel=null;this.pc=null;this.dc=null;this.remote=null;this.id=crypto.randomUUID();this.connected=false;this.status='Fly together, compare patrol scores. Every pilot commands their own ship and operation.';this.last=0;this.mode='none'}\n changed(text){this.status=text;this.game.ui?.refreshNetwork()}\n receive(data){if(\"'!data||typeof data!=='\"'object'||data.id===this.id)return;if(data.kind==='hello'){this.connected=true;this.remote=data.id;this.changed('Wingmate linked. Launch the patrol on either screen.');this.send({kind:'ack'});return}if(data.kind==='ack'){this.connected=true;this.remote=data.id;this.changed('Wingmate linked. Launch the patrol on either screen.');return}if(data.kind==='start'){this.game.start(false,true);return}if(data.kind==='bye'){this.connected=false;this.game.ghosts.clear();this.changed('Wingmate disconnected. Your patrol can continue.');return}if(data.kind==='ghost'&&this.valid(data.state))this.game.receiveGhost(data.state,'standalone','WINGMATE','#8bdaca')}\n valid(s){return s&&Number.isInteger(s.sector)&&s.sector>=0&&s.sector<6&&Array.isArray(s.p)&&s.p.length===3&&s.p.every(Number.isFinite)&&Array.isArray(s.q)&&s.q.length===4&&s.q.every(Number.isFinite)&&Number.isFinite(s.score)}\n send(data){const packet={...data,id:this.id};if(this.mode==='local')this.channel?.postMessage(packet);else if(this.dc?.readyState==='open')this.dc.send(JSON.stringify(packet))}\n local(){this.close();this.mode='local';this.channel=new BroadcastChannel('star-reclaimers-wingmate-v1');this.channel.onmessage=e=>this.receive(e.data);this.send({kind:'hello'});this.changed('Local link open. Open this game in a second tab and select Local link there, too.')}\n setup(){this.close();this.mode='rtc';this.pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});this.pc.ondatachannel=e=>this.wire(e.channel);this.pc.onconnectionstatechange=()=>{if(['disconnected','failed','closed'].includes(this.pc?.connectionState)){this.connected=false;this.changed('Link interrupted. The patrol can continue solo.')}};return this.pc}\n wire(dc){this.dc=dc;dc.onopen=()=>{this.connected=true;this.changed('Wingmate linked. Launch the patrol on either screen.');this.send({kind:'hello'})};dc.onmessage=e=>{try{this.receive(JSON.parse(e.data))}catch{}};dc.onclose=()=>{this.connected=false}}\n async gathered(){const pc=this.pc;if(pc.iceGatheringState==='complete')return;await new Promise(resolve=>{const timer=setTimeout(done,5500);function done(){clearTimeout(timer);pc.removeEventListener('icegatheringstatechange',changed);resolve()}function changed(){if(pc.iceGatheringState==='complete')done()}pc.addEventListener('icegatheringstatechange',changed)})}\n encode(){return 'SR1-'+btoa(JSON.stringify(this.pc.localDescription)).replaceAll('+','-').replaceAll('/','_').replaceAll('=','')}\n decode(code){const c=code.trim();if(\"'!c.startsWith('\"'SR1-')||c.length>50000)throw Error('That is not a Star Reclaimers link code.');try{const d=JSON.parse(atob(c.slice(4).replaceAll('-','+').replaceAll('_','/')));if(\"'!['\"'offer','answer'].includes(d.type)||typeof d.sdp\"'!=='\"'string')throw Error();return d}catch{throw Error('The link code is incomplete. Copy the whole code.')}}\n async offer(){this.changed('Gathering a direct route…');const pc=this.setup();this.wire(pc.createDataChannel('patrol',{ordered:false,maxRetransmits:0}));await pc.setLocalDescription(await pc.createOffer());await this.gathered();this.changed('Send this offer code to your wingmate. Paste their reply, then connect.');return this.encode()}\n async answer(code){const desc=this.decode(code);if(desc.type\"'!=='\"'offer')throw Error('The join screen needs an offer code.');const pc=this.setup();await pc.setRemoteDescription(desc);await pc.setLocalDescription(await pc.createAnswer());await this.gathered();this.changed('Send this reply code to the first pilot. Waiting for them to connect…');return this.encode()}\n async finish(code){const desc=this.decode(code);if(desc.type\"'!=='\"'answer'||\"'!this.pc)throw Error('\"'Create an offer first, then paste the reply code.');await this.pc.setRemoteDescription(desc);this.changed('Connecting to your wingmate…')}\n launch(){if(this.connected)this.send({kind:'start'});this.game.start(false,true)}\n update(dt){if(\"'!this.connected||this.game.hubActive)return;this.last+=dt;if(this.last>.12){this.last=0;this.send({kind:'\"'ghost',state:this.game.ghostState()})}}\n close(){this.send({kind:'bye'});this.channel?.close();this.dc?.close();this.pc?.close();this.channel=null;this.dc=null;this.pc=null;this.connected=false;this.mode='none';this.game.ghosts?.clear()}\n}\nEOF\ncat > metadata.json <<'EOF'\n{\n  \\\"sourceInformation\\\": {\n    \\\"date\\\": \\\"2026-11-05 20:31:44\\\",\n    \\\"source\\\": \\\"Star Raiders (1982)\\\",\n    \\\"plan\\\": \\\"none\\\",\n    \\\"genre\\\": \\\"Space combat simulation; tactical arcade shooter\\\",\n    \\\"perspective\\\": \\\"First-person cockpit, with optional third-person chase camera\\\",\n    \\\"tech\\\": \\\"Three.js r180 (0.180.0), WebGPURenderer with native WebGL2 fallback; Rapier 0.19.3; Web Audio; Gamepad API; WebRTC; AI Hub Session Protocol v1 client 1.4.0; bundled single HTML\\\",\n    \\\"artDirection\\\": \\\"Procedural cel-shaded spacecraft and planets, ink outlines, print grain, ivory and amber flight instruments\\\",\n    \\\"animation\\\": \\\"Three.js AnimationMixer / AnimationClip keyframe tracks for station rings, enemy reactors, engine pulses, weapon recoil and explosions; procedural flight motion\\\",\n    \\\"audio\\\": \\\"Code-generated synthesizer music at 10% default music volume; synthesized effects; formant-filtered Animalese-style gibberish radio voices; no audio files\\\",\n    \\\"online\\\": \\\"AI Hub ghost patrol races for 1–4 pilots; standalone two-pilot WebRTC link-code race; BroadcastChannel same-browser link\\\",\n    \\\"testing\\\": \\\"Headless Chromium WebGPU and WebGL2; scripted operation playthrough; simulated standard gamepad; touch profiles; offline synthesized audio analysis; two-page multiplayer; official AI Hub harness\\\",\n    \\\"research\\\": \\\"none; no internet research. Downloaded only dependencies and the user-supplied AI Hub integration contract and harness\\\",\n    \\\"environment\\\": \\\"Codex CLI (headless); Linux\\\",\n    \\\"model\\\": \\\"OpenAI, gpt-6.1-sol, reasoning effort max\\\",\n    \\\"usage\\\": \\\"added on import\\\"\n  },\n  \\\"testingFeedback\\\": [\\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\", \\\"unknown\\\"],\n  \\\"engineFeedback\\\": [\\\"Native scene graphs, toon materials and AnimationMixer support a consistent procedural art style.\\\", \\\"unknown\\\", \\\"The cockpit flight model, tactical campaign, combat systems, user interface and multiplayer race logic.\\\", \\\"Coordinating asynchronous WebGPU startup with the simulation and headless verification.\\\", \\\"none\\\", \\\"Provide a simpler first-frame readiness signal for headless WebGPU tests.\\\"],\n  \\\"promptFeedback\\\": [\\\"The source, controller-first constraints and complete vertical-slice requirement gave the game a clear identity.\\\", \\\"Standalone multiplayer transport was unspecified; I chose peer-to-peer link codes and an optional local tab link.\\\", \\\"Making tactical navigation, free flight, combat, docking and multiplayer feel coherent in one self-contained file.\\\", \\\"Specify whether standalone multiplayer needs automatic room discovery or whether manual peer-to-peer pairing is acceptable.\\\"],\n  \\\"aiHub\\\": {\n    \\\"name\\\": \\\"Star Reclaimers\\\",\n    \\\"tagline\\\": \\\"The void doesn’t patrol itself.\\\",\n    \\\"description\\\": \\\"Defend Kestrel in an ink-stroked space patrol. Manage energy, jump six sectors, dock for repairs, and tear down the Crown command ship; compare scores with wingmates in a ghost patrol race.\\\",\n    \\\"type\\\": \\\"Game\\\",\n    \\\"genre\\\": \\\"Flight\\\",\n    \\\"source\\\": \\\"Star Raiders (1982)\\\",\n    \\\"series\\\": \\\"\\\",\n    \\\"players\\\": \\\"1–4\\\",\n    \\\"controls\\\": \\\"Mouse aim, WASD fly, click/Space fire, Shift boost, C shield, X nova, T target, F dock, M chart, J jump, V camera, Esc pause; standard gamepad; assisted touch.\\\",\n    \\\"tags\\\": [\\\"3d\\\", \\\"sci-fi\\\", \\\"first-person\\\", \\\"arcade\\\", \\\"vehicles\\\", \\\"boss fights\\\"]\n  }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > visuals.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nexport {THREE};\nexport const C={ink:0x0c1424,paper:0xe8e2c6,yellow:0xffd879,cyan:0x78d7c6,red:0xd87560,purple:0x776186,navy:0x273449};\nconst materials=new Map();\nexport function toon(color,extra={}){const key=color+JSON.stringify(extra);if(\"'!materials.has(key))materials.set(key,new THREE.MeshToonNodeMaterial({color,flatShading:true,...extra}));return materials.get(key)}\nconst inkMat=new THREE.MeshBasicNodeMaterial({color:C.ink,side:THREE.BackSide});\nexport function solid(geo,color,pos=[0,0,0],scale=[1,1,1],outline=true){const m=new THREE.Mesh(geo,toon(color));m.position.set(...pos);m.scale.set(...scale);m.castShadow=true;m.receiveShadow=true;if(outline){const line=new THREE.Mesh(geo,inkMat);line.scale.setScalar(1.045);m.add(line)}return m}\nexport function glow(geo,color,pos=[0,0,0],opacity=1){const m=new THREE.Mesh(geo,new THREE.MeshBasicNodeMaterial({color,transparent:opacity<1,opacity,depthWrite:opacity===1}));m.position.set(...pos);return m}\nfunction box(group,color,pos,size){const mesh=solid(new THREE.BoxGeometry(...size),color,pos);group.add(mesh);return mesh}\nfunction beam(group,a,b,r,color){const av=new THREE.Vector3(...a),bv=new THREE.Vector3(...b),dir=bv.clone().sub(av);const m=solid(new THREE.CylinderGeometry(r,r,dir.length(),5),color,av.add(bv).multiplyScalar(.5).toArray());m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),dir.normalize());group.add(m);return m}\nfunction wingGeometry(sign=1){const a=[0,0,-12,sign*22,-1,8,sign*18,0,13,sign*3,2,8,0,1,-12,sign*22,0,8,sign*18,1,13,sign*3,3,8];const idx=[0,1,2,0,2,3,4,7,6,4,6,5,0,4,5,0,5,1,1,5,6,1,6,2,2,6,7,2,7,3,3,7,4,3,4,0];const g=new THREE.BufferGeometry();g.setAttribute('\"'position',new THREE.Float32BufferAttribute(a,3));g.setIndex(idx);g.computeVertexNormals();return g}\nexport function ship(kind='fighter',friendly=false){const root=new THREE.Group(),base=friendly?C.paper:kind==='bomber'?0xa79eb9:C.red;const hull=solid(new THREE.ConeGeometry(5,28,4),base,[0,0,0],[1,1,1]);hull.rotation.x=-Math.PI/2;root.add(hull);for(const s of [-1,1]){const wing=solid(wingGeometry(s),base);root.add(wing);box(root,C.ink,[s*11,1,5],[3,2,13]);box(root,friendly?C.cyan:C.yellow,[s*18,1.4,8],[4,.5,3]);const barrel=solid(new THREE.CylinderGeometry(.6,.9,16,6),C.paper,[s*10,0,-4]);barrel.rotation.x=Math.PI/2;root.add(barrel);const engine=glow(new THREE.ConeGeometry(2.2,9,6),C.cyan,[s*4,0,16]);engine.rotation.x=Math.PI/2;engine.name='exhaust'+(s<0?'L':'R');root.add(engine)}const canopy=solid(new THREE.IcosahedronGeometry(4,0),C.navy,[0,3,-2],[.9,.6,1.7]);root.add(canopy);const core=glow(new THREE.OctahedronGeometry(2),C.yellow,[0,4,5]);core.name='core';root.add(core);if(kind==='bomber'){root.scale.setScalar(1.4);box(root,0x645a72,[0,-2,8],[14,9,11]);for(const s of [-1,1])box(root,C.paper,[s*19,-1,7],[6,5,15])}const mix=new THREE.AnimationMixer(root);const clip=new THREE.AnimationClip('reactor-breath',1.4,[new THREE.VectorKeyframeTrack('core.scale',[0,.7,1.4],[1,1,1,1.35,1.35,1.35,1,1,1]),new THREE.VectorKeyframeTrack('exhaustL.scale',[0,.35,.7,1.05,1.4],[1,1,1,1,1.25,1,1,.8,1,1,1.2,1,1,1,1]),new THREE.VectorKeyframeTrack('exhaustR.scale',[0,.7,1.4],[1,1,1,1,1.35,1,1,1,1])]);mix.clipAction(clip).play();root.userData.mixer=mix;return root}\nexport function station(){const root=new THREE.Group();const ring=new THREE.Group();ring.name='orbital';root.add(ring);ring.add(solid(new THREE.TorusGeometry(73,4.2,6,64),C.paper));ring.add(solid(new THREE.TorusGeometry(61,2,5,48),C.navy));for(let i=0;i<8;i++){const a=i*Math.PI/4,x=Math.cos(a)*73,y=Math.sin(a)*73;const pod=box(ring,i%2?C.navy:C.red,[x,y,0],[18,12,17]);pod.rotation.z=a;ring.add(glow(new THREE.BoxGeometry(8,2,1),C.cyan,[x,y,9]));if(i%2===0)beam(ring,[0,0,0],[x,y,0],2.4,C.navy)}root.add(solid(new THREE.CylinderGeometry(16,20,61,8),C.paper,[0,0,0]));box(root,C.navy,[0,0,16],[30,23,19]);const dock=glow(new THREE.TorusGeometry(19,1.1,6,32),C.cyan,[0,0,33]);root.add(dock);const disk=solid(new THREE.CylinderGeometry(24,24,3,8),C.navy,[0,31,0]);root.add(disk);beam(root,[0,30,0],[0,82,0],1.5,C.paper);root.add(glow(new THREE.OctahedronGeometry(4),C.red,[0,84,0]));for(let i=0;i<4;i++){const solar=box(root,0x304b63,[i%2?-110:110,10+(i>1?28:-28),-10],[48,18,2]);for(let j=0;j<4;j++)box(solar,0x89a5af,[-18+j*12,0,1.1],[.35,17,.4])}const mixer=new THREE.AnimationMixer(root);mixer.clipAction(new THREE.AnimationClip('station-orbit',30,[new THREE.NumberKeyframeTrack('orbital.rotation[z]',[0,30],[0,Math.PI*2])])).play();root.userData.mixer=mixer;return root}\nexport function flagship(){const root=new THREE.Group();const hull=solid(new THREE.ConeGeometry(42,200,6),0x9a7b91);hull.rotation.x=-Math.PI/2;root.add(hull);box(root,C.ink,[0,-7,22],[79,22,100]);box(root,C.paper,[0,18,30],[22,25,80]);for(const s of [-1,1]){const w=solid(wingGeometry(s),C.purple,[s*14,-8,10],[3.6,3,3.6]);root.add(w);box(root,C.red,[s*73,-5,35],[20,18,85]);root.add(glow(new THREE.CylinderGeometry(8,8,1,12),C.cyan,[s*73,-5,79]));box(root,C.yellow,[s*48,8,-18],[8,4,45]);const ring=glow(new THREE.TorusGeometry(19,1.5,6,32),C.cyan,[s*67,14,-23],.7);ring.name=s<0?'relayL':'relayR';root.add(ring)}const rotor=solid(new THREE.TorusGeometry(32,3,5,32),C.paper,[0,24,38]);rotor.name='crown';root.add(rotor);root.add(glow(new THREE.OctahedronGeometry(11),C.yellow,[0,24,38]));const m=new THREE.AnimationMixer(root);m.clipAction(new THREE.AnimationClip('command-array',12,[new THREE.NumberKeyframeTrack('crown.rotation[z]',[0,12],[0,Math.PI*2])])).play();root.userData.mixer=m;return root}\nexport function asteroid(radius,rng){const geo=new THREE.DodecahedronGeometry(radius,0);const p=geo.attributes.position;for(let i=0;i<p.count;i++){const f=.85+rng()*.3;p.setXYZ(i,p.getX(i)*f,p.getY(i)*f,p.getZ(i)*f)}geo.computeVertexNormals();const root=solid(geo,[0x6d5a72,0x5a6676,0x9b7d7b][Math.floor(rng()*3)]);const lines=new THREE.LineSegments(new THREE.EdgesGeometry(geo,15),new THREE.LineBasicNodeMaterial({color:0x322b42}));root.add(lines);return root}\nexport function createSky(rng){const sky=new THREE.Group();const positions=[],colors=[];for(let i=0;i<3200;i++){const z=rng()*2-1,a=rng()*Math.PI*2,r=1700+rng()*300,s=Math.sqrt(1-z*z);positions.push(Math.cos(a)*s*r,z*r,Math.sin(a)*s*r);const col=new THREE.Color([0xe7e0cb,0x85bac2,0xb59ebc][i%3]);colors.push(col.r,col.g,col.b)}const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(positions,3));geo.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));sky.add(new THREE.Points(geo,new THREE.PointsNodeMaterial({size:2.1,sizeAttenuation:false,vertexColors:true})));const planetGeo=new THREE.IcosahedronGeometry(290,4).toNonIndexed();const p=planetGeo.attributes.position,cs=[];for(let i=0;i<p.count;i+=3){const y=(p.getY(i)+p.getY(i+1)+p.getY(i+2))/3;const x=p.getX(i);const band=Math.sin(y*.022+x*.002)+.4*Math.sin(y*.065);const col=new THREE.Color(band>.8?0xe4a17c:band>-.1?0xc46f60:0x9e5261);if(y>190)col.setHex(0xe9b994);for(let j=0;j<3;j++)cs.push(col.r,col.g,col.b)}planetGeo.setAttribute('color',new THREE.Float32BufferAttribute(cs,3));const planet=new THREE.Mesh(planetGeo,new THREE.MeshToonNodeMaterial({vertexColors:true,flatShading:true}));planet.position.set(540,160,-1080);planet.rotation.z=-.24;const outline=new THREE.Mesh(new THREE.IcosahedronGeometry(294,4),new THREE.MeshBasicNodeMaterial({color:0x342c47,side:THREE.BackSide}));planet.add(outline);sky.add(planet);const rings=new THREE.Group();rings.position.copy(planet.position);rings.rotation.set(1.1,.1,.34);for(let i=0;i<4;i++){const torus=new THREE.Mesh(new THREE.TorusGeometry(385+i*11,3.3-i*.4,3,160),new THREE.MeshBasicNodeMaterial({color:[0xc69483,0x5e526f,0xc0a59b,0x6b5e7b][i],transparent:true,opacity:.5}));rings.add(torus)}sky.add(rings);const c=document.createElement('canvas');c.width=c.height=512;const ctx=c.getContext('2d');const gradient=ctx.createRadialGradient(260,260,10,260,260,250);gradient.addColorStop(0,'#71638266');gradient.addColorStop(.45,'#49446b44');gradient.addColorStop(1,'#1b233000');ctx.fillStyle=gradient;ctx.fillRect(0,0,512,512);const neb=new THREE.Mesh(new THREE.PlaneGeometry(2800,1500),new THREE.MeshBasicNodeMaterial({map:new THREE.CanvasTexture(c),transparent:true,depthWrite:false,opacity:.8}));neb.position.set(-500,70,-1500);sky.add(neb);const sun=glow(new THREE.SphereGeometry(14,12,8),0xffedbb,[-690,280,-1300]);sky.add(sun);for(const len of [100,45]){const line=glow(new THREE.PlaneGeometry(len,len===100?1:2),0xffdc9b,[-690,280,-1290],.6);if(len===45)line.rotation.z=Math.PI/2;sky.add(line)}return sky}\nexport function createCockpit(camera){const root=new THREE.Group();root.name='cockpit';camera.add(root);beam(root,[-3,-1.65,-3.3],[-1.85,1.9,-2.7],.055,C.ink);beam(root,[3,-1.65,-3.3],[1.85,1.9,-2.7],.055,C.ink);beam(root,[-3,-1.65,-3.3],[-1.85,1.9,-2.7],.022,0x75828b);beam(root,[3,-1.65,-3.3],[1.85,1.9,-2.7],.022,0x75828b);beam(root,[-2.4,-1.4,-2.7],[-.7,-1.75,-2.7],.09,C.ink);beam(root,[2.4,-1.4,-2.7],[.7,-1.75,-2.7],.09,C.ink);for(const s of [-1,1]){const panel=box(root,C.ink,[s*1.9,-1.2,-2.8],[.65,.45,.35]);panel.rotation.z=s*.18;for(let i=0;i<4;i++)panel.add(glow(new THREE.BoxGeometry(.08,.015,.01),i===0?C.yellow:C.cyan,[-.18+i*.12,0,.18]));const gun=box(root,C.navy,[s*.82,-.7,-2],[.16,.15,.8]);gun.name=s<0?'gunL':'gunR';gun.add(glow(new THREE.BoxGeometry(.03,.02,.4),C.cyan,[0,.08,0]))}const m=new THREE.AnimationMixer(root);const clip=new THREE.AnimationClip('twin-cannon-recoil',.15,[new THREE.NumberKeyframeTrack('gunL.position[z]',[0,.035,.15],[-2,-1.85,-2]),new THREE.NumberKeyframeTrack('gunR.position[z]',[0,.035,.15],[-2,-1.85,-2])]);const action=m.clipAction(clip);action.setLoop(THREE.LoopOnce,1);action.clampWhenFinished=true;root.userData={mixer:m,recoil:()=>{action.reset().play()}};return root}\nexport function explosion(scene,pos,scale,rng){const root=new THREE.Group();root.position.copy(pos);const core=glow(new THREE.IcosahedronGeometry(scale,1),C.yellow);root.add(core);const ring=glow(new THREE.TorusGeometry(scale*1.1,scale*.055,4,32),C.paper,[0,0,0],.9);ring.rotation.x=rng()*Math.PI;root.add(ring);for(let i=0;i<10;i++){const shard=solid(new THREE.TetrahedronGeometry(scale*(.08+rng()*.2)),i%2?C.red:C.paper,[(rng()-.5)*scale*3,(rng()-.5)*scale*3,(rng()-.5)*scale*3]);root.add(shard)}const mix=new THREE.AnimationMixer(root);const clip=new THREE.AnimationClip('inkburst',.6,[new THREE.VectorKeyframeTrack('.scale',[0,.15,.6],[.05,.05,.05,1.5,1.5,1.5,2.4,2.4,2.4]),new THREE.NumberKeyframeTrack('.rotation[z]',[0,.6],[0,1.8]),new THREE.NumberKeyframeTrack('material.opacity',[0,.6],[1,0])]);clip.tracks.pop();mix.clipAction(clip).setLoop(THREE.LoopOnce,1).play();scene.add(root);return {root,mix,life:.6,max:.6}}\nexport function holoShip(color=C.cyan){const s=ship('fighter',true);s.scale.setScalar(.7);s.traverse(o=>{if(o.isMesh){o.material=new THREE.MeshBasicNodeMaterial({color,wireframe:true,transparent:true,opacity:.46,depthWrite:false})}});return s}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
