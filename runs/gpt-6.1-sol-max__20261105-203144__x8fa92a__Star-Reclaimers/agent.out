wLeft\") this.navigate(-1, 0);\n\t\tif (code === \"ArrowRight\") this.navigate(1, 0);\n\t}\n\tcomms(text, duration = 6) {\n\t\t$(\"comms-text\").textContent = text;\n\t\t$(\"comms\").classList.remove(\"hide\");\n\t\tthis.commTime = duration;\n\t}\n\tnotice(text, duration = 3) {\n\t\t$(\"notice\").textContent = text;\n\t\t$(\"notice\").classList.remove(\"hide\");\n\t\tthis.noticeTime = duration;\n\t}\n\ttick(dt) {\n\t\tthis.commTime -= dt;\n\t\tif (this.commTime <= 0) $(\"comms\").classList.add(\"hide\");\n\t\tthis.noticeTime -= dt;\n\t\tif (this.noticeTime <= 0) $(\"notice\").classList.add(\"hide\");\n\t\tthis.damage = Math.max(0, this.damage - dt * 1.8);\n\t\t$(\"damage-flash\").style.opacity = this.damage * 0.7;\n\t\tconst j = this.g.jump;\n\t\t$(\"jump-overlay\").style.opacity = j\n\t\t\t? Math.sin((1 - j.time / j.max) * Math.PI) * 0.75\n\t\t\t: 0;\n\t\t$(\"jump-text\").classList.toggle(\"hide\", !j);\n\t\tif (j) {\n\t\t\t$(\"jump-name\").textContent = this.g.campaign[j.to].name;\n\t\t\t$(\"jump-count\").textContent =\n\t\t\t\t\"SPOOLING \" +\n\t\t\t\tMath.max(0, j.time).toFixed(1) +\naudio.js:209:\tstop() {\ngame.js:284:\t\t\t\tthis.audio.stop();\ngame.js:1532:\tsnapshot() {\ngame.js:1581:\t\t\tframeCount: this.frameCount,\ngame.js:1590:\t\t\tsnapshot: () => this.snapshot(),\ngame.js:1591:\t\t\taudioProof: () => this.audio.proof(),\ngame.js:1602:\t\t\t\t\treturn this.snapshot();\n{\n\t\"private\": true,\n\t\"type\": \"module\",\n\t\"name\": \"star-game\",\n\t\"scripts\": {\n\t\t\"build\": \"node build.mjs\",\n\t\t\"test\": \"/home/micha/.local/share/pipx/venvs/playwright/bin/python verify.py\"\n\t},\n\t\"dependencies\": {\n\t\t\"@dimforge/rapier3d-compat\": \"0.19.3\",\n\t\t\"esbuild\": \"0.28.2\",\n\t\t\"three\": \"0.180.0\"\n\t}\n}\n./flight-gl.png\n./package-lock.json\n./shell.html\n./network.js\n./capture-webgl.py\n./audio.js\n./main.js\n./gpu-probe.mjs\n./visuals.js\n./gpu-probe.html\n./flight.png\n./hub-harness.html\n./gpu-probe-0.png\n./gpu-probe-2.png\n.