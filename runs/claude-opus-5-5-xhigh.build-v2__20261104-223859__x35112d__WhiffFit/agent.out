t.pad.rotate * 90.0 * dt + 540.0).rem_euclid(360.0) - 180.0;\n            self.rig.params.distance = (self.rig.params.distance * (1.0 + self.input.pad.zoom * dt)).clamp(2.0, 120.0);\n        }\n\"\"\"),\n(\"\"\"        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let studio_mode = curr.studio_mode();\"\"\",\"\"\"        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let fit_frame = curr.hud.fit.clone();\n        let fit_now = fit_frame.is_some();\n        if fit_now != self.fit {\n            self.fit = fit_now;\n            self.input.fit = fit_now;\n            self.input.game = false;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n            self.input.bindings = if fit_now { crate::input::Bindings::fit() } else { crate::input::Bindings::default() };\n        }\n        let studio_mode = curr.studio_mode();\"\"\"),\n(\"\"\"                self.input.bindings = b;\n                for e in errs {\"\"\",\"\"\"                if !self.fit {\n                    self.input.bindings = b;\n                }\n                for e in errs {\"\"\"),\n(\"\"\"        let alpha = if self.app_settings.smoothing && !snap_camera {\"\"\",\"\"\"        // Whiff Fit's settings, applied to the host.\n        if let Some(f) = &fit_frame {\n            let room = curr.room.as_ref().map(|r| r.id);\n            if room != self.fit_room {\n                if self.fit_room.is_some() {\n                    self.arrival = Some(now);\n                }\n                self.fit_room = room;\n                self.rig.snap(curr.focus);\n            }\n            if let Some(y) = curr.hud.camera_yaw {\n                self.rig.params.yaw = y;\n            }\n            self.fit_cam_free = f.cam_free;\n            self.app_settings.show_stats = f.show_stats;\n            let buses = [f.music, f.sfx, f.voice];\n            if let Some(a) = &self.audio {\n                if buses != self.fit_buses {\n                    self.fit_buses = buses;\n                    a.set_buses(f.music, f.sfx, f.voice);\n                }\n                if f.music_hold != self.fit_hold {\n                    self.fit_hold = f.music_hold;\n                    a.hold_music(f.music_hold);\n                }\n            }\n            if f.time_scale != self.fit_speed {\n                self.fit_speed = f.time_scale;\n                let s = f.time_scale;\n                host.set_control(|c| c.speed = s);\n            }\n            if f.save_serial != self.fit_save_serial {\n                self.fit_save_serial = f.save_serial;\n                if f.save_serial > 1 && !f.save_json.is_empty() {\n                    crate::weblink::store_save(&f.save_json);\n                }\n            }\n            if f.rumble > 0.0 {\n                crate::weblink::rumble(f.rumble);\n            }\n            if f.fullscreen_serial != self.fit_fullscreen {\n                self.fit_fullscreen = f.fullscreen_serial;\n                if let Some(g) = &self.gfx {\n                    crate::platform::toggle_fullscreen(&g.window);\n                }\n            }\n            if let Some(g) = &self.gfx {\n                g.window.set_cursor_visible(self.input.last_device != Device::Gamepad);\n            }\n            if let Some(s) = &curr.hud.status {\n                crate::weblink::publish_status(s);\n            }\n            self.hub = crate::weblink::hub();\n            if self.hub.ended && !self.hub_gone {\n                self.hub_gone = true;\n                if let Some(a) = &self.audio {\n                    a.set_master(0.0);\n                }\n                host.exec(|sim| {\n                    if let Some(g) = sim.state.play.as_mut().and_then(|g| g.get_mut::<pav_core::games::fit::FitGame>()) {\n                        g.hub_ended = true;\n                    }\n                });\n            }\n        }\n        let alpha = if self.app_settings.smoothing && !snap_camera {\"\"\"),\n(\"\"\"        let (mut held, mut pressed) = self.input.buttons();\n        // Touch: the stick, the buttons and auto-attack.\"\"\",\"\"\"        let (mut held, mut pressed) = self.input.buttons();\n        if self.fit && self.fit_ui.over_item {\n            // The UI took the click.\n            held &= !pav_core::input::buttons::PRIMARY;\n            pressed &= !pav_core::input::buttons::PRIMARY;\n            self.input.mouse_taps.clear();\n        }\n        // Touch: the stick, the buttons and auto-attack.\"\"\"),\n(\"\"\"        let room_id = self.hud.current.as_ref().map(|r| r.id);\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n        if left_tap && !self.editor.on && game_input {\n            pressed |= pav_core::input::buttons::PRIMARY;\n        }\"\"\",\"\"\"        let room_id = self.hud.current.as_ref().map(|r| r.id);\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n        if left_tap && !self.editor.on && game_input && !(self.fit && self.fit_ui.over_item) {\n            pressed |= pav_core::input::buttons::PRIMARY;\n        }\"\"\"),\n(\"\"\"        let aim = match self.input.last_device {\n            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\"\"\",\"\"\"        let aim = match self.input.last_device {\n            Device::Gamepad if self.fit => None,\n            Device::Touch if self.fit => None,\n            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\"\"\"),\n(\"\"\"                i.held = held;\n                i.pressed |= pressed;\n                i.aim = aim;\"\"\",\"\"\"                i.held = held;\n                i.pressed |= pressed;\n                i.aim = aim;\n                if let Some(f) = &fit_frame {\n                    let shape = crate::input::LeanShape {\n                        deadzone: f.input[0],\n                        curve: f.input[1],\n                        key_rate: f.input[2],\n                        key_return: f.input[3],\n                        mouse_span: f.input[4],\n                        arrows_step: f.arrows_step,\n                        cursor_leans: f.cursor_leans,\n                        fast: f.lean_fast,\n                    };\n                    i.lean = self.input.fit_lean(dt, size, &shape);\n                    if self.hub.go {\n                        i.held |= pav_core::input::buttons::HUB_GO;\n                    }\n                    let any = pressed != 0 || self.input.pad.any_activity || self.fit_cursor_moved > 6.0;\n                    if any {\n                        self.fit_cursor_moved = 0.0;\n                    }\n                    i.any |= any;\n                    i.song_pos = None;\n                    if let Some(a) = &self.audio {\n                        // The music's clock, phase-locked: it moves in lumps, a buffer at a time.\n                        let pos = a.song_seconds();\n                        if pos != self.fit_audio_last {\n                            self.fit_audio_last = pos;\n                            self.fit_audio_at = now;\n                        }\n                        if !f.music_hold {\n                            self.fit_clock += dt as f64;\n                        }\n                        self.fit_clock += (pos - self.fit_clock) * 0.05;\n                        if (now - self.fit_audio_at).as_secs_f32() < 0.5 && pos > 0.0 {\n                            i.song_pos = Some((self.fit_clock - f.rhythm_offset as f64) as f32);\n                        }\n                    }\n                }\"\"\"),\n(\"\"\"        let mut view = self.view.clone();\n        self.look_ui.apply(&mut view);\n        self.prefs.quality.trim(self.touch_screen, &mut view);\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\"\"\",\"\"\"        let mut view = self.view.clone();\n        self.look_ui.apply(&mut view);\n        self.prefs.quality.trim(self.touch_screen, &mut view);\n        // Other players' ghosts, where they're in the same area as you.\n        let mut hub_labels = Vec::new();\n        let (prev, curr) = if self.fit && !self.hub.ghosts.is_empty() {\n            let (a, b, labels) = crate::weblink::with_ghosts(&prev, &curr, &self.hub, &mut self.hub_seen, dt);\n            hub_labels = labels;\n            (std::sync::Arc::new(a), std::sync::Arc::new(b))\n        } else {\n            (prev, curr)\n        };\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\"\"\"),\n(\"\"\"        let out = self.egui_ctx.run_ui(raw, |ui| {\n            let ctx = ui.ctx().clone();\n            if let Some(c) = &info.crash {\n                ui::crash_banner(ui, c);\n            }\"\"\",\"\"\"        let fit_input = pav_ui::fit_ui::Input {\n            device: if self.input.last_device == Device::Touch { Device::Gamepad } else { self.input.last_device },\n            mouse: self.input.mouse_recent,\n        };\n        let mut fit_out = None;\n        let out = self.egui_ctx.run_ui(raw, |ui| {\n            let ctx = ui.ctx().clone();\n            if let Some(c) = &info.crash {\n                ui::crash_banner(ui, c);\n            }\n            if let Some(f) = &fit_frame {\n                fit_out = Some(pav_ui::fit_ui::draw(&ctx, f, fit_input, view_proj, &hub_labels));\n                if show_stats {\n                    ui::stats_panel(&ctx, &info, ctx.content_rect(), false);\n                }\n                return;\n            }\"\"\"),\n(\"\"\"        if prefs != self.prefs {\n            self.prefs = prefs;\n            crate::save::save_prefs(&self.prefs);\n        }\"\"\",\"\"\"        if let Some(o) = fit_out {\n            if let Some(e) = o.event {\n                let mut i = host_input(&self.host);\n                if !matches!(i.ui, Some(pav_core::input::UiEvent::Click(_))) {\n                    i.ui = Some(e);\n                }\n                set_host_input(&self.host, i);\n            }\n            if let Some(f) = &fit_frame {\n                crate::weblink::publish_ui(f, &o, self.input.last_device, self.input.mouse_recent);\n            }\n            self.fit_ui = o;\n        }\n        if prefs != self.prefs {\n            self.prefs = prefs;\n            crate::save::save_prefs(&self.prefs);\n        }\"\"\"),\n(\"\"\"                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\"\"\",\"\"\"                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } if self.fit => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    if event.state == ElementState::Pressed && !event.repeat {\n                        self.handle_key(code);\n                    }\n                    self.input.key(code, event.state);\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\"\"\"),\n(\"\"\"            WindowEvent::MouseWheel { delta, .. } if !consumed => {\"\"\",\"\"\"            WindowEvent::MouseWheel { .. } if self.fit && !self.fit_cam_free => {}\n            WindowEvent::MouseWheel { delta, .. } if !consumed => {\"\"\"),\n(\"\"\"                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n                    MouseButton::Middle\n                } else {\n                    MouseButton::Right\n                };\n                if button == turn {\"\"\",\"\"\"                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n                    MouseButton::Middle\n                } else {\n                    MouseButton::Right\n                };\n                if self.fit {\n                    // The right button is a game button too; on the island it also drags the view.\n                    if button == MouseButton::Right {\n                        self.mouse.right_down = state == ElementState::Pressed && self.fit_cam_free;\n                    }\n                    self.input.mouse_button(button, state);\n                } else if button == turn {\"\"\"),\n(\"\"\"                if (p - self.mouse.pos).length() > 2.0 {\n                    self.input.last_device = Device::KeyboardMouse;\n                }\"\"\",\"\"\"                if (p - self.mouse.pos).length() > 2.0 {\n                    self.input.last_device = Device::KeyboardMouse;\n                    self.input.mouse_recent = true;\n                }\n                self.fit_cursor_moved += (p - self.mouse.pos).length();\"\"\"),\n])\ns=open('crates/pav_app/src/app.rs').read()\ns+=\"\"\"\nfn host_input(host: &Option<SimHost>) -> InputFrame {\n    host.as_ref().map(|h| *h.shared.input.lock().unwrap()).unwrap_or_default()\n}\n\nfn set_host_input(host: &Option<SimHost>, i: InputFrame) {\n    if let Some(h) = host {\n        *h.shared.input.lock().unwrap() = i;\n    }\n}\n\"\"\"\nopen('crates/pav_app/src/app.rs','w').write(s)\n\npatch('crates/pav_app/src/settings.rs', [\n(\"\"\"        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {\"\"\",\"\"\"        // The page's boot block (an AI Hub session names its own scene and seed).\n        let boot = crate::weblink::boot();\n        if let Some(scene) = boot.scene {\n            s.scene = scene;\n        }\n        if let Some(seed) = boot.seed {\n            s.seed = seed;\n        }\n        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {\"\"\"),\n])\nEOF\ngrep -n \"^mod \\|^pub mod \" crates/pav_app/src/main.rs | head -30; grep -n \"crate-type\\|\\[lib\\]\\|\\[\\[bin\\]\\]\" crates/pav_app/Cargo.toml; ls crates/pav_app/src/lib.rs 2>/dev/null; grep -n \"mod \" crates/pav_app/src/lib.rs 2>/dev/null | head -30; sed -n 30,42p crates/pav_app/Cargo.toml","description":"Patch app, input, settings and simhost for the game"}},"wire_ingest_context":{"toolu_014hgGG3UEg3VRD2B9qdU2oN":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine"}}}
