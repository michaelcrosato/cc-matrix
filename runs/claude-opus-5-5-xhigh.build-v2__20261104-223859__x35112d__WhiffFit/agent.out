.rs:98:    sim.run(90, &InputFrame { move_dir: Vec2::new(0.4, -1.0), ..Default::default() });\ncrates/pav_core/tests/loot.rs:19:    sim.step(&InputFrame { cmd: Some(c), ..Default::default() });\n# The starter game's level: a room file (every field: rooms/_template.toml). Column = x (east),\n# row = z (south), 1 cell = 1 m. `o` cells are shards and `P` is the start (legend markers,\n# read by starter.rs with `scenes::markers`); the slimes are [[npc]] entries the game drives.\n# Check it with `pav room_check path=crates/pav_core/src/games/starter.toml`.\n\nname = \"Starter\"\nabout = \"Collect every shard while slimes chase you.\"\nentrance = { at = [8, 12], facing = \"south\" }   # required by the format; the `P` marker is the start\n\n# The rules' numbers (starter.rs `Rules`). Running from the repository, `pav` reads this file at\n# each `load`: edit, then `load scene=starter` or `play bot=true seeds=10`, no rebuild.\n[game]\nlives = 3\nslime_speed = 0.5\nslime_sight = 9.0\ncatch = 0.8\npick = 0.9\ngrace = 2.0\n\n[camera]\ntilt = 58.0\ndistance = 17.0\n\n[layout]\norigin = [-9.0, 0.0, -6.5]\n\n[[layout.layer]]\ny = 0\nmap = '''\n##################\n#o......#.......o#\n#.......#........#\n#..##.......##...#\n#..#.........#...#\n#.......o........#\n#....#.....#.....#\n#.......P........#\n#..#.........#...#\n#..##.......##...#\n#.......#........#\n105:# prop = { ..., sway = \"leaves\" }   props (and [[object]]s) can sway: \"leaves\" | \"grass\"\n106-#\n107-# zone = { kind = \"...\", ... } makes the tile a trigger (identical neighbours merge):\n108-#   kind = \"start\" | \"finish\" | \"gate\" | \"checkpoint\" | \"kill\" | \"water\" | \"pad\" | \"camera\" |\n109-#          \"conveyor\" (facing = direction, speed = m/s; carries characters and props) |\n110-#          \"bounce\" (speed = launch m/s; trampolines for characters and props)\n111-#   course = \"name\"   start/finish/gates of one course share it; leaving START starts the timer,\n112-#                     gates must be passed in `index` order (missed gate = +2 s), FINISH stops it\n113-#   index = 1         gate order\n114-#   y0 = 0, y1 = 3    height range relative to the layer (kill zones in pits: e.g. y0 = -3, y1 = -1)\n115-#   label = \"TEXT\"    drawn on the floor (label_size = 0.5 to override the auto fit);\n116-#                     color = \"#rrggbb\" or \"none\"; facing = \"east\" (respawn direction)\n117-#   Zones are half-open boxes, so touching zones never overlap. A respawn point that lies in a\n118-#   zone does not trigger it (respawning onto START keeps the timer running).\n119-#   params = { \"movement.model\" = \"momentum\" }       pads: parameter changes until you leave\n120-#                     (\"view.bloom\" = 1.5 etc. change view settings the same way)\n121-#   signal = \"drop\"   pads: tells spawners listening for \"drop\" to fire\n122-#   note = \"...\"      pads: what it sets and what to look for (on screen while you stand on it;\n123-#                     required on every pad with params)\n124-#   camera = { set = { tilt = 90, ortho = true }, sweep = [{ param = \"tilt\", from = 90,\n125-#              to = 10, period = 12 }], flip_ortho = 6 }  pads (sticky) / camera zones (inside)\n126-#   water: swim below y1 (its surface ripples: a CPU wave simulation; neighbouring water tiles\n127-#   with the same top that form a rectangle ripple as one surface). kill: back to the last checkpoint.\n128-\n129-# Free text anywhere (layout space: x = column, y = height, z = row).\n130-# [[label]]\n--\n138:[[object]]\n139-name = \"ball\"\n140-shape = { type = \"sphere\", radius = 0.4 }\n141-pos = [3.5, 1.0, 3.5]           # x = column, y = height, z = row\n142-color = \"#5b8def\"\n143-body = \"dynamic\"                # dynamic | fixed | kinematic | none\n144-\n145-# Animated objects use body = \"kinematic\" and a behavior (vectors are in the object's own frame):\n146-#   behavior = { type = \"move\", offset = [0, 0, 4], period = 4, phase = 0, hold = 0.3, smooth = true }\n147-#     (hold = share of the cycle spent waiting, split between both ends)\n148-#   behavior = { type = \"rotate\", axis = [0, 1, 0], speed = 90 }                   (deg/s)\n149-#   behavior = { type = \"rotate\", axis = [1, 0, 0], swing = 60, period = 2, pivot = [0, 2, 0] }\n150-#   behavior = { type = \"spin\", speed = 1.5 }                                       (rad/s)\n151-# Projectile emitters (body = \"none\", or \"fixed\" with a slim shape; bullets ignore their emitter):\n152-#   behavior = { type = \"emitter\", pattern = \"aimed\", interval = 1.0, count = 1, spread = 0,\n153-#                speed = 6, radius = 0.15, height = 0, range = 30, delay = 0, burst = 0, pause = 1,\n154-#                color = \"#ff5a3c\", knockback = 6, gravity = 0, spin = 12, life = 6 }\n155-#     pattern: aimed (at the player) | forward (+Z of the object, see yaw) | ring | spiral | random\n156-# Touching a hazard knocks you back (respawn = true sends you to the last checkpoint):\n157-#   hazard = { knockback = 7, respawn = false }\n158-# Spawners drop props on a timer and/or when a pad sends their signal (body = \"none\"):\n159-#   behavior = { type = \"spawner\", shape = { type = \"box\", half = [0.3, 0.3, 0.3] }, color = \"\",\n160-#                count = 20, interval = 0, max = 200, area = [1.5, 0.5, 1.5], signal = \"drop\",\n161-#                clear = \"clear\", density = 1, friction = 0.5, restitution = 0.1, tumble = true }\n162-#     (pending = 1 drops one batch on the first tick, so the room starts with its props)\n163-# The store's catalogue (rooms/catalogue.toml; body = \"none\"): a pad's signal lays out the next","is_error":false}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"48500142-5128-4486-b738-a2dca4378909","timestamp":"2026-11-05T05:40:30.907Z","tool_use_result":{"stdout":"5:use pav_render::{Renderer, gpu::Headless};\n9:    pub headless: Headless,\n16:    overlay: Option<pav_ui::headless::Overlay>,\n53:    /// Set by the native bridge. Headless sessions do not wait for or report window frames.\n55:    /// Live requests share owner 0; independent headless sessions adopt only their own jobs.\n58:    pub ui: pav_ui::headless::Headless,\n159:            let headless = Headless::new()?;\n160:            let renderer = Renderer::new(&headless.device, &headless.queue);\n162:                headless,\n350:        input: pav_ui::headless::Input,\n351:    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n365:        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));\n372:            gpu.overlay.get_or_insert_with(|| pav_ui::headless::Overlay::new(&device, pav_render::capture::CAPTURE_FORMAT));\n385:    pub fn read_ui(&mut self, width: u32, height: u32, input: pav_ui::headless::Input) -> Option<pav_ui::headless::Drawn> {\n392:        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n435:    frame.game.is_some() || !frame.hud.lines.is_empty()\n1358:fn t_input(s: &mut Session, a: &Args) -> Result<Output> {\n1359-    let mv = vec_arg(a, \"move\")?.unwrap_or_default();\n1360-    let dir = glam::Vec2::new(mv.first().copied().unwrap_or(0.0), mv.get(1).copied().unwrap_or(0.0));\n1361-    let held = buttons_arg(a, \"hold\")?;\n1362-    let press = buttons_arg(a, \"press\")?;\n1363-    let aim = vec_arg(a, \"aim\")?.filter(|v| v.len() == 3).map(|v| glam::Vec3::new(v[0], v[1], v[2]));\n1364-    let n = get_u64(a, \"ticks\", 1)?.max(1);\n1365-    for i in 0..n {\n1366-        let f = pav_core::InputFrame {\n1367-            move_dir: dir.clamp_length_max(1.0),\n1368-            vertical: 0.0,\n1369-            aim,\n1370-            held: held | if i == 0 { press } else { 0 },\n1371-            pressed: if i == 0 { press } else { 0 },\n1372-            cmd: None,\n1373-        };\n1374-        s.sim.step(&f);\n1375-        s.sync_camera();\n1376-    }\n1377-    s.keep_events();\n1378-    Ok(Output::Json(player_json(s)))\n1379-}\n1380-\n1381-fn t_spawn(s: &mut Session, a: &Args) -> Result<Output> {\n1382-    use pav_core::{BodyKind, Color, Shape, Spawn, Visual};\n1383-    let size = vec_arg(a, \"size\")?.unwrap_or_default();\n1384-    let g = |i: usize, d: f32| size.get(i).copied().unwrap_or(d);\n1385-    let shape = match get_str(a, \"shape\").unwrap_or(\"box\") {\n1386-        \"box\" => Shape::Box { half: glam::Vec3::new(g(0, 0.4), g(1, g(0, 0.4)), g(2, g(0, 0.4))) },\n1387-        \"rounded_box\" => Shape::RoundedBox { half: glam::Vec3::new(g(0, 0.4), g(1, g(0, 0.4)), g(2, g(0, 0.4))), radius: 0.1 },\n1388-        \"sphere\" => Shape::Sphere { radius: g(0, 0.4) },\n1389-        \"capsule\" => Shape::Capsule { half_height: g(0, 0.3), radius: g(1, 0.25) },\n1390-        \"cylinder\" => Shape::Cylinder { half_height: g(0, 0.4), radius: g(1, 0.3) },\n1391-        other => bail!(\"unknown shape '{other}'\"),\n1392-    };\n1393-    let pos = vec_arg(a, \"pos\")?.filter(|v| v.len() == 3).map(|v| glam::Vec3::new(v[0], v[1], v[2]));\n1394-    let pos = pos.unwrap_or_else(|| s.sim.state.focus + glam::Vec3::new(0.0, 3.0, 0.0));\n1395-    let body = match get_str(a, \"body\").unwrap_or(\"dynamic\") {\n1396-        \"dynamic\" => BodyKind::Dynamic,\n1397-        \"fixed\" => BodyKind::Fixed,\n1398-        \"kinematic\" => BodyKind::Kinematic,\n1399-        \"none\" => BodyKind::None,\n1400-        other => bail!(\"unknown body '{other}'\"),\n1401-    };\n1402-    let color = Color::try_hex(get_str(a, \"color\").unwrap_or(\"#e8704a\")).context(\"color must be #rrggbb\")?;\n1403-    let id = s.sim.spawn(Spawn::new(get_str(a, \"name\").unwrap_or(\"prop\"), pos).visual(Visual::new(shape, color)).body(body));\n1404-    Ok(Output::Json(json!({ \"id\": id.0 })))\n1405-}\n1406-\n1407-fn t_despawn(s: &mut Session, a: &Args) -> Result<Output> {\n1408-    let id = pav_core::EntityId(get_u64(a, \"id\", 0)? as u32);\n//! Games built on the engine (`pav_core::games`): the starter's bot wins on many seeds, the\n//! starter can be lost, and a game's state survives snapshot files, rewind and replays like\n//! the rest of the simulation. Copy these tests for a new game.\n\nuse pav_core::games::{GAMES, Outcome};\nuse pav_core::{InputFrame, Sim, SimState};\n\n#[test]\nfn the_starter_bot_wins_on_ten_seeds() {\n    for seed in 1..=10 {\n        let mut sim = Sim::new(\"starter\", seed).unwrap();\n        let (outcome, ticks) = sim.run_bot(60 * 60);\n        let status = sim.play().unwrap().status(&sim);\n        assert_eq!(outcome, Outcome::Won, \"seed {seed}, {ticks} ticks: {status}\");\n    }\n}\n\n#[test]\nfn standing_still_gets_caught() {\n    let mut sim = Sim::new(\"starter\", 1).unwrap();\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 3\"]);\n    for _ in 0..60 * 60 {\n        sim.step(&InputFrame::default());\n    }\n    assert_eq!(sim.outcome(), Outcome::Lost);\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 0\", \"Game over\"]);\n}\n\n#[test]\nfn snapshots_rewind_and_replays_are_exact() {\n    let mut sim = Sim::new(\"starter\", 3).unwrap();\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    // A snapshot file (CBOR) restores the game, and both copies then play on the same.\n    let mut bytes = Vec::new();\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\n    let state: SimState = ciborium::from_reader(bytes.as_slice()).unwrap();\n    let mut copy = Sim::new(\"starter\", 3).unwrap();\n    copy.restore(state);\n    assert_eq!(copy.state_hash(), sim.state_hash());\n    for _ in 0..240 {\n        let (a, b) = (sim.bot_input(), copy.bot_input());\n        sim.step(&a);\n        copy.step(&b);\n    }\n    assert_eq!(copy.state_hash(), sim.state_hash());\n\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90));\n    assert!(sim.rewind_to(tick));\n    assert_eq!(sim.state_hash(), hash);\n\n    let mut again = Sim::new(\"starter\", 3).unwrap();\n    for f in sim.recording.iter() {\n        again.step(f);\n    }\n    assert_eq!(again.state_hash(), hash);\n}\ncrates/pav_core/tests/monsters.rs:166:    sim.step(&InputFrame { cmd: Some(GameCmd::Release(exhibits[7] as u32)), ..Default::default() });\ncrates/pav_core/tests/monsters.rs:169:    sim.step(&InputFrame { cmd: Some(GameCmd::Reroll), ..Default::default() });\ncrates/pav_core/tests/movement.rs:17:    sim.run(ticks, &InputFrame { move_dir: dir, ..Default::default() });\ncrates/pav_core/tests/movement.rs:22:        sim.step(&InputFrame { move_dir: dir, held: b, pressed: if i == 0 { b } else { 0 }, ..Default::default() });\ncrates/pav_core/tests/town.rs:65:    sim.step(&InputFrame { cmd: Some(GameCmd::Gamble(0)), ..Default::default() });\ncrates/pav_core/tests/town.rs:69:        sim.step(&InputFrame { cmd: Some(GameCmd::Gamble(slot)), ..Default::default() });\ncrates/pav_core/tests/town.rs:76:    sim.step(&InputFrame { cmd: Some(GameCmd::Brew(0)), ..Default::default() });\ncrates/pav_core/tests/town.rs:77:    sim.step(&InputFrame { cmd: Some(GameCmd::Brew(1)), ..Default::default() });\ncrates/pav_core/tests/town.rs:82:        sim.step(&InputFrame { cmd: Some(GameCmd::Brew(0)), ..Default::default() });\ncrates/pav_core/tests/town.rs:90:    sim.step(&InputFrame { cmd: Some(GameCmd::Travel(Place::Level(1).code())), ..Default::default() });\ncrates/pav_core/tests/town.rs:95:    sim.step(&InputFrame { cmd: Some(GameCmd::Travel(Place::Town.code())), ..Default::default() });\ncrates/pav_core/tests/town.rs:121:        sim.step(&InputFrame { cmd: Some(GameCmd::Equip(*id)), ..Default::default() });\ncrates/pav_core/src/ai.rs:221:    pub fn think(&mut self, feet: Vec3, player: Option<Vec3>, others: &[Vec3], rng: &mut Rng, dt: f32) -> InputFrame {\ncrates/pav_core/tests/skills.rs:24:    sim.step(&InputFrame { cmd: Some(c), ..Default::default() });\ncrates/pav_core/tests/skills.rs:70:            sim.step(&InputFrame { aim: Some(aim), held, pressed, ..Default::default() });\ncrates/pav_core/tests/skills.rs:99:    let f = InputFrame {\ncrates/pav_core/tests/skills.rs:119:    let hold = InputFrame { held: buttons::SKILL3, pressed: buttons::SKILL3, ..Default::default() };\ncrates/pav_core/tests/skills.rs:122:        sim.step(&InputFrame { held: buttons::SKILL3, ..Default::default() });\ncrates/pav_core/tests/skills.rs:139:    sim.step(&InputFrame { held: buttons::SKILL4, pressed: buttons::SKILL4, ..Default::default() });\ncrates/pav_core/tests/skills.rs:146:    sim.step(&InputFrame { aim: Some(target), held: buttons::SKILL5, pressed: buttons::SKILL5, ..Default::default() });\ncrates/pav_core/tests/levels.rs:282:    sim.step(&InputFrame { cmd: Some(GameCmd::Use(spot as u32)), ..Default::default() });\ncrates/pav_core/tests/levels.rs:331:    sim.step(&InputFrame { cmd: Some(GameCmd::Use(exit as u32)), ..Default::default() });\ncrates/pav_core/tests/levels.rs:339:    sim.step(&InputFrame { cmd: Some(GameCmd::Use(exit as u32)), ..Default::default() });\ncrates/pav_core/tests/levels.rs:345:    sim.step(&InputFrame { cmd: Some(GameCmd::Travel(Place::Town.code())), ..Default::default() });\ncrates/pav_core/tests/levels.rs:347:    sim.step(&InputFrame { cmd: Some(GameCmd::Travel(Place::Level(9).code())), ..Default::default() });\ncrates/pav_core/tests/levels.rs:349:    sim.step(&InputFrame { cmd: Some(GameCmd::Travel(Place::Level(3).code())), ..Default::default() });\ncrates/pav_core/tests/levels.rs:624:    let inp = InputFrame { move_dir: glam::Vec2::new(0.0, 1.0), ..Default::default() };\ncrates/pav_core/tests/animation.rs:82:    sim.run(60, &InputFrame { move_dir: Vec2::new(1.0, 0.0), ..Default::default() });\ncrates/pav_core/tests/animation.rs:98:    sim.run(90, &InputFrame { move_dir: Vec2::new(0.4, -1.0), ..Default::default() });\ncrates/pav_core/tests/loot.rs:19:    sim.step(&InputFrame { cmd: Some(c), ..Default::default() });\n# The starter game's level: a room file (every field: rooms/_template.toml). Column = x (east),\n# row = z (south), 1 cell = 1 m. `o` cells are shards and `P` is the start (legend markers,\n# read by starter.rs with `scenes::markers`); the slimes are [[npc]] entries the game drives.\n# Check it with `pav room_check path=crates/pav_core/src/games/starter.toml`.\n\nname = \"Starter\"\nabout = \"Collect every shard while slimes chase you.\"\nentrance = { at = [8, 12], facing = \"south\" }   # required by the format; the `P` marker is the start\n\n# The rules' numbers (starter.rs `Rules`). Running from the repository, `pav` reads this file at\n# each `load`: edit, then `load scene=starter` or `play bot=true seeds=10`, no rebuild.\n[game]\nlives = 3\nslime_speed = 0.5\nslime_sight = 9.0\ncatch = 0.8\npick = 0.9\ngrace = 2.0\n\n[camera]\ntilt = 58.0\ndistance = 17.0\n\n[layout]\norigin = [-9.0, 0.0, -6.5]\n\n[[layout.layer]]\ny = 0\nmap = '''\n##################\n#o......#.......o#\n#.......#........#\n#..##.......##...#\n#..#.........#...#\n#.......o........#\n#....#.....#.....#\n#.......P........#\n#..#.........#...#\n#..##.......##...#\n#.......#........#\n105:# prop = { ..., sway = \"leaves\" }   props (and [[object]]s) can sway: \"leaves\" | \"grass\"\n106-#\n107-# zone = { kind = \"...\", ... } makes the tile a trigger (identical neighbours merge):\n108-#   kind = \"start\" | \"finish\" | \"gate\" | \"checkpoint\" | \"kill\" | \"water\" | \"pad\" | \"camera\" |\n109-#          \"conveyor\" (facing = direction, speed = m/s; carries characters and props) |\n110-#          \"bounce\" (speed = launch m/s; trampolines for characters and props)\n111-#   course = \"name\"   start/finish/gates of one course share it; leaving START starts the timer,\n112-#                     gates must be passed in `index` order (missed gate = +2 s), FINISH stops it\n113-#   index = 1         gate order\n114-#   y0 = 0, y1 = 3    height range relative to the layer (kill zones in pits: e.g. y0 = -3, y1 = -1)\n115-#   label = \"TEXT\"    drawn on the floor (label_size = 0.5 to override the auto fit);\n116-#                     color = \"#rrggbb\" or \"none\"; facing = \"east\" (respawn direction)\n117-#   Zones are half-open boxes, so touching zones never overlap. A respawn point that lies in a\n118-#   zone does not trigger it (respawning onto START keeps the timer running).\n119-#   params = { \"movement.model\" = \"momentum\" }       pads: parameter changes until you leave\n120-#                     (\"view.bloom\" = 1.5 etc. change view settings the same way)\n121-#   signal = \"drop\"   pads: tells spawners listening for \"drop\" to fire\n122-#   note = \"...\"      pads: what it sets and what to look for (on screen while you stand on it;\n123-#                     required on every pad with params)\n124-#   camera = { set = { tilt = 90, ortho = true }, sweep = [{ param = \"tilt\", from = 90,\n125-#              to = 10, period = 12 }], flip_ortho = 6 }  pads (sticky) / camera zones (inside)\n126-#   water: swim below y1 (its surface ripples: a CPU wave simulation; neighbouring water tiles\n127-#   with the same top that form a rectangle ripple as one surface). kill: back to the last checkpoint.\n128-\n129-# Free text anywhere (layout space: x = column, y = height, z = row).\n130-# [[label]]\n--\n138:[[object]]\n139-name = \"ball\"\n140-shape = { type = \"sphere\", radius = 0.4 }\n141-pos = [3.5, 1.0, 3.5]           # x = column, y = height, z = row\n142-color = \"#5b8def\"\n143-body = \"dynamic\"                # dynamic | fixed | kinematic | none\n144-\n145-# Animated objects use body = \"kinematic\" and a behavior (vectors are in the object's own frame):\n146-#   behavior = { type = \"move\", offset = [0, 0, 4], period = 4, phase = 0, hold = 0.3, smooth = true }\n147-#     (hold = share of the cycle spent waiting, split between both ends)\n148-#   behavior = { type = \"rotate\", axis = [0, 1, 0], speed = 90 }                   (deg/s)\n149-#   behavior = { type = \"rotate\", axis = [1, 0, 0], swing = 60, period = 2, pivot = [0, 2, 0] }\n150-#   behavior = { type = \"spin\", speed = 1.5 }                                       (rad/s)\n151-# Projectile emitters (body = \"none\", or \"fixed\" with a slim shape; bullets ignore their emitter):\n152-#   behavior = { type = \"emitter\", pattern = \"aimed\", interval = 1.0, count = 1, spread = 0,\n153-#                speed = 6, radius = 0.15, height = 0, range = 30, delay = 0, burst = 0, pause = 1,\n154-#                color = \"#ff5a3c\", knockback = 6, gravity = 0, spin = 12, life = 6 }\n155-#     pattern: aimed (at the player) | forward (+Z of the object, see yaw) | ring | spiral | random\n156-# Touching a hazard knocks you back (respawn = true sends you to the last checkpoint):\n157-#   hazard = { knockback = 7, respawn = false }\n158-# Spawners drop props on a timer and/or when a pad sends their signal (body = \"none\"):\n159-#   behavior = { type = \"spawner\", shape = { type = \"box\", half = [0.3, 0.3, 0.3] }, color = \"\",\n160-#                count = 20, interval = 0, max = 200, area = [1.5, 0.5, 1.5], signal = \"drop\",\n161-#                clear = \"clear\", density = 1, friction = 0.5, restitution = 0.1, tumble = true }\n162-#     (pending = 1 drops one batch on the first tick, so the room starts with its props)\n163-# The store's catalogue (rooms/catalogue.toml; body = \"none\"): a pad's signal lays out the next","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AgzDZQYFMEGnix831V8quR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
