 preset files, with no\n//! string lookups in game code (values stay plain struct fields).\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(untagged)]\npub enum ParamValue {\n    Bool(bool),\n    Int(i64),\n    Float(f64),\n    Text(String),\n}\n\nimpl ParamValue {\n    pub fn as_f64(&self) -> Option<f64> {\n        match self {\n            ParamValue::Float(f) => Some(*f),\n            ParamValue::Int(i) => Some(*i as f64),\n            ParamValue::Bool(b) => Some(*b as i64 as f64),\n            ParamValue::Text(t) => t.parse().ok(),\n        }\n    }\n    pub fn as_bool(&self) -> Option<bool> {\n        match self {\n            ParamValue::Bool(b) => Some(*b),\n            ParamValue::Int(i) => Some(*i != 0),\n            ParamValue::Float(f) => Some(*f != 0.0),\n            ParamValue::Text(t) => match t.as_str() {\n                \"true\" | \"on\" | \"yes\" | \"1\" => Some(true),\n                \"false\" | \"off\" | \"no\" | \"0\" => Some(false),\n                _ => None,\n            },\n        }\n    }\n    pub fn from_json(v: &serde_json::Value) -> Option<Self> {\n        serde_json::from_value(v.clone()).ok()\n    }\n    pub fn to_json(&self) -> serde_json::Value {\n        serde_json::to_value(self).unwrap_or(serde_json::Value::Null)\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize)]\npub enum ParamKind {\n    Float { min: f32, max: f32 },\n    Int { min: i32, max: i32 },\n    Bool,\n    Choice { options: Vec<String> },\n}\n\n#[derive(Clone, Debug, Serialize)]\npub struct ParamInfo {\n    pub path: String,\n    pub kind: ParamKind,\n    pub value: ParamValue,\n    pub help: String,\n131:pub fn list(t: &mut dyn Tunable) -> Vec<ParamInfo> {\n132-    struct L {\n133-        p: PathTracker,\n134-        out: Vec<ParamInfo>,\n135-    }\n136-    impl ParamVisitor for L {\n137-        fn float(&mut self, name: &str, v: &mut f32, min: f32, max: f32, help