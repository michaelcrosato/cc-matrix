{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017zvccnA8wnrzqTRrFy7V49","type":"tool_result","content":"1000\t        let rewinding = game_input && self.studio_mode == StudioMode::World && self.input.rewind_held();\n1001\t        host.set_control(|c| c.rewinding = rewinding);\n1002\t\n1003\t        let (prev, curr, curr_at, tick_wall) = host.frames();\n1004\t        let studio_mode = curr.studio_mode();\n1005\t        let studio_active = curr.studio_active();\n1006\t        self.studio_navigation |= studio_active;\n1007\t        let snap_camera = studio_mode != self.studio_mode\n1008\t            || prev.studio_mode() != studio_mode\n1009\t            || prev.live_edit_ticket != curr.live_edit_ticket;\n1010\t        let game_input = game_input && !studio_active;\n1011\t        if studio_mode != self.studio_mode {\n1012\t            let keep_object_redo = studio_mode == StudioMode::World && self.asset_ui.open && self.asset_ui.creation_removed();\n1013\t            let keep_creature_redo =\n1014\t                studio_mode == StudioMode::World && self.creature_ui.open && self.creature_ui.creation_removed();\n1015\t            self.builder = ViewBuilder::new();\n1016\t            if let Some(gfx) = &mut self.gfx {\n1017\t                gfx.renderer.clear_particles();\n1018\t            }\n1019\t            self.studio_mode = studio_mode;\n1020\t            self.animation_ui.open = studio_mode == StudioMode::Animation;\n1021\t            self.asset_ui.open = studio_mode == StudioMode::Prop || keep_object_redo;\n1022\t            self.creature_ui.open = studio_mode == StudioMode::Creature || keep_creature_redo;\n1023\t        }\n1024\t        if !studio_active {\n1025\t            let room_before = self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def)));\n1026\t            let quarters = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n1027\t            self.director.update(&curr.hud, quarters, &mut self.rig);\n1028\t            let room_id_before = self.hud.current.as_ref().map(|r| r.id);\n1029\t            self.hud.update(&curr.room, &mut self.rig);\n1030\t            // Rooms and pads can change view settings (night lighting, bloom, filters).\n1031\t            let key = (curr.room.as_ref().map(|r| r.id), curr.hud.view_serial);\n1032\t            if key != self.view_key {\n1033\t                self.view_key = key;\n1034\t                if let Some(b) = self.view_base.take() {\n1035\t                    self.view = b;\n1036\t                }\n1037\t                let q = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n1038\t                let room = curr.room.as_ref().map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n1039\t                let pads = pav_view::build::room_view_map(&curr.hud.view, q);\n1040\t                if !room.is_empty() || !pads.is_empty() {\n1041\t                    self.view_base = Some(self.view.clone());\n1042\t                    for u in self.view.apply(&room).into_iter().chain(self.view.apply(&pads)) {\n1043\t                        log::warn!(\"unknown view setting '{u}'\");\n1044\t                    }\n1045\t                }\n1046\t            }\n1047\t            if self.hud.current.as_ref().map(|r| r.id) != room_id_before {\n1048\t                // Rooms can open HUD overlays (feel metrics) while you are inside.\n1049\t                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"feel\"));\n1050\t                if wants && !self.feel.open {\n1051\t                    self.feel.open = true;\n1052\t                    self.feel.auto = true;\n1053\t                } else if !wants && self.feel.auto {\n1054\t                    self.feel.open = false;\n1055\t                    self.feel.auto = false;\n1056\t                }\n1057\t                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"physics\"));\n1058\t                if wants && !self.physics.open {\n1059\t                    self.physics.open = true;\n1060\t                    self.physics.auto = true;\n1061\t                } else if !wants && self.physics.auto {\n1062\t                    self.physics.open = false;\n1063\t                    self.physics.auto = false;\n1064\t                }\n1065\t            }\n1066\t            self.feel.record(curr.tick, curr.hud.feel.speed);\n1067\t            if self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def))) != room_before {\n1068\t                // Input switching: the room's key overrides apply while inside.\n1069\t                let (b, errs) = match &self.hud.current {\n1070\t                    Some(r) => crate::input::Bindings::with_overrides(&r.def.keys),\n1071\t                    None if curr.game.is_some() => (crate::input::Bindings::game(), Vec::new()),\n1072\t                    None => (crate::input::Bindings::default(), Vec::new()),\n1073\t                };\n1074\t                self.input.bindings = b;\n1075\t                for e in errs {\n1076\t                    log::warn!(\"room keys: {e}\");\n1077\t                }\n1078\t            }\n1079\t            if *curr.config != self.sim_config && curr.tick > self.config_push_tick + 3 {\n1080\t                // The simulation changed its configuration (room overrides): adopt it.\n1081\t                self.sim_config = (*curr.config).clone();\n1082\t            }\n1083\t            // Entering or leaving Shardfall: its controls, camera and look.\n1084\t            let game_mode = curr.game.is_some();\n1085\t            if game_mode != self.input.game {\n1086\t                self.input.game = game_mode;\n1087\t                self.input.bindings = if game_mode { crate::input::Bindings::game() } else { crate::input::Bindings::default() };\n1088\t                self.rig.blend_from_current(0.5);\n1089\t                if game_mode {\n1090\t                    self.game_saved = Some((self.rig.params.clone(), self.view.clone()));\n1091\t                    self.rig.params = CameraParams {\n1092\t                        tilt: 56.0,\n1093\t                        yaw: 0.0,\n1094\t                        distance: 15.5,\n1095\t                        fov: 40.0,\n1096\t                        ortho: false,\n1097\t                        follow_lag: 0.06,\n1098\t                        height_offset: 0.8,\n1099\t                    };\n1100\t                    let v = &mut self.view;\n1101\t                    v.bloom = 0.55;\n1102\t                    v.bloom_threshold = 1.0;\n1103\t                    v.sky = \"#14161c\".into();\n1104\t                    v.light.sun_elevation = 52.0;\n1105\t                    v.light.sun_azimuth = 35.0;\n1106\t                    v.light.sun_intensity = 0.95;\n1107\t                    v.light.ambient = 0.5;\n1108\t                    v.saturation = 1.08;\n1109\t                    v.fog = false;\n1110\t                } else if let Some((cam, view)) = self.game_saved.take() {\n1111\t                    self.rig.params = cam;\n1112\t                    self.view = view;\n1113\t                }\n1114\t            }\n1115\t            self.game_frame = curr.game.clone();\n1116\t            if !game_mode {\n1117\t                self.game_ui.close_all();\n1118\t                self.game_place = None;\n1119\t            }\n1120\t            if let Some(g) = &curr.game {\n1121\t                if self.game_place != Some(g.place) {\n1122\t                    self.game_place = Some(g.place);\n1123\t                    self.arrival = Some(Instant::now());\n1124\t                    self.game_ui.panel = None;\n1125\t                    pav_view::arpg::place_look(g, &mut self.view);\n1126\t                }\n1127\t            }\n1128\t        } else {\n1129\t            self.game_frame = None;\n1130\t        }\n1131\t        let alpha = if self.app_settings.smoothing && !snap_camera {\n1132\t            ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0)\n1133\t        } else {\n1134\t            1.0\n1135\t        };\n1136\t        if snap_camera {\n1137\t            // A submitted edit must contain its new framing as well as its new geometry.\n1138\t            self.rig = CameraRig::new(self.rig.params.clone());\n1139\t            self.rig.snap(curr.focus);\n1140\t        }\n1141\t        let focus = prev.focus.lerp(curr.focus, alpha);\n1142\t        let player = curr.player.and_then(|id| curr.objects.iter().find(|o| o.id == id));\n1143\t        let feet = player.and_then(|p| p.puppet.as_ref().map(|pp| p.pos - Vec3::Y * pp.feet_offset)).unwrap_or(focus);\n1144\t        let facing = player.and_then(|p| p.puppet.as_ref().map(|pp| pp.state.facing)).unwrap_or(0.0);\n1145\t\n1146\t        // Game input -> the simulation thread.\n1147\t        let (w, h) = self.gfx.as_ref().unwrap().size();\n1148\t        let size = Vec2::new(w as f32, h as f32);\n1149\t        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n1150\t        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n1151\t        if over_ui {\n1152\t            self.input.mouse_taps.clear();\n1153\t        }\n1154\t        let (mut held, mut pressed) = self.input.buttons();\n1155\t        // Touch: the stick, the buttons and auto-attack.\n1156\t        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\n1157\t        let rig = &self.rig;\n1158\t        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\n1159\t        if game_input {\n1160\t            held |= intent.held;\n1161\t            pressed |= intent.pressed;\n1162\t        }\n1163\t        if pressed & pav_core::input::buttons::INTERACT != 0 {\n1164\t            if let Some(g) = &curr.game {\n1165\t                if let Some(c) = self.game_ui.interact(g) {\n1166\t                    host.shared.command(c);\n1167\t                }\n1168\t            }\n1169\t        }\n1170\t        if pressed != 0 && self.input.last_device == Device::Gamepad {\n1171\t            // Gamepad presses are timed from when they were polled (gilrs queues them).\n1172\t            self.latency.press();\n1173\t        }\n1174\t        let room_id = self.hud.current.as_ref().map(|r| r.id);\n1175\t        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n1176\t        if left_tap && !self.editor.on && game_input {\n1177\t            pressed |= pav_core::input::buttons::PRIMARY;\n1178\t        }\n1179\t        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\n1180\t            held &= !pav_core::input::buttons::PRIMARY;\n1181\t            pressed &= !pav_core::input::buttons::PRIMARY;\n1182\t        }\n1183\t        let aim = match self.input.last_device {\n1184\t            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\n1185\t            Device::Gamepad => {\n1186\t                let r = self.input.pad.right;\n1187\t                if r.length() > 0.2 {\n1188\t                    let d = self.rig.relative_move(r);\n1189\t                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\n1190\t                } else {\n1191\t                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\n1192\t                }\n1193\t            }\n1194\t            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\n1195\t        };\n1196\t        {\n1197\t            let mut i = host.shared.input.lock().unwrap();\n1198\t            if game_input {\n1199\t                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\n1200\t                i.move_dir = match intent.move_world {\n1201\t                    // Auto-attack stepping in to a foe (only while the stick is still).\n1202\t                    Some(m) if axis == Vec2::ZERO => m,\n1203\t                    _ => self.rig.relative_move(axis),\n1204\t                };\n1205\t                i.held = held;\n1206\t                i.pressed |= pressed;\n1207\t                i.aim = aim;\n1208\t                if let Some(t) = self.latency.pending.take() {\n1209\t                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n1210\t                }\n1211\t            } else {\n1212\t                *i = InputFrame::default();\n1213\t            }\n1214\t        }\n1215\t\n1216\t        self.rig.update(focus, dt);\n1217\t        self.builder.now = self.started.elapsed().as_secs_f64();\n1218\t        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n1219\t        let events = if studio_active { Vec::new() } else { events };\n1220\t        self.builder.add_events(&events);\n1221\t        // Save the hero on every arrival somewhere, and once a minute while playing.\n1222\t        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\n1223\t        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\n1224\t            self.last_save = Instant::now();\n1225\t            host.exec(|sim| crate::save::save_from(sim));\n1226\t        }\n1227\t        if let Some(a) = &self.audio {\n1228\t            let (_, right) = self.rig.ground_axes();\n1229\t            let l = pav_audio::Listener { pos: self.rig.target, right };\n1230\t            for e in &events {\n1231\t                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\n1232\t                    continue;\n1233\t                }\n1234\t                a.play_event(e, &l, self.audio_settings.sfx);\n1235\t            }\n1236\t        }\n1237\t        // The look layer (Look & Filters) over the scene's own settings.\n1238\t        let mut view = self.view.clone();\n1239\t        self.look_ui.apply(&mut view);\n1240\t        self.prefs.quality.trim(self.touch_screen, &mut view);\n1241\t        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n1242\t        // Arriving somewhere new: the screen opens with the chosen transition, on the player.\n1243\t        if let Some(t0) = self.arrival {\n1244\t            let t = t0.elapsed().as_secs_f32() / view.filter.transition_time.max(0.05);\n1245\t            match view.filter.transition.kind() {\n1246\t                Some(kind) if t < 1.0 => {\n1247\t                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\n1248\t                    scene.filter.transition_kind = kind;\n1249\t                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\n1250\t                }\n1251\t                _ => self.arrival = None,\n1252\t            }\n1253\t        }\n1254\t        if !studio_active {\n1255\t            self.editor.draw_preview(&mut scene);\n1256\t        }\n1257\t        if let Some(a) = intent.aiming.filter(|_| game_input) {\n1258\t            // A skill aimed by hand: a ring where it lands and dots on the way there.\n1259\t            let mark = |at: Vec3, s: f32, color: Vec3| MeshInstance {\n1260\t                mesh: MeshKey::Cylinder,\n1261\t                transform: Mat4::from_scale_rotation_translation(Vec3::new(s, 0.02, s), Quat::IDENTITY, at + Vec3::Y * 0.04),\n1262\t                color,\n1263\t                emissive: 0.6,\n1264\t                style: Style::Unlit,\n1265\t                flags: rflags::NO_SHADOW | rflags::NO_CUT,\n1266\t                group: 0,\n1267\t                material: 0,\n1268\t                ext: Vec3::ZERO,\n1269\t            };\n1270\t            let a = Vec3::new(a.x, feet.y, a.z);\n1271\t            scene.meshes.push(mark(a, 0.9, Vec3::new(1.0, 0.78, 0.4)));\n1272\t            let n = ((a - feet).length() / 0.8) as usize;\n1273\t            for k in 1..n {\n1274\t                scene.meshes.push(mark(feet.lerp(a, k as f32 / n as f32), 0.14, Vec3::new(1.0, 0.9, 0.7)));\n1275\t            }\n1276\t        }\n1277\t        if self.app_settings.aim_marker && game_input && curr.player.is_some() && !self.editor.on && curr.game.is_none() {\n1278\t            if let Some(a) = aim {\n1279\t                let d = Vec2::new(a.x - feet.x, a.z - feet.z);\n1280\t                let a = if d.length() > self.sim_config.bombs.throw_range {\n1281\t                    let d = d.normalize() * self.sim_config.bombs.throw_range;\n1282\t                    Vec3::new(feet.x + d.x, a.y, feet.z + d.y)\n1283\t                } else {\n1284\t                    a\n1285\t                };\n1286\t                scene.meshes.push(MeshInstance {\n1287\t                    mesh: MeshKey::Cylinder,\n1288\t                    transform: Mat4::from_scale_rotation_translation(\n1289\t                        Vec3::new(0.5, 0.02, 0.5),\n1290\t                        Quat::IDENTITY,\n1291\t                        a + Vec3::Y * 0.03,\n1292\t                    ),\n1293\t                    color: Vec3::new(1.0, 0.95, 0.7),\n1294\t                    emissive: 0.0,\n1295\t                    style: Style::Unlit,\n1296\t                    flags: rflags::NO_SHADOW | rflags::NO_CUT,\n1297\t                    group: 0,\n1298\t                    material: 0,\n1299\t                    ext: Vec3::ZERO,\n1300\t                });\n1301\t            }\n1302\t        }\n1303\t\n1304\t        // UI.\n1305\t        let stats = *host.shared.stats.lock().unwrap();\n1306\t        let mut ctl = host.control();\n1307\t        let ctl_before = ctl;\n1308\t        let crash = host.shared.crashed.lock().unwrap().clone();\n1309\t        self.panel.record_timing(dt * 1000.0, stats.tick_ms);\n1310\t        let gfx = self.gfx.as_mut().unwrap();\n1311\t        let (render_scale, lights) =\n1312\t            self.scaler.update(self.prefs.quality, self.touch_screen, dt * 1000.0, gfx.size(), gfx.window.scale_factor() as f32);\n1313\t        gfx.renderer.render_scale = render_scale;\n1314\t        gfx.renderer.max_shadow_lights = lights;\n1315\t        let info = ui::OverlayInfo {\n1316\t            fps: self.fps.fps,\n1317\t            frame_ms: self.fps.frame_ms,\n1318\t            tps: stats.tps,\n1319\t            tick_ms: stats.tick_ms,\n1320\t            tick: stats.tick,\n1321\t            entities: stats.entities,\n1322\t            gpu_errors: gfx.gpu_errors.load(std::sync::atomic::Ordering::Relaxed),\n1323\t            adapter: &gfx.adapter_name,\n1324\t            crash: crash.clone(),\n1325\t            paused: ctl.paused,\n1326\t            speed: ctl.speed,\n1327\t            rewinding,\n1328\t            render_scale,\n1329\t        };\n1330\t        if let Some(t) = self.boot_done_at {\n1331\t            if t.elapsed().as_secs_f32() > 10.0 && self.show_boot {\n1332\t                self.show_boot = false;\n1333\t                self.boot_done_at = None;\n1334\t            }\n1335\t        }\n1336\t        let toast = self.toast.as_ref().filter(|(_, t)| t.elapsed().as_secs_f32() < 3.0).map(|(m, _)| m.clone());\n1337\t        let card_visible = !studio_active && self.hud.card_visible();\n1338\t        let guide_visible =\n1339\t            !studio_active && self.app_settings.show_guide && self.started.elapsed().as_secs_f32() < 25.0 && !card_visible;\n1340\t        let device = self.input.last_device;\n1341\t        let touch_ui = device == Device::Touch;\n1342\t        if touch_ui != self.touch_styled {\n1343\t            self.touch_styled = touch_ui;\n1344\t            pav_ui::touch_style(&self.egui_ctx, touch_ui);\n1345\t        }\n1346\t        self.game_ui.touch = touch_ui;\n1347\t        self.game_ui.tree.touch = touch_ui;\n1348\t        self.touch.swipes.begin_frame();\n1349\t        let touch = &mut self.touch;\n1350\t        let auto_attack = self.prefs.auto_attack;\n1351\t        let tips = touch_ui && !self.prefs.tips_seen && self.started.elapsed().as_secs_f32() < 45.0;\n1352\t        let mut prefs = self.prefs.clone();\n1353\t        let portal = self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town);\n1354\t        let state = self.egui_state.as_mut().unwrap();\n1355\t        let mut raw = state.take(&gfx.window);\n1356\t        raw.events.append(&mut self.pad_events);\n1357\t        let pad_cursor = self.pad_cursor;\n1358\t        let mut show_boot = self.show_boot;\n1359\t        let menu_open = self.menu_open;\n1360\t        let scene_name = self.scene_name.clone();\n1361\t        let mut menu_action = None;\n1362\t        let mut panel_actions = Vec::new();\n1363\t        let mut teleport = None;\n1364\t        let mut save_room = false;\n1365\t        let room_name = self.hud.current.as_ref().map(|r| r.key.clone());\n1366\t        let editor = &mut self.editor;\n1367\t        let hud = &mut self.hud;\n1368\t        let config_before = self.sim_config.clone();\n1369\t        let app_before = self.app_settings.clone();\n1370\t        let panel = &mut self.panel;\n1371\t        let master_before = self.audio_settings.master;\n1372\t        let view_proj = self.rig.view_proj(w as f32 / h.max(1) as f32);\n1373\t        let mut root = Root {\n1374\t            sim: &mut self.sim_config,\n1375\t            camera: &mut self.rig.params,\n1376\t            view: &mut self.view,\n1377\t            app: &mut self.app_settings,\n1378\t            audio: &mut self.audio_settings,\n1379\t        };\n1380\t        let show_stats = root.app.show_stats;\n1381\t        let feel = &mut self.feel;\n1382\t        let physics = &mut self.physics;\n1383\t        let latency = &self.latency;\n1384\t        let hud_ctx = HudCtx { hud: &curr.hud, tick: curr.tick, dt: curr.dt };\n1385\t        let game_frame = curr.game.clone();\n1386\t        let game_ui = &mut self.game_ui;\n1387\t        let look_ui = &mut self.look_ui;\n1388\t        let animation_ui = &mut self.animation_ui;\n1389\t        let asset_ui = &mut self.asset_ui;\n1390\t        let creature_ui = &mut self.creature_ui;\n1391\t        let studio_navigation = self.studio_navigation;\n1392\t        let mut creature_commands = Vec::new();\n1393\t        let mut animation_commands = Vec::new();\n1394\t        let mut asset_commands = Vec::new();\n1395\t        let mut studio_target = None;\n1396\t        #[cfg(not(target_arch = \"wasm32\"))]\n1397\t        let animation_bridge = self.bridge.as_ref().map(|b| b.addr.as_str());\n1398\t        #[cfg(target_arch = \"wasm32\")]\n1399\t        let animation_bridge: Option<&str> = None;\n1400\t        #[cfg(not(target_arch = \"wasm32\"))]\n1401\t        let creature_feedback =\n1402\t            self.bridge.as_ref().and_then(|bridge| bridge.feedback.lock().ok().map(|feedback| feedback.status(None)));\n1403\t        #[cfg(target_arch = \"wasm32\")]\n1404\t        let creature_feedback: Option<serde_json::Value> = None;\n1405\t        let mut look_msg = None;\n1406\t        let guide = &mut self.guide;\n1407\t        let mut guide_out = Vec::new();\n1408\t        let mut game_cmds = Vec::new();\n1409\t        let out = self.egui_ctx.run_ui(raw, |ui| {\n1410\t            let ctx = ui.ctx().clone();\n1411\t            if let Some(c) = &info.crash {\n1412\t                ui::crash_banner(ui, c);\n1413\t            }\n1414\t            panel_actions = panel.ui(ui, &mut root, &mut ctl, &stats);\n1415\t            let free = ui.available_rect_before_wrap();\n1416\t            ui::boot_panel(&ctx, &mut show_boot);\n1417\t            if show_stats {\n1418\t                ui::stats_panel(&ctx, &info, free, touch_ui);\n1419\t            }\n1420\t            if guide_visible && !menu_open && !touch_ui {\n1421\t                ui::guide_panel(&ctx, device, game_frame.is_some());\n1422\t            }\n1423\t            if let Some(g) = &game_frame {\n1424\t                let proj = crate::arpg_ui::Projector { vp: view_proj, size: ctx.content_rect().size() };\n1425\t                crate::arpg_ui::hud(&ctx, g, &proj, device, game_ui.map, &mut touch.swipes);\n1426\t                if !menu_open {\n1427\t                    game_cmds = game_ui.ui(&ctx, g, &proj);\n1428\t                }\n1429\t            }\n1430\t            if touch_ui {\n1431\t                let map_hidden = touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n1432\t                let covered = menu_open || game_ui.any_open() || look_ui.open || guide.station || guide.field;\n1433\t                let points = game_frame.as_ref().and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n1434\t                touch.draw(&ctx, &crate::touch::View { game: game_frame.as_deref(), auto_attack, map_hidden, points, covered });\n1435\t                if tips && !covered {\n1436\t                    ui::touch_tips(&ctx, game_frame.is_some(), &mut touch.swipes);\n1437\t                }\n1438\t            }\n1439\t            if card_visible && !menu_open && hud.card(&ctx, device) {\n1440\t                guide.station = true;\n1441\t            }\n1442\t            if !menu_open {\n1443\t                crate::guide_ui::pad_note(&ctx, hud_ctx.hud, hud_ctx.tick, hud_ctx.dt, touch_ui.then_some(&mut touch.swipes));\n1444\t            }\n1445\t            crate::hud::course_hud(&ctx, &hud_ctx);\n1446\t            pav_ui::game_lines(&ctx, hud_ctx.hud);\n1447\t            if let Some(p) = pad_cursor {\n1448\t                // The gamepad's menu cursor, above everything.\n1449\t                let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new(\"pad_cursor\")));\n1450\t                let tip = egui::Pos2::new(p.x, p.y);\n1451\t                let pts = vec![tip, tip + egui::vec2(0.0, 22.0), tip + egui::vec2(6.0, 16.5), tip + egui::vec2(15.0, 16.0)];\n1452\t                painter.add(egui::Shape::convex_polygon(\n1453\t                    pts,\n1454\t                    egui::Color32::from_rgb(255, 225, 150),\n1455\t                    egui::Stroke::new(1.5, egui::Color32::BLACK),\n1456\t                ));\n1457\t            }\n1458\t            physics.ui(&ctx, &hud_ctx, stats.tps, stats.tick_ms);\n1459\t            crate::hud::hit_flash(&ctx, hud_ctx.hud.invuln);\n1460\t            feel.ui(\n1461\t                &ctx,\n1462\t                &hud_ctx,\n1463\t                latency,\n1464\t                FeelSettings {\n1465\t                    model: &mut root.sim.movement.model,\n1466\t                    tick_rate: &mut root.sim.tick_rate,\n1467\t                    vsync: &mut root.app.vsync,\n1468\t                    smoothing: &mut root.app.smoothing,\n1469\t                },\n1470\t            );\n1471\t            teleport = hud.teleport_menu(&ctx);\n1472\t            hud.error_panel(&ctx);\n1473\t            if !studio_active {\n1474\t                save_room = editor.ui(&ctx, room_name.as_deref());\n1475\t            }\n1476\t            look_msg = look_ui.window(&ctx, root.view);\n1477\t            if studio_navigation || studio_active || animation_ui.open || asset_ui.open || creature_ui.open {\n1478\t                egui::Window::new(\"Studio workspace\")\n1479\t                    .id(egui::Id::new(\"studio_navigation\"))\n1480\t                    .title_bar(false)\n1481\t                    .resizable(false)\n1482\t                    .fixed_pos([16.0, 8.0])\n1483\t                    .show(&ctx, |ui| {\n1484\t                        ui.horizontal(|ui| {\n1485\t                            ui.strong(\"SHARDFALL STUDIO\");\n1486\t                            for (mode, label) in [\n1487\t                                (StudioMode::Animation, \"Animations\"),\n1488\t                                (StudioMode::Prop, \"Objects\"),\n1489\t                                (StudioMode::Creature, \"Creatures\"),\n1490\t                                (StudioMode::World, \"Game\"),\n1491\t                            ] {\n1492\t                                let panel_open = animation_ui.open || asset_ui.open || creature_ui.open;\n1493\t                                let reopen = match mode {\n1494\t                                    StudioMode::World => panel_open,\n1495\t                                    StudioMode::Animation => !animation_ui.open,\n1496\t                                    StudioMode::Prop => !asset_ui.open,\n1497\t                                    StudioMode::Creature => !creature_ui.open,\n1498\t                                };\n1499\t                                if ui.selectable_label(studio_mode == mode, label).clicked() && (studio_mode != mode || reopen) {\n1500\t                                    studio_target = Some(mode);\n1501\t                                }\n1502\t                            }\n1503\t                        });\n1504\t                    });\n1505\t            }\n1506\t            if matches!(studio_mode, StudioMode::Animation | StudioMode::World) {\n1507\t                animation_commands = animation_ui.window(&ctx, curr.animation_preview.as_ref(), animation_bridge);\n1508\t            }\n1509\t            if matches!(studio_mode, StudioMode::Prop | StudioMode::World) {\n1510\t                asset_commands = asset_ui.window(&ctx, &curr, animation_bridge);\n1511\t            }\n1512\t            if matches!(studio_mode, StudioMode::Creature | StudioMode::World) {\n1513\t                creature_commands = creature_ui.window(&ctx, &curr, animation_bridge, creature_feedback.as_ref());\n1514\t            }\n1515\t            let here = hud.current.clone();\n1516\t            guide_out.extend(guide.station(&ctx, here.as_ref(), &mut root));\n1517\t            guide_out.extend(guide.field_guide(&ctx, &hud.entries));\n1518\t            if menu_open {\n1519\t                let difficulty = game_frame.is_some().then_some(&mut root.sim.difficulty);\n1520\t                menu_action = if touch_ui {\n1521\t                    let show_fps = &mut root.app.show_stats;\n1522\t                    let m = ui::TouchMenu { prefs: &mut prefs, show_fps, difficulty, portal, scale: render_scale };\n1523\t                    ui::touch_menu(&ctx, &scene_name, m)\n1524\t                } else {\n1525\t                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\n1526\t                };\n1527\t            }\n1528\t            if let Some(t) = &toast {\n1529\t                if touch_ui {\n1530\t                    ui::toast_touch(&ctx, t, &mut touch.swipes);\n1531\t                } else {\n1532\t                    ui::toast(&ctx, t);\n1533\t                }\n1534\t            }\n1535\t            if !touch_ui {\n1536\t                const GAME_KEYS: &str =\n1537\t                    \"Esc menu · I inventory · P passives · C character · K skills · T town · G use · Space dodge · 1 potion\";\n1538\t                ui::hint_bar(\n1539\t                    &ctx,\n1540\t                    match (device, game_frame.is_some()) {\n1541\t                        (Device::Gamepad, _) => \"Start: menu\",\n1542\t                        (_, true) => GAME_KEYS,\n1543\t                        _ => \"Esc menu · F1 tuning · F2 rooms · F12 screenshot\",\n1544\t                    },\n1545\t                );\n1546\t            }\n1547\t        });\n1548\t        if prefs != self.prefs {\n1549\t            self.prefs = prefs;\n1550\t            crate::save::save_prefs(&self.prefs);\n1551\t        }\n1552\t        // The map: a tap on the minimap opens the big one; a tap or a swipe closes that.\n1553\t        let sw = &mut self.touch.swipes;\n1554\t        if sw.take_tap(egui::Id::new(\"minimap\")) {\n1555\t            self.game_ui.map = true;\n1556\t        }\n1557\t        let big = egui::Id::new(\"big_map\");\n1558\t        if sw.take_tap(big) || sw.is_gone(big, 0) {\n1559\t            self.game_ui.map = false;\n1560\t            sw.restore(big);\n1561\t        }\n1562\t        if !self.prefs.tips_seen && sw.is_gone(egui::Id::new(\"touch_tips\"), 0) {\n1563\t            self.prefs.tips_seen = true;\n1564\t            crate::save::save_prefs(&self.prefs);\n1565\t        }\n1566\t        self.show_boot = show_boot;\n1567\t        for a in guide_out {\n1568\t            match a {\n1569\t                crate::guide_ui::GuideAction::Go(key) => teleport = Some(crate::rooms::TeleportTarget::Room(key)),\n1570\t                crate::guide_ui::GuideAction::Toast(m) => self.toast = Some((m, Instant::now())),\n1571\t            }\n1572\t        }\n1573\t        if let Some(m) = look_msg {\n1574\t            self.toast = Some((m, Instant::now()));\n1575\t        }\n1576\t        self.look_ui.save_if_dirty(false);\n1577\t        for c in game_cmds {\n1578\t            host.shared.command(c);\n1579\t        }\n1580\t        if ctl.paused != ctl_before.paused\n1581\t            || ctl.speed != ctl_before.speed\n1582\t            || ctl.step_requests != ctl_before.step_requests\n1583\t            || ctl.rewind_speed != ctl_before.rewind_speed\n1584\t        {\n1585\t            let c = ctl;\n1586\t            host.set_control(|x| {\n1587\t                x.paused = c.paused;\n1588\t                x.speed = c.speed;\n1589\t                x.step_requests = c.step_requests;\n1590\t                x.rewind_speed = c.rewind_speed;\n1591\t            });\n1592\t        }\n1593\t        if self.sim_config != config_before {\n1594\t            let cfg = self.sim_config.clone();\n1595\t            host.exec(move |sim| sim.config = cfg);\n1596\t            self.config_push_tick = stats.tick.max(curr.tick);\n1597\t        }\n1598\t        if self.app_settings.vsync != app_before.vsync {\n1599\t            gfx.set_vsync(self.app_settings.vsync);\n1600\t        }\n1601\t        if self.audio_settings.master != master_before {\n1602\t            if let Some(a) = &self.audio {\n1603\t                a.set_master(self.audio_settings.master);\n1604\t            }\n1605\t        }\n1606\t        state.platform_output(&gfx.window, out.platform_output);\n1607\t        let ppp = out.pixels_per_point;\n1608\t        let prims = self.egui_ctx.tessellate(out.shapes, ppp);\n1609\t        let mut textures = out.textures_delta;\n1610\t\n1611\t        #[cfg(target_arch = \"wasm32\")]\n1612\t        if self.screenshot_requested {\n1613\t            // Reading pixels back waits on the GPU, which the browser does not allow here.\n1614\t            self.screenshot_requested = false;\n1615\t            self.toast = Some((\"screenshots are not available in the browser\".into(), Instant::now()));\n1616\t        }\n1617\t        #[cfg(not(target_arch = \"wasm32\"))]\n1618\t        if self.screenshot_requested {\n1619\t            self.screenshot_requested = false;\n1620\t            let (w, h) = gfx.size();\n1621\t            let dir = boot::exe_dir().join(\"screenshots\");\n1622\t            let path = dir.join(format!(\n1623\t                \"shardfall-{}.png\",\n1624\t                web_time::SystemTime::now().duration_since(web_time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)\n1625\t            ));\n1626\t            let r = pav_render::capture::render_to_rgba(&mut gfx.renderer, &scene, w, h)\n1627\t                .and_then(|px| pav_render::capture::save_png(&path, w, h, &px));\n1628\t            self.toast = Some((\n1629\t                match r {\n1630\t                    Ok(_) => format!(\"screenshot saved: {}\", path.display()),\n1631\t                    Err(e) => format!(\"screenshot failed: {e:#}\"),\n1632\t                },\n1633\t                Instant::now(),\n1634\t            ));\n1635\t        }\n1636\t\n1637\t        let first = self.boot_done_at.is_none()\n1638\t            && boot::diag().stages.lock().map(|s| !s.iter().any(|s| s.name == \"first frame\")).unwrap_or(false);\n1639\t        let submitted = if first {\n1640\t            let submitted = stage(\"first frame\", || {\n1641\t                let submitted = gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\n1642\t                Ok((submitted, format!(\"{} meshes, {} sdf\", gfx.renderer.stats.mesh_instances, gfx.renderer.stats.sdf_instances)))\n1643\t            });\n1644\t            self.boot_done_at = Some(Instant::now());\n1645\t            log::info!(\"boot complete in {:.0} ms\", boot::diag().start.elapsed().as_secs_f64() * 1000.0);\n1646\t            submitted.unwrap_or(false)\n1647\t        } else {\n1648\t            gfx.draw(&scene, Some((&prims, &mut textures, ppp)))\n1649\t        };\n1650\t        #[cfg(not(target_arch = \"wasm32\"))]\n1651\t        if submitted {\n1652\t            if let Some(bridge) = &self.bridge {\n1653\t                bridge.submitted(curr.live_edit_ticket);\n1654\t            }\n1655\t        }\n1656\t        // Input latency: the frame showing the tick that consumed a press is now submitted.\n1657\t        if submitted {\n1658\t            let mut probe = host.shared.latency_probe.lock().unwrap();\n1659\t            if let Some((pressed_at, ticked_at, tick)) = *probe {\n1660\t                if curr.tick >= tick {\n1661\t                    let now = Instant::now();\n1662\t                    self.latency.record(LatencySample {\n1663\t                        to_tick: (ticked_at - pressed_at).as_secs_f32() * 1000.0,\n1664\t                        to_screen: (now - ticked_at).as_secs_f32() * 1000.0,\n1665\t                    });\n1666\t                    *probe = None;\n1667\t                }\n1668\t            }\n1669\t        }\n1670\t\n1671\t        for a in panel_actions {\n1672\t            self.panel_action(a);\n1673\t        }\n1674\t        if let Some(t) = teleport {\n1675\t            self.teleport(t);\n1676\t        }\n1677\t        if save_room {\n1678\t            if let (Some(host), Some(id)) = (&self.host, room_id) {\n1679\t                let msg = match crate::edit::save_room(host, id) {\n1680\t                    Ok(p) => format!(\"saved {}\", p.display()),\n1681\t                    Err(e) => format!(\"save failed: {e:#}\"),\n1682\t                };\n1683\t                self.editor.status = msg.clone();\n1684\t                self.toast(msg);\n1685\t                if self.watcher.is_none() {\n1686\t                    self.watcher = RoomWatcher::start();\n1687\t                }\n1688\t            }\n1689\t        }\n1690\t        if self.watcher.as_mut().is_some_and(|w| w.poll()) {\n1691\t            self.reload_rooms();\n1692\t        }\n1693\t        if studio_active {\n1694\t            self.ensure_animation_watcher();\n1695\t        }\n1696\t        let animation_updates = self.animation_watcher.as_mut().map(|w| w.poll()).unwrap_or_default();\n1697\t        for update in animation_updates {\n1698\t            match update {\n1699\t                Ok(message) => {\n1700\t                    log::info!(\"{message}\");\n1701\t                    self.animation_ui.status = message;\n1702\t                    self.animation_ui.error = false;\n1703\t                }\n1704\t                Err(error) => {\n1705\t                    log::warn!(\"animation reload: {error}\");\n1706\t                    self.animation_ui.report(Err(error));\n1707\t                }\n1708\t            }\n1709\t        }\n1710\t        for command in animation_commands {\n1711\t            self.studio_command(command);\n1712\t        }\n1713\t        for command in asset_commands {\n1714\t            self.studio_command(command);\n1715\t        }\n1716\t        for command in creature_commands {\n1717\t            self.studio_command(command);\n1718\t        }\n1719\t        for result in self.creature_watcher.poll() {\n1720\t            self.creature_ui.report(result);\n1721\t        }\n1722\t        self.poll_creature_updates();\n1723\t        for update in self.asset_watcher.poll() {\n1724\t            match update {\n1725\t                Ok((name, definition)) => {\n1726\t                    self.asset_ui.status = format!(\"Reloaded {name}\");\n1727\t                    self.asset_ui.error = false;\n1728\t                    #[cfg(not(target_arch = \"wasm32\"))]\n1729\t                    let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1730\t                    #[cfg(target_arch = \"wasm32\")]\n1731\t                    let feedback: Option<pav_tools::live_feedback::SharedFeedback> = None;\n1732\t                    if let Some(host) = &self.host {\n1733\t                        let _ticket = host.query(move |sim| {\n1734\t                            let started = feedback.as_ref().map(|_| std::time::Instant::now());\n1735\t                            if !crate::asset_watch::apply_update(sim, &name, definition) {\n1736\t                                return None;\n1737\t                            }\n1738\t                            if let Some(feedback) = feedback {\n1739\t                                if let Ok(mut feedback) = feedback.lock() {\n1740\t                                    let note = feedback.accepted(\"asset_file_reload\", started.unwrap());\n1741\t                                    sim.live_edit_ticket = note[\"ticket\"].as_u64().unwrap_or_default();\n1742\t                                }\n1743\t                            }\n1744\t                            Some(sim.live_edit_ticket)\n1745\t                        });\n1746\t                        #[cfg(not(target_arch = \"wasm32\"))]\n1747\t                        if let (Some(bridge), Some(ticket)) = (&self.bridge, _ticket.flatten()) {\n1748\t                            bridge.adopted(ticket);\n1749\t                        }\n1750\t                    }\n1751\t                }\n1752\t                Err(error) => {\n1753\t                    log::warn!(\"object reload: {error}\");\n1754\t                    self.asset_ui.report(Err(error));\n1755\t                }\n1756\t            }\n1757\t        }\n1758\t        if let Some(mode) = studio_target {\n1759\t            self.switch_studio(mode);\n1760\t        }\n1761\t        if let Some(a) = menu_action {\n1762\t            self.menu_action(a);\n1763\t        }\n1764\t        // Touch: the bag, the menu, the map button, and taps on the open game.\n1765\t        for c in &intent.ui {\n1766\t            match c {\n1767\t                crate::touch::Control::Bag => {\n1768\t                    let ui = &mut self.game_ui;\n1769\t                    if ui.any_open() {\n1770\t                        ui.close_all();\n1771\t                    } else {\n1772\t                        ui.inventory = true;\n1773\t                    }\n1774\t                }\n1775\t                crate::touch::Control::Menu => {\n1776\t                    let open = !self.menu_open;\n1777\t                    self.set_menu(open);\n1778\t                }\n1779\t                crate::touch::Control::Map => self.touch.swipes.restore(egui::Id::new(\"minimap\")),\n1780\t                _ => {}\n1781\t            }\n1782\t        }\n1783\t        if intent.world_tap {\n1784\t            self.close_on_tap();\n1785\t        }\n1786\t    }\n1787\t\n1788\t    fn panel_action(&mut self, a: PanelAction) {\n1789\t        let Some(host) = &self.host else { return };\n1790\t        let dir = boot::exe_dir();\n1791\t        match a {\n1792\t            PanelAction::Reset => self.reset(),\n1793\t            PanelAction::Scrub(t) => host.set_control(|c| {\n1794\t                c.paused = true;\n1795\t                c.scrub = Some(t);\n1796\t            }),\n1797\t            PanelAction::SaveSnapshot => {\n1798\t                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n1799\t                let r = host.query(move |sim| sim.save_state(&path).map(|_| path.display().to_string()));\n1800\t                match r {\n1801\t                    Some(Ok(p)) => self.toast(format!(\"snapshot saved: {p}\")),\n1802\t                    Some(Err(e)) => self.toast(format!(\"snapshot failed: {e:#}\")),\n1803\t                    None => self.toast(\"snapshot timed out\"),\n1804\t                }\n1805\t            }\n1806\t            PanelAction::LoadSnapshot => {\n1807\t                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n1808\t                let r = host.query(move |sim| sim.load_state(&path));\n1809\t                match r {\n1810\t                    Some(Ok(())) => self.toast(\"snapshot loaded\"),\n1811\t                    Some(Err(e)) => self.toast(format!(\"load failed: {e:#}\")),\n1812\t                    None => self.toast(\"load timed out\"),\n1813\t                }\n1814\t            }\n1815\t            PanelAction::SaveReplay => {\n1816\t                let path = dir.join(\"replays\").join(\"last.replay.json\");\n1817\t                let r = host.query(move |sim| -> Result<String> {\n1818\t                    let mut rep = sim.recording.clone();\n1819\t                    rep.final_hash = Some(format!(\"{:016x}\", sim.state_hash()));\n1820\t                    std::fs::create_dir_all(path.parent().unwrap())?;\n1821\t                    std::fs::write(&path, serde_json::to_string(&rep)?)?;\n1822\t                    Ok(path.display().to_string())\n1823\t                });\n1824\t                match r {\n1825\t                    Some(Ok(p)) => self.toast(format!(\"replay saved: {p}\")),\n1826\t                    Some(Err(e)) => self.toast(format!(\"replay failed: {e:#}\")),\n1827\t                    None => self.toast(\"replay timed out\"),\n1828\t                }\n1829\t            }\n1830\t            PanelAction::Look => self.look_ui.open = true,\n1831\t            PanelAction::Status(s) => {\n1832\t                self.panel.status(s.clone());\n1833\t                self.toast(s);\n1834\t            }\n1835\t        }\n1836\t    }\n1837\t\n1838\t    /// Use the registered tools for UI edits too. This keeps validation, undo, and\n1839\t    /// persistence identical for a user and an LLM.\n1840\t    fn studio_command(&mut self, command: crate::animation_ui::Command) {\n1841\t        let Some(host) = &self.host else { return };\n1842\t        let asset = command.tool.starts_with(\"asset\");\n1843\t        let creature = command.tool.starts_with(\"creature\");\n1844\t        #[cfg(not(target_arch = \"wasm32\"))]\n1845\t        if let Some(bridge) = &self.bridge {\n1846\t            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n1847\t                Ok(Some(look)) => self.look_ui.set_look(look),\n1848\t                Ok(None) => {}\n1849\t                Err(error) => {\n1850\t                    let message = format!(\"The previous live edit is still pending: {error:#}\");\n1851\t                    if creature {\n1852\t                        self.creature_ui.report(Err(message));\n1853\t                    } else if asset {\n1854\t                        self.asset_ui.report(Err(message));\n1855\t                    } else {\n1856\t                        self.animation_ui.report(Err(message));\n1857\t                    }\n1858\t                    return;\n1859\t                }\n1860\t            }\n1861\t        }\n1862\t        let rig = self.rig.clone();\n1863\t        let view = self.view.clone();\n1864\t        let look = self.look_ui.look().clone();\n1865\t        #[cfg(not(target_arch = \"wasm32\"))]\n1866\t        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1867\t        #[cfg(target_arch = \"wasm32\")]\n1868\t        let feedback = None;\n1869\t        let reply = host.query(move |sim| {\n1870\t            let live = std::mem::replace(sim, Sim::empty(1));\n1871\t            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n1872\t            session.look = look;\n1873\t            session.feedback = feedback;\n1874\t            let result = pav_tools::tools::call(&mut session, command.tool, &command.args)\n1875\t                .map(|out| match out {\n1876\t                    pav_tools::Output::Json(v) => v,\n1877\t                    pav_tools::Output::Image { meta, .. } => meta,\n1878\t                })\n1879\t                .map_err(|e| format!(\"{e:#}\"));\n1880\t            let (live, rig, view, _) = session.into_live();\n1881\t            let ticket = live.live_edit_ticket;\n1882\t            *sim = live;\n1883\t            (result, rig, view, ticket)\n1884\t        });\n1885\t        let result = match reply {\n1886\t            Some((result, rig, view, _ticket)) => {\n1887\t                self.rig = rig;\n1888\t                self.view = view;\n1889\t                #[cfg(not(target_arch = \"wasm32\"))]\n1890\t                if let Some(bridge) = &self.bridge {\n1891\t                    bridge.adopted(_ticket);\n1892\t                }\n1893\t                result\n1894\t            }\n1895\t            None => Err(\"The studio command did not answer. Check the game log.\".into()),\n1896\t        };\n1897\t        if creature {\n1898\t            self.creature_ui.report_command(result);\n1899\t        } else if asset {\n1900\t            self.asset_ui.report(result);\n1901\t        } else {\n1902\t            self.animation_ui.report(result);\n1903\t        }\n1904\t        self.ensure_animation_watcher();\n1905\t    }\n1906\t\n1907\t    /// Adopt completed jobs on the live simulation thread, with the bridge camera current.\n1908\t    fn poll_creature_updates(&mut self) {\n1909\t        if !pav_tools::creature_tools::has_updates() {\n1910\t            return;\n1911\t        }\n1912\t        let Some(host) = &self.host else { return };\n1913\t        #[cfg(not(target_arch = \"wasm32\"))]\n1914\t        if let Some(bridge) = &self.bridge {\n1915\t            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n1916\t                Ok(Some(look)) => self.look_ui.set_look(look),\n1917\t                Ok(None) => {}\n1918\t                Err(_) => return,\n1919\t            }\n1920\t        }\n1921\t        let rig = self.rig.clone();\n1922\t        let view = self.view.clone();\n1923\t        let look = self.look_ui.look().clone();\n1924\t        #[cfg(not(target_arch = \"wasm32\"))]\n1925\t        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1926\t        #[cfg(target_arch = \"wasm32\")]\n1927\t        let feedback = None;\n1928\t        if let Some((reports, rig, view, ticket)) = host.query(move |sim| {\n1929\t            let live = std::mem::replace(sim, Sim::empty(1));\n1930\t            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n1931\t            session.look = look;\n1932\t            session.feedback = feedback;\n1933\t            let reports = pav_tools::creature_tools::poll(&mut session);\n1934\t            let (live, rig, view, _) = session.into_live();\n1935\t            let ticket = live.live_edit_ticket;\n1936\t            *sim = live;\n1937\t            (reports, rig, view, ticket)\n1938\t        }) {\n1939\t            self.rig = rig;\n1940\t            self.view = view;\n1941\t            #[cfg(not(target_arch = \"wasm32\"))]\n1942\t            if let Some(bridge) = &self.bridge {\n1943\t                bridge.adopted(ticket);\n1944\t            }\n1945\t            #[cfg(target_arch = \"wasm32\")]\n1946\t            let _ = ticket;\n1947\t            for report in reports {\n1948\t                self.creature_ui.report(Ok(report));\n1949\t            }\n1950\t        }\n1951\t    }\n1952\t\n1953\t    fn switch_studio(&mut self, mode: StudioMode) {\n1954\t        self.studio_navigation = true;\n1955\t        self.set_menu(false);\n1956\t        #[cfg(not(target_arch = \"wasm32\"))]\n1957\t        if mode != StudioMode::World {\n1958\t            if mode == StudioMode::Animation {\n1959\t                if let Err(error) = pav_tools::animation_tools::reload_authored() {\n1960\t                    self.animation_ui.report(Err(format!(\"Could not load saved animations: {error:#}\")));\n1961\t                }\n1962\t            }\n1963\t            if self.bridge.is_none() {\n1964\t                match crate::bridge::Bridge::start(pav_tools::bridge::DEFAULT_ADDR) {\n1965\t                    Ok(bridge) => self.bridge = Some(bridge),\n1966\t                    Err(error) => {\n1967\t                        let message = format!(\"Could not open the live bridge: {error}\");\n1968\t                        if mode == StudioMode::Creature {\n1969\t                            self.creature_ui.report(Err(message));\n1970\t                        } else if mode == StudioMode::Prop {\n1971\t                            self.asset_ui.report(Err(message));\n1972\t                        } else {\n1973\t                            self.animation_ui.report(Err(message));\n1974\t                        }\n1975\t                    }\n1976\t                }\n1977\t            }\n1978\t        }\n1979\t        self.animation_ui.open = mode == StudioMode::Animation;\n1980\t        self.asset_ui.open = mode == StudioMode::Prop;\n1981\t        self.creature_ui.open = mode == StudioMode::Creature;\n1982\t        let tool = match mode {\n1983\t            StudioMode::Animation => \"anim_preview\",\n1984\t            StudioMode::Prop => \"asset_preview\",\n1985\t            StudioMode::Creature => \"creature_preview\",\n1986\t            StudioMode::World if self.studio_mode == StudioMode::Creature => \"creature_preview\",\n1987\t            StudioMode::World if self.studio_mode == StudioMode::Prop => \"asset_preview\",\n1988\t            StudioMode::World => \"anim_preview\",\n1989\t        };\n1990\t        let action = if mode == StudioMode::World { \"close\" } else { \"open\" };\n1991\t        self.studio_command(crate::animation_ui::Command {\n1992\t            tool,\n1993\t            args: serde_json::json!({\"action\":action}).as_object().unwrap().clone(),\n1994\t        });\n1995\t    }\n1996\t\n1997\t    fn ensure_animation_watcher(&mut self) {\n1998\t        // An agent may create the first animation directory through the bridge. Attach\n1999\t        // then, but do not retry a failed native watcher on every frame.\n2000\t        if !self.animation_watch_attempted && crate::animation_watch::AnimationWatcher::directory_exists() {\n2001\t            self.animation_watch_attempted = true;\n2002\t            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n2003\t        }\n2004\t    }\n2005\t\n2006\t    fn menu_action(&mut self, a: MenuAction) {\n2007\t        match a {\n2008\t            MenuAction::Resume => self.set_menu(false),\n2009\t            MenuAction::AnimationStudio => self.switch_studio(StudioMode::Animation),\n2010\t            MenuAction::AssetStudio => self.switch_studio(StudioMode::Prop),\n2011\t            MenuAction::CreatureStudio => self.switch_studio(StudioMode::Creature),\n2012\t            MenuAction::Reset => {\n2013\t                self.set_menu(false);\n2014\t                self.reset();\n2015\t            }\n2016\t            MenuAction::LoadScene(name) => {\n2017\t                self.set_menu(false);\n2018\t                self.load_scene(&name);\n2019\t            }\n2020\t            MenuAction::NewHero => {\n2021\t                self.set_menu(false);\n2022\t                if let Some(host) = &self.host {\n2023\t                    let (cfg, seed) = (self.sim_config.clone(), self.settings.seed);\n2024\t                    host.exec(move |sim| {\n2025\t                        crate::save::erase();\n2026\t                        if let Ok(mut fresh) = Sim::new(\"town\", seed) {\n2027\t                            fresh.config = cfg;\n2028\t                            *sim = fresh;\n2029\t                        }\n2030\t                    });\n2031\t                }\n2032\t                self.scene_name = \"town\".into();\n2033\t                self.toast(\"a new hero arrives in Emberwatch\");\n2034\t            }\n2035\t            MenuAction::Tuning => {\n2036\t                self.set_menu(false);\n2037\t                self.panel.open = true;\n2038\t            }\n2039\t            MenuAction::Look => {\n2040\t                self.set_menu(false);\n2041\t                self.look_ui.open = true;\n2042\t            }\n2043\t            MenuAction::Guide => {\n2044\t                self.set_menu(false);\n2045\t                if self.hud.current.is_some() {\n2046\t                    self.guide.station = true;\n2047\t                } else {\n2048\t                    self.guide.field = true;\n2049\t                }\n2050\t            }\n2051\t            MenuAction::FieldGuide => {\n2052\t                self.set_menu(false);\n2053\t                self.guide.field = true;\n2054\t            }\n2055\t            MenuAction::Rooms => {\n2056\t                self.set_menu(false);\n2057\t                self.open_teleport();\n2058\t            }\n2059\t            MenuAction::RoomCard => {\n2060\t                self.set_menu(false);\n2061\t                self.hud.show_card();\n2062\t            }\n2063\t            MenuAction::Screenshot => {\n2064\t                self.set_menu(false);\n2065\t                self.screenshot_requested = true;\n2066\t            }\n2067\t            MenuAction::Feel => {\n2068\t                self.set_menu(false);\n2069\t                self.feel.open = !self.feel.open;\n2070\t                self.feel.auto = false;\n2071\t            }\n2072\t            MenuAction::Physics => {\n2073\t                self.set_menu(false);\n2074\t                self.physics.open = !self.physics.open;\n2075\t                self.physics.auto = false;\n2076\t            }\n2077\t            MenuAction::Quit => {\n2078\t                self.look_ui.save_if_dirty(true);\n2079\t                self.quit = true;\n2080\t            }\n2081\t            MenuAction::TownPortal => {\n2082\t                self.set_menu(false);\n2083\t                if let Some(host) = &self.host {\n2084\t                    host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n2085\t                }\n2086\t            }\n2087\t            MenuAction::Fullscreen => {\n2088\t                if let Some(g) = &self.gfx {\n2089\t                    crate::platform::toggle_fullscreen(&g.window);\n2090\t                }\n2091\t            }\n2092\t        }\n2093\t    }\n2094\t}\n2095\t\n2096\timpl App {\n2097\t    /// The browser only allows sound after the first click or key press.\n2098\t    #[cfg(target_arch = \"wasm32\")]\n2099\t    fn resume_audio(&mut self) {\n2100\t        if !self.audio_resumed {\n2101\t            self.audio_resumed = true;\n2102\t            if let Some(a) = &self.audio {\n2103\t                a.resume();\n2104\t            }\n2105\t        }\n2106\t    }\n2107\t\n2108\t    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n2109\t    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n2110\t        let msg = format!(\"{e:#}\");\n2111\t        #[cfg(target_arch = \"wasm32\")]\n2112\t        crate::platform::error_box(\"Shardfall could not start\", &msg);\n2113\t        self.fatal = Some(msg);\n2114\t        el.exit();\n2115\t    }\n2116\t}\n2117\t\n2118\timpl ApplicationHandler for App {\n2119\t    fn resumed(&mut self, el: &ActiveEventLoop) {\n2120\t        if self.init_started || self.fatal.is_some() {\n2121\t            return;\n2122\t        }\n2123\t        self.init_started = true;\n2124\t        if let Err(e) = self.init(el) {\n2125\t            self.fail(el, e);\n2126\t        }\n2127\t    }\n2128\t\n2129\t    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n2130\t        if let WindowEvent::Touch(t) = &event {\n2131\t            self.on_touch(t, &event);\n2132\t            return;\n2133\t        }\n2134\t        let consumed = match (&mut self.egui_state, &self.gfx) {\n2135\t            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n2136\t            _ => false,\n2137\t        };\n2138\t        match event {\n2139\t            WindowEvent::CloseRequested => {\n2140\t                if let Some(host) = &self.host {\n2141\t                    host.exec(|sim| crate::save::save_from(sim));\n2142\t                }\n2143\t                self.look_ui.save_if_dirty(true);\n2144\t                el.exit()\n2145\t            }\n2146\t            WindowEvent::Focused(false) => {\n2147\t                self.input.clear();\n2148\t                self.touch.clear();\n2149\t            }\n2150\t            WindowEvent::Resized(sz) => {\n2151\t                if let Some(g) = &mut self.gfx {\n2152\t                    g.resize(sz.width, sz.height);\n2153\t                }\n2154\t            }\n2155\t            WindowEvent::RedrawRequested => {\n2156\t                self.frame();\n2157\t                if self.quit {\n2158\t                    el.exit();\n2159\t                }\n2160\t            }\n2161\t            WindowEvent::KeyboardInput { event, .. } => {\n2162\t                #[cfg(target_arch = \"wasm32\")]\n2163\t                self.resume_audio();\n2164\t                if let PhysicalKey::Code(code) = event.physical_key {\n2165\t                    let system = matches!(\n2166\t                        code,\n2167\t                        KeyCode::Escape\n2168\t                            | KeyCode::F1\n2169\t                            | KeyCode::F2\n2170\t                            | KeyCode::F3\n2171\t                            | KeyCode::F4\n2172\t                            | KeyCode::F5\n2173\t                            | KeyCode::F6\n2174\t                            | KeyCode::F7\n2175\t                            | KeyCode::F8\n2176\t                            | KeyCode::F9\n2177\t                            | KeyCode::F10\n2178\t                            | KeyCode::F11\n2179\t                            | KeyCode::F12\n2180\t                    );\n2181\t                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n2182\t                        self.handle_key(code);\n2183\t                        if !system && !consumed {\n2184\t                            self.latency.press();\n2185\t                        }\n2186\t                    }\n2187\t                    if !consumed || event.state == ElementState::Released {\n2188\t                        self.input.key(code, event.state);\n2189\t                    }\n2190\t                }\n2191\t            }\n2192\t            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n2193\t                let lines = match delta {\n2194\t                    MouseScrollDelta::LineDelta(_, y) => y,\n2195\t                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n2196\t                };\n2197\t                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n2198\t            }\n2199\t            WindowEvent::MouseInput { state, button, .. } => {\n2200\t                #[cfg(target_arch = \"wasm32\")]\n2201\t                self.resume_audio();\n2202\t                if state == ElementState::Pressed && button == MouseButton::Left && !consumed {\n2203\t                    self.latency.press();\n2204\t                }\n2205\t                // In the game the right button is a skill; the middle button turns the camera.\n2206\t                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n2207\t                    MouseButton::Middle\n2208\t                } else {\n2209\t                    MouseButton::Right\n2210\t                };\n2211\t                if button == turn {\n2212\t                    self.mouse.right_down = state == ElementState::Pressed && !consumed;\n2213\t                } else if !consumed || state == ElementState::Released {\n2214\t                    self.input.mouse_button(button, state);\n2215\t                }\n2216\t            }\n2217\t            WindowEvent::CursorMoved { position, .. } => {\n2218\t                let p = Vec2::new(position.x as f32, position.y as f32);\n2219\t                if self.mouse.right_down {\n2220\t                    let d = p - self.mouse.pos;\n2221\t                    self.rig.params.yaw = (self.rig.params.yaw - d.x * 0.3 + 540.0).rem_euclid(360.0) - 180.0;\n2222\t                    self.rig.params.tilt = (self.rig.params.tilt + d.y * 0.2).clamp(0.0, 90.0);\n2223\t                }\n2224\t                if (p - self.mouse.pos).length() > 2.0 {\n2225\t                    self.input.last_device = Device::KeyboardMouse;\n2226\t                }\n2227\t                self.mouse.pos = p;\n2228\t                self.input.cursor = p;\n2229\t            }\n2230\t            _ => {}\n2231\t        }\n2232\t    }\n2233\t\n2234\t    fn about_to_wait(&mut self, el: &ActiveEventLoop) {\n2235\t        #[cfg(target_arch = \"wasm32\")]\n2236\t        if let Some(r) = self.pending_gfx.as_ref().and_then(|slot| slot.borrow_mut().take()) {\n2237\t            self.pending_gfx = None;\n2238\t            if let Err(e) = r.and_then(|gfx| self.finish_init(gfx)) {\n2239\t                self.fail(el, e);\n2240\t            }\n2241\t        }\n2242\t        #[cfg(not(target_arch = \"wasm32\"))]\n2243\t        let _ = el;\n2244\t        if let Some(g) = &self.gfx {\n2245\t            g.window.request_redraw();\n2246\t        }\n2247\t    }\n2248\t}\n2249\t\n2250\tfn room_entries(sim: &Sim) -> Vec<RoomEntry> {\n2251\t    let mut v: Vec<RoomEntry> = sim\n2252\t        .state\n2253\t        .world\n2254\t        .rooms\n2255\t        .iter()\n2256\t        .map(|r| RoomEntry {\n2257\t            key: r.key.clone(),\n2258\t            name: if r.def.name.is_empty() { r.key.clone() } else { r.def.name.clone() },\n2259\t            wing: r.def.wing.clone(),\n2260\t            about: r.def.about.clone(),\n2261\t            ask: r.def.learn.ask.clone(),\n2262\t        })\n2263\t        .collect();\n2264\t    v.sort_by(|a, b| (&a.wing, &a.name).cmp(&(&b.wing, &b.name)));\n2265\t    v\n2266\t}\n2267\t"}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"dbd0dce5-f170-4b3b-8ce5-2b215a35e6ec","timestamp":"2026-11-05T05:39:59.481Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_app/src/app.rs","content":"        let rewinding = game_input && self.studio_mode == StudioMode::World && self.input.rewind_held();\n        host.set_control(|c| c.rewinding = rewinding);\n\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let studio_mode = curr.studio_mode();\n        let studio_active = curr.studio_active();\n        self.studio_navigation |= studio_active;\n        let snap_camera = studio_mode != self.studio_mode\n            || prev.studio_mode() != studio_mode\n            || prev.live_edit_ticket != curr.live_edit_ticket;\n        let game_input = game_input && !studio_active;\n        if studio_mode != self.studio_mode {\n            let keep_object_redo = studio_mode == StudioMode::World && self.asset_ui.open && self.asset_ui.creation_removed();\n            let keep_creature_redo =\n                studio_mode == StudioMode::World && self.creature_ui.open && self.creature_ui.creation_removed();\n            self.builder = ViewBuilder::new();\n            if let Some(gfx) = &mut self.gfx {\n                gfx.renderer.clear_particles();\n            }\n            self.studio_mode = studio_mode;\n            self.animation_ui.open = studio_mode == StudioMode::Animation;\n            self.asset_ui.open = studio_mode == StudioMode::Prop || keep_object_redo;\n            self.creature_ui.open = studio_mode == StudioMode::Creature || keep_creature_redo;\n        }\n        if !studio_active {\n            let room_before = self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def)));\n            let quarters = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n            self.director.update(&curr.hud, quarters, &mut self.rig);\n            let room_id_before = self.hud.current.as_ref().map(|r| r.id);\n            self.hud.update(&curr.room, &mut self.rig);\n            // Rooms and pads can change view settings (night lighting, bloom, filters).\n            let key = (curr.room.as_ref().map(|r| r.id), curr.hud.view_serial);\n            if key != self.view_key {\n                self.view_key = key;\n                if let Some(b) = self.view_base.take() {\n                    self.view = b;\n                }\n                let q = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n                let room = curr.room.as_ref().map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n                let pads = pav_view::build::room_view_map(&curr.hud.view, q);\n                if !room.is_empty() || !pads.is_empty() {\n                    self.view_base = Some(self.view.clone());\n                    for u in self.view.apply(&room).into_iter().chain(self.view.apply(&pads)) {\n                        log::warn!(\"unknown view setting '{u}'\");\n                    }\n                }\n            }\n            if self.hud.current.as_ref().map(|r| r.id) != room_id_before {\n                // Rooms can open HUD overlays (feel metrics) while you are inside.\n                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"feel\"));\n                if wants && !self.feel.open {\n                    self.feel.open = true;\n                    self.feel.auto = true;\n                } else if !wants && self.feel.auto {\n                    self.feel.open = false;\n                    self.feel.auto = false;\n                }\n                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"physics\"));\n                if wants && !self.physics.open {\n                    self.physics.open = true;\n                    self.physics.auto = true;\n                } else if !wants && self.physics.auto {\n                    self.physics.open = false;\n                    self.physics.auto = false;\n                }\n            }\n            self.feel.record(curr.tick, curr.hud.feel.speed);\n            if self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def))) != room_before {\n                // Input switching: the room's key overrides apply while inside.\n                let (b, errs) = match &self.hud.current {\n                    Some(r) => crate::input::Bindings::with_overrides(&r.def.keys),\n                    None if curr.game.is_some() => (crate::input::Bindings::game(), Vec::new()),\n                    None => (crate::input::Bindings::default(), Vec::new()),\n                };\n                self.input.bindings = b;\n                for e in errs {\n                    log::warn!(\"room keys: {e}\");\n                }\n            }\n            if *curr.config != self.sim_config && curr.tick > self.config_push_tick + 3 {\n                // The simulation changed its configuration (room overrides): adopt it.\n                self.sim_config = (*curr.config).clone();\n            }\n            // Entering or leaving Shardfall: its controls, camera and look.\n            let game_mode = curr.game.is_some();\n            if game_mode != self.input.game {\n                self.input.game = game_mode;\n                self.input.bindings = if game_mode { crate::input::Bindings::game() } else { crate::input::Bindings::default() };\n                self.rig.blend_from_current(0.5);\n                if game_mode {\n                    self.game_saved = Some((self.rig.params.clone(), self.view.clone()));\n                    self.rig.params = CameraParams {\n                        tilt: 56.0,\n                        yaw: 0.0,\n                        distance: 15.5,\n                        fov: 40.0,\n                        ortho: false,\n                        follow_lag: 0.06,\n                        height_offset: 0.8,\n                    };\n                    let v = &mut self.view;\n                    v.bloom = 0.55;\n                    v.bloom_threshold = 1.0;\n                    v.sky = \"#14161c\".into();\n                    v.light.sun_elevation = 52.0;\n                    v.light.sun_azimuth = 35.0;\n                    v.light.sun_intensity = 0.95;\n                    v.light.ambient = 0.5;\n                    v.saturation = 1.08;\n                    v.fog = false;\n                } else if let Some((cam, view)) = self.game_saved.take() {\n                    self.rig.params = cam;\n                    self.view = view;\n                }\n            }\n            self.game_frame = curr.game.clone();\n            if !game_mode {\n                self.game_ui.close_all();\n                self.game_place = None;\n            }\n            if let Some(g) = &curr.game {\n                if self.game_place != Some(g.place) {\n                    self.game_place = Some(g.place);\n                    self.arrival = Some(Instant::now());\n                    self.game_ui.panel = None;\n                    pav_view::arpg::place_look(g, &mut self.view);\n                }\n            }\n        } else {\n            self.game_frame = None;\n        }\n        let alpha = if self.app_settings.smoothing && !snap_camera {\n            ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0)\n        } else {\n            1.0\n        };\n        if snap_camera {\n            // A submitted edit must contain its new framing as well as its new geometry.\n            self.rig = CameraRig::new(self.rig.params.clone());\n            self.rig.snap(curr.focus);\n        }\n        let focus = prev.focus.lerp(curr.focus, alpha);\n        let player = curr.player.and_then(|id| curr.objects.iter().find(|o| o.id == id));\n        let feet = player.and_then(|p| p.puppet.as_ref().map(|pp| p.pos - Vec3::Y * pp.feet_offset)).unwrap_or(focus);\n        let facing = player.and_then(|p| p.puppet.as_ref().map(|pp| pp.state.facing)).unwrap_or(0.0);\n\n        // Game input -> the simulation thread.\n        let (w, h) = self.gfx.as_ref().unwrap().size();\n        let size = Vec2::new(w as f32, h as f32);\n        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n        if over_ui {\n            self.input.mouse_taps.clear();\n        }\n        let (mut held, mut pressed) = self.input.buttons();\n        // Touch: the stick, the buttons and auto-attack.\n        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\n        let rig = &self.rig;\n        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\n        if game_input {\n            held |= intent.held;\n            pressed |= intent.pressed;\n        }\n        if pressed & pav_core::input::buttons::INTERACT != 0 {\n            if let Some(g) = &curr.game {\n                if let Some(c) = self.game_ui.interact(g) {\n                    host.shared.command(c);\n                }\n            }\n        }\n        if pressed != 0 && self.input.last_device == Device::Gamepad {\n            // Gamepad presses are timed from when they were polled (gilrs queues them).\n            self.latency.press();\n        }\n        let room_id = self.hud.current.as_ref().map(|r| r.id);\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n        if left_tap && !self.editor.on && game_input {\n            pressed |= pav_core::input::buttons::PRIMARY;\n        }\n        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\n            held &= !pav_core::input::buttons::PRIMARY;\n            pressed &= !pav_core::input::buttons::PRIMARY;\n        }\n        let aim = match self.input.last_device {\n            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\n            Device::Gamepad => {\n                let r = self.input.pad.right;\n                if r.length() > 0.2 {\n                    let d = self.rig.relative_move(r);\n                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\n                } else {\n                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\n                }\n            }\n            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\n        };\n        {\n            let mut i = host.shared.input.lock().unwrap();\n            if game_input {\n                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\n                i.move_dir = match intent.move_world {\n                    // Auto-attack stepping in to a foe (only while the stick is still).\n                    Some(m) if axis == Vec2::ZERO => m,\n                    _ => self.rig.relative_move(axis),\n                };\n                i.held = held;\n                i.pressed |= pressed;\n                i.aim = aim;\n                if let Some(t) = self.latency.pending.take() {\n                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n                }\n            } else {\n                *i = InputFrame::default();\n            }\n        }\n\n        self.rig.update(focus, dt);\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n        let events = if studio_active { Vec::new() } else { events };\n        self.builder.add_events(&events);\n        // Save the hero on every arrival somewhere, and once a minute while playing.\n        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\n        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\n            self.last_save = Instant::now();\n            host.exec(|sim| crate::save::save_from(sim));\n        }\n        if let Some(a) = &self.audio {\n            let (_, right) = self.rig.ground_axes();\n            let l = pav_audio::Listener { pos: self.rig.target, right };\n            for e in &events {\n                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\n                    continue;\n                }\n                a.play_event(e, &l, self.audio_settings.sfx);\n            }\n        }\n        // The look layer (Look & Filters) over the scene's own settings.\n        let mut view = self.view.clone();\n        self.look_ui.apply(&mut view);\n        self.prefs.quality.trim(self.touch_screen, &mut view);\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n        // Arriving somewhere new: the screen opens with the chosen transition, on the player.\n        if let Some(t0) = self.arrival {\n            let t = t0.elapsed().as_secs_f32() / view.filter.transition_time.max(0.05);\n            match view.filter.transition.kind() {\n                Some(kind) if t < 1.0 => {\n                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\n                    scene.filter.transition_kind = kind;\n                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\n                }\n                _ => self.arrival = None,\n            }\n        }\n        if !studio_active {\n            self.editor.draw_preview(&mut scene);\n        }\n        if let Some(a) = intent.aiming.filter(|_| game_input) {\n            // A skill aimed by hand: a ring where it lands and dots on the way there.\n            let mark = |at: Vec3, s: f32, color: Vec3| MeshInstance {\n                mesh: MeshKey::Cylinder,\n                transform: Mat4::from_scale_rotation_translation(Vec3::new(s, 0.02, s), Quat::IDENTITY, at + Vec3::Y * 0.04),\n                color,\n                emissive: 0.6,\n                style: Style::Unlit,\n                flags: rflags::NO_SHADOW | rflags::NO_CUT,\n                group: 0,\n                material: 0,\n                ext: Vec3::ZERO,\n            };\n            let a = Vec3::new(a.x, feet.y, a.z);\n            scene.meshes.push(mark(a, 0.9, Vec3::new(1.0, 0.78, 0.4)));\n            let n = ((a - feet).length() / 0.8) as usize;\n            for k in 1..n {\n                scene.meshes.push(mark(feet.lerp(a, k as f32 / n as f32), 0.14, Vec3::new(1.0, 0.9, 0.7)));\n            }\n        }\n        if self.app_settings.aim_marker && game_input && curr.player.is_some() && !self.editor.on && curr.game.is_none() {\n            if let Some(a) = aim {\n                let d = Vec2::new(a.x - feet.x, a.z - feet.z);\n                let a = if d.length() > self.sim_config.bombs.throw_range {\n                    let d = d.normalize() * self.sim_config.bombs.throw_range;\n                    Vec3::new(feet.x + d.x, a.y, feet.z + d.y)\n                } else {\n                    a\n                };\n                scene.meshes.push(MeshInstance {\n                    mesh: MeshKey::Cylinder,\n                    transform: Mat4::from_scale_rotation_translation(\n                        Vec3::new(0.5, 0.02, 0.5),\n                        Quat::IDENTITY,\n                        a + Vec3::Y * 0.03,\n                    ),\n                    color: Vec3::new(1.0, 0.95, 0.7),\n                    emissive: 0.0,\n                    style: Style::Unlit,\n                    flags: rflags::NO_SHADOW | rflags::NO_CUT,\n                    group: 0,\n                    material: 0,\n                    ext: Vec3::ZERO,\n                });\n            }\n        }\n\n        // UI.\n        let stats = *host.shared.stats.lock().unwrap();\n        let mut ctl = host.control();\n        let ctl_before = ctl;\n        let crash = host.shared.crashed.lock().unwrap().clone();\n        self.panel.record_timing(dt * 1000.0, stats.tick_ms);\n        let gfx = self.gfx.as_mut().unwrap();\n        let (render_scale, lights) =\n            self.scaler.update(self.prefs.quality, self.touch_screen, dt * 1000.0, gfx.size(), gfx.window.scale_factor() as f32);\n        gfx.renderer.render_scale = render_scale;\n        gfx.renderer.max_shadow_lights = lights;\n        let info = ui::OverlayInfo {\n            fps: self.fps.fps,\n            frame_ms: self.fps.frame_ms,\n            tps: stats.tps,\n            tick_ms: stats.tick_ms,\n            tick: stats.tick,\n            entities: stats.entities,\n            gpu_errors: gfx.gpu_errors.load(std::sync::atomic::Ordering::Relaxed),\n            adapter: &gfx.adapter_name,\n            crash: crash.clone(),\n            paused: ctl.paused,\n            speed: ctl.speed,\n            rewinding,\n            render_scale,\n        };\n        if let Some(t) = self.boot_done_at {\n            if t.elapsed().as_secs_f32() > 10.0 && self.show_boot {\n                self.show_boot = false;\n                self.boot_done_at = None;\n            }\n        }\n        let toast = self.toast.as_ref().filter(|(_, t)| t.elapsed().as_secs_f32() < 3.0).map(|(m, _)| m.clone());\n        let card_visible = !studio_active && self.hud.card_visible();\n        let guide_visible =\n            !studio_active && self.app_settings.show_guide && self.started.elapsed().as_secs_f32() < 25.0 && !card_visible;\n        let device = self.input.last_device;\n        let touch_ui = device == Device::Touch;\n        if touch_ui != self.touch_styled {\n            self.touch_styled = touch_ui;\n            pav_ui::touch_style(&self.egui_ctx, touch_ui);\n        }\n        self.game_ui.touch = touch_ui;\n        self.game_ui.tree.touch = touch_ui;\n        self.touch.swipes.begin_frame();\n        let touch = &mut self.touch;\n        let auto_attack = self.prefs.auto_attack;\n        let tips = touch_ui && !self.prefs.tips_seen && self.started.elapsed().as_secs_f32() < 45.0;\n        let mut prefs = self.prefs.clone();\n        let portal = self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town);\n        let state = self.egui_state.as_mut().unwrap();\n        let mut raw = state.take(&gfx.window);\n        raw.events.append(&mut self.pad_events);\n        let pad_cursor = self.pad_cursor;\n        let mut show_boot = self.show_boot;\n        let menu_open = self.menu_open;\n        let scene_name = self.scene_name.clone();\n        let mut menu_action = None;\n        let mut panel_actions = Vec::new();\n        let mut teleport = None;\n        let mut save_room = false;\n        let room_name = self.hud.current.as_ref().map(|r| r.key.clone());\n        let editor = &mut self.editor;\n        let hud = &mut self.hud;\n        let config_before = self.sim_config.clone();\n        let app_before = self.app_settings.clone();\n        let panel = &mut self.panel;\n        let master_before = self.audio_settings.master;\n        let view_proj = self.rig.view_proj(w as f32 / h.max(1) as f32);\n        let mut root = Root {\n            sim: &mut self.sim_config,\n            camera: &mut self.rig.params,\n            view: &mut self.view,\n            app: &mut self.app_settings,\n            audio: &mut self.audio_settings,\n        };\n        let show_stats = root.app.show_stats;\n        let feel = &mut self.feel;\n        let physics = &mut self.physics;\n        let latency = &self.latency;\n        let hud_ctx = HudCtx { hud: &curr.hud, tick: curr.tick, dt: curr.dt };\n        let game_frame = curr.game.clone();\n        let game_ui = &mut self.game_ui;\n        let look_ui = &mut self.look_ui;\n        let animation_ui = &mut self.animation_ui;\n        let asset_ui = &mut self.asset_ui;\n        let creature_ui = &mut self.creature_ui;\n        let studio_navigation = self.studio_navigation;\n        let mut creature_commands = Vec::new();\n        let mut animation_commands = Vec::new();\n        let mut asset_commands = Vec::new();\n        let mut studio_target = None;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let animation_bridge = self.bridge.as_ref().map(|b| b.addr.as_str());\n        #[cfg(target_arch = \"wasm32\")]\n        let animation_bridge: Option<&str> = None;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let creature_feedback =\n            self.bridge.as_ref().and_then(|bridge| bridge.feedback.lock().ok().map(|feedback| feedback.status(None)));\n        #[cfg(target_arch = \"wasm32\")]\n        let creature_feedback: Option<serde_json::Value> = None;\n        let mut look_msg = None;\n        let guide = &mut self.guide;\n        let mut guide_out = Vec::new();\n        let mut game_cmds = Vec::new();\n        let out = self.egui_ctx.run_ui(raw, |ui| {\n            let ctx = ui.ctx().clone();\n            if let Some(c) = &info.crash {\n                ui::crash_banner(ui, c);\n            }\n            panel_actions = panel.ui(ui, &mut root, &mut ctl, &stats);\n            let free = ui.available_rect_before_wrap();\n            ui::boot_panel(&ctx, &mut show_boot);\n            if show_stats {\n                ui::stats_panel(&ctx, &info, free, touch_ui);\n            }\n            if guide_visible && !menu_open && !touch_ui {\n                ui::guide_panel(&ctx, device, game_frame.is_some());\n            }\n            if let Some(g) = &game_frame {\n                let proj = crate::arpg_ui::Projector { vp: view_proj, size: ctx.content_rect().size() };\n                crate::arpg_ui::hud(&ctx, g, &proj, device, game_ui.map, &mut touch.swipes);\n                if !menu_open {\n                    game_cmds = game_ui.ui(&ctx, g, &proj);\n                }\n            }\n            if touch_ui {\n                let map_hidden = touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n                let covered = menu_open || game_ui.any_open() || look_ui.open || guide.station || guide.field;\n                let points = game_frame.as_ref().and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n                touch.draw(&ctx, &crate::touch::View { game: game_frame.as_deref(), auto_attack, map_hidden, points, covered });\n                if tips && !covered {\n                    ui::touch_tips(&ctx, game_frame.is_some(), &mut touch.swipes);\n                }\n            }\n            if card_visible && !menu_open && hud.card(&ctx, device) {\n                guide.station = true;\n            }\n            if !menu_open {\n                crate::guide_ui::pad_note(&ctx, hud_ctx.hud, hud_ctx.tick, hud_ctx.dt, touch_ui.then_some(&mut touch.swipes));\n            }\n            crate::hud::course_hud(&ctx, &hud_ctx);\n            pav_ui::game_lines(&ctx, hud_ctx.hud);\n            if let Some(p) = pad_cursor {\n                // The gamepad's menu cursor, above everything.\n                let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new(\"pad_cursor\")));\n                let tip = egui::Pos2::new(p.x, p.y);\n                let pts = vec![tip, tip + egui::vec2(0.0, 22.0), tip + egui::vec2(6.0, 16.5), tip + egui::vec2(15.0, 16.0)];\n                painter.add(egui::Shape::convex_polygon(\n                    pts,\n                    egui::Color32::from_rgb(255, 225, 150),\n                    egui::Stroke::new(1.5, egui::Color32::BLACK),\n                ));\n            }\n            physics.ui(&ctx, &hud_ctx, stats.tps, stats.tick_ms);\n            crate::hud::hit_flash(&ctx, hud_ctx.hud.invuln);\n            feel.ui(\n                &ctx,\n                &hud_ctx,\n                latency,\n                FeelSettings {\n                    model: &mut root.sim.movement.model,\n                    tick_rate: &mut root.sim.tick_rate,\n                    vsync: &mut root.app.vsync,\n                    smoothing: &mut root.app.smoothing,\n                },\n            );\n            teleport = hud.teleport_menu(&ctx);\n            hud.error_panel(&ctx);\n            if !studio_active {\n                save_room = editor.ui(&ctx, room_name.as_deref());\n            }\n            look_msg = look_ui.window(&ctx, root.view);\n            if studio_navigation || studio_active || animation_ui.open || asset_ui.open || creature_ui.open {\n                egui::Window::new(\"Studio workspace\")\n                    .id(egui::Id::new(\"studio_navigation\"))\n                    .title_bar(false)\n                    .resizable(false)\n                    .fixed_pos([16.0, 8.0])\n                    .show(&ctx, |ui| {\n                        ui.horizontal(|ui| {\n                            ui.strong(\"SHARDFALL STUDIO\");\n                            for (mode, label) in [\n                                (StudioMode::Animation, \"Animations\"),\n                                (StudioMode::Prop, \"Objects\"),\n                                (StudioMode::Creature, \"Creatures\"),\n                                (StudioMode::World, \"Game\"),\n                            ] {\n                                let panel_open = animation_ui.open || asset_ui.open || creature_ui.open;\n                                let reopen = match mode {\n                                    StudioMode::World => panel_open,\n                                    StudioMode::Animation => !animation_ui.open,\n                                    StudioMode::Prop => !asset_ui.open,\n                                    StudioMode::Creature => !creature_ui.open,\n                                };\n                                if ui.selectable_label(studio_mode == mode, label).clicked() && (studio_mode != mode || reopen) {\n                                    studio_target = Some(mode);\n                                }\n                            }\n                        });\n                    });\n            }\n            if matches!(studio_mode, StudioMode::Animation | StudioMode::World) {\n                animation_commands = animation_ui.window(&ctx, curr.animation_preview.as_ref(), animation_bridge);\n            }\n            if matches!(studio_mode, StudioMode::Prop | StudioMode::World) {\n                asset_commands = asset_ui.window(&ctx, &curr, animation_bridge);\n            }\n            if matches!(studio_mode, StudioMode::Creature | StudioMode::World) {\n                creature_commands = creature_ui.window(&ctx, &curr, animation_bridge, creature_feedback.as_ref());\n            }\n            let here = hud.current.clone();\n            guide_out.extend(guide.station(&ctx, here.as_ref(), &mut root));\n            guide_out.extend(guide.field_guide(&ctx, &hud.entries));\n            if menu_open {\n                let difficulty = game_frame.is_some().then_some(&mut root.sim.difficulty);\n                menu_action = if touch_ui {\n                    let show_fps = &mut root.app.show_stats;\n                    let m = ui::TouchMenu { prefs: &mut prefs, show_fps, difficulty, portal, scale: render_scale };\n                    ui::touch_menu(&ctx, &scene_name, m)\n                } else {\n                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\n                };\n            }\n            if let Some(t) = &toast {\n                if touch_ui {\n                    ui::toast_touch(&ctx, t, &mut touch.swipes);\n                } else {\n                    ui::toast(&ctx, t);\n                }\n            }\n            if !touch_ui {\n                const GAME_KEYS: &str =\n                    \"Esc menu · I inventory · P passives · C character · K skills · T town · G use · Space dodge · 1 potion\";\n                ui::hint_bar(\n                    &ctx,\n                    match (device, game_frame.is_some()) {\n                        (Device::Gamepad, _) => \"Start: menu\",\n                        (_, true) => GAME_KEYS,\n                        _ => \"Esc menu · F1 tuning · F2 rooms · F12 screenshot\",\n                    },\n                );\n            }\n        });\n        if prefs != self.prefs {\n            self.prefs = prefs;\n            crate::save::save_prefs(&self.prefs);\n        }\n        // The map: a tap on the minimap opens the big one; a tap or a swipe closes that.\n        let sw = &mut self.touch.swipes;\n        if sw.take_tap(egui::Id::new(\"minimap\")) {\n            self.game_ui.map = true;\n        }\n        let big = egui::Id::new(\"big_map\");\n        if sw.take_tap(big) || sw.is_gone(big, 0) {\n            self.game_ui.map = false;\n            sw.restore(big);\n        }\n        if !self.prefs.tips_seen && sw.is_gone(egui::Id::new(\"touch_tips\"), 0) {\n            self.prefs.tips_seen = true;\n            crate::save::save_prefs(&self.prefs);\n        }\n        self.show_boot = show_boot;\n        for a in guide_out {\n            match a {\n                crate::guide_ui::GuideAction::Go(key) => teleport = Some(crate::rooms::TeleportTarget::Room(key)),\n                crate::guide_ui::GuideAction::Toast(m) => self.toast = Some((m, Instant::now())),\n            }\n        }\n        if let Some(m) = look_msg {\n            self.toast = Some((m, Instant::now()));\n        }\n        self.look_ui.save_if_dirty(false);\n        for c in game_cmds {\n            host.shared.command(c);\n        }\n        if ctl.paused != ctl_before.paused\n            || ctl.speed != ctl_before.speed\n            || ctl.step_requests != ctl_before.step_requests\n            || ctl.rewind_speed != ctl_before.rewind_speed\n        {\n            let c = ctl;\n            host.set_control(|x| {\n                x.paused = c.paused;\n                x.speed = c.speed;\n                x.step_requests = c.step_requests;\n                x.rewind_speed = c.rewind_speed;\n            });\n        }\n        if self.sim_config != config_before {\n            let cfg = self.sim_config.clone();\n            host.exec(move |sim| sim.config = cfg);\n            self.config_push_tick = stats.tick.max(curr.tick);\n        }\n        if self.app_settings.vsync != app_before.vsync {\n            gfx.set_vsync(self.app_settings.vsync);\n        }\n        if self.audio_settings.master != master_before {\n            if let Some(a) = &self.audio {\n                a.set_master(self.audio_settings.master);\n            }\n        }\n        state.platform_output(&gfx.window, out.platform_output);\n        let ppp = out.pixels_per_point;\n        let prims = self.egui_ctx.tessellate(out.shapes, ppp);\n        let mut textures = out.textures_delta;\n\n        #[cfg(target_arch = \"wasm32\")]\n        if self.screenshot_requested {\n            // Reading pixels back waits on the GPU, which the browser does not allow here.\n            self.screenshot_requested = false;\n            self.toast = Some((\"screenshots are not available in the browser\".into(), Instant::now()));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if self.screenshot_requested {\n            self.screenshot_requested = false;\n            let (w, h) = gfx.size();\n            let dir = boot::exe_dir().join(\"screenshots\");\n            let path = dir.join(format!(\n                \"shardfall-{}.png\",\n                web_time::SystemTime::now().duration_since(web_time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)\n            ));\n            let r = pav_render::capture::render_to_rgba(&mut gfx.renderer, &scene, w, h)\n                .and_then(|px| pav_render::capture::save_png(&path, w, h, &px));\n            self.toast = Some((\n                match r {\n                    Ok(_) => format!(\"screenshot saved: {}\", path.display()),\n                    Err(e) => format!(\"screenshot failed: {e:#}\"),\n                },\n                Instant::now(),\n            ));\n        }\n\n        let first = self.boot_done_at.is_none()\n            && boot::diag().stages.lock().map(|s| !s.iter().any(|s| s.name == \"first frame\")).unwrap_or(false);\n        let submitted = if first {\n            let submitted = stage(\"first frame\", || {\n                let submitted = gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\n                Ok((submitted, format!(\"{} meshes, {} sdf\", gfx.renderer.stats.mesh_instances, gfx.renderer.stats.sdf_instances)))\n            });\n            self.boot_done_at = Some(Instant::now());\n            log::info!(\"boot complete in {:.0} ms\", boot::diag().start.elapsed().as_secs_f64() * 1000.0);\n            submitted.unwrap_or(false)\n        } else {\n            gfx.draw(&scene, Some((&prims, &mut textures, ppp)))\n        };\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if submitted {\n            if let Some(bridge) = &self.bridge {\n                bridge.submitted(curr.live_edit_ticket);\n            }\n        }\n        // Input latency: the frame showing the tick that consumed a press is now submitted.\n        if submitted {\n            let mut probe = host.shared.latency_probe.lock().unwrap();\n            if let Some((pressed_at, ticked_at, tick)) = *probe {\n                if curr.tick >= tick {\n                    let now = Instant::now();\n                    self.latency.record(LatencySample {\n                        to_tick: (ticked_at - pressed_at).as_secs_f32() * 1000.0,\n                        to_screen: (now - ticked_at).as_secs_f32() * 1000.0,\n                    });\n                    *probe = None;\n                }\n            }\n        }\n\n        for a in panel_actions {\n            self.panel_action(a);\n        }\n        if let Some(t) = teleport {\n            self.teleport(t);\n        }\n        if save_room {\n            if let (Some(host), Some(id)) = (&self.host, room_id) {\n                let msg = match crate::edit::save_room(host, id) {\n                    Ok(p) => format!(\"saved {}\", p.display()),\n                    Err(e) => format!(\"save failed: {e:#}\"),\n                };\n                self.editor.status = msg.clone();\n                self.toast(msg);\n                if self.watcher.is_none() {\n                    self.watcher = RoomWatcher::start();\n                }\n            }\n        }\n        if self.watcher.as_mut().is_some_and(|w| w.poll()) {\n            self.reload_rooms();\n        }\n        if studio_active {\n            self.ensure_animation_watcher();\n        }\n        let animation_updates = self.animation_watcher.as_mut().map(|w| w.poll()).unwrap_or_default();\n        for update in animation_updates {\n            match update {\n                Ok(message) => {\n                    log::info!(\"{message}\");\n                    self.animation_ui.status = message;\n                    self.animation_ui.error = false;\n                }\n                Err(error) => {\n                    log::warn!(\"animation reload: {error}\");\n                    self.animation_ui.report(Err(error));\n                }\n            }\n        }\n        for command in animation_commands {\n            self.studio_command(command);\n        }\n        for command in asset_commands {\n            self.studio_command(command);\n        }\n        for command in creature_commands {\n            self.studio_command(command);\n        }\n        for result in self.creature_watcher.poll() {\n            self.creature_ui.report(result);\n        }\n        self.poll_creature_updates();\n        for update in self.asset_watcher.poll() {\n            match update {\n                Ok((name, definition)) => {\n                    self.asset_ui.status = format!(\"Reloaded {name}\");\n                    self.asset_ui.error = false;\n                    #[cfg(not(target_arch = \"wasm32\"))]\n                    let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n                    #[cfg(target_arch = \"wasm32\")]\n                    let feedback: Option<pav_tools::live_feedback::SharedFeedback> = None;\n                    if let Some(host) = &self.host {\n                        let _ticket = host.query(move |sim| {\n                            let started = feedback.as_ref().map(|_| std::time::Instant::now());\n                            if !crate::asset_watch::apply_update(sim, &name, definition) {\n                                return None;\n                            }\n                            if let Some(feedback) = feedback {\n                                if let Ok(mut feedback) = feedback.lock() {\n                                    let note = feedback.accepted(\"asset_file_reload\", started.unwrap());\n                                    sim.live_edit_ticket = note[\"ticket\"].as_u64().unwrap_or_default();\n                                }\n                            }\n                            Some(sim.live_edit_ticket)\n                        });\n                        #[cfg(not(target_arch = \"wasm32\"))]\n                        if let (Some(bridge), Some(ticket)) = (&self.bridge, _ticket.flatten()) {\n                            bridge.adopted(ticket);\n                        }\n                    }\n                }\n                Err(error) => {\n                    log::warn!(\"object reload: {error}\");\n                    self.asset_ui.report(Err(error));\n                }\n            }\n        }\n        if let Some(mode) = studio_target {\n            self.switch_studio(mode);\n        }\n        if let Some(a) = menu_action {\n            self.menu_action(a);\n        }\n        // Touch: the bag, the menu, the map button, and taps on the open game.\n        for c in &intent.ui {\n            match c {\n                crate::touch::Control::Bag => {\n                    let ui = &mut self.game_ui;\n                    if ui.any_open() {\n                        ui.close_all();\n                    } else {\n                        ui.inventory = true;\n                    }\n                }\n                crate::touch::Control::Menu => {\n                    let open = !self.menu_open;\n                    self.set_menu(open);\n                }\n                crate::touch::Control::Map => self.touch.swipes.restore(egui::Id::new(\"minimap\")),\n                _ => {}\n            }\n        }\n        if intent.world_tap {\n            self.close_on_tap();\n        }\n    }\n\n    fn panel_action(&mut self, a: PanelAction) {\n        let Some(host) = &self.host else { return };\n        let dir = boot::exe_dir();\n        match a {\n            PanelAction::Reset => self.reset(),\n            PanelAction::Scrub(t) => host.set_control(|c| {\n                c.paused = true;\n                c.scrub = Some(t);\n            }),\n            PanelAction::SaveSnapshot => {\n                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n                let r = host.query(move |sim| sim.save_state(&path).map(|_| path.display().to_string()));\n                match r {\n                    Some(Ok(p)) => self.toast(format!(\"snapshot saved: {p}\")),\n                    Some(Err(e)) => self.toast(format!(\"snapshot failed: {e:#}\")),\n                    None => self.toast(\"snapshot timed out\"),\n                }\n            }\n            PanelAction::LoadSnapshot => {\n                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n                let r = host.query(move |sim| sim.load_state(&path));\n                match r {\n                    Some(Ok(())) => self.toast(\"snapshot loaded\"),\n                    Some(Err(e)) => self.toast(format!(\"load failed: {e:#}\")),\n                    None => self.toast(\"load timed out\"),\n                }\n            }\n            PanelAction::SaveReplay => {\n                let path = dir.join(\"replays\").join(\"last.replay.json\");\n                let r = host.query(move |sim| -> Result<String> {\n                    let mut rep = sim.recording.clone();\n                    rep.final_hash = Some(format!(\"{:016x}\", sim.state_hash()));\n                    std::fs::create_dir_all(path.parent().unwrap())?;\n                    std::fs::write(&path, serde_json::to_string(&rep)?)?;\n                    Ok(path.display().to_string())\n                });\n                match r {\n                    Some(Ok(p)) => self.toast(format!(\"replay saved: {p}\")),\n                    Some(Err(e)) => self.toast(format!(\"replay failed: {e:#}\")),\n                    None => self.toast(\"replay timed out\"),\n                }\n            }\n            PanelAction::Look => self.look_ui.open = true,\n            PanelAction::Status(s) => {\n                self.panel.status(s.clone());\n                self.toast(s);\n            }\n        }\n    }\n\n    /// Use the registered tools for UI edits too. This keeps validation, undo, and\n    /// persistence identical for a user and an LLM.\n    fn studio_command(&mut self, command: crate::animation_ui::Command) {\n        let Some(host) = &self.host else { return };\n        let asset = command.tool.starts_with(\"asset\");\n        let creature = command.tool.starts_with(\"creature\");\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(bridge) = &self.bridge {\n            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n                Ok(Some(look)) => self.look_ui.set_look(look),\n                Ok(None) => {}\n                Err(error) => {\n                    let message = format!(\"The previous live edit is still pending: {error:#}\");\n                    if creature {\n                        self.creature_ui.report(Err(message));\n                    } else if asset {\n                        self.asset_ui.report(Err(message));\n                    } else {\n                        self.animation_ui.report(Err(message));\n                    }\n                    return;\n                }\n            }\n        }\n        let rig = self.rig.clone();\n        let view = self.view.clone();\n        let look = self.look_ui.look().clone();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n        #[cfg(target_arch = \"wasm32\")]\n        let feedback = None;\n        let reply = host.query(move |sim| {\n            let live = std::mem::replace(sim, Sim::empty(1));\n            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n            session.look = look;\n            session.feedback = feedback;\n            let result = pav_tools::tools::call(&mut session, command.tool, &command.args)\n                .map(|out| match out {\n                    pav_tools::Output::Json(v) => v,\n                    pav_tools::Output::Image { meta, .. } => meta,\n                })\n                .map_err(|e| format!(\"{e:#}\"));\n            let (live, rig, view, _) = session.into_live();\n            let ticket = live.live_edit_ticket;\n            *sim = live;\n            (result, rig, view, ticket)\n        });\n        let result = match reply {\n            Some((result, rig, view, _ticket)) => {\n                self.rig = rig;\n                self.view = view;\n                #[cfg(not(target_arch = \"wasm32\"))]\n                if let Some(bridge) = &self.bridge {\n                    bridge.adopted(_ticket);\n                }\n                result\n            }\n            None => Err(\"The studio command did not answer. Check the game log.\".into()),\n        };\n        if creature {\n            self.creature_ui.report_command(result);\n        } else if asset {\n            self.asset_ui.report(result);\n        } else {\n            self.animation_ui.report(result);\n        }\n        self.ensure_animation_watcher();\n    }\n\n    /// Adopt completed jobs on the live simulation thread, with the bridge camera current.\n    fn poll_creature_updates(&mut self) {\n        if !pav_tools::creature_tools::has_updates() {\n            return;\n        }\n        let Some(host) = &self.host else { return };\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(bridge) = &self.bridge {\n            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n                Ok(Some(look)) => self.look_ui.set_look(look),\n                Ok(None) => {}\n                Err(_) => return,\n            }\n        }\n        let rig = self.rig.clone();\n        let view = self.view.clone();\n        let look = self.look_ui.look().clone();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n        #[cfg(target_arch = \"wasm32\")]\n        let feedback = None;\n        if let Some((reports, rig, view, ticket)) = host.query(move |sim| {\n            let live = std::mem::replace(sim, Sim::empty(1));\n            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n            session.look = look;\n            session.feedback = feedback;\n            let reports = pav_tools::creature_tools::poll(&mut session);\n            let (live, rig, view, _) = session.into_live();\n            let ticket = live.live_edit_ticket;\n            *sim = live;\n            (reports, rig, view, ticket)\n        }) {\n            self.rig = rig;\n            self.view = view;\n            #[cfg(not(target_arch = \"wasm32\"))]\n            if let Some(bridge) = &self.bridge {\n                bridge.adopted(ticket);\n            }\n            #[cfg(target_arch = \"wasm32\")]\n            let _ = ticket;\n            for report in reports {\n                self.creature_ui.report(Ok(report));\n            }\n        }\n    }\n\n    fn switch_studio(&mut self, mode: StudioMode) {\n        self.studio_navigation = true;\n        self.set_menu(false);\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if mode != StudioMode::World {\n            if mode == StudioMode::Animation {\n                if let Err(error) = pav_tools::animation_tools::reload_authored() {\n                    self.animation_ui.report(Err(format!(\"Could not load saved animations: {error:#}\")));\n                }\n            }\n            if self.bridge.is_none() {\n                match crate::bridge::Bridge::start(pav_tools::bridge::DEFAULT_ADDR) {\n                    Ok(bridge) => self.bridge = Some(bridge),\n                    Err(error) => {\n                        let message = format!(\"Could not open the live bridge: {error}\");\n                        if mode == StudioMode::Creature {\n                            self.creature_ui.report(Err(message));\n                        } else if mode == StudioMode::Prop {\n                            self.asset_ui.report(Err(message));\n                        } else {\n                            self.animation_ui.report(Err(message));\n                        }\n                    }\n                }\n            }\n        }\n        self.animation_ui.open = mode == StudioMode::Animation;\n        self.asset_ui.open = mode == StudioMode::Prop;\n        self.creature_ui.open = mode == StudioMode::Creature;\n        let tool = match mode {\n            StudioMode::Animation => \"anim_preview\",\n            StudioMode::Prop => \"asset_preview\",\n            StudioMode::Creature => \"creature_preview\",\n            StudioMode::World if self.studio_mode == StudioMode::Creature => \"creature_preview\",\n            StudioMode::World if self.studio_mode == StudioMode::Prop => \"asset_preview\",\n            StudioMode::World => \"anim_preview\",\n        };\n        let action = if mode == StudioMode::World { \"close\" } else { \"open\" };\n        self.studio_command(crate::animation_ui::Command {\n            tool,\n            args: serde_json::json!({\"action\":action}).as_object().unwrap().clone(),\n        });\n    }\n\n    fn ensure_animation_watcher(&mut self) {\n        // An agent may create the first animation directory through the bridge. Attach\n        // then, but do not retry a failed native watcher on every frame.\n        if !self.animation_watch_attempted && crate::animation_watch::AnimationWatcher::directory_exists() {\n            self.animation_watch_attempted = true;\n            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n        }\n    }\n\n    fn menu_action(&mut self, a: MenuAction) {\n        match a {\n            MenuAction::Resume => self.set_menu(false),\n            MenuAction::AnimationStudio => self.switch_studio(StudioMode::Animation),\n            MenuAction::AssetStudio => self.switch_studio(StudioMode::Prop),\n            MenuAction::CreatureStudio => self.switch_studio(StudioMode::Creature),\n            MenuAction::Reset => {\n                self.set_menu(false);\n                self.reset();\n            }\n            MenuAction::LoadScene(name) => {\n                self.set_menu(false);\n                self.load_scene(&name);\n            }\n            MenuAction::NewHero => {\n                self.set_menu(false);\n                if let Some(host) = &self.host {\n                    let (cfg, seed) = (self.sim_config.clone(), self.settings.seed);\n                    host.exec(move |sim| {\n                        crate::save::erase();\n                        if let Ok(mut fresh) = Sim::new(\"town\", seed) {\n                            fresh.config = cfg;\n                            *sim = fresh;\n                        }\n                    });\n                }\n                self.scene_name = \"town\".into();\n                self.toast(\"a new hero arrives in Emberwatch\");\n            }\n            MenuAction::Tuning => {\n                self.set_menu(false);\n                self.panel.open = true;\n            }\n            MenuAction::Look => {\n                self.set_menu(false);\n                self.look_ui.open = true;\n            }\n            MenuAction::Guide => {\n                self.set_menu(false);\n                if self.hud.current.is_some() {\n                    self.guide.station = true;\n                } else {\n                    self.guide.field = true;\n                }\n            }\n            MenuAction::FieldGuide => {\n                self.set_menu(false);\n                self.guide.field = true;\n            }\n            MenuAction::Rooms => {\n                self.set_menu(false);\n                self.open_teleport();\n            }\n            MenuAction::RoomCard => {\n                self.set_menu(false);\n                self.hud.show_card();\n            }\n            MenuAction::Screenshot => {\n                self.set_menu(false);\n                self.screenshot_requested = true;\n            }\n            MenuAction::Feel => {\n                self.set_menu(false);\n                self.feel.open = !self.feel.open;\n                self.feel.auto = false;\n            }\n            MenuAction::Physics => {\n                self.set_menu(false);\n                self.physics.open = !self.physics.open;\n                self.physics.auto = false;\n            }\n            MenuAction::Quit => {\n                self.look_ui.save_if_dirty(true);\n                self.quit = true;\n            }\n            MenuAction::TownPortal => {\n                self.set_menu(false);\n                if let Some(host) = &self.host {\n                    host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n                }\n            }\n            MenuAction::Fullscreen => {\n                if let Some(g) = &self.gfx {\n                    crate::platform::toggle_fullscreen(&g.window);\n                }\n            }\n        }\n    }\n}\n\nimpl App {\n    /// The browser only allows sound after the first click or key press.\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio(&mut self) {\n        if !self.audio_resumed {\n            self.audio_resumed = true;\n            if let Some(a) = &self.audio {\n                a.resume();\n            }\n        }\n    }\n\n    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(\"Shardfall could not start\", &msg);\n        self.fatal = Some(msg);\n        el.exit();\n    }\n}\n\nimpl ApplicationHandler for App {\n    fn resumed(&mut self, el: &ActiveEventLoop) {\n        if self.init_started || self.fatal.is_some() {\n            return;\n        }\n        self.init_started = true;\n        if let Err(e) = self.init(el) {\n            self.fail(el, e);\n        }\n    }\n\n    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {\n            self.on_touch(t, &event);\n            return;\n        }\n        let consumed = match (&mut self.egui_state, &self.gfx) {\n            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n            _ => false,\n        };\n        match event {\n            WindowEvent::CloseRequested => {\n                if let Some(host) = &self.host {\n                    host.exec(|sim| crate::save::save_from(sim));\n                }\n                self.look_ui.save_if_dirty(true);\n                el.exit()\n            }\n            WindowEvent::Focused(false) => {\n                self.input.clear();\n                self.touch.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    let system = matches!(\n                        code,\n                        KeyCode::Escape\n                            | KeyCode::F1\n                            | KeyCode::F2\n                            | KeyCode::F3\n                            | KeyCode::F4\n                            | KeyCode::F5\n                            | KeyCode::F6\n                            | KeyCode::F7\n                            | KeyCode::F8\n                            | KeyCode::F9\n                            | KeyCode::F10\n                            | KeyCode::F11\n                            | KeyCode::F12\n                    );\n                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n                        self.handle_key(code);\n                        if !system && !consumed {\n                            self.latency.press();\n                        }\n                    }\n                    if !consumed || event.state == ElementState::Released {\n                        self.input.key(code, event.state);\n                    }\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n                let lines = match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n                };\n                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if state == ElementState::Pressed && button == MouseButton::Left && !consumed {\n                    self.latency.press();\n                }\n                // In the game the right button is a skill; the middle button turns the camera.\n                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n                    MouseButton::Middle\n                } else {\n                    MouseButton::Right\n                };\n                if button == turn {\n                    self.mouse.right_down = state == ElementState::Pressed && !consumed;\n                } else if !consumed || state == ElementState::Released {\n                    self.input.mouse_button(button, state);\n                }\n            }\n            WindowEvent::CursorMoved { position, .. } => {\n                let p = Vec2::new(position.x as f32, position.y as f32);\n                if self.mouse.right_down {\n                    let d = p - self.mouse.pos;\n                    self.rig.params.yaw = (self.rig.params.yaw - d.x * 0.3 + 540.0).rem_euclid(360.0) - 180.0;\n                    self.rig.params.tilt = (self.rig.params.tilt + d.y * 0.2).clamp(0.0, 90.0);\n                }\n                if (p - self.mouse.pos).length() > 2.0 {\n                    self.input.last_device = Device::KeyboardMouse;\n                }\n                self.mouse.pos = p;\n                self.input.cursor = p;\n            }\n            _ => {}\n        }\n    }\n\n    fn about_to_wait(&mut self, el: &ActiveEventLoop) {\n        #[cfg(target_arch = \"wasm32\")]\n        if let Some(r) = self.pending_gfx.as_ref().and_then(|slot| slot.borrow_mut().take()) {\n            self.pending_gfx = None;\n            if let Err(e) = r.and_then(|gfx| self.finish_init(gfx)) {\n                self.fail(el, e);\n            }\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let _ = el;\n        if let Some(g) = &self.gfx {\n            g.window.request_redraw();\n        }\n    }\n}\n\nfn room_entries(sim: &Sim) -> Vec<RoomEntry> {\n    let mut v: Vec<RoomEntry> = sim\n        .state\n        .world\n        .rooms\n        .iter()\n        .map(|r| RoomEntry {\n            key: r.key.clone(),\n            name: if r.def.name.is_empty() { r.key.clone() } else { r.def.name.clone() },\n            wing: r.def.wing.clone(),\n            about: r.def.about.clone(),\n            ask: r.def.learn.ask.clone(),\n        })\n        .collect();\n    v.sort_by(|a, b| (&a.wing, &a.name).cmp(&(&b.wing, &b.name)));\n    v\n}\n","numLines":1268,"startLine":1000,"totalLines":2267}},"tool_result_meta":[{"id":"toolu_017zvccnA8wnrzqTRrFy7V49","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjF7e9i9A29TiYnaMHPM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Rgp6NDwcR8FvUpRQJ29WQQ","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_app/src/input.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":27214,"cache_read_input_tokens":97504,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":27214},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"a809bfc9-a89c-42c6-a8a6-4a01e4949472","timestamp":"2026-11-05T05:40:01.375Z","request_id":"req_011CgjF7dsaf78SZfYwxai1x","wire_tool_inputs":{"toolu_01Rgp6NDwcR8FvUpRQJ29WQQ":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_app/src/input.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rgp6NDwcR8FvUpRQJ29WQQ","type":"tool_result","content":"1\t//! Devices -> actions. Keyboard keys are bound by physical position (WASD stays WASD on AZERTY).\n2\t//! The fixed system layer (pause, rewind, menus) is handled in `app.rs` and never rebinds.\n3\t\n4\tuse std::collections::HashSet;\n5\t\n6\tuse glam::Vec2;\n7\tuse pav_core::input::buttons;\n8\tuse winit::event::{ElementState, MouseButton};\n9\tuse winit::keyboard::KeyCode;\n10\t\n11\tpub use pav_ui::Device;\n12\t\n13\t/// Game-action bindings (defaults; rooms may override in the future).\n14\tpub struct KeyBinds {\n15\t    pub up: &'static [KeyCode],\n16\t    pub down: &'static [KeyCode],\n17\t    pub left: &'static [KeyCode],\n18\t    pub right: &'static [KeyCode],\n19\t    pub buttons: &'static [(u32, &'static [KeyCode])],\n20\t}\n21\t\n22\tpub const KEYS: KeyBinds = KeyBinds {\n23\t    up: &[KeyCode::KeyW, KeyCode::ArrowUp],\n24\t    down: &[KeyCode::KeyS, KeyCode::ArrowDown],\n25\t    left: &[KeyCode::KeyA, KeyCode::ArrowLeft],\n26\t    right: &[KeyCode::KeyD, KeyCode::ArrowRight],\n27\t    buttons: &[\n28\t        (buttons::JUMP, &[KeyCode::Space]),\n29\t        (buttons::CROUCH, &[KeyCode::KeyC, KeyCode::ControlLeft]),\n30\t        (buttons::CRAWL, &[KeyCode::KeyZ]),\n31\t        (buttons::USE, &[KeyCode::KeyF]),\n32\t        (buttons::FOCUS, &[KeyCode::ShiftLeft]),\n33\t        (buttons::INTERACT, &[KeyCode::KeyE]),\n34\t    ],\n35\t};\n36\t\n37\t/// Physical key names usable in room files (`[keys]`).\n38\tpub fn key_from_name(n: &str) -> Option<KeyCode> {\n39\t    use KeyCode::*;\n40\t    let letters = [\n41\t        KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS, KeyT,\n42\t        KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,\n43\t    ];\n44\t    if let Some(c) = n.strip_prefix(\"Key\").and_then(|l| l.chars().next()).filter(|c| c.is_ascii_uppercase() && n.len() == 4) {\n45\t        return Some(letters[(c as u8 - b'A') as usize]);\n46\t    }\n47\t    let digits = [Digit0, Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8, Digit9];\n48\t    if let Some(d) = n.strip_prefix(\"Digit\").and_then(|d| d.parse::<usize>().ok()).filter(|d| *d < 10) {\n49\t        return Some(digits[d]);\n50\t    }\n51\t    Some(match n {\n52\t        \"Space\" => Space,\n53\t        \"Enter\" => Enter,\n54\t        \"Tab\" => Tab,\n55\t        \"ShiftLeft\" => ShiftLeft,\n56\t        \"ShiftRight\" => ShiftRight,\n57\t        \"ControlLeft\" => ControlLeft,\n58\t        \"ControlRight\" => ControlRight,\n59\t        \"AltLeft\" => AltLeft,\n60\t        \"AltRight\" => AltRight,\n61\t        \"ArrowUp\" => ArrowUp,\n62\t        \"ArrowDown\" => ArrowDown,\n63\t        \"ArrowLeft\" => ArrowLeft,\n64\t        \"ArrowRight\" => ArrowRight,\n65\t        \"Comma\" => Comma,\n66\t        \"Period\" => Period,\n67\t        \"Slash\" => Slash,\n68\t        \"Semicolon\" => Semicolon,\n69\t        \"Quote\" => Quote,\n70\t        \"BracketLeft\" => BracketLeft,\n71\t        \"BracketRight\" => BracketRight,\n72\t        \"Minus\" => Minus,\n73\t        \"Equal\" => Equal,\n74\t        \"CapsLock\" => CapsLock,\n75\t        _ => return None,\n76\t    })\n77\t}\n78\t\n79\t/// Current keyboard bindings: defaults, optionally overridden by the room.\n80\t#[derive(Clone)]\n81\tpub struct Bindings {\n82\t    pub up: Vec<KeyCode>,\n83\t    pub down: Vec<KeyCode>,\n84\t    pub left: Vec<KeyCode>,\n85\t    pub right: Vec<KeyCode>,\n86\t    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n87\t}\n88\t\n89\timpl Default for Bindings {\n90\t    fn default() -> Self {\n91\t        Self {\n92\t            up: KEYS.up.to_vec(),\n93\t            down: KEYS.down.to_vec(),\n94\t            left: KEYS.left.to_vec(),\n95\t            right: KEYS.right.to_vec(),\n96\t            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n97\t        }\n98\t    }\n99\t}\n100\t\n101\timpl Bindings {\n102\t    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n103\t    /// dodge, 1 for a potion, Shift to attack in place.\n104\t    pub fn game() -> Self {\n105\t        use KeyCode::*;\n106\t        Self {\n107\t            up: vec![KeyW, ArrowUp],\n108\t            down: vec![KeyS, ArrowDown],\n109\t            left: vec![KeyA, ArrowLeft],\n110\t            right: vec![KeyD, ArrowRight],\n111\t            buttons: vec![\n112\t                (buttons::SKILL3, vec![KeyQ]),\n113\t                (buttons::SKILL4, vec![KeyE]),\n114\t                (buttons::SKILL5, vec![KeyR]),\n115\t                (buttons::SKILL6, vec![KeyF]),\n116\t                (buttons::DODGE, vec![Space]),\n117\t                (buttons::POTION, vec![Digit1]),\n118\t                (buttons::FOCUS, vec![ShiftLeft]),\n119\t                (buttons::INTERACT, vec![KeyG]),\n120\t            ],\n121\t        }\n122\t    }\n123\t\n124\t    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n125\t    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n126\t        let mut b = Self::default();\n127\t        let mut errs = Vec::new();\n128\t        for (action, names) in map {\n129\t            let keys: Vec<KeyCode> = names\n130\t                .iter()\n131\t                .filter_map(|n| {\n132\t                    let k = key_from_name(n);\n133\t                    if k.is_none() {\n134\t                        errs.push(format!(\"unknown key '{n}'\"));\n135\t                    }\n136\t                    k\n137\t                })\n138\t                .collect();\n139\t            match action.as_str() {\n140\t                \"move_up\" => b.up = keys,\n141\t                \"move_down\" => b.down = keys,\n142\t                \"move_left\" => b.left = keys,\n143\t                \"move_right\" => b.right = keys,\n144\t                other => match pav_core::input::buttons::from_name(other) {\n145\t                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n146\t                        Some(e) => e.1 = keys,\n147\t                        None => b.buttons.push((bit, keys)),\n148\t                    },\n149\t                    None => errs.push(format!(\"unknown action '{other}'\")),\n150\t                },\n151\t            }\n152\t        }\n153\t        (b, errs)\n154\t    }\n155\t}\n156\t\n157\t/// Shardfall's controls.\n158\tpub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n159\t    match device {\n160\t        Device::KeyboardMouse => &[\n161\t            (\"Move\", \"W A S D\"),\n162\t            (\"Aim\", \"mouse\"),\n163\t            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n164\t            (\"Dodge roll\", \"Space (cancels any attack)\"),\n165\t            (\"Potion\", \"1\"),\n166\t            (\"Attack in place\", \"hold Shift\"),\n167\t            (\"Use (trade, portal, way down, chests)\", \"G\"),\n168\t            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n169\t            (\"Town portal\", \"T\"),\n170\t            (\"Pick up\", \"walk over it, or click its name\"),\n171\t            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n172\t            (\"Rewind\", \"hold Backspace\"),\n173\t            (\"Menu / tuning\", \"Esc / F1\"),\n174\t        ],\n175\t        Device::Gamepad => &[\n176\t            (\"Move / aim\", \"left stick / right stick\"),\n177\t            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n178\t            (\"Dodge roll\", \"A\"),\n179\t            (\"Potion\", \"D-pad up\"),\n180\t            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n181\t            (\"Map\", \"D-pad left\"),\n182\t            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n183\t            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n184\t            (\"Menu\", \"Start\"),\n185\t        ],\n186\t        Device::Touch => &[\n187\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n188\t            (\"Attack\", \"automatic: the nearest foe in reach\"),\n189\t            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n190\t            (\"Dodge roll · potion\", \"the big button · the flask\"),\n191\t            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n192\t            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n193\t            (\"Messages and the minimap\", \"swipe them away\"),\n194\t            (\"Close a window\", \"tap the game outside it\"),\n195\t        ],\n196\t    }\n197\t}\n198\t\n199\t/// Human-readable control guide per device.\n200\tpub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n201\t    match device {\n202\t        Device::KeyboardMouse => &[\n203\t            (\"Move\", \"W A S D\"),\n204\t            (\"Jump\", \"Space (hold = higher)\"),\n205\t            (\"Crouch\", \"C / Ctrl (hold)\"),\n206\t            (\"Crawl\", \"Z (toggle)\"),\n207\t            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n208\t            (\"Walk slowly\", \"Shift (instant model)\"),\n209\t            (\"Climb ladder\", \"walk into it\"),\n210\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n211\t            (\"Swim\", \"Space up · C down\"),\n212\t            (\"Dodge roll\", \"C while running (committed model)\"),\n213\t            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n214\t            (\"Vehicles\", \"E get in / out\"),\n215\t            (\"Rewind\", \"hold Backspace\"),\n216\t            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n217\t            (\"Menu / tuning\", \"Esc / F1\"),\n218\t        ],\n219\t        Device::Gamepad => &[\n220\t            (\"Move\", \"left stick\"),\n221\t            (\"Aim\", \"right stick\"),\n222\t            (\"Jump\", \"A (hold = higher)\"),\n223\t            (\"Crouch\", \"B (hold)\"),\n224\t            (\"Crawl\", \"Y (toggle)\"),\n225\t            (\"Throw bomb\", \"X or right trigger\"),\n226\t            (\"Walk slowly\", \"left trigger (instant model)\"),\n227\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n228\t            (\"Swim\", \"A up · B down\"),\n229\t            (\"Dodge roll\", \"B while running (committed model)\"),\n230\t            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n231\t            (\"Vehicles\", \"D-pad right: get in / out\"),\n232\t            (\"Rewind\", \"hold Back/View\"),\n233\t            (\"Menu\", \"Start\"),\n234\t        ],\n235\t        Device::Touch => &[\n236\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n237\t            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n238\t            (\"Menu\", \"top right\"),\n239\t        ],\n240\t    }\n241\t}\n242\t\n243\t#[derive(Default)]\n244\tpub struct Pad {\n245\t    pub left: Vec2,\n246\t    pub right: Vec2,\n247\t    pub held: u32,\n248\t    pub rotate: f32,\n249\t    pub zoom: f32,\n250\t    pub start_pressed: bool,\n251\t    /// D-pad left (the game's map).\n252\t    pub map_pressed: bool,\n253\t    /// Buttons pressed since the last poll (menus read these as taps).\n254\t    pub taps: Vec<gilrs::Button>,\n255\t    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n256\t    pub a_held: bool,\n257\t    pub x_held: bool,\n258\t    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n259\t    pub y_held: bool,\n260\t    pub back_held: bool,\n261\t    pub any_activity: bool,\n262\t}\n263\t\n264\tpub struct Input {\n265\t    pub keys: HashSet<KeyCode>,\n266\t    pub mouse: HashSet<MouseButton>,\n267\t    pub cursor: Vec2,\n268\t    pub mouse_active: bool,\n269\t    pub gilrs: Option<gilrs::Gilrs>,\n270\t    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n271\t    pub pad_script: Option<PadScript>,\n272\t    pub pad: Pad,\n273\t    pub last_device: Device,\n274\t    prev_held: u32,\n275\t    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n276\t    key_taps: HashSet<KeyCode>,\n277\t    pub mouse_taps: HashSet<MouseButton>,\n278\t    pub bindings: Bindings,\n279\t    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n280\t    pub game: bool,\n281\t}\n282\t\n283\t/// A pad's raw state for one frame.\n284\tstruct PadState {\n285\t    left: Vec2,\n286\t    right: Vec2,\n287\t    held: Vec<gilrs::Button>,\n288\t    lt2: bool,\n289\t    rt2: bool,\n290\t}\n291\t\n292\t/// One line of a pad script: hold this for so many frames.\n293\t#[derive(Clone, Debug, Default)]\n294\tpub struct PadStep {\n295\t    pub frames: u32,\n296\t    pub left: Vec2,\n297\t    pub right: Vec2,\n298\t    pub hold: Vec<gilrs::Button>,\n299\t    pub tap: Vec<gilrs::Button>,\n300\t}\n301\t\n302\t/// A scripted gamepad, one step per line:\n303\t/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n304\t/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n305\t/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n306\t#[derive(Clone, Debug, Default)]\n307\tpub struct PadScript {\n308\t    pub steps: Vec<PadStep>,\n309\t    at: usize,\n310\t    frame: u32,\n311\t}\n312\t\n313\timpl PadScript {\n314\t    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n315\t    pub fn parse(text: &str) -> Result<PadScript, String> {\n316\t        let button = |n: &str| -> Result<gilrs::Button, String> {\n317\t            use gilrs::Button as B;\n318\t            Ok(match n {\n319\t                \"South\" | \"A\" => B::South,\n320\t                \"East\" | \"B\" => B::East,\n321\t                \"West\" | \"X\" => B::West,\n322\t                \"North\" | \"Y\" => B::North,\n323\t                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n324\t                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n325\t                \"Start\" => B::Start,\n326\t                \"Select\" => B::Select,\n327\t                \"DPadUp\" => B::DPadUp,\n328\t                \"DPadDown\" => B::DPadDown,\n329\t                \"DPadLeft\" => B::DPadLeft,\n330\t                \"DPadRight\" => B::DPadRight,\n331\t                o => return Err(format!(\"unknown button '{o}'\")),\n332\t            })\n333\t        };\n334\t        let vec = |v: &str| -> Result<Vec2, String> {\n335\t            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n336\t            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n337\t        };\n338\t        let mut steps = Vec::new();\n339\t        for (n, line) in text.lines().enumerate() {\n340\t            let line = line.split('#').next().unwrap_or(\"\").trim();\n341\t            if line.is_empty() {\n342\t                continue;\n343\t            }\n344\t            let mut words = line.split_whitespace();\n345\t            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n346\t            let mut st = PadStep { frames, ..Default::default() };\n347\t            for w in words {\n348\t                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n349\t                match k {\n350\t                    \"left\" => st.left = vec(v)?,\n351\t                    \"right\" => st.right = vec(v)?,\n352\t                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n353\t                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n354\t                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n355\t                }\n356\t            }\n357\t            steps.push(st);\n358\t        }\n359\t        Ok(PadScript { steps, at: 0, frame: 0 })\n360\t    }\n361\t\n362\t    /// This frame's step (and whether it's the step's first frame); None when done.\n363\t    fn next(&mut self) -> Option<(PadStep, bool)> {\n364\t        let st = self.steps.get(self.at)?.clone();\n365\t        let first = self.frame == 0;\n366\t        self.frame += 1;\n367\t        if self.frame >= st.frames.max(1) {\n368\t            self.at += 1;\n369\t            self.frame = 0;\n370\t        }\n371\t        Some((st, first))\n372\t    }\n373\t}\n374\t\n375\tfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n376\t    let l = v.length();\n377\t    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n378\t}\n379\t\n380\timpl Input {\n381\t    pub fn new() -> Self {\n382\t        let gilrs = match gilrs::Gilrs::new() {\n383\t            Ok(g) => {\n384\t                for (_, gp) in g.gamepads() {\n385\t                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n386\t                }\n387\t                Some(g)\n388\t            }\n389\t            Err(e) => {\n390\t                log::warn!(\"gamepads unavailable: {e}\");\n391\t                None\n392\t            }\n393\t        };\n394\t        Self {\n395\t            keys: HashSet::new(),\n396\t            mouse: HashSet::new(),\n397\t            cursor: Vec2::ZERO,\n398\t            mouse_active: false,\n399\t            gilrs,\n400\t            pad_script: None,\n401\t            pad: Pad::default(),\n402\t            last_device: Device::KeyboardMouse,\n403\t            prev_held: 0,\n404\t            key_taps: HashSet::new(),\n405\t            mouse_taps: HashSet::new(),\n406\t            bindings: Bindings::default(),\n407\t            game: false,\n408\t        }\n409\t    }\n410\t\n411\t    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n412\t        self.last_device = Device::KeyboardMouse;\n413\t        match state {\n414\t            ElementState::Pressed => {\n415\t                self.keys.insert(code);\n416\t                self.key_taps.insert(code);\n417\t            }\n418\t            ElementState::Released => {\n419\t                self.keys.remove(&code);\n420\t            }\n421\t        }\n422\t    }\n423\t\n424\t    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n425\t        self.last_device = Device::KeyboardMouse;\n426\t        self.mouse_active = true;\n427\t        match state {\n428\t            ElementState::Pressed => {\n429\t                self.mouse.insert(b);\n430\t                self.mouse_taps.insert(b);\n431\t            }\n432\t            ElementState::Released => {\n433\t                self.mouse.remove(&b);\n434\t            }\n435\t        }\n436\t    }\n437\t\n438\t    pub fn clear(&mut self) {\n439\t        self.keys.clear();\n440\t        self.mouse.clear();\n441\t    }\n442\t\n443\t    /// Reads gamepad events and state (first connected pad).\n444\t    pub fn poll_gamepad(&mut self) {\n445\t        use gilrs::{Axis, Button};\n446\t        let mut activity = false;\n447\t        let mut taps = Vec::new();\n448\t        // One pad state from the first connected pad, or from the pad script while it runs.\n449\t        let mut state: Option<PadState> = None;\n450\t        if let Some(g) = &mut self.gilrs {\n451\t            while let Some(ev) = g.next_event() {\n452\t                match ev.event {\n453\t                    gilrs::EventType::ButtonPressed(b, _) => {\n454\t                        taps.push(b);\n455\t                        activity = true;\n456\t                    }\n457\t                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n458\t                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n459\t                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n460\t                    _ => {}\n461\t                }\n462\t            }\n463\t            if let Some((_, gp)) = g.gamepads().next() {\n464\t                const ALL: [Button; 15] = [\n465\t                    Button::South,\n466\t                    Button::East,\n467\t                    Button::North,\n468\t                    Button::West,\n469\t                    Button::LeftTrigger,\n470\t                    Button::RightTrigger,\n471\t                    Button::Select,\n472\t                    Button::Start,\n473\t                    Button::DPadUp,\n474\t                    Button::DPadDown,\n475\t                    Button::DPadLeft,\n476\t                    Button::DPadRight,\n477\t                    Button::LeftThumb,\n478\t                    Button::RightThumb,\n479\t                    Button::Mode,\n480\t                ];\n481\t                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n482\t                state = Some(PadState {\n483\t                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n484\t                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n485\t                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n486\t                    lt2: trig(Button::LeftTrigger2),\n487\t                    rt2: trig(Button::RightTrigger2),\n488\t                });\n489\t            }\n490\t        }\n491\t        if let Some(script) = &mut self.pad_script {\n492\t            if let Some((st, first)) = script.next() {\n493\t                if first {\n494\t                    taps.extend(st.tap.iter().copied());\n495\t                }\n496\t                activity = true;\n497\t                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n498\t            }\n499\t        }\n500\t        let start = taps.contains(&Button::Start);\n501\t        let map = taps.contains(&Button::DPadLeft);\n502\t        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n503\t        if let Some(st) = state {\n504\t            let is = |b: Button| st.held.contains(&b);\n505\t            pad.left = deadzone(st.left, 0.18);\n506\t            pad.right = deadzone(st.right, 0.25);\n507\t            let mut held = 0;\n508\t            let layout: &[(Button, u32)] = if self.game {\n509\t                &[\n510\t                    (Button::West, buttons::PRIMARY),\n511\t                    (Button::North, buttons::SECONDARY),\n512\t                    (Button::East, buttons::SKILL3),\n513\t                    (Button::RightTrigger, buttons::SKILL4),\n514\t                    (Button::LeftTrigger, buttons::SKILL5),\n515\t                    (Button::South, buttons::DODGE),\n516\t                    (Button::DPadUp, buttons::POTION),\n517\t                    (Button::DPadRight, buttons::INTERACT),\n518\t                ]\n519\t            } else {\n520\t                &[\n521\t                    (Button::South, buttons::JUMP),\n522\t                    (Button::East, buttons::CROUCH),\n523\t                    (Button::North, buttons::CRAWL),\n524\t                    (Button::West, buttons::USE),\n525\t                    (Button::DPadRight, buttons::INTERACT),\n526\t                ]\n527\t            };\n528\t            for (btn, action) in layout {\n529\t                if is(*btn) {\n530\t                    held |= action;\n531\t                }\n532\t            }\n533\t            if st.rt2 {\n534\t                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n535\t            }\n536\t            if st.lt2 {\n537\t                held |= buttons::FOCUS;\n538\t            }\n539\t            pad.held = held;\n540\t            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n541\t            // In the game the D-pad is potion / use / map / panels, not zoom.\n542\t            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n543\t            pad.a_held = is(Button::South);\n544\t            pad.x_held = is(Button::West);\n545\t            pad.y_held = is(Button::North);\n546\t            pad.back_held = is(Button::Select);\n547\t            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n548\t                pad.any_activity = true;\n549\t            }\n550\t        }\n551\t        if pad.any_activity {\n552\t            self.last_device = Device::Gamepad;\n553\t        }\n554\t        self.pad = pad;\n555\t    }\n556\t\n557\t    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n558\t    pub fn move_axis(&self) -> Vec2 {\n559\t        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n560\t        let b = &self.bindings;\n561\t        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n562\t        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n563\t        v.clamp_length_max(1.0)\n564\t    }\n565\t\n566\t    /// Held game buttons from all devices.\n567\t    pub fn held(&self) -> u32 {\n568\t        let mut b = self.pad.held;\n569\t        for (bit, codes) in &self.bindings.buttons {\n570\t            if codes.iter().any(|c| self.keys.contains(c)) {\n571\t                b |= bit;\n572\t            }\n573\t        }\n574\t        if self.mouse.contains(&MouseButton::Left) {\n575\t            b |= buttons::PRIMARY;\n576\t        }\n577\t        if self.game && self.mouse.contains(&MouseButton::Right) {\n578\t            b |= buttons::SECONDARY;\n579\t        }\n580\t        b\n581\t    }\n582\t\n583\t    /// Returns (held, newly pressed since the last call).\n584\t    pub fn buttons(&mut self) -> (u32, u32) {\n585\t        let held = self.held();\n586\t        let mut pressed = held & !self.prev_held;\n587\t        for (bit, codes) in &self.bindings.buttons {\n588\t            if codes.iter().any(|c| self.key_taps.contains(c)) {\n589\t                pressed |= bit;\n590\t            }\n591\t        }\n592\t        if self.mouse_taps.contains(&MouseButton::Left) {\n593\t            pressed |= buttons::PRIMARY;\n594\t        }\n595\t        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n596\t            pressed |= buttons::SECONDARY;\n597\t        }\n598\t        self.key_taps.clear();\n599\t        self.mouse_taps.clear();\n600\t        self.prev_held = held;\n601\t        // A tap shorter than a frame still counts as held for that frame.\n602\t        (held | pressed, pressed)\n603\t    }\n604\t\n605\t    /// True if `b` was pressed since the last call (consumes the tap).\n606\t    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n607\t        self.mouse_taps.remove(&b)\n608\t    }\n609\t\n610\t    pub fn rewind_held(&self) -> bool {\n611\t        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n612\t    }\n613\t}\n614\t\n615\t#[cfg(test)]\n616\tmod pad_script_tests {\n617\t    use super::*;\n618\t\n619\t    #[test]\n620\t    fn pad_scripts_parse_and_play() {\n621\t        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n622\t        assert_eq!(p.steps.len(), 3);\n623\t        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n624\t        assert_eq!(frames.len(), 6);\n625\t        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n626\t        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n627\t        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n628\t        assert!(PadScript::parse(\"x tap=A\").is_err());\n629\t        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n630\t    }\n631\t}\n632\t"}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"9ade9da0-d07b-4701-b843-9590f38bb6ba","timestamp":"2026-11-05T05:40:01.400Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_app/src/input.rs","content":"//! Devices -> actions. Keyboard keys are bound by physical position (WASD stays WASD on AZERTY).\n//! The fixed system layer (pause, rewind, menus) is handled in `app.rs` and never rebinds.\n\nuse std::collections::HashSet;\n\nuse glam::Vec2;\nuse pav_core::input::buttons;\nuse winit::event::{ElementState, MouseButton};\nuse winit::keyboard::KeyCode;\n\npub use pav_ui::Device;\n\n/// Game-action bindings (defaults; rooms may override in the future).\npub struct KeyBinds {\n    pub up: &'static [KeyCode],\n    pub down: &'static [KeyCode],\n    pub left: &'static [KeyCode],\n    pub right: &'static [KeyCode],\n    pub buttons: &'static [(u32, &'static [KeyCode])],\n}\n\npub const KEYS: KeyBinds = KeyBinds {\n    up: &[KeyCode::KeyW, KeyCode::ArrowUp],\n    down: &[KeyCode::KeyS, KeyCode::ArrowDown],\n    left: &[KeyCode::KeyA, KeyCode::ArrowLeft],\n    right: &[KeyCode::KeyD, KeyCode::ArrowRight],\n    buttons: &[\n        (buttons::JUMP, &[KeyCode::Space]),\n        (buttons::CROUCH, &[KeyCode::KeyC, KeyCode::ControlLeft]),\n        (buttons::CRAWL, &[KeyCode::KeyZ]),\n        (buttons::USE, &[KeyCode::KeyF]),\n        (buttons::FOCUS, &[KeyCode::ShiftLeft]),\n        (buttons::INTERACT, &[KeyCode::KeyE]),\n    ],\n};\n\n/// Physical key names usable in room files (`[keys]`).\npub fn key_from_name(n: &str) -> Option<KeyCode> {\n    use KeyCode::*;\n    let letters = [\n        KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS, KeyT,\n        KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,\n    ];\n    if let Some(c) = n.strip_prefix(\"Key\").and_then(|l| l.chars().next()).filter(|c| c.is_ascii_uppercase() && n.len() == 4) {\n        return Some(letters[(c as u8 - b'A') as usize]);\n    }\n    let digits = [Digit0, Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8, Digit9];\n    if let Some(d) = n.strip_prefix(\"Digit\").and_then(|d| d.parse::<usize>().ok()).filter(|d| *d < 10) {\n        return Some(digits[d]);\n    }\n    Some(match n {\n        \"Space\" => Space,\n        \"Enter\" => Enter,\n        \"Tab\" => Tab,\n        \"ShiftLeft\" => ShiftLeft,\n        \"ShiftRight\" => ShiftRight,\n        \"ControlLeft\" => ControlLeft,\n        \"ControlRight\" => ControlRight,\n        \"AltLeft\" => AltLeft,\n        \"AltRight\" => AltRight,\n        \"ArrowUp\" => ArrowUp,\n        \"ArrowDown\" => ArrowDown,\n        \"ArrowLeft\" => ArrowLeft,\n        \"ArrowRight\" => ArrowRight,\n        \"Comma\" => Comma,\n        \"Period\" => Period,\n        \"Slash\" => Slash,\n        \"Semicolon\" => Semicolon,\n        \"Quote\" => Quote,\n        \"BracketLeft\" => BracketLeft,\n        \"BracketRight\" => BracketRight,\n        \"Minus\" => Minus,\n        \"Equal\" => Equal,\n        \"CapsLock\" => CapsLock,\n        _ => return None,\n    })\n}\n\n/// Current keyboard bindings: defaults, optionally overridden by the room.\n#[derive(Clone)]\npub struct Bindings {\n    pub up: Vec<KeyCode>,\n    pub down: Vec<KeyCode>,\n    pub left: Vec<KeyCode>,\n    pub right: Vec<KeyCode>,\n    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n}\n\nimpl Default for Bindings {\n    fn default() -> Self {\n        Self {\n            up: KEYS.up.to_vec(),\n            down: KEYS.down.to_vec(),\n            left: KEYS.left.to_vec(),\n            right: KEYS.right.to_vec(),\n            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n        }\n    }\n}\n\nimpl Bindings {\n    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n    /// dodge, 1 for a potion, Shift to attack in place.\n    pub fn game() -> Self {\n        use KeyCode::*;\n        Self {\n            up: vec![KeyW, ArrowUp],\n            down: vec![KeyS, ArrowDown],\n            left: vec![KeyA, ArrowLeft],\n            right: vec![KeyD, ArrowRight],\n            buttons: vec![\n                (buttons::SKILL3, vec![KeyQ]),\n                (buttons::SKILL4, vec![KeyE]),\n                (buttons::SKILL5, vec![KeyR]),\n                (buttons::SKILL6, vec![KeyF]),\n                (buttons::DODGE, vec![Space]),\n                (buttons::POTION, vec![Digit1]),\n                (buttons::FOCUS, vec![ShiftLeft]),\n                (buttons::INTERACT, vec![KeyG]),\n            ],\n        }\n    }\n\n    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n        let mut b = Self::default();\n        let mut errs = Vec::new();\n        for (action, names) in map {\n            let keys: Vec<KeyCode> = names\n                .iter()\n                .filter_map(|n| {\n                    let k = key_from_name(n);\n                    if k.is_none() {\n                        errs.push(format!(\"unknown key '{n}'\"));\n                    }\n                    k\n                })\n                .collect();\n            match action.as_str() {\n                \"move_up\" => b.up = keys,\n                \"move_down\" => b.down = keys,\n                \"move_left\" => b.left = keys,\n                \"move_right\" => b.right = keys,\n                other => match pav_core::input::buttons::from_name(other) {\n                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n                        Some(e) => e.1 = keys,\n                        None => b.buttons.push((bit, keys)),\n                    },\n                    None => errs.push(format!(\"unknown action '{other}'\")),\n                },\n            }\n        }\n        (b, errs)\n    }\n}\n\n/// Shardfall's controls.\npub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Aim\", \"mouse\"),\n            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n            (\"Dodge roll\", \"Space (cancels any attack)\"),\n            (\"Potion\", \"1\"),\n            (\"Attack in place\", \"hold Shift\"),\n            (\"Use (trade, portal, way down, chests)\", \"G\"),\n            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n            (\"Town portal\", \"T\"),\n            (\"Pick up\", \"walk over it, or click its name\"),\n            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move / aim\", \"left stick / right stick\"),\n            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n            (\"Dodge roll\", \"A\"),\n            (\"Potion\", \"D-pad up\"),\n            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n            (\"Map\", \"D-pad left\"),\n            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Attack\", \"automatic: the nearest foe in reach\"),\n            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n            (\"Dodge roll · potion\", \"the big button · the flask\"),\n            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n            (\"Messages and the minimap\", \"swipe them away\"),\n            (\"Close a window\", \"tap the game outside it\"),\n        ],\n    }\n}\n\n/// Human-readable control guide per device.\npub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Jump\", \"Space (hold = higher)\"),\n            (\"Crouch\", \"C / Ctrl (hold)\"),\n            (\"Crawl\", \"Z (toggle)\"),\n            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n            (\"Walk slowly\", \"Shift (instant model)\"),\n            (\"Climb ladder\", \"walk into it\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"Space up · C down\"),\n            (\"Dodge roll\", \"C while running (committed model)\"),\n            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n            (\"Vehicles\", \"E get in / out\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move\", \"left stick\"),\n            (\"Aim\", \"right stick\"),\n            (\"Jump\", \"A (hold = higher)\"),\n            (\"Crouch\", \"B (hold)\"),\n            (\"Crawl\", \"Y (toggle)\"),\n            (\"Throw bomb\", \"X or right trigger\"),\n            (\"Walk slowly\", \"left trigger (instant model)\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"A up · B down\"),\n            (\"Dodge roll\", \"B while running (committed model)\"),\n            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n            (\"Vehicles\", \"D-pad right: get in / out\"),\n            (\"Rewind\", \"hold Back/View\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n            (\"Menu\", \"top right\"),\n        ],\n    }\n}\n\n#[derive(Default)]\npub struct Pad {\n    pub left: Vec2,\n    pub right: Vec2,\n    pub held: u32,\n    pub rotate: f32,\n    pub zoom: f32,\n    pub start_pressed: bool,\n    /// D-pad left (the game's map).\n    pub map_pressed: bool,\n    /// Buttons pressed since the last poll (menus read these as taps).\n    pub taps: Vec<gilrs::Button>,\n    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n    pub a_held: bool,\n    pub x_held: bool,\n    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n    pub y_held: bool,\n    pub back_held: bool,\n    pub any_activity: bool,\n}\n\npub struct Input {\n    pub keys: HashSet<KeyCode>,\n    pub mouse: HashSet<MouseButton>,\n    pub cursor: Vec2,\n    pub mouse_active: bool,\n    pub gilrs: Option<gilrs::Gilrs>,\n    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n    pub pad_script: Option<PadScript>,\n    pub pad: Pad,\n    pub last_device: Device,\n    prev_held: u32,\n    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n    key_taps: HashSet<KeyCode>,\n    pub mouse_taps: HashSet<MouseButton>,\n    pub bindings: Bindings,\n    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n    pub game: bool,\n}\n\n/// A pad's raw state for one frame.\nstruct PadState {\n    left: Vec2,\n    right: Vec2,\n    held: Vec<gilrs::Button>,\n    lt2: bool,\n    rt2: bool,\n}\n\n/// One line of a pad script: hold this for so many frames.\n#[derive(Clone, Debug, Default)]\npub struct PadStep {\n    pub frames: u32,\n    pub left: Vec2,\n    pub right: Vec2,\n    pub hold: Vec<gilrs::Button>,\n    pub tap: Vec<gilrs::Button>,\n}\n\n/// A scripted gamepad, one step per line:\n/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n#[derive(Clone, Debug, Default)]\npub struct PadScript {\n    pub steps: Vec<PadStep>,\n    at: usize,\n    frame: u32,\n}\n\nimpl PadScript {\n    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n    pub fn parse(text: &str) -> Result<PadScript, String> {\n        let button = |n: &str| -> Result<gilrs::Button, String> {\n            use gilrs::Button as B;\n            Ok(match n {\n                \"South\" | \"A\" => B::South,\n                \"East\" | \"B\" => B::East,\n                \"West\" | \"X\" => B::West,\n                \"North\" | \"Y\" => B::North,\n                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n                \"Start\" => B::Start,\n                \"Select\" => B::Select,\n                \"DPadUp\" => B::DPadUp,\n                \"DPadDown\" => B::DPadDown,\n                \"DPadLeft\" => B::DPadLeft,\n                \"DPadRight\" => B::DPadRight,\n                o => return Err(format!(\"unknown button '{o}'\")),\n            })\n        };\n        let vec = |v: &str| -> Result<Vec2, String> {\n            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n        };\n        let mut steps = Vec::new();\n        for (n, line) in text.lines().enumerate() {\n            let line = line.split('#').next().unwrap_or(\"\").trim();\n            if line.is_empty() {\n                continue;\n            }\n            let mut words = line.split_whitespace();\n            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n            let mut st = PadStep { frames, ..Default::default() };\n            for w in words {\n                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n                match k {\n                    \"left\" => st.left = vec(v)?,\n                    \"right\" => st.right = vec(v)?,\n                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n                }\n            }\n            steps.push(st);\n        }\n        Ok(PadScript { steps, at: 0, frame: 0 })\n    }\n\n    /// This frame's step (and whether it's the step's first frame); None when done.\n    fn next(&mut self) -> Option<(PadStep, bool)> {\n        let st = self.steps.get(self.at)?.clone();\n        let first = self.frame == 0;\n        self.frame += 1;\n        if self.frame >= st.frames.max(1) {\n            self.at += 1;\n            self.frame = 0;\n        }\n        Some((st, first))\n    }\n}\n\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n    let l = v.length();\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n}\n\nimpl Input {\n    pub fn new() -> Self {\n        let gilrs = match gilrs::Gilrs::new() {\n            Ok(g) => {\n                for (_, gp) in g.gamepads() {\n                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n                }\n                Some(g)\n            }\n            Err(e) => {\n                log::warn!(\"gamepads unavailable: {e}\");\n                None\n            }\n        };\n        Self {\n            keys: HashSet::new(),\n            mouse: HashSet::new(),\n            cursor: Vec2::ZERO,\n            mouse_active: false,\n            gilrs,\n            pad_script: None,\n            pad: Pad::default(),\n            last_device: Device::KeyboardMouse,\n            prev_held: 0,\n            key_taps: HashSet::new(),\n            mouse_taps: HashSet::new(),\n            bindings: Bindings::default(),\n            game: false,\n        }\n    }\n\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        match state {\n            ElementState::Pressed => {\n                self.keys.insert(code);\n                self.key_taps.insert(code);\n            }\n            ElementState::Released => {\n                self.keys.remove(&code);\n            }\n        }\n    }\n\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_active = true;\n        match state {\n            ElementState::Pressed => {\n                self.mouse.insert(b);\n                self.mouse_taps.insert(b);\n            }\n            ElementState::Released => {\n                self.mouse.remove(&b);\n            }\n        }\n    }\n\n    pub fn clear(&mut self) {\n        self.keys.clear();\n        self.mouse.clear();\n    }\n\n    /// Reads gamepad events and state (first connected pad).\n    pub fn poll_gamepad(&mut self) {\n        use gilrs::{Axis, Button};\n        let mut activity = false;\n        let mut taps = Vec::new();\n        // One pad state from the first connected pad, or from the pad script while it runs.\n        let mut state: Option<PadState> = None;\n        if let Some(g) = &mut self.gilrs {\n            while let Some(ev) = g.next_event() {\n                match ev.event {\n                    gilrs::EventType::ButtonPressed(b, _) => {\n                        taps.push(b);\n                        activity = true;\n                    }\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n                    _ => {}\n                }\n            }\n            if let Some((_, gp)) = g.gamepads().next() {\n                const ALL: [Button; 15] = [\n                    Button::South,\n                    Button::East,\n                    Button::North,\n                    Button::West,\n                    Button::LeftTrigger,\n                    Button::RightTrigger,\n                    Button::Select,\n                    Button::Start,\n                    Button::DPadUp,\n                    Button::DPadDown,\n                    Button::DPadLeft,\n                    Button::DPadRight,\n                    Button::LeftThumb,\n                    Button::RightThumb,\n                    Button::Mode,\n                ];\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n                state = Some(PadState {\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n                    lt2: trig(Button::LeftTrigger2),\n                    rt2: trig(Button::RightTrigger2),\n                });\n            }\n        }\n        if let Some(script) = &mut self.pad_script {\n            if let Some((st, first)) = script.next() {\n                if first {\n                    taps.extend(st.tap.iter().copied());\n                }\n                activity = true;\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n            }\n        }\n        let start = taps.contains(&Button::Start);\n        let map = taps.contains(&Button::DPadLeft);\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n        if let Some(st) = state {\n            let is = |b: Button| st.held.contains(&b);\n            pad.left = deadzone(st.left, 0.18);\n            pad.right = deadzone(st.right, 0.25);\n            let mut held = 0;\n            let layout: &[(Button, u32)] = if self.game {\n                &[\n                    (Button::West, buttons::PRIMARY),\n                    (Button::North, buttons::SECONDARY),\n                    (Button::East, buttons::SKILL3),\n                    (Button::RightTrigger, buttons::SKILL4),\n                    (Button::LeftTrigger, buttons::SKILL5),\n                    (Button::South, buttons::DODGE),\n                    (Button::DPadUp, buttons::POTION),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            } else {\n                &[\n                    (Button::South, buttons::JUMP),\n                    (Button::East, buttons::CROUCH),\n                    (Button::North, buttons::CRAWL),\n                    (Button::West, buttons::USE),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            };\n            for (btn, action) in layout {\n                if is(*btn) {\n                    held |= action;\n                }\n            }\n            if st.rt2 {\n                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n            }\n            if st.lt2 {\n                held |= buttons::FOCUS;\n            }\n            pad.held = held;\n            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n            // In the game the D-pad is potion / use / map / panels, not zoom.\n            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n            pad.a_held = is(Button::South);\n            pad.x_held = is(Button::West);\n            pad.y_held = is(Button::North);\n            pad.back_held = is(Button::Select);\n            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n                pad.any_activity = true;\n            }\n        }\n        if pad.any_activity {\n            self.last_device = Device::Gamepad;\n        }\n        self.pad = pad;\n    }\n\n    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n    pub fn move_axis(&self) -> Vec2 {\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n        let b = &self.bindings;\n        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n        v.clamp_length_max(1.0)\n    }\n\n    /// Held game buttons from all devices.\n    pub fn held(&self) -> u32 {\n        let mut b = self.pad.held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.keys.contains(c)) {\n                b |= bit;\n            }\n        }\n        if self.mouse.contains(&MouseButton::Left) {\n            b |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse.contains(&MouseButton::Right) {\n            b |= buttons::SECONDARY;\n        }\n        b\n    }\n\n    /// Returns (held, newly pressed since the last call).\n    pub fn buttons(&mut self) -> (u32, u32) {\n        let held = self.held();\n        let mut pressed = held & !self.prev_held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.key_taps.contains(c)) {\n                pressed |= bit;\n            }\n        }\n        if self.mouse_taps.contains(&MouseButton::Left) {\n            pressed |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n            pressed |= buttons::SECONDARY;\n        }\n        self.key_taps.clear();\n        self.mouse_taps.clear();\n        self.prev_held = held;\n        // A tap shorter than a frame still counts as held for that frame.\n        (held | pressed, pressed)\n    }\n\n    /// True if `b` was pressed since the last call (consumes the tap).\n    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n        self.mouse_taps.remove(&b)\n    }\n\n    pub fn rewind_held(&self) -> bool {\n        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n    }\n}\n\n#[cfg(test)]\nmod pad_script_tests {\n    use super::*;\n\n    #[test]\n    fn pad_scripts_parse_and_play() {\n        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n        assert_eq!(p.steps.len(), 3);\n        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n        assert_eq!(frames.len(), 6);\n        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n        assert!(PadScript::parse(\"x tap=A\").is_err());\n        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n    }\n}\n","numLines":632,"startLine":1,"totalLines":632}},"tool_result_meta":[{"id":"toolu_01Rgp6NDwcR8FvUpRQJ29WQQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
