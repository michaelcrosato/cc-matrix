.and_then(|id| sim.feet(id)).unwrap_or(n.pos);\n            ui.world_ring(at + glam::Vec3::Y * 0.05, 1.25, SUN);\n        }\n        if let Some((q, _)) = &self.island_quip {\n            let text: String = q.text().chars().take(q.shown as usize).collect();''')\n\n# ---- the Commodore: a body and two wings, rotated in code\nsub(F/'flow.rs', '''/// Builds the About pages from the page's plain-text block''', '''/// Commodore Gull on his post: the body and two wings, three entities with no physics.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct CommodoreRig {\n    pub wings: Vec<EntityId>,\n    pub shoulder: Vec3,\n    pub rot: Quat,\n    pub phase: f32,\n}\n\n/// Rigs every `commodore` a set has placed.\npub fn spawn_commodores(sim: &mut Sim) -> Vec<CommodoreRig> {\n    let found: Vec<(Vec3, Quat)> = sim.state.entities.iter().filter(|e| e.name == \"commodore\").map(|e| (e.pos, e.rot)).collect();\n    let mut out = Vec::new();\n    for (i, (pos, rot)) in found.into_iter().enumerate() {\n        let shoulder = pos + Vec3::Y * 1.2 + rot * Vec3::new(0.0, 0.0, -0.05);\n        let wing_l = spawn_prop(sim, \"LIB/core/gull_wing\", shoulder, 0.0, 1.5);\n        let wing_r = spawn_prop(sim, \"LIB/core/gull_wing\", shoulder, std::f32::consts::PI, 1.5);\n        out.push(CommodoreRig { wings: vec![wing_l, wing_r], shoulder, rot, phase: i as f32 * 1.7 });\n    }\n    out\n}\n\n/// Wings folded and twitching; they make his points for him while he talks.\nfn tick_commodores(rigs: &[CommodoreRig], sim: &mut Sim, t: f32, talking: bool) {\n    for g in rigs {\n        let lift = if talking { -0.35 + (t * 9.0 + g.phase).sin() * 0.55 } else { -1.05 + (t * 0.9 + g.phase).sin().powi(9) * 0.3 };\n        for (i, w) in g.wings.iter().enumerate() {\n            let side = if i == 0 { 1.0 } else { -1.0 };\n            let q = g.rot * Quat::from_rotation_z(side * lift) * if i == 1 { Quat::from_rotation_y(std::f32::consts::PI) } else { Quat::IDENTITY };\n            pose(sim, *w, g.shoulder, q);\n        }\n    }\n}\n\n/// Builds the About pages from the page's plain-text block''')\nsub(F/'flow.rs', '''            self.gulls = gulls;\n            if self.clam_pulse > 0.0 {''', '''            self.gulls = gulls;\n            let talking = self.gull_talking();\n            tick_commodores(&self.commodores, sim, t, talking);\n            if self.clam_pulse > 0.0 {''')\nsub(F/'flow.rs', '''    /// One tick of whichever screen is up. Returns the player's walking direction.''', '''    /// Commodore Gull has the floor.\n    fn gull_talking(&self) -> bool {\n        let his = |d: &Dialog| d.who == Who::Gull;\n        let run = match &self.flow {\n            Flow::Event(r) => r.c.quip.as_ref().is_some_and(his),\n            Flow::Medley(m) => m.run.as_ref().is_some_and(|r| r.c.quip.as_ref().is_some_and(his)),\n            _ => false,\n        };\n        run || self.dialog.as_ref().is_some_and(his) || self.island_quip.as_ref().is_some_and(|(d, _)| his(d))\n    }\n\n    /// One tick of whichever screen is up. Returns the player's walking direction.''')\nsub(F/'mod.rs', '    pub gulls: Vec<flow::GullRig>,\\n', '    pub gulls: Vec<flow::GullRig>,\\n    pub commodores: Vec<flow::CommodoreRig>,\\n')\nsub(F/'mod.rs', '        gulls: Vec::new(),\\n', '        gulls: Vec::new(),\\n        commodores: Vec::new(),\\n')\nsub(F/'mod.rs', '    game.gulls = flow::spawn_gulls(sim, stages[0]);\\n', '    game.gulls = flow::spawn_gulls(sim, stages[0]);\\n    game.commodores = flow::spawn_commodores(sim);\\n')\n\n# ---- the two sounds nothing played\nsub(F/'events/lap.rs', '''        if self.stitch >= 1.0 {\n            self.stitch = 0.3;''', '''        // Past halfway to a stitch, you can hear your heart.\n        if self.stitch > 0.5 && (c.t * 1.8).floor() != ((c.t - dt) * 1.8).floor() {\n            cx.sfx(sound::HEARTBEAT, 0.7, 1.0);\n        }\n        if self.stitch >= 1.0 {\n            self.stitch = 0.3;''')\nsub(F/'events/paddle.rs', '''                c.core.settle();\n                cx.sfx(sound::BOARD, 0.7, 1.0);''', '''                c.core.settle();\n                cx.sfx(sound::BOARD, 0.7, 1.0);\n                cx.sfx(sound::SPLASH_S, 0.6, 1.0);''')\nsub(F/'finale.rs', '''                c.core.settle();\n                place(cx.sim, cx.pid, self.post, 0.0);''', '''                c.core.settle();\n                place(cx.sim, cx.pid, self.post, 0.0);\n                cx.sfx(sound::SPLASH_S, 0.7, 1.0);''')\nsub(F/'flow.rs', '''            // Should anyone manage the sea after all: back to the desk, dry.\n''', '''            // Should anyone manage the sea after all: back to the desk, dry.\n            sfx(ev, sound::SPLASH_S, 0.8, 1.0);\n''')\n\n# ---- ghosts match by area, one rule for everyone\nsub(F/'ghost.rs', '''fn r2(x: f32) -> f32 {''', '''/// Only a ghost in your own event is drawn; -1 means not in one yet.\npub fn same_area(theirs: i64, mine: i64) -> bool {\n    mine >= 0 && theirs == mine\n}\n\nfn r2(x: f32) -> f32 {''')\nsub('engine/crates/pav_app/src/weblink.rs', 'for g in hub.ghosts.iter().filter(|g| g.area == area) {', 'for g in hub.ghosts.iter().filter(|g| pav_core::games::fit::ghost::same_area(g.area, area)) {')\n\n# ---- sets\ns = pathlib.Path('tools/make_sets.py')\ndef ss(old, new):\n    t = s.read_text(); assert t.count(old) == 1, old[:60]; s.write_text(t.replace(old, new))\nss('''def water_room(name, size=60, color=SEA):''', '''def bubbles(r, spots, color=\"#ffffff\"):\n    # Visual only: an invisible emitter under the surface.\n    for (x, z) in spots:\n        r.obj(None, x, -0.1, z, shape={\"type\": \"sphere\", \"radius\": 0.01}, color=color, body=\"none\",\n              particles={\"preset\": \"bubbles\", \"rate\": 2.5, \"area\": [1.4, 0.0, 1.4], \"offset\": [0.0, 0.0, 0.0]})\n\ndef water_room(name, size=60, color=SEA):''')\nss('''        r.obj(\"LIB/core/lamp_post\", x, -0.0, z)\n    r.write()''', '''        r.obj(\"LIB/core/lamp_post\", x, -0.0, z)\n    bubbles(r, [(-7.5, 3.5), (8.0, 2.5), (-3.5, -8.0), (5.0, -8.5)])\n    r.write()''')\nss('''    r.obj(\"LIB/core/gull_captain\", 6.5, -0.6, -6.5, yaw=-30)\n''', '''    r.obj(\"LIB/core/gull_captain\", 6.5, -0.6, -6.5, yaw=-30, name=\"commodore\")\n    bubbles(r, [(-6.5, 5.5), (6.5, 5.5), (-7.0, -5.5)])\n''')\nss('''    r.npc(\"cheer1\", \"biped\", 14, -200, yaw=-120, look=guest(shirt=\"#ffd166\", helm=\"none\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n''', '''    r.npc(\"cheer1\", \"biped\", 14, -200, yaw=-120, look=guest(shirt=\"#ffd166\", helm=\"none\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n    r.obj(\"LIB/core/gull_captain\", -10.8, -0.6, -6, yaw=50, name=\"commodore\")\n''')\nss('''    r.obj(\"LIB/core/lounge_chair\", -1.4, 0, -105, yaw=180)\n''', '''    r.obj(\"LIB/core/lounge_chair\", -1.4, 0, -105, yaw=180)\n    r.obj(\"LIB/core/gull_captain\", 3.7, -0.6, -7, yaw=-60, name=\"commodore\")\n''')\nss('''        r.obj(\"LIB/core/scorecard\", x, 0.4, z, yaw=-90, scale=1.3)\n''', '''        r.obj(\"LIB/core/scorecard\", x, 0.4, z, yaw=-90, scale=1.3)\n    r.obj(\"LIB/core/gull_captain\", 7.2, -0.6, 7.6, yaw=-90, name=\"commodore\")\n    # A raft of guests, there for the splash.\n    r.obj(\"LIB/core/small_raft\", 13.5, 0.05, 7.0, body=\"fixed\")\n    for i, (x, z, c) in enumerate([(13.0, 6.2, \"#ffd166\"), (13.9, 7.0, \"#78dcaa\"), (13.2, 7.9, \"#ff786e\")]):\n        r.npc(f\"fan{i}\", \"biped\", x, z, y=0.25, yaw=-90, look=guest(shirt=c, helm=\"none\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n''')\nEOF\npython3 notes/.audit/patch1.py && python3 tools/make_sets.py && cp engine/crates/pav_core/src/games/fit/rules.toml notes/.audit/rules.bak && python3 tools/make_rules.py && diff notes/.audit/rules.bak engine/crates/pav_core/src/games/fit/rules.toml; grep -n \"scroll\" engine/crates/pav_core/src/games/fit/mod.rs | head; grep -n \"^use\\|sound\" engine/crates/pav_core/src/games/fit/events/lap.rs | head -8; grep -n \"^use\" engine/crates/pav_core/src/games/fit/finale.rs