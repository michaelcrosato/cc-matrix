{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MDanVbCEJJtQV2iG6PoEHo","type":"tool_result","content":"# Every balance number. Running from engine/, this file is read at each load, so a change here needs no rebuild.\n# The dev mode's Tuning tab changes these live; Reset to Defaults goes back to this file.\n\n[core]\nstiffness = 40.0   # Spring from the dot to its target\ndamping = 8.5   # How fast the dot settles\nreach = 0.92   # Dot travel at full lean\ntip_time = 0.35   # Seconds past the edge before a tip\nwobble = 0.12   # Base wobble\nkick = 0.1   # Random nudge every second or two\ntilt_deg = 14.0   # Figure tilt at full lean (degrees)\n\n[input]\ndeadzone = 0.12   # Stick deadzone\nstick_curve = 1.5   # Stick response curve\nkey_rate = 1.6   # Key lean rate (units/s)\nkey_return = 1.2   # Key lean return rate (units/s)\nmouse_span = 0.38   # Cursor offset for full lean (share of window height)\n\n[flow]\ngoal1 = 3.0   # Day 1 minute goal\ngoal2 = 5.0   # Day 2 minute goal\ngoal3 = 7.0   # Day 3 minute goal\ngoal4 = 9.0   # Day 4 minute goal\nstar1 = 400.0   # Score for one star\nstar2 = 650.0   # Score for two stars\nstar3 = 850.0   # Score for three stars\ncheckout_age = 40.0   # Balance Age that lets you leave\nattract_idle = 10.0   # Seconds idle before attract mode\nattract_segment = 15.0   # Seconds of each attract event\nwalk_speed = 0.62   # Island walk speed (share of top)\n\n[check]\nstill_time = 8.0   # Stand Still seconds\nstill_nudge = 3.0   # Stand Still's nudge\nstill_par = 0.35   # Mean distance that scores zero\ntarget_limit = 5.0   # Lean Targets: seconds per target\ntarget_hold = 1.5   # Lean Targets: seconds to hold\ntarget_within = 0.06   # Lean Targets: how close\nblind_time = 6.0   # Eyes Closed seconds\nblind_par = 0.5   # Eyes Closed mean distance that scores zero\nstep_count = 8.0   # Step Test steps\nstep_bpm = 100.0   # Step Test tempo\nstep_par = 0.2   # Step Test error that scores zero\nweight_still = 0.3   # Weight of Stand Still\nweight_targets = 0.25   # Weight of Lean Targets\nweight_blind = 0.25   # Weight of Eyes Closed\nweight_steps = 0.2   # Weight of the Step Test\nage_base = 24.0   # Age at perfect skill\nage_range = 56.0   # Age added at zero skill\nage_curve = 1.1   # Curve of skill to age\nage_per_day = 2.0   # Age off per finished day\nage_stars_div = 3.0   # Stars per year off\nage_stars_cap = 8.0   # Most years off from stars\n\n[breath]\ncycles = 5.0   # Breath cycles\ncycle = 8.0   # Seconds per cycle\nlast_cycle = 13.0   # Seconds of the last cycle\nwobble = 0.8   # Wobble\nring = 0.35   # Keep the dot inside this\ntolerance = 0.27   # How far the breath may be off\nbreath_weight = 0.7   # Weight of the breath over the ring\ngood_cycle = 0.6   # Average that opens a lotus\npar = 0.93   # Share of a perfect run that scores 1000\n\n[pose]\ncount = 3.0   # Poses\nlength = 20.0   # Seconds per pose\ndrift_hz = 0.12   # How fast the ring drifts\ndrift = 0.35   # How far the ring drifts\nring_start = 0.3   # Ring radius at the start of a pose\nring_end = 0.18   # Ring radius at the end of a pose\nwobble = 1.0   # Wobble\ngull_at = 12.0   # Seconds into pose 2 the gull lands\ngull_time = 5.0   # Seconds the gull stays\ngull_wobble = 1.6   # Wobble under a gull\nbroken = 1.5   # Seconds a tip breaks the pose\nstreak_step = 2.0   # Seconds per multiplier step\npar = 0.9   # Share of a perfect run that scores 1000\n\n[squats]\nreps = 10.0   # Reps\ndown = 2.0   # Seconds to full depth\nup = 1.0   # Seconds to rise\nrest = 2.0   # Seconds between reps\nwobble = 0.9   # Wobble\nwobble_per_rep = 0.08   # Extra wobble per rep\nband = 0.25   # Band half width\ntolerance = 0.3   # How far the depth may be off\ntiming_weight = 0.7   # Weight of timing over balance\npar = 0.97   # Share of a perfect run that scores 1000\n\n[plank]\nlength = 60.0   # Longest plank (s)\nring_start = 0.4   # Ring at the start\nring_end = 0.2   # Ring at the end\nwobble = 0.9   # Wo