{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E3uPE76S9bwiLr1o2jz2cG","type":"tool_result","content":"--- pause/settings/dev menus\n//! Menus as data: every list on every screen comes from `FitGame::menu`, so the pad, the keys,\n//! the mouse, the bot and the tests all use one path.\n\nuse super::events::EventKind;\nuse super::ui_model::ItemKind;\n\n/// What an item does.\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum MAct {\n    None,\n    Stay,\n    Together,\n    Settings,\n    About,\n    Slot(u8),\n    Name(u16),\n    Skin,\n    Outfit,\n    Begin,\n    Resume,\n    Schedule,\n    Calendar,\n    Wardrobe,\n    HowTo,\n    Dev,\n    Quit,\n    Pavilion(u8),\n    Event(EventKind),\n    EndDay,\n    Reception,\n    Retry,\n    Done,\n    Music,\n    Sfx,\n    Voice,\n    Glyphs,\n    LeanSens,\n    Assist,\n    Rhythm,\n    TextSpeed,\n    Fullscreen,\n    ResetSave,\n    Yes,\n    No,\n    Wear(u8),\n    PagePrev,\n    PageNext,\n    Close,\n    Players(u8),\n    Go,\n    Ready,\n    DevDay(u8),\n    DevEvent(EventKind),\n    DevPhase(u8),\n    DevAttract,\n    DevMedley,\n    DevFlag(u8),\n    DevGive,\n    DevUnlock,\n    DevAllStars,\n    DevWin,\n    DevLose,\n    DevScale,\n    DevHold,\n    DevStep,\n    DevGroup,\n    DevParam(u16),\n    DevResetGroup,\n    DevResetAll,\n    DevResetGuest,\n}\n\n/// How a menu lays out.\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Layout {\n    /// A column of rows: left edge, top, width, row height; at most `visible` at once.\n    List { x: f32, y: f32, w: f32, row: f32, visible: usize },\n    /// A row of big cards, centred on the screen: top, card width and height.\n    Row { y: f32, w: f32, h: f32 },\n}\n\n#[derive(Clone, Debug)]\npub struct MItem {\n    pub act: MAct,\n    pub label: String,\n    pub sub: String,\n    pub kind: ItemKind,\n    pub stars: Option<u8>,\n}\n\nimpl MItem {\n    pub fn button(act: MAct, label: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Button, stars: None }\n    }\n    pub fn sub(mut self, sub: impl Into<String>) -> Self {\n        self.sub = sub.into();\n        self\n    }\n    pub fn stars(mut self, n: u8) -> Self {\n        self.stars = Some(n);\n        self\n    }\n    pub fn locked(mut self) -> Self {\n        self.kind = ItemKind::Locked;\n        self\n    }\n    pub fn slider(act: MAct, label: impl Into<String>, frac: f32, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Slider { frac, value: value.into() }, stars: None }\n    }\n    pub fn choice(act: MAct, label: impl Into<String>, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Choice { value: value.into() }, stars: None }\n    }\n}\n\n#[derive(Clone, Debug)]\npub struct Menu {\n    /// A name for tests: `title`, `pause`...\n    pub key: &'static str,\n    pub title: String,\n    pub sub: String,\n    pub items: Vec<MItem>,\n    pub layout: Layout,\n    pub tabs: Option<(Vec<&'static str>, usize)>,\n    pub back: bool,\n    /// Draws a card behind it, and how wide.\n    pub card: bool,\n    pub dim: bool,\n}\n--- puck placement\nengine/crates/pav_core/src/games/fit/check.rs:243:                let mut p = self.c.puck(true);\nengine/crates/pav_core/src/games/fit/check.rs:251:                        ui.puck(p);\nengine/crates/pav_core/src/games/fit/finale.rs:200:        // Stillness: the HUD vanishes, except the Puck.\nengine/crates/pav_core/src/games/fit/finale.rs:201:        ui.puck(c.puck(true));\nengine/crates/pav_core/src/games/fit/events/pose.rs:148:        let mut p = c.puck(true);\nengine/crates/pav_core/src/games/fit/events/pose.rs:152:        ui.puck(p);\nengine/crates/pav_core/src/games/fit/ui_model.rs:62:pub struct Puck {\nengine/crates/pav_core/src/games/fit/ui_model.rs:95:    Puck(Puck),\nengine/crates/pav_core/src/games/fit/ui_model.rs:286:    p