ing='utf-8'))\nsi=d['sourceInformation']\nfor k in [\"date\",\"source\",\"plan\",\"genre\",\"perspective\",\"tech\",\"artDirection\",\"animation\",\"audio\",\"online\",\"testing\",\"research\",\"environment\",\"model\",\"usage\"]:\n    need(si.get(k),'sourceInformation.'+k)\nneed(si['usage']=='added on import','usage'); need(si['date']=='2026-11-04 22:38:59','date')\nneed((len(d['testingFeedback']),len(d['engineFeedback']),len(d['promptFeedback']))==(4,6,4),'feedback counts')\nh=d['aiHub']\nneed(all(h.get(k) for k in [\"name\",\"tagline\",\"description\",\"type\",\"genre\",\"source\",\"players\",\"controls\",\"tags\"]),'aiHub fields')\npage=open(D+'.html',encoding='utf-8').read()\na=json.loads(re.search(r'<script id=\"about-data\" type=\"application/json\">(.*?)</script>',page,re.S).group(1).replace('<\\\\/','</'))\nneed({k:a[k] for k in d}==d,'About text matches the interview')\nneed(re.search(r'<title>(.*?)</title>',page).group(1)=='Whiff Fit — A balance comedy at Tippy Cay','page title')\nneed(h['name']=='Whiff Fit','interview name')\nneed('<script>'+open(D+'/hub/session.js',encoding='utf-8').read()+'</script>' in page,'hub client byte for byte')\nfor m in ['hub:session\" content=\"1','hub:session-players\" content=\"1-4','hub:session-mode\" content=\"ghost','hub:session-minutes\" content=\"3','hub:webgpu\" content=\"required']:\n    need(m in page,m)\nneed(not re.findall(r'(?:src|href)=\"https?://',page),'no external dependencies')\nfit=json.load(open(E+'anim/fit.json'))['clips']\nfor c in \"Breath Squat Tree Warrior Lighthouse DeckChair Bridge Seated ArmFlail Stumble StepL StepR HipCircle CarryTray Tuck DiveEntry Flop Bow Sleep Wake Sigh\".split():\n    need(c in fit,'clip '+c)\nfiles=[f for f in glob.glob(E+'crates/pav_core/src/games/fit/**/*',recursive=True) if os.path.isfile(f)]\nsrc=''.join(open(f,encoding='utf-8').read() for f in files)\nfor c in [\"MESH2MOTION/Jog\",\"MESH2MOTION/Jumping Jacks\",\"CMU/Hop_One_Foot_Loop\",\"CMU/Wave_Hello\",\"CMU/Stretch_Y