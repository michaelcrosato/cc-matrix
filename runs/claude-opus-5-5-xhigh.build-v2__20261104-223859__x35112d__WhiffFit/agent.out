\t                    return base(\"pause\", \"Paused\", vec![MItem::button(MAct::Resume, \"Resume\"), MItem::button(MAct::Settings, \"Settings\")]);\n227\t                }\n228\t                let in_stay = self.guest().is_some();\n229\t                let free = self.guest().is_some_and(|g| g.free_play());\n230\t                let mut items = vec![MItem::button(MAct::Resume, \"Resume\")];\n231\t                if in_stay && !matches!(self.flow, Flow::Medley(_)) {\n232\t                    items.push(MItem::button(MAct::Schedule, \"Schedule\"));\n233\t                    items.push(MItem::button(MAct::Calendar, \"Calendar\"));\n234\t                    let mut w = MItem::button(MAct::Wardrobe, \"Wardrobe\");\n235\t                    if self.day() < 2 && !free {\n236\t                        w = w.locked().sub(\"Opens on Day 2\");\n237\t                    } else if !matches!(self.flow, Flow::Island) {\n238\t                        w = w.locked().sub(\"On the island\");\n239\t                    }\n240\t                    items.push(w);\n241\t                }\n242\t                items.push(MItem::button(MAct::Settings, \"Settings\"));\n243\t                items.push(MItem::button(MAct::HowTo, \"How to Play\"));\n244\t                items.push(MItem::button(MAct::About, \"About\"));\n245\t                items.push(MItem::button(MAct::Dev, \"Dev Mode\"));\n246\t                items.push(MItem::button(MAct::Quit, \"Quit to Title\"));\n247\t                let mut m = base(\"pause\", \"Paused\", items);\n248\t                let mins = self.paused_minutes();\n249\t                if mins > 0 {\n250\t                    m.sub = script::fill(&script::line(\"pip.paused\", mins as usize), &[(\"n\", mins.to_string())]);\n251\t                }\n252\t                m\n253\t            }\n254\t            Overlay::Schedule(-1) => {\n255\t                let day = self.day();\n256\t                let free = self.guest().is_some_and(|g| g.free_play());\n257\t                let mut items: Vec<MItem> = PAVILIONS\n258\t                    .iter()\n259\t                    .enumerate()\n260\t                    .map(|(i, p)| {\n261\t                        let open = free || p.opens <= day;\n262\t                        let it = MItem::button(MAct::Pavilion(i as u8), p.name);\n263\t                        if open {\n264\t                            it.sub(p.coach.name())\n265\t                        } else {\n266\t                            it.locked().sub(format!(\"Opens on Day {}\", p.opens))\n267\t                        }\n268\t                    })\n269\t                    .collect();\n270\t                if day >= 5 || free {\n271\t                    items.push(MItem::button(MAct::Event(EventKind::BigStand), \"The Big Stand\").sub(\"The bay, at sunset\"));\n272\t                }\n273\t                if matches!(self.flow, Flow::Island) && items.len() < 6 {\n274\t                    items.push(MItem::button(MAct::Reception, \"Back to the Desk\"));\n275\t                }\n276\t                if day < 5 && !free {\n277\t                    items.push(MItem::button(MAct::EndDay, \"End Day\").sub(self.goal_text()));\n278\t                }\n279\t                let mut m = base(\"schedule\", \"Schedule\", items);\n280\t                m.sub = format!(\"Day {day}\");\n281\t                m\n282\t            }\n283\t            Overlay::Schedule(p) => {\n284\t                let pav = &PAVILIONS[p as usize];\n285\t                let g = self.guest();\n286\t                let items = pav\n287\t                    .events\n288\t                    .iter()\n289\t                    .map(|k| {\n290\t                        let s = g.and_then(|g| g.stars.get(k.key()).copied()).unwrap_or(0);\n291\t                        let best = g.and_then(|g| g.bests.get(k.key()).copied());\n292\t                        MItem::button(MAct::Event(*k), k.name()).stars(s).sub(match best {\n293\t                            Some(b) => format!(\"Best {b}\"),\n294\t                            None => \"Not yet attempted\".to_string(),\n295\t                        })\n296\t                    })\n297\t                    .collect();\n298\t                let mut m = base(\"events\", pav.name, items);\n299\t                m.sub = pav.coach.name().to_string();\n300\t                m\n301\t            }\n302\t            Overlay::Calendar => {\n303\t                let mut m = base(\"calendar\", \"\", vec![MItem::button(MAct::Close, \"Back\")]);\n304\t                m.card = false;\n305\t                m.dim = false;\n306\t                m.layout = Layout::Row { y: 800.0, w: 340.0, h: 100.0 };\n307\t                m\n308\t            }\n309\t            Overlay::Wardrobe => {\n310\t                let g = self.guest().cloned().unwrap_or_default();\n311\t                let c = |i: u8| meta::COLOURS[i as usize % 8].0;\n312\t                let items = vec![\n313\t                    MItem::choice(MAct::Wear(0), \"Hat\", meta::HATS[g.wear.hat as usize].label),\n314\t                    MItem::choice(MAct::Wear(1), \"Wrists\", meta::BANDS[g.wear.bands as usize].label),\n315\t                    MItem::choice(MAct::Wear(2), \"Waist\", meta::BELTS[g.wear.belt as usize].label),\n316\t                    MItem::choice(MAct::Wear(3), \"Arms\", meta::FLOATIES[g.wear.floaties as usize].label),\n317\t                    MItem::choice(MAct::Wear(4), \"Shirt\", c(g.wear.shirt)),\n318\t                    MItem::choice(MAct::Wear(5), \"Trousers\", c(g.wear.pants)),\n319\t                    MItem::choice(MAct::Wear(6), \"Shoes\", if g.golden && g.wear.shoes == 0 { \"Golden Flip-Flops\" } else { c(g.wear.shoes) }),\n320\t                ];\n321\t                Menu {\n322\t                    key: \"wardrobe\",\n323\t                    title: \"Wardrobe\".into(),\n324\t                    sub: script::singulars(&format!(\"{} minutes banked\", g.minutes)),\n325\t                    items,\n326\t                    layout: Layout::List { x: 70.0, y: 260.0, w: 760.0, row: 104.0, visible: 6 },\n327\t                    tabs: None,\n328\t                    back: true,\n329\t                    card: true,\n330\t                    dim: false,\n331\t                }\n332\t            }\n333\t            Overlay::Settings => {\n334\t                let s = &self.save.settings;\n335\t                let mut items = vec![\n336\t                    MItem::slider(MAct::Music, \"Music\", s.music, pct(s.music)),\n337\t                    MItem::slider(MAct::Sfx, \"Sound Effects\", s.sfx, pct(s.sfx)),\n338\t                    MItem::slider(MAct::Voice, \"Voices\", s.voice, pct(s.voice)),\n339\t                    MItem::choice(MAct::Glyphs, \"Button Glyphs\", if s.xbox { \"Xbox\" } else { \"PlayStation\" }),\n340\t                    MItem::slider(MAct::LeanSens, \"Lean Sensitivity\", (s.lean_sens - 0.5) / 1.5, pct(s.lean_sens)),\n341\t                    MItem::slider(MAct::Assist, \"Wobble Assist\", s.assist, pct(s.assist)),\n342\t                    MItem::slider(MAct::Rhythm, \"Rhythm Offset\", (s.rhythm_offset + 0.2) / 0.6, format!(\"{:.0} ms\", s.rhythm_offset * 1000.0)),\n343\t                    MItem::choice(MAct::TextSpeed, \"Text Speed\", [\"Slow\", \"Normal\", \"Fast\"][s.text_speed.min(2) as usize]),\n344\t                    MItem::button(MAct::Fullscreen, \"Fullscreen\"),\n345\t                    MItem::button(MAct::ResetSave, \"Reset Save\"),\n346\t                ];\n347\t                if self.boot.touch_only {\n348\t                    // A finger has no Back button.\n349\t                    items.insert(0, MItem::button(MAct::Close, \"Back\"));\n350\t                }\n351\t                base(\"settings\", \"Settings\", items)\n352\t            }\n353\t            Overlay::ConfirmReset => {\n354\t                let mut m = base(\"confirm\", \"Reset every guest?\", vec![MItem::button(MAct::No, \"No\"), MItem::button(MAct::Yes, \"Yes, forget everyone\")]);\n355\t                m.sub = \"Pip will remember anyway.\".into();\n356\t                m\n357\t            }\n358\t            Overlay::HowTo(_) => {\n359\t                let items = vec![MItem::button(MAct::PagePrev, \"Previous\"), MItem::button(MAct::PageNext, \"Next\")];\n360\t                Menu {\n361\t                    key: \"howto\",\n362\t                    title: String::new(),\n363\t                    sub: String::new(),\n364\t                    items,\n365\t                    layout: Layout::Row { y: 880.0, w: 340.0, h: 100.0 },\n366\t                    tabs: None,\n367\t                    back: true,\n368\t                    card: false,\n369\t                    dim: true,\n370\t                }\n371\t            }\n372\t            Overlay::About(_) => {\n373\t                let items = vec![MItem::button(MAct::PagePrev, \"Previous\"), MItem::button(MAct::PageNext, \"Next\")];\n374\t                Menu {\n375\t                    key: \"about\",\n376\t                    title: String::new(),\n377\t                    sub: String::new(),\n378\t                    items,\n379\t                    layout: Layout::Row { y: 900.0, w: 340.0, h: 96.0 },\n380\t                    tabs: None,\n381\t                    back: true,\n382\t                    card: false,\n383\t                    dim: true,\n384\t                }\n385\t            }\n386\t            Overlay::Dev => self.dev_menu(),\n387\t        }\n388\t    }\n389\t\n390\t    fn dev_menu(&self) -> Menu {\n391\t        let d = &self.dev;\n392\t        let onoff = |b: bool| if b { \"On\" } else { \"Off\" };\n393\t        let mut items: Vec<MItem> = Vec::new();\n394\t        match d.tab {\n395\t            0 => {\n396\t                for day in 1..=5u8 {\n397\t                    items.push(MItem::button(MAct::DevDay(day), format!(\"Day {day}\")));\n398\t                }\n399\t                for k in super::events::ALL {\n400\t                    items.push(MItem::button(MAct::DevEvent(k), k.name()));\n401\t                }\n402\t                for (i, p) in super::finale::PHASES.iter().enumerate() {\n403\t                    items.push(MItem::button(MAct::DevPhase(i as u8), format!(\"Big Stand: {p}\")));\n404\t                }\n405\t                items.push(MItem::button(MAct::DevAttract, \"Attract Mode\"));\n406\t                items.push(MItem::button(MAct::DevMedley, \"Medley\"));\n407\t            }\n408\t            1 => {\n409\t                items.push(MItem::choice(MAct::DevFlag(0), \"No Tips\", onoff(d.no_tips)));\n410\t                items.push(MItem::choice(MAct::DevFlag(1), \"Autoplay With the Bot\", onoff(d.autoplay)));\n411\t                items.push(MItem::choice(MAct::DevFlag(2), \"Skip Dialogue\", onoff(d.skip_dialog)));\n412\t                items.push(MItem::button(MAct::DevGive, \"Give 10 Minutes\"));\n413\t                items.push(MItem::button(MAct::DevUnlock, \"Unlock All\"));\n414\t                items.push(MItem::button(MAct::DevAllStars, \"All Stars\"));\n415\t                items.push(MItem::button(MAct::DevWin, \"Win This Event Now\"));\n416\t                items.push(MItem::button(MAct::DevLose, \"Lose This Event Now\"));\n417\t            }\n418\t            2 => {\n419\t                items.push(MItem::choice(MAct::DevScale, \"Time Scale\", format!(\"{}x\", d.time_scale)));\n420\t                items.push(MItem::choice(MAct::DevHold, \"Hold the World\", onoff(d.hold)));\n421\t                items.push(MItem::button(MAct::DevStep, \"Single Step\"));\n422\t            }\n423\t            3 => {\n424\t                let groups = dev_groups(&self.rules);\n425\t                let g = groups.get(d.group).cloned().unwrap_or_default();\n426\t                items.push(MItem::choice(MAct::DevGroup, \"Group\", g.clone()));\n427\t                let mut rules = self.rules.clone();\n428\t                for (i, p) in crate::params::list(&mut rules).iter().enumerate() {\n429\t                    if !p.path.starts_with(&format!(\"{g}.\")) {\n430\t                        continue;\n431\t                    }\n432\t                    if let crate::params::ParamKind::Float { min, max } = p.kind {\n433\t                        let v = p.value.as_f64().unwrap_or(0.0) as f32;\n434\t                        let name = p.path.rsplit('.').next().unwrap_or(\"\").replace('_', \" \");\n435\t                        items.push(MItem::slider(MAct::DevParam(i as u16), name, (v - min) / (max - min).max(1e-4), format!(\"{v:.2}\")));\n436\t                    }\n437\t                }\n438\t                items.push(MItem::button(MAct::DevResetGroup, \"Reset Group to Defaults\"));\n439\t                items.push(MItem::button(MAct::DevResetAll, \"Reset All to Defaults\"));\n440\t            }\n441\t            4 => {\n442\t                items.push(MItem::choice(MAct::DevFlag(3), \"Input Viewer\", onoff(d.input_view)));\n443\t                items.push(MItem::choice(MAct::DevFlag(4), \"Dot Trace\", onoff(d.trace)));\n444\t                items.push(MItem::choice(MAct::DevFlag(5), \"Engine Stats\", onoff(d.stats)));\n445\t                items.push(MItem::choice(MAct::DevFlag(6), \"Free Camera\", onoff(d.free_cam)));\n446\t                items.push(MItem::choice(MAct::DevFlag(7), \"Ghost Lanes\", onoff(d.ghost_lanes)));\n447\t            }\n448\t            _ => {\n449\t                let mut r = MItem::button(MAct::DevResetGuest, \"Reset This Guest\");\n450\t                if self.guest().is_none() {\n451\t                    r = r.locked().sub(\"No guest yet\");\n452\t                }\n453\t                items.push(r);\n454\t            }\n455\t        }\n456\t        Menu {\n457\t            key: \"dev\",\n458\t            title: \"Dev Mode\".into(),\n459\t            sub: String::new(),"}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"acb79e14-27cd-4d22-bbcb-ef63cb771cef","timestamp":"2026-11-05T11:11:55.674Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/games/fit/screens.rs","content":"                card: false,\n                dim: false,\n            });\n        }\n        match &self.flow {\n            Flow::Title => {\n                let has = self.save.slots.iter().any(|s| s.is_some());\n                let items = vec![\n                    MItem::button(MAct::Stay, if has { \"Continue\" } else { \"New Stay\" }),\n                    MItem::button(MAct::Together, \"Play Together\"),\n                    MItem::button(MAct::Settings, \"Settings\"),\n                    MItem::button(MAct::About, \"About\"),\n                ];\n                Some(Menu {\n                    key: \"title\",\n                    title: String::new(),\n                    sub: String::new(),\n                    items,\n                    layout: Layout::List { x: 660.0, y: 470.0, w: 600.0, row: 106.0, visible: 4 },\n                    tabs: None,\n                    back: false,\n                    card: false,\n                    dim: false,\n                })\n            }\n            Flow::Slots => {\n                let items = self\n                    .save\n                    .slots\n                    .iter()\n                    .enumerate()\n                    .map(|(i, s)| match s {\n                        Some(g) => {\n                            let mut it = MItem::button(MAct::Slot(i as u8), g.name.clone()).sub(if g.free_play() {\n                                \"Free Play\".to_string()\n                            } else {\n                                format!(\"Day {}\", g.day)\n                            });\n                            it.stars = None;\n                            it\n                        }\n                        None => MItem::button(MAct::Slot(i as u8), format!(\"Guest {}\", i + 1)).sub(\"New Stay\"),\n                    })\n                    .collect();\n                Some(Menu {\n                    key: \"slots\",\n                    title: \"Who is staying?\".into(),\n                    sub: String::new(),\n                    items,\n                    layout: Layout::Row { y: 340.0, w: 400.0, h: 360.0 },\n                    tabs: None,\n                    back: true,\n                    card: false,\n                    dim: true,\n                })\n            }\n            Flow::Names(_) => {\n                let items = script::list(\"names\").iter().enumerate().map(|(i, n)| MItem::button(MAct::Name(i as u16), n.clone())).collect();\n                Some(Menu {\n                    key: \"names\",\n                    title: \"What shall we call you?\".into(),\n                    sub: \"Pip has already written it down.\".into(),\n                    items,\n                    layout: LIST,\n                    tabs: None,\n                    back: true,\n                    card: true,\n                    dim: true,\n                })\n            }\n            Flow::Look(_, name) => {\n                let items = vec![\n                    MItem::choice(MAct::Skin, \"Skin\", format!(\"Tone {}\", self.look_skin + 1)),\n                    MItem::choice(MAct::Outfit, \"Outfit\", meta::OUTFITS[self.look_outfit as usize % 8].0),\n                    MItem::button(MAct::Begin, \"Begin Your Stay\"),\n                ];\n                Some(Menu {\n                    key: \"look\",\n                    title: name.clone(),\n                    sub: \"This is you. Pip has seen worse.\".into(),\n                    items,\n                    layout: Layout::List { x: 70.0, y: 300.0, w: 700.0, row: 110.0, visible: 3 },\n                    tabs: None,\n                    back: true,\n                    card: true,\n                    dim: false,\n                })\n            }\n            Flow::Event(r) if r.phase == RunPhase::Result && r.pt > 0.9 => {\n                let mut items = Vec::new();\n                if self.direct.is_some() || r.kind != EventKind::BigStand {\n                    items.push(MItem::button(MAct::Retry, \"Retry\"));\n                }\n                items.push(MItem::button(MAct::Done, if r.kind == EventKind::BigStand { \"Continue\" } else { \"Back\" }));\n                Some(Menu {\n                    key: \"result\",\n                    title: String::new(),\n                    sub: String::new(),\n                    items,\n                    layout: Layout::Row { y: 870.0, w: 340.0, h: 110.0 },\n                    tabs: None,\n                    back: false,\n                    card: false,\n                    dim: false,\n                })\n            }\n            Flow::Together(n) => {\n                let items = vec![\n                    MItem::button(MAct::Players(2), \"2 Guests\").sub(if *n == 2 { \"Chosen\" } else { \"\" }),\n                    MItem::button(MAct::Players(3), \"3 Guests\").sub(if *n == 3 { \"Chosen\" } else { \"\" }),\n                    MItem::button(MAct::Players(4), \"4 Guests\").sub(if *n == 4 { \"Chosen\" } else { \"\" }),\n                    MItem::button(MAct::Go, \"Begin the Medley\"),\n                ];\n                Some(Menu {\n                    key: \"together\",\n                    title: \"The Inter-Resort Medley\".into(),\n                    sub: \"One pad. Paddle Slalom, Tide Table, Cannonball Cup. Pass it round.\".into(),\n                    items,\n                    layout: Layout::List { x: 560.0, y: 340.0, w: 800.0, row: 110.0, visible: 4 },\n                    tabs: None,\n                    back: true,\n                    card: true,\n                    dim: true,\n                })\n            }\n            Flow::Medley(m) if !m.hub && m.phase == MPhase::Pass => Some(Menu {\n                key: \"pass\",\n                title: String::new(),\n                sub: String::new(),\n                items: vec![MItem::button(MAct::Ready, \"I have the pad\")],\n                layout: Layout::Row { y: 730.0, w: 520.0, h: 110.0 },\n                tabs: None,\n                back: false,\n                card: false,\n                dim: false,\n            }),\n            Flow::Medley(m) if !m.hub && m.phase == MPhase::Podium => Some(Menu {\n                key: \"podium\",\n                title: String::new(),\n                sub: String::new(),\n                items: vec![MItem::button(MAct::Ready, \"Back to the title\")],\n                layout: Layout::Row { y: 880.0, w: 520.0, h: 110.0 },\n                tabs: None,\n                back: false,\n                card: false,\n                dim: false,\n            }),\n            _ => None,\n        }\n    }\n\n    fn overlay_menu(&self, o: Overlay) -> Menu {\n        let base = |key: &'static str, title: &str, items: Vec<MItem>| Menu {\n            key,\n            title: title.to_string(),\n            sub: String::new(),\n            items,\n            layout: LIST,\n            tabs: None,\n            back: true,\n            card: true,\n            dim: true,\n        };\n        match o {\n            Overlay::Pause => {\n                if self.session {\n                    return base(\"pause\", \"Paused\", vec![MItem::button(MAct::Resume, \"Resume\"), MItem::button(MAct::Settings, \"Settings\")]);\n                }\n                let in_stay = self.guest().is_some();\n                let free = self.guest().is_some_and(|g| g.free_play());\n                let mut items = vec![MItem::button(MAct::Resume, \"Resume\")];\n                if in_stay && !matches!(self.flow, Flow::Medley(_)) {\n                    items.push(MItem::button(MAct::Schedule, \"Schedule\"));\n                    items.push(MItem::button(MAct::Calendar, \"Calendar\"));\n                    let mut w = MItem::button(MAct::Wardrobe, \"Wardrobe\");\n                    if self.day() < 2 && !free {\n                        w = w.locked().sub(\"Opens on Day 2\");\n                    } else if !matches!(self.flow, Flow::Island) {\n                        w = w.locked().sub(\"On the island\");\n                    }\n                    items.push(w);\n                }\n                items.push(MItem::button(MAct::Settings, \"Settings\"));\n                items.push(MItem::button(MAct::HowTo, \"How to Play\"));\n                items.push(MItem::button(MAct::About, \"About\"));\n                items.push(MItem::button(MAct::Dev, \"Dev Mode\"));\n                items.push(MItem::button(MAct::Quit, \"Quit to Title\"));\n                let mut m = base(\"pause\", \"Paused\", items);\n                let mins = self.paused_minutes();\n                if mins > 0 {\n                    m.sub = script::fill(&script::line(\"pip.paused\", mins as usize), &[(\"n\", mins.to_string())]);\n                }\n                m\n            }\n            Overlay::Schedule(-1) => {\n                let day = self.day();\n                let free = self.guest().is_some_and(|g| g.free_play());\n                let mut items: Vec<MItem> = PAVILIONS\n                    .iter()\n                    .enumerate()\n                    .map(|(i, p)| {\n                        let open = free || p.opens <= day;\n                        let it = MItem::button(MAct::Pavilion(i as u8), p.name);\n                        if open {\n                            it.sub(p.coach.name())\n                        } else {\n                            it.locked().sub(format!(\"Opens on Day {}\", p.opens))\n                        }\n                    })\n                    .collect();\n                if day >= 5 || free {\n                    items.push(MItem::button(MAct::Event(EventKind::BigStand), \"The Big Stand\").sub(\"The bay, at sunset\"));\n                }\n                if matches!(self.flow, Flow::Island) && items.len() < 6 {\n                    items.push(MItem::button(MAct::Reception, \"Back to the Desk\"));\n                }\n                if day < 5 && !free {\n                    items.push(MItem::button(MAct::EndDay, \"End Day\").sub(self.goal_text()));\n                }\n                let mut m = base(\"schedule\", \"Schedule\", items);\n                m.sub = format!(\"Day {day}\");\n                m\n            }\n            Overlay::Schedule(p) => {\n                let pav = &PAVILIONS[p as usize];\n                let g = self.guest();\n                let items = pav\n                    .events\n                    .iter()\n                    .map(|k| {\n                        let s = g.and_then(|g| g.stars.get(k.key()).copied()).unwrap_or(0);\n                        let best = g.and_then(|g| g.bests.get(k.key()).copied());\n                        MItem::button(MAct::Event(*k), k.name()).stars(s).sub(match best {\n                            Some(b) => format!(\"Best {b}\"),\n                            None => \"Not yet attempted\".to_string(),\n                        })\n                    })\n                    .collect();\n                let mut m = base(\"events\", pav.name, items);\n                m.sub = pav.coach.name().to_string();\n                m\n            }\n            Overlay::Calendar => {\n                let mut m = base(\"calendar\", \"\", vec![MItem::button(MAct::Close, \"Back\")]);\n                m.card = false;\n                m.dim = false;\n                m.layout = Layout::Row { y: 800.0, w: 340.0, h: 100.0 };\n                m\n            }\n            Overlay::Wardrobe => {\n                let g = self.guest().cloned().unwrap_or_default();\n                let c = |i: u8| meta::COLOURS[i as usize % 8].0;\n                let items = vec![\n                    MItem::choice(MAct::Wear(0), \"Hat\", meta::HATS[g.wear.hat as usize].label),\n                    MItem::choice(MAct::Wear(1), \"Wrists\", meta::BANDS[g.wear.bands as usize].label),\n                    MItem::choice(MAct::Wear(2), \"Waist\", meta::BELTS[g.wear.belt as usize].label),\n                    MItem::choice(MAct::Wear(3), \"Arms\", meta::FLOATIES[g.wear.floaties as usize].label),\n                    MItem::choice(MAct::Wear(4), \"Shirt\", c(g.wear.shirt)),\n                    MItem::choice(MAct::Wear(5), \"Trousers\", c(g.wear.pants)),\n                    MItem::choice(MAct::Wear(6), \"Shoes\", if g.golden && g.wear.shoes == 0 { \"Golden Flip-Flops\" } else { c(g.wear.shoes) }),\n                ];\n                Menu {\n                    key: \"wardrobe\",\n                    title: \"Wardrobe\".into(),\n                    sub: script::singulars(&format!(\"{} minutes banked\", g.minutes)),\n                    items,\n                    layout: Layout::List { x: 70.0, y: 260.0, w: 760.0, row: 104.0, visible: 6 },\n                    tabs: None,\n                    back: true,\n                    card: true,\n                    dim: false,\n                }\n            }\n            Overlay::Settings => {\n                let s = &self.save.settings;\n                let mut items = vec![\n                    MItem::slider(MAct::Music, \"Music\", s.music, pct(s.music)),\n                    MItem::slider(MAct::Sfx, \"Sound Effects\", s.sfx, pct(s.sfx)),\n                    MItem::slider(MAct::Voice, \"Voices\", s.voice, pct(s.voice)),\n                    MItem::choice(MAct::Glyphs, \"Button Glyphs\", if s.xbox { \"Xbox\" } else { \"PlayStation\" }),\n                    MItem::slider(MAct::LeanSens, \"Lean Sensitivity\", (s.lean_sens - 0.5) / 1.5, pct(s.lean_sens)),\n                    MItem::slider(MAct::Assist, \"Wobble Assist\", s.assist, pct(s.assist)),\n                    MItem::slider(MAct::Rhythm, \"Rhythm Offset\", (s.rhythm_offset + 0.2) / 0.6, format!(\"{:.0} ms\", s.rhythm_offset * 1000.0)),\n                    MItem::choice(MAct::TextSpeed, \"Text Speed\", [\"Slow\", \"Normal\", \"Fast\"][s.text_speed.min(2) as usize]),\n                    MItem::button(MAct::Fullscreen, \"Fullscreen\"),\n                    MItem::button(MAct::ResetSave, \"Reset Save\"),\n                ];\n                if self.boot.touch_only {\n                    // A finger has no Back button.\n                    items.insert(0, MItem::button(MAct::Close, \"Back\"));\n                }\n                base(\"settings\", \"Settings\", items)\n            }\n            Overlay::ConfirmReset => {\n                let mut m = base(\"confirm\", \"Reset every guest?\", vec![MItem::button(MAct::No, \"No\"), MItem::button(MAct::Yes, \"Yes, forget everyone\")]);\n                m.sub = \"Pip will remember anyway.\".into();\n                m\n            }\n            Overlay::HowTo(_) => {\n                let items = vec![MItem::button(MAct::PagePrev, \"Previous\"), MItem::button(MAct::PageNext, \"Next\")];\n                Menu {\n                    key: \"howto\",\n                    title: String::new(),\n                    sub: String::new(),\n                    items,\n                    layout: Layout::Row { y: 880.0, w: 340.0, h: 100.0 },\n                    tabs: None,\n                    back: true,\n                    card: false,\n                    dim: true,\n                }\n            }\n            Overlay::About(_) => {\n                let items = vec![MItem::button(MAct::PagePrev, \"Previous\"), MItem::button(MAct::PageNext, \"Next\")];\n                Menu {\n                    key: \"about\",\n                    title: String::new(),\n                    sub: String::new(),\n                    items,\n                    layout: Layout::Row { y: 900.0, w: 340.0, h: 96.0 },\n                    tabs: None,\n                    back: true,\n                    card: false,\n                    dim: true,\n                }\n            }\n            Overlay::Dev => self.dev_menu(),\n        }\n    }\n\n    fn dev_menu(&self) -> Menu {\n        let d = &self.dev;\n        let onoff = |b: bool| if b { \"On\" } else { \"Off\" };\n        let mut items: Vec<MItem> = Vec::new();\n        match d.tab {\n            0 => {\n                for day in 1..=5u8 {\n                    items.push(MItem::button(MAct::DevDay(day), format!(\"Day {day}\")));\n                }\n                for k in super::events::ALL {\n                    items.push(MItem::button(MAct::DevEvent(k), k.name()));\n                }\n                for (i, p) in super::finale::PHASES.iter().enumerate() {\n                    items.push(MItem::button(MAct::DevPhase(i as u8), format!(\"Big Stand: {p}\")));\n                }\n                items.push(MItem::button(MAct::DevAttract, \"Attract Mode\"));\n                items.push(MItem::button(MAct::DevMedley, \"Medley\"));\n            }\n            1 => {\n                items.push(MItem::choice(MAct::DevFlag(0), \"No Tips\", onoff(d.no_tips)));\n                items.push(MItem::choice(MAct::DevFlag(1), \"Autoplay With the Bot\", onoff(d.autoplay)));\n                items.push(MItem::choice(MAct::DevFlag(2), \"Skip Dialogue\", onoff(d.skip_dialog)));\n                items.push(MItem::button(MAct::DevGive, \"Give 10 Minutes\"));\n                items.push(MItem::button(MAct::DevUnlock, \"Unlock All\"));\n                items.push(MItem::button(MAct::DevAllStars, \"All Stars\"));\n                items.push(MItem::button(MAct::DevWin, \"Win This Event Now\"));\n                items.push(MItem::button(MAct::DevLose, \"Lose This Event Now\"));\n            }\n            2 => {\n                items.push(MItem::choice(MAct::DevScale, \"Time Scale\", format!(\"{}x\", d.time_scale)));\n                items.push(MItem::choice(MAct::DevHold, \"Hold the World\", onoff(d.hold)));\n                items.push(MItem::button(MAct::DevStep, \"Single Step\"));\n            }\n            3 => {\n                let groups = dev_groups(&self.rules);\n                let g = groups.get(d.group).cloned().unwrap_or_default();\n                items.push(MItem::choice(MAct::DevGroup, \"Group\", g.clone()));\n                let mut rules = self.rules.clone();\n                for (i, p) in crate::params::list(&mut rules).iter().enumerate() {\n                    if !p.path.starts_with(&format!(\"{g}.\")) {\n                        continue;\n                    }\n                    if let crate::params::ParamKind::Float { min, max } = p.kind {\n                        let v = p.value.as_f64().unwrap_or(0.0) as f32;\n                        let name = p.path.rsplit('.').next().unwrap_or(\"\").replace('_', \" \");\n                        items.push(MItem::slider(MAct::DevParam(i as u16), name, (v - min) / (max - min).max(1e-4), format!(\"{v:.2}\")));\n                    }\n                }\n                items.push(MItem::button(MAct::DevResetGroup, \"Reset Group to Defaults\"));\n                items.push(MItem::button(MAct::DevResetAll, \"Reset All to Defaults\"));\n            }\n            4 => {\n                items.push(MItem::choice(MAct::DevFlag(3), \"Input Viewer\", onoff(d.input_view)));\n                items.push(MItem::choice(MAct::DevFlag(4), \"Dot Trace\", onoff(d.trace)));\n                items.push(MItem::choice(MAct::DevFlag(5), \"Engine Stats\", onoff(d.stats)));\n                items.push(MItem::choice(MAct::DevFlag(6), \"Free Camera\", onoff(d.free_cam)));\n                items.push(MItem::choice(MAct::DevFlag(7), \"Ghost Lanes\", onoff(d.ghost_lanes)));\n            }\n            _ => {\n                let mut r = MItem::button(MAct::DevResetGuest, \"Reset This Guest\");\n                if self.guest().is_none() {\n                    r = r.locked().sub(\"No guest yet\");\n                }\n                items.push(r);\n            }\n        }\n        Menu {\n            key: \"dev\",\n            title: \"Dev Mode\".into(),\n            sub: String::new(),","numLines":400,"startLine":60,"totalLines":