look: Default::default(),\n            feedback: None,\n            creature_owner: crate::creature_tools::new_owner(),\n            ui: Default::default(),\n        };\n        s.sync_camera();\n        Ok(s)\n    }\n\n    /// Wraps the game's running simulation, camera and view for one live-bridge request.\n    pub fn from_live(mut sim: Sim, camera: CameraRig, view: ViewSettings, gpu: Option<Gpu>) -> Self {\n        let prev_frame = sim.frame();\n        Self {\n            sim,\n            camera,\n            view,\n            input: InputFrame::default(),\n            gpu,\n            prev_frame,\n            room_cam: None,\n            cue_serial: 0,\n            cue_base: None,\n            events: Vec::new(),\n            view_base: None,\n            view_room: None,\n            view_serial: 0,\n            live: true,\n            look: Default::default(),\n            feedback: None,\n            creature_owner: 0,\n            ui: Default::default(),\n        }\n    }\n\n    /// Hands everything back to the game after a live-bridge request.\n    pub fn into_live(self) -> (Sim, CameraRig, ViewSettings, Option<Gpu>) {\n        (self.sim, self.camera, self.view, self.gpu)\n    }\n\n    pub fn is_live(&self) -> bool {\n        self.live\n    }\n\n    pub fn params(&mut self) -> ParamsRoot<'_> {\n        ParamsRoot { sim: &mut self.sim.config, camera: &mut self.camera.params, view: &mut self.view }\n    }\n\n    pub fn gpu(&mut self) -> Result<&mut Gpu> {\n        if self.gpu.is_none() {\n            let headless = Headless::new()?;\n            let renderer = Renderer::new(&headless.device, &headless.queue);\n212:    pub fn sync_camera(&mut self) {\n213-        use pav_core::params::{ParamValue, apply_map};\n214-        if self.live || self.sim.studio_active() {\n215-            return;\n216-        }\n217-        let w = &self.sim.state.world;\n218-        let now = w.current_room;\n219-        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\n220-        let c = &self.sim.state.courses;\n221-        if c.cue_serial != self.cue_serial {\n222-            self.cue_serial = c.cue_serial;\n223-            // Like the game: each cue applies on top of the camera from before the first cue;\n224-            // sweeps start at their `from` value (captures are single moments).\n225-            match c.cue() {\n226-                Some(cue) => {\n227-                    let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n228-                    let base = self.cue_base.get_or_insert_with(|| self.camera.params.clone()).clone();\n229-                    let mut set = cue.set.clone();\n230-                    for sw in &cue.sweep {\n231-                        set.insert(sw.param.clone(), ParamValue::Float(sw.from as f64));\n232-                    }\n233-                    if let Some(y) = set.get(\"yaw\").and_then(|v| v.as_f64()) {\n234-                        set.insert(\"yaw\".into(), rot(y, q));\n235-                    }\n236-                    self.camera.params = base;\n237-                    apply_map(&mut self.camera.params, &set);\n238-                }\n239-                None => {\n240-                    if let Some(b) = self.cue_base.take() {\n241-                        self.camera.params = b;\n242-                    }\n243-                }\n244-            }\n245-        }\n246-        // Room changes after cues (leaving a room clears its cue first, then restores the camera).\n247-        if now != self.room_cam.as_ref().map(|r| r.0) {\n248-            if let Some((_, saved)) = self.room_cam.take() {\n249-                self.camera.params = saved;\n250-            }\n251-            if let Some(r) = now.and_then(|i| w.rooms.get(i as usize)).filter(|r| !r.def.camera.is_empty()) {\n252-                let saved = self.camera.params.clone();\n        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene,