s/fit/world.rs',[\n(\"\"\"    sim.state.world = World { enabled: false, rooms, current_room: Some(0), ..Default::default() };\"\"\",\"\"\"    sim.state.world = World { enabled: false, rooms, current_room: Some(0), only_current: true, ..Default::default() };\"\"\"),\n])\npatch('../tools/make_sets.py',[\n(\"\"\"        self.view = {}\n        self.mark(\"stage\", stage[0], stage[1])\"\"\",\"\"\"        self.view = {}\n        self.water = []  # (z from, z to, colour, level)\n        self.mark(\"stage\", stage[0], stage[1])\"\"\"),\n(\"\"\"        lines += [\"[[layout.layer]]\", \"y = 0\", \"map = '''\"] + [\"\".join(r) for r in overlay] + [\"'''\", \"\"]\n        legend[\"_\"] = \\\"\\\"\"\"\",\"\"\"        lines += [\"[[layout.layer]]\", \"y = 0\", \"map = '''\"] + [\"\".join(r) for r in overlay] + [\"'''\", \"\"]\n        # The water: one rectangle per band, under everything (land stands above its surface).\n        wl = [[\"_\"] * self.w for _ in range(self.h)]\n        for bi, (z0, z1, color, level) in enumerate(self.water):\n            c = \"@#$%\"[bi]\n            legend[c] = f'zone = {{ kind = \"water\", y0 = -3.0, y1 = {level}, color = \"{color}\" }}'\n            for z in range(z0, z1):\n                for x in range(self.w):\n                    wl[z][x] = c\n        if self.water:\n            lines += [\"[[layout.layer]]\", \"y = 0\", \"map = '''\"] + [\"\".join(r) for r in wl] + [\"'''\", \"\"]\n        legend[\"_\"] = \\\"\\\"\"\"\"),\n(\"\"\"def water_legend(color=SEA, floor=-3.0):\n    return f'blocks = [{{ y0 = {floor - 0.2}, y1 = {floor}, color = \"{color}\", look = \"flat\" }}]\\\\nzone = {{ kind = \"water\", y0 = {floor}, y1 = 0.0, color = \"{color}\" }}'\n\"\"\",\"\"\"WATER_Y = -0.07\ndef sea(r, color=SEA):\n    \\\"\\\"\\\"One big water zone over the whole map; `~` cells have nothing else in them.\\\"\\\"\\\"\n    r.water.append((0, r.h, color, WATER_Y))\n    r.legend[\"~\"] = \"\"\n\"\"\"),\n(\"\"\"    r.legend = {\n        \"~\": water_legend(),\n        \"s\": 'blocks\"\"\",\"\"\"    r.legend = {\n        \"s\": 'blocks\"\"\"),\n(\"\"\"    r.view = base_view(fog_start=45.0, fog_end=150.0)\n    far_sea(r)\"\"\",\"\"\"    r.view = base_view(fog_start=45.0, fog_end=150.0)\n    far_sea(r)\n    sea(r)\"\"\"),\n(\"\"\"def water_room(name, size=60, **kw):\n    r = Room(name, size, size, (size // 2, size // 2))\n    r.legend = {\"~\": water_legend(**kw)}\n    return r\"\"\",\"\"\"def water_room(name, size=60, color=SEA):\n    r = Room(name, size, size, (size // 2, size // 2))\n    sea(r, color)\n    return r\"\"\"),\n(\"\"\"    r.legend = {\"~\": water_legend(color=\"#a6d8d0\"),\n                \"s\": 'blocks\"\"\",\"\"\"    sea(r, \"#a6d8d0\")\n    r.legend.update({\"s\": 'blocks\"\"\"),\n(\"\"\"                \"g\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#cfe6a0\", look = \"flat\" }]\\\\ngrass = { density = 4, height = 0.34, color = \"#bcdc88\" }'}\"\"\",\"\"\"                \"g\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#cfe6a0\", look = \"flat\" }]\\\\ngrass = { density = 3, height = 0.34, color = \"#bcdc88\" }'})\"\"\"),\n(\"\"\"    r.legend = {\"~\": water_legend(color=\"#8fe0e8\"), \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'}\"\"\",\"\"\"    sea(r, \"#8fe0e8\")\n    r.legend[\"s\"] = 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'\"\"\"),\n(\"\"\"    r.legend = {\"~\": water_legend(color=\"#7fd8dc\"), \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'}\"\"\",\"\"\"    # Three bands, so each ripples at a fine grid (the sea's level differs by a hair).\n    for i in range(3):\n        r.water.append((i * 80, (i + 1) * 80, \"#7fd8dc\", WATER_Y - i * 0.015))\n    r.legend[\"~\"] = \"\"\n    r.legend[\"s\"] = 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'\"\"\"),\n(\"\"\"    r.legend = {\"~\": water_legend(color=\"#93dce0\")}\n\"\"\",\"\"\"    sea(r, \"#93dce0\")\n\"\"\"),\n(\"\"\"      