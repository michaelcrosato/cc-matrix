otes/credits.txt:3:Motion: FIT clips hand-keyed for this game (CC0). CMU Graphics Lab Motion Capture Database (mocap.cs.cmu.edu), Mesh2Motion (CC0), 100STYLE (CC BY 4.0), Quaternius (CC0).\n../exit-interview.json:10:    \"animation\": \"The engine's procedural puppet with motion clips: 25 hand-keyed clips (FIT set) plus library clips from Mesh2Motion, CMU, 100STYLE and Quaternius; poses scrubbed by gameplay; whole-figure lean abo\n--- stars callers\nengine/crates/pav_core/src/games/fit/flow.rs:426:        let stars = self.rules.stars(score);\n--- finale fake prompt\nengine/crates/pav_core/src/games/fit/script.toml:72:\"card.tide_table\" = [\"Your lean tilts the raft. Roll the hermit crabs into the tide pools. Fast shells skip right over.\", \"The crabs have signed a waiver. The crabs cannot read.\"]\nengine/crates/pav_core/src/games/fit/finale.rs:202:        if self.still_t >= r.stand.fake_prompt_at && self.still_t < r.stand.fake_prompt_at + 6.0 {\nengine/crates/pav_core/src/games/fit/finale.rs:203:            ui.prompt_row(&[(Act::Confirm, \"Press to skip\")]);\n--- check nudge\n37:    pub nudged: bool,\n110:                    let mut nudge = Vec2::ZERO;\n111:                    if !self.nudged && self.pt >= 5.0 {\n112:                        self.nudged = true;\n113:                        nudge = Vec2::new(cx.sim.state.rng.range(-1.0, 1.0), 0.5).normalize_or(Vec2::X) * r.still_nudge * 10.0;\n116:                    self.c.step(cx, it.lean, 0.9, Vec2::ZERO, nudge);\n281:                        ui.circle(960.0, 205.0, 80.0 + 60.0 * (1.0 - u), with_alpha(TEAL, 0.25 + 0.5 * (1.0 - u)), TEAL, 8.0);\n--- core\n//! The Balance Core: one analog dot driven by lean. Every event is played through it.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::rules::CoreRules;\nuse crate::rng::Rng;\n\nconst TAU: f32 = std::f32::consts::TAU;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct BalanceCore {\n    /// The dot: unit disc, x right, y up on screen.\n    pub cob: Vec2,\n    pub vel: Vec2,\n    /// Seconds spent past the edge.\n    pub over: f32,\n    /// How many times it tipped.\n    pub tips: u32,\n    /// True on the tick it tipped.\n    pub tipped: bool,\n    /// How much it wobbled (for Pip's records).\n    pub wobbles: u32,\n    wob_side: i8,\n    pub lean_left: f32,\n    pub lean_right: f32,\n    t: f32,\n    phase: [f32; 4],\n    kick_in: f32,\n}\n\nimpl BalanceCore {\n    pub fn new(rng: &mut Rng) -> Self {\n        Self {\n            phase: [rng.range(0.0, TAU), rng.range(0.0, TAU), rng.range(0.0, TAU), rng.range(0.0, TAU)],\n            kick_in: rng.range(1.0, 2.0),\n            ..Default::default()\n        }\n    }\n\n    /// The dot back at the centre, still (a remount).\n    pub fn settle(&mut self) {\n        self.cob = Vec2::ZERO;\n        self.vel = Vec2::ZERO;\n        self.over = 0.0;\n    }\n\n    /// One tick. `lean` is the shaped input; `amp` scales the wobble; `gust` and `nudge` are\n    /// accelerations on the dot this tick. `can_tip` false: the edge is only a place.\n    #[allow(clippy::too_many_arguments)]\n    pub fn step(&mut self, lean: Vec2, r: &CoreRules, amp: f32, gust: Vec2, nudge: Vec2, can_tip: bool, dt: f32, rng: &mut Rng) {\n        self.t += dt;\n        let a = r.wobble * amp;\n        let w = |p: f32, q: f32, t: f32| a * (0.7 * (TAU * 1.3 * t + p).sin() + 0.3 * (TAU * 2.9 * t + q).sin());\n        let wob = Vec2::new(w(self.phase[0], self.phase[1], self.t), w(self.phase[2], self.phase[3], self.t * 0.93));\n        let target = lean.clamp_length_max(1.0) * r.reach + wob;\n        let acc = (target - self.cob) * r.stiffness - self.vel * r.damping + gust + nudge;\n        self.kick_in -= dt;\n        if self.kick_in <= 0.0 {\n            self.kick_in = rng.range(1.0, 2.0);\n            let ang = rng.range(0.0, TAU);\n            self.vel += Vec2::new(ang.cos(), ang.sin()) * r.kick * amp.min(2.5);\n        }\n        self.vel += acc * dt;\n        self.cob += self.vel * dt;\n        self.tipped = false;\n        if self.cob.length() > 1.0 {\n            self.over += dt;\n            if can_tip && self.over >= r.tip_time {\n                self.tipped = true;\n                self.tips += 1;\n                self.over = 0.0;\n            }\n        } else {\n            self.over = 0.0;\n        }\n        // Pip's records: which way, and how often it swung past the middle.\n        if self.cob.x < -0.08 {\n            self.lean_left += dt;\n        } else if self.cob.x > 0.08 {\n            self.lean_right += dt;\n        }\n        let side = if self.cob.x > 0.05 {\n            1\n        } else if self.cob.x < -0.05 {\n            -1\n        } else {\n            self.wob_side\n        };\n        if side != self.wob_side {\n            self.wobbles += 1;\n            self.wob_side = side;\n        }\n    }\n\n    /// 0..1: how close to the edge.\n    pub fn danger(&self) -> f32 {\n        ((self.cob.length() - 0.75) / 0.25).clamp(0.0, 1.0)\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01MVfqyN2oFQznK4AVyjL36a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
