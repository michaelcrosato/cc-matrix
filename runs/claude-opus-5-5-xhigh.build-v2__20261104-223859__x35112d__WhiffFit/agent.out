ed last.\n    pub mouse_recent: bool,\n    key_lean: Vec2,\"\"\",\"\"\"    /// Keyboard and mouse: the mouse moved or clicked last.\n    pub mouse_recent: bool,\n    /// A key or mouse button went down since this was last cleared (any at all, bound or not).\n    pub any_press: bool,\n    key_lean: Vec2,\"\"\"),\n(\"\"\"            mouse_recent: false,\n            key_lean: Vec2::ZERO,\"\"\",\"\"\"            mouse_recent: false,\n            any_press: false,\n            key_lean: Vec2::ZERO,\"\"\"),\n(\"\"\"            ElementState::Pressed => {\n                self.keys.insert(code);\"\"\",\"\"\"            ElementState::Pressed => {\n                self.any_press = true;\n                self.keys.insert(code);\"\"\"),\n(\"\"\"            ElementState::Pressed => {\n                self.mouse.insert(b);\"\"\",\"\"\"            ElementState::Pressed => {\n                self.any_press = true;\n                self.mouse.insert(b);\"\"\"),\n])\npatch('engine/crates/pav_app/src/app.rs',[\n(\"\"\"                    let any = pressed != 0 || self.input.pad.any_activity || self.fit_cursor_moved > 6.0;\n                    if any {\n                        self.fit_cursor_moved = 0.0;\n                    }\"\"\",\"\"\"                    let any = pressed != 0 || self.input.pad.any_activity || self.fit_cursor_moved > 6.0 || self.input.any_press;\n                    self.input.any_press = false;\n                    if any {\n                        self.fit_cursor_moved = 0.0;\n                    }\"\"\"),\n])\nEOF\ncat > tests/hub.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"The AI Hub's own checks: the harness at 2, 3 and 4 players, on a bad network and when the host\nleaves, then a solo check, and the pasted client byte for byte. Prints failures and a count.\"\"\"\nimport json, pathlib, re, shutil, subprocess, sys, signal, time\nfrom common import *\n\nt = Count()\nserved = HERE / \"_served\"\nshutil.rmtree(served, ignore_errors=True)\nserved.mkdir()\nshutil.copy(PAGE, served / \"game.html\")\nfor f in (\"harness.html\", \"bridge.js\", \"round.js\", \"session.js\"):\n    shutil.copy(DEV / \"hub\" / f, served / f)\n\nclient = (DEV / \"hub\" / \"session.js\").read_text(encoding=\"utf-8\")\npage_text = PAGE.read_text(encoding=\"utf-8\")\nt.check(\"the client is pasted byte for byte\", f\"<script>{client}</script>\" in page_text, \"differs from hub/session.js\")\norder = [page_text.find(x) for x in ['<meta charset=\"utf-8\">', \"AI Hub\", 'name=\"hub:session\"', 'id=\"about-data\"', \"__gameBoot\"]]\nt.check(\"head order: charset, client, tags, about, JS\", all(a >= 0 for a in order) and order == sorted(order), str(order))\n\nsrv = subprocess.Popen([sys.executable, \"-u\", \"-m\", \"http.server\", \"0\", \"--bind\", \"127.0.0.1\", \"--directory\", str(served)],\n                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\ndef stop(*_):\n    srv.terminate()\nsignal.signal(signal.SIGTERM, lambda *a: (stop(), sys.exit(1)))\ntry:\n    line = srv.stdout.readline()\n    port = int(re.search(r\"port (\\d+)\", line).group(1))\n    base = f\"http://127.0.0.1:{port}\"\n    runs = [\n        (\"2 players\", \"players=2\"),\n        (\"3 players, bad network\", \"players=3&latency=150&jitter=50&loss=5\"),\n        (\"4 players, bad network\", \"players=4&latency=150&jitter=50&loss=5\"),\n        (\"host leaves\", \"players=4&latency=150&jitter=50&loss=5&scenario=host-leave\"),\n    ]\n    with sync_playwright() as pw:\n        b = pw.chromium.launch(args=FLAGS)\n        for name, q in runs:\n            c = b.new_context(viewport={\"width\": 960, \"height\": 540})\n            p = c.new_page()\n            p.goto(f\"{base}/harness.html?game=game.html&{q}&auto=1\")\n            ok = wait(p, lambda: p.evaluate(\"document.body.dataset.complete\") == \"true\", 220, 0.5)\n            res = p.evaluate(\"JSON.stringify(window.__hubCheck || null)\")\n            passed = p.evaluate(\"window.__hubCheck && window.__hubCheck.pass\")\n            t.check(f\"harness: {name}\", ok and passed, res)\n            c.close()\n        # Solo, like the hub's check.\n        errors = []\n        c = b.new_context(viewport={\"width\": 320, \"height\": 180})\n        p = c.new_page()\n        p.on(\"pageerror\", lambda e: errors.append(str(e)))\n        p.on(\"console\", lambda m: errors.append(m.text) if m.type == \"error\" else None)\n        p.goto(f\"{base}/game.html\")\n        s = wait(p, lambda: status(p), 90)\n        t.check(\"solo: it boots\", s is not None, \"no status\")\n        p.keyboard.press(\"Enter\")\n        p.wait_for_timeout(500)\n        p.keyboard.press(\"Space\")\n        p.wait_for_timeout(1500)\n        t.check(\"solo: no session\", p.evaluate(\"!window.AIHub || !AIHub.active\"), \"AIHub.active\")\n        native = p.evaluate(\"Math.random.toString().includes('native code')\")\n        a, bb = p.evaluate(\"[Math.random(), Math.random()]\")\n        t.check(\"solo: Math.random is the browser's own\", native and a != bb, f\"{native}\")\n        t.check(\"solo: no errors\", not errors, str(errors[:3]))\n        t.check(\"solo: drew a screen\", p.evaluate(\"!!document.querySelector('canvas')\"), \"no canvas\")\n        c.close()\n        b.close()\nfinally:\n    stop()\n    srv.wait(timeout=10)\n    shutil.rmtree(served, ignore_errors=True)\n\nprint(f\"{t.passed} passed, {t.failed} failed\")\nsys.exit(1 if t.failed else 0)\nEOF\ncat > tests/run.sh <<'EOF'\n#!/usr/bin/env bash\n# The one test command: tests/run.sh [core|browser|hub|all]. Prints only failures and a count.\nset -u\nhere=$(cd \"$(dirname \"$0\")\" && pwd)\nwhat=${1:-all}\npassed=0; failed=0\ntally() { # reads a test command's own \"N passed, M failed\" or cargo's result lines\n  local out=$1\n  while read -r p f; do passed=$((passed + p)); failed=$((failed + f)); done < <(printf '%s\\n' \"$out\" | sed -n -E 's/^test result: [a-zA-Z]+\\. ([0-9]+) passed; ([0-9]+) failed.*/\\1 \\2/p; s/^([0-9]+) passed, ([0-9]+) failed$/\\1 \\2/p')\n}\ncore() {\n  cd \"$here/../engine\"\n  local o\n  o=$(CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-8} cargo test -q --locked -p pav_core --test fit 2>&1); printf '%s\\n' \"$o\" | grep -E '^(error|test .* FAILED|thread .* panicked|---- )|panicked at|FAILED' | cut -c1-400; tally \"$o\"\n  o=$(CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-8} cargo test -q --locked -p pav_audio -p pav_ui 2>&1); printf '%s\\n' \"$o\" | grep -E '^(error|test .* FAILED|thread .* panicked|---- )|panicked at|FAILED' | cut -c1-400; tally \"$o\"\n}\npy() { cd \"$here\"; local o; o=$(python3 \"$1\" 2>&1); printf '%s\\n' \"$o\" | grep -vE '^[0-9]+ passed, [0-9]+ failed$' | cut -c1-600; tally \"$o\"; }\ncase $what in\n  core) core ;;\n  browser) py browser.py ;;\n  hub) py hub.py ;;\n  all) core; py browser.py; py hub.py ;;\n  *) echo \"usage: tests/run.sh [core|browser|hub|all]\"; exit 2 ;;\nesac\necho \"$passed passed, $failed failed\"\n[ \"$failed\" -eq 0 ]\nEOF\nchmod +x tests/run.sh tests/*.py; rm -f tests/dbg2.py; (tools/build.sh 2>&1 | tail -1 | cut -c150-260); cd tests; timeout 560 python3 hub.py 2>&1 | tail -14 | cut -c1-1100","description":"Fix pointer and any-input bugs, write hub tests and run harness","timeout":600000}}}
