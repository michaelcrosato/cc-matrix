 == \"about\", 30)\n    p.wait_for_timeout(1500)\n    p.screenshot(path=str(DEV / \"engine/out/look_about1.png\"))\n    n = []\n    for i in range(30):\n        tap(\"e\")\n        p.wait_for_timeout(600)\n        if i == 2:\n            p.screenshot(path=str(DEV / \"engine/out/look_about2.png\"))\n        if i == 5:\n            p.screenshot(path=str(DEV / \"engine/out/look_about3.png\"))\n            break\n    print(\"screen\", status(p)[\"screen\"], \"errors\", errors[:3])\n    b.close()\nEOF\ntimeout 400 python3 tests/look.py 2>&1 | tail -3 | cut -c1-300; cd engine/out && magick look_title.png look_about1.png +append -resize 50% a.png; magick look_about2.png look_about3.png +append -resize 50% b.png; magick a.png b.png -append look.png; ls -la look.png","description":"Rebuild final page and look at it at 1080p from file://","timeout":900000}}}
