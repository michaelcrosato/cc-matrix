{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjG17KGHyC9suCrjRwSn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RXvkSadsxXNDiSAttRoxN4","name":"Bash","input":{"command":"cd events && cat > mod.rs <<'EOF'\n//! The events. One file per event, dispatched through an enum (`Clone` + serde). Every event has\n//! a section in `rules.toml`, a bot that earns at least 2 stars, an idle outcome below 1 star, a\n//! ghost lane and an attract segment. New event: add a file, an `EventKind` and arms below, a\n//! card and lines in `script.toml`, a section in `rules.rs`, and a row in `Schedule`'s pavilions.\n\npub mod breath;\npub mod dive;\npub mod lap;\npub mod paddle;\npub mod plank;\npub mod pose;\npub mod spin;\npub mod squats;\npub mod step;\npub mod tide;\npub mod tray;\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::dialog::{Dialog, Who};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, buttons as b};\nuse crate::sim::Sim;\n\n/// Which event. The order is the Schedule's.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\npub enum EventKind {\n    #[default]\n    BreathBloom,\n    PoseParade,\n    TempoSquats,\n    PlankStandoff,\n    StepParty,\n    FloatieSpin,\n    MorningLap,\n    TideTable,\n    PaddleSlalom,\n    TrayTrek,\n    CannonballCup,\n    BigStand,\n}\n\n/// Every playable event but the finale.\npub const ALL: [EventKind; 11] = [\n    EventKind::BreathBloom,\n    EventKind::PoseParade,\n    EventKind::TempoSquats,\n    EventKind::PlankStandoff,\n    EventKind::StepParty,\n    EventKind::FloatieSpin,\n    EventKind::MorningLap,\n    EventKind::TideTable,\n    EventKind::PaddleSlalom,\n    EventKind::TrayTrek,\n    EventKind::CannonballCup,\n];\n\nimpl EventKind {\n    pub fn key(self) -> &'static str {\n        match self {\n            EventKind::BreathBloom => \"breath_bloom\",\n            EventKind::PoseParade => \"pose_parade\",\n            EventKind::TempoSquats => \"tempo_squats\",\n            EventKind::PlankStandoff => \"plank_standoff\",\n            EventKind::StepParty => \"step_party\",\n            EventKind::FloatieSpin => \"floatie_spin\",\n            EventKind::MorningLap => \"morning_lap\",\n            EventKind::TideTable => \"tide_table\",\n            EventKind::PaddleSlalom => \"paddle_slalom\",\n            EventKind::TrayTrek => \"tray_trek\",\n            EventKind::CannonballCup => \"cannonball_cup\",\n            EventKind::BigStand => \"big_stand\",\n        }\n    }\n    pub fn name(self) -> &'static str {\n        match self {\n            EventKind::BreathBloom => \"Breath Bloom\",\n            EventKind::PoseParade => \"Pose Parade\",\n            EventKind::TempoSquats => \"Tempo Squats\",\n            EventKind::PlankStandoff => \"Plank Standoff\",\n            EventKind::StepParty => \"Step Party\",\n            EventKind::FloatieSpin => \"Floatie Spin\",\n            EventKind::MorningLap => \"Morning Lap\",\n            EventKind::TideTable => \"Tide Table\",\n            EventKind::PaddleSlalom => \"Paddle Slalom\",\n            EventKind::TrayTrek => \"Tray Trek\",\n            EventKind::CannonballCup => \"Cannonball Cup\",\n            EventKind::BigStand => \"The Big Stand\",\n        }\n    }\n    pub fn from_key(k: &str) -> Option<EventKind> {\n        ALL.iter().copied().chain([EventKind::BigStand]).find(|e| e.key() == k)\n    }\n    pub fn coach(self) -> Who {\n        match self {\n            EventKind::BreathBloom | EventKind::PoseParade => Who::Posey,\n            EventKind::TempoSquats | EventKind::PlankStandoff => Who::Kettle,\n            EventKind::StepParty | EventKind::FloatieSpin | EventKind::MorningLap => Who::Bounce,\n            EventKind::TideTable | EventKind::PaddleSlalom | EventKind::TrayTrek | EventKind::CannonballCup => Who::Gull,\n            EventKind::BigStand => Who::Pip,\n        }\n    }\n    /// The first day it is open.\n    pub fn opens_on(self) -> u8 {\n        match self {\n            EventKind::BreathBloom | EventKind::PoseParade => 1,\n            EventKind::TempoSquats | EventKind::PlankStandoff => 2,\n            EventKind::StepParty | EventKind::FloatieSpin | EventKind::MorningLap => 3,\n            EventKind::TideTable | EventKind::PaddleSlalom | EventKind::TrayTrek | EventKind::CannonballCup => 4,\n            EventKind::BigStand => 5,\n        }\n    }\n    pub fn set(self) -> Set {\n        match self {\n            EventKind::BreathBloom | EventKind::PoseParade => Set::Studio,\n            EventKind::TempoSquats | EventKind::PlankStandoff => Set::Gazebo,\n            EventKind::StepParty | EventKind::FloatieSpin => Set::Boardwalk,\n            EventKind::MorningLap => Set::Hub,\n            EventKind::TideTable => Set::Tide,\n            EventKind::PaddleSlalom => Set::Channel,\n            EventKind::TrayTrek => Set::Pier,\n            EventKind::CannonballCup => Set::Tower,\n            EventKind::BigStand => Set::Bay,\n        }\n    }\n    /// Where the neighbouring lane is, per seat.\n    pub fn lane(self) -> Vec3 {\n        match self {\n            EventKind::TideTable => Vec3::new(11.0, 0.0, 0.0),\n            EventKind::PaddleSlalom => Vec3::new(3.0, 0.0, 0.0),\n            EventKind::TrayTrek => Vec3::new(1.5, 0.0, 0.0),\n            EventKind::CannonballCup => Vec3::new(2.2, 0.0, 0.0),\n            EventKind::MorningLap => Vec3::new(1.2, 0.0, 0.0),\n            EventKind::BreathBloom | EventKind::PoseParade => Vec3::new(-2.4, 0.0, -1.0),\n            _ => Vec3::new(-2.6, 0.0, -0.6),\n        }\n    }\n    /// What the ghost stands on (half size and height), when it stands on something.\n    pub fn ghost_stands_on(self) -> Option<(Vec3, f32)> {\n        match self {\n            EventKind::PaddleSlalom => Some((Vec3::new(0.42, 0.05, 1.5), -0.02)),\n            EventKind::TideTable => None,\n            _ => None,\n        }\n    }\n    /// Mouse-steered and step events keep the arrows as steps.\n    pub fn arrows_step(self) -> bool {\n        matches!(self, EventKind::StepParty | EventKind::FloatieSpin | EventKind::MorningLap | EventKind::PlankStandoff)\n    }\n}\n\n/// One tick's input, in the event's words. Left mouse is both Action and the left step.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Intent {\n    pub lean: Vec2,\n    pub act: bool,\n    pub act_just: bool,\n    pub l: bool,\n    pub l_just: bool,\n    pub r: bool,\n    pub r_just: bool,\n    pub any: bool,\n    pub song_pos: Option<f32>,\n}\n\nimpl Intent {\n    pub fn from_input(i: &InputFrame, sens: f32) -> Intent {\n        Intent {\n            lean: (i.lean * sens).clamp_length_max(1.0),\n            act: i.down(b::CONFIRM | b::PRIMARY),\n            act_just: i.just(b::CONFIRM | b::PRIMARY),\n            l: i.down(b::STEP_L | b::PRIMARY),\n            l_just: i.just(b::STEP_L | b::PRIMARY),\n            r: i.down(b::STEP_R | b::SECONDARY),\n            r_just: i.just(b::STEP_R | b::SECONDARY),\n            any: i.any,\n            song_pos: i.song_pos,\n        }\n    }\n    pub fn to_input(self) -> InputFrame {\n        let mut f = InputFrame { lean: self.lean, ..Default::default() };\n        if self.act {\n            f.held |= b::CONFIRM;\n        }\n        if self.act_just {\n            f.held |= b::CONFIRM;\n            f.pressed |= b::CONFIRM;\n        }\n        if self.l {\n            f.held |= b::STEP_L;\n        }\n        if self.l_just {\n            f.held |= b::STEP_L;\n            f.pressed |= b::STEP_L;\n        }\n        if self.r {\n            f.held |= b::STEP_R;\n        }\n        if self.r_just {\n            f.held |= b::STEP_R;\n            f.pressed |= b::STEP_R;\n        }\n        f\n    }\n    pub fn brace(&self) -> bool {\n        self.l && self.r\n    }\n}\n\n/// What an event may touch while it runs.\npub struct Cx<'a> {\n    pub sim: &'a mut Sim,\n    pub rules: &'a Rules,\n    pub ev: &'a mut Vec<SimEvent>,\n    pub dt: f32,\n    pub pid: EntityId,\n    pub no_tips: bool,\n    pub assist: f32,\n    pub stages: &'a [Vec3; 9],\n    pub day: u8,\n    pub slump: f32,\n    /// A seed for the course: the same on every copy in a session.\n    pub seed: u64,\n}\n\nimpl Cx<'_> {\n    pub fn stage(&self, set: Set) -> Vec3 {\n        self.stages[set as usize]\n    }\n    pub fn sfx(&mut self, id: u16, gain: f32, pitch: f32) {\n        self.ev.push(SimEvent::Sfx { id, gain, pitch });\n    }\n    pub fn feet(&self) -> Vec3 {\n        self.sim.feet(self.pid).unwrap_or(Vec3::ZERO)\n    }\n}\n\n/// What every event shares.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct RunCommon {\n    pub core: BalanceCore,\n    /// Seconds of play.\n    pub t: f32,\n    /// The live score (0..1000), as the HUD shows it.\n    pub score: f32,\n    /// A coach's line on screen and how long it stays.\n    pub quip: Option<Dialog>,\n    pub quip_t: f32,\n    /// Seconds the body clips leave a stumble alone.\n    pub stun: f32,\n    /// The dot's recent path (dev view).\n    pub trace: Vec<[f32; 2]>,\n    pub show_trace: bool,\n    pub ghost_dot: Option<[f32; 2]>,\n    pub ghost_score: Option<f32>,\n}\n\nimpl RunCommon {\n    pub fn say(&mut self, who: Who, text: impl Into<String>) {\n        self.quip = Some(Dialog::new(who, vec![text.into()]));\n        self.quip_t = 4.2;\n    }\n    /// A line from a list in `script.toml`.\n    pub fn say_key(&mut self, who: Who, key: &str, i: usize) {\n        self.say(who, super::script::line(key, i));\n    }\n    pub fn step(&mut self, cx: &mut Cx, lean: Vec2, amp: f32, gust: Vec2, nudge: Vec2) {\n        let a = amp * (1.0 - cx.assist * 0.6);\n        let r = &cx.rules.core;\n        self.core.step(lean, r, a, gust, nudge, !cx.no_tips, cx.dt, &mut cx.sim.state.rng);\n        if self.show_trace {\n            self.trace.push([self.core.cob.x, self.core.cob.y]);\n            if self.trace.len() > 120 {\n                self.trace.remove(0);\n            }\n        }\n    }\n    /// The body follows the dot; past 0.75 the arms flail over `clip`.\n    pub fn body(&mut self, cx: &mut Cx, yaw: f32, clip: Option<&str>) {\n        self.stun = (self.stun - cx.dt).max(0.0);\n        lean_figure(cx.sim, cx.pid, self.core.cob, yaw, cx.rules.core.tilt_deg, cx.slump);\n        if self.stun > 0.0 {\n            return;\n        }\n        if self.core.cob.length() > 0.75 {\n            play_flags(cx.sim, cx.pid, \"FIT/ArmFlail\", crate::clips::UPPER, 0.0);\n        } else {\n            match clip {\n                Some(c) => play(cx.sim, cx.pid, c),\n                None => stop_clip(cx.sim, cx.pid),\n            }\n        }\n    }\n    /// A tip: a stumble and, over water, a splash.\n    pub fn tip_fx(&mut self, cx: &mut Cx, water: bool) {\n        self.stun = 1.0;\n        gesture(cx.sim, cx.pid, \"FIT/Stumble\", false);\n        let at = cx.feet();\n        if water {\n            cx.ev.push(SimEvent::BigSplash { pos: at, size: 0.5 });\n            cx.sfx(sound::SPLASH_B, 0.7, 1.1);\n        } else {\n            cx.sfx(sound::BUMP, 0.8, 1.0);\n        }\n    }\n    pub fn puck(&self, top: bool) -> Puck {\n        let c = if top { [960.0, 205.0] } else { [960.0, 770.0] };\n        Puck {\n            c,\n            r: 170.0,\n            dot: [self.core.cob.x, self.core.cob.y],\n            danger: self.core.danger(),\n            trace: if self.show_trace { self.trace.clone() } else { Vec::new() },\n            ghost: self.ghost_dot,\n            good: true,\n            ..Default::default()\n        }\n    }\n    /// Event name and time left at the top left, score at the top right.\n    pub fn top_bar(&self, ui: &mut Ui, name: &str, left: Option<f32>) {\n        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n        if let Some(l) = left {\n            ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"{:.0} s left\", l.max(0.0).ceil()));\n        }\n        ui.panel(1474.0, 30.0, 410.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n        ui.text(1860.0, 38.0, 34.0, INK_SOFT, Align::Right, \"Score\");\n        ui.label(1860.0, 72.0, 58.0, INK, Align::Right, format!(\"{:.0}\", self.score));\n        if let Some(g) = self.ghost_score {\n            ui.text(1500.0, 88.0, 34.0, CORAL, Align::Left, format!(\"You, before: {g:.0}\"));\n        }\n    }\n}\n\n/// An event's own state.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub enum EventState {\n    Breath(breath::BreathBloom),\n    Pose(pose::PoseParade),\n    Squats(squats::TempoSquats),\n    Plank(plank::PlankStandoff),\n    Step(step::StepParty),\n    Spin(spin::FloatieSpin),\n    Lap(lap::MorningLap),\n    Tide(tide::TideTable),\n    Paddle(paddle::PaddleSlalom),\n    Tray(tray::TrayTrek),\n    Dive(dive::CannonballCup),\n}\n\nmacro_rules! each {\n    ($s:expr, $e:ident => $b:expr) => {\n        match $s {\n            EventState::Breath($e) => $b,\n            EventState::Pose($e) => $b,\n            EventState::Squats($e) => $b,\n            EventState::Plank($e) => $b,\n            EventState::Step($e) => $b,\n            EventState::Spin($e) => $b,\n            EventState::Lap($e) => $b,\n            EventState::Tide($e) => $b,\n            EventState::Paddle($e) => $b,\n            EventState::Tray($e) => $b,\n            EventState::Dive($e) => $b,\n        }\n    };\n}\n\nimpl EventState {\n    /// The standard run of `kind` (the finale builds its own from the same pieces).\n    pub fn new(kind: EventKind, day: u8, r: &Rules) -> EventState {\n        match kind {\n            EventKind::BreathBloom => EventState::Breath(breath::BreathBloom::new(r.breath.cycles as usize)),\n            EventKind::PoseParade => EventState::Pose(pose::PoseParade::new(day, r.pose.count as usize, r.pose.length)),\n            EventKind::TempoSquats => EventState::Squats(squats::TempoSquats::new()),\n            EventKind::PlankStandoff => EventState::Plank(plank::PlankStandoff::new(r.plank.length, false)),\n            EventKind::StepParty => EventState::Step(step::StepParty::new(None)),\n            EventKind::FloatieSpin => EventState::Spin(spin::FloatieSpin::new()),\n            EventKind::MorningLap => EventState::Lap(lap::MorningLap::new()),\n            EventKind::TideTable => EventState::Tide(tide::TideTable::new()),\n            EventKind::PaddleSlalom => EventState::Paddle(paddle::PaddleSlalom::new()),\n            EventKind::TrayTrek => EventState::Tray(tray::TrayTrek::new()),\n            EventKind::CannonballCup | EventKind::BigStand => EventState::Dive(dive::CannonballCup::new()),\n        }\n    }\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        each!(self, e => e.start(c, cx))\n    }\n    /// One tick; `Some(score)` when the event is over.\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        each!(self, e => e.tick(c, cx, it))\n    }\n    pub fn stop(&mut self, cx: &mut Cx) {\n        each!(self, e => e.stop(cx))\n    }\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        each!(self, e => e.hud(c, r, ui))\n    }\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        each!(self, e => e.bot(c, r))\n    }\n    pub fn song(&self) -> u8 {\n        match self {\n            EventState::Breath(_) | EventState::Pose(_) => song::TIDE,\n            EventState::Squats(_) | EventState::Plank(_) => song::WALTZ,\n            EventState::Step(_) | EventState::Spin(_) => song::STEP,\n            EventState::Lap(_) => song::LOBBY,\n            _ => song::MALLETS,\n        }\n    }\n    /// The figure's clip to record in a ghost (the same one the world shows).\n    pub fn lean_fast(&self) -> bool {\n        matches!(self, EventState::Spin(_))\n    }\n}\n\n/// The mirror camera from section 4.\npub fn mirror_cam(sim: &mut Sim) {\n    cam(sim, 12.0, 0.0, 8.5, 36.0);\n}\n\n/// Puts the player on a spot, ready for the event.\npub fn ready_player(cx: &mut Cx, set: Set, feet: Vec3, facing: f32) {\n    show_set(cx.sim, set);\n    place(cx.sim, cx.pid, feet, facing);\n    stop_clip(cx.sim, cx.pid);\n    clear_lean(cx.sim, cx.pid);\n}\nEOF\ncat > breath.rs <<'EOF'\n//! Breath Bloom: hold Action to inhale, release to exhale, following a guide ring.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct BreathBloom {\n    pub cycles: usize,\n    pub lungs: f32,\n    pub total: f32,\n    pub sum: f32,\n    pub cycle_sum: f32,\n    pub cycle_time: f32,\n    pub cycle: usize,\n    pub bloomed: usize,\n    pub lotus: Vec<(EntityId, f32)>,\n    pub in_ring: bool,\n    pub gust: f32,\n    /// Finale: no lotus field of its own, no HUD ring wobble of its own.\n    pub ents: Vec<EntityId>,\n}\n\nimpl BreathBloom {\n    pub fn new(cycles: usize) -> Self {\n        Self { cycles, ..Default::default() }\n    }\n\n    /// A cycle's length: the last one is longer.\n    fn cycle_len(&self, i: usize, r: &Rules) -> f32 {\n        if i + 1 == self.cycles { r.breath.last_cycle } else { r.breath.cycle }\n    }\n\n    /// Where the guide is (0..1) at time `t`, and which cycle.\n    pub fn guide(&self, t: f32, r: &Rules) -> (f32, usize) {\n        let mut at = 0.0;\n        for i in 0..self.cycles {\n            let len = self.cycle_len(i, r);\n            if t < at + len {\n                let u = (t - at) / len;\n                return (if u < 0.5 { u * 2.0 } else { 2.0 - u * 2.0 }, i);\n            }\n            at += len;\n        }\n        (0.0, self.cycles)\n    }\n\n    pub fn start(&mut self, _c: &mut RunCommon, cx: &mut Cx) {\n        self.total = (0..self.cycles).map(|i| self.cycle_len(i, cx.rules)).sum();\n        let at = cx.stage(Set::Studio);\n        ready_player(cx, Set::Studio, at, 0.0);\n        mirror_cam(cx.sim);\n        // A pond of closed lotus around the deck.\n        for i in 0..self.cycles.max(5) * 3 {\n            let a = i as f32 * 2.399;\n            let rr = 7.0 + (i as f32 * 0.7) % 5.0;\n            let p = at + Vec3::new(a.cos() * rr, -0.02, a.sin() * rr * 0.8 - 2.0);\n            let id = spawn_prop(cx.sim, \"LIB/core/lotus\", p, a, 0.25);\n            self.lotus.push((id, 0.25));\n        }\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.breath;\n        let dt = cx.dt;\n        let half = r.cycle * 0.5;\n        if it.act {\n            self.lungs += dt / half;\n        } else {\n            self.lungs -= dt / half;\n        }\n        self.lungs = clamp01(self.lungs);\n        let (guide, cycle) = self.guide(c.t, cx.rules);\n        let gust = if self.gust > 0.0 {\n            Vec2::new((c.t * 0.9).sin(), (c.t * 0.67).cos()) * self.gust\n        } else {\n            Vec2::ZERO\n        };\n        c.step(cx, it.lean, r.wobble, gust, Vec2::ZERO);\n        if c.core.tipped {\n            c.tip_fx(cx, false);\n        }\n        self.in_ring = c.core.cob.length() < r.ring;\n        let diff = (self.lungs - guide).abs();\n        let breath = 1.0 - clamp01(diff / r.tolerance);\n        // The ring only counts while the breath is near the guide: standing idle isn't breathing.\n        let tick = r.breath_weight * breath + if diff < r.tolerance && self.in_ring { 1.0 - r.breath_weight } else { 0.0 };\n        self.sum += tick * dt;\n        self.cycle_sum += tick * dt;\n        self.cycle_time += dt;\n        c.score = (self.sum / self.total.max(1.0)) * 1000.0;\n        scrub(cx.sim, cx.pid, \"FIT/Breath\", self.lungs);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        if cycle != self.cycle {\n            // A good cycle opens lotus, with a rising chime.\n            let good = self.cycle_sum / self.cycle_time.max(0.1) > r.good_cycle;\n            if good {\n                let open = if c.score > 860.0 && cycle >= self.cycles { self.lotus.len() } else { 3 };\n                let start = self.bloomed;\n                for i in start..(start + open).min(self.lotus.len()) {\n                    self.lotus[i].1 = 1.0;\n                }\n                self.bloomed = (start + open).min(self.lotus.len());\n                let degree = [1.0, 1.125, 1.26, 1.5, 1.68, 2.0, 2.25][self.cycle.min(6)];\n                cx.sfx(sound::CHIME, 0.8, degree);\n            }\n            self.cycle = cycle;\n            self.cycle_sum = 0.0;\n            self.cycle_time = 0.0;\n            if cycle < self.cycles {\n                c.say_key(Who::Posey, \"posey.breath\", cycle);\n            }\n        }\n        // Lotus open slowly.\n        for (id, want) in self.lotus.clone() {\n            if let Some(p) = cx.sim.state.entities.get_mut(id).and_then(|e| e.prop.as_mut()) {\n                p.scale += (want - p.scale) * (1.0 - (-2.0 * dt).exp());\n            }\n        }\n        (c.t >= self.total).then(|| clamp01(self.sum / self.total.max(1.0) / r.par) * 1000.0)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for (id, _) in self.lotus.drain(..) {\n            cx.sim.despawn(id);\n        }\n        despawn_all(cx.sim, &mut self.ents);\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Breath Bloom\", Some(self.total - c.t));\n        let mut p = c.puck(true);\n        p.ring = Some([0.0, 0.0, r.breath.ring]);\n        p.good = self.in_ring;\n        ui.puck(p);\n        // The guide ring, and your breath inside it.\n        let (guide, _) = self.guide(c.t, r);\n        let (cx, cy) = (480.0, 620.0);\n        ui.circle(cx, cy, 80.0 + 150.0 * guide, with_alpha(SEA, 0.25), TEAL, 8.0);\n        ui.circle(cx, cy, 80.0 + 150.0 * self.lungs, with_alpha(MINT, 0.75), with_alpha(WHITE, 0.0), 0.0);\n        let word = if guide_rising(self, c.t, r) { \"In\" } else { \"Out\" };\n        ui.label(cx, cy - 34.0, 58.0, INK, Align::Center, word);\n        ui.prompt_row(&[(Act::Confirm, \"Hold to breathe in\"), (Act::Lean, \"Keep the dot still\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let rising = guide_rising(self, c.t, r);\n        Intent { act: rising, act_just: rising, lean: -c.core.cob * 0.3, ..Default::default() }\n    }\n}\n\nfn guide_rising(b: &BreathBloom, t: f32, r: &Rules) -> bool {\n    let (a, _) = b.guide(t, r);\n    let (n, _) = b.guide(t + 0.05, r);\n    n >= a\n}\nEOF\ncat > pose.rs <<'EOF'\n//! Pose Parade: hold deadpan poses with the dot inside a drifting ring; streaks multiply.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\npub const POSES: [(&str, &str); 6] = [\n    (\"FIT/Tree\", \"The Patient Heron\"),\n    (\"FIT/Warrior\", \"The Apologetic Lunge\"),\n    (\"FIT/Lighthouse\", \"The Tired Lighthouse\"),\n    (\"FIT/DeckChair\", \"The Folded Deck Chair\"),\n    (\"FIT/Bridge\", \"The Reluctant Bridge\"),\n    (\"FIT/Seated\", \"Seated Disappointment\"),\n];\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct PoseParade {\n    pub poses: Vec<u8>,\n    pub len: f32,\n    pub i: usize,\n    pub pt: f32,\n    pub hold: f32,\n    pub mult: u8,\n    pub sum: f32,\n    pub center: Vec2,\n    pub radius: f32,\n    pub inside: bool,\n    pub broken: f32,\n    pub gull: Option<EntityId>,\n    pub gull_said: bool,\n    pub with_gull: bool,\n    /// Rising gusts (the Big Stand).\n    pub gust: f32,\n    pub posey: Option<EntityId>,\n    pub was_mult: u8,\n}\n\nimpl PoseParade {\n    pub fn new(day: u8, count: usize, len: f32) -> Self {\n        // Day 1 opens with the first three poses; later days rotate on.\n        let first = (day.max(1) as usize - 1) * 2;\n        let poses = (0..count).map(|k| ((first + k) % POSES.len()) as u8).collect();\n        Self { poses, len, mult: 1, with_gull: true, radius: 0.3, ..Default::default() }\n    }\n\n    fn scale(n: usize, len: f32, step: f32) -> f32 {\n        // The most a pose can give: x1 to x4, one step per `step` seconds.\n        let ramp = step * (1.0 + 2.0 + 3.0);\n        n as f32 * (ramp + (len - step * 3.0).max(0.0) * 4.0)\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Studio);\n        ready_player(cx, Set::Studio, at, 0.0);\n        mirror_cam(cx.sim);\n        self.posey = npc(cx.sim, \"posey\");\n        c.say_key(Who::Posey, \"posey.pose_start\", self.i);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.pose;\n        let dt = cx.dt;\n        self.pt += dt;\n        let u = clamp01(self.pt / self.len);\n        let w = std::f32::consts::TAU * r.drift_hz;\n        self.center = Vec2::new((c.t * w).sin(), (c.t * w * 1.37 + 1.0).sin()) * r.drift;\n        self.radius = r.ring_start + (r.ring_end - r.ring_start) * u;\n        // The gull lands at 12 s of the second pose.\n        let mut amp = r.wobble;\n        if self.with_gull && self.i == 1 && self.pt >= r.gull_at && self.pt < r.gull_at + r.gull_time {\n            amp *= r.gull_wobble;\n            if self.gull.is_none() {\n                let head = cx.feet() + Vec3::Y * 2.05;\n                self.gull = Some(spawn_prop(cx.sim, \"LIB/core/gull\", head, 0.0, 0.8));\n                cx.sfx(sound::GULL, 0.8, 1.0);\n                c.say_key(Who::Posey, \"posey.gull\", 0);\n            }\n        } else if let Some(g) = self.gull.take() {\n            cx.sim.despawn(g);\n            cx.sfx(sound::GULL, 0.5, 1.2);\n        }\n        let gust = if self.gust > 0.0 {\n            Vec2::new((c.t * 1.3).sin(), (c.t * 0.8 + 2.0).sin()) * self.gust * (0.4 + u)\n        } else {\n            Vec2::ZERO\n        };\n        c.step(cx, it.lean, amp, gust, Vec2::ZERO);\n        if let Some(g) = self.gull {\n            move_to(cx.sim, g, cx.feet() + Vec3::Y * 2.05);\n        }\n        if c.core.tipped {\n            self.broken = r.broken;\n            c.tip_fx(cx, false);\n            c.say_key(Who::Posey, \"posey.tip\", c.core.tips as usize);\n        }\n        self.broken = (self.broken - dt).max(0.0);\n        self.inside = self.broken <= 0.0 && (c.core.cob - self.center).length() < self.radius;\n        if self.inside {\n            self.hold += dt;\n            self.mult = (1 + (self.hold / r.streak_step) as u8).min(4);\n            self.sum += self.mult as f32 * dt;\n        } else {\n            self.hold = 0.0;\n            self.mult = 1;\n        }\n        if self.mult > self.was_mult {\n            cx.sfx(sound::STAR, 0.5, 0.8 + self.mult as f32 * 0.2);\n        }\n        self.was_mult = self.mult;\n        let max = Self::scale(self.poses.len(), self.len, r.streak_step);\n        c.score = clamp01(self.sum / max / r.par) * 1000.0;\n        let (clip, _) = POSES[self.poses[self.i] as usize];\n        c.body(cx, 0.0, Some(clip));\n        if let Some(p) = self.posey {\n            play(cx.sim, p, clip);\n        }\n        if self.pt >= self.len {\n            if self.i + 1 >= self.poses.len() {\n                return Some(c.score);\n            }\n            self.i += 1;\n            self.pt = 0.0;\n            cx.sfx(sound::CREAK, 0.7, 1.0);\n            c.say_key(Who::Posey, \"posey.pose_next\", self.i);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(g) = self.gull.take() {\n            cx.sim.despawn(g);\n        }\n        if let Some(p) = self.posey {\n            stop_clip(cx.sim, p);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, _r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Pose Parade\", Some(self.len - self.pt + (self.poses.len() - 1 - self.i) as f32 * self.len));\n        let mut p = c.puck(true);\n        p.ring = Some([self.center.x, self.center.y, self.radius]);\n        p.good = self.inside;\n        p.streak = self.mult - 1;\n        ui.puck(p);\n        ui.panel(560.0, 400.0, 800.0, 0.0, WHITE, 0.0);\n        let (_, name) = POSES[self.poses[self.i] as usize];\n        ui.panel(600.0, 900.0, 720.0, 72.0, with_alpha(WHITE, 0.93), 30.0);\n        ui.label(960.0, 910.0, 44.0, INK, Align::Center, name);\n        if self.mult > 1 {\n            ui.label(1200.0, 160.0, 72.0, CORAL, Align::Left, format!(\"x{}\", self.mult));\n        }\n        if self.broken > 0.0 {\n            ui.label(960.0, 420.0, 64.0, CORAL, Align::Center, \"Pose broken. Nobody saw.\");\n        }\n        ui.prompt_row(&[(Act::Lean, \"Keep the dot in the ring\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let aim = self.center / r.core.reach;\n        let lean = aim + (self.center - c.core.cob) * 0.8 - c.core.vel * 0.05;\n        Intent { lean: lean.clamp_length_max(1.0), ..Default::default() }\n    }\n}\nEOF\ncat > squats.rs <<'EOF'\n//! Tempo Squats: hold to go down, release to rise, in time with the guide.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct TempoSquats {\n    pub rep: usize,\n    pub rt: f32,\n    pub depth: f32,\n    pub deepest: f32,\n    pub timing: f32,\n    pub timing_n: f32,\n    pub band_in: f32,\n    pub band_n: f32,\n    pub sum: f32,\n    pub belled: bool,\n    pub in_band: bool,\n    pub kettle: Option<EntityId>,\n    pub gag: f32,\n    pub reps_counted: usize,\n}\n\nimpl TempoSquats {\n    pub fn new() -> Self {\n        Self::default()\n    }\n    fn rep_len(r: &Rules) -> f32 {\n        r.squats.down + r.squats.up + r.squats.rest\n    }\n    /// The guide's depth at `rt` seconds into a rep.\n    fn guide(rt: f32, r: &Rules) -> f32 {\n        let s = &r.squats;\n        if rt < s.down {\n            rt / s.down\n        } else if rt < s.down + s.up {\n            1.0 - (rt - s.down) / s.up\n        } else {\n            0.0\n        }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Gazebo);\n        ready_player(cx, Set::Gazebo, at, 0.0);\n        cam(cx.sim, 14.0, 18.0, 9.0, 36.0);\n        self.kettle = npc(cx.sim, \"kettle\");\n        c.say_key(Who::Kettle, \"kettle.squat_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let s = &cx.rules.squats;\n        let dt = cx.dt;\n        if self.gag > 0.0 {\n            // Rep 10 is followed by \"Ten. Also eleven.\"\n            self.gag -= dt;\n            scrub(cx.sim, cx.pid, \"FIT/Squat\", 0.0);\n            return (self.gag <= 0.0).then(|| clamp01(self.sum / s.reps / s.par) * 1000.0);\n        }\n        self.rt += dt;\n        if it.act {\n            self.depth += dt / s.down;\n        } else {\n            self.depth -= dt / s.up;\n        }\n        self.depth = clamp01(self.depth);\n        self.deepest = self.deepest.max(self.depth);\n        let amp = 1.0 + s.wobble_per_rep * self.rep as f32;\n        c.step(cx, it.lean, amp * s.wobble, Vec2::ZERO, Vec2::ZERO);\n        if c.core.tipped {\n            c.tip_fx(cx, false);\n        }\n        self.in_band = c.core.cob.x.abs() < s.band;\n        let g = Self::guide(self.rt, cx.rules);\n        if self.rt < s.down + s.up {\n            // Timing and balance count while the guide moves.\n            self.timing += 1.0 - clamp01((self.depth - g).abs() / s.tolerance);\n            self.timing_n += 1.0;\n            if self.in_band {\n                self.band_in += 1.0;\n            }\n            self.band_n += 1.0;\n        }\n        if !self.belled && self.rt >= s.down {\n            self.belled = true;\n            cx.sfx(sound::BELL, 0.7, 0.6);\n        }\n        scrub(cx.sim, cx.pid, \"FIT/Squat\", self.depth);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 18.0, cx.rules.core.tilt_deg, cx.slump);\n        if let Some(k) = self.kettle {\n            lean_figure(cx.sim, k, Vec2::new(0.0, -self.depth * 0.3), 18.0, 14.0, 0.0);\n        }\n        if self.rt >= Self::rep_len(cx.rules) {\n            let timing = self.timing / self.timing_n.max(1.0);\n            let band = self.band_in / self.band_n.max(1.0);\n            // No credit for a rep you didn't go down for.\n            let rep = if self.deepest > 0.55 { s.timing_weight * timing + (1.0 - s.timing_weight) * band } else { 0.0 };\n            self.sum += rep;\n            self.rep += 1;\n            c.score = clamp01(self.sum / s.reps / s.par) * 1000.0;\n            self.rt = 0.0;\n            self.deepest = 0.0;\n            self.timing = 0.0;\n            self.timing_n = 0.0;\n            self.band_in = 0.0;\n            self.band_n = 0.0;\n            self.belled = false;\n            cx.sfx(sound::TICK, 0.7, 1.0 + rep * 0.4);\n            if self.rep < s.reps as usize {\n                c.say_key(Who::Kettle, \"kettle.squat_rep\", self.rep);\n            } else {\n                c.say_key(Who::Kettle, \"kettle.squat_end\", 0);\n                self.gag = 2.8;\n            }\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(k) = self.kettle {\n            clear_lean(cx.sim, k);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Tempo Squats\", None);\n        let mut p = c.puck(true);\n        p.band = Some(r.squats.band);\n        p.good = self.in_band;\n        ui.puck(p);\n        // The tempo bar: the guide above, you beside it.\n        let (x, y, w, h) = (280.0, 300.0, 150.0, 540.0);\n        ui.panel(x - 30.0, y - 30.0, w + 60.0, h + 60.0, with_alpha(WHITE, 0.9), 32.0);\n        let g = Self::guide(self.rt, r);\n        ui.panel(x, y + h * g - 12.0, w, 24.0, TEAL, 12.0);\n        ui.circle(x + w * 0.5, y + h * self.depth, 34.0, CORAL, WHITE, 5.0);\n        ui.label(x + w * 0.5, y - 92.0, 44.0, INK, Align::Center, format!(\"{}/{}\", (self.rep + 1).min(r.squats.reps as usize), r.squats.reps));\n        ui.prompt_row(&[(Act::Confirm, \"Hold to go down\"), (Act::Lean, \"Stay in the band\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let down = self.rt < r.squats.down;\n        Intent { act: down, act_just: down, lean: Vec2::new(-c.core.cob.x * 0.8, -c.core.cob.y * 0.3), ..Default::default() }\n    }\n}\nEOF\ncat > plank.rs <<'EOF'\n//! Plank Standoff: hold Brace, keep the dot in a shrinking ring. A talk with a kettlebell.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct PlankStandoff {\n    pub len: f32,\n    pub held: f32,\n    pub out: f32,\n    pub radius: f32,\n    pub inside: bool,\n    pub started: bool,\n    pub flop: f32,\n    pub grace: f32,\n    pub waves: bool,\n    pub wave_in: f32,\n    pub said: u8,\n    pub kettle: Option<EntityId>,\n    pub result: Option<f32>,\n}\n\nimpl PlankStandoff {\n    pub fn new(len: f32, waves: bool) -> Self {\n        Self { len, waves, radius: 0.4, grace: 3.0, wave_in: 3.0, ..Default::default() }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        if !self.waves {\n            let at = cx.stage(Set::Gazebo);\n            ready_player(cx, Set::Gazebo, at, 1.2);\n            cam(cx.sim, 12.0, 30.0, 8.0, 36.0);\n            self.kettle = npc(cx.sim, \"kettle\");\n            c.say_key(Who::Kettle, \"kettle.plank_start\", 0);\n        }\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.plank;\n        let dt = cx.dt;\n        if self.flop > 0.0 {\n            self.flop -= dt;\n            scrub(cx.sim, cx.pid, \"FIT/Flop\", 1.0 - clamp01(self.flop / 1.6));\n            return (self.flop <= 0.0).then_some(self.result.unwrap_or(0.0));\n        }\n        let braced = it.brace();\n        if braced && !self.started {\n            self.started = true;\n            cx.sfx(sound::GRUNT_BELL, 0.5, 0.8);\n        }\n        if !self.started {\n            self.grace -= dt;\n        } else {\n            self.held += dt;\n        }\n        let u = clamp01(self.held / self.len);\n        self.radius = r.ring_start + (r.ring_end - r.ring_start) * u;\n        let fatigue = 1.0 + r.fatigue * u;\n        let tremble = if self.held > r.tremble_at { r.tremble * ((c.t * 31.0).sin() * 0.6 + (c.t * 47.0).sin() * 0.4) } else { 0.0 };\n        let mut nudge = Vec2::new(tremble, tremble * 0.7);\n        if !self.waves && self.held > r.laugh_at && self.said < 3 {\n            self.said = 3;\n            c.say_key(Who::Kettle, \"kettle.plank_joke\", 0);\n            nudge += Vec2::new(r.laugh_nudge, r.laugh_nudge * 0.5);\n            cx.sfx(sound::GONG, 0.5, 0.7);\n        } else if self.held > r.tremble_at && self.said < 2 {\n            self.said = 2;\n            c.say_key(Who::Kettle, \"kettle.plank_talk\", 1);\n        } else if self.held > r.tremble_at * 0.5 && self.said < 1 {\n            self.said = 1;\n            c.say_key(Who::Kettle, \"kettle.plank_talk\", 0);\n        }\n        if self.waves {\n            self.wave_in -= dt;\n            if self.wave_in <= 0.0 {\n                self.wave_in = 2.6;\n                let a = c.t * 2.1;\n                nudge += Vec2::new(a.cos(), a.sin()) * cx.rules.stand.wave_nudge;\n                cx.sfx(sound::WAVE, 0.7, 1.0);\n                let at = cx.feet();\n                cx.ev.push(crate::frame::SimEvent::BigSplash { pos: at + Vec3Ext::side(a), size: 0.5 });\n            }\n        }\n        c.step(cx, it.lean, r.wobble * fatigue, Vec2::ZERO, nudge);\n        self.inside = c.core.cob.length() < self.radius;\n        if self.inside {\n            self.out = 0.0;\n        } else {\n            self.out += dt;\n        }\n        c.score = clamp01(self.held / 60.0) * 1000.0;\n        scrub(cx.sim, cx.pid, \"FIT/Plank\", 0.0);\n        lean_figure(cx.sim, cx.pid, c.core.cob * 0.5, 30.0, 8.0, 0.0);\n        let gave_up = self.started && !braced;\n        let fell = self.out > r.out_time;\n        let never = !self.started && self.grace <= 0.0;\n        if gave_up || fell || never || self.held >= self.len {\n            let done = self.held >= self.len;\n            if done {\n                self.result = Some(c.score);\n                c.say_key(Who::Kettle, \"kettle.plank_win\", 0);\n                self.flop = 1.6;\n            } else {\n                self.result = Some(c.score);\n                c.say_key(Who::Kettle, \"kettle.plank_fail\", 0);\n                self.flop = 1.6;\n                cx.sfx(sound::BUMP, 1.0, 0.7);\n            }\n        }\n        None\n    }\n\n    pub fn stop(&mut self, _cx: &mut Cx) {}\n\n    pub fn hud(&self, c: &RunCommon, _r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Plank Standoff\", Some(self.len - self.held));\n        let mut p = c.puck(true);\n        p.ring = Some([0.0, 0.0, self.radius]);\n        p.good = self.inside;\n        ui.puck(p);\n        if !self.started {\n            ui.label(960.0, 430.0, 64.0, CORAL, Align::Center, \"Brace to begin\");\n        }\n        ui.label(960.0, 880.0, 72.0, INK, Align::Center, format!(\"{:.1} s\", self.held));\n        ui.prompt_row(&[(Act::Brace, \"Hold both\"), (Act::Lean, \"Stay in the ring\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, _r: &Rules) -> Intent {\n        let lean = (-c.core.cob * 1.4 - c.core.vel * 0.12).clamp_length_max(1.0);\n        Intent { l: true, r: true, l_just: !self.started, r_just: !self.started, lean, ..Default::default() }\n    }\n}\n\n/// A point a little to one side, for wave splashes.\nstruct Vec3Ext;\nimpl Vec3Ext {\n    fn side(a: f32) -> glam::Vec3 {\n        glam::Vec3::new(a.cos() * 3.0, 0.0, a.sin() * 2.0 - 1.0)\n    }\n}\nEOF\nsed -i 's/sound::GRUNT_BELL/sound::BELL/' plank.rs; cd ../../../../../../..; pwd","description":"Write events framework and first four events"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15412,"cache_read_input_tokens":323906,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15412},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"02819d4b-225e-46c4-8e9f-bbbbf752847f","timestamp":"2026-11-05T05:55:05.562Z","request_id":"req_011CgjG16zAFW4dnsPbhwj2B","wire_tool_inputs":{"toolu_01RXvkSadsxXNDiSAttRoxN4":{"command":"cd events && cat > mod.rs <<'EOF'\n//! The events. One file per event, dispatched through an enum (`Clone` + serde). Every event has\n//! a section in `rules.toml`, a bot that earns at least 2 stars, an idle outcome below 1 star, a\n//! ghost lane and an attract segment. New event: add a file, an `EventKind` and arms below, a\n//! card and lines in `script.toml`, a section in `rules.rs`, and a row in `Schedule`'s pavilions.\n\npub mod breath;\npub mod dive;\npub mod lap;\npub mod paddle;\npub mod plank;\npub mod pose;\npub mod spin;\npub mod squats;\npub mod step;\npub mod tide;\npub mod tray;\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::dialog::{Dialog, Who};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, buttons as b};\nuse crate::sim::Sim;\n\n/// Which event. The order is the Schedule's.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\npub enum EventKind {\n    #[default]\n    BreathBloom,\n    PoseParade,\n    TempoSquats,\n    PlankStandoff,\n    StepParty,\n    FloatieSpin,\n    MorningLap,\n    TideTable,\n    PaddleSlalom,\n    TrayTrek,\n    CannonballCup,\n    BigStand,\n}\n\n/// Every playable event but the finale.\npub const ALL: [EventKind; 11] = [\n    EventKind::BreathBloom,\n    EventKind::PoseParade,\n    EventKind::TempoSquats,\n    EventKind::PlankStandoff,\n    EventKind::StepParty,\n    EventKind::FloatieSpin,\n    EventKind::MorningLap,\n    EventKind::TideTable,\n    EventKind::PaddleSlalom,\n    EventKind::TrayTrek,\n    EventKind::CannonballCup,\n];\n\nimpl EventKind {\n    pub fn key(self) -> &'static str {\n        match self {\n            EventKind::BreathBloom => \"breath_bloom\",\n            EventKind::PoseParade => \"pose_parade\",\n            EventKind::TempoSquats => \"tempo_squats\",\n            EventKind::PlankStandoff => \"plank_standoff\",\n            EventKind::StepParty => \"step_party\",\n            EventKind::FloatieSpin => \"floatie_spin\",\n            EventKind::MorningLap => \"morning_lap\",\n            EventKind::TideTable => \"tide_table\",\n            EventKind::PaddleSlalom => \"paddle_slalom\",\n            EventKind::TrayTrek => \"tray_trek\",\n            EventKind::CannonballCup => \"cannonball_cup\",\n            EventKind::BigStand => \"big_stand\",\n        }\n    }\n    pub fn name(self) -> &'static str {\n        match self {\n            EventKind::BreathBloom => \"Breath Bloom\",\n            EventKind::PoseParade => \"Pose Parade\",\n            EventKind::TempoSquats => \"Tempo Squats\",\n            EventKind::PlankStandoff => \"Plank Standoff\",\n            EventKind::StepParty => \"Step Party\",\n            EventKind::FloatieSpin => \"Floatie Spin\",\n            EventKind::MorningLap => \"Morning Lap\",\n            EventKind::TideTable => \"Tide Table\",\n            EventKind::PaddleSlalom => \"Paddle Slalom\",\n            EventKind::TrayTrek => \"Tray Trek\",\n            EventKind::CannonballCup => \"Cannonball Cup\",\n            EventKind::BigStand => \"The Big Stand\",\n        }\n    }\n    pub fn from_key(k: &str) -> Option<EventKind> {\n        ALL.iter().copied().chain([EventKind::BigStand]).find(|e| e.key() == k)\n    }\n    pub fn coach(self) -> Who {\n        match self {\n            EventKind::BreathBloom | EventKind::PoseParade => Who::Posey,\n            EventKind::TempoSquats | EventKind::PlankStandoff => Who::Kettle,\n            EventKind::StepParty | EventKind::FloatieSpin | EventKind::MorningLap => Who::Bounce,\n            EventKind::TideTable | EventKind::PaddleSlalom | EventKind::TrayTrek | EventKind::CannonballCup => Who::Gull,\n            EventKind::BigStand => Who::Pip,\n        }\n    }\n    /// The first day it is open.\n    pub fn opens_on(self) -> u8 {\n        match self {\n            EventKind::BreathBloom | EventKind::PoseParade => 1,\n            EventKind::TempoSquats | EventKind::PlankStandoff => 2,\n            EventKind::StepParty | EventKind::FloatieSpin | EventKind::MorningLap => 3,\n            EventKind::TideTable | EventKind::PaddleSlalom | EventKind::TrayTrek | EventKind::CannonballCup => 4,\n            EventKind::BigStand => 5,\n        }\n    }\n    pub fn set(self) -> Set {\n        match self {\n            EventKind::BreathBloom | EventKind::PoseParade => Set::Studio,\n            EventKind::TempoSquats | EventKind::PlankStandoff => Set::Gazebo,\n            EventKind::StepParty | EventKind::FloatieSpin => Set::Boardwalk,\n            EventKind::MorningLap => Set::Hub,\n            EventKind::TideTable => Set::Tide,\n            EventKind::PaddleSlalom => Set::Channel,\n            EventKind::TrayTrek => Set::Pier,\n            EventKind::CannonballCup => Set::Tower,\n            EventKind::BigStand => Set::Bay,\n        }\n    }\n    /// Where the neighbouring lane is, per seat.\n    pub fn lane(self) -> Vec3 {\n        match self {\n            EventKind::TideTable => Vec3::new(11.0, 0.0, 0.0),\n            EventKind::PaddleSlalom => Vec3::new(3.0, 0.0, 0.0),\n            EventKind::TrayTrek => Vec3::new(1.5, 0.0, 0.0),\n            EventKind::CannonballCup => Vec3::new(2.2, 0.0, 0.0),\n            EventKind::MorningLap => Vec3::new(1.2, 0.0, 0.0),\n            EventKind::BreathBloom | EventKind::PoseParade => Vec3::new(-2.4, 0.0, -1.0),\n            _ => Vec3::new(-2.6, 0.0, -0.6),\n        }\n    }\n    /// What the ghost stands on (half size and height), when it stands on something.\n    pub fn ghost_stands_on(self) -> Option<(Vec3, f32)> {\n        match self {\n            EventKind::PaddleSlalom => Some((Vec3::new(0.42, 0.05, 1.5), -0.02)),\n            EventKind::TideTable => None,\n            _ => None,\n        }\n    }\n    /// Mouse-steered and step events keep the arrows as steps.\n    pub fn arrows_step(self) -> bool {\n        matches!(self, EventKind::StepParty | EventKind::FloatieSpin | EventKind::MorningLap | EventKind::PlankStandoff)\n    }\n}\n\n/// One tick's input, in the event's words. Left mouse is both Action and the left step.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Intent {\n    pub lean: Vec2,\n    pub act: bool,\n    pub act_just: bool,\n    pub l: bool,\n    pub l_just: bool,\n    pub r: bool,\n    pub r_just: bool,\n    pub any: bool,\n    pub song_pos: Option<f32>,\n}\n\nimpl Intent {\n    pub fn from_input(i: &InputFrame, sens: f32) -> Intent {\n        Intent {\n            lean: (i.lean * sens).clamp_length_max(1.0),\n            act: i.down(b::CONFIRM | b::PRIMARY),\n            act_just: i.just(b::CONFIRM | b::PRIMARY),\n            l: i.down(b::STEP_L | b::PRIMARY),\n            l_just: i.just(b::STEP_L | b::PRIMARY),\n            r: i.down(b::STEP_R | b::SECONDARY),\n            r_just: i.just(b::STEP_R | b::SECONDARY),\n            any: i.any,\n            song_pos: i.song_pos,\n        }\n    }\n    pub fn to_input(self) -> InputFrame {\n        let mut f = InputFrame { lean: self.lean, ..Default::default() };\n        if self.act {\n            f.held |= b::CONFIRM;\n        }\n        if self.act_just {\n            f.held |= b::CONFIRM;\n            f.pressed |= b::CONFIRM;\n        }\n        if self.l {\n            f.held |= b::STEP_L;\n        }\n        if self.l_just {\n            f.held |= b::STEP_L;\n            f.pressed |= b::STEP_L;\n        }\n        if self.r {\n            f.held |= b::STEP_R;\n        }\n        if self.r_just {\n            f.held |= b::STEP_R;\n            f.pressed |= b::STEP_R;\n        }\n        f\n    }\n    pub fn brace(&self) -> bool {\n        self.l && self.r\n    }\n}\n\n/// What an event may touch while it runs.\npub struct Cx<'a> {\n    pub sim: &'a mut Sim,\n    pub rules: &'a Rules,\n    pub ev: &'a mut Vec<SimEvent>,\n    pub dt: f32,\n    pub pid: EntityId,\n    pub no_tips: bool,\n    pub assist: f32,\n    pub stages: &'a [Vec3; 9],\n    pub day: u8,\n    pub slump: f32,\n    /// A seed for the course: the same on every copy in a session.\n    pub seed: u64,\n}\n\nimpl Cx<'_> {\n    pub fn stage(&self, set: Set) -> Vec3 {\n        self.stages[set as usize]\n    }\n    pub fn sfx(&mut self, id: u16, gain: f32, pitch: f32) {\n        self.ev.push(SimEvent::Sfx { id, gain, pitch });\n    }\n    pub fn feet(&self) -> Vec3 {\n        self.sim.feet(self.pid).unwrap_or(Vec3::ZERO)\n    }\n}\n\n/// What every event shares.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct RunCommon {\n    pub core: BalanceCore,\n    /// Seconds of play.\n    pub t: f32,\n    /// The live score (0..1000), as the HUD shows it.\n    pub score: f32,\n    /// A coach's line on screen and how long it stays.\n    pub quip: Option<Dialog>,\n    pub quip_t: f32,\n    /// Seconds the body clips leave a stumble alone.\n    pub stun: f32,\n    /// The dot's recent path (dev view).\n    pub trace: Vec<[f32; 2]>,\n    pub show_trace: bool,\n    pub ghost_dot: Option<[f32; 2]>,\n    pub ghost_score: Option<f32>,\n}\n\nimpl RunCommon {\n    pub fn say(&mut self, who: Who, text: impl Into<String>) {\n        self.quip = Some(Dialog::new(who, vec![text.into()]));\n        self.quip_t = 4.2;\n    }\n    /// A line from a list in `script.toml`.\n    pub fn say_key(&mut self, who: Who, key: &str, i: usize) {\n        self.say(who, super::script::line(key, i));\n    }\n    pub fn step(&mut self, cx: &mut Cx, lean: Vec2, amp: f32, gust: Vec2, nudge: Vec2) {\n        let a = amp * (1.0 - cx.assist * 0.6);\n        let r = &cx.rules.core;\n        self.core.step(lean, r, a, gust, nudge, !cx.no_tips, cx.dt, &mut cx.sim.state.rng);\n        if self.show_trace {\n            self.trace.push([self.core.cob.x, self.core.cob.y]);\n            if self.trace.len() > 120 {\n                self.trace.remove(0);\n            }\n        }\n    }\n    /// The body follows the dot; past 0.75 the arms flail over `clip`.\n    pub fn body(&mut self, cx: &mut Cx, yaw: f32, clip: Option<&str>) {\n        self.stun = (self.stun - cx.dt).max(0.0);\n        lean_figure(cx.sim, cx.pid, self.core.cob, yaw, cx.rules.core.tilt_deg, cx.slump);\n        if self.stun > 0.0 {\n            return;\n        }\n        if self.core.cob.length() > 0.75 {\n            play_flags(cx.sim, cx.pid, \"FIT/ArmFlail\", crate::clips::UPPER, 0.0);\n        } else {\n            match clip {\n                Some(c) => play(cx.sim, cx.pid, c),\n                None => stop_clip(cx.sim, cx.pid),\n            }\n        }\n    }\n    /// A tip: a stumble and, over water, a splash.\n    pub fn tip_fx(&mut self, cx: &mut Cx, water: bool) {\n        self.stun = 1.0;\n        gesture(cx.sim, cx.pid, \"FIT/Stumble\", false);\n        let at = cx.feet();\n        if water {\n            cx.ev.push(SimEvent::BigSplash { pos: at, size: 0.5 });\n            cx.sfx(sound::SPLASH_B, 0.7, 1.1);\n        } else {\n            cx.sfx(sound::BUMP, 0.8, 1.0);\n        }\n    }\n    pub fn puck(&self, top: bool) -> Puck {\n        let c = if top { [960.0, 205.0] } else { [960.0, 770.0] };\n        Puck {\n            c,\n            r: 170.0,\n            dot: [self.core.cob.x, self.core.cob.y],\n            danger: self.core.danger(),\n            trace: if self.show_trace { self.trace.clone() } else { Vec::new() },\n            ghost: self.ghost_dot,\n            good: true,\n            ..Default::default()\n        }\n    }\n    /// Event name and time left at the top left, score at the top right.\n    pub fn top_bar(&self, ui: &mut Ui, name: &str, left: Option<f32>) {\n        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n        if let Some(l) = left {\n            ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"{:.0} s left\", l.max(0.0).ceil()));\n        }\n        ui.panel(1474.0, 30.0, 410.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n        ui.text(1860.0, 38.0, 34.0, INK_SOFT, Align::Right, \"Score\");\n        ui.label(1860.0, 72.0, 58.0, INK, Align::Right, format!(\"{:.0}\", self.score));\n        if let Some(g) = self.ghost_score {\n            ui.text(1500.0, 88.0, 34.0, CORAL, Align::Left, format!(\"You, before: {g:.0}\"));\n        }\n    }\n}\n\n/// An event's own state.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub enum EventState {\n    Breath(breath::BreathBloom),\n    Pose(pose::PoseParade),\n    Squats(squats::TempoSquats),\n    Plank(plank::PlankStandoff),\n    Step(step::StepParty),\n    Spin(spin::FloatieSpin),\n    Lap(lap::MorningLap),\n    Tide(tide::TideTable),\n    Paddle(paddle::PaddleSlalom),\n    Tray(tray::TrayTrek),\n    Dive(dive::CannonballCup),\n}\n\nmacro_rules! each {\n    ($s:expr, $e:ident => $b:expr) => {\n        match $s {\n            EventState::Breath($e) => $b,\n            EventState::Pose($e) => $b,\n            EventState::Squats($e) => $b,\n            EventState::Plank($e) => $b,\n            EventState::Step($e) => $b,\n            EventState::Spin($e) => $b,\n            EventState::Lap($e) => $b,\n            EventState::Tide($e) => $b,\n            EventState::Paddle($e) => $b,\n            EventState::Tray($e) => $b,\n            EventState::Dive($e) => $b,\n        }\n    };\n}\n\nimpl EventState {\n    /// The standard run of `kind` (the finale builds its own from the same pieces).\n    pub fn new(kind: EventKind, day: u8, r: &Rules) -> EventState {\n        match kind {\n            EventKind::BreathBloom => EventState::Breath(breath::BreathBloom::new(r.breath.cycles as usize)),\n            EventKind::PoseParade => EventState::Pose(pose::PoseParade::new(day, r.pose.count as usize, r.pose.length)),\n            EventKind::TempoSquats => EventState::Squats(squats::TempoSquats::new()),\n            EventKind::PlankStandoff => EventState::Plank(plank::PlankStandoff::new(r.plank.length, false)),\n            EventKind::StepParty => EventState::Step(step::StepParty::new(None)),\n            EventKind::FloatieSpin => EventState::Spin(spin::FloatieSpin::new()),\n            EventKind::MorningLap => EventState::Lap(lap::MorningLap::new()),\n            EventKind::TideTable => EventState::Tide(tide::TideTable::new()),\n            EventKind::PaddleSlalom => EventState::Paddle(paddle::PaddleSlalom::new()),\n            EventKind::TrayTrek => EventState::Tray(tray::TrayTrek::new()),\n            EventKind::CannonballCup | EventKind::BigStand => EventState::Dive(dive::CannonballCup::new()),\n        }\n    }\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        each!(self, e => e.start(c, cx))\n    }\n    /// One tick; `Some(score)` when the event is over.\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        each!(self, e => e.tick(c, cx, it))\n    }\n    pub fn stop(&mut self, cx: &mut Cx) {\n        each!(self, e => e.stop(cx))\n    }\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        each!(self, e => e.hud(c, r, ui))\n    }\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        each!(self, e => e.bot(c, r))\n    }\n    pub fn song(&self) -> u8 {\n        match self {\n            EventState::Breath(_) | EventState::Pose(_) => song::TIDE,\n            EventState::Squats(_) | EventState::Plank(_) => song::WALTZ,\n            EventState::Step(_) | EventState::Spin(_) => song::STEP,\n            EventState::Lap(_) => song::LOBBY,\n            _ => song::MALLETS,\n        }\n    }\n    /// The figure's clip to record in a ghost (the same one the world shows).\n    pub fn lean_fast(&self) -> bool {\n        matches!(self, EventState::Spin(_))\n    }\n}\n\n/// The mirror camera from section 4.\npub fn mirror_cam(sim: &mut Sim) {\n    cam(sim, 12.0, 0.0, 8.5, 36.0);\n}\n\n/// Puts the player on a spot, ready for the event.\npub fn ready_player(cx: &mut Cx, set: Set, feet: Vec3, facing: f32) {\n    show_set(cx.sim, set);\n    place(cx.sim, cx.pid, feet, facing);\n    stop_clip(cx.sim, cx.pid);\n    clear_lean(cx.sim, cx.pid);\n}\nEOF\ncat > breath.rs <<'EOF'\n//! Breath Bloom: hold Action to inhale, release to exhale, following a guide ring.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct BreathBloom {\n    pub cycles: usize,\n    pub lungs: f32,\n    pub total: f32,\n    pub sum: f32,\n    pub cycle_sum: f32,\n    pub cycle_time: f32,\n    pub cycle: usize,\n    pub bloomed: usize,\n    pub lotus: Vec<(EntityId, f32)>,\n    pub in_ring: bool,\n    pub gust: f32,\n    /// Finale: no lotus field of its own, no HUD ring wobble of its own.\n    pub ents: Vec<EntityId>,\n}\n\nimpl BreathBloom {\n    pub fn new(cycles: usize) -> Self {\n        Self { cycles, ..Default::default() }\n    }\n\n    /// A cycle's length: the last one is longer.\n    fn cycle_len(&self, i: usize, r: &Rules) -> f32 {\n        if i + 1 == self.cycles { r.breath.last_cycle } else { r.breath.cycle }\n    }\n\n    /// Where the guide is (0..1) at time `t`, and which cycle.\n    pub fn guide(&self, t: f32, r: &Rules) -> (f32, usize) {\n        let mut at = 0.0;\n        for i in 0..self.cycles {\n            let len = self.cycle_len(i, r);\n            if t < at + len {\n                let u = (t - at) / len;\n                return (if u < 0.5 { u * 2.0 } else { 2.0 - u * 2.0 }, i);\n            }\n            at += len;\n        }\n        (0.0, self.cycles)\n    }\n\n    pub fn start(&mut self, _c: &mut RunCommon, cx: &mut Cx) {\n        self.total = (0..self.cycles).map(|i| self.cycle_len(i, cx.rules)).sum();\n        let at = cx.stage(Set::Studio);\n        ready_player(cx, Set::Studio, at, 0.0);\n        mirror_cam(cx.sim);\n        // A pond of closed lotus around the deck.\n        for i in 0..self.cycles.max(5) * 3 {\n            let a = i as f32 * 2.399;\n            let rr = 7.0 + (i as f32 * 0.7) % 5.0;\n            let p = at + Vec3::new(a.cos() * rr, -0.02, a.sin() * rr * 0.8 - 2.0);\n            let id = spawn_prop(cx.sim, \"LIB/core/lotus\", p, a, 0.25);\n            self.lotus.push((id, 0.25));\n        }\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.breath;\n        let dt = cx.dt;\n        let half = r.cycle * 0.5;\n        if it.act {\n            self.lungs += dt / half;\n        } else {\n            self.lungs -= dt / half;\n        }\n        self.lungs = clamp01(self.lungs);\n        let (guide, cycle) = self.guide(c.t, cx.rules);\n        let gust = if self.gust > 0.0 {\n            Vec2::new((c.t * 0.9).sin(), (c.t * 0.67).cos()) * self.gust\n        } else {\n            Vec2::ZERO\n        };\n        c.step(cx, it.lean, r.wobble, gust, Vec2::ZERO);\n        if c.core.tipped {\n            c.tip_fx(cx, false);\n        }\n        self.in_ring = c.core.cob.length() < r.ring;\n        let diff = (self.lungs - guide).abs();\n        let breath = 1.0 - clamp01(diff / r.tolerance);\n        // The ring only counts while the breath is near the guide: standing idle isn't breathing.\n        let tick = r.breath_weight * breath + if diff < r.tolerance && self.in_ring { 1.0 - r.breath_weight } else { 0.0 };\n        self.sum += tick * dt;\n        self.cycle_sum += tick * dt;\n        self.cycle_time += dt;\n        c.score = (self.sum / self.total.max(1.0)) * 1000.0;\n        scrub(cx.sim, cx.pid, \"FIT/Breath\", self.lungs);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        if cycle != self.cycle {\n            // A good cycle opens lotus, with a rising chime.\n            let good = self.cycle_sum / self.cycle_time.max(0.1) > r.good_cycle;\n            if good {\n                let open = if c.score > 860.0 && cycle >= self.cycles { self.lotus.len() } else { 3 };\n                let start = self.bloomed;\n                for i in start..(start + open).min(self.lotus.len()) {\n                    self.lotus[i].1 = 1.0;\n                }\n                self.bloomed = (start + open).min(self.lotus.len());\n                let degree = [1.0, 1.125, 1.26, 1.5, 1.68, 2.0, 2.25][self.cycle.min(6)];\n                cx.sfx(sound::CHIME, 0.8, degree);\n            }\n            self.cycle = cycle;\n            self.cycle_sum = 0.0;\n            self.cycle_time = 0.0;\n            if cycle < self.cycles {\n                c.say_key(Who::Posey, \"posey.breath\", cycle);\n            }\n        }\n        // Lotus open slowly.\n        for (id, want) in self.lotus.clone() {\n            if let Some(p) = cx.sim.state.entities.get_mut(id).and_then(|e| e.prop.as_mut()) {\n                p.scale += (want - p.scale) * (1.0 - (-2.0 * dt).exp());\n            }\n        }\n        (c.t >= self.total).then(|| clamp01(self.sum / self.total.max(1.0) / r.par) * 1000.0)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for (id, _) in self.lotus.drain(..) {\n            cx.sim.despawn(id);\n        }\n        despawn_all(cx.sim, &mut self.ents);\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Breath Bloom\", Some(self.total - c.t));\n        let mut p = c.puck(true);\n        p.ring = Some([0.0, 0.0, r.breath.ring]);\n        p.good = self.in_ring;\n        ui.puck(p);\n        // The guide ring, and your breath inside it.\n        let (guide, _) = self.guide(c.t, r);\n        let (cx, cy) = (480.0, 620.0);\n        ui.circle(cx, cy, 80.0 + 150.0 * guide, with_alpha(SEA, 0.25), TEAL, 8.0);\n        ui.circle(cx, cy, 80.0 + 150.0 * self.lungs, with_alpha(MINT, 0.75), with_alpha(WHITE, 0.0), 0.0);\n        let word = if guide_rising(self, c.t, r) { \"In\" } else { \"Out\" };\n        ui.label(cx, cy - 34.0, 58.0, INK, Align::Center, word);\n        ui.prompt_row(&[(Act::Confirm, \"Hold to breathe in\"), (Act::Lean, \"Keep the dot still\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let rising = guide_rising(self, c.t, r);\n        Intent { act: rising, act_just: rising, lean: -c.core.cob * 0.3, ..Default::default() }\n    }\n}\n\nfn guide_rising(b: &BreathBloom, t: f32, r: &Rules) -> bool {\n    let (a, _) = b.guide(t, r);\n    let (n, _) = b.guide(t + 0.05, r);\n    n >= a\n}\nEOF\ncat > pose.rs <<'EOF'\n//! Pose Parade: hold deadpan poses with the dot inside a drifting ring; streaks multiply.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\npub const POSES: [(&str, &str); 6] = [\n    (\"FIT/Tree\", \"The Patient Heron\"),\n    (\"FIT/Warrior\", \"The Apologetic Lunge\"),\n    (\"FIT/Lighthouse\", \"The Tired Lighthouse\"),\n    (\"FIT/DeckChair\", \"The Folded Deck Chair\"),\n    (\"FIT/Bridge\", \"The Reluctant Bridge\"),\n    (\"FIT/Seated\", \"Seated Disappointment\"),\n];\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct PoseParade {\n    pub poses: Vec<u8>,\n    pub len: f32,\n    pub i: usize,\n    pub pt: f32,\n    pub hold: f32,\n    pub mult: u8,\n    pub sum: f32,\n    pub center: Vec2,\n    pub radius: f32,\n    pub inside: bool,\n    pub broken: f32,\n    pub gull: Option<EntityId>,\n    pub gull_said: bool,\n    pub with_gull: bool,\n    /// Rising gusts (the Big Stand).\n    pub gust: f32,\n    pub posey: Option<EntityId>,\n    pub was_mult: u8,\n}\n\nimpl PoseParade {\n    pub fn new(day: u8, count: usize, len: f32) -> Self {\n        // Day 1 opens with the first three poses; later days rotate on.\n        let first = (day.max(1) as usize - 1) * 2;\n        let poses = (0..count).map(|k| ((first + k) % POSES.len()) as u8).collect();\n        Self { poses, len, mult: 1, with_gull: true, radius: 0.3, ..Default::default() }\n    }\n\n    fn scale(n: usize, len: f32, step: f32) -> f32 {\n        // The most a pose can give: x1 to x4, one step per `step` seconds.\n        let ramp = step * (1.0 + 2.0 + 3.0);\n        n as f32 * (ramp + (len - step * 3.0).max(0.0) * 4.0)\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Studio);\n        ready_player(cx, Set::Studio, at, 0.0);\n        mirror_cam(cx.sim);\n        self.posey = npc(cx.sim, \"posey\");\n        c.say_key(Who::Posey, \"posey.pose_start\", self.i);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.pose;\n        let dt = cx.dt;\n        self.pt += dt;\n        let u = clamp01(self.pt / self.len);\n        let w = std::f32::consts::TAU * r.drift_hz;\n        self.center = Vec2::new((c.t * w).sin(), (c.t * w * 1.37 + 1.0).sin()) * r.drift;\n        self.radius = r.ring_start + (r.ring_end - r.ring_start) * u;\n        // The gull lands at 12 s of the second pose.\n        let mut amp = r.wobble;\n        if self.with_gull && self.i == 1 && self.pt >= r.gull_at && self.pt < r.gull_at + r.gull_time {\n            amp *= r.gull_wobble;\n            if self.gull.is_none() {\n                let head = cx.feet() + Vec3::Y * 2.05;\n                self.gull = Some(spawn_prop(cx.sim, \"LIB/core/gull\", head, 0.0, 0.8));\n                cx.sfx(sound::GULL, 0.8, 1.0);\n                c.say_key(Who::Posey, \"posey.gull\", 0);\n            }\n        } else if let Some(g) = self.gull.take() {\n            cx.sim.despawn(g);\n            cx.sfx(sound::GULL, 0.5, 1.2);\n        }\n        let gust = if self.gust > 0.0 {\n            Vec2::new((c.t * 1.3).sin(), (c.t * 0.8 + 2.0).sin()) * self.gust * (0.4 + u)\n        } else {\n            Vec2::ZERO\n        };\n        c.step(cx, it.lean, amp, gust, Vec2::ZERO);\n        if let Some(g) = self.gull {\n            move_to(cx.sim, g, cx.feet() + Vec3::Y * 2.05);\n        }\n        if c.core.tipped {\n            self.broken = r.broken;\n            c.tip_fx(cx, false);\n            c.say_key(Who::Posey, \"posey.tip\", c.core.tips as usize);\n        }\n        self.broken = (self.broken - dt).max(0.0);\n        self.inside = self.broken <= 0.0 && (c.core.cob - self.center).length() < self.radius;\n        if self.inside {\n            self.hold += dt;\n            self.mult = (1 + (self.hold / r.streak_step) as u8).min(4);\n            self.sum += self.mult as f32 * dt;\n        } else {\n            self.hold = 0.0;\n            self.mult = 1;\n        }\n        if self.mult > self.was_mult {\n            cx.sfx(sound::STAR, 0.5, 0.8 + self.mult as f32 * 0.2);\n        }\n        self.was_mult = self.mult;\n        let max = Self::scale(self.poses.len(), self.len, r.streak_step);\n        c.score = clamp01(self.sum / max / r.par) * 1000.0;\n        let (clip, _) = POSES[self.poses[self.i] as usize];\n        c.body(cx, 0.0, Some(clip));\n        if let Some(p) = self.posey {\n            play(cx.sim, p, clip);\n        }\n        if self.pt >= self.len {\n            if self.i + 1 >= self.poses.len() {\n                return Some(c.score);\n            }\n            self.i += 1;\n            self.pt = 0.0;\n            cx.sfx(sound::CREAK, 0.7, 1.0);\n            c.say_key(Who::Posey, \"posey.pose_next\", self.i);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(g) = self.gull.take() {\n            cx.sim.despawn(g);\n        }\n        if let Some(p) = self.posey {\n            stop_clip(cx.sim, p);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, _r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Pose Parade\", Some(self.len - self.pt + (self.poses.len() - 1 - self.i) as f32 * self.len));\n        let mut p = c.puck(true);\n        p.ring = Some([self.center.x, self.center.y, self.radius]);\n        p.good = self.inside;\n        p.streak = self.mult - 1;\n        ui.puck(p);\n        ui.panel(560.0, 400.0, 800.0, 0.0, WHITE, 0.0);\n        let (_, name) = POSES[self.poses[self.i] as usize];\n        ui.panel(600.0, 900.0, 720.0, 72.0, with_alpha(WHITE, 0.93), 30.0);\n        ui.label(960.0, 910.0, 44.0, INK, Align::Center, name);\n        if self.mult > 1 {\n            ui.label(1200.0, 160.0, 72.0, CORAL, Align::Left, format!(\"x{}\", self.mult));\n        }\n        if self.broken > 0.0 {\n            ui.label(960.0, 420.0, 64.0, CORAL, Align::Center, \"Pose broken. Nobody saw.\");\n        }\n        ui.prompt_row(&[(Act::Lean, \"Keep the dot in the ring\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let aim = self.center / r.core.reach;\n        let lean = aim + (self.center - c.core.cob) * 0.8 - c.core.vel * 0.05;\n        Intent { lean: lean.clamp_length_max(1.0), ..Default::default() }\n    }\n}\nEOF\ncat > squats.rs <<'EOF'\n//! Tempo Squats: hold to go down, release to rise, in time with the guide.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct TempoSquats {\n    pub rep: usize,\n    pub rt: f32,\n    pub depth: f32,\n    pub deepest: f32,\n    pub timing: f32,\n    pub timing_n: f32,\n    pub band_in: f32,\n    pub band_n: f32,\n    pub sum: f32,\n    pub belled: bool,\n    pub in_band: bool,\n    pub kettle: Option<EntityId>,\n    pub gag: f32,\n    pub reps_counted: usize,\n}\n\nimpl TempoSquats {\n    pub fn new() -> Self {\n        Self::default()\n    }\n    fn rep_len(r: &Rules) -> f32 {\n        r.squats.down + r.squats.up + r.squats.rest\n    }\n    /// The guide's depth at `rt` seconds into a rep.\n    fn guide(rt: f32, r: &Rules) -> f32 {\n        let s = &r.squats;\n        if rt < s.down {\n            rt / s.down\n        } else if rt < s.down + s.up {\n            1.0 - (rt - s.down) / s.up\n        } else {\n            0.0\n        }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Gazebo);\n        ready_player(cx, Set::Gazebo, at, 0.0);\n        cam(cx.sim, 14.0, 18.0, 9.0, 36.0);\n        self.kettle = npc(cx.sim, \"kettle\");\n        c.say_key(Who::Kettle, \"kettle.squat_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let s = &cx.rules.squats;\n        let dt = cx.dt;\n        if self.gag > 0.0 {\n            // Rep 10 is followed by \"Ten. Also eleven.\"\n            self.gag -= dt;\n            scrub(cx.sim, cx.pid, \"FIT/Squat\", 0.0);\n            return (self.gag <= 0.0).then(|| clamp01(self.sum / s.reps / s.par) * 1000.0);\n        }\n        self.rt += dt;\n        if it.act {\n            self.depth += dt / s.down;\n        } else {\n            self.depth -= dt / s.up;\n        }\n        self.depth = clamp01(self.depth);\n        self.deepest = self.deepest.max(self.depth);\n        let amp = 1.0 + s.wobble_per_rep * self.rep as f32;\n        c.step(cx, it.lean, amp * s.wobble, Vec2::ZERO, Vec2::ZERO);\n        if c.core.tipped {\n            c.tip_fx(cx, false);\n        }\n        self.in_band = c.core.cob.x.abs() < s.band;\n        let g = Self::guide(self.rt, cx.rules);\n        if self.rt < s.down + s.up {\n            // Timing and balance count while the guide moves.\n            self.timing += 1.0 - clamp01((self.depth - g).abs() / s.tolerance);\n            self.timing_n += 1.0;\n            if self.in_band {\n                self.band_in += 1.0;\n            }\n            self.band_n += 1.0;\n        }\n        if !self.belled && self.rt >= s.down {\n            self.belled = true;\n            cx.sfx(sound::BELL, 0.7, 0.6);\n        }\n        scrub(cx.sim, cx.pid, \"FIT/Squat\", self.depth);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 18.0, cx.rules.core.tilt_deg, cx.slump);\n        if let Some(k) = self.kettle {\n            lean_figure(cx.sim, k, Vec2::new(0.0, -self.depth * 0.3), 18.0, 14.0, 0.0);\n        }\n        if self.rt >= Self::rep_len(cx.rules) {\n            let timing = self.timing / self.timing_n.max(1.0);\n            let band = self.band_in / self.band_n.max(1.0);\n            // No credit for a rep you didn't go down for.\n            let rep = if self.deepest > 0.55 { s.timing_weight * timing + (1.0 - s.timing_weight) * band } else { 0.0 };\n            self.sum += rep;\n            self.rep += 1;\n            c.score = clamp01(self.sum / s.reps / s.par) * 1000.0;\n            self.rt = 0.0;\n            self.deepest = 0.0;\n            self.timing = 0.0;\n            self.timing_n = 0.0;\n            self.band_in = 0.0;\n            self.band_n = 0.0;\n            self.belled = false;\n            cx.sfx(sound::TICK, 0.7, 1.0 + rep * 0.4);\n            if self.rep < s.reps as usize {\n                c.say_key(Who::Kettle, \"kettle.squat_rep\", self.rep);\n            } else {\n                c.say_key(Who::Kettle, \"kettle.squat_end\", 0);\n                self.gag = 2.8;\n            }\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(k) = self.kettle {\n            clear_lean(cx.sim, k);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Tempo Squats\", None);\n        let mut p = c.puck(true);\n        p.band = Some(r.squats.band);\n        p.good = self.in_band;\n        ui.puck(p);\n        // The tempo bar: the guide above, you beside it.\n        let (x, y, w, h) = (280.0, 300.0, 150.0, 540.0);\n        ui.panel(x - 30.0, y - 30.0, w + 60.0, h + 60.0, with_alpha(WHITE, 0.9), 32.0);\n        let g = Self::guide(self.rt, r);\n        ui.panel(x, y + h * g - 12.0, w, 24.0, TEAL, 12.0);\n        ui.circle(x + w * 0.5, y + h * self.depth, 34.0, CORAL, WHITE, 5.0);\n        ui.label(x + w * 0.5, y - 92.0, 44.0, INK, Align::Center, format!(\"{}/{}\", (self.rep + 1).min(r.squats.reps as usize), r.squats.reps));\n        ui.prompt_row(&[(Act::Confirm, \"Hold to go down\"), (Act::Lean, \"Stay in the band\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let down = self.rt < r.squats.down;\n        Intent { act: down, act_just: down, lean: Vec2::new(-c.core.cob.x * 0.8, -c.core.cob.y * 0.3), ..Default::default() }\n    }\n}\nEOF\ncat > plank.rs <<'EOF'\n//! Plank Standoff: hold Brace, keep the dot in a shrinking ring. A talk with a kettlebell.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct PlankStandoff {\n    pub len: f32,\n    pub held: f32,\n    pub out: f32,\n    pub radius: f32,\n    pub inside: bool,\n    pub started: bool,\n    pub flop: f32,\n    pub grace: f32,\n    pub waves: bool,\n    pub wave_in: f32,\n    pub said: u8,\n    pub kettle: Option<EntityId>,\n    pub result: Option<f32>,\n}\n\nimpl PlankStandoff {\n    pub fn new(len: f32, waves: bool) -> Self {\n        Self { len, waves, radius: 0.4, grace: 3.0, wave_in: 3.0, ..Default::default() }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        if !self.waves {\n            let at = cx.stage(Set::Gazebo);\n            ready_player(cx, Set::Gazebo, at, 1.2);\n            cam(cx.sim, 12.0, 30.0, 8.0, 36.0);\n            self.kettle = npc(cx.sim, \"kettle\");\n            c.say_key(Who::Kettle, \"kettle.plank_start\", 0);\n        }\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.plank;\n        let dt = cx.dt;\n        if self.flop > 0.0 {\n            self.flop -= dt;\n            scrub(cx.sim, cx.pid, \"FIT/Flop\", 1.0 - clamp01(self.flop / 1.6));\n            return (self.flop <= 0.0).then_some(self.result.unwrap_or(0.0));\n        }\n        let braced = it.brace();\n        if braced && !self.started {\n            self.started = true;\n            cx.sfx(sound::GRUNT_BELL, 0.5, 0.8);\n        }\n        if !self.started {\n            self.grace -= dt;\n        } else {\n            self.held += dt;\n        }\n        let u = clamp01(self.held / self.len);\n        self.radius = r.ring_start + (r.ring_end - r.ring_start) * u;\n        let fatigue = 1.0 + r.fatigue * u;\n        let tremble = if self.held > r.tremble_at { r.tremble * ((c.t * 31.0).sin() * 0.6 + (c.t * 47.0).sin() * 0.4) } else { 0.0 };\n        let mut nudge = Vec2::new(tremble, tremble * 0.7);\n        if !self.waves && self.held > r.laugh_at && self.said < 3 {\n            self.said = 3;\n            c.say_key(Who::Kettle, \"kettle.plank_joke\", 0);\n            nudge += Vec2::new(r.laugh_nudge, r.laugh_nudge * 0.5);\n            cx.sfx(sound::GONG, 0.5, 0.7);\n        } else if self.held > r.tremble_at && self.said < 2 {\n            self.said = 2;\n            c.say_key(Who::Kettle, \"kettle.plank_talk\", 1);\n        } else if self.held > r.tremble_at * 0.5 && self.said < 1 {\n            self.said = 1;\n            c.say_key(Who::Kettle, \"kettle.plank_talk\", 0);\n        }\n        if self.waves {\n            self.wave_in -= dt;\n            if self.wave_in <= 0.0 {\n                self.wave_in = 2.6;\n                let a = c.t * 2.1;\n                nudge += Vec2::new(a.cos(), a.sin()) * cx.rules.stand.wave_nudge;\n                cx.sfx(sound::WAVE, 0.7, 1.0);\n                let at = cx.feet();\n                cx.ev.push(crate::frame::SimEvent::BigSplash { pos: at + Vec3Ext::side(a), size: 0.5 });\n            }\n        }\n        c.step(cx, it.lean, r.wobble * fatigue, Vec2::ZERO, nudge);\n        self.inside = c.core.cob.length() < self.radius;\n        if self.inside {\n            self.out = 0.0;\n        } else {\n            self.out += dt;\n        }\n        c.score = clamp01(self.held / 60.0) * 1000.0;\n        scrub(cx.sim, cx.pid, \"FIT/Plank\", 0.0);\n        lean_figure(cx.sim, cx.pid, c.core.cob * 0.5, 30.0, 8.0, 0.0);\n        let gave_up = self.started && !braced;\n        let fell = self.out > r.out_time;\n        let never = !self.started && self.grace <= 0.0;\n        if gave_up || fell || never || self.held >= self.len {\n            let done = self.held >= self.len;\n            if done {\n                self.result = Some(c.score);\n                c.say_key(Who::Kettle, \"kettle.plank_win\", 0);\n                self.flop = 1.6;\n            } else {\n                self.result = Some(c.score);\n                c.say_key(Who::Kettle, \"kettle.plank_fail\", 0);\n                self.flop = 1.6;\n                cx.sfx(sound::BUMP, 1.0, 0.7);\n            }\n        }\n        None\n    }\n\n    pub fn stop(&mut self, _cx: &mut Cx) {}\n\n    pub fn hud(&self, c: &RunCommon, _r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Plank Standoff\", Some(self.len - self.held));\n        let mut p = c.puck(true);\n        p.ring = Some([0.0, 0.0, self.radius]);\n        p.good = self.inside;\n        ui.puck(p);\n        if !self.started {\n            ui.label(960.0, 430.0, 64.0, CORAL, Align::Center, \"Brace to begin\");\n        }\n        ui.label(960.0, 880.0, 72.0, INK, Align::Center, format!(\"{:.1} s\", self.held));\n        ui.prompt_row(&[(Act::Brace, \"Hold both\"), (Act::Lean, \"Stay in the ring\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, _r: &Rules) -> Intent {\n        let lean = (-c.core.cob * 1.4 - c.core.vel * 0.12).clamp_length_max(1.0);\n        Intent { l: true, r: true, l_just: !self.started, r_just: !self.started, lean, ..Default::default() }\n    }\n}\n\n/// A point a little to one side, for wave splashes.\nstruct Vec3Ext;\nimpl Vec3Ext {\n    fn side(a: f32) -> glam::Vec3 {\n        glam::Vec3::new(a.cos() * 3.0, 0.0, a.sin() * 2.0 - 1.0)\n    }\n}\nEOF\nsed -i 's/sound::GRUNT_BELL/sound::BELL/' plank.rs; cd ../../../../../../..; pwd","description":"Write events framework and first four events"}}}
