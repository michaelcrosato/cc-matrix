 const CROUCH: u32 = 1 << 1;\n    pub const INTERACT: u32 = 1 << 2;\n    pub const USE: u32 = 1 << 3;\n    pub const FOCUS: u32 = 1 << 4;\n    pub const SPRINT: u32 = 1 << 5;\n    pub const PRIMARY: u32 = 1 << 6;\n    pub const SECONDARY: u32 = 1 << 7;\n    pub const CRAWL: u32 = 1 << 8;\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\n    pub const SKILL3: u32 = 1 << 9;\n    pub const SKILL4: u32 = 1 << 10;\n    pub const SKILL5: u32 = 1 << 11;\n    pub const SKILL6: u32 = 1 << 12;\n    pub const DODGE: u32 = 1 << 13;\n    pub const POTION: u32 = 1 << 14;\n\n    pub const NAMES: &[(&str, u32)] = &[\n        (\"jump\", JUMP),\n        (\"crouch\", CROUCH),\n        (\"interact\", INTERACT),\n        (\"use\", USE),\n        (\"focus\", FOCUS),\n        (\"sprint\", SPRINT),\n        (\"primary\", PRIMARY),\n        (\"secondary\", SECONDARY),\n        (\"crawl\", CRAWL),\n        (\"skill3\", SKILL3),\n        (\"skill4\", SKILL4),\n        (\"skill5\", SKILL5),\n        (\"skill6\", SKILL6),\n        (\"dodge\", DODGE),\n        (\"potion\", POTION),\n    ];\n\n    pub fn from_name(n: &str) -> Option<u32> {\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct InputFrame {\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\n    pub move_dir: Vec2,\n    /// Vertical intent for climbing/flying/swimming (-1..1).\n    #[serde(default)]\n    pub vertical: f32,\n    /// World-space aim point (mouse on the ground plane, or stick projection).\n    #[serde(default)]\n    pub aim: Option<Vec3>,\n    /// Buttons held this tick.\n    #[serde(default)]\n    pub held: u32,\n    /// Buttons that went down since the previous tick (never lost, even for short taps).\n    #[serde(default)]\n    pub pressed: u32,\n    /// A menu action this tick (Shardfall: equip, sell, travel...), queued one per tick.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub cmd: Option<crate::arpg::GameCmd>,\n}\n\nimpl InputFrame {\n    pub fn down(&self, b: u32) -> bool {\n        self.held & b != 0\n    }\n    pub fn just(&self, b: u32) -> bool {\n        self.pressed & b != 0\n    }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"040add3c-d29f-4201-8098-56aeb97286f5","timestamp":"2026-11-05T05:39:45.244Z","tool_use_result":{"stdout":"    521 crates/pav_tools/src/import/fit/prims.rs\n    531 crates/pav_tools/src/agent_tools.rs\n    535 crates/pav_core/src/entity.rs\n    539 crates/pav_tools/src/mocap/fbx.rs\n    554 crates/pav_core/src/level.rs\n    566 crates/pav_core/src/moves.rs\n    577 crates/pav_core/src/props/read/mod.rs\n    583 crates/pav_view/src/arpg.rs\n    589 crates/pav_core/src/arpg/genome.rs\n    606 crates/pav_tools/tests/import.rs\n    609 crates/pav_core/src/creatures.rs\n    613 crates/pav_tools/src/animation_tools.rs\n    620 crates/pav_tools/src/import/fit/write.rs\n    631 crates/pav_app/src/input.rs\n    631 crates/pav_core/tests/levels.rs\n    636 crates/pav_core/src/room.rs\n    651 crates/pav_tools/src/asset_preview_tools.rs\n    661 crates/pav_tools/src/asset_library.rs\n    664 crates/pav_app/src/look_ui.rs\n    664 crates/pav_tools/src/mocap/takes.rs\n    665 crates/pav_render/src/fx.rs\n    675 crates/pav_tools/tests/mocap.rs\n    682 crates/pav_render/src/scene.rs\n    684 crates/pav_audio/src/lib.rs\n    692 crates/pav_tools/src/mocap/bvh.rs\n    698 crates/pav_tools/src/mocap/mod.rs\n    720 crates/pav_core/src/arpg/data.rs\n    726 crates/pav_core/src/statics.rs\n    728 crates/pav_app/src/asset_ui.rs\n    741 crates/pav_app/src/creature_ui.rs\n    741 crates/pav_core/src/props/lint.rs\n    765 crates/pav_tools/src/asset_search.rs\n    766 crates/pav_core/src/arpg/tree.rs\n    768 crates/pav_ui/src/arpg_ui.rs\n    772 crates/pav_core/src/materia