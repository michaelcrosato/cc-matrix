n chart\n{'bpm': 96.0, 'lead_in_beats': 8.0, 'party': 24, 'finale': 16}\n# Step Party notes, one line per 4/4 bar of sixteenths: L left, R right, B both, . nothing.\n# 96 BPM. Starts with quarter notes and builds to eighths and doubles.\nbpm = 96.0\nlead_in_beats = 8.0\n\nparty = [\n  \"L.......R.......\",\n  \"L.......R.......\",\n  \"L...R...L...R...\",\n  \"L...R...L...R...\",\n  \"L...L...R...R...\",\n  \"L...R...L...R...\",\n--- step bounce/clap/box\n57:    pub bounce: Option<EntityId>,\n98:        self.bounce = npc(cx.sim, \"bounce\");\n99:        self.guests = cx.sim.state.entities.iter().filter(|e| e.name.starts_with(\"clapper\")).map(|e| e.id).collect();\n100:        c.say_key(Who::Bounce, \"bounce.step_start\", 0);\n153:        let song = match it.song_pos {\n186:        // The figure steps; the box bounces on the beat.\n205:            if let Some(bo) = self.bounce {\n215:                    cx.sfx(sound::CLAP, 0.35, 1.0);\n--- lap flipflop & hazards\n1://! Morning Lap: one lap of the island. Alternate steps to set your pace, dodge, grab ribbons.\n14:    /// 0 ribbon, 1 crab, 2 sunbather, 3 towel.\n28:    pub ribbons: u32,\n36:    pub flips: Vec<EntityId>,\n102:        // Ribbons and hazards, the same on a seed.\n118:                0 => (\"LIB/core/ribbon\", 1.0),\n119:                1 => (\"LIB/core/crab\", 1.0),\n121:                _ => (\"LIB/core/towel_stack\", 1.0),\n222:                self.ribbons += 1;\n223:                cx.sfx(sound::RIBBON, 0.7, 1.0 + self.ribbons as f32 * 0.04);\n233:        let n_ribbons = self.things.iter().filter(|t| t.kind == 0).count().max(1) as f32;\n236:        let rib = clamp01(self.ribbons as f32 / n_ribbons);\n--- tide\n22:    /// Moving pools drift on this axis.\n31:    pub bumpers: Vec<(Vec2, EntityId)>,\n39:    pub skip_flash: f32,\n65:        for (_, id) in self.bumpers.drain(..) {\n91:                let id = spawn_prop(cx.sim, \"LIB/core/bumper\", self.center, 0.0, 1.0);\n92:                self.bumpers.push((p, id));\n126:        self.skip_flash = (self.skip_flash - dt).max(0.0);\n138:            self.edge = (self.edge - dt * r.tide_rise).max(r.half * 0.55);\n149:        let bumpers: Vec<Vec2> = self.bumpers.iter().map(|b| b.0).collect();\n150:        for (p, id) in &self.bumpers {\n--- tray\n24:    /// 0 wave, 1 plank gap, 2 gull.\n42:    pub marjorie: Option<EntityId>,\n76:                jolt.ent = Some(spawn_box(cx.sim, \"gap\", p, Vec3::new(1.6, 0.012, 0.35), \"#35586a\"));\n80:        self.marjorie = npc(cx.sim, \"marjorie_pier\");\n81:        c.say_key(Who::Gull, \"gull.tray_start\", 0);\n100:                self.warn_word = [\"Wave!\", \"Plank gap!\", \"Gull!\"][j.kind as usize].to_string();\n103:                    j.ent = Some(spawn_prop(cx.sim, \"LIB/core/gull\", p, 0.0, 1.2));\n104:                    cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::GULL, gain: 0.9, pitch: 1.0 });\n106:                    cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::WAVE, gain: 0.7, pitch: 1.0 });\n116:                    _ => cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::GULL, gain: 1.0, pitch: 1.3 }),\n121:        // A swooping gull crosses over.\n184:            c.say_key(Who::Gull, \"gull.tray_spill\", self.spilled as usize);\n--- finale\n        // The Long Stillness: nothing happens, and the game tries to make you press something.\n        self.still_t += dt;\n        c.step(cx, it.lean, 0.35, Vec2::ZERO, Vec2::ZERO);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, rules.core.tilt_deg, cx.slump);\n        if self.peace && (it.any || it.act_just || it.l_just || it.r_just) {\n            self.peace = false;\n            cx.sfx(sound::GROAN, 0.5, 1.2);\n        }\n        if self.still_t >= rules.stand.stillness && !self.spoke {\n            self.spoke = true;\n            let n = self.scores.len().max(1) as f32;\n            let avg = self.scores.iter().sum::<f32>() / n;\n            let bonus = if self.peace { rules.stand.peace_bonus } else { 0.0 };\n            self.final_score = (avg * (1000.0 - rules.stand.peace_bonus) / 1000.0 + bonus - self.tips as f32 * rules.stand.tip_cost).clamp(0.0, 1000.0);\n            c.score = self.final_score;\n            c.say_key(Who::Pip, \"pip.stand_end\", self.peace as usize);\n            self.ending = 4.0;\n            cx.sfx(sound::FANFARE, 0.8, 1.0);\n            cx.sfx(sound::CONFETTI, 0.8, 1.0);\n            cx.ev.push(SimEvent::Confetti { pos: self.post + Vec3::Y * 2.0 });\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(mut st) = self.sub.take() {\n            st.stop(cx);\n        }\n    }\n\n    pub fn stillness(&self) -> bool {\n        self.phase >= 4 && self.card <= 0.0 && self.ending <= 0.0\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        if self.card > 0.0 && self.phase < 5 {\n            ui.card(560.0, 90.0, 800.0, 170.0);\n            ui.text(960.0, 104.0, 36.0, INK_SOFT, Align::Center, format!(\"Phase {} of 5\", self.phase + 1));\n            ui.label(960.0, 158.0, 62.0, INK, Align::Center, PHASES[self.phase.min(4)]);\n            return;\n        }\n        if self.phase < 4 {\n            if let Some(s) = &self.sub {\n                s.hud(c, r, ui);\n            }\n            return;\n        }\n        if self.ending > 0.0 {\n            return;\n        }\n        // Stillness: the HUD vanishes, except the Puck.\n        ui.puck(c.puck(true));\n        if self.still_t >= r.stand.fake_prompt_at && self.still_t < r.stand.fake_prompt_at + 6.0 {\n            ui.prompt_row(&[(Act::Confirm, \"Press to skip\")]);\n        }\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        if self.card > 0.0 || self.fall > 0.0 {\n            return Intent::default();\n        }\n        if self.phase < 4 {\n            if let Some(s) = &self.sub {\n                let mut sc = c.clone();\n                sc.t = c.t - self.t0;\n                return s.bot(&sc, r);\n            }\n        }\n        Intent::default()\n    }\n}\n--- sfx names\n\nengine/crates/pav_audio/src/music.rs:113:pub const SONG_COUNT: u8 = 6;\nengine/crates/pav_audio/src/voice.rs:7:pub const FORMANTS: [(f32, f32); 5] = [(800.0, 1150.0), (420.0, 1950.0), (300.0, 2300.0), (480.0, 820.0), (340.0, 700.0)];\nengine/crates/pav_audio/src/lib.rs:16:pub const BUS_SFX: usize = 0;\nengine/crates/pav_audio/src/lib.rs:17:pub const BUS_VOICE: usize = 1;\nengine/crates/pav_audio/src/lib.rs:18:pub const BUS_MUSIC: usize = 2;\nengine/crates/pav_audio/src/lib.rs:56:    pub const fn new(wave: Wave, freq: f32) -> Self {\nengine/crates/pav_audio/src/lib.rs:603:pub fn sfx_bank(id: u16, pitch: f32) -> Vec<(Patch, f32)> {\n--- audio settings\nengine/crates/pav_audio/src/lib.rs:832:        let config = cpal::StreamConfig { buffer_size: cpal::BufferSize::Fixed(1024), ..config };\nengine/crates/pav_app/src/app.rs:342:        self.resume_audio();\nengine/crates/pav_app/src/app.rs:1045:            self.resume_audio();\nengine/crates/pav_app/src/app.rs:2328:    fn resume_audio(&mut self) {\nengine/crates/pav_app/src/app.rs:2392:                self.resume_audio();\nengine/crates/pav_app/src/app.rs:2402:                self.resume_audio();\nengine/crates/pav_app/src/app.rs:2441:                self.resume_audio();\n--- cursor\nengine/crates/pav_app/src/app.rs:1257:                g.window.set_cursor_visible(self.input.last_device != Device::Gamepad);\n--- transitions\nengine/crates/pav_app/src/app.rs:179:    arrival: Option<Instant>,\nengine/crates/pav_app/src/app.rs:288:            arrival: None,\nengine/crates/pav_app/src/app.rs:749:        self.arrival = Some(Instant::now());\nengine/crates/pav_app/src/app.rs:1202:                    self.arrival = Some(Instant::now());\nengine/crates/pav_app/src/app.rs:1215:                    self.arrival = Some(now);\nengine/crates/pav_app/src/app.rs:1411:        // Save the hero on every arrival somewhere, and once a minute while playing.\ne