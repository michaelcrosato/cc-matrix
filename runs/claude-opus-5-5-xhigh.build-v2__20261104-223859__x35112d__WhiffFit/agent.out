ub act: MAct,\n    pub label: String,\n    pub sub: String,\n    pub kind: ItemKind,\n    pub stars: Option<u8>,\n}\n\nimpl MItem {\n    pub fn button(act: MAct, label: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Button, stars: None }\n    }\n    pub fn sub(mut self, sub: impl Into<String>) -> Self {\n        self.sub = sub.into();\n        self\n    }\n    pub fn stars(mut self, n: u8) -> Self {\n        self.stars = Some(n);\n        self\n    }\n    pub fn locked(mut self) -> Self {\n        self.kind = ItemKind::Locked;\n        self\n    }\n    pub fn slider(act: MAct, label: impl Into<String>, frac: f32, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Slider { frac, value: value.into() }, stars: None }\n    }\n    pub fn choice(act: MAct, label: impl Into<String>, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Choice { value: value.into() }, stars: None }\n    }\n}\n\n#[derive(Clone, Debug)]\npub struct Menu {\n    /// A name for tests: `title`, `pause`...\n    pub key: &'static str,\n    pub title: String,\n    pub sub: String,\n    pub items: Vec<MItem>,\n    pub layout: Layout,\n    pub tabs: Option<(Vec<&'static str>, usize)>,\n    pub back: bool,\n    /// Draws a card behind it, and how wide.\n    pub card: bool,\n    pub dim: bool,\n}\n--- puck placement\nengine/crates/pav_core/src/games/fit/check.rs:243:                let mut p = self.c.puck(true);\nengine/crates/pav_core/src/games/fit/check.rs:251:                        ui.puck(p);\nengine/crates/pav_core/src/games/fit/finale.rs:200:        // Stillness: the HUD vanishes, except the Puck.\nengine/crates/pav_core/src/games/fit/finale.rs:201:        ui.puck(c.puck(true));\nengine/crates/pav_core/src/games/fit/events/pose.rs:148:        let mut p = c.puck(true);\nengine/crates/pav_core/src/games/fit/events/pose