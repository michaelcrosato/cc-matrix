e/palm\", math.cos(a * 2.1) * rng.uniform(10, 18), 0, -abs(math.si\ntools/make_sets.py:306:        r.obj(\"LIB/core/palm\", -30 + i * 4 + rng.uniform(-1, 1), 0, -13 - rng.uniform(0\ntools/make_sets.py:339:        r.obj(\"LIB/core/palm\", side * rng.uniform(14, 22), 0, 12 - i * 5.0, yaw=rng.uni\n--- ghost lanes per event\n27:fn r2(x: f32) -> f32 {\n32:    pub fn new(p: Vec3, f: f32, l: Vec2, c: u32, t: f32, s: f32) -> Self {\n36:    pub fn lerp(&self, o: &GFrame, u: f32) -> GFrame {\now.rs:1795:                    _ => &mut d.ghost_lanes,\nreens.rs:446:                items.push(MItem::choice(MAct::DevFlag(7), \"Ghost Lanes\", onoff(d.ghost_\nents/mod.rs:133:    pub fn lane(self) -> Vec3 {\nd.rs:75:    pub ghost_lanes: bool,\nd.rs:95:            ghost_lanes: true,\nd.rs:540:        if !self.dev.ghost_lanes {\n--- tests: area & songs\n641:    assert_eq!(v[\"hub\"][\"ghost\"][\"area\"], -1);\n657:    assert_eq!(v[\"hub\"][\"ghost\"][\"area\"], 0, \"{v}\");\n    fn every_sound_in_the_bank_makes_noise() {\n        use pav_core::games::fit::world::sound;\n        for id in 0..sound::TOTAL {\n            let ev = SimEvent::Sfx { id, gain: 1.0, pitch: 1.0 };\n            let out = render_events(&[(0.0, ev)], 3.0, 22050.0, &Listener::default());\n            let peak = out.iter().fold(0.0f32, |m, s| m.max(s.abs()));\n            assert!(peak > 0.005, \"sound {id} is silent\");\n        }\n    }\n\n    #[test]\n    fn a_song_fades_to_silence_and_holds_still() {\n        let mut m = Mixer::new(22050.0);\n        m.bus = [1.0, 1.0, 1.0];\n        m.set_song(6);\n        let mut b = vec![0.0; 22050 * 2];\n        m.render(&mut b);\n        assert!(rms(&b) > 0.01);\n        let at = m.song_pos.load(Ordering::Relaxed);\n        assert!(at > 20000);\n        m.hold = true;\n        m.render(&mut b);\n        assert_eq!(m.song_pos.load(Ordering::Relaxed), at);\n--- exit interview aiHub\n{'aiHub': {'name': 'Whiff Fit', 'tagline': 'A balance comedy at Tippy Cay', 'description': 'Five days at a resort staffed by talking gym equipment. Lean, breathe, squat, dive and stand very still until your Balance Age lets you leave.', 'type': 'Game', 'genre': 'Sports', 'source': 'Wii Fit', 'series': 'Wii Fit', 'players': '1–4', 'controls': 'Left stick, WASD or mouse leans and walks; Cross, Space or click is the action; L1/R1, Q/E or the mouse buttons are your feet.', 'tags': ['3d', 'third-person', 'comedy', 'sports', 'versus', 'low-poly']}}\n--- page about line\n505:                                     about: document.getElementById('about-data')?.textContent ?? '',\n#!/usr/bin/env bash\n# The one test command: tests/run.sh [core|browser|hub|all]. Prints only failures and a count.\nset -u\nhere=$(cd \"$(dirname \"$0\")\" && pwd)\nwhat=${1:-all}\npassed=0; failed=0\ntally() { # reads a test command's own \"N passed, M failed\" or cargo's result lines\n  local out=$1\n  while read -r p f; do passed=$((passed + p)); failed=$((failed + f)); done < <(printf '%s\\n' \"$out\" | sed -n -E 's/^test result: [a-zA-Z]+\\. ([0-9]+) passed; ([0-9]+) failed.*/\\1 \\2/p; s/^([0-9]+) passed, ([0-9]+) failed$/\\1 \\2/p')\n}\ncore() {\n  cd \"$here/../engine\"\n  local o\n  o=$(CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-8} cargo test -q --locked -p pav_core --test fit 2>&1); printf '%s\\n' \"$o\" | grep -E '^(error|test .* FAILED|thread .* panicked|---- )|panicked at|FAILED' | cut -c1-400; tally \"$o\"\n  o=$(CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-8} cargo test -q --locked -p pav_audio -p pav_ui 2>&1); printf '%s\\n' \"$o\" | grep -E '^(error|test .* FAILED|thread .* panicked|---- )|panicked at|FAILED' | cut -c1-400; tally \"$o\"\n}\npy() { cd \"$here\"; local o; o=$(python3 \"$1\" 2>&1); printf '%s\\n' \"$o\" | grep -vE '^[0-9]+ passed, [0-9]+ failed$' | cut -c1-600; tally \"$o\"; }\ncase $what in\n  core) core ;;\n  browser) py browser.py ;;\n  hub) py hub.py ;;\n  all) core; py browser.py; py hub.py ;;\n  *) echo \"usage: tests/run.sh [core|browser|hub|all]\"; exit 2 ;;\nesac\necho 