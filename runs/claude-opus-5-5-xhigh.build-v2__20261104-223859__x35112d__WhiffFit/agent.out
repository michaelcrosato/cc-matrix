with [`entry`].\npub struct Entry {\n    pub key: &'static str,\n    pub about: &'static str,\n    /// Builds the scene and sets `sim.state.play`. The `&str` is the rest of the scene name\n    /// after `<key>/` (a level number, say), if any.\n    pub build: fn(&mut Sim, Option<&str>) -> Result<()>,\n    load: fn(ciborium::Value) -> Result<GameBox, String>,\n}\n\n/// A [`GAMES`] line for the game type `G`.\npub const fn entry<G: Game>(about: &'static str, build: fn(&mut Sim, Option<&str>) -> Result<()>) -> Entry {\n    Entry { key: G::KEY, about, build, load: load_as::<G> }\n}\n\nfn load_as<G: Game>(v: ciborium::Value) -> Result<GameBox, String> {\n    v.deserialized::<G>().map(GameBox::new).map_err(|e| e.to_string())\n}\n\n/// A game's level text: `crates/pav_core/src/games/<key>.toml` read from disk when the program\n/// runs from the repository's root (`pav`, `cargo run`), so an edit shows at the next `load`\n/// with no rebuild; else `built_in`, the copy embedded with `include_str!` (tests, the browser,\n/// a shipped executable).\npub fn level_text(key: &str, built_in: &'static str) -> std::borrow::Cow<'static, str> {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    if let Ok(text) = std::fs::read_to_string(format!(\"crates/pav_core/src/games/{key}.toml\")) {\n        return text.into();\n    }\n    #[cfg(target_arch = \"wasm32\")]\n    let _ = key; // the browser has no files\n    built_in.into()\n}\n\n/// The game registered under `key`.\npub fn find(key: &str) -> Option<&'static Entry> {\n    GAMES.iter().find(|g| g.key == key)\n}\n\n/// A running game in `SimState::play`: clones (rewind, snapshots) and serializes (snapshot\n/// files, the state hash) through the game's own derives.\npub struct GameBox(Box<dyn DynGame>);\n\nimpl GameBox {\n    pub fn new<G: Game>(game: G) -> Self {\n        Self(Box::new(game))\n    }\n\n    pub fn key(&self) -> &'static str {\n        self.0.key()\n    }\n\n    /// The game as its own type (None for another game).\n    pub fn get<G: Game>(&self) -> Option<&G> {\n        self.0.as_any().downcast_ref()\n    }\n\n    pub fn get_mut<G: Game>(&mut self) -> Option<&mut G> {\n        self.0.as_any_mut().downcast_mut()\n    }\n\n    pub fn hud(&self, sim: &Sim) -> Vec<String> {\n        self.0.hud(sim)\n    }\n\n    pub fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.0.status(sim)\n    }\n\n    pub fn outcome(&self) -> Outcome {\n        self.0.outcome()\n    }\n\n    pub fn bot(&self, sim: &Sim) -> InputFrame {\n        self.0.bot(sim)\n    }\n}\n\nimpl Clone for GameBox {\n    fn clone(&self) -> Self {\n        Self(self.0.clone_box())\n    }\n}\n\n#[derive(Serialize, Deserialize)]\nstruct Saved {\n    key: String,\n    state: ciborium::Value,\n}\n\nimpl Serialize for GameBox {\n    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {\n        let state = self.0.save().map_err(serde::ser::Error::custom)?;\n        Saved { key: self.key().to_string(), state }.serialize(s)\n    }\n}\n\nimpl<'de> Deserialize<'de> for GameBox {\n    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {\n        let saved = Saved::deserialize(d)?;\n        let Some(entry) = find(&saved.key) else {\n            let known: Vec<&str> = GAMES.iter().map(|g| g.key).collect();\n            return Err(D::Error::custom(format!(\"unknown game '{}' (known: {})\", saved.key, known.join(\", \"))));\n        };\n        (entry.load)(saved.state).map_err(D::Error::custom)\n    }\n}\n\n/// [`Game`] as an object (the trait itself isn't one: `Clone` and serde).\ntrait DynGame: Send + Sync {\n    fn key(&self) -> &'static str;\n    fn clone_box(&self) -> Box<dyn DynGame>;\n    fn save(&self) -> Result<ciborium::Value, String>;\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame>;\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>);\n    fn hud(&self, sim: &Sim) -> Vec<String>;\n    fn status(&self, sim: &Sim) -> serde_json::Value;\n    fn outcome(&self) -> Outcome;\n    fn bot(&self, sim: &Sim) -> InputFrame;\n    fn as_any(&self) -> &dyn Any;\n    fn as_any_mut(&mut self) -> &mut dyn Any;\n}\n\nimpl<G: Game> DynGame for G {\n    fn key(&self) -> &'static str {\n        G::KEY\n    }\n    fn clone_box(&self) -> Box<dyn DynGame> {\n        Box::new(self.clone())\n    }\n    fn save(&self) -> Result<ciborium::Value, String> {\n        ciborium::Value::serialized(self).map_err(|e| e.to_string())\n    }\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        Game::pre(self, sim, input, dt, events)\n    }\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\n        Game::post(self, sim, dt, events)\n    }\n    fn hud(&self, sim: &Sim) -> Vec<String> {\n        Game::hud(self, sim)\n    }\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        Game::status(self, sim)\n    }\n    fn outcome(&self) -> Outcome {\n        Game::outcome(self)\n    }\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        Game::bot(self, sim)\n    }\n    fn as_any(&self) -> &dyn Any {\n        self\n    }\n    fn as_any_mut(&mut self) -> &mut dyn Any {\n        self\n    }\n}\n\nimpl Sim {\n    /// The running game from [`GAMES`], if this scene is one.\n    pub fn play(&self) -> Option<&GameBox> {\n        self.state.play.as_ref()\n    }\n\n    /// The running game's outcome (`Playing` when there is none).\n    pub fn outcome(&self) -> Outcome {\n        self.play().map(|g| g.outcome()).unwrap_or_default()\n    }\n\n    /// The running game's bot input (none without a game).\n    pub fn bot_input(&self) -> InputFrame {\n        self.play().map(|g| g.bot(self)).unwrap_or_default()\n    }\n\n    pub(crate) fn play_pre(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        let Some(mut g) = self.state.play.take() else { return BTreeMap::new() };\n        let out = g.0.pre(self, input, dt, events);\n        self.state.play = Some(g);\n        out\n    }\n\n    pub(crate) fn play_post(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut g) = self.state.play.take() else { return };\n        g.0.post(self, dt, events);\n        self.state.play = Some(g);\n    }\n\n    pub(crate) fn play_hud(&self) -> Vec<String> {\n        self.play().map(|g| g.hud(self)).unwrap_or_default()\n    }\n\n    /// Plays the running game with its bot until it is won or lost, or `ticks` pass.\n    /// Returns the outcome and the ticks played.\n    pub fn run_bot(&mut self, ticks: u64) -> (Outcome, u64) {\n        for t in 0..ticks {\n            let o = self.outcome();\n            if o != Outcome::Playing {\n                return (o, t);\n            }\n            let input = self.bot_input();\n            self.step(&input);\n        }\n        (self.outcome(), ticks)\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NjHMJQE4BNBj9ooWeKBFr4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjF6zdy6WXzoZ2zegKpj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Rnx1nASs4euGTQT9sGJeEb","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/sim.rs","limit":700},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8944,"cache_read_input_tokens":70735,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8944},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"a494769e-fe9f-40ee-97c4-e901394ae1fb","timestamp":"2026-11-05T05:39:49.360Z","request_id":"req_011CgjF6zMMTAXEaBNTpMgGH","wire_tool_inputs":{"toolu_01Rnx1nASs4euGTQT9sGJeEb":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/sim.rs","limit":700}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rnx1nASs4euGTQT9sGJeEb","type":"tool_result","content":"1\t//! The simulation: fixed-tick, headless, snapshot-able, rewindable.\n2\t\n3\tuse std::path::Path;\n4\t\n5\tuse anyhow::{Context, Result};\n6\tuse glam::{Quat, Vec3};\n7\tuse rapier::prelude::*;\n8\tuse serde::{Deserialize, Serialize};\n9\t\n10\tuse crate::character::{self, Action, BombParams, Character, MovementParams, RADIUS};\n11\tuse crate::choice_enum;\n12\tuse crate::color::Color;\n13\tuse crate::course::Courses;\n14\tuse crate::entity::{Behavior, BodyKind, Bomb, Entities, Entity, EntityId, Spawn};\n15\tuse crate::feel::FeelMeter;\n16\tuse crate::frame::{PuppetFrame, RenderFrame, RenderObject, SimEvent};\n17\tuse crate::history::{History, Replay};\n18\tuse crate::input::InputFrame;\n19\tuse crate::params::{ChoiceParam, ParamVisitor, Tunable, nested};\n20\tuse crate::physics::{EventCollector, PhysicsState, entity_tag};\n21\tuse crate::projectile::{Projectiles, Target};\n22\tuse crate::puppet::PuppetDef;\n23\tuse crate::rng::Rng;\n24\tuse crate::shape::{Look, Shape, Visual};\n25\tuse crate::statics::{StaticWorld, block_flags};\n26\tuse crate::terrain::TerrainParams;\n27\tuse crate::world::World;\n28\t\n29\tchoice_enum! {\n30\t    pub enum TickRate { Hz60 => \"60\", Hz120 => \"120\", Hz240 => \"240\" }\n31\t}\n32\t\n33\timpl TickRate {\n34\t    pub fn hz(self) -> u32 {\n35\t        match self {\n36\t            TickRate::Hz60 => 60,\n37\t            TickRate::Hz120 => 120,\n38\t            TickRate::Hz240 => 240,\n39\t        }\n40\t    }\n41\t}\n42\t\n43\t#[derive(Clone, Debug, PartialEq)]\n44\tpub struct SimConfig {\n45\t    pub tick_rate: TickRate,\n46\t    /// World gravity for physics props (m/s², positive = down).\n47\t    pub gravity: f32,\n48\t    /// How far back rewind can go (seconds).\n49\t    pub history_seconds: f32,\n50\t    pub movement: MovementParams,\n51\t    pub bombs: BombParams,\n52\t    pub puppet: PuppetDef,\n53\t    pub terrain: TerrainParams,\n54\t    /// Shardfall difficulty multipliers.\n55\t    pub difficulty: crate::arpg::Difficulty,\n56\t    /// Performers: tempo and mirroring of their clips and moves.\n57\t    pub anim: crate::clips::AnimParams,\n58\t}\n59\t\n60\timpl Default for SimConfig {\n61\t    fn default() -> Self {\n62\t        Self {\n63\t            tick_rate: TickRate::Hz60,\n64\t            gravity: 9.81,\n65\t            history_seconds: 30.0,\n66\t            movement: MovementParams::default(),\n67\t            bombs: BombParams::default(),\n68\t            puppet: PuppetDef::default(),\n69\t            terrain: TerrainParams::default(),\n70\t            difficulty: crate::arpg::Difficulty::default(),\n71\t            anim: crate::clips::AnimParams::default(),\n72\t        }\n73\t    }\n74\t}\n75\t\n76\t/// Only the simulation-level fields (groups are visited by `visit_groups`).\n77\timpl Tunable for SimConfig {\n78\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n79\t        self.tick_rate.visit_choice(v, \"tick_rate\", \"Simulation ticks per second\");\n80\t        v.float(\"gravity\", &mut self.gravity, 0.0, 40.0, \"Gravity for physics props (m/s²)\");\n81\t        v.float(\"history_seconds\", &mut self.history_seconds, 0.0, 300.0, \"Rewind window (s); 0 disables\");\n82\t    }\n83\t}\n84\t\n85\timpl SimConfig {\n86\t    /// Visits every simulation tunable as top-level groups: sim, movement, bombs, puppet, world,\n87\t    /// difficulty, anim.\n88\t    pub fn visit_groups(&mut self, v: &mut dyn ParamVisitor) {\n89\t        nested(v, \"sim\", self);\n90\t        nested(v, \"movement\", &mut self.movement);\n91\t        nested(v, \"bombs\", &mut self.bombs);\n92\t        nested(v, \"puppet\", &mut self.puppet);\n93\t        nested(v, \"world\", &mut self.terrain);\n94\t        nested(v, \"difficulty\", &mut self.difficulty);\n95\t        nested(v, \"anim\", &mut self.anim);\n96\t    }\n97\t}\n98\t\n99\t/// Everything that changes during play. Cloning it is a snapshot.\n100\t#[derive(Clone, Serialize, Deserialize)]\n101\tpub struct SimState {\n102\t    /// The prop definitions placed copies use, each once. Declared first: a restore reads it\n103\t    /// before the entities that name its keys.\n104\t    #[serde(default, skip_serializing_if = \"crate::props::PropDefTable::is_empty\")]\n105\t    pub prop_defs: crate::props::PropDefTable,\n106\t    pub tick: u64,\n107\t    pub seed: u64,\n108\t    pub rng: Rng,\n109\t    pub physics: PhysicsState,\n110\t    pub entities: Entities,\n111\t    pub statics: StaticWorld,\n112\t    pub scene: String,\n113\t    pub focus: Vec3,\n114\t    pub player: Option<EntityId>,\n115\t    pub spawn: Vec3,\n116\t    pub world: World,\n117\t    #[serde(default)]\n118\t    pub courses: Courses,\n119\t    #[serde(default)]\n120\t    pub projectiles: Projectiles,\n121\t    #[serde(default)]\n122\t    pub feel: FeelMeter,\n123\t    /// Signals sent by pads this tick (read by spawners next tick).\n124\t    #[serde(default)]\n125\t    pub signals: Vec<String>,\n126\t    /// Tiles that are crumbling or waiting to regrow.\n127\t    #[serde(default)]\n128\t    pub crumbles: Vec<crate::destruct::Crumble>,\n129\t    /// Shardfall, when this scene is part of the game.\n130\t    #[serde(default)]\n131\t    pub game: Option<Box<crate::arpg::Game>>,\n132\t    /// A game from `crate::games` (the starter, or one an agent added), when this scene is one.\n133\t    #[serde(default)]\n134\t    pub play: Option<crate::games::GameBox>,\n135\t    /// The animation stage freezes this world and publishes its own render frame.\n136\t    #[serde(default)]\n137\t    pub animation_preview: Option<crate::animation_preview::PreviewState>,\n138\t    /// None is only for legacy snapshots whose active animation stage predates this field.\n139\t    #[serde(default)]\n140\t    pub studio_mode: Option<crate::prop_preview::StudioMode>,\n141\t    #[serde(default)]\n142\t    pub prop_preview: Option<crate::prop_preview::PropPreviewState>,\n143\t    #[serde(default)]\n144\t    pub creature_preview: Option<crate::creature_preview::CreaturePreviewState>,\n145\t    #[serde(default)]\n146\t    pub studio_cameras: crate::prop_preview::StudioCameras,\n147\t}\n148\t\n149\timpl SimState {\n150\t    /// Rough memory footprint (for the history budget and stats).\n151\t    pub fn approx_bytes(&self) -> usize {\n152\t        self.physics.colliders.len() * 700\n153\t            + self.physics.bodies.len() * 600\n154\t            + self.entities.len() * 400\n155\t            + self.projectiles.list.len() * 64\n156\t            + 4096\n157\t    }\n158\t}\n159\t\n160\tpub struct Sim {\n161\t    pub config: SimConfig,\n162\t    pub state: SimState,\n163\t    /// Live feedback is a host transaction counter, independent of replay/snapshot time.\n164\t    pub live_edit_ticket: u64,\n165\t    pub history: History,\n166\t    /// Inputs since the scene was built (for replays and crash reports).\n167\t    pub recording: Replay,\n168\t    pipeline: PhysicsPipeline,\n169\t    pub(crate) events: Vec<SimEvent>,\n170\t    /// True while re-simulating (rewind): no events, no recording.\n171\t    replaying: bool,\n172\t    /// Shared copy of `config` for frames (refreshed when it changes).\n173\t    config_arc: std::sync::Arc<SimConfig>,\n174\t}\n175\t\n176\tconst MAX_RECORDING_TICKS: u64 = 60 * 60 * 60;\n177\t\n178\timpl Sim {\n179\t    /// An empty world.\n180\t    pub fn empty(seed: u64) -> Self {\n181\t        let config = SimConfig::default();\n182\t        let dt = 1.0 / config.tick_rate.hz() as f32;\n183\t        Self {\n184\t            state: SimState {\n185\t                prop_defs: Default::default(),\n186\t                tick: 0,\n187\t                seed,\n188\t                rng: Rng::new(seed),\n189\t                physics: PhysicsState::new(dt),\n190\t                entities: Entities::default(),\n191\t                statics: StaticWorld::default(),\n192\t                scene: String::new(),\n193\t                focus: Vec3::ZERO,\n194\t                player: None,\n195\t                spawn: Vec3::ZERO,\n196\t                world: World::default(),\n197\t                courses: Courses::default(),\n198\t                projectiles: Projectiles::default(),\n199\t                feel: FeelMeter::default(),\n200\t                signals: Vec::new(),\n201\t                crumbles: Vec::new(),\n202\t                game: None,\n203\t                play: None,\n204\t                animation_preview: None,\n205\t                studio_mode: Some(crate::prop_preview::StudioMode::World),\n206\t                prop_preview: None,\n207\t                creature_preview: None,\n208\t                studio_cameras: Default::default(),\n209\t            },\n210\t            live_edit_ticket: 0,\n211\t            config,\n212\t            history: History::default(),\n213\t            recording: Replay { seed, ..Default::default() },\n214\t            pipeline: PhysicsPipeline::new(),\n215\t            events: Vec::new(),\n216\t            replaying: false,\n217\t            config_arc: std::sync::Arc::new(SimConfig::default()),\n218\t        }\n219\t    }\n220\t\n221\t    /// A world populated by the named built-in scene.\n222\t    pub fn new(scene: &str, seed: u64) -> Result<Self> {\n223\t        let mut sim = Self::empty(seed);\n224\t        crate::scenes::build(&mut sim, scene)?;\n225\t        sim.state.scene = scene.to_string();\n226\t        sim.recording.scene = scene.to_string();\n227\t        Ok(sim)\n228\t    }\n229\t\n230\t    /// Rebuilds the same scene and seed, keeping the configuration.\n231\t    pub fn reset(&mut self) -> Result<()> {\n232\t        let mut fresh = Sim::new(&self.state.scene, self.state.seed)?;\n233\t        fresh.config = self.config.clone();\n234\t        *self = fresh;\n235\t        Ok(())\n236\t    }\n237\t\n238\t    pub fn dt(&self) -> f32 {\n239\t        1.0 / self.config.tick_rate.hz() as f32\n240\t    }\n241\t\n242\t    pub fn time(&self) -> f64 {\n243\t        self.state.tick as f64 * self.dt() as f64\n244\t    }\n245\t\n246\t    /// The state, carrying exactly the prop definitions its placed copies use.\n247\t    pub fn snapshot(&self) -> SimState {\n248\t        let mut state = self.state.clone();\n249\t        state.rebuild_prop_defs();\n250\t        state\n251\t    }\n252\t\n253\t    pub fn restore(&mut self, s: SimState) {\n254\t        self.state = s;\n255\t        self.state.rebuild_prop_defs();\n256\t        self.pipeline = PhysicsPipeline::new();\n257\t    }\n258\t\n259\t    pub fn spawn(&mut self, s: Spawn) -> EntityId {\n260\t        if let Some(prop) = &s.prop {\n261\t            self.state.prop_defs.insert(&prop.definition);\n262\t        }\n263\t        let id = self.state.entities.alloc_id();\n264\t        let soft = s.soft.as_ref().map(|d| {\n265\t            let part = self.state.physics.insert_soft(d, s.pos, s.rot);\n266\t            if let Some(sb) = part.handle.and_then(|h| self.state.physics.soft_bodies.get_mut(h)) {\n267\t                let tag = entity_tag(id.0);\n268\t                let root = sb.root_body();\n269\t                if let Some(b) = self.state.physics.bodies.get(root) {\n270\t                    for c in b.colliders().to_vec() {\n271\t                        if let Some(col) = self.state.physics.colliders.get_mut(c) {\n272\t                            col.user_data = tag;\n273\t                        }\n274\t                    }\n275\t                }\n276\t            }\n277\t            part\n278\t        });\n279\t        let body = match s.body {\n280\t            _ if soft.is_some() => None,\n281\t            BodyKind::None => None,\n282\t            kind => {\n283\t                let builder = match kind {\n284\t                    BodyKind::Fixed => RigidBodyBuilder::fixed(),\n285\t                    BodyKind::Kinematic => RigidBodyBuilder::kinematic_velocity_based(),\n286\t                    _ => RigidBodyBuilder::dynamic(),\n287\t                }\n288\t                .pose(Pose::from_parts(s.pos, s.rot))\n289\t                .linear_damping(s.damping as Real)\n290\t                .angular_damping(s.damping as Real);\n291\t                let shape = s.visual.as_ref().map(|v| v.shape).unwrap_or(Shape::Sphere { radius: 0.25 });\n292\t                let collider = match &s.prop {\n293\t                    Some(prop) => prop.collider(),\n294\t                    None => Some(shape.collider()),\n295\t                };\n296\t                collider.map(|collider| {\n297\t                    let collider = collider\n298\t                        .density(s.density as Real)\n299\t                        .friction(s.friction as Real)\n300\t                        .restitution(s.restitution as Real)\n301\t                        .user_data(entity_tag(id.0));\n302\t                    let (b, _) = self.state.physics.insert(builder, collider);\n303\t                    b\n304\t                })\n305\t            }\n306\t        };\n307\t        self.state.entities.map.insert(\n308\t            id,\n309\t            Entity {\n310\t                id,\n311\t                name: if s.name.is_empty() { format!(\"entity{}\", id.0) } else { s.name },\n312\t                pos: s.pos,\n313\t                rot: s.rot,\n314\t                body_kind: s.body,\n315\t                body,\n316\t                visual: s.visual,\n317\t                prop: s.prop,\n318\t                behavior: s.behavior,\n319\t                character: None,\n320\t                bomb: None,\n321\t                lifetime: None,\n322\t                region: s.region,\n323\t                material: crate::entity::Material {\n324\t                    density: s.density,\n325\t                    friction: s.friction,\n326\t                    restitution: s.restitution,\n327\t                    damping: s.damping,\n328\t                },\n329\t                hazard: s.hazard,\n330\t                soft,\n331\t                joints: Vec::new(),\n332\t                ai: None,\n333\t                vehicle: None,\n334\t                health: None,\n335\t            },\n336\t        );\n337\t        if self.state.entities.get(id).is_some_and(|e| e.prop.is_some()) {\n338\t            self.invalidate_prop_navigation();\n339\t        }\n340\t        if !self.replaying {\n341\t            self.events.push(SimEvent::Spawned { id, pos: s.pos });\n342\t        }\n343\t        id\n344\t    }\n345\t\n346\t    /// Creates a character (kinematic capsule + puppet) standing at `feet`.\n347\t    pub fn spawn_character(&mut self, name: &str, feet: Vec3) -> EntityId {\n348\t        let id = self.state.entities.alloc_id();\n349\t        let ch = Character::new();\n350\t        let center = feet + Vec3::Y * (ch.height() * 0.5 + character::PLACE_LIFT);\n351\t        let b = self.character_body(id, center, ch.posture);\n352\t        self.state.entities.map.insert(\n353\t            id,\n354\t            Entity {\n355\t                id,\n356\t                name: name.to_string(),\n357\t                pos: center,\n358\t                rot: Quat::IDENTITY,\n359\t                body_kind: BodyKind::Kinematic,\n360\t                body: Some(b),\n361\t                visual: None,\n362\t                prop: None,\n363\t                behavior: Behavior::None,\n364\t                character: Some(Box::new(ch)),\n365\t                bomb: None,\n366\t                lifetime: None,\n367\t                region: None,\n368\t                material: Default::default(),\n369\t                hazard: None,\n370\t                soft: None,\n371\t                joints: Vec::new(),\n372\t                ai: None,\n373\t                vehicle: None,\n374\t                health: None,\n375\t            },\n376\t        );\n377\t        id\n378\t    }\n379\t\n380\t    /// Creates a non-player character with its own look and (optionally) a brain.\n381\t    pub fn spawn_npc(\n382\t        &mut self,\n383\t        name: &str,\n384\t        feet: Vec3,\n385\t        facing: f32,\n386\t        def: PuppetDef,\n387\t        ai: Option<crate::ai::Ai>,\n388\t        region: Option<crate::statics::RegionKey>,\n389\t    ) -> EntityId {\n390\t        let id = self.spawn_character(name, feet);\n391\t        if let Some(e) = self.state.entities.get_mut(id) {\n392\t            e.region = region;\n393\t            e.ai = ai.map(Box::new);\n394\t            if let Some(ch) = &mut e.character {\n395\t                ch.facing = facing;\n396\t                ch.anim.facing = facing;\n397\t                ch.puppet = Some(std::sync::Arc::new(def));\n398\t            }\n399\t        }\n400\t        id\n401\t    }\n402\t\n403\t    /// A character's kinematic capsule (when it is created or wakes up).\n404\t    pub(crate) fn character_body(&mut self, id: EntityId, center: Vec3, posture: character::Posture) -> RigidBodyHandle {\n405\t        let body = RigidBodyBuilder::kinematic_position_based().translation(center);\n406\t        let collider =\n407\t            ColliderBuilder::capsule_y(posture.half_height() as Real, RADIUS as Real).friction(0.0).user_data(entity_tag(id.0));\n408\t        self.state.physics.insert(body, collider).0\n409\t    }\n410\t\n411\t    /// Spawns the player at the scene's spawn point and makes the camera follow it.\n412\t    pub fn spawn_player(&mut self) -> EntityId {\n413\t        let id = self.spawn_character(\"player\", self.state.spawn);\n414\t        self.state.player = Some(id);\n415\t        id\n416\t    }\n417\t\n418\t    /// Where an entity stands: a character's feet (its `pos` is the capsule's centre), else\n419\t    /// its position.\n420\t    pub fn feet(&self, id: EntityId) -> Option<Vec3> {\n421\t        let e = self.state.entities.get(id)?;\n422\t        Some(match &e.character {\n423\t            Some(c) => e.pos - Vec3::Y * c.height() * 0.5,\n424\t            None => e.pos,\n425\t        })\n426\t    }\n427\t\n428\t    pub fn player(&self) -> Option<&Entity> {\n429\t        self.state.player.and_then(|id| self.state.entities.get(id))\n430\t    }\n431\t\n432\t    pub fn despawn(&mut self, id: EntityId) -> bool {\n433\t        match self.state.entities.map.remove(&id) {\n434\t            Some(e) => {\n435\t                if e.prop.is_some() {\n436\t                    self.invalidate_prop_navigation();\n437\t                }\n438\t                if let Some(b) = e.body {\n439\t                    self.state.physics.remove_body(b);\n440\t                }\n441\t                if let Some(h) = e.soft.and_then(|s| s.handle) {\n442\t                    self.state.physics.remove_soft(h);\n443\t                }\n444\t                if self.state.player == Some(id) {\n445\t                    self.state.player = None;\n446\t                }\n447\t                true\n448\t            }\n449\t            None => false,\n450\t        }\n451\t    }\n452\t\n453\t    /// Moves an entity (teleport), resetting its velocity. For characters `pos` is the feet.\n454\t    pub fn set_position(&mut self, id: EntityId, pos: Vec3) -> bool {\n455\t        let Some(e) = self.state.entities.map.get_mut(&id) else { return false };\n456\t        let center = match &mut e.character {\n457\t            Some(ch) => {\n458\t                ch.vel = Vec3::ZERO;\n459\t                ch.impulse = Vec3::ZERO;\n460\t                ch.stun = 0.0;\n461\t                ch.roll = 0.0;\n462\t                ch.hang = None;\n463\t                ch.grid_target = None;\n464\t                ch.climbing = None;\n465\t                pos + Vec3::Y * (ch.height() * 0.5 + character::PLACE_LIFT)\n466\t            }\n467\t            None => pos,\n468\t        };\n469\t        e.pos = center;\n470\t        if self.state.player == Some(id) {\n471\t            self.state.focus = center;\n472\t        }\n473\t        if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n474\t            b.set_translation(center, true);\n475\t            if b.is_kinematic() {\n476\t                b.set_next_kinematic_translation(center);\n477\t            }\n478\t            b.set_linvel(Vector::ZERO, true);\n479\t            b.set_angvel(Vector::ZERO, true);\n480\t        }\n481\t        if e.prop.is_some() {\n482\t            self.invalidate_prop_navigation();\n483\t        }\n484\t        true\n485\t    }\n486\t\n487\t    /// Advances one fixed tick, recording the input for rewind and replays.\n488\t    pub fn step(&mut self, input: &InputFrame) {\n489\t        let dt = self.dt();\n490\t        match self.studio_mode() {\n491\t            crate::prop_preview::StudioMode::Animation => {\n492\t                if let Some(preview) = &mut self.state.animation_preview {\n493\t                    preview.advance(dt);\n494\t                }\n495\t                return;\n496\t            }\n497\t            crate::prop_preview::StudioMode::Prop => {\n498\t                if let Some(preview) = &mut self.state.prop_preview {\n499\t                    preview.advance(dt);\n500\t                }\n501\t                return;\n502\t            }\n503\t            crate::prop_preview::StudioMode::Creature => {\n504\t                if let Some(preview) = &mut self.state.creature_preview {\n505\t                    preview.advance(dt);\n506\t                }\n507\t                return;\n508\t            }\n509\t            crate::prop_preview::StudioMode::World => {}\n510\t        }\n511\t        if self.history.enabled && self.config.history_seconds > 0.0 {\n512\t            self.history.window = (self.config.history_seconds * self.config.tick_rate.hz() as f32) as u64;\n513\t            self.history.record(&self.state, input);\n514\t        }\n515\t        if self.recording.ticks() < MAX_RECORDING_TICKS {\n516\t            self.recording.push(input);\n517\t        }\n518\t        self.step_inner(input);\n519\t    }\n520\t\n521\t    fn step_inner(&mut self, input: &InputFrame) {\n522\t        // Hit-stop slows the whole world for a moment.\n523\t        let raw_dt = self.dt();\n524\t        let dt = raw_dt * self.game_time_scale();\n525\t        self.state.physics.params.dt = dt as Real;\n526\t        self.state.physics.gravity = Vector::new(0.0, -self.config.gravity as Real, 0.0);\n527\t\n528\t        // Behaviours set this tick's velocities of moving objects; characters then move\n529\t        // (rapier's controller carries them with kinematic platforms) and the physics step\n530\t        // advances everything together.\n531\t        self.run_behaviors(dt);\n532\t\n533\t        // Getting in and out of vehicles.\n534\t        self.vehicle_interact(input);\n535\t\n536\t        // The game decides what the hero and its monsters do this tick.\n537\t        let mut events = Vec::new();\n538\t        let mut game_inputs = self.game_pre(input, dt, &mut events);\n539\t        game_inputs.extend(self.play_pre(input, dt, &mut events));\n540\t\n541\t        // Characters.\n542\t        let ids: Vec<EntityId> = self.state.entities.iter().filter(|e| e.character.is_some()).map(|e| e.id).collect();\n543\t        let mut actions = Vec::new();\n544\t        let idle = InputFrame::default();\n545\t        let player_feet = self.player().and_then(|p| Some(p.pos - Vec3::Y * p.character.as_ref()?.height() * 0.5));\n546\t        let all_feet: Vec<Vec3> =\n547\t            self.state.entities.iter().filter_map(|e| Some(e.pos - Vec3::Y * e.character.as_ref()?.height() * 0.5)).collect();\n548\t        let mut fallen = Vec::new();\n549\t        for id in ids {\n550\t            let npc_input: InputFrame;\n551\t            let inp = if let Some(gi) = game_inputs.get(&id) {\n552\t                gi\n553\t            } else if Some(id) == self.state.player {\n554\t                input\n555\t            } else {\n556\t                // Non-player characters: their brain drives them like a player would.\n557\t                let st = &mut self.state;\n558\t                match st.entities.map.get_mut(&id) {\n559\t                    Some(e) if e.ai.is_some() => {\n560\t                        let feet = e.pos - Vec3::Y * e.character.as_ref().map(|c| c.height() * 0.5).unwrap_or(0.0);\n561\t                        let ai = e.ai.as_mut().unwrap();\n562\t                        if feet.y < crate::course::FALL_LIMIT {\n563\t                            fallen.push((id, ai.home));\n564\t                        }\n565\t                        npc_input = ai.think(feet, player_feet, &all_feet, &mut st.rng, dt);\n566\t                        if let (Some(f), Some(ch)) = (ai.rest_facing(), e.character.as_mut()) {\n567\t                            if ch.stun <= 0.0 {\n568\t                                ch.facing = f;\n569\t                            }\n570\t                        }\n571\t                        if let (Some(p), Some(ch)) = (ai.perform.as_mut(), e.character.as_mut()) {\n572\t                            p.tick(&mut ch.anim, dt, &self.config.anim);\n573\t                        }\n574\t                        &npc_input\n575\t                    }\n576\t                    _ => &idle,\n577\t                }\n578\t            };\n579\t            let own = self.state.entities.get(id).and_then(|e| e.character.as_ref()).and_then(|c| c.puppet.clone());\n580\t            character::tick(\n581\t                &mut self.state,\n582\t                id,\n583\t                inp,\n584\t                &self.config.movement,\n585\t                &self.config.bombs,\n586\t                own.as_deref().unwrap_or(&self.config.puppet),\n587\t                self.config.gravity,\n588\t                dt,\n589\t                &mut events,\n590\t                &mut actions,\n591\t            );\n592\t        }\n593\t        for (id, home) in fallen {\n594\t            self.set_position(id, home);\n595\t        }\n596\t        self.update_guards(dt, &mut events);\n597\t        for a in actions {\n598\t            match a {\n599\t                Action::ThrowBomb { from, vel, owner } => {\n600\t                    self.throw_bomb(from, vel, owner);\n601\t                    events.push(SimEvent::Throw { pos: from });\n602\t                }\n603\t                Action::Hit { id, at, dir, knockback, respawn } => {\n604\t                    self.hit_character(id, at, dir, knockback, respawn, &mut events)\n605\t                }\n606\t                Action::Shoot { from, vel, owner } => {\n607\t                    self.state.projectiles.spawn(crate::projectile::Projectile {\n608\t                        pos: from,\n609\t                        vel,\n610\t                        radius: 0.09,\n611\t                        life: self.config.bombs.shot_range / vel.length().max(0.1),\n612\t                        color: Color::hex(\"#9ef0ff\"),\n613\t                        knockback: 0.0,\n614\t                        gravity: 0.0,\n615\t                        owner: Some(owner),\n616\t                        team: crate::projectile::Team::Player,\n617\t                        damage: 1.0,\n618\t                    });\n619\t                    events.push(SimEvent::Shot { pos: from });\n620\t                }\n621\t            }\n622\t        }\n623\t        self.drive_vehicles(input, dt);\n624\t        self.zone_props(dt);\n625\t        let collector = EventCollector::default();\n626\t        self.state.physics.step(&mut self.pipeline, &collector);\n627\t        self.sync_from_physics();\n628\t        self.seat_riders();\n629\t        let contacts = collector.contacts.into_inner().unwrap_or_default();\n630\t        if !contacts.is_empty() {\n631\t            self.break_blocks(contacts, &mut events);\n632\t        }\n633\t        self.update_crumbles(dt, &mut events);\n634\t\n635\t        // Bombs and debris.\n636\t        let mut blasts = Vec::new();\n637\t        let mut expired = Vec::new();\n638\t        let settle_after = self.config.bombs.fuse - self.config.bombs.flight_time - 0.05;\n639\t        for e in self.state.entities.map.values_mut() {\n640\t            if let Some(b) = &mut e.bomb {\n641\t                b.fuse -= dt;\n642\t                if b.fuse <= 0.0 {\n643\t                    blasts.push((e.id, e.pos, b.radius));\n644\t                } else if b.fuse < settle_after {\n645\t                    // After the throw arc, bombs stop where they landed instead of rolling away.\n646\t                    if let Some(body) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n647\t                        let v = body.linvel();\n648\t                        body.set_linvel(Vec3::new(v.x * 0.8, v.y, v.z * 0.8), false);\n649\t                        body.set_angvel(body.angvel() * 0.8, false);\n650\t                    }\n651\t                }\n652\t            }\n653\t            if let Some(l) = &mut e.lifetime {\n654\t                *l = l.saturating_sub(1);\n655\t                if *l == 0 {\n656\t                    expired.push(e.id);\n657\t                }\n658\t            }\n659\t        }\n660\t        for (id, pos, radius) in blasts {\n661\t            self.despawn(id);\n662\t            self.explode(pos, radius, &mut events);\n663\t        }\n664\t        for id in expired {\n665\t            self.despawn(id);\n666\t        }\n667\t\n668\t        // Shootable things: sway, hit flash.\n669\t        self.update_health(dt);\n670\t\n671\t        // Projectiles.\n672\t        if !self.state.projectiles.list.is_empty() {\n673\t            let hitbox = self.config.movement.hitbox;\n674\t            let player = self.state.player;\n675\t            let targets: Vec<Target> = self\n676\t                .state\n677\t                .entities\n678\t                .iter()\n679\t                .filter_map(|e| {\n680\t                    let c = e.character.as_ref()?;\n681\t                    let radius = if Some(e.id) == player { hitbox } else { RADIUS };\n682\t                    Some(Target { id: e.id, feet: e.pos - Vec3::Y * c.height() * 0.5, height: c.height(), radius })\n683\t                })\n684\t                .collect();\n685\t            let enemies: Vec<crate::projectile::Enemy> = self\n686\t                .state\n687\t                .entities\n688\t                .iter()\n689\t                .filter(|e| e.health.is_some())\n690\t                .map(|e| crate::projectile::Enemy {\n691\t                    id: e.id,\n692\t                    center: e.pos,\n693\t                    radius: e.visual.as_ref().map(|v| v.shape.half_extents().max_element()).unwrap_or(0.5),\n694\t                })\n695\t                .collect();\n696\t            let physics = &self.state.physics;\n697\t            let entities = &self.state.entities;\n698\t            let out = self.state.projectiles.step(dt, &targets, &enemies, |from, dir, len, owner| {\n699\t                let ignore = owner.and_then(|id| entities.get(id)).and_then(|e| e.body);\n700\t                crate::projectile::static_blocked(physics, from, dir, len, ignore)"}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"bf40fd32-cca6-422d-bbed-91df44e5b96a","timestamp":"2026-11-05T05:39:49.539Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/sim.rs","content":"//! The simulation: fixed-tick, headless, snapshot-able, rewindable.\n\nuse std::path::Path;\n\nuse anyhow::{Context, Result};\nuse glam::{Quat, Vec3};\nuse rapier::prelude::*;\nuse serde::{Deserialize, Serialize};\n\nuse crate::character::{self, Action, BombParams, Character, MovementParams, RADIUS};\nuse crate::choice_enum;\nuse crate::color::Color;\nuse crate::course::Courses;\nuse crate::entity::{Behavior, BodyKind, Bomb, Entities, Entity, EntityId, Spawn};\nuse crate::feel::FeelMeter;\nuse crate::frame::{PuppetFrame, RenderFrame, RenderObject, SimEvent};\nuse crate::history::{History, Replay};\nuse crate::input::InputFrame;\nuse crate::params::{ChoiceParam, ParamVisitor, Tunable, nested};\nuse crate::physics::{EventCollector, PhysicsState, entity_tag};\nuse crate::projectile::{Projectiles, Target};\nuse crate::puppet::PuppetDef;\nuse crate::rng::Rng;\nuse crate::shape::{Look, Shape, Visual};\nuse crate::statics::{StaticWorld, block_flags};\nuse crate::terrain::TerrainParams;\nuse crate::world::World;\n\nchoice_enum! {\n    pub enum TickRate { Hz60 => \"60\", Hz120 => \"120\", Hz240 => \"240\" }\n}\n\nimpl TickRate {\n    pub fn hz(self) -> u32 {\n        match self {\n            TickRate::Hz60 => 60,\n            TickRate::Hz120 => 120,\n            TickRate::Hz240 => 240,\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub struct SimConfig {\n    pub tick_rate: TickRate,\n    /// World gravity for physics props (m/s², positive = down).\n    pub gravity: f32,\n    /// How far back rewind can go (seconds).\n    pub history_seconds: f32,\n    pub movement: MovementParams,\n    pub bombs: BombParams,\n    pub puppet: PuppetDef,\n    pub terrain: TerrainParams,\n    /// Shardfall difficulty multipliers.\n    pub difficulty: crate::arpg::Difficulty,\n    /// Performers: tempo and mirroring of their clips and moves.\n    pub anim: crate::clips::AnimParams,\n}\n\nimpl Default for SimConfig {\n    fn default() -> Self {\n        Self {\n            tick_rate: TickRate::Hz60,\n            gravity: 9.81,\n            history_seconds: 30.0,\n            movement: MovementParams::default(),\n            bombs: BombParams::default(),\n            puppet: PuppetDef::default(),\n            terrain: TerrainParams::default(),\n            difficulty: crate::arpg::Difficulty::default(),\n            anim: crate::clips::AnimParams::default(),\n        }\n    }\n}\n\n/// Only the simulation-level fields (groups are visited by `visit_groups`).\nimpl Tunable for SimConfig {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        self.tick_rate.visit_choice(v, \"tick_rate\", \"Simulation ticks per second\");\n        v.float(\"gravity\", &mut self.gravity, 0.0, 40.0, \"Gravity for physics props (m/s²)\");\n        v.float(\"history_seconds\", &mut self.history_seconds, 0.0, 300.0, \"Rewind window (s); 0 disables\");\n    }\n}\n\nimpl SimConfig {\n    /// Visits every simulation tunable as top-level groups: sim, movement, bombs, puppet, world,\n    /// difficulty, anim.\n    pub fn visit_groups(&mut self, v: &mut dyn ParamVisitor) {\n        nested(v, \"sim\", self);\n        nested(v, \"movement\", &mut self.movement);\n        nested(v, \"bombs\", &mut self.bombs);\n        nested(v, \"puppet\", &mut self.puppet);\n        nested(v, \"world\", &mut self.terrain);\n        nested(v, \"difficulty\", &mut self.difficulty);\n        nested(v, \"anim\", &mut self.anim);\n    }\n}\n\n/// Everything that changes during play. Cloning it is a snapshot.\n#[derive(Clone, Serialize, Deserialize)]\npub struct SimState {\n    /// The prop definitions placed copies use, each once. Declared first: a restore reads it\n    /// before the entities that name its keys.\n    #[serde(default, skip_serializing_if = \"crate::props::PropDefTable::is_empty\")]\n    pub prop_defs: crate::props::PropDefTable,\n    pub tick: u64,\n    pub seed: u64,\n    pub rng: Rng,\n    pub physics: PhysicsState,\n    pub entities: Entities,\n    pub statics: StaticWorld,\n    pub scene: String,\n    pub focus: Vec3,\n    pub player: Option<EntityId>,\n    pub spawn: Vec3,\n    pub world: World,\n    #[serde(default)]\n    pub courses: Courses,\n    #[serde(default)]\n    pub projectiles: Projectiles,\n    #[serde(default)]\n    pub feel: FeelMeter,\n    /// Signals sent by pads this tick (read by spawners next tick).\n    #[serde(default)]\n    pub signals: Vec<String>,\n    /// Tiles that are crumbling or waiting to regrow.\n    #[serde(default)]\n    pub crumbles: Vec<crate::destruct::Crumble>,\n    /// Shardfall, when this scene is part of the game.\n    #[serde(default)]\n    pub game: Option<Box<crate::arpg::Game>>,\n    /// A game from `crate::games` (the starter, or one an agent added), when this scene is one.\n    #[serde(default)]\n    pub play: Option<crate::games::GameBox>,\n    /// The animation stage freezes this world and publishes its own render frame.\n    #[serde(default)]\n    pub animation_preview: Option<crate::animation_preview::PreviewState>,\n    /// None is only for legacy snapshots whose active animation stage predates this field.\n    #[serde(default)]\n    pub studio_mode: Option<crate::prop_preview::StudioMode>,\n    #[serde(default)]\n    pub prop_preview: Option<crate::prop_preview::PropPreviewState>,\n    #[serde(default)]\n    pub creature_preview: Option<crate::creature_preview::CreaturePreviewState>,\n    #[serde(default)]\n    pub studio_cameras: crate::prop_preview::StudioCameras,\n}\n\nimpl SimState {\n    /// Rough memory footprint (for the history budget and stats).\n    pub fn approx_bytes(&self) -> usize {\n        self.physics.colliders.len() * 700\n            + self.physics.bodies.len() * 600\n            + self.entities.len() * 400\n            + self.projectiles.list.len() * 64\n            + 4096\n    }\n}\n\npub struct Sim {\n    pub config: SimConfig,\n    pub state: SimState,\n    /// Live feedback is a host transaction counter, independent of replay/snapshot time.\n    pub live_edit_ticket: u64,\n    pub history: History,\n    /// Inputs since the scene was built (for replays and crash reports).\n    pub recording: Replay,\n    pipeline: PhysicsPipeline,\n    pub(crate) events: Vec<SimEvent>,\n    /// True while re-simulating (rewind): no events, no recording.\n    replaying: bool,\n    /// Shared copy of `config` for frames (refreshed when it changes).\n    config_arc: std::sync::Arc<SimConfig>,\n}\n\nconst MAX_RECORDING_TICKS: u64 = 60 * 60 * 60;\n\nimpl Sim {\n    /// An empty world.\n    pub fn empty(seed: u64) -> Self {\n        let config = SimConfig::default();\n        let dt = 1.0 / config.tick_rate.hz() as f32;\n        Self {\n            state: SimState {\n                prop_defs: Default::default(),\n                tick: 0,\n                seed,\n                rng: Rng::new(seed),\n                physics: PhysicsState::new(dt),\n                entities: Entities::default(),\n                statics: StaticWorld::default(),\n                scene: String::new(),\n                focus: Vec3::ZERO,\n                player: None,\n                spawn: Vec3::ZERO,\n                world: World::default(),\n                courses: Courses::default(),\n                projectiles: Projectiles::default(),\n                feel: FeelMeter::default(),\n                signals: Vec::new(),\n                crumbles: Vec::new(),\n                game: None,\n                play: None,\n                animation_preview: None,\n                studio_mode: Some(crate::prop_preview::StudioMode::World),\n                prop_preview: None,\n                creature_preview: None,\n                studio_cameras: Default::default(),\n            },\n            live_edit_ticket: 0,\n            config,\n            history: History::default(),\n            recording: Replay { seed, ..Default::default() },\n            pipeline: PhysicsPipeline::new(),\n            events: Vec::new(),\n            replaying: false,\n            config_arc: std::sync::Arc::new(SimConfig::default()),\n        }\n    }\n\n    /// A world populated by the named built-in scene.\n    pub fn new(scene: &str, seed: u64) -> Result<Self> {\n        let mut sim = Self::empty(seed);\n        crate::scenes::build(&mut sim, scene)?;\n        sim.state.scene = scene.to_string();\n        sim.recording.scene = scene.to_string();\n        Ok(sim)\n    }\n\n    /// Rebuilds the same scene and seed, keeping the configuration.\n    pub fn reset(&mut self) -> Result<()> {\n        let mut fresh = Sim::new(&self.state.scene, self.state.seed)?;\n        fresh.config = self.config.clone();\n        *self = fresh;\n        Ok(())\n    }\n\n    pub fn dt(&self) -> f32 {\n        1.0 / self.config.tick_rate.hz() as f32\n    }\n\n    pub fn time(&self) -> f64 {\n        self.state.tick as f64 * self.dt() as f64\n    }\n\n    /// The state, carrying exactly the prop definitions its placed copies use.\n    pub fn snapshot(&self) -> SimState {\n        let mut state = self.state.clone();\n        state.rebuild_prop_defs();\n        state\n    }\n\n    pub fn restore(&mut self, s: SimState) {\n        self.state = s;\n        self.state.rebuild_prop_defs();\n        self.pipeline = PhysicsPipeline::new();\n    }\n\n    pub fn spawn(&mut self, s: Spawn) -> EntityId {\n        if let Some(prop) = &s.prop {\n            self.state.prop_defs.insert(&prop.definition);\n        }\n        let id = self.state.entities.alloc_id();\n        let soft = s.soft.as_ref().map(|d| {\n            let part = self.state.physics.insert_soft(d, s.pos, s.rot);\n            if let Some(sb) = part.handle.and_then(|h| self.state.physics.soft_bodies.get_mut(h)) {\n                let tag = entity_tag(id.0);\n                let root = sb.root_body();\n                if let Some(b) = self.state.physics.bodies.get(root) {\n                    for c in b.colliders().to_vec() {\n                        if let Some(col) = self.state.physics.colliders.get_mut(c) {\n                            col.user_data = tag;\n                        }\n                    }\n                }\n            }\n            part\n        });\n        let body = match s.body {\n            _ if soft.is_some() => None,\n            BodyKind::None => None,\n            kind => {\n                let builder = match kind {\n                    BodyKind::Fixed => RigidBodyBuilder::fixed(),\n                    BodyKind::Kinematic => RigidBodyBuilder::kinematic_velocity_based(),\n                    _ => RigidBodyBuilder::dynamic(),\n                }\n                .pose(Pose::from_parts(s.pos, s.rot))\n                .linear_damping(s.damping as Real)\n                .angular_damping(s.damping as Real);\n                let shape = s.visual.as_ref().map(|v| v.shape).unwrap_or(Shape::Sphere { radius: 0.25 });\n                let collider = match &s.prop {\n                    Some(prop) => prop.collider(),\n                    None => Some(shape.collider()),\n                };\n                collider.map(|collider| {\n                    let collider = collider\n                        .density(s.density as Real)\n                        .friction(s.friction as Real)\n                        .restitution(s.restitution as Real)\n                        .user_data(entity_tag(id.0));\n                    let (b, _) = self.state.physics.insert(builder, collider);\n                    b\n                })\n            }\n        };\n        self.state.entities.map.insert(\n            id,\n            Entity {\n                id,\n                name: if s.name.is_empty() { format!(\"entity{}\", id.0) } else { s.name },\n                pos: s.pos,\n                rot: s.rot,\n                body_kind: s.body,\n                body,\n                visual: s.visual,\n                prop: s.prop,\n                behavior: s.behavior,\n                character: None,\n                bomb: None,\n                lifetime: None,\n                region: s.region,\n                material: crate::entity::Material {\n                    density: s.density,\n                    friction: s.friction,\n                    restitution: s.restitution,\n                    damping: s.damping,\n                },\n                hazard: s.hazard,\n                soft,\n                joints: Vec::new(),\n                ai: None,\n                vehicle: None,\n                health: None,\n            },\n        );\n        if self.state.entities.get(id).is_some_and(|e| e.prop.is_some()) {\n            self.invalidate_prop_navigation();\n        }\n        if !self.replaying {\n            self.events.push(SimEvent::Spawned { id, pos: s.pos });\n        }\n        id\n    }\n\n    /// Creates a character (kinematic capsule + puppet) standing at `feet`.\n    pub fn spawn_character(&mut self, name: &str, feet: Vec3) -> EntityId {\n        let id = self.state.entities.alloc_id();\n        let ch = Character::new();\n        let center = feet + Vec3::Y * (ch.height() * 0.5 + character::PLACE_LIFT);\n        let b = self.character_body(id, center, ch.posture);\n        self.state.entities.map.insert(\n            id,\n            Entity {\n                id,\n                name: name.to_string(),\n                pos: center,\n                rot: Quat::IDENTITY,\n                body_kind: BodyKind::Kinematic,\n                body: Some(b),\n                visual: None,\n                prop: None,\n                behavior: Behavior::None,\n                character: Some(Box::new(ch)),\n                bomb: None,\n                lifetime: None,\n                region: None,\n                material: Default::default(),\n                hazard: None,\n                soft: None,\n                joints: Vec::new(),\n                ai: None,\n                vehicle: None,\n                health: None,\n            },\n        );\n        id\n    }\n\n    /// Creates a non-player character with its own look and (optionally) a brain.\n    pub fn spawn_npc(\n        &mut self,\n        name: &str,\n        feet: Vec3,\n        facing: f32,\n        def: PuppetDef,\n        ai: Option<crate::ai::Ai>,\n        region: Option<crate::statics::RegionKey>,\n    ) -> EntityId {\n        let id = self.spawn_character(name, feet);\n        if let Some(e) = self.state.entities.get_mut(id) {\n            e.region = region;\n            e.ai = ai.map(Box::new);\n            if let Some(ch) = &mut e.character {\n                ch.facing = facing;\n                ch.anim.facing = facing;\n                ch.puppet = Some(std::sync::Arc::new(def));\n            }\n        }\n        id\n    }\n\n    /// A character's kinematic capsule (when it is created or wakes up).\n    pub(crate) fn character_body(&mut self, id: EntityId, center: Vec3, posture: character::Posture) -> RigidBodyHandle {\n        let body = RigidBodyBuilder::kinematic_position_based().translation(center);\n        let collider =\n            ColliderBuilder::capsule_y(posture.half_height() as Real, RADIUS as Real).friction(0.0).user_data(entity_tag(id.0));\n        self.state.physics.insert(body, collider).0\n    }\n\n    /// Spawns the player at the scene's spawn point and makes the camera follow it.\n    pub fn spawn_player(&mut self) -> EntityId {\n        let id = self.spawn_character(\"player\", self.state.spawn);\n        self.state.player = Some(id);\n        id\n    }\n\n    /// Where an entity stands: a character's feet (its `pos` is the capsule's centre), else\n    /// its position.\n    pub fn feet(&self, id: EntityId) -> Option<Vec3> {\n        let e = self.state.entities.get(id)?;\n        Some(match &e.character {\n            Some(c) => e.pos - Vec3::Y * c.height() * 0.5,\n            None => e.pos,\n        })\n    }\n\n    pub fn player(&self) -> Option<&Entity> {\n        self.state.player.and_then(|id| self.state.entities.get(id))\n    }\n\n    pub fn despawn(&mut self, id: EntityId) -> bool {\n        match self.state.entities.map.remove(&id) {\n            Some(e) => {\n                if e.prop.is_some() {\n                    self.invalidate_prop_navigation();\n                }\n                if let Some(b) = e.body {\n                    self.state.physics.remove_body(b);\n                }\n                if let Some(h) = e.soft.and_then(|s| s.handle) {\n                    self.state.physics.remove_soft(h);\n                }\n                if self.state.player == Some(id) {\n                    self.state.player = None;\n                }\n                true\n            }\n            None => false,\n        }\n    }\n\n    /// Moves an entity (teleport), resetting its velocity. For characters `pos` is the feet.\n    pub fn set_position(&mut self, id: EntityId, pos: Vec3) -> bool {\n        let Some(e) = self.state.entities.map.get_mut(&id) else { return false };\n        let center = match &mut e.character {\n            Some(ch) => {\n                ch.vel = Vec3::ZERO;\n                ch.impulse = Vec3::ZERO;\n                ch.stun = 0.0;\n                ch.roll = 0.0;\n                ch.hang = None;\n                ch.grid_target = None;\n                ch.climbing = None;\n                pos + Vec3::Y * (ch.height() * 0.5 + character::PLACE_LIFT)\n            }\n            None => pos,\n        };\n        e.pos = center;\n        if self.state.player == Some(id) {\n            self.state.focus = center;\n        }\n        if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n            b.set_translation(center, true);\n            if b.is_kinematic() {\n                b.set_next_kinematic_translation(center);\n            }\n            b.set_linvel(Vector::ZERO, true);\n            b.set_angvel(Vector::ZERO, true);\n        }\n        if e.prop.is_some() {\n            self.invalidate_prop_navigation();\n        }\n        true\n    }\n\n    /// Advances one fixed tick, recording the input for rewind and replays.\n    pub fn step(&mut self, input: &InputFrame) {\n        let dt = self.dt();\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &mut self.state.animation_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &mut self.state.prop_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::Creature => {\n                if let Some(preview) = &mut self.state.creature_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::World => {}\n        }\n        if self.history.enabled && self.config.history_seconds > 0.0 {\n            self.history.window = (self.config.history_seconds * self.config.tick_rate.hz() as f32) as u64;\n            self.history.record(&self.state, input);\n        }\n        if self.recording.ticks() < MAX_RECORDING_TICKS {\n            self.recording.push(input);\n        }\n        self.step_inner(input);\n    }\n\n    fn step_inner(&mut self, input: &InputFrame) {\n        // Hit-stop slows the whole world for a moment.\n        let raw_dt = self.dt();\n        let dt = raw_dt * self.game_time_scale();\n        self.state.physics.params.dt = dt as Real;\n        self.state.physics.gravity = Vector::new(0.0, -self.config.gravity as Real, 0.0);\n\n        // Behaviours set this tick's velocities of moving objects; characters then move\n        // (rapier's controller carries them with kinematic platforms) and the physics step\n        // advances everything together.\n        self.run_behaviors(dt);\n\n        // Getting in and out of vehicles.\n        self.vehicle_interact(input);\n\n        // The game decides what the hero and its monsters do this tick.\n        let mut events = Vec::new();\n        let mut game_inputs = self.game_pre(input, dt, &mut events);\n        game_inputs.extend(self.play_pre(input, dt, &mut events));\n\n        // Characters.\n        let ids: Vec<EntityId> = self.state.entities.iter().filter(|e| e.character.is_some()).map(|e| e.id).collect();\n        let mut actions = Vec::new();\n        let idle = InputFrame::default();\n        let player_feet = self.player().and_then(|p| Some(p.pos - Vec3::Y * p.character.as_ref()?.height() * 0.5));\n        let all_feet: Vec<Vec3> =\n            self.state.entities.iter().filter_map(|e| Some(e.pos - Vec3::Y * e.character.as_ref()?.height() * 0.5)).collect();\n        let mut fallen = Vec::new();\n        for id in ids {\n            let npc_input: InputFrame;\n            let inp = if let Some(gi) = game_inputs.get(&id) {\n                gi\n            } else if Some(id) == self.state.player {\n                input\n            } else {\n                // Non-player characters: their brain drives them like a player would.\n                let st = &mut self.state;\n                match st.entities.map.get_mut(&id) {\n                    Some(e) if e.ai.is_some() => {\n                        let feet = e.pos - Vec3::Y * e.character.as_ref().map(|c| c.height() * 0.5).unwrap_or(0.0);\n                        let ai = e.ai.as_mut().unwrap();\n                        if feet.y < crate::course::FALL_LIMIT {\n                            fallen.push((id, ai.home));\n                        }\n                        npc_input = ai.think(feet, player_feet, &all_feet, &mut st.rng, dt);\n                        if let (Some(f), Some(ch)) = (ai.rest_facing(), e.character.as_mut()) {\n                            if ch.stun <= 0.0 {\n                                ch.facing = f;\n                            }\n                        }\n                        if let (Some(p), Some(ch)) = (ai.perform.as_mut(), e.character.as_mut()) {\n                            p.tick(&mut ch.anim, dt, &self.config.anim);\n                        }\n                        &npc_input\n                    }\n                    _ => &idle,\n                }\n            };\n            let own = self.state.entities.get(id).and_then(|e| e.character.as_ref()).and_then(|c| c.puppet.clone());\n            character::tick(\n                &mut self.state,\n                id,\n                inp,\n                &self.config.movement,\n                &self.config.bombs,\n                own.as_deref().unwrap_or(&self.config.puppet),\n                self.config.gravity,\n                dt,\n                &mut events,\n                &mut actions,\n            );\n        }\n        for (id, home) in fallen {\n            self.set_position(id, home);\n        }\n        self.update_guards(dt, &mut events);\n        for a in actions {\n            match a {\n                Action::ThrowBomb { from, vel, owner } => {\n                    self.throw_bomb(from, vel, owner);\n                    events.push(SimEvent::Throw { pos: from });\n                }\n                Action::Hit { id, at, dir, knockback, respawn } => {\n                    self.hit_character(id, at, dir, knockback, respawn, &mut events)\n                }\n                Action::Shoot { from, vel, owner } => {\n                    self.state.projectiles.spawn(crate::projectile::Projectile {\n                        pos: from,\n                        vel,\n                        radius: 0.09,\n                        life: self.config.bombs.shot_range / vel.length().max(0.1),\n                        color: Color::hex(\"#9ef0ff\"),\n                        knockback: 0.0,\n                        gravity: 0.0,\n                        owner: Some(owner),\n                        team: crate::projectile::Team::Player,\n                        damage: 1.0,\n                    });\n                    events.push(SimEvent::Shot { pos: from });\n                }\n            }\n        }\n        self.drive_vehicles(input, dt);\n        self.zone_props(dt);\n        let collector = EventCollector::default();\n        self.state.physics.step(&mut self.pipeline, &collector);\n        self.sync_from_physics();\n        self.seat_riders();\n        let contacts = collector.contacts.into_inner().unwrap_or_default();\n        if !contacts.is_empty() {\n            self.break_blocks(contacts, &mut events);\n        }\n        self.update_crumbles(dt, &mut events);\n\n        // Bombs and debris.\n        let mut blasts = Vec::new();\n        let mut expired = Vec::new();\n        let settle_after = self.config.bombs.fuse - self.config.bombs.flight_time - 0.05;\n        for e in self.state.entities.map.values_mut() {\n            if let Some(b) = &mut e.bomb {\n                b.fuse -= dt;\n                if b.fuse <= 0.0 {\n                    blasts.push((e.id, e.pos, b.radius));\n                } else if b.fuse < settle_after {\n                    // After the throw arc, bombs stop where they landed instead of rolling away.\n                    if let Some(body) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n                        let v = body.linvel();\n                        body.set_linvel(Vec3::new(v.x * 0.8, v.y, v.z * 0.8), false);\n                        body.set_angvel(body.angvel() * 0.8, false);\n                    }\n                }\n            }\n            if let Some(l) = &mut e.lifetime {\n                *l = l.saturating_sub(1);\n                if *l == 0 {\n                    expired.push(e.id);\n                }\n            }\n        }\n        for (id, pos, radius) in blasts {\n            self.despawn(id);\n            self.explode(pos, radius, &mut events);\n        }\n        for id in expired {\n            self.despawn(id);\n        }\n\n        // Shootable things: sway, hit flash.\n        self.update_health(dt);\n\n        // Projectiles.\n        if !self.state.projectiles.list.is_empty() {\n            let hitbox = self.config.movement.hitbox;\n            let player = self.state.player;\n            let targets: Vec<Target> = self\n                .state\n                .entities\n                .iter()\n                .filter_map(|e| {\n                    let c = e.character.as_ref()?;\n                    let radius = if Some(e.id) == player { hitbox } else { RADIUS };\n                    Some(Target { id: e.id, feet: e.pos - Vec3::Y * c.height() * 0.5, height: c.height(), radius })\n                })\n                .collect();\n            let enemies: Vec<crate::projectile::Enemy> = self\n                .state\n                .entities\n                .iter()\n                .filter(|e| e.health.is_some())\n                .map(|e| crate::projectile::Enemy {\n                    id: e.id,\n                    center: e.pos,\n                    radius: e.visual.as_ref().map(|v| v.shape.half_extents().max_element()).unwrap_or(0.5),\n                })\n                .collect();\n            let physics = &self.state.physics;\n            let entities = &self.state.entities;\n            let out = self.state.projectiles.step(dt, &targets, &enemies, |from, dir, len, owner| {\n                let ignore = owner.and_then(|id| entities.get(id)).and_then(|e| e.body);\n                crate::projectile::static_blocked(physics, from, dir, len, ignore)","numLines":700,"startLine":1,"totalLines":1188}},"tool_result_meta":[{"id":"toolu_01Rnx1nASs4euGTQT9sGJeEb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
