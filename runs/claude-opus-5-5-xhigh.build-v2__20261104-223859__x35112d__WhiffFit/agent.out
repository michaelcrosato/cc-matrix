{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGGiKqdWqVhTfe46pCs","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26015,"cache_read_input_tokens":339318,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26015},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"cf5d8f73-54f3-4e50-9830-7e681cb8f9c1","timestamp":"2026-11-05T05:55:07.644Z","request_id":"req_011CgjGGhz1d98auGheGLdQk","thinking_duration_ms":979,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGGiKqdWqVhTfe46pCs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UtP15gUgsbkgHLvkP8UnxR","name":"Bash","input":{"command":"cd engine/crates/pav_core/src/games/fit/events && cat > step.rs <<'EOF'\n//! Step Party: a rhythm game on an aerobic step box. Timing uses the music's clock.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n/// How a note went.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Judged {\n    #[default]\n    Pending,\n    Good,\n    Perfect,\n    Miss,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Note {\n    pub time: f32,\n    /// 0 left, 1 right, 2 both.\n    pub lane: u8,\n    pub l: bool,\n    pub r: bool,\n    pub judged: Judged,\n    pub worst: f32,\n}\n\n#[derive(Deserialize)]\nstruct Charts {\n    bpm: f32,\n    lead_in_beats: f32,\n    party: Vec<String>,\n    finale: Vec<String>,\n}\n\nfn charts() -> Charts {\n    toml::from_str(&crate::games::level_text(\"fit/charts\", include_str!(\"../charts.toml\")))\n        .unwrap_or_else(|e| panic!(\"charts.toml: {e}\"))\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct StepParty {\n    pub bars: Option<usize>,\n    pub bpm: f32,\n    pub notes: Vec<Note>,\n    pub next: usize,\n    pub sum: f32,\n    pub combo: u32,\n    pub song: f32,\n    pub end: f32,\n    pub beat: i32,\n    pub flash: f32,\n    pub flash_word: String,\n    pub foot: u8,\n    pub guests: Vec<EntityId>,\n    pub bounce: Option<EntityId>,\n    pub stunned: f32,\n    /// The finale: the balance matters too.\n    pub wobble: bool,\n    pub foot_l: f32,\n    pub foot_r: f32,\n}\n\nimpl StepParty {\n    pub fn new(bars: Option<usize>) -> Self {\n        Self { bars, wobble: bars.is_some(), ..Default::default() }\n    }\n\n    fn load(&mut self) {\n        let ch = charts();\n        self.bpm = ch.bpm;\n        let beat = 60.0 / ch.bpm;\n        let lines = if let Some(n) = self.bars { ch.finale.iter().take(n).cloned().collect() } else { ch.party };\n        for (b, line) in lines.iter().enumerate() {\n            for (i, c) in line.chars().enumerate() {\n                let lane = match c {\n                    'L' => 0,\n                    'R' => 1,\n                    'B' => 2,\n                    _ => continue,\n                };\n                let at = ch.lead_in_beats + b as f32 * 4.0 + i as f32 * 0.5;\n                self.notes.push(Note { time: at * beat, lane, ..Default::default() });\n            }\n        }\n        self.end = (ch.lead_in_beats + lines.len() as f32 * 4.0 + 2.0) * beat;\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        self.load();\n        if self.wobble {\n            return;\n        }\n        let at = cx.stage(Set::Boardwalk);\n        ready_player(cx, Set::Boardwalk, at + Vec3::Y * 0.3, 0.0);\n        cam(cx.sim, 18.0, 0.0, 9.5, 36.0);\n        self.bounce = npc(cx.sim, \"bounce\");\n        self.guests = cx.sim.state.entities.iter().filter(|e| e.name.starts_with(\"clapper\")).map(|e| e.id).collect();\n        c.say_key(Who::Bounce, \"bounce.step_start\", 0);\n    }\n\n    fn judge(&mut self, song: f32, left: bool, right: bool, r: &Rules, cx: &mut Cx, c: &mut RunCommon) {\n        let w = r.step.good_window;\n        for lane_press in [(left, 0u8), (right, 1u8)] {\n            if !lane_press.0 {\n                continue;\n            }\n            let lane = lane_press.1;\n            let best = self\n                .notes\n                .iter()\n                .enumerate()\n                .skip(self.next.saturating_sub(4))\n                .take_while(|(_, n)| n.time < song + w + 0.01)\n                .filter(|(_, n)| n.judged == Judged::Pending && (n.time - song).abs() <= w)\n                .filter(|(_, n)| match (n.lane, lane) {\n                    (2, 0) => !n.l,\n                    (2, 1) => !n.r,\n                    (a, b) => a == b,\n                })\n                .min_by(|a, b| (a.1.time - song).abs().total_cmp(&(b.1.time - song).abs()))\n                .map(|(i, _)| i);\n            let Some(i) = best else {\n                continue;\n            };\n            let n = &mut self.notes[i];\n            let off = (n.time - song).abs();\n            n.worst = n.worst.max(off);\n            if lane == 0 {\n                n.l = true;\n            } else {\n                n.r = true;\n            }\n            let done = n.lane != 2 || (n.l && n.r);\n            if done {\n                let perfect = n.worst <= r.step.perfect_window;\n                n.judged = if perfect { Judged::Perfect } else { Judged::Good };\n                let v = if perfect { 1.0 } else { r.step.good_value };\n                self.sum += v;\n                self.combo += 1;\n                self.flash = 0.45;\n                self.flash_word = if perfect { \"Perfect\".into() } else { \"Good\".into() };\n                cx.sfx(if perfect { sound::HIT_PERFECT } else { sound::HIT_GOOD }, 0.5, 1.0);\n                c.score = self.sum / self.notes.len().max(1) as f32 * 1000.0;\n            }\n        }\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let dt = cx.dt;\n        // The music's clock when it is believable (it isn't for a moment as a song starts).\n        let song = match it.song_pos {\n            Some(p) if (p - c.t).abs() < 1.5 => p,\n            _ => c.t,\n        };\n        self.song = song;\n        let amp = if self.wobble { cx.rules.stand.band_wobble } else { 0.5 };\n        c.step(cx, it.lean, amp, Vec2::ZERO, Vec2::ZERO);\n        self.stunned = (self.stunned - dt).max(0.0);\n        if self.wobble && c.core.tipped {\n            self.stunned = 1.2;\n            c.tip_fx(cx, true);\n        }\n        if self.stunned <= 0.0 {\n            let rules = cx.rules;\n            self.judge(song, it.l_just, it.r_just, rules, cx, c);\n        }\n        // Misses.\n        let w = cx.rules.step.good_window;\n        while let Some(n) = self.notes.get_mut(self.next) {\n            if n.judged != Judged::Pending {\n                self.next += 1;\n            } else if n.time + w < song {\n                n.judged = Judged::Miss;\n                self.combo = 0;\n                self.flash = 0.45;\n                self.flash_word = \"Miss\".into();\n                cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::MISS, gain: 0.3, pitch: 1.0 });\n                self.next += 1;\n            } else {\n                break;\n            }\n        }\n        self.flash = (self.flash - dt).max(0.0);\n        // The figure steps; the box bounces on the beat.\n        if it.l_just {\n            self.foot = 0;\n            self.foot_l = 1.0;\n        }\n        if it.r_just {\n            self.foot = 1;\n            self.foot_r = 1.0;\n        }\n        self.foot_l = (self.foot_l - dt * 3.0).max(0.0);\n        self.foot_r = (self.foot_r - dt * 3.0).max(0.0);\n        if it.l_just || it.r_just {\n            gesture(cx.sim, cx.pid, if self.foot == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" }, false);\n            cx.sfx(sound::STEP, 0.4, 1.0);\n        }\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        let beat = (song * self.bpm / 60.0).floor() as i32;\n        if beat != self.beat {\n            self.beat = beat;\n            if let Some(bo) = self.bounce {\n                if let Some(a) = anim_of(cx.sim, bo) {\n                    a.squash_vel = 3.0;\n                }\n            }\n            if beat % 4 == 0 {\n                for i in 0..self.guests.len() {\n                    gesture(cx.sim, self.guests[i], \"MESH2MOTION/Cheering_Two_Hands\", true);\n                }\n                if !self.guests.is_empty() {\n                    cx.sfx(sound::CLAP, 0.35, 1.0);\n                }\n            }\n        }\n        (song >= self.end).then_some(c.score)\n    }\n\n    pub fn stop(&mut self, _cx: &mut Cx) {}\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        if !self.wobble {\n            c.top_bar(ui, \"Step Party\", Some(self.end - self.song));\n        }\n        // Two lanes on either side of the figure, falling to two footprints.\n        let lanes = [640.0, 1280.0];\n        let (top, foot) = (170.0, 880.0);\n        let window = 1.6;\n        for (i, &x) in lanes.iter().enumerate() {\n            ui.panel(x - 74.0, top - 40.0, 148.0, foot - top + 120.0, with_alpha(WHITE, 0.5), 74.0);\n            let press = if i == 0 { self.foot_l } else { self.foot_r };\n            ui.circle(x, foot, 66.0 + press * 12.0, with_alpha(SEA, 0.5 + press * 0.5), TEAL, 8.0);\n            ui.label(x, foot - 26.0, 44.0, INK, Align::Center, if i == 0 { \"L\" } else { \"R\" });\n        }\n        for n in &self.notes {\n            let dt = n.time - self.song;\n            if n.judged != Judged::Pending || !(-0.2..=window).contains(&dt) {\n                continue;\n            }\n            let y = foot - (foot - top) * dt / window;\n            let color = if n.lane == 2 { SUN } else if n.lane == 0 { TEAL } else { CORAL };\n            if n.lane == 2 || n.lane == 0 {\n                ui.circle(lanes[0], y, 50.0, color, WHITE, 6.0);\n            }\n            if n.lane == 2 || n.lane == 1 {\n                ui.circle(lanes[1], y, 50.0, color, WHITE, 6.0);\n            }\n        }\n        if self.flash > 0.0 {\n            let col = match self.flash_word.as_str() {\n                \"Perfect\" => TEAL,\n                \"Good\" => MINT,\n                _ => CORAL,\n            };\n            ui.label(960.0, 180.0, 72.0, col, Align::Center, self.flash_word.clone());\n        }\n        if self.combo >= 5 {\n            ui.label(960.0, 270.0, 54.0, INK, Align::Center, format!(\"{} in a row\", self.combo));\n        }\n        if self.wobble {\n            let mut p = c.puck(false);\n            p.r = 120.0;\n            p.c = [960.0, 860.0];\n            ui.puck(p);\n        }\n        let _ = r;\n        ui.prompt_row_at(1040.0, &[(Act::StepL, \"Left\"), (Act::StepR, \"Right\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, _r: &Rules) -> Intent {\n        let mut it = Intent { lean: -c.core.cob * 0.6, ..Default::default() };\n        let dt = 1.0 / 60.0;\n        for n in self.notes.iter().skip(self.next) {\n            if n.time > c.t + dt * 1.5 {\n                break;\n            }\n            if n.judged == Judged::Pending && n.time >= c.t + dt * 0.5 - 0.001 {\n                it.l_just |= n.lane != 1;\n                it.r_just |= n.lane != 0;\n            }\n        }\n        it\n    }\n}\nEOF\ncat > spin.rs <<'EOF'\n//! Floatie Spin: circle the lean to keep inflatable rings up around your hips.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Ring {\n    pub id: Option<EntityId>,\n    /// Height above the feet.\n    pub h: f32,\n    pub angle: f32,\n    /// Flying in: seconds until it arrives, from which side (-1 left, 1 right).\n    pub flying: f32,\n    pub side: f32,\n    pub on: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct FloatieSpin {\n    pub rings: Vec<Ring>,\n    pub lost: u32,\n    pub omega: f32,\n    pub angle: f32,\n    pub last: Vec2,\n    pub dir: f32,\n    pub switch_in: f32,\n    pub toss_in: f32,\n    pub in_band: bool,\n    pub sum: f32,\n    pub clip_t: f32,\n    pub flash_switch: f32,\n    pub tossers: Vec<EntityId>,\n}\n\nimpl FloatieSpin {\n    pub fn new() -> Self {\n        Self { dir: 1.0, ..Default::default() }\n    }\n\n    fn add_ring(&mut self, cx: &mut Cx, side: f32, flying: f32, on: bool) {\n        let at = cx.feet() + Vec3::new(side * 6.0, 1.0, 0.0);\n        let colors = [\"#ff786e\", \"#ffd166\", \"#78dcaa\", \"#46bec8\", \"#c4b1e8\", \"#ffa8c0\", \"#fbfaf6\"];\n        let col = colors[self.rings.len() % colors.len()];\n        let id = spawn_prop_roles(cx.sim, \"LIB/core/floatie\", at, 0.0, 1.0, &[(\"$accent\", col)]);\n        let n = self.rings.len() as f32;\n        self.rings.push(Ring { id: Some(id), h: cx.rules.spin.ring_h + n * 0.07, angle: n * 1.1, flying, side, on });\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Boardwalk);\n        ready_player(cx, Set::Boardwalk, at + Vec3::Y * 0.3, 0.0);\n        cam(cx.sim, 16.0, 0.0, 8.5, 36.0);\n        self.switch_in = cx.rules.spin.switch_every;\n        self.toss_in = 3.0;\n        self.add_ring(cx, 0.0, 0.0, true);\n        self.tossers = cx.sim.state.entities.iter().filter(|e| e.name.starts_with(\"clapper\")).map(|e| e.id).collect();\n        c.say_key(Who::Bounce, \"bounce.spin_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.spin;\n        let dt = cx.dt;\n        c.step(cx, it.lean * 0.5, 0.4, Vec2::ZERO, Vec2::ZERO);\n        // Spin speed: the smoothed angular velocity of the lean.\n        let mut w = 0.0;\n        if it.lean.length() > r.min_lean && self.last.length() > r.min_lean {\n            let cross = self.last.perp_dot(it.lean);\n            let d = self.last.dot(it.lean);\n            w = cross.atan2(d) / dt;\n        }\n        self.last = it.lean;\n        self.omega += (w - self.omega) * (1.0 - (-r.smoothing * dt).exp());\n        self.angle += self.omega * dt;\n        let lo = r.band_lo / r.spin_band_scale;\n        let hi = r.band_hi * r.spin_band_scale;\n        let speed = self.omega * self.dir;\n        self.in_band = speed >= lo && speed <= hi;\n        // \"Switch!\" flips the direction.\n        self.switch_in -= dt;\n        if self.switch_in <= 0.0 {\n            self.switch_in = r.switch_every;\n            self.dir = -self.dir;\n            self.flash_switch = 1.2;\n            cx.sfx(sound::GONG, 0.5, 1.4);\n            c.say_key(Who::Bounce, \"bounce.spin_switch\", c.t as usize);\n        }\n        self.flash_switch = (self.flash_switch - dt).max(0.0);\n        // Guests toss new rings from either side.\n        let on = self.rings.iter().filter(|x| x.on).count();\n        self.toss_in -= dt;\n        if self.toss_in <= 0.0 && self.rings.len() < r.max_rings as usize + self.lost as usize {\n            self.toss_in = r.toss_every;\n            let side = if cx.sim.state.rng.f32() < 0.5 { -1.0 } else { 1.0 };\n            let fly = r.toss_flight;\n            self.add_ring(cx, side, fly, false);\n            cx.sfx(sound::WHOOSH, 0.5, 1.0);\n            if let Some(&t) = self.tossers.first() {\n                gesture(cx.sim, t, \"MESH2MOTION/Cheering_Two_Hands\", true);\n            }\n        }\n        let feet = cx.feet();\n        let (l, rr) = (it.l_just, it.r_just);\n        let mut catches = Vec::new();\n        for (i, ring) in self.rings.iter_mut().enumerate() {\n            if ring.on || ring.id.is_none() {\n                continue;\n            }\n            ring.flying -= dt;\n            let press = if ring.side < 0.0 { l } else { rr };\n            if press && ring.flying.abs() <= r.catch_window && on < r.max_rings as usize {\n                ring.on = true;\n                catches.push(i);\n            } else if ring.flying < -r.catch_window {\n                catches.push(usize::MAX - i);\n            }\n        }\n        for &i in &catches {\n            if i < 1000 {\n                cx.sfx(sound::CATCH, 0.7, 1.0 + i as f32 * 0.05);\n            } else {\n                let j = usize::MAX - i;\n                if let Some(id) = self.rings[j].id.take() {\n                    cx.sim.despawn(id);\n                }\n                self.lost += 1;\n                cx.sfx(sound::MISS, 0.4, 0.8);\n            }\n        }\n        // Out of band, rings sink; on the floor they are lost.\n        let mut dropped = Vec::new();\n        for (i, ring) in self.rings.iter_mut().enumerate() {\n            let Some(id) = ring.id else { continue };\n            if ring.flying > 0.0 && !ring.on {\n                let u = ring.flying / r.toss_flight;\n                let p = feet + Vec3::new(ring.side * 6.0 * u, 1.1 + 2.0 * (u * std::f32::consts::PI).sin(), 0.0);\n                pose(cx.sim, id, p, Quat::from_rotation_x(u * 6.0));\n                continue;\n            }\n            if !ring.on {\n                continue;\n            }\n            if self.in_band {\n                ring.h = (ring.h + dt * r.rise).min(r.ring_h + i as f32 * 0.07);\n            } else {\n                ring.h -= dt * r.sink;\n            }\n            ring.angle += self.omega * dt;\n            let w = ring.angle * 0.33 + i as f32;\n            let tilt = 0.18 + 0.08 * (i as f32).sin();\n            let off = Vec3::new(ring.angle.cos(), 0.0, ring.angle.sin()) * 0.1;\n            pose(cx.sim, id, feet + Vec3::Y * ring.h + off, Quat::from_rotation_y(w) * Quat::from_rotation_x(tilt));\n            if ring.h < 0.12 {\n                dropped.push(i);\n            }\n        }\n        for i in dropped {\n            if let Some(id) = self.rings[i].id.take() {\n                cx.sim.despawn(id);\n            }\n            self.rings[i].on = false;\n            self.lost += 1;\n            cx.sfx(sound::BUMP, 0.5, 1.4);\n        }\n        let on = self.rings.iter().filter(|x| x.on).count() as f32;\n        if self.in_band {\n            self.sum += on * dt;\n        }\n        c.score = clamp01(self.sum / r.par) * 1000.0;\n        // Scrub the hips round with the spin.\n        self.clip_t = self.angle.rem_euclid(std::f32::consts::TAU) / std::f32::consts::TAU;\n        let flip = if self.omega < 0.0 { 1.0 - self.clip_t } else { self.clip_t };\n        scrub(cx.sim, cx.pid, \"FIT/HipCircle\", flip);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        (c.t >= r.length).then_some(c.score)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for ring in self.rings.drain(..) {\n            if let Some(id) = ring.id {\n                cx.sim.despawn(id);\n            }\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Floatie Spin\", Some(r.spin.length - c.t));\n        let lean_dot = [self.last.x, self.last.y];\n        let mut p = c.puck(true);\n        p.dot = lean_dot;\n        p.good = self.in_band;\n        p.ring = Some([0.0, 0.0, 0.65]);\n        ui.puck(p);\n        // The speed gauge.\n        let (x, y, w, h) = (1500.0, 280.0, 90.0, 560.0);\n        ui.panel(x - 20.0, y - 20.0, w + 40.0, h + 40.0, with_alpha(WHITE, 0.9), 32.0);\n        let top = 14.0;\n        let lo = r.spin.band_lo / r.spin.spin_band_scale;\n        let hi = r.spin.band_hi * r.spin.spin_band_scale;\n        ui.panel(x, y + h * (1.0 - hi / top), w, h * (hi - lo) / top, MINT, 18.0);\n        let sp = (self.omega * self.dir).clamp(0.0, top);\n        ui.circle(x + w * 0.5, y + h * (1.0 - sp / top), 34.0, if self.in_band { TEAL } else { CORAL }, WHITE, 5.0);\n        let dirs = if self.dir > 0.0 { \"Clockwise-ish\" } else { \"The other way\" };\n        let col = if self.flash_switch > 0.0 { CORAL } else { INK };\n        ui.panel(120.0, 240.0, 520.0, 76.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.label(380.0, 252.0, 46.0, col, Align::Center, if self.flash_switch > 0.0 { \"Switch!\" } else { dirs });\n        let on = self.rings.iter().filter(|x| x.on).count();\n        ui.panel(120.0, 340.0, 520.0, 76.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.label(380.0, 352.0, 46.0, INK, Align::Center, format!(\"{on} of {} rings\", r.spin.max_rings));\n        // Incoming rings.\n        for ring in &self.rings {\n            if !ring.on && ring.id.is_some() && ring.flying < 1.2 {\n                let x = if ring.side < 0.0 { 330.0 } else { 1590.0 };\n                let act = if ring.side < 0.0 { Act::StepL } else { Act::StepR };\n                ui.circle(x, 600.0, 70.0 + 50.0 * clamp01(ring.flying), with_alpha(SUN, 0.5), SUN, 8.0);\n                ui.prompt(x - 26.0, 600.0, act, \"\", Align::Left);\n            }\n        }\n        ui.prompt_row(&[(Act::Lean, \"Circle\"), (Act::StepL, \"Catch left\"), (Act::StepR, \"Catch right\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let phase = 7.5 * c.t * self.dir;\n        let mut it = Intent { lean: Vec2::new(phase.cos(), phase.sin()) * 0.85, ..Default::default() };\n        for ring in &self.rings {\n            if !ring.on && ring.id.is_some() && ring.flying.abs() < r.spin.catch_window * 0.5 {\n                if ring.side < 0.0 {\n                    it.l_just = true;\n                } else {\n                    it.r_just = true;\n                }\n            }\n        }\n        it\n    }\n}\nEOF\ncat > lap.rs <<'EOF'\n//! Morning Lap: one lap of the island. Alternate steps to set your pace, dodge, grab ribbons.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n/// A thing on the path.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Thing {\n    pub id: Option<EntityId>,\n    pub s: f32,\n    pub side: f32,\n    /// 0 ribbon, 1 crab, 2 sunbather, 3 towel.\n    pub kind: u8,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct MorningLap {\n    pub s: f32,\n    pub side: f32,\n    pub pace: f32,\n    pub last_step: f32,\n    pub foot: u8,\n    pub stitch: f32,\n    pub stumble: f32,\n    pub zone_time: f32,\n    pub ribbons: u32,\n    pub bumps: u32,\n    pub things: Vec<Thing>,\n    pub bounce: Option<EntityId>,\n    pub pacer_s: f32,\n    pub length: f32,\n    pub yaw: f32,\n    pub in_zone: bool,\n    pub flips: Vec<EntityId>,\n    pub center: Vec3,\n    pub next_step_at: f32,\n    pub finished: bool,\n}\n\n/// The ring path: a rounded loop around reception (a superellipse sampled by arc length).\npub fn path_point(center: Vec3, r: &Rules, a: f32) -> Vec3 {\n    let (s, c) = a.sin_cos();\n    let p = 2.0 / r.lap.path_power;\n    center + Vec3::new(c.signum() * c.abs().powf(p) * r.lap.path_rx, 0.0, s.signum() * s.abs().powf(p) * r.lap.path_rz)\n}\n\nimpl MorningLap {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Angle along the path for a distance `s`: the loop, walked by small steps.\n    fn at(&self, r: &Rules, s: f32) -> (Vec3, Vec3) {\n        let table = 720;\n        let mut prev = path_point(self.center, r, 0.0);\n        let mut d = 0.0;\n        for i in 1..=table {\n            let a = -i as f32 / table as f32 * std::f32::consts::TAU;\n            let q = path_point(self.center, r, a);\n            let seg = (q - prev).length();\n            if d + seg >= s {\n                let u = (s - d) / seg.max(1e-3);\n                return (prev.lerp(q, u), (q - prev).normalize_or(Vec3::Z));\n            }\n            d += seg;\n            prev = q;\n        }\n        (prev, Vec3::X)\n    }\n\n    fn total_length(&self, r: &Rules) -> f32 {\n        let table = 720;\n        let mut prev = path_point(self.center, r, 0.0);\n        let mut d = 0.0;\n        for i in 1..=table {\n            let a = -i as f32 / table as f32 * std::f32::consts::TAU;\n            let q = path_point(self.center, r, a);\n            d += (q - prev).length();\n            prev = q;\n        }\n        d\n    }\n\n    fn spot(&self, r: &Rules, s: f32, side: f32) -> Vec3 {\n        let (p, d) = self.at(r, s);\n        let right = Vec3::new(-d.z, 0.0, d.x);\n        p + right * side\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let rules = cx.rules;\n        self.center = cx.stage(Set::Hub);\n        self.length = self.total_length(rules);\n        let (p0, d0) = self.at(rules, 0.0);\n        ready_player(cx, Set::Hub, p0, d0.x.atan2(d0.z));\n        self.yaw = d0.x.atan2(-d0.z).to_degrees();\n        cam_full(cx.sim, 20.0, self.yaw, 9.0, 40.0, 1.0, 0.06, None);\n        self.bounce = npc(cx.sim, \"bounce_hub\");\n        self.pacer_s = 5.0;\n        // Ribbons and hazards, the same on a seed.\n        let mut s = 14.0;\n        let count = rules.lap.things as usize;\n        let step = (self.length - 24.0) / count as f32;\n        let mut n = 0;\n        while n < count {\n            let rng = &mut cx.sim.state.rng;\n            let kind = match n % 4 {\n                0 | 2 => 0u8,\n                1 => 1 + rng.below(3) as u8,\n                _ => 1 + rng.below(2) as u8,\n            };\n            let side = rng.range(-1.0, 1.0);\n            s += step;\n            let pos = self.spot(rules, s, side);\n            let (asset, scale): (&str, f32) = match kind {\n                0 => (\"LIB/core/ribbon\", 1.0),\n                1 => (\"LIB/core/crab\", 1.0),\n                2 => (\"LIB/core/lounge_chair\", 0.8),\n                _ => (\"LIB/core/towel_stack\", 1.0),\n            };\n            let id = spawn_prop(cx.sim, asset, pos, side * 3.0, scale);\n            self.things.push(Thing { id: Some(id), s, side, kind });\n            n += 1;\n        }\n        c.say_key(Who::Bounce, \"bounce.lap_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.lap;\n        let dt = cx.dt;\n        self.stumble = (self.stumble - dt).max(0.0);\n        c.step(cx, it.lean, 0.6, Vec2::ZERO, Vec2::ZERO);\n        if self.stumble <= 0.0 {\n            let foot = if it.l_just && it.r_just {\n                None\n            } else if it.l_just {\n                Some(0u8)\n            } else if it.r_just {\n                Some(1u8)\n            } else {\n                None\n            };\n            if let Some(f) = foot {\n                // The same foot twice counts for little.\n                let gap = (c.t - self.last_step).max(0.05);\n                self.last_step = c.t;\n                let now = 1.0 / gap;\n                let k = if f == self.foot { 0.1 } else { 0.45 };\n                self.pace += (now.min(6.0) - self.pace) * k;\n                self.foot = f;\n                cx.sfx(sound::STEP, 0.35, if f == 0 { 0.95 } else { 1.05 });\n            }\n        }\n        if c.t - self.last_step > r.step_timeout {\n            self.pace = (self.pace - dt * r.pace_decay).max(0.0);\n        }\n        self.in_zone = self.pace >= r.zone_lo && self.pace <= r.zone_hi;\n        if self.pace > r.zone_hi {\n            self.stitch += dt * r.stitch_rise;\n        } else {\n            self.stitch = (self.stitch - dt * r.stitch_fall).max(0.0);\n        }\n        if self.stitch >= 1.0 {\n            self.stitch = 0.3;\n            self.stumble = r.stumble;\n            self.pace *= 0.4;\n            cx.sfx(sound::STITCH, 0.8, 1.0);\n            gesture(cx.sim, cx.pid, \"FIT/Stumble\", false);\n            c.say_key(Who::Bounce, \"bounce.lap_stitch\", c.t as usize);\n        }\n        if self.in_zone {\n            self.zone_time += dt;\n        }\n        let speed = if self.stumble > 0.0 { 0.0 } else { self.pace * r.stride };\n        self.s += speed * dt;\n        // The path steers; lean moves you sideways a little.\n        let lean = c.core.cob.x;\n        self.side += (lean * r.side_reach - self.side) * (1.0 - (-r.side_rate * dt).exp());\n        let (p, d) = self.at(rules, self.s.min(self.length - 0.01));\n        let right = Vec3::new(-d.z, 0.0, d.x);\n        let feet = p + right * self.side;\n        place(cx.sim, cx.pid, feet, d.x.atan2(d.z));\n        let want = d.x.atan2(-d.z).to_degrees();\n        let mut dy = (want - self.yaw + 540.0).rem_euclid(360.0) - 180.0;\n        dy = dy.clamp(-90.0 * dt, 90.0 * dt) * 1.0 + dy * 0.02;\n        self.yaw = (self.yaw + dy + 540.0).rem_euclid(360.0) - 180.0;\n        // Jog scaled to speed.\n        let jog = (speed / 3.2).clamp(0.0, 1.6);\n        if speed > 0.05 && self.stumble <= 0.0 {\n            play_flags(cx.sim, cx.pid, \"MESH2MOTION/Jog\", 0, jog.max(0.2));\n        } else if self.stumble <= 0.0 {\n            stop_clip(cx.sim, cx.pid);\n        }\n        lean_figure(cx.sim, cx.pid, c.core.cob, self.yaw, 8.0, cx.slump);\n        // The pacer rolls ahead.\n        self.pacer_s += r.pacer_speed * dt;\n        if self.s + r.pacer_lead < self.pacer_s {\n            self.pacer_s = self.pacer_s.min(self.s + r.pacer_max_gap);\n        }\n        if let Some(bo) = self.bounce {\n            let (bp, bd) = self.at(rules, self.pacer_s.min(self.length - 0.01));\n            if let Some(e) = cx.sim.state.entities.get(bo) {\n                let _ = e;\n            }\n            place(cx.sim, bo, bp, bd.x.atan2(bd.z));\n        }\n        // Things on the path.\n        let at = self.s;\n        let side = self.side;\n        let mut got = Vec::new();\n        for (i, th) in self.things.iter().enumerate() {\n            if th.id.is_some() && (th.s - at).abs() < 0.7 && (th.side - side).abs() < if th.kind == 0 { 0.9 } else { 0.55 } {\n                got.push(i);\n            }\n        }\n        for i in got {\n            let kind = self.things[i].kind;\n            if let Some(id) = self.things[i].id.take() {\n                cx.sim.despawn(id);\n            }\n            if kind == 0 {\n                self.ribbons += 1;\n                cx.sfx(sound::RIBBON, 0.7, 1.0 + self.ribbons as f32 * 0.04);\n            } else {\n                self.bumps += 1;\n                self.pace *= 0.6;\n                c.stun = 0.5;\n                gesture(cx.sim, cx.pid, \"FIT/Stumble\", true);\n                cx.sfx(sound::BUMP, 0.7, 1.0);\n                c.say_key(Who::Bounce, \"bounce.lap_bump\", self.bumps as usize);\n            }\n        }\n        let n_ribbons = self.things.iter().filter(|t| t.kind == 0).count().max(1) as f32;\n        let par_time = self.length / (2.0 * r.stride);\n        let zone = clamp01(self.zone_time / par_time);\n        let rib = clamp01(self.ribbons as f32 / n_ribbons);\n        let bump = self.bumps as f32 * r.bump_cost;\n        c.score = clamp01(r.zone_weight * zone + (1.0 - r.zone_weight) * rib - bump) * 1000.0;\n        if self.s >= self.length - 0.5 && !self.finished {\n            self.finished = true;\n            cx.sfx(sound::FANFARE, 0.7, 1.0);\n            return Some(c.score);\n        }\n        (c.t >= r.max_time).then_some(c.score)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for th in self.things.drain(..) {\n            if let Some(id) = th.id {\n                cx.sim.despawn(id);\n            }\n        }\n        if let Some(bo) = self.bounce {\n            let at = cx.stage(Set::Hub) + Vec3::new(10.5, 0.0, 6.5);\n            place(cx.sim, bo, at, 0.0);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Morning Lap\", None);\n        // Progress along the lap.\n        ui.bar(560.0, 60.0, 800.0, 28.0, clamp01(self.s / self.length.max(1.0)), TEAL);\n        // Pace: the zone, and you.\n        let (x, y, w, h) = (160.0, 300.0, 90.0, 500.0);\n        ui.panel(x - 20.0, y - 20.0, w + 40.0, h + 40.0, with_alpha(WHITE, 0.9), 32.0);\n        let top = 4.0;\n        ui.panel(x, y + h * (1.0 - r.lap.zone_hi / top), w, h * (r.lap.zone_hi - r.lap.zone_lo) / top, MINT, 18.0);\n        ui.circle(x + w * 0.5, y + h * (1.0 - (self.pace / top).min(1.0)), 34.0, if self.in_zone { TEAL } else { CORAL }, WHITE, 5.0);\n        ui.text(x + w * 0.5, y + h + 30.0, 34.0, INK, Align::Center, \"Pace\");\n        ui.panel(1660.0, 300.0, 200.0, 170.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.text(1760.0, 312.0, 34.0, INK_SOFT, Align::Center, \"Ribbons\");\n        ui.label(1760.0, 360.0, 72.0, INK, Align::Center, format!(\"{}\", self.ribbons));\n        if self.stitch > 0.05 {\n            ui.panel(1660.0, 500.0, 200.0, 120.0, with_alpha(WHITE, 0.9), 30.0);\n            ui.text(1760.0, 510.0, 34.0, CORAL, Align::Center, \"Stitch\");\n            ui.bar(1680.0, 566.0, 160.0, 26.0, self.stitch, CORAL);\n        }\n        if c.t < 4.0 && self.pace < 0.5 {\n            ui.label(960.0, 430.0, 64.0, CORAL, Align::Center, \"Left, right, left, right\");\n        }\n        let mut p = c.puck(false);\n        p.r = 110.0;\n        p.c = [1700.0, 830.0];\n        p.band = Some(0.8);\n        ui.puck(p);\n        ui.prompt_row(&[(Act::StepL, \"Left\"), (Act::StepR, \"Right\"), (Act::Lean, \"Dodge\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        // Two steps a second, steering to ribbons and round everything else.\n        let mut it = Intent::default();\n        let period = 0.5;\n        let beat = (c.t / period).floor();\n        let prev = ((c.t - 1.0 / 60.0) / period).floor();\n        if beat != prev {\n            if self.foot == 0 {\n                it.r_just = true;\n            } else {\n                it.l_just = true;\n            }\n        }\n        let next = self.things.iter().find(|t| t.id.is_some() && t.s > self.s - 0.5 && t.s < self.s + 7.0);\n        let target = match next {\n            Some(t) if t.kind == 0 => t.side,\n            Some(t) => {\n                if t.side > 0.0 {\n                    t.side - 1.0\n                } else {\n                    t.side + 1.0\n                }\n            }\n            None => 0.0,\n        };\n        let lean_x = (target / r.lap.side_reach / r.core.reach).clamp(-1.0, 1.0);\n        it.lean = Vec2::new(lean_x, 0.0);\n        it\n    }\n}\nEOF\ncat > tide.rs <<'EOF'\n//! Tide Table: your lean tilts a floating raft; roll hermit crabs into tide pools.\n//! The shell physics is simple 2D code, not rapier: tunable and friendly to the bot.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Shell {\n    pub p: Vec2,\n    pub v: Vec2,\n    pub id: Option<EntityId>,\n    pub potted: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Pool {\n    pub p: Vec2,\n    pub r: f32,\n    pub id: Option<EntityId>,\n    /// Moving pools drift on this axis.\n    pub moves: Vec2,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct TideTable {\n    pub board: usize,\n    pub shells: Vec<Shell>,\n    pub pools: Vec<Pool>,\n    pub bumpers: Vec<(Vec2, EntityId)>,\n    pub potted: u32,\n    pub total: u32,\n    pub t_left: f32,\n    pub raft: Option<EntityId>,\n    pub center: Vec3,\n    pub edge: f32,\n    pub roll: f32,\n    pub skip_flash: f32,\n    pub done: bool,\n    pub gull: Option<EntityId>,\n    pub end_wait: f32,\n}\n\nfn to_world(center: Vec3, rot: Quat, p: Vec2, h: f32) -> Vec3 {\n    center + rot * Vec3::new(p.x, h, -p.y)\n}\n\nimpl TideTable {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    fn clear_board(&mut self, cx: &mut Cx) {\n        for s in self.shells.drain(..) {\n            if let Some(id) = s.id {\n                cx.sim.despawn(id);\n            }\n        }\n        for p in self.pools.drain(..) {\n            if let Some(id) = p.id {\n                cx.sim.despawn(id);\n            }\n        }\n        for (_, id) in self.bumpers.drain(..) {\n            cx.sim.despawn(id);\n        }\n    }\n\n    fn deal(&mut self, cx: &mut Cx) {\n        self.clear_board(cx);\n        let r = &cx.rules.tide;\n        let b = self.board;\n        let n = [3usize, 5, 7][b.min(2)];\n        self.edge = r.half;\n        let h = r.half;\n        let pools: &[(f32, f32)] = match b {\n            0 => &[(-0.55, 0.55), (0.6, -0.5)],\n            1 => &[(0.6, 0.55), (-0.6, -0.55)],\n            _ => &[(-0.65, 0.6), (0.65, 0.6), (0.0, -0.65)],\n        };\n        for (i, (x, y)) in pools.iter().enumerate() {\n            let p = Vec2::new(*x, *y) * h;\n            let id = spawn_prop(cx.sim, \"LIB/core/tide_pool\", self.center, 0.0, r.pool_r / 0.6);\n            let moves = if b == 1 && i == 0 { Vec2::new(0.0, -0.55 * h) } else { Vec2::ZERO };\n            self.pools.push(Pool { p, r: r.pool_r, id: Some(id), moves });\n        }\n        if b >= 2 {\n            for (x, y) in [(0.0, 0.3), (-0.45, -0.1), (0.45, -0.1)] {\n                let p = Vec2::new(x, y) * h;\n                let id = spawn_prop(cx.sim, \"LIB/core/bumper\", self.center, 0.0, 1.0);\n                self.bumpers.push((p, id));\n            }\n        }\n        for _ in 0..n {\n            let rng = &mut cx.sim.state.rng;\n            let mut p = Vec2::new(rng.range(-0.8, 0.8), rng.range(-0.8, 0.8)) * h;\n            if p.length() < 1.0 {\n                p = p.normalize_or(Vec2::X) * 1.4;\n            }\n            let colors = [\"#ffb88a\", \"#ffd166\", \"#ff9db0\", \"#c4b1e8\", \"#a8e0d0\"];\n            let col = colors[rng.below(5) as usize];\n            let id = spawn_prop_roles(cx.sim, \"LIB/core/shell\", self.center, 0.0, 1.0, &[(\"$accent\", col)]);\n            self.shells.push(Shell { p, v: Vec2::ZERO, id: Some(id), potted: false });\n        }\n        self.total += n as u32;\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        self.center = cx.stage(Set::Tide) + Vec3::Y * 0.2;\n        let at = self.center;\n        ready_player(cx, Set::Tide, at + Vec3::Y * 0.12, 0.0);\n        cam_full(cx.sim, 62.0, 0.0, 15.0, 40.0, 0.3, 0.2, None);\n        self.t_left = cx.rules.tide.length;\n        self.raft = Some(spawn_prop(cx.sim, \"LIB/core/tide_raft\", at, 0.0, cx.rules.tide.half / 4.0));\n        self.total = 0;\n        self.deal(cx);\n        self.gull = npc(cx.sim, \"gull_tide\");\n        c.say_key(Who::Gull, \"gull.tide_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.tide;\n        let dt = cx.dt;\n        self.t_left -= dt;\n        self.skip_flash = (self.skip_flash - dt).max(0.0);\n        c.step(cx, it.lean, r.wobble, Vec2::ZERO, Vec2::ZERO);\n        if c.core.tipped {\n            c.tip_fx(cx, true);\n            c.core.settle();\n        }\n        let tilt = c.core.cob;\n        let rot = Quat::from_rotation_z(-tilt.x * r.tilt_deg.to_radians()) * Quat::from_rotation_x(-tilt.y * r.tilt_deg.to_radians());\n        if let Some(id) = self.raft {\n            pose(cx.sim, id, self.center, rot);\n        }\n        if self.board >= 2 {\n            self.edge = (self.edge - dt * r.tide_rise).max(r.half * 0.55);\n        }\n        let edge = self.edge;\n        let tt = c.t;\n        for pool in &mut self.pools {\n            let p = pool.p + pool.moves * (tt * 0.9).sin();\n            if let Some(id) = pool.id {\n                pose(cx.sim, id, to_world(self.center, rot, p, 0.2), rot);\n            }\n        }\n        let pools: Vec<(Vec2, f32)> = self.pools.iter().map(|p| (p.p + p.moves * (tt * 0.9).sin(), p.r)).collect();\n        let bumpers: Vec<Vec2> = self.bumpers.iter().map(|b| b.0).collect();\n        for (p, id) in &self.bumpers {\n            pose(cx.sim, *id, to_world(self.center, rot, *p, 0.2), rot);\n        }\n        let mut roll_speed = 0.0f32;\n        let mut plops = Vec::new();\n        for (i, s) in self.shells.iter_mut().enumerate() {\n            if s.potted {\n                continue;\n            }\n            let a = tilt * r.gravity - s.v * r.friction;\n            s.v += a * dt;\n            s.p += s.v * dt;\n            // Walls.\n            if s.p.x.abs() > edge {\n                s.p.x = s.p.x.clamp(-edge, edge);\n                s.v.x *= -r.wall_bounce;\n            }\n            if s.p.y.abs() > edge {\n                s.p.y = s.p.y.clamp(-edge, edge);\n                s.v.y *= -r.wall_bounce;\n            }\n            for b in &bumpers {\n                let d = s.p - *b;\n                if d.length() < r.bumper_r {\n                    let n = d.normalize_or(Vec2::Y);\n                    s.p = *b + n * r.bumper_r;\n                    s.v = (s.v - n * s.v.dot(n) * 1.8) * 1.05;\n                }\n            }\n            roll_speed = roll_speed.max(s.v.length());\n            for (pp, pr) in &pools {\n                if (s.p - *pp).length() < *pr {\n                    if s.v.length() < r.skip_speed {\n                        s.potted = true;\n                        plops.push(i);\n                    } else {\n                        self.skip_flash = 0.5;\n                    }\n                }\n            }\n            if let Some(id) = s.id {\n                let spin = Quat::from_rotation_y(s.v.x.atan2(s.v.y));\n                pose(cx.sim, id, to_world(self.center, rot, s.p, 0.3), rot * spin);\n            }\n        }\n        for i in plops {\n            if let Some(id) = self.shells[i].id.take() {\n                let at = pos_of(cx.sim, id);\n                cx.sim.despawn(id);\n                cx.ev.push(crate::frame::SimEvent::Splash { pos: at });\n            }\n            self.potted += 1;\n            cx.sfx(sound::SHELL_PLOP, 0.9, 1.0 + self.potted as f32 * 0.03);\n        }\n        self.roll += dt * roll_speed;\n        if self.roll > 0.6 {\n            self.roll = 0.0;\n            cx.sfx(sound::SHELL_ROLL, (roll_speed / 6.0).min(0.6), 1.0);\n        }\n        lean_figure(cx.sim, cx.pid, tilt, 0.0, r.tilt_deg + 8.0, cx.slump);\n        place_on_raft(cx, self.center, rot);\n        c.score = (self.potted as f32 * r.per_shell).min(r.shell_cap) + clamp01(self.t_left / r.length) * r.time_worth * if self.all_potted() { 1.0 } else { 0.0 };\n        // A board cleared: the next one.\n        if self.shells.iter().all(|s| s.potted) && !self.done {\n            if self.board >= 2 {\n                self.done = true;\n                self.end_wait = 1.0;\n            } else {\n                self.board += 1;\n                self.deal(cx);\n                cx.sfx(sound::FANFARE, 0.5, 1.2);\n                c.say_key(Who::Gull, \"gull.tide_board\", self.board);\n            }\n        }\n        if self.done {\n            self.end_wait -= dt;\n            return (self.end_wait <= 0.0).then(|| clamp01(c.score / 1000.0) * 1000.0);\n        }\n        (self.t_left <= 0.0).then(|| clamp01(c.score / 1000.0) * 1000.0)\n    }\n\n    fn all_potted(&self) -> bool {\n        self.board >= 2 && self.shells.iter().all(|s| s.potted)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        self.clear_board(cx);\n        if let Some(id) = self.raft.take() {\n            cx.sim.despawn(id);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, _r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Tide Table\", Some(self.t_left));\n        let mut p = c.puck(false);\n        p.c = [1700.0, 830.0];\n        p.r = 150.0;\n        ui.puck(p);\n        ui.panel(40.0, 170.0, 340.0, 120.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.text(60.0, 180.0, 34.0, INK_SOFT, Align::Left, format!(\"Board {} of 3\", self.board + 1));\n        ui.label(60.0, 222.0, 44.0, INK, Align::Left, format!(\"{} shells in\", self.potted));\n        if self.skip_flash > 0.0 {\n            ui.label(960.0, 200.0, 64.0, CORAL, Align::Center, \"Too fast. It skipped.\");\n        }\n        ui.prompt_row(&[(Act::Lean, \"Tilt the raft\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        // Steer the shell nearest a pool toward that pool.\n        let t = r.tide.gravity;\n        let pools: Vec<Vec2> = self.pools.iter().map(|p| p.p + p.moves * (c.t * 0.9).sin()).collect();\n        let mut best: Option<(f32, Vec2, Vec2, Vec2)> = None;\n        for s in self.shells.iter().filter(|s| !s.potted) {\n            for pp in &pools {\n                let d = (*pp - s.p).length();\n                if best.is_none_or(|b| d < b.0) {\n                    best = Some((d, s.p, s.v, *pp));\n                }\n            }\n        }\n        let Some((_, p, v, goal)) = best else { return Intent::default() };\n        // Slow down near the pool: it skips when fast.\n        let want_v = ((goal - p) * 1.05).clamp_length_max(r.tide.skip_speed * 0.8);\n        let acc = (want_v - v) * 2.4 + v * r.tide.friction;\n        let lean = (acc / t).clamp_length_max(0.95);\n        Intent { lean, ..Default::default() }\n    }\n}\n\n/// The figure rides the raft's middle.\nfn place_on_raft(cx: &mut Cx, center: Vec3, rot: Quat) {\n    let up = rot * Vec3::Y;\n    let feet = center + up * 0.14;\n    let facing = cx.sim.state.entities.get(cx.pid).and_then(|e| e.character.as_ref()).map(|c| c.facing).unwrap_or(0.0);\n    place(cx.sim, cx.pid, feet, facing);\n}\nEOF\ncat > paddle.rs <<'EOF'\n//! Paddle Slalom: stand on a board, steer with your lean, pass the gates.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Gate {\n    pub z: f32,\n    pub x: f32,\n    pub passed: bool,\n    pub ids: Vec<EntityId>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct PaddleSlalom {\n    pub x: f32,\n    pub z: f32,\n    pub speed: f32,\n    pub yaw: f32,\n    pub gates: Vec<Gate>,\n    pub next: usize,\n    pub missed: u32,\n    pub penalty: f32,\n    pub remount: f32,\n    pub gust: Vec2,\n    pub gust_t: f32,\n    pub gust_in: f32,\n    pub streak_ids: Vec<EntityId>,\n    pub board: Option<EntityId>,\n    pub wake: f32,\n    pub start: Vec3,\n    pub done: f32,\n    pub final_time: f32,\n    pub tips: u32,\n}\n\nimpl PaddleSlalom {\n    pub fn new() -> Self {\n        Self { gust_in: 5.0, ..Default::default() }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let r = &cx.rules.paddle;\n        self.start = cx.stage(Set::Channel);\n        let at = self.start;\n        ready_player(cx, Set::Channel, at + Vec3::Y * 0.02, std::f32::consts::PI);\n        cam_full(cx.sim, 22.0, 0.0, 10.0, 40.0, 0.9, 0.1, None);\n        self.board = Some(spawn_prop(cx.sim, \"LIB/core/paddleboard\", at, 0.0, 1.0));\n        let n = r.gates as usize;\n        for i in 0..n {\n            let z = (i as f32 + 1.0) / (n as f32 + 0.6) * r.length;\n            let rng = &mut cx.sim.state.rng;\n            let x = rng.range(-r.gate_x, r.gate_x);\n            let mut ids = Vec::new();\n            for side in [-1.0, 1.0] {\n                let p = at + Vec3::new(x + side * r.gate_width * 0.5, 0.0, -z);\n                ids.push(spawn_prop(cx.sim, \"LIB/core/buoy\", p, 0.0, 1.0));\n            }\n            self.gates.push(Gate { z, x, passed: false, ids });\n        }\n        c.say_key(Who::Gull, \"gull.paddle_start\", 0);\n    }\n\n    fn par(&self, r: &Rules) -> f32 {\n        r.paddle.par\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.paddle;\n        let dt = cx.dt;\n        if self.done > 0.0 {\n            self.done -= dt;\n            let par = self.par(rules);\n            let score = clamp01((1.6 * par - self.final_time) / (0.8 * par)) * 1000.0;\n            c.score = score;\n            return (self.done <= 0.0).then_some(score);\n        }\n        // Gusts, shown as ripple streaks, push the dot.\n        self.gust_in -= dt;\n        if self.gust_in <= 0.0 {\n            self.gust_in = cx.sim.state.rng.range(r.gust_every * 0.7, r.gust_every * 1.3);\n            let side = if cx.sim.state.rng.f32() < 0.5 { -1.0 } else { 1.0 };\n            self.gust = Vec2::new(side, 0.25) * r.gust;\n            self.gust_t = 1.3;\n            cx.sfx(sound::GUST, 0.7, 1.0);\n            let at = self.start + Vec3::new(self.x - side * 3.0, 0.0, -self.z - 8.0);\n            for i in 0..5 {\n                let p = at + Vec3::new(side * i as f32 * 0.6, 0.02, i as f32 * 0.7 - 2.0);\n                let id = spawn_box(cx.sim, \"ripple\", p, Vec3::new(1.3, 0.01, 0.06), \"#f4fbfb\");\n                self.streak_ids.push(id);\n            }\n        }\n        if self.gust_t > 0.0 {\n            self.gust_t -= dt;\n            let side = self.gust.x.signum();\n            for id in self.streak_ids.clone() {\n                let p = pos_of(cx.sim, id) + Vec3::new(side * 6.0 * dt, 0.0, 0.0);\n                move_to(cx.sim, id, p);\n            }\n        } else {\n            self.gust = Vec2::ZERO;\n            despawn_all(cx.sim, &mut self.streak_ids);\n        }\n        if self.remount > 0.0 {\n            self.remount -= dt;\n            self.speed = 0.0;\n            if self.remount <= 0.0 {\n                c.core.settle();\n                cx.sfx(sound::BOARD, 0.7, 1.0);\n            }\n        } else {\n            let lean_fwd = c.core.cob.y;\n            c.step(cx, it.lean, r.wobble * (1.0 + self.speed / 16.0), self.gust, Vec2::ZERO);\n            if c.core.tipped {\n                self.remount = r.remount;\n                self.tips += 1;\n                c.tip_fx(cx, true);\n                c.say_key(Who::Gull, \"gull.paddle_tip\", self.tips as usize);\n            }\n            let want = if lean_fwd > 0.0 { r.base_speed + r.fwd_speed * lean_fwd } else { (r.base_speed + r.brake * lean_fwd).max(0.3) };\n            self.speed += (want - self.speed) * (1.0 - (-r.accel * dt).exp());\n            let steer = c.core.cob.x * r.steer;\n            self.x = (self.x + steer * dt).clamp(-r.half_width, r.half_width);\n            self.yaw += (-steer * 0.06 - self.yaw) * (1.0 - (-5.0 * dt).exp());\n            self.z += self.speed * dt;\n        }\n        let at = self.start + Vec3::new(self.x, 0.02, -self.z);\n        let facing = std::f32::consts::PI + self.yaw;\n        if self.remount <= 0.0 {\n            place(cx.sim, cx.pid, at, facing);\n        } else {\n            // In the water, then climbing back on.\n            let u = self.remount / r.remount;\n            place(cx.sim, cx.pid, at - Vec3::Y * (0.9 * (u * 3.14).sin()), facing);\n        }\n        if let Some(b) = self.board {\n            let roll = c.core.cob.x * 0.14 * if self.remount > 0.0 { 3.0 } else { 1.0 };\n            pose(cx.sim, b, self.start + Vec3::new(self.x, -0.02, -self.z), Quat::from_rotation_y(self.yaw) * Quat::from_rotation_z(-roll));\n        }\n        if self.remount <= 0.0 {\n            lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, rules.core.tilt_deg, cx.slump);\n            play(cx.sim, cx.pid, \"FIT/Paddle\");\n        }\n        self.wake -= dt * self.speed.max(0.0);\n        if self.wake <= 0.0 {\n            self.wake = 0.7;\n            cx.ev.push(crate::frame::SimEvent::Wake { pos: at + Vec3::Z * 1.4 });\n        }\n        // Gates.\n        while let Some(g) = self.gates.get_mut(self.next) {\n            if self.z < g.z {\n                break;\n            }\n            let ok = (self.x - g.x).abs() < r.gate_width * 0.5;\n            g.passed = ok;\n            if ok {\n                cx.ev.push(crate::frame::SimEvent::Gate { pos: at, ok: true });\n            } else {\n                self.missed += 1;\n                self.penalty += r.miss_penalty;\n                cx.ev.push(crate::frame::SimEvent::Gate { pos: at, ok: false });\n                c.say_key(Who::Gull, \"gull.paddle_miss\", self.missed as usize);\n            }\n            self.next += 1;\n        }\n        let t = c.t + self.penalty;\n        let par = self.par(rules);\n        c.score = clamp01((1.6 * par - t) / (0.8 * par)) * 1000.0;\n        if self.z >= r.length || c.t >= r.max_time {\n            self.final_time = t;\n            self.done = 1.2;\n            cx.sfx(sound::FANFARE, 0.6, 1.0);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for g in self.gates.drain(..) {\n            for id in g.ids {\n                cx.sim.despawn(id);\n            }\n        }\n        despawn_all(cx.sim, &mut self.streak_ids);\n        if let Some(b) = self.board.take() {\n            cx.sim.despawn(b);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Paddle Slalom\", None);\n        ui.bar(560.0, 60.0, 800.0, 28.0, clamp01(self.z / r.paddle.length), TEAL);\n        let mut p = c.puck(false);\n        p.c = [1700.0, 830.0];\n        p.r = 150.0;\n        ui.puck(p);\n        ui.panel(40.0, 170.0, 380.0, 120.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.text(60.0, 180.0, 34.0, INK_SOFT, Align::Left, format!(\"{:.1} m/s\", self.speed));\n        ui.label(60.0, 222.0, 44.0, INK, Align::Left, format!(\"{:.1} s, {} missed\", c.t + self.penalty, self.missed));\n        if self.gust_t > 0.0 {\n            ui.label(960.0, 200.0, 64.0, CORAL, Align::Center, \"Gust!\");\n        }\n        if self.remount > 0.0 {\n            ui.label(960.0, 200.0, 64.0, CORAL, Align::Center, \"Remounting with dignity\");\n        }\n        ui.prompt_row(&[(Act::Lean, \"Steer, lean forward to go\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let target = self.gates.get(self.next).map(|g| g.x).unwrap_or(0.0);\n        let err = target - self.x;\n        // Lean forward 0.5 and steer to the gate's centre, against the wind.\n        let x = (err * 0.55 - self.gust.x / r.core.stiffness).clamp(-0.6, 0.6);\n        Intent { lean: Vec2::new(x, 0.5).clamp_length_max(0.85), ..Default::default() }\n    }\n}\nEOF\ncat > tray.rs <<'EOF'\n//! Tray Trek: walk a long pier with a stack of smoothies. Your dot tilts the tray.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Glass {\n    pub p: Vec2,\n    pub v: Vec2,\n    pub id: Option<EntityId>,\n    pub falling: f32,\n    pub lost: bool,\n    pub h: f32,\n    pub grip: f32,\n}\n\n/// A jolt to come, and what it is.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Jolt {\n    pub z: f32,\n    pub dir: Vec2,\n    /// 0 wave, 1 plank gap, 2 gull.\n    pub kind: u8,\n    pub warned: bool,\n    pub ent: Option<EntityId>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct TrayTrek {\n    pub z: f32,\n    pub glasses: Vec<Glass>,\n    pub jolts: Vec<Jolt>,\n    pub next: usize,\n    pub tray: Option<EntityId>,\n    pub start: Vec3,\n    pub warn: f32,\n    pub warn_word: String,\n    pub spilled: u32,\n    pub finish: f32,\n    pub marjorie: Option<EntityId>,\n    pub said: bool,\n    pub stepz: f32,\n}\n\nimpl TrayTrek {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let r = &cx.rules.tray;\n        self.start = cx.stage(Set::Pier);\n        let at = self.start;\n        ready_player(cx, Set::Pier, at, std::f32::consts::PI);\n        cam_full(cx.sim, 24.0, 0.0, 8.5, 40.0, 1.2, 0.08, None);\n        self.tray = Some(spawn_prop(cx.sim, \"LIB/core/tray\", at + Vec3::Y * 1.3, 0.0, 1.0));\n        let spots = [(0.0, 0.0), (-0.16, 0.1), (0.16, 0.1), (-0.08, -0.14), (0.1, -0.13)];\n        let cols = [\"#ff9db0\", \"#ffd166\", \"#78dcaa\", \"#c4b1e8\", \"#ffb88a\"];\n        for (i, (x, y)) in spots.iter().enumerate() {\n            let id = spawn_prop_roles(cx.sim, \"LIB/core/smoothie\", at + Vec3::Y * 1.4, 0.0, 1.0, &[(\"$accent\", cols[i])]);\n            let grip = 0.9 + i as f32 * 0.05;\n            self.glasses.push(Glass { p: Vec2::new(*x, *y), id: Some(id), h: if i == 0 { 0.2 } else { 0.0 }, grip, ..Default::default() });\n        }\n        // The jolts: the same on a seed.\n        let n = r.jolts as usize;\n        for i in 0..n {\n            let rng = &mut cx.sim.state.rng;\n            let z = 10.0 + (i as f32 + rng.range(0.0, 0.5)) / n as f32 * (r.length - 16.0);\n            let kind = rng.below(3) as u8;\n            let a = if rng.f32() < 0.5 { 0.0f32 } else { std::f32::consts::PI } + rng.range(-0.9, 0.9);\n            let mut jolt = Jolt { z, dir: Vec2::new(a.cos(), a.sin()), kind, warned: false, ent: None };\n            if kind == 1 {\n                let p = at + Vec3::new(0.0, 0.01, -z);\n                jolt.ent = Some(spawn_box(cx.sim, \"gap\", p, Vec3::new(1.6, 0.012, 0.35), \"#35586a\"));\n            }\n            self.jolts.push(jolt);\n        }\n        self.marjorie = npc(cx.sim, \"marjorie_pier\");\n        c.say_key(Who::Gull, \"gull.tray_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.tray;\n        let dt = cx.dt;\n        if self.finish > 0.0 {\n            self.finish -= dt;\n            return (self.finish <= 0.0).then(|| c.score);\n        }\n        self.z += r.pace * dt;\n        let mut nudge = Vec2::ZERO;\n        let mut kick = Vec2::ZERO;\n        self.warn = (self.warn - dt).max(0.0);\n        if let Some(j) = self.jolts.get_mut(self.next) {\n            if !j.warned && j.z - self.z < r.pace * r.warning {\n                j.warned = true;\n                self.warn = r.warning;\n                self.warn_word = [\"Wave!\", \"Plank gap!\", \"Gull!\"][j.kind as usize].to_string();\n                if j.kind == 2 {\n                    let p = self.start + Vec3::new(-j.dir.x * 12.0, 3.0, -self.z);\n                    j.ent = Some(spawn_prop(cx.sim, \"LIB/core/gull\", p, 0.0, 1.2));\n                    cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::GULL, gain: 0.9, pitch: 1.0 });\n                } else if j.kind == 0 {\n                    cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::WAVE, gain: 0.7, pitch: 1.0 });\n                }\n            }\n            if self.z >= j.z {\n                nudge = j.dir * r.jolt_nudge;\n                kick = j.dir * r.jolt_kick;\n                let at = self.start + Vec3::new(j.dir.x * 3.0, 0.0, -self.z);\n                match j.kind {\n                    0 => cx.ev.push(crate::frame::SimEvent::BigSplash { pos: at, size: 0.6 }),\n                    1 => cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::CREAK, gain: 1.0, pitch: 0.8 }),\n                    _ => cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::GULL, gain: 1.0, pitch: 1.3 }),\n                }\n                self.next += 1;\n            }\n        }\n        // A swooping gull crosses over.\n        for j in &mut self.jolts {\n            if j.kind == 2 {\n                if let Some(id) = j.ent {\n                    let u = (self.z - j.z) / (r.pace * 1.6);\n                    let p = self.start + Vec3::new(j.dir.x * 12.0 * u, 1.8 + 1.8 * u.abs(), -self.z + 1.0);\n                    move_to(cx.sim, id, p);\n                    if u > 1.2 {\n                        cx.sim.despawn(id);\n                        j.ent = None;\n                    }\n                }\n            }\n        }\n        c.step(cx, it.lean, r.wobble, Vec2::ZERO, nudge);\n        if c.core.tipped {\n            c.tip_fx(cx, false);\n            kick += c.core.cob * 0.6;\n            c.core.settle();\n        }\n        let tilt = c.core.cob;\n        let feet = self.start + Vec3::new(0.0, 0.0, -self.z);\n        place(cx.sim, cx.pid, feet, std::f32::consts::PI);\n        // Hands forward: the tray rides above them.\n        let at = feet + Vec3::new(0.0, 1.32, -0.42);\n        let rot = Quat::from_rotation_z(-tilt.x * r.tilt_deg.to_radians()) * Quat::from_rotation_x(-tilt.y * r.tilt_deg.to_radians());\n        if let Some(t) = self.tray {\n            pose(cx.sim, t, at, rot);\n        }\n        let mut plops = 0;\n        for g in &mut self.glasses {\n            if g.lost {\n                continue;\n            }\n            if g.falling > 0.0 {\n                g.falling -= dt;\n                if let Some(id) = g.id {\n                    let p = pos_of(cx.sim, id);\n                    let v = Vec3::new(g.v.x, -(0.6 - g.falling) * 9.0, -g.v.y);\n                    move_to(cx.sim, id, p + v * dt);\n                    if g.falling <= 0.0 {\n                        cx.sim.despawn(id);\n                        g.id = None;\n                        g.lost = true;\n                    }\n                }\n                continue;\n            }\n            // Glasses slide with tilt; a jolt kicks them.\n            let a = tilt * r.slide * g.grip - g.v * r.friction;\n            g.v += a * dt + kick * g.grip;\n            g.p += g.v * dt;\n            if g.p.length() > r.edge {\n                g.falling = 0.6;\n                self.spilled += 1;\n                plops += 1;\n            }\n            if let Some(id) = g.id {\n                pose(cx.sim, id, at + rot * Vec3::new(g.p.x, 0.05 + g.h, -g.p.y), rot);\n            }\n        }\n        for _ in 0..plops {\n            cx.sfx(sound::GLASS_PLOP, 0.9, 1.0);\n            c.say_key(Who::Gull, \"gull.tray_spill\", self.spilled as usize);\n        }\n        // The walk: Balance_Walk under, the carry on top.\n        play_flags(cx.sim, cx.pid, \"FIT/TrayWalk\", 0, 1.0);\n        lean_figure(cx.sim, cx.pid, tilt, 0.0, rules.core.tilt_deg * 0.6, cx.slump);\n        self.stepz += r.pace * dt;\n        if self.stepz > 0.8 {\n            self.stepz = 0.0;\n            cx.sfx(sound::STEP, 0.3, 1.0);\n        }\n        let left = self.glasses.iter().filter(|g| !g.lost && g.falling <= 0.0).count() as f32;\n        c.score = clamp01((left * r.per_glass + if self.spilled == 0 { r.bonus } else { 0.0 }) / 1000.0) * 1000.0;\n        if self.z >= r.length {\n            let mar = (left as usize).min(5);\n            c.say_key(Who::Marjorie, \"marjorie.tray\", mar);\n            self.finish = 3.0;\n            cx.sfx(sound::FANFARE, 0.6, 1.0);\n            stop_clip(cx.sim, cx.pid);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for g in self.glasses.drain(..) {\n            if let Some(id) = g.id {\n                cx.sim.despawn(id);\n            }\n        }\n        for j in self.jolts.drain(..) {\n            if let Some(id) = j.ent {\n                cx.sim.despawn(id);\n            }\n        }\n        if let Some(t) = self.tray.take() {\n            cx.sim.despawn(t);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Tray Trek\", None);\n        ui.bar(560.0, 60.0, 800.0, 28.0, clamp01(self.z / r.tray.length), TEAL);\n        ui.puck({\n            let mut p = c.puck(false);\n            p.c = [1700.0, 830.0];\n            p.r = 150.0;\n            p\n        });\n        // The tray from above, with its glasses.\n        let (cx, cy, rr) = (220.0, 830.0, 150.0);\n        ui.circle(cx, cy, rr, with_alpha(WHITE, 0.92), INK_SOFT, 6.0);\n        for g in &self.glasses {\n            if g.lost || g.falling > 0.0 {\n                continue;\n            }\n            let k = rr / r.tray.edge;\n            ui.circle(cx + g.p.x * k, cy - g.p.y * k, 26.0, CORAL, WHITE, 4.0);\n        }\n        if self.warn > 0.0 {\n            ui.label(960.0, 200.0, 72.0, CORAL, Align::Center, self.warn_word.clone());\n        }\n        ui.prompt_row(&[(Act::Lean, \"Tilt the tray, keep the glasses on\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        // Counter the jolts it knows are coming, and bring the stack back to the middle.\n        let live: Vec<&Glass> = self.glasses.iter().filter(|g| !g.lost && g.falling <= 0.0).collect();\n        let mut sum = Vec2::ZERO;\n        let mut vel = Vec2::ZERO;\n        let mut far = Vec2::ZERO;\n        let mut far_d = 0.0;\n        for g in &live {\n            sum += g.p;\n            vel += g.v;\n            if g.p.length() > far_d {\n                far_d = g.p.length();\n                far = g.p;\n            }\n        }\n        let n = live.len().max(1) as f32;\n        let target = -(sum / n) * 1.8 - (vel / n) * 1.6 - far * 0.8;\n        let mut lean = target * r.tray.friction.max(0.5);\n        if let Some(j) = self.jolts.get(self.next) {\n            if j.z - self.z < r.tray.pace * 0.25 {\n                lean -= j.dir * 0.2;\n            }\n        }\n        let _ = c;\n        Intent { lean: lean.clamp_length_max(0.9), ..Default::default() }\n    }\n}\nEOF\ncat > dive.rs <<'EOF'\n//! Cannonball Cup: bounce, leap, tuck. We are not here for form. We are here for splash.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum DivePhase {\n    #[default]\n    Bounce,\n    Air,\n    Splash,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct CannonballCup {\n    pub dive: usize,\n    pub phase: DivePhase,\n    pub pt: f32,\n    pub presses: u32,\n    pub power: f32,\n    pub pressed_now: bool,\n    pub timing: f32,\n    pub tuck: f32,\n    pub spin: f32,\n    pub spin_v: f32,\n    pub pos: Vec3,\n    pub vel: Vec3,\n    pub apex: f32,\n    pub entry_tuck: f32,\n    pub scores: Vec<f32>,\n    pub last_score: f32,\n    pub cards: Vec<String>,\n    pub board: Option<EntityId>,\n    pub tip: Vec3,\n    pub water: f32,\n    pub judges: Vec<EntityId>,\n    pub said: bool,\n}\n\nimpl CannonballCup {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Time to the next bottom of the bounce.\n    fn to_bottom(&self, r: &Rules) -> f32 {\n        let p = r.dive.period;\n        let u = (self.pt / p).fract();\n        // The bottom comes at phase 0.75 of a sine.\n        let d = (0.75 - u).rem_euclid(1.0);\n        d.min(1.0 - d) * p * if d < 0.5 { 1.0 } else { -1.0 }\n    }\n\n    fn reset_dive(&mut self, cx: &mut Cx) {\n        self.phase = DivePhase::Bounce;\n        self.pt = 0.0;\n        self.presses = 0;\n        self.power = 0.0;\n        self.timing = 0.0;\n        self.tuck = 0.0;\n        self.spin = 0.0;\n        self.spin_v = 0.0;\n        self.apex = 0.0;\n        self.cards.clear();\n        self.said = false;\n        place(cx.sim, cx.pid, self.tip, 0.0);\n        stop_clip(cx.sim, cx.pid);\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Tower);\n        self.tip = at + Vec3::new(0.0, cx.rules.dive.tower, 0.0);\n        self.water = at.y;\n        ready_player(cx, Set::Tower, self.tip, 0.0);\n        cam_full(cx.sim, 6.0, 90.0, 14.0, 42.0, 0.0, 0.06, None);\n        self.board = Some(spawn_prop(cx.sim, \"LIB/core/diving_board\", self.tip, 0.0, 1.0));\n        self.judges = [\"judge1\", \"judge2\", \"judge3\"].iter().filter_map(|n| npc(cx.sim, n)).collect();\n        self.reset_dive(cx);\n        c.say_key(Who::Gull, \"gull.dive_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.dive;\n        let dt = cx.dt;\n        self.pt += dt;\n        c.step(cx, it.lean, 0.5, Vec2::ZERO, Vec2::ZERO);\n        match self.phase {\n            DivePhase::Bounce => {\n                let w = std::f32::consts::TAU / r.period;\n                let amp = r.bounce_amp * (1.0 + self.presses as f32 * 0.5);\n                let bob = (self.pt * w).sin() * amp;\n                let feet = self.tip + Vec3::Y * (bob.max(-amp * 0.35));\n                place(cx.sim, cx.pid, feet, 0.0);\n                if let Some(b) = self.board {\n                    let bend = (-bob / amp.max(0.01)).max(-0.4) * 0.06 * (1.0 + self.presses as f32 * 0.3);\n                    pose(cx.sim, b, self.tip - Vec3::Y * bend.max(0.0) * 1.2, Quat::from_rotation_x(bend));\n                }\n                lean_figure(cx.sim, cx.pid, c.core.cob * 0.3, 90.0, 10.0, cx.slump);\n                if it.act_just {\n                    let off = self.to_bottom(rules).abs();\n                    let good = 1.0 - clamp01(off / r.press_window);\n                    self.timing += good;\n                    self.presses += 1;\n                    cx.sfx(sound::BOARD, 0.4 + 0.2 * self.presses as f32, 0.8 + 0.15 * self.presses as f32);\n                    if self.presses >= 4 {\n                        self.power = self.timing / 4.0;\n                        self.phase = DivePhase::Air;\n                        self.pt = 0.0;\n                        self.pos = feet;\n                        let v = r.leap_base + r.leap_power * self.power;\n                        self.vel = Vec3::new(0.0, v, r.forward);\n                        self.apex = feet.y;\n                        cx.ev.push(crate::frame::SimEvent::Jump { pos: feet });\n                        cx.sfx(sound::WHOOSH, 0.8, 1.0);\n                    }\n                }\n                if self.pt > r.board_timeout {\n                    // Nobody jumped: the board does it for you.\n                    self.power = self.timing / 4.0 * 0.3;\n                    self.phase = DivePhase::Air;\n                    self.pt = 0.0;\n                    self.pos = feet;\n                    self.vel = Vec3::new(0.0, 1.0, 1.4);\n                    self.apex = feet.y;\n                    c.say_key(Who::Gull, \"gull.dive_push\", self.dive);\n                }\n            }\n            DivePhase::Air => {\n                self.vel.y -= r.gravity * dt;\n                self.pos += self.vel * dt;\n                self.apex = self.apex.max(self.pos.y);\n                let want = if it.act { 1.0 } else { 0.0 };\n                self.tuck += (want - self.tuck) * (1.0 - (-r.tuck_rate * dt).exp());\n                self.spin_v = c.core.cob.y * r.spin_lean + self.tuck * r.spin_tuck;\n                self.spin += self.spin_v * dt;\n                place(cx.sim, cx.pid, self.pos, 0.0);\n                scrub(cx.sim, cx.pid, \"FIT/Tuck\", self.tuck);\n                if let Some(a) = anim_of(cx.sim, cx.pid) {\n                    a.tilt_side = 0.0;\n                    a.tilt_fwd = self.spin;\n                }\n                if self.pos.y <= self.water + 0.1 {\n                    self.entry_tuck = self.tuck;\n                    let h = clamp01((self.apex - self.water) / r.height_par);\n                    let tuck = r.flop_tuck + (1.0 - r.flop_tuck) * self.entry_tuck;\n                    let timing = 0.3 + 0.7 * self.power;\n                    let score = clamp01(h * tuck * timing / r.par) * 1000.0;\n                    self.last_score = score;\n                    self.scores.push(score);\n                    self.phase = DivePhase::Splash;\n                    self.pt = 0.0;\n                    let size = 0.5 + 2.2 * score / 1000.0;\n                    cx.ev.push(crate::frame::SimEvent::BigSplash { pos: self.pos, size });\n                    cx.sfx(sound::SPLASH_B, 1.0, 1.0 - 0.3 * score / 1000.0);\n                    // The cards.\n                    let rng = &mut cx.sim.state.rng;\n                    let v = score / 100.0;\n                    self.cards = (0..3)\n                        .map(|_| {\n                            if rng.f32() < 0.12 {\n                                \"See me\".to_string()\n                            } else {\n                                format!(\"{:.1}\", ((v + rng.range(-0.8, 0.8)) * 2.0).round().clamp(0.0, 20.0) / 2.0)\n                            }\n                        })\n                        .collect();\n                    c.score = self.scores.iter().sum::<f32>() / 3.0;\n                    c.say_key(Who::Gull, \"gull.dive_after\", self.dive + (score / 200.0) as usize);\n                }\n            }\n            DivePhase::Splash => {\n                // The figure bobs up, then it is the next dive.\n                let up = self.water - 1.1 + clamp01(self.pt / 1.2) * 0.45;\n                place(cx.sim, cx.pid, Vec3::new(self.pos.x, up, self.pos.z), 0.0);\n                if let Some(a) = anim_of(cx.sim, cx.pid) {\n                    a.tilt_fwd = 0.0;\n                }\n                play(cx.sim, cx.pid, \"FIT/Tread\");\n                if self.pt < 0.2 {\n                    for &j in &self.judges {\n                        gesture(cx.sim, j, \"CMU/Wave_Hello\", true);\n                    }\n                }\n                if self.pt >= r.splash_time {\n                    self.dive += 1;\n                    if self.dive >= 3 {\n                        return Some(c.score);\n                    }\n                    self.reset_dive(cx);\n                }\n            }\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(b) = self.board.take() {\n            cx.sim.despawn(b);\n        }\n        if let Some(a) = anim_of(cx.sim, cx.pid) {\n            a.tilt_fwd = 0.0;\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Cannonball Cup\", None);\n        ui.panel(40.0, 170.0, 380.0, 76.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.label(60.0, 182.0, 44.0, INK, Align::Left, format!(\"Dive {} of 3\", (self.dive + 1).min(3)));\n        match self.phase {\n            DivePhase::Bounce => {\n                // Bounce meter: press when the bar is at the bottom.\n                let off = self.to_bottom(r);\n                let near = 1.0 - clamp01(off.abs() / (r.dive.period * 0.5));\n                let (x, y) = (820.0, 830.0);\n                ui.panel(x, y, 280.0, 60.0, with_alpha(WHITE, 0.9), 30.0);\n                ui.panel(x + 8.0, y + 8.0, (280.0 - 16.0) * near, 44.0, if near > 0.75 { MINT } else { SEA }, 22.0);\n                for i in 0..4 {\n                    let col = if (i as u32) < self.presses { CORAL } else { with_alpha(WHITE, 0.9) };\n                    ui.circle(816.0 + i as f32 * 96.0, 780.0, 30.0, col, INK_SOFT, 4.0);\n                }\n                let label = if self.presses >= 3 { \"Leap at the bottom\" } else { \"Press at the bottom\" };\n                ui.prompt_row(&[(Act::Confirm, label)]);\n            }\n            DivePhase::Air => {\n                ui.label(960.0, 180.0, 72.0, if self.tuck > 0.6 { TEAL } else { CORAL }, Align::Center, if self.tuck > 0.6 { \"Tucked\" } else { \"Tuck!\" });\n                ui.prompt_row(&[(Act::Confirm, \"Hold to tuck\"), (Act::Lean, \"Rotate\")]);\n            }\n            DivePhase::Splash => {\n                for (i, card) in self.cards.iter().enumerate() {\n                    let x = 560.0 + i as f32 * 400.0;\n                    ui.card(x - 170.0, 300.0, 340.0, 210.0);\n                    ui.title(x, 350.0, if card.len() > 4 { 64.0 } else { 96.0 }, INK, Align::Center, card.clone());\n                }\n                ui.label(960.0, 560.0, 72.0, TEAL, Align::Center, format!(\"{:.0} splash\", self.last_score));\n            }\n        }\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let mut it = Intent::default();\n        match self.phase {\n            DivePhase::Bounce => {\n                // Presses on bottoms.\n                let off = self.to_bottom(r);\n                let dt = 1.0 / 60.0;\n                if off.abs() < dt * 0.6 && self.pt > 0.3 {\n                    it.act_just = true;\n                    it.act = true;\n                }\n            }\n            DivePhase::Air => {\n                // Tucks at the apex.\n                if self.vel.y < 1.0 {\n                    it.act = true;\n                }\n                it.lean = Vec2::new(0.0, 0.15);\n            }\n            DivePhase::Splash => {}\n        }\n        let _ = c;\n        it\n    }\n}\nEOF\necho ok","description":"Write remaining seven event modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26015,"cache_read_input_tokens":339318,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26015},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"e2f11e7c-555a-4790-8e88-f1dea787e210","timestamp":"2026-11-05T05:59:04.059Z","request_id":"req_011CgjGGhz1d98auGheGLdQk","wire_tool_inputs":{"toolu_01UtP15gUgsbkgHLvkP8UnxR":{"command":"cd engine/crates/pav_core/src/games/fit/events && cat > step.rs <<'EOF'\n//! Step Party: a rhythm game on an aerobic step box. Timing uses the music's clock.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n/// How a note went.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Judged {\n    #[default]\n    Pending,\n    Good,\n    Perfect,\n    Miss,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Note {\n    pub time: f32,\n    /// 0 left, 1 right, 2 both.\n    pub lane: u8,\n    pub l: bool,\n    pub r: bool,\n    pub judged: Judged,\n    pub worst: f32,\n}\n\n#[derive(Deserialize)]\nstruct Charts {\n    bpm: f32,\n    lead_in_beats: f32,\n    party: Vec<String>,\n    finale: Vec<String>,\n}\n\nfn charts() -> Charts {\n    toml::from_str(&crate::games::level_text(\"fit/charts\", include_str!(\"../charts.toml\")))\n        .unwrap_or_else(|e| panic!(\"charts.toml: {e}\"))\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct StepParty {\n    pub bars: Option<usize>,\n    pub bpm: f32,\n    pub notes: Vec<Note>,\n    pub next: usize,\n    pub sum: f32,\n    pub combo: u32,\n    pub song: f32,\n    pub end: f32,\n    pub beat: i32,\n    pub flash: f32,\n    pub flash_word: String,\n    pub foot: u8,\n    pub guests: Vec<EntityId>,\n    pub bounce: Option<EntityId>,\n    pub stunned: f32,\n    /// The finale: the balance matters too.\n    pub wobble: bool,\n    pub foot_l: f32,\n    pub foot_r: f32,\n}\n\nimpl StepParty {\n    pub fn new(bars: Option<usize>) -> Self {\n        Self { bars, wobble: bars.is_some(), ..Default::default() }\n    }\n\n    fn load(&mut self) {\n        let ch = charts();\n        self.bpm = ch.bpm;\n        let beat = 60.0 / ch.bpm;\n        let lines = if let Some(n) = self.bars { ch.finale.iter().take(n).cloned().collect() } else { ch.party };\n        for (b, line) in lines.iter().enumerate() {\n            for (i, c) in line.chars().enumerate() {\n                let lane = match c {\n                    'L' => 0,\n                    'R' => 1,\n                    'B' => 2,\n                    _ => continue,\n                };\n                let at = ch.lead_in_beats + b as f32 * 4.0 + i as f32 * 0.5;\n                self.notes.push(Note { time: at * beat, lane, ..Default::default() });\n            }\n        }\n        self.end = (ch.lead_in_beats + lines.len() as f32 * 4.0 + 2.0) * beat;\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        self.load();\n        if self.wobble {\n            return;\n        }\n        let at = cx.stage(Set::Boardwalk);\n        ready_player(cx, Set::Boardwalk, at + Vec3::Y * 0.3, 0.0);\n        cam(cx.sim, 18.0, 0.0, 9.5, 36.0);\n        self.bounce = npc(cx.sim, \"bounce\");\n        self.guests = cx.sim.state.entities.iter().filter(|e| e.name.starts_with(\"clapper\")).map(|e| e.id).collect();\n        c.say_key(Who::Bounce, \"bounce.step_start\", 0);\n    }\n\n    fn judge(&mut self, song: f32, left: bool, right: bool, r: &Rules, cx: &mut Cx, c: &mut RunCommon) {\n        let w = r.step.good_window;\n        for lane_press in [(left, 0u8), (right, 1u8)] {\n            if !lane_press.0 {\n                continue;\n            }\n            let lane = lane_press.1;\n            let best = self\n                .notes\n                .iter()\n                .enumerate()\n                .skip(self.next.saturating_sub(4))\n                .take_while(|(_, n)| n.time < song + w + 0.01)\n                .filter(|(_, n)| n.judged == Judged::Pending && (n.time - song).abs() <= w)\n                .filter(|(_, n)| match (n.lane, lane) {\n                    (2, 0) => !n.l,\n                    (2, 1) => !n.r,\n                    (a, b) => a == b,\n                })\n                .min_by(|a, b| (a.1.time - song).abs().total_cmp(&(b.1.time - song).abs()))\n                .map(|(i, _)| i);\n            let Some(i) = best else {\n                continue;\n            };\n            let n = &mut self.notes[i];\n            let off = (n.time - song).abs();\n            n.worst = n.worst.max(off);\n            if lane == 0 {\n                n.l = true;\n            } else {\n                n.r = true;\n            }\n            let done = n.lane != 2 || (n.l && n.r);\n            if done {\n                let perfect = n.worst <= r.step.perfect_window;\n                n.judged = if perfect { Judged::Perfect } else { Judged::Good };\n                let v = if perfect { 1.0 } else { r.step.good_value };\n                self.sum += v;\n                self.combo += 1;\n                self.flash = 0.45;\n                self.flash_word = if perfect { \"Perfect\".into() } else { \"Good\".into() };\n                cx.sfx(if perfect { sound::HIT_PERFECT } else { sound::HIT_GOOD }, 0.5, 1.0);\n                c.score = self.sum / self.notes.len().max(1) as f32 * 1000.0;\n            }\n        }\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let dt = cx.dt;\n        // The music's clock when it is believable (it isn't for a moment as a song starts).\n        let song = match it.song_pos {\n            Some(p) if (p - c.t).abs() < 1.5 => p,\n            _ => c.t,\n        };\n        self.song = song;\n        let amp = if self.wobble { cx.rules.stand.band_wobble } else { 0.5 };\n        c.step(cx, it.lean, amp, Vec2::ZERO, Vec2::ZERO);\n        self.stunned = (self.stunned - dt).max(0.0);\n        if self.wobble && c.core.tipped {\n            self.stunned = 1.2;\n            c.tip_fx(cx, true);\n        }\n        if self.stunned <= 0.0 {\n            let rules = cx.rules;\n            self.judge(song, it.l_just, it.r_just, rules, cx, c);\n        }\n        // Misses.\n        let w = cx.rules.step.good_window;\n        while let Some(n) = self.notes.get_mut(self.next) {\n            if n.judged != Judged::Pending {\n                self.next += 1;\n            } else if n.time + w < song {\n                n.judged = Judged::Miss;\n                self.combo = 0;\n                self.flash = 0.45;\n                self.flash_word = \"Miss\".into();\n                cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::MISS, gain: 0.3, pitch: 1.0 });\n                self.next += 1;\n            } else {\n                break;\n            }\n        }\n        self.flash = (self.flash - dt).max(0.0);\n        // The figure steps; the box bounces on the beat.\n        if it.l_just {\n            self.foot = 0;\n            self.foot_l = 1.0;\n        }\n        if it.r_just {\n            self.foot = 1;\n            self.foot_r = 1.0;\n        }\n        self.foot_l = (self.foot_l - dt * 3.0).max(0.0);\n        self.foot_r = (self.foot_r - dt * 3.0).max(0.0);\n        if it.l_just || it.r_just {\n            gesture(cx.sim, cx.pid, if self.foot == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" }, false);\n            cx.sfx(sound::STEP, 0.4, 1.0);\n        }\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        let beat = (song * self.bpm / 60.0).floor() as i32;\n        if beat != self.beat {\n            self.beat = beat;\n            if let Some(bo) = self.bounce {\n                if let Some(a) = anim_of(cx.sim, bo) {\n                    a.squash_vel = 3.0;\n                }\n            }\n            if beat % 4 == 0 {\n                for i in 0..self.guests.len() {\n                    gesture(cx.sim, self.guests[i], \"MESH2MOTION/Cheering_Two_Hands\", true);\n                }\n                if !self.guests.is_empty() {\n                    cx.sfx(sound::CLAP, 0.35, 1.0);\n                }\n            }\n        }\n        (song >= self.end).then_some(c.score)\n    }\n\n    pub fn stop(&mut self, _cx: &mut Cx) {}\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        if !self.wobble {\n            c.top_bar(ui, \"Step Party\", Some(self.end - self.song));\n        }\n        // Two lanes on either side of the figure, falling to two footprints.\n        let lanes = [640.0, 1280.0];\n        let (top, foot) = (170.0, 880.0);\n        let window = 1.6;\n        for (i, &x) in lanes.iter().enumerate() {\n            ui.panel(x - 74.0, top - 40.0, 148.0, foot - top + 120.0, with_alpha(WHITE, 0.5), 74.0);\n            let press = if i == 0 { self.foot_l } else { self.foot_r };\n            ui.circle(x, foot, 66.0 + press * 12.0, with_alpha(SEA, 0.5 + press * 0.5), TEAL, 8.0);\n            ui.label(x, foot - 26.0, 44.0, INK, Align::Center, if i == 0 { \"L\" } else { \"R\" });\n        }\n        for n in &self.notes {\n            let dt = n.time - self.song;\n            if n.judged != Judged::Pending || !(-0.2..=window).contains(&dt) {\n                continue;\n            }\n            let y = foot - (foot - top) * dt / window;\n            let color = if n.lane == 2 { SUN } else if n.lane == 0 { TEAL } else { CORAL };\n            if n.lane == 2 || n.lane == 0 {\n                ui.circle(lanes[0], y, 50.0, color, WHITE, 6.0);\n            }\n            if n.lane == 2 || n.lane == 1 {\n                ui.circle(lanes[1], y, 50.0, color, WHITE, 6.0);\n            }\n        }\n        if self.flash > 0.0 {\n            let col = match self.flash_word.as_str() {\n                \"Perfect\" => TEAL,\n                \"Good\" => MINT,\n                _ => CORAL,\n            };\n            ui.label(960.0, 180.0, 72.0, col, Align::Center, self.flash_word.clone());\n        }\n        if self.combo >= 5 {\n            ui.label(960.0, 270.0, 54.0, INK, Align::Center, format!(\"{} in a row\", self.combo));\n        }\n        if self.wobble {\n            let mut p = c.puck(false);\n            p.r = 120.0;\n            p.c = [960.0, 860.0];\n            ui.puck(p);\n        }\n        let _ = r;\n        ui.prompt_row_at(1040.0, &[(Act::StepL, \"Left\"), (Act::StepR, \"Right\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, _r: &Rules) -> Intent {\n        let mut it = Intent { lean: -c.core.cob * 0.6, ..Default::default() };\n        let dt = 1.0 / 60.0;\n        for n in self.notes.iter().skip(self.next) {\n            if n.time > c.t + dt * 1.5 {\n                break;\n            }\n            if n.judged == Judged::Pending && n.time >= c.t + dt * 0.5 - 0.001 {\n                it.l_just |= n.lane != 1;\n                it.r_just |= n.lane != 0;\n            }\n        }\n        it\n    }\n}\nEOF\ncat > spin.rs <<'EOF'\n//! Floatie Spin: circle the lean to keep inflatable rings up around your hips.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Ring {\n    pub id: Option<EntityId>,\n    /// Height above the feet.\n    pub h: f32,\n    pub angle: f32,\n    /// Flying in: seconds until it arrives, from which side (-1 left, 1 right).\n    pub flying: f32,\n    pub side: f32,\n    pub on: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct FloatieSpin {\n    pub rings: Vec<Ring>,\n    pub lost: u32,\n    pub omega: f32,\n    pub angle: f32,\n    pub last: Vec2,\n    pub dir: f32,\n    pub switch_in: f32,\n    pub toss_in: f32,\n    pub in_band: bool,\n    pub sum: f32,\n    pub clip_t: f32,\n    pub flash_switch: f32,\n    pub tossers: Vec<EntityId>,\n}\n\nimpl FloatieSpin {\n    pub fn new() -> Self {\n        Self { dir: 1.0, ..Default::default() }\n    }\n\n    fn add_ring(&mut self, cx: &mut Cx, side: f32, flying: f32, on: bool) {\n        let at = cx.feet() + Vec3::new(side * 6.0, 1.0, 0.0);\n        let colors = [\"#ff786e\", \"#ffd166\", \"#78dcaa\", \"#46bec8\", \"#c4b1e8\", \"#ffa8c0\", \"#fbfaf6\"];\n        let col = colors[self.rings.len() % colors.len()];\n        let id = spawn_prop_roles(cx.sim, \"LIB/core/floatie\", at, 0.0, 1.0, &[(\"$accent\", col)]);\n        let n = self.rings.len() as f32;\n        self.rings.push(Ring { id: Some(id), h: cx.rules.spin.ring_h + n * 0.07, angle: n * 1.1, flying, side, on });\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Boardwalk);\n        ready_player(cx, Set::Boardwalk, at + Vec3::Y * 0.3, 0.0);\n        cam(cx.sim, 16.0, 0.0, 8.5, 36.0);\n        self.switch_in = cx.rules.spin.switch_every;\n        self.toss_in = 3.0;\n        self.add_ring(cx, 0.0, 0.0, true);\n        self.tossers = cx.sim.state.entities.iter().filter(|e| e.name.starts_with(\"clapper\")).map(|e| e.id).collect();\n        c.say_key(Who::Bounce, \"bounce.spin_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.spin;\n        let dt = cx.dt;\n        c.step(cx, it.lean * 0.5, 0.4, Vec2::ZERO, Vec2::ZERO);\n        // Spin speed: the smoothed angular velocity of the lean.\n        let mut w = 0.0;\n        if it.lean.length() > r.min_lean && self.last.length() > r.min_lean {\n            let cross = self.last.perp_dot(it.lean);\n            let d = self.last.dot(it.lean);\n            w = cross.atan2(d) / dt;\n        }\n        self.last = it.lean;\n        self.omega += (w - self.omega) * (1.0 - (-r.smoothing * dt).exp());\n        self.angle += self.omega * dt;\n        let lo = r.band_lo / r.spin_band_scale;\n        let hi = r.band_hi * r.spin_band_scale;\n        let speed = self.omega * self.dir;\n        self.in_band = speed >= lo && speed <= hi;\n        // \"Switch!\" flips the direction.\n        self.switch_in -= dt;\n        if self.switch_in <= 0.0 {\n            self.switch_in = r.switch_every;\n            self.dir = -self.dir;\n            self.flash_switch = 1.2;\n            cx.sfx(sound::GONG, 0.5, 1.4);\n            c.say_key(Who::Bounce, \"bounce.spin_switch\", c.t as usize);\n        }\n        self.flash_switch = (self.flash_switch - dt).max(0.0);\n        // Guests toss new rings from either side.\n        let on = self.rings.iter().filter(|x| x.on).count();\n        self.toss_in -= dt;\n        if self.toss_in <= 0.0 && self.rings.len() < r.max_rings as usize + self.lost as usize {\n            self.toss_in = r.toss_every;\n            let side = if cx.sim.state.rng.f32() < 0.5 { -1.0 } else { 1.0 };\n            let fly = r.toss_flight;\n            self.add_ring(cx, side, fly, false);\n            cx.sfx(sound::WHOOSH, 0.5, 1.0);\n            if let Some(&t) = self.tossers.first() {\n                gesture(cx.sim, t, \"MESH2MOTION/Cheering_Two_Hands\", true);\n            }\n        }\n        let feet = cx.feet();\n        let (l, rr) = (it.l_just, it.r_just);\n        let mut catches = Vec::new();\n        for (i, ring) in self.rings.iter_mut().enumerate() {\n            if ring.on || ring.id.is_none() {\n                continue;\n            }\n            ring.flying -= dt;\n            let press = if ring.side < 0.0 { l } else { rr };\n            if press && ring.flying.abs() <= r.catch_window && on < r.max_rings as usize {\n                ring.on = true;\n                catches.push(i);\n            } else if ring.flying < -r.catch_window {\n                catches.push(usize::MAX - i);\n            }\n        }\n        for &i in &catches {\n            if i < 1000 {\n                cx.sfx(sound::CATCH, 0.7, 1.0 + i as f32 * 0.05);\n            } else {\n                let j = usize::MAX - i;\n                if let Some(id) = self.rings[j].id.take() {\n                    cx.sim.despawn(id);\n                }\n                self.lost += 1;\n                cx.sfx(sound::MISS, 0.4, 0.8);\n            }\n        }\n        // Out of band, rings sink; on the floor they are lost.\n        let mut dropped = Vec::new();\n        for (i, ring) in self.rings.iter_mut().enumerate() {\n            let Some(id) = ring.id else { continue };\n            if ring.flying > 0.0 && !ring.on {\n                let u = ring.flying / r.toss_flight;\n                let p = feet + Vec3::new(ring.side * 6.0 * u, 1.1 + 2.0 * (u * std::f32::consts::PI).sin(), 0.0);\n                pose(cx.sim, id, p, Quat::from_rotation_x(u * 6.0));\n                continue;\n            }\n            if !ring.on {\n                continue;\n            }\n            if self.in_band {\n                ring.h = (ring.h + dt * r.rise).min(r.ring_h + i as f32 * 0.07);\n            } else {\n                ring.h -= dt * r.sink;\n            }\n            ring.angle += self.omega * dt;\n            let w = ring.angle * 0.33 + i as f32;\n            let tilt = 0.18 + 0.08 * (i as f32).sin();\n            let off = Vec3::new(ring.angle.cos(), 0.0, ring.angle.sin()) * 0.1;\n            pose(cx.sim, id, feet + Vec3::Y * ring.h + off, Quat::from_rotation_y(w) * Quat::from_rotation_x(tilt));\n            if ring.h < 0.12 {\n                dropped.push(i);\n            }\n        }\n        for i in dropped {\n            if let Some(id) = self.rings[i].id.take() {\n                cx.sim.despawn(id);\n            }\n            self.rings[i].on = false;\n            self.lost += 1;\n            cx.sfx(sound::BUMP, 0.5, 1.4);\n        }\n        let on = self.rings.iter().filter(|x| x.on).count() as f32;\n        if self.in_band {\n            self.sum += on * dt;\n        }\n        c.score = clamp01(self.sum / r.par) * 1000.0;\n        // Scrub the hips round with the spin.\n        self.clip_t = self.angle.rem_euclid(std::f32::consts::TAU) / std::f32::consts::TAU;\n        let flip = if self.omega < 0.0 { 1.0 - self.clip_t } else { self.clip_t };\n        scrub(cx.sim, cx.pid, \"FIT/HipCircle\", flip);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        (c.t >= r.length).then_some(c.score)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for ring in self.rings.drain(..) {\n            if let Some(id) = ring.id {\n                cx.sim.despawn(id);\n            }\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Floatie Spin\", Some(r.spin.length - c.t));\n        let lean_dot = [self.last.x, self.last.y];\n        let mut p = c.puck(true);\n        p.dot = lean_dot;\n        p.good = self.in_band;\n        p.ring = Some([0.0, 0.0, 0.65]);\n        ui.puck(p);\n        // The speed gauge.\n        let (x, y, w, h) = (1500.0, 280.0, 90.0, 560.0);\n        ui.panel(x - 20.0, y - 20.0, w + 40.0, h + 40.0, with_alpha(WHITE, 0.9), 32.0);\n        let top = 14.0;\n        let lo = r.spin.band_lo / r.spin.spin_band_scale;\n        let hi = r.spin.band_hi * r.spin.spin_band_scale;\n        ui.panel(x, y + h * (1.0 - hi / top), w, h * (hi - lo) / top, MINT, 18.0);\n        let sp = (self.omega * self.dir).clamp(0.0, top);\n        ui.circle(x + w * 0.5, y + h * (1.0 - sp / top), 34.0, if self.in_band { TEAL } else { CORAL }, WHITE, 5.0);\n        let dirs = if self.dir > 0.0 { \"Clockwise-ish\" } else { \"The other way\" };\n        let col = if self.flash_switch > 0.0 { CORAL } else { INK };\n        ui.panel(120.0, 240.0, 520.0, 76.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.label(380.0, 252.0, 46.0, col, Align::Center, if self.flash_switch > 0.0 { \"Switch!\" } else { dirs });\n        let on = self.rings.iter().filter(|x| x.on).count();\n        ui.panel(120.0, 340.0, 520.0, 76.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.label(380.0, 352.0, 46.0, INK, Align::Center, format!(\"{on} of {} rings\", r.spin.max_rings));\n        // Incoming rings.\n        for ring in &self.rings {\n            if !ring.on && ring.id.is_some() && ring.flying < 1.2 {\n                let x = if ring.side < 0.0 { 330.0 } else { 1590.0 };\n                let act = if ring.side < 0.0 { Act::StepL } else { Act::StepR };\n                ui.circle(x, 600.0, 70.0 + 50.0 * clamp01(ring.flying), with_alpha(SUN, 0.5), SUN, 8.0);\n                ui.prompt(x - 26.0, 600.0, act, \"\", Align::Left);\n            }\n        }\n        ui.prompt_row(&[(Act::Lean, \"Circle\"), (Act::StepL, \"Catch left\"), (Act::StepR, \"Catch right\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let phase = 7.5 * c.t * self.dir;\n        let mut it = Intent { lean: Vec2::new(phase.cos(), phase.sin()) * 0.85, ..Default::default() };\n        for ring in &self.rings {\n            if !ring.on && ring.id.is_some() && ring.flying.abs() < r.spin.catch_window * 0.5 {\n                if ring.side < 0.0 {\n                    it.l_just = true;\n                } else {\n                    it.r_just = true;\n                }\n            }\n        }\n        it\n    }\n}\nEOF\ncat > lap.rs <<'EOF'\n//! Morning Lap: one lap of the island. Alternate steps to set your pace, dodge, grab ribbons.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n/// A thing on the path.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Thing {\n    pub id: Option<EntityId>,\n    pub s: f32,\n    pub side: f32,\n    /// 0 ribbon, 1 crab, 2 sunbather, 3 towel.\n    pub kind: u8,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct MorningLap {\n    pub s: f32,\n    pub side: f32,\n    pub pace: f32,\n    pub last_step: f32,\n    pub foot: u8,\n    pub stitch: f32,\n    pub stumble: f32,\n    pub zone_time: f32,\n    pub ribbons: u32,\n    pub bumps: u32,\n    pub things: Vec<Thing>,\n    pub bounce: Option<EntityId>,\n    pub pacer_s: f32,\n    pub length: f32,\n    pub yaw: f32,\n    pub in_zone: bool,\n    pub flips: Vec<EntityId>,\n    pub center: Vec3,\n    pub next_step_at: f32,\n    pub finished: bool,\n}\n\n/// The ring path: a rounded loop around reception (a superellipse sampled by arc length).\npub fn path_point(center: Vec3, r: &Rules, a: f32) -> Vec3 {\n    let (s, c) = a.sin_cos();\n    let p = 2.0 / r.lap.path_power;\n    center + Vec3::new(c.signum() * c.abs().powf(p) * r.lap.path_rx, 0.0, s.signum() * s.abs().powf(p) * r.lap.path_rz)\n}\n\nimpl MorningLap {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Angle along the path for a distance `s`: the loop, walked by small steps.\n    fn at(&self, r: &Rules, s: f32) -> (Vec3, Vec3) {\n        let table = 720;\n        let mut prev = path_point(self.center, r, 0.0);\n        let mut d = 0.0;\n        for i in 1..=table {\n            let a = -i as f32 / table as f32 * std::f32::consts::TAU;\n            let q = path_point(self.center, r, a);\n            let seg = (q - prev).length();\n            if d + seg >= s {\n                let u = (s - d) / seg.max(1e-3);\n                return (prev.lerp(q, u), (q - prev).normalize_or(Vec3::Z));\n            }\n            d += seg;\n            prev = q;\n        }\n        (prev, Vec3::X)\n    }\n\n    fn total_length(&self, r: &Rules) -> f32 {\n        let table = 720;\n        let mut prev = path_point(self.center, r, 0.0);\n        let mut d = 0.0;\n        for i in 1..=table {\n            let a = -i as f32 / table as f32 * std::f32::consts::TAU;\n            let q = path_point(self.center, r, a);\n            d += (q - prev).length();\n            prev = q;\n        }\n        d\n    }\n\n    fn spot(&self, r: &Rules, s: f32, side: f32) -> Vec3 {\n        let (p, d) = self.at(r, s);\n        let right = Vec3::new(-d.z, 0.0, d.x);\n        p + right * side\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let rules = cx.rules;\n        self.center = cx.stage(Set::Hub);\n        self.length = self.total_length(rules);\n        let (p0, d0) = self.at(rules, 0.0);\n        ready_player(cx, Set::Hub, p0, d0.x.atan2(d0.z));\n        self.yaw = d0.x.atan2(-d0.z).to_degrees();\n        cam_full(cx.sim, 20.0, self.yaw, 9.0, 40.0, 1.0, 0.06, None);\n        self.bounce = npc(cx.sim, \"bounce_hub\");\n        self.pacer_s = 5.0;\n        // Ribbons and hazards, the same on a seed.\n        let mut s = 14.0;\n        let count = rules.lap.things as usize;\n        let step = (self.length - 24.0) / count as f32;\n        let mut n = 0;\n        while n < count {\n            let rng = &mut cx.sim.state.rng;\n            let kind = match n % 4 {\n                0 | 2 => 0u8,\n                1 => 1 + rng.below(3) as u8,\n                _ => 1 + rng.below(2) as u8,\n            };\n            let side = rng.range(-1.0, 1.0);\n            s += step;\n            let pos = self.spot(rules, s, side);\n            let (asset, scale): (&str, f32) = match kind {\n                0 => (\"LIB/core/ribbon\", 1.0),\n                1 => (\"LIB/core/crab\", 1.0),\n                2 => (\"LIB/core/lounge_chair\", 0.8),\n                _ => (\"LIB/core/towel_stack\", 1.0),\n            };\n            let id = spawn_prop(cx.sim, asset, pos, side * 3.0, scale);\n            self.things.push(Thing { id: Some(id), s, side, kind });\n            n += 1;\n        }\n        c.say_key(Who::Bounce, \"bounce.lap_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.lap;\n        let dt = cx.dt;\n        self.stumble = (self.stumble - dt).max(0.0);\n        c.step(cx, it.lean, 0.6, Vec2::ZERO, Vec2::ZERO);\n        if self.stumble <= 0.0 {\n            let foot = if it.l_just && it.r_just {\n                None\n            } else if it.l_just {\n                Some(0u8)\n            } else if it.r_just {\n                Some(1u8)\n            } else {\n                None\n            };\n            if let Some(f) = foot {\n                // The same foot twice counts for little.\n                let gap = (c.t - self.last_step).max(0.05);\n                self.last_step = c.t;\n                let now = 1.0 / gap;\n                let k = if f == self.foot { 0.1 } else { 0.45 };\n                self.pace += (now.min(6.0) - self.pace) * k;\n                self.foot = f;\n                cx.sfx(sound::STEP, 0.35, if f == 0 { 0.95 } else { 1.05 });\n            }\n        }\n        if c.t - self.last_step > r.step_timeout {\n            self.pace = (self.pace - dt * r.pace_decay).max(0.0);\n        }\n        self.in_zone = self.pace >= r.zone_lo && self.pace <= r.zone_hi;\n        if self.pace > r.zone_hi {\n            self.stitch += dt * r.stitch_rise;\n        } else {\n            self.stitch = (self.stitch - dt * r.stitch_fall).max(0.0);\n        }\n        if self.stitch >= 1.0 {\n            self.stitch = 0.3;\n            self.stumble = r.stumble;\n            self.pace *= 0.4;\n            cx.sfx(sound::STITCH, 0.8, 1.0);\n            gesture(cx.sim, cx.pid, \"FIT/Stumble\", false);\n            c.say_key(Who::Bounce, \"bounce.lap_stitch\", c.t as usize);\n        }\n        if self.in_zone {\n            self.zone_time += dt;\n        }\n        let speed = if self.stumble > 0.0 { 0.0 } else { self.pace * r.stride };\n        self.s += speed * dt;\n        // The path steers; lean moves you sideways a little.\n        let lean = c.core.cob.x;\n        self.side += (lean * r.side_reach - self.side) * (1.0 - (-r.side_rate * dt).exp());\n        let (p, d) = self.at(rules, self.s.min(self.length - 0.01));\n        let right = Vec3::new(-d.z, 0.0, d.x);\n        let feet = p + right * self.side;\n        place(cx.sim, cx.pid, feet, d.x.atan2(d.z));\n        let want = d.x.atan2(-d.z).to_degrees();\n        let mut dy = (want - self.yaw + 540.0).rem_euclid(360.0) - 180.0;\n        dy = dy.clamp(-90.0 * dt, 90.0 * dt) * 1.0 + dy * 0.02;\n        self.yaw = (self.yaw + dy + 540.0).rem_euclid(360.0) - 180.0;\n        // Jog scaled to speed.\n        let jog = (speed / 3.2).clamp(0.0, 1.6);\n        if speed > 0.05 && self.stumble <= 0.0 {\n            play_flags(cx.sim, cx.pid, \"MESH2MOTION/Jog\", 0, jog.max(0.2));\n        } else if self.stumble <= 0.0 {\n            stop_clip(cx.sim, cx.pid);\n        }\n        lean_figure(cx.sim, cx.pid, c.core.cob, self.yaw, 8.0, cx.slump);\n        // The pacer rolls ahead.\n        self.pacer_s += r.pacer_speed * dt;\n        if self.s + r.pacer_lead < self.pacer_s {\n            self.pacer_s = self.pacer_s.min(self.s + r.pacer_max_gap);\n        }\n        if let Some(bo) = self.bounce {\n            let (bp, bd) = self.at(rules, self.pacer_s.min(self.length - 0.01));\n            if let Some(e) = cx.sim.state.entities.get(bo) {\n                let _ = e;\n            }\n            place(cx.sim, bo, bp, bd.x.atan2(bd.z));\n        }\n        // Things on the path.\n        let at = self.s;\n        let side = self.side;\n        let mut got = Vec::new();\n        for (i, th) in self.things.iter().enumerate() {\n            if th.id.is_some() && (th.s - at).abs() < 0.7 && (th.side - side).abs() < if th.kind == 0 { 0.9 } else { 0.55 } {\n                got.push(i);\n            }\n        }\n        for i in got {\n            let kind = self.things[i].kind;\n            if let Some(id) = self.things[i].id.take() {\n                cx.sim.despawn(id);\n            }\n            if kind == 0 {\n                self.ribbons += 1;\n                cx.sfx(sound::RIBBON, 0.7, 1.0 + self.ribbons as f32 * 0.04);\n            } else {\n                self.bumps += 1;\n                self.pace *= 0.6;\n                c.stun = 0.5;\n                gesture(cx.sim, cx.pid, \"FIT/Stumble\", true);\n                cx.sfx(sound::BUMP, 0.7, 1.0);\n                c.say_key(Who::Bounce, \"bounce.lap_bump\", self.bumps as usize);\n            }\n        }\n        let n_ribbons = self.things.iter().filter(|t| t.kind == 0).count().max(1) as f32;\n        let par_time = self.length / (2.0 * r.stride);\n        let zone = clamp01(self.zone_time / par_time);\n        let rib = clamp01(self.ribbons as f32 / n_ribbons);\n        let bump = self.bumps as f32 * r.bump_cost;\n        c.score = clamp01(r.zone_weight * zone + (1.0 - r.zone_weight) * rib - bump) * 1000.0;\n        if self.s >= self.length - 0.5 && !self.finished {\n            self.finished = true;\n            cx.sfx(sound::FANFARE, 0.7, 1.0);\n            return Some(c.score);\n        }\n        (c.t >= r.max_time).then_some(c.score)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for th in self.things.drain(..) {\n            if let Some(id) = th.id {\n                cx.sim.despawn(id);\n            }\n        }\n        if let Some(bo) = self.bounce {\n            let at = cx.stage(Set::Hub) + Vec3::new(10.5, 0.0, 6.5);\n            place(cx.sim, bo, at, 0.0);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Morning Lap\", None);\n        // Progress along the lap.\n        ui.bar(560.0, 60.0, 800.0, 28.0, clamp01(self.s / self.length.max(1.0)), TEAL);\n        // Pace: the zone, and you.\n        let (x, y, w, h) = (160.0, 300.0, 90.0, 500.0);\n        ui.panel(x - 20.0, y - 20.0, w + 40.0, h + 40.0, with_alpha(WHITE, 0.9), 32.0);\n        let top = 4.0;\n        ui.panel(x, y + h * (1.0 - r.lap.zone_hi / top), w, h * (r.lap.zone_hi - r.lap.zone_lo) / top, MINT, 18.0);\n        ui.circle(x + w * 0.5, y + h * (1.0 - (self.pace / top).min(1.0)), 34.0, if self.in_zone { TEAL } else { CORAL }, WHITE, 5.0);\n        ui.text(x + w * 0.5, y + h + 30.0, 34.0, INK, Align::Center, \"Pace\");\n        ui.panel(1660.0, 300.0, 200.0, 170.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.text(1760.0, 312.0, 34.0, INK_SOFT, Align::Center, \"Ribbons\");\n        ui.label(1760.0, 360.0, 72.0, INK, Align::Center, format!(\"{}\", self.ribbons));\n        if self.stitch > 0.05 {\n            ui.panel(1660.0, 500.0, 200.0, 120.0, with_alpha(WHITE, 0.9), 30.0);\n            ui.text(1760.0, 510.0, 34.0, CORAL, Align::Center, \"Stitch\");\n            ui.bar(1680.0, 566.0, 160.0, 26.0, self.stitch, CORAL);\n        }\n        if c.t < 4.0 && self.pace < 0.5 {\n            ui.label(960.0, 430.0, 64.0, CORAL, Align::Center, \"Left, right, left, right\");\n        }\n        let mut p = c.puck(false);\n        p.r = 110.0;\n        p.c = [1700.0, 830.0];\n        p.band = Some(0.8);\n        ui.puck(p);\n        ui.prompt_row(&[(Act::StepL, \"Left\"), (Act::StepR, \"Right\"), (Act::Lean, \"Dodge\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        // Two steps a second, steering to ribbons and round everything else.\n        let mut it = Intent::default();\n        let period = 0.5;\n        let beat = (c.t / period).floor();\n        let prev = ((c.t - 1.0 / 60.0) / period).floor();\n        if beat != prev {\n            if self.foot == 0 {\n                it.r_just = true;\n            } else {\n                it.l_just = true;\n            }\n        }\n        let next = self.things.iter().find(|t| t.id.is_some() && t.s > self.s - 0.5 && t.s < self.s + 7.0);\n        let target = match next {\n            Some(t) if t.kind == 0 => t.side,\n            Some(t) => {\n                if t.side > 0.0 {\n                    t.side - 1.0\n                } else {\n                    t.side + 1.0\n                }\n            }\n            None => 0.0,\n        };\n        let lean_x = (target / r.lap.side_reach / r.core.reach).clamp(-1.0, 1.0);\n        it.lean = Vec2::new(lean_x, 0.0);\n        it\n    }\n}\nEOF\ncat > tide.rs <<'EOF'\n//! Tide Table: your lean tilts a floating raft; roll hermit crabs into tide pools.\n//! The shell physics is simple 2D code, not rapier: tunable and friendly to the bot.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Shell {\n    pub p: Vec2,\n    pub v: Vec2,\n    pub id: Option<EntityId>,\n    pub potted: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Pool {\n    pub p: Vec2,\n    pub r: f32,\n    pub id: Option<EntityId>,\n    /// Moving pools drift on this axis.\n    pub moves: Vec2,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct TideTable {\n    pub board: usize,\n    pub shells: Vec<Shell>,\n    pub pools: Vec<Pool>,\n    pub bumpers: Vec<(Vec2, EntityId)>,\n    pub potted: u32,\n    pub total: u32,\n    pub t_left: f32,\n    pub raft: Option<EntityId>,\n    pub center: Vec3,\n    pub edge: f32,\n    pub roll: f32,\n    pub skip_flash: f32,\n    pub done: bool,\n    pub gull: Option<EntityId>,\n    pub end_wait: f32,\n}\n\nfn to_world(center: Vec3, rot: Quat, p: Vec2, h: f32) -> Vec3 {\n    center + rot * Vec3::new(p.x, h, -p.y)\n}\n\nimpl TideTable {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    fn clear_board(&mut self, cx: &mut Cx) {\n        for s in self.shells.drain(..) {\n            if let Some(id) = s.id {\n                cx.sim.despawn(id);\n            }\n        }\n        for p in self.pools.drain(..) {\n            if let Some(id) = p.id {\n                cx.sim.despawn(id);\n            }\n        }\n        for (_, id) in self.bumpers.drain(..) {\n            cx.sim.despawn(id);\n        }\n    }\n\n    fn deal(&mut self, cx: &mut Cx) {\n        self.clear_board(cx);\n        let r = &cx.rules.tide;\n        let b = self.board;\n        let n = [3usize, 5, 7][b.min(2)];\n        self.edge = r.half;\n        let h = r.half;\n        let pools: &[(f32, f32)] = match b {\n            0 => &[(-0.55, 0.55), (0.6, -0.5)],\n            1 => &[(0.6, 0.55), (-0.6, -0.55)],\n            _ => &[(-0.65, 0.6), (0.65, 0.6), (0.0, -0.65)],\n        };\n        for (i, (x, y)) in pools.iter().enumerate() {\n            let p = Vec2::new(*x, *y) * h;\n            let id = spawn_prop(cx.sim, \"LIB/core/tide_pool\", self.center, 0.0, r.pool_r / 0.6);\n            let moves = if b == 1 && i == 0 { Vec2::new(0.0, -0.55 * h) } else { Vec2::ZERO };\n            self.pools.push(Pool { p, r: r.pool_r, id: Some(id), moves });\n        }\n        if b >= 2 {\n            for (x, y) in [(0.0, 0.3), (-0.45, -0.1), (0.45, -0.1)] {\n                let p = Vec2::new(x, y) * h;\n                let id = spawn_prop(cx.sim, \"LIB/core/bumper\", self.center, 0.0, 1.0);\n                self.bumpers.push((p, id));\n            }\n        }\n        for _ in 0..n {\n            let rng = &mut cx.sim.state.rng;\n            let mut p = Vec2::new(rng.range(-0.8, 0.8), rng.range(-0.8, 0.8)) * h;\n            if p.length() < 1.0 {\n                p = p.normalize_or(Vec2::X) * 1.4;\n            }\n            let colors = [\"#ffb88a\", \"#ffd166\", \"#ff9db0\", \"#c4b1e8\", \"#a8e0d0\"];\n            let col = colors[rng.below(5) as usize];\n            let id = spawn_prop_roles(cx.sim, \"LIB/core/shell\", self.center, 0.0, 1.0, &[(\"$accent\", col)]);\n            self.shells.push(Shell { p, v: Vec2::ZERO, id: Some(id), potted: false });\n        }\n        self.total += n as u32;\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        self.center = cx.stage(Set::Tide) + Vec3::Y * 0.2;\n        let at = self.center;\n        ready_player(cx, Set::Tide, at + Vec3::Y * 0.12, 0.0);\n        cam_full(cx.sim, 62.0, 0.0, 15.0, 40.0, 0.3, 0.2, None);\n        self.t_left = cx.rules.tide.length;\n        self.raft = Some(spawn_prop(cx.sim, \"LIB/core/tide_raft\", at, 0.0, cx.rules.tide.half / 4.0));\n        self.total = 0;\n        self.deal(cx);\n        self.gull = npc(cx.sim, \"gull_tide\");\n        c.say_key(Who::Gull, \"gull.tide_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let r = &cx.rules.tide;\n        let dt = cx.dt;\n        self.t_left -= dt;\n        self.skip_flash = (self.skip_flash - dt).max(0.0);\n        c.step(cx, it.lean, r.wobble, Vec2::ZERO, Vec2::ZERO);\n        if c.core.tipped {\n            c.tip_fx(cx, true);\n            c.core.settle();\n        }\n        let tilt = c.core.cob;\n        let rot = Quat::from_rotation_z(-tilt.x * r.tilt_deg.to_radians()) * Quat::from_rotation_x(-tilt.y * r.tilt_deg.to_radians());\n        if let Some(id) = self.raft {\n            pose(cx.sim, id, self.center, rot);\n        }\n        if self.board >= 2 {\n            self.edge = (self.edge - dt * r.tide_rise).max(r.half * 0.55);\n        }\n        let edge = self.edge;\n        let tt = c.t;\n        for pool in &mut self.pools {\n            let p = pool.p + pool.moves * (tt * 0.9).sin();\n            if let Some(id) = pool.id {\n                pose(cx.sim, id, to_world(self.center, rot, p, 0.2), rot);\n            }\n        }\n        let pools: Vec<(Vec2, f32)> = self.pools.iter().map(|p| (p.p + p.moves * (tt * 0.9).sin(), p.r)).collect();\n        let bumpers: Vec<Vec2> = self.bumpers.iter().map(|b| b.0).collect();\n        for (p, id) in &self.bumpers {\n            pose(cx.sim, *id, to_world(self.center, rot, *p, 0.2), rot);\n        }\n        let mut roll_speed = 0.0f32;\n        let mut plops = Vec::new();\n        for (i, s) in self.shells.iter_mut().enumerate() {\n            if s.potted {\n                continue;\n            }\n            let a = tilt * r.gravity - s.v * r.friction;\n            s.v += a * dt;\n            s.p += s.v * dt;\n            // Walls.\n            if s.p.x.abs() > edge {\n                s.p.x = s.p.x.clamp(-edge, edge);\n                s.v.x *= -r.wall_bounce;\n            }\n            if s.p.y.abs() > edge {\n                s.p.y = s.p.y.clamp(-edge, edge);\n                s.v.y *= -r.wall_bounce;\n            }\n            for b in &bumpers {\n                let d = s.p - *b;\n                if d.length() < r.bumper_r {\n                    let n = d.normalize_or(Vec2::Y);\n                    s.p = *b + n * r.bumper_r;\n                    s.v = (s.v - n * s.v.dot(n) * 1.8) * 1.05;\n                }\n            }\n            roll_speed = roll_speed.max(s.v.length());\n            for (pp, pr) in &pools {\n                if (s.p - *pp).length() < *pr {\n                    if s.v.length() < r.skip_speed {\n                        s.potted = true;\n                        plops.push(i);\n                    } else {\n                        self.skip_flash = 0.5;\n                    }\n                }\n            }\n            if let Some(id) = s.id {\n                let spin = Quat::from_rotation_y(s.v.x.atan2(s.v.y));\n                pose(cx.sim, id, to_world(self.center, rot, s.p, 0.3), rot * spin);\n            }\n        }\n        for i in plops {\n            if let Some(id) = self.shells[i].id.take() {\n                let at = pos_of(cx.sim, id);\n                cx.sim.despawn(id);\n                cx.ev.push(crate::frame::SimEvent::Splash { pos: at });\n            }\n            self.potted += 1;\n            cx.sfx(sound::SHELL_PLOP, 0.9, 1.0 + self.potted as f32 * 0.03);\n        }\n        self.roll += dt * roll_speed;\n        if self.roll > 0.6 {\n            self.roll = 0.0;\n            cx.sfx(sound::SHELL_ROLL, (roll_speed / 6.0).min(0.6), 1.0);\n        }\n        lean_figure(cx.sim, cx.pid, tilt, 0.0, r.tilt_deg + 8.0, cx.slump);\n        place_on_raft(cx, self.center, rot);\n        c.score = (self.potted as f32 * r.per_shell).min(r.shell_cap) + clamp01(self.t_left / r.length) * r.time_worth * if self.all_potted() { 1.0 } else { 0.0 };\n        // A board cleared: the next one.\n        if self.shells.iter().all(|s| s.potted) && !self.done {\n            if self.board >= 2 {\n                self.done = true;\n                self.end_wait = 1.0;\n            } else {\n                self.board += 1;\n                self.deal(cx);\n                cx.sfx(sound::FANFARE, 0.5, 1.2);\n                c.say_key(Who::Gull, \"gull.tide_board\", self.board);\n            }\n        }\n        if self.done {\n            self.end_wait -= dt;\n            return (self.end_wait <= 0.0).then(|| clamp01(c.score / 1000.0) * 1000.0);\n        }\n        (self.t_left <= 0.0).then(|| clamp01(c.score / 1000.0) * 1000.0)\n    }\n\n    fn all_potted(&self) -> bool {\n        self.board >= 2 && self.shells.iter().all(|s| s.potted)\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        self.clear_board(cx);\n        if let Some(id) = self.raft.take() {\n            cx.sim.despawn(id);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, _r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Tide Table\", Some(self.t_left));\n        let mut p = c.puck(false);\n        p.c = [1700.0, 830.0];\n        p.r = 150.0;\n        ui.puck(p);\n        ui.panel(40.0, 170.0, 340.0, 120.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.text(60.0, 180.0, 34.0, INK_SOFT, Align::Left, format!(\"Board {} of 3\", self.board + 1));\n        ui.label(60.0, 222.0, 44.0, INK, Align::Left, format!(\"{} shells in\", self.potted));\n        if self.skip_flash > 0.0 {\n            ui.label(960.0, 200.0, 64.0, CORAL, Align::Center, \"Too fast. It skipped.\");\n        }\n        ui.prompt_row(&[(Act::Lean, \"Tilt the raft\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        // Steer the shell nearest a pool toward that pool.\n        let t = r.tide.gravity;\n        let pools: Vec<Vec2> = self.pools.iter().map(|p| p.p + p.moves * (c.t * 0.9).sin()).collect();\n        let mut best: Option<(f32, Vec2, Vec2, Vec2)> = None;\n        for s in self.shells.iter().filter(|s| !s.potted) {\n            for pp in &pools {\n                let d = (*pp - s.p).length();\n                if best.is_none_or(|b| d < b.0) {\n                    best = Some((d, s.p, s.v, *pp));\n                }\n            }\n        }\n        let Some((_, p, v, goal)) = best else { return Intent::default() };\n        // Slow down near the pool: it skips when fast.\n        let want_v = ((goal - p) * 1.05).clamp_length_max(r.tide.skip_speed * 0.8);\n        let acc = (want_v - v) * 2.4 + v * r.tide.friction;\n        let lean = (acc / t).clamp_length_max(0.95);\n        Intent { lean, ..Default::default() }\n    }\n}\n\n/// The figure rides the raft's middle.\nfn place_on_raft(cx: &mut Cx, center: Vec3, rot: Quat) {\n    let up = rot * Vec3::Y;\n    let feet = center + up * 0.14;\n    let facing = cx.sim.state.entities.get(cx.pid).and_then(|e| e.character.as_ref()).map(|c| c.facing).unwrap_or(0.0);\n    place(cx.sim, cx.pid, feet, facing);\n}\nEOF\ncat > paddle.rs <<'EOF'\n//! Paddle Slalom: stand on a board, steer with your lean, pass the gates.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Gate {\n    pub z: f32,\n    pub x: f32,\n    pub passed: bool,\n    pub ids: Vec<EntityId>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct PaddleSlalom {\n    pub x: f32,\n    pub z: f32,\n    pub speed: f32,\n    pub yaw: f32,\n    pub gates: Vec<Gate>,\n    pub next: usize,\n    pub missed: u32,\n    pub penalty: f32,\n    pub remount: f32,\n    pub gust: Vec2,\n    pub gust_t: f32,\n    pub gust_in: f32,\n    pub streak_ids: Vec<EntityId>,\n    pub board: Option<EntityId>,\n    pub wake: f32,\n    pub start: Vec3,\n    pub done: f32,\n    pub final_time: f32,\n    pub tips: u32,\n}\n\nimpl PaddleSlalom {\n    pub fn new() -> Self {\n        Self { gust_in: 5.0, ..Default::default() }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let r = &cx.rules.paddle;\n        self.start = cx.stage(Set::Channel);\n        let at = self.start;\n        ready_player(cx, Set::Channel, at + Vec3::Y * 0.02, std::f32::consts::PI);\n        cam_full(cx.sim, 22.0, 0.0, 10.0, 40.0, 0.9, 0.1, None);\n        self.board = Some(spawn_prop(cx.sim, \"LIB/core/paddleboard\", at, 0.0, 1.0));\n        let n = r.gates as usize;\n        for i in 0..n {\n            let z = (i as f32 + 1.0) / (n as f32 + 0.6) * r.length;\n            let rng = &mut cx.sim.state.rng;\n            let x = rng.range(-r.gate_x, r.gate_x);\n            let mut ids = Vec::new();\n            for side in [-1.0, 1.0] {\n                let p = at + Vec3::new(x + side * r.gate_width * 0.5, 0.0, -z);\n                ids.push(spawn_prop(cx.sim, \"LIB/core/buoy\", p, 0.0, 1.0));\n            }\n            self.gates.push(Gate { z, x, passed: false, ids });\n        }\n        c.say_key(Who::Gull, \"gull.paddle_start\", 0);\n    }\n\n    fn par(&self, r: &Rules) -> f32 {\n        r.paddle.par\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.paddle;\n        let dt = cx.dt;\n        if self.done > 0.0 {\n            self.done -= dt;\n            let par = self.par(rules);\n            let score = clamp01((1.6 * par - self.final_time) / (0.8 * par)) * 1000.0;\n            c.score = score;\n            return (self.done <= 0.0).then_some(score);\n        }\n        // Gusts, shown as ripple streaks, push the dot.\n        self.gust_in -= dt;\n        if self.gust_in <= 0.0 {\n            self.gust_in = cx.sim.state.rng.range(r.gust_every * 0.7, r.gust_every * 1.3);\n            let side = if cx.sim.state.rng.f32() < 0.5 { -1.0 } else { 1.0 };\n            self.gust = Vec2::new(side, 0.25) * r.gust;\n            self.gust_t = 1.3;\n            cx.sfx(sound::GUST, 0.7, 1.0);\n            let at = self.start + Vec3::new(self.x - side * 3.0, 0.0, -self.z - 8.0);\n            for i in 0..5 {\n                let p = at + Vec3::new(side * i as f32 * 0.6, 0.02, i as f32 * 0.7 - 2.0);\n                let id = spawn_box(cx.sim, \"ripple\", p, Vec3::new(1.3, 0.01, 0.06), \"#f4fbfb\");\n                self.streak_ids.push(id);\n            }\n        }\n        if self.gust_t > 0.0 {\n            self.gust_t -= dt;\n            let side = self.gust.x.signum();\n            for id in self.streak_ids.clone() {\n                let p = pos_of(cx.sim, id) + Vec3::new(side * 6.0 * dt, 0.0, 0.0);\n                move_to(cx.sim, id, p);\n            }\n        } else {\n            self.gust = Vec2::ZERO;\n            despawn_all(cx.sim, &mut self.streak_ids);\n        }\n        if self.remount > 0.0 {\n            self.remount -= dt;\n            self.speed = 0.0;\n            if self.remount <= 0.0 {\n                c.core.settle();\n                cx.sfx(sound::BOARD, 0.7, 1.0);\n            }\n        } else {\n            let lean_fwd = c.core.cob.y;\n            c.step(cx, it.lean, r.wobble * (1.0 + self.speed / 16.0), self.gust, Vec2::ZERO);\n            if c.core.tipped {\n                self.remount = r.remount;\n                self.tips += 1;\n                c.tip_fx(cx, true);\n                c.say_key(Who::Gull, \"gull.paddle_tip\", self.tips as usize);\n            }\n            let want = if lean_fwd > 0.0 { r.base_speed + r.fwd_speed * lean_fwd } else { (r.base_speed + r.brake * lean_fwd).max(0.3) };\n            self.speed += (want - self.speed) * (1.0 - (-r.accel * dt).exp());\n            let steer = c.core.cob.x * r.steer;\n            self.x = (self.x + steer * dt).clamp(-r.half_width, r.half_width);\n            self.yaw += (-steer * 0.06 - self.yaw) * (1.0 - (-5.0 * dt).exp());\n            self.z += self.speed * dt;\n        }\n        let at = self.start + Vec3::new(self.x, 0.02, -self.z);\n        let facing = std::f32::consts::PI + self.yaw;\n        if self.remount <= 0.0 {\n            place(cx.sim, cx.pid, at, facing);\n        } else {\n            // In the water, then climbing back on.\n            let u = self.remount / r.remount;\n            place(cx.sim, cx.pid, at - Vec3::Y * (0.9 * (u * 3.14).sin()), facing);\n        }\n        if let Some(b) = self.board {\n            let roll = c.core.cob.x * 0.14 * if self.remount > 0.0 { 3.0 } else { 1.0 };\n            pose(cx.sim, b, self.start + Vec3::new(self.x, -0.02, -self.z), Quat::from_rotation_y(self.yaw) * Quat::from_rotation_z(-roll));\n        }\n        if self.remount <= 0.0 {\n            lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, rules.core.tilt_deg, cx.slump);\n            play(cx.sim, cx.pid, \"FIT/Paddle\");\n        }\n        self.wake -= dt * self.speed.max(0.0);\n        if self.wake <= 0.0 {\n            self.wake = 0.7;\n            cx.ev.push(crate::frame::SimEvent::Wake { pos: at + Vec3::Z * 1.4 });\n        }\n        // Gates.\n        while let Some(g) = self.gates.get_mut(self.next) {\n            if self.z < g.z {\n                break;\n            }\n            let ok = (self.x - g.x).abs() < r.gate_width * 0.5;\n            g.passed = ok;\n            if ok {\n                cx.ev.push(crate::frame::SimEvent::Gate { pos: at, ok: true });\n            } else {\n                self.missed += 1;\n                self.penalty += r.miss_penalty;\n                cx.ev.push(crate::frame::SimEvent::Gate { pos: at, ok: false });\n                c.say_key(Who::Gull, \"gull.paddle_miss\", self.missed as usize);\n            }\n            self.next += 1;\n        }\n        let t = c.t + self.penalty;\n        let par = self.par(rules);\n        c.score = clamp01((1.6 * par - t) / (0.8 * par)) * 1000.0;\n        if self.z >= r.length || c.t >= r.max_time {\n            self.final_time = t;\n            self.done = 1.2;\n            cx.sfx(sound::FANFARE, 0.6, 1.0);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for g in self.gates.drain(..) {\n            for id in g.ids {\n                cx.sim.despawn(id);\n            }\n        }\n        despawn_all(cx.sim, &mut self.streak_ids);\n        if let Some(b) = self.board.take() {\n            cx.sim.despawn(b);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Paddle Slalom\", None);\n        ui.bar(560.0, 60.0, 800.0, 28.0, clamp01(self.z / r.paddle.length), TEAL);\n        let mut p = c.puck(false);\n        p.c = [1700.0, 830.0];\n        p.r = 150.0;\n        ui.puck(p);\n        ui.panel(40.0, 170.0, 380.0, 120.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.text(60.0, 180.0, 34.0, INK_SOFT, Align::Left, format!(\"{:.1} m/s\", self.speed));\n        ui.label(60.0, 222.0, 44.0, INK, Align::Left, format!(\"{:.1} s, {} missed\", c.t + self.penalty, self.missed));\n        if self.gust_t > 0.0 {\n            ui.label(960.0, 200.0, 64.0, CORAL, Align::Center, \"Gust!\");\n        }\n        if self.remount > 0.0 {\n            ui.label(960.0, 200.0, 64.0, CORAL, Align::Center, \"Remounting with dignity\");\n        }\n        ui.prompt_row(&[(Act::Lean, \"Steer, lean forward to go\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let target = self.gates.get(self.next).map(|g| g.x).unwrap_or(0.0);\n        let err = target - self.x;\n        // Lean forward 0.5 and steer to the gate's centre, against the wind.\n        let x = (err * 0.55 - self.gust.x / r.core.stiffness).clamp(-0.6, 0.6);\n        Intent { lean: Vec2::new(x, 0.5).clamp_length_max(0.85), ..Default::default() }\n    }\n}\nEOF\ncat > tray.rs <<'EOF'\n//! Tray Trek: walk a long pier with a stack of smoothies. Your dot tilts the tray.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Glass {\n    pub p: Vec2,\n    pub v: Vec2,\n    pub id: Option<EntityId>,\n    pub falling: f32,\n    pub lost: bool,\n    pub h: f32,\n    pub grip: f32,\n}\n\n/// A jolt to come, and what it is.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Jolt {\n    pub z: f32,\n    pub dir: Vec2,\n    /// 0 wave, 1 plank gap, 2 gull.\n    pub kind: u8,\n    pub warned: bool,\n    pub ent: Option<EntityId>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct TrayTrek {\n    pub z: f32,\n    pub glasses: Vec<Glass>,\n    pub jolts: Vec<Jolt>,\n    pub next: usize,\n    pub tray: Option<EntityId>,\n    pub start: Vec3,\n    pub warn: f32,\n    pub warn_word: String,\n    pub spilled: u32,\n    pub finish: f32,\n    pub marjorie: Option<EntityId>,\n    pub said: bool,\n    pub stepz: f32,\n}\n\nimpl TrayTrek {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let r = &cx.rules.tray;\n        self.start = cx.stage(Set::Pier);\n        let at = self.start;\n        ready_player(cx, Set::Pier, at, std::f32::consts::PI);\n        cam_full(cx.sim, 24.0, 0.0, 8.5, 40.0, 1.2, 0.08, None);\n        self.tray = Some(spawn_prop(cx.sim, \"LIB/core/tray\", at + Vec3::Y * 1.3, 0.0, 1.0));\n        let spots = [(0.0, 0.0), (-0.16, 0.1), (0.16, 0.1), (-0.08, -0.14), (0.1, -0.13)];\n        let cols = [\"#ff9db0\", \"#ffd166\", \"#78dcaa\", \"#c4b1e8\", \"#ffb88a\"];\n        for (i, (x, y)) in spots.iter().enumerate() {\n            let id = spawn_prop_roles(cx.sim, \"LIB/core/smoothie\", at + Vec3::Y * 1.4, 0.0, 1.0, &[(\"$accent\", cols[i])]);\n            let grip = 0.9 + i as f32 * 0.05;\n            self.glasses.push(Glass { p: Vec2::new(*x, *y), id: Some(id), h: if i == 0 { 0.2 } else { 0.0 }, grip, ..Default::default() });\n        }\n        // The jolts: the same on a seed.\n        let n = r.jolts as usize;\n        for i in 0..n {\n            let rng = &mut cx.sim.state.rng;\n            let z = 10.0 + (i as f32 + rng.range(0.0, 0.5)) / n as f32 * (r.length - 16.0);\n            let kind = rng.below(3) as u8;\n            let a = if rng.f32() < 0.5 { 0.0f32 } else { std::f32::consts::PI } + rng.range(-0.9, 0.9);\n            let mut jolt = Jolt { z, dir: Vec2::new(a.cos(), a.sin()), kind, warned: false, ent: None };\n            if kind == 1 {\n                let p = at + Vec3::new(0.0, 0.01, -z);\n                jolt.ent = Some(spawn_box(cx.sim, \"gap\", p, Vec3::new(1.6, 0.012, 0.35), \"#35586a\"));\n            }\n            self.jolts.push(jolt);\n        }\n        self.marjorie = npc(cx.sim, \"marjorie_pier\");\n        c.say_key(Who::Gull, \"gull.tray_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.tray;\n        let dt = cx.dt;\n        if self.finish > 0.0 {\n            self.finish -= dt;\n            return (self.finish <= 0.0).then(|| c.score);\n        }\n        self.z += r.pace * dt;\n        let mut nudge = Vec2::ZERO;\n        let mut kick = Vec2::ZERO;\n        self.warn = (self.warn - dt).max(0.0);\n        if let Some(j) = self.jolts.get_mut(self.next) {\n            if !j.warned && j.z - self.z < r.pace * r.warning {\n                j.warned = true;\n                self.warn = r.warning;\n                self.warn_word = [\"Wave!\", \"Plank gap!\", \"Gull!\"][j.kind as usize].to_string();\n                if j.kind == 2 {\n                    let p = self.start + Vec3::new(-j.dir.x * 12.0, 3.0, -self.z);\n                    j.ent = Some(spawn_prop(cx.sim, \"LIB/core/gull\", p, 0.0, 1.2));\n                    cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::GULL, gain: 0.9, pitch: 1.0 });\n                } else if j.kind == 0 {\n                    cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::WAVE, gain: 0.7, pitch: 1.0 });\n                }\n            }\n            if self.z >= j.z {\n                nudge = j.dir * r.jolt_nudge;\n                kick = j.dir * r.jolt_kick;\n                let at = self.start + Vec3::new(j.dir.x * 3.0, 0.0, -self.z);\n                match j.kind {\n                    0 => cx.ev.push(crate::frame::SimEvent::BigSplash { pos: at, size: 0.6 }),\n                    1 => cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::CREAK, gain: 1.0, pitch: 0.8 }),\n                    _ => cx.ev.push(crate::frame::SimEvent::Sfx { id: sound::GULL, gain: 1.0, pitch: 1.3 }),\n                }\n                self.next += 1;\n            }\n        }\n        // A swooping gull crosses over.\n        for j in &mut self.jolts {\n            if j.kind == 2 {\n                if let Some(id) = j.ent {\n                    let u = (self.z - j.z) / (r.pace * 1.6);\n                    let p = self.start + Vec3::new(j.dir.x * 12.0 * u, 1.8 + 1.8 * u.abs(), -self.z + 1.0);\n                    move_to(cx.sim, id, p);\n                    if u > 1.2 {\n                        cx.sim.despawn(id);\n                        j.ent = None;\n                    }\n                }\n            }\n        }\n        c.step(cx, it.lean, r.wobble, Vec2::ZERO, nudge);\n        if c.core.tipped {\n            c.tip_fx(cx, false);\n            kick += c.core.cob * 0.6;\n            c.core.settle();\n        }\n        let tilt = c.core.cob;\n        let feet = self.start + Vec3::new(0.0, 0.0, -self.z);\n        place(cx.sim, cx.pid, feet, std::f32::consts::PI);\n        // Hands forward: the tray rides above them.\n        let at = feet + Vec3::new(0.0, 1.32, -0.42);\n        let rot = Quat::from_rotation_z(-tilt.x * r.tilt_deg.to_radians()) * Quat::from_rotation_x(-tilt.y * r.tilt_deg.to_radians());\n        if let Some(t) = self.tray {\n            pose(cx.sim, t, at, rot);\n        }\n        let mut plops = 0;\n        for g in &mut self.glasses {\n            if g.lost {\n                continue;\n            }\n            if g.falling > 0.0 {\n                g.falling -= dt;\n                if let Some(id) = g.id {\n                    let p = pos_of(cx.sim, id);\n                    let v = Vec3::new(g.v.x, -(0.6 - g.falling) * 9.0, -g.v.y);\n                    move_to(cx.sim, id, p + v * dt);\n                    if g.falling <= 0.0 {\n                        cx.sim.despawn(id);\n                        g.id = None;\n                        g.lost = true;\n                    }\n                }\n                continue;\n            }\n            // Glasses slide with tilt; a jolt kicks them.\n            let a = tilt * r.slide * g.grip - g.v * r.friction;\n            g.v += a * dt + kick * g.grip;\n            g.p += g.v * dt;\n            if g.p.length() > r.edge {\n                g.falling = 0.6;\n                self.spilled += 1;\n                plops += 1;\n            }\n            if let Some(id) = g.id {\n                pose(cx.sim, id, at + rot * Vec3::new(g.p.x, 0.05 + g.h, -g.p.y), rot);\n            }\n        }\n        for _ in 0..plops {\n            cx.sfx(sound::GLASS_PLOP, 0.9, 1.0);\n            c.say_key(Who::Gull, \"gull.tray_spill\", self.spilled as usize);\n        }\n        // The walk: Balance_Walk under, the carry on top.\n        play_flags(cx.sim, cx.pid, \"FIT/TrayWalk\", 0, 1.0);\n        lean_figure(cx.sim, cx.pid, tilt, 0.0, rules.core.tilt_deg * 0.6, cx.slump);\n        self.stepz += r.pace * dt;\n        if self.stepz > 0.8 {\n            self.stepz = 0.0;\n            cx.sfx(sound::STEP, 0.3, 1.0);\n        }\n        let left = self.glasses.iter().filter(|g| !g.lost && g.falling <= 0.0).count() as f32;\n        c.score = clamp01((left * r.per_glass + if self.spilled == 0 { r.bonus } else { 0.0 }) / 1000.0) * 1000.0;\n        if self.z >= r.length {\n            let mar = (left as usize).min(5);\n            c.say_key(Who::Marjorie, \"marjorie.tray\", mar);\n            self.finish = 3.0;\n            cx.sfx(sound::FANFARE, 0.6, 1.0);\n            stop_clip(cx.sim, cx.pid);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        for g in self.glasses.drain(..) {\n            if let Some(id) = g.id {\n                cx.sim.despawn(id);\n            }\n        }\n        for j in self.jolts.drain(..) {\n            if let Some(id) = j.ent {\n                cx.sim.despawn(id);\n            }\n        }\n        if let Some(t) = self.tray.take() {\n            cx.sim.despawn(t);\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Tray Trek\", None);\n        ui.bar(560.0, 60.0, 800.0, 28.0, clamp01(self.z / r.tray.length), TEAL);\n        ui.puck({\n            let mut p = c.puck(false);\n            p.c = [1700.0, 830.0];\n            p.r = 150.0;\n            p\n        });\n        // The tray from above, with its glasses.\n        let (cx, cy, rr) = (220.0, 830.0, 150.0);\n        ui.circle(cx, cy, rr, with_alpha(WHITE, 0.92), INK_SOFT, 6.0);\n        for g in &self.glasses {\n            if g.lost || g.falling > 0.0 {\n                continue;\n            }\n            let k = rr / r.tray.edge;\n            ui.circle(cx + g.p.x * k, cy - g.p.y * k, 26.0, CORAL, WHITE, 4.0);\n        }\n        if self.warn > 0.0 {\n            ui.label(960.0, 200.0, 72.0, CORAL, Align::Center, self.warn_word.clone());\n        }\n        ui.prompt_row(&[(Act::Lean, \"Tilt the tray, keep the glasses on\")]);\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        // Counter the jolts it knows are coming, and bring the stack back to the middle.\n        let live: Vec<&Glass> = self.glasses.iter().filter(|g| !g.lost && g.falling <= 0.0).collect();\n        let mut sum = Vec2::ZERO;\n        let mut vel = Vec2::ZERO;\n        let mut far = Vec2::ZERO;\n        let mut far_d = 0.0;\n        for g in &live {\n            sum += g.p;\n            vel += g.v;\n            if g.p.length() > far_d {\n                far_d = g.p.length();\n                far = g.p;\n            }\n        }\n        let n = live.len().max(1) as f32;\n        let target = -(sum / n) * 1.8 - (vel / n) * 1.6 - far * 0.8;\n        let mut lean = target * r.tray.friction.max(0.5);\n        if let Some(j) = self.jolts.get(self.next) {\n            if j.z - self.z < r.tray.pace * 0.25 {\n                lean -= j.dir * 0.2;\n            }\n        }\n        let _ = c;\n        Intent { lean: lean.clamp_length_max(0.9), ..Default::default() }\n    }\n}\nEOF\ncat > dive.rs <<'EOF'\n//! Cannonball Cup: bounce, leap, tuck. We are not here for form. We are here for splash.\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::*;\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum DivePhase {\n    #[default]\n    Bounce,\n    Air,\n    Splash,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct CannonballCup {\n    pub dive: usize,\n    pub phase: DivePhase,\n    pub pt: f32,\n    pub presses: u32,\n    pub power: f32,\n    pub pressed_now: bool,\n    pub timing: f32,\n    pub tuck: f32,\n    pub spin: f32,\n    pub spin_v: f32,\n    pub pos: Vec3,\n    pub vel: Vec3,\n    pub apex: f32,\n    pub entry_tuck: f32,\n    pub scores: Vec<f32>,\n    pub last_score: f32,\n    pub cards: Vec<String>,\n    pub board: Option<EntityId>,\n    pub tip: Vec3,\n    pub water: f32,\n    pub judges: Vec<EntityId>,\n    pub said: bool,\n}\n\nimpl CannonballCup {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Time to the next bottom of the bounce.\n    fn to_bottom(&self, r: &Rules) -> f32 {\n        let p = r.dive.period;\n        let u = (self.pt / p).fract();\n        // The bottom comes at phase 0.75 of a sine.\n        let d = (0.75 - u).rem_euclid(1.0);\n        d.min(1.0 - d) * p * if d < 0.5 { 1.0 } else { -1.0 }\n    }\n\n    fn reset_dive(&mut self, cx: &mut Cx) {\n        self.phase = DivePhase::Bounce;\n        self.pt = 0.0;\n        self.presses = 0;\n        self.power = 0.0;\n        self.timing = 0.0;\n        self.tuck = 0.0;\n        self.spin = 0.0;\n        self.spin_v = 0.0;\n        self.apex = 0.0;\n        self.cards.clear();\n        self.said = false;\n        place(cx.sim, cx.pid, self.tip, 0.0);\n        stop_clip(cx.sim, cx.pid);\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Tower);\n        self.tip = at + Vec3::new(0.0, cx.rules.dive.tower, 0.0);\n        self.water = at.y;\n        ready_player(cx, Set::Tower, self.tip, 0.0);\n        cam_full(cx.sim, 6.0, 90.0, 14.0, 42.0, 0.0, 0.06, None);\n        self.board = Some(spawn_prop(cx.sim, \"LIB/core/diving_board\", self.tip, 0.0, 1.0));\n        self.judges = [\"judge1\", \"judge2\", \"judge3\"].iter().filter_map(|n| npc(cx.sim, n)).collect();\n        self.reset_dive(cx);\n        c.say_key(Who::Gull, \"gull.dive_start\", 0);\n    }\n\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let rules = cx.rules;\n        let r = &rules.dive;\n        let dt = cx.dt;\n        self.pt += dt;\n        c.step(cx, it.lean, 0.5, Vec2::ZERO, Vec2::ZERO);\n        match self.phase {\n            DivePhase::Bounce => {\n                let w = std::f32::consts::TAU / r.period;\n                let amp = r.bounce_amp * (1.0 + self.presses as f32 * 0.5);\n                let bob = (self.pt * w).sin() * amp;\n                let feet = self.tip + Vec3::Y * (bob.max(-amp * 0.35));\n                place(cx.sim, cx.pid, feet, 0.0);\n                if let Some(b) = self.board {\n                    let bend = (-bob / amp.max(0.01)).max(-0.4) * 0.06 * (1.0 + self.presses as f32 * 0.3);\n                    pose(cx.sim, b, self.tip - Vec3::Y * bend.max(0.0) * 1.2, Quat::from_rotation_x(bend));\n                }\n                lean_figure(cx.sim, cx.pid, c.core.cob * 0.3, 90.0, 10.0, cx.slump);\n                if it.act_just {\n                    let off = self.to_bottom(rules).abs();\n                    let good = 1.0 - clamp01(off / r.press_window);\n                    self.timing += good;\n                    self.presses += 1;\n                    cx.sfx(sound::BOARD, 0.4 + 0.2 * self.presses as f32, 0.8 + 0.15 * self.presses as f32);\n                    if self.presses >= 4 {\n                        self.power = self.timing / 4.0;\n                        self.phase = DivePhase::Air;\n                        self.pt = 0.0;\n                        self.pos = feet;\n                        let v = r.leap_base + r.leap_power * self.power;\n                        self.vel = Vec3::new(0.0, v, r.forward);\n                        self.apex = feet.y;\n                        cx.ev.push(crate::frame::SimEvent::Jump { pos: feet });\n                        cx.sfx(sound::WHOOSH, 0.8, 1.0);\n                    }\n                }\n                if self.pt > r.board_timeout {\n                    // Nobody jumped: the board does it for you.\n                    self.power = self.timing / 4.0 * 0.3;\n                    self.phase = DivePhase::Air;\n                    self.pt = 0.0;\n                    self.pos = feet;\n                    self.vel = Vec3::new(0.0, 1.0, 1.4);\n                    self.apex = feet.y;\n                    c.say_key(Who::Gull, \"gull.dive_push\", self.dive);\n                }\n            }\n            DivePhase::Air => {\n                self.vel.y -= r.gravity * dt;\n                self.pos += self.vel * dt;\n                self.apex = self.apex.max(self.pos.y);\n                let want = if it.act { 1.0 } else { 0.0 };\n                self.tuck += (want - self.tuck) * (1.0 - (-r.tuck_rate * dt).exp());\n                self.spin_v = c.core.cob.y * r.spin_lean + self.tuck * r.spin_tuck;\n                self.spin += self.spin_v * dt;\n                place(cx.sim, cx.pid, self.pos, 0.0);\n                scrub(cx.sim, cx.pid, \"FIT/Tuck\", self.tuck);\n                if let Some(a) = anim_of(cx.sim, cx.pid) {\n                    a.tilt_side = 0.0;\n                    a.tilt_fwd = self.spin;\n                }\n                if self.pos.y <= self.water + 0.1 {\n                    self.entry_tuck = self.tuck;\n                    let h = clamp01((self.apex - self.water) / r.height_par);\n                    let tuck = r.flop_tuck + (1.0 - r.flop_tuck) * self.entry_tuck;\n                    let timing = 0.3 + 0.7 * self.power;\n                    let score = clamp01(h * tuck * timing / r.par) * 1000.0;\n                    self.last_score = score;\n                    self.scores.push(score);\n                    self.phase = DivePhase::Splash;\n                    self.pt = 0.0;\n                    let size = 0.5 + 2.2 * score / 1000.0;\n                    cx.ev.push(crate::frame::SimEvent::BigSplash { pos: self.pos, size });\n                    cx.sfx(sound::SPLASH_B, 1.0, 1.0 - 0.3 * score / 1000.0);\n                    // The cards.\n                    let rng = &mut cx.sim.state.rng;\n                    let v = score / 100.0;\n                    self.cards = (0..3)\n                        .map(|_| {\n                            if rng.f32() < 0.12 {\n                                \"See me\".to_string()\n                            } else {\n                                format!(\"{:.1}\", ((v + rng.range(-0.8, 0.8)) * 2.0).round().clamp(0.0, 20.0) / 2.0)\n                            }\n                        })\n                        .collect();\n                    c.score = self.scores.iter().sum::<f32>() / 3.0;\n                    c.say_key(Who::Gull, \"gull.dive_after\", self.dive + (score / 200.0) as usize);\n                }\n            }\n            DivePhase::Splash => {\n                // The figure bobs up, then it is the next dive.\n                let up = self.water - 1.1 + clamp01(self.pt / 1.2) * 0.45;\n                place(cx.sim, cx.pid, Vec3::new(self.pos.x, up, self.pos.z), 0.0);\n                if let Some(a) = anim_of(cx.sim, cx.pid) {\n                    a.tilt_fwd = 0.0;\n                }\n                play(cx.sim, cx.pid, \"FIT/Tread\");\n                if self.pt < 0.2 {\n                    for &j in &self.judges {\n                        gesture(cx.sim, j, \"CMU/Wave_Hello\", true);\n                    }\n                }\n                if self.pt >= r.splash_time {\n                    self.dive += 1;\n                    if self.dive >= 3 {\n                        return Some(c.score);\n                    }\n                    self.reset_dive(cx);\n                }\n            }\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(b) = self.board.take() {\n            cx.sim.despawn(b);\n        }\n        if let Some(a) = anim_of(cx.sim, cx.pid) {\n            a.tilt_fwd = 0.0;\n        }\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        c.top_bar(ui, \"Cannonball Cup\", None);\n        ui.panel(40.0, 170.0, 380.0, 76.0, with_alpha(WHITE, 0.9), 30.0);\n        ui.label(60.0, 182.0, 44.0, INK, Align::Left, format!(\"Dive {} of 3\", (self.dive + 1).min(3)));\n        match self.phase {\n            DivePhase::Bounce => {\n                // Bounce meter: press when the bar is at the bottom.\n                let off = self.to_bottom(r);\n                let near = 1.0 - clamp01(off.abs() / (r.dive.period * 0.5));\n                let (x, y) = (820.0, 830.0);\n                ui.panel(x, y, 280.0, 60.0, with_alpha(WHITE, 0.9), 30.0);\n                ui.panel(x + 8.0, y + 8.0, (280.0 - 16.0) * near, 44.0, if near > 0.75 { MINT } else { SEA }, 22.0);\n                for i in 0..4 {\n                    let col = if (i as u32) < self.presses { CORAL } else { with_alpha(WHITE, 0.9) };\n                    ui.circle(816.0 + i as f32 * 96.0, 780.0, 30.0, col, INK_SOFT, 4.0);\n                }\n                let label = if self.presses >= 3 { \"Leap at the bottom\" } else { \"Press at the bottom\" };\n                ui.prompt_row(&[(Act::Confirm, label)]);\n            }\n            DivePhase::Air => {\n                ui.label(960.0, 180.0, 72.0, if self.tuck > 0.6 { TEAL } else { CORAL }, Align::Center, if self.tuck > 0.6 { \"Tucked\" } else { \"Tuck!\" });\n                ui.prompt_row(&[(Act::Confirm, \"Hold to tuck\"), (Act::Lean, \"Rotate\")]);\n            }\n            DivePhase::Splash => {\n                for (i, card) in self.cards.iter().enumerate() {\n                    let x = 560.0 + i as f32 * 400.0;\n                    ui.card(x - 170.0, 300.0, 340.0, 210.0);\n                    ui.title(x, 350.0, if card.len() > 4 { 64.0 } else { 96.0 }, INK, Align::Center, card.clone());\n                }\n                ui.label(960.0, 560.0, 72.0, TEAL, Align::Center, format!(\"{:.0} splash\", self.last_score));\n            }\n        }\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        let mut it = Intent::default();\n        match self.phase {\n            DivePhase::Bounce => {\n                // Presses on bottoms.\n                let off = self.to_bottom(r);\n                let dt = 1.0 / 60.0;\n                if off.abs() < dt * 0.6 && self.pt > 0.3 {\n                    it.act_just = true;\n                    it.act = true;\n                }\n            }\n            DivePhase::Air => {\n                // Tucks at the apex.\n                if self.vel.y < 1.0 {\n                    it.act = true;\n                }\n                it.lean = Vec2::new(0.0, 0.15);\n            }\n            DivePhase::Splash => {}\n        }\n        let _ = c;\n        it\n    }\n}\nEOF\necho ok","description":"Write remaining seven event modules"}}}
