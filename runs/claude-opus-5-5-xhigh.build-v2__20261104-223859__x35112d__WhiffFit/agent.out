t()[:16] == (dev/'notes/.audit/page.sha').read_text().strip(), 'page changed since the tests')\nd = json.loads(ex.read_text(encoding='utf-8'))\nneed(list(d) == ['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'], f'interview keys {list(d)}')\nneed(d['sourceInformation']['usage'] == 'added on import', 'usage')\nm = re.search(r'<script id=\"about-data\" type=\"application/json\">(.*?)</script>', page, re.S)\nneed(m is not None, 'no about-data')\nif m:\n    a = json.loads(m.group(1).replace('<\\\\/', '</'))\n    for k in ('sourceInformation','testingFeedback','engineFeedback','promptFeedback'):\n        need(a.get(k) == d[k], f'About differs from the interview at {k}')\n    need(a.get('credits') == (dev/'notes/credits.txt').read_text(encoding='utf-8').strip(), 'credits')\nneed(re.search(r'<title>Whiff Fit — A balance comedy at Tippy Cay</title>', page) is not None, 'title')\nneed(f'<script>{(dev/\"hub/session.js\").read_text(encoding=\"utf-8\")}</script>' in page, 'client not byte for byte')\nfor t in ['session\" content=\"1\"','session-players\" content=\"1-4\"','session-mode\" content=\"ghost\"','session-minutes\" content=\"3\"','webgpu\" content=\"required\"']:\n    need(t in page, t)\next = [u for u in re.findall(r'(?:src|href)=\"(https?://[^\"]+)\"', page[:page.find('</head>')]) ]\nneed(not ext, f'external refs {ext[:3]}')\nbad = []\nfor f in list((dev/'engine/crates/pav_core/src/games/fit').rglob('*')) + list((dev/'tests').glob('*')) + list((dev/'tools').glob('*')):\n    if f.is_file() and f.suffix in ('.rs','.toml','.py','.sh'):\n        t = f.read_text(errors='ignore')\n        if re.search(r'\\b(TODO|FIXME|XXX|unimplemented!|todo!)', t): bad.append(f.name)\nneed(not bad, f'stubs in {bad}')\nfor f in ['intent.rs','attract.rs']:\n    need((dev/'engine/crates/pav_core/src/games/fit'/f).exists(), f)\nneed((dev/'engine/crates/pav_ui/src/glyphs.rs').exists(), 'glyphs.rs')\nfor f in ['notes/decisions.md','notes/feedback.md','notes/credits.txt','notes/engine.diff','notes/plan-audit.md','notes/last_test_run.txt','README.md','tests/run.sh','tools/build.sh']:\n    need((dev/f).exists(), f)\nneed('Total: 34 issues, 4 critical.' in (dev/'notes/feedback.md').read_text(), 'feedback total')\nneed(d['testingFeedback'][0].startswith('34 issues'), 'interview count')\nfor gone in ['engine/target','engine/out','engine/.git','tests/__pycache__','tests/_served','tests/_alone']:\n    need(not (dev/gone).exists(), f'{gone} still here')\nprint('audit problems:', problems or 'none')\nprint('html bytes', html.stat().st_size, '| usage:', d['sourceInformation']['usage'])\nEOF\nrm -rf notes/.audit; python3 - <<'EOF'\nimport pathlib\npathlib.Path('../PROGRESS.md').write_text('''# PROGRESS (read this first after a compaction)\n\nGoal: STAGE.md says build the game PLAN.md describes; names and hand-ins from TASK.md.\n\n- Title (RNG, 1 of 50): **Whiff Fit**\n- Dev folder: `WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/` (engine in `engine/`, hub files in `hub/`)\n- Hand-ins in this folder's root: `WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859.html`, `exit-interview.json`\n- Chat reply and About screen: Source Information, Testing/Engine/Prompt Feedback.\n\n## Status\nDone. PLAN.md reread line by line; 8 gaps found and fixed; `notes/plan-audit.md` lists every section with its evidence, the ten differences from the plan, and what could not be checked here.\nFinal page built 04:38. `tests/run.sh all` in one run on it: 135 passed, 0 failed (`notes/last_test_run.txt`). All nine About pages and the title seen at 1080p from file://, no page errors. Native window played a full event with a scripted pad, no panics. Caches removed. Only the final reply remained.\n''')\nEOF\nls -la --time-style=+%H:%M .. | cut -c24- ; ls notes tests; du -sh . | cut -f1; cat notes/last_test_run.txt | head -8 | cut -c1-220","description":"Record results, regenerate diff, audit the hand-ins and clean up","timeout":120000},"caller":{"type":"d