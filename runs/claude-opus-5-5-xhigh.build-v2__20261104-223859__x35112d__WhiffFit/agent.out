{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VirAiEtCfqdQEcfhfr5fAV","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Boots the page and plays it with a stub pad, keys, a mouse and fingers. Prints failures and a count.\"\"\"\n3\timport json, shutil, sys, time\n4\tfrom common import *\n5\t\n6\tt = Count()\n7\t\n8\tdef boot_ok(p, what):\n9\t    s = wait(p, lambda: status(p), 90)\n10\t    t.check(f\"{what}: __gameStatus appears\", s is not None, \"no status\")\n11\t    if not s:\n12\t        return False\n13\t    a = s[\"tick\"]\n14\t    p.wait_for_timeout(1500)\n15\t    b = status(p)[\"tick\"]\n16\t    return t.check(f\"{what}: the tick advances\", b > a, f\"{a} -> {b}\")\n17\t\n18\tdef tap_key(p, key, ms=120):\n19\t    # Software rendering on a shared machine: give it a few frames either side of the press.\n20\t    a = status(p)[\"tick\"]\n21\t    p.keyboard.down(key)\n22\t    wait(p, lambda: status(p)[\"tick\"] > a + 2, 40)\n23\t    p.wait_for_timeout(ms)\n24\t    p.keyboard.up(key)\n25\t    a = status(p)[\"tick\"]\n26\t    wait(p, lambda: status(p)[\"tick\"] > a + 3, 40)\n27\t\n28\tdef tap_pad(p, i, ms=120):\n29\t    # Held until the game has really ticked with it: a tap shorter than a frame isn't a tap.\n30\t    a = status(p)[\"tick\"]\n31\t    p.evaluate(f\"__setPad([0,0,0,0],[{i}])\")\n32\t    wait(p, lambda: status(p)[\"tick\"] > a + 2, 40)\n33\t    p.wait_for_timeout(ms)\n34\t    p.evaluate(\"__setPad([0,0,0,0],[])\")\n35\t    a = status(p)[\"tick\"]\n36\t    wait(p, lambda: status(p)[\"tick\"] > a + 3, 40)\n37\t\n38\twith sync_playwright() as pw:\n39\t    b = pw.chromium.launch(args=FLAGS)\n40\t    # ---------------------------------------------------------------- the page alone: no dev folder, no network\n41\t    alone = HERE / \"_alone\"\n42\t    shutil.rmtree(alone, ignore_errors=True)\n43\t    alone.mkdir()\n44\t    shutil.copy(PAGE, alone / \"game.html\")\n45\t    c = b.new_context(viewport={\"width\": 320, \"height\": 180}, offline=True)\n46\t    p = c.new_page()\n47\t    errors, requests = [], []\n48\t    p.on(\"pageerror\", lambda e: errors.append(str(e)))\n49\t    p.on(\"console\", lambda m: errors.append(m.text) if m.type == \"error\" else None)\n50\t    p.on(\"request\", lambda r: requests.append(r.url))\n51\t    p.goto((alone / \"game.html\").as_uri() + \"?fast=1\")\n52\t    if boot_ok(p, \"the page alone\"):\n53\t        t.check(\"the page alone has the game's title\", p.title() == \"Whiff Fit \\u2014 A balance comedy at Tippy Cay\", p.title())\n54\t        t.check(\"the page alone starts on the title screen\", status(p)[\"screen\"] == \"title\", status(p)[\"screen\"])\n55\t        other = [u for u in requests if not u.startswith((alone.as_uri(), \"data:\", \"blob:\"))]\n56\t        t.check(\"the page alone asks for no other file\", not other, str(other[:5]))\n57\t        t.check(\"the page alone: no page errors\", not errors, str(errors[:3]))\n58\t    c.close()\n59\t    shutil.rmtree(alone, ignore_errors=True)\n60\t    # ---------------------------------------------------------------- boot, pad, keys, mouse\n61\t    errors = []\n62\t    c, p = open_page(b, init=[PAD], errors=errors)\n63\t    if boot_ok(p, \"boot\"):\n64\t        s = status(p)\n65\t        t.check(\"starts on the title\", s[\"screen\"] == \"title\", s[\"screen\"])\n66\t        t.check(\"music defaults to 10%\", abs(s[\"music_setting\"] - 0.10) < 1e-3, str(s[\"music_setting\"]))\n67\t        # Pad: D-pad down moves the focus, Cross confirms.\n68\t        f0 = status(p)[\"focus\"]\n69\t        tap_pad(p, 13)\n70\t        f1 = status(p)[\"focus\"]\n71\t        t.check(\"the pad moves the focus\", f1 == f0 + 1, f\"{f0} -> {f1}\")\n72\t        u = ui(p)\n73\t        t.check(\"prompts show PlayStation glyphs on a pad\", any(x.startswith(\"Cross:\") for x in u[\"prompts\"]), str(u[\"prompts\"]))\n74\t        t.check(\"the device is the pad\", u[\"device\"] == \"pad\", u[\"device\"])\n75\t        # Back to the top, then Cross: into guest select.\n76\t        tap_pad(p, 12)\n77\t        tap_pad(p, 0)\n78\t        t.check(\"the pad confirms\", wait(p, lambda: status(p)[\"screen\"] == \"slots\", 5), status(p)[\"screen\"])\n79\t        tap_pad(p, 1)\n80\t        t.check(\"Circle backs\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 5), status(p)[\"screen\"])\n81\t        # Keyboard: the same, and the prompts change the instant the device does.\n82\t        tap_key(p, \"s\")\n83\t        t.check(\"keys move the focus\", status(p)[\"focus\"] == 1, str(status(p)[\"focus\"]))\n84\t        u = ui(p)\n85\t        t.check(\"prompts follow the keyboard\", u[\"device\"] == \"keys\" and any(x.startswith(\"Space:\") for x in u[\"prompts\"]), str(u))\n86\t        tap_key(p, \"w\")\n87\t        tap_key(p, \"Enter\")\n88\t        t.check(\"Enter confirms\", wait(p, lambda: status(p)[\"screen\"] == \"slots\", 5), status(p)[\"screen\"])\n89\t        tap_key(p, \"Escape\")\n90\t        t.check(\"Esc backs\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 5), status(p)[\"screen\"])\n91\t        # Mouse: hover moves focus, a click activates.\n92\t        items = ui(p)[\"items\"]\n93\t        it = items[2]\n94\t        p.mouse.move(it[\"x\"] + it[\"w\"] / 2, it[\"y\"] + it[\"h\"] / 2)\n95\t        ok = wait(p, lambda: status(p)[\"focus\"] == 2, 5)\n96\t        t.check(\"mouse hover moves the focus\", ok, str(status(p)[\"focus\"]))\n97\t        t.check(\"prompts follow the mouse\", ui(p)[\"device\"] == \"mouse\", ui(p)[\"device\"])\n98\t        p.mouse.click(it[\"x\"] + it[\"w\"] / 2, it[\"y\"] + it[\"h\"] / 2)\n99\t        t.check(\"a click activates\", wait(p, lambda: status(p)[\"screen\"] == \"settings\", 15), status(p)[\"screen\"] + \" \" + str(ui(p).get(\"event\")))\n100\t        # Settings: the Xbox option.\n101\t        items = ui(p)[\"items\"]\n102\t        labels = [i[\"label\"] for i in items]\n103\t        t.check(\"Settings lists glyphs\", \"Button Glyphs\" in labels, str(labels))\n104\t        for _ in range(3):\n105\t            tap_key(p, \"s\")\n106\t        tap_key(p, \"Enter\")\n107\t        tap_pad(p, 13)\n108\t        u = ui(p)\n109\t        t.check(\"Xbox glyphs after the option\", any(x.startswith(\"A:\") for x in u[\"prompts\"]), str(u[\"prompts\"]))\n110\t        p.evaluate(\"__setPad([0,0,0,0],[])\")\n111\t        tap_key(p, \"Enter\") if False else None\n112\t        tap_pad(p, 12)\n113\t        tap_pad(p, 0)   # back to PlayStation\n114\t        tap_pad(p, 1)\n115\t        t.check(\"back to the title\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 5), status(p)[\"screen\"])\n116\t        # A real start from the keyboard, a look at the event flow.\n117\t        t.check(\"no page errors so far\", not errors, str(errors[:3]))\n118\t    c.close()\n119\t    # ---------------------------------------------------------------- attract\n120\t    errors = []\n121\t    c, p = open_page(b, errors=errors)\n122\t    if boot_ok(p, \"attract page\"):\n123\t        # 600 sim ticks; the wall clock depends on how fast software rendering runs.\n124\t        a = status(p)[\"tick\"]\n125\t        ok = wait(p, lambda: status(p)[\"attract\"], 240)\n126\t        ticks = status(p)[\"tick\"] - a\n127\t        t.check(\"attract starts after about 10 s (600 ticks) of no input\", ok and ticks < 640, f\"{ticks} ticks, {status(p)['screen']}\")\n128\t        tap_key(p, \"x\")\n129\t        t.check(\"any input exits attract\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 8), status(p)[\"screen\"])\n130\t        t.check(\"attract: no page errors\", not errors, str(errors[:3]))\n131\t    c.close()\n132\t    # ---------------------------------------------------------------- sound\n133\t    def level(music):\n134\t        save = json.dumps({\"version\": 1, \"settings\": {\"music\": music, \"sfx\": 0.0, \"voice\": 0.0}, \"slots\": [None, None, None, None]})\n135\t        c, p = open_page(b, init=[SOUND], storage=save)\n136\t        boot_ok(p, f\"sound page at {music}\")\n137\t        p.mouse.click(5, 5)\n138\t        p.wait_for_timeout(5000)\n139\t        p.evaluate(\"__snd.rms = 0; __snd.n = 0; __snd.peak = 0\")\n140\t        p.wait_for_timeout(9000)\n141\t        r = p.evaluate(\"__snd.n ? Math.sqrt(__snd.rms / __snd.n) : 0\")\n142\t        c.close()\n143\t        return r\n144\t    low, full = level(0.10), level(1.0)\n145\t    t.check(\"music is audible at full\", full > 0.005, str(full))\n146\t    if full > 0:\n147\t        ratio = low / full\n148\t        t.check(\"music at 10% is about a tenth of full\", 0.05 < ratio < 0.2, f\"{low} / {full} = {ratio}\")\n149\t    # ---------------------------------------------------------------- a stay: pad all the way, a save, Continue\n150\t    errors = []\n151\t    c, p = open_page(b, init=[PAD], errors=errors)\n152\t    if boot_ok(p, \"stay page\"):\n153\t        tap_pad(p, 0)   # New Stay\n154\t        wait(p, lambda: status(p)[\"screen\"] == \"slots\", 40)\n155\t        tap_pad(p, 0)   # Guest 1\n156\t        wait(p, lambda: status(p)[\"screen\"] == \"names\", 40)\n157\t        tap_pad(p, 13)\n158\t        tap_pad(p, 0)   # A name\n159\t        t.check(\"the look screen follows the name\", wait(p, lambda: status(p)[\"screen\"] == \"look\", 40), status(p)[\"screen\"])\n160\t        tap_pad(p, 13); tap_pad(p, 13); tap_pad(p, 0)   # Begin Your Stay\n161\t        t.check(\"Pip greets you\", wait(p, lambda: status(p)[\"screen\"] == \"dialog\", 40), status(p)[\"screen\"])\n162\t        for _ in range(40):\n163\t            if status(p)[\"screen\"] != \"dialog\":\n164\t                break\n165\t            tap_pad(p, 0)\n166\t        t.check(\"the Morning Wobble Check starts\", wait(p, lambda: status(p)[\"screen\"] == \"check\", 60), status(p)[\"screen\"])\n167\t        saved = p.evaluate(\"localStorage.getItem('whiff-fit-save-v1')\")\n168\t        ok = saved and json.loads(saved)[\"slots\"][0] is not None\n169\t        t.check(\"the guest is saved in localStorage\", ok, str(saved)[:200])\n170\t        t.check(\"a stay: no page errors\", not errors, str(errors[:3]))\n171\t        p.reload()\n172\t        boot_ok(p, \"reload\")\n173\t        items = wait(p, lambda: ui(p)[\"items\"], 40)\n174\t        t.check(\"the title says Continue after a save\", items and items[0][\"label\"] == \"Continue\", str(items)[:300])\n175\t    c.close()\n176\t    # ---------------------------------------------------------------- lean per device, the rhythm clock\n177\t    errors = []\n178\t    c, p = open_page(b, url=PAGE.as_uri() + \"?fast=1&scene=fit/event/step_party\", init=[PAD, SOUND], errors=errors)\n179\t    if boot_ok(p, \"event page\"):\n180\t        p.wait_for_timeout(1000)\n181\t        tap_key(p, \"Space\")\n182\t        t.check(\"Space starts the event\", wait(p, lambda: status(p)[\"phase\"] == \"Play\", 30), status(p).get(\"phase\"))\n183\t        # Keys ramp: a short hold gives a small lean.\n184\t        a = status(p)[\"tick\"]\n185\t        p.keyboard.down(\"d\")\n186\t        small = wait(p, lambda: status(p)[\"lean\"][0] or None, 8, 0.01) or 0\n187\t        wait(p, lambda: status(p)[\"tick\"] > a + 120, 25)\n188\t        big = status(p)[\"lean\"][0]\n189\t        p.keyboard.up(\"d\")\n190\t        t.check(\"keys ramp the lean\", 0 < small < big, f\"{small} then {big}\")\n191\t        # The stick: past the deadzone with its curve.\n192\t        p.evaluate(\"__setPad([0.5,0,0,0],[])\")\n193\t        ok = wait(p, lambda: 0.2 < status(p)[\"lean\"][0] < 0.45, 8)\n194\t        t.check(\"the stick leans through its curve\", ok, str(status(p)[\"lean\"]))\n195\t        p.evaluate(\"__setPad([0.08,0,0,0],[])\")\n196\t        ok = wait(p, lambda: abs(status(p)[\"lean\"][0]) < 0.001, 8)\n197\t        t.check(\"the stick has a deadzone\", ok, str(status(p)[\"lean\"]))\n198\t        p.evaluate(\"__setPad([0,0,0,0],[])\")\n199\t        # The cursor: its offset from the middle of the window.\n200\t        p.mouse.move(160 + 0.38 * 180 * 0.5, 90)\n201\t        ok = wait(p, lambda: abs(status(p)[\"lean\"][0] - 0.5) < 0.1, 8)\n202\t        t.check(\"the cursor leans by its offset\", ok, str(status(p)[\"lean\"]))\n203\t        # Sound is running (the click): the rhythm clock follows the music.\n204\t        p.mouse.click(160, 90)\n205\t        ok = wait(p, lambda: status(p).get(\"song_pos\") is not None, 15)\n206\t        t.check(\"the rhythm clock runs once sound does\", ok, str(status(p).get(\"song_pos\")))\n207\t        if ok:\n208\t            s = status(p)\n209\t            t.check(\"the clock is near the song\", abs(s[\"song_pos\"] - s[\"t\"]) < 20, f\"{s['song_pos']} vs {s['t']}\")\n210\t        t.check(\"event page: no page errors\", not errors, str(errors[:3]))\n211\t    c.close()\n212\t    # ---------------------------------------------------------------- touch-only devices\n213\t    for name in (\"Pixel 7\", \"Galaxy Tab S4\"):\n214\t        dev = dict(pw.devices[name])\n215\t        dev.pop(\"viewport\", None)\n216\t        dev.pop(\"device_scale_factor\", None)\n217\t        dev.pop(\"default_browser_type\", None)\n218\t        c, p = open_page(b, viewport=(320, 180), **dev)\n219\t        if boot_ok(p, name):\n220\t            t.check(f\"{name}: the card is up\", status(p)[\"touch_only\"], str(status(p)))\n221\t            t.check(f\"{name}: attract runs\", wait(p, lambda: status(p)[\"attract\"], 30), status(p)[\"screen\"])\n222\t            items = wait(p, lambda: ui(p)[\"items\"], 5)\n223\t            t.check(f\"{name}: one Settings button\", items and items[0][\"label\"] == \"Settings\", str(items))\n224\t            if items:\n225\t                it = items[0]\n226\t                p.touchscreen.tap(it[\"x\"] + it[\"w\"] / 2, it[\"y\"] + it[\"h\"] / 2)\n227\t                t.check(f\"{name}: a tap opens Settings\", wait(p, lambda: status(p)[\"screen\"] == \"settings\", 20), status(p)[\"screen\"] + \" \" + str(ui(p).get(\"event\")))\n228\t        c.close()\n229\t    b.close()\n230\t    # ---------------------------------------------------------------- no WebGPU, on a touch device\n231\t    w = pw.webkit.launch()\n232\t    dev = dict(pw.devices[\"iPhone 14\"])\n233\t    dev.pop(\"default_browser_type\", None)\n234\t    ctx = w.new_context(**dev)\n235\t    p = ctx.new_page()\n236\t    p.goto(PAGE.as_uri())\n237\t    p.wait_for_timeout(1000)\n238\t    text = p.inner_text(\"#msg\")\n239\t    t.check(\"no WebGPU on touch says both things\", \"Controller or keyboard required\" in text and \"WebGPU\" in text, text)\n240\t    w.close()\n241\t\n242\tprint(f\"{t.passed} passed, {t.failed} failed\")\n243\tsys.exit(1 if t.failed else 0)\n244\t"}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"26dd4574-7e0b-42a2-ac54-1ce150f3b5df","timestamp":"2026-11-05T11:13:53.256Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/tests/browser.py","content":"#!/usr/bin/env python3\n\"\"\"Boots the page and plays it with a stub pad, keys, a mouse and fingers. Prints failures and a count.\"\"\"\nimport json, shutil, sys, time\nfrom common import *\n\nt = Count()\n\ndef boot_ok(p, what):\n    s = wait(p, lambda: status(p), 90)\n    t.check(f\"{what}: __gameStatus appears\", s is not None, \"no status\")\n    if not s:\n        return False\n    a = s[\"tick\"]\n    p.wait_for_timeout(1500)\n    b = status(p)[\"tick\"]\n    return t.check(f\"{what}: the tick advances\", b > a, f\"{a} -> {b}\")\n\ndef tap_key(p, key, ms=120):\n    # Software rendering on a shared machine: give it a few frames either side of the press.\n    a = status(p)[\"tick\"]\n    p.keyboard.down(key)\n    wait(p, lambda: status(p)[\"tick\"] > a + 2, 40)\n    p.wait_for_timeout(ms)\n    p.keyboard.up(key)\n    a = status(p)[\"tick\"]\n    wait(p, lambda: status(p)[\"tick\"] > a + 3, 40)\n\ndef tap_pad(p, i, ms=120):\n    # Held until the game has really ticked with it: a tap shorter than a frame isn't a tap.\n    a = status(p)[\"tick\"]\n    p.evaluate(f\"__setPad([0,0,0,0],[{i}])\")\n    wait(p, lambda: status(p)[\"tick\"] > a + 2, 40)\n    p.wait_for_timeout(ms)\n    p.evaluate(\"__setPad([0,0,0,0],[])\")\n    a = status(p)[\"tick\"]\n    wait(p, lambda: status(p)[\"tick\"] > a + 3, 40)\n\nwith sync_playwright() as pw:\n    b = pw.chromium.launch(args=FLAGS)\n    # ---------------------------------------------------------------- the page alone: no dev folder, no network\n    alone = HERE / \"_alone\"\n    shutil.rmtree(alone, ignore_errors=True)\n    alone.mkdir()\n    shutil.copy(PAGE, alone / \"game.html\")\n    c = b.new_context(viewport={\"width\": 320, \"height\": 180}, offline=True)\n    p = c.new_page()\n    errors, requests = [], []\n    p.on(\"pageerror\", lambda e: errors.append(str(e)))\n    p.on(\"console\", lambda m: errors.append(m.text) if m.type == \"error\" else None)\n    p.on(\"request\", lambda r: requests.append(r.url))\n    p.goto((alone / \"game.html\").as_uri() + \"?fast=1\")\n    if boot_ok(p, \"the page alone\"):\n        t.check(\"the page alone has the game's title\", p.title() == \"Whiff Fit \\u2014 A balance comedy at Tippy Cay\", p.title())\n        t.check(\"the page alone starts on the title screen\", status(p)[\"screen\"] == \"title\", status(p)[\"screen\"])\n        other = [u for u in requests if not u.startswith((alone.as_uri(), \"data:\", \"blob:\"))]\n        t.check(\"the page alone asks for no other file\", not other, str(other[:5]))\n        t.check(\"the page alone: no page errors\", not errors, str(errors[:3]))\n    c.close()\n    shutil.rmtree(alone, ignore_errors=True)\n    # ---------------------------------------------------------------- boot, pad, keys, mouse\n    errors = []\n    c, p = open_page(b, init=[PAD], errors=errors)\n    if boot_ok(p, \"boot\"):\n        s = status(p)\n        t.check(\"starts on the title\", s[\"screen\"] == \"title\", s[\"screen\"])\n        t.check(\"music defaults to 10%\", abs(s[\"music_setting\"] - 0.10) < 1e-3, str(s[\"music_setting\"]))\n        # Pad: D-pad down moves the focus, Cross confirms.\n        f0 = status(p)[\"focus\"]\n        tap_pad(p, 13)\n        f1 = status(p)[\"focus\"]\n        t.check(\"the pad moves the focus\", f1 == f0 + 1, f\"{f0} -> {f1}\")\n        u = ui(p)\n        t.check(\"prompts show PlayStation glyphs on a pad\", any(x.startswith(\"Cross:\") for x in u[\"prompts\"]), str(u[\"prompts\"]))\n        t.check(\"the device is the pad\", u[\"device\"] == \"pad\", u[\"device\"])\n        # Back to the top, then Cross: into guest select.\n        tap_pad(p, 12)\n        tap_pad(p, 0)\n        t.check(\"the pad confirms\", wait(p, lambda: status(p)[\"screen\"] == \"slots\", 5), status(p)[\"screen\"])\n        tap_pad(p, 1)\n        t.check(\"Circle backs\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 5), status(p)[\"screen\"])\n        # Keyboard: the same, and the prompts change the instant the device does.\n        tap_key(p, \"s\")\n        t.check(\"keys move the focus\", status(p)[\"focus\"] == 1, str(status(p)[\"focus\"]))\n        u = ui(p)\n        t.check(\"prompts follow the keyboard\", u[\"device\"] == \"keys\" and any(x.startswith(\"Space:\") for x in u[\"prompts\"]), str(u))\n        tap_key(p, \"w\")\n        tap_key(p, \"Enter\")\n        t.check(\"Enter confirms\", wait(p, lambda: status(p)[\"screen\"] == \"slots\", 5), status(p)[\"screen\"])\n        tap_key(p, \"Escape\")\n        t.check(\"Esc backs\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 5), status(p)[\"screen\"])\n        # Mouse: hover moves focus, a click activates.\n        items = ui(p)[\"items\"]\n        it = items[2]\n        p.mouse.move(it[\"x\"] + it[\"w\"] / 2, it[\"y\"] + it[\"h\"] / 2)\n        ok = wait(p, lambda: status(p)[\"focus\"] == 2, 5)\n        t.check(\"mouse hover moves the focus\", ok, str(status(p)[\"focus\"]))\n        t.check(\"prompts follow the mouse\", ui(p)[\"device\"] == \"mouse\", ui(p)[\"device\"])\n        p.mouse.click(it[\"x\"] + it[\"w\"] / 2, it[\"y\"] + it[\"h\"] / 2)\n        t.check(\"a click activates\", wait(p, lambda: status(p)[\"screen\"] == \"settings\", 15), status(p)[\"screen\"] + \" \" + str(ui(p).get(\"event\")))\n        # Settings: the Xbox option.\n        items = ui(p)[\"items\"]\n        labels = [i[\"label\"] for i in items]\n        t.check(\"Settings lists glyphs\", \"Button Glyphs\" in labels, str(labels))\n        for _ in range(3):\n            tap_key(p, \"s\")\n        tap_key(p, \"Enter\")\n        tap_pad(p, 13)\n        u = ui(p)\n        t.check(\"Xbox glyphs after the option\", any(x.startswith(\"A:\") for x in u[\"prompts\"]), str(u[\"prompts\"]))\n        p.evaluate(\"__setPad([0,0,0,0],[])\")\n        tap_key(p, \"Enter\") if False else None\n        tap_pad(p, 12)\n        tap_pad(p, 0)   # back to PlayStation\n        tap_pad(p, 1)\n        t.check(\"back to the title\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 5), status(p)[\"screen\"])\n        # A real start from the keyboard, a look at the event flow.\n        t.check(\"no page errors so far\", not errors, str(errors[:3]))\n    c.close()\n    # ---------------------------------------------------------------- attract\n    errors = []\n    c, p = open_page(b, errors=errors)\n    if boot_ok(p, \"attract page\"):\n        # 600 sim ticks; the wall clock depends on how fast software rendering runs.\n        a = status(p)[\"tick\"]\n        ok = wait(p, lambda: status(p)[\"attract\"], 240)\n        ticks = status(p)[\"tick\"] - a\n        t.check(\"attract starts after about 10 s (600 ticks) of no input\", ok and ticks < 640, f\"{ticks} ticks, {status(p)['screen']}\")\n        tap_key(p, \"x\")\n        t.check(\"any input exits attract\", wait(p, lambda: status(p)[\"screen\"] == \"title\", 8), status(p)[\"screen\"])\n        t.check(\"attract: no page errors\", not errors, str(errors[:3]))\n    c.close()\n    # ---------------------------------------------------------------- sound\n    def level(music):\n        save = json.dumps({\"version\": 1, \"settings\": {\"music\": music, \"sfx\": 0.0, \"voice\": 0.0}, \"slots\": [None, None, None, None]})\n        c, p = open_page(b, init=[SOUND], storage=save)\n        boot_ok(p, f\"sound page at {music}\")\n        p.mouse.click(5, 5)\n        p.wait_for_timeout(5000)\n        p.evaluate(\"__snd.rms = 0; __snd.n = 0; __snd.peak = 0\")\n        p.wait_for_timeout(9000)\n        r = p.evaluate(\"__snd.n ? Math.sqrt(__snd.rms / __snd.n) : 0\")\n        c.close()\n        return r\n    low, full = level(0.10), level(1.0)\n    t.check(\"music is audible at full\", full > 0.005, str(full))\n    if full > 0:\n        ratio = low / full\n        t.check(\"music at 10% is about a tenth of full\", 0.05 < ratio < 0.2, f\"{low} / {full} = {ratio}\")\n    # ---------------------------------------------------------------- a stay: pad all the way, a save, Continue\n    errors = []\n    c, p = open_page(b, init=[PAD], errors=errors)\n    if boot_ok(p, \"stay page\"):\n        tap_pad(p, 0)   # New Stay\n        wait(p, lambda: status(p)[\"screen\"] == \"slots\", 40)\n        tap_pad(p, 0)   # Guest 1\n        wait(p, lambda: status(p)[\"screen\"] == \"names\", 40)\n        tap_pad(p, 13)\n        tap_pad(p, 0)   # A name\n        t.check(\"the look screen follows the name\", wait(p, lambda: status(p)[\"screen\"] == \"look\", 40), status(p)[\"screen\"])\n        tap_pad(p, 13); tap_pad(p, 13); tap_pad(p, 0)   # Begin Your Stay\n        t.check(\"Pip greets you\", wait(p, lambda: status(p)[\"screen\"] == \"dialog\", 40), status(p)[\"screen\"])\n        for _ in range(40):\n            if status(p)[\"screen\"] != \"dialog\":\n                break\n            tap_pad(p, 0)\n        t.check(\"the Morning Wobble Check starts\", wait(p, lambda: status(p)[\"screen\"] == \"check\", 60), status(p)[\"screen\"])\n        saved = p.evaluate(\"localStorage.getItem('whiff-fit-save-v1')\")\n        ok = saved and json.loads(saved)[\"slots\"][0] is not None\n        t.check(\"the guest is saved in localStorage\", ok, str(saved)[:200])\n        t.check(\"a stay: no page errors\", not errors, str(errors[:3]))\n        p.reload()\n        boot_ok(p, \"reload\")\n        items = wait(p, lambda: ui(p)[\"items\"], 40)\n        t.check(\"the title says Continue after a save\", items and items[0][\"label\"] == \"Continue\", str(items)[:300])\n    c.close()\n    # ---------------------------------------------------------------- lean per device, the rhythm clock\n    errors = []\n    c, p = open_page(b, url=PAGE.as_uri() + \"?fast=1&scene=fit/event/step_party\", init=[PAD, SOUND], errors=errors)\n    if boot_ok(p, \"event page\"):\n        p.wait_for_timeout(1000)\n        tap_key(p, \"Space\")\n        t.check(\"Space starts the event\", wait(p, lambda: status(p)[\"phase\"] == \"Play\", 30), status(p).get(\"phase\"))\n        # Keys ramp: a short hold gives a small lean.\n        a = status(p)[\"tick\"]\n        p.keyboard.down(\"d\")\n        small = wait(p, lambda: status(p)[\"lean\"][0] or None, 8, 0.01) or 0\n        wait(p, lambda: status(p)[\"tick\"] > a + 120, 25)\n        big = status(p)[\"lean\"][0]\n        p.keyboard.up(\"d\")\n        t.check(\"keys ramp the lean\", 0 < small < big, f\"{small} then {big}\")\n        # The stick: past the deadzone with its curve.\n        p.evaluate(\"__setPad([0.5,0,0,0],[])\")\n        ok = wait(p, lambda: 0.2 < status(p)[\"lean\"][0] < 0.45, 8)\n        t.check(\"the stick leans through its curve\", ok, str(status(p)[\"lean\"]))\n        p.evaluate(\"__setPad([0.08,0,0,0],[])\")\n        ok = wait(p, lambda: abs(status(p)[\"lean\"][0]) < 0.001, 8)\n        t.check(\"the stick has a deadzone\", ok, str(status(p)[\"lean\"]))\n        p.evaluate(\"__setPad([0,0,0,0],[])\")\n        # The cursor: its offset from the middle of the window.\n        p.mouse.move(160 + 0.38 * 180 * 0.5, 90)\n        ok = wait(p, lambda: abs(status(p)[\"lean\"][0] - 0.5) < 0.1, 8)\n        t.check(\"the cursor leans by its offset\", ok, str(status(p)[\"lean\"]))\n        # Sound is running (the click): the rhythm clock follows the music.\n        p.mouse.click(160, 90)\n        ok = wait(p, lambda: status(p).get(\"song_pos\") is not None, 15)\n        t.check(\"the rhythm clock runs once sound does\", ok, str(status(p).get(\"song_pos\")))\n        if ok:\n            s = status(p)\n            t.check(\"the clock is near the song\", abs(s[\"song_pos\"] - s[\"t\"]) < 20, f\"{s['song_pos']} vs {s['t']}\")\n        t.check(\"event page: no page errors\", not errors, str(errors[:3]))\n    c.close()\n    # ---------------------------------------------------------------- touch-only devices\n    for name in (\"Pixel 7\", \"Galaxy Tab S4\"):\n        dev = dict(pw.devices[name])\n        dev.pop(\"viewport\", None)\n        dev.pop(\"device_scale_factor\", None)\n        dev.pop(\"default_browser_type\", None)\n        c, p = open_page(b, viewport=(320, 180), **dev)\n        if boot_ok(p, name):\n            t.check(f\"{name}: the card is up\", status(p)[\"touch_only\"], str(status(p)))\n            t.check(f\"{name}: attract runs\", wait(p, lambda: status(p)[\"attract\"], 30), status(p)[\"screen\"])\n            items = wait(p, lambda: ui(p)[\"items\"], 5)\n            t.check(f\"{name}: one Settings button\", items and items[0][\"label\"] == \"Settings\", str(items))\n            if items:\n                it = items[0]\n                p.touchscreen.tap(it[\"x\"] + it[\"w\"] / 2, it[\"y\"] + it[\"h\"] / 2)\n                t.check(f\"{name}: a tap opens Settings\", wait(p, lambda: status(p)[\"screen\"] == \"settings\", 20), status(p)[\"screen\"] + \" \" + str(ui(p).get(\"event\")))\n        c.close()\n    b.close()\n    # ---------------------------------------------------------------- no WebGPU, on a touch device\n    w = pw.webkit.launch()\n    dev = dict(pw.devices[\"iPhone 14\"])\n    dev.pop(\"default_browser_type\", None)\n    ctx = w.new_context(**dev)\n    p = ctx.new_page()\n    p.goto(PAGE.as_uri())\n    p.wait_for_timeout(1000)\n    text = p.inner_text(\"#msg\")\n    t.check(\"no WebGPU on touch says both things\", \"Controller or keyboard required\" in text and \"WebGPU\" in text, text)\n    w.close()\n\nprint(f\"{t.passed} passed, {t.failed} failed\")\nsys.exit(1 if t.failed else 0)\n","numLines":244,"startLine":1,"totalLines":244}},"tool_result_meta":[{"id":"toolu_01VirAiEtCfqdQEcfhfr5fAV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
