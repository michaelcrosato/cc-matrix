            None => MItem::button(MAct::Slot(i as u8), format!(\"Guest {}\", i + 1)).sub(\"New Stay\"),\n102\t                    })\n103\t                    .collect();\n104\t                Some(Menu {\n105\t                    key: \"slots\",\n106\t                    title: \"Who is staying?\".into(),\n107\t                    sub: String::new(),\n108\t                    items,\n109\t                    layout: Layout::Row { y: 340.0, w: 400.0, h: 360.0 },\n110\t                    tabs: None,\n111\t                    back: true,\n112\t                    card: false,\n113\t                    dim: true,\n114\t                })\n115\t            }\n116\t            Flow::Names(_) => {\n117\t                let items = script::list(\"names\").iter().enumerate().map(|(i, n)| MItem::button(MAct::Name(i as u16), n.clone())).collect();\n118\t                Some(Menu {\n119\t                    key: \"names\",\n120\t                    title: \"What shall we call you?\".into(),\n121\t                    sub: \"Pip has already written it down.\".into(),\n122\t                    items,\n123\t                    layout: LIST,\n124\t                    tabs: None,\n125\t                    back: true,\n126\t                    card: true,\n127\t                    dim: true,\n128\t                })\n129\t            }\n130\t            Flow::Look(_, name) => {\n131\t                let items = vec![\n132\t                    MItem::choice(MAct::Skin, \"Skin\", format!(\"Tone {}\", self.look_skin + 1)),\n133\t                    MItem::choice(MAct::Outfit, \"Outfit\", meta::OUTFITS[self.look_outfit as usize % 8].0),\n134\t                    MItem::button(MAct::Begin, \"Begin Your Stay\"),\n135\t                ];\n136\t                Some(Menu {\n137\t                    key: \"look\",\n138\t                    title: name.clone(),\n139\t                    sub: \"This is you. Pip has seen worse.\".into(),\n140\t                    items,\n141\t                    layout: Layout::List { x: 70.0, y: 300.0, w: 700.0, row: 110.0, visible: 3 },\n142\t                    tabs: None,\n143\t                    back: true,\n144\t                    card: true,\n145\t                    dim: false,\n146\t                })\n147\t            }\n148\t            Flow::Event(r) if r.phase == RunPhase::Result && r.pt > 0.9 => {\n149\t                let mut items = Vec::new();\n150\t                if self.direct.is_some() || r.kind != EventKind::BigStand {\n151\t                    items.push(MItem::button(MAct::Retry, \"Retry\"));\n152\t                }\n153\t                items.push(MItem::button(MAct::Done, if r.kind == EventKind::BigStand { \"Continue\" } else { \"Back\" }));\n154\t                Some(Menu {\n155\t                    key: \"result\",\n156\t                    title: String::new(),\n157\t                    sub: String::new(),\n158\t                    items,\n159\t                    layout: Layout::Row { y: 870.0, w: 340.0, h: 110.0 },\n160\t                    tabs: None,\n161\t                    back: false,\n162\t                    card: false,\n163\t                    dim: false,\n164\t                })\n165\t            }\n166\t            Flow::Together(n) => {\n167\t                let items = vec![\n168\t                    MItem::button(MAct::Players(2), \"2 Guests\").sub(if *n == 2 { \"Chosen\" } else { \"\" }),\n169\t                    MItem::button(MAct::Players(3), \"3 Guests\").sub(if *n == 3 { \"Chosen\" } else { \"\" }),\n170\t                    MItem::button(MAct::Players(4), \"4 Guests\").sub(if *n == 4 { \"Chosen\" } else { \"\" }),\n171\t                    MItem::button(MAct::Go, \"Begin the Medley\"),\n172\t                ];\n173\t                Some(Menu {\n174\t                    key: \"together\",\n175\t                    title: \"The Inter-Resort Medley\".into(),\n176\t                    sub: \"One pad. Paddle Slalom, Tide Table, Cannonball Cup. Pass it round.\".into(),\n177