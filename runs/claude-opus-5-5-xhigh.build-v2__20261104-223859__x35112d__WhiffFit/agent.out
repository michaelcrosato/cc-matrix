{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjJYRksH8x43UTReBw3M","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MtD78KgxZ2JhN7Qk3Kevko","name":"Bash","input":{"command":"grep -n \"pub enum AiDef\" -A30 crates/pav_core/src/ai.rs | head -50; sed -i 's/def npc(self, name, kind, x, z, yaw=0.0, y=0.0, ai=\"idle\", \\*\\*k):/def npc(self, name, kind, x, z, yaw=0.0, y=0.0, ai={\"type\": \"idle\"}, **k):/' ../tools/make_sets.py; cat > crates/pav_ui/src/fit_ui.rs <<'EOF'\n//! Whiff Fit's whole UI: draws a `UiFrame` at a virtual 1920x1080, scaled to fit, on egui's\n//! painter (no default windows), and says what the pointer did. The window and the headless\n//! tools draw it with this same code, so captures show the real thing.\n\nuse egui::epaint::{Shadow, TextShape};\nuse egui::text::LayoutJob;\nuse egui::{Color32, CornerRadius, FontData, FontDefinitions, FontFamily, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, Vec2, pos2, vec2};\nuse glam::{Mat4, Vec3};\nuse pav_core::games::fit::ui_model::*;\nuse pav_core::input::UiEvent;\n\nuse crate::Device;\n\nconst TITLE: &str = \"Fredoka\";\nconst BODY: &str = \"Nunito\";\n\n/// Puts the game's fonts in `ctx`. Call before the context's first pass: a family used in the\n/// pass that installs it panics.\npub fn install_fonts(ctx: &egui::Context) {\n    let mut f = FontDefinitions::default();\n    f.font_data.insert(TITLE.into(), FontData::from_static(include_bytes!(\"../fonts/Fredoka_600SemiBold.ttf\")).into());\n    f.font_data.insert(BODY.into(), FontData::from_static(include_bytes!(\"../fonts/Nunito_700Bold.ttf\")).into());\n    f.families.insert(FontFamily::Name(TITLE.into()), vec![TITLE.into(), BODY.into()]);\n    f.families.insert(FontFamily::Name(BODY.into()), vec![BODY.into()]);\n    ctx.set_fonts(f);\n}\n\n/// What the player's using, as far as prompts care.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct Input {\n    pub device: Device,\n    /// On keyboard and mouse: the mouse moved or clicked last.\n    pub mouse: bool,\n}\n\n/// A glyph for a prompt.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Glyph {\n    Cross,\n    Circle,\n    Square,\n    Triangle,\n    Letter(char, [u8; 3]),\n    Pill(&'static str),\n    Stick(char),\n    Dpad,\n    Key(&'static str),\n    Mouse(MouseBit),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum MouseBit {\n    Left,\n    Right,\n    Both,\n    Move,\n}\n\n/// The one function that says which glyph an action has on the device in use.\npub fn prompt(act: Act, input: Input, xbox: bool) -> Glyph {\n    use Glyph as G;\n    match input.device {\n        Device::Gamepad | Device::Touch => match act {\n            Act::Confirm => {\n                if xbox {\n                    G::Letter('A', [96, 200, 96])\n                } else {\n                    G::Cross\n                }\n            }\n            Act::Back => {\n                if xbox {\n                    G::Letter('B', [230, 90, 90])\n                } else {\n                    G::Circle\n                }\n            }\n            Act::Wave => {\n                if xbox {\n                    G::Letter('X', [90, 140, 230])\n                } else {\n                    G::Square\n                }\n            }\n            Act::Schedule => {\n                if xbox {\n                    G::Letter('Y', [235, 200, 70])\n                } else {\n                    G::Triangle\n                }\n            }\n            Act::Pause => G::Pill(if xbox { \"Menu\" } else { \"Options\" }),\n            Act::StepL | Act::TabL => G::Pill(if xbox { \"LB\" } else { \"L1\" }),\n            Act::StepR | Act::TabR => G::Pill(if xbox { \"RB\" } else { \"R1\" }),\n            Act::Brace => G::Pill(if xbox { \"LB+RB\" } else { \"L1+R1\" }),\n            Act::Lean | Act::Walk => G::Stick('L'),\n            Act::Jog => G::Pill(if xbox { \"RT\" } else { \"R2\" }),\n            Act::Menu => G::Dpad,\n            Act::Camera => G::Stick('R'),\n        },\n        Device::KeyboardMouse => {\n            let m = input.mouse;\n            match act {\n                Act::Confirm => {\n                    if m {\n                        G::Mouse(MouseBit::Left)\n                    } else {\n                        G::Key(\"Space\")\n                    }\n                }\n                Act::Back => {\n                    if m {\n                        G::Mouse(MouseBit::Right)\n                    } else {\n                        G::Key(\"Esc\")\n                    }\n                }\n                Act::Wave => G::Key(\"F\"),\n                Act::Schedule => G::Key(\"Tab\"),\n                Act::Pause => G::Key(\"Esc\"),\n                Act::StepL => {\n                    if m {\n                        G::Mouse(MouseBit::Left)\n                    } else {\n                        G::Key(\"Q\")\n                    }\n                }\n                Act::StepR => {\n                    if m {\n                        G::Mouse(MouseBit::Right)\n                    } else {\n                        G::Key(\"E\")\n                    }\n                }\n                Act::TabL => G::Key(\"Q\"),\n                Act::TabR => G::Key(\"E\"),\n                Act::Brace => {\n                    if m {\n                        G::Mouse(MouseBit::Both)\n                    } else {\n                        G::Key(\"Q+E\")\n                    }\n                }\n                Act::Lean => {\n                    if m {\n                        G::Mouse(MouseBit::Move)\n                    } else {\n                        G::Key(\"W A S D\")\n                    }\n                }\n                Act::Walk => {\n                    if m {\n                        G::Mouse(MouseBit::Left)\n                    } else {\n                        G::Key(\"W A S D\")\n                    }\n                }\n                Act::Jog => G::Key(\"Shift\"),\n                Act::Menu => G::Key(\"W S\"),\n                Act::Camera => G::Mouse(MouseBit::Right),\n            }\n        }\n    }\n}\n\n/// A glyph's name, for tests and the page's `__gameUi`.\npub fn glyph_name(g: Glyph) -> String {\n    match g {\n        Glyph::Cross => \"Cross\".into(),\n        Glyph::Circle => \"Circle\".into(),\n        Glyph::Square => \"Square\".into(),\n        Glyph::Triangle => \"Triangle\".into(),\n        Glyph::Letter(c, _) => c.to_string(),\n        Glyph::Pill(s) | Glyph::Key(s) => s.to_string(),\n        Glyph::Stick(c) => format!(\"{c} Stick\"),\n        Glyph::Dpad => \"D-pad\".into(),\n        Glyph::Mouse(b) => format!(\"Mouse {b:?}\"),\n    }\n}\n\n/// What the pointer did and what is on screen.\n#[derive(Clone, Debug, Default)]\npub struct Output {\n    pub event: Option<UiEvent>,\n    /// The pointer is on an item, so a click there isn't for the game.\n    pub over_item: bool,\n    /// Items in window points: id, rect, label.\n    pub rects: Vec<(u16, [f32; 4], String)>,\n    /// `Glyph:label` of every prompt drawn.\n    pub prompts: Vec<String>,\n}\n\nstruct View<'a> {\n    p: Painter,\n    s: f32,\n    o: Vec2,\n    vp: Mat4,\n    screen: Vec2,\n    input: Input,\n    xbox: bool,\n    prompts: &'a mut Vec<String>,\n}\n\nfn c(rgba: Rgba) -> Color32 {\n    Color32::from_rgba_unmultiplied(rgba[0], rgba[1], rgba[2], rgba[3])\n}\n\nfn title_font(size: f32) -> FontId {\n    FontId::new(size, FontFamily::Name(TITLE.into()))\n}\nfn body_font(size: f32) -> FontId {\n    FontId::new(size, FontFamily::Name(BODY.into()))\n}\n\nimpl View<'_> {\n    fn pt(&self, x: f32, y: f32) -> Pos2 {\n        pos2(self.o.x + x * self.s, self.o.y + y * self.s)\n    }\n    fn rect(&self, r: &[f32; 4]) -> Rect {\n        Rect::from_min_size(self.pt(r[0], r[1]), vec2(r[2] * self.s, r[3] * self.s))\n    }\n    fn radius(&self, r: f32) -> CornerRadius {\n        CornerRadius::same((r * self.s).clamp(0.0, 200.0) as u8)\n    }\n    fn text(&self, at: Pos2, size: f32, font: Font, color: Color32, align: Align, wrap: f32, text: &str) {\n        let id = match font {\n            Font::Title => title_font(size * self.s),\n            Font::Body => body_font(size * self.s),\n        };\n        let mut job = LayoutJob::simple(text.to_string(), id, color, if wrap > 0.0 { wrap * self.s } else { f32::INFINITY });\n        job.halign = match align {\n            Align::Left => egui::Align::LEFT,\n            Align::Center => egui::Align::Center,\n            Align::Right => egui::Align::RIGHT,\n        };\n        let galley = self.p.fonts_mut(|f| f.layout_job(job));\n        self.p.add(TextShape::new(at, galley, color));\n    }\n    fn project(&self, w: Vec3) -> Option<Pos2> {\n        let h = self.vp * w.extend(1.0);\n        if h.w <= 0.01 {\n            return None;\n        }\n        let n = h.truncate() / h.w;\n        Some(pos2((n.x * 0.5 + 0.5) * self.screen.x, (0.5 - n.y * 0.5) * self.screen.y))\n    }\n\n    fn glyph(&self, at: Pos2, g: Glyph, size: f32) -> f32 {\n        // `at` is the glyph's left-middle; returns its width (points).\n        let s = size * self.s;\n        let r = s * 0.5;\n        let center = at + vec2(r, 0.0);\n        let dark = Color32::from_rgb(38, 42, 54);\n        let face = |col: Color32| {\n            self.p.circle_filled(center, r, dark);\n            self.p.circle_stroke(center, r, Stroke::new(s * 0.05, col));\n        };\n        match g {\n            Glyph::Cross => {\n                face(Color32::from_rgb(130, 170, 240));\n                let (k, st) = (r * 0.45, Stroke::new(s * 0.09, Color32::from_rgb(130, 170, 240)));\n                self.p.line_segment([center + vec2(-k, -k), center + vec2(k, k)], st);\n                self.p.line_segment([center + vec2(k, -k), center + vec2(-k, k)], st);\n                s\n            }\n            Glyph::Circle => {\n                face(Color32::from_rgb(240, 110, 120));\n                self.p.circle_stroke(center, r * 0.5, Stroke::new(s * 0.09, Color32::from_rgb(240, 110, 120)));\n                s\n            }\n            Glyph::Square => {\n                face(Color32::from_rgb(230, 140, 200));\n                let k = r * 0.42;\n                self.p.rect_stroke(Rect::from_center_size(center, vec2(k * 2.0, k * 2.0)), 0.0, Stroke::new(s * 0.08, Color32::from_rgb(230, 140, 200)), StrokeKind::Middle);\n                s\n            }\n            Glyph::Triangle => {\n                face(Color32::from_rgb(110, 210, 170));\n                let k = r * 0.5;\n                let st = Stroke::new(s * 0.08, Color32::from_rgb(110, 210, 170));\n                let (a, b, d) = (center + vec2(0.0, -k), center + vec2(-k, k * 0.75), center + vec2(k, k * 0.75));\n                self.p.line_segment([a, b], st);\n                self.p.line_segment([b, d], st);\n                self.p.line_segment([d, a], st);\n                s\n            }\n            Glyph::Letter(l, col) => {\n                self.p.circle_filled(center, r, Color32::from_rgb(col[0], col[1], col[2]));\n                self.text(center - vec2(0.0, s * 0.42), size * 0.68, Font::Title, Color32::WHITE, Align::Center, 0.0, &l.to_string());\n                s\n            }\n            Glyph::Pill(t) => {\n                let w = s * (0.34 + t.len() as f32 * 0.32);\n                let rect = Rect::from_min_size(at - vec2(0.0, r * 0.82), vec2(w, s * 0.82));\n                self.p.rect_filled(rect, r * 0.5, dark);\n                self.text(rect.center() - vec2(0.0, s * 0.31), size * 0.5, Font::Title, Color32::WHITE, Align::Center, 0.0, t);\n                w\n            }\n            Glyph::Stick(l) => {\n                self.p.circle_filled(center, r, dark);\n                self.p.circle_stroke(center, r * 0.62, Stroke::new(s * 0.05, Color32::from_rgb(160, 170, 190)));\n                self.text(center - vec2(0.0, s * 0.31), size * 0.5, Font::Title, Color32::WHITE, Align::Center, 0.0, &l.to_string());\n                s\n            }\n            Glyph::Dpad => {\n                let (k, t) = (r * 0.95, r * 0.36);\n                self.p.rect_filled(Rect::from_center_size(center, vec2(k * 2.0, t * 2.0)), t * 0.4, dark);\n                self.p.rect_filled(Rect::from_center_size(center, vec2(t * 2.0, k * 2.0)), t * 0.4, dark);\n                s\n            }\n            Glyph::Key(t) => {\n                let w = s * (0.5 + t.len() as f32 * 0.3);\n                let rect = Rect::from_min_size(at - vec2(0.0, r * 0.84), vec2(w, s * 0.84));\n                self.p.rect_filled(rect.translate(vec2(0.0, s * 0.06)), s * 0.16, Color32::from_rgb(160, 170, 180));\n                self.p.rect_filled(rect, s * 0.16, Color32::from_rgb(250, 250, 248));\n                self.p.rect_stroke(rect, s * 0.16, Stroke::new(s * 0.03, Color32::from_rgb(120, 134, 148)), StrokeKind::Middle);\n                self.text(rect.center() - vec2(0.0, s * 0.3), (size * 0.5).max(0.1), Font::Title, c(INK), Align::Center, 0.0, t);\n                w\n            }\n            Glyph::Mouse(bit) => {\n                let (w, h) = (s * 0.66, s * 0.96);\n                let rect = Rect::from_center_size(at + vec2(w * 0.5, 0.0), vec2(w, h));\n                self.p.rect_filled(rect, w * 0.46, Color32::from_rgb(250, 250, 248));\n                let lit = Color32::from_rgb(255, 120, 110);\n                let top = Rect::from_min_size(rect.min, vec2(w * 0.5, h * 0.46));\n                let top_r = top.translate(vec2(w * 0.5, 0.0));\n                match bit {\n                    MouseBit::Left => {\n                        self.p.rect_filled(top, w * 0.3, lit);\n                    }\n                    MouseBit::Right => {\n                        self.p.rect_filled(top_r, w * 0.3, lit);\n                    }\n                    MouseBit::Both => {\n                        self.p.rect_filled(top, w * 0.3, lit);\n                        self.p.rect_filled(top_r, w * 0.3, lit);\n                    }\n                    MouseBit::Move => {\n                        let (a, b) = (rect.center() + vec2(-w * 0.9, h * 0.1), rect.center() + vec2(w * 0.9, h * 0.1));\n                        self.p.arrow(rect.center(), a - rect.center(), Stroke::new(s * 0.05, lit));\n                        self.p.arrow(rect.center(), b - rect.center(), Stroke::new(s * 0.05, lit));\n                    }\n                }\n                self.p.rect_stroke(rect, w * 0.46, Stroke::new(s * 0.04, Color32::from_rgb(90, 104, 120)), StrokeKind::Middle);\n                w\n            }\n        }\n    }\n\n    /// A glyph and its label at a point; returns nothing, draws both.\n    fn prompt(&mut self, at: Pos2, size: f32, act: Act, label: &str, color: Color32, align: Align) {\n        let g = prompt(act, self.input, self.xbox);\n        self.prompts.push(format!(\"{}:{label}\", glyph_name(g)));\n        let mut x = at;\n        if align == Align::Right {\n            x.x -= (label.chars().count() as f32 * size * 0.55 + size * 1.3) * self.s;\n        } else if align == Align::Center {\n            x.x -= (label.chars().count() as f32 * size * 0.55 + size * 1.3) * self.s * 0.5;\n        }\n        let w = self.glyph(x, g, size);\n        if !label.is_empty() {\n            let y = x.y - size * 0.62 * self.s;\n            self.text(pos2(x.x + w + size * 0.25 * self.s, y), size * 0.92, Font::Body, color, Align::Left, 0.0, label);\n        }\n    }\n\n    fn star(&self, center: Pos2, r: f32, fill: Color32) {\n        let mut pts = Vec::new();\n        for i in 0..10 {\n            let a = -std::f32::consts::FRAC_PI_2 + i as f32 * std::f32::consts::TAU / 10.0;\n            let rr = if i % 2 == 0 { r } else { r * 0.46 };\n            pts.push(center + vec2(a.cos() * rr, a.sin() * rr));\n        }\n        // A fan of triangles: the star isn't convex.\n        let mut shapes = Vec::new();\n        for i in 0..10 {\n            shapes.push(Shape::convex_polygon(vec![center, pts[i], pts[(i + 1) % 10]], fill, Stroke::NONE));\n        }\n        self.p.extend(shapes);\n    }\n\n    fn puck(&self, k: &Puck) {\n        let center = self.pt(k.c[0], k.c[1]);\n        let r = k.r * self.s;\n        let at = |u: f32, v: f32| center + vec2(u * r * 0.86, -v * r * 0.86);\n        self.p.add(Shadow { offset: [0, 6], blur: 28, spread: 2, color: Color32::from_black_alpha(50) }.as_shape(Rect::from_center_size(center, vec2(r * 2.0, r * 2.0)), CornerRadius::same(r.min(250.0) as u8)));\n        self.p.circle_filled(center, r, Color32::from_rgb(248, 250, 248));\n        let rim = c(TEAL).lerp_to_gamma(c(CORAL), k.danger);\n        self.p.circle_stroke(center, r, Stroke::new(r * 0.05, rim));\n        self.p.circle_stroke(center, r * 0.86, Stroke::new(r * 0.012, Color32::from_rgb(210, 222, 226)));\n        self.p.line_segment([center + vec2(-r * 0.86, 0.0), center + vec2(r * 0.86, 0.0)], Stroke::new(r * 0.008, Color32::from_rgb(220, 230, 232)));\n        self.p.line_segment([center + vec2(0.0, -r * 0.86), center + vec2(0.0, r * 0.86)], Stroke::new(r * 0.008, Color32::from_rgb(220, 230, 232)));\n        let mint = c(MINT);\n        if let Some(b) = k.band {\n            let w = b * r * 0.86;\n            self.p.rect_filled(Rect::from_center_size(center, vec2(w * 2.0, r * 1.5)), w * 0.3, mint.gamma_multiply(0.45));\n        }\n        if let Some([x, y, rad]) = k.ring {\n            let ring = at(x, y);\n            let rr = rad * r * 0.86;\n            let col = if k.good { mint } else { Color32::from_rgb(170, 214, 200) };\n            self.p.circle_filled(ring, rr, col.gamma_multiply(0.28));\n            self.p.circle_stroke(ring, rr, Stroke::new(r * 0.035, col));\n        }\n        if let Some([x, y]) = k.mark {\n            self.p.circle_stroke(at(x, y), r * 0.12, Stroke::new(r * 0.03, c(SUN)));\n        }\n        if k.trace.len() > 1 {\n            let pts: Vec<Pos2> = k.trace.iter().map(|p| at(p[0], p[1])).collect();\n            self.p.add(Shape::line(pts, Stroke::new(r * 0.012, c(TEAL).gamma_multiply(0.6))));\n        }\n        if let Some([x, y]) = k.ghost {\n            self.p.circle_filled(at(x, y), r * 0.075, Color32::from_rgba_unmultiplied(120, 150, 170, 150));\n        }\n        let dot = at(k.dot[0].clamp(-1.15, 1.15), k.dot[1].clamp(-1.15, 1.15));\n        self.p.circle_filled(dot, r * 0.1, c(CORAL));\n        self.p.circle_stroke(dot, r * 0.1, Stroke::new(r * 0.016, Color32::WHITE));\n        for i in 0..k.streak.min(4) {\n            let a = -2.2 + i as f32 * 0.42;\n            self.star(center + vec2(a.cos() * r * 1.12, a.sin() * r * 1.12), r * 0.11, c(SUN));\n        }\n    }\n\n    fn item(&self, it: &Item) {\n        let k = if it.focused { 1.03 + 0.03 * it.bounce } else { 1.0 };\n        let base = self.rect(&it.r);\n        let rect = Rect::from_center_size(base.center(), base.size() * k);\n        let radius = self.radius(28.0);\n        let locked = it.kind == ItemKind::Locked;\n        self.p.add(Shadow { offset: [0, 4], blur: 16, spread: 0, color: Color32::from_black_alpha(28) }.as_shape(rect, radius));\n        let fill = if locked {\n            Color32::from_rgb(232, 236, 238)\n        } else if it.focused {\n            Color32::from_rgb(232, 250, 248)\n        } else {\n            Color32::WHITE\n        };\n        self.p.rect_filled(rect, radius, fill);\n        if it.focused {\n            self.p.rect_stroke(rect, radius, Stroke::new(8.0 * self.s, c(TEAL)), StrokeKind::Outside);\n        }\n        let ink = if locked { c(INK_SOFT) } else { c(INK) };\n        let tall = it.r[3] > 180.0;\n        let pad = 34.0 * self.s;\n        let label_size = if tall { 56.0 } else { 44.0 };\n        if tall {\n            self.text(rect.center() - vec2(0.0, 80.0 * self.s), label_size, Font::Title, ink, Align::Center, it.r[2] - 30.0, &it.label);\n            if !it.sub.is_empty() {\n                self.text(rect.center() + vec2(0.0, 40.0 * self.s), 38.0, Font::Body, c(INK_SOFT), Align::Center, it.r[2] - 30.0, &it.sub);\n            }\n            return;\n        }\n        let ly = rect.center().y - label_size * 0.62 * self.s;\n        match &it.kind {\n            ItemKind::Slider { frac, value } => {\n                self.text(pos2(rect.min.x + pad, ly), label_size, Font::Title, ink, Align::Left, 0.0, &it.label);\n                let (bx, bw) = (rect.min.x + rect.width() * 0.5, rect.width() * 0.33);\n                let by = rect.center().y;\n                let track = Rect::from_min_size(pos2(bx, by - 9.0 * self.s), vec2(bw, 18.0 * self.s));\n                self.p.rect_filled(track, 9.0 * self.s, Color32::from_rgb(216, 228, 232));\n                let f = frac.clamp(0.0, 1.0);\n                self.p.rect_filled(Rect::from_min_size(track.min, vec2(bw * f, track.height())), 9.0 * self.s, c(TEAL));\n                self.p.circle_filled(pos2(bx + bw * f, by), 19.0 * self.s, Color32::WHITE);\n                self.p.circle_stroke(pos2(bx + bw * f, by), 19.0 * self.s, Stroke::new(5.0 * self.s, c(TEAL)));\n                self.text(pos2(rect.max.x - pad, by - 26.0 * self.s), 38.0, Font::Body, c(INK_SOFT), Align::Right, 0.0, value);\n            }\n            ItemKind::Choice { value } => {\n                self.text(pos2(rect.min.x + pad, ly), label_size, Font::Title, ink, Align::Left, 0.0, &it.label);\n                let by = rect.center().y - 26.0 * self.s;\n                let txt = if it.focused { format!(\"<  {value}  >\") } else { value.clone() };\n                self.text(pos2(rect.max.x - pad, by), 40.0, Font::Body, c(TEAL), Align::Right, 0.0, &txt);\n            }\n            _ => {\n                let has_sub = !it.sub.is_empty();\n                self.text(pos2(rect.min.x + pad, ly), label_size, Font::Title, ink, Align::Left, 0.0, &it.label);\n                if has_sub {\n                    let right = rect.max.x - pad - if it.stars.is_some() { 210.0 * self.s } else { 0.0 };\n                    self.text(pos2(right, rect.center().y - 24.0 * self.s), 36.0, Font::Body, c(INK_SOFT), Align::Right, 0.0, &it.sub);\n                }\n                if let Some(n) = it.stars {\n                    for i in 0..3u8 {\n                        let col = if i < n { c(SUN) } else { Color32::from_rgb(222, 230, 232) };\n                        self.star(pos2(rect.max.x - pad - 22.0 * self.s - (2 - i) as f32 * 58.0 * self.s, rect.center().y), 26.0 * self.s, col);\n                    }\n                }\n            }\n        }\n    }\n\n    fn node(&mut self, n: &Node) {\n        match n {\n            Node::Card { r, fill, radius, shadow } => {\n                if r[2] <= 0.0 || r[3] <= 0.0 {\n                    return;\n                }\n                let rect = self.rect(r);\n                let rr = self.radius(*radius);\n                if *shadow {\n                    self.p.add(Shadow { offset: [0, 10], blur: 36, spread: 2, color: Color32::from_black_alpha(46) }.as_shape(rect, rr));\n                }\n                self.p.rect_filled(rect, rr, c(*fill));\n            }\n            Node::Outline { r, color, width, radius } => {\n                self.p.rect_stroke(self.rect(r), self.radius(*radius), Stroke::new(width * self.s, c(*color)), StrokeKind::Outside);\n            }\n            Node::Text { at, size, font, color, align, wrap, text } => {\n                self.text(self.pt(at[0], at[1]), *size, *font, c(*color), *align, *wrap, text);\n            }\n            Node::Prompt { at, size, act, label, align, color } => {\n                self.prompt(self.pt(at[0], at[1]), *size, *act, label, c(*color), *align);\n            }\n            Node::Puck(k) => self.puck(k),\n            Node::Stars { at, n, of, size } => {\n                let s = size * self.s;\n                let gap = s * 2.3;\n                for i in 0..*of {\n                    let x = (i as f32 - (*of as f32 - 1.0) * 0.5) * gap;\n                    let col = if i < *n { c(SUN) } else { Color32::from_rgb(222, 230, 232) };\n                    self.star(self.pt(at[0], at[1]) + vec2(x, 0.0), s, col);\n                }\n            }\n            Node::Bar { r, frac, fill, bg } => {\n                let rect = self.rect(r);\n                let rr = rect.height() * 0.5;\n                self.p.rect_filled(rect, rr, c(*bg));\n                let w = rect.width() * frac.clamp(0.0, 1.0);\n                if w > 0.5 {\n                    self.p.rect_filled(Rect::from_min_size(rect.min, vec2(w, rect.height())), rr, c(*fill));\n                }\n            }\n            Node::Circle { c: at, r, fill, stroke, width } => {\n                let p = self.pt(at[0], at[1]);\n                self.p.circle_filled(p, r * self.s, c(*fill));\n                if *width > 0.0 {\n                    self.p.circle_stroke(p, r * self.s, Stroke::new(width * self.s, c(*stroke)));\n                }\n            }\n            Node::Line { pts, width, color } => {\n                let pts: Vec<Pos2> = pts.iter().map(|p| self.pt(p[0], p[1])).collect();\n                self.p.add(Shape::line(pts, Stroke::new(width * self.s, c(*color))));\n            }\n            Node::Fade { color } => {\n                self.p.rect_filled(Rect::from_min_size(Pos2::ZERO, self.screen), 0.0, c(*color));\n            }\n            Node::WorldText { pos, size, color, text } => {\n                if let Some(at) = self.project(*pos) {\n                    self.text(at, *size, Font::Title, c(*color), Align::Center, 0.0, text);\n                }\n            }\n            Node::WorldPrompt { pos, act, label } => {\n                if let Some(at) = self.project(*pos) {\n                    let w = (label.chars().count() as f32 * 24.0 + 100.0) * self.s;\n                    let rect = Rect::from_center_size(at, vec2(w, 72.0 * self.s));\n                    self.p.add(Shadow { offset: [0, 4], blur: 14, spread: 0, color: Color32::from_black_alpha(40) }.as_shape(rect, self.radius(36.0)));\n                    self.p.rect_filled(rect, self.radius(36.0), Color32::WHITE);\n                    self.prompt(pos2(rect.min.x + 18.0 * self.s, at.y), 40.0, *act, label, c(INK), Align::Left);\n                }\n            }\n            Node::WorldRing { pos, r, color } => {\n                let pts: Vec<Pos2> = (0..=32)\n                    .filter_map(|i| {\n                        let a = i as f32 / 32.0 * std::f32::consts::TAU;\n                        self.project(*pos + Vec3::new(a.cos() * r, 0.0, a.sin() * r))\n                    })\n                    .collect();\n                if pts.len() > 2 {\n                    self.p.add(Shape::line(pts, Stroke::new(6.0 * self.s, c(*color))));\n                }\n            }\n        }\n    }\n}\n\n/// Text anchored in the world, from the host (other players' names).\npub struct WorldLabel {\n    pub pos: Vec3,\n    pub text: String,\n    pub color: [u8; 3],\n}\n\n/// Draws the frame. `input` says which glyphs to use; `vp` projects world anchors.\npub fn draw(ctx: &egui::Context, f: &UiFrame, input: Input, vp: Mat4, labels: &[WorldLabel]) -> Output {\n    let screen = ctx.content_rect();\n    let (w, h) = (screen.width(), screen.height());\n    let s = (w / 1920.0).min(h / 1080.0);\n    let o = vec2((w - 1920.0 * s) * 0.5, (h - 1080.0 * s) * 0.5);\n    let p = ctx.layer_painter(egui::LayerId::new(egui::Order::Middle, egui::Id::new(\"fit_ui\")));\n    let mut out = Output::default();\n    let mut prompts = Vec::new();\n    {\n        let mut v = View { p, s, o, vp, screen: vec2(w, h), input, xbox: f.xbox, prompts: &mut prompts };\n        for n in &f.nodes {\n            v.node(n);\n        }\n        for it in &f.items {\n            v.item(it);\n        }\n        for n in &f.top {\n            v.node(n);\n        }\n        for l in labels {\n            if let Some(at) = v.project(l.pos) {\n                let color = Color32::from_rgb(l.color[0], l.color[1], l.color[2]);\n                v.text(at, 40.0, Font::Title, color, Align::Center, 0.0, &l.text);\n            }\n        }\n        for it in &f.items {\n            let r = v.rect(&it.r);\n            out.rects.push((it.id, [r.min.x, r.min.y, r.width(), r.height()], it.label.clone()));\n        }\n        // The pointer.\n        let (hover, moved, clicked, down) = ctx.input(|i| {\n            let moving = i.pointer.delta().length_sq() > 0.0 || i.pointer.any_pressed();\n            (i.pointer.interact_pos().or(i.pointer.hover_pos()), moving, i.pointer.primary_clicked(), i.pointer.primary_down())\n        });\n        if let Some(at) = hover {\n            let on = f.items.iter().find(|it| v.rect(&it.r).contains(at));\n            if let Some(it) = on {\n                out.over_item = true;\n                if clicked {\n                    out.event = Some(UiEvent::Click(it.id));\n                } else if down && matches!(it.kind, ItemKind::Slider { .. }) {\n                    let rect = v.rect(&it.r);\n                    let (bx, bw) = (rect.min.x + rect.width() * 0.5, rect.width() * 0.33);\n                    if at.x >= bx - 20.0 * s {\n                        out.event = Some(UiEvent::Slider(it.id, ((at.x - bx) / bw).clamp(0.0, 1.0)));\n                    }\n                } else if moved {\n                    out.event = Some(UiEvent::Hover(it.id));\n                }\n                if matches!(it.kind, ItemKind::Slider { .. }) && clicked {\n                    let rect = v.rect(&it.r);\n                    let (bx, bw) = (rect.min.x + rect.width() * 0.5, rect.width() * 0.33);\n                    if at.x >= bx - 20.0 * s {\n                        out.event = Some(UiEvent::Slider(it.id, ((at.x - bx) / bw).clamp(0.0, 1.0)));\n                    }\n                }\n            }\n        }\n    }\n    out.prompts = prompts;\n    out\n}\n\n/// A plain-text reading of what's on screen for tests that have no painter.\npub fn item_rects(f: &UiFrame) -> Vec<(u16, [f32; 4])> {\n    f.items.iter().map(|i| (i.id, i.r)).collect()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn prompts_follow_the_device_and_the_glyph_setting() {\n        let pad = Input { device: Device::Gamepad, mouse: false };\n        let keys = Input { device: Device::KeyboardMouse, mouse: false };\n        let mouse = Input { device: Device::KeyboardMouse, mouse: true };\n        assert_eq!(prompt(Act::Confirm, pad, false), Glyph::Cross);\n        assert_eq!(prompt(Act::Back, pad, false), Glyph::Circle);\n        assert_eq!(prompt(Act::Wave, pad, false), Glyph::Square);\n        assert_eq!(prompt(Act::Schedule, pad, false), Glyph::Triangle);\n        assert_eq!(prompt(Act::StepL, pad, false), Glyph::Pill(\"L1\"));\n        assert_eq!(prompt(Act::Pause, pad, false), Glyph::Pill(\"Options\"));\n        assert_eq!(glyph_name(prompt(Act::Confirm, pad, true)), \"A\");\n        assert_eq!(glyph_name(prompt(Act::Back, pad, true)), \"B\");\n        assert_eq!(glyph_name(prompt(Act::Wave, pad, true)), \"X\");\n        assert_eq!(glyph_name(prompt(Act::Schedule, pad, true)), \"Y\");\n        assert_eq!(prompt(Act::StepR, pad, true), Glyph::Pill(\"RB\"));\n        assert_eq!(prompt(Act::Pause, pad, true), Glyph::Pill(\"Menu\"));\n        assert_eq!(prompt(Act::Confirm, keys, false), Glyph::Key(\"Space\"));\n        assert_eq!(prompt(Act::Schedule, keys, true), Glyph::Key(\"Tab\"));\n        assert_eq!(prompt(Act::Confirm, mouse, false), Glyph::Mouse(MouseBit::Left));\n        assert_eq!(prompt(Act::Lean, mouse, false), Glyph::Mouse(MouseBit::Move));\n    }\n\n    #[test]\n    fn a_frame_draws_and_the_pointer_lands_on_items() {\n        let ctx = egui::Context::default();\n        install_fonts(&ctx);\n        let mut ui = Ui::default();\n        ui.title(960.0, 100.0, 96.0, INK, Align::Center, \"Whiff Fit\");\n        ui.puck(Puck { c: [960.0, 500.0], r: 170.0, ring: Some([0.1, 0.1, 0.3]), ..Default::default() });\n        ui.prompt_row(&[(Act::Confirm, \"Begin\"), (Act::Back, \"Leave\")]);\n        ui.f.items.push(Item { id: 3, r: [100.0, 100.0, 400.0, 100.0], label: \"Hi\".into(), sub: String::new(), kind: ItemKind::Button, focused: true, bounce: 0.0, stars: Some(2) });\n        let raw = |events: Vec<egui::Event>| egui::RawInput {\n            screen_rect: Some(Rect::from_min_size(Pos2::ZERO, vec2(1920.0, 1080.0))),\n            events,\n            ..Default::default()\n        };\n        let mut out = Output::default();\n        let input = Input { device: Device::Gamepad, mouse: false };\n        let frame = ui.f;\n        let _ = ctx.run_ui(raw(vec![]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        assert_eq!(out.rects.len(), 1);\n        assert!(out.prompts.iter().any(|p| p == \"Cross:Begin\"), \"{:?}\", out.prompts);\n        // Hover at the item, then click.\n        let at = pos2(200.0, 150.0);\n        let _ = ctx.run_ui(raw(vec![egui::Event::PointerMoved(at)]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        assert_eq!(out.event, Some(UiEvent::Hover(3)));\n        let press = |pressed| egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: Default::default() };\n        let _ = ctx.run_ui(raw(vec![press(true)]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        let _ = ctx.run_ui(raw(vec![press(false)]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        assert_eq!(out.event, Some(UiEvent::Click(3)));\n    }\n}\nEOF\npython3 - <<'EOF'\ndef patch(path, pairs):\n    s = open(path).read()\n    for a, b in pairs:\n        assert a in s, (path, a[:70])\n        s = s.replace(a, b, 1)\n    open(path, 'w').write(s)\npatch('crates/pav_ui/src/lib.rs', [(\"\"\"pub mod arpg_ui;\n\"\"\",\"\"\"pub mod arpg_ui;\npub mod fit_ui;\n\"\"\")])\npatch('crates/pav_ui/src/headless.rs', [\n(\"\"\"        let ctx = egui::Context::default();\n        let touch = self.device == Device::Touch;\"\"\",\"\"\"        let ctx = egui::Context::default();\n        if hud_lines.fit.is_some() {\n            crate::fit_ui::install_fonts(&ctx);\n        }\n        let touch = self.device == Device::Touch;\"\"\"),\n(\"\"\"                crate::game_lines(&ctx, hud_lines);\n\"\"\",\"\"\"                crate::game_lines(&ctx, hud_lines);\n                if let Some(f) = &hud_lines.fit {\n                    let input = crate::fit_ui::Input { device: self.device, mouse: false };\n                    crate::fit_ui::draw(&ctx, f, input, vp, &[]);\n                }\n\"\"\"),\n])\npatch('crates/pav_tools/src/session.rs', [\n(\"\"\"    frame.game.is_some() || !frame.hud.lines.is_empty()\n\"\"\",\"\"\"    frame.game.is_some() || !frame.hud.lines.is_empty() || frame.hud.fit.is_some()\n\"\"\"),\n])\nEOF\ngrep -n \"ui::\\|camera_yaw\\|fn view_for\" crates/pav_tools/src/session.rs | head; sed -n 252,290p crates/pav_tools/src/session.rs; cat crates/pav_ui/Cargo.toml | sed -n 5,30p; sed -i 's/ai = \\\"idle\\\"/ai = { type = \\\"idle\\\" }/' crates/pav_core/src/games/fit/sets/*.toml; python3 ../tools/make_sets.py; CARGO_BUILD_JOBS=8 cargo build --locked -p pav_tools --bin pav --message-format=short 2>&1 | grep -E \"^(crates|error)|Finished\" | cut -c1-220 | head -40","description":"Write the fit UI renderer, wire headless tools, rebuild pav","timeout":500000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20720,"cache_read_input_tokens":556281,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20720},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"8b42100a-8f78-4e71-a19a-1ec1f7ef4f1f","timestamp":"2026-11-05T06:27:10.927Z","request_id":"req_011CgjJYRVW9tMzmsU2KPQ4p","wire_tool_inputs":{"toolu_01MtD78KgxZ2JhN7Qk3Kevko":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine && grep -n \"pub enum AiDef\" -A30 crates/pav_core/src/ai.rs | head -50; sed -i 's/def npc(self, name, kind, x, z, yaw=0.0, y=0.0, ai=\"idle\", \\*\\*k):/def npc(self, name, kind, x, z, yaw=0.0, y=0.0, ai={\"type\": \"idle\"}, **k):/' ../tools/make_sets.py; cat > crates/pav_ui/src/fit_ui.rs <<'EOF'\n//! Whiff Fit's whole UI: draws a `UiFrame` at a virtual 1920x1080, scaled to fit, on egui's\n//! painter (no default windows), and says what the pointer did. The window and the headless\n//! tools draw it with this same code, so captures show the real thing.\n\nuse egui::epaint::{Shadow, TextShape};\nuse egui::text::LayoutJob;\nuse egui::{Color32, CornerRadius, FontData, FontDefinitions, FontFamily, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, Vec2, pos2, vec2};\nuse glam::{Mat4, Vec3};\nuse pav_core::games::fit::ui_model::*;\nuse pav_core::input::UiEvent;\n\nuse crate::Device;\n\nconst TITLE: &str = \"Fredoka\";\nconst BODY: &str = \"Nunito\";\n\n/// Puts the game's fonts in `ctx`. Call before the context's first pass: a family used in the\n/// pass that installs it panics.\npub fn install_fonts(ctx: &egui::Context) {\n    let mut f = FontDefinitions::default();\n    f.font_data.insert(TITLE.into(), FontData::from_static(include_bytes!(\"../fonts/Fredoka_600SemiBold.ttf\")).into());\n    f.font_data.insert(BODY.into(), FontData::from_static(include_bytes!(\"../fonts/Nunito_700Bold.ttf\")).into());\n    f.families.insert(FontFamily::Name(TITLE.into()), vec![TITLE.into(), BODY.into()]);\n    f.families.insert(FontFamily::Name(BODY.into()), vec![BODY.into()]);\n    ctx.set_fonts(f);\n}\n\n/// What the player's using, as far as prompts care.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct Input {\n    pub device: Device,\n    /// On keyboard and mouse: the mouse moved or clicked last.\n    pub mouse: bool,\n}\n\n/// A glyph for a prompt.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Glyph {\n    Cross,\n    Circle,\n    Square,\n    Triangle,\n    Letter(char, [u8; 3]),\n    Pill(&'static str),\n    Stick(char),\n    Dpad,\n    Key(&'static str),\n    Mouse(MouseBit),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum MouseBit {\n    Left,\n    Right,\n    Both,\n    Move,\n}\n\n/// The one function that says which glyph an action has on the device in use.\npub fn prompt(act: Act, input: Input, xbox: bool) -> Glyph {\n    use Glyph as G;\n    match input.device {\n        Device::Gamepad | Device::Touch => match act {\n            Act::Confirm => {\n                if xbox {\n                    G::Letter('A', [96, 200, 96])\n                } else {\n                    G::Cross\n                }\n            }\n            Act::Back => {\n                if xbox {\n                    G::Letter('B', [230, 90, 90])\n                } else {\n                    G::Circle\n                }\n            }\n            Act::Wave => {\n                if xbox {\n                    G::Letter('X', [90, 140, 230])\n                } else {\n                    G::Square\n                }\n            }\n            Act::Schedule => {\n                if xbox {\n                    G::Letter('Y', [235, 200, 70])\n                } else {\n                    G::Triangle\n                }\n            }\n            Act::Pause => G::Pill(if xbox { \"Menu\" } else { \"Options\" }),\n            Act::StepL | Act::TabL => G::Pill(if xbox { \"LB\" } else { \"L1\" }),\n            Act::StepR | Act::TabR => G::Pill(if xbox { \"RB\" } else { \"R1\" }),\n            Act::Brace => G::Pill(if xbox { \"LB+RB\" } else { \"L1+R1\" }),\n            Act::Lean | Act::Walk => G::Stick('L'),\n            Act::Jog => G::Pill(if xbox { \"RT\" } else { \"R2\" }),\n            Act::Menu => G::Dpad,\n            Act::Camera => G::Stick('R'),\n        },\n        Device::KeyboardMouse => {\n            let m = input.mouse;\n            match act {\n                Act::Confirm => {\n                    if m {\n                        G::Mouse(MouseBit::Left)\n                    } else {\n                        G::Key(\"Space\")\n                    }\n                }\n                Act::Back => {\n                    if m {\n                        G::Mouse(MouseBit::Right)\n                    } else {\n                        G::Key(\"Esc\")\n                    }\n                }\n                Act::Wave => G::Key(\"F\"),\n                Act::Schedule => G::Key(\"Tab\"),\n                Act::Pause => G::Key(\"Esc\"),\n                Act::StepL => {\n                    if m {\n                        G::Mouse(MouseBit::Left)\n                    } else {\n                        G::Key(\"Q\")\n                    }\n                }\n                Act::StepR => {\n                    if m {\n                        G::Mouse(MouseBit::Right)\n                    } else {\n                        G::Key(\"E\")\n                    }\n                }\n                Act::TabL => G::Key(\"Q\"),\n                Act::TabR => G::Key(\"E\"),\n                Act::Brace => {\n                    if m {\n                        G::Mouse(MouseBit::Both)\n                    } else {\n                        G::Key(\"Q+E\")\n                    }\n                }\n                Act::Lean => {\n                    if m {\n                        G::Mouse(MouseBit::Move)\n                    } else {\n                        G::Key(\"W A S D\")\n                    }\n                }\n                Act::Walk => {\n                    if m {\n                        G::Mouse(MouseBit::Left)\n                    } else {\n                        G::Key(\"W A S D\")\n                    }\n                }\n                Act::Jog => G::Key(\"Shift\"),\n                Act::Menu => G::Key(\"W S\"),\n                Act::Camera => G::Mouse(MouseBit::Right),\n            }\n        }\n    }\n}\n\n/// A glyph's name, for tests and the page's `__gameUi`.\npub fn glyph_name(g: Glyph) -> String {\n    match g {\n        Glyph::Cross => \"Cross\".into(),\n        Glyph::Circle => \"Circle\".into(),\n        Glyph::Square => \"Square\".into(),\n        Glyph::Triangle => \"Triangle\".into(),\n        Glyph::Letter(c, _) => c.to_string(),\n        Glyph::Pill(s) | Glyph::Key(s) => s.to_string(),\n        Glyph::Stick(c) => format!(\"{c} Stick\"),\n        Glyph::Dpad => \"D-pad\".into(),\n        Glyph::Mouse(b) => format!(\"Mouse {b:?}\"),\n    }\n}\n\n/// What the pointer did and what is on screen.\n#[derive(Clone, Debug, Default)]\npub struct Output {\n    pub event: Option<UiEvent>,\n    /// The pointer is on an item, so a click there isn't for the game.\n    pub over_item: bool,\n    /// Items in window points: id, rect, label.\n    pub rects: Vec<(u16, [f32; 4], String)>,\n    /// `Glyph:label` of every prompt drawn.\n    pub prompts: Vec<String>,\n}\n\nstruct View<'a> {\n    p: Painter,\n    s: f32,\n    o: Vec2,\n    vp: Mat4,\n    screen: Vec2,\n    input: Input,\n    xbox: bool,\n    prompts: &'a mut Vec<String>,\n}\n\nfn c(rgba: Rgba) -> Color32 {\n    Color32::from_rgba_unmultiplied(rgba[0], rgba[1], rgba[2], rgba[3])\n}\n\nfn title_font(size: f32) -> FontId {\n    FontId::new(size, FontFamily::Name(TITLE.into()))\n}\nfn body_font(size: f32) -> FontId {\n    FontId::new(size, FontFamily::Name(BODY.into()))\n}\n\nimpl View<'_> {\n    fn pt(&self, x: f32, y: f32) -> Pos2 {\n        pos2(self.o.x + x * self.s, self.o.y + y * self.s)\n    }\n    fn rect(&self, r: &[f32; 4]) -> Rect {\n        Rect::from_min_size(self.pt(r[0], r[1]), vec2(r[2] * self.s, r[3] * self.s))\n    }\n    fn radius(&self, r: f32) -> CornerRadius {\n        CornerRadius::same((r * self.s).clamp(0.0, 200.0) as u8)\n    }\n    fn text(&self, at: Pos2, size: f32, font: Font, color: Color32, align: Align, wrap: f32, text: &str) {\n        let id = match font {\n            Font::Title => title_font(size * self.s),\n            Font::Body => body_font(size * self.s),\n        };\n        let mut job = LayoutJob::simple(text.to_string(), id, color, if wrap > 0.0 { wrap * self.s } else { f32::INFINITY });\n        job.halign = match align {\n            Align::Left => egui::Align::LEFT,\n            Align::Center => egui::Align::Center,\n            Align::Right => egui::Align::RIGHT,\n        };\n        let galley = self.p.fonts_mut(|f| f.layout_job(job));\n        self.p.add(TextShape::new(at, galley, color));\n    }\n    fn project(&self, w: Vec3) -> Option<Pos2> {\n        let h = self.vp * w.extend(1.0);\n        if h.w <= 0.01 {\n            return None;\n        }\n        let n = h.truncate() / h.w;\n        Some(pos2((n.x * 0.5 + 0.5) * self.screen.x, (0.5 - n.y * 0.5) * self.screen.y))\n    }\n\n    fn glyph(&self, at: Pos2, g: Glyph, size: f32) -> f32 {\n        // `at` is the glyph's left-middle; returns its width (points).\n        let s = size * self.s;\n        let r = s * 0.5;\n        let center = at + vec2(r, 0.0);\n        let dark = Color32::from_rgb(38, 42, 54);\n        let face = |col: Color32| {\n            self.p.circle_filled(center, r, dark);\n            self.p.circle_stroke(center, r, Stroke::new(s * 0.05, col));\n        };\n        match g {\n            Glyph::Cross => {\n                face(Color32::from_rgb(130, 170, 240));\n                let (k, st) = (r * 0.45, Stroke::new(s * 0.09, Color32::from_rgb(130, 170, 240)));\n                self.p.line_segment([center + vec2(-k, -k), center + vec2(k, k)], st);\n                self.p.line_segment([center + vec2(k, -k), center + vec2(-k, k)], st);\n                s\n            }\n            Glyph::Circle => {\n                face(Color32::from_rgb(240, 110, 120));\n                self.p.circle_stroke(center, r * 0.5, Stroke::new(s * 0.09, Color32::from_rgb(240, 110, 120)));\n                s\n            }\n            Glyph::Square => {\n                face(Color32::from_rgb(230, 140, 200));\n                let k = r * 0.42;\n                self.p.rect_stroke(Rect::from_center_size(center, vec2(k * 2.0, k * 2.0)), 0.0, Stroke::new(s * 0.08, Color32::from_rgb(230, 140, 200)), StrokeKind::Middle);\n                s\n            }\n            Glyph::Triangle => {\n                face(Color32::from_rgb(110, 210, 170));\n                let k = r * 0.5;\n                let st = Stroke::new(s * 0.08, Color32::from_rgb(110, 210, 170));\n                let (a, b, d) = (center + vec2(0.0, -k), center + vec2(-k, k * 0.75), center + vec2(k, k * 0.75));\n                self.p.line_segment([a, b], st);\n                self.p.line_segment([b, d], st);\n                self.p.line_segment([d, a], st);\n                s\n            }\n            Glyph::Letter(l, col) => {\n                self.p.circle_filled(center, r, Color32::from_rgb(col[0], col[1], col[2]));\n                self.text(center - vec2(0.0, s * 0.42), size * 0.68, Font::Title, Color32::WHITE, Align::Center, 0.0, &l.to_string());\n                s\n            }\n            Glyph::Pill(t) => {\n                let w = s * (0.34 + t.len() as f32 * 0.32);\n                let rect = Rect::from_min_size(at - vec2(0.0, r * 0.82), vec2(w, s * 0.82));\n                self.p.rect_filled(rect, r * 0.5, dark);\n                self.text(rect.center() - vec2(0.0, s * 0.31), size * 0.5, Font::Title, Color32::WHITE, Align::Center, 0.0, t);\n                w\n            }\n            Glyph::Stick(l) => {\n                self.p.circle_filled(center, r, dark);\n                self.p.circle_stroke(center, r * 0.62, Stroke::new(s * 0.05, Color32::from_rgb(160, 170, 190)));\n                self.text(center - vec2(0.0, s * 0.31), size * 0.5, Font::Title, Color32::WHITE, Align::Center, 0.0, &l.to_string());\n                s\n            }\n            Glyph::Dpad => {\n                let (k, t) = (r * 0.95, r * 0.36);\n                self.p.rect_filled(Rect::from_center_size(center, vec2(k * 2.0, t * 2.0)), t * 0.4, dark);\n                self.p.rect_filled(Rect::from_center_size(center, vec2(t * 2.0, k * 2.0)), t * 0.4, dark);\n                s\n            }\n            Glyph::Key(t) => {\n                let w = s * (0.5 + t.len() as f32 * 0.3);\n                let rect = Rect::from_min_size(at - vec2(0.0, r * 0.84), vec2(w, s * 0.84));\n                self.p.rect_filled(rect.translate(vec2(0.0, s * 0.06)), s * 0.16, Color32::from_rgb(160, 170, 180));\n                self.p.rect_filled(rect, s * 0.16, Color32::from_rgb(250, 250, 248));\n                self.p.rect_stroke(rect, s * 0.16, Stroke::new(s * 0.03, Color32::from_rgb(120, 134, 148)), StrokeKind::Middle);\n                self.text(rect.center() - vec2(0.0, s * 0.3), (size * 0.5).max(0.1), Font::Title, c(INK), Align::Center, 0.0, t);\n                w\n            }\n            Glyph::Mouse(bit) => {\n                let (w, h) = (s * 0.66, s * 0.96);\n                let rect = Rect::from_center_size(at + vec2(w * 0.5, 0.0), vec2(w, h));\n                self.p.rect_filled(rect, w * 0.46, Color32::from_rgb(250, 250, 248));\n                let lit = Color32::from_rgb(255, 120, 110);\n                let top = Rect::from_min_size(rect.min, vec2(w * 0.5, h * 0.46));\n                let top_r = top.translate(vec2(w * 0.5, 0.0));\n                match bit {\n                    MouseBit::Left => {\n                        self.p.rect_filled(top, w * 0.3, lit);\n                    }\n                    MouseBit::Right => {\n                        self.p.rect_filled(top_r, w * 0.3, lit);\n                    }\n                    MouseBit::Both => {\n                        self.p.rect_filled(top, w * 0.3, lit);\n                        self.p.rect_filled(top_r, w * 0.3, lit);\n                    }\n                    MouseBit::Move => {\n                        let (a, b) = (rect.center() + vec2(-w * 0.9, h * 0.1), rect.center() + vec2(w * 0.9, h * 0.1));\n                        self.p.arrow(rect.center(), a - rect.center(), Stroke::new(s * 0.05, lit));\n                        self.p.arrow(rect.center(), b - rect.center(), Stroke::new(s * 0.05, lit));\n                    }\n                }\n                self.p.rect_stroke(rect, w * 0.46, Stroke::new(s * 0.04, Color32::from_rgb(90, 104, 120)), StrokeKind::Middle);\n                w\n            }\n        }\n    }\n\n    /// A glyph and its label at a point; returns nothing, draws both.\n    fn prompt(&mut self, at: Pos2, size: f32, act: Act, label: &str, color: Color32, align: Align) {\n        let g = prompt(act, self.input, self.xbox);\n        self.prompts.push(format!(\"{}:{label}\", glyph_name(g)));\n        let mut x = at;\n        if align == Align::Right {\n            x.x -= (label.chars().count() as f32 * size * 0.55 + size * 1.3) * self.s;\n        } else if align == Align::Center {\n            x.x -= (label.chars().count() as f32 * size * 0.55 + size * 1.3) * self.s * 0.5;\n        }\n        let w = self.glyph(x, g, size);\n        if !label.is_empty() {\n            let y = x.y - size * 0.62 * self.s;\n            self.text(pos2(x.x + w + size * 0.25 * self.s, y), size * 0.92, Font::Body, color, Align::Left, 0.0, label);\n        }\n    }\n\n    fn star(&self, center: Pos2, r: f32, fill: Color32) {\n        let mut pts = Vec::new();\n        for i in 0..10 {\n            let a = -std::f32::consts::FRAC_PI_2 + i as f32 * std::f32::consts::TAU / 10.0;\n            let rr = if i % 2 == 0 { r } else { r * 0.46 };\n            pts.push(center + vec2(a.cos() * rr, a.sin() * rr));\n        }\n        // A fan of triangles: the star isn't convex.\n        let mut shapes = Vec::new();\n        for i in 0..10 {\n            shapes.push(Shape::convex_polygon(vec![center, pts[i], pts[(i + 1) % 10]], fill, Stroke::NONE));\n        }\n        self.p.extend(shapes);\n    }\n\n    fn puck(&self, k: &Puck) {\n        let center = self.pt(k.c[0], k.c[1]);\n        let r = k.r * self.s;\n        let at = |u: f32, v: f32| center + vec2(u * r * 0.86, -v * r * 0.86);\n        self.p.add(Shadow { offset: [0, 6], blur: 28, spread: 2, color: Color32::from_black_alpha(50) }.as_shape(Rect::from_center_size(center, vec2(r * 2.0, r * 2.0)), CornerRadius::same(r.min(250.0) as u8)));\n        self.p.circle_filled(center, r, Color32::from_rgb(248, 250, 248));\n        let rim = c(TEAL).lerp_to_gamma(c(CORAL), k.danger);\n        self.p.circle_stroke(center, r, Stroke::new(r * 0.05, rim));\n        self.p.circle_stroke(center, r * 0.86, Stroke::new(r * 0.012, Color32::from_rgb(210, 222, 226)));\n        self.p.line_segment([center + vec2(-r * 0.86, 0.0), center + vec2(r * 0.86, 0.0)], Stroke::new(r * 0.008, Color32::from_rgb(220, 230, 232)));\n        self.p.line_segment([center + vec2(0.0, -r * 0.86), center + vec2(0.0, r * 0.86)], Stroke::new(r * 0.008, Color32::from_rgb(220, 230, 232)));\n        let mint = c(MINT);\n        if let Some(b) = k.band {\n            let w = b * r * 0.86;\n            self.p.rect_filled(Rect::from_center_size(center, vec2(w * 2.0, r * 1.5)), w * 0.3, mint.gamma_multiply(0.45));\n        }\n        if let Some([x, y, rad]) = k.ring {\n            let ring = at(x, y);\n            let rr = rad * r * 0.86;\n            let col = if k.good { mint } else { Color32::from_rgb(170, 214, 200) };\n            self.p.circle_filled(ring, rr, col.gamma_multiply(0.28));\n            self.p.circle_stroke(ring, rr, Stroke::new(r * 0.035, col));\n        }\n        if let Some([x, y]) = k.mark {\n            self.p.circle_stroke(at(x, y), r * 0.12, Stroke::new(r * 0.03, c(SUN)));\n        }\n        if k.trace.len() > 1 {\n            let pts: Vec<Pos2> = k.trace.iter().map(|p| at(p[0], p[1])).collect();\n            self.p.add(Shape::line(pts, Stroke::new(r * 0.012, c(TEAL).gamma_multiply(0.6))));\n        }\n        if let Some([x, y]) = k.ghost {\n            self.p.circle_filled(at(x, y), r * 0.075, Color32::from_rgba_unmultiplied(120, 150, 170, 150));\n        }\n        let dot = at(k.dot[0].clamp(-1.15, 1.15), k.dot[1].clamp(-1.15, 1.15));\n        self.p.circle_filled(dot, r * 0.1, c(CORAL));\n        self.p.circle_stroke(dot, r * 0.1, Stroke::new(r * 0.016, Color32::WHITE));\n        for i in 0..k.streak.min(4) {\n            let a = -2.2 + i as f32 * 0.42;\n            self.star(center + vec2(a.cos() * r * 1.12, a.sin() * r * 1.12), r * 0.11, c(SUN));\n        }\n    }\n\n    fn item(&self, it: &Item) {\n        let k = if it.focused { 1.03 + 0.03 * it.bounce } else { 1.0 };\n        let base = self.rect(&it.r);\n        let rect = Rect::from_center_size(base.center(), base.size() * k);\n        let radius = self.radius(28.0);\n        let locked = it.kind == ItemKind::Locked;\n        self.p.add(Shadow { offset: [0, 4], blur: 16, spread: 0, color: Color32::from_black_alpha(28) }.as_shape(rect, radius));\n        let fill = if locked {\n            Color32::from_rgb(232, 236, 238)\n        } else if it.focused {\n            Color32::from_rgb(232, 250, 248)\n        } else {\n            Color32::WHITE\n        };\n        self.p.rect_filled(rect, radius, fill);\n        if it.focused {\n            self.p.rect_stroke(rect, radius, Stroke::new(8.0 * self.s, c(TEAL)), StrokeKind::Outside);\n        }\n        let ink = if locked { c(INK_SOFT) } else { c(INK) };\n        let tall = it.r[3] > 180.0;\n        let pad = 34.0 * self.s;\n        let label_size = if tall { 56.0 } else { 44.0 };\n        if tall {\n            self.text(rect.center() - vec2(0.0, 80.0 * self.s), label_size, Font::Title, ink, Align::Center, it.r[2] - 30.0, &it.label);\n            if !it.sub.is_empty() {\n                self.text(rect.center() + vec2(0.0, 40.0 * self.s), 38.0, Font::Body, c(INK_SOFT), Align::Center, it.r[2] - 30.0, &it.sub);\n            }\n            return;\n        }\n        let ly = rect.center().y - label_size * 0.62 * self.s;\n        match &it.kind {\n            ItemKind::Slider { frac, value } => {\n                self.text(pos2(rect.min.x + pad, ly), label_size, Font::Title, ink, Align::Left, 0.0, &it.label);\n                let (bx, bw) = (rect.min.x + rect.width() * 0.5, rect.width() * 0.33);\n                let by = rect.center().y;\n                let track = Rect::from_min_size(pos2(bx, by - 9.0 * self.s), vec2(bw, 18.0 * self.s));\n                self.p.rect_filled(track, 9.0 * self.s, Color32::from_rgb(216, 228, 232));\n                let f = frac.clamp(0.0, 1.0);\n                self.p.rect_filled(Rect::from_min_size(track.min, vec2(bw * f, track.height())), 9.0 * self.s, c(TEAL));\n                self.p.circle_filled(pos2(bx + bw * f, by), 19.0 * self.s, Color32::WHITE);\n                self.p.circle_stroke(pos2(bx + bw * f, by), 19.0 * self.s, Stroke::new(5.0 * self.s, c(TEAL)));\n                self.text(pos2(rect.max.x - pad, by - 26.0 * self.s), 38.0, Font::Body, c(INK_SOFT), Align::Right, 0.0, value);\n            }\n            ItemKind::Choice { value } => {\n                self.text(pos2(rect.min.x + pad, ly), label_size, Font::Title, ink, Align::Left, 0.0, &it.label);\n                let by = rect.center().y - 26.0 * self.s;\n                let txt = if it.focused { format!(\"<  {value}  >\") } else { value.clone() };\n                self.text(pos2(rect.max.x - pad, by), 40.0, Font::Body, c(TEAL), Align::Right, 0.0, &txt);\n            }\n            _ => {\n                let has_sub = !it.sub.is_empty();\n                self.text(pos2(rect.min.x + pad, ly), label_size, Font::Title, ink, Align::Left, 0.0, &it.label);\n                if has_sub {\n                    let right = rect.max.x - pad - if it.stars.is_some() { 210.0 * self.s } else { 0.0 };\n                    self.text(pos2(right, rect.center().y - 24.0 * self.s), 36.0, Font::Body, c(INK_SOFT), Align::Right, 0.0, &it.sub);\n                }\n                if let Some(n) = it.stars {\n                    for i in 0..3u8 {\n                        let col = if i < n { c(SUN) } else { Color32::from_rgb(222, 230, 232) };\n                        self.star(pos2(rect.max.x - pad - 22.0 * self.s - (2 - i) as f32 * 58.0 * self.s, rect.center().y), 26.0 * self.s, col);\n                    }\n                }\n            }\n        }\n    }\n\n    fn node(&mut self, n: &Node) {\n        match n {\n            Node::Card { r, fill, radius, shadow } => {\n                if r[2] <= 0.0 || r[3] <= 0.0 {\n                    return;\n                }\n                let rect = self.rect(r);\n                let rr = self.radius(*radius);\n                if *shadow {\n                    self.p.add(Shadow { offset: [0, 10], blur: 36, spread: 2, color: Color32::from_black_alpha(46) }.as_shape(rect, rr));\n                }\n                self.p.rect_filled(rect, rr, c(*fill));\n            }\n            Node::Outline { r, color, width, radius } => {\n                self.p.rect_stroke(self.rect(r), self.radius(*radius), Stroke::new(width * self.s, c(*color)), StrokeKind::Outside);\n            }\n            Node::Text { at, size, font, color, align, wrap, text } => {\n                self.text(self.pt(at[0], at[1]), *size, *font, c(*color), *align, *wrap, text);\n            }\n            Node::Prompt { at, size, act, label, align, color } => {\n                self.prompt(self.pt(at[0], at[1]), *size, *act, label, c(*color), *align);\n            }\n            Node::Puck(k) => self.puck(k),\n            Node::Stars { at, n, of, size } => {\n                let s = size * self.s;\n                let gap = s * 2.3;\n                for i in 0..*of {\n                    let x = (i as f32 - (*of as f32 - 1.0) * 0.5) * gap;\n                    let col = if i < *n { c(SUN) } else { Color32::from_rgb(222, 230, 232) };\n                    self.star(self.pt(at[0], at[1]) + vec2(x, 0.0), s, col);\n                }\n            }\n            Node::Bar { r, frac, fill, bg } => {\n                let rect = self.rect(r);\n                let rr = rect.height() * 0.5;\n                self.p.rect_filled(rect, rr, c(*bg));\n                let w = rect.width() * frac.clamp(0.0, 1.0);\n                if w > 0.5 {\n                    self.p.rect_filled(Rect::from_min_size(rect.min, vec2(w, rect.height())), rr, c(*fill));\n                }\n            }\n            Node::Circle { c: at, r, fill, stroke, width } => {\n                let p = self.pt(at[0], at[1]);\n                self.p.circle_filled(p, r * self.s, c(*fill));\n                if *width > 0.0 {\n                    self.p.circle_stroke(p, r * self.s, Stroke::new(width * self.s, c(*stroke)));\n                }\n            }\n            Node::Line { pts, width, color } => {\n                let pts: Vec<Pos2> = pts.iter().map(|p| self.pt(p[0], p[1])).collect();\n                self.p.add(Shape::line(pts, Stroke::new(width * self.s, c(*color))));\n            }\n            Node::Fade { color } => {\n                self.p.rect_filled(Rect::from_min_size(Pos2::ZERO, self.screen), 0.0, c(*color));\n            }\n            Node::WorldText { pos, size, color, text } => {\n                if let Some(at) = self.project(*pos) {\n                    self.text(at, *size, Font::Title, c(*color), Align::Center, 0.0, text);\n                }\n            }\n            Node::WorldPrompt { pos, act, label } => {\n                if let Some(at) = self.project(*pos) {\n                    let w = (label.chars().count() as f32 * 24.0 + 100.0) * self.s;\n                    let rect = Rect::from_center_size(at, vec2(w, 72.0 * self.s));\n                    self.p.add(Shadow { offset: [0, 4], blur: 14, spread: 0, color: Color32::from_black_alpha(40) }.as_shape(rect, self.radius(36.0)));\n                    self.p.rect_filled(rect, self.radius(36.0), Color32::WHITE);\n                    self.prompt(pos2(rect.min.x + 18.0 * self.s, at.y), 40.0, *act, label, c(INK), Align::Left);\n                }\n            }\n            Node::WorldRing { pos, r, color } => {\n                let pts: Vec<Pos2> = (0..=32)\n                    .filter_map(|i| {\n                        let a = i as f32 / 32.0 * std::f32::consts::TAU;\n                        self.project(*pos + Vec3::new(a.cos() * r, 0.0, a.sin() * r))\n                    })\n                    .collect();\n                if pts.len() > 2 {\n                    self.p.add(Shape::line(pts, Stroke::new(6.0 * self.s, c(*color))));\n                }\n            }\n        }\n    }\n}\n\n/// Text anchored in the world, from the host (other players' names).\npub struct WorldLabel {\n    pub pos: Vec3,\n    pub text: String,\n    pub color: [u8; 3],\n}\n\n/// Draws the frame. `input` says which glyphs to use; `vp` projects world anchors.\npub fn draw(ctx: &egui::Context, f: &UiFrame, input: Input, vp: Mat4, labels: &[WorldLabel]) -> Output {\n    let screen = ctx.content_rect();\n    let (w, h) = (screen.width(), screen.height());\n    let s = (w / 1920.0).min(h / 1080.0);\n    let o = vec2((w - 1920.0 * s) * 0.5, (h - 1080.0 * s) * 0.5);\n    let p = ctx.layer_painter(egui::LayerId::new(egui::Order::Middle, egui::Id::new(\"fit_ui\")));\n    let mut out = Output::default();\n    let mut prompts = Vec::new();\n    {\n        let mut v = View { p, s, o, vp, screen: vec2(w, h), input, xbox: f.xbox, prompts: &mut prompts };\n        for n in &f.nodes {\n            v.node(n);\n        }\n        for it in &f.items {\n            v.item(it);\n        }\n        for n in &f.top {\n            v.node(n);\n        }\n        for l in labels {\n            if let Some(at) = v.project(l.pos) {\n                let color = Color32::from_rgb(l.color[0], l.color[1], l.color[2]);\n                v.text(at, 40.0, Font::Title, color, Align::Center, 0.0, &l.text);\n            }\n        }\n        for it in &f.items {\n            let r = v.rect(&it.r);\n            out.rects.push((it.id, [r.min.x, r.min.y, r.width(), r.height()], it.label.clone()));\n        }\n        // The pointer.\n        let (hover, moved, clicked, down) = ctx.input(|i| {\n            let moving = i.pointer.delta().length_sq() > 0.0 || i.pointer.any_pressed();\n            (i.pointer.interact_pos().or(i.pointer.hover_pos()), moving, i.pointer.primary_clicked(), i.pointer.primary_down())\n        });\n        if let Some(at) = hover {\n            let on = f.items.iter().find(|it| v.rect(&it.r).contains(at));\n            if let Some(it) = on {\n                out.over_item = true;\n                if clicked {\n                    out.event = Some(UiEvent::Click(it.id));\n                } else if down && matches!(it.kind, ItemKind::Slider { .. }) {\n                    let rect = v.rect(&it.r);\n                    let (bx, bw) = (rect.min.x + rect.width() * 0.5, rect.width() * 0.33);\n                    if at.x >= bx - 20.0 * s {\n                        out.event = Some(UiEvent::Slider(it.id, ((at.x - bx) / bw).clamp(0.0, 1.0)));\n                    }\n                } else if moved {\n                    out.event = Some(UiEvent::Hover(it.id));\n                }\n                if matches!(it.kind, ItemKind::Slider { .. }) && clicked {\n                    let rect = v.rect(&it.r);\n                    let (bx, bw) = (rect.min.x + rect.width() * 0.5, rect.width() * 0.33);\n                    if at.x >= bx - 20.0 * s {\n                        out.event = Some(UiEvent::Slider(it.id, ((at.x - bx) / bw).clamp(0.0, 1.0)));\n                    }\n                }\n            }\n        }\n    }\n    out.prompts = prompts;\n    out\n}\n\n/// A plain-text reading of what's on screen for tests that have no painter.\npub fn item_rects(f: &UiFrame) -> Vec<(u16, [f32; 4])> {\n    f.items.iter().map(|i| (i.id, i.r)).collect()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn prompts_follow_the_device_and_the_glyph_setting() {\n        let pad = Input { device: Device::Gamepad, mouse: false };\n        let keys = Input { device: Device::KeyboardMouse, mouse: false };\n        let mouse = Input { device: Device::KeyboardMouse, mouse: true };\n        assert_eq!(prompt(Act::Confirm, pad, false), Glyph::Cross);\n        assert_eq!(prompt(Act::Back, pad, false), Glyph::Circle);\n        assert_eq!(prompt(Act::Wave, pad, false), Glyph::Square);\n        assert_eq!(prompt(Act::Schedule, pad, false), Glyph::Triangle);\n        assert_eq!(prompt(Act::StepL, pad, false), Glyph::Pill(\"L1\"));\n        assert_eq!(prompt(Act::Pause, pad, false), Glyph::Pill(\"Options\"));\n        assert_eq!(glyph_name(prompt(Act::Confirm, pad, true)), \"A\");\n        assert_eq!(glyph_name(prompt(Act::Back, pad, true)), \"B\");\n        assert_eq!(glyph_name(prompt(Act::Wave, pad, true)), \"X\");\n        assert_eq!(glyph_name(prompt(Act::Schedule, pad, true)), \"Y\");\n        assert_eq!(prompt(Act::StepR, pad, true), Glyph::Pill(\"RB\"));\n        assert_eq!(prompt(Act::Pause, pad, true), Glyph::Pill(\"Menu\"));\n        assert_eq!(prompt(Act::Confirm, keys, false), Glyph::Key(\"Space\"));\n        assert_eq!(prompt(Act::Schedule, keys, true), Glyph::Key(\"Tab\"));\n        assert_eq!(prompt(Act::Confirm, mouse, false), Glyph::Mouse(MouseBit::Left));\n        assert_eq!(prompt(Act::Lean, mouse, false), Glyph::Mouse(MouseBit::Move));\n    }\n\n    #[test]\n    fn a_frame_draws_and_the_pointer_lands_on_items() {\n        let ctx = egui::Context::default();\n        install_fonts(&ctx);\n        let mut ui = Ui::default();\n        ui.title(960.0, 100.0, 96.0, INK, Align::Center, \"Whiff Fit\");\n        ui.puck(Puck { c: [960.0, 500.0], r: 170.0, ring: Some([0.1, 0.1, 0.3]), ..Default::default() });\n        ui.prompt_row(&[(Act::Confirm, \"Begin\"), (Act::Back, \"Leave\")]);\n        ui.f.items.push(Item { id: 3, r: [100.0, 100.0, 400.0, 100.0], label: \"Hi\".into(), sub: String::new(), kind: ItemKind::Button, focused: true, bounce: 0.0, stars: Some(2) });\n        let raw = |events: Vec<egui::Event>| egui::RawInput {\n            screen_rect: Some(Rect::from_min_size(Pos2::ZERO, vec2(1920.0, 1080.0))),\n            events,\n            ..Default::default()\n        };\n        let mut out = Output::default();\n        let input = Input { device: Device::Gamepad, mouse: false };\n        let frame = ui.f;\n        let _ = ctx.run_ui(raw(vec![]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        assert_eq!(out.rects.len(), 1);\n        assert!(out.prompts.iter().any(|p| p == \"Cross:Begin\"), \"{:?}\", out.prompts);\n        // Hover at the item, then click.\n        let at = pos2(200.0, 150.0);\n        let _ = ctx.run_ui(raw(vec![egui::Event::PointerMoved(at)]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        assert_eq!(out.event, Some(UiEvent::Hover(3)));\n        let press = |pressed| egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: Default::default() };\n        let _ = ctx.run_ui(raw(vec![press(true)]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        let _ = ctx.run_ui(raw(vec![press(false)]), |c| {\n            out = draw(c.ctx(), &frame, input, Mat4::IDENTITY, &[]);\n        });\n        assert_eq!(out.event, Some(UiEvent::Click(3)));\n    }\n}\nEOF\npython3 - <<'EOF'\ndef patch(path, pairs):\n    s = open(path).read()\n    for a, b in pairs:\n        assert a in s, (path, a[:70])\n        s = s.replace(a, b, 1)\n    open(path, 'w').write(s)\npatch('crates/pav_ui/src/lib.rs', [(\"\"\"pub mod arpg_ui;\n\"\"\",\"\"\"pub mod arpg_ui;\npub mod fit_ui;\n\"\"\")])\npatch('crates/pav_ui/src/headless.rs', [\n(\"\"\"        let ctx = egui::Context::default();\n        let touch = self.device == Device::Touch;\"\"\",\"\"\"        let ctx = egui::Context::default();\n        if hud_lines.fit.is_some() {\n            crate::fit_ui::install_fonts(&ctx);\n        }\n        let touch = self.device == Device::Touch;\"\"\"),\n(\"\"\"                crate::game_lines(&ctx, hud_lines);\n\"\"\",\"\"\"                crate::game_lines(&ctx, hud_lines);\n                if let Some(f) = &hud_lines.fit {\n                    let input = crate::fit_ui::Input { device: self.device, mouse: false };\n                    crate::fit_ui::draw(&ctx, f, input, vp, &[]);\n                }\n\"\"\"),\n])\npatch('crates/pav_tools/src/session.rs', [\n(\"\"\"    frame.game.is_some() || !frame.hud.lines.is_empty()\n\"\"\",\"\"\"    frame.game.is_some() || !frame.hud.lines.is_empty() || frame.hud.fit.is_some()\n\"\"\"),\n])\nEOF\ngrep -n \"ui::\\|camera_yaw\\|fn view_for\" crates/pav_tools/src/session.rs | head; sed -n 252,290p crates/pav_tools/src/session.rs; cat crates/pav_ui/Cargo.toml | sed -n 5,30p; sed -i 's/ai = \\\"idle\\\"/ai = { type = \\\"idle\\\" }/' crates/pav_core/src/games/fit/sets/*.toml; python3 ../tools/make_sets.py; CARGO_BUILD_JOBS=8 cargo build --locked -p pav_tools --bin pav --message-format=short 2>&1 | grep -E \"^(crates|error)|Finished\" | cut -c1-220 | head -40","description":"Write the fit UI renderer, wire headless tools, rebuild pav","timeout":500000}},"wire_ingest_context":{"toolu_01MtD78KgxZ2JhN7Qk3Kevko":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine"}}}
