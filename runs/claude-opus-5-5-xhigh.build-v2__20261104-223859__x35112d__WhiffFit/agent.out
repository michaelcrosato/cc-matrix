{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGxrjijC5w8KMoZay28","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018rnYyhtejsett78QGjiCAy","name":"Bash","input":{"command":"cat > mod.rs <<'EOF'\n//! Whiff Fit: a five-day balance-and-wellness comedy at Tippy Cay, a resort staffed entirely by\n//! talking gym equipment. All game state and flow live here, driven by `InputFrame`, so tests can\n//! play the whole game with no browser or GPU. `README.md` in the dev folder says how to add an\n//! event, a set or a song.\n\npub mod bot;\npub mod check;\npub mod core;\npub mod dialog;\npub mod events;\npub mod finale;\npub mod flow;\npub mod ghost;\npub mod island;\npub mod medley;\npub mod menus;\npub mod meta;\npub mod rules;\npub mod run;\npub mod screens;\npub mod script;\npub mod ui_model;\npub mod world;\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::Result;\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse self::dialog::Dialog;\nuse self::events::{Cx, EventKind, Intent};\nuse self::island::Interact;\nuse self::menus::Menu;\nuse self::meta::{Guest, SaveData};\nuse self::rules::Rules;\nuse self::run::{EventRun, RunPhase};\nuse self::ui_model::UiFrame;\nuse self::world::*;\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::{RenderObject, SimEvent};\nuse crate::input::{InputFrame, buttons as b};\nuse crate::sim::Sim;\n\n/// The game's title. One constant; the resort's name doesn't depend on it.\npub const TITLE: &str = \"Whiff Fit\";\npub const TAGLINE: &str = \"A balance comedy at Tippy Cay\";\n\n/// What the page tells the game when it boots. Passing the date as data keeps the rule that the\n/// sim never reads the clock.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Boot {\n    /// Days since 1970, today.\n    pub today: i64,\n    pub touch_only: bool,\n}\n\n/// Dev mode's toggles.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Dev {\n    pub tab: usize,\n    pub group: usize,\n    pub no_tips: bool,\n    pub autoplay: bool,\n    pub skip_dialog: bool,\n    pub time_scale: f32,\n    pub hold: bool,\n    pub step: bool,\n    pub input_view: bool,\n    pub trace: bool,\n    pub stats: bool,\n    pub free_cam: bool,\n    pub ghost_lanes: bool,\n    pub win_now: bool,\n    pub lose_now: bool,\n}\n\nimpl Default for Dev {\n    fn default() -> Self {\n        Self {\n            tab: 0,\n            group: 0,\n            no_tips: false,\n            autoplay: false,\n            skip_dialog: false,\n            time_scale: 1.0,\n            hold: false,\n            step: false,\n            input_view: false,\n            trace: false,\n            stats: false,\n            free_cam: false,\n            ghost_lanes: true,\n            win_now: false,\n            lose_now: false,\n        }\n    }\n}\n\n/// What to do when a dialogue ends.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub enum After {\n    #[default]\n    Nothing,\n    Morning,\n    StartCheck,\n    Island,\n    Credits(u8),\n}\n\n/// The base screen.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub enum Flow {\n    #[default]\n    Title,\n    Attract(Box<flow::Attract>),\n    Slots,\n    Names(u8),\n    Look(u8, String),\n    Intro,\n    Morning,\n    Check(Box<check::Check>),\n    Report(Box<flow::Report>),\n    Island,\n    Event(Box<EventRun>),\n    Stamp(f32, u8),\n    Ending(f32, u8),\n    Credits(f32, u8),\n    Together(u8),\n    Medley(Box<medley::Medley>),\n}\n\n/// A screen stacked over the base. All but the hub's freeze the world.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Overlay {\n    Pause,\n    Schedule(i8),\n    Calendar,\n    Wardrobe,\n    Settings,\n    ConfirmReset,\n    HowTo(u8),\n    About(u8),\n    Dev,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct FitGame {\n    pub rules: Rules,\n    pub save: SaveData,\n    pub save_serial: u64,\n    #[serde(skip)]\n    pub save_text: Arc<String>,\n    pub slot: Option<usize>,\n    pub flow: Flow,\n    pub overlays: Vec<Overlay>,\n    pub focus: usize,\n    pub focus_stack: Vec<usize>,\n    pub scroll: usize,\n    pub bounce: f32,\n    pub repeat: [f32; 4],\n    pub dialog: Option<Dialog>,\n    pub after: After,\n    pub pid: EntityId,\n    pub stages: [Vec3; 9],\n    pub spots: Vec<Interact>,\n    pub flips: Vec<(u8, EntityId, Vec3)>,\n    pub near: Option<usize>,\n    pub walk: Vec<Vec3>,\n    pub walk_then: Option<usize>,\n    pub boot: Boot,\n    pub session: bool,\n    pub hub_ended: bool,\n    pub idle: f32,\n    pub time: f32,\n    pub song: u8,\n    pub dev: Dev,\n    pub seed: u64,\n    pub fullscreen_serial: u32,\n    pub rumble: f32,\n    pub island_quip: Option<(Dialog, f32)>,\n    pub goal_said: bool,\n    pub clam_pulse: f32,\n    pub clam: Option<EntityId>,\n    pub gulls: Vec<flow::GullRig>,\n    pub spin: f32,\n    pub last_input: InputFrame,\n    pub paused_t: f32,\n    pub demo_guest: bool,\n    pub outcome: Outcome,\n    pub stats_played: u32,\n    /// The scene's direct route (`fit/event/<name>`, for tools and tests).\n    pub direct: Option<EventKind>,\n    pub bot_tick: u64,\n    pub wave_t: f32,\n    #[serde(skip)]\n    pub about: Arc<Vec<(String, String)>>,\n    #[serde(skip)]\n    pub nav: Option<Arc<crate::nav::NavGrid>>,\n}\n\n/// Builds every set, then routes the scene: `fit`, `fit/medley`, `fit/event/<name>`.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    script::reload();\n    let rules = Rules::load()?;\n    world::load_sets(sim)?;\n    let mut stages = [Vec3::ZERO; 9];\n    for (i, s) in [Set::Hub, Set::Studio, Set::Gazebo, Set::Boardwalk, Set::Tide, Set::Channel, Set::Pier, Set::Tower, Set::Bay].iter().enumerate() {\n        stages[i] = set_markers(sim, *s, \"stage\").first().copied().unwrap_or(Vec3::new(i as f32 * 500.0, 0.0, 0.0));\n    }\n    sim.state.world.current_room = Some(0);\n    sim.state.spawn = stages[0];\n    let pid = sim.spawn_player();\n    sim.state.focus = stages[0];\n    let spots = island::gather(sim);\n    let clam = sim.state.entities.iter().find(|e| e.name == \"clam\").map(|e| e.id);\n    let seed = sim.state.seed;\n    let mut game = FitGame {\n        rules,\n        save: SaveData::default(),\n        save_serial: 0,\n        save_text: Arc::new(String::new()),\n        slot: None,\n        flow: Flow::Title,\n        overlays: Vec::new(),\n        focus: 0,\n        focus_stack: Vec::new(),\n        scroll: 0,\n        bounce: 0.0,\n        repeat: [0.0; 4],\n        dialog: None,\n        after: After::Nothing,\n        pid,\n        stages,\n        spots,\n        flips: Vec::new(),\n        near: None,\n        walk: Vec::new(),\n        walk_then: None,\n        boot: Boot::default(),\n        session: false,\n        hub_ended: false,\n        idle: 0.0,\n        time: 0.0,\n        song: 0,\n        dev: Dev::default(),\n        seed,\n        fullscreen_serial: 0,\n        rumble: 0.0,\n        island_quip: None,\n        goal_said: false,\n        clam_pulse: 0.0,\n        clam,\n        gulls: Vec::new(),\n        spin: 0.0,\n        last_input: InputFrame::default(),\n        paused_t: 0.0,\n        demo_guest: false,\n        outcome: Outcome::Playing,\n        stats_played: 0,\n        direct: None,\n        bot_tick: 0,\n        wave_t: 0.0,\n        about: Arc::new(flow::about_pages(\"\")),\n        nav: None,\n    };\n    let mut ev = Vec::new();\n    game.gulls = flow::spawn_gulls(sim, stages[0]);\n    match rest {\n        Some(\"medley\") => {\n            game.session = true;\n            game.start_medley_hub(sim, &mut ev);\n        }\n        Some(r) if r.starts_with(\"event/\") => {\n            let kind = EventKind::from_key(&r[\"event/\".len()..]).ok_or_else(|| anyhow::anyhow!(\"no event {r}\"))?;\n            game.direct = Some(kind);\n            game.save.slots[0] = Some(Guest { name: \"Test Guest\".into(), day: 5, checked: true, ..Default::default() });\n            game.slot = Some(0);\n            game.start_event(sim, &mut ev, kind);\n        }\n        _ => game.to_title(sim, &mut ev),\n    }\n    sim.events.extend(ev);\n    sim.state.play = Some(GameBox::new(game));\n    Ok(())\n}\n\n/// The boot data, the save and the About text from the page.\npub fn install_boot(sim: &mut Sim, boot: Boot, save: Option<&str>, about: &str) {\n    let today = boot.today;\n    let Some(game) = sim.state.play.as_mut().and_then(|g| g.get_mut::<FitGame>()) else { return };\n    game.boot = boot;\n    if let Some(s) = save.and_then(SaveData::parse) {\n        game.save = s;\n    }\n    game.about = Arc::new(flow::about_pages(about));\n    game.mark_saved();\n    let _ = today;\n}\n\nimpl FitGame {\n    pub fn guest(&self) -> Option<&Guest> {\n        self.slot.and_then(|i| self.save.slots.get(i)).and_then(|g| g.as_ref())\n    }\n    pub fn guest_mut(&mut self) -> Option<&mut Guest> {\n        self.slot.and_then(|i| self.save.slots.get_mut(i)).and_then(|g| g.as_mut())\n    }\n    pub fn day(&self) -> u8 {\n        self.guest().map(|g| g.day).unwrap_or(1)\n    }\n\n    /// Writes the save (the app copies it to `localStorage` when the serial changes).\n    pub fn mark_saved(&mut self) {\n        self.save_serial += 1;\n        self.save_text = Arc::new(self.save.to_json());\n    }\n\n    pub fn music(&mut self, ev: &mut Vec<SimEvent>, song: u8) {\n        if self.song != song {\n            self.song = song;\n            ev.push(SimEvent::Music { song });\n        }\n    }\n\n    /// The figure's slump: posture improves as the age falls.\n    pub fn slump(&self) -> f32 {\n        let age = self.guest().and_then(|g| g.ages.last().copied()).unwrap_or(40) as f32;\n        (((age - 24.0) / 56.0).clamp(0.0, 1.0)) * 0.16\n    }\n\n    /// What an event may touch.\n    pub fn cx<'a>(&'a self, sim: &'a mut Sim, ev: &'a mut Vec<SimEvent>, dt: f32) -> Cx<'a> {\n        let (assist, no_tips) = (self.save.settings.assist, self.dev.no_tips);\n        Cx {\n            sim,\n            rules: &self.rules,\n            ev,\n            dt,\n            pid: self.pid,\n            no_tips,\n            assist,\n            stages: &self.stages,\n            day: self.day(),\n            slump: self.slump(),\n            seed: self.seed,\n        }\n    }\n\n    /// Mouse-steered events keep their own meaning of the buttons.\n    fn intent(&self, input: &InputFrame) -> Intent {\n        Intent::from_input(input, self.save.settings.lean_sens)\n    }\n\n    fn frozen_now(&self) -> bool {\n        if self.session {\n            return false;\n        }\n        if self.dev.hold && !self.dev.step {\n            return true;\n        }\n        !self.overlays.is_empty()\n    }\n}\n\nimpl Game for FitGame {\n    const KEY: &'static str = \"fit\";\n\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        let mut out = BTreeMap::new();\n        self.time += dt;\n        self.bot_tick += 1;\n        self.bounce = (self.bounce - dt * 4.0).max(0.0);\n        // Attract's bot and dev autoplay play for you; the real buttons still pause and exit.\n        let auto = matches!(self.flow, Flow::Attract(_)) || (self.dev.autoplay && self.overlays.is_empty());\n        let mut input = *input;\n        if auto {\n            let real = input;\n            input = self.bot(sim);\n            input.any = real.any;\n            input.ui = real.ui;\n            input.pressed |= real.pressed & (b::PAUSE | b::BACK);\n            input.held |= real.held & (b::PAUSE | b::BACK);\n            if matches!(self.flow, Flow::Attract(_)) {\n                input.pressed &= !b::PAUSE;\n            }\n        }\n        // A hub session that ended takes no more input.\n        if self.hub_ended {\n            input = InputFrame::default();\n        }\n        self.last_input = input;\n        let mv = self.drive(sim, &input, dt, ev);\n        self.dev.step = false;\n        if !self.frozen_now() {\n            if let Some(pid) = sim.state.player {\n                out.insert(pid, InputFrame { move_dir: mv, ..Default::default() });\n            }\n        }\n        out\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn frozen(&self) -> bool {\n        self.frozen_now()\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new()\n    }\n\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.status_json(sim)\n    }\n\n    fn page_status(&self, sim: &Sim) -> Option<String> {\n        Some(self.status_json(sim).to_string())\n    }\n\n    fn ui_frame(&self, sim: &Sim) -> Option<Arc<UiFrame>> {\n        Some(Arc::new(self.build_ui(sim)))\n    }\n\n    fn camera_yaw(&self, _sim: &Sim) -> Option<f32> {\n        let run = match &self.flow {\n            Flow::Event(r) => Some(&**r),\n            Flow::Attract(a) => a.run.as_ref(),\n            _ => None,\n        }?;\n        match &run.st {\n            events::EventState::Lap(l) if run.phase != RunPhase::Result => Some(l.yaw),\n            _ => None,\n        }\n    }\n\n    fn extra_objects(&self, _sim: &Sim) -> Vec<RenderObject> {\n        self.local_ghosts()\n    }\n\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        self.bot_input(sim)\n    }\n}\n\nimpl FitGame {\n    /// The status for tools, tests and the page.\n    pub fn status_json(&self, sim: &Sim) -> serde_json::Value {\n        let g = self.guest();\n        let screen = self.screen_name();\n        let hub = self.hub_status();\n        let mut v = json!({\n            \"screen\": screen,\n            \"tick\": sim.state.tick,\n            \"focus\": self.focus,\n            \"day\": g.map(|g| g.day),\n            \"minutes\": g.map(|g| g.minutes),\n            \"stamps\": g.map(|g| g.stamps),\n            \"age\": g.and_then(|g| g.ages.last().copied()),\n            \"song\": self.song,\n            \"attract\": matches!(self.flow, Flow::Attract(_)),\n            \"attract_seg\": if let Flow::Attract(a) = &self.flow { a.seg as i64 } else { -1 },\n            \"hub\": hub,\n            \"touch_only\": self.boot.touch_only,\n            \"frozen\": self.frozen_now(),\n            \"music_setting\": self.save.settings.music,\n        });\n        if let Flow::Event(r) = &self.flow {\n            v[\"event\"] = json!(r.kind.key());\n            v[\"phase\"] = json!(format!(\"{:?}\", r.phase));\n            v[\"score\"] = json!(r.c.score);\n        }\n        v\n    }\n\n    pub fn screen_name(&self) -> String {\n        if let Some(m) = self.menu().filter(|m| m.key != \"touch\") {\n            return m.key.to_string();\n        }\n        if self.dialog.is_some() {\n            return \"dialog\".into();\n        }\n        match &self.flow {\n            Flow::Title => \"title\",\n            Flow::Attract(_) => \"attract\",\n            Flow::Slots => \"slots\",\n            Flow::Names(_) => \"names\",\n            Flow::Look(..) => \"look\",\n            Flow::Intro | Flow::Morning => \"morning\",\n            Flow::Check(_) => \"check\",\n            Flow::Report(_) => \"report\",\n            Flow::Island => \"island\",\n            Flow::Event(r) => match r.phase {\n                RunPhase::Card => \"card\",\n                RunPhase::Count => \"count\",\n                RunPhase::Play => \"event\",\n                RunPhase::Result => \"result\",\n            },\n            Flow::Stamp(..) => \"stamp\",\n            Flow::Ending(..) => \"ending\",\n            Flow::Credits(..) => \"credits\",\n            Flow::Together(_) => \"together\",\n            Flow::Medley(m) => m.screen(),\n        }\n        .to_string()\n    }\n\n    /// Local ghosts, in the same lanes as the hub's.\n    fn local_ghosts(&self) -> Vec<RenderObject> {\n        if !self.dev.ghost_lanes {\n            return Vec::new();\n        }\n        let run = match &self.flow {\n            Flow::Event(r) => &**r,\n            Flow::Medley(m) => match &m.run {\n                Some(r) => r,\n                None => return Vec::new(),\n            },\n            _ => return Vec::new(),\n        };\n        if !matches!(run.phase, RunPhase::Play | RunPhase::Count) {\n            return Vec::new();\n        }\n        let mut out = Vec::new();\n        for (i, frames) in run.ghosts.iter().enumerate() {\n            let Some(g) = ghost::sample(frames, run.c.t) else { continue };\n            let seat = i + 1;\n            let look = ghost::seat_look(seat);\n            let lane = run.kind.lane() * (i as f32 + 1.0);\n            out.push(ghost::ghost_object(0x7000_0000 + i as u32, &g, lane, &look, ghost::SEATS[seat % 4], 0.55));\n            if let Some(board) = ghost::stands_on(0x7000_0100 + i as u32, run.kind, &g, lane) {\n                out.push(board);\n            }\n        }\n        out\n    }\n\n    pub fn near_spot(&self) -> Option<&Interact> {\n        self.near.and_then(|i| self.spots.get(i))\n    }\n}\n\n/// A focus-independent helper for the UI: which way is the lean pointing, as text (dev view).\npub fn lean_text(v: Vec2) -> String {\n    format!(\"{:+.2} {:+.2}\", v.x, v.y)\n}\nEOF\ncat >> ghost.rs <<'EOF'\n\n/// What a ghost stands on, in its lane (a paddleboard).\npub fn stands_on(id: u32, kind: super::events::EventKind, g: &GFrame, lane: Vec3) -> Option<RenderObject> {\n    let (half, h) = kind.ghost_stands_on()?;\n    let feet = Vec3::from(g.p) + lane;\n    let mut visual = Visual::new(Shape::RoundedBox { half, radius: half.min_element() * 0.8 }, crate::color::Color::hex(\"#fbfaf6\"));\n    visual.look = crate::shape::Look::Cel;\n    Some(RenderObject {\n        id: EntityId(id),\n        pos: feet + Vec3::Y * h,\n        rot: Quat::from_rotation_y(g.f),\n        visual,\n        prop: None,\n        puppet: None,\n        pulse: -1.0,\n        soft: None,\n        vehicle: None,\n        cone: None,\n        scenery: false,\n    })\n}\nEOF\ncat > medley.rs <<'EOF'\n//! The Inter-Resort Medley: three events, one after another, final score is their sum. An AI Hub\n//! session plays one copy per player; Play Together passes one pad round.\n\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::events::{EventKind, Intent};\nuse super::ghost::{GFrame, GHOST_HZ};\nuse super::run::{EventRun, RunPhase};\nuse super::ui_model::*;\nuse super::world::*;\nuse super::{Flow, FitGame};\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, buttons as b};\nuse crate::rng::Rng;\nuse crate::sim::Sim;\n\npub const ORDER: [EventKind; 3] = [EventKind::PaddleSlalom, EventKind::TideTable, EventKind::CannonballCup];\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum MPhase {\n    /// Waiting for the hub to say go.\n    #[default]\n    Waiting,\n    /// A pass-the-pad card.\n    Pass,\n    Run,\n    /// The score of the event that just ended.\n    Interlude,\n    Podium,\n    Done,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct MPlayer {\n    pub name: String,\n    pub scores: [f32; 3],\n    pub runs: Vec<Vec<GFrame>>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Medley {\n    pub hub: bool,\n    pub seed: u64,\n    pub players: Vec<MPlayer>,\n    pub cur: usize,\n    pub i: usize,\n    pub run: Option<EventRun>,\n    pub phase: MPhase,\n    pub t: f32,\n}\n\nimpl Medley {\n    pub fn screen(&self) -> &'static str {\n        match self.phase {\n            MPhase::Waiting => \"medley_wait\",\n            MPhase::Pass => \"pass\",\n            MPhase::Run => \"medley_run\",\n            MPhase::Interlude => \"medley_score\",\n            MPhase::Podium => \"podium\",\n            MPhase::Done => \"medley_done\",\n        }\n    }\n    pub fn total(&self, p: usize) -> f32 {\n        self.players.get(p).map(|x| x.scores.iter().sum()).unwrap_or(0.0)\n    }\n}\n\nimpl FitGame {\n    /// A session: no title, no menu, no attract. The round opens straight away.\n    pub fn start_medley_hub(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let m = Medley {\n            hub: true,\n            seed: self.seed,\n            players: vec![MPlayer { name: \"You\".into(), ..Default::default() }],\n            phase: MPhase::Waiting,\n            ..Default::default()\n        };\n        self.flow = Flow::Medley(Box::new(m));\n        self.save.slots[0] = Some(super::meta::Guest { name: \"Guest\".into(), day: 5, checked: true, ..Default::default() });\n        self.slot = Some(0);\n        show_set(sim, Set::Channel);\n        let at = self.stages[Set::Channel as usize];\n        place(sim, self.pid, at, std::f32::consts::PI);\n        cam_full(sim, 22.0, 0.0, 10.0, 40.0, 0.9, 0.1, None);\n        self.music(ev, song::LOBBY);\n    }\n\n    pub fn start_together(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>, count: usize) {\n        let m = Medley {\n            hub: false,\n            seed: self.seed,\n            players: (0..count).map(|i| MPlayer { name: format!(\"Guest {}\", i + 1), ..Default::default() }).collect(),\n            phase: MPhase::Pass,\n            ..Default::default()\n        };\n        self.flow = Flow::Medley(Box::new(m));\n        self.save_look_for(sim, 0);\n        self.music(ev, song::LOBBY);\n    }\n\n    fn save_look_for(&mut self, sim: &mut Sim, seat: usize) {\n        let look = super::ghost::seat_look(seat);\n        if let Some(ch) = sim.state.entities.get_mut(self.pid).and_then(|e| e.character.as_mut()) {\n            ch.puppet = Some(look);\n        }\n    }\n\n    fn medley_run(&self, m: &Medley, sim: &mut Sim, ev: &mut Vec<SimEvent>, dt: f32) -> EventRun {\n        let kind = ORDER[m.i];\n        let mut run = EventRun::new(kind, 5, &self.rules);\n        run.medley = true;\n        // The same seed gives the same course on every copy, whatever came before it.\n        sim.state.rng = Rng::new(m.seed.wrapping_add(1000 * (m.i as u64 + 1)));\n        for (p, player) in m.players.iter().enumerate() {\n            if p < m.cur {\n                if let Some(frames) = player.runs.get(m.i) {\n                    run.ghosts.push(frames.clone());\n                    run.ghost_names.push(player.name.clone());\n                }\n            }\n        }\n        let mut cx = self.cx(sim, ev, dt);\n        run.begin(&mut cx);\n        run\n    }\n\n    /// One tick of a round.\n    pub fn medley_tick(&mut self, m: &mut Medley, sim: &mut Sim, input: &InputFrame, ev: &mut Vec<SimEvent>, dt: f32) {\n        m.t += dt;\n        match m.phase {\n            MPhase::Waiting => {\n                if input.down(b::HUB_GO) {\n                    m.phase = MPhase::Run;\n                    m.t = 0.0;\n                    let run = self.medley_run(m, sim, ev, dt);\n                    m.run = Some(run);\n                }\n            }\n            MPhase::Pass => {}\n            MPhase::Run => {\n                let it: Intent = Intent::from_input(input, self.save.settings.lean_sens);\n                let mut done = false;\n                if let Some(mut run) = m.run.take() {\n                    {\n                        let mut cx = self.cx(sim, ev, dt);\n                        // Session or not, no one is held at the card.\n                        done = run.tick(&mut cx, &it);\n                    }\n                    m.run = Some(run);\n                }\n                if done {\n                    if let Some(run) = &m.run {\n                        let p = &mut m.players[m.cur];\n                        p.scores[m.i] = run.out.score;\n                        p.runs.push(run.rec.clone());\n                    }\n                    self.stats_played += 1;\n                    ev.push(SimEvent::Sfx { id: sound::FANFARE, gain: 0.6, pitch: 1.0 });\n                    m.phase = MPhase::Interlude;\n                    m.t = 0.0;\n                }\n            }\n            MPhase::Interlude => {\n                if m.t > 3.0 || (!m.hub && input.just(b::CONFIRM | b::PRIMARY)) {\n                    if let Some(mut run) = m.run.take() {\n                        let mut cx = self.cx(sim, ev, dt);\n                        run.stop(&mut cx);\n                    }\n                    m.i += 1;\n                    m.t = 0.0;\n                    if m.i >= ORDER.len() {\n                        m.i = 0;\n                        m.cur += 1;\n                        if m.cur >= m.players.len() {\n                            m.phase = if m.hub { MPhase::Done } else { MPhase::Podium };\n                            show_set(sim, Set::Hub);\n                            let at = self.stages[0];\n                            place(sim, self.pid, at, 0.0);\n                            cam_orbit(sim, 14.0, 9.0, 36.0, 1.0, -30.0, 30.0, 26.0);\n                            ev.push(SimEvent::Sfx { id: sound::FANFARE, gain: 0.9, pitch: 1.0 });\n                            self.music(ev, song::LOBBY);\n                        } else {\n                            m.phase = MPhase::Pass;\n                            let seat = m.cur;\n                            self.save_look_for(sim, seat);\n                        }\n                    } else {\n                        m.phase = MPhase::Run;\n                        let run = self.medley_run(m, sim, ev, dt);\n                        m.run = Some(run);\n                    }\n                }\n            }\n            MPhase::Podium | MPhase::Done => {}\n        }\n    }\n\n    pub fn medley_ready(&mut self, m: &mut Medley, sim: &mut Sim, ev: &mut Vec<SimEvent>, dt: f32) {\n        m.phase = MPhase::Run;\n        m.t = 0.0;\n        let run = self.medley_run(m, sim, ev, dt);\n        m.run = Some(run);\n    }\n\n    /// What the page reports: score, label, done, stats and the ghost message.\n    pub fn hub_status(&self) -> serde_json::Value {\n        let Flow::Medley(m) = &self.flow else {\n            return serde_json::Value::Null;\n        };\n        if !m.hub {\n            return serde_json::Value::Null;\n        }\n        let banked = m.total(0);\n        let live = m.run.as_ref().filter(|r| r.phase == RunPhase::Play).map(|r| r.c.score).unwrap_or(0.0);\n        let label = match m.phase {\n            MPhase::Waiting => \"Warming up\".to_string(),\n            MPhase::Done => \"Finished\".to_string(),\n            _ => ORDER[m.i.min(2)].name().to_string(),\n        };\n        let score = (banked + live).round();\n        let scores: Vec<f64> = m.players[0].scores.iter().map(|s| (*s as f64).round()).collect();\n        json!({\n            \"score\": score,\n            \"label\": label,\n            \"done\": m.phase == MPhase::Done,\n            \"stats\": { \"paddle\": scores[0], \"tide\": scores[1], \"cannonball\": scores[2] },\n            \"ghost\": self.hub_ghost(m),\n        })\n    }\n\n    fn hub_ghost(&self, m: &Medley) -> serde_json::Value {\n        let Some(run) = m.run.as_ref().filter(|_| m.phase == MPhase::Run || m.phase == MPhase::Interlude) else {\n            return json!({ \"area\": -1 });\n        };\n        let g = run.rec.last().copied().unwrap_or_default();\n        json!({ \"area\": m.i, \"p\": g.p, \"f\": g.f, \"l\": g.l, \"c\": g.c, \"t\": g.t, \"s\": run.c.score.round() })\n    }\n}\n\nimpl Medley {\n    pub fn hud(&self, game: &FitGame, ui: &mut Ui) {\n        match self.phase {\n            MPhase::Waiting => {\n                ui.card(460.0, 340.0, 1000.0, 300.0);\n                ui.title(960.0, 370.0, 80.0, INK, Align::Center, \"The Inter-Resort Medley\");\n                ui.text(960.0, 490.0, 42.0, INK_SOFT, Align::Center, \"Three events. One number. Please wait to be weighed. Not weighed. Counted.\");\n            }\n            MPhase::Pass => {\n                let p = &self.players[self.cur];\n                ui.card(460.0, 300.0, 1000.0, 400.0);\n                ui.text(960.0, 330.0, 44.0, INK_SOFT, Align::Center, \"Pass the pad to\");\n                ui.title(960.0, 400.0, 110.0, TEAL, Align::Center, p.name.clone());\n                ui.para(960.0, 550.0, 860.0, 38.0, INK, Align::Center, super::script::line(\"pip.pass\", self.cur));\n            }\n            MPhase::Run => {\n                if let Some(run) = &self.run {\n                    run.hud(&game.rules, ui, &super::script::line(&format!(\"card.{}\", run.kind.key()), 0));\n                }\n                let total = self.total(self.cur);\n                ui.panel(1474.0, 150.0, 410.0, 70.0, with_alpha(WHITE, 0.93), 30.0);\n                ui.text(1860.0, 160.0, 36.0, INK, Align::Right, format!(\"Medley {:.0}\", total));\n                if self.hub {\n                    let n = self.i + 1;\n                    ui.panel(36.0, 150.0, 360.0, 0.0, WHITE, 0.0);\n                    let _ = n;\n                }\n            }\n            MPhase::Interlude => {\n                let s = self.players[self.cur].scores[self.i];\n                ui.card(560.0, 300.0, 800.0, 380.0);\n                ui.label(960.0, 330.0, 54.0, INK_SOFT, Align::Center, ORDER[self.i].name());\n                ui.title(960.0, 400.0, 150.0, INK, Align::Center, format!(\"{s:.0}\"));\n                ui.stars(960.0, 610.0, game.rules.stars(s), 3, 60.0);\n            }\n            MPhase::Podium => {\n                let mut order: Vec<usize> = (0..self.players.len()).collect();\n                order.sort_by(|a, b| self.total(*b).total_cmp(&self.total(*a)));\n                ui.card(360.0, 90.0, 1200.0, 760.0);\n                ui.title(960.0, 110.0, 96.0, INK, Align::Center, \"The Podium\");\n                for (rank, &p) in order.iter().enumerate() {\n                    let y = 250.0 + rank as f32 * 130.0;\n                    let col = if rank == 0 { SUN } else { SKY };\n                    ui.panel(460.0, y, 1000.0, 110.0, col, 30.0);\n                    ui.label(500.0, y + 22.0, 58.0, INK, Align::Left, format!(\"{}. {}\", rank + 1, self.players[p].name));\n                    ui.label(1420.0, y + 22.0, 58.0, INK, Align::Right, format!(\"{:.0}\", self.total(p)));\n                }\n                ui.para(960.0, 780.0, 1000.0, 36.0, INK_SOFT, Align::Center, super::script::line(\"pip.podium\", self.players.len()));\n            }\n            MPhase::Done => {\n                ui.card(460.0, 300.0, 1000.0, 420.0);\n                ui.label(960.0, 330.0, 54.0, INK_SOFT, Align::Center, \"Your Medley\");\n                ui.title(960.0, 400.0, 150.0, INK, Align::Center, format!(\"{:.0}\", self.total(0)));\n                ui.text(960.0, 610.0, 40.0, INK_SOFT, Align::Center, \"Pip has this written down.\");\n            }\n        }\n    }\n}\n\n/// Seconds of a ghost at frame `n`.\npub fn frame_time(n: usize) -> f32 {\n    n as f32 / GHOST_HZ\n}\nEOF\necho ok","description":"Write the main game struct, ghost board and Medley module"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11904,"cache_read_input_tokens":425476,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11904},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"ea42fa83-df9f-4c1b-a075-4fb8ea1f2f9e","timestamp":"2026-11-05T06:06:30.141Z","request_id":"req_011CgjGxrTMYgTRnwYom6VVm","wire_tool_inputs":{"toolu_018rnYyhtejsett78QGjiCAy":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/games/fit && cat > mod.rs <<'EOF'\n//! Whiff Fit: a five-day balance-and-wellness comedy at Tippy Cay, a resort staffed entirely by\n//! talking gym equipment. All game state and flow live here, driven by `InputFrame`, so tests can\n//! play the whole game with no browser or GPU. `README.md` in the dev folder says how to add an\n//! event, a set or a song.\n\npub mod bot;\npub mod check;\npub mod core;\npub mod dialog;\npub mod events;\npub mod finale;\npub mod flow;\npub mod ghost;\npub mod island;\npub mod medley;\npub mod menus;\npub mod meta;\npub mod rules;\npub mod run;\npub mod screens;\npub mod script;\npub mod ui_model;\npub mod world;\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::Result;\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse self::dialog::Dialog;\nuse self::events::{Cx, EventKind, Intent};\nuse self::island::Interact;\nuse self::menus::Menu;\nuse self::meta::{Guest, SaveData};\nuse self::rules::Rules;\nuse self::run::{EventRun, RunPhase};\nuse self::ui_model::UiFrame;\nuse self::world::*;\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::{RenderObject, SimEvent};\nuse crate::input::{InputFrame, buttons as b};\nuse crate::sim::Sim;\n\n/// The game's title. One constant; the resort's name doesn't depend on it.\npub const TITLE: &str = \"Whiff Fit\";\npub const TAGLINE: &str = \"A balance comedy at Tippy Cay\";\n\n/// What the page tells the game when it boots. Passing the date as data keeps the rule that the\n/// sim never reads the clock.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Boot {\n    /// Days since 1970, today.\n    pub today: i64,\n    pub touch_only: bool,\n}\n\n/// Dev mode's toggles.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Dev {\n    pub tab: usize,\n    pub group: usize,\n    pub no_tips: bool,\n    pub autoplay: bool,\n    pub skip_dialog: bool,\n    pub time_scale: f32,\n    pub hold: bool,\n    pub step: bool,\n    pub input_view: bool,\n    pub trace: bool,\n    pub stats: bool,\n    pub free_cam: bool,\n    pub ghost_lanes: bool,\n    pub win_now: bool,\n    pub lose_now: bool,\n}\n\nimpl Default for Dev {\n    fn default() -> Self {\n        Self {\n            tab: 0,\n            group: 0,\n            no_tips: false,\n            autoplay: false,\n            skip_dialog: false,\n            time_scale: 1.0,\n            hold: false,\n            step: false,\n            input_view: false,\n            trace: false,\n            stats: false,\n            free_cam: false,\n            ghost_lanes: true,\n            win_now: false,\n            lose_now: false,\n        }\n    }\n}\n\n/// What to do when a dialogue ends.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub enum After {\n    #[default]\n    Nothing,\n    Morning,\n    StartCheck,\n    Island,\n    Credits(u8),\n}\n\n/// The base screen.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub enum Flow {\n    #[default]\n    Title,\n    Attract(Box<flow::Attract>),\n    Slots,\n    Names(u8),\n    Look(u8, String),\n    Intro,\n    Morning,\n    Check(Box<check::Check>),\n    Report(Box<flow::Report>),\n    Island,\n    Event(Box<EventRun>),\n    Stamp(f32, u8),\n    Ending(f32, u8),\n    Credits(f32, u8),\n    Together(u8),\n    Medley(Box<medley::Medley>),\n}\n\n/// A screen stacked over the base. All but the hub's freeze the world.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Overlay {\n    Pause,\n    Schedule(i8),\n    Calendar,\n    Wardrobe,\n    Settings,\n    ConfirmReset,\n    HowTo(u8),\n    About(u8),\n    Dev,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct FitGame {\n    pub rules: Rules,\n    pub save: SaveData,\n    pub save_serial: u64,\n    #[serde(skip)]\n    pub save_text: Arc<String>,\n    pub slot: Option<usize>,\n    pub flow: Flow,\n    pub overlays: Vec<Overlay>,\n    pub focus: usize,\n    pub focus_stack: Vec<usize>,\n    pub scroll: usize,\n    pub bounce: f32,\n    pub repeat: [f32; 4],\n    pub dialog: Option<Dialog>,\n    pub after: After,\n    pub pid: EntityId,\n    pub stages: [Vec3; 9],\n    pub spots: Vec<Interact>,\n    pub flips: Vec<(u8, EntityId, Vec3)>,\n    pub near: Option<usize>,\n    pub walk: Vec<Vec3>,\n    pub walk_then: Option<usize>,\n    pub boot: Boot,\n    pub session: bool,\n    pub hub_ended: bool,\n    pub idle: f32,\n    pub time: f32,\n    pub song: u8,\n    pub dev: Dev,\n    pub seed: u64,\n    pub fullscreen_serial: u32,\n    pub rumble: f32,\n    pub island_quip: Option<(Dialog, f32)>,\n    pub goal_said: bool,\n    pub clam_pulse: f32,\n    pub clam: Option<EntityId>,\n    pub gulls: Vec<flow::GullRig>,\n    pub spin: f32,\n    pub last_input: InputFrame,\n    pub paused_t: f32,\n    pub demo_guest: bool,\n    pub outcome: Outcome,\n    pub stats_played: u32,\n    /// The scene's direct route (`fit/event/<name>`, for tools and tests).\n    pub direct: Option<EventKind>,\n    pub bot_tick: u64,\n    pub wave_t: f32,\n    #[serde(skip)]\n    pub about: Arc<Vec<(String, String)>>,\n    #[serde(skip)]\n    pub nav: Option<Arc<crate::nav::NavGrid>>,\n}\n\n/// Builds every set, then routes the scene: `fit`, `fit/medley`, `fit/event/<name>`.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    script::reload();\n    let rules = Rules::load()?;\n    world::load_sets(sim)?;\n    let mut stages = [Vec3::ZERO; 9];\n    for (i, s) in [Set::Hub, Set::Studio, Set::Gazebo, Set::Boardwalk, Set::Tide, Set::Channel, Set::Pier, Set::Tower, Set::Bay].iter().enumerate() {\n        stages[i] = set_markers(sim, *s, \"stage\").first().copied().unwrap_or(Vec3::new(i as f32 * 500.0, 0.0, 0.0));\n    }\n    sim.state.world.current_room = Some(0);\n    sim.state.spawn = stages[0];\n    let pid = sim.spawn_player();\n    sim.state.focus = stages[0];\n    let spots = island::gather(sim);\n    let clam = sim.state.entities.iter().find(|e| e.name == \"clam\").map(|e| e.id);\n    let seed = sim.state.seed;\n    let mut game = FitGame {\n        rules,\n        save: SaveData::default(),\n        save_serial: 0,\n        save_text: Arc::new(String::new()),\n        slot: None,\n        flow: Flow::Title,\n        overlays: Vec::new(),\n        focus: 0,\n        focus_stack: Vec::new(),\n        scroll: 0,\n        bounce: 0.0,\n        repeat: [0.0; 4],\n        dialog: None,\n        after: After::Nothing,\n        pid,\n        stages,\n        spots,\n        flips: Vec::new(),\n        near: None,\n        walk: Vec::new(),\n        walk_then: None,\n        boot: Boot::default(),\n        session: false,\n        hub_ended: false,\n        idle: 0.0,\n        time: 0.0,\n        song: 0,\n        dev: Dev::default(),\n        seed,\n        fullscreen_serial: 0,\n        rumble: 0.0,\n        island_quip: None,\n        goal_said: false,\n        clam_pulse: 0.0,\n        clam,\n        gulls: Vec::new(),\n        spin: 0.0,\n        last_input: InputFrame::default(),\n        paused_t: 0.0,\n        demo_guest: false,\n        outcome: Outcome::Playing,\n        stats_played: 0,\n        direct: None,\n        bot_tick: 0,\n        wave_t: 0.0,\n        about: Arc::new(flow::about_pages(\"\")),\n        nav: None,\n    };\n    let mut ev = Vec::new();\n    game.gulls = flow::spawn_gulls(sim, stages[0]);\n    match rest {\n        Some(\"medley\") => {\n            game.session = true;\n            game.start_medley_hub(sim, &mut ev);\n        }\n        Some(r) if r.starts_with(\"event/\") => {\n            let kind = EventKind::from_key(&r[\"event/\".len()..]).ok_or_else(|| anyhow::anyhow!(\"no event {r}\"))?;\n            game.direct = Some(kind);\n            game.save.slots[0] = Some(Guest { name: \"Test Guest\".into(), day: 5, checked: true, ..Default::default() });\n            game.slot = Some(0);\n            game.start_event(sim, &mut ev, kind);\n        }\n        _ => game.to_title(sim, &mut ev),\n    }\n    sim.events.extend(ev);\n    sim.state.play = Some(GameBox::new(game));\n    Ok(())\n}\n\n/// The boot data, the save and the About text from the page.\npub fn install_boot(sim: &mut Sim, boot: Boot, save: Option<&str>, about: &str) {\n    let today = boot.today;\n    let Some(game) = sim.state.play.as_mut().and_then(|g| g.get_mut::<FitGame>()) else { return };\n    game.boot = boot;\n    if let Some(s) = save.and_then(SaveData::parse) {\n        game.save = s;\n    }\n    game.about = Arc::new(flow::about_pages(about));\n    game.mark_saved();\n    let _ = today;\n}\n\nimpl FitGame {\n    pub fn guest(&self) -> Option<&Guest> {\n        self.slot.and_then(|i| self.save.slots.get(i)).and_then(|g| g.as_ref())\n    }\n    pub fn guest_mut(&mut self) -> Option<&mut Guest> {\n        self.slot.and_then(|i| self.save.slots.get_mut(i)).and_then(|g| g.as_mut())\n    }\n    pub fn day(&self) -> u8 {\n        self.guest().map(|g| g.day).unwrap_or(1)\n    }\n\n    /// Writes the save (the app copies it to `localStorage` when the serial changes).\n    pub fn mark_saved(&mut self) {\n        self.save_serial += 1;\n        self.save_text = Arc::new(self.save.to_json());\n    }\n\n    pub fn music(&mut self, ev: &mut Vec<SimEvent>, song: u8) {\n        if self.song != song {\n            self.song = song;\n            ev.push(SimEvent::Music { song });\n        }\n    }\n\n    /// The figure's slump: posture improves as the age falls.\n    pub fn slump(&self) -> f32 {\n        let age = self.guest().and_then(|g| g.ages.last().copied()).unwrap_or(40) as f32;\n        (((age - 24.0) / 56.0).clamp(0.0, 1.0)) * 0.16\n    }\n\n    /// What an event may touch.\n    pub fn cx<'a>(&'a self, sim: &'a mut Sim, ev: &'a mut Vec<SimEvent>, dt: f32) -> Cx<'a> {\n        let (assist, no_tips) = (self.save.settings.assist, self.dev.no_tips);\n        Cx {\n            sim,\n            rules: &self.rules,\n            ev,\n            dt,\n            pid: self.pid,\n            no_tips,\n            assist,\n            stages: &self.stages,\n            day: self.day(),\n            slump: self.slump(),\n            seed: self.seed,\n        }\n    }\n\n    /// Mouse-steered events keep their own meaning of the buttons.\n    fn intent(&self, input: &InputFrame) -> Intent {\n        Intent::from_input(input, self.save.settings.lean_sens)\n    }\n\n    fn frozen_now(&self) -> bool {\n        if self.session {\n            return false;\n        }\n        if self.dev.hold && !self.dev.step {\n            return true;\n        }\n        !self.overlays.is_empty()\n    }\n}\n\nimpl Game for FitGame {\n    const KEY: &'static str = \"fit\";\n\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        let mut out = BTreeMap::new();\n        self.time += dt;\n        self.bot_tick += 1;\n        self.bounce = (self.bounce - dt * 4.0).max(0.0);\n        // Attract's bot and dev autoplay play for you; the real buttons still pause and exit.\n        let auto = matches!(self.flow, Flow::Attract(_)) || (self.dev.autoplay && self.overlays.is_empty());\n        let mut input = *input;\n        if auto {\n            let real = input;\n            input = self.bot(sim);\n            input.any = real.any;\n            input.ui = real.ui;\n            input.pressed |= real.pressed & (b::PAUSE | b::BACK);\n            input.held |= real.held & (b::PAUSE | b::BACK);\n            if matches!(self.flow, Flow::Attract(_)) {\n                input.pressed &= !b::PAUSE;\n            }\n        }\n        // A hub session that ended takes no more input.\n        if self.hub_ended {\n            input = InputFrame::default();\n        }\n        self.last_input = input;\n        let mv = self.drive(sim, &input, dt, ev);\n        self.dev.step = false;\n        if !self.frozen_now() {\n            if let Some(pid) = sim.state.player {\n                out.insert(pid, InputFrame { move_dir: mv, ..Default::default() });\n            }\n        }\n        out\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn frozen(&self) -> bool {\n        self.frozen_now()\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new()\n    }\n\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.status_json(sim)\n    }\n\n    fn page_status(&self, sim: &Sim) -> Option<String> {\n        Some(self.status_json(sim).to_string())\n    }\n\n    fn ui_frame(&self, sim: &Sim) -> Option<Arc<UiFrame>> {\n        Some(Arc::new(self.build_ui(sim)))\n    }\n\n    fn camera_yaw(&self, _sim: &Sim) -> Option<f32> {\n        let run = match &self.flow {\n            Flow::Event(r) => Some(&**r),\n            Flow::Attract(a) => a.run.as_ref(),\n            _ => None,\n        }?;\n        match &run.st {\n            events::EventState::Lap(l) if run.phase != RunPhase::Result => Some(l.yaw),\n            _ => None,\n        }\n    }\n\n    fn extra_objects(&self, _sim: &Sim) -> Vec<RenderObject> {\n        self.local_ghosts()\n    }\n\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        self.bot_input(sim)\n    }\n}\n\nimpl FitGame {\n    /// The status for tools, tests and the page.\n    pub fn status_json(&self, sim: &Sim) -> serde_json::Value {\n        let g = self.guest();\n        let screen = self.screen_name();\n        let hub = self.hub_status();\n        let mut v = json!({\n            \"screen\": screen,\n            \"tick\": sim.state.tick,\n            \"focus\": self.focus,\n            \"day\": g.map(|g| g.day),\n            \"minutes\": g.map(|g| g.minutes),\n            \"stamps\": g.map(|g| g.stamps),\n            \"age\": g.and_then(|g| g.ages.last().copied()),\n            \"song\": self.song,\n            \"attract\": matches!(self.flow, Flow::Attract(_)),\n            \"attract_seg\": if let Flow::Attract(a) = &self.flow { a.seg as i64 } else { -1 },\n            \"hub\": hub,\n            \"touch_only\": self.boot.touch_only,\n            \"frozen\": self.frozen_now(),\n            \"music_setting\": self.save.settings.music,\n        });\n        if let Flow::Event(r) = &self.flow {\n            v[\"event\"] = json!(r.kind.key());\n            v[\"phase\"] = json!(format!(\"{:?}\", r.phase));\n            v[\"score\"] = json!(r.c.score);\n        }\n        v\n    }\n\n    pub fn screen_name(&self) -> String {\n        if let Some(m) = self.menu().filter(|m| m.key != \"touch\") {\n            return m.key.to_string();\n        }\n        if self.dialog.is_some() {\n            return \"dialog\".into();\n        }\n        match &self.flow {\n            Flow::Title => \"title\",\n            Flow::Attract(_) => \"attract\",\n            Flow::Slots => \"slots\",\n            Flow::Names(_) => \"names\",\n            Flow::Look(..) => \"look\",\n            Flow::Intro | Flow::Morning => \"morning\",\n            Flow::Check(_) => \"check\",\n            Flow::Report(_) => \"report\",\n            Flow::Island => \"island\",\n            Flow::Event(r) => match r.phase {\n                RunPhase::Card => \"card\",\n                RunPhase::Count => \"count\",\n                RunPhase::Play => \"event\",\n                RunPhase::Result => \"result\",\n            },\n            Flow::Stamp(..) => \"stamp\",\n            Flow::Ending(..) => \"ending\",\n            Flow::Credits(..) => \"credits\",\n            Flow::Together(_) => \"together\",\n            Flow::Medley(m) => m.screen(),\n        }\n        .to_string()\n    }\n\n    /// Local ghosts, in the same lanes as the hub's.\n    fn local_ghosts(&self) -> Vec<RenderObject> {\n        if !self.dev.ghost_lanes {\n            return Vec::new();\n        }\n        let run = match &self.flow {\n            Flow::Event(r) => &**r,\n            Flow::Medley(m) => match &m.run {\n                Some(r) => r,\n                None => return Vec::new(),\n            },\n            _ => return Vec::new(),\n        };\n        if !matches!(run.phase, RunPhase::Play | RunPhase::Count) {\n            return Vec::new();\n        }\n        let mut out = Vec::new();\n        for (i, frames) in run.ghosts.iter().enumerate() {\n            let Some(g) = ghost::sample(frames, run.c.t) else { continue };\n            let seat = i + 1;\n            let look = ghost::seat_look(seat);\n            let lane = run.kind.lane() * (i as f32 + 1.0);\n            out.push(ghost::ghost_object(0x7000_0000 + i as u32, &g, lane, &look, ghost::SEATS[seat % 4], 0.55));\n            if let Some(board) = ghost::stands_on(0x7000_0100 + i as u32, run.kind, &g, lane) {\n                out.push(board);\n            }\n        }\n        out\n    }\n\n    pub fn near_spot(&self) -> Option<&Interact> {\n        self.near.and_then(|i| self.spots.get(i))\n    }\n}\n\n/// A focus-independent helper for the UI: which way is the lean pointing, as text (dev view).\npub fn lean_text(v: Vec2) -> String {\n    format!(\"{:+.2} {:+.2}\", v.x, v.y)\n}\nEOF\ncat >> ghost.rs <<'EOF'\n\n/// What a ghost stands on, in its lane (a paddleboard).\npub fn stands_on(id: u32, kind: super::events::EventKind, g: &GFrame, lane: Vec3) -> Option<RenderObject> {\n    let (half, h) = kind.ghost_stands_on()?;\n    let feet = Vec3::from(g.p) + lane;\n    let mut visual = Visual::new(Shape::RoundedBox { half, radius: half.min_element() * 0.8 }, crate::color::Color::hex(\"#fbfaf6\"));\n    visual.look = crate::shape::Look::Cel;\n    Some(RenderObject {\n        id: EntityId(id),\n        pos: feet + Vec3::Y * h,\n        rot: Quat::from_rotation_y(g.f),\n        visual,\n        prop: None,\n        puppet: None,\n        pulse: -1.0,\n        soft: None,\n        vehicle: None,\n        cone: None,\n        scenery: false,\n    })\n}\nEOF\ncat > medley.rs <<'EOF'\n//! The Inter-Resort Medley: three events, one after another, final score is their sum. An AI Hub\n//! session plays one copy per player; Play Together passes one pad round.\n\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::events::{EventKind, Intent};\nuse super::ghost::{GFrame, GHOST_HZ};\nuse super::run::{EventRun, RunPhase};\nuse super::ui_model::*;\nuse super::world::*;\nuse super::{Flow, FitGame};\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, buttons as b};\nuse crate::rng::Rng;\nuse crate::sim::Sim;\n\npub const ORDER: [EventKind; 3] = [EventKind::PaddleSlalom, EventKind::TideTable, EventKind::CannonballCup];\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum MPhase {\n    /// Waiting for the hub to say go.\n    #[default]\n    Waiting,\n    /// A pass-the-pad card.\n    Pass,\n    Run,\n    /// The score of the event that just ended.\n    Interlude,\n    Podium,\n    Done,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct MPlayer {\n    pub name: String,\n    pub scores: [f32; 3],\n    pub runs: Vec<Vec<GFrame>>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Medley {\n    pub hub: bool,\n    pub seed: u64,\n    pub players: Vec<MPlayer>,\n    pub cur: usize,\n    pub i: usize,\n    pub run: Option<EventRun>,\n    pub phase: MPhase,\n    pub t: f32,\n}\n\nimpl Medley {\n    pub fn screen(&self) -> &'static str {\n        match self.phase {\n            MPhase::Waiting => \"medley_wait\",\n            MPhase::Pass => \"pass\",\n            MPhase::Run => \"medley_run\",\n            MPhase::Interlude => \"medley_score\",\n            MPhase::Podium => \"podium\",\n            MPhase::Done => \"medley_done\",\n        }\n    }\n    pub fn total(&self, p: usize) -> f32 {\n        self.players.get(p).map(|x| x.scores.iter().sum()).unwrap_or(0.0)\n    }\n}\n\nimpl FitGame {\n    /// A session: no title, no menu, no attract. The round opens straight away.\n    pub fn start_medley_hub(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let m = Medley {\n            hub: true,\n            seed: self.seed,\n            players: vec![MPlayer { name: \"You\".into(), ..Default::default() }],\n            phase: MPhase::Waiting,\n            ..Default::default()\n        };\n        self.flow = Flow::Medley(Box::new(m));\n        self.save.slots[0] = Some(super::meta::Guest { name: \"Guest\".into(), day: 5, checked: true, ..Default::default() });\n        self.slot = Some(0);\n        show_set(sim, Set::Channel);\n        let at = self.stages[Set::Channel as usize];\n        place(sim, self.pid, at, std::f32::consts::PI);\n        cam_full(sim, 22.0, 0.0, 10.0, 40.0, 0.9, 0.1, None);\n        self.music(ev, song::LOBBY);\n    }\n\n    pub fn start_together(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>, count: usize) {\n        let m = Medley {\n            hub: false,\n            seed: self.seed,\n            players: (0..count).map(|i| MPlayer { name: format!(\"Guest {}\", i + 1), ..Default::default() }).collect(),\n            phase: MPhase::Pass,\n            ..Default::default()\n        };\n        self.flow = Flow::Medley(Box::new(m));\n        self.save_look_for(sim, 0);\n        self.music(ev, song::LOBBY);\n    }\n\n    fn save_look_for(&mut self, sim: &mut Sim, seat: usize) {\n        let look = super::ghost::seat_look(seat);\n        if let Some(ch) = sim.state.entities.get_mut(self.pid).and_then(|e| e.character.as_mut()) {\n            ch.puppet = Some(look);\n        }\n    }\n\n    fn medley_run(&self, m: &Medley, sim: &mut Sim, ev: &mut Vec<SimEvent>, dt: f32) -> EventRun {\n        let kind = ORDER[m.i];\n        let mut run = EventRun::new(kind, 5, &self.rules);\n        run.medley = true;\n        // The same seed gives the same course on every copy, whatever came before it.\n        sim.state.rng = Rng::new(m.seed.wrapping_add(1000 * (m.i as u64 + 1)));\n        for (p, player) in m.players.iter().enumerate() {\n            if p < m.cur {\n                if let Some(frames) = player.runs.get(m.i) {\n                    run.ghosts.push(frames.clone());\n                    run.ghost_names.push(player.name.clone());\n                }\n            }\n        }\n        let mut cx = self.cx(sim, ev, dt);\n        run.begin(&mut cx);\n        run\n    }\n\n    /// One tick of a round.\n    pub fn medley_tick(&mut self, m: &mut Medley, sim: &mut Sim, input: &InputFrame, ev: &mut Vec<SimEvent>, dt: f32) {\n        m.t += dt;\n        match m.phase {\n            MPhase::Waiting => {\n                if input.down(b::HUB_GO) {\n                    m.phase = MPhase::Run;\n                    m.t = 0.0;\n                    let run = self.medley_run(m, sim, ev, dt);\n                    m.run = Some(run);\n                }\n            }\n            MPhase::Pass => {}\n            MPhase::Run => {\n                let it: Intent = Intent::from_input(input, self.save.settings.lean_sens);\n                let mut done = false;\n                if let Some(mut run) = m.run.take() {\n                    {\n                        let mut cx = self.cx(sim, ev, dt);\n                        // Session or not, no one is held at the card.\n                        done = run.tick(&mut cx, &it);\n                    }\n                    m.run = Some(run);\n                }\n                if done {\n                    if let Some(run) = &m.run {\n                        let p = &mut m.players[m.cur];\n                        p.scores[m.i] = run.out.score;\n                        p.runs.push(run.rec.clone());\n                    }\n                    self.stats_played += 1;\n                    ev.push(SimEvent::Sfx { id: sound::FANFARE, gain: 0.6, pitch: 1.0 });\n                    m.phase = MPhase::Interlude;\n                    m.t = 0.0;\n                }\n            }\n            MPhase::Interlude => {\n                if m.t > 3.0 || (!m.hub && input.just(b::CONFIRM | b::PRIMARY)) {\n                    if let Some(mut run) = m.run.take() {\n                        let mut cx = self.cx(sim, ev, dt);\n                        run.stop(&mut cx);\n                    }\n                    m.i += 1;\n                    m.t = 0.0;\n                    if m.i >= ORDER.len() {\n                        m.i = 0;\n                        m.cur += 1;\n                        if m.cur >= m.players.len() {\n                            m.phase = if m.hub { MPhase::Done } else { MPhase::Podium };\n                            show_set(sim, Set::Hub);\n                            let at = self.stages[0];\n                            place(sim, self.pid, at, 0.0);\n                            cam_orbit(sim, 14.0, 9.0, 36.0, 1.0, -30.0, 30.0, 26.0);\n                            ev.push(SimEvent::Sfx { id: sound::FANFARE, gain: 0.9, pitch: 1.0 });\n                            self.music(ev, song::LOBBY);\n                        } else {\n                            m.phase = MPhase::Pass;\n                            let seat = m.cur;\n                            self.save_look_for(sim, seat);\n                        }\n                    } else {\n                        m.phase = MPhase::Run;\n                        let run = self.medley_run(m, sim, ev, dt);\n                        m.run = Some(run);\n                    }\n                }\n            }\n            MPhase::Podium | MPhase::Done => {}\n        }\n    }\n\n    pub fn medley_ready(&mut self, m: &mut Medley, sim: &mut Sim, ev: &mut Vec<SimEvent>, dt: f32) {\n        m.phase = MPhase::Run;\n        m.t = 0.0;\n        let run = self.medley_run(m, sim, ev, dt);\n        m.run = Some(run);\n    }\n\n    /// What the page reports: score, label, done, stats and the ghost message.\n    pub fn hub_status(&self) -> serde_json::Value {\n        let Flow::Medley(m) = &self.flow else {\n            return serde_json::Value::Null;\n        };\n        if !m.hub {\n            return serde_json::Value::Null;\n        }\n        let banked = m.total(0);\n        let live = m.run.as_ref().filter(|r| r.phase == RunPhase::Play).map(|r| r.c.score).unwrap_or(0.0);\n        let label = match m.phase {\n            MPhase::Waiting => \"Warming up\".to_string(),\n            MPhase::Done => \"Finished\".to_string(),\n            _ => ORDER[m.i.min(2)].name().to_string(),\n        };\n        let score = (banked + live).round();\n        let scores: Vec<f64> = m.players[0].scores.iter().map(|s| (*s as f64).round()).collect();\n        json!({\n            \"score\": score,\n            \"label\": label,\n            \"done\": m.phase == MPhase::Done,\n            \"stats\": { \"paddle\": scores[0], \"tide\": scores[1], \"cannonball\": scores[2] },\n            \"ghost\": self.hub_ghost(m),\n        })\n    }\n\n    fn hub_ghost(&self, m: &Medley) -> serde_json::Value {\n        let Some(run) = m.run.as_ref().filter(|_| m.phase == MPhase::Run || m.phase == MPhase::Interlude) else {\n            return json!({ \"area\": -1 });\n        };\n        let g = run.rec.last().copied().unwrap_or_default();\n        json!({ \"area\": m.i, \"p\": g.p, \"f\": g.f, \"l\": g.l, \"c\": g.c, \"t\": g.t, \"s\": run.c.score.round() })\n    }\n}\n\nimpl Medley {\n    pub fn hud(&self, game: &FitGame, ui: &mut Ui) {\n        match self.phase {\n            MPhase::Waiting => {\n                ui.card(460.0, 340.0, 1000.0, 300.0);\n                ui.title(960.0, 370.0, 80.0, INK, Align::Center, \"The Inter-Resort Medley\");\n                ui.text(960.0, 490.0, 42.0, INK_SOFT, Align::Center, \"Three events. One number. Please wait to be weighed. Not weighed. Counted.\");\n            }\n            MPhase::Pass => {\n                let p = &self.players[self.cur];\n                ui.card(460.0, 300.0, 1000.0, 400.0);\n                ui.text(960.0, 330.0, 44.0, INK_SOFT, Align::Center, \"Pass the pad to\");\n                ui.title(960.0, 400.0, 110.0, TEAL, Align::Center, p.name.clone());\n                ui.para(960.0, 550.0, 860.0, 38.0, INK, Align::Center, super::script::line(\"pip.pass\", self.cur));\n            }\n            MPhase::Run => {\n                if let Some(run) = &self.run {\n                    run.hud(&game.rules, ui, &super::script::line(&format!(\"card.{}\", run.kind.key()), 0));\n                }\n                let total = self.total(self.cur);\n                ui.panel(1474.0, 150.0, 410.0, 70.0, with_alpha(WHITE, 0.93), 30.0);\n                ui.text(1860.0, 160.0, 36.0, INK, Align::Right, format!(\"Medley {:.0}\", total));\n                if self.hub {\n                    let n = self.i + 1;\n                    ui.panel(36.0, 150.0, 360.0, 0.0, WHITE, 0.0);\n                    let _ = n;\n                }\n            }\n            MPhase::Interlude => {\n                let s = self.players[self.cur].scores[self.i];\n                ui.card(560.0, 300.0, 800.0, 380.0);\n                ui.label(960.0, 330.0, 54.0, INK_SOFT, Align::Center, ORDER[self.i].name());\n                ui.title(960.0, 400.0, 150.0, INK, Align::Center, format!(\"{s:.0}\"));\n                ui.stars(960.0, 610.0, game.rules.stars(s), 3, 60.0);\n            }\n            MPhase::Podium => {\n                let mut order: Vec<usize> = (0..self.players.len()).collect();\n                order.sort_by(|a, b| self.total(*b).total_cmp(&self.total(*a)));\n                ui.card(360.0, 90.0, 1200.0, 760.0);\n                ui.title(960.0, 110.0, 96.0, INK, Align::Center, \"The Podium\");\n                for (rank, &p) in order.iter().enumerate() {\n                    let y = 250.0 + rank as f32 * 130.0;\n                    let col = if rank == 0 { SUN } else { SKY };\n                    ui.panel(460.0, y, 1000.0, 110.0, col, 30.0);\n                    ui.label(500.0, y + 22.0, 58.0, INK, Align::Left, format!(\"{}. {}\", rank + 1, self.players[p].name));\n                    ui.label(1420.0, y + 22.0, 58.0, INK, Align::Right, format!(\"{:.0}\", self.total(p)));\n                }\n                ui.para(960.0, 780.0, 1000.0, 36.0, INK_SOFT, Align::Center, super::script::line(\"pip.podium\", self.players.len()));\n            }\n            MPhase::Done => {\n                ui.card(460.0, 300.0, 1000.0, 420.0);\n                ui.label(960.0, 330.0, 54.0, INK_SOFT, Align::Center, \"Your Medley\");\n                ui.title(960.0, 400.0, 150.0, INK, Align::Center, format!(\"{:.0}\", self.total(0)));\n                ui.text(960.0, 610.0, 40.0, INK_SOFT, Align::Center, \"Pip has this written down.\");\n            }\n        }\n    }\n}\n\n/// Seconds of a ghost at frame `n`.\npub fn frame_time(n: usize) -> f32 {\n    n as f32 / GHOST_HZ\n}\nEOF\necho ok","description":"Write the main game struct, ghost board and Medley module"}},"wire_ingest_context":{"toolu_018rnYyhtejsett78QGjiCAy":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/games/fit"}}}
