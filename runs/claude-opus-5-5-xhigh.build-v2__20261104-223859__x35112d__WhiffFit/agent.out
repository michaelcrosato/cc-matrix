 => vec![(note(Triangle, 1318.0, 0.09, 0.26), 0.0), (note(Sine, 2637.0, 0.1, 0.1), 0.0)],\n        s::MISS => vec![(Patch { freq_end: 150.0 * k, glide: 0.12, duty: 0.3, cutoff: 1200.0, ..note(Square, 240.0, 0.13, 0.12) }, 0.0)],\n        s::COUNT => vec![(note(Square, 660.0, 0.1, 0.14), 0.0)],\n        s::GO => vec![(note(Square, 1320.0, 0.26, 0.16), 0.0)],\n        s::BOARD => vec![(Patch { freq_end: 340.0 * k, glide: 0.12, ..note(Sine, 120.0, 0.17, 0.42) }, 0.0)],\n        s::STITCH => vec![(Patch { freq_end: 320.0, glide: 0.1, ..note(Saw, 640.0, 0.14, 0.2) }, 0.0)],\n        s::RIBBON => vec![(note(Triangle, 1175.0, 0.1, 0.2), 0.0), (note(Triangle, 1760.0, 0.16, 0.18), 0.05)],\n        s::BUMP => vec![(Patch { freq_end: 60.0, glide: 0.08, ..note(Sine, 140.0, 0.12, 0.5) }, 0.0), (noise(0.06, 0.2, 1400.0, 300.0), 0.0)],\n        s::HEARTBEAT => vec![(Patch { freq_end: 40.0, glide: 0.06, ..note(Sine, 80.0, 0.1, 0.5) }, 0.0), (Patch { freq_end: 40.0, glide: 0.06, ..note(Sine, 70.0, 0.1, 0.4) }, 0.2)],\n        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).\"\"\")\nR(\"\"\"enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\"\"\",\"\"\"enum Cmd {\n    Play(usize, Patch, f32, f32, f32),\n    Master(f32),\n    Buses([f32; 3]),\n    Song(u8),\n    Hold(bool),\n}\"\"\")\nR(\"\"\"pub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\"\"\",\"\"\"pub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n    song_pos: Arc<AtomicU64>,\n}\"\"\")\nR(\"\"\"        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\"\"\",\"\"\"        let (tx, rx) = channel::<Cmd>();\n        let song_pos = Arc::new(AtomicU64::new(0));\n        // A smaller buffer than the web backend's default: snappier effects.\n        #[cfg(target_arch = \"wasm32\")]\n        let config = cpal::StreamConfig { buffer_size: cpal::BufferSize::Fixed(1024), ..config };\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, song_pos.clone())?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, song_pos.clone())?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, song_pos.clone())?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, song_pos })\n    }\n\n    /// Music, effects and voice levels (0..1).\n    pub fn set_buses(&self, music: f32, sfx: f32, voice: f32) {\n        let mut b = [0.0; 3];\n        b[BUS_MUSIC] = music;\n        b[BUS_SFX] = sfx;\n        b[BUS_VOICE] = voice;\n        let _ = self.tx.send(Cmd::Buses(b));\n    }\n\n    /// Holds or releases the sequencer (and so the rhythm clock).\n    pub fn hold_music(&self, on: bool) {\n        let _ = self.tx.send(Cmd::Hold(on));\n    }\n\n    /// Seconds into the song, as far as the sound device has rendered.\n    pub fn song_seconds(&self) -> f64 {\n        self.song_pos.load(Ordering::Relaxed) as f64 / self.sample_rate.max(1) as f64\n    }\n\"\"\")\nR(\"\"\"    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain) = match event_pos(ev) {\"\"\",\"\"\"    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        if let SimEvent::Music { song } = ev {\n            let _ = self.tx.send(Cmd::Song(*song));\n            return;\n        }\n        let bus = if matches!(ev, SimEvent::Syllable { .. }) { BUS_VOICE } else { BUS_SFX };\n        let (pan, gain) = match event_pos(ev) {\"\"\")\nR(\"\"\"            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\"\"\",\"\"\"            let _ = self.tx.send(Cmd::Play(bus, patch, pan, gain * sfx, delay));\"\"\")\nR(\"\"\"fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\"\"\",\"\"\"fn build<T>(\n    device: &cpal::Device,\n    config: cpal::StreamConfig,\n    rx: Receiver<Cmd>,\n    channels: usize,\n    song_pos: Arc<AtomicU64>,\n) -> anyhow::Result<cpal::Stream>\"\"\")\nR(\"\"\"    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();\"\"\",\"\"\"    let mut mixer = Mixer::new(config.sample_rate as f32);\n    mixer.song_pos = song_pos;\n    let mut buf: Vec<f32> = Vec::new();\"\"\")\nR(\"\"\"                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\"\"\",\"\"\"                    Cmd::Play(bus, p, pan, gain, delay) => mixer.play_on(bus, p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                    Cmd::Buses(b) => mixer.bus = b,\n                    Cmd::Song(n) => mixer.set_song(n),\n                    Cmd::Hold(h) => mixer.hold = h,\"\"\")\nR(\"\"\"#[cfg(test)]\nmod tests {\n    use super::*;\n\"\"\",\"\"\"/// Renders `seconds` of song `n` at a music level, offline (tests).\npub fn render_song(n: u8, seconds: f32, rate: f32, music: f32) -> Vec<f32> {\n    let mut m = Mixer::new(rate);\n    m.bus = [1.0, 1.0, music];\n    m.master = 1.0;\n    m.set_song(n);\n    let mut out = vec![0.0; (seconds * rate) as usize * 2];\n    for chunk in out.chunks_mut(512) {\n        m.render(chunk);\n    }\n    out\n}\n\n/// Root-mean-square of a buffer.\npub fn rms(v: &[f32]) -> f32 {\n    (v.iter().map(|x| x * x).sum::<f32>() / v.len().max(1) as f32).sqrt()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn music_at_ten_percent_is_a_tenth_of_full_scale() {\n        for n in 1..=music::SONG_COUNT {\n            let full = rms(&render_song(n, 8.0, 22050.0, 1.0));\n            let low = rms(&render_song(n, 8.0, 22050.0, 0.1));\n            assert!(full > 0.01, \"song {n} is silent: {full}\");\n            let ratio = low / full;\n            assert!((0.085..0.125).contains(&ratio), \"song {n}: at 10% it's {ratio} of full ({full})\");\n        }\n    }\n\n    #[test]\n    fn every_sound_in_the_bank_makes_noise() {\n        use pav_core::games::fit::world::sound;\n        for id in 0..sound::TOTAL {\n            let ev = SimEvent::Sfx { id, gain: 1.0, pitch: 1.0 };\n            let out = render_events(&[(0.0, ev)], 3.0, 22050.0, &Listener::default());\n            let peak = out.iter().fold(0.0f32, |m, s| m.max(s.abs()));\n            assert!(peak > 0.005, \"sound {id} is silent\");\n        }\n    }\n\n    #[test]\n    fn speakers_differ() {\n        let render = |speaker| {\n            let ev = SimEvent::Syllable { speaker, vowel: 0, pitch: 1.0 };\n            render_events(&[(0.0, ev)], 0.3, 22050.0, &Listener::default())\n        };\n        let mut sounds = Vec::new();\n        for s in 0..8 {\n            let out = render(s);\n            assert!(rms(&out) > 0.001, \"speaker {s} is silent\");\n            // Crossings per second: a rough pitch.\n            let zc = out.chunks(2).map(|c| c[0]).collect::<Vec<_>>().windows(2).filter(|w| w[0] * w[1] < 0.0).count();\n            sounds.push(zc);\n        }\n        for a in 0..8 {\n            for b in a + 1..8 {\n                assert_ne!(render(a as u8), render(b as u8), \"speakers {a} and {b} sound the same\");\n            }\n        }\n        // Kettle is far lower than Pip.\n        assert!(sounds[2] < sounds[0], \"Kettle {} Pip {}\", sounds[2], sounds[0]);\n    }\n\n    #[test]\n    fn a_song_fades_to_silence_and_holds_still() {\n        let mut m = Mixer::new(22050.0);\n        m.bus = [1.0, 1.0, 1.0];\n        m.set_song(6);\n        let mut b = vec![0.0; 22050 * 2];\n        m.render(&mut b);\n        assert!(rms(&b) > 0.01);\n        let at = m.song_pos.load(Ordering::Relaxed);\n        assert!(at > 20000);\n        m.hold = true;\n        m.render(&mut b);\n        assert_eq!(m.song_pos.load(Ordering::Relaxed), at);\n        m.hold = false;\n        m.set_song(0);\n        for _ in 0..7 {\n            m.render(&mut b);\n        }\n        assert!(rms(&b) < 1e-3, \"faded: {}\", rms(&b));\n        assert_eq!(m.song(), 0);\n    }\n\"\"\")\nopen(p,'w').write(s)\nEOF\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine; CARGO_BUILD_JOBS=8 timeout 400 cargo test --locked -q -p pav_audio -p pav_ui --message-format=short 2>&1 | grep -E \"^(crates|error)|^test result|panicked|FAILED|song |sound |speaker\" | cut -c1-240 | head -30","description":"Write audio sequencer, voices, SFX bank and run audio/UI tests","timeout":420000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1040,"cache_read_input_tokens":604315,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1040},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"27fdca2c-496d-40b0-a3bf-36f4c7676a37","timestamp":"2026-11-05T06:33:09.855Z","request_id":"req_011CgjJxwNGgwuRpwTQSwC6q","wire_tool_inputs":{"toolu_017CCVopC9iBL5EW3kNJvnVu":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_audio/src && cat > music.rs <<'EOF'\n//! The sequencer: runs inside `Mixer::render`, so timing is sample-accurate. A song is a tempo,\n//! steps per beat, a chord progression, and tracks of a patch plus a pattern written by hand as\n//! scale degrees. New song: add a function below and a line in `song`.\n\nuse crate::{Patch, Wave};\n\n/// One part of a song, looped.\npub struct Track {\n    pub patch: Patch,\n    pub gain: f32,\n    /// One entry per step: scale degree (1-based, 8 = an octave up), 0 for a rest.\n    pub steps: Vec<i8>,\n    /// Octave offset, in semitones.\n    pub transpose: i32,\n    /// Follows the chord root; drums and drones don't.\n    pub follow: bool,\n    /// Note length in steps.\n    pub len: f32,\n}\n\npub struct Song {\n    pub bpm: f32,\n    pub steps_per_beat: u32,\n    pub beats_per_bar: u32,\n    /// Root note of the key, as a MIDI number.\n    pub root: i32,\n    /// Semitones above the root, per scale degree.\n    pub scale: &'static [i32],\n    /// Semitones the chord root sits above the key's, per bar.\n    pub chords: &'static [i32],\n    pub tracks: Vec<Track>,\n}\n\nconst MAJOR: &[i32] = &[0, 2, 4, 5, 7, 9, 11];\nconst PENTA: &[i32] = &[0, 2, 4, 7, 9];\nconst DORIAN: &[i32] = &[0, 2, 3, 5, 7, 9, 10];\n\nfn pat(text: &str) -> Vec<i8> {\n    text.chars()\n        .filter(|c| !c.is_whitespace() && *c != '|')\n        .map(|c| match c {\n            '.' => 0,\n            '1'..='9' => c as i8 - b'0' as i8,\n            'x' => 1,\n            _ => 0,\n        })\n        .collect()\n}\n\n/// A plucked nylon-like string.\nfn pluck(vol: f32) -> Patch {\n    Patch { attack: 0.003, decay: 0.32, volume: vol, cutoff: 2800.0, cutoff_end: 900.0, ..Patch::new(Wave::Triangle, 220.0) }\n}\nfn bass(vol: f32) -> Patch {\n    Patch { attack: 0.004, decay: 0.22, sustain: 0.3, hold: 0.05, release: 0.08, volume: vol, cutoff: 700.0, cutoff_end: 400.0, ..Patch::new(Wave::Sine, 110.0) }\n}\nfn brush(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 0.06, volume: vol, cutoff: 9000.0, cutoff_end: 5000.0, ..Patch::new(Wave::Noise, 1.0) }\n}\nfn kick(vol: f32) -> Patch {\n    Patch { freq_end: 46.0, glide: 0.09, attack: 0.001, decay: 0.16, volume: vol, cutoff: 2000.0, cutoff_end: 500.0, ..Patch::new(Wave::Sine, 150.0) }\n}\nfn clap(vol: f32) -> Patch {\n    Patch { attack: 0.001, decay: 0.09, volume: vol, cutoff: 5200.0, cutoff_end: 2200.0, ..Patch::new(Wave::Noise, 1.0) }\n}\nfn snare(vol: f32) -> Patch {\n    Patch { attack: 0.001, decay: 0.07, volume: vol, cutoff: 6800.0, cutoff_end: 3000.0, ..Patch::new(Wave::Noise, 1.0) }\n}\nfn pad(vol: f32) -> Patch {\n    Patch {\n        attack: 1.4,\n        decay: 0.6,\n        sustain: 0.8,\n        hold: 1.6,\n        release: 1.8,\n        volume: vol,\n        cutoff: 700.0,\n        cutoff_end: 500.0,\n        lfo_rate: 0.17,\n        lfo_depth: 0.5,\n        ..Patch::new(Wave::Saw, 220.0)\n    }\n}\nfn bell(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 1.4, volume: vol, ..Patch::new(Wave::Sine, 880.0) }\n}\nfn mallet(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 0.2, volume: vol, cutoff: 4200.0, cutoff_end: 1200.0, ..Patch::new(Wave::Triangle, 440.0) }\n}\nfn tuba(vol: f32) -> Patch {\n    Patch { attack: 0.03, decay: 0.2, sustain: 0.6, hold: 0.1, release: 0.1, volume: vol, cutoff: 800.0, cutoff_end: 500.0, duty: 0.4, ..Patch::new(Wave::Square, 110.0) }\n}\nfn brass(vol: f32) -> Patch {\n    Patch { attack: 0.03, decay: 0.12, sustain: 0.7, hold: 0.1, release: 0.08, volume: vol, cutoff: 1800.0, cutoff_end: 1200.0, ..Patch::new(Wave::Saw, 220.0) }\n}\nfn stab(vol: f32) -> Patch {\n    Patch { attack: 0.004, decay: 0.12, volume: vol, cutoff: 2600.0, cutoff_end: 900.0, duty: 0.3, ..Patch::new(Wave::Square, 330.0) }\n}\n\n/// Song `n`, or none.\npub fn song(n: u8) -> Option<Song> {\n    match n {\n        1 => Some(lobby_bossa()),\n        2 => Some(tide_pad()),\n        3 => Some(iron_waltz()),\n        4 => Some(step_party()),\n        5 => Some(lagoon_mallets()),\n        6 => Some(band_of_guests()),\n        _ => None,\n    }\n}\n\npub const SONG_COUNT: u8 = 6;\n\nfn tr(patch: Patch, gain: f32, steps: &str, transpose: i32, follow: bool, len: f32) -> Track {\n    Track { patch, gain, steps: pat(steps), transpose, follow, len }\n}\n\n/// Resort lounge, not gym.\nfn lobby_bossa() -> Song {\n    Song {\n        bpm: 84.0,\n        steps_per_beat: 2,\n        beats_per_bar: 4,\n        root: 55,\n        scale: MAJOR,\n        chords: &[0, 0, 5, 5, 2, 7, 0, 0],\n        tracks: vec![\n            tr(pluck(0.34), 1.0, \"1.35 .3.5 1.35 .3.5\", 0, true, 1.0),\n            tr(bass(0.5), 1.0, \"1..5 ..5. 1..5 ..3.\", -12, true, 1.4),\n            tr(brush(0.05), 1.0, \"x.xx x.xx x.xx x.xx\", 0, false, 1.0),\n            tr(pluck(0.3), 1.0, \"........ 5.6.8... ........ 8.6.5.3. ........ 3.5.6... ........ 5.3.1... \", 12, false, 2.0),\n        ],\n    }\n}\n\n/// Slow pads and sparse bells, no beat.\nfn tide_pad() -> Song {\n    Song {\n        bpm: 50.0,\n        steps_per_beat: 1,\n        beats_per_bar: 4,\n        root: 50,\n        scale: PENTA,\n        chords: &[0, 0, -2, -2, 3, 3, 5, 5],\n        tracks: vec![\n            tr(pad(0.2), 1.0, \"1...\", 0, true, 4.0),\n            tr(pad(0.14), 1.0, \"3...\", 12, true, 4.0),\n            tr(pad(0.12), 1.0, \"4...\", 0, true, 4.0),\n            tr(bell(0.17), 1.0, \".... ..5. .... .... ...3 .... .... .4.. .... 2... .... ....\", 24, false, 2.0),\n        ],\n    }\n}\n\n/// 3/4, low pizzicato bass, a dignified tuba-like square.\nfn iron_waltz() -> Song {\n    Song {\n        bpm: 108.0,\n        steps_per_beat: 1,\n        beats_per_bar: 3,\n        root: 43,\n        scale: MAJOR,\n        chords: &[0, 5, 7, 0, 0, 9, 2, 7],\n        tracks: vec![\n            tr(pluck(0.48), 1.0, \"1..\", -12, true, 0.8),\n            tr(mallet(0.14), 1.0, \".35\", 12, true, 0.6),\n            tr(tuba(0.2), 1.0, \"...... 3.2 1.. ...... 5.6 5.. ...... 8.7 6.5 ...... 3.2 1..\", 0, false, 1.3),\n        ],\n    }\n}\n\n/// 96 BPM funk-pop, clear kick and clap for timing.\nfn step_party() -> Song {\n    Song {\n        bpm: 96.0,\n        steps_per_beat: 4,\n        beats_per_bar: 4,\n        root: 45,\n        scale: DORIAN,\n        chords: &[0, 0, 3, 5],\n        tracks: vec![\n            tr(kick(0.75), 1.0, \"x... x... x... x...\", 0, false, 1.0),\n            tr(clap(0.32), 1.0, \".... x... .... x...\", 0, false, 1.0),\n            tr(brush(0.09), 1.0, \"..x. ..x. ..x. ..x.\", 0, false, 1.0),\n            tr(bass(0.46), 1.0, \"1.1. ..1. 7.1. ..5.\", -12, true, 1.5),\n            tr(stab(0.17), 1.0, \"..5. .5.. ..3. .5.. ..5. .5.. ..6. .7..\", 12, true, 1.0),\n            tr(stab(0.13), 1.0, \"................ ................ 1.3.5.8.. .8.5.3. ................ \", 24, false, 1.0),\n        ],\n    }\n}\n\n/// 110 BPM marimba-like triangle, playful.\nfn lagoon_mallets() -> Song {\n    Song {\n        bpm: 110.0,\n        steps_per_beat: 2,\n        beats_per_bar: 4,\n        root: 60,\n        scale: MAJOR,\n        chords: &[0, 5, 7, 5, 0, 9, 5, 7],\n        tracks: vec![\n            tr(mallet(0.34), 1.0, \"1358 5315 1358 6531\", 0, true, 0.9),\n            tr(mallet(0.2), 1.0, \"..8. .6.. 5..3 ..5.\", 12, false, 0.9),\n            tr(bass(0.4), 1.0, \"1..1 .5.. 1..1 .5..\", -24, true, 1.2),\n            tr(brush(0.05), 1.0, \".x.x .x.x .x.x .x.x\", 0, false, 1.0),\n        ],\n    }\n}\n\n/// Marching brass and snare; the game fades it to silence for the last phase.\nfn band_of_guests() -> Song {\n    Song {\n        bpm: 96.0,\n        steps_per_beat: 2,\n        beats_per_bar: 4,\n        root: 46,\n        scale: MAJOR,\n        chords: &[0, 0, 7, 0, 5, 0, 7, 0],\n        tracks: vec![\n            tr(snare(0.2), 1.0, \"x.xx x.xx x.xx xxxx\", 0, false, 1.0),\n            tr(kick(0.42), 1.0, \"x... x... x... x...\", 0, false, 1.0),\n            tr(tuba(0.3), 1.0, \"1.5. 1.5. 1.5. 1.5.\", -12, true, 1.0),\n            tr(brass(0.17), 1.0, \"5.5. 5.65 8.8. 8.75 6.6. 6.75 5... ....\", 12, false, 1.4),\n            tr(brass(0.12), 1.0, \"3.3. 3.43 5.5. 5.53 4.4. 4.53 3... ....\", 12, false, 1.4),\n        ],\n    }\n}\n\n/// A running song.\npub struct Sequencer {\n    pub song: Song,\n    pub song_id: u8,\n    step: u64,\n    /// Samples into the song.\n    pub samples: u64,\n    next_step_at: f64,\n    pub steps_per_sample: f64,\n}\n\nimpl Sequencer {\n    pub fn new(song: Song, id: u8, rate: f32) -> Self {\n        let steps_per_second = song.bpm as f64 / 60.0 * song.steps_per_beat as f64;\n        Self { song, song_id: id, step: 0, samples: 0, next_step_at: 0.0, steps_per_sample: steps_per_second / rate as f64 }\n    }\n\n    /// One sample's worth of time: the notes that start now, as (patch, gain).\n    pub fn advance(&mut self, out: &mut Vec<(Patch, f32)>) {\n        let at = self.samples as f64 * self.steps_per_sample;\n        self.samples += 1;\n        if at < self.next_step_at {\n            return;\n        }\n        self.next_step_at += 1.0;\n        let s = self.step;\n        self.step += 1;\n        let song = &self.song;\n        let per_bar = (song.steps_per_beat * song.beats_per_bar) as u64;\n        let bar = s / per_bar;\n        let chord = song.chords[bar as usize % song.chords.len().max(1)];\n        let step_secs = 60.0 / song.bpm / song.steps_per_beat as f32;\n        for t in &song.tracks {\n            if t.steps.is_empty() {\n                continue;\n            }\n            let d = t.steps[(s % t.steps.len() as u64) as usize];\n            if d <= 0 {\n                continue;\n            }\n            let mut p = t.patch;\n            if p.wave != Wave::Noise {\n                let n = song.scale.len() as i32;\n                let deg = d as i32 - 1;\n                let semis = song.scale[(deg % n) as usize] + 12 * (deg / n);\n                let midi = song.root + t.transpose + semis + if t.follow { chord } else { 0 };\n                let f = 440.0 * 2f32.powf((midi as f32 - 69.0) / 12.0);\n                let k = p.freq_end / p.freq.max(1.0);\n                // A pitched drum keeps its own glide; everything else plays the note.\n                if p.glide == 0.1 || (k - 1.0).abs() < 1e-3 {\n                    p.freq = f;\n                    p.freq_end = f;\n                }\n            }\n            if t.len > 1.2 && p.hold == 0.0 && p.sustain == 0.0 {\n                p.decay = p.decay.max(t.len * step_secs);\n            }\n            out.push((p, t.gain));\n        }\n    }\n}\nEOF\ncat > voice.rs <<'EOF'\n//! Animalese-style voices: one formant-filtered saw blip per syllable, plus a tiny noise click for\n//! the consonant. No real words are ever spoken. Each speaker has its own pitch and timbre.\n\nuse crate::{Patch, Wave};\n\n/// Formant pairs for the five vowels (Hz).\npub const FORMANTS: [(f32, f32); 5] = [(800.0, 1150.0), (420.0, 1950.0), (300.0, 2300.0), (480.0, 820.0), (340.0, 700.0)];\n\nstruct Speaker {\n    pitch: f32,\n    /// Formants scaled for size.\n    formant: f32,\n    wave: Wave,\n    decay: f32,\n    glide: f32,\n    click: f32,\n    /// Sings in unison with itself.\n    double: bool,\n    /// A wood-block knock on each syllable.\n    wood: bool,\n}\n\nconst SPEAKERS: [Speaker; 8] = [\n    // Pip: high and rubbery; each syllable squeaks up.\n    Speaker { pitch: 560.0, formant: 1.25, wave: Wave::Saw, decay: 0.085, glide: 1.22, click: 0.05, double: false, wood: false },\n    // Posey: soft, wood-block attack.\n    Speaker { pitch: 290.0, formant: 1.0, wave: Wave::Triangle, decay: 0.13, glide: 0.98, click: 0.0, double: false, wood: true },\n    // Big Kettle: very low.\n    Speaker { pitch: 92.0, formant: 0.72, wave: Wave::Saw, decay: 0.16, glide: 0.96, click: 0.06, double: false, wood: false },\n    // Bounce: fast and breathless.\n    Speaker { pitch: 430.0, formant: 1.15, wave: Wave::Saw, decay: 0.06, glide: 1.12, click: 0.1, double: false, wood: false },\n    // Commodore Gull: nasal and clipped.\n    Speaker { pitch: 640.0, formant: 1.35, wave: Wave::Square, decay: 0.055, glide: 0.92, click: 0.05, double: false, wood: false },\n    // Marjorie: warm and unhurried.\n    Speaker { pitch: 245.0, formant: 1.05, wave: Wave::Saw, decay: 0.13, glide: 0.97, click: 0.03, double: false, wood: false },\n    // Two-Towel Tom.\n    Speaker { pitch: 165.0, formant: 0.9, wave: Wave::Saw, decay: 0.11, glide: 0.99, click: 0.05, double: false, wood: false },\n    // The Twins: two of them, slightly apart.\n    Speaker { pitch: 350.0, formant: 1.1, wave: Wave::Saw, decay: 0.09, glide: 1.03, click: 0.04, double: true, wood: false },\n];\n\n/// The patches of one syllable.\npub fn syllable(speaker: u8, vowel: u8, pitch: f32) -> Vec<(Patch, f32)> {\n    let sp = &SPEAKERS[(speaker as usize).min(SPEAKERS.len() - 1)];\n    let (a, b) = FORMANTS[(vowel as usize).min(4)];\n    // A little melody from the vowel, so a line isn't one note.\n    let wiggle = [1.0, 1.06, 1.12, 0.94, 0.89][(vowel as usize).min(4)];\n    let f = sp.pitch * pitch * wiggle;\n    let blip = Patch {\n        freq_end: f * sp.glide,\n        glide: sp.decay,\n        attack: 0.006,\n        decay: sp.decay,\n        volume: 0.42,\n        formant: [a * sp.formant, b * sp.formant],\n        ..Patch::new(sp.wave, f)\n    };\n    let mut out = vec![(blip, 0.0)];\n    if sp.click > 0.0 {\n        out.push((Patch { attack: 0.001, decay: 0.012, volume: sp.click, cutoff: 7000.0, cutoff_end: 3000.0, ..Patch::new(Wave::Noise, 1.0) }, 0.0));\n    }\n    if sp.wood {\n        out.push((Patch { attack: 0.001, decay: 0.03, volume: 0.16, freq_end: 620.0, glide: 0.02, ..Patch::new(Wave::Sine, 780.0) }, 0.0));\n    }\n    if sp.double {\n        let mut second = blip;\n        second.freq = f * 1.012;\n        second.freq_end = f * sp.glide * 1.012;\n        out.push((second, 0.012));\n    }\n    out\n}\nEOF\npython3 - <<'EOF'\np='lib.rs'\ns=open(p).read()\ndef R(a,b):\n    global s\n    assert a in s, a[:70]\n    s=s.replace(a,b,1)\nR(\"\"\"use std::sync::mpsc::{Receiver, Sender, channel};\n\"\"\",\"\"\"use std::sync::Arc;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::mpsc::{Receiver, Sender, channel};\n\"\"\")\nR(\"\"\"use pav_core::SimEvent;\n\"\"\",\"\"\"use pav_core::SimEvent;\n\npub mod music;\npub mod voice;\n\n/// Where a voice is mixed.\npub const BUS_SFX: usize = 0;\npub const BUS_VOICE: usize = 1;\npub const BUS_MUSIC: usize = 2;\n\"\"\")\nR(\"\"\"    /// Square-wave duty cycle.\n    pub duty: f32,\n}\"\"\",\"\"\"    /// Square-wave duty cycle.\n    pub duty: f32,\n    /// Two parallel band-pass filters (Hz, a vowel's formants); 0 = none.\n    pub formant: [f32; 2],\n    /// A slow wobble of the low-pass cutoff: rate (Hz) and depth (0..1 of the cutoff).\n    pub lfo_rate: f32,\n    pub lfo_depth: f32,\n}\"\"\")\nR(\"\"\"            cutoff_end: 12000.0,\n            duty: 0.5,\n        }\"\"\",\"\"\"            cutoff_end: 12000.0,\n            duty: 0.5,\n            formant: [0.0, 0.0],\n            lfo_rate: 0.0,\n            lfo_depth: 0.0,\n        }\"\"\")\nR(\"\"\"    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {\"\"\",\"\"\"    gain_l: f32,\n    gain_r: f32,\n    bus: usize,\n    // Two state-variable band-pass filters.\n    f_low: [f32; 2],\n    f_band: [f32; 2],\n}\n\nimpl Voice {\"\"\")\nR(\"\"\"        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\"\"\",\"\"\"        let mut cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        if p.lfo_rate > 0.0 {\n            cutoff *= 1.0 + p.lfo_depth * (self.t * p.lfo_rate * std::f32::consts::TAU).sin();\n        }\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let mut out = self.lp;\n        if p.formant[0] > 0.0 {\n            out = 0.0;\n            for i in 0..2 {\n                let f = 2.0 * (std::f32::consts::PI * (p.formant[i] * dt).min(0.2)).sin();\n                self.f_low[i] += f * self.f_band[i];\n                let high = self.lp - self.f_low[i] - 0.28 * self.f_band[i];\n                self.f_band[i] += f * high;\n                out += self.f_band[i] * if i == 0 { 0.5 } else { 0.32 };\n            }\n        }\n        let s = out * self.env() * p.volume;\"\"\")\nR(\"\"\"pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\"\"\",\"\"\"pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n    /// Gain per bus, applied to each voice as it mixes.\n    pub bus: [f32; 3],\n    seq: Option<music::Sequencer>,\n    /// 1 while a song plays; falls to 0 as it fades out.\n    fade: f32,\n    fading: bool,\n    /// The sequencer stands still (the game is paused).\n    pub hold: bool,\n    /// Samples into the song, for the rhythm clock.\n    pub song_pos: Arc<AtomicU64>,\n    notes: Vec<(Patch, f32)>,\n}\n\nconst MAX_VOICES: usize = 128;\n/// Seconds a song takes to fade to silence.\nconst FADE_SECONDS: f32 = 5.0;\n\"\"\")\nR(\"\"\"        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\"\"\",\"\"\"        Self {\n            voices: Vec::new(),\n            sample_rate,\n            master: 0.8,\n            seed: 0x9e37_79b9,\n            bus: [1.0, 1.0, 0.1],\n            seq: None,\n            fade: 1.0,\n            fading: false,\n            hold: false,\n            song_pos: Arc::new(AtomicU64::new(0)),\n            notes: Vec::new(),\n        }\n    }\n\n    /// Starts song `n` from its beginning; 0 fades the music to silence.\n    pub fn set_song(&mut self, n: u8) {\n        if n == 0 {\n            self.fading = true;\n            return;\n        }\n        if let Some(song) = music::song(n) {\n            self.seq = Some(music::Sequencer::new(song, n, self.sample_rate));\n            self.fading = false;\n            self.fade = 1.0;\n            self.song_pos.store(0, Ordering::Relaxed);\n        }\n    }\n\n    pub fn song(&self) -> u8 {\n        self.seq.as_ref().map(|s| s.song_id).unwrap_or(0)\n    }\n\"\"\")\nR(\"\"\"    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\"\"\",\"\"\"    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        self.play_on(BUS_SFX, p, pan, gain, delay);\n    }\n\n    pub fn play_on(&mut self, bus: usize, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\"\"\")\nR(\"\"\"            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\"\"\",\"\"\"            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n            bus,\n            f_low: [0.0; 2],\n            f_band: [0.0; 2],\n        });\"\"\")\nR(\"\"\"        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\"\"\",\"\"\"        let mut retire = false;\n        for frame in out.chunks_mut(2) {\n            if !self.hold {\n                if let Some(seq) = &mut self.seq {\n                    seq.advance(&mut self.notes);\n                    self.song_pos.store(seq.samples, Ordering::Relaxed);\n                }\n                if !self.notes.is_empty() {\n                    let notes = std::mem::t