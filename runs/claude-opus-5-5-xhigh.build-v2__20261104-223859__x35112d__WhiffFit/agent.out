{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGqvt4ijRWNbqkXU6x9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013dKEXPjQM47Ca46CbaZVeR","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/games/fit && python3 - <<'EOF'\ns=open('events/step.rs').read()\ns=s.replace(\"let at = ch.lead_in_beats + b as f32 * 4.0 + i as f32 * 0.5;\",\"let at = ch.lead_in_beats + b as f32 * 4.0 + i as f32 * 0.25;\")\nopen('events/step.rs','w').write(s)\ns=open('charts.toml').read()\ns=s.replace(\"one line per bar of eighths:\",\"one line per 4/4 bar of sixteenths:\")\ns=s.replace('''party = [\n  \"L...R...L...R...\",''','''party = [\n  \"L.......R.......\",\n  \"L.......R.......\",\n  \"L...R...L...R...\",''')\ns=s.replace('''  \"L.R.L.R.B.......\",\n  \"L...B...R...B...\",''','''  \"L.R.L.R.B.......\",\n  \"L...R...L...R...\",\n  \"L...R...B.......\",\n  \"L...B...R...B...\",''')\nopen('charts.toml','w').write(s)\ns=open('events/mod.rs').read()\ns=s.replace(\"\"\"    Dive(dive::CannonballCup),\n}\n\nmacro_rules!\"\"\",\"\"\"    Dive(dive::CannonballCup),\n    Stand(Box<super::finale::BigStand>),\n}\n\nmacro_rules!\"\"\")\ns=s.replace(\"\"\"            EventState::Dive($e) => $b,\n        }\"\"\",\"\"\"            EventState::Dive($e) => $b,\n            EventState::Stand($e) => $b,\n        }\"\"\")\ns=s.replace(\"\"\"            EventKind::CannonballCup | EventKind::BigStand => EventState::Dive(dive::CannonballCup::new()),\n\"\"\",\"\"\"            EventKind::CannonballCup => EventState::Dive(dive::CannonballCup::new()),\n            EventKind::BigStand => EventState::Stand(Box::new(super::finale::BigStand::new(0))),\n\"\"\")\ns=s.replace(\"\"\"            EventState::Lap(_) => song::LOBBY,\n\"\"\",\"\"\"            EventState::Lap(_) => song::LOBBY,\n            EventState::Stand(_) => song::BAND,\n\"\"\")\nopen('events/mod.rs','w').write(s)\nEOF\ncat > run.rs <<'EOF'\n//! The common frame of an event: card, 3-2-1, play, result. One of these runs inside a stay, a\n//! Medley round and attract mode alike.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse super::check::quip_ui;\nuse super::events::{Cx, EventKind, EventState, Intent, RunCommon};\nuse super::ghost::{GFrame, GHOST_HZ};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum RunPhase {\n    #[default]\n    Card,\n    Count,\n    Play,\n    Result,\n}\n\n/// What a finished event gave.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Outcome {\n    pub score: f32,\n    pub stars: u8,\n    pub title: String,\n    pub minutes: u32,\n    pub best: bool,\n    pub prior: Option<u32>,\n    pub comment: String,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct EventRun {\n    pub kind: EventKind,\n    pub st: EventState,\n    pub c: RunCommon,\n    pub phase: RunPhase,\n    pub pt: f32,\n    pub out: Outcome,\n    /// This run, as it is recorded for ghosts.\n    pub rec: Vec<GFrame>,\n    /// Other runs to show in neighbouring lanes.\n    pub ghosts: Vec<Vec<GFrame>>,\n    pub ghost_names: Vec<String>,\n    /// Attract mode: no card, no tips, nothing saved; stops at the time limit.\n    pub demo: bool,\n    pub limit: Option<f32>,\n    /// A Medley round: a short card, no retry.\n    pub medley: bool,\n    pub started: bool,\n    pub count_i: i32,\n}\n\nimpl EventRun {\n    pub fn new(kind: EventKind, day: u8, r: &Rules) -> Self {\n        Self {\n            kind,\n            st: EventState::new(kind, day, r),\n            c: RunCommon::default(),\n            phase: RunPhase::Card,\n            pt: 0.0,\n            out: Outcome::default(),\n            rec: Vec::new(),\n            ghosts: Vec::new(),\n            ghost_names: Vec::new(),\n            demo: false,\n            limit: None,\n            medley: false,\n            started: false,\n            count_i: 4,\n        }\n    }\n\n    /// Sets the stage. Everything the event places, it places here.\n    pub fn begin(&mut self, cx: &mut Cx) {\n        self.c.core = super::core::BalanceCore::new(&mut cx.sim.state.rng);\n        self.st.start(&mut self.c, cx);\n        self.started = true;\n        cx.ev.push(SimEvent::Music { song: self.st.song() });\n        if self.demo {\n            self.phase = RunPhase::Play;\n        }\n    }\n\n    /// One tick. True when the Result is reached (the owner banks it).\n    pub fn tick(&mut self, cx: &mut Cx, it: &Intent) -> bool {\n        let dt = cx.dt;\n        self.pt += dt;\n        if let Some(q) = &mut self.c.quip {\n            q.tick(1, dt, cx.ev);\n            self.c.quip_t -= dt;\n            if self.c.quip_t <= 0.0 {\n                self.c.quip = None;\n            }\n        }\n        match self.phase {\n            RunPhase::Card => {\n                // A short card in a Medley; else it waits for you.\n                if self.medley && self.pt > 2.0 {\n                    self.phase = RunPhase::Count;\n                    self.pt = 0.0;\n                }\n                if !self.medley && it.act_just && self.pt > 0.2 {\n                    self.phase = RunPhase::Count;\n                    self.pt = 0.0;\n                    cx.sfx(sound::UI_CONFIRM, 0.8, 1.0);\n                }\n            }\n            RunPhase::Count => {\n                let n = 3 - self.pt as i32;\n                if n != self.count_i {\n                    self.count_i = n;\n                    cx.sfx(if n > 0 { sound::COUNT } else { sound::GO }, 0.8, 1.0);\n                }\n                if self.pt >= 3.0 {\n                    self.phase = RunPhase::Play;\n                    self.pt = 0.0;\n                }\n            }\n            RunPhase::Play => {\n                self.c.t += dt;\n                // Record the run, five frames a second.\n                let n = (self.c.t * GHOST_HZ) as usize;\n                if n >= self.rec.len() {\n                    self.rec.push(self.frame_of(cx));\n                }\n                self.ghost_dots();\n                if let Some(score) = self.st.tick(&mut self.c, cx, it) {\n                    self.out.score = score;\n                    self.c.score = score;\n                    self.phase = RunPhase::Result;\n                    self.pt = 0.0;\n                    return true;\n                }\n                if self.limit.is_some_and(|l| self.c.t >= l) {\n                    self.phase = RunPhase::Result;\n                    self.pt = 0.0;\n                    return true;\n                }\n            }\n            RunPhase::Result => {}\n        }\n        false\n    }\n\n    fn frame_of(&self, cx: &Cx) -> GFrame {\n        let (feet, facing, clip, clip_t) = match cx.sim.state.entities.get(cx.pid) {\n            Some(e) => {\n                let ch = e.character.as_ref();\n                let h = ch.map(|c| c.height() * 0.5).unwrap_or(0.0);\n                let a = ch.map(|c| c.anim).unwrap_or_default();\n                (e.pos - Vec3::Y * h, a.facing, a.clip, a.clip_t)\n            }\n            None => (Vec3::ZERO, 0.0, 0, 0.0),\n        };\n        GFrame::new(feet, facing, self.c.core.cob, clip, clip_t, self.c.score)\n    }\n\n    fn ghost_dots(&mut self) {\n        let g = self.ghosts.first().and_then(|g| super::ghost::sample(g, self.c.t));\n        self.c.ghost_dot = g.map(|g| g.l);\n        self.c.ghost_score = g.map(|g| g.s);\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        self.st.stop(cx);\n        stop_clip(cx.sim, cx.pid);\n        clear_lean(cx.sim, cx.pid);\n        self.started = false;\n    }\n\n    /// Events where the arrows are steps.\n    pub fn arrows_step(&self) -> bool {\n        self.kind.arrows_step()\n    }\n\n    pub fn hud(&self, r: &Rules, ui: &mut Ui, about: &str) {\n        match self.phase {\n            RunPhase::Card => {\n                let (x, y, w, h) = (360.0, 240.0, 1200.0, 560.0);\n                ui.card(x, y, w, h);\n                ui.title(960.0, y + 40.0, 96.0, INK, Align::Center, self.kind.name());\n                ui.para(960.0, y + 170.0, 1040.0, 42.0, INK_SOFT, Align::Center, about);\n                let coach = self.kind.coach();\n                let line = super::script::line(&format!(\"card.{}\", self.kind.key()), 1);\n                ui.label(960.0, y + 320.0, 36.0, TEAL, Align::Center, coach.name());\n                ui.para(960.0, y + 366.0, 1040.0, 38.0, INK, Align::Center, line);\n                if self.medley {\n                    ui.label(960.0, y + 470.0, 44.0, CORAL, Align::Center, \"Starting soon\");\n                } else {\n                    ui.prompt_row(&[(Act::Confirm, \"Begin\"), (Act::Back, \"Leave\")]);\n                }\n                self.st_controls(ui);\n            }\n            RunPhase::Count => {\n                let n = (3.0 - self.pt).ceil().clamp(1.0, 3.0) as i32;\n                let k = 1.0 - self.pt.fract();\n                ui.circle(960.0, 500.0, 120.0 + 60.0 * k, with_alpha(WHITE, 0.9), TEAL, 10.0);\n                ui.title(960.0, 410.0, 160.0, INK, Align::Center, n.to_string());\n                self.st.hud(&self.c, r, ui);\n            }\n            RunPhase::Play => {\n                self.st.hud(&self.c, r, ui);\n                quip_ui(&self.c, ui);\n            }\n            RunPhase::Result => self.result_ui(r, ui),\n        }\n    }\n\n    fn st_controls(&self, ui: &mut Ui) {\n        // The controls this event uses, as glyphs on the card.\n        let (x, y) = (560.0, 730.0);\n        match self.kind {\n            EventKind::TempoSquats | EventKind::BreathBloom => {\n                ui.prompt(x, y, Act::Confirm, \"Hold\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::Lean, \"Balance\", Align::Left);\n            }\n            EventKind::PlankStandoff => {\n                ui.prompt(x, y, Act::Brace, \"Hold both\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::Lean, \"Balance\", Align::Left);\n            }\n            EventKind::StepParty => {\n                ui.prompt(x, y, Act::StepL, \"Left\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::StepR, \"Right\", Align::Left);\n            }\n            EventKind::FloatieSpin | EventKind::MorningLap => {\n                ui.prompt(x, y, Act::Lean, \"Lean\", Align::Left);\n                ui.prompt(x + 280.0, y, Act::StepL, \"Left\", Align::Left);\n                ui.prompt(x + 530.0, y, Act::StepR, \"Right\", Align::Left);\n            }\n            EventKind::CannonballCup | EventKind::BigStand => {\n                ui.prompt(x, y, Act::Confirm, \"Action\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::Lean, \"Lean\", Align::Left);\n            }\n            _ => {\n                ui.prompt(x + 200.0, y, Act::Lean, \"Lean is all you have\", Align::Left);\n            }\n        }\n    }\n\n    fn result_ui(&self, _r: &Rules, ui: &mut Ui) {\n        let o = &self.out;\n        let (x, y, w, h) = (360.0, 90.0, 1200.0, 760.0);\n        ui.card(x, y, w, h);\n        ui.label(960.0, y + 24.0, 48.0, INK_SOFT, Align::Center, self.kind.name());\n        let roll = (self.pt / 1.1).min(1.0);\n        ui.title(960.0, y + 84.0, 160.0, INK, Align::Center, format!(\"{:.0}\", o.score * roll));\n        let shown = ((self.pt - 1.0) / 0.35).clamp(0.0, 3.0) as u8;\n        ui.stars(960.0, y + 320.0, shown.min(o.stars), 3, 74.0);\n        if self.pt > 1.4 {\n            ui.label(960.0, y + 386.0, 54.0, TEAL, Align::Center, o.title.clone());\n            ui.para(960.0, y + 464.0, 1040.0, 36.0, INK, Align::Center, o.comment.clone());\n        }\n        if self.pt > 1.8 && !self.medley && !self.demo {\n            let mut line = format!(\"{} minutes for the Clam\", o.minutes);\n            if o.best {\n                line.push_str(\". New personal best\");\n            } else if let Some(p) = o.prior {\n                line.push_str(&format!(\". Best so far {p}\"));\n            }\n            ui.text(960.0, y + 590.0, 36.0, INK_SOFT, Align::Center, line);\n            if let Some(g) = self.c.ghost_score {\n                let d = o.score - g;\n                let word = if d >= 0.0 { \"ahead of\" } else { \"behind\" };\n                ui.text(960.0, y + 640.0, 36.0, CORAL, Align::Center, format!(\"{:.0} {word} Yesterday You. I am not comparing you.\", d.abs()));\n            }\n        }\n    }\n}\nEOF\ncat > island.rs <<'EOF'\n//! Tippy Cay itself: what stands where, what you can walk up to, and the walk.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::dialog::Who;\nuse super::world::*;\nuse crate::entity::EntityId;\nuse crate::sim::Sim;\n\n/// A thing on the island you can walk up to.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Spot {\n    #[default]\n    None,\n    /// A pavilion's mat (index into `PAVILIONS`).\n    Mat(u8),\n    Talk(Who),\n    Cabana,\n    Clam,\n    Calendar,\n    Wardrobe,\n    Flip(u8),\n    BigStand,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]\npub struct Interact {\n    pub spot: Spot,\n    pub pos: Vec3,\n    pub id: Option<EntityId>,\n}\n\n/// A pavilion: its name and events.\npub struct Pavilion {\n    pub name: &'static str,\n    pub coach: Who,\n    pub opens: u8,\n    pub events: &'static [super::events::EventKind],\n}\n\nuse super::events::EventKind as K;\npub const PAVILIONS: [Pavilion; 4] = [\n    Pavilion { name: \"Stillness Studio\", coach: Who::Posey, opens: 1, events: &[K::BreathBloom, K::PoseParade] },\n    Pavilion { name: \"Iron Gazebo\", coach: Who::Kettle, opens: 2, events: &[K::TempoSquats, K::PlankStandoff] },\n    Pavilion { name: \"The Boardwalk\", coach: Who::Bounce, opens: 3, events: &[K::StepParty, K::FloatieSpin, K::MorningLap] },\n    Pavilion { name: \"The Lagoon\", coach: Who::Gull, opens: 4, events: &[K::TideTable, K::PaddleSlalom, K::TrayTrek, K::CannonballCup] },\n];\n\n/// Whether a point (set-local, about the stage) is on dry land you may walk on.\npub fn on_land(p: Vec3, stage: Vec3) -> bool {\n    let (x, z) = ((p.x - stage.x) / 29.0, (p.z - stage.z) / 21.0);\n    x.abs().powi(4) + z.abs().powi(4) <= 1.0\n}\n\n/// Everything you can walk up to, from the hub's markers and its people.\npub fn gather(sim: &mut Sim) -> Vec<Interact> {\n    let mut out = Vec::new();\n    let mark = |sim: &mut Sim, name: &str| set_markers(sim, Set::Hub, name).first().copied();\n    for (i, name) in [\"mat_studio\", \"mat_gazebo\", \"mat_boardwalk\", \"mat_lagoon\"].iter().enumerate() {\n        if let Some(pos) = mark(sim, name) {\n            out.push(Interact { spot: Spot::Mat(i as u8), pos, id: None });\n        }\n    }\n    for (spot, name) in [\n        (Spot::Cabana, \"int_cabana\"),\n        (Spot::Clam, \"int_clam\"),\n        (Spot::Calendar, \"int_calendar\"),\n        (Spot::Wardrobe, \"int_wardrobe\"),\n        (Spot::BigStand, \"int_stand\"),\n    ] {\n        if let Some(pos) = mark(sim, name) {\n            out.push(Interact { spot, pos, id: None });\n        }\n    }\n    for (who, name) in [\n        (Who::Pip, \"pip\"),\n        (Who::Posey, \"posey_hub\"),\n        (Who::Kettle, \"kettle_hub\"),\n        (Who::Bounce, \"bounce_hub\"),\n        (Who::Gull, \"gull_hub\"),\n        (Who::Marjorie, \"marjorie\"),\n        (Who::Tom, \"tom\"),\n        (Who::Twins, \"twin_a\"),\n    ] {\n        if let Some(id) = npc(sim, name) {\n            let pos = sim.feet(id).unwrap_or(Vec3::ZERO);\n            out.push(Interact { spot: Spot::Talk(who), pos, id: Some(id) });\n        }\n    }\n    out\n}\n\n/// A step toward `to`, as a move direction.\npub fn steer(from: Vec3, to: Vec3) -> Vec2 {\n    Vec2::new(to.x - from.x, to.z - from.z).normalize_or_zero()\n}\nEOF\ncat > menus.rs <<'EOF'\n//! Menus as data: every list on every screen comes from `FitGame::menu`, so the pad, the keys,\n//! the mouse, the bot and the tests all use one path.\n\nuse super::events::EventKind;\nuse super::ui_model::ItemKind;\n\n/// What an item does.\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum MAct {\n    None,\n    Stay,\n    Together,\n    Settings,\n    About,\n    Slot(u8),\n    Name(u16),\n    Skin,\n    Outfit,\n    Begin,\n    Resume,\n    Schedule,\n    Calendar,\n    Wardrobe,\n    HowTo,\n    Dev,\n    Quit,\n    Pavilion(u8),\n    Event(EventKind),\n    EndDay,\n    Reception,\n    Retry,\n    Done,\n    Music,\n    Sfx,\n    Voice,\n    Glyphs,\n    LeanSens,\n    Assist,\n    Rhythm,\n    TextSpeed,\n    Fullscreen,\n    ResetSave,\n    Yes,\n    No,\n    Wear(u8),\n    PagePrev,\n    PageNext,\n    Close,\n    Players(u8),\n    Go,\n    Ready,\n    DevDay(u8),\n    DevEvent(EventKind),\n    DevPhase(u8),\n    DevAttract,\n    DevMedley,\n    DevFlag(u8),\n    DevGive,\n    DevUnlock,\n    DevAllStars,\n    DevWin,\n    DevLose,\n    DevScale,\n    DevHold,\n    DevStep,\n    DevGroup,\n    DevParam(u16),\n    DevResetGroup,\n    DevResetAll,\n    DevResetGuest,\n}\n\n/// How a menu lays out.\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Layout {\n    /// A column of rows: left edge, top, width, row height; at most `visible` at once.\n    List { x: f32, y: f32, w: f32, row: f32, visible: usize },\n    /// A row of big cards, centred on the screen: top, card width and height.\n    Row { y: f32, w: f32, h: f32 },\n}\n\n#[derive(Clone, Debug)]\npub struct MItem {\n    pub act: MAct,\n    pub label: String,\n    pub sub: String,\n    pub kind: ItemKind,\n    pub stars: Option<u8>,\n}\n\nimpl MItem {\n    pub fn button(act: MAct, label: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Button, stars: None }\n    }\n    pub fn sub(mut self, sub: impl Into<String>) -> Self {\n        self.sub = sub.into();\n        self\n    }\n    pub fn stars(mut self, n: u8) -> Self {\n        self.stars = Some(n);\n        self\n    }\n    pub fn locked(mut self) -> Self {\n        self.kind = ItemKind::Locked;\n        self\n    }\n    pub fn slider(act: MAct, label: impl Into<String>, frac: f32, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Slider { frac, value: value.into() }, stars: None }\n    }\n    pub fn choice(act: MAct, label: impl Into<String>, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Choice { value: value.into() }, stars: None }\n    }\n}\n\n#[derive(Clone, Debug)]\npub struct Menu {\n    /// A name for tests: `title`, `pause`...\n    pub key: &'static str,\n    pub title: String,\n    pub sub: String,\n    pub items: Vec<MItem>,\n    pub layout: Layout,\n    pub tabs: Option<(Vec<&'static str>, usize)>,\n    pub back: bool,\n    /// Draws a card behind it, and how wide.\n    pub card: bool,\n    pub dim: bool,\n}\nEOF\necho done","description":"Write event run frame, island and menu data modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26637,"cache_read_input_tokens":398839,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26637},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"5162c8b2-3b07-451e-aa69-2de4d947f822","timestamp":"2026-11-05T06:04:10.167Z","request_id":"req_011CgjGqvch6QmyYa2GJcVEw","wire_tool_inputs":{"toolu_013dKEXPjQM47Ca46CbaZVeR":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/games/fit && python3 - <<'EOF'\ns=open('events/step.rs').read()\ns=s.replace(\"let at = ch.lead_in_beats + b as f32 * 4.0 + i as f32 * 0.5;\",\"let at = ch.lead_in_beats + b as f32 * 4.0 + i as f32 * 0.25;\")\nopen('events/step.rs','w').write(s)\ns=open('charts.toml').read()\ns=s.replace(\"one line per bar of eighths:\",\"one line per 4/4 bar of sixteenths:\")\ns=s.replace('''party = [\n  \"L...R...L...R...\",''','''party = [\n  \"L.......R.......\",\n  \"L.......R.......\",\n  \"L...R...L...R...\",''')\ns=s.replace('''  \"L.R.L.R.B.......\",\n  \"L...B...R...B...\",''','''  \"L.R.L.R.B.......\",\n  \"L...R...L...R...\",\n  \"L...R...B.......\",\n  \"L...B...R...B...\",''')\nopen('charts.toml','w').write(s)\ns=open('events/mod.rs').read()\ns=s.replace(\"\"\"    Dive(dive::CannonballCup),\n}\n\nmacro_rules!\"\"\",\"\"\"    Dive(dive::CannonballCup),\n    Stand(Box<super::finale::BigStand>),\n}\n\nmacro_rules!\"\"\")\ns=s.replace(\"\"\"            EventState::Dive($e) => $b,\n        }\"\"\",\"\"\"            EventState::Dive($e) => $b,\n            EventState::Stand($e) => $b,\n        }\"\"\")\ns=s.replace(\"\"\"            EventKind::CannonballCup | EventKind::BigStand => EventState::Dive(dive::CannonballCup::new()),\n\"\"\",\"\"\"            EventKind::CannonballCup => EventState::Dive(dive::CannonballCup::new()),\n            EventKind::BigStand => EventState::Stand(Box::new(super::finale::BigStand::new(0))),\n\"\"\")\ns=s.replace(\"\"\"            EventState::Lap(_) => song::LOBBY,\n\"\"\",\"\"\"            EventState::Lap(_) => song::LOBBY,\n            EventState::Stand(_) => song::BAND,\n\"\"\")\nopen('events/mod.rs','w').write(s)\nEOF\ncat > run.rs <<'EOF'\n//! The common frame of an event: card, 3-2-1, play, result. One of these runs inside a stay, a\n//! Medley round and attract mode alike.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse super::check::quip_ui;\nuse super::events::{Cx, EventKind, EventState, Intent, RunCommon};\nuse super::ghost::{GFrame, GHOST_HZ};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum RunPhase {\n    #[default]\n    Card,\n    Count,\n    Play,\n    Result,\n}\n\n/// What a finished event gave.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Outcome {\n    pub score: f32,\n    pub stars: u8,\n    pub title: String,\n    pub minutes: u32,\n    pub best: bool,\n    pub prior: Option<u32>,\n    pub comment: String,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct EventRun {\n    pub kind: EventKind,\n    pub st: EventState,\n    pub c: RunCommon,\n    pub phase: RunPhase,\n    pub pt: f32,\n    pub out: Outcome,\n    /// This run, as it is recorded for ghosts.\n    pub rec: Vec<GFrame>,\n    /// Other runs to show in neighbouring lanes.\n    pub ghosts: Vec<Vec<GFrame>>,\n    pub ghost_names: Vec<String>,\n    /// Attract mode: no card, no tips, nothing saved; stops at the time limit.\n    pub demo: bool,\n    pub limit: Option<f32>,\n    /// A Medley round: a short card, no retry.\n    pub medley: bool,\n    pub started: bool,\n    pub count_i: i32,\n}\n\nimpl EventRun {\n    pub fn new(kind: EventKind, day: u8, r: &Rules) -> Self {\n        Self {\n            kind,\n            st: EventState::new(kind, day, r),\n            c: RunCommon::default(),\n            phase: RunPhase::Card,\n            pt: 0.0,\n            out: Outcome::default(),\n            rec: Vec::new(),\n            ghosts: Vec::new(),\n            ghost_names: Vec::new(),\n            demo: false,\n            limit: None,\n            medley: false,\n            started: false,\n            count_i: 4,\n        }\n    }\n\n    /// Sets the stage. Everything the event places, it places here.\n    pub fn begin(&mut self, cx: &mut Cx) {\n        self.c.core = super::core::BalanceCore::new(&mut cx.sim.state.rng);\n        self.st.start(&mut self.c, cx);\n        self.started = true;\n        cx.ev.push(SimEvent::Music { song: self.st.song() });\n        if self.demo {\n            self.phase = RunPhase::Play;\n        }\n    }\n\n    /// One tick. True when the Result is reached (the owner banks it).\n    pub fn tick(&mut self, cx: &mut Cx, it: &Intent) -> bool {\n        let dt = cx.dt;\n        self.pt += dt;\n        if let Some(q) = &mut self.c.quip {\n            q.tick(1, dt, cx.ev);\n            self.c.quip_t -= dt;\n            if self.c.quip_t <= 0.0 {\n                self.c.quip = None;\n            }\n        }\n        match self.phase {\n            RunPhase::Card => {\n                // A short card in a Medley; else it waits for you.\n                if self.medley && self.pt > 2.0 {\n                    self.phase = RunPhase::Count;\n                    self.pt = 0.0;\n                }\n                if !self.medley && it.act_just && self.pt > 0.2 {\n                    self.phase = RunPhase::Count;\n                    self.pt = 0.0;\n                    cx.sfx(sound::UI_CONFIRM, 0.8, 1.0);\n                }\n            }\n            RunPhase::Count => {\n                let n = 3 - self.pt as i32;\n                if n != self.count_i {\n                    self.count_i = n;\n                    cx.sfx(if n > 0 { sound::COUNT } else { sound::GO }, 0.8, 1.0);\n                }\n                if self.pt >= 3.0 {\n                    self.phase = RunPhase::Play;\n                    self.pt = 0.0;\n                }\n            }\n            RunPhase::Play => {\n                self.c.t += dt;\n                // Record the run, five frames a second.\n                let n = (self.c.t * GHOST_HZ) as usize;\n                if n >= self.rec.len() {\n                    self.rec.push(self.frame_of(cx));\n                }\n                self.ghost_dots();\n                if let Some(score) = self.st.tick(&mut self.c, cx, it) {\n                    self.out.score = score;\n                    self.c.score = score;\n                    self.phase = RunPhase::Result;\n                    self.pt = 0.0;\n                    return true;\n                }\n                if self.limit.is_some_and(|l| self.c.t >= l) {\n                    self.phase = RunPhase::Result;\n                    self.pt = 0.0;\n                    return true;\n                }\n            }\n            RunPhase::Result => {}\n        }\n        false\n    }\n\n    fn frame_of(&self, cx: &Cx) -> GFrame {\n        let (feet, facing, clip, clip_t) = match cx.sim.state.entities.get(cx.pid) {\n            Some(e) => {\n                let ch = e.character.as_ref();\n                let h = ch.map(|c| c.height() * 0.5).unwrap_or(0.0);\n                let a = ch.map(|c| c.anim).unwrap_or_default();\n                (e.pos - Vec3::Y * h, a.facing, a.clip, a.clip_t)\n            }\n            None => (Vec3::ZERO, 0.0, 0, 0.0),\n        };\n        GFrame::new(feet, facing, self.c.core.cob, clip, clip_t, self.c.score)\n    }\n\n    fn ghost_dots(&mut self) {\n        let g = self.ghosts.first().and_then(|g| super::ghost::sample(g, self.c.t));\n        self.c.ghost_dot = g.map(|g| g.l);\n        self.c.ghost_score = g.map(|g| g.s);\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        self.st.stop(cx);\n        stop_clip(cx.sim, cx.pid);\n        clear_lean(cx.sim, cx.pid);\n        self.started = false;\n    }\n\n    /// Events where the arrows are steps.\n    pub fn arrows_step(&self) -> bool {\n        self.kind.arrows_step()\n    }\n\n    pub fn hud(&self, r: &Rules, ui: &mut Ui, about: &str) {\n        match self.phase {\n            RunPhase::Card => {\n                let (x, y, w, h) = (360.0, 240.0, 1200.0, 560.0);\n                ui.card(x, y, w, h);\n                ui.title(960.0, y + 40.0, 96.0, INK, Align::Center, self.kind.name());\n                ui.para(960.0, y + 170.0, 1040.0, 42.0, INK_SOFT, Align::Center, about);\n                let coach = self.kind.coach();\n                let line = super::script::line(&format!(\"card.{}\", self.kind.key()), 1);\n                ui.label(960.0, y + 320.0, 36.0, TEAL, Align::Center, coach.name());\n                ui.para(960.0, y + 366.0, 1040.0, 38.0, INK, Align::Center, line);\n                if self.medley {\n                    ui.label(960.0, y + 470.0, 44.0, CORAL, Align::Center, \"Starting soon\");\n                } else {\n                    ui.prompt_row(&[(Act::Confirm, \"Begin\"), (Act::Back, \"Leave\")]);\n                }\n                self.st_controls(ui);\n            }\n            RunPhase::Count => {\n                let n = (3.0 - self.pt).ceil().clamp(1.0, 3.0) as i32;\n                let k = 1.0 - self.pt.fract();\n                ui.circle(960.0, 500.0, 120.0 + 60.0 * k, with_alpha(WHITE, 0.9), TEAL, 10.0);\n                ui.title(960.0, 410.0, 160.0, INK, Align::Center, n.to_string());\n                self.st.hud(&self.c, r, ui);\n            }\n            RunPhase::Play => {\n                self.st.hud(&self.c, r, ui);\n                quip_ui(&self.c, ui);\n            }\n            RunPhase::Result => self.result_ui(r, ui),\n        }\n    }\n\n    fn st_controls(&self, ui: &mut Ui) {\n        // The controls this event uses, as glyphs on the card.\n        let (x, y) = (560.0, 730.0);\n        match self.kind {\n            EventKind::TempoSquats | EventKind::BreathBloom => {\n                ui.prompt(x, y, Act::Confirm, \"Hold\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::Lean, \"Balance\", Align::Left);\n            }\n            EventKind::PlankStandoff => {\n                ui.prompt(x, y, Act::Brace, \"Hold both\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::Lean, \"Balance\", Align::Left);\n            }\n            EventKind::StepParty => {\n                ui.prompt(x, y, Act::StepL, \"Left\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::StepR, \"Right\", Align::Left);\n            }\n            EventKind::FloatieSpin | EventKind::MorningLap => {\n                ui.prompt(x, y, Act::Lean, \"Lean\", Align::Left);\n                ui.prompt(x + 280.0, y, Act::StepL, \"Left\", Align::Left);\n                ui.prompt(x + 530.0, y, Act::StepR, \"Right\", Align::Left);\n            }\n            EventKind::CannonballCup | EventKind::BigStand => {\n                ui.prompt(x, y, Act::Confirm, \"Action\", Align::Left);\n                ui.prompt(x + 400.0, y, Act::Lean, \"Lean\", Align::Left);\n            }\n            _ => {\n                ui.prompt(x + 200.0, y, Act::Lean, \"Lean is all you have\", Align::Left);\n            }\n        }\n    }\n\n    fn result_ui(&self, _r: &Rules, ui: &mut Ui) {\n        let o = &self.out;\n        let (x, y, w, h) = (360.0, 90.0, 1200.0, 760.0);\n        ui.card(x, y, w, h);\n        ui.label(960.0, y + 24.0, 48.0, INK_SOFT, Align::Center, self.kind.name());\n        let roll = (self.pt / 1.1).min(1.0);\n        ui.title(960.0, y + 84.0, 160.0, INK, Align::Center, format!(\"{:.0}\", o.score * roll));\n        let shown = ((self.pt - 1.0) / 0.35).clamp(0.0, 3.0) as u8;\n        ui.stars(960.0, y + 320.0, shown.min(o.stars), 3, 74.0);\n        if self.pt > 1.4 {\n            ui.label(960.0, y + 386.0, 54.0, TEAL, Align::Center, o.title.clone());\n            ui.para(960.0, y + 464.0, 1040.0, 36.0, INK, Align::Center, o.comment.clone());\n        }\n        if self.pt > 1.8 && !self.medley && !self.demo {\n            let mut line = format!(\"{} minutes for the Clam\", o.minutes);\n            if o.best {\n                line.push_str(\". New personal best\");\n            } else if let Some(p) = o.prior {\n                line.push_str(&format!(\". Best so far {p}\"));\n            }\n            ui.text(960.0, y + 590.0, 36.0, INK_SOFT, Align::Center, line);\n            if let Some(g) = self.c.ghost_score {\n                let d = o.score - g;\n                let word = if d >= 0.0 { \"ahead of\" } else { \"behind\" };\n                ui.text(960.0, y + 640.0, 36.0, CORAL, Align::Center, format!(\"{:.0} {word} Yesterday You. I am not comparing you.\", d.abs()));\n            }\n        }\n    }\n}\nEOF\ncat > island.rs <<'EOF'\n//! Tippy Cay itself: what stands where, what you can walk up to, and the walk.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::dialog::Who;\nuse super::world::*;\nuse crate::entity::EntityId;\nuse crate::sim::Sim;\n\n/// A thing on the island you can walk up to.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Spot {\n    #[default]\n    None,\n    /// A pavilion's mat (index into `PAVILIONS`).\n    Mat(u8),\n    Talk(Who),\n    Cabana,\n    Clam,\n    Calendar,\n    Wardrobe,\n    Flip(u8),\n    BigStand,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]\npub struct Interact {\n    pub spot: Spot,\n    pub pos: Vec3,\n    pub id: Option<EntityId>,\n}\n\n/// A pavilion: its name and events.\npub struct Pavilion {\n    pub name: &'static str,\n    pub coach: Who,\n    pub opens: u8,\n    pub events: &'static [super::events::EventKind],\n}\n\nuse super::events::EventKind as K;\npub const PAVILIONS: [Pavilion; 4] = [\n    Pavilion { name: \"Stillness Studio\", coach: Who::Posey, opens: 1, events: &[K::BreathBloom, K::PoseParade] },\n    Pavilion { name: \"Iron Gazebo\", coach: Who::Kettle, opens: 2, events: &[K::TempoSquats, K::PlankStandoff] },\n    Pavilion { name: \"The Boardwalk\", coach: Who::Bounce, opens: 3, events: &[K::StepParty, K::FloatieSpin, K::MorningLap] },\n    Pavilion { name: \"The Lagoon\", coach: Who::Gull, opens: 4, events: &[K::TideTable, K::PaddleSlalom, K::TrayTrek, K::CannonballCup] },\n];\n\n/// Whether a point (set-local, about the stage) is on dry land you may walk on.\npub fn on_land(p: Vec3, stage: Vec3) -> bool {\n    let (x, z) = ((p.x - stage.x) / 29.0, (p.z - stage.z) / 21.0);\n    x.abs().powi(4) + z.abs().powi(4) <= 1.0\n}\n\n/// Everything you can walk up to, from the hub's markers and its people.\npub fn gather(sim: &mut Sim) -> Vec<Interact> {\n    let mut out = Vec::new();\n    let mark = |sim: &mut Sim, name: &str| set_markers(sim, Set::Hub, name).first().copied();\n    for (i, name) in [\"mat_studio\", \"mat_gazebo\", \"mat_boardwalk\", \"mat_lagoon\"].iter().enumerate() {\n        if let Some(pos) = mark(sim, name) {\n            out.push(Interact { spot: Spot::Mat(i as u8), pos, id: None });\n        }\n    }\n    for (spot, name) in [\n        (Spot::Cabana, \"int_cabana\"),\n        (Spot::Clam, \"int_clam\"),\n        (Spot::Calendar, \"int_calendar\"),\n        (Spot::Wardrobe, \"int_wardrobe\"),\n        (Spot::BigStand, \"int_stand\"),\n    ] {\n        if let Some(pos) = mark(sim, name) {\n            out.push(Interact { spot, pos, id: None });\n        }\n    }\n    for (who, name) in [\n        (Who::Pip, \"pip\"),\n        (Who::Posey, \"posey_hub\"),\n        (Who::Kettle, \"kettle_hub\"),\n        (Who::Bounce, \"bounce_hub\"),\n        (Who::Gull, \"gull_hub\"),\n        (Who::Marjorie, \"marjorie\"),\n        (Who::Tom, \"tom\"),\n        (Who::Twins, \"twin_a\"),\n    ] {\n        if let Some(id) = npc(sim, name) {\n            let pos = sim.feet(id).unwrap_or(Vec3::ZERO);\n            out.push(Interact { spot: Spot::Talk(who), pos, id: Some(id) });\n        }\n    }\n    out\n}\n\n/// A step toward `to`, as a move direction.\npub fn steer(from: Vec3, to: Vec3) -> Vec2 {\n    Vec2::new(to.x - from.x, to.z - from.z).normalize_or_zero()\n}\nEOF\ncat > menus.rs <<'EOF'\n//! Menus as data: every list on every screen comes from `FitGame::menu`, so the pad, the keys,\n//! the mouse, the bot and the tests all use one path.\n\nuse super::events::EventKind;\nuse super::ui_model::ItemKind;\n\n/// What an item does.\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum MAct {\n    None,\n    Stay,\n    Together,\n    Settings,\n    About,\n    Slot(u8),\n    Name(u16),\n    Skin,\n    Outfit,\n    Begin,\n    Resume,\n    Schedule,\n    Calendar,\n    Wardrobe,\n    HowTo,\n    Dev,\n    Quit,\n    Pavilion(u8),\n    Event(EventKind),\n    EndDay,\n    Reception,\n    Retry,\n    Done,\n    Music,\n    Sfx,\n    Voice,\n    Glyphs,\n    LeanSens,\n    Assist,\n    Rhythm,\n    TextSpeed,\n    Fullscreen,\n    ResetSave,\n    Yes,\n    No,\n    Wear(u8),\n    PagePrev,\n    PageNext,\n    Close,\n    Players(u8),\n    Go,\n    Ready,\n    DevDay(u8),\n    DevEvent(EventKind),\n    DevPhase(u8),\n    DevAttract,\n    DevMedley,\n    DevFlag(u8),\n    DevGive,\n    DevUnlock,\n    DevAllStars,\n    DevWin,\n    DevLose,\n    DevScale,\n    DevHold,\n    DevStep,\n    DevGroup,\n    DevParam(u16),\n    DevResetGroup,\n    DevResetAll,\n    DevResetGuest,\n}\n\n/// How a menu lays out.\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Layout {\n    /// A column of rows: left edge, top, width, row height; at most `visible` at once.\n    List { x: f32, y: f32, w: f32, row: f32, visible: usize },\n    /// A row of big cards, centred on the screen: top, card width and height.\n    Row { y: f32, w: f32, h: f32 },\n}\n\n#[derive(Clone, Debug)]\npub struct MItem {\n    pub act: MAct,\n    pub label: String,\n    pub sub: String,\n    pub kind: ItemKind,\n    pub stars: Option<u8>,\n}\n\nimpl MItem {\n    pub fn button(act: MAct, label: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Button, stars: None }\n    }\n    pub fn sub(mut self, sub: impl Into<String>) -> Self {\n        self.sub = sub.into();\n        self\n    }\n    pub fn stars(mut self, n: u8) -> Self {\n        self.stars = Some(n);\n        self\n    }\n    pub fn locked(mut self) -> Self {\n        self.kind = ItemKind::Locked;\n        self\n    }\n    pub fn slider(act: MAct, label: impl Into<String>, frac: f32, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Slider { frac, value: value.into() }, stars: None }\n    }\n    pub fn choice(act: MAct, label: impl Into<String>, value: impl Into<String>) -> Self {\n        Self { act, label: label.into(), sub: String::new(), kind: ItemKind::Choice { value: value.into() }, stars: None }\n    }\n}\n\n#[derive(Clone, Debug)]\npub struct Menu {\n    /// A name for tests: `title`, `pause`...\n    pub key: &'static str,\n    pub title: String,\n    pub sub: String,\n    pub items: Vec<MItem>,\n    pub layout: Layout,\n    pub tabs: Option<(Vec<&'static str>, usize)>,\n    pub back: bool,\n    /// Draws a card behind it, and how wide.\n    pub card: bool,\n    pub dim: bool,\n}\nEOF\necho done","description":"Write event run frame, island and menu data modules"}}}
