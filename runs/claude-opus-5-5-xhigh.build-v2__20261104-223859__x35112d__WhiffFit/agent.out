{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGaJBHSPsX4K5rnA8rA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017bz52xSVUrAi26dRM7Jqz5","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/games/fit && cat > rules.rs <<'EOF'\n//! Every balance number, in one table per event. `rules.toml` holds the live values (it is read\n//! from disk when running from `engine/`); the dev mode's Tuning tab is generated from this.\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::params::{ParamVisitor, Tunable, nested};\n\nmacro_rules! group {\n    ($name:ident { $($f:ident : $def:expr, $min:expr, $max:expr, $help:expr;)* }) => {\n        #[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n        #[serde(default, deny_unknown_fields)]\n        pub struct $name { $(pub $f: f32,)* }\n        impl Default for $name {\n            fn default() -> Self { Self { $($f: $def,)* } }\n        }\n        impl Tunable for $name {\n            fn visit(&mut self, v: &mut dyn ParamVisitor) {\n                $(v.float(stringify!($f), &mut self.$f, $min, $max, $help);)*\n            }\n        }\n    };\n}\n\ngroup!(CoreRules {\n    stiffness: 40.0, 5.0, 120.0, \"Spring from the dot to its target\";\n    damping: 8.5, 1.0, 30.0, \"How fast the dot settles\";\n    reach: 0.92, 0.3, 1.5, \"Dot travel at full lean\";\n    tip_time: 0.35, 0.05, 2.0, \"Seconds past the edge before a tip\";\n    wobble: 0.12, 0.0, 0.5, \"Base wobble\";\n    kick: 0.1, 0.0, 1.0, \"Random nudge every second or two\";\n    tilt_deg: 14.0, 0.0, 40.0, \"Figure tilt at full lean (degrees)\";\n});\n\ngroup!(InputRules {\n    deadzone: 0.12, 0.0, 0.5, \"Stick deadzone\";\n    stick_curve: 1.5, 1.0, 3.0, \"Stick response curve\";\n    key_rate: 1.6, 0.2, 8.0, \"Key lean rate (units/s)\";\n    key_return: 1.2, 0.2, 8.0, \"Key lean return rate (units/s)\";\n    mouse_span: 0.38, 0.1, 1.0, \"Cursor offset for full lean (share of window height)\";\n});\n\ngroup!(FlowRules {\n    goal1: 3.0, 0.0, 20.0, \"Day 1 minute goal\";\n    goal2: 5.0, 0.0, 20.0, \"Day 2 minute goal\";\n    goal3: 7.0, 0.0, 20.0, \"Day 3 minute goal\";\n    goal4: 9.0, 0.0, 30.0, \"Day 4 minute goal\";\n    star1: 400.0, 0.0, 1000.0, \"Score for one star\";\n    star2: 650.0, 0.0, 1000.0, \"Score for two stars\";\n    star3: 850.0, 0.0, 1000.0, \"Score for three stars\";\n    checkout_age: 40.0, 18.0, 99.0, \"Balance Age that lets you leave\";\n    attract_idle: 10.0, 2.0, 60.0, \"Seconds idle before attract mode\";\n    attract_segment: 15.0, 3.0, 60.0, \"Seconds of each attract event\";\n    walk_speed: 0.62, 0.2, 1.0, \"Island walk speed (share of top)\";\n});\n\ngroup!(CheckRules {\n    still_time: 8.0, 2.0, 20.0, \"Stand Still seconds\";\n    still_nudge: 3.0, 0.0, 12.0, \"Stand Still's nudge\";\n    still_par: 0.35, 0.05, 1.0, \"Mean distance that scores zero\";\n    target_limit: 5.0, 1.0, 12.0, \"Lean Targets: seconds per target\";\n    target_hold: 1.5, 0.2, 4.0, \"Lean Targets: seconds to hold\";\n    target_within: 0.06, 0.01, 0.3, \"Lean Targets: how close\";\n    blind_time: 6.0, 2.0, 20.0, \"Eyes Closed seconds\";\n    blind_par: 0.5, 0.05, 1.0, \"Eyes Closed mean distance that scores zero\";\n    step_count: 8.0, 2.0, 16.0, \"Step Test steps\";\n    step_bpm: 100.0, 40.0, 180.0, \"Step Test tempo\";\n    step_par: 0.2, 0.02, 0.5, \"Step Test error that scores zero\";\n    weight_still: 0.3, 0.0, 1.0, \"Weight of Stand Still\";\n    weight_targets: 0.25, 0.0, 1.0, \"Weight of Lean Targets\";\n    weight_blind: 0.25, 0.0, 1.0, \"Weight of Eyes Closed\";\n    weight_steps: 0.2, 0.0, 1.0, \"Weight of the Step Test\";\n    age_base: 24.0, 10.0, 60.0, \"Age at perfect skill\";\n    age_range: 56.0, 10.0, 80.0, \"Age added at zero skill\";\n    age_curve: 1.1, 0.5, 2.5, \"Curve of skill to age\";\n    age_per_day: 2.0, 0.0, 6.0, \"Age off per finished day\";\n    age_stars_div: 3.0, 1.0, 10.0, \"Stars per year off\";\n    age_stars_cap: 8.0, 0.0, 20.0, \"Most years off from stars\";\n});\n\ngroup!(BreathRules {\n    cycles: 5.0, 2.0, 8.0, \"Breath cycles\";\n    cycle: 8.0, 3.0, 12.0, \"Seconds per cycle\";\n    last_cycle: 13.0, 4.0, 20.0, \"Seconds of the last cycle\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble\";\n    ring: 0.35, 0.1, 0.8, \"Keep the dot inside this\";\n    tolerance: 0.35, 0.05, 1.0, \"How far the breath may be off\";\n    breath_weight: 0.7, 0.0, 1.0, \"Weight of the breath over the ring\";\n    good_cycle: 0.6, 0.1, 1.0, \"Average that opens a lotus\";\n    par: 0.88, 0.3, 1.0, \"Share of a perfect run that scores 1000\";\n});\n\ngroup!(PoseRules {\n    count: 3.0, 1.0, 6.0, \"Poses\";\n    length: 20.0, 5.0, 40.0, \"Seconds per pose\";\n    drift_hz: 0.12, 0.02, 0.5, \"How fast the ring drifts\";\n    drift: 0.35, 0.0, 0.8, \"How far the ring drifts\";\n    ring_start: 0.3, 0.05, 0.8, \"Ring radius at the start of a pose\";\n    ring_end: 0.18, 0.05, 0.8, \"Ring radius at the end of a pose\";\n    wobble: 1.0, 0.0, 3.0, \"Wobble\";\n    gull_at: 12.0, 0.0, 40.0, \"Seconds into pose 2 the gull lands\";\n    gull_time: 5.0, 0.0, 20.0, \"Seconds the gull stays\";\n    gull_wobble: 1.6, 1.0, 4.0, \"Wobble under a gull\";\n    broken: 1.5, 0.0, 5.0, \"Seconds a tip breaks the pose\";\n    streak_step: 2.0, 0.5, 6.0, \"Seconds per multiplier step\";\n    par: 0.9, 0.3, 1.0, \"Share of a perfect run that scores 1000\";\n});\n\ngroup!(SquatRules {\n    reps: 10.0, 3.0, 20.0, \"Reps\";\n    down: 2.0, 0.5, 5.0, \"Seconds to full depth\";\n    up: 1.0, 0.3, 4.0, \"Seconds to rise\";\n    rest: 2.0, 0.2, 5.0, \"Seconds between reps\";\n    wobble: 0.9, 0.0, 3.0, \"Wobble\";\n    wobble_per_rep: 0.08, 0.0, 0.5, \"Extra wobble per rep\";\n    band: 0.25, 0.05, 0.8, \"Band half width\";\n    tolerance: 0.45, 0.05, 1.0, \"How far the depth may be off\";\n    timing_weight: 0.7, 0.0, 1.0, \"Weight of timing over balance\";\n    par: 0.95, 0.3, 1.0, \"Share of a perfect run that scores 1000\";\n});\n\ngroup!(PlankRules {\n    length: 60.0, 10.0, 120.0, \"Longest plank (s)\";\n    ring_start: 0.4, 0.1, 1.0, \"Ring at the start\";\n    ring_end: 0.2, 0.05, 0.8, \"Ring at the end\";\n    wobble: 0.9, 0.0, 3.0, \"Wobble\";\n    fatigue: 1.0, 0.0, 4.0, \"Extra wobble by the end\";\n    tremble_at: 30.0, 0.0, 60.0, \"Seconds to the tremble\";\n    tremble: 2.0, 0.0, 12.0, \"Tremble strength\";\n    laugh_at: 45.0, 0.0, 60.0, \"Seconds to Kettle's joke\";\n    laugh_nudge: 40.0, 0.0, 200.0, \"What the joke does to the dot\";\n    out_time: 1.0, 0.1, 4.0, \"Seconds outside before the flop\";\n});\n\ngroup!(StepRules {\n    perfect_window: 0.055, 0.01, 0.2, \"Perfect window (s)\";\n    good_window: 0.12, 0.03, 0.4, \"Good window (s)\";\n    good_value: 0.6, 0.0, 1.0, \"What a Good is worth\";\n});\n\ngroup!(SpinRules {\n    length: 50.0, 10.0, 120.0, \"Seconds\";\n    ring_h: 0.95, 0.4, 1.4, \"Ring height on the hips\";\n    band_lo: 6.0, 1.0, 12.0, \"Sweet band low (rad/s)\";\n    band_hi: 9.0, 2.0, 20.0, \"Sweet band high (rad/s)\";\n    spin_band_scale: 1.25, 1.0, 3.0, \"Widens the band (keyboard's friend)\";\n    min_lean: 0.4, 0.0, 0.9, \"Lean that counts as circling\";\n    smoothing: 7.0, 1.0, 30.0, \"Smoothing of the spin speed\";\n    switch_every: 15.0, 3.0, 40.0, \"Seconds between switches\";\n    max_rings: 7.0, 1.0, 12.0, \"Most rings\";\n    toss_every: 5.0, 1.0, 20.0, \"Seconds between tosses\";\n    toss_flight: 1.2, 0.3, 4.0, \"Seconds a toss flies\";\n    catch_window: 0.25, 0.05, 1.0, \"Catch window (s)\";\n    rise: 0.6, 0.0, 3.0, \"How fast rings climb in band\";\n    sink: 0.28, 0.0, 3.0, \"How fast rings sink out of band\";\n    par: 170.0, 20.0, 400.0, \"Ring-seconds that score 1000\";\n});\n\ngroup!(LapRules {\n    path_rx: 22.0, 8.0, 30.0, \"Path half width\";\n    path_rz: 15.0, 8.0, 22.0, \"Path half depth\";\n    path_power: 3.0, 2.0, 8.0, \"Path squareness\";\n    things: 26.0, 4.0, 60.0, \"Ribbons and hazards on the lap\";\n    zone_lo: 1.6, 0.5, 3.0, \"Pace zone low (steps/s)\";\n    zone_hi: 2.4, 1.0, 5.0, \"Pace zone high (steps/s)\";\n    stride: 0.72, 0.2, 2.0, \"Metres per step\";\n    step_timeout: 0.8, 0.2, 3.0, \"Seconds with no step before you slow\";\n    pace_decay: 1.4, 0.1, 6.0, \"How fast the pace falls\";\n    stitch_rise: 0.4, 0.0, 3.0, \"Stitch per second over the zone\";\n    stitch_fall: 0.2, 0.0, 3.0, \"Stitch relief per second\";\n    stumble: 1.5, 0.0, 5.0, \"Seconds a stitch stumbles you\";\n    side_reach: 1.2, 0.0, 3.0, \"Metres of sideways dodge\";\n    side_rate: 4.0, 0.5, 20.0, \"How fast the dodge responds\";\n    pacer_speed: 1.5, 0.0, 6.0, \"Bounce's speed\";\n    pacer_lead: 12.0, 1.0, 40.0, \"Lead before Bounce waits\";\n    pacer_max_gap: 30.0, 2.0, 80.0, \"Most Bounce gets away\";\n    zone_weight: 0.6, 0.0, 1.0, \"Weight of the zone over ribbons\";\n    bump_cost: 0.04, 0.0, 0.3, \"Score lost per bump\";\n    max_time: 130.0, 20.0, 300.0, \"Seconds before the lap gives up on you\";\n});\n\ngroup!(TideRules {\n    length: 60.0, 10.0, 180.0, \"Seconds for all three boards\";\n    half: 4.0, 2.0, 8.0, \"Half the raft's width\";\n    pool_r: 0.72, 0.2, 2.0, \"Pool radius\";\n    tilt_deg: 8.0, 0.0, 30.0, \"Raft tilt at full lean (degrees)\";\n    gravity: 12.0, 1.0, 40.0, \"Shell acceleration at full tilt\";\n    friction: 0.8, 0.0, 4.0, \"Shell friction\";\n    wall_bounce: 0.5, 0.0, 1.0, \"Bounce off the raft's rim\";\n    bumper_r: 0.7, 0.1, 2.0, \"Bumper radius\";\n    skip_speed: 5.0, 0.5, 20.0, \"Speed at which shells skip over pools\";\n    tide_rise: 0.03, 0.0, 0.3, \"How fast the tide takes the rim (m/s)\";\n    wobble: 0.5, 0.0, 3.0, \"Wobble\";\n    per_shell: 60.0, 5.0, 100.0, \"Score per shell\";\n    shell_cap: 900.0, 100.0, 1000.0, \"Most score from shells\";\n    time_worth: 400.0, 0.0, 1000.0, \"Score for all the time left\";\n});\n\ngroup!(PaddleRules {\n    length: 200.0, 40.0, 400.0, \"Channel length (m)\";\n    gates: 14.0, 2.0, 40.0, \"Gates\";\n    gate_x: 5.0, 0.0, 9.0, \"How far gates wander\";\n    gate_width: 4.0, 1.0, 10.0, \"Gate width\";\n    half_width: 9.0, 3.0, 20.0, \"Half the channel\";\n    base_speed: 2.2, 0.0, 8.0, \"Speed with no lean\";\n    fwd_speed: 5.0, 0.0, 16.0, \"Speed from leaning forward\";\n    brake: 3.0, 0.0, 10.0, \"Braking from leaning back\";\n    accel: 1.2, 0.1, 8.0, \"How fast the speed responds\";\n    steer: 9.0, 1.0, 24.0, \"Sideways speed at full lean\";\n    gust: 40.0, 0.0, 120.0, \"Gust strength\";\n    gust_every: 6.0, 1.0, 30.0, \"Seconds between gusts\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble\";\n    remount: 2.0, 0.2, 6.0, \"Seconds to remount\";\n    miss_penalty: 2.0, 0.0, 10.0, \"Seconds a missed gate adds\";\n    par: 45.0, 10.0, 120.0, \"Par time\";\n    max_time: 110.0, 20.0, 300.0, \"Seconds before the channel gives up on you\";\n});\n\ngroup!(TrayRules {\n    length: 100.0, 20.0, 240.0, \"Pier length (m)\";\n    pace: 2.0, 0.5, 5.0, \"Walking pace\";\n    jolts: 16.0, 2.0, 40.0, \"Jolts on the way\";\n    jolt_nudge: 55.0, 0.0, 200.0, \"A jolt's push on the dot\";\n    jolt_kick: 0.16, 0.0, 1.0, \"A jolt's kick to the glasses\";\n    warning: 0.8, 0.0, 3.0, \"Seconds of warning\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble\";\n    tilt_deg: 16.0, 0.0, 40.0, \"Tray tilt at full lean (degrees)\";\n    slide: 1.0, 0.0, 6.0, \"How glasses slide with tilt\";\n    friction: 1.1, 0.0, 6.0, \"Glass friction\";\n    edge: 0.55, 0.2, 1.2, \"Tray edge\";\n    per_glass: 180.0, 50.0, 300.0, \"Score per glass delivered\";\n    bonus: 100.0, 0.0, 500.0, \"No-spill bonus\";\n});\n\ngroup!(DiveRules {\n    tower: 6.0, 1.0, 16.0, \"Board height (m)\";\n    period: 1.2, 0.5, 3.0, \"Bounce period (s)\";\n    bounce_amp: 0.28, 0.05, 1.0, \"Bounce height\";\n    press_window: 0.3, 0.05, 0.6, \"Press window around the bottom (s)\";\n    leap_base: 4.0, 1.0, 12.0, \"Leap speed with no power\";\n    leap_power: 7.0, 0.0, 20.0, \"Leap speed from power\";\n    forward: 2.4, 0.5, 8.0, \"Forward speed\";\n    gravity: 11.0, 2.0, 30.0, \"Gravity in the air\";\n    tuck_rate: 12.0, 1.0, 40.0, \"How fast you tuck\";\n    spin_lean: 2.0, 0.0, 10.0, \"Rotation from lean\";\n    spin_tuck: 5.0, 0.0, 16.0, \"Rotation from tucking\";\n    height_par: 9.0, 2.0, 24.0, \"Height for a full score\";\n    flop_tuck: 0.35, 0.0, 1.0, \"What an untucked entry is worth\";\n    par: 0.82, 0.3, 1.0, \"Share of a perfect dive that scores 1000\";\n    board_timeout: 9.0, 2.0, 30.0, \"Seconds before the board does it for you\";\n    splash_time: 3.4, 0.5, 8.0, \"Seconds for the splash and the cards\";\n});\n\ngroup!(StandRules {\n    breath_cycles: 4.0, 1.0, 8.0, \"Breathing cycles\";\n    breath_gust: 4.0, 0.0, 40.0, \"Gusts while breathing\";\n    pose_len: 20.0, 5.0, 40.0, \"Pose seconds\";\n    gust: 26.0, 0.0, 120.0, \"Big Stand gusts\";\n    bars: 16.0, 2.0, 16.0, \"Band bars\";\n    band_wobble: 0.7, 0.0, 3.0, \"Wobble with the band\";\n    plank_len: 20.0, 5.0, 60.0, \"Brace seconds\";\n    wave_nudge: 30.0, 0.0, 200.0, \"What a wave does to the dot\";\n    stillness: 30.0, 5.0, 60.0, \"The Long Stillness (s)\";\n    fake_prompt_at: 15.0, 1.0, 60.0, \"Seconds to the fake prompt\";\n    peace_bonus: 250.0, 0.0, 500.0, \"Inner Peace bonus\";\n    tip_cost: 40.0, 0.0, 200.0, \"Score lost per tip\";\n});\n\n/// Every number.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default, deny_unknown_fields)]\npub struct Rules {\n    pub core: CoreRules,\n    pub input: InputRules,\n    pub flow: FlowRules,\n    pub check: CheckRules,\n    pub breath: BreathRules,\n    pub pose: PoseRules,\n    pub squats: SquatRules,\n    pub plank: PlankRules,\n    pub step: StepRules,\n    pub spin: SpinRules,\n    pub lap: LapRules,\n    pub tide: TideRules,\n    pub paddle: PaddleRules,\n    pub tray: TrayRules,\n    pub dive: DiveRules,\n    pub stand: StandRules,\n}\n\nimpl Tunable for Rules {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        nested(v, \"core\", &mut self.core);\n        nested(v, \"input\", &mut self.input);\n        nested(v, \"flow\", &mut self.flow);\n        nested(v, \"check\", &mut self.check);\n        nested(v, \"breath\", &mut self.breath);\n        nested(v, \"pose\", &mut self.pose);\n        nested(v, \"squats\", &mut self.squats);\n        nested(v, \"plank\", &mut self.plank);\n        nested(v, \"step\", &mut self.step);\n        nested(v, \"spin\", &mut self.spin);\n        nested(v, \"lap\", &mut self.lap);\n        nested(v, \"tide\", &mut self.tide);\n        nested(v, \"paddle\", &mut self.paddle);\n        nested(v, \"tray\", &mut self.tray);\n        nested(v, \"dive\", &mut self.dive);\n        nested(v, \"stand\", &mut self.stand);\n    }\n}\n\nimpl Rules {\n    /// The rules as the file has them.\n    pub fn load() -> anyhow::Result<Rules> {\n        let text = super::super::level_text(\"fit/rules\", include_str!(\"rules.toml\"));\n        toml::from_str(&text).map_err(|e| anyhow::anyhow!(\"rules.toml: {e}\"))\n    }\n    pub fn stars(&self, score: f32) -> u8 {\n        (score >= self.flow.star1) as u8 + (score >= self.flow.star2) as u8 + (score >= self.flow.star3) as u8\n    }\n    pub fn goal(&self, day: u8) -> u32 {\n        (match day {\n            1 => self.flow.goal1,\n            2 => self.flow.goal2,\n            3 => self.flow.goal3,\n            4 => self.flow.goal4,\n            _ => 0.0,\n        }) as u32\n    }\n}\nEOF\npython3 - <<'EOF'\nimport re\nsrc=open('rules.rs').read()\nout=[\"# Every balance number. Running from engine/, this file is read at each load, so a change here needs no rebuild.\\n# The dev mode's Tuning tab changes these live; Reset to Defaults goes back to this file.\\n\"]\nfor m in re.finditer(r'group!\\((\\w+) \\{(.*?)\\}\\);', src, re.S):\n    name=m.group(1)\n    sec={'CoreRules':'core','InputRules':'input','FlowRules':'flow','CheckRules':'check','BreathRules':'breath','PoseRules':'pose','SquatRules':'squats','PlankRules':'plank','StepRules':'step','SpinRules':'spin','LapRules':'lap','TideRules':'tide','PaddleRules':'paddle','TrayRules':'tray','DiveRules':'dive','StandRules':'stand'}[name]\n    out.append(f\"\\n[{sec}]\\n\")\n    for l in m.group(2).strip().splitlines():\n        lm=re.match(r'\\s*(\\w+): ([-\\d.]+), [-\\d.]+, [-\\d.]+, \"(.*)\";',l)\n        out.append(f\"{lm.group(1)} = {lm.group(2)}   # {lm.group(3)}\\n\")\nopen('rules.toml','w').write(''.join(out))\nEOF\ncat > check.rs <<'EOF'\n//! The Morning Wobble Check: four micro-tests, Pip presiding. Then the Balance Age.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::events::{Cx, Intent, RunCommon, ready_player};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse super::dialog::Who;\nuse crate::entity::EntityId;\n\npub const TESTS: [(&str, &str); 4] = [\n    (\"Stand Still\", \"This is the whole test.\"),\n    (\"Lean Targets\", \"Reach the mark. Hold it. Politely.\"),\n    (\"Eyes Closed\", \"The screen goes dark. Listen to the tone. Lower is left.\"),\n    (\"Step Test\", \"Eight steps, in time, left and right.\"),\n];\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum CheckPhase {\n    #[default]\n    Card,\n    Run,\n    Done,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Check {\n    pub c: RunCommon,\n    pub test: usize,\n    pub phase: CheckPhase,\n    pub pt: f32,\n    pub metrics: [f32; 4],\n    pub dist_sum: f32,\n    pub dist_n: f32,\n    pub nudged: bool,\n    pub target_i: usize,\n    pub targets: [f32; 3],\n    pub target_t: f32,\n    pub hold_t: f32,\n    pub times: f32,\n    pub step_i: u32,\n    pub step_err: f32,\n    pub step_foot: u8,\n    pub tone_in: f32,\n    pub beat_i: i32,\n    pub pip: Option<EntityId>,\n    pub rumble: f32,\n    pub flash: f32,\n}\n\nimpl Check {\n    pub fn new(cx: &mut Cx) -> Self {\n        let rng = &mut cx.sim.state.rng;\n        let side = if rng.f32() < 0.5 { -1.0 } else { 1.0 };\n        let targets = [side * 0.7, -side * 0.5, side * rng.range(0.2, 0.6)];\n        let c = RunCommon { core: super::core::BalanceCore::new(rng), ..Default::default() };\n        let mut me = Self { c, targets, ..Default::default() };\n        let at = cx.stage(Set::Studio);\n        ready_player(cx, Set::Studio, at + Vec3::Y * 0.55, 0.0);\n        super::events::mirror_cam(cx.sim);\n        me.pip = npc(cx.sim, \"pip_check\");\n        if let Some(p) = me.pip {\n            place(cx.sim, p, at, 0.0);\n        }\n        me\n    }\n\n    fn begin_run(&mut self) {\n        self.phase = CheckPhase::Run;\n        self.pt = 0.0;\n        self.dist_sum = 0.0;\n        self.dist_n = 0.0;\n        self.c.core.settle();\n    }\n\n    fn end_test(&mut self, metric: f32, cx: &mut Cx) {\n        self.metrics[self.test] = clamp01(metric);\n        cx.sfx(sound::TICK, 0.7, 1.0);\n        self.test += 1;\n        self.pt = 0.0;\n        self.phase = if self.test >= 4 { CheckPhase::Done } else { CheckPhase::Card };\n    }\n\n    /// One tick; true when all four tests are done.\n    pub fn tick(&mut self, cx: &mut Cx, it: &Intent) -> bool {\n        let r = &cx.rules.check;\n        let dt = cx.dt;\n        self.pt += dt;\n        self.c.t += dt;\n        self.rumble = 0.0;\n        match self.phase {\n            CheckPhase::Done => return self.pt > 0.8,\n            CheckPhase::Card => {\n                let c = &mut self.c;\n                c.step(cx, it.lean, 0.8, Vec2::ZERO, Vec2::ZERO);\n                if it.act_just || self.pt > 3.0 {\n                    self.begin_run();\n                    cx.sfx(sound::GONG, 0.4, 1.3);\n                }\n                if self.pt < dt * 1.5 {\n                    c_say(&mut self.c, self.test);\n                }\n            }\n            CheckPhase::Run => match self.test {\n                0 => {\n                    let mut nudge = Vec2::ZERO;\n                    if !self.nudged && self.pt >= 5.0 {\n                        self.nudged = true;\n                        nudge = Vec2::new(cx.sim.state.rng.range(-1.0, 1.0), 0.5).normalize_or(Vec2::X) * r.still_nudge * 10.0;\n                        cx.sfx(sound::PIP_SQUEAK, 0.8, 1.0);\n                    }\n                    self.c.step(cx, it.lean, 0.9, Vec2::ZERO, nudge);\n                    self.dist_sum += self.c.core.cob.length();\n                    self.dist_n += 1.0;\n                    if self.pt >= r.still_time {\n                        let m = 1.0 - (self.dist_sum / self.dist_n.max(1.0)) / r.still_par;\n                        self.end_test(m, cx);\n                    }\n                }\n                1 => {\n                    self.c.step(cx, it.lean, 0.7, Vec2::ZERO, Vec2::ZERO);\n                    let target = self.targets[self.target_i];\n                    self.target_t += dt;\n                    if (self.c.core.cob.x - target).abs() <= r.target_within {\n                        self.hold_t += dt;\n                    } else {\n                        self.hold_t = 0.0;\n                    }\n                    if self.hold_t >= r.target_hold || self.target_t >= r.target_limit {\n                        let done = self.hold_t >= r.target_hold;\n                        self.times += if done { self.target_t } else { r.target_limit * 1.5 };\n                        cx.sfx(if done { sound::STAR } else { sound::MISS }, 0.6, 1.0);\n                        self.target_i += 1;\n                        self.target_t = 0.0;\n                        self.hold_t = 0.0;\n                        if self.target_i >= 3 {\n                            let m = 1.0 - (self.times / 3.0 - r.target_hold) / (r.target_limit - r.target_hold);\n                            self.end_test(m, cx);\n                        }\n                    }\n                }\n                2 => {\n                    self.c.step(cx, it.lean, 0.9, Vec2::ZERO, Vec2::ZERO);\n                    let cob = self.c.core.cob;\n                    self.dist_sum += cob.length();\n                    self.dist_n += 1.0;\n                    self.rumble = clamp01(cob.length() * 0.8);\n                    self.tone_in -= dt;\n                    if self.tone_in <= 0.0 {\n                        self.tone_in = 0.13;\n                        cx.sfx(sound::TONE, 0.55, 1.0 + cob.x * 0.7);\n                    }\n                    if self.pt >= r.blind_time {\n                        let m = 1.0 - (self.dist_sum / self.dist_n.max(1.0)) / r.blind_par;\n                        self.end_test(m, cx);\n                    }\n                }\n                _ => {\n                    self.c.step(cx, it.lean, 0.5, Vec2::ZERO, Vec2::ZERO);\n                    let beat = 60.0 / r.step_bpm;\n                    let lead = beat * 4.0;\n                    let n = ((self.pt - lead + beat * 4.0) / beat).floor() as i32;\n                    if n != self.beat_i {\n                        self.beat_i = n;\n                        cx.sfx(sound::TICK, if n % 4 == 0 { 0.8 } else { 0.5 }, if n % 4 == 0 { 1.3 } else { 1.0 });\n                    }\n                    let press = if it.l_just && it.r_just {\n                        None\n                    } else if it.l_just {\n                        Some(0)\n                    } else if it.r_just {\n                        Some(1)\n                    } else {\n                        None\n                    };\n                    if let Some(f) = press {\n                        if self.pt > lead - beat * 0.5 && (self.step_i as f32) < r.step_count {\n                            let want = lead + self.step_i as f32 * beat;\n                            let off = (self.pt - want).abs();\n                            // The other foot, please: the same foot twice costs.\n                            let wrong = self.step_i > 0 && f == self.step_foot;\n                            self.step_err += off.min(r.step_par) + if wrong { r.step_par * 0.5 } else { 0.0 };\n                            self.step_i += 1;\n                            self.step_foot = f;\n                            self.flash = 0.2;\n                            cx.sfx(sound::STEP, 0.6, 1.0);\n                            gesture(cx.sim, cx.pid, if f == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" }, false);\n                        }\n                    }\n                    let end = lead + (r.step_count + 1.0) * beat;\n                    if self.pt >= end {\n                        let missed = r.step_count - self.step_i as f32;\n                        let err = (self.step_err + missed.max(0.0) * r.step_par) / r.step_count;\n                        let m = 1.0 - err / r.step_par;\n                        self.end_test(m, cx);\n                    }\n                }\n            },\n        }\n        self.flash = (self.flash - dt).max(0.0);\n        // Pip squashes and the figure rides on top.\n        let cob = self.c.core.cob;\n        lean_figure(cx.sim, cx.pid, cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        if let Some(p) = self.pip {\n            lean_figure(cx.sim, p, cob * 0.5, 0.0, 10.0, 0.0);\n        }\n        false\n    }\n\n    pub fn skill(&self, r: &Rules) -> f32 {\n        let c = &r.check;\n        c.weight_still * self.metrics[0] + c.weight_targets * self.metrics[1] + c.weight_blind * self.metrics[2] + c.weight_steps * self.metrics[3]\n    }\n\n    /// The worst of the four tests.\n    pub fn worst(&self) -> usize {\n        let mut w = 0;\n        for i in 1..4 {\n            if self.metrics[i] < self.metrics[w] {\n                w = i;\n            }\n        }\n        w\n    }\n\n    pub fn hud(&self, r: &Rules, ui: &mut Ui) {\n        let (name, how) = TESTS[self.test.min(3)];\n        match self.phase {\n            CheckPhase::Card => {\n                ui.card(460.0, 120.0, 1000.0, 200.0);\n                ui.title(960.0, 140.0, 72.0, INK, Align::Center, name);\n                ui.text(960.0, 240.0, 40.0, INK_SOFT, Align::Center, how);\n                ui.prompt_row(&[(Act::Confirm, \"Begin\")]);\n            }\n            CheckPhase::Done => {}\n            CheckPhase::Run => {\n                let mut p = self.c.puck(true);\n                match self.test {\n                    0 => {\n                        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n                        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n                        ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"{:.0} s left\", (r.check.still_time - self.pt).ceil().max(0.0)));\n                        p.ring = Some([0.0, 0.0, 0.2]);\n                        p.good = self.c.core.cob.length() < 0.2;\n                        ui.puck(p);\n                        ui.prompt_row(&[(Act::Lean, \"Stay in the middle\")]);\n                    }\n                    1 => {\n                        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n                        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n                        ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"Target {} of 3\", self.target_i.min(2) + 1));\n                        // A left/right bar.\n                        let (x, y, w, h) = (360.0, 170.0, 1200.0, 110.0);\n                        ui.panel(x - 20.0, y - 20.0, w + 40.0, h + 40.0, with_alpha(WHITE, 0.94), 36.0);\n                        let t = self.targets[self.target_i.min(2)];\n                        let at = |v: f32| x + w * (v + 1.0) * 0.5;\n                        let tol = r.check.target_within * w * 0.5;\n                        ui.panel(at(t) - tol, y, tol * 2.0, h, MINT, 16.0);\n                        ui.circle(at(self.c.core.cob.x.clamp(-1.0, 1.0)), y + h * 0.5, 44.0, CORAL, WHITE, 6.0);\n                        let side = if t < 0.0 { \"left\" } else { \"right\" };\n                        ui.label(960.0, 310.0, 54.0, INK, Align::Center, format!(\"{:.0}% {side}\", t.abs() * 100.0));\n                        ui.bar(760.0, 390.0, 400.0, 26.0, clamp01(self.hold_t / r.check.target_hold), TEAL);\n                        ui.prompt_row(&[(Act::Lean, \"Lean to the mark and hold\")]);\n                    }\n                    2 => {\n                        ui.fade([6, 12, 20, 240]);\n                        ui.text(960.0, 480.0, 44.0, [120, 140, 160, 255], Align::Center, \"Listen.\");\n                    }\n                    _ => {\n                        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n                        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n                        ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"Step {} of {}\", self.step_i, r.check.step_count as u32));\n                        let beat = 60.0 / r.check.step_bpm;\n                        let u = (self.pt / beat).fract();\n                        ui.circle(960.0, 205.0, 80.0 + 60.0 * (1.0 - u), with_alpha(TEAL, 0.25 + 0.5 * (1.0 - u)), TEAL, 8.0);\n                        let lead = beat * 4.0;\n                        let word = if self.pt < lead { \"Wait for it\".to_string() } else { \"Step\".to_string() };\n                        ui.label(960.0, 180.0, 50.0, INK, Align::Center, word);\n                        ui.prompt_row(&[(Act::StepL, \"Left\"), (Act::StepR, \"Right\")]);\n                    }\n                }\n            }\n        }\n        quip_ui(&self.c, ui);\n    }\n\n    pub fn bot(&self, r: &Rules) -> Intent {\n        let mut it = Intent::default();\n        match self.phase {\n            CheckPhase::Card => {\n                it.act_just = self.pt > 1.0;\n                it.act = it.act_just;\n            }\n            CheckPhase::Done => {}\n            CheckPhase::Run => match self.test {\n                1 => {\n                    let t = self.targets[self.target_i.min(2)];\n                    let lean = t / r.core.reach + (t - self.c.core.cob.x) * 0.7;\n                    it.lean = Vec2::new(lean.clamp(-1.0, 1.0), -self.c.core.cob.y * 0.5);\n                }\n                3 => {\n                    let beat = 60.0 / r.check.step_bpm;\n                    let lead = beat * 4.0;\n                    let want = lead + self.step_i as f32 * beat;\n                    if (self.step_i as f32) < r.check.step_count && self.pt + 1.0 / 60.0 >= want {\n                        if self.step_i % 2 == 0 {\n                            it.l_just = true;\n                        } else {\n                            it.r_just = true;\n                        }\n                    }\n                }\n                _ => {\n                    it.lean = (-self.c.core.cob * 1.2 - self.c.core.vel * 0.1).clamp_length_max(1.0);\n                }\n            },\n        }\n        it\n    }\n}\n\nfn c_say(c: &mut RunCommon, test: usize) {\n    c.say_key(Who::Pip, \"pip.check_test\", test);\n}\n\n/// A coach's line in a small card.\npub fn quip_ui(c: &RunCommon, ui: &mut Ui) {\n    if let Some(q) = &c.quip {\n        let text: String = q.text().chars().take(q.shown as usize).collect();\n        if text.is_empty() {\n            return;\n        }\n        let (x, y, w, h) = (360.0, 846.0, 1200.0, 120.0);\n        ui.card_c(x, y, w, h, with_alpha(WHITE, 0.96));\n        ui.label(x + 30.0, y + 8.0, 34.0, TEAL, Align::Left, q.who.name());\n        ui.text(x + 30.0, y + 58.0, 36.0, INK, Align::Left, text);\n    }\n}\nEOF\ncat > finale.rs <<'EOF'\n//! The Big Stand: five phases on a tiny post at sunset, reusing the events with new numbers.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::dialog::Who;\nuse super::events::{breath::BreathBloom, plank::PlankStandoff, pose::PoseParade, step::StepParty, Cx, EventState, Intent, RunCommon};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse crate::frame::SimEvent;\n\n/// The phase names, for the card between them.\npub const PHASES: [&str; 5] = [\"Breathing\", \"A Pose, in Weather\", \"Band of Guests\", \"Brace\", \"The Long Stillness\"];\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct BigStand {\n    pub phase: usize,\n    pub sub: Option<Box<EventState>>,\n    pub scores: Vec<f32>,\n    pub t0: f32,\n    pub card: f32,\n    pub fall: f32,\n    pub tips: u32,\n    pub peace: bool,\n    pub still_t: f32,\n    pub spoke: bool,\n    pub ending: f32,\n    pub post: Vec3,\n    pub crowd: Vec<crate::entity::EntityId>,\n    pub seed_phase: Option<usize>,\n    pub final_score: f32,\n}\n\nimpl BigStand {\n    /// `phase`: jump straight to a phase (dev mode, attract).\n    pub fn new(phase: usize) -> Self {\n        Self { phase, peace: true, card: 2.4, ..Default::default() }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        self.post = cx.stage(Set::Bay) + Vec3::Y * 1.4;\n        show_set(cx.sim, Set::Bay);\n        place(cx.sim, cx.pid, self.post, 0.0);\n        stop_clip(cx.sim, cx.pid);\n        cam_full(cx.sim, 10.0, 0.0, 9.0, 38.0, 0.9, 0.12, None);\n        self.crowd = cx.sim.state.entities.iter().filter(|e| e.name.starts_with(\"crowd\")).map(|e| e.id).collect();\n        cx.ev.push(SimEvent::Music { song: song::BAND });\n        c.say_key(Who::Pip, \"pip.stand_phase\", self.phase);\n    }\n\n    fn make_phase(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let r = &cx.rules.stand;\n        let mut st = match self.phase {\n            0 => {\n                let mut b = BreathBloom::new(r.breath_cycles as usize);\n                b.finale = true;\n                b.gust = r.breath_gust;\n                EventState::Breath(b)\n            }\n            1 => {\n                let mut p = PoseParade::new(cx.day + 2, 1, r.pose_len);\n                p.finale = true;\n                p.with_gull = false;\n                p.gust = r.gust;\n                EventState::Pose(p)\n            }\n            2 => EventState::Step(StepParty::new(Some(r.bars as usize))),\n            _ => EventState::Plank(PlankStandoff::new(r.plank_len, true)),\n        };\n        self.t0 = c.t;\n        st.start(c, cx);\n        place(cx.sim, cx.pid, self.post, 0.0);\n        self.sub = Some(Box::new(st));\n        c.score = 0.0;\n    }\n\n    /// One tick; `Some(score)` at the very end.\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let dt = cx.dt;\n        let rules = cx.rules;\n        if self.ending > 0.0 {\n            self.ending -= dt;\n            return (self.ending <= 0.0).then_some(self.final_score);\n        }\n        if self.fall > 0.0 {\n            // In the sea, and back on the post.\n            self.fall -= dt;\n            let u = self.fall / 1.6;\n            let drop = if u > 0.5 { (1.0 - u) * 2.0 } else { u * 2.0 };\n            place(cx.sim, cx.pid, self.post - Vec3::Y * drop * 2.2 + Vec3::new(1.2 * drop, 0.0, 0.0), 0.0);\n            if self.fall <= 0.0 {\n                c.core.settle();\n                place(cx.sim, cx.pid, self.post, 0.0);\n            }\n            return None;\n        }\n        if self.card > 0.0 {\n            self.card -= dt;\n            c.step(cx, it.lean, 0.5, Vec2::ZERO, Vec2::ZERO);\n            lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, rules.core.tilt_deg, cx.slump);\n            if self.card <= 0.0 && self.phase < 4 {\n                self.make_phase(c, cx);\n            } else if self.card <= 0.0 {\n                self.t0 = c.t;\n                cx.ev.push(SimEvent::Music { song: song::NONE });\n                c.quip = None;\n            }\n            return None;\n        }\n        if self.phase < 4 {\n            let saved = c.t;\n            c.t -= self.t0;\n            let mut sub = self.sub.take();\n            let done = sub.as_mut().and_then(|s| s.tick(c, cx, it));\n            self.sub = sub;\n            c.t = saved;\n            if c.core.tipped {\n                self.tips += 1;\n                self.fall = 1.6;\n                cx.ev.push(SimEvent::BigSplash { pos: self.post - Vec3::Y * 1.2, size: 0.9 });\n                cx.sfx(sound::GROAN, 0.9, 1.0);\n                cx.sfx(sound::SPLASH_B, 0.8, 1.0);\n                c.say_key(Who::Pip, \"pip.stand_tip\", self.tips as usize);\n            }\n            if let Some(s) = done {\n                if let Some(mut st) = self.sub.take() {\n                    st.stop(cx);\n                }\n                self.scores.push(s);\n                self.phase += 1;\n                self.card = 2.4;\n                c.core.settle();\n                for i in 0..self.crowd.len() {\n                    gesture(cx.sim, self.crowd[i], \"MESH2MOTION/Cheering_Two_Hands\", true);\n                }\n                cx.sfx(sound::CLAP, 0.6, 1.0);\n                c.say_key(Who::Pip, \"pip.stand_phase\", self.phase);\n                place(cx.sim, cx.pid, self.post, 0.0);\n                stop_clip(cx.sim, cx.pid);\n            }\n            return None;\n        }\n        // The Long Stillness: nothing happens, and the game tries to make you press something.\n        self.still_t += dt;\n        c.step(cx, it.lean, 0.35, Vec2::ZERO, Vec2::ZERO);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, rules.core.tilt_deg, cx.slump);\n        if self.peace && (it.any || it.act_just || it.l_just || it.r_just) {\n            self.peace = false;\n            cx.sfx(sound::GROAN, 0.5, 1.2);\n        }\n        if self.still_t >= rules.stand.stillness && !self.spoke {\n            self.spoke = true;\n            let n = self.scores.len().max(1) as f32;\n            let avg = self.scores.iter().sum::<f32>() / n;\n            let bonus = if self.peace { rules.stand.peace_bonus } else { 0.0 };\n            self.final_score = (avg * (1000.0 - rules.stand.peace_bonus) / 1000.0 + bonus - self.tips as f32 * rules.stand.tip_cost).clamp(0.0, 1000.0);\n            c.score = self.final_score;\n            c.say_key(Who::Pip, \"pip.stand_end\", self.peace as usize);\n            self.ending = 4.0;\n            cx.sfx(sound::FANFARE, 0.8, 1.0);\n            cx.sfx(sound::CONFETTI, 0.8, 1.0);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(mut st) = self.sub.take() {\n            st.stop(cx);\n        }\n    }\n\n    pub fn stillness(&self) -> bool {\n        self.phase >= 4 && self.card <= 0.0 && self.ending <= 0.0\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        if self.card > 0.0 && self.phase < 5 {\n            ui.card(560.0, 90.0, 800.0, 170.0);\n            ui.text(960.0, 104.0, 36.0, INK_SOFT, Align::Center, format!(\"Phase {} of 5\", self.phase + 1));\n            ui.label(960.0, 158.0, 62.0, INK, Align::Center, PHASES[self.phase.min(4)]);\n            return;\n        }\n        if self.phase < 4 {\n            if let Some(s) = &self.sub {\n                s.hud(c, r, ui);\n            }\n            return;\n        }\n        if self.ending > 0.0 {\n            return;\n        }\n        // Stillness: the HUD vanishes, except the Puck.\n        ui.puck(c.puck(true));\n        if self.still_t >= r.stand.fake_prompt_at && self.still_t < r.stand.fake_prompt_at + 6.0 {\n            ui.prompt_row(&[(Act::Confirm, \"Press to skip\")]);\n        }\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        if self.card > 0.0 || self.fall > 0.0 {\n            return Intent::default();\n        }\n        if self.phase < 4 {\n            if let Some(s) = &self.sub {\n                let mut sc = c.clone();\n                sc.t = c.t - self.t0;\n                return s.bot(&sc, r);\n            }\n        }\n        Intent::default()\n    }\n}\nEOF\ncd events && python3 - <<'EOF'\nimport re\ns=open('breath.rs').read()\ns=s.replace(\"\"\"    /// Finale: no lotus field of its own, no HUD ring wobble of its own.\n    pub ents: Vec<EntityId>,\"\"\",\"\"\"    pub ents: Vec<EntityId>,\n    /// In the Big Stand: stays on the post, no pond of its own.\n    pub finale: bool,\"\"\")\ns=s.replace(\"\"\"        self.total = (0..self.cycles).map(|i| self.cycle_len(i, cx.rules)).sum();\n\"\"\",\"\"\"        self.total = (0..self.cycles).map(|i| self.cycle_len(i, cx.rules)).sum();\n        if self.finale {\n            return;\n        }\n\"\"\")\ns=s.replace(\"\"\"        c.top_bar(ui, \"Breath Bloom\", Some(self.total - c.t));\"\"\",\"\"\"        if !self.finale {\n            c.top_bar(ui, \"Breath Bloom\", Some(self.total - c.t));\n        }\"\"\")\nopen('breath.rs','w').write(s)\ns=open('pose.rs').read()\ns=s.replace(\"\"\"    pub was_mult: u8,\n}\"\"\",\"\"\"    pub was_mult: u8,\n    /// In the Big Stand: stays on the post.\n    pub finale: bool,\n}\"\"\")\ns=s.replace(\"\"\"    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Studio);\"\"\",\"\"\"    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        if self.finale {\n            return;\n        }\n        let at = cx.stage(Set::Studio);\"\"\")\ns=s.replace(\"\"\"        c.top_bar(ui, \"Pose Parade\", Some(self.len - self.pt + (self.poses.len() - 1 - self.i) as f32 * self.len));\"\"\",\"\"\"        if !self.finale {\n            c.top_bar(ui, \"Pose Parade\", Some(self.len - self.pt + (self.poses.len() - 1 - self.i) as f32 * self.len));\n        }\"\"\")\ns=s.replace(\"\"\"        ui.panel(560.0, 400.0, 800.0, 0.0, WHITE, 0.0);\n\"\"\",\"\")\nopen('pose.rs','w').write(s)\ns=open('plank.rs').read()\ns=s.replace(\"\"\"        c.top_bar(ui, \"Plank Standoff\", Some(self.len - self.held));\"\"\",\"\"\"        if !self.waves {\n            c.top_bar(ui, \"Plank Standoff\", Some(self.len - self.held));\n        }\"\"\")\nopen('plank.rs','w').write(s)\nEOF\ncat > ../charts.toml <<'EOF'\n# Step Party notes, one line per bar of eighths: L left, R right, B both, . nothing.\n# 96 BPM. Starts with quarter notes and builds to eighths and doubles.\nbpm = 96.0\nlead_in_beats = 8.0\n\nparty = [\n  \"L...R...L...R...\",\n  \"L...R...L...R...\",\n  \"L...L...R...R...\",\n  \"L...R...L...R...\",\n  \"L.R.L...R.L.R...\",\n  \"L...R.L.R...L.R.\",\n  \"L.R.L.R.L...R...\",\n  \"L.R.L.R.B.......\",\n  \"L...B...R...B...\",\n  \"L.R.B...R.L.B...\",\n  \"L.R.L.R.L.R.L.R.\",\n  \"R.L.R.L.R.L.R.L.\",\n  \"L.L.R.R.L.L.R.R.\",\n  \"B...L.R.B...R.L.\",\n  \"L.R.L.R.B...B...\",\n  \"L.R.L.R.L.R.B...\",\n  \"B.L.R.L.B.R.L.R.\",\n  \"L.R.B...L.R.B...\",\n  \"L.L.R.R.B...B...\",\n  \"B.......B.......\",\n]\n\nfinale = [\n  \"L...R...L...R...\",\n  \"L...R...L...R...\",\n  \"L...L...R...R...\",\n  \"L.R.L...R.L.R...\",\n  \"L...B...R...B...\",\n  \"L.R.L.R.L.R.L.R.\",\n  \"B...L.R.B...R.L.\",\n  \"L.R.B...L.R.B...\",\n  \"L...R...L...R...\",\n  \"L.R.L...R.L.R...\",\n  \"L...B...R...B...\",\n  \"L.R.L.R.L.R.B...\",\n  \"L.R.L.R.L.R.L.R.\",\n  \"B.L.R.L.B.R.L.R.\",\n  \"L.L.R.R.B...B...\",\n  \"B.......B.......\",\n]\nEOF\npython3 - <<'EOF'\nimport re\ns=open('../charts.toml').read()\nn=sum(len(re.findall(r'[LRB]',l)) for l in s.split('party = [')[1].split('finale')[0].splitlines())\nprint('party notes',n)\nEOF\n","description":"Write rules, morning check, finale, charts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":33506,"cache_read_input_tokens":365333,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":33506},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"95aa24d3-cdef-455d-9b18-a0fd1124b2ce","timestamp":"2026-11-05T06:02:36.096Z","request_id":"req_011CgjGaHuAy1bbFKo2WWfXg","wire_tool_inputs":{"toolu_017bz52xSVUrAi26dRM7Jqz5":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine/crates/pav_core/src/games/fit && cat > rules.rs <<'EOF'\n//! Every balance number, in one table per event. `rules.toml` holds the live values (it is read\n//! from disk when running from `engine/`); the dev mode's Tuning tab is generated from this.\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::params::{ParamVisitor, Tunable, nested};\n\nmacro_rules! group {\n    ($name:ident { $($f:ident : $def:expr, $min:expr, $max:expr, $help:expr;)* }) => {\n        #[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n        #[serde(default, deny_unknown_fields)]\n        pub struct $name { $(pub $f: f32,)* }\n        impl Default for $name {\n            fn default() -> Self { Self { $($f: $def,)* } }\n        }\n        impl Tunable for $name {\n            fn visit(&mut self, v: &mut dyn ParamVisitor) {\n                $(v.float(stringify!($f), &mut self.$f, $min, $max, $help);)*\n            }\n        }\n    };\n}\n\ngroup!(CoreRules {\n    stiffness: 40.0, 5.0, 120.0, \"Spring from the dot to its target\";\n    damping: 8.5, 1.0, 30.0, \"How fast the dot settles\";\n    reach: 0.92, 0.3, 1.5, \"Dot travel at full lean\";\n    tip_time: 0.35, 0.05, 2.0, \"Seconds past the edge before a tip\";\n    wobble: 0.12, 0.0, 0.5, \"Base wobble\";\n    kick: 0.1, 0.0, 1.0, \"Random nudge every second or two\";\n    tilt_deg: 14.0, 0.0, 40.0, \"Figure tilt at full lean (degrees)\";\n});\n\ngroup!(InputRules {\n    deadzone: 0.12, 0.0, 0.5, \"Stick deadzone\";\n    stick_curve: 1.5, 1.0, 3.0, \"Stick response curve\";\n    key_rate: 1.6, 0.2, 8.0, \"Key lean rate (units/s)\";\n    key_return: 1.2, 0.2, 8.0, \"Key lean return rate (units/s)\";\n    mouse_span: 0.38, 0.1, 1.0, \"Cursor offset for full lean (share of window height)\";\n});\n\ngroup!(FlowRules {\n    goal1: 3.0, 0.0, 20.0, \"Day 1 minute goal\";\n    goal2: 5.0, 0.0, 20.0, \"Day 2 minute goal\";\n    goal3: 7.0, 0.0, 20.0, \"Day 3 minute goal\";\n    goal4: 9.0, 0.0, 30.0, \"Day 4 minute goal\";\n    star1: 400.0, 0.0, 1000.0, \"Score for one star\";\n    star2: 650.0, 0.0, 1000.0, \"Score for two stars\";\n    star3: 850.0, 0.0, 1000.0, \"Score for three stars\";\n    checkout_age: 40.0, 18.0, 99.0, \"Balance Age that lets you leave\";\n    attract_idle: 10.0, 2.0, 60.0, \"Seconds idle before attract mode\";\n    attract_segment: 15.0, 3.0, 60.0, \"Seconds of each attract event\";\n    walk_speed: 0.62, 0.2, 1.0, \"Island walk speed (share of top)\";\n});\n\ngroup!(CheckRules {\n    still_time: 8.0, 2.0, 20.0, \"Stand Still seconds\";\n    still_nudge: 3.0, 0.0, 12.0, \"Stand Still's nudge\";\n    still_par: 0.35, 0.05, 1.0, \"Mean distance that scores zero\";\n    target_limit: 5.0, 1.0, 12.0, \"Lean Targets: seconds per target\";\n    target_hold: 1.5, 0.2, 4.0, \"Lean Targets: seconds to hold\";\n    target_within: 0.06, 0.01, 0.3, \"Lean Targets: how close\";\n    blind_time: 6.0, 2.0, 20.0, \"Eyes Closed seconds\";\n    blind_par: 0.5, 0.05, 1.0, \"Eyes Closed mean distance that scores zero\";\n    step_count: 8.0, 2.0, 16.0, \"Step Test steps\";\n    step_bpm: 100.0, 40.0, 180.0, \"Step Test tempo\";\n    step_par: 0.2, 0.02, 0.5, \"Step Test error that scores zero\";\n    weight_still: 0.3, 0.0, 1.0, \"Weight of Stand Still\";\n    weight_targets: 0.25, 0.0, 1.0, \"Weight of Lean Targets\";\n    weight_blind: 0.25, 0.0, 1.0, \"Weight of Eyes Closed\";\n    weight_steps: 0.2, 0.0, 1.0, \"Weight of the Step Test\";\n    age_base: 24.0, 10.0, 60.0, \"Age at perfect skill\";\n    age_range: 56.0, 10.0, 80.0, \"Age added at zero skill\";\n    age_curve: 1.1, 0.5, 2.5, \"Curve of skill to age\";\n    age_per_day: 2.0, 0.0, 6.0, \"Age off per finished day\";\n    age_stars_div: 3.0, 1.0, 10.0, \"Stars per year off\";\n    age_stars_cap: 8.0, 0.0, 20.0, \"Most years off from stars\";\n});\n\ngroup!(BreathRules {\n    cycles: 5.0, 2.0, 8.0, \"Breath cycles\";\n    cycle: 8.0, 3.0, 12.0, \"Seconds per cycle\";\n    last_cycle: 13.0, 4.0, 20.0, \"Seconds of the last cycle\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble\";\n    ring: 0.35, 0.1, 0.8, \"Keep the dot inside this\";\n    tolerance: 0.35, 0.05, 1.0, \"How far the breath may be off\";\n    breath_weight: 0.7, 0.0, 1.0, \"Weight of the breath over the ring\";\n    good_cycle: 0.6, 0.1, 1.0, \"Average that opens a lotus\";\n    par: 0.88, 0.3, 1.0, \"Share of a perfect run that scores 1000\";\n});\n\ngroup!(PoseRules {\n    count: 3.0, 1.0, 6.0, \"Poses\";\n    length: 20.0, 5.0, 40.0, \"Seconds per pose\";\n    drift_hz: 0.12, 0.02, 0.5, \"How fast the ring drifts\";\n    drift: 0.35, 0.0, 0.8, \"How far the ring drifts\";\n    ring_start: 0.3, 0.05, 0.8, \"Ring radius at the start of a pose\";\n    ring_end: 0.18, 0.05, 0.8, \"Ring radius at the end of a pose\";\n    wobble: 1.0, 0.0, 3.0, \"Wobble\";\n    gull_at: 12.0, 0.0, 40.0, \"Seconds into pose 2 the gull lands\";\n    gull_time: 5.0, 0.0, 20.0, \"Seconds the gull stays\";\n    gull_wobble: 1.6, 1.0, 4.0, \"Wobble under a gull\";\n    broken: 1.5, 0.0, 5.0, \"Seconds a tip breaks the pose\";\n    streak_step: 2.0, 0.5, 6.0, \"Seconds per multiplier step\";\n    par: 0.9, 0.3, 1.0, \"Share of a perfect run that scores 1000\";\n});\n\ngroup!(SquatRules {\n    reps: 10.0, 3.0, 20.0, \"Reps\";\n    down: 2.0, 0.5, 5.0, \"Seconds to full depth\";\n    up: 1.0, 0.3, 4.0, \"Seconds to rise\";\n    rest: 2.0, 0.2, 5.0, \"Seconds between reps\";\n    wobble: 0.9, 0.0, 3.0, \"Wobble\";\n    wobble_per_rep: 0.08, 0.0, 0.5, \"Extra wobble per rep\";\n    band: 0.25, 0.05, 0.8, \"Band half width\";\n    tolerance: 0.45, 0.05, 1.0, \"How far the depth may be off\";\n    timing_weight: 0.7, 0.0, 1.0, \"Weight of timing over balance\";\n    par: 0.95, 0.3, 1.0, \"Share of a perfect run that scores 1000\";\n});\n\ngroup!(PlankRules {\n    length: 60.0, 10.0, 120.0, \"Longest plank (s)\";\n    ring_start: 0.4, 0.1, 1.0, \"Ring at the start\";\n    ring_end: 0.2, 0.05, 0.8, \"Ring at the end\";\n    wobble: 0.9, 0.0, 3.0, \"Wobble\";\n    fatigue: 1.0, 0.0, 4.0, \"Extra wobble by the end\";\n    tremble_at: 30.0, 0.0, 60.0, \"Seconds to the tremble\";\n    tremble: 2.0, 0.0, 12.0, \"Tremble strength\";\n    laugh_at: 45.0, 0.0, 60.0, \"Seconds to Kettle's joke\";\n    laugh_nudge: 40.0, 0.0, 200.0, \"What the joke does to the dot\";\n    out_time: 1.0, 0.1, 4.0, \"Seconds outside before the flop\";\n});\n\ngroup!(StepRules {\n    perfect_window: 0.055, 0.01, 0.2, \"Perfect window (s)\";\n    good_window: 0.12, 0.03, 0.4, \"Good window (s)\";\n    good_value: 0.6, 0.0, 1.0, \"What a Good is worth\";\n});\n\ngroup!(SpinRules {\n    length: 50.0, 10.0, 120.0, \"Seconds\";\n    ring_h: 0.95, 0.4, 1.4, \"Ring height on the hips\";\n    band_lo: 6.0, 1.0, 12.0, \"Sweet band low (rad/s)\";\n    band_hi: 9.0, 2.0, 20.0, \"Sweet band high (rad/s)\";\n    spin_band_scale: 1.25, 1.0, 3.0, \"Widens the band (keyboard's friend)\";\n    min_lean: 0.4, 0.0, 0.9, \"Lean that counts as circling\";\n    smoothing: 7.0, 1.0, 30.0, \"Smoothing of the spin speed\";\n    switch_every: 15.0, 3.0, 40.0, \"Seconds between switches\";\n    max_rings: 7.0, 1.0, 12.0, \"Most rings\";\n    toss_every: 5.0, 1.0, 20.0, \"Seconds between tosses\";\n    toss_flight: 1.2, 0.3, 4.0, \"Seconds a toss flies\";\n    catch_window: 0.25, 0.05, 1.0, \"Catch window (s)\";\n    rise: 0.6, 0.0, 3.0, \"How fast rings climb in band\";\n    sink: 0.28, 0.0, 3.0, \"How fast rings sink out of band\";\n    par: 170.0, 20.0, 400.0, \"Ring-seconds that score 1000\";\n});\n\ngroup!(LapRules {\n    path_rx: 22.0, 8.0, 30.0, \"Path half width\";\n    path_rz: 15.0, 8.0, 22.0, \"Path half depth\";\n    path_power: 3.0, 2.0, 8.0, \"Path squareness\";\n    things: 26.0, 4.0, 60.0, \"Ribbons and hazards on the lap\";\n    zone_lo: 1.6, 0.5, 3.0, \"Pace zone low (steps/s)\";\n    zone_hi: 2.4, 1.0, 5.0, \"Pace zone high (steps/s)\";\n    stride: 0.72, 0.2, 2.0, \"Metres per step\";\n    step_timeout: 0.8, 0.2, 3.0, \"Seconds with no step before you slow\";\n    pace_decay: 1.4, 0.1, 6.0, \"How fast the pace falls\";\n    stitch_rise: 0.4, 0.0, 3.0, \"Stitch per second over the zone\";\n    stitch_fall: 0.2, 0.0, 3.0, \"Stitch relief per second\";\n    stumble: 1.5, 0.0, 5.0, \"Seconds a stitch stumbles you\";\n    side_reach: 1.2, 0.0, 3.0, \"Metres of sideways dodge\";\n    side_rate: 4.0, 0.5, 20.0, \"How fast the dodge responds\";\n    pacer_speed: 1.5, 0.0, 6.0, \"Bounce's speed\";\n    pacer_lead: 12.0, 1.0, 40.0, \"Lead before Bounce waits\";\n    pacer_max_gap: 30.0, 2.0, 80.0, \"Most Bounce gets away\";\n    zone_weight: 0.6, 0.0, 1.0, \"Weight of the zone over ribbons\";\n    bump_cost: 0.04, 0.0, 0.3, \"Score lost per bump\";\n    max_time: 130.0, 20.0, 300.0, \"Seconds before the lap gives up on you\";\n});\n\ngroup!(TideRules {\n    length: 60.0, 10.0, 180.0, \"Seconds for all three boards\";\n    half: 4.0, 2.0, 8.0, \"Half the raft's width\";\n    pool_r: 0.72, 0.2, 2.0, \"Pool radius\";\n    tilt_deg: 8.0, 0.0, 30.0, \"Raft tilt at full lean (degrees)\";\n    gravity: 12.0, 1.0, 40.0, \"Shell acceleration at full tilt\";\n    friction: 0.8, 0.0, 4.0, \"Shell friction\";\n    wall_bounce: 0.5, 0.0, 1.0, \"Bounce off the raft's rim\";\n    bumper_r: 0.7, 0.1, 2.0, \"Bumper radius\";\n    skip_speed: 5.0, 0.5, 20.0, \"Speed at which shells skip over pools\";\n    tide_rise: 0.03, 0.0, 0.3, \"How fast the tide takes the rim (m/s)\";\n    wobble: 0.5, 0.0, 3.0, \"Wobble\";\n    per_shell: 60.0, 5.0, 100.0, \"Score per shell\";\n    shell_cap: 900.0, 100.0, 1000.0, \"Most score from shells\";\n    time_worth: 400.0, 0.0, 1000.0, \"Score for all the time left\";\n});\n\ngroup!(PaddleRules {\n    length: 200.0, 40.0, 400.0, \"Channel length (m)\";\n    gates: 14.0, 2.0, 40.0, \"Gates\";\n    gate_x: 5.0, 0.0, 9.0, \"How far gates wander\";\n    gate_width: 4.0, 1.0, 10.0, \"Gate width\";\n    half_width: 9.0, 3.0, 20.0, \"Half the channel\";\n    base_speed: 2.2, 0.0, 8.0, \"Speed with no lean\";\n    fwd_speed: 5.0, 0.0, 16.0, \"Speed from leaning forward\";\n    brake: 3.0, 0.0, 10.0, \"Braking from leaning back\";\n    accel: 1.2, 0.1, 8.0, \"How fast the speed responds\";\n    steer: 9.0, 1.0, 24.0, \"Sideways speed at full lean\";\n    gust: 40.0, 0.0, 120.0, \"Gust strength\";\n    gust_every: 6.0, 1.0, 30.0, \"Seconds between gusts\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble\";\n    remount: 2.0, 0.2, 6.0, \"Seconds to remount\";\n    miss_penalty: 2.0, 0.0, 10.0, \"Seconds a missed gate adds\";\n    par: 45.0, 10.0, 120.0, \"Par time\";\n    max_time: 110.0, 20.0, 300.0, \"Seconds before the channel gives up on you\";\n});\n\ngroup!(TrayRules {\n    length: 100.0, 20.0, 240.0, \"Pier length (m)\";\n    pace: 2.0, 0.5, 5.0, \"Walking pace\";\n    jolts: 16.0, 2.0, 40.0, \"Jolts on the way\";\n    jolt_nudge: 55.0, 0.0, 200.0, \"A jolt's push on the dot\";\n    jolt_kick: 0.16, 0.0, 1.0, \"A jolt's kick to the glasses\";\n    warning: 0.8, 0.0, 3.0, \"Seconds of warning\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble\";\n    tilt_deg: 16.0, 0.0, 40.0, \"Tray tilt at full lean (degrees)\";\n    slide: 1.0, 0.0, 6.0, \"How glasses slide with tilt\";\n    friction: 1.1, 0.0, 6.0, \"Glass friction\";\n    edge: 0.55, 0.2, 1.2, \"Tray edge\";\n    per_glass: 180.0, 50.0, 300.0, \"Score per glass delivered\";\n    bonus: 100.0, 0.0, 500.0, \"No-spill bonus\";\n});\n\ngroup!(DiveRules {\n    tower: 6.0, 1.0, 16.0, \"Board height (m)\";\n    period: 1.2, 0.5, 3.0, \"Bounce period (s)\";\n    bounce_amp: 0.28, 0.05, 1.0, \"Bounce height\";\n    press_window: 0.3, 0.05, 0.6, \"Press window around the bottom (s)\";\n    leap_base: 4.0, 1.0, 12.0, \"Leap speed with no power\";\n    leap_power: 7.0, 0.0, 20.0, \"Leap speed from power\";\n    forward: 2.4, 0.5, 8.0, \"Forward speed\";\n    gravity: 11.0, 2.0, 30.0, \"Gravity in the air\";\n    tuck_rate: 12.0, 1.0, 40.0, \"How fast you tuck\";\n    spin_lean: 2.0, 0.0, 10.0, \"Rotation from lean\";\n    spin_tuck: 5.0, 0.0, 16.0, \"Rotation from tucking\";\n    height_par: 9.0, 2.0, 24.0, \"Height for a full score\";\n    flop_tuck: 0.35, 0.0, 1.0, \"What an untucked entry is worth\";\n    par: 0.82, 0.3, 1.0, \"Share of a perfect dive that scores 1000\";\n    board_timeout: 9.0, 2.0, 30.0, \"Seconds before the board does it for you\";\n    splash_time: 3.4, 0.5, 8.0, \"Seconds for the splash and the cards\";\n});\n\ngroup!(StandRules {\n    breath_cycles: 4.0, 1.0, 8.0, \"Breathing cycles\";\n    breath_gust: 4.0, 0.0, 40.0, \"Gusts while breathing\";\n    pose_len: 20.0, 5.0, 40.0, \"Pose seconds\";\n    gust: 26.0, 0.0, 120.0, \"Big Stand gusts\";\n    bars: 16.0, 2.0, 16.0, \"Band bars\";\n    band_wobble: 0.7, 0.0, 3.0, \"Wobble with the band\";\n    plank_len: 20.0, 5.0, 60.0, \"Brace seconds\";\n    wave_nudge: 30.0, 0.0, 200.0, \"What a wave does to the dot\";\n    stillness: 30.0, 5.0, 60.0, \"The Long Stillness (s)\";\n    fake_prompt_at: 15.0, 1.0, 60.0, \"Seconds to the fake prompt\";\n    peace_bonus: 250.0, 0.0, 500.0, \"Inner Peace bonus\";\n    tip_cost: 40.0, 0.0, 200.0, \"Score lost per tip\";\n});\n\n/// Every number.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default, deny_unknown_fields)]\npub struct Rules {\n    pub core: CoreRules,\n    pub input: InputRules,\n    pub flow: FlowRules,\n    pub check: CheckRules,\n    pub breath: BreathRules,\n    pub pose: PoseRules,\n    pub squats: SquatRules,\n    pub plank: PlankRules,\n    pub step: StepRules,\n    pub spin: SpinRules,\n    pub lap: LapRules,\n    pub tide: TideRules,\n    pub paddle: PaddleRules,\n    pub tray: TrayRules,\n    pub dive: DiveRules,\n    pub stand: StandRules,\n}\n\nimpl Tunable for Rules {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        nested(v, \"core\", &mut self.core);\n        nested(v, \"input\", &mut self.input);\n        nested(v, \"flow\", &mut self.flow);\n        nested(v, \"check\", &mut self.check);\n        nested(v, \"breath\", &mut self.breath);\n        nested(v, \"pose\", &mut self.pose);\n        nested(v, \"squats\", &mut self.squats);\n        nested(v, \"plank\", &mut self.plank);\n        nested(v, \"step\", &mut self.step);\n        nested(v, \"spin\", &mut self.spin);\n        nested(v, \"lap\", &mut self.lap);\n        nested(v, \"tide\", &mut self.tide);\n        nested(v, \"paddle\", &mut self.paddle);\n        nested(v, \"tray\", &mut self.tray);\n        nested(v, \"dive\", &mut self.dive);\n        nested(v, \"stand\", &mut self.stand);\n    }\n}\n\nimpl Rules {\n    /// The rules as the file has them.\n    pub fn load() -> anyhow::Result<Rules> {\n        let text = super::super::level_text(\"fit/rules\", include_str!(\"rules.toml\"));\n        toml::from_str(&text).map_err(|e| anyhow::anyhow!(\"rules.toml: {e}\"))\n    }\n    pub fn stars(&self, score: f32) -> u8 {\n        (score >= self.flow.star1) as u8 + (score >= self.flow.star2) as u8 + (score >= self.flow.star3) as u8\n    }\n    pub fn goal(&self, day: u8) -> u32 {\n        (match day {\n            1 => self.flow.goal1,\n            2 => self.flow.goal2,\n            3 => self.flow.goal3,\n            4 => self.flow.goal4,\n            _ => 0.0,\n        }) as u32\n    }\n}\nEOF\npython3 - <<'EOF'\nimport re\nsrc=open('rules.rs').read()\nout=[\"# Every balance number. Running from engine/, this file is read at each load, so a change here needs no rebuild.\\n# The dev mode's Tuning tab changes these live; Reset to Defaults goes back to this file.\\n\"]\nfor m in re.finditer(r'group!\\((\\w+) \\{(.*?)\\}\\);', src, re.S):\n    name=m.group(1)\n    sec={'CoreRules':'core','InputRules':'input','FlowRules':'flow','CheckRules':'check','BreathRules':'breath','PoseRules':'pose','SquatRules':'squats','PlankRules':'plank','StepRules':'step','SpinRules':'spin','LapRules':'lap','TideRules':'tide','PaddleRules':'paddle','TrayRules':'tray','DiveRules':'dive','StandRules':'stand'}[name]\n    out.append(f\"\\n[{sec}]\\n\")\n    for l in m.group(2).strip().splitlines():\n        lm=re.match(r'\\s*(\\w+): ([-\\d.]+), [-\\d.]+, [-\\d.]+, \"(.*)\";',l)\n        out.append(f\"{lm.group(1)} = {lm.group(2)}   # {lm.group(3)}\\n\")\nopen('rules.toml','w').write(''.join(out))\nEOF\ncat > check.rs <<'EOF'\n//! The Morning Wobble Check: four micro-tests, Pip presiding. Then the Balance Age.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::events::{Cx, Intent, RunCommon, ready_player};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse super::dialog::Who;\nuse crate::entity::EntityId;\n\npub const TESTS: [(&str, &str); 4] = [\n    (\"Stand Still\", \"This is the whole test.\"),\n    (\"Lean Targets\", \"Reach the mark. Hold it. Politely.\"),\n    (\"Eyes Closed\", \"The screen goes dark. Listen to the tone. Lower is left.\"),\n    (\"Step Test\", \"Eight steps, in time, left and right.\"),\n];\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum CheckPhase {\n    #[default]\n    Card,\n    Run,\n    Done,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Check {\n    pub c: RunCommon,\n    pub test: usize,\n    pub phase: CheckPhase,\n    pub pt: f32,\n    pub metrics: [f32; 4],\n    pub dist_sum: f32,\n    pub dist_n: f32,\n    pub nudged: bool,\n    pub target_i: usize,\n    pub targets: [f32; 3],\n    pub target_t: f32,\n    pub hold_t: f32,\n    pub times: f32,\n    pub step_i: u32,\n    pub step_err: f32,\n    pub step_foot: u8,\n    pub tone_in: f32,\n    pub beat_i: i32,\n    pub pip: Option<EntityId>,\n    pub rumble: f32,\n    pub flash: f32,\n}\n\nimpl Check {\n    pub fn new(cx: &mut Cx) -> Self {\n        let rng = &mut cx.sim.state.rng;\n        let side = if rng.f32() < 0.5 { -1.0 } else { 1.0 };\n        let targets = [side * 0.7, -side * 0.5, side * rng.range(0.2, 0.6)];\n        let c = RunCommon { core: super::core::BalanceCore::new(rng), ..Default::default() };\n        let mut me = Self { c, targets, ..Default::default() };\n        let at = cx.stage(Set::Studio);\n        ready_player(cx, Set::Studio, at + Vec3::Y * 0.55, 0.0);\n        super::events::mirror_cam(cx.sim);\n        me.pip = npc(cx.sim, \"pip_check\");\n        if let Some(p) = me.pip {\n            place(cx.sim, p, at, 0.0);\n        }\n        me\n    }\n\n    fn begin_run(&mut self) {\n        self.phase = CheckPhase::Run;\n        self.pt = 0.0;\n        self.dist_sum = 0.0;\n        self.dist_n = 0.0;\n        self.c.core.settle();\n    }\n\n    fn end_test(&mut self, metric: f32, cx: &mut Cx) {\n        self.metrics[self.test] = clamp01(metric);\n        cx.sfx(sound::TICK, 0.7, 1.0);\n        self.test += 1;\n        self.pt = 0.0;\n        self.phase = if self.test >= 4 { CheckPhase::Done } else { CheckPhase::Card };\n    }\n\n    /// One tick; true when all four tests are done.\n    pub fn tick(&mut self, cx: &mut Cx, it: &Intent) -> bool {\n        let r = &cx.rules.check;\n        let dt = cx.dt;\n        self.pt += dt;\n        self.c.t += dt;\n        self.rumble = 0.0;\n        match self.phase {\n            CheckPhase::Done => return self.pt > 0.8,\n            CheckPhase::Card => {\n                let c = &mut self.c;\n                c.step(cx, it.lean, 0.8, Vec2::ZERO, Vec2::ZERO);\n                if it.act_just || self.pt > 3.0 {\n                    self.begin_run();\n                    cx.sfx(sound::GONG, 0.4, 1.3);\n                }\n                if self.pt < dt * 1.5 {\n                    c_say(&mut self.c, self.test);\n                }\n            }\n            CheckPhase::Run => match self.test {\n                0 => {\n                    let mut nudge = Vec2::ZERO;\n                    if !self.nudged && self.pt >= 5.0 {\n                        self.nudged = true;\n                        nudge = Vec2::new(cx.sim.state.rng.range(-1.0, 1.0), 0.5).normalize_or(Vec2::X) * r.still_nudge * 10.0;\n                        cx.sfx(sound::PIP_SQUEAK, 0.8, 1.0);\n                    }\n                    self.c.step(cx, it.lean, 0.9, Vec2::ZERO, nudge);\n                    self.dist_sum += self.c.core.cob.length();\n                    self.dist_n += 1.0;\n                    if self.pt >= r.still_time {\n                        let m = 1.0 - (self.dist_sum / self.dist_n.max(1.0)) / r.still_par;\n                        self.end_test(m, cx);\n                    }\n                }\n                1 => {\n                    self.c.step(cx, it.lean, 0.7, Vec2::ZERO, Vec2::ZERO);\n                    let target = self.targets[self.target_i];\n                    self.target_t += dt;\n                    if (self.c.core.cob.x - target).abs() <= r.target_within {\n                        self.hold_t += dt;\n                    } else {\n                        self.hold_t = 0.0;\n                    }\n                    if self.hold_t >= r.target_hold || self.target_t >= r.target_limit {\n                        let done = self.hold_t >= r.target_hold;\n                        self.times += if done { self.target_t } else { r.target_limit * 1.5 };\n                        cx.sfx(if done { sound::STAR } else { sound::MISS }, 0.6, 1.0);\n                        self.target_i += 1;\n                        self.target_t = 0.0;\n                        self.hold_t = 0.0;\n                        if self.target_i >= 3 {\n                            let m = 1.0 - (self.times / 3.0 - r.target_hold) / (r.target_limit - r.target_hold);\n                            self.end_test(m, cx);\n                        }\n                    }\n                }\n                2 => {\n                    self.c.step(cx, it.lean, 0.9, Vec2::ZERO, Vec2::ZERO);\n                    let cob = self.c.core.cob;\n                    self.dist_sum += cob.length();\n                    self.dist_n += 1.0;\n                    self.rumble = clamp01(cob.length() * 0.8);\n                    self.tone_in -= dt;\n                    if self.tone_in <= 0.0 {\n                        self.tone_in = 0.13;\n                        cx.sfx(sound::TONE, 0.55, 1.0 + cob.x * 0.7);\n                    }\n                    if self.pt >= r.blind_time {\n                        let m = 1.0 - (self.dist_sum / self.dist_n.max(1.0)) / r.blind_par;\n                        self.end_test(m, cx);\n                    }\n                }\n                _ => {\n                    self.c.step(cx, it.lean, 0.5, Vec2::ZERO, Vec2::ZERO);\n                    let beat = 60.0 / r.step_bpm;\n                    let lead = beat * 4.0;\n                    let n = ((self.pt - lead + beat * 4.0) / beat).floor() as i32;\n                    if n != self.beat_i {\n                        self.beat_i = n;\n                        cx.sfx(sound::TICK, if n % 4 == 0 { 0.8 } else { 0.5 }, if n % 4 == 0 { 1.3 } else { 1.0 });\n                    }\n                    let press = if it.l_just && it.r_just {\n                        None\n                    } else if it.l_just {\n                        Some(0)\n                    } else if it.r_just {\n                        Some(1)\n                    } else {\n                        None\n                    };\n                    if let Some(f) = press {\n                        if self.pt > lead - beat * 0.5 && (self.step_i as f32) < r.step_count {\n                            let want = lead + self.step_i as f32 * beat;\n                            let off = (self.pt - want).abs();\n                            // The other foot, please: the same foot twice costs.\n                            let wrong = self.step_i > 0 && f == self.step_foot;\n                            self.step_err += off.min(r.step_par) + if wrong { r.step_par * 0.5 } else { 0.0 };\n                            self.step_i += 1;\n                            self.step_foot = f;\n                            self.flash = 0.2;\n                            cx.sfx(sound::STEP, 0.6, 1.0);\n                            gesture(cx.sim, cx.pid, if f == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" }, false);\n                        }\n                    }\n                    let end = lead + (r.step_count + 1.0) * beat;\n                    if self.pt >= end {\n                        let missed = r.step_count - self.step_i as f32;\n                        let err = (self.step_err + missed.max(0.0) * r.step_par) / r.step_count;\n                        let m = 1.0 - err / r.step_par;\n                        self.end_test(m, cx);\n                    }\n                }\n            },\n        }\n        self.flash = (self.flash - dt).max(0.0);\n        // Pip squashes and the figure rides on top.\n        let cob = self.c.core.cob;\n        lean_figure(cx.sim, cx.pid, cob, 0.0, cx.rules.core.tilt_deg, cx.slump);\n        if let Some(p) = self.pip {\n            lean_figure(cx.sim, p, cob * 0.5, 0.0, 10.0, 0.0);\n        }\n        false\n    }\n\n    pub fn skill(&self, r: &Rules) -> f32 {\n        let c = &r.check;\n        c.weight_still * self.metrics[0] + c.weight_targets * self.metrics[1] + c.weight_blind * self.metrics[2] + c.weight_steps * self.metrics[3]\n    }\n\n    /// The worst of the four tests.\n    pub fn worst(&self) -> usize {\n        let mut w = 0;\n        for i in 1..4 {\n            if self.metrics[i] < self.metrics[w] {\n                w = i;\n            }\n        }\n        w\n    }\n\n    pub fn hud(&self, r: &Rules, ui: &mut Ui) {\n        let (name, how) = TESTS[self.test.min(3)];\n        match self.phase {\n            CheckPhase::Card => {\n                ui.card(460.0, 120.0, 1000.0, 200.0);\n                ui.title(960.0, 140.0, 72.0, INK, Align::Center, name);\n                ui.text(960.0, 240.0, 40.0, INK_SOFT, Align::Center, how);\n                ui.prompt_row(&[(Act::Confirm, \"Begin\")]);\n            }\n            CheckPhase::Done => {}\n            CheckPhase::Run => {\n                let mut p = self.c.puck(true);\n                match self.test {\n                    0 => {\n                        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n                        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n                        ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"{:.0} s left\", (r.check.still_time - self.pt).ceil().max(0.0)));\n                        p.ring = Some([0.0, 0.0, 0.2]);\n                        p.good = self.c.core.cob.length() < 0.2;\n                        ui.puck(p);\n                        ui.prompt_row(&[(Act::Lean, \"Stay in the middle\")]);\n                    }\n                    1 => {\n                        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n                        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n                        ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"Target {} of 3\", self.target_i.min(2) + 1));\n                        // A left/right bar.\n                        let (x, y, w, h) = (360.0, 170.0, 1200.0, 110.0);\n                        ui.panel(x - 20.0, y - 20.0, w + 40.0, h + 40.0, with_alpha(WHITE, 0.94), 36.0);\n                        let t = self.targets[self.target_i.min(2)];\n                        let at = |v: f32| x + w * (v + 1.0) * 0.5;\n                        let tol = r.check.target_within * w * 0.5;\n                        ui.panel(at(t) - tol, y, tol * 2.0, h, MINT, 16.0);\n                        ui.circle(at(self.c.core.cob.x.clamp(-1.0, 1.0)), y + h * 0.5, 44.0, CORAL, WHITE, 6.0);\n                        let side = if t < 0.0 { \"left\" } else { \"right\" };\n                        ui.label(960.0, 310.0, 54.0, INK, Align::Center, format!(\"{:.0}% {side}\", t.abs() * 100.0));\n                        ui.bar(760.0, 390.0, 400.0, 26.0, clamp01(self.hold_t / r.check.target_hold), TEAL);\n                        ui.prompt_row(&[(Act::Lean, \"Lean to the mark and hold\")]);\n                    }\n                    2 => {\n                        ui.fade([6, 12, 20, 240]);\n                        ui.text(960.0, 480.0, 44.0, [120, 140, 160, 255], Align::Center, \"Listen.\");\n                    }\n                    _ => {\n                        ui.panel(36.0, 30.0, 470.0, 112.0, with_alpha(WHITE, 0.93), 30.0);\n                        ui.label(60.0, 40.0, 42.0, INK, Align::Left, name);\n                        ui.text(60.0, 88.0, 38.0, INK_SOFT, Align::Left, format!(\"Step {} of {}\", self.step_i, r.check.step_count as u32));\n                        let beat = 60.0 / r.check.step_bpm;\n                        let u = (self.pt / beat).fract();\n                        ui.circle(960.0, 205.0, 80.0 + 60.0 * (1.0 - u), with_alpha(TEAL, 0.25 + 0.5 * (1.0 - u)), TEAL, 8.0);\n                        let lead = beat * 4.0;\n                        let word = if self.pt < lead { \"Wait for it\".to_string() } else { \"Step\".to_string() };\n                        ui.label(960.0, 180.0, 50.0, INK, Align::Center, word);\n                        ui.prompt_row(&[(Act::StepL, \"Left\"), (Act::StepR, \"Right\")]);\n                    }\n                }\n            }\n        }\n        quip_ui(&self.c, ui);\n    }\n\n    pub fn bot(&self, r: &Rules) -> Intent {\n        let mut it = Intent::default();\n        match self.phase {\n            CheckPhase::Card => {\n                it.act_just = self.pt > 1.0;\n                it.act = it.act_just;\n            }\n            CheckPhase::Done => {}\n            CheckPhase::Run => match self.test {\n                1 => {\n                    let t = self.targets[self.target_i.min(2)];\n                    let lean = t / r.core.reach + (t - self.c.core.cob.x) * 0.7;\n                    it.lean = Vec2::new(lean.clamp(-1.0, 1.0), -self.c.core.cob.y * 0.5);\n                }\n                3 => {\n                    let beat = 60.0 / r.check.step_bpm;\n                    let lead = beat * 4.0;\n                    let want = lead + self.step_i as f32 * beat;\n                    if (self.step_i as f32) < r.check.step_count && self.pt + 1.0 / 60.0 >= want {\n                        if self.step_i % 2 == 0 {\n                            it.l_just = true;\n                        } else {\n                            it.r_just = true;\n                        }\n                    }\n                }\n                _ => {\n                    it.lean = (-self.c.core.cob * 1.2 - self.c.core.vel * 0.1).clamp_length_max(1.0);\n                }\n            },\n        }\n        it\n    }\n}\n\nfn c_say(c: &mut RunCommon, test: usize) {\n    c.say_key(Who::Pip, \"pip.check_test\", test);\n}\n\n/// A coach's line in a small card.\npub fn quip_ui(c: &RunCommon, ui: &mut Ui) {\n    if let Some(q) = &c.quip {\n        let text: String = q.text().chars().take(q.shown as usize).collect();\n        if text.is_empty() {\n            return;\n        }\n        let (x, y, w, h) = (360.0, 846.0, 1200.0, 120.0);\n        ui.card_c(x, y, w, h, with_alpha(WHITE, 0.96));\n        ui.label(x + 30.0, y + 8.0, 34.0, TEAL, Align::Left, q.who.name());\n        ui.text(x + 30.0, y + 58.0, 36.0, INK, Align::Left, text);\n    }\n}\nEOF\ncat > finale.rs <<'EOF'\n//! The Big Stand: five phases on a tiny post at sunset, reusing the events with new numbers.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::dialog::Who;\nuse super::events::{breath::BreathBloom, plank::PlankStandoff, pose::PoseParade, step::StepParty, Cx, EventState, Intent, RunCommon};\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse super::world::*;\nuse crate::frame::SimEvent;\n\n/// The phase names, for the card between them.\npub const PHASES: [&str; 5] = [\"Breathing\", \"A Pose, in Weather\", \"Band of Guests\", \"Brace\", \"The Long Stillness\"];\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct BigStand {\n    pub phase: usize,\n    pub sub: Option<Box<EventState>>,\n    pub scores: Vec<f32>,\n    pub t0: f32,\n    pub card: f32,\n    pub fall: f32,\n    pub tips: u32,\n    pub peace: bool,\n    pub still_t: f32,\n    pub spoke: bool,\n    pub ending: f32,\n    pub post: Vec3,\n    pub crowd: Vec<crate::entity::EntityId>,\n    pub seed_phase: Option<usize>,\n    pub final_score: f32,\n}\n\nimpl BigStand {\n    /// `phase`: jump straight to a phase (dev mode, attract).\n    pub fn new(phase: usize) -> Self {\n        Self { phase, peace: true, card: 2.4, ..Default::default() }\n    }\n\n    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        self.post = cx.stage(Set::Bay) + Vec3::Y * 1.4;\n        show_set(cx.sim, Set::Bay);\n        place(cx.sim, cx.pid, self.post, 0.0);\n        stop_clip(cx.sim, cx.pid);\n        cam_full(cx.sim, 10.0, 0.0, 9.0, 38.0, 0.9, 0.12, None);\n        self.crowd = cx.sim.state.entities.iter().filter(|e| e.name.starts_with(\"crowd\")).map(|e| e.id).collect();\n        cx.ev.push(SimEvent::Music { song: song::BAND });\n        c.say_key(Who::Pip, \"pip.stand_phase\", self.phase);\n    }\n\n    fn make_phase(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let r = &cx.rules.stand;\n        let mut st = match self.phase {\n            0 => {\n                let mut b = BreathBloom::new(r.breath_cycles as usize);\n                b.finale = true;\n                b.gust = r.breath_gust;\n                EventState::Breath(b)\n            }\n            1 => {\n                let mut p = PoseParade::new(cx.day + 2, 1, r.pose_len);\n                p.finale = true;\n                p.with_gull = false;\n                p.gust = r.gust;\n                EventState::Pose(p)\n            }\n            2 => EventState::Step(StepParty::new(Some(r.bars as usize))),\n            _ => EventState::Plank(PlankStandoff::new(r.plank_len, true)),\n        };\n        self.t0 = c.t;\n        st.start(c, cx);\n        place(cx.sim, cx.pid, self.post, 0.0);\n        self.sub = Some(Box::new(st));\n        c.score = 0.0;\n    }\n\n    /// One tick; `Some(score)` at the very end.\n    pub fn tick(&mut self, c: &mut RunCommon, cx: &mut Cx, it: &Intent) -> Option<f32> {\n        let dt = cx.dt;\n        let rules = cx.rules;\n        if self.ending > 0.0 {\n            self.ending -= dt;\n            return (self.ending <= 0.0).then_some(self.final_score);\n        }\n        if self.fall > 0.0 {\n            // In the sea, and back on the post.\n            self.fall -= dt;\n            let u = self.fall / 1.6;\n            let drop = if u > 0.5 { (1.0 - u) * 2.0 } else { u * 2.0 };\n            place(cx.sim, cx.pid, self.post - Vec3::Y * drop * 2.2 + Vec3::new(1.2 * drop, 0.0, 0.0), 0.0);\n            if self.fall <= 0.0 {\n                c.core.settle();\n                place(cx.sim, cx.pid, self.post, 0.0);\n            }\n            return None;\n        }\n        if self.card > 0.0 {\n            self.card -= dt;\n            c.step(cx, it.lean, 0.5, Vec2::ZERO, Vec2::ZERO);\n            lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, rules.core.tilt_deg, cx.slump);\n            if self.card <= 0.0 && self.phase < 4 {\n                self.make_phase(c, cx);\n            } else if self.card <= 0.0 {\n                self.t0 = c.t;\n                cx.ev.push(SimEvent::Music { song: song::NONE });\n                c.quip = None;\n            }\n            return None;\n        }\n        if self.phase < 4 {\n            let saved = c.t;\n            c.t -= self.t0;\n            let mut sub = self.sub.take();\n            let done = sub.as_mut().and_then(|s| s.tick(c, cx, it));\n            self.sub = sub;\n            c.t = saved;\n            if c.core.tipped {\n                self.tips += 1;\n                self.fall = 1.6;\n                cx.ev.push(SimEvent::BigSplash { pos: self.post - Vec3::Y * 1.2, size: 0.9 });\n                cx.sfx(sound::GROAN, 0.9, 1.0);\n                cx.sfx(sound::SPLASH_B, 0.8, 1.0);\n                c.say_key(Who::Pip, \"pip.stand_tip\", self.tips as usize);\n            }\n            if let Some(s) = done {\n                if let Some(mut st) = self.sub.take() {\n                    st.stop(cx);\n                }\n                self.scores.push(s);\n                self.phase += 1;\n                self.card = 2.4;\n                c.core.settle();\n                for i in 0..self.crowd.len() {\n                    gesture(cx.sim, self.crowd[i], \"MESH2MOTION/Cheering_Two_Hands\", true);\n                }\n                cx.sfx(sound::CLAP, 0.6, 1.0);\n                c.say_key(Who::Pip, \"pip.stand_phase\", self.phase);\n                place(cx.sim, cx.pid, self.post, 0.0);\n                stop_clip(cx.sim, cx.pid);\n            }\n            return None;\n        }\n        // The Long Stillness: nothing happens, and the game tries to make you press something.\n        self.still_t += dt;\n        c.step(cx, it.lean, 0.35, Vec2::ZERO, Vec2::ZERO);\n        lean_figure(cx.sim, cx.pid, c.core.cob, 0.0, rules.core.tilt_deg, cx.slump);\n        if self.peace && (it.any || it.act_just || it.l_just || it.r_just) {\n            self.peace = false;\n            cx.sfx(sound::GROAN, 0.5, 1.2);\n        }\n        if self.still_t >= rules.stand.stillness && !self.spoke {\n            self.spoke = true;\n            let n = self.scores.len().max(1) as f32;\n            let avg = self.scores.iter().sum::<f32>() / n;\n            let bonus = if self.peace { rules.stand.peace_bonus } else { 0.0 };\n            self.final_score = (avg * (1000.0 - rules.stand.peace_bonus) / 1000.0 + bonus - self.tips as f32 * rules.stand.tip_cost).clamp(0.0, 1000.0);\n            c.score = self.final_score;\n            c.say_key(Who::Pip, \"pip.stand_end\", self.peace as usize);\n            self.ending = 4.0;\n            cx.sfx(sound::FANFARE, 0.8, 1.0);\n            cx.sfx(sound::CONFETTI, 0.8, 1.0);\n        }\n        None\n    }\n\n    pub fn stop(&mut self, cx: &mut Cx) {\n        if let Some(mut st) = self.sub.take() {\n            st.stop(cx);\n        }\n    }\n\n    pub fn stillness(&self) -> bool {\n        self.phase >= 4 && self.card <= 0.0 && self.ending <= 0.0\n    }\n\n    pub fn hud(&self, c: &RunCommon, r: &Rules, ui: &mut Ui) {\n        if self.card > 0.0 && self.phase < 5 {\n            ui.card(560.0, 90.0, 800.0, 170.0);\n            ui.text(960.0, 104.0, 36.0, INK_SOFT, Align::Center, format!(\"Phase {} of 5\", self.phase + 1));\n            ui.label(960.0, 158.0, 62.0, INK, Align::Center, PHASES[self.phase.min(4)]);\n            return;\n        }\n        if self.phase < 4 {\n            if let Some(s) = &self.sub {\n                s.hud(c, r, ui);\n            }\n            return;\n        }\n        if self.ending > 0.0 {\n            return;\n        }\n        // Stillness: the HUD vanishes, except the Puck.\n        ui.puck(c.puck(true));\n        if self.still_t >= r.stand.fake_prompt_at && self.still_t < r.stand.fake_prompt_at + 6.0 {\n            ui.prompt_row(&[(Act::Confirm, \"Press to skip\")]);\n        }\n    }\n\n    pub fn bot(&self, c: &RunCommon, r: &Rules) -> Intent {\n        if self.card > 0.0 || self.fall > 0.0 {\n            return Intent::default();\n        }\n        if self.phase < 4 {\n            if let Some(s) = &self.sub {\n                let mut sc = c.clone();\n                sc.t = c.t - self.t0;\n                return s.bot(&sc, r);\n            }\n        }\n        Intent::default()\n    }\n}\nEOF\ncd events && python3 - <<'EOF'\nimport re\ns=open('breath.rs').read()\ns=s.replace(\"\"\"    /// Finale: no lotus field of its own, no HUD ring wobble of its own.\n    pub ents: Vec<EntityId>,\"\"\",\"\"\"    pub ents: Vec<EntityId>,\n    /// In the Big Stand: stays on the post, no pond of its own.\n    pub finale: bool,\"\"\")\ns=s.replace(\"\"\"        self.total = (0..self.cycles).map(|i| self.cycle_len(i, cx.rules)).sum();\n\"\"\",\"\"\"        self.total = (0..self.cycles).map(|i| self.cycle_len(i, cx.rules)).sum();\n        if self.finale {\n            return;\n        }\n\"\"\")\ns=s.replace(\"\"\"        c.top_bar(ui, \"Breath Bloom\", Some(self.total - c.t));\"\"\",\"\"\"        if !self.finale {\n            c.top_bar(ui, \"Breath Bloom\", Some(self.total - c.t));\n        }\"\"\")\nopen('breath.rs','w').write(s)\ns=open('pose.rs').read()\ns=s.replace(\"\"\"    pub was_mult: u8,\n}\"\"\",\"\"\"    pub was_mult: u8,\n    /// In the Big Stand: stays on the post.\n    pub finale: bool,\n}\"\"\")\ns=s.replace(\"\"\"    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        let at = cx.stage(Set::Studio);\"\"\",\"\"\"    pub fn start(&mut self, c: &mut RunCommon, cx: &mut Cx) {\n        if self.finale {\n            return;\n        }\n        let at = cx.stage(Set::Studio);\"\"\")\ns=s.replace(\"\"\"        c.top_bar(ui, \"Pose Parade\", Some(self.len - self.pt + (self.poses.len() - 1 - self.i) as f32 * self.len));\"\"\",\"\"\"        if !self.finale {\n            c.top_bar(ui, \"Pose Parade\", Some(self.len - self.pt + (self.poses.len() - 1 - self.i) as f32 * self.len));\n        }\"\"\")\ns=s.replace(\"\"\"        ui.panel(560.0, 400.0, 800.0, 0.0, WHITE, 0.0);\n\"\"\",\"\")\nopen('pose.rs','w').write(s)\ns=open('plank.rs').read()\ns=s.replace(\"\"\"        c.top_bar(ui, \"Plank Standoff\", Some(self.len - self.held));\"\"\",\"\"\"        if !self.waves {\n            c.top_bar(ui, \"Plank Standoff\", Some(self.len - self.held));\n        }\"\"\")\nopen('plank.rs','w').write(s)\nEOF\ncat > ../charts.toml <<'EOF'\n# Step Party notes, one line per bar of eighths: L left, R right, B both, . nothing.\n# 96 BPM. Starts with quarter notes and builds to eighths and doubles.\nbpm = 96.0\nlead_in_beats = 8.0\n\nparty = [\n  \"L...R...L...R...\",\n  \"L...R...L...R...\",\n  \"L...L...R...R...\",\n  \"L...R...L...R...\",\n  \"L.R.L...R.L.R...\",\n  \"L...R.L.R...L.R.\",\n  \"L.R.L.R.L...R...\",\n  \"L.R.L.R.B.......\",\n  \"L...B...R...B...\",\n  \"L.R.B...R.L.B...\",\n  \"L.R.L.R.L.R.L.R.\",\n  \"R.L.R.L.R.L.R.L.\",\n  \"L.L.R.R.L.L.R.R.\",\n  \"B...L.R.B...R.L.\",\n  \"L.R.L.R.B...B...\",\n  \"L.R.L.R.L.R.B...\",\n  \"B.L.R.L.B.R.L.R.\",\n  \"L.R.B...L.R.B...\",\n  \"L.L.R.R.B...B...\",\n  \"B.......B.......\",\n]\n\nfinale = [\n  \"L...R...L...R...\",\n  \"L...R...L...R...\",\n  \"L...L...R...R...\",\n  \"L.R.L...R.L.R...\",\n  \"L...B...R...B...\",\n  \"L.R.L.R.L.R.L.R.\",\n  \"B...L.R.B...R.L.\",\n  \"L.R.B...L.R.B...\",\n  \"L...R...L...R...\",\n  \"L.R.L...R.L.R...\",\n  \"L...B...R...B...\",\n  \"L.R.L.R.L.R.B...\",\n  \"L.R.L.R.L.R.L.R.\",\n  \"B.L.R.L.B.R.L.R.\",\n  \"L.L.R.R.B...B...\",\n  \"B.......B.......\",\n]\nEOF\npython3 - <<'EOF'\nimport re\ns=open('../charts.toml').read()\nn=sum(len(re.findall(r'[LRB]',l)) for l in s.split('party = [')[1].split('finale')[0].splitlines())\nprint('party notes',n)\nEOF\n","description":"Write rules, morning check, finale, charts"}}}
