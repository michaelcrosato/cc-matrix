the deadzone, for the lean's own shaping.\n    pub raw_left: Vec2,\n    /// Options, unless Create is held (that pair belongs to the AI Hub).\n    pub pause_pressed: bool,\n}\"\"\"),\n(\"\"\"    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n    pub game: bool,\n}\"\"\",\"\"\"    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n    pub game: bool,\n    /// Whiff Fit's layout.\n    pub fit: bool,\n    /// Keyboard and mouse: the mouse moved or clicked last.\n    pub mouse_recent: bool,\n    key_lean: Vec2,\n    lean_from: LeanFrom,\n    last_stick: Vec2,\n    last_cursor: Vec2,\n}\n\n/// The device that moved last wins the lean.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\nenum LeanFrom {\n    #[default]\n    Stick,\n    Keys,\n    Mouse,\n}\n\n/// What the game says about shaping the lean this frame.\n#[derive(Clone, Copy, Debug)]\npub struct LeanShape {\n    pub deadzone: f32,\n    pub curve: f32,\n    pub key_rate: f32,\n    pub key_return: f32,\n    pub mouse_span: f32,\n    pub arrows_step: bool,\n    pub cursor_leans: bool,\n    pub fast: bool,\n}\"\"\"),\n(\"\"\"            bindings: Bindings::default(),\n            game: false,\n        }\"\"\",\"\"\"            bindings: Bindings::default(),\n            game: false,\n            fit: false,\n            mouse_recent: false,\n            key_lean: Vec2::ZERO,\n            lean_from: LeanFrom::Stick,\n            last_stick: Vec2::ZERO,\n            last_cursor: Vec2::ZERO,\n        }\"\"\"),\n(\"\"\"    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n\"\"\",\"\"\"    /// The lean this frame, shaped per device: stick, keys or cursor, whichever moved last.\n    pub fn fit_lean(&mut self, dt: f32, size: Vec2, s: &LeanShape) -> Vec2 {\n        let raw = self.pad.raw_left;\n        let l = raw.length();\n        let stick = if l < s.deadzone { Vec2::ZERO } else { raw / l * ((l - s.deadzone) / (1.0 - s.deadzone)).min(1.0).powf(s.curve) };\n        if (raw - self.last_stick).length() > 0.02 && l > s.deadzone {\n            self.lean_from = LeanFrom::Stick;\n        }\n        self.last_stick = raw;\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n        use KeyCode::*;\n        let (left, right) = if s.arrows_step { (k(&[KeyA]), k(&[KeyD])) } else { (k(&[KeyA, ArrowLeft]), k(&[KeyD, ArrowRight])) };\n        let dir = Vec2::new(right - left, k(&[KeyW, ArrowUp]) - k(&[KeyS, ArrowDown]));\n        // Keys move the target at a rate and it returns when they're released: tapping gives\n        // small nudges, so keys feel native, not bang-bang. Shift is the fine lean.\n        let fine = if self.keys.contains(&ShiftLeft) || self.keys.contains(&ShiftRight) { 0.5 } else { 1.0 };\n        let rate = if s.fast { 9.0 } else { s.key_rate * fine };\n        if dir != Vec2::ZERO {\n            self.lean_from = LeanFrom::Keys;\n            self.key_lean = (self.key_lean + dir.normalize() * rate * dt).clamp_length_max(1.0);\n        }\n        let back = if s.fast { 3.0 } else { s.key_return } * dt;\n        if dir.x == 0.0 {\n            self.key_lean.x -= self.key_lean.x.clamp(-back, back);\n        }\n        if dir.y == 0.0 {\n            self.key_lean.y -= self.key_lean.y.clamp(-back, back);\n        }\n        if (self.cursor - self.last_cursor).length() > 1.5 && s.cursor_leans {\n            self.lean_from = LeanFrom::Mouse;\n        }\n        self.last_cursor = self.cursor;\n        match self.lean_from {\n            LeanFrom::Stick => stick,\n            LeanFrom::Keys => self.key_lean,\n            LeanFrom::Mouse if s.cursor_leans => {\n                let span = (s.mouse_span * size.y).max(1.0);\n                let o = (self.cursor - size * 0.5) / span;\n                Vec2::new(o.x, -o.y).clamp_length_max(1.0)\n            }\n            LeanFrom::Mouse => Vec2::ZERO,\n  