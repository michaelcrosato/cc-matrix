ast_cursor = self.cursor;\n        match self.lean_from {\n            LeanFrom::Stick => stick,\n            LeanFrom::Keys => self.key_lean,\n            LeanFrom::Mouse if s.cursor_leans => {\n                let span = (s.mouse_span * size.y).max(1.0);\n                let o = (self.cursor - size * 0.5) / span;\n                Vec2::new(o.x, -o.y).clamp_length_max(1.0)\n            }\n            LeanFrom::Mouse => Vec2::ZERO,\n        }\n    }\n\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_recent = false;\n\"\"\"),\n(\"\"\"    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_active = true;\n\"\"\",\"\"\"    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_active = true;\n        self.mouse_recent = true;\n\"\"\"),\n(\"\"\"            let is = |b: Button| st.held.contains(&b);\n            pad.left = deadzone(st.left, 0.18);\n            pad.right = deadzone(st.right, 0.25);\n            let mut held = 0;\n            let layout: &[(Button, u32)] = if self.game {\"\"\",\"\"\"            let is = |b: Button| st.held.contains(&b);\n            pad.left = deadzone(st.left, 0.18);\n            pad.right = deadzone(st.right, 0.25);\n            pad.raw_left = st.left;\n            let mut held = 0;\n            let layout: &[(Button, u32)] = if self.fit {\n                &[\n                    (Button::South, buttons::CONFIRM),\n                    (Button::East, buttons::BACK),\n                    (Button::West, buttons::WAVE),\n                    (Button::North, buttons::SCHEDULE),\n                    (Button::LeftTrigger, buttons::TAB_L | buttons::STEP_L),\n                    (Button::RightTrigger, buttons::TAB_R | buttons::STEP_R),\n                    (Button::DPadUp, buttons::MENU_UP)