{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjFsPY75NEVwqMGcaaGh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01StDUa6MqAbpMiUB7XEAFLG","name":"Bash","input":{"command":"cd crates/pav_core/src/games/fit && cat > world.rs <<'EOF'\n//! The sets (one room each, on one `Sim`) and small helpers that move things around in them.\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow};\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::color::Color;\nuse crate::entity::{EntityId, Spawn};\nuse crate::frame::SimEvent;\nuse crate::level::Placement;\nuse crate::params::ParamValue;\nuse crate::puppet::PuppetState;\nuse crate::room::RoomDef;\nuse crate::shape::{Shape, Visual};\nuse crate::sim::Sim;\nuse crate::world::{RoomSlot, World};\nuse crate::zones::{CameraCue, Sweep};\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Set {\n    #[default]\n    Hub = 0,\n    Studio = 1,\n    Gazebo = 2,\n    Boardwalk = 3,\n    Tide = 4,\n    Channel = 5,\n    Pier = 6,\n    Tower = 7,\n    Bay = 8,\n}\n\n/// Every set's key and text. The file is read from disk when running from `engine/`.\nconst SETS: [(&str, &str); 9] = [\n    (\"fit/sets/hub\", include_str!(\"sets/hub.toml\")),\n    (\"fit/sets/studio\", include_str!(\"sets/studio.toml\")),\n    (\"fit/sets/gazebo\", include_str!(\"sets/gazebo.toml\")),\n    (\"fit/sets/boardwalk\", include_str!(\"sets/boardwalk.toml\")),\n    (\"fit/sets/tide\", include_str!(\"sets/tide.toml\")),\n    (\"fit/sets/channel\", include_str!(\"sets/channel.toml\")),\n    (\"fit/sets/pier\", include_str!(\"sets/pier.toml\")),\n    (\"fit/sets/tower\", include_str!(\"sets/tower.toml\")),\n    (\"fit/sets/bay\", include_str!(\"sets/bay.toml\")),\n];\n\n/// Metres between set origins: far enough that fog hides each from the next.\nconst SPACING: f32 = 500.0;\n\n/// Builds all the sets into the sim's world.\npub fn load_sets(sim: &mut Sim) -> Result<()> {\n    let mut rooms = Vec::new();\n    for (i, (key, text)) in SETS.iter().enumerate() {\n        let mut def = RoomDef::parse(&super::super::level_text(key, text)).map_err(|e| anyhow!(\"{key}: {e}\"))?;\n        def.layout.origin = Vec3::new(i as f32 * SPACING, 0.0, 0.0);\n        let place = Placement::new(def.layout.origin, 0);\n        let (cols, rows) = def.layout.extent();\n        let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n        let start = def.local_start();\n        let inward = -def.entrance.facing.dir();\n        rooms.push(RoomSlot {\n            id: i as u16,\n            key: key.rsplit('/').next().unwrap_or(key).to_string(),\n            def: Arc::new(def),\n            place,\n            min,\n            max,\n            inside: place.point(start),\n            outside: place.point(start) - inward * 4.0,\n            inward,\n            built: false,\n        });\n    }\n    let n = rooms.len() as u16;\n    sim.state.world = World { enabled: false, rooms, current_room: Some(0), ..Default::default() };\n    for i in 0..n {\n        sim.build_room(i);\n    }\n    Ok(())\n}\n\n/// A set's markers named `name`.\npub fn set_markers(sim: &mut Sim, set: Set, name: &str) -> Vec<Vec3> {\n    let was = sim.state.world.current_room;\n    sim.state.world.current_room = Some(set as u16);\n    let out = crate::scenes::markers(sim, name);\n    sim.state.world.current_room = was;\n    out\n}\n\n/// Makes `set` the one on screen (its [camera] and [view] apply; the app irises to it).\npub fn show_set(sim: &mut Sim, set: Set) {\n    sim.state.world.current_room = Some(set as u16);\n}\n\npub fn current_set(sim: &Sim) -> Set {\n    match sim.state.world.current_room.unwrap_or(0) {\n        1 => Set::Studio,\n        2 => Set::Gazebo,\n        3 => Set::Boardwalk,\n        4 => Set::Tide,\n        5 => Set::Channel,\n        6 => Set::Pier,\n        7 => Set::Tower,\n        8 => Set::Bay,\n        _ => Set::Hub,\n    }\n}\n\n/// An NPC from a set's file, by name.\npub fn npc(sim: &Sim, name: &str) -> Option<EntityId> {\n    sim.state.entities.iter().find(|e| e.name == name && e.character.is_some()).map(|e| e.id)\n}\n\n/// The game's own prop copy with no collision; it stays where it is told.\npub fn spawn_prop(sim: &mut Sim, asset: &str, pos: Vec3, yaw: f32, scale: f32) -> EntityId {\n    spawn_prop_roles(sim, asset, pos, yaw, scale, &[])\n}\n\npub fn spawn_prop_roles(sim: &mut Sim, asset: &str, pos: Vec3, yaw: f32, scale: f32, roles: &[(&str, &str)]) -> EntityId {\n    let placed = crate::props::resolve_placed(asset, &crate::props::Params::new()).and_then(|(name, def, params)| {\n        let roles: BTreeMap<String, String> = roles.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();\n        crate::prop_instance::PropInstance::new(&name, def, scale, false)?.with_params(&params)?.with_roles(roles)\n    });\n    match placed.and_then(|copy| sim.place_prop(copy, pos, Quat::from_rotation_y(yaw), None)) {\n        Ok(id) => id,\n        Err(e) => {\n            log::error!(\"prop {asset}: {e}\");\n            spawn_ball(sim, \"missing\", pos, 0.2, \"#ff00ff\")\n        }\n    }\n}\n\npub fn spawn_ball(sim: &mut Sim, name: &str, pos: Vec3, radius: f32, color: &str) -> EntityId {\n    sim.spawn(Spawn::new(name, pos).visual(Visual::new(Shape::Sphere { radius }, Color::hex(color))))\n}\n\npub fn spawn_box(sim: &mut Sim, name: &str, pos: Vec3, half: Vec3, color: &str) -> EntityId {\n    sim.spawn(Spawn::new(name, pos).visual(Visual::new(Shape::RoundedBox { half, radius: half.min_element() * 0.4 }, Color::hex(color))))\n}\n\npub fn spawn_cyl(sim: &mut Sim, name: &str, pos: Vec3, half_height: f32, radius: f32, color: &str) -> EntityId {\n    sim.spawn(Spawn::new(name, pos).visual(Visual::new(Shape::Cylinder { half_height, radius }, Color::hex(color))))\n}\n\n/// Moves a no-physics entity.\npub fn pose(sim: &mut Sim, id: EntityId, pos: Vec3, rot: Quat) {\n    if let Some(e) = sim.state.entities.get_mut(id) {\n        e.pos = pos;\n        e.rot = rot;\n    }\n}\n\npub fn move_to(sim: &mut Sim, id: EntityId, pos: Vec3) {\n    if let Some(e) = sim.state.entities.get_mut(id) {\n        e.pos = pos;\n    }\n}\n\npub fn pos_of(sim: &Sim, id: EntityId) -> Vec3 {\n    sim.state.entities.get(id).map(|e| e.pos).unwrap_or(Vec3::ZERO)\n}\n\npub fn despawn_all(sim: &mut Sim, ids: &mut Vec<EntityId>) {\n    for id in ids.drain(..) {\n        sim.despawn(id);\n    }\n}\n\n/// Puts a character's feet at `feet` facing `facing` (radians, 0 = +Z).\npub fn place(sim: &mut Sim, id: EntityId, feet: Vec3, facing: f32) {\n    sim.set_position(id, feet);\n    set_facing(sim, id, facing);\n}\n\npub fn set_facing(sim: &mut Sim, id: EntityId, facing: f32) {\n    if let Some(ch) = sim.state.entities.get_mut(id).and_then(|e| e.character.as_mut()) {\n        ch.facing = facing;\n        ch.anim.facing = facing;\n    }\n}\n\npub fn anim_of(sim: &mut Sim, id: EntityId) -> Option<&mut PuppetState> {\n    sim.state.entities.get_mut(id).and_then(|e| e.character.as_mut()).map(|c| &mut c.anim)\n}\n\npub fn clip_id(name: &str) -> u32 {\n    crate::clips::find_cached(name)\n}\n\n/// Plays a looping clip (asking again keeps it going).\npub fn play(sim: &mut Sim, id: EntityId, clip: &str) {\n    let c = clip_id(clip);\n    if let Some(a) = anim_of(sim, id) {\n        a.play_clip(c, 0, 0.0);\n    }\n}\n\npub fn play_flags(sim: &mut Sim, id: EntityId, clip: &str, flags: u8, speed: f32) {\n    let c = clip_id(clip);\n    if let Some(a) = anim_of(sim, id) {\n        a.play_clip(c, flags, speed);\n    }\n}\n\n/// A one-shot gesture from its start.\npub fn gesture(sim: &mut Sim, id: EntityId, clip: &str, upper: bool) {\n    let c = clip_id(clip);\n    let flags = crate::clips::ONCE | if upper { crate::clips::UPPER } else { 0 };\n    if let Some(a) = anim_of(sim, id) {\n        a.replay_clip(c, flags, 0.0);\n    }\n}\n\n/// Holds a clip at time `t` (gameplay scrubs it).\npub fn scrub(sim: &mut Sim, id: EntityId, clip: &str, t: f32) {\n    let c = clip_id(clip);\n    if let Some(a) = anim_of(sim, id) {\n        a.play_clip(c, crate::clips::CLAMP, 1e-6);\n        a.clip_t = t;\n    }\n}\n\npub fn stop_clip(sim: &mut Sim, id: EntityId) {\n    if let Some(a) = anim_of(sim, id) {\n        a.stop_clip();\n    }\n}\n\n/// Leans the whole figure by a screen-space dot from a camera at `cam_yaw` degrees: x toward\n/// the camera's right, y away from it, `deg` degrees at full lean, plus a forward slump (radians).\npub fn lean_figure(sim: &mut Sim, id: EntityId, dot: Vec2, cam_yaw: f32, deg: f32, slump: f32) {\n    let y = cam_yaw.to_radians();\n    let right = Vec3::new(y.cos(), 0.0, y.sin());\n    let away = Vec3::new(y.sin(), 0.0, -y.cos());\n    let world = (right * dot.x + away * dot.y) * deg.to_radians();\n    if let Some(a) = anim_of(sim, id) {\n        let (s, c) = a.facing.sin_cos();\n        let fwd = Vec3::new(s, 0.0, c);\n        let side = Vec3::new(c, 0.0, -s);\n        a.tilt_side = world.dot(side);\n        a.tilt_fwd = world.dot(fwd) + slump;\n    }\n}\n\npub fn clear_lean(sim: &mut Sim, id: EntityId) {\n    if let Some(a) = anim_of(sim, id) {\n        a.tilt_side = 0.0;\n        a.tilt_fwd = 0.0;\n    }\n}\n\n/// The camera, blended over 0.7 s. Yaw 0 looks north at a figure facing +Z (the mirror view).\npub fn cam(sim: &mut Sim, tilt: f32, yaw: f32, distance: f32, fov: f32) {\n    cam_full(sim, tilt, yaw, distance, fov, 0.8, 0.12, None);\n}\n\n#[allow(clippy::too_many_arguments)]\npub fn cam_full(sim: &mut Sim, tilt: f32, yaw: f32, distance: f32, fov: f32, height: f32, lag: f32, sweep: Option<(&str, f32, f32, f32)>) {\n    let set: BTreeMap<String, ParamValue> = [\n        (\"tilt\", tilt),\n        (\"yaw\", yaw),\n        (\"distance\", distance),\n        (\"fov\", fov),\n        (\"height_offset\", height),\n        (\"follow_lag\", lag),\n    ]\n    .into_iter()\n    .map(|(k, v)| (k.to_string(), ParamValue::Float(v as f64)))\n    .collect();\n    let sweep = sweep\n        .map(|(param, from, to, period)| vec![Sweep { param: param.to_string(), from, to, period, phase: 0.0 }])\n        .unwrap_or_default();\n    let c = &mut sim.state.courses;\n    c.sticky_cue = Some(Arc::new(CameraCue { set, sweep, flip_ortho: 0.0 }));\n    c.cue_serial += 1;\n}\n\n/// A slow orbit (result screens, the title's sweep).\npub fn cam_orbit(sim: &mut Sim, tilt: f32, distance: f32, fov: f32, height: f32, from: f32, to: f32, period: f32) {\n    cam_full(sim, tilt, from, distance, fov, height, 0.2, Some((\"yaw\", from, to, period)));\n}\n\n/// Lighting per state: view paths over the set's own `[view]`.\npub fn view_over(sim: &mut Sim, pairs: &[(&str, f64)]) {\n    let c = &mut sim.state.courses;\n    c.view = pairs.iter().map(|(k, v)| (k.to_string(), ParamValue::Float(*v))).collect();\n    c.view_serial += 1;\n}\n\npub fn sfx(ev: &mut Vec<SimEvent>, id: u16, gain: f32, pitch: f32) {\n    ev.push(SimEvent::Sfx { id, gain, pitch });\n}\n\npub fn clamp01(x: f32) -> f32 {\n    x.clamp(0.0, 1.0)\n}\n\npub fn smooth(x: f32) -> f32 {\n    let t = clamp01(x);\n    t * t * (3.0 - 2.0 * t)\n}\n\n/// Sound bank ids (`pav_audio::sfx_bank` plays them).\npub mod sound {\n    pub const UI_MOVE: u16 = 0;\n    pub const UI_CONFIRM: u16 = 1;\n    pub const UI_BACK: u16 = 2;\n    pub const STAMP: u16 = 3;\n    pub const CLAM: u16 = 4;\n    pub const AGE_TICK: u16 = 5;\n    pub const STEP: u16 = 6;\n    pub const PIP_SQUEAK: u16 = 7;\n    pub const CREAK: u16 = 8;\n    pub const SPLASH_S: u16 = 9;\n    pub const SPLASH_B: u16 = 10;\n    pub const GULL: u16 = 11;\n    pub const CROWD: u16 = 12;\n    pub const CLAP: u16 = 13;\n    pub const GONG: u16 = 14;\n    pub const BELL: u16 = 15;\n    pub const WHOOSH: u16 = 16;\n    pub const SHELL_ROLL: u16 = 17;\n    pub const SHELL_PLOP: u16 = 18;\n    pub const GLASS_PLOP: u16 = 19;\n    pub const CONFETTI: u16 = 20;\n    pub const GUST: u16 = 21;\n    pub const WAVE: u16 = 22;\n    pub const SEA: u16 = 23;\n    pub const TONE: u16 = 24;\n    pub const CHIME: u16 = 25;\n    pub const TICK: u16 = 26;\n    pub const STAR: u16 = 27;\n    pub const FANFARE: u16 = 28;\n    pub const SAD: u16 = 29;\n    pub const REVEAL: u16 = 30;\n    pub const GROAN: u16 = 31;\n    pub const CATCH: u16 = 32;\n    pub const HIT_GOOD: u16 = 33;\n    pub const HIT_PERFECT: u16 = 34;\n    pub const MISS: u16 = 35;\n    pub const COUNT: u16 = 36;\n    pub const GO: u16 = 37;\n    pub const BOARD: u16 = 38;\n    pub const STITCH: u16 = 39;\n    pub const RIBBON: u16 = 40;\n    pub const BUMP: u16 = 41;\n    pub const HEARTBEAT: u16 = 42;\n    /// How many ids there are.\n    pub const TOTAL: u16 = 43;\n}\n\n/// Songs (`pav_audio::music`).\npub mod song {\n    pub const NONE: u8 = 0;\n    pub const LOBBY: u8 = 1;\n    pub const TIDE: u8 = 2;\n    pub const WALTZ: u8 = 3;\n    pub const STEP: u8 = 4;\n    pub const MALLETS: u8 = 5;\n    pub const BAND: u8 = 6;\n}\nEOF\ncat > script.rs <<'EOF'\n//! All the game's words, in `script.toml`: named lists of lines. Tests lint them.\n\nuse std::collections::BTreeMap;\nuse std::sync::{OnceLock, RwLock};\n\n/// Named lists of lines.\npub type Lines = BTreeMap<String, Vec<String>>;\n\nstatic SCRIPT: OnceLock<RwLock<Lines>> = OnceLock::new();\n\nfn cell() -> &'static RwLock<Lines> {\n    SCRIPT.get_or_init(|| RwLock::new(parse(include_str!(\"script.toml\"))))\n}\n\nfn parse(text: &str) -> Lines {\n    toml::from_str(text).unwrap_or_else(|e| {\n        log::error!(\"script.toml: {e}\");\n        Lines::new()\n    })\n}\n\n/// Re-reads the words (the disk's copy when running from the repository).\npub fn reload() {\n    let text = super::super::level_text(\"fit/script\", include_str!(\"script.toml\"));\n    *cell().write().unwrap() = parse(&text);\n}\n\n/// The whole table (tests).\npub fn all() -> Lines {\n    cell().read().unwrap().clone()\n}\n\n/// Line `i` (wrapping) of list `key`.\npub fn line(key: &str, i: usize) -> String {\n    let s = cell().read().unwrap();\n    match s.get(key) {\n        Some(list) if !list.is_empty() => list[i % list.len()].clone(),\n        _ => {\n            log::error!(\"script: no lines for {key}\");\n            String::new()\n        }\n    }\n}\n\n/// How many lines a list has.\npub fn count(key: &str) -> usize {\n    cell().read().unwrap().get(key).map(|l| l.len()).unwrap_or(0)\n}\n\n/// A whole list.\npub fn list(key: &str) -> Vec<String> {\n    cell().read().unwrap().get(key).cloned().unwrap_or_default()\n}\n\n/// A line with `{word}`s filled in.\npub fn fill(text: &str, vars: &[(&str, String)]) -> String {\n    let mut s = text.to_string();\n    for (k, v) in vars {\n        s = s.replace(&format!(\"{{{k}}}\"), v);\n    }\n    s\n}\nEOF\ncat > meta.rs <<'EOF'\n//! What persists: settings, guest slots, personal bests, ghosts. Versioned JSON the page keeps\n//! in `localStorage`.\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\nuse super::ghost::GFrame;\nuse crate::puppet::PuppetDef;\n\npub const SAVE_VERSION: u32 = 1;\npub const SLOTS: usize = 4;\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Settings {\n    pub music: f32,\n    pub sfx: f32,\n    pub voice: f32,\n    pub xbox: bool,\n    pub lean_sens: f32,\n    pub assist: f32,\n    pub rhythm_offset: f32,\n    pub text_speed: u8,\n}\n\nimpl Default for Settings {\n    fn default() -> Self {\n        Self { music: 0.10, sfx: 0.80, voice: 0.80, xbox: false, lean_sens: 1.0, assist: 0.0, rhythm_offset: 0.10, text_speed: 1 }\n    }\n}\n\n/// What the guest wears beyond the outfit.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Wear {\n    pub hat: u8,\n    pub bands: u8,\n    pub belt: u8,\n    pub floaties: u8,\n    pub shirt: u8,\n    pub pants: u8,\n    pub shoes: u8,\n}\n\n/// One guest's stay.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Guest {\n    pub name: String,\n    pub skin: u8,\n    pub outfit: u8,\n    pub wear: Wear,\n    /// The day of the stay, 1 to 5.\n    pub day: u8,\n    /// Days finished (stamps).\n    pub stamps: u8,\n    pub minutes: u32,\n    pub minutes_today: u32,\n    /// Stars and scores per event key.\n    pub stars: BTreeMap<String, u8>,\n    pub bests: BTreeMap<String, u32>,\n    pub best_ghost: BTreeMap<String, Vec<GFrame>>,\n    /// Events cleared today.\n    pub today: Vec<String>,\n    /// Morning ages, one per day checked.\n    pub ages: Vec<u8>,\n    /// Morning check done today.\n    pub checked: bool,\n    /// Lost flip-flops found (bits), and given to Tom.\n    pub flipflops: u8,\n    pub golden: bool,\n    /// 0 still on the stay; 1 checked out; 2 extended stay. Both open Free Play.\n    pub ending: u8,\n    pub final_age: u8,\n    /// The day number (days since 1970) last played.\n    pub last_date: i64,\n    pub total_wobbles: u32,\n    pub played: Vec<String>,\n    /// Talked to these people today (keys).\n    pub talked: Vec<String>,\n    pub titles: u32,\n    pub free_days: u32,\n}\n\nimpl Guest {\n    pub fn total_stars(&self) -> u32 {\n        self.stars.values().map(|&s| s as u32).sum()\n    }\n    pub fn free_play(&self) -> bool {\n        self.ending != 0\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct SaveData {\n    pub version: u32,\n    pub settings: Settings,\n    pub slots: Vec<Option<Guest>>,\n}\n\nimpl Default for SaveData {\n    fn default() -> Self {\n        Self { version: SAVE_VERSION, settings: Settings::default(), slots: vec![None; SLOTS] }\n    }\n}\n\nimpl SaveData {\n    /// Reads a save, or `None` when it isn't one (or comes from a newer version).\n    pub fn parse(text: &str) -> Option<SaveData> {\n        let mut s: SaveData = serde_json::from_str(text).ok()?;\n        if s.version > SAVE_VERSION {\n            return None;\n        }\n        s.version = SAVE_VERSION;\n        s.slots.resize(SLOTS, None);\n        Some(s)\n    }\n    pub fn to_json(&self) -> String {\n        serde_json::to_string(self).unwrap_or_default()\n    }\n}\n\npub const SKINS: [&str; 6] = [\"#f6d7b8\", \"#eebd94\", \"#d9a074\", \"#b97f54\", \"#8c5a3a\", \"#5f3d29\"];\n\n/// Name, shirt, pants, shoes.\npub const OUTFITS: [(&str, &str, &str, &str); 8] = [\n    (\"Resort Mint\", \"#78dcaa\", \"#f4f1e8\", \"#46bec8\"),\n    (\"Tide Blue\", \"#46bec8\", \"#263e54\", \"#f4f1e8\"),\n    (\"Coral Reef\", \"#ff786e\", \"#f4f1e8\", \"#ffd166\"),\n    (\"Sun Yellow\", \"#ffd166\", \"#46bec8\", \"#ff786e\"),\n    (\"Towel White\", \"#fbfaf6\", \"#fbfaf6\", \"#d9d4c5\"),\n    (\"Lavender Calm\", \"#c4b1e8\", \"#f4f1e8\", \"#8a78b8\"),\n    (\"Sand Dollar\", \"#e8d4a8\", \"#a08a60\", \"#f4f1e8\"),\n    (\"Ink Sensible\", \"#3c5a78\", \"#263e54\", \"#fbfaf6\"),\n];\n\n/// One wardrobe row's options: a label and the minutes that unlock it.\npub struct WearOption {\n    pub label: &'static str,\n    pub minutes: u32,\n}\n\nconst fn w(label: &'static str, minutes: u32) -> WearOption {\n    WearOption { label, minutes }\n}\n\npub const HATS: [WearOption; 5] = [w(\"None\", 0), w(\"Sun Cap\", 3), w(\"Towel Turban\", 10), w(\"Resort Crown\", 24), w(\"Modest Halo\", 36)];\npub const BANDS: [WearOption; 3] = [w(\"None\", 0), w(\"Sweatbands\", 6), w(\"Golden Sweatbands\", 30)];\npub const BELTS: [WearOption; 3] = [w(\"None\", 0), w(\"Towel Belt\", 8), w(\"Champion Belt\", 28)];\npub const FLOATIES: [WearOption; 2] = [w(\"None\", 0), w(\"Arm Floaties\", 14)];\npub const COLOURS: [(&str, &str, u32); 8] = [\n    (\"Outfit's Own\", \"\", 0),\n    (\"Mint\", \"#78dcaa\", 2),\n    (\"Tide\", \"#46bec8\", 4),\n    (\"Coral\", \"#ff786e\", 6),\n    (\"Sun\", \"#ffd166\", 9),\n    (\"Lavender\", \"#c4b1e8\", 12),\n    (\"Ink\", \"#3c5a78\", 16),\n    (\"Towel\", \"#fbfaf6\", 20),\n];\n\n/// The guest's figure.\npub fn guest_look(g: &Guest) -> PuppetDef {\n    let (_, shirt, pants, shoes) = OUTFITS[g.outfit as usize % OUTFITS.len()];\n    let skin = SKINS[g.skin as usize % SKINS.len()];\n    let pick = |i: u8, own: &str| {\n        let c = COLOURS[i as usize % COLOURS.len()].1;\n        if c.is_empty() { own.to_string() } else { c.to_string() }\n    };\n    let mut def = PuppetDef {\n        skin: skin.into(),\n        shirt: pick(g.wear.shirt, shirt),\n        pants: pick(g.wear.pants, pants),\n        shoes: if g.golden && g.wear.shoes == 0 { \"#ffcf4a\".into() } else { pick(g.wear.shoes, shoes) },\n        ..PuppetDef::default()\n    };\n    use crate::puppet::HelmKind as H;\n    def.gear.helm = match g.wear.hat {\n        1 => H::Cap,\n        2 => H::Hood,\n        3 => H::Crown,\n        4 => H::Halo,\n        _ => H::None,\n    };\n    def.gear.helm_color = match g.wear.hat {\n        1 => \"#ff786e\".into(),\n        2 => \"#f5f2ec\".into(),\n        3 => \"#ffd166\".into(),\n        4 => \"#ffe9a0\".into(),\n        _ => def.gear.helm_color.clone(),\n    };\n    def.gear.gloves = match g.wear.bands {\n        1 => \"#fbfaf6\".into(),\n        2 => \"#ffcf4a\".into(),\n        _ => String::new(),\n    };\n    def.gear.belt = match g.wear.belt {\n        1 => \"#f5f2ec\".into(),\n        2 => \"#ffcf4a\".into(),\n        _ => String::new(),\n    };\n    if g.wear.floaties > 0 {\n        def.gear.pauldrons = 1.0;\n        def.gear.armor_color = \"#ffd166\".into();\n    }\n    def\n}\n\n/// The Balance Age formula (plan section 5).\npub fn balance_age(skill: f32, days_completed: u32, total_stars: u32, r: &super::rules::CheckRules) -> u8 {\n    let skill = skill.clamp(0.0, 1.0);\n    let age = r.age_base + r.age_range * (1.0 - skill).powf(r.age_curve)\n        - r.age_per_day * days_completed as f32\n        - (total_stars as f32 / r.age_stars_div).min(r.age_stars_cap);\n    age.round().clamp(18.0, 99.0) as u8\n}\nEOF\ncat > dialog.rs <<'EOF'\n//! Dialogue: types out with voice blips. Action completes the line, then advances.\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::frame::SimEvent;\n\n/// Who talks: voice and name.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Who {\n    #[default]\n    Pip = 0,\n    Posey = 1,\n    Kettle = 2,\n    Bounce = 3,\n    Gull = 4,\n    Marjorie = 5,\n    Tom = 6,\n    Twins = 7,\n}\n\nimpl Who {\n    pub fn name(self) -> &'static str {\n        match self {\n            Who::Pip => \"Pip\",\n            Who::Posey => \"Posey\",\n            Who::Kettle => \"Big Kettle\",\n            Who::Bounce => \"Bounce\",\n            Who::Gull => \"Commodore Gull\",\n            Who::Marjorie => \"Marjorie\",\n            Who::Tom => \"Two-Towel Tom\",\n            Who::Twins => \"The Twins\",\n        }\n    }\n    /// Letters a second at normal speed.\n    fn rate(self) -> f32 {\n        match self {\n            Who::Pip => 34.0,\n            Who::Posey => 22.0,\n            Who::Kettle => 24.0,\n            Who::Bounce => 52.0,\n            Who::Gull => 38.0,\n            Who::Marjorie => 26.0,\n            Who::Tom => 30.0,\n            Who::Twins => 40.0,\n        }\n    }\n    /// Letters per syllable.\n    fn per_syllable(self) -> usize {\n        match self {\n            Who::Bounce | Who::Gull => 2,\n            _ => 3,\n        }\n    }\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Dialog {\n    pub who: Who,\n    pub lines: Vec<String>,\n    pub i: usize,\n    /// Letters shown of line `i`.\n    pub shown: f32,\n    pub last_syllable: usize,\n    pub wait: f32,\n}\n\nimpl Dialog {\n    pub fn new(who: Who, lines: Vec<String>) -> Self {\n        Self { who, lines, ..Default::default() }\n    }\n\n    pub fn text(&self) -> &str {\n        self.lines.get(self.i).map(|s| s.as_str()).unwrap_or(\"\")\n    }\n\n    pub fn complete(&self) -> bool {\n        self.shown as usize >= self.text().chars().count()\n    }\n\n    /// Types on. `speed` is the Text Speed setting (0..2).\n    pub fn tick(&mut self, speed: u8, dt: f32, ev: &mut Vec<SimEvent>) {\n        self.wait = (self.wait - dt).max(0.0);\n        if self.complete() {\n            return;\n        }\n        let mult = [0.7, 1.0, 1.7][speed.min(2) as usize];\n        self.shown += self.who.rate() * mult * dt;\n        let n = self.shown as usize;\n        let chars: Vec<char> = self.text().chars().collect();\n        let per = self.who.per_syllable();\n        while self.last_syllable + per <= n.min(chars.len()) {\n            let at = self.last_syllable;\n            self.last_syllable += per;\n            let c = chars[(at + per - 1).min(chars.len() - 1)];\n            if c == ' ' {\n                continue;\n            }\n            let vowel = match c.to_ascii_lowercase() {\n                'a' | 'h' | 'r' | 'l' => 0,\n                'e' | 'd' | 't' | 'n' => 1,\n                'i' | 'y' | 's' | 'c' => 2,\n                'o' | 'g' | 'k' | 'w' => 3,\n                _ => 4,\n            };\n            // Pitch falls toward a full stop and rises toward a question.\n            let end = chars[(at + per + 6).min(chars.len() - 1)..].iter().find(|c| matches!(c, '.' | '?' | '!')).copied();\n            let pitch = match end {\n                Some('?') => 1.15,\n                Some('!') => 1.08,\n                Some('.') if chars.len() - at < 10 => 0.88,\n                _ => 1.0,\n            };\n            ev.push(SimEvent::Syllable { speaker: self.who as u8, vowel, pitch });\n        }\n    }\n\n    /// Action pressed: completes the line, or goes on. True when the dialogue is over.\n    pub fn advance(&mut self) -> bool {\n        if !self.complete() {\n            self.shown = self.text().chars().count() as f32;\n            self.last_syllable = self.shown as usize;\n            return false;\n        }\n        self.i += 1;\n        self.shown = 0.0;\n        self.last_syllable = 0;\n        self.wait = 0.0;\n        self.i >= self.lines.len()\n    }\n}\nEOF\ncat > ghost.rs <<'EOF'\n//! Ghosts: one pipeline for Yesterday You, Play Together and other players in an AI Hub session.\n\nuse std::sync::Arc;\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::EntityId;\nuse crate::frame::{PuppetFrame, RenderObject};\nuse crate::puppet::{PuppetDef, PuppetState};\nuse crate::shape::{Shape, Visual};\n\n/// Frames a second a run is recorded at.\npub const GHOST_HZ: f32 = 5.0;\n\n/// A moment of a run. Short names: a save holds thousands of these.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct GFrame {\n    pub p: [f32; 3],\n    pub f: f32,\n    pub l: [f32; 2],\n    pub c: u32,\n    pub t: f32,\n    pub s: f32,\n}\n\nfn r2(x: f32) -> f32 {\n    (x * 100.0).round() / 100.0\n}\n\nimpl GFrame {\n    pub fn new(p: Vec3, f: f32, l: Vec2, c: u32, t: f32, s: f32) -> Self {\n        Self { p: [r2(p.x), r2(p.y), r2(p.z)], f: r2(f), l: [r2(l.x), r2(l.y)], c, t: r2(t), s: s.round() }\n    }\n\n    pub fn lerp(&self, o: &GFrame, u: f32) -> GFrame {\n        let l = |a: f32, b: f32| a + (b - a) * u;\n        let mut d = o.f - self.f;\n        if d > std::f32::consts::PI {\n            d -= std::f32::consts::TAU;\n        } else if d < -std::f32::consts::PI {\n            d += std::f32::consts::TAU;\n        }\n        GFrame {\n            p: [l(self.p[0], o.p[0]), l(self.p[1], o.p[1]), l(self.p[2], o.p[2])],\n            f: self.f + d * u,\n            l: [l(self.l[0], o.l[0]), l(self.l[1], o.l[1])],\n            c: if u < 0.5 { self.c } else { o.c },\n            t: if o.c == self.c && o.t >= self.t { l(self.t, o.t) } else if u < 0.5 { self.t } else { o.t },\n            s: l(self.s, o.s),\n        }\n    }\n}\n\n/// A recorded run at time `t` (seconds of play).\npub fn sample(frames: &[GFrame], t: f32) -> Option<GFrame> {\n    if frames.is_empty() {\n        return None;\n    }\n    let x = (t * GHOST_HZ).max(0.0);\n    let i = x.floor() as usize;\n    if i + 1 >= frames.len() {\n        return frames.last().copied();\n    }\n    Some(frames[i].lerp(&frames[i + 1], x - i as f32))\n}\n\n/// A moment as a figure in the scene: seat-tinted, tilted, playing the recorded clip.\npub fn ghost_object(id: u32, g: &GFrame, offset: Vec3, def: &Arc<PuppetDef>, tint: [f32; 3], strength: f32) -> RenderObject {\n    let height = 1.8;\n    let feet = Vec3::from(g.p) + offset;\n    let mut state = PuppetState { facing: g.f, time: 1.0, seed: 0.3, ..Default::default() };\n    if g.c != 0 {\n        state.clip = g.c;\n        state.clip_t = g.t;\n        state.clip_w = 1.0;\n        state.clip_flags = crate::clips::CLAMP;\n    }\n    let y = g.f;\n    let side = Vec3::new(y.cos(), 0.0, -y.sin());\n    let fwd = Vec3::new(y.sin(), 0.0, y.cos());\n    let world = Vec3::new(g.l[0], 0.0, -g.l[1]) * 14f32.to_radians();\n    state.tilt_side = world.dot(side);\n    state.tilt_fwd = world.dot(fwd);\n    RenderObject {\n        id: EntityId(id),\n        pos: feet + Vec3::Y * height * 0.5,\n        rot: Quat::IDENTITY,\n        visual: Visual::new(Shape::Sphere { radius: 0.0 }, crate::color::Color::WHITE),\n        prop: None,\n        puppet: Some(PuppetFrame { state, feet_offset: height * 0.5, def: Some(def.clone()), rig: None, tint: Some((tint, strength)) }),\n        pulse: -1.0,\n        soft: None,\n        vehicle: None,\n        cone: None,\n        scenery: false,\n    }\n}\n\n/// Seat colours (players 1 to 4).\npub const SEATS: [[f32; 3]; 4] = [[0.27, 0.75, 0.78], [1.0, 0.47, 0.43], [1.0, 0.82, 0.4], [0.47, 0.86, 0.67]];\n\n/// A figure in a seat's colours.\npub fn seat_look(seat: usize) -> Arc<PuppetDef> {\n    let (_, shirt, pants, shoes) = super::meta::OUTFITS[seat % super::meta::OUTFITS.len()];\n    Arc::new(PuppetDef { shirt: shirt.into(), pants: pants.into(), shoes: shoes.into(), ..PuppetDef::default() })\n}\nEOF\ngrep -n \"pub struct EntityId\" -B3 -A3 ../../entity.rs | head -12; grep -n \"pub origin\\|pub fn extent\" -A8 ../../level.rs | head -30; grep -n \"derive\" ../../puppet.rs | sed -n 1,12p","description":"Write set helpers, script, saves, dialogue and ghost modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7790,"cache_read_input_tokens":316116,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7790},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"6c2c44ae-4e76-4633-a5fa-a452e5551e21","timestamp":"2026-11-05T05:51:33.891Z","request_id":"req_011CgjFsPCGBuFiuL4WYGQvf","wire_tool_inputs":{"toolu_01StDUa6MqAbpMiUB7XEAFLG":{"command":"cd crates/pav_core/src/games/fit && cat > world.rs <<'EOF'\n//! The sets (one room each, on one `Sim`) and small helpers that move things around in them.\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow};\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::color::Color;\nuse crate::entity::{EntityId, Spawn};\nuse crate::frame::SimEvent;\nuse crate::level::Placement;\nuse crate::params::ParamValue;\nuse crate::puppet::PuppetState;\nuse crate::room::RoomDef;\nuse crate::shape::{Shape, Visual};\nuse crate::sim::Sim;\nuse crate::world::{RoomSlot, World};\nuse crate::zones::{CameraCue, Sweep};\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Set {\n    #[default]\n    Hub = 0,\n    Studio = 1,\n    Gazebo = 2,\n    Boardwalk = 3,\n    Tide = 4,\n    Channel = 5,\n    Pier = 6,\n    Tower = 7,\n    Bay = 8,\n}\n\n/// Every set's key and text. The file is read from disk when running from `engine/`.\nconst SETS: [(&str, &str); 9] = [\n    (\"fit/sets/hub\", include_str!(\"sets/hub.toml\")),\n    (\"fit/sets/studio\", include_str!(\"sets/studio.toml\")),\n    (\"fit/sets/gazebo\", include_str!(\"sets/gazebo.toml\")),\n    (\"fit/sets/boardwalk\", include_str!(\"sets/boardwalk.toml\")),\n    (\"fit/sets/tide\", include_str!(\"sets/tide.toml\")),\n    (\"fit/sets/channel\", include_str!(\"sets/channel.toml\")),\n    (\"fit/sets/pier\", include_str!(\"sets/pier.toml\")),\n    (\"fit/sets/tower\", include_str!(\"sets/tower.toml\")),\n    (\"fit/sets/bay\", include_str!(\"sets/bay.toml\")),\n];\n\n/// Metres between set origins: far enough that fog hides each from the next.\nconst SPACING: f32 = 500.0;\n\n/// Builds all the sets into the sim's world.\npub fn load_sets(sim: &mut Sim) -> Result<()> {\n    let mut rooms = Vec::new();\n    for (i, (key, text)) in SETS.iter().enumerate() {\n        let mut def = RoomDef::parse(&super::super::level_text(key, text)).map_err(|e| anyhow!(\"{key}: {e}\"))?;\n        def.layout.origin = Vec3::new(i as f32 * SPACING, 0.0, 0.0);\n        let place = Placement::new(def.layout.origin, 0);\n        let (cols, rows) = def.layout.extent();\n        let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n        let start = def.local_start();\n        let inward = -def.entrance.facing.dir();\n        rooms.push(RoomSlot {\n            id: i as u16,\n            key: key.rsplit('/').next().unwrap_or(key).to_string(),\n            def: Arc::new(def),\n            place,\n            min,\n            max,\n            inside: place.point(start),\n            outside: place.point(start) - inward * 4.0,\n            inward,\n            built: false,\n        });\n    }\n    let n = rooms.len() as u16;\n    sim.state.world = World { enabled: false, rooms, current_room: Some(0), ..Default::default() };\n    for i in 0..n {\n        sim.build_room(i);\n    }\n    Ok(())\n}\n\n/// A set's markers named `name`.\npub fn set_markers(sim: &mut Sim, set: Set, name: &str) -> Vec<Vec3> {\n    let was = sim.state.world.current_room;\n    sim.state.world.current_room = Some(set as u16);\n    let out = crate::scenes::markers(sim, name);\n    sim.state.world.current_room = was;\n    out\n}\n\n/// Makes `set` the one on screen (its [camera] and [view] apply; the app irises to it).\npub fn show_set(sim: &mut Sim, set: Set) {\n    sim.state.world.current_room = Some(set as u16);\n}\n\npub fn current_set(sim: &Sim) -> Set {\n    match sim.state.world.current_room.unwrap_or(0) {\n        1 => Set::Studio,\n        2 => Set::Gazebo,\n        3 => Set::Boardwalk,\n        4 => Set::Tide,\n        5 => Set::Channel,\n        6 => Set::Pier,\n        7 => Set::Tower,\n        8 => Set::Bay,\n        _ => Set::Hub,\n    }\n}\n\n/// An NPC from a set's file, by name.\npub fn npc(sim: &Sim, name: &str) -> Option<EntityId> {\n    sim.state.entities.iter().find(|e| e.name == name && e.character.is_some()).map(|e| e.id)\n}\n\n/// The game's own prop copy with no collision; it stays where it is told.\npub fn spawn_prop(sim: &mut Sim, asset: &str, pos: Vec3, yaw: f32, scale: f32) -> EntityId {\n    spawn_prop_roles(sim, asset, pos, yaw, scale, &[])\n}\n\npub fn spawn_prop_roles(sim: &mut Sim, asset: &str, pos: Vec3, yaw: f32, scale: f32, roles: &[(&str, &str)]) -> EntityId {\n    let placed = crate::props::resolve_placed(asset, &crate::props::Params::new()).and_then(|(name, def, params)| {\n        let roles: BTreeMap<String, String> = roles.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();\n        crate::prop_instance::PropInstance::new(&name, def, scale, false)?.with_params(&params)?.with_roles(roles)\n    });\n    match placed.and_then(|copy| sim.place_prop(copy, pos, Quat::from_rotation_y(yaw), None)) {\n        Ok(id) => id,\n        Err(e) => {\n            log::error!(\"prop {asset}: {e}\");\n            spawn_ball(sim, \"missing\", pos, 0.2, \"#ff00ff\")\n        }\n    }\n}\n\npub fn spawn_ball(sim: &mut Sim, name: &str, pos: Vec3, radius: f32, color: &str) -> EntityId {\n    sim.spawn(Spawn::new(name, pos).visual(Visual::new(Shape::Sphere { radius }, Color::hex(color))))\n}\n\npub fn spawn_box(sim: &mut Sim, name: &str, pos: Vec3, half: Vec3, color: &str) -> EntityId {\n    sim.spawn(Spawn::new(name, pos).visual(Visual::new(Shape::RoundedBox { half, radius: half.min_element() * 0.4 }, Color::hex(color))))\n}\n\npub fn spawn_cyl(sim: &mut Sim, name: &str, pos: Vec3, half_height: f32, radius: f32, color: &str) -> EntityId {\n    sim.spawn(Spawn::new(name, pos).visual(Visual::new(Shape::Cylinder { half_height, radius }, Color::hex(color))))\n}\n\n/// Moves a no-physics entity.\npub fn pose(sim: &mut Sim, id: EntityId, pos: Vec3, rot: Quat) {\n    if let Some(e) = sim.state.entities.get_mut(id) {\n        e.pos = pos;\n        e.rot = rot;\n    }\n}\n\npub fn move_to(sim: &mut Sim, id: EntityId, pos: Vec3) {\n    if let Some(e) = sim.state.entities.get_mut(id) {\n        e.pos = pos;\n    }\n}\n\npub fn pos_of(sim: &Sim, id: EntityId) -> Vec3 {\n    sim.state.entities.get(id).map(|e| e.pos).unwrap_or(Vec3::ZERO)\n}\n\npub fn despawn_all(sim: &mut Sim, ids: &mut Vec<EntityId>) {\n    for id in ids.drain(..) {\n        sim.despawn(id);\n    }\n}\n\n/// Puts a character's feet at `feet` facing `facing` (radians, 0 = +Z).\npub fn place(sim: &mut Sim, id: EntityId, feet: Vec3, facing: f32) {\n    sim.set_position(id, feet);\n    set_facing(sim, id, facing);\n}\n\npub fn set_facing(sim: &mut Sim, id: EntityId, facing: f32) {\n    if let Some(ch) = sim.state.entities.get_mut(id).and_then(|e| e.character.as_mut()) {\n        ch.facing = facing;\n        ch.anim.facing = facing;\n    }\n}\n\npub fn anim_of(sim: &mut Sim, id: EntityId) -> Option<&mut PuppetState> {\n    sim.state.entities.get_mut(id).and_then(|e| e.character.as_mut()).map(|c| &mut c.anim)\n}\n\npub fn clip_id(name: &str) -> u32 {\n    crate::clips::find_cached(name)\n}\n\n/// Plays a looping clip (asking again keeps it going).\npub fn play(sim: &mut Sim, id: EntityId, clip: &str) {\n    let c = clip_id(clip);\n    if let Some(a) = anim_of(sim, id) {\n        a.play_clip(c, 0, 0.0);\n    }\n}\n\npub fn play_flags(sim: &mut Sim, id: EntityId, clip: &str, flags: u8, speed: f32) {\n    let c = clip_id(clip);\n    if let Some(a) = anim_of(sim, id) {\n        a.play_clip(c, flags, speed);\n    }\n}\n\n/// A one-shot gesture from its start.\npub fn gesture(sim: &mut Sim, id: EntityId, clip: &str, upper: bool) {\n    let c = clip_id(clip);\n    let flags = crate::clips::ONCE | if upper { crate::clips::UPPER } else { 0 };\n    if let Some(a) = anim_of(sim, id) {\n        a.replay_clip(c, flags, 0.0);\n    }\n}\n\n/// Holds a clip at time `t` (gameplay scrubs it).\npub fn scrub(sim: &mut Sim, id: EntityId, clip: &str, t: f32) {\n    let c = clip_id(clip);\n    if let Some(a) = anim_of(sim, id) {\n        a.play_clip(c, crate::clips::CLAMP, 1e-6);\n        a.clip_t = t;\n    }\n}\n\npub fn stop_clip(sim: &mut Sim, id: EntityId) {\n    if let Some(a) = anim_of(sim, id) {\n        a.stop_clip();\n    }\n}\n\n/// Leans the whole figure by a screen-space dot from a camera at `cam_yaw` degrees: x toward\n/// the camera's right, y away from it, `deg` degrees at full lean, plus a forward slump (radians).\npub fn lean_figure(sim: &mut Sim, id: EntityId, dot: Vec2, cam_yaw: f32, deg: f32, slump: f32) {\n    let y = cam_yaw.to_radians();\n    let right = Vec3::new(y.cos(), 0.0, y.sin());\n    let away = Vec3::new(y.sin(), 0.0, -y.cos());\n    let world = (right * dot.x + away * dot.y) * deg.to_radians();\n    if let Some(a) = anim_of(sim, id) {\n        let (s, c) = a.facing.sin_cos();\n        let fwd = Vec3::new(s, 0.0, c);\n        let side = Vec3::new(c, 0.0, -s);\n        a.tilt_side = world.dot(side);\n        a.tilt_fwd = world.dot(fwd) + slump;\n    }\n}\n\npub fn clear_lean(sim: &mut Sim, id: EntityId) {\n    if let Some(a) = anim_of(sim, id) {\n        a.tilt_side = 0.0;\n        a.tilt_fwd = 0.0;\n    }\n}\n\n/// The camera, blended over 0.7 s. Yaw 0 looks north at a figure facing +Z (the mirror view).\npub fn cam(sim: &mut Sim, tilt: f32, yaw: f32, distance: f32, fov: f32) {\n    cam_full(sim, tilt, yaw, distance, fov, 0.8, 0.12, None);\n}\n\n#[allow(clippy::too_many_arguments)]\npub fn cam_full(sim: &mut Sim, tilt: f32, yaw: f32, distance: f32, fov: f32, height: f32, lag: f32, sweep: Option<(&str, f32, f32, f32)>) {\n    let set: BTreeMap<String, ParamValue> = [\n        (\"tilt\", tilt),\n        (\"yaw\", yaw),\n        (\"distance\", distance),\n        (\"fov\", fov),\n        (\"height_offset\", height),\n        (\"follow_lag\", lag),\n    ]\n    .into_iter()\n    .map(|(k, v)| (k.to_string(), ParamValue::Float(v as f64)))\n    .collect();\n    let sweep = sweep\n        .map(|(param, from, to, period)| vec![Sweep { param: param.to_string(), from, to, period, phase: 0.0 }])\n        .unwrap_or_default();\n    let c = &mut sim.state.courses;\n    c.sticky_cue = Some(Arc::new(CameraCue { set, sweep, flip_ortho: 0.0 }));\n    c.cue_serial += 1;\n}\n\n/// A slow orbit (result screens, the title's sweep).\npub fn cam_orbit(sim: &mut Sim, tilt: f32, distance: f32, fov: f32, height: f32, from: f32, to: f32, period: f32) {\n    cam_full(sim, tilt, from, distance, fov, height, 0.2, Some((\"yaw\", from, to, period)));\n}\n\n/// Lighting per state: view paths over the set's own `[view]`.\npub fn view_over(sim: &mut Sim, pairs: &[(&str, f64)]) {\n    let c = &mut sim.state.courses;\n    c.view = pairs.iter().map(|(k, v)| (k.to_string(), ParamValue::Float(*v))).collect();\n    c.view_serial += 1;\n}\n\npub fn sfx(ev: &mut Vec<SimEvent>, id: u16, gain: f32, pitch: f32) {\n    ev.push(SimEvent::Sfx { id, gain, pitch });\n}\n\npub fn clamp01(x: f32) -> f32 {\n    x.clamp(0.0, 1.0)\n}\n\npub fn smooth(x: f32) -> f32 {\n    let t = clamp01(x);\n    t * t * (3.0 - 2.0 * t)\n}\n\n/// Sound bank ids (`pav_audio::sfx_bank` plays them).\npub mod sound {\n    pub const UI_MOVE: u16 = 0;\n    pub const UI_CONFIRM: u16 = 1;\n    pub const UI_BACK: u16 = 2;\n    pub const STAMP: u16 = 3;\n    pub const CLAM: u16 = 4;\n    pub const AGE_TICK: u16 = 5;\n    pub const STEP: u16 = 6;\n    pub const PIP_SQUEAK: u16 = 7;\n    pub const CREAK: u16 = 8;\n    pub const SPLASH_S: u16 = 9;\n    pub const SPLASH_B: u16 = 10;\n    pub const GULL: u16 = 11;\n    pub const CROWD: u16 = 12;\n    pub const CLAP: u16 = 13;\n    pub const GONG: u16 = 14;\n    pub const BELL: u16 = 15;\n    pub const WHOOSH: u16 = 16;\n    pub const SHELL_ROLL: u16 = 17;\n    pub const SHELL_PLOP: u16 = 18;\n    pub const GLASS_PLOP: u16 = 19;\n    pub const CONFETTI: u16 = 20;\n    pub const GUST: u16 = 21;\n    pub const WAVE: u16 = 22;\n    pub const SEA: u16 = 23;\n    pub const TONE: u16 = 24;\n    pub const CHIME: u16 = 25;\n    pub const TICK: u16 = 26;\n    pub const STAR: u16 = 27;\n    pub const FANFARE: u16 = 28;\n    pub const SAD: u16 = 29;\n    pub const REVEAL: u16 = 30;\n    pub const GROAN: u16 = 31;\n    pub const CATCH: u16 = 32;\n    pub const HIT_GOOD: u16 = 33;\n    pub const HIT_PERFECT: u16 = 34;\n    pub const MISS: u16 = 35;\n    pub const COUNT: u16 = 36;\n    pub const GO: u16 = 37;\n    pub const BOARD: u16 = 38;\n    pub const STITCH: u16 = 39;\n    pub const RIBBON: u16 = 40;\n    pub const BUMP: u16 = 41;\n    pub const HEARTBEAT: u16 = 42;\n    /// How many ids there are.\n    pub const TOTAL: u16 = 43;\n}\n\n/// Songs (`pav_audio::music`).\npub mod song {\n    pub const NONE: u8 = 0;\n    pub const LOBBY: u8 = 1;\n    pub const TIDE: u8 = 2;\n    pub const WALTZ: u8 = 3;\n    pub const STEP: u8 = 4;\n    pub const MALLETS: u8 = 5;\n    pub const BAND: u8 = 6;\n}\nEOF\ncat > script.rs <<'EOF'\n//! All the game's words, in `script.toml`: named lists of lines. Tests lint them.\n\nuse std::collections::BTreeMap;\nuse std::sync::{OnceLock, RwLock};\n\n/// Named lists of lines.\npub type Lines = BTreeMap<String, Vec<String>>;\n\nstatic SCRIPT: OnceLock<RwLock<Lines>> = OnceLock::new();\n\nfn cell() -> &'static RwLock<Lines> {\n    SCRIPT.get_or_init(|| RwLock::new(parse(include_str!(\"script.toml\"))))\n}\n\nfn parse(text: &str) -> Lines {\n    toml::from_str(text).unwrap_or_else(|e| {\n        log::error!(\"script.toml: {e}\");\n        Lines::new()\n    })\n}\n\n/// Re-reads the words (the disk's copy when running from the repository).\npub fn reload() {\n    let text = super::super::level_text(\"fit/script\", include_str!(\"script.toml\"));\n    *cell().write().unwrap() = parse(&text);\n}\n\n/// The whole table (tests).\npub fn all() -> Lines {\n    cell().read().unwrap().clone()\n}\n\n/// Line `i` (wrapping) of list `key`.\npub fn line(key: &str, i: usize) -> String {\n    let s = cell().read().unwrap();\n    match s.get(key) {\n        Some(list) if !list.is_empty() => list[i % list.len()].clone(),\n        _ => {\n            log::error!(\"script: no lines for {key}\");\n            String::new()\n        }\n    }\n}\n\n/// How many lines a list has.\npub fn count(key: &str) -> usize {\n    cell().read().unwrap().get(key).map(|l| l.len()).unwrap_or(0)\n}\n\n/// A whole list.\npub fn list(key: &str) -> Vec<String> {\n    cell().read().unwrap().get(key).cloned().unwrap_or_default()\n}\n\n/// A line with `{word}`s filled in.\npub fn fill(text: &str, vars: &[(&str, String)]) -> String {\n    let mut s = text.to_string();\n    for (k, v) in vars {\n        s = s.replace(&format!(\"{{{k}}}\"), v);\n    }\n    s\n}\nEOF\ncat > meta.rs <<'EOF'\n//! What persists: settings, guest slots, personal bests, ghosts. Versioned JSON the page keeps\n//! in `localStorage`.\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\nuse super::ghost::GFrame;\nuse crate::puppet::PuppetDef;\n\npub const SAVE_VERSION: u32 = 1;\npub const SLOTS: usize = 4;\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Settings {\n    pub music: f32,\n    pub sfx: f32,\n    pub voice: f32,\n    pub xbox: bool,\n    pub lean_sens: f32,\n    pub assist: f32,\n    pub rhythm_offset: f32,\n    pub text_speed: u8,\n}\n\nimpl Default for Settings {\n    fn default() -> Self {\n        Self { music: 0.10, sfx: 0.80, voice: 0.80, xbox: false, lean_sens: 1.0, assist: 0.0, rhythm_offset: 0.10, text_speed: 1 }\n    }\n}\n\n/// What the guest wears beyond the outfit.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Wear {\n    pub hat: u8,\n    pub bands: u8,\n    pub belt: u8,\n    pub floaties: u8,\n    pub shirt: u8,\n    pub pants: u8,\n    pub shoes: u8,\n}\n\n/// One guest's stay.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Guest {\n    pub name: String,\n    pub skin: u8,\n    pub outfit: u8,\n    pub wear: Wear,\n    /// The day of the stay, 1 to 5.\n    pub day: u8,\n    /// Days finished (stamps).\n    pub stamps: u8,\n    pub minutes: u32,\n    pub minutes_today: u32,\n    /// Stars and scores per event key.\n    pub stars: BTreeMap<String, u8>,\n    pub bests: BTreeMap<String, u32>,\n    pub best_ghost: BTreeMap<String, Vec<GFrame>>,\n    /// Events cleared today.\n    pub today: Vec<String>,\n    /// Morning ages, one per day checked.\n    pub ages: Vec<u8>,\n    /// Morning check done today.\n    pub checked: bool,\n    /// Lost flip-flops found (bits), and given to Tom.\n    pub flipflops: u8,\n    pub golden: bool,\n    /// 0 still on the stay; 1 checked out; 2 extended stay. Both open Free Play.\n    pub ending: u8,\n    pub final_age: u8,\n    /// The day number (days since 1970) last played.\n    pub last_date: i64,\n    pub total_wobbles: u32,\n    pub played: Vec<String>,\n    /// Talked to these people today (keys).\n    pub talked: Vec<String>,\n    pub titles: u32,\n    pub free_days: u32,\n}\n\nimpl Guest {\n    pub fn total_stars(&self) -> u32 {\n        self.stars.values().map(|&s| s as u32).sum()\n    }\n    pub fn free_play(&self) -> bool {\n        self.ending != 0\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct SaveData {\n    pub version: u32,\n    pub settings: Settings,\n    pub slots: Vec<Option<Guest>>,\n}\n\nimpl Default for SaveData {\n    fn default() -> Self {\n        Self { version: SAVE_VERSION, settings: Settings::default(), slots: vec![None; SLOTS] }\n    }\n}\n\nimpl SaveData {\n    /// Reads a save, or `None` when it isn't one (or comes from a newer version).\n    pub fn parse(text: &str) -> Option<SaveData> {\n        let mut s: SaveData = serde_json::from_str(text).ok()?;\n        if s.version > SAVE_VERSION {\n            return None;\n        }\n        s.version = SAVE_VERSION;\n        s.slots.resize(SLOTS, None);\n        Some(s)\n    }\n    pub fn to_json(&self) -> String {\n        serde_json::to_string(self).unwrap_or_default()\n    }\n}\n\npub const SKINS: [&str; 6] = [\"#f6d7b8\", \"#eebd94\", \"#d9a074\", \"#b97f54\", \"#8c5a3a\", \"#5f3d29\"];\n\n/// Name, shirt, pants, shoes.\npub const OUTFITS: [(&str, &str, &str, &str); 8] = [\n    (\"Resort Mint\", \"#78dcaa\", \"#f4f1e8\", \"#46bec8\"),\n    (\"Tide Blue\", \"#46bec8\", \"#263e54\", \"#f4f1e8\"),\n    (\"Coral Reef\", \"#ff786e\", \"#f4f1e8\", \"#ffd166\"),\n    (\"Sun Yellow\", \"#ffd166\", \"#46bec8\", \"#ff786e\"),\n    (\"Towel White\", \"#fbfaf6\", \"#fbfaf6\", \"#d9d4c5\"),\n    (\"Lavender Calm\", \"#c4b1e8\", \"#f4f1e8\", \"#8a78b8\"),\n    (\"Sand Dollar\", \"#e8d4a8\", \"#a08a60\", \"#f4f1e8\"),\n    (\"Ink Sensible\", \"#3c5a78\", \"#263e54\", \"#fbfaf6\"),\n];\n\n/// One wardrobe row's options: a label and the minutes that unlock it.\npub struct WearOption {\n    pub label: &'static str,\n    pub minutes: u32,\n}\n\nconst fn w(label: &'static str, minutes: u32) -> WearOption {\n    WearOption { label, minutes }\n}\n\npub const HATS: [WearOption; 5] = [w(\"None\", 0), w(\"Sun Cap\", 3), w(\"Towel Turban\", 10), w(\"Resort Crown\", 24), w(\"Modest Halo\", 36)];\npub const BANDS: [WearOption; 3] = [w(\"None\", 0), w(\"Sweatbands\", 6), w(\"Golden Sweatbands\", 30)];\npub const BELTS: [WearOption; 3] = [w(\"None\", 0), w(\"Towel Belt\", 8), w(\"Champion Belt\", 28)];\npub const FLOATIES: [WearOption; 2] = [w(\"None\", 0), w(\"Arm Floaties\", 14)];\npub const COLOURS: [(&str, &str, u32); 8] = [\n    (\"Outfit's Own\", \"\", 0),\n    (\"Mint\", \"#78dcaa\", 2),\n    (\"Tide\", \"#46bec8\", 4),\n    (\"Coral\", \"#ff786e\", 6),\n    (\"Sun\", \"#ffd166\", 9),\n    (\"Lavender\", \"#c4b1e8\", 12),\n    (\"Ink\", \"#3c5a78\", 16),\n    (\"Towel\", \"#fbfaf6\", 20),\n];\n\n/// The guest's figure.\npub fn guest_look(g: &Guest) -> PuppetDef {\n    let (_, shirt, pants, shoes) = OUTFITS[g.outfit as usize % OUTFITS.len()];\n    let skin = SKINS[g.skin as usize % SKINS.len()];\n    let pick = |i: u8, own: &str| {\n        let c = COLOURS[i as usize % COLOURS.len()].1;\n        if c.is_empty() { own.to_string() } else { c.to_string() }\n    };\n    let mut def = PuppetDef {\n        skin: skin.into(),\n        shirt: pick(g.wear.shirt, shirt),\n        pants: pick(g.wear.pants, pants),\n        shoes: if g.golden && g.wear.shoes == 0 { \"#ffcf4a\".into() } else { pick(g.wear.shoes, shoes) },\n        ..PuppetDef::default()\n    };\n    use crate::puppet::HelmKind as H;\n    def.gear.helm = match g.wear.hat {\n        1 => H::Cap,\n        2 => H::Hood,\n        3 => H::Crown,\n        4 => H::Halo,\n        _ => H::None,\n    };\n    def.gear.helm_color = match g.wear.hat {\n        1 => \"#ff786e\".into(),\n        2 => \"#f5f2ec\".into(),\n        3 => \"#ffd166\".into(),\n        4 => \"#ffe9a0\".into(),\n        _ => def.gear.helm_color.clone(),\n    };\n    def.gear.gloves = match g.wear.bands {\n        1 => \"#fbfaf6\".into(),\n        2 => \"#ffcf4a\".into(),\n        _ => String::new(),\n    };\n    def.gear.belt = match g.wear.belt {\n        1 => \"#f5f2ec\".into(),\n        2 => \"#ffcf4a\".into(),\n        _ => String::new(),\n    };\n    if g.wear.floaties > 0 {\n        def.gear.pauldrons = 1.0;\n        def.gear.armor_color = \"#ffd166\".into();\n    }\n    def\n}\n\n/// The Balance Age formula (plan section 5).\npub fn balance_age(skill: f32, days_completed: u32, total_stars: u32, r: &super::rules::CheckRules) -> u8 {\n    let skill = skill.clamp(0.0, 1.0);\n    let age = r.age_base + r.age_range * (1.0 - skill).powf(r.age_curve)\n        - r.age_per_day * days_completed as f32\n        - (total_stars as f32 / r.age_stars_div).min(r.age_stars_cap);\n    age.round().clamp(18.0, 99.0) as u8\n}\nEOF\ncat > dialog.rs <<'EOF'\n//! Dialogue: types out with voice blips. Action completes the line, then advances.\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::frame::SimEvent;\n\n/// Who talks: voice and name.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Who {\n    #[default]\n    Pip = 0,\n    Posey = 1,\n    Kettle = 2,\n    Bounce = 3,\n    Gull = 4,\n    Marjorie = 5,\n    Tom = 6,\n    Twins = 7,\n}\n\nimpl Who {\n    pub fn name(self) -> &'static str {\n        match self {\n            Who::Pip => \"Pip\",\n            Who::Posey => \"Posey\",\n            Who::Kettle => \"Big Kettle\",\n            Who::Bounce => \"Bounce\",\n            Who::Gull => \"Commodore Gull\",\n            Who::Marjorie => \"Marjorie\",\n            Who::Tom => \"Two-Towel Tom\",\n            Who::Twins => \"The Twins\",\n        }\n    }\n    /// Letters a second at normal speed.\n    fn rate(self) -> f32 {\n        match self {\n            Who::Pip => 34.0,\n            Who::Posey => 22.0,\n            Who::Kettle => 24.0,\n            Who::Bounce => 52.0,\n            Who::Gull => 38.0,\n            Who::Marjorie => 26.0,\n            Who::Tom => 30.0,\n            Who::Twins => 40.0,\n        }\n    }\n    /// Letters per syllable.\n    fn per_syllable(self) -> usize {\n        match self {\n            Who::Bounce | Who::Gull => 2,\n            _ => 3,\n        }\n    }\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Dialog {\n    pub who: Who,\n    pub lines: Vec<String>,\n    pub i: usize,\n    /// Letters shown of line `i`.\n    pub shown: f32,\n    pub last_syllable: usize,\n    pub wait: f32,\n}\n\nimpl Dialog {\n    pub fn new(who: Who, lines: Vec<String>) -> Self {\n        Self { who, lines, ..Default::default() }\n    }\n\n    pub fn text(&self) -> &str {\n        self.lines.get(self.i).map(|s| s.as_str()).unwrap_or(\"\")\n    }\n\n    pub fn complete(&self) -> bool {\n        self.shown as usize >= self.text().chars().count()\n    }\n\n    /// Types on. `speed` is the Text Speed setting (0..2).\n    pub fn tick(&mut self, speed: u8, dt: f32, ev: &mut Vec<SimEvent>) {\n        self.wait = (self.wait - dt).max(0.0);\n        if self.complete() {\n            return;\n        }\n        let mult = [0.7, 1.0, 1.7][speed.min(2) as usize];\n        self.shown += self.who.rate() * mult * dt;\n        let n = self.shown as usize;\n        let chars: Vec<char> = self.text().chars().collect();\n        let per = self.who.per_syllable();\n        while self.last_syllable + per <= n.min(chars.len()) {\n            let at = self.last_syllable;\n            self.last_syllable += per;\n            let c = chars[(at + per - 1).min(chars.len() - 1)];\n            if c == ' ' {\n                continue;\n            }\n            let vowel = match c.to_ascii_lowercase() {\n                'a' | 'h' | 'r' | 'l' => 0,\n                'e' | 'd' | 't' | 'n' => 1,\n                'i' | 'y' | 's' | 'c' => 2,\n                'o' | 'g' | 'k' | 'w' => 3,\n                _ => 4,\n            };\n            // Pitch falls toward a full stop and rises toward a question.\n            let end = chars[(at + per + 6).min(chars.len() - 1)..].iter().find(|c| matches!(c, '.' | '?' | '!')).copied();\n            let pitch = match end {\n                Some('?') => 1.15,\n                Some('!') => 1.08,\n                Some('.') if chars.len() - at < 10 => 0.88,\n                _ => 1.0,\n            };\n            ev.push(SimEvent::Syllable { speaker: self.who as u8, vowel, pitch });\n        }\n    }\n\n    /// Action pressed: completes the line, or goes on. True when the dialogue is over.\n    pub fn advance(&mut self) -> bool {\n        if !self.complete() {\n            self.shown = self.text().chars().count() as f32;\n            self.last_syllable = self.shown as usize;\n            return false;\n        }\n        self.i += 1;\n        self.shown = 0.0;\n        self.last_syllable = 0;\n        self.wait = 0.0;\n        self.i >= self.lines.len()\n    }\n}\nEOF\ncat > ghost.rs <<'EOF'\n//! Ghosts: one pipeline for Yesterday You, Play Together and other players in an AI Hub session.\n\nuse std::sync::Arc;\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::EntityId;\nuse crate::frame::{PuppetFrame, RenderObject};\nuse crate::puppet::{PuppetDef, PuppetState};\nuse crate::shape::{Shape, Visual};\n\n/// Frames a second a run is recorded at.\npub const GHOST_HZ: f32 = 5.0;\n\n/// A moment of a run. Short names: a save holds thousands of these.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct GFrame {\n    pub p: [f32; 3],\n    pub f: f32,\n    pub l: [f32; 2],\n    pub c: u32,\n    pub t: f32,\n    pub s: f32,\n}\n\nfn r2(x: f32) -> f32 {\n    (x * 100.0).round() / 100.0\n}\n\nimpl GFrame {\n    pub fn new(p: Vec3, f: f32, l: Vec2, c: u32, t: f32, s: f32) -> Self {\n        Self { p: [r2(p.x), r2(p.y), r2(p.z)], f: r2(f), l: [r2(l.x), r2(l.y)], c, t: r2(t), s: s.round() }\n    }\n\n    pub fn lerp(&self, o: &GFrame, u: f32) -> GFrame {\n        let l = |a: f32, b: f32| a + (b - a) * u;\n        let mut d = o.f - self.f;\n        if d > std::f32::consts::PI {\n            d -= std::f32::consts::TAU;\n        } else if d < -std::f32::consts::PI {\n            d += std::f32::consts::TAU;\n        }\n        GFrame {\n            p: [l(self.p[0], o.p[0]), l(self.p[1], o.p[1]), l(self.p[2], o.p[2])],\n            f: self.f + d * u,\n            l: [l(self.l[0], o.l[0]), l(self.l[1], o.l[1])],\n            c: if u < 0.5 { self.c } else { o.c },\n            t: if o.c == self.c && o.t >= self.t { l(self.t, o.t) } else if u < 0.5 { self.t } else { o.t },\n            s: l(self.s, o.s),\n        }\n    }\n}\n\n/// A recorded run at time `t` (seconds of play).\npub fn sample(frames: &[GFrame], t: f32) -> Option<GFrame> {\n    if frames.is_empty() {\n        return None;\n    }\n    let x = (t * GHOST_HZ).max(0.0);\n    let i = x.floor() as usize;\n    if i + 1 >= frames.len() {\n        return frames.last().copied();\n    }\n    Some(frames[i].lerp(&frames[i + 1], x - i as f32))\n}\n\n/// A moment as a figure in the scene: seat-tinted, tilted, playing the recorded clip.\npub fn ghost_object(id: u32, g: &GFrame, offset: Vec3, def: &Arc<PuppetDef>, tint: [f32; 3], strength: f32) -> RenderObject {\n    let height = 1.8;\n    let feet = Vec3::from(g.p) + offset;\n    let mut state = PuppetState { facing: g.f, time: 1.0, seed: 0.3, ..Default::default() };\n    if g.c != 0 {\n        state.clip = g.c;\n        state.clip_t = g.t;\n        state.clip_w = 1.0;\n        state.clip_flags = crate::clips::CLAMP;\n    }\n    let y = g.f;\n    let side = Vec3::new(y.cos(), 0.0, -y.sin());\n    let fwd = Vec3::new(y.sin(), 0.0, y.cos());\n    let world = Vec3::new(g.l[0], 0.0, -g.l[1]) * 14f32.to_radians();\n    state.tilt_side = world.dot(side);\n    state.tilt_fwd = world.dot(fwd);\n    RenderObject {\n        id: EntityId(id),\n        pos: feet + Vec3::Y * height * 0.5,\n        rot: Quat::IDENTITY,\n        visual: Visual::new(Shape::Sphere { radius: 0.0 }, crate::color::Color::WHITE),\n        prop: None,\n        puppet: Some(PuppetFrame { state, feet_offset: height * 0.5, def: Some(def.clone()), rig: None, tint: Some((tint, strength)) }),\n        pulse: -1.0,\n        soft: None,\n        vehicle: None,\n        cone: None,\n        scenery: false,\n    }\n}\n\n/// Seat colours (players 1 to 4).\npub const SEATS: [[f32; 3]; 4] = [[0.27, 0.75, 0.78], [1.0, 0.47, 0.43], [1.0, 0.82, 0.4], [0.47, 0.86, 0.67]];\n\n/// A figure in a seat's colours.\npub fn seat_look(seat: usize) -> Arc<PuppetDef> {\n    let (_, shirt, pants, shoes) = super::meta::OUTFITS[seat % super::meta::OUTFITS.len()];\n    Arc::new(PuppetDef { shirt: shirt.into(), pants: pants.into(), shoes: shoes.into(), ..PuppetDef::default() })\n}\nEOF\ngrep -n \"pub struct EntityId\" -B3 -A3 ../../entity.rs | head -12; grep -n \"pub origin\\|pub fn extent\" -A8 ../../level.rs | head -30; grep -n \"derive\" ../../puppet.rs | sed -n 1,12p","description":"Write set helpers, script, saves, dialogue and ghost modules"}}}
