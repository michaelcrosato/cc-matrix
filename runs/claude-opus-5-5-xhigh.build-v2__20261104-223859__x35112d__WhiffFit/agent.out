ad drops the card.\n    sim.step(&InputFrame { any: true, ..Default::default() });\n    assert!(!game(&sim).boot.touch_only);\n}\n'''\nopen('crates/pav_core/tests/fit.rs','w').write(s)\nEOF\nrm -f ../tests/dbg.py; timeout 300 cargo test --locked -q -p pav_core --test fit touch_only --message-format=short 2>&1 | grep -E \"^crates.*error|^error|FAILED|panicked|test result\" | cut -c1-280 | head -6","description":"Fix attract bot on touch card and add a test","timeout":320000}},"wire_ingest_context":{"toolu_0146HV5BjFHcU3RoCeygj5sb":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859/engine"}}}
