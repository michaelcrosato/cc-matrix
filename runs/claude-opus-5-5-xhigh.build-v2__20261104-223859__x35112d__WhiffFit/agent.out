{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjJLjMTRnseq9Sr8Pzao","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011gAGqK2CQLFH3XEaakiCNt","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859 && cat > tools/make_clips.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Writes engine/anim/fit.json: the game's hand-keyed clips, as readable key poses.\nField meanings are in LEGEND at the top of engine/crates/pav_core/src/clips.rs.\"\"\"\nimport json, pathlib, copy\nROOT = pathlib.Path(__file__).resolve().parent.parent / \"engine/anim\"\nSTAND = {\"hips\": [0, 0, 100], \"body\": [0, 0, 0], \"chest\": [0, 0, 0], \"head\": [0, 0, 0],\n         \"armL\": [10, 10, -95, 10, 0], \"armR\": [10, 10, -95, 10, 0],\n         \"legL\": [0, 6, -100, 0, 0], \"legR\": [0, 6, -100, 0, 0]}\ndef k(t, **o):\n    d = copy.deepcopy(STAND); d.update(o); d[\"t\"] = t\n    return d\ndef clip(name, dur, loop, tags, desc, keys):\n    return name, {\"clip\": name, \"dur\": dur, \"loop\": loop, \"tags\": tags, \"desc\": desc, \"keys\": keys}\ndef hold(name, desc, **pose):\n    return clip(name, 2.0, True, [\"pose\"], desc, [k(0, **pose), k(1.0, **{**pose, \"hips\": [pose.get(\"hips\", [0, 0, 100])[0], pose.get(\"hips\", [0, 0, 100])[1], pose.get(\"hips\", [0, 0, 100])[2] - 1]}), k(2.0, **pose)])\n\nm2m = json.load(open(ROOT / \"mesh2motion.json\"))[\"clips\"]\nplank = copy.deepcopy(m2m[\"Pushup\"][\"keys\"][0])\nstyle = json.load(open(ROOT / \"style100.json\"))[\"clips\"]\ncarry_arms = {\"armL\": [95, 12, 5, 72, 0], \"armR\": [95, 12, 5, 72, 0]}\ntray_keys = []\nfor key in style[\"Balance_Walk\"][\"keys\"]:\n    kk = copy.deepcopy(key)\n    kk.update(carry_arms)\n    kk[\"chest\"] = [0, -3, 0]\n    kk[\"head\"] = [0, 5, 0]\n    kk[\"shL\"] = [0, 0]\n    kk[\"shR\"] = [0, 0]\n    tray_keys.append(kk)\nflop_low = copy.deepcopy(plank); flop_low[\"hips\"] = [-7, 0, 14]; flop_low[\"body\"] = [0, 84, 0]; flop_low[\"armL\"] = [40, 80, -10, 20, 0]; flop_low[\"armR\"] = [40, 80, -10, 20, 0]; flop_low[\"head\"] = [0, -6, 8]\n\nclips = dict([\n    clip(\"Breath\", 1.0, False, [\"exercise\"], \"Exhaled to inhaled; scrub clip time with the lungs.\", [\n        k(0, chest=[0, 8, 0], head=[0, 8, 0], armL=[20, 18, -85, 20, 0], armR=[20, 18, -85, 20, 0]),\n        k(1.0, hips=[0, 0, 102], chest=[0, -8, 0], head=[0, -8, 0], armL=[0, 80, 62, 10, 0], armR=[0, 80, 62, 10, 0])]),\n    clip(\"Squat\", 1.0, False, [\"exercise\"], \"Stand to deep squat; scrub clip time with depth.\", [\n        k(0, armL=[10, 10, -95, 10, 0], armR=[10, 10, -95, 10, 0]),\n        k(1.0, hips=[-22, 0, 58], body=[0, 28, 0], chest=[0, 5, 0], head=[0, -22, 0], armL=[100, 4, 10, 0, 0], armR=[100, 4, 10, 0, 0],\n          legL=[55, 10, -60, 95, 0], legR=[55, 10, -60, 95, 0], footL=[-12, 0, 0], footR=[-12, 0, 0])]),\n    hold(\"Tree\", \"The Patient Heron: one foot on the other knee, palms up overhead.\",\n         hips=[0, 3, 98], body=[0, 0, -2], armL=[6, -6, 100, 25, 0], armR=[6, -6, 100, 25, 0],\n         legL=[6, 30, -55, 115, 62], legR=[0, 1, -100, 0, 0], footL=[35, 0, 0]),\n    hold(\"Warrior\", \"The Apologetic Lunge: deep lunge, arms out.\",\n         hips=[0, 0, 72], body=[35, 0, 0], chest=[-35, -4, 0], head=[-30, 8, 0], armL=[0, 100, 0, 0, 0], armR=[0, 100, 0, 0, 0],\n         legL=[70, 0, -55, 95, 0], legR=[-85, 20, -60, 0, 0], footR=[10, 40, 0]),\n    hold(\"Lighthouse\", \"The Tired Lighthouse: one arm up like a beam, head sagging.\",\n         hips=[0, -3, 100], body=[0, 0, -6], chest=[0, 0, -8], head=[0, 22, 10], armR=[0, 18, 100, 5, 0], armL=[0, 8, -100, 18, 0],\n         legL=[0, 8, -100, 2, 0], legR=[0, 4, -100, 0, 0]),\n    hold(\"DeckChair\", \"The Folded Deck Chair: folded in half, hands near the feet.\",\n         hips=[-18, 0, 76], body=[0, 88, 0], chest=[0, 14, 0], head=[0, 8, 0], armL=[56, 8, -90, 0, 0], armR=[56, 8, -90, 0, 0],\n         legL=[6, 6, -100, 28, 0], legR=[6, 6, -100, 28, 0]),\n    hold(\"Bridge\", \"The Reluctant Bridge: an arched back, arms flung back without enthusiasm.\",\n         hips=[14, 0, 92], body=[0, -28, 0], chest=[0, -24, 0], head=[0, -18, 0], armL=[-34, 12, 100, 8, 0], armR=[-34, 12, 100, 8, 0],\n         legL=[8, 8, -100, 22, 0], legR=[8, 8, -100, 22, 0]),\n    hold(\"Seated\", \"Seated Disappointment: cross-legged on the floor, looking at the floor.\",\n         hips=[0, 0, 26], body=[0, 16, 0], chest=[0, 18, 0], head=[0, 30, 0], armL=[42, 16, -70, 44, 0], armR=[42, 16, -70, 44, 0],\n         legL=[76, 44, -6, 128, 0], legR=[76, 44, -6, 128, 0], footL=[0, 30, 0], footR=[0, 30, 0]),\n    clip(\"Plank\", 1.0, True, [\"exercise\"], \"A held plank (from one frame of MESH2MOTION/Pushup).\", [dict(plank, t=0), dict(plank, t=1.0)]),\n    clip(\"Flop\", 1.0, False, [\"exercise\"], \"From a plank to flat on the floor; scrub clip time.\", [dict(plank, t=0), dict(flop_low, t=1.0)]),\n    clip(\"ArmFlail\", 0.7, True, [\"upper\"], \"Arms windmilling for balance (upper body).\", [\n        k(0, armL=[10, 90, 40, 12, 0], armR=[10, 90, -30, 12, 0], chest=[0, 0, 4]),\n        k(0.35, armL=[10, 90, -30, 12, 0], armR=[10, 90, 40, 12, 0], chest=[0, 0, -4]),\n        k(0.7, armL=[10, 90, 40, 12, 0], armR=[10, 90, -30, 12, 0], chest=[0, 0, 4])]),\n    clip(\"Stumble\", 0.95, False, [\"fall\"], \"A stumble and a recovery.\", [\n        k(0),\n        k(0.22, hips=[10, 0, 90], body=[0, 26, 0], chest=[0, 10, 0], armL=[60, 50, 20, 20, 0], armR=[60, 50, 20, 20, 0], legL=[26, 6, -90, 30, 0], legR=[-16, 6, -96, 10, 0]),\n        k(0.55, hips=[16, 0, 78], body=[0, 42, 0], chest=[0, 8, 0], head=[0, -12, 0], armL=[40, 90, 10, 10, 0], armR=[40, 90, -20, 10, 0], legL=[50, 8, -70, 70, 0], legR=[-26, 6, -92, 14, 0]),\n        k(0.95)]),\n    clip(\"StepL\", 0.42, False, [\"step\"], \"A left step up and down.\", [\n        k(0), k(0.14, hips=[0, 2, 104], legL=[34, 6, -84, 54, 0], armR=[30, 12, -80, 24, 0]), k(0.42)]),\n    clip(\"StepR\", 0.42, False, [\"step\"], \"A right step up and down.\", [\n        k(0), k(0.14, hips=[0, -2, 104], legR=[34, 6, -84, 54, 0], armL=[30, 12, -80, 24, 0]), k(0.42)]),\n    clip(\"HipCircle\", 1.0, True, [\"dance\"], \"Hips going round; scrub clip time with the spin.\", [\n        k(0, hips=[0, 9, 98], body=[0, 0, 7], chest=[0, 0, -7], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(0.25, hips=[9, 0, 98], body=[0, -6, 0], chest=[0, 6, 0], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(0.5, hips=[0, -9, 98], body=[0, 0, -7], chest=[0, 0, 7], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(0.75, hips=[-9, 0, 98], body=[0, 6, 0], chest=[0, -6, 0], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(1.0, hips=[0, 9, 98], body=[0, 0, 7], chest=[0, 0, -7], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0])]),\n    clip(\"CarryTray\", 1.0, True, [\"upper\"], \"Both hands out under a tray (upper body).\", [k(0, **carry_arms), k(1.0, **carry_arms)]),\n    clip(\"TrayWalk\", style[\"Balance_Walk\"][\"dur\"], True, [\"walk\"], \"STYLE100/Balance_Walk's legs with CarryTray's arms.\", tray_keys),\n    clip(\"Paddle\", 2.0, True, [\"water\"], \"Standing on a board, knees soft, arms out low.\", [\n        k(0, hips=[0, 0, 94], armL=[30, 40, -50, 30, 0], armR=[30, 40, -50, 30, 0], legL=[4, 14, -96, 18, 0], legR=[4, 14, -96, 18, 0]),\n        k(1.0, hips=[0, 2, 95], body=[0, 0, 2], armL=[30, 44, -44, 30, 0], armR=[30, 36, -54, 30, 0], legL=[4, 14, -96, 18, 0], legR=[4, 14, -96, 18, 0]),\n        k(2.0, hips=[0, 0, 94], armL=[30, 40, -50, 30, 0], armR=[30, 40, -50, 30, 0], legL=[4, 14, -96, 18, 0], legR=[4, 14, -96, 18, 0])]),\n    clip(\"Tuck\", 1.0, False, [\"dive\"], \"Open to tucked; scrub clip time with the tuck.\", [\n        k(0, armL=[0, 40, 60, 10, 0], armR=[0, 40, 60, 10, 0]),\n        k(1.0, hips=[0, 0, 62], body=[0, 44, 0], chest=[0, 22, 0], head=[0, 28, 0], armL=[80, 2, -24, 102, 0], armR=[80, 2, -24, 102, 0],\n          legL=[86, 8, 8, 132, 0], legR=[86, 8, 8, 132, 0], footL=[35, 0, 0], footR=[35, 0, 0])]),\n    clip(\"DiveEntry\", 1.0, True, [\"dive\"], \"Arms overhead, straight as a pencil.\", [\n        k(0, armL=[0, 0, 100, 0, 0], armR=[0, 0, 100, 0, 0], legL=[0, 2, -100, 0, 0], legR=[0, 2, -100, 0, 0]),\n        k(1.0, armL=[0, 0, 100, 0, 0], armR=[0, 0, 100, 0, 0], legL=[0, 2, -100, 0, 0], legR=[0, 2, -100, 0, 0])]),\n    clip(\"Tread\", 1.2, True, [\"water\"], \"Treading water, arms sculling.\", [\n        k(0, armL=[30, 70, -6, 30, 0], armR=[30, 70, -6, 30, 0], legL=[20, 10, -90, 30, 0], legR=[-10, 10, -96, 20, 0]),\n        k(0.6, armL=[-10, 80, 2, 20, 0], armR=[-10, 80, 2, 20, 0], legL=[-10, 10, -96, 20, 0], legR=[20, 10, -90, 30, 0]),\n        k(1.2, armL=[30, 70, -6, 30, 0], armR=[30, 70, -6, 30, 0], legL=[20, 10, -90, 30, 0], legR=[-10, 10, -96, 20, 0])]),\n    clip(\"Wake\", 1.8, False, [\"gesture\"], \"Waking: head up, a big stretch, a sigh.\", [\n        k(0, chest=[0, 14, 0], head=[0, 26, 0]),\n        k(0.7, hips=[0, 0, 102], chest=[0, -10, 0], head=[0, -14, 0], armL=[6, 30, 90, 16, 0], armR=[6, 30, 90, 16, 0]),\n        k(1.2, hips=[0, 0, 102], chest=[0, -12, 0], head=[0, -10, 0], armL=[6, 34, 92, 10, 0], armR=[6, 34, 92, 10, 0]),\n        k(1.8)]),\n    hold(\"Sleep\", \"Sitting, asleep, head on chest.\", hips=[0, 0, 26], body=[0, 20, 0], chest=[0, 22, 0], head=[0, 40, 0],\n         armL=[40, 12, -70, 30, 0], armR=[40, 12, -70, 30, 0], legL=[76, 34, -6, 120, 0], legR=[76, 34, -6, 120, 0]),\n    clip(\"Sigh\", 1.6, False, [\"gesture\"], \"The shoulders rise and fall.\", [\n        k(0), k(0.6, chest=[0, -6, 0], head=[0, -6, 0], shL=[0, 14], shR=[0, 14]), k(1.6, chest=[0, 6, 0], head=[0, 12, 0])]),\n    clip(\"Bow\", 1.2, False, [\"gesture\"], \"A polite bow.\", [\n        k(0), k(0.5, body=[0, 45, 0], chest=[0, 10, 0], head=[0, 10, 0]), k(1.2)]),\n])\ndoc = {\"set\": \"FIT\", \"title\": \"Tippy Cay moves\", \"format\": 1, \"credit\": \"Hand-keyed for this game (CC0); TrayWalk's legs from 100STYLE's Balance_Walk.\",\n       \"legend\": [], \"fps\": 30, \"sources\": {}, \"clips\": clips}\n(ROOT / \"fit.json\").write_text(json.dumps(doc, indent=0) + \"\\n\")\nprint(len(clips), \"clips\")\nEOF\npython3 tools/make_clips.py\ncat > tools/make_sets.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Writes the game's sets (room files) into engine/crates/pav_core/src/games/fit/sets/.\nMaps, objects and people are generated here once for convenience; the TOML it writes is the data\nthe game reads, and running from engine/ a change to it needs no rebuild.\"\"\"\nimport math, pathlib, random\nOUT = pathlib.Path(__file__).resolve().parent.parent / \"engine/crates/pav_core/src/games/fit/sets\"\n\ndef toml_val(v):\n    if isinstance(v, bool): return \"true\" if v else \"false\"\n    if isinstance(v, (int, float)): return repr(round(v, 3))\n    if isinstance(v, str): return '\"' + v + '\"'\n    if isinstance(v, (list, tuple)): return \"[\" + \", \".join(toml_val(x) for x in v) + \"]\"\n    if isinstance(v, dict): return \"{ \" + \", \".join(f'\"{k}\" = {toml_val(x)}' if not k.isidentifier() else f\"{k} = {toml_val(x)}\" for k, x in v.items()) + \" }\"\n    raise TypeError(v)\n\nclass Room:\n    def __init__(self, name, w, h, stage, ground=\"~\"):\n        self.name, self.w, self.h = name, w, h\n        self.stage = stage  # (x, z) cell\n        self.grid = [[ground] * w for _ in range(h)]\n        self.marks = {}\n        self.legend = {}\n        self.objects, self.npcs, self.labels = [], [], []\n        self.view = {}\n        self.mark(\"stage\", stage[0], stage[1])\n    def mark(self, name, x, z):\n        self.marks[name] = self.marks.get(name, []) + [(int(x), int(z))]\n    def obj(self, asset=None, x=0.0, y=0.0, z=0.0, yaw=0.0, scale=1.0, body=\"none\", name=\"\", **k):\n        d = {}\n        if name: d[\"name\"] = name\n        if asset: d[\"asset\"] = asset\n        d[\"pos\"] = [self.stage[0] + 0.5 + x, y, self.stage[1] + 0.5 + z]\n        if yaw: d[\"yaw\"] = yaw\n        if scale != 1.0: d[\"scale\"] = scale\n        d[\"body\"] = body\n        d.update(k)\n        self.objects.append(d)\n    def npc(self, name, kind, x, z, yaw=0.0, y=0.0, ai=\"idle\", **k):\n        d = {\"name\": name, \"kind\": kind, \"pos\": [self.stage[0] + 0.5 + x, y, self.stage[1] + 0.5 + z], \"yaw\": yaw, \"ai\": ai}\n        d.update(k)\n        self.npcs.append(d)\n    def write(self):\n        chars = \"abcdefghijklmnopqrtuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\"\n        lines = [f'name = \"{self.name}\"', 'entrance = { at = [1, 1], facing = \"south\" }', \"\"]\n        lines.append(\"[view]\")\n        for k, v in self.view.items():\n            key = f'\"{k}\"' if \".\" in k else k\n            lines.append(f\"{key} = {toml_val(v)}\")\n        lines += [\"\", \"[layout]\", \"origin = [0.0, 0.0, 0.0]\", \"\", \"[[layout.layer]]\", \"y = 0\", \"map = '''\"]\n        lines += [\"\".join(r) for r in self.grid]\n        lines += [\"'''\", \"\"]\n        overlay = [[\"_\"] * self.w for _ in range(self.h)]\n        legend = dict(self.legend)\n        i = 0\n        for name, cells in sorted(self.marks.items()):\n            c = chars[i]; i += 1\n            while c in legend: c = chars[i]; i += 1\n            legend[c] = f'marker = \"{name}\"'\n            for (x, z) in cells:\n                overlay[z][x] = c\n        lines += [\"[[layout.layer]]\", \"y = 0\", \"map = '''\"] + [\"\".join(r) for r in overlay] + [\"'''\", \"\"]\n        legend[\"_\"] = \"\"\n        for c, body in legend.items():\n            lines.append(f\"[layout.legend.'{c}']\")\n            if body: lines.append(body)\n            lines.append(\"\")\n        for o in self.objects:\n            lines.append(\"[[object]]\")\n            for k, v in o.items():\n                lines.append(f\"{k} = {toml_val(v)}\")\n            lines.append(\"\")\n        for n in self.npcs:\n            lines.append(\"[[npc]]\")\n            for k, v in n.items():\n                lines.append(f\"{k} = {toml_val(v)}\")\n            lines.append(\"\")\n        (OUT / f\"{self.name}.toml\").write_text(\"\\n\".join(lines))\n\nSEA = \"#8fdde0\"\ndef base_view(sky=\"#d6eef6\", elev=52.0, az=160.0, sun=0.62, amb=1.15, sea=SEA, fog_start=25.0, fog_end=110.0, exposure=1.0, sat=0.95, fog_color=None):\n    v = {\"sky\": sky, \"exposure\": exposure, \"saturation\": sat, \"bloom\": 0.15, \"bloom_threshold\": 1.3, \"outlines_on\": \"objects\",\n         \"outline_px\": 1.0, \"outline_darken\": 0.55, \"rim\": 0.3, \"fog\": True, \"fog_start\": fog_start, \"fog_end\": fog_end, \"wind\": 0.5,\n         \"light.sun_elevation\": elev, \"light.sun_azimuth\": az, \"light.sun_intensity\": sun, \"light.ambient\": amb,\n         \"cutaway.height_cut\": False, \"cutaway.front_cut\": False, \"cutaway.fade\": False,\n         \"filter.transition\": \"iris\", \"filter.transition_time\": 0.8}\n    return v\ndef water_legend(color=SEA, floor=-3.0):\n    return f'blocks = [{{ y0 = {floor - 0.2}, y1 = {floor}, color = \"{color}\", look = \"flat\" }}]\\nzone = {{ kind = \"water\", y0 = {floor}, y1 = 0.0, color = \"{color}\" }}'\ndef far_sea(r, color=SEA):\n    r.obj(None, 0, -0.12, 0, name=\"far_sea\", shape={\"type\": \"cylinder\", \"half_height\": 0.05, \"radius\": 240.0}, color=color, look=\"flat\")\n\n# People.\nPIP = dict(skin=\"#8fd3ff\", shirt=\"#8fd3ff\", eyes=\"#263e54\", scale=0.72, squash=2.0, accent=\"#5fb0e0\", parts=[{\"kind\": \"spikes\", \"size\": 0.3, \"count\": 1, \"color\": \"#5fb0e0\"}])\nPOSEY = dict(skin=\"#d8b184\", shirt=\"#d8b184\", pants=\"#c79f6e\", shoes=\"#c79f6e\", eyes=\"#d8b184\", scale=1.05, leg_length=0.98)\nKETTLE = dict(skin=\"#2b2f36\", shirt=\"#2b2f36\", eyes=\"#ffffff\", scale=1.0, squash=0.2, parts=[{\"kind\": \"handle\", \"size\": 1.2, \"color\": \"#2b2f36\"}])\nBOUNCE = dict(skin=\"#ffa8c0\", shirt=\"#ffa8c0\", eyes=\"#263e54\", scale=1.25, squash=2.0)\ndef guest(shirt=\"#fbfaf6\", pants=\"#fbfaf6\", skin=\"#eebd94\", helm=\"hood\", helm_color=\"#f5f2ec\", **k):\n    d = dict(shirt=shirt, pants=pants, skin=skin, shoes=\"#d9d4c5\", **k)\n    d[\"gear\"] = {\"helm\": helm, \"helm_color\": helm_color}\n    return d\n\ndef islet(r, x, z, size=7.0, palms=2, rng=None):\n    r.obj(None, x, -0.25, z, shape={\"type\": \"cylinder\", \"half_height\": 0.3, \"radius\": size}, color=\"#f6e7c8\", look=\"flat\", body=\"none\")\n    rng = rng or random\n    for i in range(palms):\n        a = rng.uniform(0, 6.28)\n        r.obj(\"LIB/core/palm\", x + math.cos(a) * size * 0.4, 0.0, z + math.sin(a) * size * 0.4, yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.2))\n\n# ------------------------------------------------------------------ the hub: Tippy Cay itself\ndef hub():\n    W, H, cx, cz = 76, 60, 38, 30\n    r = Room(\"hub\", W, H, (cx, cz))\n    rng = random.Random(7)\n    for z in range(H):\n        for x in range(W):\n            dx, dz = x + 0.5 - (cx + 0.5), z + 0.5 - (cz + 0.5)\n            land = (abs(dx) / 29) ** 4 + (abs(dz) / 21) ** 4\n            ring = ((abs(dx) / 22) ** 3 + (abs(dz) / 15) ** 3) ** (1 / 3)\n            plaza = (dx / 8.5) ** 2 + (dz / 6.5) ** 2\n            if land > 1.0: c = \"~\"\n            elif abs(ring - 1) < 0.075: c = \"p\"\n            elif plaza < 1: c = \"d\"\n            elif land > 0.62 or ring > 1.09: c = \"s\"\n            else: c = \"g\" if (x * 7 + z * 13) % 11 > 2 else \"h\"\n            r.grid[z][x] = c\n    r.legend = {\n        \"~\": water_legend(),\n        \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]',\n        \"g\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#bfe6b0\", look = \"flat\" }]\\ngrass = { density = 3, height = 0.32, color = \"#a8dc98\" }',\n        \"h\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#b8e2a8\", look = \"flat\" }]',\n        \"p\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#efe7d6\", look = \"flat\" }]',\n        \"d\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#fbfaf6\", look = \"flat\" }]',\n    }\n    r.view = base_view(fog_start=45.0, fog_end=150.0)\n    far_sea(r)\n    # Reception.\n    r.obj(\"LIB/core/reception_desk\", 0, 0, -3, body=\"fixed\", name=\"desk\")\n    r.npc(\"pip\", \"blob\", 0, -3, y=1.0, yaw=0, look=PIP)\n    r.obj(\"LIB/core/calendar_wall\", -5.5, 0, -3.5, yaw=20, body=\"fixed\")\n    r.obj(\"LIB/core/minute_clam\", 5.5, 0, -3.2, yaw=-20, body=\"fixed\", name=\"clam\")\n    r.obj(\"LIB/core/wardrobe_rack\", -7, 0, 1.2, yaw=70, body=\"fixed\")\n    r.obj(\"LIB/core/umbrella\", 7.5, 0, 2.2, roles={\"$accent\": \"#ff786e\"})\n    r.obj(\"LIB/core/lounge_chair\", 8.6, 0, 3.3, yaw=-30, body=\"none\")\n    r.mark(\"int_calendar\", cx - 5, cz - 2); r.mark(\"int_clam\", cx + 5, cz - 1); r.mark(\"int_wardrobe\", cx - 6, cz + 2)\n    # Pavilions and their mats, inside the ring.\n    pav = [(\"mat_studio\", -13, -8, \"#c4e8d8\", -12), (\"mat_gazebo\", 13, -8, \"#ffe2b0\", 12), (\"mat_boardwalk\", 13, 8, \"#ffc4d6\", 12), (\"mat_lagoon\", -13, 8, \"#b0e0f0\", -12)]\n    for name, x, z, col, _ in pav:\n        r.obj(\"LIB/core/pavilion\", x, 0, z, roles={\"$accent\": col}, body=\"fixed\")\n        sx, sz = (1 if x < 0 else -1), (1 if z < 0 else -1)\n        mx, mz = x + sx * 4.8, z + sz * 3.8\n        r.obj(\"LIB/core/exercise_mat\", mx, 0.01, mz, yaw=math.degrees(math.atan2(sx, sz)), roles={\"$accent\": col})\n        r.mark(name, cx + mx, cz + mz)\n    # Cabanas on the south beach.\n    for i, x in enumerate([-16, -8, 0, 8, 16]):\n        cols = [\"#46bec8\", \"#ff786e\", \"#ffd166\", \"#78dcaa\", \"#c4b1e8\"]\n        r.obj(\"LIB/core/cabana\", x, 0, 19 - abs(x) * 0.05, yaw=180, roles={\"$accent\": cols[i]}, body=\"fixed\")\n    r.mark(\"int_cabana\", cx, cz + 16)\n    # The pier, tower and rowboat, to the east.\n    r.obj(None, 36, -0.12, 0, shape={\"type\": \"rounded_box\", \"half\": [10.0, 0.14, 1.5], \"radius\": 0.1}, color=\"#e0c89a\", body=\"none\")\n    for i in range(5):\n        r.obj(\"LIB/core/mooring_post\", 28 + i * 4, -0.6, 1.7, scale=0.5)\n    r.obj(\"LIB/core/diving_tower\", 40, 0, -10, yaw=90)\n    r.mark(\"int_stand\", cx + 25, cz + 1)\n    r.obj(\"LIB/core/exercise_mat\", 25, 0.01, 1, yaw=90, roles={\"$accent\": \"#ff786e\"})\n    r.obj(\"LIB/core/rowboat\", 31, -0.2, 7, name=\"rowboat\")\n    r.mark(\"end_dock\", cx + 31, cz + 7)\n    # Palms, loungers and a smoothie stand.\n    placed = 0\n    while placed < 38:\n        a = rng.uniform(0, 6.283); k = rng.uniform(0.62, 0.98)\n        c, s = math.cos(a), math.sin(a)\n        x = math.copysign(abs(c) ** 0.5, c) * 28 * k; z = math.copysign(abs(s) ** 0.5, s) * 20 * k\n        ring = ((abs(x) / 22) ** 3 + (abs(z) / 15) ** 3) ** (1 / 3)\n        if abs(ring - 1) < 0.16 or (z > 15 and abs(x) < 20) or (x > 20 and abs(z) < 4):\n            continue\n        r.obj(\"LIB/core/palm\", x, 0, z, yaw=rng.uniform(0, 360), scale=rng.uniform(0.75, 1.25), sway=\"leaves\")\n        placed += 1\n    for (x, z, y) in [(-22, -3, 90), (-22, 0, 90), (-22, 3, 90), (22, 8, -90), (19, 12, -60)]:\n        r.obj(\"LIB/core/lounge_chair\", x, 0, z, yaw=y)\n        r.obj(\"LIB/core/umbrella\", x + 1.2, 0, z - 1, roles={\"$accent\": rng.choice([\"#46bec8\", \"#ffd166\", \"#ff786e\"])})\n    r.obj(\"LIB/core/market_stall\", 0, 0, 9, yaw=180, body=\"fixed\")\n    # People.\n    r.npc(\"posey_hub\", \"biped\", -9.5, -3.2, yaw=120, look=POSEY)\n    r.npc(\"kettle_hub\", \"blob\", 9.5, -4.0, yaw=-120, look=KETTLE)\n    r.npc(\"bounce_hub\", \"blob\", 10.5, 6.5, yaw=-140, hop=0.7, look=BOUNCE)\n    r.obj(\"LIB/core/gull_captain\", -10.5, 0, 6.3, yaw=130, body=\"fixed\", name=\"commodore\")\n    r.mark(\"int_gull\", cx - 10, cz + 6)\n    r.npc(\"marjorie\", \"biped\", -3.5, 4.5, yaw=30, look=guest())\n    r.npc(\"tom\", \"biped\", -5, 15, yaw=10, look=guest(shirt=\"#46bec8\", pants=\"#fbfaf6\", skin=\"#d9a074\", belt=\"#fbfaf6\"))\n    r.npc(\"twin_a\", \"biped\", 5, 5, yaw=-20, look=guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"))\n    r.npc(\"twin_b\", \"biped\", 6, 5, yaw=-20, look=guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"))\n    for i, (x, z) in enumerate([(-20, 8), (20, -7), (-3, -12), (16, 14), (-14, 14)]):\n        cols = [\"#fbfaf6\", \"#c4b1e8\", \"#78dcaa\", \"#ffb88a\", \"#f4f1e8\"]\n        skins = [\"#f6d7b8\", \"#8c5a3a\", \"#d9a074\", \"#5f3d29\", \"#eebd94\"]\n        r.npc(f\"guest{i}\", \"biped\", x, z, ai={\"type\": \"wander\", \"radius\": 5.0}, speed=0.35, look=guest(shirt=cols[i], skin=skins[i], helm=\"none\"))\n    # Lost flip-flops.\n    for (x, z) in [(10, 20), (17, -13), (-26, 4), (27, -5), (-17, -13)]:\n        r.mark(\"flipflop\", cx + x, cz + z)\n    r.write()\n\n# ------------------------------------------------------------------ one-event sets\ndef water_room(name, size=60, **kw):\n    r = Room(name, size, size, (size // 2, size // 2))\n    r.legend = {\"~\": water_legend(**kw)}\n    return r\n\ndef studio():\n    r = water_room(\"studio\", color=\"#a8e4e6\")\n    r.view = base_view(sky=\"#fbe6dc\", elev=14.0, az=95.0, sun=0.5, amb=1.25, fog_start=20.0, fog_end=95.0)\n    far_sea(r, \"#a8e4e6\")\n    r.obj(None, 0, -0.14, 0, name=\"deck\", shape={\"type\": \"cylinder\", \"half_height\": 0.14, \"radius\": 5.8}, color=\"#fbfaf6\", body=\"none\")\n    r.obj(None, 0, -0.1, 0, shape={\"type\": \"cylinder\", \"half_height\": 0.12, \"radius\": 6.1}, color=\"#e8e2d4\", body=\"none\")\n    r.obj(\"LIB/core/exercise_mat\", 0, 0.01, 0, roles={\"$accent\": \"#c4e8d8\"})\n    r.obj(\"LIB/core/exercise_mat\", 2.4, 0.01, 0.2, roles={\"$accent\": \"#ffd9c4\"})\n    r.npc(\"posey\", \"biped\", 2.4, 0.2, yaw=0, look=POSEY)\n    r.npc(\"pip_check\", \"blob\", -3.2, -2.0, yaw=0, look=PIP)\n    rng = random.Random(3)\n    for (x, z, s, p) in [(-20, -16, 7, 3), (16, -22, 6, 2), (-9, -30, 5, 2), (26, -8, 5, 2), (-30, 2, 6, 2)]:\n        islet(r, x, z, s, p, rng)\n    for (x, z) in [(-7, -5), (7, -6)]:\n        r.obj(\"LIB/core/lamp_post\", x, -0.0, z)\n    r.write()\n\ndef gazebo():\n    r = Room(\"gazebo\", 60, 60, (30, 30))\n    for z in range(60):\n        for x in range(60):\n            d = math.hypot(x - 30, z - 30)\n            r.grid[z][x] = \"~\" if d > 22 else (\"s\" if d > 16 else \"g\")\n    r.legend = {\"~\": water_legend(color=\"#a6d8d0\"),\n                \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6dfb4\", look = \"flat\" }]',\n                \"g\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#cfe6a0\", look = \"flat\" }]\\ngrass = { density = 4, height = 0.34, color = \"#bcdc88\" }'}\n    r.view = base_view(sky=\"#ffe6c2\", elev=18.0, az=250.0, sun=0.85, amb=1.0, sat=1.0, fog_start=25.0, fog_end=100.0)\n    far_sea(r, \"#a6d8d0\")\n    r.obj(\"LIB/core/iron_gazebo\", 0, 0, 0)\n    r.obj(\"LIB/core/exercise_mat\", 0, 0.11, 0, roles={\"$accent\": \"#ffe2b0\"})\n    r.npc(\"kettle\", \"blob\", 2.8, -0.2, yaw=-30, look=KETTLE)\n    r.obj(\"LIB/core/kettle_rack\", -3.6, 0.1, -2.2, yaw=30)\n    rng = random.Random(5)\n    for i in range(11):\n        a = i * 0.57 + 0.3\n        r.obj(\"LIB/core/palm\", math.cos(a * 2.1) * rng.uniform(10, 18), 0, -abs(math.sin(a * 2.1)) * rng.uniform(9, 17) - 2, yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.3), sway=\"leaves\")\n    for (x, z, n) in [(-4.5, -7.5, \"g1\"), (5.2, -8.2, \"g2\")]:\n        r.npc(n, \"biped\", x, z, yaw=10, look=guest(helm=\"none\"), clips=[\"MESH2MOTION/Jumping Jacks\"])\n    r.write()\n\ndef boardwalk():\n    r = Room(\"boardwalk\", 70, 60, (35, 30))\n    for z in range(60):\n        for x in range(70):\n            r.grid[z][x] = \"~\" if z > 42 else \"s\"\n    r.legend = {\"~\": water_legend(color=\"#8fe0e8\"), \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'}\n    r.view = base_view(sky=\"#cdeefc\", elev=66.0, az=170.0, sun=0.75, amb=1.1, sat=1.0, fog_start=30.0, fog_end=120.0)\n    far_sea(r, \"#8fe0e8\")\n    r.obj(None, 0, -0.05, -1, name=\"planks\", shape={\"type\": \"rounded_box\", \"half\": [18.0, 0.1, 6.0], \"radius\": 0.05}, color=\"#e0c89a\", body=\"none\")\n    for i in range(18):\n        r.obj(None, -17 + i * 2, 0.056, -1, shape={\"type\": \"box\", \"half\": [0.02, 0.005, 6.0]}, color=\"#c8ae80\", body=\"none\")\n    r.obj(\"LIB/core/step_box\", 0, 0.05, 0, scale=1.2)\n    r.npc(\"bounce\", \"blob\", -4.2, -1.2, yaw=40, hop=0.62, look=BOUNCE)\n    for i, x in enumerate([-8, -6, -3, 3, 6, 8]):\n        cols = [\"#ffd166\", \"#78dcaa\", \"#c4b1e8\", \"#ff786e\", \"#46bec8\", \"#fbfaf6\"]\n        skins = [\"#f6d7b8\", \"#d9a074\", \"#8c5a3a\", \"#eebd94\", \"#5f3d29\", \"#b97f54\"]\n        r.npc(f\"clapper{i}\", \"biped\", x, -4.4 - (i % 2) * 0.8, yaw=0, look=guest(shirt=cols[i], pants=\"#f4f1e8\", skin=skins[i], helm=\"none\"))\n    r.obj(\"LIB/core/market_stall\", 11, 0, -5, yaw=-20, body=\"none\")\n    for (x, z, c) in [(-12, 3, \"#ff786e\"), (-15, -3, \"#ffd166\"), (14, 3, \"#46bec8\"), (-20, 8, \"#78dcaa\"), (20, 9, \"#ff786e\")]:\n        r.obj(\"LIB/core/umbrella\", x, 0, z, roles={\"$accent\": c})\n        r.obj(\"LIB/core/lounge_chair\", x + 1.3, 0, z + 0.4, yaw=20)\n    rng = random.Random(9)\n    for i in range(16):\n        r.obj(\"LIB/core/palm\", -30 + i * 4 + rng.uniform(-1, 1), 0, -13 - rng.uniform(0, 8), yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.3), sway=\"leaves\")\n    r.write()\n\ndef tide():\n    r = water_room(\"tide\")\n    r.view = base_view(sky=\"#d6eef6\", elev=58.0, az=150.0, sun=0.7, amb=1.1)\n    far_sea(r)\n    for x in [-11, 11, 22, -22]:\n        r.obj(\"LIB/core/tide_raft\", x, 0.2, 0)\n    r.obj(\"LIB/core/gull_captain\", 6.5, -0.6, -6.5, yaw=-30)\n    rng = random.Random(11)\n    for (x, z, s, p) in [(-26, -20, 6, 2), (24, -24, 7, 3), (0, -30, 5, 2)]:\n        islet(r, x, z, s, p, rng)\n    r.write()\n\ndef channel():\n    W, H = 56, 240\n    r = Room(\"channel\", W, H, (28, 225))\n    for z in range(H):\n        for x in range(W):\n            r.grid[z][x] = \"~\" if abs(x - 28) <= 12 else \"s\"\n    r.legend = {\"~\": water_legend(color=\"#7fd8dc\"), \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'}\n    r.view = base_view(sky=\"#d0ecf8\", elev=55.0, az=140.0, sun=0.7, amb=1.1, fog_start=40.0, fog_end=120.0)\n    far_sea(r, \"#7fd8dc\")\n    rng = random.Random(13)\n    for i in range(44):\n        side = -1 if i % 2 else 1\n        r.obj(\"LIB/core/palm\", side * rng.uniform(14, 22), 0, 12 - i * 5.0, yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.3), sway=\"leaves\")\n    for i in range(10):\n        side = 1 if i % 2 else -1\n        r.obj(\"LIB/core/umbrella\", side * 14, 0, -i * 21.0, roles={\"$accent\": rng.choice([\"#46bec8\", \"#ffd166\", \"#ff786e\"])})\n    r.npc(\"cheer0\", \"biped\", -14, 4, yaw=60, look=guest(helm=\"none\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n    r.npc(\"cheer1\", \"biped\", 14, -200, yaw=-120, look=guest(shirt=\"#ffd166\", helm=\"none\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n    r.write()\n\ndef pier():\n    r = Room(\"pier\", 60, 150, (30, 125))\n    r.legend = {\"~\": water_legend(color=\"#93dce0\")}\n    r.view = base_view(sky=\"#d9eef4\", elev=46.0, az=120.0, sun=0.65, amb=1.15, fog_start=35.0, fog_end=120.0)\n    far_sea(r, \"#93dce0\")\n    r.obj(None, 0, -0.14, -52, name=\"pierdeck\", shape={\"type\": \"rounded_box\", \"half\": [2.8, 0.14, 60.0], \"radius\": 0.05}, color=\"#e0c89a\", body=\"none\")\n    for i in range(26):\n        z = 6 - i * 4.4\n        for s in (-1, 1):\n            r.obj(\"LIB/core/mooring_post\", s * 2.9, -0.5, z, scale=0.55)\n        if i % 3 == 0:\n            r.obj(\"LIB/core/lamp_post\", 2.5 * (1 if i % 2 else -1), 0, z)\n    r.npc(\"marjorie_pier\", \"biped\", 1.2, -103.2, yaw=0, look=guest())\n    r.obj(\"LIB/core/lounge_chair\", -1.4, 0, -105, yaw=180)\n    r.write()\n\ndef tower():\n    r = water_room(\"tower\", color=\"#8ad8e4\")\n    r.view = base_view(sky=\"#d0ecf8\", elev=60.0, az=120.0, sun=0.8, amb=1.1, sat=1.0, fog_start=30.0, fog_end=110.0)\n    far_sea(r, \"#8ad8e4\")\n    r.obj(\"LIB/core/diving_tower\", 0, 0, -3.4)\n    for x in (2.2, 4.4, -2.2):\n        r.obj(\"LIB/core/diving_board\", x, 6.0, 0)\n    r.obj(\"LIB/core/small_raft\", 9, 0.1, 11)\n    r.obj(\"LIB/core/gull\", 8.2, 0.4, 10.2, yaw=-90, scale=2.2, name=\"judge1\")\n    r.obj(\"LIB/core/gull\", 9.0, 0.4, 11.0, yaw=-90, scale=2.2, name=\"judge2\")\n    r.obj(\"LIB/core/gull\", 9.8, 0.4, 11.8, yaw=-90, scale=2.2, name=\"judge3\")\n    rng = random.Random(17)\n    for (x, z, s, p) in [(24, -2, 7, 3), (28, 14, 6, 2), (20, 24, 5, 2)]:\n        islet(r, x, z, s, p, rng)\n    r.write()\n\ndef bay():\n    r = water_room(\"bay\", color=\"#d8b0b8\")\n    r.view = base_view(sky=\"#ffb9a0\", elev=8.0, az=215.0, sun=0.95, amb=0.85, sat=1.05, fog_start=20.0, fog_end=95.0, exposure=1.0)\n    r.view[\"bloom\"] = 0.4\n    far_sea(r, \"#e8a8a0\")\n    r.obj(\"LIB/core/mooring_post\", 0, 0, 0, name=\"post\")\n    rafts = [(-5, -6), (0, -7.5), (5, -6), (-9, -3), (9, -3), (-3, -12), (3, -12), (-9, -10), (9, -10)]\n    for (x, z) in rafts:\n        r.obj(\"LIB/core/small_raft\", x, 0.05, z, scale=1.0, light={\"color\": \"#ffc080\", \"radius\": 7.0, \"intensity\": 2.0, \"offset\": [0.0, 1.6, 0.0]})\n    cast = [(\"crowd_pip\", \"blob\", PIP, -5, -6), (\"crowd_posey\", \"biped\", POSEY, 0, -7.5), (\"crowd_kettle\", \"blob\", KETTLE, 5, -6),\n            (\"crowd_bounce\", \"blob\", BOUNCE, -9, -3), (\"crowd_marjorie\", \"biped\", guest(), 9, -3),\n            (\"crowd_tom\", \"biped\", guest(shirt=\"#46bec8\", belt=\"#fbfaf6\"), -3, -12), (\"crowd_twin_a\", \"biped\", guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"), 3, -12),\n            (\"crowd_twin_b\", \"biped\", guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"), 3.9, -12)]\n    for (name, kind, look, x, z) in cast:\n        extra = {\"hop\": 0.7} if name == \"crowd_bounce\" else {}\n        r.npc(name, kind, x, z, y=0.25, yaw=math.degrees(math.atan2(-x, -z)), look=look, **extra)\n    for i, (x, z) in enumerate([(-9.6, -10.2), (-8.4, -9.6), (8.6, -10), (9.6, -10.4)]):\n        r.npc(f\"crowd_band{i}\", \"biped\", x, z, y=0.25, yaw=0, look=guest(shirt=\"#ff786e\", helm=\"cap\", helm_color=\"#ff786e\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n    rng = random.Random(19)\n    for (x, z, s, p) in [(-28, -26, 8, 3), (30, -30, 7, 3)]:\n        islet(r, x, z, s, p, rng)\n    r.write()\n\nfor f in (hub, studio, gazebo, boardwalk, tide, channel, pier, tower, bay):\n    f()\nprint(\"sets written\")\nEOF\npython3 tools/make_sets.py; cd engine; python3 - <<'EOF'\np='crates/pav_core/src/games/fit/island.rs'\ns=open(p).read()\ns=s.replace(\"\"\"        (Who::Gull, \"gull_hub\"),\n\"\"\",\"\")\ns=s.replace(\"\"\"    out\n}\n\n/// A step toward\"\"\",\"\"\"    if let Some(pos) = set_markers(sim, Set::Hub, \"int_gull\").first().copied() {\n        out.push(Interact { spot: Spot::Talk(Who::Gull), pos, id: None });\n    }\n    out\n}\n\n/// A step toward\"\"\")\nopen(p,'w').write(s)\nEOF\nfor s in hub studio gazebo boardwalk tide channel pier tower bay; do echo \"== $s\"; ./target/debug/pav room_check path=crates/pav_core/src/games/fit/sets/$s.toml 2>&1 | cut -c1-400 | head -5; done","description":"Write clips and sets generators and check the sets","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3122,"cache_read_input_tokens":553159,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3122},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"b69e64d2-46df-41fc-b2dc-e9f6bf0fc6ef","timestamp":"2026-11-05T06:24:52.031Z","request_id":"req_011CgjJLj1cJtBzC6SuEWFKr","wire_tool_inputs":{"toolu_011gAGqK2CQLFH3XEaakiCNt":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-223859__x35112d/work/WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859 && cat > tools/make_clips.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Writes engine/anim/fit.json: the game's hand-keyed clips, as readable key poses.\nField meanings are in LEGEND at the top of engine/crates/pav_core/src/clips.rs.\"\"\"\nimport json, pathlib, copy\nROOT = pathlib.Path(__file__).resolve().parent.parent / \"engine/anim\"\nSTAND = {\"hips\": [0, 0, 100], \"body\": [0, 0, 0], \"chest\": [0, 0, 0], \"head\": [0, 0, 0],\n         \"armL\": [10, 10, -95, 10, 0], \"armR\": [10, 10, -95, 10, 0],\n         \"legL\": [0, 6, -100, 0, 0], \"legR\": [0, 6, -100, 0, 0]}\ndef k(t, **o):\n    d = copy.deepcopy(STAND); d.update(o); d[\"t\"] = t\n    return d\ndef clip(name, dur, loop, tags, desc, keys):\n    return name, {\"clip\": name, \"dur\": dur, \"loop\": loop, \"tags\": tags, \"desc\": desc, \"keys\": keys}\ndef hold(name, desc, **pose):\n    return clip(name, 2.0, True, [\"pose\"], desc, [k(0, **pose), k(1.0, **{**pose, \"hips\": [pose.get(\"hips\", [0, 0, 100])[0], pose.get(\"hips\", [0, 0, 100])[1], pose.get(\"hips\", [0, 0, 100])[2] - 1]}), k(2.0, **pose)])\n\nm2m = json.load(open(ROOT / \"mesh2motion.json\"))[\"clips\"]\nplank = copy.deepcopy(m2m[\"Pushup\"][\"keys\"][0])\nstyle = json.load(open(ROOT / \"style100.json\"))[\"clips\"]\ncarry_arms = {\"armL\": [95, 12, 5, 72, 0], \"armR\": [95, 12, 5, 72, 0]}\ntray_keys = []\nfor key in style[\"Balance_Walk\"][\"keys\"]:\n    kk = copy.deepcopy(key)\n    kk.update(carry_arms)\n    kk[\"chest\"] = [0, -3, 0]\n    kk[\"head\"] = [0, 5, 0]\n    kk[\"shL\"] = [0, 0]\n    kk[\"shR\"] = [0, 0]\n    tray_keys.append(kk)\nflop_low = copy.deepcopy(plank); flop_low[\"hips\"] = [-7, 0, 14]; flop_low[\"body\"] = [0, 84, 0]; flop_low[\"armL\"] = [40, 80, -10, 20, 0]; flop_low[\"armR\"] = [40, 80, -10, 20, 0]; flop_low[\"head\"] = [0, -6, 8]\n\nclips = dict([\n    clip(\"Breath\", 1.0, False, [\"exercise\"], \"Exhaled to inhaled; scrub clip time with the lungs.\", [\n        k(0, chest=[0, 8, 0], head=[0, 8, 0], armL=[20, 18, -85, 20, 0], armR=[20, 18, -85, 20, 0]),\n        k(1.0, hips=[0, 0, 102], chest=[0, -8, 0], head=[0, -8, 0], armL=[0, 80, 62, 10, 0], armR=[0, 80, 62, 10, 0])]),\n    clip(\"Squat\", 1.0, False, [\"exercise\"], \"Stand to deep squat; scrub clip time with depth.\", [\n        k(0, armL=[10, 10, -95, 10, 0], armR=[10, 10, -95, 10, 0]),\n        k(1.0, hips=[-22, 0, 58], body=[0, 28, 0], chest=[0, 5, 0], head=[0, -22, 0], armL=[100, 4, 10, 0, 0], armR=[100, 4, 10, 0, 0],\n          legL=[55, 10, -60, 95, 0], legR=[55, 10, -60, 95, 0], footL=[-12, 0, 0], footR=[-12, 0, 0])]),\n    hold(\"Tree\", \"The Patient Heron: one foot on the other knee, palms up overhead.\",\n         hips=[0, 3, 98], body=[0, 0, -2], armL=[6, -6, 100, 25, 0], armR=[6, -6, 100, 25, 0],\n         legL=[6, 30, -55, 115, 62], legR=[0, 1, -100, 0, 0], footL=[35, 0, 0]),\n    hold(\"Warrior\", \"The Apologetic Lunge: deep lunge, arms out.\",\n         hips=[0, 0, 72], body=[35, 0, 0], chest=[-35, -4, 0], head=[-30, 8, 0], armL=[0, 100, 0, 0, 0], armR=[0, 100, 0, 0, 0],\n         legL=[70, 0, -55, 95, 0], legR=[-85, 20, -60, 0, 0], footR=[10, 40, 0]),\n    hold(\"Lighthouse\", \"The Tired Lighthouse: one arm up like a beam, head sagging.\",\n         hips=[0, -3, 100], body=[0, 0, -6], chest=[0, 0, -8], head=[0, 22, 10], armR=[0, 18, 100, 5, 0], armL=[0, 8, -100, 18, 0],\n         legL=[0, 8, -100, 2, 0], legR=[0, 4, -100, 0, 0]),\n    hold(\"DeckChair\", \"The Folded Deck Chair: folded in half, hands near the feet.\",\n         hips=[-18, 0, 76], body=[0, 88, 0], chest=[0, 14, 0], head=[0, 8, 0], armL=[56, 8, -90, 0, 0], armR=[56, 8, -90, 0, 0],\n         legL=[6, 6, -100, 28, 0], legR=[6, 6, -100, 28, 0]),\n    hold(\"Bridge\", \"The Reluctant Bridge: an arched back, arms flung back without enthusiasm.\",\n         hips=[14, 0, 92], body=[0, -28, 0], chest=[0, -24, 0], head=[0, -18, 0], armL=[-34, 12, 100, 8, 0], armR=[-34, 12, 100, 8, 0],\n         legL=[8, 8, -100, 22, 0], legR=[8, 8, -100, 22, 0]),\n    hold(\"Seated\", \"Seated Disappointment: cross-legged on the floor, looking at the floor.\",\n         hips=[0, 0, 26], body=[0, 16, 0], chest=[0, 18, 0], head=[0, 30, 0], armL=[42, 16, -70, 44, 0], armR=[42, 16, -70, 44, 0],\n         legL=[76, 44, -6, 128, 0], legR=[76, 44, -6, 128, 0], footL=[0, 30, 0], footR=[0, 30, 0]),\n    clip(\"Plank\", 1.0, True, [\"exercise\"], \"A held plank (from one frame of MESH2MOTION/Pushup).\", [dict(plank, t=0), dict(plank, t=1.0)]),\n    clip(\"Flop\", 1.0, False, [\"exercise\"], \"From a plank to flat on the floor; scrub clip time.\", [dict(plank, t=0), dict(flop_low, t=1.0)]),\n    clip(\"ArmFlail\", 0.7, True, [\"upper\"], \"Arms windmilling for balance (upper body).\", [\n        k(0, armL=[10, 90, 40, 12, 0], armR=[10, 90, -30, 12, 0], chest=[0, 0, 4]),\n        k(0.35, armL=[10, 90, -30, 12, 0], armR=[10, 90, 40, 12, 0], chest=[0, 0, -4]),\n        k(0.7, armL=[10, 90, 40, 12, 0], armR=[10, 90, -30, 12, 0], chest=[0, 0, 4])]),\n    clip(\"Stumble\", 0.95, False, [\"fall\"], \"A stumble and a recovery.\", [\n        k(0),\n        k(0.22, hips=[10, 0, 90], body=[0, 26, 0], chest=[0, 10, 0], armL=[60, 50, 20, 20, 0], armR=[60, 50, 20, 20, 0], legL=[26, 6, -90, 30, 0], legR=[-16, 6, -96, 10, 0]),\n        k(0.55, hips=[16, 0, 78], body=[0, 42, 0], chest=[0, 8, 0], head=[0, -12, 0], armL=[40, 90, 10, 10, 0], armR=[40, 90, -20, 10, 0], legL=[50, 8, -70, 70, 0], legR=[-26, 6, -92, 14, 0]),\n        k(0.95)]),\n    clip(\"StepL\", 0.42, False, [\"step\"], \"A left step up and down.\", [\n        k(0), k(0.14, hips=[0, 2, 104], legL=[34, 6, -84, 54, 0], armR=[30, 12, -80, 24, 0]), k(0.42)]),\n    clip(\"StepR\", 0.42, False, [\"step\"], \"A right step up and down.\", [\n        k(0), k(0.14, hips=[0, -2, 104], legR=[34, 6, -84, 54, 0], armL=[30, 12, -80, 24, 0]), k(0.42)]),\n    clip(\"HipCircle\", 1.0, True, [\"dance\"], \"Hips going round; scrub clip time with the spin.\", [\n        k(0, hips=[0, 9, 98], body=[0, 0, 7], chest=[0, 0, -7], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(0.25, hips=[9, 0, 98], body=[0, -6, 0], chest=[0, 6, 0], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(0.5, hips=[0, -9, 98], body=[0, 0, -7], chest=[0, 0, 7], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(0.75, hips=[-9, 0, 98], body=[0, 6, 0], chest=[0, -6, 0], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0]),\n        k(1.0, hips=[0, 9, 98], body=[0, 0, 7], chest=[0, 0, -7], armL=[0, 80, 30, 20, 0], armR=[0, 80, 30, 20, 0])]),\n    clip(\"CarryTray\", 1.0, True, [\"upper\"], \"Both hands out under a tray (upper body).\", [k(0, **carry_arms), k(1.0, **carry_arms)]),\n    clip(\"TrayWalk\", style[\"Balance_Walk\"][\"dur\"], True, [\"walk\"], \"STYLE100/Balance_Walk's legs with CarryTray's arms.\", tray_keys),\n    clip(\"Paddle\", 2.0, True, [\"water\"], \"Standing on a board, knees soft, arms out low.\", [\n        k(0, hips=[0, 0, 94], armL=[30, 40, -50, 30, 0], armR=[30, 40, -50, 30, 0], legL=[4, 14, -96, 18, 0], legR=[4, 14, -96, 18, 0]),\n        k(1.0, hips=[0, 2, 95], body=[0, 0, 2], armL=[30, 44, -44, 30, 0], armR=[30, 36, -54, 30, 0], legL=[4, 14, -96, 18, 0], legR=[4, 14, -96, 18, 0]),\n        k(2.0, hips=[0, 0, 94], armL=[30, 40, -50, 30, 0], armR=[30, 40, -50, 30, 0], legL=[4, 14, -96, 18, 0], legR=[4, 14, -96, 18, 0])]),\n    clip(\"Tuck\", 1.0, False, [\"dive\"], \"Open to tucked; scrub clip time with the tuck.\", [\n        k(0, armL=[0, 40, 60, 10, 0], armR=[0, 40, 60, 10, 0]),\n        k(1.0, hips=[0, 0, 62], body=[0, 44, 0], chest=[0, 22, 0], head=[0, 28, 0], armL=[80, 2, -24, 102, 0], armR=[80, 2, -24, 102, 0],\n          legL=[86, 8, 8, 132, 0], legR=[86, 8, 8, 132, 0], footL=[35, 0, 0], footR=[35, 0, 0])]),\n    clip(\"DiveEntry\", 1.0, True, [\"dive\"], \"Arms overhead, straight as a pencil.\", [\n        k(0, armL=[0, 0, 100, 0, 0], armR=[0, 0, 100, 0, 0], legL=[0, 2, -100, 0, 0], legR=[0, 2, -100, 0, 0]),\n        k(1.0, armL=[0, 0, 100, 0, 0], armR=[0, 0, 100, 0, 0], legL=[0, 2, -100, 0, 0], legR=[0, 2, -100, 0, 0])]),\n    clip(\"Tread\", 1.2, True, [\"water\"], \"Treading water, arms sculling.\", [\n        k(0, armL=[30, 70, -6, 30, 0], armR=[30, 70, -6, 30, 0], legL=[20, 10, -90, 30, 0], legR=[-10, 10, -96, 20, 0]),\n        k(0.6, armL=[-10, 80, 2, 20, 0], armR=[-10, 80, 2, 20, 0], legL=[-10, 10, -96, 20, 0], legR=[20, 10, -90, 30, 0]),\n        k(1.2, armL=[30, 70, -6, 30, 0], armR=[30, 70, -6, 30, 0], legL=[20, 10, -90, 30, 0], legR=[-10, 10, -96, 20, 0])]),\n    clip(\"Wake\", 1.8, False, [\"gesture\"], \"Waking: head up, a big stretch, a sigh.\", [\n        k(0, chest=[0, 14, 0], head=[0, 26, 0]),\n        k(0.7, hips=[0, 0, 102], chest=[0, -10, 0], head=[0, -14, 0], armL=[6, 30, 90, 16, 0], armR=[6, 30, 90, 16, 0]),\n        k(1.2, hips=[0, 0, 102], chest=[0, -12, 0], head=[0, -10, 0], armL=[6, 34, 92, 10, 0], armR=[6, 34, 92, 10, 0]),\n        k(1.8)]),\n    hold(\"Sleep\", \"Sitting, asleep, head on chest.\", hips=[0, 0, 26], body=[0, 20, 0], chest=[0, 22, 0], head=[0, 40, 0],\n         armL=[40, 12, -70, 30, 0], armR=[40, 12, -70, 30, 0], legL=[76, 34, -6, 120, 0], legR=[76, 34, -6, 120, 0]),\n    clip(\"Sigh\", 1.6, False, [\"gesture\"], \"The shoulders rise and fall.\", [\n        k(0), k(0.6, chest=[0, -6, 0], head=[0, -6, 0], shL=[0, 14], shR=[0, 14]), k(1.6, chest=[0, 6, 0], head=[0, 12, 0])]),\n    clip(\"Bow\", 1.2, False, [\"gesture\"], \"A polite bow.\", [\n        k(0), k(0.5, body=[0, 45, 0], chest=[0, 10, 0], head=[0, 10, 0]), k(1.2)]),\n])\ndoc = {\"set\": \"FIT\", \"title\": \"Tippy Cay moves\", \"format\": 1, \"credit\": \"Hand-keyed for this game (CC0); TrayWalk's legs from 100STYLE's Balance_Walk.\",\n       \"legend\": [], \"fps\": 30, \"sources\": {}, \"clips\": clips}\n(ROOT / \"fit.json\").write_text(json.dumps(doc, indent=0) + \"\\n\")\nprint(len(clips), \"clips\")\nEOF\npython3 tools/make_clips.py\ncat > tools/make_sets.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Writes the game's sets (room files) into engine/crates/pav_core/src/games/fit/sets/.\nMaps, objects and people are generated here once for convenience; the TOML it writes is the data\nthe game reads, and running from engine/ a change to it needs no rebuild.\"\"\"\nimport math, pathlib, random\nOUT = pathlib.Path(__file__).resolve().parent.parent / \"engine/crates/pav_core/src/games/fit/sets\"\n\ndef toml_val(v):\n    if isinstance(v, bool): return \"true\" if v else \"false\"\n    if isinstance(v, (int, float)): return repr(round(v, 3))\n    if isinstance(v, str): return '\"' + v + '\"'\n    if isinstance(v, (list, tuple)): return \"[\" + \", \".join(toml_val(x) for x in v) + \"]\"\n    if isinstance(v, dict): return \"{ \" + \", \".join(f'\"{k}\" = {toml_val(x)}' if not k.isidentifier() else f\"{k} = {toml_val(x)}\" for k, x in v.items()) + \" }\"\n    raise TypeError(v)\n\nclass Room:\n    def __init__(self, name, w, h, stage, ground=\"~\"):\n        self.name, self.w, self.h = name, w, h\n        self.stage = stage  # (x, z) cell\n        self.grid = [[ground] * w for _ in range(h)]\n        self.marks = {}\n        self.legend = {}\n        self.objects, self.npcs, self.labels = [], [], []\n        self.view = {}\n        self.mark(\"stage\", stage[0], stage[1])\n    def mark(self, name, x, z):\n        self.marks[name] = self.marks.get(name, []) + [(int(x), int(z))]\n    def obj(self, asset=None, x=0.0, y=0.0, z=0.0, yaw=0.0, scale=1.0, body=\"none\", name=\"\", **k):\n        d = {}\n        if name: d[\"name\"] = name\n        if asset: d[\"asset\"] = asset\n        d[\"pos\"] = [self.stage[0] + 0.5 + x, y, self.stage[1] + 0.5 + z]\n        if yaw: d[\"yaw\"] = yaw\n        if scale != 1.0: d[\"scale\"] = scale\n        d[\"body\"] = body\n        d.update(k)\n        self.objects.append(d)\n    def npc(self, name, kind, x, z, yaw=0.0, y=0.0, ai=\"idle\", **k):\n        d = {\"name\": name, \"kind\": kind, \"pos\": [self.stage[0] + 0.5 + x, y, self.stage[1] + 0.5 + z], \"yaw\": yaw, \"ai\": ai}\n        d.update(k)\n        self.npcs.append(d)\n    def write(self):\n        chars = \"abcdefghijklmnopqrtuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\"\n        lines = [f'name = \"{self.name}\"', 'entrance = { at = [1, 1], facing = \"south\" }', \"\"]\n        lines.append(\"[view]\")\n        for k, v in self.view.items():\n            key = f'\"{k}\"' if \".\" in k else k\n            lines.append(f\"{key} = {toml_val(v)}\")\n        lines += [\"\", \"[layout]\", \"origin = [0.0, 0.0, 0.0]\", \"\", \"[[layout.layer]]\", \"y = 0\", \"map = '''\"]\n        lines += [\"\".join(r) for r in self.grid]\n        lines += [\"'''\", \"\"]\n        overlay = [[\"_\"] * self.w for _ in range(self.h)]\n        legend = dict(self.legend)\n        i = 0\n        for name, cells in sorted(self.marks.items()):\n            c = chars[i]; i += 1\n            while c in legend: c = chars[i]; i += 1\n            legend[c] = f'marker = \"{name}\"'\n            for (x, z) in cells:\n                overlay[z][x] = c\n        lines += [\"[[layout.layer]]\", \"y = 0\", \"map = '''\"] + [\"\".join(r) for r in overlay] + [\"'''\", \"\"]\n        legend[\"_\"] = \"\"\n        for c, body in legend.items():\n            lines.append(f\"[layout.legend.'{c}']\")\n            if body: lines.append(body)\n            lines.append(\"\")\n        for o in self.objects:\n            lines.append(\"[[object]]\")\n            for k, v in o.items():\n                lines.append(f\"{k} = {toml_val(v)}\")\n            lines.append(\"\")\n        for n in self.npcs:\n            lines.append(\"[[npc]]\")\n            for k, v in n.items():\n                lines.append(f\"{k} = {toml_val(v)}\")\n            lines.append(\"\")\n        (OUT / f\"{self.name}.toml\").write_text(\"\\n\".join(lines))\n\nSEA = \"#8fdde0\"\ndef base_view(sky=\"#d6eef6\", elev=52.0, az=160.0, sun=0.62, amb=1.15, sea=SEA, fog_start=25.0, fog_end=110.0, exposure=1.0, sat=0.95, fog_color=None):\n    v = {\"sky\": sky, \"exposure\": exposure, \"saturation\": sat, \"bloom\": 0.15, \"bloom_threshold\": 1.3, \"outlines_on\": \"objects\",\n         \"outline_px\": 1.0, \"outline_darken\": 0.55, \"rim\": 0.3, \"fog\": True, \"fog_start\": fog_start, \"fog_end\": fog_end, \"wind\": 0.5,\n         \"light.sun_elevation\": elev, \"light.sun_azimuth\": az, \"light.sun_intensity\": sun, \"light.ambient\": amb,\n         \"cutaway.height_cut\": False, \"cutaway.front_cut\": False, \"cutaway.fade\": False,\n         \"filter.transition\": \"iris\", \"filter.transition_time\": 0.8}\n    return v\ndef water_legend(color=SEA, floor=-3.0):\n    return f'blocks = [{{ y0 = {floor - 0.2}, y1 = {floor}, color = \"{color}\", look = \"flat\" }}]\\nzone = {{ kind = \"water\", y0 = {floor}, y1 = 0.0, color = \"{color}\" }}'\ndef far_sea(r, color=SEA):\n    r.obj(None, 0, -0.12, 0, name=\"far_sea\", shape={\"type\": \"cylinder\", \"half_height\": 0.05, \"radius\": 240.0}, color=color, look=\"flat\")\n\n# People.\nPIP = dict(skin=\"#8fd3ff\", shirt=\"#8fd3ff\", eyes=\"#263e54\", scale=0.72, squash=2.0, accent=\"#5fb0e0\", parts=[{\"kind\": \"spikes\", \"size\": 0.3, \"count\": 1, \"color\": \"#5fb0e0\"}])\nPOSEY = dict(skin=\"#d8b184\", shirt=\"#d8b184\", pants=\"#c79f6e\", shoes=\"#c79f6e\", eyes=\"#d8b184\", scale=1.05, leg_length=0.98)\nKETTLE = dict(skin=\"#2b2f36\", shirt=\"#2b2f36\", eyes=\"#ffffff\", scale=1.0, squash=0.2, parts=[{\"kind\": \"handle\", \"size\": 1.2, \"color\": \"#2b2f36\"}])\nBOUNCE = dict(skin=\"#ffa8c0\", shirt=\"#ffa8c0\", eyes=\"#263e54\", scale=1.25, squash=2.0)\ndef guest(shirt=\"#fbfaf6\", pants=\"#fbfaf6\", skin=\"#eebd94\", helm=\"hood\", helm_color=\"#f5f2ec\", **k):\n    d = dict(shirt=shirt, pants=pants, skin=skin, shoes=\"#d9d4c5\", **k)\n    d[\"gear\"] = {\"helm\": helm, \"helm_color\": helm_color}\n    return d\n\ndef islet(r, x, z, size=7.0, palms=2, rng=None):\n    r.obj(None, x, -0.25, z, shape={\"type\": \"cylinder\", \"half_height\": 0.3, \"radius\": size}, color=\"#f6e7c8\", look=\"flat\", body=\"none\")\n    rng = rng or random\n    for i in range(palms):\n        a = rng.uniform(0, 6.28)\n        r.obj(\"LIB/core/palm\", x + math.cos(a) * size * 0.4, 0.0, z + math.sin(a) * size * 0.4, yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.2))\n\n# ------------------------------------------------------------------ the hub: Tippy Cay itself\ndef hub():\n    W, H, cx, cz = 76, 60, 38, 30\n    r = Room(\"hub\", W, H, (cx, cz))\n    rng = random.Random(7)\n    for z in range(H):\n        for x in range(W):\n            dx, dz = x + 0.5 - (cx + 0.5), z + 0.5 - (cz + 0.5)\n            land = (abs(dx) / 29) ** 4 + (abs(dz) / 21) ** 4\n            ring = ((abs(dx) / 22) ** 3 + (abs(dz) / 15) ** 3) ** (1 / 3)\n            plaza = (dx / 8.5) ** 2 + (dz / 6.5) ** 2\n            if land > 1.0: c = \"~\"\n            elif abs(ring - 1) < 0.075: c = \"p\"\n            elif plaza < 1: c = \"d\"\n            elif land > 0.62 or ring > 1.09: c = \"s\"\n            else: c = \"g\" if (x * 7 + z * 13) % 11 > 2 else \"h\"\n            r.grid[z][x] = c\n    r.legend = {\n        \"~\": water_legend(),\n        \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]',\n        \"g\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#bfe6b0\", look = \"flat\" }]\\ngrass = { density = 3, height = 0.32, color = \"#a8dc98\" }',\n        \"h\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#b8e2a8\", look = \"flat\" }]',\n        \"p\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#efe7d6\", look = \"flat\" }]',\n        \"d\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#fbfaf6\", look = \"flat\" }]',\n    }\n    r.view = base_view(fog_start=45.0, fog_end=150.0)\n    far_sea(r)\n    # Reception.\n    r.obj(\"LIB/core/reception_desk\", 0, 0, -3, body=\"fixed\", name=\"desk\")\n    r.npc(\"pip\", \"blob\", 0, -3, y=1.0, yaw=0, look=PIP)\n    r.obj(\"LIB/core/calendar_wall\", -5.5, 0, -3.5, yaw=20, body=\"fixed\")\n    r.obj(\"LIB/core/minute_clam\", 5.5, 0, -3.2, yaw=-20, body=\"fixed\", name=\"clam\")\n    r.obj(\"LIB/core/wardrobe_rack\", -7, 0, 1.2, yaw=70, body=\"fixed\")\n    r.obj(\"LIB/core/umbrella\", 7.5, 0, 2.2, roles={\"$accent\": \"#ff786e\"})\n    r.obj(\"LIB/core/lounge_chair\", 8.6, 0, 3.3, yaw=-30, body=\"none\")\n    r.mark(\"int_calendar\", cx - 5, cz - 2); r.mark(\"int_clam\", cx + 5, cz - 1); r.mark(\"int_wardrobe\", cx - 6, cz + 2)\n    # Pavilions and their mats, inside the ring.\n    pav = [(\"mat_studio\", -13, -8, \"#c4e8d8\", -12), (\"mat_gazebo\", 13, -8, \"#ffe2b0\", 12), (\"mat_boardwalk\", 13, 8, \"#ffc4d6\", 12), (\"mat_lagoon\", -13, 8, \"#b0e0f0\", -12)]\n    for name, x, z, col, _ in pav:\n        r.obj(\"LIB/core/pavilion\", x, 0, z, roles={\"$accent\": col}, body=\"fixed\")\n        sx, sz = (1 if x < 0 else -1), (1 if z < 0 else -1)\n        mx, mz = x + sx * 4.8, z + sz * 3.8\n        r.obj(\"LIB/core/exercise_mat\", mx, 0.01, mz, yaw=math.degrees(math.atan2(sx, sz)), roles={\"$accent\": col})\n        r.mark(name, cx + mx, cz + mz)\n    # Cabanas on the south beach.\n    for i, x in enumerate([-16, -8, 0, 8, 16]):\n        cols = [\"#46bec8\", \"#ff786e\", \"#ffd166\", \"#78dcaa\", \"#c4b1e8\"]\n        r.obj(\"LIB/core/cabana\", x, 0, 19 - abs(x) * 0.05, yaw=180, roles={\"$accent\": cols[i]}, body=\"fixed\")\n    r.mark(\"int_cabana\", cx, cz + 16)\n    # The pier, tower and rowboat, to the east.\n    r.obj(None, 36, -0.12, 0, shape={\"type\": \"rounded_box\", \"half\": [10.0, 0.14, 1.5], \"radius\": 0.1}, color=\"#e0c89a\", body=\"none\")\n    for i in range(5):\n        r.obj(\"LIB/core/mooring_post\", 28 + i * 4, -0.6, 1.7, scale=0.5)\n    r.obj(\"LIB/core/diving_tower\", 40, 0, -10, yaw=90)\n    r.mark(\"int_stand\", cx + 25, cz + 1)\n    r.obj(\"LIB/core/exercise_mat\", 25, 0.01, 1, yaw=90, roles={\"$accent\": \"#ff786e\"})\n    r.obj(\"LIB/core/rowboat\", 31, -0.2, 7, name=\"rowboat\")\n    r.mark(\"end_dock\", cx + 31, cz + 7)\n    # Palms, loungers and a smoothie stand.\n    placed = 0\n    while placed < 38:\n        a = rng.uniform(0, 6.283); k = rng.uniform(0.62, 0.98)\n        c, s = math.cos(a), math.sin(a)\n        x = math.copysign(abs(c) ** 0.5, c) * 28 * k; z = math.copysign(abs(s) ** 0.5, s) * 20 * k\n        ring = ((abs(x) / 22) ** 3 + (abs(z) / 15) ** 3) ** (1 / 3)\n        if abs(ring - 1) < 0.16 or (z > 15 and abs(x) < 20) or (x > 20 and abs(z) < 4):\n            continue\n        r.obj(\"LIB/core/palm\", x, 0, z, yaw=rng.uniform(0, 360), scale=rng.uniform(0.75, 1.25), sway=\"leaves\")\n        placed += 1\n    for (x, z, y) in [(-22, -3, 90), (-22, 0, 90), (-22, 3, 90), (22, 8, -90), (19, 12, -60)]:\n        r.obj(\"LIB/core/lounge_chair\", x, 0, z, yaw=y)\n        r.obj(\"LIB/core/umbrella\", x + 1.2, 0, z - 1, roles={\"$accent\": rng.choice([\"#46bec8\", \"#ffd166\", \"#ff786e\"])})\n    r.obj(\"LIB/core/market_stall\", 0, 0, 9, yaw=180, body=\"fixed\")\n    # People.\n    r.npc(\"posey_hub\", \"biped\", -9.5, -3.2, yaw=120, look=POSEY)\n    r.npc(\"kettle_hub\", \"blob\", 9.5, -4.0, yaw=-120, look=KETTLE)\n    r.npc(\"bounce_hub\", \"blob\", 10.5, 6.5, yaw=-140, hop=0.7, look=BOUNCE)\n    r.obj(\"LIB/core/gull_captain\", -10.5, 0, 6.3, yaw=130, body=\"fixed\", name=\"commodore\")\n    r.mark(\"int_gull\", cx - 10, cz + 6)\n    r.npc(\"marjorie\", \"biped\", -3.5, 4.5, yaw=30, look=guest())\n    r.npc(\"tom\", \"biped\", -5, 15, yaw=10, look=guest(shirt=\"#46bec8\", pants=\"#fbfaf6\", skin=\"#d9a074\", belt=\"#fbfaf6\"))\n    r.npc(\"twin_a\", \"biped\", 5, 5, yaw=-20, look=guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"))\n    r.npc(\"twin_b\", \"biped\", 6, 5, yaw=-20, look=guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"))\n    for i, (x, z) in enumerate([(-20, 8), (20, -7), (-3, -12), (16, 14), (-14, 14)]):\n        cols = [\"#fbfaf6\", \"#c4b1e8\", \"#78dcaa\", \"#ffb88a\", \"#f4f1e8\"]\n        skins = [\"#f6d7b8\", \"#8c5a3a\", \"#d9a074\", \"#5f3d29\", \"#eebd94\"]\n        r.npc(f\"guest{i}\", \"biped\", x, z, ai={\"type\": \"wander\", \"radius\": 5.0}, speed=0.35, look=guest(shirt=cols[i], skin=skins[i], helm=\"none\"))\n    # Lost flip-flops.\n    for (x, z) in [(10, 20), (17, -13), (-26, 4), (27, -5), (-17, -13)]:\n        r.mark(\"flipflop\", cx + x, cz + z)\n    r.write()\n\n# ------------------------------------------------------------------ one-event sets\ndef water_room(name, size=60, **kw):\n    r = Room(name, size, size, (size // 2, size // 2))\n    r.legend = {\"~\": water_legend(**kw)}\n    return r\n\ndef studio():\n    r = water_room(\"studio\", color=\"#a8e4e6\")\n    r.view = base_view(sky=\"#fbe6dc\", elev=14.0, az=95.0, sun=0.5, amb=1.25, fog_start=20.0, fog_end=95.0)\n    far_sea(r, \"#a8e4e6\")\n    r.obj(None, 0, -0.14, 0, name=\"deck\", shape={\"type\": \"cylinder\", \"half_height\": 0.14, \"radius\": 5.8}, color=\"#fbfaf6\", body=\"none\")\n    r.obj(None, 0, -0.1, 0, shape={\"type\": \"cylinder\", \"half_height\": 0.12, \"radius\": 6.1}, color=\"#e8e2d4\", body=\"none\")\n    r.obj(\"LIB/core/exercise_mat\", 0, 0.01, 0, roles={\"$accent\": \"#c4e8d8\"})\n    r.obj(\"LIB/core/exercise_mat\", 2.4, 0.01, 0.2, roles={\"$accent\": \"#ffd9c4\"})\n    r.npc(\"posey\", \"biped\", 2.4, 0.2, yaw=0, look=POSEY)\n    r.npc(\"pip_check\", \"blob\", -3.2, -2.0, yaw=0, look=PIP)\n    rng = random.Random(3)\n    for (x, z, s, p) in [(-20, -16, 7, 3), (16, -22, 6, 2), (-9, -30, 5, 2), (26, -8, 5, 2), (-30, 2, 6, 2)]:\n        islet(r, x, z, s, p, rng)\n    for (x, z) in [(-7, -5), (7, -6)]:\n        r.obj(\"LIB/core/lamp_post\", x, -0.0, z)\n    r.write()\n\ndef gazebo():\n    r = Room(\"gazebo\", 60, 60, (30, 30))\n    for z in range(60):\n        for x in range(60):\n            d = math.hypot(x - 30, z - 30)\n            r.grid[z][x] = \"~\" if d > 22 else (\"s\" if d > 16 else \"g\")\n    r.legend = {\"~\": water_legend(color=\"#a6d8d0\"),\n                \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6dfb4\", look = \"flat\" }]',\n                \"g\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#cfe6a0\", look = \"flat\" }]\\ngrass = { density = 4, height = 0.34, color = \"#bcdc88\" }'}\n    r.view = base_view(sky=\"#ffe6c2\", elev=18.0, az=250.0, sun=0.85, amb=1.0, sat=1.0, fog_start=25.0, fog_end=100.0)\n    far_sea(r, \"#a6d8d0\")\n    r.obj(\"LIB/core/iron_gazebo\", 0, 0, 0)\n    r.obj(\"LIB/core/exercise_mat\", 0, 0.11, 0, roles={\"$accent\": \"#ffe2b0\"})\n    r.npc(\"kettle\", \"blob\", 2.8, -0.2, yaw=-30, look=KETTLE)\n    r.obj(\"LIB/core/kettle_rack\", -3.6, 0.1, -2.2, yaw=30)\n    rng = random.Random(5)\n    for i in range(11):\n        a = i * 0.57 + 0.3\n        r.obj(\"LIB/core/palm\", math.cos(a * 2.1) * rng.uniform(10, 18), 0, -abs(math.sin(a * 2.1)) * rng.uniform(9, 17) - 2, yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.3), sway=\"leaves\")\n    for (x, z, n) in [(-4.5, -7.5, \"g1\"), (5.2, -8.2, \"g2\")]:\n        r.npc(n, \"biped\", x, z, yaw=10, look=guest(helm=\"none\"), clips=[\"MESH2MOTION/Jumping Jacks\"])\n    r.write()\n\ndef boardwalk():\n    r = Room(\"boardwalk\", 70, 60, (35, 30))\n    for z in range(60):\n        for x in range(70):\n            r.grid[z][x] = \"~\" if z > 42 else \"s\"\n    r.legend = {\"~\": water_legend(color=\"#8fe0e8\"), \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'}\n    r.view = base_view(sky=\"#cdeefc\", elev=66.0, az=170.0, sun=0.75, amb=1.1, sat=1.0, fog_start=30.0, fog_end=120.0)\n    far_sea(r, \"#8fe0e8\")\n    r.obj(None, 0, -0.05, -1, name=\"planks\", shape={\"type\": \"rounded_box\", \"half\": [18.0, 0.1, 6.0], \"radius\": 0.05}, color=\"#e0c89a\", body=\"none\")\n    for i in range(18):\n        r.obj(None, -17 + i * 2, 0.056, -1, shape={\"type\": \"box\", \"half\": [0.02, 0.005, 6.0]}, color=\"#c8ae80\", body=\"none\")\n    r.obj(\"LIB/core/step_box\", 0, 0.05, 0, scale=1.2)\n    r.npc(\"bounce\", \"blob\", -4.2, -1.2, yaw=40, hop=0.62, look=BOUNCE)\n    for i, x in enumerate([-8, -6, -3, 3, 6, 8]):\n        cols = [\"#ffd166\", \"#78dcaa\", \"#c4b1e8\", \"#ff786e\", \"#46bec8\", \"#fbfaf6\"]\n        skins = [\"#f6d7b8\", \"#d9a074\", \"#8c5a3a\", \"#eebd94\", \"#5f3d29\", \"#b97f54\"]\n        r.npc(f\"clapper{i}\", \"biped\", x, -4.4 - (i % 2) * 0.8, yaw=0, look=guest(shirt=cols[i], pants=\"#f4f1e8\", skin=skins[i], helm=\"none\"))\n    r.obj(\"LIB/core/market_stall\", 11, 0, -5, yaw=-20, body=\"none\")\n    for (x, z, c) in [(-12, 3, \"#ff786e\"), (-15, -3, \"#ffd166\"), (14, 3, \"#46bec8\"), (-20, 8, \"#78dcaa\"), (20, 9, \"#ff786e\")]:\n        r.obj(\"LIB/core/umbrella\", x, 0, z, roles={\"$accent\": c})\n        r.obj(\"LIB/core/lounge_chair\", x + 1.3, 0, z + 0.4, yaw=20)\n    rng = random.Random(9)\n    for i in range(16):\n        r.obj(\"LIB/core/palm\", -30 + i * 4 + rng.uniform(-1, 1), 0, -13 - rng.uniform(0, 8), yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.3), sway=\"leaves\")\n    r.write()\n\ndef tide():\n    r = water_room(\"tide\")\n    r.view = base_view(sky=\"#d6eef6\", elev=58.0, az=150.0, sun=0.7, amb=1.1)\n    far_sea(r)\n    for x in [-11, 11, 22, -22]:\n        r.obj(\"LIB/core/tide_raft\", x, 0.2, 0)\n    r.obj(\"LIB/core/gull_captain\", 6.5, -0.6, -6.5, yaw=-30)\n    rng = random.Random(11)\n    for (x, z, s, p) in [(-26, -20, 6, 2), (24, -24, 7, 3), (0, -30, 5, 2)]:\n        islet(r, x, z, s, p, rng)\n    r.write()\n\ndef channel():\n    W, H = 56, 240\n    r = Room(\"channel\", W, H, (28, 225))\n    for z in range(H):\n        for x in range(W):\n            r.grid[z][x] = \"~\" if abs(x - 28) <= 12 else \"s\"\n    r.legend = {\"~\": water_legend(color=\"#7fd8dc\"), \"s\": 'blocks = [{ y0 = -0.5, y1 = 0, color = \"#f6e7c8\", look = \"flat\" }]'}\n    r.view = base_view(sky=\"#d0ecf8\", elev=55.0, az=140.0, sun=0.7, amb=1.1, fog_start=40.0, fog_end=120.0)\n    far_sea(r, \"#7fd8dc\")\n    rng = random.Random(13)\n    for i in range(44):\n        side = -1 if i % 2 else 1\n        r.obj(\"LIB/core/palm\", side * rng.uniform(14, 22), 0, 12 - i * 5.0, yaw=rng.uniform(0, 360), scale=rng.uniform(0.8, 1.3), sway=\"leaves\")\n    for i in range(10):\n        side = 1 if i % 2 else -1\n        r.obj(\"LIB/core/umbrella\", side * 14, 0, -i * 21.0, roles={\"$accent\": rng.choice([\"#46bec8\", \"#ffd166\", \"#ff786e\"])})\n    r.npc(\"cheer0\", \"biped\", -14, 4, yaw=60, look=guest(helm=\"none\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n    r.npc(\"cheer1\", \"biped\", 14, -200, yaw=-120, look=guest(shirt=\"#ffd166\", helm=\"none\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n    r.write()\n\ndef pier():\n    r = Room(\"pier\", 60, 150, (30, 125))\n    r.legend = {\"~\": water_legend(color=\"#93dce0\")}\n    r.view = base_view(sky=\"#d9eef4\", elev=46.0, az=120.0, sun=0.65, amb=1.15, fog_start=35.0, fog_end=120.0)\n    far_sea(r, \"#93dce0\")\n    r.obj(None, 0, -0.14, -52, name=\"pierdeck\", shape={\"type\": \"rounded_box\", \"half\": [2.8, 0.14, 60.0], \"radius\": 0.05}, color=\"#e0c89a\", body=\"none\")\n    for i in range(26):\n        z = 6 - i * 4.4\n        for s in (-1, 1):\n            r.obj(\"LIB/core/mooring_post\", s * 2.9, -0.5, z, scale=0.55)\n        if i % 3 == 0:\n            r.obj(\"LIB/core/lamp_post\", 2.5 * (1 if i % 2 else -1), 0, z)\n    r.npc(\"marjorie_pier\", \"biped\", 1.2, -103.2, yaw=0, look=guest())\n    r.obj(\"LIB/core/lounge_chair\", -1.4, 0, -105, yaw=180)\n    r.write()\n\ndef tower():\n    r = water_room(\"tower\", color=\"#8ad8e4\")\n    r.view = base_view(sky=\"#d0ecf8\", elev=60.0, az=120.0, sun=0.8, amb=1.1, sat=1.0, fog_start=30.0, fog_end=110.0)\n    far_sea(r, \"#8ad8e4\")\n    r.obj(\"LIB/core/diving_tower\", 0, 0, -3.4)\n    for x in (2.2, 4.4, -2.2):\n        r.obj(\"LIB/core/diving_board\", x, 6.0, 0)\n    r.obj(\"LIB/core/small_raft\", 9, 0.1, 11)\n    r.obj(\"LIB/core/gull\", 8.2, 0.4, 10.2, yaw=-90, scale=2.2, name=\"judge1\")\n    r.obj(\"LIB/core/gull\", 9.0, 0.4, 11.0, yaw=-90, scale=2.2, name=\"judge2\")\n    r.obj(\"LIB/core/gull\", 9.8, 0.4, 11.8, yaw=-90, scale=2.2, name=\"judge3\")\n    rng = random.Random(17)\n    for (x, z, s, p) in [(24, -2, 7, 3), (28, 14, 6, 2), (20, 24, 5, 2)]:\n        islet(r, x, z, s, p, rng)\n    r.write()\n\ndef bay():\n    r = water_room(\"bay\", color=\"#d8b0b8\")\n    r.view = base_view(sky=\"#ffb9a0\", elev=8.0, az=215.0, sun=0.95, amb=0.85, sat=1.05, fog_start=20.0, fog_end=95.0, exposure=1.0)\n    r.view[\"bloom\"] = 0.4\n    far_sea(r, \"#e8a8a0\")\n    r.obj(\"LIB/core/mooring_post\", 0, 0, 0, name=\"post\")\n    rafts = [(-5, -6), (0, -7.5), (5, -6), (-9, -3), (9, -3), (-3, -12), (3, -12), (-9, -10), (9, -10)]\n    for (x, z) in rafts:\n        r.obj(\"LIB/core/small_raft\", x, 0.05, z, scale=1.0, light={\"color\": \"#ffc080\", \"radius\": 7.0, \"intensity\": 2.0, \"offset\": [0.0, 1.6, 0.0]})\n    cast = [(\"crowd_pip\", \"blob\", PIP, -5, -6), (\"crowd_posey\", \"biped\", POSEY, 0, -7.5), (\"crowd_kettle\", \"blob\", KETTLE, 5, -6),\n            (\"crowd_bounce\", \"blob\", BOUNCE, -9, -3), (\"crowd_marjorie\", \"biped\", guest(), 9, -3),\n            (\"crowd_tom\", \"biped\", guest(shirt=\"#46bec8\", belt=\"#fbfaf6\"), -3, -12), (\"crowd_twin_a\", \"biped\", guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"), 3, -12),\n            (\"crowd_twin_b\", \"biped\", guest(shirt=\"#ffd166\", pants=\"#ff786e\", helm=\"cap\", helm_color=\"#ffd166\"), 3.9, -12)]\n    for (name, kind, look, x, z) in cast:\n        extra = {\"hop\": 0.7} if name == \"crowd_bounce\" else {}\n        r.npc(name, kind, x, z, y=0.25, yaw=math.degrees(math.atan2(-x, -z)), look=look, **extra)\n    for i, (x, z) in enumerate([(-9.6, -10.2), (-8.4, -9.6), (8.6, -10), (9.6, -10.4)]):\n        r.npc(f\"crowd_band{i}\", \"biped\", x, z, y=0.25, yaw=0, look=guest(shirt=\"#ff786e\", helm=\"cap\", helm_color=\"#ff786e\"), clips=[\"MESH2MOTION/Cheering_Two_Hands\"])\n    rng = random.Random(19)\n    for (x, z, s, p) in [(-28, -26, 8, 3), (30, -30, 7, 3)]:\n        islet(r, x, z, s, p, rng)\n    r.write()\n\nfor f in (hub, studio, gazebo, boardwalk, tide, channel, pier, tower, bay):\n    f()\nprint(\"sets written\")\nEOF\npython3 tools/make_sets.py; cd engine; python3 - <<'EOF'\np='crates/pav_core/src/games/fit/island.rs'\ns=open(p).read()\ns=s.replace(\"\"\"        (Who::Gull, \"gull_hub\"),\n\"\"\",\"\")\ns=s.replace(\"\"\"    out\n}\n\n/// A step toward\"\"\",\"\"\"    if let Some(pos) = set_markers(sim, Set::Hub, \"int_gull\").first().copied() {\n        out.push(Interact { spot: Spot::Talk(Who::Gull), pos, id: None });\n    }\n    out\n}\n\n/// A step toward\"\"\")\nopen(p,'w').write(s)\nEOF\nfor s in hub studio gazebo boardwalk tide channel pier tower bay; do echo \"== $s\"; ./target/debug/pav room_check path=crates/pav_core/src/games/fit/sets/$s.toml 2>&1 | cut -c1-400 | head -5; done","description":"Write clips and sets generators and check the sets","timeout":120000}}}
