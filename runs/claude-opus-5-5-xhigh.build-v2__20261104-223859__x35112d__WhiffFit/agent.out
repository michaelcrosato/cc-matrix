right things (0 = off)\");\ncrates/pav_view/src/build.rs:506:        v.float(\"bloom_threshold\", &mut self.bloom_threshold, 0.2, 4.0, \"Brightness where glow starts\");\ncrates/pav_view/src/build.rs:537:        nested(v, \"light\", &mut self.light);\n//! Live-tunable parameters. Any struct implementing `Tunable` exposes its fields through a\n//! visitor, which powers the tuning panel, agent get/set by path, and preset files, with no\n//! string lookups in game code (values stay plain struct fields).\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(untagged)]\npub enum ParamValue {\n    Bool(bool),\n    Int(i64),\n    Float(f64),\n    Text(String),\n}\n\nimpl ParamValue {\n    pub fn as_f64(&self) -> Option<f64> {\n        match self {\n            ParamValue::Float(f) => Some(*f),\n            ParamValue::Int(i) => Some(*i as f64),\n            ParamValue::Bool(b) => Some(*b as i64 as f64),\n            ParamValue::Text(t) => t.parse().ok(),\n        }\n    }\n    pub fn as_bool(&self) -> Option<bool> {\n        match self {\n            ParamValue::Bool(b) => Some(*b),\n            ParamValue::Int(i) => Some(*i != 0),\n            ParamValue::Float(f) => Some(*f != 0.0),\n            ParamValue::Text(t) => match t.as_str() {\n                \"true\" | \"on\" | \"yes\" | \"1\" => Some(true),\n                \"false\" | \"off\" | \"no\" | \"0\" => Some(false),\n                _ => None,\n            },\n        }\n    }\n    pub fn from_json(v: &serde_json::Value) -> Option<Self> {\n        serde_json::from_value(v.clone()).ok()\n    }\n    pub fn to_json(&self) -> serde_json::Value {\n        serde_json::to_value(self).unwrap_or(serde_json::Value::Null)\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize)]\npub enum ParamKind {\n    Float { min: f32, max: f32 },\n    Int { min: i32, max: i32 },\n    Bool,\n    Choice { options: Vec<String> },\n}\n\n#[derive(Clone, Debug, Serialize)]\npub struct ParamInfo {\n    pub path: String,\n    pub kind: ParamKind,\n    pub value: ParamValue,\n    pub help: String,\n131:pub fn list(t: &mut dyn Tunable) -> Vec<ParamInfo> {\n132-    struct L {\n133-        p: PathTracker,\n134-        out: Vec<ParamInfo>,\n135-    }\n136-    impl ParamVisitor for L {\n137-        fn float(&mut self, name: &str, v: &mut f32, min: f32, max: f32, help: &str) {\n138-            self.out.push(ParamInfo {\n139-                path: self.p.path(name),\n140-                kind: ParamKind::Float { min, max },\n141-                value: ParamValue::Float(*v as f64),\n142-                help: help.into(),\n143-            });\n144-        }\n145-        fn int(&mut self, name: &str, v: &mut i32, min: i32, max: i32, help: &str) {\n--\n250:pub fn set(t: &mut dyn Tunable, path: &str, value: ParamValue) -> Result<(), String> {\n251-    let mut m = BTreeMap::new();\n252-    m.insert(path.to_string(), value);\n253-    let missing = apply_map(t, &m);\n254-    if missing.is_empty() { Ok(()) } else { Err(format!(\"unknown parameter '{path}'\")) }\n255-}\n256-\n257:pub fn get(t: &mut dyn Tunable, path: &str) -> Option<ParamValue> {\n258-    list(t).into_iter().find(|p| p.path == path).map(|p| p.value)\n259-}\n260-\n261-#[cfg(test)]\n262-mod tests {\n263-    use super::*;\n264-\n265-    choice_enum! {\n266-        enum Mode { A => \"alpha\", B => \"beta\" }\n267-    }\n268-\n269-    struct Inner {\n270-        speed: f32,\n271-    }","is_error":false}]},"parent_tool_use_id":null,"session_id":"0691f0d6-f08e-44c9-b7bd-c57d7fb96b71","uuid":"c196325e-f397-409a-88cf-84a1372a31db","timestamp":"2026-11-05T05:40:28.137Z","tool_use_result":{"stdout":"//! Attachments: horns, antlers, spikes, crests, tusks, mandibles, shell plates, extra eyes,\n//! floating orbs and wings that go on *any* body plan. Each body builder reports a few anchor\n//! points (head, back line, shoulders); the parts are drawn from those, so a spider can grow\n//! antlers and a blob can have wings. This is the \"Spore\" layer of the monster genome.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse crate::color::Color;\n\ncrate::choice_enum! {\n    /// Kinds of attachment.\n    #[derive(Default)]\n    pub enum AttachKind {\n        #[default]\n        Horns => \"horns\",\n        Antlers => \"antlers\",\n        Spikes => \"spikes\",\n        Crest => \"crest\",\n        Tusks => \"tusks\",\n        Mandibles => \"mandibles\",\n        Plates => \"plates\",\n        Eyes => \"eyes\",\n        Orbs => \"orbs\",\n        Wings => \"wings\",\n    }\n}\n\nimpl AttachKind {\n    pub const ALL: [AttachKind; 10] = [\n        AttachKind::Horns,\n        AttachKind::Antlers,\n        AttachKind::Spikes,\n        AttachKind::Crest,\n        AttachKind::Tusks,\n        AttachKind::Mandibles,\n        AttachKind::Plates,\n        AttachKind::Eyes,\n        AttachKind::Orbs,\n        AttachKind::Wings,\n    ];\n}\n\n/// One attachment on a puppet.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Attach {\n    pub kind: AttachKind,\n    /// Size multiplier (1 = normal).\n    pub size: f32,\n    /// How many (spikes, plates, eyes, orbs; 0 = the kind's usual number).\n    pub count: u32,\n    /// Colour (\"\" = the puppet's accent colour).\n    pub color: String,\n    /// Shine (orbs and eyes glow by default).\n    pub glow: f32,\n}\n\nimpl Default for Attach {\n    fn default() -> Self {\n        Self { kind: AttachKind::Horns, size: 1.0, count: 0, color: String::new(), glow: 0.0 }\n    }\n}\n\n/// Where parts attach, in the space the body builder works in.\n#[derive(Clone, Debug)]\npub struct Anchors {\n    pub head: Vec3,\n    pub head_r: f32,\n    /// The head's forward, the body's up and right.\n    pub fwd: Vec3,\n    pub up: Vec3,\n    pub right: Vec3,\n    /// Points along the back (front to rear), the back's thickness, and which way is \"out of\n    /// the back\" (up for creatures, backward for bipeds).\n    pub back: Vec<Vec3>,\n    pub back_r: f32,\n    pub back_out: Vec3,\n    pub shoulders: [Vec3; 2],\n    pub center: Vec3,\n    /// Overall size (puppet scale).\n    pub k: f32,\n}\n\n/// A point `t` (0..1) along a polyline.\nfn along(pts: &[Vec3], t: f32) -> Vec3 {\n    match pts.len() {\n        0 => Vec3::ZERO,\n        1 => pts[0],\n        n => {\n            let x = t.clamp(0.0, 1.0) * (n - 1) as f32;\n            let i = (x.floor() as usize).min(n - 2);\n            pts[i].lerp(pts[i + 1], x - i as f32)\n        }\n    }\n}\n\n/// Draws the attachments. `push(a, b, ra, rb, colour, glow)` adds one capsule.\npub fn attach(parts: &[Attach], accent: Color, a: &Anchors, time: f32, push: &mut dyn FnMut(Vec3, Vec3, f32, f32, Color, f32)) {\n    let (f, u, r) = (a.fwd, a.up, a.right);\n    let hr = a.head_r.max(0.06 * a.k);\n    for p in parts {\n        let c = Color::try_hex(&p.color).unwrap_or(accent);\n        let s = p.size.max(0.1);\n        let g = p.glow;\n        match p.kind {\n            AttachKind::Horns => {\n                for sd in [-1.0f32, 1.0] {\n                    let base = a.head + u * hr * 0.6 + r * sd * hr * 0.55;\n                    let mid = base + (u * 0.75 + r * sd * 0.35 - f * 0.2) * hr * s;\n                    let tip = mid + (u * 0.35 - f * 0.55 + r * sd * 0.1) * hr * s;\n                    push(base, mid, hr * 0.2 * s.sqrt(), hr * 0.13 * s.sqrt(), c, g);\n                    push(mid, tip, hr * 0.13 * s.sqrt(), hr * 0.03, c, g);\n                }\n            }\n            AttachKind::Antlers => {\n                for sd in [-1.0f32, 1.0] {\n                    let base = a.head + u * hr * 0.75 + r * sd * hr * 0.4;\n                    let mid = base + (u * 0.8 + r * sd * 0.6) * hr * s;\n                    let tip = mid + (u * 0.9 + r * sd * 0.3 - f * 0.2) * hr * s;\ncrates/pav_view/src/build.rs:724:            if let SimEvent::Explosion { pos, radius } = e {\ncrates/pav_view/src/build.rs:728:            if let SimEvent::Splash { pos } = e {\ncrates/pav_view/src/build.rs:731:            if let SimEvent::Destroyed { pos, size } = e {\ncrates/pav_view/src/build.rs:735:                SimEvent::Slam { pos, radius } => self.shocks.push((*pos, radius * 2.5, self.last_time.unwrap_or(0.0))),\ncrates/pav_view/src/build.rs:736:                SimEvent::Blast { pos, .. } => self.shocks.push((*pos, 4.0, self.last_time.unwrap_or(0.0))),\ncrates/pav_view/src/build.rs:740:                SimEvent::Explosion { pos, radius } => {\ncrates/pav_view/src/build.rs:743:                SimEvent::Land { pos, speed } if *speed > 6.0 => {\ncrates/pav_view/src/build.rs:746:                SimEvent::Hit { pos, .. } => self.effects.push(Effect {\ncrates/pav_view/src/build.rs:751:                SimEvent::Splash { pos } => self.effects.push(Effect {\ncrates/pav_view/src/build.rs:756:                SimEvent::Break { pos } => self.effects.push(Effect {\ncrates/pav_view/src/build.rs:761:                SimEvent::Bounce { pos } => self.effects.push(Effect {\ncrates/pav_view/src/build.rs:766:                SimEvent::Respawn { pos } => self.effects.push(Effect {\n17:[camera]\n18-# tilt = 70.0\n19-# ortho = false\n20-\n21-# Station guide (H in the game, the room card's \"How it works\" button, `pav room`): what you\n22-# see, how it works, where games use it, how to ask for it. Every room has one; the test\n23-# crates/pav_view/tests/learn.rs checks the words, settings and code files it names.\n24-# [learn]\n25-# what = \"What the visitor is looking at, naming the room's exhibits and pads.\"\n26-# how = [\"Step one: the technique as the engine does it.\", \"Step two...\"]\n27-# uses = [\"Title: where games use it (real games).\"]\n28-# ask = [\"phrases to paste into a request for this\"]\n29-# cost = \"What it costs and what makes it cost more.\"\n30-# knobs = [\"view.bloom\", \"movement.jump_height\"]   # live sliders (paths from `pav params`)\n31-# terms = [\"bloom\", \"hdr\"]         