gs::GRASS` (tufts that part around the player)).\n--- attract times\n/// Attract mode: an island sweep, then each event, then the title card; round again.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Attract {\n    pub seg: usize,\n    pub t: f32,\n    pub run: Option<EventRun>,\n    pub cycles: u32,\n}\n\n/// The order of attract's events.\npub const ATTRACT: [EventKind; 12] = [\n    EventKind::CannonballCup,\n    EventKind::PaddleSlalom,\n    EventKind::StepParty,\n    EventKind::PoseParade,\n    EventKind::TideTable,\n    EventKind::FloatieSpin,\n    EventKind::TrayTrek,\n    EventKind::PlankStandoff,\n    EventKind::MorningLap,\n    EventKind::BreathBloom,\n    EventKind::TempoSquats,\n    EventKind::BigStand,\n];\n6:        let seg = self.rules.flow.attract_segment;\n7:        let end_seg = |a: &mut Attract, this: &FitGame, sim: &mut Sim, ev: &mut Vec<SimEvent>| {\n13:        if a.seg == 0 {\n15:            if a.t >= 8.0 {\n16:                a.seg = 1;\n19:            if a.seg == 1 {\n22:        } else if a.seg <= n {\n24:                let kind = ATTRACT[a.seg - 1];\n27:                run.limit = Some(seg);\n52:                end_seg(a, self, sim, ev);\n53:                a.seg += 1;\n55:                if a.seg > n {\n--- gull rig\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct GullRig {\n    pub body: Option<EntityId>,\n    pub wings: Vec<EntityId>,\n    pub center: Vec3,\n    pub radius: f32,\n    pub speed: f32,\n    pub angle: f32,\n    pub height: f32,\n    pub phase: f32,\n}\n\npub fn spawn_gulls(sim: &mut Sim, stage: Vec3) -> Vec<GullRig> {\n    let mut out = Vec::new();\n    for i in 0..3 {\n        let f = i as f32;\n        let center = stage + Vec3::new(-8.0 + f * 7.0, 0.0, -2.0 + f * 3.0);\n        let body = spawn_prop(sim, \"LIB/core/gull\", center, 0.0, 1.0);\n        let wing_l = spawn_prop(sim, \"LIB/core/gull_wing\", center, 0.0, 1.0);\n        let wing_r = spawn_prop(sim, \"LIB/core/gull_wing\", center, std::f32::consts::PI, 1.0);\n        out.push(GullRig {\n            body: Some(body),\n            wings: vec![wing_l, wing_r],\n            center,\n            radius: 15.0 + f * 5.0,\n            speed: 0.3 - f * 0.05,\n            angle: f * 2.0,\n            height: 9.0 + f * 1.5,\n            phase: f,\n        });\n    }\n    out\n}\n\nfn tick_gulls(gulls: &mut [GullRig], sim: &mut Sim, t: f32, dt: f32) {\n    for g in gulls.iter_mut() {\n        g.angle += g.speed * dt;\n        let dir = Vec3::new(g.angle.cos(), 0.0, g.angle.sin());\n        let at = g.center + dir * g.radius + Vec3::Y * (g.height + (t * 0.6 + g.phase).sin() * 0.8);\n        let yaw = (-dir.z).atan2(dir.x) + std::f32::consts::FRAC_PI_2 + std::f32::consts::PI;\n        let rot = Quat::from_rotation_y(yaw);\n        if let Some(body) = g.body {\n            pose(sim, body, at, rot);\n        }\n        let flap = (t * 7.0 + g.phase * 3.0).sin() * 0.55;\n        for (i, w) in g.wings.clone().into_iter().enumerate() {\n            let side = if i == 0 { 1.0 } else { -1.0 };\n            let q = rot * Quat::from_rotation_z(side * flap) * if i == 1 { Quat::from_rotation_y(std::f32::consts::PI) } else { Quat::IDENTITY };\n            pose(sim, w, at + Vec3::Y * 0.06, q);\n        }\n    }\n}\n\n/// Builds the About pages from the page's plain-text block (`about-data`), or says nothing is there.\npub fn about_pages(text: &str) -> Vec<(String, String)> {\n    let Ok(v) = serde_json::from_str::<serde_json::Value>(text) else {\n        return vec![(super::TITLE.to_string(), \"A game about standing.\".to_string())];\n    };\n    let mut out = Vec::new();\n{\"format\": 2, \"name\": \"gull_captain\", \"unit\": \"cm\", \"description\": \"Commodore Gull: a gull in a captain's cap, on a mooring post.\", \"tags\": [\"gull\", \"captain\"], \"category\": \"furniture\", \"materials\": {\"post\": {\"color\": \"#c9a26b\"}, \"c\": {\"color\": \"#263e54\"}, \"w\": {\"color\": \"#fbfaf6\"}, \"b\": {\"