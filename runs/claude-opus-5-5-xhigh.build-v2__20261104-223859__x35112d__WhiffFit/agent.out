mport json, re, pathlib, hashlib\ndev = pathlib.Path('.').resolve(); root = dev.parent\nname = 'WhiffFit-WiiFit-claude-opus-5-5-xhigh-20261104-223859'\nhtml = root / f'{name}.html'; ex = root / 'exit-interview.json'\nproblems = []\ndef need(ok, what):\n    if not ok: problems.append(what)\nneed(html.exists(), 'no html'); need(ex.exists(), 'no interview')\npage = html.read_text(encoding='utf-8', errors='replace')\nneed(hashlib.sha256(html.read_bytes()).hexdigest()[:16] == (dev/'notes/.audit/page.sha').read_text().strip(), 'page changed since the tests')\nd = json.loads(ex.read_text(encoding='utf-8'))\nneed(list(d) == ['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'], f'interview keys {list(d)}')\nneed(d['sourceInformation']['usage'] == 'added on import', 'usage')\nm = re.search(r'<script id=\"about-data\" type=\"application/json\">(.*?)</script>', page, re.S)\nneed(m is not None, 'no about-data')\nif m:\n    a = json.loads(m.group(1).replace('<\\\\/', '</'))\n    for k in ('sourceInformation','testingFeedback','engineFeedback','promptFeedback'):\n        need(a.get(k) == d[k], f'About differs from the interview at {k}')\n    need(a.get('credits') == (dev/'notes/credits.txt').read_text(encoding='utf-8').strip(), 'credits')\nneed(re.search(r'<title>Whiff Fit — A balance comedy at Tippy Cay</title>', page) is not None, 'title')\nneed(f'<script>{(dev/\"hub/session.js\").read_text(encoding=\"utf-8\")}</script>' in page, 'client not byte for byte')\nfor t in ['session\" content=\"1\"','session-players\" content=\"1-4\"','session-mode\" content=\"ghost\"','session-minutes\" content=\"3\"','webgpu\" content=\"required\"']:\n    need(t in page, t)\next = [u for u in re.findall(r'(?:src|href)=\"(https?://[^\"]+)\"', page[:page.find('</head>')]) ]\nneed(not ext, f'external refs {ext[:3]}')\nbad = []\nfor f in list((dev/'engine/crates/pav_core/src/games/fit').rglob('*')) + list((dev/'tests').glob('*')) + list((dev/'tools').glob('*')):\n    if f.is