{"type":"item.started","item":{"id":"item_779","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' labs/game/main.ts; printf '\\\\n--- WOBBLE ---\\\\n'; cat labs/game/wobble.ts; printf '\\\\n--- PROGRAMME ---\\\\n'; cat labs/game/programme.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
