lp: \"Runs a dev action between steps, recorded in the replay: actions.run('travel', { at: [3, 0, 5] }).\",\nengine/dev/actions.ts:71:    name: { type: 'string', required: true, description: 'Its name, as actions.list() shows it.' },\nengine/dev/actions.ts:72:    args: { type: 'object', description: 'Its arguments, as actions.list() names them.' },\nengine/dev/actions.ts:93:    if (!scene.level && !scene.site) throw codeError('SIM_BAD_ARGUMENT', { where: '__engine.bot()', value: scene.id, expected: 'a scene with a level or a site for the bot to read (defineScene({ level }))' }); // prettier-ignore\nengine/dev/inspector.ts:199:    help: 'Runs n sim steps through the clock, recorded in the session (without intents, what the virtual device holds: input.hold, input.axis…); returns the tick after them.',\nengine/dev/inspector.ts:205:          'One intents object for every step (its pressed buttons, p, on the first only), or a list of one per step (none past its end); none samples the virtual device each step (__engine.input).',\nengine/dev/feel/course.ts:3: * scripted run of a scene, as a replay holds one (its scene, settings, seed, steps and change-point inputs, dev actions\nengine/dev/bot.ts:3: * intents, as a virtual device would, for play longer and more varied than a scripted replay (soaks, navigation smoke).\nengine/dev/bot.ts:29: * and plan it plays the same steps. Carried from `my-3d2dge:src/emberdeep/93-autopilot.js` (the virtual input, the\nengine/dev/feel/panel.ts:38:  input: { record(): unknown };\nengine/app/view.ts:268:  const move = (input: CameraInput | undefined, dt: number): CameraPose => {\nengine/dev/feel/camera.ts:21: * Invariants: presentation math only (the cameras are pure functions of their input: no GPU); it reads the sim's query\nengine/dev/governor.ts:25: * `gfx.governor` is false; the tools' virtual clock gives it even frames, so it never moves under them). Each move is logged once as advice, `GFX_GOVERNOR`, naming\nengine/app/loop.ts:18: * tools' virtual clock (tools/lib/browser.ts) a frame runs exactly when `__clock.tick()` says. An error thrown by a\nengine/ui/dialog.ts:48:  input: UiInput;\nengine/dev/botSweep.ts:71:  if (!options.level && !levelId) throw codeError('SIM_BAD_ARGUMENT', { where: 'sweepBot(scene)', value: found.id, expected: 'a scene with a level or a site (defineScene({ level })), or { level } given' }); // prettier-ignore\nengine/core/schema.ts:276:function fillObject(schema: Schema, input: Record<string, unknown>, path: string, problems: Problem[]) {\nengine/core/schema.ts:295:export function validate<S extends Schema>(schema: S, input: unknown): { value: EntryOf<S>; problems: Problem[] } {\nengine/core/schema.ts:310:export function parse<S extends Schema>(schema: S, input: unknown, where = 'the spec'): EntryOf<S> {\nengine/dev/members.ts:135:  /** Runs `n` sim steps through the clock, with one intents object for every step, one per step, or (undefined) the virtual device's. */\nengine/app/engine.ts:27: * still read the system layer, but no intent reaches the run; `cameraInput()` is laid over each frame's camera input.\nengine/app/engine.ts:109:  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\nengine/app/engine.ts:129:   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\nengine/app/engine.ts:144:  cameraInput?: () => CameraInput | undefined;\nengine/app/engine.ts:158:  readonly input: Input | null;\nengine/app/engine.ts:221:  const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: null, numbers: null, governor: createGovernor({ log, memory: governorMemory(options.store, () => routes?.scene) }), cameraInput: options.cameraInput, ready: false }; // prettier-ignore\nengine/app/engine.ts:329:  connectVirtualDevice(started.host, input.virtual);\nengine/dev/feel/run.ts:3: * as a replay plays (engine/sim/replay.ts: setting values, dev actions, then intents, at each change-point), samples\nengine/dev/feel/run.ts:46:    fix: 'run a scene that spawns a player actor (spawnActor with player: true), or measure another course',\nengine/dev/feel/run.ts:50:    fix: 'spawn the player with an animator (spawnActor with anim: { build }), or drop the animation measure',\nengine/anim/actions-check.ts:2: * @file An action's check (PLAN.md WP 8.7): `actionCheck` turns an action's `check` (actions-data.ts `ACTION_FIELDS`)\nengine/anim/actions-check.ts:5: * action of data/anim/actions/ by it. Split from actions.ts to keep each under 400 lines (ADR-0014 amendment 16).\nengine/anim/actions-check.ts:8: * import { defineAction } from './actions-data';\nengine/anim/actions-check.ts:14: * @see engine/anim/actions.test.ts\nengine/anim/actions-check.ts:18:import { Actions } from './actions';\nengine/anim/actions-check.ts:19:import { ACTION, getAction, type Action } from './actions-data';\nengine/ui/menu.ts:15: * the session records (a dev action, `__engine.actions.run`, or a custom intent for the next step), so the replay\nengine/ui/menu.ts:22: * skipped, onPick, onCancel, onMove) and shardfall's rule that menu actions reach the game as input (§5.8).\nengine/ui/menu.ts:27: * //   input, title: 'Paused', onCancel: () => pause.remove(), send: (id) => engine.actions.run(id) });\nengine/ui/menu.ts:52:  input: UiInput;\nengine/sim/doors.ts:42:import { defineComponent } from './state';\nengine/sim/doors.ts:85:defineComponent('door', {\nengine/app/animMember.ts:21: * import { defineActorKinds, spawnActor } from '../sim/actors';\nengine/app/animMember.ts:22: * import { defineScene } from '../sim/scene';\nengine/app/animMember.ts:29: *   spawnActor(w, { at: [0, 0, 0], character: createCharacter({ speed: 5 }), anim: {} });\n--- files ---\n/**\n * @file The starter game's page (labs/game/index.html): it starts the engine (`createEngine`, engine/app/engine.ts) on\n * the scene `game:play` (labs/game/scenes/play.ts) with the arena's text registered for the view, offers the bot's\n * replay to `?replay=bot`, and shows the round each drawn frame in the HTML/CSS overlay's HUD: the gems, the clock,\n * the controls, the best round kept across sessions (labs/game/best.ts, through the engine's store) and, when the\n * round ends, how it ended. Enter then starts a new round on the next seed. Escape (or the pad's Start) pauses the\n * round under a menu (`createMenu`: Resume, New round), which keeps its keys out of play while it is open\n * (`createEngine({ modal })`); the store keeps the best round and any keys rebound (`createEngine({ store })`). The\n * camera is the chase camera unless the URL names one (`?cam=iso`, `?cam3=orbit`).\n *\n * Everything else a page does (routes, the renderer, the frame loop, the devices, `window.__engine`, the error\n * overlay, the touch controls) is the engine's, so this file is the game's own presentation only. It reads the run\n * and never changes it: the HUD cannot change the hash.\n *\n * Game code: it imports only the engine's public API (engine/index.ts) and the game's own files.\n *\n * Open it at http://127.0.0.1:5173/labs/game/ (`npm run dev`): `?seed=7&game.gems=20` plays another round,\n * `?replay=bot` the bot's, `?cam=iso` another camera. Headless, `node x shot labs/game` reports what it draws.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createMenu, createStore, type Engine, type EngineFrame, type Menu } from '../../engine';\nimport { bestOf, recordBest } from './best';\nimport { ARENA_TEXT, play, type Round } from './scenes/play';\n\n/** The page's query, with the chase camera when it names none: it follows the player round the arena. */\nconst search = new URLSearchParams(location.search);\nif (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\n\n/** The game's replays, by name (`?replay=bot`), as text loaded on demand. */\nconst replays = { bot: () => import('./replays/bot.replay.json?raw').then((module) => module.default) };\n\n/** The started engine; null until `createEngine` resolves (its first frames are drawn before that). */\nlet engine: Engine | null = null;\n\n/** Whether the round on screen has ended, so Enter starts the next. */\nlet ended = false;\n\n/** The game's store: its best round across sessions; a replay's page plays in its demo mode, so it sets none. */\nconst store = createStore({ prefix: 'my3dge-game:', mode: search.has('replay') ? 'demo' : 'play' });\n\n/** The fastest won round kept (s), and the run whose clock the page saw running, with the steps it started with. */\nlet best = bestOf(store);\nlet seen: { world: object; steps: number } | null = null;\n\n/** The pause menu while it is open; null while the round plays. */\nlet paused: Menu | null = null;\n\n/** Opens the pause menu over the paused round, or reads it a frame: Resume (or Escape again), New round. */\nfunction pauseMenu(dt: number): void {\n  const [inspector, ui, input] = [engine?.inspector, engine?.ui, engine?.input];\n  if (!inspector || !ui || !input) return;\n  const close = () => {\n    paused?.remove();\n    paused = null;\n    inspector.resume();\n  };\n  if (paused) return void paused.update(dt);\n  if (!input.pressed('pause')) return;\n  inspector.pause();\n  const items = [\n    { label: 'Resume', id: 'resume' },\n    { label: 'New round', id: 'new' },\n  ];\n  paused = createMenu(ui.root, items, { input, id: 'pause', title: 'Paused', onCancel: close, onPick: (_i, item) => {\n    if (typeof item === 'object' && item.id === 'new') inspector.seed(inspector.seed() + 1);\n    close();\n  } }); // prettier-ignore\n}\n\n/** Shows the round in the HUD: the gems, the clock, the controls, and how the round ended. */\nfunction showRound({ world }: EngineFrame): void {\n  const ui = engine?.ui;\n  const entity = world.query('round')[0] as unknown as { round: Round } | undefined;\n  if (!ui || !entity) return;\n  const { gems, collected, left, state } = entity.round;\n  if (seen?.world !== world) seen = state === 'playing' ? { world, steps: left + world.tick } : null;\n  const was = ended;\n  ui.hud('gems', `Gems ${collected} / ${gems}`, { at: 'top-left' });\n  ui.hud('clock', `${Math.ceil(left / world.hz)} s`, { at: 'top-right', color: left < 10 * world.hz ? '#ff8f6b' : '' });\n  ui.hud('keys', 'WASD: run · Space: jump · Shift: dash · Esc: pause', { at: 'bottom', keys: true });\n  ended = state !== 'playing';\n  if (ended && !was && state === 'won' && seen) best = recordBest(store, (seen.steps - left) / world.hz);\n  ui.hud('best', best === null ? null : `Best ${best.toFixed(1)} s`, { at: 'top-left' });\n  const end = state === 'won' ? 'Every gem! Enter: play again' : 'Time! Enter: play again';\n  ui.hud('end', ended ? end : null, { at: 'top' });\n}\n\nengine = await createEngine({\n  canvas: document.querySelector<HTMLCanvasElement>('#view')!,\n  scenes: [play.id],\n  levels: { 'level:arena': { text: ARENA_TEXT, file: 'labs/game/scenes/play.ts' } },\n  replays,\n  search: `?${search}`,\n  store,\n  modal: () => paused !== null,\n  onFrame: (frame) => {\n    pauseMenu(frame.dt);\n    showRound(frame);\n  },\n});\n\naddEventListener('keydown', (event) => {\n  const inspector = engine?.inspector;\n  if (event.code === 'Enter' && ended && inspector) inspector.seed(inspector.seed() + 1);\n});\n/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_101","type":"reasoning","text":"**Checking current environment**"}}
{"type":"item.started","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '--- applicable instructions ---'; cat AGENTS.md; printf '%s\\\\n' '--- engine guides ---'; find . -maxdepth 3 \\\\( -iname '*guide*' -o -name AGENTS.md \\\\) -print | head -30; printf '%s\\\\n' '--- entry files ---'; ls labs/game; sed -n '1,180p' labs/game/cast/player.ts; printf '%s\\\\n' '--- scene input hooks ---'; rg -n 'sceneAction|actions:|action\\\\(|input\\\\.axes|input\\\\.buttons|virtual|cameraInput' engine/sim-api.ts engine -g '*.ts' | head -90\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '--- applicable instructions ---'; cat AGENTS.md; printf '%s\\\\n' '--- engine guides ---'; find . -maxdepth 3 \\\\( -iname '*guide*' -o -name AGENTS.md \\\\) -print | head -30; printf '%s\\\\n' '--- entry files ---'; ls labs/game; sed -n '1,180p' labs/game/cast/player.ts; printf '%s\\\\n' '--- scene input hooks ---'; rg -n 'sceneAction|actions:|action\\\\(|input\\\\.axes|input\\\\.buttons|virtual|cameraInput' engine/sim-api.ts engine -g '*.ts' | head -90\"","aggregated_output":"--- applicable instructions ---\n# AGENTS.md: wee-fit-retreat\n\nwee-fit-retreat is a game made with my-3dge, a 3D web game engine built for AI coding agents: TypeScript, three.js on\nWebGPU, Rapier physics, gameplay reproducible on the CPU and checked without a screen, the UI in HTML/CSS. The engine\nis in this repository, pinned to the commit engine-lock.json names; you make the game.\n\nBefore your first change, read docs/GAME-GUIDE.md once: how a game is built on this engine, the commands that prove\nit works, and where to look things up. Then grow the game from the starter in labs/game/, which already plays, wins\nthrough its bot, and passes its tests.\n\n## Set up (once per machine)\n\n    bash scripts/setup.sh\n\nIt installs Node 24 when missing (Linux x64), Chromium for the browser commands when missing, then `npm ci`. Plain\n`npm ci` is enough for everything except `x shot`, `x film` and `x replay --browser`.\n\n## The loop\n\n1. Edit the game in labs/game/: sim-side code (the rules) in labs/game/scenes/ and labs/game/cast/, the page in\n   labs/game/main.ts.\n2. `npm run check`: types, lint, format, the asset rules, and the engine unchanged.\n3. `npm test`: the game's tests (its replay's golden hashes, capture and restore, the bot wins on 10 seeds).\n4. See it without a screen: `node x sim labs/game/scenes/play.ts` (the hash and the events), `node x shot labs/game`\n   (what the page draws, as numbers and a text thumbnail), `node x replay labs/game/replays --browser sim` (the\n   goldens, in Node and Chromium). `node x help` lists every command; each prints its verdict first and writes\n   out/<cmd>/…/report.json.\n5. Commit, and keep labs/game/README.md current: what the game is, how it plays, the calls you made.\n\n`npm run dev` serves the game at http://127.0.0.1:5173/labs/game/ for a person to play.\n\n## Rules\n\n- **The engine is read-only.** engine/, tools/, data/, labs/box/ (the engine's worked example), scripts/setup.sh, the\n  configs and the docs it shipped: engine-lock.json lists every one, and `npm run check` fails when one changes. When\n  the engine is in your way, work round it in the game and write what you needed in ENGINE-FEEDBACK.md. Only when no\n  workaround exists, patch the engine file and list it under \"Local engine patches\" there, with why.\n- **Only the public API.** Pages import engine/index.ts; sim-side code imports engine/sim-api.ts (lint enforces it).\n- **Reproducible play.** Sim-side code reads no clock, no `Math.random`, no DOM: randomness comes from named streams\n  (`w.rng('loot')`), time is whole 60 Hz steps. The same intents and seed give the same hashes, in Node and Chromium.\n- **Assets are code or text first**: geometry, textures, materials and sounds as data. A binary file only with the\n  owner's approval, listed in APPROVED-BINARIES.json with their answer (`npm run check` fails one unlisted); fonts are\n  approved, anywhere in labs/game/ with their license beside them.\n- SI units, +Y up, characters face +Z. Every file opens with a `@file` comment and stays under 400 lines.\n- **Ask the owner** before anything outward or costly: a binary asset, a new npm dependency, spending money,\n  publishing. No answer within 15 minutes: take the safer choice, note it in labs/game/README.md, carry on.\n- Update the engine only when the owner asks: `node x engine --update`.\n\n## Done means\n\n`npm run check` and `npm test` pass; the bot still wins (teach it each new rule); a change that alters play on\npurpose records the replay's goldens again (`node x replay labs/game/replays --browser sim --update`) with the reason\nin the commit; labs/game/README.md says what the game is now.\n--- engine guides ---\n./docs/GAME-GUIDE.md\n./AGENTS.md\n--- entry files ---\nREADME.md\nbest.test.ts\nbest.ts\nbot.ts\ncast\nindex.html\nmain.ts\nreplays\nscenes\n/**\n * @file The starter game's player: the character the keys move (the character controller's numbers: how it runs,\n * jumps and dashes) and the body it is drawn as, and `spawnPlayer`, which stands it in a scene. A game keeps its\n * cast here, one character a file, as the box keeps its hero, walkers, slimes and wisps (labs/box/cast/); its scenes\n * spawn them. `node x sim labs/game/scenes/play.ts --feel` measures how the player handles: response, top speed, the\n * jump's height and air time, the dash's reach.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter(6).speed; // 6: m/s\n * playerCharacter(6).jumpSpeed; // 9: m/s at take-off, about 1.27 m up, over the arena's 0.75 m low walls\n * @see labs/game/scenes/play.ts\n */\nimport { createCharacter, spawnActor, type Character, type World } from '../../../engine/sim-api';\n\n/** The player's take-off speed, m/s: about 1.27 m up under the controller's gravity, over a 0.75 m low wall. */\nexport const JUMP_SPEED = 9;\n\n/** The body the player is drawn as: the humanoid in the chibi build, empty-handed. */\nexport const PLAYER_BODY = Object.freeze({ build: 'build:chibi', weapon: 'none' });\n\n/** The player's character at `speed` m/s; createCharacter's defaults for the rest (its dash among them). */\nexport function playerCharacter(speed: number): Character {\n  return createCharacter({ speed, jumpSpeed: JUMP_SPEED });\n}\n\n/** Stands the player in `w` (a scene with physics) at `at`, facing `yaw`: an actor the step's intents move. */\nexport function spawnPlayer<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  speed: number,\n  yaw = 0,\n): number {\n  const character = playerCharacter(speed);\n  return spawnActor(w, { at: [at[0], at[1], at[2]], character, player: true, yaw, anim: { ...PLAYER_BODY } });\n}\n--- scene input hooks ---\nengine/dev/inspector.ts:199:    help: 'Runs n sim steps through the clock, recorded in the session (without intents, what the virtual device holds: input.hold, input.axis…); returns the tick after them.',\nengine/dev/inspector.ts:205:          'One intents object for every step (its pressed buttons, p, on the first only), or a list of one per step (none past its end); none samples the virtual device each step (__engine.input).',\nengine/dev/bot.ts:3: * intents, as a virtual device would, for play longer and more varied than a scripted replay (soaks, navigation smoke).\nengine/dev/bot.ts:29: * and plan it plays the same steps. Carried from `my-3d2dge:src/emberdeep/93-autopilot.js` (the virtual input, the\nengine/dev/governor.ts:25: * `gfx.governor` is false; the tools' virtual clock gives it even frames, so it never moves under them). Each move is logged once as advice, `GFX_GOVERNOR`, naming\nengine/sim/actors.ts:258: * its axis, throws `SIM_BAD_ARGUMENT` before it moves anything: the body would sink through the floor. For a scene's dev actions: a feel\nengine/app/engine.ts:27: * still read the system layer, but no intent reaches the run; `cameraInput()` is laid over each frame's camera input.\nengine/app/engine.ts:144:  cameraInput?: () => CameraInput | undefined;\nengine/app/engine.ts:221:  const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: null, numbers: null, governor: createGovernor({ log, memory: governorMemory(options.store, () => routes?.scene) }), cameraInput: options.cameraInput, ready: false }; // prettier-ignore\nengine/app/engine.ts:329:  connectVirtualDevice(started.host, input.virtual);\nengine/dev/members.ts:135:  /** Runs `n` sim steps through the clock, with one intents object for every step, one per step, or (undefined) the virtual device's. */\nengine/dev/galleryScene.ts:222:      actions: {\nengine/app/headless.ts:52:import { virtualDeviceOf } from '../input/devices/inspector'; // registers `__engine.input` too\nengine/app/headless.ts:53:import { virtualIntents } from '../input/devices/virtual';\nengine/app/headless.ts:278:        // No intents: what the virtual device holds (`__engine.input`), taken each step as the page's input is.\nengine/app/headless.ts:279:        const device = virtualDeviceOf(host);\nengine/app/headless.ts:280:        for (let k = 0; k < n; k++) stepOnce(virtualIntents(device.take()));\nengine/dev/actions.ts:57:  help: \"Lists the run's dev actions: the scene's own, then the engine's (god, freeze, spawn, travel, timeScale).\",\nengine/app/loop.ts:18: * tools' virtual clock (tools/lib/browser.ts) a frame runs exactly when `__clock.tick()` says. An error thrown by a\nengine/sim/devActions.ts:230:      'Dev actions: changes made to a running scene between steps (god mode, freeze, spawn, travel, time scale), recorded in replays.',\nengine/sim/reactions.ts:95:export type ReactionComponents = { reactions: ReactionState; secondary: SecondaryComponent };\nengine/sim/reactions.ts:124:  act: (reactions: Reactions) => unknown,\nengine/sim/melee.ts:27: * // in a scene's setup, the player first: spawnPlayer(w, at); addInteraction(w); addMelee(w);\nengine/app/drawing.ts:72:  /** The page's own camera input, laid over the devices' each drawn frame (`EngineOptions.cameraInput`). */\nengine/app/drawing.ts:73:  cameraInput?: () => CameraInput | undefined;\nengine/app/drawing.ts:178:      const cameraInput = { ...parts.input?.camera(), ...parts.cameraInput?.() };\nengine/app/drawing.ts:179:      const view = viewNow().frame({ alpha, dt, aspect: aspect(), input: cameraInput });\nengine/sim/interact.ts:3: * `addInteraction(w)` (a scene's setup, once) adds the system `interact` (phase `intents`, before the actors move and\nengine/sim/session.ts:47:    fix: \"add it to the scene, defineScene('{scene}', { actions: { {name}(w, args) { … } } }), or to the engine's, defineDevAction('{name}', { help, run }) (engine/sim/devActions.ts); or call one there is\",\nengine/sim/session.ts:185:        const suggestion = near || (names.length ? `its actions: ${names.map(show).join(', ')}` : 'it has none');\nengine/anim/poseNames.ts:29:/** The held poses, each with what it shows. `die` and `down` are reactions: they knock the body flat. */\nengine/sim/actorActions.ts:73:export type ActionComponents = { actions: ActionsState };\nengine/sim/actorActions.ts:92:function save(entity: ActionActor, actions: Actions): ActionsState {\nengine/sim/actorActions.ts:107:  act: (actions: Actions) => unknown,\nengine/sim/scene.ts:129:  actions: {\nengine/anim/reactions.ts:51:/** Every constant of the reactions: rates per second, times in seconds. */\nengine/anim/reactions.ts:132:/** A body's reactions: the flinch, the knockdown, the death, the get-ups. See the file comment. */\nengine/core/time.ts:4: * budget and pause; plus a virtual clock for tests. Nothing here reads a wall clock: real time arrives from outside,\nengine/core/time.ts:372:/** Makes a virtual clock starting at `start` milliseconds. */\nengine/gfx/puppets/actors.ts:136:  layers(): ReadonlyMap<number, { readonly reactions: Reactions | null; readonly secondary: Secondary | null; readonly ragdoll: RagdollLayer }>; // prettier-ignore\nengine/gfx/puppets/actorLayers.ts:55:  reactions: ReactionState | null;\nengine/gfx/puppets/actorLayers.ts:57:  actions: ActionsState | null;\nengine/gfx/puppets/actorLayers.ts:91:  reactions: Reactions | null;\nengine/gfx/puppets/actorLayers.ts:93:  actions: Actions | null;\nengine/gfx/enhanced/timing.ts:18: * the virtual clock's `tick(n)` draws n frames in one task, before any read can come back. After each read it empties\nengine/input/actionMaps.ts:70:  actions: {\nengine/input/actionMaps.ts:124:  readonly actions: Readonly<Record<string, readonly string[]>>;\nengine/input/actionMaps.ts:153:  if (map.move.length !== 4) problems.push(`move names ${map.move.length} actions: give forward, back, left, right`);\nengine/input/actionMaps.ts:178:    defineWith: \"defineActionMap('actionMap:<name>', { actions: { jump: ['Space', 'PadSouth'] } })\",\nengine/input/actionMaps.ts:186:  actions: Readonly<Record<string, readonly string[]>>;\nengine/input/actionMaps.ts:226:    actions: {\nengine/input/actionMaps.ts:237:    actions: {\nengine/input/actionMaps.ts:253:    actions: {\nengine/input/actionMaps.ts:263:    actions: {\nengine/input/input.ts:3: * gamepads, touch, the virtual device) turned into one step's intents through bindings (engine/input/bindings.ts).\nengine/input/input.ts:15: * its poll, the virtual device's at the sample). `camera()` gives what the camera takes each frame (mouse look under\nengine/input/input.ts:26: * release reports. In Node (no `window`, `document`), only the gamepad source given and the virtual device feed it.\nengine/input/input.ts:51:import { createVirtualDevice, type VirtualDevice } from './devices/virtual';\nengine/input/input.ts:110:  /** The virtual device, merged into every sample (`__engine.input` drives it). */\nengine/input/input.ts:111:  readonly virtual: VirtualDevice;\nengine/input/input.ts:185:  /** The view actions told as their codes went down since the last sample, which tells only the others (virtual). */\nengine/input/input.ts:241:  const virtual = createVirtualDevice();\nengine/input/input.ts:290:    virtual,\nengine/input/input.ts:299:      if (virtual.touched) last = 'virtual';\nengine/input/input.ts:313:      const own = virtual.take();\nengine/input/devices/touch.ts:22: * input.ts), so ages are measured to the frame and the tools' virtual clock drives them. No `@example` runs here: it\nengine/input/devices/virtual.ts:2: * @file The virtual device (PLAN.md WP 3.3, §8.3; doctrine: Agent-operable): input made by code instead of hands, the\nengine/input/devices/virtual.ts:5: * virtual stick (`[right, forward]`, turned by the camera as keys are), and `axis('cam' | 'look' | 'aim' | 'game:…',\nengine/input/devices/virtual.ts:21: * virtualIntents(pad.take(), Math.PI / 2); // { move: [1, 6.1e-17], b: [], p: ['jump'] }: forward is +X at ψ = π/2\nengine/input/devices/virtual.ts:25: * @see engine/input/devices/virtual.test.ts\nengine/input/devices/virtual.ts:37:    doc: 'Raised by the virtual device (engine/input/devices/virtual.ts) and `__engine.input` for an empty action name, an unknown axis, or a value of the wrong shape.',\nengine/input/devices/virtual.ts:54:/** The virtual device. */\nengine/input/devices/virtual.ts:78:/** Makes a virtual device, holding nothing. */\nengine/input/devices/virtual.ts:134:/** One step's intents from a virtual sample: `move` turned by the heading `yaw` (the `cam` axis when it holds one). */\nengine/input/devices/virtual.ts:135:export function virtualIntents(sample: VirtualSample, yaw = 0): Record<string, unknown> {\nengine/input/devices/virtual.ts:174:      step(virtualIntents(merged, yaw));\nengine/input/bindings.ts:60:  actions: Record<string, string[]>;\nengine/input/bindings.ts:140:    actions: () => [...names],\nengine/input/bindings.ts:173:      const actions: Record<string, string[]> = {};\nengine/input/api.ts:9: * the virtual device that __engine.input drives and the scripted gamepad for tests (WP 3.3); aiming, the point the\nengine/input/api.ts:18: * // defineActionMap('actionMap:my-first', { actions: { jump: ['Space'] }, look: true, aimWith: 'centre', lock: true });\nengine/input/api.ts:24:// the virtual device that __engine.input drives, and the scripted gamepad for tests.\nengine/input/api.ts:47:export { createVirtualDevice } from './devices/virtual';\nengine/input/api.ts:48:export type { VirtualDevice } from './devices/virtual';\nengine/input/script.ts:5: * virtual device's `__engine.input.play` (engine/input/devices/virtual.ts: `30 move=0,1 hold=sprint tap=jump`, a\nengine/input/script.ts:17: * @see engine/input/devices/virtual.test.ts\nengine/input/codes.ts:37:/** The devices input comes from; `virtual` is the inspector's (engine/input/devices/virtual.ts). */\nengine/input/codes.ts:38:export type DeviceKind = 'keyboard' | 'mouse' | 'gamepad' | 'touch' | 'virtual';\nengine/input/codes.ts:139:export function deviceOf(code: string): Exclude<DeviceKind, 'virtual'> {\nengine/input/devices/inspector.ts:2: * @file `__engine.input` (PLAN.md §8.3, WP 3.3; doctrine: Agent-operable): the inspector members that drive the virtual\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_103","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' labs/game/cast/player.ts; printf '\\\\n--- html ---\\\\n'; cat labs/game/index.html; printf '\\\\n--- api guide excerpts ---\\\\n'; rg -n 'defineScene|spawn|camera|model|component|actions|input|hud' docs/GAME-GUIDE.md | head -70; printf '\\\\n--- starter scene ---\\\\n'; sed -n '1,230p' labs/game/scenes/play.ts; printf '\\\\n--- engine exports ---\\\\n'; sed -n '1,160p' engine/sim-api.ts; cat package.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_103","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' labs/game/cast/player.ts; printf '\\\\n--- html ---\\\\n'; cat labs/game/index.html; printf '\\\\n--- api guide excerpts ---\\\\n'; rg -n 'defineScene|spawn|camera|model|component|actions|input|hud' docs/GAME-GUIDE.md | head -70; printf '\\\\n--- starter scene ---\\\\n'; sed -n '1,230p' labs/game/scenes/play.ts; printf '\\\\n--- engine exports ---\\\\n'; sed -n '1,160p' engine/sim-api.ts; cat package.json\"","aggregated_output":"/**\n * @file The starter game's player: the character the keys move (the character controller's numbers: how it runs,\n * jumps and dashes) and the body it is drawn as, and `spawnPlayer`, which stands it in a scene. A game keeps its\n * cast here, one character a file, as the box keeps its hero, walkers, slimes and wisps (labs/box/cast/); its scenes\n * spawn them. `node x sim labs/game/scenes/play.ts --feel` measures how the player handles: response, top speed, the\n * jump's height and air time, the dash's reach.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter(6).speed; // 6: m/s\n * playerCharacter(6).jumpSpeed; // 9: m/s at take-off, about 1.27 m up, over the arena's 0.75 m low walls\n * @see labs/game/scenes/play.ts\n */\nimport { createCharacter, spawnActor, type Character, type World } from '../../../engine/sim-api';\n\n/** The player's take-off speed, m/s: about 1.27 m up under the controller's gravity, over a 0.75 m low wall. */\nexport const JUMP_SPEED = 9;\n\n/** The body the player is drawn as: the humanoid in the chibi build, empty-handed. */\nexport const PLAYER_BODY = Object.freeze({ build: 'build:chibi', weapon: 'none' });\n\n/** The player's character at `speed` m/s; createCharacter's defaults for the rest (its dash among them). */\nexport function playerCharacter(speed: number): Character {\n  return createCharacter({ speed, jumpSpeed: JUMP_SPEED });\n}\n\n/** Stands the player in `w` (a scene with physics) at `at`, facing `yaw`: an actor the step's intents move. */\nexport function spawnPlayer<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  speed: number,\n  yaw = 0,\n): number {\n  const character = playerCharacter(speed);\n  return spawnActor(w, { at: [at[0], at[1], at[2]], character, player: true, yaw, anim: { ...PLAYER_BODY } });\n}\n\n--- html ---\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n\n--- api guide excerpts ---\n4:8). A game's AGENTS.md sends you here after `node tools/game/new-game.mjs` made the game. For a model without the\n28:| `data/anim/`                                                     | The animation library: readable clips, and the engine's actions                       |\n35:## 2. The model\n37:**Two halves.** The sim is the game's rules: entities holding components (plain data), systems that change them each\n43:**A scene** is the unit `x sim`, the page and the tests run: `defineScene('game:play', { level, physics, settings,\n44:setup(w), step(w, intents) })`. `setup` spawns entities and adds systems; `step` runs first in every step. One page can\n50:- **Components and entities.** `defineComponent('gem', { description, fields })` declares a component: typed fields\n51:  with defaults and units, so the state can be hashed, captured and checked. `w.spawn({ gem: { x, z } })` returns an\n53:  `w.despawn` do the rest. An entity whose component declares `x` and `z` in metres is drawn as a stand-in box until\n57:  readback copied their places into components.\n72:the camera's view as `look`, and its `aimWith` fills `aim` (`centre`: what the screen's middle points at; `pointer`:\n73:the pointer on the player's floor), and a game with several camera modes gives `createEngine` a map per camera\n88:| labs/game/scenes/play.ts     | The rules: a level as text, settings, components (`gem`, `round`), systems, a random stream, events |\n91:| labs/game/main.ts            | The page: `createEngine`, the HUD in `onFrame`, Enter to play again, Esc's pause menu, the chase camera     |\n103:| A level                        | A text map in a scene module; `compileLevel`, glyphs (`#` wall, `.` floor, `@` spawn, `w` low wall, `P` pillar, `^` stairs, `=` gallery, `o` dais, `t` brazier), `defineGlyph` for your own; `addLevelBodies`; the page registers the text (`createEngine({ levels })`); a building of storeys: `node x new level`; buildings on a terrain: `defineSite`, `addSiteBodies` | labs/game/scenes/play.ts, labs/box/levels/hall.txt, labs/playground/levels/site.ts |\n104:| A player or character          | `createCharacter` (speed, jump, dash, coyote time, buffer), `spawnActor`, `measureFeel`; Apex's movement, `{ movement: 'movement:apex' }`, or your own: `defineMovement` (`node x new movement`); `node x feel`, `createFeelPanel` | labs/game/cast/player.ts, labs/box/cast/hero.ts, labs/playground/cast/player.ts |\n106:| Props                          | `defineProp` (meshes, a body, hooks), `spawnProp`, `hitProp`; the engine's `prop:crate`, `prop:barrel`, `prop:brazier`, `prop:pillar`; one a player uses or strikes: `defineUsable`, `defineStrikable`, `addInteraction` (`node x new interactable`) | labs/box/scenes/hall-props.ts |\n110:| Melee, guns and targets        | `addMelee` (punches, kicks, the door kick), `defineWeapon`, `weaponsFor` and `addWeapons` (hip fire, the sights, a climbing recoil, reloads; `node x new weapon`), `defineThing` and `spawnThing` (targets that fall at a hit and stand again; `node x new thing`) | labs/playground/weapons/, labs/playground/cast/dummies.ts |\n112:| Animation                      | Actors animate themselves (`spawnActor({ anim: { build } })`); builds, bodies, the animator's body states, actions (`defineAction`, played on an actor with `actOn`), clips from the library (`playClip`) | labs/box/scenes/clips.ts, `node x anim find` |\n115:| UI                             | `engine.ui`: `hud(id, text, { at })`, `label`, `damage`, `crosshair`; screens and menus: `createMenu`, `createEngine({ store, modal })` (rebinds kept, a menu's keys out of play), `input.bindingsFor`, `rebind`, `listen` (a controls screen); the rest plain HTML/CSS | labs/game/main.ts (its pause), labs/playground/ui/, labs/box/menu.ts |\n117:| Cameras                        | `?cam=iso` (`threequarter`, `topdown`, `overhead`, `brawler`, `side`), `?cam3=chase` (`orbit`, `fly`, `fixed`, `first`, `rail`, `shoulder`, `follow`); `__engine.camera.set(code, { blend: true })`; a map per mode: `createEngine({ actionMap: (code) => … })`; a mode of your own: `defineCamera` (`node x new camera`) | labs/game/main.ts, labs/playground/views.ts |\n134:- Presentation never writes the sim: cameras, looks, particles, sound and the HUD change freely without changing a hash.\n138:sounds as voices and tracker notes, levels as text. A binary file (an image, a recorded sound, a model) needs the\n155:| `node x eye labs/game/scenes/play.ts [--cam code] [--steps n]` | What a camera sees of the bodies, in Node with no GPU: a text picture and its legend (`__engine.eye()` in a page) |\n168:`capture`, `restore`, `replay`, `input.press`, `input.record`, `set`, `state`, `shot`,\n199:1. Work round it in the game: a component, a system, page code of your own.\n217:`defineScene`, `defineDevAction`; types `Scene`, `SceneSpec`, `SceneAction`, `SceneSound`, `DevActionSpec`.\n219:**The world**: entities, components, systems, timers, events.\n237:**Levels**: a legend of glyphs, level text compiled to plain data (heights, solid grid, colliders, meshes, spawns).\n258:**Reactions and secondary motion (WP 6.2)**: a directional flinch, knockdown, death and the get-up chosen by how the body lies (face up or face down), stepped in the sim; verlet chains (hair, tails) with bone-capsule colliders, a floor probe and a rest shape, a cape of two chains, and the squash spring as a volume-preserving root scale, drawn by an animator layer in the view.\n259:`Reactions`, `REACTION`, `REACTIONS`, `lyingOf`, `Chain`, `CHAIN`, `Cape`, `Secondary`, `HAIR`, `CAPE`, `TAIL`, `SQUASH`, `squashScale`, `BODY_CAPSULES`, `bodyCapsules`; types `ReactionOptions`, `ReactionState`, `ReactionBody`, `ReactionName`, `Lying`, `ChainOptions`, `ChainTuning`, `BoneCapsule`, `CapeOptions`, `SecondaryOptions`.\n261:**Animation checks (WP 6.6)**: the state matrix (each body state held at each facing, from rest and back to rest) and animCheckBody, which checks a whole body over it: every pose, the same hashes twice, 1/60 s against 1/120 s; and the camera presets sheets of it are drawn from.\n264:**Actions (WP 8.7)**: multi-beat sequences a body plays, beats of body states, clips, IK targets, flips and squashes with held contact frames, events, flags and cancel windows; the engine's set is data/anim/actions/, which loadActions defines.\n267:**Clip sets in the registry (WP 8.9)**: the kind clipset, one entry per set of readable clips, which a page or tool registers from data/anim/sets/ (defineClipSet), and the clip layer of an entity kept as plain data, loaded from it at every use (ClipLayerPool), as an actor's component clips holds it.\n276:**Characters (WP 3.2)**: actors moved by the character controller (Rapier's, moved across then down), with an action game's feel: acceleration and skid, coyote time, a jump buffer, a variable jump, a wall jump, a dash, pushing props; the feel meter measures how one handles. A body's reactions and an actor's secondary motion as components (WP 7.8), and its actions (`actOn`, WP 13.11).\n277:`createCharacter`, `CHARACTER_FIELDS`, `CHARACTER_STATE_FIELDS`, `spawnActor`, `removeActor`, `measureFeel`, `reactTo`, `stepReactions`, `REACTION_FIELDS`, `SECONDARY_FIELDS`, `actOn`, `ACTIONS_FIELDS`; types `Character`, `CharacterState`, `ActorSpec`, `ActorComponent`, `ActorComponents`, `FeelReport`, `FeelOptions`, `AnimatorComponent`, `SecondaryComponent`, `ReactionComponents`, `ActionComponents`.\n291:**Props in a scene (WP 4.6)**: spawnProp stands a prop in a running scene (its body, and an entity with the component sceneProp whose pose is read back after each step, which the view draws as the prop); hitProp calls its hit hook with the means to knock it; removeProp.\n292:`spawnProp`, `removeProp`, `hitProp`, `SCENE_PROP_FIELDS`; types `ScenePropComponent`, `ScenePropComponents`.\n294:**Crowd bodies (WP 5.1)**: agents as dynamic capsules and balls driven by the velocities their AI wants (approach limits, only on their feet), knockback and launches, the corpse group and its timers, spawn and despawn queues.\n300:**Crowd bodies (WP 5.7)**: a crowd member's look and rig (a humanoid in a build, a blob, a floater) in the component crowdBody, its rig stepped in the sim by stepCrowdBody; the stage draws them through a crowd with its level of detail.\n324:**Clips on actors (WP 8.9)**: the clip layer in an actor's animator as sim data, the component clips, stepped at the actor's ground speed and drawn over its body by the view; its events come as `clip`. spawnActor's `body` names the body it is drawn as (body:mannequin).\n327:**Movement profiles (WP 13.3)**: the registry kind `movement`, and the shooter model (Apex's) a profile gives a character.\n330:**The feel kit, sim-side (WP 13.4)**: the shooter model's live tuning, `movement.<group>.<field>` (a setting off its default replaces that number in every model character's model, from the next step), and an actor placed at rest (a scene's dev action: a feel course's start).\n333:**Rides (WP 13.7)**: ziplines, ladders and launchers as world data (engine/world/traverse.ts), placed in a scene (engine/sim/rides.ts) and ridden by the shooter model (engine/physics/movement/ride.ts, ladder.ts): a zipline and the poles under its anchors, the redeploy balloon's line and its skydive, a ladder (or every ladder a level's ladder glyph `|` stands), a jump pad or a trampoline. Use is the button `interact`; the look's pitch picks a vertical zipline's way and a skydive's dive.\n366:**Things (WP 10.4)**: what can be hit, as a range's targets and a ring's dummies: the kind `thing` (its prop, hit points, rise, track and hooks), a thing's state (hits, down and up, its place on its track), and things in a scene (spawned as their prop, struck as hits, stood back up and driven along their tracks by the system `things`).\n367:`defineThing`, `getThing`, `thingState`, `hitThing`, `stepThing`, `thingAt`, `THING_FIELDS`, `THING_KIND_FIELDS`, `spawnThing`, `strikeThing`; types `Thing`, `ThingKind`, `ThingSpec`, `ThingTouch`, `ThingHit`, `ThingOutcome`, `ThingStanding`.\n398:**Input (WP 3.3)**: the devices of a page sampled into intents (keys by physical code, mouse with pointer lock and the wheel, gamepads in any slot), action maps and their presets, bindings players change and keep, prompts per device, the virtual device that __engine.input drives, and the scripted gamepad for tests.\n401:**Aiming and look (WP 13.9)**: the point the intents' aim carries by a map's rule, and the look settings input.*.\n422:**A page's own presentation (WP 9.5)**: createEngine's onFrame, once per drawn frame, with the run to read and the camera.\n425:**Touch controls (WP 3.12; built, not tested, ADR-0021)**: a page's touch layout (the corner fan's buttons and the menu button) for createEngine's touchLayout and onMenu, the touch device on input.touch, and the touch codes it writes.\n428:**Level meshes v2 and the cutaway (WP 4.4)**: galleries, stairs, the dais, pillars with plinths and capitals and brazier stands as recipe shapes; walls facing an outside camera cut low and pillars before the hero as stumps.\n437:**The widgets (WP 10.6)**: bars, hearts and boxes, the dialog box and the menu as HTML/CSS over the overlay, reading the page's input (its system layer) and asking the page for sound cues; a gamepad's cursor over any panel. A menu sends the picks that change play as input (`send`), so replays hold them.\n467:**Effects (WP 6.4)**: particles as data (emitters: shardfall's presets, the 2D engine's kinds, event effects), drawn with telegraphs on the floor, socket trails, bolts and camera shake by a view's effects; never part of the hash.\n473:**Camera modes (WP 2.5, WP 3.9, WP 13.8)**: a code to a camera, each mode's factory, and a game's own.\n477:`createCameraRig`, `rigOptions`, `CAMERA_SETTINGS`, `blendCameras`, `BLEND_TIME`, `createCameraEffects`, `applyEffects`, `cameraPlayer`, `apexFov`, `EFFECTS`; types `CameraRig`, `RigOptions`, `RigInput`, `CameraPlayer`, `EffectWeights`, `EffectsFrame`.\n\n--- starter scene ---\n/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n\n--- engine exports ---\n/**\n * @file The public API for sim-side game code (PLAN.md §6.1, §6.9, WP 1.6; doctrine: Quality under the hood): what a\n * scene, a cast member or a behaviour imports, and all it may import (ESLint's public-API rule), so `x sim` runs it\n * in Node and its play is reproducible. engine/index.ts re-exports all of it for pages.\n *\n * What is here: scenes, the world and its components, the registries and settings, the intents vocabulary,\n * three.js's math classes with the engine's angle helpers, seeded randomness, and the event types. docs/API.md\n * lists every name with the first sentence of its doc comment; `node x describe` lists the registries.\n *\n * Invariants: a flat list of `export … from` lines, one name per line, grouped by area, and append-only: each WP adds\n * its public names at the end of their area, so parallel lanes merge cleanly (§11.3). The Animation area lives in\n * engine/anim/api.ts, re-exported here whole so this file stays under its line cap (ADR-0020 amendment 8): append\n * animation names there; Phase 13's movement areas likewise in engine/sim/movementApi.ts (ADR-0025 amendment 7), its\n * sites' in engine/sim/siteApi.ts, its house's in engine/sim/houseApi.ts (amendment 19), and the crowds' and combat's\n * in engine/sim/combatApi.ts and the gameplay kits' in engine/sim/kitsApi.ts (amendment 23). Only sim-side modules are\n * re-exported (ESLint's layer rule for this file).\n * Each name is documented where it is declared, and `x docs --check` fails a public export without its doc comment.\n * Game code reaches three.js only through these re-exports.\n *\n * @example\n * // fixtures/scenes/kernel/index.ts\n * // import { defineScene, defineComponent, held, type World } from '../../../engine/sim-api';\n * @see fixtures/scenes/kernel/index.ts\n */\n\n// Scenes: defined as data with a setup and a step, run by x sim, x replay and createHeadless.\nexport { defineScene } from './sim/scene';\nexport type { Scene } from './sim/scene';\nexport type { SceneSpec } from './sim/scene';\nexport type { SceneAction } from './sim/scene';\nexport type { SceneSound } from './sim/scene';\nexport { defineDevAction } from './sim/devActions';\nexport type { DevActionSpec } from './sim/devActions';\n\n// The world: entities, components, systems, timers, events.\nexport type { World } from './sim/world';\nexport type { SimRng } from './sim/world';\nexport type { WorldTimers } from './sim/world';\nexport type { WorldEvents } from './sim/world';\nexport { defineComponent } from './sim/state';\nexport type { Entity } from './sim/state';\nexport type { With } from './sim/state';\nexport type { SpawnSpec } from './sim/state';\nexport type { ComponentOf } from './sim/state';\nexport { PHASES } from './sim/systems';\nexport type { Phase } from './sim/systems';\nexport type { SystemFn } from './sim/systems';\n\n// Registries and settings: content as data, one schema for every setting.\nexport { defineKind } from './core/registry';\nexport { def } from './core/registry';\nexport type { Entry } from './core/registry';\nexport type { Kind } from './core/registry';\nexport type { KindSpec } from './core/registry';\nexport type { Field } from './core/schema';\nexport type { Schema } from './core/schema';\nexport { defineSettings } from './core/settings';\nexport type { SimSettings } from './core/settings';\nexport type { SettingValue } from './core/settings';\n\n// Intents: what the sim reads from outside each step.\nexport { held } from './input/intents';\nexport { pressed } from './input/intents';\nexport { fromCamera } from './input/intents';\nexport { INTENT_KEYS } from './input/intents';\nexport type { Intents } from './input/intents';\nexport type { IntentValue } from './input/intents';\nexport type { CustomIntentKey } from './input/intents';\nexport { createInputBuffer } from './input/intents';\nexport { updateInputBuffer } from './input/intents';\nexport { released } from './input/intents';\nexport { buffered } from './input/intents';\nexport { consume } from './input/intents';\nexport { consumeAll } from './input/intents';\nexport { repeated } from './input/intents';\nexport { BUFFER_STEPS } from './input/intents';\nexport { REPEAT_DELAY } from './input/intents';\nexport { REPEAT_RATE } from './input/intents';\nexport type { InputBuffer } from './input/intents';\n\n// Math: three.js's math classes and the engine's helpers (MathUtils covers clamp, lerp, damp, smoothstep).\nexport { Vector3 } from './core/math';\nexport { Quaternion } from './core/math';\nexport { Matrix4 } from './core/math';\nexport { Euler } from './core/math';\nexport { Box3 } from './core/math';\nexport { Sphere } from './core/math';\nexport { Ray } from './core/math';\nexport { Plane } from './core/math';\nexport { Color } from './core/math';\nexport { MathUtils } from './core/math';\nexport { approach } from './core/math';\nexport { angDiff } from './core/math';\nexport { lerpAng } from './core/math';\nexport { approachAng } from './core/math';\nexport { smoothDamp } from './core/math';\nexport { ease } from './core/math';\nexport { swingTwist } from './core/math';\n\n// Randomness: seeded streams (the world's are w.rng('<stream>')).\nexport { Rng } from './core/rng';\n\n// Events: emitted with w.emit, heard with w.events.on.\nexport type { EventMap } from './core/events';\nexport type { Listener } from './core/events';\nexport type { TraceRecord } from './core/events';\n\n// Levels: a legend of glyphs, level text compiled to plain data (heights, solid grid, colliders, meshes, spawns).\nexport { compileLevel } from './world/level/compile';\nexport type { CompileOptions } from './world/level/compile';\nexport { validateLevel } from './world/level/validate';\nexport type { LevelSource } from './world/level/validate';\nexport type { LevelProblem } from './world/level/problems';\nexport { defineGlyph } from './world/level/glyph';\nexport type { Glyph } from './world/level/glyph';\nexport type { GlyphSpec } from './world/level/glyph';\nexport { defineLevel } from './world/level/level';\nexport { getLevel } from './world/level/level';\nexport type { LevelEntry } from './world/level/level';\nexport { floorHeight } from './world/level/heights';\nexport { topHeight } from './world/level/heights';\nexport { solidAt } from './world/level/heights';\nexport { tileAt } from './world/level/heights';\nexport { LEVEL_FORMAT } from './world/level/types';\nexport type { CompiledLevel } from './world/level/types';\nexport type { LevelGlyph } from './world/level/types';\nexport type { BoxCollider } from './world/level/types';\nexport type { ColliderDescriptor } from './world/level/types';\nexport type { GroundDescriptor } from './world/level/types';\nexport type { MeshDescriptor } from './world/level/types';\nexport type { SpawnPoint } from './world/level/types';\nexport type { LightSpot } from './world/level/types';\nexport type { TileRect } from './world/level/types';\nexport type { Point3 } from './world/level/types';\n\n// Animation (WP 3.4 onward): skeleton, builds, poses, IK, the humanoid, moves, reactions, checks and actions, listed\n// area by area in engine/anim/api.ts so this file stays under its line cap (ADR-0020 amendment 8).\nexport * from './anim/api';\n\n// Physics (WP 3.1): Rapier behind plain terms. A scene with `physics: true` has a physics world: bodies by id,\n// raycasts, shape casts, overlaps and ground probes, collision groups by name, a level's bodies; presentation reads\n// it through the read-only QueryView.\nexport { physicsOf } from './physics/binding';\nexport type { Physics } from './physics/world';\nexport type { BodySpec } from './physics/world';\nexport type { ColliderSpec } from './physics/world';\nexport type { BodyState } from './physics/world';\nexport type { BodyChange } from './physics/world';\nexport type { BodyType } from './physics/world';\nexport type { Shape } from './physics/queries';\nexport type { Vec3Like } from './physics/queries';\nexport type { QuatLike } from './physics/queries';\nexport type { Hit } from './physics/queries';\nexport type { Ground } from './physics/queries';\nexport type { QueryOptions } from './physics/queries';\nexport type { RayOptions } from './physics/queries';\nexport type { ShapeCastOptions } from './physics/queries';\nexport type { OverlapOptions } from './physics/queries';\nexport type { ProbeOptions } from './physics/queries';\nexport { COLLISION_GROUPS } from './physics/groups';\n{\n  \"name\": \"wee-fit-retreat\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"A game made with the my-3dge engine.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=24.10 <25\"\n  },\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"typecheck\": \"tsc -b tsconfig.check.json\",\n    \"lint\": \"eslint --cache --cache-location node_modules/.cache/eslint/ .\",\n    \"format\": \"prettier --write --cache .\",\n    \"check\": \"node tools/checkAll.ts\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-simd-compat\": \"0.21.0\",\n    \"@stdlib/math-base-special-cos\": \"0.3.1\",\n    \"@stdlib/math-base-special-pow\": \"0.3.1\",\n    \"@stdlib/math-base-special-sin\": \"0.3.1\",\n    \"three\": \"0.182.0\"\n  },\n  \"devDependencies\": {\n    \"@modelcontextprotocol/sdk\": \"1.32.2\",\n    \"@playwright/test\": \"1.64.1\",\n    \"@stryker-mutator/core\": \"9.6.1\",\n    \"@stryker-mutator/vitest-runner\": \"9.6.1\",\n    \"@types/node\": \"24.19.2\",\n    \"@types/three\": \"0.182.0\",\n    \"eslint\": \"9.39.5\",\n    \"eslint-plugin-jsdoc\": \"61.7.1\",\n    \"globals\": \"16.5.0\",\n    \"prettier\": \"3.9.10\",\n    \"tsx\": \"4.23.15\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.72.1\",\n    \"vite\": \"7.3.7\",\n    \"vitest\": \"4.1.12\"\n  },\n  \"allowScripts\": {\n    \"esbuild\": false\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_104","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,165p' docs/GAME-GUIDE.md; printf '\\\\n--- SCENE ---\\\\n'; sed -n '1,220p' labs/game/scenes/play.ts; printf '\\\\n--- ENTRY ---\\\\n'; sed -n '1,160p' labs/game/main.ts; printf '\\\\n--- MANIFEST ---\\\\n'; cat package.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_104","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,165p' docs/GAME-GUIDE.md; printf '\\\\n--- SCENE ---\\\\n'; sed -n '1,220p' labs/game/scenes/play.ts; printf '\\\\n--- ENTRY ---\\\\n'; sed -n '1,160p' labs/game/main.ts; printf '\\\\n--- MANIFEST ---\\\\n'; cat package.json\"","aggregated_output":"## 2. The model\n\n**Two halves.** The sim is the game's rules: entities holding components (plain data), systems that change them each\nstep, events. Sim-side code (labs/game/scenes/, labs/game/cast/) imports only engine/sim-api.ts and never touches the\nDOM, the GPU, the clock or `Math.random`. The page (labs/game/main.ts) imports engine/index.ts: `createEngine` starts\nthe sim, turns the keyboard, mouse, pads and touch into intents, draws every frame on WebGPU, and calls your `onFrame`\nfor the game's own presentation (the HUD, sound). The page reads the sim and never writes it. Lint enforces the split.\n\n**A scene** is the unit `x sim`, the page and the tests run: `defineScene('game:play', { level, physics, settings,\nsetup(w), step(w, intents) })`. `setup` spawns entities and adds systems; `step` runs first in every step. One page can\noffer several scenes (`createEngine({ scenes })`, `?scene=<id>` picks one); a running page cannot switch scenes yet,\nso a level select reloads the page with another `?scene`.\n\n**The world, `w`**, is what systems get:\n\n- **Components and entities.** `defineComponent('gem', { description, fields })` declares a component: typed fields\n  with defaults and units, so the state can be hashed, captured and checked. `w.spawn({ gem: { x, z } })` returns an\n  id; `w.query('gem')` returns the live entities holding it, in id order; `w.get(id)`, `w.add`, `w.remove` and\n  `w.despawn` do the rest. An entity whose component declares `x` and `z` in metres is drawn as a stand-in box until\n  something draws it properly (an actor, a prop, a crowd body).\n- **Systems** run in phases, in this order: `intents`, `ai`, `anim`, `physics`, `readback`, `rules`.\n  `w.systems.add('game.collect', collect, { phase: 'rules' })` puts a rule after the physics moved the bodies and the\n  readback copied their places into components.\n- **Events.** `w.emit('gem', payload)` delivers at the end of the step to `w.events.on('gem', …)` listeners. A page\n  reads them from `frame.world.events.trace()` (sounds, effects); emitters burst on them; tests count them.\n- **Time** is steps: `w.tick`, `w.dt` (1/60 s), `w.hz`. Count a duration in whole steps (30 s is 1,800), never by\n  adding up `w.dt`: floating-point sums drift. `w.timers` schedule in sim seconds.\n- **Randomness** comes from named streams seeded by the run: `w.rng('gems').int(0, 9)`, `.range(a, b)`, `.chance(p)`.\n- **Settings** are the game's tunable numbers: `defineSettings({ 'game.gems': { type, default, minimum, maximum,\n  unit, when: 'scene', description } })`, read with `w.settings.get('game.gems')`. Each is reachable from the URL\n  (`?game.gems=20`), from `node x sim … --set game.gems=20`, `node x set` and `__engine.set`, and replays record them.\n\n**Intents** are everything the sim reads from outside, once per step, as plain data: `move` (a world-space\ndirection `[x, z]`), `b` (buttons held), `p` (pressed this step), `aim`, `look`, `cam`, and the game's own\n`'game:<name>'` keys. A player actor reads the step's intents itself; systems get them as their second argument\n(`held(intents, 'jump')`, `pressed(intents, 'attack')`). In a page, devices make intents through an action map\n(`actionMap:thirdPerson` by default: WASD or the arrows run, Space jumps, Shift dashes); a map with `look: true` sends\nthe camera's view as `look`, and its `aimWith` fills `aim` (`centre`: what the screen's middle points at; `pointer`:\nthe pointer on the player's floor), and a game with several camera modes gives `createEngine` a map per camera\n(`actionMap: (code) => …`). A bot or a test writes them directly: `engine.step(1, { move: [1, 0] })`. A replay is the\nintents of a run, recorded.\n\n**Proof.** `engine.hash()` digests the whole sim. A replay file (labs/game/replays/bot.replay.json) holds a scene,\nseed, settings, the intents at each step that changed them, and the golden hashes at its checkpoints, per platform\n(`linux-x64`). `capture()` and `restore()` copy a run and continue it exactly. If a hash changes, play changed.\n\n## 3. The starter, file by file\n\nThe starter (labs/game/) is a whole small game: run round an arena collecting every gem before the clock runs out.\nGrow your game from it; keep its tests as they are, and change what they check as the game changes.\n\n| File                         | What it shows                                                                              |\n| ---------------------------- | ------------------------------------------------------------------------------------------ |\n| labs/game/scenes/play.ts     | The rules: a level as text, settings, components (`gem`, `round`), systems, a random stream, events |\n| labs/game/cast/player.ts     | The player: a character on the controller (run, jump, dash) drawn as the humanoid          |\n| labs/game/bot.ts             | A bot that plays through intents, steering down a flow field to the nearest gem            |\n| labs/game/main.ts            | The page: `createEngine`, the HUD in `onFrame`, Enter to play again, Esc's pause menu, the chase camera     |\n| labs/game/scenes/play.test.ts | The tests: the golden replay, capture and restore, the bot wins on 10 seeds, the clock     |\n| labs/game/replays/bot.replay.json | The bot's play, recorded, with its golden hashes                                      |\n| labs/game/README.md          | The game's own page: what it is, how it plays, the calls made                              |\n\n## 4. What to reach for\n\nThe public names below are in engine/sim-api.ts (sim-side) or engine/index.ts (pages); section 10 lists them all.\nThe box (labs/box/, its README says which scene shows what) has a working use of almost each one.\n\n| You need                       | Reach for                                                                                 | See it in                          |\n| ------------------------------ | ----------------------------------------------------------------------------------------- | ---------------------------------- |\n| A level                        | A text map in a scene module; `compileLevel`, glyphs (`#` wall, `.` floor, `@` spawn, `w` low wall, `P` pillar, `^` stairs, `=` gallery, `o` dais, `t` brazier), `defineGlyph` for your own; `addLevelBodies`; the page registers the text (`createEngine({ levels })`); a building of storeys: `node x new level`; buildings on a terrain: `defineSite`, `addSiteBodies` | labs/game/scenes/play.ts, labs/box/levels/hall.txt, labs/playground/levels/site.ts |\n| A player or character          | `createCharacter` (speed, jump, dash, coyote time, buffer), `spawnActor`, `measureFeel`; Apex's movement, `{ movement: 'movement:apex' }`, or your own: `defineMovement` (`node x new movement`); `node x feel`, `createFeelPanel` | labs/game/cast/player.ts, labs/box/cast/hero.ts, labs/playground/cast/player.ts |\n| Physics                        | `physics: true` in the scene, `physicsOf(w)`: bodies, `raycast`, `overlap`, `probe`; `addBox`, `addSensor`, `knock`, movers | labs/box/scenes/hall.ts |\n| Props                          | `defineProp` (meshes, a body, hooks), `spawnProp`, `hitProp`; the engine's `prop:crate`, `prop:barrel`, `prop:brazier`, `prop:pillar`; one a player uses or strikes: `defineUsable`, `defineStrikable`, `addInteraction` (`node x new interactable`) | labs/box/scenes/hall-props.ts |\n| Rides, doors and switches      | `addLevelLadders`, `addZipline`, `addLauncher`; `addLevelDoors`, `addLevelWindows`, `addSwitch`, `switchGroup`; `setDaytime`, `lightsAtDusk`; `placeActor` | labs/playground/scenes/site.ts |\n| Enemies and crowds             | Crowd bodies (`addAgent`, `updateCrowd`, `knockback`, `killAgent`), steering (`seek`, `followFlow`, `approachRing`), `NavGrid` and `FlowField`, attack tokens, `canSee` | labs/box/cast/walker.ts, labs/box/scenes/crowd-1000.ts |\n| Combat                         | Moves as data (`defineMove`, `Attack`, `Combo`), hit queries (`coneHits`, `sweepHits`), `damage` and `HEALTH`, projectiles, telegraphs, `reactTo`, `requestHitStop` | labs/box/scenes/fight.ts, labs/box/cast/hero.ts |\n| Melee, guns and targets        | `addMelee` (punches, kicks, the door kick), `defineWeapon`, `weaponsFor` and `addWeapons` (hip fire, the sights, a climbing recoil, reloads; `node x new weapon`), `defineThing` and `spawnThing` (targets that fall at a hit and stand again; `node x new thing`) | labs/playground/weapons/, labs/playground/cast/dummies.ts |\n| Ragdolls and joints            | `addJoint` (fixed, ball, hinge, slider, rope, spring, as data), `addRagdolls` and `handOff` (a hard blow or a death gives a person's body to physics; it gets up the way it lies), `standUp` | labs/box/scenes/ragdoll.ts, labs/playground/cast/partners.ts |\n| Animation                      | Actors animate themselves (`spawnActor({ anim: { build } })`); builds, bodies, the animator's body states, actions (`defineAction`, played on an actor with `actOn`), clips from the library (`playClip`) | labs/box/scenes/clips.ts, `node x anim find` |\n| How it looks                   | Materials and textures as data (`defineMaterial`, `defineTexture`), looks (`?post.look=look:storybook`, `post.combine`, `post.filters`, `defineLook`; `__engine.look()`), skies, lights | labs/box/looks/torch-lit.ts, `node x describe look` |\n| Effects                        | Emitters as data, bursting on sim events (`defineEmitter`); telegraphs; screen shake      | labs/box/scenes/fight.ts           |\n| UI                             | `engine.ui`: `hud(id, text, { at })`, `label`, `damage`, `crosshair`; screens and menus: `createMenu`, `createEngine({ store, modal })` (rebinds kept, a menu's keys out of play), `input.bindingsFor`, `rebind`, `listen` (a controls screen); the rest plain HTML/CSS | labs/game/main.ts (its pause), labs/playground/ui/, labs/box/menu.ts |\n| Sound                          | Effects and songs as data (`defineSfx`, `defineSong`), the page's `createAudio`; a scene's `sounds` maps events to sounds | labs/box/sounds/effects.ts, labs/box/sounds/page.ts |\n| Cameras                        | `?cam=iso` (`threequarter`, `topdown`, `overhead`, `brawler`, `side`), `?cam3=chase` (`orbit`, `fly`, `fixed`, `first`, `rail`, `shoulder`, `follow`); `__engine.camera.set(code, { blend: true })`; a map per mode: `createEngine({ actionMap: (code) => … })`; a mode of your own: `defineCamera` (`node x new camera`) | labs/game/main.ts, labs/playground/views.ts |\n| Touch controls                 | `defineTouchLayout`, `createEngine({ touchLayout })` (built, not yet tested on phones)   | labs/box/touch.ts                  |\n| A new entry of a kind          | `node x new <kind> labs/game/<dir>/<name>`: the module and its test from a template (`node x new` lists the kinds, tools/templates/README.md says where each goes; a new scene starts as a copy of play.ts instead) | tools/templates/                    |\n\nSaves, high scores and settings go in the page's store (`createStore`, never read by the sim), as labs/game/best.ts\nkeeps the best round.\n\n## 5. Rules that keep play reproducible\n\n- Sim-side code (labs/game/scenes/, labs/game/cast/) imports only engine/sim-api.ts; pages only engine/index.ts.\n  Never import three.js or Rapier directly: the public API re-exports what a game needs.\n- No clocks, timers, `Math.random`, `crypto`, DOM, storage, Web Audio or Node built-ins in sim-side code, and no\n  dynamic `import()`: lint refuses each, and its message names the fix. No network either: what the sim needs from\n  outside arrives as intents or settings. Write `Math.pow`, not `**`. Use the standard `Math`: the sim swaps in\n  portable ports while it steps, so the results match in Node and Chromium.\n- Time in steps; randomness from named streams; entities in `w.query`'s id order.\n- A sim-side module reads no files: a level's text lives in a string in the scene module.\n- Presentation never writes the sim: cameras, looks, particles, sound and the HUD change freely without changing a hash.\n- Units: metres, seconds, radians; +Y up, x east, z south; characters face +Z.\n\n**Assets.** Make them with code and data first: geometry, textures and materials as generators with parameters,\nsounds as voices and tracker notes, levels as text. A binary file (an image, a recorded sound, a model) needs the\nowner's approval: ask, and once they approve, list it in APPROVED-BINARIES.json at the game's root as\n`{ \"path\", \"reason\" }`, the reason their answer, who and when; `npm run check` fails a binary listed nowhere. Fonts\nare approved: anywhere in labs/game/, each with its license file beside it.\n\n## 6. Seeing it without a screen\n\nEvery command prints its verdict first, about 20 lines at most, and writes `out/<cmd>/<target>/report.json`;\n`node x help <cmd>` gives its manual.\n\n| Command                                                     | What it does                                                                     |\n| ----------------------------------------------------------- | -------------------------------------------------------------------------------- |\n| `npm test`                                                  | The game's tests (Vitest), headless                                              |\n| `npm run check`                                             | Types, lint, format, `node x check` (the asset rules; the engine as pinned)       |\n| `node x sim labs/game/scenes/play.ts [--steps n] [--seed s] [--set k=v] [--feel]` | Runs a scene in Node: its hash, events, entities; `--feel` measures the player |\n| `node x replay labs/game/replays [--browser sim] [--update] [--bisect]` | Checks replays' goldens; `--update` records them; `--bisect` finds where two runs part |\n| `node x shot labs/game [--cam code] [--set k=v] [--png]`    | Renders the page on WebGPU: coverage, visible objects, a text thumbnail; an image only with `--png` |\n| `node x eye labs/game/scenes/play.ts [--cam code] [--steps n]` | What a camera sees of the bodies, in Node with no GPU: a text picture and its legend (`__engine.eye()` in a page) |\n| `node x film labs/game --steps \"…\" [--compare ref]`         | Films scripted play as a contact sheet; `--compare` names the objects whose pixels changed |\n| `node x gallery <kind> [id] --page labs/game [--look id]`   | Films every prop, material, emitter, look, body or move as a labelled contact sheet; `#gallery/<kind>/<id>` opens one on any page |\n| `node x inspect --page labs/game`, then `node x eval \"<js>\"`, `node x dump`, `node x set <key> <value>` | A live headless page to question: the HUD through DOM queries, `__engine` |\n| `node x perf labs/game [--scene id]`                        | Performance as counters (ms per step and frame, draw calls), never frames per second |\n| `node x describe [kind [id]]`                               | The registries: every kind's fields and entries (materials, moves, looks, sounds…) |\n| `node x qa geo tex audio`                                   | Content QA by numbers: the engine's and the game's geometry, props, textures and sounds (labs/game/'s geometry, props, textures and sounds folders); a new or worse violation fails, and one the game accepts goes in its own `tests/baselines/qa-<family>-game.json` with the reason |\n| `node x new <kind> <id>`                                    | A new entry from its template, with its test                                     |\n| `node x audio sfx:<id>` · `node x anim find <words>`        | A sound rendered in Node, as numbers · the clip library searched                 |\n| `node x engine`                                             | Which engine the game is on, and whether its files are as shipped                |\n\n\n--- SCENE ---\n/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n\n--- ENTRY ---\n/**\n * @file The starter game's page (labs/game/index.html): it starts the engine (`createEngine`, engine/app/engine.ts) on\n * the scene `game:play` (labs/game/scenes/play.ts) with the arena's text registered for the view, offers the bot's\n * replay to `?replay=bot`, and shows the round each drawn frame in the HTML/CSS overlay's HUD: the gems, the clock,\n * the controls, the best round kept across sessions (labs/game/best.ts, through the engine's store) and, when the\n * round ends, how it ended. Enter then starts a new round on the next seed. Escape (or the pad's Start) pauses the\n * round under a menu (`createMenu`: Resume, New round), which keeps its keys out of play while it is open\n * (`createEngine({ modal })`); the store keeps the best round and any keys rebound (`createEngine({ store })`). The\n * camera is the chase camera unless the URL names one (`?cam=iso`, `?cam3=orbit`).\n *\n * Everything else a page does (routes, the renderer, the frame loop, the devices, `window.__engine`, the error\n * overlay, the touch controls) is the engine's, so this file is the game's own presentation only. It reads the run\n * and never changes it: the HUD cannot change the hash.\n *\n * Game code: it imports only the engine's public API (engine/index.ts) and the game's own files.\n *\n * Open it at http://127.0.0.1:5173/labs/game/ (`npm run dev`): `?seed=7&game.gems=20` plays another round,\n * `?replay=bot` the bot's, `?cam=iso` another camera. Headless, `node x shot labs/game` reports what it draws.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createMenu, createStore, type Engine, type EngineFrame, type Menu } from '../../engine';\nimport { bestOf, recordBest } from './best';\nimport { ARENA_TEXT, play, type Round } from './scenes/play';\n\n/** The page's query, with the chase camera when it names none: it follows the player round the arena. */\nconst search = new URLSearchParams(location.search);\nif (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\n\n/** The game's replays, by name (`?replay=bot`), as text loaded on demand. */\nconst replays = { bot: () => import('./replays/bot.replay.json?raw').then((module) => module.default) };\n\n/** The started engine; null until `createEngine` resolves (its first frames are drawn before that). */\nlet engine: Engine | null = null;\n\n/** Whether the round on screen has ended, so Enter starts the next. */\nlet ended = false;\n\n/** The game's store: its best round across sessions; a replay's page plays in its demo mode, so it sets none. */\nconst store = createStore({ prefix: 'my3dge-game:', mode: search.has('replay') ? 'demo' : 'play' });\n\n/** The fastest won round kept (s), and the run whose clock the page saw running, with the steps it started with. */\nlet best = bestOf(store);\nlet seen: { world: object; steps: number } | null = null;\n\n/** The pause menu while it is open; null while the round plays. */\nlet paused: Menu | null = null;\n\n/** Opens the pause menu over the paused round, or reads it a frame: Resume (or Escape again), New round. */\nfunction pauseMenu(dt: number): void {\n  const [inspector, ui, input] = [engine?.inspector, engine?.ui, engine?.input];\n  if (!inspector || !ui || !input) return;\n  const close = () => {\n    paused?.remove();\n    paused = null;\n    inspector.resume();\n  };\n  if (paused) return void paused.update(dt);\n  if (!input.pressed('pause')) return;\n  inspector.pause();\n  const items = [\n    { label: 'Resume', id: 'resume' },\n    { label: 'New round', id: 'new' },\n  ];\n  paused = createMenu(ui.root, items, { input, id: 'pause', title: 'Paused', onCancel: close, onPick: (_i, item) => {\n    if (typeof item === 'object' && item.id === 'new') inspector.seed(inspector.seed() + 1);\n    close();\n  } }); // prettier-ignore\n}\n\n/** Shows the round in the HUD: the gems, the clock, the controls, and how the round ended. */\nfunction showRound({ world }: EngineFrame): void {\n  const ui = engine?.ui;\n  const entity = world.query('round')[0] as unknown as { round: Round } | undefined;\n  if (!ui || !entity) return;\n  const { gems, collected, left, state } = entity.round;\n  if (seen?.world !== world) seen = state === 'playing' ? { world, steps: left + world.tick } : null;\n  const was = ended;\n  ui.hud('gems', `Gems ${collected} / ${gems}`, { at: 'top-left' });\n  ui.hud('clock', `${Math.ceil(left / world.hz)} s`, { at: 'top-right', color: left < 10 * world.hz ? '#ff8f6b' : '' });\n  ui.hud('keys', 'WASD: run · Space: jump · Shift: dash · Esc: pause', { at: 'bottom', keys: true });\n  ended = state !== 'playing';\n  if (ended && !was && state === 'won' && seen) best = recordBest(store, (seen.steps - left) / world.hz);\n  ui.hud('best', best === null ? null : `Best ${best.toFixed(1)} s`, { at: 'top-left' });\n  const end = state === 'won' ? 'Every gem! Enter: play again' : 'Time! Enter: play again';\n  ui.hud('end', ended ? end : null, { at: 'top' });\n}\n\nengine = await createEngine({\n  canvas: document.querySelector<HTMLCanvasElement>('#view')!,\n  scenes: [play.id],\n  levels: { 'level:arena': { text: ARENA_TEXT, file: 'labs/game/scenes/play.ts' } },\n  replays,\n  search: `?${search}`,\n  store,\n  modal: () => paused !== null,\n  onFrame: (frame) => {\n    pauseMenu(frame.dt);\n    showRound(frame);\n  },\n});\n\naddEventListener('keydown', (event) => {\n  const inspector = engine?.inspector;\n  if (event.code === 'Enter' && ended && inspector) inspector.seed(inspector.seed() + 1);\n});\n\n--- MANIFEST ---\n{\n  \"name\": \"wee-fit-retreat\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"A game made with the my-3dge engine.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=24.10 <25\"\n  },\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"typecheck\": \"tsc -b tsconfig.check.json\",\n    \"lint\": \"eslint --cache --cache-location node_modules/.cache/eslint/ .\",\n    \"format\": \"prettier --write --cache .\",\n    \"check\": \"node tools/checkAll.ts\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-simd-compat\": \"0.21.0\",\n    \"@stdlib/math-base-special-cos\": \"0.3.1\",\n    \"@stdlib/math-base-special-pow\": \"0.3.1\",\n    \"@stdlib/math-base-special-sin\": \"0.3.1\",\n    \"three\": \"0.182.0\"\n  },\n  \"devDependencies\": {\n    \"@modelcontextprotocol/sdk\": \"1.32.2\",\n    \"@playwright/test\": \"1.64.1\",\n    \"@stryker-mutator/core\": \"9.6.1\",\n    \"@stryker-mutator/vitest-runner\": \"9.6.1\",\n    \"@types/node\": \"24.19.2\",\n    \"@types/three\": \"0.182.0\",\n    \"eslint\": \"9.39.5\",\n    \"eslint-plugin-jsdoc\": \"61.7.1\",\n    \"globals\": \"16.5.0\",\n    \"prettier\": \"3.9.10\",\n    \"tsx\": \"4.23.15\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.72.1\",\n    \"vite\": \"7.3.7\",\n    \"vitest\": \"4.1.12\"\n  },\n  \"allowScripts\": {\n    \"esbuild\": false\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_105","type":"reasoning","text":"**Inspecting small files**"}}
{"type":"item.started","item":{"id":"item_106","type":"command_execution","command":"/bin/bash -lc \"cat labs/game/scenes/play.ts; printf '\\\\n--- ENTRY ---\\\\n'; cat labs/game/main.ts; printf '\\\\n--- HTML ---\\\\n'; cat labs/game/index.html; printf '\\\\n--- PACKAGE ---\\\\n'; cat package.json | head -65\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_106","type":"command_execution","command":"/bin/bash -lc \"cat labs/game/scenes/play.ts; printf '\\\\n--- ENTRY ---\\\\n'; cat labs/game/main.ts; printf '\\\\n--- HTML ---\\\\n'; cat labs/game/index.html; printf '\\\\n--- PACKAGE ---\\\\n'; cat package.json | head -65\"","aggregated_output":"/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n\n--- ENTRY ---\n/**\n * @file The starter game's page (labs/game/index.html): it starts the engine (`createEngine`, engine/app/engine.ts) on\n * the scene `game:play` (labs/game/scenes/play.ts) with the arena's text registered for the view, offers the bot's\n * replay to `?replay=bot`, and shows the round each drawn frame in the HTML/CSS overlay's HUD: the gems, the clock,\n * the controls, the best round kept across sessions (labs/game/best.ts, through the engine's store) and, when the\n * round ends, how it ended. Enter then starts a new round on the next seed. Escape (or the pad's Start) pauses the\n * round under a menu (`createMenu`: Resume, New round), which keeps its keys out of play while it is open\n * (`createEngine({ modal })`); the store keeps the best round and any keys rebound (`createEngine({ store })`). The\n * camera is the chase camera unless the URL names one (`?cam=iso`, `?cam3=orbit`).\n *\n * Everything else a page does (routes, the renderer, the frame loop, the devices, `window.__engine`, the error\n * overlay, the touch controls) is the engine's, so this file is the game's own presentation only. It reads the run\n * and never changes it: the HUD cannot change the hash.\n *\n * Game code: it imports only the engine's public API (engine/index.ts) and the game's own files.\n *\n * Open it at http://127.0.0.1:5173/labs/game/ (`npm run dev`): `?seed=7&game.gems=20` plays another round,\n * `?replay=bot` the bot's, `?cam=iso` another camera. Headless, `node x shot labs/game` reports what it draws.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createMenu, createStore, type Engine, type EngineFrame, type Menu } from '../../engine';\nimport { bestOf, recordBest } from './best';\nimport { ARENA_TEXT, play, type Round } from './scenes/play';\n\n/** The page's query, with the chase camera when it names none: it follows the player round the arena. */\nconst search = new URLSearchParams(location.search);\nif (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\n\n/** The game's replays, by name (`?replay=bot`), as text loaded on demand. */\nconst replays = { bot: () => import('./replays/bot.replay.json?raw').then((module) => module.default) };\n\n/** The started engine; null until `createEngine` resolves (its first frames are drawn before that). */\nlet engine: Engine | null = null;\n\n/** Whether the round on screen has ended, so Enter starts the next. */\nlet ended = false;\n\n/** The game's store: its best round across sessions; a replay's page plays in its demo mode, so it sets none. */\nconst store = createStore({ prefix: 'my3dge-game:', mode: search.has('replay') ? 'demo' : 'play' });\n\n/** The fastest won round kept (s), and the run whose clock the page saw running, with the steps it started with. */\nlet best = bestOf(store);\nlet seen: { world: object; steps: number } | null = null;\n\n/** The pause menu while it is open; null while the round plays. */\nlet paused: Menu | null = null;\n\n/** Opens the pause menu over the paused round, or reads it a frame: Resume (or Escape again), New round. */\nfunction pauseMenu(dt: number): void {\n  const [inspector, ui, input] = [engine?.inspector, engine?.ui, engine?.input];\n  if (!inspector || !ui || !input) return;\n  const close = () => {\n    paused?.remove();\n    paused = null;\n    inspector.resume();\n  };\n  if (paused) return void paused.update(dt);\n  if (!input.pressed('pause')) return;\n  inspector.pause();\n  const items = [\n    { label: 'Resume', id: 'resume' },\n    { label: 'New round', id: 'new' },\n  ];\n  paused = createMenu(ui.root, items, { input, id: 'pause', title: 'Paused', onCancel: close, onPick: (_i, item) => {\n    if (typeof item === 'object' && item.id === 'new') inspector.seed(inspector.seed() + 1);\n    close();\n  } }); // prettier-ignore\n}\n\n/** Shows the round in the HUD: the gems, the clock, the controls, and how the round ended. */\nfunction showRound({ world }: EngineFrame): void {\n  const ui = engine?.ui;\n  const entity = world.query('round')[0] as unknown as { round: Round } | undefined;\n  if (!ui || !entity) return;\n  const { gems, collected, left, state } = entity.round;\n  if (seen?.world !== world) seen = state === 'playing' ? { world, steps: left + world.tick } : null;\n  const was = ended;\n  ui.hud('gems', `Gems ${collected} / ${gems}`, { at: 'top-left' });\n  ui.hud('clock', `${Math.ceil(left / world.hz)} s`, { at: 'top-right', color: left < 10 * world.hz ? '#ff8f6b' : '' });\n  ui.hud('keys', 'WASD: run · Space: jump · Shift: dash · Esc: pause', { at: 'bottom', keys: true });\n  ended = state !== 'playing';\n  if (ended && !was && state === 'won' && seen) best = recordBest(store, (seen.steps - left) / world.hz);\n  ui.hud('best', best === null ? null : `Best ${best.toFixed(1)} s`, { at: 'top-left' });\n  const end = state === 'won' ? 'Every gem! Enter: play again' : 'Time! Enter: play again';\n  ui.hud('end', ended ? end : null, { at: 'top' });\n}\n\nengine = await createEngine({\n  canvas: document.querySelector<HTMLCanvasElement>('#view')!,\n  scenes: [play.id],\n  levels: { 'level:arena': { text: ARENA_TEXT, file: 'labs/game/scenes/play.ts' } },\n  replays,\n  search: `?${search}`,\n  store,\n  modal: () => paused !== null,\n  onFrame: (frame) => {\n    pauseMenu(frame.dt);\n    showRound(frame);\n  },\n});\n\naddEventListener('keydown', (event) => {\n  const inspector = engine?.inspector;\n  if (event.code === 'Enter' && ended && inspector) inspector.seed(inspector.seed() + 1);\n});\n\n--- HTML ---\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n\n--- PACKAGE ---\n{\n  \"name\": \"wee-fit-retreat\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"A game made with the my-3dge engine.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=24.10 <25\"\n  },\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"typecheck\": \"tsc -b tsconfig.check.json\",\n    \"lint\": \"eslint --cache --cache-location node_modules/.cache/eslint/ .\",\n    \"format\": \"prettier --write --cache .\",\n    \"check\": \"node tools/checkAll.ts\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-simd-compat\": \"0.21.0\",\n    \"@stdlib/math-base-special-cos\": \"0.3.1\",\n    \"@stdlib/math-base-special-pow\": \"0.3.1\",\n    \"@stdlib/math-base-special-sin\": \"0.3.1\",\n    \"three\": \"0.182.0\"\n  },\n  \"devDependencies\": {\n    \"@modelcontextprotocol/sdk\": \"1.32.2\",\n    \"@playwright/test\": \"1.64.1\",\n    \"@stryker-mutator/core\": \"9.6.1\",\n    \"@stryker-mutator/vitest-runner\": \"9.6.1\",\n    \"@types/node\": \"24.19.2\",\n    \"@types/three\": \"0.182.0\",\n    \"eslint\": \"9.39.5\",\n    \"eslint-plugin-jsdoc\": \"61.7.1\",\n    \"globals\": \"16.5.0\",\n    \"prettier\": \"3.9.10\",\n    \"tsx\": \"4.23.15\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.72.1\",\n    \"vite\": \"7.3.7\",\n    \"vitest\": \"4.1.12\"\n  },\n  \"allowScripts\": {\n    \"esbuild\": false\n  }\n}\n","exit_code":0,"status":"completed"}}
