{"type":"item.started","item":{"id":"item_886","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\npath = next(Path.cwd().glob('Wee-Fit-Retreat-Wii-Fit-*.html'))\nwith sync_playwright() as playwright:\n    for name in ('chromium', 'webkit'):\n        browser = getattr(playwright, name).launch(headless=True)\n        page = browser.new_page(viewport={'width': 375, 'height': 667}, device_scale_factor=1)\n        errors = []\n        page.on('pageerror', lambda error: errors.append(str(error)))\n        page.goto(path.as_uri(), wait_until='load')\n        page.locator('[data-action=\\\"about\\\"]').first.click()\n        dialog = page.get_by_role('dialog', name='About and credits')\n        assert dialog.is_visible(), f'{name}: dialog not visible'\n        content = dialog.inner_text()\n        for section in ('Source Information', 'Testing Feedback', 'Engine Feedback', 'Prompt Feedback'):\n            assert section in content, f'{name}: missing {section}'\n        if name == 'webkit': page.screenshot(path='/tmp/viewport-matrix/wee-fit-final/about-phone-webkit.png')\n        page.locator('[data-action=\\\"close\\\"]').first.click()\n        assert not dialog.is_visible(), f'{name}: dialog did not close'\n        assert not errors, f'{name}: {errors}'\n        print(f'{name}: offline About screen opens, contains required sections, closes; no page errors')\n        browser.close()\nPY\nprintf '\\\\n--- PROGRESS ---\\\\n'\ncat PROGRESS.md\nprintf '\\\\n--- FEEDBACK ---\\\\n'\ncat exit-interview.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
