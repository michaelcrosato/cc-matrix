{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' labs/game/scenes/play.ts; printf '\\\\n--- SIM API ---\\\\n'; sed -n '1,150p' engine/sim-api.ts; printf '\\\\n--- GUIDE INDEX ---\\\\n'; rg -n 'virtual|action|intents|primitive|material:' docs/GAME-GUIDE.md | head -65\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' labs/game/scenes/play.ts; printf '\\\\n--- SIM API ---\\\\n'; sed -n '1,150p' engine/sim-api.ts; printf '\\\\n--- GUIDE INDEX ---\\\\n'; rg -n 'virtual|action|intents|primitive|material:' docs/GAME-GUIDE.md | head -65\"","aggregated_output":"/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n\n--- SIM API ---\n/**\n * @file The public API for sim-side game code (PLAN.md §6.1, §6.9, WP 1.6; doctrine: Quality under the hood): what a\n * scene, a cast member or a behaviour imports, and all it may import (ESLint's public-API rule), so `x sim` runs it\n * in Node and its play is reproducible. engine/index.ts re-exports all of it for pages.\n *\n * What is here: scenes, the world and its components, the registries and settings, the intents vocabulary,\n * three.js's math classes with the engine's angle helpers, seeded randomness, and the event types. docs/API.md\n * lists every name with the first sentence of its doc comment; `node x describe` lists the registries.\n *\n * Invariants: a flat list of `export … from` lines, one name per line, grouped by area, and append-only: each WP adds\n * its public names at the end of their area, so parallel lanes merge cleanly (§11.3). The Animation area lives in\n * engine/anim/api.ts, re-exported here whole so this file stays under its line cap (ADR-0020 amendment 8): append\n * animation names there; Phase 13's movement areas likewise in engine/sim/movementApi.ts (ADR-0025 amendment 7), its\n * sites' in engine/sim/siteApi.ts, its house's in engine/sim/houseApi.ts (amendment 19), and the crowds' and combat's\n * in engine/sim/combatApi.ts and the gameplay kits' in engine/sim/kitsApi.ts (amendment 23). Only sim-side modules are\n * re-exported (ESLint's layer rule for this file).\n * Each name is documented where it is declared, and `x docs --check` fails a public export without its doc comment.\n * Game code reaches three.js only through these re-exports.\n *\n * @example\n * // fixtures/scenes/kernel/index.ts\n * // import { defineScene, defineComponent, held, type World } from '../../../engine/sim-api';\n * @see fixtures/scenes/kernel/index.ts\n */\n\n// Scenes: defined as data with a setup and a step, run by x sim, x replay and createHeadless.\nexport { defineScene } from './sim/scene';\nexport type { Scene } from './sim/scene';\nexport type { SceneSpec } from './sim/scene';\nexport type { SceneAction } from './sim/scene';\nexport type { SceneSound } from './sim/scene';\nexport { defineDevAction } from './sim/devActions';\nexport type { DevActionSpec } from './sim/devActions';\n\n// The world: entities, components, systems, timers, events.\nexport type { World } from './sim/world';\nexport type { SimRng } from './sim/world';\nexport type { WorldTimers } from './sim/world';\nexport type { WorldEvents } from './sim/world';\nexport { defineComponent } from './sim/state';\nexport type { Entity } from './sim/state';\nexport type { With } from './sim/state';\nexport type { SpawnSpec } from './sim/state';\nexport type { ComponentOf } from './sim/state';\nexport { PHASES } from './sim/systems';\nexport type { Phase } from './sim/systems';\nexport type { SystemFn } from './sim/systems';\n\n// Registries and settings: content as data, one schema for every setting.\nexport { defineKind } from './core/registry';\nexport { def } from './core/registry';\nexport type { Entry } from './core/registry';\nexport type { Kind } from './core/registry';\nexport type { KindSpec } from './core/registry';\nexport type { Field } from './core/schema';\nexport type { Schema } from './core/schema';\nexport { defineSettings } from './core/settings';\nexport type { SimSettings } from './core/settings';\nexport type { SettingValue } from './core/settings';\n\n// Intents: what the sim reads from outside each step.\nexport { held } from './input/intents';\nexport { pressed } from './input/intents';\nexport { fromCamera } from './input/intents';\nexport { INTENT_KEYS } from './input/intents';\nexport type { Intents } from './input/intents';\nexport type { IntentValue } from './input/intents';\nexport type { CustomIntentKey } from './input/intents';\nexport { createInputBuffer } from './input/intents';\nexport { updateInputBuffer } from './input/intents';\nexport { released } from './input/intents';\nexport { buffered } from './input/intents';\nexport { consume } from './input/intents';\nexport { consumeAll } from './input/intents';\nexport { repeated } from './input/intents';\nexport { BUFFER_STEPS } from './input/intents';\nexport { REPEAT_DELAY } from './input/intents';\nexport { REPEAT_RATE } from './input/intents';\nexport type { InputBuffer } from './input/intents';\n\n// Math: three.js's math classes and the engine's helpers (MathUtils covers clamp, lerp, damp, smoothstep).\nexport { Vector3 } from './core/math';\nexport { Quaternion } from './core/math';\nexport { Matrix4 } from './core/math';\nexport { Euler } from './core/math';\nexport { Box3 } from './core/math';\nexport { Sphere } from './core/math';\nexport { Ray } from './core/math';\nexport { Plane } from './core/math';\nexport { Color } from './core/math';\nexport { MathUtils } from './core/math';\nexport { approach } from './core/math';\nexport { angDiff } from './core/math';\nexport { lerpAng } from './core/math';\nexport { approachAng } from './core/math';\nexport { smoothDamp } from './core/math';\nexport { ease } from './core/math';\nexport { swingTwist } from './core/math';\n\n// Randomness: seeded streams (the world's are w.rng('<stream>')).\nexport { Rng } from './core/rng';\n\n// Events: emitted with w.emit, heard with w.events.on.\nexport type { EventMap } from './core/events';\nexport type { Listener } from './core/events';\nexport type { TraceRecord } from './core/events';\n\n// Levels: a legend of glyphs, level text compiled to plain data (heights, solid grid, colliders, meshes, spawns).\nexport { compileLevel } from './world/level/compile';\nexport type { CompileOptions } from './world/level/compile';\nexport { validateLevel } from './world/level/validate';\nexport type { LevelSource } from './world/level/validate';\nexport type { LevelProblem } from './world/level/problems';\nexport { defineGlyph } from './world/level/glyph';\nexport type { Glyph } from './world/level/glyph';\nexport type { GlyphSpec } from './world/level/glyph';\nexport { defineLevel } from './world/level/level';\nexport { getLevel } from './world/level/level';\nexport type { LevelEntry } from './world/level/level';\nexport { floorHeight } from './world/level/heights';\nexport { topHeight } from './world/level/heights';\nexport { solidAt } from './world/level/heights';\nexport { tileAt } from './world/level/heights';\nexport { LEVEL_FORMAT } from './world/level/types';\nexport type { CompiledLevel } from './world/level/types';\nexport type { LevelGlyph } from './world/level/types';\nexport type { BoxCollider } from './world/level/types';\nexport type { ColliderDescriptor } from './world/level/types';\nexport type { GroundDescriptor } from './world/level/types';\nexport type { MeshDescriptor } from './world/level/types';\nexport type { SpawnPoint } from './world/level/types';\nexport type { LightSpot } from './world/level/types';\nexport type { TileRect } from './world/level/types';\nexport type { Point3 } from './world/level/types';\n\n// Animation (WP 3.4 onward): skeleton, builds, poses, IK, the humanoid, moves, reactions, checks and actions, listed\n// area by area in engine/anim/api.ts so this file stays under its line cap (ADR-0020 amendment 8).\nexport * from './anim/api';\n\n// Physics (WP 3.1): Rapier behind plain terms. A scene with `physics: true` has a physics world: bodies by id,\n// raycasts, shape casts, overlaps and ground probes, collision groups by name, a level's bodies; presentation reads\n// it through the read-only QueryView.\nexport { physicsOf } from './physics/binding';\nexport type { Physics } from './physics/world';\nexport type { BodySpec } from './physics/world';\nexport type { ColliderSpec } from './physics/world';\nexport type { BodyState } from './physics/world';\nexport type { BodyChange } from './physics/world';\nexport type { BodyType } from './physics/world';\nexport type { Shape } from './physics/queries';\n\n--- GUIDE INDEX ---\n13:  same intents give the same state, bit for bit, in Node and in Chromium; every state has a 16-digit hash.\n28:| `data/anim/`                                                     | The animation library: readable clips, and the engine's actions                       |\n40:the sim, turns the keyboard, mouse, pads and touch into intents, draws every frame on WebGPU, and calls your `onFrame`\n44:setup(w), step(w, intents) })`. `setup` spawns entities and adds systems; `step` runs first in every step. One page can\n55:- **Systems** run in phases, in this order: `intents`, `ai`, `anim`, `physics`, `readback`, `rules`.\n69:`'game:<name>'` keys. A player actor reads the step's intents itself; systems get them as their second argument\n70:(`held(intents, 'jump')`, `pressed(intents, 'attack')`). In a page, devices make intents through an action map\n71:(`actionMap:thirdPerson` by default: WASD or the arrows run, Space jumps, Shift dashes); a map with `look: true` sends\n74:(`actionMap: (code) => …`). A bot or a test writes them directly: `engine.step(1, { move: [1, 0] })`. A replay is the\n75:intents of a run, recorded.\n78:seed, settings, the intents at each step that changed them, and the golden hashes at its checkpoints, per platform\n90:| labs/game/bot.ts             | A bot that plays through intents, steering down a flow field to the nearest gem            |\n106:| Props                          | `defineProp` (meshes, a body, hooks), `spawnProp`, `hitProp`; the engine's `prop:crate`, `prop:barrel`, `prop:brazier`, `prop:pillar`; one a player uses or strikes: `defineUsable`, `defineStrikable`, `addInteraction` (`node x new interactable`) | labs/box/scenes/hall-props.ts |\n112:| Animation                      | Actors animate themselves (`spawnActor({ anim: { build } })`); builds, bodies, the animator's body states, actions (`defineAction`, played on an actor with `actOn`), clips from the library (`playClip`) | labs/box/scenes/clips.ts, `node x anim find` |\n117:| Cameras                        | `?cam=iso` (`threequarter`, `topdown`, `overhead`, `brawler`, `side`), `?cam3=chase` (`orbit`, `fly`, `fixed`, `first`, `rail`, `shoulder`, `follow`); `__engine.camera.set(code, { blend: true })`; a map per mode: `createEngine({ actionMap: (code) => … })`; a mode of your own: `defineCamera` (`node x new camera`) | labs/game/main.ts, labs/playground/views.ts |\n130:  outside arrives as intents or settings. Write `Math.pow`, not `**`. Use the standard `Math`: the sim swaps in\n258:**Reactions and secondary motion (WP 6.2)**: a directional flinch, knockdown, death and the get-up chosen by how the body lies (face up or face down), stepped in the sim; verlet chains (hair, tails) with bone-capsule colliders, a floor probe and a rest shape, a cape of two chains, and the squash spring as a volume-preserving root scale, drawn by an animator layer in the view.\n259:`Reactions`, `REACTION`, `REACTIONS`, `lyingOf`, `Chain`, `CHAIN`, `Cape`, `Secondary`, `HAIR`, `CAPE`, `TAIL`, `SQUASH`, `squashScale`, `BODY_CAPSULES`, `bodyCapsules`; types `ReactionOptions`, `ReactionState`, `ReactionBody`, `ReactionName`, `Lying`, `ChainOptions`, `ChainTuning`, `BoneCapsule`, `CapeOptions`, `SecondaryOptions`.\n264:**Actions (WP 8.7)**: multi-beat sequences a body plays, beats of body states, clips, IK targets, flips and squashes with held contact frames, events, flags and cancel windows; the engine's set is data/anim/actions/, which loadActions defines.\n265:`Actions`, `defineAction`, `getAction`, `loadActions`, `actionCheck`, `ACTION`, `FLIP_AXES`, `EFFECTORS`, `CHANNELS`; types `ActionsOptions`, `ActionsState`, `Action`, `Beat`, `ActionSpec`.\n276:**Characters (WP 3.2)**: actors moved by the character controller (Rapier's, moved across then down), with an action game's feel: acceleration and skid, coyote time, a jump buffer, a variable jump, a wall jump, a dash, pushing props; the feel meter measures how one handles. A body's reactions and an actor's secondary motion as components (WP 7.8), and its actions (`actOn`, WP 13.11).\n277:`createCharacter`, `CHARACTER_FIELDS`, `CHARACTER_STATE_FIELDS`, `spawnActor`, `removeActor`, `measureFeel`, `reactTo`, `stepReactions`, `REACTION_FIELDS`, `SECONDARY_FIELDS`, `actOn`, `ACTIONS_FIELDS`; types `Character`, `CharacterState`, `ActorSpec`, `ActorComponent`, `ActorComponents`, `FeelReport`, `FeelOptions`, `AnimatorComponent`, `SecondaryComponent`, `ReactionComponents`, `ActionComponents`.\n330:**The feel kit, sim-side (WP 13.4)**: the shooter model's live tuning, `movement.<group>.<field>` (a setting off its default replaces that number in every model character's model, from the next step), and an actor placed at rest (a scene's dev action: a feel course's start).\n349:`addInteraction`, `defineUsable`, `defineStrikable`, `strikeEntity`, `USE_REACH`, `CARRY_MASS`, `THROW_SPEED`, `propOfBody`; types `UsableSpec`, `InteractorComponent`, `StrikeForce`, `SpawnPropOptions`, `PropHealthComponent`, `PropLightComponent`.\n398:**Input (WP 3.3)**: the devices of a page sampled into intents (keys by physical code, mouse with pointer lock and the wheel, gamepads in any slot), action maps and their presets, bindings players change and keep, prompts per device, the virtual device that __engine.input drives, and the scripted gamepad for tests.\n401:**Aiming and look (WP 13.9)**: the point the intents' aim carries by a map's rule, and the look settings input.*.\n404:**Held bindings (WP 13.20)**: a key or a button kept down for an action of its own (Apex's pad reload on X held), and the device a code is of.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cat AGENTS.md 2>/dev/null; printf '\\\\n--- engine guide ---\\\\n'; sed -n '1,180p' Wee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/AGENTS.md; printf '\\\\n--- starter scene ---\\\\n'; sed -n '1,260p' Wee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/labs/game/scenes/play.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cat AGENTS.md 2>/dev/null; printf '\\\\n--- engine guide ---\\\\n'; sed -n '1,180p' Wee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/AGENTS.md; printf '\\\\n--- starter scene ---\\\\n'; sed -n '1,260p' Wee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/labs/game/scenes/play.ts\"","aggregated_output":"\n--- engine guide ---\n# AGENTS.md: wee-fit-retreat\n\nwee-fit-retreat is a game made with my-3dge, a 3D web game engine built for AI coding agents: TypeScript, three.js on\nWebGPU, Rapier physics, gameplay reproducible on the CPU and checked without a screen, the UI in HTML/CSS. The engine\nis in this repository, pinned to the commit engine-lock.json names; you make the game.\n\nBefore your first change, read docs/GAME-GUIDE.md once: how a game is built on this engine, the commands that prove\nit works, and where to look things up. Then grow the game from the starter in labs/game/, which already plays, wins\nthrough its bot, and passes its tests.\n\n## Set up (once per machine)\n\n    bash scripts/setup.sh\n\nIt installs Node 24 when missing (Linux x64), Chromium for the browser commands when missing, then `npm ci`. Plain\n`npm ci` is enough for everything except `x shot`, `x film` and `x replay --browser`.\n\n## The loop\n\n1. Edit the game in labs/game/: sim-side code (the rules) in labs/game/scenes/ and labs/game/cast/, the page in\n   labs/game/main.ts.\n2. `npm run check`: types, lint, format, the asset rules, and the engine unchanged.\n3. `npm test`: the game's tests (its replay's golden hashes, capture and restore, the bot wins on 10 seeds).\n4. See it without a screen: `node x sim labs/game/scenes/play.ts` (the hash and the events), `node x shot labs/game`\n   (what the page draws, as numbers and a text thumbnail), `node x replay labs/game/replays --browser sim` (the\n   goldens, in Node and Chromium). `node x help` lists every command; each prints its verdict first and writes\n   out/<cmd>/…/report.json.\n5. Commit, and keep labs/game/README.md current: what the game is, how it plays, the calls you made.\n\n`npm run dev` serves the game at http://127.0.0.1:5173/labs/game/ for a person to play.\n\n## Rules\n\n- **The engine is read-only.** engine/, tools/, data/, labs/box/ (the engine's worked example), scripts/setup.sh, the\n  configs and the docs it shipped: engine-lock.json lists every one, and `npm run check` fails when one changes. When\n  the engine is in your way, work round it in the game and write what you needed in ENGINE-FEEDBACK.md. Only when no\n  workaround exists, patch the engine file and list it under \"Local engine patches\" there, with why.\n- **Only the public API.** Pages import engine/index.ts; sim-side code imports engine/sim-api.ts (lint enforces it).\n- **Reproducible play.** Sim-side code reads no clock, no `Math.random`, no DOM: randomness comes from named streams\n  (`w.rng('loot')`), time is whole 60 Hz steps. The same intents and seed give the same hashes, in Node and Chromium.\n- **Assets are code or text first**: geometry, textures, materials and sounds as data. A binary file only with the\n  owner's approval, listed in APPROVED-BINARIES.json with their answer (`npm run check` fails one unlisted); fonts are\n  approved, anywhere in labs/game/ with their license beside them.\n- SI units, +Y up, characters face +Z. Every file opens with a `@file` comment and stays under 400 lines.\n- **Ask the owner** before anything outward or costly: a binary asset, a new npm dependency, spending money,\n  publishing. No answer within 15 minutes: take the safer choice, note it in labs/game/README.md, carry on.\n- Update the engine only when the owner asks: `node x engine --update`.\n\n## Done means\n\n`npm run check` and `npm test` pass; the bot still wins (teach it each new rule); a change that alters play on\npurpose records the replay's goldens again (`node x replay labs/game/replays --browser sim --update`) with the reason\nin the commit; labs/game/README.md says what the game is now.\n\n--- starter scene ---\n/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_81","type":"reasoning","text":"**Inspecting key APIs**"}}
{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"cat labs/game/AGENTS.md; sed -n '150,280p' labs/game/scenes/play.ts; sed -n '1,200p' labs/game/cast/player.ts; cat labs/game/index.html; cat package.json | head -90; sed -n '564,635p' ../PLAN.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"cat labs/game/AGENTS.md; sed -n '150,280p' labs/game/scenes/play.ts; sed -n '1,200p' labs/game/cast/player.ts; cat labs/game/index.html; cat package.json | head -90; sed -n '564,635p' ../PLAN.md\"","aggregated_output":"cat: labs/game/AGENTS.md: No such file or directory\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n/**\n * @file The starter game's player: the character the keys move (the character controller's numbers: how it runs,\n * jumps and dashes) and the body it is drawn as, and `spawnPlayer`, which stands it in a scene. A game keeps its\n * cast here, one character a file, as the box keeps its hero, walkers, slimes and wisps (labs/box/cast/); its scenes\n * spawn them. `node x sim labs/game/scenes/play.ts --feel` measures how the player handles: response, top speed, the\n * jump's height and air time, the dash's reach.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter(6).speed; // 6: m/s\n * playerCharacter(6).jumpSpeed; // 9: m/s at take-off, about 1.27 m up, over the arena's 0.75 m low walls\n * @see labs/game/scenes/play.ts\n */\nimport { createCharacter, spawnActor, type Character, type World } from '../../../engine/sim-api';\n\n/** The player's take-off speed, m/s: about 1.27 m up under the controller's gravity, over a 0.75 m low wall. */\nexport const JUMP_SPEED = 9;\n\n/** The body the player is drawn as: the humanoid in the chibi build, empty-handed. */\nexport const PLAYER_BODY = Object.freeze({ build: 'build:chibi', weapon: 'none' });\n\n/** The player's character at `speed` m/s; createCharacter's defaults for the rest (its dash among them). */\nexport function playerCharacter(speed: number): Character {\n  return createCharacter({ speed, jumpSpeed: JUMP_SPEED });\n}\n\n/** Stands the player in `w` (a scene with physics) at `at`, facing `yaw`: an actor the step's intents move. */\nexport function spawnPlayer<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  speed: number,\n  yaw = 0,\n): number {\n  const character = playerCharacter(speed);\n  return spawnActor(w, { at: [at[0], at[1], at[2]], character, player: true, yaw, anim: { ...PLAYER_BODY } });\n}\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n{\n  \"name\": \"wee-fit-retreat\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"A game made with the my-3dge engine.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=24.10 <25\"\n  },\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"typecheck\": \"tsc -b tsconfig.check.json\",\n    \"lint\": \"eslint --cache --cache-location node_modules/.cache/eslint/ .\",\n    \"format\": \"prettier --write --cache .\",\n    \"check\": \"node tools/checkAll.ts\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-simd-compat\": \"0.21.0\",\n    \"@stdlib/math-base-special-cos\": \"0.3.1\",\n    \"@stdlib/math-base-special-pow\": \"0.3.1\",\n    \"@stdlib/math-base-special-sin\": \"0.3.1\",\n    \"three\": \"0.182.0\"\n  },\n  \"devDependencies\": {\n    \"@modelcontextprotocol/sdk\": \"1.32.2\",\n    \"@playwright/test\": \"1.64.1\",\n    \"@stryker-mutator/core\": \"9.6.1\",\n    \"@stryker-mutator/vitest-runner\": \"9.6.1\",\n    \"@types/node\": \"24.19.2\",\n    \"@types/three\": \"0.182.0\",\n    \"eslint\": \"9.39.5\",\n    \"eslint-plugin-jsdoc\": \"61.7.1\",\n    \"globals\": \"16.5.0\",\n    \"prettier\": \"3.9.10\",\n    \"tsx\": \"4.23.15\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.72.1\",\n    \"vite\": \"7.3.7\",\n    \"vitest\": \"4.1.12\"\n  },\n  \"allowScripts\": {\n    \"esbuild\": false\n  }\n}\n### In AI Hub: AI Hub Session Protocol v1, mode **ghost**\n\nRead the protocol once: `https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`. Fetch by raw URL, into\n`labs/game/hub/`: `session.js` (save it as `session-client.txt`), and for tests `harness.html`, `bridge.js`, `round.js` from the same\nfolder. **Do not clone the ai-hub repository: it is 5.3 GB.**\n\nWhy ghost: every copy runs its own seeded round, nothing depends on a host, and each player sees the others on the neighbouring mats,\nwobbling in their seat colour. It is the source's solo ritual made social without any interference.\n\n**Tags** in the head, right after the client (the build injects them, section 14):\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Stay the steadiest across three classes\">\n<meta name=\"hub:session-howto\" content=\"Lean: stick or WASD · Feet: L2 R2 or Q E · Breathe: both or Space\">\n<meta name=\"hub:webgpu\" content=\"required\">\n```\n\nGoal at most 60 characters, how-to at most 80. Also `hub:type` Game, `hub:players` 1-4, `hub:source` Wii Fit.\n\n**Startup** **[tested: this shape, on the starter's one scene, passed the harness at 2, 3 (host leaving) and 4 players with the engine running in every frame]**:\n\n```ts\nconst search = new URLSearchParams(location.search);\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key); // see the trap below\nsearch.set('touch', 'off');\nconst AIHub = window.AIHub;\nconst info = AIHub?.active ? await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\nif (info) { search.set('scene', 'game:round'); search.set('seed', String(info.seed)); }\nconst watchdog = info ? setTimeout(() => AIHub.ready(), 14000) : 0;   // the harness allows 20 s after hello\nengine = await createEngine({ canvas, scenes: ['game:island', 'game:round'], search: `?${search}`, /* … */ });\nif (info) { clearTimeout(watchdog); AIHub.ready(); }\n```\n\n**The biggest trap in this whole plan [tested]:** the hub opens the page with `?aihub=1&aihub-seed=N`. `createEngine` treats every\nunknown query key as a setting and fails with `CORE_BAD_SETTING`, **and the harness still reports PASS**, because the client keeps\nanswering while the game is dead. Strip those keys, and make your test assert, inside every frame, `__engine.ready === true` and\n`__engine.errors.length === 0`.\n\n**The round in a session:**\n\n- No title, menus or attract. Straight to the game's own card: the four mats in the pavilion, Plumb in front, each player standing on their\n  mat. It shows the game's title, players in colour with who is ready, how to win, this player's controls, seconds left (from the `card` event).\n  Keys: Enter or Cross answers `AIHub.answer('ready')`, Triangle or T answers `'more'`, a tap or click works too. Listen for Enter with your own\n  `keydown` on `window`: the harness sends a synthetic one. The card has no menus or choices, and draws numbers only from `AIHub.rng('card')`.\n  Make it HTML over whatever is drawn, because the watchdog may call `ready()` while the view is still warming up.\n- `start` arrives; play begins at `AIHub.time() >= 0`. Send the sim `round.go` then (scene action). On `start` also send one\n  `AIHub.progress({ score: 0, label: 'Breathing in' })` and one ghost message, so a slow copy still passes the harness.\n- During play: `AIHub.progress({ score, label })` whenever it changes (label at most 24 characters, \"Class 2 · 640\"), and every 100 ms\n  `AIHub.send({ t: 'g', e: classIndex, x, y, p: poseId, s: score }, { reliable: false })`. Never above 20 a second.\n- Ghosts are sim entities, because only sim entities can be drawn: incoming messages go through\n  `engine.input.virtual.axis('game:ghosts', […])` to actors on the other mats, tinted with `info.players[i].color`, leans scrubbed by their CoB,\n  name labels from the hub as text (never as HTML), shown only while `e` matches. On `leave`, they walk off politely.\n- Finished: `AIHub.result({ score, stats, awards })` once. Stats at most six, names at most 16 characters (\"Wobble Age\", \"Best hold\", \"Breath\"),\n  values short; awards at most three, title at most 24, detail at most 40 (\"Unnervingly Still\").\n- `time-up`: report the current score at once if you have not. `end`: `engine.stop()`, stop all sound, take no input, send nothing.\n- If `engine.ready` is false (no WebGPU): `AIHub.fail('WebGPU required')`.\n- **Rules in a session:** network only through the hub; no chat or custom names; no `alert`, `confirm`, `prompt`, `window.open` or navigation; restart\n  and quit do nothing. Pause is an overlay that never pauses the sim: Resume, volume, button icons. No dev mode. **Create + Options belongs to the hub:**\n  while pad button 8 is held, ignore the engine's `pause`. Storage is a fresh memory copy, handled by the client, so write nothing special for it.\n- Outside a session (`connect` gives `null`, or no client at all in the dev server) the game must behave exactly as it does alone.\n\n**Boot deadline, the one place performance matters.** The harness gives every copy 20 s to call `ready()`. **[tested on SwiftShader]** the starter\ngame alone needed 8–16 s per copy at four copies; the engine's playground needed 52–73 s. So `game:round` is a small separate scene with just the\npavilion, the mats and the cast. The island's cost never reaches a session, and the watchdog covers the rest. Performance is out of scope everywhere else.\n\n---\n\n## 10. Art direction\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_83","type":"reasoning","text":"**Reading focused docs**"}}
{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,200p' labs/game/main.ts; printf '\\\\n--- SCENE ---\\\\n'; sed -n '1,200p' labs/game/scenes/play.ts; printf '\\\\n--- HUB ---\\\\n'; sed -n '564,635p' ../PLAN.md; printf '\\\\n--- INDEX ---\\\\n'; cat labs/game/index.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,200p' labs/game/main.ts; printf '\\\\n--- SCENE ---\\\\n'; sed -n '1,200p' labs/game/scenes/play.ts; printf '\\\\n--- HUB ---\\\\n'; sed -n '564,635p' ../PLAN.md; printf '\\\\n--- INDEX ---\\\\n'; cat labs/game/index.html\"","aggregated_output":"/**\n * @file The starter game's page (labs/game/index.html): it starts the engine (`createEngine`, engine/app/engine.ts) on\n * the scene `game:play` (labs/game/scenes/play.ts) with the arena's text registered for the view, offers the bot's\n * replay to `?replay=bot`, and shows the round each drawn frame in the HTML/CSS overlay's HUD: the gems, the clock,\n * the controls, the best round kept across sessions (labs/game/best.ts, through the engine's store) and, when the\n * round ends, how it ended. Enter then starts a new round on the next seed. Escape (or the pad's Start) pauses the\n * round under a menu (`createMenu`: Resume, New round), which keeps its keys out of play while it is open\n * (`createEngine({ modal })`); the store keeps the best round and any keys rebound (`createEngine({ store })`). The\n * camera is the chase camera unless the URL names one (`?cam=iso`, `?cam3=orbit`).\n *\n * Everything else a page does (routes, the renderer, the frame loop, the devices, `window.__engine`, the error\n * overlay, the touch controls) is the engine's, so this file is the game's own presentation only. It reads the run\n * and never changes it: the HUD cannot change the hash.\n *\n * Game code: it imports only the engine's public API (engine/index.ts) and the game's own files.\n *\n * Open it at http://127.0.0.1:5173/labs/game/ (`npm run dev`): `?seed=7&game.gems=20` plays another round,\n * `?replay=bot` the bot's, `?cam=iso` another camera. Headless, `node x shot labs/game` reports what it draws.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createMenu, createStore, type Engine, type EngineFrame, type Menu } from '../../engine';\nimport { bestOf, recordBest } from './best';\nimport { ARENA_TEXT, play, type Round } from './scenes/play';\n\n/** The page's query, with the chase camera when it names none: it follows the player round the arena. */\nconst search = new URLSearchParams(location.search);\nif (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\n\n/** The game's replays, by name (`?replay=bot`), as text loaded on demand. */\nconst replays = { bot: () => import('./replays/bot.replay.json?raw').then((module) => module.default) };\n\n/** The started engine; null until `createEngine` resolves (its first frames are drawn before that). */\nlet engine: Engine | null = null;\n\n/** Whether the round on screen has ended, so Enter starts the next. */\nlet ended = false;\n\n/** The game's store: its best round across sessions; a replay's page plays in its demo mode, so it sets none. */\nconst store = createStore({ prefix: 'my3dge-game:', mode: search.has('replay') ? 'demo' : 'play' });\n\n/** The fastest won round kept (s), and the run whose clock the page saw running, with the steps it started with. */\nlet best = bestOf(store);\nlet seen: { world: object; steps: number } | null = null;\n\n/** The pause menu while it is open; null while the round plays. */\nlet paused: Menu | null = null;\n\n/** Opens the pause menu over the paused round, or reads it a frame: Resume (or Escape again), New round. */\nfunction pauseMenu(dt: number): void {\n  const [inspector, ui, input] = [engine?.inspector, engine?.ui, engine?.input];\n  if (!inspector || !ui || !input) return;\n  const close = () => {\n    paused?.remove();\n    paused = null;\n    inspector.resume();\n  };\n  if (paused) return void paused.update(dt);\n  if (!input.pressed('pause')) return;\n  inspector.pause();\n  const items = [\n    { label: 'Resume', id: 'resume' },\n    { label: 'New round', id: 'new' },\n  ];\n  paused = createMenu(ui.root, items, { input, id: 'pause', title: 'Paused', onCancel: close, onPick: (_i, item) => {\n    if (typeof item === 'object' && item.id === 'new') inspector.seed(inspector.seed() + 1);\n    close();\n  } }); // prettier-ignore\n}\n\n/** Shows the round in the HUD: the gems, the clock, the controls, and how the round ended. */\nfunction showRound({ world }: EngineFrame): void {\n  const ui = engine?.ui;\n  const entity = world.query('round')[0] as unknown as { round: Round } | undefined;\n  if (!ui || !entity) return;\n  const { gems, collected, left, state } = entity.round;\n  if (seen?.world !== world) seen = state === 'playing' ? { world, steps: left + world.tick } : null;\n  const was = ended;\n  ui.hud('gems', `Gems ${collected} / ${gems}`, { at: 'top-left' });\n  ui.hud('clock', `${Math.ceil(left / world.hz)} s`, { at: 'top-right', color: left < 10 * world.hz ? '#ff8f6b' : '' });\n  ui.hud('keys', 'WASD: run · Space: jump · Shift: dash · Esc: pause', { at: 'bottom', keys: true });\n  ended = state !== 'playing';\n  if (ended && !was && state === 'won' && seen) best = recordBest(store, (seen.steps - left) / world.hz);\n  ui.hud('best', best === null ? null : `Best ${best.toFixed(1)} s`, { at: 'top-left' });\n  const end = state === 'won' ? 'Every gem! Enter: play again' : 'Time! Enter: play again';\n  ui.hud('end', ended ? end : null, { at: 'top' });\n}\n\nengine = await createEngine({\n  canvas: document.querySelector<HTMLCanvasElement>('#view')!,\n  scenes: [play.id],\n  levels: { 'level:arena': { text: ARENA_TEXT, file: 'labs/game/scenes/play.ts' } },\n  replays,\n  search: `?${search}`,\n  store,\n  modal: () => paused !== null,\n  onFrame: (frame) => {\n    pauseMenu(frame.dt);\n    showRound(frame);\n  },\n});\n\naddEventListener('keydown', (event) => {\n  const inspector = engine?.inspector;\n  if (event.code === 'Enter' && ended && inspector) inspector.seed(inspector.seed() + 1);\n});\n\n--- SCENE ---\n/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n\n--- HUB ---\n### In AI Hub: AI Hub Session Protocol v1, mode **ghost**\n\nRead the protocol once: `https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`. Fetch by raw URL, into\n`labs/game/hub/`: `session.js` (save it as `session-client.txt`), and for tests `harness.html`, `bridge.js`, `round.js` from the same\nfolder. **Do not clone the ai-hub repository: it is 5.3 GB.**\n\nWhy ghost: every copy runs its own seeded round, nothing depends on a host, and each player sees the others on the neighbouring mats,\nwobbling in their seat colour. It is the source's solo ritual made social without any interference.\n\n**Tags** in the head, right after the client (the build injects them, section 14):\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Stay the steadiest across three classes\">\n<meta name=\"hub:session-howto\" content=\"Lean: stick or WASD · Feet: L2 R2 or Q E · Breathe: both or Space\">\n<meta name=\"hub:webgpu\" content=\"required\">\n```\n\nGoal at most 60 characters, how-to at most 80. Also `hub:type` Game, `hub:players` 1-4, `hub:source` Wii Fit.\n\n**Startup** **[tested: this shape, on the starter's one scene, passed the harness at 2, 3 (host leaving) and 4 players with the engine running in every frame]**:\n\n```ts\nconst search = new URLSearchParams(location.search);\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key); // see the trap below\nsearch.set('touch', 'off');\nconst AIHub = window.AIHub;\nconst info = AIHub?.active ? await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\nif (info) { search.set('scene', 'game:round'); search.set('seed', String(info.seed)); }\nconst watchdog = info ? setTimeout(() => AIHub.ready(), 14000) : 0;   // the harness allows 20 s after hello\nengine = await createEngine({ canvas, scenes: ['game:island', 'game:round'], search: `?${search}`, /* … */ });\nif (info) { clearTimeout(watchdog); AIHub.ready(); }\n```\n\n**The biggest trap in this whole plan [tested]:** the hub opens the page with `?aihub=1&aihub-seed=N`. `createEngine` treats every\nunknown query key as a setting and fails with `CORE_BAD_SETTING`, **and the harness still reports PASS**, because the client keeps\nanswering while the game is dead. Strip those keys, and make your test assert, inside every frame, `__engine.ready === true` and\n`__engine.errors.length === 0`.\n\n**The round in a session:**\n\n- No title, menus or attract. Straight to the game's own card: the four mats in the pavilion, Plumb in front, each player standing on their\n  mat. It shows the game's title, players in colour with who is ready, how to win, this player's controls, seconds left (from the `card` event).\n  Keys: Enter or Cross answers `AIHub.answer('ready')`, Triangle or T answers `'more'`, a tap or click works too. Listen for Enter with your own\n  `keydown` on `window`: the harness sends a synthetic one. The card has no menus or choices, and draws numbers only from `AIHub.rng('card')`.\n  Make it HTML over whatever is drawn, because the watchdog may call `ready()` while the view is still warming up.\n- `start` arrives; play begins at `AIHub.time() >= 0`. Send the sim `round.go` then (scene action). On `start` also send one\n  `AIHub.progress({ score: 0, label: 'Breathing in' })` and one ghost message, so a slow copy still passes the harness.\n- During play: `AIHub.progress({ score, label })` whenever it changes (label at most 24 characters, \"Class 2 · 640\"), and every 100 ms\n  `AIHub.send({ t: 'g', e: classIndex, x, y, p: poseId, s: score }, { reliable: false })`. Never above 20 a second.\n- Ghosts are sim entities, because only sim entities can be drawn: incoming messages go through\n  `engine.input.virtual.axis('game:ghosts', […])` to actors on the other mats, tinted with `info.players[i].color`, leans scrubbed by their CoB,\n  name labels from the hub as text (never as HTML), shown only while `e` matches. On `leave`, they walk off politely.\n- Finished: `AIHub.result({ score, stats, awards })` once. Stats at most six, names at most 16 characters (\"Wobble Age\", \"Best hold\", \"Breath\"),\n  values short; awards at most three, title at most 24, detail at most 40 (\"Unnervingly Still\").\n- `time-up`: report the current score at once if you have not. `end`: `engine.stop()`, stop all sound, take no input, send nothing.\n- If `engine.ready` is false (no WebGPU): `AIHub.fail('WebGPU required')`.\n- **Rules in a session:** network only through the hub; no chat or custom names; no `alert`, `confirm`, `prompt`, `window.open` or navigation; restart\n  and quit do nothing. Pause is an overlay that never pauses the sim: Resume, volume, button icons. No dev mode. **Create + Options belongs to the hub:**\n  while pad button 8 is held, ignore the engine's `pause`. Storage is a fresh memory copy, handled by the client, so write nothing special for it.\n- Outside a session (`connect` gives `null`, or no client at all in the dev server) the game must behave exactly as it does alone.\n\n**Boot deadline, the one place performance matters.** The harness gives every copy 20 s to call `ready()`. **[tested on SwiftShader]** the starter\ngame alone needed 8–16 s per copy at four copies; the engine's playground needed 52–73 s. So `game:round` is a small separate scene with just the\npavilion, the mats and the cast. The island's cost never reaches a session, and the watchdog covers the rest. Performance is out of scope everywhere else.\n\n---\n\n## 10. Art direction\n\n--- INDEX ---\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' labs/game/scenes/play.ts; printf '\\\\n--- player ---\\\\n'; cat labs/game/cast/player.ts; printf '\\\\n--- scene guide ---\\\\n'; rg -n 'defineScene|components|mesh|spawnActor|createCharacter|input\\\\.' docs/GAME.md | head -80\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' labs/game/scenes/play.ts; printf '\\\\n--- player ---\\\\n'; cat labs/game/cast/player.ts; printf '\\\\n--- scene guide ---\\\\n'; rg -n 'defineScene|components|mesh|spawnActor|createCharacter|input\\\\.' docs/GAME.md | head -80\"","aggregated_output":"/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n\n--- player ---\n/**\n * @file The starter game's player: the character the keys move (the character controller's numbers: how it runs,\n * jumps and dashes) and the body it is drawn as, and `spawnPlayer`, which stands it in a scene. A game keeps its\n * cast here, one character a file, as the box keeps its hero, walkers, slimes and wisps (labs/box/cast/); its scenes\n * spawn them. `node x sim labs/game/scenes/play.ts --feel` measures how the player handles: response, top speed, the\n * jump's height and air time, the dash's reach.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter(6).speed; // 6: m/s\n * playerCharacter(6).jumpSpeed; // 9: m/s at take-off, about 1.27 m up, over the arena's 0.75 m low walls\n * @see labs/game/scenes/play.ts\n */\nimport { createCharacter, spawnActor, type Character, type World } from '../../../engine/sim-api';\n\n/** The player's take-off speed, m/s: about 1.27 m up under the controller's gravity, over a 0.75 m low wall. */\nexport const JUMP_SPEED = 9;\n\n/** The body the player is drawn as: the humanoid in the chibi build, empty-handed. */\nexport const PLAYER_BODY = Object.freeze({ build: 'build:chibi', weapon: 'none' });\n\n/** The player's character at `speed` m/s; createCharacter's defaults for the rest (its dash among them). */\nexport function playerCharacter(speed: number): Character {\n  return createCharacter({ speed, jumpSpeed: JUMP_SPEED });\n}\n\n/** Stands the player in `w` (a scene with physics) at `at`, facing `yaw`: an actor the step's intents move. */\nexport function spawnPlayer<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  speed: number,\n  yaw = 0,\n): number {\n  const character = playerCharacter(speed);\n  return spawnActor(w, { at: [at[0], at[1], at[2]], character, player: true, yaw, anim: { ...PLAYER_BODY } });\n}\n\n--- scene guide ---\nrg: docs/GAME.md: IO error for operation on docs/GAME.md: No such file or directory (os error 2)\n","exit_code":0,"status":"completed"}}
