{"type":"item.started","item":{"id":"item_225","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' labs/game/wobble.ts; sed -n '1,180p' labs/game/programme.ts; cat labs/game/index.html; cat tsconfig.json; sed -n '1,220p' /home/micha/dev/cc-matrix/runs/gpt-6.1-terra-max.build-v2__20261104-224055__x54facc/work/TASK.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_225","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' labs/game/wobble.ts; sed -n '1,180p' labs/game/programme.ts; cat labs/game/index.html; cat tsconfig.json; sed -n '1,220p' /home/micha/dev/cc-matrix/runs/gpt-6.1-terra-max.build-v2__20261104-224055__x54facc/work/TASK.md\"","aggregated_output":"/** @file Deterministic fixed-step balance and activity simulation. */\n\nimport type { Activity } from './programme';\n\nexport type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nexport const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nexport type Input = { x: number; y: number; gentle: boolean };\nexport type Foot = 'left' | 'right' | 'both';\nexport type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nexport type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\n\nconst clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));\nconst approach = (value: number, target: number, amount: number) => value + clamp(target - value, -amount, amount);\n\nexport function createBalance(): Balance {\n  return { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, time: 0, calm: 0, outside: 0, recovering: 0, falls: 0 };\n}\n\nexport function createSession(activity: Activity, seed = 1): Session {\n  return { activity, balance: createBalance(), time: 0, scoreSum: 0, samples: 0, hits: 0, attempts: 0, foot: null, lastFoot: null, cue: 'left', actionFlash: 0, seed, finished: false, score: 0 };\n}\n\nexport function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\n  balance.time += dt;\n  const length = Math.hypot(input.x, input.y);\n  const scale = (length > 1 ? 1 / length : 1) * settings.reach * (input.gentle ? 0.4 : 1);\n  balance.targetX = approach(balance.targetX, input.x * scale, 4 * dt);\n  balance.targetY = approach(balance.targetY, input.y * scale, 4 * dt);\n  const quiet = Math.hypot(balance.vx, balance.vy) < 0.17 && length < 0.2;\n  balance.calm = clamp(balance.calm + (quiet ? dt * 0.15 : -dt * 0.3), 0, 1);\n  if (balance.recovering > 0) {\n    balance.recovering -= dt;\n    balance.x *= Math.exp(-5 * dt); balance.y *= Math.exp(-5 * dt);\n    balance.vx = 0; balance.vy = 0;\n    return;\n  }\n  const noise = settings.noise * (1 - settings.calmEffect * balance.calm);\n  const phase = balance.time * settings.noiseRate * Math.PI * 2;\n  const nx = Math.sin(phase + seed * 1.71) * 0.65 + Math.sin(phase * 1.73 + seed) * 0.35;\n  const ny = Math.sin(phase * 0.83 + seed * 2.13) * 0.65 + Math.sin(phase * 1.47 + seed * 0.8) * 0.35;\n  balance.vx += (settings.gain * (balance.targetX - balance.x) + settings.instability * balance.x + noise * nx) * dt;\n  balance.vy += (settings.gain * (balance.targetY - balance.y) + settings.instability * balance.y + noise * ny) * dt;\n  balance.vx *= Math.exp(-settings.damping * dt); balance.vy *= Math.exp(-settings.damping * dt);\n  balance.x += balance.vx * dt; balance.y += balance.vy * dt;\n  balance.outside = Math.hypot(balance.x, balance.y) > 1 ? balance.outside + 1 : 0;\n  if (balance.outside >= 6) { balance.falls++; balance.outside = 0; balance.recovering = 1; }\n}\n\nexport function targetFor(session: Session): { x: number; y: number; label: string } {\n  const time = session.time;\n  const kind = session.activity.kind;\n  if (kind === 'pond') return { x: 0, y: 0, label: 'Breathe in. Breathe out.' };\n  if (kind === 'line' || kind === 'reps' || kind === 'step' || kind === 'group' || kind === 'jog') return { x: Math.sin(time * 0.28) * (kind === 'line' ? 0.12 : 0.2), y: 0, label: 'Find your centre' };\n  if (kind === 'hoop') return { x: Math.sin(time * 1.35) * 0.44, y: Math.cos(time * 1.35) * 0.44, label: 'Follow the hoop' };\n  if (kind === 'paddle') return { x: Math.sin(time * 0.38) * 0.56, y: 0.12, label: 'Steer through the buoys' };\n  if (kind === 'sand') { const index = Math.floor(time / 12); return { x: [0.48, -0.48, 0.18, -0.32, 0][index % 5], y: [-0.25, 0.25, 0.48, -0.42, 0][index % 5], label: `Garden ${Math.min(5, index + 1)} of 5` }; }\n  if (kind === 'finale') { const index = Math.floor(time / 18); return { x: Math.sin(time * 0.35) * 0.48, y: Math.cos(time * 0.21) * 0.32, label: ['Steady the crowd', 'Hold the island', 'Help the carts', 'Find the fulcrum', 'Wait for the sunrise'][Math.min(index, 4)] }; }\n  if (kind === 'pose') { const index = Math.floor(time / 15); return { x: [0, 0.35, -0.35][index % 3], y: [0, -0.28, 0.22][index % 3], label: ['Find your centre', 'Hold the shape', 'A little longer'][index % 3] }; }\n  if (kind === 'cliff') return { x: Math.sin(time * 0.28) * 0.35, y: -0.3, label: 'Find your diving line' };\n  const index = Math.floor(time / 6);\n  return { x: [0, -0.38, 0.38, 0, 0][index % 5], y: [0, 0, 0, -0.38, 0.38][index % 5], label: ['Find your centre', 'Lean left', 'Lean right', 'Lean forward', 'Lean back'][index % 5] };\n}\n\nexport function action(session: Session, foot: Foot): boolean {\n  if (session.finished) return false;\n  session.foot = foot; session.attempts++; session.actionFlash = 0.5;\n  const kind = session.activity.kind;\n  const beat = Math.abs((session.time % 1.2) - 0.6) < 0.3;\n  const matched = kind === 'reps' || kind === 'cliff' ? foot === 'both' : foot !== 'both' && foot !== session.lastFoot;\n  const good = matched && (kind === 'step' || kind === 'reps' ? beat : true);\n  if (good) session.hits++;\n  if (foot !== 'both') session.lastFoot = foot;\n  session.cue = session.cue === 'left' ? 'right' : 'left';\n  return good;\n}\n\nexport function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n  if (session.finished) return;\n  session.time += dt;\n  stepBalance(session.balance, input, settings, dt, session.seed);\n  session.actionFlash = Math.max(0, session.actionFlash - dt);\n  const target = targetFor(session);\n  const distance = Math.hypot(session.balance.x - target.x, session.balance.y - target.y);\n  const calmBonus = session.activity.kind === 'pond' ? session.balance.calm * 0.15 : 0;\n  session.scoreSum += clamp(1 - distance * 0.8 + calmBonus, 0, 1);\n  session.samples++;\n  if (session.time >= session.activity.duration) {\n    const movement = session.scoreSum / Math.max(1, session.samples);\n    const actionKind = ['reps', 'step', 'line', 'paddle', 'cliff', 'jog', 'group'].includes(session.activity.kind);\n    const expected = session.activity.duration / 2.5;\n    const actionScore = clamp(session.hits / expected, 0, 1);\n    session.score = Math.round(clamp((actionKind ? movement * 0.7 + actionScore * 0.3 : movement) - session.balance.falls * 0.025, 0, 1) * 1000);\n    session.finished = true;\n  }\n}\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n// The whole repository as one TypeScript program: what `npx tsc --noEmit`, editors, Vite, Vitest, tsx and `x new`\n// read. T0 (`npm run check`, `npm run typecheck`) checks the same files through the projects of tsconfig.check.json,\n// incrementally; tools/checkAll.test.ts keeps the two file lists equal (ADR-0014, amendment 7).\n{\n  \"extends\": \"./tsconfig.base.json\",\n  \"compilerOptions\": {\n    \"noEmit\": true\n  },\n  \"include\": [\"engine\", \"labs\", \"tests\", \"fixtures\", \"tools\", \".claude/hooks\", \"*.config.ts\"]\n}\nSOURCE: Wii Fit\n\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\n\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\n\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\n\nResearch: Whether and how much to research is your choice.\n\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-224055].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\n\nTech Stack: Build on https://github.com/michaelcrosato/my-3dge#make-a-game-with-my-3dge, in the engine's full workspace. The engine stays read-only, as the AGENTS.md it gives your game says: add whatever systems, art assets and animations the game needs on top of it. The rest of the tech stack is your choice.\n\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\n\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\n\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\n\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\n\nWorking Environment and deliverable:\nCreate a subfolder called [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-224055] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-224055].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\n\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\n\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\n\nEffort: Spend effort however you see fit.\n\n## This computer\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\n\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\n  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\n- **Not installed:** sox, bun, deno.\n- **Network:** internet works (github.com, registry.npmjs.org).\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \"Target closed\", \"page crashed\" or \"browser has been closed\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\n\n### What this computer doesn't have\n\nNo script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\n\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\n\n### Sharing this computer\n\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\n\n## Goal\n\nBuild an original game inspired by the source.\n\nScope\n\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\n\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\n\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\n\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\n\nNarrative tone: Use a writing style similar to the source’s.\n\n## UI & UX: 10-Foot Controller-First Philosophy\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\n\nDo not use overly dense, web-style data screens.\n\nTouch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.\n\n## Done\nNo TODOs, placeholders, or stubbed features. The demo is complete.\n\n## Source Information\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n- Date: 2026-11-04 22:40:55\n- Source: the work it's based on\n- Plan: the file name of the plan you were given to build from, or none\n- Genre and Perspective: genre and camera perspective used\n- Tech: stack, libraries/engines, with versions if applicable\n- Art Direction: style used\n- Animation: system used\n- Audio: music, sound effects and voice used\n- Online: network features used, or none\n- Testing: testing parameters allowed\n- Research: research done, or none\n- Environment: Codex CLI (headless); Linux\n- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n{\n  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n  \"aiHub\": {\n    \"name\": \"the game's title, as on its title screen\",\n    \"tagline\": \"a few words to go under the title\",\n    \"description\": \"one or two sentences for the catalogue\",\n    \"type\": \"Game, Tech demo or Tool\",\n    \"genre\": \"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\",\n    \"source\": \"the work it's based on, e.g. Moby-Dick\",\n    \"series\": \"its franchise, e.g. Star Fox, or empty\",\n    \"players\": \"how many can play: 1, 1–2 or 1–4\",\n    \"controls\": \"the controls, in one line\",\n    \"tags\": [\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\"]\n  }\n}\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n\nTesting Feedback\n\n- How many issues did testing catch?\n- How many would be considered critical issues / game breaking?\n- What was the most helpful test you ran?\n- What was the least helpful test you ran?\n\nEngine Feedback\n\n- What did you like most about the engine?\n- Did you get stuck or guess wrong?\n- What was the most important thing you had to build yourself?\n- What was the hardest part about using the engine?\n- What did you change in the engine, and why? (none if nothing)\n- If you could change one thing about the engine, what would it be?\n\nPrompt Feedback\n\n- What did you like most about this prompt?\n- What was confusing?\n- What was the hardest thing to do?\n- What would you change in this prompt?\n","exit_code":0,"status":"completed"}}
