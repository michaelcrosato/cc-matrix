Wee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/bodies.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/heightfield.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/ledge.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/room.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/carry.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/joints.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/touch.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/widgets.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/state.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/manifest.webmanifest\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/overlay.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/menu.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/dialog.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/touch.css\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/labels.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/swipe.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/chrome.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/sim-api.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/LICENSE\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/world/aiRoutes.ts\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/world/telegraphs.ts\n\n--- BUILD CONFIG ---\n/** @file Packages the game as one portable HTML file. */\nimport { writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nimport { build } from 'vite';\n\nconst root = process.cwd();\nconst result = await build({ root, configFile: false, logLevel: 'warn', base: './', build: { write: false, modulePreload: false, cssCodeSplit: false, rollupOptions: { input: { game: join(root, 'labs/game/index.html') }, output: { inlineDynamicImports: true } } } });\nlet html = '';\nconst files = {};\nfor (const entry of (Array.isArray(result) ? result : [result]).flatMap((output) => output.output)) {\n  const text = entry.type === 'chunk' ? entry.code : typeof entry.source === 'string' ? entry.source : new TextDecoder().decode(entry.source);\n  if (entry.fileName.endsWith('.html')) html = text;\n  else files[entry.fileName] = text;\n}\nfunction contents(reference) {\n  const name = Object.keys(files).find((file) => reference.endsWith(file));\n  if (!name) throw new Error(`Missing build asset: ${reference}`);\n  return files[name];\n}\nhtml = html.replace(/<script type=\"module\" crossorigin src=\"([^\"]+)\"><\\/script>|<link rel=\"stylesheet\" crossorigin href=\"([^\"]+)\">/g, (_tag, script, style) => style ? `<style>${contents(style)}</style>` : `<script type=\"module\">${contents(script).replaceAll('</script', '<\\\\/script')}</script>`);\nif (!html || /(?:src|href)=\"\\.\\/assets\\//.test(html)) throw new Error('Build is not self-contained');\nwriteFileSync(resolve(process.argv[2]), html);\n","exit_code":0,"status":"completed"}}
