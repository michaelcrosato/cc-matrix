{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' labs/game/scenes/play.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' labs/game/scenes/play.ts\"","aggregated_output":"/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_59","type":"reasoning","text":"**Examining with commands**"}}
{"type":"item.completed","item":{"id":"item_60","type":"agent_message","text":"The engine is installed and pinned. I’m building the playable retreat next."}}
{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' docs/GAME-GUIDE.md; printf '\\\\n--- scene continuation ---\\\\n'; sed -n '200,390p' labs/game/scenes/play.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' docs/GAME-GUIDE.md; printf '\\\\n--- scene continuation ---\\\\n'; sed -n '200,390p' labs/game/scenes/play.ts\"","aggregated_output":"# Making a game with my-3dge\n\nYou are making a game with the my-3dge engine. Read this once, start to finish; after that, look things up (section\n8). A game's AGENTS.md sends you here after `node tools/game/new-game.mjs` made the game. For a model without the\nrepository, this one file is also the engine in brief: its public API by area is section 10.\n\n## 1. What you have\n\nmy-3dge is a 3D web game engine built for AI coding agents: TypeScript, three.js r182 on WebGPU, Rapier physics, the\nUI in HTML/CSS. Three promises shape everything you write:\n\n- **Play is reproducible.** The rules (the _sim_) run on the CPU at a fixed 60 steps a second. The same seed and the\n  same intents give the same state, bit for bit, in Node and in Chromium; every state has a 16-digit hash.\n- **Nothing needs a screen.** The sim runs headless in Node (tests, `node x sim`). The page renders on WebGPU in a\n  headless Chromium (`node x shot`) and reports what it drew as numbers: which object covers which pixels (the ID\n  pass), the look's metrics, a text thumbnail. You prove a game works with commands, not by looking.\n- **Code and data, not binary files.** Levels are text maps; materials and textures are generators with parameters;\n  sounds are voices and tracker notes; characters are procedural bodies, with a library of readable motion clips.\n\nA game's repository:\n\n| Path                                                             | What it is                                                            |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------- |\n| `labs/game/`                                                     | The game: the page, the rules (`scenes/`), the characters (`cast/`), the bot, the replays |\n| `labs/box/`                                                      | The engine's worked example: a hero, crowds, combat, props, looks, sound (read-only)   |\n| `engine/`                                                        | The engine. Game code imports only engine/index.ts and engine/sim-api.ts            |\n| `tools/`, `x.js`                                                 | The `node x` commands, the lint rules, the templates (tools/templates/)               |\n| `data/anim/`                                                     | The animation library: readable clips, and the engine's actions                       |\n| `docs/`                                                          | This guide, API.md (every public name) and ERRORS.md (every error code, with its fix) |\n| `engine-lock.json`, `ENGINE-FEEDBACK.md`                         | The engine's pinned commit and file hashes; what you needed from the engine           |\n\nEverything but `labs/game/` and the root's game files (AGENTS.md, README.md, package.json…) is the engine's,\nread-only: `npm run check` compares every engine file with engine-lock.json.\n\n## 2. The model\n\n**Two halves.** The sim is the game's rules: entities holding components (plain data), systems that change them each\nstep, events. Sim-side code (labs/game/scenes/, labs/game/cast/) imports only engine/sim-api.ts and never touches the\nDOM, the GPU, the clock or `Math.random`. The page (labs/game/main.ts) imports engine/index.ts: `createEngine` starts\nthe sim, turns the keyboard, mouse, pads and touch into intents, draws every frame on WebGPU, and calls your `onFrame`\nfor the game's own presentation (the HUD, sound). The page reads the sim and never writes it. Lint enforces the split.\n\n**A scene** is the unit `x sim`, the page and the tests run: `defineScene('game:play', { level, physics, settings,\nsetup(w), step(w, intents) })`. `setup` spawns entities and adds systems; `step` runs first in every step. One page can\noffer several scenes (`createEngine({ scenes })`, `?scene=<id>` picks one); a running page cannot switch scenes yet,\nso a level select reloads the page with another `?scene`.\n\n**The world, `w`**, is what systems get:\n\n- **Components and entities.** `defineComponent('gem', { description, fields })` declares a component: typed fields\n  with defaults and units, so the state can be hashed, captured and checked. `w.spawn({ gem: { x, z } })` returns an\n  id; `w.query('gem')` returns the live entities holding it, in id order; `w.get(id)`, `w.add`, `w.remove` and\n  `w.despawn` do the rest. An entity whose component declares `x` and `z` in metres is drawn as a stand-in box until\n  something draws it properly (an actor, a prop, a crowd body).\n- **Systems** run in phases, in this order: `intents`, `ai`, `anim`, `physics`, `readback`, `rules`.\n  `w.systems.add('game.collect', collect, { phase: 'rules' })` puts a rule after the physics moved the bodies and the\n  readback copied their places into components.\n- **Events.** `w.emit('gem', payload)` delivers at the end of the step to `w.events.on('gem', …)` listeners. A page\n  reads them from `frame.world.events.trace()` (sounds, effects); emitters burst on them; tests count them.\n- **Time** is steps: `w.tick`, `w.dt` (1/60 s), `w.hz`. Count a duration in whole steps (30 s is 1,800), never by\n  adding up `w.dt`: floating-point sums drift. `w.timers` schedule in sim seconds.\n- **Randomness** comes from named streams seeded by the run: `w.rng('gems').int(0, 9)`, `.range(a, b)`, `.chance(p)`.\n- **Settings** are the game's tunable numbers: `defineSettings({ 'game.gems': { type, default, minimum, maximum,\n  unit, when: 'scene', description } })`, read with `w.settings.get('game.gems')`. Each is reachable from the URL\n  (`?game.gems=20`), from `node x sim … --set game.gems=20`, `node x set` and `__engine.set`, and replays record them.\n\n**Intents** are everything the sim reads from outside, once per step, as plain data: `move` (a world-space\ndirection `[x, z]`), `b` (buttons held), `p` (pressed this step), `aim`, `look`, `cam`, and the game's own\n`'game:<name>'` keys. A player actor reads the step's intents itself; systems get them as their second argument\n(`held(intents, 'jump')`, `pressed(intents, 'attack')`). In a page, devices make intents through an action map\n(`actionMap:thirdPerson` by default: WASD or the arrows run, Space jumps, Shift dashes); a map with `look: true` sends\nthe camera's view as `look`, and its `aimWith` fills `aim` (`centre`: what the screen's middle points at; `pointer`:\nthe pointer on the player's floor), and a game with several camera modes gives `createEngine` a map per camera\n(`actionMap: (code) => …`). A bot or a test writes them directly: `engine.step(1, { move: [1, 0] })`. A replay is the\nintents of a run, recorded.\n\n**Proof.** `engine.hash()` digests the whole sim. A replay file (labs/game/replays/bot.replay.json) holds a scene,\nseed, settings, the intents at each step that changed them, and the golden hashes at its checkpoints, per platform\n(`linux-x64`). `capture()` and `restore()` copy a run and continue it exactly. If a hash changes, play changed.\n\n## 3. The starter, file by file\n\nThe starter (labs/game/) is a whole small game: run round an arena collecting every gem before the clock runs out.\nGrow your game from it; keep its tests as they are, and change what they check as the game changes.\n\n| File                         | What it shows                                                                              |\n| ---------------------------- | ------------------------------------------------------------------------------------------ |\n| labs/game/scenes/play.ts     | The rules: a level as text, settings, components (`gem`, `round`), systems, a random stream, events |\n| labs/game/cast/player.ts     | The player: a character on the controller (run, jump, dash) drawn as the humanoid          |\n| labs/game/bot.ts             | A bot that plays through intents, steering down a flow field to the nearest gem            |\n| labs/game/main.ts            | The page: `createEngine`, the HUD in `onFrame`, Enter to play again, Esc's pause menu, the chase camera     |\n| labs/game/scenes/play.test.ts | The tests: the golden replay, capture and restore, the bot wins on 10 seeds, the clock     |\n| labs/game/replays/bot.replay.json | The bot's play, recorded, with its golden hashes                                      |\n| labs/game/README.md          | The game's own page: what it is, how it plays, the calls made                              |\n\n## 4. What to reach for\n\nThe public names below are in engine/sim-api.ts (sim-side) or engine/index.ts (pages); section 10 lists them all.\nThe box (labs/box/, its README says which scene shows what) has a working use of almost each one.\n\n| You need                       | Reach for                                                                                 | See it in                          |\n| ------------------------------ | ----------------------------------------------------------------------------------------- | ---------------------------------- |\n| A level                        | A text map in a scene module; `compileLevel`, glyphs (`#` wall, `.` floor, `@` spawn, `w` low wall, `P` pillar, `^` stairs, `=` gallery, `o` dais, `t` brazier), `defineGlyph` for your own; `addLevelBodies`; the page registers the text (`createEngine({ levels })`); a building of storeys: `node x new level`; buildings on a terrain: `defineSite`, `addSiteBodies` | labs/game/scenes/play.ts, labs/box/levels/hall.txt, labs/playground/levels/site.ts |\n| A player or character          | `createCharacter` (speed, jump, dash, coyote time, buffer), `spawnActor`, `measureFeel`; Apex's movement, `{ movement: 'movement:apex' }`, or your own: `defineMovement` (`node x new movement`); `node x feel`, `createFeelPanel` | labs/game/cast/player.ts, labs/box/cast/hero.ts, labs/playground/cast/player.ts |\n| Physics                        | `physics: true` in the scene, `physicsOf(w)`: bodies, `raycast`, `overlap`, `probe`; `addBox`, `addSensor`, `knock`, movers | labs/box/scenes/hall.ts |\n| Props                          | `defineProp` (meshes, a body, hooks), `spawnProp`, `hitProp`; the engine's `prop:crate`, `prop:barrel`, `prop:brazier`, `prop:pillar`; one a player uses or strikes: `defineUsable`, `defineStrikable`, `addInteraction` (`node x new interactable`) | labs/box/scenes/hall-props.ts |\n| Rides, doors and switches      | `addLevelLadders`, `addZipline`, `addLauncher`; `addLevelDoors`, `addLevelWindows`, `addSwitch`, `switchGroup`; `setDaytime`, `lightsAtDusk`; `placeActor` | labs/playground/scenes/site.ts |\n| Enemies and crowds             | Crowd bodies (`addAgent`, `updateCrowd`, `knockback`, `killAgent`), steering (`seek`, `followFlow`, `approachRing`), `NavGrid` and `FlowField`, attack tokens, `canSee` | labs/box/cast/walker.ts, labs/box/scenes/crowd-1000.ts |\n| Combat                         | Moves as data (`defineMove`, `Attack`, `Combo`), hit queries (`coneHits`, `sweepHits`), `damage` and `HEALTH`, projectiles, telegraphs, `reactTo`, `requestHitStop` | labs/box/scenes/fight.ts, labs/box/cast/hero.ts |\n| Melee, guns and targets        | `addMelee` (punches, kicks, the door kick), `defineWeapon`, `weaponsFor` and `addWeapons` (hip fire, the sights, a climbing recoil, reloads; `node x new weapon`), `defineThing` and `spawnThing` (targets that fall at a hit and stand again; `node x new thing`) | labs/playground/weapons/, labs/playground/cast/dummies.ts |\n| Ragdolls and joints            | `addJoint` (fixed, ball, hinge, slider, rope, spring, as data), `addRagdolls` and `handOff` (a hard blow or a death gives a person's body to physics; it gets up the way it lies), `standUp` | labs/box/scenes/ragdoll.ts, labs/playground/cast/partners.ts |\n| Animation                      | Actors animate themselves (`spawnActor({ anim: { build } })`); builds, bodies, the animator's body states, actions (`defineAction`, played on an actor with `actOn`), clips from the library (`playClip`) | labs/box/scenes/clips.ts, `node x anim find` |\n| How it looks                   | Materials and textures as data (`defineMaterial`, `defineTexture`), looks (`?post.look=look:storybook`, `post.combine`, `post.filters`, `defineLook`; `__engine.look()`), skies, lights | labs/box/looks/torch-lit.ts, `node x describe look` |\n| Effects                        | Emitters as data, bursting on sim events (`defineEmitter`); telegraphs; screen shake      | labs/box/scenes/fight.ts           |\n| UI                             | `engine.ui`: `hud(id, text, { at })`, `label`, `damage`, `crosshair`; screens and menus: `createMenu`, `createEngine({ store, modal })` (rebinds kept, a menu's keys out of play), `input.bindingsFor`, `rebind`, `listen` (a controls screen); the rest plain HTML/CSS | labs/game/main.ts (its pause), labs/playground/ui/, labs/box/menu.ts |\n| Sound                          | Effects and songs as data (`defineSfx`, `defineSong`), the page's `createAudio`; a scene's `sounds` maps events to sounds | labs/box/sounds/effects.ts, labs/box/sounds/page.ts |\n| Cameras                        | `?cam=iso` (`threequarter`, `topdown`, `overhead`, `brawler`, `side`), `?cam3=chase` (`orbit`, `fly`, `fixed`, `first`, `rail`, `shoulder`, `follow`); `__engine.camera.set(code, { blend: true })`; a map per mode: `createEngine({ actionMap: (code) => … })`; a mode of your own: `defineCamera` (`node x new camera`) | labs/game/main.ts, labs/playground/views.ts |\n| Touch controls                 | `defineTouchLayout`, `createEngine({ touchLayout })` (built, not yet tested on phones)   | labs/box/touch.ts                  |\n| A new entry of a kind          | `node x new <kind> labs/game/<dir>/<name>`: the module and its test from a template (`node x new` lists the kinds, tools/templates/README.md says where each goes; a new scene starts as a copy of play.ts instead) | tools/templates/                    |\n\nSaves, high scores and settings go in the page's store (`createStore`, never read by the sim), as labs/game/best.ts\nkeeps the best round.\n\n## 5. Rules that keep play reproducible\n\n- Sim-side code (labs/game/scenes/, labs/game/cast/) imports only engine/sim-api.ts; pages only engine/index.ts.\n  Never import three.js or Rapier directly: the public API re-exports what a game needs.\n- No clocks, timers, `Math.random`, `crypto`, DOM, storage, Web Audio or Node built-ins in sim-side code, and no\n  dynamic `import()`: lint refuses each, and its message names the fix. No network either: what the sim needs from\n  outside arrives as intents or settings. Write `Math.pow`, not `**`. Use the standard `Math`: the sim swaps in\n  portable ports while it steps, so the results match in Node and Chromium.\n- Time in steps; randomness from named streams; entities in `w.query`'s id order.\n- A sim-side module reads no files: a level's text lives in a string in the scene module.\n- Presentation never writes the sim: cameras, looks, particles, sound and the HUD change freely without changing a hash.\n- Units: metres, seconds, radians; +Y up, x east, z south; characters face +Z.\n\n**Assets.** Make them with code and data first: geometry, textures and materials as generators with parameters,\nsounds as voices and tracker notes, levels as text. A binary file (an image, a recorded sound, a model) needs the\nowner's approval: ask, and once they approve, list it in APPROVED-BINARIES.json at the game's root as\n`{ \"path\", \"reason\" }`, the reason their answer, who and when; `npm run check` fails a binary listed nowhere. Fonts\nare approved: anywhere in labs/game/, each with its license file beside it.\n\n## 6. Seeing it without a screen\n\nEvery command prints its verdict first, about 20 lines at most, and writes `out/<cmd>/<target>/report.json`;\n`node x help <cmd>` gives its manual.\n\n| Command                                                     | What it does                                                                     |\n| ----------------------------------------------------------- | -------------------------------------------------------------------------------- |\n| `npm test`                                                  | The game's tests (Vitest), headless                                              |\n\n--- scene continuation ---\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_62","type":"reasoning","text":"**Inspecting grouped engine APIs**"}}
{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' labs/game/scenes/play.ts; sed -n '180,360p' labs/game/scenes/play.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' labs/game/scenes/play.ts; sed -n '180,360p' labs/game/scenes/play.ts\"","aggregated_output":"/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_64","type":"reasoning","text":"**Reviewing API details**"}}
{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,170p' docs/GAME-GUIDE.md; printf '\\\\n--- scene setup ---\\\\n'; sed -n '150,280p' labs/game/scenes/play.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,170p' docs/GAME-GUIDE.md; printf '\\\\n--- scene setup ---\\\\n'; sed -n '150,280p' labs/game/scenes/play.ts\"","aggregated_output":"# Making a game with my-3dge\n\nYou are making a game with the my-3dge engine. Read this once, start to finish; after that, look things up (section\n8). A game's AGENTS.md sends you here after `node tools/game/new-game.mjs` made the game. For a model without the\nrepository, this one file is also the engine in brief: its public API by area is section 10.\n\n## 1. What you have\n\nmy-3dge is a 3D web game engine built for AI coding agents: TypeScript, three.js r182 on WebGPU, Rapier physics, the\nUI in HTML/CSS. Three promises shape everything you write:\n\n- **Play is reproducible.** The rules (the _sim_) run on the CPU at a fixed 60 steps a second. The same seed and the\n  same intents give the same state, bit for bit, in Node and in Chromium; every state has a 16-digit hash.\n- **Nothing needs a screen.** The sim runs headless in Node (tests, `node x sim`). The page renders on WebGPU in a\n  headless Chromium (`node x shot`) and reports what it drew as numbers: which object covers which pixels (the ID\n  pass), the look's metrics, a text thumbnail. You prove a game works with commands, not by looking.\n- **Code and data, not binary files.** Levels are text maps; materials and textures are generators with parameters;\n  sounds are voices and tracker notes; characters are procedural bodies, with a library of readable motion clips.\n\nA game's repository:\n\n| Path                                                             | What it is                                                            |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------- |\n| `labs/game/`                                                     | The game: the page, the rules (`scenes/`), the characters (`cast/`), the bot, the replays |\n| `labs/box/`                                                      | The engine's worked example: a hero, crowds, combat, props, looks, sound (read-only)   |\n| `engine/`                                                        | The engine. Game code imports only engine/index.ts and engine/sim-api.ts            |\n| `tools/`, `x.js`                                                 | The `node x` commands, the lint rules, the templates (tools/templates/)               |\n| `data/anim/`                                                     | The animation library: readable clips, and the engine's actions                       |\n| `docs/`                                                          | This guide, API.md (every public name) and ERRORS.md (every error code, with its fix) |\n| `engine-lock.json`, `ENGINE-FEEDBACK.md`                         | The engine's pinned commit and file hashes; what you needed from the engine           |\n\nEverything but `labs/game/` and the root's game files (AGENTS.md, README.md, package.json…) is the engine's,\nread-only: `npm run check` compares every engine file with engine-lock.json.\n\n## 2. The model\n\n**Two halves.** The sim is the game's rules: entities holding components (plain data), systems that change them each\nstep, events. Sim-side code (labs/game/scenes/, labs/game/cast/) imports only engine/sim-api.ts and never touches the\nDOM, the GPU, the clock or `Math.random`. The page (labs/game/main.ts) imports engine/index.ts: `createEngine` starts\nthe sim, turns the keyboard, mouse, pads and touch into intents, draws every frame on WebGPU, and calls your `onFrame`\nfor the game's own presentation (the HUD, sound). The page reads the sim and never writes it. Lint enforces the split.\n\n**A scene** is the unit `x sim`, the page and the tests run: `defineScene('game:play', { level, physics, settings,\nsetup(w), step(w, intents) })`. `setup` spawns entities and adds systems; `step` runs first in every step. One page can\noffer several scenes (`createEngine({ scenes })`, `?scene=<id>` picks one); a running page cannot switch scenes yet,\nso a level select reloads the page with another `?scene`.\n\n**The world, `w`**, is what systems get:\n\n- **Components and entities.** `defineComponent('gem', { description, fields })` declares a component: typed fields\n  with defaults and units, so the state can be hashed, captured and checked. `w.spawn({ gem: { x, z } })` returns an\n  id; `w.query('gem')` returns the live entities holding it, in id order; `w.get(id)`, `w.add`, `w.remove` and\n  `w.despawn` do the rest. An entity whose component declares `x` and `z` in metres is drawn as a stand-in box until\n  something draws it properly (an actor, a prop, a crowd body).\n- **Systems** run in phases, in this order: `intents`, `ai`, `anim`, `physics`, `readback`, `rules`.\n  `w.systems.add('game.collect', collect, { phase: 'rules' })` puts a rule after the physics moved the bodies and the\n  readback copied their places into components.\n- **Events.** `w.emit('gem', payload)` delivers at the end of the step to `w.events.on('gem', …)` listeners. A page\n  reads them from `frame.world.events.trace()` (sounds, effects); emitters burst on them; tests count them.\n- **Time** is steps: `w.tick`, `w.dt` (1/60 s), `w.hz`. Count a duration in whole steps (30 s is 1,800), never by\n  adding up `w.dt`: floating-point sums drift. `w.timers` schedule in sim seconds.\n- **Randomness** comes from named streams seeded by the run: `w.rng('gems').int(0, 9)`, `.range(a, b)`, `.chance(p)`.\n- **Settings** are the game's tunable numbers: `defineSettings({ 'game.gems': { type, default, minimum, maximum,\n  unit, when: 'scene', description } })`, read with `w.settings.get('game.gems')`. Each is reachable from the URL\n  (`?game.gems=20`), from `node x sim … --set game.gems=20`, `node x set` and `__engine.set`, and replays record them.\n\n**Intents** are everything the sim reads from outside, once per step, as plain data: `move` (a world-space\ndirection `[x, z]`), `b` (buttons held), `p` (pressed this step), `aim`, `look`, `cam`, and the game's own\n`'game:<name>'` keys. A player actor reads the step's intents itself; systems get them as their second argument\n(`held(intents, 'jump')`, `pressed(intents, 'attack')`). In a page, devices make intents through an action map\n(`actionMap:thirdPerson` by default: WASD or the arrows run, Space jumps, Shift dashes); a map with `look: true` sends\nthe camera's view as `look`, and its `aimWith` fills `aim` (`centre`: what the screen's middle points at; `pointer`:\nthe pointer on the player's floor), and a game with several camera modes gives `createEngine` a map per camera\n(`actionMap: (code) => …`). A bot or a test writes them directly: `engine.step(1, { move: [1, 0] })`. A replay is the\nintents of a run, recorded.\n\n**Proof.** `engine.hash()` digests the whole sim. A replay file (labs/game/replays/bot.replay.json) holds a scene,\nseed, settings, the intents at each step that changed them, and the golden hashes at its checkpoints, per platform\n(`linux-x64`). `capture()` and `restore()` copy a run and continue it exactly. If a hash changes, play changed.\n\n## 3. The starter, file by file\n\nThe starter (labs/game/) is a whole small game: run round an arena collecting every gem before the clock runs out.\nGrow your game from it; keep its tests as they are, and change what they check as the game changes.\n\n| File                         | What it shows                                                                              |\n| ---------------------------- | ------------------------------------------------------------------------------------------ |\n| labs/game/scenes/play.ts     | The rules: a level as text, settings, components (`gem`, `round`), systems, a random stream, events |\n| labs/game/cast/player.ts     | The player: a character on the controller (run, jump, dash) drawn as the humanoid          |\n| labs/game/bot.ts             | A bot that plays through intents, steering down a flow field to the nearest gem            |\n| labs/game/main.ts            | The page: `createEngine`, the HUD in `onFrame`, Enter to play again, Esc's pause menu, the chase camera     |\n| labs/game/scenes/play.test.ts | The tests: the golden replay, capture and restore, the bot wins on 10 seeds, the clock     |\n| labs/game/replays/bot.replay.json | The bot's play, recorded, with its golden hashes                                      |\n| labs/game/README.md          | The game's own page: what it is, how it plays, the calls made                              |\n\n## 4. What to reach for\n\nThe public names below are in engine/sim-api.ts (sim-side) or engine/index.ts (pages); section 10 lists them all.\nThe box (labs/box/, its README says which scene shows what) has a working use of almost each one.\n\n| You need                       | Reach for                                                                                 | See it in                          |\n| ------------------------------ | ----------------------------------------------------------------------------------------- | ---------------------------------- |\n| A level                        | A text map in a scene module; `compileLevel`, glyphs (`#` wall, `.` floor, `@` spawn, `w` low wall, `P` pillar, `^` stairs, `=` gallery, `o` dais, `t` brazier), `defineGlyph` for your own; `addLevelBodies`; the page registers the text (`createEngine({ levels })`); a building of storeys: `node x new level`; buildings on a terrain: `defineSite`, `addSiteBodies` | labs/game/scenes/play.ts, labs/box/levels/hall.txt, labs/playground/levels/site.ts |\n| A player or character          | `createCharacter` (speed, jump, dash, coyote time, buffer), `spawnActor`, `measureFeel`; Apex's movement, `{ movement: 'movement:apex' }`, or your own: `defineMovement` (`node x new movement`); `node x feel`, `createFeelPanel` | labs/game/cast/player.ts, labs/box/cast/hero.ts, labs/playground/cast/player.ts |\n| Physics                        | `physics: true` in the scene, `physicsOf(w)`: bodies, `raycast`, `overlap`, `probe`; `addBox`, `addSensor`, `knock`, movers | labs/box/scenes/hall.ts |\n| Props                          | `defineProp` (meshes, a body, hooks), `spawnProp`, `hitProp`; the engine's `prop:crate`, `prop:barrel`, `prop:brazier`, `prop:pillar`; one a player uses or strikes: `defineUsable`, `defineStrikable`, `addInteraction` (`node x new interactable`) | labs/box/scenes/hall-props.ts |\n| Rides, doors and switches      | `addLevelLadders`, `addZipline`, `addLauncher`; `addLevelDoors`, `addLevelWindows`, `addSwitch`, `switchGroup`; `setDaytime`, `lightsAtDusk`; `placeActor` | labs/playground/scenes/site.ts |\n| Enemies and crowds             | Crowd bodies (`addAgent`, `updateCrowd`, `knockback`, `killAgent`), steering (`seek`, `followFlow`, `approachRing`), `NavGrid` and `FlowField`, attack tokens, `canSee` | labs/box/cast/walker.ts, labs/box/scenes/crowd-1000.ts |\n| Combat                         | Moves as data (`defineMove`, `Attack`, `Combo`), hit queries (`coneHits`, `sweepHits`), `damage` and `HEALTH`, projectiles, telegraphs, `reactTo`, `requestHitStop` | labs/box/scenes/fight.ts, labs/box/cast/hero.ts |\n| Melee, guns and targets        | `addMelee` (punches, kicks, the door kick), `defineWeapon`, `weaponsFor` and `addWeapons` (hip fire, the sights, a climbing recoil, reloads; `node x new weapon`), `defineThing` and `spawnThing` (targets that fall at a hit and stand again; `node x new thing`) | labs/playground/weapons/, labs/playground/cast/dummies.ts |\n| Ragdolls and joints            | `addJoint` (fixed, ball, hinge, slider, rope, spring, as data), `addRagdolls` and `handOff` (a hard blow or a death gives a person's body to physics; it gets up the way it lies), `standUp` | labs/box/scenes/ragdoll.ts, labs/playground/cast/partners.ts |\n| Animation                      | Actors animate themselves (`spawnActor({ anim: { build } })`); builds, bodies, the animator's body states, actions (`defineAction`, played on an actor with `actOn`), clips from the library (`playClip`) | labs/box/scenes/clips.ts, `node x anim find` |\n| How it looks                   | Materials and textures as data (`defineMaterial`, `defineTexture`), looks (`?post.look=look:storybook`, `post.combine`, `post.filters`, `defineLook`; `__engine.look()`), skies, lights | labs/box/looks/torch-lit.ts, `node x describe look` |\n| Effects                        | Emitters as data, bursting on sim events (`defineEmitter`); telegraphs; screen shake      | labs/box/scenes/fight.ts           |\n| UI                             | `engine.ui`: `hud(id, text, { at })`, `label`, `damage`, `crosshair`; screens and menus: `createMenu`, `createEngine({ store, modal })` (rebinds kept, a menu's keys out of play), `input.bindingsFor`, `rebind`, `listen` (a controls screen); the rest plain HTML/CSS | labs/game/main.ts (its pause), labs/playground/ui/, labs/box/menu.ts |\n| Sound                          | Effects and songs as data (`defineSfx`, `defineSong`), the page's `createAudio`; a scene's `sounds` maps events to sounds | labs/box/sounds/effects.ts, labs/box/sounds/page.ts |\n| Cameras                        | `?cam=iso` (`threequarter`, `topdown`, `overhead`, `brawler`, `side`), `?cam3=chase` (`orbit`, `fly`, `fixed`, `first`, `rail`, `shoulder`, `follow`); `__engine.camera.set(code, { blend: true })`; a map per mode: `createEngine({ actionMap: (code) => … })`; a mode of your own: `defineCamera` (`node x new camera`) | labs/game/main.ts, labs/playground/views.ts |\n| Touch controls                 | `defineTouchLayout`, `createEngine({ touchLayout })` (built, not yet tested on phones)   | labs/box/touch.ts                  |\n| A new entry of a kind          | `node x new <kind> labs/game/<dir>/<name>`: the module and its test from a template (`node x new` lists the kinds, tools/templates/README.md says where each goes; a new scene starts as a copy of play.ts instead) | tools/templates/                    |\n\nSaves, high scores and settings go in the page's store (`createStore`, never read by the sim), as labs/game/best.ts\nkeeps the best round.\n\n## 5. Rules that keep play reproducible\n\n- Sim-side code (labs/game/scenes/, labs/game/cast/) imports only engine/sim-api.ts; pages only engine/index.ts.\n  Never import three.js or Rapier directly: the public API re-exports what a game needs.\n- No clocks, timers, `Math.random`, `crypto`, DOM, storage, Web Audio or Node built-ins in sim-side code, and no\n  dynamic `import()`: lint refuses each, and its message names the fix. No network either: what the sim needs from\n  outside arrives as intents or settings. Write `Math.pow`, not `**`. Use the standard `Math`: the sim swaps in\n  portable ports while it steps, so the results match in Node and Chromium.\n- Time in steps; randomness from named streams; entities in `w.query`'s id order.\n- A sim-side module reads no files: a level's text lives in a string in the scene module.\n- Presentation never writes the sim: cameras, looks, particles, sound and the HUD change freely without changing a hash.\n- Units: metres, seconds, radians; +Y up, x east, z south; characters face +Z.\n\n**Assets.** Make them with code and data first: geometry, textures and materials as generators with parameters,\nsounds as voices and tracker notes, levels as text. A binary file (an image, a recorded sound, a model) needs the\nowner's approval: ask, and once they approve, list it in APPROVED-BINARIES.json at the game's root as\n`{ \"path\", \"reason\" }`, the reason their answer, who and when; `npm run check` fails a binary listed nowhere. Fonts\nare approved: anywhere in labs/game/, each with its license file beside it.\n\n## 6. Seeing it without a screen\n\nEvery command prints its verdict first, about 20 lines at most, and writes `out/<cmd>/<target>/report.json`;\n`node x help <cmd>` gives its manual.\n\n| Command                                                     | What it does                                                                     |\n| ----------------------------------------------------------- | -------------------------------------------------------------------------------- |\n| `npm test`                                                  | The game's tests (Vitest), headless                                              |\n| `npm run check`                                             | Types, lint, format, `node x check` (the asset rules; the engine as pinned)       |\n| `node x sim labs/game/scenes/play.ts [--steps n] [--seed s] [--set k=v] [--feel]` | Runs a scene in Node: its hash, events, entities; `--feel` measures the player |\n| `node x replay labs/game/replays [--browser sim] [--update] [--bisect]` | Checks replays' goldens; `--update` records them; `--bisect` finds where two runs part |\n| `node x shot labs/game [--cam code] [--set k=v] [--png]`    | Renders the page on WebGPU: coverage, visible objects, a text thumbnail; an image only with `--png` |\n| `node x eye labs/game/scenes/play.ts [--cam code] [--steps n]` | What a camera sees of the bodies, in Node with no GPU: a text picture and its legend (`__engine.eye()` in a page) |\n| `node x film labs/game --steps \"…\" [--compare ref]`         | Films scripted play as a contact sheet; `--compare` names the objects whose pixels changed |\n| `node x gallery <kind> [id] --page labs/game [--look id]`   | Films every prop, material, emitter, look, body or move as a labelled contact sheet; `#gallery/<kind>/<id>` opens one on any page |\n| `node x inspect --page labs/game`, then `node x eval \"<js>\"`, `node x dump`, `node x set <key> <value>` | A live headless page to question: the HUD through DOM queries, `__engine` |\n| `node x perf labs/game [--scene id]`                        | Performance as counters (ms per step and frame, draw calls), never frames per second |\n| `node x describe [kind [id]]`                               | The registries: every kind's fields and entries (materials, moves, looks, sounds…) |\n| `node x qa geo tex audio`                                   | Content QA by numbers: the engine's and the game's geometry, props, textures and sounds (labs/game/'s geometry, props, textures and sounds folders); a new or worse violation fails, and one the game accepts goes in its own `tests/baselines/qa-<family>-game.json` with the reason |\n| `node x new <kind> <id>`                                    | A new entry from its template, with its test                                     |\n| `node x audio sfx:<id>` · `node x anim find <words>`        | A sound rendered in Node, as numbers · the clip library searched                 |\n| `node x engine`                                             | Which engine the game is on, and whether its files are as shipped                |\n\nIn a page, `window.__engine` is the inspector, and a headless engine in tests (`createHeadless({ scene, seed,\nsettings })`) has the same members but the rendering ones: `__engine.help()` lists them (`step`, `hash`,\n`capture`, `restore`, `replay`, `input.press`, `input.record`, `set`, `state`, `shot`,\n`stats`…).\n\n\n--- scene setup ---\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_66","type":"reasoning","text":"**Inspecting repo and docs**"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,190p' labs/game/scenes/play.ts; printf '\\\\n--- scene setup ---\\\\n'; sed -n '190,310p' labs/game/scenes/play.ts; printf '\\\\n--- starter main ---\\\\n'; sed -n '1,220p' labs/game/main.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,190p' labs/game/scenes/play.ts; printf '\\\\n--- scene setup ---\\\\n'; sed -n '190,310p' labs/game/scenes/play.ts; printf '\\\\n--- starter main ---\\\\n'; sed -n '1,220p' labs/game/main.ts\"","aggregated_output":"/**\n * @file The starter game's scene `game:play`: every new game begins as this one (tools/game/new-game.mjs copies\n * labs/game/ into it), so it is small, plays, and shows the parts a game is made of. The player, a humanoid on the\n * character controller, runs round the arena (`ARENA_TEXT` below: walls, two pillars, two low walls to jump) collecting\n * the gems the seed scatters, before the clock runs out. All the gems: won; the clock at 0: lost.\n *\n * The parts: a level as text, compiled for its physics bodies; settings (`game.*`, read when the scene starts, so they\n * change play and go in replays); components (`gem`, drawn as a small glowing box because it declares `x` and `z` in\n * metres; `round`, the score and the clock); the player (labs/game/cast/player.ts, an actor that reads the step's\n * intents: `move`, `jump`, `dash`); systems in the phase `rules`, after the actors' feet are read back; a named random\n * stream (`gems`); events (`gem`, `won`, `lost`) that pages, sounds and tests hear. The page is labs/game/main.ts, the\n * bot labs/game/bot.ts.\n *\n * The level's text lives here, not in a .txt file, since sim-side code reads no files; the page registers the same\n * text for the view (labs/game/main.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts, so `node x sim labs/game/scenes/play.ts` runs it in Node.\n *\n * @example\n * // node x sim labs/game/scenes/play.ts --steps 600\n * // node x sim labs/game/scenes/play.ts --set game.gems=3 --seed 7\n * ARENA.spawns.find((spawn) => spawn.name === 'hero')?.position; // [3.5, 0, 2.5]\n * @see labs/game/scenes/play.test.ts\n */\nimport {\n  addLevelBodies,\n  compileLevel,\n  defineComponent,\n  defineScene,\n  defineSettings,\n  physicsOf,\n  type ActorComponent,\n  type World,\n} from '../../../engine/sim-api';\nimport { spawnPlayer } from '../cast/player';\n\n/** The arena: 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls (0.75 m) to jump, the spawn `@`. */\nexport const ARENA_TEXT = `---\ndescription: The starter game's arena. 18 × 14 m inside walls 3 m high, two 2 × 2 m pillars, two low walls 0.75 m high that the player jumps, and the player's spawn.\n---\n##################\n#................#\n#..@.............#\n#.......PP.......#\n#.......PP.......#\n#................#\n#....w......w....#\n#....w......w....#\n#................#\n#.......PP.......#\n#.......PP.......#\n#................#\n#................#\n##################\n`;\n\n/** The arena, compiled: its colliders for physics, its tiles for the gems and the bot's paths. */\nexport const ARENA = compileLevel(ARENA_TEXT, { file: 'labs/game/scenes/play.ts', name: 'arena' });\n\n/** The game's settings: each is reachable through `x set`, URL parameters (`?game.gems=3`) and `__engine.set`. */\nexport const GAME_SETTINGS = defineSettings({\n  'game.gems': {\n    type: 'integer',\n    default: 10,\n    minimum: 1,\n    maximum: 40,\n    when: 'scene',\n    description: 'How many gems the seed scatters.',\n  },\n  'game.seconds': {\n    type: 'number',\n    default: 30,\n    minimum: 5,\n    maximum: 600,\n    unit: 's',\n    when: 'scene',\n    description: 'How long the player has to collect them all.',\n  },\n  'game.speed': {\n    type: 'number',\n    default: 6,\n    minimum: 1,\n    maximum: 20,\n    unit: 'm/s',\n    when: 'scene',\n    description: 'How fast the player runs.',\n  },\n});\n\n/** A gem: where it floats and how it looks (the page draws a component that declares x and z in metres). */\nexport const GEM = defineComponent('gem', {\n  description: 'A gem to collect: where it floats, its spin and how it is drawn.',\n  fields: {\n    x: { type: 'number', default: 0, unit: 'm', description: 'East.' },\n    y: { type: 'number', default: 0.5, unit: 'm', description: 'Up: the bottom of its box.' },\n    z: { type: 'number', default: 0, unit: 'm', description: 'South.' },\n    yaw: { type: 'number', default: 0, unit: 'rad', description: 'Its spin.' },\n    size: { type: 'number', default: 0.4, unit: 'm', description: 'The side of its box.' },\n    material: { type: 'string', default: 'material:glow', description: 'What it is drawn with.' },\n  },\n});\n\n/** The round: the score, the clock and how it ended. One entity holds it. */\nexport const ROUND = defineComponent('round', {\n  description:\n    'The round: gems collected of the total, the steps left on the clock, and whether it is playing, won or lost.',\n  fields: {\n    gems: { type: 'integer', default: 0, description: 'How many gems the round scattered.' },\n    collected: { type: 'integer', default: 0, description: 'How many the player has collected.' },\n    left: { type: 'integer', default: 0, description: 'The sim steps left on the clock (60 a second).' },\n    state: { type: 'string', default: 'playing', description: \"'playing', 'won' or 'lost'.\" },\n  },\n});\n\n/** The round, as the component holds it. */\nexport type Round = { gems: number; collected: number; left: number; state: 'playing' | 'won' | 'lost' };\n\n/** The scene's components, typed. */\nexport type GameComponents = {\n  gem: { x: number; y: number; z: number; yaw: number; size: number; material: string };\n  round: Round;\n  actor: ActorComponent;\n};\n\n/** How close the player's feet come to a gem to collect it, m (on the ground plane). */\nexport const REACH = 0.8;\n\n/** How far from the spawn the gems keep, m, so the first one is never collected without moving. */\nconst CLEAR = 3;\n\n/** Where the player starts: the level's spawn `@`. */\nconst START = ARENA.spawns.find((spawn) => spawn.name === 'hero')!.position;\n\n/** The floor tiles a gem may float over: open floor (`.`), at least `CLEAR` metres from the spawn, in reading order. */\nfunction gemTiles(): number[] {\n  const tiles: number[] = [];\n  ARENA.tiles.forEach((char, i) => {\n    const x = ((i % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(i / ARENA.cols) + 0.5) * ARENA.tile;\n    if (char === '.' && Math.hypot(x - START[0], z - START[2]) >= CLEAR) tiles.push(i);\n  });\n  return tiles;\n}\n\n/** Scatters `count` gems over distinct floor tiles drawn from the stream `gems`: each seed lays them its own way. */\nfunction scatterGems(w: World<GameComponents>, count: number): void {\n  const tiles = gemTiles();\n  const rng = w.rng('gems');\n  for (let k = 0; k < count && tiles.length > 0; k++) {\n    const [tile] = tiles.splice(rng.int(0, tiles.length - 1), 1);\n    const x = ((tile % ARENA.cols) + 0.5) * ARENA.tile;\n    const z = (Math.floor(tile / ARENA.cols) + 0.5) * ARENA.tile;\n    w.spawn({ gem: { x, z, yaw: rng.range(0, Math.PI) } });\n  }\n}\n\n/** Ends the round: the player stops reading intents (and so stands still), and the event says how it ended. */\nfunction endRound(w: World<GameComponents>, round: Round, state: 'won' | 'lost'): void {\n  round.state = state;\n  for (const e of w.query('actor')) {\n    e.actor.player = false;\n    e.actor.intents = {};\n  }\n  w.emit(state, { collected: round.collected, gems: round.gems, left: round.left });\n}\n\n/**\n * Spins the gems, collects those an actor's feet reach, and ends the round when the last one goes. A despawn waits for\n * the end of the step, so a gem taken this step is remembered: two actors never count it twice.\n */\nfunction collect(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n  for (const gem of w.query('gem')) gem.gem.yaw += 2 * w.dt;\n  if (round.state !== 'playing') return;\n  const taken = new Set<number>();\n  for (const { actor } of w.query('actor')) {\n    for (const gem of w.query('gem')) {\n      if (taken.has(gem.id) || Math.hypot(gem.gem.x - actor.x, gem.gem.z - actor.z) > REACH) continue;\n      taken.add(gem.id);\n      w.despawn(gem.id);\n      round.collected += 1;\n      w.emit('gem', { id: gem.id, x: gem.gem.x, z: gem.gem.z, collected: round.collected });\n    }\n  }\n  if (round.collected >= round.gems) endRound(w, round, 'won');\n}\n\n/** Runs the clock down a step at a time (game time is whole steps, never summed seconds); at 0 the round is lost. */\nfunction clock(w: World<GameComponents>): void {\n  const [{ round }] = w.query('round');\n\n--- scene setup ---\n  const [{ round }] = w.query('round');\n  if (round.state !== 'playing') return;\n  round.left = Math.max(0, round.left - 1);\n  if (round.left === 0) endRound(w, round, 'lost');\n}\n\n/** The starter game: collect every gem before the clock runs out. */\nexport const play = defineScene<GameComponents>('game:play', {\n  description: 'The starter game: run round the arena collecting the gems before the clock runs out.',\n  level: 'level:arena',\n  physics: true,\n  setup(w) {\n    addLevelBodies(physicsOf(w), ARENA);\n    const gems = w.settings.get<number>('game.gems');\n    w.spawn({ round: { gems, left: Math.round(w.settings.get<number>('game.seconds') * w.hz) } });\n    scatterGems(w, gems);\n    spawnPlayer(w, [START[0], START[1], START[2]], w.settings.get<number>('game.speed'));\n    w.systems.add('game.collect', collect, { phase: 'rules' });\n    w.systems.add('game.clock', clock, { phase: 'rules' });\n  },\n});\n\nexport default play;\n\n--- starter main ---\n/**\n * @file The starter game's page (labs/game/index.html): it starts the engine (`createEngine`, engine/app/engine.ts) on\n * the scene `game:play` (labs/game/scenes/play.ts) with the arena's text registered for the view, offers the bot's\n * replay to `?replay=bot`, and shows the round each drawn frame in the HTML/CSS overlay's HUD: the gems, the clock,\n * the controls, the best round kept across sessions (labs/game/best.ts, through the engine's store) and, when the\n * round ends, how it ended. Enter then starts a new round on the next seed. Escape (or the pad's Start) pauses the\n * round under a menu (`createMenu`: Resume, New round), which keeps its keys out of play while it is open\n * (`createEngine({ modal })`); the store keeps the best round and any keys rebound (`createEngine({ store })`). The\n * camera is the chase camera unless the URL names one (`?cam=iso`, `?cam3=orbit`).\n *\n * Everything else a page does (routes, the renderer, the frame loop, the devices, `window.__engine`, the error\n * overlay, the touch controls) is the engine's, so this file is the game's own presentation only. It reads the run\n * and never changes it: the HUD cannot change the hash.\n *\n * Game code: it imports only the engine's public API (engine/index.ts) and the game's own files.\n *\n * Open it at http://127.0.0.1:5173/labs/game/ (`npm run dev`): `?seed=7&game.gems=20` plays another round,\n * `?replay=bot` the bot's, `?cam=iso` another camera. Headless, `node x shot labs/game` reports what it draws.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createMenu, createStore, type Engine, type EngineFrame, type Menu } from '../../engine';\nimport { bestOf, recordBest } from './best';\nimport { ARENA_TEXT, play, type Round } from './scenes/play';\n\n/** The page's query, with the chase camera when it names none: it follows the player round the arena. */\nconst search = new URLSearchParams(location.search);\nif (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'chase');\n\n/** The game's replays, by name (`?replay=bot`), as text loaded on demand. */\nconst replays = { bot: () => import('./replays/bot.replay.json?raw').then((module) => module.default) };\n\n/** The started engine; null until `createEngine` resolves (its first frames are drawn before that). */\nlet engine: Engine | null = null;\n\n/** Whether the round on screen has ended, so Enter starts the next. */\nlet ended = false;\n\n/** The game's store: its best round across sessions; a replay's page plays in its demo mode, so it sets none. */\nconst store = createStore({ prefix: 'my3dge-game:', mode: search.has('replay') ? 'demo' : 'play' });\n\n/** The fastest won round kept (s), and the run whose clock the page saw running, with the steps it started with. */\nlet best = bestOf(store);\nlet seen: { world: object; steps: number } | null = null;\n\n/** The pause menu while it is open; null while the round plays. */\nlet paused: Menu | null = null;\n\n/** Opens the pause menu over the paused round, or reads it a frame: Resume (or Escape again), New round. */\nfunction pauseMenu(dt: number): void {\n  const [inspector, ui, input] = [engine?.inspector, engine?.ui, engine?.input];\n  if (!inspector || !ui || !input) return;\n  const close = () => {\n    paused?.remove();\n    paused = null;\n    inspector.resume();\n  };\n  if (paused) return void paused.update(dt);\n  if (!input.pressed('pause')) return;\n  inspector.pause();\n  const items = [\n    { label: 'Resume', id: 'resume' },\n    { label: 'New round', id: 'new' },\n  ];\n  paused = createMenu(ui.root, items, { input, id: 'pause', title: 'Paused', onCancel: close, onPick: (_i, item) => {\n    if (typeof item === 'object' && item.id === 'new') inspector.seed(inspector.seed() + 1);\n    close();\n  } }); // prettier-ignore\n}\n\n/** Shows the round in the HUD: the gems, the clock, the controls, and how the round ended. */\nfunction showRound({ world }: EngineFrame): void {\n  const ui = engine?.ui;\n  const entity = world.query('round')[0] as unknown as { round: Round } | undefined;\n  if (!ui || !entity) return;\n  const { gems, collected, left, state } = entity.round;\n  if (seen?.world !== world) seen = state === 'playing' ? { world, steps: left + world.tick } : null;\n  const was = ended;\n  ui.hud('gems', `Gems ${collected} / ${gems}`, { at: 'top-left' });\n  ui.hud('clock', `${Math.ceil(left / world.hz)} s`, { at: 'top-right', color: left < 10 * world.hz ? '#ff8f6b' : '' });\n  ui.hud('keys', 'WASD: run · Space: jump · Shift: dash · Esc: pause', { at: 'bottom', keys: true });\n  ended = state !== 'playing';\n  if (ended && !was && state === 'won' && seen) best = recordBest(store, (seen.steps - left) / world.hz);\n  ui.hud('best', best === null ? null : `Best ${best.toFixed(1)} s`, { at: 'top-left' });\n  const end = state === 'won' ? 'Every gem! Enter: play again' : 'Time! Enter: play again';\n  ui.hud('end', ended ? end : null, { at: 'top' });\n}\n\nengine = await createEngine({\n  canvas: document.querySelector<HTMLCanvasElement>('#view')!,\n  scenes: [play.id],\n  levels: { 'level:arena': { text: ARENA_TEXT, file: 'labs/game/scenes/play.ts' } },\n  replays,\n  search: `?${search}`,\n  store,\n  modal: () => paused !== null,\n  onFrame: (frame) => {\n    pauseMenu(frame.dt);\n    showRound(frame);\n  },\n});\n\naddEventListener('keydown', (event) => {\n  const inspector = engine?.inspector;\n  if (event.code === 'Enter' && ended && inspector) inspector.seed(inspector.seed() + 1);\n});\n","exit_code":0,"status":"completed"}}
