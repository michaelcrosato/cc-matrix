ty') activityIndex = Number(button.dataset.index);\n  else if (command === 'start' || command === 'retry') { openGame(); return; }\n  else if (command === 'continue') { screen = 'hub'; session = null; selectFlat(save.unlocked); }\n  render();\n});\nroot.addEventListener('change', (event) => {\n  const input = event.target as HTMLInputElement;\n  const key = input.dataset.preference as keyof Preferences | undefined;\n  if (!key) return;\n  save.preferences[key] = input.checked; sounds.enabled = save.preferences.sound; persist(); render();\n});\nwindow.addEventListener('keydown', (event) => {\n  const key = event.key.toLowerCase();\n  if (attract) { event.preventDefault(); wake(); return; }\n  lastInput = performance.now(); lastInputType = 'keyboard';\n  if (key === 'escape') { event.preventDefault(); if (modal) modal = null; else if (screen === 'playing') modal = 'pause'; render(); return; }\n  if (screen === 'playing' && !modal) {\n    if (['arrowup','arrowdown','arrowleft','arrowright',' ','q','e'].includes(key)) event.preventDefault();\n    keys.add(key);\n    if (!event.repeat && key === 'q') doFoot('left');\n    if (!event.repeat && key === 'e') doFoot('right');\n    if (!event.repeat && key === ' ') doFoot('both');\n  } else if (['arrowup','arrowdown','arrowleft','arrowright'].includes(key)) {\n    event.preventDefault(); moveFocus(key === 'arrowup' || key === 'arrowleft' ? -1 : 1);\n  }\n});\nwindow.addEventListener('keyup', (event) => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => keys.clear());\ndocument.addEventListener('visibilitychange', () => { lastFrame = 0; });\nwindow.addEventListener('pointerdown', () => { if (attract) wake(); else lastInput = performance.now(); });\n\nfunction frame(now: number): void {\n  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean);\n  let stickX = 0; let stickY = 0; let gentle = false;\n  if (pad) {\n    stickX = Math.abs(pad.axes[0] || 0) > .13 ? pad.axes[0] : 0;\n    stickY = Math.abs(pad.axes[1] || 0) > .13 ? pad.axes[1] : 0;\n    gentle = !!pad.buttons[7]?.pressed;\n    const buttons = pad.buttons.map((button) => button.pressed);\n    const pressed = (index: number) => buttons[index] && !lastPadButtons[index];\n    if (buttons.some((button, index) => button && !lastPadButtons[index]) || stickX || stickY) {\n      if (attract) wake();\n      lastInput = now; lastInputType = 'controller';\n    }\n    if (pressed(9) || pressed(3)) { if (screen === 'playing') { modal = modal ? null : 'pause'; render(); } }\n    if (screen === 'playing' && !modal) {\n      if (pressed(4)) doFoot('left'); if (pressed(5)) doFoot('right'); if (pressed(0)) doFoot('both');\n    } else {\n      if (pressed(12) || pressed(14)) moveFocus(-1);\n      if (pressed(13) || pressed(15)) moveFocus(1);\n      if (pressed(0)) (document.activeElement as HTMLElement | null)?.click();\n      if (pressed(1) && modal) { modal = null; render(); }\n    }\n    lastPadButtons = buttons;\n  } else lastPadButtons = [];\n  if (screen === 'welcome' && !modal && now - lastInput > 60000) { dayIndex = 0; activityIndex = 0; openGame(true); }\n  if (screen === 'playing' && session && !modal && !document.hidden) {\n    const elapsed = lastFrame ? Math.min((now - lastFrame) / 1000, .1) : 0;\n    accumulator += elapsed;\n    const input = attract ? { x: Math.sin(now / 1800) * .25, y: Math.cos(now / 2400) * .2, gentle: true } : {\n      x: Math.max(-1, Math.min(1, stickX + Number(keys.has('d') || keys.has('arrowright')) - Number(keys.has('a') || keys.has('arrowleft')))),\n      y: Math.max(-1, Math.min(1, stickY + Number(keys.has('s') || keys.has('arrowdown')) - Number(keys.has('w') || keys.has('arrowup')))),\n      gentle: gentle || keys.has('shift'),\n    };\n    const settings = save.preferences.assist ? { ...DEFAULT_BALANCE, gain: DEFAULT_BALANCE.gain * .7, instability: DEFAULT_BALANCE.instability * .7, damping: DEFAULT_BALANCE.damping * 1.3 } : DEFAULT_BALANCE;\n    while (accumulator >= 1 / 60 && !session.finished) { stepSession(session, input, settings, 1 / 60); accumulator -= 1 / 60; }\n    updateGame();\n    if (session.finished) finish();\n  }\n  lastFrame = now; requestAnimationFrame(frame);\n}\nrender(); requestAnimationFrame(frame);\n\n---SIM---\n/** @file Deterministic fixed-step balance and activity simulation. */\n\nimport type { Activity } from './programme';\n\nexport type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nexport const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nexport type Input = { x: number; y: number; gentle: boolean };\nexport type Foot = 'left' | 'right' | 'both';\nexport type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nexport type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\n\nconst clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));\nconst approach = (value: number, target: number, amount: number) => value + clamp(target - value, -amount, amount);\n\nexport function createBalance(): Balance {\n  return { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, time: 0, calm: 0, outside: 0, recovering: 0, falls: 0 };\n}\n\nexport function createSession(activity: Activity, seed = 1): Session {\n  return { activity, balance: createBalance(), time: 0, scoreSum: 0, samples: 0, hits: 0, attempts: 0, foot: null, lastFoot: null, cue: 'left', actionFlash: 0, seed, finished: false, score: 0 };\n}\n\nexport function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\n  balance.time += dt;\n  const length = Math.hypot(input.x, input.y);\n  const scale = (length > 1 ? 1 / length : 1) * settings.reach * (input.gentle ? 0.4 : 1);\n  balance.targetX = approach(balance.targetX, input.x * scale, 4 * dt);\n  balance.targetY = approach(balance.targetY, input.y * scale, 4 * dt);\n  const quiet = Math.hypot(balance.vx, balance.vy) < 0.17 && length < 0.2;\n  balance.calm = clamp(balance.calm + (quiet ? dt * 0.15 : -dt * 0.3), 0, 1);\n  if (balance.recovering > 0) {\n    balance.recovering -= dt;\n    balance.x *= Math.exp(-5 * dt); balance.y *= Math.exp(-5 * dt);\n    balance.vx = 0; balance.vy = 0;\n    return;\n  }\n  const noise = settings.noise * (1 - settings.calmEffect * balance.calm);\n  const phase = balance.time * settings.noiseRate * Math.PI * 2;\n  const nx = Math.sin(phase + seed * 1.71) * 0.65 + Math.sin(phase * 1.73 + seed) * 0.35;\n  const ny = Math.sin(phase * 0.83 + seed * 2.13) * 0.65 + Math.sin(phase * 1.47 + seed * 0.8) * 0.35;\n  balance.vx += (settings.gain * (balance.targetX - balance.x) + settings.instability * balance.x + noise * nx) * dt;\n  balance.vy += (settings.gain * (balance.targetY - balance.y) + settings.instability * balance.y + noise * ny) * dt;\n  balance.vx *= Math.exp(-settings.damping * dt); balance.vy *= Math.exp(-settings.damping * dt);\n  balance.x += balance.vx * dt; balance.y += balance.vy * dt;\n  balance.outside = Math.hypot(balance.x, balance.y) > 1 ? balance.outside + 1 : 0;\n  if (balance.outside >= 6) { balance.falls++; balance.outside = 0; balance.recovering = 1; }\n}\n\nexport function targetFor(session: Session): { x: number; y: number; label: string } {\n  const time = session.time;\n  const kind = session.activity.kind;\n  if (kind === 'pond') return { x: 0, y: 0, label: 'Breathe in. Breathe out.' };\n  if (kind === 'line' || kind === 'reps' || kind === 'step' || kind === 'group' || kind === 'jog') return { x: Math.sin(time * 0.28) * (kind === 'line' ? 0.12 : 0.2), y: 0, label: 'Find your centre' };\n  if (kind === 'hoop') return { x: Math.sin(time * 1.35) * 0.44, y: Math.cos(time * 1.35) * 0.44, label: 'Follow the hoop' };\n  if (kind === 'paddle') return { x: Math.sin(time * 0.38) * 0.56, y: 0.12, label: 'Steer through the buoys' };\n  if (kind === 'sand') { const index = Math.floor(time / 12); return { x: [0.48, -0.48, 0.18, -0.32, 0][index % 5], y: [-0.25, 0.25, 0.48, -0.42, 0][index % 5], label: `Garden ${Math.min(5, index + 1)} of 5` }; }\n  if (kind === 'finale') { const index = Math.floor(time / 18); return { x: Math.sin(time * 0.35) * 0.48, y: Math.cos(time * 0.21) * 0.32, label: ['Steady the crowd', 'Hold the island', 'Help the carts', 'Find the fulcrum', 'Wait for the sunrise'][Math.min(index, 4)] }; }\n  if (kind === 'pose') { const index = Math.floor(time / 15); return { x: [0, 0.35, -0.35][index % 3], y: [0, -0.28, 0.22][index % 3], label: ['Find your centre', 'Hold the shape', 'A little longer'][index % 3] }; }\n  if (kind === 'cliff') return { x: Math.sin(time * 0.28) * 0.35, y: -0.3, label: 'Find your diving line' };\n  const index = Math.floor(time / 6);\n  return { x: [0, -0.38, 0.38, 0, 0][index % 5], y: [0, 0, 0, -0.38, 0.38][index % 5], label: ['Find your centre', 'Lean left', 'Lean right', 'Lean forward', 'Lean back'][index % 5] };\n}\n\nexport function action(session: Session, foot: Foot): boolean {\n  if (session.finished) return false;\n  session.foot = foot; session.attempts++; session.actionFlash = 0.5;\n  const kind = session.activity.kind;\n  const beat = Math.abs((session.time % 1.2) - 0.6) < 0.3;\n  const matched = kind === 'reps' || kind === 'cliff' ? foot === 'both' : foot !== 'both' && foot !== session.lastFoot;\n  const good = matched && (kind === 'step' || kind === 'reps' ? beat : true);\n  if (good) session.hits++;\n  if (foot !== 'both') session.lastFoot = foot;\n  session.cue = session.cue === 'left' ? 'right' : 'left';\n  return good;\n}\n\nexport function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n  if (session.finished) return;\n  session.time += dt;\n  stepBalance(session.balance, input, settings, dt, session.seed);\n  session.actionFlash = Math.max(0, session.actionFlash - dt);\n  const target = targetFor(session);\n  const distance = Math.hypot(session.balance.x - target.x, session.balance.y - target.y);\n  const calmBonus = session.activity.kind === 'pond' ? session.balance.calm * 0.15 : 0;\n  session.scoreSum += clamp(1 - distance * 0.8 + calmBonus, 0, 1);\n  session.samples++;\n  if (session.time >= session.activity.duration) {\n    const movement = session.scoreSum / Math.max(1, session.samples);\n    const actionKind = ['reps', 'step', 'line', 'paddle', 'cliff', 'jog', 'group'].includes(session.activity.kind);\n    const expected = session.activity.duration / 2.5;\n    const actionScore = clamp(session.hits / expected, 0, 1);\n    session.score = Math.round(clamp((actionKind ? movement * 0.7 + actionScore * 0.3 : movement) - session.balance.falls * 0.025, 0, 1) * 1000);\n    session.finished = true;\n  }\n}\n\n---DATA---\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_796","type":"reasoning","text":"**Locating exact repository**"}}
{"type":"item.started","item":{"id":"item_797","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' labs/game/main.ts; printf '\\\\n--- PROGRAMME ---\\\\n'; cat labs/game/programme.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_797","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' labs/game/main.ts; printf '\\\\n--- PROGRAMME ---\\\\n'; cat labs/game/programme.ts\"","aggregated_output":"/** @file Runs the retreat's menus, input, and balance sessions. */\nimport './styles.css';\nimport { DAYS, rankFor, type Activity } from './programme';\nimport { DEFAULT_BALANCE, action, createSession, stepSession, targetFor, type Session } from './wobble';\nimport { Soundscape } from './audio';\nimport { welcomeView, hubView, gameView, resultView, modalView } from './view';\n\ntype Screen = 'welcome' | 'hub' | 'playing' | 'result';\ntype Modal = 'settings' | 'about' | 'pause' | 'touch' | null;\ntype Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\ntype Save = { unlocked: number; scores: Record<string, number>; preferences: Preferences };\n\nconst root = document.querySelector<HTMLElement>('#app')!;\nconst storageKey = 'wee-fit-retreat-save-v1';\nconst defaults: Save = { unlocked: 0, scores: {}, preferences: { sound: true, motion: false, contrast: false, assist: false } };\nfunction load(): Save {\n  try {\n    const saved = JSON.parse(localStorage.getItem(storageKey) || '{}') as Partial<Save>;\n    return { ...defaults, ...saved, scores: saved.scores || {}, preferences: { ...defaults.preferences, ...saved.preferences } };\n  } catch { return structuredClone(defaults); }\n}\nlet save = load();\nlet screen: Screen = 'welcome';\nlet modal: Modal = null;\nlet dayIndex = 0;\nlet activityIndex = 0;\nlet session: Session | null = null;\nlet attract = false;\nlet lastInput = performance.now();\nlet lastFrame = 0;\nlet accumulator = 0;\nlet lastPadButtons: boolean[] = [];\nlet lastInputType: 'keyboard' | 'controller' = 'keyboard';\nconst keys = new Set<string>();\nconst sounds = new Soundscape();\nsounds.enabled = save.preferences.sound;\n\nfunction persist(): void {\n  try { localStorage.setItem(storageKey, JSON.stringify(save)); } catch { /* storage can be unavailable */ }\n}\nfunction flatIndex(day: number, activity: number): number {\n  return DAYS.slice(0, day).reduce((total, item) => total + item.activities.length, 0) + activity;\n}\nfunction selected(): Activity { return DAYS[dayIndex].activities[activityIndex]; }\nfunction selectFlat(index: number): void {\n  let remaining = index;\n  for (let day = 0; day < DAYS.length; day++) {\n    if (remaining < DAYS[day].activities.length) { dayIndex = day; activityIndex = remaining; return; }\n    remaining -= DAYS[day].activities.length;\n  }\n}\nfunction totalActivities(): number { return DAYS.reduce((total, day) => total + day.activities.length, 0); }\nfunction playSound(name: 'click' | 'hit' | 'finish' | 'miss'): void { try { sounds.play(name); } catch { /* audio is optional */ } }\nfunction isTouchOnly(): boolean {\n  return matchMedia('(hover: none) and (pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n}\nfunction render(): void {\n  document.documentElement.classList.toggle('reduced-motion', save.preferences.motion);\n  document.documentElement.classList.toggle('high-contrast', save.preferences.contrast);\n  const content = screen === 'welcome' ? welcomeView(isTouchOnly()) : screen === 'hub' ? hubView(dayIndex, activityIndex, save.unlocked, save.scores) : screen === 'playing' && session ? gameView(session, attract, lastInputType) : session ? resultView(session) : '';\n  root.innerHTML = content + (modal ? modalView(modal, save.preferences) : '');\n  if (screen === 'playing') updateGame();\n  if (modal) root.querySelector<HTMLElement>('.modal button, .modal input')?.focus();\n}\nfunction openGame(preview = false): void {\n  if (!preview && isTouchOnly()) { modal = 'touch'; render(); return; }\n  session = createSession(selected(), 13 + flatIndex(dayIndex, activityIndex));\n  attract = preview; screen = 'playing'; modal = null; lastFrame = 0; accumulator = 0;\n  keys.clear(); render();\n}\nfunction finish(): void {\n  if (!session) return;\n  if (attract) { screen = 'welcome'; attract = false; session = null; lastInput = performance.now(); render(); return; }\n  const index = flatIndex(dayIndex, activityIndex);\n  save.scores[session.activity.id] = Math.max(save.scores[session.activity.id] || 0, session.score);\n  save.unlocked = Math.min(totalActivities() - 1, Math.max(save.unlocked, index + 1));\n  persist(); playSound('finish'); screen = 'result'; render();\n}\nfunction updateGame(): void {\n  if (!session) return;\n  const balance = session.balance;\n  const target = targetFor(session);\n  const ball = root.querySelector<HTMLElement>('#balance-ball');\n  const marker = root.querySelector<HTMLElement>('#balance-target');\n  if (ball) { ball.style.left = `${50 + balance.x * 40}%`; ball.style.top = `${50 + balance.y * 40}%`; }\n  if (marker) { marker.style.left = `${50 + target.x * 40}%`; marker.style.top = `${50 + target.y * 40}%`; }\n  const timer = root.querySelector<HTMLElement>('#session-time');\n  if (timer) { const remaining = Math.max(0, Math.ceil(session.activity.duration - session.time)); timer.textContent = `${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}`; }\n  const cue = root.querySelector<HTMLElement>('#session-cue');\n  if (cue) cue.textContent = balance.recovering > 0 ? 'Take a breath. Find your footing.' : target.label || session.cue || 'Find your centre';\n  const score = root.querySelector<HTMLElement>('#session-score');\n  if (score) score.textContent = `${Math.round(session.samples ? session.scoreSum / session.samples : 0)}`;\n  const falls = root.querySelector<HTMLElement>('#session-falls');\n  if (falls) falls.textContent = String(balance.falls);\n  const progress = root.querySelector<HTMLElement>('#session-progress');\n  if (progress) progress.style.width = `${Math.min(100, session.time / session.activity.duration * 100)}%`;\n  const person = root.querySelector<HTMLElement>('.guest-art');\n  if (person) person.style.setProperty('--lean', `${Math.max(-1, Math.min(1, balance.x)) * 11}deg`);\n}\nfunction moveFocus(direction: number): void {\n  const scope = modal ? root.querySelector('.modal') : root;\n  const focusables = Array.from(scope?.querySelectorAll<HTMLElement>('button:not(:disabled), input:not(:disabled)') || []);\n  if (!focusables.length) return;\n  const current = focusables.indexOf(document.activeElement as HTMLElement);\n  focusables[(current + direction + focusables.length) % focusables.length].focus();\n}\nfunction doFoot(foot: 'left' | 'right' | 'both'): void {\n  if (!session || screen !== 'playing' || modal || attract) return;\n  playSound(action(session, foot) ? 'hit' : 'miss');\n}\nfunction wake(): void {\n  lastInput = performance.now();\n  if (attract) { attract = false; session = null; screen = 'welcome'; render(); }\n}\nroot.addEventListener('click', (event) => {\n  const button = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');\n  if (!button) return;\n  if (attract) { wake(); return; }\n  wake(); const command = button.dataset.action; playSound('click');\n  if (command === 'begin') { screen = 'hub'; selectFlat(save.unlocked); }\n  else if (command === 'home') { screen = 'welcome'; session = null; }\n  else if (command === 'settings' || command === 'about') modal = command;\n  else if (command === 'close') modal = null;\n  else if (command === 'pause') modal = 'pause';\n  else if (command === 'resume') { modal = null; lastFrame = 0; }\n  else if (command === 'quit') { modal = null; session = null; screen = 'hub'; }\n  else if (command === 'reset') {\n    if (window.confirm('Reset all retreat progress and scores?')) { save = structuredClone(defaults); sounds.enabled = save.preferences.sound; persist(); dayIndex = 0; activityIndex = 0; }\n  } else if (command === 'day') { dayIndex = Number(button.dataset.day); activityIndex = 0; }\n  else if (command === 'activity') activityIndex = Number(button.dataset.index);\n  else if (command === 'start' || command === 'retry') { openGame(); return; }\n  else if (command === 'continue') { screen = 'hub'; session = null; selectFlat(save.unlocked); }\n  render();\n});\nroot.addEventListener('change', (event) => {\n  const input = event.target as HTMLInputElement;\n  const key = input.dataset.preference as keyof Preferences | undefined;\n  if (!key) return;\n  save.preferences[key] = input.checked; sounds.enabled = save.preferences.sound; persist(); render();\n});\nwindow.addEventListener('keydown', (event) => {\n  const key = event.key.toLowerCase();\n  if (attract) { event.preventDefault(); wake(); return; }\n  lastInput = performance.now(); lastInputType = 'keyboard';\n  if (key === 'escape') { event.preventDefault(); if (modal) modal = null; else if (screen === 'playing') modal = 'pause'; render(); return; }\n  if (screen === 'playing' && !modal) {\n    if (['arrowup','arrowdown','arrowleft','arrowright',' ','q','e'].includes(key)) event.preventDefault();\n    keys.add(key);\n    if (!event.repeat && key === 'q') doFoot('left');\n    if (!event.repeat && key === 'e') doFoot('right');\n\n--- PROGRAMME ---\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_798","type":"reasoning","text":"**Inspecting the task details**"}}
{"type":"item.started","item":{"id":"item_799","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,125p' labs/game/wobble.ts; sed -n '1,110p' labs/game/programme.ts; sed -n '1,95p' labs/game/main.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_799","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,125p' labs/game/wobble.ts; sed -n '1,110p' labs/game/programme.ts; sed -n '1,95p' labs/game/main.ts\"","aggregated_output":"/** @file Deterministic fixed-step balance and activity simulation. */\n\nimport type { Activity } from './programme';\n\nexport type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nexport const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nexport type Input = { x: number; y: number; gentle: boolean };\nexport type Foot = 'left' | 'right' | 'both';\nexport type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nexport type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\n\nconst clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));\nconst approach = (value: number, target: number, amount: number) => value + clamp(target - value, -amount, amount);\n\nexport function createBalance(): Balance {\n  return { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, time: 0, calm: 0, outside: 0, recovering: 0, falls: 0 };\n}\n\nexport function createSession(activity: Activity, seed = 1): Session {\n  return { activity, balance: createBalance(), time: 0, scoreSum: 0, samples: 0, hits: 0, attempts: 0, foot: null, lastFoot: null, cue: 'left', actionFlash: 0, seed, finished: false, score: 0 };\n}\n\nexport function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\n  balance.time += dt;\n  const length = Math.hypot(input.x, input.y);\n  const scale = (length > 1 ? 1 / length : 1) * settings.reach * (input.gentle ? 0.4 : 1);\n  balance.targetX = approach(balance.targetX, input.x * scale, 4 * dt);\n  balance.targetY = approach(balance.targetY, input.y * scale, 4 * dt);\n  const quiet = Math.hypot(balance.vx, balance.vy) < 0.17 && length < 0.2;\n  balance.calm = clamp(balance.calm + (quiet ? dt * 0.15 : -dt * 0.3), 0, 1);\n  if (balance.recovering > 0) {\n    balance.recovering -= dt;\n    balance.x *= Math.exp(-5 * dt); balance.y *= Math.exp(-5 * dt);\n    balance.vx = 0; balance.vy = 0;\n    return;\n  }\n  const noise = settings.noise * (1 - settings.calmEffect * balance.calm);\n  const phase = balance.time * settings.noiseRate * Math.PI * 2;\n  const nx = Math.sin(phase + seed * 1.71) * 0.65 + Math.sin(phase * 1.73 + seed) * 0.35;\n  const ny = Math.sin(phase * 0.83 + seed * 2.13) * 0.65 + Math.sin(phase * 1.47 + seed * 0.8) * 0.35;\n  balance.vx += (settings.gain * (balance.targetX - balance.x) + settings.instability * balance.x + noise * nx) * dt;\n  balance.vy += (settings.gain * (balance.targetY - balance.y) + settings.instability * balance.y + noise * ny) * dt;\n  balance.vx *= Math.exp(-settings.damping * dt); balance.vy *= Math.exp(-settings.damping * dt);\n  balance.x += balance.vx * dt; balance.y += balance.vy * dt;\n  balance.outside = Math.hypot(balance.x, balance.y) > 1 ? balance.outside + 1 : 0;\n  if (balance.outside >= 6) { balance.falls++; balance.outside = 0; balance.recovering = 1; }\n}\n\nexport function targetFor(session: Session): { x: number; y: number; label: string } {\n  const time = session.time;\n  const kind = session.activity.kind;\n  if (kind === 'pond') return { x: 0, y: 0, label: 'Breathe in. Breathe out.' };\n  if (kind === 'line' || kind === 'reps' || kind === 'step' || kind === 'group' || kind === 'jog') return { x: Math.sin(time * 0.28) * (kind === 'line' ? 0.12 : 0.2), y: 0, label: 'Find your centre' };\n  if (kind === 'hoop') return { x: Math.sin(time * 1.35) * 0.44, y: Math.cos(time * 1.35) * 0.44, label: 'Follow the hoop' };\n  if (kind === 'paddle') return { x: Math.sin(time * 0.38) * 0.56, y: 0.12, label: 'Steer through the buoys' };\n  if (kind === 'sand') { const index = Math.floor(time / 12); return { x: [0.48, -0.48, 0.18, -0.32, 0][index % 5], y: [-0.25, 0.25, 0.48, -0.42, 0][index % 5], label: `Garden ${Math.min(5, index + 1)} of 5` }; }\n  if (kind === 'finale') { const index = Math.floor(time / 18); return { x: Math.sin(time * 0.35) * 0.48, y: Math.cos(time * 0.21) * 0.32, label: ['Steady the crowd', 'Hold the island', 'Help the carts', 'Find the fulcrum', 'Wait for the sunrise'][Math.min(index, 4)] }; }\n  if (kind === 'pose') { const index = Math.floor(time / 15); return { x: [0, 0.35, -0.35][index % 3], y: [0, -0.28, 0.22][index % 3], label: ['Find your centre', 'Hold the shape', 'A little longer'][index % 3] }; }\n  if (kind === 'cliff') return { x: Math.sin(time * 0.28) * 0.35, y: -0.3, label: 'Find your diving line' };\n  const index = Math.floor(time / 6);\n  return { x: [0, -0.38, 0.38, 0, 0][index % 5], y: [0, 0, 0, -0.38, 0.38][index % 5], label: ['Find your centre', 'Lean left', 'Lean right', 'Lean forward', 'Lean back'][index % 5] };\n}\n\nexport function action(session: Session, foot: Foot): boolean {\n  if (session.finished) return false;\n  session.foot = foot; session.attempts++; session.actionFlash = 0.5;\n  const kind = session.activity.kind;\n  const beat = Math.abs((session.time % 1.2) - 0.6) < 0.3;\n  const matched = kind === 'reps' || kind === 'cliff' ? foot === 'both' : foot !== 'both' && foot !== session.lastFoot;\n  const good = matched && (kind === 'step' || kind === 'reps' ? beat : true);\n  if (good) session.hits++;\n  if (foot !== 'both') session.lastFoot = foot;\n  session.cue = session.cue === 'left' ? 'right' : 'left';\n  return good;\n}\n\nexport function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n  if (session.finished) return;\n  session.time += dt;\n  stepBalance(session.balance, input, settings, dt, session.seed);\n  session.actionFlash = Math.max(0, session.actionFlash - dt);\n  const target = targetFor(session);\n  const distance = Math.hypot(session.balance.x - target.x, session.balance.y - target.y);\n  const calmBonus = session.activity.kind === 'pond' ? session.balance.calm * 0.15 : 0;\n  session.scoreSum += clamp(1 - distance * 0.8 + calmBonus, 0, 1);\n  session.samples++;\n  if (session.time >= session.activity.duration) {\n    const movement = session.scoreSum / Math.max(1, session.samples);\n    const actionKind = ['reps', 'step', 'line', 'paddle', 'cliff', 'jog', 'group'].includes(session.activity.kind);\n    const expected = session.activity.duration / 2.5;\n    const actionScore = clamp(session.hits / expected, 0, 1);\n    session.score = Math.round(clamp((actionKind ? movement * 0.7 + actionScore * 0.3 : movement) - session.balance.falls * 0.025, 0, 1) * 1000);\n    session.finished = true;\n  }\n}\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n/** @file Runs the retreat's menus, input, and balance sessions. */\nimport './styles.css';\nimport { DAYS, rankFor, type Activity } from './programme';\nimport { DEFAULT_BALANCE, action, createSession, stepSession, targetFor, type Session } from './wobble';\nimport { Soundscape } from './audio';\nimport { welcomeView, hubView, gameView, resultView, modalView } from './view';\n\ntype Screen = 'welcome' | 'hub' | 'playing' | 'result';\ntype Modal = 'settings' | 'about' | 'pause' | 'touch' | null;\ntype Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\ntype Save = { unlocked: number; scores: Record<string, number>; preferences: Preferences };\n\nconst root = document.querySelector<HTMLElement>('#app')!;\nconst storageKey = 'wee-fit-retreat-save-v1';\nconst defaults: Save = { unlocked: 0, scores: {}, preferences: { sound: true, motion: false, contrast: false, assist: false } };\nfunction load(): Save {\n  try {\n    const saved = JSON.parse(localStorage.getItem(storageKey) || '{}') as Partial<Save>;\n    return { ...defaults, ...saved, scores: saved.scores || {}, preferences: { ...defaults.preferences, ...saved.preferences } };\n  } catch { return structuredClone(defaults); }\n}\nlet save = load();\nlet screen: Screen = 'welcome';\nlet modal: Modal = null;\nlet dayIndex = 0;\nlet activityIndex = 0;\nlet session: Session | null = null;\nlet attract = false;\nlet lastInput = performance.now();\nlet lastFrame = 0;\nlet accumulator = 0;\nlet lastPadButtons: boolean[] = [];\nlet lastInputType: 'keyboard' | 'controller' = 'keyboard';\nconst keys = new Set<string>();\nconst sounds = new Soundscape();\nsounds.enabled = save.preferences.sound;\n\nfunction persist(): void {\n  try { localStorage.setItem(storageKey, JSON.stringify(save)); } catch { /* storage can be unavailable */ }\n}\nfunction flatIndex(day: number, activity: number): number {\n  return DAYS.slice(0, day).reduce((total, item) => total + item.activities.length, 0) + activity;\n}\nfunction selected(): Activity { return DAYS[dayIndex].activities[activityIndex]; }\nfunction selectFlat(index: number): void {\n  let remaining = index;\n  for (let day = 0; day < DAYS.length; day++) {\n    if (remaining < DAYS[day].activities.length) { dayIndex = day; activityIndex = remaining; return; }\n    remaining -= DAYS[day].activities.length;\n  }\n}\nfunction totalActivities(): number { return DAYS.reduce((total, day) => total + day.activities.length, 0); }\nfunction playSound(name: 'click' | 'hit' | 'finish' | 'miss'): void { try { sounds.play(name); } catch { /* audio is optional */ } }\nfunction isTouchOnly(): boolean {\n  return matchMedia('(hover: none) and (pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n}\nfunction render(): void {\n  document.documentElement.classList.toggle('reduced-motion', save.preferences.motion);\n  document.documentElement.classList.toggle('high-contrast', save.preferences.contrast);\n  const content = screen === 'welcome' ? welcomeView(isTouchOnly()) : screen === 'hub' ? hubView(dayIndex, activityIndex, save.unlocked, save.scores) : screen === 'playing' && session ? gameView(session, attract, lastInputType) : session ? resultView(session) : '';\n  root.innerHTML = content + (modal ? modalView(modal, save.preferences) : '');\n  if (screen === 'playing') updateGame();\n  if (modal) root.querySelector<HTMLElement>('.modal button, .modal input')?.focus();\n}\nfunction openGame(preview = false): void {\n  if (!preview && isTouchOnly()) { modal = 'touch'; render(); return; }\n  session = createSession(selected(), 13 + flatIndex(dayIndex, activityIndex));\n  attract = preview; screen = 'playing'; modal = null; lastFrame = 0; accumulator = 0;\n  keys.clear(); render();\n}\nfunction finish(): void {\n  if (!session) return;\n  if (attract) { screen = 'welcome'; attract = false; session = null; lastInput = performance.now(); render(); return; }\n  const index = flatIndex(dayIndex, activityIndex);\n  save.scores[session.activity.id] = Math.max(save.scores[session.activity.id] || 0, session.score);\n  save.unlocked = Math.min(totalActivities() - 1, Math.max(save.unlocked, index + 1));\n  persist(); playSound('finish'); screen = 'result'; render();\n}\nfunction updateGame(): void {\n  if (!session) return;\n  const balance = session.balance;\n  const target = targetFor(session);\n  const ball = root.querySelector<HTMLElement>('#balance-ball');\n  const marker = root.querySelector<HTMLElement>('#balance-target');\n  if (ball) { ball.style.left = `${50 + balance.x * 40}%`; ball.style.top = `${50 + balance.y * 40}%`; }\n  if (marker) { marker.style.left = `${50 + target.x * 40}%`; marker.style.top = `${50 + target.y * 40}%`; }\n  const timer = root.querySelector<HTMLElement>('#session-time');\n  if (timer) { const remaining = Math.max(0, Math.ceil(session.activity.duration - session.time)); timer.textContent = `${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}`; }\n  const cue = root.querySelector<HTMLElement>('#session-cue');\n  if (cue) cue.textContent = balance.recovering > 0 ? 'Take a breath. Find your footing.' : target.label || session.cue || 'Find your centre';\n  const score = root.querySelector<HTMLElement>('#session-score');\n  if (score) score.textContent = `${Math.round(session.samples ? session.scoreSum / session.samples : 0)}`;\n  const falls = root.querySelector<HTMLElement>('#session-falls');\n  if (falls) falls.textContent = String(balance.falls);\n  const progress = root.querySelector<HTMLElement>('#session-progress');\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_800","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' labs/game/wobble.ts; sed -n '1,100p' labs/game/programme.ts; sed -n '1,90p' labs/game/main.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_800","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' labs/game/wobble.ts; sed -n '1,100p' labs/game/programme.ts; sed -n '1,90p' labs/game/main.ts\"","aggregated_output":"/** @file Deterministic fixed-step balance and activity simulation. */\n\nimport type { Activity } from './programme';\n\nexport type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nexport const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nexport type Input = { x: number; y: number; gentle: boolean };\nexport type Foot = 'left' | 'right' | 'both';\nexport type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nexport type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\n\nconst clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));\nconst approach = (value: number, target: number, amount: number) => value + clamp(target - value, -amount, amount);\n\nexport function createBalance(): Balance {\n  return { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, time: 0, calm: 0, outside: 0, recovering: 0, falls: 0 };\n}\n\nexport function createSession(activity: Activity, seed = 1): Session {\n  return { activity, balance: createBalance(), time: 0, scoreSum: 0, samples: 0, hits: 0, attempts: 0, foot: null, lastFoot: null, cue: 'left', actionFlash: 0, seed, finished: false, score: 0 };\n}\n\nexport function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\n  balance.time += dt;\n  const length = Math.hypot(input.x, input.y);\n  const scale = (length > 1 ? 1 / length : 1) * settings.reach * (input.gentle ? 0.4 : 1);\n  balance.targetX = approach(balance.targetX, input.x * scale, 4 * dt);\n  balance.targetY = approach(balance.targetY, input.y * scale, 4 * dt);\n  const quiet = Math.hypot(balance.vx, balance.vy) < 0.17 && length < 0.2;\n  balance.calm = clamp(balance.calm + (quiet ? dt * 0.15 : -dt * 0.3), 0, 1);\n  if (balance.recovering > 0) {\n    balance.recovering -= dt;\n    balance.x *= Math.exp(-5 * dt); balance.y *= Math.exp(-5 * dt);\n    balance.vx = 0; balance.vy = 0;\n    return;\n  }\n  const noise = settings.noise * (1 - settings.calmEffect * balance.calm);\n  const phase = balance.time * settings.noiseRate * Math.PI * 2;\n  const nx = Math.sin(phase + seed * 1.71) * 0.65 + Math.sin(phase * 1.73 + seed) * 0.35;\n  const ny = Math.sin(phase * 0.83 + seed * 2.13) * 0.65 + Math.sin(phase * 1.47 + seed * 0.8) * 0.35;\n  balance.vx += (settings.gain * (balance.targetX - balance.x) + settings.instability * balance.x + noise * nx) * dt;\n  balance.vy += (settings.gain * (balance.targetY - balance.y) + settings.instability * balance.y + noise * ny) * dt;\n  balance.vx *= Math.exp(-settings.damping * dt); balance.vy *= Math.exp(-settings.damping * dt);\n  balance.x += balance.vx * dt; balance.y += balance.vy * dt;\n  balance.outside = Math.hypot(balance.x, balance.y) > 1 ? balance.outside + 1 : 0;\n  if (balance.outside >= 6) { balance.falls++; balance.outside = 0; balance.recovering = 1; }\n}\n\nexport function targetFor(session: Session): { x: number; y: number; label: string } {\n  const time = session.time;\n  const kind = session.activity.kind;\n  if (kind === 'pond') return { x: 0, y: 0, label: 'Breathe in. Breathe out.' };\n  if (kind === 'line' || kind === 'reps' || kind === 'step' || kind === 'group' || kind === 'jog') return { x: Math.sin(time * 0.28) * (kind === 'line' ? 0.12 : 0.2), y: 0, label: 'Find your centre' };\n  if (kind === 'hoop') return { x: Math.sin(time * 1.35) * 0.44, y: Math.cos(time * 1.35) * 0.44, label: 'Follow the hoop' };\n  if (kind === 'paddle') return { x: Math.sin(time * 0.38) * 0.56, y: 0.12, label: 'Steer through the buoys' };\n  if (kind === 'sand') { const index = Math.floor(time / 12); return { x: [0.48, -0.48, 0.18, -0.32, 0][index % 5], y: [-0.25, 0.25, 0.48, -0.42, 0][index % 5], label: `Garden ${Math.min(5, index + 1)} of 5` }; }\n  if (kind === 'finale') { const index = Math.floor(time / 18); return { x: Math.sin(time * 0.35) * 0.48, y: Math.cos(time * 0.21) * 0.32, label: ['Steady the crowd', 'Hold the island', 'Help the carts', 'Find the fulcrum', 'Wait for the sunrise'][Math.min(index, 4)] }; }\n  if (kind === 'pose') { const index = Math.floor(time / 15); return { x: [0, 0.35, -0.35][index % 3], y: [0, -0.28, 0.22][index % 3], label: ['Find your centre', 'Hold the shape', 'A little longer'][index % 3] }; }\n  if (kind === 'cliff') return { x: Math.sin(time * 0.28) * 0.35, y: -0.3, label: 'Find your diving line' };\n  const index = Math.floor(time / 6);\n  return { x: [0, -0.38, 0.38, 0, 0][index % 5], y: [0, 0, 0, -0.38, 0.38][index % 5], label: ['Find your centre', 'Lean left', 'Lean right', 'Lean forward', 'Lean back'][index % 5] };\n}\n\nexport function action(session: Session, foot: Foot): boolean {\n  if (session.finished) return false;\n  session.foot = foot; session.attempts++; session.actionFlash = 0.5;\n  const kind = session.activity.kind;\n  const beat = Math.abs((session.time % 1.2) - 0.6) < 0.3;\n  const matched = kind === 'reps' || kind === 'cliff' ? foot === 'both' : foot !== 'both' && foot !== session.lastFoot;\n  const good = matched && (kind === 'step' || kind === 'reps' ? beat : true);\n  if (good) session.hits++;\n  if (foot !== 'both') session.lastFoot = foot;\n  session.cue = session.cue === 'left' ? 'right' : 'left';\n  return good;\n}\n\nexport function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n  if (session.finished) return;\n  session.time += dt;\n  stepBalance(session.balance, input, settings, dt, session.seed);\n  session.actionFlash = Math.max(0, session.actionFlash - dt);\n  const target = targetFor(session);\n  const distance = Math.hypot(session.balance.x - target.x, session.balance.y - target.y);\n  const calmBonus = session.activity.kind === 'pond' ? session.balance.calm * 0.15 : 0;\n  session.scoreSum += clamp(1 - distance * 0.8 + calmBonus, 0, 1);\n  session.samples++;\n  if (session.time >= session.activity.duration) {\n    const movement = session.scoreSum / Math.max(1, session.samples);\n    const actionKind = ['reps', 'step', 'line', 'paddle', 'cliff', 'jog', 'group'].includes(session.activity.kind);\n    const expected = session.activity.duration / 2.5;\n    const actionScore = clamp(session.hits / expected, 0, 1);\n    session.score = Math.round(clamp((actionKind ? movement * 0.7 + actionScore * 0.3 : movement) - session.balance.falls * 0.025, 0, 1) * 1000);\n    session.finished = true;\n  }\n}\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n/** @file Runs the retreat's menus, input, and balance sessions. */\nimport './styles.css';\nimport { DAYS, rankFor, type Activity } from './programme';\nimport { DEFAULT_BALANCE, action, createSession, stepSession, targetFor, type Session } from './wobble';\nimport { Soundscape } from './audio';\nimport { welcomeView, hubView, gameView, resultView, modalView } from './view';\n\ntype Screen = 'welcome' | 'hub' | 'playing' | 'result';\ntype Modal = 'settings' | 'about' | 'pause' | 'touch' | null;\ntype Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\ntype Save = { unlocked: number; scores: Record<string, number>; preferences: Preferences };\n\nconst root = document.querySelector<HTMLElement>('#app')!;\nconst storageKey = 'wee-fit-retreat-save-v1';\nconst defaults: Save = { unlocked: 0, scores: {}, preferences: { sound: true, motion: false, contrast: false, assist: false } };\nfunction load(): Save {\n  try {\n    const saved = JSON.parse(localStorage.getItem(storageKey) || '{}') as Partial<Save>;\n    return { ...defaults, ...saved, scores: saved.scores || {}, preferences: { ...defaults.preferences, ...saved.preferences } };\n  } catch { return structuredClone(defaults); }\n}\nlet save = load();\nlet screen: Screen = 'welcome';\nlet modal: Modal = null;\nlet dayIndex = 0;\nlet activityIndex = 0;\nlet session: Session | null = null;\nlet attract = false;\nlet lastInput = performance.now();\nlet lastFrame = 0;\nlet accumulator = 0;\nlet lastPadButtons: boolean[] = [];\nlet lastInputType: 'keyboard' | 'controller' = 'keyboard';\nconst keys = new Set<string>();\nconst sounds = new Soundscape();\nsounds.enabled = save.preferences.sound;\n\nfunction persist(): void {\n  try { localStorage.setItem(storageKey, JSON.stringify(save)); } catch { /* storage can be unavailable */ }\n}\nfunction flatIndex(day: number, activity: number): number {\n  return DAYS.slice(0, day).reduce((total, item) => total + item.activities.length, 0) + activity;\n}\nfunction selected(): Activity { return DAYS[dayIndex].activities[activityIndex]; }\nfunction selectFlat(index: number): void {\n  let remaining = index;\n  for (let day = 0; day < DAYS.length; day++) {\n    if (remaining < DAYS[day].activities.length) { dayIndex = day; activityIndex = remaining; return; }\n    remaining -= DAYS[day].activities.length;\n  }\n}\nfunction totalActivities(): number { return DAYS.reduce((total, day) => total + day.activities.length, 0); }\nfunction playSound(name: 'click' | 'hit' | 'finish' | 'miss'): void { try { sounds.play(name); } catch { /* audio is optional */ } }\nfunction isTouchOnly(): boolean {\n  return matchMedia('(hover: none) and (pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n}\nfunction render(): void {\n  document.documentElement.classList.toggle('reduced-motion', save.preferences.motion);\n  document.documentElement.classList.toggle('high-contrast', save.preferences.contrast);\n  const content = screen === 'welcome' ? welcomeView(isTouchOnly()) : screen === 'hub' ? hubView(dayIndex, activityIndex, save.unlocked, save.scores) : screen === 'playing' && session ? gameView(session, attract, lastInputType) : session ? resultView(session) : '';\n  root.innerHTML = content + (modal ? modalView(modal, save.preferences) : '');\n  if (screen === 'playing') updateGame();\n  if (modal) root.querySelector<HTMLElement>('.modal button, .modal input')?.focus();\n}\nfunction openGame(preview = false): void {\n  if (!preview && isTouchOnly()) { modal = 'touch'; render(); return; }\n  session = createSession(selected(), 13 + flatIndex(dayIndex, activityIndex));\n  attract = preview; screen = 'playing'; modal = null; lastFrame = 0; accumulator = 0;\n  keys.clear(); render();\n}\nfunction finish(): void {\n  if (!session) return;\n  if (attract) { screen = 'welcome'; attract = false; session = null; lastInput = performance.now(); render(); return; }\n  const index = flatIndex(dayIndex, activityIndex);\n  save.scores[session.activity.id] = Math.max(save.scores[session.activity.id] || 0, session.score);\n  save.unlocked = Math.min(totalActivities() - 1, Math.max(save.unlocked, index + 1));\n  persist(); playSound('finish'); screen = 'result'; render();\n}\nfunction updateGame(): void {\n  if (!session) return;\n  const balance = session.balance;\n  const target = targetFor(session);\n  const ball = root.querySelector<HTMLElement>('#balance-ball');\n  const marker = root.querySelector<HTMLElement>('#balance-target');\n  if (ball) { ball.style.left = `${50 + balance.x * 40}%`; ball.style.top = `${50 + balance.y * 40}%`; }\n  if (marker) { marker.style.left = `${50 + target.x * 40}%`; marker.style.top = `${50 + target.y * 40}%`; }\n  const timer = root.querySelector<HTMLElement>('#session-time');\n  if (timer) { const remaining = Math.max(0, Math.ceil(session.activity.duration - session.time)); timer.textContent = `${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}`; }\n  const cue = root.querySelector<HTMLElement>('#session-cue');\n  if (cue) cue.textContent = balance.recovering > 0 ? 'Take a breath. Find your footing.' : target.label || session.cue || 'Find your centre';\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_801","type":"reasoning","text":"**Reviewing the current plan**"}}
{"type":"item.started","item":{"id":"item_802","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' labs/game/main.ts; printf '\\\\n--- VIEW ---\\\\n'; sed -n '1,100p' labs/game/view.ts; printf '\\\\n--- PROGRAMME ---\\\\n'; cat labs/game/programme.ts; printf '\\\\n--- ENGINE HUMANOID ---\\\\n'; sed -n '1,180p' engine/anim/humanoid.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_802","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' labs/game/main.ts; printf '\\\\n--- VIEW ---\\\\n'; sed -n '1,100p' labs/game/view.ts; printf '\\\\n--- PROGRAMME ---\\\\n'; cat labs/game/programme.ts; printf '\\\\n--- ENGINE HUMANOID ---\\\\n'; sed -n '1,180p' engine/anim/humanoid.ts\"","aggregated_output":"/** @file Runs the retreat's menus, input, and balance sessions. */\nimport './styles.css';\nimport { DAYS, rankFor, type Activity } from './programme';\nimport { DEFAULT_BALANCE, action, createSession, stepSession, targetFor, type Session } from './wobble';\nimport { Soundscape } from './audio';\nimport { welcomeView, hubView, gameView, resultView, modalView } from './view';\n\ntype Screen = 'welcome' | 'hub' | 'playing' | 'result';\ntype Modal = 'settings' | 'about' | 'pause' | 'touch' | null;\ntype Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\ntype Save = { unlocked: number; scores: Record<string, number>; preferences: Preferences };\n\nconst root = document.querySelector<HTMLElement>('#app')!;\nconst storageKey = 'wee-fit-retreat-save-v1';\nconst defaults: Save = { unlocked: 0, scores: {}, preferences: { sound: true, motion: false, contrast: false, assist: false } };\nfunction load(): Save {\n  try {\n    const saved = JSON.parse(localStorage.getItem(storageKey) || '{}') as Partial<Save>;\n    return { ...defaults, ...saved, scores: saved.scores || {}, preferences: { ...defaults.preferences, ...saved.preferences } };\n  } catch { return structuredClone(defaults); }\n}\nlet save = load();\nlet screen: Screen = 'welcome';\nlet modal: Modal = null;\nlet dayIndex = 0;\nlet activityIndex = 0;\nlet session: Session | null = null;\nlet attract = false;\nlet lastInput = performance.now();\nlet lastFrame = 0;\nlet accumulator = 0;\nlet lastPadButtons: boolean[] = [];\nlet lastInputType: 'keyboard' | 'controller' = 'keyboard';\nconst keys = new Set<string>();\nconst sounds = new Soundscape();\nsounds.enabled = save.preferences.sound;\n\nfunction persist(): void {\n  try { localStorage.setItem(storageKey, JSON.stringify(save)); } catch { /* storage can be unavailable */ }\n}\nfunction flatIndex(day: number, activity: number): number {\n  return DAYS.slice(0, day).reduce((total, item) => total + item.activities.length, 0) + activity;\n}\nfunction selected(): Activity { return DAYS[dayIndex].activities[activityIndex]; }\nfunction selectFlat(index: number): void {\n  let remaining = index;\n  for (let day = 0; day < DAYS.length; day++) {\n    if (remaining < DAYS[day].activities.length) { dayIndex = day; activityIndex = remaining; return; }\n    remaining -= DAYS[day].activities.length;\n  }\n}\nfunction totalActivities(): number { return DAYS.reduce((total, day) => total + day.activities.length, 0); }\nfunction playSound(name: 'click' | 'hit' | 'finish' | 'miss'): void { try { sounds.play(name); } catch { /* audio is optional */ } }\nfunction isTouchOnly(): boolean {\n  return matchMedia('(hover: none) and (pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n}\nfunction render(): void {\n  document.documentElement.classList.toggle('reduced-motion', save.preferences.motion);\n  document.documentElement.classList.toggle('high-contrast', save.preferences.contrast);\n  const content = screen === 'welcome' ? welcomeView(isTouchOnly()) : screen === 'hub' ? hubView(dayIndex, activityIndex, save.unlocked, save.scores) : screen === 'playing' && session ? gameView(session, attract, lastInputType) : session ? resultView(session) : '';\n  root.innerHTML = content + (modal ? modalView(modal, save.preferences) : '');\n  if (screen === 'playing') updateGame();\n  if (modal) root.querySelector<HTMLElement>('.modal button, .modal input')?.focus();\n}\nfunction openGame(preview = false): void {\n  if (!preview && isTouchOnly()) { modal = 'touch'; render(); return; }\n  session = createSession(selected(), 13 + flatIndex(dayIndex, activityIndex));\n  attract = preview; screen = 'playing'; modal = null; lastFrame = 0; accumulator = 0;\n  keys.clear(); render();\n}\nfunction finish(): void {\n  if (!session) return;\n  if (attract) { screen = 'welcome'; attract = false; session = null; lastInput = performance.now(); render(); return; }\n  const index = flatIndex(dayIndex, activityIndex);\n  save.scores[session.activity.id] = Math.max(save.scores[session.activity.id] || 0, session.score);\n  save.unlocked = Math.min(totalActivities() - 1, Math.max(save.unlocked, index + 1));\n  persist(); playSound('finish'); screen = 'result'; render();\n}\nfunction updateGame(): void {\n  if (!session) return;\n  const balance = session.balance;\n  const target = targetFor(session);\n  const ball = root.querySelector<HTMLElement>('#balance-ball');\n  const marker = root.querySelector<HTMLElement>('#balance-target');\n  if (ball) { ball.style.left = `${50 + balance.x * 40}%`; ball.style.top = `${50 + balance.y * 40}%`; }\n  if (marker) { marker.style.left = `${50 + target.x * 40}%`; marker.style.top = `${50 + target.y * 40}%`; }\n  const timer = root.querySelector<HTMLElement>('#session-time');\n  if (timer) { const remaining = Math.max(0, Math.ceil(session.activity.duration - session.time)); timer.textContent = `${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}`; }\n  const cue = root.querySelector<HTMLElement>('#session-cue');\n  if (cue) cue.textContent = balance.recovering > 0 ? 'Take a breath. Find your footing.' : target.label || session.cue || 'Find your centre';\n  const score = root.querySelector<HTMLElement>('#session-score');\n  if (score) score.textContent = `${Math.round(session.samples ? session.scoreSum / session.samples : 0)}`;\n  const falls = root.querySelector<HTMLElement>('#session-falls');\n  if (falls) falls.textContent = String(balance.falls);\n  const progress = root.querySelector<HTMLElement>('#session-progress');\n  if (progress) progress.style.width = `${Math.min(100, session.time / session.activity.duration * 100)}%`;\n  const person = root.querySelector<HTMLElement>('.guest-art');\n  if (person) person.style.setProperty('--lean', `${Math.max(-1, Math.min(1, balance.x)) * 11}deg`);\n}\nfunction moveFocus(direction: number): void {\n  const scope = modal ? root.querySelector('.modal') : root;\n  const focusables = Array.from(scope?.querySelectorAll<HTMLElement>('button:not(:disabled), input:not(:disabled)') || []);\n  if (!focusables.length) return;\n  const current = focusables.indexOf(document.activeElement as HTMLElement);\n  focusables[(current + direction + focusables.length) % focusables.length].focus();\n}\nfunction doFoot(foot: 'left' | 'right' | 'both'): void {\n  if (!session || screen !== 'playing' || modal || attract) return;\n  playSound(action(session, foot) ? 'hit' : 'miss');\n}\nfunction wake(): void {\n  lastInput = performance.now();\n  if (attract) { attract = false; session = null; screen = 'welcome'; render(); }\n}\nroot.addEventListener('click', (event) => {\n  const button = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');\n  if (!button) return;\n  if (attract) { wake(); return; }\n  wake(); const command = button.dataset.action; playSound('click');\n  if (command === 'begin') { screen = 'hub'; selectFlat(save.unlocked); }\n  else if (command === 'home') { screen = 'welcome'; session = null; }\n  else if (command === 'settings' || command === 'about') modal = command;\n  else if (command === 'close') modal = null;\n  else if (command === 'pause') modal = 'pause';\n  else if (command === 'resume') { modal = null; lastFrame = 0; }\n  else if (command === 'quit') { modal = null; session = null; screen = 'hub'; }\n  else if (command === 'reset') {\n    if (window.confirm('Reset all retreat progress and scores?')) { save = structuredClone(defaults); sounds.enabled = save.preferences.sound; persist(); dayIndex = 0; activityIndex = 0; }\n  } else if (command === 'day') { dayIndex = Number(button.dataset.day); activityIndex = 0; }\n  else if (command === 'activity') activityIndex = Number(button.dataset.index);\n  else if (command === 'start' || command === 'retry') { openGame(); return; }\n  else if (command === 'continue') { screen = 'hub'; session = null; selectFlat(save.unlocked); }\n  render();\n});\nroot.addEventListener('change', (event) => {\n  const input = event.target as HTMLInputElement;\n  const key = input.dataset.preference as keyof Preferences | undefined;\n  if (!key) return;\n  save.preferences[key] = input.checked; sounds.enabled = save.preferences.sound; persist(); render();\n});\nwindow.addEventListener('keydown', (event) => {\n  const key = event.key.toLowerCase();\n  if (attract) { event.preventDefault(); wake(); return; }\n  lastInput = performance.now(); lastInputType = 'keyboard';\n  if (key === 'escape') { event.preventDefault(); if (modal) modal = null; else if (screen === 'playing') modal = 'pause'; render(); return; }\n  if (screen === 'playing' && !modal) {\n    if (['arrowup','arrowdown','arrowleft','arrowright',' ','q','e'].includes(key)) event.preventDefault();\n    keys.add(key);\n    if (!event.repeat && key === 'q') doFoot('left');\n    if (!event.repeat && key === 'e') doFoot('right');\n    if (!event.repeat && key === ' ') doFoot('both');\n  } else if (['arrowup','arrowdown','arrowleft','arrowright'].includes(key)) {\n    event.preventDefault(); moveFocus(key === 'arrowup' || key === 'arrowleft' ? -1 : 1);\n  }\n});\nwindow.addEventListener('keyup', (event) => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => keys.clear());\ndocument.addEventListener('visibilitychange', () => { lastFrame = 0; });\nwindow.addEventListener('pointerdown', () => { if (attract) wake(); else lastInput = performance.now(); });\n\nfunction frame(now: number): void {\n  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean);\n  let stickX = 0; let stickY = 0; let gentle = false;\n  if (pad) {\n    stickX = Math.abs(pad.axes[0] || 0) > .13 ? pad.axes[0] : 0;\n    stickY = Math.abs(pad.axes[1] || 0) > .13 ? pad.axes[1] : 0;\n    gentle = !!pad.buttons[7]?.pressed;\n    const buttons = pad.buttons.map((button) => button.pressed);\n    const pressed = (index: number) => buttons[index] && !lastPadButtons[index];\n    if (buttons.some((button, index) => button && !lastPadButtons[index]) || stickX || stickY) {\n      if (attract) wake();\n      lastInput = now; lastInputType = 'controller';\n    }\n    if (pressed(9) || pressed(3)) { if (screen === 'playing') { modal = modal ? null : 'pause'; render(); } }\n    if (screen === 'playing' && !modal) {\n      if (pressed(4)) doFoot('left'); if (pressed(5)) doFoot('right'); if (pressed(0)) doFoot('both');\n    } else {\n      if (pressed(12) || pressed(14)) moveFocus(-1);\n      if (pressed(13) || pressed(15)) moveFocus(1);\n      if (pressed(0)) (document.activeElement as HTMLElement | null)?.click();\n      if (pressed(1) && modal) { modal = null; render(); }\n    }\n    lastPadButtons = buttons;\n  } else lastPadButtons = [];\n  if (screen === 'welcome' && !modal && now - lastInput > 60000) { dayIndex = 0; activityIndex = 0; openGame(true); }\n  if (screen === 'playing' && session && !modal && !document.hidden) {\n    const elapsed = lastFrame ? Math.min((now - lastFrame) / 1000, .1) : 0;\n    accumulator += elapsed;\n    const input = attract ? { x: Math.sin(now / 1800) * .25, y: Math.cos(now / 2400) * .2, gentle: true } : {\n      x: Math.max(-1, Math.min(1, stickX + Number(keys.has('d') || keys.has('arrowright')) - Number(keys.has('a') || keys.has('arrowleft')))),\n      y: Math.max(-1, Math.min(1, stickY + Number(keys.has('s') || keys.has('arrowdown')) - Number(keys.has('w') || keys.has('arrowup')))),\n      gentle: gentle || keys.has('shift'),\n    };\n    const settings = save.preferences.assist ? { ...DEFAULT_BALANCE, gain: DEFAULT_BALANCE.gain * .7, instability: DEFAULT_BALANCE.instability * .7, damping: DEFAULT_BALANCE.damping * 1.3 } : DEFAULT_BALANCE;\n    while (accumulator >= 1 / 60 && !session.finished) { stepSession(session, input, settings, 1 / 60); accumulator -= 1 / 60; }\n    updateGame();\n    if (session.finished) finish();\n  }\n  lastFrame = now; requestAnimationFrame(frame);\n}\nrender(); requestAnimationFrame(frame);\n\n--- VIEW ---\n/** @file Builds the original retreat interface and accessible menus. */\nimport { DAYS, rankFor } from './programme';\nimport { characterArt, islandArt } from './art';\nimport type { Session } from './wobble';\n\ntype Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\nfunction header(label = 'YOUR LITTLE ISLAND'): string {\n  return `<header class=\"topbar\"><button class=\"brand\" data-action=\"home\" aria-label=\"Return to title\"><span class=\"brand-icon\">✳</span><span>WEE FIT <b>RETREAT</b></span></button><span class=\"top-label\">${label}</span><button class=\"icon-button\" data-action=\"settings\" aria-label=\"Settings\">⚙</button></header>`;\n}\nfunction duration(seconds: number): string { return `${Math.ceil(seconds / 60)} MIN`; }\nexport function welcomeView(touch: boolean): string {\n  return `<div class=\"site welcome\">${header()}<main class=\"welcome-main\"><div class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\"></span> A MOST GENTLE ESCAPE</div><h1>Find your<br><em>almost</em> balance.</h1><p>Welcome to a little island where the air is fresh, the hosts are encouraging, and standing still is surprisingly ambitious.</p><div class=\"hero-actions\"><button class=\"primary\" data-action=\"begin\">Begin your stay <span>→</span></button><button class=\"text-button\" data-action=\"about\">What is this place? <span>↗</span></button></div>${touch ? '<p class=\"touch-notice\">Controller or keyboard required to play. Settings and the idle preview are available.</p>' : '<div class=\"control-note\"><span class=\"keycap\">↵</span> KEYBOARD &nbsp; OR &nbsp; CONTROLLER FRIENDLY</div>'}</div><div class=\"hero-art\"><div class=\"sun-halo\"></div>${islandArt()}<div class=\"postcard\"><span class=\"postcard-mark\">✳</span><div><b>A slower kind of holiday</b><small>YOUR RETREAT AWAITS</small></div></div><div class=\"art-caption\">EST. SOMEWHERE PEACEFUL &nbsp; · &nbsp; 01 / 05</div></div></main><footer class=\"welcome-footer\"><span>TAKE YOUR TIME. YOU'RE ON ISLAND TIME.</span><button class=\"footer-link\" data-action=\"about\">ABOUT &amp; CREDITS</button></footer></div>`;\n}\nexport function hubView(dayIndex: number, activityIndex: number, unlocked: number, scores: Record<string, number>): string {\n  const day = DAYS[dayIndex]; const chosen = day.activities[activityIndex];\n  const offset = DAYS.slice(0, dayIndex).reduce((total, item) => total + item.activities.length, 0);\n  const locked = offset + activityIndex > unlocked;\n  const complete = Object.keys(scores).length;\n  const tabs = DAYS.map((item, index) => `<button class=\"day-tab ${index === dayIndex ? 'active' : ''}\" data-action=\"day\" data-day=\"${index}\" aria-pressed=\"${index === dayIndex}\"><span>DAY ${String(index + 1).padStart(2, '0')}</span><b>${item.title}</b></button>`).join('');\n  const items = day.activities.map((item, index) => {\n    const isLocked = offset + index > unlocked; const score = scores[item.id];\n    return `<button class=\"activity-row ${index === activityIndex ? 'selected' : ''} ${isLocked ? 'locked' : ''}\" data-action=\"activity\" data-index=\"${index}\" aria-pressed=\"${index === activityIndex}\"><span class=\"activity-number\">${isLocked ? '·' : String(index + 1).padStart(2, '0')}</span><span class=\"activity-name\"><b>${item.title}</b><small>${item.location} &nbsp; · &nbsp; ${duration(item.duration)}</small></span><span class=\"row-status\">${score !== undefined ? '✓' : isLocked ? 'LOCKED' : '→'}</span></button>`;\n  }).join('');\n  return `<div class=\"site hub\">${header('YOUR RETREAT PROGRAMME')}<main class=\"hub-main\"><div class=\"hub-heading\"><div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> MAKE YOURSELF AT HOME</div><h1>Your island <em>itinerary.</em></h1><p>One small wobble at a time. There is no rush.</p></div><div class=\"stay-progress\"><span>YOUR STAY SO FAR</span><b>${String(complete).padStart(2, '0')} <small>experiences enjoyed</small></b></div></div><nav class=\"days\" aria-label=\"Retreat days\">${tabs}</nav><div class=\"hub-grid\"><section class=\"programme\"><div class=\"section-kicker\">DAY ${String(dayIndex + 1).padStart(2, '0')} <span>✳</span> ${day.subtitle}</div><h2>${day.title}</h2><p class=\"day-story\">${day.story}</p><div class=\"activity-list\">${items}</div></section><aside class=\"brief-card\"><div class=\"brief-top\"><span>YOUR NEXT EXPERIENCE</span><span>✳</span></div><div class=\"brief-illustration\">${characterArt()}<span class=\"illustration-sun\"></span></div><div class=\"brief-content\"><div class=\"eyebrow\">${chosen.location} &nbsp; / &nbsp; ${duration(chosen.duration)}</div><h2>${chosen.title}</h2><p>${chosen.description}</p><div class=\"host-quote\">“${chosen.quote}”<small>— ${chosen.host}, YOUR HOST</small></div><button class=\"primary full\" data-action=\"start\" ${locked ? 'disabled' : ''}>${locked ? 'Complete earlier experiences' : scores[chosen.id] !== undefined ? 'Enjoy again' : 'Start experience'} <span>→</span></button></div></aside></div></main><footer class=\"inner-footer\"><span>✳ &nbsp; THE ISLAND IS HAPPY YOU'RE HERE</span><button class=\"footer-link\" data-action=\"about\">ABOUT &amp; CREDITS</button></footer></div>`;\n}\nexport function gameView(session: Session, attract: boolean, input: 'keyboard' | 'controller'): string {\n  const activity = session.activity;\n  return `<div class=\"site game-site\">${header(attract ? 'A LITTLE PREVIEW' : activity.location.toUpperCase())}<main class=\"game-main\"><div class=\"game-title\"><div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> ${attract ? 'IDLE PREVIEW · ANY INPUT TO RETURN' : 'A MOMENT FOR YOURSELF'}</div><h1>${activity.title}</h1><p>${activity.instruction}</p></div><button class=\"outline-button\" data-action=\"pause\">Ⅱ <span>Pause</span></button></div><div class=\"game-layout\"><section class=\"balance-panel\"><div class=\"panel-label\"><span>YOUR BALANCE</span><span>STAY WITH THE CIRCLE</span></div><div class=\"balance-board\"><div class=\"board-ring ring-outer\"></div><div class=\"board-ring ring-middle\"></div><div class=\"board-ring ring-inner\"></div><div class=\"board-line horizontal\"></div><div class=\"board-line vertical\"></div><div id=\"balance-target\" class=\"balance-target\"></div><div id=\"balance-ball\" class=\"balance-ball\"></div><span class=\"board-letter top\">N</span><span class=\"board-letter bottom\">S</span><span class=\"board-letter left\">W</span><span class=\"board-letter right\">E</span></div><div class=\"session-cue\" id=\"session-cue\">Find your centre</div><div class=\"game-progress\"><div id=\"session-progress\"></div></div><div class=\"board-bottom\"><span>GENTLE DOES IT</span><span>✳</span><span>EVERY WOBBLE COUNTS</span></div></section><aside class=\"session-side\"><div class=\"session-art\"><div class=\"session-sun\"></div><div class=\"guest-art\">${characterArt()}</div><div class=\"island-water\"></div></div><div class=\"session-stats\"><div><small>TIME REMAINING</small><b id=\"session-time\">0:00</b></div><div><small>BALANCE</small><b><span id=\"session-score\">0</span><i> / 100</i></b></div><div><small>STUMBLES</small><b id=\"session-falls\">0</b></div></div><div class=\"how-to\"><b>HOW TO MOVE</b><p>${input === 'controller' ? 'Left stick to lean · R2 for gentle movement · L1 / R1 for feet · ✕ for both' : 'WASD or arrow keys to lean · Shift for gentle movement · Q / E for feet · Space for both'}</p></div></aside></div></main></div>`;\n}\nexport function resultView(session: Session): string {\n  const rank = rankFor(session.score);\n  return `<div class=\"site result-site\">${header('EXPERIENCE COMPLETE')}<main class=\"result-main\"><div class=\"result-art\">${characterArt()}<span>✳</span></div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> YOU SHOWED UP. THAT COUNTS.</div><h1>Beautifully <em>done.</em></h1><p>You've completed ${session.activity.title}. Your body may have wandered, but your spirit stayed on the island.</p><div class=\"result-score\"><div><small>YOUR BALANCE SCORE</small><b>${session.score}<i> / 100</i></b></div><div><small>THE ISLAND CALLS YOU</small><b>${rank.name}</b></div><div><small>STUMBLES</small><b>${session.balance.falls}</b></div></div><div class=\"result-actions\"><button class=\"primary\" data-action=\"continue\">Continue your stay <span>→</span></button><button class=\"text-button\" data-action=\"retry\">Try this again ↻</button></div></main></div>`;\n}\nexport function modalView(modal: string, preferences: Preferences): string {\n  let body = '';\n  if (modal === 'settings') {\n    const toggle = (key: keyof Preferences, title: string, description: string) => `<label class=\"setting-row\"><span><b>${title}</b><small>${description}</small></span><input type=\"checkbox\" data-preference=\"${key}\" ${preferences[key] ? 'checked' : ''}><span class=\"switch\" aria-hidden=\"true\"></span></label>`;\n    body = `<div class=\"eyebrow\">MAKE YOURSELF COMFORTABLE</div><h2>Retreat settings</h2>${toggle('sound','Sound effects','Little sounds for island moments')}${toggle('motion','Reduce motion','Keep the interface calm and still')}${toggle('contrast','Higher contrast','Make text and controls easier to see')}${toggle('assist','Balance assist','A gentler, more forgiving wobble')}<button class=\"text-button reset\" data-action=\"reset\">Reset saved progress ↺</button>`;\n  } else if (modal === 'pause') body = `<div class=\"eyebrow\">TAKE ALL THE TIME YOU NEED</div><h2>Pause for a breath.</h2><p>Your experience will be right here when you're ready.</p><div class=\"modal-actions\"><button class=\"primary\" data-action=\"resume\">Resume experience →</button><button class=\"text-button\" data-action=\"quit\">Return to itinerary</button></div>`;\n  else if (modal === 'touch') body = `<div class=\"eyebrow\">ONE SMALL THING</div><h2>Controller or keyboard required.</h2><p>Connect a controller or use a keyboard to take part. The settings and idle preview are still available here.</p><button class=\"primary\" data-action=\"close\">Got it →</button>`;\n  else body = `<div class=\"eyebrow\">A NOTE FROM THE ISLAND</div><h2>About this retreat</h2><p>Wee Fit Retreat is an original, gentle balance game inspired by the reassuring oddness of fitness games. All illustrations and sound effects were made for this project.</p><p>Explore five days of small activities. Lean towards the target and use your feet when the activity calls for them. Stumbles are invitations to begin again.</p><h3>Controls</h3><p><b>Keyboard:</b> WASD or arrows to lean, Shift for gentle movement, Q / E for left / right foot, Space for both, Esc to pause.<br><b>Controller:</b> left stick to lean, R2 for gentle movement, L1 / R1 for feet, Cross for both, Options to pause. D-pad and Cross navigate menus.</p><h3>Credits &amp; project notes</h3><p>Original code, illustration and synthesized audio created for this game. Built in the provided my-3dge workspace; this edition uses a custom 2D presentation and does not include online multiplayer. Progress is stored locally in your browser.</p><p>Built with Vite and TypeScript. The engine source and project feedback are included with the hand-in.</p>`;\n  return `<div class=\"modal-backdrop\"><section class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"${modal === 'about' ? 'About and credits' : modal}\" tabindex=\"-1\"><button class=\"modal-close\" data-action=\"close\" aria-label=\"Close\">×</button>${body}</section></div>`;\n}\n\n--- PROGRAMME ---\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n\n--- ENGINE HUMANOID ---\n/**\n * @file The procedural humanoid (PLAN.md WP 3.6, §5.2; I-09): my-3d2dge's `Humanoid` on the rotation skeleton.\n * `step(input)` eases the state toward the input at a fixed step (humanoidRates.ts): the weights, the gait's phase,\n * the clocks. `solve()` runs the effector stage (poses.ts `effectorStage`: locomotion.ts's gait, then the pose layers\n * in order) and the solve stage (authoring.ts: the spine from lean and twist, the arms and legs through `twoBoneRot`\n * with the old hints as poles, the feet, the weapon hand), writing `pose` and its FK, `world`; `update` does both.\n *\n * Invariants:\n * - `step` is the sim's part: `state` is plain numbers (WP 3.7 hashes and captures it). `solve` reads only `state`,\n *   `position` and `yaw`, and starts from a cleared pose, so it may run in the presentation, as often as wanted, with\n *   the same result.\n * - A fixed step, `dt` (`SIM_DT` by default). The breathing phase and the blinks come from the entity's stream\n *   (`rng`); `clock` sets the phase instead (the differential tests inject the reference rig's).\n * - `effectors` are rig-local metres before `size`, in the model frame (+Z forward, +Y up), placed by the root:\n *   `rootRot` is the yaw (times the knockdown's turn), `rootPos` carries the pelvis's offset (`rootOffset`).\n * - Where the joints land (humanoid.test.ts checks it against the reference vectors): on the old rig's points (`hipC`,\n *   `shC`, `head`, the shoulders, elbows, wrists, hips, the blade, the sole under each ankle); the old leg had no\n *   ankle, so where a planted foot lies flat or its heel lifts (authoring.ts `solveLeg`) the knee and the sole move,\n *   3 mm on average and 2 cm at worst; elsewhere the joints match to float32 rounding.\n * - The removed view hacks (`_cheat`, `_pitch`, `_camSide`) have no counterpart: the camera never feeds animation.\n *   What the view shows of the movement (`shown`, WP 13.10) is presentation, never stepped or saved; `stance()` and\n *   `treadmill()` tell the foot plant's locks when the feet stand and how the ground moves under them.\n * - A move plays through `input.body` (WP 6.1): `step` steps its arm path (strike.ts, `state.arm`), the effector\n *   stage lays it, a spin turns the root. A swing's start comes from the effector stage of the state before the step,\n *   never from a pose, so posing or not leaves the state as it is. A body motion given instead is taken as it is.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:1803-1871` (`update`, the state) and `:1917-1994` (`_pose`; the\n * knockdown's rigid turn at `:1989-1993`, as a root rotation). Squash, hair and cape are secondary motion (WP 6.2).\n *\n * @example\n * import { Vector3 } from '../core/math';\n * import { Rng } from '../core/rng';\n * import { jointPosition } from './fk';\n * const hero = new Humanoid({ build: 'build:heroic', weapon: 'sword', rng: new Rng(7) });\n * for (let i = 0; i < 60; i++) hero.update({ velocity: new Vector3(0, 0, 5), position: new Vector3(0, 0, i / 12) });\n * hero.state.weights.speed; // 1: walking at its reference speed\n * jointPosition(hero.world, 'head').y; // ≈ 1.6: the base of the skull\n * hero.update({ body: { move: 'move:slash', phase: 'active', u: 0.5 } }).state.arm.weight; // 0.5: a strike begins\n * @see engine/anim/humanoid.test.ts\n */\nimport { log as engineLog, type Log } from '../core/log';\nimport { approach, MathUtils, Quaternion, Vector3 } from '../core/math';\nimport { Rng } from '../core/rng';\nimport { SIM_DT } from '../core/time';\nimport { B, holdAlong, relaxHand, SIDES, sideSign, solveArm, solveLeg, solveSpine, type Rig, type LimbSide } from './authoring'; // prettier-ignore\nimport { getBuild, type Build } from './builds';\nimport { createWorldPose, forwardKinematics, type WorldPose } from './fk';\nimport { crouchShare, gaitKnee, gaitStance, strideShare, type BodyMotion, type EffectorContext, type HumanoidWeights } from './locomotion'; // prettier-ignore\nimport { GAIT } from './locomotion/gait';\nimport { onFeet } from './locomotion/locks';\nimport { plantedEase, plantedMove } from './locomotion/planted';\nimport { createShown, type ShownMovement } from './locomotion/shown';\nimport { Pose } from './pose';\nimport type { MoveInput } from './moves-data';\nimport { poseName, stanceName, weaponName, type PoseName, type StanceName, type Weapon } from './poseNames';\nimport { createEffectors, effectorStage, type Effectors } from './poses';\nimport { createSkeleton, jointIndex, type Skeleton } from './skeleton';\nimport { KNOCKDOWN, STEP } from './humanoidRates';\nimport { createArmState, stepArm, type ArmState } from './strike';\n\n/** The poses with a weight of their own (`die` and `down` drive the down weight instead). */\nconst HELD = ['cheer', 'cast', 'guard', 'kneel', 'crouch', 'wave', 'hips', 'block'] as const;\n\n/** What a humanoid is made from. */\nexport interface HumanoidOptions {\n  /** Its build, or the build's id; `build:chibi` by default. */\n  build?: Build | string;\n  /** What its right hand holds; `'none'` by default. */\n  weapon?: Weapon;\n  /** The entity's own stream (in a scene, `w.rng.entity(id, 'anim')`): the breathing phase and the blinks. Seed 0 by default. */\n  rng?: Rng;\n  /** The breathing clock's start, seconds; drawn from `rng` (0–10 s) by default. */\n  clock?: number;\n  /** The fixed step, seconds; `SIM_DT` by default. */\n  dt?: number;\n  /** Where it reports a misspelt pose, stance or weapon; the engine's log by default. */\n  log?: Log;\n}\n\n/** What a humanoid is told each step; every field is optional. */\nexport interface HumanoidInput {\n  /** The ground point under it, world metres; kept from the last step when absent. */\n  position?: Vector3;\n  /** Its velocity, m/s: the horizontal part drives the gait, the vertical the climb. */\n  velocity?: Vector3;\n  /** Its heading, radians: forward is (sin yaw, 0, cos yaw). Kept from the last step when absent. */\n  yaw?: number;\n  /** 0–1: run in place at this share of the build's `speedRef` (a treadmill). */\n  run?: number;\n  /** Dashing. */\n  dash?: boolean;\n  /** Hurt: a flinch. */\n  hurt?: boolean;\n  /** Airborne: the legs tuck. */\n  air?: boolean;\n  /** Climbing a ladder, hand over hand, at the vertical velocity. */\n  climb?: boolean;\n  /** The weapon hand held out along the aim. */\n  point?: boolean;\n  /** Radians above level (+) or below (−) while pointing. */\n  aim?: number;\n  /** A held pose (`POSES`). */\n  pose?: PoseName;\n  /** A stance held while moving (`STANCES`). */\n  stance?: StanceName;\n  /** 0–1: knocked flat, overriding the `die` and `down` poses. */\n  down?: number;\n  /**\n   * A move playing (WP 6.1): the move at its phase and share (`moveAt`, `Attack.body`), whose arm path and body\n   * motion the humanoid plays; or a body motion's targets alone, and the foot that leads a lunge.\n   */\n  body?: MoveInput | (Partial<BodyMotion> & { lead?: LimbSide });\n}\n\n/** The humanoid's state: plain numbers, what the sim keeps of it. */\nexport interface HumanoidState {\n  /** Seconds on the breathing clock. */\n  clock: number;\n  /** The gait's phase, radians: a step every π. */\n  phase: number;\n  /** The movement direction relative to the facing: forward share. */\n  moveF: number;\n  /** The movement direction relative to the facing: rightward share. */\n  moveR: number;\n  /** The hand-over-hand phase on a ladder, radians. */\n  climbPhase: number;\n  /** Seconds into the die pose; 0 when not dying. */\n  dieTime: number;\n  /** The aim now, radians. */\n  aim: number;\n  /** Seconds to the next blink; the eyes are shut while it is below 0. */\n  blink: number;\n  /** The foot that steps into a lunge: −1 left, 1 right. */\n  lead: number;\n  /** The weights, 0–1 each. */\n  weights: HumanoidWeights;\n  /** A move's body motion now. */\n  body: BodyMotion;\n  /** A move's arm path now (strike.ts). */\n  arm: ArmState;\n}\n\nconst ZERO = new Vector3();\nconst [UP, X_AXIS] = [new Vector3(0, 1, 0), new Vector3(1, 0, 0)];\n/** Scratch objects. */\nconst [v, yaw, knock] = [new Vector3(), new Quaternion(), new Quaternion()];\n\n/** A procedural humanoid: state, effectors, pose. See the file comment. */\nexport class Humanoid implements Rig {\n  /** Its build. */\n  readonly build: Build;\n  /** Its skeleton, made from the build. */\n  readonly skeleton: Skeleton;\n  /** What its right hand holds. */\n  readonly weapon: Weapon;\n  /** The fixed step, seconds. */\n  readonly dt: number;\n  /** The state `step` eases. */\n  readonly state: HumanoidState;\n  /** The ground point under it, world metres. */\n  readonly position = new Vector3();\n  /** Its heading, radians. */\n  yaw = 0;\n  /** The pose the last `solve` wrote. */\n  readonly pose = new Pose();\n  /** The pose's FK. */\n  readonly world: WorldPose = createWorldPose();\n  /** The last effector stage's targets. */\n  readonly effectors: Effectors = createEffectors();\n  /** Where the root sits in the rig frame, metres after `size`: the pelvis's target less its rest offset. */\n  readonly rootOffset = new Vector3();\n  /**\n   * What the view shows beyond the sim's state (WP 13.10, engine/anim/locomotion/shown.ts): the movement's crouch,\n   * slide, air, landing and lean, which the view eases (locomotion/motion.ts) and sets before each pose. Presentation\n   * only: never stepped or saved, so no hash sees it.\n   */\n  readonly shown: ShownMovement = createShown();\n  readonly #rng: Rng;\n  /** The last step's `run`: running in place. */\n  #run = 0;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_803","type":"reasoning","text":"**Assessing build request**"}}
{"type":"item.started","item":{"id":"item_804","type":"command_execution","command":"/bin/bash -lc 'cat labs/game/wobble.ts; cat labs/game/programme.ts; cat labs/game/view.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_804","type":"command_execution","command":"/bin/bash -lc 'cat labs/game/wobble.ts; cat labs/game/programme.ts; cat labs/game/view.ts'","aggregated_output":"/** @file Deterministic fixed-step balance and activity simulation. */\n\nimport type { Activity } from './programme';\n\nexport type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nexport const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nexport type Input = { x: number; y: number; gentle: boolean };\nexport type Foot = 'left' | 'right' | 'both';\nexport type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nexport type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\n\nconst clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));\nconst approach = (value: number, target: number, amount: number) => value + clamp(target - value, -amount, amount);\n\nexport function createBalance(): Balance {\n  return { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, time: 0, calm: 0, outside: 0, recovering: 0, falls: 0 };\n}\n\nexport function createSession(activity: Activity, seed = 1): Session {\n  return { activity, balance: createBalance(), time: 0, scoreSum: 0, samples: 0, hits: 0, attempts: 0, foot: null, lastFoot: null, cue: 'left', actionFlash: 0, seed, finished: false, score: 0 };\n}\n\nexport function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\n  balance.time += dt;\n  const length = Math.hypot(input.x, input.y);\n  const scale = (length > 1 ? 1 / length : 1) * settings.reach * (input.gentle ? 0.4 : 1);\n  balance.targetX = approach(balance.targetX, input.x * scale, 4 * dt);\n  balance.targetY = approach(balance.targetY, input.y * scale, 4 * dt);\n  const quiet = Math.hypot(balance.vx, balance.vy) < 0.17 && length < 0.2;\n  balance.calm = clamp(balance.calm + (quiet ? dt * 0.15 : -dt * 0.3), 0, 1);\n  if (balance.recovering > 0) {\n    balance.recovering -= dt;\n    balance.x *= Math.exp(-5 * dt); balance.y *= Math.exp(-5 * dt);\n    balance.vx = 0; balance.vy = 0;\n    return;\n  }\n  const noise = settings.noise * (1 - settings.calmEffect * balance.calm);\n  const phase = balance.time * settings.noiseRate * Math.PI * 2;\n  const nx = Math.sin(phase + seed * 1.71) * 0.65 + Math.sin(phase * 1.73 + seed) * 0.35;\n  const ny = Math.sin(phase * 0.83 + seed * 2.13) * 0.65 + Math.sin(phase * 1.47 + seed * 0.8) * 0.35;\n  balance.vx += (settings.gain * (balance.targetX - balance.x) + settings.instability * balance.x + noise * nx) * dt;\n  balance.vy += (settings.gain * (balance.targetY - balance.y) + settings.instability * balance.y + noise * ny) * dt;\n  balance.vx *= Math.exp(-settings.damping * dt); balance.vy *= Math.exp(-settings.damping * dt);\n  balance.x += balance.vx * dt; balance.y += balance.vy * dt;\n  balance.outside = Math.hypot(balance.x, balance.y) > 1 ? balance.outside + 1 : 0;\n  if (balance.outside >= 6) { balance.falls++; balance.outside = 0; balance.recovering = 1; }\n}\n\nexport function targetFor(session: Session): { x: number; y: number; label: string } {\n  const time = session.time;\n  const kind = session.activity.kind;\n  if (kind === 'pond') return { x: 0, y: 0, label: 'Breathe in. Breathe out.' };\n  if (kind === 'line' || kind === 'reps' || kind === 'step' || kind === 'group' || kind === 'jog') return { x: Math.sin(time * 0.28) * (kind === 'line' ? 0.12 : 0.2), y: 0, label: 'Find your centre' };\n  if (kind === 'hoop') return { x: Math.sin(time * 1.35) * 0.44, y: Math.cos(time * 1.35) * 0.44, label: 'Follow the hoop' };\n  if (kind === 'paddle') return { x: Math.sin(time * 0.38) * 0.56, y: 0.12, label: 'Steer through the buoys' };\n  if (kind === 'sand') { const index = Math.floor(time / 12); return { x: [0.48, -0.48, 0.18, -0.32, 0][index % 5], y: [-0.25, 0.25, 0.48, -0.42, 0][index % 5], label: `Garden ${Math.min(5, index + 1)} of 5` }; }\n  if (kind === 'finale') { const index = Math.floor(time / 18); return { x: Math.sin(time * 0.35) * 0.48, y: Math.cos(time * 0.21) * 0.32, label: ['Steady the crowd', 'Hold the island', 'Help the carts', 'Find the fulcrum', 'Wait for the sunrise'][Math.min(index, 4)] }; }\n  if (kind === 'pose') { const index = Math.floor(time / 15); return { x: [0, 0.35, -0.35][index % 3], y: [0, -0.28, 0.22][index % 3], label: ['Find your centre', 'Hold the shape', 'A little longer'][index % 3] }; }\n  if (kind === 'cliff') return { x: Math.sin(time * 0.28) * 0.35, y: -0.3, label: 'Find your diving line' };\n  const index = Math.floor(time / 6);\n  return { x: [0, -0.38, 0.38, 0, 0][index % 5], y: [0, 0, 0, -0.38, 0.38][index % 5], label: ['Find your centre', 'Lean left', 'Lean right', 'Lean forward', 'Lean back'][index % 5] };\n}\n\nexport function action(session: Session, foot: Foot): boolean {\n  if (session.finished) return false;\n  session.foot = foot; session.attempts++; session.actionFlash = 0.5;\n  const kind = session.activity.kind;\n  const beat = Math.abs((session.time % 1.2) - 0.6) < 0.3;\n  const matched = kind === 'reps' || kind === 'cliff' ? foot === 'both' : foot !== 'both' && foot !== session.lastFoot;\n  const good = matched && (kind === 'step' || kind === 'reps' ? beat : true);\n  if (good) session.hits++;\n  if (foot !== 'both') session.lastFoot = foot;\n  session.cue = session.cue === 'left' ? 'right' : 'left';\n  return good;\n}\n\nexport function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n  if (session.finished) return;\n  session.time += dt;\n  stepBalance(session.balance, input, settings, dt, session.seed);\n  session.actionFlash = Math.max(0, session.actionFlash - dt);\n  const target = targetFor(session);\n  const distance = Math.hypot(session.balance.x - target.x, session.balance.y - target.y);\n  const calmBonus = session.activity.kind === 'pond' ? session.balance.calm * 0.15 : 0;\n  session.scoreSum += clamp(1 - distance * 0.8 + calmBonus, 0, 1);\n  session.samples++;\n  if (session.time >= session.activity.duration) {\n    const movement = session.scoreSum / Math.max(1, session.samples);\n    const actionKind = ['reps', 'step', 'line', 'paddle', 'cliff', 'jog', 'group'].includes(session.activity.kind);\n    const expected = session.activity.duration / 2.5;\n    const actionScore = clamp(session.hits / expected, 0, 1);\n    session.score = Math.round(clamp((actionKind ? movement * 0.7 + actionScore * 0.3 : movement) - session.balance.falls * 0.025, 0, 1) * 1000);\n    session.finished = true;\n  }\n}\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n/** @file Builds the original retreat interface and accessible menus. */\nimport { DAYS, rankFor } from './programme';\nimport { characterArt, islandArt } from './art';\nimport type { Session } from './wobble';\n\ntype Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\nfunction header(label = 'YOUR LITTLE ISLAND'): string {\n  return `<header class=\"topbar\"><button class=\"brand\" data-action=\"home\" aria-label=\"Return to title\"><span class=\"brand-icon\">✳</span><span>WEE FIT <b>RETREAT</b></span></button><span class=\"top-label\">${label}</span><button class=\"icon-button\" data-action=\"settings\" aria-label=\"Settings\">⚙</button></header>`;\n}\nfunction duration(seconds: number): string { return `${Math.ceil(seconds / 60)} MIN`; }\nexport function welcomeView(touch: boolean): string {\n  return `<div class=\"site welcome\">${header()}<main class=\"welcome-main\"><div class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\"></span> A MOST GENTLE ESCAPE</div><h1>Find your<br><em>almost</em> balance.</h1><p>Welcome to a little island where the air is fresh, the hosts are encouraging, and standing still is surprisingly ambitious.</p><div class=\"hero-actions\"><button class=\"primary\" data-action=\"begin\">Begin your stay <span>→</span></button><button class=\"text-button\" data-action=\"about\">What is this place? <span>↗</span></button></div>${touch ? '<p class=\"touch-notice\">Controller or keyboard required to play. Settings and the idle preview are available.</p>' : '<div class=\"control-note\"><span class=\"keycap\">↵</span> KEYBOARD &nbsp; OR &nbsp; CONTROLLER FRIENDLY</div>'}</div><div class=\"hero-art\"><div class=\"sun-halo\"></div>${islandArt()}<div class=\"postcard\"><span class=\"postcard-mark\">✳</span><div><b>A slower kind of holiday</b><small>YOUR RETREAT AWAITS</small></div></div><div class=\"art-caption\">EST. SOMEWHERE PEACEFUL &nbsp; · &nbsp; 01 / 05</div></div></main><footer class=\"welcome-footer\"><span>TAKE YOUR TIME. YOU'RE ON ISLAND TIME.</span><button class=\"footer-link\" data-action=\"about\">ABOUT &amp; CREDITS</button></footer></div>`;\n}\nexport function hubView(dayIndex: number, activityIndex: number, unlocked: number, scores: Record<string, number>): string {\n  const day = DAYS[dayIndex]; const chosen = day.activities[activityIndex];\n  const offset = DAYS.slice(0, dayIndex).reduce((total, item) => total + item.activities.length, 0);\n  const locked = offset + activityIndex > unlocked;\n  const complete = Object.keys(scores).length;\n  const tabs = DAYS.map((item, index) => `<button class=\"day-tab ${index === dayIndex ? 'active' : ''}\" data-action=\"day\" data-day=\"${index}\" aria-pressed=\"${index === dayIndex}\"><span>DAY ${String(index + 1).padStart(2, '0')}</span><b>${item.title}</b></button>`).join('');\n  const items = day.activities.map((item, index) => {\n    const isLocked = offset + index > unlocked; const score = scores[item.id];\n    return `<button class=\"activity-row ${index === activityIndex ? 'selected' : ''} ${isLocked ? 'locked' : ''}\" data-action=\"activity\" data-index=\"${index}\" aria-pressed=\"${index === activityIndex}\"><span class=\"activity-number\">${isLocked ? '·' : String(index + 1).padStart(2, '0')}</span><span class=\"activity-name\"><b>${item.title}</b><small>${item.location} &nbsp; · &nbsp; ${duration(item.duration)}</small></span><span class=\"row-status\">${score !== undefined ? '✓' : isLocked ? 'LOCKED' : '→'}</span></button>`;\n  }).join('');\n  return `<div class=\"site hub\">${header('YOUR RETREAT PROGRAMME')}<main class=\"hub-main\"><div class=\"hub-heading\"><div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> MAKE YOURSELF AT HOME</div><h1>Your island <em>itinerary.</em></h1><p>One small wobble at a time. There is no rush.</p></div><div class=\"stay-progress\"><span>YOUR STAY SO FAR</span><b>${String(complete).padStart(2, '0')} <small>experiences enjoyed</small></b></div></div><nav class=\"days\" aria-label=\"Retreat days\">${tabs}</nav><div class=\"hub-grid\"><section class=\"programme\"><div class=\"section-kicker\">DAY ${String(dayIndex + 1).padStart(2, '0')} <span>✳</span> ${day.subtitle}</div><h2>${day.title}</h2><p class=\"day-story\">${day.story}</p><div class=\"activity-list\">${items}</div></section><aside class=\"brief-card\"><div class=\"brief-top\"><span>YOUR NEXT EXPERIENCE</span><span>✳</span></div><div class=\"brief-illustration\">${characterArt()}<span class=\"illustration-sun\"></span></div><div class=\"brief-content\"><div class=\"eyebrow\">${chosen.location} &nbsp; / &nbsp; ${duration(chosen.duration)}</div><h2>${chosen.title}</h2><p>${chosen.description}</p><div class=\"host-quote\">“${chosen.quote}”<small>— ${chosen.host}, YOUR HOST</small></div><button class=\"primary full\" data-action=\"start\" ${locked ? 'disabled' : ''}>${locked ? 'Complete earlier experiences' : scores[chosen.id] !== undefined ? 'Enjoy again' : 'Start experience'} <span>→</span></button></div></aside></div></main><footer class=\"inner-footer\"><span>✳ &nbsp; THE ISLAND IS HAPPY YOU'RE HERE</span><button class=\"footer-link\" data-action=\"about\">ABOUT &amp; CREDITS</button></footer></div>`;\n}\nexport function gameView(session: Session, attract: boolean, input: 'keyboard' | 'controller'): string {\n  const activity = session.activity;\n  return `<div class=\"site game-site\">${header(attract ? 'A LITTLE PREVIEW' : activity.location.toUpperCase())}<main class=\"game-main\"><div class=\"game-title\"><div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> ${attract ? 'IDLE PREVIEW · ANY INPUT TO RETURN' : 'A MOMENT FOR YOURSELF'}</div><h1>${activity.title}</h1><p>${activity.instruction}</p></div><button class=\"outline-button\" data-action=\"pause\">Ⅱ <span>Pause</span></button></div><div class=\"game-layout\"><section class=\"balance-panel\"><div class=\"panel-label\"><span>YOUR BALANCE</span><span>STAY WITH THE CIRCLE</span></div><div class=\"balance-board\"><div class=\"board-ring ring-outer\"></div><div class=\"board-ring ring-middle\"></div><div class=\"board-ring ring-inner\"></div><div class=\"board-line horizontal\"></div><div class=\"board-line vertical\"></div><div id=\"balance-target\" class=\"balance-target\"></div><div id=\"balance-ball\" class=\"balance-ball\"></div><span class=\"board-letter top\">N</span><span class=\"board-letter bottom\">S</span><span class=\"board-letter left\">W</span><span class=\"board-letter right\">E</span></div><div class=\"session-cue\" id=\"session-cue\">Find your centre</div><div class=\"game-progress\"><div id=\"session-progress\"></div></div><div class=\"board-bottom\"><span>GENTLE DOES IT</span><span>✳</span><span>EVERY WOBBLE COUNTS</span></div></section><aside class=\"session-side\"><div class=\"session-art\"><div class=\"session-sun\"></div><div class=\"guest-art\">${characterArt()}</div><div class=\"island-water\"></div></div><div class=\"session-stats\"><div><small>TIME REMAINING</small><b id=\"session-time\">0:00</b></div><div><small>BALANCE</small><b><span id=\"session-score\">0</span><i> / 100</i></b></div><div><small>STUMBLES</small><b id=\"session-falls\">0</b></div></div><div class=\"how-to\"><b>HOW TO MOVE</b><p>${input === 'controller' ? 'Left stick to lean · R2 for gentle movement · L1 / R1 for feet · ✕ for both' : 'WASD or arrow keys to lean · Shift for gentle movement · Q / E for feet · Space for both'}</p></div></aside></div></main></div>`;\n}\nexport function resultView(session: Session): string {\n  const rank = rankFor(session.score);\n  return `<div class=\"site result-site\">${header('EXPERIENCE COMPLETE')}<main class=\"result-main\"><div class=\"result-art\">${characterArt()}<span>✳</span></div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> YOU SHOWED UP. THAT COUNTS.</div><h1>Beautifully <em>done.</em></h1><p>You've completed ${session.activity.title}. Your body may have wandered, but your spirit stayed on the island.</p><div class=\"result-score\"><div><small>YOUR BALANCE SCORE</small><b>${session.score}<i> / 100</i></b></div><div><small>THE ISLAND CALLS YOU</small><b>${rank.name}</b></div><div><small>STUMBLES</small><b>${session.balance.falls}</b></div></div><div class=\"result-actions\"><button class=\"primary\" data-action=\"continue\">Continue your stay <span>→</span></button><button class=\"text-button\" data-action=\"retry\">Try this again ↻</button></div></main></div>`;\n}\nexport function modalView(modal: string, preferences: Preferences): string {\n  let body = '';\n  if (modal === 'settings') {\n    const toggle = (key: keyof Preferences, title: string, description: string) => `<label class=\"setting-row\"><span><b>${title}</b><small>${description}</small></span><input type=\"checkbox\" data-preference=\"${key}\" ${preferences[key] ? 'checked' : ''}><span class=\"switch\" aria-hidden=\"true\"></span></label>`;\n    body = `<div class=\"eyebrow\">MAKE YOURSELF COMFORTABLE</div><h2>Retreat settings</h2>${toggle('sound','Sound effects','Little sounds for island moments')}${toggle('motion','Reduce motion','Keep the interface calm and still')}${toggle('contrast','Higher contrast','Make text and controls easier to see')}${toggle('assist','Balance assist','A gentler, more forgiving wobble')}<button class=\"text-button reset\" data-action=\"reset\">Reset saved progress ↺</button>`;\n  } else if (modal === 'pause') body = `<div class=\"eyebrow\">TAKE ALL THE TIME YOU NEED</div><h2>Pause for a breath.</h2><p>Your experience will be right here when you're ready.</p><div class=\"modal-actions\"><button class=\"primary\" data-action=\"resume\">Resume experience →</button><button class=\"text-button\" data-action=\"quit\">Return to itinerary</button></div>`;\n  else if (modal === 'touch') body = `<div class=\"eyebrow\">ONE SMALL THING</div><h2>Controller or keyboard required.</h2><p>Connect a controller or use a keyboard to take part. The settings and idle preview are still available here.</p><button class=\"primary\" data-action=\"close\">Got it →</button>`;\n  else body = `<div class=\"eyebrow\">A NOTE FROM THE ISLAND</div><h2>About this retreat</h2><p>Wee Fit Retreat is an original, gentle balance game inspired by the reassuring oddness of fitness games. All illustrations and sound effects were made for this project.</p><p>Explore five days of small activities. Lean towards the target and use your feet when the activity calls for them. Stumbles are invitations to begin again.</p><h3>Controls</h3><p><b>Keyboard:</b> WASD or arrows to lean, Shift for gentle movement, Q / E for left / right foot, Space for both, Esc to pause.<br><b>Controller:</b> left stick to lean, R2 for gentle movement, L1 / R1 for feet, Cross for both, Options to pause. D-pad and Cross navigate menus.</p><h3>Credits &amp; project notes</h3><p>Original code, illustration and synthesized audio created for this game. Built in the provided my-3dge workspace; this edition uses a custom 2D presentation and does not include online multiplayer. Progress is stored locally in your browser.</p><p>Built with Vite and TypeScript. The engine source and project feedback are included with the hand-in.</p>`;\n  return `<div class=\"modal-backdrop\"><section class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"${modal === 'about' ? 'About and credits' : modal}\" tabindex=\"-1\"><button class=\"modal-close\" data-action=\"close\" aria-label=\"Close\">×</button>${body}</section></div>`;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_805","type":"reasoning","text":"**Inspecting limited lines**"}}
{"type":"item.started","item":{"id":"item_806","type":"command_execution","command":"/bin/bash -lc \"cat labs/game/wobble.ts; cat labs/game/programme.ts; sed -n '1,230p' labs/game/main.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_806","type":"command_execution","command":"/bin/bash -lc \"cat labs/game/wobble.ts; cat labs/game/programme.ts; sed -n '1,230p' labs/game/main.ts\"","aggregated_output":"/** @file Deterministic fixed-step balance and activity simulation. */\n\nimport type { Activity } from './programme';\n\nexport type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nexport const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nexport type Input = { x: number; y: number; gentle: boolean };\nexport type Foot = 'left' | 'right' | 'both';\nexport type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nexport type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\n\nconst clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));\nconst approach = (value: number, target: number, amount: number) => value + clamp(target - value, -amount, amount);\n\nexport function createBalance(): Balance {\n  return { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, time: 0, calm: 0, outside: 0, recovering: 0, falls: 0 };\n}\n\nexport function createSession(activity: Activity, seed = 1): Session {\n  return { activity, balance: createBalance(), time: 0, scoreSum: 0, samples: 0, hits: 0, attempts: 0, foot: null, lastFoot: null, cue: 'left', actionFlash: 0, seed, finished: false, score: 0 };\n}\n\nexport function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\n  balance.time += dt;\n  const length = Math.hypot(input.x, input.y);\n  const scale = (length > 1 ? 1 / length : 1) * settings.reach * (input.gentle ? 0.4 : 1);\n  balance.targetX = approach(balance.targetX, input.x * scale, 4 * dt);\n  balance.targetY = approach(balance.targetY, input.y * scale, 4 * dt);\n  const quiet = Math.hypot(balance.vx, balance.vy) < 0.17 && length < 0.2;\n  balance.calm = clamp(balance.calm + (quiet ? dt * 0.15 : -dt * 0.3), 0, 1);\n  if (balance.recovering > 0) {\n    balance.recovering -= dt;\n    balance.x *= Math.exp(-5 * dt); balance.y *= Math.exp(-5 * dt);\n    balance.vx = 0; balance.vy = 0;\n    return;\n  }\n  const noise = settings.noise * (1 - settings.calmEffect * balance.calm);\n  const phase = balance.time * settings.noiseRate * Math.PI * 2;\n  const nx = Math.sin(phase + seed * 1.71) * 0.65 + Math.sin(phase * 1.73 + seed) * 0.35;\n  const ny = Math.sin(phase * 0.83 + seed * 2.13) * 0.65 + Math.sin(phase * 1.47 + seed * 0.8) * 0.35;\n  balance.vx += (settings.gain * (balance.targetX - balance.x) + settings.instability * balance.x + noise * nx) * dt;\n  balance.vy += (settings.gain * (balance.targetY - balance.y) + settings.instability * balance.y + noise * ny) * dt;\n  balance.vx *= Math.exp(-settings.damping * dt); balance.vy *= Math.exp(-settings.damping * dt);\n  balance.x += balance.vx * dt; balance.y += balance.vy * dt;\n  balance.outside = Math.hypot(balance.x, balance.y) > 1 ? balance.outside + 1 : 0;\n  if (balance.outside >= 6) { balance.falls++; balance.outside = 0; balance.recovering = 1; }\n}\n\nexport function targetFor(session: Session): { x: number; y: number; label: string } {\n  const time = session.time;\n  const kind = session.activity.kind;\n  if (kind === 'pond') return { x: 0, y: 0, label: 'Breathe in. Breathe out.' };\n  if (kind === 'line' || kind === 'reps' || kind === 'step' || kind === 'group' || kind === 'jog') return { x: Math.sin(time * 0.28) * (kind === 'line' ? 0.12 : 0.2), y: 0, label: 'Find your centre' };\n  if (kind === 'hoop') return { x: Math.sin(time * 1.35) * 0.44, y: Math.cos(time * 1.35) * 0.44, label: 'Follow the hoop' };\n  if (kind === 'paddle') return { x: Math.sin(time * 0.38) * 0.56, y: 0.12, label: 'Steer through the buoys' };\n  if (kind === 'sand') { const index = Math.floor(time / 12); return { x: [0.48, -0.48, 0.18, -0.32, 0][index % 5], y: [-0.25, 0.25, 0.48, -0.42, 0][index % 5], label: `Garden ${Math.min(5, index + 1)} of 5` }; }\n  if (kind === 'finale') { const index = Math.floor(time / 18); return { x: Math.sin(time * 0.35) * 0.48, y: Math.cos(time * 0.21) * 0.32, label: ['Steady the crowd', 'Hold the island', 'Help the carts', 'Find the fulcrum', 'Wait for the sunrise'][Math.min(index, 4)] }; }\n  if (kind === 'pose') { const index = Math.floor(time / 15); return { x: [0, 0.35, -0.35][index % 3], y: [0, -0.28, 0.22][index % 3], label: ['Find your centre', 'Hold the shape', 'A little longer'][index % 3] }; }\n  if (kind === 'cliff') return { x: Math.sin(time * 0.28) * 0.35, y: -0.3, label: 'Find your diving line' };\n  const index = Math.floor(time / 6);\n  return { x: [0, -0.38, 0.38, 0, 0][index % 5], y: [0, 0, 0, -0.38, 0.38][index % 5], label: ['Find your centre', 'Lean left', 'Lean right', 'Lean forward', 'Lean back'][index % 5] };\n}\n\nexport function action(session: Session, foot: Foot): boolean {\n  if (session.finished) return false;\n  session.foot = foot; session.attempts++; session.actionFlash = 0.5;\n  const kind = session.activity.kind;\n  const beat = Math.abs((session.time % 1.2) - 0.6) < 0.3;\n  const matched = kind === 'reps' || kind === 'cliff' ? foot === 'both' : foot !== 'both' && foot !== session.lastFoot;\n  const good = matched && (kind === 'step' || kind === 'reps' ? beat : true);\n  if (good) session.hits++;\n  if (foot !== 'both') session.lastFoot = foot;\n  session.cue = session.cue === 'left' ? 'right' : 'left';\n  return good;\n}\n\nexport function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n  if (session.finished) return;\n  session.time += dt;\n  stepBalance(session.balance, input, settings, dt, session.seed);\n  session.actionFlash = Math.max(0, session.actionFlash - dt);\n  const target = targetFor(session);\n  const distance = Math.hypot(session.balance.x - target.x, session.balance.y - target.y);\n  const calmBonus = session.activity.kind === 'pond' ? session.balance.calm * 0.15 : 0;\n  session.scoreSum += clamp(1 - distance * 0.8 + calmBonus, 0, 1);\n  session.samples++;\n  if (session.time >= session.activity.duration) {\n    const movement = session.scoreSum / Math.max(1, session.samples);\n    const actionKind = ['reps', 'step', 'line', 'paddle', 'cliff', 'jog', 'group'].includes(session.activity.kind);\n    const expected = session.activity.duration / 2.5;\n    const actionScore = clamp(session.hits / expected, 0, 1);\n    session.score = Math.round(clamp((actionKind ? movement * 0.7 + actionScore * 0.3 : movement) - session.balance.falls * 0.025, 0, 1) * 1000);\n    session.finished = true;\n  }\n}\n/** @file The retreat's daily programme and character dialogue. */\n\nexport type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nexport type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nexport type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\n\nconst activity = (id: string, title: string, kind: ActivityKind, location: string, duration: number, description: string, instruction: string, host: string, quote: string): Activity => ({ id, title, kind, location, duration, description, instruction, host, quote });\n\nexport const DAYS: Day[] = [\n  { title: 'A softer landing', subtitle: 'DAY 01 · ARRIVAL', story: 'The ferry has left, the slippers fit, and the island seems perfectly ordinary. Probably.', activities: [\n    activity('d1-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 36, 'Meet Tare and find your centre.', 'Follow the mint target with your balance disc. Try a gentle lean.', 'TARE', 'Please step onto the mat. I promise to be only moderately judgmental.'),\n    activity('d1-pose', 'Pose Class', 'pose', 'THE PAVILION', 45, 'Three poses, no particular rush.', 'Follow the pose target. Switch feet when the instructor asks.', 'PLUMB', 'A pose is just a wobble that has made a commitment.'),\n    activity('d1-pond', 'Still Pond', 'pond', 'THE QUIET SHORE', 60, 'Be very still. The pond is watching.', 'Keep your balance centred and breathe. You do not have to obey every prompt.', 'NAN', 'The water reflects everything. Even your enthusiasm.'),\n  ] },\n  { title: 'Finding your feet', subtitle: 'DAY 02 · PRACTICE', story: 'A small tremor interrupts breakfast. Everyone politely agrees not to mention it.', activities: [\n    activity('d2-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A little check-in with Tare.', 'Follow the target and keep your movement smooth.', 'TARE', 'Welcome back. Your balance has arrived before your confidence.'),\n    activity('d2-reps', 'Reps Hall', 'reps', 'THE PAVILION', 45, 'Move with the count, not ahead of it.', 'Press both feet on the beat and keep your centre steady.', 'BEX', 'Excellent! We have a whole room for doing the same thing again.'),\n    activity('d2-sand', 'Sand Garden', 'sand', 'THE SAND GARDEN', 60, 'Guide a little stone through the garden.', 'Lean toward each target to roll the stone into place.', 'NAN', 'The sand has no deadlines. The stone, regrettably, does.'),\n    activity('d2-pose', 'Pose Class II', 'pose', 'THE PAVILION', 45, 'Archer, Comma, and the enigmatic Napkin.', 'Match each changing pose and switch feet when asked.', 'PLUMB', 'Today we become punctuation. Please avoid becoming an exclamation mark.'),\n  ] },\n  { title: 'A little momentum', subtitle: 'DAY 03 · DISCOVERY', story: 'The horizon tilts, just for a moment. Gerald says it has always done that.', activities: [\n    activity('d3-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Find your balance before venturing out.', 'Follow the mint target without rushing.', 'TARE', 'A good morning begins with a controlled amount of uncertainty.'),\n    activity('d3-paddle', 'Paddle Glide', 'paddle', 'THE LAGOON', 60, 'A gentle course through the blue.', 'Lean left and right through the buoys. Alternate feet to paddle.', 'BEX', 'The buoys are suggestions with very strong opinions.'),\n    activity('d3-line', 'The Line', 'line', 'THE RIDGE', 60, 'One careful step after another.', 'Alternate left and right feet while keeping the balance disc centred.', 'GERALD', 'It is a line. Walk along it.'),\n    activity('d3-step', 'Step Class', 'step', 'THE PAVILION', 45, 'A little rhythm for the rest of us.', 'Press the indicated foot as the beat reaches the centre.', 'BEX', 'If you lose the beat, it will come around again. They do that.'),\n  ] },\n  { title: 'The view from here', subtitle: 'DAY 04 · PERSPECTIVE', story: 'A crack runs through the path. Beneath the island is something round and very, very large.', activities: [\n    activity('d4-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'Take a breath and check in.', 'Stay with the moving target. Gentle movements help.', 'TARE', 'I have checked the island. The island has declined to comment.'),\n    activity('d4-hoop', 'Hoop Patrol', 'hoop', 'THE MEADOW', 45, 'Keep a hoop going, then catch it.', 'Circle your lean around the disc. Return to centre to catch.', 'BEX', 'Round and round! Unlike the island, which is only mostly round.'),\n    activity('d4-cliff', 'Cliff Plunge', 'cliff', 'THE CLIFF', 45, 'Three graceful plunges into the lagoon.', 'Lean into the target and press both feet to launch.', 'PLUMB', 'The important part of a dive is deciding to leave.'),\n    activity('d4-jog', 'Island Jog', 'jog', 'THE COAST PATH', 60, 'Keep Gerald company on the coast path.', 'Alternate feet to jog and lean gently through the bends.', 'GERALD', 'I am going for a walk. You may also go for a walk.'),\n  ] },\n  { title: 'The great tilt', subtitle: 'DAY 05 · TOGETHER', story: 'The secret is out: Little Fulcrum balances on a rock. A storm is coming, and the whole island will need a hand.', activities: [\n    activity('d5-check', 'Morning Check', 'check', 'THE SCALE HOUSE', 30, 'A last check before the weather arrives.', 'Follow the target and settle into a comfortable rhythm.', 'TARE', 'No pressure. Except the atmospheric kind, which is considerable.'),\n    activity('d5-group', 'Group Class', 'group', 'THE PAVILION', 60, 'A class for everyone, even Gerald.', 'Follow the targets and match the foot prompts. Everybody finishes together.', 'PLUMB', 'Balance is easier when someone is wobbling beside you.'),\n    activity('d5-pose', 'Pose Class III', 'pose', 'THE PAVILION', 45, 'Bridge and Lighthouse, for the road ahead.', 'Hold each pose by following the target. Change feet when prompted.', 'PLUMB', 'A lighthouse does not stop the sea. It simply stands there rather well.'),\n    activity('d5-finale', 'The Great Tilt', 'finale', 'THE WHOLE ISLAND', 90, 'Steady Little Fulcrum through the storm.', 'Lean toward the target to steady the island. Keep going together.', 'TARE', 'The island is wobbling. So are we. That is not the same as falling.'),\n  ] },\n];\n\nexport function rankFor(score: number): { name: string; pebbles: number } {\n  if (score >= 900) return { name: 'Unsettling', pebbles: 5 };\n  if (score >= 750) return { name: 'Serene', pebbles: 4 };\n  if (score >= 550) return { name: 'Composed', pebbles: 3 };\n  if (score >= 300) return { name: 'Adequate', pebbles: 2 };\n  return { name: 'Present', pebbles: 1 };\n}\n\nexport const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\n/** @file Runs the retreat's menus, input, and balance sessions. */\nimport './styles.css';\nimport { DAYS, rankFor, type Activity } from './programme';\nimport { DEFAULT_BALANCE, action, createSession, stepSession, targetFor, type Session } from './wobble';\nimport { Soundscape } from './audio';\nimport { welcomeView, hubView, gameView, resultView, modalView } from './view';\n\ntype Screen = 'welcome' | 'hub' | 'playing' | 'result';\ntype Modal = 'settings' | 'about' | 'pause' | 'touch' | null;\ntype Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\ntype Save = { unlocked: number; scores: Record<string, number>; preferences: Preferences };\n\nconst root = document.querySelector<HTMLElement>('#app')!;\nconst storageKey = 'wee-fit-retreat-save-v1';\nconst defaults: Save = { unlocked: 0, scores: {}, preferences: { sound: true, motion: false, contrast: false, assist: false } };\nfunction load(): Save {\n  try {\n    const saved = JSON.parse(localStorage.getItem(storageKey) || '{}') as Partial<Save>;\n    return { ...defaults, ...saved, scores: saved.scores || {}, preferences: { ...defaults.preferences, ...saved.preferences } };\n  } catch { return structuredClone(defaults); }\n}\nlet save = load();\nlet screen: Screen = 'welcome';\nlet modal: Modal = null;\nlet dayIndex = 0;\nlet activityIndex = 0;\nlet session: Session | null = null;\nlet attract = false;\nlet lastInput = performance.now();\nlet lastFrame = 0;\nlet accumulator = 0;\nlet lastPadButtons: boolean[] = [];\nlet lastInputType: 'keyboard' | 'controller' = 'keyboard';\nconst keys = new Set<string>();\nconst sounds = new Soundscape();\nsounds.enabled = save.preferences.sound;\n\nfunction persist(): void {\n  try { localStorage.setItem(storageKey, JSON.stringify(save)); } catch { /* storage can be unavailable */ }\n}\nfunction flatIndex(day: number, activity: number): number {\n  return DAYS.slice(0, day).reduce((total, item) => total + item.activities.length, 0) + activity;\n}\nfunction selected(): Activity { return DAYS[dayIndex].activities[activityIndex]; }\nfunction selectFlat(index: number): void {\n  let remaining = index;\n  for (let day = 0; day < DAYS.length; day++) {\n    if (remaining < DAYS[day].activities.length) { dayIndex = day; activityIndex = remaining; return; }\n    remaining -= DAYS[day].activities.length;\n  }\n}\nfunction totalActivities(): number { return DAYS.reduce((total, day) => total + day.activities.length, 0); }\nfunction playSound(name: 'click' | 'hit' | 'finish' | 'miss'): void { try { sounds.play(name); } catch { /* audio is optional */ } }\nfunction isTouchOnly(): boolean {\n  return matchMedia('(hover: none) and (pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n}\nfunction render(): void {\n  document.documentElement.classList.toggle('reduced-motion', save.preferences.motion);\n  document.documentElement.classList.toggle('high-contrast', save.preferences.contrast);\n  const content = screen === 'welcome' ? welcomeView(isTouchOnly()) : screen === 'hub' ? hubView(dayIndex, activityIndex, save.unlocked, save.scores) : screen === 'playing' && session ? gameView(session, attract, lastInputType) : session ? resultView(session) : '';\n  root.innerHTML = content + (modal ? modalView(modal, save.preferences) : '');\n  if (screen === 'playing') updateGame();\n  if (modal) root.querySelector<HTMLElement>('.modal button, .modal input')?.focus();\n}\nfunction openGame(preview = false): void {\n  if (!preview && isTouchOnly()) { modal = 'touch'; render(); return; }\n  session = createSession(selected(), 13 + flatIndex(dayIndex, activityIndex));\n  attract = preview; screen = 'playing'; modal = null; lastFrame = 0; accumulator = 0;\n  keys.clear(); render();\n}\nfunction finish(): void {\n  if (!session) return;\n  if (attract) { screen = 'welcome'; attract = false; session = null; lastInput = performance.now(); render(); return; }\n  const index = flatIndex(dayIndex, activityIndex);\n  save.scores[session.activity.id] = Math.max(save.scores[session.activity.id] || 0, session.score);\n  save.unlocked = Math.min(totalActivities() - 1, Math.max(save.unlocked, index + 1));\n  persist(); playSound('finish'); screen = 'result'; render();\n}\nfunction updateGame(): void {\n  if (!session) return;\n  const balance = session.balance;\n  const target = targetFor(session);\n  const ball = root.querySelector<HTMLElement>('#balance-ball');\n  const marker = root.querySelector<HTMLElement>('#balance-target');\n  if (ball) { ball.style.left = `${50 + balance.x * 40}%`; ball.style.top = `${50 + balance.y * 40}%`; }\n  if (marker) { marker.style.left = `${50 + target.x * 40}%`; marker.style.top = `${50 + target.y * 40}%`; }\n  const timer = root.querySelector<HTMLElement>('#session-time');\n  if (timer) { const remaining = Math.max(0, Math.ceil(session.activity.duration - session.time)); timer.textContent = `${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}`; }\n  const cue = root.querySelector<HTMLElement>('#session-cue');\n  if (cue) cue.textContent = balance.recovering > 0 ? 'Take a breath. Find your footing.' : target.label || session.cue || 'Find your centre';\n  const score = root.querySelector<HTMLElement>('#session-score');\n  if (score) score.textContent = `${Math.round(session.samples ? session.scoreSum / session.samples : 0)}`;\n  const falls = root.querySelector<HTMLElement>('#session-falls');\n  if (falls) falls.textContent = String(balance.falls);\n  const progress = root.querySelector<HTMLElement>('#session-progress');\n  if (progress) progress.style.width = `${Math.min(100, session.time / session.activity.duration * 100)}%`;\n  const person = root.querySelector<HTMLElement>('.guest-art');\n  if (person) person.style.setProperty('--lean', `${Math.max(-1, Math.min(1, balance.x)) * 11}deg`);\n}\nfunction moveFocus(direction: number): void {\n  const scope = modal ? root.querySelector('.modal') : root;\n  const focusables = Array.from(scope?.querySelectorAll<HTMLElement>('button:not(:disabled), input:not(:disabled)') || []);\n  if (!focusables.length) return;\n  const current = focusables.indexOf(document.activeElement as HTMLElement);\n  focusables[(current + direction + focusables.length) % focusables.length].focus();\n}\nfunction doFoot(foot: 'left' | 'right' | 'both'): void {\n  if (!session || screen !== 'playing' || modal || attract) return;\n  playSound(action(session, foot) ? 'hit' : 'miss');\n}\nfunction wake(): void {\n  lastInput = performance.now();\n  if (attract) { attract = false; session = null; screen = 'welcome'; render(); }\n}\nroot.addEventListener('click', (event) => {\n  const button = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');\n  if (!button) return;\n  if (attract) { wake(); return; }\n  wake(); const command = button.dataset.action; playSound('click');\n  if (command === 'begin') { screen = 'hub'; selectFlat(save.unlocked); }\n  else if (command === 'home') { screen = 'welcome'; session = null; }\n  else if (command === 'settings' || command === 'about') modal = command;\n  else if (command === 'close') modal = null;\n  else if (command === 'pause') modal = 'pause';\n  else if (command === 'resume') { modal = null; lastFrame = 0; }\n  else if (command === 'quit') { modal = null; session = null; screen = 'hub'; }\n  else if (command === 'reset') {\n    if (window.confirm('Reset all retreat progress and scores?')) { save = structuredClone(defaults); sounds.enabled = save.preferences.sound; persist(); dayIndex = 0; activityIndex = 0; }\n  } else if (command === 'day') { dayIndex = Number(button.dataset.day); activityIndex = 0; }\n  else if (command === 'activity') activityIndex = Number(button.dataset.index);\n  else if (command === 'start' || command === 'retry') { openGame(); return; }\n  else if (command === 'continue') { screen = 'hub'; session = null; selectFlat(save.unlocked); }\n  render();\n});\nroot.addEventListener('change', (event) => {\n  const input = event.target as HTMLInputElement;\n  const key = input.dataset.preference as keyof Preferences | undefined;\n  if (!key) return;\n  save.preferences[key] = input.checked; sounds.enabled = save.preferences.sound; persist(); render();\n});\nwindow.addEventListener('keydown', (event) => {\n  const key = event.key.toLowerCase();\n  if (attract) { event.preventDefault(); wake(); return; }\n  lastInput = performance.now(); lastInputType = 'keyboard';\n  if (key === 'escape') { event.preventDefault(); if (modal) modal = null; else if (screen === 'playing') modal = 'pause'; render(); return; }\n  if (screen === 'playing' && !modal) {\n    if (['arrowup','arrowdown','arrowleft','arrowright',' ','q','e'].includes(key)) event.preventDefault();\n    keys.add(key);\n    if (!event.repeat && key === 'q') doFoot('left');\n    if (!event.repeat && key === 'e') doFoot('right');\n    if (!event.repeat && key === ' ') doFoot('both');\n  } else if (['arrowup','arrowdown','arrowleft','arrowright'].includes(key)) {\n    event.preventDefault(); moveFocus(key === 'arrowup' || key === 'arrowleft' ? -1 : 1);\n  }\n});\nwindow.addEventListener('keyup', (event) => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => keys.clear());\ndocument.addEventListener('visibilitychange', () => { lastFrame = 0; });\nwindow.addEventListener('pointerdown', () => { if (attract) wake(); else lastInput = performance.now(); });\n\nfunction frame(now: number): void {\n  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean);\n  let stickX = 0; let stickY = 0; let gentle = false;\n  if (pad) {\n    stickX = Math.abs(pad.axes[0] || 0) > .13 ? pad.axes[0] : 0;\n    stickY = Math.abs(pad.axes[1] || 0) > .13 ? pad.axes[1] : 0;\n    gentle = !!pad.buttons[7]?.pressed;\n    const buttons = pad.buttons.map((button) => button.pressed);\n    const pressed = (index: number) => buttons[index] && !lastPadButtons[index];\n    if (buttons.some((button, index) => button && !lastPadButtons[index]) || stickX || stickY) {\n      if (attract) wake();\n      lastInput = now; lastInputType = 'controller';\n    }\n    if (pressed(9) || pressed(3)) { if (screen === 'playing') { modal = modal ? null : 'pause'; render(); } }\n    if (screen === 'playing' && !modal) {\n      if (pressed(4)) doFoot('left'); if (pressed(5)) doFoot('right'); if (pressed(0)) doFoot('both');\n    } else {\n      if (pressed(12) || pressed(14)) moveFocus(-1);\n      if (pressed(13) || pressed(15)) moveFocus(1);\n      if (pressed(0)) (document.activeElement as HTMLElement | null)?.click();\n      if (pressed(1) && modal) { modal = null; render(); }\n    }\n    lastPadButtons = buttons;\n  } else lastPadButtons = [];\n  if (screen === 'welcome' && !modal && now - lastInput > 60000) { dayIndex = 0; activityIndex = 0; openGame(true); }\n  if (screen === 'playing' && session && !modal && !document.hidden) {\n    const elapsed = lastFrame ? Math.min((now - lastFrame) / 1000, .1) : 0;\n    accumulator += elapsed;\n    const input = attract ? { x: Math.sin(now / 1800) * .25, y: Math.cos(now / 2400) * .2, gentle: true } : {\n      x: Math.max(-1, Math.min(1, stickX + Number(keys.has('d') || keys.has('arrowright')) - Number(keys.has('a') || keys.has('arrowleft')))),\n      y: Math.max(-1, Math.min(1, stickY + Number(keys.has('s') || keys.has('arrowdown')) - Number(keys.has('w') || keys.has('arrowup')))),\n      gentle: gentle || keys.has('shift'),\n    };\n    const settings = save.preferences.assist ? { ...DEFAULT_BALANCE, gain: DEFAULT_BALANCE.gain * .7, instability: DEFAULT_BALANCE.instability * .7, damping: DEFAULT_BALANCE.damping * 1.3 } : DEFAULT_BALANCE;\n    while (accumulator >= 1 / 60 && !session.finished) { stepSession(session, input, settings, 1 / 60); accumulator -= 1 / 60; }\n    updateGame();\n    if (session.finished) finish();\n  }\n  lastFrame = now; requestAnimationFrame(frame);\n}\nrender(); requestAnimationFrame(frame);\n","exit_code":0,"status":"completed"}}
