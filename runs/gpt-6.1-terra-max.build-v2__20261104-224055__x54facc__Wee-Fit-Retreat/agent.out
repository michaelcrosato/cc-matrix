 type { CrowdRigDraw } from './gfx/puppets/crowd';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:271:export type { CrowdStats } from './gfx/puppets/crowd';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:272:export type { RigBody } from './gfx/puppets/crowd';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:273:export type { RigPart } from './gfx/puppets/crowd';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:274:export type { RigJoints } from './gfx/puppets/crowd';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:275:export type { RigShape } from './gfx/puppets/crowd';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:278:export type { CrowdLod } from './gfx/puppets/lod';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:279:export type { CrowdLodOptions } from './gfx/puppets/lod';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:280:export type { CrowdLodCounts } from './gfx/puppets/lod';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:281:export type { CrowdBand } from './gfx/puppets/lod';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:282:export type { CrowdBandSpec } from './gfx/puppets/lod';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:285:export type { BlobFeatures } from './gfx/puppets/bodies/blob';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/index.ts:307:export type { MannequinData } from './gfx/puppets/bodies/mannequin';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/ui/labels.ts:54:export interface OverlayCamera {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/input/intents.ts:210:export function fromCamera(yaw: number, axes: readonly [number, number]): [number, number] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/dais.ts:55:export function daisGeometry(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/stairs.ts:115:export function stairsGeometry(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/input/input.ts:56:export interface CameraLike {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/input/input.ts:96:export interface CameraInputSample {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/input/api.ts:28:export type { CameraLike } from './input';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/input/api.ts:29:export type { CameraInputSample } from './input';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/ramp.ts:70:export function rampGeometry(tile: number, ramps: readonly RampDescriptor[], ground: number): BufferGeometry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/walls.ts:53:export function underRoofGeometry(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/shapes.ts:79:export function placeInstances(mesh: InstancedMesh, cells: readonly LevelCell[]): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/shapes.ts:118:export function drawnWith(geometry: BufferGeometry, materials: readonly Material[]): Material | Material[] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/app/view.ts:88:export interface CameraInfo {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/fx/sprites.ts:77:export function spriteMaterial(): MeshBasicNodeMaterial {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/surface.ts:24:export function surfaceGeometry(tile: number, pieces: readonly TileRect[], y: number): BufferGeometry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/app/drawing.ts:56:export function warmedCameras<C>(cameras: readonly C[], drawn: ReadonlySet<C>, asked: boolean): readonly C[] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/trimesh.ts:27:export interface TrimeshShape {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/physics/trimesh.ts:36:export function trimeshDesc(shape: TrimeshShape, where: string): RAPIER.ColliderDesc {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/flights.ts:28:export function flightGeometry(tile: number, ramps: readonly RampDescriptor[], ground: number): BufferGeometry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cutaway.ts:181:export function planFade(targets: readonly Omit<CutTarget, 'when'>[], pose: CameraPose, focus: Vec3): boolean[][] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cutaway.ts:252:export function createCutaway(meshes: Pick<LevelMeshes, 'root' | 'parts'>, options: CutawayOptions = {}): Cutaway {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/fx/decals.ts:125:export function decalMaterial(): MeshBasicNodeMaterial {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/geometry/roundedBox.ts:49:export function roundedBoxGeometry(options: RoundedBoxOptions = {}): BufferGeometry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/openings.ts:76:export function boxBetween(x0: number, y0: number, z0: number, x1: number, y1: number, z1: number): BufferGeometry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/openings.ts:89:export function headsGeometry(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/openings.ts:211:export function framesGeometry(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/openings.ts:245:export function railingGeometry(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/runs.ts:32:export interface RunMeshesOptions extends LevelLooks {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/level/runs.ts:103:export function runMeshes(level: CompiledLevel, options: RunMeshesOptions): LevelMeshes {\n\n--- npm config ---\n{\n  \"name\": \"wee-fit-retreat\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"A game made with the my-3dge engine.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=24.10 <25\"\n  },\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"typecheck\": \"tsc -b tsconfig.check.json\",\n    \"lint\": \"eslint --cache --cache-location node_modules/.cache/eslint/ .\",\n    \"format\": \"prettier --write --cache .\",\n    \"check\": \"node tools/checkAll.ts\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-simd-compat\": \"0.21.0\",\n    \"@stdlib/math-base-special-cos\": \"0.3.1\",\n    \"@stdlib/math-base-special-pow\": \"0.3.1\",\n    \"@stdlib/math-base-special-sin\": \"0.3.1\",\n    \"three\": \"0.182.0\"\n  },\n  \"devDependencies\": {\n    \"@modelcontextprotocol/sdk\": \"1.32.2\",\n    \"@playwright/test\": \"1.64.1\",\n    \"@stryker-mutator/core\": \"9.6.1\",\n    \"@stryker-mutator/vitest-runner\": \"9.6.1\",\n    \"@types/node\": \"24.19.2\",\n    \"@types/three\": \"0.182.0\",\n    \"eslint\": \"9.39.5\",\n    \"eslint-plugin-jsdoc\": \"61.7.1\",\n    \"globals\": \"16.5.0\",\n    \"prettier\": \"3.9.10\",\n    \"tsx\": \"4.23.15\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.72.1\",\n    \"vite\": \"7.3.7\",\n    \"vitest\": \"4.1.12\"\n  },\n  \"allowScripts\": {\n    \"esbuild\": false\n  }\n}\n\n--- local instructions ---\n","exit_code":0,"status":"completed"}}
