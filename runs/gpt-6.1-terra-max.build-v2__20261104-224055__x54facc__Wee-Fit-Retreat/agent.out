.ts\naudio.ts\nbest.test.ts\nbest.ts\nbot.ts\ncast\nindex.html\nmain.ts\nprogramme.ts\nreplays\nscenes\nstyles.css\ntools\nview.ts\nwobble.ts\n--- engine helpers ---\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:37:export const BLOB_SHADOW = { lift: 0.0125, fadeHeight: 5, smallest: 0.35 } as const;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:40:export const BLOB_SHADOW_MATERIAL = {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:50:export function blobShadowMaterial(registry: Registry = sharedRegistry): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:58:export function blobScale(height: number): number {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:63:export interface BlobShadows {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:77:export function createBlobShadows(options: {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/geometry/roundedBox.ts:27:export interface RoundedBoxOptions {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/geometry/roundedBox.ts:49:export function roundedBoxGeometry(options: RoundedBoxOptions = {}): BufferGeometry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cameras/boost.ts:33:export function applyBoost(camera: Camera, k: number): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cameras/boost.ts:42:export interface Boosted {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cameras/boost.ts:48:export function isBoosted(camera: Camera): camera is Camera & Boosted {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cameras/boost.ts:56:export function boost(camera: PerspectiveCamera | OrthographicCamera, k: number): void {\nWee-Fit