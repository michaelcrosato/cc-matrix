x system-ui;color:#829b8d}.days{display:flex;border-bottom:1px solid #d6e4d8;margin-top:38px;gap:5px;overflow-x:auto;scrollbar-width:thin}.day-tab{flex:1;min-width:140px;text-align:left;border:0;border-bottom:3px solid transparent;background:none;padding:16px 16px 19px;color:#9aafa1}.day-tab span,.day-tab b{display:block}.day-tab span{font-size:9px;letter-spacing:.15em;font-weight:700}.day-tab b{font:17px Georgia,serif;margin-top:7px;color:#859f90}.day-tab.active{border-color:#397e6d}.day-tab.active b,.day-tab.active span{color:#286451}.hub-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,390px);gap:7%;padding-top:45px}.programme h2,.brief-card h2,.modal h2{font:normal 38px/1.1 Georgia,serif;letter-spacing:-.03em;margin:16px 0;color:var(--ink)}.section-kicker span{color:#e49a7f;margin:0 8px}.day-story{font-size:14px;line-height:1.75;color:#789387;max-width:580px;margin-bottom:26px}.activity-list{border-top:1px solid #dce8dd}.activity-row{width:100%;display:flex;align-items:center;gap:17px;text-align:left;background:transparent;border:0;border-bottom:1px solid #dce8dd;padding:20px 15px 20px 8px;color:var(--ink);border-radius:5px}.activity-row.selected{background:#e9f2e8}.activity-row.locked{opacity:.56}.activity-number{color:#9aafa3;font:14px Georgia,serif}.activity-name{flex:1;min-width:0}.activity-name b,.activity-name small{display:block}.activity-name b{font-size:14px}.activity-name small{font-size:9px;letter-spacing:.12em;color:#8ea69a;text-transform:uppercase;margin-top:7px}.row-status{font-size:10px;font-weight:700;letter-spacing:.1em;color:#548878}.brief-card{background:#fffef9;border:1px solid #e6eee4;border-radius:14px;box-shadow:0 16px 50px #28593d0b;overflow:hidden}.brief-top{display:flex;justify-content:space-between;padding:20px 24px;color:#87a397}.brief-top span:last-child{font-size:19px;color:#dc8b70}.brief-illustration{height:175px;background:#e1f0df;position:relative;overflow:hidden;display:grid;place-items:center}.brief-illustrati