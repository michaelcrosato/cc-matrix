ne/gfx/shadows.ts:84:export function shadowCasters(budget: Pick<QualityBudget, 'shadowCasters'>): number {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/shadows.ts:96:export function splitCasters(casters: number, shining: { sun: boolean; points: boolean }): Casters {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/shadows.ts:102:export function enableShadows(renderer: Pick<WebGPURenderer, 'shadowMap'>): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/shadows.ts:108:export function configurePointCaster(light: PointLight): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/shadows.ts:164:export function snapShadow(shadow: LightShadow): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/motionMetrics.ts:57:export type Found = { value: number; message: string } | undefined;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/motionMetrics.ts:66:export function motionTrack(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/motionMetrics.ts:77:export function worstPop(t: Track): Found {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/motionMetrics.ts:94:export function pops(t: Track): Found {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/motionMetrics.ts:103:export function worstSlide(t: Track): Found {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/motionMetrics.ts:125:export function footSlide(t: Track): Found {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/skyKind.ts:81:export type SkyEntry = Entry<typeof SKY_FIELDS>;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/skyKind.ts:84:export type SkySpec = {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/skyKind.ts:91:export type BackdropSpec = SkyEntry['backdrop'];\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/skyKind.ts:94:export function defineSkies(registry: Registry = sharedRegistry): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/skyKind.ts:133:export function defineSky(id: string, spec: SkySpec, registry: Registry = sharedRegistry): SkyEntry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/sky.ts:74:export { BACKDROP, BACKDROP_KINDS, bakeBackdrop } from './backdrop';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/sky.ts:75:export { defineSkies, defineSky, SKY_FIELDS, type BackdropSpec, type SkyEntry, type SkySpec } from './skyKind';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/sky.ts:168:export function createSky(scene: Scene, options: SkyOptions = {}): Sky {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/actions-check.ts:38:export function actionCheck(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/weapons.ts:74:export function weaponOut(entity: EntityData, registry: Registry = sharedRegistry): WeaponKind | null {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/weapons.ts:82:export function gunPose(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/weapons.ts:93:export function alongBarrel(barrel: Vector3, out: Quaternion): Quaternion {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/weapons.ts:103:export function muzzlePoint(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/weapons.ts:120:export function gunGeometry(kind: WeaponKind, registry: Registry = sharedRegistry): BufferGeometry | null {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/weapons.ts:164:export function createWeaponFx(options: { effects: Pick<Effects, 'burst'> }): WeaponFx {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/stage.ts:166:export function createStage(options: StageOptions): Stage {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/propLooks.ts:110:export function propLooks(registry: Registry): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/storeyCut.ts:41:export function cutPlace(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/storeyCut.ts:65:export function aboveStorey(level: CompiledLevel, storey: number, x: number, y: number, z: number): boolean {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/storeyCut.ts:73:export function planStoreys(pieces: readonly StoreyPiece[], storey: number, indoors: boolean, low = false): boolean[] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/storeyCut.ts:89:export function createStoreyCut(meshes: LevelMeshes): StoreyCut {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:53:export function moveAt(name: string | Move | MoveSpec, u = 0.5, phase: MovePhase = 'active'): MoveInput {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:58:export function strikePart(move: Move, armed: boolean): TrailName {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:65:export type StrikeBody = Pick<Humanoid, 'skeleton' | 'world' | 'build' | 'weapon'>;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:68:export type StrikeAnimator = Pick<Animator, 'body' | 'preciseHits'>;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:80:export function strikeSegment(from: StrikeBody | StrikeAnimator, part: TrailName, base: Vector3, tip: Vector3): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:127:export function measureMove(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:164:export function inArc(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:177:export function inHitShape(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/moves.ts:195:export function knockbackVelocity(from: Vector3, target: Vector3, speed: number, up = 0, out = new Vector3()): Vector3 {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/quality.ts:31:export type QualitySetting = (typeof QUALITY_SETTING_VALUES)[number];\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/quality.ts:34:export type QualityTier = Exclude<QualitySetting, 'auto'>;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/quality.ts:69:export function resolveQuality(setting: QualitySetting, touch: boolean): QualityTier {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/quality.ts:74:export function qualityBudget(setting: QualitySetting, touch: boolean): QualityBudget {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/stageFx.ts:71:export function fxKinds(registry: Registry = sharedRegistry): { bolts: string[]; telegraphs: string[] } {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/stageFx.ts:131:export function createStageFx(options: StageFxOptions = {}): StageFx {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/humanoid.ts:149:export class Humanoid implements Rig {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/idmarks.ts:26:export function marksOf(pass: IdPass, options: { max?: number; minPx?: number } = {}): Mark[] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/idmarks.ts:46:export function drawMarks(rgba: Uint8Array, width: number, height: number, marks: readonly Mark[]): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/renderer.ts:82:export type GfxCode = keyof typeof GFX_CODES;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/renderer.ts:85:export class GfxError extends Error {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/pipelines.ts:109:export function advanceFrame(renderer: WebGPURenderer): boolean {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/pipelines.ts:121:export function checkPinned(renderer: WebGPURenderer, revision: string = REVISION): string[] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/pipelines.ts:134:export function countPipelines(device: GPUDevice, options: { log?: Log } = {}): PipelineCounter {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/strike.ts:144:export function createArmState(): ArmState {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/strike.ts:176:export type ArmMotion = BodyMotion & { lead: 'L' | 'R' };\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/strike.ts:185:export function stepArm(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/strike.ts:272:export type ArmLayContext = Pick<EffectorContext, 'build' | 'armed' | 'w' | 'body'>;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/strike.ts:291:export function layArm(arm: ArmState, ctx: ArmLayContext, E: Effectors): Effectors {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/strike.ts:326:export function armBlade(arm: ArmState, rest: Vector3, E: Effectors, out: Vector3): Vector3 {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/idpass.ts:61:export type UnseenReason = 'hidden' | 'outside' | 'covered' | 'background';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/idpass.ts:138:export function idColour(n: number): number {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/idpass.ts:154:export function listDrawables(scene: Object3D, camera: Camera, options: { protagonist?: string } = {}): IdTable {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/idpass.ts:258:export function withIdScene(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/idpass.ts:285:export function decodeIds(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/bodyPlants.ts:50:export function attachPlants(animator: Animator, prefix: string, previous?: HoldPlant): BodyPlants {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/bodyPlants.ts:58:export function layPlants(animator: Animator, plants: BodyPlants, body: PlantedBody, ground: GroundProbe | null, legsHeld = 0): void { // prettier-ignore\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:50:export function blobShadowMaterial(registry: Registry = sharedRegistry): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:58:export function blobScale(height: number): number {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/blobShadow.ts:77:export function createBlobShadows(options: {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/lod.ts:61:export type CrowdBandSpec = Omit<CrowdBand, 'index'>;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/lod.ts:119:export function createCrowdLod(options: CrowdLodOptions = {}): CrowdLod {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/terrainSplat.ts:54:export function createTerrainSplat(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:97:export type LightEntry = Entry<typeof LIGHT_FIELDS>;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:138:export function defineLights(registry: Registry = sharedRegistry): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:161:export function defineLight(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:170:export function lightSources(level: Pick<CompiledLevel, 'lights'>): LightSource[] {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:175:export function flicker(time: number, phase: number, amount: number): number {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:190:export function rankSources(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:211:export function fadeOf(rank: number, cutoff: number): number {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/lights.ts:257:export function createLightPool(options: { size?: number; tiled?: boolean; registry?: Registry } = {}): LightPool {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/resolution.ts:46:export type ResolutionMode = (typeof RESOLUTION_MODES)[number];\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/resolution.ts:49:export type ResolutionSetting = 'auto' | ResolutionMode;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/resolution.ts:104:export function fitResolution(css: Size, devicePixelRatio: number, mode: ResolutionMode, cap: PixelCap = {}): Fit {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/resolution.ts:167:export function createResolution(options: ResolutionOptions): Resolution {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/resolution.ts:222:export function portraitFov(fov: number, aspect: number): number {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/resolution.ts:228:export function keepWidth(camera: Camera, aspect: number): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:59:export type PieceShape = 'limb' | 'ball' | 'eye' | 'box' | 'cone' | 'blade' | 'strip';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:111:export function restPositions(skeleton: Skeleton): Float64Array {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:136:export function compileBody(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:309:export function recolor(compiled: CompiledBody, palette: Readonly<Record<string, string>>): CompiledBody {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/anim/locomotion/planted.ts:71:export function plantedDuty(share: number, crouch = 0): number {\n--- source files ---\nREADME.md\nart.ts\naudio.ts\nbest.test.ts\nbest.ts\nbot.ts\ncast\nindex.html\nmain.ts\nprogramme.ts\nreplays\nscenes\nstyles.css\ntools\nview.ts\nwobble.ts\n--- hub protocol excerpt ---\n28:camera for each activity (the table in section 6). **Hub genre:** Sports.\n564:### In AI Hub: AI Hub Session Protocol v1, mode **ghost**\n567:`labs/game/hub/`: `session.js` (save it as `session-client.txt`), and for tests `harness.html`, `bridge.js`, `round.js` from the same\n570:Why ghost: every copy runs its own seeded round, nothing depends on a host, and each player sees the others on the neighbouring mats,\n573:**Tags** in the head, right after the client (the build injects them, section 14):\n576:<meta name=\"hub:session\" content=\"1\">\n577:<meta name=\"hub:session-players\" content=\"1-4\">\n578:<meta name=\"hub:session-mode\" content=\"ghost\">\n579:<meta name=\"hub:session-minutes\" content=\"3\">\n580:<meta name=\"hub:session-goal\" content=\"Stay the steadiest across three classes\">\n581:<meta name=\"hub:session-howto\" content=\"Lean: stick or WASD · Feet: L2 R2 or Q E · Breathe: both or Space\">\n582:<meta name=\"hub:webgpu\" content=\"required\">\n585:Goal at most 60 characters, how-to at most 80. Also `hub:type` Game, `hub:players` 1-4, `hub:source` Wii Fit.\n587:**Startup** **[tested: this shape, on the starter's one scene, passed the harness at 2, 3 (host leaving) and 4 players with the engine running in every frame]**:\n593:const AIHub = window.AIHub;\n594:const info = AIHub?.active ? await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\n596:const watchdog = info ? setTimeout(() => AIHub.ready(), 14000) : 0;   // the harness allows 20 s after hello\n598:if (info) { clearTimeout(watchdog); AIHub.ready(); }\n602:unknown query key as a setting and fails with `CORE_BAD_SETTING`, **and the harness still reports PASS**, because the client keeps\n610:  Keys: Enter or Cross answers `AIHub.answer('ready')`, Triangle or T answers `'more'`, a tap or click works too. Listen for Enter with your own\n611:  `keydown` on `window`: the harness sends a synthetic one. The card has no menus or choices, and draws numbers only from `AIHub.rng('card')`.\n613:- `start` arrives; play begins at `AIHub.time() >= 0`. Send the sim `round.go` then (scene action). On `start` also send one\n614:  `AIHub.progress({ score: 0, label: 'Breathing in' })` and one ghost message, so a slow copy still passes the harness.\n615:- During play: `AIHub.progress({ score, label })` whenever it changes (label at most 24 characters, \"Class 2 · 640\"), and every 100 ms\n616:  `AIHub.send({ t: 'g', e: classIndex, x, y, p: poseId, s: score }, { reliable: false })`. Never above 20 a second.\n618:  `engine.input.virtual.axis('game:ghosts', […])` to actors on the other mats, tinted with `info.players[i].color`, leans scrubbed by their CoB,\n620:- Finished: `AIHub.result({ score, stats, awards })` once. Stats at most six, names at most 16 characters (\"Wobble Age\", \"Best hold\", \"Breath\"),\n623:- If `engine.ready` is false (no WebGPU): `AIHub.fail('WebGPU required')`.\n625:  and quit do nothing. Pause is an overlay that never pauses the sim: Resume, volume, button icons. No dev mode. **Create + Options belongs to the hub:**\n626:  while pad button 8 is held, ignore the engine's `pause`. Storage is a fresh memory copy, handled by the client, so write nothing special for it.\n627:- Outside a session (`connect` gives `null`, or no client at all in the dev server) the game must behave exactly as it does alone.\n629:**Boot deadline, the one place performance matters.** The harness gives every copy 20 s to call `ready()`. **[tested on SwiftShader]** the starter\n659:`#3A4A55` for text. Hub seat colours are fixed: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n877:  hub/      session.ts  session-client.txt  tags.html\n882:**Key components** (plain data): `flow` (mode: front, roam, event, cutscene, results; event, phase, tick; day), `wobble` (per seat), `seat` (input per seat), `island` (tilt), `round`, `pebble`, `plaque`, `ghost`, plus one per activity. Time in whole steps, randomness from named streams, loops in `w.query` order, `Math.pow` not `**`.\n884:**The single HTML [tested: 6.7 MB, 4 s, opens from file://, client stays byte-identical].** `node x html` is engine-only, so the game carries this. The session client goes in as text, so no formatter ever touches it: the hub rejects an edited copy by SHA-256.\n911:const client = readFileSync('labs/game/hub/session-client.txt', 'utf8');\n913:writeFileSync(resolve(process.argv[2]), inlined.replace('<meta charset=\"utf-8\" />', () => `<meta charset=\"utf-8\" />\\n<script>\\n${client}</script>\\n${tags}`));\n916:Use a function as `replace`'s second argument, as here: the bundle holds `$` patterns that a string replacement would corrupt. Everything is inlined, so no CDN is needed. Run from the dev folder; write the deliverable where your TASK.md says. `npm run format` will restyle `tags.html` and this script, harmlessly **[tested: the build still passes and the client stays pristine]**; Prettier leaves the `.txt` alone.\n926:| Hub's `?aihub=…` in the query | `CORE_BAD_SETTING`, engine dead, harness still passes | Strip them; assert `__engine.ready` in every frame |\n932:| `docs/GAME-GUIDE.md` cites `labs/playground/…` | Those files are not in your workspace | Use `labs/box/`; or read the engine's GitHub repository if one is truly worth it |\n941:| Hub client through a formatter **[source]** | Hub rejects it | Keep it as `.txt`, inject at build |\n980:- **Standalone hub checks, as the hub's own test does:** press Enter, Space, Enter, Space; the client is there and inactive; `Math.random` is untouched; the screen is drawn; no errors.\n981:- **Hub harness:** serve the built file beside `harness.html`, `bridge.js`, `round.js` (Node `http` server or `python3 -m http.server 0 --bind 127.0.0.1`, read the port it prints, confirm the page is your game, stop only that PID: never `pkill`, `killall` or `fuser -k`). Run `harness.html?game=<file>&players=N&latency=150&jitter=50&loss=5&auto=1&play=8000` for N = 2, 3, 4, then `players=3&…&scenario=host-leave`. Pass means `window.__hubCheck.pass`, with `body[data-complete=\"true\"]` at the end. **Also assert in each frame** `__engine.ready === true`, zero engine errors, a `ghost` entity at 2 players; no console line starting `[AIHub]`; and that the pasted client's SHA-256 from banner to last line matches `529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a` (client 1.4.0; compare what you fetched first, the hub may have moved on).\n982:- **By hand in the harness:** run it once without `auto` at 2 players: its frames are your players on this computer, and clicking a frame gives it the keyboard. New round, Time up, Remove player. Drive it by script and read the state to see the card, ghosts and results; one screenshot.\n992:1. **Skeleton (first hour's job).** Workspace, one-file build, hub client and tags, `game:round` with one mat, harness passing with the engine truly running, `verify.mjs` skeleton.\n1000:9. **Together.** Group Class; hub ghosts, own card, full round.\n1005:**Cut line, if and only if you run out of budget.** Cut whole things and re-flow `days.ts`, leaving no trace (no greyed-out rows, no mentions), in this order: Great Tilt step 3 → Expert variants and outfits → Hoop Patrol → Reps Hall → Island Jog's race (keep the walk) → Cliff Plunge → Step Class. Never cut: Morning Check, Pose Class, Still Pond, The Line, Sand Garden, Paddle Glide, Great Tilt steps 1, 2, 4 and 5, Group Class, hub ghost round, attract, Dev Mode, About.\n1025:Answers already decided: Plan: the name this file has in your folder. Genre and Perspective as in section 1. Tech: my-3dge at its pinned commit, three.js r182 on WebGPU, Rapier 0.21, Vite, TypeScript. Art: the engine's native toon puppets and generators with new retreat assets. Animation: the engine's clip layer and humanoid with a new readable clip set scrubbed from the sim. Audio: tracker songs, `defineSfx` effects, gibberish syllable voices, all code, music at 10%. Online: AI Hub Session Protocol v1, ghost; same-screen Group Class on its own. Environment and Model as your TASK.md gives them. Usage: \"added on import\".\n1027:Hub catalogue suggestions: type `Game`; genre `Sports`; source `Wii Fit`; series empty (the source is its own franchise); players `1–4`; controls \"Lean: left stick, WASD or mouse · Feet: L2 R2, Q E or mouse buttons · Breathe: both\"; tags from `3d`, `third-person`, `comedy`, `arcade`, `sports`, `story`. Tagline idea: \"Stand still. It is harder than it looks.\"\n1029:**Credits must include:** my-3dge (MIT), three.js (MIT), Rapier (Apache-2.0), @stdlib (Apache-2.0); the AI Hub session client. Animation clips by what you actually copied: Mesh2Motion and Quaternius Universal Animation Library (CC0; credit anyway); **100STYLE dataset, Mason, Starke and Komura, 2022, CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/), converted to key poses: required credit with a link and a note of changes** if you use any `STYLE100*` clip; CMU Graphics Lab Motion Capture Database if you use any `CMU` clip (terms in `data/anim/LICENSES/CMU.txt`).\n","exit_code":0,"status":"completed"}}
