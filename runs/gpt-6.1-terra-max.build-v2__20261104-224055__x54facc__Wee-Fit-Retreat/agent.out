{"type":"item.started","item":{"id":"item_724","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '--- animation ---'; sed -n '1,180p' engine/anim/humanoid.ts; printf '%s\\\\n' '--- puppet API ---'; sed -n '1,160p' engine/gfx/puppets/actors.ts; printf '%s\\\\n' '--- balance and sessions ---'; sed -n '1,240p' labs/game/wobble.ts; printf '%s\\\\n' '--- index/build ---'; cat labs/game/index.html; sed -n '1,160p' labs/game/tools/bundle.mjs; printf '%s\\\\n' '--- selected source lines ---'; rg -n 'render\\\\(|session-art|about|function openGame|function finish|function frame|lastInput|modal|save\\\\(' labs/game/{main,view}.ts; printf '%s\\\\n' '--- hub urls ---'; curl -fsSL https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js -o /tmp/wee-fit-hub-session.js && wc -c /tmp/wee-fit-hub-session.js && sha256sum /tmp/wee-fit-hub-session.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_724","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '--- animation ---'; sed -n '1,180p' engine/anim/humanoid.ts; printf '%s\\\\n' '--- puppet API ---'; sed -n '1,160p' engine/gfx/puppets/actors.ts; printf '%s\\\\n' '--- balance and sessions ---'; sed -n '1,240p' labs/game/wobble.ts; printf '%s\\\\n' '--- index/build ---'; cat labs/game/index.html; sed -n '1,160p' labs/game/tools/bundle.mjs; printf '%s\\\\n' '--- selected source lines ---'; rg -n 'render\\\\(|session-art|about|function openGame|function finish|function frame|lastInput|modal|save\\\\(' labs/game/{main,view}.ts; printf '%s\\\\n' '--- hub urls ---'; curl -fsSL https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js -o /tmp/wee-fit-hub-session.js && wc -c /tmp/wee-fit-hub-session.js && sha256sum /tmp/wee-fit-hub-session.js\"","aggregated_output":"--- animation ---\n/**\n * @file The procedural humanoid (PLAN.md WP 3.6, §5.2; I-09): my-3d2dge's `Humanoid` on the rotation skeleton.\n * `step(input)` eases the state toward the input at a fixed step (humanoidRates.ts): the weights, the gait's phase,\n * the clocks. `solve()` runs the effector stage (poses.ts `effectorStage`: locomotion.ts's gait, then the pose layers\n * in order) and the solve stage (authoring.ts: the spine from lean and twist, the arms and legs through `twoBoneRot`\n * with the old hints as poles, the feet, the weapon hand), writing `pose` and its FK, `world`; `update` does both.\n *\n * Invariants:\n * - `step` is the sim's part: `state` is plain numbers (WP 3.7 hashes and captures it). `solve` reads only `state`,\n *   `position` and `yaw`, and starts from a cleared pose, so it may run in the presentation, as often as wanted, with\n *   the same result.\n * - A fixed step, `dt` (`SIM_DT` by default). The breathing phase and the blinks come from the entity's stream\n *   (`rng`); `clock` sets the phase instead (the differential tests inject the reference rig's).\n * - `effectors` are rig-local metres before `size`, in the model frame (+Z forward, +Y up), placed by the root:\n *   `rootRot` is the yaw (times the knockdown's turn), `rootPos` carries the pelvis's offset (`rootOffset`).\n * - Where the joints land (humanoid.test.ts checks it against the reference vectors): on the old rig's points (`hipC`,\n *   `shC`, `head`, the shoulders, elbows, wrists, hips, the blade, the sole under each ankle); the old leg had no\n *   ankle, so where a planted foot lies flat or its heel lifts (authoring.ts `solveLeg`) the knee and the sole move,\n *   3 mm on average and 2 cm at worst; elsewhere the joints match to float32 rounding.\n * - The removed view hacks (`_cheat`, `_pitch`, `_camSide`) have no counterpart: the camera never feeds animation.\n *   What the view shows of the movement (`shown`, WP 13.10) is presentation, never stepped or saved; `stance()` and\n *   `treadmill()` tell the foot plant's locks when the feet stand and how the ground moves under them.\n * - A move plays through `input.body` (WP 6.1): `step` steps its arm path (strike.ts, `state.arm`), the effector\n *   stage lays it, a spin turns the root. A swing's start comes from the effector stage of the state before the step,\n *   never from a pose, so posing or not leaves the state as it is. A body motion given instead is taken as it is.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:1803-1871` (`update`, the state) and `:1917-1994` (`_pose`; the\n * knockdown's rigid turn at `:1989-1993`, as a root rotation). Squash, hair and cape are secondary motion (WP 6.2).\n *\n * @example\n * import { Vector3 } from '../core/math';\n * import { Rng } from '../core/rng';\n * import { jointPosition } from './fk';\n * const hero = new Humanoid({ build: 'build:heroic', weapon: 'sword', rng: new Rng(7) });\n * for (let i = 0; i < 60; i++) hero.update({ velocity: new Vector3(0, 0, 5), position: new Vector3(0, 0, i / 12) });\n * hero.state.weights.speed; // 1: walking at its reference speed\n * jointPosition(hero.world, 'head').y; // ≈ 1.6: the base of the skull\n * hero.update({ body: { move: 'move:slash', phase: 'active', u: 0.5 } }).state.arm.weight; // 0.5: a strike begins\n * @see engine/anim/humanoid.test.ts\n */\nimport { log as engineLog, type Log } from '../core/log';\nimport { approach, MathUtils, Quaternion, Vector3 } from '../core/math';\nimport { Rng } from '../core/rng';\nimport { SIM_DT } from '../core/time';\nimport { B, holdAlong, relaxHand, SIDES, sideSign, solveArm, solveLeg, solveSpine, type Rig, type LimbSide } from './authoring'; // prettier-ignore\nimport { getBuild, type Build } from './builds';\nimport { createWorldPose, forwardKinematics, type WorldPose } from './fk';\nimport { crouchShare, gaitKnee, gaitStance, strideShare, type BodyMotion, type EffectorContext, type HumanoidWeights } from './locomotion'; // prettier-ignore\nimport { GAIT } from './locomotion/gait';\nimport { onFeet } from './locomotion/locks';\nimport { plantedEase, plantedMove } from './locomotion/planted';\nimport { createShown, type ShownMovement } from './locomotion/shown';\nimport { Pose } from './pose';\nimport type { MoveInput } from './moves-data';\nimport { poseName, stanceName, weaponName, type PoseName, type StanceName, type Weapon } from './poseNames';\nimport { createEffectors, effectorStage, type Effectors } from './poses';\nimport { createSkeleton, jointIndex, type Skeleton } from './skeleton';\nimport { KNOCKDOWN, STEP } from './humanoidRates';\nimport { createArmState, stepArm, type ArmState } from './strike';\n\n/** The poses with a weight of their own (`die` and `down` drive the down weight instead). */\nconst HELD = ['cheer', 'cast', 'guard', 'kneel', 'crouch', 'wave', 'hips', 'block'] as const;\n\n/** What a humanoid is made from. */\nexport interface HumanoidOptions {\n  /** Its build, or the build's id; `build:chibi` by default. */\n  build?: Build | string;\n  /** What its right hand holds; `'none'` by default. */\n  weapon?: Weapon;\n  /** The entity's own stream (in a scene, `w.rng.entity(id, 'anim')`): the breathing phase and the blinks. Seed 0 by default. */\n  rng?: Rng;\n  /** The breathing clock's start, seconds; drawn from `rng` (0–10 s) by default. */\n  clock?: number;\n  /** The fixed step, seconds; `SIM_DT` by default. */\n  dt?: number;\n  /** Where it reports a misspelt pose, stance or weapon; the engine's log by default. */\n  log?: Log;\n}\n\n/** What a humanoid is told each step; every field is optional. */\nexport interface HumanoidInput {\n  /** The ground point under it, world metres; kept from the last step when absent. */\n  position?: Vector3;\n  /** Its velocity, m/s: the horizontal part drives the gait, the vertical the climb. */\n  velocity?: Vector3;\n  /** Its heading, radians: forward is (sin yaw, 0, cos yaw). Kept from the last step when absent. */\n  yaw?: number;\n  /** 0–1: run in place at this share of the build's `speedRef` (a treadmill). */\n  run?: number;\n  /** Dashing. */\n  dash?: boolean;\n  /** Hurt: a flinch. */\n  hurt?: boolean;\n  /** Airborne: the legs tuck. */\n  air?: boolean;\n  /** Climbing a ladder, hand over hand, at the vertical velocity. */\n  climb?: boolean;\n  /** The weapon hand held out along the aim. */\n  point?: boolean;\n  /** Radians above level (+) or below (−) while pointing. */\n  aim?: number;\n  /** A held pose (`POSES`). */\n  pose?: PoseName;\n  /** A stance held while moving (`STANCES`). */\n  stance?: StanceName;\n  /** 0–1: knocked flat, overriding the `die` and `down` poses. */\n  down?: number;\n  /**\n   * A move playing (WP 6.1): the move at its phase and share (`moveAt`, `Attack.body`), whose arm path and body\n   * motion the humanoid plays; or a body motion's targets alone, and the foot that leads a lunge.\n   */\n  body?: MoveInput | (Partial<BodyMotion> & { lead?: LimbSide });\n}\n\n/** The humanoid's state: plain numbers, what the sim keeps of it. */\nexport interface HumanoidState {\n  /** Seconds on the breathing clock. */\n  clock: number;\n  /** The gait's phase, radians: a step every π. */\n  phase: number;\n  /** The movement direction relative to the facing: forward share. */\n  moveF: number;\n  /** The movement direction relative to the facing: rightward share. */\n  moveR: number;\n  /** The hand-over-hand phase on a ladder, radians. */\n  climbPhase: number;\n  /** Seconds into the die pose; 0 when not dying. */\n  dieTime: number;\n  /** The aim now, radians. */\n  aim: number;\n  /** Seconds to the next blink; the eyes are shut while it is below 0. */\n  blink: number;\n  /** The foot that steps into a lunge: −1 left, 1 right. */\n  lead: number;\n  /** The weights, 0–1 each. */\n  weights: HumanoidWeights;\n  /** A move's body motion now. */\n  body: BodyMotion;\n  /** A move's arm path now (strike.ts). */\n  arm: ArmState;\n}\n\nconst ZERO = new Vector3();\nconst [UP, X_AXIS] = [new Vector3(0, 1, 0), new Vector3(1, 0, 0)];\n/** Scratch objects. */\nconst [v, yaw, knock] = [new Vector3(), new Quaternion(), new Quaternion()];\n\n/** A procedural humanoid: state, effectors, pose. See the file comment. */\nexport class Humanoid implements Rig {\n  /** Its build. */\n  readonly build: Build;\n  /** Its skeleton, made from the build. */\n  readonly skeleton: Skeleton;\n  /** What its right hand holds. */\n  readonly weapon: Weapon;\n  /** The fixed step, seconds. */\n  readonly dt: number;\n  /** The state `step` eases. */\n  readonly state: HumanoidState;\n  /** The ground point under it, world metres. */\n  readonly position = new Vector3();\n  /** Its heading, radians. */\n  yaw = 0;\n  /** The pose the last `solve` wrote. */\n  readonly pose = new Pose();\n  /** The pose's FK. */\n  readonly world: WorldPose = createWorldPose();\n  /** The last effector stage's targets. */\n  readonly effectors: Effectors = createEffectors();\n  /** Where the root sits in the rig frame, metres after `size`: the pelvis's target less its rest offset. */\n  readonly rootOffset = new Vector3();\n  /**\n   * What the view shows beyond the sim's state (WP 13.10, engine/anim/locomotion/shown.ts): the movement's crouch,\n   * slide, air, landing and lean, which the view eases (locomotion/motion.ts) and sets before each pose. Presentation\n   * only: never stepped or saved, so no hash sees it.\n   */\n  readonly shown: ShownMovement = createShown();\n  readonly #rng: Rng;\n  /** The last step's `run`: running in place. */\n  #run = 0;\n--- puppet API ---\n/**\n * @file Actors on the stage (PLAN.md WP 3.10, §6.4's view; I-21): every actor with an animator (engine/sim/actors.ts:\n * an entity with the components `actor` and `animator`) drawn as a puppet (engine/gfx/puppets/draw.ts) of the neutral\n * humanoid (`ACTOR_BODY`) or the body its component `puppet` names (`body:mannequin`, WP 8.9), in its animator's build,\n * posed every frame by its animator's presentation half (engine/anim/character.ts `pose`) at the frame's alpha; an\n * actor with clips (`clips`, engine/sim/actorClips.ts) has its clip layer laid over the body, loaded from the same data\n * (a `ClipLayerPool` of the view's own, engine/anim/clip/clipsets.ts). The stage (engine/gfx/stage.ts) draws these.\n *\n * `capture(entities, dt, queries)` after each sim step keeps each actor's last two places (feet and heading) and its\n * animator's data; `draw(alpha)` poses each puppet `alpha` of the way from the one before to the last. `player()` is\n * the first player actor (in id order) as the last draw put it: its feet and, with a puppet, its skeleton, world pose\n * and eye (the head socket, engine/gfx/cameras/first.ts's `eyePoint`), which the cameras follow (engine/app/view.ts).\n * `firstPerson(frame)` draws the player for a first-person camera's frame (engine/gfx/viewmodel/body.ts, WP 13.12:\n * his body hidden, its shadow kept, his arms posed against it by a lens of their own), or whole for null. `trails()` is\n * each puppet's trail as its last pose sampled it (WP 6.7, oldest first), which the stage's effects draw as ribbons.\n * WP 13.20: the weapon an actor has out stands in its right hand while its hold holds a gun (`carried`, `muzzle`).\n * WP 10.2: a `ragdoll` (engine/sim/ragdolls.ts) lays its parts on the bones, faded in and out (`layRagdoll`).\n *\n * WP 6.2 in the box (WP 7.8): an actor's `reactions` (engine/sim/reactions.ts) are a `Reactions` layer on its puppet's\n * animator, loaded at every pose (its flinch bends its spine; a body down on its face is drawn so), its `actions` (WP\n * 13.11, engine/sim/actorActions.ts) an `Actions` layer on its clip layer, its `secondary` a `Secondary` layer whose\n * chains hang under the puppet (engine/gfx/puppets/chains.ts: `actor#<id>/cape`…), and its `post` slot ends with a\n * `FootPlant` (engine/anim/footPlant.ts) on the ground the sim's `queries` find, faded out as far as its clips hold its\n * legs (clipsets.ts `legsHeld`). WP 13.10: an actor's movement (`motion`) shows on its body (motion.ts `MovementPose`)\n * and locks its feet as `plantsFeet` lets it, laid as the feel kit's (anim/bodyPlants.ts); its layers: actorLayers.ts.\n *\n * Invariants: presentation only (doctrine: WebGPU only): its animators and their layers are its own, loaded from the\n * sim's data at every pose and never writing it, so drawing, culling or not drawing never changes the hash (the\n * animator's own invariant, engine/anim/character.test.ts); one puppet per actor, its layers made again when its\n * animator or their components do; every object it draws is under `root`, and a puppet given up waits as a spare for\n * the next actor of its build and body (`createActorPuppets` says why). A puppet is a skinned mesh of two draw calls:\n * right for heroes and a few foes; crowds draw through instanced batches (WP 5.4).\n *\n * @example\n * // const actors = createActorPuppets({ materials: library }); stage.scene.add(actors.root);\n * // const drawn = actors.capture(world.query('actor'), world.dt); // the ids drawn as puppets\n * // actors.draw(0.5);\n * // actors.player()?.eye; // where a first-person camera sits\n * @see engine/gfx/puppets/actors.test.ts\n */\nimport { Group } from 'three/webgpu';\nimport { layPlants } from '../../anim/bodyPlants';\nimport type { ActionsState } from '../../anim/actions';\nimport { getBuild } from '../../anim/builds';\nimport { AnimatorPool, type Animator, type AnimatorData, type TrailSample } from '../../anim/character';\nimport { ClipLayerPool, legsHeld, type ClipsData } from '../../anim/clip/clipsets';\nimport type { WorldPose } from '../../anim/fk';\nimport { queryGround } from '../../anim/footPlant';\nimport type { GroundProbe } from '../../anim/ik';\nimport { MovementPose, type BodyView, type MotionView } from '../../anim/locomotion/motion';\nimport { blendRagdollPoses, RAGDOLL_FADE, type RagdollLayer } from '../../anim/ragdoll';\nimport { Reactions, type ReactionState } from '../../anim/reactions';\nimport { hullOf, rideOf, type TraversalView } from '../../anim/traversal/contacts';\nimport { LookPose, type Look } from '../../anim/traversal/hold';\nimport { TraversalPose } from '../../anim/traversal/pose';\nimport { Secondary } from '../../anim/secondary';\nimport type { Skeleton } from '../../anim/skeleton';\nimport { lerpAng, Vector3 } from '../../core/math';\nimport { registry as sharedRegistry, type Registry } from '../../core/registry';\nimport type { QueryView } from '../../sim/queryView';\nimport type { SecondaryComponent } from '../../sim/reactions';\nimport type { EntityData } from '../../sim/state';\nimport { eyePoint } from '../cameras/first';\nimport type { Vec3 } from '../cameras/pose';\nimport { RUNG } from '../stageRides';\nimport type { Warmup } from '../warmup';\nimport { createViewmodel, type FirstPersonParts, type Viewmodel, type ViewmodelFrame } from '../viewmodel/body';\nimport { createViewmodelLook } from '../viewmodel/material';\nimport { gunPose, muzzlePoint, weaponOut, type HeldGun } from '../weapons';\nimport { dropLayers, layersFor, type Held, type HeldRagdoll, type Layers, type Place } from './actorLayers';\nimport { compileBody } from './compile';\nimport { createPuppet, puppetMaterials, type Puppet, type PuppetMaterials } from './draw';\n\n/** What the view reads of an actor's component `ragdoll` (engine/sim/ragdolls.ts). */\ntype RagdollView = { poses: number[]; since: number; rise: number };\n\n/** An actor's ragdoll as the view keeps it after a step: its poses then and now, its age and how long it has risen. */\nfunction heldRagdoll(now: RagdollView | undefined, last: HeldRagdoll | null): HeldRagdoll | null {\n  if (!now || now.poses.length === 0) return null;\n  const same = last !== null && last.since === now.since; // a new hand-off starts afresh\n  const rising = now.rise < 0 ? -1 : same && last.rising >= 0 ? last.rising + 1 : 0;\n  return { before: same ? last.after : [...now.poses], after: [...now.poses], since: now.since, age: same ? last.age + 1 : 0, rising }; // prettier-ignore\n}\n\n/**\n * Lays `ragdoll` on its layer `alpha` of the way through the step, between its last two steps' poses\n * (engine/anim/ragdoll.ts `blendRagdollPoses`): faded in over `RAGDOLL_FADE.in` from the hand-off, out over\n * `RAGDOLL_FADE.out` as it gets up; no ragdoll, no weight.\n */\nfunction layRagdoll(layer: RagdollLayer, ragdoll: HeldRagdoll | null, alpha: number, dt: number): void {\n  if (!ragdoll) {\n    [layer.weight, layer.poses.length] = [0, 0];\n    return;\n  }\n  blendRagdollPoses(ragdoll.before, ragdoll.after, alpha, layer.poses);\n  const rising = ragdoll.rising >= 0;\n  const t = ((rising ? ragdoll.rising : ragdoll.age) + alpha) * dt;\n  layer.weight = rising ? Math.max(0, 1 - t / RAGDOLL_FADE.out) : Math.min(1, t / RAGDOLL_FADE.in);\n}\n\n/** The body every animated actor wears (engine/gfx/puppets/bodies/humanoid.ts). */\nexport const ACTOR_BODY = 'body:humanoid';\n\n/** A puppet's part of the warm-up's key: its build, and its body when not `ACTOR_BODY`. */\nconst worn = (build: string, body = ACTOR_BODY) => (body === ACTOR_BODY ? build : `${build}+${body}`);\n\n/** The player actor as the last draw put it. */\nexport interface PlayerView {\n  readonly id: number;\n  /** Its feet, m. */\n  readonly feet: Vec3;\n  /** With a puppet: its skeleton and world pose, and its eye (the head socket), m. */\n  readonly posed: { readonly skeleton: Skeleton; readonly world: WorldPose; readonly eye: Vec3 } | null;\n}\n\n/** Actors drawn as puppets (see the file comment). */\nexport interface ActorPuppets {\n  /** Every puppet, under one group. */\n  readonly root: Group;\n  /** The puppets, by entity id: each `actor#<id>` with `userData.entity`; the player's `userData.protagonist`, \"the hero\" to engine/gfx/idpass.ts. */ // prettier-ignore\n  readonly puppets: ReadonlyMap<number, Puppet>;\n  /**\n   * Reads the actors after a sim step (the sim's step `dt`, s) and the sim's read-only `queries`, whose ground the feet\n   * stand on (null without physics: a flat floor at each actor's feet); returns the ids it draws as puppets.\n   */\n  capture(entities: Iterable<EntityData>, dt?: number, queries?: QueryView | null): ReadonlySet<number>;\n  /** Poses every puppet `alpha` (0 to 1) of the way from its place a step ago to its last. */\n  draw(alpha: number): void;\n  /** The first player actor at the last draw, or null. */\n  player(): PlayerView | null;\n  /** Whether the last capture held a player actor. */\n  hasPlayer(): boolean;\n  /** Each puppet's trail as its last pose sampled it, by entity id (its animator's: oldest first, empty for none). */\n  trails(): ReadonlyMap<number, readonly TrailSample[]>;\n  /** The view's layers on each puppet's animator, by entity id: its `Reactions` and `Secondary`, when it has them, and its ragdoll's. */ // prettier-ignore\n  layers(): ReadonlyMap<number, { readonly reactions: Reactions | null; readonly secondary: Secondary | null; readonly ragdoll: RagdollLayer }>; // prettier-ignore\n  /** Points actor `id`'s head, and its gun, along `look` from the next draw (the page gives the player's); null: none. */\n  look(id: number, look: Look | null): void;\n  /**\n   * The guns in the actors' hands as the last draw put them (engine/gfx/weapons.ts `weaponOut`, `gunPose`), by entity\n   * id, but the one first person draws in its arms: what the stage's props draw.\n   */\n  carried(): ReadonlyMap<number, HeldGun>;\n  /** Where actor `id`'s shots leave its gun now (world, m; first person's as its lens draws it), or null: none in hand. */\n  muzzle(id: number): Vector3 | null;\n  /** Draws the player for a first-person camera's `frame`, or whole with null (see the file comment). */\n  firstPerson(frame: ViewmodelFrame | null): FirstPersonParts;\n  /** Registers the puppets with `warmup`, and their builds with its shader key. */\n  register(warmup: Pick<Warmup, 'register' | 'keyPart'>): { dispose(): void };\n  /** Frees the puppets' geometries. */\n  dispose(): void;\n}\n\n/**\n * Draws actors as puppets (see the file comment); `registry` holds the bodies and gets the puppets' materials.\n *\n * Spares: a puppet an actor gives up (it despawned, a restart read the world afresh, its build changed) leaves `root`\n * and waits, shown whole, for the next actor of the same build and body, who wears it; only `dispose` frees them. So a\n * restart or a respawn makes no new skinned mesh: r182 names a skinned mesh's bone buffer in its shader, so a new one\n * would build its shadow pipeline in a drawn frame after the warm-up (found by the playground, PLAN.md WP 13.1).\n--- balance and sessions ---\n/** @file Deterministic fixed-step balance and activity simulation. */\n\nimport type { Activity } from './programme';\n\nexport type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nexport const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nexport type Input = { x: number; y: number; gentle: boolean };\nexport type Foot = 'left' | 'right' | 'both';\nexport type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nexport type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\n\nconst clamp = (value: number, minimum: number, maximum: number) => Math.max(minimum, Math.min(maximum, value));\nconst approach = (value: number, target: number, amount: number) => value + clamp(target - value, -amount, amount);\n\nexport function createBalance(): Balance {\n  return { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, time: 0, calm: 0, outside: 0, recovering: 0, falls: 0 };\n}\n\nexport function createSession(activity: Activity, seed = 1): Session {\n  return { activity, balance: createBalance(), time: 0, scoreSum: 0, samples: 0, hits: 0, attempts: 0, foot: null, lastFoot: null, cue: 'left', actionFlash: 0, seed, finished: false, score: 0 };\n}\n\nexport function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\n  balance.time += dt;\n  const length = Math.hypot(input.x, input.y);\n  const scale = (length > 1 ? 1 / length : 1) * settings.reach * (input.gentle ? 0.4 : 1);\n  balance.targetX = approach(balance.targetX, input.x * scale, 4 * dt);\n  balance.targetY = approach(balance.targetY, input.y * scale, 4 * dt);\n  const quiet = Math.hypot(balance.vx, balance.vy) < 0.17 && length < 0.2;\n  balance.calm = clamp(balance.calm + (quiet ? dt * 0.15 : -dt * 0.3), 0, 1);\n  if (balance.recovering > 0) {\n    balance.recovering -= dt;\n    balance.x *= Math.exp(-5 * dt); balance.y *= Math.exp(-5 * dt);\n    balance.vx = 0; balance.vy = 0;\n    return;\n  }\n  const noise = settings.noise * (1 - settings.calmEffect * balance.calm);\n  const phase = balance.time * settings.noiseRate * Math.PI * 2;\n  const nx = Math.sin(phase + seed * 1.71) * 0.65 + Math.sin(phase * 1.73 + seed) * 0.35;\n  const ny = Math.sin(phase * 0.83 + seed * 2.13) * 0.65 + Math.sin(phase * 1.47 + seed * 0.8) * 0.35;\n  balance.vx += (settings.gain * (balance.targetX - balance.x) + settings.instability * balance.x + noise * nx) * dt;\n  balance.vy += (settings.gain * (balance.targetY - balance.y) + settings.instability * balance.y + noise * ny) * dt;\n  balance.vx *= Math.exp(-settings.damping * dt); balance.vy *= Math.exp(-settings.damping * dt);\n  balance.x += balance.vx * dt; balance.y += balance.vy * dt;\n  balance.outside = Math.hypot(balance.x, balance.y) > 1 ? balance.outside + 1 : 0;\n  if (balance.outside >= 6) { balance.falls++; balance.outside = 0; balance.recovering = 1; }\n}\n\nexport function targetFor(session: Session): { x: number; y: number; label: string } {\n  const time = session.time;\n  const kind = session.activity.kind;\n  if (kind === 'pond') return { x: 0, y: 0, label: 'Breathe in. Breathe out.' };\n  if (kind === 'line' || kind === 'reps' || kind === 'step' || kind === 'group' || kind === 'jog') return { x: Math.sin(time * 0.28) * (kind === 'line' ? 0.12 : 0.2), y: 0, label: 'Find your centre' };\n  if (kind === 'hoop') return { x: Math.sin(time * 1.35) * 0.44, y: Math.cos(time * 1.35) * 0.44, label: 'Follow the hoop' };\n  if (kind === 'paddle') return { x: Math.sin(time * 0.38) * 0.56, y: 0.12, label: 'Steer through the buoys' };\n  if (kind === 'sand') { const index = Math.floor(time / 12); return { x: [0.48, -0.48, 0.18, -0.32, 0][index % 5], y: [-0.25, 0.25, 0.48, -0.42, 0][index % 5], label: `Garden ${Math.min(5, index + 1)} of 5` }; }\n  if (kind === 'finale') { const index = Math.floor(time / 18); return { x: Math.sin(time * 0.35) * 0.48, y: Math.cos(time * 0.21) * 0.32, label: ['Steady the crowd', 'Hold the island', 'Help the carts', 'Find the fulcrum', 'Wait for the sunrise'][Math.min(index, 4)] }; }\n  if (kind === 'pose') { const index = Math.floor(time / 15); return { x: [0, 0.35, -0.35][index % 3], y: [0, -0.28, 0.22][index % 3], label: ['Find your centre', 'Hold the shape', 'A little longer'][index % 3] }; }\n  if (kind === 'cliff') return { x: Math.sin(time * 0.28) * 0.35, y: -0.3, label: 'Find your diving line' };\n  const index = Math.floor(time / 6);\n  return { x: [0, -0.38, 0.38, 0, 0][index % 5], y: [0, 0, 0, -0.38, 0.38][index % 5], label: ['Find your centre', 'Lean left', 'Lean right', 'Lean forward', 'Lean back'][index % 5] };\n}\n\nexport function action(session: Session, foot: Foot): boolean {\n  if (session.finished) return false;\n  session.foot = foot; session.attempts++; session.actionFlash = 0.5;\n  const kind = session.activity.kind;\n  const beat = Math.abs((session.time % 1.2) - 0.6) < 0.3;\n  const matched = kind === 'reps' || kind === 'cliff' ? foot === 'both' : foot !== 'both' && foot !== session.lastFoot;\n  const good = matched && (kind === 'step' || kind === 'reps' ? beat : true);\n  if (good) session.hits++;\n  if (foot !== 'both') session.lastFoot = foot;\n  session.cue = session.cue === 'left' ? 'right' : 'left';\n  return good;\n}\n\nexport function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n  if (session.finished) return;\n  session.time += dt;\n  stepBalance(session.balance, input, settings, dt, session.seed);\n  session.actionFlash = Math.max(0, session.actionFlash - dt);\n  const target = targetFor(session);\n  const distance = Math.hypot(session.balance.x - target.x, session.balance.y - target.y);\n  const calmBonus = session.activity.kind === 'pond' ? session.balance.calm * 0.15 : 0;\n  session.scoreSum += clamp(1 - distance * 0.8 + calmBonus, 0, 1);\n  session.samples++;\n  if (session.time >= session.activity.duration) {\n    const movement = session.scoreSum / Math.max(1, session.samples);\n    const actionKind = ['reps', 'step', 'line', 'paddle', 'cliff', 'jog', 'group'].includes(session.activity.kind);\n    const expected = session.activity.duration / 2.5;\n    const actionScore = clamp(session.hits / expected, 0, 1);\n    session.score = Math.round(clamp((actionKind ? movement * 0.7 + actionScore * 0.3 : movement) - session.balance.falls * 0.025, 0, 1) * 1000);\n    session.finished = true;\n  }\n}\n--- index/build ---\n<!doctype html>\n<!-- @file Entry point for the Wee Fit Retreat game. -->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"theme-color\" content=\"#b8e7e1\" />\n    <meta name=\"description\" content=\"A tiny island wellness retreat with an unusually concerned balance scale.\" />\n    <title>Wee Fit Retreat</title>\n  </head>\n  <body>\n    <main id=\"app\"></main>\n    <script type=\"module\" src=\"./main.ts\"></script>\n  </body>\n</html>\n/** @file Packages the game as one portable HTML file. */\nimport { writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nimport { build } from 'vite';\n\nconst root = process.cwd();\nconst result = await build({ root, configFile: false, logLevel: 'warn', base: './', build: { write: false, modulePreload: false, cssCodeSplit: false, rollupOptions: { input: { game: join(root, 'labs/game/index.html') }, output: { inlineDynamicImports: true } } } });\nlet html = '';\nconst files = {};\nfor (const entry of (Array.isArray(result) ? result : [result]).flatMap((output) => output.output)) {\n  const text = entry.type === 'chunk' ? entry.code : typeof entry.source === 'string' ? entry.source : new TextDecoder().decode(entry.source);\n  if (entry.fileName.endsWith('.html')) html = text;\n  else files[entry.fileName] = text;\n}\nfunction contents(reference) {\n  const name = Object.keys(files).find((file) => reference.endsWith(file));\n  if (!name) throw new Error(`Missing build asset: ${reference}`);\n  return files[name];\n}\nhtml = html.replace(/<script type=\"module\" crossorigin src=\"([^\"]+)\"><\\/script>|<link rel=\"stylesheet\" crossorigin href=\"([^\"]+)\">/g, (_tag, script, style) => style ? `<style>${contents(style)}</style>` : `<script type=\"module\">${contents(script).replaceAll('</script', '<\\\\/script')}</script>`);\nif (!html || /(?:src|href)=\"\\.\\/assets\\//.test(html)) throw new Error('Build is not self-contained');\nwriteFileSync(resolve(process.argv[2]), html);\n--- selected source lines ---\nlabs/game/main.ts:6:import { welcomeView, hubView, gameView, resultView, modalView } from './view';\nlabs/game/main.ts:9:type Modal = 'settings' | 'about' | 'pause' | 'touch' | null;\nlabs/game/main.ts:24:let modal: Modal = null;\nlabs/game/main.ts:29:let lastInput = performance.now();\nlabs/game/main.ts:33:let lastInputType: 'keyboard' | 'controller' = 'keyboard';\nlabs/game/main.ts:57:function render(): void {\nlabs/game/main.ts:60:  const content = screen === 'welcome' ? welcomeView(isTouchOnly()) : screen === 'hub' ? hubView(dayIndex, activityIndex, save.unlocked, save.scores) : screen === 'playing' && session ? gameView(session, attract, lastInputType) : session ? resultView(session) : '';\nlabs/game/main.ts:61:  root.innerHTML = content + (modal ? modalView(modal, save.preferences) : '');\nlabs/game/main.ts:63:  if (modal) root.querySelector<HTMLElement>('.modal button, .modal input')?.focus();\nlabs/game/main.ts:65:function openGame(preview = false): void {\nlabs/game/main.ts:66:  if (!preview && isTouchOnly()) { modal = 'touch'; render(); return; }\nlabs/game/main.ts:68:  attract = preview; screen = 'playing'; modal = null; lastFrame = 0; accumulator = 0;\nlabs/game/main.ts:69:  keys.clear(); render();\nlabs/game/main.ts:71:function finish(): void {\nlabs/game/main.ts:73:  if (attract) { screen = 'welcome'; attract = false; session = null; lastInput = performance.now(); render(); return; }\nlabs/game/main.ts:77:  persist(); playSound('finish'); screen = 'result'; render();\nlabs/game/main.ts:101:  const scope = modal ? root.querySelector('.modal') : root;\nlabs/game/main.ts:108:  if (!session || screen !== 'playing' || modal || attract) return;\nlabs/game/main.ts:112:  lastInput = performance.now();\nlabs/game/main.ts:113:  if (attract) { attract = false; session = null; screen = 'welcome'; render(); }\nlabs/game/main.ts:122:  else if (command === 'settings' || command === 'about') modal = command;\nlabs/game/main.ts:123:  else if (command === 'close') modal = null;\nlabs/game/main.ts:124:  else if (command === 'pause') modal = 'pause';\nlabs/game/main.ts:125:  else if (command === 'resume') { modal = null; lastFrame = 0; }\nlabs/game/main.ts:126:  else if (command === 'quit') { modal = null; session = null; screen = 'hub'; }\nlabs/game/main.ts:133:  render();\nlabs/game/main.ts:139:  save.preferences[key] = input.checked; sounds.enabled = save.preferences.sound; persist(); render();\nlabs/game/main.ts:144:  lastInput = performance.now(); lastInputType = 'keyboard';\nlabs/game/main.ts:145:  if (key === 'escape') { event.preventDefault(); if (modal) modal = null; else if (screen === 'playing') modal = 'pause'; render(); return; }\nlabs/game/main.ts:146:  if (screen === 'playing' && !modal) {\nlabs/game/main.ts:159:window.addEventListener('pointerdown', () => { if (attract) wake(); else lastInput = performance.now(); });\nlabs/game/main.ts:161:function frame(now: number): void {\nlabs/game/main.ts:172:      lastInput = now; lastInputType = 'controller';\nlabs/game/main.ts:174:    if (pressed(9) || pressed(3)) { if (screen === 'playing') { modal = modal ? null : 'pause'; render(); } }\nlabs/game/main.ts:175:    if (screen === 'playing' && !modal) {\nlabs/game/main.ts:181:      if (pressed(1) && modal) { modal = null; render(); }\nlabs/game/main.ts:185:  if (screen === 'welcome' && !modal && now - lastInput > 60000) { dayIndex = 0; activityIndex = 0; openGame(true); }\nlabs/game/main.ts:186:  if (screen === 'playing' && session && !modal && !document.hidden) {\nlabs/game/main.ts:201:render(); requestAnimationFrame(frame);\nlabs/game/view.ts:12:  return `<div class=\"site welcome\">${header()}<main class=\"welcome-main\"><div class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\"></span> A MOST GENTLE ESCAPE</div><h1>Find your<br><em>almost</em> balance.</h1><p>Welcome to a little island where the air is fresh, the hosts are encouraging, and standing still is surprisingly ambitious.</p><div class=\"hero-actions\"><button class=\"primary\" data-action=\"begin\">Begin your stay <span>→</span></button><button class=\"text-button\" data-action=\"about\">What is this place? <span>↗</span></button></div>${touch ? '<p class=\"touch-notice\">Controller or keyboard required to play. Settings and the idle preview are available.</p>' : '<div class=\"control-note\"><span class=\"keycap\">↵</span> KEYBOARD &nbsp; OR &nbsp; CONTROLLER FRIENDLY</div>'}</div><div class=\"hero-art\"><div class=\"sun-halo\"></div>${islandArt()}<div class=\"postcard\"><span class=\"postcard-mark\">✳</span><div><b>A slower kind of holiday</b><small>YOUR RETREAT AWAITS</small></div></div><div class=\"art-caption\">EST. SOMEWHERE PEACEFUL &nbsp; · &nbsp; 01 / 05</div></div></main><footer class=\"welcome-footer\"><span>TAKE YOUR TIME. YOU'RE ON ISLAND TIME.</span><button class=\"footer-link\" data-action=\"about\">ABOUT &amp; CREDITS</button></footer></div>`;\nlabs/game/view.ts:24:  return `<div class=\"site hub\">${header('YOUR RETREAT PROGRAMME')}<main class=\"hub-main\"><div class=\"hub-heading\"><div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> MAKE YOURSELF AT HOME</div><h1>Your island <em>itinerary.</em></h1><p>One small wobble at a time. There is no rush.</p></div><div class=\"stay-progress\"><span>YOUR STAY SO FAR</span><b>${String(complete).padStart(2, '0')} <small>experiences enjoyed</small></b></div></div><nav class=\"days\" aria-label=\"Retreat days\">${tabs}</nav><div class=\"hub-grid\"><section class=\"programme\"><div class=\"section-kicker\">DAY ${String(dayIndex + 1).padStart(2, '0')} <span>✳</span> ${day.subtitle}</div><h2>${day.title}</h2><p class=\"day-story\">${day.story}</p><div class=\"activity-list\">${items}</div></section><aside class=\"brief-card\"><div class=\"brief-top\"><span>YOUR NEXT EXPERIENCE</span><span>✳</span></div><div class=\"brief-illustration\">${characterArt()}<span class=\"illustration-sun\"></span></div><div class=\"brief-content\"><div class=\"eyebrow\">${chosen.location} &nbsp; / &nbsp; ${duration(chosen.duration)}</div><h2>${chosen.title}</h2><p>${chosen.description}</p><div class=\"host-quote\">“${chosen.quote}”<small>— ${chosen.host}, YOUR HOST</small></div><button class=\"primary full\" data-action=\"start\" ${locked ? 'disabled' : ''}>${locked ? 'Complete earlier experiences' : scores[chosen.id] !== undefined ? 'Enjoy again' : 'Start experience'} <span>→</span></button></div></aside></div></main><footer class=\"inner-footer\"><span>✳ &nbsp; THE ISLAND IS HAPPY YOU'RE HERE</span><button class=\"footer-link\" data-action=\"about\">ABOUT &amp; CREDITS</button></footer></div>`;\nlabs/game/view.ts:28:  return `<div class=\"site game-site\">${header(attract ? 'A LITTLE PREVIEW' : activity.location.toUpperCase())}<main class=\"game-main\"><div class=\"game-title\"><div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> ${attract ? 'IDLE PREVIEW · ANY INPUT TO RETURN' : 'A MOMENT FOR YOURSELF'}</div><h1>${activity.title}</h1><p>${activity.instruction}</p></div><button class=\"outline-button\" data-action=\"pause\">Ⅱ <span>Pause</span></button></div><div class=\"game-layout\"><section class=\"balance-panel\"><div class=\"panel-label\"><span>YOUR BALANCE</span><span>STAY WITH THE CIRCLE</span></div><div class=\"balance-board\"><div class=\"board-ring ring-outer\"></div><div class=\"board-ring ring-middle\"></div><div class=\"board-ring ring-inner\"></div><div class=\"board-line horizontal\"></div><div class=\"board-line vertical\"></div><div id=\"balance-target\" class=\"balance-target\"></div><div id=\"balance-ball\" class=\"balance-ball\"></div><span class=\"board-letter top\">N</span><span class=\"board-letter bottom\">S</span><span class=\"board-letter left\">W</span><span class=\"board-letter right\">E</span></div><div class=\"session-cue\" id=\"session-cue\">Find your centre</div><div class=\"game-progress\"><div id=\"session-progress\"></div></div><div class=\"board-bottom\"><span>GENTLE DOES IT</span><span>✳</span><span>EVERY WOBBLE COUNTS</span></div></section><aside class=\"session-side\"><div class=\"session-art\"><div class=\"session-sun\"></div><div class=\"guest-art\">${characterArt()}</div><div class=\"island-water\"></div></div><div class=\"session-stats\"><div><small>TIME REMAINING</small><b id=\"session-time\">0:00</b></div><div><small>BALANCE</small><b><span id=\"session-score\">0</span><i> / 100</i></b></div><div><small>STUMBLES</small><b id=\"session-falls\">0</b></div></div><div class=\"how-to\"><b>HOW TO MOVE</b><p>${input === 'controller' ? 'Left stick to lean · R2 for gentle movement · L1 / R1 for feet · ✕ for both' : 'WASD or arrow keys to lean · Shift for gentle movement · Q / E for feet · Space for both'}</p></div></aside></div></main></div>`;\nlabs/game/view.ts:34:export function modalView(modal: string, preferences: Preferences): string {\nlabs/game/view.ts:36:  if (modal === 'settings') {\nlabs/game/view.ts:39:  } else if (modal === 'pause') body = `<div class=\"eyebrow\">TAKE ALL THE TIME YOU NEED</div><h2>Pause for a breath.</h2><p>Your experience will be right here when you're ready.</p><div class=\"modal-actions\"><button class=\"primary\" data-action=\"resume\">Resume experience →</button><button class=\"text-button\" data-action=\"quit\">Return to itinerary</button></div>`;\nlabs/game/view.ts:40:  else if (modal === 'touch') body = `<div class=\"eyebrow\">ONE SMALL THING</div><h2>Controller or keyboard required.</h2><p>Connect a controller or use a keyboard to take part. The settings and idle preview are still available here.</p><button class=\"primary\" data-action=\"close\">Got it →</button>`;\nlabs/game/view.ts:42:  return `<div class=\"modal-backdrop\"><section class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"${modal === 'about' ? 'About and credits' : modal}\" tabindex=\"-1\"><button class=\"modal-close\" data-action=\"close\" aria-label=\"Close\">×</button>${body}</section></div>`;\n--- hub urls ---\n16707 /tmp/wee-fit-hub-session.js\n6ab6be43898e2db069bc21a94757d77d9c3f2a0cb76f01186490d3bd88d8717a  /tmp/wee-fit-hub-session.js\n","exit_code":0,"status":"completed"}}
