uto;padding:42px 6.2% 65px}.game-title{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}.game-title h1{font-size:clamp(46px,5vw,70px);margin:16px 0 6px}.game-title p{font-size:14px;margin:0;max-width:760px}.outline-button{border:1px solid #c9dbcf;color:#326b5a;background:transparent;border-radius:8px;padding:12px 17px;white-space:nowrap}.game-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:24px}.balance-panel,.session-side{background:#fffef9;border:1px solid #e3ede3;border-radius:14px;overflow:hidden}.balance-panel{padding:24px 30px}.panel-label,.board-bottom{display:flex;justify-content:space-between;font-size:9px}.balance-board{position:relative;width:min(100%,390px);aspect-ratio:1;margin:25px auto 16px;border-radius:50%;background:#e6f2e7;border:1px solid #cfe2d1;overflow:hidden}.board-ring{position:absolute;border:1px solid #cadfd0;border-radius:50%;inset:12%}.ring-middle{inset:27%}.ring-inner{inset:42%;background:#d5e9d7}.board-line{position:absolute;background:#d4e5d7}.board-line.horizontal{width:100%;height:1px;top:50%}.board-line.vertical{height:100%;width:1px;left:50%}.balance-target,.balance-ball{position:absolute;transform:translate(-50%,-50%);border-radius:50%;z-index:2}.balance-target{width:17%;height:17%;border:2px dashed #dd9078;background:#e49a7925;left:50%;top:50%}.balance-ball{width:8%;height:8%;background:#246e5b;border:5px solid #fffdf4;box-shadow:0 3px 8px #235a4a4d;left:50%;top:50%}.board-letter{position:absolute;color:#91ae9c;font-size:9px;font-weight:700}.board-letter.top{top:4%;left:49%}.board-letter.bottom{bottom:4%;left:49%}.board-letter.left{left:5%;top:49%}.board-letter.right{right:5%;top:49%}.session-cue{text-align:center;font:italic 21px Georgia,serif;color:#5d8e79;min-height:25px}.game-progress{height:5px;border-radius:5px;background:#edf3e9;margin:22px 0 14px;overflow:hidden}.game-progress div{height:100%;width:0;background:#79ad95;transition:width .2s}.session-