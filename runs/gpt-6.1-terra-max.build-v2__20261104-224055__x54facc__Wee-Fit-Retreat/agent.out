elcome' | 'hub' | 'playing' | 'result';\n.welcome-footer{font-size:10px;font-weight:750;letter-spacing:.18em;color:#78988a}\n.welcome-main{min-height:calc(100vh - 144px);display:grid;grid-template-columns: .92fr 1.08fr;align-items:center;padding:2% 6.2% 4%;gap:2%}\n.hero-copy{max-width:590px;position:relative;z-index:1}\n.hero-copy h1,.hub-heading h1,.game-title h1,.result-main h1{font-family:Georgia,\"Times New Roman\",serif;letter-spacing:-.055em;font-weight:400;line-height:.98;font-size:clamp(58px,6.8vw,112px);margin:28px 0}\n.hero-copy h1 em,.hub-heading h1 em,.result-main h1 em{font-weight:400;color:#679b85}\n.hero-copy>p,.hub-heading p,.game-title p,.result-main>p{font-size:16px;line-height:1.8;color:#6c887b;max-width:465px}\n.hero-art{min-width:0;position:relative;display:grid;place-items:center;min-height:530px}\n.hero-art>svg{width:min(100%,760px);height:auto;position:relative;z-index:1;filter:drop-shadow(0 22px 30px #34796320)}\n.postcard{position:absolute;right:0;bottom:13%;z-index:1;background:#fffef8;border-radius:12px;padding:14px 19px;box-shadow:0 12px 40px #2b624316;display:flex;align-items:center;gap:12px}\n.postcard-mark{font-size:26px;color:#d68b72}\n.postcard b,.postcard small{display:block}\n.postcard b{font-family:Georgia,serif;font-weight:400;font-size:16px}\n.postcard small{font-size:8px;letter-spacing:.15em;color:#8ba99b;margin-top:5px}\n.welcome-footer,.inner-footer{min-height:56px;border-top:1px solid #e2eadf;display:flex;align-items:center;justify-content:space-between;padding:0 6.2%;font-size:9px}\n.welcome-main{grid-template-columns:1fr;padding-top:65px}\n.hero-copy{max-width:650px}\n.hero-copy h1{font-size:clamp(64px,10vw,90px)}\n.hero-art{min-height:400px}\n.hero-art>svg{max-height:480px}\n.welcome-main{padding:58px 24px 35px;gap:10px;min-height:auto}\n.hero-copy h1{font-size:clamp(58px,14vw,86px);margin:21px 0}\n.hero-copy>p{font-size:14px}\n.hero-art{min-height:310px}\n.postcard{bottom:7%;right:0;padding:10px 12px}\n.postcard b{font