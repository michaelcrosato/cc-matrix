a micha    584 Nov  4 22:55 tsconfig.apps.json\n-rw-r--r--   1 micha micha    544 Nov  4 22:55 tsconfig.base.json\n-rw-r--r--   1 micha micha   1392 Nov  4 22:55 tsconfig.check.json\n-rw-r--r--   1 micha micha    345 Nov  4 22:55 tsconfig.engine.json\n-rw-r--r--   1 micha micha    512 Nov  4 22:55 tsconfig.json\n-rw-r--r--   1 micha micha    546 Nov  4 22:55 tsconfig.tests.json\n-rw-r--r--   1 micha micha   4934 Nov  4 22:55 vite.config.ts\n-rw-r--r--   1 micha micha    387 Nov  4 22:55 x.js\nlabs/game/programme.ts:export type ActivityKind = 'check' | 'pose' | 'reps' | 'step' | 'pond' | 'line' | 'paddle' | 'sand' | 'cliff' | 'hoop' | 'jog' | 'group' | 'finale';\nlabs/game/programme.ts:export type Activity = { id: string; title: string; kind: ActivityKind; location: string; duration: number; description: string; instruction: string; host: string; quote: string };\nlabs/game/programme.ts:export type Day = { title: string; subtitle: string; story: string; activities: Activity[] };\nlabs/game/programme.ts:export const DAYS: Day[] = [\nlabs/game/programme.ts:export function rankFor(score: number): { name: string; pebbles: number } {\nlabs/game/programme.ts:export const POSES = ['Seated Nothing', 'Patient Chair', 'Heron', 'Archer', 'Comma', 'Napkin', 'Bridge', 'Lighthouse'];\nlabs/game/audio.ts:export class Soundscape {\nlabs/game/art.ts:export function islandArt(): string {\nlabs/game/art.ts:export function characterArt(): string {\nlabs/game/wobble.ts:export type BalanceSettings = { gain: number; instability: number; damping: number; noise: number; noiseRate: number; reach: number; breathSeconds: number; calmEffect: number };\nlabs/game/wobble.ts:export const DEFAULT_BALANCE: BalanceSettings = { gain: 14, instability: 3, damping: 5, noise: 0.15, noiseRate: 0.15, reach: 0.9, breathSeconds: 8, calmEffect: 0.5 };\nlabs/game/wobble.ts:export type Input = { x: number; y: number; gentle: boolean };\nlabs/game/wobble.ts:export type Foot = 'left' | 'right' | 'both';\nlabs/game/wobble.ts:export type Balance = { x: number; y: number; vx: number; vy: number; targetX: number; targetY: number; time: number; calm: number; outside: number; recovering: number; falls: number };\nlabs/game/wobble.ts:export type Session = { activity: Activity; balance: Balance; time: number; scoreSum: number; samples: number; hits: number; attempts: number; foot: Foot | null; lastFoot: Foot | null; cue: Foot; actionFlash: number; seed: number; finished: boolean; score: number };\nlabs/game/wobble.ts:export function createBalance(): Balance {\nlabs/game/wobble.ts:export function createSession(activity: Activity, seed = 1): Session {\nlabs/game/wobble.ts:export function stepBalance(balance: Balance, input: Input, settings: BalanceSettings, dt: number, seed = 1): void {\nlabs/game/wobble.ts:export function targetFor(session: Session): { x: number; y: number; label: string } {\nlabs/game/wobble.ts:export function action(session: Session, foot: Foot): boolean {\nlabs/game/wobble.ts:export function stepSession(session: Session, input: Input, settings: BalanceSettings, dt = 1 / 60): void {\n// The whole repository as one TypeScript program: what `npx tsc --noEmit`, editors, Vite, Vitest, tsx and `x new`\n// read. T0 (`npm run check`, `npm run typecheck`) checks the same files through the projects of tsconfig.check.json,\n// incrementally; tools/checkAll.test.ts keeps the two file lists equal (ADR-0014, amendment 7).\n{\n  \"extends\": \"./tsconfig.base.json\",\n  \"compilerOptions\": {\n    \"noEmit\": true\n  },\n  \"include\": [\"engine\", \"labs\", \"tests\", \"fixtures\", \"tools\", \".claude/hooks\", \"*.config.ts\"]\n}\n<!doctype html>\n<!-- @file Entry point for the Wee Fit Retreat game. -->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"theme-color\" content=\"#b8e7e1\" />\n    <meta name=\"description\" content=\"A tiny island wellness retreat with an unusually concerned balance scale.\" />\n    <title>Wee Fit Retreat</title>\n  </head>\n  <body>\n    <main id=\"app\"></main>\n    <script type=\"module\" src=\"./main.ts\"></script>\n  </body>\n</html>\n","exit_code":0,"status":"completed"}}
