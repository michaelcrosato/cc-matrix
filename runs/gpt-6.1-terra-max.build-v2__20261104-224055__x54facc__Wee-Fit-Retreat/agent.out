-gpt-6.1-terra-max-20261104-224055/engine/gfx/geometry/geometry.ts:89:export function geometryKind(registry: Registry): void {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/geometry/geometry.ts:109:export function defineGeometry<const S extends Schema>(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/geometry/geometry.ts:119:export function getGeometry(id: string, registry: Registry = sharedRegistry): GeometryEntry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/geometry/geometry.ts:129:export function buildGeometry(ref: string | GeometryRef, registry: Registry = sharedRegistry): BufferGeometry {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:50:export const COMPILE_CODES = defineCodes('gfx', {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:59:export type PieceShape = 'limb' | 'ball' | 'eye' | 'box' | 'cone' | 'blade' | 'strip';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:62:export const CAPE_THICKNESS = 0.02;\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:65:export interface BodyPiece {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:83:export interface CompiledBody {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:111:export function restPositions(skeleton: Skeleton): Float64Array {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:136:export function compileBody(\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/compile.ts:309:export function recolor(compiled: CompiledBody, palette: Readonly<Record<string, string>>): CompiledBody {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/actors.ts:102:export const ACTOR_BODY = 'body:humanoid';\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/actors.ts:108:export interface PlayerView {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/actors.ts:117:export interface ActorPuppets {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/puppets/actors.ts:162:export function createActorPuppets(options: { materials: PuppetMaterials; registry?: Registry }): ActorPuppets {\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cameras/follow.ts:50:export const FOLLOW_RIG = Object.freeze({\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cameras/follow.ts:73:export const FOLLOW_LIMITS = Object.freeze({ pitch: [-1.4, 0.8] as const, distance: [1, 20] as const });\nWee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/engine/gfx/cameras/follow.ts:75:export const FOLLOW_TURN_SPEED = Object.freeze([2.2, 1.2] as const);\n--- main functions ---\n10:type Preferences = { sound: boolean; motion: boolean; contrast: boolean; assist: boolean };\n13:const root = document.querySelector<HTMLElement>('#app')!;\n16:function load(): Save {\n23:let screen: Screen = 'welcome';\n27:let session: Session | null = null;\n35:const sounds = new Soundscape();\n38:function persist(): void {\n41:function flatIndex(day: number, activity: number): number {\n44:function selected(): Activity { return DAYS[dayIndex].activities[activityIndex]; }\n45:function selectFlat(index: number): void {\n52:function totalActivities(): number { return DAYS.reduce((total, day) => total + day.activities.length, 0); }\n53:function playSound(name: 'click' | 'hit' | 'finish' | 'miss'): void { try { sounds.play(name); } catch { /* audio is optional */ } }\n54:function isTouchOnly(): boolean {\n57:function render(): void {\n65:function openGame(preview = false): void {\n71:function finish(): void {\n79:function updateGame(): void {\n100:function moveFocus(direction: number): void {\n107:function doFoot(foot: 'left' | 'right' | 'both'): void {\n111:function wake(): void {\n161:function frame(now: number): void {\n--- game view ---\n8:  return `<header class=\"topbar\"><button class=\"brand\" data-action=\"home\" aria-label=\"Return to title\"><span class=\"brand-icon\">✳</span><span>WEE FIT <b>RETREAT</b></span></button><span class=\"top-label\">${label}</span><button class=\"icon-button\" data-action=\"settings\" aria-label=\"Settings\">⚙</button></header>`;\n12:  return `<div class=\"site welcome\">${header()}<main class=\"welcome-main\"><div class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\"></span> A MOST GENTLE ESCAPE</div><h1>Find your<br><em>almost</em> balance.</h1><p>Welcome to a little island where the air is fresh, the hosts are encouraging, and standing still is surprisingly ambitious.</p><div class=\"hero-actions\"><button class=\"primary\" data-action=\"begin\">Begin your stay <span>→</span></button><button class=\"text-button\" data-action=\"about\">What is this place? <span>↗</span></button></div>${touch ? '<p class=\"touch-notice\">Controller or keyboard required to play. Settings and the idle preview are available.</p>' : '<div class=\"control-note\"><span class=\"keycap\">↵</span> KEYBOARD &nbsp; OR &nbsp; CONTROLLER FRIENDLY</div>'}</div><div class=\"hero-art\"><div class=\"sun-halo\"></div>${islandArt()}<div class=\"postcard\"><span class=\"postcard-mark\">✳</span><div><b>A slower kind of holiday</b><small>YOUR RETREAT AWAITS</small></div></div><div class=\"art-caption\">EST. SOMEWHERE PEACEFUL &nbsp; · &nbsp; 01 / 05</div></div></main><footer class=\"welcome-footer\"><span>TAKE YOUR TIME. YOU'RE ON ISLAND TIME.</span><button class=\"footer-link\" data-action=\"about\">ABOUT &amp; CREDITS</button></footer></div>`;\n26:export function gameView(session: Session, attract: boolean, input: 'keyboard' | 'controller'): string {\n28:  return `<div class=\"site game-site\">${header(attract ? 'A LITTLE PREVIEW' : activity.location.toUpperCase())}<main class=\"game-main\"><div class=\"game-title\"><div><div class=\"eyebrow\"><span class=\"sun-dot\"></span> ${attract ? 'IDLE PREVIEW · ANY INPUT TO RETURN' : 'A MOMENT FOR YOURSELF'}</div><h1>${activity.title}</h1><p>${activity.instruction}</p></div><button class=\"outline-button\" data-action=\"pause\">Ⅱ <span>Pause</span></button></div><div class=\"game-layout\"><section class=\"balance-panel\"><div class=\"panel-label\"><span>YOUR BALANCE</span><span>STAY WITH THE CIRCLE</span></div><div class=\"balance-board\"><div class=\"board-ring ring-outer\"></div><div class=\"board-ring ring-middle\"></div><div class=\"board-ring ring-inner\"></div><div class=\"board-line horizontal\"></div><div class=\"board-line vertical\"></div><div id=\"balance-target\" class=\"balance-target\"></div><div id=\"balance-ball\" class=\"balance-ball\"></div><span class=\"board-letter top\">N</span><span class=\"board-letter bottom\">S</span><span class=\"board-letter left\">W</span><span class=\"board-letter right\">E</span></div><div class=\"session-cue\" id=\"session-cue\">Find your centre</div><div class=\"game-progress\"><div id=\"session-progress\"></div></div><div class=\"board-bottom\"><span>GENTLE DOES IT</span><span>✳</span><span>EVERY WOBBLE COUNTS</span></div></section><aside class=\"session-side\"><div class=\"session-art\"><div class=\"session-sun\"></div><div class=\"guest-art\">${characterArt()}</div><div class=\"island-water\"></div></div><div class=\"session-stats\"><div><small>TIME REMAINING</small><b id=\"session-time\">0:00</b></div><div><small>BALANCE</small><b><span id=\"session-score\">0</span><i> / 100</i></b></div><div><small>STUMBLES</small><b id=\"session-falls\">0</b></div></div><div class=\"how-to\"><b>HOW TO MOVE</b><p>${input === 'controller' ? 'Left stick to lean · R2 for gentle movement · L1 / R1 for feet · ✕ for both' : 'WASD or arrow keys to lean · Shift for gentle movement · Q / E for feet · Space for both'}</p></div></aside></div></main></div>`;\n34:export function modalView(modal: string, preferences: Preferences): string {\n41:  else body = `<div class=\"eyebrow\">A NOTE FROM THE ISLAND</div><h2>About this retreat</h2><p>Wee Fit Retreat is an original, gentle balance game inspired by the reassuring oddness of fitness games. All illustrations and sound effects were made for this project.</p><p>Explore five days of small activities. Lean towards the target and use your feet when the activity calls for them. Stumbles are invitations to begin again.</p><h3>Controls</h3><p><b>Keyboard:</b> WASD or arrows to lean, Shift for gentle movement, Q / E for left / right foot, Space for both, Esc to pause.<br><b>Controller:</b> left stick to lean, R2 for gentle movement, L1 / R1 for feet, Cross for both, Options to pause. D-pad and Cross navigate menus.</p><h3>Credits &amp; project notes</h3><p>Original code, illustration and synthesized audio created for this game. Built in the provided my-3dge workspace; this edition uses a custom 2D presentation and does not include online multiplayer. Progress is stored locally in your browser.</p><p>Built with Vite and TypeScript. The engine source and project feedback are included with the hand-in.</p>`;\n42:  return `<div class=\"modal-backdrop\"><section class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"${modal === 'about' ? 'About and credits' : modal}\" tabindex=\"-1\"><button class=\"modal-close\" data-action=\"close\" aria-label=\"Close\">×</button>${body}</section></div>`;\n--- package and config ---\ncat: Wee-Fit-Retreat-Wii-Fit-gpt-6.1-terra-max-20261104-224055/labs/game/package.json: No such file or directory\n","exit_code":1,"status":"failed"}}
