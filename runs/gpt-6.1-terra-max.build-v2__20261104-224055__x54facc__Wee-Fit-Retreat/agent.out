{"type":"item.started","item":{"id":"item_808","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' labs/game/main.ts; printf '\\\\n-- SESSION --\\\\n'; sed -n '1,150p' labs/game/wobble.ts; printf '\\\\n-- PROGRAMME --\\\\n'; sed -n '1,100p' labs/game/programme.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
