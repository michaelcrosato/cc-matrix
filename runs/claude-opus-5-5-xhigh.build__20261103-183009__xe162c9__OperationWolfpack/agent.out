 6], [22, 8, 14], { rot: [0, 0, 180] }], ['mirror', 'x', ['cyl', 'r', [12, -14, 13], 4.5, 12, { rot: [90, 0, 0] }]], ['cyl', 'd', [0, 2, 20], 5, 4], ['cyl', 'd', [0, 18, 16], 1.8, 18, { rot: [90, 0, 0] }]] };\nS.locomotive = { about: \"the armored train engine 'IRON HOG'\", tags: 'train boss', scale: 1.5, mats: { b: { color: '#3a3a40', pattern: 'metal', rivet: 1 }, r: 'redPaint', t: 'steelDk', y: 'yellowPaint' },\n  parts: [B('t', [0, 0, 0], [16, 64, 6]), ['cyl', 'b', [0, 8, 14], 9, 40, { rot: [90, 0, 0] }], B('b', [0, -20, 6], [20, 22, 24]), ['cyl', 't', [0, 22, 22], 3, 10], ['wedge', 'r', [0, 32, 0], [18, 6, 8], { rot: [0, 0, 180] }], B('y', [0, -9, 22], [21, .4, 2])] };\nS.trainCar = { about: 'an armored train car', tags: 'train', scale: 1.5, mats: { b: { color: '#4a4a50', pattern: 'metal', rivet: 1 }, t: 'steelDk', k: { color: '#14121a', pattern: 'none' } },\n  parts: [B('t', [0, 0, 0], [16, 50, 6]), B('b', [0, 0, 6], [20, 50, 18]), ['row', 3, [0, 14, 0], B('k', [10.1, 0, 14], [.3, 6, 3])]] };\nS.ammoWagon = { about: 'an open wagon of ammunition crates', tags: 'train explosive', scale: 1.5, mats: { w: 'planks', t: 'steelDk', c: 'olive' },\n  parts: [B('t', [0, 0, 0], [16, 50, 6]), B('w', [0, 0, 6], [20, 50, 8]), ['row', 3, [0, 14, 0], B('c', [0, 0, 14], [14, 10, 8])]] };\nS.flatcar = { about: 'a flatcar', tags: 'train', scale: 1.5, mats: { w: 'planks', t: 'steelDk' }, parts: [B('t', [0, 0, 0], [16, 50, 6]), B('w', [0, 0, 6], [20, 52, 2])] };\nS.cargoPlane = { about: 'OLD HOWLER, a twin-prop cargo plane with a rear ramp', tags: 'aircraft', scale: 1.5, mats: { b: { color: '#6a7a5a', pattern: 'metal' }, w: 'whitePaint', g: 'glassDk', d: 'steelDk', k: { color: '#121410', pattern: 'none' } },\n  parts: [['cyl', 'b', [0, 0, 10], 10, 90, { rot: [90, 0, 0] }], ['ball', 'b', [0, 45, 10], 10, { sz: .9 }], B('g', [0, 50, 14], [10, 4, 3]), B('b', [0, 6, 18], [140, 18, 2]), ['mirror', 'x', ['cyl', 'd', [30, 18, 15], 4, 16, { rot: [90, 0, 0] }]], B('b', [0, -46, 14], [44, 10,