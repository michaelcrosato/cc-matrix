ugin-authoring\",\"anthropic-skills:artifact-emulator\"],\"plugins\":[{\"name\":\"pyright-lsp\",\"path\":\"/home/micha/.claude/plugins/cache/claude-plugins-official/pyright-lsp/1.0.0\",\"source\":\"pyright-lsp@claude-plugins-official\",\"version\":\"1.0.0\"},{\"name\":\"cc-plugin-agents-md\",\"path\":\"builtin\",\"source\":\"cc-plugin-agents-md@builtin\"},{\"name\":\"cc-plugin-telemetry\",\"path\":\"builtin\",\"source\":\"cc-plugin-telemetry@builtin\"},{\"name\":\"cc-plugin-privacy\",\"path\":\"builtin\",\"source\":\"cc-plugin-privacy@builtin\"},{\"name\":\"cc-plugin-plugin-authoring\",\"path\":\"builtin\",\"source\":\"cc-plugin-plugin-authoring@builtin\"}],\"capabilities\":[\"interrupt_receipt_v1\",\"interrupt_cancel_queued_v1\",\"interrupt_send_now_v1\",\"interrupt_requeue_taken_v1\",\"msg_lifecycle_v1\",\"request_marker_lists_v1\",\"ask_user_question_unanswered_v1\",\"lifecycle_wakeup_source_v1\",\"sdk_mcp_tools_list_changed\",\"sdk_mcp_manifests\",\"mcp_read_resource_v1\",\"mcp_tool_ui_meta_v1\",\"ui_surface_v1\",\"mcp_call_result_not_for_model_v1\"],\"analytics_disabled\":false,\"product_feedback_disabled\":false,\"uuid\":\"3890d99e-5771-44b3-89a3-f8bea624dfac\",\"original_cwd\":\"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183606__xf7f297/work\",\"additional_directories\":[],\"messaging_socket_path\":\"/run/user/1000/cc-socks/1439450.sock\",\"fast_mode_state\":\"off\",\"fast_mode_disabled_reason\":\"sdk_opt_in_required\",\"per_turn_effort_active\":true,\"ultrathink_available\":false,\"ultrathink_typed_raises\":false,\"view_mode\":\"default\"}"," {\"type\":\"assistant\",\"message\":{\"diagnostics\":null,\"id\":\"a1339c10-c8e7-4073-bdc7-725ccef89ab2\",\"container\":null,\"model\":\"<synthetic>\",\"role\":\"assistant\",\"stop_details\":null,\"stop_reason\":\"end_turn\",\"stop_sequence\":null,\"type\":\"message\",\"usage\":{\"output_tokens_details\":null,\"input_tokens\":0,\"output_tokens\":0,\"cache_creation_input_tokens\":0,\"cache_read_input_tokens\":0,\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":null,\"cache_creation\":{\"ephemeral_1h_input_tokens\":0,\"ephemeral_5m_input_tokens\":0},\"inference_geo\":null,\"iterations\":null,\"speed\":null,\"fallback_credit\":null},\"content\":[{\"type\":\"text\",\"text\":\"Goal set: Read STAGE.md in the current folder and do what it says (TASK.md describes the game). Done when: the bundled single .html file exists in this folder's root, every feature in TASK.md is implemented with no TODOs, placeholders or stubs, exit-interview.json in this folder's root parses as JSON and answers every field, and your final reply contains the Source Information, Testing Feedback, Engine Feedback and Prompt Feedback sections.\"}],\"context_management\":null},\"parent_tool_use_id\":null,\"local_command_source\":\"<local-command-stdout>Goal set: Read STAGE.md in the current folder and do what it says (TASK.md describes the game). Done when: the bundled single .html file exists in this folder's root, every feature in TASK.md is implemented with no TODOs, placeholders or stubs, exit-interview.json in this folder's root parses as JSON and answers every field, and your final reply contains the Source Information, Testing Feedback, Engine Feedback and Prompt Feedback sections.</local-command-stdout>\",\"session_id\":\"9cdefc10-dd96-4250-9292-d55bd20762ae\",\"uuid\":\"aea564ce-9a83-498c-a6d2-16189c926a29\",\"timestamp\":\"2026-11-04T01:36:07.426Z\",\"local_command_run\":{\"command\":\"goal\",\"args\":\"Read STAGE.md in the current folder and do what it says (TASK.md describes the game). Done when: the bundled single .html file exists in this folder's root, every feature in TASK.md is implemented with no TODOs, placeholders or stubs, exit-interview.json in this folder's root parses as JSON and answers every field, and your final reply contains the Source Information, Testing Feedback, Engine Feedback and Prompt Feedback sections.\"}}","+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh2iSVgeVULAbpNmkTR2\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2587,\"cache_read_input_tokens\":13236,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2587},\"output_tokens\":9,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"9cdefc10-dd96-4250-9292-d55bd20762ae\",\"uuid\":\"da9d03b5-7348-43fe-80bd-552a05e4dc0b\",\"timestamp\":\"2026-11-04T01:36:08.916Z\",\"request_id\":\"req_011Cgh2iSG3VdWZNJAFminyg\",\"thinking_duration_ms\":178,\"thinking_display\":\"updates\"}","+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh2iSVgeVULAbpNmkTR2\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Goal acknowledged. I'll start by reading STAGE.md and TASK.md in the current folder.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2587,\"cache_read_input_tokens\":13236,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2587},\"output_tokens\":9,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"9cdefc10-dd96-4250-9292-d55bd20762ae\",\"uuid\":\"5ab6273a-b3d2-4f39-9b7a-92ed1398d241\",\"timestamp\":\"2026-11-04T01:36:09.103Z\",\"request_id\":\"req_011Cgh2iSG3VdWZNJAFminyg\"}","+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-5-5\",\"id\":\"msg_011Cgh2iSVgeVULAbpNmkTR2\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01K1CWEysGLuWmXQ76HThWbU\",\"name\":\"Bash\",\"input\":{\"command\":\"pwd && ls -la && cat STAGE.md 2>/dev/null; echo ---; cat TASK.md 2>/dev/null\",\"description\":\"Show working folder, files, STAGE.md and TASK.md\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2587,\"cache_read_input_tokens\":13236,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2587},\"output_tokens\":9,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"9cdefc10-dd96-4250-9292-d55bd20762ae\",\"uuid\":\"4cdfbfe6-db4a-4d4c-a4aa-a49032fe64a2\",\"timestamp\":\"2026-11-04T01:36:09.476Z\",\"request_id\":\"req_011Cgh2iSG3VdWZNJAFminyg\",\"wire_tool_inputs\":{\"toolu_01K1CWEysGLuWmXQ76HThWbU\":{\"command\":\"pwd && ls -la && cat STAGE.md 2>/dev/null; echo ---; cat TASK.md 2>/dev/null\",\"description\":\"Show working folder, files, STAGE.md and TASK.md\"}}}","+{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\",\"resetsAt\":1793793600,\"rateLimitType\":\"seven_day\",\"overageStatus\":\"rejected\",\"overageDisabledReason\":\"org_level_disabled\",\"isUsingOverage\":false,\"unifiedWindows\":{\"seven_day\":{\"utilization\":0.41,\"resetsAt\":1793793600,\"status\":\"allowed\"}}},\"uuid\":\"fb0c53c4-fca9-4c85-a7be-be454d82031a\",\"session_id\":\"9cdefc10-dd96-4250-9292-d55bd20762ae\"}","+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01K1CWEysGLuWmXQ76HThWbU\",\"type\":\"tool_result\",\"content\":\"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183606__xf7f297/work\\ntotal 152\\ndrwxr-xr-x 2 micha micha   4096 Nov  3 18:36 .\\ndrwxr-xr-x 3 micha micha   4096 Nov  3 18:36 ..\\n-rw-r--r-- 1 micha micha 129055 Nov  3 18:36 PLAN.md\\n-rw-r--r-- 1 micha micha    347 Nov  3 18:36 STAGE.md\\n-rw-r--r-- 1 micha micha   8791 Nov  3 18:36 TASK.md\\nRead TASK.md (what to build) and PLAN.md (how to build it, written by claude-opus-5-5 at max effort) in this folder. Build the game TASK.md describes, following the plan and using the title it gives; where they disagree, TASK.md wins. Deliver everything TASK.md asks for, including its file name, and the sections it asks for in your final reply.\\n---\\nSOURCE: Tenchu 2: Birth of the Stealth Assassins\\n\\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\\n\\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\\n\\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\\n\\nResearch: Whether and how much to research is your choice.\\n\\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-claude-haiku-5-5-medium-20261103-183606.html]. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\\n\\nTech Stack: Build on https://github.com/michaelcrosato/my-3d2dge/tree/main/dist/handoff. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\\n\\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\\n\\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\\n\\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish.\\n\\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\\n\\nWorking Environment and deliverable:\\nCreate a subfolder called [GameTitle-SOURCE-claude-haiku-5-5-medium-20261103-183606] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-claude-haiku-5-5-medium-20261103-183606].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need - other agents share this directory. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\\n\\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\\n\\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state (the engine’s game.advance and game.debug, as in game/test.mjs), including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\\n\\nEffort: Spend effort however you see fit.\\n\\n## Goal\\n\\nBuild an original game inspired by the source.\\n\\nScope\\n\\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\\n\\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\\n\\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game. \\n\\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\\n\\nNarrative tone: Use a writing style similar to the source’s.\\n\\n## UI & UX: 10-Foot Controller-First Philosophy\\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\\n\\nDo not use overly dense, web-style data screens.\\n\\nTouch-only devices: no touch controls; show \\\"Controller or keyboard required\\\" and the settings button. Let the attract mode run.\\n\\n## Done\\nNo TODOs, placeholders, or stubbed features. The demo is complete.\\n\\n## Source Information\\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \\\"unknown\\\" for anything you can't confirm.\\n- Date: 2026-11-03 18:36:06\\n- Source: the work it's based on\\n- Plan: the file name of the plan you were given to build from, or none\\n- Genre and Perspective: genre and camera perspective used\\n- Tech: stack, libraries/engines, with versions if applicable\\n- Art Direction: style used\\n- Animation: system used\\n- Audio: music, sound effects and voice used\\n- Online: network features used, or none\\n- Testing: testing parameters allowed\\n- Research: research done, or none\\n- Environment: Claude Code CLI (headless); Linux; browser unknown\\n- Model: Anthropic, claude-haiku-5-5, reasoning effort medium\\n- Usage: the estimated API cost in USD, total number of tokens in K or M (provide break down if available) and session time, only if estimates are available.\\n\\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\\\"unknown\\\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\\n{\\n  \\\"sourceInformation\\\": {\\\"date\\\": \\\"\\\", \\\"source\\\": \\\"\\\", \\\"plan\\\": \\\"\\\", \\\"genre\\\": \\\"\\\", \\\"perspective\\\": \\\"\\\", \\\"tech\\\": \\\"\\\", \\\"artDirection\\\": \\\"\\\", \\\"animation\\\": \\\"\\\", \\\"audio\\\": \\\"\\\", \\\"online\\\": \\\"\\\", \\\"testing\\\": \\\"\\\", \\\"research\\\": \\\"\\\", \\\"environment\\\": \\\"\\\", \\\"model\\\": \\\"\\\", \\\"usage\\\": \\\"\\\"},\\n  \\\"testingFeedback\\\": [\\\"your answer to each Testing Feedback question, in order\\\"],\\n  \\\"engineFeedback\\\": [\\\"your answer to each Engine Feedback question, in order\\\"],\\n  \\\"promptFeedback\\\": [\\\"your answer to each Prompt Feedback question, in order\\\"],\\n  \\\"aiHub\\\": {\\n    \\\"name\\\": \\\"the game's title, as on its title screen\\\",\\n    \\\"tagline\\\": \\\"a few words to go under the title\\\",\\n    \\\"description\\\": \\\"one or two sentences for the catalogue\\\",\\n    \\\"type\\\": \\\"Game, Tech demo or Tool\\\",\\n    \\\"genre\\\": \\\"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\\\",\\n    \\\"source\\\": \\\"the work it's based on, e.g. Moby-Dick\\\",\\n    \\\"series\\\": \\\"its franchise, e.g. Star Fox, or empty\\\",\\n    \\\"players\\\": \\\"how many can play: 1, 1–2 or 1–4\\\",\\n    \\\"controls\\\": \\\"the controls, in one line\\\",\\n    \\\"tags\\\": [\\\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\\\"]\\n  }\\n}\\n\\nTesting Feedback\\n\\n- How many issues did testing catch?\\n- How many would be considered critical issues / game breaking?\\n- What was the most helpful test you ran?\\n- What was the least helpful test you ran? \\n\\nEngine Feedback\\n\\n- What did you like most about the engine?\\n- Did you get stuck or guess wrong?\\n- What was the most important thing you had to build yourself?\\n- What was the hardest part about using the engine?\\n- What did you change in the engine, and why? (none if nothing)\\n- If you could change one thing about the engine, what would it be?\\n\\nPrompt Feedback \\n\\n- What did you like most about this prompt?\\n- What was confusing?\\n- What was the hardest thing to do?\\n- What would you change in this prompt?\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"9cdefc10-dd96-4250-9292-d55bd20762ae\",\"uuid\":\"aa4152d7-8453-40f6-aab7-c738129f22c6\",\"timestamp\":\"2026-11-04T01:36:09.604Z\",\"tool_use_result\":{\"stdout\":\"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183606__xf7f297/work\\ntotal 152\\ndrwxr-xr-x 2 micha micha   4096 Nov  3 18:36 .\\ndrwxr-xr-x 3 micha micha   4096 Nov  3 18:36 ..\\n-rw-r--r-- 1 micha micha 129055 Nov  3 18:36 PLAN.md\\n-rw-r--r-- 1 micha micha    347 Nov  3 18:36 STAGE.md\\n-rw-r--r-- 1 micha micha   8791 Nov  3 18:36 TASK.md\\nRead TASK.md (what to build) and PLAN.md (how to build it, written by claude-opus-5-5 at max effort) in this folder. Build the game TASK.md describes, following the plan and using the title it gives; where they disagree, TASK.md wins. Deliver everything TASK.md asks for, including its file name, and the sections it asks for in your final reply.\\n---\\nSOURCE: Tenchu 2: Birth of the Stealth Assassins\\n\\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\\n\\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\\n\\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\\n\\nResearch: Whether and how much to research is your choice.\\n\\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-claude-haiku-5-5-medium-20261103-183606.html]. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\\n\\nTech Stack: Build on https://github.com/michaelcrosato/my-3d2dge/tree/main/dist/handoff. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\\n\\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\\n\\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\\n\\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish.\\n\\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\\n\\nWorking Environment and deliverable:\\nCreate a subfolder called [GameTitle-SOURCE-claude-haiku-5-5-medium-20261103-183606] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-claude-haiku-5-5-medium-20261103-183606].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need - other agents share this directory. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\\n\\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\\n\\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state (the engine’s game.advance and game.debug, as in game/test.mjs), including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\\n\\nEffort: Spend effort however you see fit.\\n\\n## Goal\\n\\nBuild an original game inspired by the source.\\n\\nScope\\n\\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\\n\\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\\n\\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game. \\n\\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\\n\\nNarrative tone: Use a writing style similar to the source’s.\\n\\n## UI & UX: 10-Foot Controller-First Philosophy\\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\\n\\nDo not use overly dense, web-style data screens.\\n\\nTouch-only devices: no touch controls; show \\\"Controller or keyboard required\\\" and the settings button. Let the attract mode run.\\n\\n## Done\\nNo TODOs, placeholders, or stubbed features. The demo is complete.\\n\\n## Source Information\\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \\\"unknown\\\" for anything you can't confirm.\\n- Date: 2026-11-03 18:36:06\\n- Source: the work it's based on\\n- Plan: the file name of the plan you were given to build from, or none\\n- Genre and Perspective: genre and camera perspective used\\n- Tech: stack, libraries/engines, with versions if applicable\\n- Art Direction: style used\\n- Animation: system used\\n- Audio: music, sound effects and voice used\\n- Online: network features used, or none\\n- Testing: testing parameters allowed\\n- Research: research done, or none\\n- Environment: Claude Code CLI (headless); Linux; browser unknown\\n- Model: Anthropic, claude-haiku-5-5, reasoning effort medium\\n- Usage: the estimated API cost in USD, total number of tokens in K or M (provide break down if available) and session time, only if estimates are available.\\n\\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\\\"unknown\\\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\\n{\\n  \\\"sourceInformation\\\": {\\\"date\\\": \\\"\\\", \\\"source\\\": \\\"\\\", \\\"plan\\\": \\\"\\\", \\\"genre\\\": \\\"\\\", \\\"pers