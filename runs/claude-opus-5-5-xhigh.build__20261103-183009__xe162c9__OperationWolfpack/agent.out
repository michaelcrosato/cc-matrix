{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh2kuVSvekpZtgaznn1r","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3109,"cache_read_input_tokens":228719,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3109},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a0704575-f16b-44ea-a24d-907e9c278025","uuid":"30ab9d42-77ab-43b9-a3d3-c499fc787bdc","timestamp":"2026-11-04T01:37:25.932Z","request_id":"req_011Cgh2kuGof84GpnvMvpxK8","thinking_duration_ms":42837,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh2kuVSvekpZtgaznn1r","type":"message","role":"assistant","content":[{"type":"text","text":"Hat colors come from `hat: { style, color }`. Now the core of the Sim. First the type registry (bestiary, vehicles, props, pickups, projectiles) and the screen-space hit shapes."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3109,"cache_read_input_tokens":228719,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3109},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a0704575-f16b-44ea-a24d-907e9c278025","uuid":"9b2e7de0-2df5-44bb-b7c5-c1d038202bd3","timestamp":"2026-11-04T01:37:25.934Z","request_id":"req_011Cgh2kuGof84GpnvMvpxK8"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh2kuVSvekpZtgaznn1r","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QQFDPskqV3vWMEBcvHDW2Y","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/src/20-entities.js","content":"// The type registry (WP.TYPES: the bestiary, vehicles, friendlies, props, pickups, projectiles) and the hit shapes\n// every hittable thing produces in screen space each step (WP.Hit).\n(() => {\nconst E = My3D2dge, WP = globalThis.WP, { clamp } = WP;\n\n// calibrated drawn heights (px at rig view scale 1, standing), measured from the engine's own drawing (dev/spike.html)\nWP.RIG_H = { chibi: 38 / 1.3, bulky: 47 / 1.55, coat: 39 / 1.35 };\nWP.KNEEL = 31 / 38; WP.CROUCH = 32 / 38;\n\nconst T = WP.TYPES = {};\nconst inf = (id, o) => { T[id] = Object.assign({ id, kind: 'infantry', quota: 'soldier', hp: 1, score: 100, size: 1.3, build: 'chibi', headMul: 2 }, o); };\n// ---------- the Hyena Legion (8.4, VETERAN values) ----------\ninf('rifleman', { name: 'RIFLEMAN', fire: { tele: 1.3, bullets: [1, 3], acc: .45, dmg: 4 } });\ninf('grenadier', { name: 'GRENADIER', hp: 2, score: 150, throws: { proj: 'grenade', tele: .6 } });\ninf('knife', { name: 'KNIFE', size: 1.25, score: 200, throws: { proj: 'knife', tele: .45 } });\ninf('brute', { name: 'BRUTE', hp: 8, size: 1.55, build: 'bulky', score: 500, headMul: 4, fire: { tele: 1.6, bullets: [5, 5], acc: .30, dmg: 4 } });\ninf('rpg', { name: 'RPG', hp: 2, score: 300, fire: { tele: 1.5, proj: 'rocket' } });\ninf('sniper', { name: 'SNIPER', score: 400, fire: { tele: 2.4, bullets: [1, 1], acc: .85, dmg: 10, glint: true } });\ninf('mortar', { name: 'MORTAR', size: 1.2, score: 200, fire: { tele: 6, proj: 'mortar', noRing: true } });\ninf('officer', { name: 'OFFICER', hp: 2, size: 1.35, build: 'coat', score: 600, whistle: 2 });\ninf('para', { name: 'PARATROOPER', score: 150, fire: { tele: 1.3, bullets: [1, 3], acc: .45, dmg: 4 } });\n// ---------- vehicles, boats, aircraft (8.5) ----------\nconst veh = (id, o) => { T[id] = Object.assign({ id, kind: 'vehicle', quota: 'vehicle' }, o); };\nveh('jeep', { name: 'SCAVENGER', hp: 14, score: 1000, shape: 'jeep', box: [20, 34, 16], speed: 80, gunners: [[0, -4, 15]], gfire: { tele: 1.2, bullets: [3, 3], acc: .45, dmg: 4 } });\nveh('truck', { name: 'HAULER', hp: 20, score: 1200, shape: 'truck', box: [26, 58, 30], speed: 60, unload: 4 });\nveh('apc', { name: 'BADGER', hp: 32, score: 2000, shape: 'apc', box: [28, 52, 24], speed: 40, unload: 3, tfire: { tele: 1.8, proj: 'rocket', every: 5 } });\nveh('tank', { name: 'MAULER', hp: 48, score: 3000, shape: 'tank', box: [34, 56, 24], speed: 30, tfire: { tele: 2.0, proj: 'shell', every: 5.5 } });\nveh('skiff', { name: 'SKIFF', kind: 'boat', quota: 'boat', hp: 10, score: 800, shape: 'skiff', box: [16, 40, 8], speed: 70, gunners: [[0, 6, 6], [0, -10, 6]], gfire: { tele: 1.3, bullets: [1, 2], acc: .45, dmg: 4 } });\nveh('gunboat', { name: 'PATROL BOAT', kind: 'boat', quota: 'boat', hp: 26, score: 1500, shape: 'gunboat', box: [24, 60, 18], speed: 50, tfire: { tele: 1.4, bullets: [4, 4], acc: .45, dmg: 4, every: 3.5 } });\nveh('heli', { name: 'VULTURE', kind: 'air', quota: 'air', hp: 34, score: 3000, shape: 'heli', box: [16, 52, 18], speed: 90, tfire: { tele: 1.6, bullets: [6, 6], acc: .35, dmg: 3, every: 4 }, missiles: 7 });\nveh('samtruck', { name: 'SAM TRUCK', hp: 16, score: 2000, shape: 'truck', box: [26, 58, 30], speed: 0, quota: null });\nveh('forklift', { name: 'FORKLIFT', hp: 6, score: 300, shape: 'forklift', box: [14, 22, 14], speed: 45, quota: null, carry: 'gbox' });\nveh('cargoPlane', { name: 'CARGO PLANE', kind: 'air', quota: null, hp: 9999, score: 0, shape: 'cargoPlane', box: [0, 0, 0], speed: 120, scenery: true });\nveh('friendTruck', { name: 'FRIENDLY TRUCK', quota: null, hp: 9999, score: 0, shape: 'truckFriendly', box: [26, 58, 30], speed: 60, friendly: true });\n// ---------- bosses (8.7): parts per phase in 25-bosses.js ----------\nconst boss = (id, o) => { T[id] = Object.assign({ id, kind: 'boss', quota: null, hp: 1 }, o); };\nboss('bigEar', { name: \"SIGNAL TRUCK 'BIG EAR'\", score: 10000, shape: 'bigEar', box: [34, 80, 34] });\nboss('crocodile', { name: \"GUNBOAT 'CROCODILE'\", score: 14000, shape: 'crocodile', box: [44, 110, 26] });\nboss('warthog', { name: \"HALF-TRACK 'WARTHOG'\", score: 18000, shape: 'halftrack', box: [32, 64, 28] });\nboss('ironHog', { name: \"ARMORED TRAIN 'IRON HOG'\", score: 22000, shape: 'locomotive', box: [30, 70, 36] });\nboss('tusk', { name: 'THE WARDEN, MAJOR TUSK', score: 26000, shape: 'bossTower', box: [60, 60, 90] });\nboss('hyenaOne', { name: \"GUNSHIP 'HYENA ONE'\", score: 30000, shape: 'hyenaOne', box: [24, 76, 24] });\n// ---------- friendlies ----------\nT.villager = { id: 'villager', kind: 'civ', size: 1.25, build: 'chibi', hp: 1 };\nT.medic = { id: 'medic', kind: 'civ', size: 1.25, build: 'chibi', hp: 1 };\nT.reporter = { id: 'reporter', kind: 'civ', size: 1.25, build: 'chibi', hp: 1, reporter: true };\nT.hostage = { id: 'hostage', kind: 'hostage', size: 1.25, build: 'chibi', hp: 3 };\nfor (const a of ['goat', 'chicken', 'pig', 'parrot', 'monkey', 'seagull']) T[a] = { id: a, kind: 'animal', hp: 1, R: { goat: 7, chicken: 4, pig: 7, parrot: 4, monkey: 5, seagull: 4 }[a], fly: a === 'parrot' || a === 'seagull' };\nT.dummy = { id: 'dummy', kind: 'infantry', quota: null, hp: 3, score: 50, size: 1.3, build: 'chibi', headMul: 2, name: 'DUMMY' };\n// ---------- props (7.12) ----------\nconst prop = (id, o) => { T[id] = Object.assign({ id, kind: 'prop' }, o); };\nprop('crate', { hp: 3, shape: 'woodCrate', box: [15, 15, 14], drop: .6, mat: 'wood' });\nprop('ammoCrate', { hp: 3, shape: 'ammoCrate', box: [18, 12, 12], drop: 1, ammo: true, mat: 'wood' });\nprop('barrel', { hp: 4, shape: 'redBarrel', box: [12, 12, 17], blast: { r: 48, dmg: 10 }, mat: 'metal' });\nprop('sandbags', { hp: 40, shape: 'sandbags', box: [48, 12, 14], cover: true, mat: 'dirt', grenadeDmg: 15 });\nprop('mast', { hp: 25, shape: 'radioMast', box: [10, 10, 30], mat: 'metal', objective: 'masts' });\nprop('fuelTank', { hp: 20, shape: 'fuelTank', box: [40, 18, 26], cover: true, blast: { r: 90, dmg: 20 }, mat: 'metal' });\nprop('searchlight', { hp: 2, shape: 'searchlight', box: [8, 8, 8], mat: 'glass' });\nprop('rope', { hp: 6, shape: null, box: [4, 4, 10], mat: 'wood' });\nprop('ammoWagon', { hp: 4, shape: 'ammoWagon', box: [26, 56, 26], blast: { r: 70, dmg: 30 }, mat: 'wood' });\nprop('fuelTruck', { hp: 10, shape: 'fuelTruck', box: [26, 58, 28], blast: { r: 70, dmg: 18 }, cover: true, mat: 'metal' });\nprop('shutter', { hp: 1, shape: null, box: [10, 2, 12], mat: 'wood' });\nprop('wreck', { hp: 9999, shape: null, box: [20, 30, 14], cover: true, mat: 'metal' });\nprop('target', { hp: 9999, shape: 'rangeTarget', box: [16, 4, 30], mat: 'wood' });\n// ---------- pickups (7.13) ----------\nWP.PICKUPS = {\n  mag: { name: 'MAG' }, crate: { name: 'AMMO CRATE' }, gren: { name: 'GRENADE' }, gbox: { name: 'GRENADE BOX' },\n  ration: { name: 'RATION' }, medkit: { name: 'MEDKIT' }, fury: { name: 'FURY' }, dynamite: { name: 'DYNAMITE' },\n  flare: { name: 'FLARE' }, intel: { name: 'INTEL' }, fang: { name: 'WOLF FANG' }\n};\n// ---------- projectiles (7.7) ----------\nWP.PROJ = {\n  grenade: { T: 1.3, hits: 1, r: 4, dmg: 12, score: 50, apex: 60 },\n  knife: { T: .65, hits: 1, r: 3, dmg: 8, score: 100, apex: 6 },\n  rocket: { T: 1.6, hits: 1, r: 4, dmg: 16, score: 150, apex: 0, wobble: 2 },\n  missile: { T: 1.8, hits: 1, r: 4, dmg: 18, score: 200, apex: 10, home: true },\n  mortar: { T: 2.6, hits: 1, r: 4, dmg: 14, score: 100, apex: 260, marker: true },\n  shell: { T: .8, hits: 2, r: 6, dmg: 22, score: 250, apex: 0 },\n  flame: { T: 1.2, hits: 0, r: 10, dmg: 15, score: 0, apex: 0, ground: true },\n  steam: { T: .01, hits: 0, r: 1, dmg: 10, score: 0, apex: 0 }\n};\n\n// ---------- hit shapes (7.2) ----------\n// a shape: { e (entity), part, D (depth), kind: 'c' | 'r' | 'p', cx, cy, r | x0, y0, x1, y1 | pts, cover }\nconst Hit = WP.Hit = {};\nHit.rigH = (tp, e) => {\n  const base = tp.build === 'bulky' ? WP.RIG_H.bulky : tp.build === 'coat' ? WP.RIG_H.coat : WP.RIG_H.chibi;\n  let h = base * (e.size || tp.size || 1.3);\n  if (e.pose === 'kneel') h *= WP.KNEEL; else if (e.pose === 'crouch') h *= WP.CROUCH;\n  return h;\n};\n// the world height of a humanoid (units, standing), for explosions and anchors\nHit.worldH = tp => (tp.build === 'bulky' ? WP.RIG_H.bulky : tp.build === 'coat' ? WP.RIG_H.coat : WP.RIG_H.chibi) * (tp.size || 1.3);\nconst inPoly = (pts, x, y) => {\n  let ins = false;\n  for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {\n    const [xi, yi] = pts[i], [xj, yj] = pts[j];\n    if ((yi > y) !== (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi + 1e-9) + xi) ins = !ins;\n  }\n  return ins;\n};\nHit.contains = (s, x, y, grow = 0) => {\n  if (s.kind === 'c') return (x - s.cx) ** 2 + (y - s.cy) ** 2 <= (s.r + grow) ** 2;\n  if (s.kind === 'r') return x >= s.x0 - grow && x <= s.x1 + grow && y >= s.y0 - grow && y <= s.y1 + grow;\n  if (grow) { const b = s.bb; if (x < b[0] - grow || x > b[2] + grow || y < b[1] - grow || y > b[3] + grow) return false; if (inPoly(s.pts, x, y)) return true; return x >= b[0] - grow && x <= b[2] + grow && y >= b[1] - grow && y <= b[3] + grow && Math.min(Math.abs(x - b[0]), Math.abs(x - b[2]), Math.abs(y - b[1]), Math.abs(y - b[3])) <= grow; }\n  const b = s.bb; if (x < b[0] || x > b[2] || y < b[1] || y > b[3]) return false;\n  return inPoly(s.pts, x, y);\n};\nHit.center = s => s.kind === 'c' ? [s.cx, s.cy] : s.kind === 'r' ? [(s.x0 + s.x1) / 2, (s.y0 + s.y1) / 2] : [(s.bb[0] + s.bb[2]) / 2, (s.bb[1] + s.bb[3]) / 2];\nconst hull = pts => {\n  pts = pts.slice().sort((a, b) => a[0] - b[0] || a[1] - b[1]);\n  const cr = (o, a, b) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]), lo = [], up = [];\n  for (const p of pts) { while (lo.length >= 2 && cr(lo[lo.length - 2], lo[lo.length - 1], p) <= 0) lo.pop(); lo.push(p); }\n  for (let i = pts.length - 1; i >= 0; i--) { const p = pts[i]; while (up.length >= 2 && cr(up[up.length - 2], up[up.length - 1], p) <= 0) up.pop(); up.push(p); }\n  lo.pop(); up.pop(); return lo.concat(up);\n};\nHit.hull = hull;\n/** the projected hull of a box (w across, d along, h up; its front along facing) at (x, y, z) */\nHit.boxPoly = (view, x, y, z, box, facing) => {\n  const [w, d, h] = box, c = Math.cos(facing), s = Math.sin(facing), pts = [];\n  for (const a of [-1, 1]) for (const b of [-1, 1]) for (const zz of [0, h]) {\n    const fx = b * d / 2, sx = a * w / 2;   // forward along facing, side across\n    const wx = x + c * fx - s * sx, wy = y + s * fx + c * sx, p = view.project(wx, wy, z + zz);\n    if (!p) return null; pts.push([p[0], p[1]]);\n  }\n  const H = hull(pts); let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n  for (const [px, py] of H) { x0 = Math.min(x0, px); y0 = Math.min(y0, py); x1 = Math.max(x1, px); y1 = Math.max(y1, py); }\n  return { kind: 'p', pts: H, bb: [x0, y0, x1, y1] };\n};\n/** a local offset (ax across, ay forward, az up, in a shape's own frame) at facing -> a world point */\nHit.local = (e, off) => {\n  const f = e.facing, c = Math.cos(f), s = Math.sin(f), [ax, ay, az] = off;\n  return [e.x + c * ay - s * ax, e.y + s * ay + c * ax, (e.z || 0) + az];\n};\n/** the humanoid shapes for a rig standing at (sx, sy) with drawn height H px */\nHit.humanoid = (out, e, D, sx, sy, H, o = {}) => {\n  const hr = Math.max(2, .11 * H), bw = Math.max(2, .17 * H), lw = Math.max(1.5, .12 * H);\n  const head = { e, part: 'head', D: D - .1, kind: 'c', cx: sx, cy: sy - .87 * H, r: hr };\n  let body = { e, part: 'body', D, kind: 'r', x0: sx - bw, x1: sx + bw, y0: sy - .76 * H, y1: sy - .42 * H };\n  if (body.y1 - body.y0 < 8) { const m = (body.y0 + body.y1) / 2; body.y0 = m - 4; body.y1 = m + 4; }\n  if (body.x1 - body.x0 < 4) { body.x0 = sx - 2; body.x1 = sx + 2; }\n  const legs = { e, part: 'legs', D: D + .05, kind: 'r', x0: sx - lw, x1: sx + lw, y0: sy - .42 * H, y1: sy };\n  const clip = o.clip, below = o.coverY;\n  for (const s of [head, body, legs]) {\n    if (clip) {   // a window or door: everything clipped to the opening\n      if (s.kind === 'c') { if (s.cx < clip[0] || s.cx > clip[2] || s.cy < clip[1] || s.cy > clip[3]) continue; }\n      else { s.x0 = Math.max(s.x0, clip[0]); s.x1 = Math.min(s.x1, clip[2]); s.y0 = Math.max(s.y0, clip[1]); s.y1 = Math.min(s.y1, clip[3]); if (s.x1 <= s.x0 || s.y1 <= s.y0) continue; }\n    }\n    if (below !== undefined) {   // behind cover: below its top is removed\n      if (s.kind === 'c') { if (s.cy > below) continue; }\n      else { s.y1 = Math.min(s.y1, below); if (s.y1 <= s.y0 + 1) continue; }\n    }\n    if (o.noLegs && s === legs) continue;\n    out.push(s);\n  }\n};\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3109,"cache_read_input_tokens":228719,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3109},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a0704575-f16b-44ea-a24d-907e9c278025","uuid":"eaf260d3-708d-4ab1-8d29-0f9adce24769","timestamp":"2026-11-04T01:38:17.758Z","request_id":"req_011Cgh2kuGof84GpnvMvpxK8","wire_tool_inputs":{"toolu_01QQFDPskqV3vWMEBcvHDW2Y":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/src/20-entities.js","content":"// The type registry (WP.TYPES: the bestiary, vehicles, friendlies, props, pickups, projectiles) and the hit shapes\n// every hittable thing produces in screen space each step (WP.Hit).\n(() => {\nconst E = My3D2dge, WP = globalThis.WP, { clamp } = WP;\n\n// calibrated drawn heights (px at rig view scale 1, standing), measured from the engine's own drawing (dev/spike.html)\nWP.RIG_H = { chibi: 38 / 1.3, bulky: 47 / 1.55, coat: 39 / 1.35 };\nWP.KNEEL = 31 / 38; WP.CROUCH = 32 / 38;\n\nconst T = WP.TYPES = {};\nconst inf = (id, o) => { T[id] = Object.assign({ id, kind: 'infantry', quota: 'soldier', hp: 1, score: 100, size: 1.3, build: 'chibi', headMul: 2 }, o); };\n// ---------- the Hyena Legion (8.4, VETERAN values) ----------\ninf('rifleman', { name: 'RIFLEMAN', fire: { tele: 1.3, bullets: [1, 3], acc: .45, dmg: 4 } });\ninf('grenadier', { name: 'GRENADIER', hp: 2, score: 150, throws: { proj: 'grenade', tele: .6 } });\ninf('knife', { name: 'KNIFE', size: 1.25, score: 200, throws: { proj: 'knife', tele: .45 } });\ninf('brute', { name: 'BRUTE', hp: 8, size: 1.55, build: 'bulky', score: 500, headMul: 4, fire: { tele: 1.6, bullets: [5, 5], acc: .30, dmg: 4 } });\ninf('rpg', { name: 'RPG', hp: 2, score: 300, fire: { tele: 1.5, proj: 'rocket' } });\ninf('sniper', { name: 'SNIPER', score: 400, fire: { tele: 2.4, bullets: [1, 1], acc: .85, dmg: 10, glint: true } });\ninf('mortar', { name: 'MORTAR', size: 1.2, score: 200, fire: { tele: 6, proj: 'mortar', noRing: true } });\ninf('officer', { name: 'OFFICER', hp: 2, size: 1.35, build: 'coat', score: 600, whistle: 2 });\ninf('para', { name: 'PARATROOPER', score: 150, fire: { tele: 1.3, bullets: [1, 3], acc: .45, dmg: 4 } });\n// ---------- vehicles, boats, aircraft (8.5) ----------\nconst veh = (id, o) => { T[id] = Object.assign({ id, kind: 'vehicle', quota: 'vehicle' }, o); };\nveh('jeep', { name: 'SCAVENGER', hp: 14, score: 1000, shape: 'jeep', box: [20, 34, 16], speed: 80, gunners: [[0, -4, 15]], gfire: { tele: 1.2, bullets: [3, 3], acc: .45, dmg: 4 } });\nveh('truck', { name: 'HAULER', hp: 20, score: 1200, shape: 'truck', box: [26, 58, 30], speed: 60, unload: 4 });\nveh('apc', { name: 'BADGER', hp: 32, score: 2000, shape: 'apc', box: [28, 52, 24], speed: 40, unload: 3, tfire: { tele: 1.8, proj: 'rocket', every: 5 } });\nveh('tank', { name: 'MAULER', hp: 48, score: 3000, shape: 'tank', box: [34, 56, 24], speed: 30, tfire: { tele: 2.0, proj: 'shell', every: 5.5 } });\nveh('skiff', { name: 'SKIFF', kind: 'boat', quota: 'boat', hp: 10, score: 800, shape: 'skiff', box: [16, 40, 8], speed: 70, gunners: [[0, 6, 6], [0, -10, 6]], gfire: { tele: 1.3, bullets: [1, 2], acc: .45, dmg: 4 } });\nveh('gunboat', { name: 'PATROL BOAT', kind: 'boat', quota: 'boat', hp: 26, score: 1500, shape: 'gunboat', box: [24, 60, 18], speed: 50, tfire: { tele: 1.4, bullets: [4, 4], acc: .45, dmg: 4, every: 3.5 } });\nveh('heli', { name: 'VULTURE', kind: 'air', quota: 'air', hp: 34, score: 3000, shape: 'heli', box: [16, 52, 18], speed: 90, tfire: { tele: 1.6, bullets: [6, 6], acc: .35, dmg: 3, every: 4 }, missiles: 7 });\nveh('samtruck', { name: 'SAM TRUCK', hp: 16, score: 2000, shape: 'truck', box: [26, 58, 30], speed: 0, quota: null });\nveh('forklift', { name: 'FORKLIFT', hp: 6, score: 300, shape: 'forklift', box: [14, 22, 14], speed: 45, quota: null, carry: 'gbox' });\nveh('cargoPlane', { name: 'CARGO PLANE', kind: 'air', quota: null, hp: 9999, score: 0, shape: 'cargoPlane', box: [0, 0, 0], speed: 120, scenery: true });\nveh('friendTruck', { name: 'FRIENDLY TRUCK', quota: null, hp: 9999, score: 0, shape: 'truckFriendly', box: [26, 58, 30], speed: 60, friendly: true });\n// ---------- bosses (8.7): parts per phase in 25-bosses.js ----------\nconst boss = (id, o) => { T[id] = Object.assign({ id, kind: 'boss', quota: null, hp: 1 }, o); };\nboss('bigEar', { name: \"SIGNAL TRUCK 'BIG EAR'\", score: 10000, shape: 'bigEar', box: [34, 80, 34] });\nboss('crocodile', { name: \"GUNBOAT 'CROCODILE'\", score: 14000, shape: 'crocodile', box: [44, 110, 26] });\nboss('warthog', { name: \"HALF-TRACK 'WARTHOG'\", score: 18000, shape: 'halftrack', box: [32, 64, 28] });\nboss('ironHog', { name: \"ARMORED TRAIN 'IRON HOG'\", score: 22000, shape: 'locomotive', box: [30, 70, 36] });\nboss('tusk', { name: 'THE WARDEN, MAJOR TUSK', score: 26000, shape: 'bossTower', box: [60, 60, 90] });\nboss('hyenaOne', { name: \"GUNSHIP 'HYENA ONE'\", score: 30000, shape: 'hyenaOne', box: [24, 76, 24] });\n// ---------- friendlies ----------\nT.villager = { id: 'villager', kind: 'civ', size: 1.25, build: 'chibi', hp: 1 };\nT.medic = { id: 'medic', kind: 'civ', size: 1.25, build: 'chibi', hp: 1 };\nT.reporter = { id: 'reporter', kind: 'civ', size: 1.25, build: 'chibi', hp: 1, reporter: true };\nT.hostage = { id: 'hostage', kind: 'hostage', size: 1.25, build: 'chibi', hp: 3 };\nfor (const a of ['goat', 'chicken', 'pig', 'parrot', 'monkey', 'seagull']) T[a] = { id: a, kind: 'animal', hp: 1, R: { goat: 7, chicken: 4, pig: 7, parrot: 4, monkey: 5, seagull: 4 }[a], fly: a === 'parrot' || a === 'seagull' };\nT.dummy = { id: 'dummy', kind: 'infantry', quota: null, hp: 3, score: 50, size: 1.3, build: 'chibi', headMul: 2, name: 'DUMMY' };\n// ---------- props (7.12) ----------\nconst prop = (id, o) => { T[id] = Object.assign({ id, kind: 'prop' }, o); };\nprop('crate', { hp: 3, shape: 'woodCrate', box: [15, 15, 14], drop: .6, mat: 'wood' });\nprop('ammoCrate', { hp: 3, shape: 'ammoCrate', box: [18, 12, 12], drop: 1, ammo: true, mat: 'wood' });\nprop('barrel', { hp: 4, shape: 'redBarrel', box: [12, 12, 17], blast: { r: 48, dmg: 10 }, mat: 'metal' });\nprop('sandbags', { hp: 40, shape: 'sandbags', box: [48, 12, 14], cover: true, mat: 'dirt', grenadeDmg: 15 });\nprop('mast', { hp: 25, shape: 'radioMast', box: [10, 10, 30], mat: 'metal', objective: 'masts' });\nprop('fuelTank', { hp: 20, shape: 'fuelTank', box: [40, 18, 26], cover: true, blast: { r: 90, dmg: 20 }, mat: 'metal' });\nprop('searchlight', { hp: 2, shape: 'searchlight', box: [8, 8, 8], mat: 'glass' });\nprop('rope', { hp: 6, shape: null, box: [4, 4, 10], mat: 'wood' });\nprop('ammoWagon', { hp: 4, shape: 'ammoWagon', box: [26, 56, 26], blast: { r: 70, dmg: 30 }, mat: 'wood' });\nprop('fuelTruck', { hp: 10, shape: 'fuelTruck', box: [26, 58, 28], blast: { r: 70, dmg: 18 }, cover: true, mat: 'metal' });\nprop('shutter', { hp: 1, shape: null, box: [10, 2, 12], mat: 'wood' });\nprop('wreck', { hp: 9999, shape: null, box: [20, 30, 14], cover: true, mat: 'metal' });\nprop('target', { hp: 9999, shape: 'rangeTarget', box: [16, 4, 30], mat: 'wood' });\n// ---------- pickups (7.13) ----------\nWP.PICKUPS = {\n  mag: { name: 'MAG' }, crate: { name: 'AMMO CRATE' }, gren: { name: 'GRENADE' }, gbox: { name: 'GRENADE BOX' },\n  ration: { name: 'RATION' }, medkit: { name: 'MEDKIT' }, fury: { name: 'FURY' }, dynamite: { name: 'DYNAMITE' },\n  flare: { name: 'FLARE' }, intel: { name: 'INTEL' }, fang: { name: 'WOLF FANG' }\n};\n// ---------- projectiles (7.7) ----------\nWP.PROJ = {\n  grenade: { T: 1.3, hits: 1, r: 4, dmg: 12, score: 50, apex: 60 },\n  knife: { T: .65, hits: 1, r: 3, dmg: 8, score: 100, apex: 6 },\n  rocket: { T: 1.6, hits: 1, r: 4, dmg: 16, score: 150, apex: 0, wobble: 2 },\n  missile: { T: 1.8, hits: 1, r: 4, dmg: 18, score: 200, apex: 10, home: true },\n  mortar: { T: 2.6, hits: 1, r: 4, dmg: 14, score: 100, apex: 260, marker: true },\n  shell: { T: .8, hits: 2, r: 6, dmg: 22, score: 250, apex: 0 },\n  flame: { T: 1.2, hits: 0, r: 10, dmg: 15, score: 0, apex: 0, ground: true },\n  steam: { T: .01, hits: 0, r: 1, dmg: 10, score: 0, apex: 0 }\n};\n\n// ---------- hit shapes (7.2) ----------\n// a shape: { e (entity), part, D (depth), kind: 'c' | 'r' | 'p', cx, cy, r | x0, y0, x1, y1 | pts, cover }\nconst Hit = WP.Hit = {};\nHit.rigH = (tp, e) => {\n  const base = tp.build === 'bulky' ? WP.RIG_H.bulky : tp.build === 'coat' ? WP.RIG_H.coat : WP.RIG_H.chibi;\n  let h = base * (e.size || tp.size || 1.3);\n  if (e.pose === 'kneel') h *= WP.KNEEL; else if (e.pose === 'crouch') h *= WP.CROUCH;\n  return h;\n};\n// the world height of a humanoid (units, standing), for explosions and anchors\nHit.worldH = tp => (tp.build === 'bulky' ? WP.RIG_H.bulky : tp.build === 'coat' ? WP.RIG_H.coat : WP.RIG_H.chibi) * (tp.size || 1.3);\nconst inPoly = (pts, x, y) => {\n  let ins = false;\n  for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {\n    const [xi, yi] = pts[i], [xj, yj] = pts[j];\n    if ((yi > y) !== (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi + 1e-9) + xi) ins = !ins;\n  }\n  return ins;\n};\nHit.contains = (s, x, y, grow = 0) => {\n  if (s.kind === 'c') return (x - s.cx) ** 2 + (y - s.cy) ** 2 <= (s.r + grow) ** 2;\n  if (s.kind === 'r') return x >= s.x0 - grow && x <= s.x1 + grow && y >= s.y0 - grow && y <= s.y1 + grow;\n  if (grow) { const b = s.bb; if (x < b[0] - grow || x > b[2] + grow || y < b[1] - grow || y > b[3] + grow) return false; if (inPoly(s.pts, x, y)) return true; return x >= b[0] - grow && x <= b[2] + grow && y >= b[1] - grow && y <= b[3] + grow && Math.min(Math.abs(x - b[0]), Math.abs(x - b[2]), Math.abs(y - b[1]), Math.abs(y - b[3])) <= grow; }\n  const b = s.bb; if (x < b[0] || x > b[2] || y < b[1] || y > b[3]) return false;\n  return inPoly(s.pts, x, y);\n};\nHit.center = s => s.kind === 'c' ? [s.cx, s.cy] : s.kind === 'r' ? [(s.x0 + s.x1) / 2, (s.y0 + s.y1) / 2] : [(s.bb[0] + s.bb[2]) / 2, (s.bb[1] + s.bb[3]) / 2];\nconst hull = pts => {\n  pts = pts.slice().sort((a, b) => a[0] - b[0] || a[1] - b[1]);\n  const cr = (o, a, b) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]), lo = [], up = [];\n  for (const p of pts) { while (lo.length >= 2 && cr(lo[lo.length - 2], lo[lo.length - 1], p) <= 0) lo.pop(); lo.push(p); }\n  for (let i = pts.length - 1; i >= 0; i--) { const p = pts[i]; while (up.length >= 2 && cr(up[up.length - 2], up[up.length - 1], p) <= 0) up.pop(); up.push(p); }\n  lo.pop(); up.pop(); return lo.concat(up);\n};\nHit.hull = hull;\n/** the projected hull of a box (w across, d along, h up; its front along facing) at (x, y, z) */\nHit.boxPoly = (view, x, y, z, box, facing) => {\n  const [w, d, h] = box, c = Math.cos(facing), s = Math.sin(facing), pts = [];\n  for (const a of [-1, 1]) for (const b of [-1, 1]) for (const zz of [0, h]) {\n    const fx = b * d / 2, sx = a * w / 2;   // forward along facing, side across\n    const wx = x + c * fx - s * sx, wy = y + s * fx + c * sx, p = view.project(wx, wy, z + zz);\n    if (!p) return null; pts.push([p[0], p[1]]);\n  }\n  const H = hull(pts); let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n  for (const [px, py] of H) { x0 = Math.min(x0, px); y0 = Math.min(y0, py); x1 = Math.max(x1, px); y1 = Math.max(y1, py); }\n  return { kind: 'p', pts: H, bb: [x0, y0, x1, y1] };\n};\n/** a local offset (ax across, ay forward, az up, in a shape's own frame) at facing -> a world point */\nHit.local = (e, off) => {\n  const f = e.facing, c = Math.cos(f), s = Math.sin(f), [ax, ay, az] = off;\n  return [e.x + c * ay - s * ax, e.y + s * ay + c * ax, (e.z || 0) + az];\n};\n/** the humanoid shapes for a rig standing at (sx, sy) with drawn height H px */\nHit.humanoid = (out, e, D, sx, sy, H, o = {}) => {\n  const hr = Math.max(2, .11 * H), bw = Math.max(2, .17 * H), lw = Math.max(1.5, .12 * H);\n  const head = { e, part: 'head', D: D - .1, kind: 'c', cx: sx, cy: sy - .87 * H, r: hr };\n  let body = { e, part: 'body', D, kind: 'r', x0: sx - bw, x1: sx + bw, y0: sy - .76 * H, y1: sy - .42 * H };\n  if (body.y1 - body.y0 < 8) { const m = (body.y0 + body.y1) / 2; body.y0 = m - 4; body.y1 = m + 4; }\n  if (body.x1 - body.x0 < 4) { body.x0 = sx - 2; body.x1 = sx + 2; }\n  const legs = { e, part: 'legs', D: D + .05, kind: 'r', x0: sx - lw, x1: sx + lw, y0: sy - .42 * H, y1: sy };\n  const clip = o.clip, below = o.coverY;\n  for (const s of [head, body, legs]) {\n    if (clip) {   // a window or door: everything clipped to the opening\n      if (s.kind === 'c') { if (s.cx < clip[0] || s.cx > clip[2] || s.cy < clip[1] || s.cy > clip[3]) continue; }\n      else { s.x0 = Math.max(s.x0, clip[0]); s.x1 = Math.min(s.x1, clip[2]); s.y0 = Math.max(s.y0, clip[1]); s.y1 = Math.min(s.y1, clip[3]); if (s.x1 <= s.x0 || s.y1 <= s.y0) continue; }\n    }\n    if (below !== undefined) {   // behind cover: below its top is removed\n      if (s.kind === 'c') { if (s.cy > below) continue; }\n      else { s.y1 = Math.min(s.y1, below); if (s.y1 <= s.y0 + 1) continue; }\n    }\n    if (o.noLegs && s === legs) continue;\n    out.push(s);\n  }\n};\n})();\n"}}}
