if (e.state === 'hide') e.exposedT = 0;"]},{"oldStart":16590,"oldLines":13,"newStart":16595,"newLines":14,"lines":[" }"," function pickPeek(sim, e) { const p = e.cover ? e.cover.peek : ['up']; return tall(e) ? 'side' : sim.rng('ai').pick(p) === 'up' ? 'up' : 'side'; }"," function relocate(sim, e) {","-  const free = Object.values(sim.covers).filter(c => c.busy === 0 && c !== e.cover && !c.noMove);","+  if (e.cover && e.cover.ledge) return;","+  const free = Object.values(sim.covers).filter(c => c.busy === 0 && c !== e.cover && !c.noMove && !c.ledge && Math.abs(c.at[2] - e.z) < 4);","   if (!free.length) return;","   const c = sim.rng('ai').pick(free); if (vdist(c.at, e.cover ? e.cover.at : [e.x, e.y, e.z]) > 260) return;","   if (e.cover) e.cover.busy--; c.busy++; e.cover = c; e.to = c.at.slice(); e.state = 'move'; e.side = 0; e.up = 1;"," }"," function muzzle(e) {","-  const f = e.facing, s = e.size, zb = e.z - e.sinkNow, sd = e.side * 12;","+  const f = e.facing, s = e.size, zb = e.z - e.sinkNow, sd = e.side * 14;","   if (e.A.ai === 'drone') return [e.x, e.y, e.z - 3];","   return [e.x + Math.cos(f) * 16 * s - Math.sin(f) * (sd + 2), e.y + Math.sin(f) * 16 * s + Math.cos(f) * (sd + 2), zb + 23 * s * (e.up > .5 ? 1 : .8)];"," }"]},{"oldStart":16829,"oldLines":15,"newStart":16835,"newLines":15,"lines":[" function coverPoint(sim, i, ahead = 18) { const c = sim.poseOf(i, 'stand'), f = [Math.cos(c.yaw), Math.sin(c.yaw), 0]; return [c.x + f[0] * ahead, c.y + f[1] * ahead, c.z - 6]; }"," TC.coverPoint = coverPoint;"," function lobGrenade(sim, e, at) {","-  const tgt = coverPoint(sim, e.target, 34 + sim.rng('proj')() * 20), T = 1.1 + sim.rng('proj')() * .3, g = 240;","+  const tgt = coverPoint(sim, e.target, 34 + sim.rng('proj')() * 20), T0 = 1.1 + sim.rng('proj')() * .3, g = 240;","+  const th = requestThreat(sim, { src: e.id, target: e.target, dur: T0, kind: 'grenade', at, always: true, proj: true }), T = th ? th.dur : T0;","   const vel = [(tgt[0] - at[0]) / T, (tgt[1] - at[1]) / T, (tgt[2] - at[2]) / T + .5 * g * T];","-  const th = requestThreat(sim, { src: e.id, target: e.target, dur: T, kind: 'grenade', at, always: true, proj: true });","   return spawnProjectile(sim, 'grenade', at, vel, { gravity: g, target: e.target, threat: th, arrive: T, src: e.id });"," }"," TC.lobGrenade = lobGrenade;"," function fireRocket(sim, src, at, kind = 'rocket', o = {}) {","-  const tgt = o.to || coverPoint(sim, src.target !== undefined ? src.target : 0, 14), d = vsub(tgt, at), L = vlen(d), sp = o.speed || (kind === 'torpedo' ? 120 : kind === 'flare' ? 160 : kind === 'harpoon' ? 300 : 220), T = L / sp;","-  const th = requestThreat(sim, { src: src.id, target: src.target || 0, dur: T, kind, at, always: true, proj: true, unblockable: kind === 'torpedo' });","+  const tgt = o.to || coverPoint(sim, src.target !== undefined ? src.target : 0, 14), d = vsub(tgt, at), L = vlen(d), sp0 = o.speed || (kind === 'torpedo' ? 120 : kind === 'flare' ? 160 : kind === 'harpoon' ? 300 : 220), T0 = L / sp0;","+  const th = requestThreat(sim, { src: src.id, target: src.target || 0, dur: T0, kind, at, always: true, proj: true, unblockable: kind === 'torpedo' }), T = th ? th.dur : T0, sp = L / T;","   let vel = vmul(vnorm(d), sp), g = 0;","   if (kind === 'missile') { g = 160; vel = [d[0] / T, d[1] / T, d[2] / T + .5 * g * T]; }","   return spawnProjectile(sim, kind, at, vel, { gravity: g, target: src.target || 0, threat: th, arrive: T, src: src.id, to: tgt });"]},{"oldStart":16860,"oldLines":6,"newStart":16866,"newLines":7,"lines":["     }","     if (pr.team === 'fx') { if (pr.life <= 0) pr.dead = true; continue; }","     // enemy projectiles arrive at their target: the threat resolves there","+    if (pr.threat && !pr.threat.done && pr.arrive !== undefined) pr.threat.left = pr.arrive - pr.t;","     if (pr.arrive !== undefined && pr.t >= pr.arrive) {","       pr.dead = true;","       if (pr.threat && !pr.threat.done) resolveThreat(sim, pr.threat);"]},{"oldStart":17095,"oldLines":12,"newStart":17102,"newLines":12,"lines":[" def('boss', 'bulldog', { name: 'BULLDOG', title: 'Armored truck', card: false, slow: false, bonus: 8000,","   parts: { tank: { hp: 6, r: 8, weak: true, score: 6000, noMul: false } },","   init(B, sim) { const s = sim.scene.bulldog; B.from = s.from; B.to = s.to; B.x = s.from[0]; B.y = s.from[1]; B.z = s.from[2]; B.yaw = Math.atan2(s.to[1] - s.from[1], s.to[0] - s.from[0]); B.u = 0; sim.emit('fx', { kind: 'crash', at: s.from }); },","-  pose(B, sim, dt) { B.u = Math.min(1, B.u + dt / 1.6); const k = 1 - Math.pow(1 - B.u, 3); B.x = lerp(B.from[0], B.to[0], k); B.y = lerp(B.from[1], B.to[1], k); B.part('tank').pos = boatXY(B, [-22, 14, 10]); },","+  pose(B, sim, dt) { B.u = Math.min(1, B.u + dt / 1.6); const k = 1 - Math.pow(1 - B.u, 3); B.x = lerp(B.from[0], B.to[0], k); B.y = lerp(B.from[1], B.to[1], k); B.part('tank').pos = boatXY(B, [-22, -17, 14]); },","   onPart(B, sim, part) { sim.emit('explode', { at: part.pos.slice(), size: 2.2, big: true }); TC.explode(sim, part.pos, 90, 10, {}); sim.say('rook', 'Boom. Scratch one truck.'); defeatBoss(sim, B, { killMinions: false }); },","   *script(B, sim) {","     yield 1.6; sim.say('kai', 'Armored truck! Take out the gunner!');","     const g = TC.makeEnemy(sim, 'gunner', null, { at: boatXY(B, [4, 0, 26]), entry: 'stand', mount: true }); g.ride = B; g.local = [4, 0, 26]; g.cover = { h: 12, peek: ['up'], at: g.local, busy: 0 }; g.state = 'hide'; g.t = .5;","-    yield 1.2; for (const l of [[-40, -16, 0], [-40, 16, 0]]) { const p = boatXY(B, l); TC.makeEnemy(sim, 'marine', null, { at: p, entry: 'stand' }).state = 'peek'; }","+    yield 1.2; for (const l of [[-30, 26, 0], [50, -24, 0]]) { const p = sim.scene.bulldogMen ? sim.scene.bulldogMen[l[0] < 0 ? 0 : 1] : boatXY(B, l); TC.makeEnemy(sim, 'marine', null, { at: p, entry: 'stand' }).state = 'peek'; }","     yield 3; sim.say('rook', 'Fuel tank—light it up!');","     yield () => B.defeated;","   }"]},{"oldStart":17125,"oldLines":7,"newStart":17132,"newLines":7,"lines":[" "," // ---------------------------------------------------------------- HAMMERHEAD (2-B): shield advance, rotary sweep, grenades, the charge"," def('boss', 'hammerhead', { name: 'HAMMERHEAD', title: 'Enforcer of the Black Current', time: 120, bonus: 40000,","-  parts: { body: { hp: 60, r: 10, score: 20000, human: true }, legs: { hp: 999, r: 7, noMul: true, link: 'body' } },","+  parts: { body: { hp: 44, r: 10, score: 20000, human: true }, legs: { hp: 999, r: 7, noMul: true, link: 'body' } },","   bars: B => [{ label: 'HAMMERHEAD', f: B.part('body').hp / B.part('body').max }],","   init(B, sim) { const s = sim.scene.hammer; B.track = s.track; B.u = .5; B.x = lerp(s.track[0][0], s.track[1][0], .5); B.y = lerp(s.track[0][1], s.track[1][1], .5); B.z = s.track[0][2]; B.shield = true; B.shieldDown = 0; B.coverHp = 3; B.mode = 'walk'; B.yaw = 0; },","   pose(B, sim, dt) {"]},{"oldStart":17185,"oldLines":7,"newStart":17192,"newLines":7,"lines":[" TC.damageBoss = (sim, part, dmg, o = {}) => {","   const B = sim.boss;","   if (B && B.id === 'hammerhead') {","-    if (part.id === 'legs') { if (B.shield && B.shieldDown <= 0) { sim.emit('impact', { at: o.at, surf: 'metal' }); } return _dmgBoss(sim, B.part('body'), dmg * .75, Object.assign({}, o, { blast: true })); }","+    if (part.id === 'legs') { if (B.shield && B.shieldDown <= 0) { sim.emit('impact', { at: o.at, surf: 'metal' }); } return _dmgBoss(sim, B.part('body'), dmg * .8, Object.assign({}, o, { blast: true })); }","     if (B.onHit) B.onHit(o);","     if (part.armor && (o.w === 'sg' || o.w === 'gl' || o.blast)) { B.shieldDown = 1.5; part.armor = false; sim.emit('shieldknock', { boss: true }); return; }","   }"]},{"oldStart":17348,"oldLines":6,"newStart":17355,"newLines":7,"lines":["   return out;"," }"," TC.covers = covers;","+TC.noCheck = cs => { for (const k in cs) cs[k].noCheck = true; return cs; };   // moving scenes: checked in play, not from the start pose"," "," // ---------------------------------------------------------------- prefabs"," const PF = {};"]},{"oldStart":17445,"oldLines":7,"newStart":17453,"newLines":7,"lines":["   speedboat: G => { PF.boat(G, 0, 0, 0, 0, 96, { hull: 'hull', cabin: false }); G.box(-30, -16, 8, -26, 16, 20, 'steel-paint', { surf: 'metal' }); G.box(-10, -14, 8, 6, -6, 22, 'steel-paint'); G.box(-10, -6, 20, 6, 6, 24, 'glass'); G.box(10, -16, 8, 40, -14, 18, 'steel-paint'); G.box(10, 14, 8, 40, 16, 18, 'steel-paint'); },","   stingray: G => { PF.boat(G, 0, 0, 0, 0, 150, { hull: 'hull-dark', cabin: false }); G.box(-20, -18, 9, 22, 18, 34, 'gunmetal'); G.box(-14, -16, 34, 16, 16, 46, 'gunmetal'); G.box(16.2, -12, 36, 16.8, 12, 42, 'glasslit'); G.box(-60, -24, 8, 60, -23, 18, 'iron'); G.box(-60, 23, 8, 60, 24, 18, 'iron'); },","   turret: G => { G.cyl(0, 0, 0, 6, 7, 6, 8, 'gunmetal'); G.box(-5, -5, 6, 5, 5, 12, 'gunmetal'); G.pipe(4, 22, -2, 9, 1.4, 6, 'iron'); G.pipe(4, 22, 2, 9, 1.4, 6, 'iron'); },","-  truck: G => { G.box(-46, -16, 6, 20, 16, 40, 'camo'); G.box(20, -16, 6, 46, 16, 30, 'camo'); G.box(46, -15, 14, 46.6, 15, 26, 'glass'); for (const x of [-30, 0, 32]) for (const y of [-17, 17]) G.cyl(x, y, 0, 0, 0, 0, 3, 'rubber'); for (const x of [-30, 0, 32]) for (const y of [-18, 14]) G.box(x - 7, y, 0, x + 7, y + 4, 12, 'rubber'); G.box(-28, 13, 4, -16, 17, 16, 'tank-white'); G.box(-6, -8, 40, 8, 8, 46, 'gunmetal'); G.box(4, -10, 46, 6, 10, 56, 'steel-paint'); },","+  truck: G => { G.box(-46, -16, 6, 20, 16, 40, 'camo'); G.box(20, -16, 6, 46, 16, 30, 'camo'); G.box(46, -15, 14, 46.6, 15, 26, 'glass'); for (const x of [-30, 0, 32]) for (const y of [-17, 17]) G.cyl(x, y, 0, 0, 0, 0, 3, 'rubber'); for (const x of [-30, 0, 32]) for (const y of [-18, 14]) G.box(x - 7, y, 0, x + 7, y + 4, 12, 'rubber'); G.box(-28, -17, 6, -16, -13, 20, 'tank-white'); G.box(-6, -8, 40, 8, 8, 46, 'gunmetal'); G.box(4, -10, 46, 6, 10, 56, 'steel-paint'); },","   jetski: G => { G.box(-10, -5, -2, 8, 5, 5, 'teal-paint'); G.quad([8, -5, -2], [16, 0, 0], [16, 0, 4], [8, -5, 5], 'teal-paint', { tess: false }); G.quad([16, 0, 0], [8, 5, -2], [8, 5, 5], [16, 0, 4], 'teal-paint', { tess: false }); G.box(-4, -3, 5, 4, 3, 8, 'rubber'); G.box(5, -6, 8, 7, 6, 9, 'iron'); },","   drone: G => { G.box(-5, -5, -2, 5, 5, 3, 'gunmetal'); for (const [x, y] of [[-8, -8], [8, -8], [-8, 8], [8, 8]]) { G.box(x - 4, y - 4, 3, x + 4, y + 4, 3.6, 'rubber', { double: true }); G.box(x * .5 - 1, y * .5 - 1, 1, x * .5 + 1, y * .5 + 1, 3, 'iron'); } G.box(4.5, -1.5, -1, 5.5, 1.5, 1.5, 'red-lamp'); },","   seawolf: G => { G.box(-30, -12, -10, 22, 12, 12, 'gunmetal'); G.quad([22, -12, -10], [38, 0, -4], [38, 0, 6], [22, -12, 12], 'gunmetal', { tess: false }); G.quad([38, 0, -4], [22, 12, -10], [22, 12, 12], [38, 0, 6], 'gunmetal', { tess: false }); G.box(22.2, -8, 0, 30, 8, 10, 'glasslit'); G.box(-80, -3, -2, -30, 3, 6, 'gunmetal'); G.box(-84, -1, 6, -78, 1, 24, 'gunmetal'); G.box(-6, -32, -6, 10, 32, -3, 'gunmetal'); G.cyl(4, -18, -12, -1, 6, 6, 8, 'steel-paint', { bottom: true }); G.cyl(4, 18, -12, -1, 6, 6, 8, 'steel-paint', { bottom: true }); G.cyl(0, 0, 12, 18, 4, 4, 8, 'iron'); },"]},{"oldStart":17488,"oldLines":12,"newStart":17496,"newLines":18,"lines":["     const c = sim.covers[k]; if (c.noCheck) continue;","     const tallC = c.h >= 30, head = [c.at[0], c.at[1], c.at[2] + RIGH.head];","     let target = head;","-    if (tallC) { const f = Math.atan2(cs.pos[1] - c.at[1], cs.pos[0] - c.at[0]), s = c.peek.includes('left') ? -1 : 1; target = [c.at[0] - Math.sin(f) * 12 * s, c.at[1] + Math.cos(f) * 12 * s, c.at[2] + RIGH.head]; }","+    if (tallC) { const f = Math.atan2(cs.pos[1] - c.at[1], cs.pos[0] - c.at[0]), s = c.peek.includes('left') ? -1 : 1; target = [c.at[0] - Math.sin(f) * 14 * s, c.at[1] + Math.cos(f) * 14 * s, c.at[2] + RIGH.head]; }","     const v = projectVU(cs, target);","     if (!v || Math.abs(v[0]) > .95 * 16 / 9 || Math.abs(v[1]) > .95) { errs.push(sim.sceneId + ' cover ' + k + ': exposed head off screen (' + (v ? v[0].toFixed(2) + ',' + v[1].toFixed(2) : 'behind') + ')'); continue; }","     const d = vnorm(vsub(target, cs.pos)), t = vdist(target, cs.pos);","     for (const col of sim.colliders) { if (!col.on) continue; const ht = rayAABB(cs.pos, d, col.b); if (ht < t - 6) { errs.push(sim.sceneId + ' cover ' + k + ': head blocked by a collider at ' + ht.toFixed(0) + ' of ' + t.toFixed(0)); break; } }","   }","+  // objective and bonus targets (locks, life rings, intel bottles) can be seen and shot from slot 1 or slot 2","+  for (const ob of sim.objects) {","+    if (!ob.K.objective && !ob.K.bonus) continue;","+    const ok = [0, 1].some(i => { const c2 = camSetup(Object.assign({}, sim.poseOf(i, 'stand'), { fov: 55, aspect: 16 / 9 })), v = projectVU(c2, ob.pos); if (!v || Math.abs(v[0]) > .95 * 16 / 9 || Math.abs(v[1]) > .95) return false; const h = sim.raycast(c2.pos, vnorm(vsub(ob.pos, c2.pos))); return h && h.kind === 'object' && h.ob === ob; });","+    if (!ok && !ob.noCheck) errs.push(sim.sceneId + ' object ' + ob.kind + ' at ' + ob.pos.map(Math.round) + ': not visible or not shootable');","+  }","   return errs;"," };"," const cam = (t, at, look) => ({ t, at, look });   // a cutscene camera key"]},{"oldStart":17561,"oldLines":6,"newStart":17575,"newLines":7,"lines":["     PF.container(G, 240, 70, 0, 0, 'container-ochre'); PF.container(G, 330, -150, 0, Math.PI / 2, 'container-green'); PF.container(G, 330, -150, 42, Math.PI / 2, 'container-grey');","     PF.container(G, 420, 40, 0, 0, 'container-red'); PF.container(G, 420, 40, 42, 0, 'container-blue'); PF.container(G, 120, 170, 0, .1, 'container-green');","     PF.container(G, 300, 250, 0, Math.PI / 2, 'container-ochre');   // the wall the Bulldog smashes through","+    G.box(256, -14, 0, 272, 2, 16, 'crate', { fit: true, surf: 'wood' }); G.box(348, -28, 0, 364, -12, 16, 'crate', { fit: true, surf: 'wood' });","     G.box(120, -50, 0, 150, -26, 20, 'container-ochre', { surf: 'metal' });   // a 