first = 'practice'; data = { lesson: a1 || 'lessonI' }; }","+else if (link === 'lab') { first = 'lab'; data = { tech: a1 || 'frontKick' }; }","+else if (link === 'spar') { first = 'fight'; data = KC.Versus.sparData(); }","+else if (link === 'ending') { first = 'cutscene'; KC.Story.newGame(); data = KC.Story.endingData(); }","+else if (['attract', 'about', 'records', 'credits', 'dojo', 'bonusMenu', 'movelist'].includes(link)) first = link;","+game.start({ scenes, scene: first, data, boot });","+game.debug = KC.debugHandle(game);","+if (typeof window !== 'undefined') window.__game = { game, scenes, KC };"]}],"created":true}],"moreFiles":7,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-182910__x9a2bbb/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183848__x1295cd/work/KarateChampon-KarateChamp1984-claude-opus-5-5-medium-20261103-183848/check-output/0-load.png","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183848__x1295cd/work/KarateChampon-KarateChamp1984-claude-opus-5-5-medium-20261103-183848/check-output/1-started.png","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183848__x1295cd/work/KarateChampon-KarateChamp1984-claude-opus-5-5-medium-20261103-183848/check-output/2-played.png","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183848__x1295cd/work/KarateChampon-KarateChamp1984-claude-opus-5-5-medium-20261103-183848/check-output/view-iso.png","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-182647__x9a2bbb/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183638__x1295cd/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183638__x1295cd/work/KarateChampon-KarateChamp1984-claude-opus-5-5-xhigh-20261103-183638/src/90-start.js","/home/micha/dev/cc-m