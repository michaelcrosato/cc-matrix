abbedBy, h.saved, 'c', c.beh, c.st, Math.round(c.x), Math.round(c.y), (c.near || 0).toFixed(2)); }"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-184630__xa320fb/work/SnipeoutHD-WipeoutHD-claude-opus-5-5-xhigh-20261103-184630/tests/node/flow.mjs","hunks":[{"oldStart":47,"oldLines":7,"newStart":47,"newLines":7,"lines":["     I.press('Pad0'); adv(.05); I.release('Pad0'); T.check('prompts follow the device used last (pad)', SN.glyph.device(I) === 'gamepad', I.lastDevice); I.press('KeyW'); adv(.05); I.release('KeyW'); T.check('…then the keyboard', SN.glyph.device(I) === 'keyboard', I.lastDevice);","     T.check('no touch controls', I.touchEnabled === false); }","   // the attract mode: not at 9.9 s, at 10 s; content across the loop; any input exits within a step","-  { SN.flow.toTitle(); adv(1); SN.attract.idleT = 0; adv(9.8); T.check('no attract at 9.9 s idle', snap().scene === 'title', snap().scene); adv(.4); adv(.4); T.check('the attract starts after 10 s idle', snap().scene === 'attract', snap().scene);","+  { SN.flow.toTitle(); adv(1); SN.attract.idleT = 0; if (process.env.DBG) console.log('held', [...I.held], I.padMove, I.mouse); adv(9.8); if (process.env.DBG) console.log('idleT', SN.attract.idleT, [...I.held]); T.check('no attract at 9.9 s idle', snap().scene === 'title', snap().scene); adv(.4); adv(.4); T.check('the attract starts after 10 s idle', snap().scene === 'attract', snap().scene);","     SN.attract.seen.weapons.clear(); SN.attract.seen.tracks.clear(); adv(150);","     T.check('the attract shows at least 8 weapons', SN.attract.seen.weapons.size >= 8, [...SN.attract.seen.weapons]); T.check('the attract shows at least 3 circuits', SN.attract.seen.tracks.size >= 3, [...SN.attract.seen.tracks]);","     I.tap('fire'); adv(1 / 120); adv(1 / 120); adv(1 / 120); T.check('any input exits the attract to the title', snap().scene === 'title', snap().scene); }"]},{"oldStart":74,"oldLines":5,"newStart":74,"newLin