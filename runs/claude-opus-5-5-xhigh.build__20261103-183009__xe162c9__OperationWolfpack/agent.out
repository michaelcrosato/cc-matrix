th ? t[0].score : 50000; },\n  reset() { S.set('tips', {}); S.set('cleared', {}); try { for (const m of ['campaign', 'op1', 'op2', 'op3', 'op4', 'op5', 'op6']) E.store.set('arcade:' + S.id + ':' + m, []); } catch (e) { /* blocked */ } },\n  save() {}\n};\n})();\n"}}}
