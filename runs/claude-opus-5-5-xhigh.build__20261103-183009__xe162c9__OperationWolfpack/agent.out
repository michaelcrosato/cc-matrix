ase || 1) && q.name !== 'kragg') { const r = WP.Rigs.pool.get(e.id + ':' + q.name); if (r) R.rig(r, q.x, q.y - .8, q.z + (e.bob || 0), { flash: flashOf(q) }); } };"," /** weak points blink with a white outline at 3 Hz (drawn as a ring at the part) */"," const weakRing = (e) => {","   for (const q of e.parts || []) {"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/src/25-bosses.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/src/56-render-bosses.js"]}},"tool_result_meta":[{"id":"toolu_013UVPNPW31GeqcAfNtEuRYo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
