muteAll = false; if (!ctx.net) ctx.demo = false; },\"\"\"\nassert s.count(old)==1; s=s.replace(old,new); open(p,'w').write(s)\nEOF\ntimeout 900 node tests/playthrough.mjs 2>&1 | grep -v \"^    at\" | tail -12","description":"Fix override clearing and rerun playthrough"}}}
