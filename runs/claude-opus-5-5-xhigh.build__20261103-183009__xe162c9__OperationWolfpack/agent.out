-5-xhigh-20261103-183009/tests/hub-mock.mjs","hunks":[{"oldStart":33,"oldLines":13,"newStart":33,"newLines":13,"lines":["   const startAt = 500; for (const c of copies) { c.H._start = startAt + 3000; c.H._emit('start', { in: 3000 }); }","   // clients play with the bot; the host's own player too","   const step = 1 / 120;","-  const run = secs => { for (let i = 0; i < secs * 120; i++) { clock += step * 1000; for (let q = queue.length - 1; q >= 0; q--) if (queue[q].at <= clock) { const m = queue.splice(q, 1)[0]; if (!m.to.gone && !m.to.H._ended) m.to.H._emit('message', m.data, m.from); } for (const c of copies) if (!c.gone) c.game.advance(step); } };","+  const run = secs => { for (let i = 0; i < secs * 120; i++) { clock += step * 1000; for (let q = queue.length - 1; q >= 0; q--) if (queue[q].at <= clock) { const m = queue.splice(q, 1)[0]; if (!m.to.gone && !m.to.H._ended) m.to.H._emit('message', m.data, m.from); } for (const c of copies) if (!c.gone) { c.game.advance(step); const sm = c.WP.Flow.sim; if (sm && !c.H.isHost) c.maxNet = Math.max(c.maxNet || 0, sm.ents.filter(e => e.net && !e.dead).length); } } };","   run(4);","   for (const c of copies) { const WP = c.WP; if (c.H.isHost && server) continue; const b = WP.Bot.make({ seed: c.me + 1 }); WP.Input.override(c.me, (w, p, dt) => WP.Bot.frame(b, w, p, dt)); }","   run(o.seconds || 25);","   const host = copies.find(c => c.H.isHost), hs = host.WP.Flow.sim;","   check('the host plays the op', host.game.sceneName === 'play' && hs && hs.t > 5, host.game.sceneName);","-  for (const c of copies) if (!c.H.isHost) { const s = c.WP.Flow.sim; check('client ' + c.me + ' sees the host\\'s world', s && s.ents.filter(e => e.net).length > 0 && c.WP.Net.state.snapN > 50, s ? s.ents.length + ' ents, ' + c.WP.Net.state.snapN + ' snaps' : 'no sim'); }","+  for (const c of copies) if (!c.H.isHost) { const s = c.WP.Flow.sim; check('client ' + c.me + ' sees the host\\'s world', s && c.maxNet > 3 && c.WP.Net.state.snapN > 50, s ? c.maxNet + ' ents at most, ' + c.WP.Net.state.snapN + ' snaps' : 'no sim'); }","   const remote = hs.players.filter(p => p.pid !== host.me);","   check('client hits count on the host', remote.some(p => p.kills > 0 || p.hits > 0), JSON.stringify(remote.map(p => [p.pid, p.kills, p.hits, p.shots])));","   check('server mode: no local player', !server || !host.WP.ctx.locals[host.me]);"]}]}],"moreFiles":11,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-183848__x1295cd/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-185330__x53986f/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-185330__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-medium-20261103-185330/src/71-attract.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/tests/hub-mock.mjs","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183153__xf5fb84/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/build/game.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/43-combat.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/src/80-autopilot.js","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183331__xf7f297/work/Bentou2-Tenchu2-claude-opus-5-5-xhigh-20261103-183331/tests/zz-debug.test.mjs","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261