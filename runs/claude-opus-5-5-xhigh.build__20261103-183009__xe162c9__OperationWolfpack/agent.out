 snap: g.debug && g.debug.snapshot ? g.debug.snapshot() : null, errors: (g.errors || []).map(e => String(e.message || e)) }; })));\nfor (const e of errs) console.log(e);\nawait browser.close();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":458,"cache_read_input_tokens":222989,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":458},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a0704575-f16b-44ea-a24d-907e9c278025","uuid":"4f7a499b-de41-4113-b40a-984e27382df7","timestamp":"2026-11-04T01:36:06.853Z","request_id":"req_011Cgh2hYr8xHVzeWaqDtJ9m","wire_tool_inputs":{"toolu_01XPAbiPUE6dLPJQbKXmYfmp":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/tools/shot.mjs","content":"// node tools/shot.mjs <page.html[#hash]> <out.png> [--wait ms] [--eval \"js\"] [--size 960x540] [--snap]\n// Opens the page over file:// in headless Chromium, waits, optionally runs JS, screenshots, prints errors (+ snapshot).\nimport { chromium } from 'playwright';\nimport { resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nconst a = process.argv.slice(2), opt = (n, d) => { const i = a.indexOf('--' + n); return i >= 0 ? a[i + 1] : d; };\nconst [page0, out] = a.filter((x, i) => !x.startsWith('--') && !(i > 0 && a[i - 1].startsWith('--') && !['--snap'].includes(a[i - 1])));\nconst [file, hash] = page0.split('#');\nconst url = pathToFileURL(resolve(file)).href + (hash ? '#' + hash : '');\nconst [w, h] = (opt('size', '960x540')).split('x').map(Number);\nconst browser = await chromium.launch({ args: ['--autoplay-policy=no-user-gesture-required'] });\nconst page = await browser.newPage({ viewport: { width: w, height: h } });\nconst errs = [];\npage.on('pageerror', e => errs.push('pageerror: ' + e.message));\npage.on('console', m => { if (m.type() === 'error' || m.type() === 'warning') errs.push(m.type() + ': ' + m.text()); });\nawait page.goto(url);\nawait page.waitForTimeout(+opt('wait', 1500));\nconst ev = opt('eval', null);\nif (ev) { const r = await page.evaluate(ev); if (r !== undefined) console.log('eval:', JSON.stringify(r)); await page.waitForTimeout(+opt('after', 300)); }\nawait page.screenshot({ path: out });\nif (a.includes('--snap')) console.log(JSON.stringify(await page.evaluate(() => { const g = My3D2dge.current; return { snap: g.debug && g.debug.snapshot ? g.debug.snapshot() : null, errors: (g.errors || []).map(e => String(e.message || e)) }; })));\nfor (const e of errs) console.log(e);\nawait browser.close();\n"}}}
