OF'\np='engine/my-3d2dge.js'; s=open(p).read()\nold=\"\"\"  \"×\": '.....|#...#|.#.#.|..#..|.#.#.|#...#|.....', \"▸\": '#...|##..|###.|####|###.|##..|#...', \"♪\": '..##.|..#.#|..#..|..#..|.##..|###..|.#...'\n};\"\"\"\nnew=\"\"\"  \"×\": '.....|#...#|.#.#.|..#..|.#.#.|#...#|.....', \"▸\": '#...|##..|###.|####|###.|##..|#...', \"♪\": '..##.|..#.#|..#..|..#..|.##..|###..|.#...',\n  \"✕\": '#...#|##.##|.###.|..#..|.###.|##.##|#...#', \"○\": '.###.|#...#|#...#|#...#|#...#|#...#|.###.', \"□\": '#####|#...#|#...#|#...#|#...#|#...#|#####', \"△\": '..#..|..#..|.#.#.|.#.#.|#...#|#...#|#####', \"·\": '..|..|..|##|##|..|..'\n};\"\"\"\nassert s.count(old)==1; s=s.replace(old,new); open(p,'w').write(s)\nEOF\ncat >> engine/CHANGES.md <<'EOF'\n6. **PlayStation button symbols in the 5x7 font** (✕ ○ □ △, and the middle dot ·). `input.label()` returns them for a\n   DualSense, but the pixel font had no glyphs for them, so every canvas prompt drew \"?\".\nEOF\necho ok","description":"Add PS glyphs to the engine font and log it"}}}
