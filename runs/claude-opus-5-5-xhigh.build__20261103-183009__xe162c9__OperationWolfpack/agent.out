 => { const g = A.game; if (!g || WP.headless || A.muteAll) return; const k = WP.ctx && WP.ctx.demo ? .5 : 1; g.audio.sfx('wp_' + name, Object.assign({ vary: .05 }, o, { vol: (o.vol === undefined ? 1 : o.vol) * k })); };   // (the attract demo at half volume)\"\"\"\nassert s.count(old)==1; s=s.replace(old,new); open(p,'w').write(s)\nEOF\nnode tools/devpage.mjs && node tools/build.mjs && timeout 1800 node tests/run.mjs 2>&1 | grep -v \"^    at\" | tail -20","description":"Half-volume demo, rebuild, run the full test suite"}}}
