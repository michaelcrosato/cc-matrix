\nold=\"\"\"for (const c of copies) if (!c.gone) c.game.advance(step); } };\"\"\"\nnew=\"\"\"for (const c of copies) if (!c.gone) { c.game.advance(step); const sm = c.WP.Flow.sim; if (sm && !c.H.isHost) c.maxNet = Math.max(c.maxNet || 0, sm.ents.filter(e => e.net && !e.dead).length); } } };\"\"\"\nassert s.count(old)==1; s=s.replace(old,new)\ns=s.replace(\"\"\"check('client ' + c.me + ' sees the host\\\\'s world', s && s.ents.filter(e => e.net).length > 0 && c.WP.Net.state.snapN > 50, s ? s.ents.length + ' ents, ' + c.WP.Net.state.snapN + ' snaps' : 'no sim');\"\"\",\"\"\"check('client ' + c.me + ' sees the host\\\\'s world', s && c.maxNet > 3 && c.WP.Net.state.snapN > 50, s ? c.maxNet + ' ents at most, ' + c.WP.Net.state.snapN + ' snaps' : 'no sim');\"\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 300 node tests/hub-mock.mjs 2>&1 | grep -v \"^    at\" | tail -8","description":"Track mirrored entities over the run and rerun"}}}
