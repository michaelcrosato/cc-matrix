 no damage', m.hp === h); B.CHEATS.god = false;","+  cheats.find(r => r.label === 'One-hit kills').set(true); const r2 = B.spawnMon('f1', 'ooze', 3, 7, {}); B.attackMon(m, r2, { dmg: '1d1' }, 'main', { dmg: '1d1' }); check('one-hit kills', r2.hp <= 0 || r2.hp === r2.max); B.CHEATS.oneHit = false;","+  B.CHEATS.noclip = true; B.S.party.cx = 2; B.S.party.cy = 14; B.S.party.dir = 3; B.cmdMove('f'); check('noclip walks through walls', B.S.party.cx === 1); B.CHEATS.noclip = false; B.S.party.tween = null;","+  cheats.find(r => r.label === 'Give all keys and wards').run(); check('every key and ward given', B.countItem('ironWard') === 1 && B.countItem('boneKey') === 1);","+  for (const fid of ['f1', 'f2', 'f3', 'f4', 'race']) for (const [n, x, y, d] of B.FLOORS[fid].waypoints || []) { B.devWarp(fid, x, y, d); check('warp to ' + n, B.S.floor === fid && B.S.party.cx === x && B.S.party.cy === y); }","+  B.devWarp('f1', 2, 14, 0);","+  const party = B.DevMode.rows(6); party.find(r => r.label === '+1 level for everyone').run(); check('+1 level', B.S.party.members.every(x => x.lvl === 2));","+  party.find(r => r.label === 'Add Durgan').run(); check('add an NPC', B.S.party.members.some(x => x.npc === 'durgan'));","+  const sp = B.DevMode.rows(7); const before = B.FS().mons.length; sp.find(r => r.label === 'Spawn in front').run(); check('spawn in front', B.FS().mons.length > before);","+  sp.find(r => r.label === 'Kill all on this floor').run(); check('kill all', B.FS().mons.every(x => x.hp <= 0));","+  check('the debug tab has auto-play, attract, cutscenes and the sound test', ['Auto-play to floor end', 'Start the attract mode now', 'Play the intro', 'Sound test', 'Fake hub ghosts'].every(l => B.DevMode.rows(8).some(r => r.label === l)));","+  check('the sound test lists sfx, songs and voices', B.DevMode.soundList().length > 100);","+  check('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));","+};"]}],"created":true},{"filePath":"/home/micha/dev/cc-mat