inH, maxW: R.maxW, maxH: R.maxH, portrait: R.portrait }); game.cam.snap = true; }\n    return this._res ? this._res.S : 1;\n  }\n}\nE.Mode7 = Mode7;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01W6hi3oSjHhg3hy6P2VVTU9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
