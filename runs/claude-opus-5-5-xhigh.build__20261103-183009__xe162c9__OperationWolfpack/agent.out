n (g, vp) {\n  const P = this._P, top = Math.max(vp.y, Math.ceil(P.cy - P.f * P.sp / P.cp)), bot = vp.y + vp.h; if (bot <= top) return;\n  const w = vp.w, h = bot - top;\n  if (!buf || buf.width !== w || buf.height !== h) { buf = E.mkCanvas(w, h); img = buf.getContext('2d').createImageData(w, h); }\n  const out = new Uint32Array(img.data.buffer);\n  for (let row = 0; row < h; row++) {\n    const D = this.rowDepth(top + row + .5); if (!D) continue;\n    const s = (D * P.cp + P.h * P.sp) / P.f, l0 = (vp.x + .5 - P.cx) * s, ux = P.rx * s, uy = P.ry * s, base = row * w;\n    let wx = P.x + P.fx * D + P.rx * l0, wy = P.y + P.fy * D + P.ry * l0;\n    const dep = WP.Y0 - wy;\n    for (let i = 0; i < w; i++, wx += ux, wy += uy) {\n      const tx = wx & 255, ty = wy & 255; let c = grass[ty * 256 + tx];\n      const dd = WP.Y0 - wy; if (dd > 70 && dd < 110) c = 0xff3a5a7a;\n      out[base + i] = c;\n    }\n  }\n  buf.getContext('2d').putImageData(img, 0, 0); g.drawImage(buf, vp.x, top);\n  const fog = this.o.fog, fc = E.hex(fog.color), n = fog.near, far = fog.far;\n  for (let by = top; by < bot; by++) { const D = this.rowDepth(by + .5), a = D ? clamp((D - n) / (far - n), 0, 1) : 1; if (a > .01) { g.fillStyle = `rgba(${fc[0]},${fc[1]},${fc[2]},${a.toFixed(3)})`; g.fillRect(vp.x, by, vp.w, 1); } }\n};\nconst clamp = E.clamp;\nconst rigs = [60, 120, 200, 400, 600, 900].map((d, i) => ({ d, rig: new E.Humanoid({ size: 1.3, weapon: 'gun', hat: 'cap', outfit: 'shirt', colors: { cloth: '#b89a62', pants: '#8a7048', hat: '#7a6038' } }), x: 100 + i * 50 }));\nconst cam = { x: 200, y: WP.Y0, h: 28, angle: -Math.PI / 2, pitch: 6, fov: 60 };\nconst res = {};\ngame.debug = { snapshot: () => res };\ngame.start({ update(dt) { cam.x += dt * 16; for (const r of rigs) r.rig.update(dt, { x: r.x, y: WP.Y0 - r.d, z: 0, facing: Math.PI / 2, point: true }); },\n  draw(r) {\n    m7.cam = cam;\n    for (const q of rigs) m7.rig(q.rig, cam.x - 150 + rigs.indexOf(q) * 60, WP.Y0 - q.d, 0);\n    m7.shape('barrel', cam.x + 60, WP.Y0 - 80, 0);\n    m7.shape('tree', cam.x + 120, WP.Y0 - 300, 0);\n    m7.draw(r);\n    r.overlay(g => {\n      // calibrate: draw a rig at view scale 1 to an offscreen canvas and measure\n      if (!res.done) {\n        const c = E.mkCanvas(200, 200), cg = E.ctx2d(c);\n        const presets = { r13: { size: 1.3, weapon: 'gun', hat: 'cap' }, b155: { size: 1.55, build: 'bulky', weapon: 'gun' }, h135: { size: 1.35, hat: 'cap', outfit: 'coat' } };\n        for (const k in presets) {\n          const rig = new E.Humanoid(presets[k]); for (const pose of [null, 'kneel', 'crouch']) {\n            rig.update(1, { x: 0, y: 0, z: 0, facing: Math.PI / 2, pose: pose || undefined }); for (let i = 0; i < 60; i++) rig.update(1 / 60, { x: 0, y: 0, z: 0, facing: Math.PI / 2, pose: pose || undefined });\n            cg.clearRect(0, 0, 200, 200); rig.draw(cg, 100, 150, m7.view(1));\n            const d = cg.getImageData(0, 0, 200, 200).data; let x0 = 999, x1 = -1, y0 = 999, y1 = -1;\n            for (let y = 0; y < 200; y++) for (let x = 0; x < 200; x++) if (d[(y * 200 + x) * 4 + 3] > 0) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y); }\n            res[k + ':' + (pose || 'stand')] = { top: 150 - y0, bot: y1 - 150, w: x1 - x0 + 1, l: 100 - x0, rr: x1 - 100 };\n          }\n        }\n        res.done = true;\n      }\n    });\n  } });\n})();\n</script></body></html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01777bAHWfcVcfBzqT3ZeNnb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
