ewLines":8,"lines":[" };"," Hit.hull = hull;"," /** the projected hull of a box (w across, d along, h up; its front along facing) at (x, y, z) */","-Hit.boxPoly = (view, x, y, z, box, facing) => {","-  const [w, d, h] = box, c = Math.cos(facing), s = Math.sin(facing), pts = [];","+Hit.boxPoly = (view, x, y, z, box, facing, sc = 1) => {","+  const w = box[0] * sc, d = box[1] * sc, h = box[2] * sc; c = Math.cos(facing), s = Math.sin(facing), pts = [];","   for (const a of [-1, 1]) for (const b of [-1, 1]) for (const zz of [0, h]) {","     const fx = b * d / 2, sx = a * w / 2;   // forward along facing, side across","     const wx = x + c * fx - s * sx, wy = y + s * fx + c * sx, p = view.project(wx, wy, z + zz);"]},{"oldStart":129,"oldLines":7,"newStart":129,"newLines":7,"lines":[" };"," /** a local offset (ax across, ay forward, az up, in a shape's own frame) at facing -> a world point */"," Hit.local = (e, off) => {","-  const f = e.facing, c = Math.cos(f), s = Math.sin(f), [ax, ay, az] = off;   // (written facing south: local +y is the front, +x its right as written)","+  const k = (WP.TYPES[e.type] && WP.TYPES[e.type].sc) || 1, f = e.facing, c = Math.cos(f), s = Math.sin(f), ax = off[0] * k, ay = off[1] * k, az = off[2] * k;   // (written facing south: local +y is the front, +x its right as written)","   return [e.x + ax * s + ay * c, e.y - ax * c + ay * s, (e.z || 0) + az];"," };"," /** the humanoid shapes for a rig standing at (sx, sy) with drawn height H px */"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-183009__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009/src/50-art-shapes.js","hunks":[{"oldStart":42,"oldLines":7,"newStart":42,"newLines":7,"lines":[" S.windsock = { about: 'an orange windsock on a pole', tags: 'airfield', scale: 1.5, mats: { m: 'silver', o: { color: '#e8702a', pattern: 'cloth' } },","   parts: [['cyl', 'm', [0, 0, 0], .8, 42], ['cyl', 'o', [6, 0, 38], 3, 12, { r2: 1.