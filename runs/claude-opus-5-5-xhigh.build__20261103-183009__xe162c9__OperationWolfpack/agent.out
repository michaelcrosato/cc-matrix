ch, b.pitch, s), fov: lerp(a.fov, b.fov, s) };\n  }\n}\nWP.Rail = Rail;\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_012uTtpZRsXE28eevbNVDgh6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
