h.round(k))); px.rect(g, Math.min(a[0], b[0]) + 4 * k, Math.min(a[1], b[1]) - 2 * k, Math.abs(b[0] - a[0]) - 8 * k, Math.max(2, 3 * k), '#e8e4d8'); } }\n    }\n    if (e.kind === 'hostage' && !e.saved && !e.lost) {\"\"\"\nassert s.count(old)==1; s=s.replace(old,new); open(p,'w').write(s)\nEOF\necho ok","description":"Co-op scaling on join, stretcher, range sway target"}}}
