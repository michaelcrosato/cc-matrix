sage)).slice(0, 3) }; })));\n  await page.screenshot({ path: 'shots/hub2.png' });\n  await browser.close();\n} finally { srv.kill(); }\nEOF\ntimeout 120 node .tmp/hubpeek.mjs tests/.serve OperationWolfpack-OperationWolf-claude-opus-5-5-xhigh-20261103-183009.html","description":"Peek inside a live two-player hub round"}}}
