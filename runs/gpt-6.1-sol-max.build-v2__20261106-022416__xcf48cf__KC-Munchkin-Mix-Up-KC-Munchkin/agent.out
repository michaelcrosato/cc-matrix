') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n  const round = ++roundNo;\n  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n  const hubEnd = net.endpoint('hub');\n  const grid = $('grid');\n  grid.replaceChildren();\n  const copies = n + (serverMode ? 1 : 0);\n  grid.style.gridTemplateColumns = copies > 1 ? '1fr 1fr' : '1fr';\n  grid.style.gridTemplateRows = `repeat(${Math.ceil(copies / (copies > 1 ? 2 : 1))}, 1fr)`;\n\n  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n  current = state;\n  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n\n  state.coordinator = createRound({\n    round,\n    players,\n    hostKey: 'p0',\n    serverKey: serverMode ? 'server' : null,\n    mode,\n    seed,\n    limitMs,\n    gate: true,\n    deliver: (key, m) => hubEnd.send(key, { k: 'h', r: round, m }),\n    onStatus: (s) => { state.status = s; render(state); },\n    onEnd: (record) => {\n      state.record = record;\n      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n      render(state);\n    },\n  });\n  hubEnd.onMessage((from, env) => {\n    if (env.k !== 'c' || env.r !== round) return;\n    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n    state.coordinator.receive(from, env.m);\n  });\n\n  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n    const frame = document.createElement('iframe');\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    frame.title = p.name;\n    const label = document.createElement('div');\n    label.className = 'cell__bar';\n    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n    const el = document.createElement('div');\n    el.className = 'cell';\n    el.style.borderColor = color;\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\n991:    for (const el of [this._touchEl, this._startEl]) if (el) { for (const b of el.querySelectorAll('[data-act]')) this.release('Act:' + b.dataset.act); el.remove(); }\n992:    this._touchEl = this._startEl = null;\n1008:      const st = this._startEl = document.createElement('div'), b = document.createElement('button'); st.dataset.sys = 'touch';\n2608:    const c = this._corner && this._corner.style.display !== 'none' ? this._corner : this.input._startEl; if (!c || !c.isConnected || !this.screen.canvas) return null;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"cat > tests/hub.py <<'EOF'\nimport functools\nimport http.server\nimport json\nimport threading\nimport urllib.parse\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nWORK=ROOT.parent\nPROJECT=json.loads((WORK/'project.json').read_text())\npassed=failed=0\nfailures=[]\ndetails=[]\ndef check(name,ok,detail=''):\n    global passed,failed\n    if ok: passed+=1\n    else:\n        failed+=1\n        failures.append(name+(': '+str(detail) if detail else ''))\nclass Quiet(http.server.SimpleHTTPRequestHandler):\n    def log_message(self,*args): pass\nhandler=functools.partial(Quiet,directory=str(WORK))\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),handler)\nthread=threading.Thread(target=server.serve_forever,daemon=True)\nthread.start()\nbase='http://127.0.0.1:'+str(server.server_port)\ntry:\n    with sync_playwright() as p:\n        browser=p.chromium.launch(headless=True,args=['--no-sandbox'])\n        try:\n            scenarios=[(1,'standard',0,0,0),(2,'standard',0,0,0),(2,'standard',150,50,5),(2,'host-leave',150,50,5),(2,'server',150,50,5)]\n            for players,scenario,latency,jitter,loss in scenarios:\n                ctx=browser.new_context(viewport={'width':1440,'height':1000})\n                page=ctx.new_page()\n                warnings=[]\n                page.on('console',lambda msg: warnings.append(msg.text) if msg.type=='warning' and '[AIHub]' in msg.text else None)\n                query=urllib.parse.urlencode({'game':'/'+PROJECT['base']+'.html','players':players,'scenario':scenario,'latency':latency,'jitter':jitter,'loss':loss,'auto':1,'play':5000,'seed':4242})\n                url=base+'/'+PROJECT['base']+'/tools/hub/harness.html?'+query\n                name=f'{players} seats / {scenario} / {latency}ms / {loss}%'\n                try:\n                    page.goto(url)\n                    page.wait_for_function('document.body.dataset.complete === \\\"true\\\"',timeout=70000)\n                    report=page.evaluate('window.__hubCheck')\n                    check(name+' official harness',report.get('pass') is True,[c for c in report.get('checks',[]) if not c.get('pass')])\n                    check(name+' no client warnings',not warnings,warnings)\n                    frames=[f for f in page.frames if f\"'!=page.main_frame and PROJECT['\"'base']+'.html' in f.url]\n                    states=[]\n                    for f in frames:\n                        state=f.evaluate('({title:document.title,host:AIHub.isHost,server:AIHub.server,me:AIHub.me,players:mix.world.players.map(p=>p.id),tick:mix.world.tick,score:mix.world.score,lives:mix.world.lives,gate:mix.world.board.orientation,mask:mix.world.food.reduce((a,f,i)=>a|(f.alive?1<<i:0),0),rev:mix.world.revision,ended:mix.net.ended,muted:game.audio.muted,stats:mix.net.diagnostics,errors:game.errors})')\n                        states.append(state)\n                    check(name+' correct game served',all(s['title']==PROJECT['title'] for s in states) and bool(states),states)\n                    if scenario=='server':\n                        dedicated=[s for s in states if s['server']]\n                        check(name+' no phantom server player',len(dedicated)==1 and dedicated[0]['me'] not in dedicated[0]['players'] and len(dedicated[0]['players'])==2,dedicated)\n                    check(name+' all surviving copies ended and muted',all(s['ended'] and s['muted'] for s in states),states)\n                    check(name+' bounded snapshot traffic',all(s['stats']['maxBytes']<16384 for s in states),states)\n                    if scenario\"'!='\"'host-leave':\n                        check(name+' final authoritative state agrees',len({(s['score'],s['lives'],s['gate'],s['mask'],s['rev']) for s in states})==1,states)\n                    check(name+' no native game errors',all(not s['errors'] for s in states),states)\n                    details.append({'scenario':name,'pass':report['pass'],'checks':report['checks'],'states':states})\n                except Exception as e:\n                    check(name,False,str(e))\n                finally:\n                    ctx.close()\n        finally:\n            browser.close()\nfinally:\n    server.shutdown()\n    server.server_close()\nprint(json.dumps({'passed':passed,'failed':failed,'skipped':0,'failures':failures,'details':details}))\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('src/main.js')\ns=p.read_text().replace(\\\"fullscreen:'button',autoPause:\\\",\\\"fullscreen:'button',corner:false,autoPause:\\\")\ns=s.replace(\\\"this.workshopButton.hidden=screen\"'!=='\"'editor';\\\", \\\"this.workshopButton.hidden=screen\"'!=='\"'editor';this.menuButton.hidden=\"'!['\"'play','editor'].includes(screen)||this.net.ended;\\\")\ns=s.replace(\\\"this.hudElement=el('div','mix-hud');\\\", \\\"this.menuButton=el('button','mix-menu','Menu');this.menuButton.setAttribute('aria-label','Pause menu');this.menuButton.hidden=true;this.menuButton.onclick=()=>{if(\"'!this.net.ended)this.game.menu();};document.body.append(this.menuButton);'\"\\\\n      this.hudElement=el('div','mix-hud');\\\")\np.write_text(s)\np=Path('src/theme.css')\np.write_text(p.read_text()+'''\\\\n[data-sys=\\\"touch\\\"]{display:none\"'!important}.esh.mix-ui .esh-ttl button{min-height:36px;padding:7px 12px;font-size:13px}.mix-menu{position:absolute;right:2.5vw;top:2.7vh;border:1px solid #977ba866;border-radius:24px;padding:11px 18px;background:#281f35d9;color:#d7c5e6;font-size:clamp(13px,1.05vw,22px);min-height:44px;z-index:11}.mix-menu[hidden]{display:none}@media(max-aspect-ratio:4/5){.esh.mix-ui .esh-ttl button{font-size:10px;padding:7px 8px}.mix-menu{top:max(12px,env(safe-area-inset-top));right:5vw;font-size:13px;padding:10px 16px}.mix-counters{margin-right:0}}'\"\\\\n''')\np=Path('src/view/theatre.js')\ns=p.read_text().replace(\\\"r.groundDisc((tr[i][0]+.5)*T,(tr[i][1]+.5)*T,1.4,'#b99b67',.12+i*.025);\\\", \\\"r.decal(()=>r.groundDisc((tr[i][0]+.5)*T,(tr[i][1]+.5)*T,1.4,'#b99b67',.12+i*.025));\\\")\ns=s.replace(\\\"if(hero){r.groundRing(xx,yy,8.3,colors,1);if(a.chirpFx>0)r.groundRing(xx,yy,12+(1-a.chirpFx/.75)*42,'#a9ede3',1);}\\\",\\\"if(hero){r.decal(()=>{r.groundRing(xx,yy,8.3,colors,1);if(a.chirpFx>0)r.groundRing(xx,yy,12+(1-a.chirpFx/.75)*42,'#a9ede3',1);});}\\\")\np.write_text(s)\np=Path('src/net/session.js')\ns=p.read_text().replace(\\\"this.received.set(AIHub.me,{q:++this.inputSeq,...intent,time:now});\\\",\\\"{this.received.set(AIHub.me,{q:++this.inputSeq,...intent,time:now});this.app.intentCache[0].a=false;}\\\")\ns=s.replace(\\\"this.lastInput=text;this._heartbeat\\\", \\\"this.app.intentCache[0].a=false;this.lastInput=text;this._heartbeat\\\")\np.write_text(s)\nPY\nnode tools/build.mjs\nnode tools/test.mjs --hub\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
