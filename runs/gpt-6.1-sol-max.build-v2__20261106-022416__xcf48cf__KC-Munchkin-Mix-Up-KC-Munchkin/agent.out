{"type":"item.started","item":{"id":"item_109","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'EOF'\nimport assert from 'node:assert/strict';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {createHash} from 'node:crypto';\nimport {spawnSync} from 'node:child_process';\nconst p=JSON.parse(readFileSync('project.json','utf8'));\nconst out='../'+p.base+'.html';\nconst sha=s=>createHash('sha256').update(s).digest('hex');\nconst before=sha(readFileSync(out));\nconst build=spawnSync(process.execPath,['tools/build.mjs'],{encoding:'utf8'});assert.equal(build.status,0,build.stderr);\nassert.equal(sha(readFileSync(out)),before,'Build is not deterministic');\nconst html=readFileSync(out,'utf8'),client=readFileSync('vendor/hub/lib/hub/session.js','utf8');\nconst first=html.match(/<meta charset=\\\"utf-8\\\">\\\\s*<script>([\\\\s\\\\S]*?)<\\\\/script>/);assert(first);assert.equal(first[1],client);\nconst release=JSON.parse(readFileSync('../exit-interview.json','utf8'));\nassert.deepEqual(release,JSON.parse(readFileSync('src/release.json','utf8')));\nassert.deepEqual(Object.keys(release),['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub']);\nassert.deepEqual(Object.keys(release.sourceInformation),['date','source','plan','genre','perspective','tech','artDirection','animation','audio','online','testing','research','environment','model','usage']);\nassert.deepEqual(Object.keys(release.aiHub),['name','tagline','description','type','genre','source','series','players','controls','tags']);\nfor(const [name,n] of [['testingFeedback',4],['engineFeedback',6],['promptFeedback',4]]){assert.equal(release[name].length,n);assert(release[name].every(v=>typeof v==='string'&&v.trim()));}\nassert(Object.values(release.sourceInformation).every(v=>typeof v==='string'&&v.trim()));assert.equal(release.sourceInformation.usage,'added on import');assert.equal(release.aiHub.players,'1–2');assert.equal(release.aiHub.name,p.title);assert(release.aiHub.tags.length>=3&&release.aiHub.tags.length<=6);\nconst result={artifact:p.base+'.html',bytes:Buffer.byteLength(html),sha256:before,clientSha256:sha(client),clientByteIdentical:true,deterministic:true,interviewValid:true};writeFileSync('build/reports/package.json',JSON.stringify(result,null,2)+'\\\\n');console.log(JSON.stringify(result));\nEOF\nbiome check src tools/*.mjs tests/simulation.mjs package.json project.json\ngit -C vendor/engine status --short\ngit -C vendor/hub status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
