testing\":\"Headless deterministic simulation, legal-intent playthroughs, browser/controller/touch stand-ins and official Hub harness; no FPS target\", \"research\":\"Original manual, contemporary audiovisual observations, archival commercial contact sheet, pinned engine and Hub source\", \"environment\":\"Codex CLI (headless); Linux\", \"model\":\"OpenAI, gpt-6.1-sol, reasoning effort max\", \"usage\":\"added on import\"\n  },\n  \"testingFeedback\":[\"Final verification is recorded in docs/testing.md.\",\"Final severity counts are recorded in docs/issues.md.\",\"Legal-intent whole-campaign and authoritative network checks.\",\"Static syntax checks say little about game feel.\"],\n  \"engineFeedback\":[\"Native Blob rigs, shaded pixels and the TV Shell provided a coherent visual and input foundation.\",\"GridMover needs a focused extension for expiring turns, immediate reversal and explicit tunnel edges.\",\"The authoritative board graph, moving-food simulation, editor validation and Hub snapshot adapter.\",\"Keeping native presentation APIs separate from deterministic grid and transport state.\",\"No vendored engine changes. GraphMover subclasses the native mover; custom art, UI and audio extend public systems.\",\"An official graph-edge adapter for GridMover, including tunnels and motion segments.\"],\n  \"promptFeedback\":[\"The distinctive moving-food premise and concrete whole-game acceptance gates.\",\"First-run duration was a hypothesis; strong route-planning bots finish much faster.\",\"Integrating one ruleset across six stages, the editor, local co-op and dedicated Hub hosting.\",\"Separate mandatory acceptance gates from target pacing hypotheses and ask for measured timing ranges.\"],\n  \"aiHub\":{\"name\":\"K.C. Munchkin Mix-Up\",\"tagline\":\"Your lunch has other plans.\",\"description\":\"Hunt twelve runaway snacks while three hungry rivals hunt you. Ride a turning pen, cut through side doors, reveal shy walls, and build your own mischievous mazes.\",\"type\":\"Game\",\"genre\":\"Action\",\"source\":\"K.C. Munchkin! (1981)\",\"series\":\"\",\"players\":\"1–2\",\"controls\":\"WASD/arrows or stick/D-pad: move; Space/Cross: reveal; Escape/Options: menu. Couch duo: WASD+F / arrows+period.\",\"tags\":[\"arcade\",\"co-op\",\"top-down\",\"pixel art\",\"retro\",\"comedy\"]}\n}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport {readFileSync,writeFileSync,copyFileSync} from 'node:fs';\nimport {root,order} from './load.mjs';\nimport path from 'node:path';\nconst project=JSON.parse(readFileSync(path.join(root,'../project.json'),'utf8'));\nconst release=JSON.parse(readFileSync(path.join(root,'src/release.json'),'utf8'));\nconst client=readFileSync(path.join(root,'vendor/hub/lib/hub/session.js'),'utf8');\nif(/<\\\\/script/i.test(client))throw new Error('Session client contains a closing script tag');\nconst escape=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst engine=readFileSync(path.join(root,'vendor/engine/dist/handoff/my-3d2dge.js'),'utf8');\nconst source=order.map(name=>readFileSync(path.join(root,\"'`src/${name}.js`),'\"'utf8')).join('\\\\n');\nconst css=readFileSync(path.join(root,'src/theme.css'),'utf8');\nconst html=\"'`<!doctype html>'\"\\\\n<html lang=\\\"en\\\">\\\\n<head>\\\\n<meta charset=\\\"utf-8\\\">\\\\n<script>\"'${client}</script>'\"\\\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover\\\">\\\\n<title>\"'${project.title}</title>'\"\\\\n<meta name=\\\"description\\\" content=\\\"\"'${release.aiHub.description}\">'\"\\\\n<meta name=\\\"theme-color\\\" content=\\\"#21182f\\\">\\\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\">\\\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Clear six mazes together. Munch twelve moving snacks per maze; keep your five team lives.\\\">\\\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Move: stick/D-pad or WASD/arrows. Cross/Space: reveal shy walls. Options/Escape: local menu.\\\">\\\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"8\\\">\\\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\">\\\\n<meta name=\\\"hub:players\\\" content=\\\"1-2\\\">\\\\n<style>\"'${css}</style>'\"\\\\n<script>\"'${escape(engine)}</script>'\"\\\\n</head>\\\\n<body>\\\\n<canvas id=\\\"screen\\\" aria-label=\\\"K.C. Munchkin Mix-Up maze\\\"></canvas>\\\\n<div id=\\\"load-error\\\" hidden></div>\\\\n<script>globalThis.Mix={RELEASE:\"'${escape(JSON.stringify(release))}};'\"\\\\n\"'${escape(source)}</script>'\"\\\\n</body>\\\\n</html>\\\\n\"'`;\nconst output=path.join(root,'\"'..',project.base+'.html');writeFileSync(output,html);writeFileSync(path.join(root,'build/index.html'),html);writeFileSync(path.join(root,'../exit-interview.json'),JSON.stringify(release,null,2)+'\\\\n');\nfor(const name of ['harness.html','bridge.js','round.js'])copyFileSync(path.join(root,'vendor/hub/lib/hub',name),path.join(root,'tools/hub',name));\nwriteFileSync(path.join(root,'vendor/REVISIONS.json'),JSON.stringify({engine:{version:'0.89.1',commit:'8ecc2f62353761187bdfe226f327b7ea5d2eb691',changes:'none'},hub:{protocol:1,client:'1.4.0',commit:'35a1047f2067b2af3de3943f0fe452f39105d869',changes:'none'}},null,2)+'\\\\n');\nif(process.argv.includes('--verbose'))console.log(output);\nEOF\ncat > package.json <<'EOF'\n{\\\"name\\\":\\\"kc-munchkin-mix-up\\\",\\\"private\\\":true,\\\"version\\\":\\\"1.0.0\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"test\\\":\\\"node tools/test.mjs\\\"}}\nEOF\nnode tools/build.mjs --verbose\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\n(function(M){\n  'use strict';\n  const {E}=M;\n  const INPUT={up:['KeyW','ArrowUp','Pad12','PadAxisUp'],down:['KeyS','ArrowDown','Pad13','PadAxisDown'],left:['KeyA','ArrowLeft','Pad14','PadAxisLeft'],right:['KeyD','ArrowRight','Pad15','PadAxisRight'],start:['Enter','Pad9'],pause:['Escape','KeyP','Pad9'],confirm:['Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1'],chirp:['Space','KeyF','Pad0'],toolPrev:['KeyQ','Pad4'],toolNext:['KeyE','Pad5'],undo:['KeyZ','Pad2'],redo:['KeyY','Pad3'],halves:{left:{chirp:['KeyF']},right:{chirp:['Period']}}};\n  class App {\n    constructor(net){\n      this.net=net;this.screen=net.active?'play':'title';this.devOpen=false;this.overlays=false;this.editor=null;this.currentOptions={seats:[0]};this.intentCache=[{d:-1,a:false},{d:-1,a:false}];this.axes=[-1,-1];this.touch=null;this.lastPointer=null;this.paint=null;this.returning=false;this.reported=false;this.lastHUD='';this.attractAge=0;this.attractPart=-1;this.ui=null;\n      const server=net.active&&AIHub.server;\n      this.game=new E.Game({canvas:'screen',id:'kc-munchkin-mix-up-v1',view:'overhead',views:['overhead'],res:[480,360],expand:true,headless:server,loop:\"'!server,fullscreen:'\"'button',autoPause:\"'!net.active,live:net.active,input:INPUT,bg:'\"'#120e1c',camera:false,\n        menu:{quit:net.active?false:'title',controls:{chirp:'Reveal chirp',toolPrev:'Previous tool',toolNext:'Next tool',undo:'Undo wall edit',redo:'Redo wall edit'},items:()=>this.pauseItems(),settings:[{key:'music',value:.10},{key:'glyphs',value:'playstation'},{key:'voiceLevel',group:'Sound',label:'Gibberish voices',value:.65,min:0,max:1,step:.05,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},{key:'autoChirp',group:'Game',label:'Touch auto-chirp',value:true,help:'Reveal shy walls whenever the chirp is ready on touch.'},{key:'touchSensitivity',group:'Game',label:'Touch steering sensitivity',value:1,min:.5,max:2,step:.1}]}});\n      this.game.fadeTime=.12;this.game.cam.smooth=0;this.game.input.steer='drag';this.game.input.touchButtons([]);\n      this.profile=new M.Profile();this.world=new M.World({god:true,assisted:true});this.theatre=new M.Theatre(this.game,this);this.sound=new M.Sound(this.game);this.front=new E.Arcade(this.game,{id:'mix-up-attract',idle:10,demo:1e9,scores:0});\n      if(\"'!server){this.screens=new M.Screens(this);this.ui.root.classList.add('\"'mix-ui');this.setupDOM();}\n      this.game.debug={snapshot:()=>({title:M.RELEASE.aiHub.name,screen:this.screen,menu:this.ui?.screen||null,world:this.world?.snapshot(),input:{device:this.game.input.lastDevice,axes:this.axes.slice(),touch:\"'!!this.touch,seats:this.game.players.map(p=>({pad:p.pad,half:p.half||null,device:p.lastDevice}))},audio:{unlocked:this.sound.unlocked,music:this.game.settings.music,muted:this.game.audio.muted,voice:this.game.settings.voiceLevel},network:{active:net.active,host:net.active?AIHub.isHost:false,server:net.active?AIHub.server:false,ended:net.ended,...net.diagnostics},editor:this.editor?{x:this.editor.x,y:this.editor.y,tool:this.editor.tool,valid:this.editor.errors.length===0,message:this.editor.message}:null,errors:this.game.errors.map(e=>e.message)}),\n        command:(name,args={})=>this.command(name,args)};\n      this.game.hook('\"'input',dt=>this.inputStep(dt));\n      this.game.start({scene:net.active?'hub':'title',scenes:{\n        title:{pausable:false,enter:()=>this.enterTitle(),update:dt=>this.update(dt),draw:r=>this.draw(r)},\n        play:{pausable:true,enter:options=>this.enterPlay(options||{}),update:dt=>this.update(dt),draw:r=>this.draw(r)},\n        editor:{pausable:true,enter:()=>this.enterEditor(),update:dt=>this.update(dt),draw:r=>this.draw(r)},\n        attract:{pausable:false,enter:()=>this.enterAttract(),update:dt=>this.update(dt),draw:r=>this.draw(r)},\n        hub:{pausable:true,update:dt=>this.update(dt),draw:r=>this.draw(r)},\n        ended:{pausable:false,draw:r=>this.draw(r)}\n      }});\n      if(net.active)net.attach(this);\n      if(this.profile.notice&&this.ui)this.ui.toast('A fresh start',this.profile.notice);\n    }\n    pauseItems(){\n      if(this.screen==='editor')return [['Workshop menu',()=>this.screens.workshop()],['Editing help',()=>this.screens.editHelp()]];\n      return [['How to play',()=>this.screens.help(0)],[this.net.active?'World inspector':'Developer tools',()=>this.screens.developer(0)],['About & credits',()=>this.screens.about(0)],...(\"'!this.net.active&&this.currentOptions.mode==='\"'custom'?[['Return to workshop',()=>this.returnEditor()]]:[])];\n    }\n    markActivity(){this.front.wake();}\n    clearIntents(){this.intentCache=[{d:-1,a:false},{d:-1,a:false}];this.axes=[-1,-1];if(this.world)for(const p of this.world.players)this.world.setIntent(p.id,{d:-1,a:false});}\n    resetPresentation(){this.theatre.reset();this.sound.lastEvent=0;this.game.particles.list.length=0;this.clearIntents();this.reported=false;}\n    enterTitle(){\n      if(this.net.active)return;this.screen='title';this.devOpen=false;this.overlays=false;this.ui?.hide();this.game.resume();while(this.game.players.length>1)this.game.removePlayer(this.game.players.at(-1));this.game.input.pad='any';this.game.input.use(INPUT);this.game.input.clear();this.world=new M.World({seed:83,god:true,assisted:true});this.world.phase='playing';this.resetPresentation();this.markActivity();this.screens?.title();document.body.dataset.mode='title';\n    }\n    showTitle(){if(this.net.active)return;this.ui?.hide();this.game.resume();this.clearIntents();this.touch=null;this.game.go('title');}\n    devices(options){\n      const g=this.game;while(g.players.length>1)g.removePlayer(g.players.at(-1));g.input.use(INPUT);g.input.pad='any';\n      if(options.seats?.length===2){\n        if(options.devices==='pads'){g.input.pad=options.pads[0];g.addPlayer({pad:options.pads[1]});}\n        else if(options.devices==='mixed'){g.input.pad=null;g.addPlayer({pad:options.pads[0]});}\n        else{g.input.pad=null;g.addPlayer({keys:'right'});}\n      }\n      for(const I of g.players){I.steer='drag';I.touchButtons([]);I.clear();}\n    }\n    startRun(options={}){if(this.net.active)return;this.ui?.hide();this.game.resume();this.game.input.consumeAll();this.game.input.clear();this.clearIntents();this.currentOptions=M.copy(options);this.game.go('play',options);}\n    enterPlay(options){\n      this.screen='play';this.devOpen=false;this.overlays=false;this.devices(options);this.world=new M.World(options);this.resetPresentation();this.sound.babble();document.body.dataset.mode='play';this.lastHUD='';\n    }\n    replaceWorld(options){if(this.net.active)return false;this.world=new M.World({...this.currentOptions,...options});this.resetPresentation();return true;}\n    openEditor(){if(this.net.active)return;this.ui?.hide();this.game.resume();if(\"'!this.editor)this.editor=new M.Editor();this.game.go('\"'editor');}\n    returnEditor(){if(this.net.active)return;this.ui?.hide();this.game.resume();this.game.go('editor');}\n    enterEditor(){this.screen='editor';this.devOpen=false;this.clearIntents();this.world=new M.World({custom:M.template(0),mode:'custom',god:true,assisted:true});this.refreshEditor();this.resetPresentation();document.body.dataset.mode='editor';this.game.input.clear();}\n    refreshEditor(){if(\"'!this.editor)return;this.world.data=M.copy(this.editor.data);this.world.board=new M.Board(this.world.data);for(let i=0;i<12;i++)this.world.food[i].m.place(this.editor.data.food[i].x,this.editor.data.food[i].y);for(let i=0;i<this.world.players.length;i++)this.world.players[i].m.place(...this.editor.data.spawns[i%2]);this.world.reveal=10;this.theatre.rev=0;this.lastHUD='\"'';}\n    enterAttract(){this.screen='attract';this.ui?.hide();this.game.resume();this.attractAge=0;this.attractPart=-1;this.makeAttractPart(0);document.body.dataset.mode='attract';this.game.input.clear();}\n    makeAttractPart(part){this.attractPart=part;const stage=[0,1,2,3,5][part%5];this.world=new M.World({seed:803,stage,god:true,assisted:true,seats:part%5===3?[0,1]:[0]});this.world.phase='playing';this.bots=this.world.players.map(p=>new M.Bot(p.id));this.resetPresentation();}\n    inputStep(dt){\n      if(this.net.ended){for(const I of this.game.players)I.clear();return;}\n      const g=this.game,I=g.input;\n      if(this.screen==='title'){if(this.front.attract(dt)==='demo'){this.ui?.hide();g.resume();g.go('attract');return;}}\n      if(I.lastDevice==='gamepad'&&(I.anyPressed()||Math.hypot(...I.move())>.4)){\n        if(this.screen==='attract'){this.showTitle();I.consumeAll();I.clear();return;}this.markActivity();\n      }\n      if(this.screen==='play'&&\"'!this.ui?.screen&&!g.paused){\n        for(let i=0;i<g.players.length;i++){\n          const input=g.players[i];let v=input.move();if(i===0&&this.touch)v=this.touch.vector;\n          const direction=M.cardinal(v,this.axes[i],input.lastDevice==='\"'touch'?.15:.25);this.axes[i]=direction;\n          this.intentCache[i]={d:direction,a:\"'!!this.intentCache[i]?.a||input.pressed('\"'chirp')};\n          if(i===0&&input.lastDevice==='touch'&&g.settings.autoChirp&&this.world.data.reveal.kind\"'!=='\"'none'&&this.world.players[0]?.chirp<=0)this.intentCache[0].a=true;\n        }\n        if(this.world.phase==='intro'&&I.pressed('confirm')){if(\"'!this.net.active)this.world.phaseT=0;this.intentCache.forEach(i=>i.a=false);I.consumeAll();}\n      }else this.clearIntents();\n      this.sound.update(this.world,g.paused&&!this.net.active);\n    }\n    localIntent(index=0){return this.intentCache[index]||{d:-1,a:false};}\n    consumeEvents(events){\n      if(this.net.active||this.screen!=='\"'play')return;\n      for(const e of events){if(e.type==='clear')this.profile.record(this.world);if(e.type==='hit')this.ui?.toast('A little bump\"'!'\"',\"'`${this.world.lives} team lives. Keep your grin up.`,1.8);if(e.type==='\"'power')this.ui?.toast('Turn the tables\"'!'\"',\"'`Rivals are edible. Next catch: ${[5,10,20][Math.min(this.world.chain,2)]} points.`,2);}\n    }\n    update(dt){\n      const w=this.world;if(!w||this.net.ended)return;\n      if(this.net.active){if(!AIHub.server)this.theatre.update(w,dt);this.hud();return;}\n      if(this.screen==='\"'title'){w.setIntent(0,{d:-1,a:false});w.step();if(w.phase==='lost'||w.phase==='won')w.phase='playing';}\n      else if(this.screen==='attract'){\n        this.attractAge+=dt;const part=Math.floor(this.attractAge/18);if(part\"'!==this.attractPart)this.makeAttractPart(part);\n        for(let i=0;i<this.world.players.length;i++)this.world.setIntent(this.world.players[i].id,this.bots[i].intent(this.world,this.world.players[i]));this.world.step();\n        if(this.world.phase==='\"'won'&&this.attractAge%18<16){this.world.emit('victory');}\n        this.sound.events(this.world.events);\n      }else if(this.screen==='editor'){this.updateEditor(dt);}\n      else if(this.screen==='play'){\n        for(let i=0;i<w.players.length;i++){w.setIntent(w.players[i].id,this.localIntent(i));this.intentCache[i].a=false;}\n        w.step();this.sound.events(w.events);this.consumeEvents(w.events);\n        if((w.phase==='won'||w.phase==='lost')&&\"'!this.reported){this.reported=true;this.profile.record(w);this.screens.results();}\n      }\n      this.theatre.update(this.world,dt);this.hud();\n    }\n    updateEditor(dt){\n      const e=this.editor,I=this.game.input;let changed=false;\n      const ways=[['\"'up',0,-1],['right',1,0],['down',0,1],['left',-1,0]];\n      for(const [action,x,y]of ways)if(I.repeat(action,.3,.085)){e.x=M.clamp(e.x+x,1,19);e.y=M.clamp(e.y+y,1,15);}\n      if(I.pressed('toolNext'))e.tool=(e.tool+1)%8;if(I.pressed('toolPrev'))e.tool=(e.tool+7)%8;\n      if(I.pressed('confirm'))changed=e.apply();if(I.pressed('undo'))changed=e.undo();if(I.pressed('redo'))changed=e.redo();if(changed)this.refreshEditor();\n    }\n    draw(r){if(this.world)this.theatre.draw(r,this.world);}\n    hud(){\n      if(\"'!this.hudElement)return;const w=this.world,screen=this.screen,game=this.game;\n      this.hudElement.hidden=!['\"'play','editor','attract'].includes(screen)||this.net.ended;\n      const menu=this.ui?.screen;this.hudElement.classList.toggle('under-menu',\"'!!menu);\n      const state=[screen,w.stageIndex,w.score,w.lives,w.remaining,Math.ceil(w.power),Math.ceil(w.players[0]?.chirp||0),w.phase,this.editor?.tool,this.editor?.message,game.input.lastDevice,game.settings.glyphs,w.assisted,w.board.orientation].join('\"'|');\n      if(state===this.lastHUD)return;this.lastHUD=state;\n      this.hudStage.textContent=screen==='editor'?'MAZE WORKSHOP':screen==='attract'?'A LITTLE MISCHIEF / DEMO':this.net.active?'TEAM LUNCH / '+w.data.name:w.data.name;\n      this.hudScore.textContent=String(w.score).padStart(3,'0');this.hudLives.textContent='♥'.repeat(Math.max(0,w.lives));this.hudFood.textContent=String(w.remaining).padStart(2,'0');\n      this.hudCounters.hidden=screen==='editor';\n      this.hudDetail.textContent=screen==='editor'?\"'`${this.editor.tools[this.editor.tool]}  ·  ${this.editor.message}`:w.power>0?`BRIGHT BITE ${w.power.toFixed(0)}s · NEXT RIVAL ${[5,10,20][Math.min(w.chain,2)]} PTS`:w.remaining<=3?`${w.remaining===1?'\"'LAST LITTLE RUNAWAY':'THREE OR FEWER LEFT'} · MEET IT AT THE NEXT JUNCTION\"'`:w.data.subtitle;\n      this.hudPrompt.textContent=screen==='\"'editor'?\"'`${game.input.label('\"'toolPrev')} / \"'${game.input.label('\"'toolNext')} tool  ·  \"'${game.input.label('\"'confirm')} edit  ·  \"'${game.input.label('\"'undo')} undo\"'`:game.input.lastDevice==='\"'touch'?'DRAG ANYWHERE TO STEER':\"'`${game.input.label('\"'up')} \"'${game.input.label('\"'left')} \"'${game.input.label('\"'down')} \"'${game.input.label('\"'right')} move  ·  \"'${game.input.label('\"'chirp')} chirp  ·  \"'${game.input.label('\"'pause')} menu\"'`;\n      this.hudSeed.textContent=screen==='\"'editor'?\"'`CELL ${this.editor.x}, ${this.editor.y}`:w.assisted&&screen==='\"'play'?'ASSISTED RUN':w.stageIndex===4||w.mode==='remix'?\"'`SEED ${w.data.seed}`:w.data.gate.turning?`PEN ${['\"'N','E','S','W'][w.board.orientation]} ↻\"'`:'\"'12 LITTLE RUNAWAYS';\n      this.chirpButton.hidden=screen\"'!=='\"'play'||game.input.lastDevice\"'!=='\"'touch'||w.data.reveal.kind==='none';this.chirpButton.disabled=(w.players.find(p=>p.id===(this.net.active?AIHub.me:0))?.chirp||0)>0;this.chirpButton.textContent=this.chirpButton.disabled?'Chirp cooling':'Chirp';\n      this.workshopButton.hidden=screen\"'!=='\"'editor';\n      const foot=this.ui?.root?.querySelector('.esh-ttl>div>div.esh-m:last-child');if(foot)foot.textContent=\"'`${game.input.label('\"'confirm')} choose · Best \"'${this.profile.data.best}`;\n      document.body.dataset.device=game.input.lastDevice;\n    }\n    setupDOM(){\n      const el=(tag,cls,text)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(text)e.textContent=text;return e;};\n      this.hudElement=el('\"'div','mix-hud');this.hudElement.hidden=true;const top=el('div','mix-hud-top');\n      const label=el('div','mix-stage-block');this.hudStage=el('div','mix-stage');this.hudDetail=el('div','mix-detail');label.append(this.hudStage,this.hudDetail);\n      this.hudCounters=el('div','mix-counters');for(const [name,prop]of [['TEAM','hudScore'],['LIVES','hudLives'],['LEFT','hudFood']]){const block=el('div','mix-counter');block.append(el('span','',name));this[prop]=el('b','');block.append(this[prop]);this.hudCounters.append(block);}top.append(label,this.hudCounters);\n      const bottom=el('div','mix-hud-bottom');this.hudPrompt=el('div','mix-prompt');this.hudSeed=el('div','mix-seed');bottom.append(this.hudPrompt,this.hudSeed);this.hudElement.append(top,bottom);document.body.append(this.hudElement);\n      this.chirpButton=el('button','mix-chirp','Chirp');this.chirpButton.hidden=true;this.chirpButton.onclick=()=>{if(\"'!this.net.ended)this.intentCache[0].a=true;};document.body.append(this.chirpButton);\n      this.workshopButton=el('\"'button','mix-workshop-button','Workshop menu');this.workshopButton.hidden=true;this.workshopButton.onclick=()=>this.screens.workshop();document.body.append(this.workshopButton);\n      this.ui.root.addEventListener('pointerover',e=>{if(e.pointerType==='mouse'){const b=e.target.closest('button');if(b&&\"'!b.disabled)b.focus({preventScroll:true});}});\n      const activity=e=>{\n        if(this.net.ended){e.preventDefault();e.stopImmediatePropagation();return;}\n        if(e.type==='\"'pointermove'){\n          if(e.pointerType\"'!=='\"'mouse')return;\n          if(this.lastPointer&&Math.hypot(e.clientX-this.lastPointer[0],e.clientY-this.lastPointer[1])<3)return;this.lastPointer=[e.clientX,e.clientY];\n        }\n        this.sound.unlock();\n        if(this.screen==='attract'){e.preventDefault();e.stopImmediatePropagation();this.showTitle();this.game.input.clear();this.game.input.consumeAll();return;}\n        this.markActivity();\n      };\n      for(const ev of ['keydown','pointerdown','pointermove','wheel'])window.addEventListener(ev,activity,{capture:true,passive:false,signal:this.game._abort.signal});\n      const cv=this.game.screen.canvas;\n      const cell=e=>{const rc=cv.getBoundingClientRect();return this.theatre.cellAt((e.clientX-rc.left)*this.game.W/rc.width,(e.clientY-rc.top)*this.game.H/rc.height);};\n      const paint=e=>{const p=cell(e);if(\"'!p)return;const key=p.join('\"',');if(key===this.paint?.last)return;if(this.paint)this.paint.last=key;if(this.editor.apply(...p))this.refreshEditor();};\n      cv.addEventListener('pointerdown',e=>{\n        if(this.net.ended||this.ui?.screen)return;\n        if(this.screen==='editor'){this.paint={id:e.pointerId,last:''};cv.setPointerCapture?.(e.pointerId);paint(e);return;}\n        if(e.pointerType==='touch'&&\"'!this.touch){this.touch={id:e.pointerId,x:e.clientX,y:e.clientY,vector:[0,0]};cv.setPointerCapture?.(e.pointerId);this.game.input.lastDevice='\"'touch';}\n      });\n      cv.addEventListener('pointermove',e=>{if(this.paint?.id===e.pointerId&&\"'!this.ui?.screen)paint(e);if(this.touch?.id===e.pointerId){const k=this.game.settings.touchSensitivity/42;this.touch.vector=[M.clamp((e.clientX-this.touch.x)*k,-1,1),M.clamp((e.clientY-this.touch.y)*k,-1,1)];}});\n      const release=e=>{if(this.paint?.id===e.pointerId)this.paint=null;if(this.touch?.id===e.pointerId){this.touch=null;this.intentCache[0]={d:-1,a:false};}};\n      for(const ev of ['\"'pointerup','pointercancel','lostpointercapture'])cv.addEventListener(ev,release);\n      window.addEventListener('blur',()=>{this.touch=null;this.paint=null;this.clearIntents();});\n      window.addEventListener('keydown',e=>{if(this.screen==='editor'&&e.ctrlKey&&(e.code==='KeyZ'||e.code==='KeyY')){e.preventDefault();if(e.code==='KeyY'||e.shiftKey)this.editor.redo();else this.editor.undo();this.refreshEditor();}});\n    }\n    command(name,args){\n      const testing=typeof location\"'!=='\"'undefined'&&new URLSearchParams(location.search).get('test')==='1';\n      if(name==='snapshot')return this.game.debug.snapshot();\n      if(this.net.active||(\"'!testing&&!this.devOpen))return {ok:false,reason:'\"'Use visible Developer tools in a standalone run.'};\n      if(name==='start'){this.startRun(args);return {ok:true};}\n      if(name==='advance'){const n=M.clamp(Number(args.seconds)||0,0,1200);this.game.advance(n,{draw:false});return {ok:true};}\n      if(name==='bot-play'){\n        const bots=this.world.players.map(p=>new M.Bot(p.id)),limit=M.clamp(args.seconds||900,1,1200),trace=[];let lastRev=this.world.revision;\n        for(let i=0;i<limit*120&&\"'!['\"'won','lost'].includes(this.world.phase);i++){for(let j=0;j<this.world.players.length;j++)this.world.setIntent(this.world.players[j].id,bots[j].intent(this.world,this.world.players[j]));this.world.step();if(lastRev\"'!==this.world.revision){trace.push(this.world.snapshot());lastRev=this.world.revision;}}\n        this.theatre.update(this.world,1/120);return {ok:this.world.phase==='\"'won',state:this.world.snapshot(),transitions:trace.map(s=>({stage:s.stage,tick:s.tick,lives:s.lives}))};\n      }\n      if(name==='tune')return {ok:this.world.setTuning(args.key,args.value)};\n      if(name==='stage'){this.world.stageIndex=M.clamp(args.index|0,0,5);this.world.assisted=true;this.world.loadStage();this.resetPresentation();return {ok:true};}\n      if(name==='editor'){this.openEditor();return {ok:true};}\n      return {ok:false,reason:'Unknown diagnostic command.'};\n    }\n    dispose(){this.net.dispose();this.sound.end();this.game.dispose();}\n  }\n  M.App=App;\n  (async()=>{\n    const net=new M.Session();\n    try{await net.connect();const app=new App(net);globalThis.mix=app;globalThis.game=app.game;document.body.dataset.game='kc-munchkin-mix-up';}\n    catch(error){if(net.active)AIHub.fail('Mix-Up could not load: '+error.message);else{const el=document.getElementById('load-error');if(el){el.hidden=false;el.textContent='This cabinet could not start: '+error.message;}}console.error(error);}\n  })();\n})(globalThis.Mix);\nEOF\ncat > src/theme.css <<'EOF'\n:root{color-scheme:dark;--cream:#f8efd9;--mint:#98eadb;--lavender:#c9a9e9}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#15101f;color:var(--cream);font-family:'Trebuchet MS',system-ui,sans-serif;touch-action:none;overscroll-behavior:none}#screen{display:block;image-rendering:pixelated;touch-action:none;width:100%;height:100%}button,input,textarea{font:inherit}button{touch-action:manipulation}.esh.mix-ui{--pt:18px;--pr:24px;--pb:22px;--pl:24px}.esh.mix-ui .esh-sh{background:#110c1bd9;padding:28px 24px 24px}.esh.mix-ui .esh-ttl{background:linear-gradient(90deg,#15101ff5 0%,#15101ff2 35%,#15101fb9 47%,#15101f00 67%);place-items:center start}.esh.mix-ui .esh-ttl>div{max-width:45%;padding:0 0 0 3vw}.esh.mix-ui .esh-ttl h1{font:900 37px/.98 'Trebuchet MS',system-ui,sans-serif;letter-spacing:-.035em;white-space:pre-line;color:#ffedba;text-shadow:0 3px 0 #6e3e78;margin:12px 0}.esh.mix-ui .esh-ttl .esh-k{font-size:8px;letter-spacing:.19em;color:#a7e7da}.esh.mix-ui .esh-sub{font:italic 13px/1.3 'Trebuchet MS',sans-serif;color:#c8b5d8}.esh.mix-ui .esh-ttl .esh-btns{gap:5px;margin-top:18px;max-width:220px}.esh.mix-ui button{border-radius:8px;letter-spacing:.03em;padding:9px 12px;font-size:12px;border-color:#8a6aa955;background:#3d2d4d99;transition:background .12s,transform .12s}.esh.mix-ui button:hover{border-color:#ceabe9;background:#644c7677}.esh.mix-ui button.pri{background:#f5d695;border-color:#fff0b7;color:#35213e;box-shadow:0 3px 0 #b88f5c}.esh.mix-ui button:focus-visible{outline:2px solid #a0eddf;outline-offset:3px}.esh.mix-ui .esh-tags{font-size:7px;gap:9px;letter-spacing:.11em;white-space:nowrap}.esh.mix-ui .esh-ttl .esh-m{font-size:9px;margin-top:12px}.esh.mix-ui .esh-mod{border-radius:12px;border:1px solid #a684c166;box-shadow:0 12px 42px #0007;max-width:470px;padding:20px 24px;font-size:13px;line-height:1.5}.esh.mix-ui h2{font-size:26px;line-height:1.13;letter-spacing:-.02em;color:#ffe7b1;margin:6px 0 15px}.esh.mix-ui .esh-m{white-space:pre-line;color:#d0bfdb;font-size:12px;line-height:1.5}.esh.mix-ui .esh-k{font-size:9px;color:#98dfd1;letter-spacing:.14em}.esh.mix-ui .esh-sec{margin-top:14px}.esh.mix-ui .esh-row{padding:9px 0;font-size:12px}.esh.mix-ui .esh-row small{font-size:10px}.esh.mix-ui .esh-stats b{color:#f5d695}.esh.mix-ui .esh-emb{color:#a4e6d7;font-size:40px}.esh.mix-ui .esh-nav{border-radius:30px}.esh.mix-ui .esh-toast{max-width:300px;font-size:12px;border-radius:9px;background:#2a2037ee;border:1px solid #bda0d455;top:48px}.mix-form{display:flex;flex-direction:column;gap:7px;font-size:11px;letter-spacing:.04em;margin-top:12px;color:#b7d9d0}.mix-form input,.mix-form textarea{width:100%;border:1px solid #a487c877;border-radius:6px;background:#15101f;color:#fff0c9;padding:10px;font-size:14px;touch-action:auto}.mix-form textarea{height:130px;font:10px/1.5 ui-monospace,monospace;resize:vertical}.mix-hud{position:absolute;inset:0;pointer-events:none;font-size:clamp(14px,1.55vw,30px);line-height:1.25;padding:3.5vh 4.6vw 3vh;color:#f7e9cf}.mix-hud[hidden]{display:none}.mix-hud-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.mix-stage{font-weight:700;letter-spacing:.025em;color:#f4dba8}.mix-detail{font-size:.5em;letter-spacing:.13em;color:#a698b5;margin-top:.45em}.mix-counters{display:flex;gap:1.8em;text-align:right;margin-right:2.3em}.mix-counter span{display:block;font-size:.45em;letter-spacing:.18em;color:#b7a5ca}.mix-counter b{font-size:1.05em;font-weight:700;letter-spacing:.04em}.mix-counter:nth-child(2) b{font-size:.75em;color:#ec9daa;letter-spacing:.17em}.mix-counter:last-child b{color:#96e1d4}.mix-hud-bottom{position:absolute;left:4.6vw;right:4.6vw;bottom:2.9vh;display:flex;justify-content:space-between;align-items:center;gap:12px}.mix-prompt{font-size:.47em;letter-spacing:.06em;color:#bdb0cc}.mix-seed{font-size:.43em;letter-spacing:.13em;color:#b49ac9}.mix-hud.under-menu{opacity:.15}.mix-chirp,.mix-workshop-button{position:absolute;right:max(20px,env(safe-area-inset-right));bottom:max(22px,env(safe-area-inset-bottom));border:1px solid #b8cbbf66;border-radius:24px;padding:13px 22px;background:#262336db;color:#b2eddd;min-width:72px;min-height:44px;z-index:11;pointer-events:auto}.mix-chirp[hidden],.mix-workshop-button[hidden]{display:none}.mix-chirp:disabled{opacity:.45}.mix-workshop-button{font-size:clamp(13px,1vw,22px);bottom:6vh}.esh.mix-ui input[type=range]{accent-color:#a2e6d8}.esh.mix-ui .esh-btns:has(+ .esh-tags){margin-bottom:6px}#load-error{position:absolute;inset:20%;padding:30px;background:#2d2035;color:#ffe4bf;z-index:100;font-size:24px}body[data-ended=true] .mix-hud,body[data-ended=true] button{pointer-events:none;visibility:hidden}@media(max-aspect-ratio:4/5){.esh.mix-ui .esh-ttl{place-items:start center;background:linear-gradient(#15101ff5,#15101fe0 43%,#15101f00 70%);padding:26px 18px}.esh.mix-ui .esh-ttl>div{max-width:100%;width:100%;padding:0 10px}.esh.mix-ui .esh-ttl h1{font-size:34px;line-height:.99;margin-top:8px}.esh.mix-ui .esh-ttl .esh-sub{font-size:12px}.esh.mix-ui .esh-ttl .esh-btns{display:grid;grid-template-columns:1fr 1fr;max-width:none;gap:7px;margin-top:13px}.esh.mix-ui .esh-ttl button{padding:9px 8px;font-size:10px;min-height:36px}.esh.mix-ui .esh-tags{font-size:6px;gap:8px}.esh.mix-ui .esh-ttl .esh-m{font-size:8px}.esh.mix-ui .esh-mod{padding:18px;max-height:94%;font-size:12px}.esh.mix-ui .esh-sh{padding:25px 15px}.mix-hud{padding:7vh 5vw 3vh;font-size:16px}.mix-hud-top{flex-direction:column;gap:15px}.mix-counters{gap:2.3em;margin:0;text-align:left}.mix-detail{font-size:9px;line-height:1.45;max-width:85vw;letter-spacing:.07em}.mix-hud-bottom{bottom:9vh;flex-direction:column;align-items:flex-start;gap:8px}.mix-prompt{font-size:11px}.mix-seed{font-size:10px}.mix-workshop-button{bottom:2.5vh;right:5vw}.mix-chirp{bottom:3vh;right:5vw}}@media(prefers-reduced-motion:reduce){*{transition:none\"'!important;animation:none!important}}\nEOF\ncat > src/release.json <<'\"'EOF'\n{\n  \\\"sourceInformation\\\": {\n    \\\"date\\\":\\\"2026-11-06 02:24:16\\\", \\\"source\\\":\\\"K.C. Munchkin\"'! (1981)\", \"plan\":\"PLAN.md\", \"genre\":\"Arcade action / maze-chase\", \"perspective\":\"Fixed overhead\",\n    \"tech\":\"JavaScript, Canvas 2D, my-3D2dge 0.89.1 (8ecc2f6), AI Hub client 1.4.0 (35a1047)\", \"artDirection\":\"Original shaded pixel toy theatre; plum floor, luminous violet walls, expressive cool-coloured heroes\", \"animation\":\"Native Blob squash, look and footfall with original antennae, mouths, tells, turn anticipation and event effects\", \"audio\":\"Original code-generated chip score, SFX and formant gibberish voices; music defaults to 10%; human listening quality unknown\", \"online\":\"Standalone solo/couch co-op; AI Hub 1–2-seat host-authoritative shared-world campaign, including dedicated host\", \"testing\":\"Headless deterministic simulation, legal-intent playthroughs, browser/controller/touch stand-ins and official Hub harness; no FPS target\", \"research\":\"Original manual, contemporary audiovisual observations, archival commercial contact sheet, pinned engine and Hub source\", \"environment\":\"Codex CLI (headless); Linux\", \"model\":\"OpenAI, gpt-6.1-sol, reasoning effort max\", \"usage\":\"added on import\"\n  },\n  \"testingFeedback\":[\"Final verification is recorded in docs/testing.md.\",\"Final severity counts are recorded in docs/issues.md.\",\"Legal-intent whole-campaign and authoritative network checks.\",\"Static syntax checks say little about game feel.\"],\n  \"engineFeedback\":[\"Native Blob rigs, shaded pixels and the TV Shell provided a coherent visual and input foundation.\",\"GridMover needs a focused extension for expiring turns, immediate reversal and explicit tunnel edges.\",\"The authoritative board graph, moving-food simulation, editor validation and Hub snapshot adapter.\",\"Keeping native presentation APIs separate from deterministic grid and transport state.\",\"No vendored engine changes. GraphMover subclasses the native mover; custom art, UI and audio extend public systems.\",\"An official graph-edge adapter for GridMover, including tunnels and motion segments.\"],\n  \"promptFeedback\":[\"The distinctive moving-food premise and concrete whole-game acceptance gates.\",\"First-run duration was a hypothesis; strong route-planning bots finish much faster.\",\"Integrating one ruleset across six stages, the editor, local co-op and dedicated Hub hosting.\",\"Separate mandatory acceptance gates from target pacing hypotheses and ask for measured timing ranges.\"],\n  \"aiHub\":{\"name\":\"K.C. Munchkin Mix-Up\",\"tagline\":\"Your lunch has other plans.\",\"description\":\"Hunt twelve runaway snacks while three hungry rivals hunt you. Ride a turning pen, cut through side doors, reveal shy walls, and build your own mischievous mazes.\",\"type\":\"Game\",\"genre\":\"Action\",\"source\":\"K.C. Munchkin! (1981)\",\"series\":\"\",\"players\":\"1–2\",\"controls\":\"WASD/arrows or stick/D-pad: move; Space/Cross: reveal; Escape/Options: menu. Couch duo: WASD+F / arrows+period.\",\"tags\":[\"arcade\",\"co-op\",\"top-down\",\"pixel art\",\"retro\",\"comedy\"]}\n}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport {readFileSync,writeFileSync,copyFileSync} from 'node:fs';\nimport {root,order} from './load.mjs';\nimport path from 'node:path';\nconst project=JSON.parse(readFileSync(path.join(root,'../project.json'),'utf8'));\nconst release=JSON.parse(readFileSync(path.join(root,'src/release.json'),'utf8'));\nconst client=readFileSync(path.join(root,'vendor/hub/lib/hub/session.js'),'utf8');\nif(/<\\\\/script/i.test(client))throw new Error('Session client contains a closing script tag');\nconst escape=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst engine=readFileSync(path.join(root,'vendor/engine/dist/handoff/my-3d2dge.js'),'utf8');\nconst source=order.map(name=>readFileSync(path.join(root,\"'`src/${name}.js`),'\"'utf8')).join('\\\\n');\nconst css=readFileSync(path.join(root,'src/theme.css'),'utf8');\nconst html=\"'`<!doctype html>'\"\\\\n<html lang=\\\"en\\\">\\\\n<head>\\\\n<meta charset=\\\"utf-8\\\">\\\\n<script>\"'${client}</script>'\"\\\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover\\\">\\\\n<title>\"'${project.title}</title>'\"\\\\n<meta name=\\\"description\\\" content=\\\"\"'${release.aiHub.description}\">'\"\\\\n<meta name=\\\"theme-color\\\" content=\\\"#21182f\\\">\\\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\">\\\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Clear six mazes together. Munch twelve moving snacks per maze; keep your five team lives.\\\">\\\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Move: stick/D-pad or WASD/arrows. Cross/Space: reveal shy walls. Options/Escape: local menu.\\\">\\\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"8\\\">\\\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\">\\\\n<meta name=\\\"hub:players\\\" content=\\\"1-2\\\">\\\\n<style>\"'${css}</style>'\"\\\\n<script>\"'${escape(engine)}</script>'\"\\\\n</head>\\\\n<body>\\\\n<canvas id=\\\"screen\\\" aria-label=\\\"K.C. Munchkin Mix-Up maze\\\"></canvas>\\\\n<div id=\\\"load-error\\\" hidden></div>\\\\n<script>globalThis.Mix={RELEASE:\"'${escape(JSON.stringify(release))}};'\"\\\\n\"'${escape(source)}</script>'\"\\\\n</body>\\\\n</html>\\\\n\"'`;\nconst output=path.join(root,'\"'..',project.base+'.html');writeFileSync(output,html);writeFileSync(path.join(root,'build/index.html'),html);writeFileSync(path.join(root,'../exit-interview.json'),JSON.stringify(release,null,2)+'\\\\n');\nfor(const name of ['harness.html','bridge.js','round.js'])copyFileSync(path.join(root,'vendor/hub/lib/hub',name),path.join(root,'tools/hub',name));\nwriteFileSync(path.join(root,'vendor/REVISIONS.json'),JSON.stringify({engine:{version:'0.89.1',commit:'8ecc2f62353761187bdfe226f327b7ea5d2eb691',changes:'none'},hub:{protocol:1,client:'1.4.0',commit:'35a1047f2067b2af3de3943f0fe452f39105d869',changes:'none'}},null,2)+'\\\\n');\nif(process.argv.includes('--verbose'))console.log(output);\nEOF\ncat > package.json <<'EOF'\n{\\\"name\\\":\\\"kc-munchkin-mix-up\\\",\\\"private\\\":true,\\\"version\\\":\\\"1.0.0\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"test\\\":\\\"node tools/test.mjs\\\"}}\nEOF\nnode tools/build.mjs --verbose\"","aggregated_output":"/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022416__xcf48cf/work/KC-Munchkin-Mix-Up-KC-Munchkin-gpt-6.1-sol-max-20261106-022416.html\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > tools/test.mjs <<'EOF'\nimport {spawnSync} from 'node:child_process';\nimport {readFileSync,writeFileSync,mkdirSync} from 'node:fs';\nimport path from 'node:path';\nimport {root} from './load.mjs';\nconst args=process.argv.slice(2),all=args.length===0||args.includes('--all');let passed=0,failed=0,skipped=0;\nconst reports=[];\nconst run=(name,command,argv)=>{\n const p=spawnSync(command,argv,{cwd:root,encoding:'utf8',maxBuffer:12*1024*1024});\n let result;try{result=JSON.parse(p.stdout.trim());}catch{result={passed:0,failed:1,skipped:0,failures:[\"'`${name}: ${p.stdout}'\"\\\\n\"'${p.stderr}`]};}\n passed+=result.passed||0;failed+=result.failed||0;skipped+=result.skipped||0;reports.push({name,...result});for(const f of result.failures||[])console.log('\"'FAIL '+f);for(const s of result.limitations||[])console.log('SKIP '+s);\n};\nif(all||args.includes('--unit'))run('simulation','node',['tests/simulation.mjs']);\nif(all||args.includes('--browser')||args.includes('--smoke'))run('browser','/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/browser.py',...(args.includes('--smoke')?['--smoke']:[])]);\nif(all||args.includes('--hub'))run('hub','/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/hub.py']);\nmkdirSync(path.join(root,'build/reports'),{recursive:true});writeFileSync(path.join(root,'build/reports/latest.json'),JSON.stringify({passed,failed,skipped,reports},null,2)+'\\\\n');\nconsole.log(\"'`${passed} passed, ${failed} failed, ${skipped} skipped`);process.exitCode=failed?1:0;\nEOF\ncat > tests/simulation.mjs <<'\"'EOF'\nimport assert from 'node:assert/strict';\nimport {loadCore,root} from '../tools/load.mjs';\nimport {readFileSync} from 'node:fs';\nimport vm from 'node:vm';\nconst M=loadCore(['net/session','audio/sound','view/theatre']);\nlet passed=0,failed=0;const failures=[];const details={};\nconst test=(name,fn)=>{try{fn();passed++;}catch(e){failed++;failures.push(name+': '+e.message);}};\ntest('every authored board validates',()=>{for(let i=0;i<6;i++)assert.equal(M.validate(M.stage(i)).ok,true,'stage '+i);});\ntest('normal legal-input whole campaigns',()=>{details.playthroughs=[];for(const seats of [[0],[0,1]]){const w=new M.World({seed:4242,seats}),bots=seats.map(s=>new M.Bot(s));let last=12,finals=0;for(let tick=0;tick<120*1000&&\"'!['\"'won','lost'].includes(w.phase);tick++){for(let j=0;j<w.players.length;j++)w.setIntent(w.players[j].id,bots[j].intent(w,w.players[j]));const prior=w.remaining;w.step();if(prior===1&&w.remaining===0)finals++;}assert.equal(w.phase,'won',JSON.stringify(w.snapshot()));assert.equal(w.assisted,false);assert.equal(w.god,false);assert.equal(w.stats.caught,72);assert.equal(w.stats.stages,6);assert.equal(finals,6);details.playthroughs.push({seats:seats.length,time:w.elapsed,lives:w.lives,score:w.score,stages:w.stats.finals});}});\ntest('native renderer can draw game rigs and board',()=>{const g=new M.E.Game({headless:true,draw:true,res:[480,360],view:'overhead',menu:false});const w=new M.World(),app={screen:'play',overlays:false,net:{active:false}};const view=new M.Theatre(g,app);g.start({update(dt){w.step();view.update(w,dt);},draw:r=>view.draw(r,w)});g.advance(3);assert.deepEqual(g.errors,[]);g.dispose();});\nconsole.log(JSON.stringify({passed,failed,skipped:0,failures,details}));\nEOF\ncat > tests/browser.py <<'EOF'\nimport json\nimport sys\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nPROJECT = json.loads((ROOT.parent / 'project.json').read_text())\nARTIFACT = ROOT.parent / (PROJECT['base'] + '.html')\nOUT = ROOT / 'build' / 'screenshots'\nOUT.mkdir(parents=True, exist_ok=True)\npassed = failed = 0\nfailures = []\ndetails = {}\n\ndef check(name, condition, detail=''):\n    global passed, failed\n    if condition:\n        passed += 1\n    else:\n        failed += 1\n        failures.append(name + (': ' + str(detail) if detail else ''))\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True, args=['--no-sandbox'])\n    try:\n        ctx = browser.new_context(viewport={'width':1920,'height':1080})\n        page = ctx.new_page()\n        errors=[]\n        page.on('pageerror', lambda e: errors.append(str(e)))\n        page.goto(ARTIFACT.as_uri()+'?test=1')\n        page.wait_for_function('window.game && window.mix', timeout=20000)\n        page.wait_for_timeout(1200)\n        check('direct-file title boots', page.evaluate('mix.screen === \\\"title\\\" && \"'!AIHub.active'\"'))\n        check('default music is ten percent', page.evaluate('game.settings.music === .1 && game.audio.musicVolume === .1'))\n        page.screenshot(path=str(OUT/'title-tv.png'))\n        page.get_by_role('button',name='Play solo',exact=True).click()\n        page.wait_for_function('mix.screen === \\\"play\\\"', timeout=10000)\n        page.wait_for_timeout(2900)\n        page.keyboard.down('KeyD')\n        page.wait_for_timeout(650)\n        page.keyboard.up('KeyD')\n        check('keyboard legal movement changes position', page.evaluate('mix.world.players[0].m.x > 2'))\n        page.screenshot(path=str(OUT/'play-tv.png'))\n        check('engine captured no errors', page.evaluate('game.errors.length === 0'), page.evaluate('game.errors.map(e=>e.message)'))\n        check('browser raised no errors',not errors,errors)\n        details['state']=page.evaluate('({screen:mix.screen,menu:mix.ui.screen,errors:game.errors.map(e=>e.message),player:mix.world.players[0].m.x})')\n        ctx.close()\n    except Exception as e:\n        check('browser suite completed',False,str(e))\n    finally:\n        browser.close()\nprint(json.dumps({'passed':passed,'failed':failed,'skipped':0,'failures':failures,'details':details}))\nEOF\nnode tools/test.mjs --unit --smoke\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
