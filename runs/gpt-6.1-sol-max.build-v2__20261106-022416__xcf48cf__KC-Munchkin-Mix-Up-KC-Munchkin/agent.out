is.message='Imported, validated and ready to munch.';return true;}\n    reset(index){this.checkpoint();this.data=M.template(index);this.data.id='workshop';this.data.name='My Mischief Maze';this.errors=[];this.message='Fresh template, fresh trouble.';}\n    rename(name){const clean=String(name).replace(/[\\\\x00-\\\\x1f<>]/g,'').trim().slice(0,32);this.checkpoint();this.data.name=clean||'My Mischief Maze';this.message='Maze name saved.';}\n  }\n  M.Profile=Profile;M.Editor=Editor;\n})(globalThis.Mix);\nEOF\ncat > src/audio/sound.js <<'EOF'\n(function(M){\n  'use strict';\n  const SONG={bpm:116,steps:4,tracks:[\n    {name:'grin',wave:'triangle',vol:.28,notes:'D5 . F5 A5 . G5 F5 . | E5 . G5 B5 . A5 G5 . | F5 . A5 C6 . B5 A5 G5 | E5 . C5 E5 D5 - . .'},\n    {name:'patter',wave:'pulse12',vol:.09,notes:'. . A4 . . . D5 . | . . B4 . . . E5 . | . . C5 . . . F5 . | . . A4 . . C5 . .'},\n    {name:'tummy',wave:'triangle',vol:.3,notes:'D3 . A3 . D3 . F3 . | C3 . G3 . C3 . E3 . | Bb2 . F3 . Bb2 . D3 . | A2 . E3 . A2 . C#3 .'},\n    {name:'mischief',wave:'square',vol:.07,on:false,notes:'A5 . D6 . C6 . A5 . | B5 . E6 . D6 . B5 . | C6 . F6 . E6 . C6 . | A5 G5 F5 E5 D5 - . .'},\n    {name:'feet',wave:'drums',vol:.08,notes:'k . . h . . s . k . h . s . . h'}\n  ]};\n  const SFX={\n    bite:{wave:'triangle',freq:560,to:250,dur:.085,vol:.28},power:{wave:'pulse12',freq:330,to:990,dur:.3,vol:.24,arp:[0,4,7],step:.065},\n    catch:{wave:'square',freq:440,to:900,dur:.22,vol:.2,arp:[0,7,12],step:.06},warning:{wave:'triangle',freq:680,to:310,dur:.22,vol:.24},\n    'gate-warn':{wave:'sine',freq:180,to:310,dur:.13,vol:.22},'gate-turn':{wave:'triangle',freq:220,to:420,dur:.18,vol:.18},\n    tunnel:{wave:'sine',freq:870,to:220,dur:.19,vol:.24},chirp:{wave:'triangle',freq:480,to:1440,dur:.21,vol:.25,arp:[0,7],step:.08},\n    hit:{wave:'saw',freq:230,to:65,dur:.35,vol:.18},respawn:{wave:'sine',freq:220,to:660,dur:.2,vol:.2},\n    clear:{wave:'triangle',freq:440,dur:.5,vol:.26,arp:[0,4,7,12],step:.1},victory:{wave:'triangle',freq:294,dur:.8,vol:.26,arp:[0,4,7,12,16,12],step:.11},failure:{wave:'triangle',freq:294,to:73,dur:.65,vol:.2},bump:{wave:'sine',freq:130,to:80,dur:.06,vol:.08}\n  };\n  // Shared by live voices and OfflineAudioContext verification. No files, speech APIs or encoded samples.\n  function phoneme(ctx,bus,time,freq,duration,volume,vowel=0){\n    const o=ctx.createOscillator(), filter=ctx.createBiquadFilter(),gain=ctx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(freq,time);o.frequency.exponentialRampToValueAtTime(freq*1.12,time+duration);\n    filter.type='bandpass';filter.frequency.setValueAtTime([880,1350,580,1900][vowel%4],time);filter.Q.value=3.2;\n    gain.gain.setValueAtTime(0,time);gain.gain.linearRampToValueAtTime(volume,time+.012);gain.gain.exponentialRampToValueAtTime(.0001,time+duration);\n    o.connect(filter);filter.connect(gain);gain.connect(bus);o.start(time);o.stop(time+duration+.01);return o;\n  }\n  class Sound {\n    constructor(game){this.game=game;this.audio=game.audio;this.unlocked=false;this.ended=false;this.lastEvent=0;this.voices=[];this.voiceCooldown=0;this.lastLast=false;this.paused=false;}\n    unlock(){if(this.unlocked||this.ended)return;this.unlocked=true;this.audio.bus('sfx');if(this.audio.ctx?.state==='suspended')this.audio.ctx.resume().catch(()=>{});this.audio.music(SONG,{sync:true});}\n    babble(kind='grin'){\n      if(\"'!this.unlocked||this.ended||!this.audio.ctx||this.game.real<this.voiceCooldown)return;\n      const c=this.audio.ctx,b=this.audio.bus('\"'voice'),base=kind==='alarm'?190:kind==='laugh'?280:240,seq=kind==='laugh'?[0,7,4,7,12,7]:kind==='alarm'?[7,0,3]:[0,4,2,7];\n      this.voiceCooldown=this.game.real+1.1;\n      for(let i=0;i<seq.length;i++)this.voices.push(phoneme(c,b,c.currentTime+i*.085,base*2**(seq[i]/12),.09,.18,i));\n      if(this.voices.length>64)this.voices.splice(0,this.voices.length-64);\n    }\n    events(events){\n      for(const e of events){if(e.id<=this.lastEvent)continue;this.lastEvent=e.id;if(\"'!this.unlocked||this.ended)continue;\n        if(SFX[e.type])this.audio.sfx(SFX[e.type],{pitch:e.type==='\"'catch'?1+e.points/40:e.type==='bite'?1+Number(e.food.slice(1))*.012:1});\n        if(e.type==='hit')this.babble('alarm');if(e.type==='go')this.babble();if(e.type==='clear'||e.type==='victory')this.babble('laugh');\n      }\n    }\n    update(world,paused=false){\n      if(\"'!this.unlocked||this.ended)return;\n      const last=world&&world.remaining<=3&&world.phase==='\"'playing';if(last\"'!==this.lastLast){this.audio.layer('\"'mischief',last?.07:0,.3);this.lastLast=last;}\n      if(paused\"'!==this.paused){this.paused=paused;for(const node of this.voices)try{node.stop();}catch{}this.voices=[];if(this.audio.ctx){this.audio._sfxBus.gain.value=paused?0:this.audio.sfxVolume;this.audio._voiceBus.gain.value=paused?0:this.audio.voiceVolume;}}\n    }\n    end(){this.ended=true;this.audio.music(null);this.audio.mute(true);for(const node of this.voices)try{node.stop();}catch{}this.voices=[];if(this.audio.ctx)this.audio.ctx.suspend().catch(()=>{});}\n  }\n  M.SONG=SONG;M.SFX=SFX;M.phoneme=phoneme;M.Sound=Sound;\n})(globalThis.Mix);\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > src/view/theatre.js <<'EOF'\n(function(M){\n  'use strict';\n  const {E,DIRS}=M,{px}=E,T=16;\n  const COLORS={hero:['#57e1dc','#b0a0ff'],food:'#ffe29a',power:'#ffed9e',needle:'#f16d8b',peek:'#fbb66d',chonk:'#af91eb'};\n  E.MATERIALS.mixMetal={color:'#695083',pattern:'metal',rivet:0};\n  E.MATERIALS.mixGlow={color:'#a9f4e9',pattern:'none',glow:1};\n  E.SHAPES.mixBolt={about:'Original recessed cabinet screw',mats:{m:'mixMetal'},parts:[['cyl','m',[0,0,0],2,1,{seg:8}],['box','iron',[0,0,1],[2.5,.5,.3]]]};\n  E.SHAPES.mixRotor={about:'Original low-profile pen rotor',mats:{m:'mixMetal',g:'mixGlow'},parts:[['cyl','m',[0,0,0],20,1,{seg:16}],['cyl','iron',[0,0,1],15,1,{seg:12}],['ring',8,17,['box','g',[0,0,1],[1,2,1]]]]};\n  class Creature {\n    constructor(kind,index=0){\n      this.kind=kind;this.index=index;this.radius=kind==='food'?3.4:kind==='power'?4.2:kind==='chonk'?6.2:kind==='hero'?6:5.5;\n      const c=kind==='hero'?COLORS.hero[index%2]:COLORS[kind]||COLORS.food,tones=E.tones(c);\n      this.rig=new E.Blob({R:this.radius,face:'front',charView:false,feet:kind==='food'||kind==='power',mouth:false,colors:{dk:tones.deep,base:c,lt:tones.lt,spec:tones.hi,eye:'#fff9e9',pupil:'#29182e'}});\n      this.t=0;this.entity=null;this.lean=0;\n    }\n    update(dt,a,w){\n      this.t+=dt;this.entity=a;this.world=w;const d=DIRS[a.m.d]||[0,0],moving=a.m.moving;\n      const hunt=a.state==='hunting',fright=a.state==='frightened'||a.state==='warning';\n      let color=this.kind==='hero'?COLORS.hero[this.index%2]:COLORS[this.kind]||COLORS.food;\n      if(fright)color='#a5d9d1';if(a.state==='recharging')color='#776781';\n      const tones=E.tones(color);Object.assign(this.rig.C,{base:color,dk:tones.deep,lt:tones.lt});\n      this.rig.scale=this.kind==='chonk'?1.07:1;\n      this.rig.update(dt,{look:a.hit?[0,1]:d,walk:moving?1:0,squint:hunt&&this.kind==='needle',squash:a.hit?-.38:a.bite>0?-.12:fright?.1:moving?Math.sin(this.t*16)*.035:Math.sin(this.t*3)*.035});\n      this.lean=M.clamp(this.lean+(moving?.7:-.7)*dt,0,.1);\n    }\n    draw(g,ox,oy,view){\n      const a=this.entity,w=this.world;if(\"'!a)return;const sc=view.scale,R=this.radius*sc,still=this.rig.t;\n      const bob=this.kind==='\"'food'||this.kind==='power'?(Math.sin(still*10+this.index)*.6):0;oy-=bob*sc;\n      if(a.state==='returning'){\n        for(const s of [-1,1]){px.ell(g,ox+s*R*.35,oy,1.7*sc,2.2*sc,'#f5eedf');px.dot(g,ox+s*R*.35+(DIRS[a.m.d]?.[0]||0)*sc,oy,'#594174');}\n        for(let i=0;i<3;i++)px.rect(g,ox+(i-1)*R*.7,oy+R*.6,1.8*sc,sc,'#bba8d4');return;\n      }\n      if(this.kind==='hero'){\n        for(const s of [-1,1]){\n          const bend=this.index===1?s*2:Math.sin(still*4+s)*.8;\n          const x=ox+s*R*.56,y=oy-R*.62;\n          px.line(g,x,y,x+s*R*.22+bend*sc,y-R*.7,'#247679',Math.max(1,sc));\n          if(this.index===1)px.poly(g,[[x+s*R*.22+bend*sc-2*sc,y-R*.7],[x+s*R*.22+bend*sc,y-R*.7-2*sc],[x+s*R*.22+bend*sc+2*sc,y-R*.7]],'#eee1ff');\n          else px.disc(g,x+s*R*.22+bend*sc,y-R*.7,1.7*sc,'#affff0');\n        }\n      }\n      if(['needle','peek','chonk'].includes(this.kind)){\n        const feet=this.kind==='needle'?4:3;\n        for(let i=0;i<feet;i++){\n          const x=ox+(i-(feet-1)/2)*R*.58,walk=Math.sin(still*11+i)*sc*(a.m.moving?1:0);\n          px.line(g,x,oy+R*.5,x+walk,oy+R*1.12,'#5a304e',Math.max(1,sc));px.ell(g,x+walk,oy+R*1.12,1.5*sc,.7*sc,'#dac1c8');\n        }\n        if(this.kind==='needle')px.poly(g,[[ox-R*.4,oy-R*.7],[ox,oy-R*1.65],[ox+R*.4,oy-R*.7]],'#fda0b7');\n        if(this.kind==='peek')for(const s of [-1,1])px.poly(g,[[ox+s*R*.6,oy-R*.5],[ox+s*R*1.3,oy-R*1.15],[ox+s*R*.8,oy+R*.1]],'#ffd5a0');\n        if(this.kind==='chonk')for(const s of [-1,1])px.ell(g,ox+s*R*.87,oy-R*.22,R*.35,R*.42,'#8d6fbf');\n      }\n      this.rig.draw(g,ox,oy,view);\n      const mouthY=oy+R*.44,mouthX=ox+(DIRS[a.m.d]?.[0]||0)*R*.15;\n      if(this.kind==='hero'){\n        const bite=a.bite>0,alarm=a.hit>0,win=w.phase==='clear'||w.phase==='won';\n        if(bite||win){px.ell(g,mouthX,mouthY,R*.49,R*(bite?.4:.3),'#20212f');px.ell(g,mouthX,mouthY+R*.13,R*.25,R*.11,'#fc9baf');px.rect(g,mouthX-R*.28,mouthY-R*.18,R*.56,sc,'#fff8db');}\n        else if(alarm){px.poly(g,[[mouthX-R*.35,mouthY+sc],[mouthX,mouthY-sc],[mouthX+R*.35,mouthY+sc]],'#24444e');}\n        else{px.line(g,mouthX-R*.4,mouthY-sc,mouthX-R*.24,mouthY+sc,'#24444e',sc);px.line(g,mouthX-R*.24,mouthY+sc,mouthX+R*.24,mouthY+sc,'#24444e',sc);px.dot(g,mouthX+R*.38,mouthY,'#24444e');}\n        for(const s of [-1,1])px.ell(g,ox+s*R*.72,oy+R*.2,1.1*sc,.6*sc,'#e6b7b9');\n      }else if(this.kind==='food'||this.kind==='power'){\n        px.rect(g,mouthX-sc,mouthY,2*sc,sc,'#8d592e');\n        if(this.kind==='power'){\n          const sy=oy-R*1.3;px.poly(g,[[ox,sy-2*sc],[ox+sc,sy],[ox+3*sc,sy],[ox+1.5*sc,sy+sc],[ox+2*sc,sy+3*sc],[ox,sy+2*sc],[ox-2*sc,sy+3*sc],[ox-1.5*sc,sy+sc],[ox-3*sc,sy],[ox-sc,sy]],'#fff6c9');\n        }\n        if(a.turn>0){const d=DIRS[a.pending]||DIRS[a.m.d]||[0,0];px.disc(g,ox+d[0]*R*1.35,oy+d[1]*R*1.35,.7*sc,'#fff4c9');}\n      }else{\n        const frightened=a.state==='frightened'||a.state==='warning';\n        if(frightened){px.poly(g,[[mouthX-R*.4,mouthY],[mouthX-R*.2,mouthY-sc],[mouthX,mouthY+sc],[mouthX+R*.2,mouthY-sc],[mouthX+R*.4,mouthY]],'#35505a');}\n        else{px.rect(g,mouthX-R*.45,mouthY,R*.9,2*sc,'#3f2843');for(let i=0;i<3;i++)px.rect(g,mouthX-R*.32+i*R*.3,mouthY,sc,sc,'#fff3d2');}\n        if(a.state==='warning')for(let i=-1;i<=1;i++)px.line(g,ox+i*R*.5,oy-R*.7,ox+i*R*.5+R*.35,oy-R*.25,'#fff1d9',Math.max(1,sc));\n        if(a.state==='penned'||a.state==='recharging')px.rect(g,ox-R*.4,oy-R*1.2,Math.max(sc,R*.8*(1-M.clamp(a.wait/12,0,1))),sc,'#ddc4fc');\n      }\n    }\n  }\n  class Theatre {\n    constructor(game,app){this.game=game;this.app=app;this.rigs=new Map();this.lastEvent=0;this.rev=0;this.trails=new Map();this.layout={};}\n    reset(){this.rigs.clear();this.lastEvent=0;this.rev=0;this.trails.clear();}\n    fit(w){\n      const g=this.game,title=this.app.screen==='title',portrait=g.H>g.W*1.05;\n      let zoom=Math.min((g.W-64)/(w.board.w*T),(g.H-88)/(w.board.h*T)),offset=[0,10];\n      if(title){zoom=portrait?Math.min((g.W-54)/(w.board.w*T),(g.H*.43)/(w.board.h*T)):Math.min((g.W*.55-20)/(w.board.w*T),(g.H-90)/(w.board.h*T));offset=portrait?[0,g.H*.22]:[g.W*.195,12];}\n      zoom=M.clamp(zoom,.5,2.5);if(Math.abs(g.zoom-zoom)>.005)g.setZoom(zoom);\n      g.cam.offset=offset;g.cam.smooth=0;g.focus(w.board.w*T/2,w.board.h*T/2,0);\n      this.layout={zoom,portrait};\n    }\n    update(w,dt){\n      this.fit(w);\n      const actors=[...w.food.filter(f=>f.alive),...w.predators,...w.players];\n      for(const a of actors){const hero=w.players.includes(a),food=w.food.includes(a),kind=hero?'hero':food?(a.power?'power':'food'):a.id;\n        const id=(hero?'p':food?'f':'e')+a.id;let rig=this.rigs.get(id);if(\"'!rig){rig=new Creature(kind,hero?a.seat:food?Number(a.id.slice(1)):0);this.rigs.set(id,rig);}rig.update(dt,a,w);\n        let trail=this.trails.get(id)||[];if(w.tick%5===0&&a.m.moving){trail.push([a.m.x,a.m.y]);if(trail.length>5)trail.shift();this.trails.set(id,trail);}\n      }\n      for(const e of w.events){if(e.id<=this.lastEvent)continue;this.lastEvent=e.id;const x=(e.x+.5)*T,y=(e.y+.5)*T;\n        if(e.type==='\"'bite'||e.type==='catch'){this.game.particles.glints(x,y,0,6,e.type==='catch'?'#ddb1ff':'#fff0ab');this.game.particles.ring(x,y,2,11,'#ffe4a1',.25);const p=this.rigs.get('p'+e.player);if(p)p.rig.kick(-2);}\n        if(e.type==='hit'){this.game.particles.bits(x,y,0,10,['#7ef3e3','#ead4ff']);if(\"'!this.game.reduceMotion)this.game.shake(1.2);}\n        if(e.type==='\"'chirp')this.game.particles.ring(x,y,3,75,'#b4f5e9',.7);\n        if(e.type==='clear'||e.type==='victory'){for(let i=0;i<16;i++)this.game.particles.glints((1+(i*7)%19+.5)*T,(1+(i*11)%15+.5)*T,0,3,['#ffe2a3','#b3e7db','#ceabef'][i%3]);}\n      }\n    }\n    draw(r,w){\n      const g=this.game,b=w.board,t=w.time,scale=r.view.scale,[bx,by]=r.w(0,0),S=T*scale,bw=b.w*S,bh=b.h*S;\n      r.sky(['#100d1b','#171020','#21152a']);\n      r.decal(ctx=>{\n        // Toy cabinet surround, printed circuit traces and recessed floor.\n        px.rect(ctx,bx-12*scale,by-12*scale,bw+24*scale,bh+24*scale,'#100e1a');\n        px.rect(ctx,bx-10*scale,by-10*scale,bw+20*scale,bh+20*scale,'#3e2a52');\n        px.rect(ctx,bx-8*scale,by-8*scale,bw+16*scale,bh+16*scale,'#251b34');\n        px.line(ctx,bx-7*scale,by-7*scale,bx+bw+6*scale,by-7*scale,'#9d72bd',scale);\n        px.line(ctx,bx-7*scale,by-7*scale,bx-7*scale,by+bh+6*scale,'#694981',scale);\n        px.rect(ctx,bx-2*scale,by-2*scale,bw+4*scale,bh+4*scale,'#0a101d');\n        for(let y=0;y<b.h;y++)for(let x=0;x<b.w;x++){\n          const X=bx+x*S,Y=by+y*S;\n          px.rect(ctx,X,Y,S+.1,S+.1,(x+y)%2?'#211a2e':'#241c32');\n          if(b.baseWalk(x,y)&&((x*7+y*11)%5===0)){px.rect(ctx,X+S*.45,Y+S*.46,scale,scale,'#3e3049');}\n          if(\"'!b.baseWalk(x,y)){\n            const pen=x>=8&&x<=12&&y>=6&&y<=10,edge=x===0||x===20||y===0||y===16;\n            let shown=1;\n            const fades=w.data.reveal.kind==='\"'all'||w.data.reveal.kind==='bands'&&(y<6||y>10);\n            if(fades&&\"'!pen&&!edge&&w.reveal<=0&&!w.showWalls){const moving=w.players.some(p=>p.m.moving);shown=moving?.10:.4;if(w.echo.some(e=>Math.hypot(e.x-x,e.y-y)<3))shown=.9;}\n            px.blend(ctx,shown,'\"'normal',()=>{\n              px.rect(ctx,X+scale,Y+2*scale,S-scale,S-scale,'#0d0e19');\n              px.rect(ctx,X+scale,Y+scale,S-2*scale,S-3*scale,pen?'#675779':'#68459a');\n              px.rect(ctx,X+2*scale,Y+scale,S-4*scale,2*scale,pen?'#a795b7':'#b389e4');\n              px.rect(ctx,X+scale,Y+2*scale,scale,S-5*scale,'#9471c5');\n              px.rect(ctx,X+2*scale,Y+S-4*scale,S-4*scale,2*scale,'#3b2b60');\n              if((x+y)%3===0)px.line(ctx,X+4*scale,Y+S/2,X+S-4*scale,Y+S/2,'#7853a9',scale);\n            });\n          }\n        }\n        for(let i=0;i<4;i++){\n          const [x,y]=b.gateCells[i],X=bx+x*S,Y=by+y*S,open=i===b.orientation;\n          if(\"'!open){px.rect(ctx,X+scale,Y+scale,S-2*scale,S-2*scale,'\"'#695979');for(let j=0;j<3;j++)px.rect(ctx,X+(3+j*4)*scale,Y+3*scale,2*scale,S-6*scale,'#a895be');}\n          else{px.rect(ctx,X+2*scale,Y+2*scale,S-4*scale,S-4*scale,w.gateWarn?'#a38d67':'#32505b');const d=DIRS[i],cx=X+S/2,cy=Y+S/2;px.line(ctx,cx-d[0]*3*scale,cy-d[1]*3*scale,cx+d[0]*3*scale,cy+d[1]*3*scale,'#bcf9de',scale);}\n        }\n        // Every tunnel mouth is striped and shows a matching destination tick.\n        b.tunnels.forEach((tunnel,i)=>{for(const p of [tunnel.a,tunnel.b]){const X=bx+p[0]*S,Y=by+p[1]*S;px.rect(ctx,X,Y,S,S,'#364754');for(let j=0;j<4;j++)px.rect(ctx,X+j*4*scale,Y,2*scale,S,['#87d5d1','#d9c4ee','#f1d09d'][i%3]);px.rect(ctx,X+4*scale,Y+5*scale,S-8*scale,S-10*scale,'#162333');}});\n        if(w.phase==='clear'||w.phase==='won')px.blend(ctx,.08,'add',()=>px.rect(ctx,bx,by,bw,bh,'#ffe6a8'));\n      });\n      for(const p of [[-5,-5],[b.w*T+5,-5],[-5,b.h*T+5],[b.w*T+5,b.h*T+5]])r.shape('mixBolt',...p,0,{scale:.8,shadow:false});\n      r.shape('mixRotor',(10.5)*T,(8.5)*T,0,{facing:b.orientation*Math.PI/2,shadow:false,bias:-500});\n      for(const a of [...w.food.filter(f=>f.alive),...w.predators,...w.players]){\n        const hero=w.players.includes(a),food=w.food.includes(a),id=(hero?'p':food?'f':'e')+a.id,rig=this.rigs.get(id);if(\"'!rig)continue;\n        const xx=(a.m.x+.5)*T,yy=(a.m.y+.5)*T,colors=hero?COLORS.hero[a.seat%2]:food?(a.power?'\"'#ffd779':'#ebc993'):COLORS[a.id];\n        if(food&&w.remaining<=3&&\"'!this.game.reduceMotion){const tr=this.trails.get(id)||[];for(let i=0;i<tr.length;i++)r.groundDisc((tr[i][0]+.5)*T,(tr[i][1]+.5)*T,1.4,'\"'#b99b67',.12+i*.025);}\n        if(hero){r.groundRing(xx,yy,8.3,colors,1);if(a.chirpFx>0)r.groundRing(xx,yy,12+(1-a.chirpFx/.75)*42,'#a9ede3',1);}\n        r.shadow(xx,yy,food?3:6,.32,'#070b16');\n        const drawAt=(x,y)=>r.actor(x,y,0,(ctx,ox,oy)=>rig.draw(ctx,ox,oy,r.view),{alpha:hero&&a.inv>0?(Math.floor(t*8)%2?.52:1):1,outline:hero?'#d3fcf0':false});\n        drawAt(xx,yy);\n        if(a.m.x<.3&&b.tunnels.some(t=>Math.abs(a.m.y-t.a[1])<.2))drawAt(xx+b.w*T,yy);\n        if(a.m.x>b.w-1.3&&b.tunnels.some(t=>Math.abs(a.m.y-t.a[1])<.2))drawAt(xx-b.w*T,yy);\n        if(hero)r.textAt(xx,yy+10,0,String(a.seat+1),colors);\n        if(this.app.overlays){r.groundRing(xx,yy,4.7,food?'#fff1b9':'#f9a8c2',1);r.textAt(xx,yy-12,0,hero?'P'+(a.seat+1):food?a.id:a.state,'#f2dfc8');if(a.m.moving){const end=r.w((a.m._to[0]+.5)*T,(a.m._to[1]+.5)*T,0),start=r.w(xx,yy,0);r.overlay(ctx=>px.line(ctx,...start,...end,'#e9ce9f',1));}}\n      }\n      if(this.app.screen==='editor')this.drawEditor(r,b,bx,by,S);\n      if(this.app.screen==='attract')r.overlay(ctx=>{E.ui.box(ctx,r.W/2-120,r.H-40,240,29,{bg:'#161223',border:'#a789b6'});E.font.text(ctx,'A LITTLE MISCHIEF / DEMO',r.W/2,r.H-34,'#ffe8b1',{align:'center'});E.font.text(ctx,'Any input brings you back',r.W/2,r.H-22,'#c8b9db',{align:'center'});});\n      if(this.app.screen==='play'&&w.phase==='intro')this.card(r,w.data.name,w.data.subtitle,\"'`${Math.max(1,Math.ceil(w.phaseT))} ... READY, STEADY, CHEW!`);\n      if(this.app.screen==='\"'play'&&w.phase==='clear')this.card(r,'DELICIOUS\"'!'\"',w.data.clear,\"'`${w.stageIndex===5||w.mode!=='\"'campaign'?'One last laugh':'Next mix coming up'} · +\"'${w.tuning.lifeRestore} life`);\n      if(this.app.net?.active&&!this.app.net.started)this.card(r,'\"'GET YOUR GRIN ON','YOUR TEAM IS GETTING READY','Hub starts the round automatically');\n      else if(this.app.net?.active&&AIHub.time()<0)this.card(r,String(Math.max(1,Math.ceil(-AIHub.time()/1000))),'READY, STEADY, CHEW\"'!'\"','A shared appetite. A shared adventure.');\n    }\n    card(r,title,sub,foot){r.overlay(ctx=>{const width=Math.min(330,r.W-36),x=(r.W-width)/2,y=r.H/2-43;E.ui.box(ctx,x,y,width,85,{bg:'#21182f',border:'#d4a9ed',alpha:.97});E.font.title(ctx,title,r.W/2,y+12,{scale:1,colors:['#fff1bd','#dfbcf1'],align:'center',depth:1});E.font.text(ctx,sub,r.W/2,y+34,'#d0c2de',{align:'center',wrap:width-20});E.font.text(ctx,foot,r.W/2,y+63,'#99e6d7',{align:'center',wrap:width-20});});}\n    drawEditor(r,b,bx,by,S){const ed=this.app.editor,sc=r.view.scale;r.overlay(ctx=>{for(let i=0;i<ed.data.food.length;i++){const f=ed.data.food[i],x=bx+(f.x+.5)*S,y=by+(f.y+.5)*S;px.disc(ctx,x,y,(f.power?4:3)*sc,f.power?'#fff3b8':'#e8bb77');}for(let i=0;i<2;i++){const p=ed.data.spawns[i];E.font.text(ctx,String(i+1),bx+(p[0]+.5)*S,by+(p[1]+.3)*S,COLORS.hero[i],{align:'center'});}const x=bx+ed.x*S,y=by+ed.y*S,c=ed.errors.length?'#f99cac':'#b4f5e2';px.line(ctx,x,y,x+S,y,c,sc);px.line(ctx,x+S,y,x+S,y+S,c,sc);px.line(ctx,x,y+S,x+S,y+S,c,sc);px.line(ctx,x,y,x,y+S,c,sc);});}\n    cellAt(sx,sy){const g=this.game,p=g.view.toGround(g.cam.x+sx,g.cam.y+sy);return p?[Math.floor(p[0]/T),Math.floor(p[1]/T)]:null;}\n  }\n  M.Creature=Creature;M.Theatre=Theatre;\n})(globalThis.Mix);\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > src/view/theatre.js <<'EOF'\n(function(M){\n  'use strict';\n  const {E,DIRS}=M,{px}=E,T=16;\n  const COLORS={hero:['#57e1dc','#b0a0ff'],food:'#ffe29a',power:'#ffed9e',needle:'#f16d8b',peek:'#fbb66d',chonk:'#af91eb'};\n  E.MATERIALS.mixMetal={color:'#695083',pattern:'metal',rivet:0};\n  E.MATERIALS.mixGlow={color:'#a9f4e9',pattern:'none',glow:1};\n  E.SHAPES.mixBolt={about:'Original recessed cabinet screw',mats:{m:'mixMetal'},parts:[['cyl','m',[0,0,0],2,1,{seg:8}],['box','iron',[0,0,1],[2.5,.5,.3]]]};\n  E.SHAPES.mixRotor={about:'Original low-profile pen rotor',mats:{m:'mixMetal',g:'mixGlow'},parts:[['cyl','m',[0,0,0],20,1,{seg:16}],['cyl','iron',[0,0,1],15,1,{seg:12}],['ring',8,17,['box','g',[0,0,1],[1,2,1]]]]};\n  class Creature {\n    constructor(kind,index=0){\n      this.kind=kind;this.index=index;this.radius=kind==='food'?3.4:kind==='power'?4.2:kind==='chonk'?6.2:kind==='hero'?6:5.5;\n      const c=kind==='hero'?COLORS.hero[index%2]:COLORS[kind]||COLORS.food,tones=E.tones(c);\n      this.rig=new E.Blob({R:this.radius,face:'front',charView:false,feet:kind==='food'||kind==='power',mouth:false,colors:{dk:tones.deep,base:c,lt:tones.lt,spec:tones.hi,eye:'#fff9e9',pupil:'#29182e'}});\n      this.t=0;this.entity=null;this.lean=0;\n    }\n    update(dt,a,w){\n      this.t+=dt;this.entity=a;this.world=w;const d=DIRS[a.m.d]||[0,0],moving=a.m.moving;\n      const hunt=a.state==='hunting',fright=a.state==='frightened'||a.state==='warning';\n      let color=this.kind==='hero'?COLORS.hero[this.index%2]:COLORS[this.kind]||COLORS.food;\n      if(fright)color='#a5d9d1';if(a.state==='recharging')color='#776781';\n      const tones=E.tones(color);Object.assign(this.rig.C,{base:color,dk:tones.deep,lt:tones.lt});\n      this.rig.scale=this.kind==='chonk'?1.07:1;\n      this.rig.update(dt,{look:a.hit?[0,1]:d,walk:moving?1:0,squint:hunt&&this.kind==='needle',squash:a.hit?-.38:a.bite>0?-.12:fright?.1:moving?Math.sin(this.t*16)*.035:Math.sin(this.t*3)*.035});\n      this.lean=M.clamp(this.lean+(moving?.7:-.7)*dt,0,.1);\n    }\n    draw(g,ox,oy,view){\n      const a=this.entity,w=this.world;if(\"'!a)return;const sc=view.scale,R=this.radius*sc,still=this.rig.t;\n      const bob=this.kind==='\"'food'||this.kind==='power'?(Math.sin(still*10+this.index)*.6):0;oy-=bob*sc;\n      if(a.state==='returning'){\n        for(const s of [-1,1]){px.ell(g,ox+s*R*.35,oy,1.7*sc,2.2*sc,'#f5eedf');px.dot(g,ox+s*R*.35+(DIRS[a.m.d]?.[0]||0)*sc,oy,'#594174');}\n        for(let i=0;i<3;i++)px.rect(g,ox+(i-1)*R*.7,oy+R*.6,1.8*sc,sc,'#bba8d4');return;\n      }\n      if(this.kind==='hero'){\n        for(const s of [-1,1]){\n          const bend=this.index===1?s*2:Math.sin(still*4+s)*.8;\n          const x=ox+s*R*.56,y=oy-R*.62;\n          px.line(g,x,y,x+s*R*.22+bend*sc,y-R*.7,'#247679',Math.max(1,sc));\n          if(this.index===1)px.poly(g,[[x+s*R*.22+bend*sc-2*sc,y-R*.7],[x+s*R*.22+bend*sc,y-R*.7-2*sc],[x+s*R*.22+bend*sc+2*sc,y-R*.7]],'#eee1ff');\n          else px.disc(g,x+s*R*.22+bend*sc,y-R*.7,1.7*sc,'#affff0');\n        }\n      }\n      if(['needle','peek','chonk'].includes(this.kind)){\n        const feet=this.kind==='needle'?4:3;\n        for(let i=0;i<feet;i++){\n          const x=ox+(i-(feet-1)/2)*R*.58,walk=Math.sin(still*11+i)*sc*(a.m.moving?1:0);\n          px.line(g,x,oy+R*.5,x+walk,oy+R*1.12,'#5a304e',Math.max(1,sc));px.ell(g,x+walk,oy+R*1.12,1.5*sc,.7*sc,'#dac1c8');\n        }\n        if(this.kind==='needle')px.poly(g,[[ox-R*.4,oy-R*.7],[ox,oy-R*1.65],[ox+R*.4,oy-R*.7]],'#fda0b7');\n        if(this.kind==='peek')for(const s of [-1,1])px.poly(g,[[ox+s*R*.6,oy-R*.5],[ox+s*R*1.3,oy-R*1.15],[ox+s*R*.8,oy+R*.1]],'#ffd5a0');\n        if(this.kind==='chonk')for(const s of [-1,1])px.ell(g,ox+s*R*.87,oy-R*.22,R*.35,R*.42,'#8d6fbf');\n      }\n      this.rig.draw(g,ox,oy,view);\n      const mouthY=oy+R*.44,mouthX=ox+(DIRS[a.m.d]?.[0]||0)*R*.15;\n      if(this.kind==='hero'){\n        const bite=a.bite>0,alarm=a.hit>0,win=w.phase==='clear'||w.phase==='won';\n        if(bite||win){px.ell(g,mouthX,mouthY,R*.49,R*(bite?.4:.3),'#20212f');px.ell(g,mouthX,mouthY+R*.13,R*.25,R*.11,'#fc9baf');px.rect(g,mouthX-R*.28,mouthY-R*.18,R*.56,sc,'#fff8db');}\n        else if(alarm){px.poly(g,[[mouthX-R*.35,mouthY+sc],[mouthX,mouthY-sc],[mouthX+R*.35,mouthY+sc]],'#24444e');}\n        else{px.line(g,mouthX-R*.4,mouthY-sc,mouthX-R*.24,mouthY+sc,'#24444e',sc);px.line(g,mouthX-R*.24,mouthY+sc,mouthX+R*.24,mouthY+sc,'#24444e',sc);px.dot(g,mouthX+R*.38,mouthY,'#24444e');}\n        for(const s of [-1,1])px.ell(g,ox+s*R*.72,oy+R*.2,1.1*sc,.6*sc,'#e6b7b9');\n      }else if(this.kind==='food'||this.kind==='power'){\n        px.rect(g,mouthX-sc,mouthY,2*sc,sc,'#8d592e');\n        if(this.kind==='power'){\n          const sy=oy-R*1.3;px.poly(g,[[ox,sy-2*sc],[ox+sc,sy],[ox+3*sc,sy],[ox+1.5*sc,sy+sc],[ox+2*sc,sy+3*sc],[ox,sy+2*sc],[ox-2*sc,sy+3*sc],[ox-1.5*sc,sy+sc],[ox-3*sc,sy],[ox-sc,sy]],'#fff6c9');\n        }\n        if(a.turn>0){const d=DIRS[a.pending]||DIRS[a.m.d]||[0,0];px.disc(g,ox+d[0]*R*1.35,oy+d[1]*R*1.35,.7*sc,'#fff4c9');}\n      }else{\n        const frightened=a.state==='frightened'||a.state==='warning';\n        if(frightened){px.poly(g,[[mouthX-R*.4,mouthY],[mouthX-R*.2,mouthY-sc],[mouthX,mouthY+sc],[mouthX+R*.2,mouthY-sc],[mouthX+R*.4,mouthY]],'#35505a');}\n        else{px.rect(g,mouthX-R*.45,mouthY,R*.9,2*sc,'#3f2843');for(let i=0;i<3;i++)px.rect(g,mouthX-R*.32+i*R*.3,mouthY,sc,sc,'#fff3d2');}\n        if(a.state==='warning')for(let i=-1;i<=1;i++)px.line(g,ox+i*R*.5,oy-R*.7,ox+i*R*.5+R*.35,oy-R*.25,'#fff1d9',Math.max(1,sc));\n        if(a.state==='penned'||a.state==='recharging')px.rect(g,ox-R*.4,oy-R*1.2,Math.max(sc,R*.8*(1-M.clamp(a.wait/12,0,1))),sc,'#ddc4fc');\n      }\n    }\n  }\n  class Theatre {\n    constructor(game,app){this.game=game;this.app=app;this.rigs=new Map();this.lastEvent=0;this.rev=0;this.trails=new Map();this.layout={};}\n    reset(){this.rigs.clear();this.lastEvent=0;this.rev=0;this.trails.clear();}\n    fit(w){\n      const g=this.game,title=this.app.screen==='title',portrait=g.H>g.W*1.05;\n      let zoom=Math.min((g.W-64)/(w.board.w*T),(g.H-88)/(w.board.h*T)),offset=[0,10];\n      if(title){zoom=portrait?Math.min((g.W-54)/(w.board.w*T),(g.H*.43)/(w.board.h*T)):Math.min((g.W*.55-20)/(w.board.w*T),(g.H-90)/(w.board.h*T));offset=portrait?[0,g.H*.22]:[g.W*.195,12];}\n      zoom=M.clamp(zoom,.5,2.5);if(Math.abs(g.zoom-zoom)>.005)g.setZoom(zoom);\n      g.cam.offset=offset;g.cam.smooth=0;g.focus(w.board.w*T/2,w.board.h*T/2,0);\n      this.layout={zoom,portrait};\n    }\n    update(w,dt){\n      this.fit(w);\n      const actors=[...w.food.filter(f=>f.alive),...w.predators,...w.players];\n      for(const a of actors){const hero=w.players.includes(a),food=w.food.includes(a),kind=hero?'hero':food?(a.power?'power':'food'):a.id;\n        const id=(hero?'p':food?'f':'e')+a.id;let rig=this.rigs.get(id);if(\"'!rig){rig=new Creature(kind,hero?a.seat:food?Number(a.id.slice(1)):0);this.rigs.set(id,rig);}rig.update(dt,a,w);\n        let trail=this.trails.get(id)||[];if(w.tick%5===0&&a.m.moving){trail.push([a.m.x,a.m.y]);if(trail.length>5)trail.shift();this.trails.set(id,trail);}\n      }\n      for(const e of w.events){if(e.id<=this.lastEvent)continue;this.lastEvent=e.id;const x=(e.x+.5)*T,y=(e.y+.5)*T;\n        if(e.type==='\"'bite'||e.type==='catch'){this.game.particles.glints(x,y,0,6,e.type==='catch'?'#ddb1ff':'#fff0ab');this.game.particles.ring(x,y,2,11,'#ffe4a1',.25);const p=this.rigs.get('p'+e.player);if(p)p.rig.kick(-2);}\n        if(e.type==='hit'){this.game.particles.bits(x,y,0,10,['#7ef3e3','#ead4ff']);if(\"'!this.game.reduceMotion)this.game.shake(1.2);}\n        if(e.type==='\"'chirp')this.game.particles.ring(x,y,3,75,'#b4f5e9',.7);\n        if(e.type==='clear'||e.type==='victory'){for(let i=0;i<16;i++)this.game.particles.glints((1+(i*7)%19+.5)*T,(1+(i*11)%15+.5)*T,0,3,['#ff