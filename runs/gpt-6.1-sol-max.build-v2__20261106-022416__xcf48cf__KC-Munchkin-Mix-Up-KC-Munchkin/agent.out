ata.q)||data.q<=this.lastPacket){this.diagnostics.rejected++;return;}\n        const before=this.world?this.world.players.concat(this.world.food,this.world.predators).map(a=>[a.id,a.m.x,a.m.y]):[];\n        const w=M.unpack(data,this.world);if(!w){this.diagnostics.rejected++;return;}this.lastPacket=data.q;this.world=w;this.renderFrom=new Map(before.map(a=>[a[0],[a[1],a[2]]]));this.renderAt=performance.now();this.app.world=w;this.app.sound.events(w.events);this.diagnostics.lastTick=w.tick;\n      }\n    }\n    intent(){\n      if(!this.app||AIHub.server||!this.players.includes(AIHub.me)||this.ended)return {d:-1,a:false};\n      if(!this.started||AIHub.time()<0||this.app.ui?.screen||this.app.game.paused)return {d:-1,a:false};return this.app.localIntent(0);\n    }\n    pump(){\n      if(this.ended||!this.app)return;const now=performance.now(),dt=Math.min(.25,(now-this.lastClock)/1000);this.lastClock=now;\n      const live=this.started&&AIHub.time()>=0;\n      const intent=this.intent(),text=intent.d+'\"':'+Number(intent.a);\n      if(AIHub.isHost){\n        if(this.players.includes(AIHub.me)&&\"'!AIHub.server)this.received.set(AIHub.me,{q:++this.inputSeq,...intent,time:now});\n        if(live&&!this.finished){this.acc+=dt;let count=0;while(this.acc>=1/120&&count++<60){for(const p of this.world.players){const input=this.received.get(p.id);this.world.setIntent(p.id,input&&now-input.time<650?input:{d:-1,a:false});if(input)input.a=false;}this.world.step();this.app.sound.events(this.world.events);this.app.consumeEvents(this.world.events);this.acc-=1/120;}if(this.world.phase==='\"'won'||this.world.phase==='lost')this.finish(this.world.phase==='won');}\n        if(now>=this.nextSnap&&\"'!this.finished){const repair=now>=this.nextReliable||this._rev!==this.world.revision||this._phase!==this.world.phase;this.send(M.pack(this.world,++this.sendSeq),{reliable:repair});this.nextSnap=now+100;if(repair)this.nextReliable=now+1000;this._rev=this.world.revision;this._phase=this.world.ph