{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"mv ../project.json project.json\npython3 - <<'PY'\nfrom pathlib import Path\nfor path in ['tools/build.mjs','tests/simulation.mjs']:\n p=Path(path);s=p.read_text().replace(\\\"'../project.json'\\\", \\\"'project.json'\\\");p.write_text(s)\nfor path in ['tests/browser.py','tests/hub.py','tests/touch.py']:\n p=Path(path);s=p.read_text().replace(\\\"(ROOT.parent/'project.json')\\\", \\\"(ROOT/'project.json')\\\").replace(\\\"(WORK/'project.json')\\\", \\\"(ROOT/'project.json')\\\").replace(\\\"(R.parent/'project.json')\\\", \\\"(R/'project.json')\\\");p.write_text(s)\np=Path('src/content/validate.js')\ns=p.read_text().replace(\\\"    if(data.w\"'!==21\", \"    if(typeof data.id!=='\"'string'||\"'!/''^[-a-z0-9]{1,40}$/.test(data.id)||typeof data.name!=='\"'string'||data.name.length<1||data.name.length>64||typeof data.subtitle\"'!=='\"'string'||data.subtitle.length>120||typeof data.hint\"'!=='\"'string'||\"'!data.hint.length||data.hint.length>240||typeof data.clear!=='\"'string'||\"'!data.clear.length||data.clear.length>120||!Number.isInteger(data.seed)||data.seed<0||data.seed>4294967295)return {ok:false,errors:[{message:'\"'Use a valid maze ID, name, hint, clear message and numeric seed.',cells:[]}]};\\\\n    if(data.w\"'!==21\")\ns=s.replace(\"data.food.some(f=>!f||\", \"data.food.some((f,i)=>!f||f.id!==`f${i}`||f.power!==(i>=8)||!Number.isInteger(f.dir)||f.dir<0||f.dir>3||\")\ns=s.replace(\"data.predators.some(p=>!p||\", \"data.predators.some(p=>!p||p.id!==({follower:'\"'needle',interceptor:'peek',keeper:'chonk'})[p.role]||\"'!Number.isInteger(p.x)||!Number.isInteger(p.y)||\")\ns=s.replace(\"p.release<2||\", \"p.release<2||p.release>30||\")\ns=s.replace(\"if(!data.reveal||!['\"'none','all','bands'].includes(data.reveal.kind))\\\", \\\"if(\"'!data.reveal||!['\"'none','all','bands'].includes(data.reveal.kind)||\"'!Number.isFinite(data.reveal.period)||data.reveal.period<3||data.reveal.period>30||!Number.isFinite(data.reveal.duration)||data.reveal.duration<.5||data.reveal.duration>5)\")\np.write_text(s)\np=Path('\"'tests/simulation.mjs')\ns=p.read_text().replace(\\\"test('storage corruption\\\", \\\"test('invalid imported metadata and actor identities are rejected',()=>{for(const edit of [d=>d.name={},d=>d.hint=null,d=>d.predators[0].id='food',d=>d.food.reverse(),d=>d.food[0].power=true,d=>d.reveal.period=0,d=>d.seed=-1]){const d=M.stage(0);edit(d);assert.equal(M.validate(d).ok,false);const e=new M.Editor(),before=e.export();assert.equal(e.import(JSON.stringify({format:'mix-up-maze',version:1,board:d})),false);assert.equal(e.export(),before);}});\\\\ntest('storage corruption\\\")\np.write_text(s)\nPY\ncat > biome.json <<'EOF'\n{\n  \\\"files\\\": {\\\"includes\\\":[\\\"src/**\\\",\\\"tools/*.mjs\\\",\\\"tests/*.mjs\\\",\\\"package.json\\\",\\\"project.json\\\"]},\n  \\\"formatter\\\":{\\\"indentStyle\\\":\\\"space\\\",\\\"indentWidth\\\":2,\\\"lineWidth\\\":100},\n  \\\"linter\\\":{\\\"enabled\\\":true,\\\"rules\\\":{\\\"recommended\\\":false}},\n  \\\"javascript\\\":{\\\"globals\\\":[\\\"My3D2dge\\\",\\\"AIHub\\\",\\\"Mix\\\"]}\n}\nEOF\nbiome check --write src tools/*.mjs tests/simulation.mjs package.json project.json\nnode tools/build.mjs\nnode tools/test.mjs --unit --smoke\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
