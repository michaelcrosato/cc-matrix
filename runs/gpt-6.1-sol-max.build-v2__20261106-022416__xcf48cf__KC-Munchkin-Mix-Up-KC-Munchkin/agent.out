{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/screens.js <<'EOF'\n(function(M){\n  'use strict';\n  const {E}=M;\n  class Screens {\n    constructor(app){\n      this.app=app;const g=app.game;\n      this.shell=new E.Shell(g,{tv:true,theme:{ink:'#f8efd9',paper:'rgba(31,23,43,.97)',accent:'#f5d695',muted:'#c2afcf',line:'rgba(196,165,226,.25)',font:'Trebuchet MS, system-ui, sans-serif',titleFont:'Trebuchet MS, system-ui, sans-serif'},\n        screens:{pause:{kicker:()=>app.net.active?'LOCAL MENU / TEAM PLAY CONTINUES':app.screen==='editor'?'MAZE WORKSHOP':'TAKE A BREATHER',text:()=>app.net.active?'Your team keeps munching while this menu is open.':''},help:{title:'How to munch',text:'Meet your moving lunch at a junction. Star snacks turn hungry predators into a five / ten / twenty point feast.'}}});\n      app.ui=this.shell;\n      for(const [key,label,min,max,step,unit] of M.TUNING)g.settings.define({key:'dev_'+key,group:'Tuning',label,value:M.DEFAULTS[key],min,max,step,unit,apply:(_,value)=>{if(app.devOpen&&app.world&&\"'!app.net.active)app.world.setTuning(key,value);}});\n      g.settings.define({key:'\"'dev_stage',group:'Tuning',label:'Restart at stage',value:0,options:M.STAGES.map((_,i)=>[i,M.stage(i).name])});\n      g.settings.define({key:'dev_seed',group:'Tuning',label:'Restart seed',value:4242,min:1,max:999999,step:1});\n      this.devPage=0;this.aboutPage=0;\n    }\n    show(name,spec){this.shell.show(name,spec);this.app.markActivity();}\n    close(){this.shell.hide();this.app.game.input.consumeAll();this.app.clearIntents();}\n    title(){const a=this.app,g=a.game;\n      this.show('title',{kicker:'A LITTLE ELECTRONIC MISCHIEF',name:'K.C. MUNCHKIN\\\\nMIX-UP',subtitle:'Your lunch has other plans.',\n        actions:[['Play solo',()=>a.startRun({seats:[0]})],['Play together',()=>this.coop()],['Remix a maze',()=>this.remix()],['Maze workshop',()=>a.openEditor()],['How to play',()=>this.help(