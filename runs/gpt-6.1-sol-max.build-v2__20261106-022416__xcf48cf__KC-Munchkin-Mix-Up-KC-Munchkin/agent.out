{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/main.js')\ns=p.read_text()\ns=s.replace(\\\"    setupDOM(){\\\", \\\"    bindButton(button,action){let skipClickUntil=0;button.onclick=()=>{if(performance.now()>skipClickUntil)action();};button.onpointerdown=e=>{if(e.pointerType==='touch'){e.preventDefault();skipClickUntil=performance.now()+600;action();}};}\\\\n    setupDOM(){\\\")\ns=s.replace(\\\"this.menuButton.onclick=menu;this.menuButton.onpointerdown=e=>{if(e.pointerType==='touch'){e.preventDefault();menu();}};\\\", \\\"this.bindButton(this.menuButton,menu);\\\")\ns=s.replace(\\\"this.chirpButton.onclick=chirp;this.chirpButton.onpointerdown=e=>{if(e.pointerType==='touch'){e.preventDefault();chirp();}};\\\", \\\"this.bindButton(this.chirpButton,chirp);\\\")\ns=s.replace(\\\"this.workshopButton.onclick=workshop;this.workshopButton.onpointerdown=e=>{if(e.pointerType==='touch'){e.preventDefault();workshop();}};\\\", \\\"this.bindButton(this.workshopButton,workshop);\\\")\ns=s.replace(\\\"button.onclick=action;button.onpointerdown=e=>{if(e.pointerType==='touch'){e.preventDefault();action();}};\\\", \\\"this.bindButton(button,action);\\\")\ns=s.replace(\\\"this.world.players[0]?.chirp<=0\\\", \\\"this.world.players.find(p=>p.id===(this.net.active?AIHub.me:0))?.chirp<=0\\\")\ns=s.replace(\\\"Math.ceil(w.players[0]?.chirp||0)\\\", \\\"Math.ceil(w.players.find(p=>p.id===(this.net.active?AIHub.me:0))?.chirp||0)\\\")\np.write_text(s)\np=Path('tests/hub.py')\ns=p.read_text().replace('import threading','import threading\\\\nimport sys')\ns=s.replace(\\\"scenarios=[(1,'standard'\\\", \\\"scenarios=[] if '--live-only' in sys.argv else [(1,'standard'\\\")\ns=s.replace(\\\"const input=bot.intent(host.mix.world,hero);['up','right','down','left']\\\", \\\"let input;if(hero.m.moving){const to=hero.m._to,edge=host.mix.world.revision+':'+hero.m.cx+','+hero.m.cy+'>'+to.join(',')