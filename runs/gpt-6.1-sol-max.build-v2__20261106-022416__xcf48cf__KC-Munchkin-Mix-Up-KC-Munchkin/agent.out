; null when\n   *  the keys zoomed (about the screen's middle) */\n  zoomPoint() { return this._zoomPt; }\n  /** a pointer event in screen pixels, as the browser's would give: feed('down' | 'move' | 'up', x, y, { touch: false,\n   *  button: 0, id: 0 (which finger, for zones) }) (a test's or a bot's mouse and fingers: clicks, boxes, long presses,\n   *  double taps and pans follow; a finger in one of the zones holds its act), or\n   *  feed('zoom', x, y, { k: 1.1 }): a wheel's notch or a pinch about that point */\n  feed(type, x, y, o = {}) {\n    if (type === 'zoom') { this._zoomAcc *= o.k || 1.1; this._zoomPt = [x, y]; return; }\n    if (!o.touch) this._fedAt = [x, y];\n    const S = this.screen, z = o.touch && type === 'down' && this.zones && this._zone(x / S.W, y / S.H);\n    if (z) { this._zoneDown('fed' + (o.id || 0), z); return; }   // (a finger in a zone: its act, no gesture)\n    if (o.touch && type === 'up' && this._zoneOf.has('fed' + (o.id || 0))) { this._zoneUp('fed' + (o.id || 0)); return; }\n    if (type === 'down') { this._fed = [x, y]; if (!o.touch) this.press('Mouse' + (o.button || 0)); this._gesture('down', x, y, { touch: !!o.touch, button: o.button || 0, id: 'fed' }); }\n    else if (type === 'move') { if (!o.touch) { this.mouse.t = this.clock; this.mouse.active = true; } this._gesture('move', x, y); }   // (menus hover by mouse.t, as a real move)\n    else if (type === 'up') {\n      if (this._fed && Math.hypot(x - this._fed[0], y - this._fed[1]) < 4 && !(o.button > 0)) this._click = [x, y];\n      if (!o.touch) this.release('Mouse' + (o.button || 0)); this._fed = null; this._gesture('up', x, y);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n.esh-nav.x{right:calc(8px + env(safe-area-inset-right,0px))}.esh-nav.bk{left:calc(8px + env(safe-area-inset-left,0px))}.esh-sw{transition:transform .2s,opacity .2s}\n.esh-mod{width:min(460px,100%);max-height:100%;overflow:auto;padding:22px 24px}.esh-wide{width:min(760px,100%)}\n.esh-ttl{place-items:center start;background:linear-gradient(90deg,#04060aee,#04060a99 50%,#04060a00 85%)}.esh-ttl>div{max-width:min(520px,92vw);padding-left:4vw}\n.esh-ttl h1{font-size:clamp(44px,10vw,92px);letter-spacing:.07em}.esh-sub{font:italic 20px var(--title);color:var(--accent);margin-top:6px}\n.esh-btns{display:flex;flex-direction:column;gap:8px;margin-top:18px}.esh-tags{display:flex;gap:10px;margin-top:18px;font-size:11px;letter-spacing:.16em;color:var(--muted)}\n.esh button{font:600 13px var(--font);letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:#ffffff0f;border:1px solid #ffffff2c;border-radius:4px;padding:10px 14px;text-align:left;cursor:pointer}\n.esh button.pri{background:var(--accent);border-color:var(--accent);color:#16130e}.esh button:disabled{opacity:.4;cursor:default}\n.esh button:focus-visible,.esh input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.esh-row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:7px 0;border-bottom:1px solid var(--line)}.esh-row button{min-width:64px;text-align:center}\n.esh input[type=range]{accent-color:var(--accent);width:140px}.esh-grid{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin-top:12px;align-items:center}\n.esh-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:10px;margin:16px 0 8px}.esh-stats b{display:block;font:600 24px var(--title)}\n.esh-stats small{color:var(--muted);font-size:10px;letter-spacing:.14em}.esh-med{display:inline-block;margin:6px 6px 0 0;padding:3px 9px;border-radius:12px;border:1px solid var(--accent);font-size:12px}.esh-med.off{opacity:.35;border-color:var(--muted)}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui/screens.js <<'EOF'\n(function(M){\n  'use strict';\n  const {E}=M;\n  class Screens {\n    constructor(app){\n      this.app=app;const g=app.game;\n      this.shell=new E.Shell(g,{tv:true,theme:{ink:'#f8efd9',paper:'rgba(31,23,43,.97)',accent:'#f5d695',muted:'#c2afcf',line:'rgba(196,165,226,.25)',font:'Trebuchet MS, system-ui, sans-serif',titleFont:'Trebuchet MS, system-ui, sans-serif'},\n        screens:{pause:{kicker:()=>app.net.active?'LOCAL MENU / TEAM PLAY CONTINUES':app.screen==='editor'?'MAZE WORKSHOP':'TAKE A BREATHER',text:()=>app.net.active?'Your team keeps munching while this menu is open.':''},help:{title:'How to munch',text:'Meet your moving lunch at a junction. Star snacks turn hungry predators into a five / ten / twenty point feast.'}}});\n      app.ui=this.shell;\n      for(const [key,label,min,max,step,unit] of M.TUNING)g.settings.define({key:'dev_'+key,group:'Tuning',label,value:M.DEFAULTS[key],min,max,step,unit,apply:(_,value)=>{if(app.devOpen&&app.world&&\"'!app.net.active)app.world.setTuning(key,value);}});\n      g.settings.define({key:'\"'dev_stage',group:'Tuning',label:'Restart at stage',value:0,options:M.STAGES.map((_,i)=>[i,M.stage(i).name])});\n      g.settings.define({key:'dev_seed',group:'Tuning',label:'Restart seed',value:4242,min:1,max:999999,step:1});\n      this.devPage=0;this.aboutPage=0;\n    }\n    show(name,spec){this.shell.show(name,spec);this.app.markActivity();}\n    close(){this.shell.hide();this.app.game.input.consumeAll();this.app.clearIntents();}\n    title(){const a=this.app,g=a.game;\n      this.show('title',{kicker:'A LITTLE ELECTRONIC MISCHIEF',name:'K.C. MUNCHKIN\\\\nMIX-UP',subtitle:'Your lunch has other plans.',\n        actions:[['Play solo',()=>a.startRun({seats:[0]})],['Play together',()=>this.coop()],['Remix a maze',()=>this.remix()],['Maze workshop',()=>a.openEditor()],['How to play',()=>this.help(0)],['Settings & credits',()=>this.more()]],\n        meta:['12 RUNAWAYS','3 HUNGRY RIVALS','1–2 PLAYERS'],footer:()=>\"'`${g.input.label('\"'confirm')} choose  ·  \"'${g.input.label('\"'up')} / \"'${g.input.label('\"'down')} browse  ·  Best \"'${a.profile.data.best}`,\n        back:()=>{}});\n    }\n    more(){this.show('\"'more',{kicker:'THE CABINET',title:'Make yourself at home',actions:[['Settings',()=>this.app.game.menu('settings')],['Controls & rebinding',()=>this.app.game.menu('controls')],['About & credits',()=>this.about(0)],['Back',()=>this.shell.back()]]});}\n    coop(){const a=this.app;let pads=[];try{pads=Array.from(navigator.getGamepads()).filter(p=>p?.connected\"'!==false&&p?.mapping==='\"'standard');}catch{}\n      this.show('coop',{kicker:'SHARED LUNCH / SHARED LIVES',title:'Two grins are better',text:'Choose your seats. Heroes pass through each other. Every star snack helps both of you.',\n        sections:[['Keyboard duo','P1: WASD + F. P2: arrows + period. Five lives and one team score.'],['Across devices','Launch this game from AI Hub for shared-world co-op. Hub supplies the connection and round clock.']],\n        actions:[['Two on one keyboard',()=>a.startRun({seats:[0,1],devices:'keys'})],{label:'Keyboard + controller',disabled:pads.length<1,fn:()=>a.startRun({seats:[0,1],devices:'mixed',pads:[pads[0].index]})},{label:'Two controllers',disabled:pads.length<2,fn:()=>a.startRun({seats:[0,1],devices:'pads',pads:pads.slice(0,2).map(p=>p.index)})},['Refresh controllers',()=>{this.shell.back();this.coop();}],['Back',()=>this.shell.back()]]});\n    }\n    inputField(label,value,options={}){\n      if(\"'!this.shell.root)return null;const box=this.shell.root.querySelector('\"'.esh-sh>div'),wrap=document.createElement('label');wrap.className='mix-form';wrap.textContent=label;const field=document.createElement(options.area?'textarea':'input');if(\"'!options.area)field.type='\"'text';field.value=value;field.maxLength=options.max||40000;field.spellcheck=false;field.setAttribute('aria-label',label);if(options.readonly)field.readOnly=true;\n      for(const ev of ['keydown','keyup','pointerdown'])field.addEventListener(ev,e=>e.stopPropagation());wrap.appendChild(field);box.insertBefore(wrap,box.querySelector('.esh-btns'));return field;\n    }\n    remix(){const a=this.app;let seed='4242',vanish=false,tunnels=true;\n      const open=()=>{this.show('remix',{kicker:'A LITTLE LUCK IN EVERY LOOP',title:'Remix your lunch',text:'The same seed serves the same maze and opening routes. All twelve snacks and all three predators are here.',actions:[['Play this mix',()=>{seed=field.value.trim()||'4242';a.startRun({mode:'remix',seed,seats:[0],remixOptions:{vanish,tunnels}});}],['New seed',()=>{const arr=new Uint32Array(1);crypto.getRandomValues(arr);field.value=String(arr[0]%1000000);}],['Walls: '+(vanish?'disappearing':'visible'),()=>{seed=field.value;vanish=\"'!vanish;this.shell.back();open();}],['\"'Tunnels: '+(tunnels?'on':'off'),()=>{seed=field.value;tunnels=\"'!tunnels;this.shell.back();open();}],['\"'Back',()=>this.shell.back()]]});const field=this.inputField('Maze seed',seed,{max:24});};open();\n    }\n    help(page=0){\n      const a=this.app,g=a.game,pages=[\n        {title:'Lunch on the loose',sections:[['Meet it. Munch it.','Twelve little snacks run around each maze. Cut across a loop and meet them at a junction. The fewer left, the faster they scoot.'],['Bright bites back','Four star snacks make all three predators edible for six seconds. Catch them for 5, 10, then 20 points. Stripes warn you before power ends.'],['One shared appetite','Start with five team lives. A clear restores one. Catch the last snack to clear the board, even during a last-moment tangle.']]},\n        {title:'Tricks of the chew',sections:[['Take the side door','Striped tunnel mouths on the same row join together. Everyone can use them, so watch both ends.'],['Ride the rotating pen','One door turns to the next side after a light sweep. Step inside, w