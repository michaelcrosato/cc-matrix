s = s.views;\n    if (ok('input')) this.input.use(s.input);\n    if (ok('res') || ok('expand')) this.screen.setOptions(Object.assign(ok('res') ? { res: s.res } : {}, ok('expand') ? { expand: s.expand } : {}));\n    if (ok('touch')) this.input.touchButtons(s.touch);\n    ok('camera');\n    if (s.propSize !== undefined) { s._propWas = E.style.propSize; E.style.propSize = s.propSize; }   // scene option: prop scale while this scene runs\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > src/net/session.js <<'EOF'\n(function(M){\n  'use strict';\n  const PHASES=['intro','playing','clear','won','lost'],EVENTS=['stage','go','bite','power','catch','hit','respawn','chirp','gate-warn','gate-turn','warning','power-end','clear','victory','failure','tunnel','recharge','bump','leave'];\n  const round=v=>Math.round(v*1000)/1000;\n  M.pack = (w,q) => ({k:'s',q,r:w.revision,s:w.stageIndex,z:w.seed,t:w.tick,c:[PHASES.indexOf(w.phase),round(w.phaseT),w.score,w.lives,round(w.power),w.chain,w.board.orientation,round(w.gateTime),round(w.reveal),round(w.elapsed)],\n    mask:w.food.reduce((v,f,i)=>v|(f.alive?1<<i:0),0),\n    p:w.players.map(p=>[p.id,round(p.m.x),round(p.m.y),p.m.d,round(p.inv),round(p.hit),round(p.chirp),round(p.bite),round(p.chirpFx),p.seat]),\n    f:w.food.map(f=>[round(f.m.x),round(f.m.y),f.m.d,round(f.turn)]),\n    e:w.predators.map(e=>[round(e.m.x),round(e.m.y),e.m.d,M.ACTOR_STATES.indexOf(e.state),round(Math.max(0,e.wait))]),\n    ev:w.eventLog.slice(-5).map(e=>[e.id,EVENTS.indexOf(e.type),e.player??-1,round(e.x||0),round(e.y||0),e.food?Number(e.food.slice(1)):-1,e.points||0])});\n  M.unpack = (packet,prior=null) => {\n    if(\"'!packet||packet.k!=='\"'s'||\"'!Number.isInteger(packet.r)||!Number.isInteger(packet.q)||!Number.isInteger(packet.t)||packet.s<0||packet.s>5||!Array.isArray(packet.p)||packet.p.length>2||!Array.isArray(packet.f)||packet.f.length!==12||!Array.isArray(packet.e)||packet.e.length!==3||!Array.isArray(packet.c)||packet.c.length!==10)return null;\n    if(prior&&(packet.r<prior.revision||packet.r===prior.revision&&packet.t<prior.tick))return null;\n    // Host messages are still checked for finite coordinates and valid state indexes before touching presentation.\n    if([...packet.p,...packet.f,...packet.e,packet.c].some(a=>!Array.isArray(a)||a.some(v=>typeof v!=='\"'number'||\"'!Number.isFinite(v)))||packet.c[0]<0||packet.c[0]>=PHASES.length)return null;\n    let w=prior;\n    if(!w||w.revision!==packet.r||w.stageIndex!==packet.s){w=new M.World({seed:packet.z,seats:packet.p.map(p=>p[0]),stage:packet.s});w.revision=packet.r;}\n    w.tick=packet.t;w.time=packet.t/120;w.phase=PHASES[packet.c[0]];w.phaseT=packet.c[1];w.score=packet.c[2];w.lives=packet.c[3];w.power=packet.c[4];w.chain=packet.c[5];w.board.setOrientation(packet.c[6]);w.gateTime=packet.c[7];w.reveal=packet.c[8];w.elapsed=packet.c[9];w.gateWarn=w.gateTime>w.tuning.gateCadence-.5;\n    const motion=(a,x,y,d)=>{a.m.x=x;a.m.y=y;a.m.cx=Math.round(x);a.m.cy=Math.round(y);a.m.d=d;a.m.dir=M.DIRS[d]||[0,0];a.m.moving=Math.abs(x-Math.round(x))+Math.abs(y-Math.round(y))>.005;a.m._to=[Math.round(x)+(M.DIRS[d]?.[0]||0),Math.round(y)+(M.DIRS[d]?.[1]||0)];};\n    const former=new Map(w.players.map(p=>[p.id,p]));w.players=packet.p.map(a=>{const p=former.get(a[0])||{id:a[0],seat:a[9],m:new M.GraphMover(1,15,6),spawn:w.data.spawns[a[9]%2]};motion(p,a[1],a[2],a[3]);[p.inv,p.hit,p.chirp,p.bite,p.chirpFx]=a.slice(4,9);return p;});w.seats=w.players.map(p=>p.id);\n    packet.f.forEach((a,i)=>{motion(w.food[i],a[0],a[1],a[2]);w.food[i].alive=!!(packet.mask&(1<<i));w.food[i].turn=a[3];});\n    packet.e.forEach((a,i)=>{motion(w.predators[i],a[0],a[1],a[2]);w.predators[i].state=M.ACTOR_STATES[a[3]]||'\"'penned';w.predators[i].wait=a[4];});\n    w.events=(packet.ev||[]).filter(a=>Array.isArray(a)&&EVENTS[a[1]]).map(a=>({id:a[0],type:EVENTS[a[1]],player:a[2],x:a[3],y:a[4],food:a[5]>=0?'f'+a[5]:undefined,points:a[6]}));w.eventLog=w.events.slice();return w;\n  };\n  class Session {\n    constructor(){\n      this.active=\"'!!globalThis.AIHub?.active;this.app=null;this.world=null;this.started=false;this.ended=false;this.finished=false;this.players=[];this.received=new Map();this.lastPacket=0;this.sendSeq=0;this.inputSeq=0;this.nextSnap=0;this.nextReliable=0;this.nextInput=0;this.lastInput='\"'';this.lastClock=0;this.acc=0;this.timer=null;this.pendingTimeUp=