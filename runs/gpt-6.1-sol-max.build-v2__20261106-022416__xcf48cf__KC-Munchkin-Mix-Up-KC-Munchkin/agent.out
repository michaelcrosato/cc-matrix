{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"rg -n 'groundDisc\\\\(|groundRing\\\\(|textAt\\\\(|setZoom\\\\(|\"'^const My3D2dge|''^var My3D2dge'\"' vendor/engine/dist/handoff/my-3d2dge.js | head -24 && sed -n '2540,2567p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '1034,1068p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '1,28p' vendor/hub/lib/hub/harness.html && head -18 vendor/hub/lib/hub/bridge.js\"","aggregated_output":"1621:          else r.decal(g => r.groundRing(p.x, p.y, lerp(p.r0, p.r1, ease.outQuad(u)), p.color, 1 - u, p.z), { emissive: .8 * (1 - u) }); break;\n1790:  groundDisc(x, y, rad, color, alpha = 1, z = 0) { px.polyDither(this.tgt, this.groundPts(x, y, rad, 18, z), color, alpha, this.ix, this.iy); }\n1792:  groundRing(x, y, rad, color, alpha = 1, z = 0) {\n1947:  /** text floating at a world point (names, prompts): r.textAt(x, y, z, 'OPEN', '#ffe08a') */\n1948:  textAt(x, y, z, str, color = '#ffffff', o = {}) { this.overlay(g => { const [sx, sy] = this.w(x, y, z); E.font.text(g, str, sx, sy, color, Object.assign({ align: 'center' }, o)); }); }\n2460:   * camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom\n2464:  setZoom(z) { this._zoomBase = clamp(+z || 1, .5, 3); this._zoomApply(true); }\n3710:        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\n   * open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without\n   * scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or\n   * menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play.\n   * o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when\n   * a menu opened\n   */\n  menu(name, o) {\n    const sh = this.shell, s = this.scene, play = !!s && (!!s.pausable || this.sceneName === 'main');\n    if (o && o.pause === false && !this.paused) this._goOn = true;   // (until it resumes)\n    if (!sh || !sh._menu()) { if (play) this.pause('player'); return false; }\n    if (!name && play) { this.pause('player'); return true; }\n    if (this.pause('menu')) sh._ownPause = true;\n    sh.show(name || 'settings'); return true;\n  }\n  /** the standard features in a page (section 10b): the page set up for phones, pausing when it is hidden, the player's\n   *  full-screen choice kept, a phone's first tap going full screen, the corner buttons and the menu screens */\n  _standard(signal) {\n    const on = (t, type, fn, o) => t.addEventListener(type, fn, Object.assign({ signal }, o)), fs = this.fullscreen;\n    pageSetup(this.screen.canvas);\n    on(window, 'blur', () => this._autoPause('focus'));\n    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its sound\n    on(window, 'pagehide', () => this._autoPause('focus'));\n    // held keys let go as the screen changes; a finger on the glass goes on, and a tap that has landed (the one that went full screen) counts\n    const fsChange = () => { this.input._refit(); if (this.shell && this.shell.screen) this.shell._render(); };   // (the player's choice is what they asked for: fullscreen.toggle() keeps it)\n    on(document, 'fullscreenchange', fsChange); on(document, 'webkitfullscreenchange', fsChange);\n    on(window, 'pointerup', e => {   // (a browser goes full screen only from a tap: this one, or a game started by it)\n      if (e.pointerType === 'mouse') return;\n      if (!this._fsAuto && !(e.target && e.target.closest && e.target.closest('[data-sys=\"corner\"]'))) this._fsAuto = this._autoFull();   // once until a game starts: the player who leaves it mid-game stays out\n  _tapCode(c) { this.press(c); this._taps.add(c); }\n  /** hold an action down (on) or let it go (false), as its key would */\n  hold(a, on = true) {\n    if (!this.map[a]) { this._check(a); return; }\n    const c = 'Act:' + a, d = this.lastDevice; if (on) { this._holds.add(c); this.press(c); } else { this._holds.delete(c); this.release(c); }\n    this.lastDevice = d;   // (no device either; and a tap of a held action leaves it held)\n  }\n  _check(a) { if (!this.map[a]) warn('action:' + a, 'unknown input action \"' + a + '\". Known actions: ' + Object.keys(this.map).join(', ') + '. Add your own with new E.Game({ input: { ...E.Input.DEFAULT, ' + a + \": ['KeyQ'] } })\"); }\n  /** is the action held right now? */\n  down(a) { const m = this.map[a]; if (!m) { this._check(a); return false; } if (this._suppressed.has(a)) return false; for (const c of m) if (this.held.has(c)) return true; return false; }\n  /** true only during the first update step after the press (menus, jumps, one-shot actions) */\n  pressed(a) { if (!this.map[a]) this._check(a); return !this._suppressed.has(a) && this._now.has(a); }\n  /** true only during the first update step after the action was let go */\n  released(a) { return this._nowUp.has(a); }\n  /** pressed, then repeats while held (after `delay` s, every `rate` s): menu cursors, puzzle pieces */\n  repeat(a, delay = .3, rate = .08) {\n    if (this.pressed(a)) return true;\n    if (!this.down(a) || this._pt[a] === undefined) return false;\n    const t = this.clock - this._pt[a]; if (t < delay) return false;\n    const k = Math.floor((t - delay) / rate); if (k !== this._rk[a]) { this._rk[a] = k; return true; }\n    return false;\n  }\n  /** was it pressed within the last `win` seconds and not yet consumed? (input buffering) */\n  buffered(a, win = .15) { if (!this.map[a]) this._check(a); const t = this._pt[a]; return !this._suppressed.has(a) && t !== undefined && !this._used[a] && this.clock - t <= win; }\n  /** mark a buffered press of action a as used, so buffered(a) is false until the next press */\n  consume(a) { this._used[a] = true; }\n  /** Suppress a held action until the next tick (a HUD widget owns the pointer this step). */\n  suppress(a) { this.consume(a); this._suppressed.add(a); }\n  /** A widget owns this button; other devices bound to the same action still work. */\n  suppressCode(code) {\n    for (const a of this._codes[code] || []) if (!this.map[a].some(c => c !== code && this.held.has(c))) this.suppress(a);\n  }\n  /** forget every pending press (after closing a menu or dialog, so the same press does not also attack) */\n  consumeAll() { for (const a in this.map) this._used[a] = true; this._now.clear(); this._fresh.clear(); this._freshCodes.clear(); this._clickAt = this._click = null; }\n  /** the page went full screen or back: the keys and mouse buttons let go (one held through the change may never come up),\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n/**\n * bridge.js — the hub's end of one game frame in a session.\n *\n * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n * The bridge checks every message, enforces the limits, and routes it: control\n * messages (hello, ready, result, finish, error) to whoever coordinates the\n * round (lib/hub/round.js), game traffic straight to the other players, and a\n * game's answers on its own card to the page that holds it. What\n * comes back from the network is checked again before it reaches the game,\n * and anything from another round is dropped, so a slow packet can never land\n * in the next game.\n *\n * The network is anything with `send(toKey, envelope, {reliable})`: the\n * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n * WebRTC mesh. Envelopes:\n *   {k:'c', r, m}       to the coordinator: a message from this game\n *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n *   {k:'g', r, f, d}    game traffic from player id f\n","exit_code":0,"status":"completed"}}
