e, kind = null;\n    if (typeof fade === 'string') {\n      kind = fade; fade = o.seconds === undefined ? .4 : +o.seconds || 0;\n      if (kind !== 'black' && kind !== 'white' && !FADES[kind]) warn('fade:' + kind, 'game.go: no transition \"' + kind + '\" here (black, white, wipe, iris, mosaic, swirl, dissolve; a kit may leave them out: the full engine has them): a fade through black');\n    }\n    if (fade > 0 && this.scene) this._fade = { t: 0, dur: fade, name, data, out: true, kind, at: o.at };\n    else { this._fade = null; this._next = { name, data }; }\n  }\n  _fadeStep(dt) {\n    const f = this._fade; f.t += dt;\n    if (f.out && f.t >= f.dur) { f.out = false; f.t = 0; this._enter(f.name, f.data); }\n    else if (!f.out && f.t >= f.dur) this._fade = null;\n  }\n  _fadeLevel() { const f = this._fade; return f ? clamp(f.out ? f.t / f.dur : 1 - f.t / f.dur, 0, 1) : 0; }\n  _enter(name, data) {\n    const s = this.scenes[name];\n    if (!s) throw new Error('scene \"' + name + '\" does not exist. Scenes: ' + Object.keys(this.scenes).join(', '));\n    const old = this.scene;\n2881:  go(name, data, o = {}) {\n10978:  go(id, at, now) {\n  cell.el.classList.add('is-out');\n  if (tellRound) {\n    log(`${cell.key} left`);\n    current?.coordinator.leave(cell.key, 'left');\n  }\n}\n\nfunction renderWho(state) {\n  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n}\n\nfunction render(state) {\n  const s = state.status;\n  if (!s) return;\n  for (const cell of state.cells) {\n    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n    if (!p) continue;\n    const bits = [];\n","exit_code":0,"status":"completed"}}
