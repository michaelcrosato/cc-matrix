 omitted end of long line]\n3826:    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n9519:    for (const t of ['pointerup', 'pointercancel']) sh.addEventListener(t, end);\n10412:  const KIND = { keydown: 'key', keyup: 'key', pointerdown: 'pointer', pointermove: 'pointer', pointerup: 'pointer', pointercancel: 'pointer', wheel: 'wheel',\n10414:    fullscreenchange: 'fullscreen', webkitfullscreenchange: 'fullscreen', gotpointercapture: 'capture', lostpointercapture: 'capture', blur: 'plain', focus: 'plain', cancel: 'plain' };\n    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its sound\n    on(window, 'pagehide', () => this._autoPause('focus'));\n    // held keys let go as the screen changes; a finger on the glass goes on, and a tap that has landed (the one that went full screen) counts\n    const fsChange = () => { this.input._refit(); if (this.shell && this.shell.screen) this.shell._render(); };   // (the player's choice is what they asked for: fullscreen.toggle() keeps it)\n    on(document, 'fullscreenchange', fsChange); on(document, 'webkitfullscreenchange', fsChange);\n    on(window, 'pointerup', e => {   // (a browser goes full screen only from a tap: this one, or a game started by it)\n      if (e.pointerType === 'mouse') return;\n      if (!this._fsAuto && !(e.target && e.target.closest && e.target.closest('[data-sys=\"corner\"]'))) this._fsAuto = this._autoFull();   // once until a game starts: the player who leaves it mid-game stays out\n      if (!this._guard && this.o.backGesture !== false && this._canBack() && window.top === window && history.pushState) try { history.pushState({ e3: 'back' }, ''); this._guard = true; } catch (err) { /* a sandboxed page */ }\n    }, { capture: true });\n    // the phone's back gesture (and the browser's back button, after a tap)