= (b.y - a.y) / d, pa = (a.x - a.x0) * ux + (a.y - a.y0) * uy, pb = (b.x - b.x0) * ux + (b.y - b.y0) * uy;\n      if (Math.abs(pa) < 4 || Math.abs(pb) < 4 || pa * pb >= 0 || Math.abs(d - Math.hypot(b.x0 - a.x0, b.y0 - a.y0)) < 16) return;\n      this._pinching = true; this._pinchD = d; this._down = null; this._g = this._gBox = null;\n      if (this.stickOn && this._fingers.has(this.stickId)) this._stickEnd({ pointerId: this.stickId });\n      return;\n    }\n    this._zoomAcc *= d / this._pinchD; this._pinchD = d; this._zoomPt = this.screenPoint((a.x + b.x) / 2, (a.y + b.y) / 2);\n  }\n  _stickStart(e) {\n    if (!this.touchEnabled || this.stickOn) return;\n    const rc = this.screen.canvas.getBoundingClientRect();\n    if (this.steer !== 'drag' && (this.stickSide === 'right' ? e.clientX - rc.left < rc.width * .5 : e.clientX - rc.left > rc.width * .5)) return;   // dragging: anywhere\n    this.screen.canvas.setPointerCapture(e.pointerId); this.aimSource = 'move'; this.lastDevice = 'touch';\n    /** stickId: the pointer (finger) holding the touch stick */\n    this.stickId = e.pointerId; this.stickOn = true; this._stickO = [e.clientX, e.clientY]; this.stick = [0, 0]; this._dragAt = [e.clientX, e.clientY];\n    if (!this._stickEl) {\n      const mkEl = (s, css) => { const d = document.createElement('div'); d.style.cssText = 'position:absolute;pointer-events:none;border-radius:50%;z-index:3;' + css; d.style.width = d.style.height = s + 'px'; this.screen.canvas.parentElement.appendChild(d); return d; };\n      this._stickEl = mkEl(96, 'border:2px solid rgba(255,255,255,.35);background:rgba(255,255,255,.06)');\n2745:      this._raf = requestAnimationFrame(frame);   // scheduled first, so an error never stops the loop\n2758:      this.audio._frame(now);   // (the music clock between steps, and the sound held to it)\n2761:        try { this._frame(); } catch (e) { this.fail('draw', e); try { this.screen._present(); } catch (e2) { /* nothing to show */ } }\n2783:    this._raf = requestAnimationFrame(frame);\n2806:        if (r && typeof r.then === 'function') { r.then(() => { ok(); live ? requestAnimationFrame(next) : next(); }, e => fail(label, e)); return; }\n2807:        ok(); if (live) { requestAnimationFrame(next); return; }   // one step a frame: the screen shows each\n2809:      if (live && o.min && now() - t0 < o.min * 1000) { requestAnimationFrame(next); return; }\n2837:   * run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and\n2846:    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n2992:  _frame() {\n8009:  _frame(perf) {\n10403:  if (typeof window === 'undefined' || typeof requestAnimationFrame !== 'function') return S;\n","exit_code":0,"status":"completed"}}
