hite-space:pre-line;color:#ffedba;text-shadow:0 3px 0 #6e3e78;margin:12px 0}.esh.mix-ui .esh-ttl .esh-k{font-size:8px;letter-spacing:.19em;color:#a7e7da}.esh.mix-ui .esh-sub{font:italic 13px/1.3 'Trebuchet MS',sans-serif;color:#c8b5d8}.esh.mix-ui .esh-ttl .esh-btns{gap:5px;margin-top:18px;max-width:220px}.esh.mix-ui button{border-radius:8px;letter-spacing:.03em;padding:9px 12px;font-size:12px;border-color:#8a6aa955;background:#3d2d4d99;transition:background .12s,transform .12s}.esh.mix-ui button:hover{border-color:#ceabe9;background:#644c7677}.esh.mix-ui button.pri{background:#f5d695;border-color:#fff0b7;color:#35213e;box-shadow:0 3px 0 #b88f5c}.esh.mix-ui button:focus-visible{outline:2px solid #a0eddf;outline-offset:3px}.esh.mix-ui .esh-tags{font-size:7px;gap:9px;letter-spacing:.11em;white-space:nowrap}.esh.mix-ui .esh-ttl .esh-m{font-size:9px;margin-top:12px}.esh.mix-ui .esh-mod{border-radius:12px;border:1px solid #a684c166;box-shadow:0 12px 42px #0007;max-width:470px;padding:20px 24px;font-size:13px;line-height:1.5}.esh.mix-ui h2{font-size:26px;line-height:1.13;letter-spacing:-.02em;color:#ffe7b1;margin:6px 0 15px}.esh.mix-ui .esh-m{white-space:pre-line;color:#d0bfdb;font-size:12px;line-height:1.5}.esh.mix-ui .esh-k{font-size:9px;color:#98dfd1;letter-spacing:.14em}.esh.mix-ui .esh-sec{margin-top:14px}.esh.mix-ui .esh-row{padding:9px 0;font-size:12px}.esh.mix-ui .esh-row small{font-size:10px}.esh.mix-ui .esh-stats b{color:#f5d695}.esh.mix-ui .esh-emb{color:#a4e6d7;font-size:40px}.esh.mix-ui .esh-nav{border-radius:30px}.esh.mix-ui .esh-toast{max-width:300px;font-size:12px;border-radius:9px;background:#2a2037ee;border:1px solid #bda0d455;top:48px}.mix-form{display:flex;flex-direction:column;gap:7px;font-size:11px;letter-spacing:.04em;margin-top:12px;color:#b7d9d0}.mix-form input,.mix-form textarea{width:100%;border:1px solid #a487c877;border-radius:6px;background:#15101f;color:#fff0c9;padding:10px;font-size:14px;touch-action:auto}.mix-form textarea{height:130px;font:10px/1.5 ui-monospace,monospace;resize:vertical}.mix-hud{position:absolute;inset:0;pointer-events:none;font-size:clamp(14px,1.55vw,30px);line-height:1.25;padding:3.5vh 4.6vw 3vh;color:#f7e9cf}.mix-hud[hidden]{display:none}.mix-hud-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.mix-stage{font-weight:700;letter-spacing:.025em;color:#f4dba8}.mix-detail{font-size:.5em;letter-spacing:.13em;color:#a698b5;margin-top:.45em}.mix-counters{display:flex;gap:1.8em;text-align:right;margin-right:2.3em}.mix-counter span{display:block;font-size:.45em;letter-spacing:.18em;color:#b7a5ca}.mix-counter b{font-size:1.05em;font-weight:700;letter-spacing:.04em}.mix-counter:nth-child(2) b{font-size:.75em;color:#ec9daa;letter-spacing:.17em}.mix-counter:last-child b{color:#96e1d4}.mix-hud-bottom{position:absolute;left:4.6vw;right:4.6vw;bottom:2.9vh;display:flex;justify-content:space-between;align-items:center;gap:12px}.mix-prompt{font-size:.47em;letter-spacing:.06em;color:#bdb0cc}.mix-seed{font-size:.43em;letter-spacing:.13em;color:#b49ac9}.mix-hud.under-menu{opacity:.15}.mix-chirp,.mix-workshop-button{position:absolute;right:max(20px,env(safe-area-inset-right));bottom:max(22px,env(safe-area-inset-bottom));border:1px solid #b8cbbf66;border-radius:24px;padding:13px 22px;background:#262336db;color:#b2eddd;min-width:72px;min-height:44px;z-index:11;pointer-events:auto}.mix-chirp[hidden],.mix-workshop-button[hidden]{display:none}.mix-chirp:disabled{opacity:.45}.mix-workshop-button{font-size:clamp(13px,1vw,22px);bottom:6vh}.esh.mix-ui input[type=range]{accent-color:#a2e6d8}.esh.mix-ui .esh-btns:has(+ .esh-tags){margin-bottom:6px}#load-error{position:absolute;inset:20%;padding:30px;background:#2d2035;color:#ffe4bf;z-index:100;font-size:24px}body[data-ended=true] .mix-hud,body[data-ended=true] button{pointer-events:none;visibility:hidden}@media(max-aspect-ratio:4/5){.esh.mix-ui .esh-ttl{place-items:start center;background:linear-gradient(#15101ff5,#15101fe0 43%,#15101