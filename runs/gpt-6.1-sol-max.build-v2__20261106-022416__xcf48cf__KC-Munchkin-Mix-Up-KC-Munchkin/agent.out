{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"rg -n 'class GridMover|class Blob|class Shell|class Menu|class Arcade|class Input|class Settings|class Game|bus\\\\(name|musicVolume|voiceVolume' vendor/engine/dist/handoff/my-3d2dge.js && rg -n 'export|function check|scenario|__hubCheck' vendor/hub/lib/hub/harness.html | tail -35 && sed -n '1,190p' vendor/hub/lib/hub/examples/arena.html\"","aggregated_output":"754:class Input {\n2308:class Game {\n3054:  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n3087:class Settings {\n5038:class Blob {\n7742:     *  is none); volume: master volume 0..1; sfxVolume, musicVolume, voiceVolume: 0..1 for effects, music and the voice\n7744:    this._game = game; this._signal = signal; this.ctx = null; this.volume = .7; this.sfxVolume = 1; this.musicVolume = .5; this.voiceVolume = 1; this.muted = false;\n7777:  /** apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it) */\n7778:  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || [... omitted end of long line]\n7781:   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n7782:  bus(name = 'sfx') {\n9269:class Menu {\n9415:class Shell {\n10650:class Arcade {\n12462:class GridMover {\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Star Arena — AI Hub session example (shared world)</title>\n<meta name=\"description\" content=\"A minimal shared-world game for the AI Hub Session Protocol: every copy moves its own player, the host runs the stars and the scores, first to ten wins.\">\n<meta name=\"theme-color\" content=\"#1b1530\">\n<meta name=\"hub:type\" content=\"Tech demo\">\n<meta name=\"hub:players\" content=\"1\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"2-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-minutes\" content=\"2\">\n<meta name=\"hub:session-goal\" content=\"First to ten stars wins\">\n<meta name=\"hub:session-howto\" content=\"Move: arrows, WASD or a stick · sprint: Space or Cross · or hold a finger\">\n<style>\n  html, body { margin: 0; height: 100%; background: #1b1530; color: #f3eef7; font: 16px system-ui, sans-serif; overflow: hidden; }\n  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n</style>\n<script>\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n        return k in data || k in t;\n      },\n      deleteProperty: function (t, k) {\n        delete data[k];\n        return true;\n      },\n      ownKeys: function () {\n        return Object.keys(data);\n      },\n      getOwnPropertyDescriptor: function (t, k) {\n        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n      },\n    });\n  }\n\n  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n  function generator(a) {\n    return function () {\n      a = (a + 0x6d2b79f5) >>> 0;\n      var t = a;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  // A fair start: in a session the game gets an empty storage of its own, so\n  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n  // and nothing the round saves touches the player's own saves.\n  if (hub.active) {\n    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n      try {\n        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n      } catch (e) {\n        warn('could not give the game a fresh ' + stores[s]);\n      }\n    }\n  }\n\n  // Side by side: before any of the game's own scripts run, Math.random becomes\n  // a generator seeded by the hub, so every copy builds the same start.\n  var realRandom = Math.random;\n  var seededRandom = null;\n  if (hub.active && seedArg) {\n    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n    hub.seeded = true;\n  }\n\n  // In a session the hub owns fullscreen: a game that asks for it gets the\n  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n  // hub says when its page goes in and out, so the game's own toggle and its\n  // fullscreenchange listeners work as they always did.\n  var fullscreenOn = false;\n  if (hub.active && root.Element && root.document) {\n    var asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n    };\n    var proto = root.Element.prototype;\n    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n    var shown = function () {\n      return fullscreenOn ? root.document.documentElement || null : null;\n    };\n    try {\n      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n    } catch (e) {}\n  }\n\n  /**\n   * No hub after all: play on, with Math.random the page's own again. The\n   * empty storage stays: the game has read it already, and what it writes\n   * must never land on the player's real saves.\n   */\n  function standAlone() {\n    hub.active = false;\n    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n    hub.seeded = false;\n  }\n\n  var origin = '*';\n  var welcomed = false;\n  var ended = false;\n  var connecting = null;\n  var goAt = null;\n  var sentReady = false;\n  var reported = false;\n  var handlers = {};\n  var pending = {};\n  var tokens = limits.burst;\n  var refilled = now();\n","exit_code":0,"status":"completed"}}
