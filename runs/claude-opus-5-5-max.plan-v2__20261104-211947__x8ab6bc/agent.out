e:engine/my-3d2dge.js:3708-3786` (`ChipAudio`: the lazy context, resume on a gesture, the\n * buses and their levels, `sfx` with its per-sound rule, `music`), on pre-rendered buffers.\n *\n * @example\n * // browser: Web Audio plays only in a page (tests/e2e/examples.spec.ts runs it; tests/e2e/audio.spec.ts the rest)\n * const audio = createAudio({ footsteps: { iron: 'sfx:stomp', '*': 'sfx:step' } });\n * audio.music('song:dungeon', { intensity: 0 }); // starts on the first gesture\n * audio.bind('bossSeen', 'sfx:secret');\n * // each frame, after the render: audio.update(camera.pose, queryViewOf(world));\n * audio.event('hit', { sfx: 'sfx:hit', position: [2, 1, 5] });\n * @see tests/e2e/audio.spec.ts\n */\n\n=== engine/ui/menu.ts\n/**\n * @file The menu (PLAN.md §6.7, WP 10.6, I-50): a list with a cursor, for title screens, pause menus, settings and\n * shops, as HTML/CSS over the overlay. `createMenu(parent, items, { input, sound, title, place, onPick, onCancel,\n * onMove, send })` makes it open; `update(dt)` each frame reads the page's input and returns true when it picked or\n * cancelled.\n *\n * `uiUp` and `uiDown` (keys, the pad's D-pad and left stick; held, they repeat: engine/ui/widgets.ts `createRepeat`)\n * move the cursor over the items, round the ends, past disabled ones; `uiAccept` picks the item under it, `uiCancel`\n * calls `onCancel` when there is one; a pointer moving over an item moves the cursor there (a menu opening under a still\n * pointer, or rows shifting under it, moves none), a click picks it. A gamepad drives the menu with its buttons, and any\n * other panel through the pad's cursor (`createPadCursor`).\n *\n * Picks that change play: the system layer never enters the intents (engine/input/actionMaps.ts), so a menu never\n * reaches the sim itself. An item with an `id` is handed to `send(id)` when picked, which the page turns into input\n * the session records (a dev action, `__engine.actions.run`, or a custom intent for the next step), so the replay\n * holds the pick; `onPick` hears every pick, for what only the page changes (a look, a panel).\n *\n * Elements: `[data-ui=menu]` (`data-id`, `data-value` the cursor's index; `data-place`), its `[data-ui=menu-title]`,\n * and a `[data-ui=item]` per item (`data-id` its id or index, `data-value` `selected`, `disabled` or empty). Cues: `move`,\n * `pick`, `cancel`. Invariants: presentation only; `active: false` reads no input; the cursor never rests on a disabled\n * item while another is enabled. Carried from `my-3d2dge:engine/my-3d2dge.js:4288-4330` (`Menu`: items, disabled ones\n * skipped, onPick, onCancel, onMove) and shardfall's rule that menu actions reach the game as input (§5.8).\n *\n * @example\n * // browser: the menu needs a page\n * // const pause = createMenu(ui.root, ['Resume', { label: 'Restart', id: 'restart' }], {\n * //   input, title: 'Paused', onCancel: () => pause.remove(), send: (id) => engine.actions.run(id) });\n * // pause.update(dt); // each frame\n * @see engine/ui/menu.test.ts\n * @see tests/e2e/ui.spec.ts\n */\n\n=== engine/ui/widgets.ts\n/**\n * @file The overlay's widgets (PLAN.md §6.7, WP 10.6, I-50; doctrine: Verifiable without a display): bars, hearts and\n * boxes as HTML/CSS elements, each marked `data-ui` so `ui.state()` (engine/ui/state.ts) and DOM queries read it as\n * text, a value and a box, never as pixels; and what the dialog and the menu share (engine/ui/{dialog,menu}.ts).\n *\n * - `createBar(parent, { id, value, max, label, color })`: a filled bar (a health, magic or boss bar): `data-ui=bar`,\n *   `data-value` its fill from 0 to 1, its text the label and the value (`HP 30/40`).\n * - `createHearts(parent, { id, hp, max })`: a row of `max` hearts (rounded up), each full, half or empty by `hp`\n *   (halves count): `data-ui=hearts`, `data-value` `hp/max`, a heart per `data-fill`.\n * - `createBox(parent, { id, title, text })`: a window frame, Final Fantasy's soft gradient in a light rim, a title and\n *   a body (`data-ui=box`); the dialog and the menu draw theirs alike.\n * Each returns its element, `set(…)` (the new numbers or text, changing the page only where they differ) and\n * `remove()`. Put a HUD widget in a HUD place with `overlay.attach(widget.el, at)` (engine/ui/overlay.ts).\n *\n * Shared: `UiInput`, what a menu reads of a page's input (engine/input/input.ts: `held`, `pressed`, `strength` and\n * `lastDevice`, over the system layer's `uiAccept`, `uiCancel` and `uiUp`/`uiDown`/`uiLeft`/`uiRight`, which never enter\n * the intents); `UiSound`, a cue it asks for (`move`, `pick`, `cancel`, `type`), played by the page's audio;\n * `createRepeat()`, a held direction moving again after 0.35 s and every 0.1 s after; and `createPadCursor(root,\n * input)`: with a gamepad used last and a panel open, the left stick moves a cursor over the page (260 px/s, up to\n * 1,160 at a full push: shardfall's) and the pad's accept clicks what it is over, so a gamepad works any DOM panel.\n *\n * Invariants: presentation only: widgets read what they are given and the page, never the sim; one stylesheet\n * (`<style id=\"ui-widgets-style\">`, added once and kept), no `.css` import (tsx runs the `x` commands). Carried from `my-3d2dge:engine/my-3d2dge.js:4146-4192` (`ui.box`, `bar`,\n * `hearts`) as behaviour, and `shardfall:crates/pav_app/src/app.rs:438-530` (the pad's cursor), in HTML/CSS.\n *\n * @example\n * // browser: widgets need a page\n * // const hp = createBar(ui.root, { id: 'hp', value: 30, max: 40, label: 'HP' });\n * // ui.attach(hp.el, 'top-left');\n * // hp.set(25); // data-value '0.625', text 'HP 25/40'\n * // createHearts(ui.root, { id: 'life', hp: 2.5, max: 3 }).el.dataset.value; // '2.5/3'\n * @see engine/ui/widgets.test.ts\n * @see tests/e2e/ui.spec.ts\n */\n\n=== engine/ui/dialog.ts\n/**\n * @file The dialog box (PLAN.md §6.7, WP 10.6, I-50): text that types itself out a page at a time, with a speaker's\n * name and, on its last page, choices (Zelda's, Dragon Quest's, Final Fantasy's), as HTML/CSS over the overlay.\n * `createDialog(parent, { input, sound, speed, place })` makes it closed; `say(text, options)` opens it, each string a\n * page; `update(dt)` each frame types `speed` characters a second (50), reads the page's input and returns true while\n * it is open and modal, so the game waits.\n *\n * Accept (`uiAccept`: Enter, Space, the pad's south button; or a click on the box) shows the rest of a page that is\n * still typing, else turns the page, else closes it: with choices, it picks the one marked, `uiUp` and `uiDown` moving\n * the mark (held, they repeat: engine/ui/widgets.ts `createRepeat`) and a click picking one, while cancel (`uiCancel`)\n * marks the last (the \"no\"). `onChoice(i, choice)` then `onDone()` hear it. `auto: s` turns each typed page after `s`\n * seconds and closes after the last; `modal: false` reads no input and holds nothing back (radio chatter). Cues: `type`\n * every second character shown, `move` for the mark, `pick` on closing. A pick that changes play is the game's to send\n * as input (a dev action or a custom intent), since the system layer never reaches the intents.\n *\n * Elements: `[data-ui=dialog]` (`data-value`: `typing`, `shown` or `asking`; `data-place`), its `[data-ui=dialog-name]`\n * and `[data-ui=dialog-text]` (the characters shown), and a `[data-ui=choice]` per choice (`data-value=selected` on the\n * one marked). Invariants: presentation only; typing follows `dt` alone, so the same frames show the same text; it\n * never reads the sim. Carried from `my-3d2dge:engine/my-3d2dge.js:4194-4284` (`Dialog`: say, typing, pages, choices,\n * cancel to the last, auto, modal), the pixel-font wrap replaced by CSS.\n *\n * @example\n * // browser: the dialog needs a page\n * // const talk = createDialog(ui.root, { input, sound: (cue) => audio.play(`ui.${cue}`) });\n * // talk.say(['Hello, traveler!', 'Take the shield?'], { name: 'OLD MAN', choices: ['YES', 'NO'], onChoice: (i) => … });\n * // if (talk.update(dt)) return; // each frame: true while it is open, so play waits\n * @see engine/ui/dialog.test.ts\n * @see tests/e2e/ui.spec.ts\n */\n\nengine/audio/data:\ndrums.ts\neffects.ts\nfoley.ts\nsfx.ts\nsong.ts\nsongs.ts\n\nengine/audio/dsp:\nbiquad.ts\ndelay.ts\nenvelope.ts\nmeasure.ts\nosc.ts\npluck.ts\nrender.ts\nsynth.ts\nvoice.ts\n\nengine/audio/runtime:\naudio.ts\nbuffers.ts\ngesture.ts\nmixer.ts\nmusic.ts\nreverb.ts\nsound.ts\nspatial.ts\nvoices.ts\nengine/audio/runtime/audio.ts:46:import { BUS_VOLUMES, createMixer, type AudioBus, type Mixer, type MixerInfo } from './mixer';\nengine/audio/runtime/audio.ts-47-import { createMusic, type Music, type MusicChange, type MusicPosition } from './music';\nengine/audio/runtime/audio.ts-48-import { roomSpec, type RoomName, type RoomSpec } from './reverb';\nengine/audio/runtime/audio.ts-49-import { foldLoop, toBuffer } from './buffers';\nengine/audio/runtime/audio.ts-50-import { checkPlay, createVoice, type PlayOptions, type Sound, type RuntimeSound } from './sound';\nengine/audio/runtime/audio.ts-51-import { placeListener, wallsBetween, type ListenerPose, type Vec3 } from './spatial';\nengine/audio/runtime/audio.ts-52-import { createVoicePool, type VoiceLimits } from './voices';\nengine/audio/runtime/audio.ts-53-\nengine/audio/runtime/audio.ts-54-/** The runtime's codes, with their fixes. */\nengine/audio/runtime/audio.ts-55-export const AUDIO_CODES = defineCodes('audio', {\nengine/audio/runtime/audio.ts-56-  AUDIO_OFF: {\n--\nengine/audio/runtime/audio.ts:138:  const volumes = { ...BUS_VOLUMES };\nengine/audio/runtime/audio.ts-139-  let muted = false;\nengine/audio/runtime/audio.ts-140-  let room: RoomName | RoomSpec = 'none';\nengine/audio/runtime/audio.ts-141-  let pose: ListenerPose | null = null;\nengine/audio/runtime/audio.ts-142-  let queries: QueryView | undefined;\nengine/audio/runtime/audio.ts-143-  let pending: { id: string | null; options: MusicChange & { intensity?: number } } | null = null;\nengine/audio/runtime/audio.ts-144-  let level: number | undefined;\nengine/audio/runtime/audio.ts-145-  let context: BaseAudioContext | null = null;\n6: * mapping by position (`PadSouth` is index 0: A on Xbox, Cross on PlayStation), and each stick has four direction codes\n24: * Carried from `my-3d2dge:src/emberdeep/61-controls.js:28-116` (`bindingCode`, `PAD_LABELS`, `codeLabel`), with\n28: * deviceOf('PadSouth'); // 'gamepad'\n31: * codeLabel('PadSouth', { pad: padStyle('DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c)') }); // 'Cross'\n59:  'PadSouth',\n148:const PAD_LABELS: Record<PadStyle, readonly string[]> = {\n193:  if (button >= 0) return PAD_LABELS[options.pad ?? 'xbox'][button];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XdhMuMcJwfZ6cbstyofzNV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
