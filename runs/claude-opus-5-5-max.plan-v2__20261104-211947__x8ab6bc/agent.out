{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014wdHTTTnsUNapyzJ1uJJhG","type":"tool_result","content":"import { chromium, type Browser, type LaunchOptions, type Page } from '@playwright/test';\nimport { fnv1a } from './hash';\nimport { mapPageError, type PageError } from './pageErrors';\n\n/** Shardfall's WebGPU flags (PLAN.md §8.8): SwiftShader through Vulkan, presenting to the page's own canvas. */\nexport const WEBGPU_FLAGS: readonly string[] = [\n  '--enable-unsafe-webgpu',\n  '--enable-features=Vulkan',\n  '--use-vulkan=swiftshader',\n  '--use-angle=swiftshader',\n];\n\n7: * Invariants: WebGPU runs on SwiftShader with shardfall's flags (`WEBGPU_FLAGS`), so pages present to their real\n8- * canvas. The clock only moves on `__clock.tick(n)`, 1/60 s per frame, and `Math.random` and `__clock.rng(name)`\n9- * are seeded, so a run repeats exactly. `__gpu` counts what WebGPU really did (adapters, devices, configured\n10- * canvases, queue submits, lost devices); it is measured, never reported by the page. `__gpuIdle()` resolves once\n11- * every queue the page submitted to has finished its work (the e2e harness waits on it at each test's end).\n12- *\n13- * @example\n14- * import { chromium } from '@playwright/test';\n15- * const browser = await chromium.launch(launchOptions());\n16- * const page = await browser.newPage({ viewport: VIEWPORT });\n17- * const watch = await preparePage(page, { seed: 1 }); // the virtual clock and the console, before the first goto\n18- * await browser.close();\n19- * @see tests/e2e/harness.spec.ts\n20- */\n21-/// <reference types=\"@webgpu/types\" />\n--\n30:export const WEBGPU_FLAGS: readonly string[] = [\n31-  '--enable-unsafe-webgpu',\n32-  '--enable-features=Vulkan',\n33-  '--use-vulkan=swiftshader',\n34-  '--use-angle=swiftshader',\n35-];\n36-\n37-/** The container's Chromium (153 since 2026-10-22); `$CHROMIUM_PATH` overrides it. Nothing runs `playwright install`. */\n38-export const DEFAULT_CHROMIUM = '/