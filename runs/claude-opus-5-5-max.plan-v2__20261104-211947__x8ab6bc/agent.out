{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Si6h1iZEojuhVNAURhs5Cm","type":"tool_result","content":"26- *\n27- * @example\n28: * deviceOf('PadSouth'); // 'gamepad'\n29- * codeLabel('KeyW'); // 'W'\n30- * codeLabel('KeyW', { layout: new Map([['KeyW', 'z']]) }); // 'Z': the key AZERTY puts there\n31: * codeLabel('PadSouth', { pad: padStyle('DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c)') }\n32- * isCode('KeyW') && !isCode('w'); // true: bindings name physical keys\n33- * codeLabel(holdCode('PadWest')); // 'Hold X': Apex's reload on a pad\n34- * @see engine/input/bindings.test.ts\n35- */\n36-\n37-/** The devices input comes from; `virtual` is the inspector's (engine/input/devices/virtual.ts). */\n38-export type DeviceKind = 'keyboard' | 'mouse' | 'gamepad' | 'touch' | 'virtual';\n39-\n40-/** Where the devices write (engine/input/input.ts keeps it): codes going down and up, analog strengths, us\n41-export interface InputSink {\n42-  /** A digital code went down (a key, a mouse button, a wheel notch): pressed at the next sample, even if \n43-  press(code: string, device: DeviceKind): void;\n44-  /** A digital code went up. */\n45-  release(code: string): void;\n46-  /** An analog code's strength now, 0 to 1 (a trigger, a stick direction); `press` and `release` say when \n47-  analog(code: string, value: number): void;\n48-  /** The device was used without a press (a stick pushed, the mouse moved): prompts follow it. */\n49-  used(device: DeviceKind): void;\n50-  /** Whether an action binds `code`: a bound key's default (Space scrolling the page) is prevented. */\n51-  bound(code: string): boolean;\n52-}\n53-\n--\n57-/** The W3C standard gamepad buttons by index, named by position. */\n58-export const PAD_BUTTONS = [\n59:  'PadSouth',\n60-  'PadEast',\n61-  'PadWest',\n  playstation: ['Cross', 'Circle', 'Square', 'Triangle', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad Up', 'D-p\n  nintendo: ['B', 'A', 'Y', 'X', 'L', 'R', 'ZL', 'ZR', '−', '+', 'L Stick', 'R Stick', 'D-pad Up', 'D-pad Down', 'D-pad Left', 'D-\n};\n\n/** Labels of codes whose name says too little or too much. */\nconst NAMED: Readonly<Record<string, string>> = {\n  MouseLeft: 'LMB',\n  MouseMiddle: 'MMB',\n  MouseRight: 'RMB',\n  MouseBack: 'Mouse 4',\n  MouseForward: 'Mouse 5',\n  WheelUp: 'Wheel Up',\n  WheelDown: 'Wheel Down',\n  Escape: 'Esc',\n  Backquote: '`',\n  ShiftLeft: 'L Shift',\n  ShiftRight: 'R Shift',\n  ControlLeft: 'L Ctrl',\n  ControlRight: 'R Ctrl',\n  AltLeft: 'L Alt',\n  AltRight: 'R Alt',\n8: * The context: a page's runtime starts `locked`, with no `AudioContext`, and makes one inside the first user gesture\n10: * resumes it when the browser suspended it. Its `state` is then the context's (`running`, `suspended`, `closed`).\n12: * context (`OfflineAudioContext`), which needs no gesture.\n16: * the `Sound` (move it, stop it), or null when the voice limits drop it or there is no running context yet (sounds\n25: * effect and variant at the context's rate (played looped, an effect with a `loop` pass is its render folded onto it:\n28: * Carried from `my-3d2dge:engine/my-3d2dge.js:3708-3786` (`ChipAudio`: the lazy context, resume on a gesture, the\n59:    doc: 'Advice from `createAudio` (engine/audio/runtime/audio.ts) when there is no Web Audio, or the context could not be made.',\n63:/** The runtime's state: `locked` until a gesture, then the context's; `off` without Web Audio. */\n68:  /** The context to play into (an `OfflineAudioContext` in a test); one is made on the first gesture by default. */\n69:  context?: BaseAudioContext;\n/**\n * @file The game's HTML/CSS overlay (PLAN.md §6.7, WP 6.5; doctrine: WebGPU only): what a game shows over the canvas\n * as page elements, never drawn on the GPU. `createOverlay({ canvas })` puts a root over the canvas, sized to it each\n * frame, holding world-anchored labels and damage numbers (engine/ui/labels.ts), HUD lines in six places and a\n * crosshair. Call `update(camera, dt)` once per frame after drawing, with the camera the frame was drawn with; tests\n * and agents read it all through `state()` (engine/ui/state.ts) or DOM queries on `[data-ui]`.\n *\n * Elements: `[data-ui=label]` (`data-id`), `[data-ui=damage]` (`data-value`), `[data-ui=hud]` (`data-id`, and\n * `data-keyboard` for a key hint), `[data-ui=crosshair]` while it shows; WP 10.6's widgets (engine/ui/widgets.ts,\n * dialog.ts, menu.ts) in the HUD's places (`attach`) or over the root. Text uses the system font. The overlay's\n * stylesheet is one `<style id=\"ui-overlay-style\">` it adds to the page (no engine module imports a `.css` file: tsx,\n * which runs every `x` command, cannot load one). Damage numbers animate with CSS keyframes, paused and driven by the\n * overlay's clock (`--ui-age`, a negative `animation-delay`), so a frame shows the same look for the same age in\n * every run.\n *\n * Touch screens (WP 3.12's rules; built, not tested, ADR-0021): in touch mode (the `touch` class engine/ui/chrome.ts\n * puts on the page), text scales with `--touch-k` (the overlay scales its own root, so its lines carry no\n * `data-hud`), key hints (`data-keyboard`) are hidden, the HUD's bottom and top-right places move clear of the\n * buttons' corner and the menu button, and a label or number whose centre falls on a button of the touch layer\n * (engine/ui/touch.ts's slots at `touchScale`) is hidden.\n *\n * Invariants: presentation only: the overlay reads the camera and the page and never the sim, so it cannot change\n * the hash (tests/e2e/overlay.spec.ts plays a replay with it); it takes no pointer events; `dispose()` removes it.\n *","is_error":false}]},"parent_tool_use_id":null,"session_id":"3b0d0401-1a79-4c2f-8a33-ba9239fdbfed","uuid":"4b23520b-512b-4348-a24d-d173dfb4e5a6","timestamp":"2026-11-05T05:16:12.801Z","tool_use_result":{"stdout":"26- *\n27- * @example\n28: * deviceOf('PadSouth'); // 'gamepad'\n29- * codeLabel('KeyW'); // 'W'\n