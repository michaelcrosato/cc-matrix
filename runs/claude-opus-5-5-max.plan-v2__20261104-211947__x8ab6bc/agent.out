' engine/sim/crowdBodies.ts | cut -c1-160 | head -30; grep -n \"rig ===\\|case '\\|\\.rig\" engine/gfx/stageCrowd.ts | head -20 | cut -c1-160","description":"Check how a game's own procedural rig gets drawn"}},"wire_ingest_context":{"toolu_01KCbNL6sJ3MRykQReunK1LW":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211947__x8ab6bc/work/.research/proto"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KCbNL6sJ3MRykQReunK1LW","type":"tool_result","content":"{\n  \"describe\": \"A procedural rig: a creature made of the blocks of engine/anim/proc (it starts as a small four-legged walker: a planted gait on two diagonals, two-bone legs, a body bobbing on a spring, a wagging tail, a looking head) and its rig spec, with a unit test that passes it through rigCheck and walks it on its diagonals (PLAN.md WP 10.1).\",\n  \"id\": \"the module's path, labs/<lab>/rigs/<name> (its rig's id is rig:<name>; `node x qa anim` drives the fixture rigs, a game's own test drives its own): labs/box/rigs/crab\",\n  \"pattern\": \"^(labs/[a-z][a-z0-9-]*/rigs|tools/templates/rig)/[a-z][A-Za-z0-9]*$\",\n  \"sample\": \"tools/templates/rig/sampleRig\",\n  \"files\": {\n    \"rig.ts.tmpl\": \"{{id}}.ts\",\n    \"rig.test.ts.tmpl\": \"{{id}}.test.ts\"\n  },\n  \"checks\": [\"types\", \"lint\", \"test\", \"docs\"]\n}\n/**\n * @file Unit tests for the rig `rig:{{name}}` ({{id}}.ts): it passes the rig check in every state (finite, on the\n * floor, its bones their lengths, the same every run and at any step), and walking, its feet keep up with it.\n * @see {{id}}.ts\n */\nimport { describe, expect, it } from 'vitest';\nimport { rigCheck } from '../../../engine/sim-api';\nimport { {{name}} } from './{{name}}';\n\ndescribe('rig:{{name}}', () => {\n  it('passes the rig check in every state, and keeps its feet up with it as it walks', () => {\n    expect(rigCheck({{name}}).problems.map((p) => p.message)).toEqual([]);\n    const body = {{name}}.make('walk', 0, 1 / 60);\n    let root = body.step();\n    for (let k = 0; k < 120; k++) root = body.step(k / 60);\n    expect(root.z).toBeGreaterThan(1.5); // walked on\n    for (const foot of {{name}}.feet!) {\n      const at = body.points()[{{name}}.names.indexOf(foot)];\n      expect(Math.hypot(at.x - root.x, at.z - root.z)).toBeLessThan(0.45); // stepped along, never left behind\n    }\n  });\n});\n/**\n * @file The rig `rig:{{name}}`: what it is (replace this text; `x docs` puts the first sentence in INDEX). It starts as\n * a small four-legged walker of the procedural blocks (engine/sim-api.ts): its feet planted and stepping on two\n * diagonals (`LegGait`), each leg bent by two-bone IK (`twoBone`), its body bobbing on a spring a footfall kicks\n * (`Spring1`), its tail wagging (`SwayChain`) and its head looking where it is told (`LookAt`).\n *\n * Invariants: metres, seconds, +Y up, facing +Z; a fixed step; nothing random.\n *\n * @example\n * {{name}}.names.length; // 21: its body, head and eye, four legs and a tail\n * @see {{id}}.test.ts\n */\nimport { LegGait, LookAt, Quaternion, Spring1, SwayChain, twoBone, Vector3 } from '../../../engine/sim-api';\nimport type { GaitLeg, ProcRig } from '../../../engine/sim-api';\n\n/** Its legs: left front with right back, right front with left back (x left, y up, z forward; m). */\nconst LEGS: readonly GaitLeg[] = [1, -1].flatMap((side) =>\n  [0.18, -0.18].map((z) => {\n    const group = side > 0 === z > 0 ? 0 : 1;\n    return { hip: [0.08 * side, 0.32, z], rest: [0.1 * side, 0, z], group } as const;\n  }),\n);\nconst UP = new Vector3(0, 1, 0);\n\n/** The creature, stepped at `dt`, facing `yaw`. */\nclass Body {\n  readonly root = new Vector3();\n  readonly turn: Quaternion;\n  readonly gait = new LegGait({ legs: LEGS });\n  readonly bob = new Spring1({ frequency: 12, damping: 0.5, limit: 0.03 });\n  readonly tail = new SwayChain({ count: 4, length: 0.06, amplitude: 0.5, frequency: 6, lag: 0.6, droop: 0.1 });\n  readonly look = new LookAt({ rate: 8, yaw: 1, pitch: 0.5 });\n  readonly yaw: number;\n  readonly dt: number;\n  points: Vector3[] = [];\n\n  constructor(yaw: number, dt: number) {\n    [this.yaw, this.dt] = [yaw, dt];\nrig.test.ts.tmpl\nrig.ts.tmpl\ntemplate.json\n====\n/**\n * @file Procedural rigs (PLAN.md WP 10.1): the contract a creature built from the blocks of engine/anim/proc meets, so\n * one check runs every such rig as `anim.check` runs the humanoid (engine/anim/check.ts) and the `anim` QA family\n * measures their motion (tools/qa/anim.ts). A `ProcRig` names:\n * - `names`: its points (world metres), what the view draws on and the checks measure;\n * - `bones`: pairs of points that keep their distance (a leg's bones, a tail's links), held to the length a bone\n *   gives or else the run's first frame;\n * - `feet`: the points that plant, which must not slide while on the floor (the QA's foot slide);\n * - `closed`: how many of its first points come back at rest (the rest cycle: motes, a wave), for every state or by\n *   state (`rigClosed`: a state not named closes every point);\n * - `states`: what it does, each held some seconds;\n * - `make(state, facing, dt)`: a fresh body facing `facing`, stepped at `dt`: `step(time)` takes it `time` seconds\n *   into the state (undefined: at rest) and returns where its root is; `points()` gives its points.\n * `driveRig(rig, state, facing, dt)` runs a state as the humanoid's matrix does (`STATE_MATRIX.lead` seconds at rest,\n * the state, `STATE_MATRIX.after` at rest); `rigCheck(rig)` runs every state at both of its facings and reports in\n * `anim.check`'s words: points not finite (`finite`), bones off their length (`length`, past `tolerance`), points\n * under the floor (`floor`), a run giving other points the second time (`hash`), and points straying farther than\n * `STATE_MATRIX.rate` at half the step, beyond a step of their own motion (`rate`).\n *\n * Invariants: read-only and deterministic: the same rig gives the same report; a problem is reported once per check,\n * state and point, naming its first frame, how many frames have it and the worst value. A rig that breaks its own\n * contract (a bone, a foot or a closure naming what it lacks, a state it has not, points() not one a name) throws\n * `ANIM_BAD_RIG`.\n *\n * @example\n * import { Vector3 } from '../../core/math';\n * const post: ProcRig = { id: 'rig:post', names: ['foot', 'top'], bones: [['foot', 'top']], states: { still: 0.5 }, make: () => ({ step: () => new Vector3(), points: () => [new Ve\n * rigCheck(post).ok; // true: finite, on the floor, its bone its length, the same every run and at any step\n * @see engine/anim/proc/rig.test.ts\n */\nimport { Fnv64 } from '../../core/hash';\nimport { codeError, defineCodes, didYouMean } from '../../core/log';\nimport type { Vector3 } from '../../core/math';\nimport type { AnimCheckName, AnimCheckReport, AnimProblem } from '../check';\nimport { rateDrift, STATE_MATRIX } from '../stateMatrix';\n\n/** The codes this module raises, with their fixes. */\nexport const RIG_CODES = defineCodes('anim', {\n  ANIM_BAD_RIG: {\n    template: 'the rig {id} {problem}{suggestion}',\n    fix: 'use its own names in bones, feet, closed and runs; give one point a name, bones and states sizes above 0',\n    doc: 'Raised by `driveRig` and `rigCheck` (engine/anim/proc/rig.ts) for a rig that breaks its own contract.',\n  },\n});\n\n====\nexport const CROWD_BODY_FIELDS = defineSchema({\n  rig: {\n    type: 'string',\n    enum: ['humanoid', 'blob', 'floater', 'quadruped'],\n    default: 'humanoid',\n    description: 'Its rig: a humanoid (an animator), a blob, a floater or a quadruped.',\n  },\n  look: {\n    type: 'string',\n    default: '',\n    description:\n      'What it wears: a humanoid’s build id (build:chibi when empty), a blob’s features (horns, ears or wings; none when empty); a floater and a quadruped have \n  },\n  size: {\n    type: 'number',\n    default: 0,\n    minimum: 0,\n    maximum: 100,\n    unit: 'm',\n    description: 'A blob’s radius at rest (BLOB.radius when 0); unused for the others.',\n  },\n  x: {\n    type: 'number',\n    default: 0,\n    unit: 'm',\n    description: 'Where it stands, east: a humanoid’s, blob’s or quadruped’s feet, a floater’s core.',\n  },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where it stands, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where it stands, south.' },\n  yaw: { type: 'number', default: 0, unit: 'rad', description: 'Where it faces: forward is (sin yaw, 0, cos yaw).' },\n180:        if (body.rig === 'humanoid') humanoidOf(body.look || 'build:chibi');\n181:        else if (body.rig === 'blob') blobLookOf(body.look);\n182:        else if (body.rig === 'quadruped') quadrupedLook();\n199:        if (body.rig === 'humanoid') {\n206:        } else if (body.rig === 'blob') {\n215:        } else if (body.rig === 'quadruped') {\n220:          crowd.rig(quadrupedLook(), quadruped.pose() as RigJoints, { band, floor: floorAt(x, z) });","is_error":false}]},"parent_tool_use_id":null,"session_id":"3b0d0401-1a79-4c2f-8a33-ba9239fdbfed","uuid":"b32f91c5-753a-4185-8426-cc9d49f2745d","timestamp":"2026-11-05T04:36:08.805Z","tool_use_result":{"stdout":"{\n  \"describe\": \"A procedural rig: a creature made of the blocks of engine/anim/proc (it starts as a small four-legged walker: a planted gait on two diagonals, two-bone legs, a body bobbing on a spring, a wagging tail, a looking head) and its rig spec, with a unit test that passes it through rigCheck and walks it on its diagonals (PLAN.md WP 10.1).\",\n  \"id\": \"the module's path, labs/<lab>/rigs/<name> (its rig's id is rig:<name>; `node x qa anim` drives the fixture rigs, a game's own test drives its own): labs/box/rigs/crab\",\n  \"pattern\": \"^(labs/[a-z][a-z0-9-]*/rigs|tools/templates/rig)/[a-z][A-Za-z0-9]*$\",\n  \"sample\": \"tools/templates/rig/sampleRig\",\n  \"files\": {\n    \"rig.ts.tmpl\": \"{{id}}.ts\",\n    \"rig.test.ts.tmpl\": \"{{id}}.test.ts\"\n  },\n  \"checks\": [\"types\", \"lint\", \"test\", \"docs\"]\n}\n/**\n * @file Unit tests for the rig `rig:{{name}}` ({{id}}.ts): it passes the rig check in every state (finite, on the\n * floor, its bones their lengths, the same every run and at any step), and walking, its feet keep up with it.\n * @see {{id}}.ts\n */\nimport { describe, expect, it } from 'vitest';\nimport { rigCheck } from '../../../engine/sim-api';\nimport { {{name}} } from './{{name}}';\n\ndescribe('rig:{{name}}', () => {\n  it('passes the rig check in every state, and keeps its feet up with it as it walks', () => {\n    expect(rigCheck({{name}}).problems.map((p) => p.message)).toEqual([]);\n    const body = {{name}}.make('walk', 0, 1 / 60);\n    let root = body.step();\n    for (let k = 0; k < 120; k++) root = body.step(k / 60);\n    expect(root.z).toBeGreaterThan(1.5); // walked on\n    for (const foot of {{name}}.feet!) {\n      const at = body.points()[{{name}}.names.indexOf(foot)];\n      expect(Math.hypot(at.x - root.x, at.z - root.z)).toBeLessThan(0.45); // stepped along, never left behind\n    }\n  });\n});\n/**\n * @file The rig `rig:{{name}}`: what it is (replace this text; `x docs` puts the first sentence in INDEX). It starts as\n * a small four-legged walker of the procedural blocks (engine/sim-api.ts): its feet planted and stepping on two\n * diagonals (`LegGait`), each leg bent by two-bone IK (`twoBone`), its body bobbing on a spring a footfall kicks\n * (`Spring1`), its tail wagging (`SwayChain`) and its head looking where it is told (`LookAt`).\n *\n * Invariants: metres, seconds, +Y up, facing +Z; a fixed step; nothing random.\n *\n * @example\n * {{name}}.names.length; // 21: its body, head and eye, four legs and a tail\n * @see {{id}}.test.ts\n */\nimport { LegGait, LookAt, Quaternion, Spring1, SwayChain, twoBone, Vector3 } from '../../../engine/sim-api';\nimport type { GaitLeg, ProcRig } from '../../../engine/sim-api';\n\n/** Its legs: left front with right back, right front with left back (x left, y up, z forward; m). */\nconst LEGS: readonly GaitLeg[] = [1, -1].flatMap((side) =>\n  [0.18, -0.18].map((z) => {\n    const group = side > 0 === z > 0 ? 0 : 1;\n    return { hip: [0.08 * side, 0.32, z], rest: [0.1 * side, 0, z], group } as const;\n  }),\n);\nconst UP = new Vector3(0, 1, 0);\n\n/** The creature, stepped at `dt`, facing `yaw`. */\nclass Body {\n  readonly root = new Vector3();\n  readonly turn: Quaternion;\n  readonly gait = new LegGait({ legs: LEGS });\n  readonly bob = new Spring1({ frequency: 12, damping: 0.5, limit: 0.03 });\n  readonly tail = new SwayChain({ count: 4, length: 0.06, amplitude: 0.5, frequency: 6, lag: 0.6, droop: 0.1 });\n  readonly look = new LookAt({ rate: 8, yaw: 1, pitch: 0.5 });\n  readonly yaw: number;\n  readonly dt: number;\n  points: Vector3[] = [];\n\n  constructor(yaw: number, dt: number) {\n    [this.yaw, this.dt] = [yaw, dt];\nrig.test.ts.tmpl\nrig.ts.tmpl\ntemplate.json\n====\n/**\n * @file Procedural rigs (PLAN.md WP 10.1): the contract a creature built from the blocks of engine/anim/proc meets, so\n * one check runs every such rig as `anim.check` runs the humanoid (engine/anim/check.ts) and the `anim` QA family\n * measures their motion (tools/qa/anim.ts). A `ProcRig` names:\n * - `names`: its points (world metres), what the view draws on and the checks measure;\n * - `bones`: pairs of points that keep their distance (a leg's bones, a tail's links), held to the length a bone\n *   gives or else the run's first frame;\n * - `feet`: the points that plant, which must not slide while on the floor (the QA's foot slide);\n * - `closed`: how many of its first points come back at rest (the rest cycle: motes, a wave), for every state or by\n *   state (`rigClosed`: a state not named closes every point);\n * - `states`: what it does, each held some seconds;\n * - `make(state, facing, dt)`: a fresh body facing `facing`, stepped at `dt`: `step(time)` takes it `time` seconds\n *   into the state (undefined: at rest) and returns where its root is; `points()` gives its points.\n * `driveRig(rig, state, facing, dt)` runs a state as the humanoid's matrix does (`STATE_MATRIX.lead` seconds at rest,\n * the state, `STATE_MATRIX.after` at rest); `rigCheck(rig)` runs every state at both of its facings and reports in\n * `anim.check`'s words: points not finite (`finite`), bones off their length (`length`, past `tolerance`), points\n * under the floor (`floor`), a run giving other points the second time (`hash`), and points straying farther than\n * `STATE_MATRIX.rate` at half the step, beyond a step of their own motion (`rate`).\n *\n * Invariants: read-only and deterministic: the same rig gives the same report; a problem is reported once per check,\n * state and point, naming its first frame, how many frames have it and the worst value. A rig that breaks its own\n * contract (a bone, a foot or a closure naming what it lacks, a state it has not, points() not one a name) throws\n * `ANIM_BAD_RIG`.\n *\n * @example\n * import { Vector3 } from '../../core/math';\n * const post: ProcRig = { id: 'rig:post', names: ['foot', 'top'], bones: [['foot', 'top']], states: { still: 0.5 }, make: () => ({ step: () => new Vector3(), points: () => [new Ve\n * rigCheck(post).ok; // true: finite, on the floor, its bone its length, the same every run and at any step\n * @see engine/anim/proc/rig.test.ts\n */\nimport { Fnv64 } from '../../core/hash';\nimport { codeError, defineCodes, didYouMean } from '../../core/log';\nimport type { Vector3 } from '../../core/math';\nimport type { AnimCheckName, AnimCheckReport, AnimProblem } from '../check';\nimport { rateDrift, STATE_MATRIX } from '../stateMatrix';\n\n/** The codes this module raises, with their fixes. */\nexport const RIG_CODES = defineCodes('anim', {\n  ANIM_BAD_RIG: {\n    template: 'the rig {id} {problem}{suggestion}',\n    fix: 'use its own names in bones, feet, closed and runs; give one point a name, bones and states sizes above 0',\n    doc: 'Raised by `driveRig` and `rigCheck` (engine/anim/proc/rig.ts) for a rig that breaks its own contract.',\n  },\n});\n\n====\nexport const CROWD_BODY_FIELDS = defineSchema({\n  rig: {\n    type: 'string',\n    enum: ['humanoid', 'blob', 'floater', 'quadruped'],\n    default: 'humanoid',\n    description: 'Its rig: a humanoid (an animator), a blob, a floater or a quadruped.',\n  },\n  look: {\n    type: 'string',\n    default: '',\n    description:\n      'What it wears: a humanoid’s build id (build:chibi when empty), a blob’s features (horns, ears or wings; none when empty); a floater and a quadruped have \n  },\n  size: {\n    type: 'number',\n    default: 0,\n    minimum: 0,\n    maximum: 100,\n    unit: 'm',\n    description: 'A blob’s radius at rest (BLOB.radius when 0); unused for the others.',\n  },\n  x: {\n    type: 'number',\n    default: 0,\n    unit: 'm',\n    description: 'Where it stands, east: a humanoid’s, blob’s or quadruped’s feet, a floater’s core.',\n  },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where it stands, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where it stands, south.' },\n  yaw: { type: 'number', default: 0, unit: 'rad', description: 'Where it faces: forward is (sin yaw, 0, cos yaw).' },\n180:        if (body.rig === 'humanoid') humanoidOf(body.look || 'build:chibi');\n181:        else if (body.rig === 'blob') blobLookOf(body.look);\n182:        else if (body.rig === 'quadruped') quadrupedLook();\n199:        if (body.rig === 'humanoid') {\n206:        } else if (body.rig === 'blob') {\n215:        } else if (body.rig === 'quadruped') {\n220:          crowd.rig(quadrupedLook(), quadruped.pose() as RigJoints, { band, floor: floorAt(x, z) });","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KCbNL6sJ3MRykQReunK1LW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
