{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ayj6fwufAjeBqN6y4tSkyY","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t/**\n3\t * @file Makes a game from the my-3dge engine, and moves a game to a newer engine (PLAN.md WP 10.7, ADR-0024): the\n4\t * one command an agent runs to start a game. Plain JavaScript for any Node from 18 with nothing installed, since it\n5\t * runs straight after `git clone`, before setup. What a game gets, and whose each file is, is tools/game/files.mjs.\n6\t *\n7\t * Create: `node <engine>/tools/game/new-game.mjs <dir> [--name <name>]` writes a game into <dir> (made if missing;\n8\t * an empty folder, or a fresh repository's root): the engine's files, copied as they are and pinned by\n9\t * engine-lock.json; the starter game, labs/game/; the game's root files from tools/game/template/ (`TEMPLATES`); and\n10\t * package.json and package-lock.json with the engine's pins (`gamePackage`, `gameLockfile`, from tools/game/files.mjs).\n11\t * Then `git init` when the folder is in no repository. It never overwrites: a README.md or LICENSE already there is\n12\t * kept, a .gitignore gains the lines it lacks, an AGENTS.md, CLAUDE.md or GEMINI.md gets the game's after its own\n13\t * text, and any other file in the way stops it before it writes anything.\n14\t *\n15\t * Update: `node <newer engine>/tools/game/new-game.mjs --update <dir>` (what `node x engine --update` runs) puts this\n16\t * checkout's engine files in place of the game's, removes those it dropped, moves package.json to its pins, brings\n17\t * the root files the game never edited to its templates (`refreshTemplates`) and writes the new lock. Nothing of the\n18\t * game's is replaced or removed: it stops, having written nothing, on an engine file the game changed without\n19\t * declaring it under \"Local engine patches\" in ENGINE-FEEDBACK.md (a declared one is kept), on a file of the game's\n20\t * where the newer engine adds one, and on a package.json entry of the game's that the newer engine sets otherwise\n21\t * (`npmClashes`); `--force` lets the engine's replace them. It names the package.json entries it drops, or sets back\n22\t * where the game had edited the engine's (`npmLost`): the engine's pins win, as its files do.\n23\t *\n24\t * `--verify <dir>` prints `verifyGame` (tools/game/files.mjs) as JSON. Exit codes: 0 done, 1 stopped (the message says\n25\t * why and what to do), 2 a usage error.\n26\t *\n27\t * @example\n28\t * // node /tmp/my-3dge/tools/game/new-game.mjs ../dragon-run → a game in ../dragon-run, named dragon-run\n29\t * // node /tmp/my-3dge/tools/game/new-game.mjs . --name dragon-run → in the current folder (a fresh repository)\n30\t * // node /tmp/my-3dge-new/tools/game/new-game.mjs --update . → the game in . on the newer engine\n31\t * gameName('/tmp/Dragon Run!'); // 'dragon-run'\n32\t * render('# {{name}}', { name: 'dragon-run' }); // '# dragon-run'\n33\t * @see tools/game/new-game.test.ts\n34\t */\n35\timport { execFileSync } from 'node:child_process';\n36\timport { copyFileSync, existsSync, mkdirSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';\n37\timport { basename, dirname, join, relative, resolve, sep } from 'node:path';\n38\timport { fileURLToPath } from 'node:url';\n39\timport {\n40\t  engineIdentity,\n41\t  FEEDBACK_FILE,\n42\t  gameLockfile,\n43\t  gamePackage,\n44\t  hashFile,\n45\t  hashText,\n46\t  LOCK_FILE,\n47\t  lockFor,\n48\t  npmClashes,\n49\t  npmLost,\n50\t  plan,\n51\t  sameDependencies,\n52\t  SOURCE,\n53\t  verifyGame,\n54\t} from './files.mjs';\n55\t\n56\texport { gameLockfile, gamePackage, npmClashes };\n57\t\n58\t/** The game's root files: template (in tools/game/template/) → where it goes. */\n59\texport const TEMPLATES = Object.freeze([\n60\t  ['AGENTS.md.tmpl', 'AGENTS.md'],\n61\t  ['CLAUDE.md.tmpl', 'CLAUDE.md'],\n62\t  ['GEMINI.md.tmpl', 'GEMINI.md'],\n63\t  ['README.md.tmpl', 'README.md'],\n64\t  ['ENGINE-FEEDBACK.md.tmpl', FEEDBACK_FILE],\n65\t  ['gitignore.tmpl', '.gitignore'],\n66\t  ['index.html.tmpl', 'index.html'],\n67\t  ['claude-settings.json.tmpl', '.claude/settings.json'],\n68\t]);\n69\t\n70\t/** Files a target may hold: a README.md or LICENSE is kept; a .gitignore gains the template's lines it lacks. */\n71\tconst KEPT = new Set(['README.md', 'LICENSE', '.gitignore', 'AGENTS.md', 'CLAUDE.md', 'GEMINI.md']);\n72\t\n73\t/** Instruction files the agents read: one already there keeps its text, and the game's follows it (`appendOnce`). */\n74\tconst APPENDED = new Set(['AGENTS.md', 'CLAUDE.md', 'GEMINI.md']);\n75\t\n76\t/** A game's name: an npm package name, from the folder's name by default (`Dragon Run!` → `dragon-run`). */\n77\texport function gameName(target, name) {\n78\t  const folder = basename(resolve(target)).toLowerCase();\n79\t  const chosen = name ?? folder.replace(/[^a-z0-9._-]+/g, '-').replace(/^[-._]+|[-._]+$/g, '');\n80\t  if (!/^[a-z0-9][a-z0-9._-]{0,213}$/.test(chosen)) {\n81\t    throw new Error(`\"${chosen}\" cannot name a game: give --name with lower-case letters, digits, '-', '.' or '_'`);\n82\t  }\n83\t  return chosen;\n84\t}\n85\t\n86\t/** Fills a template's `{{name}}` and `{{engine.*}}`; any other placeholder is an error. */\n87\texport function render(text, values) {\n88\t  return text.replace(/\\{\\{([a-z.]+)\\}\\}/g, (whole, key) => {\n89\t    if (key in values) return values[key];\n90\t    throw new Error(`the template's ${whole} has no value: new-game.mjs fills ${Object.keys(values).join(', ')}`);\n91\t  });\n92\t}\n93\t\n94\t/** The values of the templates' placeholders for the game `game` on the engine `identity`. */\n95\tfunction templateValues(game, identity) {\n96\t  return {\n97\t    name: game,\n98\t    'engine.repository': identity.repository,\n99\t    'engine.commit': identity.commit,\n100\t    'engine.short': identity.commit.slice(0, 7),\n101\t    'engine.date': identity.date,\n102\t  };\n103\t}\n104\t\n105\t/** A template's text in the engine at `source`. */\n106\tconst templateText = (source, template) => readFileSync(join(source, 'tools/game/template', template), 'utf8');\n107\t\n108\t/** Reads a JSON file. */\n109\tconst readJson = (file) => JSON.parse(readFileSync(file, 'utf8'));\n110\t\n111\t/** Writes JSON with two spaces and a final newline (what Prettier keeps). */\n112\tfunction writeJson(file, value) {\n113\t  mkdirSync(dirname(file), { recursive: true });\n114\t  writeFileSync(file, `${JSON.stringify(value, null, 2)}\\n`);\n115\t}\n116\t\n117\t/** What writing `to` under `root` meets, if anything: the file itself, or a file where one of its folders goes. */\n118\tfunction inTheWay(root, to) {\n119\t  const parts = to.split('/');\n120\t  for (let i = 1; i <= parts.length; i++) {\n121\t    const path = join(root, ...parts.slice(0, i));\n122\t    if (existsSync(path) && (i === parts.length || !statSync(path).isDirectory())) return path;\n123\t  }\n124\t  return undefined;\n125\t}\n126\t\n127\t/** Copies one file, making its folder. */\n128\tfunction copyInto(source, from, root, to) {\n129\t  mkdirSync(dirname(join(root, to)), { recursive: true });\n130\t  copyFileSync(join(source, from), join(root, to));\n131\t}\n132\t\n133\t/** Makes a game in `target` from the engine at `source`; on a clash it throws, having written nothing. */\n134\texport function createGame({ target, name, source = SOURCE, git = true }) {\n135\t  const root = resolve(target);\n136\t  if (existsSync(root) && !statSync(root).isDirectory()) throw new Error(`${root} is a file: name a folder`);\n137\t  const game = gameName(root, name);\n138\t  const identity = engineIdentity(source);\n139\t  const items = plan(source);\n140\t  const writes = [\n141\t    ...items.map((item) => item.to),\n142\t    ...TEMPLATES.map(([, to]) => to),\n143\t    'package.json',\n144\t    'package-lock.json',\n145\t  ];\n146\t  const clashes = [...writes, LOCK_FILE].filter((to) => !KEPT.has(to) && inTheWay(root, to));\n147\t  if (clashes.length > 0) {\n148\t    const named = clashes.slice(0, 5).join(', ') + (clashes.length > 5 ? ` and ${clashes.length - 5} more` : '');\n149\t    throw new Error(\n150\t      `${root} already holds ${named}: make the game in an empty folder or a fresh repository's root (a README.md, ` +\n151\t        'LICENSE or .gitignore may be there), or move a game to a newer engine with --update',\n152\t    );\n153\t  }\n154\t  for (const { from, to } of items) copyInto(source, from, root, to);\n155\t  const values = templateValues(game, identity);\n156\t  const kept = [];\n157\t  const templates = {};\n158\t  for (const [template, to] of TEMPLATES) {\n159\t    const text = render(templateText(source, template), values);\n160\t    const file = join(root, to);\n161\t    templates[to] = existsSync(file) ? null : hashText(text);\n162\t    if (to === '.gitignore' && existsSync(file)) mergeLines(file, text);\n163\t    else if (APPENDED.has(to) && existsSync(file)) appendOnce(file, text);\n164\t    else if (existsSync(file)) kept.push(to);\n165\t    else {\n166\t      mkdirSync(dirname(file), { recursive: true });\n167\t      writeFileSync(file, text);\n168\t    }\n169\t  }\n170\t  const engine = readJson(join(source, 'package.json'));\n171\t  writeJson(join(root, 'package.json'), gamePackage(engine, game));\n172\t  writeJson(join(root, 'package-lock.json'), gameLockfile(readJson(join(source, 'package-lock.json')), game));\n173\t  const engineItems = items.filter((item) => item.owner === 'engine');\n174\t  writeJson(join(root, LOCK_FILE), lockFor(source, engineItems, identity, game, engine, templates));\n175\t  const initialized = git && initRepository(root);\n176\t  const starterFiles = items.length - engineItems.length;\n177\t  return { root, name: game, identity, engineFiles: engineItems.length, starterFiles, kept, initialized };\n178\t}\n179\t\n180\t/**\n181\t * Moves the game in `target` to the engine at `source`; returns what changed. Throws, having written nothing, on\n182\t * anything of the game's the update would replace (the file comment says what), unless `force`.\n183\t */\n184\texport function updateGame({ target, source = SOURCE, force = false }) {\n185\t  const root = resolve(target);\n186\t  const before = verifyGame(root);\n187\t  if (before.undeclared.length > 0 && !force) throw new Error(undeclaredMessage(before));\n188\t  const patched = [...before.changed, ...before.missing, ...before.added];\n189\t  const keep = new Set(force ? [] : before.declared.filter((path) => patched.includes(path)));\n190\t  const identity = engineIdentity(source);\n191\t  const items = plan(source).filter((item) => item.owner === 'engine');\n192\t  const old = before.lock.files;\n193\t  const added = items.filter((item) => !(item.to in old)).map((item) => item.to);\n194\t  const blocked = added.filter((path) => !keep.has(path) && inTheWay(root, path));\n195\t  const engine = readJson(join(source, 'package.json'));\n196\t  const previous = readJson(join(root, 'package.json'));\n197\t  const clashes = npmClashes(previous, engine, before.lock.npm);\n198\t  if (blocked.length + clashes.length > 0 && !force) throw new Error(clashMessage(blocked, clashes));\n199\t  const next = new Set(items.map((item) => item.to));\n200\t  const removed = Object.keys(old).filter((path) => !next.has(path) && !keep.has(path));\n201\t  for (const path of removed) rmSync(join(root, path), { force: true });\n202\t  for (const way of blocked.map((path) => inTheWay(root, path))) if (way) rmSync(way, { recursive: true, force: true });\n203\t  const replaced = items\n204\t    .filter((item) => item.to in old && !keep.has(item.to) && old[item.to] !== hashFile(join(source, item.from)))\n205\t    .map((item) => item.to);\n206\t  for (const { from, to } of items) if (!keep.has(to)) copyInto(source, from, root, to);\n207\t  const pkg = gamePackage(engine, previous.name, previous, before.lock.npm);\n208\t  writeJson(join(root, 'package.json'), pkg);\n209\t  const npm = npmLost(previous, pkg, before.lock.npm);\n210\t  const lockfileFits = sameDependencies(pkg, engine);\n211\t  if (lockfileFits) {\n212\t    writeJson(join(root, 'package-lock.json'), gameLockfile(readJson(join(source, 'package-lock.json')), pkg.name));\n213\t  }\n214\t  const { templates, refreshed, diverged } = refreshTemplates(root, source, before.lock, identity);\n215\t  writeJson(join(root, LOCK_FILE), lockFor(source, items, identity, before.lock.game, engine, templates));\n216\t  const forced = [...blocked, ...clashes];\n217\t  return { root, from: before.lock.engine, to: identity, added, removed, replaced, kept: [...keep], forced, npm, refreshed, diverged, lockfileFits }; // prettier-ignore\n218\t}\n219\t\n220\t/** Why an update stops on engine files the game changed or added without declaring them, with the fixes. */\n221\tfunction undeclaredMessage({ undeclared, added }) {\n222\t  const declare = `list it under \"Local engine patches\" in ${FEEDBACK_FILE} to keep it`;\n223\t  const edited = undeclared.filter((path) => !added.includes(path));\n224\t  const own = undeclared.filter((path) => added.includes(path));\n225\t  return [\n226\t    edited.length > 0 &&\n227\t      `the game changed engine files it does not declare: ${edited.join(', ')}. Undo each (git checkout -- <path>), ${declare}, or pass --force to replace it`, // prettier-ignore\n228\t    own.length > 0 &&\n229\t      `the game added files in the engine's folders: ${own.join(', ')}. Move each into labs/game/ (or delete it), or ${declare}`, // prettier-ignore\n230\t  ]\n231\t    .filter(Boolean)\n232\t    .join('; ');\n233\t}\n234\t\n235\t/** Why an update stops on the game's own files and package.json entries where the newer engine has its own. */\n236\tfunction clashMessage(blocked, clashes) {\n237\t  const parts = [\n238\t    blocked.length > 0 &&\n239\t      `the newer engine adds ${blocked.join(', ')}, where the game has files of its own: move or rename them`,\n240\t    clashes.length > 0 &&\n241\t      `the newer engine sets ${clashes.join(', ')} in package.json, where the game has its own: rename the game's (a script), or drop it (a dependency: the engine's pin then serves)`, // prettier-ignore\n242\t  ];\n243\t  return `${parts.filter(Boolean).join('; ')}; or pass --force to let the engine's replace them`;\n244\t}\n245\t\n246\t/**\n247\t * Brings the game's root files to the templates of the engine at `source` (`lock` is the game's, `identity` the new\n248\t * engine's). A file the game never edited (its hash is the lock's) gets the new template; one it edited is named when\n249\t * its template changed, to compare by hand; one it removed, or had before new-game.mjs, stays as it is; a template new\n250\t * to the game is written where no file is. Returns the lock's new `templates` and the paths refreshed and named.\n251\t */\n252\tfunction refreshTemplates(root, source, lock, identity) {\n253\t  const was = lock.templates ?? {};\n254\t  const [then, now] = [templateValues(lock.game, lock.engine), templateValues(lock.game, identity)];\n255\t  const templates = {};\n256\t  const refreshed = [];\n257\t  const diverged = [];\n258\t  for (const [template, to] of TEMPLATES) {\n259\t    const file = join(root, to);\n260\t    const text = templateText(source, template);\n261\t    const fresh = render(text, now);\n262\t    templates[to] = hashText(fresh);\n263\t    if (!(to in was) && !existsSync(file)) {\n264\t      mkdirSync(dirname(file), { recursive: true });\n265\t      writeFileSync(file, fresh);\n266\t      refreshed.push(to);\n267\t    } else if (!(to in was) || was[to] === null || !existsSync(file)) templates[to] = null;\n268\t    else if (hashFile(file) !== was[to]) {\n269\t      if (hashText(render(text, then)) !== was[to]) diverged.push(to);\n270\t    } else if (templates[to] !== was[to]) {\n271\t      writeFileSync(file, fresh);\n272\t      refreshed.push(to);\n273\t    }\n274\t  }\n275\t  return { templates, refreshed, diverged };\n276\t}\n277\t\n278\t/** Appends `text` after a file's own, once: a repository's instructions stay first, and the game's follow them. */\n279\tfunction appendOnce(file, text) {\n280\t  const had = readFileSync(file, 'utf8');\n281\t  if (!had.includes(text.trim())) writeFileSync(file, `${had.replace(/\\n*$/, '\\n\\n')}${text}`);\n282\t}\n283\t\n284\t/** Appends the template's lines a file lacks. */\n285\tfunction mergeLines(file, text) {\n286\t  const had = readFileSync(file, 'utf8');\n287\t  const have = new Set(had.split('\\n'));\n288\t  const lacking = text.split('\\n').filter((line) => line.trim() && !line.startsWith('#') && !have.has(line));\n289\t  if (lacking.length > 0) writeFileSync(file, `${had.replace(/\\n?$/, '\\n')}${lacking.join('\\n')}\\n`);\n290\t}\n291\t\n292\t/** Runs `git init` when `root` is in no repository and git is there; returns whether it did. */\n293\tfunction initRepository(root) {\n294\t  try {\n295\t    execFileSync('git', ['-C', root, 'rev-parse', '--is-inside-work-tree'], { stdio: 'ignore' });\n296\t    return false;\n297\t  } catch {\n298\t    try {\n299\t      execFileSync('git', ['init', '--quiet', root], { stdio: 'ignore' });\n300\t      return true;\n301\t    } catch {\n302\t      return false;\n303\t    }\n304\t  }\n305\t}\n306\t\n307\t/** The command line; returns the exit code. */\n308\texport function main(argv = process.argv.slice(2), out = console.log, err = console.error) {\n309\t  const usage = 'usage: node tools/game/new-game.mjs <dir> [--name <name>] | --update <dir> [--force] | --verify <dir>';\n310\t  const named = argv.indexOf('--name');\n311\t  const flags = argv.filter((arg) => arg.startsWith('--'));\n312\t  const positional = argv.filter((arg, i) => !arg.startsWith('--') && (named < 0 || i !== named + 1));\n313\t  const unknown = flags.find((flag) => !['--name', '--update', '--force', '--verify', '--help'].includes(flag));\n314\t  if (flags.includes('--help')) return (out(usage), 0);\n315\t  if (unknown || positional.length !== 1 || (named >= 0 && !argv[named + 1])) {\n316\t    return (err(`new-game: ${unknown ? `unknown flag ${unknown}` : 'name one folder'}\\n${usage}`), 2);\n317\t  }\n318\t  const [target] = positional;\n319\t  try {\n320\t    if (flags.includes('--verify')) return (out(JSON.stringify(verifyGame(target), null, 2)), 0);\n321\t    if (flags.includes('--update')) {\n322\t      const done = updateGame({ target, force: flags.includes('--force') });\n323\t      const patches = done.kept.length > 0 ? `, the local patches kept (${done.kept.join(', ')})` : '';\n324\t      const counts = `${done.replaced.length} engine files changed, ${done.added.length} added, ${done.removed.length} removed`; // prettier-ignore\n325\t      out(`new-game: moved from my-3dge@${done.from.commit.slice(0, 7)} to my-3dge@${done.to.commit.slice(0, 7)}: ${counts}${patches}`); // prettier-ignore\n326\t      if (done.forced.length > 0) out(`replaced the game's own (--force): ${done.forced.join(', ')}`);\n327\t      if (done.npm.length > 0) out(`package.json: the engine's entries win, so these went or are the engine's again: ${done.npm.join(', ')}; put back what the game needs under a name of its own`); // prettier-ignore\n328\t      if (done.refreshed.length > 0) out(`root files brought to the engine's templates: ${done.refreshed.join(', ')}`);\n329\t      const template = (to) => `${to} (tools/game/template/${TEMPLATES.find(([, path]) => path === to)[0]})`;\n330\t      if (done.diverged.length > 0) out(`the engine's templates changed for root files the game edited: compare ${done.diverged.map(template).join(', ')} and take what applies`); // prettier-ignore\n331\t      out(`next: ${done.lockfileFits ? 'npm ci' : 'npm install (the game has dependencies of its own)'}, then npm run check && npm test`); // prettier-ignore\n332\t      return 0;\n333\t    }\n334\t    const done = createGame({ target, name: named >= 0 ? argv[named + 1] : undefined });\n335\t    const near = relative(process.cwd(), done.root);\n336\t    const where = near.startsWith('..') ? done.root : (near || '.').split(sep).join('/');\n337\t    const extra = `${done.kept.length > 0 ? `; kept your ${done.kept.join(', ')}` : ''}${done.initialized ? '; git init' : ''}`; // prettier-ignore\n338\t    out(`new-game: made the game \"${done.name}\" in ${where}: the engine at my-3dge@${done.identity.commit.slice(0, 7)} (${done.engineFiles} files, read-only, pinned by ${LOCK_FILE}) and the starter game in labs/game/${extra}`); // prettier-ignore\n339\t    out(`next: ${where === '.' ? '' : `cd ${where} && `}bash scripts/setup.sh && npm test`);\n340\t    out('then: read AGENTS.md and docs/GAME-GUIDE.md, make the game in labs/game/, and commit as you go');\n341\t    return 0;\n342\t  } catch (error) {\n343\t    err(`new-game: ${error instanceof Error ? error.message : String(error)}`);\n344\t    return 1;\n345\t  }\n346\t}\n347\t\n348\tif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) process.exitCode = main();\n349\t"}]},"parent_tool_use_id":null,"session_id":"3b0d0401-1a79-4c2f-8a33-ba9239fdbfed","uuid":"b63f304c-e220-4837-89f2-0db5cf4c674c","timestamp":"2026-11-05T04:20:27.877Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211947__x8ab6bc/work/.research/my-3dge/tools/game/new-game.mjs","content":"#!/usr/bin/env node\n/**\n * @file Makes a game from the my-3dge engine, and moves a game to a newer engine (PLAN.md WP 10.7, ADR-0024): the\n * one command an agent runs to start a game. Plain JavaScript for any Node from 18 with nothing installed, since it\n * runs straight after `git clone`, before setup. What a game gets, and whose each file is, is tools/game/files.mjs.\n *\n * Create: `node <engine>/tools/game/new-game.mjs <dir> [--name <name>]` writes a game into <dir> (made if missing;\n * an empty folder, or a fresh repository's root): the engine's files, copied as they are and pinned by\n * engine-lock.json; the starter game, labs/game/; the game's root files from tools/game/template/ (`TEMPLATES`); and\n * package.json and package-lock.json with the engine's pins (`gamePackage`, `gameLockfile`, from tools/game/files.mjs).\n * Then `git init` when the folder is in no repository. It never overwrites: a README.md or LICENSE already there is\n * kept, a .gitignore gains the lines it lacks, an AGENTS.md, CLAUDE.md or GEMINI.md gets the game's after its own\n * text, and any other file in the way stops it before it writes anything.\n *\n * Update: `node <newer engine>/tools/game/new-game.mjs --update <dir>` (what `node x engine --update` runs) puts this\n * checkout's engine files in place of the game's, removes those it dropped, moves package.json to its pins, brings\n * the root files the game never edited to its templates (`refreshTemplates`) and writes the new lock. Nothing of the\n * game's is replaced or removed: it stops, having written nothing, on an engine file the game changed without\n * declaring it under \"Local engine patches\" in ENGINE-FEEDBACK.md (a declared one is kept), on a file of the game's\n * where the newer engine adds one, and on a package.json entry of the game's that the newer engine sets otherwise\n * (`npmClashes`); `--force` lets the engine's replace them. It names the package.json entries it drops, or sets back\n * where the game had edited the engine's (`npmLost`): the engine's pins win, as its files do.\n *\n * `--verify <dir>` prints `verifyGame` (tools/game/files.mjs) as JSON. Exit codes: 0 done, 1 stopped (the message says\n * why and what to do), 2 a usage error.\n *\n * @example\n * // node /tmp/my-3dge/tools/game/new-game.mjs ../dragon-run → a game in ../dragon-run, named dragon-run\n * // node /tmp/my-3dge/tools/game/new-game.mjs . --name dragon-run → in the current folder (a fresh repository)\n * // node /tmp/my-3dge-new/tools/game/new-game.mjs --update . → the game in . on the newer engine\n * gameName('/tmp/Dragon Run!'); // 'dragon-run'\n * render('# {{name}}', { name: 'dragon-run' }); // '# dragon-run'\n * @see tools/game/new-game.test.ts\n */\nimport { execFileSync } from 'node:child_process';\nimport { copyFileSync, existsSync, mkdirSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';\nimport { basename, dirname, join, relative, resolve, sep } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport {\n  engineIdentity,\n  FEEDBACK_FILE,\n  gameLockfile,\n  gamePackage,\n  hashFile,\n  hashText,\n  LOCK_FILE,\n  lockFor,\n  npmClashes,\n  npmLost,\n  plan,\n  sameDependencies,\n  SOURCE,\n  verifyGame,\n} from './files.mjs';\n\nexport { gameLockfile, gamePackage, npmClashes };\n\n/** The game's root files: template (in tools/game/template/) → where it goes. */\nexport const TEMPLATES = Object.freeze([\n  ['AGENTS.md.tmpl', 'AGENTS.md'],\n  ['CLAUDE.md.tmpl', 'CLAUDE.md'],\n  ['GEMINI.md.tmpl', 'GEMINI.md'],\n  ['README.md.tmpl', 'README.md'],\n  ['ENGINE-FEEDBACK.md.tmpl', FEEDBACK_FILE],\n  ['gitignore.tmpl', '.gitignore'],\n  ['index.html.tmpl', 'index.html'],\n  ['claude-settings.json.tmpl', '.claude/settings.json'],\n]);\n\n/** Files a target may hold: a README.md or LICENSE is kept; a .gitignore gains the template's lines it lacks. */\nconst KEPT = new Set(['README.md', 'LICENSE', '.gitignore', 'AGENTS.md', 'CLAUDE.md', 'GEMINI.md']);\n\n/** Instruction files the agents read: one already there keeps its text, and the game's follows it (`appendOnce`). */\nconst APPENDED = new Set(['AGENTS.md', 'CLAUDE.md', 'GEMINI.md']);\n\n/** A game's name: an npm package name, from the folder's name by default (`Dragon Run!` → `dragon-run`). */\nexport function gameName(target, name) {\n  const folder = basename(resolve(target)).toLowerCase();\n  const chosen = name ?? folder.replace(/[^a-z0-9._-]+/g, '-').replace(/^[-._]+|[-._]+$/g, '');\n  if (!/^[a-z0-9][a-z0-9._-]{0,213}$/.test(chosen)) {\n    throw new Error(`\"${chosen}\" cannot name a game: give --name with lower-case letters, digits, '-', '.' or '_'`);\n  }\n  return chosen;\n}\n\n/** Fills a template's `{{name}}` and `{{engine.*}}`; any other placeholder is an error. */\nexport function render(text, values) {\n  return text.replace(/\\{\\{([a-z.]+)\\}\\}/g, (whole, key) => {\n    if (key in values) return values[key];\n    throw new Error(`the template's ${whole} has no value: new-game.mjs fills ${Object.keys(values).join(', ')}`);\n  });\n}\n\n/** The values of the templates' placeholders for the game `game` on the engine `identity`. */\nfunction templateValues(game, identity) {\n  return {\n    name: game,\n    'engine.repository': identity.repository,\n    'engine.commit': identity.commit,\n    'engine.short': identity.commit.slice(0, 7),\n    'engine.date': identity.date,\n  };\n}\n\n/** A template's text in the engine at `source`. */\nconst templateText = (source, template) => readFileSync(join(source, 'tools/game/template', template), 'utf8');\n\n/** Reads a JSON file. */\nconst readJson = (file) => JSON.parse(readFileSync(file, 'utf8'));\n\n/** Writes JSON with two spaces and a final newline (what Prettier keeps). */\nfunction writeJson(file, value) {\n  mkdirSync(dirname(file), { recursive: true });\n  writeFileSync(file, `${JSON.stringify(value, null, 2)}\\n`);\n}\n\n/** What writing `to` under `root` meets, if anything: the file itself, or a file where one of its folders goes. */\nfunction inTheWay(root, to) {\n  const parts = to.split('/');\n  for (let i = 1; i <= parts.length; i++) {\n    const path = join(root, ...parts.slice(0, i));\n    if (existsSync(path) && (i === parts.length || !statSync(path).isDirectory())) return path;\n  }\n  return undefined;\n}\n\n/** Copies one file, making its folder. */\nfunction copyInto(source, from, root, to) {\n  mkdirSync(dirname(join(root, to)), { recursive: true });\n  copyFileSync(join(source, from), join(root, to));\n}\n\n/** Makes a game in `target` from the engine at `source`; on a clash it throws, having written nothing. */\nexport function createGame({ target, name, source = SOURCE, git = true }) {\n  const root = resolve(target);\n  if (existsSync(root) && !statSync(root).isDirectory()) throw new Error(`${root} is a file: name a folder`);\n  const game = gameName(root, name);\n  const identity = engineIdentity(source);\n  const items = plan(source);\n  const writes = [\n    ...items.map((item) => item.to),\n    ...TEMPLATES.map(([, to]) => to),\n    'package.json',\n    'package-lock.json',\n  ];\n  const clashes = [...writes, LOCK_FILE].filter((to) => !KEPT.has(to) && inTheWay(root, to));\n  if (clashes.length > 0) {\n    const named = clashes.slice(0, 5).join(', ') + (clashes.length > 5 ? ` and ${clashes.length - 5} more` : '');\n    throw new Error(\n      `${root} already holds ${named}: make the game in an empty folder or a fresh repository's root (a README.md, ` +\n        'LICENSE or .gitignore may be there), or move a game to a newer engine with --update',\n    );\n  }\n  for (const { from, to } of items) copyInto(source, from, root, to);\n  const values = templateValues(game, identity);\n  const kept = [];\n  const templates = {};\n  for (const [template, to] of TEMPLATES) {\n    const text = render(templateText(source, template), values);\n    const file = join(root, to);\n    templates[to] = existsSync(file) ? null : hashText(text);\n    if (to === '.gitignore' && existsSync(file)) mergeLines(file, text);\n    else if (APPENDED.has(to) && existsSync(file)) appendOnce(file, text);\n    else if (existsSync(file)) kept.push(to);\n    else {\n      mkdirSync(dirname(file), { recursive: true });\n      writeFileSync(file, text);\n    }\n  }\n  const engine = readJson(join(source, 'package.json'));\n  writeJson(join(root, 'package.json'), gamePackage(engine, game));\n  writeJson(join(root, 'package-lock.json'), gameLockfile(readJson(join(source, 'package-lock.json')), game));\n  const engineItems = items.filter((item) => item.owner === 'engine');\n  writeJson(join(root, LOCK_FILE), lockFor(source, engineItems, identity, game, engine, templates));\n  const initialized = git && initRepository(root);\n  const starterFiles = items.length - engineItems.length;\n  return { root, name: game, identity, engineFiles: engineItems.length, starterFiles, kept, initialized };\n}\n\n/**\n * Moves the game in `target` to the engine at `source`; returns what changed. Throws, having written nothing, on\n * anything of the game's the update would replace (the file comment says what), unless `force`.\n */\nexport function updateGame({ target, source = SOURCE, force = false }) {\n  const root = resolve(target);\n  const before = verifyGame(root);\n  if (before.undeclared.length > 0 && !force) throw new Error(undeclaredMessage(before));\n  const patched = [...before.changed, ...before.missing, ...before.added];\n  const keep = new Set(force ? [] : before.declared.filter((path) => patched.includes(path)));\n  const identity = engineIdentity(source);\n  const items = plan(source).filter((item) => item.owner === 'engine');\n  const old = before.lock.files;\n  const added = items.filter((item) => !(item.to in old)).map((item) => item.to);\n  const blocked = added.filter((path) => !keep.has(path) && inTheWay(root, path));\n  const engine = readJson(join(source, 'package.json'));\n  const previous = readJson(join(root, 'package.json'));\n  const clashes = npmClashes(previous, engine, before.lock.npm);\n  if (blocked.length + clashes.length > 0 && !force) throw new Error(clashMessage(blocked, clashes));\n  const next = new Set(items.map((item) => item.to));\n  const removed = Object.keys(old).filter((path) => !next.has(path) && !keep.has(path));\n  for (const path of removed) rmSync(join(root, path), { force: true });\n  for (const way of blocked.map((path) => inTheWay(root, path))) if (way) rmSync(way, { recursive: true, force: true });\n  const replaced = items\n    .filter((item) => item.to in old && !keep.has(item.to) && old[item.to] !== hashFile(join(source, item.from)))\n    .map((item) => item.to);\n  for (const { from, to } of items) if (!keep.has(to)) copyInto(source, from, root, to);\n  const pkg = gamePackage(engine, previous.name, previous, before.lock.npm);\n  writeJson(join(root, 'package.json'), pkg);\n  const npm = npmLost(previous, pkg, before.lock.npm);\n  const lockfileFits = sameDependencies(pkg, engine);\n  if (lockfileFits) {\n    writeJson(join(root, 'package-lock.json'), gameLockfile(readJson(join(source, 'package-lock.json')), pkg.name));\n  }\n  const { templates, refreshed, diverged } = refreshTemplates(root, source, before.lock, identity);\n  writeJson(join(root, LOCK_FILE), lockFor(source, items, identity, before.lock.game, engine, templates));\n  const forced = [...blocked, ...clashes];\n  return { root, from: before.lock.engine, to: identity, added, removed, replaced, kept: [...keep], forced, npm, refreshed, diverged, lockfileFits }; // prettier-ignore\n}\n\n/** Why an update stops on engine files the game changed or added without declaring them, with the fixes. */\nfunction undeclaredMessage({ undeclared, added }) {\n  const declare = `list it under \"Local engine patches\" in ${FEEDBACK_FILE} to keep it`;\n  const edited = undeclared.filter((path) => !added.includes(path));\n  const own = undeclared.filter((path) => added.includes(path));\n  return [\n    edited.length > 0 &&\n      `the game changed engine files it does not declare: ${edited.join(', ')}. Undo each (git checkout -- <path>), ${declare}, or pass --force to replace it`, // prettier-ignore\n    own.length > 0 &&\n      `the game added files in the engine's folders: ${own.join(', ')}. Move each into labs/game/ (or delete it), or ${declare}`, // prettier-ignore\n  ]\n    .filter(Boolean)\n    .join('; ');\n}\n\n/** Why an update stops on the game's own files and package.json entries where the newer engine has its own. */\nfunction clashMessage(blocked, clashes) {\n  const parts = [\n    blocked.length > 0 &&\n      `the newer engine adds ${blocked.join(', ')}, where the game has files of its own: move or rename them`,\n    clashes.length > 0 &&\n      `the newer engine sets ${clashes.join(', ')} in package.json, where the game has its own: rename the game's (a script), or drop it (a dependency: the engine's pin then serves)`, // prettier-ignore\n  ];\n  return `${parts.filter(Boolean).join('; ')}; or pass --force to let the engine's replace them`;\n}\n\n/**\n * Brings the game's root files to the templates of the engine at `source` (`lock` is the game's, `identity` the new\n * engine's). A file the game never edited (its hash is the lock's) gets the new template; one it edited is named when\n * its template changed, to compare by hand; one it removed, or had before new-game.mjs, stays as it is; a template new\n * to the game is written where no file is. Returns the lock's new `templates` and the paths refreshed and named.\n */\nfunction refreshTemplates(root, source, lock, identity) {\n  const was = lock.templates ?? {};\n  const [then, now] = [templateValues(lock.game, lock.engine), templateValues(lock.game, identity)];\n  const templates = {};\n  const refreshed = [];\n  const diverged = [];\n  for (const [template, to] of TEMPLATES) {\n    const file = join(root, to);\n    const text = templateText(source, template);\n    const fresh = render(text, now);\n    templates[to] = hashText(fresh);\n    if (!(to in was) && !existsSync(file)) {\n      mkdirSync(dirname(file), { recursive: true });\n      writeFileSync(file, fresh);\n      refreshed.push(to);\n    } else if (!(to in was) || was[to] === null || !existsSync(file)) templates[to] = null;\n    else if (hashFile(file) !== was[to]) {\n      if (hashText(render(text, then)) !== was[to]) diverged.push(to);\n    } else if (templates[to] !== was[to]) {\n      writeFileSync(file, fresh);\n      refreshed.push(to);\n    }\n  }\n  return { templates, refreshed, diverged };\n}\n\n/** Appends `text` after a file's own, once: a repository's instructions stay first, and the game's follow them. */\nfunction appendOnce(file, text) {\n  const had = readFileSync(file, 'utf8');\n  if (!had.includes(text.trim())) writeFileSync(file, `${had.replace(/\\n*$/, '\\n\\n')}${text}`);\n}\n\n/** Appends the template's lines a file lacks. */\nfunction mergeLines(file, text) {\n  const had = readFileSync(file, 'utf8');\n  const have = new Set(had.split('\\n'));\n  const lacking = text.split('\\n').filter((line) => line.trim() && !line.startsWith('#') && !have.has(line));\n  if (lacking.length > 0) writeFileSync(file, `${had.replace(/\\n?$/, '\\n')}${lacking.join('\\n')}\\n`);\n}\n\n/** Runs `git init` when `root` is in no repository and git is there; returns whether it did. */\nfunction initRepository(root) {\n  try {\n    execFileSync('git', ['-C', root, 'rev-parse', '--is-inside-work-tree'], { stdio: 'ignore' });\n    return false;\n  } catch {\n    try {\n      execFileSync('git', ['init', '--quiet', root], { stdio: 'ignore' });\n      return true;\n    } catch {\n      return false;\n    }\n  }\n}\n\n/** The command line; returns the exit code. */\nexport function main(argv = process.argv.slice(2), out = console.log, err = console.error) {\n  const usage = 'usage: node tools/game/new-game.mjs <dir> [--name <name>] | --update <dir> [--force] | --verify <dir>';\n  const named = argv.indexOf('--name');\n  const flags = argv.filter((arg) => arg.startsWith('--'));\n  const positional = argv.filter((arg, i) => !arg.startsWith('--') && (named < 0 || i !== named + 1));\n  const unknown = flags.find((flag) => !['--name', '--update', '--force', '--verify', '--help'].includes(flag));\n  if (flags.includes('--help')) return (out(usage), 0);\n  if (unknown || positional.length !== 1 || (named >= 0 && !argv[named + 1])) {\n    return (err(`new-game: ${unknown ? `unknown flag ${unknown}` : 'name one folder'}\\n${usage}`), 2);\n  }\n  const [target] = positional;\n  try {\n    if (flags.includes('--verify')) return (out(JSON.stringify(verifyGame(target), null, 2)), 0);\n    if (flags.includes('--update')) {\n      const done = updateGame({ target, force: flags.includes('--force') });\n      const patches = done.kept.length > 0 ? `, the local patches kept (${done.kept.join(', ')})` : '';\n      const counts = `${done.replaced.length} engine files changed, ${done.added.length} added, ${done.removed.length} removed`; // prettier-ignore\n      out(`new-game: moved from my-3dge@${done.from.commit.slice(0, 7)} to my-3dge@${done.to.commit.slice(0, 7)}: ${counts}${patches}`); // prettier-ignore\n      if (done.forced.length > 0) out(`replaced the game's own (--force): ${done.forced.join(', ')}`);\n      if (done.npm.length > 0) out(`package.json: the engine's entries win, so these went or are the engine's again: ${done.npm.join(', ')}; put back what the game needs under a name of its own`); // prettier-ignore\n      if (done.refreshed.length > 0) out(`root files brought to the engine's templates: ${done.refreshed.join(', ')}`);\n      const template = (to) => `${to} (tools/game/template/${TEMPLATES.find(([, path]) => path === to)[0]})`;\n      if (done.diverged.length > 0) out(`the engine's templates changed for root files the game edited: compare ${done.diverged.map(template).join(', ')} and take what applies`); // prettier-ignore\n      out(`next: ${done.lockfileFits ? 'npm ci' : 'npm install (the game has dependencies of its own)'}, then npm run check && npm test`); // prettier-ignore\n      return 0;\n    }\n    const done = createGame({ target, name: named >= 0 ? argv[named + 1] : undefined });\n    const near = relative(process.cwd(), done.root);\n    const where = near.startsWith('..') ? done.root : (near || '.').split(sep).join('/');\n    const extra = `${done.kept.length > 0 ? `; kept your ${done.kept.join(', ')}` : ''}${done.initialized ? '; git init' : ''}`; // prettier-ignore\n    out(`new-game: made the game \"${done.name}\" in ${where}: the engine at my-3dge@${done.identity.commit.slice(0, 7)} (${done.engineFiles} files, read-only, pinned by ${LOCK_FILE}) and the starter game in labs/game/${extra}`); // prettier-ignore\n    out(`next: ${where === '.' ? '' : `cd ${where} && `}bash scripts/setup.sh && npm test`);\n    out('then: read AGENTS.md and docs/GAME-GUIDE.md, make the game in labs/game/, and commit as you go');\n    return 0;\n  } catch (error) {\n    err(`new-game: ${error instanceof Error ? error.message : String(error)}`);\n    return 1;\n  }\n}\n\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) process.exitCode = main();\n","numLines":349,"startLine":1,"totalLines":349}},"tool_result_meta":[{"id":"toolu_01Ayj6fwufAjeBqN6y4tSkyY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
