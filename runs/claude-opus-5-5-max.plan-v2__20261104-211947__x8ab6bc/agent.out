{ char: b.floor, description: `${b.name} floor`, mesh: `${b.name}Floor` });\n}\ndefineGlyph('glyph:rock', { char: 'X', description: 'Undrawn solid rock', top: 3, solid: true, collider: 'box', nav: { walkable: false }, full: true }); // prettier-ignore\n\nfunction mulberry(a: number) {\n  return () => {\n    a = (a + 0x6d2b79f5) >>> 0;\n    let t = a;\n    t = Math.imul(t ^ (t >>> 15), t | 1);\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\n/** The world's text: `plots`×`plots` plots of `plot` tiles, each a biome of rooms and corridors. */\nexport function makeWorldText(seed: number, plot = 100, plots = 3): string {\n  const size = plot * plots;\n  const r = mulberry(seed >>> 0);\n  const grid = Array.from({ length: size }, () => new Array<string>(size).fill('X'));\n  let spawn: [number, number] | null = null;\n  for (let py = 0; py < plots; py++) {\n    for (let px = 0; px < plots; px++) {\n      const b = BIOMES[(px + py * plots) % BIOMES.length];\n      const rooms: [number, number, number, number][] = [];\n      for (let k = 0; k < 14; k++) {\n        const w = 7 + Math.floor(r() * 12);\n        const h = 7 + Math.floor(r() * 12);\n        const x = px * plot + 2 + Math.floor(r() * (plot - w - 4));\n        const y = py * plot + 2 + Math.floor(r() * (plot - h - 4));\n        rooms.push([x, y, w, h]);\n        for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) grid[j][i] = b.floor;\n      }\n      for (let k = 1; k < rooms.length; k++) {\n        const [ax, ay, aw, ah] = rooms[k - 1];\n        const [bx, by, bw, bh] = rooms[k];\n        const [cx, cy, dx, dy] = [ax + (aw >> 1), ay + (ah >> 1), bx + (bw >> 1), by + (bh >> 1)];\n        for (let i = Math.min(cx, dx); i <= Math.max(cx, dx); i++) for (let w = -1; w <= 2; w++) grid[cy + w][i] = b.floor;\n        for (let j = Math.min(cy, dy); j <= Math.max(cy, dy); j++) for (let w = -1; w <= 2; w++) grid[j][dx + w] = b.floor;\n      }\n      if (!spawn) spawn = [rooms[0][0] + (rooms[0][2] >> 1), rooms[0][1] + (rooms[0][3] >> 1)];\n      for (let y = py * plot; y < (py + 1) * plot; y++) {\n        for (let x = px * plot; x < (px + 1) * plot; x++) {\n          if (grid[y][x] !== 'X') continue;\n          let near = false;\n          for (let j = -1; j <= 1 && !near; j++) {\n            for (let i = -1; i <= 1 && !near; i++) {\n              const c = grid[y + j]?.[x + i];\n              if (c && c !== 'X' && c !== b.wall && 'cnah'.includes(c)) near = true;\n            }\n          }\n          if (near) grid[y][x] = b.wall;\n        }\n      }\n    }\n  }\n  grid[spawn![1]][spawn![0]] = '@';\n  return `---\\ndescription: Prototype world.\\n---\\n${grid.map((row) => row.join('')).join('\\n')}\\n`;\n}\n\nexport const WORLD_SETTINGS = defineSettings({\n  'game.actors': { type: 'integer', default: 0, minimum: 0, maximum: 400, when: 'scene', description: 'Foes as actors.' },\n  'game.seat': { type: 'integer', default: 0, minimum: -1, maximum: 3, when: 'scene', description: 'This copy’s seat; -1: none.' }, // prettier-ignore\n  'game.seats': { type: 'integer', default: 1, minimum: 1, maximum: 4, when: 'scene', description: 'How many heroes.' },\n});\n\ndefineComponent('hero', {\n  description: 'A seat’s hero.',\n  fields: {\n    seat: { type: 'integer', default: 0, description: 'Its seat.' },\n    score: { type: 'integer', default: 0, description: 'Commands seen.' },\n  },\n});\ndefineComponent('foe', {\n  description: 'A foe.',\n  fields: { speed: { type: 'number', default: 2, unit: 'm/s', description: 'Speed.' } },\n});\n\ntype Cmd = { m?: [number, number]; a?: number };\n\nfunction drive(w: World, intents: Record<string, unknown>): void {\n  const seats = (intents['game:seats'] ?? []) as Cmd[];\n  for (const e of w.query('hero', 'actor') as unknown as { hero: { seat: number; score: number }; actor: { player: boolean; intents: { move?: [number, number] } } }[]) { // prettier-ignore\n    const cmd = seats[e.hero.seat] ?? {};\n    if (cmd.a) e.hero.score += 1;\n    if (!e.actor.player) e.actor.intents = cmd.m ? { move: cmd.m } : {};\n  }\n}\n\nfunction chase(w: World): void {\n  const heroes = w.query('hero', 'actor') as unknown as { actor: { x: number; z: number } }[];\n  if (!heroes.length) return;\n  for (const f of w.query('foe', 'actor') as unknown as { foe: { speed: number }; actor: { x: number; z: number; intents: { move?: [number, number] } } }[]) { // prettier-ignore\n    let best = heroes[0].actor;\n    let dist = Infinity;\n    for (const h of heroes) {\n      const d = Math.hypot(h.actor.x - f.actor.x, h.actor.z - f.actor.z);\n      if (d < dist) [best, dist] = [h.actor, d];\n    }\n    const [dx, dz] = [best.x - f.actor.x, best.z - f.actor.z];\n    const len = Math.hypot(dx, dz) || 1;\n    f.actor.intents = dist > 1.2 ? { move: [(dx / len) * 0.6, (dz / len) * 0.6] } : {};\n  }\n}\n\nexport const world = defineScene<Record<string, never>>('game:world', {\n  description: 'Prototype: a generated world in one level.',\n  level: 'level:world',\n  physics: true,\n  setup(w0) {\n    const w = w0 as unknown as World;\n    const level = compileLevel(makeWorldText(w.seed), { file: 'world', name: 'world' });\n    addLevelBodies(physicsOf(w), level);\n    const [sx, sy, sz] = level.spawns.find((s) => s.name === 'hero')!.position;\n    const seats = w.settings.get<number>('game.seats');\n    const mine = w.settings.get<number>('game.seat');\n    for (let seat = 0; seat < seats; seat++) {\n      const character = createCharacter({ speed: 6 });\n      spawnActor(w, { at: [sx + seat, sy, sz], character, player: seat === mine, anim: { build: 'build:heroic', weapon: 'none' }, components: { hero: { seat } } } as never); // prettier-ignore\n    }\n    const n = w.settings.get<number>('game.actors');\n    const rng = w.rng('foes');\n    for (let k = 0; k < n; k++) {\n      const a = rng.range(0, Math.PI * 2);\n      const r = rng.range(3, 6);\n      const character = createCharacter({ speed: 3 });\n      const id = spawnActor(w, { at: [sx + Math.cos(a) * r, sy, sz + Math.sin(a) * r], character, player: false, anim: { build: 'build:skeleton', weapon: 'none' } }); // prettier-ignore\n      w.add(id, 'foe' as never, {} as never);\n    }\n    w.systems.add('game.chase', chase, { phase: 'ai' });\n  },\n  step(w0, intents) {\n    drive(w0 as unknown as World, intents as unknown as Record<string, unknown>);\n  },\n});\nEOF\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211947__x8ab6bc/work/.research/proto && grep -n \"components\\|export interface ActorSpec\" -A3 engine/sim/actors.ts | sed -n 1,30p | cut -c1-150; grep -n \"seed\" engine/sim/world.ts | head -5 | cut -c1-140; (time node x sim labs/game/scenes/world.ts --steps 60 --set game.actors=0 2>&1 | tail -15 | cut -c1-220)","description":"Write the throwaway world scene and run it headless","timeout":180000}}}
