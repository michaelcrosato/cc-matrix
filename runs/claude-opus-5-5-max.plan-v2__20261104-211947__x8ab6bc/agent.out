ever);\n\"\"\",\"\"\"    void me;\n    inspector.step(1, { 'game:seats': seats } as never);\n\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > scripts-proto/follow.py <<'EOF'\nimport sys, time, json\nfrom playwright.sync_api import sync_playwright\nurl = sys.argv[1]\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n    pg = b.new_page(viewport={'width':640,'height':360})\n    pg.goto(url)\n    for i in range(240):\n        if pg.evaluate(\"window.__engine && window.__engine.ready === true\"): break\n        time.sleep(0.5)\n    pg.evaluate(\"window.__engine.pause()\")\n    a = json.loads(pg.evaluate(\"JSON.stringify(window.__engine.camera.get().pose.position)\"))\n    pg.evaluate(\"window.__engine.step(120,{move:[1,0]})\")\n    pg.evaluate(\"window.__engine.render(10)\")\n    time.sleep(0.5)\n    c = json.loads(pg.evaluate(\"JSON.stringify(window.__engine.camera.get().pose.position)\"))\n    e = json.loads(pg.evaluate(\"JSON.stringify(window.__engine.state('hero').entities.filter(e=>e.hero).map(e=>[e.hero.seat,e.actor.player,e.actor.x,e.actor.z]))\"))\n    print('camera before', a, 'after', c, 'hero', e, 'errors', pg.evaluate(\"JSON.stringify(window.__engine.errors).slice(0,300)\"), flush=True)\n    b.close()\nEOF\nnode scripts-proto/one-file.mjs 2>&1 | tail -1 | cut -c1-90; F=\"file://$PWD/out/game.html\"; timeout 100 python3 -u scripts-proto/follow.py \"$F?game.actors=0\" 2>&1 </dev/null | cut -c1-500 | tail -3; (timeout 200 python3 -u scripts-proto/hub.py game.html \"players=3&latency=150&jitter=50&loss=5&play=45000\" > out/hub3.log 2>&1 </dev/null; cut -c1-1800 out/hub3.log | grep -E \"^PASS|^FAIL|^BAD|^done|^\\[|^logs\")","description":"Test heroes always moving via own intents with the camera following the local one","timeout":330000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":