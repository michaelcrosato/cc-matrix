anvases, queue submits, lost devices); it is measured, never reported by the page. `__gpuIdle()` resolves once\n11- * every queue the page submitted to has finished its work (the e2e harness waits on it at each test's end).\n12- *\n13- * @example\n14- * import { chromium } from '@playwright/test';\n15- * const browser = await chromium.launch(launchOptions());\n16- * const page = await browser.newPage({ viewport: VIEWPORT });\n17- * const watch = await preparePage(page, { seed: 1 }); // the virtual clock and the console, before the first goto\n18- * await browser.close();\n19- * @see tests/e2e/harness.spec.ts\n20- */\n21-/// <reference types=\"@webgpu/types\" />\n--\n30:export const WEBGPU_FLAGS: readonly string[] = [\n31-  '--enable-unsafe-webgpu',\n32-  '--enable-features=Vulkan',\n33-  '--use-vulkan=swiftshader',\n34-  '--use-angle=swiftshader',\n35-];\n36-\n37-/** The container's Chromium (153 since 2026-10-22); `$CHROMIUM_PATH` overrides it. Nothing runs `playwright install`. */\n38-export const DEFAULT_CHROMIUM = '/opt/pw-browsers/chromium';\n39-\n40-/** The platform's Chromium release (tools/deps.json), which scripts/setup.sh fetches where the container's is absent. */\n41-export const CHROMIUM_VERSION = '153.0.8010.12';\n42-\n43-/** Where scripts/setup.sh keeps Chrome for Testing `CHROMIUM_VERSION` on a machine without `DEFAULT_CHROMIUM`. */\n44-export function cachedChromium(env: Record<string, string | undefined> = process.env): string {\n--\n68:  return { executablePath: chromiumPath(env), args: [...WEBGPU_FLAGS] };\n69-}\n70-\n71-/** Launches the platform's Chromium with WebGPU, for `x` commands that open pages. */\n72-export function launchBrowser(): Promise<Browser> {\n73-  return chromium.launch(launchOptions());\n74-}\n75-\nTerminated                 timeout 60 node x shot labs/game 2>&1 | sed -e 's/\\x1b\\[[0-9;]*m//g' | cut -c1-220 | head -40\nXDG_RUNTIME_DIR=/run/user/1000\nXDG_DATA_DIRS=/usr/local/share:/usr/share:/var/lib/snapd/desktop","stderr":