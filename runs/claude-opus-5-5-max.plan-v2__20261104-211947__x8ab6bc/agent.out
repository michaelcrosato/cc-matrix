',\n  hips: 'Hands on the hips.',\n  block: 'The weapon upright across the body, both hands on it.',\n  die: 'A stagger, the knees give, then the body topples onto its back and stays down.',\n  down: 'Knocked flat onto the back; it gets up when the pose ends.',\n} as const;\n\n/** A pose's name. */\nexport type PoseName = keyof typeof POSES;\n\n/** The stances, held while moving. */\nexport const STANCES = {\n  guard: 'Fists up while moving.',\n  ready: 'The weapon held forward in both hands (with a weapon).',\n} as const;\n70:export const BODY_STATES = {\n71-  position: 'vector',\n72-  velocity: 'vector',\n73-  yaw: 'number',\n74-  run: 'number',\n75-  dash: 'boolean',\n76-  hurt: 'boolean',\n77-  air: 'boolean',\n78-  climb: 'boolean',\n79-  point: 'boolean',\n80-  aim: 'number',\n81-  pose: 'name',\n82-  stance: 'name',\n83-  down: 'number',\n84-  body: 'object',\n85-  trail: 'trail',\n86-} as const satisfies { readonly [K in keyof Required<AnimatorInput>]: StateKind };\n87-\n88-/** A body state's name. */\n89-export type BodyStateName = keyof typeof BODY_STATES;\n90-\n91-/** What a kind's value must be, as a message says it. */\n92-const EXPECTED: Readonly<Record<StateKind, string>> = {\n93-  number: 'a finite number',\n94-  boolean: 'true or false',\n95-  vector: 'a Vector3',\n96-  object: 'an object',\n97-  name: 'a name',\n98-  trail: `one of ${Object.keys(TRAILS).join(', ')}`,\n99-};\n100-\n101-/** Whether `value` is of kind `kind`. */\n102-function fits(kind: StateKind, value: unknown): boolean {\n103-  switch (kind) {\n104-    case 'number':\n105-      // Stryker disable next-line ConditionalExpression: Number.isFinite is false for anything but a fini\n106-      return typeof value === 'number' && Number.isFinite(value);\n107-    case 'boolean':\n108-      return typeof value === 'boolean';\n109-    case 'vector':\n110-      return value instanceof Vector3 && [value.x, value.y, value.z].every(Number.isFinite);\n/**\n * @file Crowd bodies (PLAN.md WP 5.1, §4.7; doctrines: Common ground, Reproducible, Quality under the hood): a crowd\n * of dynamic bodies driven by the velocities its AI wants, so the solver resolves the crowd and no separation code is\n * needed. Scenes keep each agent in a component (`CROWD_AGENT_FIELDS`), call these from systems, and never meet\n * Rapier; fixtures/scenes/crowd-1000 is the worked example (1,000 agents pushing toward a point).\n *\n * - **Agents**: capsules or balls (a `flyer` hovers) of `CROWD_MATERIAL`, rotations locked, sliding on everything.\n * - **Queues**: spawn an entity with the component `queued`, its feet at `x`, `y`, `z`; set `state = 'leaving'` to\n *   take it out. `updateCrowd` applies both in list (id) order, adding at most `spawnLimit` bodies a step.\n * - **Intents**: `setVelocity` with an acceleration limit, on the feet only; `knockback` (momentum), `launch`.\n * - **Corpses**: `killAgent` moves an agent to the group `corpse`; `updateCrowd` brakes it and removes it on time.\n * - **Readback**: `updateCrowd`, after the physics step, copies feet and velocity and decides `grounded`.\n * - **Wake and sleep**: still bodies sleep (Rapier 0.21: after about half a second, measured); `setVelocity` keeps\n *   a sleeping agent asleep while it wants to stay still. The lost-body rescue is `rescueLost` (physics/rescue.ts).","is_error":false}]},"parent_tool_use_id":null,"session_id":"3b0d0401-1a79-4c2f-8a33-ba9239fdbfed","uuid":"b233e09a-a03e-4d91-8d97-ff0615009ac6","timestamp":"2026-11-05T05:05:32.939Z","tool_use_result":{"stdout":"10\ncmu\nmesh2motion\nquaternius\nstyle100\nstyle100_back\nstyle100_backrun\nstyle100_idle\nstyle100_run\nstyle100_side\nstyle100_siderun\n8.8M\nx anim: ok: 10 clips and 0 CMU takes match\nquaternius/Sword_Attack  1.533s once  sword attack — stepping one-handed slash, in place\nquaternius/Sword_Attack_RM  1.533s once  sword attack root-motion — stepping one-handed slash that travels\nquaternius/Sword_Dash  1.567s once  sword attack dodge — dashes forw