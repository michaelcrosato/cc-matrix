{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QjXyPYKkXcRNUk1UbyYMdk","type":"tool_result","content":"> extends HeadlessOptions<C, E> {\n  drawing?: Drawing;\n  materials?: MaterialLibrary;\n}\n\n/** The run behind each headless engine, for tools that need more than the members. */\nconst hosts = new WeakMap<object, InspectorHost>();\n\n/** The settings of `session` that differ from a fresh start of its scene: what a restart keeps. */\nfunction changedSettings(session: Session, registry: Registry): Record<string, SettingValue> {\n  const fresh = createSettings({ registry });\n  fresh.override(session.scene.settings, 'fresh');\n  const now = session.settings.values();\n  const changed = Object.keys(now).filter((path) => !sameValue(now[path], fresh.get(path)));\n  return Object.fromEntries(changed.map((path) => [path, now[path]]));\n}\n\n/** Of the settings a restart keeps, those marked view: what a replay's run keeps, since none of them changes play. */\nfunction changedViewSettings(session: Session, registry: Registry): Record<string, SettingValue> {\n  const changed = Object.entries(changedSettings(session, registry));\n  return Object.fromEntries(changed.filter(([path]) => registry.get('setting', path).view === true));\n}\n\n/** Makes the run behind an engine (see the file comment). Throws as `createHeadless` does, and `APP_NO_LEVEL`. */\nexport function createAppHost<C extends object = AnyComponents, E extends EventMap = EventMap>(\n  options: AppHostOptions<C, E>,\n): AppRun {\n  const firstSeed = checkSeed(options.seed, 'createHeadless({ seed })');\n  const registry = options.registry ?? sharedRegistry;\n  const firstScene =\n    typeof options.scene === 'string' ? getScene(options.scene, registry) : (options.scene as unknown as Scene);\n  const timed = registry.kinds().includes('setting') && registry.has('setting', 'time.hz');\n  if (!timed) defineSettings(TIME_SETTINGS, registry); // the clock reads them: a test registry may lack them\n  const { drawing } = options;\n  const meter = createStatsMeter({ counts: () => drawing?.counts() ?? null });\n  // Members get `recordedRun(session)`, except that a restore or a dev action moves entities between steps, so the\n  // view then snaps to the world as it is (no interpolation from the places it had), as it does after a restart.\n  const followed = (session: Session): RecordedRun => {\n    const recorded = recordedRun(session);\n    const snapping = <A extends unknown[]>(change: (...args: A) => void) => ({\n      enumerable: true,\n      value: (...args: A) => {\n        change(...args);\n        view?.restarted();\n      },\n    });\n    return Object.freeze(\n      Object.defineProperties(\n        {},\n        {\n          ...Object.getOwnPropertyDescriptors(recorded),\n          restore: snapping(recorded.restore),\n          act: snapping(recorded.act),\n        },\n      ),\n    ) as RecordedRun;\n  };\n  const start = (scene: Scene, seed: number, settings: Readonly<Record<string, unknown>> | undefined) => {\n    const session = createSession(scene, { seed, settings, registry, log: options.log, probe: meter.probe });\n    const clock = createClock({ settings: session.settings, log: options.log });\n    return { session, recorded: followed(session), clock };\n  };\n  let run: { session: Session; recorded: RecordedRun; clock: Clock } = start(firstScene, firstSeed, options.settings);\n  let playing = false;\n  const wantView = options.view === true || drawing !== undefined;\n  const view = wantView\n    ? createRunView({\n        run: () => run.session,\n        registry,\n        materials: options.materials ?? createMaterialLibrary({ registry }),\n        cam: options.cam,\n        log: options.log,\n      })\n    : null;\n  const restart = (scene: Scene, seed: number, settings: Readonly<Record<string, unknown>> | undefined) => {\n    if (view && scene.id !== run.session.scene.id) {\n      throw codeError('APP_OTHER_SCENE', { shown: run.session.scene.id, scene: scene.id });\n    }\n    run = start(scene, seed, settings);\n    view?.restarted();\n  };\n  const begin = (replay: Replay) => {\n    // The replay holds the run's play; the page keeps its view (its look, quality, resolution, speed…), none of which\n    // changes play, so a replay neither changes the picture nor makes the renderer warm up again.\n    const settings = { ...changedViewSettings(run.session, registry), ...replay.settings };\n    restart(getScene(replay.scene, registry), replay.seed, settings);\n    return run.session;\n  };\n  // After a step of the run's: the clock gets the hit-stop the step's rules asked for, and the view reads the world.\n  const stepped = () => {\n    const stop = takeHitStop(run.session.world);\n    if (stop > 0) run.clock.hitStop(stop);\n    view?.stepped();\n  };\n  const stepOnce = (intents: unknown) => {\n    meter.time('sim', () => run.session.step(intents));\n    stepped();\n  };\n  const host: AppHost = {\n    registry,\n    members: sharedRegistry,\n    log: options.log ?? sharedLog,\n    get clock() {\n      return run.clock;\n    },\n    get session() {\n      return run.recorded;\n    },\n    runtime: typeof window === 'undefined' ? 'node' : 'browser',\n    get renderer() {\n      return drawing?.active() ?? false;\n    },\n    get adapter() {\n      return drawing?.adapter ?? null;\n    },\n    get features() {\n      return drawing?.features ?? [];\n    },\n    get downgrades() {\n      return drawing?.downgrades ?? [];\n    },\n    get ready() {\n      return drawing ? drawing.ready() : true;\n    },\n    view,\n    meter,\n    step(n, intents) {\n      if (intents === undefined) {\n        // No intents: what the virtual device holds (`__engine.input`), taken each step as the page's input is.\n        const device = virtualDeviceOf(host);\n        for (let k = 0; k < n; k++) stepOnce(virtualIntents(device.take()));\n        return;\n      }\n      const script = Array.isArray(intents) ? intents : undefined;\n      const later = isPlainObject(intents) ? { ...intents, p: undefined } : intents;\n      for (let k = 0; k < n; k++) stepOnce(script ? (script[k] ?? {}) : k === 0 ? intents : later);\n    },\n    restart(next) {\n      restart(run.session.scene, next, changedSettings(run.session, registry));\n    },\n    render: (frames) => drawing!.render(frames),\n    shot: (shotOptions) => drawing!.shot(shotOptions),\n    async replay(text: string, playOptions: PlayIntoOptions): Promise<PlayResult> {\n      playing = true;\n      try {\n        return await playInto(\n          {\n            registry,\n            begin,\n            stepped: () => view?.stepped(),\n            draw: drawing && (() => drawing.draw()),\n            carry: drawing && view ? () => view.carry() : undefined,\n            camera: view ? (code, blend) => void view.setCamera(code, { blend }) : undefined,\n            setView: (path, value) => (drawing ? drawing.setView(path, value) : run.session.set(path, value)),\n            shoot: drawing && ((shotOptions) => drawing.shot(shotOptions)),\n          },\n          text,\n          playOptions,\n        );\n      } finally {\n        playing = false;\n        // The loop was held, so no frame passed for the stops its steps asked for: left in the outbox, they would\n        // freeze the first live frame after it.\n        takeHitStop(run.session.world);\n      }\n    },\n  };\n  const inspector = createInspector(host);\n  hosts.set(inspector, host);\n  return {\n    inspector,\n    host,\n    get session() {\n      return run.session;\n    },\n    get clock() {\n      return run.clock;\n    },\n    view,\n    stepOnce,\n    stepped,\n    get playing() {\n      return playing;\n    },\n    begin,\n    meter,\n  };\n}\n\n/**\n * Starts a scene headless, in this process, and returns its inspector: the members a page's `window.__engine` has\n * (`step`, `hash`, `state`, `set`…; `help()` lists them all), minus a renderer. With `view: true` it also builds the\n * scene's view, for `scene.dump()` and `camera`. Throws `CORE_NO_ENTRY` for an unknown scene id, `CORE_BAD_SETTING`\n * for a bad setting, `SIM_BAD_SEED` for a seed a replay cannot hold, and with a view `APP_NO_LEVEL` for a level not\n * registered.\n */\nexport async function createHeadless<C extends object = AnyComponents, E extends EventMap = EventMap>(\n  options: HeadlessOptions<C, E>,\n): Promise<Headless> {\n  return createAppHost(options).inspector;\n}\n\n/** The run behind a headless engine: its session (world, settings, recording) and clock. Tools only. */\nexport function headlessHost(headless: Headless): InspectorHost {\n  const host = hosts.get(headless);\n  if (!host) throw codeError('APP_NOT_HEADLESS', { value: typeof headless });\n  return host;\n}\n------\n/**\n * @file The frame loop (PLAN.md §6.4, WP 2.7; doctrine: Reproducible): fixed sim steps plus interpolation, once per\n * animation frame. `createLoop` calls `frame(now)` from `requestAnimationFrame`: it samples the devices into intents,\n * asks the clock (engine/core/time.ts) how many fixed 1/60 s steps the real time since the last frame holds (at most\n * `time.maxSteps`, a time scale and pause applied), runs them, then has the view drawn at the clock's alpha, the\n * fraction of a step real time is past the last one (the view blends the last two states by it).\n *\n * Inputs across steps (§6.4): the frame's sample goes to its first step and its later steps get it without `p`\n * (held state repeats, edges apply once). A press sampled in a frame that runs no step (a display faster than 60 Hz,\n * a pause) waits for the next step, so a tap shorter than a step is never lost. While `hold()` says so (a replay is\n * playing through the same session), frames step nothing and draw nothing, and the time they cover is dropped.\n *\n * Touch screens draw at most 60 frames a second (WP 3.12, built, not tested): while `cap()` says so, an animation\n * frame that arrives more than 2.5 ms before the next 16.667 ms slot is skipped whole, and the slot starts again from\n * a frame that falls behind (`shardfall:crates/pav_app/src/app.rs:799-808`).\n *\n * Invariants: the loop reads no clock of its own: time comes from the animation frame's timestamp, so under the\n * tools' virtual clock (tools/lib/browser.ts) a frame runs exactly when `__clock.tick()` says. An error thrown by a\n * frame stops the loop and goes to `onError` once, instead of repeating every frame.\n *\n * @example\n * // const loop = createLoop({ clock: () => run.clock, sample: (now) => input.sample(view.camera, now), step, draw, onError });\n * // loop.start();\n * // loop.frame(performance.now()); // one frame by hand: { steps: 1, alpha: 0.4, … }\n * @see engine/app/loop.test.ts\n */\nimport type { Clock, Frame } from '../core/time';\n\n/** What the loop drives. */\nexport interface LoopOptions {\n  /** The run's clock (read each frame: a restart makes a new one). */\n  clock(): Clock;\n  /** The devices' intents for the frame at timestamp `now` (`input.sample(camera, now)`); `{}` when there are none. */\n  sample(now: number): Record<string, unknown>;\n  /** Runs one sim step with these intents, through the session. */\n  step(intents: Record<string, unknown>): void;\n  /** Draws the view at the clock's `alpha`; `dt` is the real seconds since the last frame. */\n  draw(frame: { alpha: number; dt: number }): void;\n  /** True while frames must neither step nor draw (a replay plays). */\n  hold?(): boolean;\n  /** True while frames are capped at 60 a second (touch mode). */\n  cap?(): boolean;\n  /** Gets a frame's error, once; the loop has stopped. */\n  onError(error: unknown): void;\n  /** `requestAnimationFrame` and `cancelAnimationFrame` (the window's). */\n  request?: (callback: (now: number) => void) => number;\n  cancel?: (id: number) => void;\n}\n\n/** A running frame loop. */\nexport interface Loop {\n  /** Starts calling `frame` on every animation frame. */\n  start(): void;\n  /** Stops it. */\n  stop(): void;\n  /** Runs one frame at timestamp `now` (ms): sample, step, draw; returns what the clock handed out. */\n  frame(now: number): Frame;\n  /** Frames run, and sim steps run by them. */\n  readonly frames: number;\n  readonly steps: number;\n  readonly running: boolean;\n}\n\n/** The capped frame rate's slot, in ms: 60 frames a second. */\nexport const FRAME_SLOT_MS = 16.667;\n/** How early a capped frame may come before its slot and still run, in ms. */\nexport const FRAME_SLACK_MS = 2.5;\n\n/** The sorted union of two press lists. */\nconst union = (a: readonly string[], b: readonly string[]) => [...new Set([...a, ...b])].sort();\n\n/** Makes a frame loop (see the file comment). */\nexport function createLoop(options: LoopOptions): Loop {\n  const request = options.request ?? ((callback) => requestAnimationFrame(callback));\n  const cancel = options.cancel ?? ((id) => cancelAnimationFrame(id));\n  let id: number | null = null;\n  let frames = 0;\n  let steps = 0;\n  let waiting: string[] = []; // presses sampled in frames that ran no step\n  let slot = -Infinity; // the next capped frame's time\n  /** Whether a frame at `now` runs under the 60 fps cap (see the file comment); always without it. */\n  const due = (now: number) => {\n    if (!options.cap?.()) return true;\n    if (now + FRAME_SLACK_MS < slot) return false;\n    slot = now > slot + FRAME_SLOT_MS ? now + FRAME_SLOT_MS : slot + FRAME_SLOT_MS;\n    return true;\n  };\n  const loop: Loop = {\n    start() {\n      if (id !== null) return;\n      const tick = (now: number) => {\n        id = request(tick);\n        if (!due(now)) return;\n        try {\n          loop.frame(now);\n        } catch (error) {\n          loop.stop();\n          options.onError(error);\n        }\n      };\n      id = request(tick);\n    },\n    stop() {\n      if (id !== null) cancel(id);\n      id = null;\n    },\n    frame(now) {\n      const clock = options.clock();\n      if (options.hold?.()) return clock.advance(now);\n      const sampled = options.sample(now);\n      const pressed = union(waiting, Array.isArray(sampled.p) ? (sampled.p as string[]) : []);\n      const frame = clock.advance(now);\n      if (frame.steps === 0) waiting = pressed;\n      else {\n        waiting = [];\n        const first = pressed.length ? { ...sampled, p: pressed } : { ...sampled, p: undefined };\n        const later = { ...sampled, p: undefined };\n        for (let k = 0; k < frame.steps; k++) options.step(k === 0 ? first : later);\n        steps += frame.steps;\n      }\n      options.draw({ alpha: frame.alpha, dt: frame.elapsed });\n      frames++;\n      return frame;\n    },\n    get frames() {\n      return frames;\n    },\n    get steps() {\n      return steps;\n    },\n    get running() {\n      return id !== null;\n    },\n  };\n  return loop;\n}\n-----\n/**\n * @file The frame clock (PLAN.md §6.3, §6.4, WP 1.3, ADR-0005; doctrine: Reproducible): it turns real time into fixed\n * 60 Hz sim steps plus an interpolation `alpha`, under a time scale, a stack of slowdowns, a hit-stop with a leaky\n * budget and pause; plus a virtual clock for tests. Nothing here reads a wall clock: real time arrives from outside,\n * as the timestamps the page's loop passes to `clock.advance(now)` (requestAnimationFrame's argument), or from the\n * `now` it is given. Timers and per-entity clocks, which run in sim time, are in engine/core/timers.ts.\n *\n * `createClock` keeps an accumulator (Glenn Fiedler's \"Fix your timestep\"): each frame adds the real time since the\n * last, times the speed, and hands out the whole steps in it, at most `time.maxSteps`; after a stall the steps beyond\n * are dropped and only the fraction is kept. The speed is `time.scale` times the slowest pushed slowdown (`push(id,\n * k, seconds?)`, `pop(id)`), and 0 while paused or in a hit-stop. Slowdowns and hit-stops are sim decisions (rules\n * call them) that change how many steps a frame runs, never what a step does, so the clock is no part of the hash,\n * captures or replays (they record each step's intents); their durations count real seconds, so a slowdown never\n * stretches itself. The budget shrinks hit-stops that follow each other closely, so a crowd stutters once.\n *\n * Invariants: the accumulator counts whole nanoseconds times `hz` (one step is 1e9), so at speed 1 the steps after T\n * ms are exactly floor(T × hz / 1000) however the frames fall: random frame times give the fixed-step state. A\n * slowdown or hit-stop that ends inside a frame ends at its exact time. A paused frame counts no time, so resuming\n * owes none. Settings (the store's, read every frame): `time.hz` (sim-side, read when made or reset) and the view\n * settings `time.maxSteps`, `time.scale`, `time.paused` and `time.hitStop.*`. Ten frames in a row that drop steps\n * raise `CORE_CLOCK_BEHIND`, printed once and counted per slow spell; a single stall drops its backlog quietly.\n *\n * Carried from `my-3d2dge:src/lab3d/60-panel.js:143-152` (the fixed loop, its 6-step cap),\n * `my-3d2dge:src/emberdeep/10-combat.js:45-76` (the hit-stop budget, its numbers kept) and\n * `my-3d2dge:src/emberdeep/00-core.js:146-161` (the slow-motion stack, now without a wall clock).\n *\n * @example\n * const clock = createClock({ hz: 60 });\n * clock.advance(1000); // { steps: 0, alpha: 0, … }: the first frame sets the origin\n * const frame = clock.advance(1025); // 25 ms later: { steps: 1, alpha: 0.5, … }\n * clock.push('dodge', 0.25, 0.5); // a quarter speed for half a real second\n * clock.hitStop(0.07); // 0.07: a full stop; another at once would get 0.0126\n * const time = createVirtualClock(0); // tests: createClock({ now: time.now }), then time.tick(ms)\n * @see engine/core/time.test.ts\n */\nimport { defineCodes, codeError, log as sharedLog, type Log } from './log';\nimport { show, type Field } from './schema';\nimport { createSettings, defineSettings, type Settings } from './settings';\n\n/** The sim's steps per second: gameplay time is counted in 60 Hz ticks (ADR-0005). */\nexport const SIM_HZ = 60;\n/** One sim step in seconds, 1/60. */\nexport const SIM_DT = 1 / SIM_HZ;\n\n/** The codes this module raises, with their fixes. */\nexport const TIME_CODES = defineCodes('core', {\n  CORE_NO_TIME: {\n    template: 'clock.advance() got no timestamp, and the clock has no now()',\n    fix: \"pass the frame's time in milliseconds, clock.advance(timestamp) with requestAnimationFrame's argument, or create the clock with createClock({ now }) (createVirtualClock().now in tests): sim-side code never reads a wall clock\",\n  },\n  CORE_BAD_TIME: {\n    template: '{where} got {value}',\n    fix: 'pass {expected}',\n    doc: 'Raised by engine/core/time.ts and engine/core/timers.ts for a timestamp that is not a finite number, a negative or infinite duration, a slowdown `k` outside 0..1 (speed-ups go through the `time.scale` setting), an empty slowdown id, an `every` shorter than one tick, a step count that is not a whole number, or an entity clock rate below 0.',\n  },\n  CORE_CLOCK_BEHIND: {\n    template:\n      'the sim is falling behind real time: {frames} frames in a row each needed more than time.maxSteps = {maxSteps} steps, and the rest were dropped',\n    fix: 'make each step cheaper (__engine.stats() shows where the time goes) or lighten the scene; raise time.maxSteps only when frames are long and steps cheap',\n    doc: 'Advice from `clock.advance` (engine/core/time.ts): the game runs slower than real time. A single stall (a tab coming back, a debugger pause) drops its backlog without advice.',","is_error":false}]},"parent_tool_use_id":null,"session_id":"3b0d0401-1a79-4c2f-8a33-ba9239fdbfed","uuid":"ae70f945-7cb3-403e-9405-805b0161d09e","timestamp":"2026-11-05T04:24:46.218Z","tool_use_result":{"stdout":"> extends HeadlessOptions<C, E> {\n  drawing?: Drawing;\n  materials?: MaterialLibrary;\n}\n\n/** The run behind each headless engine, for tools that need more than the members. */\nconst hosts = new WeakMap<object, InspectorHost>();\n\n/** The settings of `session` that differ from a fresh start of its scene: what a restart keeps. */\nfunction changedSettings(session: Session, registry: Registry): Record<string, SettingValue> {\n  const fresh = createSettings({ registry });\n  fresh.override(session.scene.settings, 'fresh');\n  const now = session.settings.values();\n  const changed = Object.keys(now).filter((path) => !sameValue(now[path], fresh.get(path)));\n  return Object.fromEntries(changed.map((path) => [path, now[path]]));\n}\n\n/** Of the settings a restart keeps, those marked view: what a replay's run keeps, since none of them changes play. */\nfunction changedViewSettings(session: Session, registry: Registry): Record<string, SettingValue> {\n  const changed = Object.entries(changedSettings(session, registry));\n  return Object.fromEntries(changed.filter(([path]) => registry.get('setting', path).view === true));\n}\n\n/** Makes the run behind an engine (see the file comment). Throws as `createHeadless` does, and `APP_NO_LEVEL`. */\nexport function createAppHost<C extends object = AnyComponents, E extends EventMap = EventMap>(\n  options: AppHostOptions<C, E>,\n): AppRun {\n  const firstSeed = checkSeed(options.seed, 'createHeadless({ seed })');\n  const registry = options.registry ?? sharedRegistry;\n  const firstScene =\n    typeof options.scene === 'string' ? getScene(options.scene, registry) : (options.scene as unknown as Scene);\n  const timed = registry.kinds().includes('setting') && registry.has('setting', 'time.hz');\n  if (!timed) defineSettings(TIME_SETTINGS, registry); // the clock reads them: a test registry may lack them\n  const { drawing } = options;\n  const meter = createStatsMeter({ counts: () => drawing?.counts() ?? null });\n  // Members get `recordedRun(session)`, except that a restore or a dev action moves entities between steps, so the\n  // view then snaps to the world as it is (no interpolation from the places it had), as it does after a restart.\n  const followed = (session: Session): RecordedRun => {\n    const recorded = recordedRun(session);\n    const snapping = <A extends unknown[]>(change: (...args: A) => void) => ({\n      enumerable: true,\n      value: (...args: A) => {\n        change(...args);\n        view?.restarted();\n      },\n    });\n    return Object.freeze(\n      Object.defineProperties(\n        {},\n        {\n          ...Object.getOwnPropertyDescriptors(recorded),\n          restore: snapping(recorded.restore),\n          act: snapping(recorded.act),\n        },\n      ),\n    ) as RecordedRun;\n  };\n  const start = (scene: Scene, seed: number, settings: Readonly<Record<string, unknown>> | undefined) => {\n    const session = createSession(scene, { seed, settings, registry, log: options.log, probe: meter.probe });\n    const clock = createClock({ settings: session.settings, log: options.log });\n    return { session, recorded: followed(session), clock };\n  };\n  let run: { session: Session; recorded: RecordedRun; clock: Clock } = start(firstScene, firstSeed, options.settings);\n  let playing = false;\n  const wantView = options.view === true || drawing !== undefined;\n  const view = wantView\n    ? createRunView({\n        run: () => run.session,\n        registry,\n        materials: options.materials ?? createMaterialLibrary({ registry }),\n        cam: options.cam,\n        log: options.log,\n      })\n    : null;\n  const restart = (scene: Scene, seed: number, settings: Readonly<Record<string, unknown>> | undefined) => {\n    if (view && scene.id !== run.session.scene.id) {\n      throw codeError('APP_OTHER_SCENE', { shown: run.session.scene.id, scene: scene.id });\n    }\n    run = start(scene, seed, settings);\n    view?.restarted();\n  };\n  const begin = (replay: Replay) => {\n    // The replay holds the run's play; the page keeps its view (its look, quality, resolution, speed…), none of which\n    // changes play, so a replay neither changes the picture nor makes the renderer warm up again.\n    const settings = { ...changedViewSettings(run.session, registry), ...replay.settings };\n    restart(getScene(replay.scene, registry), replay.seed, settings);\n    return run.session;\n  };\n  // After a step of the run's: the clock gets the hit-stop the step's rules asked for, and the view reads the world.\n  const stepped = () => {\n    const stop = takeHitStop(run.session.world);\n    if (stop > 0) run.clock.hitStop(stop);\n    view?.stepped();\n  };\n  const stepOnce = (intents: unknown) => {\n    meter.time('sim', () => run.session.step(intents));\n    stepped();\n  };\n  const host: AppHost = {\n    registry,\n    members: sharedRegistry,\n    log: options.log ?? sharedLog,\n    get clock() {\n      return run.clock;\n    },\n    get session() {\n      return run.recorded;\n    },\n    runtime: typeof window === 'undefined' ? 'node' : 'browser',\n    get renderer() {\n      return drawing?.active() ?? false;\n    },\n    get adapter() {\n      return drawing?.adapter ?? null;\n    },\n    get features() {\n      return drawing?.features ?? [];\n    },\n    get downgrades() {\n      return drawing?.downgrades ?? [];\n    },\n    get ready() {\n      return drawing ? drawing.ready() : true;\n    },\n    view,\n    meter,\n    step(n, intents) {\n      if (intents === undefined) {\n        // No intents: what the virtual device holds (`__engine.input`), taken each step as the page's input is.\n        const device = virtualDeviceOf(host);\n        for (let k = 0; k < n; k++) stepOnce(virtualIntents(device.take()));\n        return;\n      }\n      const script = Array.isArray(intents) ? intents : undefined;\n      const later = isPlainObject(intents) ? { ...intents, p: undefined } : intents;\n      for (let k = 0; k < n; k++) stepOnce(script ? (script[k] ?? {}) : k === 0 ? intents : later);\n    },\n    restart(next) {\n      restart(run.session.scene, next, changedSettings(run.session, registry));\n    },\n    render: (frames) => drawing!.render(frames),\n    shot: (shotOptions) => drawing!.shot(shotOptions),\n    async replay(text: string, playOptions: PlayIntoOptions): Promise<PlayResult> {\n      playing = true;\n      try {\n        return await playInto(\n          {\n            registry,\n            begin,\n            stepped: () => view?.stepped(),\n            draw: drawing && (() => drawing.draw()),\n            carry: drawing && view ? () => view.carry() : undefined,\n            camera: view ? (code, blend) => void view.setCamera(code, { blend }) : undefined,\n            setView: (path, value) => (drawing ? drawing.setView(path, value) : run.session.set(path, value)),\n            shoot: drawing && ((shotOptions) => drawing.shot(shotOptions)),\n          },\n          text,\n          playOptions,\n        );\n      } finally {\n        playing = false;\n        // The loop was held, so no frame passed for the stops its steps asked for: left in the outbox, they would\n        // freeze the first live frame after it.\n        takeHitStop(run.session.world);\n      }\n    },\n  };\n  const inspector = createInspector(host);\n  hosts.set(inspector, host);\n  return {\n    inspector,\n    host,\n    get session() {\n      return run.session;\n    },\n    get clock() {\n      return run.clock;\n    },\n    view,\n    stepOnce,\n    stepped,\n    get playing() {\n      return playing;\n    },\n    begin,\n    meter,\n  };\n}\n\n/**\n * Starts a scene headless, in this process, and returns its inspector: the members a page's `window.__engine` has\n * (`step`, `hash`, `state`, `set`…; `help()` lists them all), minus a renderer. With `view: true` it also builds the\n * scene's view, for `scene.dump()` and `camera`. Throws `CORE_NO_ENTRY` for an unknown scene id, `CORE_BAD_SETTING`\n * for a bad setting, `SIM_BAD_SEED` for a seed a replay cannot hold, and with a view `APP_NO_LEVEL` for a level not\n * registered.\n */\nexport async function createHeadless<C extends object = AnyComponents, E extends EventMap = EventMap>(\n  options: HeadlessOptions<C, E>,\n): Promise<Headless> {\n  return createAppHost(options).inspector;\n}\n\n/** The run behind a headless engine: its session (world, settings, recording) and clock. Tools only. */\nexport function headlessHost(headless: Headless): InspectorHost {\n  const host = hosts.get(headless);\n  if (!host) throw codeError('APP_NOT_HEADLESS', { value: typeof headless });\n  return host;\n}\n------\n/**\n * @file The frame loop (PLAN.md §6.4, WP 2.7; doctrine: Reproducible): fixed sim steps plus interpolation, once per\n * animation frame. `createLoop` calls `frame(now)` from `requestAnimationFrame`: it samples the devices into intents,\n * asks the clock (engine/core/time.ts) how many fixed 1/60 s steps the real time since the last frame holds (at most\n * `time.maxSteps`, a time scale and pause applied), runs them, then has the view drawn at the clock's alpha, the\n * fraction of a step real time is past the last one (the view blends the last two states by it).\n *\n * Inputs across steps (§6.4): the frame's sample goes to its first step and its later steps get it without `p`\n * (held state repeats, edges apply once). A press sampled in a frame that runs no step (a display faster than 60 Hz,\n * a pause) waits for the next step, so a tap shorter than a step is never lost. While `hold()` says so (a replay is\n * playing through the same session), frames step nothing and draw nothing, and the time they cover is dropped.\n *\n * Touch screens draw at most 60 frames a second (WP 3.12, built, not tested): while `cap()` says so, an animation\n * frame that arrives more than 2.5 ms before the next 16.667 ms slot is skipped whole, and the slot starts again from\n * a frame that falls behind (`shardfall:crates/pav_app/src/app.rs:799-808`).\n *\n * Invariants: the loop reads no clock of its own: time comes from the animation frame's timestamp, so under the\n * tools' virtual clock (tools/lib/browser.ts) a frame runs exactly when `__clock.tick()` says. An error thrown by a\n * frame stops the loop and goes to `onError` once, instead of repeating every frame.\n *\n * @example\n * // const loop = createLoop({ clock: () => run.clock, sample: (now) => input.sample(view.camera, now), step, draw, onError });\n * // loop.start();\n * // loop.frame(performance.now()); // one frame by hand: { steps: 1, alpha: 0.4, … }\n * @see engine/app/loop.test.ts\n */\nimport type { Clock, Frame } from '../core/time';\n\n/** What the loop drives. */\nexport interface LoopOptions {\n  /** The run's clock (read each frame: a restart makes a new one). */\n  clock(): Clock;\n  /** The devices' intents for the frame at timestamp `now` (`input.sample(camera, now)`); `{}` when there are none. */\n  sample(now: number): Record<string, unknown>;\n  /** Runs one sim step with these intents, through the session. */\n  step(intents: Record<string, unknown>): void;\n  /** Draws the view at the clock's `alpha`; `dt` is the real seconds since the last frame. */\n  draw(frame: { alpha: number; dt: number }): void;\n  /** True while frames must neither step nor draw (a replay plays). */\n  hold?(): boolean;\n  /** True while frames are capped at 60 a second (touch mode). */\n  cap?(): boolean;\n  /** Gets a frame's error, once; the loop has stopped. */\n  onError(error: unknown): void;\n  /** `requestAnimationFrame` and `cancelAnimationFrame` (the window's). */\n  request?: (callback: (now: number) => void) => number;\n  cancel?: (id: number) => void;\n}\n\n/** A running frame loop. */\nexport interface Loop {\n  /** Starts calling `frame` on every animation frame. */\n  start(): void;\n  /** Stops it. */\n  stop(): void;\n  /** Runs one frame at timestamp `now` (ms): sample, step, draw; returns what the clock handed out. */\n  frame(now: number): Frame;\n  /** Frames run, and sim steps run by them. */\n  readonly frames: number;\n  readonly steps: number;\n  readonly running: boolean;\n}\n\n/** The capped frame rate's slot, in ms: 60 frames a second. */\nexport const FRAME_SLOT_MS = 16.667;\n/** How early a capped frame may come before its slot and still run, in ms. */\nexport const FRAME_SLACK_MS = 2.5;\n\n/** The sorted union of two press lists. */\nconst union = (a: readonly string[], b: readonly string[]) => [...new Set([...a, ...b])].sort();\n\n/** Makes a frame loop (see the file comment). */\nexport function createLoop(options: LoopOptions): Loop {\n  const request = options.request ?? ((callback) => requestAnimationFrame(callback));\n  const cancel = options.cancel ?? ((id) => cancelAnimationFrame(id));\n  let id: number | null = null;\n  let frames = 0;\n  let steps = 0;\n  let waiting: string[] = []; // presses sampled in frames that ran no step\n  let slot = -Infinity; // the next capped frame's time\n  /** Whether a frame at `now` runs under the 60 fps cap (see the file comment); always without it. */\n  const due = (now: number) => {\n    if (!options.cap?.()) return true;\n    if (now + FRAME_SLACK_MS < slot) return false;\n    slot = now > slot + FRAME_SLOT_MS ? now + FRAME_SLOT_MS : slot + FRAME_SLOT_MS;\n    return true;\n  };\n  const loop: Loop = {\n    start() {\n      if (id !== null) return;\n      const tick = (now: number) => {\n        id = request(tick);\n        if (!due(now)) return;\n        try {\n          loop.frame(now);\n        } catch (error) {\n          loop.stop();\n          options.onError(error);\n        }\n      };\n      id = request(tick);\n    },\n    stop() {\n      if (id !== null) cancel(id);\n      id = null;\n    },\n    frame(now) {\n      const clock = options.clock();\n      if (options.hold?.()) return clock.advance(now);\n      const sampled = options.sample(now);\n      const pressed = union(waiting, Array.isArray(sampled.p) ? (sampled.p as string[]) : []);\n      const frame = clock.advance(now);\n      if (frame.steps === 0) waiting = pressed;\n      else {\n        waiting = [];\n        const first = pressed.length ? { ...sampled, p: pressed } : { ...sampled, p: undefined };\n        const later = { ...sampled, p: undefined };\n        for (let k = 0; k < frame.steps; k++) options.step(k === 0 ? first : later);\n        steps += frame.steps;\n      }\n      options.draw({ alpha: frame.alpha, dt: frame.elapsed });\n      frames++;\n      return frame;\n    },\n    get frames() {\n      return frames;\n    },\n    get steps() {\n      return steps;\n    },\n    get running() {\n      return id !== null;\n    },\n  };\n  return loop;\n}\n-----\n/**\n * @file The frame clock (PLAN.md §6.3, §6.4, WP 1.3, ADR-0005; doctrine: Reproducible): it turns real time into fixed\n * 60 Hz sim steps plus an interpolation `alpha`, under a time scale, a stack of slowdowns, a hit-stop with a leaky\n * budget and pause; plus a virtual clock for tests. Nothing here reads a wall clock: real time arrives from outside,\n * as the timestamps the page's loop passes to `clock.advance(now)` (requestAnimationFrame's argument), or from the\n * `now` it is given. Timers and per-entity clocks, which run in sim time, are in engine/core/timers.ts.\n *\n * `createClock` keeps an accumulator (Glenn Fiedler's \"Fix your timestep\"): each frame adds the real time since the\n * last, times the speed, and hands out the whole steps in it, at most `time.maxSteps`; after a stall the steps beyond\n * are dropped and only the fraction is kept. The speed is `time.scale` times the slowest pushed slowdown (`push(id,\n * k, seconds?)`, `pop(id)`), and 0 while paused or in a hit-stop. Slowdowns and hit-stops are sim decisions (rules\n * call them) that change how many steps a frame runs, never what a step does, so the clock is no part of the hash,\n * captures or replays (they record each step's intents); their durations count real seconds, so a slowdown never\n * stretches itself. The budget shrinks hit-stops that follow each other closely, so a crowd stutters once.\n *\n * Invariants: the accumulator counts whole nanoseconds times `hz` (one step is 1e9), so at speed 1 the steps after T\n * ms are exactly floor(T × hz / 1000) however the frames fall: random frame times give the fixed-step state. A\n * slowdown or hit-stop that ends inside a frame ends at its exact time. A paused frame counts no time, so resuming\n * owes none. Settings (the store's, read every frame): `time.hz` (sim-side, read when made or reset) and the view\n * settings `time.maxSteps`, `time.scale`, `time.paused` and `time.hitStop.*`. Ten frames in a row that drop steps\n * raise `CORE_CLOCK_BEHIND`, printed once and counted per slow spell; a single stall drops its backlog quietly.\n *\n * Carried from `my-3d2dge:src/lab3d/60-panel.js:143-152` (the fixed loop, its 6-step cap),\n * `my-3d2dge:src/emberdeep/10-combat.js:45-76` (the hit-stop budget, its numbers kept) and\n * `my-3d2dge:src/emberdeep/00-core.js:146-161` (the slow-motion stack, now without a wall clock).\n *\n * @example\n * const clock = createClock({ hz: 60 });\n * clock.advance(1000); // { steps: 0, alpha: 0, … }: the first frame sets the origin\n * const frame = clock.advance(1025); // 25 ms later: { steps: 1, alpha: 0.5, … }\n * clock.push('dodge', 0.25, 0.5); // a quarter speed for half a real second\n * clock.hitStop(0.07); // 0.07: a full stop; another at once would get 0.0126\n * const time = createVirtualClock(0); // tests: createClock({ now: time.now }), then time.tick(ms)\n * @see engine/core/time.test.ts\n */\nimport { defineCodes, codeError, log as sharedLog, type Log } from './log';\nimport { show, type Field } from './schema';\nimport { createSettings, defineSettings, type Settings } from './settings';\n\n/** The sim's steps per second: gameplay time is counted in 60 Hz ticks (ADR-0005). */\nexport const SIM_HZ = 60;\n/** One sim step in seconds, 1/60. */\nexport const SIM_DT = 1 / SIM_HZ;\n\n/** The codes this module raises, with their fixes. */\nexport const TIME_CODES = defineCodes('core', {\n  CORE_NO_TIME: {\n    template: 'clock.advance() got no timestamp, and the clock has no now()',\n    fix: \"pass the frame's time in milliseconds, clock.advance(timestamp) with requestAnimationFrame's argument, or create the clock with createClock({ now }) (createVirtualClock().now in tests): sim-side code never reads a wall clock\",\n  },\n  CORE_BAD_TIME: {\n    template: '{where} got {value}',\n    fix: 'pass {expected}',\n    doc: 'Raised by engine/core/time.ts and engine/core/timers.ts for a timestamp that is not a finite number, a negative or infinite duration, a slowdown `k` outside 0..1 (speed-ups go through the `time.scale` setting), an empty slowdown id, an `every` shorter than one tick, a step count that is not a whole number, or an entity clock rate below 0.',\n  },\n  CORE_CLOCK_BEHIND: {\n    template:\n      'the sim is falling behind real time: {frames} frames in a row each needed more than time.maxSteps = {maxSteps} steps, and the rest were dropped',\n    fix: 'make each step cheaper (__engine.stats() shows where the time goes) or lighten the scene; raise time.maxSteps only when frames are long and steps cheap',\n    doc: 'Advice from `clock.advance` (engine/core/time.ts): the game runs slower than real time. A single stall (a tab coming back, a debugger pause) drops its backlog without advice.',","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QjXyPYKkXcRNUk1UbyYMdk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
