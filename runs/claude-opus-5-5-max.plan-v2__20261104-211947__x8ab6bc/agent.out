 const batch = batchOf(part.shape, id ?? fallback, !glow && !part.material, part.material !== undefined);\n233:      return { part, batch, color: toLinear(body.slots[part.slot]), at, local };\n235:    compiledRigs.set(body, pieces);\n271:      for (const body of list) {\n272:        if ('skeleton' in body) puppets.prepare(body);\n273:        else compileRig(body);\n301:      return crowd.rig(draw.body ?? BLOB_BODY, blob.pose(), blobDraw);\n306:      return crowd.rig(draw.body ?? FLOATER_BODY, floaterJoints, draw);\n308:    rig(body, joints, draw = {}) {\n312:      for (const piece of compileRig(body)) {\n317:          const index = body.parts.indexOf(piece.part);\n=====\nengine/anim:\n__snapshots__\nactions-check.ts\nactions-data.ts\nactions.ts\napi.ts\nattack.ts\nauthoring.ts\nblob.ts\nbodyPlants.ts\nbuilds.ts\nchain.ts\ncharacter.ts\ncheck.ts\nclip\nfk.ts\nfloater.ts\nfootPlant.ts\nfootRoll.ts\nhumanoid.ts\nhumanoidRates.ts\nik.ts\nlocomotion\nlocomotion.ts\nmotionMetrics.ts\nmoves-data.ts\nmoves.ts\npose.ts\nposeNames.ts\nposes.ts\nproc\nquadruped.ts\nragdoll.ts\nreactions.ts\nsecondary.ts\nsheet.ts\nskeleton.ts\nstateMatrix.ts\nstates.ts\nstrike.ts\ntimeline.ts\ntraversal\nweights.ts\n\nengine/gfx/puppets:\nactorLayers.ts\nactors.ts\nbatches.ts\nblobShadow.ts\nbodies\nchains.ts\ncompile.ts\ncrowd.ts\ndraw.ts\ngrammar.ts\nlod.ts\nrigBody.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HqYw9sPohdgts2zH9RB9tz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
