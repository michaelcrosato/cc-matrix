{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bfdy3Ndxe3mZ73hvU6PqRY","type":"tool_result","content":"15:export const TIMINGS = Object.freeze({\n16-  helloMs: 10_000,\n17-  readyMs: 45_000,\n18-  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n19-  loadGraceMs: 20_000,\n20-  countdownMs: 3_000,\n21-  graceMs: 5_000,\n22-  hiddenMs: 20_000,\n23-  maxRoundMs: 15 * 60_000,\n24-});\n25-\n26-/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\n27-export const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n--\n61:export function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n62-  const typical = Number(minutes);\n63-  if (!(typical > 0)) return maxRoundMs;\n64-  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\n65-}\n66-\n67-/**\n68- * Parallel and ghost order: finishers by time, then the rest by score,\n69- * then anyone who reported nothing, tied last. Equal times or scores share a\n70- * place.\n71- */\n72-export function rankResults(results, ids) {\n73-  const timed = [];\n--\n190:  timings = TIMINGS,\n191-  gate = false,\n192-  serverKey = null,\n193-}) {\n194-  mode = modeOf(mode);\n195:  const t = { ...TIMINGS, ...timings };\n196-  const seats = [...players]\n197-    .sort((a, b) => a.slot - b.slot)\n198-    .map((p, id) => ({\n199-      id,\n200-      key: p.key,\n201-      slot: p.slot,\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.A\n    }\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  cut?: LevelCut;\n}\n\n/** The wall's cut twin (m): the prototype's 7 units. */\nconst WALL_CUT = 0.4375;\n/** A pillar's stump (m): the prototype's 14 units, its plinth and the foot of its shaft. */\nconst PILLAR_STUMP = 0.875;\n\n/** The engine's recipes, by the name a glyph's `mesh` gives. */\nexport const LEVEL_RECIPES: Readonly<Record<string, LevelRecipe>> = {\n  floor: { shape: 'surface', materials: ['material:flagstone'], castShadow: false, receiveShadow: true },\n  wall: {\n    shape: 'block',\n    materials: ['material:brick', 'material:stone'],\n    castShadow: true,\n    receiveShadow: true,\n    cut: { height: WALL_CUT, when: 'facing' },\n  },\n  lowWall: { shape: 'block', materials: ['material:stone', 'material:stone'], castShadow: true, receiveShadow: true },\n  pillar: {\n    shape: 'pillar',\n    materials: ['material:stone', 'material:stone'],\n    castShadow: true,\n    receiveShadow: true,\n    cut: { height: PILLAR_STUMP, when: 'blocking' },\n  },\n  gallery: {\n    shape: 'slab',\n    materials: ['material:brick', 'material:flagstone'],\n    castShadow: true,\n    receiveShadow: true,\n  },\n  stairs: { shape: 'stairs', materials: ['material:stone'], castShadow: true, receiveShadow: true },\n  ramp: { shape: 'ramp', materials: ['material:stone', 'material:flagstone'], castShadow: true, receiveShadow: true },\n  dais: { shape: 'dais', materials: ['materi