ants ready within 20 s, which rules out the obvious startup order for a heavy WebGPU game.\"\n  }\n]\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01LG5DXt9v8nerCZxzkuJoLS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
