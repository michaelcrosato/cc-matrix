ue } from '../core/settings';\nimport { qualityBudget, type QualitySetting } from '../gfx/quality';\nimport { keepWidth } from '../gfx/resolution';\nimport type { Post } from '../gfx/post/chain';\nimport type { FrameReport, FrameView, Gfx } from '../gfx/renderer';\nimport { shot, shotForJson } from '../gfx/shot';\nimport { warmsAsked } from '../gfx/warmup';\nimport type { Input } from '../input/input';\nimport type { Chrome } from '../ui/chrome';\nimport type { Overlay } from '../ui/overlay';\nimport type { TouchLayer } from '../ui/touch';\nimport { queryViewOf } from '../sim/queryView';\nimport type { CameraInput, CameraPose } from '../gfx/cameras/pose';\nimport type { QueryView } from '../sim/queryView';\nimport type { Scene } from '../sim/scene';\nimport type { World, WorldEvents } from '../sim/world';\nimport type { DamageNumbers } from './damageNumbers';\nimport type { AppRun, Drawing } from './headless';\nimport type { PageLook } from './look';\nimport { HEADLESS_ASPECT } from './view';\nimport type { Governor } from '../dev/governor';\n\n/** GPU frames drawn while a replay plays before the queue is drained (`drain`); frames tried before a warm-up counts as stuck (`tries`). */\nexport const DRAWING = { drain: 10, tries: 10 } as const;\n\n/**\n * The cameras a warm-up compiles for (`gfx.warmUp`, engine/gfx/warmup.ts): every one of the view's in `all`, else\n * those the page has drawn with (`drawn`), in the view's order.\n */\nexport function warmedCameras<C>(cameras: readonly C[], drawn: ReadonlySet<C>, asked: boolean): readonly C[] {\n  return asked ? cameras.filter((camera) => drawn.has(camera)) : cameras;\n}\n\n/** What the page has started so far, read at each call: each part is null until the engine starts it. */\nexport interface PageParts {\n  run: AppRun | null;\n  gfx: Gfx | null;\n  post: Post | null;\n  look: PageLook | null;\n  input: Input | null;\n  layer: TouchLayer | null;\n  ui: Overlay | null;\n  numbers: DamageNumbers | null;\n  /** The performance governor (engine/dev/governor.ts): `auto`'s tier as the frame rate asks. */\n  governor: Governor | null;\n  /** The page's own camera input, laid over the devices' each drawn frame (`EngineOptions.cameraInput`). */\n  cameraInput?: () => CameraInput | undefined;\n  /** Whether the first frame is drawn. */\n  ready: boolean;\n}\n\n/** The read side of the run's world a page gets each frame: its step, rate, entities and the trace of its events. */\nexport type FrameWorld = Pick<World, 'tick' | 'hz' | 'get' | 'query'> & { readonly events: Pick<WorldEvents, 'trace'> };\n\n-------\n/**\n * @file The input (PLAN.md §6.4, WP 3.3, I-24; doctrine: Reproducible): the devices of a page (keyboard, mouse,\n * gamepads, touch, the virtual device) turned into one step's intents through bindings (engine/input/bindings.ts).\n * The frame loop calls `sample(camera, now)` once per rendered frame, before the clock hands out steps, and gives the\n * result to the frame's first step (its later steps get it without `p`, PLAN.md §6.4); the session records it, so\n * touch play replays like any other (WP 3.12, `sample`).\n *\n * What a sample holds: `b`, the map's actions held, sorted; `p`, those pressed since the last sample (a code that went\n * down, so a tap shorter than a frame still presses); `move`, the map's four move actions as `[right − left, forward −\n * back]` turned by `fromCamera(camera.yaw(), …)`, so W walks away from the camera; `cam`, the camera's heading; `look`\n * (its yaw and pitch) for maps with `look`; `aim`, the camera's point for the map's `aimWith` rule from the free\n * pointer and the right stick (engine/input/aim.ts); the map's `values` as custom intents. The move actions, the map's\n * `view` actions and the system layer (pause, menus) are never buttons in it: `held`, `pressed` and `strength` give\n * every action to the app and the UI, and `onView` hears a view action as it is pressed (a key at once, a pad button at\n * its poll, the virtual device's at the sample). `camera()` gives what the camera takes each frame (mouse look under\n * pointer lock and the right stick, scaled by the view settings `input.*`, engine/input/look.ts; the wheel; a map that\n * aims with the pointer keeps the stick for aiming). `prompt(action)` labels a binding on the device used last;\n * `use(map)` switches the map live (one per camera mode, WP 13.9), what is held read through it from the next sample;\n * `bindingsFor(map)`, another map's bindings, unswitched, for a controls screen (WP 13.25). A code a held binding waits\n * on (WP 13.20) is held back as it goes down, until it is a tap or a hold (`sample`).\n *\n * Clearing: a page blur, the page going hidden and `clear()` let go of every held code and drop pending presses, so\n * nothing stays held after alt-tab; a gamepad that disconnects lets go of its own. `listen(device)` serves rebinding.\n *\n * Invariants: nothing here reads a clock; edges are counted per sample; a code is held only between its press and\n * release reports. In Node (no `window`, `document`), only the gamepad source given and the virtual device feed it.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:482-512, 542-555, 594-622` (the input object, blur, `move`, `tick`),\n * sampled per frame; shardfall's short taps and prompts (`shardfall:crates/pav_app/src/input.rs:590-610`).\n *\n * @example\n * const window = new EventTarget();\n * const input = createInput({ window, document: new EventTarget(), element: new EventTarget() });\n * const key = (type: string, code: string) => window.dispatchEvent(Object.assign(new Event(type), { code }));\n * ['KeyW', 'Space'].forEach((code) => key('keydown', code)), key('keyup', 'Space'); // a tap between two frames\n * input.sample({ yaw: () => Math.PI / 2 }); // { move: [1, 6.1e-17], cam: 1.5707963267948966, p: ['jump'] }\n * input.prompt('jump'); // 'Space'\n * input.sample({ yaw: () => 0 }).move; // [0, 1]: still held; the camera turned, so W walks +Z now\n * @see engine/input/input.test.ts\n */\nimport type { Log } from '../core/log';\nimport type { Registry } from '../core/registry';\nimport { SYSTEM_ACTIONS } from './actionMaps';\nimport { createBindings, pickLabel, type Bindings, type BindingsStorage } from './bindings';\nimport { deviceOf, heldBase, HOLD_TIME, holdCode, PAD_BUTTONS, touchCode, type DeviceKind, type InputSink } from './codes'; // prettier-ignore\nimport { createGamepadDevice, type GamepadDevice, type GamepadSource } from './devices/gamepad';\nimport { attachKeyboard } from './devices/keyboard';\nimport type { AimDevices, AimRule } from './aim';\nimport { attachMouse, type MouseDevice, type MouseTargets } from './devices/mouse';\nimport { attachTouch, type TouchDevice, type TouchSetting } from './devices/touch';\nimport { createVirtualDevice, type VirtualDevice } from './devices/virtual';\nimport { fromCamera } from './intents';\nimport { lookOptions, scaleLook, type LookOptions } from './look';\n\n/** A camera as the input reads it (the app's, over its view): its heading, its pitch for the look, and the aim. */\nexport interface CameraLike {\n  yaw(): number;\n  pose?(): { readonly pitch: number };\n  /** The point `rule` aims at this frame from the devices' pointer and stick (engine/input/aim.ts), or undefined. */\n  aim?(rule: AimRule, devices: AimDevices): readonly [number, number, number] | undefined;\n}\n\n/** How an input is made; in a page every field has its default. */\nexport interface InputOptions {\n  /** The action map's id (`actionMap:thirdPerson`) or ready bindings. */\n  map?: string | Bindings;\n  /** Where bindings made from an id are saved (the page's `localStorage`). */\n  storage?: BindingsStorage;\n  /** Where keys, releases, blur and gamepad events arrive (`window`). */\n  window?: EventTarget;\n------\n/**\n * @file Sessions (PLAN.md §8.4, WP 1.5; doctrines: Reproducible, Agent-operable): `createSession(scene, options)`\n * starts a scene (engine/sim/scene.ts `startScene`) that records its inputs from step 0, the recorder of PLAN.md §8.4.\n * The kernel fixture, the box's scenes and `createHeadless` (WP 1.6) all record through it; engine/sim/replay.ts plays\n * what it records.\n *\n * A session logs, each at the step it happens (merged in play order: set, then dev, then intents), what its intents\n * change (a step the world does not count logs nothing), every non-view setting change (through `set` or its own store,\n * `session.settings`), and its dev actions (`act`: the scene's own, else the engine's, engine/sim/devActions.ts; all or\n * nothing: one that throws is rolled back; an unknown one is `SIM_NO_ACTION`). `record()` returns the replay from step\n * 0; change-points no step has followed yet wait for it.\n * Step, capture and restore through the session, never the world (`SIM_OFF_RECORD`): `session.restore` takes the\n * recording back to the capture's step with the sim, so `record()` replays the run as it stands; it refuses a capture\n * it did not take (`SIM_FOREIGN_CAPTURE`) or one changed since (`SIM_EDITED_CAPTURE`). `Session` says the rest.\n *\n * Invariants: the recording is plain data, from step 0, and replays to the same hashes (engine/sim/replay.ts); view\n * settings are never recorded. Split from scene.ts to keep each under 400 lines (ADR-0014 amendment 16).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineScene } from './scene';\n * const reg = createRegistry();\n * defineScene('demo', { description: 'Spawns one.', setup: (w) => w.spawn() }, reg);\n * const live = createSession('demo', { registry: reg });\n * live.step({ move: [0, 1] });\n * live.step({ move: [0, 1], b: ['jump'] });\n * live.record().inputs; // [[0, { move: [0, 1] }], [1, { b: ['jump'] }]]\n * @see engine/sim/scene.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { deserialize, hashValue, serialize, type Canonical } from '../core/hash';\nimport { codeError, defineCodes, didYouMean } from '../core/log';\nimport { registry as sharedRegistry, sameValue } from '../core/registry';\nimport { show } from '../core/schema';\nimport type { SettingChange, SettingValue } from '../core/settings';\nimport { diffIntents, INTENT_KEYS, NO_INTENTS, normalizeIntents, type Intents } from '../input/intents';\nimport type { WorldCapture } from './capture';\nimport type { InputChange, InputEntry, Replay } from './replay';\nimport { changesSim, devArgs, findDevAction, listDevActions } from './devActions';\nimport { checkSeed, startScene, type SceneOptions, type SceneRun } from './scene';\nimport type { AnyComponents } from './state';\n\n/** The codes this module raises, with their fixes. */\nexport const SESSION_CODES = defineCodes('sim', {\n  SIM_NO_ACTION: {\n    template: 'the scene {scene} has no dev action {name} ({suggestion})',\n    fix: \"add it to the scene, defineScene('{scene}', { actions: { {name}(w, args) { … } } }), or to the engine's, defineDevAction('{name}', { help, run }) (engine/sim/devActions.ts); or call one there is\",\n  },\n  SIM_OFF_RECORD: {\n    template: 'the world took {count} steps outside its session, so the recording misses their intents',\n    fix: 'step a recorded scene through session.step(intents), never world.step(); capture and restore it through session.capture() and session.restore(capture), never the world',\n  },\n  SIM_FOREIGN_CAPTURE: {\n    template: 'restore() was given a capture the session of {scene} did not take',\n    fix: \"restore what this session's capture() (__engine.capture()) returned, the object itself: the session knows where its recording stood then; the world's own captures, another session's and copies have no place in it, so reach other state by starting the scene again (__engine.seed(n)) or playing a replay\",\n  },\n  SIM_EDITED_CAPTURE: {\n    template: 'the capture the session of {scene} took at step {step} was changed since (it hashes {now}, not {then})',\n    fix: 'restore it unchanged, then make the change through the session so record() replays it: session.set(path, value) (__engine.set) for a setting, a dev action (session.act(name, args)) for components',\n  },\n----\nugrep: warning: engine/sim/intents.ts: No such file or directory\nactorActions.test.ts\nactorActions.ts\nactorAnim.ts\nactorClips.test.ts\nactorClips.ts\nactorInput.ts\nactors.test.ts\nactors.ts\nbreakables.test.ts\nbreakables.ts\ncapture.test.ts\ncapture.ts\ncombatApi.ts\ncrowdBodies.test.ts\ncrowdBodies.ts\ndamage.test.ts\ndamage.ts\ndevActions.ts\ndoors.test.ts\ndoors.ts\nentities.ts\nentityTable.ts\nfeelCourse.test.ts\nfeelCourse.ts\nhits.test.ts\nhits.ts\nhouseApi.ts\ninteract.test.ts\ninteract.ts\nkitsApi.ts\nlevelBodies.test.ts\nlevelBodies.ts\nlights.test.ts\nlights.ts\nmelee.test.ts\nmelee.ts\nmovementApi.ts\npropBlocks.test.ts\npropBlocks.ts\nprops.test.ts\nprops.ts\nqueryView.test.ts\nqueryView.ts\nragdolls.test.ts\nragdolls.ts\nreactions.test.ts\nreactions.ts\nreplay.test.ts\nreplay.ts\nrestore.test.ts\nrides.test.ts\nrides.ts\nscene.test.ts\nscene.ts\nsession.ts\nsiteApi.ts\nstate.test.ts\nstate.ts\nswitches.test.ts\nswitches.ts\nsystems.test.ts\nsystems.ts\nthings.test.ts\nthings.ts\nthrownStep.test.ts\nweapons.test.ts\nweapons.ts\nworld.test.ts\nworld.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018zaxMxQtBKfTM7mfG9mGDT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
