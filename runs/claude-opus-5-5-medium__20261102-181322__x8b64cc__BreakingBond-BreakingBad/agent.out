tion:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n`;\nfs.writeFileSync(path.join(root, 'index.html'), head(false) + '<script src=\"vendor/my-3d2dge.js\"></script>\\n<script src=\"game.js\"></script>\\n</body>\\n</html>\\n');\nfs.writeFileSync(path.join(out, NAME + '.html'), head(true) + '<script>\\n' + esc(engine) + '\\n</script>\\n<script>\\n' + esc(game) + '\\n</script>\\n</body>\\n</html>\\n');\nconsole.log('built', (fs.statSync(path.join(out, NAME + '.html')).size / 1024).toFixed(0) + ' KB');\nEOF\necho ok","description":"Write the bundling build script"}}}
