acing: Math.PI / 2, pose: 'hips' });\"\"\", \"\"\"    setup() {\n      if (M.beat > 0) return;\n      M.flags.tito = M.npc('TITO', 6, 4.8, { facing: Math.PI / 2, pose: 'hips' });\"\"\")\nrep('src/40-missions.js', \"\"\"    setup() {\n      M.flags.danny = M.npc('DANNY', 15.5, 11.5, { facing: Math.PI / 2, pose: 'kneel' });\"\"\", \"\"\"    setup() {\n      if (M.beat > 0) { W.partner = makePlayer('DANNY', 16 * R16, 16 * R16, { ai: true, hp: 6 }); W.partner.player = game.players[1] || null; return; }\n      M.flags.danny = M.npc('DANNY', 15.5, 11.5, { facing: Math.PI / 2, pose: 'kneel' });\"\"\")\nEOF\nnode tools/build.mjs","description":"Fix labels, cook pips, barks and checkpoint NPCs"}},"wire_ingest_context":{"toolu_01B6A7GAL8TTHBoWEKKN9TQP":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181322__x8b64cc/work/BreakingBond-BreakingBad-claude-opus-5-5-medium-20261102-181322"}}}
