'Pad1'] };","+const INPUT = Object.assign({","+  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],","+  attack: ['KeyJ', 'Mouse0', 'Pad2'],              // punch: a four-hit combo","+  heavy: ['KeyK', 'Pad3'],                          // haymaker / stomp a downed guy","+  dodge: ['Space', 'Pad1'],                         // roll out of the way","+  interact: ['KeyE', 'KeyF', 'Pad0'],               // talk, take, enter and leave the car","+  fire: ['KeyL', 'Mouse2', 'Pad7'],                 // the pistol (draws heat)","+  gas: ['KeyW', 'ArrowUp', 'Pad7'],                 // in the car","+  brake: ['KeyS', 'ArrowDown', 'Pad6'],             // in the car (reverse when stopped)","+  breathe: ['KeyQ', 'Pad6'],                        // hold: Dr. Melba's breathing (lowers stress)","+  sprint: ['ShiftLeft', 'ShiftRight', 'Pad4', 'Pad10'],","+  horn: ['KeyH', 'Pad5'],                           // in the car","+  view: ['KeyV', 'Pad11'],                          // cycle the camera","+  log: ['Tab', 'KeyM', 'Pad8']                      // the job log","+}, MENU);","+const CONTROL_NAMES = { attack: 'Punch (combo)', heavy: 'Haymaker', dodge: 'Roll', interact: 'Talk / use / car', fire: 'Pistol', gas: 'Gas (car)', brake: 'Brake (car)',","+  breathe: 'Breathe (hold)', sprint: 'Sprint', horn: 'Horn (car)', view: 'Camera view', log: 'Job log' };","+","+const game = new E.Game({","+  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'iso', 'topdown'], input: INPUT,","+  menu: {","+    controls: CONTROL_NAMES, saves: HUB ? false : { slots: 3, version: 1 }, quit: 'title',","+    settings: [","+      { key: 'invertPadX', label: 'Invert controller horizontal', value: false, group: 'Controller', help: 'Some controllers report the sticks backwards. Flip left and right.' },","+      { key: 'invertPadY', label: 'Invert controller vertical', value: false, group: 'Controller', help: 'Flip up and down on the controller.' },","+      { key: 'difficulty', label: 'Difficulty', options: ['Made guy', 'Capo', 'Boss'], value: 'Capo' },","+      { key: 'hints', label: 'On-screen hints', value: true },","+      { key: 'talkSpeed', label: 'Text speed', options: ['Slow', 'Normal', 'Fast'], value: 'Normal' },","+      { key: 'voices', label: 'Gibberish voices', value: true }","+    ]","+  }","+});","+const input = game.input, audio = game.audio, P = game.particles, L = game.lights;","+","+// PlayStation symbols by default (the game is designed around a DualSense); Settings > Controller > Button symbols has Xbox","+if (!E.store.get('sopraniacs.glyphs', false)) { try { game.settings.set('glyphs', 'playstation'); } catch (e) { input.glyphs = 'playstation'; } E.store.set('sopraniacs.glyphs', true); }","+","+// the ~10% of pads that report a stick backwards: Settings > Controller flips them. Only the controller is flipped","+const rawMove = input.move.bind(input);","+const padFlip = v => [game.settings.invertPadX ? -v[0] : v[0], game.settings.invertPadY ? -v[1] : v[1]];","+input.move = function () { const m = rawMove(); return input.lastDevice === 'gamepad' ? padFlip(m) : m; };","+const padAim = () => input.padAim ? padFlip(input.padAim) : null;","+","+// touch-only devices: no touch controls (the game needs a controller or a keyboard)","+const COARSE = !!(window.matchMedia && matchMedia('(pointer: coarse)').matches), FINE = !!(window.matchMedia && matchMedia('(any-pointer: fine)').matches);","+function touchOnly() {","+  if (!COARSE || FINE) return false;","+  if (input.lastDevice === 'gamepad' || input.lastDevice === 'keyboard') return false;","+  try { const pads = navigator.getGamepads ? [...navigator.getGamepads()].filter(Boolean) : []; if (pads.length) return false; } catch (e) { /* none */ }","+  return true;","+}","+input.touchEnabled = false;","+","+const diff = () => ({ 'Made guy': .6, Capo: 1, Boss: 1.45 })[game.settings.difficulty] || 1;","+const fmt$ = n => '$' + Math.round(n).toLocaleString('en-US');","+","+/* ---- SOUND: code-written effects and Animalese-style gibberish voices ---- */","+audio.define('punchHit', [{ wave: 'noise', freq: 900, to: 120, dur: .09, vol: .5 }, { wave: 'square', freq: 160, to: 60, dur: .08, vol: .3 }]);","+audio.define('slap', { wave: 'noise', freq: 2400, to: 900, dur: .05, vol: .35 });","+audio.define('gun', [{ wave: 'noise', freq: 1800, to: 80, dur: .22, vol: .7 }, { wave: 'square', freq: 220, to: 40, dur: .12, vol: .35 }]);","+audio.define('click', { wave: 'square', freq: 1400, dur: .02, vol: .2 });","+audio.define('quack', [{ wave: 'saw', freq: 520, to: 380, dur: .09, vol: .3, vib: [30, .05] }, { wave: 'square', freq: 260, to: 200, dur: .09, vol: .12 }]);","+audio.define('horn', [{ wave: 'square', freq: 349, dur: .35, vol: .3 }, { wave: 'square', freq: 440, dur: .35, vol: .25 }]);","+audio.define('engine', { wave: 'saw', freq: 70, to: 90, dur: .12, vol: .08 });","+audio.define('door', { wave: 'noise', freq: 500, to: 200, dur: .18, vol: .25 });","+audio.define('bell', [{ wave: 'sine', freq: 1568, dur: .9, vol: .35 }, { wave: 'sine', freq: 2093, dur: .7, vol: .2 }, { wave: 'triangle', freq: 784, dur: 1, vol: .15 }]);","+audio.define('cash', [{ wave: 'square', freq: 1046, dur: .06, vol: .2 }, { wave: 'square', freq: 1318, dur: .06, vol: .2, delay: .06 }, { wave: 'triangle', freq: 1568, dur: .25, vol: .25, delay: .12 }]);","+audio.define('ring', { wave: 'square', freq: 880, dur: .5, vol: .18, vib: [24, .2] });","+audio.define('heartbeat', [{ wave: 'sine', freq: 60, to: 40, dur: .12, vol: .7 }]);","+audio.define('crash', [{ wave: 'noise', freq: 600, to: 60, dur: .35, vol: .6 }, { wave: 'square', freq: 90, to: 30, dur: .3, vol: .3 }]);","+audio.define('breath', { wave: 'noise', freq: 400, to: 250, dur: .8, vol: .12 });","+","+// each speaker's voice: a pitch, a wave and a lilt; letters type, syllables blip at random pitches around it","+const VOICES = {","+  TONY: { f: 110, w: 'square', s: .32 }, PAULIE: { f: 175, w: 'pulse', s: .4 }, CHRISSY: { f: 150, w: 'saw', s: .35 }, SIL: { f: 95, w: 'triangle', s: .25 },","+  'DR. MELBA': { f: 260, w: 'triangle', s: .25 }, CARLA: { f: 240, w: 'pulse', s: .35 }, MA: { f: 300, w: 'saw', s: .45 }, RALPHIE: { f: 165, w: 'square', s: .5 },","+  ARTIE: { f: 140, w: 'triangle', s: .3 }, 'AGENT HARROW': { f: 125, w: 'triangle', s: .15 }, ENZO: { f: 130, w: 'saw', s: .3 }, GEORGIE: { f: 190, w: 'pulse', s: .4 },","+  'T.J.': { f: 200, w: 'square', s: .3 }, MEDORA: { f: 280, w: 'triangle', s: .3 }, DEFAULT: { f: 160, w: 'square', s: .35 }","+};","+let voiceT = 0, voiceShown = 0;","+function voiceTick(talk, dt) {","+  if (!talk.open || !game.settings.voices) { voiceShown = 0; return; }","+  if (talk.shown < voiceShown) voiceShown = 0;","+  const v = VOICES[talk.name] || VOICES.DEFAULT;","+  voiceT -= dt;","+  if (talk.typing && talk.shown > voiceShown + 1 && voiceT <= 0) {","+    voiceShown = talk.shown; voiceT = .075 + Math.random() * .04;","+    const f = v.f * (1 + (Math.random() - .5) * v.s * 2), g = f * (1 + (Math.random() - .5) * .3);","+    audio.sfx({ wave: v.w, freq: f, to: g, dur: .055, vol: .16 });","+  }","+}","+","+/* ---- MUSIC: written as tracker strings (original tunes) ---- */","+const rep = (s, n) => Array(n).fill(s).join(' | ');","+const SONGS = {","+  // a smoky Jersey blues shuffle for the title: walking bass, a brass stab, a ride cymbal","+  title: { bpm: 96, steps: 4, tracks: [","+    { wave: 'saw', vol: .1, notes: 'E2 - . E2 G2 - . A2 Bb2 - B2 - . . A2 . | E2 - . E2 G2 - . A2 Bb2 - A2 - G2 - E2 . | A2 - . A2 C3 - . D3 Eb3 - E3 - . . D3 . | E2 - . E2 G2 - . A2 B2 - . D3 . B2 A2 .' },","+    { wave: 'pulse', vol: .07, notes: '. . . . . . . . E4 - G4 - . . . . | . . . . . . . . B4 - A4 - G4 - E4 - | . . . . . . . . A4 - C5 - . . . . | . . . . B4 . D5 - - - B4 - A4 - G4 -' },","+    { wave: 'drums', vol: .22, notes: rep('k . h . s . h k . k h . s . h h', 4) }] },","+  // the neighborhood: an easy mandolin-ish tremolo over a I-vi-IV-V doo-wop changes","+  town: { bpm: 104, steps: 4, tracks: [","+    { wave: 'triangle', vol: .16, notes: 'C3 . G2 . C3 . E3 . | A2 . E2 . A2 . C3 . | F2 . C3 . F2 . A2 . | G2 . D3 . G2 . B2 . | C3 . G2 . C3 . E3 . | A2 . E2 . A2 . C3 . | F2 . C3 . G2 . B2 . | C3 . G2 . C3 - - -' },","+    { wave: 'pulse12', vol: .06, notes: 'E5 E5 G5 G5 E5 E5 C5 C5 | E5 E5 C5 C5 A4 A4 C5 . | A4 A4 C5 C5 F5 F5 E5 D5 | D5 - B4 - G4 - . . | E5 E5 G5 G5 C6 C6 B5 A5 | A5 - E5 - C5 - . . | F5 F5 A5 A5 G5 F5 D5 B4 | C5 - - - . . . .' },","+    { wave: 'drums', vol: .12, notes: rep('k . h . s . h .', 8) }] },","+  // the fight: driving rock in A minor","+  fight: { bpm: 150, steps: 4, tracks: [","+    { wave: 'saw', vol: .12, notes: 'A2 A2 A3 A2 A2 G3 A2 A2 | F2 F2 F3 F2 G2 G2 G3 G2 | A2 A2 A3 A2 A2 C4 A2 A2 | E2 E2 E3 E2 G2 G2 Ab2 Ab2' },","+    { wave: 'square', vol: .06, notes: 'A4 - - C5 - - E5 - | F5 - E5 - D5 - C5 - | A4 - - C5 - - E5 - | B4 - - - Ab4 - - -' },","+    { wave: 'drums', vol: .26, notes: rep('k h s h k k s h', 4) }] },","+  // the therapist's office: slow triangle arpeggios, a held pad","+  therapy: { bpm: 70, steps: 4, tracks: [","+    { wave: 'triangle', vol: .14, notes: 'D4 F4 A4 C5 A4 F4 D4 F4 | Bb3 D4 F4 A4 F4 D4 Bb3 D4 | G3 Bb3 D4 F4 D4 Bb3 G3 Bb3 | A3 C#4 E4 G4 E4 C#4 A3 C#4' },","+    { wave: 'sine', vol: .08, notes: 'D3 - - - - - - - | Bb2 - - - - - - - | G2 - - - - - - - | A2 - - - - - - -' }] },","+  // the club: four on the floor","+  club: { bpm: 122, steps: 4, tracks: [","+    { wave: 'saw', vol: .1, notes: 'C3 . C3 C4 . C3 Eb3 . | C3 . C3 C4 . Bb2 G2 . | Ab2 . Ab2 Ab3 . Ab2 C3 . | Bb2 . Bb2 Bb3 . Bb2 D3 .' },","+    { wave: 'pulse', vol: .05, notes: '. . G4 . . . G4 . | . . G4 . . . Bb4 . | . . Ab4 . . . C5 . | . . Bb4 . . . D5 .' },","+    { wave: 'drums', vol: .24, notes: rep('k . h . k . h c', 4) }] },","+  // jukebox 1: \"Kearny Streetlights\", a power ballad that builds","+  juke1: { bpm: 118, steps: 4, tracks: [","+    { wave: 'triangle', vol: .14, notes: 'E3 . E3 . E3 . E3 . | B2 . B2 . B2 . B2 . | C#3 . C#3 . C#3 . C#3 . | A2 . A2 . A2 . A2 .' },","+    { wave: 'pulse', vol: .07, notes: 'E4 B4 G#4 B4 E4 B4 G#4 B4 | D#4 B4 F#4 B4 D#4 B4 F#4 B4 | C#4 G#4 E4 G#4 C#4 G#4 E4 G#4 | A3 E4 C#4 E4 B3 F#4 D#4 F#4' },","+    { wave: 'square', vol: .05, notes: '. . . . G#5 - F#5 E5 | F#5 - - - D#5 - B4 - | E5 - - E5 F#5 - G#5 - | F#5 - - - - - . .' },","+    { wave: 'drums', vol: .16, notes: rep('k . h . s . h .', 4) }] },","+  // jukebox 2: \"Turnpike Exit 16W\", a stomping rocker","+  juke2: { bpm: 136, steps: 4, tracks: [","+    { wave: 'saw', vol: .11, notes: 'G2 G2 Bb2 G2 C3 G2 Db3 C3 | G2 G2 Bb2 G2 F2 G2 . . | C3 C3 Eb3 C3 F3 C3 Gb3 F3 | D3 D3 C3 C3 Bb2 Bb2 A2 A2' },","+    { wave: 'square', vol: .05, notes: 'G4 - Bb4 - C5 - Db5 C5 | Bb4 - G4 - . . . . | C5 - Eb5 - F5 - Gb5 F5 | D5 - C5 - Bb4 - A4 -' },","+    { wave: 'drums', vol: .24, notes: rep('k . s . k k s .', 4) }] },","+  // jukebox 3: \"Onion Ring Serenade\", a crooner's waltz-ish swing","+  juke3: { bpm: 92, steps: 3, tracks: [","+    { wave: 'triangle', vol: .15, notes: 'F2 A2 C3 | D3 F3 A3 | G2 Bb2 D3 | C3 E3 G3 | F2 A2 C3 | D3 F3 A3 | G2 C3 E3 | F2 - -' },","+    { wave: 'pulse12', vol: .07, notes: 'A4 - C5 | F5 - - | D5 - Bb4 | G4 - - | A4 C5 F5 | A5 - G5 | E5 D5 C5 | F5 - -' },","+    { wave: 'drums', vol: .09, notes: rep('k h h', 8) }] },","+  // the yard at night: low, tense","+  night: { bpm: 84, steps: 4, tracks: [","+    { wave: 'saw', vol: .1, notes: 'D2 - . D2 . . F2 - | E2 - . E2 . . C2 - | D2 - . D2 . . F2 - | A1 - . A1 . . C#2 -' },","+    { wave: 'triangle', vol: .08, notes: '. . A4 . . . G4 . | . . F4 . . . E4 . | . . A4 . . . Bb4 . | . . A4 - - - G#4 .' },","+    { wave: 'drums', vol: .14, notes: rep('k . . h s . . h', 4) }] },","+  victory: { bpm: 120, steps: 4, tracks: [","+    { wave: 'square', vol: .1, notes: 'C5 E5 G5 C6 - - G5 C6 | - - - - . . . .' }, { wave: 'triangle', vol: .14, notes: 'C3 - G3 - C4 - - - | C3 - - - . . . .' },","+    { wave: 'drums', vol: .2, notes: 'k . s . k k s . | c . . . . . . .' }] }","+};","+let curSong = null;","+function music(name, o) { if (curSong === name) return; curSong = name; audio.music(name ? SONGS[name] : null, o); }"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181319__xb81546/work/BreakingBackyard-BreakingBad-claude-opus-5-5-medium-20261102-181319/src/00-core.js","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":191,"lines":["+// BREAKING BACKYARD: an original spiritual successor to Breaking Bad (2008-2013), on the my-3D2dge engine.","+// A three-quarter-view crime action-adventure: cook in the RV parked in your backyard (a three-stage chemistry","+// minigame), sell on street corners under the eyes of DEA patrols (sight cones, suspicion, heat), launder the cash,","+// buy upgrades from a lawyer, and fight your way through five episodes to the top of a taco franchise's empire.","+// Files (concatenated in order into one IIFE by build.mjs): 00-core, 10-art, 20-world, 30-actors, 40-story,","+// 50-cook, 60-scenes, 70-hub, 90-start.","+(() => {","+'use strict';","+const E = My3D2dge, { px, clamp, lerp, approach } = E;","+const TAU = Math.PI * 2;","+const HUB = typeof window !== 'undefined' && window.AIHub && window.AIHub.active ? window.AIHub : null;","+const TITLE = 'BREAKING BACKYARD';","+const BUILD = 'claude-opus-5-5-medium-20261102-181319';","+","+/* ---------------- input: the genre's keys (WASD, E, mouse) and a DualSense layout ---------------- */","+const D = E.Input.DEFAULT;","+const PRESET = {","+  up: D.up, down: D.down, left: D.left, right: D.right,","+  interact: ['KeyE', 'Pad0'],                       // ✕ / A: talk, use, cook, sell","+  attack: ['Mouse0', 'KeyF', 'Pad2', 'Pad7'],        // □ / X, R2: punch or shoot","+  throw: ['Mouse2', 'KeyG', 'Pad5'],                 // R1 / RB: throw the selected flask","+  cycle: ['KeyQ', 'Pad3'],                           // △ / Y: switch flask","+  dodge: ['Space', 'Pad1'],                          // ○ / B: dodge roll","+  sprint: ['ShiftLeft', 'ShiftRight', 'Pad6', 'Pad10'], // L2 / L3: sprint","+  ledger: ['Tab', 'KeyM', 'Pad8'],                   // Create / View: the ledger","+  view: ['KeyV', 'Pad11'],                           // R3: change the camera","+  start: D.start, pause: D.pause, confirm: D.confirm, cancel: D.cancel","+};","+const ACTION_NAMES = { interact: 'Interact / talk', attack: 'Punch / shoot', throw: 'Throw flask', cycle: 'Switch flask',","+  dodge: 'Dodge roll', sprint: 'Sprint', ledger: 'Ledger', view: 'Camera view' };","+","+/* ---------------- gamepad axis inversion (the Settings quick fix): every read of the pads goes through it ---------------- */","+let SETTINGS_REF = null;","+(function wrapGamepads() {","+  if (typeof navigator === 'undefined' || !navigator.getGamepads) return;","+  const real = navigator.getGamepads.bind(navigator);","+  const wrap = p => {","+    if (!p) return p;","+    const s = SETTINGS_REF; if (!s || (!s.invertX && !s.invertY)) return p;","+    const axes = Array.from(p.axes || []);","+    for (let i = 0; i < axes.length; i++) if ((i % 2 === 0 && s.invertX) || (i % 2 === 1 && s.invertY)) axes[i] = -axes[i];","+    return { id: p.id, index: p.index, connected: p.connected, mapping: p.mapping, timestamp: p.timestamp, buttons: p.buttons, axes, vibrationActuator: p.vibrationActuator, hapticActuators: p.hapticActuators };","+  };","+  try {","+    Object.defineProperty(navigator, 'getGamepads', { configurable: true, writable: true, value: () => { const list = real(); return Array.from(list || []).map(wrap); } });","+  } catch (e) { /* a locked navigator: inversion unavailable */ }","+})();","+","+/* ---------------- the game ---------------- */","+const game = new E.Game({","+  canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: PRESET, bg: '#0a0806',","+  id: 'breaking-backyard',","+  autoPause: !HUB,","+  menu: {","+    controls: ACTION_NAMES,","+    quit: HUB ? false : 'title',","+    settings: [","+      { key: 'glyphs', label: 'Button prompts', options: ['PlayStation', 'Xbox'], value: 'PlayStation', group: 'Controller', help: 'Which controller symbols the prompts show',","+        apply: (g, v) => { for (const p of (g.players || [g.input])) p.glyphs = v === 'Xbox' ? 'xbox' : 'playstation'; } },","+      { key: 'invertX', label: 'Invert stick horizontal', value: false, group: 'Controller', help: 'Flip left/right on both sticks (some pads report it backwards)' },","+      { key: 'invertY', label: 'Invert stick vertical', value: false, group: 'Controller', help: 'Flip up/down on both sticks (some pads report it backwards)' },","+      { key: 'difficulty', label: 'Difficulty', options: ['Story', 'Normal', 'Hard'], value: 'Normal', group: 'Game', help: 'How hard enemies hit and how fast the DEA notice' },","+      { key: 'cones', label: 'Show DEA sight cones', value: true, group: 'Game', help: 'Draw what each agent can see' },","+      { key: 'hints', label: 'Hints', value: true, group: 'Game', help: 'Tutorial tips as new things come up' }","+    ]","+  }","+});","+SETTINGS_REF = game.settings;","+const I = game.input, A = game.audio, P = game.particles, L = game.lights;","+for (const p of game.players) p.glyphs = game.settings.glyphs === 'Xbox' ? 'xbox' : 'playstation';","+const DIFF = () => ({ Story: { dmg: .5, sus: .6 }, Normal: { dmg: 1, sus: 1 }, Hard: { dmg: 1.5, sus: 1.4 } })[game.settings.difficulty] || { dmg: 1, sus: 1 };","+","+/* ---------------- devices: touch-only screens get no touch controls ---------------- */","+const mm = q => { try { return typeof matchMedia === 'function' && matchMedia(q).matches; } catch (e) { return false; } };","+let sawKeyOrPad = false;","+const touchOnly = () => {","+  if (sawKeyOrPad) return false;","+  if (typeof navigator === 'undefined' || !navigator.maxTouchPoints) return false;","+  if (mm('(any-pointer: fine)') || mm('(any-hover: hover)')) return false;","+  try { if (Array.from(navigator.getGamepads ? navigator.getGamepads() : []).some(Boolean)) return false; } catch (e) { /* none */ }","+  return true;","+};","+if (typeof addEventListener === 'function') {","+  addEventListener('keydown', () => { sawKeyOrPad = true; }, true);","+  addEventListener('gamepadconnected', () => { sawKeyOrPad = true; });","+}","+I.touchEnabled = false;","+","+/* ---------------- prompts that follow the device used last ---------------- */","+const lbl = a => {","+  const s = I.label(a);","+  return (s || a).replace('Left click', 'LMB').replace('Right click', 'RMB');","+};","+const isPad = () => I.lastDevice === 'gamepad';","+","+/* ---------------- audio: chip voices for each speaker (gibberish \"Simlish\") ---------------- */","+const VOICES = {","+  hollis: { base: 'A2', wave: 'square', span: 5, vol: .07 },","+  dusty: { base: 'E3', wave: 'pulse', span: 9, vol: .07 },","+  lenny: { base: 'C3', wave: 'saw', span: 12, vol: .05 },","+  vela: { base: 'F2', wave: 'triangle', span: 3, vol: .12 },","+  dale: { base: 'D2', wave: 'square', span: 7, vol: .07 },","+  rafa: { base: 'G2', wave: 'saw', span: 10, vol: .05 },","+  mack: { base: 'C2', wave: 'triangle', span: 2, vol: .12 },","+  skyler: { base: 'C4', wave: 'pulse12', span: 6, vol: .05 },","+  thug: { base: 'B2', wave: 'saw', span: 8, vol: .05 },","+  radio: { base: 'G3', wave: 'pulse12', span: 4, vol: .04 }","+};","+const NOTE_ST = { C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11 };","+const noteHz = n => { const m = /^([A-G])(#|b)?(\\d)$/.exec(n); const s = NOTE_ST[m[1]] + (m[2] === '#' ? 1 : m[2] === 'b' ? -1 : 0) + (+m[3] + 1) * 12; return 440 * Math.pow(2, (s - 69) / 12); };","+const SCALE = [0, 2, 3, 5, 7, 8, 10, 12, 14];","+let voiceRand = E.rng(77);","+for (const k in VOICES) {","+  const v = VOICES[k];","+  // a syllable: a short blip at a random step of the speaker's scale, a vowel-ish glide","+  A.define('vox_' + k, { wave: v.wave, freq: noteHz(v.base), dur: .06, vol: v.vol });","+}","+const realSfx = A.sfx.bind(A);","+A.sfx = (what, o = {}) => {","+  if (typeof what === 'string' && what.startsWith('vox_')) {","+    const v = VOICES[what.slice(4)] || VOICES.thug;","+    if (voiceRand() < .35) return null;            // not every letter speaks: syllables","+    const st = SCALE[Math.floor(voiceRand() * SCALE.length)] % (v.span + 1);","+    const f = noteHz(v.base) * Math.pow(2, st / 12);","+    return realSfx({ wave: v.wave, freq: f, to: f * (voiceRand() < .5 ? .85 : 1.12), dur: .05 + voiceRand() * .04, vol: v.vol }, o);","+  }","+  return realSfx(what, o);","+};","+A.define('flask', { wave: 'noise', freq: 1800, to: 300, dur: .18, vol: .25 });","+A.define('glass', { wave: 'square', freq: 2400, to: 3600, dur: .08, vol: .12, arp: [0, 7, 12], step: .02 });","+A.define('cash', { wave: 'pulse', freq: 'E5', dur: .16, vol: .14, arp: [0, 4, 7, 12], step: .035 });","+A.define('alarm', { wave: 'square', freq: 'A4', to: 'E5', dur: .3, vol: .12, vib: [10, .06] });","+A.define('bubble', { wave: 'sine', freq: 300, to: 900, dur: .09, vol: .12 });","+A.define('tick', { wave: 'square', freq: 1400, dur: .025, vol: .07 });","+A.define('good', { wave: 'triangle', freq: 'C5', dur: .18, vol: .2, arp: [0, 7, 12], step: .04 });","+A.define('bad', { wave: 'saw', freq: 'C3', to: 'A2', dur: .25, vol: .14 });","+A.define('gun', { wave: 'noise', freq: 900, to: 120, dur: .12, vol: .3 });","+A.define('shotgun', { wave: 'noise', freq: 600, to: 60, dur: .28, vol: .38 });","+A.define('siren', { wave: 'square', freq: 'C5', to: 'G5', dur: .45, vol: .06, vib: [4, .2] });","+A.define('hiss', { wave: 'noise', freq: 4000, to: 2000, dur: .6, vol: .08 });","+","+/* music: original chip songs in the engine's step notation */","+const SONGS = {","+  // the title: a lonely desert twang over a slow pulse, in E minor","+  title: { bpm: 84, steps: 4, tracks: [","+    { wave: 'pulse', vol: .09, notes: 'E4 - - G4 | B4 - A4 - | G4 - E4 - | - - - . | D4 - - E4 | G4 - F#4 - | E4 - - - | . . . . | E4 - - G4 | B4 - D5 - | C5 - B4 - | A4 - - . | G4 - F#4 - | E4 - D4 - | E4 - - - | . . . .' },","+    { wave: 'triangle', vol: .16, notes: 'E2 . E2 . | E2 . . E2 | C2 . C2 . | C2 . . C2 | D2 . D2 . | D2 . . D2 | E2 . E2 . | B1 . . . ' },","+    { wave: 'drums', vol: .08, notes: 'k . . . | . . h . | k . . k | . . h . ' }","+  ] },","+  // the town: a laid-back bassline, a guitar-ish lead that says \"nothing to see here\"","+  town: { bpm: 96, steps: 4, tracks: [","+    { name: 'lead', wave: 'pulse12', vol: .07, notes: 'A4 . C5 . | E5 - D5 . | C5 . A4 . | G4 - - . | A4 . C5 . | E5 - G5 . | F5 . E5 . | D5 - - . | . . . . | . . . . | E5 . D5 . | C5 - A4 . | B4 . G4 . | A4 - - - | . . . . | . . . .' },","+    { name: 'bass', wave: 'triangle', vol: .18, notes: 'A2 . A2 E2 | A2 . G2 . | F2 . F2 C2 | F2 . G2 . ' },","+    { name: 'drums', wave: 'drums', vol: .09, notes: 'k . h . | s . h k | k . h . | s . h h ' },","+    { name: 'tension', wave: 'saw', vol: .05, on: false, notes: 'A3 - - - | G#3 - - - | A3 - - - | A#3 - - - ' }","+  ] },","+  // the cook: a pulsing arpeggio, science montage","+  cook: { bpm: 128, steps: 4, tracks: [","+    { wave: 'square', vol: .06, notes: 'E4 G4 B4 E5 | B4 G4 E4 G4 | C4 E4 G4 C5 | G4 E4 C4 E4 | D4 F#4 A4 D5 | A4 F#4 D4 F#4 | B3 D#4 F#4 B4 | F#4 D#4 B3 D#4' },","+    { wave: 'triangle', vol: .17, notes: 'E2 - E3 . | E2 - E3 . | C2 - C3 . | C2 - C3 . | D2 - D3 . | D2 - D3 . | B1 - B2 . | B1 - B2 . ' },","+    { wave: 'drums', vol: .08, notes: 'k h s h | k h s h | k h s h | k k s o ' }","+  ] },","+  // a fight: driving, minor, urgent","+  fight: { bpm: 150, steps: 4, tracks: [","+    { wave: 'saw', vol: .06, notes: 'E4 . E4 G4 | . E4 A4 . | E4 . E4 G4 | . B4 A4 G4 | D4 . D4 F4 | . D4 G4 . | D4 . D4 F4 | . A4 G4 F4 ' },","+    { wave: 'triangle', vol: .2, notes: 'E2 E2 E3 E2 | E2 E3 E2 E2 | D2 D2 D3 D2 | D2 D3 D2 D2 ' },","+    { wave: 'drums', vol: .1, notes: 'k . s . | k k s . | k . s . | k k s s ' }","+  ] },","+  // a boss: heavy, slow-stepping, a chromatic menace","+  boss: { bpm: 120, steps: 4, tracks: [","+    { wave: 'square', vol: .07, notes: 'E4 - F4 - | E4 - D#4 - | E4 - G4 - | F#4 - F4 - | E4 - F4 - | E4 - D#4 - | B4 - A#4 - | A4 - G#4 - ' },","+    { wave: 'saw', vol: .06, notes: 'E2 E2 . E2 | F2 . E2 . | E2 E2 . E2 | A#1 . B1 . ' },","+    { wave: 'drums', vol: .11, notes: 'k . k s | . k s . | k . k s | k s s s ' }","+  ] },","+  // the ending: somber, slow, in A minor, then a held note","+  ending: { bpm: 70, steps: 4, tracks: [","+    { wave: 'triangle', vol: .12, notes: 'A4 - - - | C5 - B4 - | A4 - - - | E4 - - - | F4 - - - | E4 - D4 - | E4 - - - | - - - - | A4 - - - | C5 - D5 - | E5 - - - | D5 - C5 - | B4 - - - | G#4 - - - | A4 - - - | - - - - ' },","+    { wave: 'pulse12', vol: .05, notes: 'A2 . E3 . | A2 . E3 . | F2 . C3 . | F2 . C3 . | D2 . A2 . | E2 . B2 . | A2 . E3 . | A2 . . . ' }","+  ] }","+};","+let songNow = null;","+const music = (id, o) => { if (songNow === id) return; songNow = id; A.music(id ? SONGS[id] : null, o); };","+","+/* ---------------- shared helpers ---------------- */","+const fmt$ = n => '$' + Math.round(n).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');","+const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);","+const angTo = (a, b) => Math.atan2(b.y - a.y, b.x - a.x);","+const choose = (rnd, list) => list[Math.floor(rnd() * list.length) % list.length];","+let rnd = Math.random;                     // the hub round swaps in AIHub.rng('deal')","+const LOG = [];                            // a short event log the tests read","+const log = (k, v) => { LOG.push([k, v]); if (LOG.length > 300) LOG.shift(); };"]}],"created":true}],"moreFiles":18,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181307__x22cc1b/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181307__x22cc1b/work/Re