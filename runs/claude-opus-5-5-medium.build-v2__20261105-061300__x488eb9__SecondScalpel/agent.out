x.reset(cg);\",\"st.bake(cg, W, H); finish(cg, W, H, st.warm); px.reset(cg);\")\nsub(st,\"const cache = new Map();\\nG.drawStage\",\"// the bake's last pass: light falling off down the room and into the corners, in many fine steps\\nconst finish = (g, W, H, warm) => { for (let y = 0; y < H; y += 2) { const k = Math.abs(y / H - .42); px.blend(g, Math.min(.5, k * k * 1.3), 'normal', () => px.rect(g, 0, y, W, 2, warm ? '#1a0c08' : '#040c14')); } for (let x = 0; x < W; x += 3) { const k = Math.abs(x / W - .5) * 2; px.blend(g, k * k * k * .45, 'normal', () => px.rect(g, x, 0, 3, H, '#02060a')); } for (let i = 0; i < 26; i++) { const a = (i * 37.7) % 1, b = (i * 91.3) % 1; px.blend(g, .018 + i * .0012, 'add', () => px.disc(g, W * a, H * b * .7, 22 + i * 3, warm ? '#402818' : '#143040')); } };\\nG.stageFinish = finish;\\nconst cache = new Map();\\nG.drawStage\")\ns=open(st).read()\nfor k in ['office','gala','chapel']: s=s.replace(\"  %s: { bake\"%k,\"  %s: { warm: true, bake\"%k)\nopen(st,'w').write(s)\nfl='src/scenes/flow.js'\nsub(fl,\"draw(r) { const p = this.pages[this.i]; r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#06161a');\",\"draw(r) { const p = this.pages[this.i]; r.overlay(g => { G.drawStage(g, 'radiology', r.W, r.H, this.t); px.blend(g, .84, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#06161a'));\")\nsub(fl,\"font.title(g, G.GAME_TITLE, W / 2, logoY,\",\"for (let y = 0; y < H; y += 2) { const k = Math.abs(y / H - .5) * 2; px.blend(g, k * k * .4, 'normal', () => px.rect(g, 0, y, W, 2, '#02060c')); } px.blend(g, .1, 'add', () => { px.disc(g, bx, by - 50, 120, '#c89048'); px.disc(g, bx, by - 50, 70, '#c89048'); }); font.title(g, G.GAME_TITLE, W / 2, logoY,\")\nEOF\necho \"23 starting a case part-way (dev Jump, deep link) skipped strains whose nests or worms an earlier phase spawned: found by a filmstrip; carried now. 24 look notes: stages and About too flat, few colors: added a light pass\" >> notes/feedback.md\nnode tools/build.mjs; H=$(cd .. && pwd)/SecondScalpe