tlock smirks. Minus ten seconds.'; this.smirk = 2;\")\nsub(fl,\"if (this.stage === 'lightbox') { const L = this.c.lightbox,\",\"if (this.stage === 'lightbox') { if (this.smirk > 0) this.smirk -= dt; const L = this.c.lightbox,\")\nsub(fl,\"px.reset(g); g.drawImage(b, 28, 16, 56, 76, 16 + OX, 90 + OY, 56, 76); px.reset(g); px.rect(g, 340 + OX\",\"px.reset(g); g.drawImage(this.smirk > 0 ? G.bust('percy', 'smile') : b, 28, 16, 56, 76, 16 + OX, 90 + OY, 56, 76); px.reset(g); px.rect(g, 340 + OX\")\n# lab: unlocked so far\nsub(fl,\"phase: d.phase, assistPlus: assist });\",\"phase: d.phase, assistPlus: assist, level: G.prog.unlocked.length });\")\nc='src/core/op.js'\nsub(c,\"if (o.clockBonus) S.clock += o.clockBonus;\",\"if (o.clockBonus) S.clock += o.clockBonus; S.level = o.level === undefined ? 99 : o.level;\")\nc4='src/data/cases/ch4.js'\ns=open(c4).read()\ns=s.replace(\"defScript('labEnter', S => { S.lacOpt = true; S.ph.d.timers = {}; for (const sp of LAB) G.spawn(S, Object.assign({ lab: LAB.indexOf(sp) }, sp)); });\",\"const LAB_AT = [1, 1, 1, 2, 2, 2, 2, 6, 4], labOn = (S, i) => S.level >= LAB_AT[i];\\ndefScript('labEnter', S => { S.lacOpt = true; S.ph.d.timers = {}; LAB.forEach((sp, i) => { if (labOn(S, i)) G.spawn(S, Object.assign({ lab: i }, sp)); }); });\")\ns=s.replace(\"LAB.forEach((sp, i) => { const alive = S.objs.some(o => !o.dead && o.lab === i);\",\"LAB.forEach((sp, i) => { if (!labOn(S, i)) return; const alive = S.objs.some(o => !o.dead && o.lab === i);\")\nopen(c4,'w').write(s)\n# Code Blue paddles, pool creep\nh='src/ui/hud.js'\nsub(h,\"const inp = view.seats[0] && view.seats[0].input; if (inp) { const y1 = y0 + 50;\",\"const pj = c.res.length && c.t % c.per < .12 ? 2 : 0; for (const s of [-1, 1]) { const px0 = W / 2 + s * 90 - 11, py0 = 62 - pj; px.rect(g, px0, py0, 22, 12, '#c8d4dc'); px.rect(g, px0 + 2, py0 + 12, 18, 3, '#ffd060'); px.rect(g, px0 + 8, py0 - 8, 6, 8, '#3a4048'); px.rect(g, px0 + 4, py0 - 11, 14, 4, '#c82a2a'); } const inp = view.seats[