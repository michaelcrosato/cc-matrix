eal DualSense, or end the goal with `/goal clear`."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1473,"cache_read_input_tokens":792540,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1473},"output_tokens":655,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"3deae3e5-e3e9-4b15-89b7-b4e2a04115c2","timestamp":"2026-11-05T22:01:40.340Z","request_id":"req_011CgkXyD4qwkrFzTH86NCMW"}
