 const f = () => { const [q, r] = hit({ drain: 1 }), v = q.v; r.step(1); return v - q.v; }; return slide('drainX', 3, f) > f() * 2.5; },\n    slipX: () => { const f = () => { const [q, r] = hit(), v = q.v; r.use('scalpel').at(150, 90).press().line(170, 90, 100); return v - q.v; }; return slide('slipX', 3, f) > f() * 2; },\n    healX: () => { const f = () => { const q = mk(); q.v = 10; G.heal(q, 10); return q.v; }; return slide('healX', 3, f) === 40; },\n    syringeDose: () => slide('syringeDose', 2, dose) > dose() + 10,\n    clockX: () => slide('clockX', 2, () => mk().clock) === 1000,\n    cursorSpeed: () => slide('cursorSpeed', 600, () => curMove({ stick: [1, 0] })) > curMove({ stick: [1, 0] }) * 1.5,\n    fineFactor: () => slide('fineFactor', 1, () => curMove({ stick: [1, 0], fine: true })) > curMove({ stick: [1, 0], fine: true }) * 2,\n    stickCurve: () => slide('stickCurve', 3, () => curMove({ stick: [.5, 0] })) < curMove({ stick: [.5, 0] }) * .7,\n    assist: () => { const f = () => { const q = G.Op.create('t', { seed: 1 }); q.ev = []; const o = add(q, { t: 'guide', pts: [[100, 100], [300, 100]] }); q.players[0].hold = { k: 'cut', id: o.id }; const c = G.Cursor.create(100, 100), d = G.Cursor.emptyDevice(); d.stick = [.7, .7]; for (let i = 0; i < 60; i++) G.Cursor.update(c, q.players[0], d, q, dt); return c.y - 100; }; return slide('assist', 1, f) < slide('assist', 0, f) * .6; },\n    magnetR: () => { const f = () => { const q = mk(); add(q, { t: 'shard', x: 150, y: 100, a: 0 }); const c = G.Cursor.create(120, 100), d = G.Cursor.emptyDevice(); for (let i = 0; i < 120; i++) G.Cursor.update(c, q.players[0], d, q, dt); return c.x; }; return slide('magnetR', 50, f) > 140 && slide('magnetR', 0, f) === 120; },\n    gradeTol: () => { const f = () => { const q = mk(), r = new Run(q), o = add(q, { t: 'shard', x: 200, y: 110, a: 0, depth: 30 }); r.use('forceps').at(200, 110).press().line(240, 110, 150); return o.pull.tears; }; return slide('gradeTol', 3, f) === 0 && f() >= 1; },\n    strainSpeed: () => { const f = () => { const q = mk(), o = add(q, { t: 'legato', route: [[50, 100], [380, 100]], s: 10, noSlur: true }), r = new Run(q); r.step(1); return o.s; }; return slide('strainSpeed', 2, f) > f() + 20; },\n    strainHealth: () => slide('strainHealth', 3, () => { const q = mk(); return add(q, { t: 'bead', x: 1, y: 1 }).burn; }) > .3,\n    spawnRate: () => { const f = () => { const q = mk(); q.flags.swarm = true; add(q, { t: 'nest', x: 100, y: 100, hidden: false }); const r = new Run(q); r.step(3); return q.objs.filter(o => o.type === 'bead').length; }; return slide('spawnRate', 3, f) > f(); },\n    strainDamage: () => { const f = () => { const q = mk(), r = new Run(q), v = q.v; add(q, { t: 'bead', x: 200, y: 100, req: false }); r.step(4); return v - q.v; }; return slide('strainDamage', 3, f) > f() * 1.5; },\n    staccatoBeat: () => { const f = () => { const q = mk(), r = new Run(q); add(q, { t: 'bead', x: 200, y: 100, req: false }); r.step(6); return r.ev.bite || 0; }; return slide('staccatoBeat', .4, f) > f(); },\n    chargeX: () => slide('chargeX', 0, () => { const [q, r] = hit(); r.step(2); return q.steady; }) === 0,\n    breathDrain: () => slide('breathDrain', 40, () => breath()[1]) > breath()[1] * 2,\n    breathFactor: () => Math.abs(slide('breathFactor', .5, () => breath()[0]) - .5) < .02,\n    lookSeconds: () => { const f = () => { const q = mk('ts'), r = new Run(q); r.step(9); q.steady = 90; r.step(dt, { gift: true }); return q.ghosts.dur; }; return slide('lookSeconds', 3, f) === 3 && f() === 6; },\n    bleedX: () => { const f = () => { const q = mk(), r = new Run(q), o = add(q, { t: 'bleeder', x: 100, y: 100 }); r.step(1); return q.objs.filter(p => p.type === 'pool').reduce((a, p) => a + p.vol, 0); }; return slide('bleedX', 3, f) > f() * 2; },\n    suctionRate: () => slide('suctionRate', 200, () => { const q = mk(), o = add(q, { t: 'pool', x: 100, y: 100, vol: 90 }), r = new Run(q); r.use('suction').at(100, 100).press(); r.step(.6); return o.dead; }),\n    cauteryHeat: () => { const f = () => { const q = mk(), r = new Run(q); r.use('cautery').at(100, 100).press(); r.step(.5); return q.players[0].heat; }; return slide('cauteryHeat', 1, f) > f() * 1.5; },\n  };\n  for (const pg of G.TUNING_PAGES) for (const row of pg.rows) { check('slider has an effect test: ' + row.key, !!eff[row.key]); if (eff[row.key]) { let ok = false, why = ''; try { ok = eff[row.key](); } catch (e) { why = e.message; } check('slider changes behavior live: ' + row.key, ok, why); } check('slider has a default mark and range: ' + row.key, row.v >= row.min && row.v <= row.max); }\n  { const K = G.CHEATS; K.radii = true; check('show hit radii is on', G.cheating()); K.radii = false; const j = D.tab; D.tab = 1; const rows = D.rows().rows, sl = rows.find(r => r.label.startsWith('Slow motion')); const t0 = game.timeScale; sl.act(); check('slow motion steps timeScale', game.timeScale !== t0, game.timeScale); while (game.timeScale !== 1) sl.act(), D.rows(); D.tab = 0; const AS = G.Op.create('c1', { seed: 3 }); AS.ev = []; K.auto = true; const seat = { pid: 0, input: game.input }, V = new G.OpView(game, AS, { seats: [seat] }); for (let i = 0; i < 240; i++) V.update(dt); const shards0 = AS.objs.filter(o => o.type === 'shard').length; K.auto = false; check('autosurgeon takes over', shards0 < 8, shards0); }\n\"\"\"+s[b:]\n# determinism with draw\ns=s.replace(\"check('same seed and inputs give the same hash twice', run2() === run2());\",\"check('same seed and inputs give the same hash twice', run2() === run2());\\n{ const P = load({ draw: true }), Gd = P.G, g = P.game; g.fadeTime = 0; g.advance(.3); const S = Gd.Op.create('c8', { seed: 11, phase: 1 }), bot = new Gd.Bot({ seed: 3 }), seat = { pid: 0, bot }; g.go('op', { caseId: 'c8', S, seats: [seat], mode: 'files' }); for (let i = 0; i < 40; i++) g.advance(.05); check('drawing runs in the op with no errors', !g.errors.length); const r = () => { const q = Gd.Op.create('c8', { seed: 11, phase: 1 }), b = new Gd.Bot({ seed: 3 }), cur = Gd.Cursor.create(), wh = Gd.Wheel.create(); q.ev = []; for (let i = 0; i < 1200; i++) { const p = q.players[0], d = b.update(q, p, cur, dt); Gd.Cursor.update(cur, p, d, q, dt); Gd.Op.step(q, [Gd.buildInput(cur, Gd.Wheel.update(wh, p.toolNext, d, dt), d)], dt); q.ev = []; } return Gd.stateHash(q); }; check('the same hash with draw on: draw changes nothing', r() === run2()); }\")\n# attract exit, each device\ns=s.replace(\"game.go('about', { back: 'menu' }); game.advance(.4); game.advance(11);\",\"\"\"for (const [nm, act] of [['key', () => game.input.tap('confirm')], ['mouse move', () => { game.input.mouse.t = (game.input.mouse.t || 0) + 1; }], ['click', () => game.input.feed('down', 50, 50) || game.input.feed('up', 50, 50)], ['stick', () => { game.input.padAim = [.9, 0]; }]]) { game.go('title'); game.advance(.4); game.advance(10.3); check('attract before ' + nm, G.sceneName(game.scene) === 'attract', G.sceneName(game.scene)); game.advance(.6); act(); game.advance(.1); game.input.padAim = null; game.advance(.4); check(nm + ' exits attract to the title', G.sceneName(game.scene) === 'title', G.sceneName(game.scene)); }\ngame.go('about', { back: 'menu' }); game.advance(.4); game.advance(11);\"\"\")\nopen(t,'w').write(s)\nb='tests/browser.py'\nsub(b,\"pg.evaluate(SIM); pg.wait_for_timeout(12000); pg.evaluate(\\\"() => GAME.game.go('ward', { map: 'ward3', after: 2 })\\\"); pg.wait_for_timeout(5000); pg.evaluate(\\\"() => GAME.game.go('story', { id: 'c3_before', then: () => {} })\\\"); pg.wait_for_timeout(5000)\",\"pg.evaluate(SIM); pg.wait_for_timeout(15000); pg.evaluate(\\\"() => GAME.game.go('ward', { map: 'ward3', after: 2 })\\\"); pg.wait_for_timeout(7500); pg.evaluate(\\\"() => GAME.game.go('story', { id: 'c3_before', then: () => {} })\\\"); pg.wait_for_timeout(7500)\")\n# sizes: HUD inside, cavity centered\nsub(b,\"check(f'{w}x{h}: at least 426 x 240, no errors', s['W'] >= 426 and s['H'] >= 240 and not s['e'], s