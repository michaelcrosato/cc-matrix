{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjrHqXAusFQTZNhfR8x1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B77n4ucvJUV422Dzu9QzKB","name":"Bash","input":{"command":"cat > src/core/op.js <<'EOF'\n// The operation: one JSON-safe state object S, stepped by plain inputs. Rewinds, checkpoints and the network all rest on that.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, clone, rnd } = G, T = G.T;\nconst O = o => G.OBJ[o.type];\nG.CASES = G.CASES || {}; G.CASE_ORDER = G.CASE_ORDER || [];\nG.defCase = c => { G.CASES[c.id] = c; if (c.number) { G.CASE_ORDER.push(c.id); G.CASE_ORDER.sort((a, b) => G.CASES[a].number - G.CASES[b].number); } return c; };\nG.Scripts = G.Scripts || {};\nG.defScript = (n, f) => { G.Scripts[n] = f; };\nconst RT = new WeakMap(); const rt = S => { let r = RT.get(S); if (!r) RT.set(S, r = { ring: [], ckpt: null, ringT: 0, fails: {} }); return r; };\nconst mkPlayer = (id, color, x = 213, y = 116) => ({ id, color, x, y, lastX: x, lastY: y, spd: 0, tool: 'forceps', toolNext: 'forceps', swapT: 0, trigPrev: 0, hold: null, heat: 0, lockT: 0, fill: 0, overT: 0, coolT: 0, bareT: 0, drag: 0, tension: 0, nerveT: 0, near: 0, score: 0, stats: { textbook: 0, clean: 0, sloppy: 0, slips: 0, stitches: 0, suction: 0, burns: 0 }, gone: false });\nconst Op = G.Op = {\n  create(c, o = {}) { if (typeof c === 'string') c = G.CASES[c];\n    const diffId = o.difficulty || 'resident', diff = G.DIFFS[diffId], clockX = c.noClockScale ? 1 : diff.clock * T.clockX;\n    const players = o.players || [{ id: 0, color: G.SEATS[0] }];\n    const S = { caseId: c.id, seed: o.seed === undefined ? 1 : o.seed, rng: (o.seed === undefined ? 1 : o.seed) >>> 0, diffId, diff: { iv: diff.iv, drain: diff.drain, hints: diff.hints, codeBlue: diff.codeBlue, assist: diff.assist }, t: 0, ht: 0, v: c.vitals, clock: c.clock * clockX, clock0: c.clock * clockX, drain: c.drain, phaseI: -1, ph: { t: 0, si: 0, d: {} }, objs: [], nextId: 1, players: players.map(q => mkPlayer(q.id, q.color)), steady: o.steady || 0, breath: false, doc: c.doc === 'both' ? 'soko' : c.doc || 'vale', docs: c.doc === 'both' ? ['vale', 'soko'] : [c.doc || 'vale'], consultT: 0, flow: 0, bestFlow: 0, slips: 0, acts: { sloppy: 0, clean: 0, textbook: 0 }, score: 0, flags: {}, marks: [], tut: null, tip: null, codeBlue: null, codeUsed: false, closing: null, done: null, ev: [], ghosts: null, rwT: 0, out: { recap: 0, rewinds: 0, lurched: false }, sinceBeat: 0, beatLen: .9, windowOpen: true, capB: false, assistTol: 0, tilt: null, dim: 0, hush: false, static: false, silent: false, aura: null, markers: o.markers || [], lock: !!o.lock, lab: !!c.lab, attract: !!o.attract, bomb: !!c.bomb, noLac: false, stage: 0, ringOn: c.doc !== 'vale' && c.id !== 'grandrounds', dressBonus: 0, finalScore: 0, N: players.length };\n    if (o.clockBonus) S.clock += o.clockBonus;\n    S.assistTol = clamp((T.assist + diff.assist + (o.assistPlus || 0)) * 1, 0, 1);\n    for (const m of S.markers) void m;\n    Op.enterPhase(S, o.phase || 0); return S; },\n  caseOf: S => G.CASES[S.caseId],\n  phaseOf: S => G.CASES[S.caseId].phases[S.phaseI],\n  enterPhase(S, i) { const c = Op.caseOf(S), ph = c.phases[i]; S.phaseI = i; S.ph = { t: 0, si: 0, d: {} }; S.tip = null; S.tut = null; S.stage = i;\n    if (c.lab) S.clock = S.clock0;\n    if (ph.clockAdd) S.clock += ph.clockAdd * (S.diffId === 'intern' ? 1.3 : S.diffId === 'attending' ? .8 : 1);\n    if (ph.spawn) for (const sp of ph.spawn) G.spawn(S, sp);\n    if (ph.enter) G.Scripts[ph.enter](S, ph);\n    if (ph.tut && !S.attract) S.tut = { verb: ph.tut.verb, text: ph.tut.text };\n    if (ph.tip) S.tip = clone(ph.tip);\n    ev(S, 'phase', i); rt(S).ckpt = clone(Object.assign({}, S, { ev: [] })); },\n  // Hazards still open: the phase's 'clear' test, and table 7's drains\n  openReq: S => S.objs.some(o => !o.dead && o.req && (o.type !== 'pool' || o.vol > 2)),\n  drainNow(S) { let n = S.drain; for (const o of S.objs) if (!o.dead) { const d = O(o); if (G.inDome(S, o.x, o.y)) continue; n += d.drainOf ? d.drainOf(o, S) : d.drain; } return n * S.diff.drain * T.drainX; },\n  // Where the held tool could act: for the magnet, prompts, hints and the bot\n  targets(S, tool) { const out = []; for (const o of S.objs) { if (o.dead || !G.canTouch(S, o)) continue; const d = O(o); let w = d.want ? d.want(o, S) : null; if (w === tool) out.push({ o, at: d.aim ? d.aim(o, S) : [o.x, o.y], verb: d.verb }); } return out; },\n  nextTarget(S) { let best = null, score = 1e9; for (const o of S.objs) { if (o.dead || !G.canTouch(S, o)) continue; const d = O(o), w = d.want ? d.want(o, S) : null; if (!w) continue; if (!o.req && o.type !== 'pool') continue; const k = o.type === 'pool' ? (o.req ? 1 : 2) : (d.drainOf ? 3 - d.drainOf(o, S) : 3 - d.drain); if (k < score) { score = k; best = { o, tool: w, at: d.aim ? d.aim(o, S) : [o.x, o.y] }; } } if (!best) for (const o of S.objs) if (!o.dead && o.hidden && !(o.mark > 0) && !G.CHEATS.reveal) return { o, tool: 'sonar', at: [o.x, o.y] }; return best; },\n  step(S, inputs, dt) { if (S.done) return;\n    if (G.CHEATS.infiniteSteady) S.steady = 100;\n    if (S.rwT > 0) { S.rwT -= dt; S.players.forEach((p, i) => { const q = inputs[i]; if (q && !p.gone) { p.lastX = p.x = q.x; p.lastY = p.y = q.y; p.trigPrev = q.trig; } }); return; }\n    if (S.codeBlue) return stepCode(S, inputs, dt);\n    if (S.closing) return stepClosing(S, inputs, dt);\n    if (S.out.hold > 0) { S.out.hold -= dt; if (S.out.hold <= 0) G.Scripts[S.out.holdDone](S); return; }\n    S.ht += dt;\n    if (S.consultT > 0) { S.consultT -= dt; if (S.consultT <= 0) { S.doc = S.docNext; ev(S, 'consulted', S.doc); } }\n    S.players.forEach((p, i) => { const q = inputs[i]; if (!q || p.gone) return; if (q.gift) gift(S, p); if (q.consult && S.docs.length > 1 && S.consultT <= 0) { S.docNext = S.doc === 'vale' ? 'soko' : 'vale'; S.consultT = .4; if (S.breath) S.breath = false; G.releaseHold(S, p); ev(S, 'consult', S.docNext); G.didVerb(S, 'consult'); } });\n    if (S.rwT > 0) return;   // (a Second Look just began)\n    if (S.breath) { S.steady -= T.breathDrain * dt; if (S.steady <= 0) { S.steady = 0; S.breath = false; ev(S, 'breathoff'); } }\n    const w = dt * (S.breath ? T.breathFactor : 1); S.w = w;\n    S.t += w; S.ph.t += w; if (!S.breath) G.charge(S, .5 * dt);\n    S.sinceBeat += w; S.beatLen = 60 / (56 + (99 - S.v) * .55 + (Op.caseOf(S).bpmUp || 0)); if (S.sinceBeat >= S.beatLen) { S.sinceBeat -= S.beatLen; ev(S, 'beat'); }\n    S.players.forEach((p, i) => { const q = inputs[i]; if (q && !p.gone) G.toolStep(S, p, q, dt); });\n    S.aura = null;\n    for (let k = 0; k < S.objs.length; k++) { const o = S.objs[k]; if (o.dead) continue; o.age += w; if (o.mark > 0) o.mark -= w; const d = O(o); if (d.step) d.step(o, S, w, dt); if (d.drift !== false && S.tilt && o.loose) { o.x = clamp(o.x + S.tilt[0] * 12 * w, 60, 366); o.y = clamp(o.y + S.tilt[1] * 12 * w, 40, 192); if (o.pull) { o.bx = o.x; o.by = o.y; } } }\n    if (!S.tut) { if (!(G.CHEATS.freezeClock || S.lab)) S.clock -= w; G.hurt(S, Op.drainNow(S) * w); }\n    if (S.aura) { G.hurt(S, .6 * S.aura.amp * w); }\n    const ph = Op.phaseOf(S);\n    if (ph.script) while (S.ph.si < ph.script.length && S.ph.t >= ph.script[S.ph.si].t) { const a = ph.script[S.ph.si++]; G.Scripts[a.do](S, a); }\n    if (ph.step) G.Scripts[ph.step](S, ph, w, dt);\n    S.objs = S.objs.filter(o => !o.dead);\n    if (S.lab) { S.v = Math.max(S.v, 60); }\n    if (S.done) return;\n    // done with the phase?\n    if (phaseDone(S, ph)) { const c = Op.caseOf(S); if (ph.leave) G.Scripts[ph.leave](S, ph); if (S.rwT > 0 || S.codeBlue) return; if (S.phaseI + 1 < c.phases.length) { S.flow = S.flow; ev(S, 'phasedone', S.phaseI); Op.enterPhase(S, S.phaseI + 1); } else startClosing(S); return; }\n    if (S.ringOn) { const r = rt(S); r.ringT += w; if (r.ringT >= .1) { r.ringT -= .1; r.ring.push(snap(S)); const cap = T.lookSeconds * 10 + 12; if (r.ring.length > cap) r.ring.shift(); } }\n    if (S.clock <= 0 && !G.CHEATS.freezeClock) { S.clock = 0; return lost(S, S.bomb ? 'bomb' : 'time'); }\n    if (S.bomb && S.v < 25 && !G.CHEATS.lockVitals && !S.lock && !S.tut) return lost(S, 'bomb');\n    if (S.v <= 0 && !G.CHEATS.lockVitals && !S.lock) { if (S.diff.codeBlue && !S.codeUsed && !S.bomb) startCode(S); else lost(S, 'vitals'); } },\n  checkpoint: S => rt(S).ckpt,\n  // Retry from this phase: the phase's starting state, its rank capped at B\n  retry(S) { const r = rt(S), c = r.ckpt, f = (r.fails[c.phaseI] || 0) + 1, ring = r.ring; for (const k in S) delete S[k]; Object.assign(S, clone(c)); S.capB = true; S.done = null; S.ev = []; r.ring = []; r.ringT = 0; r.fails[S.phaseI] = f; ring.length = 0; return f; },\n  fails: S => rt(S).fails[S.phaseI] || 0,\n  ringOf: S => rt(S).ring,\n  reverseOf: S => rt(S).reverse || [],\n  rewind(S, secs, forced) { const r = rt(S), ring = r.ring; if (!ring.length) return false; const target = S.t - secs; let i = 0; while (i < ring.length - 1 && ring[i].t < target) i++;\n    const snapTo = ring[i], frames = ring.slice(i).map(f => ({ p: f.players.map(q => [Math.round(q.x), Math.round(q.y)]), s: f.objs.filter(o => O(o).ghost && !o.dead).map(o => [o.type, Math.round(o.x), Math.round(o.y), o.open ? 1 : 0, o.id]) }));\n    r.reverse = ring.slice(i); r.pre = forced ? snap(S) : null;\n    const keep = { steady: S.steady, out: S.out, doc: S.doc, ev: S.ev, players: S.players.map(p => ({ x: p.x, y: p.y, tool: p.tool, toolNext: p.toolNext, trigPrev: p.trigPrev, spd: 0, gone: p.gone })) };\n    for (const k in S) delete S[k]; Object.assign(S, clone(snapTo)); S.ev = keep.ev; S.steady = keep.steady; S.out = keep.out; S.doc = keep.doc; S.breath = false; keep.out.rewinds++;\n    S.players.forEach((p, k) => { Object.assign(p, keep.players[k], { hold: null, lastX: keep.players[k].x, lastY: keep.players[k].y, tension: 0, fill: 0, overT: 0 }); });\n    S.ghosts = { t: 0, dur: secs, fr: frames }; S.rwT = 1.2; r.ring = ring.slice(0, i + 1); ev(S, 'rewind', forced ? 1 : 0); return true; },\n  // Cantor's rewind undone: the world as it stood before the forced rewind\n  counter(S) { const r = rt(S); if (!r.pre) return false; const pre = r.pre; r.pre = null; const keep = { steady: S.steady, out: S.out, ev: S.ev, doc: S.doc, players: S.players.map(p => ({ x: p.x, y: p.y, tool: p.tool, toolNext: p.toolNext, trigPrev: p.trigPrev })) }; for (const k in S) delete S[k]; Object.assign(S, clone(pre)); Object.assign(S, { steady: keep.steady, out: keep.out, ev: keep.ev, doc: keep.doc, rwT: .8 }); S.players.forEach((p, k) => Object.assign(p, keep.players[k], { hold: null })); ev(S, 'rewind', 2); return true; },\n  forceLost(S, why) { lost(S, why || 'vitals'); },\n  forceWin(S) { S.objs = []; S.phaseI = Op.caseOf(S).phases.length - 1; S.done = 'won'; G.finalize(S); ev(S, 'won'); },\n  triggerCode(S) { S.codeUsed = false; S.v = 0; startCode(S); },\n  jumpPhase(S, i) { S.objs = S.objs.filter(o => o.type === 'nerve'); S.tut = null; S.breath = false; Op.enterPhase(S, i); },\n};\nconst snap = S => { const c = {}; for (const k in S) if (k !== 'ev' && k !== 'ghosts') c[k] = clone(S[k]); return c; };\nconst phaseDone = (S, ph) => { const w = ph.when || 'clear'; if (w === 'clear') return !Op.openReq(S); if (w === 'never') return false; if (w.startsWith('flag:')) return !!S.flags[w.slice(5)]; if (w.startsWith('t:')) return S.ph.t >= +w.slice(2); return !!S.ph.d.done; };\nfunction gift(S, p) {\n  if (S.doc === 'vale' || S.caseId === 'grandrounds') { if (S.breath) { S.breath = false; ev(S, 'breathoff'); return; } if (S.steady < 35) { ev(S, 'nogift'); return; } S.breath = true; ev(S, 'breathon', p.id); G.didVerb(S, 'gift'); return; }\n  if (S.steady < 45 || S.caseId === 'grandrounds') { ev(S, 'nogift'); return; }\n  const r = rt(S); if (S.ph.d.counterOpen > 0 && r.pre) { S.steady -= 45; if (Op.counter(S)) { S.out.recap++; S.ph.d.counterOpen = 0; ev(S, 'countered'); G.didVerb(S, 'gift'); } return; }\n  if (!r.ring.length) { ev(S, 'nogift'); return; }\n  S.steady -= 45; if (Op.rewind(S, T.lookSeconds)) G.didVerb(S, 'gift'); }\nfunction lost(S, why) { S.done = 'lost'; S.lostWhy = why; S.breath = false; ev(S, 'lost', why); }\n// Code Blue: a marker crossing the peak; two hits in four attempts\nfunction startCode(S) { S.codeUsed = true; S.breath = false; for (const p of S.players) G.releaseHold(S, p); S.codeBlue = { t: 0, tries: 0, hits: 0, per: .9, flash: 0, done: 0, res: [], pressed: false }; ev(S, 'codeblue'); S.v = 0; }\nfunction stepCode(S, inputs, dt) { const c = S.codeBlue; if (c.done > 0) { c.done -= dt; if (c.done <= 0) { const ok = c.hits >= 2; if (ok) { S.v = 30; S.flags.revived = true; ev(S, 'revived'); } S.codeBlue = null; if (!ok) lost(S, 'vitals'); } return; }\n  c.t += dt; const phase = c.t / c.per, near = Math.round(phase), err = (phase - near) * c.per; if (near > c.tries && err > .14 + (S.assistTol * .03)) { c.tries = near; c.res.push(0); ev(S, 'codemiss'); check(); }\n  let press = false; S.players.forEach((p, i) => { const q = inputs[i]; if (q) { if (q.shock) press = true; p.x = q.x; p.y = q.y; p.trigPrev = q.trig; } });\n  if (press && near >= 1 && near > c.tries) { const a = Math.abs(err), win = .14 + (S.assistTol * .03); c.tries = near; if (a <= win) { c.hits++; c.res.push(a <= .06 ? 2 : 1); ev(S, 'codehit', a <= .06 ? 'textbook' : 'clean'); G.grade(S, S.players[0], 213, 120, a <= .06 ? 'textbook' : 'clean', 'codeblue'); } else { c.res.push(0); ev(S, 'codemiss'); } check(); }\n  function check() { if (c.hits >= 2 || c.tries >= 4 || c.tries - c.hits > 2) c.done = .6; } }\n// The dressing, and the stamp\nfunction startClosing(S) { for (const p of S.players) G.releaseHold(S, p); S.breath = false; S.objs = S.objs.filter(o => o.type === 'nerve'); S.closing = { t: 0, per: 1.5, phase: 'ring', hit: 0, stampT: 0, x: Op.caseOf(S).dressAt ? Op.caseOf(S).dressAt[0] : 213, y: Op.caseOf(S).dressAt ? Op.caseOf(S).dressAt[1] : 116, tries: 0 }; ev(S, 'dressing'); }\nfunction stepClosing(S, inputs, dt) { const c = S.closing; c.t += dt; if (c.phase === 'ring') { const k = c.t / c.per;\n    let press = false; S.players.forEach((p, i) => { const q = inputs[i]; if (q) { p.x = q.x; p.y = q.y; if (q.trig >= .3 && p.trigPrev < .3) press = true; p.trigPrev = q.trig; } });\n    if (press || k >= 1.4) { const err = Math.abs(1 - k), g = !press ? 'late' : err < .08 ? 'textbook' : err < .22 ? 'clean' : 'sloppy'; S.dressBonus = g === 'textbook' ? 60 : g === 'clean' ? 30 : 10; c.g = g; c.phase = 'stamp'; c.t = 0; ev(S, 'stamp', g); }\n  } else if (c.t >= (S.attract ? .5 : 2.6)) { S.done = 'won'; G.finalize(S); ev(S, 'won'); } }\nG.opGift = gift;\n})();\nEOF\ncat > src/core/strains/staccato.js <<'EOF'\n// Staccato: beads hopping on a fixed beat from hidden nests. A closing ring shows each landing .5 s ahead; a landing bites.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, rnd } = G, T = G.T;\nG.defObject('nest', { drain: .2, ghost: true,   // found by Sonar; a slash opens it, Forceps takes it\n  init(o) { o.r = 10; o.hidden = o.hidden !== false; o.mark = 0; o.stayMarked = true; G.mkPull(o, { a: o.a === undefined ? -1.57 : o.a, depth: 14, maxV: 120 }); o.opened = false; o.ontop = true; o.spawnT = 1.5; },\n  want: o => o.opened ? 'forceps' : 'scalpel', canGrip: o => o.opened, slashable: o => !o.opened, verb: 'Slash',\n  slash(o, S, p) { o.opened = true; G.grade(S, p, o.x, o.y, 'clean', 'slash'); },\n  step(o, S, w) { if (!S.flags.swarm) return; o.spawnT -= w * T.spawnRate; if (o.spawnT <= 0) { let n = 0; for (const q of S.objs) if (q.type === 'bead' && !q.dead) n++; o.spawnT = 2.6; if (n < (S.beadCap || 6)) G.spawn(S, { t: 'bead', x: o.x, y: o.y, nest: o.id }); } },\n  gone(o, S) { let left = 0; for (const q of S.objs) if (q.type === 'nest' && !q.dead) left++; if (!left) for (const q of S.objs) if (q.type === 'bead' && !q.dead) q.dieT = 1 + rnd(S) * 2; } });\nG.defObject('bead', { drain: .05, ghost: true,\n  init(o, S) { o.burn = o.burn0 = .12 * T.strainHealth; o.hopT = T.staccatoBeat * (.5 + rnd(S) * .5); o.tx = o.x; o.ty = o.y; o.sx = o.x; o.sy = o.y; o.air = 0; o.ontop = true; o.r = 2; },\n  want: () => 'cautery', verb: 'Burn',\n  aim: o => [o.x, o.y],\n  step(o, S, w) { if (o.dieT !== undefined) { o.dieT -= w; if (o.dieT <= 0) { ev(S, 'pop', Math.round(o.x), Math.round(o.y)); G.kill(S, o); return; } } const sp = T.strainSpeed;\n    o.hopT -= w * sp;\n    if (o.air > 0) { o.air -= w * sp / .5; const k = 1 - clamp(o.air, 0, 1); o.x = o.sx + (o.tx - o.sx) * k; o.y = o.sy + (o.ty - o.sy) * k; o.h = Math.sin(k * 3.14) * 12; if (o.air <= 0) { o.h = 0; o.x = o.tx; o.y = o.ty; ev(S, 'bite', Math.round(o.x), Math.round(o.y)); o.bites = (o.bites || 0) + 1; G.hurt(S, 1 * T.strainDamage); if (rnd(S) < .34) G.addLac(S, o.x, o.y); } return; }\n    if (o.hopT <= 0) { o.hopT = T.staccatoBeat * (1 + (rnd(S) < .3 ? 1 : 0)); const a = rnd(S) * 6.28, d = 24 + rnd(S) * 30; o.sx = o.x; o.sy = o.y; o.tx = clamp(o.x + Math.cos(a) * d, 70, 356); o.ty = clamp(o.y + Math.sin(a) * d * .7, 46, 186); o.air = 1; ev(S, 'tk', Math.round(o.x)); } } });\nG.defScript('swarmOn', S => { S.flags.swarm = true; S.beadCap = Math.max(6, 4 * (S.N || 1)); });\n})();\nEOF\ncat > src/core/strains/legato.js <<'EOF'\n// Legato: a long worm under the tissue, seen as a moving ridge. Cut at a slur mark as it passes; pull, clamp, burn, regrip.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, rnd, polyLen, polyAt } = G, T = G.T;\nconst newSlur = (S, o) => { const d = (o.slurS === undefined ? o.routeLen * .35 : o.slurS), [x, y, a] = polyAt(o.route, d), c = Math.cos(a + 1.57) * 11, s = Math.sin(a + 1.57) * 11; const g = G.spawn(S, { t: 'guide', pts: [[x - c, y - s], [x + c, y + s]], slur: o.id, link: o.id, req: false }); o.slurAt = [x, y]; o.gid = g.id; o.slurS = (d + o.routeLen * .3) % o.routeLen; };\nG.defObject('legato', { drain: .5, ghost: true,\n  init(o, S) { o.routeLen = polyLen(o.route); o.s = o.s || 10; o.dir = 1; o.stage = o.stage || 'under'; o.total = o.total || 150; o.pulled = o.pulled || 0; o.gap = 30; o.sinceBarb = 0; o.ontop = true; o.spd = o.spd || 34; const [x, y] = polyAt(o.route, o.s); o.x = x; o.y = y; o.exit = [x, y]; o.slurs = 0; if (o.stage === 'under' && !o.hidden && !o.noSlur) newSlur(S, o); o.a = -1.57; },\n  want: o => o.stage === 'out' ? 'forceps' : null, canGrip: o => o.stage === 'out', verb: 'Pull',\n  marked(o, S) { S.flags.legato_found = true; if (!o.gid) newSlur(S, o); o.hidden = false; },\n  aim: o => [o.x, o.y],\n  linked(o, S, g, p) { const d = Math.hypot(o.x - o.slurAt[0], o.y - o.slurAt[1]); if (d > 44) { ev(S, 'missed', Math.round(g.x), Math.round(g.y)); newSlur(S, o); return; } o.stage = 'out'; o.exit = [o.slurAt[0], o.slurAt[1]]; o.x = o.exit[0]; o.y = o.exit[1]; o.a = Math.atan2(116 - o.y, 213 - o.x); o.sinceBarb = 0; S.flags.legato_out = true; ev(S, 'surface', Math.round(o.x), Math.round(o.y)); },\n  grip(o, S, p) { p.hold = { k: 'legato', id: o.id, gx: p.x, gy: p.y, last: 0, v: 0, p0: o.sinceBarb }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  held(o, S, p, h) { const H = p.hold, ax = Math.cos(o.a), ay = Math.sin(o.a), along = (p.x - H.gx) * ax + (p.y - H.gy) * ay, v = (along - H.last) / h, lim = (o.maxV || 46) * T.gradeTol; H.last = along; H.v = H.v * .9 + v * .1; p.tension = clamp(H.v / lim, 0, 1.3); o.tens = p.tension;\n    if (H.v > lim) { snap(o, S, p); return; }\n    if (o.stage === 'barb') return;\n    const got = Math.max(0, along) - (H.got || 0); if (got > 0) { H.got = (H.got || 0) + got; o.pulled += got; o.sinceBarb += got; o.x = o.exit[0] + ax * o.sinceBarb; o.y = o.exit[1] + ay * o.sinceBarb; }\n    if (o.pulled >= (o.splitAt || 1e9)) { S.flags.legato_half = true; ev(S, 'split', Math.round(o.x), Math.round(o.y)); G.grade(S, p, o.x, o.y, 'textbook', 'legato'); p.hold = null; p.tension = 0; const left = o.total - o.pulled; G.kill(S, o); G.spawn(S, { t: 'legato', route: o.route, s: (o.s + 40) % o.routeLen, total: left, spd: o.spd * 1.5, maxV: (o.maxV || 46) * 1.15, slurS: (o.s + 60) % o.routeLen }); return; }\n    if (o.pulled >= o.total) { G.grade(S, p, o.x, o.y, 'textbook', 'legato'); S.flags.legato_dead = true; ev(S, 'clink', Math.round(o.x), Math.round(o.y)); p.hold = null; p.tension = 0; G.kill(S, o); return; }\n    if (o.sinceBarb >= o.gap) { o.stage = 'barb'; o.zone = [o.exit[0] + ax * (o.gap + 2), o.exit[1] + ay * (o.gap + 2)]; ev(S, 'barb', Math.round(o.x), Math.round(o.y)); } },\n  release(o, S, p) { p.tension = 0; if (o.stage === 'barb') { if (Math.hypot(p.x - o.zone[0], p.y - o.zone[1]) < 20 + S.assistTol * 4) { o.stage = 'clamped'; ev(S, 'clamp', Math.round(p.x), Math.round(p.y)); G.spawn(S, { t: 'barbspot', x: o.exit[0], y: o.exit[1], worm: o.id }); } else { ev(S, 'slide', Math.round(o.x), Math.round(o.y)); o.pulled = Math.max(0, o.pulled - 8); o.sinceBarb = Math.max(0, o.sinceBarb - 8); o.stage = 'out'; o.x = o.exit[0]; o.y = o.exit[1]; } } else { o.x = o.exit[0] + Math.cos(o.a) * o.sinceBarb; o.y = o.exit[1] + Math.sin(o.a) * o.sinceBarb; } },\n  step(o, S, w) { if (o.stage === 'under' || o.stage === 'flee') { o.s += o.dir * o.spd * w * T.strainSpeed; if (o.s > o.routeLen - 2) { o.s = o.routeLen - 2; o.dir = -1; } if (o.s < 2) { o.s = 2; o.dir = 1; } const q = polyAt(o.route, o.s); o.x = q[0]; o.y = q[1]; } } });\nfunction snap(o, S, p) { p.hold = null; p.tension = 0; G.slip(S, p, o.x, o.y, 5, 'snap'); ev(S, 'snap', Math.round(o.x), Math.round(o.y)); o.stage = 'under'; o.sinceBarb = 0; newSlur(S, o); }\nG.defObject('barbspot', { req: true, init(o) { o.burn = o.burn0 = .4 * T.strainHealth; o.ontop = true; }, want: () => 'cautery', verb: 'Burn',\n  burned(o, S, p, g) { G.grade(S, p, o.x, o.y, g, 'cautery'); const w = G.getObj(S, o.worm); if (w) { w.stage = 'out'; w.sinceBarb = 0; w.x = w.exit[0]; w.y = w.exit[1]; } G.kill(S, o); } });\n// A Legato sliver (Fermata, the Cantor): slash it where it runs, then a short pull\nG.defObject('sliver', { drain: .3, ghost: true,\n  init(o) { o.r = 9; o.ontop = true; o.t0 = o.x * .1; o.cx = o.x; o.cy = o.y; o.slashedIt = false; G.mkPull(o, { a: -1.2, depth: 12, maxV: 90 }); },\n  want: o => o.slashedIt ? 'forceps' : 'scalpel', canGrip: o => o.slashedIt, slashable: o => !o.slashedIt, verb: 'Slash',\n  slash(o, S, p) { o.slashedIt = true; o.bx = o.x; o.by = o.y; G.grade(S, p, o.x, o.y, 'clean', 'slash'); },\n  step(o, S, w) { if (o.slashedIt) return; o.t0 += w * T.strainSpeed * 1.1; o.x = o.cx + Math.cos(o.t0) * 26; o.y = o.cy + Math.sin(o.t0 * 1.7) * 13; o.bx = o.x; o.by = o.y; } });\n})();\nEOF\ncat > src/core/strains/tremolo.js <<'EOF'\n// Tremolo: a shivering web on the beating heart. Sedate reeds in the flare after each beat; burn the mass; pull it, slowly.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, rnd } = G, T = G.T;\nG.defObject('tremolo', { drain: 0, ghost: true,\n  init(o, S) { o.amp = 1; o.stage = 1; o.burn = 0; o.burnMax = 3 * T.strainHealth; o.wake = 6; o.r = 15; o.ontop = true; o.pin = 0; o.free2 = false; o.vp = o.vp || [[150, 80], [190, 110], [230, 130], [270, 120], [300, 90]]; o.vs = 2; o.vd = 1; o.cut = 0; for (let i = 0; i < (o.n || 5); i++) { const a = i / (o.n || 5) * 6.283 - 1.57; G.spawn(S, { t: 'reed', x: o.x + Math.cos(a) * 44, y: o.y + Math.sin(a) * 30, owner: o.id, a }); } },\n  want: o => o.stage === 2 ? (o.free2 && o.pin <= 0 ? 'forceps' : o.amp <= .21 ? 'cautery' : null) : o.stage === 3 ? 'forceps' : null,\n  canGrip: o => o.stage === 3 || (o.stage === 2 && o.free2), verb: 'Burn', burnOk: o => o.stage === 2 && o.amp <= .21,\n  grip(o, S, p) { if (o.stage === 2) { o.pin = 2; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return false; } if (!o.pull) G.mkPull(o, { a: -1.4, depth: 40, maxV: 42, par: 3 }); p.hold = { k: 'pull', id: o.id, gx: p.x, gy: p.y, p0: o.pull.prog, last: 0, v: 0 }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  burned(o, S, p, g) { o.burn = 0; o.stage = 3; G.grade(S, p, o.x, o.y, g, 'cautery'); S.flags.trem3 = true; ev(S, 'crack', Math.round(o.x), Math.round(o.y)); for (const q of S.objs) if (q.type === 'reed') q.dead = true; o.bx = o.x; o.by = o.y; },\n  caught(o, S) { S.flags.tremolo_dead = true; },\n  step(o, S, w, h) { const amp = o.amp; S.aura = { x: o.x, y: o.y, amp, r: 70 }; o.flare = S.sinceBeat < .3;\n    if (o.stage === 1 && amp <= .21) { o.stage = 2; o.burn = o.burnMax; o.burn0 = o.burnMax; ev(S, 'crack', Math.round(o.x), Math.round(o.y)); S.flags.trem2 = true; }\n    if (o.stage === 2) { if (o.pin > 0) o.pin -= w; o.wake -= w; if (o.wake <= 0) { o.wake = 6; for (const q of S.objs) if (q.type === 'reed' && q.sedated && !q.dead) { q.sedated = false; q.dose = true; o.amp = Math.min(1, o.amp + .2); ev(S, 'wake', Math.round(q.x), Math.round(q.y)); break; } }\n      if (!o.free2 && o.burn < o.burnMax / 2) { o.free2 = true; ev(S, 'tearfree', Math.round(o.x), Math.round(o.y)); }\n      if (o.free2 && o.pin <= 0) { o.vs = clamp(o.vs + o.vd * w * .45 * T.strainSpeed, 0, o.vp.length - 1.001); if (o.vs >= o.vp.length - 1.01 || o.vs <= 0) o.vd = -o.vd; const i = o.vs | 0, f = o.vs - i, a = o.vp[i], b = o.vp[i + 1]; o.x = a[0] + (b[0] - a[0]) * f; o.y = a[1] + (b[1] - a[1]) * f; o.cut += w; if (o.cut > 1.8) { o.cut = 0; G.addLac(S, o.x, o.y); } } }\n    else if (o.stage === 3) { o.amp = .08; } },\n});\nG.defObject('reed', { drain: 0, ghost: true, req: false,\n  init(o) { o.dose = true; o.sedated = false; o.ontop = true; o.r = 6; },\n  want: o => o.sedated ? null : 'syringe', verb: 'Inject', step(o, S) { o.open = S.sinceBeat < .3 && !o.sedated; },\n  dosed(o, S, p, g, half) { const m = G.getObj(S, o.owner); if (S.sinceBeat < .3 || S.breath) { o.sedated = true; o.dose = false; if (m) m.amp = Math.max(0, m.amp - (half ? .1 : .2)); G.grade(S, p, o.x, o.y, g, 'dose'); ev(S, 'sedate', Math.round(o.x), Math.round(o.y)); } else { ev(S, 'spit', Math.round(o.x), Math.round(o.y)); G.hurt(S, 2 * T.strainDamage); G.addLac(S, o.x + 6, o.y + 6); } } });\n})();\nEOF\ncat > src/core/strains/dacapo.js <<'EOF'\n// Da Capo: three lobes on a staff, each armor on its own timer. Kill all three inside the countdown or it plays from the top.\n(() => {\nconst G = (window.GAME ||= {}), { ev, rnd } = G, T = G.T;\nconst LOBE = { A: { per: 6, open: 2.5, off: 0 }, B: { per: 7, open: 2.5, off: 2 }, C: { per: 9, open: 3, off: 4 } };\nconst setStage = (o, d) => { o.dead2 = false; o.stageN = 0; o.burn = o.label === 'A' ? 1 * T.strainHealth : 0; o.burn0 = o.burn; o.dose = o.label === 'C'; o.salveT = 0; o.slashedIt = false; o.bx = o.x0; o.by = o.y0; o.x = o.x0; o.y = o.y0; o.pull = null; o.cov = null; };\nG.lobeOpen = (o, S) => { const L = LOBE[o.label], sp = S.ph.d.speed || 1, t = S.t * sp * T.strainSpeed + L.off; return (t % L.per) < L.open * (o.small ? 1.3 : 1); };\nG.lobeNext = (o, S, at = S.t) => { const L = LOBE[o.label], sp = S.ph.d.speed || 1, t = at * sp * T.strainSpeed + L.off, m = t % L.per; return m < L.open ? 0 : (L.per - m) / (sp * T.strainSpeed); };\nG.defObject('dacapo', { req: true, drain: .1,\n  init(o, S) { o.cd = -1; o.round = o.round || 1; o.ontop = true; o.lobes = []; o.regrew = 0; const px = [o.x - 74, o.x, o.x + 74], py = [o.y + 12, o.y - 18, o.y + 12]; ['A', 'B', 'C'].forEach((l, i) => { const q = G.spawn(S, { t: 'lobe', x: px[i], y: py[i], label: l, owner: o.id, small: !!o.small }); o.lobes.push(q.id); }); S.ph.d.speed = o.round > 1 ? 2 : 1; },\n  want: () => null,\n  step(o, S, w) { const L = o.lobes.map(id => G.getObj(S, id)).filter(Boolean), dead = L.filter(q => q.dead2).length; if (dead && o.cd < 0) { o.cd = (o.window || 10); ev(S, 'countdown'); } if (o.cd >= 0) { o.cd -= w; if (dead === L.length) { ev(S, 'fine', o.round); S.flags['dacapo_r' + o.round] = true; for (const q of L) q.dead = true; G.kill(S, o); return; } if (o.cd <= 0) { o.cd = -1; o.regrew++; G.hurt(S, 8 * T.strainDamage); ev(S, 'dacapo', Math.round(o.x), Math.round(o.y)); for (const q of L) if (q.dead2) setStage(q); } } } });\nG.defObject('lobe', { req: false, drain: 0, ghost: true,\n  init(o, S) { o.x0 = o.x; o.y0 = o.y; o.r = 14; o.ontop = true; setStage(o); },\n  want(o, S) { if (o.dead2 || !G.lobeOpen(o, S)) return null; if (o.label === 'A') return 'cautery'; if (o.label === 'B') return o.slashedIt ? 'forceps' : 'scalpel'; return o.dose ? 'syringe' : 'salve'; },\n  verb: 'Strike', step(o, S, w, h) { o.open = !o.dead2 && G.lobeOpen(o, S); if (o.dead2) return; if (o.label === 'C' && !o.dose && o.open) { for (const p of S.players) if (p.tool === 'salve' && !p.gone && p.trigPrev >= .3 && Math.hypot(p.x - o.x, p.y - o.y) < 24) { o.salveT += h; if (o.salveT >= 1 * T.strainHealth) { G.grade(S, p, o.x, o.y, 'clean', 'salve'); dieLobe(o, S); return; } } } },\n  burnOk: o => o.open && !o.dead2, burned(o, S, p, g) { G.grade(S, p, o.x, o.y, g, 'cautery'); dieLobe(o, S); },\n  slashable: (o, S) => o.label === 'B' && !o.slashedIt && o.open && !o.dead2, slash(o, S, p) { o.slashedIt = true; G.mkPull(o, { a: -1.57, depth: 10, maxV: 140 }); G.grade(S, p, o.x, o.y, 'clean', 'slash'); },\n  canGrip: (o, S) => o.label === 'B' && o.slashedIt && !o.dead2, grip(o, S, p) { p.hold = { k: 'pull', id: o.id, gx: p.x, gy: p.y, p0: o.pull.prog, last: 0, v: 0 }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  onFree(o, S, p) { G.grade(S, p, o.x, o.y, o.pull.tears ? 'clean' : 'textbook', 'forceps'); p.hold = null; p.tension = 0; ev(S, 'clink', Math.round(o.x), Math.round(o.y)); dieLobe(o, S); o.x = o.x0; o.y = o.y0; },\n  dosed(o, S, p, g) { if (!o.open || !o.dose) { ev(S, 'spit', Math.round(o.x), Math.round(o.y)); return; } o.dose = false; G.grade(S, p, o.x, o.y, g, 'dose'); } });\nfunction dieLobe(o, S) { o.dead2 = true; o.open = false; o.burn = 0; o.dose = false; ev(S, 'lobedead', Math.round(o.x), Math.round(o.y)); }\nG.defScript('dacapoBeads', (S) => { S.flags.swarm = true; S.beadCap = 4; for (let i = 0; i < 3; i++) G.spawn(S, { t: 'bead', x: 120 + i * 90, y: 150, req: false }); });\n})();\nEOF\ncat > src/core/strains/fermata.js <<'EOF'\n// Fermata: an eye in the gyri. Its hold domes stop everything inside; it opens only as a dome collapses. Case 10's foe.\n(() => {\nconst G = (window.GAME ||= {}), { ev, rnd, clamp } = G, T = G.T;\nG.defObject('dome', { req: false, ontop: true, init(o) { o.r = o.r || 34; o.life = o.life || 5; o.life0 = o.life; o.ontop = true; }, want: () => null,\n  step(o, S, w) { o.life -= w; if (o.life <= 0) { ev(S, 'domefall', Math.round(o.x), Math.round(o.y)); G.kill(S, o); const e = S.objs.find(q => q.type === 'fermata' && !q.dead); if (e) e.open = Math.max(e.open || 0, .7); } } });\nG.defObject('fermata', { drain: .15, ghost: true,\n  init(o) { o.r = 10; o.ontop = true; o.open = 0; o.hits = 0; o.stage2 = 1; o.domeT = 1; o.burn0 = .3 * T.strainHealth; o.burn = o.burn0; o.spots = o.spots || [[150, 90], [285, 85], [215, 150]]; o.si = 0; },\n  want: o => o.stage2 === 3 ? 'forceps' : o.open > 0 ? 'cautery' : null, verb: 'Burn', burnOk: o => o.open > 0, canGrip: o => o.stage2 === 3,\n  grip(o, S, p) { p.hold = { k: 'pull', id: o.id, gx: p.x, gy: p.y, p0: o.pull.prog, last: 0, v: 0 }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  burned(o, S, p, g) { o.hits++; G.grade(S, p, o.x, o.y, g, 'cautery'); ev(S, 'eyehit', Math.round(o.x), Math.round(o.y)); o.burn = o.burn0; o.open = 0; if (o.hits >= (o.need || 3)) { S.flags.fermata1 = true; } },\n  marked(o, S) { S.flags.fermata_found = true; },\n  caught(o, S) { S.flags.fermata_dead = true; },\n  step(o, S, w) { if (o.open > 0) o.open -= w; if (o.stage2 === 1 && !S.flags.fermata1) { o.domeT -= w * T.spawnRate; let n = 0; for (const q of S.objs) if (q.type === 'dome' && !q.dead) n++; if (o.domeT <= 0 && n < 3 && o.open <= 0) { o.domeT = 2.6; const a = rnd(S) * 6.28; G.spawn(S, { t: 'dome', x: clamp(o.x + Math.cos(a) * (n ? 60 : 8), 70, 356), y: clamp(o.y + Math.sin(a) * (n ? 34 : 8), 40, 190) }); } } } });\nG.defScript('fermataFlee', S => { const e = S.objs.find(q => q.type === 'fermata'); if (!e) return; for (const q of S.objs) if (q.type === 'dome') q.dead = true; e.si = 1; e.x = e.spots[1][0]; e.y = e.spots[1][1]; e.stage2 = 2; e.hidden = true; e.mark = 0; e.stayMarked = true; e.open = 0; ev(S, 'flee', Math.round(e.x), Math.round(e.y)); G.spawn(S, { t: 'sliver', x: 130, y: 130 }); G.spawn(S, { t: 'sliver', x: 300, y: 140 }); });\nG.defScript('fermataPull', S => { const e = S.objs.find(q => q.type === 'fermata'); if (!e) return; e.stage2 = 3; e.hidden = false; G.mkPull(e, { a: -1.57, depth: 34, maxV: 30, off: 12, par: 3.6 }); });\n})();\nEOF\ncat > src/core/strains/cantor.js <<'EOF'\n// Cantor: the choir-organ around the heart. Four movements, each a phase: conducting, the hush, the forced rewinds, the Last Note.\n(() => {\nconst G = (window.GAME ||= {}), { ev, rnd, clamp, polyAt } = G, T = G.T;\nG.defObject('baton', { req: true, drain: .2, ghost: true,\n  init(o) { o.r = 11; o.ontop = true; o.u = 0; o.dirn = 1; o.pause = 0; o.cx = o.x; o.cy = o.y; o.rad = o.rad || 56; o.ph0 = o.ph0 || 0; },\n  want: o => o.pause > 0 ? 'scalpel' : null, slashable: o => o.pause > 0, verb: 'Slash', slash(o, S, p) { G.grade(S, p, o.x, o.y, 'textbook', 'slash'); ev(S, 'tendril', Math.round(o.x), Math.round(o.y)); G.kill(S, o); },\n  step(o, S, w) { if (o.pause > 0) { o.pause -= w; o.open = true; if (o.pause <= 0) o.dirn = -o.dirn; } else { o.open = false; o.u += o.dirn * w * .42 * T.strainSpeed; if (o.u >= 1 || o.u <= 0) { o.u = clamp(o.u, 0, 1); o.pause = 1.5; ev(S, 'batonrest', Math.round(o.x), Math.round(o.y)); } } const a = o.ph0 + (o.u - .5) * 2.4; o.x = o.cx + Math.cos(a) * o.rad; o.y = o.cy + Math.sin(a) * o.rad * .6; } });\nG.defObject('uvula', { drain: .25, ghost: true, init(o) { o.burn = o.burn0 = 1.5 * T.strainHealth; o.r = 8; o.ontop = true; }, want: () => 'cautery', verb: 'Burn' });\nG.defObject('voicebox', { drain: .3, ghost: true,   // the hush's voice: found by Sonar, sedated on the beat, three times\n  init(o) { o.hidden = true; o.mark = 0; o.hits = 0; o.moveT = 8; o.dose = true; o.r = 8; o.ontop = true; },\n  want: o => o.mark > 0 ? 'syringe' : null, verb: 'Inject',\n  step(o, S, w) { o.open = S.sinceBeat < .3; o.moveT -= w; if (o.moveT <= 0 && !(o.mark > 0)) { o.moveT = 8; o.x = clamp(o.x + (rnd(S) - .5) * 120, 100, 330); o.y = clamp(o.y + (rnd(S) - .5) * 70, 60, 170); } S.aura = { x: o.x, y: o.y, amp: .6, r: 110 }; },\n  dosed(o, S, p, g) { if (S.sinceBeat < .3 || S.breath) { o.hits++; G.grade(S, p, o.x, o.y, g, 'dose'); ev(S, 'sedate', Math.round(o.x), Math.round(o.y)); if (o.hits >= 3) { S.flags.voice_dead = true; G.kill(S, o); } else { o.mark = 0; o.moveT = 0; } } else { ev(S, 'spit', Math.round(o.x), Math.round(o.y)); G.hurt(S, 3); } } });\nG.defObject('repeatSign', { req: false, ghost: true, init(o) { o.r = 18; o.ontop = true; o.life = 3; o.open = true; }, want: () => 'scalpel', verb: 'Slash', slashable: () => true,\n  slash(o, S, p) { S.out.recap++; G.grade(S, p, o.x, o.y, 'textbook', 'slash'); ev(S, 'recapcut', Math.round(o.x), Math.round(o.y)); G.kill(S, o); },\n  step(o, S, w) { o.life -= w; if (o.life <= 0) { G.kill(S, o); if (S.ph.d) { S.ph.d.fire = true; } } } });\nG.defObject('note', { drain: 0, ghost: true, init(o) { G.mkPull(o, { a: -1.57, depth: 60, maxV: 58, off: 12, par: 3.2 }); o.ontop = true; }, want: () => 'forceps', verb: 'Draw out',\n  pulling(o, S) { ev(S, 'noterise', o.pull.prog / o.pull.depth); },\n  onFree(o, S, p) { p.hold = null; G.grade(S, p, o.x, o.y, o.pull.tears ? 'clean' : 'textbook', 'forceps'); G.kill(S, o); S.silent = true; S.out.hold = 3; S.out.holdDone = 'afterSilence'; ev(S, 'silence'); } });\nG.defScript('afterSilence', S => { S.silent = false; S.out.hold = 0; S.flags.note_out = true; ev(S, 'lastbeep'); });\nconst sing = (S, d, w) => { d.sing = (d.sing || 2) - w * T.spawnRate; if (d.sing > 0) return; d.sing = 4.5; let n = 0, b = 0; for (const q of S.objs) { if (q.type === 'bead' && !q.dead) n++; if ((q.type === 'bleeder') && !q.dead) b++; } const k = (d.k = (d.k || 0) + 1) % 3; ev(S, 'sing', k); if (k === 0 && n < 4) G.spawn(S, { t: 'bead', x: 120, y: 90, req: false }); else if (k === 1 && S.objs.filter(q => q.type === 'sliver' && !q.dead).length < 2) G.spawn(S, { t: 'sliver', x: 300, y: 130, req: false }); else if (b < 2) G.spawn(S, { t: 'bleeder', x: 150 + rnd(S) * 130, y: 70 + rnd(S) * 90, req: false }); };\nG.defScript('cantor1', (S, ph, w) => { const d = S.ph.d; sing(S, d, w); if (!d.stage2 && !S.objs.some(o => o.type === 'baton' && !o.dead)) { d.stage2 = true; ev(S, 'mouths'); for (const [x, y] of [[135, 100], [213, 72], [292, 100]]) G.spawn(S, { t: 'uvula', x, y }); } if (d.stage2 && !S.objs.some(o => o.type === 'uvula' && !o.dead)) d.done = true; });\nG.defScript('cantor2enter', S => { S.hush = true; ev(S, 'hush'); });\nG.defScript('cantor2', (S, ph, w) => { const d = S.ph.d; d.st = (d.st === undefined ? 15 : d.st) - w; if (d.st <= 0) { S.static = !S.static; d.st = S.static ? 8 : 15; ev(S, S.static ? 'staticon' : 'staticoff'); } d.readT = (d.readT || 3) - w; if (d.readT <= 0) { d.readT = 6; ev(S, 'readout', Math.round(S.v)); }\n  d.dome = (d.dome || 5) - w; if (d.dome <= 0) { d.dome = 7; if (S.objs.filter(o => o.type === 'dome' && !o.dead).length < 2) G.spawn(S, { t: 'dome', x: 120 + rnd(S) * 190, y: 70 + rnd(S) * 90, life: 5 }); }\n  if (S.flags.voice_dead) { d.done = true; } });\nG.defScript('cantor2leave', S => { S.hush = false; S.static = false; ev(S, 'hushend'); });\nG.defScript('cantor3', (S, ph, w) => { const d = S.ph.d; if (d.counterOpen > 0) d.counterOpen -= w; d.next = (d.next === undefined ? 12 : d.next) - w; if (S.out.recap >= (S.attract ? 2 : 6)) { d.done = true; return; }\n  d.haz = (d.haz || 3) - w; if (d.haz <= 0) { d.haz = 5; if (S.objs.filter(o => o.type === 'polyp' && !o.dead).length < 4) G.spawn(S, { t: 'polyp', x: 110 + rnd(S) * 210, y: 60 + rnd(S) * 110, req: false }); }\n  if (d.next <= 0 && !S.objs.some(o => o.type === 'repeatSign' && !o.dead)) { G.spawn(S, { t: 'repeatSign', x: 213, y: 96 }); d.next = 17; ev(S, 'windup'); }\n  if (d.fire) { d.fire = false; const secs = T.lookSeconds, cnt = S.out; const n = S.ph.d.next; if (G.Op.rewind(S, secs, true)) { S.ph.d.counterOpen = 4.5; S.ph.d.next = n; } ev(S, 'forced'); } });\nG.defScript('cantor4', (S, ph, w) => { S.flags.heart = true; if (S.flags.note_out) S.ph.d.done = true; });\n})();\nEOF\ncat > src/core/strains/device.js <<'EOF'\n// Case 9's rigged pacemaker: screws turned by circling, a board that disagrees with the chart, wires cut in the true order.\n(() => {\nconst G = (window.GAME ||= {}), { ev, clamp } = G;\nG.defObject('screw', { drain: 0, ghost: false, init(o) { o.turn = 0; o.ontop = true; o.r = 5; }, want: () => 'forceps', verb: 'Turn',\n  grip(o, S, p) { p.hold = { k: 'turn', id: o.id, lx: p.x, ly: p.y, la: null }; ev(S, 'grip', o.x, o.y); return true; },\n  held(o, S, p, h) { const H = p.hold, dx = p.x - H.lx, dy = p.y - H.ly; if (Math.hypot(dx, dy) < 1.2) return; const a = Math.atan2(dy, dx); H.lx = p.x; H.ly = p.y; if (H.la !== null) { let d = a - H.la; while (d > 3.1416) d -= 6.2832; while (d < -3.1416) d += 6.2832; if (Math.abs(d) < 1.6) o.turn += Math.abs(d); } H.la = a; p.tension = 0; o.ang = (o.ang || 0) + .3; if (Math.floor(o.turn / 3.14) !== o.lastTick) { o.lastTick = Math.floor(o.turn / 3.14); ev(S, 'ratchet', o.x, o.y); }\n    if (o.turn >= 18.85) { G.grade(S, p, o.x, o.y, 'clean', 'forceps'); ev(S, 'clink', o.x, o.y); p.hold = null; G.kill(S, o); } },\n  release(o, S, p) { p.tension = 0; } });\nG.defObject('boardmark', { req: false, ontop: true, init(o) { o.hidden = true; o.mark = 0; o.stayMarked = true; o.ontop = true; }, want: () => null, marked(o, S) { S.flags.board = (S.flags.board || 0) + 1; ev(S, 'boardread', o.order); } });\nG.defObject('lead', { drain: 0, init(o) { o.burn = o.burn0 = .9; o.ontop = true; }, want: () => 'cautery', verb: 'Solder' });\nG.defObject('wire', { drain: 0, init(o) { o.r = 7; o.ontop = true; }, want: () => 'scanned', slashable: () => true, verb: 'Slash',\n  aim: o => [o.x, o.y],\n  slash(o, S, p) { const c = S.ph.d, next = (c.nextWire || 0); if (o.order === next) { c.nextWire = next + 1; G.grade(S, p, o.x, o.y, 'textbook', 'slash'); ev(S, 'wirecut', o.x, o.y); G.kill(S, o); } else { ev(S, 'wrongwire', o.x, o.y); if (!o.hurtT || S.t - o.hurtT > 1) { o.hurtT = S.t; G.slip(S, p, o.x, o.y, 30, 'wire'); S.clock = Math.max(1, S.clock - 30); } } } });\nG.defObject('can', { drain: 0, init(o) { G.mkPull(o, { a: -1.57, depth: 26, maxV: 34, off: 14, par: 3.6 }); o.ontop = true; }, want: () => 'forceps', verb: 'Lift', caught(o, S) { S.flags.can_out = true; } });\nG.OBJ.wire.want = (o, S) => (o.order === (S.ph.d.nextWire || 0)) ? 'scalpel' : null;\n})();\nEOF","description":"Write op core and all strain simulations"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22098,"cache_read_input_tokens":177919,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22098},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"47f1e3d8-8c33-4640-bf9e-46d5325e3126","timestamp":"2026-11-05T13:24:01.109Z","request_id":"req_011CgjrHq7rwdmGNP1RZ15ev","wire_tool_inputs":{"toolu_01B77n4ucvJUV422Dzu9QzKB":{"command":"cat > src/core/op.js <<'EOF'\n// The operation: one JSON-safe state object S, stepped by plain inputs. Rewinds, checkpoints and the network all rest on that.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, clone, rnd } = G, T = G.T;\nconst O = o => G.OBJ[o.type];\nG.CASES = G.CASES || {}; G.CASE_ORDER = G.CASE_ORDER || [];\nG.defCase = c => { G.CASES[c.id] = c; if (c.number) { G.CASE_ORDER.push(c.id); G.CASE_ORDER.sort((a, b) => G.CASES[a].number - G.CASES[b].number); } return c; };\nG.Scripts = G.Scripts || {};\nG.defScript = (n, f) => { G.Scripts[n] = f; };\nconst RT = new WeakMap(); const rt = S => { let r = RT.get(S); if (!r) RT.set(S, r = { ring: [], ckpt: null, ringT: 0, fails: {} }); return r; };\nconst mkPlayer = (id, color, x = 213, y = 116) => ({ id, color, x, y, lastX: x, lastY: y, spd: 0, tool: 'forceps', toolNext: 'forceps', swapT: 0, trigPrev: 0, hold: null, heat: 0, lockT: 0, fill: 0, overT: 0, coolT: 0, bareT: 0, drag: 0, tension: 0, nerveT: 0, near: 0, score: 0, stats: { textbook: 0, clean: 0, sloppy: 0, slips: 0, stitches: 0, suction: 0, burns: 0 }, gone: false });\nconst Op = G.Op = {\n  create(c, o = {}) { if (typeof c === 'string') c = G.CASES[c];\n    const diffId = o.difficulty || 'resident', diff = G.DIFFS[diffId], clockX = c.noClockScale ? 1 : diff.clock * T.clockX;\n    const players = o.players || [{ id: 0, color: G.SEATS[0] }];\n    const S = { caseId: c.id, seed: o.seed === undefined ? 1 : o.seed, rng: (o.seed === undefined ? 1 : o.seed) >>> 0, diffId, diff: { iv: diff.iv, drain: diff.drain, hints: diff.hints, codeBlue: diff.codeBlue, assist: diff.assist }, t: 0, ht: 0, v: c.vitals, clock: c.clock * clockX, clock0: c.clock * clockX, drain: c.drain, phaseI: -1, ph: { t: 0, si: 0, d: {} }, objs: [], nextId: 1, players: players.map(q => mkPlayer(q.id, q.color)), steady: o.steady || 0, breath: false, doc: c.doc === 'both' ? 'soko' : c.doc || 'vale', docs: c.doc === 'both' ? ['vale', 'soko'] : [c.doc || 'vale'], consultT: 0, flow: 0, bestFlow: 0, slips: 0, acts: { sloppy: 0, clean: 0, textbook: 0 }, score: 0, flags: {}, marks: [], tut: null, tip: null, codeBlue: null, codeUsed: false, closing: null, done: null, ev: [], ghosts: null, rwT: 0, out: { recap: 0, rewinds: 0, lurched: false }, sinceBeat: 0, beatLen: .9, windowOpen: true, capB: false, assistTol: 0, tilt: null, dim: 0, hush: false, static: false, silent: false, aura: null, markers: o.markers || [], lock: !!o.lock, lab: !!c.lab, attract: !!o.attract, bomb: !!c.bomb, noLac: false, stage: 0, ringOn: c.doc !== 'vale' && c.id !== 'grandrounds', dressBonus: 0, finalScore: 0, N: players.length };\n    if (o.clockBonus) S.clock += o.clockBonus;\n    S.assistTol = clamp((T.assist + diff.assist + (o.assistPlus || 0)) * 1, 0, 1);\n    for (const m of S.markers) void m;\n    Op.enterPhase(S, o.phase || 0); return S; },\n  caseOf: S => G.CASES[S.caseId],\n  phaseOf: S => G.CASES[S.caseId].phases[S.phaseI],\n  enterPhase(S, i) { const c = Op.caseOf(S), ph = c.phases[i]; S.phaseI = i; S.ph = { t: 0, si: 0, d: {} }; S.tip = null; S.tut = null; S.stage = i;\n    if (c.lab) S.clock = S.clock0;\n    if (ph.clockAdd) S.clock += ph.clockAdd * (S.diffId === 'intern' ? 1.3 : S.diffId === 'attending' ? .8 : 1);\n    if (ph.spawn) for (const sp of ph.spawn) G.spawn(S, sp);\n    if (ph.enter) G.Scripts[ph.enter](S, ph);\n    if (ph.tut && !S.attract) S.tut = { verb: ph.tut.verb, text: ph.tut.text };\n    if (ph.tip) S.tip = clone(ph.tip);\n    ev(S, 'phase', i); rt(S).ckpt = clone(Object.assign({}, S, { ev: [] })); },\n  // Hazards still open: the phase's 'clear' test, and table 7's drains\n  openReq: S => S.objs.some(o => !o.dead && o.req && (o.type !== 'pool' || o.vol > 2)),\n  drainNow(S) { let n = S.drain; for (const o of S.objs) if (!o.dead) { const d = O(o); if (G.inDome(S, o.x, o.y)) continue; n += d.drainOf ? d.drainOf(o, S) : d.drain; } return n * S.diff.drain * T.drainX; },\n  // Where the held tool could act: for the magnet, prompts, hints and the bot\n  targets(S, tool) { const out = []; for (const o of S.objs) { if (o.dead || !G.canTouch(S, o)) continue; const d = O(o); let w = d.want ? d.want(o, S) : null; if (w === tool) out.push({ o, at: d.aim ? d.aim(o, S) : [o.x, o.y], verb: d.verb }); } return out; },\n  nextTarget(S) { let best = null, score = 1e9; for (const o of S.objs) { if (o.dead || !G.canTouch(S, o)) continue; const d = O(o), w = d.want ? d.want(o, S) : null; if (!w) continue; if (!o.req && o.type !== 'pool') continue; const k = o.type === 'pool' ? (o.req ? 1 : 2) : (d.drainOf ? 3 - d.drainOf(o, S) : 3 - d.drain); if (k < score) { score = k; best = { o, tool: w, at: d.aim ? d.aim(o, S) : [o.x, o.y] }; } } if (!best) for (const o of S.objs) if (!o.dead && o.hidden && !(o.mark > 0) && !G.CHEATS.reveal) return { o, tool: 'sonar', at: [o.x, o.y] }; return best; },\n  step(S, inputs, dt) { if (S.done) return;\n    if (G.CHEATS.infiniteSteady) S.steady = 100;\n    if (S.rwT > 0) { S.rwT -= dt; S.players.forEach((p, i) => { const q = inputs[i]; if (q && !p.gone) { p.lastX = p.x = q.x; p.lastY = p.y = q.y; p.trigPrev = q.trig; } }); return; }\n    if (S.codeBlue) return stepCode(S, inputs, dt);\n    if (S.closing) return stepClosing(S, inputs, dt);\n    if (S.out.hold > 0) { S.out.hold -= dt; if (S.out.hold <= 0) G.Scripts[S.out.holdDone](S); return; }\n    S.ht += dt;\n    if (S.consultT > 0) { S.consultT -= dt; if (S.consultT <= 0) { S.doc = S.docNext; ev(S, 'consulted', S.doc); } }\n    S.players.forEach((p, i) => { const q = inputs[i]; if (!q || p.gone) return; if (q.gift) gift(S, p); if (q.consult && S.docs.length > 1 && S.consultT <= 0) { S.docNext = S.doc === 'vale' ? 'soko' : 'vale'; S.consultT = .4; if (S.breath) S.breath = false; G.releaseHold(S, p); ev(S, 'consult', S.docNext); G.didVerb(S, 'consult'); } });\n    if (S.rwT > 0) return;   // (a Second Look just began)\n    if (S.breath) { S.steady -= T.breathDrain * dt; if (S.steady <= 0) { S.steady = 0; S.breath = false; ev(S, 'breathoff'); } }\n    const w = dt * (S.breath ? T.breathFactor : 1); S.w = w;\n    S.t += w; S.ph.t += w; if (!S.breath) G.charge(S, .5 * dt);\n    S.sinceBeat += w; S.beatLen = 60 / (56 + (99 - S.v) * .55 + (Op.caseOf(S).bpmUp || 0)); if (S.sinceBeat >= S.beatLen) { S.sinceBeat -= S.beatLen; ev(S, 'beat'); }\n    S.players.forEach((p, i) => { const q = inputs[i]; if (q && !p.gone) G.toolStep(S, p, q, dt); });\n    S.aura = null;\n    for (let k = 0; k < S.objs.length; k++) { const o = S.objs[k]; if (o.dead) continue; o.age += w; if (o.mark > 0) o.mark -= w; const d = O(o); if (d.step) d.step(o, S, w, dt); if (d.drift !== false && S.tilt && o.loose) { o.x = clamp(o.x + S.tilt[0] * 12 * w, 60, 366); o.y = clamp(o.y + S.tilt[1] * 12 * w, 40, 192); if (o.pull) { o.bx = o.x; o.by = o.y; } } }\n    if (!S.tut) { if (!(G.CHEATS.freezeClock || S.lab)) S.clock -= w; G.hurt(S, Op.drainNow(S) * w); }\n    if (S.aura) { G.hurt(S, .6 * S.aura.amp * w); }\n    const ph = Op.phaseOf(S);\n    if (ph.script) while (S.ph.si < ph.script.length && S.ph.t >= ph.script[S.ph.si].t) { const a = ph.script[S.ph.si++]; G.Scripts[a.do](S, a); }\n    if (ph.step) G.Scripts[ph.step](S, ph, w, dt);\n    S.objs = S.objs.filter(o => !o.dead);\n    if (S.lab) { S.v = Math.max(S.v, 60); }\n    if (S.done) return;\n    // done with the phase?\n    if (phaseDone(S, ph)) { const c = Op.caseOf(S); if (ph.leave) G.Scripts[ph.leave](S, ph); if (S.rwT > 0 || S.codeBlue) return; if (S.phaseI + 1 < c.phases.length) { S.flow = S.flow; ev(S, 'phasedone', S.phaseI); Op.enterPhase(S, S.phaseI + 1); } else startClosing(S); return; }\n    if (S.ringOn) { const r = rt(S); r.ringT += w; if (r.ringT >= .1) { r.ringT -= .1; r.ring.push(snap(S)); const cap = T.lookSeconds * 10 + 12; if (r.ring.length > cap) r.ring.shift(); } }\n    if (S.clock <= 0 && !G.CHEATS.freezeClock) { S.clock = 0; return lost(S, S.bomb ? 'bomb' : 'time'); }\n    if (S.bomb && S.v < 25 && !G.CHEATS.lockVitals && !S.lock && !S.tut) return lost(S, 'bomb');\n    if (S.v <= 0 && !G.CHEATS.lockVitals && !S.lock) { if (S.diff.codeBlue && !S.codeUsed && !S.bomb) startCode(S); else lost(S, 'vitals'); } },\n  checkpoint: S => rt(S).ckpt,\n  // Retry from this phase: the phase's starting state, its rank capped at B\n  retry(S) { const r = rt(S), c = r.ckpt, f = (r.fails[c.phaseI] || 0) + 1, ring = r.ring; for (const k in S) delete S[k]; Object.assign(S, clone(c)); S.capB = true; S.done = null; S.ev = []; r.ring = []; r.ringT = 0; r.fails[S.phaseI] = f; ring.length = 0; return f; },\n  fails: S => rt(S).fails[S.phaseI] || 0,\n  ringOf: S => rt(S).ring,\n  reverseOf: S => rt(S).reverse || [],\n  rewind(S, secs, forced) { const r = rt(S), ring = r.ring; if (!ring.length) return false; const target = S.t - secs; let i = 0; while (i < ring.length - 1 && ring[i].t < target) i++;\n    const snapTo = ring[i], frames = ring.slice(i).map(f => ({ p: f.players.map(q => [Math.round(q.x), Math.round(q.y)]), s: f.objs.filter(o => O(o).ghost && !o.dead).map(o => [o.type, Math.round(o.x), Math.round(o.y), o.open ? 1 : 0, o.id]) }));\n    r.reverse = ring.slice(i); r.pre = forced ? snap(S) : null;\n    const keep = { steady: S.steady, out: S.out, doc: S.doc, ev: S.ev, players: S.players.map(p => ({ x: p.x, y: p.y, tool: p.tool, toolNext: p.toolNext, trigPrev: p.trigPrev, spd: 0, gone: p.gone })) };\n    for (const k in S) delete S[k]; Object.assign(S, clone(snapTo)); S.ev = keep.ev; S.steady = keep.steady; S.out = keep.out; S.doc = keep.doc; S.breath = false; keep.out.rewinds++;\n    S.players.forEach((p, k) => { Object.assign(p, keep.players[k], { hold: null, lastX: keep.players[k].x, lastY: keep.players[k].y, tension: 0, fill: 0, overT: 0 }); });\n    S.ghosts = { t: 0, dur: secs, fr: frames }; S.rwT = 1.2; r.ring = ring.slice(0, i + 1); ev(S, 'rewind', forced ? 1 : 0); return true; },\n  // Cantor's rewind undone: the world as it stood before the forced rewind\n  counter(S) { const r = rt(S); if (!r.pre) return false; const pre = r.pre; r.pre = null; const keep = { steady: S.steady, out: S.out, ev: S.ev, doc: S.doc, players: S.players.map(p => ({ x: p.x, y: p.y, tool: p.tool, toolNext: p.toolNext, trigPrev: p.trigPrev })) }; for (const k in S) delete S[k]; Object.assign(S, clone(pre)); Object.assign(S, { steady: keep.steady, out: keep.out, ev: keep.ev, doc: keep.doc, rwT: .8 }); S.players.forEach((p, k) => Object.assign(p, keep.players[k], { hold: null })); ev(S, 'rewind', 2); return true; },\n  forceLost(S, why) { lost(S, why || 'vitals'); },\n  forceWin(S) { S.objs = []; S.phaseI = Op.caseOf(S).phases.length - 1; S.done = 'won'; G.finalize(S); ev(S, 'won'); },\n  triggerCode(S) { S.codeUsed = false; S.v = 0; startCode(S); },\n  jumpPhase(S, i) { S.objs = S.objs.filter(o => o.type === 'nerve'); S.tut = null; S.breath = false; Op.enterPhase(S, i); },\n};\nconst snap = S => { const c = {}; for (const k in S) if (k !== 'ev' && k !== 'ghosts') c[k] = clone(S[k]); return c; };\nconst phaseDone = (S, ph) => { const w = ph.when || 'clear'; if (w === 'clear') return !Op.openReq(S); if (w === 'never') return false; if (w.startsWith('flag:')) return !!S.flags[w.slice(5)]; if (w.startsWith('t:')) return S.ph.t >= +w.slice(2); return !!S.ph.d.done; };\nfunction gift(S, p) {\n  if (S.doc === 'vale' || S.caseId === 'grandrounds') { if (S.breath) { S.breath = false; ev(S, 'breathoff'); return; } if (S.steady < 35) { ev(S, 'nogift'); return; } S.breath = true; ev(S, 'breathon', p.id); G.didVerb(S, 'gift'); return; }\n  if (S.steady < 45 || S.caseId === 'grandrounds') { ev(S, 'nogift'); return; }\n  const r = rt(S); if (S.ph.d.counterOpen > 0 && r.pre) { S.steady -= 45; if (Op.counter(S)) { S.out.recap++; S.ph.d.counterOpen = 0; ev(S, 'countered'); G.didVerb(S, 'gift'); } return; }\n  if (!r.ring.length) { ev(S, 'nogift'); return; }\n  S.steady -= 45; if (Op.rewind(S, T.lookSeconds)) G.didVerb(S, 'gift'); }\nfunction lost(S, why) { S.done = 'lost'; S.lostWhy = why; S.breath = false; ev(S, 'lost', why); }\n// Code Blue: a marker crossing the peak; two hits in four attempts\nfunction startCode(S) { S.codeUsed = true; S.breath = false; for (const p of S.players) G.releaseHold(S, p); S.codeBlue = { t: 0, tries: 0, hits: 0, per: .9, flash: 0, done: 0, res: [], pressed: false }; ev(S, 'codeblue'); S.v = 0; }\nfunction stepCode(S, inputs, dt) { const c = S.codeBlue; if (c.done > 0) { c.done -= dt; if (c.done <= 0) { const ok = c.hits >= 2; if (ok) { S.v = 30; S.flags.revived = true; ev(S, 'revived'); } S.codeBlue = null; if (!ok) lost(S, 'vitals'); } return; }\n  c.t += dt; const phase = c.t / c.per, near = Math.round(phase), err = (phase - near) * c.per; if (near > c.tries && err > .14 + (S.assistTol * .03)) { c.tries = near; c.res.push(0); ev(S, 'codemiss'); check(); }\n  let press = false; S.players.forEach((p, i) => { const q = inputs[i]; if (q) { if (q.shock) press = true; p.x = q.x; p.y = q.y; p.trigPrev = q.trig; } });\n  if (press && near >= 1 && near > c.tries) { const a = Math.abs(err), win = .14 + (S.assistTol * .03); c.tries = near; if (a <= win) { c.hits++; c.res.push(a <= .06 ? 2 : 1); ev(S, 'codehit', a <= .06 ? 'textbook' : 'clean'); G.grade(S, S.players[0], 213, 120, a <= .06 ? 'textbook' : 'clean', 'codeblue'); } else { c.res.push(0); ev(S, 'codemiss'); } check(); }\n  function check() { if (c.hits >= 2 || c.tries >= 4 || c.tries - c.hits > 2) c.done = .6; } }\n// The dressing, and the stamp\nfunction startClosing(S) { for (const p of S.players) G.releaseHold(S, p); S.breath = false; S.objs = S.objs.filter(o => o.type === 'nerve'); S.closing = { t: 0, per: 1.5, phase: 'ring', hit: 0, stampT: 0, x: Op.caseOf(S).dressAt ? Op.caseOf(S).dressAt[0] : 213, y: Op.caseOf(S).dressAt ? Op.caseOf(S).dressAt[1] : 116, tries: 0 }; ev(S, 'dressing'); }\nfunction stepClosing(S, inputs, dt) { const c = S.closing; c.t += dt; if (c.phase === 'ring') { const k = c.t / c.per;\n    let press = false; S.players.forEach((p, i) => { const q = inputs[i]; if (q) { p.x = q.x; p.y = q.y; if (q.trig >= .3 && p.trigPrev < .3) press = true; p.trigPrev = q.trig; } });\n    if (press || k >= 1.4) { const err = Math.abs(1 - k), g = !press ? 'late' : err < .08 ? 'textbook' : err < .22 ? 'clean' : 'sloppy'; S.dressBonus = g === 'textbook' ? 60 : g === 'clean' ? 30 : 10; c.g = g; c.phase = 'stamp'; c.t = 0; ev(S, 'stamp', g); }\n  } else if (c.t >= (S.attract ? .5 : 2.6)) { S.done = 'won'; G.finalize(S); ev(S, 'won'); } }\nG.opGift = gift;\n})();\nEOF\ncat > src/core/strains/staccato.js <<'EOF'\n// Staccato: beads hopping on a fixed beat from hidden nests. A closing ring shows each landing .5 s ahead; a landing bites.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, rnd } = G, T = G.T;\nG.defObject('nest', { drain: .2, ghost: true,   // found by Sonar; a slash opens it, Forceps takes it\n  init(o) { o.r = 10; o.hidden = o.hidden !== false; o.mark = 0; o.stayMarked = true; G.mkPull(o, { a: o.a === undefined ? -1.57 : o.a, depth: 14, maxV: 120 }); o.opened = false; o.ontop = true; o.spawnT = 1.5; },\n  want: o => o.opened ? 'forceps' : 'scalpel', canGrip: o => o.opened, slashable: o => !o.opened, verb: 'Slash',\n  slash(o, S, p) { o.opened = true; G.grade(S, p, o.x, o.y, 'clean', 'slash'); },\n  step(o, S, w) { if (!S.flags.swarm) return; o.spawnT -= w * T.spawnRate; if (o.spawnT <= 0) { let n = 0; for (const q of S.objs) if (q.type === 'bead' && !q.dead) n++; o.spawnT = 2.6; if (n < (S.beadCap || 6)) G.spawn(S, { t: 'bead', x: o.x, y: o.y, nest: o.id }); } },\n  gone(o, S) { let left = 0; for (const q of S.objs) if (q.type === 'nest' && !q.dead) left++; if (!left) for (const q of S.objs) if (q.type === 'bead' && !q.dead) q.dieT = 1 + rnd(S) * 2; } });\nG.defObject('bead', { drain: .05, ghost: true,\n  init(o, S) { o.burn = o.burn0 = .12 * T.strainHealth; o.hopT = T.staccatoBeat * (.5 + rnd(S) * .5); o.tx = o.x; o.ty = o.y; o.sx = o.x; o.sy = o.y; o.air = 0; o.ontop = true; o.r = 2; },\n  want: () => 'cautery', verb: 'Burn',\n  aim: o => [o.x, o.y],\n  step(o, S, w) { if (o.dieT !== undefined) { o.dieT -= w; if (o.dieT <= 0) { ev(S, 'pop', Math.round(o.x), Math.round(o.y)); G.kill(S, o); return; } } const sp = T.strainSpeed;\n    o.hopT -= w * sp;\n    if (o.air > 0) { o.air -= w * sp / .5; const k = 1 - clamp(o.air, 0, 1); o.x = o.sx + (o.tx - o.sx) * k; o.y = o.sy + (o.ty - o.sy) * k; o.h = Math.sin(k * 3.14) * 12; if (o.air <= 0) { o.h = 0; o.x = o.tx; o.y = o.ty; ev(S, 'bite', Math.round(o.x), Math.round(o.y)); o.bites = (o.bites || 0) + 1; G.hurt(S, 1 * T.strainDamage); if (rnd(S) < .34) G.addLac(S, o.x, o.y); } return; }\n    if (o.hopT <= 0) { o.hopT = T.staccatoBeat * (1 + (rnd(S) < .3 ? 1 : 0)); const a = rnd(S) * 6.28, d = 24 + rnd(S) * 30; o.sx = o.x; o.sy = o.y; o.tx = clamp(o.x + Math.cos(a) * d, 70, 356); o.ty = clamp(o.y + Math.sin(a) * d * .7, 46, 186); o.air = 1; ev(S, 'tk', Math.round(o.x)); } } });\nG.defScript('swarmOn', S => { S.flags.swarm = true; S.beadCap = Math.max(6, 4 * (S.N || 1)); });\n})();\nEOF\ncat > src/core/strains/legato.js <<'EOF'\n// Legato: a long worm under the tissue, seen as a moving ridge. Cut at a slur mark as it passes; pull, clamp, burn, regrip.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, rnd, polyLen, polyAt } = G, T = G.T;\nconst newSlur = (S, o) => { const d = (o.slurS === undefined ? o.routeLen * .35 : o.slurS), [x, y, a] = polyAt(o.route, d), c = Math.cos(a + 1.57) * 11, s = Math.sin(a + 1.57) * 11; const g = G.spawn(S, { t: 'guide', pts: [[x - c, y - s], [x + c, y + s]], slur: o.id, link: o.id, req: false }); o.slurAt = [x, y]; o.gid = g.id; o.slurS = (d + o.routeLen * .3) % o.routeLen; };\nG.defObject('legato', { drain: .5, ghost: true,\n  init(o, S) { o.routeLen = polyLen(o.route); o.s = o.s || 10; o.dir = 1; o.stage = o.stage || 'under'; o.total = o.total || 150; o.pulled = o.pulled || 0; o.gap = 30; o.sinceBarb = 0; o.ontop = true; o.spd = o.spd || 34; const [x, y] = polyAt(o.route, o.s); o.x = x; o.y = y; o.exit = [x, y]; o.slurs = 0; if (o.stage === 'under' && !o.hidden && !o.noSlur) newSlur(S, o); o.a = -1.57; },\n  want: o => o.stage === 'out' ? 'forceps' : null, canGrip: o => o.stage === 'out', verb: 'Pull',\n  marked(o, S) { S.flags.legato_found = true; if (!o.gid) newSlur(S, o); o.hidden = false; },\n  aim: o => [o.x, o.y],\n  linked(o, S, g, p) { const d = Math.hypot(o.x - o.slurAt[0], o.y - o.slurAt[1]); if (d > 44) { ev(S, 'missed', Math.round(g.x), Math.round(g.y)); newSlur(S, o); return; } o.stage = 'out'; o.exit = [o.slurAt[0], o.slurAt[1]]; o.x = o.exit[0]; o.y = o.exit[1]; o.a = Math.atan2(116 - o.y, 213 - o.x); o.sinceBarb = 0; S.flags.legato_out = true; ev(S, 'surface', Math.round(o.x), Math.round(o.y)); },\n  grip(o, S, p) { p.hold = { k: 'legato', id: o.id, gx: p.x, gy: p.y, last: 0, v: 0, p0: o.sinceBarb }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  held(o, S, p, h) { const H = p.hold, ax = Math.cos(o.a), ay = Math.sin(o.a), along = (p.x - H.gx) * ax + (p.y - H.gy) * ay, v = (along - H.last) / h, lim = (o.maxV || 46) * T.gradeTol; H.last = along; H.v = H.v * .9 + v * .1; p.tension = clamp(H.v / lim, 0, 1.3); o.tens = p.tension;\n    if (H.v > lim) { snap(o, S, p); return; }\n    if (o.stage === 'barb') return;\n    const got = Math.max(0, along) - (H.got || 0); if (got > 0) { H.got = (H.got || 0) + got; o.pulled += got; o.sinceBarb += got; o.x = o.exit[0] + ax * o.sinceBarb; o.y = o.exit[1] + ay * o.sinceBarb; }\n    if (o.pulled >= (o.splitAt || 1e9)) { S.flags.legato_half = true; ev(S, 'split', Math.round(o.x), Math.round(o.y)); G.grade(S, p, o.x, o.y, 'textbook', 'legato'); p.hold = null; p.tension = 0; const left = o.total - o.pulled; G.kill(S, o); G.spawn(S, { t: 'legato', route: o.route, s: (o.s + 40) % o.routeLen, total: left, spd: o.spd * 1.5, maxV: (o.maxV || 46) * 1.15, slurS: (o.s + 60) % o.routeLen }); return; }\n    if (o.pulled >= o.total) { G.grade(S, p, o.x, o.y, 'textbook', 'legato'); S.flags.legato_dead = true; ev(S, 'clink', Math.round(o.x), Math.round(o.y)); p.hold = null; p.tension = 0; G.kill(S, o); return; }\n    if (o.sinceBarb >= o.gap) { o.stage = 'barb'; o.zone = [o.exit[0] + ax * (o.gap + 2), o.exit[1] + ay * (o.gap + 2)]; ev(S, 'barb', Math.round(o.x), Math.round(o.y)); } },\n  release(o, S, p) { p.tension = 0; if (o.stage === 'barb') { if (Math.hypot(p.x - o.zone[0], p.y - o.zone[1]) < 20 + S.assistTol * 4) { o.stage = 'clamped'; ev(S, 'clamp', Math.round(p.x), Math.round(p.y)); G.spawn(S, { t: 'barbspot', x: o.exit[0], y: o.exit[1], worm: o.id }); } else { ev(S, 'slide', Math.round(o.x), Math.round(o.y)); o.pulled = Math.max(0, o.pulled - 8); o.sinceBarb = Math.max(0, o.sinceBarb - 8); o.stage = 'out'; o.x = o.exit[0]; o.y = o.exit[1]; } } else { o.x = o.exit[0] + Math.cos(o.a) * o.sinceBarb; o.y = o.exit[1] + Math.sin(o.a) * o.sinceBarb; } },\n  step(o, S, w) { if (o.stage === 'under' || o.stage === 'flee') { o.s += o.dir * o.spd * w * T.strainSpeed; if (o.s > o.routeLen - 2) { o.s = o.routeLen - 2; o.dir = -1; } if (o.s < 2) { o.s = 2; o.dir = 1; } const q = polyAt(o.route, o.s); o.x = q[0]; o.y = q[1]; } } });\nfunction snap(o, S, p) { p.hold = null; p.tension = 0; G.slip(S, p, o.x, o.y, 5, 'snap'); ev(S, 'snap', Math.round(o.x), Math.round(o.y)); o.stage = 'under'; o.sinceBarb = 0; newSlur(S, o); }\nG.defObject('barbspot', { req: true, init(o) { o.burn = o.burn0 = .4 * T.strainHealth; o.ontop = true; }, want: () => 'cautery', verb: 'Burn',\n  burned(o, S, p, g) { G.grade(S, p, o.x, o.y, g, 'cautery'); const w = G.getObj(S, o.worm); if (w) { w.stage = 'out'; w.sinceBarb = 0; w.x = w.exit[0]; w.y = w.exit[1]; } G.kill(S, o); } });\n// A Legato sliver (Fermata, the Cantor): slash it where it runs, then a short pull\nG.defObject('sliver', { drain: .3, ghost: true,\n  init(o) { o.r = 9; o.ontop = true; o.t0 = o.x * .1; o.cx = o.x; o.cy = o.y; o.slashedIt = false; G.mkPull(o, { a: -1.2, depth: 12, maxV: 90 }); },\n  want: o => o.slashedIt ? 'forceps' : 'scalpel', canGrip: o => o.slashedIt, slashable: o => !o.slashedIt, verb: 'Slash',\n  slash(o, S, p) { o.slashedIt = true; o.bx = o.x; o.by = o.y; G.grade(S, p, o.x, o.y, 'clean', 'slash'); },\n  step(o, S, w) { if (o.slashedIt) return; o.t0 += w * T.strainSpeed * 1.1; o.x = o.cx + Math.cos(o.t0) * 26; o.y = o.cy + Math.sin(o.t0 * 1.7) * 13; o.bx = o.x; o.by = o.y; } });\n})();\nEOF\ncat > src/core/strains/tremolo.js <<'EOF'\n// Tremolo: a shivering web on the beating heart. Sedate reeds in the flare after each beat; burn the mass; pull it, slowly.\n(() => {\nconst G = (window.GAME ||= {}), { clamp, ev, rnd } = G, T = G.T;\nG.defObject('tremolo', { drain: 0, ghost: true,\n  init(o, S) { o.amp = 1; o.stage = 1; o.burn = 0; o.burnMax = 3 * T.strainHealth; o.wake = 6; o.r = 15; o.ontop = true; o.pin = 0; o.free2 = false; o.vp = o.vp || [[150, 80], [190, 110], [230, 130], [270, 120], [300, 90]]; o.vs = 2; o.vd = 1; o.cut = 0; for (let i = 0; i < (o.n || 5); i++) { const a = i / (o.n || 5) * 6.283 - 1.57; G.spawn(S, { t: 'reed', x: o.x + Math.cos(a) * 44, y: o.y + Math.sin(a) * 30, owner: o.id, a }); } },\n  want: o => o.stage === 2 ? (o.free2 && o.pin <= 0 ? 'forceps' : o.amp <= .21 ? 'cautery' : null) : o.stage === 3 ? 'forceps' : null,\n  canGrip: o => o.stage === 3 || (o.stage === 2 && o.free2), verb: 'Burn', burnOk: o => o.stage === 2 && o.amp <= .21,\n  grip(o, S, p) { if (o.stage === 2) { o.pin = 2; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return false; } if (!o.pull) G.mkPull(o, { a: -1.4, depth: 40, maxV: 42, par: 3 }); p.hold = { k: 'pull', id: o.id, gx: p.x, gy: p.y, p0: o.pull.prog, last: 0, v: 0 }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  burned(o, S, p, g) { o.burn = 0; o.stage = 3; G.grade(S, p, o.x, o.y, g, 'cautery'); S.flags.trem3 = true; ev(S, 'crack', Math.round(o.x), Math.round(o.y)); for (const q of S.objs) if (q.type === 'reed') q.dead = true; o.bx = o.x; o.by = o.y; },\n  caught(o, S) { S.flags.tremolo_dead = true; },\n  step(o, S, w, h) { const amp = o.amp; S.aura = { x: o.x, y: o.y, amp, r: 70 }; o.flare = S.sinceBeat < .3;\n    if (o.stage === 1 && amp <= .21) { o.stage = 2; o.burn = o.burnMax; o.burn0 = o.burnMax; ev(S, 'crack', Math.round(o.x), Math.round(o.y)); S.flags.trem2 = true; }\n    if (o.stage === 2) { if (o.pin > 0) o.pin -= w; o.wake -= w; if (o.wake <= 0) { o.wake = 6; for (const q of S.objs) if (q.type === 'reed' && q.sedated && !q.dead) { q.sedated = false; q.dose = true; o.amp = Math.min(1, o.amp + .2); ev(S, 'wake', Math.round(q.x), Math.round(q.y)); break; } }\n      if (!o.free2 && o.burn < o.burnMax / 2) { o.free2 = true; ev(S, 'tearfree', Math.round(o.x), Math.round(o.y)); }\n      if (o.free2 && o.pin <= 0) { o.vs = clamp(o.vs + o.vd * w * .45 * T.strainSpeed, 0, o.vp.length - 1.001); if (o.vs >= o.vp.length - 1.01 || o.vs <= 0) o.vd = -o.vd; const i = o.vs | 0, f = o.vs - i, a = o.vp[i], b = o.vp[i + 1]; o.x = a[0] + (b[0] - a[0]) * f; o.y = a[1] + (b[1] - a[1]) * f; o.cut += w; if (o.cut > 1.8) { o.cut = 0; G.addLac(S, o.x, o.y); } } }\n    else if (o.stage === 3) { o.amp = .08; } },\n});\nG.defObject('reed', { drain: 0, ghost: true, req: false,\n  init(o) { o.dose = true; o.sedated = false; o.ontop = true; o.r = 6; },\n  want: o => o.sedated ? null : 'syringe', verb: 'Inject', step(o, S) { o.open = S.sinceBeat < .3 && !o.sedated; },\n  dosed(o, S, p, g, half) { const m = G.getObj(S, o.owner); if (S.sinceBeat < .3 || S.breath) { o.sedated = true; o.dose = false; if (m) m.amp = Math.max(0, m.amp - (half ? .1 : .2)); G.grade(S, p, o.x, o.y, g, 'dose'); ev(S, 'sedate', Math.round(o.x), Math.round(o.y)); } else { ev(S, 'spit', Math.round(o.x), Math.round(o.y)); G.hurt(S, 2 * T.strainDamage); G.addLac(S, o.x + 6, o.y + 6); } } });\n})();\nEOF\ncat > src/core/strains/dacapo.js <<'EOF'\n// Da Capo: three lobes on a staff, each armor on its own timer. Kill all three inside the countdown or it plays from the top.\n(() => {\nconst G = (window.GAME ||= {}), { ev, rnd } = G, T = G.T;\nconst LOBE = { A: { per: 6, open: 2.5, off: 0 }, B: { per: 7, open: 2.5, off: 2 }, C: { per: 9, open: 3, off: 4 } };\nconst setStage = (o, d) => { o.dead2 = false; o.stageN = 0; o.burn = o.label === 'A' ? 1 * T.strainHealth : 0; o.burn0 = o.burn; o.dose = o.label === 'C'; o.salveT = 0; o.slashedIt = false; o.bx = o.x0; o.by = o.y0; o.x = o.x0; o.y = o.y0; o.pull = null; o.cov = null; };\nG.lobeOpen = (o, S) => { const L = LOBE[o.label], sp = S.ph.d.speed || 1, t = S.t * sp * T.strainSpeed + L.off; return (t % L.per) < L.open * (o.small ? 1.3 : 1); };\nG.lobeNext = (o, S, at = S.t) => { const L = LOBE[o.label], sp = S.ph.d.speed || 1, t = at * sp * T.strainSpeed + L.off, m = t % L.per; return m < L.open ? 0 : (L.per - m) / (sp * T.strainSpeed); };\nG.defObject('dacapo', { req: true, drain: .1,\n  init(o, S) { o.cd = -1; o.round = o.round || 1; o.ontop = true; o.lobes = []; o.regrew = 0; const px = [o.x - 74, o.x, o.x + 74], py = [o.y + 12, o.y - 18, o.y + 12]; ['A', 'B', 'C'].forEach((l, i) => { const q = G.spawn(S, { t: 'lobe', x: px[i], y: py[i], label: l, owner: o.id, small: !!o.small }); o.lobes.push(q.id); }); S.ph.d.speed = o.round > 1 ? 2 : 1; },\n  want: () => null,\n  step(o, S, w) { const L = o.lobes.map(id => G.getObj(S, id)).filter(Boolean), dead = L.filter(q => q.dead2).length; if (dead && o.cd < 0) { o.cd = (o.window || 10); ev(S, 'countdown'); } if (o.cd >= 0) { o.cd -= w; if (dead === L.length) { ev(S, 'fine', o.round); S.flags['dacapo_r' + o.round] = true; for (const q of L) q.dead = true; G.kill(S, o); return; } if (o.cd <= 0) { o.cd = -1; o.regrew++; G.hurt(S, 8 * T.strainDamage); ev(S, 'dacapo', Math.round(o.x), Math.round(o.y)); for (const q of L) if (q.dead2) setStage(q); } } } });\nG.defObject('lobe', { req: false, drain: 0, ghost: true,\n  init(o, S) { o.x0 = o.x; o.y0 = o.y; o.r = 14; o.ontop = true; setStage(o); },\n  want(o, S) { if (o.dead2 || !G.lobeOpen(o, S)) return null; if (o.label === 'A') return 'cautery'; if (o.label === 'B') return o.slashedIt ? 'forceps' : 'scalpel'; return o.dose ? 'syringe' : 'salve'; },\n  verb: 'Strike', step(o, S, w, h) { o.open = !o.dead2 && G.lobeOpen(o, S); if (o.dead2) return; if (o.label === 'C' && !o.dose && o.open) { for (const p of S.players) if (p.tool === 'salve' && !p.gone && p.trigPrev >= .3 && Math.hypot(p.x - o.x, p.y - o.y) < 24) { o.salveT += h; if (o.salveT >= 1 * T.strainHealth) { G.grade(S, p, o.x, o.y, 'clean', 'salve'); dieLobe(o, S); return; } } } },\n  burnOk: o => o.open && !o.dead2, burned(o, S, p, g) { G.grade(S, p, o.x, o.y, g, 'cautery'); dieLobe(o, S); },\n  slashable: (o, S) => o.label === 'B' && !o.slashedIt && o.open && !o.dead2, slash(o, S, p) { o.slashedIt = true; G.mkPull(o, { a: -1.57, depth: 10, maxV: 140 }); G.grade(S, p, o.x, o.y, 'clean', 'slash'); },\n  canGrip: (o, S) => o.label === 'B' && o.slashedIt && !o.dead2, grip(o, S, p) { p.hold = { k: 'pull', id: o.id, gx: p.x, gy: p.y, p0: o.pull.prog, last: 0, v: 0 }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  onFree(o, S, p) { G.grade(S, p, o.x, o.y, o.pull.tears ? 'clean' : 'textbook', 'forceps'); p.hold = null; p.tension = 0; ev(S, 'clink', Math.round(o.x), Math.round(o.y)); dieLobe(o, S); o.x = o.x0; o.y = o.y0; },\n  dosed(o, S, p, g) { if (!o.open || !o.dose) { ev(S, 'spit', Math.round(o.x), Math.round(o.y)); return; } o.dose = false; G.grade(S, p, o.x, o.y, g, 'dose'); } });\nfunction dieLobe(o, S) { o.dead2 = true; o.open = false; o.burn = 0; o.dose = false; ev(S, 'lobedead', Math.round(o.x), Math.round(o.y)); }\nG.defScript('dacapoBeads', (S) => { S.flags.swarm = true; S.beadCap = 4; for (let i = 0; i < 3; i++) G.spawn(S, { t: 'bead', x: 120 + i * 90, y: 150, req: false }); });\n})();\nEOF\ncat > src/core/strains/fermata.js <<'EOF'\n// Fermata: an eye in the gyri. Its hold domes stop everything inside; it opens only as a dome collapses. Case 10's foe.\n(() => {\nconst G = (window.GAME ||= {}), { ev, rnd, clamp } = G, T = G.T;\nG.defObject('dome', { req: false, ontop: true, init(o) { o.r = o.r || 34; o.life = o.life || 5; o.life0 = o.life; o.ontop = true; }, want: () => null,\n  step(o, S, w) { o.life -= w; if (o.life <= 0) { ev(S, 'domefall', Math.round(o.x), Math.round(o.y)); G.kill(S, o); const e = S.objs.find(q => q.type === 'fermata' && !q.dead); if (e) e.open = Math.max(e.open || 0, .7); } } });\nG.defObject('fermata', { drain: .15, ghost: true,\n  init(o) { o.r = 10; o.ontop = true; o.open = 0; o.hits = 0; o.stage2 = 1; o.domeT = 1; o.burn0 = .3 * T.strainHealth; o.burn = o.burn0; o.spots = o.spots || [[150, 90], [285, 85], [215, 150]]; o.si = 0; },\n  want: o => o.stage2 === 3 ? 'forceps' : o.open > 0 ? 'cautery' : null, verb: 'Burn', burnOk: o => o.open > 0, canGrip: o => o.stage2 === 3,\n  grip(o, S, p) { p.hold = { k: 'pull', id: o.id, gx: p.x, gy: p.y, p0: o.pull.prog, last: 0, v: 0 }; ev(S, 'grip', Math.round(o.x), Math.round(o.y)); return true; },\n  burned(o, S, p, g) { o.hits++; G.grade(S, p, o.x, o.y, g, 'cautery'); ev(S, 'eyehit', Math.round(o.x), Math.round(o.y)); o.burn = o.burn0; o.open = 0; if (o.hits >= (o.need || 3)) { S.flags.fermata1 = true; } },\n  marked(o, S) { S.flags.fermata_found = true; },\n  caught(o, S) { S.flags.fermata_dead = true; },\n  step(o, S, w) { if (o.open > 0) o.open -= w; if (o.stage2 === 1 && !S.flags.fermata1) { o.domeT -= w * T.spawnRate; let n = 0; for (const q of S.objs) if (q.type === 'dome' && !q.dead) n++; if (o.domeT <= 0 && n < 3 && o.open <= 0) { o.domeT = 2.6; const a = rnd(S) * 6.28; G.spawn(S, { t: 'dome', x: clamp(o.x + Math.cos(a) * (n ? 60 : 8), 70, 356), y: clamp(o.y + Math.sin(a) * (n ? 34 : 8), 40, 190) }); } } } });\nG.defScript('fermataFlee', S => { const e = S.objs.find(q => q.type === 'fermata'); if (!e) return; for (const q of S.objs) if (q.type === 'dome') q.dead = true; e.si = 1; e.x = e.spots[1][0]; e.y = e.spots[1][1]; e.stage2 = 2; e.hidden = true; e.mark = 0; e.stayMarked = true; e.open = 0; ev(S, 'flee', Math.round(e.x), Math.round(e.y)); G.spawn(S, { t: 'sliver', x: 130, y: 130 }); G.spawn(S, { t: 'sliver', x: 300, y: 140 }); });\nG.defScript('fermataPull', S => { const e = S.objs.find(q => q.type === 'fermata'); if (!e) return; e.stage2 = 3; e.hidden = false; G.mkPull(e, { a: -1.57, depth: 34, maxV: 30, off: 12, par: 3.6 }); });\n})();\nEOF\ncat > src/core/strains/cantor.js <<'EOF'\n// Cantor: the choir-organ around the heart. Four movements, each a phase: conducting, the hush, the forced rewinds, the Last Note.\n(() => {\nconst G = (window.GAME ||= {}), { ev, rnd, clamp, polyAt } = G, T = G.T;\nG.defObject('baton', { req: true, drain: .2, ghost: true,\n  init(o) { o.r = 11; o.ontop = true; o.u = 0; o.dirn = 1; o.pause = 0; o.cx = o.x; o.cy = o.y; o.rad = o.rad || 56; o.ph0 = o.ph0 || 0; },\n  want: o => o.pause > 0 ? 'scalpel' : null, slashable: o => o.pause > 0, verb: 'Slash', slash(o, S, p) { G.grade(S, p, o.x, o.y, 'textbook', 'slash'); ev(S, 'tendril', Math.round(o.x), Math.round(o.y)); G.kill(S, o); },\n  step(o, S, w) { if (o.pause > 0) { o.pause -= w; o.open = true; if (o.pause <= 0) o.dirn = -o.dirn; } else { o.open = false; o.u += o.dirn * w * .42 * T.strainSpeed; if (o.u >= 1 || o.u <= 0) { o.u = clamp(o.u, 0, 1); o.pause = 1.5; ev(S, 'batonrest', Math.round(o.x), Math.round(o.y)); } } const a = o.ph0 + (o.u - .5) * 2.4; o.x = o.cx + Math.cos(a) * o.rad; o.y = o.cy + Math.sin(a) * o.rad * .6; } });\nG.defObject('uvula', { drain: .25, ghost: true, init(o) { o.burn = o.burn0 = 1.5 * T.strainHealth; o.r = 8; o.ontop = true; }, want: () => 'cautery', verb: 'Burn' });\nG.defObject('voicebox', { drain: .3, ghost: true,   // the hush's voice: found by Sonar, sedated on the beat, three times\n  init(o) { o.hidden = true; o.mark = 0; o.hits = 0; o.moveT = 8; o.dose = true; o.r = 8; o.ontop = true; },\n  want: o => o.mark > 0 ? 'syringe' : null, verb: 'Inject',\n  step(o, S, w) { o.open = S.sinceBeat < .3; o.moveT -= w; if (o.moveT <= 0 && !(o.mark > 0)) { o.moveT = 8; o.x = clamp(o.x + (rnd(S) - .5) * 120, 100, 330); o.y = clamp(o.y + (rnd(S) - .5) * 70, 60, 170); } S.aura = { x: o.x, y: o.y, amp: .6, r: 110 }; },\n  dosed(o, S, p, g) { if (S.sinceBeat < .3 || S.breath) { o.hits++; G.grade(S, p, o.x, o.y, g, 'dose'); ev(S, 'sedate', Math.round(o.x), Math.round(o.y)); if (o.hits >= 3) { S.flags.voice_dead = true; G.kill(S, o); } else { o.mark = 0; o.moveT = 0; } } else { ev(S, 'spit', Math.round(o.x), Math.round(o.y)); G.hurt(S, 3); } } });\nG.defObject('repeatSign', { req: false, ghost: true, init(o) { o.r = 18; o.ontop = true; o.life = 3; o.open = true; }, want: () => 'scalpel', verb: 'Slash', slashable: () => true,\n  slash(o, S, p) { S.out.recap++; G.grade(S, p, o.x, o.y, 'textbook', 'slash'); ev(S, 'recapcut', Math.round(o.x), Math.round(o.y)); G.kill(S, o); },\n  step(o, S, w) { o.life -= w; if (o.life <= 0) { G.kill(S, o); if (S.ph.d) { S.ph.d.fire = true; } } } });\nG.defObject('note', { drain: 0, ghost: true, init(o) { G.mkPull(o, { a: -1.57, depth: 60, maxV: 58, off: 12, par: 3.2 }); o.ontop = true; }, want: () => 'forceps', verb: 'Draw out',\n  pulling(o, S) { ev(S, 'noterise', o.pull.prog / o.pull.depth); },\n  onFree(o, S, p) { p.hold = null; G.grade(S, p, o.x, o.y, o.pull.tears ? 'clean' : 'textbook', 'forceps'); G.kill(S, o); S.silent = true; S.out.hold = 3; S.out.holdDone = 'afterSilence'; ev(S, 'silence'); } });\nG.defScript('afterSilence', S => { S.silent = false; S.out.hold = 0; S.flags.note_out = true; ev(S, 'lastbeep'); });\nconst sing = (S, d, w) => { d.sing = (d.sing || 2) - w * T.spawnRate; if (d.sing > 0) return; d.sing = 4.5; let n = 0, b = 0; for (const q of S.objs) { if (q.type === 'bead' && !q.dead) n++; if ((q.type === 'bleeder') && !q.dead) b++; } const k = (d.k = (d.k || 0) + 1) % 3; ev(S, 'sing', k); if (k === 0 && n < 4) G.spawn(S, { t: 'bead', x: 120, y: 90, req: false }); else if (k === 1 && S.objs.filter(q => q.type === 'sliver' && !q.dead).length < 2) G.spawn(S, { t: 'sliver', x: 300, y: 130, req: false }); else if (b < 2) G.spawn(S, { t: 'bleeder', x: 150 + rnd(S) * 130, y: 70 + rnd(S) * 90, req: false }); };\nG.defScript('cantor1', (S, ph, w) => { const d = S.ph.d; sing(S, d, w); if (!d.stage2 && !S.objs.some(o => o.type === 'baton' && !o.dead)) { d.stage2 = true; ev(S, 'mouths'); for (const [x, y] of [[135, 100], [213, 72], [292, 100]]) G.spawn(S, { t: 'uvula', x, y }); } if (d.stage2 && !S.objs.some(o => o.type === 'uvula' && !o.dead)) d.done = true; });\nG.defScript('cantor2enter', S => { S.hush = true; ev(S, 'hush'); });\nG.defScript('cantor2', (S, ph, w) => { const d = S.ph.d; d.st = (d.st === undefined ? 15 : d.st) - w; if (d.st <= 0) { S.static = !S.static; d.st = S.static ? 8 : 15; ev(S, S.static ? 'staticon' : 'staticoff'); } d.readT = (d.readT || 3) - w; if (d.readT <= 0) { d.readT = 6; ev(S, 'readout', Math.round(S.v)); }\n  d.dome = (d.dome || 5) - w; if (d.dome <= 0) { d.dome = 7; if (S.objs.filter(o => o.type === 'dome' && !o.dead).length < 2) G.spawn(S, { t: 'dome', x: 120 + rnd(S) * 190, y: 70 + rnd(S) * 90, life: 5 }); }\n  if (S.flags.voice_dead) { d.done = true; } });\nG.defScript('cantor2leave', S => { S.hush = false; S.static = false; ev(S, 'hushend'); });\nG.defScript('cantor3', (S, ph, w) => { const d = S.ph.d; if (d.counterOpen > 0) d.counterOpen -= w; d.next = (d.next === undefined ? 12 : d.next) - w; if (S.out.recap >= (S.attract ? 2 : 6)) { d.done = true; return; }\n  d.haz = (d.haz || 3) - w; if (d.haz <= 0) { d.haz = 5; if (S.objs.filter(o => o.type === 'polyp' && !o.dead).length < 4) G.spawn(S, { t: 'polyp', x: 110 + rnd(S) * 210, y: 60 + rnd(S) * 110, req: false }); }\n  if (d.next <= 0 && !S.objs.some(o => o.type === 'repeatSign' && !o.dead)) { G.spawn(S, { t: 'repeatSign', x: 213, y: 96 }); d.next = 17; ev(S, 'windup'); }\n  if (d.fire) { d.fire = false; const secs = T.lookSeconds, cnt = S.out; const n = S.ph.d.next; if (G.Op.rewind(S, secs, true)) { S.ph.d.counterOpen = 4.5; S.ph.d.next = n; } ev(S, 'forced'); } });\nG.defScript('cantor4', (S, ph, w) => { S.flags.heart = true; if (S.flags.note_out) S.ph.d.done = true; });\n})();\nEOF\ncat > src/core/strains/device.js <<'EOF'\n// Case 9's rigged pacemaker: screws turned by circling, a board that disagrees with the chart, wires cut in the true order.\n(() => {\nconst G = (window.GAME ||= {}), { ev, clamp } = G;\nG.defObject('screw', { drain: 0, ghost: false, init(o) { o.turn = 0; o.ontop = true; o.r = 5; }, want: () => 'forceps', verb: 'Turn',\n  grip(o, S, p) { p.hold = { k: 'turn', id: o.id, lx: p.x, ly: p.y, la: null }; ev(S, 'grip', o.x, o.y); return true; },\n  held(o, S, p, h) { const H = p.hold, dx = p.x - H.lx, dy = p.y - H.ly; if (Math.hypot(dx, dy) < 1.2) return; const a = Math.atan2(dy, dx); H.lx = p.x; H.ly = p.y; if (H.la !== null) { let d = a - H.la; while (d > 3.1416) d -= 6.2832; while (d < -3.1416) d += 6.2832; if (Math.abs(d) < 1.6) o.turn += Math.abs(d); } H.la = a; p.tension = 0; o.ang = (o.ang || 0) + .3; if (Math.floor(o.turn / 3.14) !== o.lastTick) { o.lastTick = Math.floor(o.turn / 3.14); ev(S, 'ratchet', o.x, o.y); }\n    if (o.turn >= 18.85) { G.grade(S, p, o.x, o.y, 'clean', 'forceps'); ev(S, 'clink', o.x, o.y); p.hold = null; G.kill(S, o); } },\n  release(o, S, p) { p.tension = 0; } });\nG.defObject('boardmark', { req: false, ontop: true, init(o) { o.hidden = true; o.mark = 0; o.stayMarked = true; o.ontop = true; }, want: () => null, marked(o, S) { S.flags.board = (S.flags.board || 0) + 1; ev(S, 'boardread', o.order); } });\nG.defObject('lead', { drain: 0, init(o) { o.burn = o.burn0 = .9; o.ontop = true; }, want: () => 'cautery', verb: 'Solder' });\nG.defObject('wire', { drain: 0, init(o) { o.r = 7; o.ontop = true; }, want: () => 'scanned', slashable: () => true, verb: 'Slash',\n  aim: o => [o.x, o.y],\n  slash(o, S, p) { const c = S.ph.d, next = (c.nextWire || 0); if (o.order === next) { c.nextWire = next + 1; G.grade(S, p, o.x, o.y, 'textbook', 'slash'); ev(S, 'wirecut', o.x, o.y); G.kill(S, o); } else { ev(S, 'wrongwire', o.x, o.y); if (!o.hurtT || S.t - o.hurtT > 1) { o.hurtT = S.t; G.slip(S, p, o.x, o.y, 30, 'wire'); S.clock = Math.max(1, S.clock - 30); } } } });\nG.defObject('can', { drain: 0, init(o) { G.mkPull(o, { a: -1.57, depth: 26, maxV: 34, off: 14, par: 3.6 }); o.ontop = true; }, want: () => 'forceps', verb: 'Lift', caught(o, S) { S.flags.can_out = true; } });\nG.OBJ.wire.want = (o, S) => (o.order === (S.ph.d.nextWire || 0)) ? 'scalpel' : null;\n})();\nEOF","description":"Write op core and all strain simulations"}}}
