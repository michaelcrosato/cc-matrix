{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjtKBvmkvjhqmQ3S81e7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014PjbnPao7xcxJ9z5GLd2cx","name":"Bash","input":{"command":"cat > src/art/rigs.js <<'EOF'\n// Bodies for the ward and cinematics: the engine's Humanoids, dressed for a hospital, with new poses, a surgical cap, a mask and held instruments.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px } = E, H = E.Humanoid;\nH.hat('surgcap', (g, x, y, r, o) => { const c = (o && o.color) || '#2bb0a2'; px.ell(g, x, y - (r || 6) * .35, (r || 6) * 1.05, (r || 6) * .72, c); px.rect(g, x - (r || 6) | 0, y - 1 | 0, (r || 6) * 2 | 0, 2, E.tones(c).sh); });\nH.pose('scrub', (J, w) => { for (const k of ['handL', 'handR']) { const s = k === 'handL' ? -1 : 1; J[k][0] += (6 - J[k][0]) * w; J[k][1] += (s * 2.5 - J[k][1]) * w; J[k][2] += (J.shC[2] + 2 - J[k][2]) * w; } for (const k of ['elbowL', 'elbowR']) { const s = k === 'elbowL' ? -1 : 1; J[k][0] += (3 - J[k][0]) * w; J[k][1] += (s * 5 - J[k][1]) * w; J[k][2] += (J.shC[2] - 5 - J[k][2]) * w; } });\nH.pose('push', (J, w) => { for (const k of ['handL', 'handR']) { const s = k === 'handL' ? -1 : 1; J[k][0] += (9 - J[k][0]) * w; J[k][1] += (s * 3 - J[k][1]) * w; J[k][2] += (J.shC[2] - 4 - J[k][2]) * w; } });\nH.pose('lean', (J, w) => { const lean = 3; J.head[0] += lean * w; J.shC[0] += lean * .8 * w; for (const k of ['handL', 'handR']) { const s = k === 'handL' ? -1 : 1; J[k][0] += (8 - J[k][0]) * w; J[k][1] += (s * 2 - J[k][1]) * w; J[k][2] += (J.hipC[2] + 1 - J[k][2]) * w; } });\nH.pose('pass', (J, w) => { J.handR[0] += (10 - J.handR[0]) * w; J.handR[2] += (J.shC[2] - 2 - J.handR[2]) * w; J.handR[1] += (2 - J.handR[1]) * w; });\nH.pose('knit', (J, w, rig) => { const t = (rig && rig.t) || 0, k = Math.sin((rig ? rig._knit = (rig._knit || 0) + .1 : 0)) * 1; for (const n of ['handL', 'handR']) { const s = n === 'handL' ? -1 : 1; J[n][0] += (6 + s * k - J[n][0]) * w; J[n][1] += (s * 1.6 - J[n][1]) * w; J[n][2] += (J.hipC[2] + 3 - J[n][2]) * w; } });\nconst mask = c => ({ over(g, Q) { if (!Q || !Q.head) return; const h = Q.head; px.rect(g, h[0] - 3 | 0, h[1] | 0, 7, 3, c); } });\nH.weapon('tray', { length: 6, rest: [.5, .3, -.5], blade: false, draw(w) { } });\nconst R = (o) => new E.Humanoid(Object.assign({ size: 1.3, weapon: null, outfit: 'shirt', sleeves: 'short' }, o));\nconst defs = {\n  vale: () => R({ hat: { style: 'surgcap', color: '#2bb0a2' }, hair: 'short', colors: { skin: '#f6d0b2', hair: '#c9562a', cloth: '#2f9c8e', pants: '#2f9c8e', boot: '#d8e0e0', belt: '#2f9c8e', trim: '#2bb0a2' } }),\n  sokolova: () => R({ build: 'heroic', hair: 'long', hat: { style: 'band', color: '#c8352a' }, colors: { skin: '#e8c6aa', hair: '#dedad2', cloth: '#6b7a48', pants: '#566038', boot: '#3a3020', belt: '#3a3020' } }),\n  quill: () => R({ build: 'bulky', hair: 'short', hat: { style: 'surgcap', color: '#35558f' }, colors: { skin: '#dcae8e', hair: '#8d8a88', cloth: '#3d62a6', pants: '#3d62a6', boot: '#28303a', belt: '#3d62a6' } }),\n  oyelaran: () => R({ build: 'heroic', outfit: 'coat', sleeves: 'long', hair: 'short', colors: { skin: '#7c4a2e', hair: '#c9c5bb', cloth: '#2e2c36', coat: '#ece7da', pants: '#2e2c36', boot: '#1a1820', trim: '#ece7da' } }),\n  percy: () => R({ build: 'heroic', outfit: 'coat', sleeves: 'long', hair: 'short', colors: { skin: '#efcfae', hair: '#d8b45a', cloth: '#7a90b0', coat: '#f4f4f0', pants: '#3a4050', boot: '#20242c', trim: '#f4f4f0' } }),\n  odalys: () => R({ hair: 'spiky', outfit: 'tunic', sleeves: 'long', colors: { skin: '#b98a62', hair: '#3a2420', cloth: '#c06a5a', pants: '#3a3a50', boot: '#4a3020', trim: '#e8d0a0' } }),\n  hale: () => R({ build: 'heroic', outfit: 'coat', sleeves: 'long', hair: 'short', colors: { skin: '#e6c4a4', hair: '#c4c6cc', cloth: '#e8e8f0', coat: '#343c54', pants: '#2a3044', boot: '#14161e', trim: '#343c54' } }),\n  patient: (c = '#a8c8d8', hair = '#5a4030', skin = '#e8c0a0') => R({ hair: 'short', outfit: 'robe', colors: { skin, hair, cloth: c, pants: c, boot: '#d8e0e0' } }),\n};\nconst cache = {};\nG.rig = (id, ...a) => { if (a.length) return defs.patient(...a); return (cache[id] = cache[id] || (defs[id] || defs.patient)()); };\nG.newRig = (id, ...a) => (defs[id] || defs.patient)(...a);\n})();\nEOF\ncat > src/scenes/cine.js <<'EOF'\n// Short cinematics, 4 to 8 s and skippable, played by the story scene: in-engine rigs in the threequarter view, and one ship in side view.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst WALL = { 1: { h: 28, top: '#2a3a3a', side: '#4a6660', face: 'plaster' }, 2: { h: 28, top: '#2a3a3a', side: '#6a7a70', face: 'plaster' } };\nconst corridor = (w, h) => { const rows = ['#'.repeat(w)]; for (let i = 0; i < h - 2; i++) rows.push('#' + '.'.repeat(w - 2) + '#'); rows.push('#'.repeat(w)); return new E.TileMap({ rows, legend: { '#': 1 }, types: WALL, floorMat: 'flagstone', outside: '#0a1214' }); };\nconst lane = (id, from, to, dur, st = {}) => ({ rig: G.newRig(id), from, to, dur, st });\nconst simple = (o) => ({ view: 'threequarter', ...o });\nG.CINE = {\n  scrubin: simple({ dur: 3.4, cap: 'Scrubbing in', map: () => corridor(10, 6), props: [['crashCart', 56, 40], ['surgicalLamp', 110, 40]], focus: [80, 48], actors: () => [lane('vale', [70, 56], [70, 56], 1, { pose: 'scrub', facing: -1.57 }), lane('quill', [110, 60], [92, 60], 2, { pose: 'pass', facing: 3.14 })] }),\n  gurney: simple({ dur: 5, cap: 'Crane Nine. Everyone runs.', map: () => corridor(30, 6), props: [['ivStand', 140, 28], ['crashCart', 240, 28], ['vitalsMonitor', 340, 28]], gurney: true, focusF: t => [60 + t * 72, 48], actors: () => [lane('vale', [20, 50], [380, 50], 5, { pose: 'push', facing: 0, run: 1 }), lane('quill', [8, 60], [368, 60], 5, { pose: 'push', facing: 0, run: 1 }), lane('patient', [50, 50], [410, 50], 5, { down: 1, facing: 0 })] }),\n  galacollapse: simple({ dur: 4.5, cap: 'The cane rolls across the floor.', map: () => corridor(14, 8), props: [['table', 40, 40], ['table', 180, 40]], focus: [110, 60], actors: () => [lane('oyelaran', [90, 60], [106, 60], 2, { facing: 0, dieAt: 1.8 }), lane('hale', [160, 44], [160, 44], 1, { pose: 'wave', facing: 3.14 }), lane('vale', [30, 76], [86, 66], 3, { facing: 0, run: 1 })] }),\n  traydrop: simple({ dur: 3.2, cap: 'A crash, in Theatre Three.', map: () => corridor(10, 6), props: [['crashCart', 110, 36]], focus: [80, 48], actors: () => [lane('quill', [80, 52], [80, 52], 1, { facing: 1.57, kneel: true }), lane('vale', [40, 54], [58, 54], 2, { facing: 0 })], tray: true }),\n  percycollapse: simple({ dur: 3.6, cap: 'He is still smiling.', map: () => corridor(12, 6), props: [['vendingMachine', 50, 28]], focus: [90, 48], actors: () => [lane('percy', [86, 52], [86, 52], 1, { facing: 3.14, dieAt: 1.2 }), lane('vale', [130, 54], [100, 54], 1.4, { facing: 3.14, run: 1 })] }),\n  finaltable: simple({ dur: 6, cap: 'Everyone is there.', map: () => corridor(14, 9), props: [['operatingTable', 112, 72], ['surgicalLamp', 80, 44], ['surgicalLamp', 146, 44], ['vitalsMonitor', 170, 60], ['crashCart', 56, 90]], focusF: t => [112, 72 - t * 2], actors: () => [lane('vale', [92, 76], [92, 76], 1, { pose: 'lean', facing: 0 }), lane('sokolova', [132, 76], [132, 76], 1, { pose: 'lean', facing: 3.14 }), lane('quill', [112, 104], [112, 100], 1.5, { pose: 'pass', facing: -1.57 }), lane('percy', [176, 76], [176, 76], 1, { facing: 3.14 }), lane('odalys', [50, 60], [50, 60], 1, { facing: 0, pose: 'hips' }), lane('oyelaran', [112, 28], [112, 28], 1, { facing: 1.57 })] }),\n  erchaos: simple({ dur: 6, cap: 'The city wakes in pain.', map: () => corridor(24, 8), props: [['hospitalBed', 60, 40], ['hospitalBed', 140, 40], ['hospitalBed', 220, 40], ['gurney', 300, 44]], focusF: t => [100 + t * 20, 60], actors: () => { const c = ['#a8c8d8', '#d8a890', '#a890c8', '#c8c890']; const A = [lane('vale', [80, 90], [300, 90], 6, { facing: 0, run: 1 })]; for (let i = 0; i < 8; i++) { const a = lane('patient', [40 + i * 40, 70 + (i % 3) * 12], [60 + i * 36, 80 + ((i + 1) % 3) * 10], 2 + i % 3, { facing: i * 1.3, pose: i % 2 ? 'wave' : 'cheer' }); a.rig = G.newRig('patient', c[i % 4]); A.push(a); } return A; } }),\n  stormship: { view: 'side', dur: 6, cap: 'The launch, in a Force Nine.', custom: true, enter() { }, draw(r, t) { r.overlay(g => { const W = r.W, H = r.H; for (let y = 0; y < H; y += 4) px.rect(g, 0, y, W, 4, E.mix('#060c14', '#1c2c38', y / H)); if ((t * 5 | 0) % 17 === 0) px.rect(g, 0, 0, W, H, '#8aa0b0'); const roll = Math.sin(t * 1.3) * .18, cx = W * .55, cy = H * .55 + Math.sin(t * 1.1) * 8, c = Math.cos(roll), s = Math.sin(roll), P = (x, y) => [cx + x * c - y * s, cy + x * s + y * c]; for (let i = 0; i < 3; i++) { const yy = H * (.5 + i * .12); for (let x = 0; x < W; x += 4) { const wy = yy + Math.sin(x * .03 + t * (1.4 + i * .3) + i) * (9 - i * 2); if (i === 0) px.rect(g, x, wy, 4, 2, '#3a5a6a'); } } px.poly(g, [P(-110, 0), P(120, 0), P(90, 26), P(-90, 26)], '#22303a'); px.poly(g, [P(-110, 0), P(120, 0), P(118, 5), P(-108, 5)], '#b8c4c8'); px.poly(g, [P(-50, 0), P(30, 0), P(26, -28), P(-46, -28)], '#d8e0e0'); px.poly(g, [P(-14, -8), P(-4, -8), P(-4, -18), P(-14, -18)], '#c8352a'); px.poly(g, [P(-18, -11), P(0, -11), P(0, -15), P(-18, -15)], '#c8352a'); const l = P(-30, -36); px.line(g, l[0], l[1], P(-30, -28)[0], P(-30, -28)[1], '#889', 1); px.blend(g, .4, 'add', () => px.disc(g, l[0], l[1], 7, '#ffe8a0')); const lx = W * .18 + Math.sin(t * 1.4) * 6, ly = H * .62 + Math.sin(t * 2.1) * 12; px.poly(g, [[lx - 24, ly], [lx + 24, ly - 4], [lx + 16, ly + 10], [lx - 18, ly + 12]], '#3a4048'); px.rect(g, lx - 4, ly - 12, 6, 10, '#2f9c8e'); px.rect(g, lx + 6, ly - 12, 7, 10, '#3d62a6'); for (let i = 0; i < 2; i++) { const yy = H * (.66 + i * .14); for (let x = 0; x < W; x += 3) { const wy = yy + Math.sin(x * .025 + t * (1.2 + i * .4)) * (12 - i * 3); px.rect(g, x, wy, 3, H - wy, i ? '#0c1c28' : '#14303c'); } } for (let i = 0; i < 140; i++) { const a = (i * 73.13) % 1, b = (i * 37.77) % 1; px.line(g, (a * W + t * 160 + i) % W | 0, (b * H + t * (260 + i % 60)) % H | 0, ((a * W + t * 160 + i) % W | 0) - 3, ((b * H + t * (260 + i % 60)) % H | 0) - 6, '#7a9ab0', 1); } }); } },\n};\nclass CinePlayer {\n  constructor(game, id) { this.game = game; this.def = G.CINE[id]; this.id = id; this.t = 0; const D = this.def; game.setView(D.view); if (D.custom) { game.setView('side'); return; } this.map = D.map(); game.cam.bounds = null; this.actors = D.actors(); game.lights.enabled = true; game.lights.ambient = .62; G.sfxFor && G.sfxFor(id); }\n  get done() { return this.t >= this.def.dur; }\n  update(dt) { this.t += dt; const D = this.def, t = this.t, game = this.game; if (D.custom) { game.focus(game.W / 2, 0, game.H / 2); return; } const f = D.focusF ? D.focusF(t) : D.focus; game.focus(f[0], f[1], 10); for (const a of this.actors) { const k = Math.min(1, t / a.dur), x = a.from[0] + (a.to[0] - a.from[0]) * k, y = a.from[1] + (a.to[1] - a.from[1]) * k, vx = k < 1 ? (a.to[0] - a.from[0]) / a.dur : 0, vy = k < 1 ? (a.to[1] - a.from[1]) / a.dur : 0; a.x = x; a.y = y; const st = { x, y, z: 0, vx, vy, facing: a.st.facing || 0, pose: a.st.pose, down: a.st.down, run: k < 1 ? a.st.run : 0 }; if (a.st.dieAt !== undefined && t > a.st.dieAt) st.pose = 'die'; if (a.st.kneel) st.pose = 'kneel'; a.rig.update(dt, st); } }\n  draw(r) { const D = this.def, t = this.t; if (D.custom) { D.draw(r, t); this.caption(r); return; } this.map.drawFloor(r); this.map.queueWalls(r); for (const p of D.props) r.shape(p[0], p[1], p[2], 0, { facing: p[3] === undefined ? 1.57 : p[3] }); const L = this.game.lights; L.add(r.W ? 100 : 0, 40, 40, 200, .8, { color: '#d8f0e8' }); if (D.gurney) { const a = this.actors[2]; r.shape('gurney', a.x, a.y, 0, { facing: 0 }); } for (const a of this.actors) { r.shadow(a.x, a.y, 6); r.actor(a.x, a.y, a.st.down ? 11 : 0, (g, ox, oy) => a.rig.draw(g, ox, oy, r.view)); } if (D.tray) { const k = Math.min(1, t / 1.0); r.overlay(g => { for (let i = 0; i < 6; i++) { const a = i * 1.1; const o = r.w(84 + Math.cos(a) * 14 * k, 60 + Math.sin(a) * 8 * k, 0); px.rect(g, o[0], o[1] - 2, 5, 1, '#d8e4ee'); } }); } this.caption(r); }\n  caption(r) { r.overlay(g => { px.rect(g, 0, 0, r.W, 18, '#000000'); px.rect(g, 0, r.H - 22, r.W, 22, '#000000'); font.text(g, this.def.cap, r.W / 2, r.H - 16, '#e8fbf6', { align: 'center', outline: false }); }); }\n  finish() { const game = this.game; game.lights.enabled = false; game.setView('overhead'); }\n}\nG.CinePlayer = CinePlayer;\n})();\nEOF\ncat > src/scenes/story.js <<'EOF'\n// The story scene: a painted stage, big portraits, typed lines with gibberish voices, chapter cards, cinematics, a backlog.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst STAFF = { vale: 1, quill: 1, sokolova: 1, oyelaran: 1 };\nconst LEFT = { vale: 1, sokolova: 1 };\nG.SCENES = G.SCENES || {};\nG.makeStory = (game) => { const people = {}; for (const id in G.CAST) people[id] = { name: G.CAST[id].name };\n  const talk = new E.Dialog(game, { voice: (ch) => G.babble.letter(ch, G.curWho || 'quill'), speed: 46, lines: 2, width: 416, bg: '#06161a', border: '#5ff0e0', nameColor: '#5ff0e0' });\n  const story = new E.Story(game, { people, nodes: G.compileStory(), dialog: talk, on: { stage: (s, st) => G.storyView.setStage(st.arg), look: (s, st) => G.storyView.look(st.who, st.expr), card: (s, st) => G.storyView.card(st.arg), cine: (s, st) => G.storyView.cine(st.arg) } });\n  return story; };\nclass StoryView {\n  constructor(game) { this.game = game; this.reset(); }\n  reset() { this.stage = null; this.slots = { L: null, R: null }; this.t = 0; this.cardT = 0; this.cardText = null; this.player = null; this.backlog = false; this.blinkT = 2; this.speaker = null; }\n  setStage(id) { this.stage = id; this.slots = { L: null, R: null }; const m = { harbor: 'tension', gala: 'tension', theatre: 'tension', chapel: 'ward', scrub: 'ward', radiology: 'ward', office: 'tension', ward: 'ward', shipward: 'tension', gallery: 'ward' }[id]; if (!this.silent) G.music.play(m || 'ward'); }\n  look(who, expr) { G.curWho = who; this.speaker = who; const side = LEFT[who] ? 'L' : 'R', cur = this.slots[side]; if (cur && cur.who === who) { if (cur.expr !== expr && (expr === 'shock' || expr === 'shout')) cur.shake = .3; cur.expr = expr; } else this.slots[side] = { who, expr, slide: 0, shake: expr === 'shock' ? .3 : 0 }; }\n  card(arg) { const [a, b] = arg.split('|'); this.cardText = [a, b]; this.cardT = 2.6; G.sfx.swell(); }\n  cine(id) { this.player = new G.CinePlayer(this.game, id); G.sfx.swell(); if (id === 'stormship') { G.sfx.foghorn(); G.sfx.creak(); } }\n  update(dt) { const game = this.game, I = game.input, story = G.story; this.t += dt; this.blinkT -= dt; if (this.blinkT < -.12) this.blinkT = 2 + Math.random() * 3; for (const k in this.slots) { const q = this.slots[k]; if (q) { q.slide = Math.min(1, q.slide + dt * 4); if (q.shake > 0) q.shake -= dt; } }\n    if (this.cardT > 0) { this.cardT -= dt; if (I.pressed('confirm') || I.clicked()) this.cardT = Math.min(this.cardT, .2); if (this.cardT <= 0) { this.cardText = null; story.resume(); } return true; }\n    if (this.player) { this.player.update(dt); if (this.player.done || I.pressed('confirm') || I.clicked()) { this.player.finish(); this.player = null; game.focus(game.W / 2, game.H / 2, 0); story.resume(); } return true; }\n    game.focus(game.W / 2, game.H / 2, 0);\n    if (I.pressed('log')) this.backlog = !this.backlog; if (this.backlog) { if (I.pressed('cancel') || I.pressed('confirm')) this.backlog = false; I.consumeAll(); return true; }\n    story.skip = I.down('skip') || !!this.autoSkip; story.update(dt); return story.running; }\n  draw(r) { if (this.player) { this.player.draw(r); return; } const talk = G.story.talk; r.overlay(g => { if (this.stage) G.drawStage(g, this.stage, r.W, r.H, this.t); else px.rect(g, 0, 0, r.W, r.H, '#000'); for (const side of ['L', 'R']) this.drawSlot(g, r, side, talk);\n      if (this.cardText) { px.blend(g, .8, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); const w = r.W; font.text(g, this.cardText[0].toUpperCase(), w / 2, r.H / 2 - 30, '#5ff0e0', { align: 'center', outline: false, shadow: '#000' }); font.title(g, this.cardText[1], w / 2, r.H / 2 - 14, { scale: 3, align: 'center', colors: ['#ffffff', '#a8e8e0'] }); }\n      if (this.stage && talk.open && !this.cardText) { const inp = this.game.input; const w = G.promptWidth(inp, 'skip', 'Hold: skip') + G.promptWidth(inp, 'log', 'Log') + 10; let x = r.W - w - 6; x += G.drawPrompt(g, inp, 'skip', 'Hold: skip', x, 4) + 10; G.drawPrompt(g, inp, 'log', 'Log', x, 4); } if (this.backlog) this.drawLog(g, r); });\n    G.story.draw(r); }\n  drawSlot(g, r, side, talk) { const q = this.slots[side]; if (!q) return; const speaking = q.who === this.speaker, typing = speaking && talk.open && talk.typing, mouth = typing && (this.t * 10 | 0) % 2, c = G.bust(q.who, q.expr, { blink: this.blinkT < 0 && !typing, talk: mouth, maskUp: this.stage === 'theatre' && STAFF[q.who] && q.expr !== 'shock' }), e = 1 - (1 - q.slide) ** 3, W = r.W, base = side === 'L' ? Math.max(12, W * .18 - 56) : Math.min(W - 124, W * .82 - 56), off = (1 - e) * (side === 'L' ? -140 : 140), bob = typing ? Math.sin(this.t * 14) * 1 : Math.sin(this.t * 1.6) * .7, sh = q.shake > 0 ? Math.sin(this.t * 70) * 2 : 0; px.reset(g); const a = g.globalAlpha; if (!speaking) g.globalAlpha = .72; g.drawImage(c, base + off + sh | 0, r.H - 128 - 22 + bob | 0); g.globalAlpha = a; px.reset(g); }\n  drawLog(g, r) { px.blend(g, .9, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); font.text(g, 'BACKLOG', 12, 8, '#5ff0e0', { outline: false }); const L = G.story.log.slice(-9); L.forEach((e, i) => { const y = 24 + i * 24; font.text(g, e.name || '', 12, y, '#5ff0e0', { outline: false }); font.text(g, e.text.slice(0, 90), 12, y + 10, '#e8fbf6', { outline: false }); }); }\n}\nG.StoryView = StoryView;\nG.SCENES.story = { pausable: true, view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; game.saves.canSave = false; const V = G.storyView; V.reset(); V.silent = false; this.then = d.then; G.story.auto = d.auto || 0; V.autoSkip = !!d.autoSkip; G.story.run(d.id, { onDone: () => { this.done = true; } }); this.done = false; },\n  update(dt) { G.storyView.update(dt); if (this.done && !G.storyView.player) { this.done = false; const t = this.then; this.then = null; if (t) t(); } },\n  draw(r) { G.storyView.draw(r); } };\n})();\nEOF\ncat > src/scenes/flow.js <<'EOF'\n// Everything between the operations: title, menu, difficulty, chart, lightbox, results, lost, case files, credits, about.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst SC = G.SCENES = G.SCENES || {};\nconst center = (g, s, x, y, c, o = {}) => font.text(g, s, x, y, c, Object.assign({ align: 'center', outline: false, shadow: '#000' }, o));\n// ---- progress ----\nconst fresh = () => ({ flow: 0, diff: 'resident', ranks: {}, unlocked: ['c1'], ended: false, morale: false });\nG.prog = fresh();\nG.loadProg = () => { const p = E.store.get('scalpel.prog', null); if (p) G.prog = Object.assign(fresh(), p); };\nG.saveProg = () => { E.store.set('scalpel.prog', G.prog); };\nG.newGame = (diff) => { const keep = G.prog.ranks, ended = G.prog.ended, un = G.prog.unlocked; G.prog = fresh(); G.prog.ranks = keep; G.prog.ended = ended; G.prog.unlocked = un; G.prog.diff = diff; G.saveProg(); };\nG.flowGo = (i) => { const game = G.game, it = G.FLOW[i]; G.prog.flow = i; G.saveProg(); if (!it) { game.go('title'); return; } if (it.k === 'story') game.go('story', { id: it.id, then: () => G.flowGo(i + 1) }); else if (it.k === 'case') game.go('chart', { caseId: it.id, mode: 'story', then: () => G.flowGo(i + 1) }); else if (it.k === 'ward') game.go('ward', { map: it.map, after: it.after, then: () => G.flowGo(i + 1) }); else game.go('credits', { ending: true }); };\n// Title and menu share the skyline\nconst skyline = () => { if (G._sky) return G._sky; G._sky = new E.Backdrop({ sky: ['#04060e', '#0c1624', '#1c2c3c'], moon: false, stars: 40, starsY: .4, layers: [{ kind: 'city', color: '#0c1622', y: .58, height: .3, parallax: .1 }, { kind: 'fog', color: '#1c3040', y: .7, parallax: .2 }] }); return G._sky; };\nfunction drawHarbor(r, t, logoY) { skyline().draw(r); r.overlay(g => { const W = r.W, H = r.H, bx = W * .5 | 0, by = H * .78 | 0; const crane = (x, s) => { px.line(g, x, by, x, by - 80 * s, '#0a1218', 3); px.line(g, x - 14 * s, by - 70 * s, x + 60 * s, by - 78 * s, '#0a1218', 2); px.line(g, x, by - 92 * s, x + 60 * s, by - 78 * s, '#0a1218', 1); px.line(g, x, by - 92 * s, x - 14 * s, by - 70 * s, '#0a1218', 1); }; crane(W * .1 | 0, 1.1); crane(W * .86 | 0, 1.3); px.rect(g, bx - 110, by - 74, 220, 74, '#141e28'); px.rect(g, bx - 40, by - 110, 80, 36, '#18242e'); px.rect(g, bx + 110, by - 54, 70, 54, '#a8c0c8'); for (let y = 0; y < 8; y++) for (let x = 0; x < 19; x++) { const k = (x * 7 + y * 13) % 5; if (k < 3) px.rect(g, bx - 104 + x * 11, by - 70 + y * 9, 7, 6, k ? '#e8c870' : '#88a8b0'); } for (let y = 0; y < 3; y++) for (let x = 0; x < 6; x++) px.rect(g, bx + 114 + x * 11, by - 50 + y * 15, 7, 10, '#1c5a68'); px.rect(g, bx - 8, by - 108, 16, 5, '#e84a4a'); px.rect(g, bx - 3, by - 113, 6, 15, '#e84a4a'); font.text(g, 'ANODYNE', bx + 144, by - 62, '#5ff0e0', { align: 'center', font: 'tiny', outline: false }); px.rect(g, 0, by, W, H - by, '#0a141c'); for (let y = by + 4; y < H; y += 5) for (let x = (y * 3) % 17; x < W; x += 26) px.rect(g, x + Math.sin(t + y) * 4, y, 12, 1, '#284050');\n    const a = (t * .14) % 1.4 - .2, ax = a * W; if (a < 1.1) { px.rect(g, ax, by - 12, 26, 11, '#d8e0e4'); px.rect(g, ax + 2, by - 10, 6, 4, '#3a5060'); px.rect(g, ax + 14, by - 8, 6, 2, '#c82a2a'); if ((t * 6 | 0) % 2) { px.rect(g, ax + 12, by - 14, 4, 2, '#ff3030'); px.blend(g, .3, 'add', () => px.disc(g, ax + 14, by - 14, 18, '#ff3030')); } else { px.rect(g, ax + 18, by - 14, 4, 2, '#3060ff'); px.blend(g, .3, 'add', () => px.disc(g, ax + 20, by - 14, 18, '#3060ff')); } }\n    font.title(g, G.GAME_TITLE, W / 2, logoY, { scale: W > 460 ? 4 : 3, align: 'center', colors: ['#ffffff', '#a8e8e0', '#5ff0e0'], depth: 2, depthColor: '#0b2a30' }); const k = Math.min(1, t / 1.6), y0 = logoY + (W > 460 ? 40 : 32), L = Math.min(W - 40, 320), X0 = W / 2 - L / 2; let lx = X0, ly = y0; for (let i = 1; i <= L * k; i += 1) { const u = ((i / L * 5) + t * .1) % 1, v = G.ecgValue(u) * 14; const yy = y0 - v; px.line(g, lx, ly, X0 + i, yy, '#40f0a0', 1); lx = X0 + i; ly = yy; } }); }\nSC.title = { view: 'side', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; game.saves.canSave = false; this.t = 0; game.weather = { kind: 'rain', amount: .7, wind: .2, lightning: .05 }; G.music.play('title'); this.b = -1; G.touchNotice && G.touchNotice(); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, 0, game.H / 2); const n = this.t * .9 | 0; if (n !== this.b && this.t < 1.8) { this.b = n; G.sfx.beep(70); } if (I.anyPressed() || I.clicked()) { if (this.t > .3) { I.consumeAll(); G.sfx.ui(); game.go('menu'); } } },\n  draw(r) { drawHarbor(r, this.t, 28); r.overlay(g => { if ((this.t * 1.6 | 0) % 2 === 0) { const I = G.game.input; center(g, I.lastDevice === 'gamepad' ? 'Press ' + I.label('start') : I.lastDevice === 'mouse' ? 'Click to begin' : 'Press ' + I.label('start'), r.W / 2, r.H * .72, '#ffffff', { scale: 1 }); } center(g, G.TAGLINE, r.W / 2, r.H - 14, '#8fb8b0'); }); } };\nSC.menu = { view: 'side', camera: { zoom: false, wheel: false },\n  enter() { const game = G.game; game.saves.canSave = false; this.t = 2; game.weather = { kind: 'rain', amount: .5, wind: .2 }; G.music.play('title'); const has = game.saves.latest && game.saves.latest(); this.m = new E.Menu(game, [{ label: 'Continue', disabled: !has }, 'New Game', 'Case Files', 'Grand Rounds', 'Settings', 'About'], { scale: 2, x: 'center', y: 84, bg: '#06161a', border: '#5ff0e0', pick: '#5ff0e0', onPick: (i) => this.pick(i, has), onCancel: () => game.go('title') }); },\n  pick(i, has) { const game = G.game; if (i === 0) { game.saves.load(has.slot === undefined ? 'auto' : has.slot); return; } if (i === 1) game.go('difficulty'); if (i === 2) game.go('casefiles'); if (i === 3) game.go('lobby'); if (i === 4) game.menu('settings'); if (i === 5) game.go('about', { back: 'menu' }); },\n  update(dt) { this.t += dt; const game = G.game; game.focus(game.W / 2, 0, game.H / 2); if (!game.paused && !(game.shell && game.shell.screen)) this.m.update(); },\n  draw(r) { drawHarbor(r, this.t, 12); this.m.draw(r); } };\nconst DIFF_LINES = { intern: \"Hints on, generous clock. Nobody's watching, Doctor.\", resident: 'The job as it is. I have seen worse.', attending: 'No Code Blue. A star, if you are perfect. Do try.' };\nSC.difficulty = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter() { this.i = 1; this.t = 0; G.music.play('ward'); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = 3, w = 128, gap = 8, x0 = (game.W - (w * n + gap * 2)) / 2; const box = i => [x0 + i * (w + gap), 60, w, 120]; const hit = p => { if (!p) return -1; for (let i = 0; i < n; i++) { const b = box(i); if (p[0] >= b[0] && p[0] < b[0] + b[2] && p[1] >= b[1] && p[1] < b[1] + b[3]) return i; } return -1; }; if (I.repeat('left')) { this.i = (this.i + 2) % 3; G.sfx.ui(); } if (I.repeat('right')) { this.i = (this.i + 1) % 3; G.sfx.ui(); } if (I.mouse.t !== this.mt) { this.mt = I.mouse.t; const h = hit(I.pointer()); if (h >= 0 && h !== this.i) { this.i = h; G.sfx.ui(); } } const c = hit(I.clicked()); if (c >= 0) this.i = c; if (I.pressed('confirm') || c >= 0) { I.consumeAll(); G.sfx.chime(); G.newGame(G.DIFF_ORDER[this.i]); G.flowGo(0); } if (I.pressed('cancel')) { I.consumeAll(); game.go('menu'); } this.box = box; },\n  draw(r) { r.overlay(g => { G.drawStage(g, 'scrub', r.W, r.H, this.t); center(g, 'How long have you been a doctor?', r.W / 2, 30, '#fff', { scale: 1 }); if (!this.box) return; G.DIFF_ORDER.forEach((id, i) => { const [x, y, w, h] = this.box(i), on = i === this.i; E.ui.box(g, x, y, w, h, { bg: on ? '#104a48' : '#06161a', border: on ? '#5ff0e0' : '#2c6a64' }); center(g, G.DIFFS[id].name, x + w / 2, y + 12, on ? '#5ff0e0' : '#e8fbf6', { scale: 2 }); font.text(g, DIFF_LINES[id], x + 8, y + 44, '#e8fbf6', { wrap: w - 16, outline: false, shadow: '#000' }); }); const b = G.bust('quill', 'neutral'); }); } };\n// ---- the chart and the lightbox ----\nSC.chart = { pausable: true, view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; game.saves.canSave = false; this.d = d; const c = this.c = G.CASES[d.caseId]; this.t = 0; this.stage = 'chart'; this.bonus = { clock: 0, steady: 0, markers: [] }; this.tries = 0; this.cur = [213, 120]; this.msg = null; this.stT = 0; G.music.play('tension'); G.babble.say(c.opinion, 'quill', { vol: .7 }); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); if (this.stage === 'chart') { if (this.t > .25 && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); G.sfx.ui(); if (this.c.lightbox) { this.stage = 'lightbox'; this.t = 0; } else this.scrub(); } if (I.pressed('cancel') && this.d.mode === 'files') { I.consumeAll(); game.go('casefiles'); } return; }\n    if (this.stage === 'lightbox') { const L = this.c.lightbox, a = I.padAim || I.padMove || [0, 0], k = I.move(); this.cur[0] += (a[0] + k[0]) * 200 * dt; this.cur[1] += (a[1] + k[1]) * 200 * dt; const OX = (game.W - 426) >> 1, OY = (game.H - 240) >> 1, ptr = I.lastDevice === 'mouse' ? I.pointer() : null; if (ptr) this.cur = [ptr[0] - OX, ptr[1] - OY]; const c = I.clicked(); if (this.result) { this.resT -= dt; if (this.resT <= 0 || (this.resT < 1.2 && (I.pressed('confirm') || c))) { I.consumeAll(); this.scrub(); } return; } if (I.pressed('confirm') || c) { I.consumeAll(); const at = c ? [c[0] - OX, c[1] - OY] : this.cur; if (Math.hypot(at[0] - L.at[0], at[1] - L.at[1]) < 14) { this.result = 'right'; this.resT = 2.4; this.bonus.clock += 20; this.bonus.steady += 20; this.bonus.markers.push(L.markAt || L.at); G.sfx.chime(); G.babble.say('Second opinion confirmed!', 'odalys'); } else { this.tries++; this.bonus.clock -= 10; G.sfx.sloppy(); this.msg = 'Dr. Whitlock smirks. Minus ten seconds.'; G.babble.say('Mm. Try again.', 'percy'); if (this.tries >= 3) { this.result = 'wrong'; this.resT = 2.4; this.msg = \"Odalys taps the film. There. That's it.\"; } } } return; }\n    if (this.stage === 'scrub') { this.stT += dt; if (this.stT > 1.8 || (this.stT > .3 && (I.pressed('confirm') || I.clicked()))) { I.consumeAll(); const D = this.d, b = this.bonus; game.go('op', Object.assign({}, D, { clockBonus: b.clock, steady: (b.steady || 0) + (G.prog.morale ? 10 : 0), markers: b.markers })); G.prog.morale = false; } } },\n  scrub() { this.stage = 'scrub'; this.stT = 0; this.result = null; G.sfx.noise({ f: 2400, to: 800, d: 1.4, v: .1, q: .5, a: .2 }); },\n  draw(r) { r.overlay(g => { G.drawStage(g, this.c.lightbox && this.stage === 'lightbox' ? 'radiology' : 'theatre', r.W, r.H, this.t); if (this.stage === 'chart') this.drawChart(g, r); else if (this.stage === 'lightbox') this.drawLightbox(g, r); else this.drawScrub(g, r); }); },\n  drawChart(g, r) { const w = 260, h = 186, x = (r.W - w) / 2 | 0, y = (r.H - h) / 2 | 0, c = this.c; px.rect(g, x - 3, y - 3, w + 6, h + 6, '#5a3a20'); px.rect(g, x, y, w, h, '#ece6d4'); px.rect(g, x + w / 2 - 24, y - 8, 48, 14, '#a8b0b8'); const ink = '#1c2028', red = '#a02020'; font.text(g, 'CASE ' + (c.number || '--'), x + 12, y + 14, red, { outline: false }); font.title(g, c.title, x + 12, y + 26, { scale: 2, colors: [ink, ink], depth: 0, outline: false }); px.rect(g, x + 12, y + 50, w - 24, 1, ink); font.text(g, c.patient, x + 12, y + 56, ink, { outline: false }); font.text(g, c.complaint, x + 12, y + 72, ink, { wrap: w - 24, outline: false }); font.text(g, 'FIRST OPINION', x + 12, y + 106, red, { outline: false }); font.text(g, c.opinion, x + 12, y + 118, ink, { wrap: w - 24, outline: false }); const I = G.game.input, pw = G.promptWidth(I, 'confirm', c.lightbox ? 'See the film' : 'Scrub in'); G.drawCap(g, I.label('confirm'), x + w - pw - 10, y + h - 18, { pad: I.lastDevice === 'gamepad' }); font.text(g, c.lightbox ? 'See the film' : 'Scrub in', x + w - pw - 10 + G.capWidth(I.label('confirm')) + 3, y + h - 16, ink, { outline: false }); },\n  drawLightbox(g, r) { const OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1, L = this.c.lightbox, x0 = 96 + OX, y0 = 40 + OY, w = 234, h = 170; px.rect(g, x0 - 6, y0 - 6, w + 12, h + 12, '#88b8d8'); px.rect(g, x0 - 3, y0 - 3, w + 6, h + 6, '#2a3a44'); G.drawFilm(g, L.film, x0, y0, w, h, this.t, L, OX, OY); const b = G.bust('odalys', 'smile'); px.reset(g); g.drawImage(b, 28, 16, 56, 76, 16 + OX, 90 + OY, 56, 76); px.reset(g); px.rect(g, 340 + OX, 56 + OY, 74, 44, '#f4e878'); font.text(g, this.c.opinion, 343 + OX, 59 + OY, '#2a2010', { wrap: 68, font: 'tiny', outline: false }); const cx = this.cur[0] + OX | 0, cy = this.cur[1] + OY | 0; G.ringDraw(g, cx, cy, 8, '#ffe08a', 16); px.rect(g, cx, cy - 12, 1, 6, '#ffe08a'); px.rect(g, cx, cy + 7, 1, 6, '#ffe08a'); px.rect(g, cx - 12, cy, 6, 1, '#ffe08a'); px.rect(g, cx + 7, cy, 6, 1, '#ffe08a'); const txt = this.result === 'right' ? 'Second opinion confirmed. ' + L.text : this.result === 'wrong' ? this.msg + ' ' + L.text : this.msg || 'Point at what is really wrong.'; G.panel(g, 40 + OX, 214 + OY, 346, 22, .9); center(g, txt.slice(0, 66), r.W / 2, 220 + OY, this.result === 'right' ? '#5ff0e0' : '#fff'); if (this.result) G.ringDraw(g, L.at[0] + OX, L.at[1] + OY, 14 + Math.sin(this.t * 8) * 2, '#5ff0e0', 22); },\n  drawScrub(g, r) { const k = Math.min(1, this.stT * 3), id = this.c.doc === 'soko' || this.c.doc === 'both' ? 'sokolova' : 'vale', c = G.bust(id, 'neutral', { maskUp: this.stT > .7 }); px.blend(g, .6, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#04100e')); px.reset(g); g.drawImage(c, (r.W - 112) / 2 | 0, (r.H - 128 - 22 + (1 - k) * 60) | 0); px.reset(g); center(g, 'SCRUB IN', r.W / 2, 34, '#5ff0e0', { scale: 2 }); for (let i = 0; i < 18; i++) { const x = r.W / 2 - 60 + i * 7, y = (this.stT * 180 + i * 37) % 170 + 40; px.rect(g, x, y, 1, 4, '#a8e0f0'); } } };\nG.drawFilm = (g, kind, x0, y0, w, h, t, L, OX, OY) => { px.rect(g, x0, y0, w, h, '#0c161c'); const bone = '#b8ccd4', cx = x0 + w / 2, cy = y0 + h / 2; px.polyDither(g, [[x0 + 16, y0 + 16], [x0 + w - 16, y0 + 16], [x0 + w - 16, y0 + h - 16], [x0 + 16, y0 + h - 16]], '#30424c', .4, 0, 0); if (kind === 'ribs') { px.rect(g, cx - 4, y0 + 8, 8, h - 16, bone); for (let i = 0; i < 7; i++) { const y = y0 + 16 + i * 20; for (const s of [-1, 1]) { px.line(g, cx + s * 4, y, cx + s * 54, y + 6, bone, 3); px.line(g, cx + s * 54, y + 6, cx + s * 86, y + 26, bone, 2); } } } else if (kind === 'spine') { for (let i = 0; i < 8; i++) { const y = y0 + 8 + i * 20; px.rect(g, cx - 12, y, 24, 15, bone); px.rect(g, cx - 18, y + 5, 36, 4, '#90a4ac'); } px.poly(g, [[cx - 70, y0 + h], [cx - 34, y0 + h - 44], [cx + 34, y0 + h - 44], [cx + 70, y0 + h]], '#90a4ac'); } else { px.ell(g, cx, cy - 8, 76, 66, bone); px.ell(g, cx, cy - 8, 68, 58, '#0c161c'); px.rect(g, cx - 26, cy + 56, 52, 18, bone); px.ell(g, cx - 26, cy + 6, 14, 10, bone); px.ell(g, cx + 26, cy + 6, 14, 10, bone); px.ell(g, cx - 26, cy + 6, 10, 7, '#0c161c'); px.ell(g, cx + 26, cy + 6, 10, 7, '#0c161c'); } for (let i = 0; i < 300; i++) px.dot(g, x0 + ((i * 7919) % w), y0 + ((i * 104729) % h), i % 4 ? '#1c2a32' : '#3a4a54'); for (const d of (L.decoys || [])) px.disc(g, d[0] + OX, d[1] + OY, 5, '#5a6a74'); const X = L.at[0] + OX, Y = L.at[1] + OY, wob = L.moving ? Math.sin(t * 3) * 3 : 0; px.disc(g, X + wob, Y, 8, '#d0dde4'); px.disc(g, X + wob, Y, 5, '#f4fcff'); if (kind === 'skull') { px.ell(g, X, Y, 9, 4, '#0c161c'); px.disc(g, X, Y, 2, '#f4fcff'); } px.rect(g, x0, y0 + ((t * 40) % h), w, 1, '#2a4048'); };\n// ---- the operation's scene ----\nSC.op = { pausable: true, view: 'overhead', camera: { zoom: false, wheel: false }, expand: true,\n  enter(d) { const game = G.game; game.saves.canSave = false; this.d = d; game.focus(game.W / 2, game.H / 2, 0); const diff = d.difficulty || G.prog.diff; this.diff = diff; const c = G.CASES[d.caseId]; const seats = d.seats || [{ pid: 0, input: game.input }]; const players = d.players || seats.map((s, i) => ({ id: s.pid, color: G.SEATS[s.pid] })); const assist = game.settings.assist === undefined ? 0 : (game.settings.assist - .6); this.S = d.S || G.Op.create(c, { seed: (d.seed || (Date.now() % 100000)) | 0, difficulty: diff, players, steady: d.steady, clockBonus: d.clockBonus, markers: d.markers, phase: d.phase, assistPlus: assist }); this.view = new G.OpView(game, this.S, { seats, music: c.music || 'op' }); G.music.play(c.music || 'op'); this.done = false; this.dev = G.tuningChanged() || G.cheating(); for (const s of seats) { s.cur.speedK = game.settings.cursorSpeed || 1; } G.op = this; game.input.consumeAll(); },\n  exit() { const c = G.game.screen.canvas; if (c) c.style.cursor = ''; G.sfx.stopLoops(); G.sfx.setSlow(false); G.sfx.setMode('normal'); G.choir.silence(); },\n  update(dt) { const game = G.game, c = game.screen.canvas; if (c) c.style.cursor = game.paused ? '' : 'none'; game.focus(game.W / 2, game.H / 2, 0); if (this.done) return; this.dev = this.dev || G.tuningChanged() || G.cheating(); this.view.update(dt); const S = this.S; if (S.done && !this.done) { this.done = true; game.after(S.done === 'won' ? .3 : 1.4, () => { if (S.done === 'won') game.go('results', { S, d: this.d, dev: this.dev, diff: this.diff }); else game.go('lost', { S, d: this.d, view: this.view, diff: this.diff }); }, { keep: false }); } },\n  draw(r) { this.view.draw(r); } };\n// ---- results ----\nSC.results = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; this.d = d; const S = d.S, c = G.CASES[S.caseId]; this.t = 0; this.shown = 0; G.music.play(null); G.music.sting('closed'); const R = this.res = G.rankOf(S, (G.PAR && G.PAR[S.caseId]) || 1); this.line = E.pick ? G.RANK_LINES[R.rank][S.ht * 7 % G.RANK_LINES[R.rank].length | 0] : ''; const tot = S.acts.sloppy + S.acts.clean + S.acts.textbook; this.tiles = [['Time left', G.fmtClock(S.clock)], ['Pulse held', '' + Math.round(S.v)], ['Technique', (tot ? Math.round((S.acts.clean + S.acts.textbook) / tot * 100) : 100) + '%'], ['Best Flow', 'x' + S.bestFlow]]; if (!d.dev && !S.attract && d.d.mode !== 'gr' && !S.lab) { const r = G.prog.ranks[S.caseId] = G.prog.ranks[S.caseId] || {}, order = 'DCBAS', cur = r[d.diff]; if (!cur || order.indexOf(R.rank) > order.indexOf(cur)) r[d.diff] = R.rank; if (R.star) r.star = true; const i = G.CASE_ORDER.indexOf(S.caseId), nx = G.CASE_ORDER[i + 1]; if (nx && !G.prog.unlocked.includes(nx)) G.prog.unlocked.push(nx); G.saveProg(); } game.input.consumeAll(); },\n  update(dt) { const game = G.game, I = game.input; const was = this.t; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = Math.min(4, this.t / .45 | 0); if (n > this.shown) { this.shown = n; G.sfx.tick(); } if (was < 2.1 && this.t >= 2.1) { G.sfx.stamp(); game.shake(3); G.babble.say(this.line, 'quill'); } if (this.t > 2.4 && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); this.next(); } else if (I.pressed('confirm') || I.clicked()) { I.consumeAll(); this.t = 2.4; this.shown = 4; } },\n  next() { const m = this.d.d; if (m.then) { m.then(); return; } G.game.go(m.mode === 'gr' ? 'lobby' : 'casefiles'); },\n  draw(r) { const S = this.d.S, c = G.CASES[S.caseId], t = this.t; r.overlay(g => { G.drawStage(g, 'scrub', r.W, r.H, t); px.blend(g, .45, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); center(g, 'CASE CLOSED', r.W / 2, 14, '#ff5a4a', { scale: 2 }); center(g, c.title, r.W / 2, 36, '#e8fbf6'); const id = S.doc === 'soko' ? 'sokolova' : 'vale'; px.reset(g); g.drawImage(G.bust(id, this.res.rank === 'D' || this.res.rank === 'C' ? 'neutral' : 'smile', {}), 6, r.H - 128 | 0); px.reset(g); const x0 = r.W / 2 - 88 | 0; this.tiles.forEach(([a, b], i) => { if (i >= this.shown) return; const y = 52 + i * 30; G.panel(g, x0, y, 176, 26); font.text(g, a, x0 + 8, y + 9, '#8fb8b0', { outline: false }); font.text(g, b, x0 + 168, y + 5, '#ffffff', { align: 'right', outline: false, scale: 2 }); }); if (t > 2.1) { const k = Math.min(1, (t - 2.1) * 6), sc = k < 1 ? 7 : 5; const x = r.W - 62, y = 60; G.ringDraw(g, x, y + 16, 34, '#ff5a4a', 36); G.ringDraw(g, x, y + 16, 32, '#ff5a4a', 36); font.text(g, this.res.rank, x, y, '#ff5a4a', { align: 'center', scale: sc, outline: false }); if (this.res.star) center(g, '★ Textbook', x, y + 52, '#ffe08a'); if (this.d.dev) center(g, 'DEV', x, y - 24, '#ff9a7a', { scale: 2 }); if (S.capB) center(g, 'Retried: capped at B', x, y + 62, '#ff9a7a', { font: 'tiny' }); center(g, this.line, r.W / 2 + 40, 182, '#e8fbf6'); } if (t > 2.4) { const I = G.game.input, w = G.promptWidth(I, 'confirm', 'Continue'); G.drawPrompt(g, I, 'confirm', 'Continue', r.W - w - 10, r.H - 18); } }); } };\n// ---- lost ----\nSC.lost = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; this.d = d; const S = d.S; this.t = 0; const L = G.LOST_LINES[S.lostWhy] || G.LOST_LINES.vitals; this.line = L[0]; G.babble.say(this.line, 'quill'); const f = G.Op.fails(S) + 1, items = ['Retry from this phase', 'Restart case']; if (f >= 2 && d.diff !== 'intern') items.push('Lower difficulty for this case'); items.push('Quit'); this.items = items; this.m = new E.Menu(game, items, { scale: 1, x: 'center', y: 150, bg: '#06161a', border: '#ff7a6a', pick: '#ff9a7a', onPick: (i, it) => this.pick(it) }); game.input.consumeAll(); },\n  pick(it) { const game = G.game, D = this.d, S = D.S; if (it === 'Retry from this phase') { G.Op.retry(S); game.go('op', Object.assign({}, D.d, { S, seats: D.view.seats })); } else if (it === 'Restart case') game.go('op', Object.assign({}, D.d, { S: null, phase: 0 })); else if (it.startsWith('Lower')) game.go('op', Object.assign({}, D.d, { S: null, phase: 0, difficulty: 'intern' })); else game.go(D.d.mode === 'story' ? 'menu' : D.d.mode === 'gr' ? 'lobby' : 'casefiles'); },\n  update(dt) { this.t += dt; const game = G.game; game.focus(game.W / 2, game.H / 2, 0); if (this.t > .5) this.m.update(); },\n  draw(r) { r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#04060a'); let last = 0; const y0 = 70; for (let x = 0; x < r.W; x++) { px.dot(g, x, y0, '#ff5a4a'); } center(g, this.d.S.lostWhy === 'bomb' ? 'THE SHIP WENT' : 'PATIENT LOST', r.W / 2, 28, '#ff7a6a', { scale: 2 }); px.reset(g); g.drawImage(G.bust('quill', 'sad', { maskUp: true }), 28, 16, 56, 60, r.W / 2 - 28 | 0, 78, 56, 60); px.reset(g); center(g, this.line, r.W / 2, 140, '#e8fbf6'); }); this.m.draw(r); } };\n// ---- case files ----\nSC.casefiles = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter() { this.t = 0; this.i = this.i || 0; G.music.play('ward'); this.build(); G.game.input.consumeAll(); },\n  build() { const un = G.prog.unlocked; this.L = [...G.CASE_ORDER.filter(id => un.includes(id)).map(id => ({ id })), { id: 'lab' }]; if (G.prog.ended) this.L.push({ blank: true }); this.i = Math.min(this.i, this.L.length - 1); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = this.L.length; if (I.repeat('left') || I.pressed('toolPrev')) { this.i = (this.i + n - 1) % n; G.sfx.ui(); } if (I.repeat('right') || I.pressed('toolNext')) { this.i = (this.i + 1) % n; G.sfx.ui(); } const c = I.clicked(); let side = 0; if (c) { if (c[0] < game.W * .22) side = -1; else if (c[0] > game.W * .78) side = 1; } if (side) { this.i = (this.i + n + side) % n; G.sfx.ui(); } else if (I.pressed('confirm') || c) { I.consumeAll(); const it = this.L[this.i]; if (it.blank) { G.sfx.ui(); return; } if (it.id === 'lab') game.go('op', { caseId: 'lab', mode: 'lab', difficulty: 'resident' }); else game.go('chart', { caseId: it.id, mode: 'files' }); } if (I.pressed('cancel')) { I.consumeAll(); game.go('menu'); } },\n  draw(r) { const it = this.L[this.i]; r.overlay(g => { G.drawStage(g, 'office', r.W, r.H, this.t); const w = 300, h = 170, x = (r.W - w) / 2 | 0, y = 26; px.poly(g, [[x, y + 8], [x + 70, y + 8], [x + 80, y], [x + 150, y], [x + 160, y + 8], [x + w, y + 8], [x + w, y + h], [x, y + h]], '#c8a860'); px.rect(g, x + 6, y + 14, w - 12, h - 20, '#ece6d4'); const ink = '#1c2028'; if (it.blank) { center(g, 'Incoming', x + w / 2, y + 40, ink, { scale: 2 }); center(g, 'Next shift starts at seven.', x + w / 2, y + 80, ink); center(g, 'Get some sleep, Doctor.', x + w / 2, y + 94, ink); } else { const c = G.CASES[it.id]; font.title(g, c.title, x + w / 2, y + 22, { scale: 2, align: 'center', colors: [ink, ink], depth: 0, outline: false }); center(g, c.patient, x + w / 2, y + 48, ink, { outline: false, shadow: undefined }); center(g, c.teach, x + w / 2, y + 62, '#5a5040'); if (it.id !== 'lab') { G.DIFF_ORDER.forEach((d, k) => { const X = x + w / 2 - 70 + k * 70, rk = (G.prog.ranks[it.id] || {})[d]; G.ringDraw(g, X, y + 112, 22, rk ? '#a02020' : '#b0a890', 28); font.text(g, rk || '-', X, y + 104, rk ? '#a02020' : '#b0a890', { align: 'center', scale: 2, outline: false }); center(g, G.DIFFS[d].name, X, y + 138, '#5a5040', { shadow: undefined }); }); if ((G.prog.ranks[it.id] || {}).star) center(g, '★ Textbook', x + w / 2, y + 150, '#a07010', { shadow: undefined }); } else center(g, c.complaint, x + w / 2, y + 90, ink); } const I = G.game.input; font.text(g, '◀', 12, r.H / 2 - 8, '#5ff0e0', { scale: 3, outline: false }); font.text(g, '▶', r.W - 28, r.H / 2 - 8, '#5ff0e0', { scale: 3, outline: false }); let X = 12; if (!it.blank) X += G.drawPrompt(g, I, 'confirm', it.id === 'lab' ? 'Practice' : 'Replay', X, r.H - 18) + 12; G.drawPrompt(g, I, 'cancel', 'Back', X, r.H - 18); center(g, (this.i + 1) + ' / ' + this.L.length, r.W / 2, r.H - 16, '#8fb8b0'); }); } };\n// ---- about and credits ----\nSC.about = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { this.back = (d && d.back) || 'menu'; this.i = 0; this.t = 0; this.pages = G.aboutPages(); G.game.input.consumeAll(); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = this.pages.length; if (I.repeat('left') || I.pressed('toolPrev')) { this.i = (this.i + n - 1) % n; G.sfx.ui(); } if (I.repeat('right') || I.pressed('toolNext') || I.pressed('confirm')) { this.i = (this.i + 1) % n; G.sfx.ui(); } const c = I.clicked(); if (c) { this.i = (this.i + n + (c[0] < game.W / 3 ? -1 : 1)) % n; G.sfx.ui(); } if (I.pressed('cancel')) { I.consumeAll(); game.go(this.back); } },\n  draw(r) { const p = this.pages[this.i]; r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#06161a'); font.text(g, p.title, 12, 8, '#5ff0e0', { outline: false, scale: 2 }); let y = 30; for (const l of p.lines) { if (l.h) { font.text(g, l.h, 12, y, '#ffe08a', { outline: false }); y += 10; } else if (l.t !== undefined) { font.text(g, l.t, 12, y, '#e8fbf6', { outline: false }); y += 10; } } const I = G.game.input; center(g, (this.i + 1) + ' / ' + this.pages.length, r.W / 2, r.H - 14, '#8fb8b0'); G.drawPrompt(g, I, 'cancel', 'Back', 10, r.H - 16); const w = G.promptWidth(I, 'confirm', 'Next'); G.drawPrompt(g, I, 'confirm', 'Next', r.W - w - 10, r.H - 16); }); } };\nG.aboutPages = () => { const A = G.ABOUT || { sourceInformation: {}, testingFeedback: [], engineFeedback: [], promptFeedback: [], credits: [] }, pages = [], MAX = 19, W = Math.max(400, (G.game ? G.game.W : 426) - 24); const add = (title, entries) => { let lines = []; const flush = () => { if (lines.length) { pages.push({ title, lines }); lines = []; } }; for (const [h, t] of entries) { const w = font.wrap(String(t), W); if (lines.length + w.length + (h ? 1 : 0) > MAX) flush(); if (h) lines.push({ h }); for (const l of w) { if (lines.length >= MAX) flush(); lines.push({ t: l }); } } flush(); };\n  const S = A.sourceInformation, N = { date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art Direction', animation: 'Animation', audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage' }; add('Source Information', Object.keys(N).map(k => [N[k], S[k] === undefined ? 'unknown' : S[k]]));\n  const Q = (t, qs, as) => add(t, qs.map((q, i) => [q, as[i] === undefined ? 'unknown' : as[i]])); Q('Testing Feedback', ['How many issues did testing catch?', 'How many were critical or game breaking?', 'The most helpful test', 'The least helpful test'], A.testingFeedback); Q('Engine Feedback', ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'The most important thing you built yourself', 'The hardest part of using the engine', 'What did you change in the engine, and why?', 'One thing you would change'], A.engineFeedback); Q('Prompt Feedback', ['What did you like most about this prompt?', 'What was confusing?', 'The hardest thing to do', 'What would you change?'], A.promptFeedback); add('Credits', (A.credits || []).map(c => ['', c])); return pages; };\nSC.credits = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { this.t = 0; this.stage = 'roll'; G.prog.ended = true; G.saveProg(); G.music.play('ward'); this.lines = ['SECOND SCALPEL', '', 'DR. IMOGEN VALE', 'second-year resident, frequent apologizer', '', 'BARTHOLOMEW QUILL', 'scrub nurse, Theatre Three, thirty-one years', '', 'DR. YEVGENIA SOKOLOVA', 'hospital ship Samaritan\\'s Wake', '', 'DR. MARGUERITE OYELARAN', 'Chief of Surgery, opinions in pen', '', 'DR. PERCIVAL WHITLOCK', 'it was never a hernia', '', 'ODALYS FERREIRA', 'night radiology, always right, always eating', '', 'DR. LUCIAN HALE and CLEMENTINE', '', 'and the patients of St. Erasmus Harbor Hospital', 'who would like a word about their headaches', '', 'Pain is information. Don\\'t let it go quiet.', '', 'Not a medical training tool. Please do not.']; G.game.input.consumeAll(); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const speed = I.down('skip') || I.down('confirm') ? 60 : 16; this.y = (this.y || 0) + dt * speed; if (this.stage === 'roll' && this.y > this.lines.length * 14 + game.H) { this.stage = 'last'; this.t = 0; G.babble.say('Next shift starts at seven.', 'quill'); } if (this.stage === 'last' && (this.t > 5 || (this.t > 1 && (I.pressed('confirm') || I.clicked())))) { this.y = 0; I.consumeAll(); G.prog.flow = 0; G.saveProg(); game.go('about', { back: 'title' }); } },\n  draw(r) { r.overlay(g => { G.drawStage(g, 'harbor', r.W, r.H, this.t); px.blend(g, .55, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); if (this.stage === 'roll') this.lines.forEach((l, i) => { const y = r.H + i * 14 - this.y; if (y > -10 && y < r.H) center(g, l, r.W / 2, y, /^[A-Z ,.']+$/.test(l) && l ? '#5ff0e0' : '#e8fbf6', { scale: i === 0 ? 2 : 1 }); }); else { center(g, 'In Case Files, a new folder.', r.W / 2, r.H / 2 - 24, '#8fb8b0'); center(g, 'Incoming', r.W / 2, r.H / 2 - 8, '#fff', { scale: 2 }); center(g, 'Next shift starts at seven. Get some sleep, Doctor.', r.W / 2, r.H / 2 + 20, '#e8fbf6'); } }); } };\n})();\nEOF","description":"Write rigs, cinematics, story and flow scenes"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17644,"cache_read_input_tokens":384607,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17644},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"7be890fa-4373-44e9-8a3c-d50895c0f404","timestamp":"2026-11-05T13:51:48.672Z","request_id":"req_011CgjtKBePuKpDW11UE77Pn","wire_tool_inputs":{"toolu_014PjbnPao7xcxJ9z5GLd2cx":{"command":"cat > src/art/rigs.js <<'EOF'\n// Bodies for the ward and cinematics: the engine's Humanoids, dressed for a hospital, with new poses, a surgical cap, a mask and held instruments.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px } = E, H = E.Humanoid;\nH.hat('surgcap', (g, x, y, r, o) => { const c = (o && o.color) || '#2bb0a2'; px.ell(g, x, y - (r || 6) * .35, (r || 6) * 1.05, (r || 6) * .72, c); px.rect(g, x - (r || 6) | 0, y - 1 | 0, (r || 6) * 2 | 0, 2, E.tones(c).sh); });\nH.pose('scrub', (J, w) => { for (const k of ['handL', 'handR']) { const s = k === 'handL' ? -1 : 1; J[k][0] += (6 - J[k][0]) * w; J[k][1] += (s * 2.5 - J[k][1]) * w; J[k][2] += (J.shC[2] + 2 - J[k][2]) * w; } for (const k of ['elbowL', 'elbowR']) { const s = k === 'elbowL' ? -1 : 1; J[k][0] += (3 - J[k][0]) * w; J[k][1] += (s * 5 - J[k][1]) * w; J[k][2] += (J.shC[2] - 5 - J[k][2]) * w; } });\nH.pose('push', (J, w) => { for (const k of ['handL', 'handR']) { const s = k === 'handL' ? -1 : 1; J[k][0] += (9 - J[k][0]) * w; J[k][1] += (s * 3 - J[k][1]) * w; J[k][2] += (J.shC[2] - 4 - J[k][2]) * w; } });\nH.pose('lean', (J, w) => { const lean = 3; J.head[0] += lean * w; J.shC[0] += lean * .8 * w; for (const k of ['handL', 'handR']) { const s = k === 'handL' ? -1 : 1; J[k][0] += (8 - J[k][0]) * w; J[k][1] += (s * 2 - J[k][1]) * w; J[k][2] += (J.hipC[2] + 1 - J[k][2]) * w; } });\nH.pose('pass', (J, w) => { J.handR[0] += (10 - J.handR[0]) * w; J.handR[2] += (J.shC[2] - 2 - J.handR[2]) * w; J.handR[1] += (2 - J.handR[1]) * w; });\nH.pose('knit', (J, w, rig) => { const t = (rig && rig.t) || 0, k = Math.sin((rig ? rig._knit = (rig._knit || 0) + .1 : 0)) * 1; for (const n of ['handL', 'handR']) { const s = n === 'handL' ? -1 : 1; J[n][0] += (6 + s * k - J[n][0]) * w; J[n][1] += (s * 1.6 - J[n][1]) * w; J[n][2] += (J.hipC[2] + 3 - J[n][2]) * w; } });\nconst mask = c => ({ over(g, Q) { if (!Q || !Q.head) return; const h = Q.head; px.rect(g, h[0] - 3 | 0, h[1] | 0, 7, 3, c); } });\nH.weapon('tray', { length: 6, rest: [.5, .3, -.5], blade: false, draw(w) { } });\nconst R = (o) => new E.Humanoid(Object.assign({ size: 1.3, weapon: null, outfit: 'shirt', sleeves: 'short' }, o));\nconst defs = {\n  vale: () => R({ hat: { style: 'surgcap', color: '#2bb0a2' }, hair: 'short', colors: { skin: '#f6d0b2', hair: '#c9562a', cloth: '#2f9c8e', pants: '#2f9c8e', boot: '#d8e0e0', belt: '#2f9c8e', trim: '#2bb0a2' } }),\n  sokolova: () => R({ build: 'heroic', hair: 'long', hat: { style: 'band', color: '#c8352a' }, colors: { skin: '#e8c6aa', hair: '#dedad2', cloth: '#6b7a48', pants: '#566038', boot: '#3a3020', belt: '#3a3020' } }),\n  quill: () => R({ build: 'bulky', hair: 'short', hat: { style: 'surgcap', color: '#35558f' }, colors: { skin: '#dcae8e', hair: '#8d8a88', cloth: '#3d62a6', pants: '#3d62a6', boot: '#28303a', belt: '#3d62a6' } }),\n  oyelaran: () => R({ build: 'heroic', outfit: 'coat', sleeves: 'long', hair: 'short', colors: { skin: '#7c4a2e', hair: '#c9c5bb', cloth: '#2e2c36', coat: '#ece7da', pants: '#2e2c36', boot: '#1a1820', trim: '#ece7da' } }),\n  percy: () => R({ build: 'heroic', outfit: 'coat', sleeves: 'long', hair: 'short', colors: { skin: '#efcfae', hair: '#d8b45a', cloth: '#7a90b0', coat: '#f4f4f0', pants: '#3a4050', boot: '#20242c', trim: '#f4f4f0' } }),\n  odalys: () => R({ hair: 'spiky', outfit: 'tunic', sleeves: 'long', colors: { skin: '#b98a62', hair: '#3a2420', cloth: '#c06a5a', pants: '#3a3a50', boot: '#4a3020', trim: '#e8d0a0' } }),\n  hale: () => R({ build: 'heroic', outfit: 'coat', sleeves: 'long', hair: 'short', colors: { skin: '#e6c4a4', hair: '#c4c6cc', cloth: '#e8e8f0', coat: '#343c54', pants: '#2a3044', boot: '#14161e', trim: '#343c54' } }),\n  patient: (c = '#a8c8d8', hair = '#5a4030', skin = '#e8c0a0') => R({ hair: 'short', outfit: 'robe', colors: { skin, hair, cloth: c, pants: c, boot: '#d8e0e0' } }),\n};\nconst cache = {};\nG.rig = (id, ...a) => { if (a.length) return defs.patient(...a); return (cache[id] = cache[id] || (defs[id] || defs.patient)()); };\nG.newRig = (id, ...a) => (defs[id] || defs.patient)(...a);\n})();\nEOF\ncat > src/scenes/cine.js <<'EOF'\n// Short cinematics, 4 to 8 s and skippable, played by the story scene: in-engine rigs in the threequarter view, and one ship in side view.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst WALL = { 1: { h: 28, top: '#2a3a3a', side: '#4a6660', face: 'plaster' }, 2: { h: 28, top: '#2a3a3a', side: '#6a7a70', face: 'plaster' } };\nconst corridor = (w, h) => { const rows = ['#'.repeat(w)]; for (let i = 0; i < h - 2; i++) rows.push('#' + '.'.repeat(w - 2) + '#'); rows.push('#'.repeat(w)); return new E.TileMap({ rows, legend: { '#': 1 }, types: WALL, floorMat: 'flagstone', outside: '#0a1214' }); };\nconst lane = (id, from, to, dur, st = {}) => ({ rig: G.newRig(id), from, to, dur, st });\nconst simple = (o) => ({ view: 'threequarter', ...o });\nG.CINE = {\n  scrubin: simple({ dur: 3.4, cap: 'Scrubbing in', map: () => corridor(10, 6), props: [['crashCart', 56, 40], ['surgicalLamp', 110, 40]], focus: [80, 48], actors: () => [lane('vale', [70, 56], [70, 56], 1, { pose: 'scrub', facing: -1.57 }), lane('quill', [110, 60], [92, 60], 2, { pose: 'pass', facing: 3.14 })] }),\n  gurney: simple({ dur: 5, cap: 'Crane Nine. Everyone runs.', map: () => corridor(30, 6), props: [['ivStand', 140, 28], ['crashCart', 240, 28], ['vitalsMonitor', 340, 28]], gurney: true, focusF: t => [60 + t * 72, 48], actors: () => [lane('vale', [20, 50], [380, 50], 5, { pose: 'push', facing: 0, run: 1 }), lane('quill', [8, 60], [368, 60], 5, { pose: 'push', facing: 0, run: 1 }), lane('patient', [50, 50], [410, 50], 5, { down: 1, facing: 0 })] }),\n  galacollapse: simple({ dur: 4.5, cap: 'The cane rolls across the floor.', map: () => corridor(14, 8), props: [['table', 40, 40], ['table', 180, 40]], focus: [110, 60], actors: () => [lane('oyelaran', [90, 60], [106, 60], 2, { facing: 0, dieAt: 1.8 }), lane('hale', [160, 44], [160, 44], 1, { pose: 'wave', facing: 3.14 }), lane('vale', [30, 76], [86, 66], 3, { facing: 0, run: 1 })] }),\n  traydrop: simple({ dur: 3.2, cap: 'A crash, in Theatre Three.', map: () => corridor(10, 6), props: [['crashCart', 110, 36]], focus: [80, 48], actors: () => [lane('quill', [80, 52], [80, 52], 1, { facing: 1.57, kneel: true }), lane('vale', [40, 54], [58, 54], 2, { facing: 0 })], tray: true }),\n  percycollapse: simple({ dur: 3.6, cap: 'He is still smiling.', map: () => corridor(12, 6), props: [['vendingMachine', 50, 28]], focus: [90, 48], actors: () => [lane('percy', [86, 52], [86, 52], 1, { facing: 3.14, dieAt: 1.2 }), lane('vale', [130, 54], [100, 54], 1.4, { facing: 3.14, run: 1 })] }),\n  finaltable: simple({ dur: 6, cap: 'Everyone is there.', map: () => corridor(14, 9), props: [['operatingTable', 112, 72], ['surgicalLamp', 80, 44], ['surgicalLamp', 146, 44], ['vitalsMonitor', 170, 60], ['crashCart', 56, 90]], focusF: t => [112, 72 - t * 2], actors: () => [lane('vale', [92, 76], [92, 76], 1, { pose: 'lean', facing: 0 }), lane('sokolova', [132, 76], [132, 76], 1, { pose: 'lean', facing: 3.14 }), lane('quill', [112, 104], [112, 100], 1.5, { pose: 'pass', facing: -1.57 }), lane('percy', [176, 76], [176, 76], 1, { facing: 3.14 }), lane('odalys', [50, 60], [50, 60], 1, { facing: 0, pose: 'hips' }), lane('oyelaran', [112, 28], [112, 28], 1, { facing: 1.57 })] }),\n  erchaos: simple({ dur: 6, cap: 'The city wakes in pain.', map: () => corridor(24, 8), props: [['hospitalBed', 60, 40], ['hospitalBed', 140, 40], ['hospitalBed', 220, 40], ['gurney', 300, 44]], focusF: t => [100 + t * 20, 60], actors: () => { const c = ['#a8c8d8', '#d8a890', '#a890c8', '#c8c890']; const A = [lane('vale', [80, 90], [300, 90], 6, { facing: 0, run: 1 })]; for (let i = 0; i < 8; i++) { const a = lane('patient', [40 + i * 40, 70 + (i % 3) * 12], [60 + i * 36, 80 + ((i + 1) % 3) * 10], 2 + i % 3, { facing: i * 1.3, pose: i % 2 ? 'wave' : 'cheer' }); a.rig = G.newRig('patient', c[i % 4]); A.push(a); } return A; } }),\n  stormship: { view: 'side', dur: 6, cap: 'The launch, in a Force Nine.', custom: true, enter() { }, draw(r, t) { r.overlay(g => { const W = r.W, H = r.H; for (let y = 0; y < H; y += 4) px.rect(g, 0, y, W, 4, E.mix('#060c14', '#1c2c38', y / H)); if ((t * 5 | 0) % 17 === 0) px.rect(g, 0, 0, W, H, '#8aa0b0'); const roll = Math.sin(t * 1.3) * .18, cx = W * .55, cy = H * .55 + Math.sin(t * 1.1) * 8, c = Math.cos(roll), s = Math.sin(roll), P = (x, y) => [cx + x * c - y * s, cy + x * s + y * c]; for (let i = 0; i < 3; i++) { const yy = H * (.5 + i * .12); for (let x = 0; x < W; x += 4) { const wy = yy + Math.sin(x * .03 + t * (1.4 + i * .3) + i) * (9 - i * 2); if (i === 0) px.rect(g, x, wy, 4, 2, '#3a5a6a'); } } px.poly(g, [P(-110, 0), P(120, 0), P(90, 26), P(-90, 26)], '#22303a'); px.poly(g, [P(-110, 0), P(120, 0), P(118, 5), P(-108, 5)], '#b8c4c8'); px.poly(g, [P(-50, 0), P(30, 0), P(26, -28), P(-46, -28)], '#d8e0e0'); px.poly(g, [P(-14, -8), P(-4, -8), P(-4, -18), P(-14, -18)], '#c8352a'); px.poly(g, [P(-18, -11), P(0, -11), P(0, -15), P(-18, -15)], '#c8352a'); const l = P(-30, -36); px.line(g, l[0], l[1], P(-30, -28)[0], P(-30, -28)[1], '#889', 1); px.blend(g, .4, 'add', () => px.disc(g, l[0], l[1], 7, '#ffe8a0')); const lx = W * .18 + Math.sin(t * 1.4) * 6, ly = H * .62 + Math.sin(t * 2.1) * 12; px.poly(g, [[lx - 24, ly], [lx + 24, ly - 4], [lx + 16, ly + 10], [lx - 18, ly + 12]], '#3a4048'); px.rect(g, lx - 4, ly - 12, 6, 10, '#2f9c8e'); px.rect(g, lx + 6, ly - 12, 7, 10, '#3d62a6'); for (let i = 0; i < 2; i++) { const yy = H * (.66 + i * .14); for (let x = 0; x < W; x += 3) { const wy = yy + Math.sin(x * .025 + t * (1.2 + i * .4)) * (12 - i * 3); px.rect(g, x, wy, 3, H - wy, i ? '#0c1c28' : '#14303c'); } } for (let i = 0; i < 140; i++) { const a = (i * 73.13) % 1, b = (i * 37.77) % 1; px.line(g, (a * W + t * 160 + i) % W | 0, (b * H + t * (260 + i % 60)) % H | 0, ((a * W + t * 160 + i) % W | 0) - 3, ((b * H + t * (260 + i % 60)) % H | 0) - 6, '#7a9ab0', 1); } }); } },\n};\nclass CinePlayer {\n  constructor(game, id) { this.game = game; this.def = G.CINE[id]; this.id = id; this.t = 0; const D = this.def; game.setView(D.view); if (D.custom) { game.setView('side'); return; } this.map = D.map(); game.cam.bounds = null; this.actors = D.actors(); game.lights.enabled = true; game.lights.ambient = .62; G.sfxFor && G.sfxFor(id); }\n  get done() { return this.t >= this.def.dur; }\n  update(dt) { this.t += dt; const D = this.def, t = this.t, game = this.game; if (D.custom) { game.focus(game.W / 2, 0, game.H / 2); return; } const f = D.focusF ? D.focusF(t) : D.focus; game.focus(f[0], f[1], 10); for (const a of this.actors) { const k = Math.min(1, t / a.dur), x = a.from[0] + (a.to[0] - a.from[0]) * k, y = a.from[1] + (a.to[1] - a.from[1]) * k, vx = k < 1 ? (a.to[0] - a.from[0]) / a.dur : 0, vy = k < 1 ? (a.to[1] - a.from[1]) / a.dur : 0; a.x = x; a.y = y; const st = { x, y, z: 0, vx, vy, facing: a.st.facing || 0, pose: a.st.pose, down: a.st.down, run: k < 1 ? a.st.run : 0 }; if (a.st.dieAt !== undefined && t > a.st.dieAt) st.pose = 'die'; if (a.st.kneel) st.pose = 'kneel'; a.rig.update(dt, st); } }\n  draw(r) { const D = this.def, t = this.t; if (D.custom) { D.draw(r, t); this.caption(r); return; } this.map.drawFloor(r); this.map.queueWalls(r); for (const p of D.props) r.shape(p[0], p[1], p[2], 0, { facing: p[3] === undefined ? 1.57 : p[3] }); const L = this.game.lights; L.add(r.W ? 100 : 0, 40, 40, 200, .8, { color: '#d8f0e8' }); if (D.gurney) { const a = this.actors[2]; r.shape('gurney', a.x, a.y, 0, { facing: 0 }); } for (const a of this.actors) { r.shadow(a.x, a.y, 6); r.actor(a.x, a.y, a.st.down ? 11 : 0, (g, ox, oy) => a.rig.draw(g, ox, oy, r.view)); } if (D.tray) { const k = Math.min(1, t / 1.0); r.overlay(g => { for (let i = 0; i < 6; i++) { const a = i * 1.1; const o = r.w(84 + Math.cos(a) * 14 * k, 60 + Math.sin(a) * 8 * k, 0); px.rect(g, o[0], o[1] - 2, 5, 1, '#d8e4ee'); } }); } this.caption(r); }\n  caption(r) { r.overlay(g => { px.rect(g, 0, 0, r.W, 18, '#000000'); px.rect(g, 0, r.H - 22, r.W, 22, '#000000'); font.text(g, this.def.cap, r.W / 2, r.H - 16, '#e8fbf6', { align: 'center', outline: false }); }); }\n  finish() { const game = this.game; game.lights.enabled = false; game.setView('overhead'); }\n}\nG.CinePlayer = CinePlayer;\n})();\nEOF\ncat > src/scenes/story.js <<'EOF'\n// The story scene: a painted stage, big portraits, typed lines with gibberish voices, chapter cards, cinematics, a backlog.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst STAFF = { vale: 1, quill: 1, sokolova: 1, oyelaran: 1 };\nconst LEFT = { vale: 1, sokolova: 1 };\nG.SCENES = G.SCENES || {};\nG.makeStory = (game) => { const people = {}; for (const id in G.CAST) people[id] = { name: G.CAST[id].name };\n  const talk = new E.Dialog(game, { voice: (ch) => G.babble.letter(ch, G.curWho || 'quill'), speed: 46, lines: 2, width: 416, bg: '#06161a', border: '#5ff0e0', nameColor: '#5ff0e0' });\n  const story = new E.Story(game, { people, nodes: G.compileStory(), dialog: talk, on: { stage: (s, st) => G.storyView.setStage(st.arg), look: (s, st) => G.storyView.look(st.who, st.expr), card: (s, st) => G.storyView.card(st.arg), cine: (s, st) => G.storyView.cine(st.arg) } });\n  return story; };\nclass StoryView {\n  constructor(game) { this.game = game; this.reset(); }\n  reset() { this.stage = null; this.slots = { L: null, R: null }; this.t = 0; this.cardT = 0; this.cardText = null; this.player = null; this.backlog = false; this.blinkT = 2; this.speaker = null; }\n  setStage(id) { this.stage = id; this.slots = { L: null, R: null }; const m = { harbor: 'tension', gala: 'tension', theatre: 'tension', chapel: 'ward', scrub: 'ward', radiology: 'ward', office: 'tension', ward: 'ward', shipward: 'tension', gallery: 'ward' }[id]; if (!this.silent) G.music.play(m || 'ward'); }\n  look(who, expr) { G.curWho = who; this.speaker = who; const side = LEFT[who] ? 'L' : 'R', cur = this.slots[side]; if (cur && cur.who === who) { if (cur.expr !== expr && (expr === 'shock' || expr === 'shout')) cur.shake = .3; cur.expr = expr; } else this.slots[side] = { who, expr, slide: 0, shake: expr === 'shock' ? .3 : 0 }; }\n  card(arg) { const [a, b] = arg.split('|'); this.cardText = [a, b]; this.cardT = 2.6; G.sfx.swell(); }\n  cine(id) { this.player = new G.CinePlayer(this.game, id); G.sfx.swell(); if (id === 'stormship') { G.sfx.foghorn(); G.sfx.creak(); } }\n  update(dt) { const game = this.game, I = game.input, story = G.story; this.t += dt; this.blinkT -= dt; if (this.blinkT < -.12) this.blinkT = 2 + Math.random() * 3; for (const k in this.slots) { const q = this.slots[k]; if (q) { q.slide = Math.min(1, q.slide + dt * 4); if (q.shake > 0) q.shake -= dt; } }\n    if (this.cardT > 0) { this.cardT -= dt; if (I.pressed('confirm') || I.clicked()) this.cardT = Math.min(this.cardT, .2); if (this.cardT <= 0) { this.cardText = null; story.resume(); } return true; }\n    if (this.player) { this.player.update(dt); if (this.player.done || I.pressed('confirm') || I.clicked()) { this.player.finish(); this.player = null; game.focus(game.W / 2, game.H / 2, 0); story.resume(); } return true; }\n    game.focus(game.W / 2, game.H / 2, 0);\n    if (I.pressed('log')) this.backlog = !this.backlog; if (this.backlog) { if (I.pressed('cancel') || I.pressed('confirm')) this.backlog = false; I.consumeAll(); return true; }\n    story.skip = I.down('skip') || !!this.autoSkip; story.update(dt); return story.running; }\n  draw(r) { if (this.player) { this.player.draw(r); return; } const talk = G.story.talk; r.overlay(g => { if (this.stage) G.drawStage(g, this.stage, r.W, r.H, this.t); else px.rect(g, 0, 0, r.W, r.H, '#000'); for (const side of ['L', 'R']) this.drawSlot(g, r, side, talk);\n      if (this.cardText) { px.blend(g, .8, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); const w = r.W; font.text(g, this.cardText[0].toUpperCase(), w / 2, r.H / 2 - 30, '#5ff0e0', { align: 'center', outline: false, shadow: '#000' }); font.title(g, this.cardText[1], w / 2, r.H / 2 - 14, { scale: 3, align: 'center', colors: ['#ffffff', '#a8e8e0'] }); }\n      if (this.stage && talk.open && !this.cardText) { const inp = this.game.input; const w = G.promptWidth(inp, 'skip', 'Hold: skip') + G.promptWidth(inp, 'log', 'Log') + 10; let x = r.W - w - 6; x += G.drawPrompt(g, inp, 'skip', 'Hold: skip', x, 4) + 10; G.drawPrompt(g, inp, 'log', 'Log', x, 4); } if (this.backlog) this.drawLog(g, r); });\n    G.story.draw(r); }\n  drawSlot(g, r, side, talk) { const q = this.slots[side]; if (!q) return; const speaking = q.who === this.speaker, typing = speaking && talk.open && talk.typing, mouth = typing && (this.t * 10 | 0) % 2, c = G.bust(q.who, q.expr, { blink: this.blinkT < 0 && !typing, talk: mouth, maskUp: this.stage === 'theatre' && STAFF[q.who] && q.expr !== 'shock' }), e = 1 - (1 - q.slide) ** 3, W = r.W, base = side === 'L' ? Math.max(12, W * .18 - 56) : Math.min(W - 124, W * .82 - 56), off = (1 - e) * (side === 'L' ? -140 : 140), bob = typing ? Math.sin(this.t * 14) * 1 : Math.sin(this.t * 1.6) * .7, sh = q.shake > 0 ? Math.sin(this.t * 70) * 2 : 0; px.reset(g); const a = g.globalAlpha; if (!speaking) g.globalAlpha = .72; g.drawImage(c, base + off + sh | 0, r.H - 128 - 22 + bob | 0); g.globalAlpha = a; px.reset(g); }\n  drawLog(g, r) { px.blend(g, .9, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); font.text(g, 'BACKLOG', 12, 8, '#5ff0e0', { outline: false }); const L = G.story.log.slice(-9); L.forEach((e, i) => { const y = 24 + i * 24; font.text(g, e.name || '', 12, y, '#5ff0e0', { outline: false }); font.text(g, e.text.slice(0, 90), 12, y + 10, '#e8fbf6', { outline: false }); }); }\n}\nG.StoryView = StoryView;\nG.SCENES.story = { pausable: true, view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; game.saves.canSave = false; const V = G.storyView; V.reset(); V.silent = false; this.then = d.then; G.story.auto = d.auto || 0; V.autoSkip = !!d.autoSkip; G.story.run(d.id, { onDone: () => { this.done = true; } }); this.done = false; },\n  update(dt) { G.storyView.update(dt); if (this.done && !G.storyView.player) { this.done = false; const t = this.then; this.then = null; if (t) t(); } },\n  draw(r) { G.storyView.draw(r); } };\n})();\nEOF\ncat > src/scenes/flow.js <<'EOF'\n// Everything between the operations: title, menu, difficulty, chart, lightbox, results, lost, case files, credits, about.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst SC = G.SCENES = G.SCENES || {};\nconst center = (g, s, x, y, c, o = {}) => font.text(g, s, x, y, c, Object.assign({ align: 'center', outline: false, shadow: '#000' }, o));\n// ---- progress ----\nconst fresh = () => ({ flow: 0, diff: 'resident', ranks: {}, unlocked: ['c1'], ended: false, morale: false });\nG.prog = fresh();\nG.loadProg = () => { const p = E.store.get('scalpel.prog', null); if (p) G.prog = Object.assign(fresh(), p); };\nG.saveProg = () => { E.store.set('scalpel.prog', G.prog); };\nG.newGame = (diff) => { const keep = G.prog.ranks, ended = G.prog.ended, un = G.prog.unlocked; G.prog = fresh(); G.prog.ranks = keep; G.prog.ended = ended; G.prog.unlocked = un; G.prog.diff = diff; G.saveProg(); };\nG.flowGo = (i) => { const game = G.game, it = G.FLOW[i]; G.prog.flow = i; G.saveProg(); if (!it) { game.go('title'); return; } if (it.k === 'story') game.go('story', { id: it.id, then: () => G.flowGo(i + 1) }); else if (it.k === 'case') game.go('chart', { caseId: it.id, mode: 'story', then: () => G.flowGo(i + 1) }); else if (it.k === 'ward') game.go('ward', { map: it.map, after: it.after, then: () => G.flowGo(i + 1) }); else game.go('credits', { ending: true }); };\n// Title and menu share the skyline\nconst skyline = () => { if (G._sky) return G._sky; G._sky = new E.Backdrop({ sky: ['#04060e', '#0c1624', '#1c2c3c'], moon: false, stars: 40, starsY: .4, layers: [{ kind: 'city', color: '#0c1622', y: .58, height: .3, parallax: .1 }, { kind: 'fog', color: '#1c3040', y: .7, parallax: .2 }] }); return G._sky; };\nfunction drawHarbor(r, t, logoY) { skyline().draw(r); r.overlay(g => { const W = r.W, H = r.H, bx = W * .5 | 0, by = H * .78 | 0; const crane = (x, s) => { px.line(g, x, by, x, by - 80 * s, '#0a1218', 3); px.line(g, x - 14 * s, by - 70 * s, x + 60 * s, by - 78 * s, '#0a1218', 2); px.line(g, x, by - 92 * s, x + 60 * s, by - 78 * s, '#0a1218', 1); px.line(g, x, by - 92 * s, x - 14 * s, by - 70 * s, '#0a1218', 1); }; crane(W * .1 | 0, 1.1); crane(W * .86 | 0, 1.3); px.rect(g, bx - 110, by - 74, 220, 74, '#141e28'); px.rect(g, bx - 40, by - 110, 80, 36, '#18242e'); px.rect(g, bx + 110, by - 54, 70, 54, '#a8c0c8'); for (let y = 0; y < 8; y++) for (let x = 0; x < 19; x++) { const k = (x * 7 + y * 13) % 5; if (k < 3) px.rect(g, bx - 104 + x * 11, by - 70 + y * 9, 7, 6, k ? '#e8c870' : '#88a8b0'); } for (let y = 0; y < 3; y++) for (let x = 0; x < 6; x++) px.rect(g, bx + 114 + x * 11, by - 50 + y * 15, 7, 10, '#1c5a68'); px.rect(g, bx - 8, by - 108, 16, 5, '#e84a4a'); px.rect(g, bx - 3, by - 113, 6, 15, '#e84a4a'); font.text(g, 'ANODYNE', bx + 144, by - 62, '#5ff0e0', { align: 'center', font: 'tiny', outline: false }); px.rect(g, 0, by, W, H - by, '#0a141c'); for (let y = by + 4; y < H; y += 5) for (let x = (y * 3) % 17; x < W; x += 26) px.rect(g, x + Math.sin(t + y) * 4, y, 12, 1, '#284050');\n    const a = (t * .14) % 1.4 - .2, ax = a * W; if (a < 1.1) { px.rect(g, ax, by - 12, 26, 11, '#d8e0e4'); px.rect(g, ax + 2, by - 10, 6, 4, '#3a5060'); px.rect(g, ax + 14, by - 8, 6, 2, '#c82a2a'); if ((t * 6 | 0) % 2) { px.rect(g, ax + 12, by - 14, 4, 2, '#ff3030'); px.blend(g, .3, 'add', () => px.disc(g, ax + 14, by - 14, 18, '#ff3030')); } else { px.rect(g, ax + 18, by - 14, 4, 2, '#3060ff'); px.blend(g, .3, 'add', () => px.disc(g, ax + 20, by - 14, 18, '#3060ff')); } }\n    font.title(g, G.GAME_TITLE, W / 2, logoY, { scale: W > 460 ? 4 : 3, align: 'center', colors: ['#ffffff', '#a8e8e0', '#5ff0e0'], depth: 2, depthColor: '#0b2a30' }); const k = Math.min(1, t / 1.6), y0 = logoY + (W > 460 ? 40 : 32), L = Math.min(W - 40, 320), X0 = W / 2 - L / 2; let lx = X0, ly = y0; for (let i = 1; i <= L * k; i += 1) { const u = ((i / L * 5) + t * .1) % 1, v = G.ecgValue(u) * 14; const yy = y0 - v; px.line(g, lx, ly, X0 + i, yy, '#40f0a0', 1); lx = X0 + i; ly = yy; } }); }\nSC.title = { view: 'side', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; game.saves.canSave = false; this.t = 0; game.weather = { kind: 'rain', amount: .7, wind: .2, lightning: .05 }; G.music.play('title'); this.b = -1; G.touchNotice && G.touchNotice(); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, 0, game.H / 2); const n = this.t * .9 | 0; if (n !== this.b && this.t < 1.8) { this.b = n; G.sfx.beep(70); } if (I.anyPressed() || I.clicked()) { if (this.t > .3) { I.consumeAll(); G.sfx.ui(); game.go('menu'); } } },\n  draw(r) { drawHarbor(r, this.t, 28); r.overlay(g => { if ((this.t * 1.6 | 0) % 2 === 0) { const I = G.game.input; center(g, I.lastDevice === 'gamepad' ? 'Press ' + I.label('start') : I.lastDevice === 'mouse' ? 'Click to begin' : 'Press ' + I.label('start'), r.W / 2, r.H * .72, '#ffffff', { scale: 1 }); } center(g, G.TAGLINE, r.W / 2, r.H - 14, '#8fb8b0'); }); } };\nSC.menu = { view: 'side', camera: { zoom: false, wheel: false },\n  enter() { const game = G.game; game.saves.canSave = false; this.t = 2; game.weather = { kind: 'rain', amount: .5, wind: .2 }; G.music.play('title'); const has = game.saves.latest && game.saves.latest(); this.m = new E.Menu(game, [{ label: 'Continue', disabled: !has }, 'New Game', 'Case Files', 'Grand Rounds', 'Settings', 'About'], { scale: 2, x: 'center', y: 84, bg: '#06161a', border: '#5ff0e0', pick: '#5ff0e0', onPick: (i) => this.pick(i, has), onCancel: () => game.go('title') }); },\n  pick(i, has) { const game = G.game; if (i === 0) { game.saves.load(has.slot === undefined ? 'auto' : has.slot); return; } if (i === 1) game.go('difficulty'); if (i === 2) game.go('casefiles'); if (i === 3) game.go('lobby'); if (i === 4) game.menu('settings'); if (i === 5) game.go('about', { back: 'menu' }); },\n  update(dt) { this.t += dt; const game = G.game; game.focus(game.W / 2, 0, game.H / 2); if (!game.paused && !(game.shell && game.shell.screen)) this.m.update(); },\n  draw(r) { drawHarbor(r, this.t, 12); this.m.draw(r); } };\nconst DIFF_LINES = { intern: \"Hints on, generous clock. Nobody's watching, Doctor.\", resident: 'The job as it is. I have seen worse.', attending: 'No Code Blue. A star, if you are perfect. Do try.' };\nSC.difficulty = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter() { this.i = 1; this.t = 0; G.music.play('ward'); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = 3, w = 128, gap = 8, x0 = (game.W - (w * n + gap * 2)) / 2; const box = i => [x0 + i * (w + gap), 60, w, 120]; const hit = p => { if (!p) return -1; for (let i = 0; i < n; i++) { const b = box(i); if (p[0] >= b[0] && p[0] < b[0] + b[2] && p[1] >= b[1] && p[1] < b[1] + b[3]) return i; } return -1; }; if (I.repeat('left')) { this.i = (this.i + 2) % 3; G.sfx.ui(); } if (I.repeat('right')) { this.i = (this.i + 1) % 3; G.sfx.ui(); } if (I.mouse.t !== this.mt) { this.mt = I.mouse.t; const h = hit(I.pointer()); if (h >= 0 && h !== this.i) { this.i = h; G.sfx.ui(); } } const c = hit(I.clicked()); if (c >= 0) this.i = c; if (I.pressed('confirm') || c >= 0) { I.consumeAll(); G.sfx.chime(); G.newGame(G.DIFF_ORDER[this.i]); G.flowGo(0); } if (I.pressed('cancel')) { I.consumeAll(); game.go('menu'); } this.box = box; },\n  draw(r) { r.overlay(g => { G.drawStage(g, 'scrub', r.W, r.H, this.t); center(g, 'How long have you been a doctor?', r.W / 2, 30, '#fff', { scale: 1 }); if (!this.box) return; G.DIFF_ORDER.forEach((id, i) => { const [x, y, w, h] = this.box(i), on = i === this.i; E.ui.box(g, x, y, w, h, { bg: on ? '#104a48' : '#06161a', border: on ? '#5ff0e0' : '#2c6a64' }); center(g, G.DIFFS[id].name, x + w / 2, y + 12, on ? '#5ff0e0' : '#e8fbf6', { scale: 2 }); font.text(g, DIFF_LINES[id], x + 8, y + 44, '#e8fbf6', { wrap: w - 16, outline: false, shadow: '#000' }); }); const b = G.bust('quill', 'neutral'); }); } };\n// ---- the chart and the lightbox ----\nSC.chart = { pausable: true, view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; game.saves.canSave = false; this.d = d; const c = this.c = G.CASES[d.caseId]; this.t = 0; this.stage = 'chart'; this.bonus = { clock: 0, steady: 0, markers: [] }; this.tries = 0; this.cur = [213, 120]; this.msg = null; this.stT = 0; G.music.play('tension'); G.babble.say(c.opinion, 'quill', { vol: .7 }); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); if (this.stage === 'chart') { if (this.t > .25 && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); G.sfx.ui(); if (this.c.lightbox) { this.stage = 'lightbox'; this.t = 0; } else this.scrub(); } if (I.pressed('cancel') && this.d.mode === 'files') { I.consumeAll(); game.go('casefiles'); } return; }\n    if (this.stage === 'lightbox') { const L = this.c.lightbox, a = I.padAim || I.padMove || [0, 0], k = I.move(); this.cur[0] += (a[0] + k[0]) * 200 * dt; this.cur[1] += (a[1] + k[1]) * 200 * dt; const OX = (game.W - 426) >> 1, OY = (game.H - 240) >> 1, ptr = I.lastDevice === 'mouse' ? I.pointer() : null; if (ptr) this.cur = [ptr[0] - OX, ptr[1] - OY]; const c = I.clicked(); if (this.result) { this.resT -= dt; if (this.resT <= 0 || (this.resT < 1.2 && (I.pressed('confirm') || c))) { I.consumeAll(); this.scrub(); } return; } if (I.pressed('confirm') || c) { I.consumeAll(); const at = c ? [c[0] - OX, c[1] - OY] : this.cur; if (Math.hypot(at[0] - L.at[0], at[1] - L.at[1]) < 14) { this.result = 'right'; this.resT = 2.4; this.bonus.clock += 20; this.bonus.steady += 20; this.bonus.markers.push(L.markAt || L.at); G.sfx.chime(); G.babble.say('Second opinion confirmed!', 'odalys'); } else { this.tries++; this.bonus.clock -= 10; G.sfx.sloppy(); this.msg = 'Dr. Whitlock smirks. Minus ten seconds.'; G.babble.say('Mm. Try again.', 'percy'); if (this.tries >= 3) { this.result = 'wrong'; this.resT = 2.4; this.msg = \"Odalys taps the film. There. That's it.\"; } } } return; }\n    if (this.stage === 'scrub') { this.stT += dt; if (this.stT > 1.8 || (this.stT > .3 && (I.pressed('confirm') || I.clicked()))) { I.consumeAll(); const D = this.d, b = this.bonus; game.go('op', Object.assign({}, D, { clockBonus: b.clock, steady: (b.steady || 0) + (G.prog.morale ? 10 : 0), markers: b.markers })); G.prog.morale = false; } } },\n  scrub() { this.stage = 'scrub'; this.stT = 0; this.result = null; G.sfx.noise({ f: 2400, to: 800, d: 1.4, v: .1, q: .5, a: .2 }); },\n  draw(r) { r.overlay(g => { G.drawStage(g, this.c.lightbox && this.stage === 'lightbox' ? 'radiology' : 'theatre', r.W, r.H, this.t); if (this.stage === 'chart') this.drawChart(g, r); else if (this.stage === 'lightbox') this.drawLightbox(g, r); else this.drawScrub(g, r); }); },\n  drawChart(g, r) { const w = 260, h = 186, x = (r.W - w) / 2 | 0, y = (r.H - h) / 2 | 0, c = this.c; px.rect(g, x - 3, y - 3, w + 6, h + 6, '#5a3a20'); px.rect(g, x, y, w, h, '#ece6d4'); px.rect(g, x + w / 2 - 24, y - 8, 48, 14, '#a8b0b8'); const ink = '#1c2028', red = '#a02020'; font.text(g, 'CASE ' + (c.number || '--'), x + 12, y + 14, red, { outline: false }); font.title(g, c.title, x + 12, y + 26, { scale: 2, colors: [ink, ink], depth: 0, outline: false }); px.rect(g, x + 12, y + 50, w - 24, 1, ink); font.text(g, c.patient, x + 12, y + 56, ink, { outline: false }); font.text(g, c.complaint, x + 12, y + 72, ink, { wrap: w - 24, outline: false }); font.text(g, 'FIRST OPINION', x + 12, y + 106, red, { outline: false }); font.text(g, c.opinion, x + 12, y + 118, ink, { wrap: w - 24, outline: false }); const I = G.game.input, pw = G.promptWidth(I, 'confirm', c.lightbox ? 'See the film' : 'Scrub in'); G.drawCap(g, I.label('confirm'), x + w - pw - 10, y + h - 18, { pad: I.lastDevice === 'gamepad' }); font.text(g, c.lightbox ? 'See the film' : 'Scrub in', x + w - pw - 10 + G.capWidth(I.label('confirm')) + 3, y + h - 16, ink, { outline: false }); },\n  drawLightbox(g, r) { const OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1, L = this.c.lightbox, x0 = 96 + OX, y0 = 40 + OY, w = 234, h = 170; px.rect(g, x0 - 6, y0 - 6, w + 12, h + 12, '#88b8d8'); px.rect(g, x0 - 3, y0 - 3, w + 6, h + 6, '#2a3a44'); G.drawFilm(g, L.film, x0, y0, w, h, this.t, L, OX, OY); const b = G.bust('odalys', 'smile'); px.reset(g); g.drawImage(b, 28, 16, 56, 76, 16 + OX, 90 + OY, 56, 76); px.reset(g); px.rect(g, 340 + OX, 56 + OY, 74, 44, '#f4e878'); font.text(g, this.c.opinion, 343 + OX, 59 + OY, '#2a2010', { wrap: 68, font: 'tiny', outline: false }); const cx = this.cur[0] + OX | 0, cy = this.cur[1] + OY | 0; G.ringDraw(g, cx, cy, 8, '#ffe08a', 16); px.rect(g, cx, cy - 12, 1, 6, '#ffe08a'); px.rect(g, cx, cy + 7, 1, 6, '#ffe08a'); px.rect(g, cx - 12, cy, 6, 1, '#ffe08a'); px.rect(g, cx + 7, cy, 6, 1, '#ffe08a'); const txt = this.result === 'right' ? 'Second opinion confirmed. ' + L.text : this.result === 'wrong' ? this.msg + ' ' + L.text : this.msg || 'Point at what is really wrong.'; G.panel(g, 40 + OX, 214 + OY, 346, 22, .9); center(g, txt.slice(0, 66), r.W / 2, 220 + OY, this.result === 'right' ? '#5ff0e0' : '#fff'); if (this.result) G.ringDraw(g, L.at[0] + OX, L.at[1] + OY, 14 + Math.sin(this.t * 8) * 2, '#5ff0e0', 22); },\n  drawScrub(g, r) { const k = Math.min(1, this.stT * 3), id = this.c.doc === 'soko' || this.c.doc === 'both' ? 'sokolova' : 'vale', c = G.bust(id, 'neutral', { maskUp: this.stT > .7 }); px.blend(g, .6, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#04100e')); px.reset(g); g.drawImage(c, (r.W - 112) / 2 | 0, (r.H - 128 - 22 + (1 - k) * 60) | 0); px.reset(g); center(g, 'SCRUB IN', r.W / 2, 34, '#5ff0e0', { scale: 2 }); for (let i = 0; i < 18; i++) { const x = r.W / 2 - 60 + i * 7, y = (this.stT * 180 + i * 37) % 170 + 40; px.rect(g, x, y, 1, 4, '#a8e0f0'); } } };\nG.drawFilm = (g, kind, x0, y0, w, h, t, L, OX, OY) => { px.rect(g, x0, y0, w, h, '#0c161c'); const bone = '#b8ccd4', cx = x0 + w / 2, cy = y0 + h / 2; px.polyDither(g, [[x0 + 16, y0 + 16], [x0 + w - 16, y0 + 16], [x0 + w - 16, y0 + h - 16], [x0 + 16, y0 + h - 16]], '#30424c', .4, 0, 0); if (kind === 'ribs') { px.rect(g, cx - 4, y0 + 8, 8, h - 16, bone); for (let i = 0; i < 7; i++) { const y = y0 + 16 + i * 20; for (const s of [-1, 1]) { px.line(g, cx + s * 4, y, cx + s * 54, y + 6, bone, 3); px.line(g, cx + s * 54, y + 6, cx + s * 86, y + 26, bone, 2); } } } else if (kind === 'spine') { for (let i = 0; i < 8; i++) { const y = y0 + 8 + i * 20; px.rect(g, cx - 12, y, 24, 15, bone); px.rect(g, cx - 18, y + 5, 36, 4, '#90a4ac'); } px.poly(g, [[cx - 70, y0 + h], [cx - 34, y0 + h - 44], [cx + 34, y0 + h - 44], [cx + 70, y0 + h]], '#90a4ac'); } else { px.ell(g, cx, cy - 8, 76, 66, bone); px.ell(g, cx, cy - 8, 68, 58, '#0c161c'); px.rect(g, cx - 26, cy + 56, 52, 18, bone); px.ell(g, cx - 26, cy + 6, 14, 10, bone); px.ell(g, cx + 26, cy + 6, 14, 10, bone); px.ell(g, cx - 26, cy + 6, 10, 7, '#0c161c'); px.ell(g, cx + 26, cy + 6, 10, 7, '#0c161c'); } for (let i = 0; i < 300; i++) px.dot(g, x0 + ((i * 7919) % w), y0 + ((i * 104729) % h), i % 4 ? '#1c2a32' : '#3a4a54'); for (const d of (L.decoys || [])) px.disc(g, d[0] + OX, d[1] + OY, 5, '#5a6a74'); const X = L.at[0] + OX, Y = L.at[1] + OY, wob = L.moving ? Math.sin(t * 3) * 3 : 0; px.disc(g, X + wob, Y, 8, '#d0dde4'); px.disc(g, X + wob, Y, 5, '#f4fcff'); if (kind === 'skull') { px.ell(g, X, Y, 9, 4, '#0c161c'); px.disc(g, X, Y, 2, '#f4fcff'); } px.rect(g, x0, y0 + ((t * 40) % h), w, 1, '#2a4048'); };\n// ---- the operation's scene ----\nSC.op = { pausable: true, view: 'overhead', camera: { zoom: false, wheel: false }, expand: true,\n  enter(d) { const game = G.game; game.saves.canSave = false; this.d = d; game.focus(game.W / 2, game.H / 2, 0); const diff = d.difficulty || G.prog.diff; this.diff = diff; const c = G.CASES[d.caseId]; const seats = d.seats || [{ pid: 0, input: game.input }]; const players = d.players || seats.map((s, i) => ({ id: s.pid, color: G.SEATS[s.pid] })); const assist = game.settings.assist === undefined ? 0 : (game.settings.assist - .6); this.S = d.S || G.Op.create(c, { seed: (d.seed || (Date.now() % 100000)) | 0, difficulty: diff, players, steady: d.steady, clockBonus: d.clockBonus, markers: d.markers, phase: d.phase, assistPlus: assist }); this.view = new G.OpView(game, this.S, { seats, music: c.music || 'op' }); G.music.play(c.music || 'op'); this.done = false; this.dev = G.tuningChanged() || G.cheating(); for (const s of seats) { s.cur.speedK = game.settings.cursorSpeed || 1; } G.op = this; game.input.consumeAll(); },\n  exit() { const c = G.game.screen.canvas; if (c) c.style.cursor = ''; G.sfx.stopLoops(); G.sfx.setSlow(false); G.sfx.setMode('normal'); G.choir.silence(); },\n  update(dt) { const game = G.game, c = game.screen.canvas; if (c) c.style.cursor = game.paused ? '' : 'none'; game.focus(game.W / 2, game.H / 2, 0); if (this.done) return; this.dev = this.dev || G.tuningChanged() || G.cheating(); this.view.update(dt); const S = this.S; if (S.done && !this.done) { this.done = true; game.after(S.done === 'won' ? .3 : 1.4, () => { if (S.done === 'won') game.go('results', { S, d: this.d, dev: this.dev, diff: this.diff }); else game.go('lost', { S, d: this.d, view: this.view, diff: this.diff }); }, { keep: false }); } },\n  draw(r) { this.view.draw(r); } };\n// ---- results ----\nSC.results = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; this.d = d; const S = d.S, c = G.CASES[S.caseId]; this.t = 0; this.shown = 0; G.music.play(null); G.music.sting('closed'); const R = this.res = G.rankOf(S, (G.PAR && G.PAR[S.caseId]) || 1); this.line = E.pick ? G.RANK_LINES[R.rank][S.ht * 7 % G.RANK_LINES[R.rank].length | 0] : ''; const tot = S.acts.sloppy + S.acts.clean + S.acts.textbook; this.tiles = [['Time left', G.fmtClock(S.clock)], ['Pulse held', '' + Math.round(S.v)], ['Technique', (tot ? Math.round((S.acts.clean + S.acts.textbook) / tot * 100) : 100) + '%'], ['Best Flow', 'x' + S.bestFlow]]; if (!d.dev && !S.attract && d.d.mode !== 'gr' && !S.lab) { const r = G.prog.ranks[S.caseId] = G.prog.ranks[S.caseId] || {}, order = 'DCBAS', cur = r[d.diff]; if (!cur || order.indexOf(R.rank) > order.indexOf(cur)) r[d.diff] = R.rank; if (R.star) r.star = true; const i = G.CASE_ORDER.indexOf(S.caseId), nx = G.CASE_ORDER[i + 1]; if (nx && !G.prog.unlocked.includes(nx)) G.prog.unlocked.push(nx); G.saveProg(); } game.input.consumeAll(); },\n  update(dt) { const game = G.game, I = game.input; const was = this.t; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = Math.min(4, this.t / .45 | 0); if (n > this.shown) { this.shown = n; G.sfx.tick(); } if (was < 2.1 && this.t >= 2.1) { G.sfx.stamp(); game.shake(3); G.babble.say(this.line, 'quill'); } if (this.t > 2.4 && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); this.next(); } else if (I.pressed('confirm') || I.clicked()) { I.consumeAll(); this.t = 2.4; this.shown = 4; } },\n  next() { const m = this.d.d; if (m.then) { m.then(); return; } G.game.go(m.mode === 'gr' ? 'lobby' : 'casefiles'); },\n  draw(r) { const S = this.d.S, c = G.CASES[S.caseId], t = this.t; r.overlay(g => { G.drawStage(g, 'scrub', r.W, r.H, t); px.blend(g, .45, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); center(g, 'CASE CLOSED', r.W / 2, 14, '#ff5a4a', { scale: 2 }); center(g, c.title, r.W / 2, 36, '#e8fbf6'); const id = S.doc === 'soko' ? 'sokolova' : 'vale'; px.reset(g); g.drawImage(G.bust(id, this.res.rank === 'D' || this.res.rank === 'C' ? 'neutral' : 'smile', {}), 6, r.H - 128 | 0); px.reset(g); const x0 = r.W / 2 - 88 | 0; this.tiles.forEach(([a, b], i) => { if (i >= this.shown) return; const y = 52 + i * 30; G.panel(g, x0, y, 176, 26); font.text(g, a, x0 + 8, y + 9, '#8fb8b0', { outline: false }); font.text(g, b, x0 + 168, y + 5, '#ffffff', { align: 'right', outline: false, scale: 2 }); }); if (t > 2.1) { const k = Math.min(1, (t - 2.1) * 6), sc = k < 1 ? 7 : 5; const x = r.W - 62, y = 60; G.ringDraw(g, x, y + 16, 34, '#ff5a4a', 36); G.ringDraw(g, x, y + 16, 32, '#ff5a4a', 36); font.text(g, this.res.rank, x, y, '#ff5a4a', { align: 'center', scale: sc, outline: false }); if (this.res.star) center(g, '★ Textbook', x, y + 52, '#ffe08a'); if (this.d.dev) center(g, 'DEV', x, y - 24, '#ff9a7a', { scale: 2 }); if (S.capB) center(g, 'Retried: capped at B', x, y + 62, '#ff9a7a', { font: 'tiny' }); center(g, this.line, r.W / 2 + 40, 182, '#e8fbf6'); } if (t > 2.4) { const I = G.game.input, w = G.promptWidth(I, 'confirm', 'Continue'); G.drawPrompt(g, I, 'confirm', 'Continue', r.W - w - 10, r.H - 18); } }); } };\n// ---- lost ----\nSC.lost = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { const game = G.game; this.d = d; const S = d.S; this.t = 0; const L = G.LOST_LINES[S.lostWhy] || G.LOST_LINES.vitals; this.line = L[0]; G.babble.say(this.line, 'quill'); const f = G.Op.fails(S) + 1, items = ['Retry from this phase', 'Restart case']; if (f >= 2 && d.diff !== 'intern') items.push('Lower difficulty for this case'); items.push('Quit'); this.items = items; this.m = new E.Menu(game, items, { scale: 1, x: 'center', y: 150, bg: '#06161a', border: '#ff7a6a', pick: '#ff9a7a', onPick: (i, it) => this.pick(it) }); game.input.consumeAll(); },\n  pick(it) { const game = G.game, D = this.d, S = D.S; if (it === 'Retry from this phase') { G.Op.retry(S); game.go('op', Object.assign({}, D.d, { S, seats: D.view.seats })); } else if (it === 'Restart case') game.go('op', Object.assign({}, D.d, { S: null, phase: 0 })); else if (it.startsWith('Lower')) game.go('op', Object.assign({}, D.d, { S: null, phase: 0, difficulty: 'intern' })); else game.go(D.d.mode === 'story' ? 'menu' : D.d.mode === 'gr' ? 'lobby' : 'casefiles'); },\n  update(dt) { this.t += dt; const game = G.game; game.focus(game.W / 2, game.H / 2, 0); if (this.t > .5) this.m.update(); },\n  draw(r) { r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#04060a'); let last = 0; const y0 = 70; for (let x = 0; x < r.W; x++) { px.dot(g, x, y0, '#ff5a4a'); } center(g, this.d.S.lostWhy === 'bomb' ? 'THE SHIP WENT' : 'PATIENT LOST', r.W / 2, 28, '#ff7a6a', { scale: 2 }); px.reset(g); g.drawImage(G.bust('quill', 'sad', { maskUp: true }), 28, 16, 56, 60, r.W / 2 - 28 | 0, 78, 56, 60); px.reset(g); center(g, this.line, r.W / 2, 140, '#e8fbf6'); }); this.m.draw(r); } };\n// ---- case files ----\nSC.casefiles = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter() { this.t = 0; this.i = this.i || 0; G.music.play('ward'); this.build(); G.game.input.consumeAll(); },\n  build() { const un = G.prog.unlocked; this.L = [...G.CASE_ORDER.filter(id => un.includes(id)).map(id => ({ id })), { id: 'lab' }]; if (G.prog.ended) this.L.push({ blank: true }); this.i = Math.min(this.i, this.L.length - 1); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = this.L.length; if (I.repeat('left') || I.pressed('toolPrev')) { this.i = (this.i + n - 1) % n; G.sfx.ui(); } if (I.repeat('right') || I.pressed('toolNext')) { this.i = (this.i + 1) % n; G.sfx.ui(); } const c = I.clicked(); let side = 0; if (c) { if (c[0] < game.W * .22) side = -1; else if (c[0] > game.W * .78) side = 1; } if (side) { this.i = (this.i + n + side) % n; G.sfx.ui(); } else if (I.pressed('confirm') || c) { I.consumeAll(); const it = this.L[this.i]; if (it.blank) { G.sfx.ui(); return; } if (it.id === 'lab') game.go('op', { caseId: 'lab', mode: 'lab', difficulty: 'resident' }); else game.go('chart', { caseId: it.id, mode: 'files' }); } if (I.pressed('cancel')) { I.consumeAll(); game.go('menu'); } },\n  draw(r) { const it = this.L[this.i]; r.overlay(g => { G.drawStage(g, 'office', r.W, r.H, this.t); const w = 300, h = 170, x = (r.W - w) / 2 | 0, y = 26; px.poly(g, [[x, y + 8], [x + 70, y + 8], [x + 80, y], [x + 150, y], [x + 160, y + 8], [x + w, y + 8], [x + w, y + h], [x, y + h]], '#c8a860'); px.rect(g, x + 6, y + 14, w - 12, h - 20, '#ece6d4'); const ink = '#1c2028'; if (it.blank) { center(g, 'Incoming', x + w / 2, y + 40, ink, { scale: 2 }); center(g, 'Next shift starts at seven.', x + w / 2, y + 80, ink); center(g, 'Get some sleep, Doctor.', x + w / 2, y + 94, ink); } else { const c = G.CASES[it.id]; font.title(g, c.title, x + w / 2, y + 22, { scale: 2, align: 'center', colors: [ink, ink], depth: 0, outline: false }); center(g, c.patient, x + w / 2, y + 48, ink, { outline: false, shadow: undefined }); center(g, c.teach, x + w / 2, y + 62, '#5a5040'); if (it.id !== 'lab') { G.DIFF_ORDER.forEach((d, k) => { const X = x + w / 2 - 70 + k * 70, rk = (G.prog.ranks[it.id] || {})[d]; G.ringDraw(g, X, y + 112, 22, rk ? '#a02020' : '#b0a890', 28); font.text(g, rk || '-', X, y + 104, rk ? '#a02020' : '#b0a890', { align: 'center', scale: 2, outline: false }); center(g, G.DIFFS[d].name, X, y + 138, '#5a5040', { shadow: undefined }); }); if ((G.prog.ranks[it.id] || {}).star) center(g, '★ Textbook', x + w / 2, y + 150, '#a07010', { shadow: undefined }); } else center(g, c.complaint, x + w / 2, y + 90, ink); } const I = G.game.input; font.text(g, '◀', 12, r.H / 2 - 8, '#5ff0e0', { scale: 3, outline: false }); font.text(g, '▶', r.W - 28, r.H / 2 - 8, '#5ff0e0', { scale: 3, outline: false }); let X = 12; if (!it.blank) X += G.drawPrompt(g, I, 'confirm', it.id === 'lab' ? 'Practice' : 'Replay', X, r.H - 18) + 12; G.drawPrompt(g, I, 'cancel', 'Back', X, r.H - 18); center(g, (this.i + 1) + ' / ' + this.L.length, r.W / 2, r.H - 16, '#8fb8b0'); }); } };\n// ---- about and credits ----\nSC.about = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { this.back = (d && d.back) || 'menu'; this.i = 0; this.t = 0; this.pages = G.aboutPages(); G.game.input.consumeAll(); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const n = this.pages.length; if (I.repeat('left') || I.pressed('toolPrev')) { this.i = (this.i + n - 1) % n; G.sfx.ui(); } if (I.repeat('right') || I.pressed('toolNext') || I.pressed('confirm')) { this.i = (this.i + 1) % n; G.sfx.ui(); } const c = I.clicked(); if (c) { this.i = (this.i + n + (c[0] < game.W / 3 ? -1 : 1)) % n; G.sfx.ui(); } if (I.pressed('cancel')) { I.consumeAll(); game.go(this.back); } },\n  draw(r) { const p = this.pages[this.i]; r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#06161a'); font.text(g, p.title, 12, 8, '#5ff0e0', { outline: false, scale: 2 }); let y = 30; for (const l of p.lines) { if (l.h) { font.text(g, l.h, 12, y, '#ffe08a', { outline: false }); y += 10; } else if (l.t !== undefined) { font.text(g, l.t, 12, y, '#e8fbf6', { outline: false }); y += 10; } } const I = G.game.input; center(g, (this.i + 1) + ' / ' + this.pages.length, r.W / 2, r.H - 14, '#8fb8b0'); G.drawPrompt(g, I, 'cancel', 'Back', 10, r.H - 16); const w = G.promptWidth(I, 'confirm', 'Next'); G.drawPrompt(g, I, 'confirm', 'Next', r.W - w - 10, r.H - 16); }); } };\nG.aboutPages = () => { const A = G.ABOUT || { sourceInformation: {}, testingFeedback: [], engineFeedback: [], promptFeedback: [], credits: [] }, pages = [], MAX = 19, W = Math.max(400, (G.game ? G.game.W : 426) - 24); const add = (title, entries) => { let lines = []; const flush = () => { if (lines.length) { pages.push({ title, lines }); lines = []; } }; for (const [h, t] of entries) { const w = font.wrap(String(t), W); if (lines.length + w.length + (h ? 1 : 0) > MAX) flush(); if (h) lines.push({ h }); for (const l of w) { if (lines.length >= MAX) flush(); lines.push({ t: l }); } } flush(); };\n  const S = A.sourceInformation, N = { date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art Direction', animation: 'Animation', audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage' }; add('Source Information', Object.keys(N).map(k => [N[k], S[k] === undefined ? 'unknown' : S[k]]));\n  const Q = (t, qs, as) => add(t, qs.map((q, i) => [q, as[i] === undefined ? 'unknown' : as[i]])); Q('Testing Feedback', ['How many issues did testing catch?', 'How many were critical or game breaking?', 'The most helpful test', 'The least helpful test'], A.testingFeedback); Q('Engine Feedback', ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'The most important thing you built yourself', 'The hardest part of using the engine', 'What did you change in the engine, and why?', 'One thing you would change'], A.engineFeedback); Q('Prompt Feedback', ['What did you like most about this prompt?', 'What was confusing?', 'The hardest thing to do', 'What would you change?'], A.promptFeedback); add('Credits', (A.credits || []).map(c => ['', c])); return pages; };\nSC.credits = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter(d) { this.t = 0; this.stage = 'roll'; G.prog.ended = true; G.saveProg(); G.music.play('ward'); this.lines = ['SECOND SCALPEL', '', 'DR. IMOGEN VALE', 'second-year resident, frequent apologizer', '', 'BARTHOLOMEW QUILL', 'scrub nurse, Theatre Three, thirty-one years', '', 'DR. YEVGENIA SOKOLOVA', 'hospital ship Samaritan\\'s Wake', '', 'DR. MARGUERITE OYELARAN', 'Chief of Surgery, opinions in pen', '', 'DR. PERCIVAL WHITLOCK', 'it was never a hernia', '', 'ODALYS FERREIRA', 'night radiology, always right, always eating', '', 'DR. LUCIAN HALE and CLEMENTINE', '', 'and the patients of St. Erasmus Harbor Hospital', 'who would like a word about their headaches', '', 'Pain is information. Don\\'t let it go quiet.', '', 'Not a medical training tool. Please do not.']; G.game.input.consumeAll(); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); const speed = I.down('skip') || I.down('confirm') ? 60 : 16; this.y = (this.y || 0) + dt * speed; if (this.stage === 'roll' && this.y > this.lines.length * 14 + game.H) { this.stage = 'last'; this.t = 0; G.babble.say('Next shift starts at seven.', 'quill'); } if (this.stage === 'last' && (this.t > 5 || (this.t > 1 && (I.pressed('confirm') || I.clicked())))) { this.y = 0; I.consumeAll(); G.prog.flow = 0; G.saveProg(); game.go('about', { back: 'title' }); } },\n  draw(r) { r.overlay(g => { G.drawStage(g, 'harbor', r.W, r.H, this.t); px.blend(g, .55, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); if (this.stage === 'roll') this.lines.forEach((l, i) => { const y = r.H + i * 14 - this.y; if (y > -10 && y < r.H) center(g, l, r.W / 2, y, /^[A-Z ,.']+$/.test(l) && l ? '#5ff0e0' : '#e8fbf6', { scale: i === 0 ? 2 : 1 }); }); else { center(g, 'In Case Files, a new folder.', r.W / 2, r.H / 2 - 24, '#8fb8b0'); center(g, 'Incoming', r.W / 2, r.H / 2 - 8, '#fff', { scale: 2 }); center(g, 'Next shift starts at seven. Get some sleep, Doctor.', r.W / 2, r.H / 2 + 20, '#e8fbf6'); } }); } };\n})();\nEOF","description":"Write rigs, cinematics, story and flow scenes"}}}
