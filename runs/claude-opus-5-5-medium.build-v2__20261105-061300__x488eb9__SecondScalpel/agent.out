{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjtAhD9W14NWK3pgZ2YT","type":"message","role":"assistant","content":[{"type":"text","text":"Those two files failed because the shell had stayed in the engine folder, so nothing was written. From now on I'll start each command from an absolute path. Writing the HUD and operation view again."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17801,"cache_read_input_tokens":366806,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17801},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"4a49c89b-1a16-42f2-b80b-d6606b2e67a4","timestamp":"2026-11-05T13:45:55.946Z","request_id":"req_011CgjtAguYdamVudKGhvpNi"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjtAhD9W14NWK3pgZ2YT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018y3KCeVMHPhx6VP7kNjfyX","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-061300__x488eb9/work/SecondScalpel-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-061300 && mkdir -p src/ui src/scenes && ls src/art vendor/my-3d2dge/dist/handoff/src 2>/dev/null | head -20; git -C vendor/my-3d2dge status --short | head -5\ncat > src/ui/hud.js <<'EOF'\n// The operating HUD: monitor, clock, objective, speaker, gauge and the wheel. Sparse: the patient is the screen.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst T1 = { outline: false, shadow: '#000' }, T2 = { outline: false, shadow: '#000', scale: 2 };\nconst panel = (g, x, y, w, h, a = .78) => E.ui.box(g, x, y, w, h, { bg: '#06161a', border: '#2c6a64', gradient: false, alpha: a });\nG.panel = panel;\nG.ecgValue = k => { const b = (c, w, a) => a * Math.exp(-((k - c) ** 2) / w); return b(.16, .0016, .14) - b(.27, .00018, .16) + b(.3, .00022, 1) - b(.335, .00018, .28) + b(.54, .0032, .24); };\nG.fmtClock = s => { s = Math.max(0, Math.ceil(s)); return String(s / 60 | 0).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); };\nconst HUD = G.HUD = {\n  monitor(g, S, view, x = 6, y = 6, w = 148, h = 30) { panel(g, x, y, w, h); const v = Math.round(S.v), crit = v < 30; if (S.static) { for (let i = 0; i < 130; i++) { const X = x + 2 + ((i * 7919 + (S.ht * 900 | 0) * 31) % (w - 4)), Y = y + 2 + ((i * 104729 + (S.ht * 700 | 0) * 17) % (h - 4)); px.dot(g, X, Y, i % 3 ? '#4a5a60' : '#a8b8c0'); } return; }\n    const L = w - 46, tr = view.ecg, col = S.breath ? '#a8f0ff' : crit ? '#ff6a5a' : '#40f0a0'; for (let i = 1; i < L && i < tr.length; i++) { const a = tr[tr.length - i], b = tr[tr.length - 1 - i]; px.line(g, x + L - i, y + 21 - a * 14 | 0, x + L - i - 1, y + 21 - b * 14 | 0, col, 1); }\n    const flash = crit && (S.ht * 4 | 0) % 2 === 0, num = String(v).padStart(2, '0'); font.text(g, num, x + w - 26, y + 4, flash ? '#ffffff' : col, T2); if (crit) font.text(g, 'CRITICAL', x + w - 44, y + 21, flash ? '#ff6a5a' : '#ffd0c8', { outline: false, font: 'tiny' }); },\n  clock(g, S, r) { const w = 70, x = r.W - w - 6, y = 6, low = S.clock < 20; panel(g, x, y, w, 22); font.text(g, S.lab ? '--:--' : G.fmtClock(S.clock), x + w / 2, y + 4, low && (S.ht * 3 | 0) % 2 ? '#ff7a6a' : '#e8fbf6', { outline: false, shadow: '#000', scale: 2, align: 'center' }); },\n  objective(g, S, r) { const ph = G.Op.phaseOf(S); if (!ph.obj) return; const w = font.width(ph.obj) + 16; panel(g, (r.W - w) / 2 | 0, 8, w, 16, .7); font.text(g, ph.obj, r.W / 2, 12, '#ffffff', { outline: false, shadow: '#000', align: 'center' }); },\n  speaker(g, view, r) { const b = view.bark; if (!b) return; const H = r.H, c = G.bust(b.who, b.expr || 'neutral', { maskUp: b.mask !== false, talk: (view.t * 9 | 0) % 2 && b.age < b.typed }); px.reset(g); px.rect(g, 3, H - 63, 58, 62, '#2c6a64'); g.drawImage(c, 28, 16, 56, 60, 4, H - 62, 56, 60); px.reset(g); panel(g, 62, H - 34, Math.min(r.W - 170, 264), 30, .86); font.text(g, G.CAST[b.who] ? G.CAST[b.who].name : b.who, 67, H - 31, '#5ff0e0', { outline: false }); const n = Math.min(b.text.length, (b.age || 0) * 40 | 0); font.text(g, b.text.slice(0, n), 67, H - 20, '#ffffff', { outline: false, shadow: '#000' }); },\n  gauge(g, S, r, input) { const w = 92, h = 18, x = r.W - w - 6, y = r.H - h - 4, f = S.steady / 100, gr = S.caseId === 'grandrounds', need = S.doc === 'vale' || gr ? 35 : 45, ready = S.steady >= need; panel(g, x, y, w, h); E.ui.bar(g, x + 3, y + 3, w - 6, 5, f, S.breath ? '#a8f0ff' : ready ? '#5ff0e0' : '#2c7a74'); px.rect(g, x + 3 + (w - 6) * need / 100 | 0, y + 2, 1, 7, '#fff'); const name = S.doc === 'vale' || gr ? 'Long Breath' : 'Second Look'; font.text(g, ready ? name : 'Steady', x + 3, y + 9, ready ? '#e8fbf6' : '#6a8a88', { outline: false }); if (ready && input) G.drawCap(g, input.label('gift'), x + w - G.capWidth(input.label('gift')) - 2, y - 13, { pad: input.lastDevice === 'gamepad' });\n    if (S.flow >= 3) font.text(g, 'FLOW x' + S.flow, x + 2, y - 11, S.flow >= 10 ? '#ffe08a' : '#e8fbf6', { outline: false, shadow: '#000' });\n    if (S.docs.length > 1) { font.text(g, S.doc === 'vale' ? 'DR. VALE' : 'DR. SOKOLOVA', x - 4, y + 7, '#5ff0e0', { align: 'right', outline: false, shadow: '#000' }); if (input) { const lb = input.label('consult'), wl = G.capWidth(lb); G.drawCap(g, lb, x - 4 - wl, y - 7, { pad: input.lastDevice === 'gamepad' }); } } },\n  toolTile(g, tool, x, y, on, col) { px.rect(g, x, y, 22, 22, on ? '#e8fbf6' : '#0c242a'); px.rect(g, x + 1, y + 1, 20, 20, on ? '#1c5a58' : '#102e34'); G.toolIcon(g, tool, x + 1, y + 1, on ? '#ffffff' : (col || '#8fb8b0')); },\n  wheel(g, seat, S, x, y) { const w = seat.wheel, p = S.players[seat.pid], R = 34; if (!(w.show > 0) && !w.hold) return; G.TOOLS.forEach((t, i) => { const a = i / 8 * 6.2832 - 1.5708, X = x + Math.cos(a) * R - 11 | 0, Y = y + Math.sin(a) * R - 11 | 0, on = t === p.toolNext || w.sector === i || w.hover === i; HUD.toolTile(g, t, X, Y, on); }); font.text(g, G.TOOL_NAMES[p.toolNext], x, y - 48, '#ffffff', { align: 'center', outline: false, shadow: '#000' }); },\n  tip(g, S, r, input) { const t = S.tut || S.tip; if (!t) return; const w = Math.min(320, r.W - 40), lines = font.wrap(t.text, w - 12), v = S.tut && S.tut.verb, act = t.k === 'gift' || v === 'gift' ? 'gift' : t.k === 'consult' || v === 'consult' ? 'consult' : t.k === 'fine' ? 'fine' : null, big = act && input, h = 7 + lines.length * 10 + (big ? 13 : 0), x = (r.W - w) / 2 | 0, y = 27; panel(g, x, y, w, h, .9); lines.forEach((l, i) => font.text(g, l, r.W / 2, y + 4 + i * 10, S.tut ? '#ffe08a' : '#e8fbf6', { align: 'center', outline: false, shadow: '#000' })); if (big) { const label = input.label(act), wl = G.capWidth(label); G.drawCap(g, label, r.W / 2 - wl / 2 | 0, y + h - 13, { pad: input.lastDevice === 'gamepad' }); } },\n  code(g, S, r, view) { const c = S.codeBlue, W = r.W, H = r.H; px.blend(g, .72, 'normal', () => px.rect(g, 0, 0, W, H, '#14040a')); font.text(g, 'CODE BLUE', W / 2, 30, '#ff7a6a', { align: 'center', outline: false, shadow: '#000', scale: 3 }); const y0 = H / 2 + 8, L = W - 60, per = c.per, span = per * 2; let last = 0; for (let i = 0; i < L; i++) { const tt = c.t - .5 * per + i / L * span, k = ((tt / per) % 1 + 1) % 1, v = Math.exp(-((k - .5) ** 2) / .002) * 34; if (i) px.line(g, 30 + i - 1, y0 - last | 0, 30 + i, y0 - v | 0, '#40f0a0', 1); last = v; } const mx = 30 + L * .25 | 0; px.rect(g, mx - 1, y0 - 44, 2, 58, '#ffffff'); px.rect(g, mx - 14, y0 - 46, 28, 2, '#ffe08a'); for (let i = 0; i < 4; i++) { const res = c.res[i], X = W / 2 - 36 + i * 24; px.disc(g, X, y0 + 34, 7, '#101820'); px.disc(g, X, y0 + 34, 5, res === undefined ? '#3a4a50' : res === 2 ? '#ffe08a' : res === 1 ? '#40f0a0' : '#ff5a5a'); } const inp = view.seats[0] && view.seats[0].input; if (inp) { const y1 = y0 + 50; if (inp.lastDevice === 'gamepad') { const a = inp.label('fine'), b = inp.label('useTool'), w = G.capWidth(a) + G.capWidth(b) + 14 + font.width('Shock on the peak') + 4; let x = W / 2 - w / 2 | 0; x += G.drawCap(g, a, x, y1, { pad: true }) + 3; font.text(g, '+', x, y1 + 2, '#fff', T1); x += 9; x += G.drawCap(g, b, x, y1, { pad: true }) + 4; font.text(g, 'Shock on the peak', x, y1 + 2, '#fff', T1); } else { const w = G.promptWidth(inp, 'useTool', 'Shock on the peak'); G.drawPrompt(g, inp, 'useTool', 'Shock on the peak', W / 2 - w / 2 | 0, y1); } } },\n  closing(g, S, r, view, OX, OY) { const c = S.closing, x = c.x + OX, y = c.y + OY; if (c.phase === 'ring') { const k = c.t / c.per, R = Math.max(0, 80 * (1 - k)) + 18; G.ringDraw(g, x, y, 18, '#ffffff', 28); G.ringDraw(g, x, y, R, Math.abs(1 - k) < .08 ? '#ffe08a' : '#5ff0e0', 36); font.text(g, 'Dressing', x, y - 3, '#fff', { align: 'center', outline: false, shadow: '#000' }); const inp = view.seats[0] && view.seats[0].input; if (inp) { const w = G.promptWidth(inp, 'useTool', 'On the ring'); G.drawPrompt(g, inp, 'useTool', 'On the ring', x - w / 2 | 0, y + 28); } } else { const s = Math.min(1, c.t * 5), sc = s < 1 ? 5 - s * 2 | 0 : 3, W = r.W; px.blend(g, .55, 'normal', () => px.rect(g, 0, r.H / 2 - 42, W, 76, '#061014')); font.text(g, 'CASE CLOSED', W / 2, r.H / 2 - 26, '#ff5a4a', { align: 'center', outline: false, shadow: '#3a0a0a', scale: sc }); if (s >= 1) font.text(g, 'TIME OF COMPLETION ' + G.fmtClock(S.ht), W / 2, r.H / 2 + 14, '#e8fbf6', { align: 'center', outline: false, shadow: '#000' }); } },\n};\n})();\nEOF\ncat > src/scenes/op.js <<'EOF'\n// The operation's view: reads devices (or a bot, or the network), steps the sim, turns its events into sound, particles, popups and rumble, and draws it.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E, { clamp } = G;\nconst SUSTAIN = { salve: 1, cautery: 1, suction: 1, sonar: 1 };\nconst COLD = { sloppy: '#ff9a7a', clean: '#e8fbf6', textbook: '#ffe08a' };\nconst STRAIN_OF = { bead: 'staccato', nest: 'staccato', legato: 'legato', tremolo: 'tremolo', lobe: 'dacapo', fermata: 'fermata', cantorbody: 'cantor', voicebox: 'cantor' };\nG.readDevice = (seat, game, S) => { const I = seat.input, d = seat.dev || (seat.dev = G.Cursor.emptyDevice()), swap = game.settings.swapSticks && I === game.input; const aim = swap ? I.padMove : I.padAim, mv = swap ? I.padAim : I.padMove; d.stick[0] = aim ? aim[0] : 0; d.stick[1] = aim ? aim[1] : 0; d.wheel[0] = mv ? mv[0] : 0; d.wheel[1] = mv ? mv[1] : 0;\n  d.keys[0] = (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0); d.keys[1] = (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0); d.nudge[0] = (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0); d.nudge[1] = (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0); d.fine = I.value('fine') > .3 || I.down('fine');\n  const p1 = I === game.input, usedMouse = p1 && I.lastDevice === 'mouse', ptr = usedMouse ? I.pointer() : null, OX = (game.W - 426) >> 1, OY = (game.H - 240) >> 1; d.wheelHold = p1 && I.down('wheelHold'); if (ptr) { const ux = ptr[0] - OX, uy = ptr[1] - OY; d.wheelDelta[0] = ux - (seat.mx === undefined ? ux : seat.mx); d.wheelDelta[1] = uy - (seat.my === undefined ? uy : seat.my); seat.mx = ux; seat.my = uy; d.mouse = d.wheelHold ? null : [ux, uy]; } else { d.mouse = null; d.wheelDelta[0] = d.wheelDelta[1] = 0; }\n  const tool = S.players[seat.pid] ? S.players[seat.pid].toolNext : 'forceps'; let trig = I.value('useTool'); if (I.down('useTool') && trig < .3) trig = 1; if (d.wheelHold) trig = 0;\n  if (game.settings.sustain === 'Toggle' && SUSTAIN[tool]) { if (I.pressed('useTool')) seat.toggleOn = !seat.toggleOn; trig = seat.toggleOn ? 1 : 0; } else seat.toggleOn = false; d.trig = trig; d.gift = I.pressed('gift'); d.consult = I.pressed('consult'); d.cancel = I.pressed('drop'); d.prev = I.pressed('toolPrev'); d.next = I.pressed('toolNext'); d.num = 0; for (let i = 1; i <= 8; i++) if (I.pressed('tool' + i)) d.num = i;\n  const both = I.lastDevice === 'gamepad' ? I.value('fine') > .5 && I.value('useTool') > .5 : I.down('useTool'); d.shock = both && !seat.shockHeld; seat.shockHeld = both; d.wheelPick = null; return d; };\nclass OpView {\n  constructor(game, S, o = {}) { Object.assign(this, { game, S, seats: o.seats || [], attract: !!o.attract, mirror: !!o.mirror, remote: o.remote || null, net: o.net || null }); this.popups = []; this.ecg = []; this.bark = null; this.barkCool = 0; this.t = 0; this.idle = 0; this.recent = {}; this.hintShown = null; this.lastPhase = S.phaseI; this.mu = o.music; this.wasBreath = false; for (const s of this.seats) { s.cur = s.cur || G.Cursor.create(); s.wheel = s.wheel || G.Wheel.create(); }\n    this.barkFor(G.Op.phaseOf(S).bark); S.ev = S.ev.filter(e => e[0] !== 'phase' && e[0] !== 'spawn'); }\n  get localPlayer() { const s = this.seats[0]; return s ? { x: s.cur.x, y: s.cur.y } : this.S.players[0]; }\n  say(text, who = 'quill', o = {}) { if (this.S.silent) return; this.bark = { who, text, t: 2.5 + .05 * text.length, age: 0, typed: text.length / 40, expr: o.expr, mask: o.mask }; if (!this.attract) G.babble.say(text, who); }\n  barkFor(text) { if (text) this.say(text); }\n  pool(key, vars) { const L = G.BARKS[key]; if (!L || this.barkCool > 0) return; let line, n = 0; do { line = L[Math.random() * L.length | 0]; } while (this.recent[line] && ++n < 8); this.recent[line] = 1; if (Object.keys(this.recent).length > 12) this.recent = {}; if (vars) for (const k in vars) line = line.replace('{' + k + '}', vars[k]); this.say(line); this.barkCool = 5; }\n  rumble(s, d) { if (this.attract) return; for (const q of this.seats) if (q.input && q.input.rumble) q.input.rumble(s, d); }\n  // ---- a step ----\n  update(dt) { const S = this.S, game = this.game; this.t += dt; if (this.barkCool > 0) this.barkCool -= dt; if (this.bark) { this.bark.age += dt; if (this.bark.age > this.bark.t) this.bark = null; }\n    const inputs = []; let touched = false; for (const seat of this.seats) { const p = S.players[seat.pid]; if (!p) continue; let d; if (seat.bot) d = seat.bot.update(S, p, seat.cur, dt); else { d = G.readDevice(seat, game, S); if (d.trig > 0 || Math.hypot(d.stick[0], d.stick[1]) > .2 || (d.mouse && (d.mouse[0] !== seat.lx || d.mouse[1] !== seat.ly))) touched = true; if (d.mouse) { seat.lx = d.mouse[0]; seat.ly = d.mouse[1]; } }\n      if (G.CHEATS.auto && !seat.bot && seat.autoBot) d = seat.autoBot.update(S, p, seat.cur, dt); else if (G.CHEATS.auto && !seat.bot) { seat.autoBot = new G.Bot({ speed: 330 }); }\n      G.Cursor.update(seat.cur, p, d, S, dt); const tool = G.Wheel.update(seat.wheel, p.toolNext, d, dt); inputs[seat.pid] = G.buildInput(seat.cur, tool, d); seat.lastDev = d; }\n    if (this.remote) this.remote(inputs, dt);\n    if (touched) { this.idle = 0; this.hintShown = null; } else this.idle += dt;\n    if (!this.mirror) { for (let i = 0; i < S.players.length; i++) if (!inputs[i]) inputs[i] = null; G.Op.step(S, inputs, dt); if (S.ghosts) { S.ghosts.t += dt; if (S.ghosts.t >= S.ghosts.dur) S.ghosts = null; } }\n    this.drain(); this.ambience(dt); this.popups = this.popups.filter(q => (q.t -= dt) > 0); for (const q of this.popups) q.y -= dt * 14;\n    const k = S.static ? 0 : G.ecgValue(S.sinceBeat / S.beatLen); if ((this.ecgN = (this.ecgN || 0) + 1) % 3 === 0) { this.ecg.push(k); if (this.ecg.length > 220) this.ecg.splice(0, this.ecg.length - 220); }\n    this.hint(); if (this.mu) G.music.opUpdate(S.v, S.phaseI); }\n  hint() { const S = this.S, H = S.diff.hints; if (!this.seats.length || !this.seats[0].input || S.codeBlue || S.closing || !this.game.settings.hints) { this.showHint = null; return; } const on = H === 0 || this.idle > H || (this.slipsAgo || 0) > 1; this.showHint = on ? G.Op.nextTarget(S) : null; if (this.showHint && this.idle > H && this.hintShown !== this.showHint.tool) { this.hintShown = this.showHint.tool; this.pool('idle'); } }\n  drain() { const S = this.S; if (!S.ev.length) return; const L = S.ev; S.ev = []; for (const e of L) this.present(e); if (this.net) this.net.events(L); }\n  // the sim's events become everything else: table 5.11\n  present(e) { const [k, a, b, c] = e, S = this.S, sfx = G.sfx, game = this.game, P = game.particles, OX = (game.W - 426) >> 1, OY = (game.H - 240) >> 1, X = v => v + OX, Y = v => v + OY;\n    const pop = (x, y, text, col, scale = 1) => this.popups.push({ x, y, text, col, scale, t: 1.1 }), blood = (x, y, n) => { P.bits(X(x), Y(y), 0, n, game.settings.blood === 'Clinical' ? ['#44706c', '#2c4e52'] : ['#cf2a22', '#8c0f14']); }, sparkle = (x, y, n, col) => P.glints(X(x), Y(y), 0, n, col);\n    switch (k) {\n      case 'swap': sfx.clack(); this.rumble(.15, .03); if (!this.attract && this.seats[0] && this.seats[0].pid === b && this.barkCool <= 0) G.babble.say(G.TOOL_NAMES[a] + '.', 'quill', { vol: .8 }); break;\n      case 'grip': sfx.tick(); this.rumble(.15, .04); sparkle(a, b, 3, '#ffffff'); break;\n      case 'free': this.rumble(.3, .05); blood(a, b, 4); break;\n      case 'clink': sfx.clink(); sparkle(a, b, 2, '#ffffff'); break;\n      case 'tear': sfx.rip(); blood(a, b, 10); game.freeze(.04); game.shake(2); this.rumble(.5, .1); this.pool('tear'); break;\n      case 'cutstart': sfx.tick(); break; case 'cutdone': sfx.tick(); blood(a, b, 4); break;\n      case 'needle': sfx.tick(); break; case 'stitch': sfx.twang(); this.rumble(.25, .05); sparkle(a, b, 2, '#a8d4ff'); break; case 'loose': sfx.loose(); pop(a, b, 'Loose', '#ffb0a0'); this.pool('loose'); break;\n      case 'inject': sfx.plunger(); this.rumble(.1, .1); break; case 'iv': sfx.plunger(); this.rumble(.1, .1); break;\n      case 'burned': sfx.sizzleBurst(); P.smoke(X(a), Y(b), 0, 4, { size: .5 }); break; case 'lock': sfx.sloppy(); this.pool('heat'); break;\n      case 'drained': sfx.tick(); break; case 'healed': sfx.clean(); sparkle(a, b, 6, '#b0ffe0'); break; case 'marked': sfx.pingAt(1, 1); pop(a, b - 10, 'Found', '#5ff0e0'); break;\n      case 'grade': { const g = c, t = { sloppy: 'Sloppy', clean: 'Clean', textbook: 'Textbook' }[g]; pop(a, b - 8, t, COLD[g], g === 'textbook' ? 2 : 1); if (g === 'textbook') { sfx.chime(); sparkle(a, b, 6, '#ffe08a'); this.rumble(.2, .05); if (Math.random() < .12) this.pool('textbook'); } else if (g === 'clean') sfx.clean(); else sfx.sloppy(); this.slipsAgo = 0; if (S.flow && S.flow % 10 === 0) this.pool('flow'); break; }\n      case 'slip': sfx.thud(); sfx.sigh(); game.flash('#ff2020', .08, .25); this.rumble(.6, .12); pop(a, b, c === 'nerve' ? 'NERVE!' : c === 'tear' ? 'Tear' : 'Slip', '#ff7a6a'); this.slipsAgo = (this.slipsAgo || 0) + 1; if (c === 'wire') this.pool('wrongwire'); else if (c !== 'tear') this.pool('slip'); break;\n      case 'phase': if (this.lastPhase !== a) { this.lastPhase = a; const ph = G.Op.phaseOf(S); this.barkFor(ph.bark); if (this.mu && ph.noMusic) G.music.play(null, .1); if (!this.attract) sfx.swell(); } break; case 'phasedone': sfx.chime(); this.rumble(.3, .1); break;\n      case 'beat': this.onBeat(); break; case 'tutdone': sfx.chime(); break;\n      case 'breathon': sfx.swell(); this.rumble(.4, .2); this.pool('gift'); break; case 'breathoff': sfx.tick(); break; case 'nogift': sfx.sloppy(); { const q = this.localPlayer; pop(q.x, q.y - 16, 'Not steady yet', '#ffb0a0'); } break;\n      case 'rewind': sfx.rewindFx(); this.rumble(.5, .4); game.flash('#c8e0ff', .1, .3); if (a === 0) { this.say('No. Again.', 'sokolova'); G.babble.reversed('No. Again.', 'quill'); } else if (a === 1) this.say('It took that back, Doctor.'); else this.say(\"I've seen this one.\", 'sokolova'); break;\n      case 'consult': sfx.clack(); this.say(a === 'vale' ? 'Yours, Dr. Vale.' : 'Your hands, Dr. Sokolova.'); break;\n      case 'codeblue': G.music.play('emergency', .1); sfx.alarm(); this.say('Code Blue. Paddles, Doctor.'); this.rumble(.6, .3); break; case 'codehit': sfx.whine(); sfx.bang(); game.flash('#ffffff', .14); game.shake(5); this.rumble(1, .35); this.say('Clear!', 'vale'); break; case 'codemiss': sfx.sloppy(); break; case 'revived': sfx.chime(); this.pool('revived'); G.music.play(this.mu || 'op', .3); break;\n      case 'dressing': this.say('Dressing.'); sfx.ui(); break; case 'stamp': sfx.stamp(); sfx.chord(); G.music.play(null); game.shake(3); this.rumble(.7, .25); break; case 'won': break; case 'lost': sfx.heartbeat(.5); G.music.play(null); G.music.sting('lost'); game.flash('#000000', .4, .6); break;\n      case 'tk': sfx.tk(a); break; case 'bite': sfx.bite(a); blood(a, b, 2); this.pool('bite'); break; case 'pop': sfx.tick(); sparkle(a, b, 3, '#5ff0e0'); break;\n      case 'slash': sfx.rip(); blood(a, b, 4); this.rumble(.2, .05); break; case 'surface': sfx.swell(); game.shake(2); this.rumble(.3, .2); this.say('There. Forceps, Doctor. Slowly.'); break; case 'missed': pop(a, b, 'Too soon', '#ffb0a0'); sfx.sloppy(); break; case 'snap': sfx.rip(); game.shake(3); this.say('Snapped. It has gone back under.'); break; case 'barb': sfx.tick(); this.say('Barb. Let go in the box. I clamp.'); break; case 'clamp': sfx.clack(); this.say('Clamped. Burn it.'); break; case 'slide': sfx.loose(); break; case 'split': sfx.swell(); game.shake(4); this.rumble(.7, .4); break;\n      case 'crack': sfx.swell(); game.shake(4); this.rumble(.7, .4); game.flash('#c8fff4', .1, .3); break; case 'sedate': sfx.chime(); pop(a, b - 12, 'Sedated', '#5ff0e0'); break; case 'spit': sfx.bite(a); pop(a, b - 12, 'Off the beat!', '#ff9a7a'); this.rumble(.3, .1); break; case 'wake': sfx.flare(a); pop(a, b - 12, 'Awake!', '#ff9a7a'); break; case 'tearfree': sfx.rip(); this.say('It tore free. Pin it with Forceps!'); break;\n      case 'countdown': sfx.alarm(); this.say('Ten seconds, Doctor. Then it plays again.'); break; case 'dacapo': sfx.swell(); game.shake(5); game.flash('#b8a0ff', .15, .3); this.rumble(.7, .4); this.say('From the top. Again.'); break; case 'fine': sfx.chime(); game.shake(3); break; case 'lobedead': sfx.twang(); game.shake(1); break;\n      case 'domefall': sfx.swell(); break; case 'eyehit': sfx.bang(); game.shake(3); this.rumble(.5, .2); break; case 'flee': this.say('It moved. Sonar!'); sfx.swell(); break;\n      case 'hush': this.say('Pulse... I shall read them to you, Doctor.'); G.music.play(null, .2); game.flash('#000000', .2, .5); break; case 'hushend': G.music.play('final', .5); break; case 'readout': this.barkCool = 0; this.pool('readout', { v: a }); break; case 'staticoff': sfx.beep(S.v); break;\n      case 'windup': sfx.swell(); game.shake(2); this.say('It is about to repeat us. Cut it!'); break; case 'recapcut': sfx.bang(); game.shake(3); this.rumble(.6, .25); break; case 'forced': sfx.swell(); break; case 'countered': sfx.chime(); break;\n      case 'noterise': sfx.rising(a); break; case 'silence': sfx.noteCut(); G.music.play(null, .01); G.choir.silence(); this.bark = null; break; case 'lastbeep': sfx.lastBeep(); this.say('...Doctor.'); G.music.play('piano', .1); break;\n      case 'ratchet': sfx.tick(); this.rumble(.1, .02); break; case 'boardread': sfx.pingAt(1, .5); this.say(a === 0 ? 'First: the circle. Not the triangle.' : a === 1 ? 'Second: the triangle.' : 'Third: the square.'); break; case 'wirecut': sfx.twang(); this.rumble(.3, .1); break; case 'wrongwire': sfx.alarm(); game.shake(4); break; case 'lurch': sfx.lurch(); game.shake(6); this.rumble(.9, .4); break; case 'blackout': sfx.bang(); game.flash('#000000', .3, .9); break; case 'lights': sfx.tick(); break; case 'batonrest': sfx.flare(a); break; case 'tendril': sfx.bang(); break; case 'mouths': sfx.swell(); this.say('Three mouths. Burn what sings.'); break; case 'dropit': sfx.loose(); break;\n      default: break;\n    } }\n  onBeat() { const S = this.S, sfx = G.sfx; if (S.silent) return; if (S.v < 30) { sfx.heartbeat(1.2); sfx.alarm(); this.rumble(.5, .08); this.game.after(.19, () => this.rumble(.4, .08)); if (Math.random() < .25) this.pool('low'); } else if (S.breath) sfx.heartbeat(1); else if (!S.static && !S.hush) sfx.beep(S.v); if (S.objs.some(o => o.type === 'reed' && !o.sedated)) sfx.flare(213); }\n  ambience(dt) { const S = this.S, sfx = G.sfx, c = G.choir, mode = S.silent ? 'silent' : S.hush ? 'hush' : 'normal'; sfx.setMode(mode); sfx.setSlow(S.breath); if (S.breath !== this.wasBreath) { this.wasBreath = S.breath; G.music.setThin(S.breath); }\n    let cut = 0, burn = 0, suck = 0, suckP = 400, son = null; const paused = this.game.paused, off = paused || S.done; for (const p of S.players) { if (p.cutting > 0 || (p.hold && p.hold.k === 'cut')) cut = Math.max(cut, Math.min(1, p.spd / 150)); if (p.firing) { burn = 1; if (p.hitting) this.rumble(.2, .03); } if (p.sucking) { suck = 1; suckP = 500 + (1 - Math.min(1, p.sucking / 120)) * 1800; this.rumble(.1, .03); } if (p.sonar) son = p; }\n    sfx.set('cut', { f: 4200, q: 3, v: .15 }, off ? 0 : cut, 2600 + cut * 3000); sfx.set('burn', { f: 7000, q: 1.4, v: .16 }, off ? 0 : burn * (.7 + Math.random() * .3)); sfx.set('suck', { f: 600, q: 2.4, v: .26 }, off ? 0 : suck, suckP); sfx.set('vent', { f: 1100, q: .7, v: .05 }, off || S.codeBlue ? 0 : Math.max(0, Math.sin(S.t * 1.3)));\n    let strain = null, nd = 1e9, sx = 213; const ref = son || this.localPlayer; for (const o of S.objs) if (STRAIN_OF[o.type] && !o.dead) { const d = Math.hypot(o.x - ref.x, o.y - ref.y); if (d < nd) { nd = d; strain = STRAIN_OF[o.type]; sx = o.x; } } let lvl = strain ? .5 : 0; if (son) { this.pingT = (this.pingT || 0) - dt; if (strain) lvl = clamp(1.1 - nd / 200, .3, 1.2); if (this.pingT <= 0 && son.near > 0) { this.pingT = .9 - son.near * .75; sfx.pingAt(1, son.near); } } if (S.silent || off) lvl = 0; c.update(dt, strain, lvl, (sx - 213) / 213); if (S.done) sfx.stopLoops(); }\n  // ---- the picture ----\n  draw(r) { let S = this.S; const main = this.S; if (main.rwT > 0) { const rev = G.Op.reverseOf(main); if (rev.length) { const k = 1 - main.rwT / 1.2, i = Math.max(0, rev.length - 1 - (k * rev.length | 0)); S = Object.assign({}, rev[i], { rwT: main.rwT, ghosts: null, ev: [] }); } }\n    G.drawField(r, S, this); const OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1;\n    r.overlay(g => { G.drawObjects(g, r, S, this); for (const q of this.popups) font.text(g, q.text, q.x + OX, q.y + OY, q.col, { align: 'center', outline: false, shadow: '#000', scale: q.scale }); this.drawSeats(g, r, main, OX, OY); if (main.rwT > 0) { for (let y = (this.t * 240 | 0) % 24; y < r.H; y += 24) px.blend(g, .3, 'add', () => px.rect(g, 0, y, r.W, 3, '#c0d8ff')); const yy = ((1.2 - main.rwT) / 1.2) * r.H | 0; px.rect(g, 0, yy, r.W, 2, '#ffffff'); }\n      if (main.ghosts && main.ghosts.t < main.ghosts.dur) font.text(g, 'SECOND LOOK ' + Math.ceil(main.ghosts.dur - main.ghosts.t), r.W / 2, 28, '#c8e0ff', { align: 'center', outline: false, shadow: '#000' });\n      if (main.v < 30 && !main.static) { const a = .14 + Math.sin(this.t * 6) * .05; px.blend(g, a, 'normal', () => { for (let i = 0; i < 12; i += 2) { px.rect(g, i, i, r.W - i * 2, 2, '#ff0000'); px.rect(g, i, r.H - i - 2, r.W - i * 2, 2, '#ff0000'); px.rect(g, i, i, 2, r.H - i * 2, '#ff0000'); px.rect(g, r.W - i - 2, i, 2, r.H - i * 2, '#ff0000'); } }); }\n      this.drawHud(g, r, main, OX, OY); if (this.attract) { const W = r.W, s = (this.t * 2 | 0) % 2; px.blend(g, .7, 'normal', () => px.rect(g, 0, r.H - 22, W, 22, '#06161a')); font.text(g, 'DEMO', 8, r.H - 18, '#ffe08a', { outline: false, scale: 2 }); if (s) font.text(g, 'Press any button', W - 8, r.H - 15, '#ffffff', { align: 'right', outline: false, shadow: '#000' }); } }); }\n  drawHud(g, r, S, OX, OY) { const H = G.HUD, inp = this.seats[0] && this.seats[0].input; H.monitor(g, S, this); H.clock(g, S, r); H.objective(g, S, r); H.tip(g, S, r, inp); H.speaker(g, this, r); H.gauge(g, S, r, inp); if (S.codeBlue) H.code(g, S, r, this); if (S.closing) H.closing(g, S, r, this, OX, OY); if (this.showHint && !S.closing && !S.codeBlue) this.drawHint(g, r, S, OX, OY, inp); if (S.tut && this.seats[0] && !S.codeBlue) { const n = G.Op.nextTarget(S); if (n) G.ringDraw(g, n.at[0] + OX | 0, n.at[1] + OY | 0, 10 + ((this.t * 4) % 1) * 16, '#ffe08a', 20, 2); } }\n  drawHint(g, r, S, OX, OY, inp) { const h = this.showHint, p = S.players[this.seats[0].pid], x = h.at[0] + OX | 0, y = h.at[1] + OY | 0; if ((this.t * 3 | 0) % 2) G.ringDraw(g, x, y, 14 + Math.sin(this.t * 5) * 2, '#ffe08a', 16, 2); if (p.toolNext !== h.tool) { const X = r.W - 110, Y = r.H - 62; G.HUD.toolTile(g, h.tool, X, Y, true); font.text(g, G.TOOL_NAMES[h.tool], X + 26, Y + 2, '#ffe08a', { outline: false, shadow: '#000' }); const num = G.TOOLS.indexOf(h.tool); if (inp) font.text(g, inp.lastDevice === 'gamepad' ? 'L stick ' + ['↑', '↗', '→', '↘', '↓', '↙', '←', '↖'][num] : 'Key ' + (num + 1), X + 26, Y + 12, '#e8fbf6', { outline: false, shadow: '#000' }); } }\n  drawSeats(g, r, S, OX, OY) { const all = []; for (const seat of this.seats) { const p = S.players[seat.pid]; if (p) all.push({ x: seat.cur.x + seat.cur.jx, y: seat.cur.y + seat.cur.jy, p, seat }); } for (const p of S.players) if (!p.gone && !this.seats.some(s => s.pid === p.id)) all.push({ x: p.x, y: p.y, p, seat: null });\n    const main = this.seats[0]; if (main && main.input && main.cur.fineT > .15 && !S.codeBlue) this.drawLoupe(g, main.cur.x + OX, main.cur.y + OY);\n    for (const c of all) { const x = c.x + OX | 0, y = c.y + OY | 0, p = c.p, st = { closed: !!p.hold || p.trigPrev >= .3, down: p.trigPrev >= .3, fill: p.fill, heat: p.heat, locked: p.lockT > 0 };\n      if (p.sonar) { const R = 38 * (S.doc === 'vale' ? 1.25 : 1); G.ringDraw(g, x, y, R, '#88e8ff', 36); const n = (this.t * 1.5) % 1; G.ringDraw(g, x, y, R * n, '#3a7aa0', 28, 2); if (p.near > .1) for (let i = 0; i < 3; i++) G.ringDraw(g, x, y, 6 + i * 5 + n * 5, '#88e8ff', 12, 3); }\n      if (p.firing && !(p.lockT > 0)) { px.blend(g, .6, 'add', () => px.disc(g, x, y, 4 + Math.random() * 2, '#ffb060')); if (Math.random() < .3) this.game.particles.sparks(x, y, 0, 1, Math.random() * 6.28); }\n      if (p.hold && p.tension > 0) { const f = clamp(p.tension, 0, 1); px.rect(g, x - 34, y - 10, 3, 24, '#102028'); px.rect(g, x - 34, y + 14 - (24 * f | 0), 3, 24 * f | 0, f > .85 ? '#ff5a4a' : f > .6 ? '#ffc060' : '#5ff0e0'); }\n      if (p.hold && p.hold.k === 'stitch') { const o = G.getObj(S, p.hold.id); if (o) { const q = G.stPts(o, S, p.hold.i), sx = (p.hold.flip ? q[2] : q[0]) + OX, sy = (p.hold.flip ? q[3] : q[1]) + OY, tx = (p.hold.flip ? q[0] : q[2]) + OX, ty = (p.hold.flip ? q[1] : q[3]) + OY; px.line(g, sx | 0, sy | 0, x, y, '#5aa8ff', 1); G.ringDraw(g, tx | 0, ty | 0, 6, '#ffffff', 12); } }\n      if (p.heat > .05 && p.toolNext === 'cautery') { px.rect(g, x + 14, y - 12, 18, 3, '#102028'); px.rect(g, x + 14, y - 12, 18 * p.heat | 0, 3, p.heat > .8 ? '#ff5a4a' : '#ff9a3a'); }\n      G.drawInstrument(g, p.toolNext || p.tool, x, y, st, S.N > 1 ? p.color : '#8cc8d8', this.t);\n      if (S.N > 1) font.text(g, (p.name || ('P' + (p.id + 1))).slice(0, 8), x + 10, y + 30, p.color, { outline: false, shadow: '#000' });\n      if (c.seat) { G.HUD.wheel(g, c.seat, S, x, y); if (c.seat.input && !p.hold && !S.closing && !S.codeBlue && !(c.seat.wheel.show > 0)) { let best = null, bd = 16; for (const q of G.Op.targets(S, p.toolNext)) { const d = Math.hypot(q.at[0] - c.x, q.at[1] - c.y); if (d < bd) { bd = d; best = q; } } if (best) { const inp = c.seat.input, wt = G.promptWidth(inp, 'useTool', best.verb || 'Use'), fx = x + 16 + wt > r.W ? x - wt - 8 : x + 16, fy = y - 18 < 2 ? y + 34 : y - 18; G.drawPrompt(g, inp, 'useTool', best.verb || 'Use', fx, fy); } } } } }\n  drawLoupe(g, x, y) { const R = 34, cv = g.canvas; if (!cv) return; x |= 0; y |= 0; px.reset(g); const sm = g.imageSmoothingEnabled; g.imageSmoothingEnabled = false; for (let dy = -R; dy < R; dy += 2) { const a = Math.sqrt(R * R - dy * dy) | 0; if (a > 0) g.drawImage(cv, x - (a >> 1), y + (dy >> 1), a, 1, x - a, y + dy, a * 2, 2); } g.imageSmoothingEnabled = sm; px.reset(g); G.ringDraw(g, x, y, R, '#e8fbf6', 36); }\n}\nG.OpView = OpView;\n})();\nEOF\nwc -l src/ui/hud.js src/scenes/op.js","description":"Write HUD and operation view using absolute paths"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17801,"cache_read_input_tokens":366806,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17801},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"b62654f1-e9e4-4e05-ab50-89a060bd2947","timestamp":"2026-11-05T13:47:44.557Z","request_id":"req_011CgjtAguYdamVudKGhvpNi","wire_tool_inputs":{"toolu_018y3KCeVMHPhx6VP7kNjfyX":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-061300__x488eb9/work/SecondScalpel-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-061300 && mkdir -p src/ui src/scenes && ls src/art vendor/my-3d2dge/dist/handoff/src 2>/dev/null | head -20; git -C vendor/my-3d2dge status --short | head -5\ncat > src/ui/hud.js <<'EOF'\n// The operating HUD: monitor, clock, objective, speaker, gauge and the wheel. Sparse: the patient is the screen.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst T1 = { outline: false, shadow: '#000' }, T2 = { outline: false, shadow: '#000', scale: 2 };\nconst panel = (g, x, y, w, h, a = .78) => E.ui.box(g, x, y, w, h, { bg: '#06161a', border: '#2c6a64', gradient: false, alpha: a });\nG.panel = panel;\nG.ecgValue = k => { const b = (c, w, a) => a * Math.exp(-((k - c) ** 2) / w); return b(.16, .0016, .14) - b(.27, .00018, .16) + b(.3, .00022, 1) - b(.335, .00018, .28) + b(.54, .0032, .24); };\nG.fmtClock = s => { s = Math.max(0, Math.ceil(s)); return String(s / 60 | 0).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); };\nconst HUD = G.HUD = {\n  monitor(g, S, view, x = 6, y = 6, w = 148, h = 30) { panel(g, x, y, w, h); const v = Math.round(S.v), crit = v < 30; if (S.static) { for (let i = 0; i < 130; i++) { const X = x + 2 + ((i * 7919 + (S.ht * 900 | 0) * 31) % (w - 4)), Y = y + 2 + ((i * 104729 + (S.ht * 700 | 0) * 17) % (h - 4)); px.dot(g, X, Y, i % 3 ? '#4a5a60' : '#a8b8c0'); } return; }\n    const L = w - 46, tr = view.ecg, col = S.breath ? '#a8f0ff' : crit ? '#ff6a5a' : '#40f0a0'; for (let i = 1; i < L && i < tr.length; i++) { const a = tr[tr.length - i], b = tr[tr.length - 1 - i]; px.line(g, x + L - i, y + 21 - a * 14 | 0, x + L - i - 1, y + 21 - b * 14 | 0, col, 1); }\n    const flash = crit && (S.ht * 4 | 0) % 2 === 0, num = String(v).padStart(2, '0'); font.text(g, num, x + w - 26, y + 4, flash ? '#ffffff' : col, T2); if (crit) font.text(g, 'CRITICAL', x + w - 44, y + 21, flash ? '#ff6a5a' : '#ffd0c8', { outline: false, font: 'tiny' }); },\n  clock(g, S, r) { const w = 70, x = r.W - w - 6, y = 6, low = S.clock < 20; panel(g, x, y, w, 22); font.text(g, S.lab ? '--:--' : G.fmtClock(S.clock), x + w / 2, y + 4, low && (S.ht * 3 | 0) % 2 ? '#ff7a6a' : '#e8fbf6', { outline: false, shadow: '#000', scale: 2, align: 'center' }); },\n  objective(g, S, r) { const ph = G.Op.phaseOf(S); if (!ph.obj) return; const w = font.width(ph.obj) + 16; panel(g, (r.W - w) / 2 | 0, 8, w, 16, .7); font.text(g, ph.obj, r.W / 2, 12, '#ffffff', { outline: false, shadow: '#000', align: 'center' }); },\n  speaker(g, view, r) { const b = view.bark; if (!b) return; const H = r.H, c = G.bust(b.who, b.expr || 'neutral', { maskUp: b.mask !== false, talk: (view.t * 9 | 0) % 2 && b.age < b.typed }); px.reset(g); px.rect(g, 3, H - 63, 58, 62, '#2c6a64'); g.drawImage(c, 28, 16, 56, 60, 4, H - 62, 56, 60); px.reset(g); panel(g, 62, H - 34, Math.min(r.W - 170, 264), 30, .86); font.text(g, G.CAST[b.who] ? G.CAST[b.who].name : b.who, 67, H - 31, '#5ff0e0', { outline: false }); const n = Math.min(b.text.length, (b.age || 0) * 40 | 0); font.text(g, b.text.slice(0, n), 67, H - 20, '#ffffff', { outline: false, shadow: '#000' }); },\n  gauge(g, S, r, input) { const w = 92, h = 18, x = r.W - w - 6, y = r.H - h - 4, f = S.steady / 100, gr = S.caseId === 'grandrounds', need = S.doc === 'vale' || gr ? 35 : 45, ready = S.steady >= need; panel(g, x, y, w, h); E.ui.bar(g, x + 3, y + 3, w - 6, 5, f, S.breath ? '#a8f0ff' : ready ? '#5ff0e0' : '#2c7a74'); px.rect(g, x + 3 + (w - 6) * need / 100 | 0, y + 2, 1, 7, '#fff'); const name = S.doc === 'vale' || gr ? 'Long Breath' : 'Second Look'; font.text(g, ready ? name : 'Steady', x + 3, y + 9, ready ? '#e8fbf6' : '#6a8a88', { outline: false }); if (ready && input) G.drawCap(g, input.label('gift'), x + w - G.capWidth(input.label('gift')) - 2, y - 13, { pad: input.lastDevice === 'gamepad' });\n    if (S.flow >= 3) font.text(g, 'FLOW x' + S.flow, x + 2, y - 11, S.flow >= 10 ? '#ffe08a' : '#e8fbf6', { outline: false, shadow: '#000' });\n    if (S.docs.length > 1) { font.text(g, S.doc === 'vale' ? 'DR. VALE' : 'DR. SOKOLOVA', x - 4, y + 7, '#5ff0e0', { align: 'right', outline: false, shadow: '#000' }); if (input) { const lb = input.label('consult'), wl = G.capWidth(lb); G.drawCap(g, lb, x - 4 - wl, y - 7, { pad: input.lastDevice === 'gamepad' }); } } },\n  toolTile(g, tool, x, y, on, col) { px.rect(g, x, y, 22, 22, on ? '#e8fbf6' : '#0c242a'); px.rect(g, x + 1, y + 1, 20, 20, on ? '#1c5a58' : '#102e34'); G.toolIcon(g, tool, x + 1, y + 1, on ? '#ffffff' : (col || '#8fb8b0')); },\n  wheel(g, seat, S, x, y) { const w = seat.wheel, p = S.players[seat.pid], R = 34; if (!(w.show > 0) && !w.hold) return; G.TOOLS.forEach((t, i) => { const a = i / 8 * 6.2832 - 1.5708, X = x + Math.cos(a) * R - 11 | 0, Y = y + Math.sin(a) * R - 11 | 0, on = t === p.toolNext || w.sector === i || w.hover === i; HUD.toolTile(g, t, X, Y, on); }); font.text(g, G.TOOL_NAMES[p.toolNext], x, y - 48, '#ffffff', { align: 'center', outline: false, shadow: '#000' }); },\n  tip(g, S, r, input) { const t = S.tut || S.tip; if (!t) return; const w = Math.min(320, r.W - 40), lines = font.wrap(t.text, w - 12), v = S.tut && S.tut.verb, act = t.k === 'gift' || v === 'gift' ? 'gift' : t.k === 'consult' || v === 'consult' ? 'consult' : t.k === 'fine' ? 'fine' : null, big = act && input, h = 7 + lines.length * 10 + (big ? 13 : 0), x = (r.W - w) / 2 | 0, y = 27; panel(g, x, y, w, h, .9); lines.forEach((l, i) => font.text(g, l, r.W / 2, y + 4 + i * 10, S.tut ? '#ffe08a' : '#e8fbf6', { align: 'center', outline: false, shadow: '#000' })); if (big) { const label = input.label(act), wl = G.capWidth(label); G.drawCap(g, label, r.W / 2 - wl / 2 | 0, y + h - 13, { pad: input.lastDevice === 'gamepad' }); } },\n  code(g, S, r, view) { const c = S.codeBlue, W = r.W, H = r.H; px.blend(g, .72, 'normal', () => px.rect(g, 0, 0, W, H, '#14040a')); font.text(g, 'CODE BLUE', W / 2, 30, '#ff7a6a', { align: 'center', outline: false, shadow: '#000', scale: 3 }); const y0 = H / 2 + 8, L = W - 60, per = c.per, span = per * 2; let last = 0; for (let i = 0; i < L; i++) { const tt = c.t - .5 * per + i / L * span, k = ((tt / per) % 1 + 1) % 1, v = Math.exp(-((k - .5) ** 2) / .002) * 34; if (i) px.line(g, 30 + i - 1, y0 - last | 0, 30 + i, y0 - v | 0, '#40f0a0', 1); last = v; } const mx = 30 + L * .25 | 0; px.rect(g, mx - 1, y0 - 44, 2, 58, '#ffffff'); px.rect(g, mx - 14, y0 - 46, 28, 2, '#ffe08a'); for (let i = 0; i < 4; i++) { const res = c.res[i], X = W / 2 - 36 + i * 24; px.disc(g, X, y0 + 34, 7, '#101820'); px.disc(g, X, y0 + 34, 5, res === undefined ? '#3a4a50' : res === 2 ? '#ffe08a' : res === 1 ? '#40f0a0' : '#ff5a5a'); } const inp = view.seats[0] && view.seats[0].input; if (inp) { const y1 = y0 + 50; if (inp.lastDevice === 'gamepad') { const a = inp.label('fine'), b = inp.label('useTool'), w = G.capWidth(a) + G.capWidth(b) + 14 + font.width('Shock on the peak') + 4; let x = W / 2 - w / 2 | 0; x += G.drawCap(g, a, x, y1, { pad: true }) + 3; font.text(g, '+', x, y1 + 2, '#fff', T1); x += 9; x += G.drawCap(g, b, x, y1, { pad: true }) + 4; font.text(g, 'Shock on the peak', x, y1 + 2, '#fff', T1); } else { const w = G.promptWidth(inp, 'useTool', 'Shock on the peak'); G.drawPrompt(g, inp, 'useTool', 'Shock on the peak', W / 2 - w / 2 | 0, y1); } } },\n  closing(g, S, r, view, OX, OY) { const c = S.closing, x = c.x + OX, y = c.y + OY; if (c.phase === 'ring') { const k = c.t / c.per, R = Math.max(0, 80 * (1 - k)) + 18; G.ringDraw(g, x, y, 18, '#ffffff', 28); G.ringDraw(g, x, y, R, Math.abs(1 - k) < .08 ? '#ffe08a' : '#5ff0e0', 36); font.text(g, 'Dressing', x, y - 3, '#fff', { align: 'center', outline: false, shadow: '#000' }); const inp = view.seats[0] && view.seats[0].input; if (inp) { const w = G.promptWidth(inp, 'useTool', 'On the ring'); G.drawPrompt(g, inp, 'useTool', 'On the ring', x - w / 2 | 0, y + 28); } } else { const s = Math.min(1, c.t * 5), sc = s < 1 ? 5 - s * 2 | 0 : 3, W = r.W; px.blend(g, .55, 'normal', () => px.rect(g, 0, r.H / 2 - 42, W, 76, '#061014')); font.text(g, 'CASE CLOSED', W / 2, r.H / 2 - 26, '#ff5a4a', { align: 'center', outline: false, shadow: '#3a0a0a', scale: sc }); if (s >= 1) font.text(g, 'TIME OF COMPLETION ' + G.fmtClock(S.ht), W / 2, r.H / 2 + 14, '#e8fbf6', { align: 'center', outline: false, shadow: '#000' }); } },\n};\n})();\nEOF\ncat > src/scenes/op.js <<'EOF'\n// The operation's view: reads devices (or a bot, or the network), steps the sim, turns its events into sound, particles, popups and rumble, and draws it.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E, { clamp } = G;\nconst SUSTAIN = { salve: 1, cautery: 1, suction: 1, sonar: 1 };\nconst COLD = { sloppy: '#ff9a7a', clean: '#e8fbf6', textbook: '#ffe08a' };\nconst STRAIN_OF = { bead: 'staccato', nest: 'staccato', legato: 'legato', tremolo: 'tremolo', lobe: 'dacapo', fermata: 'fermata', cantorbody: 'cantor', voicebox: 'cantor' };\nG.readDevice = (seat, game, S) => { const I = seat.input, d = seat.dev || (seat.dev = G.Cursor.emptyDevice()), swap = game.settings.swapSticks && I === game.input; const aim = swap ? I.padMove : I.padAim, mv = swap ? I.padAim : I.padMove; d.stick[0] = aim ? aim[0] : 0; d.stick[1] = aim ? aim[1] : 0; d.wheel[0] = mv ? mv[0] : 0; d.wheel[1] = mv ? mv[1] : 0;\n  d.keys[0] = (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0); d.keys[1] = (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0); d.nudge[0] = (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0); d.nudge[1] = (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0); d.fine = I.value('fine') > .3 || I.down('fine');\n  const p1 = I === game.input, usedMouse = p1 && I.lastDevice === 'mouse', ptr = usedMouse ? I.pointer() : null, OX = (game.W - 426) >> 1, OY = (game.H - 240) >> 1; d.wheelHold = p1 && I.down('wheelHold'); if (ptr) { const ux = ptr[0] - OX, uy = ptr[1] - OY; d.wheelDelta[0] = ux - (seat.mx === undefined ? ux : seat.mx); d.wheelDelta[1] = uy - (seat.my === undefined ? uy : seat.my); seat.mx = ux; seat.my = uy; d.mouse = d.wheelHold ? null : [ux, uy]; } else { d.mouse = null; d.wheelDelta[0] = d.wheelDelta[1] = 0; }\n  const tool = S.players[seat.pid] ? S.players[seat.pid].toolNext : 'forceps'; let trig = I.value('useTool'); if (I.down('useTool') && trig < .3) trig = 1; if (d.wheelHold) trig = 0;\n  if (game.settings.sustain === 'Toggle' && SUSTAIN[tool]) { if (I.pressed('useTool')) seat.toggleOn = !seat.toggleOn; trig = seat.toggleOn ? 1 : 0; } else seat.toggleOn = false; d.trig = trig; d.gift = I.pressed('gift'); d.consult = I.pressed('consult'); d.cancel = I.pressed('drop'); d.prev = I.pressed('toolPrev'); d.next = I.pressed('toolNext'); d.num = 0; for (let i = 1; i <= 8; i++) if (I.pressed('tool' + i)) d.num = i;\n  const both = I.lastDevice === 'gamepad' ? I.value('fine') > .5 && I.value('useTool') > .5 : I.down('useTool'); d.shock = both && !seat.shockHeld; seat.shockHeld = both; d.wheelPick = null; return d; };\nclass OpView {\n  constructor(game, S, o = {}) { Object.assign(this, { game, S, seats: o.seats || [], attract: !!o.attract, mirror: !!o.mirror, remote: o.remote || null, net: o.net || null }); this.popups = []; this.ecg = []; this.bark = null; this.barkCool = 0; this.t = 0; this.idle = 0; this.recent = {}; this.hintShown = null; this.lastPhase = S.phaseI; this.mu = o.music; this.wasBreath = false; for (const s of this.seats) { s.cur = s.cur || G.Cursor.create(); s.wheel = s.wheel || G.Wheel.create(); }\n    this.barkFor(G.Op.phaseOf(S).bark); S.ev = S.ev.filter(e => e[0] !== 'phase' && e[0] !== 'spawn'); }\n  get localPlayer() { const s = this.seats[0]; return s ? { x: s.cur.x, y: s.cur.y } : this.S.players[0]; }\n  say(text, who = 'quill', o = {}) { if (this.S.silent) return; this.bark = { who, text, t: 2.5 + .05 * text.length, age: 0, typed: text.length / 40, expr: o.expr, mask: o.mask }; if (!this.attract) G.babble.say(text, who); }\n  barkFor(text) { if (text) this.say(text); }\n  pool(key, vars) { const L = G.BARKS[key]; if (!L || this.barkCool > 0) return; let line, n = 0; do { line = L[Math.random() * L.length | 0]; } while (this.recent[line] && ++n < 8); this.recent[line] = 1; if (Object.keys(this.recent).length > 12) this.recent = {}; if (vars) for (const k in vars) line = line.replace('{' + k + '}', vars[k]); this.say(line); this.barkCool = 5; }\n  rumble(s, d) { if (this.attract) return; for (const q of this.seats) if (q.input && q.input.rumble) q.input.rumble(s, d); }\n  // ---- a step ----\n  update(dt) { const S = this.S, game = this.game; this.t += dt; if (this.barkCool > 0) this.barkCool -= dt; if (this.bark) { this.bark.age += dt; if (this.bark.age > this.bark.t) this.bark = null; }\n    const inputs = []; let touched = false; for (const seat of this.seats) { const p = S.players[seat.pid]; if (!p) continue; let d; if (seat.bot) d = seat.bot.update(S, p, seat.cur, dt); else { d = G.readDevice(seat, game, S); if (d.trig > 0 || Math.hypot(d.stick[0], d.stick[1]) > .2 || (d.mouse && (d.mouse[0] !== seat.lx || d.mouse[1] !== seat.ly))) touched = true; if (d.mouse) { seat.lx = d.mouse[0]; seat.ly = d.mouse[1]; } }\n      if (G.CHEATS.auto && !seat.bot && seat.autoBot) d = seat.autoBot.update(S, p, seat.cur, dt); else if (G.CHEATS.auto && !seat.bot) { seat.autoBot = new G.Bot({ speed: 330 }); }\n      G.Cursor.update(seat.cur, p, d, S, dt); const tool = G.Wheel.update(seat.wheel, p.toolNext, d, dt); inputs[seat.pid] = G.buildInput(seat.cur, tool, d); seat.lastDev = d; }\n    if (this.remote) this.remote(inputs, dt);\n    if (touched) { this.idle = 0; this.hintShown = null; } else this.idle += dt;\n    if (!this.mirror) { for (let i = 0; i < S.players.length; i++) if (!inputs[i]) inputs[i] = null; G.Op.step(S, inputs, dt); if (S.ghosts) { S.ghosts.t += dt; if (S.ghosts.t >= S.ghosts.dur) S.ghosts = null; } }\n    this.drain(); this.ambience(dt); this.popups = this.popups.filter(q => (q.t -= dt) > 0); for (const q of this.popups) q.y -= dt * 14;\n    const k = S.static ? 0 : G.ecgValue(S.sinceBeat / S.beatLen); if ((this.ecgN = (this.ecgN || 0) + 1) % 3 === 0) { this.ecg.push(k); if (this.ecg.length > 220) this.ecg.splice(0, this.ecg.length - 220); }\n    this.hint(); if (this.mu) G.music.opUpdate(S.v, S.phaseI); }\n  hint() { const S = this.S, H = S.diff.hints; if (!this.seats.length || !this.seats[0].input || S.codeBlue || S.closing || !this.game.settings.hints) { this.showHint = null; return; } const on = H === 0 || this.idle > H || (this.slipsAgo || 0) > 1; this.showHint = on ? G.Op.nextTarget(S) : null; if (this.showHint && this.idle > H && this.hintShown !== this.showHint.tool) { this.hintShown = this.showHint.tool; this.pool('idle'); } }\n  drain() { const S = this.S; if (!S.ev.length) return; const L = S.ev; S.ev = []; for (const e of L) this.present(e); if (this.net) this.net.events(L); }\n  // the sim's events become everything else: table 5.11\n  present(e) { const [k, a, b, c] = e, S = this.S, sfx = G.sfx, game = this.game, P = game.particles, OX = (game.W - 426) >> 1, OY = (game.H - 240) >> 1, X = v => v + OX, Y = v => v + OY;\n    const pop = (x, y, text, col, scale = 1) => this.popups.push({ x, y, text, col, scale, t: 1.1 }), blood = (x, y, n) => { P.bits(X(x), Y(y), 0, n, game.settings.blood === 'Clinical' ? ['#44706c', '#2c4e52'] : ['#cf2a22', '#8c0f14']); }, sparkle = (x, y, n, col) => P.glints(X(x), Y(y), 0, n, col);\n    switch (k) {\n      case 'swap': sfx.clack(); this.rumble(.15, .03); if (!this.attract && this.seats[0] && this.seats[0].pid === b && this.barkCool <= 0) G.babble.say(G.TOOL_NAMES[a] + '.', 'quill', { vol: .8 }); break;\n      case 'grip': sfx.tick(); this.rumble(.15, .04); sparkle(a, b, 3, '#ffffff'); break;\n      case 'free': this.rumble(.3, .05); blood(a, b, 4); break;\n      case 'clink': sfx.clink(); sparkle(a, b, 2, '#ffffff'); break;\n      case 'tear': sfx.rip(); blood(a, b, 10); game.freeze(.04); game.shake(2); this.rumble(.5, .1); this.pool('tear'); break;\n      case 'cutstart': sfx.tick(); break; case 'cutdone': sfx.tick(); blood(a, b, 4); break;\n      case 'needle': sfx.tick(); break; case 'stitch': sfx.twang(); this.rumble(.25, .05); sparkle(a, b, 2, '#a8d4ff'); break; case 'loose': sfx.loose(); pop(a, b, 'Loose', '#ffb0a0'); this.pool('loose'); break;\n      case 'inject': sfx.plunger(); this.rumble(.1, .1); break; case 'iv': sfx.plunger(); this.rumble(.1, .1); break;\n      case 'burned': sfx.sizzleBurst(); P.smoke(X(a), Y(b), 0, 4, { size: .5 }); break; case 'lock': sfx.sloppy(); this.pool('heat'); break;\n      case 'drained': sfx.tick(); break; case 'healed': sfx.clean(); sparkle(a, b, 6, '#b0ffe0'); break; case 'marked': sfx.pingAt(1, 1); pop(a, b - 10, 'Found', '#5ff0e0'); break;\n      case 'grade': { const g = c, t = { sloppy: 'Sloppy', clean: 'Clean', textbook: 'Textbook' }[g]; pop(a, b - 8, t, COLD[g], g === 'textbook' ? 2 : 1); if (g === 'textbook') { sfx.chime(); sparkle(a, b, 6, '#ffe08a'); this.rumble(.2, .05); if (Math.random() < .12) this.pool('textbook'); } else if (g === 'clean') sfx.clean(); else sfx.sloppy(); this.slipsAgo = 0; if (S.flow && S.flow % 10 === 0) this.pool('flow'); break; }\n      case 'slip': sfx.thud(); sfx.sigh(); game.flash('#ff2020', .08, .25); this.rumble(.6, .12); pop(a, b, c === 'nerve' ? 'NERVE!' : c === 'tear' ? 'Tear' : 'Slip', '#ff7a6a'); this.slipsAgo = (this.slipsAgo || 0) + 1; if (c === 'wire') this.pool('wrongwire'); else if (c !== 'tear') this.pool('slip'); break;\n      case 'phase': if (this.lastPhase !== a) { this.lastPhase = a; const ph = G.Op.phaseOf(S); this.barkFor(ph.bark); if (this.mu && ph.noMusic) G.music.play(null, .1); if (!this.attract) sfx.swell(); } break; case 'phasedone': sfx.chime(); this.rumble(.3, .1); break;\n      case 'beat': this.onBeat(); break; case 'tutdone': sfx.chime(); break;\n      case 'breathon': sfx.swell(); this.rumble(.4, .2); this.pool('gift'); break; case 'breathoff': sfx.tick(); break; case 'nogift': sfx.sloppy(); { const q = this.localPlayer; pop(q.x, q.y - 16, 'Not steady yet', '#ffb0a0'); } break;\n      case 'rewind': sfx.rewindFx(); this.rumble(.5, .4); game.flash('#c8e0ff', .1, .3); if (a === 0) { this.say('No. Again.', 'sokolova'); G.babble.reversed('No. Again.', 'quill'); } else if (a === 1) this.say('It took that back, Doctor.'); else this.say(\"I've seen this one.\", 'sokolova'); break;\n      case 'consult': sfx.clack(); this.say(a === 'vale' ? 'Yours, Dr. Vale.' : 'Your hands, Dr. Sokolova.'); break;\n      case 'codeblue': G.music.play('emergency', .1); sfx.alarm(); this.say('Code Blue. Paddles, Doctor.'); this.rumble(.6, .3); break; case 'codehit': sfx.whine(); sfx.bang(); game.flash('#ffffff', .14); game.shake(5); this.rumble(1, .35); this.say('Clear!', 'vale'); break; case 'codemiss': sfx.sloppy(); break; case 'revived': sfx.chime(); this.pool('revived'); G.music.play(this.mu || 'op', .3); break;\n      case 'dressing': this.say('Dressing.'); sfx.ui(); break; case 'stamp': sfx.stamp(); sfx.chord(); G.music.play(null); game.shake(3); this.rumble(.7, .25); break; case 'won': break; case 'lost': sfx.heartbeat(.5); G.music.play(null); G.music.sting('lost'); game.flash('#000000', .4, .6); break;\n      case 'tk': sfx.tk(a); break; case 'bite': sfx.bite(a); blood(a, b, 2); this.pool('bite'); break; case 'pop': sfx.tick(); sparkle(a, b, 3, '#5ff0e0'); break;\n      case 'slash': sfx.rip(); blood(a, b, 4); this.rumble(.2, .05); break; case 'surface': sfx.swell(); game.shake(2); this.rumble(.3, .2); this.say('There. Forceps, Doctor. Slowly.'); break; case 'missed': pop(a, b, 'Too soon', '#ffb0a0'); sfx.sloppy(); break; case 'snap': sfx.rip(); game.shake(3); this.say('Snapped. It has gone back under.'); break; case 'barb': sfx.tick(); this.say('Barb. Let go in the box. I clamp.'); break; case 'clamp': sfx.clack(); this.say('Clamped. Burn it.'); break; case 'slide': sfx.loose(); break; case 'split': sfx.swell(); game.shake(4); this.rumble(.7, .4); break;\n      case 'crack': sfx.swell(); game.shake(4); this.rumble(.7, .4); game.flash('#c8fff4', .1, .3); break; case 'sedate': sfx.chime(); pop(a, b - 12, 'Sedated', '#5ff0e0'); break; case 'spit': sfx.bite(a); pop(a, b - 12, 'Off the beat!', '#ff9a7a'); this.rumble(.3, .1); break; case 'wake': sfx.flare(a); pop(a, b - 12, 'Awake!', '#ff9a7a'); break; case 'tearfree': sfx.rip(); this.say('It tore free. Pin it with Forceps!'); break;\n      case 'countdown': sfx.alarm(); this.say('Ten seconds, Doctor. Then it plays again.'); break; case 'dacapo': sfx.swell(); game.shake(5); game.flash('#b8a0ff', .15, .3); this.rumble(.7, .4); this.say('From the top. Again.'); break; case 'fine': sfx.chime(); game.shake(3); break; case 'lobedead': sfx.twang(); game.shake(1); break;\n      case 'domefall': sfx.swell(); break; case 'eyehit': sfx.bang(); game.shake(3); this.rumble(.5, .2); break; case 'flee': this.say('It moved. Sonar!'); sfx.swell(); break;\n      case 'hush': this.say('Pulse... I shall read them to you, Doctor.'); G.music.play(null, .2); game.flash('#000000', .2, .5); break; case 'hushend': G.music.play('final', .5); break; case 'readout': this.barkCool = 0; this.pool('readout', { v: a }); break; case 'staticoff': sfx.beep(S.v); break;\n      case 'windup': sfx.swell(); game.shake(2); this.say('It is about to repeat us. Cut it!'); break; case 'recapcut': sfx.bang(); game.shake(3); this.rumble(.6, .25); break; case 'forced': sfx.swell(); break; case 'countered': sfx.chime(); break;\n      case 'noterise': sfx.rising(a); break; case 'silence': sfx.noteCut(); G.music.play(null, .01); G.choir.silence(); this.bark = null; break; case 'lastbeep': sfx.lastBeep(); this.say('...Doctor.'); G.music.play('piano', .1); break;\n      case 'ratchet': sfx.tick(); this.rumble(.1, .02); break; case 'boardread': sfx.pingAt(1, .5); this.say(a === 0 ? 'First: the circle. Not the triangle.' : a === 1 ? 'Second: the triangle.' : 'Third: the square.'); break; case 'wirecut': sfx.twang(); this.rumble(.3, .1); break; case 'wrongwire': sfx.alarm(); game.shake(4); break; case 'lurch': sfx.lurch(); game.shake(6); this.rumble(.9, .4); break; case 'blackout': sfx.bang(); game.flash('#000000', .3, .9); break; case 'lights': sfx.tick(); break; case 'batonrest': sfx.flare(a); break; case 'tendril': sfx.bang(); break; case 'mouths': sfx.swell(); this.say('Three mouths. Burn what sings.'); break; case 'dropit': sfx.loose(); break;\n      default: break;\n    } }\n  onBeat() { const S = this.S, sfx = G.sfx; if (S.silent) return; if (S.v < 30) { sfx.heartbeat(1.2); sfx.alarm(); this.rumble(.5, .08); this.game.after(.19, () => this.rumble(.4, .08)); if (Math.random() < .25) this.pool('low'); } else if (S.breath) sfx.heartbeat(1); else if (!S.static && !S.hush) sfx.beep(S.v); if (S.objs.some(o => o.type === 'reed' && !o.sedated)) sfx.flare(213); }\n  ambience(dt) { const S = this.S, sfx = G.sfx, c = G.choir, mode = S.silent ? 'silent' : S.hush ? 'hush' : 'normal'; sfx.setMode(mode); sfx.setSlow(S.breath); if (S.breath !== this.wasBreath) { this.wasBreath = S.breath; G.music.setThin(S.breath); }\n    let cut = 0, burn = 0, suck = 0, suckP = 400, son = null; const paused = this.game.paused, off = paused || S.done; for (const p of S.players) { if (p.cutting > 0 || (p.hold && p.hold.k === 'cut')) cut = Math.max(cut, Math.min(1, p.spd / 150)); if (p.firing) { burn = 1; if (p.hitting) this.rumble(.2, .03); } if (p.sucking) { suck = 1; suckP = 500 + (1 - Math.min(1, p.sucking / 120)) * 1800; this.rumble(.1, .03); } if (p.sonar) son = p; }\n    sfx.set('cut', { f: 4200, q: 3, v: .15 }, off ? 0 : cut, 2600 + cut * 3000); sfx.set('burn', { f: 7000, q: 1.4, v: .16 }, off ? 0 : burn * (.7 + Math.random() * .3)); sfx.set('suck', { f: 600, q: 2.4, v: .26 }, off ? 0 : suck, suckP); sfx.set('vent', { f: 1100, q: .7, v: .05 }, off || S.codeBlue ? 0 : Math.max(0, Math.sin(S.t * 1.3)));\n    let strain = null, nd = 1e9, sx = 213; const ref = son || this.localPlayer; for (const o of S.objs) if (STRAIN_OF[o.type] && !o.dead) { const d = Math.hypot(o.x - ref.x, o.y - ref.y); if (d < nd) { nd = d; strain = STRAIN_OF[o.type]; sx = o.x; } } let lvl = strain ? .5 : 0; if (son) { this.pingT = (this.pingT || 0) - dt; if (strain) lvl = clamp(1.1 - nd / 200, .3, 1.2); if (this.pingT <= 0 && son.near > 0) { this.pingT = .9 - son.near * .75; sfx.pingAt(1, son.near); } } if (S.silent || off) lvl = 0; c.update(dt, strain, lvl, (sx - 213) / 213); if (S.done) sfx.stopLoops(); }\n  // ---- the picture ----\n  draw(r) { let S = this.S; const main = this.S; if (main.rwT > 0) { const rev = G.Op.reverseOf(main); if (rev.length) { const k = 1 - main.rwT / 1.2, i = Math.max(0, rev.length - 1 - (k * rev.length | 0)); S = Object.assign({}, rev[i], { rwT: main.rwT, ghosts: null, ev: [] }); } }\n    G.drawField(r, S, this); const OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1;\n    r.overlay(g => { G.drawObjects(g, r, S, this); for (const q of this.popups) font.text(g, q.text, q.x + OX, q.y + OY, q.col, { align: 'center', outline: false, shadow: '#000', scale: q.scale }); this.drawSeats(g, r, main, OX, OY); if (main.rwT > 0) { for (let y = (this.t * 240 | 0) % 24; y < r.H; y += 24) px.blend(g, .3, 'add', () => px.rect(g, 0, y, r.W, 3, '#c0d8ff')); const yy = ((1.2 - main.rwT) / 1.2) * r.H | 0; px.rect(g, 0, yy, r.W, 2, '#ffffff'); }\n      if (main.ghosts && main.ghosts.t < main.ghosts.dur) font.text(g, 'SECOND LOOK ' + Math.ceil(main.ghosts.dur - main.ghosts.t), r.W / 2, 28, '#c8e0ff', { align: 'center', outline: false, shadow: '#000' });\n      if (main.v < 30 && !main.static) { const a = .14 + Math.sin(this.t * 6) * .05; px.blend(g, a, 'normal', () => { for (let i = 0; i < 12; i += 2) { px.rect(g, i, i, r.W - i * 2, 2, '#ff0000'); px.rect(g, i, r.H - i - 2, r.W - i * 2, 2, '#ff0000'); px.rect(g, i, i, 2, r.H - i * 2, '#ff0000'); px.rect(g, r.W - i - 2, i, 2, r.H - i * 2, '#ff0000'); } }); }\n      this.drawHud(g, r, main, OX, OY); if (this.attract) { const W = r.W, s = (this.t * 2 | 0) % 2; px.blend(g, .7, 'normal', () => px.rect(g, 0, r.H - 22, W, 22, '#06161a')); font.text(g, 'DEMO', 8, r.H - 18, '#ffe08a', { outline: false, scale: 2 }); if (s) font.text(g, 'Press any button', W - 8, r.H - 15, '#ffffff', { align: 'right', outline: false, shadow: '#000' }); } }); }\n  drawHud(g, r, S, OX, OY) { const H = G.HUD, inp = this.seats[0] && this.seats[0].input; H.monitor(g, S, this); H.clock(g, S, r); H.objective(g, S, r); H.tip(g, S, r, inp); H.speaker(g, this, r); H.gauge(g, S, r, inp); if (S.codeBlue) H.code(g, S, r, this); if (S.closing) H.closing(g, S, r, this, OX, OY); if (this.showHint && !S.closing && !S.codeBlue) this.drawHint(g, r, S, OX, OY, inp); if (S.tut && this.seats[0] && !S.codeBlue) { const n = G.Op.nextTarget(S); if (n) G.ringDraw(g, n.at[0] + OX | 0, n.at[1] + OY | 0, 10 + ((this.t * 4) % 1) * 16, '#ffe08a', 20, 2); } }\n  drawHint(g, r, S, OX, OY, inp) { const h = this.showHint, p = S.players[this.seats[0].pid], x = h.at[0] + OX | 0, y = h.at[1] + OY | 0; if ((this.t * 3 | 0) % 2) G.ringDraw(g, x, y, 14 + Math.sin(this.t * 5) * 2, '#ffe08a', 16, 2); if (p.toolNext !== h.tool) { const X = r.W - 110, Y = r.H - 62; G.HUD.toolTile(g, h.tool, X, Y, true); font.text(g, G.TOOL_NAMES[h.tool], X + 26, Y + 2, '#ffe08a', { outline: false, shadow: '#000' }); const num = G.TOOLS.indexOf(h.tool); if (inp) font.text(g, inp.lastDevice === 'gamepad' ? 'L stick ' + ['↑', '↗', '→', '↘', '↓', '↙', '←', '↖'][num] : 'Key ' + (num + 1), X + 26, Y + 12, '#e8fbf6', { outline: false, shadow: '#000' }); } }\n  drawSeats(g, r, S, OX, OY) { const all = []; for (const seat of this.seats) { const p = S.players[seat.pid]; if (p) all.push({ x: seat.cur.x + seat.cur.jx, y: seat.cur.y + seat.cur.jy, p, seat }); } for (const p of S.players) if (!p.gone && !this.seats.some(s => s.pid === p.id)) all.push({ x: p.x, y: p.y, p, seat: null });\n    const main = this.seats[0]; if (main && main.input && main.cur.fineT > .15 && !S.codeBlue) this.drawLoupe(g, main.cur.x + OX, main.cur.y + OY);\n    for (const c of all) { const x = c.x + OX | 0, y = c.y + OY | 0, p = c.p, st = { closed: !!p.hold || p.trigPrev >= .3, down: p.trigPrev >= .3, fill: p.fill, heat: p.heat, locked: p.lockT > 0 };\n      if (p.sonar) { const R = 38 * (S.doc === 'vale' ? 1.25 : 1); G.ringDraw(g, x, y, R, '#88e8ff', 36); const n = (this.t * 1.5) % 1; G.ringDraw(g, x, y, R * n, '#3a7aa0', 28, 2); if (p.near > .1) for (let i = 0; i < 3; i++) G.ringDraw(g, x, y, 6 + i * 5 + n * 5, '#88e8ff', 12, 3); }\n      if (p.firing && !(p.lockT > 0)) { px.blend(g, .6, 'add', () => px.disc(g, x, y, 4 + Math.random() * 2, '#ffb060')); if (Math.random() < .3) this.game.particles.sparks(x, y, 0, 1, Math.random() * 6.28); }\n      if (p.hold && p.tension > 0) { const f = clamp(p.tension, 0, 1); px.rect(g, x - 34, y - 10, 3, 24, '#102028'); px.rect(g, x - 34, y + 14 - (24 * f | 0), 3, 24 * f | 0, f > .85 ? '#ff5a4a' : f > .6 ? '#ffc060' : '#5ff0e0'); }\n      if (p.hold && p.hold.k === 'stitch') { const o = G.getObj(S, p.hold.id); if (o) { const q = G.stPts(o, S, p.hold.i), sx = (p.hold.flip ? q[2] : q[0]) + OX, sy = (p.hold.flip ? q[3] : q[1]) + OY, tx = (p.hold.flip ? q[0] : q[2]) + OX, ty = (p.hold.flip ? q[1] : q[3]) + OY; px.line(g, sx | 0, sy | 0, x, y, '#5aa8ff', 1); G.ringDraw(g, tx | 0, ty | 0, 6, '#ffffff', 12); } }\n      if (p.heat > .05 && p.toolNext === 'cautery') { px.rect(g, x + 14, y - 12, 18, 3, '#102028'); px.rect(g, x + 14, y - 12, 18 * p.heat | 0, 3, p.heat > .8 ? '#ff5a4a' : '#ff9a3a'); }\n      G.drawInstrument(g, p.toolNext || p.tool, x, y, st, S.N > 1 ? p.color : '#8cc8d8', this.t);\n      if (S.N > 1) font.text(g, (p.name || ('P' + (p.id + 1))).slice(0, 8), x + 10, y + 30, p.color, { outline: false, shadow: '#000' });\n      if (c.seat) { G.HUD.wheel(g, c.seat, S, x, y); if (c.seat.input && !p.hold && !S.closing && !S.codeBlue && !(c.seat.wheel.show > 0)) { let best = null, bd = 16; for (const q of G.Op.targets(S, p.toolNext)) { const d = Math.hypot(q.at[0] - c.x, q.at[1] - c.y); if (d < bd) { bd = d; best = q; } } if (best) { const inp = c.seat.input, wt = G.promptWidth(inp, 'useTool', best.verb || 'Use'), fx = x + 16 + wt > r.W ? x - wt - 8 : x + 16, fy = y - 18 < 2 ? y + 34 : y - 18; G.drawPrompt(g, inp, 'useTool', best.verb || 'Use', fx, fy); } } } } }\n  drawLoupe(g, x, y) { const R = 34, cv = g.canvas; if (!cv) return; x |= 0; y |= 0; px.reset(g); const sm = g.imageSmoothingEnabled; g.imageSmoothingEnabled = false; for (let dy = -R; dy < R; dy += 2) { const a = Math.sqrt(R * R - dy * dy) | 0; if (a > 0) g.drawImage(cv, x - (a >> 1), y + (dy >> 1), a, 1, x - a, y + dy, a * 2, 2); } g.imageSmoothingEnabled = sm; px.reset(g); G.ringDraw(g, x, y, R, '#e8fbf6', 36); }\n}\nG.OpView = OpView;\n})();\nEOF\nwc -l src/ui/hud.js src/scenes/op.js","description":"Write HUD and operation view using absolute paths"}}}
