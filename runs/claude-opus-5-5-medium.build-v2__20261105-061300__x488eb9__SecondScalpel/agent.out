.2, 4)] });\nadd('c10', 290, { 0: [{ t: 'bleeder', x: 300, y: 100 }, { t: 'pool', x: 300, y: 100, vol: 80, req: true }], 4: [W(120, 88, .3, 4, { w: 9 }), W(296, 152, -.2, 4, { w: 9 })] });\n})();\nEOF\npython3 - <<'EOF'\ndef sub(f,a,b):\n    s=open(f).read(); assert a in s,(f,a[:70]); s=s.replace(a,b,1); open(f,'w').write(s)\nsub('src/manifest.json','\"data/cases/ch4.js\", ','\"data/cases/ch4.js\", \"data/cases/extra.js\", ')\n# Da Capo: mercy on each repeat\nsub('src/core/strains/dacapo.js',\"o.cd = -1; o.regrew++;\",\"o.cd = -1; o.regrew++; o.window = Math.min(18, (o.window || 10) + 2);\")\n# a first-timer misses beats\nb='src/bot/autosurgeon.js'\nsub(b,\"while (Math.abs((S.beatLen - S.sinceBeat) - .47) > .03 && t < 2.5) { t += this.dt; yield; } }\",\"const off = this.o.beatErr ? (this.rnd() - .5) * 2 * this.o.beatErr : 0; while (Math.abs((S.beatLen - S.sinceBeat) - (.47 + off)) > .03 && t < 2.5) { t += this.dt; yield; } }\")\nsub('tools/slow.mjs',\"err: 4 * k, phaseRead: 3 * k }\",\"err: 4 * k, phaseRead: 3 * k, beatErr: .35 * k }\")\n# tremolo: the plan's 2 to 4 tries want a mistake to cost more\nsub('src/core/strains/tremolo.js',\"G.hurt(S, 2 * T.strainDamage); G.addLac\",\"G.hurt(S, 4 * T.strainDamage); G.addLac\")\n# less checkerboard in the shader\nsub('src/art/tissue.js',\"BAYER[(x & 3) | ((y & 3) << 2)] * 1.15 + .5\",\"BAYER[(x & 3) | ((y & 3) << 2)] * .62 + .5\")\n# stages: a per-pixel light and grain pass where the canvas allows it; About shows more of its stage\nst='src/art/stages.js'\nsub(st,\"for (let i = 0; i < 26; i++) { const a = (i * 37.7) % 1, b = (i * 91.3) % 1; px.blend(g, .018 + i * .0012, 'add', () => px.disc(g, W * a, H * b * .7, 22 + i * 3, warm ? '#402818' : '#143040')); } };\",\"for (let i = 0; i < 26; i++) { const a = (i * 37.7) % 1, b = (i * 91.3) % 1; px.blend(g, .018 + i * .0012, 'add', () => px.disc(g, W * a, H * b * .7, 22 + i * 3, warm ? '#402818' : '#143040')); } if (!g.getImageData) return; const im = g.getImageData(0, 0, W, H); 