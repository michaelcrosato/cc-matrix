#', '#..............#', '#..............#', '#..............#', '#..............#', '#..............#', '################'];\nconst MAPS = {\n  ward3: { rows: rowsW, wall: 1, name: 'Ward 3', floor: 'marble', start: [17.5, 8.5], door: [21.5, 5.5], beds: [[2.5, 3], [5.5, 3], [8.5, 3], [11.5, 3], [14.5, 3], [17.5, 3], [2.5, 8.8], [5.5, 8.8]], staff: { quill: [11, 8.5], odalys: [8.5, 9], percy: [14.5, 9.6], oyelaran: [19.5, 2] }, props: [['vendingMachine', 14.5, 10.5], ['lightbox', 8.5, 10.6], ['ivStand', 3.8, 2.2], ['ivStand', 9.8, 2.2], ['vitalsMonitor', 6.8, 2.2], ['privacyCurtain', 12.9, 3.5, 1.57], ['crashCart', 20.5, 9.5], ['ward:chair-desk', 11, 9.7], ['ward:cabinet-bed-drawer', 15.8, 2.2]], lights: [[6, 3], [12, 3], [18, 3], [6, 8], [12, 8], [18, 8]], people: ['quill', 'odalys', 'percy', 'oyelaran'], windows: true },\n  ship: { rows: rowsS, wall: 2, name: \"Ship's Ward\", floor: 'planks', start: [11, 6.5], door: [13.5, 3.5], beds: [[2.5, 2.8], [5.5, 2.8], [8.5, 2.8], [2.5, 6.5]], staff: { quill: [7, 6.3], sokolova: [10.5, 2.5] }, props: [['ivStand', 3.8, 2], ['crashCart', 12.8, 6.8], ['privacyCurtain', 6.9, 3.2, 1.57], ['chest', 5.5, 7.2]], lights: [[7, 4]], people: ['quill', 'sokolova'], lamp: true },\n};\nconst LINES_EXTRA = { sokolova: ['In the navy we had one ward, and it was also the kitchen.', 'Sit. Eat. At my age, dear, everything happens twice, including lunch.', 'You are thinking about the argument. Good. Lose it with style.'] };\nconst pat = { agnes: ['#a06a8a', '#e4e0dc', '#efd4c0'], slide: ['#7a3a4a', '#2a2424', '#5e3a26'], tam: ['#e0902a', '#b4562c', '#e4b08c'], ned: ['#2a3a5a', '#d8d4cc', '#c89a78'], ilse: ['#3a3a4a', '#e0c48a', '#f4dccc'], yusuf: ['#d07a2a', '#1e1a1c', '#b88a64'], perpetua: ['#22222e', '#1a1a24', '#f0d8c8'], crane: ['#5a6470', '#6a5a4c', '#dcc0a4'] };\nG.SCENES.ward = { pausable: true, view: 'threequarter', camera: { zoom: false, wheel: false }, propSize: 1.3,\n  enter(d) { const game = G.game, M = this.M = MAPS[d.map] || MAPS.ward3; this.d = d; this.t = 0; game.saves.canSave = true; this.map = new E.TileMap({ rows: M.rows, legend: { '#': M.wall }, types: WALL, floorMat: M.floor, outside: '#0a1214' }); game.cam.bounds = v => this.map.bounds(v); const T = v => v * 16; this.hero = new E.Body({ x: T(M.start[0]), y: T(M.start[1]), r: 5 }); this.rig = G.newRig('vale'); this.people = []; this.talked = new Set(); const after = d.after || 1, ch = after; for (const id of M.people) { const at = M.staff[id]; const rig = G.newRig(id); this.people.push({ id, x: T(at[0]), y: T(at[1]), rig, r: 7, facing: 1.57, staff: true, pose: id === 'quill' ? 'knit' : id === 'percy' ? 'hips' : null }); } const beds = (G.WARD_PEOPLE[after] || []); M.beds.forEach((b, i) => { const id = beds[i], x = T(b[0]), y = T(b[1]); this.map.solid('hospitalBed', x, y, 0, { facing: 1.57 }); if (id) { const c = pat[id]; this.people.push({ id, x, y, rig: G.newRig('patient', c[0], c[1], c[2]), bed: true, r: 9, facing: 1.57 }); } }); for (const p of M.props) this.map.solid(p[0], T(p[1]), T(p[2]), 0, { facing: p[3] === undefined ? 1.57 : p[3] }); this.door = { x: T(M.door[0]), y: T(M.door[1]) }; this.flow = new E.FlowField(this.map); this.go = null; this.hover = null; this.chapterI = Math.max(0, after - 1); game.lights.enabled = true; game.lights.ambient = M.lamp ? .5 : .68; game.lights.tint = '#10201e'; G.music.play(M.lamp ? 'tension' : 'ward'); if (game.saves.autosave) game.saves.autosave(); game.input.consumeAll(); if (M.windows) game.weather = null; this.wardTalk = G.wardStory; },\n  exit() { const game = G.game; game.lights.enabled = false; game.cam.bounds = null; game.saves.canSave = false; },\n  talk(p) { const S = this.wardTalk, id = p.id, L = (G.WARD_LINES[id] || LINES_EXTRA[id] || ['...']), n = this.chapterI % L.length, line = L[n]; p.rig.kick && p.rig.kick(.2); G.curWho = id; S.nodes.__w = [{ who: id, say: line }]; S.run('__w', { onDone: () => { this.talked.add(id); if (this.talked.size >= this.people.length && !G.prog.morale) { G.prog.morale = true; G.sfx.chime(); G.game.note('Morale, Quill says, as if it were a diagnosis. +10 Steady', 3); } } }); },\n  update(dt) { const game = G.game, I = game.input; this.t += dt; const hero = this.hero; if (this.wardTalk.update(dt)) { hero.vx = hero.vy = 0; this.rig.update(dt, { x: hero.x, y: hero.y, z: 0, vx: 0, vy: 0, facing: this.face || 0 }); for (const p of this.people) this.stepP(p, dt); game.focus(hero.x, hero.y, 10); return; }\n    const m = I.move(), d = game.view.screenDirToGround(m[0], m[1]); let vx = d[0] * 95, vy = d[1] * 95; if (Math.hypot(vx, vy) > 5) this.go = null;\n    // the mouse: hover moves the focus, a click walks there and talks\n    const ptr = I.mouse.t !== this.mt || I.lastDevice === 'mouse' ? game.mouseGround() : null; this.mt = I.mouse.t; if (ptr && I.lastDevice === 'mouse') { let best = null, bd = 14; for (const p of this.people) { const q = Math.hypot(p.x - ptr[0], p.y - ptr[1]); if (q < bd) { bd = q; best = p; } } if (Math.hypot(this.door.x - ptr[0], this.door.y - ptr[1]) < 14) best = this.door; this.hover = best; }\n    let near = null, nd = 22; for (const p of this.people) { const q = Math.hypot(p.x - hero.x, p.y - hero.y); if (q < nd + (p.bed ? 8 : 0)) { nd = q; near = p; } } this.near = near; const atDoor = Math.hypot(this.door.x - hero.x, this.door.y - hero.y) < 24; this.atDoor = atDoor;\n    const c = I.clicked(); if (c) { const gr = game.mouseGround(); if (gr) { const tgt = this.hover || null; this.go = tgt ? { x: tgt.x, y: tgt.y, who: tgt } : { x: gr[0], y: gr[1] }; } }\n    if (this.go) { const q = Math.hypot(this.go.x - hero.x, this.go.y - hero.y); if (q < (this.go.who ? 22 : 4)) { const w = this.go.who; this.go = null; if (w === this.door) return this.leave(); if (w) return this.talk(w); } else { const dir = this.flow.dir(hero.x, hero.y, this.go.x, this.go.y); vx = dir[0] * 95; vy = dir[1] * 95; } }\n    hero.vx = vx; hero.vy = vy; hero.update(dt, this.map); if (Math.hypot(vx, vy) > 5) this.face = Math.atan2(vy, vx); this.rig.update(dt, { x: hero.x, y: hero.y, z: 0, vx, vy, facing: this.face || 0 }); for (const p of this.people) this.stepP(p, dt); game.focus(hero.x, hero.y, 10);\n    if (I.pressed('interact') || I.pressed('confirm')) { I.consumeAll(); if (atDoor) return this.leave(); if (near) this.talk(near); } },\n  stepP(p, dt) { p.rig.update(dt, { x: p.x, y: p.y, z: p.bed ? 12 : 0, vx: 0, vy: 0, facing: p.bed ? 1.57 : Math.atan2(this.hero.y - p.y, this.hero.x - p.x), down: p.bed ? 1 : 0, pose: p.pose || undefined }); },\n  leave() { G.sfx.ui(); const t = this.d.then; G.saveProg(); if (t) t(); },\n  draw(r) { const game = G.game, M = this.M, T = v => v * 16; this.map.drawFloor(r); this.map.queueWalls(r); const swing = M.lamp ? Math.sin(this.t * 1.1) * 28 : 0; for (const l of M.lights) { const fl = M.lamp ? 1 : ((this.t * 7 + l[0]) % 13 < .2 ? .6 : 1); game.lights.add(T(l[0]) + swing, T(l[1]), 40, M.lamp ? 150 : 90, .85 * fl, { color: M.lamp ? '#ffd890' : '#d8f0e8' }); } for (const p of M.props) r.shape(p[0], T(p[1]), T(p[2]), 0, { facing: p[3] === undefined ? 1.57 : p[3], light: true }); for (const b of M.beds) r.shape('hospitalBed', T(b[0]), T(b[1]), 0, { facing: 1.57 }); game.lights.add(this.door.x, this.door.y, 26, 44, .9, { color: '#5ff0e0' }); r.shadow(this.hero.x, this.hero.y, 6); r.actor(this.hero.x, this.hero.y, 0, (g, ox, oy) => this.rig.draw(g, ox, oy, r.view)); for (const p of this.people) { if (!p.bed) r.shadow(p.x, p.y, 6); r.actor(p.x, p.y, p.bed ? 12 : 0, (g, ox, oy) => p.rig.draw(g, ox, oy, r.view), { outline: this.hover === p || this.near === p ? '#ffe08a' : undefined }); }\n    r.overlay(g => { const I = game.input, dp = r.w(this.door.x, this.door.y, 34); px.rect(g, dp[0] - 30, dp[1] - 8, 60, 13, (this.t * 2 | 0) % 2 ? '#0c4a48' : '#106a64'); font.text(g, 'NEXT CASE', dp[0], dp[1] - 5, '#5ff0e0', { align: 'center', outline: false, font: 'tiny' }); font.text(g, M.name, 8, 6, '#e8fbf6', { outline: false, shadow: '#000' });\n      const f = this.hover || this.near, tgtDoor = this.atDoor || this.hover === this.door; if (tgtDoor) { const w = G.promptWidth(I, 'interact', 'Theatre'); G.drawPrompt(g, I, 'interact', 'Theatre', (r.W - w) / 2 | 0, r.H - 18); } else if (f && f !== this.door) { const o = r.w(f.x, f.y, 44), nm = G.CAST[f.id] ? G.CAST[f.id].name : f.id; font.text(g, nm, o[0], o[1] - 8, '#ffe08a', { align: 'center', outline: false, shadow: '#000' }); const w = G.promptWidth(I, 'interact', 'Talk'); G.drawPrompt(g, I, 'interact', 'Talk', (r.W - w) / 2 | 0, r.H - 18); } if (G.prog.morale) font.text(g, 'Morale: +10 Steady', r.W - 8, 6, '#ffe08a', { align: 'right', outline: false, shadow: '#000' }); }); this.wardTalk.draw(r); } };\nG.makeWardStory = (game) => { const people = {}; for (const id in G.CAST) people[id] = { name: G.CAST[id].name, portrait: (g, x, y, s) => { px.reset(g); g.drawImage(G.bust(id, 'neutral'), 28, 14, 56, 56, x, y, s, s); px.reset(g); } }; const talk = new E.Dialog(game, { voice: (ch) => G.babble.letter(ch, G.curWho || 'quill'), speed: 46, lines: 3, width: 400, bg: '#06161a', border: '#5ff0e0', nameColor: '#5ff0e0', portraitSize: 40 }); return new E.Story(game, { people, nodes: {}, dialog: talk }); };\n})();\nEOF\ncat > src/scenes/lobby.js <<'EOF'\n// Grand Rounds on one couch: four seats, press to join, add AI colleagues, start.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nG.SCENES.lobby = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter() { const game = G.game; this.t = 0; this.seats = [{ kind: 'you', input: game.input }, null, null, null]; game.allowJoin({ max: 4, onJoin: (inp) => { const i = this.seats.findIndex(s => !s); if (i >= 0) { this.seats[i] = { kind: 'human', input: inp }; G.sfx.chime(); } } }); this.i = 0; this.menu = new E.Menu(game, this.items(), { scale: 1, x: 'center', y: 168, bg: '#06161a', border: '#5ff0e0', pick: '#5ff0e0', onPick: (i) => this.pick(i), onCancel: () => this.back() }); G.music.play('ward'); game.input.consumeAll(); },\n  items() { return ['Start', 'Add AI colleague', 'Remove AI colleague', 'Back']; },\n  exit() { G.game.allowJoin(false); },\n  back() { const game = G.game; for (const q of game.players.slice(1)) game.removePlayer(q); game.go('menu'); },\n  pick(i) { const game = G.game; if (i === 0) { const seats = [], players = []; this.seats.forEach((s) => { if (!s) return; const pid = players.length; players.push({ id: pid, color: G.SEATS[pid] }); if (s.kind === 'ai') seats.push({ pid, bot: new G.Bot({ seed: 11 + pid * 7, speed: 300, react: .08 }) }); else seats.push({ pid, input: s.input }); }); game.go('op', { caseId: 'grandrounds', mode: 'gr', seats, players, difficulty: 'resident' }); } if (i === 1) { const k = this.seats.findIndex(s => !s); if (k >= 0) { this.seats[k] = { kind: 'ai' }; G.sfx.ui(); } } if (i === 2) { for (let k = 3; k >= 1; k--) if (this.seats[k] && this.seats[k].kind === 'ai') { this.seats[k] = null; G.sfx.ui(); break; } } if (i === 3) this.back(); },\n  update(dt) { const game = G.game; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); this.menu.update(); },\n  draw(r) { r.overlay(g => { G.drawStage(g, 'gallery', r.W, r.H, this.t); px.blend(g, .4, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); font.text(g, 'GRAND ROUNDS', r.W / 2, 10, '#5ff0e0', { align: 'center', scale: 2, outline: false, shadow: '#000' }); font.text(g, 'A ferry disaster. One patient. Every surgeon.', r.W / 2, 32, '#e8fbf6', { align: 'center', outline: false, shadow: '#000' }); const w = 92, x0 = (r.W - (w * 4 + 18)) / 2 | 0; this.seats.forEach((s, i) => { const x = x0 + i * (w + 6), y = 50; E.ui.box(g, x, y, w, 104, { bg: '#06161a', border: G.SEATS[i] }); font.text(g, 'P' + (i + 1), x + 6, y + 5, G.SEATS[i], { outline: false, scale: 2 }); if (s) { const id = ['vale', 'quill', 'percy', 'odalys'][i]; px.reset(g); g.drawImage(G.bust(id, 'neutral', { maskUp: true }), 28, 16, 56, 60, x + 18, y + 26, 56, 60); px.reset(g); font.text(g, s.kind === 'ai' ? 'AI colleague' : s.kind === 'you' ? 'You' : 'Joined', x + w / 2, y + 90, '#e8fbf6', { align: 'center', outline: false }); } else { font.text(g, 'Open seat', x + w / 2, y + 40, '#8fb8b0', { align: 'center', outline: false }); font.text(g, 'Start on a', x + w / 2, y + 58, '#8fb8b0', { align: 'center', outline: false }); font.text(g, 'pad, or 2', x + w / 2, y + 68, '#8fb8b0', { align: 'center', outline: false }); } }); }); this.menu.draw(r); } };\n})();\nEOF\ncat > src/ui/attract.js <<'EOF'\n// The attract reel: the real game, played by the bot with cheats on, a segment at a time. Any input goes back to the title; it never saves.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst op = (caseId, o) => Object.assign({ k: 'op', caseId, seats: 1, dur: 15, phase: 0 }, o);\nG.REEL = [\n  { k: 'story', id: 'c3_after', dur: 14 },\n  op('c1', { dur: 15 }),\n  op('c3', { dur: 18, phase: 0, at: [[6, S => { G.Op.jumpPhase(S, 2); S.lock = false; }]] }),\n  op('c3', { dur: 10, phase: 3 }),\n  op('c6', { dur: 16, phase: 1 }),\n  op('c7', { dur: 24, phase: 0, at: [[20.5, (S, V) => { S.steady = 100; V.seats[0].bot.dev.giftNext = true; G.opGift(S, S.players[0]); }]] }),\n  op('grandrounds', { dur: 20, seats: 4 }),\n  op('c11', { dur: 20, phase: 2 }),\n  op('c11', { dur: 12, phase: 3 }),\n  { k: 'stamp', dur: 5 },\n  { k: 'title', dur: 8 },\n];\nG.SCENES.attract = { view: 'overhead', camera: { zoom: false, wheel: false },\n  enter() { const game = G.game; this.i = -1; this.t = 0; this.loops = 0; this.reelT = 0; game.saves.canSave = false; G.attractOn = true; this.next(); },\n  exit() { G.attractOn = false; const game = G.game; game.setView('overhead'); game.weather = null; if (G.storyView) G.story.stop(); G.sfx.stopLoops(); G.choir.silence(); G.sfx.setMode('normal'); G.sfx.setSlow(false); G.music.play(null); },\n  next() { const game = G.game; this.i++; if (this.i >= G.REEL.length) { this.i = 0; this.loops++; } this.seg = G.REEL[this.i]; this.t = 0; this.view = null; this.ati = 0; G.story.stop(); const s = this.seg; game.weather = null; game.setView('overhead'); if (s.k === 'story') { const V = G.storyView; V.reset(); V.autoSkip = false; G.story.auto = 1.6; G.story.run(s.id, { onDone: () => { this.t = 1e9; } }); } else if (s.k === 'op') { const n = s.seats, players = [], seats = []; for (let i = 0; i < n; i++) { players.push({ id: i, color: G.SEATS[i] }); seats.push({ pid: i, bot: new G.Bot({ seed: 5 + i * 3, speed: 420 }) }); } const S = G.Op.create(s.caseId, { seed: 77 + this.i, difficulty: 'resident', players, phase: s.phase, lock: s.caseId !== 'c3' || s.phase !== 0, attract: true, steady: 60 }); this.view = new G.OpView(game, S, { seats, attract: true, music: 'op' }); G.music.play(G.CASES[s.caseId].music || 'op'); if (s.caseId === 'c11' && s.phase === 2) G.music.play(null); } else if (s.k === 'title') { game.setView('side'); this.titleScene = G.SCENES.title; game.weather = { kind: 'rain', amount: .7, wind: .2 }; G.music.play('title'); } },\n  update(dt) { const game = G.game; this.t += dt; this.reelT += dt; const s = this.seg; if (G.idle < .01 && this.reelT > .25 && G.lastPress) { G.lastPress = false; game.input.consumeAll(); game.go('title', { fromAttract: true }); return; } G.lastPress = false; if (s.k === 'story') { G.storyView.update(dt); } else if (s.k === 'op') { const V = this.view; game.focus(game.W / 2, game.H / 2, 0); if (s.at) while (this.ati < s.at.length && this.t >= s.at[this.ati][0]) { s.at[this.ati++][1](V.S, V); } if (V.S.done) { this.t = s.dur; } else V.update(dt); } else if (s.k === 'title') game.focus(game.W / 2, 0, game.H / 2); else game.focus(game.W / 2, game.H / 2, 0); if (this.t >= s.dur) this.next(); },\n  draw(r) { const s = this.seg; if (!s) return; if (s.k === 'story') G.storyView.draw(r); else if (s.k === 'op') this.view.draw(r); else if (s.k === 'title') { G.SCENES.title.t = this.t + 2; G.drawTitleArt(r, this.t + 2); } else r.overlay(g => { G.drawStage(g, 'scrub', r.W, r.H, this.t); px.blend(g, .4, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#02080a')); font.text(g, 'CASE CLOSED', r.W / 2, 60, '#ff5a4a', { align: 'center', scale: 3, outline: false }); G.ringDraw(g, r.W / 2, 136, 34, '#ff5a4a', 36); font.text(g, 'S', r.W / 2, 118, '#ff5a4a', { align: 'center', scale: 5, outline: false }); }); if (s.k !== 'op') r.overlay(g => { const W = r.W; px.blend(g, .7, 'normal', () => px.rect(g, 0, r.H - 22, W, 22, '#06161a')); font.text(g, 'DEMO', 8, r.H - 18, '#ffe08a', { outline: false, scale: 2 }); if ((this.reelT * 2 | 0) % 2) font.text(g, 'Press any button', W - 8, r.H - 15, '#ffffff', { align: 'right', outline: false, shadow: '#000' }); }); } };\n})();\nEOF\ncat > src/ui/dev.js <<'EOF'\n// Dev mode: a docked panel on the left third, the game running behind it, in the game's pixel UI. Tuning, Cheats, Jump, Info.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E, { T } = G;\nconst PER_PAGE = 8, TABS = ['Tuning', 'Cheats', 'Jump', 'Info'], KEY = 'scalpel.dev';\nconst Dev = G.Dev = { open: false, tab: 0, row: 0, page: 0, jumpCase: 0, jumpPhase: 0, spawnI: 0, nodeI: 0,\n  toggle(on) { this.open = on === undefined ? !this.open : on; },\n  load() { const s = E.store.get(KEY, null); if (s) for (const k in s) if (k in G.TUNING) T[k] = s[k]; },\n  save() { const c = {}; for (const k in G.TUNING) if (T[k] !== G.TUNING[k]) c[k] = T[k]; E.store.set(KEY, c); },\n  rows() { const S = G.op && G.game.scene === G.SCENES.op ? G.op.S : null; const K = G.CHEATS; if (this.tab === 0) { const P = G.TUNING_PAGES[this.page % G.TUNING_PAGES.length], R = P.rows.map(r => ({ slider: r })); R.push({ label: 'Reset this page', act: () => { for (const r of P.rows) T[r.key] = r.v; this.save(); } }); R.push({ label: 'Reset everything', act: () => { Object.assign(T, G.TUNING); this.save(); } }); return { title: P.name, rows: R }; }\n    if (this.tab === 1) { const t = (k, l) => ({ label: l, on: K[k], act: () => { K[k] = !K[k]; } }); const ts = G.game.timeScale; return { title: 'Cheats', rows: [t('lockVitals', 'Lock vitals'), t('freezeClock', 'Freeze clock'), t('infiniteSteady', 'Infinite Steady'), t('oneHit', 'One-hit strains'), t('reveal', 'Reveal hidden'), t('radii', 'Show hit radii'), t('auto', 'Autosurgeon'), { label: 'Slow motion x' + ts, act: () => { const L = [.25, .5, 1, 2]; G.game.timeScale = L[(L.indexOf(ts) + 1) % 4]; } }] }; }\n    if (this.tab === 2) { const id = [...G.CASE_ORDER, 'grandrounds', 'lab'][this.jumpCase % (G.CASE_ORDER.length + 2)], c = G.CASES[id], types = Object.keys(G.OBJ).filter(k => !['guide', 'nerve', 'lobe', 'reed', 'dome', 'barbspot'].includes(k)), sp = types[this.spawnI % types.length], nodes = Object.keys(G.SCRIPT), node = nodes[this.nodeI % nodes.length]; return { title: 'Jump', rows: [{ label: 'Case: ' + c.title, adj: d => { this.jumpCase = (this.jumpCase + d + 99) % (G.CASE_ORDER.length + 2); this.jumpPhase = 0; }, act: () => G.game.go('op', { caseId: id, mode: 'files', phase: this.jumpPhase }) }, { label: 'Phase ' + (this.jumpPhase + 1) + ' of ' + c.phases.length, adj: d => { this.jumpPhase = (this.jumpPhase + d + c.phases.length) % c.phases.length; }, act: () => { if (S && S.caseId === id) G.Op.jumpPhase(S, this.jumpPhase); else G.game.go('op', { caseId: id, mode: 'files', phase: this.jumpPhase }); } }, { label: 'Force win', act: () => { if (S) G.Op.forceWin(S); } }, { label: 'Force lost', act: () => { if (S) G.Op.forceLost(S); } }, { label: 'Trigger Code Blue', act: () => { if (S) G.Op.triggerCode(S); } }, { label: 'Spawn: ' + sp, adj: d => { this.spawnI = (this.spawnI + d + types.length) % types.length; }, act: () => { if (S) { const P = S.players[0], o = { t: sp, x: P.x, y: P.y }; if (sp === 'legato') o.route = [[100, 120], [200, 90], [320, 130]]; G.spawn(S, o); } } }, { label: 'Story: ' + node, adj: d => { this.nodeI = (this.nodeI + d + nodes.length) % nodes.length; }, act: () => { this.toggle(false); G.game.go('story', { id: node, then: () => G.game.go('menu') }); } }, { label: 'Unlock all', act: () => { G.prog.unlocked = G.CASE_ORDER.slice(); G.prog.ended = true; G.saveProg(); } }, { label: 'Clear save', act: () => { G.prog = { flow: 0, diff: 'resident', ranks: {}, unlocked: ['c1'], ended: false, morale: false }; G.saveProg(); } }] }; }\n    const info = S ? ['Case ' + S.caseId + ', phase ' + S.phaseI, 'Objects ' + S.objs.length, 'Seed ' + S.seed, 'Hash ' + G.stateHash(S), 'Score ' + (S.score | 0) + ', slips ' + S.slips, 'Flow ' + S.flow, 'Last: ' + (G.op.view.lastEv || '-')] : ['No operation running.']; return { title: 'Info', rows: [...info.map(l => ({ label: l, info: true })), { label: 'Copy tuning', act: () => { const s = JSON.stringify(T); console.log(s); try { navigator.clipboard && navigator.clipboard.writeText(s); } catch (e) { /* no clipboard here */ } G.game.note('Tuning copied', 1.2); } }] }; },\n  update(dt) { if (!this.open) return; const I = G.game.input, A = this.rows(); const n = A.rows.length; if (I.pressed('cancel')) { I.consumeAll(); this.toggle(false); return; } if (I.pressed('toolNext')) { this.tab = (this.tab + 1) % 4; this.row = 0; I.consumeAll(); } if (I.pressed('toolPrev')) { this.tab = (this.tab + 3) % 4; this.row = 0; I.consumeAll(); } if (I.repeat('nudgeU') || I.repeat('curU') || I.repeat('up')) { this.row = (this.row + n - 1) % n; G.sfx.ui(); } if (I.repeat('nudgeD') || I.repeat('curD') || I.repeat('down')) { this.row = (this.row + 1) % n; G.sfx.ui(); } this.row = Math.min(this.row, n - 1); const r = A.rows[this.row], adjD = (I.down('left') || I.down('nudgeL') ? -1 : 0) + (I.down('right') || I.down('nudgeR') ? 1 : 0), adjP = (I.repeat('left') || I.repeat('nudgeL') ? -1 : 0) + (I.repeat('right') || I.repeat('nudgeR') ? 1 : 0);\n    if (this.tab === 0 && adjP && (r.slider ? false : true)) { this.page = (this.page + adjP + G.TUNING_PAGES.length) % G.TUNING_PAGES.length; this.row = 0; } else if (r.slider && adjD) { this.hold = (this.hold || 0) + dt; if (adjP || this.hold > .4) { const q = r.slider; T[q.key] = G.clamp(Math.round((T[q.key] + adjD * q.step * (this.hold > 1 ? 3 : 1)) / q.step) * q.step, q.min, q.max); T[q.key] = +T[q.key].toFixed(3); this.save(); } } else this.hold = 0; if (r.adj && adjP) r.adj(adjP); if (I.pressed('interact') || I.pressed('confirm')) { if (r.act) { r.act(); G.sfx.chime(); } I.consumeAll(); }\n    const p = I.pointer(); if (p && p[0] < 150 && I.lastDevice === 'mouse') { const ry = Math.floor((p[1] - 44) / 18); if (ry >= 0 && ry < n) { if (I.mouse.t !== this.mt) this.row = ry; const c = A.rows[ry]; if (c.slider && I.down('useTool')) { const q = c.slider, f = G.clamp((p[0] - 10) / 124, 0, 1); T[q.key] = +(Math.round((q.min + (q.max - q.min) * f) / q.step) * q.step).toFixed(3); this.save(); I.suppressCode && I.suppressCode('Mouse0'); } else if (I.clicked() && c.act) { c.act(); G.sfx.chime(); } } if (p[1] < 26) { const c = I.clicked(); if (c) { this.tab = Math.min(3, c[0] / 36 | 0); this.row = 0; } } this.mt = I.mouse.t; } },\n  draw(r) { if (!this.open) return; const A = this.rows(); r.overlay(g => { const w = 146, H = r.H; px.blend(g, .88, 'normal', () => px.rect(g, 0, 0, w, H, '#06161a')); px.rect(g, w, 0, 1, H, '#5ff0e0'); TABS.forEach((t, i) => { const X = 2 + i * 36; px.rect(g, X, 2, 34, 13, i === this.tab ? '#5ff0e0' : '#123036'); font.text(g, t, X + 17, 5, i === this.tab ? '#06161a' : '#e8fbf6', { align: 'center', outline: false, font: 'tiny' }); }); font.text(g, A.title, 6, 20, '#ffe08a', { outline: false }); if (this.tab === 0) font.text(g, '←→ page', w - 4, 20, '#8fb8b0', { align: 'right', outline: false, font: 'tiny' }); const start = Math.max(0, Math.min(this.row - (PER_PAGE + 1), A.rows.length - 10)); A.rows.slice(0, 10).forEach((q, i) => { const y = 34 + i * 18, on = i === this.row; if (on) px.rect(g, 2, y - 2, w - 4, 17, '#123a3c'); if (q.slider) { const s = q.slider, v = T[s.key], f = (v - s.min) / (s.max - s.min); font.text(g, s.label, 6, y, on ? '#fff' : '#b8d8d0', { outline: false, font: 'tiny' }); font.text(g, String(v), w - 6, y, v === s.v ? '#b8d8d0' : '#ffe08a', { align: 'right', outline: false, font: 'tiny' }); px.rect(g, 10, y + 8, 124, 3, '#0c2a30'); px.rect(g, 10, y + 8, 124 * f | 0, 3, '#5ff0e0'); px.rect(g, 10 + 124 * (s.v - s.min) / (s.max - s.min) | 0, y + 7, 1, 5, '#ffffff'); px.rect(g, 10 + 124 * f - 1 | 0, y + 6, 3, 7, on ? '#ffffff' : '#a8e8e0'); } else if (q.on !== undefined) { px.rect(g, 6, y + 1, 8, 8, q.on ? '#5ff0e0' : '#0c2a30'); font.text(g, q.label, 18, y + 1, on ? '#fff' : '#b8d8d0', { outline: false }); } else font.text(g, q.label.slice(0, 26), 6, y + 1, q.info ? '#8fb8b0' : on ? '#fff' : '#b8d8d0', { outline: false }); }); }); },\n};\nG.stateHash = S => { let h = 2166136261; const s = JSON.stringify({ v: S.v, c: S.clock, r: S.rng, o: S.objs, t: S.t }); for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0).toString(16); };\n})();\nEOF\ncat > src/net/hub.js <<'EOF'\n// AI Hub Session Protocol v1, shared world. The host's copy runs the sim; other copies keep a mirror of it and send only their own hands.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E, HUB = window.AIHub;\nconst DYN = { pool: ['vol'], guide: ['prog'], wound: ['si'], arteryTear: ['si'], bead: ['air', 'tx', 'ty', 'h'], nest: ['opened', 'mark'], lobe: ['open', 'dead2', 'dose', 'slashedIt'], dacapo: ['cd'], windowTarget: ['slashed'], retractorHandle: ['held'], laceration: ['covN'], patch: ['covN'], bleeder: ['burn'], polyp: ['burn'], shard: ['pullProg'] };\nconst packObj = o => { const a = [o.id, Math.round(o.x), Math.round(o.y)], K = DYN[o.type]; if (K) for (const k of K) { const v = k === 'pullProg' ? (o.pull ? o.pull.prog : 0) : o[k]; a.push(typeof v === 'boolean' ? (v ? 1 : 0) : typeof v === 'number' ? Math.round(v * 10) / 10 : 0); } return a; };\nconst unpackObj = (o, a) => { o.x = a[1]; o.y = a[2]; const K = DYN[o.type]; if (K) K.forEach((k, i) => { const v = a[3 + i]; if (v === undefined) return; if (k === 'pullProg') { if (o.pull) o.pull.prog = v; } else if (typeof o[k] === 'boolean') o[k] = !!v; else o[k] = v; }); };\nconst H = G.Hub = { active: !!(HUB && HUB.active), info: null, phase: 'wait', card: null, over: false, S: null, view: null, snapN: 0, inN: 0, acc: 0, inAcc: 0, batch: [], adds: [], rmv: [], marks: 0, heard: 0, queues: {}, samples: [], sentObjs: 0,\n  async connect() { const info = this.info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); if (!info) { this.active = false; return null; }\n    HUB.on('card', c => { this.card = c; }); HUB.on('start', () => { if (this.phase === 'wait') this.phase = 'count'; G.sfx.chime && G.sfx.chime(); });\n    HUB.on('message', (d, from) => this.onMessage(d, from)); HUB.on('leave', ({ id }) => { if (this.S && this.S.players[id]) { this.S.players[id].gone = true; G.releaseHold(this.S, this.S.players[id]); } });\n    HUB.on('time-up', () => { if (info.isHost) this.finish(this.S && this.S.done === 'won'); });\n    HUB.on('end', () => { this.phase = 'over'; this.ended = true; const g = G.game; g.audio.music(null); g.audio.mute(true); if (G.sfx) G.sfx.stopLoops(); if (G.choir) G.choir.silence(); });\n    this.build(); HUB.ready(); return info; },\n  build() { const info = this.info, game = G.game, players = info.players.map(q => ({ id: q.id, color: q.color || G.SEATS[q.id] })); const r = HUB.rng('sim'), seed = (r() * 1e9) | 0; this.S = G.Op.create('grandrounds', { seed, difficulty: 'resident', players }); info.players.forEach(q => { this.S.players[q.id].name = q.name; this.S.players[q.id].color = q.color || G.SEATS[q.id]; }); if (!info.isHost) { this.S.objs = []; this.S.ev = []; } if (info.server) return; const seats = []; const me = info.me; if (me !== null && me !== undefined && this.S.players[me]) { seats.push({ pid: me, input: game.input }); } const isHost = info.isHost; this.view = new G.OpView(game, this.S, { seats, mirror: !isHost, music: 'op', remote: isHost ? (inputs, dt) => this.remote(inputs, dt) : null, net: isHost ? { events: L => this.queueEvents(L) } : null }); },\n  // ---- the host ----\n  remote(inputs, dt) { for (const p of this.S.players) { if (p.gone || (this.view && this.view.seats.some(s => s.pid === p.id))) continue; const q = this.queues[p.id]; if (!q) { inputs[p.id] = null; continue; } if (q.s.length > 10) q.s.splice(0, q.s.length - 6); if (q.s.length) { const a = q.s.shift(); q.x = a[0]; q.y = a[1]; q.trig = a[2]; } inputs[p.id] = { x: q.x, y: q.y, tool: q.tool, trig: q.trig, fine: false, gift: q.gift, consult: false, cancel: false, shock: q.shock }; q.gift = false; q.shock = false; } },\n  queueEvents(L) { for (const e of L) { if (e[0] === 'spawn') { const o = G.getObj(this.S, e[4 - 0] === undefined ? e[3] : e[4]); this.pendingAdd = true; continue; } if (e[0] === 'beat' || e[0] === 'tk' || e[0] === 'noterise') continue; if (this.batch.length < 40) this.batch.push(e); } },\n  hostStep(dt) { const S = this.S; if (!this.view && !S.done) { const inputs = []; this.remote(inputs, dt); G.Op.step(S, inputs, dt); this.queueEvents(S.ev); S.ev = []; }\n    this.acc += dt; if (this.acc >= 1 / 12) { this.acc -= 1 / 12; this.sendState(false); } this.evAcc = (this.evAcc || 0) + dt; if (this.evAcc >= .25) { this.evAcc = 0; this.sendEvents(); } if (S.done && !this.over) { this.sendState(true); this.sendEvents(); this.finish(S.done === 'won'); } },\n  sendEvents() { const S = this.S, known = this.known || (this.known = new Set()), add = [], now = new Set(); for (const o of S.objs) { now.add(o.id); if (!known.has(o.id) && add.length < 12) { add.push(o); known.add(o.id); } } const rm = []; for (const id of known) if (!now.has(id)) { rm.push(id); known.delete(id); } const marks = S.marks.slice(this.marks || 0); this.marks = S.marks.length; if (!add.length && !rm.length && !this.batch.length && !marks.length) return; HUB.send({ t: 'e', ev: this.batch.splice(0, 30), add, rm, marks, ph: S.phaseI }); },\n  sendState(rel) { const S = this.S, n = ++this.snapN; const P = S.players.filter(p => !p.gone).map(p => [p.id, Math.round(p.x), Math.round(p.y), G.TOOLS.indexOf(p.toolNext), p.trigPrev >= .3 ? 1 : 0, p.hold ? 1 : 0, Math.round(p.score), Math.round(p.heat * 10) / 10, Math.round(p.fill * 10) / 10, (p.sonar ? 1 : 0) | (p.firing ? 2 : 0)]); const objs = []; let bytes = 90 + P.length * 34; const N = S.objs.length, st = this.sentObjs % Math.max(1, N); for (let i = 0; i < N; i++) { const o = S.objs[(st + i) % N], a = packObj(o); bytes += JSON.stringify(a).length + 1; if (bytes > 1050) { this.sentObjs = (st + i) % Math.max(1, N); break; } objs.push(a); } if (bytes <= 1050) this.sentObjs = 0;\n    const msg = { t: 's', n, ck: Math.round(S.clock * 10), v: Math.round(S.v * 10) / 10, ph: S.phaseI, st: Math.round(S.steady), fl: S.flow, sb: Math.round(S.sinceBeat * 100) / 100, bl: Math.round(S.beatLen * 100) / 100, T: Math.round(S.t * 10) / 10, f: (S.breath ? 1 : 0) | (S.windowOpen ? 2 : 0) | (S.done ? 4 : 0) | (S.done === 'won' ? 8 : 0), p: P, o: objs }; HUB.send(msg, { reliable: !!rel }); },\n  finish(won) { if (this.over) return; this.over = true; const S = this.S, info = this.info; const live = info.players.filter(q => !S.players[q.id].gone).sort((a, b) => S.players[b.id].score - S.players[a.id].score), standings = []; for (const q of live) { const last = standings[standings.length - 1]; if (last && Math.round(S.players[last[0]].score) === Math.round(S.players[q.id].score)) last.push(q.id); else standings.push([q.id]); } const scores = {}, stats = {}; for (const q of info.players) { const p = S.players[q.id]; scores[q.id] = Math.round(p.score); stats[q.id] = { Textbook: p.stats.textbook, Stitches: p.stats.stitches, Slips: p.stats.slips }; }\n    const award = (title, f, unit) => { let b = null, bv = 0; for (const q of live) { const v = f(S.players[q.id]); if (v > bv) { bv = v; b = q; } } return b ? { id: b.id, title, detail: Math.round(bv) + unit } : null; }; const awards = [award('Steadiest Hand', p => { const n = p.stats.textbook + p.stats.clean + p.stats.sloppy; return n ? p.stats.textbook / n * 100 : 0; }, '% Textbook'), award('Needlework', p => p.stats.stitches, ' stitches'), award('Hoover', p => p.stats.suction, ' volume suctioned'), award('Firebrand', p => p.stats.burns, ' burns')].filter(Boolean); HUB.send({ t: 'over', won: !!won }); HUB.finish({ standings, scores, won: !!won, stats, awards }); },\n  // ---- every other copy ----\n  onMessage(d, from) { const info = this.info, S = this.S; if (info.isHost) { const q = this.queues[from] || (this.queues[from] = { s: [], x: 213, y: 116, trig: 0, tool: 'forceps', n: 0 }); if (d.t === 'i') { if (d.n <= q.n) return; q.n = d.n; q.tool = G.TOOLS[d.k] || q.tool; for (const a of d.a) q.s.push(a); } else if (d.t === 'p') { if (d.g) q.gift = true; if (d.sh) q.shock = true; } return; }\n    if (from !== info.host) return; if (d.t === 's') { if (d.n <= this.heard) return; this.heard = d.n; S.clock = d.ck / 10; S.v = d.v; S.steady = d.st; S.flow = d.fl; S.sinceBeat = d.sb; S.beatLen = d.bl; if (d.T > S.t || S.t - d.T > 2) S.t = d.T; S.breath = !!(d.f & 1); S.windowOpen = !!(d.f & 2); if (d.ph !== S.phaseI && d.ph >= 0) S.phaseI = d.ph; for (const a of d.p) { const p = S.players[a[0]]; if (!p) continue; if (!this.view || !this.view.seats.some(s => s.pid === a[0])) { p.nx = a[1]; p.ny = a[2]; } p.toolNext = p.tool = G.TOOLS[a[3]] || p.tool; p.trigPrev = a[4] ? 1 : 0; p.hold = a[5] ? (p.hold || { k: 'net' }) : null; p.score = a[6]; p.heat = a[7]; p.fill = a[8]; p.sonar = !!(a[9] & 1); p.firing = !!(a[9] & 2); } for (const a of d.o) { const o = S.objs.find(q => q.id === a[0]); if (o) unpackObj(o, a); } }\n    else if (d.t === 'e') { for (const o of d.add || []) if (!S.objs.some(q => q.id === o.id)) S.objs.push(o); if (d.rm && d.rm.length) S.objs = S.objs.filter(o => !d.rm.includes(o.id)); for (const m of d.marks || []) S.marks.push(m); if (d.ph !== undefined) S.phaseI = d.ph; for (const e of d.ev || []) if (this.view) this.view.present(e); } else if (d.t === 'over') { this.over = true; S.done = d.won ? 'won' : 'lost'; } },\n  clientStep(dt) { const v = this.view, S = this.S; for (const p of S.players) if (p.nx !== undefined) { const k = Math.min(1, dt * 12); p.x += (p.nx - p.x) * k; p.y += (p.ny - p.y) * k; } const seat = v && v.seats[0]; if (!seat) return; this.smpAcc = (this.smpAcc || 0) + dt; if (this.smpAcc >= 1 / 90) { this.smpAcc -= 1 / 90; const dv = seat.lastDev; this.samples.push([Math.round(seat.cur.x), Math.round(seat.cur.y), dv && dv.trig >= .3 ? 1 : 0]); if (this.samples.length > 6) this.samples.shift(); } const dv = seat.lastDev; if (dv && (dv.gift || dv.shock)) HUB.send({ t: 'p', g: dv.gift ? 1 : 0, sh: dv.shock ? 1 : 0 }, { to: this.info.host }); this.inAcc += dt; if (this.inAcc >= 1 / 15) { this.inAcc -= 1 / 15; const p = S.players[seat.pid], tool = seat.wheelTool || p.toolNext; HUB.send({ t: 'i', n: ++this.inN, k: G.TOOLS.indexOf(seat.tool || tool), a: this.samples.slice() }, { to: this.info.host, reliable: false }); } },\n};\nG.SCENES = G.SCENES || {};\nG.SCENES.hubround = { pausable: true, view: 'overhead', camera: { zoom: false, wheel: false },\n  enter() { const game = G.game; game.saves.canSave = false; this.t = 0; G.music.play('title'); },\n  update(dt) { const game = G.game, I = game.input, h = G.Hub; this.t += dt; game.focus(game.W / 2, game.H / 2, 0); if (h.ended) return; if (h.phase === 'wait' && h.info) { if (I.pressed('confirm') || I.pressed('start')) { HUB.answer('ready'); I.consumeAll(); } if (I.pressed('more')) { HUB.answer('more'); I.consumeAll(); } const c = I.clicked(); if (c) HUB.answer(c[1] > game.H * .78 ? 'more' : 'ready'); } if (h.phase === 'count' && HUB.time() >= 0) { h.phase = 'play'; G.music.play(null); G.music.play('op'); if (h.view) h.view.barkFor('All hands, Doctors. One patient.'); } if (h.phase === 'play' && !h.info) return; if (h.phase === 'play') { if (h.view) { const S = h.S; const seat = h.view.seats[0]; h.view.update(dt); if (seat && S.players[seat.pid]) seat.tool = S.players[seat.pid] && seat.dev ? G.Wheel.update(seat.wheel, S.players[seat.pid].toolNext, G.Cursor.emptyDevice(), 0) : null; if (seat && h.view.mirror) { const wish = seat.wishTool; } } if (h.info.isHost) h.hostStep(dt); else h.clientStep(dt); if (!h.info.isHost && h.view && h.view.seats[0]) { const seat = h.view.seats[0], p = h.S.players[seat.pid], d = seat.lastDev; if (d) { const T = G.Wheel.update(seat.wheel, p.toolNext, Object.assign(G.Cursor.emptyDevice(), { }), 0); if (d.num) p.toolNext = G.TOOLS[d.num - 1]; } } } },\n  draw(r) { const h = G.Hub; if (h.info && h.info.server) return; if ((h.phase === 'play' || h.phase === 'over') && h.view) { h.view.draw(r); return; } r.overlay(g => this.drawCard(g, r)); },\n  drawCard(g, r) { const h = G.Hub, W = r.W, H = r.H, I = G.game.input, info = h.info, c = h.card; G.drawStage(g, 'theatre', W, H, this.t); px.rect(g, 20, 8, W - 40, H - 16, '#d8e4dc'); px.rect(g, 24, 12, W - 48, H - 24, '#f0f6f0'); const ink = '#1c2a2a'; font.title(g, G.GAME_TITLE, W / 2, 16, { scale: 2, align: 'center', colors: ['#0c4a48', '#0c4a48'], depth: 0, outline: false }); font.text(g, 'GRAND ROUNDS: ' + G.HUB_GOAL, W / 2, 38, ink, { align: 'center', outline: false }); if (info) info.players.forEach((q, i) => { const X = 36 + i * ((W - 72) / 4), rd = c && c.ready && c.ready.includes(q.id); px.rect(g, X, 54, 14, 14, q.color); if (rd) font.text(g, '✓', X + 3, 57, '#fff', { outline: false }); font.text(g, String(q.name).slice(0, 12), X + 18, 57, ink, { outline: false }); }); const pad = I.lastDevice === 'gamepad', mouse = I.lastDevice === 'mouse'; const lines = pad ? ['Aim: right stick. Use tool: R2. Pick tool: left stick flick.', 'Steady hand: L2. Long Breath: Triangle.'] : mouse ? ['Aim: mouse. Use tool: left click. Pick tool: wheel or 1-8.', 'Steady hand: Shift. Long Breath: F or middle click.'] : ['Aim: WASD or arrows. Use tool: Space. Pick tool: 1-8, Q, E.', 'Steady hand: Shift. Long Breath: F.']; lines.forEach((l, i) => font.text(g, l, W / 2, 82 + i * 11, ink, { align: 'center', outline: false })); font.text(g, 'One holds the retractor, one cuts. Vitals and clock are shared.', W / 2, 112, ink, { align: 'center', outline: false }); const left = c && c.left != null ? Math.ceil(c.left / 1000) : null; if (h.phase === 'count') { const t = Math.max(1, Math.ceil(-HUB.time() / 1000)); font.text(g, String(t), W / 2, 130, '#a02020', { align: 'center', outline: false, scale: 4 }); } else { font.text(g, c && c.paused ? 'Waiting: more time asked' : c && c.starting ? 'Starting...' : left !== null ? left + ' s' : '', W / 2, 136, '#a02020', { align: 'center', outline: false, scale: 2 }); const lb = I.label('confirm'), lm = I.label('more'); let X = W / 2 - 100 | 0; X += G.drawCap(g, lb, X, H - 40, { pad }) + 3; font.text(g, 'Ready', X, H - 38, ink, { outline: false }); X += 60; X += G.drawCap(g, lm, X, H - 40, { pad }) + 3; font.text(g, c && c.asked ? 'Cancel more time' : 'More time', X, H - 38, ink, { outline: false }); } } };\nwindow.__hubProbe = () => ({ phase: G.Hub.phase, over: G.Hub.over, v: G.Hub.S ? G.Hub.S.v : 0, phaseI: G.Hub.S ? G.Hub.S.phaseI : -1, objs: G.Hub.S ? G.Hub.S.objs.length : 0, t: HUB && HUB.active ? HUB.time() : 0 });\n})();\nEOF\ncat > src/main.js <<'EOF'\n// The game's top level: the engine's game, its input map, standard screens, boot, the idle watcher and attract's start.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {});\nconst inSession = !!(window.AIHub && AIHub.active);\nconst { attack, dash, skill, jump, ...base } = E.Input.DEFAULT;\nconst INPUT = { ...base, useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'], fine: ['Pad6', 'ShiftLeft', 'ShiftRight'], gift: ['Pad3', 'KeyF', 'Mouse1'], consult: ['Pad2', 'KeyC'], drop: ['Pad1', 'KeyX', 'Backspace'],\n  toolPrev: ['Pad4', 'KeyQ', 'WheelUp'], toolNext: ['Pad5', 'KeyE', 'WheelDown'], wheelHold: ['Mouse2'],\n  curU: ['KeyW', 'ArrowUp'], curD: ['KeyS', 'ArrowDown'], curL: ['KeyA', 'ArrowLeft'], curR: ['KeyD', 'ArrowRight'], nudgeU: ['Pad12'], nudgeD: ['Pad13'], nudgeL: ['Pad14'], nudgeR: ['Pad15'],\n  tool1: ['Digit1'], tool2: ['Digit2'], tool3: ['Digit3'], tool4: ['Digit4'], tool5: ['Digit5'], tool6: ['Digit6'], tool7: ['Digit7'], tool8: ['Digit8'],\n  interact: ['Pad0', 'KeyE', 'Enter'], skip: ['Pad2', 'ControlLeft'], log: ['Pad3', 'KeyB'], more: ['Pad3', 'KeyM'],\n  halves: { left: { curU: ['KeyW'], curD: ['KeyS'], curL: ['KeyA'], curR: ['KeyD'], useTool: ['KeyF'], fine: ['KeyG'], gift: ['KeyH'], toolPrev: ['KeyR'], toolNext: ['KeyT'], consult: [], drop: ['KeyY'], wheelHold: [], tool1: [], tool2: [], tool3: [], tool4: [], tool5: [], tool6: [], tool7: [], tool8: [], interact: ['KeyF'], skip: [], log: [], more: [], nudgeU: [], nudgeD: [], nudgeL: [], nudgeR: [] }, right: { curU: ['ArrowUp'], curD: ['ArrowDown'], curL: ['ArrowLeft'], curR: ['ArrowRight'], useTool: ['Period', 'Numpad1'], fine: ['Slash', 'Numpad2'], gift: ['Comma', 'Numpad3'], toolPrev: ['KeyL', 'Numpad4'], toolNext: ['Semicolon', 'Numpad5'], consult: [], drop: ['Quote', 'Numpad6'], wheelHold: [], tool1: [], tool2: [], tool3: [], tool4: [], tool5: [], tool6: [], tool7: [], tool8: [], interact: ['Period'], skip: [], log: [], more: [], nudgeU: [], nudgeD: [], nudgeL: [], nudgeR: [] } } };\nconst openDev = () => { G.game.resume(); G.Dev.toggle(true); };\nconst restartPhase = () => { const op = G.op; if (op && G.game.scene === G.SCENES.op) { G.game.resume(); G.Op.retry(op.S); op.view.ecg.length = 0; op.done = false; } };\nconst items = () => { const g = G.game; if (inSession) return []; const L = [['Dev Mode', openDev]]; if (g && g.scene === G.SCENES.op && G.op) L.push(['Restart Phase', restartPhase]); return L; };\nconst opt = window.__gameOptions || {};\nconst game = G.game = new E.Game(Object.assign({ canvas: 'screen', id: G.GAME_TITLE, res: [426, 240], expand: true, view: 'overhead', touch: 'never', input: INPUT, live: inSession, autoPause: !inSession, corner: !inSession,\n  menu: { items, saves: !inSession, quit: inSession ? false : 'title',\n    controls: { useTool: 'Use tool', fine: 'Steady hand', gift: 'The Steady', consult: 'Consult', drop: 'Drop', toolPrev: 'Previous tool', toolNext: 'Next tool', wheelHold: 'Tool wheel', curU: 'Aim up', curD: 'Aim down', curL: 'Aim left', curR: 'Aim right', nudgeU: 'Nudge up', nudgeD: 'Nudge down', nudgeL: 'Nudge left', nudgeR: 'Nudge right', interact: 'Talk, use', skip: 'Fast-forward', log: 'Backlog', more: false, tool1: false, tool2: false, tool3: false, tool4: false, tool5: false, tool6: false, tool7: false, tool8: false },\n    settings: [{ key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] },\n      { key: 'voices', label: 'Voices', type: 'slider', min: 0, max: 1, step: .05, value: .9, apply: (g, v) => { g.audio.voiceVolume = v; g.audio.applyVolume(); } },\n      { key: 'difficulty', label: 'Difficulty', options: [['intern', 'Intern'], ['resident', 'Resident'], ['attending', 'Attending']], value: 'resident', apply: (g, v) => { if (G.prog && G.applyDiff) G.applyDiff(v); } },\n      { key: 'assist', label: 'Surgical assist', type: 'slider', min: 0, max: 1, step: .05, value: .6 }, { key: 'cursorSpeed', label: 'Cursor speed', type: 'slider', min: .5, max: 1.5, step: .05, value: 1 }, { key: 'swapSticks', label: 'Swap sticks', value: false }, { key: 'sustain', label: 'Sustained tools', options: ['Hold', 'Toggle'], value: 'Hold' }, { key: 'hints', label: 'Hints', value: true }, { key: 'blood', label: 'Blood color', options: ['Surgical', 'Clinical'], value: 'Surgical', apply: (g, v) => { if (G.setBloodColor) G.setBloodColor(v === 'Clinical'); } }, { key: 'textSpeed', label: 'Text speed', type: 'slider', min: .5, max: 2, step: .1, value: 1, apply: (g, v) => { if (G.story) { G.story.talk.speed = 46 * v; G.story._speed = 46 * v; } } }] } }, opt));\nif (typeof document !== 'undefined') G.ui = new E.Shell(game, { tv: true, theme: { paper: 'rgba(6,22,26,.94)', accent: '#5ff0e0', line: 'rgba(95,240,224,.35)', ink: '#e8fbf6', muted: '#8fb8b0', danger: '#ff7a6a' } });\nG.applyDiff = v => { G.prog.diff = v; G.saveProg(); };\ngame.saves.write = () => ({ data: G.prog, place: G.game.scene === G.SCENES.ward ? 'Between cases' : 'Night shift', level: 'Case ' + ((G.prog.flow / 4 | 0) + 1) });\ngame.saves.read = (save) => { G.prog = Object.assign({}, G.prog, save.data); G.saveProg(); G.flowGo(G.prog.flow); };\nG.sfx = new G.Sfx(game); G.babble = new G.Babble(game); G.choir = new G.Choir(game); G.music = new G.Music(game);\nfor (const k in E.SHAPES) void k;\nif (window.ASSETS && window.ASSETS.ward) E.addAssets(window.ASSETS.ward);\n// the dev panel runs over every pausable scene\nfor (const name in G.SCENES) { const sc = G.SCENES[name], up = sc.update, dr = sc.draw; if (!sc.pausable) continue; sc.update = function (dt) { up.call(this, dt); if (!inSession) G.Dev.update(dt); }; sc.draw = function (r) { dr.call(this, r); if (!inSession) G.Dev.draw(r); }; }\n// idle: any pressed action, held code, mouse move, click, stick\nconst IDLE_SCENES = { title: 1, menu: 1, casefiles: 1, lobby: 1 };\nG.idle = 0; let lastMouse = -1;\ngame.hook('input', dt => { const I = game.input, a = I.padAim, m = I.padMove; const active = I.anyPressed() || I.held.size > 0 || I.clicked() || I.mouse.t !== lastMouse || (a && Math.hypot(a[0], a[1]) > .25) || (m && Math.hypot(m[0], m[1]) > .25); lastMouse = I.mouse.t; if (active) { G.idle = 0; G.lastPress = true; } else G.idle += dt; if (!inSession && !game.paused && !(game.shell && game.shell.screen) && G.idle >= 10 && game.scene && IDLE_SCENES[G.sceneName(game.scene)]) { G.idle = 0; game.go('attract'); } });\nG.sceneName = sc => { for (const k in G.SCENES) if (G.SCENES[k] === sc) return k; return null; };\nG.drawTitleArt = (r, t) => { const T = G.SCENES.title; T.t = t; const d = T.draw; d.call(T, r); };\nG.story = G.makeStory(game); G.storyView = new G.StoryView(game); G.wardStory = G.makeWardStory(game);\ngame.debug = { snapshot() { const S = G.op && G.op.S; return { scene: G.sceneName(game.scene), flow: G.prog.flow, op: S ? { caseId: S.caseId, phase: S.phaseI, v: S.v, clock: S.clock, done: S.done, objs: S.objs.length } : null, attract: !!G.attractOn, music: game.settings.music, hub: G.Hub ? G.Hub.phase : null }; } };\nconst hide = () => { };\ngame.start({ scene: inSession ? 'hubround' : 'title', scenes: G.SCENES, boot: { title: G.GAME_TITLE, steps: [['Scrubbing in', () => { G.loadProg(); G.Dev.load(); }], ['Painting the theatre', () => { G.bust('quill', 'neutral'); }], ...(inSession ? [['Calling the round', () => { G.Hub.connect(); }]] : [])] } });\n})();\nEOF\ncat > src/manifest.json <<'EOF'\n{ \"core\": [\"config.js\", \"core/state.js\", \"core/score.js\", \"core/objects.js\", \"core/tools.js\", \"core/cursor.js\", \"core/op.js\", \"core/strains/staccato.js\", \"core/strains/legato.js\", \"core/strains/tremolo.js\", \"core/strains/dacapo.js\", \"core/strains/fermata.js\", \"core/strains/cantor.js\", \"core/strains/device.js\", \"data/cases/ch1.js\", \"data/cases/ch2.js\", \"data/cases/ch3.js\", \"data/cases/ch4.js\", \"data/par.js\", \"bot/autosurgeon.js\"],\n  \"game\": [\"data/story/script1.js\", \"data/story/script2.js\", \"data/story/flow.js\", \"data/barks.js\", \"data/songs.js\", \"art/tissue.js\", \"art/sites.js\", \"art/bust.js\", \"art/objects.js\", \"art/instruments.js\", \"art/glyphs.js\", \"art/stages.js\", \"art/props.js\", \"art/ward-assets.js\", \"art/rigs.js\", \"audio/sfx.js\", \"audio/babble.js\", \"audio/choir.js\", \"audio/music.js\", \"ui/hud.js\", \"ui/dev.js\", \"ui/attract.js\", \"scenes/op.js\", \"scenes/cine.js\", \"scenes/story.js\", \"scenes/flow.js\", \"scenes/ward.js\", \"scenes/lobby.js\", \"net/hub.js\", \"main.js\"] }\nEOF\ncat > tools/build.mjs <<'EOF'\n// Bundles the game into the one HTML file TASK.md names, and writes the exit interview beside it from src/about-data.json.\nimport { readFileSync, writeFileSync, existsSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nimport vm from 'node:vm';\nconst ROOT = new URL('../', import.meta.url), man = JSON.parse(readFileSync(new URL('src/manifest.json', ROOT)));\nconst NAME = 'SecondScalpel-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-061300';\nconst read = p => readFileSync(new URL(p, ROOT), 'utf8'), esc = s => s.replace(/<\\/script/gi, '<\\\\/script');\nconst engine = read('vendor/my-3d2dge/dist/handoff/my-3d2dge.js'), session = read('vendor/hub/session.js');\nconst about = existsSync(new URL('src/about-data.json', ROOT)) ? JSON.parse(read('src/about-data.json')) : null;\nconst game = [...man.core, ...man.game].map(f => read('src/' + f)).join('\\n');\nconst cfg = { goal: 'Save the patient together; best hands top the board', howto: 'Aim: right stick or mouse. Use tool: R2 or click. Tools: left stick or 1-8' };\nconst ctx = { console }; vm.createContext(ctx); vm.runInContext('var My3D2dge;' + engine.slice(0, 0), ctx);\nconst splash = (() => { const c = { console }; c.window = c; vm.createContext(c); vm.runInContext(engine, c); return c.My3D2dge.bootSplash('Second Scalpel'); })();\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>${esc(session)}</script>\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:session-minutes\" content=\"5\">\n<meta name=\"hub:session-goal\" content=\"${cfg.goal}\">\n<meta name=\"hub:session-howto\" content=\"${cfg.howto}\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"><title>Second Scalpel</title>\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#screen{width:100%;height:100%;display:block;image-rendering:pixelated;touch-action:none}html .esh-row small{display:none}html .esh-row:focus-within small{display:block}</style></head>\n<body>${splash}<canvas id=\"screen\"></canvas><script>${esc(engine)}</script><script>${about ? 'window.GAME=window.GA