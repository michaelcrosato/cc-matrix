grep -n \"new E.Story\\|story\\.\\(say\\|update\\|draw\\|start\\|goto\\|log\\|auto\\|skip\\|save\\|load\\|state\\|running\\|open\\|active\\|on\\b\\|flags\\|set\\|get\\)\" API-INDEX.md | cut -c1-400 | head -40; grep -n \"allowJoin\\|addPlayer\\|input.padAim\\|input.padMove\\|padIndex\\|input.rumble\\|lastDevice\\|input.mouse\\|saves.canSave\\|E.Shell\\b\" API-INDEX.md | cut -c1-300 | head -20;  sed -n 1,60p docs/ASSETS.md | cut -c1-300","description":"Check test loader, Story and input API entries"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LFLywGeyNK4w1kPgCfEWdg","type":"tool_result","content":"// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n----\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.89.1</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>\n\n----\n591:- `E.bootSplash(title = '')`: the boot screen's markup, for the very start of a page's <body>: it shows from the first paint, its bar moving while the page's scripts load (a pure CSS animation), and says so if the game's script never runs. The engine takes it over\n1671:- `new E.Story(game, o = {}) → story`: new E.Story(game, { people, nodes, vars, on, dialog }): the talk of a game (the manual above)\n1673:- `story.draw(r)`: draw the balloons over their targets and the box (anywhere in draw: both go to the overlay)\n1675:- `story.get(key)`: a flag or value (key may be a dotted path into vars)\n1680:- `story.set(key, value = true)`: set a flag (value true) or a value\n1681:- `story.state()`: its vars and quests, as JSON (for a save)\n1684:- `story.update(dt)`: run the talk and the balloons; true while a node runs (play waits)\n1685:- `story.auto = 0`: seconds a page shows before it turns by itself (0: it waits for the player)\n1687:- `story.log = []`: what was said and chosen, oldest first ({ who, name, text }, the last 200: a visual novel's backlog)\n1690:- `story.on`: the game's event handlers by name\n1693:- `story.running = false`: a node runs\n1694:- `story.skip = false`: pages type at once and turn at once (choices still wait)\n88:- 1184 21d. Shell; E.Shell: shell\n293:- `input.label(a, device = this.lastDevice)`: the key or button to show in a prompt for action a, on the device the player used last (or the one named: 'keyboard' | 'mouse' | 'gamepad' | 'touch'), with their bindings: input.label('jump') -> 'Space', 'A' or '✕'\n296:- `input.mouseScreen()`: mouse position in projected screen pixels, or null\n309:- `input.rumble(strength = .5, seconds = .15)` †: shake the gamepad: strength 0..1 for seconds (scaled by rumbleScale; nothing where the controller can't). Returns true when it rumbled\n332:- `input.lastDevice = 'keyboard'`: 'keyboard' | 'mouse' | 'gamepad' | 'touch', the last one used (show the right button prompts)\n334:- `input.mouse`: { cx, cy } its page position, active once it has moved over the canvas, t the input clock when it last moved\n337:- `input.padAim = null` †: its right stick, or null when centered\n339:- `input.padId = ''`, `input.padIndex = null`: the gamepad in use (null and '' without one)\n341:- `input.padMove = [0, 0]`: the gamepad's left stick after the dead zone\n345:- `input.rumbleScale = .6` †: vibration strength 0..1 (0 = off; game.settings.rumble sets it)\n476:- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\n479:- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\n499:- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\n555:- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\n637:- `saves.show(mode = 'load', done)` †: open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or a save. False without a menu (a headless game, menu: false)\n639:- `saves.canSave = true` †: the pause menu offers Save (a JRPG turns it off away from save points)\n1186:- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n1187:- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30\n1188:- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n1189:- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\n# Objects and materials as data\n\nThe full engine draws still objects (barrels, tables, trees, wells) from a few lines of data, in every view and facing,\nwith the house shading and outline, and gives every surface (floors, wall faces, wall tops, platform tiles, the objects'\nown faces) a material from one open registry. An object costs one to a few hundred tokens of data (the core's median is\n125); you check it headless with one command. Read this card whole before you write one. (The agent edition keeps the\nregistries and ignores the calls: `E.addAssets` returns empty lists, the others null.)\n\n## Use one\n\n```js\n// in draw(r): feet on the point, depth sorted like an actor; its front toward facing\nr.shape('barrel', x, y, 0, { facing: Math.PI / 2 });\n// once, before the updates: bodies stop at it, a body coming down lands on it, one wholly below passes under\nmap.solid('table', 120, 80, 0, { facing: 0 });\n// a sprite of it, for an inventory or a HUD (r.sprite, px.sprite)\nconst icon = E.shapeSprite('chest', { view: 'iso' });\n```\n\n- **r.shape options:** facing (radians, where the front points: 0 east, π/2 south, as written), scale, mats ({ slot:\n  material }), flip (mirrors it x to -x, collision too), params (a generator's: { h: 30 }), bias, hides (default true),\n  light (adds its lights to game.lights), shadow (default true).\n- **map.solid** takes the same id and placement, so one object can feed both calls. Bodies span z to z + h (E.Body's h, 32).\n- **In 3D** the 3D engine draws the same entries, materials and boxes: `world.shape(id, x, y, z, o)` (its header).\n- **Steep views** (top-down) draw shapes from the characters' lower angle, as rigs are drawn. The light comes from the\n  viewer's upper left in every view.\n- **Glow and fire:** a material with glow: 1 ignores the light and stays bright in the dark; an entry's flames ([[x, y, z,\n  w, h]]) draw the engine's animated flame (r.shape only: a sprite has none). Anything else that moves stays a prop\n  (r.prop) or your own code.\n- **Dressing a generated level:** a scene is a few entries as [id, across, forward] from an anchor (a wall spot, forward\n  into the room); place it whole or not at all, each part on free floor, after the level's own random picks and from a\n  seeded stream of its own, so the level stays as its seed builds it (Emberdeep's `src/emberdeep/53-scenes.js`).\n\n## The core library\n\n**Shapes** (sized for a 26-unit hero; generators take params): barrel, crate, chest, table, chair, stool, bench, bed,\nbookcase, shelf, pot, jar, sack, cart, well, sign, lamppost, anvil; fence { len: 16 }, pine { h: 41, tiers: 4 },\ntree { h: 40, seed: 1 }, bush { r: 7 }, grass { h: 6, n: 6 }, rock { r: 7.5, seed: 2 }, crystal { h: 18, seed: 1 }.\n`r.shape('pine', x, y, 0, { params: { h: 30 } })`; `E.SHAPES.barrel.about` says what each is.\n\n**Materials:** woods oak walnut birch crate plank planks wood; stones stone cobble marble granite sandstone slate rock\nbrick flagstone ruin; metals iron steel gold copper bronze metal rusted; clay glazed porcelain; cloth linen burlap wool velvet leather;\nplants bark needles leaves shrub moss straw hedge grass; ground dirt sand snow mud; water ice crystal flame bone shingle;\nwalls timber plaster; tops speckle plain tiles slab; tiles block bonus ground pipe checker.\n\n## Materials on surfaces\n\n```js\nE.MATERIALS.mossy = { color: '#6a7a5a', pattern: 'stones', size: 6 };   // or the shorthand '#6a7a5a stones size=6'\nconst types = { 1: { h: 32, top: '#6a6280', side: '#4a4360', face: 'cobble', roof: 'slate' } };   // TileMap walls\nconst map = new E.TileMap({ rows, legend, types, floorMat: 'flagstone', floorMats: { water: 'water' } });   // floors\nconst level = new E.PlatformMap({ rows, legend, types: { 1: { kind: 'solid', style: 'block', mat: 'mossy' } } });\n```\n\nfloorMats is keyed by the floor tags of the legend ('~': { floor: 'water' }); either stands in for floorTex.\n\nA material is `{ color, pattern, ...the pattern's numbers, ramp, glow, over }`. Its five tones come from `E.tones(color)`\n(or its own `ramp` of five, dark to light); the light picks a band, the pattern moves it a step, so a material works on\nevery surface and in every palette and recolors with one hex. An unknown name warns with the list of names.\nOverlays, the last on top, each in its own color's tones: `over: [['moss', '#5f7a3a', { up: .6 }], ['cracks']]`; moss on","is_error":false}]},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"ba3c6ea4-c6dc-41fc-8fad-14d9a4608fec","timestamp":"2026-11-05T13:14:00.078Z","tool_use_result":{"stdout":"// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n----\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.89.1</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>\n\n----\n591:- `E.bootSplash(title = '')`: the boot screen's markup, for the very start of a page's <body>: it shows from the first paint, its bar moving while the page's scripts load (a pure CSS animation), and says so if the game's script never runs. The engine takes it over\n1671:- `new E.Story(game, o = {}) → story`: new E.Story(game, { people, nodes, vars, on, dialog }): the talk of a game (the manual above)\n1673:- `story.draw(r)`: draw the balloons over their targets and the box (anywhere in draw: both go to the overlay)\n1675:- `story.get(key)`: a flag or value (key may be a dotted path into vars)\n1680:- `story.set(key, value = true)`: set a flag (value true) or a value\n1681:- `story.state()`: its vars and quests, as JSON (for a save)\n1684:- `story.update(dt)`: run the talk and the balloons; true while a node runs (play waits)\n1685:- `story.auto = 0`: seconds a page shows before it turns by itself (0: it waits for the player)\n1687:- `story.log = []`: what was said and chosen, oldest first ({ who, name, text }, the last 200: a visual novel's backlog)\n1690:- `story.on`: the game's event handlers by name\n1693:- `story.running = false`: a node runs\n1694:- `story.skip = false`: pages type at once and turn at once (choices still wait)\n88:- 1184 21d. Shell; E.Shell: shell\n293:- `input.label(a, device = this.lastDevice)`: the key or button to show in a prompt for action a, on the device the player used last (or the one named: 'keyboard' | 'mouse' | 'gamepad' | 'touch'), with their bindings: input.label('jump') -> 'Space', 'A' or '✕'\n296:- `input.mouseScreen()`: mouse position in projected screen pixels, or null\n309:- `input.rumble(strength = .5, seconds = .15)` †: shake the gamepad: strength 0..1 for seconds (scaled by rumbleScale; nothing where the controller can't). Returns true when it rumbled\n332:- `input.lastDevice = 'keyboard'`: 'keyboard' | 'mouse' | 'gamepad' | 'touch', the last one used (show the right button prompts)\n334:- `input.mouse`: { cx, cy } its page position, active once it has moved over the canvas, t the input clock when it last moved\n337:- `input.padAim = null` †: its right stick, or null when centered\n339:- `input.padId = ''`, `input.padIndex = null`: the gamepad in use (null and '' without one)\n341:- `input.padMove = [0, 0]`: the gamepad's left stick after the dead zone\n345:- `input.rumbleScale = .6` †: vibration strength 0..1 (0 = off; game.settings.rumble sets it)\n476:- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\n479:- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\n499:- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\n555:- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\n637:- `saves.show(mode = 'load', done)` †: open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or a save. False without a menu (a headless game, menu: false)\n639:- `saves.canSave = true` †: the pause menu offers Save (a JRPG turns it off away from save points)\n1186:- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n1187:- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30\n1188:- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n1189:- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\n# Objects and materials as data\n\nThe full engine draws still objects (barrels, tables, trees, wells) from a few lines of data, in every view and facing,\nwith the house shading and outline, and gives every surface (floors, wall faces, wall tops, platform tiles, the objects'\nown faces) a material from one open registry. An object costs one to a few hundred tokens of data (the core's median is\n125); you check it headless with one command. Read this card whole before you write one. (The agent edition keeps the\nregistries and ignores the calls: `E.addAssets` returns empty lists, the others null.)\n\n## Use one\n\n```js\n// in draw(r): feet on the point, depth sorted like an actor; its front toward facing\nr.shape('barrel', x, y, 0, { facing: Math.PI / 2 });\n// once, before the updates: bodies stop at it, a body coming down lands on it, one wholly below passes under\nmap.solid('table', 120, 80, 0, { facing: 0 });\n// a sprite of it, for an inventory or a HUD (r.sprite, px.sprite)\nconst icon = E.shapeSprite('chest', { view: 'iso' });\n```\n\n- **r.shape options:** facing (radians, where the front points: 0 east, π/2 south, as written), scale, mats ({ slot:\n  material }), flip (mirrors it x to -x, collision too), params (a generator's: { h: 30 }), bias, hides (default true),\n  light (adds its lights to game.lights), shadow (default true).\n- **map.solid** takes the same id and placement, so one object can feed both calls. Bodies span z to z + h (E.Body's h, 32).\n- **In 3D** the 3D engine draws the same entries, materials and boxes: `world.shape(id, x, y, z, o)` (its header).\n- **Steep views** (top-down) draw shapes from the characters' lower angle, as rigs are drawn. The light comes from the\n  viewer's upper left in every view.\n- **Glow and fire:** a material with glow: 1 ignores the light and stays bright in the dark; an entry's flames ([[x, y, z,\n  w, h]]) draw the engine's animated flame (r.shape only: a sprite has none). Anything else that moves stays a prop\n  (r.prop) or your own code.\n- **Dressing a generated level:** a scene is a few entries as [id, across, forward] from an anchor (a wall spot, forward\n  into the room); place it whole or not at all, each part on free floor, after the level's own random picks and from a\n  seeded stream of its own, so the level stays as its seed builds it (Emberdeep's `src/emberdeep/53-scenes.js`).\n\n## The core library\n\n**Shapes** (sized for a 26-unit hero; generators take params): barrel, crate, chest, table, chair, stool, bench, bed,\nbookcase, shelf, pot, jar, sack, cart, well, sign, lamppost, anvil; fence { len: 16 }, pine { h: 41, tiers: 4 },\ntree { h: 40, seed: 1 }, bush { r: 7 }, grass { h: 6, n: 6 }, rock { r: 7.5, seed: 2 }, crystal { h: 18, seed: 1 }.\n`r.shape('pine', x, y, 0, { params: { h: 30 } })`; `E.SHAPES.barrel.about` says what each is.\n\n**Materials:** woods oak walnut birch crate plank planks wood; stones stone cobble marble granite sandstone slate rock\nbrick flagstone ruin; metals iron steel gold copper bronze metal rusted; clay glazed porcelain; cloth linen burlap wool velvet leather;\nplants bark needles leaves shrub moss straw hedge grass; ground dirt sand snow mud; water ice crystal flame bone shingle;\nwalls timber plaster; tops speckle plain tiles slab; tiles block bonus ground pipe checker.\n\n## Materials on surfaces\n\n```js\nE.MATERIALS.mossy = { color: '#6a7a5a', pattern: 'stones', size: 6 };   // or the shorthand '#6a7a5a stones size=6'\nconst types = { 1: { h: 32, top: '#6a6280', side: '#4a4360', face: 'cobble', roof: 'slate' } };   // TileMap walls\nconst map = new E.TileMap({ rows, legend, types, floorMat: 'flagstone', floorMats: { water: 'water' } });   // floors\nconst level = new E.PlatformMap({ rows, legend, types: { 1: { kind: 'solid', style: 'block', mat: 'mossy' } } });\n```\n\nfloorMats is keyed by the floor tags of the legend ('~': { floor: 'water' }); either stands in for floorTex.\n\nA material is `{ color, pattern, ...the pattern's numbers, ramp, glow, over }`. Its five tones come from `E.tones(color)`\n(or its own `ramp` of five, dark to light); the light picks a band, the pattern moves it a step, so a material works on\nevery surface and in every palette and recolors with one hex. An unknown name warns with the list of names.\nOverlays, the last on top, each in its own color's tones: `over: [['moss', '#5f7a3a', { up: .6 }], ['cracks']]`; moss on","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LFLywGeyNK4w1kPgCfEWdg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
