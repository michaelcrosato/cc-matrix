{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjsEVKmec82DZ6V2Y78P","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015Lmpd3pTWSrxvaxpaVk5Bn","name":"Bash","input":{"command":"cat > src/art/objects.js <<'EOF'\n// How the things on the table look. Stamps go into the tissue painter (wet, shaded); overlays are pixel art on top. Reads S, changes nothing.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst HUSH = '#5ff0e0', HUSHD = '#0b2a30', LAV = '#b8a0ff';\nconst glow = (g, x, y, r, c, a = .35) => px.blend(g, a, 'add', () => { px.disc(g, x, y, r, c); px.disc(g, x, y, r * .6, c); });\nconst dashLine = (g, pts, from, col, dash = 5, t = 0) => { for (let i = 1; i < pts.length; i++) { const [a, b] = [pts[i - 1], pts[i]], L = Math.hypot(b[0] - a[0], b[1] - a[1]); for (let s = 0; s < L; s += dash * 2) { const k0 = s / L, k1 = Math.min(1, (s + dash) / L); px.line(g, a[0] + (b[0] - a[0]) * k0 | 0, a[1] + (b[1] - a[1]) * k0 | 0, a[0] + (b[0] - a[0]) * k1 | 0, a[1] + (b[1] - a[1]) * k1 | 0, col, 1); } } };\nconst ring = (g, x, y, r, col, n = 18, skip = 1) => { for (let i = 0; i < n; i += skip) { const a = i / n * 6.283, b = (i + .6) / n * 6.283; px.line(g, x + Math.cos(a) * r | 0, y + Math.sin(a) * r | 0, x + Math.cos(b) * r | 0, y + Math.sin(b) * r | 0, col, 1); } };\nconst brackets = (g, x, y, r, col) => { const L = 4; for (const [sx, sy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) { const X = x + sx * r | 0, Y = y + sy * r | 0; px.rect(g, sx < 0 ? X : X - L + 1, Y, L, 1, col); px.rect(g, X, sy < 0 ? Y : Y - L + 1, 1, L, col); } };\nconst plusRing = (g, x, y, col, t) => { ring(g, x, y, 9 + Math.sin(t * 5) * 1, col); px.rect(g, x - 4 | 0, y | 0, 9, 1, col); px.rect(g, x | 0, y - 4 | 0, 1, 9, col); };\nconst hatch = (g, x, y, r, col, t) => { for (let k = -r; k <= r; k += 5) { const a = Math.sqrt(Math.max(0, r * r - k * k)); px.line(g, x + k - a * .5 | 0, y + a | 0, x + k + a * .5 | 0, y - a | 0, col, 1); } };\nconst label = (g, s, x, y, col) => font.text(g, s, x, y, col, { align: 'center', outline: false, shadow: '#000' });\nconst DRAW = G.OBJ_DRAW = {}, STAMP = G.OBJ_STAMP = {};\nconst D = (t, f) => { DRAW[t] = f; }, ST = (t, f) => { STAMP[t] = f; };\nconst Sh = (g, o, c = '#ffffff') => { };\n// ---- stamps ----\nST('pool', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), Math.max(3, G.poolR(o)), -1.1, 'blood'));\nST('laceration', (F, o, X, Y) => { const a = o.ang, c = Math.cos(a) * o.r * .8, s = Math.sin(a) * o.r * .8; F.stampLine([[X(o.x - c), Y(o.y - s)], [X(o.x + c), Y(o.y + s)]], 2.5, -2.6, 'wound'); stampCov(F, o, X, Y); });\nST('patch', (F, o, X, Y) => { F.stampDisc(X(o.x), Y(o.y), o.r, 1.2, 'muscle'); stampCov(F, o, X, Y); });\nconst stampCov = (F, o, X, Y) => { if (!o.cov) return; const N = o.covW; for (let j = 0; j < N; j++) for (let i = 0; i < N; i++) if (o.cov[j * N + i] === 1) F.stampDisc(X(o.x + (i + .5) * 4 - o.r), Y(o.y + (j + .5) * 4 - o.r), 3.2, .9, 'gel'); };\nconst stampWound = (F, o, X, Y, S) => { const a = o.a || 0, L = (o.len || 22) * .55, c = Math.cos(a) * L, s = Math.sin(a) * L, k = 1 - o.si / o.st.length, open = 1.8 + (o.w || 9) * .45 * k, nx = -Math.sin(a) * (open + 2), ny = Math.cos(a) * (open + 2), P = [[X(o.x - c), Y(o.y - s)], [X(o.x + c), Y(o.y + s)]]; F.stampLine(P.map(q => [q[0] + nx, q[1] + ny]), 2.2, 2.2, 'muscle'); F.stampLine(P.map(q => [q[0] - nx, q[1] - ny]), 2.2, 2.2, 'muscle'); F.stampLine(P, open, -4.2, 'wound'); };\nST('wound', stampWound); ST('arteryTear', stampWound);\nST('polyp', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 6, 5, 'bowel'));\nST('mass', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), o.r, 11, 'liver'));\nST('nerve', (F, o, X, Y) => F.stampLine(o.pts.map(p => [X(p[0]), Y(p[1])]), 2, 2, 'gold'));\nST('clot', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 7, 4, 'char'));\nST('legato', (F, o, X, Y, S) => { if (o.stage !== 'under' && o.stage !== 'flee') return; const pts = []; for (let k = 0; k < 8; k++) { const q = G.polyAt(o.route, Math.max(0, o.s - k * 8 * o.dir)); pts.push([X(q[0]), Y(q[1])]); } F.stampLine(pts, 4, 3 + Math.sin(S.t * 6) * .6); });\nST('cantorbody', (F, o, X, Y, S) => { const b = 1 + Math.sin(S.t * 2.2) * .08; for (const [dx, dy, r] of [[-78, -6, 28], [0, -26, 32], [78, -6, 28], [-40, 26, 24], [40, 26, 24]]) F.stampDisc(X(o.x + dx), Y(o.y + dy), r * b, 8, 'hush'); });\nST('can', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 24, 6, 'steel'));\nST('tremolo', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), o.stage === 1 ? 19 : 14, 8, 'hush'));\nST('lobe', (F, o, X, Y) => { if (!o.dead2) F.stampDisc(X(o.x), Y(o.y), 17, o.open ? 9 : 6, o.open ? 'heart' : 'hush'); });\nST('fermata', (F, o, X, Y, S) => { if (!o.hidden || o.mark > 0) F.stampDisc(X(o.x), Y(o.y), 12, 5, 'hush'); });\nST('uvula', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 10, 7, 'heart'));\n// ---- overlays ----\nD('shard', (g, o, x, y, S, t) => { const a = o.pull.a, c = Math.cos(a), s = Math.sin(a), L = 10, steel = o.kind === 'steel', cork = o.kind === 'cork', col = cork ? '#c89a60' : steel ? '#a8b4c0' : '#c8f0f4', hi = cork ? '#f0d0a0' : '#ffffff';\n  if (cork) { px.disc(g, x, y, 5, col); px.disc(g, x - 1, y - 1, 3, hi); } else { px.poly(g, [[x + c * L, y + s * L], [x - s * 4, y + c * 4], [x - c * L * .9, y - s * L * .9], [x + s * 4, y - c * 4]], col); px.line(g, x | 0, y | 0, x + c * L | 0, y + s * L | 0, hi, 1); }\n  if ((t * 2 + o.id) % 1.6 < .12) px.dot(g, x + c * 5 | 0, y + s * 5 | 0, '#ffffff');\n  if (!o.pull.free) { const d = o.pull.depth - o.pull.prog; for (let k = 8; k < 22; k += 4) px.dot(g, x + c * (L + k) | 0, y + s * (L + k) | 0, '#ffffffb0'.slice(0, 7)); px.line(g, x + c * (L + 22) | 0, y + s * (L + 22) | 0, x + Math.cos(a + 2.6) * 5 + c * (L + 22) | 0, y + Math.sin(a + 2.6) * 5 + s * (L + 22) | 0, '#ffffff', 1); px.line(g, x + c * (L + 22) | 0, y + s * (L + 22) | 0, x + Math.cos(a - 2.6) * 5 + c * (L + 22) | 0, y + Math.sin(a - 2.6) * 5 + s * (L + 22) | 0, '#ffffff', 1); } brackets(g, x, y, 9, '#ffffff'); });\nD('laceration', (g, o, x, y) => hatch(g, x, y, o.r, '#6ee0a8'));\nD('patch', (g, o, x, y) => hatch(g, x, y, o.r, '#6ee0a8'));\nconst stitchDots = (g, o, S, ox, oy, t) => { if (o.si >= o.st.length) return; const q = G.stPts(o, S, o.si), b = 1 + (Math.sin(t * 7) > 0 ? 1 : 0); px.disc(g, q[0] + ox, q[1] + oy, 2 + b * .5, '#5aa8ff'); px.disc(g, q[2] + ox, q[3] + oy, 2 + b * .5, '#5aa8ff'); px.dot(g, q[0] + ox, q[1] + oy, '#fff'); px.dot(g, q[2] + ox, q[3] + oy, '#fff'); for (let i = o.si + 1; i < o.st.length; i++) { const z = G.stPts(o, S, i); px.dot(g, z[0] + ox, z[1] + oy, '#3a78c0'); px.dot(g, z[2] + ox, z[3] + oy, '#3a78c0'); } };\nD('wound', (g, o, x, y, S, t, ox, oy) => stitchDots(g, o, S, ox, oy, t));\nD('arteryTear', (g, o, x, y, S, t, ox, oy) => { stitchDots(g, o, S, ox, oy, t); const k = 1 - o.si / o.st.length, b = (S.sinceBeat / S.beatLen); if (b < .35) for (let i = 0; i < 5 * k; i++) { const a = -1.57 + (i - 2) * .4, r = b * 34; px.rect(g, x + Math.cos(a) * r | 0, y + Math.sin(a) * r + b * b * 40 | 0, 2, 2, '#cf2a22'); } });\nD('bleeder', (g, o, x, y, S, t) => { const b = S.sinceBeat / S.beatLen; px.disc(g, x, y, 3, '#7a1216'); px.dot(g, x, y, '#ff8870'); if (b < .4) for (let i = 0; i < 4; i++) { const a = -1.57 + (i - 1.5) * .5, r = b * 22; px.rect(g, x + Math.cos(a) * r | 0, y + Math.sin(a) * r + b * b * 24 | 0, 1 + (i & 1), 1 + (i & 1), '#cf2a22'); } ring(g, x, y, 7, '#ff9a3a', 12); });\nD('polyp', (g, o, x, y, S, t) => ring(g, x, y, 8 + Math.sin(t * 5 + o.id), '#ff9a3a', 14));\nD('guide', (g, o, x, y, S, t, ox, oy) => { const pts = o.pts.map(p => [p[0] + ox, p[1] + oy]), col = o.between && G.beatHot(S) ? '#ff5a7a' : '#c06aff'; dashLine(g, pts, 0, col, 3); let s = 0; const q = G.polyAt(o.pts, o.prog); if (o.prog > 0) { const cut = []; let d = 0; for (let i = 0; i <= 40; i++) { const r = G.polyAt(o.pts, o.prog * i / 40); cut.push([r[0] + ox, r[1] + oy]); } for (let i = 1; i < cut.length; i++) px.line(g, cut[i - 1][0] | 0, cut[i - 1][1] | 0, cut[i][0] | 0, cut[i][1] | 0, '#8c0f14', 2); } px.disc(g, q[0] + ox, q[1] + oy, 3 + (Math.sin(t * 8) > 0 ? 1 : 0), '#e8b0ff'); px.dot(g, q[0] + ox, q[1] + oy, '#fff'); if (o.slur !== undefined) { const w = G.getObj(S, o.slur); if (w && Math.hypot(w.x - o.x, w.y - o.y) < 44) label(g, 'NOW', x, y - 16, '#ffe08a'); } });\nD('mass', (g, o, x, y, S, t) => { if (o.cut) brackets(g, x, y, o.r + 2, '#ffffff'); });\nD('hook', (g, o, x, y, S, t) => { const a = o.pull.a, c = Math.cos(a), s = Math.sin(a); px.line(g, x - c * 26 | 0, y - s * 26 | 0, x + c * 34 | 0, y + s * 34 | 0, '#6a7480', 4); px.line(g, x - c * 26 | 0, y - s * 26 | 0, x + c * 34 | 0, y + s * 34 | 0, '#b8c4d0', 2); if (o.barbs > 0) { for (const k of [-10, 10]) { px.line(g, x + c * k | 0, y + s * k | 0, x + c * k - s * 9 | 0, y + s * k + c * 9 | 0, '#e0e8f0', 2); } } else brackets(g, x + c * 34, y + s * 34, 8, '#fff'); });\nD('clot', (g, o, x, y, S, t) => { if (o.dose) plusRing(g, x, y, '#ffe08a', t); else brackets(g, x, y, 9, '#fff'); });\nD('nerve', () => {});\nD('retractorHandle', (g, o, x, y, S, t) => { px.rect(g, x - 16, y - 4, 40, 8, '#6a7480'); px.rect(g, x - 16, y - 4, 40, 3, '#c8d4e0'); px.line(g, x + 24, y, 268 + (x - o.x) - 22, y, S.windowOpen ? '#fff8c0' : '#3a4048', 1); brackets(g, x, y, 12, '#ffffff'); if (!S.windowOpen) label(g, 'HOLD', x + 4, y - 16, '#fff'); });\nD('windowTarget', (g, o, x, y, S, t) => { if (!S.windowOpen) { px.disc(g, x, y, 13, '#5a2030'); px.line(g, x - 9, y - 9, x + 9, y + 9, '#c8d4e0', 2); px.line(g, x - 9, y + 9, x + 9, y - 9, '#c8d4e0', 2); return; } glow(g, x, y, 14, '#fff8c0', .25); px.disc(g, x, y, 8, '#8a2f3e'); px.disc(g, x - 2, y - 2, 4, '#eb9486'); o.slashed ? brackets(g, x, y, 10, '#fff') : ring(g, x, y, 11, '#c06aff'); });\nD('nest', (g, o, x, y, S, t) => { const k = Math.sin(t * 4 + o.id) * 1.5; glow(g, x, y, 16 + k, HUSH, .28); px.disc(g, x, y, 9, HUSHD); for (let i = 0; i < 7; i++) { const a = i * .9 + t; px.disc(g, x + Math.cos(a) * 6 | 0, y + Math.sin(a) * 5 | 0, 2, HUSH); } if (o.opened) brackets(g, x, y, 11, '#fff'); else ring(g, x, y, 12, '#c06aff', 16, 2); });\nD('bead', (g, o, x, y, S, t) => { const H = o.h || 0; if (o.air > 0) { ring(g, o.tx + (x - o.x), o.ty + (y - o.y), 2 + o.air * 12, HUSH, 12, 2); } px.ell(g, x, y, 3, 1, '#00000080'.slice(0, 7)); const sq = o.air > 0 ? 0 : 1; glow(g, x, y - H, 6, HUSH, .3); px.ell(g, x, y - H, 3 + sq, 3 - sq, HUSH); px.dot(g, x - 1, y - H - 1, '#fff'); px.dot(g, x + 1, y - H, HUSHD); });\nD('legato', (g, o, x, y, S, t, ox, oy) => { if (o.stage === 'under' || o.stage === 'flee') { const q = G.polyAt(o.route, o.s); glow(g, q[0] + ox, q[1] + oy, 8, HUSH, .22); return; } const ex = o.exit[0] + ox, ey = o.exit[1] + oy, hx = o.x + ox, hy = o.y + oy, n = Math.max(2, Math.hypot(hx - ex, hy - ey) / 6 | 0); px.disc(g, ex, ey, 5, '#2a0408'); for (let i = 0; i <= n; i++) { const k = i / n, w = Math.sin(k * 8 + t * 5) * 2; glow(g, ex + (hx - ex) * k + w, ey + (hy - ey) * k - w, 4, HUSH, .14); px.disc(g, ex + (hx - ex) * k + w | 0, ey + (hy - ey) * k - w | 0, 3, i === n ? HUSH : '#2c9a94'); } px.dot(g, hx - 1, hy - 1, '#fff'); if (o.stage === 'out') brackets(g, hx, hy, 8, '#fff'); if (o.stage === 'barb') { const zx = o.zone[0] + ox, zy = o.zone[1] + oy; dashLine(g, [[zx - 18, zy - 18], [zx + 18, zy - 18], [zx + 18, zy + 18], [zx - 18, zy + 18], [zx - 18, zy - 18]], 0, '#ffe08a', 3); label(g, 'LET GO', zx, zy - 28, '#ffe08a'); } const f = o.pulled / o.total; px.rect(g, ex - 16, ey + 14, 32, 3, '#102028'); px.rect(g, ex - 16, ey + 14, 32 * f | 0, 3, HUSH); });\nD('barbspot', (g, o, x, y, S, t) => { px.disc(g, x, y, 4, LAV); ring(g, x, y, 8 + Math.sin(t * 6), '#ff9a3a', 14); });\nD('sliver', (g, o, x, y, S, t) => { for (let i = 0; i < 6; i++) { const k = i * 3; px.disc(g, x - Math.cos(t * 2) * k | 0, y - Math.sin(t * 3) * k | 0, 3 - i * .3, i ? '#2c9a94' : HUSH); } glow(g, x, y, 8, HUSH, .22); o.slashedIt ? brackets(g, x, y, 8, '#fff') : ring(g, x, y, 10, '#c06aff', 16, 2); });\nD('tremolo', (g, o, x, y, S, t) => { const j = o.amp * 1.6, jx = Math.sin(t * 57) * j, jy = Math.cos(t * 43) * j; if (o.stage === 1) { glow(g, x + jx, y + jy, 40 * (.5 + o.amp * .5), HUSH, .12 + o.amp * .12); for (const q of S.objs) if (q.type === 'reed' && !q.dead) { px.line(g, x + jx | 0, y + jy | 0, q.x + (x - o.x) | 0, q.y + (y - o.y) | 0, q.sedated ? '#2c5a5a' : HUSH, 1); } px.disc(g, x + jx, y + jy, 14, '#123a40'); px.disc(g, x + jx, y + jy, 9, HUSH); } else { glow(g, x, y, 18, LAV, .3); px.disc(g, x, y, 12, '#5a3a9a'); px.disc(g, x - 2, y - 2, 7, LAV); const f = o.burnMax ? o.burn / o.burnMax : 0; if (o.stage === 2) { px.rect(g, x - 16, y + 18, 32, 3, '#102028'); px.rect(g, x - 16, y + 18, 32 * f | 0, 3, '#ff9a3a'); ring(g, x, y, 16, o.amp <= .21 ? '#ff9a3a' : '#5a6a70', 18, 2); if (o.free2 && o.pin <= 0) brackets(g, x, y, 15, '#fff'); if (o.pin > 0) label(g, 'PINNED', x, y - 26, '#fff'); } else brackets(g, x, y, 15, '#fff'); } });\nD('reed', (g, o, x, y, S, t) => { const j = o.sedated ? 0 : Math.sin(t * 60 + o.id) * 1.5, fl = !o.sedated && S.sinceBeat < .3; px.line(g, x + j | 0, y + 8, x - j | 0, y - 8, o.sedated ? '#2c5a5a' : HUSH, 3); px.disc(g, x - j, y - 8, 3, o.sedated ? '#2c5a5a' : fl ? '#ffffff' : HUSH); if (fl) { glow(g, x, y, 14, '#c8fff4', .4); } if (!o.sedated) plusRing(g, x, y, fl ? '#ffffff' : '#5a8a88', t); });\nD('dacapo', (g, o, x, y, S, t) => { for (let k = -2; k <= 2; k++) px.line(g, x - 120, y + k * 4 + 16, x + 120, y + k * 4 + 16, '#2c9a94', 1); for (const s of [-1, 1]) { px.rect(g, x + s * 124 - 1, y + 6, 2, 20, HUSH); px.rect(g, x + s * 128 - 1, y + 6, 1, 20, HUSH); px.dot(g, x + s * 120, y + 12, HUSH); px.dot(g, x + s * 120, y + 20, HUSH); } if (o.cd >= 0) { const s = Math.ceil(o.cd) + ''; font.text(g, s, x, y - 56, o.cd < 3 ? '#ff7a6a' : '#fff', { align: 'center', scale: 2, outline: false, shadow: '#000' }); } });\nconst lobeTool = { A: 'Burn', B: 'Slash', C: 'Dose' };\nD('lobe', (g, o, x, y, S, t) => { if (o.dead2) { px.disc(g, x, y, 7, '#2c2a30'); label(g, '×', x, y - 3, '#889'); return; } const k = 1 + Math.sin(t * 3 + o.id) * .08; glow(g, x, y, 22 * k, o.open ? '#ffffff' : HUSH, o.open ? .32 : .16); label(g, o.label, x, y - 30, o.open ? '#fff' : '#6aa8a4'); if (!o.open) { for (let a = 0; a < 6; a++) { const b = a * 1.05 + t * .4; px.line(g, x | 0, y | 0, x + Math.cos(b) * 15 | 0, y + Math.sin(b) * 15 | 0, HUSH, 1); } ring(g, x, y, 15, HUSH); const n = G.lobeNext(o, S); label(g, n.toFixed(0), x, y + 18, '#6aa8a4'); return; } const w = G.OBJ.lobe.want(o, S); if (w === 'cautery') ring(g, x, y, 15, '#ff9a3a'); else if (w === 'scalpel') ring(g, x, y, 15, '#c06aff', 16, 2); else if (w === 'forceps') brackets(g, x, y, 13, '#fff'); else if (w === 'syringe') plusRing(g, x, y, '#ffe08a', t); else { hatch(g, x, y, 13, '#6ee0a8'); px.rect(g, x - 12, y + 18, 24 * (o.salveT || 0) | 0, 2, '#6ee0a8'); } });\nD('dome', (g, o, x, y, S, t) => { const f = o.life / (o.life0 || 5); px.blend(g, .16, 'add', () => px.disc(g, x, y, o.r, LAV)); ring(g, x, y, o.r, LAV, 32); ring(g, x, y, o.r * f, '#fff', 32, 3); });\nD('fermata', (g, o, x, y, S, t) => { const op = o.open > 0, h = op ? 8 : 1; px.ell(g, x, y, 13, h + 1, '#0b2a30'); if (op) { px.ell(g, x, y, 12, h, '#f4f0e8'); px.disc(g, x, y, 6, HUSH); px.disc(g, x, y, 3, '#101018'); ring(g, x, y, 15, '#ff9a3a', 18); } else { px.line(g, x - 13, y, x + 13, y, HUSH, 1); } if (o.stage2 === 3) brackets(g, x, y, 14, '#fff'); for (let i = 0; i < 3; i++) if (i < o.hits) px.disc(g, x - 8 + i * 8, y + 16, 2, '#ff9a3a'); else if (o.stage2 === 1) px.disc(g, x - 8 + i * 8, y + 16, 1, '#556'); });\nD('baton', (g, o, x, y, S, t) => { const c = S.objs.find(q => q.type === 'cantorbody'); px.line(g, o.cx + (x - o.x) | 0, o.cy + 20 + (y - o.y) | 0, x | 0, y | 0, '#6a5ac0', 4); px.line(g, o.cx + (x - o.x) | 0, o.cy + 20 + (y - o.y) | 0, x | 0, y | 0, HUSH, 1); px.disc(g, x, y, 5, o.pause > 0 ? '#fff' : LAV); if (o.pause > 0) { glow(g, x, y, 14, '#fff', .3); ring(g, x, y, 13, '#c06aff', 18); } });\nD('uvula', (g, o, x, y, S, t) => { ring(g, x, y, 11 + Math.sin(t * 5), '#ff9a3a', 16); px.disc(g, x, y, 5, LAV); });\nD('voicebox', (g, o, x, y, S, t) => { glow(g, x, y, 15, S.sinceBeat < .3 ? '#fff' : HUSH, .35); px.disc(g, x, y, 7, LAV); plusRing(g, x, y, S.sinceBeat < .3 ? '#fff' : '#6aa8a4', t); for (let i = 0; i < 3; i++) px.disc(g, x - 8 + i * 8, y + 15, i < o.hits ? 2 : 1, i < o.hits ? HUSH : '#556'); });\nD('repeatSign', (g, o, x, y, S, t) => { const f = o.life / 3; glow(g, x, y, 34, LAV, .28); for (const s of [-1, 1]) { px.rect(g, x + s * 22 - 2, y - 26, 4, 52, '#fff'); px.rect(g, x + s * 28 - 1, y - 26, 2, 52, '#fff'); px.disc(g, x + s * 15, y - 8, 3, '#fff'); px.disc(g, x + s * 15, y + 8, 3, '#fff'); } ring(g, x, y, 32 * f + 8, '#c06aff', 28); });\nD('note', (g, o, x, y, S, t) => { const f = o.pull.prog / o.pull.depth; glow(g, x, y, 12 + f * 30, '#ffffff', .2 + f * .3); px.disc(g, x, y, 5, HUSH); px.rect(g, x + 4, y - 16, 2, 16, '#fff'); px.rect(g, x + 4, y - 16, 7, 2, '#fff'); brackets(g, x, y, 11, '#fff'); });\nD('cantorbody', (g, o, x, y, S, t) => { const mouth = (x2, y2, k) => { const a = (Math.sin(t * 2.4 + k) + 1) * .5; px.ell(g, x2, y2, 12, 2 + a * 6, '#150a30'); px.ell(g, x2, y2, 8, 1 + a * 3, '#5a2a70'); }; if (S.flags.cantor_gone) return; mouth(x - 78, y - 8, 0); mouth(x, y - 34, 2); mouth(x + 78, y - 8, 4); glow(g, x, y - 10, 70, HUSH, .05 + Math.sin(t * 2) * .02); });\nD('screw', (g, o, x, y, S, t) => { px.disc(g, x, y, 5, '#8a98a8'); px.disc(g, x - 1, y - 1, 3, '#d0dae4'); const a = o.turn; px.line(g, x - Math.cos(a) * 4 | 0, y - Math.sin(a) * 4 | 0, x + Math.cos(a) * 4 | 0, y + Math.sin(a) * 4 | 0, '#2a3038', 1); brackets(g, x, y, 8, '#fff'); const f = Math.min(1, o.turn / 18.85); px.rect(g, x - 10, y + 10, 20, 2, '#102028'); px.rect(g, x - 10, y + 10, 20 * f | 0, 2, '#ffe08a'); });\nconst SYM = { tri: '▲', dot: '●', sq: '■' };\nconst symDraw = (g, s, x, y, c) => { if (s === 'tri') px.poly(g, [[x, y - 4], [x + 4, y + 3], [x - 4, y + 3]], c); else if (s === 'dot') px.disc(g, x, y, 3, c); else px.rect(g, x - 3, y - 3, 7, 7, c); };\nD('boardmark', (g, o, x, y, S, t) => { px.rect(g, x - 9, y - 9, 18, 18, '#0c2a20'); symDraw(g, o.sym, x, y, HUSH); label(g, (o.order + 1) + '', x, y - 20, '#fff'); });\nD('lead', (g, o, x, y, S, t) => { px.rect(g, x - 8, y - 2, 16, 4, '#c8a040'); ring(g, x, y, 8, '#ff9a3a', 12); });\nD('wire', (g, o, x, y, S, t) => { px.line(g, x - 26, y - 8, x + 26, y + 8, '#d0d8e0', 2); px.rect(g, x - 8, y - 8, 16, 16, '#101820'); symDraw(g, o.sym, x, y, '#fff'); const pal = S.objs.some(q => q.type === 'lead' && !q.dead) ? '#556' : '#c06aff'; ring(g, x, y, 12, pal, 16, 2); });\nD('can', (g, o, x, y, S, t) => { px.rect(g, x - 26, y - 18, 52, 36, '#7a8894'); px.rect(g, x - 26, y - 18, 52, 6, '#c8d4e0'); px.rect(g, x - 16, y - 4, 32, 12, '#3a4048'); font.text(g, 'DO NOT', x, y - 11, '#101820', { align: 'center', font: 'tiny', outline: false }); brackets(g, x, y, 30, '#fff'); });\n// ---- the whole table ----\nconst siteOpts = {};\nG.fieldOf = (r, S) => { const c = G.Op.caseOf(S); return G.fieldFor(c.site, r.W, r.H, c.seed || 1, c.siteOpt); };\nG.beatShape = (S) => { const k = S.sinceBeat / S.beatLen, a = Math.exp(-((k - .05) ** 2) / .004), b = Math.exp(-((k - .22) ** 2) / .006) * .6; return a + b; };\nG.drawField = (r, S, view) => { const F = G.fieldOf(r, S), OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1, X = v => v + OX, Y = v => v + OY;\n  for (const m of S.marks) { if (m[0] === 'char') F.stampDisc(X(m[1]), Y(m[2]), 5, -.6, 'char'); else if (m[0] === 'scar') { const a = m[3], c = Math.cos(a) * m[4] * .5, s = Math.sin(a) * m[4] * .5; F.stampLine([[X(m[1] - c), Y(m[2] - s)], [X(m[1] + c), Y(m[2] + s)]], 1.4, -1, 'wound'); } }\n  for (const o of S.objs) if (!o.dead && STAMP[o.type] && (!o.hidden || o.mark > 0 || G.CHEATS.reveal)) STAMP[o.type](F, o, X, Y, S);\n  const p0 = view.localPlayer || S.players[0], son = S.players.find(p => p.sonar), lamp = G.Op.caseOf(S).lamp;\n  const fx = { beat: S.static ? 0 : G.beatShape(S) * (S.v < 30 ? 1.25 : 1), breath: Math.sin(S.t * 1.3) * .8, slow: S.breath, lens: son ? { x: X(son.x), y: Y(son.y), r: 38 * (S.doc === 'vale' ? 1.25 : 1) } : null, light: lamp ? [-.42 + Math.sin(S.t * .9) * .34, -.52 + Math.cos(S.t * .6) * .2] : undefined, dim: S.dim, spot: S.dim ? { x: X(p0.x), y: Y(p0.y), r: son ? 46 : 28 } : null };\n  F.shade(fx); const o0 = r.w(0, 0, 0); E.px.rect(r.ctx, 0, 0, r.W, r.H, '#14504a'); r.ctx.imageSmoothingEnabled = false; r.ctx.drawImage(F.cv, o0[0], o0[1]); E.px.reset(r.ctx); };\nG.drawObjects = (g, r, S, view) => { const OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1, t = S.t, hx = v => v + OX;\n  for (const m of S.marks) if (m[0] === 'st') { px.line(g, m[1] + OX, m[2] + OY, m[3] + OX, m[4] + OY, '#a8d4ff', 1); }\n  const order = ['nerve', 'cantorbody', 'dacapo', 'dome']; const ord = o => { const i = order.indexOf(o.type); return i < 0 ? 9 : i; };\n  const L = S.objs.filter(o => !o.dead && G.visible(S, o)).sort((a, b) => ord(a) - ord(b));\n  for (const o of L) { const f = DRAW[o.type]; if (f && !(S.dim && Math.hypot(o.x - view.localPlayer.x, o.y - view.localPlayer.y) > 46 && !(o.mark > 0))) f(g, o, o.x + OX | 0, o.y + OY | 0, S, t, OX, OY); if (S.breath && o.req && o.type !== 'guide') ring(g, o.x + OX | 0, o.y + OY | 0, 17 + Math.sin(S.ht * 6) * 2, '#d8fff8', 16, 2); if (G.CHEATS.radii) ring(g, o.x + OX | 0, o.y + OY | 0, o.r || 12, '#ff00ff', 12); }\n  // the ghosts: what is about to happen, seen a second time\n  if (S.ghosts && S.ghosts.t < S.ghosts.dur) { const i = Math.min(S.ghosts.fr.length - 1, S.ghosts.t * 10 | 0), f = S.ghosts.fr[i]; if (f) { px.blend(g, .4, 'add', () => { for (const q of f.s) { px.disc(g, q[1] + OX, q[2] + OY, q[3] ? 12 : 8, q[3] ? '#ffffff' : '#88c8ff'); } for (const q of f.p) { px.disc(g, q[0] + OX, q[1] + OY, 4, '#d0e0ff'); px.line(g, q[0] + OX, q[1] + OY, q[0] + OX + 8, q[1] + OY + 10, '#d0e0ff', 2); } }); } }\n};\nG.symDraw = symDraw; G.hatchDraw = hatch; G.ringDraw = ring;\n})();\nEOF\ncat > src/art/instruments.js <<'EOF'\n// The eight instruments, drawn from the tip, gloved hand behind and to the right so it never hides the target; and the wheel's 20 x 20 tiles.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px } = E;\nconst glove = (g, x, y, col) => { const T = E.tones(col); px.poly(g, [[x + 9, y + 9], [x + 16, y + 5], [x + 26, y + 9], [x + 34, y + 19], [x + 28, y + 30], [x + 18, y + 26], [x + 11, y + 18]], T.base); px.poly(g, [[x + 18, y + 26], [x + 28, y + 30], [x + 34, y + 19], [x + 30, y + 20], [x + 24, y + 22]], T.sh); px.line(g, x + 12, y + 10, x + 20, y + 7, T.lt, 2); px.poly(g, [[x + 28, y + 30], [x + 34, y + 19], [x + 44, y + 28], [x + 38, y + 40]], E.tones('#d8e4ec').base); };\nconst steel = (g, x0, y0, x1, y1, w = 2) => { px.line(g, x0 | 0, y0 | 0, x1 | 0, y1 | 0, '#5a6a78', w + 1); px.line(g, x0 | 0, y0 | 0, x1 | 0, y1 | 0, '#d8e4ee', w > 1 ? w - 1 : 1); };\nconst IN = {\n  forceps(g, x, y, s, t) { const o = s.closed ? 0 : 4; steel(g, x + o * .4, y - o * .3, x + 18, y + 16); steel(g, x - o * .3, y + o * .5, x + 16, y + 18); },\n  scalpel(g, x, y, s, t) { px.poly(g, [[x, y], [x + 9, y + 5], [x + 7, y + 10]], '#e8f0f8'); if ((t * 1.5) % 1 < .12) px.dot(g, x + 5, y + 4, '#ffffff'); steel(g, x + 7, y + 8, x + 20, y + 20, 3); },\n  suture(g, x, y, s, t) { const a = s.down ? t * 8 : .5; for (let k = 0; k < 6; k++) { const q = k / 5 * 2; px.dot(g, x + Math.cos(q + a) * 5 + 4 | 0, y + Math.sin(q + a) * 5 + 4 | 0, '#e8f0f8'); } steel(g, x + 6, y + 6, x + 20, y + 18); px.line(g, x + 2, y + 1, x + 10, y - 7, '#5aa8ff', 1); },\n  salve(g, x, y, s, t) { px.rect(g, x + 2, y - 1, 6, 5, '#6ee0a8'); px.dot(g, x + 3, y, '#d0ffe8'); steel(g, x + 6, y + 4, x + 20, y + 18, 3); if (s.down) for (let i = 0; i < 2; i++) px.dot(g, x + Math.sin(t * 30 + i) * 6 | 0, y + Math.cos(t * 23 + i) * 6 | 0, '#b0ffe0'); },\n  syringe(g, x, y, s, t) { px.line(g, x, y, x + 7, y + 6, '#e8f0f8', 1); const f = s.fill || 0, bx = x + 7, by = y + 6, ex = x + 19, ey = y + 17; px.line(g, bx, by, ex, ey, '#d8f0ff', 6); px.line(g, bx, by, bx + (ex - bx) * f | 0, by + (ey - by) * f | 0, '#ffe08a', 4); if (f >= 1) px.dot(g, bx + 4 + Math.sin(t * 20) * 3 | 0, by + 4, '#fff'); px.line(g, ex, ey, ex + 5, ey + 5, '#8a98a8', 3); },\n  cautery(g, x, y, s, t) { const hot = s.heat || 0; px.line(g, x, y, x + 6, y + 5, hot > .8 ? '#fff0a0' : hot > .3 ? '#ff9a3a' : '#b0605a', 2); steel(g, x + 6, y + 5, x + 20, y + 18, 3); if (s.down && !s.locked) { px.line(g, x, y, x, y, '#fff', 1); px.disc(g, x, y, 2, '#fff8c0'); } },\n  suction(g, x, y, s, t) { const j = s.down ? Math.sin(t * 60) : 0; px.line(g, x + j | 0, y, x + 9, y + 8, '#8a98a8', 4); px.line(g, x + j | 0, y, x + 9, y + 8, '#d8e4ee', 2); px.line(g, x + 9, y + 8, x + 22, y + 22, '#5a7a8a', 3); },\n  sonar(g, x, y, s, t) { px.disc(g, x + 5, y + 4, 4, '#3a4a58'); px.disc(g, x + 4, y + 3, 2, '#88e8ff'); steel(g, x + 7, y + 7, x + 20, y + 19, 3); },\n};\nG.drawInstrument = (g, tool, x, y, st, col, t) => { glove(g, x + 8, y + 8, col); IN[tool](g, x, y, st, t); };\nconst TILE = {\n  forceps(g, x, y, c) { px.line(g, x + 3, y + 3, x + 14, y + 15, c, 2); px.line(g, x + 8, y + 2, x + 16, y + 13, c, 2); px.line(g, x + 3, y + 3, x + 8, y + 2, c, 1); },\n  scalpel(g, x, y, c) { px.poly(g, [[x + 3, y + 3], [x + 11, y + 6], [x + 7, y + 11]], c); px.line(g, x + 9, y + 9, x + 17, y + 17, c, 3); },\n  suture(g, x, y, c) { for (let k = 0; k < 14; k++) { const a = 3.3 + k / 13 * 3; px.dot(g, x + 10 + Math.cos(a) * 7 | 0, y + 11 + Math.sin(a) * 7 | 0, c); px.dot(g, x + 10 + Math.cos(a) * 6 | 0, y + 11 + Math.sin(a) * 6 | 0, c); } px.line(g, x + 3, y + 12, x + 8, y + 17, c, 1); px.dot(g, x + 16, y + 11, c); },\n  salve(g, x, y, c) { px.rect(g, x + 6, y + 8, 9, 9, c); px.rect(g, x + 8, y + 3, 5, 5, c); px.rect(g, x + 8, y + 10, 5, 1, '#000000'); },\n  syringe(g, x, y, c) { px.line(g, x + 2, y + 2, x + 7, y + 7, c, 1); px.line(g, x + 7, y + 7, x + 14, y + 14, c, 5); px.line(g, x + 14, y + 14, x + 18, y + 18, c, 2); px.line(g, x + 12, y + 17, x + 18, y + 12, c, 1); },\n  cautery(g, x, y, c) { px.line(g, x + 8, y + 9, x + 16, y + 17, c, 3); px.line(g, x + 4, y + 5, x + 8, y + 9, c, 1); for (const [a, b] of [[2, 1], [5, 1], [1, 5]]) px.dot(g, x + a, y + b, c); px.disc(g, x + 3, y + 3, 1, c); },\n  suction(g, x, y, c) { px.line(g, x + 3, y + 4, x + 12, y + 8, c, 3); px.line(g, x + 12, y + 8, x + 12, y + 17, c, 3); px.disc(g, x + 3, y + 4, 2, c); },\n  sonar(g, x, y, c) { px.disc(g, x + 5, y + 14, 3, c); for (const r of [6, 10, 14]) for (let k = 0; k < 8; k++) { const a = -1.4 + k / 7 * 1.3; px.dot(g, x + 5 + Math.cos(a) * r | 0, y + 14 + Math.sin(a) * r | 0, c); } },\n};\nG.toolIcon = (g, tool, x, y, c) => TILE[tool](g, x | 0, y | 0, c);\n})();\nEOF\n","description":"Write object art, instruments and tool icons"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11611,"cache_read_input_tokens":275081,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11611},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"a918005f-9b4e-4450-899f-e36399fd3794","timestamp":"2026-11-05T13:35:53.852Z","request_id":"req_011CgjsEUyBwSV6ShprwR6vk","wire_tool_inputs":{"toolu_015Lmpd3pTWSrxvaxpaVk5Bn":{"command":"cat > src/art/objects.js <<'EOF'\n// How the things on the table look. Stamps go into the tissue painter (wet, shaded); overlays are pixel art on top. Reads S, changes nothing.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px, font } = E;\nconst HUSH = '#5ff0e0', HUSHD = '#0b2a30', LAV = '#b8a0ff';\nconst glow = (g, x, y, r, c, a = .35) => px.blend(g, a, 'add', () => { px.disc(g, x, y, r, c); px.disc(g, x, y, r * .6, c); });\nconst dashLine = (g, pts, from, col, dash = 5, t = 0) => { for (let i = 1; i < pts.length; i++) { const [a, b] = [pts[i - 1], pts[i]], L = Math.hypot(b[0] - a[0], b[1] - a[1]); for (let s = 0; s < L; s += dash * 2) { const k0 = s / L, k1 = Math.min(1, (s + dash) / L); px.line(g, a[0] + (b[0] - a[0]) * k0 | 0, a[1] + (b[1] - a[1]) * k0 | 0, a[0] + (b[0] - a[0]) * k1 | 0, a[1] + (b[1] - a[1]) * k1 | 0, col, 1); } } };\nconst ring = (g, x, y, r, col, n = 18, skip = 1) => { for (let i = 0; i < n; i += skip) { const a = i / n * 6.283, b = (i + .6) / n * 6.283; px.line(g, x + Math.cos(a) * r | 0, y + Math.sin(a) * r | 0, x + Math.cos(b) * r | 0, y + Math.sin(b) * r | 0, col, 1); } };\nconst brackets = (g, x, y, r, col) => { const L = 4; for (const [sx, sy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) { const X = x + sx * r | 0, Y = y + sy * r | 0; px.rect(g, sx < 0 ? X : X - L + 1, Y, L, 1, col); px.rect(g, X, sy < 0 ? Y : Y - L + 1, 1, L, col); } };\nconst plusRing = (g, x, y, col, t) => { ring(g, x, y, 9 + Math.sin(t * 5) * 1, col); px.rect(g, x - 4 | 0, y | 0, 9, 1, col); px.rect(g, x | 0, y - 4 | 0, 1, 9, col); };\nconst hatch = (g, x, y, r, col, t) => { for (let k = -r; k <= r; k += 5) { const a = Math.sqrt(Math.max(0, r * r - k * k)); px.line(g, x + k - a * .5 | 0, y + a | 0, x + k + a * .5 | 0, y - a | 0, col, 1); } };\nconst label = (g, s, x, y, col) => font.text(g, s, x, y, col, { align: 'center', outline: false, shadow: '#000' });\nconst DRAW = G.OBJ_DRAW = {}, STAMP = G.OBJ_STAMP = {};\nconst D = (t, f) => { DRAW[t] = f; }, ST = (t, f) => { STAMP[t] = f; };\nconst Sh = (g, o, c = '#ffffff') => { };\n// ---- stamps ----\nST('pool', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), Math.max(3, G.poolR(o)), -1.1, 'blood'));\nST('laceration', (F, o, X, Y) => { const a = o.ang, c = Math.cos(a) * o.r * .8, s = Math.sin(a) * o.r * .8; F.stampLine([[X(o.x - c), Y(o.y - s)], [X(o.x + c), Y(o.y + s)]], 2.5, -2.6, 'wound'); stampCov(F, o, X, Y); });\nST('patch', (F, o, X, Y) => { F.stampDisc(X(o.x), Y(o.y), o.r, 1.2, 'muscle'); stampCov(F, o, X, Y); });\nconst stampCov = (F, o, X, Y) => { if (!o.cov) return; const N = o.covW; for (let j = 0; j < N; j++) for (let i = 0; i < N; i++) if (o.cov[j * N + i] === 1) F.stampDisc(X(o.x + (i + .5) * 4 - o.r), Y(o.y + (j + .5) * 4 - o.r), 3.2, .9, 'gel'); };\nconst stampWound = (F, o, X, Y, S) => { const a = o.a || 0, L = (o.len || 22) * .55, c = Math.cos(a) * L, s = Math.sin(a) * L, k = 1 - o.si / o.st.length, open = 1.8 + (o.w || 9) * .45 * k, nx = -Math.sin(a) * (open + 2), ny = Math.cos(a) * (open + 2), P = [[X(o.x - c), Y(o.y - s)], [X(o.x + c), Y(o.y + s)]]; F.stampLine(P.map(q => [q[0] + nx, q[1] + ny]), 2.2, 2.2, 'muscle'); F.stampLine(P.map(q => [q[0] - nx, q[1] - ny]), 2.2, 2.2, 'muscle'); F.stampLine(P, open, -4.2, 'wound'); };\nST('wound', stampWound); ST('arteryTear', stampWound);\nST('polyp', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 6, 5, 'bowel'));\nST('mass', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), o.r, 11, 'liver'));\nST('nerve', (F, o, X, Y) => F.stampLine(o.pts.map(p => [X(p[0]), Y(p[1])]), 2, 2, 'gold'));\nST('clot', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 7, 4, 'char'));\nST('legato', (F, o, X, Y, S) => { if (o.stage !== 'under' && o.stage !== 'flee') return; const pts = []; for (let k = 0; k < 8; k++) { const q = G.polyAt(o.route, Math.max(0, o.s - k * 8 * o.dir)); pts.push([X(q[0]), Y(q[1])]); } F.stampLine(pts, 4, 3 + Math.sin(S.t * 6) * .6); });\nST('cantorbody', (F, o, X, Y, S) => { const b = 1 + Math.sin(S.t * 2.2) * .08; for (const [dx, dy, r] of [[-78, -6, 28], [0, -26, 32], [78, -6, 28], [-40, 26, 24], [40, 26, 24]]) F.stampDisc(X(o.x + dx), Y(o.y + dy), r * b, 8, 'hush'); });\nST('can', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 24, 6, 'steel'));\nST('tremolo', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), o.stage === 1 ? 19 : 14, 8, 'hush'));\nST('lobe', (F, o, X, Y) => { if (!o.dead2) F.stampDisc(X(o.x), Y(o.y), 17, o.open ? 9 : 6, o.open ? 'heart' : 'hush'); });\nST('fermata', (F, o, X, Y, S) => { if (!o.hidden || o.mark > 0) F.stampDisc(X(o.x), Y(o.y), 12, 5, 'hush'); });\nST('uvula', (F, o, X, Y) => F.stampDisc(X(o.x), Y(o.y), 10, 7, 'heart'));\n// ---- overlays ----\nD('shard', (g, o, x, y, S, t) => { const a = o.pull.a, c = Math.cos(a), s = Math.sin(a), L = 10, steel = o.kind === 'steel', cork = o.kind === 'cork', col = cork ? '#c89a60' : steel ? '#a8b4c0' : '#c8f0f4', hi = cork ? '#f0d0a0' : '#ffffff';\n  if (cork) { px.disc(g, x, y, 5, col); px.disc(g, x - 1, y - 1, 3, hi); } else { px.poly(g, [[x + c * L, y + s * L], [x - s * 4, y + c * 4], [x - c * L * .9, y - s * L * .9], [x + s * 4, y - c * 4]], col); px.line(g, x | 0, y | 0, x + c * L | 0, y + s * L | 0, hi, 1); }\n  if ((t * 2 + o.id) % 1.6 < .12) px.dot(g, x + c * 5 | 0, y + s * 5 | 0, '#ffffff');\n  if (!o.pull.free) { const d = o.pull.depth - o.pull.prog; for (let k = 8; k < 22; k += 4) px.dot(g, x + c * (L + k) | 0, y + s * (L + k) | 0, '#ffffffb0'.slice(0, 7)); px.line(g, x + c * (L + 22) | 0, y + s * (L + 22) | 0, x + Math.cos(a + 2.6) * 5 + c * (L + 22) | 0, y + Math.sin(a + 2.6) * 5 + s * (L + 22) | 0, '#ffffff', 1); px.line(g, x + c * (L + 22) | 0, y + s * (L + 22) | 0, x + Math.cos(a - 2.6) * 5 + c * (L + 22) | 0, y + Math.sin(a - 2.6) * 5 + s * (L + 22) | 0, '#ffffff', 1); } brackets(g, x, y, 9, '#ffffff'); });\nD('laceration', (g, o, x, y) => hatch(g, x, y, o.r, '#6ee0a8'));\nD('patch', (g, o, x, y) => hatch(g, x, y, o.r, '#6ee0a8'));\nconst stitchDots = (g, o, S, ox, oy, t) => { if (o.si >= o.st.length) return; const q = G.stPts(o, S, o.si), b = 1 + (Math.sin(t * 7) > 0 ? 1 : 0); px.disc(g, q[0] + ox, q[1] + oy, 2 + b * .5, '#5aa8ff'); px.disc(g, q[2] + ox, q[3] + oy, 2 + b * .5, '#5aa8ff'); px.dot(g, q[0] + ox, q[1] + oy, '#fff'); px.dot(g, q[2] + ox, q[3] + oy, '#fff'); for (let i = o.si + 1; i < o.st.length; i++) { const z = G.stPts(o, S, i); px.dot(g, z[0] + ox, z[1] + oy, '#3a78c0'); px.dot(g, z[2] + ox, z[3] + oy, '#3a78c0'); } };\nD('wound', (g, o, x, y, S, t, ox, oy) => stitchDots(g, o, S, ox, oy, t));\nD('arteryTear', (g, o, x, y, S, t, ox, oy) => { stitchDots(g, o, S, ox, oy, t); const k = 1 - o.si / o.st.length, b = (S.sinceBeat / S.beatLen); if (b < .35) for (let i = 0; i < 5 * k; i++) { const a = -1.57 + (i - 2) * .4, r = b * 34; px.rect(g, x + Math.cos(a) * r | 0, y + Math.sin(a) * r + b * b * 40 | 0, 2, 2, '#cf2a22'); } });\nD('bleeder', (g, o, x, y, S, t) => { const b = S.sinceBeat / S.beatLen; px.disc(g, x, y, 3, '#7a1216'); px.dot(g, x, y, '#ff8870'); if (b < .4) for (let i = 0; i < 4; i++) { const a = -1.57 + (i - 1.5) * .5, r = b * 22; px.rect(g, x + Math.cos(a) * r | 0, y + Math.sin(a) * r + b * b * 24 | 0, 1 + (i & 1), 1 + (i & 1), '#cf2a22'); } ring(g, x, y, 7, '#ff9a3a', 12); });\nD('polyp', (g, o, x, y, S, t) => ring(g, x, y, 8 + Math.sin(t * 5 + o.id), '#ff9a3a', 14));\nD('guide', (g, o, x, y, S, t, ox, oy) => { const pts = o.pts.map(p => [p[0] + ox, p[1] + oy]), col = o.between && G.beatHot(S) ? '#ff5a7a' : '#c06aff'; dashLine(g, pts, 0, col, 3); let s = 0; const q = G.polyAt(o.pts, o.prog); if (o.prog > 0) { const cut = []; let d = 0; for (let i = 0; i <= 40; i++) { const r = G.polyAt(o.pts, o.prog * i / 40); cut.push([r[0] + ox, r[1] + oy]); } for (let i = 1; i < cut.length; i++) px.line(g, cut[i - 1][0] | 0, cut[i - 1][1] | 0, cut[i][0] | 0, cut[i][1] | 0, '#8c0f14', 2); } px.disc(g, q[0] + ox, q[1] + oy, 3 + (Math.sin(t * 8) > 0 ? 1 : 0), '#e8b0ff'); px.dot(g, q[0] + ox, q[1] + oy, '#fff'); if (o.slur !== undefined) { const w = G.getObj(S, o.slur); if (w && Math.hypot(w.x - o.x, w.y - o.y) < 44) label(g, 'NOW', x, y - 16, '#ffe08a'); } });\nD('mass', (g, o, x, y, S, t) => { if (o.cut) brackets(g, x, y, o.r + 2, '#ffffff'); });\nD('hook', (g, o, x, y, S, t) => { const a = o.pull.a, c = Math.cos(a), s = Math.sin(a); px.line(g, x - c * 26 | 0, y - s * 26 | 0, x + c * 34 | 0, y + s * 34 | 0, '#6a7480', 4); px.line(g, x - c * 26 | 0, y - s * 26 | 0, x + c * 34 | 0, y + s * 34 | 0, '#b8c4d0', 2); if (o.barbs > 0) { for (const k of [-10, 10]) { px.line(g, x + c * k | 0, y + s * k | 0, x + c * k - s * 9 | 0, y + s * k + c * 9 | 0, '#e0e8f0', 2); } } else brackets(g, x + c * 34, y + s * 34, 8, '#fff'); });\nD('clot', (g, o, x, y, S, t) => { if (o.dose) plusRing(g, x, y, '#ffe08a', t); else brackets(g, x, y, 9, '#fff'); });\nD('nerve', () => {});\nD('retractorHandle', (g, o, x, y, S, t) => { px.rect(g, x - 16, y - 4, 40, 8, '#6a7480'); px.rect(g, x - 16, y - 4, 40, 3, '#c8d4e0'); px.line(g, x + 24, y, 268 + (x - o.x) - 22, y, S.windowOpen ? '#fff8c0' : '#3a4048', 1); brackets(g, x, y, 12, '#ffffff'); if (!S.windowOpen) label(g, 'HOLD', x + 4, y - 16, '#fff'); });\nD('windowTarget', (g, o, x, y, S, t) => { if (!S.windowOpen) { px.disc(g, x, y, 13, '#5a2030'); px.line(g, x - 9, y - 9, x + 9, y + 9, '#c8d4e0', 2); px.line(g, x - 9, y + 9, x + 9, y - 9, '#c8d4e0', 2); return; } glow(g, x, y, 14, '#fff8c0', .25); px.disc(g, x, y, 8, '#8a2f3e'); px.disc(g, x - 2, y - 2, 4, '#eb9486'); o.slashed ? brackets(g, x, y, 10, '#fff') : ring(g, x, y, 11, '#c06aff'); });\nD('nest', (g, o, x, y, S, t) => { const k = Math.sin(t * 4 + o.id) * 1.5; glow(g, x, y, 16 + k, HUSH, .28); px.disc(g, x, y, 9, HUSHD); for (let i = 0; i < 7; i++) { const a = i * .9 + t; px.disc(g, x + Math.cos(a) * 6 | 0, y + Math.sin(a) * 5 | 0, 2, HUSH); } if (o.opened) brackets(g, x, y, 11, '#fff'); else ring(g, x, y, 12, '#c06aff', 16, 2); });\nD('bead', (g, o, x, y, S, t) => { const H = o.h || 0; if (o.air > 0) { ring(g, o.tx + (x - o.x), o.ty + (y - o.y), 2 + o.air * 12, HUSH, 12, 2); } px.ell(g, x, y, 3, 1, '#00000080'.slice(0, 7)); const sq = o.air > 0 ? 0 : 1; glow(g, x, y - H, 6, HUSH, .3); px.ell(g, x, y - H, 3 + sq, 3 - sq, HUSH); px.dot(g, x - 1, y - H - 1, '#fff'); px.dot(g, x + 1, y - H, HUSHD); });\nD('legato', (g, o, x, y, S, t, ox, oy) => { if (o.stage === 'under' || o.stage === 'flee') { const q = G.polyAt(o.route, o.s); glow(g, q[0] + ox, q[1] + oy, 8, HUSH, .22); return; } const ex = o.exit[0] + ox, ey = o.exit[1] + oy, hx = o.x + ox, hy = o.y + oy, n = Math.max(2, Math.hypot(hx - ex, hy - ey) / 6 | 0); px.disc(g, ex, ey, 5, '#2a0408'); for (let i = 0; i <= n; i++) { const k = i / n, w = Math.sin(k * 8 + t * 5) * 2; glow(g, ex + (hx - ex) * k + w, ey + (hy - ey) * k - w, 4, HUSH, .14); px.disc(g, ex + (hx - ex) * k + w | 0, ey + (hy - ey) * k - w | 0, 3, i === n ? HUSH : '#2c9a94'); } px.dot(g, hx - 1, hy - 1, '#fff'); if (o.stage === 'out') brackets(g, hx, hy, 8, '#fff'); if (o.stage === 'barb') { const zx = o.zone[0] + ox, zy = o.zone[1] + oy; dashLine(g, [[zx - 18, zy - 18], [zx + 18, zy - 18], [zx + 18, zy + 18], [zx - 18, zy + 18], [zx - 18, zy - 18]], 0, '#ffe08a', 3); label(g, 'LET GO', zx, zy - 28, '#ffe08a'); } const f = o.pulled / o.total; px.rect(g, ex - 16, ey + 14, 32, 3, '#102028'); px.rect(g, ex - 16, ey + 14, 32 * f | 0, 3, HUSH); });\nD('barbspot', (g, o, x, y, S, t) => { px.disc(g, x, y, 4, LAV); ring(g, x, y, 8 + Math.sin(t * 6), '#ff9a3a', 14); });\nD('sliver', (g, o, x, y, S, t) => { for (let i = 0; i < 6; i++) { const k = i * 3; px.disc(g, x - Math.cos(t * 2) * k | 0, y - Math.sin(t * 3) * k | 0, 3 - i * .3, i ? '#2c9a94' : HUSH); } glow(g, x, y, 8, HUSH, .22); o.slashedIt ? brackets(g, x, y, 8, '#fff') : ring(g, x, y, 10, '#c06aff', 16, 2); });\nD('tremolo', (g, o, x, y, S, t) => { const j = o.amp * 1.6, jx = Math.sin(t * 57) * j, jy = Math.cos(t * 43) * j; if (o.stage === 1) { glow(g, x + jx, y + jy, 40 * (.5 + o.amp * .5), HUSH, .12 + o.amp * .12); for (const q of S.objs) if (q.type === 'reed' && !q.dead) { px.line(g, x + jx | 0, y + jy | 0, q.x + (x - o.x) | 0, q.y + (y - o.y) | 0, q.sedated ? '#2c5a5a' : HUSH, 1); } px.disc(g, x + jx, y + jy, 14, '#123a40'); px.disc(g, x + jx, y + jy, 9, HUSH); } else { glow(g, x, y, 18, LAV, .3); px.disc(g, x, y, 12, '#5a3a9a'); px.disc(g, x - 2, y - 2, 7, LAV); const f = o.burnMax ? o.burn / o.burnMax : 0; if (o.stage === 2) { px.rect(g, x - 16, y + 18, 32, 3, '#102028'); px.rect(g, x - 16, y + 18, 32 * f | 0, 3, '#ff9a3a'); ring(g, x, y, 16, o.amp <= .21 ? '#ff9a3a' : '#5a6a70', 18, 2); if (o.free2 && o.pin <= 0) brackets(g, x, y, 15, '#fff'); if (o.pin > 0) label(g, 'PINNED', x, y - 26, '#fff'); } else brackets(g, x, y, 15, '#fff'); } });\nD('reed', (g, o, x, y, S, t) => { const j = o.sedated ? 0 : Math.sin(t * 60 + o.id) * 1.5, fl = !o.sedated && S.sinceBeat < .3; px.line(g, x + j | 0, y + 8, x - j | 0, y - 8, o.sedated ? '#2c5a5a' : HUSH, 3); px.disc(g, x - j, y - 8, 3, o.sedated ? '#2c5a5a' : fl ? '#ffffff' : HUSH); if (fl) { glow(g, x, y, 14, '#c8fff4', .4); } if (!o.sedated) plusRing(g, x, y, fl ? '#ffffff' : '#5a8a88', t); });\nD('dacapo', (g, o, x, y, S, t) => { for (let k = -2; k <= 2; k++) px.line(g, x - 120, y + k * 4 + 16, x + 120, y + k * 4 + 16, '#2c9a94', 1); for (const s of [-1, 1]) { px.rect(g, x + s * 124 - 1, y + 6, 2, 20, HUSH); px.rect(g, x + s * 128 - 1, y + 6, 1, 20, HUSH); px.dot(g, x + s * 120, y + 12, HUSH); px.dot(g, x + s * 120, y + 20, HUSH); } if (o.cd >= 0) { const s = Math.ceil(o.cd) + ''; font.text(g, s, x, y - 56, o.cd < 3 ? '#ff7a6a' : '#fff', { align: 'center', scale: 2, outline: false, shadow: '#000' }); } });\nconst lobeTool = { A: 'Burn', B: 'Slash', C: 'Dose' };\nD('lobe', (g, o, x, y, S, t) => { if (o.dead2) { px.disc(g, x, y, 7, '#2c2a30'); label(g, '×', x, y - 3, '#889'); return; } const k = 1 + Math.sin(t * 3 + o.id) * .08; glow(g, x, y, 22 * k, o.open ? '#ffffff' : HUSH, o.open ? .32 : .16); label(g, o.label, x, y - 30, o.open ? '#fff' : '#6aa8a4'); if (!o.open) { for (let a = 0; a < 6; a++) { const b = a * 1.05 + t * .4; px.line(g, x | 0, y | 0, x + Math.cos(b) * 15 | 0, y + Math.sin(b) * 15 | 0, HUSH, 1); } ring(g, x, y, 15, HUSH); const n = G.lobeNext(o, S); label(g, n.toFixed(0), x, y + 18, '#6aa8a4'); return; } const w = G.OBJ.lobe.want(o, S); if (w === 'cautery') ring(g, x, y, 15, '#ff9a3a'); else if (w === 'scalpel') ring(g, x, y, 15, '#c06aff', 16, 2); else if (w === 'forceps') brackets(g, x, y, 13, '#fff'); else if (w === 'syringe') plusRing(g, x, y, '#ffe08a', t); else { hatch(g, x, y, 13, '#6ee0a8'); px.rect(g, x - 12, y + 18, 24 * (o.salveT || 0) | 0, 2, '#6ee0a8'); } });\nD('dome', (g, o, x, y, S, t) => { const f = o.life / (o.life0 || 5); px.blend(g, .16, 'add', () => px.disc(g, x, y, o.r, LAV)); ring(g, x, y, o.r, LAV, 32); ring(g, x, y, o.r * f, '#fff', 32, 3); });\nD('fermata', (g, o, x, y, S, t) => { const op = o.open > 0, h = op ? 8 : 1; px.ell(g, x, y, 13, h + 1, '#0b2a30'); if (op) { px.ell(g, x, y, 12, h, '#f4f0e8'); px.disc(g, x, y, 6, HUSH); px.disc(g, x, y, 3, '#101018'); ring(g, x, y, 15, '#ff9a3a', 18); } else { px.line(g, x - 13, y, x + 13, y, HUSH, 1); } if (o.stage2 === 3) brackets(g, x, y, 14, '#fff'); for (let i = 0; i < 3; i++) if (i < o.hits) px.disc(g, x - 8 + i * 8, y + 16, 2, '#ff9a3a'); else if (o.stage2 === 1) px.disc(g, x - 8 + i * 8, y + 16, 1, '#556'); });\nD('baton', (g, o, x, y, S, t) => { const c = S.objs.find(q => q.type === 'cantorbody'); px.line(g, o.cx + (x - o.x) | 0, o.cy + 20 + (y - o.y) | 0, x | 0, y | 0, '#6a5ac0', 4); px.line(g, o.cx + (x - o.x) | 0, o.cy + 20 + (y - o.y) | 0, x | 0, y | 0, HUSH, 1); px.disc(g, x, y, 5, o.pause > 0 ? '#fff' : LAV); if (o.pause > 0) { glow(g, x, y, 14, '#fff', .3); ring(g, x, y, 13, '#c06aff', 18); } });\nD('uvula', (g, o, x, y, S, t) => { ring(g, x, y, 11 + Math.sin(t * 5), '#ff9a3a', 16); px.disc(g, x, y, 5, LAV); });\nD('voicebox', (g, o, x, y, S, t) => { glow(g, x, y, 15, S.sinceBeat < .3 ? '#fff' : HUSH, .35); px.disc(g, x, y, 7, LAV); plusRing(g, x, y, S.sinceBeat < .3 ? '#fff' : '#6aa8a4', t); for (let i = 0; i < 3; i++) px.disc(g, x - 8 + i * 8, y + 15, i < o.hits ? 2 : 1, i < o.hits ? HUSH : '#556'); });\nD('repeatSign', (g, o, x, y, S, t) => { const f = o.life / 3; glow(g, x, y, 34, LAV, .28); for (const s of [-1, 1]) { px.rect(g, x + s * 22 - 2, y - 26, 4, 52, '#fff'); px.rect(g, x + s * 28 - 1, y - 26, 2, 52, '#fff'); px.disc(g, x + s * 15, y - 8, 3, '#fff'); px.disc(g, x + s * 15, y + 8, 3, '#fff'); } ring(g, x, y, 32 * f + 8, '#c06aff', 28); });\nD('note', (g, o, x, y, S, t) => { const f = o.pull.prog / o.pull.depth; glow(g, x, y, 12 + f * 30, '#ffffff', .2 + f * .3); px.disc(g, x, y, 5, HUSH); px.rect(g, x + 4, y - 16, 2, 16, '#fff'); px.rect(g, x + 4, y - 16, 7, 2, '#fff'); brackets(g, x, y, 11, '#fff'); });\nD('cantorbody', (g, o, x, y, S, t) => { const mouth = (x2, y2, k) => { const a = (Math.sin(t * 2.4 + k) + 1) * .5; px.ell(g, x2, y2, 12, 2 + a * 6, '#150a30'); px.ell(g, x2, y2, 8, 1 + a * 3, '#5a2a70'); }; if (S.flags.cantor_gone) return; mouth(x - 78, y - 8, 0); mouth(x, y - 34, 2); mouth(x + 78, y - 8, 4); glow(g, x, y - 10, 70, HUSH, .05 + Math.sin(t * 2) * .02); });\nD('screw', (g, o, x, y, S, t) => { px.disc(g, x, y, 5, '#8a98a8'); px.disc(g, x - 1, y - 1, 3, '#d0dae4'); const a = o.turn; px.line(g, x - Math.cos(a) * 4 | 0, y - Math.sin(a) * 4 | 0, x + Math.cos(a) * 4 | 0, y + Math.sin(a) * 4 | 0, '#2a3038', 1); brackets(g, x, y, 8, '#fff'); const f = Math.min(1, o.turn / 18.85); px.rect(g, x - 10, y + 10, 20, 2, '#102028'); px.rect(g, x - 10, y + 10, 20 * f | 0, 2, '#ffe08a'); });\nconst SYM = { tri: '▲', dot: '●', sq: '■' };\nconst symDraw = (g, s, x, y, c) => { if (s === 'tri') px.poly(g, [[x, y - 4], [x + 4, y + 3], [x - 4, y + 3]], c); else if (s === 'dot') px.disc(g, x, y, 3, c); else px.rect(g, x - 3, y - 3, 7, 7, c); };\nD('boardmark', (g, o, x, y, S, t) => { px.rect(g, x - 9, y - 9, 18, 18, '#0c2a20'); symDraw(g, o.sym, x, y, HUSH); label(g, (o.order + 1) + '', x, y - 20, '#fff'); });\nD('lead', (g, o, x, y, S, t) => { px.rect(g, x - 8, y - 2, 16, 4, '#c8a040'); ring(g, x, y, 8, '#ff9a3a', 12); });\nD('wire', (g, o, x, y, S, t) => { px.line(g, x - 26, y - 8, x + 26, y + 8, '#d0d8e0', 2); px.rect(g, x - 8, y - 8, 16, 16, '#101820'); symDraw(g, o.sym, x, y, '#fff'); const pal = S.objs.some(q => q.type === 'lead' && !q.dead) ? '#556' : '#c06aff'; ring(g, x, y, 12, pal, 16, 2); });\nD('can', (g, o, x, y, S, t) => { px.rect(g, x - 26, y - 18, 52, 36, '#7a8894'); px.rect(g, x - 26, y - 18, 52, 6, '#c8d4e0'); px.rect(g, x - 16, y - 4, 32, 12, '#3a4048'); font.text(g, 'DO NOT', x, y - 11, '#101820', { align: 'center', font: 'tiny', outline: false }); brackets(g, x, y, 30, '#fff'); });\n// ---- the whole table ----\nconst siteOpts = {};\nG.fieldOf = (r, S) => { const c = G.Op.caseOf(S); return G.fieldFor(c.site, r.W, r.H, c.seed || 1, c.siteOpt); };\nG.beatShape = (S) => { const k = S.sinceBeat / S.beatLen, a = Math.exp(-((k - .05) ** 2) / .004), b = Math.exp(-((k - .22) ** 2) / .006) * .6; return a + b; };\nG.drawField = (r, S, view) => { const F = G.fieldOf(r, S), OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1, X = v => v + OX, Y = v => v + OY;\n  for (const m of S.marks) { if (m[0] === 'char') F.stampDisc(X(m[1]), Y(m[2]), 5, -.6, 'char'); else if (m[0] === 'scar') { const a = m[3], c = Math.cos(a) * m[4] * .5, s = Math.sin(a) * m[4] * .5; F.stampLine([[X(m[1] - c), Y(m[2] - s)], [X(m[1] + c), Y(m[2] + s)]], 1.4, -1, 'wound'); } }\n  for (const o of S.objs) if (!o.dead && STAMP[o.type] && (!o.hidden || o.mark > 0 || G.CHEATS.reveal)) STAMP[o.type](F, o, X, Y, S);\n  const p0 = view.localPlayer || S.players[0], son = S.players.find(p => p.sonar), lamp = G.Op.caseOf(S).lamp;\n  const fx = { beat: S.static ? 0 : G.beatShape(S) * (S.v < 30 ? 1.25 : 1), breath: Math.sin(S.t * 1.3) * .8, slow: S.breath, lens: son ? { x: X(son.x), y: Y(son.y), r: 38 * (S.doc === 'vale' ? 1.25 : 1) } : null, light: lamp ? [-.42 + Math.sin(S.t * .9) * .34, -.52 + Math.cos(S.t * .6) * .2] : undefined, dim: S.dim, spot: S.dim ? { x: X(p0.x), y: Y(p0.y), r: son ? 46 : 28 } : null };\n  F.shade(fx); const o0 = r.w(0, 0, 0); E.px.rect(r.ctx, 0, 0, r.W, r.H, '#14504a'); r.ctx.imageSmoothingEnabled = false; r.ctx.drawImage(F.cv, o0[0], o0[1]); E.px.reset(r.ctx); };\nG.drawObjects = (g, r, S, view) => { const OX = (r.W - 426) >> 1, OY = (r.H - 240) >> 1, t = S.t, hx = v => v + OX;\n  for (const m of S.marks) if (m[0] === 'st') { px.line(g, m[1] + OX, m[2] + OY, m[3] + OX, m[4] + OY, '#a8d4ff', 1); }\n  const order = ['nerve', 'cantorbody', 'dacapo', 'dome']; const ord = o => { const i = order.indexOf(o.type); return i < 0 ? 9 : i; };\n  const L = S.objs.filter(o => !o.dead && G.visible(S, o)).sort((a, b) => ord(a) - ord(b));\n  for (const o of L) { const f = DRAW[o.type]; if (f && !(S.dim && Math.hypot(o.x - view.localPlayer.x, o.y - view.localPlayer.y) > 46 && !(o.mark > 0))) f(g, o, o.x + OX | 0, o.y + OY | 0, S, t, OX, OY); if (S.breath && o.req && o.type !== 'guide') ring(g, o.x + OX | 0, o.y + OY | 0, 17 + Math.sin(S.ht * 6) * 2, '#d8fff8', 16, 2); if (G.CHEATS.radii) ring(g, o.x + OX | 0, o.y + OY | 0, o.r || 12, '#ff00ff', 12); }\n  // the ghosts: what is about to happen, seen a second time\n  if (S.ghosts && S.ghosts.t < S.ghosts.dur) { const i = Math.min(S.ghosts.fr.length - 1, S.ghosts.t * 10 | 0), f = S.ghosts.fr[i]; if (f) { px.blend(g, .4, 'add', () => { for (const q of f.s) { px.disc(g, q[1] + OX, q[2] + OY, q[3] ? 12 : 8, q[3] ? '#ffffff' : '#88c8ff'); } for (const q of f.p) { px.disc(g, q[0] + OX, q[1] + OY, 4, '#d0e0ff'); px.line(g, q[0] + OX, q[1] + OY, q[0] + OX + 8, q[1] + OY + 10, '#d0e0ff', 2); } }); } }\n};\nG.symDraw = symDraw; G.hatchDraw = hatch; G.ringDraw = ring;\n})();\nEOF\ncat > src/art/instruments.js <<'EOF'\n// The eight instruments, drawn from the tip, gloved hand behind and to the right so it never hides the target; and the wheel's 20 x 20 tiles.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), { px } = E;\nconst glove = (g, x, y, col) => { const T = E.tones(col); px.poly(g, [[x + 9, y + 9], [x + 16, y + 5], [x + 26, y + 9], [x + 34, y + 19], [x + 28, y + 30], [x + 18, y + 26], [x + 11, y + 18]], T.base); px.poly(g, [[x + 18, y + 26], [x + 28, y + 30], [x + 34, y + 19], [x + 30, y + 20], [x + 24, y + 22]], T.sh); px.line(g, x + 12, y + 10, x + 20, y + 7, T.lt, 2); px.poly(g, [[x + 28, y + 30], [x + 34, y + 19], [x + 44, y + 28], [x + 38, y + 40]], E.tones('#d8e4ec').base); };\nconst steel = (g, x0, y0, x1, y1, w = 2) => { px.line(g, x0 | 0, y0 | 0, x1 | 0, y1 | 0, '#5a6a78', w + 1); px.line(g, x0 | 0, y0 | 0, x1 | 0, y1 | 0, '#d8e4ee', w > 1 ? w - 1 : 1); };\nconst IN = {\n  forceps(g, x, y, s, t) { const o = s.closed ? 0 : 4; steel(g, x + o * .4, y - o * .3, x + 18, y + 16); steel(g, x - o * .3, y + o * .5, x + 16, y + 18); },\n  scalpel(g, x, y, s, t) { px.poly(g, [[x, y], [x + 9, y + 5], [x + 7, y + 10]], '#e8f0f8'); if ((t * 1.5) % 1 < .12) px.dot(g, x + 5, y + 4, '#ffffff'); steel(g, x + 7, y + 8, x + 20, y + 20, 3); },\n  suture(g, x, y, s, t) { const a = s.down ? t * 8 : .5; for (let k = 0; k < 6; k++) { const q = k / 5 * 2; px.dot(g, x + Math.cos(q + a) * 5 + 4 | 0, y + Math.sin(q + a) * 5 + 4 | 0, '#e8f0f8'); } steel(g, x + 6, y + 6, x + 20, y + 18); px.line(g, x + 2, y + 1, x + 10, y - 7, '#5aa8ff', 1); },\n  salve(g, x, y, s, t) { px.rect(g, x + 2, y - 1, 6, 5, '#6ee0a8'); px.dot(g, x + 3, y, '#d0ffe8'); steel(g, x + 6, y + 4, x + 20, y + 18, 3); if (s.down) for (let i = 0; i < 2; i++) px.dot(g, x + Math.sin(t * 30 + i) * 6 | 0, y + Math.cos(t * 23 + i) * 6 | 0, '#b0ffe0'); },\n  syringe(g, x, y, s, t) { px.line(g, x, y, x + 7, y + 6, '#e8f0f8', 1); const f = s.fill || 0, bx = x + 7, by = y + 6, ex = x + 19, ey = y + 17; px.line(g, bx, by, ex, ey, '#d8f0ff', 6); px.line(g, bx, by, bx + (ex - bx) * f | 0, by + (ey - by) * f | 0, '#ffe08a', 4); if (f >= 1) px.dot(g, bx + 4 + Math.sin(t * 20) * 3 | 0, by + 4, '#fff'); px.line(g, ex, ey, ex + 5, ey + 5, '#8a98a8', 3); },\n  cautery(g, x, y, s, t) { const hot = s.heat || 0; px.line(g, x, y, x + 6, y + 5, hot > .8 ? '#fff0a0' : hot > .3 ? '#ff9a3a' : '#b0605a', 2); steel(g, x + 6, y + 5, x + 20, y + 18, 3); if (s.down && !s.locked) { px.line(g, x, y, x, y, '#fff', 1); px.disc(g, x, y, 2, '#fff8c0'); } },\n  suction(g, x, y, s, t) { const j = s.down ? Math.sin(t * 60) : 0; px.line(g, x + j | 0, y, x + 9, y + 8, '#8a98a8', 4); px.line(g, x + j | 0, y, x + 9, y + 8, '#d8e4ee', 2); px.line(g, x + 9, y + 8, x + 22, y + 22, '#5a7a8a', 3); },\n  sonar(g, x, y, s, t) { px.disc(g, x + 5, y + 4, 4, '#3a4a58'); px.disc(g, x + 4, y + 3, 2, '#88e8ff'); steel(g, x + 7, y + 7, x + 20, y + 19, 3); },\n};\nG.drawInstrument = (g, tool, x, y, st, col, t) => { glove(g, x + 8, y + 8, col); IN[tool](g, x, y, st, t); };\nconst TILE = {\n  forceps(g, x, y, c) { px.line(g, x + 3, y + 3, x + 14, y + 15, c, 2); px.line(g, x + 8, y + 2, x + 16, y + 13, c, 2); px.line(g, x + 3, y + 3, x + 8, y + 2, c, 1); },\n  scalpel(g, x, y, c) { px.poly(g, [[x + 3, y + 3], [x + 11, y + 6], [x + 7, y + 11]], c); px.line(g, x + 9, y + 9, x + 17, y + 17, c, 3); },\n  suture(g, x, y, c) { for (let k = 0; k < 14; k++) { const a = 3.3 + k / 13 * 3; px.dot(g, x + 10 + Math.cos(a) * 7 | 0, y + 11 + Math.sin(a) * 7 | 0, c); px.dot(g, x + 10 + Math.cos(a) * 6 | 0, y + 11 + Math.sin(a) * 6 | 0, c); } px.line(g, x + 3, y + 12, x + 8, y + 17, c, 1); px.dot(g, x + 16, y + 11, c); },\n  salve(g, x, y, c) { px.rect(g, x + 6, y + 8, 9, 9, c); px.rect(g, x + 8, y + 3, 5, 5, c); px.rect(g, x + 8, y + 10, 5, 1, '#000000'); },\n  syringe(g, x, y, c) { px.line(g, x + 2, y + 2, x + 7, y + 7, c, 1); px.line(g, x + 7, y + 7, x + 14, y + 14, c, 5); px.line(g, x + 14, y + 14, x + 18, y + 18, c, 2); px.line(g, x + 12, y + 17, x + 18, y + 12, c, 1); },\n  cautery(g, x, y, c) { px.line(g, x + 8, y + 9, x + 16, y + 17, c, 3); px.line(g, x + 4, y + 5, x + 8, y + 9, c, 1); for (const [a, b] of [[2, 1], [5, 1], [1, 5]]) px.dot(g, x + a, y + b, c); px.disc(g, x + 3, y + 3, 1, c); },\n  suction(g, x, y, c) { px.line(g, x + 3, y + 4, x + 12, y + 8, c, 3); px.line(g, x + 12, y + 8, x + 12, y + 17, c, 3); px.disc(g, x + 3, y + 4, 2, c); },\n  sonar(g, x, y, c) { px.disc(g, x + 5, y + 14, 3, c); for (const r of [6, 10, 14]) for (let k = 0; k < 8; k++) { const a = -1.4 + k / 7 * 1.3; px.dot(g, x + 5 + Math.cos(a) * r | 0, y + 14 + Math.sin(a) * r | 0, c); } },\n};\nG.toolIcon = (g, tool, x, y, c) => TILE[tool](g, x | 0, y | 0, c);\n})();\nEOF\n","description":"Write object art, instruments and tool icons"}}}
