{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjra9xPCnhKtKHq2hCiv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B9LUMPMy6b5tDXhvyMWNSZ","name":"Bash","input":{"command":"cd ../../../..; cat > src/data/cases/ch1.js <<'EOF'\n// Chapter 1: First Incision. A case is data: patient, site, clock, vitals, drain, phases. See CONTENT.md.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript, circlePts } = G;\ndefScript('dip40', S => { S.v = Math.min(S.v, 40); });\ndefCase({ id: 'c1', number: 1, title: 'Glasshouse', chapter: 1, doc: 'vale', site: 'forearm', seed: 3, clock: 180, vitals: 80, drain: .1,\n  patient: 'Agnes Pellow, 74', complaint: 'Fell through her own greenhouse roof. Forearm full of glass.', opinion: 'She wants the glass kept for the grandchildren.', story: { before: 'c1_before', after: 'c1_after' }, teach: 'Cursor, wheel, four tools, grades',\n  phases: [\n    { obj: 'Pull the glass', bark: 'Forceps, Doctor. Pull the way it went in.', tut: { verb: 'forceps', text: 'Grip the glass and pull it out along the arrow. Slowly.' }, spawn: [{ t: 'shard', x: 130, y: 104, a: -1.9, depth: 16 }, { t: 'shard', x: 196, y: 138, a: 1.25, depth: 15 }, { t: 'shard', x: 262, y: 88, a: -.8, depth: 18 }, { t: 'shard', x: 306, y: 132, a: .3, depth: 15 }] },\n    { obj: 'Clean the cuts', bark: 'Salve. Paint it on. Nobody grades the brushwork.', tut: { verb: 'salve', text: 'Pick Salve, then hold and paint over the whole cut.' }, spawn: [{ t: 'laceration', x: 140, y: 120, r: 11 }, { t: 'laceration', x: 224, y: 92, r: 12 }, { t: 'laceration', x: 292, y: 118, r: 10 }] },\n    { obj: 'Close the wound', bark: 'Suture. Across the wound, Doctor, not along it.', tut: { verb: 'suture', text: 'Press on a blue dot, cross the wound, let go on the other dot.' }, spawn: [{ t: 'wound', x: 213, y: 116, a: .2, len: 76, n: 4, w: 13, bleeds: false }] },\n    { obj: 'Give her a boost', bark: 'Pressure is dropping. Stimulant to the IV.', enter: 'dip40', when: 'flag:iv', tut: { verb: 'iv', text: 'Pick the Syringe. Hold to fill, let go anywhere to dose the IV.' } },\n  ] });\ndefCase({ id: 'c2', number: 2, title: 'Low Brass', chapter: 1, doc: 'vale', site: 'abdomen', seed: 11, clock: 210, vitals: 70, drain: .2,\n  patient: 'Desmond \"Slide\" Achebe, 58', complaint: 'Trombonist. Pain under the ribs when he holds a long note.', opinion: 'Dr. Whitlock: \"Hernia. Obviously.\"', story: { before: 'c2_before', after: 'c2_after' }, teach: 'Scalpel, Suction, Cautery, excision',\n  lightbox: { film: 'ribs', at: [262, 128], decoys: [[150, 96], [205, 170]], text: 'A round shadow behind the bowel. Not a hernia.', markAt: [213, 116] },\n  phases: [\n    { obj: 'Open him up', bark: 'Scalpel. Follow the marker. It has been to medical school.', tut: { verb: 'scalpel', text: 'Press on the start dot, then trace the purple line in one stroke.' }, spawn: [{ t: 'guide', pts: [[183, 72], [205, 96], [224, 128], [240, 156]] }] },\n    { obj: 'Clear the field', bark: 'Bleeder under that pool. Drain first. Burn second.', tut: { verb: 'suction', text: 'Pick Suction and hold it over the pool.' }, spawn: [{ t: 'pool', x: 150, y: 110, vol: 110, req: true }, { t: 'pool', x: 268, y: 126, vol: 120, req: true }, { t: 'bleeder', x: 268, y: 126 }] },\n    { obj: 'Burn the polyps', bark: 'Cautery. Short bursts. Mind the heat gauge.', tut: { verb: 'cautery', text: 'Pick Cautery and hold the beam on each pink polyp.' }, spawn: [{ t: 'polyp', x: 112, y: 92 }, { t: 'polyp', x: 160, y: 148 }, { t: 'polyp', x: 214, y: 76 }, { t: 'polyp', x: 266, y: 154 }, { t: 'polyp', x: 320, y: 100 }] },\n    { obj: 'Take the mass', bark: 'Ring it, then lift it. Gently. It has a family.', spawn: [{ t: 'mass', x: 213, y: 118, r: 22, leaves: [{ t: 'shard', depth: 12, a: -1.1, kind: 'cork' }] }] },\n    { obj: 'Close him', bark: 'That is a cork, Doctor. I will label it.', spawn: [{ t: 'wound', x: 213, y: 118, a: 1.1, len: 86, n: 6, w: 12, bleeds: false }, { t: 'patch', x: 150, y: 128, r: 14 }] },\n  ] });\ndefScript('crashEnter', S => { S.codeUsed = false; S.objs.forEach(o => { if (o.type === 'pool') o.req = false; }); });\ndefScript('crashStep', (S, ph, w) => { if (S.flags.revived) return; if (S.diff.codeBlue) { S.v = Math.max(0, S.v - 16 * w); } else { S.v = Math.max(14, S.v - 16 * w); if (S.v <= 14) S.flags.revived = true; } });\ndefScript('ruptureEnter', S => { S.steady = 100; for (let i = 0; i < 6; i++) { const a = i / 6 * 6.283; G.spawn(S, { t: 'bleeder', x: 213 + Math.cos(a) * 92, y: 116 + Math.sin(a) * 52, burn: .35, rupture: true, ontop: true }); } });\ndefScript('ruptureStep', (S, ph, w) => { const d = S.ph.d; if (S.tut) return; d.t = (d.t || 0) + w; if (d.t >= 12) { d.t = 0; G.hurt(S, 14); G.ev(S, 'slip', 213, 116, 'rupture', 0); } });\ndefCase({ id: 'c3', number: 3, title: 'Crane Nine', chapter: 1, doc: 'vale', site: 'abdomen', seed: 23, clock: 150, vitals: 55, drain: .5,\n  patient: 'Big Tam Rennie, 49', complaint: 'Crane foreman. The crane came down. He walked to the ambulance.', opinion: 'Everyone senior is at a conference. Quill has checked twice.', story: { before: 'c3_before', after: 'c3_after' }, teach: 'Triage, Code Blue, Long Breath',\n  phases: [\n    { obj: 'Stop the bleeding', bark: 'Three arteries. Pick one. Quickly is a technique.', spawn: [{ t: 'arteryTear', x: 138, y: 96, a: .5 }, { t: 'arteryTear', x: 222, y: 138, a: -.3 }, { t: 'arteryTear', x: 306, y: 96, a: 1.1 }, { t: 'bleeder', x: 176, y: 152 }, { t: 'bleeder', x: 274, y: 150 }, { t: 'pool', x: 120, y: 138, vol: 70 }, { t: 'pool', x: 310, y: 148, vol: 70 }] },\n    { obj: 'Pull the shrapnel', bark: 'Steel, this time. Two under the pools.', spawn: [{ t: 'shard', x: 128, y: 84, a: -2.2, depth: 16, kind: 'steel' }, { t: 'shard', x: 205, y: 92, a: -1.4, depth: 14, kind: 'steel' }, { t: 'shard', x: 292, y: 84, a: -.7, depth: 16, kind: 'steel' }, { t: 'pool', x: 165, y: 134, vol: 130, req: true }, { t: 'shard', x: 165, y: 134, a: 1.9, depth: 14, kind: 'steel' }, { t: 'pool', x: 262, y: 142, vol: 130, req: true }, { t: 'shard', x: 262, y: 142, a: 1.1, depth: 14, kind: 'steel' }] },\n    { obj: \"He's crashing\", bark: 'Pressure is falling through the floor, Doctor.', enter: 'crashEnter', step: 'crashStep', when: 'flag:revived' },\n    { obj: 'Seal the ruptures', bark: 'Six ruptures. Twelve seconds. Doctor? How long is twelve seconds?', enter: 'ruptureEnter', step: 'ruptureStep', tut: { verb: 'gift', text: 'Something is different. Use the Steady: the world slows, your hands do not.' }, tip: { k: 'gift', text: 'Long Breath' } },\n    { obj: 'Close him', bark: 'Close, Doctor. You may shake afterward.', spawn: [{ t: 'wound', x: 213, y: 116, a: -.2, len: 84, n: 5, w: 12, bleeds: false }] },\n  ] });\n})();\nEOF\ncat > src/data/cases/ch2.js <<'EOF'\n// Chapter 2: The Quiet Ones.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript } = G;\ndefScript('nestsStep', S => { const n = S.objs.filter(o => o.type === 'nest' && !o.dead); if (n.length && n.every(o => o.mark > 0)) S.ph.d.done = true; });\ndefScript('swarmEnter', S => { S.flags.swarm = true; S.lacOpt = true; for (const o of S.objs) if (o.type === 'nest') { for (let i = 0; i < 2; i++) G.spawn(S, { t: 'bead', x: o.x, y: o.y }); } });\ndefScript('repairEnter', S => { S.lacOpt = false; S.flags.swarm = false; let n = 0; for (const o of S.objs) if (o.type === 'laceration') { o.req = true; n++; } const pts = [[120, 96], [150, 150], [205, 78], [262, 156], [316, 112], [300, 74]]; for (let i = n; i < 6; i++) G.spawn(S, { t: 'laceration', x: pts[i][0], y: pts[i][1], r: 8 }); });\ndefCase({ id: 'c4', number: 4, title: 'The Whistling Man', chapter: 2, doc: 'vale', site: 'flank', seed: 41, clock: 200, vitals: 75, drain: .25,\n  patient: 'Captain Ned Harrow, 63', complaint: 'Walked into the ER whistling, with a gaff through his side.', opinion: 'Triage: \"Superficial. He is in no pain at all.\"', story: { before: 'c4_before', after: 'c4_after' }, teach: 'Sonar, barbed extraction, the first strain',\n  lightbox: { film: 'spine', at: [158, 92], decoys: [[250, 150], [300, 90]], text: 'Beads of light beside the spine. The film is humming.', moving: true, markAt: [150, 150] },\n  phases: [\n    { obj: 'Free the gaff', bark: 'Barbed. Relief cuts first, Doctor, or it brings friends.', tut: { verb: 'scalpel', text: 'Cut both short lines to free the barbs, then pull the gaff out with Forceps.' }, spawn: [{ t: 'hook', x: 205, y: 112, a: .35, depth: 38 }] },\n    { obj: 'Something moved', bark: 'Sonar, Doctor. Why is there singing in my theatre?', step: 'nestsStep', when: 'done', tut: { verb: 'sonar', text: 'Hold Sonar and sweep. Listen: the song swells and pans toward what is hiding.' }, spawn: [{ t: 'nest', x: 118, y: 110 }, { t: 'nest', x: 300, y: 128 }] },\n    { obj: 'Kill the swarm', bark: 'Burn the beads. Slash the nests. Forceps after.', enter: 'swarmEnter' },\n    { obj: 'Repair the bites', bark: 'Tidy up. He will not thank you. He cannot feel it.', enter: 'repairEnter', spawn: [{ t: 'wound', x: 205, y: 118, a: .35, len: 66, n: 4, w: 11, bleeds: false }] },\n  ] });\nconst SLUR_ROUTE = [[92, 148], [150, 136], [205, 150], [262, 126], [326, 110], [290, 80], [214, 92], [140, 86]];\ndefCase({ id: 'c5', number: 5, title: 'Slur', chapter: 2, doc: 'vale', site: 'forearm', siteOpt: { nerve: true }, seed: 57, clock: 220, vitals: 70, drain: .2,\n  patient: 'Ilse Brandt, 19', complaint: 'Conservatory violinist. Numb left hand. Has never been happier.', opinion: 'She did not want this operation. Her mother signed.', story: { before: 'c5_before', after: 'c5_after' }, teach: 'Legato, fine mode, no-touch anatomy, the clamp',\n  phases: [\n    { obj: 'Find it', bark: 'Something long under there. Sonar. Mind the gold line.', when: 'flag:legato_found', spawn: [{ t: 'nerve', pts: [[70, 118], [130, 112], [200, 120], [270, 112], [356, 118]] }, { t: 'legato', route: SLUR_ROUTE, hidden: true, total: 150, splitAt: 75, spd: 28 }] },\n    { obj: 'Cut as it passes', bark: 'When the ridge reaches the mark, Doctor. Not before.', when: 'flag:legato_out' },\n    { obj: 'The long pull', bark: 'Slowly. Barb: let go in the box. I clamp, you burn.', when: 'flag:legato_half', tip: { k: 'fine', text: 'Steady hand: move slowly' } },\n    { obj: 'It split!', bark: 'A smaller one. Faster. Naturally.', when: 'flag:legato_dead' },\n    { obj: 'Repair the track', bark: 'Fine stitches. She plays with this hand.', spawn: [{ t: 'patch', x: 150, y: 138, r: 15 }, { t: 'patch', x: 276, y: 92, r: 15 }, { t: 'wound', x: 213, y: 148, a: 0, len: 72, n: 5, w: 9, bleeds: false }] },\n  ] });\ndefCase({ id: 'c6', number: 6, title: 'Bedside Manner', chapter: 2, doc: 'vale', site: 'heart', seed: 71, clock: 240, vitals: 60, drain: .35,\n  patient: 'Dr. Marguerite Oyelaran, 61', complaint: 'Chief of Surgery. Collapsed at the Foundation gala, mid-toast.', opinion: 'She left a note on her own chart: \"Do not be sentimental.\"', story: { before: 'c6_before', after: 'c6_after' }, teach: 'The beating heart, timing, tremor, first boss', music: 'boss',\n  phases: [\n    { obj: 'Open the chest', bark: \"It's the Chief, Doctor. So, no pressure. Sternal line.\", spawn: [{ t: 'guide', pts: [[213, 42], [214, 80], [212, 120], [213, 160], [214, 190]] }, { t: 'pool', x: 150, y: 120, vol: 90, req: true }, { t: 'pool', x: 280, y: 112, vol: 90, req: true }] },\n    { obj: 'Sedate on the beat', bark: 'Tremolo. Inject each reed just after the beat. Listen.', when: 'flag:tremolo_dead', spawn: [{ t: 'tremolo', x: 213, y: 112 }], tip: { k: 'gift', text: 'Long Breath stills the tremor' } },\n    { obj: 'Graft the vessel', bark: 'Stitch between beats. She always did hate a rushed graft.', spawn: [{ t: 'wound', x: 213, y: 112, a: -.5, len: 90, n: 6, w: 10, between: true, bleeds: false }, { t: 'patch', x: 142, y: 136, r: 13 }] },\n  ] });\n})();\nEOF\ncat > src/data/cases/ch3.js <<'EOF'\n// Chapter 3: Second Look. The player is Dr. Sokolova, on the hospital ship.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript } = G;\ndefScript('shipRoll', (S) => { S.tilt = [Math.sin(S.t * .55), Math.cos(S.t * .37) * .55]; });\ndefScript('shipFirst', (S, ph, w) => { G.Scripts.shipRoll(S); if (!G.Op.openReq(S) && S.out.lurched) S.ph.d.done = true; });\ndefScript('lurch', (S) => { G.ev(S, 'lurch'); for (const p of S.players) { const first = !S.out.lurched; if (first || p.trigPrev >= .3) { G.releaseHold(S, p); G.slip(S, p, p.x, p.y, 8, 'lurch'); G.addLac(S, p.x, p.y); S.out.look = 1; } } S.out.lurched = true; });\ndefScript('blackoutOn', S => { S.dim = .88; G.ev(S, 'blackout'); });\ndefScript('blackoutOff', S => { S.dim = 0; G.ev(S, 'lights'); });\ndefCase({ id: 'c7', number: 7, title: 'Force Nine', chapter: 3, doc: 'soko', site: 'abdomen', siteOpt: { lamp: true }, seed: 83, clock: 170, vitals: 60, drain: .35,\n  patient: 'Yusuf Demir, 22', complaint: 'Deckhand. A winch came off its mount in a Force Nine.', opinion: 'Dr. Sokolova: \"In the navy we did this with a spoon.\"', story: { before: 'c7_before', after: 'c7_after' }, teach: 'Second Look, the ship\\'s roll, blackout', lamp: true,\n  phases: [\n    { obj: 'Winch damage', bark: 'Everything slides, Doctor. Wait for the roll.', step: 'shipFirst', when: 'done', script: [{ t: 18, do: 'lurch' }], spawn: [{ t: 'shard', x: 135, y: 96, a: -1.9, depth: 14, kind: 'steel', loose: true }, { t: 'shard', x: 206, y: 150, a: 1.3, depth: 14, kind: 'steel', loose: true }, { t: 'shard', x: 262, y: 84, a: -.9, depth: 14, kind: 'steel', loose: true }, { t: 'shard', x: 318, y: 138, a: .4, depth: 14, kind: 'steel', loose: true }, { t: 'arteryTear', x: 170, y: 118, a: .9 }, { t: 'arteryTear', x: 270, y: 124, a: -.5 }] },\n    { obj: 'Blackout: seal bleeders', bark: 'Generator. Naturally. Sonar is all the light you have.', enter: 'blackoutOn', leave: 'blackoutOff', step: 'shipRoll', spawn: [{ t: 'bleeder', x: 130, y: 112, hidden: true, stayMarked: true }, { t: 'bleeder', x: 226, y: 72, hidden: true, stayMarked: true }, { t: 'bleeder', x: 306, y: 146, hidden: true, stayMarked: true }] },\n    { obj: 'Close on the roll', bark: 'The points drift, Doctor. So does the Atlantic.', step: 'shipRoll', spawn: [{ t: 'wound', x: 213, y: 118, a: .1, len: 110, n: 8, w: 11, shift: 6, bleeds: false }] },\n  ] });\ndefCase({ id: 'c8', number: 8, title: 'From the Top', chapter: 3, doc: 'soko', site: 'abdomen', seed: 97, clock: 210, vitals: 65, drain: .3,\n  patient: 'Sister Perpetua, 71', complaint: 'Runs the seamen\\'s hospice. Radiant, serene, and in organ failure.', opinion: 'She has asked us to pray for the other patients.', story: { before: 'c8_before', after: 'c8_after' }, teach: 'Da Capo, planning with ghosts', music: 'boss',\n  phases: [\n    { obj: 'Open and clear', bark: 'A clean line, dear. She will inspect it.', spawn: [{ t: 'guide', pts: [[160, 62], [190, 92], [228, 108], [266, 134]] }, { t: 'pool', x: 130, y: 128, vol: 90, req: true }, { t: 'pool', x: 300, y: 104, vol: 90, req: true }] },\n    { obj: 'Kill all three lobes', bark: 'A burn. B slash, pull. C dose, salve. All inside ten seconds.', when: 'flag:dacapo_r1', spawn: [{ t: 'dacapo', x: 213, y: 112 }], tip: { k: 'gift', text: 'Rewind: ghosts show when lobes open' } },\n    { obj: 'From the top. Faster', bark: 'It has repeated itself, Doctor. So have I.', when: 'flag:dacapo_r2', enter: 'dacapoBeads', spawn: [{ t: 'dacapo', x: 213, y: 112, round: 2, window: 12 }] },\n    { obj: 'Close', bark: 'Close. She will want the good thread.', spawn: [{ t: 'wound', x: 213, y: 124, a: -.1, len: 84, n: 6, w: 11, bleeds: false }] },\n  ] });\ndefScript('boardEnter', S => { [[188, 106, 0], [213, 124, 1], [240, 106, 2]].forEach(([x, y, o]) => G.spawn(S, { t: 'boardmark', x, y, order: o, sym: ['dot', 'tri', 'sq'][o] })); });\ndefScript('boardStep', S => { if ((S.flags.board || 0) >= 3) S.ph.d.done = true; });\nG.OBJ.wire.slashable = (o, S) => !S.objs.some(q => q.type === 'lead' && !q.dead);\nconst prevWant = G.OBJ.wire.want; G.OBJ.wire.want = (o, S) => S.objs.some(q => q.type === 'lead' && !q.dead) ? null : prevWant(o, S);\ndefCase({ id: 'c9', number: 9, title: \"Dead Man's Rhythm\", chapter: 3, doc: 'soko', site: 'implant', seed: 113, clock: 200, vitals: 70, drain: .25, bomb: true,\n  patient: 'Dr. Hollis Crane, 44', complaint: 'Foundation researcher. His pacemaker detonates if his heart stops, or if the can is forced.', opinion: 'Dr. Sokolova: \"We are doctors.\" Quill: \"I\\'ll fetch the other forceps.\"', story: { before: 'c9_before', after: 'c9_after' }, teach: 'A device instead of a disease',\n  phases: [\n    { obj: 'Expose the can', bark: 'Vitals under twenty-five and the ship goes. I mention it.', spawn: [{ t: 'guide', pts: [[150, 62], [210, 58], [276, 64]] }, { t: 'pool', x: 124, y: 118, vol: 80, req: true }, { t: 'pool', x: 306, y: 122, vol: 80, req: true }] },\n    { obj: 'Four screws', bark: 'Forceps. Grip and circle. Three full turns each.', spawn: [{ t: 'screw', x: 160, y: 76 }, { t: 'screw', x: 268, y: 76 }, { t: 'screw', x: 160, y: 156 }, { t: 'screw', x: 268, y: 156 }], tip: { k: 'text', text: 'Circle your aim, three turns' } },\n    { obj: 'Sonar the board', bark: 'He says ▲ ● ■. Trust him? Read the board yourself.', enter: 'boardEnter', step: 'boardStep', when: 'done' },\n    { obj: 'Bypass, then cut', bark: 'Solder the bypass, then cut in the order the board gave.', spawn: [{ t: 'lead', x: 168, y: 90 }, { t: 'lead', x: 260, y: 90 }, { t: 'wire', x: 170, y: 122, order: 1, sym: 'tri' }, { t: 'wire', x: 214, y: 134, order: 0, sym: 'dot' }, { t: 'wire', x: 258, y: 122, order: 2, sym: 'sq' }] },\n    { obj: 'Lift it, gently', bark: 'Now lift. Very gently. We are rolling.', step: 'shipRoll', spawn: [{ t: 'can', x: 213, y: 116 }], enter: 'canEnter' },\n    { obj: 'Close', bark: 'I shall fetch the other forceps back.', spawn: [{ t: 'wound', x: 213, y: 116, a: 0, len: 76, n: 5, w: 11, bleeds: false }] },\n  ] });\ndefScript('canEnter', S => { S.tilt = [0, 0]; });\n})();\nEOF\ncat > src/data/cases/ch4.js <<'EOF'\n// Chapter 4: Coda. Both doctors, and the Cantor.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript, spiralPts } = G;\ndefScript('fermataEnter', S => { S.steady = Math.max(S.steady, 60); });\ndefScript('fermata2Step', S => { if (S.flags.fermata_found && !S.objs.some(o => o.type === 'sliver' && !o.dead)) S.ph.d.done = true; });\nconst NERVES = [{ t: 'nerve', pts: [[86, 74], [130, 96], [180, 70], [226, 88]] }, { t: 'nerve', pts: [[230, 164], [276, 150], [330, 158]] }, { t: 'nerve', pts: [[110, 160], [150, 142], [196, 166]] }];\ndefCase({ id: 'c10', number: 10, title: 'Eloquent Cortex', chapter: 4, doc: 'both', site: 'brain', seed: 131, clock: 240, vitals: 60, drain: .3,\n  patient: 'Dr. Percival Whitlock, 29', complaint: 'Collapsed mid-sentence, smiling. \"It\\'s finally quiet.\"', opinion: 'His own handwriting on his own chart: \"Migraine.\"', story: { before: 'c10_before', after: 'c10_after' }, teach: 'Consult: two doctors, two gifts', music: 'boss',\n  lightbox: { film: 'skull', at: [176, 104], decoys: [[250, 90], [226, 150]], text: 'Not a migraine. An eye. It is looking back.', markAt: [150, 90] },\n  phases: [\n    { obj: 'Open the scalp', bark: 'Your hands, Dr. Sokolova. Hers next. Try to share.', spawn: [...NERVES, { t: 'guide', pts: [[120, 54], [170, 40], [230, 38], [290, 52], [320, 76]] }, { t: 'pool', x: 240, y: 112, vol: 90, req: true }] },\n    { obj: 'Burn the eye as it opens', bark: 'Inside a dome, nothing happens. Nothing at all.', when: 'flag:fermata1', enter: 'fermataEnter', spawn: [{ t: 'fermata', x: 150, y: 110 }], tut: { verb: 'consult', text: 'Consult hands over to the other doctor: Vale stretches the moment, Sokolova takes it back.' }, tip: { k: 'consult', text: 'Consult' } },\n    { obj: 'Find the eye', bark: 'It moved. Dr. Vale\\'s Sonar reaches further.', enter: 'fermataFlee', step: 'fermata2Step', when: 'done' },\n    { obj: 'The gentle pull', bark: 'Gently. This is the part of him that does crosswords.', enter: 'fermataPull', when: 'flag:fermata_dead', tip: { k: 'fine', text: 'Steady hand: a very light pull' } },\n    { obj: 'Close', bark: 'Fine stitches. He will complain about them. Good.', spawn: [{ t: 'wound', x: 200, y: 118, a: .2, len: 76, n: 6, w: 9, bleeds: false }, { t: 'patch', x: 300, y: 112, r: 13 }] },\n  ] });\nconst mkBody = { t: 'cantorbody', x: 213, y: 104 };\ndefScript('c11open', S => { S.lacOpt = true; });\ndefScript('cantor3enter', S => { S.ringOn = true; S.steady = Math.max(S.steady, 50); });\ndefCase({ id: 'c11', number: 11, title: 'Last Note', chapter: 4, doc: 'both', site: 'mediastinum', seed: 149, clock: 420, vitals: 70, drain: .3,\n  patient: 'Clementine Hale, 19', complaint: 'Patient zero. Has felt nothing since she was nine. Everything is singing to her.', opinion: 'Her father carried her in himself.', story: { before: 'c11_before', after: 'c11_after' }, teach: 'All tools, both gifts, everything you know', music: 'final',\n  phases: [\n    { obj: 'Open the chest', bark: 'Last time, Doctors. The long line.', enter: 'c11open', spawn: [mkBody, { t: 'guide', pts: [[213, 40], [212, 72], [214, 110], [212, 150], [213, 192]] }, { t: 'bleeder', x: 142, y: 138 }, { t: 'bleeder', x: 286, y: 140 }, { t: 'pool', x: 118, y: 104, vol: 90, req: true }] },\n    { obj: 'Slash the batons', bark: 'It conducts. Slash the baton when it rests.', clockAdd: 120, step: 'cantor1', when: 'done', spawn: [{ t: 'baton', x: 140, y: 90, ph0: -.4, rad: 44 }, { t: 'baton', x: 213, y: 84, ph0: 1.2, rad: 44 }, { t: 'baton', x: 286, y: 90, ph0: 2.8, rad: 44 }] },\n    { obj: 'Sedate the voice', bark: 'Forty, Doctor. I shall read them to you.', clockAdd: 120, enter: 'cantor2enter', leave: 'cantor2leave', step: 'cantor2', when: 'done', spawn: [{ t: 'voicebox', x: 213, y: 110 }] },\n    { obj: 'Cut the repeat', bark: 'It is repeating us. Cut it, or answer it.', clockAdd: 120, enter: 'cantor3enter', step: 'cantor3', when: 'done', tip: { k: 'gift', text: 'Slash the sign, or answer with a rewind' } },\n    { obj: 'The Last Note', bark: 'Between beats, Doctors. Only between beats.', clockAdd: 120, step: 'cantor4', when: 'flag:note_out', spawn: [{ t: 'guide', pts: spiralPts(213, 112, 8, 44, 1.45), between: true, after: [{ t: 'note', x: 213, y: 112 }] }], tip: { k: 'fine', text: 'Steady hand. Lift between beats' } },\n    { obj: 'Close', bark: '...Doctor.', noMusic: true, spawn: [{ t: 'wound', x: 213, y: 116, a: 1.57, len: 92, n: 6, w: 10, bleeds: false }] },\n  ] });\nG.defObject('cantorbody', { req: false, want: () => null, init(o) { o.ontop = true; } });\n// Grand Rounds: a ferry disaster, scaled by the seats.\ndefScript('grTriage', S => { const N = S.N, pts = [[120, 88], [168, 150], [214, 80], [262, 150], [306, 92], [140, 122], [288, 124], [214, 124], [100, 112], [326, 124], [190, 60], [238, 170]]; for (let i = 0; i < 3 * N; i++) { const [x, y] = pts[i % pts.length]; G.spawn(S, i % 3 === 0 ? { t: 'arteryTear', x, y, a: i } : { t: 'bleeder', x, y, ontop: i % 3 === 1 }); } G.spawn(S, { t: 'pool', x: 140, y: 136, vol: 80 }); G.spawn(S, { t: 'pool', x: 286, y: 100, vol: 80 }); });\ndefScript('grSwarm', S => { const N = S.N; S.flags.swarm = true; S.lacOpt = true; S.beadCap = 4 * N; const pts = [[120, 100], [306, 130], [180, 150], [250, 76]]; for (let i = 0; i < N; i++) { const n = G.spawn(S, { t: 'nest', x: pts[i][0], y: pts[i][1], hidden: false }); for (let k = 0; k < 4; k++) G.spawn(S, { t: 'bead', x: n.x + k * 3, y: n.y }); } });\ndefScript('grClose', S => { const N = S.N; S.lacOpt = true; S.objs.forEach(o => { if (o.type === 'laceration') o.req = false; }); for (let i = 0; i < N; i++) G.spawn(S, { t: 'wound', x: 140 + (N > 1 ? i * 146 / (N - 1) : 73), y: 100 + (i % 2) * 40, a: .3 * (i - 1), len: 62, n: 4, w: 11, bleeds: false }); });\ndefCase({ id: 'grandrounds', title: 'Grand Rounds', chapter: 0, doc: 'vale', site: 'abdomen', seed: 171, clock: 300, vitals: 75, drain: .25, noClockScale: true,\n  patient: 'The Ferry Disaster', complaint: 'The Port Anselm ferry went into the breakwater. All hands to one table.', opinion: 'Every surgeon in the building. Mind the elbows.', teach: 'One to four surgeons, one patient',\n  phases: [\n    { obj: 'Triage!', bark: 'Everyone bleeds at once tonight, Doctors.', enter: 'grTriage' },\n    { obj: 'Swarm: burn and slash', bark: 'Beads. Nests. Teamwork is a technique.', enter: 'grSwarm' },\n    { obj: 'One holds, one cuts', bark: 'Hold the retractor open. Someone else cuts.', spawn: [{ t: 'retractorHandle', x: 120, y: 118 }, { t: 'windowTarget', x: 268, y: 112 }], leave: 'grLeave3' },\n    { obj: 'Choir: kill all three', bark: 'It sings. A burn, B slash and pull, C dose then salve.', when: 'flag:dacapo_r1', spawn: [{ t: 'dacapo', x: 213, y: 112, small: true, window: 14 }] },\n    { obj: 'Close, together', bark: 'Close. Everyone. Dressings on my mark.', enter: 'grClose' },\n  ] });\ndefScript('grLeave3', S => { S.windowOpen = true; });\n// The Skills Lab: a pig's trotter, a clock that doesn't run, one of everything.\nconst LAB = [{ t: 'shard', x: 104, y: 100, a: -1.6, depth: 14 }, { t: 'laceration', x: 160, y: 72, r: 11 }, { t: 'wound', x: 226, y: 72, a: 0, len: 50, n: 3, w: 11, bleeds: false }, { t: 'polyp', x: 300, y: 76 }, { t: 'bleeder', x: 330, y: 118, ontop: true }, { t: 'pool', x: 290, y: 150, vol: 70 }, { t: 'guide', pts: [[140, 158], [190, 150], [240, 164]] }, { t: 'clot', x: 110, y: 148 }, { t: 'nest', x: 213, y: 116, hidden: true, stayMarked: true }];\ndefScript('labEnter', S => { S.lacOpt = true; S.ph.d.timers = {}; for (const sp of LAB) G.spawn(S, Object.assign({ lab: LAB.indexOf(sp) }, sp)); });\ndefScript('labStep', (S, ph, w) => { S.v = Math.max(S.v, 60); const d = S.ph.d; LAB.forEach((sp, i) => { const alive = S.objs.some(o => !o.dead && o.lab === i); if (alive) { d.timers[i] = 0; return; } d.timers[i] = (d.timers[i] || 0) + w; if (d.timers[i] > 2.5) { d.timers[i] = 0; G.spawn(S, Object.assign({ lab: i }, sp)); } }); });\ndefCase({ id: 'lab', title: 'Skills Lab', chapter: 0, doc: 'vale', site: 'forearm', seed: 5, clock: 999, vitals: 80, drain: 0, lab: true, noClockScale: true,\n  patient: 'A pig\\'s trotter', complaint: 'It has signed the waiver.', opinion: 'Practice anything. Nothing here can die twice.', teach: 'A sandbox with locked vitals',\n  phases: [{ obj: 'Practice', bark: 'This is a pig\\'s trotter. It has signed the waiver.', enter: 'labEnter', step: 'labStep', when: 'never' }] });\n})();\nEOF\ncat > src/data/par.js <<'EOF'\n// Written by tools/balance.mjs: a perfect bot's score per case at Resident, the 100% of a case's rank.\n(() => { const G = (window.GAME ||= {}); G.PAR = { c1: 500, c2: 600, c3: 700, c4: 700, c5: 700, c6: 700, c7: 700, c8: 700, c9: 700, c10: 800, c11: 1200, grandrounds: 900, lab: 1 }; })();\nEOF\ncat > src/bot/autosurgeon.js <<'EOF'\n// One bot, three jobs: attract mode (cheats), the scripted playthrough (no cheats), balance runs. It feeds a virtual device, the same stick and trigger a pad gives.\n(() => {\nconst G = (window.GAME ||= {}), { clamp } = G;\nconst O = o => G.OBJ[o.type];\nclass Bot {\n  // o: { speed: u/s max, react: seconds a plan waits first, err: aim error u, perfect: true (steers straight onto the target), seed }\n  constructor(o = {}) { this.o = Object.assign({ speed: 330, react: 0, err: 0, warp: false }, o); this.a = (o.seed || 7) >>> 0; this.plan = null; this.dev = G.Cursor.emptyDevice(); this.rewinds = 0; this.wantTool = null; }\n  rnd() { this.a = (this.a + 0x6d2b79f5) >>> 0; let t = Math.imul(this.a ^ (this.a >>> 15), this.a | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }\n  // Call once a step, with the state, this seat's player and cursor; returns the device\n  update(S, p, cur, dt) { this.S = S; this.p = p; this.cur = cur; this.dt = dt; const d = this.dev; d.gift = d.consult = d.cancel = d.shock = false; d.wheelPick = null; d.stick[0] = d.stick[1] = 0;\n    if (S.done) { d.trig = 0; return d; }\n    if (this.rewinds !== S.out.rewinds) { this.rewinds = S.out.rewinds; this.plan = null; d.trig = 0; }\n    if (S.codeBlue) { const c = S.codeBlue, ph = c.t / c.per, near = Math.round(ph), err = Math.abs(ph - near) * c.per; d.shock = near >= 1 && near > c.tries && err < .03; d.trig = 0; return d; }\n    if (S.closing) { const k = S.closing.t / S.closing.per; d.trig = S.closing.phase === 'ring' && k >= .99 ? 1 : 0; return d; }\n    if (S.out.hold > 0 || S.rwT > 0) { d.trig = 0; return d; }\n    if (!this.plan) { d.trig = 0; this.plan = this.think(); }\n    if (this.plan) { const r = this.plan.next(); if (r.done) { this.plan = null; d.trig = 0; } }\n    if (this.wantTool && p.toolNext !== this.wantTool) { d.wheelPick = this.wantTool; }\n    return d; }\n  // ---- what next ----\n  *think() { const S = this.S, p = this.p; if (this.o.react > 0) { let t = this.o.react; while (t > 0) { t -= this.dt; yield; } }\n    if (S.tut) { yield* this.tutorial(S.tut); return; }\n    if (!S.lock && !G.CHEATS.lockVitals && S.v < (S.bomb ? 42 : 34)) { yield* this.iv(); return; }\n    if (S.doc === 'vale' && !S.breath && S.steady > 45 && S.objs.some(o => o.type === 'bleeder' && o.rupture)) { this.dev.gift = true; yield; }\n    if (S.docs.length > 1) { const eye = S.objs.find(o => o.type === 'fermata' && o.stage2 === 1); if (eye && S.doc !== 'vale') { this.dev.consult = true; yield; let w = .5; while (w > 0) { w -= this.dt; yield; } } }\n    const special = S.objs.find(o => !o.dead && O(o).bot); if (special) { yield* O(special).bot(special, S, this); return; }\n    const pick = this.choose(); if (!pick) { if (S.objs.some(o => o.hidden && !(o.mark > 0))) { yield* this.sonarHunt(); return; } yield* this.idle(.15); return; }\n    yield* this.act(pick); }\n  choose() { const S = this.S, others = S.players.filter(q => q !== this.p && !q.gone), taken = new Set(others.map(q => q.botAim)); let best = null, bs = 1e9; for (const o of S.objs) { if (o.dead || !G.canTouch(S, o)) continue; const d = O(o), w = d.want ? d.want(o, S) : null; if (!w) continue; if (!o.req && o.type !== 'pool' && o.type !== 'bleeder' && o.type !== 'sliver' && o.type !== 'bead' && o.type !== 'reed' && o.type !== 'lobe' && o.type !== 'polyp') continue; if (o.type === 'pool' && !o.req && !S.objs.some(q => q.req && !q.dead && !G.visible(S, q))) continue; if (o.type === 'polyp' && !o.req && S.caseId === 'c11') continue; if (o.slur !== undefined) { const w2 = G.getObj(S, o.slur); if (!w2) continue; if (Math.hypot(w2.x - o.x, w2.y - o.y) > 90) continue; } const at = d.aim ? d.aim(o, S) : [o.x, o.y]; let k = Math.hypot(at[0] - this.cur.x, at[1] - this.cur.y) * .01; k += d.drainOf ? -d.drainOf(o, S) * 2 : -d.drain * 2; if (taken.has(o.id)) k += 3; if (o.type === 'pool') k += 2; if (o.type === 'repeatSign') k -= 50; if (o.type === 'bead') k -= 1; if (o.type === 'arteryTear') k -= 2; if (k < bs) { bs = k; best = { o, w, at }; } } if (best) this.p.botAim = best.o.id; return best; }\n  *act({ o, w, at }) { const S = this.S, d = this.dev; yield* this.tool(w);\n    switch (w) { case 'forceps': yield* this.forceps(o); break; case 'scalpel': if (o.type === 'guide') yield* this.cut(o); else yield* this.slash(o); break; case 'suture': yield* this.stitch(o); break; case 'salve': yield* this.paint(o); break; case 'syringe': yield* this.dose(o); break; case 'cautery': yield* this.burn(o); break; case 'suction': yield* this.suck(o); break; case 'sonar': yield* this.sonarHunt(); break; } d.trig = 0; }\n  // ---- gestures ----\n  *tool(id) { this.wantTool = id; yield; let t = 0; while (this.p.tool !== id && t < 1) { t += this.dt; yield; } }\n  steer(x, y, sp = this.o.speed, fine = false) { const d = this.dev, dx = x - this.cur.x, dy = y - this.cur.y, L = Math.hypot(dx, dy); if (L < .4) return true; if (this.o.warp) { this.cur.x = x; this.cur.y = y; return true; } const want = Math.min(sp, L / Math.max(.03, this.dt * 3)), T = G.T, base = T.cursorSpeed * (this.cur.speedK || 1), m = clamp(Math.pow(want / base, 1 / T.stickCurve), 0, 1); d.stick[0] = dx / L * m; d.stick[1] = dy / L * m; return L < 1; }\n  *moveTo(x, y, sp, tol = 1.2, follow) { let t = 0; this.dev.fine = false; if (this.o.err) { x += (this.rnd() - .5) * this.o.err; y += (this.rnd() - .5) * this.o.err; } while (Math.hypot(x - this.cur.x, y - this.cur.y) > tol && t < 4) { if (follow) { const q = follow(); x = q[0]; y = q[1]; } this.steer(x, y, sp); t += this.dt; yield; } }\n  *hold(s) { let t = s; while (t > 0) { t -= this.dt; yield; } }\n  *idle(s) { this.dev.trig = 0; yield* this.hold(s); }\n  *forceps(o) { const S = this.S, d = this.dev, D = O(o); yield* this.moveTo(o.x, o.y, undefined, 2, () => [o.x, o.y]); if (o.dead) return; if (D.canGrip && !D.canGrip(o, S)) return; d.trig = 1; yield; yield;\n    if (o.type === 'screw') { let a = 0; while (!o.dead && a < 60) { a += this.dt * 7; this.steer(o.x + Math.cos(a) * 9, o.y + Math.sin(a) * 9, 200); yield; } d.trig = 0; yield; return; }\n    if (o.type === 'tremolo' && o.stage === 2) { d.trig = 0; yield; return; }\n    if (o.type === 'legato') { const lim = (o.maxV || 46) * G.T.gradeTol * .62, c = Math.cos(o.a), s = Math.sin(o.a), sx = this.cur.x, sy = this.cur.y; let got = 0; while (!o.dead && o.stage === 'out' && got < 34 && this.p.hold) { got += lim * this.dt; this.steer(sx + c * got, sy + s * got, 300); yield; } if (o.dead) { d.trig = 0; yield; return; } if (o.stage === 'barb' && o.zone) yield* this.moveTo(o.zone[0], o.zone[1], lim, 6); d.trig = 0; yield; yield; return; }\n    if (!o.pull) { d.trig = 0; return; } const P = o.pull, lim = Math.min(P.maxV * G.T.gradeTol * .62, 85), c = Math.cos(P.a), s = Math.sin(P.a), sx = this.cur.x, sy = this.cur.y; let got = 0; while (!P.free && !o.dead && this.p.hold && got < P.depth * 1.6) { got += lim * this.dt; this.steer(sx + c * got, sy + s * got, 400); yield; }\n    if (o.dead || !this.p.hold) { d.trig = 0; yield; return; }\n    const ex = clamp(o.bx + c * (P.depth + 28), 40, 386), ey = clamp(o.by + s * (P.depth + 28), 20, 214); let t = 0; while (Math.hypot(o.x - o.bx, o.y - o.by) < 26 && t < 1.2 && !o.dead) { this.steer(ex, ey, 200); t += this.dt; yield; } d.trig = 0; yield; yield; }\n  *cut(o) { const S = this.S, d = this.dev, P = G.polyAt(o.pts, o.prog); yield* this.moveTo(P[0], P[1], undefined, 3); if (o.dead) return;\n    if (o.slur !== undefined) { const w = G.getObj(S, o.slur); let t = 0; while (w && !w.dead && Math.hypot(w.x - o.x, w.y - o.y) > 24 && t < 16) { t += this.dt; yield; } }\n    d.trig = 1; yield; yield; let t = 0; const sp = o.between ? 120 : 200; while (!o.dead && t < 30) { if (o.between && G.beatHot(S)) { t += this.dt; yield; continue; } const q = G.polyAt(o.pts, o.prog + 8); this.steer(q[0], q[1], sp); t += this.dt; yield; } d.trig = 0; yield; }\n  *slash(o) { const S = this.S, d = this.dev; const lead = 22; yield* this.moveTo(o.x - lead, o.y, undefined, 3, () => [o.x - lead, o.y]); if (o.dead) return; d.trig = 1; yield; let t = 0; while (!o.dead && t < .5 && (!O(o).slashable || O(o).slashable(o, S))) { this.steer(o.x + lead + 6, o.y, 400); t += this.dt; yield; } d.trig = 0; yield; yield; }\n  *stitch(o) { const S = this.S, d = this.dev, i = o.si; let q = G.stPts(o, S, i); yield* this.moveTo(q[0], q[1], undefined, 2.5, () => { const z = G.stPts(o, S, i); return [z[0], z[1]]; }); if (o.dead) return; d.trig = 1; yield; yield; let t = 0; while (t < 1.4) { q = G.stPts(o, S, i); this.steer(q[2], q[3], 300); t += this.dt; yield; if (Math.hypot(q[2] - this.cur.x, q[3] - this.cur.y) < 2.2) break; } if (o.between) { let w = 0; while (G.beatHot(S) && w < 1) { w += this.dt; yield; } } d.trig = 0; yield; yield; }\n  *paint(o) { const d = this.dev, R = o.r || 10; yield* this.moveTo(o.x - R * .4, o.y - R * .4, undefined, 3); if (o.dead) return; d.trig = 1; let a = 0, t = 0; while (!o.dead && t < 4) { a += this.dt * 9; const r = R * .55; this.steer(o.x + Math.cos(a) * r, o.y + Math.sin(a) * r, 260); t += this.dt; yield; } d.trig = 0; yield; }\n  *dose(o) { const S = this.S, d = this.dev; yield* this.moveTo(o.x, o.y, undefined, 2); if (o.dead) return; d.trig = 1; yield* this.hold(.56); let t = 0; const needBeat = o.type === 'reed' || o.type === 'voicebox'; if (needBeat && !S.breath) { while (S.sinceBeat > .2 && t < 2) { t += this.dt; yield; } } d.trig = 0; yield; yield; let c = .36; while (c > 0) { c -= this.dt; yield; } }\n  *burn(o) { const S = this.S, d = this.dev; yield* this.moveTo(o.x, o.y, undefined, 3, () => [o.x, o.y]); if (o.dead) return; d.trig = 1; let t = 0; while (!o.dead && o.burn > 0 && t < 3 && (O(o).burnOk ? O(o).burnOk(o, S) : true)) { if (this.p.heat > .8) { d.trig = 0; yield* this.hold(.6); d.trig = 1; } this.steer(o.x, o.y, 300); t += this.dt; yield; } d.trig = 0; yield; }\n  *suck(o) { const d = this.dev; yield* this.moveTo(o.x, o.y, undefined, 5); if (o.dead) return; d.trig = 1; let t = 0; while (!o.dead && t < 6) { this.steer(o.x, o.y, 200); t += this.dt; yield; } d.trig = 0; yield; }\n  *iv() { yield* this.tool('syringe'); const d = this.dev; d.trig = 1; yield* this.hold(.56); d.trig = 0; yield; yield; yield* this.hold(.36); }\n  *sonarHunt() { const S = this.S, d = this.dev, o = S.objs.find(q => q.hidden && !(q.mark > 0) && !q.dead); if (!o) return; yield* this.tool('sonar'); d.trig = 1; yield* this.moveTo(o.x + 8, o.y, undefined, 8); yield* this.hold(.1); d.trig = 0; yield; }\n  *tutorial(tut) { const S = this.S; if (tut.verb === 'iv') { yield* this.iv(); return; } if (tut.verb === 'gift') { this.dev.gift = true; yield; return; } if (tut.verb === 'consult') { this.dev.consult = true; yield; return; } const pick = this.choose(); if (pick) { yield* this.act(pick); return; } if (S.objs.some(o => o.hidden && !(o.mark > 0))) { yield* this.sonarHunt(); return; } yield* this.idle(.1); }\n}\nG.Bot = Bot;\n// Plans for the strains and special objects that aren't a single gesture\nG.OBJ.tremolo.bot = function* (o, S, B) { if (!S.breath && S.doc === 'vale' && S.steady >= 60 && o.stage < 3) { B.dev.gift = true; yield; } const reed = S.objs.find(q => q.type === 'reed' && !q.dead && !q.sedated); if (o.stage === 1 || (o.stage === 2 && o.amp > .21)) { if (reed) { yield* B.tool('syringe'); yield* B.dose(reed); return; } } if (o.stage === 2) { const w = G.OBJ.tremolo.want(o, S); if (w === 'forceps') { yield* B.tool('forceps'); yield* B.forceps(o); yield* B.tool('cautery'); yield* B.burn(o); return; } if (w === 'cautery') { yield* B.tool('cautery'); yield* B.burn(o); return; } yield* B.idle(.1); return; } if (o.stage === 3) { const l = S.objs.find(q => q.type === 'laceration' && !q.dead && q.req); yield* B.tool('forceps'); yield* B.forceps(o); return; } };\nG.OBJ.dacapo.bot = function* (o, S, B) { const L = o.lobes.map(id => G.getObj(S, id)).filter(q => q && !q.dead2); if (!L.length) { yield* B.idle(.05); return; }\n  // plan: only start the first kill when the others will open inside the window\n  if (o.cd < 0 && !o.lobes.some(id => { const q = G.getObj(S, id); return q && q.dead2; })) { const win = (o.window || 10) - 3.5, nextAll = L.map(q => G.lobeNext(q, S)), max = Math.max(...nextAll); if (max > win * .6 && !L.some(q => (q.slashedIt) || (q.label === 'C' && !q.dose) || (q.burn0 && q.burn < q.burn0))) { const open = L.filter(q => q.open); if (!(open.length >= 2)) { yield* B.idle(.05); return; } } }\n  const open = L.filter(q => q.open).sort((a, b) => a.label < b.label ? -1 : 1), q = open[0]; if (!q) { const nx = L.slice().sort((a, b) => G.lobeNext(a, S) - G.lobeNext(b, S))[0]; yield* B.moveTo(nx.x, nx.y, undefined, 4); yield* B.idle(.05); return; }\n  const want = G.OBJ.lobe.want(q, S); if (!want) { yield* B.idle(.03); return; } yield* B.tool(want);\n  if (want === 'cautery') yield* B.burn(q); else if (want === 'scalpel') yield* B.slash(q); else if (want === 'forceps') { yield* B.forceps(q); } else if (want === 'syringe') yield* B.dose(q); else if (want === 'salve') { yield* B.moveTo(q.x, q.y, undefined, 3); B.dev.trig = 1; let t = 0; while (!q.dead2 && q.open && t < 1.5) { t += B.dt; yield; } B.dev.trig = 0; yield; } };\nG.OBJ.fermata.bot = function* (o, S, B) { const others = S.objs.filter(q => q.type === 'sliver' && !q.dead); if (others.length) { const q = others[0], w = G.OBJ.sliver.want(q); yield* B.tool(w); if (w === 'scalpel') yield* B.slash(q); else yield* B.forceps(q); return; } if (o.stage2 === 1) { if (S.doc === 'vale' && !S.breath && o.open > 0 && S.steady > 35) { B.dev.gift = true; yield; } if (o.open > 0 && !G.inDome(S, o.x, o.y)) { yield* B.tool('cautery'); yield* B.burn(o); return; } yield* B.tool('cautery'); yield* B.moveTo(o.x + 2, o.y + 2, undefined, 4); yield* B.idle(.03); return; } if (o.stage2 === 2) { if (!(o.mark > 0)) { yield* B.sonarHunt(); return; } yield* B.idle(.1); return; } if (o.stage2 === 3) { yield* B.tool('forceps'); yield* B.forceps(o); } };\nG.OBJ.voicebox.bot = function* (o, S, B) { if (!(o.mark > 0)) { yield* B.sonarHunt(); return; } yield* B.tool('syringe'); yield* B.dose(o); };\n})();\nEOF","description":"Write case data for all chapters and the bot"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8150,"cache_read_input_tokens":222656,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8150},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4983f3c-8ab3-4cb5-bbfd-23a240d1dce6","uuid":"3b829063-31cd-4342-9d65-8477f05f90f9","timestamp":"2026-11-05T13:27:45.525Z","request_id":"req_011Cgjra9g1w1Fp8qc8dNkFb","wire_tool_inputs":{"toolu_01B9LUMPMy6b5tDXhvyMWNSZ":{"command":"cd ../../../..; cat > src/data/cases/ch1.js <<'EOF'\n// Chapter 1: First Incision. A case is data: patient, site, clock, vitals, drain, phases. See CONTENT.md.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript, circlePts } = G;\ndefScript('dip40', S => { S.v = Math.min(S.v, 40); });\ndefCase({ id: 'c1', number: 1, title: 'Glasshouse', chapter: 1, doc: 'vale', site: 'forearm', seed: 3, clock: 180, vitals: 80, drain: .1,\n  patient: 'Agnes Pellow, 74', complaint: 'Fell through her own greenhouse roof. Forearm full of glass.', opinion: 'She wants the glass kept for the grandchildren.', story: { before: 'c1_before', after: 'c1_after' }, teach: 'Cursor, wheel, four tools, grades',\n  phases: [\n    { obj: 'Pull the glass', bark: 'Forceps, Doctor. Pull the way it went in.', tut: { verb: 'forceps', text: 'Grip the glass and pull it out along the arrow. Slowly.' }, spawn: [{ t: 'shard', x: 130, y: 104, a: -1.9, depth: 16 }, { t: 'shard', x: 196, y: 138, a: 1.25, depth: 15 }, { t: 'shard', x: 262, y: 88, a: -.8, depth: 18 }, { t: 'shard', x: 306, y: 132, a: .3, depth: 15 }] },\n    { obj: 'Clean the cuts', bark: 'Salve. Paint it on. Nobody grades the brushwork.', tut: { verb: 'salve', text: 'Pick Salve, then hold and paint over the whole cut.' }, spawn: [{ t: 'laceration', x: 140, y: 120, r: 11 }, { t: 'laceration', x: 224, y: 92, r: 12 }, { t: 'laceration', x: 292, y: 118, r: 10 }] },\n    { obj: 'Close the wound', bark: 'Suture. Across the wound, Doctor, not along it.', tut: { verb: 'suture', text: 'Press on a blue dot, cross the wound, let go on the other dot.' }, spawn: [{ t: 'wound', x: 213, y: 116, a: .2, len: 76, n: 4, w: 13, bleeds: false }] },\n    { obj: 'Give her a boost', bark: 'Pressure is dropping. Stimulant to the IV.', enter: 'dip40', when: 'flag:iv', tut: { verb: 'iv', text: 'Pick the Syringe. Hold to fill, let go anywhere to dose the IV.' } },\n  ] });\ndefCase({ id: 'c2', number: 2, title: 'Low Brass', chapter: 1, doc: 'vale', site: 'abdomen', seed: 11, clock: 210, vitals: 70, drain: .2,\n  patient: 'Desmond \"Slide\" Achebe, 58', complaint: 'Trombonist. Pain under the ribs when he holds a long note.', opinion: 'Dr. Whitlock: \"Hernia. Obviously.\"', story: { before: 'c2_before', after: 'c2_after' }, teach: 'Scalpel, Suction, Cautery, excision',\n  lightbox: { film: 'ribs', at: [262, 128], decoys: [[150, 96], [205, 170]], text: 'A round shadow behind the bowel. Not a hernia.', markAt: [213, 116] },\n  phases: [\n    { obj: 'Open him up', bark: 'Scalpel. Follow the marker. It has been to medical school.', tut: { verb: 'scalpel', text: 'Press on the start dot, then trace the purple line in one stroke.' }, spawn: [{ t: 'guide', pts: [[183, 72], [205, 96], [224, 128], [240, 156]] }] },\n    { obj: 'Clear the field', bark: 'Bleeder under that pool. Drain first. Burn second.', tut: { verb: 'suction', text: 'Pick Suction and hold it over the pool.' }, spawn: [{ t: 'pool', x: 150, y: 110, vol: 110, req: true }, { t: 'pool', x: 268, y: 126, vol: 120, req: true }, { t: 'bleeder', x: 268, y: 126 }] },\n    { obj: 'Burn the polyps', bark: 'Cautery. Short bursts. Mind the heat gauge.', tut: { verb: 'cautery', text: 'Pick Cautery and hold the beam on each pink polyp.' }, spawn: [{ t: 'polyp', x: 112, y: 92 }, { t: 'polyp', x: 160, y: 148 }, { t: 'polyp', x: 214, y: 76 }, { t: 'polyp', x: 266, y: 154 }, { t: 'polyp', x: 320, y: 100 }] },\n    { obj: 'Take the mass', bark: 'Ring it, then lift it. Gently. It has a family.', spawn: [{ t: 'mass', x: 213, y: 118, r: 22, leaves: [{ t: 'shard', depth: 12, a: -1.1, kind: 'cork' }] }] },\n    { obj: 'Close him', bark: 'That is a cork, Doctor. I will label it.', spawn: [{ t: 'wound', x: 213, y: 118, a: 1.1, len: 86, n: 6, w: 12, bleeds: false }, { t: 'patch', x: 150, y: 128, r: 14 }] },\n  ] });\ndefScript('crashEnter', S => { S.codeUsed = false; S.objs.forEach(o => { if (o.type === 'pool') o.req = false; }); });\ndefScript('crashStep', (S, ph, w) => { if (S.flags.revived) return; if (S.diff.codeBlue) { S.v = Math.max(0, S.v - 16 * w); } else { S.v = Math.max(14, S.v - 16 * w); if (S.v <= 14) S.flags.revived = true; } });\ndefScript('ruptureEnter', S => { S.steady = 100; for (let i = 0; i < 6; i++) { const a = i / 6 * 6.283; G.spawn(S, { t: 'bleeder', x: 213 + Math.cos(a) * 92, y: 116 + Math.sin(a) * 52, burn: .35, rupture: true, ontop: true }); } });\ndefScript('ruptureStep', (S, ph, w) => { const d = S.ph.d; if (S.tut) return; d.t = (d.t || 0) + w; if (d.t >= 12) { d.t = 0; G.hurt(S, 14); G.ev(S, 'slip', 213, 116, 'rupture', 0); } });\ndefCase({ id: 'c3', number: 3, title: 'Crane Nine', chapter: 1, doc: 'vale', site: 'abdomen', seed: 23, clock: 150, vitals: 55, drain: .5,\n  patient: 'Big Tam Rennie, 49', complaint: 'Crane foreman. The crane came down. He walked to the ambulance.', opinion: 'Everyone senior is at a conference. Quill has checked twice.', story: { before: 'c3_before', after: 'c3_after' }, teach: 'Triage, Code Blue, Long Breath',\n  phases: [\n    { obj: 'Stop the bleeding', bark: 'Three arteries. Pick one. Quickly is a technique.', spawn: [{ t: 'arteryTear', x: 138, y: 96, a: .5 }, { t: 'arteryTear', x: 222, y: 138, a: -.3 }, { t: 'arteryTear', x: 306, y: 96, a: 1.1 }, { t: 'bleeder', x: 176, y: 152 }, { t: 'bleeder', x: 274, y: 150 }, { t: 'pool', x: 120, y: 138, vol: 70 }, { t: 'pool', x: 310, y: 148, vol: 70 }] },\n    { obj: 'Pull the shrapnel', bark: 'Steel, this time. Two under the pools.', spawn: [{ t: 'shard', x: 128, y: 84, a: -2.2, depth: 16, kind: 'steel' }, { t: 'shard', x: 205, y: 92, a: -1.4, depth: 14, kind: 'steel' }, { t: 'shard', x: 292, y: 84, a: -.7, depth: 16, kind: 'steel' }, { t: 'pool', x: 165, y: 134, vol: 130, req: true }, { t: 'shard', x: 165, y: 134, a: 1.9, depth: 14, kind: 'steel' }, { t: 'pool', x: 262, y: 142, vol: 130, req: true }, { t: 'shard', x: 262, y: 142, a: 1.1, depth: 14, kind: 'steel' }] },\n    { obj: \"He's crashing\", bark: 'Pressure is falling through the floor, Doctor.', enter: 'crashEnter', step: 'crashStep', when: 'flag:revived' },\n    { obj: 'Seal the ruptures', bark: 'Six ruptures. Twelve seconds. Doctor? How long is twelve seconds?', enter: 'ruptureEnter', step: 'ruptureStep', tut: { verb: 'gift', text: 'Something is different. Use the Steady: the world slows, your hands do not.' }, tip: { k: 'gift', text: 'Long Breath' } },\n    { obj: 'Close him', bark: 'Close, Doctor. You may shake afterward.', spawn: [{ t: 'wound', x: 213, y: 116, a: -.2, len: 84, n: 5, w: 12, bleeds: false }] },\n  ] });\n})();\nEOF\ncat > src/data/cases/ch2.js <<'EOF'\n// Chapter 2: The Quiet Ones.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript } = G;\ndefScript('nestsStep', S => { const n = S.objs.filter(o => o.type === 'nest' && !o.dead); if (n.length && n.every(o => o.mark > 0)) S.ph.d.done = true; });\ndefScript('swarmEnter', S => { S.flags.swarm = true; S.lacOpt = true; for (const o of S.objs) if (o.type === 'nest') { for (let i = 0; i < 2; i++) G.spawn(S, { t: 'bead', x: o.x, y: o.y }); } });\ndefScript('repairEnter', S => { S.lacOpt = false; S.flags.swarm = false; let n = 0; for (const o of S.objs) if (o.type === 'laceration') { o.req = true; n++; } const pts = [[120, 96], [150, 150], [205, 78], [262, 156], [316, 112], [300, 74]]; for (let i = n; i < 6; i++) G.spawn(S, { t: 'laceration', x: pts[i][0], y: pts[i][1], r: 8 }); });\ndefCase({ id: 'c4', number: 4, title: 'The Whistling Man', chapter: 2, doc: 'vale', site: 'flank', seed: 41, clock: 200, vitals: 75, drain: .25,\n  patient: 'Captain Ned Harrow, 63', complaint: 'Walked into the ER whistling, with a gaff through his side.', opinion: 'Triage: \"Superficial. He is in no pain at all.\"', story: { before: 'c4_before', after: 'c4_after' }, teach: 'Sonar, barbed extraction, the first strain',\n  lightbox: { film: 'spine', at: [158, 92], decoys: [[250, 150], [300, 90]], text: 'Beads of light beside the spine. The film is humming.', moving: true, markAt: [150, 150] },\n  phases: [\n    { obj: 'Free the gaff', bark: 'Barbed. Relief cuts first, Doctor, or it brings friends.', tut: { verb: 'scalpel', text: 'Cut both short lines to free the barbs, then pull the gaff out with Forceps.' }, spawn: [{ t: 'hook', x: 205, y: 112, a: .35, depth: 38 }] },\n    { obj: 'Something moved', bark: 'Sonar, Doctor. Why is there singing in my theatre?', step: 'nestsStep', when: 'done', tut: { verb: 'sonar', text: 'Hold Sonar and sweep. Listen: the song swells and pans toward what is hiding.' }, spawn: [{ t: 'nest', x: 118, y: 110 }, { t: 'nest', x: 300, y: 128 }] },\n    { obj: 'Kill the swarm', bark: 'Burn the beads. Slash the nests. Forceps after.', enter: 'swarmEnter' },\n    { obj: 'Repair the bites', bark: 'Tidy up. He will not thank you. He cannot feel it.', enter: 'repairEnter', spawn: [{ t: 'wound', x: 205, y: 118, a: .35, len: 66, n: 4, w: 11, bleeds: false }] },\n  ] });\nconst SLUR_ROUTE = [[92, 148], [150, 136], [205, 150], [262, 126], [326, 110], [290, 80], [214, 92], [140, 86]];\ndefCase({ id: 'c5', number: 5, title: 'Slur', chapter: 2, doc: 'vale', site: 'forearm', siteOpt: { nerve: true }, seed: 57, clock: 220, vitals: 70, drain: .2,\n  patient: 'Ilse Brandt, 19', complaint: 'Conservatory violinist. Numb left hand. Has never been happier.', opinion: 'She did not want this operation. Her mother signed.', story: { before: 'c5_before', after: 'c5_after' }, teach: 'Legato, fine mode, no-touch anatomy, the clamp',\n  phases: [\n    { obj: 'Find it', bark: 'Something long under there. Sonar. Mind the gold line.', when: 'flag:legato_found', spawn: [{ t: 'nerve', pts: [[70, 118], [130, 112], [200, 120], [270, 112], [356, 118]] }, { t: 'legato', route: SLUR_ROUTE, hidden: true, total: 150, splitAt: 75, spd: 28 }] },\n    { obj: 'Cut as it passes', bark: 'When the ridge reaches the mark, Doctor. Not before.', when: 'flag:legato_out' },\n    { obj: 'The long pull', bark: 'Slowly. Barb: let go in the box. I clamp, you burn.', when: 'flag:legato_half', tip: { k: 'fine', text: 'Steady hand: move slowly' } },\n    { obj: 'It split!', bark: 'A smaller one. Faster. Naturally.', when: 'flag:legato_dead' },\n    { obj: 'Repair the track', bark: 'Fine stitches. She plays with this hand.', spawn: [{ t: 'patch', x: 150, y: 138, r: 15 }, { t: 'patch', x: 276, y: 92, r: 15 }, { t: 'wound', x: 213, y: 148, a: 0, len: 72, n: 5, w: 9, bleeds: false }] },\n  ] });\ndefCase({ id: 'c6', number: 6, title: 'Bedside Manner', chapter: 2, doc: 'vale', site: 'heart', seed: 71, clock: 240, vitals: 60, drain: .35,\n  patient: 'Dr. Marguerite Oyelaran, 61', complaint: 'Chief of Surgery. Collapsed at the Foundation gala, mid-toast.', opinion: 'She left a note on her own chart: \"Do not be sentimental.\"', story: { before: 'c6_before', after: 'c6_after' }, teach: 'The beating heart, timing, tremor, first boss', music: 'boss',\n  phases: [\n    { obj: 'Open the chest', bark: \"It's the Chief, Doctor. So, no pressure. Sternal line.\", spawn: [{ t: 'guide', pts: [[213, 42], [214, 80], [212, 120], [213, 160], [214, 190]] }, { t: 'pool', x: 150, y: 120, vol: 90, req: true }, { t: 'pool', x: 280, y: 112, vol: 90, req: true }] },\n    { obj: 'Sedate on the beat', bark: 'Tremolo. Inject each reed just after the beat. Listen.', when: 'flag:tremolo_dead', spawn: [{ t: 'tremolo', x: 213, y: 112 }], tip: { k: 'gift', text: 'Long Breath stills the tremor' } },\n    { obj: 'Graft the vessel', bark: 'Stitch between beats. She always did hate a rushed graft.', spawn: [{ t: 'wound', x: 213, y: 112, a: -.5, len: 90, n: 6, w: 10, between: true, bleeds: false }, { t: 'patch', x: 142, y: 136, r: 13 }] },\n  ] });\n})();\nEOF\ncat > src/data/cases/ch3.js <<'EOF'\n// Chapter 3: Second Look. The player is Dr. Sokolova, on the hospital ship.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript } = G;\ndefScript('shipRoll', (S) => { S.tilt = [Math.sin(S.t * .55), Math.cos(S.t * .37) * .55]; });\ndefScript('shipFirst', (S, ph, w) => { G.Scripts.shipRoll(S); if (!G.Op.openReq(S) && S.out.lurched) S.ph.d.done = true; });\ndefScript('lurch', (S) => { G.ev(S, 'lurch'); for (const p of S.players) { const first = !S.out.lurched; if (first || p.trigPrev >= .3) { G.releaseHold(S, p); G.slip(S, p, p.x, p.y, 8, 'lurch'); G.addLac(S, p.x, p.y); S.out.look = 1; } } S.out.lurched = true; });\ndefScript('blackoutOn', S => { S.dim = .88; G.ev(S, 'blackout'); });\ndefScript('blackoutOff', S => { S.dim = 0; G.ev(S, 'lights'); });\ndefCase({ id: 'c7', number: 7, title: 'Force Nine', chapter: 3, doc: 'soko', site: 'abdomen', siteOpt: { lamp: true }, seed: 83, clock: 170, vitals: 60, drain: .35,\n  patient: 'Yusuf Demir, 22', complaint: 'Deckhand. A winch came off its mount in a Force Nine.', opinion: 'Dr. Sokolova: \"In the navy we did this with a spoon.\"', story: { before: 'c7_before', after: 'c7_after' }, teach: 'Second Look, the ship\\'s roll, blackout', lamp: true,\n  phases: [\n    { obj: 'Winch damage', bark: 'Everything slides, Doctor. Wait for the roll.', step: 'shipFirst', when: 'done', script: [{ t: 18, do: 'lurch' }], spawn: [{ t: 'shard', x: 135, y: 96, a: -1.9, depth: 14, kind: 'steel', loose: true }, { t: 'shard', x: 206, y: 150, a: 1.3, depth: 14, kind: 'steel', loose: true }, { t: 'shard', x: 262, y: 84, a: -.9, depth: 14, kind: 'steel', loose: true }, { t: 'shard', x: 318, y: 138, a: .4, depth: 14, kind: 'steel', loose: true }, { t: 'arteryTear', x: 170, y: 118, a: .9 }, { t: 'arteryTear', x: 270, y: 124, a: -.5 }] },\n    { obj: 'Blackout: seal bleeders', bark: 'Generator. Naturally. Sonar is all the light you have.', enter: 'blackoutOn', leave: 'blackoutOff', step: 'shipRoll', spawn: [{ t: 'bleeder', x: 130, y: 112, hidden: true, stayMarked: true }, { t: 'bleeder', x: 226, y: 72, hidden: true, stayMarked: true }, { t: 'bleeder', x: 306, y: 146, hidden: true, stayMarked: true }] },\n    { obj: 'Close on the roll', bark: 'The points drift, Doctor. So does the Atlantic.', step: 'shipRoll', spawn: [{ t: 'wound', x: 213, y: 118, a: .1, len: 110, n: 8, w: 11, shift: 6, bleeds: false }] },\n  ] });\ndefCase({ id: 'c8', number: 8, title: 'From the Top', chapter: 3, doc: 'soko', site: 'abdomen', seed: 97, clock: 210, vitals: 65, drain: .3,\n  patient: 'Sister Perpetua, 71', complaint: 'Runs the seamen\\'s hospice. Radiant, serene, and in organ failure.', opinion: 'She has asked us to pray for the other patients.', story: { before: 'c8_before', after: 'c8_after' }, teach: 'Da Capo, planning with ghosts', music: 'boss',\n  phases: [\n    { obj: 'Open and clear', bark: 'A clean line, dear. She will inspect it.', spawn: [{ t: 'guide', pts: [[160, 62], [190, 92], [228, 108], [266, 134]] }, { t: 'pool', x: 130, y: 128, vol: 90, req: true }, { t: 'pool', x: 300, y: 104, vol: 90, req: true }] },\n    { obj: 'Kill all three lobes', bark: 'A burn. B slash, pull. C dose, salve. All inside ten seconds.', when: 'flag:dacapo_r1', spawn: [{ t: 'dacapo', x: 213, y: 112 }], tip: { k: 'gift', text: 'Rewind: ghosts show when lobes open' } },\n    { obj: 'From the top. Faster', bark: 'It has repeated itself, Doctor. So have I.', when: 'flag:dacapo_r2', enter: 'dacapoBeads', spawn: [{ t: 'dacapo', x: 213, y: 112, round: 2, window: 12 }] },\n    { obj: 'Close', bark: 'Close. She will want the good thread.', spawn: [{ t: 'wound', x: 213, y: 124, a: -.1, len: 84, n: 6, w: 11, bleeds: false }] },\n  ] });\ndefScript('boardEnter', S => { [[188, 106, 0], [213, 124, 1], [240, 106, 2]].forEach(([x, y, o]) => G.spawn(S, { t: 'boardmark', x, y, order: o, sym: ['dot', 'tri', 'sq'][o] })); });\ndefScript('boardStep', S => { if ((S.flags.board || 0) >= 3) S.ph.d.done = true; });\nG.OBJ.wire.slashable = (o, S) => !S.objs.some(q => q.type === 'lead' && !q.dead);\nconst prevWant = G.OBJ.wire.want; G.OBJ.wire.want = (o, S) => S.objs.some(q => q.type === 'lead' && !q.dead) ? null : prevWant(o, S);\ndefCase({ id: 'c9', number: 9, title: \"Dead Man's Rhythm\", chapter: 3, doc: 'soko', site: 'implant', seed: 113, clock: 200, vitals: 70, drain: .25, bomb: true,\n  patient: 'Dr. Hollis Crane, 44', complaint: 'Foundation researcher. His pacemaker detonates if his heart stops, or if the can is forced.', opinion: 'Dr. Sokolova: \"We are doctors.\" Quill: \"I\\'ll fetch the other forceps.\"', story: { before: 'c9_before', after: 'c9_after' }, teach: 'A device instead of a disease',\n  phases: [\n    { obj: 'Expose the can', bark: 'Vitals under twenty-five and the ship goes. I mention it.', spawn: [{ t: 'guide', pts: [[150, 62], [210, 58], [276, 64]] }, { t: 'pool', x: 124, y: 118, vol: 80, req: true }, { t: 'pool', x: 306, y: 122, vol: 80, req: true }] },\n    { obj: 'Four screws', bark: 'Forceps. Grip and circle. Three full turns each.', spawn: [{ t: 'screw', x: 160, y: 76 }, { t: 'screw', x: 268, y: 76 }, { t: 'screw', x: 160, y: 156 }, { t: 'screw', x: 268, y: 156 }], tip: { k: 'text', text: 'Circle your aim, three turns' } },\n    { obj: 'Sonar the board', bark: 'He says ▲ ● ■. Trust him? Read the board yourself.', enter: 'boardEnter', step: 'boardStep', when: 'done' },\n    { obj: 'Bypass, then cut', bark: 'Solder the bypass, then cut in the order the board gave.', spawn: [{ t: 'lead', x: 168, y: 90 }, { t: 'lead', x: 260, y: 90 }, { t: 'wire', x: 170, y: 122, order: 1, sym: 'tri' }, { t: 'wire', x: 214, y: 134, order: 0, sym: 'dot' }, { t: 'wire', x: 258, y: 122, order: 2, sym: 'sq' }] },\n    { obj: 'Lift it, gently', bark: 'Now lift. Very gently. We are rolling.', step: 'shipRoll', spawn: [{ t: 'can', x: 213, y: 116 }], enter: 'canEnter' },\n    { obj: 'Close', bark: 'I shall fetch the other forceps back.', spawn: [{ t: 'wound', x: 213, y: 116, a: 0, len: 76, n: 5, w: 11, bleeds: false }] },\n  ] });\ndefScript('canEnter', S => { S.tilt = [0, 0]; });\n})();\nEOF\ncat > src/data/cases/ch4.js <<'EOF'\n// Chapter 4: Coda. Both doctors, and the Cantor.\n(() => {\nconst G = (window.GAME ||= {}), { defCase, defScript, spiralPts } = G;\ndefScript('fermataEnter', S => { S.steady = Math.max(S.steady, 60); });\ndefScript('fermata2Step', S => { if (S.flags.fermata_found && !S.objs.some(o => o.type === 'sliver' && !o.dead)) S.ph.d.done = true; });\nconst NERVES = [{ t: 'nerve', pts: [[86, 74], [130, 96], [180, 70], [226, 88]] }, { t: 'nerve', pts: [[230, 164], [276, 150], [330, 158]] }, { t: 'nerve', pts: [[110, 160], [150, 142], [196, 166]] }];\ndefCase({ id: 'c10', number: 10, title: 'Eloquent Cortex', chapter: 4, doc: 'both', site: 'brain', seed: 131, clock: 240, vitals: 60, drain: .3,\n  patient: 'Dr. Percival Whitlock, 29', complaint: 'Collapsed mid-sentence, smiling. \"It\\'s finally quiet.\"', opinion: 'His own handwriting on his own chart: \"Migraine.\"', story: { before: 'c10_before', after: 'c10_after' }, teach: 'Consult: two doctors, two gifts', music: 'boss',\n  lightbox: { film: 'skull', at: [176, 104], decoys: [[250, 90], [226, 150]], text: 'Not a migraine. An eye. It is looking back.', markAt: [150, 90] },\n  phases: [\n    { obj: 'Open the scalp', bark: 'Your hands, Dr. Sokolova. Hers next. Try to share.', spawn: [...NERVES, { t: 'guide', pts: [[120, 54], [170, 40], [230, 38], [290, 52], [320, 76]] }, { t: 'pool', x: 240, y: 112, vol: 90, req: true }] },\n    { obj: 'Burn the eye as it opens', bark: 'Inside a dome, nothing happens. Nothing at all.', when: 'flag:fermata1', enter: 'fermataEnter', spawn: [{ t: 'fermata', x: 150, y: 110 }], tut: { verb: 'consult', text: 'Consult hands over to the other doctor: Vale stretches the moment, Sokolova takes it back.' }, tip: { k: 'consult', text: 'Consult' } },\n    { obj: 'Find the eye', bark: 'It moved. Dr. Vale\\'s Sonar reaches further.', enter: 'fermataFlee', step: 'fermata2Step', when: 'done' },\n    { obj: 'The gentle pull', bark: 'Gently. This is the part of him that does crosswords.', enter: 'fermataPull', when: 'flag:fermata_dead', tip: { k: 'fine', text: 'Steady hand: a very light pull' } },\n    { obj: 'Close', bark: 'Fine stitches. He will complain about them. Good.', spawn: [{ t: 'wound', x: 200, y: 118, a: .2, len: 76, n: 6, w: 9, bleeds: false }, { t: 'patch', x: 300, y: 112, r: 13 }] },\n  ] });\nconst mkBody = { t: 'cantorbody', x: 213, y: 104 };\ndefScript('c11open', S => { S.lacOpt = true; });\ndefScript('cantor3enter', S => { S.ringOn = true; S.steady = Math.max(S.steady, 50); });\ndefCase({ id: 'c11', number: 11, title: 'Last Note', chapter: 4, doc: 'both', site: 'mediastinum', seed: 149, clock: 420, vitals: 70, drain: .3,\n  patient: 'Clementine Hale, 19', complaint: 'Patient zero. Has felt nothing since she was nine. Everything is singing to her.', opinion: 'Her father carried her in himself.', story: { before: 'c11_before', after: 'c11_after' }, teach: 'All tools, both gifts, everything you know', music: 'final',\n  phases: [\n    { obj: 'Open the chest', bark: 'Last time, Doctors. The long line.', enter: 'c11open', spawn: [mkBody, { t: 'guide', pts: [[213, 40], [212, 72], [214, 110], [212, 150], [213, 192]] }, { t: 'bleeder', x: 142, y: 138 }, { t: 'bleeder', x: 286, y: 140 }, { t: 'pool', x: 118, y: 104, vol: 90, req: true }] },\n    { obj: 'Slash the batons', bark: 'It conducts. Slash the baton when it rests.', clockAdd: 120, step: 'cantor1', when: 'done', spawn: [{ t: 'baton', x: 140, y: 90, ph0: -.4, rad: 44 }, { t: 'baton', x: 213, y: 84, ph0: 1.2, rad: 44 }, { t: 'baton', x: 286, y: 90, ph0: 2.8, rad: 44 }] },\n    { obj: 'Sedate the voice', bark: 'Forty, Doctor. I shall read them to you.', clockAdd: 120, enter: 'cantor2enter', leave: 'cantor2leave', step: 'cantor2', when: 'done', spawn: [{ t: 'voicebox', x: 213, y: 110 }] },\n    { obj: 'Cut the repeat', bark: 'It is repeating us. Cut it, or answer it.', clockAdd: 120, enter: 'cantor3enter', step: 'cantor3', when: 'done', tip: { k: 'gift', text: 'Slash the sign, or answer with a rewind' } },\n    { obj: 'The Last Note', bark: 'Between beats, Doctors. Only between beats.', clockAdd: 120, step: 'cantor4', when: 'flag:note_out', spawn: [{ t: 'guide', pts: spiralPts(213, 112, 8, 44, 1.45), between: true, after: [{ t: 'note', x: 213, y: 112 }] }], tip: { k: 'fine', text: 'Steady hand. Lift between beats' } },\n    { obj: 'Close', bark: '...Doctor.', noMusic: true, spawn: [{ t: 'wound', x: 213, y: 116, a: 1.57, len: 92, n: 6, w: 10, bleeds: false }] },\n  ] });\nG.defObject('cantorbody', { req: false, want: () => null, init(o) { o.ontop = true; } });\n// Grand Rounds: a ferry disaster, scaled by the seats.\ndefScript('grTriage', S => { const N = S.N, pts = [[120, 88], [168, 150], [214, 80], [262, 150], [306, 92], [140, 122], [288, 124], [214, 124], [100, 112], [326, 124], [190, 60], [238, 170]]; for (let i = 0; i < 3 * N; i++) { const [x, y] = pts[i % pts.length]; G.spawn(S, i % 3 === 0 ? { t: 'arteryTear', x, y, a: i } : { t: 'bleeder', x, y, ontop: i % 3 === 1 }); } G.spawn(S, { t: 'pool', x: 140, y: 136, vol: 80 }); G.spawn(S, { t: 'pool', x: 286, y: 100, vol: 80 }); });\ndefScript('grSwarm', S => { const N = S.N; S.flags.swarm = true; S.lacOpt = true; S.beadCap = 4 * N; const pts = [[120, 100], [306, 130], [180, 150], [250, 76]]; for (let i = 0; i < N; i++) { const n = G.spawn(S, { t: 'nest', x: pts[i][0], y: pts[i][1], hidden: false }); for (let k = 0; k < 4; k++) G.spawn(S, { t: 'bead', x: n.x + k * 3, y: n.y }); } });\ndefScript('grClose', S => { const N = S.N; S.lacOpt = true; S.objs.forEach(o => { if (o.type === 'laceration') o.req = false; }); for (let i = 0; i < N; i++) G.spawn(S, { t: 'wound', x: 140 + (N > 1 ? i * 146 / (N - 1) : 73), y: 100 + (i % 2) * 40, a: .3 * (i - 1), len: 62, n: 4, w: 11, bleeds: false }); });\ndefCase({ id: 'grandrounds', title: 'Grand Rounds', chapter: 0, doc: 'vale', site: 'abdomen', seed: 171, clock: 300, vitals: 75, drain: .25, noClockScale: true,\n  patient: 'The Ferry Disaster', complaint: 'The Port Anselm ferry went into the breakwater. All hands to one table.', opinion: 'Every surgeon in the building. Mind the elbows.', teach: 'One to four surgeons, one patient',\n  phases: [\n    { obj: 'Triage!', bark: 'Everyone bleeds at once tonight, Doctors.', enter: 'grTriage' },\n    { obj: 'Swarm: burn and slash', bark: 'Beads. Nests. Teamwork is a technique.', enter: 'grSwarm' },\n    { obj: 'One holds, one cuts', bark: 'Hold the retractor open. Someone else cuts.', spawn: [{ t: 'retractorHandle', x: 120, y: 118 }, { t: 'windowTarget', x: 268, y: 112 }], leave: 'grLeave3' },\n    { obj: 'Choir: kill all three', bark: 'It sings. A burn, B slash and pull, C dose then salve.', when: 'flag:dacapo_r1', spawn: [{ t: 'dacapo', x: 213, y: 112, small: true, window: 14 }] },\n    { obj: 'Close, together', bark: 'Close. Everyone. Dressings on my mark.', enter: 'grClose' },\n  ] });\ndefScript('grLeave3', S => { S.windowOpen = true; });\n// The Skills Lab: a pig's trotter, a clock that doesn't run, one of everything.\nconst LAB = [{ t: 'shard', x: 104, y: 100, a: -1.6, depth: 14 }, { t: 'laceration', x: 160, y: 72, r: 11 }, { t: 'wound', x: 226, y: 72, a: 0, len: 50, n: 3, w: 11, bleeds: false }, { t: 'polyp', x: 300, y: 76 }, { t: 'bleeder', x: 330, y: 118, ontop: true }, { t: 'pool', x: 290, y: 150, vol: 70 }, { t: 'guide', pts: [[140, 158], [190, 150], [240, 164]] }, { t: 'clot', x: 110, y: 148 }, { t: 'nest', x: 213, y: 116, hidden: true, stayMarked: true }];\ndefScript('labEnter', S => { S.lacOpt = true; S.ph.d.timers = {}; for (const sp of LAB) G.spawn(S, Object.assign({ lab: LAB.indexOf(sp) }, sp)); });\ndefScript('labStep', (S, ph, w) => { S.v = Math.max(S.v, 60); const d = S.ph.d; LAB.forEach((sp, i) => { const alive = S.objs.some(o => !o.dead && o.lab === i); if (alive) { d.timers[i] = 0; return; } d.timers[i] = (d.timers[i] || 0) + w; if (d.timers[i] > 2.5) { d.timers[i] = 0; G.spawn(S, Object.assign({ lab: i }, sp)); } }); });\ndefCase({ id: 'lab', title: 'Skills Lab', chapter: 0, doc: 'vale', site: 'forearm', seed: 5, clock: 999, vitals: 80, drain: 0, lab: true, noClockScale: true,\n  patient: 'A pig\\'s trotter', complaint: 'It has signed the waiver.', opinion: 'Practice anything. Nothing here can die twice.', teach: 'A sandbox with locked vitals',\n  phases: [{ obj: 'Practice', bark: 'This is a pig\\'s trotter. It has signed the waiver.', enter: 'labEnter', step: 'labStep', when: 'never' }] });\n})();\nEOF\ncat > src/data/par.js <<'EOF'\n// Written by tools/balance.mjs: a perfect bot's score per case at Resident, the 100% of a case's rank.\n(() => { const G = (window.GAME ||= {}); G.PAR = { c1: 500, c2: 600, c3: 700, c4: 700, c5: 700, c6: 700, c7: 700, c8: 700, c9: 700, c10: 800, c11: 1200, grandrounds: 900, lab: 1 }; })();\nEOF\ncat > src/bot/autosurgeon.js <<'EOF'\n// One bot, three jobs: attract mode (cheats), the scripted playthrough (no cheats), balance runs. It feeds a virtual device, the same stick and trigger a pad gives.\n(() => {\nconst G = (window.GAME ||= {}), { clamp } = G;\nconst O = o => G.OBJ[o.type];\nclass Bot {\n  // o: { speed: u/s max, react: seconds a plan waits first, err: aim error u, perfect: true (steers straight onto the target), seed }\n  constructor(o = {}) { this.o = Object.assign({ speed: 330, react: 0, err: 0, warp: false }, o); this.a = (o.seed || 7) >>> 0; this.plan = null; this.dev = G.Cursor.emptyDevice(); this.rewinds = 0; this.wantTool = null; }\n  rnd() { this.a = (this.a + 0x6d2b79f5) >>> 0; let t = Math.imul(this.a ^ (this.a >>> 15), this.a | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }\n  // Call once a step, with the state, this seat's player and cursor; returns the device\n  update(S, p, cur, dt) { this.S = S; this.p = p; this.cur = cur; this.dt = dt; const d = this.dev; d.gift = d.consult = d.cancel = d.shock = false; d.wheelPick = null; d.stick[0] = d.stick[1] = 0;\n    if (S.done) { d.trig = 0; return d; }\n    if (this.rewinds !== S.out.rewinds) { this.rewinds = S.out.rewinds; this.plan = null; d.trig = 0; }\n    if (S.codeBlue) { const c = S.codeBlue, ph = c.t / c.per, near = Math.round(ph), err = Math.abs(ph - near) * c.per; d.shock = near >= 1 && near > c.tries && err < .03; d.trig = 0; return d; }\n    if (S.closing) { const k = S.closing.t / S.closing.per; d.trig = S.closing.phase === 'ring' && k >= .99 ? 1 : 0; return d; }\n    if (S.out.hold > 0 || S.rwT > 0) { d.trig = 0; return d; }\n    if (!this.plan) { d.trig = 0; this.plan = this.think(); }\n    if (this.plan) { const r = this.plan.next(); if (r.done) { this.plan = null; d.trig = 0; } }\n    if (this.wantTool && p.toolNext !== this.wantTool) { d.wheelPick = this.wantTool; }\n    return d; }\n  // ---- what next ----\n  *think() { const S = this.S, p = this.p; if (this.o.react > 0) { let t = this.o.react; while (t > 0) { t -= this.dt; yield; } }\n    if (S.tut) { yield* this.tutorial(S.tut); return; }\n    if (!S.lock && !G.CHEATS.lockVitals && S.v < (S.bomb ? 42 : 34)) { yield* this.iv(); return; }\n    if (S.doc === 'vale' && !S.breath && S.steady > 45 && S.objs.some(o => o.type === 'bleeder' && o.rupture)) { this.dev.gift = true; yield; }\n    if (S.docs.length > 1) { const eye = S.objs.find(o => o.type === 'fermata' && o.stage2 === 1); if (eye && S.doc !== 'vale') { this.dev.consult = true; yield; let w = .5; while (w > 0) { w -= this.dt; yield; } } }\n    const special = S.objs.find(o => !o.dead && O(o).bot); if (special) { yield* O(special).bot(special, S, this); return; }\n    const pick = this.choose(); if (!pick) { if (S.objs.some(o => o.hidden && !(o.mark > 0))) { yield* this.sonarHunt(); return; } yield* this.idle(.15); return; }\n    yield* this.act(pick); }\n  choose() { const S = this.S, others = S.players.filter(q => q !== this.p && !q.gone), taken = new Set(others.map(q => q.botAim)); let best = null, bs = 1e9; for (const o of S.objs) { if (o.dead || !G.canTouch(S, o)) continue; const d = O(o), w = d.want ? d.want(o, S) : null; if (!w) continue; if (!o.req && o.type !== 'pool' && o.type !== 'bleeder' && o.type !== 'sliver' && o.type !== 'bead' && o.type !== 'reed' && o.type !== 'lobe' && o.type !== 'polyp') continue; if (o.type === 'pool' && !o.req && !S.objs.some(q => q.req && !q.dead && !G.visible(S, q))) continue; if (o.type === 'polyp' && !o.req && S.caseId === 'c11') continue; if (o.slur !== undefined) { const w2 = G.getObj(S, o.slur); if (!w2) continue; if (Math.hypot(w2.x - o.x, w2.y - o.y) > 90) continue; } const at = d.aim ? d.aim(o, S) : [o.x, o.y]; let k = Math.hypot(at[0] - this.cur.x, at[1] - this.cur.y) * .01; k += d.drainOf ? -d.drainOf(o, S) * 2 : -d.drain * 2; if (taken.has(o.id)) k += 3; if (o.type === 'pool') k += 2; if (o.type === 'repeatSign') k -= 50; if (o.type === 'bead') k -= 1; if (o.type === 'arteryTear') k -= 2; if (k < bs) { bs = k; best = { o, w, at }; } } if (best) this.p.botAim = best.o.id; return best; }\n  *act({ o, w, at }) { const S = this.S, d = this.dev; yield* this.tool(w);\n    switch (w) { case 'forceps': yield* this.forceps(o); break; case 'scalpel': if (o.type === 'guide') yield* this.cut(o); else yield* this.slash(o); break; case 'suture': yield* this.stitch(o); break; case 'salve': yield* this.paint(o); break; case 'syringe': yield* this.dose(o); break; case 'cautery': yield* this.burn(o); break; case 'suction': yield* this.suck(o); break; case 'sonar': yield* this.sonarHunt(); break; } d.trig = 0; }\n  // ---- gestures ----\n  *tool(id) { this.wantTool = id; yield; let t = 0; while (this.p.tool !== id && t < 1) { t += this.dt; yield; } }\n  steer(x, y, sp = this.o.speed, fine = false) { const d = this.dev, dx = x - this.cur.x, dy = y - this.cur.y, L = Math.hypot(dx, dy); if (L < .4) return true; if (this.o.warp) { this.cur.x = x; this.cur.y = y; return true; } const want = Math.min(sp, L / Math.max(.03, this.dt * 3)), T = G.T, base = T.cursorSpeed * (this.cur.speedK || 1), m = clamp(Math.pow(want / base, 1 / T.stickCurve), 0, 1); d.stick[0] = dx / L * m; d.stick[1] = dy / L * m; return L < 1; }\n  *moveTo(x, y, sp, tol = 1.2, follow) { let t = 0; this.dev.fine = false; if (this.o.err) { x += (this.rnd() - .5) * this.o.err; y += (this.rnd() - .5) * this.o.err; } while (Math.hypot(x - this.cur.x, y - this.cur.y) > tol && t < 4) { if (follow) { const q = follow(); x = q[0]; y = q[1]; } this.steer(x, y, sp); t += this.dt; yield; } }\n  *hold(s) { let t = s; while (t > 0) { t -= this.dt; yield; } }\n  *idle(s) { this.dev.trig = 0; yield* this.hold(s); }\n  *forceps(o) { const S = this.S, d = this.dev, D = O(o); yield* this.moveTo(o.x, o.y, undefined, 2, () => [o.x, o.y]); if (o.dead) return; if (D.canGrip && !D.canGrip(o, S)) return; d.trig = 1; yield; yield;\n    if (o.type === 'screw') { let a = 0; while (!o.dead && a < 60) { a += this.dt * 7; this.steer(o.x + Math.cos(a) * 9, o.y + Math.sin(a) * 9, 200); yield; } d.trig = 0; yield; return; }\n    if (o.type === 'tremolo' && o.stage === 2) { d.trig = 0; yield; return; }\n    if (o.type === 'legato') { const lim = (o.maxV || 46) * G.T.gradeTol * .62, c = Math.cos(o.a), s = Math.sin(o.a), sx = this.cur.x, sy = this.cur.y; let got = 0; while (!o.dead && o.stage === 'out' && got < 34 && this.p.hold) { got += lim * this.dt; this.steer(sx + c * got, sy + s * got, 300); yield; } if (o.dead) { d.trig = 0; yield; return; } if (o.stage === 'barb' && o.zone) yield* this.moveTo(o.zone[0], o.zone[1], lim, 6); d.trig = 0; yield; yield; return; }\n    if (!o.pull) { d.trig = 0; return; } const P = o.pull, lim = Math.min(P.maxV * G.T.gradeTol * .62, 85), c = Math.cos(P.a), s = Math.sin(P.a), sx = this.cur.x, sy = this.cur.y; let got = 0; while (!P.free && !o.dead && this.p.hold && got < P.depth * 1.6) { got += lim * this.dt; this.steer(sx + c * got, sy + s * got, 400); yield; }\n    if (o.dead || !this.p.hold) { d.trig = 0; yield; return; }\n    const ex = clamp(o.bx + c * (P.depth + 28), 40, 386), ey = clamp(o.by + s * (P.depth + 28), 20, 214); let t = 0; while (Math.hypot(o.x - o.bx, o.y - o.by) < 26 && t < 1.2 && !o.dead) { this.steer(ex, ey, 200); t += this.dt; yield; } d.trig = 0; yield; yield; }\n  *cut(o) { const S = this.S, d = this.dev, P = G.polyAt(o.pts, o.prog); yield* this.moveTo(P[0], P[1], undefined, 3); if (o.dead) return;\n    if (o.slur !== undefined) { const w = G.getObj(S, o.slur); let t = 0; while (w && !w.dead && Math.hypot(w.x - o.x, w.y - o.y) > 24 && t < 16) { t += this.dt; yield; } }\n    d.trig = 1; yield; yield; let t = 0; const sp = o.between ? 120 : 200; while (!o.dead && t < 30) { if (o.between && G.beatHot(S)) { t += this.dt; yield; continue; } const q = G.polyAt(o.pts, o.prog + 8); this.steer(q[0], q[1], sp); t += this.dt; yield; } d.trig = 0; yield; }\n  *slash(o) { const S = this.S, d = this.dev; const lead = 22; yield* this.moveTo(o.x - lead, o.y, undefined, 3, () => [o.x - lead, o.y]); if (o.dead) return; d.trig = 1; yield; let t = 0; while (!o.dead && t < .5 && (!O(o).slashable || O(o).slashable(o, S))) { this.steer(o.x + lead + 6, o.y, 400); t += this.dt; yield; } d.trig = 0; yield; yield; }\n  *stitch(o) { const S = this.S, d = this.dev, i = o.si; let q = G.stPts(o, S, i); yield* this.moveTo(q[0], q[1], undefined, 2.5, () => { const z = G.stPts(o, S, i); return [z[0], z[1]]; }); if (o.dead) return; d.trig = 1; yield; yield; let t = 0; while (t < 1.4) { q = G.stPts(o, S, i); this.steer(q[2], q[3], 300); t += this.dt; yield; if (Math.hypot(q[2] - this.cur.x, q[3] - this.cur.y) < 2.2) break; } if (o.between) { let w = 0; while (G.beatHot(S) && w < 1) { w += this.dt; yield; } } d.trig = 0; yield; yield; }\n  *paint(o) { const d = this.dev, R = o.r || 10; yield* this.moveTo(o.x - R * .4, o.y - R * .4, undefined, 3); if (o.dead) return; d.trig = 1; let a = 0, t = 0; while (!o.dead && t < 4) { a += this.dt * 9; const r = R * .55; this.steer(o.x + Math.cos(a) * r, o.y + Math.sin(a) * r, 260); t += this.dt; yield; } d.trig = 0; yield; }\n  *dose(o) { const S = this.S, d = this.dev; yield* this.moveTo(o.x, o.y, undefined, 2); if (o.dead) return; d.trig = 1; yield* this.hold(.56); let t = 0; const needBeat = o.type === 'reed' || o.type === 'voicebox'; if (needBeat && !S.breath) { while (S.sinceBeat > .2 && t < 2) { t += this.dt; yield; } } d.trig = 0; yield; yield; let c = .36; while (c > 0) { c -= this.dt; yield; } }\n  *burn(o) { const S = this.S, d = this.dev; yield* this.moveTo(o.x, o.y, undefined, 3, () => [o.x, o.y]); if (o.dead) return; d.trig = 1; let t = 0; while (!o.dead && o.burn > 0 && t < 3 && (O(o).burnOk ? O(o).burnOk(o, S) : true)) { if (this.p.heat > .8) { d.trig = 0; yield* this.hold(.6); d.trig = 1; } this.steer(o.x, o.y, 300); t += this.dt; yield; } d.trig = 0; yield; }\n  *suck(o) { const d = this.dev; yield* this.moveTo(o.x, o.y, undefined, 5); if (o.dead) return; d.trig = 1; let t = 0; while (!o.dead && t < 6) { this.steer(o.x, o.y, 200); t += this.dt; yield; } d.trig = 0; yield; }\n  *iv() { yield* this.tool('syringe'); const d = this.dev; d.trig = 1; yield* this.hold(.56); d.trig = 0; yield; yield; yield* this.hold(.36); }\n  *sonarHunt() { const S = this.S, d = this.dev, o = S.objs.find(q => q.hidden && !(q.mark > 0) && !q.dead); if (!o) return; yield* this.tool('sonar'); d.trig = 1; yield* this.moveTo(o.x + 8, o.y, undefined, 8); yield* this.hold(.1); d.trig = 0; yield; }\n  *tutorial(tut) { const S = this.S; if (tut.verb === 'iv') { yield* this.iv(); return; } if (tut.verb === 'gift') { this.dev.gift = true; yield; return; } if (tut.verb === 'consult') { this.dev.consult = true; yield; return; } const pick = this.choose(); if (pick) { yield* this.act(pick); return; } if (S.objs.some(o => o.hidden && !(o.mark > 0))) { yield* this.sonarHunt(); return; } yield* this.idle(.1); }\n}\nG.Bot = Bot;\n// Plans for the strains and special objects that aren't a single gesture\nG.OBJ.tremolo.bot = function* (o, S, B) { if (!S.breath && S.doc === 'vale' && S.steady >= 60 && o.stage < 3) { B.dev.gift = true; yield; } const reed = S.objs.find(q => q.type === 'reed' && !q.dead && !q.sedated); if (o.stage === 1 || (o.stage === 2 && o.amp > .21)) { if (reed) { yield* B.tool('syringe'); yield* B.dose(reed); return; } } if (o.stage === 2) { const w = G.OBJ.tremolo.want(o, S); if (w === 'forceps') { yield* B.tool('forceps'); yield* B.forceps(o); yield* B.tool('cautery'); yield* B.burn(o); return; } if (w === 'cautery') { yield* B.tool('cautery'); yield* B.burn(o); return; } yield* B.idle(.1); return; } if (o.stage === 3) { const l = S.objs.find(q => q.type === 'laceration' && !q.dead && q.req); yield* B.tool('forceps'); yield* B.forceps(o); return; } };\nG.OBJ.dacapo.bot = function* (o, S, B) { const L = o.lobes.map(id => G.getObj(S, id)).filter(q => q && !q.dead2); if (!L.length) { yield* B.idle(.05); return; }\n  // plan: only start the first kill when the others will open inside the window\n  if (o.cd < 0 && !o.lobes.some(id => { const q = G.getObj(S, id); return q && q.dead2; })) { const win = (o.window || 10) - 3.5, nextAll = L.map(q => G.lobeNext(q, S)), max = Math.max(...nextAll); if (max > win * .6 && !L.some(q => (q.slashedIt) || (q.label === 'C' && !q.dose) || (q.burn0 && q.burn < q.burn0))) { const open = L.filter(q => q.open); if (!(open.length >= 2)) { yield* B.idle(.05); return; } } }\n  const open = L.filter(q => q.open).sort((a, b) => a.label < b.label ? -1 : 1), q = open[0]; if (!q) { const nx = L.slice().sort((a, b) => G.lobeNext(a, S) - G.lobeNext(b, S))[0]; yield* B.moveTo(nx.x, nx.y, undefined, 4); yield* B.idle(.05); return; }\n  const want = G.OBJ.lobe.want(q, S); if (!want) { yield* B.idle(.03); return; } yield* B.tool(want);\n  if (want === 'cautery') yield* B.burn(q); else if (want === 'scalpel') yield* B.slash(q); else if (want === 'forceps') { yield* B.forceps(q); } else if (want === 'syringe') yield* B.dose(q); else if (want === 'salve') { yield* B.moveTo(q.x, q.y, undefined, 3); B.dev.trig = 1; let t = 0; while (!q.dead2 && q.open && t < 1.5) { t += B.dt; yield; } B.dev.trig = 0; yield; } };\nG.OBJ.fermata.bot = function* (o, S, B) { const others = S.objs.filter(q => q.type === 'sliver' && !q.dead); if (others.length) { const q = others[0], w = G.OBJ.sliver.want(q); yield* B.tool(w); if (w === 'scalpel') yield* B.slash(q); else yield* B.forceps(q); return; } if (o.stage2 === 1) { if (S.doc === 'vale' && !S.breath && o.open > 0 && S.steady > 35) { B.dev.gift = true; yield; } if (o.open > 0 && !G.inDome(S, o.x, o.y)) { yield* B.tool('cautery'); yield* B.burn(o); return; } yield* B.tool('cautery'); yield* B.moveTo(o.x + 2, o.y + 2, undefined, 4); yield* B.idle(.03); return; } if (o.stage2 === 2) { if (!(o.mark > 0)) { yield* B.sonarHunt(); return; } yield* B.idle(.1); return; } if (o.stage2 === 3) { yield* B.tool('forceps'); yield* B.forceps(o); } };\nG.OBJ.voicebox.bot = function* (o, S, B) { if (!(o.mark > 0)) { yield* B.sonarHunt(); return; } yield* B.tool('syringe'); yield* B.dose(o); };\n})();\nEOF","description":"Write case data for all chapters and the bot"}}}
