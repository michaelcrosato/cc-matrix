{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgju9pvawbxWcoENEw8Mc","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01M5YaEZ6a6gz8GidacD5Pcz","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-061300__x488eb9/work/Sec*/ && python3 - <<'EOF'\ndef sub(f,a,b):\n    s=open(f).read(); assert a in s,(f,a[:60]); s=s.replace(a,b,1); open(f,'w').write(s)\nsub('src/scenes/flow.js',\"const seats = d.seats || [{ pid: 0, input: game.input }];\",\"const seats = d.seats || (G.testBot ? [{ pid: 0, bot: new G.Bot({ seed: 9 }) }] : [{ pid: 0, input: game.input }]);\")\nEOF\ncat > tests/run.mjs <<'EOF'\n// The one test command: node tests/run.mjs [--fast]. Prints only failures and a one-line count.\nimport { load } from './lib.mjs'; import { readFileSync, readdirSync, statSync, existsSync } from 'node:fs'; import { spawnSync } from 'node:child_process';\nconst ROOT = new URL('../', import.meta.url), args = process.argv.slice(2), fast = args.includes('--fast');\nlet n = 0, bad = 0; const check = (name, ok, detail = '') => { n++; if (!ok) { bad++; console.log('FAIL ' + name + (detail !== '' ? ': ' + (typeof detail === 'string' ? detail : JSON.stringify(detail)).slice(0, 300) : '')); } };\nconst realLog = console.log; const quiet = f => { console.warn = () => {}; return f(); };\nconst { G, E, game, ctx } = load({ draw: false }); const T = G.T, I0 = () => ({ x: 213, y: 116, tool: null, trig: 0 });\nG.defCase({ id: 't', title: 'T', doc: 'vale', site: 'abdomen', clock: 500, vitals: 80, drain: 0, phases: [{ when: 'never', spawn: [] }] });\nG.defCase({ id: 'ts', title: 'T', doc: 'soko', site: 'abdomen', clock: 500, vitals: 80, drain: 0, phases: [{ when: 'never', spawn: [] }] });\nconst dt = 1 / 120, mk = (id = 't', o = {}) => { const S = G.Op.create(id, { seed: 5, ...o }); S.ev = []; return S; };\nclass Run { constructor(S) { this.S = S; this.x = 213; this.y = 116; this.tool = null; this.trig = 0; this.ev = {}; } step(sec, extra = {}) { const k = Math.max(1, Math.round(sec * 120)); for (let i = 0; i < k; i++) { G.Op.step(this.S, [{ x: this.x, y: this.y, tool: this.tool, trig: this.trig, ...extra }], dt); for (const e of this.S.ev) this.ev[e[0]] = (this.ev[e[0]] || 0) + 1; this.S.ev = []; extra = {}; } return this; } use(t) { this.tool = t; this.trig = 0; return this.step(.15); } at(x, y) { this.x = x; this.y = y; return this.step(.02); } line(x, y, sp) { const d = Math.hypot(x - this.x, y - this.y), st = Math.max(1, d / sp * 120 | 0), dx = (x - this.x) / st, dy = (y - this.y) / st; for (let i = 0; i < st; i++) { this.x += dx; this.y += dy; this.step(dt); } return this; } press() { this.trig = 1; return this.step(.02); } release() { this.trig = 0; return this.step(.02); } }\nconst add = (S, sp) => { const o = G.spawn(S, sp); S.ev = []; return o; };\n// ---- the tools: right gestures finish, wrong gestures give the specified result ----\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'shard', x: 200, y: 110, a: 0, depth: 16 }); r.use('forceps').at(200, 110).press().line(240, 110, 60).release(); check('forceps pulls a shard along its axis', o.dead && S.acts.textbook === 1, S.acts); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'shard', x: 200, y: 110, a: 0, depth: 16 }), v0 = S.v; r.use('forceps').at(200, 110).press().line(220, 110, 400); check('pulling too fast tears: vitals -4, progress -30%, a slip', S.slips === 1 && Math.abs(v0 - S.v - 4) < .3 && !p_hold(S) && o.pull.tears === 1, [S.slips, v0 - S.v]); }\nfunction p_hold(S) { return S.players[0].hold; }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'shard', x: 200, y: 110, a: 0, depth: 30 }); r.use('forceps').at(200, 110).press().line(205, 130, 50); check('pulling off axis tears', o.pull.tears >= 1); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'guide', pts: [[100, 100], [160, 100]] }); r.use('scalpel').at(100, 100).press().line(160, 100, 120).release(); check('scalpel traces a guide, Textbook when true', o.dead && S.acts.textbook === 1 && S.slips === 0, S.acts); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'guide', pts: [[100, 100], [200, 100]] }), v0 = S.v; r.use('scalpel').at(100, 100).press().line(130, 100, 120).at(130, 125); r.step(.2); check('scalpel off the line is a slip, -3', S.slips === 1 && v0 - S.v >= 2.9, [S.slips, v0 - S.v]); r.at(131, 100); r.line(200, 100, 120); check('and the stroke goes on when you come back', o.dead); }\n{ const S = mk(), r = new Run(S); add(S, { t: 'nerve', pts: [[100, 100], [200, 100]] }); const v0 = S.v; r.use('scalpel').at(150, 90).press().line(150, 110, 100); check('blade across a nerve: -12 and a slip', S.slips >= 1 && v0 - S.v >= 11.5, [S.slips, v0 - S.v]); }\n{ const S = mk(), r = new Run(S), v0 = S.v; r.use('scalpel').at(150, 90).press().line(170, 90, 100); check('blade over healthy tissue is a slip', S.slips === 1); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'wound', x: 200, y: 120, a: 0, len: 40, n: 2, w: 10, bleeds: false }); r.use('suture'); for (let i = 0; i < 2; i++) { const q = o.st[i]; r.at(q[0], q[1]).press().line(q[2], q[3], 120).release(); } check('suture: two stitches close a wound', o.dead && S.acts.textbook >= 2, S.acts); check('a closed wound leaves its stitches', S.marks.filter(m => m[0] === 'st').length === 2); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'wound', x: 200, y: 120, a: 0, len: 40, n: 2, w: 10, bleeds: false }), v0 = S.v; r.use('suture'); const q = o.st[0]; r.at(q[0], q[1]).press().at(q[0] + 40, q[1]).release(); check('a bad release is loose, -1, redo it', o.si === 0 && r.ev.loose === 1 && Math.abs(v0 - S.v - 1) < .3, r.ev); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'patch', x: 200, y: 120, r: 12 }); r.use('salve').at(192, 112).press().line(208, 112, 60).line(208, 128, 60).line(192, 128, 60).release(); check('salve paints a patch closed and heals', o.dead && r.ev.healed === 1, [o.covN, o.covTotal]); }\n{ const S = mk(), r = new Run(S); S.v = 40; r.use('syringe').press(); r.step(.56); r.release(); check('syringe to the IV: +18 at full on Resident', Math.abs(S.v - 58) < .5, S.v); const a = mk('t', { difficulty: 'intern' }), b = mk('t', { difficulty: 'attending' }); check('IV dose by difficulty', G.DIFFS.intern.iv === 24 && G.DIFFS.attending.iv === 12 && a.diff.iv === 24 && b.diff.iv === 12); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'clot', x: 150, y: 100 }); r.use('syringe').at(150, 100).press(); r.step(.56); r.release(); check('targeted dose Textbook', !o.dose && S.acts.textbook === 1, S.acts); const S2 = mk(), r2 = new Run(S2), o2 = add(S2, { t: 'clot', x: 150, y: 100 }); r2.use('syringe').at(150, 100).press(); r2.step(.56 + .35); r2.release(); check('held past full: an air bubble, Sloppy', S2.acts.sloppy === 1, S2.acts); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'polyp', x: 150, y: 100 }); r.use('cautery').at(150, 100).press(); r.step(.55); r.release(); check('cautery burns a polyp in .5 s', o.dead && S.acts.textbook === 1, S.acts); }\n{ const S = mk(), r = new Run(S), p = S.players[0], v0 = S.v; r.use('cautery').at(150, 100).press(); r.step(.7); check('cautery on bare tissue: char and a slip at .6 s', S.slips === 1 && S.marks.some(m => m[0] === 'char'), S.slips); r.step(1.4); check('heat locks the cautery', p.lockT > 0 || r.ev.lock >= 1, p.heat); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'pool', x: 150, y: 100, vol: 60 }); r.use('suction').at(150, 100).press(); r.step(1.1); check('suction removes 60 volume a second', o.dead); const S2 = mk(), s = add(S2, { t: 'pool', x: 100, y: 100, vol: 200 }), h = add(S2, { t: 'shard', x: 100, y: 100, a: 0 }); check('objects under a pool cannot be touched', !G.canTouch(S2, h)); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'nest', x: 300, y: 100 }); check('hidden objects cannot be touched until marked', !G.canTouch(S, o)); r.use('sonar').at(150, 100).press(); r.step(.1); check('out of the lens stays hidden', !(o.mark > 0)); r.at(290, 100); r.step(.1); check('sonar marks what is in the lens', o.mark > 0 && G.canTouch(S, o)); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'hook', x: 200, y: 110, a: 0, depth: 20 }); r.use('forceps').at(200, 110).press().release(); check('a hook pulled with barbs set tears', S.slips === 1); }\n// ---- cursor and wheel ----\n{ const S = mk(), p = S.players[0], c = G.Cursor.create(100, 116), d = G.Cursor.emptyDevice(); d.stick[0] = 1; S.objs = []; S.doc = 'none'; for (let i = 0; i < 120; i++) G.Cursor.update(c, p, d, S, dt); const full = c.x - 100; const c2 = G.Cursor.create(100, 116); d.fine = true; for (let i = 0; i < 120; i++) G.Cursor.update(c2, p, d, S, dt); check('full stick for 1 s moves 300 u or more', full >= 300, full); check('with Fine, 120 u or less', c2.x - 100 <= 120, c2.x - 100); S.doc = 'vale'; }\n{ const S = mk(), p = S.players[0], o = add(S, { t: 'shard', x: 150, y: 100, a: 0 }), c = G.Cursor.create(140, 96), d = G.Cursor.emptyDevice(); for (let i = 0; i < 120; i++) G.Cursor.update(c, p, d, S, dt); check('magnet settles on a target', Math.hypot(c.x - 150, c.y - 100) < 1, [c.x, c.y]); }\n{ const S = mk(), p = S.players[0], o = add(S, { t: 'guide', pts: [[100, 100], [300, 100]] }); p.hold = { k: 'cut', id: o.id }; const keep = T.assist; S.assistTol = 1; const c = G.Cursor.create(100, 100), d = G.Cursor.emptyDevice(); d.stick[0] = .7; d.stick[1] = .7; for (let i = 0; i < 60; i++) G.Cursor.update(c, p, d, S, dt); check('guide-follow holds a line at full assist', (c.y - 100) < (c.x - 100) * .25, [c.x, c.y]); T.assist = keep; }\n{ const dirs = [[0, -1], [.7, -.7], [1, 0], [.7, .7], [0, 1], [-.7, .7], [-1, 0], [-.7, -.7]]; dirs.forEach((v, i) => { const w = G.Wheel.create(), d = G.Cursor.emptyDevice(); d.wheel = v; let t = 'none', k = 0; while (t !== G.TOOLS[i] && k < 12) { t = G.Wheel.update(w, 'none', d, dt); k++; } check('stick direction ' + i + ' picks ' + G.TOOLS[i] + ' within 100 ms', t === G.TOOLS[i], [t, k]); }); for (let i = 1; i <= 8; i++) { const w = G.Wheel.create(), d = G.Cursor.emptyDevice(); d.num = i; check('key ' + i, G.Wheel.update(w, 'x', d, dt) === G.TOOLS[i - 1]); } const w = G.Wheel.create(), d = G.Cursor.emptyDevice(); d.wheelHold = true; d.wheelDelta = [0, -20]; G.Wheel.update(w, 'sonar', d, dt); d.wheelHold = false; d.wheelDelta = [0, 0]; check('hold right click and flick picks', G.Wheel.update(w, 'sonar', d, dt) === 'forceps'); check('swap takes .12 s', (() => { const S = mk(), r = new Run(S); r.tool = 'suture'; r.step(.05); const a = S.players[0].tool !== 'suture'; r.step(.1); return a && S.players[0].tool === 'suture'; })()); }\n// ---- vitals, clock, code blue, checkpoints ----\n{ const S = mk(), r = new Run(S); add(S, { t: 'bleeder', x: 100, y: 100 }); S.drain = 0; const v0 = S.v; r.step(2); check('drains add up: a bleeder is .5/s', Math.abs(v0 - S.v - 1) < .05, v0 - S.v); }\n{ const S = mk(); const r = new Run(S), v = S.clock; r.step(1); check('clock counts down', Math.abs(v - S.clock - 1) < .02); S.clock = .1; r.step(.2); check('clock at 0 loses the patient, no Code Blue', S.done === 'lost' && S.lostWhy === 'time'); }\n{ const S = mk(); const r = new Run(S); S.v = .01; r.step(.05); check('vitals 0 starts Code Blue', !!S.codeBlue && S.v === 0); const c = S.codeBlue, shoot = () => { while (S.codeBlue && Math.abs(c.t / c.per - Math.round(c.t / c.per)) * c.per > .02 || Math.round(c.t / c.per) <= c.tries) r.step(dt); r.step(dt, { shock: true }); }; shoot(); check('a shock on the peak hits', c.hits === 1, c); shoot(); r.step(.8); check('two hits revive to 30', !S.codeBlue && S.v > 29 && !S.done, S.v); S.v = .01; r.step(.05); check('second time, lost', S.done === 'lost'); }\n{ const S = mk(); const r = new Run(S); S.v = .01; r.step(.05); r.step(4.2); check('missed Code Blue loses the patient', S.done === 'lost'); }\n{ const S = mk('t', { difficulty: 'attending' }); const r = new Run(S); S.v = .01; r.step(.05); check('no Code Blue on Attending', S.done === 'lost'); }\n{ const S = G.Op.create('c1', { seed: 3 }); S.ev = []; const r = new Run(S), cp = JSON.stringify(G.Op.checkpoint(S).objs); r.use('forceps'); S.tut = null; S.v = 3; r.step(1); G.Op.retry(S); check('a phase checkpoint restores exactly', JSON.stringify(S.objs) === cp && S.capB === true && S.v === 80, S.v); }\n{ const S = G.Op.create('c1', { seed: 3 }); const v0 = S.v, c0 = S.clock; const r = new Run(S); S.ev = []; r.step(1); check('tutorial moments freeze clock and vitals', S.v === v0 && S.clock === c0); }\n// ---- grades and ranks ----\n{ const S = mk(); G.grade(S, S.players[0], 0, 0, 'textbook', 'x'); check('Textbook scores 1.5 and flow', S.flow === 1 && Math.abs(S.score - 10 * 1.5 * 1.05) < .01, S.score); G.grade(S, S.players[0], 0, 0, 'sloppy', 'x'); check('Sloppy resets Flow', S.flow === 0); S.finalScore = 95; check('rank S at 95%', G.rankOf(S, 100).rank === 'S'); S.finalScore = 80; check('A at 80', G.rankOf(S, 100).rank === 'A'); S.finalScore = 60; check('B at 60', G.rankOf(S, 100).rank === 'B'); S.finalScore = 40; check('C at 40', G.rankOf(S, 100).rank === 'C'); S.finalScore = 39; check('D below', G.rankOf(S, 100).rank === 'D'); S.capB = true; S.finalScore = 99; check('retries cap at B', G.rankOf(S, 100).rank === 'B'); S.capB = false; S.diffId = 'attending'; S.slips = 0; check('S with no slips on Attending stars', G.rankOf(S, 100).star); }\n// ---- gifts ----\n{ const S = mk(); S.steady = 80; const r = new Run(S), c0 = S.clock; S.drain = 1; const v0 = S.v; r.step(dt, { gift: true }); check('Long Breath on', S.breath); const t0 = S.t, h0 = S.ht; r.step(1); check('world time at .25, hands at 1', Math.abs((S.t - t0) - .25) < .01 && Math.abs((S.ht - h0) - 1) < .01, [S.t - t0, S.ht - h0]); check('it drains 16/s', Math.abs(S.steady - (80 - 16 * (1 + dt))) < 1, S.steady); r.step(dt, { gift: true }); check('press again stops', !S.breath); S.steady = 10; r.step(dt, { gift: true }); check('needs 35', !S.breath); }\n{ const S = mk('ts'); const r = new Run(S); add(S, { t: 'bleeder', x: 100, y: 100 }); r.step(1.2); S.ev = []; const ring = G.Op.ringOf(S); const snaps = ring.length; check('the ring holds snapshots every .1 s', snaps >= 10 && snaps <= 13, snaps); S.steady = 90; r.step(5); const target = S.t - T.lookSeconds; const R = G.Op.ringOf(S); const want = R.find(f => f.t >= target) || R[0], cp = JSON.stringify({ o: want.objs, v: want.v, c: want.clock, r: want.rng }); add(S, { t: 'polyp', x: 200, y: 100 }); S.objs.push; r.step(dt, { gift: true }); check('Second Look restores objects, vitals, clock, RNG exactly', JSON.stringify({ o: S.objs, v: S.v, c: S.clock, r: S.rng }) === cp); check('the ghost list is filled', S.ghosts && S.ghosts.fr.length >= 20, S.ghosts && S.ghosts.fr.length); check('costs 45, kept outside time', S.steady < 60 && S.steady > 30, S.steady); check('hands outside time', S.players[0].hold === null && S.rwT > 0); r.step(1.3); check('play resumes', S.rwT <= 0 && !S.done); }\n{ const S = G.Op.create('c10', { seed: 2 }); S.ev = []; const r = new Run(S); r.step(dt, { consult: true }); r.step(.5); check('Consult hands over', S.doc === 'vale' && r.ev.consulted === 1, S.doc); }\n// ---- strains reach their ends, failure branches ----\nconst stepBot = (id, ph, maxT = 300, o = {}) => { const S = G.Op.create(id, { seed: 7, phase: ph, ...o }), bot = new G.Bot({ seed: 1 }), cur = G.Cursor.create(), wh = G.Wheel.create(); S.ev = []; const evs = {}; let t = 0; const start = S.phaseI; while (!S.done && t < maxT && S.phaseI === start) { const p = S.players[0], d = bot.update(S, p, cur, dt); G.Cursor.update(cur, p, d, S, dt); const tool = G.Wheel.update(wh, p.toolNext, d, dt); G.Op.step(S, [G.buildInput(cur, tool, d)], dt); for (const e of S.ev) evs[e[0]] = (evs[e[0]] || 0) + 1; S.ev = []; t += dt; } return { S, evs, t, moved: S.phaseI !== start || S.done === 'won' }; };\nfor (const [id, ph, name] of [['c4', 2, 'Staccato'], ['c5', 2, 'Legato long pull'], ['c5', 3, 'Legato second worm'], ['c6', 1, 'Tremolo'], ['c8', 1, 'Da Capo round 1'], ['c8', 2, 'Da Capo round 2'], ['c9', 1, 'screws'], ['c9', 3, 'wires'], ['c10', 1, 'Fermata'], ['c11', 1, 'Cantor Exposition'], ['c11', 2, 'Cantor Development'], ['c11', 3, 'Cantor Recapitulation'], ['c11', 4, 'the Last Note']]) { if ((id === 'c5' && ph >= 2) || (id === 'c4' && ph === 2) || (id === 'c8' && ph === 2) || id === 'c10') { const S0 = stepThrough(id, ph); check(name + ' reaches its end', S0.moved, [S0.S.phaseI, S0.S.done, S0.t | 0]); } else { const r = stepBot(id, ph); check(name + ' reaches its end', r.moved, [r.S.phaseI, r.S.done, r.t | 0, r.S.objs.map(o => o.type)]); } }\nfunction stepThrough(id, ph) { const S = G.Op.create(id, { seed: 7 }), bot = new G.Bot({ seed: 1 }), cur = G.Cursor.create(), wh = G.Wheel.create(); S.ev = []; let t = 0; while (!S.done && t < 400 && S.phaseI <= ph) { const p = S.players[0], d = bot.update(S, p, cur, dt); G.Cursor.update(cur, p, d, S, dt); const tool = G.Wheel.update(wh, p.toolNext, d, dt); G.Op.step(S, [G.buildInput(cur, tool, d)], dt); S.ev = []; t += dt; } return { S, t, moved: S.phaseI > ph || S.done === 'won' }; }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'legato', route: [[100, 100], [300, 100]], total: 90 }); o.stage = 'out'; o.exit = [150, 100]; o.x = 150; o.y = 100; o.a = 0; r.use('forceps').at(150, 100).press().line(190, 100, 400); check('Legato pulled too fast snaps and flees', o.stage === 'under' && S.slips === 1, o.stage); }\n{ const S = mk(), r = new Run(S), o = add(S, { t: 'dacapo', x: 213, y: 110 }), L = o.lobes.map(i => G.getObj(S, i)); L[0].dead2 = true; const v0 = S.v; r.step(.1); check('first kill starts the countdown', o.cd > 9); r.step(10.1); check('at 0 dead lobes regrow, vitals -8, the figure repeats', !L[0].dead2 && r.ev.dacapo === 1 && v0 - S.v > 7, [L[0].dead2, v0 - S.v]); }\n{ const S = G.Op.create('c11', { seed: 7, phase: 3 }), r = new Run(S); S.ev = []; S.ph.d.next = .1; r.step(.2); check('Cantor winds up a repeat sign', S.objs.some(o => o.type === 'repeatSign')); r.step(1); add(S, { t: 'polyp', x: 100, y: 100 }); r.step(2.5); check('unanswered, it rewinds the field', r.ev.rewind >= 1 && S.out.recap === 0, r.ev); }\n{ const S = mk(), r = new Run(S); add(S, { t: 'dome', x: 100, y: 100, life: 5 }); const o = add(S, { t: 'polyp', x: 100, y: 100 }); r.use('cautery').at(100, 100).press(); r.step(.8); check('inside a dome tools do nothing', !o.dead && !S.slips); }\n{ const S = G.Op.create('c9', { seed: 2, phase: 3 }), r = new Run(S); S.ev = []; S.objs.filter(o => o.type === 'lead').forEach(o => { o.dead = true; }); S.objs = S.objs.filter(o => !o.dead); const v0 = S.v, c0 = S.clock, w = S.objs.find(o => o.type === 'wire' && o.order === 2); r.use('scalpel').at(w.x - 22, w.y).press().line(w.x + 22, w.y, 300).release(); check('a wrong wire: vitals -30, clock -30', S.v < 45 && c0 - S.clock > 29.5, [S.v, c0 - S.clock]); }\n// ---- determinism ----\nconst run2 = (draw) => { const S = G.Op.create('c8', { seed: 11, phase: 1 }), bot = new G.Bot({ seed: 3 }), cur = G.Cursor.create(), wh = G.Wheel.create(); S.ev = []; for (let i = 0; i < 1200; i++) { const p = S.players[0], d = bot.update(S, p, cur, dt); G.Cursor.update(cur, p, d, S, dt); const tool = G.Wheel.update(wh, p.toolNext, d, dt); G.Op.step(S, [G.buildInput(cur, tool, d)], dt); S.ev = []; } return G.stateHash(S); };\ncheck('same seed and inputs give the same hash twice', run2() === run2());\n// ---- content validator ----\n{ const nodes = G.story.nodes, reach = new Set(); for (const it of G.FLOW) if (it.k === 'story') { check('flow story node exists: ' + it.id, !!nodes[it.id]); } else if (it.k === 'case') check('flow case exists: ' + it.id, !!G.CASES[it.id]); const walk = id => { if (reach.has(id) || !nodes[id]) return; reach.add(id); for (const s of nodes[id]) { if (s.goto) walk(s.goto); if (s.choices) for (const c of s.choices) walk(c.goto); } }; G.FLOW.forEach(it => it.k === 'story' && walk(it.id)); for (const k in nodes) if (!k.startsWith('__')) { check('story node reachable: ' + k, reach.has(k)); for (const s of nodes[k]) { if (s.event === 'look') { check('story speaker has a portrait: ' + s.who, !!G.CAST[s.who], k); check('expression exists: ' + s.expr, ['neutral', 'smile', 'angry', 'sad', 'shock', 'shout'].includes(s.expr), k); } if (s.event === 'stage') check('stage exists: ' + s.arg, !!G.STAGES[s.arg]); if (s.event === 'cine') check('cine exists: ' + s.arg, !!G.CINE[s.arg]); if (s.say) check('a line fits two rows (90): ' + s.say.slice(0, 30), s.say.length <= 96, s.say.length); } }\n  for (const id in G.CASES) { const c = G.CASES[id]; if (id === 't' || id === 'ts') continue; check('site exists: ' + id, !!G.SITES[c.site]); c.phases.forEach((ph, i) => { for (const sp of ph.spawn || []) check('object type exists: ' + sp.t, !!G.OBJ[sp.t], id); for (const k of ['enter', 'step', 'leave']) if (ph[k]) check('script exists: ' + ph[k], !!G.Scripts[ph[k]], id); for (const a of ph.script || []) check('script exists: ' + a.do, !!G.Scripts[a.do], id); check('objective fits 26 chars: ' + ph.obj, (ph.obj || '').length <= 26, id); if (ph.bark) check('a bark fits: ' + ph.bark, ph.bark.length <= 66, ph.bark.length); }); check('par is set: ' + id, G.PAR[id] > 0); } for (const k in G.OBJ) if (!['cantorbody'].includes(k)) check('object draws: ' + k, !!G.OBJ_DRAW[k] || !!G.OBJ_STAMP[k]); }\nconst walkFiles = d => readdirSync(d).flatMap(f => { const p = d + '/' + f; return statSync(p).isDirectory() ? walkFiles(p) : [p]; }); { const dir = new URL('src', ROOT).pathname; for (const f of walkFiles(dir)) { const s = readFileSync(f, 'utf8'); check('no TODO, FIXME, placeholder, stub: ' + f.slice(dir.length), !/\\b(TODO|FIXME|placeholder|stub)\\b/i.test(s)); check('originality: ' + f.slice(dir.length), !/Derek|Stiles|Angie|Naomi|Kimishima|Nozomi|Hoffman|Blackwell|Hope Hospital|Angeles Bay|Caduceus|Delphi|\\bGUILT\\b|Healing Touch/.test(s.replace(/Trauma Center: Second Opinion/g, ''))); } }\n// ---- scenes: settings, dev, attract, grand rounds ----\ngame.advance(1); check('boots to the title', G.sceneName(game.scene) === 'title', G.sceneName(game.scene)); check('music defaults to 10%', game.settings.music === .1 && game.audio.musicVolume === .1, [game.settings.music, game.audio.musicVolume]); check('glyphs default PlayStation', game.settings.glyphs === 'playstation'); game.input.lastDevice = 'gamepad'; game.input.padIndex = 0; check('R2 prompt on a pad', game.input.label('useTool', 'gamepad') === 'R2', game.input.label('useTool', 'gamepad')); game.settings.set('glyphs', 'xbox'); check('Xbox labels', game.input.label('useTool', 'gamepad') === 'RT', game.input.label('useTool', 'gamepad')); check('Xbox triangle is Y', game.input.label('gift', 'gamepad') === 'Y'); game.settings.set('glyphs', 'playstation'); check('keyboard prompt', game.input.label('useTool', 'keyboard') === 'Space'); check('mouse prompt', /click/i.test(game.input.label('useTool', 'mouse'))); game.input.lastDevice = 'keyboard'; game.input.padIndex = null;\ngame.advance(10.5); check('title idle 10 s starts attract', G.sceneName(game.scene) === 'attract', G.sceneName(game.scene)); { const firstSeg = G.SCENES.attract.seg; game.input.tap('confirm'); game.advance(.5); check('any input leaves attract for the title', G.sceneName(game.scene) === 'title', G.sceneName(game.scene)); check('that press does nothing else', G.sceneName(game.scene) !== 'menu'); }\ngame.go('about', { back: 'menu' }); game.advance(.4); game.advance(11); check('no attract on reading screens', G.sceneName(game.scene) === 'about'); game.go('menu'); game.advance(.4); game.advance(10.3); check('menu idle starts attract', G.sceneName(game.scene) === 'attract'); { const A = G.SCENES.attract; const seen = new Set(); let t = 0; const lim = 330; while (t < lim && A.loops < 2) { game.advance(2); t += 2; seen.add(A.seg.k + (A.seg.caseId || '') + (A.seg.phase || '')); game.input.lastDevice = 'keyboard'; } check('the reel loops twice with no errors', A.loops >= 2 && !game.errors.length, [A.loops, t, game.errors.slice(0, 2).map(e => e.message)]); check('the reel shows many segments', seen.size >= 9, [...seen]); check('reel segment ids', G.REEL.length >= 9); check('attract never saves', !E.store.get('scalpel.prog', null) || E.store.get('scalpel.prog', null).flow === 0); }\ngame.input.tap('confirm'); game.advance(.5);\n{ // dev: sliders, reset, cheats\n  game.go('op', { caseId: 't', mode: 'files', difficulty: 'resident' }); game.advance(.4); const S = G.op.S, D = G.Dev; let ok = true; D.toggle(true); for (let p = 0; p < G.TUNING_PAGES.length; p++) { D.page = p; D.tab = 0; const A = D.rows(); check('tuning page has rows: ' + A.title, A.rows.length >= 5); }\n  const sliderEffect = { drainX: () => { T.drainX = 3; const q = mk(); q.drain = 1; const r = new Run(q), v0 = q.v; r.step(1); const a = v0 - q.v; T.drainX = 1; return a > 2.5; }, cursorSpeed: () => { T.cursorSpeed = 600; const q = mk(), c = G.Cursor.create(100, 100), d = G.Cursor.emptyDevice(); d.stick[0] = 1; q.doc = 'x'; for (let i = 0; i < 60; i++) G.Cursor.update(c, q.players[0], d, q, dt); T.cursorSpeed = 330; return c.x - 100 > 250; }, suctionRate: () => { T.suctionRate = 200; const q = mk(), o = add(q, { t: 'pool', x: 100, y: 100, vol: 90 }), r = new Run(q); r.use('suction').at(100, 100).press(); r.step(.6); T.suctionRate = 60; return o.dead; }, syringeDose: () => { T.syringeDose = 2; const q = mk(); q.v = 20; const r = new Run(q); r.use('syringe').press(); r.step(.56); r.release(); T.syringeDose = 1; return q.v > 50; }, chargeX: () => { T.chargeX = 0; const q = mk(); const r = new Run(q); r.step(2); T.chargeX = 1; return q.steady === 0; }, breathFactor: () => { T.breathFactor = .5; const q = mk(); q.steady = 90; const r = new Run(q); r.step(dt, { gift: true }); const t0 = q.t; r.step(1); T.breathFactor = .25; return Math.abs(q.t - t0 - .5) < .02; } }; for (const k in sliderEffect) check('slider changes behavior live: ' + k, sliderEffect[k]());\n  T.drainX = 2; D.page = 0; D.tab = 0; D.rows().rows.find(r => r.label === 'Reset everything').act(); check('Reset restores TUNING', T.drainX === G.TUNING.drainX && !G.tuningChanged()); const C = G.CHEATS; C.lockVitals = true; const q = mk(); q.v = 10; G.hurt(q, 5); check('lock vitals', q.v === 10); C.lockVitals = false; C.reveal = true; const q2 = mk(), n2 = add(q2, { t: 'nest', x: 1, y: 1 }); check('reveal hidden', G.visible(q2, n2)); C.reveal = false; C.freezeClock = true; const q3 = mk(), c3 = q3.clock, r3 = new Run(q3); r3.step(.5); check('freeze clock', q3.clock === c3); C.freezeClock = false; C.infiniteSteady = true; const q4 = mk(), r4 = new Run(q4); r4.step(.1); check('infinite Steady', q4.steady === 100); C.infiniteSteady = false; C.oneHit = true; const q5 = mk(), o5 = add(q5, { t: 'polyp', x: 100, y: 100 }), r5 = new Run(q5); r5.use('cautery').at(100, 100).press(); r5.step(.02); check('one-hit strains', o5.dead); C.oneHit = false; D.tab = 2; const J = D.rows(); check('jump rows', J.rows.length >= 8); J.rows[2].act(); check('force win', S.done === 'won'); D.toggle(false); }\ngame.advance(.8);\n{ const r = {}; for (const N of [1, 2, 3, 4]) { const players = [], seats = []; for (let i = 0; i < N; i++) players.push({ id: i, color: G.SEATS[i] }); const S = G.Op.create('grandrounds', { seed: 9, players }), bots = players.map((_, i) => new G.Bot({ seed: i * 3 + 1, speed: 300, react: .05 })), curs = players.map(() => G.Cursor.create()), whs = players.map(() => G.Wheel.create()); S.ev = []; let t = 0, retr = false; while (!S.done && t < 300) { const inp = S.players.map((p, i) => { const d = bots[i].update(S, p, curs[i], dt); G.Cursor.update(curs[i], p, d, S, dt); return G.buildInput(curs[i], G.Wheel.update(whs[i], p.toolNext, d, dt), d); }); G.Op.step(S, inp, dt); S.ev = []; t += dt; if (S.objs.some(o => o.type === 'retractorHandle')) retr = true; } check('Grand Rounds with ' + N + ' bots finishes', S.done === 'won', [S.done, S.phaseI, t | 0]); check('retractor phase seen with ' + N, retr); } }\n{ const S = G.Op.create('grandrounds', { seed: 1, phase: 2, players: [{ id: 0, color: '#fff' }] }); const r = new Run(S); S.ev = []; r.step(.5); const a = S.windowOpen; r.step(3); check('alone, Quill holds the retractor at half the window', a === true && S.windowOpen === false, [a, S.windowOpen]); const S2 = G.Op.create('grandrounds', { seed: 1, phase: 2, players: [{ id: 0, color: '#fff' }, { id: 1, color: '#fff' }] }); S2.ev = []; const h = S2.objs.find(o => o.type === 'retractorHandle'); for (let i = 0; i < 400; i++) { G.Op.step(S2, [{ x: h.x, y: h.y, tool: 'forceps', trig: i > 5 ? 1 : 0 }, null], dt); S2.ev = []; } check('with two, holding opens the window', S2.windowOpen && h.held); }\n// ---- the full playthrough ----\nG.testBot = true; E.store.clear && E.store.clear(); { const P = load({ draw: false }), g = P.game, Gx = P.G; Gx.testBot = true; g.fadeTime = 0; g.advance(.5); g.go('menu'); g.advance(.3); const name = () => Gx.sceneName(g.scene); const mn = Gx.SCENES.menu.m; g.go('difficulty'); g.advance(.3); Gx.SCENES.difficulty.i = 1; g.input.tap('confirm'); g.advance(.3); let t = 0, seen = {}, cases = [], ward = 0, res = {}; while (t < 3000 && !(name() === 'title' && seen.credits)) { const nm = name(); seen[nm] = (seen[nm] || 0) + 1; if (nm === 'story' || nm === 'chart' || nm === 'results' || nm === 'about') { g.input.tap('confirm'); g.advance(.25); t += .25; if (nm === 'about') { g.input.tap('cancel'); g.advance(.25); } } else if (nm === 'ward') { ward++; const W = Gx.SCENES.ward; W.leave(); g.advance(.5); t += .5; } else if (nm === 'op') { const c = Gx.op.S.caseId; if (cases[cases.length - 1] !== c) cases.push(c); g.advance(1); t += 1; } else if (nm === 'lost') { res.lost = (res.lost || 0) + 1; Gx.SCENES.lost.m.i = 0; g.input.tap('confirm'); g.advance(.5); t += .5; } else if (nm === 'credits') { g.input.hold('confirm'); g.advance(1); t += 1; g.input.hold('confirm', false); if (Gx.SCENES.credits.stage === 'last') { g.advance(1.2); g.input.tap('confirm'); g.advance(.3); } } else { g.advance(.5); t += .5; } }\n  check('full playthrough reaches the title again', name() === 'title' && seen.credits > 0, [name(), t | 0, cases, seen]); check('every case played in order', cases.join() === Gx.CASE_ORDER.join(), cases); check('the ward visited ten times', ward === 10, ward); check('no errors on the way', !g.errors.length, g.errors.slice(0, 3).map(e => e.message)); check('all ranks saved at Resident', Gx.CASE_ORDER.every(c => (Gx.prog.ranks[c] || {}).resident), Gx.prog.ranks); check('unlocks', Gx.CASE_ORDER.every(c => Gx.prog.unlocked.includes(c))); check('the ending opens the blank folder', Gx.prog.ended); }\n// ---- draw errors ----\n{ const P = load({ draw: true }), g = P.game, Gx = P.G; Gx.testBot = true; g.fadeTime = 0; g.advance(.5); for (const [n, d] of [['menu'], ['difficulty'], ['casefiles'], ['lobby'], ['about', { back: 'menu' }], ['credits', {}], ['chart', { caseId: 'c2', mode: 'files' }], ['ward', { map: 'ward3', after: 3 }], ['ward', { map: 'ship', after: 7 }]]) { g.go(n, d); g.advance(.6); } for (const c of [...Gx.CASE_ORDER, 'grandrounds', 'lab']) { const ph = Gx.CASES[c].phases.length; for (let i = 0; i < ph; i++) { g.go('op', { caseId: c, mode: 'files', difficulty: 'resident', phase: i }); g.advance(.5); } } check('every site and phase draws with no error', !g.errors.length, g.errors.slice(0, 3).map(e => (e.stack || e.message).slice(0, 220))); for (const k in Gx.CINE) { g.go('story', { id: 'c1_after', then: () => {} }); g.advance(.2); Gx.storyView.cine(k); g.advance(.6); Gx.storyView.player.finish(); Gx.storyView.player = null; Gx.story.stop(); } check('every cinematic draws', !g.errors.length, g.errors.slice(0, 2).map(e => (e.stack || e.message).slice(0, 220))); for (const id in Gx.SCRIPT) void id; for (const id in Gx.CAST) for (const e of ['neutral', 'smile', 'angry', 'sad', 'shock', 'shout']) Gx.bust(id, e, { talk: true }); check('every bust paints', !g.errors.length); }\n// ---- the exit interview ----\n{ const p = new URL('../exit-interview.json', ROOT), a = new URL('src/about-data.json', ROOT); if (existsSync(a)) { const A = JSON.parse(readFileSync(a)); const ok = v => typeof v === 'string' ? v.trim().length > 0 : Array.isArray(v) ? v.length > 0 && v.every(ok) : v && typeof v === 'object' ? Object.values(v).every(ok) : false; check('about-data parses, every field filled', ok(A)); check('exit interview exists and parses', existsSync(p) && !!JSON.parse(readFileSync(p))); if (existsSync(p)) { const X = JSON.parse(readFileSync(p)); check('exit interview shape', X.testingFeedback.length === 4 && X.engineFeedback.length === 6 && X.promptFeedback.length === 4 && X.aiHub.tags.length >= 3 && X.aiHub.tags.length <= 6 && !X.credits, Object.keys(X)); check('usage', X.sourceInformation.usage === 'added on import'); } } }\n// ---- browser ----\nif (!fast) { const r = spawnSync('python3', [new URL('browser.py', import.meta.url).pathname], { encoding: 'utf8', timeout: 400000 }); const m = r.stdout && r.stdout.trim().split('\\n').pop(); try { const q = JSON.parse(m); n += q.n; bad += q.fails.length; for (const f of q.fails) console.log('FAIL browser ' + f); } catch (e) { bad++; n++; console.log('FAIL browser run: ' + (r.stdout || '').slice(-300) + (r.stderr || '').slice(-300)); } const h = spawnSync('python3', [new URL('hub.py', import.meta.url).pathname], { encoding: 'utf8', timeout: 800000 }); const m2 = h.stdout && h.stdout.trim().split('\\n').pop(); try { const q = JSON.parse(m2); n += q.n; bad += q.fails.length; for (const f of q.fails) console.log('FAIL hub ' + f); } catch (e) { bad++; n++; console.log('FAIL hub run: ' + (h.stdout || '').slice(-300) + (h.stderr || '').slice(-300)); } }\nconsole.log(n + ' checks, ' + bad + ' failed'); process.exit(bad ? 1 : 0);\nEOF\nsed -i \"s#^G.testBot = true; E.store.clear#E.store.clear#\" tests/run.mjs; node tools/balance.mjs --par --perfect 2>&1 | cut -c1-110 | head -14; timeout 500 node tests/run.mjs --fast 2>&1 | grep -v \"^my-3D2dge\" | cut -c1-420 | tail -40","description":"Wr