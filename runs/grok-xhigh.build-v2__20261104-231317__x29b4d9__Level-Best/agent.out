/src/events/roomService.js\",\"matches\":[{\"line_number\":16,\"content\":\"  static title = 'Room Service';\"},{\"line_number\":18,\"content\":\"  static instructor = 'trudy';\"},{\"line_number\":21,\"content\":\"  static can = 'Alternate feet to walk. When the gust shows, lean into the green side early and gently.';\"},{\"line_number\":22,\"content\":\"  static cant = 'The same foot twice stumbles. A big late lean throws the glasses.';\"},{\"line_number\":23,\"content\":\"  static verbs = ['weight', 'leftFoot', 'rightFoot', 'flail'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/stillWater.js\",\"matches\":[{\"line_number\":15,\"content\":\"  static title = 'Still Water';\"},{\"line_number\":17,\"content\":\"  static instructor = 'stillwater';\"},{\"line_number\":20,\"content\":\"  static can = 'Sit in the calm. When a sneeze is coming, flail to stifle it.';\"},{\"line_number\":21,\"content\":\"  static cant = 'You cannot chase the creatures. Leaving the calm sends them off.';\"},{\"line_number\":22,\"content\":\"  static verbs = ['weight', 'flail', 'breathe'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/fruitHat.js\",\"matches\":[{\"line_number\":23,\"content\":\"  static title = 'Fruit Hat';\"},{\"line_number\":25,\"content\":\"  static instructor = 'trudy';\"},{\"line_number\":28,\"content\":\"  static can = 'Lean the basket hat under the shadow. Hop to bank what you are wearing.';\"},{\"line_number\":29,\"content\":\"  static cant = 'A fall spills everything you have not banked. You cannot keep it by standing still.';\"},{\"line_number\":30,\"content\":\"  static verbs = ['weight', 'hop', 'flail'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/raft.js\",\"matches\":[{\"line_number\":9,\"content\":\"  static title = 'Tippy Raft';\"},{\"line_number\":11,\"content\":\"  static instructor = 'trudy';\"},{\"line_number\":14,\"content\":\"  static can = 'Walk, hop, and flail to shove. Last one on the raft takes the round.';\"},{\"line_number\":15,\"content\":\"  static verbs = ['weight', 'hop', 'flail'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/plank.js\",\"matches\":[{\"line_number\":15,\"content\":\"  static title = 'Plank & Perch';\"},{\"line_number\":17,\"content\":\"  static instructor = 'bolster';\"},{\"line_number\":20,\"content\":\"  static can = 'Hold the plank. Counter the gulls with your weight. Flail shakes them off.';\"},{\"line_number\":21,\"content\":\"  static cant = 'Stay outside the zone for two seconds and you belly-flop. That rep of pride is gone.';\"},{\"line_number\":22,\"content\":\"  static verbs = ['weight', 'flail'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/logReps.js\",\"matches\":[{\"line_number\":15,\"content\":\"  static title = 'Log Reps';\"},{\"line_number\":17,\"content\":\"  static instructor = 'bolster';\"},{\"line_number\":20,\"content\":\"  static can = 'Follow the ribbon with both feet and keep the dot near the middle.';\"},{\"line_number\":21,\"content\":\"  static cant = 'The log is not a balance board. Lean it past the notch and Coach has to catch it.';\"},{\"line_number\":22,\"content\":\"  static verbs = ['weight', 'leftFoot', 'rightFoot'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/plates.js\",\"matches\":[{\"line_number\":20,\"content\":\"  static title = 'Plate Spinners';\"},{\"line_number\":22,\"content\":\"  static instructor = 'bolster';\"},{\"line_number\":25,\"content\":\"  static can = 'Circle the stick, or tap A and D. Each key press is half a turn. Match a plate\\\\'s band.';\"},{\"line_number\":26,\"content\":\"  static cant = 'You cannot fall here. You can only drop plates.';\"},{\"line_number\":27,\"content\":\"  static verbs = ['weight'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/cairn.js\",\"matches\":[{\"line_number\":20,\"content\":\"  static title = 'The Cairn';\"},{\"line_number\":22,\"content\":\"  static instructor = 'stillwater';\"},{\"line_number\":25,\"content\":\"  static can = 'Keep the slab level while stones are lowered onto it. Breathe with the ring.';\"},{\"line_number\":26,\"content\":\"  static cant = 'You can drop a stone. A flail will not put it back, and it costs a little form.';\"},{\"line_number\":27,\"content\":\"  static verbs = ['weight', 'flail', 'breathe'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/tug.js\",\"matches\":[{\"line_number\":16,\"content\":\"  static title = 'Tug of Peace';\"},{\"line_number\":18,\"content\":\"  static instructor = 'bolster';\"},{\"line_number\":21,\"content\":\"  static can = 'On Heave, squeeze both feet and lean back. First side to take the pull wins it.';\"},{\"line_number\":22,\"content\":\"  static cant = 'Lean back while they ease off and you sit down. This one is not in a remote class.';\"},{\"line_number\":23,\"content\":\"  static verbs = ['weight', 'leftFoot', 'rightFoot', 'flail'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/stepClass.js\",\"matches\":[{\"line_number\":13,\"content\":\"  static title = 'Step Class';\"},{\"line_number\":15,\"content\":\"  static instructor = 'bolster';\"},{\"line_number\":18,\"content\":\"  static can = 'Step on the footprints. Lean when the ribbon asks, and lead it a little.';\"},{\"line_number\":19,\"content\":\"  static cant = 'A foot note is not a lean. Missing the window trips someone in the class.';\"},{\"line_number\":20,\"content\":\"  static verbs = ['weight', 'leftFoot', 'rightFoot'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/springboard.js\",\"matches\":[{\"line_number\":12,\"content\":\"  static title = 'Springboard';\"},{\"line_number\":14,\"content\":\"  static instructor = 'trudy';\"},{\"line_number\":17,\"content\":\"  static can = 'Pump both feet as the board goes down. Hop near the top. In the air, aim for a clean line or a proud flop.';\"},{\"line_number\":18,\"content\":\"  static cant = 'You cannot steer the board with your weight. Late pumping barely lifts you.';\"},{\"line_number\":19,\"content\":\"  static verbs = ['leftFoot', 'rightFoot', 'hop', 'weight'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/grandHold.js\",\"matches\":[{\"line_number\":18,\"content\":\"  static title = 'The Grand Hold';\"},{\"line_number\":20,\"content\":\"  static instructor = 'trudy';\"},{\"line_number\":23,\"content\":\"  static can = 'Follow the remix. If you fall, the class catches you and the phase starts again.';\"},{\"line_number\":24,\"content\":\"  static cant = 'You cannot fail this. You can only take longer.';\"},{\"line_number\":25,\"content\":\"  static verbs = ['weight', 'flail', 'breathe', 'leftFoot', 'rightFoot'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/islandLoop.js\",\"matches\":[{\"line_number\":12,\"content\":\"  static title = 'Island Loop';\"},{\"line_number\":14,\"content\":\"  static instructor = 'trudy';\"},{\"line_number\":17,\"content\":\"  static can = 'Alternate your feet to jog the ring road. Steer with your weight. Stay with Kevin.';\"},{\"line_number\":18,\"content\":\"  static cant = 'You cannot sprint the whole way. Outside the pace band, the loop does not count.';\"},{\"line_number\":19,\"content\":\"  static verbs = ['weight', 'leftFoot', 'rightFoot'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/poses.js\",\"matches\":[{\"line_number\":19,\"content\":\"  static title = 'Poses';\"},{\"line_number\":21,\"content\":\"  static instructor = 'stillwater';\"},{\"line_number\":24,\"content\":\"  static can = 'Follow the ring with your weight. Breathe in while the breath ring grows.';\"},{\"line_number\":25,\"content\":\"  static cant = 'You can fall. Flail costs a little form, and it will not hold the pose for you.';\"},{\"line_number\":26,\"content\":\"  static verbs = ['weight', 'flail', 'breathe'];\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"0fb49257-5b76-49c5-981a-6a0ed8ad6b28"}
