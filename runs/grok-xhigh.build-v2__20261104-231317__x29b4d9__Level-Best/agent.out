dex),\\n      hover: (index) => { focus = index; paint(); },\\n      slide: (id, value) => { setTune(id, value); applySettings(); paint(); },\\n    });\\n  }\\n\\n  function applySettings() {\\n    audio.setGains(settings.music / 100, settings.sfx / 100, settings.voice / 100);\\n    inputs.forEach((input) => input.setRumble(settings.rumble));\\n  }\\n  applySettings();\\n\\n  function persist() {\\n    writeSave(storage, SAVE_KEY, { profile, settings });\\n  }\\n\\n  function tiltRad() {\\n    const rest = getTune('islandRest');\\n    return restTiltRad(profile.doneSteps.length, Math.max(1, programme.length), rest);\\n  }\\n\\n  function talk(speaker, bucket) {\\n    const line = takeLine(speaker, bucket, rng('talk'));\\n    if (!line) return;\\n    speech = { who: speaker === 'stillwater' ? 'Ms. Stillwater' : speaker === 'bolster' ? 'Coach Bolster' : 'Trudy', text: line.text, id: line.id };\\n    const rate = speaker === 'stillwater' ? 7 : speaker === 'bolster' ? 11 : 16;\\n    speechLeft = Math.max(0.8, line.text.length / rate);\\n    audio.say(line.text, speaker === 'guest' ? 'guest' : speaker);\\n  }\\n\\n  function choicesOf() {\\n    return model().choices;\\n  }\\n\\n  function setScreen(next, keepFocus = false) {\\n    screen = next;\\n    if (!keepFocus) focus = 0;\\n    page = 0;\\n    volumeOpen = false;\\n    if (next !== 'play') paused = false;\\n    for (const pad of pads) clearPad(pad);\\n    paint();\\n    persist();\\n  }\\n\\n  function today() {\\n    const plan = dayPlan(profile.dayIndex, eventIds());\\n    if (plan.maintenance) {\\n      const pool = eventIds().slice();\\n      const picked = [];\\n      while (picked.length < 3 && pool.length) {\\n        const i = Math.floor(rng('maintenance') * pool.length);\\n        picked.push(pool.splice(i, 1)[0]);\\n      }\\n      plan.classes = picked;\\n    }\\n    return plan;\\n  }\\n\\n  function tierFor(id) {\\n    if (!freePick && profile.dayIndex < 5) return 1;\\n    const best = profile.best[id] || {};\\n    return tiersOpen(best);\\n  }\\n\\n  function startEvent(id, extra = {}) {\\n    if (event) event.dispose();\\n    const Ctor = id === 'checkin' ? CheckIn : eventById(id);\\n    eventId = id;\\n    tier = extra.tier || (id === 'checkin' ? 1 : tierFor(id));\\n    const lanes = extra.lanes || (group && group.lanes && group.lanes.length ? group.lanes : [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] }]);\\n    event = new Ctor({\\n      tier, lanes, seed: extra.seed || 1, session: !!extra.session, god: extra.god || god,\\n      difficulty: settings.difficulty, tests: extra.tests, skill: extra.skill || 'sharp',\\n      label: `${id}-${profile.dayIndex}`,\\n    });\\n    if (event.build) event.build();\\n    audio.play(EVENT_TRACK[id] || 'island');\\n  }\\n\\n  function finishEvent() {\\n    if (!event) return;\\n    const result = event.result(0);\\n    const forms = event.lanes.map((_, i) => {\\n      const row = event.result(i);\\n      return row && Number.isFinite(row.form) ? row.form : 0;\\n    });\\n    lastResult = { ...result, forms, winner: result && Number.isFinite(result.winner) ? result.winner : null };\\n    profile.minutes += (event.t || 0) / 60;\\n    profile.floor += result.falls || 0;\\n    if (eventId !== 'checkin') {\\n      const form = result.form || 0;\\n      const best = profile.best[eventId] || {};\\n      best[tier] = Math.max(best[tier] || 0, form);\\n      profile.best[eventId] = best;\\n      if (!profile.met.includes(eventId)) profile.met.push(eventId);\\n      if (programme.includes(eventId) && !profile.doneSteps.includes(eventId)) profile.doneSteps.push(eventId);\\n      const first = !profile.cleared[eventId];\\n      jarPay = marblePayout({\\n        seconds: event.t || 0, form, firstClear: first,\\n        perMin: getTune('marblesPerMin'), medalScale: getTune('medalScale'),\\n      });\\n      profile.cleared[eventId] = true;\\n      profile.medals.push({ id: eventId, tier, form, medal: result.medal });\\n      if (!profile.classDone.includes(eventId)) profile.classDone.push(eventId);\\n    }\\n    event.dispose();\\n    event = null;\\n    audio.setTilt(tiltRad());\\n  }\\n\\n  function woke(sample, travel) {\\n    const e = sample.edges;\\n    if (e.confirm || e.back || e.pause || e.hop || e.flail || e.ask || e.up || e.down || e.left || e.right || e.recenter) return true;\\n    if (sample.padConnected && Math.hypot(sample.wish.x, sample.wish.y) > 0.3) return true;\\n    if (travel > 8) return true;\\n    return false;\\n  }\\n\\n  function menuMove(sample) {\\n    const list = choicesOf();\\n    const n = list.length || 1;\\n    if (sample.edges.up) focus = (focus - 1 + n) % n;\\n    if (sample.edges.down) focus = (focus + 1) % n;\\n    if (sample.edges.left || sample.edges.right) nudge(list[focus], sample.edges.right ? 1 : -1);\\n    if (sample.edges.confirm) activate(focus);\\n    if (sample.edges.back) back();\\n  }\\n\\n  function nudge(choice, dir) {\\n    if (!choice) return;\\n    if (choice.kind === 'slider') {\\n      const def = TUNING_DEFS.find((d) => d.id === choice.id);\\n      if (def) setTune(choice.id, getTune(choice.id) + dir * def.step);\\n      return;\\n\",\"total_lines\":1297}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e343490b-7eb5-4cca-ae78-79b4eb09dce7-13","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/** The balance core. One step, shared by every standing event and by the tests. */\\n\\nexport const DEG = Math.PI / 180;\\nconst COM = 0.75;\\n\\nexport function freshBalance() {\\n  return {\\n    wishX: 0,\\n    wishZ: 0,\\n10→    wx: 0,\\n    wz: 0,\\n    leanX: 0,\\n    leanZ: 0,\\n    flailLeft: 0,\\n    flailCool: 0,\\n    fallen: false,\\n    falls: 0,\\n    recoverLeft: 0,\\n    grace: 0,\\n20→    nxHold: 0,\\n    nzHold: 0,\\n  };\\n}\\n\\nexport function constantsFor(margin, zeta) {\\n  const G = 9.81 * COM;\\n  const I = COM * COM + 0.06;\\n  const K = G * (1 + margin);\\n  const wn = Math.sqrt(Math.max(0, (K - G) / I));\\n30→  const D = 2 * zeta * wn * I;\\n  return { G, I, K, D, limit: K - G };\\n}\\n\\nexport function readLean(body) {\\n  const q = body.rotation();\\n  const ux = 2 * (q.x * q.y - q.w * q.z);\\n  const uy = 1 - 2 * (q.x * q.x + q.z * q.z);\\n  const uz = 2 * (q.y * q.z + q.w * q.x);\\n  const leanX = Math.atan2(ux, uy);\\n40→  const leanZ = Math.atan2(uz, uy);\\n  const tilt = Math.atan2(Math.hypot(ux, uz), uy);\\n  return { leanX, leanZ, tilt, ux, uy, uz };\\n}\\n\\n/** Slow sway plus a little tremor. ph comes from the event seed. Units are N·m. */\\nexport function swayTorque(time, ph, sway, tremor) {\\n  const nx = sway * (Math.sin(time * 0.9 + ph) * 0.6 + Math.sin(time * 1.73 + ph * 2.1) * 0.4)\\n    + tremor * (Math.sin(time * 8.2 + 1.1) * 0.6 + Math.sin(time * 18.3) * 0.4);\\n  const nz = sway * (Math.sin(time * 0.77 + ph * 1.7) * 0.6 + Math.sin(time * 1.51 + ph * 0.6) * 0.4)\\n50→    + tremor * (Math.sin(time * 7.1 + 2.3) * 0.6 + Math.sin(time * 15.7 + 0.7) * 0.4);\\n  return { nx, nz };\\n}\\n\\nexport function pressFlail(state, cooldown) {\\n  if (state.flailCool > 0 || state.flailLeft > 0 || state.fallen) return false;\\n  state.flailLeft = 0.35;\\n  state.flailCool = cooldown;\\n  return true;\\n}\\n60→\\nexport function tickTimers(state, dt) {\\n  if (state.flailLeft > 0) state.flailLeft = Math.max(0, state.flailLeft - dt);\\n  if (state.flailCool > 0) state.flailCool = Math.max(0, state.flailCool - dt);\\n  if (state.grace > 0) state.grace = Math.max(0, state.grace - dt);\\n  if (state.recoverLeft > 0) state.recoverLeft = Math.max(0, state.recoverLeft - dt);\\n}\\n\\n/**\\n * Apply the ankle torque for one fixed step. Call before world.step().\\n70→ * tune: { maxLean (deg), margin, zeta, ankleMax, reflex, flailBoost, swayScale, disturbScale }\\n * nx, nz are disturbances in N·m, added after the ankle clamp.\\n */\\nexport function balanceStep(body, state, dt, tune, nx = 0, nz = 0) {\\n  if (!body.isEnabled()) return readLean(body);\\n  const maxLean = tune.maxLean * DEG;\\n  const reflex = tune.reflex;\\n  const r = 1 - Math.exp(-reflex * dt);\\n  state.wx += (state.wishX - state.wx) * r;\\n  state.wz += (state.wishZ - state.wz) * r;\\n80→  const tx = state.wx * maxLean;\\n  const tz = state.wz * maxLean;\\n  const lean = readLean(body);\\n  state.leanX = lean.leanX;\\n  state.leanZ = lean.leanZ;\\n  const { G, K, D } = constantsFor(tune.margin, tune.zeta);\\n  const w = body.angvel();\\n  let Tx = -(G * Math.sin(tx) + K * (lean.leanX - tx)) + D * w.z;\\n  let Tz = -(G * Math.sin(tz) + K * (lean.leanZ - tz)) - D * w.x;\\n  const limit = tune.ankleMax * (state.flailLeft > 0 ? tune.flailBoost : 1);\\n90→  const m = Math.hypot(Tx, Tz);\\n  if (m > limit) {\\n    Tx *= limit / m;\\n    Tz *= limit / m;\\n  }\\n  const ds = tune.disturbScale ?? 1;\\n  const ss = tune.swayScale ?? 1;\\n  body.resetTorques(true);\\n  body.addTorque({ x: Tz + nz * ds * ss, y: -w.y * 0.6, z: -(Tx + nx * ds * ss) }, true);\\n  return lean;\\n100→}\\n\\n/** After world.step(), decide whether this lean is a fall. */\\nexport function checkFall(body, state, tune, godMode = false) {\\n  if (godMode || state.fallen || state.grace > 0 || !body.isEnabled()) return false;\\n  const lean = readLean(body);\\n  state.leanX = lean.leanX;\\n  state.leanZ = lean.leanZ;\\n  if (lean.tilt >= tune.fallAngle * DEG) {\\n    state.fallen = true;\\n110→    state.falls += 1;\\n    state.recoverLeft = tune.recoverTime;\\n    return true;\\n  }\\n  return false;\\n}\\n\\n/** Put the core back on its foot. Clears the cached lean so it does not fall again at once. */\\nexport function resetCore(doll, state) {\\n  const { body } = doll;\\n120→  body.setEnabled(true);\\n  body.setTranslation({ x: doll.homeX, y: 0.75, z: doll.homeZ }, true);\\n  body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true);\\n  body.setLinvel({ x: 0, y: 0, z: 0 }, true);\\n  body.setAngvel({ x: 0, y: 0, z: 0 }, true);\\n  state.leanX = 0;\\n  state.leanZ = 0;\\n  state.wx = 0;\\n  state.wz = 0;\\n  state.wishX = 0;\\n130→  state.wishZ = 0;\\n  state.fallen = false;\\n  state.grace = 0.35;\\n  state.recoverLeft = 0;\\n}\\n\\nexport function tuneFrom(values, extra = {}) {\\n  return {\\n    maxLean: extra.maxLean ?? values.maxLean,\\n    margin: extra.margin ?? values.margin,\\n140→    zeta: values.zeta,\\n    ankleMax: (extra.ankleMax ?? values.ankleMax) * (extra.ankleMul ?? 1),\\n    reflex: extra.reflex ?? values.reflex,\\n    flailBoost: values.flailBoost,\\n    fallAngle: values.fallAngle,\\n    recoverTime: values.recoverTime,\\n    swayScale: (extra.swayScale ?? 1) * (values.swayScale ?? 1),\\n    disturbScale: extra.disturbScale ?? 1,\\n  };\\n}\\n150→\\n/** Difficulty: Gentle / Standard / Honest. */\\nexport function difficultyOf(name) {\\n  if (name === 'gentle') return { ankleMul: 1.25, disturb: 0.65, rhythm: 1.4 };\\n  if (name === 'honest') return { ankleMul: 0.9, disturb: 1.2, rhythm: 0.8 };\\n  return { ankleMul: 1, disturb: 1, rhythm: 1 };\\n}\\n\\nexport function cobOf(state, maxLeanDeg) {\\n  const m = Math.max(1e-4, maxLeanDeg * DEG);\\n160→  return { x: state.leanX / m, z: state.leanZ / m };\\n}\\n\",\"content_concise\":\"1→/** The balance core. One step, shared by every standing event and by the tests. */\\n\\nexport const DEG = Math.PI / 180;\\nconst COM = 0.75;\\n\\nexport function freshBalance() {\\n  return {\\n    wishX: 0,\\n    wishZ: 0,\\n10→    wx: 0,\\n    wz: 0,\\n    leanX: 0,\\n    leanZ: 0,\\n    flailLeft: 0,\\n    flailCool: 0,\\n    fallen: false,\\n    falls: 0,\\n    recoverLeft: 0,\\n    grace: 0,\\n20→    nxHold: 0,\\n    nzHold: 0,\\n  };\\n}\\n\\nexport function constantsFor(margin, zeta) {\\n  const G = 9.81 * COM;\\n  const I = COM * COM + 0.06;\\n  const K = G * (1 + margin);\\n  const wn = Math.sqrt(Math.max(0, (K - G) / I));\\n30→  const D = 2 * zeta * wn * I;\\n  return { G, I, K, D, limit: K - G };\\n}\\n\\nexport function readLean(body) {\\n  const q = body.rotation();\\n  const ux = 2 * (q.x * q.y - q.w * q.z);\\n  const uy = 1 - 2 * (q.x * q.x + q.z * q.z);\\n  const uz = 2 * (q.y * q.z + q.w * q.x);\\n  const leanX = Math.atan2(ux, uy);\\n40→  const leanZ = Math.atan2(uz, uy);\\n  const tilt = Math.atan2(Math.hypot(ux, uz), uy);\\n  return { leanX, leanZ, tilt, ux, uy, uz };\\n}\\n\\n/** Slow sway plus a little tremor. ph comes from the event seed. Units are N·m. */\\nexport function swayTorque(time, ph, sway, tremor) {\\n  const nx = sway * (Math.sin(time * 0.9 + ph) * 0.6 + Math.sin(time * 1.73 + ph * 2.1) * 0.4)\\n    + tremor * (Math.sin(time * 8.2 + 1.1) * 0.6 + Math.sin(time * 18.3) * 0.4);\\n  const nz = sway * (Math.sin(time * 0.77 + ph * 1.7) * 0.6 + Math.sin(time * 1.51 + ph * 0.6) * 0.4)\\n50→    + tremor * (Math.sin(time * 7.1 + 2.3) * 0.6 + Math.sin(time * 15.7 + 0.7) * 0.4);\\n  return { nx, nz };\\n}\\n\\nexport function pressFlail(state, cooldown) {\\n  if (state.flailCool > 0 || state.flailLeft > 0 || state.fallen) return false;\\n  state.flailLeft = 0.35;\\n  state.flailCool = cooldown;\\n  return true;\\n}\\n60→\\nexport function tickTimers(state, dt) {\\n  if (state.flailLeft > 0) state.flailLeft = Math.max(0, state.flailLeft - dt);\\n  if (state.flailCool > 0) state.flailCool = Math.max(0, state.flailCool - dt);\\n  if (state.grace > 0) state.grace = Math.max(0, state.grace - dt);\\n  if (state.recoverLeft > 0) state.recoverLeft = Math.max(0, state.recoverLeft - dt);\\n}\\n\\n/**\\n * Apply the ankle torque for one fixed step. Call before world.step().\\n70→ * tune: { maxLean (deg), margin, zeta, ankleMax, reflex, flailBoost, swayScale, disturbScale }\\n * nx, nz are disturbances in N·m, added after the ankle clamp.\\n */\\nexport function balanceStep(body, state, dt, tune, nx = 0, nz = 0) {\\n  if (!body.isEnabled()) return readLean(body);\\n  const maxLean = tune.maxLean * DEG;\\n  const reflex = tune.reflex;\\n  const r = 1 - Math.exp(-reflex * dt);\\n  state.wx += (state.wishX - state.wx) * r;\\n  state.wz += (state.wishZ - state.wz) * r;\\n80→  const tx = state.wx * maxLean;\\n  const tz = state.wz * maxLean;\\n  const lean = readLean(body);\\n  state.leanX = lean.leanX;\\n  state.leanZ = lean.leanZ;\\n  const { G, K, D } = constantsFor(tune.margin, tune.zeta);\\n  const w = body.angvel();\\n  let Tx = -(G * Math.sin(tx) + K * (lean.leanX - tx)) + D * w.z;\\n  let Tz = -(G * Math.sin(tz) + K * (lean.leanZ - tz)) - D * w.x;\\n  const limit = tune.ankleMax * (state.flailLeft > 0 ? tune.flailBoost : 1);\\n90→  const m = Math.hypot(Tx, Tz);\\n  if (m > limit) {\\n    Tx *= limit / m;\\n    Tz *= limit / m;\\n  }\\n  const ds = tune.disturbScale ?? 1;\\n  const ss = tune.swayScale ?? 1;\\n  body.resetTorques(true);\\n  body.addTorque({ x: Tz + nz * ds * ss, y: -w.y * 0.6, z: -(Tx + nx * ds * ss) }, true);\\n  return lean;\\n100→}\\n\\n/** After world.step(), decide whether this lean is a fall. */\\nexport function checkFall(body, state, tune, godMode = false) {\\n  if (godMode || state.fallen || state.grace > 0 || !body.isEnabled()) return false;\\n  const lean = readLean(body);\\n  state.leanX = lean.leanX;\\n  state.leanZ = lean.leanZ;\\n  if (lean.tilt >= tune.fallAngle * DEG) {\\n    state.fallen = true;\\n110→    state.falls += 1;\\n    state.recoverLeft = tune.recoverTime;\\n    return true;\\n  }\\n  return false;\\n}\\n\\n/** Put the core back on its foot. Clears the cached lean so it does not fall again at once. */\\nexport function resetCore(doll, state) {\\n  const { body } = doll;\\n120→  body.setEnabled(true);\\n  body.setTranslation({ x: doll.homeX, y: 0.75, z: doll.homeZ }, true);\\n  body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true);\\n  body.setLinvel({ x: 0, y: 0, z: 0 }, true);\\n  body.setAngvel({ x: 0, y: 0, z: 0 }, true);\\n  state.leanX = 0;\\n  state.leanZ = 0;\\n  state.wx = 0;\\n  state.wz = 0;\\n  state.wishX = 0;\\n130→  state.wishZ = 0;\\n  state.fallen = false;\\n  state.grace = 0.35;\\n  state.recoverLeft = 0;\\n}\\n\\nexport function tuneFrom(values, extra = {}) {\\n  return {\\n    maxLean: extra.maxLean ?? values.maxLean,\\n    margin: extra.margin ?? values.margin,\\n140→    zeta: values.zeta,\\n    ankleMax: (extra.ankleMax ?? values.ankleMax) * (extra.ankleMul ?? 1),\\n    reflex: extra.reflex ?? values.reflex,\\n    flailBoost: values.flailBoost,\\n    fallAngle: values.fallAngle,\\n    recoverTime: values.recoverTime,\\n    swayScale: (extra.swayScale ?? 1) * (values.swayScale ?? 1),\\n    disturbScale: extra.disturbScale ?? 1,\\n  };\\n}\\n150→\\n/** Difficulty: Gentle / Standard / Honest. */\\nexport function difficultyOf(name) {\\n  if (name === 'gentle') return { ankleMul: 1.25, disturb: 0.65, rhythm: 1.4 };\\n  if (name === 'honest') return { ankleMul: 0.9, disturb: 1.2, rhythm: 0.8 };\\n  return { ankleMul: 1, disturb: 1, rhythm: 1 };\\n}\\n\\nexport function cobOf(state, maxLeanDeg) {\\n  const m = Math.max(1e-4, maxLeanDeg * DEG);\\n160→  return { x: state.leanX / m, z: state.leanZ / m };\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/physics/balancer.js\",\"offset\":null,\"raw_output\":\"/** The balance core. One step, shared by every standing event and by the tests. */\\n\\nexport const DEG = Math.PI / 180;\\nconst COM = 0.75;\\n\\nexport function freshBalance() {\\n  return {\\n    wishX: 0,\\n    wishZ: 0,\\n    wx: 0,\\n    wz: 0,\\n    leanX: 0,\\n    leanZ: 0,\\n    flailLeft: 0,\\n    flailCool: 0,\\n    fallen: false,\\n    falls: 0,\\n    recoverLeft: 0,\\n    grace: 0,\\n    nxHold: 0,\\n    nzHold: 0,\\n  };\\n}\\n\\nexport function constantsFor(margin, zeta) {\\n  const G = 9.81 * COM;\\n  const I = COM * COM + 0.06;\\n  const K = G * (1 + margin);\\n  const wn = Math.sqrt(Math.max(0, (K - G) / I));\\n  const D = 2 * zeta * wn * I;\\n  return { G, I, K, D, limit: K - G };\\n}\\n\\nexport function readLean(body) {\\n  const q = body.rotation();\\n  const ux = 2 * (q.x * q.y - q.w * q.z);\\n  const uy = 1 - 2 * (q.x * q.x + q.z * q.z);\\n  const uz = 2 * (q.y * q.z + q.w * q.x);\\n  const leanX = Math.atan2(ux, uy);\\n  const leanZ = Math.atan2(uz, uy);\\n  const tilt = Math.atan2(Math.hypot(ux, uz), uy);\\n  return { leanX, leanZ, tilt, ux, uy, uz };\\n}\\n\\n/** Slow sway plus a little tremor. ph comes from the event seed. Units are N·m. */\\nexport function swayTorque(time, ph, sway, tremor) {\\n  const nx = sway * (Math.sin(time * 0.9 + ph) * 0.6 + Math.sin(time * 1.73 + ph * 2.1) * 0.4)\\n    + tremor * (Math.sin(time * 8.2 + 1.1) * 0.6 + Math.sin(time * 18.3) * 0.4);\\n  const nz = sway * (Math.sin(time * 0.77 + ph * 1.7) * 0.6 + Math.sin(time * 1.51 + ph * 0.6) * 0.4)\\n    + tremor * (Math.sin(time * 7.1 + 2.3) * 0.6 + Math.sin(time * 15.7 + 0.7) * 0.4);\\n  return { nx, nz };\\n}\\n\\nexport function pressFlail(state, cooldown) {\\n  if (state.flailCool > 0 || state.flailLeft > 0 || state.fallen) return false;\\n  state.flailLeft = 0.35;\\n  state.flailCool = cooldown;\\n  return true;\\n}\\n\\nexport function tickTimers(state, dt) {\\n  if (state.flailLeft > 0) state.flailLeft = Math.max(0, state.flailLeft - dt);\\n  if (state.flailCool > 0) state.flailCool = Math.max(0, state.flailCool - dt);\\n  if (state.grace > 0) state.grace = Math.max(0, state.grace - dt);\\n  if (state.recoverLeft > 0) state.recoverLeft = Math.max(0, state.recoverLeft - dt);\\n}\\n\\n/**\\n * Apply the ankle torque for one fixed step. Call before world.step().\\n * tune: { maxLean (deg), margin, zeta, ankleMax, reflex, flailBoost, swayScale, disturbScale }\\n * nx, nz are disturbances in N·m, added after the ankle clamp.\\n */\\nexport function balanceStep(body, state, dt, tune, nx = 0, nz = 0) {\\n  if (!body.isEnabled()) return readLean(body);\\n  const maxLean = tune.maxLean * DEG;\\n  const reflex = tune.reflex;\\n  const r = 1 - Math.exp(-reflex * dt);\\n  state.wx += (state.wishX - state.wx) * r;\\n  state.wz += (state.wishZ - state.wz) * r;\\n  const tx = state.wx * maxLean;\\n  const tz = state.wz * maxLean;\\n  const lean = readLean(body);\\n  state.leanX = lean.leanX;\\n  state.leanZ = lean.leanZ;\\n  const { G, K, D } = constantsFor(tune.margin, tune.zeta);\\n  const w = body.angvel();\\n  let Tx = -(G * Math.sin(tx) + K * (lean.leanX - tx)) + D * w.z;\\n  let Tz = -(G * Math.sin(tz) + K * (lean.leanZ - tz)) - D * w.x;\\n  const limit = tune.ankleMax * (state.flailLeft > 0 ? tune.flailBoost : 1);\\n  const m = Math.hypot(Tx, Tz);\\n  if (m > limit) {\\n    Tx *= limit / m;\\n    Tz *= limit / m;\\n  }\\n  const ds = tune.disturbScale ?? 1;\\n  const ss = tune.swayScale ?? 1;\\n  body.resetTorques(true);\\n  body.addTorque({ x: Tz + nz * ds * ss, y: -w.y * 0.6, z: -(Tx + nx * ds * ss) }, true);\\n  return lean;\\n}\\n\\n/** After world.step(), decide whether this lean is a fall. */\\nexport function checkFall(body, state, tune, godMode = false) {\\n  if (godMode || state.fallen || state.grace > 0 || !body.isEnabled()) return false;\\n  const lean = readLean(body);\\n  state.leanX = lean.leanX;\\n  state.leanZ = lean.leanZ;\\n  if (lean.tilt >= tune.fallAngle * DEG) {\\n    state.fallen = true;\\n    state.falls += 1;\\n    state.recoverLeft = tune.recoverTime;\\n    return true;\\n  }\\n  return false;\\n}\\n\\n/** Put the core back on its foot. Clears the cached lean so it does not fall again at once. */\\nexport function resetCore(doll, state) {\\n  const { body } = doll;\\n  body.setEnabled(true);\\n  body.setTranslation({ x: doll.homeX, y: 0.75, z: doll.homeZ }, true);\\n  body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true);\\n  body.setLinvel({ x: 0, y: 0, z: 0 }, true);\\n  body.setAngvel({ x: 0, y: 0, z: 0 }, true);\\n  state.leanX = 0;\\n  state.leanZ = 0;\\n  state.wx = 0;\\n  state.wz = 0;\\n  state.wishX = 0;\\n  state.wishZ = 0;\\n  state.fallen = false;\\n  state.grace = 0.35;\\n  state.recoverLeft = 0;\\n}\\n\\nexport function tuneFrom(values, extra = {}) {\\n  return {\\n    maxLean: extra.maxLean ?? values.maxLean,\\n    margin: extra.margin ?? values.margin,\\n    zeta: values.zeta,\\n    ankleMax: (extra.ankleMax ?? values.ankleMax) * (extra.ankleMul ?? 1),\\n    reflex: extra.reflex ?? values.reflex,\\n    flailBoost: values.flailBoost,\\n    fallAngle: values.fallAngle,\\n    recoverTime: values.recoverTime,\\n    swayScale: (extra.swayScale ?? 1) * (values.swayScale ?? 1),\\n    disturbScale: extra.disturbScale ?? 1,\\n  };\\n}\\n\\n/** Difficulty: Gentle / Standard / Honest. */\\nexport function difficultyOf(name) {\\n  if (name === 'gentle') return { ankleMul: 1.25, disturb: 0.65, rhythm: 1.4 };\\n  if (name === 'honest') return { ankleMul: 0.9, disturb: 1.2, rhythm: 0.8 };\\n  return { ankleMul: 1, disturb: 1, rhythm: 1 };\\n}\\n\\nexport function cobOf(state, maxLeanDeg) {\\n  const m = Math.max(1e-4, maxLeanDeg * DEG);\\n  return { x: state.leanX / m, z: state.leanZ / m };\\n}\\n\",\"total_lines\":161}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e343490b-7eb5-4cca-ae78-79b4eb09dce7-14","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import RAPIER from '@dimforge/rapier3d-compat';\\nimport { FIXED_DT } from '../data/config.js';\\n\\nlet initPromise = null;\\n\\nexport function initRapier() {\\n  if (!initPromise) {\\n    const bytes = globalThis.__LEVEL_BEST_WASM__ || null;\\n    initPromise = bytes ? RAPIER.init({ module_or_path: bytes }) : RAPIER.init();\\n10→  }\\n  return initPromise;\\n}\\n\\nexport { RAPIER, FIXED_DT };\\n\\nexport const GROUND = 0x0001;\\nexport const RAGDOLL = 0x1000;\\n\\nexport function propBit(i) {\\n20→  return 0x0010 << i;\\n}\\n\\nexport function dollBit(i) {\\n  return 0x0100 << i;\\n}\\n\\nexport function group(member, filter) {\\n  return ((member & 0xffff) << 16) | (filter & 0xffff);\\n}\\n30→\\nexport function dollGroups(i) {\\n  return group(dollBit(i), propBit(i));\\n}\\n\\nexport function propGroups(i) {\\n  return group(propBit(i), dollBit(i) | propBit(i) | GROUND);\\n}\\n\\nexport function groundGroups() {\\n40→  return group(GROUND, 0x00f0 | RAGDOLL);\\n}\\n\\nexport function ragdollGroups() {\\n  return group(RAGDOLL, GROUND);\\n}\\n\\nexport function makeWorld(iterations = 8) {\\n  const world = new RAPIER.World({ x: 0, y: -9.81, z: 0 });\\n  world.timestep = FIXED_DT;\\n50→  world.integrationParameters.numSolverIterations = iterations;\\n  return world;\\n}\\n\\nexport function addGround(world, half = 30, friction = 0.9) {\\n  const body = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, -0.3, 0));\\n  world.createCollider(\\n    RAPIER.ColliderDesc.cuboid(half, 0.3, half).setFriction(friction).setCollisionGroups(groundGroups()),\\n    body,\\n  );\\n60→  return body;\\n}\\n\\n/** One standing doll: kinematic foot, dynamic capsule, ball joint at the sole. */\\nexport function createDollBody(world, lane, x, z) {\\n  const foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x, 0, z));\\n  const body = world.createRigidBody(\\n    RAPIER.RigidBodyDesc.dynamic()\\n      .setTranslation(x, 0.75, z)\\n      .setCanSleep(false)\\n70→      .setAdditionalSolverIterations(4),\\n  );\\n  world.createCollider(\\n    RAPIER.ColliderDesc.capsule(0.5, 0.25).setMass(1).setFriction(0.5).setCollisionGroups(dollGroups(lane)),\\n    body,\\n  );\\n  const joint = world.createImpulseJoint(\\n    RAPIER.JointData.spherical({ x: 0, y: 0, z: 0 }, { x: 0, y: -0.75, z: 0 }),\\n    foot,\\n    body,\\n80→    true,\\n  );\\n  joint.setContactsEnabled(false);\\n  return { foot, body, joint, lane, homeX: x, homeZ: z };\\n}\\n\\nexport function bodyCount(world) {\\n  return world.bodies.len();\\n}\\n\\n90→export function freeWorld(world) {\\n  if (world && !world.freed) {\\n    world.free();\\n    world.freed = true;\\n  }\\n}\\n\\nexport function quatFromYaw(yaw) {\\n  const h = yaw * 0.5;\\n  return { x: 0, y: Math.sin(h), z: 0, w: Math.cos(h) };\\n100→}\\n\\nexport function rotateVec(q, v) {\\n  const { x: qx, y: qy, z: qz, w: qw } = q;\\n  const { x: vx, y: vy, z: vz } = v;\\n  const tx = 2 * (qy * vz - qz * vy);\\n  const ty = 2 * (qz * vx - qx * vz);\\n  const tz = 2 * (qx * vy - qy * vx);\\n  return {\\n    x: vx + qw * tx + (qy * tz - qz * ty),\\n110→    y: vy + qw * ty + (qz * tx - qx * tz),\\n    z: vz + qw * tz + (qx * ty - qy * tx),\\n  };\\n}\\n\\nexport function bodyPoint(body, local) {\\n  const t = body.translation();\\n  const q = body.rotation();\\n  const r = rotateVec(q, local);\\n  return { x: t.x + r.x, y: t.y + r.y, z: t.z + r.z };\\n120→}\\n\\nexport function finiteVec(v) {\\n  return v && Number.isFinite(v.x) && Number.isFinite(v.y) && Number.isFinite(v.z);\\n}\\n\",\"content_concise\":\"1→import RAPIER from '@dimforge/rapier3d-compat';\\nimport { FIXED_DT } from '../data/config.js';\\n\\nlet initPromise = null;\\n\\nexport function initRapier() {\\n  if (!initPromise) {\\n    const bytes = globalThis.__LEVEL_BEST_WASM__ || null;\\n    initPromise = bytes ? RAPIER.init({ module_or_path: bytes }) : RAPIER.init();\\n10→  }\\n  return initPromise;\\n}\\n\\nexport { RAPIER, FIXED_DT };\\n\\nexport const GROUND = 0x0001;\\nexport const RAGDOLL = 0x1000;\\n\\nexport function propBit(i) {\\n20→  return 0x0010 << i;\\n}\\n\\nexport function dollBit(i) {\\n  return 0x0100 << i;\\n}\\n\\nexport function group(member, filter) {\\n  return ((member & 0xffff) << 16) | (filter & 0xffff);\\n}\\n30→\\nexport function dollGroups(i) {\\n  return group(dollBit(i), propBit(i));\\n}\\n\\nexport function propGroups(i) {\\n  return group(propBit(i), dollBit(i) | propBit(i) | GROUND);\\n}\\n\\nexport function groundGroups() {\\n40→  return group(GROUND, 0x00f0 | RAGDOLL);\\n}\\n\\nexport function ragdollGroups() {\\n  return group(RAGDOLL, GROUND);\\n}\\n\\nexport function makeWorld(iterations = 8) {\\n  const world = new RAPIER.World({ x: 0, y: -9.81, z: 0 });\\n  world.timestep = FIXED_DT;\\n50→  world.integrationParameters.numSolverIterations = iterations;\\n  return world;\\n}\\n\\nexport function addGround(world, half = 30, friction = 0.9) {\\n  const body = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, -0.3, 0));\\n  world.createCollider(\\n    RAPIER.ColliderDesc.cuboid(half, 0.3, half).setFriction(friction).setCollisionGroups(groundGroups()),\\n    body,\\n  );\\n60→  return body;\\n}\\n\\n/** One standing doll: kinematic foot, dynamic capsule, ball joint at the sole. */\\nexport function createDollBody(world, lane, x, z) {\\n  const foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x, 0, z));\\n  const body = world.createRigidBody(\\n    RAPIER.RigidBodyDesc.dynamic()\\n      .setTranslation(x, 0.75, z)\\n      .setCanSleep(false)\\n70→      .setAdditionalSolverIterations(4),\\n  );\\n  world.createCollider(\\n    RAPIER.ColliderDesc.capsule(0.5, 0.25).setMass(1).setFriction(0.5).setCollisionGroups(dollGroups(lane)),\\n    body,\\n  );\\n  const joint = world.createImpulseJoint(\\n    RAPIER.JointData.spherical({ x: 0, y: 0, z: 0 }, { x: 0, y: -0.75, z: 0 }),\\n    foot,\\n    body,\\n80→    true,\\n  );\\n  joint.setContactsEnabled(false);\\n  return { foot, body, joint, lane, homeX: x, homeZ: z };\\n}\\n\\nexport function bodyCount(world) {\\n  return world.bodies.len();\\n}\\n\\n90→export function freeWorld(world) {\\n  if (world && !world.freed) {\\n    world.free();\\n    world.freed = true;\\n  }\\n}\\n\\nexport function quatFromYaw(yaw) {\\n  const h = yaw * 0.5;\\n  return { x: 0, y: Math.sin(h), z: 0, w: Math.cos(h) };\\n100→}\\n\\nexport function rotateVec(q, v) {\\n  const { x: qx, y: qy, z: qz, w: qw } = q;\\n  const { x: vx, y: vy, z: vz } = v;\\n  const tx = 2 * (qy * vz - qz * vy);\\n  const ty = 2 * (qz * vx - qx * vz);\\n  const tz = 2 * (qx * vy - qy * vx);\\n  return {\\n    x: vx + qw * tx + (qy * tz - qz * ty),\\n110→    y: vy + qw * ty + (qz * tx - qx * tz),\\n    z: vz + qw * tz + (qx * ty - qy * tx),\\n  };\\n}\\n\\nexport function bodyPoint(body, local) {\\n  const t = body.translation();\\n  const q = body.rotation();\\n  const r = rotateVec(q, local);\\n  return { x: t.x + r.x, y: t.y + r.y, z: t.z + r.z };\\n120→}\\n\\nexport function finiteVec(v) {\\n  return v && Number.isFinite(v.x) && Number.isFinite(v.y) && Number.isFinite(v.z);\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/physics/world.js\",\"offset\":null,\"limit\":160,\"raw_output\":\"import RAPIER from '@dimforge/rapier3d-compat';\\nimport { FIXED_DT } from '../data/config.js';\\n\\nlet initPromise = null;\\n\\nexport function initRapier() {\\n  if (!initPromise) {\\n    const bytes = globalThis.__LEVEL_BEST_WASM__ || null;\\n    initPromise = bytes ? RAPIER.init({ module_or_path: bytes }) : RAPIER.init();\\n  }\\n  return initPromise;\\n}\\n\\nexport { RAPIER, FIXED_DT };\\n\\nexport const GROUND = 0x0001;\\nexport const RAGDOLL = 0x1000;\\n\\nexport function propBit(i) {\\n  return 0x0010 << i;\\n}\\n\\nexport function dollBit(i) {\\n  return 0x0100 << i;\\n}\\n\\nexport function group(member, filter) {\\n  return ((member & 0xffff) << 16) | (filter & 0xffff);\\n}\\n\\nexport function dollGroups(i) {\\n  return group(dollBit(i), propBit(i));\\n}\\n\\nexport function propGroups(i) {\\n  return group(propBit(i), dollBit(i) | propBit(i) | GROUND);\\n}\\n\\nexport function groundGroups() {\\n  return group(GROUND, 0x00f0 | RAGDOLL);\\n}\\n\\nexport function ragdollGroups() {\\n  return group(RAGDOLL, GROUND);\\n}\\n\\nexport function makeWorld(iterations = 8) {\\n  const world = new RAPIER.World({ x: 0, y: -9.81, z: 0 });\\n  world.timestep = FIXED_DT;\\n  world.integrationParameters.numSolverIterations = iterations;\\n  return world;\\n}\\n\\nexport function addGround(world, half = 30, friction = 0.9) {\\n  const body = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, -0.3, 0));\\n  world.createCollider(\\n    RAPIER.ColliderDesc.cuboid(half, 0.3, half).setFriction(friction).setCollisionGroups(groundGroups()),\\n    body,\\n  );\\n  return body;\\n}\\n\\n/** One standing doll: kinematic foot, dynamic capsule, ball joint at the sole. */\\nexport function createDollBody(world, lane, x, z) {\\n  const foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x, 0, z));\\n  const body = world.createRigidBody(\\n    RAPIER.RigidBodyDesc.dynamic()\\n      .setTranslation(x, 0.75, z)\\n      .setCanSleep(false)\\n      .setAdditionalSolverIterations(4),\\n  );\\n  world.createCollider(\\n    RAPIER.ColliderDesc.capsule(0.5, 0.25).setMass(1).setFriction(0.5).setCollisionGroups(dollGroups(lane)),\\n    body,\\n  );\\n  const joint = world.createImpulseJoint(\\n    RAPIER.JointData.spherical({ x: 0, y: 0, z: 0 }, { x: 0, y: -0.75, z: 0 }),\\n    foot,\\n    body,\\n    true,\\n  );\\n  joint.setContactsEnabled(false);\\n  return { foot, body, joint, lane, homeX: x, homeZ: z };\\n}\\n\\nexport function bodyCount(world) {\\n  return world.bodies.len();\\n}\\n\\nexport function freeWorld(world) {\\n  if (world && !world.freed) {\\n    world.free();\\n    world.freed = true;\\n  }\\n}\\n\\nexport function quatFromYaw(yaw) {\\n  const h = yaw * 0.5;\\n  return { x: 0, y: Math.sin(h), z: 0, w: Math.cos(h) };\\n}\\n\\nexport function rotateVec(q, v) {\\n  const { x: qx, y: qy, z: qz, w: qw } = q;\\n  const { x: vx, y: vy, z: vz } = v;\\n  const tx = 2 * (qy * vz - qz * vy);\\n  const ty = 2 * (qz * vx - qx * vz);\\n  const tz = 2 * (qx * vy - qy * vx);\\n  return {\\n    x: vx + qw * tx + (qy * tz - qz * ty),\\n    y: vy + qw * ty + (qz * tx - qx * tz),\\n    z: vz + qw * tz + (qx * ty - qy * tx),\\n  };\\n}\\n\\nexport function bodyPoint(body, local) {\\n  const t = body.translation();\\n  const q = body.rotation();\\n  const r = rotateVec(q, local);\\n  return { x: t.x + r.x, y: t.y + r.y, z: t.z + r.z };\\n}\\n\\nexport function finiteVec(v) {\\n  return v && Number.isFinite(v.x) && Number.isFinite(v.y) && Number.isFinite(v.z);\\n}\\n\",\"total_lines\":124}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"859d5451-0b34-4d7c-b55f-232015febeee"}
{"type":"assistant","message":{"id":"msg_223","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"tool_use","id":"call-0e49f498-5305-4d93-9caa-7d8186582084-15","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","offset":244,"limit":360}},{"type":"tool_use","id":"call-0e49f498-5305-4d93-9caa-7d8186582084-16","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","offset":520,"limit":280}},{"type":"tool_use","id":"call-0e49f498-5305-4d93-9caa-7d8186582084-17","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/data/programme.js","limit":120}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":6381,"output_tokens":303,"cache_read_input_tokens":56832,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"fa592cf4-7891-4308-93b6-12f5ecfdede6"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-0e49f498-5305-4d93-9caa-7d8186582084-15","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"244→  function nudge(choice, dir) {\\n    if (!choice) return;\\n    if (choice.kind === 'slider') {\\n      const def = TUNING_DEFS.find((d) => d.id === choice.id);\\n      if (def) setTune(choice.id, getTune(choice.id) + dir * def.step);\\n      return;\\n250→    }\\n    if (choice.id === 'music') settings.music = clampNum(settings.music + dir * 5, 0, 100);\\n    if (choice.id === 'sfx') settings.sfx = clampNum(settings.sfx + dir * 5, 0, 100);\\n    if (choice.id === 'voice') settings.voice = clampNum(settings.voice + dir * 5, 0, 100);\\n    if (choice.id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n    if (choice.id === 'difficulty') {\\n      const order = ['gentle', 'standard', 'honest'];\\n      const i = order.indexOf(settings.difficulty);\\n      settings.difficulty = order[(i + (dir > 0 ? 1 : 2)) % 3];\\n    }\\n260→    if (choice.id === 'name') profile.nameIndex = (profile.nameIndex + (dir > 0 ? 1 : NAMES.length - 1)) % NAMES.length;\\n    if (choice.id === 'paint') profile.paintIndex = (profile.paintIndex + (dir > 0 ? 1 : PAINTS.length - 1)) % PAINTS.length;\\n    if (choice.id === 'hat') profile.hatIndex = (profile.hatIndex + (dir > 0 ? 1 : HATS.length - 1)) % HATS.length;\\n    if (choice.id === 'page') page = Math.max(0, page + dir);\\n    applySettings();\\n  }\\n\\n  function activate(index) {\\n    const list = choicesOf();\\n    const choice = list[index];\\n270→    if (!choice || choice.kind === 'slider') return;\\n    focus = index;\\n    audio.unlock();\\n    audio.sfx('uiConfirm');\\n    const id = choice.id;\\n    if (screen === 'title') return setScreen(profile.stamps.length || profile.dayIndex > 0 ? 'menu' : 'who');\\n    if (screen === 'touch') return setScreen('settings');\\n    if (screen === 'who' && id === 'begin') {\\n      profile.name = NAMES[profile.nameIndex];\\n      profile.paint = PAINTS[profile.paintIndex].id;\\n280→      profile.hat = HATS[profile.hatIndex].id;\\n      return setScreen('tutorial');\\n    }\\n    if (screen === 'tutorial' && id === 'on') return beginDay();\\n    if (screen === 'menu') {\\n      if (id === 'programme') return profile.classDone.length ? setScreen('plan') : beginDay();\\n      if (id === 'group') { group = { seats: [null, null, null, null], points: [0, 0, 0, 0], playlist: [], cursor: 0 }; return setScreen('group'); }\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      if (id === 'journal') return setScreen('journal');\\n      if (id === 'settings') return setScreen('settings');\\n290→      if (id === 'about') return setScreen('about');\\n    }\\n    if (screen === 'question') return answerQuestion(id);\\n    if (screen === 'reply') { eventId = 'checkin'; beginCountdown(); return; }\\n    if (screen === 'age') return setScreen('plan');\\n    if (screen === 'plan' && eventById(id)) return openIntro(id);\\n    if (screen === 'intro') return beginCountdown();\\n    if (screen === 'results') {\\n      if (id === 'retry') return openIntro(eventId);\\n      return afterResult();\\n300→    }\\n    if (screen === 'jar') return afterJar();\\n    if (screen === 'bed') {\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      return sleepDay();\\n    }\\n    if (screen === 'ending') return setScreen(pageOfEnding());\\n    if (screen === 'credits') { sleepDay(); return setScreen('menu'); }\\n    if (screen === 'pause') return pauseAction(id);\\n    if (screen === 'settings') return settingsAction(id);\\n310→    if (screen === 'dev') return devAction(id);\\n    if (screen === 'free' && eventById(id)) return openIntro(id);\\n    if (screen === 'group') {\\n      if (group && !group.seats.some(Boolean)) group.seats[0] = { name: profile.name, device: 'key' };\\n      return groupAction(id);\\n    }\\n    if (screen === 'confirm-reset' && id === 'yes') { resetAll(); return setScreen('title'); }\\n    if (screen === 'confirm-reset') return setScreen('settings');\\n    if (screen === 'island') {\\n      if (id === 'plan') return setScreen('plan');\\n320→      if (id === 'bed') return setScreen('bed');\\n      if (id === 'menu') return setScreen('menu');\\n    }\\n    paint();\\n  }\\n\\n  function pageOfEnding() {\\n    if (screen === 'ending') return 'credits';\\n    return 'credits';\\n  }\\n330→\\n  function beginDay() {\\n    freePick = false;\\n    profile.classDone = [];\\n    talk('trudy', 'morning');\\n    setScreen('morning');\\n  }\\n\\n  function answerQuestion(id) {\\n    const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\\n340→    const key = id === 'yes' ? q.yes : id === 'no' ? q.no : id === 'left' ? q.left : q.right;\\n    const line = lookup(key);\\n    speech = { who: 'Trudy', text: line ? line.text : 'Noted.', id: key };\\n    speechLeft = 1.2;\\n    if (line) audio.say(line.text, 'trudy');\\n    setScreen('reply');\\n  }\\n\\n  function openIntro(id) {\\n    eventId = id;\\n350→    tier = tierFor(id);\\n    setScreen('intro');\\n  }\\n\\n  function beginCountdown() {\\n    const plan = today();\\n    startEvent(eventId, {\\n      tests: eventId === 'checkin' ? plan.tests : undefined,\\n      god: screen === 'attract',\\n    });\\n360→    if (eventId === 'checkin') {\\n      screen = 'checkinPlay';\\n      return;\\n    }\\n    countLeft = 3;\\n    setScreen('countdown');\\n  }\\n\\n  function afterResult() {\\n    if (eventId === 'checkin') return;\\n370→    profile.marbles += jarPay;\\n    jarLeft = 2;\\n    audio.sfx('marble');\\n    setScreen('jar');\\n  }\\n\\n  function afterJar() {\\n    if (profile.levelled && eventId === 'grandHold') {\\n      sayExact(\\\"Oh. So that's what the middle looks like.\\\");\\n      return setScreen('ending');\\n380→    }\\n    const plan = today();\\n    const pendingClass = plan.classes.filter((id) => !profile.classDone.includes(id));\\n    if (group && group.playlist) return scoreGroup();\\n    if (pendingClass.length && !freePick) return setScreen('plan');\\n    if (freePick) return setScreen('free');\\n    return setScreen('bed');\\n  }\\n\\n  function sleepDay() {\\n390→    const plan = today();\\n    profile.stamps.push({ day: profile.dayIndex + 1, name: plan.name });\\n    profile.dayIndex += 1;\\n    profile.classDone = [];\\n    paletteHold = null;\\n    persist();\\n    beginDay();\\n  }\\n\\n  function scoreGroup() {\\n400→    if (!group) return setScreen('menu');\\n    const forms = lastResult && lastResult.forms ? lastResult.forms : group.seats.map((s, i) => (s ? (i === 0 ? lastResult.form : 0) : -1));\\n    const ranked = forms.map((form, i) => ({ i, form })).filter((row) => row.form >= 0).sort((a, b) => b.form - a.form);\\n    const points = [4, 3, 2, 1];\\n    ranked.forEach((row, place) => { group.points[row.i] += points[place] || 1; });\\n    group.cursor += 1;\\n    if (group.cursor >= group.playlist.length) return setScreen('podium');\\n    openIntro(group.playlist[group.cursor]);\\n  }\\n\\n410→  function back() {\\n    if (screen === 'settings' || screen === 'about' || screen === 'journal' || screen === 'free' || screen === 'group' || screen === 'mirror') return setScreen('menu');\\n    if (screen === 'dev') return setScreen('pause');\\n    if (screen === 'pause') { paused = false; return setScreen('play'); }\\n    if (screen === 'plan' || screen === 'island') return setScreen('menu');\\n    if (screen === 'who') return setScreen('title');\\n  }\\n\\n  function pauseAction(id) {\\n    if (id === 'resume') { paused = false; return setScreen('play'); }\\n420→    if (id === 'restart') { openIntro(eventId); return; }\\n    if (id === 'howto') return setScreen('howto');\\n    if (id === 'settings') return setScreen('settings');\\n    if (id === 'dev') { devFromPause = true; return setScreen('dev'); }\\n    if (id === 'leave') {\\n      if (event) event.dispose();\\n      event = null;\\n      return setScreen('island');\\n    }\\n  }\\n430→\\n  function settingsAction(id) {\\n    if (id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n    if (id === 'rumble') settings.rumble = !settings.rumble;\\n    if (id === 'breathe') settings.autoBreathe = !settings.autoBreathe;\\n    if (id === 'shake') settings.reduceShake = !settings.reduceShake;\\n    if (id === 'full') {\\n      const el = doc && doc.documentElement;\\n      if (el && el.requestFullscreen) el.requestFullscreen().catch(() => {});\\n    }\\n440→    if (id === 'reset') return setScreen('confirm-reset');\\n    if (id === 'next') page = (page + 1) % 4;\\n    if (id === 'prev') page = (page + 3) % 4;\\n    applySettings();\\n    paint();\\n  }\\n\\n  function devAction(id) {\\n    if (!devFromPause && screen !== 'dev') return;\\n    if (id === 'reset-tune') resetTuning();\\n450→    if (id === 'god') god = !god;\\n    if (id === 'faster') timeScale = Math.min(4, timeScale * 2);\\n    if (id === 'slower') timeScale = Math.max(0.1, timeScale / 2);\\n    if (id === 'step' && event) event.fixed(FIXED_DT, [inputs[0].snapshot(0)]);\\n    if (id === 'fall' && event && event.beginFall) event.beginFall(0);\\n    if (id === 'results') { finishEvent(); return setScreen('results'); }\\n    if (id === 'ending') {\\n      profile.doneSteps = programme.slice();\\n      profile.levelled = true;\\n      profile.met = eventIds();\\n460→      sayExact(\\\"Oh. So that's what the middle looks like.\\\");\\n      return setScreen('ending');\\n    }\\n    if (id === 'marbles') profile.marbles += 10;\\n    if (id === 'unlock') profile.met = eventIds();\\n    if (id === 'age') profile.ages.push(41);\\n    if (id === 'bot') botSkill = botSkill ? null : 'sharp';\\n    if (id === 'copy') copyText = JSON.stringify(tuningSnapshot());\\n    if (id === 'wipe') return setScreen('confirm-reset');\\n    if (id === 'palette') {\\n470→      const i = PALETTE_ORDER.indexOf(paletteNow());\\n      paletteHold = PALETTE_ORDER[(i + 1) % PALETTE_ORDER.length];\\n    }\\n    if (id === 'ink') inkOn = !inkOn;\\n    if (id === 'camera') freeCam = !freeCam;\\n    if (id === 'debug') debugPhysics = !debugPhysics;\\n    if (id === 'gust' && event && event.states) {\\n      event.states[0].gustLeft = 0.5;\\n      event.states[0].gustN = 3.5;\\n    }\\n480→    if (id === 'next') page = (page + 1) % devPageCount();\\n    if (id === 'prev') page = (page + devPageCount() - 1) % devPageCount();\\n    if (id.startsWith('jump-')) {\\n      devFromPause = true;\\n      return openIntro(id.slice(5));\\n    }\\n    paint();\\n  }\\n\\n  function groupAction(id) {\\n490→    if (id === 'quick' || id === 'raft' || eventById(id)) {\\n      const couch = eventIds().filter((eid) => eventById(eid).couch);\\n      const playlist = id === 'quick' ? pickSome(couch, 3) : [id === 'raft' ? 'raft' : id];\\n      group.playlist = playlist;\\n      group.cursor = 0;\\n      const lanes = group.seats.map((seat, i) => seat ? ({\\n        id: i, kind: 'local', name: seat.name, colour: SEAT_COLOURS[i],\\n      }) : null).filter(Boolean);\\n      if (!lanes.length) lanes.push({ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] });\\n      group.lanes = lanes;\\n500→      return openIntro(playlist[0]);\\n    }\\n    if (id === 'back') return setScreen('menu');\\n  }\\n\\n  function pickSome(list, n) {\\n    const pool = list.slice();\\n    const out = [];\\n    while (out.length < n && pool.length) out.push(pool.splice(Math.floor(rng('group') * pool.length), 1)[0]);\\n    return out;\\n510→  }\\n\\n  function resetAll() {\\n    const next = freshProfile();\\n    Object.keys(profile).forEach((k) => delete profile[k]);\\n    Object.assign(profile, next);\\n    Object.assign(settings, defaultSettings());\\n    resetTuning();\\n    try { storage.removeItem(SAVE_KEY); } catch { /* memory store */ }\\n  }\\n520→\\n  function sayExact(text) {\\n    speech = { who: 'Trudy', text, id: 'exact' };\\n    speechLeft = Math.max(1, text.length / 16);\\n    audio.say(text, 'trudy');\\n  }\\n\\n  function lookup(id) {\\n    return lineById(id);\\n  }\\n530→\\n  function driveBots(dt) {\\n    if (!event || !botSkill) return null;\\n    const skill = skillOf(botSkill);\\n    const snaps = [];\\n    const count = event.lanes.length;\\n    for (let i = 0; i < count; i++) {\\n      const cmd = event.botInput(i, skill, botOpt) || {};\\n      const pad = padAt(i);\\n      clearPad(pad);\\n540→      writeWish(pad, cmd.x || 0, cmd.y || 0);\\n      writeButton(pad, 0, !!cmd.hop);\\n      writeButton(pad, 2, !!cmd.flail);\\n      writeButton(pad, 5, !!(cmd.breathe || (settings.autoBreathe && screen === 'play')));\\n      writeButton(pad, 6, (cmd.feetL || 0) > 0, cmd.feetL || 0);\\n      writeButton(pad, 7, (cmd.feetR || 0) > 0, cmd.feetR || 0);\\n      const input = inputs[i];\\n      if (cmd.plateA) input.keyDown('KeyA');\\n      if (cmd.plateD) input.keyDown('KeyD');\\n      input.poll(dt, 'balance');\\n550→      if (cmd.plateA) input.keyUp('KeyA');\\n      if (cmd.plateD) input.keyUp('KeyD');\\n      snaps.push(input.snapshot(0));\\n    }\\n    return snaps;\\n  }\\n\\n  function padAt(i) {\\n    const list = padSource() || pads;\\n    return list[i] || pads[i];\\n560→  }\\n\\n  function fixed(dt) {\\n    if (locked) return;\\n    audio.setTilt(tiltRad());\\n    if (session) return sessionFixed(dt);\\n    const input = inputs[0];\\n    const playing = screen === 'play' || screen === 'checkinPlay';\\n    if (attract) {\\n      const sample = input.poll(dt, 'menu');\\n570→      const travel = input.takeTravel();\\n      if (woke(sample, travel)) { stopAttract(true); return; }\\n      stepAttract(dt);\\n      return;\\n    }\\n    if (playing && botSkill) {\\n      const snaps = driveBots(dt);\\n      if (!paused && event) stepEvent(dt, snaps);\\n      noteNotch();\\n      if (event && event.done) {\\n580→        finishEvent();\\n        if (eventId === 'checkin') revealAge();\\n        else setScreen('results');\\n      }\\n      return;\\n    }\\n    const sample = input.poll(dt, playing ? 'balance' : 'menu');\\n    const travel = input.takeTravel();\\n    if (screen === 'title' || screen === 'menu' || screen === 'touch') {\\n      if (woke(sample, travel)) idle = 0;\\n590→      else if (!holdAttract) idle += dt;\\n      if (idle >= 10 && !session) { startAttract(); return; }\\n    } else idle = 0;\\n    if (sample.edges.pause && (screen === 'play' || screen === 'checkinPlay') && !sample.createHeld) {\\n      paused = true;\\n      return setScreen('pause');\\n    }\\n    if (screen === 'group' && joinPads(sample)) return;\\n    if ((screen === 'play' || screen === 'checkinPlay') && !paused) {\\n      const snaps = snapsFor(dt, sample);\\n600→      stepEvent(dt, snaps);\\n      noteNotch();\\n      if (event && event.done) {\\n        finishEvent();\",\"content_concise\":\"244→  function nudge(choice, dir) {\\n    if (!choice) return;\\n    if (choice.kind === 'slider') {\\n      const def = TUNING_DEFS.find((d) => d.id === choice.id);\\n      if (def) setTune(choice.id, getTune(choice.id) + dir * def.step);\\n      return;\\n250→    }\\n    if (choice.id === 'music') settings.music = clampNum(settings.music + dir * 5, 0, 100);\\n    if (choice.id === 'sfx') settings.sfx = clampNum(settings.sfx + dir * 5, 0, 100);\\n    if (choice.id === 'voice') settings.voice = clampNum(settings.voice + dir * 5, 0, 100);\\n    if (choice.id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n    if (choice.id === 'difficulty') {\\n      const order = ['gentle', 'standard', 'honest'];\\n      const i = order.indexOf(settings.difficulty);\\n      settings.difficulty = order[(i + (dir > 0 ? 1 : 2)) % 3];\\n    }\\n260→    if (choice.id === 'name') profile.nameIndex = (profile.nameIndex + (dir > 0 ? 1 : NAMES.length - 1)) % NAMES.length;\\n    if (choice.id === 'paint') profile.paintIndex = (profile.paintIndex + (dir > 0 ? 1 : PAINTS.length - 1)) % PAINTS.length;\\n    if (choice.id === 'hat') profile.hatIndex = (profile.hatIndex + (dir > 0 ? 1 : HATS.length - 1)) % HATS.length;\\n    if (choice.id === 'page') page = Math.max(0, page + dir);\\n    applySettings();\\n  }\\n\\n  function activate(index) {\\n    const list = choicesOf();\\n    const choice = list[index];\\n270→    if (!choice || choice.kind === 'slider') return;\\n    focus = index;\\n    audio.unlock();\\n    audio.sfx('uiConfirm');\\n    const id = choice.id;\\n    if (screen === 'title') return setScreen(profile.stamps.length || profile.dayIndex > 0 ? 'menu' : 'who');\\n    if (screen === 'touch') return setScreen('settings');\\n    if (screen === 'who' && id === 'begin') {\\n      profile.name = NAMES[profile.nameIndex];\\n      profile.paint = PAINTS[profile.paintIndex].id;\\n280→      profile.hat = HATS[profile.hatIndex].id;\\n      return setScreen('tutorial');\\n    }\\n    if (screen === 'tutorial' && id === 'on') return beginDay();\\n    if (screen === 'menu') {\\n      if (id === 'programme') return profile.classDone.length ? setScreen('plan') : beginDay();\\n      if (id === 'group') { group = { seats: [null, null, null, null], points: [0, 0, 0, 0], playlist: [], cursor: 0 }; return setScreen('group'); }\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      if (id === 'journal') return setScreen('journal');\\n      if (id === 'settings') return setScreen('settings');\\n290→      if (id === 'about') return setScreen('about');\\n    }\\n    if (screen === 'question') return answerQuestion(id);\\n    if (screen === 'reply') { eventId = 'checkin'; beginCountdown(); return; }\\n    if (screen === 'age') return setScreen('plan');\\n    if (screen === 'plan' && eventById(id)) return openIntro(id);\\n    if (screen === 'intro') return beginCountdown();\\n    if (screen === 'results') {\\n      if (id === 'retry') return openIntro(eventId);\\n      return afterResult();\\n300→    }\\n    if (screen === 'jar') return afterJar();\\n    if (screen === 'bed') {\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      return sleepDay();\\n    }\\n    if (screen === 'ending') return setScreen(pageOfEnding());\\n    if (screen === 'credits') { sleepDay(); return setScreen('menu'); }\\n    if (screen === 'pause') return pauseAction(id);\\n    if (screen === 'settings') return settingsAction(id);\\n310→    if (screen === 'dev') return devAction(id);\\n    if (screen === 'free' && eventById(id)) return openIntro(id);\\n    if (screen === 'group') {\\n      if (group && !group.seats.some(Boolean)) group.seats[0] = { name: profile.name, device: 'key' };\\n      return groupAction(id);\\n    }\\n    if (screen === 'confirm-reset' && id === 'yes') { resetAll(); return setScreen('title'); }\\n    if (screen === 'confirm-reset') return setScreen('settings');\\n    if (screen === 'island') {\\n      if (id === 'plan') return setScreen('plan');\\n320→      if (id === 'bed') return setScreen('bed');\\n      if (id === 'menu') return setScreen('menu');\\n    }\\n    paint();\\n  }\\n\\n  function pageOfEnding() {\\n    if (screen === 'ending') return 'credits';\\n    return 'credits';\\n  }\\n330→\\n  function beginDay() {\\n    freePick = false;\\n    profile.classDone = [];\\n    talk('trudy', 'morning');\\n    setScreen('morning');\\n  }\\n\\n  function answerQuestion(id) {\\n    const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\\n340→    const key = id === 'yes' ? q.yes : id === 'no' ? q.no : id === 'left' ? q.left : q.right;\\n    const line = lookup(key);\\n    speech = { who: 'Trudy', text: line ? line.text : 'Noted.', id: key };\\n    speechLeft = 1.2;\\n    if (line) audio.say(line.text, 'trudy');\\n    setScreen('reply');\\n  }\\n\\n  function openIntro(id) {\\n    eventId = id;\\n350→    tier = tierFor(id);\\n    setScreen('intro');\\n  }\\n\\n  function beginCountdown() {\\n    const plan = today();\\n    startEvent(eventId, {\\n      tests: eventId === 'checkin' ? plan.tests : undefined,\\n      god: screen === 'attract',\\n    });\\n360→    if (eventId === 'checkin') {\\n      screen = 'checkinPlay';\\n      return;\\n    }\\n    countLeft = 3;\\n    setScreen('countdown');\\n  }\\n\\n  function afterResult() {\\n    if (eventId === 'checkin') return;\\n370→    profile.marbles += jarPay;\\n    jarLeft = 2;\\n    audio.sfx('marble');\\n    setScreen('jar');\\n  }\\n\\n  function afterJar() {\\n    if (profile.levelled && eventId === 'grandHold') {\\n      sayExact(\\\"Oh. So that's what the middle looks like.\\\");\\n      return setScreen('ending');\\n380→    }\\n    const plan = today();\\n    const pendingClass = plan.classes.filter((id) => !profile.classDone.includes(id));\\n    if (group && group.playlist) return scoreGroup();\\n    if (pendingClass.length && !freePick) return setScreen('plan');\\n    if (freePick) return setScreen('free');\\n    return setScreen('bed');\\n  }\\n\\n  function sleepDay() {\\n390→    const plan = today();\\n    profile.stamps.push({ day: profile.dayIndex + 1, name: plan.name });\\n    profile.dayIndex += 1;\\n    profile.classDone = [];\\n    paletteHold = null;\\n    persist();\\n    beginDay();\\n  }\\n\\n  function scoreGroup() {\\n400→    if (!group) return setScreen('menu');\\n    const forms = lastResult && lastResult.forms ? lastResult.forms : group.seats.map((s, i) => (s ? (i === 0 ? lastResult.form : 0) : -1));\\n    const ranked = forms.map((form, i) => ({ i, form })).filter((row) => row.form >= 0).sort((a, b) => b.form - a.form);\\n    const points = [4, 3, 2, 1];\\n    ranked.forEach((row, place) => { group.points[row.i] += points[place] || 1; });\\n    group.cursor += 1;\\n    if (group.cursor >= group.playlist.length) return setScreen('podium');\\n    openIntro(group.playlist[group.cursor]);\\n  }\\n\\n410→  function back() {\\n    if (screen === '