ntent\":\"    ready.add(cell.key);\"},{\"line_number\":297,\"content\":\"    ready.delete(cell.key);\"},{\"line_number\":302,\"content\":\"  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\"},{\"line_number\":340,\"content\":\"    else if (p.ready) bits.push('ready');\"},{\"line_number\":343,\"content\":\"    const last = cell.progress.at(-1);\"},{\"line_number\":344,\"content\":\"    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\"},{\"line_number\":406,\"content\":\"  const check = (name, pass, detail = '') => {\"},{\"line_number\":407,\"content\":\"    checks.push({ name, pass: !!pass, detail });\"},{\"line_number\":409,\"content\":\"    return !!pass;\"},{\"line_number\":411,\"content\":\"  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\"},{\"line_number\":416,\"content\":\"      check('game named', false, 'pass ?game=<path> of a page on this site');\"},{\"line_number\":440,\"content\":\"    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\"},{\"line_number\":441,\"content\":\"    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\"},{\"line_number\":442,\"content\":\"    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\"},{\"line_number\":448,\"content\":\"      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\"},{\"line_number\":449,\"content\":\"      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\"},{\"line_number\":453,\"content\":\"    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\"},{\"line_number\":468,\"content\":\"    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\"},{\"line_number\":469,\"content\":\"    // still tagged race was built to race's contract: no seeded start, and no progress asked.\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"b1308dc1-19be-4efa-9b44-d8f1c0bada5a"}
