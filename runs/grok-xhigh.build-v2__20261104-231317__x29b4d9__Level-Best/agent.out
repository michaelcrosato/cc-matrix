build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/stepClass.js\",\"matches\":[{\"line_number\":29,\"content\":\"    const key = opts.session ? 'session' : this.tier;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/stillWater.js\",\"matches\":[{\"line_number\":32,\"content\":\"    this.duration = opts.session ? 50 : 60;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/fruitHat.js\",\"matches\":[{\"line_number\":40,\"content\":\"    if (opts.session) this.duration = 50;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"3b87cf51-8b93-4d62-84f2-03a182dd9acd"}
{"type":"assistant","message":{"id":"msg_133","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Poses, cairn, logReps, and springboard may not shorten to 50 seconds.\n\nThe harness finishes before the 50-second cutoff. If an event exceeds that limit, it will be forced to end and call result(). A lower score is acceptable for this hub test.\n\nThe director will stay under 900 lines. Styles, render files, main entry, build script, and tests are next. about.js will contain real interview content so the game works before the build regenerates it.","signature":""},{"type":"text","text":"The dialogue catalogue is in place. Next I’ll add the menu flow, audio mix, and the screen that drives every event."},{"type":"tool_use","id":"call-53856429-2807-4902-b2da-b98a10cbb61d-105","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/styles.js","content":"export const CSS = `\n:root { color: #1A1420; font-family: Fredoka, \"Trebuchet MS\", sans-serif; }\nhtml, body { margin: 0; height: 100%; background: #8FB4E0; overflow: hidden; }\ncanvas, .bg { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }\n#boot-line { position: fixed; inset: 5%; z-index: 3; font-size: 48px; }\n#ui { position: fixed; inset: 5%; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; font-size: 36px; line-height: 1.25; }\n#ui button, #ui input, #ui .hit { pointer-events: auto; font: inherit; font-size: 36px; color: #1A1420; }\nh1, h2, p, li, button, label, span, input { font-size: 36px; }\nh1 { font-size: 84px; margin: 0; line-height: 1; }\nh2 { font-size: 54px; margin: 0 0 8px; }\nbutton, .choice {\n  display: block; width: 100%; text-align: left; margin: 8px 0; padding: 10px 18px;\n  background: #fff6e4; border: 4px solid #1A1420; border-radius: 14px;\n  transform: rotate(-0.4deg); box-shadow: 4px 4px 0 #1A1420;\n}\nbutton.is-focus, button:focus-visible {\n  outline: 6px solid #F5B700; outline-offset: 4px; transform: rotate(0.6deg) scale(1.02);\n}\n.row { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }\n.tag { background: #fff6e4; border: 3px solid #1A1420; border-radius: 12px; padding: 8px 14px; display: inline-block; }\n.speech { background: #fffdf6; border: 4px solid #1A1420; border-radius: 16px; padding: 16px 20px; max-width: 70%; }\n.hud { display: flex; justify-content: space-between; align-items: flex-start; }\n.score { font-size: 64px; }\n.time { font-size: 42px; }\n.disc { width: 140px; height: 140px; border: 4px solid #1A1420; border-radius: 50%; background: #efe7da; position: relative; }\n.dot { width: 22px; height: 22px; border-radius: 50%; background: #E8443A; position: absolute; left: 50%; top: 50%; }\n.prompts { display: flex; gap: 18px; align-items: center; }\n.prompts svg { width: 36px; height: 36px; }\ninput[type=\"range\"] { width: 100%; height: 36px; accent-color: #E8443A; }\n.pages { font-size: 30px; }\n.hidden { display: none; }\n.card-name { font-size: 36px; margin: 4px 0; }\n`;\n"}},{"type":"tool_use","id":"call-53856429-2807-4902-b2da-b98a10cbb61d-106","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/ui.js","content":"import { CSS } from './styles.js';\nimport { glyphSvg } from '../input/glyphs.js';\n\nexport function mountUi(doc, handlers) {\n  if (!doc.getElementById('level-best-css')) {\n    const style = doc.createElement('style');\n    style.id = 'level-best-css';\n    style.textContent = CSS;\n    doc.head.appendChild(style);\n  }\n  let root = doc.getElementById('ui');\n  if (!root) {\n    root = doc.createElement('div');\n    root.id = 'ui';\n    doc.body.appendChild(root);\n  }\n  const paint = (model) => {\n    doc.body.dataset.screen = model.screen || '';\n    doc.body.dataset.attract = model.attract ? 'true' : 'false';\n    root.replaceChildren();\n    const top = doc.createElement('div');\n    top.className = 'hud';\n    const title = doc.createElement('div');\n    if (model.screen === 'title' || model.screen === 'touch' || model.attract) {\n      const h = doc.createElement('h1');\n      h.textContent = model.gameTitle || 'Level Best';\n      title.appendChild(h);\n    } else if (model.heading) {\n      const h = doc.createElement('h2');\n      h.textContent = model.heading;\n      title.appendChild(h);\n    }\n    for (const line of model.lines || []) {\n      const p = doc.createElement('p');\n      p.textContent = line;\n      title.appendChild(p);\n    }\n    top.appendChild(title);\n    if (model.hud) {\n      const side = doc.createElement('div');\n      const time = doc.createElement('div');\n      time.className = 'time';\n      time.textContent = model.hud.time;\n      const score = doc.createElement('div');\n      score.className = 'score';\n      score.textContent = model.hud.score;\n      side.append(time, score);\n      top.appendChild(side);\n    }\n    root.appendChild(top);\n\n    if (model.speech) {\n      const bubble = doc.createElement('div');\n      bubble.className = 'speech';\n      const who = doc.createElement('p');\n      who.textContent = model.speech.who;\n      const said = doc.createElement('p');\n      said.textContent = model.speech.text;\n      bubble.append(who, said);\n      root.appendChild(bubble);\n    }\n\n    const mid = doc.createElement('div');\n    for (const choice of model.choices || []) {\n      if (choice.kind === 'slider') {\n        const label = doc.createElement('label');\n        label.className = 'choice';\n        label.textContent = `${choice.label}: ${choice.value}`;\n        const input = doc.createElement('input');\n        input.type = 'range';\n        input.min = String(choice.min);\n        input.max = String(choice.max);\n        input.step = String(choice.step);\n        input.value = String(choice.value);\n        input.dataset.choice = choice.id;\n        input.tabIndex = 0;\n        if (choice.focus) input.classList.add('is-focus');\n        input.addEventListener('input', () => handlers.slide(choice.id, Number(input.value)));\n        input.addEventListener('pointerdown', () => handlers.hover(choice.index));\n        label.appendChild(input);\n        mid.appendChild(label);\n      } else {\n        const button = doc.createElement('button');\n        button.type = 'button';\n        button.dataset.choice = choice.id;\n        button.textContent = choice.label;\n        button.tabIndex = 0;\n        if (choice.focus) {\n          button.classList.add('is-focus');\n          button.autofocus = true;\n        }\n        button.addEventListener('click', () => handlers.activate(choice.index));\n        button.addEventListener('pointermove', () => handlers.hover(choice.index));\n        mid.appendChild(button);\n      }\n    }\n    if (model.page) {\n      const pager = doc.createElement('p');\n      pager.className = 'pages';\n      pager.dataset.pager = 'page';\n      pager.textContent = model.page;\n      mid.appendChild(pager);\n    }\n    root.appendChild(mid);\n\n    const bottom = doc.createElement('div');\n    bottom.className = 'row';\n    if (model.disc) {\n      const disc = doc.createElement('div');\n      disc.className = 'disc';\n      disc.dataset.disc = '1';\n      const dot = doc.createElement('div');\n      dot.className = 'dot';\n      const x = 50 + model.disc.x * 40;\n      const y = 50 - model.disc.y * 40;\n      dot.style.left = `${x}%`;\n      dot.style.top = `${y}%`;\n      disc.appendChild(dot);\n      bottom.appendChild(disc);\n    }\n    const prompts = doc.createElement('div');\n    prompts.className = 'prompts';\n    for (const prompt of model.prompts || []) {\n      const wrap = doc.createElement('span');\n      wrap.className = 'tag';\n      wrap.innerHTML = glyphSvg(prompt.glyph);\n      const name = doc.createElement('span');\n      name.textContent = ` ${prompt.verb}`;\n      wrap.appendChild(name);\n      prompts.appendChild(wrap);\n    }\n    bottom.appendChild(prompts);\n    root.appendChild(bottom);\n    const focused = root.querySelector('.is-focus');\n    if (focused && focused.focus) focused.focus({ preventScroll: true });\n  };\n  return { paint };\n}\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3495,"output_tokens":3239,"cache_read_input_tokens":183168,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"20699a2e-77ff-46b4-8ee2-5e9c7fc3f9c0"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-53856429-2807-4902-b2da-b98a10cbb61d-105","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"export const CSS = `\\n:root { color: #1A1420; font-family: Fredoka, \\\"Trebuchet MS\\\", sans-serif; }\\nhtml, body { margin: 0; height: 100%; background: #8FB4E0; overflow: hidden; }\\ncanvas, .bg { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }\\n#boot-line { position: fixed; inset: 5%; z-index: 3; font-size: 48px; }\\n#ui { position: fixed; inset: 5%; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; font-size: 36px; line-height: 1.25; }\\n#ui button, #ui input, #ui .hit { pointer-events: auto; font: inherit; font-size: 36px; color: #1A1420; }\\nh1, h2, p, li, button, label, span, input { font-size: 36px; }\\nh1 { font-size: 84px; margin: 0; line-height: 1; }\\nh2 { font-size: 54px; margin: 0 0 8px; }\\nbutton, .choice {\\n  display: block; width: 100%; text-align: left; margin: 8px 0; padding: 10px 18px;\\n  background: #fff6e4; border: 4px solid #1A1420; border-radius: 14px;\\n  transform: rotate(-0.4deg); box-shadow: 4px 4px 0 #1A1420;\\n}\\nbutton.is-focus, button:focus-visible {\\n  outline: 6px solid #F5B700; outline-offset: 4px; transform: rotate(0.6deg) scale(1.02);\\n}\\n.row { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }\\n.tag { background: #fff6e4; border: 3px solid #1A1420; border-radius: 12px; padding: 8px 14px; display: inline-block; }\\n.speech { background: #fffdf6; border: 4px solid #1A1420; border-radius: 16px; padding: 16px 20px; max-width: 70%; }\\n.hud { display: flex; justify-content: space-between; align-items: flex-start; }\\n.score { font-size: 64px; }\\n.time { font-size: 42px; }\\n.disc { width: 140px; height: 140px; border: 4px solid #1A1420; border-radius: 50%; background: #efe7da; position: relative; }\\n.dot { width: 22px; height: 22px; border-radius: 50%; background: #E8443A; position: absolute; left: 50%; top: 50%; }\\n.prompts { display: flex; gap: 18px; align-items: center; }\\n.prompts svg { width: 36px; height: 36px; }\\ninput[type=\\\"range\\\"] { width: 100%; height: 36px; accent-color: #E8443A; }\\n.pages { font-size: 30px; }\\n.hidden { display: none; }\\n.card-name { font-size: 36px; margin: 4px 0; }\\n`;\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/styles.js has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/styles.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/styles.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"export const CSS = `\\n:root { color: #1A1420; font-family: Fredoka, \\\"Trebuchet MS\\\", sans-serif; }\\nhtml, body { margin: 0; height: 100%; background: #8FB4E0; overflow: hidden; }\\ncanvas, .bg { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }\\n#boot-line { position: fixed; inset: 5%; z-index: 3; font-size: 48px; }\\n#ui { position: fixed; inset: 5%; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; font-size: 36px; line-height: 1.25; }\\n#ui button, #ui input, #ui .hit { pointer-events: auto; font: inherit; font-size: 36px; color: #1A1420; }\\nh1, h2, p, li, button, label, span, input { font-size: 36px; }\\nh1 { font-size: 84px; margin: 0; line-height: 1; }\\nh2 { font-size: 54px; margin: 0 0 8px; }\\nbutton, .choice {\\n  display: block; width: 100%; text-align: left; margin: 8px 0; padding: 10px 18px;\\n  background: #fff6e4; border: 4px solid #1A1420; border-radius: 14px;\\n  transform: rotate(-0.4deg); box-shadow: 4px 4px 0 #1A1420;\\n}\\nbutton.is-focus, button:focus-visible {\\n  outline: 6px solid #F5B700; outline-offset: 4px; transform: rotate(0.6deg) scale(1.02);\\n}\\n.row { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }\\n.tag { background: #fff6e4; border: 3px solid #1A1420; border-radius: 12px; padding: 8px 14px; display: inline-block; }\\n.speech { background: #fffdf6; border: 4px solid #1A1420; border-radius: 16px; padding: 16px 20px; max-width: 70%; }\\n.hud { display: flex; justify-content: space-between; align-items: flex-start; }\\n.score { font-size: 64px; }\\n.time { font-size: 42px; }\\n.disc { width: 140px; height: 140px; border: 4px solid #1A1420; border-radius: 50%; background: #efe7da; position: relative; }\\n.dot { width: 22px; height: 22px; border-radius: 50%; background: #E8443A; position: absolute; left: 50%; top: 50%; }\\n.prompts { display: flex; gap: 18px; align-items: center; }\\n.prompts svg { width: 36px; height: 36px; }\\ninput[type=\\\"range\\\"] { width: 100%; height: 36px; accent-color: #E8443A; }\\n.pages { font-size: 30px; }\\n.hidden { display: none; }\\n.card-name { font-size: 36px; margin: 4px 0; }\\n`;\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-53856429-2807-4902-b2da-b98a10cbb61d-106","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"import { CSS } from './styles.js';\\nimport { glyphSvg } from '../input/glyphs.js';\\n\\nexport function mountUi(doc, handlers) {\\n  if (!doc.getElementById('level-best-css')) {\\n    const style = doc.createElement('style');\\n    style.id = 'level-best-css';\\n    style.textContent = CSS;\\n    doc.head.appendChild(style);\\n  }\\n  let root = doc.getElementById('ui');\\n  if (!root) {\\n    root = doc.createElement('div');\\n    root.id = 'ui';\\n    doc.body.appendChild(root);\\n  }\\n  const paint = (model) => {\\n    doc.body.dataset.screen = model.screen || '';\\n    doc.body.dataset.attract = model.attract ? 'true' : 'false';\\n    root.replaceChildren();\\n    const top = doc.createElement('div');\\n    top.className = 'hud';\\n    const title = doc.createElement('div');\\n    if (model.screen === 'title' || model.screen === 'touch' || model.attract) {\\n      const h = doc.createElement('h1');\\n      h.textContent = model.gameTitle || 'Level Best';\\n      title.appendChild(h);\\n    } else if (model.heading) {\\n      const h = doc.createElement('h2');\\n      h.textContent = model.heading;\\n      title.appendChild(h);\\n    }\\n    for (const line of model.lines || []) {\\n      const p = doc.createElement('p');\\n      p.textContent = line;\\n      title.appendChild(p);\\n    }\\n    top.appendChild(title);\\n    if (model.hud) {\\n      const side = doc.createElement('div');\\n      const time = doc.createElement('div');\\n      time.className = 'time';\\n      time.textContent = model.hud.time;\\n      const score = doc.createElement('div');\\n      score.className = 'score';\\n      score.textContent = model.hud.score;\\n      side.append(time, score);\\n      top.appendChild(side);\\n    }\\n    root.appendChild(top);\\n\\n    if (model.speech) {\\n      const bubble = doc.createElement('div');\\n      bubble.className = 'speech';\\n      const who = doc.createElement('p');\\n      who.textContent = model.speech.who;\\n      const said = doc.createElement('p');\\n      said.textContent = model.speech.text;\\n      bubble.append(who, said);\\n      root.appendChild(bubble);\\n    }\\n\\n    const mid = doc.createElement('div');\\n    for (const choice of model.choices || []) {\\n      if (choice.kind === 'slider') {\\n        const label = doc.createElement('label');\\n        label.className = 'choice';\\n        label.textContent = `${choice.label}: ${choice.value}`;\\n        const input = doc.createElement('input');\\n        input.type = 'range';\\n        input.min = String(choice.min);\\n        input.max = String(choice.max);\\n        input.step = String(choice.step);\\n        input.value = String(choice.value);\\n        input.dataset.choice = choice.id;\\n        input.tabIndex = 0;\\n        if (choice.focus) input.classList.add('is-focus');\\n        input.addEventListener('input', () => handlers.slide(choice.id, Number(input.value)));\\n        input.addEventListener('pointerdown', () => handlers.hover(choice.index));\\n        label.appendChild(input);\\n        mid.appendChild(label);\\n      } else {\\n        const button = doc.createElement('button');\\n        button.type = 'button';\\n        button.dataset.choice = choice.id;\\n        button.textContent = choice.label;\\n        button.tabIndex = 0;\\n        if (choice.focus) {\\n          button.classList.add('is-focus');\\n          button.autofocus = true;\\n        }\\n        button.addEventListener('click', () => handlers.activate(choice.index));\\n        button.addEventListener('pointermove', () => handlers.hover(choice.index));\\n        mid.appendChild(button);\\n      }\\n    }\\n    if (model.page) {\\n      const pager = doc.createElement('p');\\n      pager.className = 'pages';\\n      pager.dataset.pager = 'page';\\n      pager.textContent = model.page;\\n      mid.appendChild(pager);\\n    }\\n    root.appendChild(mid);\\n\\n    const bottom = doc.createElement('div');\\n    bottom.className = 'row';\\n    if (model.disc) {\\n      const disc = doc.createElement('div');\\n      disc.className = 'disc';\\n      disc.dataset.disc = '1';\\n      const dot = doc.createElement('div');\\n      dot.className = 'dot';\\n      const x = 50 + model.disc.x * 40;\\n      const y = 50 - model.disc.y * 40;\\n      dot.style.left = `${x}%`;\\n      dot.style.top = `${y}%`;\\n      disc.appendChild(dot);\\n      bottom.appendChild(disc);\\n    }\\n    const prompts = doc.createElement('div');\\n    prompts.className = 'prompts';\\n    for (const prompt of model.prompts || []) {\\n      const wrap = doc.createElement('span');\\n      wrap.className = 'tag';\\n      wrap.innerHTML = glyphSvg(prompt.glyph);\\n      const name = doc.createElement('span');\\n      name.textContent = ` ${prompt.verb}`;\\n      wrap.appendChild(name);\\n      prompts.appendChild(wrap);\\n    }\\n    bottom.appendChild(prompts);\\n    root.appendChild(bottom);\\n    const focused = root.querySelector('.is-focus');\\n    if (focused && focused.focus) focused.focus({ preventScroll: true });\\n  };\\n  return { paint };\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/ui.js has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/ui.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/ui/ui.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"import { CSS } from './styles.js';\\nimport { glyphSvg } from '../input/glyphs.js';\\n\\nexport function mountUi(doc, handlers) {\\n  if (!doc.getElementById('level-best-css')) {\\n    const style = doc.createElement('style');\\n    style.id = 'level-best-css';\\n    style.textContent = CSS;\\n    doc.head.appendChild(style);\\n  }\\n  let root = doc.getElementById('ui');\\n  if (!root) {\\n    root = doc.createElement('div');\\n    root.id = 'ui';\\n    doc.body.appendChild(root);\\n  }\\n  const paint = (model) => {\\n    doc.body.dataset.screen = model.screen || '';\\n    doc.body.dataset.attract = model.attract ? 'true' : 'false';\\n    root.replaceChildren();\\n    const top = doc.createElement('div');\\n    top.className = 'hud';\\n    const title = doc.createElement('div');\\n    if (model.screen === 'title' || model.screen === 'touch' || model.attract) {\\n      const h = doc.createElement('h1');\\n      h.textContent = model.gameTitle || 'Level Best';\\n      title.appendChild(h);\\n    } else if (model.heading) {\\n      const h = doc.createElement('h2');\\n      h.textContent = model.heading;\\n      title.appendChild(h);\\n    }\\n    for (const line of model.lines || []) {\\n      const p = doc.createElement('p');\\n      p.textContent = line;\\n      title.appendChild(p);\\n    }\\n    top.appendChild(title);\\n    if (model.hud) {\\n      const side = doc.createElement('div');\\n      const time = doc.createElement('div');\\n      time.className = 'time';\\n      time.textContent = model.hud.time;\\n      const score = doc.createElement('div');\\n      score.className = 'score';\\n      score.textContent = model.hud.score;\\n      side.append(time, score);\\n      top.appendChild(side);\\n    }\\n    root.appendChild(top);\\n\\n    if (model.speech) {\\n      const bubble = doc.createElement('div');\\n      bubble.className = 'speech';\\n      const who = doc.createElement('p');\\n      who.textContent = model.speech.who;\\n      const said = doc.createElement('p');\\n      said.textContent = model.speech.text;\\n      bubble.append(who, said);\\n      root.appendChild(bubble);\\n    }\\n\\n    const mid = doc.createElement('div');\\n    for (const choice of model.choices || []) {\\n      if (choice.kind === 'slider') {\\n        const label = doc.createElement('label');\\n        label.className = 'choice';\\n        label.textContent = `${choice.label}: ${choice.value}`;\\n        const input = doc.createElement('input');\\n        input.type = 'range';\\n        input.min = String(choice.min);\\n        input.max = String(choice.max);\\n        input.step = String(choice.step);\\n        input.value = String(choice.value);\\n        input.dataset.choice = choice.id;\\n        input.tabIndex = 0;\\n        if (choice.focus) input.classList.add('is-focus');\\n        input.addEventListener('input', () => handlers.slide(choice.id, Number(input.value)));\\n        input.addEventListener('pointerdown', () => handlers.hover(choice.index));\\n        label.appendChild(input);\\n        mid.appendChild(label);\\n      } else {\\n        const button = doc.createElement('button');\\n        button.type = 'button';\\n        button.dataset.choice = choice.id;\\n        button.textContent = choice.label;\\n        button.tabIndex = 0;\\n        if (choice.focus) {\\n          button.classList.add('is-focus');\\n          button.autofocus = true;\\n        }\\n        button.addEventListener('click', () => handlers.activate(choice.index));\\n        button.addEventListener('pointermove', () => handlers.hover(choice.index));\\n        mid.appendChild(button);\\n      }\\n    }\\n    if (model.page) {\\n      const pager = doc.createElement('p');\\n      pager.className = 'pages';\\n      pager.dataset.pager = 'page';\\n      pager.textContent = model.page;\\n      mid.appendChild(pager);\\n    }\\n    root.appendChild(mid);\\n\\n    const bottom = doc.createElement('div');\\n    bottom.className = 'row';\\n    if (model.disc) {\\n      const disc = doc.createElement('div');\\n      disc.className = 'disc';\\n      disc.dataset.disc = '1';\\n      const dot = doc.createElement('div');\\n      dot.className = 'dot';\\n      const x = 50 + model.disc.x * 40;\\n      const y = 50 - model.disc.y * 40;\\n      dot.style.left = `${x}%`;\\n      dot.style.top = `${y}%`;\\n      disc.appendChild(dot);\\n      bottom.appendChild(disc);\\n    }\\n    const prompts = doc.createElement('div');\\n    prompts.className = 'prompts';\\n    for (const prompt of model.prompts || []) {\\n      const wrap = doc.createElement('span');\\n      wrap.className = 'tag';\\n      wrap.innerHTML = glyphSvg(prompt.glyph);\\n      const name = doc.createElement('span');\\n      name.textContent = ` ${prompt.verb}`;\\n      wrap.appendChild(name);\\n      prompts.appendChild(wrap);\\n    }\\n    bottom.appendChild(prompts);\\n    root.appendChild(bottom);\\n    const focused = root.querySelector('.is-focus');\\n    if (focused && focused.focus) focused.focus({ preventScroll: true });\\n  };\\n  return { paint };\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"bb3ea2a0-8aec-4129-98ac-b782990d8e4b"}
{"type":"assistant","message":{"id":"msg_134","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Using innerHTML with a trusted glyphSvg is safe.\n\nPlayer names will use textContent. The director.js file is the next major task. It will include driveBots helpers and state fields for group, attract, and session. Profile and settings are also planned. A screen model builder view() is needed too.\n\nThe director needs eventById, CheckIn, score functions, programme, island rest, audio, input, bot, glyphs, save, config, rng, tuning, dialogue, NAMES, and unlocks. UI rendering will skip if no document exists. Solo mode uses inputs[0] and four pads. In the browser, navigator.getGamepads will be used instead of internal pads so bot writes apply to real gamepads.\n\nA `padList()` helper will return external pads when available, otherwise the internal array. The main function will set the pad source to read from `navigator.getGamepads` and fall back to `window.__pads`. Bot writes will target whichever pad list is active.\n\nA `padAt(i)` helper will read from the active pad list or fall back to the internal array. The main function will initialize `window.__pads` with four real pads so bot writes do not target null gamepads.\n\nThe padAt helper will return the external pad object directly when the source provides it, so bot writes target the same object that gets read. If the source returns null, it falls back to the internal pad. This prevents the test stub and internal pads from diverging.\n\nThe pad source defaults to the internal pads array. Four input objects are created per lane, each bound to its pad index and the active pad list. Solo play polls only inputs[0], while group mode polls all joined inputs. The menu also uses inputs[0] exclusively.\n\nThe first joined player drives group menus. Before anyone joins, the keyboard input controls them.\n\nPads will be zeroed when entering a menu or exiting attract mode so sticks cannot scroll menus.\n\nA `pad(i)` helper will expose internal pads for tests. Browser tests will write directly to `window.__pads`. Node tests will use `game.pad(i)`.","signature":""},{"type":"tool_use","id":"call-27a22917-f4e7-4779-80b5-b0edfb43496e-107","name":"write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","content":"import { TITLE, TAGLINE, SAVE_KEY, FIXED_DT, SEAT_COLOURS } from '../data/config.js';\nimport { eventById, eventIds } from '../events/index.js';\nimport { CheckIn } from './checkin.js';\nimport { medalOf, medalLabel, wobbleAge, marblePayout, tiersOpen } from './score.js';\nimport { dayPlan, programmeSteps } from '../data/programme.js';\nimport { restTiltRad, detuneCents } from '../physics/island.js';\nimport { initRapier } from '../physics/world.js';\nimport { createInput } from '../input/input.js';\nimport { makePad, clearPad, writeWish, writeButton, skillOf } from '../input/bot.js';\nimport { promptFor } from '../input/glyphs.js';\nimport { getTune, setTune, resetTuning, tuningSnapshot } from '../core/tuning.js';\nimport { TUNING_DEFS } from '../data/tuning.js';\nimport { rng, resetRng, setSessionMode } from '../core/rng.js';\nimport { readSave, writeSave, memoryStorage } from '../core/save.js';\nimport { createAudio } from '../audio/engine.js';\nimport { EVENT_TRACK } from '../audio/tracks.js';\nimport { findLine, takeLine } from '../data/dialogue.js';\nimport { NAMES, PAINTS, HATS } from '../data/names.js';\nimport { createLoop } from '../core/loop.js';\nimport { mountUi } from '../ui/ui.js';\n\nconst SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\nconst ATTRACT = ['fruitHat', 'cairn', 'stepClass', 'plates', 'springboard', 'raft', 'roomService', 'poses'];\nconst QUESTIONS = [\n  { ask: 'trudy.question.0', yes: 'trudy.yes.0', no: 'trudy.no.0', kind: 'yes' },\n  { ask: 'trudy.question.1', yes: 'trudy.yes.1', no: 'trudy.no.1', kind: 'yes' },\n  { ask: 'trudy.question.2', yes: 'trudy.yes.2', no: 'trudy.no.2', kind: 'yes' },\n  { ask: 'trudy.question.3', left: 'trudy.left.0', right: 'trudy.right.0', kind: 'side' },\n];\n\nfunction freshProfile() {\n  return {\n    name: NAMES[0], paint: 'coral', hat: 'none', nameIndex: 0, paintIndex: 0, hatIndex: 0,\n    dayIndex: 0, doneSteps: [], met: [], cleared: {}, best: {},\n    marbles: 0, ages: [], stamps: [], medals: [], minutes: 0, floor: 0,\n    levelled: false, classDone: [],\n  };\n}\n\nfunction defaultSettings() {\n  return {\n    music: 10, sfx: 80, voice: 80, glyphs: 'playstation', rumble: true,\n    autoBreathe: false, rhythmOffset: 0, uiScale: 1, ink: 1, reduceShake: false,\n    difficulty: 'standard',\n  };\n}\n\nexport async function createGame(opts = {}) {\n  await initRapier();\n  const storage = opts.storage || (opts.window && opts.window.localStorage) || memoryStorage();\n  const doc = opts.document || null;\n  const audio = createAudio();\n  const pads = [0, 1, 2, 3].map(() => makePad());\n  let padSource = () => pads;\n  const inputs = [0, 1, 2, 3].map((i) => {\n    const input = createInput();\n    input.setPadSource(() => padSource());\n    input.setPadIndex(i);\n    input.setDevice('pad');\n    return input;\n  });\n  const profile = freshProfile();\n  const settings = defaultSettings();\n  const saved = readSave(storage, SAVE_KEY);\n  if (saved) {\n    Object.assign(profile, saved.profile);\n    Object.assign(settings, saved.settings);\n  }\n  let screen = 'title';\n  let focus = 0;\n  let page = 0;\n  let idle = 0;\n  let attract = null;\n  let event = null;\n  let eventId = null;\n  let tier = 1;\n  let paused = false;\n  let countLeft = 0;\n  let speech = null;\n  let speechLeft = 0;\n  let pending = null;\n  let jarLeft = 0;\n  let jarPay = 0;\n  let botSkill = null;\n  let botOpt = {};\n  let god = false;\n  let timeScale = 1;\n  let coarse = !!opts.coarse;\n  let session = null;\n  let locked = false;\n  let errors = [];\n  let volumeOpen = false;\n  let devFromPause = false;\n  let group = null;\n  let freePick = false;\n  let lastResult = null;\n  let copyText = '';\n  let palette = 'dawn';\n  let frames = 0;\n  let backend = 'none';\n  let lost = null;\n  const listeners = new Set();\n  const programme = programmeSteps(eventIds());\n  let ui = null;\n  if (doc) {\n    ui = mountUi(doc, {\n      activate: (index) => activate(index),\n      hover: (index) => { focus = index; paint(); },\n      slide: (id, value) => { setTune(id, value); applySettings(); paint(); },\n    });\n  }\n\n  function applySettings() {\n    audio.setGains(settings.music / 100, settings.sfx / 100, settings.voice / 100);\n    inputs.forEach((input) => input.setRumble(settings.rumble));\n  }\n  applySettings();\n\n  function persist() {\n    writeSave(storage, SAVE_KEY, { profile, settings });\n  }\n\n  function tiltRad() {\n    const rest = getTune('islandRest');\n    return restTiltRad(profile.doneSteps.length, Math.max(1, programme.length), rest);\n  }\n\n  function talk(speaker, bucket) {\n    const line = takeLine(speaker, bucket, rng('talk'));\n    if (!line) return;\n    speech = { who: speaker === 'stillwater' ? 'Ms. Stillwater' : speaker === 'bolster' ? 'Coach Bolster' : 'Trudy', text: line.text, id: line.id };\n    const rate = speaker === 'stillwater' ? 7 : speaker === 'bolster' ? 11 : 16;\n    speechLeft = Math.max(0.8, line.text.length / rate);\n    audio.say(line.text, speaker === 'guest' ? 'guest' : speaker);\n  }\n\n  function sayId(id) {\n    const line = findLineById(id);\n    if (!line) return;\n    speech = { who: 'Trudy', text: line.text, id: line.id };\n    speechLeft = Math.max(0.6, line.text.length / 16);\n    audio.say(line.text, 'trudy');\n  }\n\n  function findLineById(id) {\n    return findLine(id) ? null : null;\n  }\n\n  function choicesOf() {\n    return model().choices;\n  }\n\n  function setScreen(next, keepFocus = false) {\n    screen = next;\n    if (!keepFocus) focus = 0;\n    page = 0;\n    volumeOpen = false;\n    if (next !== 'play') paused = false;\n    for (const pad of pads) clearPad(pad);\n    paint();\n    persist();\n  }\n\n  function today() {\n    const plan = dayPlan(profile.dayIndex, eventIds());\n    if (plan.maintenance) {\n      const pool = eventIds().slice();\n      const picked = [];\n      while (picked.length < 3 && pool.length) {\n        const i = Math.floor(rng('maintenance') * pool.length);\n        picked.push(pool.splice(i, 1)[0]);\n      }\n      plan.classes = picked;\n    }\n    return plan;\n  }\n\n  function tierFor(id) {\n    if (!freePick && profile.dayIndex < 5) return 1;\n    const best = profile.best[id] || {};\n    return tiersOpen(best);\n  }\n\n  function startEvent(id, extra = {}) {\n    if (event) event.dispose();\n    const Ctor = id === 'checkin' ? CheckIn : eventById(id);\n    eventId = id;\n    tier = extra.tier || (id === 'checkin' ? 1 : tierFor(id));\n    const lanes = extra.lanes || [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] }];\n    event = new Ctor({\n      tier, lanes, seed: extra.seed || 1, session: !!extra.session, god: extra.god || god,\n      difficulty: settings.difficulty, tests: extra.tests, skill: extra.skill || 'sharp',\n      label: `${id}-${profile.dayIndex}`,\n    });\n    if (event.build) event.build();\n    audio.play(EVENT_TRACK[id] || 'island');\n  }\n\n  function finishEvent() {\n    if (!event) return;\n    const result = event.result(0);\n    lastResult = result;\n    profile.minutes += (event.t || 0) / 60;\n    profile.floor += result.falls || 0;\n    if (eventId !== 'checkin') {\n      const form = result.form || 0;\n      const best = profile.best[eventId] || {};\n      best[tier] = Math.max(best[tier] || 0, form);\n      profile.best[eventId] = best;\n      if (!profile.met.includes(eventId)) profile.met.push(eventId);\n      if (programme.includes(eventId) && !profile.doneSteps.includes(eventId)) profile.doneSteps.push(eventId);\n      const first = !profile.cleared[eventId];\n      jarPay = marblePayout({\n        seconds: event.t || 0, form, firstClear: first,\n        perMin: getTune('marblesPerMin'), medalScale: getTune('medalScale'),\n      });\n      profile.cleared[eventId] = true;\n      profile.medals.push({ id: eventId, tier, form, medal: result.medal });\n      if (!profile.classDone.includes(eventId)) profile.classDone.push(eventId);\n    }\n    event.dispose();\n    event = null;\n    audio.setTilt(tiltRad());\n  }\n\n  function woke(sample, travel) {\n    const e = sample.edges;\n    if (e.confirm || e.back || e.pause || e.hop || e.flail || e.ask || e.up || e.down || e.left || e.right || e.recenter) return true;\n    if (sample.padConnected && Math.hypot(sample.wish.x, sample.wish.y) > 0.3) return true;\n    if (travel > 8) return true;\n    return false;\n  }\n\n  function menuMove(sample) {\n    const list = choicesOf();\n    const n = list.length || 1;\n    if (sample.edges.up) focus = (focus - 1 + n) % n;\n    if (sample.edges.down) focus = (focus + 1) % n;\n    if (sample.edges.left || sample.edges.right) nudge(list[focus], sample.edges.right ? 1 : -1);\n    if (sample.edges.confirm) activate(focus);\n    if (sample.edges.back) back();\n  }\n\n  function nudge(choice, dir) {\n    if (!choice) return;\n    if (choice.kind === 'slider') {\n      const def = TUNING_DEFS.find((d) => d.id === choice.id);\n      if (def) setTune(choice.id, getTune(choice.id) + dir * def.step);\n      return;\n    }\n    if (choice.id === 'music') settings.music = clampNum(settings.music + dir * 5, 0, 100);\n    if (choice.id === 'sfx') settings.sfx = clampNum(settings.sfx + dir * 5, 0, 100);\n    if (choice.id === 'voice') settings.voice = clampNum(settings.voice + dir * 5, 0, 100);\n    if (choice.id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\n    if (choice.id === 'difficulty') {\n      const order = ['gentle', 'standard', 'honest'];\n      const i = order.indexOf(settings.difficulty);\n      settings.difficulty = order[(i + (dir > 0 ? 1 : 2)) % 3];\n    }\n    if (choice.id === 'name') profile.nameIndex = (profile.nameIndex + (dir > 0 ? 1 : NAMES.length - 1)) % NAMES.length;\n    if (choice.id === 'paint') profile.paintIndex = (profile.paintIndex + (dir > 0 ? 1 : PAINTS.length - 1)) % PAINTS.length;\n    if (choice.id === 'hat') profile.hatIndex = (profile.hatIndex + (dir > 0 ? 1 : HATS.length - 1)) % HATS.length;\n    if (choice.id === 'page') page = Math.max(0, page + dir);\n    applySettings();\n  }\n\n  function activate(index) {\n    const list = choicesOf();\n    const choice = list[index];\n    if (!choice || choice.kind === 'slider') return;\n    focus = index;\n    audio.unlock();\n    audio.sfx('uiConfirm');\n    const id = choice.id;\n    if (screen === 'title') return setScreen(profile.stamps.length || profile.dayIndex > 0 ? 'menu' : 'who');\n    if (screen === 'touch') return setScreen('settings');\n    if (screen === 'who' && id === 'begin') {\n      profile.name = NAMES[profile.nameIndex];\n      profile.paint = PAINTS[profile.paintIndex].id;\n      profile.hat = HATS[profile.hatIndex].id;\n      return setScreen('tutorial');\n    }\n    if (screen === 'tutorial' && id === 'on') return beginDay();\n    if (screen === 'menu') {\n      if (id === 'programme') return profile.classDone.length ? setScreen('plan') : beginDay();\n      if (id === 'group') { group = { seats: [null, null, null, null], points: [0, 0, 0, 0], playlist: [], cursor: 0 }; return setScreen('group'); }\n      if (id === 'free') { freePick = true; return setScreen('free'); }\n      if (id === 'journal') return setScreen('journal');\n      if (id === 'settings') return setScreen('settings');\n      if (id === 'about') return setScreen('about');\n    }\n    if (screen === 'question') return answerQuestion(id);\n    if (screen === 'reply') return setScreen('checkinPlay');\n    if (screen === 'age') return setScreen('plan');\n    if (screen === 'plan' && eventById(id)) return openIntro(id);\n    if (screen === 'intro') return beginCountdown();\n    if (screen === 'results') {\n      if (id === 'retry') return openIntro(eventId);\n      return afterResult();\n    }\n    if (screen === 'jar') return afterJar();\n    if (screen === 'bed') {\n      if (id === 'free') { freePick = true; return setScreen('free'); }\n      return sleepDay();\n    }\n    if (screen === 'ending') return setScreen(pageOfEnding());\n    if (screen === 'credits') { sleepDay(); return setScreen('menu'); }\n    if (screen === 'pause') return pauseAction(id);\n    if (screen === 'settings') return settingsAction(id);\n    if (screen === 'dev') return devAction(id);\n    if (screen === 'free' && eventById(id)) return openIntro(id);\n    if (screen === 'group') return groupAction(id);\n    if (screen === 'confirm-reset' && id === 'yes') { resetAll(); return setScreen('title'); }\n    if (screen === 'confirm-reset') return setScreen('settings');\n    if (screen === 'island') {\n      if (id === 'plan') return setScreen('plan');\n      if (id === 'bed') return setScreen('bed');\n      if (id === 'menu') return setScreen('menu');\n    }\n    paint();\n  }\n\n  function pageOfEnding() {\n    if (screen === 'ending') return 'credits';\n    return 'credits';\n  }\n\n  function beginDay() {\n    freePick = false;\n    profile.classDone = [];\n    talk('trudy', 'morning');\n    setScreen('morning');\n  }\n\n  function answerQuestion(id) {\n    const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\n    const key = id === 'yes' ? q.yes : id === 'no' ? q.no : id === 'left' ? q.left : q.right;\n    const line = lookup(key);\n    speech = { who: 'Trudy', text: line ? line.text : 'Noted.', id: key };\n    speechLeft = 1.2;\n    if (line) audio.say(line.text, 'trudy');\n    setScreen('reply');\n  }\n\n  function openIntro(id) {\n    eventId = id;\n    tier = tierFor(id);\n    setScreen('intro');\n  }\n\n  function beginCountdown() {\n    const plan = today();\n    startEvent(eventId, {\n      tests: eventId === 'checkin' ? plan.tests : undefined,\n      god: screen === 'attract',\n    });\n    if (eventId === 'checkin') {\n      screen = 'checkinPlay';\n      return;\n    }\n    countLeft = 3;\n    setScreen('countdown');\n  }\n\n  function afterResult() {\n    if (eventId === 'checkin') return;\n    profile.marbles += jarPay;\n    jarLeft = 2;\n    audio.sfx('marble');\n    setScreen('jar');\n  }\n\n  function afterJar() {\n    if (profile.levelled && eventId === 'grandHold') {\n      sayExact(\"Oh. So that's what the middle looks like.\");\n      return setScreen('ending');\n    }\n    const plan = today();\n    const pendingClass = plan.classes.filter((id) => !profile.classDone.includes(id));\n    if (group && group.playlist) return scoreGroup();\n    if (pendingClass.length && !freePick) return setScreen('plan');\n    if (freePick) return setScreen('free');\n    return setScreen('bed');\n  }\n\n  function sleepDay() {\n    const plan = today();\n    profile.stamps.push({ day: profile.dayIndex + 1, name: plan.name });\n    profile.dayIndex += 1;\n    profile.classDone = [];\n    palette = 'dawn';\n    persist();\n  }\n\n  function scoreGroup() {\n    if (!group) return setScreen('menu');\n    const forms = lastResult && lastResult.forms ? lastResult.forms : group.seats.map((s, i) => (s ? (i === 0 ? lastResult.form : 0) : -1));\n    const ranked = forms.map((form, i) => ({ i, form })).filter((row) => row.form >= 0).sort((a, b) => b.form - a.form);\n    const points = [4, 3, 2, 1];\n    ranked.forEach((row, place) => { group.points[row.i] += points[place] || 1; });\n    group.cursor += 1;\n    if (group.cursor >= group.playlist.length) return setScreen('podium');\n    openIntro(group.playlist[group.cursor]);\n  }\n\n  function back() {\n    if (screen === 'settings' || screen === 'about' || screen === 'journal' || screen === 'free' || screen === 'group' || screen === 'mirror') return setScreen('menu');\n    if (screen === 'dev') return setScreen('pause');\n    if (screen === 'pause') { paused = false; return setScreen('play'); }\n    if (screen === 'plan' || screen === 'island') return setScreen('menu');\n    if (screen === 'who') return setScreen('title');\n  }\n\n  function pauseAction(id) {\n    if (id === 'resume') { paused = false; return setScreen('play'); }\n    if (id === 'restart') { openIntro(eventId); return; }\n    if (id === 'howto') return setScreen('howto');\n    if (id === 'settings') return setScreen('settings');\n    if (id === 'dev') { devFromPause = true; return setScreen('dev'); }\n    if (id === 'leave') {\n      if (event) event.dispose();\n      event = null;\n      return setScreen('island');\n    }\n  }\n\n  function settingsAction(id) {\n    if (id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\n    if (id === 'rumble') settings.rumble = !settings.rumble;\n    if (id === 'breathe') settings.autoBreathe = !settings.autoBreathe;\n    if (id === 'shake') settings.reduceShake = !settings.reduceShake;\n    if (id === 'full') {\n      const el = doc && doc.documentElement;\n      if (el && el.requestFullscreen) el.requestFullscreen().catch(() => {});\n    }\n    if (id === 'reset') return setScreen('confirm-reset');\n    if (id === 'next') page = (page + 1) % 4;\n    if (id === 'prev') page = (page + 3) % 4;\n    applySettings();\n    paint();\n  }\n\n  function devAction(id) {\n    if (!devFromPause && screen !== 'dev') return;\n    if (id === 'reset-tune') resetTuning();\n    if (id === 'god') god = !god;\n    if (id === 'faster') timeScale = Math.min(4, timeScale * 2);\n    if (id === 'slower') timeScale = Math.max(0.1, timeScale / 2);\n    if (id === 'step' && event) event.fixed(FIXED_DT, [inputs[0].snapshot(0)]);\n    if (id === 'fall' && event && event.beginFall) event.beginFall(0);\n    if (id === 'results') { finishEvent(); return setScreen('results'); }\n    if (id === 'ending') {\n      profile.doneSteps = programme.slice();\n      profile.levelled = true;\n      profile.met = eventIds();\n      sayExact(\"Oh. So that's what the middle looks like.\");\n      return setScreen('ending');\n    }\n    if (id === 'marbles') profile.marbles += 10;\n    if (id === 'unlock') profile.met = eventIds();\n    if (id === 'age') profile.ages.push(41);\n    if (id === 'bot') botSkill = botSkill ? null : 'sharp';\n    if (id === 'copy') copyText = JSON.stringify(tuningSnapshot());\n    if (id === 'wipe') return setScreen('confirm-reset');\n    if (id === 'next') page += 1;\n    if (id === 'prev') page = Math.max(0, page - 1);\n    if (id.startsWith('jump-')) {\n      devFromPause = true;\n      return openIntro(id.slice(5));\n    }\n    paint();\n  }\n\n  function groupAction(id) {\n    if (id === 'quick' || id === 'raft' || eventById(id)) {\n      const couch = eventIds().filter((eid) => eventById(eid).couch);\n      const playlist = id === 'quick' ? pickSome(couch, 3) : [id === 'raft' ? 'raft' : id];\n      group.playlist = playlist;\n      group.cursor = 0;\n      const lanes = group.seats.map((seat, i) => seat ? ({\n        id: i, kind: 'local', name: seat.name, colour: SEAT_COLOURS[i],\n      }) : null).filter(Boolean);\n      if (!lanes.length) lanes.push({ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] });\n      group.lanes = lanes;\n      return openIntro(playlist[0]);\n    }\n    if (id === 'back') return setScreen('menu');\n  }\n\n  function pickSome(list, n) {\n    const pool = list.slice();\n    const out = [];\n    while (out.length < n && pool.length) out.push(pool.splice(Math.floor(rng('group') * pool.length), 1)[0]);\n    return out;\n  }\n\n  function resetAll() {\n    const next = freshProfile();\n    Object.keys(profile).forEach((k) => delete profile[k]);\n    Object.assign(profile, next);\n    Object.assign(settings, defaultSettings());\n    resetTuning();\n    try { storage.removeItem(SAVE_KEY); } catch { /* memory store */ }\n  }\n\n  function sayExact(text) {\n    speech = { who: 'Trudy', text, id: 'exact' };\n    speechLeft = Math.max(1, text.length / 16);\n    audio.say(text, 'trudy');\n  }\n\n  function lookup(id) {\n    const { lineById } = dialogueApi();\n    return lineById(id);\n  }\n\n  function dialogueApi() {\n    return import('../data/dialogue.js');\n  }\n\n  function driveBots(dt) {\n    if (!event || !botSkill) return null;\n    const skill = skillOf(botSkill);\n    const snaps = [];\n    const count = event.lanes.length;\n    for (let i = 0; i < count; i++) {\n      const cmd = event.botInput(i, skill, botOpt) || {};\n      const pad = padAt(i);\n      clearPad(pad);\n      writeWish(pad, cmd.x || 0, cmd.y || 0);\n      writeButton(pad, 0, !!cmd.hop);\n      writeButton(pad, 2, !!cmd.flail);\n      writeButton(pad, 5, !!(cmd.breathe || (settings.autoBreathe && screen === 'play')));\n      writeButton(pad, 6, (cmd.feetL || 0) > 0, cmd.feetL || 0);\n      writeButton(pad, 7, (cmd.feetR || 0) > 0, cmd.feetR || 0);\n      const input = inputs[i];\n      if (cmd.plateA) input.keyDown('KeyA');\n      if (cmd.plateD) input.keyDown('KeyD');\n      input.poll(dt, 'balance');\n      if (cmd.plateA) input.keyUp('KeyA');\n      if (cmd.plateD) input.keyUp('KeyD');\n      snaps.push(input.snapshot(0));\n    }\n    return snaps;\n  }\n\n  function padAt(i) {\n    const list = padSource() || pads;\n    return list[i] || pads[i];\n  }\n\n  function fixed(dt) {\n    if (locked) return;\n    audio.setTilt(tiltRad());\n    if (session) return sessionFixed(dt);\n    const input = inputs[0];\n    const before = input.takeTravel ? 0 : 0;\n    const playing = screen === 'play' || screen === 'checkinPlay' || attract;\n    if (playing && botSkill) {\n      const snaps = driveBots(dt);\n      if (!paused && event) stepEvent(dt, snaps);\n      noteNotch();\n      return;\n    }\n    const sample = input.poll(dt, playing ? 'balance' : 'menu');\n    const travel = input.takeTravel();\n    if (attract) {\n      if (woke(sample, travel)) { stopAttract(true); return; }\n      stepAttract(dt);\n      return;\n    }\n    if (screen === 'title' || screen === 'menu' || screen === 'touch') {\n      if (woke(sample, travel)) idle = 0;\n      else idle += dt;\n      if (idle >= 10) { startAttract(); return; }\n    } else idle = 0;\n    if (sample.edges.pause && (screen === 'play' || screen === 'checkinPlay') && !sample.createHeld) {\n      paused = true;\n      return setScreen('pause');\n    }\n    if ((screen === 'play' || screen === 'checkinPlay') && !paused) {\n      const snaps = [];\n      const n = event ? event.lanes.length : 1;\n      snaps.push(sampleToSnap(sample, input));\n      for (let i = 1; i < n; i++) {\n        const extra = inputs[i].poll(dt, 'balance');\n        snaps.push(sampleToSnap(extra, inputs[i]));\n      }\n      joinPads(sample);\n      stepEvent(dt, snaps);\n      noteNotch();\n      if (event && event.done) {\n        finishEvent();\n        if (eventId === 'checkin') revealAge();\n        else setScreen('results');\n      }\n      return;\n    }\n    if (screen === 'countdown') {\n      countLeft -= dt;\n      if (countLeft <= 0) setScreen('play');\n      return;\n    }\n    if (screen === 'morning') {\n      speechLeft -= dt;\n      if (sample.edges.confirm || speechLeft <= 0) openQuestion();\n      return;\n    }\n    if (screen === 'jar') {\n      jarLeft -= dt;\n      if (sample.edges.confirm || jarLeft <= 0) afterJar();\n      return;\n    }\n    if (speechLeft > 0) speechLeft -= dt;\n    if (!playing) menuMove(sample);\n    void before;\n  }\n\n  function sampleToSnap(sample, input) {\n    return input.snapshot(0);\n  }\n\n  function stepEvent(dt, snaps) {\n    if (!event || paused) return;\n    event.fixed(dt, snaps || []);\n    if (event.frame) event.frame(dt);\n  }\n\n  function noteNotch() {\n    if (event && event.notch && !profile.doneSteps.includes('grandHold')) {\n      profile.doneSteps.push('grandHold');\n      profile.levelled = profile.doneSteps.length >= programme.length;\n      if (!profile.met.includes('grandHold')) profile.met.push('grandHold');\n      audio.sfx('creak');\n    }\n    if (profile.doneSteps.length >= programme.length) profile.levelled = true;\n  }\n\n  function revealAge() {\n    const mean = lastResult.mean || 0;\n    const age = wobbleAge(mean, Math.min(4, profile.dayIndex));\n    profile.ages.push(age);\n    profile.marbles += 1;\n    sayExact(`Your Wobble Age is ${age}.`);\n    setScreen('age');\n  }\n\n  function openQuestion() {\n    setScreen('question');\n  }\n\n  function startAttract() {\n    attract = { index: 0, left: 18, between: 0, seen: [] };\n    idle = 0;\n    botSkill = 'sharp';\n    launchAttract();\n  }\n\n  function launchAttract() {\n    const id = ATTRACT[attract.index % ATTRACT.length];\n    if (!attract.seen.includes(id)) attract.seen.push(id);\n    startEvent(id, { god: id !== 'fruitHat', lanes: [{ id: 0, kind: 'bot', name: 'Demo', colour: SEAT_COLOURS[1] }] });\n    botOpt = id === 'fruitHat' ? { bankAt: 99 } : {};\n    screen = 'play';\n  }\n\n  function stepAttract(dt) {\n    if (!attract) return;\n    if (attract.between > 0) {\n      attract.between -= dt;\n      screen = 'title';\n      if (attract.between <= 0) launchAttract();\n      return;\n    }\n    const snaps = driveBots(dt);\n    if (event) stepEvent(dt, snaps);\n    attract.left -= dt;\n    if (!event || event.done || attract.left <= 0) {\n      if (event) { event.dispose(); event = null; }\n      attract.index += 1;\n      attract.left = 18;\n      if (attract.index % ATTRACT.length === 0) {\n        attract.between = 5;\n        screen = 'title';\n        botSkill = null;\n      } else launchAttract();\n    }\n  }\n\n  function stopAttract(swallow) {\n    if (event) { event.dispose(); event = null; }\n    attract = null;\n    botSkill = null;\n    botOpt = {};\n    idle = 0;\n    for (const pad of pads) clearPad(pad);\n    screen = coarse ? 'touch' : 'title';\n    if (swallow) paint();\n  }\n\n  function joinPads(sample) {\n    if (screen !== 'group' || !group) return;\n    for (let i = 0; i < 4; i++) {\n      const pad = padAt(i);\n      if (pad && pad.buttons[0] && pad.buttons[0].pressed && !group.seats[i]) {\n        group.seats[i] = { name: `Player ${i + 1}`, device: 'pad' };\n      }\n      if (pad && pad.buttons[1] && pad.buttons[1].pressed) group.seats[i] = null;\n    }\n    if (sample.edges.confirm && !group.seats.some((s) => s && s.device === 'key')) {\n      const slot = group.seats.findIndex((s) => !s);\n      if (slot >= 0) group.seats[slot] = { name: profile.name, device: 'key' };\n    }\n  }\n\n  function sessionFixed(dt) {\n    const hub = globalThis.AIHub;\n    if (!hub) return;\n    const ms = hub.time();\n    if (!Number.isFinite(ms)) {\n      screen = 'card';\n      return;\n    }\n    const t = ms / 1000;\n    if (t < 0) {\n      screen = 'countdown';\n      countLeft = Math.max(0, -t);\n      return;\n    }\n    const slot = Math.min(session.slots.length, Math.floor(t / 62));\n    const local = t - slot * 62;\n    if (slot >= session.slots.length) {\n      screen = 'waiting';\n      sendResult();\n      return;\n    }\n    if (session.slot !== slot) {\n      session.slot = slot;\n      session.playT = 0;\n      if (event) event.dispose();\n      event = null;\n      eventId = session.slots[slot];\n    }\n    if (local < 6) {\n      screen = 'intro';\n      session.scoreShown = session.total;\n    } else if (local < 56) {\n      if (!event) {\n        startEvent(eventId, { session: true, lanes: [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[hub.me || 0] }] });\n        screen = 'play';\n      }\n      const input = inputs[0];\n      const snaps = botSkill ? driveBots(dt) : [input.snapshot(0)];\n      if (!botSkill) input.poll(dt, 'balance');\n      stepEvent(dt, snaps);\n      session.playT += dt;\n      if (event && (event.done || local >= 55.9)) {\n        const result = event.result(0);\n        session.parts.push(Math.round((result.form || 0) * 10));\n        session.total = session.parts.reduce((a, b) => a + b, 0);\n        session.best = medalLabel(result.medal || 'attended');\n        event.dispose();\n        event = null;\n        screen = 'results';\n      } else screen = 'play';\n    } else screen = 'results';\n    if (t - session.lastProgress >= 1 || session.lastProgress < 0) {\n      const label = `${eventTitle(session.slots[slot])} ${session.slot === 0 && local < 6 ? 0 : session.total}`.slice(0, 24);\n      const score = session.slot === 0 && local < 6 ? 0 : session.total;\n      hub.progress({ score, label });\n      session.lastProgress = t;\n    }\n    if (t - session.lastGhost >= 0.1) {\n      const lean = event && event.states ? event.states[0] : { leanX: 0, leanZ: 0, fallen: false };\n      hub.send({\n        t: 'g', a: slot, x: 0, z: 0,\n        lx: Number((lean.leanX || 0).toFixed(3)),\n        lz: Number((lean.leanZ || 0).toFixed(3)),\n        c: 0, f: lean.fallen ? 1 : 0, s: session.total,\n      }, { reliable: false });\n      session.lastGhost = t;\n    }\n    void dt;\n  }\n\n  function sendResult() {\n    const hub = globalThis.AIHub;\n    if (!session || session.sent || !hub) return;\n    session.sent = true;\n    const score = session.total || 0;\n    hub.result({\n      score,\n      stats: { 'Floor Exercises': profile.floor, 'Best medal': session.best || 'Attended', 'Wobble Age': profile.ages[0] || 41 },\n      awards: score >= 2500 ? ['Suspiciously Still'] : ['Showed Up'],\n    });\n  }\n\n  function eventTitle(id) {\n    const Ctor = eventById(id);\n    return Ctor ? Ctor.title : 'Class';\n  }\n\n  function frame() {\n    frames += 1;\n    if (!locked) audio.tick();\n    for (const fn of listeners) fn();\n    paint();\n  }\n\n  function model() {\n    const device = inputs[0].lastDevice;\n    const prompts = promptFor(currentVerbs(), device, settings.glyphs);\n    const lines = [];\n    const choices = [];\n    let heading = '';\n    const add = (id, label, extra = {}) => choices.push({ id, label, index: choices.length, focus: choices.length === focus, ...extra });\n    if (coarse && screen === 'title') screen = 'touch';\n    if (screen === 'touch') {\n      lines.push('Controller or keyboard required');\n      lines.push(TAGLINE);\n      add('settings', 'Settings');\n    } else if (screen === 'title' || (attract && attract.between > 0)) {\n      lines.push(TAGLINE);\n      lines.push('Press to begin');\n      add('begin', 'Begin');\n    } else if (screen === 'who') {\n      heading = \"Who's here?\";\n      add('name', `Name: ${NAMES[profile.nameIndex]}`);\n      add('paint', `Paint: ${PAINTS[profile.paintIndex].id}`);\n      add('hat', `Hat: ${HATS[profile.hatIndex].label}`);\n      add('begin', 'Begin');\n    } else if (screen === 'tutorial') {\n      heading = 'How a day works';\n      lines.push('You can lean, step, hop, and flail. You cannot type a name.');\n      lines.push('Flail is a short save with a cooldown. It is not a free win.');\n      add('on', 'Step on');\n    } else if (screen === 'menu') {\n      heading = 'Level Best Retreat';\n      const cont = profile.dayIndex > 0 || profile.classDone.length ? 'Continue' : 'Programme';\n      add('programme', cont);\n      add('group', 'Group Class');\n      add('free', 'Free Play');\n      add('journal', 'Journal');\n      add('settings', 'Settings');\n      add('about', 'About / Credits');\n    } else if (screen === 'morning') {\n      heading = today().name;\n      lines.push(speech ? speech.text : 'Good morning.');\n      add('on', 'Continue');\n    } else if (screen === 'question') {\n      const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\n      const line = lookup(q.ask);\n      heading = 'A small question';\n      lines.push(line ? line.text : 'Do you trust your knees?');\n      if (q.kind === 'side') { add('left', 'Left'); add('right', 'Right'); }\n      else { add('yes', 'Yes'); add('no', 'No'); }\n    } else if (screen === 'reply') {\n      heading = 'Trudy';\n      lines.push(speech ? speech.text : 'Noted.');\n      add('on', 'To the mat');\n    } else if (screen === 'age') {\n      heading = 'Wobble Age';\n      lines.push(String(profile.ages[profile.ages.length - 1] || ''));\n      lines.push('I did not ask how old you are. I asked your knees.');\n      add('on', 'See the plan');\n    } else if (screen === 'plan') {\n      heading = today().name;\n      const classes = today().classes;\n      for (const id of classes) add(id, `${eventTitle(id)}${profile.classDone.includes(id) ? ' — stamped' : ''}`);\n      if (!classes.length) lines.push('The day is open.');\n    } else if (screen === 'intro') {\n      const Ctor = eventById(eventId);\n      heading = Ctor ? Ctor.title : 'Class';\n      lines.push(Ctor ? Ctor.can : '');\n      lines.push(Ctor ? Ctor.cant : '');\n      add('go', 'Begin');\n    } else if (screen === 'countdown') {\n      heading = String(Math.max(1, Math.ceil(countLeft)));\n      lines.push('Hold still.');\n    } else if (screen === 'play' || screen === 'checkinPlay') {\n      heading = eventTitle(eventId);\n    } else if (screen === 'results') {\n      heading = lastResult ? medalLabel(lastResult.medal) : 'Attended';\n      lines.push(lastResult ? lastResult.stats : '');\n      lines.push(lastResult ? `Form ${Math.round(lastResult.form)}` : '');\n      add('continue', 'Continue');\n      add('retry', 'Retry');\n    } else if (screen === 'jar') {\n      heading = 'The jar';\n      lines.push(`+${jarPay} marbles. The jar has ${profile.marbles}.`);\n      add('on', 'Continue');\n    } else if (screen === 'bed') {\n      heading = 'Bed hut';\n      lines.push('The stamp is ready.');\n      add('bed', 'Sleep');\n      add('free', 'Free Play');\n    } else if (screen === 'ending') {\n      heading = 'Level';\n      lines.push(\"Oh. So that's what the middle looks like.\");\n      add('on', 'Listen');\n    } else if (screen === 'credits') {\n      heading = 'Credits';\n      lines.push(\"It's quite flat, isn't it? ...Same time tomorrow?\");\n      add('on', 'Same time tomorrow');\n    } else if (screen === 'pause') {\n      heading = 'Paused';\n      ['resume', 'restart', 'howto', 'settings', 'dev', 'leave'].forEach((id) => add(id, {\n        resume: 'Resume', restart: 'Restart', howto: 'How to Play', settings: 'Settings', dev: 'Dev Mode', leave: 'Leave Class',\n      }[id]));\n    } else if (screen === 'howto') {\n      heading = 'How to Play';\n      lines.push('Lean with the stick, the keys, or the mouse. Feet are the triggers.');\n      lines.push('You cannot win by flailing on cooldown.');\n      add('back', 'Back');\n    } else if (screen === 'settings') settingsModel(add, lines);\n    else if (screen === 'dev') devModel(add, lines);\n    else if (screen === 'about') aboutModel(add, lines);\n    else if (screen === 'journal') journalModel(add, lines);\n    else if (screen === 'free') {\n      heading = 'Free Play';\n      const ids = (profile.levelled ? eventIds() : profile.met);\n      const slice = ids.slice(page * 4, page * 4 + 4);\n      slice.forEach((id) => add(id, eventTitle(id)));\n      if (ids.length > 4) add('page', 'More');\n      if (!slice.length) lines.push('Meet a class first. The pavilions keep.');\n    } else if (screen === 'group') {\n      heading = 'Group Class';\n      lines.push(group.seats.map((s, i) => s ? `${i + 1} ${s.name}` : `${i + 1} empty`).join('  '));\n      add('quick', 'Quick Class');\n      add('raft', 'Tippy Raft');\n      add('back', 'Back');\n    } else if (screen === 'podium') {\n      heading = 'Podium';\n      lines.push(group.points.map((p, i) => `Seat ${i + 1}: ${p}`).join('  '));\n      add('back', 'Back to the island');\n    } else if (screen === 'island') {\n      heading = 'The island';\n      lines.push(speech ? speech.text : 'Trudy is here.');\n      add('plan', \"Today's Plan\");\n      add('bed', 'Bed hut');\n      add('menu', 'Menu');\n    } else if (screen === 'card') cardModel(lines);\n    else if (screen === 'waiting') {\n      heading = 'Waiting for the others';\n      lines.push('Trudy is keeping the clipboard shut.');\n    } else if (screen === 'confirm-reset') {\n      heading = 'Reset the save?';\n      lines.push('The jar will be empty again.');\n      add('yes', 'Yes, reset');\n      add('no', 'No');\n    } else if (screen === 'boot') {\n      lines.push('Stretching...');\n    }\n    if (attract && screen === 'play') lines.push('DEMO · Press any button');\n    if (copyText && screen === 'dev') lines.push(copyText);\n    const cob = event && event.cob ? event.cob(0) : { x: 0, y: 0 };\n    return {\n      screen: attract ? 'attract' : screen,\n      gameTitle: TITLE,\n      heading,\n      lines,\n      choices: choices.slice(0, 6),\n      page: pageLabel(),\n      prompts,\n      speech: speech && (screen === 'play' || screen === 'morning') ? speech : null,\n      hud: (screen === 'play' || screen === 'checkinPlay') && event ? {\n        time: formatTime(event.t || 0),\n        score: String(Math.round((event.result ? event.result(0).form : 0) || 0)),\n      } : null,\n      disc: (screen === 'play' || screen === 'checkinPlay') ? { x: cob.x || 0, y: cob.y || 0 } : null,\n      attract: !!attract,\n    };\n  }\n\n  function pageLabel() {\n    if (screen === 'settings') return `Page ${page + 1} of 4`;\n    if (screen === 'about') return `Page ${page + 1} of 8`;\n    if (screen === 'journal') return `Page ${page + 1}`;\n    if (screen === 'dev') return `Page ${page + 1}`;\n    return '';\n  }\n\n  function settingsModel(add, lines) {\n    const pages = [\n      () => { add('music', `Music: ${settings.music}`); add('sfx', `Sound: ${settings.sfx}`); add('voice', `Voice: ${settings.voice}`); },\n      () => { add('glyphs', `Glyphs: ${settings.glyphs}`); add('rumble', `Rumble: ${settings.rumble ? 'on' : 'off'}`); add('breathe', `Auto-breathe: ${settings.autoBreathe ? 'on' : 'off'}`); },\n      () => { add('shake', `Reduce shake: ${settings.reduceShake ? 'on' : 'off'}`); add('full', 'Fullscreen'); lines.push(`Ink ${settings.ink}`); },\n      () => { add('difficulty', `Difficulty: ${settings.difficulty}`); add('reset', 'Reset save'); },\n    ];\n    pages[page % 4]();\n    add('prev', 'Previous page');\n    add('next', 'Next page');\n  }\n\n  function devModel(add, lines) {\n    lines.push(`Time scale ${timeScale}. God ${god ? 'on' : 'off'}.`);\n    const groups = [...new Set(TUNING_DEFS.map((d) => d.group))];\n    if (page === 0) {\n      add('god', god ? 'God mode on' : 'God mode off');\n      add('faster', 'Faster');\n      add('slower', 'Slower');\n      add('fall', 'Force a fall');\n    } else if (page === 1) {\n      add('results', 'Skip to Results');\n      add('ending', 'Skip to Ending');\n      add('bot', botSkill ? 'Bot playing' : 'Let the bot play');\n      add('copy', 'Copy tuning');\n    } else if (page === 2) {\n      add('marbles', 'Add marbles');\n      add('unlock', 'Unlock all');\n      add('age', 'Set a Wobble Age');\n      add('wipe', 'Reset save');\n    } else {\n      const defs = TUNING_DEFS.filter((d) => d.group === groups[(page - 3) % groups.length]);\n      for (const def of defs.slice(0, 4)) add(def.id, `${def.label}: ${getTune(def.id)}`, { kind: 'slider', min: def.min, max: def.max, step: def.step, value: getTune(def.id) });\n    }\n    add('prev', 'Previous page');\n    add('next', 'Next page');\n    add('reset-tune', 'Reset to defaults');\n  }\n\n  function aboutModel(add, lines) {\n    const pages = aboutPages();\n    headingSafe(lines, pages[page % pages.length]);\n    add('prev', 'Previous page');\n    add('next', 'Next page');\n  }\n\n  function headingSafe(lines, block) {\n    for (const line of block) lines.push(line);\n  }\n\n  function journalModel(add, lines) {\n    if (page === 0) lines.push(profile.stamps.map((s) => `Day ${s.day} ${s.name}`).join(' · ') || 'No stamps yet.');\n    else if (page === 1) lines.push(profile.ages.join(' → ') || 'No ages yet.');\n    else lines.push(`Minutes ${profile.minutes.toFixed(1)}. Marbles ${profile.marbles}. Floor exercises ${profile.floor}.`);\n    add('prev', 'Previous page');\n    add('next', 'Next page');\n  }\n\n  function cardModel(lines) {\n    lines.push(TITLE);\n    lines.push('Stay balanced through the class: highest score wins');\n    lines.push('Enter is Ready. M is More time.');\n    const hub = globalThis.AIHub;\n    const players = (hub && hub.players) || [];\n    for (const player of players) lines.push(`${player.name || 'Player'}`);\n  }\n\n  function currentVerbs() {\n    if (screen === 'play' || screen === 'intro') {\n      const Ctor = eventById(eventId);\n      return Ctor && Ctor.verbs ? Ctor.verbs : ['use'];\n    }\n    return ['confirm', 'back'];\n  }\n\n  function formatTime(t) {\n    const s = Math.max(0, Math.floor(t));\n    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;\n  }\n\n  function paint() {\n    if (!ui) return;\n    const view = model();\n    ui.paint(view);\n  }\n\n  function aboutPages() {\n    return [[TITLE], [TAGLINE], ['About'], ['Credits'], ['Fredoka'], ['Three.js'], ['Rapier'], ['Level Best Retreat']];\n  }\n\n  const loop = createLoop(fixed, frame, { scale: () => timeScale });\n  if (!opts.manual) loop.start();\n  if (coarse) screen = 'touch';\n  paint();\n\n  function state() {\n    const lean = event && event.states ? event.states[0] : null;\n    const result = event && event.result ? event.result(0) : null;\n    return {\n      screen: attract ? 'attract' : screen,\n      attract: !!attract,\n      attractSeen: attract ? attract.seen.slice() : [],\n      day: profile.dayIndex + 1,\n      step: profile.doneSteps.length,\n      profile: { ...profile, doneSteps: profile.doneSteps.slice(), met: profile.met.slice(), ages: profile.ages.slice(), stamps: profile.stamps.slice() },\n      marbles: profile.marbles,\n      tilt: tiltRad(),\n      detune: detuneCents(tiltRad(), 0),\n      wobbleAge: profile.ages[profile.ages.length - 1] || null,\n      event: event ? {\n        id: eventId, tier, phase: event.phase ? (typeof event.phase === 'function' ? event.phase()?.id : event.phase) : screen,\n        t: event.t || 0, score: result ? result.form : 0,\n        lanes: (event.states || []).map((st, i) => ({\n          kind: event.lanes[i]?.kind || 'local', leanX: st.leanX, leanZ: st.leanZ,\n          cob: event.cob ? event.cob(i) : { x: 0, y: 0 }, fallen: !!st.fallen,\n          form: result && i === 0 ? result.form : 0, props: 0,\n        })),\n      } : null,\n      input: { lastDevice: inputs[0].lastDevice, glyphSet: settings.glyphs },\n      audio: audio.snapshot(),\n      render: { backend, frames, lost },\n      errors: errors.slice(),\n      settings: { ...settings },\n      focus,\n      god, timeScale, levelled: profile.levelled,\n      dev: screen === 'dev',\n      group: group ? { seats: group.seats.map((s) => s && s.name), points: group.points.slice() } : null,\n    };\n  }\n\n  return {\n    state,\n    advance(seconds) {\n      const steps = Math.max(0, Math.round(seconds / FIXED_DT));\n      for (let i = 0; i < steps; i++) fixed(FIXED_DT);\n      frame();\n    },\n    bot(skill, opt) { botSkill = skill; botOpt = opt || {}; },\n    goto(next, args = {}) {\n      if (next === 'dev' && screen !== 'pause' && screen !== 'dev') return false;\n      if (next === 'play' && args.id) { openIntro(args.id); beginCountdown(); setScreen('play'); return true; }\n      if (next === 'pause') { devFromPause = false; paused = true; }\n      setScreen(next);\n      return true;\n    },\n    tuning: { get: getTune, set: setTune, reset: resetTuning, snapshot: tuningSnapshot },\n    settings: {\n      get: () => ({ ...settings }),\n      set(partial) { Object.assign(settings, partial); applySettings(); paint(); },\n    },\n    pads,\n    pad: padAt,\n    key(code, down = true) { if (down) inputs[0].keyDown(code); else inputs[0].keyUp(code); },\n    pointer(x, y, buttons = 0) { inputs[0].pointerMove(x, y, buttons); if (buttons) inputs[0].pointerButtons(buttons, x, y); },\n    setPadSource(fn) { padSource = fn; },\n    setCoarse(on) { coarse = !!on; if (coarse && screen === 'title') setScreen('touch'); if (!coarse && screen === 'touch') setScreen('title'); },\n    setRender(info) { backend = info.backend; lost = info.lost; frames = info.frames; },\n    onFrame(fn) { listeners.add(fn); return () => listeners.delete(fn); },\n    audio,\n    profile,\n    tilt: tiltRad,\n    persist,\n    loop,\n    input: inputs[0],\n    inputs,\n    runStandalone() { audio.play('title'); paint(); },\n    runSession(info) {\n      session = { info, slots: [], slot: -1, parts: [], total: 0, best: 'Attended', lastProgress: -1, lastGhost: -1, sent: false, playT: 0, ghosts: [] };\n      setSessionMode(true);\n      const hub = globalThis.AIHub;\n      const deal = hub.rng('deal');\n      const pool = SESSION_SET.slice();\n      while (session.slots.length < 3 && pool.length) {\n        session.slots.push(pool.splice(Math.floor(deal() * pool.length), 1)[0]);\n      }\n      hub.on('card', () => { screen = 'card'; paint(); });\n      hub.on('start', () => { session.started = true; });\n      hub.on('time-up', () => sendResult());\n      hub.on('end', () => { locked = true; audio.stop(); });\n      hub.on('leave', (msg) => { session.ghosts = session.ghosts.filter((g) => g.id !== msg.id); });\n      hub.on('message', (data) => { if (data && data.t === 'g') session.ghosts.push(data); });\n      const onKey = (e) => {\n        if (locked || session.started) return;\n        if (e.key === 'Enter') hub.answer('ready');\n        if (e.key === 'm' || e.key === 'M') hub.answer('more');\n      };\n      if (opts.window) opts.window.addEventListener('keydown', onKey);\n      screen = 'card';\n      hub.ready();\n      paint();\n    },\n    activate,\n    errors,\n    TITLE,\n  };\n}\n\nfunction clampNum(n, a, b) { return Math.max(a, Math.min(b, n)); }\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3445,"output_tokens":14618,"cache_read_input_tokens":186624,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"8bdd2d98-c117-497a-b36a-95cc99d25072"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-27a22917-f4e7-4779-80b5-b0edfb43496e-107","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"import { TITLE, TAGLINE, SAVE_KEY, FIXED_DT, SEAT_COLOURS } from '../data/config.js';\\nimport { eventById, eventIds } from '../events/index.js';\\nimport { CheckIn } from './checkin.js';\\nimport { medalOf, medalLabel, wobbleAge, marblePayout, tiersOpen } from './score.js';\\nimport { dayPlan, programmeSteps } from '../data/programme.js';\\nimport { restTiltRad, detuneCents } from '../physics/island.js';\\nimport { initRapier } from '../physics/world.js';\\nimport { createInput } from '../input/input.js';\\nimport { makePad, clearPad, writeWish, writeButton, skillOf } from '../input/bot.js';\\nimport { promptFor } from '../input/glyphs.js';\\nimport { getTune, setTune, resetTuning, tuningSnapshot } from '../core/tuning.js';\\nimport { TUNING_DEFS } from '../data/tuning.js';\\nimport { rng, resetRng, setSessionMode } from '../core/rng.js';\\nimport { readSave, writeSave, memoryStorage } from '../core/save.js';\\nimport { createAudio } from '../audio/engine.js';\\nimport { EVENT_TRACK } from '../audio/tracks.js';\\nimport { findLine, takeLine } from '../data/dialogue.js';\\nimport { NAMES, PAINTS, HATS } from '../data/names.js';\\nimport { createLoop } from '../core/loop.js';\\nimport { mountUi } from '../ui/ui.js';\\n\\nconst SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\\nconst ATTRACT = ['fruitHat', 'cairn', 'stepClass', 'plates', 'springboard', 'raft', 'roomService', 'poses'];\\nconst QUESTIONS = [\\n  { ask: 'trudy.question.0', yes: 'trudy.yes.0', no: 'trudy.no.0', kind: 'yes' },\\n  { ask: 'trudy.question.1', yes: 'trudy.yes.1', no: 'trudy.no.1', kind: 'yes' },\\n  { ask: 'trudy.question.2', yes: 'trudy.yes.2', no: 'trudy.no.2', kind: 'yes' },\\n  { ask: 'trudy.question.3', left: 'trudy.left.0', right: 'trudy.right.0', kind: 'side' },\\n];\\n\\nfunction freshProfile() {\\n  return {\\n    name: NAMES[0], paint: 'coral', hat: 'none', nameIndex: 0, paintIndex: 0, hatIndex: 0,\\n    dayIndex: 0, doneSteps: [], met: [], cleared: {}, best: {},\\n    marbles: 0, ages: [], stamps: [], medals: [], minutes: 0, floor: 0,\\n    levelled: false, classDone: [],\\n  };\\n}\\n\\nfunction defaultSettings() {\\n  return {\\n    music: 10, sfx: 80, voice: 80, glyphs: 'playstation', rumble: true,\\n    autoBreathe: false, rhythmOffset: 0, uiScale: 1, ink: 1, reduceShake: false,\\n    difficulty: 'standard',\\n  };\\n}\\n\\nexport async function createGame(opts = {}) {\\n  await initRapier();\\n  const storage = opts.storage || (opts.window && opts.window.localStorage) || memoryStorage();\\n  const doc = opts.document || null;\\n  const audio = createAudio();\\n  const pads = [0, 1, 2, 3].map(() => makePad());\\n  let padSource = () => pads;\\n  const inputs = [0, 1, 2, 3].map((i) => {\\n    const input = createInput();\\n    input.setPadSource(() => padSource());\\n    input.setPadIndex(i);\\n    input.setDevice('pad');\\n    return input;\\n  });\\n  const profile = freshProfile();\\n  const settings = defaultSettings();\\n  const saved = readSave(storage, SAVE_KEY);\\n  if (saved) {\\n    Object.assign(profile, saved.profile);\\n    Object.assign(settings, saved.settings);\\n  }\\n  let screen = 'title';\\n  let focus = 0;\\n  let page = 0;\\n  let idle = 0;\\n  let attract = null;\\n  let event = null;\\n  let eventId = null;\\n  let tier = 1;\\n  let paused = false;\\n  let countLeft = 0;\\n  let speech = null;\\n  let speechLeft = 0;\\n  let pending = null;\\n  let jarLeft = 0;\\n  let jarPay = 0;\\n  let botSkill = null;\\n  let botOpt = {};\\n  let god = false;\\n  let timeScale = 1;\\n  let coarse = !!opts.coarse;\\n  let session = null;\\n  let locked = false;\\n  let errors = [];\\n  let volumeOpen = false;\\n  let devFromPause = false;\\n  let group = null;\\n  let freePick = false;\\n  let lastResult = null;\\n  let copyText = '';\\n  let palette = 'dawn';\\n  let frames = 0;\\n  let backend = 'none';\\n  let lost = null;\\n  const listeners = new Set();\\n  const programme = programmeSteps(eventIds());\\n  let ui = null;\\n  if (doc) {\\n    ui = mountUi(doc, {\\n      activate: (index) => activate(index),\\n      hover: (index) => { focus = index; paint(); },\\n      slide: (id, value) => { setTune(id, value); applySettings(); paint(); },\\n    });\\n  }\\n\\n  function applySettings() {\\n    audio.setGains(settings.music / 100, settings.sfx / 100, settings.voice / 100);\\n    inputs.forEach((input) => input.setRumble(settings.rumble));\\n  }\\n  applySettings();\\n\\n  function persist() {\\n    writeSave(storage, SAVE_KEY, { profile, settings });\\n  }\\n\\n  function tiltRad() {\\n    const rest = getTune('islandRest');\\n    return restTiltRad(profile.doneSteps.length, Math.max(1, programme.length), rest);\\n  }\\n\\n  function talk(speaker, bucket) {\\n    const line = takeLine(speaker, bucket, rng('talk'));\\n    if (!line) return;\\n    speech = { who: speaker === 'stillwater' ? 'Ms. Stillwater' : speaker === 'bolster' ? 'Coach Bolster' : 'Trudy', text: line.text, id: line.id };\\n    const rate = speaker === 'stillwater' ? 7 : speaker === 'bolster' ? 11 : 16;\\n    speechLeft = Math.max(0.8, line.text.length / rate);\\n    audio.say(line.text, speaker === 'guest' ? 'guest' : speaker);\\n  }\\n\\n  function sayId(id) {\\n    const line = findLineById(id);\\n    if (!line) return;\\n    speech = { who: 'Trudy', text: line.text, id: line.id };\\n    speechLeft = Math.max(0.6, line.text.length / 16);\\n    audio.say(line.text, 'trudy');\\n  }\\n\\n  function findLineById(id) {\\n    return findLine(id) ? null : null;\\n  }\\n\\n  function choicesOf() {\\n    return model().choices;\\n  }\\n\\n  function setScreen(next, keepFocus = false) {\\n    screen = next;\\n    if (!keepFocus) focus = 0;\\n    page = 0;\\n    volumeOpen = false;\\n    if (next !== 'play') paused = false;\\n    for (const pad of pads) clearPad(pad);\\n    paint();\\n    persist();\\n  }\\n\\n  function today() {\\n    const plan = dayPlan(profile.dayIndex, eventIds());\\n    if (plan.maintenance) {\\n      const pool = eventIds().slice();\\n      const picked = [];\\n      while (picked.length < 3 && pool.length) {\\n        const i = Math.floor(rng('maintenance') * pool.length);\\n        picked.push(pool.splice(i, 1)[0]);\\n      }\\n      plan.classes = picked;\\n    }\\n    return plan;\\n  }\\n\\n  function tierFor(id) {\\n    if (!freePick && profile.dayIndex < 5) return 1;\\n    const best = profile.best[id] || {};\\n    return tiersOpen(best);\\n  }\\n\\n  function startEvent(id, extra = {}) {\\n    if (event) event.dispose();\\n    const Ctor = id === 'checkin' ? CheckIn : eventById(id);\\n    eventId = id;\\n    tier = extra.tier || (id === 'checkin' ? 1 : tierFor(id));\\n    const lanes = extra.lanes || [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] }];\\n    event = new Ctor({\\n      tier, lanes, seed: extra.seed || 1, session: !!extra.session, god: extra.god || god,\\n      difficulty: settings.difficulty, tests: extra.tests, skill: extra.skill || 'sharp',\\n      label: `${id}-${profile.dayIndex}`,\\n    });\\n    if (event.build) event.build();\\n    audio.play(EVENT_TRACK[id] || 'island');\\n  }\\n\\n  function finishEvent() {\\n    if (!event) return;\\n    const result = event.result(0);\\n    lastResult = result;\\n    profile.minutes += (event.t || 0) / 60;\\n    profile.floor += result.falls || 0;\\n    if (eventId !== 'checkin') {\\n      const form = result.form || 0;\\n      const best = profile.best[eventId] || {};\\n      best[tier] = Math.max(best[tier] || 0, form);\\n      profile.best[eventId] = best;\\n      if (!profile.met.includes(eventId)) profile.met.push(eventId);\\n      if (programme.includes(eventId) && !profile.doneSteps.includes(eventId)) profile.doneSteps.push(eventId);\\n      const first = !profile.cleared[eventId];\\n      jarPay = marblePayout({\\n        seconds: event.t || 0, form, firstClear: first,\\n        perMin: getTune('marblesPerMin'), medalScale: getTune('medalScale'),\\n      });\\n      profile.cleared[eventId] = true;\\n      profile.medals.push({ id: eventId, tier, form, medal: result.medal });\\n      if (!profile.classDone.includes(eventId)) profile.classDone.push(eventId);\\n    }\\n    event.dispose();\\n    event = null;\\n    audio.setTilt(tiltRad());\\n  }\\n\\n  function woke(sample, travel) {\\n    const e = sample.edges;\\n    if (e.confirm || e.back || e.pause || e.hop || e.flail || e.ask || e.up || e.down || e.left || e.right || e.recenter) return true;\\n    if (sample.padConnected && Math.hypot(sample.wish.x, sample.wish.y) > 0.3) return true;\\n    if (travel > 8) return true;\\n    return false;\\n  }\\n\\n  function menuMove(sample) {\\n    const list = choicesOf();\\n    const n = list.length || 1;\\n    if (sample.edges.up) focus = (focus - 1 + n) % n;\\n    if (sample.edges.down) focus = (focus + 1) % n;\\n    if (sample.edges.left || sample.edges.right) nudge(list[focus], sample.edges.right ? 1 : -1);\\n    if (sample.edges.confirm) activate(focus);\\n    if (sample.edges.back) back();\\n  }\\n\\n  function nudge(choice, dir) {\\n    if (!choice) return;\\n    if (choice.kind === 'slider') {\\n      const def = TUNING_DEFS.find((d) => d.id === choice.id);\\n      if (def) setTune(choice.id, getTune(choice.id) + dir * def.step);\\n      return;\\n    }\\n    if (choice.id === 'music') settings.music = clampNum(settings.music + dir * 5, 0, 100);\\n    if (choice.id === 'sfx') settings.sfx = clampNum(settings.sfx + dir * 5, 0, 100);\\n    if (choice.id === 'voice') settings.voice = clampNum(settings.voice + dir * 5, 0, 100);\\n    if (choice.id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n    if (choice.id === 'difficulty') {\\n      const order = ['gentle', 'standard', 'honest'];\\n      const i = order.indexOf(settings.difficulty);\\n      settings.difficulty = order[(i + (dir > 0 ? 1 : 2)) % 3];\\n    }\\n    if (choice.id === 'name') profile.nameIndex = (profile.nameIndex + (dir > 0 ? 1 : NAMES.length - 1)) % NAMES.length;\\n    if (choice.id === 'paint') profile.paintIndex = (profile.paintIndex + (dir > 0 ? 1 : PAINTS.length - 1)) % PAINTS.length;\\n    if (choice.id === 'hat') profile.hatIndex = (profile.hatIndex + (dir > 0 ? 1 : HATS.length - 1)) % HATS.length;\\n    if (choice.id === 'page') page = Math.max(0, page + dir);\\n    applySettings();\\n  }\\n\\n  function activate(index) {\\n    const list = choicesOf();\\n    const choice = list[index];\\n    if (!choice || choice.kind === 'slider') return;\\n    focus = index;\\n    audio.unlock();\\n    audio.sfx('uiConfirm');\\n    const id = choice.id;\\n    if (screen === 'title') return setScreen(profile.stamps.length || profile.dayIndex > 0 ? 'menu' : 'who');\\n    if (screen === 'touch') return setScreen('settings');\\n    if (screen === 'who' && id === 'begin') {\\n      profile.name = NAMES[profile.nameIndex];\\n      profile.paint = PAINTS[profile.paintIndex].id;\\n      profile.hat = HATS[profile.hatIndex].id;\\n      return setScreen('tutorial');\\n    }\\n    if (screen === 'tutorial' && id === 'on') return beginDay();\\n    if (screen === 'menu') {\\n      if (id === 'programme') return profile.classDone.length ? setScreen('plan') : beginDay();\\n      if (id === 'group') { group = { seats: [null, null, null, null], points: [0, 0, 0, 0], playlist: [], cursor: 0 }; return setScreen('group'); }\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      if (id === 'journal') return setScreen('journal');\\n      if (id === 'settings') return setScreen('settings');\\n      if (id === 'about') return setScreen('about');\\n    }\\n    if (screen === 'question') return answerQuestion(id);\\n    if (screen === 'reply') return setScreen('checkinPlay');\\n    if (screen === 'age') return setScreen('plan');\\n    if (screen === 'plan' && eventById(id)) return openIntro(id);\\n    if (screen === 'intro') return beginCountdown();\\n    if (screen === 'results') {\\n      if (id === 'retry') return openIntro(eventId);\\n      return afterResult();\\n    }\\n    if (screen === 'jar') return afterJar();\\n    if (screen === 'bed') {\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      return sleepDay();\\n    }\\n    if (screen === 'ending') return setScreen(pageOfEnding());\\n    if (screen === 'credits') { sleepDay(); return setScreen('menu'); }\\n    if (screen === 'pause') return pauseAction(id);\\n    if (screen === 'settings') return settingsAction(id);\\n    if (screen === 'dev') return devAction(id);\\n    if (screen === 'free' && eventById(id)) return openIntro(id);\\n    if (screen === 'group') return groupAction(id);\\n    if (screen === 'confirm-reset' && id === 'yes') { resetAll(); return setScreen('title'); }\\n    if (screen === 'confirm-reset') return setScreen('settings');\\n    if (screen === 'island') {\\n      if (id === 'plan') return setScreen('plan');\\n      if (id === 'bed') return setScreen('bed');\\n      if (id === 'menu') return setScreen('menu');\\n    }\\n    paint();\\n  }\\n\\n  function pageOfEnding() {\\n    if (screen === 'ending') return 'credits';\\n    return 'credits';\\n  }\\n\\n  function beginDay() {\\n    freePick = false;\\n    profile.classDone = [];\\n    talk('trudy', 'morning');\\n    setScreen('morning');\\n  }\\n\\n  function answerQuestion(id) {\\n    const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\\n    const key = id === 'yes' ? q.yes : id === 'no' ? q.no : id === 'left' ? q.left : q.right;\\n    const line = lookup(key);\\n    speech = { who: 'Trudy', text: line ? line.text : 'Noted.', id: key };\\n    speechLeft = 1.2;\\n    if (line) audio.say(line.text, 'trudy');\\n    setScreen('reply');\\n  }\\n\\n  function openIntro(id) {\\n    eventId = id;\\n    tier = tierFor(id);\\n    setScreen('intro');\\n  }\\n\\n  function beginCountdown() {\\n    const plan = today();\\n    startEvent(eventId, {\\n      tests: eventId === 'checkin' ? plan.tests : undefined,\\n      god: screen === 'attract',\\n    });\\n    if (eventId === 'checkin') {\\n      screen = 'checkinPlay';\\n      return;\\n    }\\n    countLeft = 3;\\n    setScreen('countdown');\\n  }\\n\\n  function afterResult() {\\n    if (eventId === 'checkin') return;\\n    profile.marbles += jarPay;\\n    jarLeft = 2;\\n    audio.sfx('marble');\\n    setScreen('jar');\\n  }\\n\\n  function afterJar() {\\n    if (profile.levelled && eventId === 'grandHold') {\\n      sayExact(\\\"Oh. So that's what the middle looks like.\\\");\\n      return setScreen('ending');\\n    }\\n    const plan = today();\\n    const pendingClass = plan.classes.filter((id) => !profile.classDone.includes(id));\\n    if (group && group.playlist) return scoreGroup();\\n    if (pendingClass.length && !freePick) return setScreen('plan');\\n    if (freePick) return setScreen('free');\\n    return setScreen('bed');\\n  }\\n\\n  function sleepDay() {\\n    const plan = today();\\n    profile.stamps.push({ day: profile.dayIndex + 1, name: plan.name });\\n    profile.dayIndex += 1;\\n    profile.classDone = [];\\n    palette = 'dawn';\\n    persist();\\n  }\\n\\n  function scoreGroup() {\\n    if (!group) return setScreen('menu');\\n    const forms = lastResult && lastResult.forms ? lastResult.forms : group.seats.map((s, i) => (s ? (i === 0 ? lastResult.form : 0) : -1));\\n    const ranked = forms.map((form, i) => ({ i, form })).filter((row) => row.form >= 0).sort((a, b) => b.form - a.form);\\n    const points = [4, 3, 2, 1];\\n    ranked.forEach((row, place) => { group.points[row.i] += points[place] || 1; });\\n    group.cursor += 1;\\n    if (group.cursor >= group.playlist.length) return setScreen('podium');\\n    openIntro(group.playlist[group.cursor]);\\n  }\\n\\n  function back() {\\n    if (screen === 'settings' || screen === 'about' || screen === 'journal' || screen === 'free' || screen === 'group' || screen === 'mirror') return setScreen('menu');\\n    if (screen === 'dev') return setScreen('pause');\\n    if (screen === 'pause') { paused = false; return setScreen('play'); }\\n    if (screen === 'plan' || screen === 'island') return setScreen('menu');\\n    if (screen === 'who') return setScreen('title');\\n  }\\n\\n  function pauseAction(id) {\\n    if (id === 'resume') { paused = false; return setScreen('play'); }\\n    if (id === 'restart') { openIntro(eventId); return; }\\n    if (id === 'howto') return setScreen('howto');\\n    if (id === 'settings') return setScreen('settings');\\n    if (id === 'dev') { devFromPause = true; return setScreen('dev'); }\\n    if (id === 'leave') {\\n      if (event) event.dispose();\\n      event = null;\\n      return setScreen('island');\\n    }\\n  }\\n\\n  function settingsAction(id) {\\n    if (id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n    if (id === 'rumble') settings.rumble = !settings.rumble;\\n    if (id === 'breathe') settings.autoBreathe = !settings.autoBreathe;\\n    if (id === 'shake') settings.reduceShake = !settings.reduceShake;\\n    if (id === 'full') {\\n      const el = doc && doc.documentElement;\\n      if (el && el.requestFullscreen) el.requestFullscreen().catch(() => {});\\n    }\\n    if (id === 'reset') return setScreen('confirm-reset');\\n    if (id === 'next') page = (page + 1) % 4;\\n    if (id === 'prev') page = (page + 3) % 4;\\n    applySettings();\\n    paint();\\n  }\\n\\n  function devAction(id) {\\n    if (!devFromPause && screen !== 'dev') return;\\n    if (id === 'reset-tune') resetTuning();\\n    if (id === 'god') god = !god;\\n    if (id === 'faster') timeScale = Math.min(4, timeScale * 2);\\n    if (id === 'slower') timeScale = Math.max(0.1, timeScale / 2);\\n    if (id === 'step' && event) event.fixed(FIXED_DT, [inputs[0].snapshot(0)]);\\n    if (id === 'fall' && event && event.beginFall) event.beginFall(0);\\n    if (id === 'results') { finishEvent(); return setScreen('results'); }\\n    if (id === 'ending') {\\n      profile.doneSteps = programme.slice();\\n      profile.levelled = true;\\n      profile.met = eventIds();\\n      sayExact(\\\"Oh. So that's what the middle looks like.\\\");\\n      return setScreen('ending');\\n    }\\n    if (id === 'marbles') profile.marbles += 10;\\n    if (id === 'unlock') profile.met = eventIds();\\n    if (id === 'age') profile.ages.push(41);\\n    if (id === 'bot') botSkill = botSkill ? null : 'sharp';\\n    if (id === 'copy') copyText = JSON.stringify(tuningSnapshot());\\n    if (id === 'wipe') return setScreen('confirm-reset');\\n    if (id === 'next') page += 1;\\n    if (id === 'prev') page = Math.max(0, page - 1);\\n    if (id.startsWith('jump-')) {\\n      devFromPause = true;\\n      return openIntro(id.slice(5));\\n    }\\n    paint();\\n  }\\n\\n  function groupAction(id) {\\n    if (id === 'quick' || id === 'raft' || eventById(id)) {\\n      const couch = eventIds().filter((eid) => eventById(eid).couch);\\n      const playlist = id === 'quick' ? pickSome(couch, 3) : [id === 'raft' ? 'raft' : id];\\n      group.playlist = playlist;\\n      group.cursor = 0;\\n      const lanes = group.seats.map((seat, i) => seat ? ({\\n        id: i, kind: 'local', name: seat.name, colour: SEAT_COLOURS[i],\\n      }) : null).filter(Boolean);\\n      if (!lanes.length) lanes.push({ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] });\\n      group.lanes = lanes;\\n      return openIntro(playlist[0]);\\n    }\\n    if (id === 'back') return setScreen('menu');\\n  }\\n\\n  function pickSome(list, n) {\\n    const pool = list.slice();\\n    const out = [];\\n    while (out.length < n && pool.length) out.push(pool.splice(Math.floor(rng('group') * pool.length), 1)[0]);\\n    return out;\\n  }\\n\\n  function resetAll() {\\n    const next = freshProfile();\\n    Object.keys(profile).forEach((k) => delete profile[k]);\\n    Object.assign(profile, next);\\n    Object.assign(settings, defaultSettings());\\n    resetTuning();\\n    try { storage.removeItem(SAVE_KEY); } catch { /* memory store */ }\\n  }\\n\\n  function sayExact(text) {\\n    speech = { who: 'Trudy', text, id: 'exact' };\\n    speechLeft = Math.max(1, text.length / 16);\\n    audio.say(text, 'trudy');\\n  }\\n\\n  function lookup(id) {\\n    const { lineById } = dialogueApi();\\n    return lineById(id);\\n  }\\n\\n  function dialogueApi() {\\n    return import('../data/dialogue.js');\\n  }\\n\\n  function driveBots(dt) {\\n    if (!event || !botSkill) return null;\\n    const skill = skillOf(botSkill);\\n    const snaps = [];\\n    const count = event.lanes.length;\\n    for (let i = 0; i < count; i++) {\\n      const cmd = event.botInput(i, skill, botOpt) || {};\\n      const pad = padAt(i);\\n      clearPad(pad);\\n      writeWish(pad, cmd.x || 0, cmd.y || 0);\\n      writeButton(pad, 0, !!cmd.hop);\\n      writeButton(pad, 2, !!cmd.flail);\\n      writeButton(pad, 5, !!(cmd.breathe || (settings.autoBreathe && screen === 'play')));\\n      writeButton(pad, 6, (cmd.feetL || 0) > 0, cmd.feetL || 0);\\n      writeButton(pad, 7, (cmd.feetR || 0) > 0, cmd.feetR || 0);\\n      const input = inputs[i];\\n      if (cmd.plateA) input.keyDown('KeyA');\\n      if (cmd.plateD) input.keyDown('KeyD');\\n      input.poll(dt, 'balance');\\n      if (cmd.plateA) input.keyUp('KeyA');\\n      if (cmd.plateD) input.keyUp('KeyD');\\n      snaps.push(input.snapshot(0));\\n    }\\n    return snaps;\\n  }\\n\\n  function padAt(i) {\\n    const list = padSource() || pads;\\n    return list[i] || pads[i];\\n  }\\n\\n  function fixed(dt) {\\n    if (locked) return;\\n    audio.setTilt(tiltRad());\\n    if (session) return sessionFixed(dt);\\n    const input = inputs[0];\\n    const before = input.takeTravel ? 0 : 0;\\n    const playing = screen === 'play' || screen === 'checkinPlay' || attract;\\n    if (playing && botSkill) {\\n      const snaps = driveBots(dt);\\n      if (!paused && event) stepEvent(dt, snaps);\\n      noteNotch();\\n      return;\\n    }\\n    const sample = input.poll(dt, playing ? 'balance' : 'menu');\\n    const travel = input.takeTravel();\\n    if (attract) {\\n      if (woke(sample, travel)) { stopAttract(true); return; }\\n      stepAttract(dt);\\n      return;\\n    }\\n    if (screen === 'title' || screen === 'menu' || screen === 'touch') {\\n      if (woke(sample, travel)) idle = 0;\\n      else idle += dt;\\n      if (idle >= 10) { startAttract(); return; }\\n    } else idle = 0;\\n    if (sample.edges.pause && (screen === 'play' || screen === 'checkinPlay') && !sample.createHeld) {\\n      paused = true;\\n      return setScreen('pause');\\n    }\\n    if ((screen === 'play' || screen === 'checkinPlay') && !paused) {\\n      const snaps = [];\\n      const n = event ? event.lanes.length : 1;\\n      snaps.push(sampleToSnap(sample, input));\\n      for (let i = 1; i < n; i++) {\\n        const extra = inputs[i].poll(dt, 'balance');\\n        snaps.push(sampleToSnap(extra, inputs[i]));\\n      }\\n      joinPads(sample);\\n      stepEvent(dt, snaps);\\n      noteNotch();\\n      if (event && event.done) {\\n        finishEvent();\\n        if (eventId === 'checkin') revealAge();\\n        else setScreen('results');\\n      }\\n      return;\\n    }\\n    if (screen === 'countdown') {\\n      countLeft -= dt;\\n      if (countLeft <= 0) setScreen('play');\\n      return;\\n    }\\n    if (screen === 'morning') {\\n      speechLeft -= dt;\\n      if (sample.edges.confirm || speechLeft <= 0) openQuestion();\\n      return;\\n    }\\n    if (screen === 'jar') {\\n      jarLeft -= dt;\\n      if (sample.edges.confirm || jarLeft <= 0) afterJar();\\n      return;\\n    }\\n    if (speechLeft > 0) speechLeft -= dt;\\n    if (!playing) menuMove(sample);\\n    void before;\\n  }\\n\\n  function sampleToSnap(sample, input) {\\n    return input.snapshot(0);\\n  }\\n\\n  function stepEvent(dt, snaps) {\\n    if (!event || paused) return;\\n    event.fixed(dt, snaps || []);\\n    if (event.frame) event.frame(dt);\\n  }\\n\\n  function noteNotch() {\\n    if (event && event.notch && !profile.doneSteps.includes('grandHold')) {\\n      profile.doneSteps.push('grandHold');\\n      profile.levelled = profile.doneSteps.length >= programme.length;\\n      if (!profile.met.includes('grandHold')) profile.met.push('grandHold');\\n      audio.sfx('creak');\\n    }\\n    if (profile.doneSteps.length >= programme.length) profile.levelled = true;\\n  }\\n\\n  function revealAge() {\\n    const mean = lastResult.mean || 0;\\n    const age = wobbleAge(mean, Math.min(4, profile.dayIndex));\\n    profile.ages.push(age);\\n    profile.marbles += 1;\\n    sayExact(`Your Wobble Age is ${age}.`);\\n    setScreen('age');\\n  }\\n\\n  function openQuestion() {\\n    setScreen('question');\\n  }\\n\\n  function startAttract() {\\n    attract = { index: 0, left: 18, between: 0, seen: [] };\\n    idle = 0;\\n    botSkill = 'sharp';\\n    launchAttract();\\n  }\\n\\n  function launchAttract() {\\n    const id = ATTRACT[attract.index % ATTRACT.length];\\n    if (!attract.seen.includes(id)) attract.seen.push(id);\\n    startEvent(id, { god: id !== 'fruitHat', lanes: [{ id: 0, kind: 'bot', name: 'Demo', colour: SEAT_COLOURS[1] }] });\\n    botOpt = id === 'fruitHat' ? { bankAt: 99 } : {};\\n    screen = 'play';\\n  }\\n\\n  function stepAttract(dt) {\\n    if (!attract) return;\\n    if (attract.between > 0) {\\n      attract.between -= dt;\\n      screen = 'title';\\n      if (attract.between <= 0) launchAttract();\\n      return;\\n    }\\n    const snaps = driveBots(dt);\\n    if (event) stepEvent(dt, snaps);\\n    attract.left -= dt;\\n    if (!event || event.done || attract.left <= 0) {\\n      if (event) { event.dispose(); event = null; }\\n      attract.index += 1;\\n      attract.left = 18;\\n      if (attract.index % ATTRACT.length === 0) {\\n        attract.between = 5;\\n        screen = 'title';\\n        botSkill = null;\\n      } else launchAttract();\\n    }\\n  }\\n\\n  function stopAttract(swallow) {\\n    if (event) { event.dispose(); event = null; }\\n    attract = null;\\n    botSkill = null;\\n    botOpt = {};\\n    idle = 0;\\n    for (const pad of pads) clearPad(pad);\\n    screen = coarse ? 'touch' : 'title';\\n    if (swallow) paint();\\n  }\\n\\n  function joinPads(sample) {\\n    if (screen !== 'group' || !group) return;\\n    for (let i = 0; i < 4; i++) {\\n      const pad = padAt(i);\\n      if (pad && pad.buttons[0] && pad.buttons[0].pressed && !group.seats[i]) {\\n        group.seats[i] = { name: `Player ${i + 1}`, device: 'pad' };\\n      }\\n      if (pad && pad.buttons[1] && pad.buttons[1].pressed) group.seats[i] = null;\\n    }\\n    if (sample.edges.confirm && !group.seats.some((s) => s && s.device === 'key')) {\\n      const slot = group.seats.findIndex((s) => !s);\\n      if (slot >= 0) group.seats[slot] = { name: profile.name, device: 'key' };\\n    }\\n  }\\n\\n  function sessionFixed(dt) {\\n    const hub = globalThis.AIHub;\\n    if (!hub) return;\\n    const ms = hub.time();\\n    if (!Number.isFinite(ms)) {\\n      screen = 'card';\\n      return;\\n    }\\n    const t = ms / 1000;\\n    if (t < 0) {\\n      screen = 'countdown';\\n      countLeft = Math.max(0, -t);\\n      return;\\n    }\\n    const slot = Math.min(session.slots.length, Math.floor(t / 62));\\n    const local = t - slot * 62;\\n    if (slot >= session.slots.length) {\\n      screen = 'waiting';\\n      sendResult();\\n      return;\\n    }\\n    if (session.slot !== slot) {\\n      session.slot = slot;\\n      session.playT = 0;\\n      if (event) event.dispose();\\n      event = null;\\n      eventId = session.slots[slot];\\n    }\\n    if (local < 6) {\\n      screen = 'intro';\\n      session.scoreShown = session.total;\\n    } else if (local < 56) {\\n      if (!event) {\\n        startEvent(eventId, { session: true, lanes: [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[hub.me || 0] }] });\\n        screen = 'play';\\n      }\\n      const input = inputs[0];\\n      const snaps = botSkill ? driveBots(dt) : [input.snapshot(0)];\\n      if (!botSkill) input.poll(dt, 'balance');\\n      stepEvent(dt, snaps);\\n      session.playT += dt;\\n      if (event && (event.done || local >= 55.9)) {\\n        const result = event.result(0);\\n        session.parts.push(Math.round((result.form || 0) * 10));\\n        session.total = session.parts.reduce((a, b) => a + b, 0);\\n        session.best = medalLabel(result.medal || 'attended');\\n        event.dispose();\\n        event = null;\\n        screen = 'results';\\n      } else screen = 'play';\\n    } else screen = 'results';\\n    if (t - session.lastProgress >= 1 || session.lastProgress < 0) {\\n      const label = `${eventTitle(session.slots[slot])} ${session.slot === 0 && local < 6 ? 0 : session.total}`.slice(0, 24);\\n      const score = session.slot === 0 && local < 6 ? 0 : session.total;\\n      hub.progress({ score, label });\\n      session.lastProgress = t;\\n    }\\n    if (t - session.lastGhost >= 0.1) {\\n      const lean = event && event.states ? event.states[0] : { leanX: 0, leanZ: 0, fallen: false };\\n      hub.send({\\n        t: 'g', a: slot, x: 0, z: 0,\\n        lx: Number((lean.leanX || 0).toFixed(3)),\\n        lz: Number((lean.leanZ || 0).toFixed(3)),\\n        c: 0, f: lean.fallen ? 1 : 0, s: session.total,\\n      }, { reliable: false });\\n      session.lastGhost = t;\\n    }\\n    void dt;\\n  }\\n\\n  function sendResult() {\\n    const hub = globalThis.AIHub;\\n    if (!session || session.sent || !hub) return;\\n    session.sent = true;\\n    const score = session.total || 0;\\n    hub.result({\\n      score,\\n      stats: { 'Floor Exercises': profile.floor, 'Best medal': session.best || 'Attended', 'Wobble Age': profile.ages[0] || 41 },\\n      awards: score >= 2500 ? ['Suspiciously Still'] : ['Showed Up'],\\n    });\\n  }\\n\\n  function eventTitle(id) {\\n    const Ctor = eventById(id);\\n    return Ctor ? Ctor.title : 'Class';\\n  }\\n\\n  function frame() {\\n    frames += 1;\\n    if (!locked) audio.tick();\\n    for (const fn of listeners) fn();\\n    paint();\\n  }\\n\\n  function model() {\\n    const device = inputs[0].lastDevice;\\n    const prompts = promptFor(currentVerbs(), device, settings.glyphs);\\n    const lines = [];\\n    const choices = [];\\n    let heading = '';\\n    const add = (id, label, extra = {}) => choices.push({ id, label, index: choices.length, focus: choices.length === focus, ...extra });\\n    if (coarse && screen === 'title') screen = 'touch';\\n    if (screen === 'touch') {\\n      lines.push('Controller or keyboard required');\\n      lines.push(TAGLINE);\\n      add('settings', 'Settings');\\n    } else if (screen === 'title' || (attract && attract.between > 0)) {\\n      lines.push(TAGLINE);\\n      lines.push('Press to begin');\\n      add('begin', 'Begin');\\n    } else if (screen === 'who') {\\n      heading = \\\"Who's here?\\\";\\n      add('name', `Name: ${NAMES[profile.nameIndex]}`);\\n      add('paint', `Paint: ${PAINTS[profile.paintIndex].id}`);\\n      add('hat', `Hat: ${HATS[profile.hatIndex].label}`);\\n      add('begin', 'Begin');\\n    } else if (screen === 'tutorial') {\\n      heading = 'How a day works';\\n      lines.push('You can lean, step, hop, and flail. You cannot type a name.');\\n      lines.push('Flail is a short save with a cooldown. It is not a free win.');\\n      add('on', 'Step on');\\n    } else if (screen === 'menu') {\\n      heading = 'Level Best Retreat';\\n      const cont = profile.dayIndex > 0 || profile.classDone.length ? 'Continue' : 'Programme';\\n      add('programme', cont);\\n      add('group', 'Group Class');\\n      add('free', 'Free Play');\\n      add('journal', 'Journal');\\n      add('settings', 'Settings');\\n      add('about', 'About / Credits');\\n    } else if (screen === 'morning') {\\n      heading = today().name;\\n      lines.push(speech ? speech.text : 'Good morning.');\\n      add('on', 'Continue');\\n    } else if (screen === 'question') {\\n      const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\\n      const line = lookup(q.ask);\\n      heading = 'A small question';\\n      lines.push(line ? line.text : 'Do you trust your knees?');\\n      if (q.kind === 'side') { add('left', 'Left'); add('right', 'Right'); }\\n      else { add('yes', 'Yes'); add('no', 'No'); }\\n    } else if (screen === 'reply') {\\n      heading = 'Trudy';\\n      lines.push(speech ? speech.text : 'Noted.');\\n      add('on', 'To the mat');\\n    } else if (screen === 'age') {\\n      heading = 'Wobble Age';\\n      lines.push(String(profile.ages[profile.ages.length - 1] || ''));\\n      lines.push('I did not ask how old you are. I asked your knees.');\\n      add('on', 'See the plan');\\n    } else if (screen === 'plan') {\\n      heading = today().name;\\n      const classes = today().classes;\\n      for (const id of classes) add(id, `${eventTitle(id)}${profile.classDone.includes(id) ? ' — stamped' : ''}`);\\n      if (!classes.length) lines.push('The day is open.');\\n    } else if (screen === 'intro') {\\n      const Ctor = eventById(eventId);\\n      heading = Ctor ? Ctor.title : 'Class';\\n      lines.push(Ctor ? Ctor.can : '');\\n      lines.push(Ctor ? Ctor.cant : '');\\n      add('go', 'Begin');\\n    } else if (screen === 'countdown') {\\n      heading = String(Math.max(1, Math.ceil(countLeft)));\\n      lines.push('Hold still.');\\n    } else if (screen === 'play' || screen === 'checkinPlay') {\\n      heading = eventTitle(eventId);\\n    } else if (screen === 'results') {\\n      heading = lastResult ? medalLabel(lastResult.medal) : 'Attended';\\n      lines.push(lastResult ? lastResult.stats : '');\\n      lines.push(lastResult ? `Form ${Math.round(lastResult.form)}` : '');\\n      add('continue', 'Continue');\\n      add('retry', 'Retry');\\n    } else if (screen === 'jar') {\\n      heading = 'The jar';\\n      lines.push(`+${jarPay} marbles. The jar has ${profile.marbles}.`);\\n      add('on', 'Continue');\\n    } else if (screen === 'bed') {\\n      heading = 'Bed hut';\\n      lines.push('The stamp is ready.');\\n      add('bed', 'Sleep');\\n      add('free', 'Free Play');\\n    } else if (screen === 'ending') {\\n      heading = 'Level';\\n      lines.push(\\\"Oh. So that's what the middle looks like.\\\");\\n      add('on', 'Listen');\\n    } else if (screen === 'credits') {\\n      heading = 'Credits';\\n      lines.push(\\\"It's quite flat, isn't it? ...Same time tomorrow?\\\");\\n      add('on', 'Same time tomorrow');\\n    } else if (screen === 'pause') {\\n      heading = 'Paused';\\n      ['resume', 'restart', 'howto', 'settings', 'dev', 'leave'].forEach((id) => add(id, {\\n        resume: 'Resume', restart: 'Restart', howto: 'How to Play', settings: 'Settings', dev: 'Dev Mode', leave: 'Leave Class',\\n      }[id]));\\n    } else if (screen === 'howto') {\\n      heading = 'How to Play';\\n      lines.push('Lean with the stick, the keys, or the mouse. Feet are the triggers.');\\n      lines.push('You cannot win by flailing on cooldown.');\\n      add('back', 'Back');\\n    } else if (screen === 'settings') settingsModel(add, lines);\\n    else if (screen === 'dev') devModel(add, lines);\\n    else if (screen === 'about') aboutModel(add, lines);\\n    else if (screen === 'journal') journalModel(add, lines);\\n    else if (screen === 'free') {\\n      heading = 'Free Play';\\n      const ids = (profile.levelled ? eventIds() : profile.met);\\n      const slice = ids.slice(page * 4, page * 4 + 4);\\n      slice.forEach((id) => add(id, eventTitle(id)));\\n      if (ids.length > 4) add('page', 'More');\\n      if (!slice.length) lines.push('Meet a class first. The pavilions keep.');\\n    } else if (screen === 'group') {\\n      heading = 'Group Class';\\n      lines.push(group.seats.map((s, i) => s ? `${i + 1} ${s.name}` : `${i + 1} empty`).join('  '));\\n      add('quick', 'Quick Class');\\n      add('raft', 'Tippy Raft');\\n      add('back', 'Back');\\n    } else if (screen === 'podium') {\\n      heading = 'Podium';\\n      lines.push(group.points.map((p, i) => `Seat ${i + 1}: ${p}`).join('  '));\\n      add('back', 'Back to the island');\\n    } else if (screen === 'island') {\\n      heading = 'The island';\\n      lines.push(speech ? speech.text : 'Trudy is here.');\\n      add('plan', \\\"Today's Plan\\\");\\n      add('bed', 'Bed hut');\\n      add('menu', 'Menu');\\n    } else if (screen === 'card') cardModel(lines);\\n    else if (screen === 'waiting') {\\n      heading = 'Waiting for the others';\\n      lines.push('Trudy is keeping the clipboard shut.');\\n    } else if (screen === 'confirm-reset') {\\n      heading = 'Reset the save?';\\n      lines.push('The jar will be empty again.');\\n      add('yes', 'Yes, reset');\\n      add('no', 'No');\\n    } else if (screen === 'boot') {\\n      lines.push('Stretching...');\\n    }\\n    if (attract && screen === 'play') lines.push('DEMO · Press any button');\\n    if (copyText && screen === 'dev') lines.push(copyText);\\n    const cob = event && event.cob ? event.cob(0) : { x: 0, y: 0 };\\n    return {\\n      screen: attract ? 'attract' : screen,\\n      gameTitle: TITLE,\\n      heading,\\n      lines,\\n      choices: choices.slice(0, 6),\\n      page: pageLabel(),\\n      prompts,\\n      speech: speech && (screen === 'play' || screen === 'morning') ? speech : null,\\n      hud: (screen === 'play' || screen === 'checkinPlay') && event ? {\\n        time: formatTime(event.t || 0),\\n        score: String(Math.round((event.result ? event.result(0).form : 0) || 0)),\\n      } : null,\\n      disc: (screen === 'play' || screen === 'checkinPlay') ? { x: cob.x || 0, y: cob.y || 0 } : null,\\n      attract: !!attract,\\n    };\\n  }\\n\\n  function pageLabel() {\\n    if (screen === 'settings') return `Page ${page + 1} of 4`;\\n    if (screen === 'about') return `Page ${page + 1} of 8`;\\n    if (screen === 'journal') return `Page ${page + 1}`;\\n    if (screen === 'dev') return `Page ${page + 1}`;\\n    return '';\\n  }\\n\\n  function settingsModel(add, lines) {\\n    const pages = [\\n      () => { add('music', `Music: ${settings.music}`); add('sfx', `Sound: ${settings.sfx}`); add('voice', `Voice: ${settings.voice}`); },\\n      () => { add('glyphs', `Glyphs: ${settings.glyphs}`); add('rumble', `Rumble: ${settings.rumble ? 'on' : 'off'}`); add('breathe', `Auto-breathe: ${settings.autoBreathe ? 'on' : 'off'}`); },\\n      () => { add('shake', `Reduce shake: ${settings.reduceShake ? 'on' : 'off'}`); add('full', 'Fullscreen'); lines.push(`Ink ${settings.ink}`); },\\n      () => { add('difficulty', `Difficulty: ${settings.difficulty}`); add('reset', 'Reset save'); },\\n    ];\\n    pages[page % 4]();\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n  }\\n\\n  function devModel(add, lines) {\\n    lines.push(`Time scale ${timeScale}. God ${god ? 'on' : 'off'}.`);\\n    const groups = [...new Set(TUNING_DEFS.map((d) => d.group))];\\n    if (page === 0) {\\n      add('god', god ? 'God mode on' : 'God mode off');\\n      add('faster', 'Faster');\\n      add('slower', 'Slower');\\n      add('fall', 'Force a fall');\\n    } else if (page === 1) {\\n      add('results', 'Skip to Results');\\n      add('ending', 'Skip to Ending');\\n      add('bot', botSkill ? 'Bot playing' : 'Let the bot play');\\n      add('copy', 'Copy tuning');\\n    } else if (page === 2) {\\n      add('marbles', 'Add marbles');\\n      add('unlock', 'Unlock all');\\n      add('age', 'Set a Wobble Age');\\n      add('wipe', 'Reset save');\\n    } else {\\n      const defs = TUNING_DEFS.filter((d) => d.group === groups[(page - 3) % groups.length]);\\n      for (const def of defs.slice(0, 4)) add(def.id, `${def.label}: ${getTune(def.id)}`, { kind: 'slider', min: def.min, max: def.max, step: def.step, value: getTune(def.id) });\\n    }\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n    add('reset-tune', 'Reset to defaults');\\n  }\\n\\n  function aboutModel(add, lines) {\\n    const pages = aboutPages();\\n    headingSafe(lines, pages[page % pages.length]);\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n  }\\n\\n  function headingSafe(lines, block) {\\n    for (const line of block) lines.push(line);\\n  }\\n\\n  function journalModel(add, lines) {\\n    if (page === 0) lines.push(profile.stamps.map((s) => `Day ${s.day} ${s.name}`).join(' · ') || 'No stamps yet.');\\n    else if (page === 1) lines.push(profile.ages.join(' → ') || 'No ages yet.');\\n    else lines.push(`Minutes ${profile.minutes.toFixed(1)}. Marbles ${profile.marbles}. Floor exercises ${profile.floor}.`);\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n  }\\n\\n  function cardModel(lines) {\\n    lines.push(TITLE);\\n    lines.push('Stay balanced through the class: highest score wins');\\n    lines.push('Enter is Ready. M is More time.');\\n    const hub = globalThis.AIHub;\\n    const players = (hub && hub.players) || [];\\n    for (const player of players) lines.push(`${player.name || 'Player'}`);\\n  }\\n\\n  function currentVerbs() {\\n    if (screen === 'play' || screen === 'intro') {\\n      const Ctor = eventById(eventId);\\n      return Ctor && Ctor.verbs ? Ctor.verbs : ['use'];\\n    }\\n    return ['confirm', 'back'];\\n  }\\n\\n  function formatTime(t) {\\n    const s = Math.max(0, Math.floor(t));\\n    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;\\n  }\\n\\n  function paint() {\\n    if (!ui) return;\\n    const view = model();\\n    ui.paint(view);\\n  }\\n\\n  function aboutPages() {\\n    return [[TITLE], [TAGLINE], ['About'], ['Credits'], ['Fredoka'], ['Three.js'], ['Rapier'], ['Level Best Retreat']];\\n  }\\n\\n  const loop = createLoop(fixed, frame, { scale: () => timeScale });\\n  if (!opts.manual) loop.start();\\n  if (coarse) screen = 'touch';\\n  paint();\\n\\n  function state() {\\n    const lean = event && event.states ? event.states[0] : null;\\n    const result = event && event.result ? event.result(0) : null;\\n    return {\\n      screen: attract ? 'attract' : screen,\\n      attract: !!attract,\\n      attractSeen: attract ? attract.seen.slice() : [],\\n      day: profile.dayIndex + 1,\\n      step: profile.doneSteps.length,\\n      profile: { ...profile, doneSteps: profile.doneSteps.slice(), met: profile.met.slice(), ages: profile.ages.slice(), stamps: profile.stamps.slice() },\\n      marbles: profile.marbles,\\n      tilt: tiltRad(),\\n      detune: detuneCents(tiltRad(), 0),\\n      wobbleAge: profile.ages[profile.ages.length - 1] || null,\\n      event: event ? {\\n        id: eventId, tier, phase: event.phase ? (typeof event.phase === 'function' ? event.phase()?.id : event.phase) : screen,\\n        t: event.t || 0, score: result ? result.form : 0,\\n        lanes: (event.states || []).map((st, i) => ({\\n          kind: event.lanes[i]?.kind || 'local', leanX: st.leanX, leanZ: st.leanZ,\\n          cob: event.cob ? event.cob(i) : { x: 0, y: 0 }, fallen: !!st.fallen,\\n          form: result && i === 0 ? result.form : 0, props: 0,\\n        })),\\n      } : null,\\n      input: { lastDevice: inputs[0].lastDevice, glyphSet: settings.glyphs },\\n      audio: audio.snapshot(),\\n      render: { backend, frames, lost },\\n      errors: errors.slice(),\\n      settings: { ...settings },\\n      focus,\\n      god, timeScale, levelled: profile.levelled,\\n      dev: screen === 'dev',\\n      group: group ? { seats: group.seats.map((s) => s && s.name), points: group.points.slice() } : null,\\n    };\\n  }\\n\\n  return {\\n    state,\\n    advance(seconds) {\\n      const steps = Math.max(0, Math.round(seconds / FIXED_DT));\\n      for (let i = 0; i < steps; i++) fixed(FIXED_DT);\\n      frame();\\n    },\\n    bot(skill, opt) { botSkill = skill; botOpt = opt || {}; },\\n    goto(next, args = {}) {\\n      if (next === 'dev' && screen !== 'pause' && screen !== 'dev') return false;\\n      if (next === 'play' && args.id) { openIntro(args.id); beginCountdown(); setScreen('play'); return true; }\\n      if (next === 'pause') { devFromPause = false; paused = true; }\\n      setScreen(next);\\n      return true;\\n    },\\n    tuning: { get: getTune, set: setTune, reset: resetTuning, snapshot: tuningSnapshot },\\n    settings: {\\n      get: () => ({ ...settings }),\\n      set(partial) { Object.assign(settings, partial); applySettings(); paint(); },\\n    },\\n    pads,\\n    pad: padAt,\\n    key(code, down = true) { if (down) inputs[0].keyDown(code); else inputs[0].keyUp(code); },\\n    pointer(x, y, buttons = 0) { inputs[0].pointerMove(x, y, buttons); if (buttons) inputs[0].pointerButtons(buttons, x, y); },\\n    setPadSource(fn) { padSource = fn; },\\n    setCoarse(on) { coarse = !!on; if (coarse && screen === 'title') setScreen('touch'); if (!coarse && screen === 'touch') setScreen('title'); },\\n    setRender(info) { backend = info.backend; lost = info.lost; frames = info.frames; },\\n    onFrame(fn) { listeners.add(fn); return () => listeners.delete(fn); },\\n    audio,\\n    profile,\\n    tilt: tiltRad,\\n    persist,\\n    loop,\\n    input: inputs[0],\\n    inputs,\\n    runStandalone() { audio.play('title'); paint(); },\\n    runSession(info) {\\n      session = { info, slots: [], slot: -1, parts: [], total: 0, best: 'Attended', lastProgress: -1, lastGhost: -1, sent: false, playT: 0, ghosts: [] };\\n      setSessionMode(true);\\n      const hub = globalThis.AIHub;\\n      const deal = hub.rng('deal');\\n      const pool = SESSION_SET.slice();\\n      while (session.slots.length < 3 && pool.length) {\\n        session.slots.push(pool.splice(Math.floor(deal() * pool.length), 1)[0]);\\n      }\\n      hub.on('card', () => { screen = 'card'; paint(); });\\n      hub.on('start', () => { session.started = true; });\\n      hub.on('time-up', () => sendResult());\\n      hub.on('end', () => { locked = true; audio.stop(); });\\n      hub.on('leave', (msg) => { session.ghosts = session.ghosts.filter((g) => g.id !== msg.id); });\\n      hub.on('message', (data) => { if (data && data.t === 'g') session.ghosts.push(data); });\\n      const onKey = (e) => {\\n        if (locked || session.started) return;\\n        if (e.key === 'Enter') hub.answer('ready');\\n        if (e.key === 'm' || e.key === 'M') hub.answer('more');\\n      };\\n      if (opts.window) opts.window.addEventListener('keydown', onKey);\\n      screen = 'card';\\n      hub.ready();\\n      paint();\\n    },\\n    activate,\\n    errors,\\n    TITLE,\\n  };\\n}\\n\\nfunction clampNum(n, a, b) { return Math.max(a, Math.min(b, n)); }\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js has been created.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"import { TITLE, TAGLINE, SAVE_KEY, FIXED_DT, SEAT_COLOURS } from '../data/config.js';\\nimport { eventById, eventIds } from '../events/index.js';\\nimport { CheckIn } from './checkin.js';\\nimport { medalOf, medalLabel, wobbleAge, marblePayout, tiersOpen } from './score.js';\\nimport { dayPlan, programmeSteps } from '../data/programme.js';\\nimport { restTiltRad, detuneCents } from '../physics/island.js';\\nimport { initRapier } from '../physics/world.js';\\nimport { createInput } from '../input/input.js';\\nimport { makePad, clearPad, writeWish, writeButton, skillOf } from '../input/bot.js';\\nimport { promptFor } from '../input/glyphs.js';\\nimport { getTune, setTune, resetTuning, tuningSnapshot } from '../core/tuning.js';\\nimport { TUNING_DEFS } from '../data/tuning.js';\\nimport { rng, resetRng, setSessionMode } from '../core/rng.js';\\nimport { readSave, writeSave, memoryStorage } from '../core/save.js';\\nimport { createAudio } from '../audio/engine.js';\\nimport { EVENT_TRACK } from '../audio/tracks.js';\\nimport { findLine, takeLine } from '../data/dialogue.js';\\nimport { NAMES, PAINTS, HATS } from '../data/names.js';\\nimport { createLoop } from '../core/loop.js';\\nimport { mountUi } from '../ui/ui.js';\\n\\nconst SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\\nconst ATTRACT = ['fruitHat', 'cairn', 'stepClass', 'plates', 'springboard', 'raft', 'roomService', 'poses'];\\nconst QUESTIONS = [\\n  { ask: 'trudy.question.0', yes: 'trudy.yes.0', no: 'trudy.no.0', kind: 'yes' },\\n  { ask: 'trudy.question.1', yes: 'trudy.yes.1', no: 'trudy.no.1', kind: 'yes' },\\n  { ask: 'trudy.question.2', yes: 'trudy.yes.2', no: 'trudy.no.2', kind: 'yes' },\\n  { ask: 'trudy.question.3', left: 'trudy.left.0', right: 'trudy.right.0', kind: 'side' },\\n];\\n\\nfunction freshProfile() {\\n  return {\\n    name: NAMES[0], paint: 'coral', hat: 'none', nameIndex: 0, paintIndex: 0, hatIndex: 0,\\n    dayIndex: 0, doneSteps: [], met: [], cleared: {}, best: {},\\n    marbles: 0, ages: [], stamps: [], medals: [], minutes: 0, floor: 0,\\n    levelled: false, classDone: [],\\n  };\\n}\\n\\nfunction defaultSettings() {\\n  return {\\n    music: 10, sfx: 80, voice: 80, glyphs: 'playstation', rumble: true,\\n    autoBreathe: false, rhythmOffset: 0, uiScale: 1, ink: 1, reduceShake: false,\\n    difficulty: 'standard',\\n  };\\n}\\n\\nexport async function createGame(opts = {}) {\\n  await initRapier();\\n  const storage = opts.storage || (opts.window && opts.window.localStorage) || memoryStorage();\\n  const doc = opts.document || null;\\n  const audio = createAudio();\\n  const pads = [0, 1, 2, 3].map(() => makePad());\\n  let padSource = () => pads;\\n  const inputs = [0, 1, 2, 3].map((i) => {\\n    const input = createInput();\\n    input.setPadSource(() => padSource());\\n    input.setPadIndex(i);\\n    input.setDevice('pad');\\n    return input;\\n  });\\n  const profile = freshProfile();\\n  const settings = defaultSettings();\\n  const saved = readSave(storage, SAVE_KEY);\\n  if (saved) {\\n    Object.assign(profile, saved.profile);\\n    Object.assign(settings, saved.settings);\\n  }\\n  let screen = 'title';\\n  let focus = 0;\\n  let page = 0;\\n  let idle = 0;\\n  let attract = null;\\n  let event = null;\\n  let eventId = null;\\n  let tier = 1;\\n  let paused = false;\\n  let countLeft = 0;\\n  let speech = null;\\n  let speechLeft = 0;\\n  let pending = null;\\n  let jarLeft = 0;\\n  let jarPay = 0;\\n  let botSkill = null;\\n  let botOpt = {};\\n  let god = false;\\n  let timeScale = 1;\\n  let coarse = !!opts.coarse;\\n  let session = null;\\n  let locked = false;\\n  let errors = [];\\n  let volumeOpen = false;\\n  let devFromPause = false;\\n  let group = null;\\n  let freePick = false;\\n  let lastResult = null;\\n  let copyText = '';\\n  let palette = 'dawn';\\n  let frames = 0;\\n  let backend = 'none';\\n  let lost = null;\\n  const listeners = new Set();\\n  const programme = programmeSteps(eventIds());\\n  let ui = null;\\n  if (doc) {\\n    ui = mountUi(doc, {\\n      activate: (index) => activate(index),\\n      hover: (index) => { focus = index; paint(); },\\n      slide: (id, value) => { setTune(id, value); applySettings(); paint(); },\\n    });\\n  }\\n\\n  function applySettings() {\\n    audio.setGains(settings.music / 100, settings.sfx / 100, settings.voice / 100);\\n    inputs.forEach((input) => input.setRumble(settings.rumble));\\n  }\\n  applySettings();\\n\\n  function persist() {\\n    writeSave(storage, SAVE_KEY, { profile, settings });\\n  }\\n\\n  function tiltRad() {\\n    const rest = getTune('islandRest');\\n    return restTiltRad(profile.doneSteps.length, Math.max(1, programme.length), rest);\\n  }\\n\\n  function talk(speaker, bucket) {\\n    const line = takeLine(speaker, bucket, rng('talk'));\\n    if (!line) return;\\n    speech = { who: speaker === 'stillwater' ? 'Ms. Stillwater' : speaker === 'bolster' ? 'Coach Bolster' : 'Trudy', text: line.text, id: line.id };\\n    const rate = speaker === 'stillwater' ? 7 : speaker === 'bolster' ? 11 : 16;\\n    speechLeft = Math.max(0.8, line.text.length / rate);\\n    audio.say(line.text, speaker === 'guest' ? 'guest' : speaker);\\n  }\\n\\n  function sayId(id) {\\n    const line = findLineById(id);\\n    if (!line) return;\\n    speech = { who: 'Trudy', text: line.text, id: line.id };\\n    speechLeft = Math.max(0.6, line.text.length / 16);\\n    audio.say(line.text, 'trudy');\\n  }\\n\\n  function findLineById(id) {\\n    return findLine(id) ? null : null;\\n  }\\n\\n  function choicesOf() {\\n    return model().choices;\\n  }\\n\\n  function setScreen(next, keepFocus = false) {\\n    screen = next;\\n    if (!keepFocus) focus = 0;\\n    page = 0;\\n    volumeOpen = false;\\n    if (next !== 'play') paused = false;\\n    for (const pad of pads) clearPad(pad);\\n    paint();\\n    persist();\\n  }\\n\\n  function today() {\\n    const plan = dayPlan(profile.dayIndex, eventIds());\\n    if (plan.maintenance) {\\n      const pool = eventIds().slice();\\n      const picked = [];\\n      while (picked.length < 3 && pool.length) {\\n        const i = Math.floor(rng('maintenance') * pool.length);\\n        picked.push(pool.splice(i, 1)[0]);\\n      }\\n      plan.classes = picked;\\n    }\\n    return plan;\\n  }\\n\\n  function tierFor(id) {\\n    if (!freePick && profile.dayIndex < 5) return 1;\\n    const best = profile.best[id] || {};\\n    return tiersOpen(best);\\n  }\\n\\n  function startEvent(id, extra = {}) {\\n    if (event) event.dispose();\\n    const Ctor = id === 'checkin' ? CheckIn : eventById(id);\\n    eventId = id;\\n    tier = extra.tier || (id === 'checkin' ? 1 : tierFor(id));\\n    const lanes = extra.lanes || [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] }];\\n    event = new Ctor({\\n      tier, lanes, seed: extra.seed || 1, session: !!extra.session, god: extra.god || god,\\n      difficulty: settings.difficulty, tests: extra.tests, skill: extra.skill || 'sharp',\\n      label: `${id}-${profile.dayIndex}`,\\n    });\\n    if (event.build) event.build();\\n    audio.play(EVENT_TRACK[id] || 'island');\\n  }\\n\\n  function finishEvent() {\\n    if (!event) return;\\n    const result = event.result(0);\\n    lastResult = result;\\n    profile.minutes += (event.t || 0) / 60;\\n    profile.floor += result.falls || 0;\\n    if (eventId !== 'checkin') {\\n      const form = result.form || 0;\\n      const best = profile.best[eventId] || {};\\n      best[tier] = Math.max(best[tier] || 0, form);\\n      profile.best[eventId] = best;\\n      if (!profile.met.includes(eventId)) profile.met.push(eventId);\\n      if (programme.includes(eventId) && !profile.doneSteps.includes(eventId)) profile.doneSteps.push(eventId);\\n      const first = !profile.cleared[eventId];\\n      jarPay = marblePayout({\\n        seconds: event.t || 0, form, firstClear: first,\\n        perMin: getTune('marblesPerMin'), medalScale: getTune('medalScale'),\\n      });\\n      profile.cleared[eventId] = true;\\n      profile.medals.push({ id: eventId, tier, form, medal: result.medal });\\n      if (!profile.classDone.includes(eventId)) profile.classDone.push(eventId);\\n    }\\n    event.dispose();\\n    event = null;\\n    audio.setTilt(tiltRad());\\n  }\\n\\n  function woke(sample, travel) {\\n    const e = sample.edges;\\n    if (e.confirm || e.back || e.pause || e.hop || e.flail || e.ask || e.up || e.down || e.left || e.right || e.recenter) return true;\\n    if (sample.padConnected && Math.hypot(sample.wish.x, sample.wish.y) > 0.3) return true;\\n    if (travel > 8) return true;\\n    return false;\\n  }\\n\\n  function menuMove(sample) {\\n    const list = choicesOf();\\n    const n = list.length || 1;\\n    if (sample.edges.up) focus = (focus - 1 + n) % n;\\n    if (sample.edges.down) focus = (focus + 1) % n;\\n    if (sample.edges.left || sample.edges.right) nudge(list[focus], sample.edges.right ? 1 : -1);\\n    if (sample.edges.confirm) activate(focus);\\n    if (sample.edges.back) back();\\n  }\\n\\n  function nudge(choice, dir) {\\n    if (!choice) return;\\n    if (choice.kind === 'slider') {\\n      const def = TUNING_DEFS.find((d) => d.id === choice.id);\\n      if (def) setTune(choice.id, getTune(choice.id) + dir * def.step);\\n      return;\\n    }\\n    if (choice.id === 'music') settings.music = clampNum(settings.music + dir * 5, 0, 100);\\n    if (choice.id === 'sfx') settings.sfx = clampNum(settings.sfx + dir * 5, 0, 100);\\n    if (choice.id === 'voice') settings.voice = clampNum(settings.voice + dir * 5, 0, 100);\\n    if (choice.id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n    if (choice.id === 'difficulty') {\\n      const order = ['gentle', 'standard', 'honest'];\\n      const i = order.indexOf(settings.difficulty);\\n      settings.difficulty = order[(i + (dir > 0 ? 1 : 2)) % 3];\\n    }\\n    if (choice.id === 'name') profile.nameIndex = (profile.nameIndex + (dir > 0 ? 1 : NAMES.length - 1)) % NAMES.length;\\n    if (choice.id === 'paint') profile.paintIndex = (profile.paintIndex + (dir > 0 ? 1 : PAINTS.length - 1)) % PAINTS.length;\\n    if (choice.id === 'hat') profile.hatIndex = (profile.hatIndex + (dir > 0 ? 1 : HATS.length - 1)) % HATS.length;\\n    if (choice.id === 'page') page = Math.max(0, page + dir);\\n    applySettings();\\n  }\\n\\n  function activate(index) {\\n    const list = choicesOf();\\n    const choice = list[index];\\n    if (!choice || choice.kind === 'slider') return;\\n    focus = index;\\n    audio.unlock();\\n    audio.sfx('uiConfirm');\\n    const id = choice.id;\\n    if (screen === 'title') return setScreen(profile.stamps.length || profile.dayIndex > 0 ? 'menu' : 'who');\\n    if (screen === 'touch') return setScreen('settings');\\n    if (screen === 'who' && id === 'begin') {\\n      profile.name = NAMES[profile.nameIndex];\\n      profile.paint = PAINTS[profile.paintIndex].id;\\n      profile.hat = HATS[profile.hatIndex].id;\\n      return setScreen('tutorial');\\n    }\\n    if (screen === 'tutorial' && id === 'on') return beginDay();\\n    if (screen === 'menu') {\\n      if (id === 'programme') return profile.classDone.length ? setScreen('plan') : beginDay();\\n      if (id === 'group') { group = { seats: [null, null, null, null], points: [0, 0, 0, 0], playlist: [], cursor: 0 }; return setScreen('group'); }\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      if (id === 'journal') return setScreen('journal');\\n      if (id === 'settings') return setScreen('settings');\\n      if (id === 'about') return setScreen('about');\\n    }\\n    if (screen === 'question') return answerQuestion(id);\\n    if (screen === 'reply') return setScreen('checkinPlay');\\n    if (screen === 'age') return setScreen('plan');\\n    if (screen === 'plan' && eventById(id)) return openIntro(id);\\n    if (screen === 'intro') return beginCountdown();\\n    if (screen === 'results') {\\n      if (id === 'retry') return openIntro(eventId);\\n      return afterResult();\\n    }\\n    if (screen === 'jar') return afterJar();\\n    if (screen === 'bed') {\\n      if (id === 'free') { freePick = true; return setScreen('free'); }\\n      return sleepDay();\\n    }\\n    if (screen === 'ending') return setScreen(pageOfEnding());\\n    if (screen === 'credits') { sleepDay(); return setScreen('menu'); }\\n    if (screen === 'pause') return pauseAction(id);\\n    if (screen === 'settings') return settingsAction(id);\\n    if (screen === 'dev') return devAction(id);\\n    if (screen === 'free' && eventById(id)) return openIntro(id);\\n    if (screen === 'group') return groupAction(id);\\n    if (screen === 'confirm-reset' && id === 'yes') { resetAll(); return setScreen('title'); }\\n    if (screen === 'confirm-reset') return setScreen('settings');\\n    if (screen === 'island') {\\n      if (id === 'plan') return setScreen('plan');\\n      if (id === 'bed') return setScreen('bed');\\n      if (id === 'menu') return setScreen('menu');\\n    }\\n    paint();\\n  }\\n\\n  function pageOfEnding() {\\n    if (screen === 'ending') return 'credits';\\n    return 'credits';\\n  }\\n\\n  function beginDay() {\\n    freePick = false;\\n    profile.classDone = [];\\n    talk('trudy', 'morning');\\n    setScreen('morning');\\n  }\\n\\n  function answerQuestion(id) {\\n    const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\\n    const key = id === 'yes' ? q.yes : id === 'no' ? q.no : id === 'left' ? q.left : q.right;\\n    const line = lookup(key);\\n    speech = { who: 'Trudy', text: line ? line.text : 'Noted.', id: key };\\n    speechLeft = 1.2;\\n    if (line) audio.say(line.text, 'trudy');\\n    setScreen('reply');\\n  }\\n\\n  function openIntro(id) {\\n    eventId = id;\\n    tier = tierFor(id);\\n    setScreen('intro');\\n  }\\n\\n  function beginCountdown() {\\n    const plan = today();\\n    startEvent(eventId, {\\n      tests: eventId === 'checkin' ? plan.tests : undefined,\\n      god: screen === 'attract',\\n    });\\n    if (eventId === 'checkin') {\\n      screen = 'checkinPlay';\\n      return;\\n    }\\n    countLeft = 3;\\n    setScreen('countdown');\\n  }\\n\\n  function afterResult() {\\n    if (eventId === 'checkin') return;\\n    profile.marbles += jarPay;\\n    jarLeft = 2;\\n    audio.sfx('marble');\\n    setScreen('jar');\\n  }\\n\\n  function afterJar() {\\n    if (profile.levelled && eventId === 'grandHold') {\\n      sayExact(\\\"Oh. So that's what the middle looks like.\\\");\\n      return setScreen('ending');\\n    }\\n    const plan = today();\\n    const pendingClass = plan.classes.filter((id) => !profile.classDone.includes(id));\\n    if (group && group.playlist) return scoreGroup();\\n    if (pendingClass.length && !freePick) return setScreen('plan');\\n    if (freePick) return setScreen('free');\\n    return setScreen('bed');\\n  }\\n\\n  function sleepDay() {\\n    const plan = today();\\n    profile.stamps.push({ day: profile.dayIndex + 1, name: plan.name });\\n    profile.dayIndex += 1;\\n    profile.classDone = [];\\n    palette = 'dawn';\\n    persist();\\n  }\\n\\n  function scoreGroup() {\\n    if (!group) return setScreen('menu');\\n    const forms = lastResult && lastResult.forms ? lastResult.forms : group.seats.map((s, i) => (s ? (i === 0 ? lastResult.form : 0) : -1));\\n    const ranked = forms.map((form, i) => ({ i, form })).filter((row) => row.form >= 0).sort((a, b) => b.form - a.form);\\n    const points = [4, 3, 2, 1];\\n    ranked.forEach((row, place) => { group.points[row.i] += points[place] || 1; });\\n    group.cursor += 1;\\n    if (group.cursor >= group.playlist.length) return setScreen('podium');\\n    openIntro(group.playlist[group.cursor]);\\n  }\\n\\n  function back() {\\n    if (screen === 'settings' || screen === 'about' || screen === 'journal' || screen === 'free' || screen === 'group' || screen === 'mirror') return setScreen('menu');\\n    if (screen === 'dev') return setScreen('pause');\\n    if (screen === 'pause') { paused = false; return setScreen('play'); }\\n    if (screen === 'plan' || screen === 'island') return setScreen('menu');\\n    if (screen === 'who') return setScreen('title');\\n  }\\n\\n  function pauseAction(id) {\\n    if (id === 'resume') { paused = false; return setScreen('play'); }\\n    if (id === 'restart') { openIntro(eventId); return; }\\n    if (id === 'howto') return setScreen('howto');\\n    if (id === 'settings') return setScreen('settings');\\n    if (id === 'dev') { devFromPause = true; return setScreen('dev'); }\\n    if (id === 'leave') {\\n      if (event) event.dispose();\\n      event = null;\\n      return setScreen('island');\\n    }\\n  }\\n\\n  function settingsAction(id) {\\n    if (id === 'glyphs') settings.glyphs = settings.glyphs === 'playstation' ? 'xbox' : 'playstation';\\n    if (id === 'rumble') settings.rumble = !settings.rumble;\\n    if (id === 'breathe') settings.autoBreathe = !settings.autoBreathe;\\n    if (id === 'shake') settings.reduceShake = !settings.reduceShake;\\n    if (id === 'full') {\\n      const el = doc && doc.documentElement;\\n      if (el && el.requestFullscreen) el.requestFullscreen().catch(() => {});\\n    }\\n    if (id === 'reset') return setScreen('confirm-reset');\\n    if (id === 'next') page = (page + 1) % 4;\\n    if (id === 'prev') page = (page + 3) % 4;\\n    applySettings();\\n    paint();\\n  }\\n\\n  function devAction(id) {\\n    if (!devFromPause && screen !== 'dev') return;\\n    if (id === 'reset-tune') resetTuning();\\n    if (id === 'god') god = !god;\\n    if (id === 'faster') timeScale = Math.min(4, timeScale * 2);\\n    if (id === 'slower') timeScale = Math.max(0.1, timeScale / 2);\\n    if (id === 'step' && event) event.fixed(FIXED_DT, [inputs[0].snapshot(0)]);\\n    if (id === 'fall' && event && event.beginFall) event.beginFall(0);\\n    if (id === 'results') { finishEvent(); return setScreen('results'); }\\n    if (id === 'ending') {\\n      profile.doneSteps = programme.slice();\\n      profile.levelled = true;\\n      profile.met = eventIds();\\n      sayExact(\\\"Oh. So that's what the middle looks like.\\\");\\n      return setScreen('ending');\\n    }\\n    if (id === 'marbles') profile.marbles += 10;\\n    if (id === 'unlock') profile.met = eventIds();\\n    if (id === 'age') profile.ages.push(41);\\n    if (id === 'bot') botSkill = botSkill ? null : 'sharp';\\n    if (id === 'copy') copyText = JSON.stringify(tuningSnapshot());\\n    if (id === 'wipe') return setScreen('confirm-reset');\\n    if (id === 'next') page += 1;\\n    if (id === 'prev') page = Math.max(0, page - 1);\\n    if (id.startsWith('jump-')) {\\n      devFromPause = true;\\n      return openIntro(id.slice(5));\\n    }\\n    paint();\\n  }\\n\\n  function groupAction(id) {\\n    if (id === 'quick' || id === 'raft' || eventById(id)) {\\n      const couch = eventIds().filter((eid) => eventById(eid).couch);\\n      const playlist = id === 'quick' ? pickSome(couch, 3) : [id === 'raft' ? 'raft' : id];\\n      group.playlist = playlist;\\n      group.cursor = 0;\\n      const lanes = group.seats.map((seat, i) => seat ? ({\\n        id: i, kind: 'local', name: seat.name, colour: SEAT_COLOURS[i],\\n      }) : null).filter(Boolean);\\n      if (!lanes.length) lanes.push({ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] });\\n      group.lanes = lanes;\\n      return openIntro(playlist[0]);\\n    }\\n    if (id === 'back') return setScreen('menu');\\n  }\\n\\n  function pickSome(list, n) {\\n    const pool = list.slice();\\n    const out = [];\\n    while (out.length < n && pool.length) out.push(pool.splice(Math.floor(rng('group') * pool.length), 1)[0]);\\n    return out;\\n  }\\n\\n  function resetAll() {\\n    const next = freshProfile();\\n    Object.keys(profile).forEach((k) => delete profile[k]);\\n    Object.assign(profile, next);\\n    Object.assign(settings, defaultSettings());\\n    resetTuning();\\n    try { storage.removeItem(SAVE_KEY); } catch { /* memory store */ }\\n  }\\n\\n  function sayExact(text) {\\n    speech = { who: 'Trudy', text, id: 'exact' };\\n    speechLeft = Math.max(1, text.length / 16);\\n    audio.say(text, 'trudy');\\n  }\\n\\n  function lookup(id) {\\n    const { lineById } = dialogueApi();\\n    return lineById(id);\\n  }\\n\\n  function dialogueApi() {\\n    return import('../data/dialogue.js');\\n  }\\n\\n  function driveBots(dt) {\\n    if (!event || !botSkill) return null;\\n    const skill = skillOf(botSkill);\\n    const snaps = [];\\n    const count = event.lanes.length;\\n    for (let i = 0; i < count; i++) {\\n      const cmd = event.botInput(i, skill, botOpt) || {};\\n      const pad = padAt(i);\\n      clearPad(pad);\\n      writeWish(pad, cmd.x || 0, cmd.y || 0);\\n      writeButton(pad, 0, !!cmd.hop);\\n      writeButton(pad, 2, !!cmd.flail);\\n      writeButton(pad, 5, !!(cmd.breathe || (settings.autoBreathe && screen === 'play')));\\n      writeButton(pad, 6, (cmd.feetL || 0) > 0, cmd.feetL || 0);\\n      writeButton(pad, 7, (cmd.feetR || 0) > 0, cmd.feetR || 0);\\n      const input = inputs[i];\\n      if (cmd.plateA) input.keyDown('KeyA');\\n      if (cmd.plateD) input.keyDown('KeyD');\\n      input.poll(dt, 'balance');\\n      if (cmd.plateA) input.keyUp('KeyA');\\n      if (cmd.plateD) input.keyUp('KeyD');\\n      snaps.push(input.snapshot(0));\\n    }\\n    return snaps;\\n  }\\n\\n  function padAt(i) {\\n    const list = padSource() || pads;\\n    return list[i] || pads[i];\\n  }\\n\\n  function fixed(dt) {\\n    if (locked) return;\\n    audio.setTilt(tiltRad());\\n    if (session) return sessionFixed(dt);\\n    const input = inputs[0];\\n    const before = input.takeTravel ? 0 : 0;\\n    const playing = screen === 'play' || screen === 'checkinPlay' || attract;\\n    if (playing && botSkill) {\\n      const snaps = driveBots(dt);\\n      if (!paused && event) stepEvent(dt, snaps);\\n      noteNotch();\\n      return;\\n    }\\n    const sample = input.poll(dt, playing ? 'balance' : 'menu');\\n    const travel = input.takeTravel();\\n    if (attract) {\\n      if (woke(sample, travel)) { stopAttract(true); return; }\\n      stepAttract(dt);\\n      return;\\n    }\\n    if (screen === 'title' || screen === 'menu' || screen === 'touch') {\\n      if (woke(sample, travel)) idle = 0;\\n      else idle += dt;\\n      if (idle >= 10) { startAttract(); return; }\\n    } else idle = 0;\\n    if (sample.edges.pause && (screen === 'play' || screen === 'checkinPlay') && !sample.createHeld) {\\n      paused = true;\\n      return setScreen('pause');\\n    }\\n    if ((screen === 'play' || screen === 'checkinPlay') && !paused) {\\n      const snaps = [];\\n      const n = event ? event.lanes.length : 1;\\n      snaps.push(sampleToSnap(sample, input));\\n      for (let i = 1; i < n; i++) {\\n        const extra = inputs[i].poll(dt, 'balance');\\n        snaps.push(sampleToSnap(extra, inputs[i]));\\n      }\\n      joinPads(sample);\\n      stepEvent(dt, snaps);\\n      noteNotch();\\n      if (event && event.done) {\\n        finishEvent();\\n        if (eventId === 'checkin') revealAge();\\n        else setScreen('results');\\n      }\\n      return;\\n    }\\n    if (screen === 'countdown') {\\n      countLeft -= dt;\\n      if (countLeft <= 0) setScreen('play');\\n      return;\\n    }\\n    if (screen === 'morning') {\\n      speechLeft -= dt;\\n      if (sample.edges.confirm || speechLeft <= 0) openQuestion();\\n      return;\\n    }\\n    if (screen === 'jar') {\\n      jarLeft -= dt;\\n      if (sample.edges.confirm || jarLeft <= 0) afterJar();\\n      return;\\n    }\\n    if (speechLeft > 0) speechLeft -= dt;\\n    if (!playing) menuMove(sample);\\n    void before;\\n  }\\n\\n  function sampleToSnap(sample, input) {\\n    return input.snapshot(0);\\n  }\\n\\n  function stepEvent(dt, snaps) {\\n    if (!event || paused) return;\\n    event.fixed(dt, snaps || []);\\n    if (event.frame) event.frame(dt);\\n  }\\n\\n  function noteNotch() {\\n    if (event && event.notch && !profile.doneSteps.includes('grandHold')) {\\n      profile.doneSteps.push('grandHold');\\n      profile.levelled = profile.doneSteps.length >= programme.length;\\n      if (!profile.met.includes('grandHold')) profile.met.push('grandHold');\\n      audio.sfx('creak');\\n    }\\n    if (profile.doneSteps.length >= programme.length) profile.levelled = true;\\n  }\\n\\n  function revealAge() {\\n    const mean = lastResult.mean || 0;\\n    const age = wobbleAge(mean, Math.min(4, profile.dayIndex));\\n    profile.ages.push(age);\\n    profile.marbles += 1;\\n    sayExact(`Your Wobble Age is ${age}.`);\\n    setScreen('age');\\n  }\\n\\n  function openQuestion() {\\n    setScreen('question');\\n  }\\n\\n  function startAttract() {\\n    attract = { index: 0, left: 18, between: 0, seen: [] };\\n    idle = 0;\\n    botSkill = 'sharp';\\n    launchAttract();\\n  }\\n\\n  function launchAttract() {\\n    const id = ATTRACT[attract.index % ATTRACT.length];\\n    if (!attract.seen.includes(id)) attract.seen.push(id);\\n    startEvent(id, { god: id !== 'fruitHat', lanes: [{ id: 0, kind: 'bot', name: 'Demo', colour: SEAT_COLOURS[1] }] });\\n    botOpt = id === 'fruitHat' ? { bankAt: 99 } : {};\\n    screen = 'play';\\n  }\\n\\n  function stepAttract(dt) {\\n    if (!attract) return;\\n    if (attract.between > 0) {\\n      attract.between -= dt;\\n      screen = 'title';\\n      if (attract.between <= 0) launchAttract();\\n      return;\\n    }\\n    const snaps = driveBots(dt);\\n    if (event) stepEvent(dt, snaps);\\n    attract.left -= dt;\\n    if (!event || event.done || attract.left <= 0) {\\n      if (event) { event.dispose(); event = null; }\\n      attract.index += 1;\\n      attract.left = 18;\\n      if (attract.index % ATTRACT.length === 0) {\\n        attract.between = 5;\\n        screen = 'title';\\n        botSkill = null;\\n      } else launchAttract();\\n    }\\n  }\\n\\n  function stopAttract(swallow) {\\n    if (event) { event.dispose(); event = null; }\\n    attract = null;\\n    botSkill = null;\\n    botOpt = {};\\n    idle = 0;\\n    for (const pad of pads) clearPad(pad);\\n    screen = coarse ? 'touch' : 'title';\\n    if (swallow) paint();\\n  }\\n\\n  function joinPads(sample) {\\n    if (screen !== 'group' || !group) return;\\n    for (let i = 0; i < 4; i++) {\\n      const pad = padAt(i);\\n      if (pad && pad.buttons[0] && pad.buttons[0].pressed && !group.seats[i]) {\\n        group.seats[i] = { name: `Player ${i + 1}`, device: 'pad' };\\n      }\\n      if (pad && pad.buttons[1] && pad.buttons[1].pressed) group.seats[i] = null;\\n    }\\n    if (sample.edges.confirm && !group.seats.some((s) => s && s.device === 'key')) {\\n      const slot = group.seats.findIndex((s) => !s);\\n      if (slot >= 0) group.seats[slot] = { name: profile.name, device: 'key' };\\n    }\\n  }\\n\\n  function sessionFixed(dt) {\\n    const hub = globalThis.AIHub;\\n    if (!hub) return;\\n    const ms = hub.time();\\n    if (!Number.isFinite(ms)) {\\n      screen = 'card';\\n      return;\\n    }\\n    const t = ms / 1000;\\n    if (t < 0) {\\n      screen = 'countdown';\\n      countLeft = Math.max(0, -t);\\n      return;\\n    }\\n    const slot = Math.min(session.slots.length, Math.floor(t / 62));\\n    const local = t - slot * 62;\\n    if (slot >= session.slots.length) {\\n      screen = 'waiting';\\n      sendResult();\\n      return;\\n    }\\n    if (session.slot !== slot) {\\n      session.slot = slot;\\n      session.playT = 0;\\n      if (event) event.dispose();\\n      event = null;\\n      eventId = session.slots[slot];\\n    }\\n    if (local < 6) {\\n      screen = 'intro';\\n      session.scoreShown = session.total;\\n    } else if (local < 56) {\\n      if (!event) {\\n        startEvent(eventId, { session: true, lanes: [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[hub.me || 0] }] });\\n        screen = 'play';\\n      }\\n      const input = inputs[0];\\n      const snaps = botSkill ? driveBots(dt) : [input.snapshot(0)];\\n      if (!botSkill) input.poll(dt, 'balance');\\n      stepEvent(dt, snaps);\\n      session.playT += dt;\\n      if (event && (event.done || local >= 55.9)) {\\n        const result = event.result(0);\\n        session.parts.push(Math.round((result.form || 0) * 10));\\n        session.total = session.parts.reduce((a, b) => a + b, 0);\\n        session.best = medalLabel(result.medal || 'attended');\\n        event.dispose();\\n        event = null;\\n        screen = 'results';\\n      } else screen = 'play';\\n    } else screen = 'results';\\n    if (t - session.lastProgress >= 1 || session.lastProgress < 0) {\\n      const label = `${eventTitle(session.slots[slot])} ${session.slot === 0 && local < 6 ? 0 : session.total}`.slice(0, 24);\\n      const score = session.slot === 0 && local < 6 ? 0 : session.total;\\n      hub.progress({ score, label });\\n      session.lastProgress = t;\\n    }\\n    if (t - session.lastGhost >= 0.1) {\\n      const lean = event && event.states ? event.states[0] : { leanX: 0, leanZ: 0, fallen: false };\\n      hub.send({\\n        t: 'g', a: slot, x: 0, z: 0,\\n        lx: Number((lean.leanX || 0).toFixed(3)),\\n        lz: Number((lean.leanZ || 0).toFixed(3)),\\n        c: 0, f: lean.fallen ? 1 : 0, s: session.total,\\n      }, { reliable: false });\\n      session.lastGhost = t;\\n    }\\n    void dt;\\n  }\\n\\n  function sendResult() {\\n    const hub = globalThis.AIHub;\\n    if (!session || session.sent || !hub) return;\\n    session.sent = true;\\n    const score = session.total || 0;\\n    hub.result({\\n      score,\\n      stats: { 'Floor Exercises': profile.floor, 'Best medal': session.best || 'Attended', 'Wobble Age': profile.ages[0] || 41 },\\n      awards: score >= 2500 ? ['Suspiciously Still'] : ['Showed Up'],\\n    });\\n  }\\n\\n  function eventTitle(id) {\\n    const Ctor = eventById(id);\\n    return Ctor ? Ctor.title : 'Class';\\n  }\\n\\n  function frame() {\\n    frames += 1;\\n    if (!locked) audio.tick();\\n    for (const fn of listeners) fn();\\n    paint();\\n  }\\n\\n  function model() {\\n    const device = inputs[0].lastDevice;\\n    const prompts = promptFor(currentVerbs(), device, settings.glyphs);\\n    const lines = [];\\n    const choices = [];\\n    let heading = '';\\n    const add = (id, label, extra = {}) => choices.push({ id, label, index: choices.length, focus: choices.length === focus, ...extra });\\n    if (coarse && screen === 'title') screen = 'touch';\\n    if (screen === 'touch') {\\n      lines.push('Controller or keyboard required');\\n      lines.push(TAGLINE);\\n      add('settings', 'Settings');\\n    } else if (screen === 'title' || (attract && attract.between > 0)) {\\n      lines.push(TAGLINE);\\n      lines.push('Press to begin');\\n      add('begin', 'Begin');\\n    } else if (screen === 'who') {\\n      heading = \\\"Who's here?\\\";\\n      add('name', `Name: ${NAMES[profile.nameIndex]}`);\\n      add('paint', `Paint: ${PAINTS[profile.paintIndex].id}`);\\n      add('hat', `Hat: ${HATS[profile.hatIndex].label}`);\\n      add('begin', 'Begin');\\n    } else if (screen === 'tutorial') {\\n      heading = 'How a day works';\\n      lines.push('You can lean, step, hop, and flail. You cannot type a name.');\\n      lines.push('Flail is a short save with a cooldown. It is not a free win.');\\n      add('on', 'Step on');\\n    } else if (screen === 'menu') {\\n      heading = 'Level Best Retreat';\\n      const cont = profile.dayIndex > 0 || profile.classDone.length ? 'Continue' : 'Programme';\\n      add('programme', cont);\\n      add('group', 'Group Class');\\n      add('free', 'Free Play');\\n      add('journal', 'Journal');\\n      add('settings', 'Settings');\\n      add('about', 'About / Credits');\\n    } else if (screen === 'morning') {\\n      heading = today().name;\\n      lines.push(speech ? speech.text : 'Good morning.');\\n      add('on', 'Continue');\\n    } else if (screen === 'question') {\\n      const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\\n      const line = lookup(q.ask);\\n      heading = 'A small question';\\n      lines.push(line ? line.text : 'Do you trust your knees?');\\n      if (q.kind === 'side') { add('left', 'Left'); add('right', 'Right'); }\\n      else { add('yes', 'Yes'); add('no', 'No'); }\\n    } else if (screen === 'reply') {\\n      heading = 'Trudy';\\n      lines.push(speech ? speech.text : 'Noted.');\\n      add('on', 'To the mat');\\n    } else if (screen === 'age') {\\n      heading = 'Wobble Age';\\n      lines.push(String(profile.ages[profile.ages.length - 1] || ''));\\n      lines.push('I did not ask how old you are. I asked your knees.');\\n      add('on', 'See the plan');\\n    } else if (screen === 'plan') {\\n      heading = today().name;\\n      const classes = today().classes;\\n      for (const id of classes) add(id, `${eventTitle(id)}${profile.classDone.includes(id) ? ' — stamped' : ''}`);\\n      if (!classes.length) lines.push('The day is open.');\\n    } else if (screen === 'intro') {\\n      const Ctor = eventById(eventId);\\n      heading = Ctor ? Ctor.title : 'Class';\\n      lines.push(Ctor ? Ctor.can : '');\\n      lines.push(Ctor ? Ctor.cant : '');\\n      add('go', 'Begin');\\n    } else if (screen === 'countdown') {\\n      heading = String(Math.max(1, Math.ceil(countLeft)));\\n      lines.push('Hold still.');\\n    } else if (screen === 'play' || screen === 'checkinPlay') {\\n      heading = eventTitle(eventId);\\n    } else if (screen === 'results') {\\n      heading = lastResult ? medalLabel(lastResult.medal) : 'Attended';\\n      lines.push(lastResult ? lastResult.stats : '');\\n      lines.push(lastResult ? `Form ${Math.round(lastResult.form)}` : '');\\n      add('continue', 'Continue');\\n      add('retry', 'Retry');\\n    } else if (screen === 'jar') {\\n      heading = 'The jar';\\n      lines.push(`+${jarPay} marbles. The jar has ${profile.marbles}.`);\\n      add('on', 'Continue');\\n    } else if (screen === 'bed') {\\n      heading = 'Bed hut';\\n      lines.push('The stamp is ready.');\\n      add('bed', 'Sleep');\\n      add('free', 'Free Play');\\n    } else if (screen === 'ending') {\\n      heading = 'Level';\\n      lines.push(\\\"Oh. So that's what the middle looks like.\\\");\\n      add('on', 'Listen');\\n    } else if (screen === 'credits') {\\n      heading = 'Credits';\\n      lines.push(\\\"It's quite flat, isn't it? ...Same time tomorrow?\\\");\\n      add('on', 'Same time tomorrow');\\n    } else if (screen === 'pause') {\\n      heading = 'Paused';\\n      ['resume', 'restart', 'howto', 'settings', 'dev', 'leave'].forEach((id) => add(id, {\\n        resume: 'Resume', restart: 'Restart', howto: 'How to Play', settings: 'Settings', dev: 'Dev Mode', leave: 'Leave Class',\\n      }[id]));\\n    } else if (screen === 'howto') {\\n      heading = 'How to Play';\\n      lines.push('Lean with the stick, the keys, or the mouse. Feet are the triggers.');\\n      lines.push('You cannot win by flailing on cooldown.');\\n      add('back', 'Back');\\n    } else if (screen === 'settings') settingsModel(add, lines);\\n    else if (screen === 'dev') devModel(add, lines);\\n    else if (screen === 'about') aboutModel(add, lines);\\n    else if (screen === 'journal') journalModel(add, lines);\\n    else if (screen === 'free') {\\n      heading = 'Free Play';\\n      const ids = (profile.levelled ? eventIds() : profile.met);\\n      const slice = ids.slice(page * 4, page * 4 + 4);\\n      slice.forEach((id) => add(id, eventTitle(id)));\\n      if (ids.length > 4) add('page', 'More');\\n      if (!slice.length) lines.push('Meet a class first. The pavilions keep.');\\n    } else if (screen === 'group') {\\n      heading = 'Group Class';\\n      lines.push(group.seats.map((s, i) => s ? `${i + 1} ${s.name}` : `${i + 1} empty`).join('  '));\\n      add('quick', 'Quick Class');\\n      add('raft', 'Tippy Raft');\\n      add('back', 'Back');\\n    } else if (screen === 'podium') {\\n      heading = 'Podium';\\n      lines.push(group.points.map((p, i) => `Seat ${i + 1}: ${p}`).join('  '));\\n      add('back', 'Back to the island');\\n    } else if (screen === 'island') {\\n      heading = 'The island';\\n      lines.push(speech ? speech.text : 'Trudy is here.');\\n      add('plan', \\\"Today's Plan\\\");\\n      add('bed', 'Bed hut');\\n      add('menu', 'Menu');\\n    } else if (screen === 'card') cardModel(lines);\\n    else if (screen === 'waiting') {\\n      heading = 'Waiting for the others';\\n      lines.push('Trudy is keeping the clipboard shut.');\\n    } else if (screen === 'confirm-reset') {\\n      heading = 'Reset the save?';\\n      lines.push('The jar will be empty again.');\\n      add('yes', 'Yes, reset');\\n      add('no', 'No');\\n    } else if (screen === 'boot') {\\n      lines.push('Stretching...');\\n    }\\n    if (attract && screen === 'play') lines.push('DEMO · Press any button');\\n    if (copyText && screen === 'dev') lines.push(copyText);\\n    const cob = event && event.cob ? event.cob(0) : { x: 0, y: 0 };\\n    return {\\n      screen: attract ? 'attract' : screen,\\n      gameTitle: TITLE,\\n      heading,\\n      lines,\\n      choices: choices.slice(0, 6),\\n      page: pageLabel(),\\n      prompts,\\n      speech: speech && (screen === 'play' || screen === 'morning') ? speech : null,\\n      hud: (screen === 'play' || screen === 'checkinPlay') && event ? {\\n        time: formatTime(event.t || 0),\\n        score: String(Math.round((event.result ? event.result(0).form : 0) || 0)),\\n      } : null,\\n      disc: (screen === 'play' || screen === 'checkinPlay') ? { x: cob.x || 0, y: cob.y || 0 } : null,\\n      attract: !!attract,\\n    };\\n  }\\n\\n  function pageLabel() {\\n    if (screen === 'settings') return `Page ${page + 1} of 4`;\\n    if (screen === 'about') return `Page ${page + 1} of 8`;\\n    if (screen === 'journal') return `Page ${page + 1}`;\\n    if (screen === 'dev') return `Page ${page + 1}`;\\n    return '';\\n  }\\n\\n  function settingsModel(add, lines) {\\n    const pages = [\\n      () => { add('music', `Music: ${settings.music}`); add('sfx', `Sound: ${settings.sfx}`); add('voice', `Voice: ${settings.voice}`); },\\n      () => { add('glyphs', `Glyphs: ${settings.glyphs}`); add('rumble', `Rumble: ${settings.rumble ? 'on' : 'off'}`); add('breathe', `Auto-breathe: ${settings.autoBreathe ? 'on' : 'off'}`); },\\n      () => { add('shake', `Reduce shake: ${settings.reduceShake ? 'on' : 'off'}`); add('full', 'Fullscreen'); lines.push(`Ink ${settings.ink}`); },\\n      () => { add('difficulty', `Difficulty: ${settings.difficulty}`); add('reset', 'Reset save'); },\\n    ];\\n    pages[page % 4]();\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n  }\\n\\n  function devModel(add, lines) {\\n    lines.push(`Time scale ${timeScale}. God ${god ? 'on' : 'off'}.`);\\n    const groups = [...new Set(TUNING_DEFS.map((d) => d.group))];\\n    if (page === 0) {\\n      add('god', god ? 'God mode on' : 'God mode off');\\n      add('faster', 'Faster');\\n      add('slower', 'Slower');\\n      add('fall', 'Force a fall');\\n    } else if (page === 1) {\\n      add('results', 'Skip to Results');\\n      add('ending', 'Skip to Ending');\\n      add('bot', botSkill ? 'Bot playing' : 'Let the bot play');\\n      add('copy', 'Copy tuning');\\n    } else if (page === 2) {\\n      add('marbles', 'Add marbles');\\n      add('unlock', 'Unlock all');\\n      add('age', 'Set a Wobble Age');\\n      add('wipe', 'Reset save');\\n    } else {\\n      const defs = TUNING_DEFS.filter((d) => d.group === groups[(page - 3) % groups.length]);\\n      for (const def of defs.slice(0, 4)) add(def.id, `${def.label}: ${getTune(def.id)}`, { kind: 'slider', min: def.min, max: def.max, step: def.step, value: getTune(def.id) });\\n    }\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n    add('reset-tune', 'Reset to defaults');\\n  }\\n\\n  function aboutModel(add, lines) {\\n    const pages = aboutPages();\\n    headingSafe(lines, pages[page % pages.length]);\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n  }\\n\\n  function headingSafe(lines, block) {\\n    for (const line of block) lines.push(line);\\n  }\\n\\n  function journalModel(add, lines) {\\n    if (page === 0) lines.push(profile.stamps.map((s) => `Day ${s.day} ${s.name}`).join(' · ') || 'No stamps yet.');\\n    else if (page === 1) lines.push(profile.ages.join(' → ') || 'No ages yet.');\\n    else lines.push(`Minutes ${profile.minutes.toFixed(1)}. Marbles ${profile.marbles}. Floor exercises ${profile.floor}.`);\\n    add('prev', 'Previous page');\\n    add('next', 'Next page');\\n  }\\n\\n  function cardModel(lines) {\\n    lines.push(TITLE);\\n    lines.push('Stay balanced through the class: highest score wins');\\n    lines.push('Enter is Ready. M is More time.');\\n    const hub = globalThis.AIHub;\\n    const players = (hub && hub.players) || [];\\n    for (const player of players) lines.push(`${player.name || 'Player'}`);\\n  }\\n\\n  function currentVerbs() {\\n    if (screen === 'play' || screen === 'intro') {\\n      const Ctor = eventById(eventId);\\n      return Ctor && Ctor.verbs ? Ctor.verbs : ['use'];\\n    }\\n    return ['confirm', 'back'];\\n  }\\n\\n  function formatTime(t) {\\n    const s = Math.max(0, Math.floor(t));\\n    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;\\n  }\\n\\n  function paint() {\\n    if (!ui) return;\\n    const view = model();\\n    ui.paint(view);\\n  }\\n\\n  function aboutPages() {\\n    return [[TITLE], [TAGLINE], ['About'], ['Credits'], ['Fredoka'], ['Three.js'], ['Rapier'], ['Level Best Retreat']];\\n  }\\n\\n  const loop = createLoop(fixed, frame, { scale: () => timeScale });\\n  if (!opts.manual) loop.start();\\n  if (coarse) screen = 'touch';\\n  paint();\\n\\n  function state() {\\n    const lean = event && event.states ? event.states[0] : null;\\n    const result = event && event.result ? event.result(0) : null;\\n    return {\\n      screen: attract ? 'attract' : screen,\\n      attract: !!attract,\\n      attractSeen: attract ? attract.seen.slice() : [],\\n      day: profile.dayIndex + 1,\\n      step: profile.doneSteps.length,\\n      profile: { ...profile, doneSteps: profile.doneSteps.slice(), met: profile.met.slice(), ages: profile.ages.slice(), stamps: profile.stamps.slice() },\\n      marbles: profile.marbles,\\n      tilt: tiltRad(),\\n      detune: detuneCents(tiltRad(), 0),\\n      wobbleAge: profile.ages[profile.ages.length - 1] || null,\\n      event: event ? {\\n        id: eventId, tier, phase: event.phase ? (typeof event.phase === 'function' ? event.phase()?.id : event.phase) : screen,\\n        t: event.t || 0, score: result ? result.form : 0,\\n        lanes: (event.states || []).map((st, i) => ({\\n          kind: event.lanes[i]?.kind || 'local', leanX: st.leanX, leanZ: st.leanZ,\\n          cob: event.cob ? event.cob(i) : { x: 0, y: 0 }, fallen: !!st.fallen,\\n          form: result && i === 0 ? result.form : 0, props: 0,\\n        })),\\n      } : null,\\n      input: { lastDevice: inputs[0].lastDevice, glyphSet: settings.glyphs },\\n      audio: audio.snapshot(),\\n      render: { backend, frames, lost },\\n      errors: errors.slice(),\\n      settings: { ...settings },\\n      focus,\\n      god, timeScale, levelled: profile.levelled,\\n      dev: screen === 'dev',\\n      group: group ? { seats: group.seats.map((s) => s && s.name), points: group.points.slice() } : null,\\n    };\\n  }\\n\\n  return {\\n    state,\\n    advance(seconds) {\\n      const steps = Math.max(0, Math.round(seconds / FIXED_DT));\\n      for (let i = 0; i < steps; i++) fixed(FIXED_DT);\\n      frame();\\n    },\\n    bot(skill, opt) { botSkill = skill; botOpt = opt || {}; },\\n    goto(next, args = {}) {\\n      if (next === 'dev' && screen !== 'pause' && screen !== 'dev') return false;\\n      if (next === 'play' && args.id) { openIntro(args.id); beginCountdown(); setScreen('play'); return true; }\\n      if (next === 'pause') { devFromPause = false; paused = true; }\\n      setScreen(next);\\n      return true;\\n    },\\n    tuning: { get: getTune, set: setTune, reset: resetTuning, snapshot: tuningSnapshot },\\n    settings: {\\n      get: () => ({ ...settings }),\\n      set(partial) { Object.assign(settings, partial); applySettings(); paint(); },\\n    },\\n    pads,\\n    pad: padAt,\\n    key(code, down = true) { if (down) inputs[0].keyDown(code); else inputs[0].keyUp(code); },\\n    pointer(x, y, buttons = 0) { inputs[0].pointerMove(x, y, buttons); if (buttons) inputs[0].pointerButtons(buttons, x, y); },\\n    setPadSource(fn) { padSource = fn; },\\n    setCoarse(on) { coarse = !!on; if (coarse && screen === 'title') setScreen('touch'); if (!coarse && screen === 'touch') setScreen('title'); },\\n    setRender(info) { backend = info.backend; lost = info.lost; frames = info.frames; },\\n    onFrame(fn) { listeners.add(fn); return () => listeners.delete(fn); },\\n    audio,\\n    profile,\\n    tilt: tiltRad,\\n    persist,\\n    loop,\\n    input: inputs[0],\\n    inputs,\\n    runStandalone() { audio.play('title'); paint(); },\\n    runSession(info) {\\n      session = { info, slots: [], slot: -1, parts: [], total: 0, best: 'Attended', lastProgress: -1, lastGhost: -1, sent: false, playT: 0, ghosts: [] };\\n      setSessionMode(true);\\n      const hub = globalThis.AIHub;\\n      const deal = hub.rng('deal');\\n      const pool = SESSION_SET.slice();\\n      while (session.slots.length < 3 && pool.length) {\\n        session.slots.push(pool.splice(Math.floor(deal() * pool.length), 1)[0]);\\n      }\\n      hub.on('card', () => { screen = 'card'; paint(); });\\n      hub.on('start', () => { session.started = true; });\\n      hub.on('time-up', () => sendResult());\\n      hub.on('end', () => { locked = true; audio.stop(); });\\n      hub.on('leave', (msg) => { session.ghosts = session.ghosts.filter((g) => g.id !== msg.id); });\\n      hub.on('message', (data) => { if (data && data.t === 'g') session.ghosts.push(data); });\\n      const onKey = (e) => {\\n        if (locked || session.started) return;\\n        if (e.key === 'Enter') hub.answer('ready');\\n        if (e.key === 'm' || e.key === 'M') hub.answer('more');\\n      };\\n      if (opts.window) opts.window.addEventListener('keydown', onKey);\\n      screen = 'card';\\n      hub.ready();\\n      paint();\\n    },\\n    activate,\\n    errors,\\n    TITLE,\\n  };\\n}\\n\\nfunction clampNum(n, a, b) { return Math.max(a, Math.min(b, n)); }\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"168ce180-353c-42ba-909d-b7b35f41dc2e"}
{"type":"assistant","message":{"id":"msg_135","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"`findLineById` in the director module is broken and largely unused.\n\n`lookup` needs `lineById` imported and the broken functions removed. `sayId` also relies on the broken `findLineById`. `aboutPages` is just stub text; real content will come from `data/about.js`. `headingSafe` works without explicit heading setup. `pageOfEnding` is redundant because it always returns `'credits'`.\n\nThe countdown flow is sound: `startEvent` runs before `setScreen`, so the event persists through the countdown and into play. However, the check-in path has a bug. When a question reply activates check-in, it jumps straight to `checkinPlay` without starting the actual check-in event.\n\nThe fix for the check-in bug is to start the event inside the reply activate handler before switching to `checkinPlay`. Morning confirm correctly calls `openQuestion`. The `finishEvent` logic appears sound: it returns early for non-check-in events but still disposes the check-in event.\n\n`startEvent` must fall back to `group.lanes` when a group playlist is active. The attract flow sets bot skill before launching.\n\nThe `fixed()` function has a branch ordering bug. Because `playing` includes attract, the bot skill check runs before the attract branch when `botSkill` is active. This prevents attract from stopping or counting time. The correct order should be session first, then attract, then bot during play. During attract, input polling and consumption should happen inside `stepAttract` rather than in `driveBots`.\n\nTitle screen activation correctly routes to the who or menu choices. During attract mode, model screen is 'attract' while the internal state may still be 'play', so activation should be swallowed to prevent unwanted transitions.\n\nThe dynamic import of dialogue is broken and `findLine` searches by text rather than id, so `lineById` will be imported instead. The dev model can hold seven choices, but `model()` will slice them to six to prevent overflow.\n\nThe reset-tune button will be placed before the extras so it is preserved when the dev model is sliced to six choices. The settings page holds five choices, and the menu holds exactly six.\n\nThe free play page holds five choices, which is acceptable. The `inner` issue is resolved by passing lanes through `startEvent` when opening a group raft. Group countdowns will use the corrected `startEvent`. For group tests, the winner must be exposed on state because `lastResult.forms` is never populated; it will be set from the event result before disposal.\n\nSession messages arrive via `hub.on('message')` and ghost echoes from other players are harmless. In `sessionFixed`, input polling must precede snapshot capture; currently it runs after, so the order needs to be reversed.\n\nThe pad button 3 is mapped to \"more\" and button 0 to \"ready\" before the start event begins. `openQuestion` does not set the question speech from its dialogue line.\n\nThe grand hold notch logic is sound. It sets the levelled flag when all steps are done and adds the grandHold event only if it is missing. The jar pay is deferred until afterResult, preventing a double marble. Check-in marbles increment correctly in revealAge.\n\nThe age handicap caps the day index at four. During attract mode, `stepAttract` already polls input for bots, so the `fixed()` attract branch must not poll again or it will double-poll and clear edges.\n\nThe attract exit logic needs a human poll before the bot branch. The first poll captures keyboard edges for the exit check. If no key is pressed, the second poll inside `stepAttract` belongs to the bot. Polling before the bot branch would let the bot overwrite the human input.\n\nTitle screen idle mode polls every frame, so a held stick can wake the game. Calling `setScreen` from `stopAttract` triggers a paint.\n\n`stopAttract` sets the screen directly instead of calling `setScreen`, so the swallowed confirm edge is not cleared. The confirm edge is consumed during the current frame, leaving no confirm on the next frame.\n\nThe wall-clock attract test requires the game loop to keep running. `createGame` starts the loop unless manual mode is enabled. The test uses manual false and sleeps 10.5 seconds, relying on real timers through the Node raf shim. The event loop must remain unblocked.\n\nThe wall-clock attract test uses a 11-second timeout, which works because the game loop also runs on setTimeout. createLoop falls back to setTimeout when requestAnimationFrame is unavailable. beginDay calls talk before setScreen, and speech persists across screen changes. The question dialogue IDs are trudy.question.0, trudy.question.1, and trudy.question.2.\n\nThe third question is \"When you walk into a room...\". Each question's yes and no replies map to the correct dialogue IDs. Ending strings must match exactly for sayExact and screen lines.\n\nThe dynamic `dialogueApi` import must be removed entirely, because leaving it would break the esbuild IIFE build. Group introductions now return early so the countdown only starts after the user confirms.\n\nGroup introductions correctly return early so the countdown only starts after the user confirms. The dev goto from title returns false as intended. Pause mode allows returning to dev because the screen is still pause. Settings from touch activates the settings page. Font slider labels are attached to their label elements.\n\nThe check-in screen must be added to the currentVerbs condition so its HUD verbs appear. beginCountdown sets the screen to checkinPlay internally, which would clash with a caller that also calls setScreen, so a dedicated startCheckin() helper is needed.\n\n`noteNotch` is safe during check-in because `event.notch` is undefined. The snapshot detune logic is sound: `state().detune` reads `tiltRad()` directly, so it stays current even if `fixed` is not called after the notch. The snapshot returns a music gain of 0.1.\n\nI will apply targeted fixes rather than rewrite the entire file. The `lookup` function calls `dialogueApi()`, which returns a promise, so passing that promise to `lineById` would crash the question screen. I must replace `lookup` with `lineById` and remove the unused `dialogueApi` import before any test runs. I also need to write about.js, render, main, and tests.\n\nThe title model mutates the screen to touch when coarse input is detected at render time. During attract between-passes, the state screen is forced to 'attract' even though the internal screen remains 'title'.\n\nThe DOM data-screen attribute may show 'attract' during the between-passes idle state even though the visible screen is title. This is a minor inconsistency. The test assertions for attract mode and event visits remain valid.\n\nThe four-event test needs roughly sixty seconds of advance time to see all visits, because the first event starts immediately and each subsequent one begins eighteen seconds after the previous one ends. A fruit-hat attract bankAt ninety-nine visit is counted at launch even if it falls before the eighteen-second cutoff. The unused `findLine` import will be removed once `lineById` replaces it. The about model does not set a heading field; its lines contain the content directly.\n\nThe about model will place its heading inside the lines array so tests can read it as text content. In the dev menu, nudge handles both slider kinds and music or sfx choice IDs. The settings music button is not a range input; it is a labeled toggle that left and right nudges cycle.\n\nThe music slider in settings will be a real range input so the mouse-drag test can use it. The live tuning API path and the DOM slider will both be kept for the slider tests.","signature":""},{"type":"tool_use","id":"call-3bba56ab-cf74-4cbd-95fe-4a7116d229c7-108","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","old_string":"import { findLine, takeLine } from '../data/dialogue.js';","new_string":"import { lineById, takeLine } from '../data/dialogue.js';\nimport { ABOUT } from '../data/about.js';"}},{"type":"tool_use","id":"call-3bba56ab-cf74-4cbd-95fe-4a7116d229c7-109","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","old_string":"function sayId(id) {\n    const line = findLineById(id);\n    if (!line) return;\n    speech = { who: 'Trudy', text: line.text, id: line.id };\n    speechLeft = Math.max(0.6, line.text.length / 16);\n    audio.say(line.text, 'trudy');\n  }\n\n  function choicesOf() {","new_string":"function choicesOf() {"}},{"type":"tool_use","id":"call-3bba56ab-cf74-4cbd-95fe-4a7116d229c7-110","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","old_string":"if (screen === 'reply') return setScreen('checkinPlay');","new_string":"if (screen === 'reply') { eventId = 'checkin'; beginCountdown(); return; }"}},{"type":"tool_use","id":"call-3bba56ab-cf74-4cbd-95fe-4a7116d229c7-111","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","old_string":"const lanes = extra.lanes || [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] }];","new_string":"const lanes = extra.lanes || (group && group.lanes && group.lanes.length ? group.lanes : [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] }]);"}},{"type":"tool_use","id":"call-3bba56ab-cf74-4cbd-95fe-4a7116d229c7-112","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js","old_string":"function findLineById(id) {\n    return findLine(id) ? null : null;\n  }\n\n  function choicesOf() {","new_string":"function choicesOf() {"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":14819,"output_tokens":4945,"cache_read_input_tokens":189952,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"be2dd378-cfd1-4cdc-8d17-4a0049c12a1c"}
