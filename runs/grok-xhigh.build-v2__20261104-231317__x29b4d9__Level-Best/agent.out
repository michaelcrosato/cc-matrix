[1].pressed) group.seats[i] = null;\\n    }\\n    if (sample.edges.confirm && !group.seats.some((s) => s && s.device === 'key')) {\\n      const slot = group.seats.findIndex((s) => !s);\\n      if (slot >= 0) {\\n        group.seats[slot] = { name: profile.name, device: 'key' };\\n        used = true;\\n      }\\n    }\\n    return used;\\n  }\\n\\n  function latchSlot() {\\n    if (!session || session.latched || !event) return;\\n    const result = event.result(0);\\n    session.parts.push(Math.round((result.form || 0) * 10));\\n    session.total = session.parts.reduce((a, b) => a + b, 0);\\n    session.best = medalLabel(result.medal || 'attended');\\n    session.latched = true;\\n    event.dispose();\\n    event = null;\\n    screen = 'results';\\n  }\\n\\n  function sessionFixed(dt) {\\n    const hub = globalThis.AIHub;\\n    if (!hub) return;\\n    const ms = hub.time();\\n    if (!Number.isFinite(ms)) {\\n      screen = 'card';\\n      const sample = inputs[0].poll(dt, 'menu');\\n      if (sample.edges.confirm) hub.answer('ready');\\n      if (sample.edges.ask) hub.answer('more');\\n      return;\\n    }\\n    const t = ms / 1000;\\n    if (t < 0) {\\n      screen = 'countdown';\\n      countLeft = Math.max(0, -t);\\n      return;\\n    }\\n    const slot = Math.min(session.slots.length, Math.floor(t / 62));\\n    const local = t - slot * 62;\\n    if (slot >= session.slots.length) {\\n      latchSlot();\\n      screen = 'waiting';\\n      sendResult();\\n      return;\\n    }\\n    if (session.slot !== slot) {\\n      latchSlot();\\n      session.slot = slot;\\n      session.playT = 0;\\n      session.latched = false;\\n      if (event) event.dispose();\\n      event = null;\\n      eventId = session.slots[slot];\\n    }\\n    if (local < 6) {\\n      screen = 'intro';\\n      session.scoreShown = session.total;\\n    } else if (local < 56) {\\n      if (!event && !session.latched) {\\n        startEvent(eventId, { session: true, lanes: [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[hub.me || 0] }] });\\n      }\\n      if (event && !session.latched) {\\n        const input = inputs[0];\\n        let snaps;\\n        if (botSkill) snaps = driveBots(dt);\\n        else {\\n          input.poll(dt, 'balance');\\n          snaps = [input.snapshot(0)];\\n        }\\n        stepEvent(dt, snaps);\\n        session.playT += dt;\\n        if (event.done || local >= 55.9) latchSlot();\\n        else screen = 'play';\\n      } else screen = 'results';\\n    } else if (!session.latched) latchSlot();\\n    else screen = 'results';\\n    if (t - session.lastProgress >= 1 || session.lastProgress < 0) {\\n      const label = `${eventTitle(session.slots[slot])} ${session.slot === 0 && local < 6 ? 0 : session.total}`.slice(0, 24);\\n      const score = session.slot === 0 && local < 6 ? 0 : session.total;\\n      hub.progress({ score, label });\\n      session.lastProgress = t;\\n    }\\n    if (t - session.lastGhost >= 0.1) {\\n      const lean = event && event.states ? event.states[0] : { leanX: 0, leanZ: 0, fallen: false };\\n      hub.send({\\n        t: 'g', a: slot, x: 0, z: 0,\\n        lx: Number((lean.leanX || 0).toFixed(3)),\\n        lz: Number((lean.leanZ || 0).toFixed(3)),\\n        c: 0, f: lean.fallen ? 1 : 0, s: session.total,\\n      }, { reliable: false });\\n      session.lastGhost = t;\\n    }\\n    void dt;\\n  }\\n\\n  function sendResult() {\\n    const hub = globalThis.AIHub;\\n    if (!session || session.sent || !hub) return;\\n    session.sent = true;\\n    const score = session.total || 0;\\n    hub.result({\\n      score,\\n      stats: { 'Floor Exercises': profile.floor, 'Best medal': session.best || 'Attended', 'Wobble Age': profile.ages[0] || 41 },\\n      awards: score >= 2500 ? ['Suspiciously Still'] : ['Showed Up'],\\n    });\\n  }\\n\\n  function eventTitle(id) {\\n    const Ctor = eventById(id);\\n    return Ctor ? Ctor.title : 'Class';\\n  }\\n\\n  function frame() {\\n    frames += 1;\\n    if (!locked) audio.tick();\\n    for (const fn of listeners) fn();\\n    paint();\\n  }\\n\\n  function model() {\\n    const device = inputs[0].lastDevice;\\n    const prompts = promptFor(currentVerbs(), device, settings.glyphs);\\n    const lines = [];\\n    const choices = [];\\n    let heading = '';\\n    const add = (id, label, extra = {}) => choices.push({ id, label, index: choices.length, focus: choices.length === focus, ...extra });\\n    if (coarse && screen === 'title') screen = 'touch';\\n    if (screen === 'touch') {\\n      lines.push('Controller or keyboard required');\\n      lines.push(TAGLINE);\\n      add('settings', 'Settings');\\n    } else if (screen === 'title' || (attract && attract.between > 0)) {\\n      lines.push(TAGLINE);\\n      lines.push('Press to begin');\\n      add('begin', 'Begin');\\n    } else if (screen === 'who') {\\n      heading = \\\"Who's here?\\\";\\n      add('begin', 'Begin');\\n      add('name', `Name: ${NAMES[profile.nameIndex]}`);\\n      add('paint', `Paint: ${PAINTS[profile.paintIndex].id}`);\\n      add('hat', `Hat: ${HATS[profile.hatIndex].label}`);\\n    } else if (screen === 'tutorial') {\\n      heading = 'How a day works';\\n      lines.push('You can lean, step, hop, and flail. You cannot type a name.');\\n      lines.push('Flail is a short save with a cooldown. It is not a free win.');\\n      add('on', 'Step on');\\n    } else if (screen === 'menu') {\\n      heading = 'Level Best Retreat';\\n      const cont = profile.dayIndex > 0 || profile.classDone.length ? 'Continue' : 'Programme';\\n      add('programme', cont);\\n      add('group', 'Group Class');\\n      add('free', 'Free Play');\\n      add('journal', 'Journal');\\n      add('settings', 'Settings');\\n      add('about', 'About / Credits');\\n    } else if (screen === 'morning') {\\n      heading = today().name;\\n      lines.push(speech ? speech.text : 'Good morning.');\\n      add('on', 'Continue');\\n    } else if (screen === 'question') {\\n      const q = QUESTIONS[profile.dayIndex % QUESTIONS.length];\\n      const line = lookup(q.ask);\\n      heading = 'A small question';\\n      lines.push(line ? line.text : 'Do you trust your knees?');\\n      if (q.kind === 'side') { add('left', 'Left'); add('right', 'Right'); }\\n      else { add('yes', 'Yes'); add('no', 'No'); }\\n    } else if (screen === 'reply') {\\n      heading = 'Trudy';\\n      lines.push(speech ? speech.text : 'Noted.');\\n      add('on', 'To the mat');\\n    } else if (screen === 'age') {\\n      heading = 'Wobble Age';\\n      lines.push(String(profile.ages[profile.ages.length - 1] || ''));\\n      lines.push('I did not ask how old you are. I asked your knees.');\\n      add('on', 'See the plan');\\n    } else if (screen === 'plan') {\\n      heading = today().name;\\n      const classes = today().classes;\\n      for (const id of classes) add(id, `${eventTitle(id)}${profile.classDone.includes(id) ? ' — stamped' : ''}`);\\n      if (!classes.length) lines.push('The day is open.');\\n    } else if (screen === 'intro') {\\n      const Ctor = eventById(eventId);\\n      heading = Ctor ? Ctor.title : 'Class';\\n      lines.push(Ctor ? Ctor.can : '');\\n      lines.push(Ctor ? Ctor.cant : '');\\n      add('go', 'Begin');\\n    } else if (screen === 'countdown') {\\n\",\"total_lines\":1350}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1e3f37e4-a105-4097-be85-f40b239bcb1a-4","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"180→  }]);\\n\\n  tests.push(['touch-only offers settings and no play', async () => {\\n    const game = await fresh({ coarse: true });\\n    assert(game.state().screen === 'touch', game.state().screen);\\n    assert(game.state().lines.some((line) => line.includes('Controller or keyboard required')), game.state().lines.join('|'));\\n    assert(game.state().choices.length === 1 && game.state().choices[0] === 'settings', game.state().choices.join(','));\\n    tap(game);\\n    await until(game, (s) => s.screen === 'settings', 2, 'touch settings');\\n    assert(!game.state().choices.includes('poses'), 'touch started a class');\\n190→  }]);\\n\\n  tests.push(['pause lists six choices', async () => {\\n    const game = await fresh();\\n    game.goto('play', { id: 'stillWater' });\\n    tap(game, 'Escape');\\n    await until(game, (s) => s.screen === 'pause', 2, 'pause');\\n    assert(game.state().choices.length === 6, game.state().choices.join(','));\\n  }]);\\n\\n200→  tests.push(['a hub slot keeps one score through the end of the minute', async () => {\\n    const previous = globalThis.AIHub;\\n    let ms = 0;\\n    const stepMs = 1000 / 120;\\n    const scores = [];\\n    globalThis.AIHub = {\\n      me: 0,\\n      players: [],\\n      time: () => {\\n        const now = ms;\\n210→        ms += stepMs;\\n        return now;\\n      },\\n      rng: (label) => {\\n        let n = 0;\\n        return () => (label === 'deal' && n++ === 0 ? 0.99 : 0.5);\\n      },\\n      on: () => {},\\n      ready: () => {},\\n      answer: () => {},\\n220→      send: () => {},\\n      progress: (body) => { scores.push(body.score); },\\n      result: () => {},\\n    };\\n    try {\\n      const game = await fresh();\\n      game.runSession({ room: 'test' });\\n      game.advance(45);\\n      const mid = game.state();\\n      assert(mid.sessionRound && mid.sessionRound.id === 'springboard', `slot ${mid.sessionRound && mid.sessionRound.id}`);\\n230→      assert(mid.sessionRound.slot === 0, `slot index ${mid.sessionRound.slot}`);\\n      assert(mid.sessionRound.parts.length === 1, `parts at 45s ${mid.sessionRound.parts.join(',')}`);\\n      assert(mid.screen === 'results', `screen at 45s ${mid.screen}`);\\n      assert(mid.event === null, 'the finished class was started again');\\n      const held = mid.sessionRound.total;\\n      game.advance(16.9);\\n      const end = game.state();\\n      assert(end.sessionRound.slot === 0, `left slot 0 at ${end.sessionRound.slot}`);\\n      assert(end.sessionRound.parts.length === 1, `parts at the end ${end.sessionRound.parts.join(',')}`);\\n      assert(end.sessionRound.total === held, `score changed from ${held} to ${end.sessionRound.total}`);\\n240→      assert(end.sessionRound.total <= 1000, `score ${end.sessionRound.total}`);\\n      assert(end.screen === 'results', `screen at the end ${end.screen}`);\\n      assert(scores.length > 0 && scores[scores.length - 1] <= 1000, `progress ${scores[scores.length - 1]}`);\\n      assert(scores.every((score) => score <= 1000), `progress climbed ${scores.join(',')}`);\\n    } finally {\\n      globalThis.AIHub = previous;\\n      setSessionMode(false);\\n    }\\n  }]);\\n\\n250→  tests.push(['a 6fps hub clock scores one 50s class', async () => {\\n    const previous = globalThis.AIHub;\\n    let ms = 0;\\n    const scores = [];\\n    globalThis.AIHub = {\\n      me: 0,\\n      players: [],\\n      time: () => ms,\\n      rng: (label) => {\\n        let n = 0;\\n260→        return () => (label === 'deal' && n++ === 0 ? 0.6 : 0.5);\\n      },\\n      on: () => {},\\n      ready: () => {},\\n      answer: () => {},\\n      send: () => {},\\n      progress: (body) => { scores.push(body.score); },\\n      result: () => {},\\n    };\\n    try {\\n270→      const game = await fresh();\\n      game.runSession({ room: 'test' });\\n      game.bot('sharp');\\n      const frame = 1 / 6;\\n      for (let i = 0; i < 372; i++) {\\n        ms = i * frame * 1000;\\n        game.advance(frame);\\n      }\\n      const end = game.state();\\n      assert(end.sessionRound && end.sessionRound.id === 'plates', `class ${end.sessionRound && end.sessionRound.id}`);\\n280→      assert(end.sessionRound.slot === 0, `slot ${end.sessionRound.slot}`);\\n      assert(end.sessionRound.parts.length === 1, `parts ${end.sessionRound.parts.join(',')}`);\\n      assert(end.sessionRound.total > 0 && end.sessionRound.total <= 1000, `score ${end.sessionRound.total}`);\\n      assert(end.sessionRound.total === end.sessionRound.parts[0], 'the part is not the total');\\n      assert(end.screen === 'results', `screen ${end.screen}`);\\n      assert(end.event === null, 'the class was still live');\\n      assert(scores.some((score) => score === end.sessionRound.total), 'progress never showed the score');\\n      assert(scores.every((score) => score <= 1000), 'progress climbed past one class');\\n    } finally {\\n      globalThis.AIHub = previous;\\n290→      setSessionMode(false);\\n    }\\n  }]);\\n\\n  return tests;\\n}\\n\",\"content_concise\":\"180→  }]);\\n\\n  tests.push(['touch-only offers settings and no play', async () => {\\n    const game = await fresh({ coarse: true });\\n    assert(game.state().screen === 'touch', game.state().screen);\\n    assert(game.state().lines.some((line) => line.includes('Controller or keyboard required')), game.state().lines.join('|'));\\n    assert(game.state().choices.length === 1 && game.state().choices[0] === 'settings', game.state().choices.join(','));\\n    tap(game);\\n    await until(game, (s) => s.screen === 'settings', 2, 'touch settings');\\n    assert(!game.state().choices.includes('poses'), 'touch started a class');\\n190→  }]);\\n\\n  tests.push(['pause lists six choices', async () => {\\n    const game = await fresh();\\n    game.goto('play', { id: 'stillWater' });\\n    tap(game, 'Escape');\\n    await until(game, (s) => s.screen === 'pause', 2, 'pause');\\n    assert(game.state().choices.length === 6, game.state().choices.join(','));\\n  }]);\\n\\n200→  tests.push(['a hub slot keeps one score through the end of the minute', async () => {\\n    const previous = globalThis.AIHub;\\n    let ms = 0;\\n    const stepMs = 1000 / 120;\\n    const scores = [];\\n    globalThis.AIHub = {\\n      me: 0,\\n      players: [],\\n      time: () => {\\n        const now = ms;\\n210→        ms += stepMs;\\n        return now;\\n      },\\n      rng: (label) => {\\n        let n = 0;\\n        return () => (label === '