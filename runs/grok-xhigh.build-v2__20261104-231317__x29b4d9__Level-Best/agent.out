piked > before, `${id} ragdoll did not spawn (${before} to ${spiked})`);\n  let steps = 0;\n  while (first.states[0].fallen && steps < 120 * 6) {\n    first.fixed(DT, [{ wishX: 0, wishZ: 0, feetL: 0, feetR: 0 }]);\n    steps += 1;\n  }\n  assert(!first.states[0].fallen, `${id} did not recover`);\n  assert(first.states[0].falls === 1, `${id} refell during recovery`);\n  assert(first.rags[0] === null, `${id} ragdoll left behind`);\n  const lean = readLean(first.dolls[0].body);\n  assert(Number.isFinite(lean.tilt), `${id} NaN after recovery`);\n  assert(first.world.bodies.len() < spiked, `${id} bodies ${first.world.bodies.len()} vs spiked ${spiked}`);"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":1497,"output_tokens":2190,"cache_read_input_tokens":76672,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"31114085-ec98-4923-8ff7-6fa024052922"}
