\"match_count\":19,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/tools/hub/harness.html\",\"matches\":[{\"line_number\":67,\"content\":\"import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\"},{\"line_number\":76,\"content\":\"const playMs = Number(params.get('play')) || 6000;\"},{\"line_number\":429,\"content\":\"    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\"},{\"line_number\":456,\"content\":\"    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\"},{\"line_number\":465,\"content\":\"    await randomly(Math.min(1500, playMs / 4));\"},{\"line_number\":479,\"content\":\"    await randomly(playMs / 2);\"},{\"line_number\":497,\"content\":\"    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/tools/hub/bridge.js\",\"matches\":[{\"line_number\":226,\"content\":\"        return toGame({ type: 'time-up', graceMs: m.graceMs });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/tools/hub/round.js\",\"matches\":[{\"line_number\":15,\"content\":\"export const TIMINGS = Object.freeze({\"},{\"line_number\":20,\"content\":\"  countdownMs: 3_000,\"},{\"line_number\":21,\"content\":\"  graceMs: 5_000,\"},{\"line_number\":61,\"content\":\"export function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\"},{\"line_number\":190,\"content\":\"  timings = TIMINGS,\"},{\"line_number\":195,\"content\":\"  const t = { ...TIMINGS, ...timings };\"},{\"line_number\":327,\"content\":\"    goAt = clock.now() + t.countdownMs;\"},{\"line_number\":329,\"content\":\"    later(t.countdownMs, () => {\"},{\"line_number\":335,\"content\":\"    later(t.countdownMs + limitMs, timeUp);\"},{\"line_number\":342,\"content\":\"    toPresent({ type: 'time-up', graceMs: t.graceMs });\"},{\"line_number\":343,\"content\":\"    later(t.graceMs, () => {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"233d5d74-e9e1-4ee3-a834-37e158557e1b"}
