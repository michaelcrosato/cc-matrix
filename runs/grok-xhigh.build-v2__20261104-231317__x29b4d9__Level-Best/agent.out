__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/plank.js\",\"matches\":[{\"line_number\":14,\"content\":\"  static id = 'plank';\"},{\"line_number\":15,\"content\":\"  static title = 'Plank & Perch';\"},{\"line_number\":18,\"content\":\"  static couch = false;\"},{\"line_number\":19,\"content\":\"  static session = false;\"},{\"line_number\":20,\"content\":\"  static can = 'Hold the plank. Counter the gulls with your weight. Flail shakes them off.';\"},{\"line_number\":21,\"content\":\"  static cant = 'Stay outside the zone for two seconds and you belly-flop. That rep of pride is gone.';\"},{\"line_number\":22,\"content\":\"  static verbs = ['weight', 'flail'];\"},{\"line_number\":97,\"content\":\"    if (this.t >= this.duration) this.done = true;\"},{\"line_number\":100,\"content\":\"  result(i = 0) {\"},{\"line_number\":111,\"content\":\"  botInput(i, skill) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/springboard.js\",\"matches\":[{\"line_number\":11,\"content\":\"  static id = 'springboard';\"},{\"line_number\":12,\"content\":\"  static title = 'Springboard';\"},{\"line_number\":15,\"content\":\"  static couch = true;\"},{\"line_number\":16,\"content\":\"  static session = true;\"},{\"line_number\":17,\"content\":\"  static can = 'Pump both feet as the board goes down. Hop near the top. In the air, aim for a clean line or a proud flop.';\"},{\"line_number\":18,\"content\":\"  static cant = 'You cannot steer the board with your weight. Late pumping barely lifts you.';\"},{\"line_number\":19,\"content\":\"  static verbs = ['leftFoot', 'rightFoot', 'hop', 'weight'];\"},{\"line_number\":91,\"content\":\"    if (this.scores.length >= 3) this.done = true;\"},{\"line_number\":116,\"content\":\"      this.done = true;\"},{\"line_number\":127,\"content\":\"  result(i = 0) {\"},{\"line_number\":138,\"content\":\"