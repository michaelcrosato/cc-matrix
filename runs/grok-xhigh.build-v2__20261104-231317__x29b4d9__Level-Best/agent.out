tent\":\"  function startEvent(id, extra = {}) {\"},{\"line_number\":300,\"content\":\"    if (screen === 'reply') { eventId = 'checkin'; beginCountdown(); return; }\"},{\"line_number\":302,\"content\":\"    if (screen === 'plan' && eventById(id)) return openIntro(id);\"},{\"line_number\":303,\"content\":\"    if (screen === 'intro') return beginCountdown();\"},{\"line_number\":305,\"content\":\"      if (id === 'retry') return openIntro(eventId);\"},{\"line_number\":318,\"content\":\"    if (screen === 'free' && eventById(id)) return openIntro(id);\"},{\"line_number\":355,\"content\":\"  function openIntro(id) {\"},{\"line_number\":357,\"content\":\"    tier = (pendingStart && pendingStart.tier) || tierFor(id);\"},{\"line_number\":361,\"content\":\"  function beginCountdown() {\"},{\"line_number\":363,\"content\":\"    const extra = pendingStart || {};\"},{\"line_number\":364,\"content\":\"    pendingStart = null;\"},{\"line_number\":365,\"content\":\"    startEvent(eventId, {\"},{\"line_number\":420,\"content\":\"    openIntro(group.playlist[group.cursor]);\"},{\"line_number\":433,\"content\":\"    if (id === 'restart') { openIntro(eventId); return; }\"},{\"line_number\":497,\"content\":\"      return openIntro(id.slice(5));\"},{\"line_number\":513,\"content\":\"      return openIntro(playlist[0]);\"},{\"line_number\":709,\"content\":\"    startEvent(id, { god: id !== 'fruitHat', lanes: [{ id: 0, kind: 'bot', name: 'Demo', colour: SEAT_COLOURS[1] }] });\"},{\"line_number\":805,\"content\":\"        startEvent(eventId, { session: true, lanes: [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[hub.me || 0] }] });\"},{\"line_number\":1245,\"content\":\"        pendingStart = args;\"},{\"line_number\":1246,\"content\":\"        openIntro(args.id);\"},{\"line_number\":1247,\"content\":\"        beginCountdown();\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"d24df572-fd10-472e-83e5-210a97