umber\":425,\"content\":\"    if (screen === 'dev') return setScreen('pause');\"},{\"line_number\":426,\"content\":\"    if (screen === 'pause') { paused = false; return setScreen('play'); }\"},{\"line_number\":427,\"content\":\"    if (screen === 'plan' || screen === 'island') return setScreen('menu');\"},{\"line_number\":428,\"content\":\"    if (screen === 'who') return setScreen('title');\"},{\"line_number\":432,\"content\":\"    if (id === 'resume') { paused = false; return setScreen('play'); }\"},{\"line_number\":434,\"content\":\"    if (id === 'howto') return setScreen('howto');\"},{\"line_number\":435,\"content\":\"    if (id === 'settings') return setScreen('settings');\"},{\"line_number\":436,\"content\":\"    if (id === 'dev') { devFromPause = true; return setScreen('dev'); }\"},{\"line_number\":440,\"content\":\"      return setScreen('island');\"},{\"line_number\":453,\"content\":\"    if (id === 'reset') return setScreen('confirm-reset');\"},{\"line_number\":468,\"content\":\"    if (id === 'results') { finishEvent(); return setScreen('results'); }\"},{\"line_number\":474,\"content\":\"      return setScreen('ending');\"},{\"line_number\":481,\"content\":\"    if (id === 'wipe') return setScreen('confirm-reset');\"},{\"line_number\":515,\"content\":\"    if (id === 'back') return setScreen('menu');\"},{\"line_number\":598,\"content\":\"        else setScreen('results');\"},{\"line_number\":611,\"content\":\"      return setScreen('pause');\"},{\"line_number\":621,\"content\":\"        else setScreen('results');\"},{\"line_number\":627,\"content\":\"      if (countLeft <= 0) setScreen('play');\"},{\"line_number\":695,\"content\":\"    setScreen('age');\"},{\"line_number\":699,\"content\":\"    setScreen('question');\"},{\"line_number\":1251,\"content\":\"        setScreen('play');\"},{\"line_number\":1268,\"content\":\"    setCoarse(on) { coarse = !!on; if (coarse && screen === 'title') setScreen('touch'); if (!coarse && screen === 'touch') setScreen('