tested from its own start\\n- [completed] shell: Menus, attract, dev sliders, audio, glyphs, touch-only, Group Class, hub ghost\\n- [completed] ship: Ending, About, exit-interview, full tests, two launches, hub log\\n\",\"todos\":[{\"content\":\"Pick GameTitle with RNG, record in PROGRESS.md, create dev subfolder\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Boot single-file build: Three r180 ink, Rapier, hub client, WebGL2 fallback, test hook\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Balance core, input, disc, doll, ragdoll, Fruit Hat, tests from a fresh world\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Island ritual and every §6 event, each tested from its own start\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Menus, attract, dev sliders, audio, glyphs, touch-only, Group Class, hub ghost\",\"priority\":\"medium\",\"status\":\"completed\"},{\"content\":\"Ending, About, exit-interview, full tests, two launches, hub log\",\"priority\":\"medium\",\"status\":\"completed\"}],\"state\":{\"todos\":{\"title\":{\"content\":\"Pick GameTitle with RNG, record in PROGRESS.md, create dev subfolder\",\"priority\":\"medium\",\"status\":\"completed\"},\"boot\":{\"content\":\"Boot single-file build: Three r180 ink, Rapier, hub client, WebGL2 fallback, test hook\",\"priority\":\"medium\",\"status\":\"completed\"},\"balance\":{\"content\":\"Balance core, input, disc, doll, ragdoll, Fruit Hat, tests from a fresh world\",\"priority\":\"medium\",\"status\":\"completed\"},\"events\":{\"content\":\"Island ritual and every §6 event, each tested from its own start\",\"priority\":\"medium\",\"status\":\"completed\"},\"shell\":{\"content\":\"Menus, attract, dev sliders, audio, glyphs, touch-only, Group Class, hub ghost\",\"priority\":\"medium\",\"status\":\"completed\"},\"ship\":{\"content\":\"Ending, About, exit-interview, full tests, two launches, hub log\",\"priority\":\"medium\",\"status\":\"complete