12,44,32,102,108,97,105,108,58,32,102,97,108,115,101,32,125,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":5,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/fruitHat.js\",\"matches\":[{\"line_number\":81,\"content\":\"    const reach = Math.sin(getTune('maxLean') * DEG) * 1.5;\"},{\"line_number\":237,\"content\":\"    const reach = Math.max(0.2, Math.sin(getTune('maxLean') * DEG) * 1.5);\"},{\"line_number\":243,\"content\":\"      x = dx / reach;\"},{\"line_number\":244,\"content\":\"      y = -dz / reach;\"},{\"line_number\":252,\"content\":\"    return { x: x * s, y: y * s, hop, flail: false };\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"e1965db7-c8bf-4113-a462-6419d77dc33b"}
