oupclass.js  session.js  ghost.js  ending.js\"},{\"line_number\":718,\"content\":\"const session = readFileSync('vendor/session.js', 'utf8').replace(/\\\\r\\\\n/g, '\\\\n');\"},{\"line_number\":720,\"content\":\"const hash = createHash('sha256').update(session.slice(session.indexOf('/*! aihub-session '), session.indexOf(END) + END.length)).digest('hex');\"},{\"line_number\":721,\"content\":\"if (hash !== '529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a') throw new Error('not the released hub client');\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"9081fbef-492b-4f23-9285-ed06d0bc019c"}
