a2b3c4d) {\\n  baseSeed = seed >>> 0;\\n  streams.clear();\\n}\\n\\nfunction mulberry32(seed) {\\n  let a = seed >>> 0;\\n  return function next() {\\n20→    a = (a + 0x6d2b79f5) >>> 0;\\n    let t = a;\\n    t = Math.imul(t ^ (t >>> 15), t | 1);\\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\\n  };\\n}\\n\\nfunction hashLabel(label) {\\n  let h = 2166136261;\\n30→  const s = String(label);\\n  for (let i = 0; i < s.length; i++) {\\n    h ^= s.charCodeAt(i);\\n    h = Math.imul(h, 16777619);\\n  }\\n  return (h ^ baseSeed) >>> 0;\\n}\\n\\nfunction generatorFor(label) {\\n  let g = streams.get(label);\\n40→  if (g) return g;\",\"content_concise\":\"1→/** The only randomness in the game. Gameplay draws go through rng(label). */\\n\\nconst streams = new Map();\\nlet baseSeed = 0x1a2b3c4d;\\nlet session = false;\\n\\nexport function setSessionMode(on) {\\n  session = !!on;\\n  streams.clear();\\n10→}\\n\\nexport function resetRng(seed = 0x1a2b3c4d) {\\n  baseSeed = seed >>> 0;\\n  streams.clear();\\n}\\n\\nfunction mulberry32(seed) {\\n  let a = seed >>> 0;\\n  return function next() {\\n20→    a = (a + 0x6d2b79f5) >>> 0;\\n    let t = a;\\n    t = Math.imul(t ^ (t >>> 15), t | 1);\\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\\n  };\\n}\\n\\nfunction hashLabel(label) {\\n  let h = 2166136261;\\n30→  const s = String(label);\\n  for (let i = 0; i < s.length; i++) {\\n    h ^= s.charCodeAt(i);\\n    h = Math.imul(h, 16777619);\\n  }\\n  return (h ^ baseSeed) >>> 0;\\n}\\n\\nfunction generatorFor(label) {\\n  let g = streams.get(label);\\n40→  if (g) return g;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/core/rng.js\",\"offset\":null,\"limit\":40,\"raw_output\":\"/** The only randomness in the game. Gameplay draws go through rng(label). */\\n\\nconst streams = new Map();\\nlet baseSeed = 0x1a2b3c4d;\\nlet session = false;\\n\\nexport function setSessionMode(on) {\\n  session = !!on;\\n  streams.clear();\\n}\\n\\nexport function resetRng(seed = 0x1a2b3c4d) {\\n  baseSeed = seed >>> 0;\\n  streams.clear();\\n}\\n\\nfunction mulberry32(seed) {\\n  let a = seed >>> 0;\\n  return function next() {\\n    a = (a + 0x6d2b79f5) >>> 0;\\n    let t = a;\\n    t = Math.imul(t ^ (t >>> 15), t | 1);\\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\\n  };\\n}\\n\\nfunction hashLabel(label) {\\n  let h = 2166136261;\\n  const s = String(label);\\n  for (let i = 0; i < s.length; i++) {\\n    h ^= s.charCodeAt(i);\\n    h = Math.imul(h, 16777619);\\n  }\\n  return (h ^ baseSeed) >>> 0;\\n}\\n\\nfunction generatorFor(label) {\\n  let g = streams.get(label);\\n  if (g) return g;\\n\",\"total_lines\":70}}","is_error":false},{"type":"tool_result","tool_use_id":"call-78beffd0-56b8-499e-b80a-91fe6c9d51ce-36","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { SAVE_VERSION } from '../data/config.js';\\n\\nexport function memoryStorage() {\\n  const map = new Map();\\n  return {\\n    getItem(key) { return map.has(key) ? map.get(key) : null; },\\n    setItem(key, value) { map.set(key, String(value)); },\\n    removeItem(key) { map.delete(key); },\\n  };\\n10→}\\n\\nexport function readSave(storage, key) {\\n  try {\\n    const raw = storage.getItem(key);\\n    if (!raw) return null;\\n    const data = JSON.parse(raw);\\n    if (!data || data.version !== SAVE_VERSION || !data.profile) return null;\\n    return data;\\n  } catch {\\n20→    return null;\\n  }\\n}\\n\\nexport function writeSave(storage, key, data) {\\n  const payload = JSON.stringify({ ...data, version: SAVE_VERSION });\\n  try {\\n    storage.setItem(key, payload);\\n    return true;\\n  } catch {\\n30→    return false;\\n  }\\n}\\n\",\"content_concise\":\"1→import { SAVE_VERSION } from '../data/config.js';\\n\\nexport function memoryStorage() {\\n  const map = new Map();\\n  return {\\n    getItem(key) { return map.has(key) ? map.get(key) : null; },\\n    setItem(key, value) { map.set(key, String(value)); },\\n    removeItem(key) { map.delete(key); },\\n  };\\n10→}\\n\\nexport function readSave(storage, key) {\\n  try {\\n    const raw = storage.getItem(key);\\n    if (!raw) return null;\\n    const data = JSON.parse(raw);\\n    if (!data || data.version !== SAVE_VERSION || !data.profile) return null;\\n    return data;\\n  } catch {\\n20→    return null;\\n  }\\n}\\n\\nexport function writeSave(storage, key, data) {\\n  const payload = JSON.stringify({ ...data, version: SAVE_VERSION });\\n  try {\\n    storage.setItem(key, payload);\\n    return true;\\n  } catch {\\n30→    return false;\\n  }\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/core/save.js\",\"offset\":null,\"raw_output\":\"import { SAVE_VERSION } from '../data/config.js';\\n\\nexport function memoryStorage() {\\n  const map = new Map();\\n  return {\\n    getItem(key) { return map.has(key) ? map.get(key) : null; },\\n    setItem(key, value) { map.set(key, String(value)); },\\n    removeItem(key) { map.delete(key); },\\n  };\\n}\\n\\nexport function readSave(storage, key) {\\n  try {\\n    const raw = storage.getItem(key);\\n    if (!raw) return null;\\n    const data = JSON.parse(raw);\\n    if (!data || data.version !== SAVE_VERSION || !data.profile) return null;\\n    return data;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport function writeSave(storage, key, data) {\\n  const payload = JSON.stringify({ ...data, version: SAVE_VERSION });\\n  try {\\n    storage.setItem(key, payload);\\n    return true;\\n  } catch {\\n    return false;\\n  }\\n}\\n\",\"total_lines\":32}}","is_error":false},{"type":"tool_result","tool_use_id":"call-78beffd0-56b8-499e-b80a-91fe6c9d51ce-37","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { createGame } from './game/director.js';\\nimport { createStage } from './render/renderer.js';\\nimport { renderProbe } from './audio/engine.js';\\nimport { TITLE } from './data/config.js';\\n\\nconst params = new URLSearchParams(location.search);\\nconst coarse = window.matchMedia('(pointer: coarse)').matches && !window.matchMedia('(any-pointer: fine)').matches;\\n\\nconst canvas = document.createElement('canvas');\\n10→canvas.id = 'view';\\ndocument.body.appendChild(canvas);\\n\\nconst boot = document.createElement('p');\\nboot.id = 'boot-line';\\nboot.textContent = TITLE;\\ndocument.body.appendChild(boot);\\n\\nconst errors = [];\\nwindow.addEventListener('error', (event) => { errors.push(String(event.message || 'error')); });\\n20→window.addEventListener('unhandledrejection', (event) => {\\n  const reason = event.reason;\\n  errors.push(String((reason && reason.message) || reason || 'rejection'));\\n});\\n\\nconst game = await createGame({\\n  window,\\n  document,\\n  coarse,\\n  manual: params.get('manual') === '1',\\n30→});\\n\\nconst pads = [null, null, null, null];\\nwindow.__pads = pads;\\ngame.setPadSource(() => pads.map((pad, i) => pad || game.pads[i]));\\n\\nfunction publish(info) {\\n  const render = {\\n    backend: info ? info.backend : 'none',\\n    lost: info ? info.lost : null,\\n40→    frames: info ? info.frames : 0,\\n    width: info ? info.width : 0,\\n    height: info ? info.height : 0,\\n  };\\n  window.__RENDER__ = { ...render, errors: errors.slice() };\\n  game.setRender(render);\\n}\\n\\nif (params.get('test') === '1') {\\n  window.__TEST__ = {\\n50→    state: () => game.state(),\\n    advance: (seconds) => game.advance(seconds),\\n    bot: (skill, opt) => game.bot(skill, opt),\\n    goto: (screen, args) => game.goto(screen, args),\\n    tuning: game.tuning,\\n    settings: game.settings,\\n    activate: (index) => game.activate(index),\\n    key: (code, down) => game.key(code, down),\\n    pointer: (x, y, buttons) => game.pointer(x, y, buttons),\\n    pad: (i) => game.pad(i),\\n60→    pads: game.pads,\\n    setCoarse: (on) => game.setCoarse(on),\\n    setPadSource: (fn) => game.setPadSource(fn),\\n    audio: game.audio,\\n    probe: (kind, id) => renderProbe(kind, id),\\n    errors: () => errors.slice(),\\n    TITLE,\\n  };\\n}\\n\\n70→const hub = globalThis.AIHub;\\nconst connecting = hub && hub.active ? hub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\\n\\nlet stage = null;\\nconst stagePromise = params.get('render') === '0'\\n  ? null\\n  : createStage(canvas, { session: !!(hub && hub.active) }).then((made) => {\\n    stage = made;\\n    publish(stage.info());\\n    return made;\\n80→  }).catch((err) => {\",\"content_concise\":\"1→import { createGame } from './game/director.js';\\nimport { createStage } from './render/renderer.js';\\nimport { renderProbe } from './audio/engine.js';\\nimport { TITLE } from './data/config.js';\\n\\nconst params = new URLSearchParams(location.search);\\nconst coarse = window.matchMedia('(pointer: coarse)').matches && !window.matchMedia('(any-pointer: fine)').matches;\\n\\nconst canvas = document.createElement('canvas');\\n10→canvas.id = 'view';\\ndocument.body.appendChild(canvas);\\n\\nconst boot = document.createElement('p');\\nboot.id = 'boot-line';\\nboot.textContent = TITLE;\\ndocument.body.appendChild(boot);\\n\\nconst errors = [];\\nwindow.addEventListener('error', (event) => { errors.push(String(event.message || 'error')); });\\n20→window.addEventListener('unhandledrejection', (event) => {\\n  const reason = event.reason;\\n  errors.push(String((reason && reason.message) || reason || 'rejection'));\\n});\\n\\nconst game = await createGame({\\n  window,\\n  document,\\n  coarse,\\n  manual: params.get('manual') === '1',\\n30→});\\n\\nconst pads = [null, null, null, null];\\nwindow.__pads = pads;\\ngame.setPadSource(() => pads.map((pad, i) => pad || game.pads[i]));\\n\\nfunction publish(info) {\\n  const render = {\\n    backend: info ? info.backend : 'none',\\n    lost: info ? info.lost : null,\\n40→    frames: info ? info.frames : 0,\\n    width: info ? info.width : 0,\\n    height: info ? info.height : 0,\\n  };\\n  window.__RENDER__ = { ...render, errors: errors.slice() };\\n  game.setRender(render);\\n}\\n\\nif (params.get('test') === '1') {\\n  window.__TEST__ = {\\n50→    state: () => game.state(),\\n    advance: (seconds) => game.advance(seconds),\\n    bot: (skill, opt) => game.bot(skill, opt),\\n    goto: (screen, args) => game.goto(screen, args),\\n    tuning: game.tuning,\\n    settings: game.settings,\\n    activate: (index) => game.activate(index),\\n    key: (code, down) => game.key(code, down),\\n    pointer: (x, y, buttons) => game.pointer(x, y, buttons),\\n    pad: (i) => game.pad(i),\\n60→    pads: game.pads,\\n    setCoarse: (on) => game.setCoarse(on),\\n    setPadSource: (fn) => game.setPadSource(fn),\\n    audio: game.audio,\\n    probe: (kind, id) => renderProbe(kind, id),\\n    errors: () => errors.slice(),\\n    TITLE,\\n  };\\n}\\n\\n70→const hub = globalThis.AIHub;\\nconst connecting = hub && hub.active ? hub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\\n\\nlet stage = null;\\nconst stagePromise = params.get('render') === '0'\\n  ? null\\n  : createStage(canvas, { session: !!(hub && hub.active) }).then((made) => {\\n    stage = made;\\n    publish(stage.info());\\n    return made;\\n80→  }).catch((err) => {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/main.js\",\"offset\":null,\"limit\":80,\"raw_output\":\"import { createGame } from './game/director.js';\\nimport { createStage } from './render/renderer.js';\\nimport { renderProbe } from './audio/engine.js';\\nimport { TITLE } from './data/config.js';\\n\\nconst params = new URLSearchParams(location.search);\\nconst coarse = window.matchMedia('(pointer: coarse)').matches && !window.matchMedia('(any-pointer: fine)').matches;\\n\\nconst canvas = document.createElement('canvas');\\ncanvas.id = 'view';\\ndocument.body.appendChild(canvas);\\n\\nconst boot = document.createElement('p');\\nboot.id = 'boot-line';\\nboot.textContent = TITLE;\\ndocument.body.appendChild(boot);\\n\\nconst errors = [];\\nwindow.addEventListener('error', (event) => { errors.push(String(event.message || 'error')); });\\nwindow.addEventListener('unhandledrejection', (event) => {\\n  const reason = event.reason;\\n  errors.push(String((reason && reason.message) || reason || 'rejection'));\\n});\\n\\nconst game = await createGame({\\n  window,\\n  document,\\n  coarse,\\n  manual: params.get('manual') === '1',\\n});\\n\\nconst pads = [null, null, null, null];\\nwindow.__pads = pads;\\ngame.setPadSource(() => pads.map((pad, i) => pad || game.pads[i]));\\n\\nfunction publish(info) {\\n  const render = {\\n    backend: info ? info.backend : 'none',\\n    lost: info ? info.lost : null,\\n    frames: info ? info.frames : 0,\\n    width: info ? info.width : 0,\\n    height: info ? info.height : 0,\\n  };\\n  window.__RENDER__ = { ...render, errors: errors.slice() };\\n  game.setRender(render);\\n}\\n\\nif (params.get('test') === '1') {\\n  window.__TEST__ = {\\n    state: () => game.state(),\\n    advance: (seconds) => game.advance(seconds),\\n    bot: (skill, opt) => game.bot(skill, opt),\\n    goto: (screen, args) => game.goto(screen, args),\\n    tuning: game.tuning,\\n    settings: game.settings,\\n    activate: (index) => game.activate(index),\\n    key: (code, down) => game.key(code, down),\\n    pointer: (x, y, buttons) => game.pointer(x, y, buttons),\\n    pad: (i) => game.pad(i),\\n    pads: game.pads,\\n    setCoarse: (on) => game.setCoarse(on),\\n    setPadSource: (fn) => game.setPadSource(fn),\\n    audio: game.audio,\\n    probe: (kind, id) => renderProbe(kind, id),\\n    errors: () => errors.slice(),\\n    TITLE,\\n  };\\n}\\n\\nconst hub = globalThis.AIHub;\\nconst connecting = hub && hub.active ? hub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\\n\\nlet stage = null;\\nconst stagePromise = params.get('render') === '0'\\n  ? null\\n  : createStage(canvas, { session: !!(hub && hub.active) }).then((made) => {\\n    stage = made;\\n    publish(stage.info());\\n    return made;\\n  }).catch((err) => {\\n\",\"total_lines\":112}}","is_error":false},{"type":"tool_result","tool_use_id":"call-78beffd0-56b8-499e-b80a-91fe6c9d51ce-38","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>AI Hub Session Harness</title>\\n<meta name=\\\"description\\\" content=\\\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\\\">\\n<style>\\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\\n10→  * { box-sizing: border-box; }\\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\\n  body { display: grid; grid-template-rows: auto 1fr; }\\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\\n  input[type=number] { width: 70px; }\\n  input.game { width: 300px; }\\n  button { cursor: pointer; }\\n20→  button:hover { border-color: var(--dim); }\\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\\n  .cell__state { margin-left: auto; color: var(--dim); }\\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\\n  .cell.is-out { opacity: .35; }\\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\\n30→  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\\n  #checks li { list-style: none; }\\n  #checks ul { margin: 0; padding: 0; }\\n  .ok::before { content: '✓ '; color: var(--ok); }\\n  .bad::before { content: '✗ '; color: var(--bad); }\\n  .wait::before { content: '… '; color: var(--warn); }\\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\\n  #round { white-space: pre-wrap; font-size: 13px; }\\n  .hint { color: var(--dim); }\\n40→</style>\\n</head>\\n<body>\\n<header>\\n  <h1>AI Hub session harness</h1>\\n  <label>Game <input class=\\\"game\\\" id=\\\"game\\\" placeholder=\\\"mygame.html or /games/mygame/index.html\\\"></label>\\n  <label>Players <select id=\\\"players\\\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\\n  <label>Latency <input type=\\\"number\\\" id=\\\"latency\\\" min=\\\"0\\\" value=\\\"60\\\"> ms</label>\\n  <label>Jitter <input type=\\\"number\\\" id=\\\"jitter\\\" min=\\\"0\\\" value=\\\"20\\\"> ms</label>\\n  <label>Loss <input type=\\\"number\\\" id=\\\"loss\\\" min=\\\"0\\\" max=\\\"50\\\" value=\\\"0\\\"> %</label>\\n50→  <button id=\\\"restart\\\" type=\\\"button\\\">New round</button>\\n  <button id=\\\"release\\\" type=\\\"button\\\" title=\\\"End the splash now: the round starts once every game has loaded\\\">Start now</button>\\n  <button id=\\\"timeup\\\" type=\\\"button\\\">Time up</button>\\n  <label>Remove <select id=\\\"who\\\"></select></label>\\n  <button id=\\\"remove\\\" type=\\\"button\\\">Remove player</button>\\n  <button id=\\\"hide\\\" type=\\\"button\\\" aria-pressed=\\\"false\\\">Hide host tab</button>\\n</header>\\n<main>\\n  <div id=\\\"grid\\\"><p class=\\\"hint\\\" style=\\\"padding:16px\\\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\\n  <aside>\\n60→    <section><h2>Round</h2><div id=\\\"round\\\" class=\\\"hint\\\">No round yet.</div></section>\\n    <section id=\\\"checks\\\"><h2>Conformance</h2><ul id=\\\"checklist\\\"><li class=\\\"hint\\\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\\n    <pre id=\\\"log\\\" aria-live=\\\"off\\\"></pre>\\n  </aside>\\n</main>\\n<script type=\\\"module\\\">\\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\\n\\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\\n70→const params = new URLSearchParams(location.search);\\nconst $ = (id) => document.getElementById(id);\\nconst auto = params.get('auto') === '1';\\nconst scenario = params.get('scenario') || 'standard';\\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\\nconst serverMode = scenario === 'server';\\nconst playMs = Number(params.get('play')) || 6000;\\nconst SPLASH_MS = 10_000;\\n\\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\\n80→  if (params.has(key)) $(id).value = params.get(key);\",\"content_concise\":\"1→<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>AI Hub Session Harness</title>\\n<meta name=\\\"description\\\" content=\\\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\\\">\\n<style>\\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\\n10→  * { box-sizing: border-box; }\\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\\n  body { display: grid; grid-template-rows: auto 1fr; }\\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\\n  input[type=number] { width: 70px; }\\n  input.game { width: 300px; }\\n  button { cursor: pointer; }\\n20→  button:hover { border-color: var(--dim); }\\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\\n  .cell__state { margin-left: auto; color: var(--dim); }\\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\\n  .cell.is-out { opacity: .35; }\\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\\n30→  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\\n  #checks li { list-style: none; }\\n  #checks ul { margin: 0; padding: 0; }\\n  .ok::before { content: '✓ '; color: var(--ok); }\\n  .bad::before { content: '✗ '; color: var(--bad); }\\n  .wait::before { content: '… '; color: var(--warn); }\\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\\n  #round { white-space: pre-wrap; font-size: 13px; }\\n  .hint { color: var(--dim); }\\n40→</style>\\n</head>\\n<body>\\n<header>\\n  <h1>AI Hub session harness</h1>\\n  <label>Game <input class=\\\"game\\\" id=\\\"game\\\" placeholder=\\\"mygame.html or /games/mygame/index.html\\\"></label>\\n  <label>Players <select id=\\\"players\\\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\\n  <label>Latency <input type=\\\"number\\\" id=\\\"latency\\\" min=\\\"0\\\" value=\\\"60\\\"> ms</label>\\n  <label>Jitter <input type=\\\"number\\\" id=\\\"jitter\\\" min=\\\"0\\\" value=\\\"20\\\"> ms</label>\\n  <label>Loss <input type=\\\"number\\\" id=\\\"loss\\\" min=\\\"0\\\" max=\\\"50\\\" value=\\\"0\\\"> %</label>\\n50→  <button id=\\\"restart\\\" type=\\\"button\\\">New round</button>\\n  <button id=\\\"release\\\" type=\\\"button\\\" title=\\\"End the splash now: the round starts once every game has loaded\\\">Start now</b