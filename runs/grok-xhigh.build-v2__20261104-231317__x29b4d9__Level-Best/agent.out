 false, flail: false, ask: false,\"},{\"line_number\":100,\"content\":\"  function weightKeyDown() {\"},{\"line_number\":108,\"content\":\"    if (keys.has('KeyA') || keys.has('ArrowLeft')) x -= 1;\"},{\"line_number\":109,\"content\":\"    if (keys.has('KeyD') || keys.has('ArrowRight')) x += 1;\"},{\"line_number\":110,\"content\":\"    if (keys.has('KeyW') || keys.has('ArrowUp')) y += 1;\"},{\"line_number\":111,\"content\":\"    if (keys.has('KeyS') || keys.has('ArrowDown')) y -= 1;\"},{\"line_number\":154,\"content\":\"      if (btn(2)) edges.flail = true;\"},{\"line_number\":175,\"content\":\"      if (rumble && pad.vibrationActuator && edges.flail) {\"},{\"line_number\":181,\"content\":\"      rawL = keys.has('KeyQ') || (pointer.buttons & 1) ? 1 : 0;\"},{\"line_number\":182,\"content\":\"      rawR = keys.has('KeyE') || (pointer.buttons & 2) ? 1 : 0;\"},{\"line_number\":186,\"content\":\"    if (pressed('Enter') || pressed('Space')) edges.confirm = true;\"},{\"line_number\":191,\"content\":\"    if (pressed('KeyF') || latched.has('MouseMiddle')) edges.flail = true;\"},{\"line_number\":193,\"content\":\"    if (pressed('Space') || (both && !bothMouse)) edges.hop = true;\"},{\"line_number\":195,\"content\":\"    if (pressed('KeyT')) edges.ask = true;\"},{\"line_number\":196,\"content\":\"    if (pressed('KeyC')) edges.recenter = true;\"},{\"line_number\":197,\"content\":\"    if (latched.has('KeyA')) edges.plateA = true;\"},{\"line_number\":198,\"content\":\"    if (latched.has('KeyD')) edges.plateD = true;\"},{\"line_number\":199,\"content\":\"    if (pressed('ArrowUp') || pressed('KeyW')) edges.up = true;\"},{\"line_number\":200,\"content\":\"    if (pressed('ArrowDown') || pressed('KeyS')) edges.down = true;\"},{\"line_number\":201,\"content\":\"    if (pressed('ArrowLeft') || pressed('KeyA')) edges.left = true;\"},{\"line_number\":202,\"content\":\"    if (pressed('ArrowRight') || pressed('KeyD')) edges.right = true;\"},{\"line_number\":211,\"content\":\"      