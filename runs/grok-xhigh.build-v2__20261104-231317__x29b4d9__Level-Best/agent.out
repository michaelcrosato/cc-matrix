115,46,114,101,97,100,121,41,41,59,10,52,57,53,58,32,32,32,32,108,97,116,101,114,40,116,46,108,111,97,100,71,114,97,99,101,77,115,44,32,115,105,116,79,117,116,40,40,115,41,32,61,62,32,33,115,46,114,101,97,100,121,41,41,59,10,53,49,48,58,32,32,32,32,47,42,42,32,65,32,112,108,97,121,101,114,39,115,32,112,114,111,103,114,101,115,115,32,115,99,111,114,101,44,32,97,115,32,116,104,101,32,104,117,98,39,115,32,115,99,111,114,101,98,111,97,114,100,32,115,97,119,32,105,116,32,40,112,97,114,97,108,108,101,108,32,97,110,100,32,103,104,111,115,116,41,46,32,42,47,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":80,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/tools/hub/harness.html\",\"matches\":[{\"line_number\":113,\"content\":\" * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\"},{\"line_number\":181,\"content\":\"  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\"},{\"line_number\":224,\"content\":\"    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\"},{\"line_number\":238,\"content\":\"      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\"},{\"line_number\":241,\"content\":\"        cell.progress.push({ at: performance.now(), ...report });\"},{\"line_number\":242,\"content\":\"        state.coordinator.progress(id, report.score);\"},{\"line_number\":272,\"content\":\"/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\"},{\"line_number\":275,\"content\":\"  const ready = state.cells.filter((c) => state.answers.ready.has(c.key)).map((c) => c.bridge.me);\"},{\"line_number\":278,\"content\":\"    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\"},{\"line_number\":289,\"content\":\"  const { ready, more } = state.answers;\"},{\"line_number\":290,\"content\":\"  if (what === 'ready') {\"},{\"line_number\":291,\"content\":\"    ready.add(cell.key);\"},{\"line_number\":297,\"content\":\"    ready.delete(cell.key);\"},{\"line_number\":302,\"content\":\"  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\"},{\"line_number\":340,\"content\":\"    else if (p.ready) bits.push('ready');\"},{\"line_number\":343,\"content\":\"    const last = cell.progress.at(-1);\"},{\"line_number\":344,\"content\":\"    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\"},{\"line_number\":379,\"content\":\" * page's origin). Results land in window.__hubCheck, and body[data-complete]\"},{\"line_number\":412,\"content\":\"  window.__hubCheck = report;\"},{\"line_number\":416,\"content\":\"      check('game named', false, 'pass ?game=<path> of a page on this site');\"},{\"line_number\":421,\"content\":\"    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\"},{\"line_number\":424,\"content\":\"    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\"},{\"line_number\":425,\"content\":\"    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\"},{\"line_number\":430,\"content\":\"    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\"},{\"line_number\":433,\"content\":\"    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\"},{\"line_number\":434,\"content\":\"    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\"},{\"line_number\":436,\"content\":\"      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\"},{\"line_number\":440,\"content\":\"    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\"},{\"line_number\":441,\"content\":\"    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\"},{\"line_number\":442,\"content\":\"    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\"},{\"line_number\":448,\"content\":\"      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\"},{\"line_number\":449,\"content\":\"      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\"},{\"line_number\":453,\"content\":\"    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\"},{\"line_number\":468,\"content\":\"    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\"},{\"line_number\":469,\"content\":\"    // still tagged race was built to race's contract: no seeded start, and no progress asked.\"},{\"line_number\":474,\"content\":\"      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\"},{\"line_number\":483,\"content\":\"        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\"},{\"line_number\":486,\"content\":\"        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\"},{\"line_number\":489,\"content\":\"      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\"},{\"line_number\":490,\"content\":\"        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\"},{\"line_number\":492,\"content\":\"      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\"},{\"line_number\":502,\"content\":\"      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\"},{\"line_number\":506,\"content\":\"      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\"},{\"line_number\":508,\"content\":\"      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\"},{\"line_number\":511,\"content\":\"    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\"},{\"line_number\":513,\"content\":\"    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\"},{\"line_number\":521,\"content\":\"    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\"},{\"line_number\":523,\"content\":\"    check('harness ran', false, String(error?.stack || error));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/tools/hub/round.js\",\"matches\":[{\"line_number\":17,\"content\":\"  readyMs: 45_000,\"},{\"line_number\":29,\"content\":\"export const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\"},{\"line_number\":32,\"content\":\"export const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\"},{\"line_number\":34,\"content\":\"/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\"},{\"line_number\":35,\"content\":\"const MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\"},{\"line_number\":44,\"content\":\"export const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\"},{\"line_number\":49,\"content\":\" * parallel or ghost. A game still tagged race was built for an unseeded start\"},{\"line_number\":52,\"content\":\"export const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\"},{\"line_number\":68,\"content\":\" * Parallel and ghost order: finishers by time, then the rest by score,\"},{\"line_number\":135,\"content\":\" * exactly once. Players already gone may be placed or left out; whoever is\"},{\"line_number\":169,\"content\":\" * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\"},{\"line_number\":176,\"content\":\" * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\"},{\"line_number\":177,\"content\":\" *                                    games ready up once loaded, and the round starts on release()\"},{\"line_number\":205,\"content\":\"      ready: false,\"},{\"line_number\":208,\"content\":\"      /** The last progress score the hub saw: the result of a player who never reports one. */\"},{\"line_number\":209,\"content\":\"      progress: null,\"},{\"line_number\":216,\"content\":\"    ? { id: seats.length, key: serverKey, slot: null, name: 'Server', color: null, hello: false, ready: false, out: null, result: null, progress: null, stats: null, awards: [], caps: null, hidden: null }\"},{\"line_number\":275,\"content\":\"        ready: s.ready,\"},{\"line_number\":280,\"content\":\"      server: server && { id: server.id, key: server.key, hello: server.hello, ready: server.ready, out: server.out, client: server.caps?.client ?? null },\"},{\"line_number\":308,\"content\":\"    if (reason === 'not-ready' && seat.hello) send(seat, { type: 'end', reason: 'sat-out' });\"},{\"line_number\":316,\"content\":\"      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\"},{\"line_number\":319,\"content\":\"      if (released && presentCopies().every((s) => s.ready)) begin();\"},{\"line_number\":352,\"content\":\"    // A player still here who never reported is ranked by the last progress the hub saw from them.\"},{\"line_number\":354,\"content\":\"      seats.filter((s) => s.result || (!s.out && Number.isFinite(s.progress))).map((s) => [s.id, s.result ?? { score: s.progress, fallback: true }])\"},{\"line_number\":410,\"content\":\"      case 'ready':\"},{\"line_number\":411,\"content\":\"        if (!seat.hello || seat.ready || phase !== 'loading') return;\"},{\"line_number\":412,\"content\":\"        seat.ready = true;\"},{\"line_number\":416,\"content\":\"        if (!selfReported()) return issue(seat, `result is for parallel and ghost; this round is ${mode}`);\"},{\"line_number\":476,\"content\":\"    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\"},{\"line_number\":486,\"content\":\"      later(t.readyMs, sitOut((s) => !s.ready));\"},{\"line_number\":495,\"content\":\"    later(t.loadGraceMs, sitOut((s) => !s.ready));\"},{\"line_number\":510,\"content\":\"    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"ef6f603c-b9f4-496a-a9f0-633ce64d5a23"}
