04-231317/src/events/stillWater.js\",\"matches\":[{\"line_number\":14,\"content\":\"  static id = 'stillWater';\"},{\"line_number\":15,\"content\":\"  static title = 'Still Water';\"},{\"line_number\":18,\"content\":\"  static couch = false;\"},{\"line_number\":19,\"content\":\"  static session = false;\"},{\"line_number\":20,\"content\":\"  static can = 'Sit in the calm. When a sneeze is coming, flail to stifle it.';\"},{\"line_number\":21,\"content\":\"  static cant = 'You cannot chase the creatures. Leaving the calm sends them off.';\"},{\"line_number\":22,\"content\":\"  static verbs = ['weight', 'flail', 'breathe'];\"},{\"line_number\":90,\"content\":\"    if (this.t >= this.duration) this.done = true;\"},{\"line_number\":93,\"content\":\"  result(i = 0) {\"},{\"line_number\":104,\"content\":\"  botInput(i, skill) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/grandHold.js\",\"matches\":[{\"line_number\":17,\"content\":\"  static id = 'grandHold';\"},{\"line_number\":18,\"content\":\"  static title = 'The Grand Hold';\"},{\"line_number\":21,\"content\":\"  static couch = false;\"},{\"line_number\":22,\"content\":\"  static session = false;\"},{\"line_number\":23,\"content\":\"  static can = 'Follow the remix. If you fall, the class catches you and the phase starts again.';\"},{\"line_number\":24,\"content\":\"  static cant = 'You cannot fail this. You can only take longer.';\"},{\"line_number\":25,\"content\":\"  static verbs = ['weight', 'flail', 'breathe', 'leftFoot', 'rightFoot'];\"},{\"line_number\":84,\"content\":\"      this.done = true;\"},{\"line_number\":141,\"content\":\"      if (!this.phase()) this.done = true;\"},{\"line_number\":145,\"content\":\"  result(i = 0) {\"},{\"line_number\":157,\"content\":\"  botInput(i, skill) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wi