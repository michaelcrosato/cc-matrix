lyphs.js';\\nimport { getTune, setTune, resetTuning, tuningSnapshot } from '../core/tuning.js';\\nimport { TUNING_DEFS } from '../data/tuning.js';\\nimport { rng, resetRng, setSessionMode } from '../core/rng.js';\\nimport { readSave, writeSave, memoryStorage } from '../core/save.js';\\nimport { createAudio } from '../audio/engine.js';\\nimport { EVENT_TRACK } from '../audio/tracks.js';\\nimport { lineById, takeLine } from '../data/dialogue.js';\\nimport { ABOUT } from '../data/about.js';\\nimport { NAMES, PAINTS, HATS } from '../data/names.js';\\nimport { createLoop } from '../core/loop.js';\\nimport { mountUi } from '../ui/ui.js';\\n\\nconst SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\\nconst ATTRACT = ['fruitHat', 'cairn', 'stepClass', 'plates', 'springboard', 'raft', 'roomService', 'poses'];\\nconst QUESTIONS = [\\n  { ask: 'trudy.question.0', yes: 'trudy.yes.0', no: 'trudy.no.0', kind: 'yes' },\\n  { ask: 'trudy.question.1', yes: 'trudy.yes.1', no: 'trudy.no.1', kind: 'yes' },\\n  { ask: 'trudy.question.2', yes: 'trudy.yes.2', no: 'trudy.no.2', kind: 'yes' },\\n  { ask: 'trudy.question.3', left: 'trudy.left.0', right: 'trudy.right.0', kind: 'side' },\\n];\\n\\nfunction freshProfile() {\\n  return {\\n    name: NAMES[0], paint: 'coral', hat: 'none', nameIndex: 0, paintIndex: 0, hatIndex: 0,\\n    dayIndex: 0, doneSteps: [], met: [], cleared: {}, best: {},\\n    marbles: 0, ages: [], stamps: [], medals: [], minutes: 0, floor: 0,\\n    levelled: false, classDone: [],\\n  };\\n}\\n\\nfunction defaultSettings() {\\n  return {\\n    music: 10, sfx: 80, voice: 80, glyphs: 'playstation', rumble: true,\\n    autoBreathe: false, rhythmOffset: 0, uiScale: 1, ink: 1, reduceShake: false,\\n    difficulty: 'standard',\\n  };\\n}\\n\\nexport async function createGame(opts = {}) {\\n  await initRapier();\\n  const storage = opts.storage || (opts.window && opts.window.localStorage) || memoryStorage();\\n  const doc = opts.document || null;\\n  const audio = createAudio();\\n  const pads = [0, 1, 2, 3].map(() => makePad());\\n  let padSource = () => pads;\\n  const inputs = [0, 1, 2, 3].map((i) => {\\n    const input = createInput();\\n    input.setPadSource(() => padSource());\\n    input.setPadIndex(i);\\n    input.setDevice('pad');\\n    return input;\\n  });\\n  const profile = freshProfile();\\n  const settings = defaultSettings();\\n  const saved = readSave(storage, SAVE_KEY);\\n  if (saved) {\\n    Object.assign(profile, saved.profile);\\n    Object.assign(settings, saved.settings);\\n  }\\n  let screen = 'title';\\n  let focus = 0;\\n  let page = 0;\\n  let idle = 0;\\n  let attract = null;\\n  let event = null;\\n  let eventId = null;\\n  let tier = 1;\\n  let paused = false;\\n  let countLeft = 0;\\n  let speech = null;\\n  let speechLeft = 0;\\n  let pending = null;\\n  let jarLeft = 0;\\n  let jarPay = 0;\\n  let botSkill = null;\\n  let botOpt = {};\\n  let god = false;\\n  let timeScale = 1;\\n  let coarse = !!opts.coarse;\\n  let session = null;\\n  let locked = false;\\n  let errors = [];\\n  let volumeOpen = false;\\n  let devFromPause = false;\\n  let group = null;\\n  let freePick = false;\\n  let lastResult = null;\\n  let copyText = '';\\n  let palette = 'dawn';\\n  let frames = 0;\\n  let backend = 'none';\\n  let lost = null;\\n  const listeners = new Set();\\n  const programme = programmeSteps(eventIds());\\n  let ui = null;\\n  if (doc) {\\n    ui = mountUi(doc, {\\n      activate: (index) => activate(index),\\n      hover: (index) => { focus = index; paint(); },\\n      slide: (id, value) => { setTune(id, value); applySettings(); paint(); },\\n    });\\n  }\\n\\n  function applySettings() {\\n    audio.setGains(settings.music / 100, settings.sfx / 100, settings.voice / 100);\\n    inputs.forEach((input) => input.setRumble(settings.rumble));\\n  }\\n  applySettings();\\n\\n  function persist() {\\n    writeSave(storage, SAVE_KEY, { profile, settings });\\n  }\\n\\n  function tiltRad() {\\n    const rest = getTune('islandRest');\\n    return restTiltRad(profile.doneSteps.length, Math.max(1, programme.length), rest);\\n  }\\n\\n  function talk(speaker, bucket) {\\n    const line = takeLine(speaker, bucket, rng('talk'));\\n    if (!line) return;\\n    speech = { who: speaker === 'stillwater' ? 'Ms. Stillwater' : speaker === 'bolster' ? 'Coach Bolster' : 'Trudy', text: line.text, id: line.id };\\n    const rate = speaker === 'stillwater' ? 7 : speaker === 'bolster' ? 11 : 16;\\n    speechLeft = Math.max(0.8, line.text.length / rate);\\n    audio.say(line.text, speaker === 'guest' ? 'guest' : speaker);\\n  }\\n\\n  function sayId(id) {\\n    const line = findLineById(id);\\n    if (!line) return;\\n    speech = { who: 'Trudy', text: line.text, id: line.id };\\n    speechLeft = Math.max(0.6, line.text.length / 16);\\n    audio.say(line.text, 'trudy');\\n  }\\n\\n  function choicesOf() {\\n    return model().choices;\\n  }\\n\\n  function setScreen(next, keepFocus = false) {\\n    screen = next;\\n    if (!keepFocus) focus = 0;\\n    page = 0;\\n    volumeOpen = false;\\n    if (next !== 'play') paused = false;\\n    for (const pad of pads) clearPad(pad);\\n    paint();\\n    persist();\\n  }\\n\\n  function today() {\\n    const plan = dayPlan(profile.dayIndex, eventIds());\\n    if (plan.maintenance) {\\n      const pool = eventIds().slice();\\n      const picked = [];\\n      while (picked.length < 3 && pool.length) {\\n        const i = Math.floor(rng('maintenance') * pool.length);\\n        picked.push(pool.splice(i, 1)[0]);\\n      }\\n      plan.classes = picked;\\n    }\\n    return plan;\\n  }\\n\\n  function tierFor(id) {\\n    if (!freePick && profile.dayIndex < 5) return 1;\\n    const best = profile.best[id] || {};\\n    return tiersOpen(best);\\n  }\\n\\n  function startEvent(id, extra = {}) {\\n    if (event) event.dispose();\\n    const Ctor = id === 'checkin' ? CheckIn : eventById(id);\\n    eventId = id;\\n    tier = extra.tier || (id === 'checkin' ? 1 : tierFor(id));\\n    const lanes = extra.lanes || (group && group.lanes && group.lanes.length ? group.lanes : [{ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] }]);\\n    event = new Ctor({\\n      tier, lanes, seed: extra.seed || 1, session: !!extra.session, god: extra.god || god,\\n      difficulty: settings.difficulty, tests: extra.tests, skill: extra.skill || 'sharp',\\n      label: `${id}-${profile.dayIndex}`,\\n    });\\n    if (event.build) event.build();\\n    audio.play(EVENT_TRACK[id] || 'island');\\n  }\\n\\n  function finishEvent() {\\n    if (!event) return;\\n    const result = event.result(0);\\n    lastResult = result;\\n    profile.minutes += (event.t || 0) / 60;\\n\",\"total_lines\":1177}}","is_error":false},{"type":"tool_result","tool_use_id":"call-de43bbb9-df8f-4401-b161-70b1f1db1058-4","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"480→      if (!lanes.length) lanes.push({ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] });\\n      group.lanes = lanes;\\n      return openIntro(playlist[0]);\\n    }\\n    if (id === 'back') return setScreen('menu');\\n  }\\n\\n  function pickSome(list, n) {\\n    const pool = list.slice();\\n    const out = [];\\n490→    while (out.length < n && pool.length) out.push(pool.splice(Math.floor(rng('group') * pool.length), 1)[0]);\\n    return out;\\n  }\\n\\n  function resetAll() {\\n    const next = freshProfile();\\n    Object.keys(profile).forEach((k) => delete profile[k]);\\n    Object.assign(profile, next);\\n    Object.assign(settings, defaultSettings());\\n    resetTuning();\\n500→    try { storage.removeItem(SAVE_KEY); } catch { /* memory store */ }\\n  }\\n\\n  function sayExact(text) {\\n    speech = { who: 'Trudy', text, id: 'exact' };\\n    speechLeft = Math.max(1, text.length / 16);\\n    audio.say(text, 'trudy');\\n  }\\n\\n  function lookup(id) {\\n510→    const { lineById } = dialogueApi();\\n    return lineById(id);\\n  }\\n\\n  function dialogueApi() {\\n    return import('../data/dialogue.js');\\n  }\\n\\n  function driveBots(dt) {\\n    if (!event || !botSkill) return null;\\n520→    const skill = skillOf(botSkill);\\n    const snaps = [];\\n    const count = event.lanes.length;\\n    for (let i = 0; i < count; i++) {\\n      const cmd = event.botInput(i, skill, botOpt) || {};\\n      const pad = padAt(i);\\n      clearPad(pad);\\n      writeWish(pad, cmd.x || 0, cmd.y || 0);\\n      writeButton(pad, 0, !!cmd.hop);\\n      writeButton(pad, 2, !!cmd.flail);\\n530→      writeButton(pad, 5, !!(cmd.breathe || (settings.autoBreathe && screen === 'play')));\\n      writeButton(pad, 6, (cmd.feetL || 0) > 0, cmd.feetL || 0);\\n      writeButton(pad, 7, (cmd.feetR || 0) > 0, cmd.feetR || 0);\\n      const input = inputs[i];\\n      if (cmd.plateA) input.keyDown('KeyA');\\n      if (cmd.plateD) input.keyDown('KeyD');\\n      input.poll(dt, 'balance');\\n      if (cmd.plateA) input.keyUp('KeyA');\\n      if (cmd.plateD) input.keyUp('KeyD');\\n      snaps.push(input.snapshot(0));\\n540→    }\\n    return snaps;\\n  }\\n\\n  function padAt(i) {\\n    const list = padSource() || pads;\\n    return list[i] || pads[i];\\n  }\\n\\n  function fixed(dt) {\\n550→    if (locked) return;\\n    audio.setTilt(tiltRad());\\n    if (session) return sessionFixed(dt);\\n    const input = inputs[0];\\n    const before = input.takeTravel ? 0 : 0;\\n    const playing = screen === 'play' || screen === 'checkinPlay' || attract;\\n    if (playing && botSkill) {\\n      const snaps = driveBots(dt);\\n      if (!paused && event) stepEvent(dt, snaps);\\n      noteNotch();\\n560→      return;\\n    }\\n    const sample = input.poll(dt, playing ? 'balance' : 'menu');\\n    const travel = input.takeTravel();\\n    if (attract) {\\n      if (woke(sample, travel)) { stopAttract(true); return; }\\n      stepAttract(dt);\\n      return;\\n    }\\n    if (screen === 'title' || screen === 'menu' || screen === 'touch') {\\n570→      if (woke(sample, travel)) idle = 0;\\n      else idle += dt;\\n      if (idle >= 10) { startAttract(); return; }\\n    } else idle = 0;\\n    if (sample.edges.pause && (screen === 'play' || screen === 'checkinPlay') && !sample.createHeld) {\\n      paused = true;\\n      return setScreen('pause');\\n    }\\n    if ((screen === 'play' || screen === 'checkinPlay') && !paused) {\\n      const snaps = [];\\n580→      const n = event ? event.lanes.length : 1;\\n      snaps.push(sampleToSnap(sample, input));\\n      for (let i = 1; i < n; i++) {\\n        const extra = inputs[i].poll(dt, 'balance');\\n        snaps.push(sampleToSnap(extra, inputs[i]));\\n      }\\n      joinPads(sample);\\n      stepEvent(dt, snaps);\\n      noteNotch();\\n      if (event && event.done) {\\n590→        finishEvent();\\n        if (eventId === 'checkin') revealAge();\\n        else setScreen('results');\\n      }\\n      return;\\n    }\\n    if (screen === 'countdown') {\\n      countLeft -= dt;\\n      if (countLeft <= 0) setScreen('play');\\n      return;\\n600→    }\\n    if (screen === 'morning') {\\n      speechLeft -= dt;\\n      if (sample.edges.confirm || speechLeft <= 0) openQuestion();\\n      return;\\n    }\\n    if (screen === 'jar') {\\n      jarLeft -= dt;\\n      if (sample.edges.confirm || jarLeft <= 0) afterJar();\\n      return;\\n610→    }\\n    if (speechLeft > 0) speechLeft -= dt;\\n    if (!playing) menuMove(sample);\\n    void before;\\n  }\\n\\n  function sampleToSnap(sample, input) {\\n    return input.snapshot(0);\\n  }\\n\\n620→  function stepEvent(dt, snaps) {\\n    if (!event || paused) return;\\n    event.fixed(dt, snaps || []);\\n    if (event.frame) event.frame(dt);\\n  }\\n\\n  function noteNotch() {\\n    if (event && event.notch && !profile.doneSteps.includes('grandHold')) {\\n      profile.doneSteps.push('grandHold');\\n      profile.levelled = profile.doneSteps.length >= programme.length;\\n630→      if (!profile.met.includes('grandHold')) profile.met.push('grandHold');\\n      audio.sfx('creak');\\n    }\\n    if (profile.doneSteps.length >= programme.length) profile.levelled = true;\\n  }\\n\\n  function revealAge() {\\n    const mean = lastResult.mean || 0;\\n    const age = wobbleAge(mean, Math.min(4, profile.dayIndex));\\n    profile.ages.push(age);\\n640→    profile.marbles += 1;\\n    sayExact(`Your Wobble Age is ${age}.`);\\n    setScreen('age');\\n  }\\n\\n  function openQuestion() {\\n    setScreen('question');\\n  }\\n\\n  function startAttract() {\\n650→    attract = { index: 0, left: 18, between: 0, seen: [] };\\n    idle = 0;\\n    botSkill = 'sharp';\\n    launchAttract();\\n  }\\n\\n  function launchAttract() {\\n    const id = ATTRACT[attract.index % ATTRACT.length];\\n    if (!attract.seen.includes(id)) attract.seen.push(id);\\n    startEvent(id, { god: id !== 'fruitHat', lanes: [{ id: 0, kind: 'bot', name: 'Demo', colour: SEAT_COLOURS[1] }] });\\n660→    botOpt = id === 'fruitHat' ? { bankAt: 99 } : {};\\n    screen = 'play';\\n  }\\n\\n  function stepAttract(dt) {\\n    if (!attract) return;\\n    if (attract.between > 0) {\\n      attract.between -= dt;\\n      screen = 'title';\\n      if (attract.between <= 0) launchAttract();\\n670→      return;\\n    }\\n    const snaps = driveBots(dt);\\n    if (event) stepEvent(dt, snaps);\\n    attract.left -= dt;\\n    if (!event || event.done || attract.left <= 0) {\\n      if (event) { event.dispose(); event = null; }\\n      attract.index += 1;\\n      attract.left = 18;\\n      if (attract.index % ATTRACT.length === 0) {\",\"content_concise\":\"480→      if (!lanes.length) lanes.push({ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] });\\n      group.lanes = lanes;\\n      return openIntro(playlist[0]);\\n    }\\n    if (id === 'back') return setScreen('menu');\\n  }\\n\\n  function pickSome(list, n) {\\n    const pool = list.slice();\\n    const out = [];\\n490→    while (out.length < n && pool.length) out.push(pool.splice(Math.floor(rng('group') * pool.length), 1)[0]);\\n    return out;\\n  }\\n\\n  function resetAll() {\\n    const next = freshProfile();\\n    Object.keys(profile).forEach((k) => delete profile[k]);\\n    Object.assign(profile, next);\\n    Object.assign(settings, defaultSettings());\\n    resetTuning();\\n500→    try { storage.removeItem(SAVE_KEY); } catch { /* memory store */ }\\n  }\\n\\n  function sayExact(text) {\\n    speech = { who: 'Trudy', text, id: 'exact' };\\n    speechLeft = Math.max(1, text.length / 16);\\n    audio.say(text, 'trudy');\\n  }\\n\\n  function lookup(id) {\\n510→    const { lineById } = dialogueApi();\\n    return lineById(id);\\n  }\\n\\n  function dialogueApi() {\\n    return import('../data/dialogue.js');\\n  }\\n\\n  function driveBots(dt) {\\n    if (!event || !botSkill) return null;\\n520→    const skill = skillOf(botSkill);\\n    const snaps = [];\\n    const count = event.lanes.length;\\n    for (let i = 0; i < count; i++) {\\n      const cmd = event.botInput(i, skill, botOpt) || {};\\n      const pad = padAt(i);\\n      clearPad(pad);\\n      writeWish(pad, cmd.x || 0, cmd.y || 0);\\n      writeButton(pad, 0, !!cmd.hop);\\n      writeButton(pad, 2, !!cmd.flail);\\n530→      writeButton(pad, 5, !!(cmd.breathe || (settings.autoBreathe && screen === 'play')));\\n      writeButton(pad, 6, (cmd.feetL || 0) > 0, cmd.feetL || 0);\\n      writeButton(pad, 7, (cmd.feetR || 0) > 0, cmd.feetR || 0);\\n      const input = inputs[i];\\n      if (cmd.plateA) input.keyDown('KeyA');\\n      if (cmd.plateD) input.keyDown('KeyD');\\n      input.poll(dt, 'balance');\\n      if (cmd.plateA) input.keyUp('KeyA');\\n      if (cmd.plateD) input.keyUp('KeyD');\\n      snaps.push(input.snapshot(0));\\n540→    }\\n    return snaps;\\n  }\\n\\n  function padAt(i) {\\n    const list = padSource() || pads;\\n    return list[i] || pads[i];\\n  }\\n\\n  function fixed(dt) {\\n550→    if (locked) return;\\n    audio.setTilt(tiltRad());\\n    if (session) return sessionFixed(dt);\\n    const input = inputs[0];\\n    const before = input.takeTravel ? 0 : 0;\\n    const playing = screen === 'play' || screen === 'checkinPlay' || attract;\\n    if (playing && botSkill) {\\n      const snaps = driveBots(dt);\\n      if (!paused && event) stepEvent(dt, snaps);\\n      noteNotch();\\n560→      return;\\n    }\\n    const sample = input.poll(dt, playing ? 'balance' : 'menu');\\n    const travel = input.takeTravel();\\n    if (attract) {\\n      if (woke(sample, travel)) { stopAttract(true); return; }\\n      stepAttract(dt);\\n      return;\\n    }\\n    if (screen === 'title' || screen === 'menu' || screen === 'touch') {\\n570→      if (woke(sample, travel)) idle = 0;\\n      else idle += dt;\\n      if (idle >= 10) { startAttract(); return; }\\n    } else idle = 0;\\n    if (sample.edges.pause && (screen === 'play' || screen === 'checkinPlay') && !sample.createHeld) {\\n      paused = true;\\n      return setScreen('pause');\\n    }\\n    if ((screen === 'play' || screen === 'checkinPlay') && !paused) {\\n      const snaps = [];\\n580→      const n = event ? event.lanes.length : 1;\\n      snaps.push(sampleToSnap(sample, input));\\n      for (let i = 1; i < n; i++) {\\n        const extra = inputs[i].poll(dt, 'balance');\\n        snaps.push(sampleToSnap(extra, inputs[i]));\\n      }\\n      joinPads(sample);\\n      stepEvent(dt, snaps);\\n      noteNotch();\\n      if (event && event.done) {\\n590→        finishEvent();\\n        if (eventId === 'checkin') revealAge();\\n        else setScreen('results');\\n      }\\n      return;\\n    }\\n    if (screen === 'countdown') {\\n      countLeft -= dt;\\n      if (countLeft <= 0) setScreen('play');\\n      return;\\n600→    }\\n    if (screen === 'morning') {\\n      speechLeft -= dt;\\n      if (sample.edges.confirm || speechLeft <= 0) openQuestion();\\n      return;\\n    }\\n    if (screen === 'jar') {\\n      jarLeft -= dt;\\n      if (sample.edges.confirm || jarLeft <= 0) afterJar();\\n      return;\\n610→    }\\n    if (speechLeft > 0) speechLeft -= dt;\\n    if (!playing) menuMove(sample);\\n    void before;\\n  }\\n\\n  function sampleToSnap(sample, input) {\\n    return input.snapshot(0);\\n  }\\n\\n620→  function stepEvent(dt, snaps) {\\n    if (!event || paused) return;\\n    event.fixed(dt, snaps || []);\\n    if (event.frame) event.frame(dt);\\n  }\\n\\n  function noteNotch() {\\n    if (event && event.notch && !profile.doneSteps.includes('grandHold')) {\\n      profile.doneSteps.push('grandHold');\\n      profile.levelled = profile.doneSteps.length >= programme.length;\\n630→      if (!profile.met.includes('grandHold')) profile.met.push('grandHold');\\n      audio.sfx('creak');\\n    }\\n    if (profile.doneSteps.length >= programme.length) profile.levelled = true;\\n  }\\n\\n  function revealAge() {\\n    const mean = lastResult.mean || 0;\\n    const age = wobbleAge(mean, Math.min(4, profile.dayIndex));\\n    profile.ages.push(age);\\n640→    profile.marbles += 1;\\n    sayExact(`Your Wobble Age is ${age}.`);\\n    setScreen('age');\\n  }\\n\\n  function openQuestion() {\\n    setScreen('question');\\n  }\\n\\n  function startAttract() {\\n650→    attract = { index: 0, left: 18, between: 0, seen: [] };\\n    idle = 0;\\n    botSkill = 'sharp';\\n    launchAttract();\\n  }\\n\\n  function launchAttract() {\\n    const id = ATTRACT[attract.index % ATTRACT.length];\\n    if (!attract.seen.includes(id)) attract.seen.push(id);\\n    startEvent(id, { god: id !== 'fruitHat', lanes: [{ id: 0, kind: 'bot', name: 'Demo', colour: SEAT_COLOURS[1] }] });\\n660→    botOpt = id === 'fruitHat' ? { bankAt: 99 } : {};\\n    screen = 'play';\\n  }\\n\\n  function stepAttract(dt) {\\n    if (!attract) return;\\n    if (attract.between > 0) {\\n      attract.between -= dt;\\n      screen = 'title';\\n      if (attract.between <= 0) launchAttract();\\n670→      return;\\n    }\\n    const snaps = driveBots(dt);\\n    if (event) stepEvent(dt, snaps);\\n    attract.left -= dt;\\n    if (!event || event.done || attract.left <= 0) {\\n      if (event) { event.dispose(); event = null; }\\n      attract.index += 1;\\n      attract.left = 18;\\n      if (attract.index % ATTRACT.length === 0) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/game/director.js\",\"offset\":480,\"limit\":200,\"raw_output\":\"      if (!lanes.length) lanes.push({ id: 0, kind: 'local', name: profile.name, colour: SEAT_COLOURS[0] });\\n      group.lanes = lanes;\\n      return openIntro(playlist[0]);\\n    }\\n    if (id === 'back') return setScreen('menu');\\n  }\\n\\n  function pickSome(list, n) {\\n    const pool = list.slice();\\n    const out = [];\\n    while (out.length < n && pool.length) out.push(pool.splice(Math.floor(rng('group') * pool.length), 1)[0]);\\n    return out;\\n  }\\n\\n  function resetAll() {\\n    const next = freshProfile();\\n    Object.keys(profile).forEach((k) => delete profile[k]);\\n    Object.assign(profile, next);\\n    Object.assign(settings, defaultSettings());\\n    resetTuning();\\n    try { storage.removeItem(SAVE_KEY); } catch { /* memory store */ }\\n  }\\n\\n  function sayExact(text) {\\n    speech = { who: 'Trudy', text, id: 'exact' };\\n    speechLeft = Math.max(1, text.length / 16);\\n    audio.say(text, 'trudy');\\n  }\\n\\n  function lookup(id) {\\n    const { lineById } = dialogueApi();\\n    return lineById(id);\\n  }\\n\\n  function dialogueApi() {\\n    return import('../data/dialogue.js');\\n  }\\n\\n  function driveBots(dt) {\\n    if (!event || !botSkill) return null;\\n    const skill = skillOf(botSkill);\\n    const snaps = [];\\n    const count = event.lanes.length;\\n    for (let i = 0; i < count; i++) {\\n      const cmd = event.botInput(i, skill, botOpt) || {};\\n      const pad = padAt(i);\\n      clearPad(pad);\\n      writeWish(pad, cmd.x || 0, cmd.y || 0);\\n      writeButton(pad, 0, !!cmd.hop);\\n      writeButton(pad, 2, !!cmd.flail);\\n      writeButton(pad, 5, !!(cmd.breathe || (settings.autoBreathe && screen === 'play')));\\n      writeButton(pad, 6, (cmd.feetL || 0) > 0, cmd.feetL || 0);\\n      writeButton(pad, 7, (cmd.feetR || 0) > 0, cmd.feetR || 0);\\n      const input = inputs[i];\\n      if (cmd.plateA) input.keyDown('KeyA');\\n      if (cmd.plateD) input.keyDown('KeyD');\\n      input.poll(dt, 'balance');\\n      if (cmd.plateA) input.keyUp('KeyA');\\n      if (cmd.plateD) input.keyUp('KeyD');\\n      snaps.push(input.snapshot(0));\\n    }\\n    return snaps;\\n  }\\n\\n  function padAt(i) {\\n    const list = padSource() || pads;\\n    return list[i] || pads[i];\\n  }\\n\\n  function fixed(dt) {\\n    if (locked) return;\\n    audio.setTilt(tiltRad());\\n    if (session) return sessionFixed(dt);\\n    const input = inputs[0];\\n    const before = input.takeTravel ? 0 : 0;\\n    const playing = screen === 'play' || screen === 'checkinPlay' || attract;\\n    if (playing && botSkill) {\\n      const snaps = driveBots(dt);\\n      if (!paused && event) stepEvent(dt, snaps);\\n      noteNotch();\\n      return;\\n    }\\n    const sample = input.poll(dt, playing ? 'balance' : 'menu');\\n    const travel = input.takeTravel();\\n    if (attract) {\\n      if (woke(sample, travel)) { stopAttract(true); return; }\\n      stepAttract(dt);\\n      return;\\n    }\\n    if (screen === 'title' || screen === 'menu' || screen === 'touch') {\\n      if (woke(sample, travel)) idle = 0;\\n      else idle += dt;\\n      if (idle >= 10) { startAttract(); return; }\\n    } else idle = 0;\\n    if (sample.edges.pause && (screen === 'play' || screen === 'checkinPlay') && !sample.createHeld) {\\n      paused = true;\\n      return setScreen('pause');\\n    }\\n    if ((screen === 'play' || screen === 'checkinPlay') && !paused) {\\n      const snaps = [];\\n      const n = event ? event.lanes.length : 1;\\n      snaps.push(sampleToSnap(sample, input));\\n      for (let i = 1; i < n; i++) {\\n        const extra = inputs[i].poll(dt, 'balance');\\n        snaps.push(sampleToSnap(extra, inputs[i]));\\n      }\\n      joinPads(sample);\\n      stepEvent(dt, snaps);\\n      noteNotch();\\n      if (event && event.done) {\\n        finishEvent();\\n        if (eventId === 'checkin') revealAge();\\n        else setScreen('results');\\n      }\\n      return;\\n    }\\n    if (screen === 'countdown') {\\n      countLeft -= dt;\\n      if (countLeft <= 0) setScreen('play');\\n      return;\\n    }\\n    if (screen === 'morning') {\\n      speechLeft -= dt;\\n      if (sample.edges.confirm || speechLeft <= 0) openQuestion();\\n      return;\\n    }\\n    if (screen === 'jar') {\\n      jarLeft -= dt;\\n      if (sample.edges.confirm || jarLeft <= 0) afterJar();\\n      return;\\n    }\\n    if (speechLeft > 0) speechLeft -= dt;\\n    if (!playing) menuMove(sample);\\n    void before;\\n  }\\n\\n  function sampleToSnap(sample, input) {\\n    return input.snapshot(0);\\n  }\\n\\n  function stepEvent(dt, snaps) {\\n    if (!event || paused) return;\\n    event.fixed(dt, snaps || []);\\n    if (event.frame) event.frame(dt);\\n  }\\n\\n  function noteNotch() {\\n    if (event && event.notch && !profile.doneSteps.includes('grandHold')) {\\n      profile.doneSteps.push('grandHold');\\n      profile.levelled = profile.doneSteps.length >= programme.length;\\n      if (!profile.met.includes('grandHold')) profile.met.push('grandHold');\\n      audio.sfx('creak');\\n    }\\n    if (profile.doneSteps.length >= programme.length) profile.levelled = true;\\n  }\\n\\n  function revealAge() {\\n    const mean = lastResult.mean || 0;\\n    const age = wobbleAge(mean, Math.min(4, profile.dayIndex));\\n    profile.ages.push(age);\\n    profile.marbles += 1;\\n    sayExact(`Your Wobble Age is ${age}.`);\\n    setScreen('age');\\n  }\\n\\n  function openQuestion() {\\n    setScreen('question');\\n  }\\n\\n  function startAttract() {\\n    attract = { index: 0, left: 18, between: 0, seen: [] };\\n    idle = 0;\\n    botSkill = 'sharp';\\n    launchAttract();\\n  }\\n\\n  function launchAttract() {\\n    const id = ATTRACT[attract.index % ATTRACT.length];\\n    if (!attract.seen.includes(id)) attract.seen.push(id);\\n    startEvent(id, { god: id !== 'fruitHat', lanes: [{ id: 0, kind: 'bot', name: 'Demo', colour: SEAT_COLOURS[1] }] });\\n    botOpt = id === 'fruitHat' ? { bankAt: 99 } : {};\\n    screen = 'play';\\n  }\\n\\n  function stepAttract(dt) {\\n    if (!attract) return;\\n    if (attract.between > 0) {\\n      attract.between -= dt;\\n      screen = 'title';\\n      if (attract.between <= 0) launchAttract();\\n      return;\\n    }\\n    const snaps = driveBots(dt);\\n    if (event) stepEvent(dt, snaps);\\n    attract.left -= dt;\\n    if (!event || event.done || attract.left <= 0) {\\n      if (event) { event.dispose(); event = null; }\\n      attract.index += 1;\\n      attract.left = 18;\\n      if (attract.index % ATTRACT.length === 0) {\\n\",\"total_lines\":1177}}","is_error":false},{"type":"tool_result","tool_use_id":"call-de43bbb9-df8f-4401-b161-70b1f1db1058-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→# Plan: Build the original crooked-island balance game in PLAN.md and hand in every TASK.md file\\n\\n## Goal kind\\ncode-change\\n\\n## Acceptance criteria\\n1. The work-folder root contains one self-contained HTML file named `{GameTitle}-Wii Fit-grok-4.7-xhigh-20261104-231317.html`, a dev subfolder with that same basename, `PROGRESS.md`, and `exit-interview.json` beside the HTML. GameTitle is a playful riff on \\\"Wii Fit\\\" (not that name and not a source activity name), chosen with a real random-number generator and recorded in `PROGRESS.md`, and it is the title drawn on the title screen. The JSON parses as one object in TASK.md's exact shape: every `sourceInformation` value filled, `usage` exactly `added on import`, feedback arrays of length 4, 6, and 4 in question order, and `aiHub` whose `name` equals that title, `type` Game, `genre` from TASK.md's catalogue list, `source` Wii Fit, `players` `1–4`, 3–6 lowercase tags (`series` may be empty). The About/Credits screen shows those same strings. The page is Three.js R180 (WebGPU by default, WebGL2 fallback that still draws), a cel-shaded ink filter, Rapier 0.19.3, Web Audio, and the Gamepad API. It opens from `file://` with no external requests and no audio files. No TODO, placeholder, or stubbed feature remains. Source product names, the forbidden activities, and the source's gym/avatar look from PLAN.md §2 appear only in the title joke and the About source line.\\n\\n2. One screen-relative weight-shift verb, taken from whichever device was used last (a standard-mapped stick, keys that leave a pose where they were released, or the pointer's offset from centre), drives one Rapier foot ball-joint core shared by every standing event. The Balance Disc shows that lean. From a fresh world, a full lean settles near the tuned max lean without falling; crossing the fall angle becomes a ragdoll and recovery does not instantly fall again; a stick parked on a stillness target and never corrected does not score Exemplary; extra carried mass makes the doll easier to tip; flail is a timed save with a cooldown, not a free win. Fruit Hat, started on its own, banks caught fruit on a hop and spills unbanked fruit on a fall. Checks run the shipped step, not a re-coded copy of the formula.\\n10→\\n3. Each event in PLAN.md §6 (Poses, The Cairn, Still Water, Log Reps, Plank & Perch, Tug of Peace, Step Class, Plate Spinners, Island Loop, Fruit Hat, Room Service, Springboard, Tippy Raft, The Grand Hold), started on its own, plays that section's rules through intro (what you can and cannot do), play, and a medal result, on three tiers, with a bot lane. Check-in yields a Wobble Age from 18 to 99 that falls across days when skill is unchanged; marbles pour into the jar from results; island rest tilt follows completed programme steps, not skill, and is level after The Grand Hold, which cannot be failed. Days, Free Play, and later days continue, and no skill gate blocks the story. A sharp bot finishes each Tier 1 event with no NaN and no physics panic, and disposing the event does not leak bodies.\\n\\n4. Keyboard and mouse play the same screens as a pad. Prompts follow the last device: PlayStation glyphs by default, an Xbox-letter option, and keycaps or mouse buttons for keyboard and mouse. After 10 seconds with no input on the title or main menu, a looping bot demo of real events starts; any input leaves it and is not also acted on. Dev mode opens only from pause and includes the §14 tools plus live sliders for balance, world, events, rewards, and ink that change a running event and reset to defaults. A coarse pointer with no fine pointer shows \\\"Controller or keyboard required\\\" and a working Settings control, has no touch gameplay, and still runs attract mode. Music defaults to 10%. Music, effects, and gibberish voices are synthesized in code, and every spoken line is also on screen. At 1920×1080, gameplay text is at least 30px, a screen has at most six choices, and focus is visible.\\n\\n5. Group Class on one screen seats 1–4 local players on the couch events, and Tippy Raft can end with a winner. An AI Hub session is Protocol v1 ghost mode: the unmodified session client is the first script in `head` after the charset meta; the §12 metas are present (`hub:session` 1, players `1-4`, mode `ghost`, minutes, goal, howto, type Game, source Wii Fit) and `hub:webgpu` required is not set; the game connects and calls ready with no key press, shows its own card, schedules the round on `AIHub.time()`, draws ghost dolls that never affect local physics, reports progress from the start of the clock, sends one result, and on time-up or end stops input and sound. The hub harness passes at 1 player, at 2 players, at 4 players with latency, jitter, and loss, and with the host leaving. Outside a session, Enter and Space on the title leave a drawn frame and no error. Options is ignored while Create is held.\\n\\n## Verification plan\\n1. gating: Add in-repo tests that drive the shipped simulation (the same fixed step the page runs), not a copy of the formulas and not a mock of the unit under test. One command prints only failures and a one-line count, and its full run covers criteria 2–4 from their own start states: balance (parked stick, fall/recover, load, Fruit Hat bank versus never-bank), each §6 event, check-in/age/marbles/tilt, a sim-time playthrough from a fresh profile through the ending and a later day, input verbs and glyphs, attract at 10 seconds with the press swallowed, dev sliders and reset, touch-only copy and Settings, offline audio renders that are finite, non-silent, and not clipped with music gain 0.10, the 1080p UI limits, the exit-interview shape, and the built HTML (no external requests, no audio files, no TODO/placeholder/stub, client immediately after charset). Capture stdout to `{SCRATCH}/test-full.log`. Pass only if the count shows zero failures.\\n2. gating: Launch the real root HTML from `file://` twice, in Playwright Chromium, with `--enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader --use-vulkan=swiftshader --use-angle=swiftshader`. Each run must show no page errors, a live WebGPU device (a lost device fails), a canvas whose drawing size matches the requested view, and a pixel readback that is substantially painted (a large painted fraction or a bbox covering most of the surface, with dark ink-like pixels and a spread of other colours — not merely non-zero). The title string on screen equals GameTitle. A stubbed standard pad or a key then changes screen or balance state in a second capture. Both runs must succeed the same way. Save `{SCRATCH}/launch-1.png`, `{SCRATCH}/launch-2.png`, and `{SCRATCH}/launch.log`. If the browser cannot start, save that launcher error to `{SCRATCH}/launch-env.txt` and criterion 1's file checks plus the non-render tests in step 1 are the bar. A readback that succeeds and is blank or nearly blank is a game failure, not this fallback.\\n20→3. gating: Serve the built HTML and the hub harness on `127.0.0.1` with an OS-picked port, confirm the response is this game, then run the harness to `body[data-complete=\\\"true\\\"]` and `window.__hubCheck.pass === true` for `players=1`, `players=2`, `players=4&latency=150&jitter=50&loss=5`, and `scenario=host-leave`. Stop only that server, by its PID. Also open the file outside a session and press Enter, Space, Enter, Space: no errors and a drawn frame. Capture `{SCRATCH}/hub.log`.\\n4. evidence: At 1920×1080, with the same rendering flags, capture title, island on day 1 and level, each event mid-play, results, jar, age reveal, four-player Group Class, dev mode, and About into `{SCRATCH}/shots/`. A WebKit load that reports the WebGL2 fallback and no page errors goes to `{SCRATCH}/webkit.log`. Absence of these shots does not fail the goal once steps 1–3 pass.\\n\\n## Non-goals\\n- FPS targets, optimization, or a performance budget.\\n- A real DualSense, TV, listener, second human, or iOS Safari. Stand-ins in TASK.md are as far as those checks go.\\n- Recreating Wii Fit activities, its balance board, its age/bank product names, Mii avatars, or its white gym look.\\n- Shared-world hub mode, chat, emotes, custom names, or any network besides the hub client.\\n- Typed profile names, or a fail state that stops the days.\\n\\n30→## Assumed scope\\nOnly this work folder. New sources live in the named dev subfolder; the bundled HTML, `exit-interview.json`, and `PROGRESS.md` land in the work-folder root. Runtime deps are three@0.180.0, @dimforge/rapier3d-compat@0.19.3, esbuild, playwright@1.63.0, Fredoka, and the AI Hub session client plus harness (protocol v1, client 1.4.0) from `https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub`. Wii Fit's own activity list was not re-derived: PLAN.md already maps the source's pillars onto original events and forbids copying those activities.\\n\\n## Implementation approach\\nKeep age, payouts, tilt, scoring, and the balance torque step pure so tests call them without a canvas. One fixed 1/120 step is shared by the page and the tests. Events take a list of lanes so solo, bots, couch play, ghosts, and attract are the same code. Bundle an IIFE into one HTML file so `file://` works with no module import. A test mode advances sim time without waiting and can skip the renderer. One test command prints only failures and a count; rerun only the part a change touches.\\n\\n## Task checklist\\n- [x] Pick GameTitle with a real RNG after brainstorming riffs, record it in PROGRESS.md, and create the matching dev subfolder.\\n- [ ] Boot a single-file build: Three r180 ink scene, Rapier 0.19.3, unmodified hub client, WebGL2 fallback, and a test advance hook. Confirm `file://` draws.\\n- [ ] Add the balance core, three-device input, Balance Disc, jointed doll, ragdoll recovery, and Fruit Hat. Lock them with tests from a fresh world.\\n40→- [ ] Add the island ritual (check-in, Wobble Age, jar, tilt) and every other §6 event, each tested from its own start.\\n- [ ] Add menus, attract, dev sliders, synthesized audio, glyphs, touch-only, Group Class, and the hub ghost session.\\n- [ ] Ship the ending, About/Credits, exit-interview.json, `{SCRATCH}/test-full.log` with zero failures, the two launch captures, and the hub log.\\n\\n## Risks / Contradictions\\n- TASK.md's three WebGPU flags alone lose the device while the frame counter still climbs. Rendering checks must also pass `--use-vulkan=swiftshader` and `--use-angle=swiftshader`. A lost device, or a readback that succeeds and is blank, is a failure.\\n- Software WebGPU is only a few frames per second here, and extra browsers are killed when memory runs out. Logic tests must not need a renderer; keep at most two browsers open.\\n- PLAN.md §18 lets a short build cut whole events in a fixed order. That does not relax this plan: this computer can run the full demo, so every §6 event is required. A stub, a placeholder, or a cut of a do-not-cut system fails.\\n- The hub rejects an edited `session.js` and checks its hash. If the published client hash differs from the hash written in PLAN.md, use the hash shipped with that client release and fail the build on a mismatch.\\n- A real pad unlocking audio, and whether the music sounds good, cannot be confirmed here. Signal tests, plus the on-screen prompt if audio stays suspended after pad input, are the bar.\\n\",\"content_concise\":\"1→# Plan: Build the original crooked-island balance game in PLAN.md and hand in every TASK.md file\\n\\n## Goal kind\\ncode-change\\n\\n## Acceptance criteria\\n1. The work-folder root contains one self-contained HTML file named `{GameTitle}-Wii Fit-grok-4.7-xhigh-20261104-231317.html`, a dev subfolder with that same basename, `PROGRESS.md`, and `exit-interview.json` beside the HTML. GameTitle is a playful riff on \\\"Wii Fit\\\" (not that name and not a source activity name), chosen with a real random-number generator and recorded in `PROGRESS.md`, and it is the title drawn on the title screen. The JSON parses as one object in TASK.md's exact shape: every `sourceInformation` value filled, `usage` exactly `added on import`, feedback arrays of length 4, 6, and 4 in question order, and `aiHub` whose `name` equals that title, `type` Game, `genre` from TASK.md's catalogue list, `source` Wii Fit, `players` `1–4`, 3–6 lowercase tags (`series` may be empty). The About/Credits screen shows those same strings. The page is Three.js R180 (WebGPU by default, WebGL2 fallback that still draws), a cel-shaded ink filter, Rapier 0.19.3, Web Audio, and the Gamepad API. It opens from `file://` with no external requests and no audio files. No TODO, placeholder, or stubbed feature remains. Source product names, the forbidden activities, and the source's