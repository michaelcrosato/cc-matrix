{\"line_number\":72,\"content\":\"    this.stones.push(body);\"},{\"line_number\":88,\"content\":\"    if (phase.id === 'stones' && !this.clearing && this.stones.length < 4 && this.phaseT > 1 + this.stones.length * 3) this.spawnStone();\"},{\"line_number\":89,\"content\":\"    if (phase.id === 'stones' && this.phaseT >= phase.len && !this.clearing) this.clearing = true;\"},{\"line_number\":91,\"content\":\"      if (this.stones.length) {\"},{\"line_number\":92,\"content\":\"        const body = this.stones.pop();\"},{\"line_number\":118,\"content\":\"    let sway = phase.id === 'hold' ? lerp(0.2, 0.02, this.phaseT / phase.len) : phase.id === 'stones' ? 0.12 : 0.1;\"},{\"line_number\":120,\"content\":\"    this.stepCores(dt, { margin: phase.id === 'stones' ? 0.8 : 0.55, ankleMax: 6, maxLean: 16 }, (i) => {\"},{\"line_number\":138,\"content\":\"    if (this.phaseT >= phase.len && !(phase.id === 'stones' && !this.plateGone)) {\"},{\"line_number\":165,\"content\":\"    const wish = correctWish({ ...skill, gain: skill?.gainLoad ?? 0.7 }, goal, past, this.t, phase?.id === 'stones', this.ph);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa57-1af6-7b91-b0b8-da8c4d991b66","uuid":"22f26b52-3c3f-4328-a8e9-88a0d78d6e44"}
