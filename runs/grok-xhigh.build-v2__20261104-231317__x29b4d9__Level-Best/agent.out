ll);\\n};\\n$('hide').onclick = () => {\\n  if (!current) return;\\n  current.hidden = !current.hidden;\\n370→  $('hide').setAttribute('aria-pressed', String(current.hidden));\\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\\n};\\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\\n\\n/* ---------------------------------------------------------------------------\\n * ?auto=1 — the conformance run. It presses keys inside each frame with\\n * synthetic events while the round plays (the frames must be served from this\\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\\n380→ * turns \\\"true\\\".\\n * ------------------------------------------------------------------------- */\\n\\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\nasync function until(test, ms) {\\n  const end = performance.now() + ms;\\n  while (performance.now() < end) {\\n    if (test()) return true;\\n    await sleep(50);\\n  }\\n390→  return test();\\n}\\n\\nfunction poke(cell, key) {\\n  const doc = cell.frame.contentDocument;\\n  const win = cell.frame.contentWindow;\\n  if (!doc || !win) return false;\\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\\n400→  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\\n  return true;\\n}\\n\\nasync function conformance() {\\n  const checks = [];\\n  const check = (name, pass, detail = '') => {\\n    checks.push({ name, pass: !!pass, detail });\\n    renderChecks(checks);\\n    return !!pass;\\n410→  };\\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('playe