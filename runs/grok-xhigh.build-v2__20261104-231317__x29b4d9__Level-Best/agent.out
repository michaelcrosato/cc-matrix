ing) return connecting.promise;\\n    var done;\\n    var promise = new Promise(function (resolve) {\\n      done = resolve;\\n    });\\n    connecting = { promise: promise, resolve: done };\\n    if (!hub.active) {\\n      done(null);\\n300→      return promise;\\n    }\\n    opts = opts || {};\\n    root.addEventListener('message', onMessage);\\n    var started = now();\\n    var hello = function () {\\n      if (welcomed) return;\\n      if (now() - started > HELLO_TIMEOUT_MS) {\\n        standAlone();\\n        warn('no hub answered; playing normally');\\n310→        done(null);\\n        return;\\n      }\\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\\n      setTimeout(hello, HELLO_EVERY_MS);\\n    };\\n    hello();\\n    return promise;\\n  };\\n\\n320→  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\\n  hub.ready = function () {\\n    if (!welcomed || sentReady || ended) return;\\n    sentReady = true;\\n    post('ready', {});\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/vendor/session.js\",\"offset\":285,\"limit\":40,\"raw_output\":\"    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\\n    out.players = hub.players.slice();\\n    return out;\\n  }\\n\\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\\n  hub.connect = function (opts) {\\n    if (connecting) return connecting.promise;\\n    var done;\\n    var promise = new Promise(function (resolve) {\\n      done = resolve;\\n    });\\n    connecting = { promise: promise, resolve: done };\\n    if (!hub.active) {\\n      done(null);\\n      return promise;\\n    }\\n    opts = opts || {};\\n    root.addEventListener('message', onMessage);\\n    var starte