t\":\"      const a = rng(this.label) * Math.PI * 2;\"},{\"line_number\":106,\"content\":\"      this.nextSwell += 5 + rng(this.label) * 2;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/tug.js\",\"matches\":[{\"line_number\":41,\"content\":\"    this.label = opts.label ?? 'tug';\"},{\"line_number\":48,\"content\":\"    return this.params.power * (0.8 + 0.4 * rng(this.label));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/plank.js\",\"matches\":[{\"line_number\":40,\"content\":\"    this.label = opts.label ?? 'plank';\"},{\"line_number\":53,\"content\":\"        const mag = this.params.push0 + rng(this.label) * span;\"},{\"line_number\":54,\"content\":\"        const same = rng(this.label) < 0.7;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/fruitHat.js\",\"matches\":[{\"line_number\":50,\"content\":\"    this.label = opts.label ?? `fruit-${opts.seed ?? 1}`;\"},{\"line_number\":140,\"content\":\"      const ang = rng(this.label) * Math.PI * 2;\"},{\"line_number\":141,\"content\":\"      const rad = Math.sqrt(rng(this.label)) * this.radius();\"},{\"line_number\":144,\"content\":\"      const kind = kindOf(rng(this.label));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231317__x29b4d9/work/Level Best-Wii Fit-grok-4.7-xhigh-20261104-231317/src/events/cairn.js\",\"matches\":[{\"line_number\":49,\"content\":\"    this.label = opts.label ?? 'cairn';\"},{\"line_number\":95,\"content\":\"    const x = origin.x + (rng(this.label) * 2 - 1) * off;\"},{\"line_number\":96,\"content\":\"    const z = origin.z + (rng(this.label) * 2 - 1) * off;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a