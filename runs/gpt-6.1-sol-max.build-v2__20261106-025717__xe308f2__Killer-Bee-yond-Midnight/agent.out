{"type":"item.completed","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport {newWorld,step} from './src/sim/world.js';import {pilot} from './src/sim/bot.js';\nfor(const seed of [7,23,701]){const s=newWorld({seed}),m={};for(let i=0;i<120*800;i++){step(s,[pilot(s,s.players[0],m)]);if(s.phase==='failed'||s.phase==='ending')break;}console.log({seed,phase:s.phase,stage:s.stage+1,time:s.time,bees:s.players[0].bees,kills:s.stats.kills});}\nJS\"","aggregated_output":"{\n  seed: 7,\n  phase: 'failed',\n  stage: 4,\n  time: 431.16666666643886,\n  bees: 0,\n  kills: 36\n}\n{\n  seed: 23,\n  phase: 'failed',\n  stage: 2,\n  time: 240.29166666661246,\n  bees: 0,\n  kills: 15\n}\n{\n  seed: 701,\n  phase: 'failed',\n  stage: 2,\n  time: 214.53333333330255,\n  bees: 0,\n  kills: 15\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"retry(app.world);app.lastPhase=null;\\\", \\\"retry(app.world);app.bestSaved=false;app.lastPhase=null;\\\").replace(\\\"retry(s);app.lastPhase=null;\\\", \\\"retry(s);app.bestSaved=false;app.lastPhase=null;\\\");s=s.replace(\\\"let local=app.local<0?{x:0,y:0,focus:false,ray:0}:actionFor(app.local);\\\", \\\"let local=app.isNetwork()?(app.local<0?{x:0,y:0,focus:false,ray:0}:actionFor(app.local)):{x:0,y:0,focus:false,ray:0};\\\");s=s.replace(\\\"app.world.dev.invulnerable=true;app.garden.reset(app.world);\\\", \\\"app.world.dev.invulnerable=true;app.world.tuning.maturation=.5;app.garden.reset(app.world);\\\");open(p,'w').write(s)\np='src/sim/world.js';s=open(p).read().replace(\\\"for(const o of STAGES[s.stage].obstacles)if(circleRect(x,y,r,o))return true;\\\", \\\"for(const o of (s.definition||STAGES[s.stage]).obstacles)if(circleRect(x,y,r,o))return true;\\\");s=s.replace(\\\"if(a===STAGES[index]&&\"'!topology({stage:index,husks:[]}))\", \"if(!topology({stage:index,definition:a,husks:[]}))\");open(p,'\"'w').write(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"retry(app.world);app.lastPhase=null;\\\", \\\"retry(app.world);app.bestSaved=false;app.lastPhase=null;\\\").replace(\\\"retry(s);app.lastPhase=null;\\\", \\\"retry(s);app.bestSaved=false;app.lastPhase=null;\\\");s=s.replace(\\\"let local=app.local<0?{x:0,y:0,focus:false,ray:0}:actionFor(app.local);\\\", \\\"let local=app.isNetwork()?(app.local<0?{x:0,y:0,focus:false,ray:0}:actionFor(app.local)):{x:0,y:0,focus:false,ray:0};\\\");s=s.replace(\\\"app.world.dev.invulnerable=true;app.garden.reset(app.world);\\\", \\\"app.world.dev.invulnerable=true;app.world.tuning.maturation=.5;app.garden.reset(app.world);\\\");open(p,'w').write(s)\np='src/sim/world.js';s=open(p).read().replace(\\\"for(const o of STAGES[s.stage].obstacles)if(circleRect(x,y,r,o))return true;\\\", \\\"for(const o of (s.definition||STAGES[s.stage]).obstacles)if(circleRect(x,y,r,o))return true;\\\");s=s.replace(\\\"if(a===STAGES[index]&&\"'!topology({stage:index,husks:[]}))\", \"if(!topology({stage:index,definition:a,husks:[]}))\");open(p,'\"'w').write(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"cat > tests/simulation.mjs <<'EOF'\nimport vm from 'node:vm';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {newWorld,step,clone,footprint,distance,blocked,topology,validateStages,enterStage,retry,tune,spawnRival,invariants,leave,STEP} from '../src/sim/world.js';\nimport {pilot} from '../src/sim/bot.js';\nimport {STAGES,DEFAULT_TUNING} from '../content/stages.js';\nimport {Authority,pack,unpack,validSnapshot,validateInput} from '../src/net/protocol.js';\nimport {Garden} from '../src/presentation/garden.js';\nexport async function simulation(check){\n const run=(s,seconds,commands=[])=>{for(let i=0;i<Math.round(seconds*120);i++)step(s,typeof commands==='function'?commands(s):commands);};\n const quiet=(players=1,stage=0)=>{const s=newWorld({players,stage});s.queue=[{at:1e9,type:'left',entrance:0}];s.nextRival=1e9;s.players.forEach(p=>p.inv=0);return s;};\n const target=(id=100,x=192,y=120,hp=1.65,type='left')=>({id,type,x,y,hp,maxHp:hp,r:7,dir:0,turn:-1,lastContact:-100,contrib:[0,0],warning:0,stuck:0,think:100,recovering:false,bossPhase:'move',bossT:0,circuit:0});\n const rival=(id=300,x=192,y=120,age=0)=>({id,x,y,r:8,dir:0,age,state:0,warning:0,turn:100,want:0,matureAt:-10});\n check('six valid authored encounters',STAGES.length===6&&validateStages().length===0);\n for(const [i,d]of STAGES.entries()){check(\"'`encounter ${i+1}: connected Focus routes`,topology({stage:i,husks:[]}));check(`encounter ${i+1}: schedules finish`,d.schedule.length>=7&&d.schedule.at(-1).at<=110&&d.rivals.cap<=5);}\n let bad=clone(STAGES);bad[0].obstacles=[{x:0,y:0,w:384,h:240}];check('\"'validator rejects fully blocked floor',validateStages(bad).some(e=>e.includes('disconnected')));\n bad=clone(STAGES);bad[0].schedule[0].type='dragon';check('validator rejects unsupported archetypes',validateStages(bad).some(e=>e.includes('schedule')));\n bad=clone(STAGES);bad[5].schedule=bad[5].schedule.filter(e=>e.type\"'!=='\"'bell');check('validator rejects unreachable final condition',validateStages(bad).some(e=>e.includes('concluding')));\n const a=newWorld({seed:77}),b=newWorld({seed:77});for(let i=0;i<2400;i++){const c=[{x:Math.sin(i/110),y:Math.cos(i/140),focus:i%160<40,ray:Math.floor(i/300)}];step(a,c);step(b,c);}check('seeded simulation is reproducible',JSON.stringify(a)===JSON.stringify(b));\n const restored=clone(a);run(a,2,[{x:.3,y:-.2,focus:false,ray:8}]);run(restored,2,[{x:.3,y:-.2,focus:false,ray:8}]);check('snapshot restore continues identically',JSON.stringify(a)===JSON.stringify(restored));\n let s=quiet(),p=s.players[0];p.x=180;p.y=120;run(s,.25,[{x:1,y:1,focus:false,ray:0}]);check('diagonal flight is normalized',Math.abs(distance(p,{x:180,y:120})-86*.25)<.001);\n let roam=quiet(),focus=quiet();run(roam,.25,[{x:1,y:0}]);run(focus,.25,[{x:1,y:0,focus:true}]);check('Focus has a real speed tradeoff',Math.abs((focus.players[0].x-176)/(roam.players[0].x-176)-.75)<.001);\n check('formation footprint follows bee count and Focus',footprint({bees:12,focus:false})>footprint({bees:4,focus:false})&&footprint({bees:12,focus:false})>footprint({bees:12,focus:true}));\n s=quiet();p=s.players[0];p.x=192;s.targets=[target()];run(s,.1);const wounded=s.targets[0].hp;check('only sustained valid overlap stings',wounded<1.65&&s.stats.contactTicks>0);p.x=50;p.y=200;run(s,.6);check('recovery has a contact-break grace',Math.abs(s.targets[0].hp-wounded)<.0001);run(s,.6);check('broken contact visibly recovers target',s.targets[0].hp>wounded&&s.targets[0].recovering);run(s,5);check('full recovery clears old contributors',s.targets[0].hp===s.targets[0].maxHp&&s.targets[0].contrib.every(n=>n===0));\n s=quiet(2);p=s.players[0];p.x=192;p.y=120;s.players[1].x=300;s.players[1].y=120;s.targets=[target(100,50,40)];s.husks=[{id:101,x:240,y:120,r:9}];s.rivals=[rival(300,60,120),rival(301,192,120),rival(302,320,180)];step(s,[{ray:1}]);check('horizontal ray hits both sides and touching rivals',s.rivals.length===1&&s.rivals[0].id===302&&s.stats.zaps===2);check('ray spares gardeners, shells and friendly bees',s.targets[0].hp===1.65&&s.husks.length===1&&s.players.every(p=>p.bees===12));check('ray spends one nonstacking charge',p.charge===0);step(s,[{ray:2}]);check('empty ray gives dry cue without movement lock',s.stats.rays===1&&s.events.some(e=>e.type==='dry'));\n s=quiet();p=s.players[0];p.x=192;s.targets=[target(100,192,120,.001)];step(s,[{ray:1}]);check('same-tick spend occurs before kill refill',p.charge===1&&s.stats.refills===1&&s.stats.rays===1);const score=s.score;run(s,.1);check('target death owns one score and one shell event',s.score===score&&s.husks.length===1&&s.events.filter(e=>e.type==='collapse').length===1);check('kill shell ejects friendly centroid to legal space',\"'!blocked(s,p.x,p.y,footprint(p)));\n s=quiet(2);s.players.forEach(p=>{p.charge=0;p.x=192;p.y=120;});let t=target(100,192,120,.001);t.contrib=[2,4];s.targets=[t];step(s,[]);check('\"'co-op refill honors greatest empty contributor',s.players[1].charge===1&&s.players[0].charge===0);\n s=quiet(2);s.players.forEach(p=>{p.charge=0;p.x=300;p.y=200;});s.players[0].emptyAt=3;s.players[1].emptyAt=1;s.targets=[target(100,192,120,0)];step(s,[]);check('co-op fallback honors longest-empty living player',s.players[1].charge===1&&s.players[0].charge===0);\n s=quiet(2);s.players.forEach(p=>{p.charge=0;p.x=192;p.y=120;});s.targets=[target(100,192,120,.001),target(101,193,120,.001)];step(s,[]);check('simultaneous co-op kills award two distinct refills',s.players.every(p=>p.charge===1)&&s.stats.refills===2&&s.stats.kills===2);\n s=quiet();p=s.players[0];s.rivals=Array.from({length:5},(_,i)=>rival(300+i,p.x,p.y));for(let i=0;i<120;i++){s.rivals.forEach(a=>{a.x=p.x;a.y=p.y;});step(s,[]);}check('overlapping threats respect one-bee damage cadence',p.bees===10&&s.stats.losses===2);check('damage has a visible one-shot event',s.events.filter(e=>e.type==='loss').length===2);\n s=quiet();s.rivals=[rival(300,350,200,14.99)];step(s);check('scout matures into guard',s.rivals[0].state===0);run(s,.1);check('guard has explicit maturation event',s.rivals[0].state===1&&s.events.some(e=>e.type==='mature'));s.rivals[0].age=31;run(s,.1);check('guard becomes pursuing hunter',s.rivals[0].state===2);\n s=quiet();check('entrance warning is never zero',spawnRival(s)&&s.rivals[0].warning>=.7&&s.players.every(p=>distance(p,s.rivals[0])>=40));\n for(let i=0;i<6;i++){s=quiet(1,i);for(let j=0;j<8;j++){const x=30+(j%4)*90,y=30+Math.floor(j/4)*180;s.targets=[target(100+j,x,y,0)];step(s,[]);}check(\"'`encounter ${i+1}: shells preserve reachable topology`,topology(s)&&s.husks.length===8);}\n s=quiet(1,3);p=s.players[0];p.x=96;p.y=119;run(s,.8,[{x:1,y:0,focus:false}]);const roamX=p.x;s=quiet(1,3);p=s.players[0];p.x=96;p.y=119;run(s,.8,[{x:1,y:0,focus:true}]);check('\"'authored gap admits Focus and rejects broad Roam',roamX<116&&p.x>134);\n s=quiet(2);s.players[0].bees=0;run(s,.2);check('one fallen co-op swarm observes while team continues',s.phase==='play'&&s.players[1].bees===12);s.queue=[];step(s);run(s,4.1);check('checkpoint clear replenishes fallen teammate',s.stage===1&&s.players.every(p=>p.bees===12));\n s=quiet(2);s.players.forEach(p=>p.bees=0);step(s);check('complete co-op wipe fails once',s.phase==='failed'&&s.events.filter(e=>e.type==='defeat').length===1);s.checkpoint={score:720,streak:2};s.score=900;retry(s);check('retry restores playable assisted checkpoint',s.phase==='play'&&s.score===720&&s.streak===2&&s.assisted&&s.players.every(p=>p.bees===12));tune(s,'speed',999);check('live tuning clamps and remembers assisted history',s.tuning.speed===135&&s.assisted);tune(s,'speed',86);check('resetting defaults cannot clean assisted history',s.assisted);check('invalid tuning is rejected',\"'!tune(s,'\"'speed',NaN));leave(s,1);check('departed player is neutralized',\"'!s.players[1].joined&&s.players[1].bees===0);\n s=quiet(1,5);s.queue=[{at:0,type:'\"'bell',entrance:0}];step(s);run(s,1.4);check('concluding gardener exposes a clear core',s.targets[0]?.bossPhase==='open'&&s.stats.bossExposures>0);t=s.targets[0];t.bossPhase='pulse';t.bossT=1.49;p=s.players[0];p.x=t.x+30;p.y=t.y;const oldX=p.x;step(s);step(s);check('telegraphed bell pulse pushes without bee damage',p.bees===12&&p.x>oldX&&s.stats.bossPulses===1);\n const packet=pack(s),copy=unpack(packet);check('compact snapshots preserve campaign and player state',validSnapshot(packet)&&copy.stage===s.stage&&copy.players[0].bees===12&&copy.targets[0].bossPhase===s.targets[0].bossPhase);\n let record={seq:-1,ray:0};const input={t:'i',v:1,seq:1,stage:0,x:.5,y:0,focus:false,ray:1};check('network accepts finite owned intention',\"'!!validateInput(input,record,0));check('\"'network rejects forged score/coordinates as commands',\"'!validateInput({...input,x:Infinity},record,0)&&!validateInput({...input,ray:100},record,0));check('\"'network rejects stale phase and sequence',\"'!validateInput({...input,stage:1},record,0)&&!validateInput(input,{seq:1,ray:1},0));\n s=quiet(2);const wire=[],authority=new Authority({host:true,local:0,send:(m,o)=>wire.push({m,o}),onSnapshot:()=>{}});authority.receive(input,1,1,s);run(s,.1,authority.commands(s,{x:0,y:0,ray:0},1.1));check('\"'guest intention moves its own authoritative seat',s.players[1].x>208&&s.players[0].x===176);check('lost release is bounded by stale-input timeout',authority.commands(s,{},1.6)[1].x===0&&authority.commands(s,{},1.6)[1].focus===false);for(let i=0;i<1200;i++)authority.update(s,{},i/120);check('host traffic stays under official rate budget',authority.metrics.maxRate<=13&&authority.metrics.maxBytes<16384&&authority.metrics.unreliableMax<=1200);\n const sink=new Authority({host:false,local:1,send:()=>{},onSnapshot:()=>{}});for(let i=0;i<1200;i++)sink.update(s,{x:0,y:0,focus:false,ray:1},i/120);check('guest traffic stays under official rate budget',sink.metrics.maxRate<=16);\n // Principal completion proof: only ordinary movement/Focus/ray commands. No cheats, teleports or health edits.\n const campaign=newWorld({players:2,seed:4117}),mem=[{},{}];let worst=0,unreachable=false,healthIssue=false;\n for(let i=0;i<120*800;i++){\n  const commands=campaign.players.map((p,j)=>pilot(campaign,p,mem[j]));step(campaign,commands);\n  if(i%120===0){worst=Math.max(worst,new TextEncoder().encode(JSON.stringify(pack(campaign))).length);if(invariants(campaign).length)healthIssue=true;}\n  if(campaign.phase==='failed'||campaign.phase==='ending')break;\n }\n check('normal-command pilot completes all six encounters',campaign.phase==='ending'&&campaign.stats.clears===6,\"'`phase=${campaign.phase}, stage=${campaign.stage+1}, t=${campaign.time}`);\n check('\"'campaign pacing leaves headroom below Hub cap',campaign.time>=600&&campaign.time<=720,\"'`${campaign.time.toFixed(2)} s`);\n check('\"'campaign proof used no assisted or invulnerable state',\"'!campaign.assisted&&!campaign.dev.invulnerable);\n check('\"'campaign proof exercised Focus, sting, recovery and bee loss',campaign.stats.focusTicks>0&&campaign.stats.contactTicks>0&&campaign.stats.recoveries>0&&campaign.stats.losses>0);\n check('campaign proof exercised rays, maturation and concluding pulse',campaign.stats.rays>0&&campaign.stats.zaps>0&&campaign.stats.maturations>0&&campaign.stats.bossExposures>0&&campaign.stats.bossPulses>0);\n check('worst authored snapshot fits tested reliable strategy',worst<16384&&worst>0,\"'`${worst} bytes`);check('\"'whole campaign state remains finite and bounded',\"'!healthIssue);\n writeFileSync(new URL('\"'../evidence/campaign.json',import.meta.url),JSON.stringify({phase:campaign.phase,seconds:campaign.time,score:campaign.score,bees:campaign.players.map(p=>p.bees),stats:campaign.stats,cleared:campaign.cleared,maxSnapshotBytes:worst,assisted:campaign.assisted},null,2)+'\\\\n');\n const logs=[],ctx={console:{log:()=>{},warn:(...a)=>logs.push(a.join(' ')),error:(...a)=>logs.push(a.join(' '))},performance,TextEncoder};vm.createContext(ctx);vm.runInContext(readFileSync(new URL('../vendor/engine/my-3d2dge.js',import.meta.url),'utf8'),ctx);\n const E=ctx.My3D2dge,game=new E.Game({headless:true,draw:true,res:[480,320],view:'overhead',input:{...E.Input.SHMUP,focus:['ShiftLeft']}}),nativeWorld=newWorld(),garden=new Garden(E,game);\n game.start({update(dt){const m=game.input.move();step(nativeWorld,[{x:m[0],y:m[1],focus:game.input.down('focus'),ray:game.input.down('fire')?1:0}],dt);garden.update(dt,nativeWorld);},draw(r){garden.draw(r,nativeWorld);},boot:false});\n game.input.hold('right');game.advance(.25);game.input.hold('right',false);game.input.tap('fire');game.advance(.1);check('native fixed-step headless input drives actual simulation',nativeWorld.players[0].x>190&&nativeWorld.stats.rays===1);check('native renderer draws same rigs without collected errors',game.errors.length===0,JSON.stringify(game.errors));game.dispose();\n}\nEOF\ncat > tools/test.mjs <<'EOF'\nimport{resolve,dirname}from'node:path';import{fileURLToPath}from'node:url';import{spawnSync}from'node:child_process';import{writeFileSync,readFileSync}from'node:fs';\nconst root=resolve(dirname(fileURLToPath(import.meta.url)),'..');process.chdir(root);\nconst group=process.argv.find(a=>a.startsWith('--group='))?.split('=')[1]||'all';let passed=0,failed=0;const failures=[];\nconst check=(name,ok,detail='')=>{if(ok)passed++;else{failed++;failures.push({name,detail});console.log(\"'`FAIL ${name}${detail?'\"': '+detail:''}\"'`);}};\ntry{\n if(group==='\"'all'||group==='sim'){const{simulation}=await import('../tests/simulation.mjs');await simulation(check);}\n if(group\"'!=='\"'sim'){\n  const result=spawnSync('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/browser.py','--group',group],{cwd:root,encoding:'utf8',maxBuffer:8*1024*1024});\n  if(result.stdout){let report;try{report=JSON.parse(result.stdout);}catch{check('browser runner returned JSON',false,result.stdout.slice(-2000));}\n   if(report){passed+=report.passed;failed+=report.failed;for(const f of report.failures){failures.push(f);console.log(\"'`FAIL ${f.name}: ${f.detail}`);}}\n  }\n  if(result.status!==0&&!result.stdout)check('\"'browser runner completed',false,result.stderr.slice(-3000));\n }\n}catch(error){check('test runner completed',false,error.stack);}\nwriteFileSync(resolve(root,'evidence/test-results.json'),JSON.stringify({group,passed,failed,failures},null,2)+'\\\\n');\nconsole.log(\"'`${passed+failed} checks: ${passed} passed, ${failed} failed`);process.exitCode=failed?1:0;\nEOF\nnode tools/test.mjs --group=sim'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"cat > tests/simulation.mjs <<'EOF'\nimport vm from 'node:vm';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {newWorld,step,clone,footprint,distance,blocked,topology,validateStages,enterStage,retry,tune,spawnRival,invariants,leave,STEP} from '../src/sim/world.js';\nimport {pilot} from '../src/sim/bot.js';\nimport {STAGES,DEFAULT_TUNING} from '../content/stages.js';\nimport {Authority,pack,unpack,validSnapshot,validateInput} from '../src/net/protocol.js';\nimport {Garden} from '../src/presentation/garden.js';\nexport async function simulation(check){\n const run=(s,seconds,commands=[])=>{for(let i=0;i<Math.round(seconds*120);i++)step(s,typeof commands==='function'?commands(s):commands);};\n const quiet=(players=1,stage=0)=>{const s=newWorld({players,stage});s.queue=[{at:1e9,type:'left',entrance:0}];s.nextRival=1e9;s.players.forEach(p=>p.inv=0);return s;};\n const target=(id=100,x=192,y=120,hp=1.65,type='left')=>({id,type,x,y,hp,maxHp:hp,r:7,dir:0,turn:-1,lastContact:-100,contrib:[0,0],warning:0,stuck:0,think:100,recovering:false,bossPhase:'move',bossT:0,circuit:0});\n const rival=(id=300,x=192,y=120,age=0)=>({id,x,y,r:8,dir:0,age,state:0,warning:0,turn:100,want:0,matureAt:-10});\n check('six valid authored encounters',STAGES.length===6&&validateStages().length===0);\n for(const [i,d]of STAGES.entries()){check(\"'`encounter ${i+1}: connected Focus routes`,topology({stage:i,husks:[]}));check(`encounter ${i+1}: schedules finish`,d.schedule.length>=7&&d.schedule.at(-1).at<=110&&d.rivals.cap<=5);}\n let bad=clone(STAGES);bad[0].obstacles=[{x:0,y:0,w:384,h:240}];check('\"'validator rejects fully blocked floor',validateStages(bad).some(e=>e.includes('disconnected')));\n bad=clone(STAGES);bad[0].schedule[0].type='dragon';check('validator rejects unsupported archetypes',validateStages(bad).some(e=>e.includes('schedule')));\n bad=clone(STAGES);bad[5].schedule=bad[5].schedule.filter(e=>e.type\"'!=='\"'bell');check('validator rejects unreachable final condition',validateStages(bad).some(e=>e.includes('concluding')));\n const a=newWorld({seed:77}),b=newWorld({seed:77});for(let i=0;i<2400;i++){const c=[{x:Math.sin(i/110),y:Math.cos(i/140),focus:i%160<40,ray:Math.floor(i/300)}];step(a,c);step(b,c);}check('seeded simulation is reproducible',JSON.stringify(a)===JSON.stringify(b));\n const restored=clone(a);run(a,2,[{x:.3,y:-.2,focus:false,ray:8}]);run(restored,2,[{x:.3,y:-.2,focus:false,ray:8}]);check('snapshot restore continues identically',JSON.stringify(a)===JSON.stringify(restored));\n let s=quiet(),p=s.players[0];p.x=180;p.y=120;run(s,.25,[{x:1,y:1,focus:false,ray:0}]);check('diagonal flight is normalized',Math.abs(distance(p,{x:180,y:120})-86*.25)<.001);\n let roam=quiet(),focus=quiet();run(roam,.25,[{x:1,y:0}]);run(focus,.25,[{x:1,y:0,focus:true}]);check('Focus has a real speed tradeoff',Math.abs((focus.players[0].x-176)/(roam.players[0].x-176)-.75)<.001);\n check('formation footprint follows bee count and Focus',footprint({bees:12,focus:false})>footprint({bees:4,focus:false})&&footprint({bees:12,focus:false})>footprint({bees:12,focus:true}));\n s=quiet();p=s.players[0];p.x=192;s.targets=[target()];run(s,.1);const wounded=s.targets[0].hp;check('only sustained valid overlap stings',wounded<1.65&&s.stats.contactTicks>0);p.x=50;p.y=200;run(s,.6);check('recovery has a contact-break grace',Math.abs(s.targets[0].hp-wounded)<.0001);run(s,.6);check('broken contact visibly recovers target',s.targets[0].hp>wounded&&s.targets[0].recovering);run(s,5);check('full recovery clears old contributors',s.targets[0].hp===s.targets[0].maxHp&&s.targets[0].contrib.every(n=>n===0));\n s=quiet(2);p=s.players[0];p.x=192;p.y=120;s.players[1].x=300;s.players[1].y=120;s.targets=[target(100,50,40)];s.husks=[{id:101,x:240,y:120,r:9}];s.rivals=[rival(300,60,120),rival(301,192,120),rival(302,320,180)];step(s,[{ray:1}]);check('horizontal ray hits both sides and touching rivals',s.rivals.length===1&&s.rivals[0].id===302&&s.stats.zaps===2);check('ray spares gardeners, shells and friendly bees',s.targets[0].hp===1.65&&s.husks.length===1&&s.players.every(p=>p.bees===12));check('ray spends one nonstacking charge',p.charge===0);step(s,[{ray:2}]);check('empty ray gives dry cue without movement lock',s.stats.rays===1&&s.events.some(e=>e.type==='dry'));\n s=quiet();p=s.players[0];p.x=192;s.targets=[target(100,192,120,.001)];step(s,[{ray:1}]);check('same-tick spend occurs before kill refill',p.charge===1&&s.stats.refills===1&&s.stats.rays===1);const score=s.score;run(s,.1);check('target death owns one score and one shell event',s.score===score&&s.husks.length===1&&s.events.filter(e=>e.type==='collapse').length===1);check('kill shell ejects friendly centroid to legal space',\"'!blocked(s,p.x,p.y,footprint(p)));\n s=quiet(2);s.players.forEach(p=>{p.charge=0;p.x=192;p.y=120;});let t=target(100,192,120,.001);t.contrib=[2,4];s.targets=[t];step(s,[]);check('\"'co-op refill honors greatest empty contributor',s.players[1].charge===1&&s.players[0].charge===0);\n s=quiet(2);s.players.forEach(p=>{p.charge=0;p.x=300;p.y=200;});s.players[0].emptyAt=3;s.players[1].emptyAt=1;s.targets=[target(100,192,120,0)];step(s,[]);check('co-op fallback honors longest-empty living player',s.players[1].charge===1&&s.players[0].charge===0);\n s=quiet(2);s.players.forEach(p=>{p.charge=0;p.x=192;p.y=120;});s.targets=[target(100,192,120,.001),target(101,193,120,.001)];step(s,[]);check('simultaneous co-op kills award two distinct refills',s.players.every(p=>p.charge===1)&&s.stats.refills===2&&s.stats.kills===2);\n s=quiet();p=s.players[0];s.rivals=Array.from({length:5},(_,i)=>rival(300+i,p.x,p.y));for(let i=0;i<120;i++){s.rivals.forEach(a=>{a.x=p.x;a.y=p.y;});step(s,[]);}check('overlapping threats respect one-bee damage cadence',p.bees===10&&s.stats.losses===2);check('damage has a visible one-shot event',s.events.filter(e=>e.type==='loss').length===2);\n s=quiet();s.rivals=[rival(300,350,200,14.99)];step(s);check('scout matures into guard',s.rivals[0].state===0);run(s,.1);check('guard has explicit maturation event',s.rivals[0].state===1&&s.events.some(e=>e.type==='mature'));s.rivals[0].age=31;run(s,.1);check('guard becomes pursuing hunter',s.rivals[0].state===2);\n s=quiet();check('entrance warning is never zero',spawnRival(s)&&s.rivals[0].warning>=.7&&s.players.every(p=>distance(p,s.rivals[0])>=40));\n for(let i=0;i<6;i++){s=quiet(1,i);for(let j=0;j<8;j++){const x=30+(j%4)*90,y=30+Math.floor(j/4)*180;s.targets=[target(100+j,x,y,0)];step(s,[]);}check(\"'`encounter ${i+1}: shells preserve reachable topology`,topology(s)&&s.husks.length===8);}\n s=quiet(1,3);p=s.players[0];p.x=96;p.y=119;run(s,.8,[{x:1,y:0,focus:false}]);const roamX=p.x;s=quiet(1,3);p=s.players[0];p.x=96;p.y=119;run(s,.8,[{x:1,y:0,focus:true}]);check('\"'authored gap admits Focus and rejects broad Roam',roamX<116&&p.x>134);\n s=quiet(2);s.players[0].bees=0;run(s,.2);check('one fallen co-op swarm observes while team continues',s.phase==='play'&&s.players[1].bees===12);s.queue=[];step(s);run(s,4.1);check('checkpoint clear replenishes fallen teammate',s.stage===1&&s.players.every(p=>p.bees===12));\n s=quiet(2);s.players.forEach(p=>p.bees=0);step(s);check('complete co-op wipe fails once',s.phase==='failed'&&s.events.filter(e=>e.type==='defeat').length===1);s.checkpoint={score:720,streak:2};s.score=900;retry(s);check('retry restores playable assisted checkpoint',s.phase==='play'&&s.score===720&&s.streak===2&&s.assisted&&s.players.every(p=>p.bees===12));tune(s,'speed',999);check('live tuning clamps and remembers assisted history',s.tuning.speed===135&&s.assisted);tune(s,'speed',86);check('resetting defaults cannot clean assisted history',s.assisted);check('invalid tuning is rejected',\"'!tune(s,'\"'speed',NaN));leave(s,1);check('departed player is neutralized',\"'!s.players[1].joined&&s.players[1].bees===0);\n s=quiet(1,5);s.queue=[{at:0,type:'\"'bell',entrance:0}];step(s);run(s,1.4);check('concluding gardener exposes a clear core',s.targets[0]?.bossPhase==='open'&&s.stats.bossExposures>0);t=s.targets[0];t.bossPhase='pulse';t.bossT=1.49;p=s.players[0];p.x=t.x+30;p.y=t.y;const oldX=p.x;step(s);step(s);check('telegraphed bell pulse pushes without bee damage',p.bees===12&&p.x>oldX&&s.stats.bossPulses===1);\n const packet=pack(s),copy=unpack(packet);check('compact snapshots preserve campaign and player state',validSnapshot(packet)&&copy.stage===s.stage&&copy.players[0].bees===12&&copy.targets[0].bossPhase===s.targets[0].bossPhase);\n let record={seq:-1,ray:0};const input={t:'i',v:1,seq:1,stage:0,x:.5,y:0,focus:false,ray:1};check('network accepts finite owned intention',\"'!!validateInput(input,record,0));check('\"'network rejects forged score/coordinates as commands',\"'!validateInput({...input,x:Infinity},record,0)&&!validateInput({...input,ray:100},record,0));check('\"'network rejects stale phase and sequence',\"'!validateInput({...input,stage:1},record,0)&&!validateInput(input,{seq:1,ray:1},0));\n s=quiet(2);const wire=[],authority=new Authority({host:true,local:0,send:(m,o)=>wire.push({m,o}),onSnapshot:()=>{}});authority.receive(input,1,1,s);run(s,.1,authority.commands(s,{x:0,y:0,ray:0},1.1));check('\"'guest intention moves its own authoritative seat',s.players[1].x>208&&s.players[0].x===176);check('lost release is bounded by stale-input timeout',authority.commands(s,{},1.6)[1].x===0&&authority.commands(s,{},1.6)[1].focus===false);for(let i=0;i<1200;i++)authority.update(s,{},i/120);check('host traffic stays under official rate budget',authority.metrics.maxRate<=13&&authority.metrics.maxBytes<16384&&authority.metrics.unreliableMax<=1200);\n const sink=new Authority({host:false,local:1,send:()=>{},onSnapshot:()=>{}});for(let i=0;i<1200;i++)sink.update(s,{x:0,y:0,focus:false,ray:1},i/120);check('guest traffic stays under official rate budget',sink.metrics.maxRate<=16);\n // Principal completion proof: only ordinary movement/Focus/ray commands. No cheats, teleports or health edits.\n const campaign=newWorld({players:2,seed:4117}),mem=[{},{}];let worst=0,unreachable=false,healthIssue=false;\n for(let i=0;i<120*800;i++){\n  const commands=campaign.players.map((p,j)=>pilot(campaign,p,mem[j]));step(campaign,commands);\n  if(i%120===0){worst=Math.max(worst,new TextEncoder().encode(JSON.stringify(pack(campaign))).length);if(invariants(campaign).length)healthIssue=true;}\n  if(campaign.phase==='failed'||campaign.phase==='ending')break;\n }\n check('normal-command pilot completes all six encounters',campaign.phase==='ending'&&campaign.stats.clears===6,\"'`phase=${campaign.phase}, stage=${campaign.stage+1}, t=${campaign.time}`);\n check('\"'campaign pacing leaves headroom below Hub cap',campaign.time>=600&&campaign.time<=720,\"'`${campaign.time.toFixed(2)} s`);\n check('\"'campaign proof used no assisted or invulnerable state',\"'!campaign.assisted&&!campaign.dev.invulnerable);\n check('\"'campaign proof exercised Focus, sting, recovery and bee loss',campaign.stats.focusTicks>0&&campaign.stats.contactTicks>0&&campaign.stats.recoveries>0&&campaign.stats.losses>0);\n check('campaign proof exercised rays, maturation and concluding pulse',campaign.stats.rays>0&&campaign.stats.zaps>0&&campaign.stats.maturations>0&&campaign.stats.bossExposures>0&&campaign.stats.bossPulses>0);\n check('worst authored snapshot fits tested reliable strategy',worst<16384&&worst>0,\"'`${worst} bytes`);check('\"'whole campaign state remains finite and bounded',\"'!healthIssue);\n writeFileSync(new URL('\"'../evidence/campaign.json',import.meta.url),JSON.stringify({phase:campaign.phase,seconds:campaign.time,score:campaign.score,bees:campaign.players.map(p=>p.bees),stats:campaign.stats,cleared:campaign.cleared,maxSnapshotBytes:worst,assisted:campaign.assisted},null,2)+'\\\\n');\n const logs=[],ctx={console:{log:()=>{},warn:(...a)=>logs.push(a.join(' ')),error:(...a)=>logs.push(a.join(' '))},performance,TextEncoder};vm.createContext(ctx);vm.runInContext(readFileSync(new URL('../vendor/engine/my-3d2dge.js',import.meta.url),'utf8'),ctx);\n const E=ctx.My3D2dge,game=new E.Game({headless:true,draw:true,res:[480,320],view:'overhead',input:{...E.Input.SHMUP,focus:['ShiftLeft']}}),nativeWorld=newWorld(),garden=new Garden(E,game);\n game.start({update(dt){const m=game.input.move();step(nativeWorld,[{x:m[0],y:m[1],focus:game.input.down('focus'),ray:game.input.down('fire')?1:0}],dt);garden.update(dt,nativeWorld);},draw(r){garden.draw(r,nativeWorld);},boot:false});\n game.input.hold('right');game.advance(.25);game.input.hold('right',false);game.input.tap('fire');game.advance(.1);check('native fixed-step headless input drives actual simulation',nativeWorld.players[0].x>190&&nativeWorld.stats.rays===1);check('native renderer draws same rigs without collected errors',game.errors.length===0,JSON.stringify(game.errors));game.dispose();\n}\nEOF\ncat > tools/test.mjs <<'EOF'\nimport{resolve,dirname}from'node:path';import{fileURLToPath}from'node:url';import{spawnSync}from'node:child_process';import{writeFileSync,readFileSync}from'node:fs';\nconst root=resolve(dirname(fileURLToPath(import.meta.url)),'..');process.chdir(root);\nconst group=process.argv.find(a=>a.startsWith('--group='))?.split('=')[1]||'all';let passed=0,failed=0;const failures=[];\nconst check=(name,ok,detail='')=>{if(ok)passed++;else{failed++;failures.push({name,detail});console.log(\"'`FAIL ${name}${detail?'\"': '+detail:''}\"'`);}};\ntry{\n if(group==='\"'all'||group==='sim'){const{simulation}=await import('../tests/simulation.mjs');await simulation(check);}\n if(group\"'!=='\"'sim'){\n  const result=spawnSync('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/browser.py','--group',group],{cwd:root,encoding:'utf8',maxBuffer:8*1024*1024});\n  if(result.stdout){let report;try{report=JSON.parse(result.stdout);}catch{check('browser runner returned JSON',false,result.stdout.slice(-2000));}\n   if(report){passed+=report.passed;failed+=report.failed;for(const f of report.failures){failures.push(f);console.log(\"'`FAIL ${f.name}: ${f.detail}`);}}\n  }\n  if(result.status!==0&&!result.stdout)check('\"'browser runner completed',false,result.stderr.slice(-3000));\n }\n}catch(error){check('test runner completed',false,error.stack);}\nwriteFileSync(resolve(root,'evidence/test-results.json'),JSON.stringify({group,passed,failed,failures},null,2)+'\\\\n');\nconsole.log(\"'`${passed+failed} checks: ${passed} passed, ${failed} failed`);process.exitCode=failed?1:0;\nEOF\nnode tools/test.mjs --group=sim'","aggregated_output":"FAIL simultaneous co-op kills award two distinct refills\n75 checks: 74 passed, 1 failed\n","exit_code":1,"status":"failed"}}
