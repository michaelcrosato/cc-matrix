t[k,sp]of Object.entries(TUNING_SPECS))S.set('dev_'+k,sp.value);ui.show('tuning',{});}],['Back',()=>ui.back()]]})]),['Encounter & seed',()=>{ui.show('encounter-tools',{title:'Encounter & seed',rows:['devStage','devSeed'],text:'Choose a seed and encounter, then restart to apply.',actions:[['Restart selected encounter',restart],['Random seed',()=>{S.set('devSeed',crypto.getRandomValues(new Uint32Array(1))[0]%100000);ui.show('encounter-tools',{});}],['Back',()=>ui.back()]]});}],['Playback & cheats',()=>ui.show('playback',{title:'Playback & cheats',rows:['devTime','devInvincible'],text:'Live preview keeps the world running behind these tools. Closing the workbench restores normal speed.',actions:[['Single simulation step',()=>{app.applyPending();app.world.assisted=true;step(app.world,[]);app.garden?.update(1/120,app.world);}],['Toggle live preview',()=>{game.live=\"'!game.live;ui.show('\"'playback',{});}],['Refill both rays',()=>{app.world.assisted=true;for(const p of app.world.players)if(p.bees)p.charge=1;}],['Spawn rival with warning',()=>{app.world.assisted=true;spawnRival(app.world);}],['Back',()=>ui.back()]]})],['Export snapshot',exportSnapshot],['Back',()=>ui.back()]]});\n };\n function diagnostics(){ui.show('diagnostics',{title:'Network diagnostics',text:JSON.stringify(app.net?.metrics||{mode:app.mode,tick:app.world.tick},null,2),actions:[['Refresh',diagnostics],['Back',()=>ui.back()]]});}\n app.closeDev=()=>{if(\"'!app.devOpen)return;app.devOpen=false;game.timeScale=1;game.live=app.isNetwork();app.clearInput();};\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"sed -n '1280,1335p' vendor/engine/my-3d2dge.js && sed -n '1080,1123p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"sed -n '1280,1335p' vendor/engine/my-3d2dge.js && sed -n '1080,1123p' vendor/engine/my-3d2dge.js\"","aggregated_output":"const ZOOM_KEYS = { Minus: 1 / 1.1, NumpadSubtract: 1 / 1.1, Equal: 1.1, NumpadAdd: 1.1 };\n/* menu actions shared by every preset. Pad9 = Start, Pad0 = A (bottom), Pad1 = B (right). use() adds 'Act:menu', the\n   touch START button, to start and pause in any layout: like Start, it starts on a title and pauses a pausable scene */\nconst MENU_KEYS = {\n  start: ['Enter', 'NumpadEnter', 'Pad9'], pause: ['Escape', 'KeyP', 'Pad9'],\n  confirm: ['Enter', 'NumpadEnter', 'Space', 'KeyJ', 'KeyZ', 'Pad0'], cancel: ['Escape', 'Backspace', 'KeyX', 'KeyK', 'Pad1']\n};\n/* rebinding: the codes a player may bind (not Escape, Enter, the F keys, Start or Home: the menus and the browser keep\n   them), the arrow keys and d-pad that stay on the moves whatever is bound, and which codes are a gamepad's */\nconst BINDABLE = /^(Key[A-Z]|Digit\\d|Numpad\\d|Arrow(Up|Down|Left|Right)|Space|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Tab|Backspace|Backquote|Minus|Equal|Bracket(Left|Right)|Backslash|Semicolon|Quote|Comma|Period|Slash|CapsLock|Mouse[0-4]|Wheel(Up|Down)|Pad([0-8]|1[0-5])|PadRAxis(Up|Down|Left|Right))$/;\nconst FIXED_CODES = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight']);\n/* the left stick past halfway presses the direction actions, as the d-pad does (menus, dialog choices, ladders) */\nconst STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\nconst padCode = c => c.startsWith('Pad'), RSTICK = ['PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight'];   // (the right stick's codes, past halfway)\n/* a standard gamepad's buttons by position (0 bottom, 1 right, 2 left, 3 top, 4-7 shoulders and triggers, 8 back, 9 start,\n   10-11 stick clicks, 12-15 d-pad, 16 home), as each family prints them */\nconst PAD_GLYPHS = {\n  xbox: ['A', 'B', 'X', 'Y', 'LB', 'RB', 'LT', 'RT', 'View', 'Menu', 'LS', 'RS', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Guide'],\n  playstation: ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'PS'],\n  nintendo: ['B', 'A', 'Y', 'X', 'L', 'R', 'ZL', 'ZR', '−', '+', 'L stick', 'R stick', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home'],\n  generic: ['Bottom', 'Right', 'Left', 'Top', 'L1', 'R1', 'L2', 'R2', 'Select', 'Start', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home']\n};\nconst CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',\n  Enter: 'Enter', NumpadEnter: 'Enter', Escape: 'Esc', Backspace: 'Backspace', Tab: 'Tab', CapsLock: 'Caps', ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→',\n  Mouse0: 'Left click', Mouse1: 'Middle click', Mouse2: 'Right click', Mouse3: 'Mouse 4', Mouse4: 'Mouse 5', Backquote: '`', Minus: '-', Equal: '=', BracketLeft: '[',\n  BracketRight: ']', Backslash: '\\\\', Semicolon: ';', Quote: \"'\", Comma: ',', Period: '.', Slash: '/',\n  PadAxisUp: 'L stick ↑', PadAxisDown: 'L stick ↓', PadAxisLeft: 'L stick ←', PadAxisRight: 'L stick →',\n  PadRAxisUp: 'R stick ↑', PadRAxisDown: 'R stick ↓', PadRAxisLeft: 'R stick ←', PadRAxisRight: 'R stick →', WheelUp: 'Wheel up', WheelDown: 'Wheel down' };\n/** top-down / isometric action (Zelda, Diablo): Space dashes, J or click attacks */\nInput.DEFAULT = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  attack: ['KeyJ', 'KeyX', 'Mouse0', 'Pad0', 'Pad7'], dash: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyK', 'Pad1', 'Pad6'],\n  skill: ['KeyL', 'KeyE', 'Mouse2', 'Pad2', 'Pad5'], jump: ['KeyZ', 'Pad3'], ...MENU_KEYS\n};\n/** side-scrollers (Mario, Mega Man): Space / Z / K jump, X / J attack or shoot, Shift / C dash */\nInput.PLATFORMER = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  jump: ['Space', 'KeyZ', 'KeyK', 'Pad0'], attack: ['KeyX', 'KeyJ', 'Mouse0', 'Pad2'], dash: ['ShiftLeft', 'ShiftRight', 'KeyC', 'KeyL', 'Pad1', 'Pad5'],\n  skill: ['KeyE', 'KeyV', 'Mouse2', 'Pad3'], ...MENU_KEYS\n};\n/** third-person action and stealth (Assassin's Creed, Metal Gear): WASD / stick move, Shift sprint, Space jump and parkour,\n *  C crouch (a toggle), E interact, J attack, K block, L dodge, Q use, M map. Pad: A jump, B crouch, X attack, Y interact,\n *  LB block, RB dodge, LT use, RT or L3 sprint, Back map */\nInput.THIRDPERSON = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  sprint: ['ShiftLeft', 'ShiftRight', 'Pad7', 'Pad10'], jump: ['Space', 'Pad0'], crouch: ['KeyC', 'ControlLeft', 'Pad1'], interact: ['KeyE', 'KeyF', 'Pad3'],\n  attack: ['KeyJ', 'Mouse0', 'Pad2'], block: ['KeyK', 'Mouse2', 'Pad4'], dodge: ['KeyL', 'Pad5'], use: ['KeyQ', 'Pad6'], map: ['KeyM', 'Tab', 'Pad8'], ...MENU_KEYS\n};\n/** shoot-'em-ups (1942, Gradius): Space / Z / J fire (hold for autofire), X / K bomb */\nInput.SHMUP = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  fire: ['Space', 'KeyZ', 'KeyJ', 'Mouse0', 'Pad0', 'Pad7'], bomb: ['KeyX', 'KeyK', 'Mouse2', 'Pad1', 'Pad6'], ...MENU_KEYS\n};\nE.Input = Input;\n\n/* =============================================================================\n   *  pressed: the actions pressed then, directions aside }], one entry each time the direction changes or a button is\n   *  pressed: an input display draws it; sequence() and motion() read it (section 10h: a kit without it has none) */\n  get history() { return this._hist || []; }\n  /** any action pressed this step (title screens: \"press any button\") */\n  anyPressed() { return this._now.size > 0; }\n  /** movement intent in screen directions: x right, y down, length <= 1 */\n  move() {\n    let x = (this.down('right') ? 1 : 0) - (this.down('left') ? 1 : 0), y = (this.down('down') ? 1 : 0) - (this.down('up') ? 1 : 0);\n    if (this.stickOn) { x = this.stick[0]; y = this.stick[1]; }\n    if (Math.hypot(this.padMove[0], this.padMove[1]) > 0) { x = this.padMove[0]; y = this.padMove[1]; }\n    const l = Math.hypot(x, y); if (l > 1) { x /= l; y /= l; }\n    return [x, y];\n  }\n  /** mouse position in projected screen pixels, or null */\n  mouseScreen() { return this.mouse.active ? this.screen.clientToScreen(this.mouse.cx, this.mouse.cy) : null; }\n  /** where a click or tap on the canvas landed, in screen pixels [x, y] (the HUD's space: r.W, r.H), during the step\n   *  after it lifted (a press that drags away, like the touch stick's, is none); else null. Menus and dialogs answer to\n   *  it; a HUD button of your own can: if (hit(input.clicked())) ... */\n  clicked() { return this._clickAt; }\n  /** how far the touch stick's finger moved since the last step, in screen pixels [dx, dy] (the HUD's space), or null while\n   *  no finger holds it: to steer one to one (a shooter's ship follows the thumb) instead of by the stick's direction */\n  drag() { return this._drag || null; }\n  /** the camera zoom the player asked for since the last step, as a factor (1.1: 10% closer, .9: farther; 1: none): the\n   *  wheel, - and = and a pinch, where the scene lets them zoom. The game applies it (game.zoomBy) */\n  zoom() { return this._zoomNow; }\n  /** the mouse pointer in screen pixels [x, y] (the HUD's space), or null before it has moved over the canvas */\n  pointer() { return this._fedAt || (this.mouse.active ? this.screenPoint(this.mouse.cx, this.mouse.cy) : null); }\n  /** the pointer's gestures, read each step in screen pixels (the HUD's space), from a mouse or one finger:\n   *  box() -> { x0, y0, x1, y1, from, to, done } while a box is drawn (a mouse's left button dragged; on a touch screen a long\n   *  press, then a drag), done the step it is let go; else null */\n  box() { return this._boxAt; }\n  /** [x, y] the step a press held still has been held .45 s (a long press), else null */\n  longPress() { return this._longAt; }\n  /** [x, y] the step a second tap or click lands within .35 s and 8 pixels of the first (a double tap), else null */\n  doubleTap() { return this._tap2At; }\n  /** [dx, dy] how far a drag moved this step: one finger on open ground (not a box), or a mouse's middle or right button;\n   *  else null. A free camera pans by it (game.cam.free) */\n  pan() { return this._panAt; }\n  /** [x, y] where the last zoom was asked for: the mouse pointer for the wheel, between the fingers for a pinch; null when\n   *  the keys zoomed (about the screen's middle) */\n  zoomPoint() { return this._zoomPt; }\n  /** a pointer event in screen pixels, as the browser's would give: feed('down' | 'move' | 'up', x, y, { touch: false,\n   *  button: 0, id: 0 (which finger, for zones) }) (a test's or a bot's mouse and fingers: clicks, boxes, long presses,\n   *  double taps and pans follow; a finger in one of the zones holds its act), or\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_56","type":"agent_message","text":"The native rendering and input paths are coming together: Focus compresses the visible swarm, damage removes individual bees, and charged rays show a faint alignment row. I’m wiring the game into native menus, couch co-op, Hub, and direct peer play before testing the packaged HTML.\n"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/input/actions.js';s=open(p).read();s=s.replace(\\\"'PadUp'\\\",\\\"'Pad12'\\\").replace(\\\"'PadDown'\\\",\\\"'Pad13'\\\").replace(\\\"'PadLeft'\\\",\\\"'Pad14'\\\").replace(\\\"'PadRight'\\\",\\\"'Pad15'\\\");open(p,'w').write(s)\nPY\ncat > src/main.js <<'EOF'\nimport identity from '../identity.json';\nimport interview from '../interview.json';\nimport {STAGES,PALETTES,DEFAULT_TUNING} from '../content/stages.js';\nimport {newWorld,step,retry,enterStage,leave,clone,clamp,moveCircle,footprint,validateStages} from './sim/world.js';\nimport {pilot} from './sim/bot.js';\nimport {Garden} from './presentation/garden.js';\nimport {GardenAudio} from './presentation/audio.js';\nimport {ACTIONS,readAction,prompt} from './input/actions.js';\nimport {Authority,unpack,pack} from './net/protocol.js';\nimport {DirectPeer} from './net/peer.js';\nimport {installDev} from './dev/tools.js';\n\nexport async function boot(E=globalThis.My3D2dge){\n const hub=globalThis.AIHub,info=hub?await hub.connect({mode:'shared-world',seats:[1,2]}):null;\n const app={game:null,ui:null,garden:null,audio:null,world:null,display:null,mode:info?'hub':'solo',info,host:info?info.isHost:true,local:info?(info.server?-1:info.players.findIndex(p=>p.id===info.me)):0,net:null,peer:null,idle:0,attract:false,demoPart:0,demoClock:0,finished:false,ended:false,hubStart:false,rayCounters:[0,0],injected:new Map(),pending:[],devOpen:false,inputGate:0,serverTimer:null,names:info?.players?.map(p=>p.name)||[],lastPhase:null,lastStage:-1,bestSaved:false,peerStatus:'',peerInput:'',peerOutput:'',titleMenu:null,runMenu:null};\n app.isNetwork=()=>app.mode==='hub'||app.mode==='peer';\n app.readOnly=()=>app.mode==='hub'||(app.mode==='peer'&&\"'!app.host);\n app.clearInput=()=>{for(const I of app.game.players)I.clear();app.inputGate=.16;app.injected.clear();};\n const menu={quit:info?false:'\"'title',settings:[{key:'music',value:.1},{key:'glyphs',value:'playstation'},{key:'scale',value:'fill'},{key:'voice',label:'Garden chatter',group:'Sound',type:'slider',value:.7,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}}],controls:{ray:'Horizontal ray',focus:'Hold Focus',steer:'Hold cursor steering'},items:()=>app.mode==='hub'?[['Diagnostics',()=>app.openDev()],['About / Credits',()=>openAbout()]]:[['Retry this encounter',()=>{if(app.readOnly())return;retry(app.world);app.lastPhase=null;app.ui.hide();app.clearInput();}],['Developer tools',()=>app.openDev()],['About / Credits',()=>openAbout()]]};\n const game=app.game=new E.Game({canvas:'screen',headless:\"'!!info?.server,loop:!info?.server,res:[480,320],portrait:{res:[320,540]},expand:true,view:'\"'overhead',views:['overhead'],input:ACTIONS,id:'killer-bee-yond-midnight-v1',bg:'#0c1922',fullscreen:'button',autoPause:\"'!info,live:!!info,menu,camera:{zoom:false}});\n game.fadeTime=0;game.cam.smooth=0;game.lights.enabled=false;\n const ui=app.ui=new E.Shell(game,{tv:true,theme:{ink:'\"'#f5e9cb',paper:'#12232bf5',accent:'#eed195',muted:'#b9c7b8',line:'#68867c66',font:'system-ui, sans-serif',titleFont:'Georgia, serif'},screens:{pause:{kicker:identity.title,text:()=>app.isNetwork()?'The shared garden keeps moving while this menu is open.':\"'`${STAGES[app.world?.stage||0].name}'\"\\\\nGoal: finish every gardener. A kill recharges one ray.\"'`},help:{title:'\"'Twelve bees. One big night.',sections:[['Sting','Fly over a clockwork gardener and stay with it. Break away too long and its shell recovers.'],['Focus','Hold Focus to squeeze through gaps and finish a sting faster. Release it to escape.'],['Ray','Fire left and right across your row. Only rival swarms are zapped. Every gardener kill recharges one empty ray.'],['Survive','Rivals grow from scouts to guards to hunters. Each contact costs individual bees. Clear a bed to return to twelve.'],['Together','Gold is player 1; mint is player 2. A fallen teammate watches until the next bed. Team score comes first.']]}}});\n app.garden=info?.server?null:new Garden(E,game);app.audio=new GardenAudio(game,\"'!!info?.server);\n installDev(app);\n app.applyPending=()=>{const changes=app.pending.splice(0);for(const fn of changes)fn();};\n const preview=newWorld({seed:733});preview.players=[];preview.targets=[];preview.queue=[];\n const botMemory=[{},{}];\n function cleanShell(){ui.hide();app.closeDev();game.timeScale=1;game.live=app.isNetwork();game.resume();app.clearInput();}\n function title(){\n  if(app.mode==='\"'hub')return;\n  app.net?.stop();app.net=null;app.peer?.close(false);app.peer=null;app.mode='solo';app.host=true;app.local=0;app.finished=false;app.ended=false;app.attract=false;app.idle=0;app.lastPhase=null;game.live=false;game.o.autoPause=true;game.o.menu.quit='title';game.allowJoin(false);while(game.players.length>1)game.removePlayer(game.players.at(-1));game.input.pad='any';game.input.use(ACTIONS);cleanShell();app.audio.stop();app.audio.start();game.go('title');\n }\n function makeMenu(items,onPick,y='center'){\n  return new E.Menu(game,items,{scale:2,rows:5,x:'center',y,box:false,bg:'#152932',color:'#ced8c5',pick:'#f4d99b',onPick,onCancel:title});\n }\n function startRun(mode='solo',players=1,seed=4117){\n  app.mode=mode;app.host=true;app.local=0;app.attract=false;app.finished=false;app.ended=false;app.bestSaved=false;app.lastPhase=null;app.lastStage=-1;app.rayCounters=[0,0];app.world=newWorld({players,seed});app.display=null;app.garden?.reset(app.world);app.audio.reset(app.world);game.live=app.isNetwork();game.o.autoPause=\"'!app.isNetwork();cleanShell();game.go('\"'run');\n }\n function couch(){\n  let pads=[];try{pads=Array.from(navigator.getGamepads?.()||[]).filter(p=>p?.connected);}catch{}\n  while(game.players.length>1)game.removePlayer(game.players.at(-1));\n  game.input.use(ACTIONS);\n  if(pads.length>=2){game.input.pad=pads[0].index;game.addPlayer({pad:pads[1].index});}\n  else if(pads.length===1){game.input.pad=null;game.addPlayer({pad:pads[0].index});}\n  else{game.input.pad=null;game.addPlayer({keys:'right'});}\n  game.allowJoin(false);startRun('couch',2);\n }\n function coOp(){\n  app.idle=0;app.attract=false;app.titleMenu=makeMenu(['Couch co-op','Direct peer co-op','Back'],i=>{if(i===0)couch();else if(i===1)peerMenu();else title();});\n  game.allowJoin({max:2,onJoin:()=>{if(game.sceneName==='coop'){game.allowJoin(false);startRun('couch',2);}}});cleanShell();game.go('coop');\n }\n function openAbout(){\n  app.idle=0;const chunks=Object.entries(interview.sourceInformation),pages=[chunks.slice(0,5),chunks.slice(5,10),chunks.slice(10)];\n  ui.show('about',{kicker:'An original garden emergency',title:identity.title,text:'Inspired by Killer Bees\"'! (1983), by Bob Harris.'\"\\\\nBuilt on my-3D2dge v0.89.1 (MIT). Original game code, artwork, music and chatter generated for this build.',actions:[...pages.map((entries,i)=>[\"'`Source Information ${i+1}/3`,()=>ui.show('\"'source',{title:\"'`Source Information ${i+1}/3`,sections:entries.map(([k,v])=>[k,v]),actions:[['\"'Back',()=>ui.back()]]})]),...['testingFeedback','engineFeedback','promptFeedback'].map((key,i)=>[['Testing Feedback','Engine Feedback','Prompt Feedback'][i],()=>ui.show('feedback',{title:['Testing Feedback','Engine Feedback','Prompt Feedback'][i],sections:interview[key].map((answer,j)=>[feedbackQuestions[key][j],answer]),actions:[['Back',()=>ui.back()]]})]),['Back',()=>ui.back()]]});\n }\n const feedbackQuestions={testingFeedback:['Issues found','Critical / game breaking','Most helpful test','Least helpful test'],engineFeedback:['Liked most','Got stuck or guessed wrong','Built ourselves','Hardest engine task','Engine changes','One requested change'],promptFeedback:['Liked most','Confusing','Hardest task','Suggested change']};\n function peerMenu(){\n  if(app.mode==='hub')return;game.allowJoin(false);app.peer?.close(false);app.peer=new DirectPeer({onOpen:role=>openPeerWorld(role),onMessage:m=>{if(m.t==='end'){if(app.world){app.world.phase=m.won?'ending':'failed';app.world.score=m.score;app.lastPhase=null;}return;}app.net?.receive(m,app.host?1:0,game.real,app.world);},onClose:()=>{if(app.mode==='peer'&&\"'!app.finished){app.net?.stop();app.net=null;app.audio.stop();app.peerStatus='\"'Connection lost. The round stopped safely.';ui.show('disconnected',{title:'The garden lost a swarm',text:app.peerStatus,actions:[['Reconnect',()=>{title();peerMenu();}],['Title',title]]});}},onStatus:text=>{app.peerStatus=text;const el=ui.root?.querySelector('.peer-status');if(el)el.textContent=text;}});\n  app.peerInput='';app.peerOutput='';app.peerStatus='Choose host or guest.';showPeer('choose');\n }\n function showPeer(screen){\n  const fail=e=>{app.peerStatus=e.message||String(e);showPeer(screen);};\n  const copy=async()=>{try{await navigator.clipboard.writeText(app.peerOutput);app.peerStatus='Copied. Return the complete code to your partner.';}catch{const ta=ui.root?.querySelector('[data-peer=output]');ta?.focus();ta?.select();app.peerStatus='Copy is restricted here. The code is selected; use your browser’s Copy command.';}const el=ui.root?.querySelector('.peer-status');if(el)el.textContent=app.peerStatus;};\n  const paste=async()=>{try{app.peerInput=await navigator.clipboard.readText();const ta=ui.root?.querySelector('[data-peer=input]');if(ta)ta.value=app.peerInput;}catch{const ta=ui.root?.querySelector('[data-peer=input]');ta?.focus();app.peerStatus='Paste is restricted here. Paste directly into the code box.';const el=ui.root?.querySelector('.peer-status');if(el)el.textContent=app.peerStatus;}};\n  const cancel=()=>{app.peer?.close(false);app.peer=null;ui.hide();coOp();};\n  const host=async()=>{app.peerStatus='Gathering local connection details…';showPeer('host');try{app.peerOutput=await app.peer.offer();showPeer('host');}catch(e){fail(e);}};\n  const answer=async()=>{try{app.peerOutput=await app.peer.answer(app.peerInput);showPeer('guest-answer');}catch(e){fail(e);}};\n  const acts=screen==='c