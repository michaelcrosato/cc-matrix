{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '2720,2746p' vendor/engine/my-3d2dge.js && sed -n '430,510p' vendor/hub/harness.html && rg -n '_autoPause|o.live' vendor/engine/my-3d2dge.js | head -20\"","aggregated_output":"   *   function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at\n   *   (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\n   * - boot: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the\n   *   steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\n   */\n  start(hooks) {\n    if (hooks && hooks.boot !== undefined && !this._booting) return this._boot(hooks);\n    if (hooks !== undefined || !this._hooks) {\n      if (!hooks || typeof hooks !== 'object') throw new Error('game.start needs { update(dt), draw(r) } or { scenes: { name: { update, draw } }, scene: \"name\" }');\n      this._hooks = hooks;\n      if (hooks.scenes) {\n        this.scenes = hooks.scenes;\n        const first = hooks.scene || Object.keys(hooks.scenes)[0];\n        this._enter(first, hooks.data);\n      } else {\n        if (typeof hooks.update !== 'function' || typeof hooks.draw !== 'function') throw new Error('game.start({ update(dt), draw(r) }) needs both functions (or use { scenes, scene })');\n        this.scene = hooks; this.sceneName = 'main';\n      }\n    }\n    if (this._running || this.disposed || this.o.loop === false) return this;\n    this._running = true;\n    let last = performance.now(), acc = 0, n = 0, since = 0, per = 1 / 60, cost = 0, ri = 0, miss = 0, hold = 0, back = 3, full = 0, fresh = true, long = 0;\n    const ring = [];\n    const frame = now => {\n      if (!this._running) return;\n      this._raf = requestAnimationFrame(frame);   // scheduled first, so an error never stops the loop\n      const raw = Math.max(0, (now - last) / 1000); last = now; since += raw;\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n2396:     *  errors caught in update and draw, each { where, scene, message, stack }, once per kind; live: true (o.live): a pause\n2399:    this.paused = false; this.pauseOverlay = true; this._timers = []; this.errors = []; this._errKeys = new Set(); this.live = !!o.live; this._goOn = false;\n2538:  _autoPause(reason) { this.input.stopRumble(); return this.o.autoPause !== false && !!this.scene && !!this.scene.pausable && this.pause(reason); }\n2559:    on(window, 'blur', () => this._autoPause('focus'));\n2560:    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its soun [... omitted end of long line]\n2561:    on(window, 'pagehide', () => this._autoPause('focus'));\n2938:    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTR [... omitted end of long line]\n3826:    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n10672:    this.players = Array.from({ length: Math.max(1, Math.min(2, players)) }, (_, i) => ({ n: i + 1, score: 0, lives: this.o.lives, save: null, next: this.o.every || (this.o.extra[0] === undefined ? In [... omitted end of long line]\n10770:        this._cont = null; for (const p of this.players) p.lives = this.o.lives;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation/audio.js <<'EOF'\n// Original code-only score, effects and little nonverbal vowel-like chirps.\nexport const SONG={bpm:116,steps:4,tracks:[\n {name:'dew',wave:'triangle',vol:.22,notes:'D5 . A5 . F5 . E5 . | D5 . . A4 . . C5 . | E5 . G5 . A5 . G5 . | F5 . E5 . D5 - . . | D5 . F5 . A5 . C6 . | Bb5 . A5 . G5 . E5 . | F5 . D5 . C5 . A4 . | D5 - . . . . . .'},\n {name:'roots',wave:'sine',vol:.3,notes:'D3 . . . . . A3 . | D3 . . . . . . . | C3 . . . . . G3 . | Bb2 . . . A2 . . . | D3 . . . . . A3 . | G2 . . . . . D3 . | Bb2 . . . C3 . . . | D3 . . . A2 . . .'},\n {name:'chase',wave:'pulse12',vol:.09,on:false,notes:'D4 . A4 . D4 . A4 . | D4 . F4 . A4 . F4 . | C4 . G4 . C4 . G4 . | Bb3 . F4 . A3 . E4 .'},\n {name:'wings',wave:'drums',vol:.13,notes:'k . . h . . h . | . . s . . . h . | k . . h . . h . | . . s . h . . .'},\n]};\nconst VOICES={\n ray:{wave:'saw',freq:920,to:120,dur:.18,vol:.2},dry:{wave:'triangle',freq:100,to:80,dur:.045,vol:.09},\n collapse:{wave:'pulse12',freq:520,to:90,dur:.2,vol:.17,arp:[0,7,-7],step:.04},charge:{wave:'triangle',freq:660,to:1320,dur:.16,vol:.18,arp:[0,4,7],step:.04},\n loss:{wave:'sine',freq:740,to:180,dur:.2,vol:.25},warning:{wave:'sine',freq:370,to:440,dur:.11,vol:.11},mature:{wave:'pulse12',freq:240,to:580,dur:.18,vol:.12,arp:[0,3,6],step:.05},\n zap:{wave:'noise',freq:1600,to:500,dur:.08,vol:.16},recover:{wave:'sine',freq:320,to:440,dur:.09,vol:.08},\n expose:{wave:'triangle',freq:587,to:1174,dur:.3,vol:.19},pulse:{wave:'sine',freq:90,to:280,dur:.26,vol:.2},\n clear:{wave:'triangle',freq:587,dur:.22,vol:.22,arp:[0,4,7,12],step:.07},defeat:{wave:'triangle',freq:294,to:110,dur:.4,vol:.18},victory:{wave:'triangle',freq:587,dur:.3,vol:.2,arp:[0,4,7,12,16],step:.1},\n};\nexport function syllable(ctx,bus,time,freq=520,dur=.12,vol=.15){\n const source=ctx.createOscillator(),amp=ctx.createGain(),filter=ctx.createBiquadFilter();source.type='sawtooth';source.frequency.setValueAtTime(freq,time);source.frequency.exponentialRampToValueAtTime(freq*1.25,time+dur*.25);source.frequency.exponentialRampToValueAtTime(freq*.9,time+dur);filter.type='bandpass';filter.frequency.setValueAtTime(freq*2.7,time);filter.Q.value=3;\n amp.gain.setValueAtTime(0,time);amp.gain.linearRampToValueAtTime(vol,time+.008);amp.gain.exponentialRampToValueAtTime(.0001,time+dur);source.connect(filter);filter.connect(amp);amp.connect(bus);source.start(time);source.stop(time+dur+.01);return{source,amp};\n}\nexport class GardenAudio{\n constructor(game,server=false){this.game=game;this.disabled=server;this.lastEvent=0;this.lastWing=-10;this.lastSting=-10;this.lastChat=-10;this.song=false;this.stopped=false;}\n start(){if(this.disabled||this.song)return;this.game.audio.music(SONG,{sync:true});this.song=true;this.stopped=false;}\n reset(s){this.lastEvent=s?.eid||0;this.lastWing=-10;this.lastSting=-10;this.start();}\n update(s,demo=false){\n  if(this.disabled||this.stopped)return;const A=this.game.audio;\n  for(const e of s.events)if(e.id>this.lastEvent){this.lastEvent=e.id;if(VOICES[e.type])A.sfx(VOICES[e.type]);if(['encounter','clear','victory','expose'].includes(e.type)&&\"'!demo)this.chatter(e.id);}\n  if(this.game.paused&&!this.game.live)return;\n  const near=s.rivals.some(a=>a.state===2),contact=s.players.some(p=>p.contact&&p.bees);\n  A.layer('\"'chase',near?.09:0,.35);\n  if(s.phase==='play'&&s.time-this.lastWing>(near?.19:.36)){this.lastWing=s.time;A.sfx({wave:'triangle',freq:near?205:170,to:near?230:180,dur:.065,vol:near?.025:.016});}\n  if(contact&&s.time-this.lastSting>.16){this.lastSting=s.time;A.sfx({wave:'pulse12',freq:310+(s.tick%5)*50,to:190,dur:.045,vol:.04});}\n }\n chatter(seed){const A=this.game.audio;if(\"'!A.ready)return;const bus=A.bus('\"'voice'),c=A.ctx;if(\"'!bus||!c)return;for(let i=0;i<4;i++)syllable(c,bus,c.currentTime+i*.09,440+((seed*13+i*17)%8)*63,.065+(i%2)*.035,.07);}\n stop(){this.stopped=true;this.song=false;if(this.disabled)return;this.game.audio.music(null);}\n}\nEOF\ncat > src/net/protocol.js <<'\"'EOF'\nimport {DEFAULT_TUNING} from '../../content/stages.js';\nimport {clone,newWorld,clamp} from '../sim/world.js';\nexport const TYPES=['left','right','bell'],PHASES=['play','result','failed','ending'],BOSS=['move','open','pulse'];\nexport const EVENTS=['arrival','warning','ray','dry','zap','mature','recover','charge','collapse','loss','fallen','encounter','clear','expose','pulse-warning','pulse','victory','defeat','shell-push','unstuck','leave'];\nconst n=v=>Math.round((v||0)*10)/10;\nconst statsKeys=['kills','rays','zaps','losses','clears','refills','maturations','bossExposures','bossPulses','focusTicks','contactTicks','recoveries'];\nexport function pack(s){return{t:'s',v:1,k:s.tick,z:s.seed,i:s.stage,q:PHASES.indexOf(s.phase),tm:n(s.time),ts:n(s.stageTime),pt:n(s.phaseT),sc:s.score,ss:s.streak,a:s.assisted?1:0,\n p:s.players.map(p=>[p.id,n(p.x),n(p.y),p.bees,p.charge,p.focus?1:0,n(p.facing),n(p.inv),n(p.lostAt),p.lastRay,p.joined?1:0,n(p.vx),n(p.vy)]),\n b:s.targets.map(a=>[a.id,TYPES.indexOf(a.type),n(a.x),n(a.y),n(a.hp),n(a.maxHp),n(a.dir),n(a.warning),BOSS.indexOf(a.bossPhase),n(a.bossT),a.circuit,a.recovering?1:0]),\n r:s.rivals.map(a=>[a.id,n(a.x),n(a.y),n(a.dir),n(a.age),a.state,n(a.warning),n(a.matureAt)]),\n h:s.husks.map(a=>[a.id,n(a.x),n(a.y),n(a.r),TYPES.indexOf(a.type),n(a.born)]),\n e:s.events.slice(-8).map(e=>[e.id,EVENTS.indexOf(e.type),n(e.t),e.x===undefined?null:n(e.x),e.y===undefined?null:n(e.y),e.player??null,e.points||0,e.kind===undefined?null:TYPES.indexOf(e.kind)]),\n eid:s.eid,c:s.queue.length,result:s.result,tu:Object.keys(DEFAULT_TUNING).map(k=>s.tuning[k]),st:statsKeys.map(k=>s.stats[k]||0)};}\nexport function validSnapshot(m){return m?.t==='s'&&m.v===1&&Number.isSafeInteger(m.k)&&m.k>=0&&Number.isInteger(m.i)&&m.i>=0&&m.i<6&&Number.isInteger(m.q)&&m.q>=0&&m.q<4&&Number.isFinite(m.sc)&&m.sc>=0&&Array.isArray(m.p)&&m.p.length>=1&&m.p.length<=2&&Array.isArray(m.b)&&m.b.length<=5&&Array.isArray(m.r)&&m.r.length<=7&&Array.isArray(m.h)&&m.h.length<=24&&Array.isArray(m.e)&&m.e.length<=8&&[...m.p,...m.b,...m.r,...m.h].every(a=>Array.isArray(a)&&a.every(v=>typeof v==='number'&&Number.isFinite(v)));}\nexport function unpack(m,previous=null){\n if(\"'!validSnapshot(m))return null;\n const s=previous||newWorld({players:m.p.length,seed:m.z});Object.assign(s,{tick:m.k,seed:m.z,stage:m.i,phase:PHASES[m.q],time:m.tm,stageTime:m.ts,phaseT:m.pt,score:m.sc,streak:m.ss,assisted:!!m.a,eid:m.eid,result:m.result,queue:Array.from({length:Math.max(0,Math.min(20,m.c||0))},()=>({}))});\n s.players=m.p.map(a=>({id:a[0],x:a[1],y:a[2],bees:a[3],charge:a[4],focus:!!a[5],facing:a[6],inv:a[7],lostAt:a[8],lastRay:a[9],joined:!!a[10],vx:a[11],vy:a[12],contact:false}));\n s.targets=m.b.map(a=>({id:a[0],type:TYPES[a[1]],x:a[2],y:a[3],hp:a[4],maxHp:a[5],dir:a[6],warning:a[7],bossPhase:BOSS[a[8]],bossT:a[9],circuit:a[10],recovering:!!a[11],r:a[1]===2?17:7}));\n s.rivals=m.r.map(a=>({id:a[0],x:a[1],y:a[2],dir:a[3],age:a[4],state:a[5],warning:a[6],matureAt:a[7],r:8}));\n s.husks=m.h.map(a=>({id:a[0],x:a[1],y:a[2],r:a[3],type:TYPES[a[4]],born:a[5]}));\n s.events=m.e.map(a=>({id:a[0],type:EVENTS[a[1]],t:a[2],...(a[3]===null?{}:{x:a[3]}),...(a[4]===null?{}:{y:a[4]}),player:a[5],points:a[6],kind:TYPES[a[7]]}));\n Object.keys(DEFAULT_TUNING).forEach((k,i)=>{s.tuning[k]=m.tu?.[i]??DEFAULT_TUNING[k];});statsKeys.forEach((k,i)=>{s.stats[k]=m.st?.[i]||0;});\n return s;\n}\nexport function validateInput(packet,record,stage){\n if(!packet||packet.t!=='\"'i'||packet.v\"'!==1||packet.stage!==stage||!Number.isSafeInteger(packet.seq)||packet.seq<0||packet.seq<=record.seq||!Number.isFinite(packet.x)||!Number.isFinite(packet.y)||Math.abs(packet.x)>1||Math.abs(packet.y)>1||typeof packet.focus!=='\"'boolean'||\"'!Number.isSafeInteger(packet.ray)||packet.ray<record.ray||packet.ray>record.ray+16)return null;\n return {x:clamp(packet.x,-1,1),y:clamp(packet.y,-1,1),focus:packet.focus,ray:packet.ray};\n}\nexport class Authority{\n constructor({host,local=0,send,onSnapshot,onEnd}){Object.assign(this,{host,local,send,onSnapshot,onEnd});this.records=new Map();this.seq=0;this.nextSend=0;this.lastTick=-1;this.ended=false;this.metrics={sent:0,received:0,rejected:0,maxBytes:0,maxRate:0,unreliableMax:0,reliableSnapshots:0};this.times=[];}\n transmit(data,now,reliable=false){if(this.ended)return;const bytes=new TextEncoder().encode(JSON.stringify(data)).length;if(bytes>16384)throw Error('\"'Network packet exceeds 16 KiB');this.times=this.times.filter(t=>t>now-1);if(this.times.length>=18)return;this.times.push(now);this.metrics.sent++;this.metrics.maxBytes=Math.max(this.metrics.maxBytes,bytes);this.metrics.maxRate=Math.max(this.metrics.maxRate,this.times.length);if(\"'!reliable)this.metrics.unreliableMax=Math.max(this.metrics.unreliableMax,bytes);this.send(data,{reliable});}\n receive(m,from,now,world){\n  if(this.ended||!m||typeof m!=='\"'object')return;this.metrics.received++;\n  if(this.host){\n   if(\"'!world||!Number.isInteger(from)||!world.players[from]?.joined||from===this.local){this.metrics.rejected++;return;}\n   const rec=this.records.get(from)||{seq:-1,ray:world.players[from].lastRay,time:-100,input:{}};\n   const command=validateInput(m,rec,world.stage);if(!command){this.metrics.rejected++;return;}\n   rec.seq=m.seq;rec.ray=m.ray;rec.time=now;rec.input=command;this.records.set(from,rec);\n  }else if(m.t==='\"'s'){\n   if(\"'!validSnapshot(m)||m.k<=this.lastTick){this.metrics.rejected++;return;}this.lastTick=m.k;this.onSnapshot(m);\n  }else if(m.t==='\"'end'){this.onEnd?.(m);}\n }\n commands(world,local,now){return world.players.map(p=>{if(p.id===this.local)return local;const a=this.records.get(p.id);return a&&now-a.time<.45?a.input:{x:0,y:0,focus:false,ray:a?.ray??p.lastRay};});}\n update(world,command,now){\n  if(this.ended||now<this.nextSend)return;this.nextSend=now+1/(this.host?12:15);\n  if(this.host){const packet=pack(world),bytes=JSON.stringify(packet).length,reliable=bytes>1180;if(reliable)this.metrics.reliableSnapshots++;this.transmit(packet,now,reliable);}\n  else this.transmit({t:'i',v:1,seq:++this.seq,stage:world.stage,x:Math.round(command.x*1000)/1000,y:Math.round(command.y*1000)/1000,focus:\"'!!command.focus,ray:command.ray},now,false);\n }\n neutralize(id){this.records.delete(id);}\n stop(){this.ended=true;this.records.clear();}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
