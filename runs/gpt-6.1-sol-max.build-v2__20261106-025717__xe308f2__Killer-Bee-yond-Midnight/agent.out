{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'EOF'\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom urllib.parse import urlencode\nimport functools\nimport threading\nimport json\nimport re\nimport sys\nimport traceback\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent.parent\nID = json.loads((ROOT / 'identity.json').read_text())\nARTIFACT = ROOT.parent / ID['artifact']\nGROUP = sys.argv[sys.argv.index('--group') + 1] if '--group' in sys.argv else 'all'\nREPORT = {'passed': 0, 'failed': 0, 'failures': []}\n\ndef check(name, ok, detail=''):\n    if ok:\n        REPORT['passed'] += 1\n    else:\n        REPORT['failed'] += 1\n        REPORT['failures'].append({'name': name, 'detail': str(detail)[:3000]})\n\ndef section(name, fn):\n    try:\n        fn()\n    except Exception:\n        check(name, False, traceback.format_exc())\n\ndef tick(page, seconds=.1, draw=True):\n    page.evaluate('([s,d])=>__midnight.game.advance(s,{draw:d})', [seconds, draw])\n\ndef load(page, url=None, stopped=True):\n    page.goto(url or ARTIFACT.as_uri())\n    page.wait_for_function('window.__midnight \"'!== undefined'\"', timeout=20000)\n    if stopped:\n        page.evaluate('__midnight.game.stop()')\n        tick(page, .2)\n\ndef start(page, players=1):\n    page.evaluate('(n)=>__midnight.start(n)', players)\n    tick(page, .3)\n\ndef press(page, key, seconds=.05):\n    page.keyboard.press(key)\n    tick(page, seconds)\n\ndef point(page, index):\n    return page.evaluate('''i=>{const m=__midnight.app.titleMenu,b=m.rowAt(i),s=__midnight.game.screen,r=s.canvas.getBoundingClientRect();return [r.left+(s.OX+(b[0]+b[2]/2)*s.S)/s.dpr,r.top+(s.OY+(b[1]+b[3]/2)*s.S)/s.dpr];}''', index)\n\nPAD_INIT = '''window.__pads=[];Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});window.__pad=(index=0)=>({id:'DualSense Wireless Controller',index,connected:true,mapping:'standard',timestamp:performance.now(),axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))});'''\n\ndef package_checks():\n    html = ARTIFACT.read_text()\n    first = re.search(r'<script>([\\\\s\\\\S]*?)</script>', html).group(1)\n    check('artifact has the exact prescribed root filename', ARTIFACT.exists() and ARTIFACT.stem == ROOT.name)\n    check('first script is byte-identical pristine Hub client', first.encode() == (ROOT / 'vendor/hub/session.js').read_bytes())\n    check('single HTML contains all runtime code', '<script src=' not in html and 'type=\\\"module\\\"' not in html and '<link ' not in html)\n    check('artifact has no workstation paths or sample slices', '/home/micha/' not in html and 'const SLICES =' not in html)\n    check('served and file artifacts are identical', ARTIFACT.read_bytes() == (ROOT / 'build/index.html').read_bytes())\n    interview = json.loads((ROOT.parent / 'exit-interview.json').read_text()) if (ROOT.parent / 'exit-interview.json').exists() else json.loads((ROOT / 'interview.json').read_text())\n    check('delivery interview parses with exact top-level schema', set(interview) == {'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'})\n    check('catalogue identity matches title and source', interview['aiHub']['name'] == ID['title'] and interview['sourceInformation']['plan'] == 'PLAN.md')\n    check('delivery feedback has every required answer', [len(interview[k]) for k in ['testingFeedback','engineFeedback','promptFeedback']] == [4,6,4] and all(isinstance(a,str) and a for k in ['testingFeedback','engineFeedback','promptFeedback'] for a in interview[k]))\n\n\ndef browser_checks(p):\n    for engine in ['chromium', 'webkit', 'firefox']:\n        browser = getattr(p, engine).launch(headless=True)\n        context = browser.new_context(viewport={'width':1920,'height':1080})\n        page = context.new_page()\n        errors = []\n        requests = []\n        page.on('pageerror', lambda e: errors.append(str(e)))\n        page.on('request', lambda r: requests.append(r.url))\n        load(page)\n        check(f'{engine}: file title boots', page.evaluate('__midnight.game.sceneName === \\\"title\\\"'))\n        check(f'{engine}: music default is persisted setting 10%', page.evaluate('__midnight.game.settings.music === .1 && __midnight.game.audio.musicVolume === .1'))\n        check(f'{engine}: PlayStation symbols are the default', page.evaluate('__midnight.game.settings.glyphs === \\\"playstation\\\"'))\n        # Pointer hover and click use native menu hit regions.\n        xy = point(page, 1)\n        page.mouse.move(*xy)\n        tick(page)\n        check(f'{engine}: hover changes native menu focus', page.evaluate('__midnight.app.titleMenu.i === 1'))\n        page.mouse.click(*point(page, 0))\n        tick(page, .3)\n        check(f'{engine}: pointer starts campaign', page.evaluate('__midnight.game.sceneName === \\\"run\\\" && __midnight.app.world.players[0].bees === 12'))\n        x = page.evaluate('__midnight.app.world.players[0].x')\n        page.keyboard.down('d')\n        tick(page, .4)\n        page.keyboard.up('d')\n        tick(page)\n        check(f'{engine}: keyboard steers responsive swarm', page.evaluate('__midnight.app.world.players[0].x') > x + 25)\n        press(page, 'Space')\n        check(f'{engine}: one press spends exactly one ray', page.evaluate('__midnight.app.world.stats.rays === 1 && __midnight.app.world.players[0].charge === 0'))\n        page.keyboard.down('Shift')\n        tick(page)\n        check(f'{engine}: held Focus uses authoritative formation', page.evaluate('__midnight.app.world.players[0].focus'))\n        page.keyboard.up('Shift')\n        tick(page)\n        press(page, 'Escape')\n        before = page.evaluate('__midnight.app.world.tick')\n        tick(page, 1)\n        check(f'{engine}: native pause freezes solo and opens menu', page.evaluate('__midnight.game.paused && __midnight.app.ui.screen === \\\"pause\\\"') and before == page.evaluate('__midnight.app.world.tick'))\n        page.get_by_role('button', name='Controls', exact=True).click()\n        check(f'{engine}: native controls expose ray and Focus rebinding', page.get_by_role('dialog').get_by_text('Horizontal ray', exact=True).count() > 0 and page.get_by_role('dialog').get_by_text('Hold Focus', exact=True).count() > 0)\n        page.evaluate('__midnight.app.ui.hide();__midnight.game.resume();__midnight.game.input.rebind(\\\"ray\\\",\\\"keys\\\",\\\"KeyR\\\")')\n        tick(page)\n        check(f'{engine}: native rebinding updates key labels', page.evaluate('__midnight.game.input.label(\\\"ray\\\") === \\\"R\\\"'))\n        page.evaluate('__midnight.game.settings.set(\\\"music\\\",.17);__midnight.game.settings.set(\\\"glyphs\\\",\\\"xbox\\\")')\n        page.reload()\n        page.wait_for_function('window.__midnight')\n        page.evaluate('__midnight.game.stop()')\n        tick(page)\n        check(f'{engine}: sound and glyph settings survive reload', page.evaluate('__midnight.game.settings.music === .17 && __midnight.game.settings.glyphs === \\\"xbox\\\"'))\n        check(f'{engine}: no external audio or asset requests', all(u.startswith('file:') for u in requests))\n        check(f'{engine}: no page or native collected errors', not errors and page.evaluate('__midnight.game.errors.length === 0'), errors)\n        context.close()\n        browser.close()\n\n\ndef access_checks(p):\n    browser = p.chromium.launch(headless=True)\n    context = browser.new_context(viewport={'width':1920,'height':1080})\n    context.add_init_script(PAD_INIT)\n    page = context.new_page()\n    load(page)\n    page.evaluate('window.__pads=[__pad(0),__pad(1)];__pads[0].axes=[.1,.1,0,0]')\n    tick(page)\n    check('standard pad dead zone ignores drift', page.evaluate('Math.hypot(...__midnight.game.input.move()) === 0'))\n    page.evaluate('__pads[0].buttons[0]={pressed:true,value:1,touched:true}')\n    tick(page, .3)\n    check('Cross starts a campaign through native input', page.evaluate('__midnight.game.sceneName === \\\"run\\\"'))\n    tick(page, .3)\n    check('held menu confirm does not fire opening ray', page.evaluate('__midnight.app.world.stats.rays === 0'))\n    page.evaluate('__pads[0].buttons[0]={pressed:false,value:0};__pads[0].axes=[.7,0,0,0]')\n    before = page.evaluate('__midnight.app.world.players[0].x')\n    tick(page, .4)\n    check('analogue pad movement reaches simulation', page.evaluate('__midnight.app.world.players[0].x') > before + 15)\n    page.evaluate('__pads[0].axes=[0,0,0,0];__pads[0].buttons[7]={pressed:true,value:1};')\n    tick(page)\n    check('R2 compresses the swarm with PlayStation prompt', page.evaluate('__midnight.app.world.players[0].focus && __midnight.game.input.label(\\\"focus\\\") === \\\"R2\\\"'))\n    page.evaluate('__midnight.game.settings.set(\\\"glyphs\\\",\\\"xbox\\\")')\n    check('Xbox glyph option uses A and RT', page.evaluate('__midnight.game.input.label(\\\"ray\\\") === \\\"A\\\" && __midnight.game.input.label(\\\"focus\\\") === \\\"RT\\\"'))\n    page.evaluate('__pads[0].buttons[7]={pressed:false,value:0};__midnight.title()')\n    tick(page, .3)\n    page.evaluate('__midnight.coOp()')\n    tick(page, .3)\n    page.evaluate('__midnight.app.titleMenu.i=0;__midnight.game.input.tap(\\\"confirm\\\")')\n    tick(page, .3)\n    check('couch setup claims two standard pads', page.evaluate('__midnight.app.mode === \\\"couch\\\" && __midnight.game.players.length === 2 && __midnight.game.players[1].pad === 1'))\n    before = page.evaluate('__midnight.app.world.players.map(p=>[p.x,p.y])')\n    page.evaluate('__pads[0].axes=[-.8,0,0,0];__pads[1].axes=[0,.8,0,0]')\n    tick(page, .5)\n    after = page.evaluate('__midnight.app.world.players.map(p=>[p.x,p.y])')\n    check('two pads independently steer shared couch world', after[0][0] < before[0][0]-15 and after[1][1] > before[1][1]+15)\n    page.evaluate('__pads[0].axes=[0,0,0,0];__pads[1].axes=[0,0,0,0];__pads[1].connected=false')\n    tick(page)\n    check('couch controller disconnect pauses safely', page.evaluate('__midnight.game.paused'))\n    page.evaluate('__pads[1].connected=true;__midnight.app.ui.hide();__midnight.game.resume()')\n    tick(page)\n    check('couch reconnect returns coherent controls', page.evaluate('__midnight.game.players.length === 2 && __midnight.app.world.players.length === 2'))\n    # Reset to standalone title to check the idle threshold exactly.\n    page.evaluate('__pads=[];__midnight.title()')\n    tick(page, .3)\n    page.evaluate('__midnight.app.idle=0')\n    tick(page, 9.9, False)\n    check('attract does not start before ten seconds', page.evaluate('__midnight.game.sceneName === \\\"title\\\"'))\n    tick(page, .2)\n    check('attract starts after ten idle seconds', page.evaluate('__midnight.game.sceneName === \\\"attract\\\" && __midnight.app.attract'))\n    saved = page.evaluate('My3D2dge.store.get(\\\"best:clean\\\",0)')\n    tick(page, 90, False)\n    coverage = page.evaluate('({stats:__midnight.app.world.stats,stage:__midnight.app.world.stage,part:__midnight.app.demoPart})')\n    check('attract exercises real sting, Focus, shells and rays', coverage['stats']['kills'] > 0 and coverage['stats']['focusTicks'] > 0 and coverage['stats']['zaps'] > 0, coverage)\n    check('attract covers maturation and finale exposure', coverage['stats']['maturations'] > 0 and coverage['stats']['bossExposures'] > 0, coverage)\n    check('attract isolates local best scores', saved == page.evaluate('My3D2dge.store.get(\\\"best:clean\\\",0)'))\n    page.mouse.move(500,400)\n    tick(page)\n    check('mouse movement cancels attract and consumes input', page.evaluate('__midnight.game.sceneName === \\\"title\\\" && \"'!__midnight.app.attract && __midnight.app.world === null'\"'))\n    for family in ['keyboard','pad','touch']:\n        page.evaluate('__midnight.app.idle=10')\n        tick(page, .1)\n        if family == 'keyboard':\n            page.keyboard.press('Space')\n        elif family == 'pad':\n            page.evaluate('__pads=[__pad(0)];__pads[0].axes=[.8,0,0,0]')\n        else:\n            page.dispatch_event('#screen','pointerdown',{'pointerId':44,'pointerType':'touch','clientX':100,'clientY':100,'button':0,'bubbles':True})\n            page.dispatch_event('#screen','pointerup',{'pointerId':44,'pointerType':'touch','clientX':100,'clientY':100,'button':0,'bubbles':True})\n        tick(page, .1)\n        check(f'{family} cancels attract without entering play', page.evaluate('__midnight.game.sceneName === \\\"title\\\" && \"'!__midnight.app.attract'\"'))\n        page.evaluate('__pads=[]')\n        tick(page,.25)\n    # Native dev controls and About use the engine's existing Shell.\n    start(page)\n    press(page,'Escape')\n    page.get_by_role('button',name='Developer tools',exact=True).click()\n    check('developer tools are reachable from pause', page.evaluate('__midnight.app.ui.screen === \\\"dev\\\"'))\n    page.get_by_role('button',name='Flight & sting',exact=True).click()\n    page.evaluate('__midnight.game.settings.set(\\\"dev_speed\\\",100)')\n    tick(page)\n    check('live slider changes authoritative tuning and marks assisted', page.evaluate('__midnight.app.world.tuning.speed === 100 && __midnight.app.world.assisted'))\n    page.get_by_role('button',name='Reset tuning to defaults',exact=True).click()\n    tick(page)\n    check('reset sliders restores defaults without erasing assistance', page.evaluate('__midnight.app.world.tuning.speed === 86 && __midnight.app.world.assisted'))\n    page.evaluate('__midnight.game.settings.set(\\\"devTime\\\",.25);__midnight.app.ui.hide()')\n    tick(page)\n    check('closing developer tools restores speed and clears held actions', page.evaluate('__midnight.game.timeScale === 1 && \"'!__midnight.app.devOpen'\"'))\n    page.evaluate('__midnight.title()')\n    tick(page,.3)\n    page.evaluate('__midnight.app.titleMenu.i=3;__midnight.game.input.tap(\\\"confirm\\\")')\n    tick(page)\n    check('About exposes all four required information groups', all(page.get_by_role('button',name=label,exact=True).count() for label in ['Source Information 1/3','Source Information 2/3','Source Information 3/3','Testing Feedback','Engine Feedback','Prompt Feedback']))\n    page.get_by_role('button',name='Source Information 3/3',exact=True).click()\n    check('credits include model, environment and usage provenance', 'added on import' in page.get_by_role('dialog').inner_text() and 'gpt-6.1-sol' in page.get_by_role('dialog').inner_text())\n    page.screenshot(path=str(ROOT/'evidence/credits.png'))\n    context.close()\n    # Storage can be unavailable on file origins; the native memory fallback must keep playing.\n    blocked_context=browser.new_context()\n    blocked_context.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new Error('blocked for storage test')}})\\\")\n    blocked_page=blocked_context.new_page()\n    load(blocked_page)\n    start(blocked_page)\n    blocked_page.evaluate('__midnight.game.settings.set(\\\"music\\\",.22)')\n    tick(blocked_page)\n    check('blocked storage retains playable visit-local settings', blocked_page.evaluate('__midnight.game.sceneName === \\\"run\\\" && __midnight.game.settings.music === .22 && __midnight.game.errors.length === 0'))\n    blocked_context.close()\n    browser.close()\n\n\ndef touch_and_visual_checks(p):\n    browser=p.chromium.launch(headless=True)\n    context=browser.new_context(**p.devices['iPhone 13'])\n    page=context.new_page()\n    load(page)\n    page.screenshot(path=str(ROOT/'evidence/portrait-title.png'))\n    page.touchscreen.tap(*point(page,0))\n    tick(page,.3)\n    check('touch menu starts the same campaign',page.evaluate('__midnight.game.sceneName === \\\"run\\\"'))\n    client=context.new_cdp_session(page)\n    def touches(kind,items):\n        client.send('Input.dispatchTouchEvent',{'type':kind,'touchPoints':[{'id':i,'x':x,'y':y}for i,x,y in items]})\n        tick(page,.1)\n    touches('touchStart',[(1,80,590)])\n    touches('touchMove',[(1,125,570)])\n    touches('touchStart',[(1,125,570),(2,320,440)])\n    before=page.evaluate('__midnight.app.world.players[0].x')\n    tick(page,.3)\n    check('touch supports simultaneous steering and Focus hold',page.evaluate('__midnight.app.world.players[0].focus') and page.evaluate('__midnight.app.world.players[0].x')>before)\n    ray=page.locator('button[data-act=\\\"ray\\\"]').bounding_box()\n    if ray:\n        touches('touchStart',[(1,125,570),(2,320,440),(3,ray['x']+ray['width']/2,ray['y']+ray['height']/2)])\n        check('third touch fires ray while steering and focusing',page.evaluate('__midnight.app.world.stats.rays === 1'))\n    else:\n        check('contextual touch ray button is present when charged',False)\n    touches('touchEnd',[])\n    tick(page,.2)\n    check('releasing Focus does not emit a second ray',page.evaluate('__midnight.app.world.stats.rays === 1 && \"'!__midnight.app.world.players[0].focus'\"'))\n    touches('touchStart',[(7,70,600)])\n    touches('touchMove',[(7,130,590)])\n    touches('touchCancel',[])\n    check('touch cancellation clears stick and actions',page.evaluate('\"'!__midnight.game.input.stickOn && !__midnight.app.world.players[0].focus'\"'))\n    page.screenshot(path=str(ROOT/'evidence/portrait-gameplay.png'))\n    context.close()\n    # Exact arena containment after every resize, independent of device orientation.\n    context=browser.new_context(viewport={'width':1920,'height':1080})\n    page=context.new_page();load(page);start(page,2)\n    for w,h in [(1920,1080),(1280,720),(390,844),(844,390),(768,1024),(320,568)]:\n        page.set_viewport_size({'width':w,'height':h});tick(page,.1)\n        result=page.evaluate('''()=>{const g=__midnight.game,q=[[0,0],[384,0],[384,240],[0,240]].map(([x,y])=>{const p=g.view.p(x,y,0);return[p[0]-g.cam.x,p[1]-g.cam.y]});return{corners:q,W:g.W,H:g.H,fit:__midnight.app.garden.rect};}''')\n        ok=all(0<=x<=result['W'] and (74 if result['fit']['portrait'] else 43)<=y<=result['H']-(75 if result['fit']['portrait'] else 25) for x,y in result['corners'])\n        check(f'fixed arena fits viewport {w}x{h} outside HUD/touch',ok,result)\n    page.set_viewport_size({'width':1920,'height':1080});tick(page)\n    page.evaluate('__midnight.loadStage(5)');tick(page,1.6)\n    page.screenshot(path=str(ROOT/'evidence/finale.png'))\n    page.evaluate('__midnight.game.settings.set(\\\"motion\\\",true);__midnight.game.settings.set(\\\"flashes\\\",0)');tick(page)\n    check('motion and flash comfort controls apply',page.evaluate('__midnight.game.reduceMotion && __midnight.game.settings.flashes === 0'))\n    check('visual fixtures have no collected drawing errors',page.evaluate('__midnight.game.errors.length === 0'),page.evaluate('__midnight.game.errors'))\n    context.close();browser.close()\n\n\ndef audio_checks(p):\n    browser=p.chromium.launch(headless=True)\n    context=browser.new_context();page=context.new_page();load(page);start(page)\n    page.keyboard.press('Control');tick(page)\n    voice=page.evaluate('__midnight.offlineVoice()')\n    check('actual procedural chatter has finite nonzero offline output',voice['finite'] and voice['peak']>0.001 and voice['rms']>0.0001,voice)\n    check('procedural chatter envelope decays to silence',voice['tail']<1e-9,voice)\n    levels=page.evaluate('''async()=>{const A=__midnight.game.audio,c=A.ctx;await c.resume();const analyser=c.createAnalyser();analyser.fftSize=512;A.bus('sfx').connect(analyser);const data=new Float32Array(512);A.sfx({wave:'triangle',freq:440,to:800,dur:.2,vol:.5});let peak=0;for(let i=0;i<15;i++){await new Promise(r=>setTimeout(r,15));analyser.getFloatTimeDomainData(data);for(const v of data)peak=Math.max(peak,Math.abs(v));}return{peak,finite:Number.isFinite(peak),music:A.musicVolume,master:A._master.gain.value};}''')\n    check('native SFX bus produces nonzero finite synthesis',levels['finite'] and levels['peak']>0.001,levels)\n    page.evaluate('__midnight.game.settings.set(\\\"sound\\\",false)')\n    check('native mute reaches actual master gain',page.evaluate('__midnight.game.audio._master.gain.value === 0'))\n    page.evaluate('__midnight.game.settings.set(\\\"sound\\\",true);__midnight.game.settings.set(\\\"voice\\\",.23);__midnight.game.settings.set(\\\"effects\\\",.35);__midnight.app.audio.stop()')\n    check('voice and SFX controls reach their buses',page.evaluate('__midnight.game.audio._voiceBus.gain.value === .23 && __midnight.game.audio._sfxBus.gain.value === .35'))\n    check('ending audio stop cancels the original score',page.evaluate('\"'!__midnight.game.audio.pos.playing'\"'))\n    context.close();browser.close()\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self,*args):\n        pass\n\n\ndef hub_checks(p,base):\n    browser=p.chromium.launch(headless=True)\n    reports=[]\n    cases=[('solo',1,'standard',0,0,0),('duo',2,'standard',0,0,0),('lag',2,'standard',150,50,5),('host-leave',2,'host-leave',0,0,0),('dedicated',2,'server',0,0,0)]\n    for label,players,scenario,latency,jitter,loss in cases:\n        context=browser.new_context(viewport={'width':1280,'height':900})\n        page=context.new_page()\n        args={'game':'../../build/index.html','players':players,'auto':1,'play':4500,'scenario':scenario,'latency':latency,'jitter':jitter,'loss':loss}\n        page.goto(base+'/vendor/hub/harness.html?'+urlencode(args))\n        page.wait_for_function('Array.from(document.querySelectorAll(\\\"iframe\\\")).every(f=>f.contentWindow.__midnight)',timeout=20000)\n        frames=page.locator('iframe').count()\n        # Start clock cannot be bypassed by normal actions or explicit engine stepping.\n        gated=page.evaluate('''()=>Array.from(document.querySelectorAll('iframe')).every(f=>{const a=f.contentWindow.__midnight;return a.app.world.tick===0&&\"'!a.app.attract&&a.game.sceneName==='\"'run';})''')\n        check(f'Hub {label}: auto-ready bypasses title and gates pre-start play',gated)\n        page.wait_for_function('Array.from(document.querySelectorAll(\\\"iframe\\\")).some(f=>f.contentWindow.AIHub.time()>=0)',timeout=15000)\n        if players==2 and scenario\"'!='\"'host-leave':\n            # The actual remote page submits intention through the actual bridge.\n            initial=page.evaluate('''()=>{const frames=Array.from(document.querySelectorAll('iframe')),host=frames.find(f=>f.contentWindow.__midnight.app.host).contentWindow.__midnight;const guest=frames.find(f=>\"'!f.contentWindow.__midnight.app.host).contentWindow.__midnight;guest.command(guest.app.local,{x:1,y:0,focus:false,ray:1});return{guest:guest.app.local,x:host.app.world.players[guest.app.local].x};}'\"''')\n            page.wait_for_timeout(800 if not latency else 1100)\n            actual=page.evaluate('''()=>{const a=Array.from(document.querySelectorAll('iframe')).find(f=>f.contentWindow.__midnight.app.host).contentWindow.__midnight;return{players:a.app.world.players,rays:a.app.world.stats.rays};}''')\n            check(f'Hub {label}: remote steering changes host-owned position',actual['players'][initial['guest']]['x']>initial['x']+15,actual)\n            check(f'Hub {label}: remote ray is delivered exactly once',actual['rays']==1,actual)\n            if scenario=='server':\n                check('Hub dedicated: authority has no canvas, local seat or audio context',page.evaluate('''()=>{const a=Array.from(document.querySelectorAll('iframe')).find(f=>f.contentWindow.__midnight.app.host).contentWindow.__midnight;return a.game.headless&&a.game.r===null&&a.app.local===-1&&a.game.audio.ctx===null;}'''))\n            elif label=='duo':\n                before=page.evaluate('''()=>{const a=document.querySelector('iframe').contentWindow.__midnight;a.game.menu('settings');return a.app.world.tick;}''')\n                page.wait_for_timeout(300)\n                check('Hub host settings overlay keeps authority moving',page.evaluate(\\\"document.querySelector('iframe').contentWindow.__midnight.app.world.tick\\\")>before)\n        page.wait_for_function('document.body.dataset.complete === \\\"true\\\"',timeout=30000)\n        report=page.evaluate('window.__hubCheck');reports.append({'case':label,'report':report})\n        check(f'official Hub harness {label} completes and passes',report.get('pass') is True, [c for c in report.get('checks',[])if not c['pass']])\n        if scenario\"'!='\"'host-leave':\n            metrics=page.evaluate('''()=>Array.from(document.querySelectorAll('iframe')).map(f=>{const a=f.contentWindow.__midnight;return{metrics:a.app.net.metrics,ended:a.app.ended,attract:a.app.attract,errors:a.game.errors};})''')\n            check(f'Hub {label}: end stops transport/input/audio ownership',all(a['ended'] and not a['attract'] and not a['errors'] for a in metrics),metrics)\n            check(f'Hub {label}: measured traffic obeys limits',all(a['metrics']['maxRate']<=18 and a['metrics']['maxBytes']<=16384 and a['metrics']['unreliableMax']<=1200 for a in metrics),metrics)\n        context.close()\n    # Guest departure is independent of a host departure and keeps the remaining swarm playable.\n    context=browser.new_context(viewport={'width':1280,'height':900});page=context.new_page()\n    page.goto(base+'/vendor/hub/harness.html?'+urlencode({'game':'../../build/index.html','players':2,'auto':1,'play':6500,'latency':0,'jitter':0,'loss':0}))\n    page.wait_for_function(\\\"document.querySelector('iframe')?.contentWindow.__midnight?.app.world.tick>30\\\",timeout=20000)\n    page.select_option('#who','p1');page.click('#remove');page.wait_for_timeout(250)\n    check('Hub guest departure neutralizes removed seat and continues',page.evaluate(\\\"()=>{const a=document.querySelector('iframe').contentWindow.__midnight;return \"'!a.app.world.players[1].joined&&a.app.world.players[1].bees===0&&a.app.world.phase==='\"'play';}\\\"))\n    page.wait_for_function('document.body.dataset.complete === \\\"true\\\"',timeout=25000)\n    check('Hub remaining player receives valid tied team result',page.evaluate('window.__hubCheck.pass === true'),page.evaluate('window.__hubCheck.checks.filter(c=>\"'!c.pass)'\"'))\n    context.close()\n    (ROOT/'evidence/hub-results.json').write_text(json.dumps(reports,indent=2))\n    browser.close()\n\n\ndef peer_checks(p):\n    browser=p.chromium.launch(headless=True)\n    ca=browser.new_context();cg=browser.new_context();host=ca.new_page();guest=cg.new_page()\n    for page in [host,guest]:load(page,stopped=False);page.evaluate('__midnight.peerMenu()')\n    invalid=guest.evaluate('''async()=>{try{await __midnight.getPeer().answer('not-a-code');return false;}catch(e){return e.message.includes('garden code');}}''')\n    check('direct setup recovers from malformed codes',invalid)\n    offer=host.evaluate('async()=>await __midnight.getPeer().offer()')\n    answer=guest.evaluate('async code=>await __midnight.getPeer().answer(code)',offer)\n    host.evaluate('async code=>await __midnight.getPeer().accept(code)',answer)\n    for page in [host,guest]:page.wait_for_function('__midnight.app.mode === \\\"peer\\\" && __midnight.game.sceneName === \\\"run\\\"',timeout=15000)\n    check('real serverless WebRTC offer/answer opens ordered data channel',host.evaluate('__midnight.getPeer().channel.readyState === \\\"open\\\" && __midnight.getPeer().channel.ordered') and guest.evaluate('__midnight.getPeer().channel.readyState === \\\"open\\\"'))\n    initial=host.evaluate('__midnight.app.world.players[1].x')\n    guest.evaluate('__midnight.command(1,{x:1,y:0,focus:true,ray:1})')\n    host.wait_for_timeout(900)\n    state=host.evaluate('({player:__midnight.app.world.players[1],rays:__midnight.app.world.stats.rays})')\n    check('real WebRTC guest steers and focuses host-authoritative swarm',state['player']['x']>initial+20 and state['player']['focus'],state)\n    check('real WebRTC repeats do not duplicate guest ray',state['rays']==1 and state['player']['charge']==0,state)\n    guest.evaluate('__midnight.release()');host.wait_for_timeout(600)\n    check('direct peer release clears host movement and Focus',host.evaluate('__midnight.app.world.players[1].vx === 0 && \"'!__midnight.app.world.players[1].focus'\"'))\n    before=host.evaluate('__midnight.app.world.tick');host.evaluate('__midnight.game.menu(\\\"settings\\\")');host.wait_for_timeout(300)\n    check('direct host settings overlay keeps world moving',host.evaluate('__midnight.app.world.tick')>before)\n    host.evaluate('__midnight.app.ui.hide()')\n    result=host.evaluate('''async()=>{await __midnight.getPeer().finish({t:'end',won:true,score:3210});return __midnight.getPeer().pc===null;}''')\n    check('direct final result is acknowledged before channel closes',result and guest.evaluate('__midnight.app.world.score===3210 && __midnight.app.world.phase === \\\"ending\\\"'))\n    for page in [host,guest]:page.evaluate('__midnight.title();__midnight.peerMenu()')\n    # Retry creates a new peer connection, with no stale channel or input.\n    offer=host.evaluate('async()=>await __midnight.getPeer().offer()')\n    answer=guest.evaluate('async code=>await __midnight.getPeer().answer(code)',offer)\n    host.evaluate('async code=>await __midnight.getPeer().accept(code)',answer)\n    for page in [host,guest]:page.wait_for_function('__midnight.app.mode === \\\"peer\\\" && __midnight.game.sceneName === \\\"run\\\"',timeout=15000)\n    check('direct setup retries after prior session teardown',host.evaluate('__midnight.app.world.score === 0 && __midnight.app.world.players[1].lastRay === 0'))\n    guest.evaluate('__midnight.getPeer().close(false)')\n    host.wait_for_function('__midnight.app.ui.screen === \\\"disconnected\\\"',timeout=10000)\n    check('direct connection loss offers reconnect and title',host.get_by_role('button',name='Reconnect',exact=True).count()>0 and host.get_by_role('button',name='Title',exact=True).count()>0)\n    check('direct peers have no native collected errors',host.evaluate('__midnight.game.errors.length === 0') and guest.evaluate('__midnight.game.errors.length === 0'))\n    ca.close();cg.close();browser.close()\n\n\ndef main():\n    section('package checks',package_checks)\n    server=ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(ROOT)))\n    threading.Thread(target=server.serve_forever,daemon=True).start()\n    base=f'http://127.0.0.1:{server.server_port}'\n    try:\n        with sync_playwright() as p:\n            if GROUP in ['all','browser']:\n                section('three-browser controls and storage',lambda:browser_checks(p))\n                section('pad, attract, developer and credits',lambda:access_checks(p))\n                section('touch, resize and visual inspection fixtures',lambda:touch_and_visual_checks(p))\n            if GROUP in ['all','audio']:\n                section('synthetic audio',lambda:audio_checks(p))\n            if GROUP in ['all','hub']:\n                section('real official Hub harness',lambda:hub_checks(p,base))\n            if GROUP in ['all','peer']:\n                section('real two-context WebRTC',lambda:peer_checks(p))\n    finally:\n        server.shutdown();server.server_close()\n    (ROOT/'evidence/browser-results.json').write_text(json.dumps(REPORT,indent=2))\n    print(json.dumps(REPORT))\n    return 1 if REPORT['failed'] else 0\n\nif __name__=='__main__':\n    sys.exit(main())\nEOF\nnode tools/build.mjs\nnode tools/test.mjs --group=browser\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'EOF'\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom urllib.parse import urlencode\nimport functools\nimport threading\nimport json\nimport re\nimport sys\nimport traceback\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent.parent\nID = json.loads((ROOT / 'identity.json').read_text())\nARTIFACT = ROOT.parent / ID['artifact']\nGROUP = sys.argv[sys.argv.index('--group') + 1] if '--group' in sys.argv else 'all'\nREPORT = {'passed': 0, 'failed': 0, 'failures': []}\n\ndef check(name, ok, detail=''):\n    if ok:\n        REPORT['passed'] += 1\n    else:\n        REPORT['failed'] += 1\n        REPORT['failures'].append({'name': name, 'detail': str(detail)[:3000]})\n\ndef section(name, fn):\n    try:\n        fn()\n    except Exception:\n        check(name, False, traceback.format_exc())\n\ndef tick(page, seconds=.1, draw=True):\n    page.evaluate('([s,d])=>__midnight.game.advance(s,{draw:d})', [seconds, draw])\n\ndef load(page, url=None, stopped=True):\n    page.goto(url or ARTIFACT.as_uri())\n    page.wait_for_function('window.__midnight \"'!== undefined'\"', timeout=20000)\n    if stopped:\n        page.evaluate('__midnight.game.stop()')\n        tick(page, .2)\n\ndef start(page, players=1):\n    page.evaluate('(n)=>__midnight.start(n)', players)\n    tick(page, .3)\n\ndef press(page, key, seconds=.05):\n    page.keyboard.press(key)\n    tick(page, seconds)\n\ndef point(page, index):\n    return page.evaluate('''i=>{const m=__midnight.app.titleMenu,b=m.rowAt(i),s=__midnight.game.screen,r=s.canvas.getBoundingClientRect();return [r.left+(s.OX+(b[0]+b[2]/2)*s.S)/s.dpr,r.top+(s.OY+(b[1]+b[3]/2)*s.S)/s.dpr];}''', index)\n\nPAD_INIT = '''window.__pads=[];Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});window.__pad=(index=0)=>({id:'DualSense Wireless Controller',index,connected:true,mapping:'standard',timestamp:performance.now(),axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))});'''\n\ndef package_checks():\n    html = ARTIFACT.read_text()\n    first = re.search(r'<script>([\\\\s\\\\S]*?)</script>', html).group(1)\n    check('artifact has the exact prescribed root filename', ARTIFACT.exists() and ARTIFACT.stem == ROOT.name)\n    check('first script is byte-identical pristine Hub client', first.encode() == (ROOT / 'vendor/hub/session.js').read_bytes())\n    check('single HTML contains all runtime code', '<script src=' not in html and 'type=\\\"module\\\"' not in html and '<link ' not in html)\n    check('artifact has no workstation paths or sample slices', '/home/micha/' not in html and 'const SLICES =' not in html)\n    check('served and file artifacts are identical', ARTIFACT.read_bytes() == (ROOT / 'build/index.html').read_bytes())\n    interview = json.loads((ROOT.parent / 'exit-interview.json').read_text()) if (ROOT.parent / 'exit-interview.json').exists() else json.loads((ROOT / 'interview.json').read_text())\n    check('delivery interview parses with exact top-level schema', set(interview) == {'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'})\n    check('catalogue identity matches title and source', interview['aiHub']['name'] == ID['title'] and interview['sourceInformation']['plan'] == 'PLAN.md')\n    check('delivery feedback has every required answer', [len(interview[k]) for k in ['testingFeedback','engineFeedback','promptFeedback']] == [4,6,4] and all(isinstance(a,str) and a for k in ['testingFeedback','engineFeedback','promptFeedback'] for a in interview[k]))\n\n\ndef browser_checks(p):\n    for engine in ['chromium', 'webkit', 'firefox']:\n        browser = getattr(p, engine).launch(headless=True)\n        context = browser.new_context(viewport={'width':1920,'height':1080})\n        page = context.new_page()\n        errors = []\n        requests = []\n        page.on('pageerror', lambda e: errors.append(str(e)))\n        page.on('request', lambda r: requests.append(r.url))\n        load(page)\n        check(f'{engine}: file title boots', page.evaluate('__midnight.game.sceneName === \\\"title\\\"'))\n        check(f'{engine}: music default is persisted setting 10%', page.evaluate('__midnight.game.settings.music === .1 && __midnight.game.audio.musicVolume === .1'))\n        check(f'{engine}: PlayStation symbols are the default', page.evaluate('__midnight.game.settings.glyphs === \\\"playstation\\\"'))\n        # Pointer hover and click use native menu hit regions.\n        xy = point(page, 1)\n        page.mouse.move(*xy)\n        tick(page)\n        check(f'{engine}: hover changes native menu focus', page.evaluate('__midnight.app.titleMenu.i === 1'))\n        page.mouse.click(*point(page, 0))\n        tick(page, .3)\n        check(f'{engine}: pointer starts campaign', page.evaluate('__midnight.game.sceneName === \\\"run\\\" && __midnight.app.world.players[0].bees === 12'))\n        x = page.evaluate('__midnight.app.world.players[0].x')\n        page.keyboard.down('d')\n        tick(page, .4)\n        page.keyboard.up('d')\n        tick(page)\n        check(f'{engine}: keyboard steers responsive swarm', page.evaluate('__midnight.app.world.players[0].x') > x + 25)\n        press(page, 'Space')\n        check(f'{engine}: one press spends exactly one ray', page.evaluate('__midnight.app.world.stats.rays === 1 && __midnight.app.world.players[0].charge === 0'))\n        page.keyboard.down('Shift')\n        tick(page)\n        check(f'{engine}: held Focus uses authoritative formation', page.evaluate('__midnight.app.world.players[0].focus'))\n        page.keyboard.up('Shift')\n        tick(page)\n        press(page, 'Escape')\n        before = page.evaluate('__midnight.app.world.tick')\n        tick(page, 1)\n        check(f'{engine}: native pause freezes solo and opens menu', page.evaluate('__midnight.game.paused && __midnight.app.ui.screen === \\\"pause\\\"') and before == page.evaluate('__midnight.app.world.tick'))\n        page.get_by_role('button', name='Controls', exact=True).click()\n        check(f'{engine}: native controls expose ray and Focus rebinding', page.get_by_role('dialog').get_by_text('Horizontal ray', exact=True).count() > 0 and page.get_by_role('dialog').get_by_text('Hold Focus', exact=True).count() > 0)\n        page.evaluate('__midnight.app.ui.hide();__midnight.game.resume();__midnight.game.input.rebind(\\\"ray\\\",\\\"keys\\\",\\\"KeyR\\\")')\n        tick(page)\n        check(f'{engine}: native rebinding updates key labels', page.evaluate('__midnight.game.input.label(\\\"ray\\\") === \\\"R\\\"'))\n        page.evaluate('__midnight.game.settings.set(\\\"music\\\",.17);__midnight.game.settings.set(\\\"glyphs\\\",\\\"xbox\\\")')\n        page.reload()\n        page.wait_for_function('window.__midnight')\n        page.evaluate('__midnight.game.stop()')\n        tick(page)\n        check(f'{engine}: sound and glyph settings survive reload', page.evaluate('__midnight.game.settings.music === .17 && __midnight.game.settings.glyphs === \\\"xbox\\\"'))\n        check(f'{engine}: no external audio or asset requests', all(u.startswith('file:') for u in requests))\n        check(f'{engine}: no page or native collected errors', not errors and page.evaluate('__midnight.game.errors.length === 0'), errors)\n        context.close()\n        browser.close()\n\n\ndef access_checks(p):\n    browser = p.chromium.launch(headless=True)\n    context = browser.new_context(viewport={'width':1920,'height':1080})\n    context.add_init_script(PAD_INIT)\n    page = context.new_page()\n    load(page)\n    page.evaluate('window.__pads=[__pad(0),__pad(1)];__pads[0].axes=[.1,.1,0,0]')\n    tick(page)\n    check('standard pad dead zone ignores drift', page.evaluate('Math.hypot(...__midnight.game.input.move()) === 0'))\n    page.evaluate('__pads[0].buttons[0]={pressed:true,value:1,touched:true}')\n    tick(page, .3)\n    check('Cross starts a campaign through native input', page.evaluate('__midnight.game.sceneName === \\\"run\\\"'))\n    tick(page, .3)\n    check('held menu confirm does not fire opening ray', page.evaluate('__midnight.app.world.stats.rays === 0'))\n    page.evaluate('__pads[0].buttons[0]={pressed:false,value:0};__pads[0].axes=[.7,0,0,0]')\n    before = page.evaluate('__midnight.app.world.players[0].x')\n    tick(page, .4)\n    check('analogue pad movement reaches simulation', page.evaluate('__midnight.app.world.players[0].x') > before + 15)\n    page.evaluate('__pads[0].axes=[0,0,0,0];__pads[0].buttons[7]={pressed:true,value:1};')\n    tick(page)\n    check('R2 compresses the swarm with PlayStation prompt', page.evaluate('__midnight.app.world.players[0].focus && __midnight.game.input.label(\\\"focus\\\") === \\\"R2\\\"'))\n    page.evaluate('__midnight.game.settings.set(\\\"glyphs\\\",\\\"xbox\\\")')\n    check('Xbox glyph option uses A and RT', page.evaluate('__midnight.game.input.label(\\\"ray\\\") === \\\"A\\\" && __midnight.game.input.label(\\\"focus\\\") === \\\"RT\\\"'))\n    page.evaluate('__pads[0].buttons[7]={pressed:false,value:0};__midnight.title()')\n    tick(page, .3)\n    page.evaluate('__midnight.coOp()')\n    tick(page, .3)\n    page.evaluate('__midnight.app.titleMenu.i=0;__midnight.game.input.tap(\\\"confirm\\\")')\n    tick(page, .3)\n    check('couch setup claims two standard pads', page.evaluate('__midnight.app.mode === \\\"couch\\\" && __midnight.game.players.length === 2 && __midnight.game.players[1].pad === 1'))\n    before = page.evaluate('__midnight.app.world.players.map(p=>[p.x,p.y])')\n    page.evaluate('__pads[0].axes=[-.8,0,0,0];__pads[1].axes=[0,.8,0,0]')\n    tick(page, .5)\n    after = page.evaluate('__midnight.app.world.players.map(p=>[p.x,p.y])')\n    check('two pads independently steer shared couch world', after[0][0] < before[0][0]-15 and after[1][1] > before[1][1]+15)\n    page.evaluate('__pads[0].axes=[0,0,0,0];__pads[1].axes=[0,0,0,0];__pads[1].connected=false')\n    tick(page)\n    check('couch controller disconnect pauses safely', page.evaluate('__midnight.game.paused'))\n    page.evaluate('__pads[1].connected=true;__midnight.app.ui.hide();__midnight.game.resume()')\n    tick(page)\n    check('couch reconnect returns coherent controls', page.evaluate('__midnight.game.players.length === 2 && __midnight.app.world.players.length === 2'))\n    # Reset to standalone title to check the idle threshold exactly.\n    page.evaluate('__pads=[];__midnight.title()')\n    tick(page, .3)\n    page.evaluate('__midnight.app.idle=0')\n    tick(page, 9.9, False)\n    check('attract does not start before ten seconds', page.evaluate('__midnight.game.sceneName === \\\"title\\\"'))\n    tick(page, .2)\n    check('attract starts after ten idle seconds', page.evaluate('__midnight.game.sceneName === \\\"attract\\\" && __midnight.app.attract'))\n    saved = page.evaluate('My3D2dge.store.get(\\\"best:clean\\\",0)')\n    tick(page, 90, False)\n    coverage = page.evaluate('({stats:__midnight.app.world.stats,stage:__midnight.app.world.stage,part:__midnight.app.demoPart})')\n    check('attract exercises real sting, Focus, shells and rays', coverage['stats']['kills'] > 0 and coverage['stats']['focusTicks'] > 0 and coverage['stats']['zaps'] > 0, coverage)\n    check('attract covers maturation and finale exposure', coverage['stats']['maturations'] > 0 and coverage['stats']['bossExposures'] > 0, coverage)\n    check('attract isolates local best scores', saved == page.evaluate('My3D2dge.store.get(\\\"best:clean\\\",0)'))\n    page.mouse.move(500,400)\n    tick(page)\n    check('mouse movement cancels attract and consumes input', page.evaluate('__midnight.game.sceneName === \\\"title\\\" && \"'!__midnight.app.attract && __midnight.app.world === null'\"'))\n    for family in ['keyboard','pad','touch']:\n        page.evaluate('__midnight.app.idle=10')\n        tick(page, .1)\n        if family == 'keyboard':\n            page.keyboard.press('Space')\n        elif family == 'pad':\n            page.evaluate('__pads=[__pad(0)];__pads[0].axes=[.8,0,0,0]')\n        else:\n            page.dispatch_event('#screen','pointerdown',{'pointerId':44,'pointerType':'touch','clientX':100,'clientY':100,'button':0,'bubbles':True})\n            page.dispatch_event('#screen','pointerup',{'pointerId':44,'pointerType':'touch','clientX':100,'clientY':100,'button':0,'bubbles':True})\n        tick(page, .1)\n        check(f'{family} cancels attract without entering play', page.evaluate('__midnight.game.sceneName === \\\"title\\\" && \"'!__midnight.app.attract'\"'))\n        page.evaluate('__pads=[]')\n        tick(page,.25)\n    # Native dev controls and About use the engine's existing Shell.\n    start(page)\n    press(page,'Escape')\n    page.get_by_role('button',name='Developer tools',exact=True).click()\n    check('developer tools are reachable from pause', page.evaluate('__midnight.app.ui.screen === \\\"dev\\\"'))\n    page.get_by_role('button',name='Flight & sting',exact=True).click()\n    page.evaluate('__midnight.game.settings.set(\\\"dev_speed\\\",100)')\n    tick(page)\n    check('live slider changes authoritative tuning and marks assisted', page.evaluate('__midnight.app.world.tuning.speed === 100 && __midnight.app.world.assisted'))\n    page.get_by_role('button',name='Reset tuning to defaults',exact=True).click()\n    tick(page)\n    check('reset sliders restores defaults without erasing assistance', page.evaluate('__midnight.app.world.tuning.speed === 86 && __midnight.app.world.assisted'))\n    page.evaluate('__midnight.game.settings.set(\\\"devTime\\\",.25);__midnight.app.ui.hide()')\n    tick(page)\n    check('closing developer tools restores speed and clears held actions', page.evaluate('__midnight.game.timeScale === 1 && \"'!__midnight.app.devOpen'\"'))\n    page.evaluate('__midnight.title()')\n    tick(page,.3)\n    page.evaluate('__midnight.app.titleMenu.i=3;__midnight.game.input.tap(\\\"confirm\\\")')\n    tick(page)\n    check('About exposes all four required information groups', all(page.get_by_role('button',name=label,exact=True).count() for label in ['Source Information 1/3','Source Information 2/3','Source Information 3/3','Testing Feedback','Engine Feedback','Prompt Feedback']))\n    page.get_by_role('button',name='Source Information 3/3',exact=True).click()\n    check('credits include model, environment and usage provenance', 'added on import' in page.get_by_role('dialog').inner_text() and 'gpt-6.1-sol' in page.get_by_role('dialog').inner_text())\n    page.screenshot(path=str(ROOT/'evidence/credits.png'))\n    context.close()\n    # Storage can be unavailable on file origins; the native memory fallback must keep playing.\n    blocked_context=browser.new_context()\n    blocked_context.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new Error('blocked for storage test')}})\\\")\n    blocked_page=blocked_context.new_page()\n    load(blocked_page)\n    start(blocked_page)\n    blocked_page.evaluate('__midnight.game.settings.set(\\\"music\\\",.22)')\n    tick(blocked_page)\n    check('blocked storage retains playable visit-local settings', blocked_page.evaluate('__midnight.game.sceneName === \\\"run\\\" && __midnight.game.settings.music === .22 && __midnight.game.errors.length === 0'))\n    blocked_context.close()\n    browser.close()\n\n\ndef touch_and_visual_checks(p):\n    browser=p.chromium.launch(headless=True)\n    context=browser.new_context(**p.devices['iPhone 13'])\n    page=context.new_page()\n    load(page)\n    page.screenshot(path=str(ROOT/'evidence/portrait-title.png'))\n    page.touchscreen.tap(*point(page,0))\n    tick(page,.3)\n    check('touch menu starts the same campaign',page.evaluate('__midnight.game.sceneName === \\\"run\\\"'))\n    client=context.new_cdp_session(page)\n    def touches(kind,items):\n        client.send('Input.dispatchTouchEvent',{'type':kind,'touchPoints':[{'id':i,'x':x,'y':y}for i,x,y in items]})\n        tick(page,.1)\n    touches('touchStart',[(1,80,590)])\n    touches('touchMove',[(1,125,570)])\n    touches('touchStart',[(1,125,570),(2,320,440)])\n    before=page.evaluate('__midnight.app.world.players[0].x')\n    tick(page,.3)\n    check('touch supports simultaneous steering and Focus hold',page.evaluate('__midnight.app.world.players[0].focus') and page.evaluate('__midnight.app.world.players[0].x')>before)\n    ray=page.locator('button[data-act=\\\"ray\\\"]').bounding_box()\n    if ray:\n        touches('touchStart',[(1,125,570),(2,320,440),(3,ray['x']+ray['width']/2,ray['y']+ray['height']/2)])\n        check('third touch fires ray while steering and focusing',page.evaluate('__midnight.app.world.stats.rays === 1'))\n    else:\n        check('contextual touch ray button is present when charged',False)\n    touches('touchEnd',[])\n    tick(page,.2)\n    check('releasing Focus does not emit a second ray',page.evaluate('__midnight.app.world.stats.rays === 1 && \"'!__midnight.app.world.players[0].focus'\"'))\n    touches('touchStart',[(7,70,600)])\n    touches('touchMove',[(7,130,590)])\n    touches('touchCancel',[])\n    check('touch cancellation clears stick and actions',page.evaluate('\"'!__midnight.game.input.stickOn && !__midnight.app.world.players[0].focus'\"'))\n    page.screenshot(path=str(ROOT/'evidence/portrait-gameplay.png'))\n    context.close()\n    # Exact arena containment after every resize, independent of device orientation.\n    context=browser.new_context(viewport={'width':1920,'height':1080})\n    page=context.new_page();load(page);start(page,2)\n    for w,h in [(1920,1080),(1280,720),(390,844),(844,390),(768,1024),(320,568)]:\n        page.set_viewport_size({'width':w,'height':h});tick(page,.1)\n        result=page.evaluate('''()=>{const g=__midnight.game,q=[[0,0],[384,0],[384,240],[0,240]].map(([x,y])=>{const p=g.view.p(x,y,0);return[p[0]-g.cam.x,p[1]-g.cam.y]});return{corners:q,W:g.W,H:g.H,fit:__midnight.app.garden.rect};}''')\n        ok=all(0<=x<=result['W'] and (74 if result['fit']['portrait'] else 43)<=y<=result['H']-(75 if result['fit']['portrait'] else 25) for x,y in result['corners'])\n        check(f'fixed arena fits viewport {w}x{h} outside HUD/touch',ok,result)\n    page.set_viewport_size({'width':1920,'height':1080});tick(page)\n    page.evaluate('__midnight.loadStage(5)');tick(page,1.6)\n    page.screenshot(path=str(ROOT/'evidence/finale.png'))\n    page.evaluate('__midnight.game.settings.set(\\\"motion\\\",true);__midnight.game.settings.set(\\\"flashes\\\",0)');tick(page)\n    check('motion and flash comfort controls apply',page.evaluate('__midnight.game.reduceMotion && __midnight.game.settings.flashes === 0'))\n    check('visual fixtures have no collected drawing errors',page.evaluate('__midnight.game.errors.length === 0'),page.evaluate('__midnight.game.errors'))\n    context.close();browser.close()\n\n\ndef audio_checks(p):\n    browser=p.chromium.launch(headless=True)\n    context=browser.new_context();page=context.new_page();load(page);start(page)\n    page.keyboard.press('Control');tick(page)\n    voice=page.evaluate('__midnight.offlineVoice()')\n    check('actual procedural chatter has finite nonzero offline output',voice['finite'] and voice['peak']>0.001 and voice['rms']>0.0001,voice)\n    check('procedural chatter envelope decays to silence',voice['tail']<1e-9,voice)\n    levels=page.evaluate('''async()=>{const A=__midnight.game.audio,c=A.ctx;await c.resume();const analyser=c.createAnalyser();analyser.fftSize=512;A.bus('sfx').connect(analyser);const data=new Float32Array(512);A.sfx({wave:'triangle',freq:440,to:800,dur:.2,vol:.5});let peak=0;for(let i=0;i<15;i++){await new Promise(r=>setTimeout(r,15));analyser.getFloatTimeDomainData(data);for(const v of data)peak=Math.max(peak,Math.abs(v));}return{peak,finite:Number.isFinite(peak),music:A.musicVolume,master:A._master.gain.value};}''')\n    check('native SFX bus produces nonzero finite synthesis',levels['finite'] and levels['peak']>0.001,levels)\n    page.evaluate('__midnight.game.settings.set(\\\"sound\\\",false)')\n    check('native mute reaches actual master gain',page.evaluate('__midnight.game.audio._master.gain.value === 0'))\n    page.evaluate('__midnight.game.settings.set(\\\"sound\\\",true);__midnight.game.settings.set(\\\"voice\\\",.23);__midnight.game.settings.set(\\\"effects\\\",.35);__midnight.app.audio.stop()')\n    check('voice and SFX controls reach their buses',page.evaluate('__midnight.game.audio._voiceBus.gain.value === .23 && __midnight.game.audio._sfxBus.gain.value === .35'))\n    check('ending audio stop cancels the original score',page.evaluate('\"'!__midnight.game.audio.pos.playing'\"'))\n    context.close();browser.close()\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self,*args):\n        pass\n\n\ndef hub_checks(p,base):\n    browser=p.chromium.launch(headless=True)\n    reports=[]\n    cases=[('solo',1,'standard',0,0,0),('duo',2,'standard',0,0,0),('lag',2,'standard',150,50,5),('host-leave',2,'host-leave',0,0,0),('dedicated',2,'server',0,0,0)]\n    for label,players,scenario,latency,jitter,loss in cases:\n        context=browser.new_context(viewport={'width':1280,'height':900})\n        page=context.new_page()\n        args={'game':'../../build/index.html','players':players,'auto':1,'play':4500,'scenario':scenario,'latency':latency,'jitter':jitter,'loss':loss}\n        page.goto(base+'/vendor/hub/harness.html?'+urlencode(args))\n        page.wait_for_function('Array.from(document.querySelectorAll(\\\"iframe\\\")).every(f=>f.contentWindow.__midnight)',timeout=20000)\n        frames=page.locator('iframe').count()\n        # Start clock cannot be bypassed by normal actions or explicit engine stepping.\n        gated=page.evaluate('''()=>Array.from(document.querySelectorAll('iframe')).every(f=>{const a=f.contentWindow.__midnight;return a.app.world.tick===0&&\"'!a.app.attract&&a.game.sceneName==='\"'run';})''')\n        check(f'Hub {label}: auto-ready bypasses title and gates pre-start play',gated)\n        page.wait_for_function('Array.from(document.querySelectorAll(\\\"iframe\\\")).some(f=>f.contentWindow.AIHub.time()>=0)',timeout=15000)\n        if players==2 and scenario\"'!='\"'host-leave':\n            # The actual remote page submits intention through the actual bridge.\n            initial=page.evaluate('''()=>{const frames=Array.from(document.querySelectorAll('iframe')),host=frames.find(f=>f.contentWindow.__midnight.app.host).contentWindow.__midnight;const guest=frames.find(f=>\"'!f.contentWindow.__midnight.app.host).contentWindow.__midnight;guest.command(guest.app.local,{x:1,y:0,focus:false,ray:1});return{guest:guest.app.local,x:host.app.world.players[guest.app.local].x};}'\"''')\n            page.wait_for_timeout(800 if not latency else 1100)\n            actual=page.evaluate('''()=>{const a=Array.from(document.querySelectorAll('iframe')).find(f=>f.contentWindow.__midnight.app.host).contentWindow.__midnight;return{players:a.app.world.players,rays:a.app.world.stats.rays};}''')\n            check(f'Hub {label}: remote steering changes host-owned position',actual['players'][initial['guest']]['x']>initial['x']+15,actual)\n            check(f'Hub {label}: remote ray is delivered exactly once',actual['rays']==1,actual)\n            if scenario=='server':\n                check('Hub dedicated: authority has no canvas, local seat or audio context',page.evaluate('''()=>{const a=Array.from(document.querySelectorAll('iframe')).find(f=>f.contentWindow.__midnight.app.host).contentWindow.__midnight;return a.game.headless&&a.game.r===null&&a.app.local===-1&&a.game.audio.ctx===null;}'''))\n            elif label=='duo':\n                before=page.evaluate('''()=>{const a=document.querySelector('iframe').contentWindow.__midnight;a.game.menu('settings');return a.app.world.tick;}''')\n                page.wait_for_timeout(300)\n                check('Hub host settings overlay keeps authority moving',page.evaluate(\\\"document.querySelector('iframe').contentWindow.__midnight.app.world.tick\\\")>before)\n        page.wait_for_function('document.body.dataset.complete === \\\"true\\\"',timeout=30000)\n        report=page.evaluate('window.__hubCheck');reports.append({'case':label,'report':report})\n        check(f'official Hub harness {label} completes and passes',report.get('pass') is True, [c for c in report.get('checks',[])if not c['pass']])\n        if scenario\"'!='\"'host-leave':\n            metrics=page.evaluate('''()=>Array.from(document.querySelectorAll('iframe')).map(f=>{const a=f.contentWindow.__midnight;return{metrics:a.app.net.metrics,ended:a.app.ended,attract:a.app.attract,errors:a.game.errors};})''')\n            check(f'Hub {label}: end stops transport/input/audio ownership',all(a['ended'] and not a['attract'] and not a['errors'] for a in metrics),metrics)\n            check(f'Hub {label}: measured traffic obeys limits',all(a['metrics']['maxRate']<=18 and a['metrics']['maxBytes']<=16384 and a['metrics']['unreliableMax']<=1200 for a in metrics),metrics)\n        context.close()\n    # Guest departure is independent of a host departure and keeps the remaining swarm playable.\n    context=browser.new_context(viewport={'width':1280,'height':900});page=context.new_page()\n    page.goto(base+'/vendor/hub/harness.html?'+urlencode({'game':'../../build/index.html','players':2,'auto':1,'play':6500,'latency':0,'jitter':0,'loss':0}))\n    page.wait_for_function(\\\"document.querySelector('iframe')?.contentWindow.__midnight?.app.world.tick>30\\\",timeout=20000)\n    page.select_option('#who','p1');page.click('#remove');page.wait_for_timeout(250)\n    check('Hub guest departure neutralizes removed seat and continues',page.evaluate(\\\"()=>{const a=document.querySelector('iframe').contentWindow.__midnight;return \"'!a.app.world.players[1].joined&&a.app.world.players[1].bees===0&&a.app.world.phase==='\"'play';}\\\"))\n    page.wait_for_function('document.body.dataset.complete === \\\"true\\\"',timeout=25000)\n    check('Hub remaining player receives valid tied team result',page.evaluate('window.__hubCheck.pass === true'),page.evaluate('window.__hubCheck.checks.filter(c=>\"'!c.pass)'\"'))\n    context.close()\n    (ROOT/'evidence/hub-results.json').write_text(json.dumps(reports,indent=2))\n    browser.close()\n\n\ndef peer_checks(p):\n    browser=p.chromium.launch(headless=True)\n    ca=browser.new_context();cg=browser.new_context();host=ca.new_page();guest=cg.new_page()\n    for page in [host,guest]:load(page,stopped=False);page.evaluate('__midnight.peerMenu()')\n    invalid=guest.evaluate('''async()=>{try{await __midnight.getPeer().answer('not-a-code');return false;}catch(e){return e.message.includes('garden code');}}''')\n    check('direct setup recovers from malformed codes',invalid)\n    offer=host.evaluate('async()=>await __midnight.getPeer().offer()')\n    answer=guest.evaluate('async code=>await __midnight.getPeer().answer(code)',offer)\n    host.evaluate('async code=>await __midnight.getPeer().accept(code)',answer)\n    for page in [host,guest]:page.wait_for_function('__midnight.app.mode === \\\"peer\\\" && __midnight.game.sceneName === \\\"run\\\"',timeout=15000)\n    check('real serverless WebRTC offer/answer opens ordered data channel',host.evaluate('__midnight.getPeer().channel.readyState === \\\"open\\\" && __midnight.getPeer().channel.ordered') and guest.evaluate('__midnight.getPeer().channel.readyState === \\\"open\\\"'))\n    initial=host.evaluate('__midnight.app.world.players[1].x')\n    guest.evaluate('__midnight.command(1,{x:1,y:0,focus:true,ray:1})')\n    host.wait_for_timeout(900)\n    state=host.evaluate('({player:__midnight.app.world.players[1],rays:__midnight.app.world.stats.rays})')\n    check('real WebRTC guest steers and focuses host-authoritative swarm',state['player']['x']>initial+20 and state['player']['focus'],state)\n    check('real WebRTC repeats do not duplicate guest ray',state['rays']==1 and state['player']['charge']==0,state)\n    guest.evaluate('__midnight.release()');host.wait_for_timeout(600)\n    check('direct peer release clears host movement and Focus',host.evaluate('__midnight.app.world.players[1].vx === 0 && \"'!__midnight.app.world.players[1].focus'\"'))\n    before=host.evaluate('__midnight.app.world.tick');host.evaluate('__midnight.game.menu(\\\"settings\\\")');host.wait_for_timeout(300)\n    check('direct host settings overlay keeps world moving',host.evaluate('__midnight.app.world.tick')>before)\n    host.evaluate('__midnight.app.ui.hide()')\n    result=host.evaluate('''async()=>{await __midnight.getPeer().finish({t:'end',won:true,score:3210});return __midnight.getPeer().pc===null;}''')\n    check('direct final result is acknowledged before channel closes',result and guest.evaluate('__midnight.app.world.score===3210 && __midnight.app.world.phase === \\\"ending\\\"'))\n    for page in [host,guest]:page.evaluate('__midnight.title();__midnight.peerMenu()')\n    # Retry creates a new peer connection, with no stale channel or input.\n    offer=host.evaluate('async()=>await __midnight.getPeer().offer()')\n    answer=guest.evaluate('async code=>await __midnight.getPeer().answer(code)',offer)\n    host.evaluate('async code=>await __midnight.getPeer().accept(code)',answer)\n    for page in [host,guest]:page.wait_for_function('__midnight.app.mode === \\\"peer\\\" && __midnight.game.sceneName === \\\"run\\\"',timeout=15000)\n    check('direct setup retries after prior session teardown',host.evaluate('__midnight.app.world.score === 0 && __midnight.app.world.players[1].lastRay === 0'))\n    guest.evaluate('__midnight.getPeer().close(false)')\n    host.wait_for_function('__midnight.app.ui.screen === \\\"disconnected\\\"',timeout=10000)\n    check('direct connection loss offers reconnect and title',host.get_by_role('button',name='Reconnect',exact=True).count()>0 and host.get_by_role('button',name='Title',exact=True).count()>0)\n    check('direct peers have no native collected errors',host.evaluate('__midnight.game.errors.length === 0') and guest.evaluate('__midnight.game.errors.length === 0'))\n    ca.close();cg.close();browser.close()\n\n\ndef main():\n    section('package checks',package_checks)\n    server=ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(ROOT)))\n    threading.Thread(target=server.serve_forever,daemon=True).start()\n    base=f'http://127.0.0.1:{server.server_port}'\n    try:\n        with sync_playwright() as p:\n            if GROUP in ['all','browser']:\n                section('three-browser controls and storage',lambda:browser_checks(p))\n                section('pad, attract, developer and credits',lambda:access_checks(p))\n                section('touch, resize and visual inspection fixtures',lambda:touch_and_visual_checks(p))\n            if GROUP in ['all','audio']:\n                section('synthetic audio',lambda:audio_checks(p))\n            if GROUP in ['all','hub']:\n                section('real official Hub harness',lambda:hub_checks(p,base))\n            if GROUP in ['all','peer']:\n                section('real two-context WebRTC',lambda:peer_checks(p))\n    finally:\n        server.shutdown();server.server_close()\n    (ROOT/'evidence/browser-results.json').write_text(json.dumps(REPORT,indent=2))\n    print(json.dumps(REPORT))\n    return 1 if REPORT['failed'] else 0\n\nif __name__=='__main__':\n    sys.exit(main())\nEOF\nnode tools/build.mjs\nnode tools/test.mjs --group=browser\"","aggregated_output":"Built Killer-Bee-yond-Midnight-Killer-Bees-1983-gpt-6.1-sol-max-20261106-025717.html (1380 KiB)\nFAIL fixed arena fits viewport 390x844 outside HUD/touch: {'corners': [[103, 53.5625], [466, 53.5625], [466, 280.4375], [103, 280.4375]], 'W': 320, 'H': 693, 'fit': {'x': 103, 'y': 53.5625, 'w': 363, 'h': 226.875, 'zoom': 0.9453125, 'portrait': False, 'top': 46, 'bottom': 32}}\n