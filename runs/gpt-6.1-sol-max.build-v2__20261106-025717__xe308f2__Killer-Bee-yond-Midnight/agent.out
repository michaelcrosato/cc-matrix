{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"rg -n 'start\\\\(scene|start\\\\(o|start\\\\(|_loop\\\\(|requestAnimationFrame|setInterval\\\\(' vendor/engine/my-3d2dge.js | head -35 && rg -n 'server|scenario|limit=|auto' vendor/hub/harness.html | head -35\"","aggregated_output":"28: * 6. TIME. game.start({ update(dt), draw(r) }) or game.start({ scenes, scene }).\n45: *    input.label(action) for prompts, and a boot (10c): heavy setup in game.start({ boot: { steps } }) runs behind a\n61: *    your game's handle for tests and tools; game.stop(), start() and dispose() stop, resume and end it.\n2404:    /** scenes: the scenes given to start(), by name; scene: the scene running; sceneName: its name ('main' for a\n2709:   * Start the loop. Either one scene:  game.start({ update(dt), draw(r) })\n2710:   * or several:  game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' })\n2712:   * (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only\n2725:  start(hooks) {\n2735:        if (typeof hooks.update !== 'function' || typeof hooks.draw !== 'function') throw new Error('game.start({ update(dt), draw(r) }) needs both functions (or use { scenes, scene })');\n2745:      this._raf = requestAnimationFrame(frame);   // scheduled first, so an error never stops the loop\n2749:      // the first, timed from start() and not from a refresh (it read 5 ms on a 120 Hz screen: 200 Hz until 90 more)\n2783:    this._raf = requestAnimationFrame(frame);\n2793:    if (hooks.boot === false) { BOOT.played = true; const el = typeof document !== 'undefined' && document.getElementById('e3-boot'); if (el) { el.hidden = true; el.style.display = 'none'; } BOOT.el = [... omitted end of long line]\n2806:        if (r && typeof r.then === 'function') { r.then(() => { ok(); live ? requestAnimationFrame(next) : next(); }, e => fail(label, e)); return; }\n2807:        ok(); if (live) { requestAnimationFrame(next); return; }   // one step a frame: the screen shows each\n2809:      if (live && o.min && now() - t0 < o.min * 1000) { requestAnimationFrame(next); return; }\n2813:      this.start(h); res(this);\n2818:  /** stop the loop; the game keeps its state, and start() resumes it */\n2837:   * run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and\n2843:    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n2883:    if (!this.scenes) { warn('go:noscenes', 'game.go() needs game.start({ scenes: {...}, scene }) first'); return; }\n3219: *      game.start({ scenes, scene: 'title', boot: { title: 'VESPER', version: '1.0',\n3301:    quip(); clearInterval(this._quip); this._quip = setInterval(quip, 1400);\n4889: *   if (input.buffered('attack') && slash.start()) input.consume('attack');\n4906:  start(canCancel = false) {\n4970:    this.step = next; this.idle = 0; return this.moves[next].start();\n7816:      src.connect(f); f.connect(g); src.start(t, this._rnd() * .5);\n7824:      if (p.vib) { lfo = c.createOscillator(); const lg = c.createGain(); lfo.frequency.value = p.vib[0]; lg.gain.value = f0 * p.vib[1]; lfo.connect(lg); lg.connect(src.frequency); lfo.start(t); if (! [... omitted end of long line]\n7825:      src.connect(g); src.start(t);\n7976:    if (!this._timer) this._timer = setInterval(() => { try { this._schedule(); } catch (e) { warn('music-fail', 'music stopped: ' + e.message); this.stopMusic(); } }, 25);\n10403:  if (typeof window === 'undefined' || typeof requestAnimationFrame !== 'function') return S;\n10416:  const realNow = performance.now.bind(performance), realDate = Date.now, realRAF = requestAnimationFrame.bind(window);\n10496:  // the frame loop: requestAnimationFrame callbacks run with the frame's time, the same way in both\n10498:  window.requestAnimationFrame = cb => { const id = ++ids; queue.push([id, cb]); if (!R && !pending) { pending = true; realRAF(tick); } return id; };\n10615:  a number: coins a game, cab.coin() adds one), hud: true }); cab.start(players, { demo }) begins a game (one or two\n12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n72:const auto = params.get('auto') === '1';\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n177:  const copies = n + (serverMode ? 1 : 0);\n189:    serverKey: serverMode ? 'server' : null,\n208:  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n209:    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n288:  if (state !== current || state.coordinator.released || cell.server) return;\n301:  const players = state.cells.filter((c) => !c.server && !c.gone);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n328:  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n335:    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n349:  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n371:  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n427:    // Every copy: the players, and in a server round the server's copy.\n428:    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n445:      const players = state.cells.filter((c) => !c.server);\n461:        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n499:    if (serverMode) {\n500:      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n501:      const serverCell = state.cells.find((c) => c.server);\n502:      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n503:        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n","exit_code":0,"status":"completed"}}
