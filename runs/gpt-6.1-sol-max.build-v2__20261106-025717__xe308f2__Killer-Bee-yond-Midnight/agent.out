{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"sed -n '9630,9645p' vendor/engine/my-3d2dge.js && sed -n '9805,9860p' vendor/engine/my-3d2dge.js && sed -n '2920,2947p' vendor/engine/my-3d2dge.js\"","aggregated_output":"  }\n  /** the settings screen's rows: Display, Sound and Comfort, then the game's own (standard: false, the game's items only) */\n  _settingsRows(add) {\n    const S = this._game.settings, own = this._items().map(i => i.key);\n    if (!this._std) { for (const k of own) add(this._row(k)); return; }\n    const groups = SHELL_GROUPS.concat([...new Set(S.keys().map(k => S.spec(k).group))].filter(g => !SHELL_GROUPS.includes(g) && !['Controls', 'Controller', 'Touch'].includes(g)));\n    for (const g of groups) {\n      const keys = S.keys(g).filter(k => (k !== 'scale' || this._game.screen._fixedRes()) && (k !== 'fullscreen' || this._game.o.fullscreen !== false) && (k !== 'zoom' || !this._game._zoomStd() || this._game._zooms()) && S.spec(k).type !== 'value');\n      if (!keys.length) continue;\n      add(this._el('div', 'esh-k esh-sec', g)); for (const k of keys) add(this._row(k));\n    }\n  }\n  /** the controls screen: each action's keys and buttons (press a new one to rebind), the controller's and the touch\n   *  buttons' settings */\n  /** the input the Controls screen edits: player 1's, or another player's page (several players: game.players) */\n  _ctlI() { const P = this._game._players; return (P && P[this._pl || 0]) || this._game.input; }\n  _step() {\n    const g = this._game, I = g.input, now = g.real, sc = g.scene, play = !!sc && (!!sc.pausable || g.sceneName === 'main');\n    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n    if (pause && g.paused && !this._stack.length) this.show('pause');\n    if (!g.paused && this._stack.length && (this._ownPause || (pause && this._stack.some(t => t.name === 'pause')))) { this._stack.length = 0; this._ownPause = false; this._capEnd(); this._render(); }   // resumed from code\n    if (this.root) {\n      if (this._toastEnd && now > this._toastEnd) { this._els.toast.classList.remove('on'); this._toastEnd = 0; }\n      if (this._tutEnd && now > this._tutEnd) this.tutorial(null);\n      this.root.classList.toggle('esh-still', !!g.reduceMotion);\n    }\n    if (!this._stack.length) return;\n    const keep = this._held; this._held = new Set();\n    const has = a => !!I.map[a], confirm = has('confirm') && I.pressed('confirm'), cancel = has('cancel') && I.pressed('cancel'), closeAll = has('pause') && I.pressed('pause'), mv = I.move();\n    const hit = ['up', 'down', 'left', 'right'].find(a => has(a) && I.pressed(a)), dir = Math.abs(mv[1]) > .5 ? (mv[1] < 0 ? 'up' : 'down') : Math.abs(mv[0]) > .5 ? (mv[0] < 0 ? 'left' : 'right') : null;\n    for (const a in I.map) if (!keep.has(a)) I.suppress(a);   // the game doesn't see what the menu used\n    if (this._cap) { this._capPad(); return; }   // binding: the next button is the answer, not a move in the menu\n    if (!this.root) { if (cancel) this.back(); else if (closeAll) this.hide(); return; }\n    if (hit) { this._dir = hit; this._dirT = now + .35; this._nav(hit); }   // a press (however short), then the held direction repeats\n    else if (dir !== this._dir) { this._dir = dir; this._dirT = now + .35; if (dir) this._nav(dir); }\n    else if (dir && now > this._dirT) { this._dirT = now + .09; this._nav(dir); }\n    const f = document.activeElement, mine = f && this._els.scr.contains(f);\n    if (confirm && mine && f.tagName === 'BUTTON') f.click();\n    else if (cancel) this.back();\n    else if (closeAll) this.hide();   // Start (or P) closes the whole menu; Escape and B go back one screen\n  }\n  /** binding a controller button: the first one pressed since binding began (Start cancels) */\n  _capPad() {\n    const c = this._cap, I = this._ctlI(); if (!c || c.device !== 'pad') return;\n    const i = I.padPrev.findIndex((on, k) => on && !c.prev[k]); c.prev = I.padPrev.slice();\n    const ra = RSTICK.find(k => I.held.has(k) && !c.prevR.includes(k)); c.prevR = RSTICK.filter(k => I.held.has(k));   // (the right stick pushed: its direction)\n    if (i === 9) this._capEnd('Not changed.'); else if (i >= 0) this._capBind('Pad' + i); else if (ra) this._capBind(ra);\n  }\n  /** move the focus (or turn a focused slider or choice), keeping it in view */\n  _nav(dir) {\n    const all = this._focusables(); if (!all.length) return;\n    const f = document.activeElement, i = all.indexOf(f), side = dir === 'left' || dir === 'right', d = dir === 'up' || dir === 'left' ? -1 : 1;\n    if (f && side && f.type === 'range') { if (d < 0) f.stepDown(); else f.stepUp(); f.dispatchEvent(new Event('input')); return; }\n    if (f && side && f._cycle) { f._cycle(d); return; }\n    const n = all[((i < 0 ? 0 : i + d) + all.length) % all.length]; n.focus({ preventScroll: true }); if (n.scrollIntoView) n.scrollIntoView({ block: 'nearest' });\n  }\n}\nE.Shell = Shell;\n\n/* =============================================================================\n * 22. GPU LIGHTING (WebGPU)  optional. game.enableGPU({ map }) turns it on.\n *    The Canvas renderer still draws every color. Alongside it, it writes an\n *    \"info\" image (height, surface type, glow per pixel). The GPU then lights each\n *    pixel: colored point lights, soft shadows marched through a heightmap of the\n *    level, light wrapping around characters (normals from their silhouettes),\n *    glow spilling onto nearby surfaces, dithered light bands, and heat shimmer.\n *    If WebGPU is missing or fails, the game keeps the Canvas lighting.\n * ============================================================================= */\nconst WGSL_COMMON = /* wgsl */`\nstruct Params {\n  a: vec4f, b: vec4f, c: vec4f, camv: vec4f,\n  right: vec4f, up: vec4f, amb: vec4f, fx: vec4f,\n  }\n  /** report an error in game code without stopping the game: logged once per place and message, kept in game.errors\n   *  and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err) */\n  fail(where, e) {\n    const msg = (e && e.message) || String(e), key = where + ':' + msg;\n    if (!this._errKeys.has(key)) {\n      this._errKeys.add(key); this.errors.push({ where, scene: this.sceneName, message: msg, stack: e && e.stack });\n      console.error('my-3D2dge: error in ' + where + (this.sceneName ? ' (scene \"' + this.sceneName + '\")' : '') + ': ' + ((e && e.stack) || msg));\n    }\n    E.showError('error in ' + where + '()' + (this.sceneName && this.sceneName !== 'main' ? ' of scene \"' + this.sceneName + '\"' : ''), e);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_46","type":"agent_message","text":"The pilot exposed a navigation bug near obstacle edges; I fixed its route recovery. It now clears the first three encounters under normal rules. I’m continuing balance checks while adding bee and gardener rigs, entrance warnings, and the moonlit garden scenery.\n"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation/rigs.js <<'EOF'\nimport {footprint,clamp} from '../sim/world.js';\nexport function createRigs(E){\n const {px}=E;\n function ellipse(g,x,y,rx,ry,color){px.ell(g,x,y,Math.max(.6,rx),Math.max(.6,ry),color);}\n function bee(g,x,y,a,k,time,colors={},agitated=false){\n  const C={body:'#f5d47a',light:'#fff5cb',dark:'#73502b',stripe:'#292e35',wing:'#c8e8e2',...colors},cs=Math.cos(a),sn=Math.sin(a);\n  const P=(u,v)=>[x+(u*cs-v*sn)*k,y+(u*sn+v*cs)*k];\n  const line=(u,v,uu,vv,c,w=1)=>px.line(g,...P(u,v),...P(uu,vv),c,Math.max(1,w*k));\n  const wing=.7+.5*Math.sin(time*54);\n  for(const side of [-1,1]){\n   const pts=[P(-.7,side*.4),P(-2.4,side*(2.4+wing)),P(.1,side*(3+wing)),P(1.3,side*1.3)];\n   px.poly(g,pts,'#466a73');px.poly(g,[pts[0],pts[1],P(.2,side*(2.5+wing)),pts[3]],C.wing);line(-.6,side*.8,-1.1,side*(2.8+wing),'#f1fbdd');\n   line(-1,side,-2,side*1.9,C.dark);line(.7,side,.3,side*2,C.dark);\n   line(2,side*.4,3.4,side*1.5,C.dark);line(3.4,side*1.5,3.6,side*1.8,C.light);\n  }\n  const [ax,ay]=P(-1.3,0);ellipse(g,ax,ay,2.6*k,1.75*k,C.dark);ellipse(g,ax-.25*k,ay-.5*k,2.15*k,1.45*k,C.body);\n  for(const u of [-2.4,-.8])line(u,-1.25,u,1.25,C.stripe,.7);\n  line(-3.4,0,-4.5,0,agitated?'#fff5cb':C.dark);\n  const [tx,ty]=P(1.25,0);ellipse(g,tx,ty,1.65*k,1.65*k,C.dark);ellipse(g,tx-.2*k,ty-.35*k,1.25*k,1.2*k,C.body);\n  const [hx,hy]=P(2.25,0);ellipse(g,hx,hy,1.1*k,1.2*k,C.light);\n  for(const side of [-1,1]){const q=P(2.65,side*.58);px.disc(g,...q,Math.max(.55,.42*k),'#172b35');}\n  px.dot(g,ax-k,ay-k,C.light);\n }\n class BeeRig extends E.Blob{\n  constructor(id){super({R:3,wings:true,colors:{base:id?'#bce1d5':'#f5d47a'}});this.id=id;this.positions=[];this.state=null;}\n  update(dt,state){super.update(dt,{look:[Math.cos(state.facing),Math.sin(state.facing)],flap:state.contact?1:.72,squash:state.focus?-.18:Math.hypot(state.vx,state.vy)/120*.12,squint:state.contact});this.state=state;}\n  draw(g,ox,oy,view){\n   const p=this.state;if(\"'!p)return;const k=(view.scale||1)*(view.zoom||1),R=footprint(p),color=this.id?'\"'#d0f3e6':'#ffdc86';\n   if(\"'!p.bees){px.line(g,ox-4*k,oy-4*k,ox+4*k,oy+4*k,color);px.line(g,ox+4*k,oy-4*k,ox-4*k,oy+4*k,color);return;}\n   for(let i=0;i<p.bees;i++){\n    const a=i*2.399963+this.t*(p.contact?1.6:.65),rr=Math.sqrt((i+.4)/12)*Math.max(0,R-4.3),flutter=Math.sin(this.t*10+i)*.35;\n    const dx=Math.cos(a)*rr,dy=Math.sin(a)*rr;let last=this.positions[i];if(!last)last=this.positions[i]={x:dx,y:dy};\n    // Followers spring within the authoritative footprint; the center stays responsive.\n    last.x+=(dx-last.x)*.24;last.y+=(dy-last.y)*.24;\n    const f=p.contact?Math.atan2(-last.y,-last.x):p.facing+Math.sin(i*2+this.t*4)*.16;\n    bee(g,ox+last.x*k,oy+(last.y+flutter)*k,f,.66*k,this.t+i*1.3,this.id?{body:'\"'#b9decf',light:'#effff0',dark:'#3a6460',wing:'#d4edff'}:{},p.contact);\n   }\n   const pts=this.id?[[ox,oy-2],[ox+2,oy],[ox,oy+2],[ox-2,oy]]:[[ox-1,oy-1],[ox+1,oy-1],[ox+1,oy+1],[ox-1,oy+1]];\n   px.poly(g,pts,color);\n  }\n }\n class GardenerRig extends E.Blob{\n  constructor(type){super({R:7,wings:false,feet:true});this.type=type;this.state=null;}\n  update(dt,state){super.update(dt,{flap:0,walk:state.warning>0?0:state.hp/state.maxHp,squash:state.hp/state.maxHp<.5?-.15:0,squint:state.hp<state.maxHp});this.state=state;}\n  draw(g,ox,oy,view){\n   const t=this.state;if(\"'!t)return;const k=(view.scale||1)*(view.zoom||1),C=this.type==='\"'right'?{dark:'#244644',base:'#548d80',light:'#a9d2b5',rim:'#debd7d'}:{dark:'#4f3837',base:'#bd8057',light:'#f4c086',rim:'#d0e1c0'},health=t.hp/t.maxHp;\n   const bank=Math.sin(this.t*20)*(1-health)*1.3*k,xx=ox+bank,yy=oy;\n   if(this.type==='bell'){this.bell(g,ox,oy,k);return;}\n   for(const side of [-1,1])for(let i=0;i<2;i++){\n    const st=Math.sin(this.t*13+i*Math.PI+side)*health,dx=side*(7+st)*k,dy=(i?3:-3)*k;\n    px.line(g,xx+side*4*k,yy+dy,xx+dx,yy+dy+st*k,C.dark,Math.max(1,k));px.rect(g,xx+dx-k,yy+dy-k,3*k,2*k,C.light);\n   }\n   if(this.type==='right'){\n    px.poly(g,[[xx-7*k,yy-3*k],[xx-3*k,yy-7*k],[xx+5*k,yy-5*k],[xx+7*k,yy+4*k],[xx,yy+7*k],[xx-6*k,yy+4*k]],C.dark);\n    px.poly(g,[[xx-5*k,yy-3*k],[xx-2*k,yy-6*k],[xx+4*k,yy-4*k],[xx+5*k,yy+3*k],[xx,yy+5*k],[xx-4*k,yy+3*k]],C.base);\n    px.line(g,xx-2*k,yy-5*k,xx+3*k,yy-4*k,C.light,Math.max(1,k));\n    px.line(g,xx,yy-5*k,xx,yy-11*k,C.rim);px.poly(g,[[xx,yy-11*k],[xx+4*k,yy-13*k],[xx+3*k,yy-9*k]],C.light);\n   }else{\n    ellipse(g,xx,yy,7*k,6.5*k,C.dark);ellipse(g,xx-.4*k,yy-1*k,5.7*k,5.3*k,C.base);ellipse(g,xx-2*k,yy-3*k,2.6*k,1.6*k,C.light);\n    for(const side of [-1,1]){px.line(g,xx+side*3*k,yy-5*k,xx+side*4*k,yy-9*k,C.rim);px.disc(g,xx+side*4*k,yy-9*k,1.2*k,C.light);}\n   }\n   px.rect(g,xx-4*k,yy-k,8*k,3*k,C.dark);\n   for(const side of [-1,1]){px.rect(g,xx+side*2.5*k-k,yy,2*k,health<.4?k:2*k,health<.4?'#f4a879':'#fff0c8');}\n   px.line(g,xx-2*k,yy+4*k,xx+2*k,yy+4*k,C.rim);px.rect(g,xx-k,yy+6*k,2*k,3*k,C.dark);\n   // The turning arrow is part of the shell's anatomy, separate from color.\n   px.line(g,xx-2*k,yy-3*k,xx+2*k,yy-3*k,C.dark);const side=this.type==='right'?1:-1;px.line(g,xx+side*2*k,yy-3*k,xx+side*k,yy-4*k,C.dark);\n   if(health<.96){const n=16;for(let i=0;i<n;i++){const a=i/n*Math.PI*2,aa=a+.2;const c=i/n<1-health?'#f8d786':'#283b40';px.line(g,ox+Math.cos(a)*10*k,oy+Math.sin(a)*10*k,ox+Math.cos(aa)*10*k,oy+Math.sin(aa)*10*k,c);}}\n   if(t.recovering){px.line(g,xx-2*k,yy-13*k,xx,yy-15*k,'#a6d4d1');px.line(g,xx,yy-15*k,xx+2*k,yy-13*k,'#a6d4d1');}\n  }\n  bell(g,x,y,k){\n   const t=this.state,open=t.bossPhase==='open',pulse=t.bossPhase==='pulse',wob=pulse?Math.sin(this.t*28)*1.3*k:0,C={dark:'#624b36',base:'#c39858',light:'#f9d995'};x+=wob;\n   for(const side of [-1,1])for(const v of [-1,1]){px.line(g,x+side*9*k,y+v*7*k,x+side*19*k,y+v*11*k,'#52675f',2*k);ellipse(g,x+side*19*k,y+v*11*k,3*k,2*k,'#b4c1a1');}\n   ellipse(g,x,y,17*k,16*k,C.dark);ellipse(g,x-k,y-k,15*k,14*k,C.base);ellipse(g,x-5*k,y-7*k,7*k,3*k,C.light);\n   px.rect(g,x-6*k,y-21*k,12*k,4*k,'#71827a');px.rect(g,x-4*k,y-25*k,8*k,5*k,C.dark);px.rect(g,x-2*k,y-24*k,4*k,3*k,C.light);\n   ellipse(g,x,y+2*k,11*k,10*k,'#324443');\n   if(open){\n    for(let i=0;i<6;i++){const a=i*Math.PI/3+this.t*.6;px.poly(g,[[x+Math.cos(a)*7*k,y+Math.sin(a)*7*k],[x+Math.cos(a+.2)*15*k,y+Math.sin(a+.2)*15*k],[x+Math.cos(a+.5)*14*k,y+Math.sin(a+.5)*14*k]],C.light);}\n    ellipse(g,x,y+1*k,6*k,6*k,'#f9da8d');ellipse(g,x-1*k,y-k,3.5*k,3.5*k,'#fff9dc');\n   }else{px.rect(g,x-10*k,y,20*k,4*k,'#88978b');px.line(g,x,y-8*k,x,y+9*k,'#c7b373',Math.max(1,k));for(const side of [-1,1])px.rect(g,x+side*5*k-1,y-4*k,3*k,2*k,pulse?'#ffc68b':'#dfefce');}\n   px.rect(g,x-14*k,y+13*k,28*k,4*k,C.dark);px.rect(g,x-12*k,y+13*k,24*k,2*k,C.light);\n   const n=24;for(let i=0;i<n;i++){const a=i/n*Math.PI*2,aa=a+.15;px.line(g,x+Math.cos(a)*21*k,y+Math.sin(a)*21*k,x+Math.cos(aa)*21*k,y+Math.sin(aa)*21*k,i/n<1-t.hp/t.maxHp?'#ffe1a3':'#45565b');}\n  }\n }\n return {BeeRig,GardenerRig,bee};\n}\nEOF\ncat > src/presentation/assets.js <<'EOF'\nexport function installAssets(E){\n E.MATERIALS.midnightGlaze={color:'#476e69',pattern:'glaze'};\n E.MATERIALS.midnightSoil={color:'#34433c',pattern:'speck',amount:.07};\n E.MATERIALS.midnightGold={color:'#ba9a60',pattern:'metal'};\n E.SHAPES['garden-bed']={about:'glazed moonflower bed with copper corner studs',tags:'garden planter',mats:{g:'midnightGlaze',s:'midnightSoil',c:'midnightGold'},params:{w:32,d:20},make:p=>[\n  ['box','g',[0,0,0],[p.w,p.d,5]],['box','s',[0,0,5],[p.w-5,p.d-5,1]],['mirror','xy',['cyl','c',[p.w/2-2,p.d/2-2,5],1,1]],\n ]};\n E.SHAPES['garden-dial']={about:'a clockwork sundial for a garden that never sees the sun',tags:'garden clock',mats:{s:'slate',g:'midnightGold',c:'copper'},parts:[['cyl','s',[0,0,0],19,3,{seg:12}],['cyl','g',[0,0,3],17,1,{seg:12}],['cyl','s',[0,0,4],15,1,{seg:12}],['ring',12,13,['box','g',[0,0,5],[1,2,1]]],['wedge','c',[0,0,5],[2,16,8]]]};\n E.SHAPES['garden-jewel']={about:'a pale glowing dew jewel in a copper bezel',tags:'garden jewel',mats:{c:'midnightGold',j:{color:'#a0d6c7',pattern:'glaze',glow:.25}},parts:[['cyl','c',[0,0,0],7,2,{seg:6}],['ball','j',[0,0,4],5,{sz:.7}]]};\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation/rigs.js <<'EOF'\nimport {footprint,clamp} from '../sim/world.js';\nexport function createRigs(E){\n const {px}=E;\n function ellipse(g,x,y,rx,ry,color){px.ell(g,x,y,Math.max(.6,rx),Math.max(.6,ry),color);}\n function bee(g,x,y,a,k,time,colors={},agitated=false){\n  const C={body:'#f5d47a',light:'#fff5cb',dark:'#73502b',stripe:'#292e35',wing:'#c8e8e2',...colors},cs=Math.cos(a),sn=Math.sin(a);\n  const P=(u,v)=>[x+(u*cs-v*sn)*k,y+(u*sn+v*cs)*k];\n  const line=(u,v,uu,vv,c,w=1)=>px.line(g,...P(u,v),...P(uu,vv),c,Math.max(1,w*k));\n  const wing=.7+.5*Math.sin(time*54);\n  for(const side of [-1,1]){\n   const pts=[P(-.7,side*.4),P(-2.4,side*(2.4+wing)),P(.1,side*(3+wing)),P(1.3,side*1.3)];\n   px.poly(g,pts,'#466a73');px.poly(g,[pts[0],pts[1],P(.2,side*(2.5+wing)),pts[3]],C.wing);line(-.6,side*.8,-1.1,side*(2.8+wing),'#f1fbdd');\n   line(-1,side,-2,side*1.9,C.dark);line(.7,side,.3,side*2,C.dark);\n   line(2,side*.4,3.4,side*1.5,C.dark);line(3.4,side*1.5,3.6,side*1.8,C.light);\n  }\n  const [ax,ay]=P(-1.3,0);ellipse(g,ax,ay,2.6*k,1.75*k,C.dark);ellipse(g,ax-.25*k,ay-.5*k,2.15*k,1.45*k,C.body);\n  for(const u of [-2.4,-.8])line(u,-1.25,u,1.25,C.stripe,.7);\n  line(-3.4,0,-4.5,0,agitated?'#fff5cb':C.dark);\n  const [tx,ty]=P(1.25,0);ellipse(g,tx,ty,1.65*k,1.65*k,C.dark);ellipse(g,tx-.2*k,ty-.35*k,1.25*k,1.2*k,C.body);\n  const [hx,hy]=P(2.25,0);ellipse(g,hx,hy,1.1*k,1.2*k,C.light);\n  for(const side of [-1,1]){const q=P(2.65,side*.58);px.disc(g,...q,Math.max(.55,.42*k),'#172b35');}\n  px.dot(g,ax-k,ay-k,C.light);\n }\n class BeeRig extends E.Blob{\n  constructor(id){super({R:3,wings:true,colors:{base:id?'#bce1d5':'#f5d47a'}});this.id=id;this.positions=[];this.state=null;}\n  update(dt,state){super.update(dt,{look:[Math.cos(state.facing),Math.sin(state.facing)],flap:state.contact?1:.72,squash:state.focus?-.18:Math.hypot(state.vx,state.vy)/120*.12,squint:state.contact});this.state=state;}\n  draw(g,ox,oy,view){\n   const p=this.state;if(\"'!p)return;const k=(view.scale||1)*(view.zoom||1),R=footprint(p),color=this.id?'\"'#d0f3e6':'#ffdc86';\n   if(\"'!p.bees){px.line(g,ox-4*k,oy-4*k,ox+4*k,oy+4*k,color);px.line(g,ox+4*k,oy-4*k,ox-4*k,oy+4*k,color);return;}\n   for(let i=0;i<p.bees;i++){\n    const a=i*2.399963+this.t*(p.contact?1.6:.65),rr=Math.sqrt((i+.4)/12)*Math.max(0,R-4.3),flutter=Math.sin(this.t*10+i)*.35;\n    const dx=Math.cos(a)*rr,dy=Math.sin(a)*rr;let last=this.positions[i];if(!last)last=this.positions[i]={x:dx,y:dy};\n    // Followers spring within the authoritative footprint; the center stays responsive.\n    last.x+=(dx-last.x)*.24;last.y+=(dy-last.y)*.24;\n    const f=p.contact?Math.atan2(-last.y,-last.x):p.facing+Math.sin(i*2+this.t*4)*.16;\n    bee(g,ox+last.x*k,oy+(last.y+flutter)*k,f,.66*k,this.t+i*1.3,this.id?{body:'\"'#b9decf',light:'#effff0',dark:'#3a6460',wing:'#d4edff'}:{},p.contact);\n   }\n   const pts=this.id?[[ox,oy-2],[ox+2,oy],[ox,oy+2],[ox-2,oy]]:[[ox-1,oy-1],[ox+1,oy-1],[ox+1,oy+1],[ox-1,oy+1]];\n   px.poly(g,pts,color);\n  }\n }\n class GardenerRig extends E.Blob{\n  constructor(type){super({R:7,wings:false,feet:true});this.type=type;this.state=null;}\n  update(dt,state){super.update(dt,{flap:0,walk:state.warning>0?0:state.hp/state.maxHp,squash:state.hp/state.maxHp<.5?-.15:0,squint:state.hp<state.maxHp});this.state=state;}\n  draw(g,ox,oy,view){\n   const t=this.state;if(\"'!t)return;const k=(view.scale||1)*(view.zoom||1),C=this.type==='\"'right'?{dark:'#244644',base:'#548d80',light:'#a9d2b5',rim:'#debd7d'}:{dark:'#4f3837',base:'#bd8057',light:'#f4c086',rim:'#d0e1c0'},health=t.hp/t.maxHp;\n   const bank=Math.sin(this.t*20)*(1-health)*1.3*k,xx=ox+bank,yy=oy;\n   if(this.type==='bell'){this.bell(g,ox,oy,k);return;}\n   for(const side of [-1,1])for(let i=0;i<2;i++){\n    const st=Math.sin(this.t*13+i*Math.PI+side)*health,dx=side*(7+st)*k,dy=(i?3:-3)*k;\n    px.line(g,xx+side*4*k,yy+dy,xx+dx,yy+dy+st*k,C.dark,Math.max(1,k));px.rect(g,xx+dx-k,yy+dy-k,3*k,2*k,C.light);\n   }\n   if(this.type==='right'){\n    px.poly(g,[[xx-7*k,yy-3*k],[xx-3*k,yy-7*k],[xx+5*k,yy-5*k],[xx+7*k,yy+4*k],[xx,yy+7*k],[xx-6*k,yy+4*k]],C.dark);\n    px.poly(g,[[xx-5*k,yy-3*k],[xx-2*k,yy-6*k],[xx+4*k,yy-4*k],[xx+5*k,yy+3*k],[xx,yy+5*k],[xx-4*k,yy+3*k]],C.base);\n    px.line(g,xx-2*k,yy-5*k,xx+3*k,yy-4*k,C.light,Math.max(1,k));\n    px.line(g,xx,yy-5*k,xx,yy-11*k,C.rim);px.poly(g,[[xx,yy-11*k],[xx+4*k,yy-13*k],[xx+3*k,yy-9*k]],C.light);\n   }else{\n    ellipse(g,xx,yy,7*k,6.5*k,C.dark);ellipse(g,xx-.4*k,yy-1*k,5.7*k,5.3*k,C.base);ellipse(g,xx-2*k,yy-3*k,2.6*k,1.6*k,C.light);\n    for(const side of [-1,1]){px.line(g,xx+side*3*k,yy-5*k,xx+side*4*k,yy-9*k,C.rim);px.disc(g,xx+side*4*k,yy-9*k,1.2*k,C.light);}\n   }\n   px.rect(g,xx-4*k,yy-k,8*k,3*k,C.dark);\n   for(const side of [-1,1]){px.rect(g,xx+side*2.5*k-k,yy,2*k,health<.4?k:2*k,health<.4?'#f4a879':'#fff0c8');}\n   px.line(g,xx-2*k,yy+4*k,xx+2*k,yy+4*k,C.rim);px.rect(g,xx-k,yy+6*k,2*k,3*k,C.dark);\n   // The turning arrow is part of the shell's anatomy, separate from color.\n   px.line(g,xx-2*k,yy-3*k,xx+2*k,yy-3*k,C.dark);const side=this.type==='right'?1:-1;px.line(g,xx+side*2*k,yy-3*k,xx+side*k,yy-4*k,C.dark);\n   if(health<.96){const n=16;for(let i=0;i<n;i++){const a=i/n*Math.PI*2,aa=a+.2;const c=i/n<1-health?'#f8d786':'#283b40';px.line(g,ox+Math.cos(a)*10*k,oy+Math.sin(a)*10*k,ox+Math.cos(aa)*10*k,oy+Math.sin(aa)*10*k,c);}}\n   if(t.recovering){px.line(g,xx-2*k,yy-13*k,xx,yy-15*k,'#a6d4d1');px.line(g,xx,yy-15*k,xx+2*k,yy-13*k,'#a6d4d1');}\n  }\n  bell(g,x,y,k){\n   const t=this.state,open=t.bossPhase==='open',pulse=t.bossPhase==='pulse',wob=pulse?Math.sin(this.t*28)*1.3*k:0,C={dark:'#624b36',base:'#c39858',light:'#f9d995'};x+=wob;\n   for(const side of [-1,1])for(const v of [-1,1]){px.line(g,x+side*9*k,y+v*7*k,x+side*19*k,y+v*11*k,'#52675f',2*k);ellipse(g,x+side*19*k,y+v*11*k,3*k,2*k,'#b4c1a1');}\n   ellipse(g,x,y,17*k,16*k,C.dark);ellipse(g,x-k,y-k,15*k,14*k,C.base);ellipse(g,x-5*k,y-7*k,7*k,3*k,C.light);\n   px.rect(g,x-6*k,y-21*k,12*k,4*k,'#71827a');px.rect(g,x-4*k,y-25*k,8*k,5*k,C.dark);px.rect(g,x-2*k,y-24*k,4*k,3*k,C.light);\n   ellipse(g,x,y+2*k,11*k,10*k,'#324443');\n   if(open){\n    for(let i=0;i<6;i++){const a=i*Math.PI/3+this.t*.6;px.poly(g,[[x+Math.cos(a)*7*k,y+Math.sin(a)*7*k],[x+Math.cos(a+.2)*15*k,y+Math.sin(a+.2)*15*k],[x+Math.cos(a+.5)*14*k,y+Math.sin(a+.5)*14*k]],C.light);}\n    ellipse(g,x,y+1*k,6*k,6*k,'#f9da8d');ellipse(g,x-1*k,y-k,3.5*k,3.5*k,'#fff9dc');\n   }else{px.rect(g,x-10*k,y,20*k,4*k,'#88978b');px.line(g,x,y-8*k,x,y+9*k,'#c7b373',Math.max(1,k));for(const side of [-1,1])px.rect(g,x+side*5*k-1,y-4*k,3*k,2*k,pulse?'#ffc68b':'#dfefce');}\n   px.rect(g,x-14*k,y+13*k,28*k,4*k,C.dark);px.rect(g,x-12*k,y+13*k,24*k,2*k,C.light);\n   const n=24;for(let i=0;i<n;i++){const a=i/n*Math.PI*2,aa=a+.15;px.line(g,x+Math.cos(a)*21*k,y+Math.sin(a)*21*k,x+Math.cos(aa)*21*k,y+Math.sin(aa)*21*k,i/n<1-t.hp/t.maxHp?'#ffe1a3':'#45565b');}\n  }\n }\n return {BeeRig,GardenerRig,bee};\n}\nEOF\ncat > src/presentation/assets.js <<'EOF'\nexport function installAssets(E){\n E.MATERIALS.midnightGlaze={color:'#476e69',pattern:'glaze'};\n E.MATERIALS.midnightSoil={color:'#34433c',pattern:'speck',amount:.07};\n E.MATERIALS.midnightGold={color:'#ba9a60',pattern:'metal'};\n E.SHAPES['garden-bed']={about:'glazed moonflower bed with copper corner studs',tags:'garden planter',mats:{g:'midnightGlaze',s:'midnightSoil',c:'midnightGold'},params:{w:32,d:20},make:p=>[\n  ['box','g',[0,0,0],[p.w,p.d,5]],['box','s',[0,0,5],[p.w-5,p.d-5,1]],['mirror','xy',['cyl','c',[p.w/2-2,p.d/2-2,5],1,1]],\n ]};\n E.SHAPES['garden-dial']={about:'a clockwork sundial for a garden that never sees the sun',tags:'garden clock',mats:{s:'slate',g:'midnightGold',c:'copper'},parts:[['cyl','s',[0,0,0],19,3,{seg:12}],['cyl','g',[0,0,3],17,1,{seg:12}],['cyl','s',[0,0,4],15,1,{seg:12}],['ring',12,13,['box','g',[0,0,5],[1,2,1]]],['wedge','c',[0,0,5],[2,16,8]]]};\n E.SHAPES['garden-jewel']={about:'a pale glowing dew jewel in a copper bezel',tags:'garden jewel',mats:{c:'midnightGold',j:{color:'#a0d6c7',pattern:'glaze',glow:.25}},parts:[['cyl','c',[0,0,0],7,2,{seg:6}],['ball','j',[0,0,4],5,{sz:.7}]]};\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation/garden.js <<'EOF'\nimport {STAGES,PALETTES} from '../../content/stages.js';\nimport {footprint,clamp,rng} from '../sim/world.js';\nimport {createRigs} from './rigs.js';\nimport {installAssets} from './assets.js';\nexport class Garden{\n constructor(E,game){this.E=E;this.game=game;installAssets(E);this.rigs=createRigs(E);this.bees=new Map();this.gardeners=new Map();this.particles=[];this.lastEvent=0;this.overlay=false;this.labels=false;this.rect=null;this.cacheStage=-1;this.t=0;this.weather=[];const R=rng(23);for(let i=0;i<100;i++)this.weather.push({x:R()*650-130,y:R()*430-95,a:R()*6.28,s:.2+R()*.7});}\n fit(){\n  const g=this.game,W=g.W,H=g.H,portrait=H>W*1.15;\n  const top=portrait?86:54,bottom=portrait?100:37,margin=portrait?19:30;\n  const fit=Math.min((W-margin*2)/416,(H-top-bottom)/272),zoom=clamp(fit,.5,1.6);\n  if(Math.abs(g.zoom-zoom)>.001)g.setZoom(zoom);\n  const centerY=(top+H-bottom)/2;g.cam.offset=[0,centerY-H/2];g.cam.smooth=0;g.focus(192,120,0);g.cam.snap=true;\n  this.rect={x:(W-384*zoom)/2,y:centerY-120*zoom,w:384*zoom,h:240*zoom,zoom,portrait,top,bottom};return this.rect;\n }\n reset(s){this.lastEvent=s?.eid||0;this.particles=[];this.bees.clear();this.gardeners.clear();}\n update(dt,s){\n  this.t=s.time;this.fit();\n  for(const p of s.players){if(\"'!this.bees.has(p.id))this.bees.set(p.id,new this.rigs.BeeRig(p.id));this.bees.get(p.id).update(dt,p);}\n  for(const t of s.targets){if(!this.gardeners.has(t.id))this.gardeners.set(t.id,new this.rigs.GardenerRig(t.type));this.gardeners.get(t.id).update(dt,t);}\n  for(const e of s.events)if(e.id>this.lastEvent){this.effect(e);this.lastEvent=e.id;}\n  this.particles=this.particles.filter(p=>s.time-p.born<p.life);\n }\n effect(e){\n  const palette={collapse:'\"'#e9bd79',zap:'#d3e8b1',loss:'#e5a397',charge:'#ffe5a0',mature:'#df9890',pulse:'#ebd695',clear:'#e5e9b8'};\n  if(palette[e.type]&&Number.isFinite(e.x)){\n   const R=rng(e.id*37);for(let i=0;i<(e.type==='collapse'?16:8);i++){const a=R()*6.28,s=8+R()*35;this.particles.push({x:e.x,y:e.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,born:e.t,life:.4+R()*.7,c:palette[e.type],kind:e.type});}\n  }\n }\n draw(r,s,{hud=true,demo=false,prompt='',names=[]}={}){\n  const E=this.E,{px}=E,g=this.game,d=STAGES[s.stage],C=PALETTES[d.garden],time=g.reduceMotion?0:s.time;\n  r.sky(['#08151d','#101e29','#18272c']);\n  r.decal(ctx=>{\n   const q=(x,y)=>r.w(x,y,0),rect=(x,y,w,h,c)=>{const a=q(x,y),b=q(x+w,y+h);px.rect(ctx,a[0],a[1],b[0]-a[0],b[1]-a[1],c);};\n   rect(-70,-65,524,370,'#101f27');\n   // Worn stone and soil strata framing the quiet play surface.\n   rect(-20,-20,424,284,'#0a141c');rect(-16,-16,416,276,'#283b40');rect(-12,-12,408,268,C.edge);rect(-10,-10,404,264,'#15272d');\n   rect(-5,-5,394,250,'#42605b');rect(-3,-3,390,246,'#253e3e');rect(0,0,384,240,C.floor);\n   for(let x=0;x<384;x+=16){rect(x,-10,15,3,'#63726b');rect(x,247,15,3,'#263a3b');if(x%48===0){const a=q(x+7,-8);px.dot(ctx,...a,'#c1ac78');}}\n   for(let y=0;y<240;y+=16){rect(-10,y,3,15,'#5c716a');rect(391,y,3,15,'#283e3d');}\n   // Sparse, low contrast floor grain. No animated decorative motion in collision lanes.\n   for(let i=0;i<240;i++){const x=(i*173+19)%382+1,y=(i*83+7)%238+1,a=q(x,y);px.dot(ctx,...a,i%3?'#182a2e':'#233437');}\n   for(let x=32;x<384;x+=64)for(let y=26;y<240;y+=64){const a=q(x,y);px.line(ctx,a[0]-2,a[1],a[0]+2,a[1],'#263738');}\n   // Hand-placed pots, petal beds and copper irrigation rails live outside the arena.\n   for(let i=0;i<17;i++){const x=-25+i*27;this.flower(ctx,r,x,-28,8+i%4,C,i,time);this.flower(ctx,r,x,269,8+(i*3)%5,C,i+23,time);}\n   for(let i=0;i<10;i++){this.flower(ctx,r,-31,i*28-10,11,C,i+41,time);this.flower(ctx,r,416,i*28-10,11,C,i+67,time);}\n   for(let i=0;i<24;i++){const x=i%2?-58:442,y=(i*47)%320-36;this.leaf(ctx,r,x,y,15+i%6,(i%2?1:-1)*.7,C.leaf,time,i);}\n   for(let i=0;i<7;i++){const x=-65+i*85,qq=q(x,-48);px.line(ctx,qq[0],qq[1],qq[0]+40*r.ppu,qq[1],'#294449');}\n   // Visible collision outlines for authored beds.\n   for(const o of d.obstacles){rect(o.x-1,o.y-1,o.w+2,o.h+2,'#5d7469');rect(o.x,o.y,o.w,o.h,'#293e3d');}\n   for(const h of s.husks){const a=q(h.x,h.y);px.ell(ctx,a[0]+2,a[1]+3,h.r*r.ppu+3,h.r*r.ppu+2,'#071318');}\n   if(this.overlay){for(const o of d.obstacles){const a=q(o.x,o.y),b=q(o.x+o.w,o.y+o.h);px.line(ctx,...a,b[0],a[1],'#e5a4b7');px.line(ctx,b[0],a[1],...b,'#e5a4b7');px.line(ctx,...b,a[0],b[1],'#e5a4b7');px.line(ctx,a[0],b[1],...a,'#e5a4b7');}}\n  });\n  for(const o of d.obstacles){\n   if(o.kind==='dial')r.shape('garden-dial',o.x+o.w/2,o.y+o.h/2,0,{scale:o.w/42,shadow:false});\n   else{\n    r.shape('garden-bed',o.x+o.w/2,o.y+o.h/2,0,{params:{w:o.w,d:o.h},mats:{g:d.garden===1?'slate':'midnightGlaze'},shadow:false});\n    r.queue(o.x+o.w/2,o.y+o.h/2,3,ctx=>{for(let i=0;i<Math.max(1,Math.floor(o.w/12));i++)this.flower(ctx,r,o.x+6+i*11,o.y+o.h/2,Math.min(5,o.h/3),C,i+o.x,time,true);});\n    if(o.kind==='trellis')r.queue(o.x+o.w/2,o.y+o.h/2,4,ctx=>{const a=r.w(o.x+3,o.y+3,0),b=r.w(o.x+o.w-3,o.y+o.h-3,0);px.line(ctx,...a,...b,'#8c9878');px.line(ctx,a[0],b[1],b[0],a[1],'#6d867a');});\n   }\n  }\n  for(const [i,e] of d.entrances.entries()){\n   r.shape('garden-jewel',e.x,e.y,0,{scale:.9,shadow:false});\n   r.decal(ctx=>{const a=r.w(e.x,e.y,0);for(let j=0;j<4;j++){const x=a[0]+e.dx*(j*3-9)*r.ppu,y=a[1]+e.dy*(j*3-9)*r.ppu;px.dot(ctx,x,y,'#678a80');}});\n  }\n  for(const h of s.husks){\n   const age=s.time-h.born,k=r.ppu,settle=g.reduceMotion?0:Math.max(0,1-age/.45)*3;\n   r.actor(h.x,h.y,0,(ctx,x,y)=>{\n    const R=h.r*k;px.ell(ctx,x,y,R,R,'#5f6658');px.ell(ctx,x-.5,y-settle,R-1,R-2,'#9c9d7b');px.ell(ctx,x-1,y-2-settle,R-3,R-4,'#c7bf8a');\n    px.line(ctx,x-R*.7,y,x+R*.6,y+R*.2,'#535b51');px.line(ctx,x,y-R*.6,x-2,y+R*.5,'#626950');px.rect(ctx,x+R*.5,y-R*.5,2,1,'#ede0ad');\n    if(h.type==='bell'){px.rect(ctx,x-4*k,y-5*k,8*k,4*k,'#c6a469');px.rect(ctx,x-2*k,y-3*k,4*k,2*k,'#394a49');}\n   },{outline:false,rim:false});\n   if(this.overlay)r.decal(()=>r.groundRing(h.x,h.y,h.r,'#ffd28c',1));\n  }\n  // Charged alignment preview, kept weaker than enemies and the ray itself.\n  for(const p of s.players)if(p.bees&&p.charge){const threat=s.rivals.some(a=>Math.abs(a.y-p.y)<s.tuning.rayWidth+a.r);r.decal(ctx=>{const a=r.w(0,p.y),b=r.w(384,p.y);const c=p.id?'#5f8583':'#69684b';for(let x=a[0];x<b[0];x+=threat?5:10)px.rect(ctx,x,a[1],threat?3:1,1,c);});}\n  for(const t of s.targets){\n   r.shadow(t.x,t.y,t.r+2,.5,'#06151a');\n   if(t.warning>0){r.decal(()=>r.groundRing(t.x,t.y,11+(Math.sin(s.time*8)+1)*2,'#e3b17b',.8));r.textAt(t.x,t.y,0,'\"'!'\"','#ffda90');}\n   const rig=this.gardeners.get(t.id);if(rig)r.actor(t.x,t.y,0,(ctx,x,y)=>rig.draw(ctx,x,y,r.view),{outline:false,rim:false});\n   if(t.type==='bell'&&t.bossPhase==='pulse')r.decal(ctx=>{r.groundRing(t.x,t.y,20+70*t.bossT/1.5,'#c3a176',.65);r.groundRing(t.x,t.y,95,'#786d55',.4);});\n   if(this.labels)r.textAt(t.x,t.y,10,t.type==='bell'?t.bossPhase:t.type==='left'?'LEFTENANT':'RIGHTO','#f5de9b');\n  }\n  for(const a of s.rivals){\n   const k=r.ppu,state=a.state,color=['#95b57f','#9bb3d4','#e89280'][state],shapeN=[5,7,9][state];\n   r.shadow(a.x,a.y,9,.35,'#071018');\n   if(a.warning>0||s.time-a.matureAt<.8)r.decal(()=>r.groundRing(a.x,a.y,12+Math.sin(s.time*6)*2,color,.7));\n   r.actor(a.x,a.y,0,(ctx,x,y)=>{\n    if(a.warning>0){const w=Math.sin(s.time*9)*.2+.5;px.ell(ctx,x,y,8*k,8*k,'#344643');px.ell(ctx,x,y,6*k,6*k,color);px.rect(ctx,x-k,y-4*k,2*k,5*k,'#202e30');px.dot(ctx,x,y+3*k,'#202e30');return;}\n    for(let i=0;i<shapeN;i++){\n     const angle=state===2?a.dir+Math.PI+(i-shapeN/2)*.32:i*2.399+s.time*(state===1?1.6:.8),radius=state===2?3+Math.abs(i-shapeN/2)*1.1:2+Math.sqrt(i)*2;\n     const xx=x+Math.cos(angle)*radius*k,yy=y+Math.sin(angle)*radius*k,wa=Math.sin(s.time*49+i)*1.5;\n     px.ell(ctx,xx,yy-2*k,2*k,(1.7+wa*.2)*k,'#cbded4');px.ell(ctx,xx,yy,1.8*k,2.4*k,'#253334');px.rect(ctx,xx-k,yy-k,2*k,3*k,color);px.dot(ctx,xx,yy-2*k,'#fff4d7');\n    }\n    if(state===2){const cs=Math.cos(a.dir),sn=Math.sin(a.dir);px.line(ctx,x+cs*9*k,y+sn*9*k,x+cs*12*k,y+sn*12*k,color);}\n   },{outline:false,rim:false});\n   if(this.labels)r.textAt(a.x,a.y,10,['SCOUT','GUARD','HUNTER'][state],color);\n  }\n  for(const p of s.players){\n   const color=p.id?'#bce6d3':'#ffe2a0',R=footprint(p);\n   if(p.bees){r.shadow(p.x,p.y,R,.25,'#071419');if(p.contact||p.focus||this.overlay)r.decal(()=>r.groundRing(p.x,p.y,R,color,p.contact?.8:.35));\n    if(s.time-p.lostAt<.45)r.decal(()=>r.groundRing(p.x,p.y,R+4*(s.time-p.lostAt), '#efaa9a',.8));\n   }\n   const rig=this.bees.get(p.id);if(rig)r.actor(p.x,p.y,1,(ctx,x,y)=>rig.draw(ctx,x,y,r.view),{outline:false,rim:false});\n   if(s.players.length>1)r.textAt(p.x,p.y+R+6,0,p.bees?(p.id?'2':'1'):'OUT',color);\n  }\n  for(const e of s.events){const age=s.time-e.t;if(age<0)continue;\n   if(e.type==='ray'&&age<.4){r.queue(192,e.y,1,ctx=>{const a=r.w(0,e.y,0),b=r.w(384,e.y,0),height=(age<.07?3:1)*r.ppu,alpha=(g.settings.flashes===0?.4:.8)*(1-age/.4);px.blend(ctx,alpha,'add',()=>{px.rect(ctx,a[0],a[1]-s.tuning.rayWidth*r.ppu,b[0]-a[0],s.tuning.rayWidth*2*r.ppu,'#697f6a');px.rect(ctx,a[0],a[1]-height/2,b[0]-a[0],height,'#fff4c7');});},{emissive:true});}\n   if(e.type==='collapse'&&age<1.3)r.textAt(e.x,e.y-10-age*9,0,'+'+e.points,'#f6de9f');\n   if(e.type==='pulse'&&age<.65)r.decal(()=>r.groundRing(e.x,e.y,15+age*150,'#f7d9a2',1-age/.65));\n  }\n  for(const p of this.particles){const age=s.time-p.born,a=1-age/p.life;r.actor(p.x+p.vx*age,p.y+p.vy*age,1,(ctx,x,y)=>{px.rect(ctx,x,y,a> .5?2:1,1,p.c);},{outline:false,rim:false});}\n  r.overlay(ctx=>{\n   // A few fireflies float over the perimeter only.\n   for(const a of this.weather){const xx=a.x+Math.sin(time*.3+a.a)*5,yy=a.y+Math.cos(time*.4+a.a)*5;if(xx>0&&xx<384&&yy>0&&yy<240)continue;const q=r.w(xx,yy,0);if(q[0]<0||q[0]>r.W||q[1]<0||q[1]>r.H)continue;if(Math.sin(time*.7+a.a)>.3)px.dot(ctx,...q,'#b2c78b');}\n  });\n  if(hud)this.hud(r,s,{demo,prompt,names});\n }\n leaf(ctx,r,x,y,size,angle,color,time,id){\n  const {px}=this.E,k=r.ppu,a=angle+Math.sin(time*.4+id)*.06,p=r.w(x,y,0),cs=Math.cos(a),sn=Math.sin(a),P=(u,v)=>[p[0]+(u*cs-v*sn)*k,p[1]+(u*sn+v*cs)*k];\n  px.poly(ctx,[P(0,0),P(-size*.5,-size*.6),P(-size*.2,-size*1.2),P(0,-size*1.55),P(size*.4,-size*.7)],'#1d3639');\n  px.poly(ctx,[P(0,0),P(-size*.3,-size*.65),P(0,-size*1.55),P(size*.32,-size*.7)],color);px.line(ctx,...P(0,0),...P(0,-size*1.3),'#658372');\n }\n flower(ctx,r,x,y,size,C,id,time,small=false){\n  const {px}=this.E,k=r.ppu,p=r.w(x,y,0),angle=id*1.73,sw=Math.sin(time*.7+id)*1.3;\n  if(\"'!small){this.leaf(ctx,r,x-3,y+5,size,angle,C.leaf,time,id);this.leaf(ctx,r,x+3,y+4,size*.8,angle+2,C.leaf,time,id+4);}\n  const rad=size*.42*k;\n  for(let i=0;i<5;i++){const a=i*Math.PI*2/5+angle,xx=p[0]+Math.cos(a)*rad,yy=p[1]+Math.sin(a)*rad+sw*k;px.ell(ctx,xx,yy,rad*.95,rad*.85,'\"'#69596a');px.ell(ctx,xx-.5,yy-1,rad*.8,rad*.65,C.flower);px.dot(ctx,xx-1,yy-1,'#f5e2c2');}\n  px.disc(ctx,p[0],p[1]+sw*k,Math.max(1,rad*.55),'#574c3c');px.disc(ctx,p[0]-.5,p[1]-1+sw*k,Math.max(1,rad*.4),'#e5c580');\n  if(id%3===0&&\"'!small){px.disc(ctx,p[0]+rad*1.3,p[1]+rad*1.2,Math.max(1,k),'\"'#9dc8b4');px.dot(ctx,p[0]+rad*1.3-1,p[1]+rad*1.2-1,'#e9f1d4');}\n }\n hud(r,s,{demo,prompt,names}){\n  const {px,font}=this.E,W=r.W,H=r.H,p=this.rect?.portrait,score=String(s.score).padStart(6,'0'),d=STAGES[s.stage];\n  r.overlay(ctx=>{\n   px.rect(ctx,0,0,W,p?73:43,'#0c1922');px.rect(ctx,12,p?72:42,W-24,1,'#3b5353');\n   font.text(ctx,'TEAM',16,8,'#92a6a1',{outline:false});font.text(ctx,score,16,20,'#f8e4ac',{scale:2,outline:false});\n   const cx=p?W*.58:W/2; font.text(ctx,\"'`${String(s.stage+1).padStart(2,'\"'0')} / 06\"'`,cx,8,'\"'#f1d49c',{align:'center',outline:false});\n   if(\"'!p)font.text(ctx,d.name,cx,22,'\"'#d0dfcc',{align:'center',outline:false});\n   s.players.forEach((a,i)=>{const xx=p?16+i*W*.46:W-140+i*72,yy=p?53:8;const c=i?'#bce6d3':'#f1d49c';font.text(ctx,\"'`${i?'\"'◆':'•'} \"'${i+1}  ${a.bees}/12`,xx,yy,c,{outline:false});font.text(ctx,a.bees?(a.charge?'\"'RAY READY':'RAY EMPTY'):'OBSERVER',xx,yy+12,a.charge?c:'#829595',{font:'tiny',outline:false});});\n   const by=H-(p?77:25);px.rect(ctx,12,by-7,W-24,1,'#334b4c');\n   const teaching=s.stageTime<10?d.lesson:s.stageTime<20?d.hint:prompt;\n   const lines=font.wrap(demo?'DEMO  •  ANY INPUT TO PLAY':teaching,W-35,{scale:1});font.text(ctx,lines.slice(0,p?3:2).join('\\\\n'),W/2,by,'#c4d1b9',{align:'center',outline:false});\n   if(s.assisted&&\"'!demo)font.text(ctx,'\"'ASSISTED',W-17,p?81:47,'#b6b8a5',{align:'right',font:'tiny',outline:false});\n   if(demo)font.text(ctx,'KILLER BEE-YOND MIDNIGHT',W/2,p?93:50,'#f8e3ac',{align:'center',outline:false});\n  });\n }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation/garden.js <<'EOF'\nimport {STAGES,PALETTES} from '../../content/stages.js';\nimport {footprint,clamp,rng} from '../sim/world.js';\nimport {createRigs} from './rigs.js';\nimport {installAssets} from './assets.js';\nexport class Garden{\n constructor(E,game){this.E=E;this.game=game;installAssets(E);this.rigs=createRigs(E);this.bees=new Map();this.gardeners=new Map();this.particles=[];this.lastEvent=0;this.overlay=false;this.labels=false;this.rect=null;this.cacheStage=-1;this.t=0;this.weather=[];const R=rng(23);for(let i=0;i<100;i++)this.weather.push({x:R()*650-130,y:R()*430-95,a:R()*6.28,s:.2+R()*.7});}\n fit(){\n  const g=this.game,W=g.W,H=g.H,portrait=H>W*1.15;\n  const top=portrait?86:54,bottom=portrait?100:37,margin=portrait?19:30;\n  const fit=Math.min((W-margin*2)/416,(H-top-bottom)/272),zoom=clamp(fit,.5,1.6);\n  if(Math.abs(g.zoom-zoom)>.001)g.setZoom(zoom);\n  const centerY=(top+H-bottom)/2;g.cam.offset=[0,centerY-H/2];g.cam.smooth=0;g.focus(192,120,0);g.cam.snap=true;\n  this.rect={x:(W-384*zoom)/2,y:centerY-120*zoom,w:384*zoom,h:240*zoom,zoom,portrait,top,bottom};return this.rect;\n }\n reset(s){this.lastEvent=s?.eid||0;this.particles=[];this.bees.clear();this.gardeners.clear();}\n update(dt,s){\n  this.t=s.time;this.fit();\n  for(const p of s.players){if(\"'!this.bees.has(p.id))this.bees.set(p.id,new this.rigs.BeeRig(p.id));this.bees.get(p.id).update(dt,p);}\n  for(const t of s.targets){if(!this.gardeners.has(t.id))this.gardeners.set(t.id,new this.rigs.GardenerRig(t.type));this.gardeners.get(t.id).update(dt,t);}\n  for(const e of s.events)if(e.id>this.lastEvent){this.effect(e);this.lastEvent=e.id;}\n  this.particles=this.particles.filter(p=>s.time-p.born<p.life);\n }\n effect(e){\n  const palette={collapse:'\"'#e9bd79',zap:'#d3e8b1',loss:'#e5a397',charge:'#ffe5a0',mature:'#df9890',pulse:'#ebd695',clear:'#e5e9b8'};\n  if(palette[e.type]&&Number.isFinite(e.x)){\n   const R=rng(e.id*37);for(let i=0;i<(e.type==='collapse'?16:8);i++){const a=R()*6.28,s=8+R()*35;this.particles.push({x:e.x,y:e.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,born:e.t,life:.4+R()*.7,c:palette[e.type],kind:e.type});}\n  }\n }\n draw(r,s,{hud=true,demo=false,prompt='',names=[]}={}){\n  const E=this.E,{px}=E,g=this.game,d=STAGES[s.stage],C=PALETTES[d.garden],time=g.reduceMotion?0:s.time;\n  r.sky(['#08151d','#101e29','#18272c']);\n  r.decal(ctx=>{\n   const q=(x,y)=>r.w(x,y,0),rect=(x,y,w,h,c)=>{const a=q(x,y),b=q(x+w,y+h);px.rect(ctx,a[0],a[1],b[0]-a[0],b[1]-a[1],c);};\n   rect(-70,-65,524,370,'#101f27');\n   // Worn stone and soil strata framing the quiet play surface.\n   rect(-20,-20,424,284,'#0a141c');rect(-16,-16,416,276,'#283b40');rect(-12,-12,408,268,C.edge);rect(-10,-10,404,264,'#15272d');\n   rect(-5,-5,394,250,'#42605b');rect(-3,-3,390,246,'#253e3e');rect(0,0,384,240,C.floor);\n   for(let x=0;x<384;x+=16){rect(x,-10,15,3,'#63726b');rect(x,247,15,3,'#263a3b');if(x%48===0){const a=q(x+7,-8);px.dot(ctx,...a,'#c1ac78');}}\n   for(let y=0;y<240;y+=16){rect(-10,y,3,15,'#5c716a');rect(391,y,3,15,'#283e3d');}\n   // Sparse, low contrast floor grain. No animated decorative motion in collision lanes.\n   for(let i=0;i<240;i++){const x=(i*173+19)%382+1,y=(i*83+7)%238+1,a=q(x,y);px.dot(ctx,...a,i%3?'#182a2e':'#233437');}\n   for(let x=32;x<384;x+=64)for(let y=26;y<240;y+=64){const a=q(x,y);px.line(ctx,a[0]-2,a[1],a[0]+2,a[1],'#263738');}\n   // Hand-placed pots, petal beds and copper irrigation rails live outside the arena.\n   for(let i=0;i<17;i++){const x=-25+i*27;this.flower(ctx,r,x,-28,8+i%4,C,i,time);this.flower(ctx,r,x,269,8+(i*3)%5,C,i+23,time);}\n   for(let i=0;i<10;i++){this.flower(ctx,r,-31,i*28-10,11,C,i+41,time);this.flower(ctx,r,416,i*28-10,11,C,i+67,time);}\n   for(let i=0;i<24;i++){const x=i%2?-58:442,y=(i*47)%320-36;this.leaf(ctx,r,x,y,15+i%6,(i%2?1:-1)*.7,C.leaf,time,i);}\n   for(let i=0;i<7;i++){const x=-65+i*85,qq=q(x,-48);px.line(ctx,qq[0],qq[1],qq[0]+40*r.ppu,qq[1],'#294449');}\n   // Visible collision outlines for authored beds.\n   for(const o of d.obstacles){rect(o.x-1,o.y-1,o.w+2,o.h+2,'#5d7469');rect(o.x,o.y,o.w,o.h,'#293e3d');}\n   for(const h of s.husks){const a=q(h.x,h.y);px.ell(ctx,a[0]+2,a[1]+3,h.r*r.ppu+3,h.r*r.ppu+2,'#071318');}\n   if(this.overlay){for(const o of d.obstacles){const a=q(o.x,o.y),b=q(o.x+o.w,o.y+o.h);px.line(ctx,...a,b[0],a[1],'#e5a4b7');px.line(ctx,b[0],a[1],...b,'#e5a4b7');px.line(ctx,...b,a[0],b[1],'#e5a4b7');px.line(ctx,a[0],b[1],...a,'#e5a4b7');}}\n  });\n  for(const o of d.obstacles){\n   if(o.kind==='dial')r.shape('garden-dial',o.x+o.w/2,o.y+o.h/2,0,{scale:o.w/42,shadow:false});\n   else{\n    r.shape('garden-bed',o.x+o.w/2,o.y+o.h/2,0,{params:{w:o.w,d:o.h},mats:{g:d.garden===1?'slate':'midnightGlaze'},shadow:false});\n    r.queue(o.x+o.w/2,o.y+o.h/2,3,ctx=>{for(let i=0;i<Math.max(1,Math.floor(o.w/12));i++)this.flower(ctx,r,o.x+6+i*11,o.y+o.h/2,Math.min(5,o.h/3),C,i+o.x,time,true);});\n    if(o.kind==='trellis')r.queue(o.x+o.w/2,o.y+o.h/2,4,ctx=>{const a=r.w(o.x+3,o.y+3,0),b=r.w(o.x+o.w-3,o.y+o.h-3,0);px.line(ctx,...a,...b,'#8c9878');px.line(ctx,a[0],b[1],b[0],a[1],'#6d867a');});\n   }\n  }\n  for(const [i,e] of d.entrances.entries()){\n   r.shape('garden-jewel',e.x,e.y,0,{scale:.9,shadow:false});\n   r.decal(ctx=>{const a=r.w(e.x,e.y,0);for(let j=0;j<4;j++){const x=a[0]+e.dx*(j*3-9)*r.ppu,y=a[1]+e.dy*(j*3-9)*r.ppu;px.dot(ctx,x,y,'#678a80');}});\n  }\n  for(const h of s.husks){\n   const age=s.time-h.born,k=r.ppu,settle=g.reduceMotion?0:Math.max(0,1-age/.45)*3;\n   r.actor(h.x,h.y,0,(ctx,x,y)=>{\n    const R=h.r*k;px.ell(ctx,x,y,R,R,'#5f6658');px.ell(ctx,x-.5,y-settle,R-1,R-2,'#9c9d7b');px.ell(ctx,x-1,y-2-settle,R-3,R-4,'#c7bf8a');\n    px.line(ctx,x-R*.7,y,x+R*.6,y+R*.2,'#535b51');px.line(ctx,x,y-R*.6,x-2,y+R*.5,'#626950');px.rect(ctx,x+R*.5,y-R*.5,2,1,'#ede0ad');\n    if(h.type==='bell'){px.rect(ctx,x-4*k,y-5*k,8*k,4*k,'#c6a469');px.rect(ctx,x-2*k,y-3*k,4*k,2*k,'#394a49');}\n   },{outline:false,rim:false});\n   if(this.overlay)r.decal(()=>r.groundRing(h.x,h.y,h.r,'#ffd28c',1));\n  }\n  // Charged alignment preview, kept weaker than enemies and the ray itself.\n  for(const p of s.players)if(p.bees&&p.charge){const threat=s.rivals.some(a=>Math.abs(a.y-p.y)<s.tuning.rayWidth+a.r);r.decal(ctx=>{const a=r.w(0,p.y),b=r.w(384,p.y);const c=p.id?'#5f8583':'#69684b';for(let x=a[0];x<b[0];x+=threat?5:10)px.rect(ctx,x,a[1],threat?3:1,1,c);});}\n  for(const t of s.targets){\n   r.shadow(t.x,t.y,t.r+2,.5,'#06151a');\n   if(t.warning>0){r.decal(()=>r.groundRing(t.x,t.y,11+(Math.sin(s.time*8)+1)*2,'#e3b17b',.8));r.textAt(t.x,t.y,0,'\"'!'\"','#ffda90');}\n   const rig=this.gardeners.get(t.id);if(rig)r.actor(t.x,t.y,0,(ctx,x,y)=>rig.draw(ctx,x,y,r.view),{outline:false,rim:false});\n   if(t.type==='bell'&&t.bossPhase==='pulse')r.decal(ctx=>{r.groundRing(t.x,t.y,20+70*t.bossT/1.5,'#c3a176',.65);r.groundRing(t.x,t.y,95,'#786d55',.4);});\n   if(this.labels)r.textAt(t.x,t.y,10,t.type==='bell'?t.bossPhase:t.type==='left'?'LEFTENANT':'RIGHTO','#f5de9b');\n  }\n  for(const a of s.rivals){\n   const k=r.ppu,state=a.state,color=['#95b57f','#9bb3d4','#e89280'][state],shapeN=[5,7,9][state];\n   r.shadow(a.x,a.y,9,.35,'#071018');\n   if(a.warning>0||s.time-a.matureAt<.8)r.decal(()=>r.groundRing(a.x,a.y,12+Math.sin(s.time*6)*2,color,.7));\n   r.actor(a.x,a.y,0,(ctx,x,y)=>{\n    if(a.warning>0){const w=Math.sin(s.time*9)*.2+.5;px.ell(ctx,x,y,8*k,8*k,'#344643');px.ell(ctx,x,y,6*k,6*k,color);px.rect(ctx,x-k,y-4*k,2*k,5*k,'#202e30');px.dot(ctx,x,y+3*k,'#202e30');return;}\n    for(let i=0;i<shapeN;i++){\n     const angle=state===2?a.dir+Math.PI+(i-shapeN/2)*.32:i*2.399+s.time*(state===1?1.6:.8),radius=state===2?3+Math.abs(i-shapeN/2)*1.1:2+Math.sqrt(i)*2;\n     const xx=x+Math.cos(angle)*radius*k,yy=y+Math.sin(angle)*radius*k,wa=Math.sin(s.time*49+i)*1.5;\n     px.ell(ctx,xx,yy-2*k,2*k,(1.7+wa*.2)*k,'#cbded4');px.ell(ctx,xx,yy,1.8*k,2.4*k,'#253334');px.rect(ctx,xx-k,yy-k,2*k,3*k,color);px.dot(ctx,xx,yy-2*k,'#fff4d7');\n    }\n    if(state===2){const cs=Math.cos(a.dir),sn=Math.sin(a.dir);px.line(ctx,x+cs*9*k,y+sn*9*k,x+cs*12*k,y+sn*12*k,color);}\n   },{outline:false,rim:false});\n   if(this.labels)r.textAt(a.x,a.y,10,['SCOUT','GUARD','HUNTER'][state],color);\n  }\n  for(const p of s.players){\n   const color=p.id?'#bce6d3':'#ffe2a0',R=footprint(p);\n   if(p.bees){r.shadow(p.x,p.y,R,.25,'#071419');if(p.contact||p.focus||this.overlay)r.decal(()=>r.groundRing(p.x,p.y,R,color,p.contact?.8:.35));\n    if(s.time-p.lostAt<.45)r.decal(()=>r.groundRing(p.x,p.y,R+4*(s.time-p.lostAt), '#efaa9a',.8));\n   }\n   const rig=this.bees.get(p.id);if(rig)r.actor(p.x,p.y,1,(ctx,x,y)=>rig.draw(ctx,x,y,r.view),{outline:false,rim:false});\n   if(s.players.length>1)r.textAt(p.x,p.y+R+6,0,p.bees?(p.id?'2':'1'):'OUT',color);\n  }\n  for(const e of s.events){const age=s.time-e.t;if(age<0)continue;\n   if(e.type==='ray'&&age<.4){r.queue(192,e.y,1,ctx=>{const a=r.w(0,e.y,0),b=r.w(384,e.y,0),height=(age<.07?3:1)*r.ppu,alpha=(g.settings.flashes===0?.4:.8)*(1-age/.4);px.blend(ctx,alpha,'add',()=>{px.rect(ctx,a[0],a[1]-s.tuning.rayWidth*r.ppu,b[0]-a[0],s.tuning.rayWidth*2*r.ppu,'#697f6a');px.rect(ctx,a[0],a[1]-height/2,b[0]-a[0],height,'#fff4c7');});},{emissive:true});}\n   if(e.type==='collapse'&&age<1.3)r.textAt(e.x,e.y-10-age*9,0,'+'+e.points,'#f6de9f');\n   if(e.type==='pulse'&&age<.65)r.decal(()=>r.groundRing(e.x,e.y,15+age*150,'#f7d9a2',1-age/.65));\n  }\n  for(const p of this.particles){const age=s.time-p.born,a=1-age/p.life;r.actor(p.x+p.vx*age,p.y+p.vy*age,1,(ctx,x,y)=>{px.rect(ctx,x,y,a> .5?2:1,1,p.c);},{outline:false,rim:false});}\n  r.overlay(ctx=>{\n   // A few fireflies float over the perimeter only.\n   for(const a of this.weather){const xx=a.x+Math.sin(time*.3+a.a)*5,yy=a.y+Math.cos(time*.4+a.a)*5;if(xx>0&&xx<384&&yy>0&&yy<240)continue;const q=r.w(xx,yy,0);if(q[0]<0||q[0]>r.W||q[1]<0||q[1]>r.H)continue;if(Math.sin(time*.7+a.a)>.3)px.dot(ctx,...q,'#b2c78b');}\n  });\n  if(hud)this.hud(r,s,{demo,prompt,names});\n }\n leaf(ctx,r,x,y,size,angle,color,time,id){\n  const {px}=this.E,k=r.ppu,a=angle+Math.sin(time*.4+id)*.06,p=r.w(x,y,0),cs=Math.cos(a),sn=Math.sin(a),P=(u,v)=>[p[0]+(u*cs-v*sn)*k,p[1]+(u*sn+v*cs)*k];\n  px.poly(ctx,[P(0,0),P(-size*.5,-size*.6),P(-size*.2,-size*1.2),P(0,-size*1.55),P(size*.4,-size*.7)],'#1d3639');\n  px.poly(ctx,[P(0,0),P(-size*.3,-size*.65),P(0,-size*1.55),P(size*.32,-size*.7)],color);px.line(ctx,...P(0,0),...P(0,-size*1.3),'#658372');\n }\n flower(ctx,r,x,y,size,C,id,time,small=false){\n  const {px}=this.E,k=r.ppu,p=r.w(x,y,0),angle=id*1.73,sw=Math.sin(time*.7+id)*1.3;\n  if(\"'!small){this.leaf(ctx,r,x-3,y+5,size,angle,C.leaf,time,id);this.leaf(ctx,r,x+3,y+4,size*.8,angle+2,C.leaf,time,id+4);}\n  const rad=size*.42*k;\n  for(let i=0;i<5;i++){const a=i*Math.PI*2/5+angle,xx=p[0]+Math.cos(a)*rad,yy=p[1]+Math.sin(a)*rad+sw*k;px.ell(ctx,xx,yy,rad*.95,rad*.85,'\"'#69596a');px.ell(ctx,xx-.5,yy-1,rad*.8,rad*.65,C.flower);px.dot(ctx,xx-1,yy-1,'#f5e2c2');}\n  px.disc(ctx,p[0],p[1]+sw*k,Math.max(1,rad*.55),'#574c3c');px.disc(ctx,p[0]-.5,p[1]-1+sw*k,Math.max(1,rad*.4),'#e5c580');\n  if(id%3===0&&\"'!small){px.disc(ctx,p[0]+rad*1.3,p[1]+rad*1.2,Math.max(1,k),'\"'#9dc8b4');px.dot(ctx,p[0]+rad*1.3-1,p[1]+rad*1.2-1,'#e9f1d4');}\n }\n hud(r,s,{demo,prompt,names}){\n  const {px,font}=this.E,W=r.W,H=r.H,p=this.rect?.portrait,score=String(s.score).padStart(6,'0'),d=STAGES[s.stage];\n  r.overlay(ctx=>{\n   px.rect(ctx,0,0,W,p?73:43,'#0c1922');px.rect(ctx,12,p?72:42,W-24,1,'#3b5353');\n   font.text(ctx,'TEAM',16,8,'#92a6a1',{outline:false});font.text(ctx,score,16,20,'#f8e4ac',{scale:2,outline:false});\n   const cx=p?W*.58:W/2; font.text(ctx,\"'`${String(s.stage+1).padStart(2,'\"'0')} / 06\"'`,cx,8,'\"'#f1d49c',{align:'center',outline:false});\n   if(\"'!p)font.text(ctx,d.name,cx,22,'\"'#d0dfcc',{align:'center',outline:false});\n   s.players.forEach((a,i)=>{const xx=p?16+i*W*.46:W-140+i*72,yy=p?53:8;const c=i?'#bce6d3':'#f1d49c';font.text(ctx,\"'`${i?'\"'◆':'•'} \"'${i+1}  ${a.bees}/12`,xx,yy,c,{outline:false});font.text(ctx,a.bees?(a.charge?'\"'RAY READY':'RAY EMPTY'):'OBSERVER',xx,yy+12,a.charge?c:'#829595',{font:'tiny',outline:false});});\n   const by=H-(p?77:25);px.rect(ctx,12,by-7,W-24,1,'#334b4c');\n   const teaching=s.stageTime<10?d.lesson:s.stageTime<20?d.hint:prompt;\n   const lines=font.wrap(demo?'DEMO  •  ANY INPUT TO PLAY':teaching,W-35,{scale:1});font.text(ctx,lines.slice(0,p?3:2).join('\\\\n'),W/2,by,'#c4d1b9',{align:'center',outline:false});\n   if(s.assisted&&\"'!demo)font.text(ctx,'\"'ASSISTED',W-17,p?81:47,'#b6b8a5',{align:'right',font:'tiny',outline:false});\n   if(demo)font.text(ctx,'KILLER BEE-YOND MIDNIGHT',W/2,p?93:50,'#f8e3ac',{align:'center',outline:false});\n  });\n }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
