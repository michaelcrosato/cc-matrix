{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc 'head -12 vendor/engine/my-3d2dge.js && tail -8 vendor/engine/my-3d2dge.js && cat vendor/engine/game/test.mjs | head -70 && cat evidence/hub-smoke.json 2>/dev/null | head -60'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc 'head -12 vendor/engine/my-3d2dge.js && tail -8 vendor/engine/my-3d2dge.js && cat vendor/engine/game/test.mjs | head -70 && cat evidence/hub-smoke.json 2>/dev/null | head -60'","aggregated_output":"/*!\n * my-3D2dge v0.89.1  (My \"3D\" 2D Game Engine)\n * Procedural pixel-puppet engine for every 2D perspective.\n * https://github.com/michaelcrosato/my-3d2dge  (MIT License)\n *\n * READ THIS FIRST (humans and AI models extending a my-3D2dge game)\n * -----------------------------------------------------------------------------\n * 0. EVERY GAME STARTS WITH  const E = My3D2dge;  and then uses E.Game, E.px, ...\n * 1. WORLD SPACE IS 3D. x = east, y = south, z = up. One floor tile = 16 units.\n *    Game logic never thinks about screen pixels.\n * 2. A VIEW turns world points into screen pixels. Swap the view and the whole game\n *    re-renders from another angle: E.VIEWS.iso, .threequarter, .topdown,\n      const base = up ? P.t : rim ? P.e : P.c, l = up === 1 ? 24 : 0;\n      D[o] = Math.max(0, Math.min(255, base[0] + n + l)); D[o + 1] = Math.max(0, Math.min(255, base[1] + n + l)); D[o + 2] = Math.max(0, Math.min(255, base[2] + n * .7 + l)); D[o + 3] = 255;\n    }\n    g.putImageData(img, 0, 0); return cv;\n  }\n}\nE.Terrain = Terrain;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\n// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n{\n  \"done\": true,\n  \"pass\": true,\n  \"game\": \"../../build/index.html\",\n  \"players\": 2,\n  \"scenario\": \"standard\",\n  \"checks\": [\n    {\n      \"name\": \"head metas\",\n      \"pass\": true,\n      \"detail\": \"hub:session=1 mode=shared-world\"\n    },\n    {\n      \"name\": \"hub:session-players is a range within 1\\u20134\",\n      \"pass\": true,\n      \"detail\": \"hub:session-players=1-2\"\n    },\n    {\n      \"name\": \"hub:session-minutes, when given, is a number\",\n      \"pass\": true,\n      \"detail\": \"hub:session-minutes=12\"\n    },\n    {\n      \"name\": \"every copy says hello\",\n      \"pass\": true,\n      \"detail\": \"\"\n    },\n    {\n      \"name\": \"hello names protocol 1 and the mode\",\n      \"pass\": true,\n      \"detail\": \"{\\\"v\\\":1,\\\"client\\\":\\\"1.4.0\\\",\\\"mode\\\":\\\"shared-world\\\",\\\"seats\\\":[1,2],\\\"card\\\":false}\"\n    },\n    {\n      \"name\": \"hello seats cover this player count\",\n      \"pass\": true,\n      \"detail\": \"[1,2]\"\n    },\n    {\n      \"name\": \"ready without a key press (the card asks the players)\",\n      \"pass\": true,\n      \"detail\": \"\"\n    },\n    {\n      \"name\": \"the round starts when the card ends\",\n      \"pass\": true,\n      \"detail\": \"countdown\"\n    },\n    {\n      \"name\": \"game traffic flows both ways\",\n      \"pass\": true,\n      \"detail\": \"p0 \\u219124 \\u219329 p1 \\u219130 \\u219324\"\n    },\n    {\n      \"name\": \"the round ends with a valid result\",\n      \"pass\": true,\n      \"detail\": \"played (finished)\"\n    },\n    {\n      \"name\": \"every remaining copy is told the round ended\",\n      \"pass\": true,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"cat > tools/peer-smoke.py <<'EOF'\nfrom pathlib import Path\nimport json\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parent.parent\nurl=(root.parent/json.loads((root/'identity.json').read_text())['artifact']).as_uri()\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True);a=b.new_page();g=b.new_page();errors=[]\n for page in [a,g]:page.on('pageerror',lambda e:errors.append(str(e)));page.goto(url);page.wait_for_function('window.__midnight');page.evaluate('__midnight.peerMenu()')\n offer=a.evaluate('async()=>await __midnight.getPeer().offer()')\n answer=g.evaluate('async code=>await __midnight.getPeer().answer(code)',offer)\n a.evaluate('async code=>await __midnight.getPeer().accept(code)',answer)\n for page in [a,g]:page.wait_for_function('__midnight.app.mode === \\\"peer\\\" && __midnight.game.sceneName === \\\"run\\\"',timeout=15000)\n x=a.evaluate('__midnight.app.world.players[1].x')\n g.evaluate('__midnight.command(1,{x:1,y:0,focus:false,ray:1})')\n a.wait_for_timeout(1100)\n print('Host:',a.evaluate('({players:__midnight.app.world.players,metrics:__midnight.app.net.metrics,errors:__midnight.game.errors})'))\n print('Guest:',g.evaluate('({players:__midnight.app.world.players,metrics:__midnight.app.net.metrics,errors:__midnight.game.errors})'))\n print('Moved',a.evaluate('__midnight.app.world.players[1].x')-x,'Page errors',errors)\n for page in [a,g]:page.evaluate('__midnight.dispose()')\n b.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tools/peer-smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport {newWorld,step} from './src/sim/world.js';import {pilot} from './src/sim/bot.js';\nfor(const seed of [7,23,701]){const s=newWorld({seed}),m={};for(let i=0;i<120*800;i++){step(s,[pilot(s,s.players[0],m)]);if(s.phase==='failed'||s.phase==='ending')break;}console.log({seed,phase:s.phase,stage:s.stage+1,time:s.time,bees:s.players[0].bees,kills:s.stats.kills});}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"cat > tools/peer-smoke.py <<'EOF'\nfrom pathlib import Path\nimport json\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parent.parent\nurl=(root.parent/json.loads((root/'identity.json').read_text())['artifact']).as_uri()\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True);a=b.new_page();g=b.new_page();errors=[]\n for page in [a,g]:page.on('pageerror',lambda e:errors.append(str(e)));page.goto(url);page.wait_for_function('window.__midnight');page.evaluate('__midnight.peerMenu()')\n offer=a.evaluate('async()=>await __midnight.getPeer().offer()')\n answer=g.evaluate('async code=>await __midnight.getPeer().answer(code)',offer)\n a.evaluate('async code=>await __midnight.getPeer().accept(code)',answer)\n for page in [a,g]:page.wait_for_function('__midnight.app.mode === \\\"peer\\\" && __midnight.game.sceneName === \\\"run\\\"',timeout=15000)\n x=a.evaluate('__midnight.app.world.players[1].x')\n g.evaluate('__midnight.command(1,{x:1,y:0,focus:false,ray:1})')\n a.wait_for_timeout(1100)\n print('Host:',a.evaluate('({players:__midnight.app.world.players,metrics:__midnight.app.net.metrics,errors:__midnight.game.errors})'))\n print('Guest:',g.evaluate('({players:__midnight.app.world.players,metrics:__midnight.app.net.metrics,errors:__midnight.game.errors})'))\n print('Moved',a.evaluate('__midnight.app.world.players[1].x')-x,'Page errors',errors)\n for page in [a,g]:page.evaluate('__midnight.dispose()')\n b.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tools/peer-smoke.py\"","aggregated_output":"Host: {'players': [{'id': 0, 'x': 176, 'y': 126, 'bees': 12, 'charge': 1, 'focus': False, 'vx': 0, 'vy': 0, 'facing': -1.5707963267948966, 'inv': 0.33333333333333637, 'lastRay': 0, 'emptyAt': 0, 'contact': False, 'lostAt': -10, 'joined': True, 'contribution': 0}, {'id': 1, 'x': 301.1666666666651, 'y': 126, 'bees': 1