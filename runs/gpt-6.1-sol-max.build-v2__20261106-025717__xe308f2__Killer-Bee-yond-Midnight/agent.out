{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"sed -n '3720,3837p' vendor/engine/my-3d2dge.js\"","aggregated_output":"/* =============================================================================\n * 10j. PLAYERS AND SPLIT SCREEN  two to four on one machine. game.players: game.input is player 1 (a game of one is\n *    unchanged), each other an input of its own, with game.input's API, its device and its bindings: a gamepad each, or\n *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\n *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n *    right half's start) on the keyboard, player 1 then playing on its left half; game.removePlayer(p). Each has player (its\n *    number), name ('P2') and color. A pause says who paused, a lost controller names its player, the Controls screen\n *    has a page each. game.splitScreen(n, { layout, follow }): two to four viewports, each its own camera (viewport.follow,\n *    viewport.focus), the scene drawn once in each (r.viewport says which: { i, x, y, w, h }) and scene.hud(r) once over\n *    the whole screen; GPU lighting off while split. A scene's start ends a split.\n * ============================================================================= */\nconst KEY_HALVES = {   // each half's moves, its buttons in order (the preset's other actions take them in turn) and its menu keys\n  left: { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], buttons: [['KeyF'], ['KeyG'], ['KeyH'], ['KeyR'], ['KeyT'], ['KeyY'], ['KeyV'], ['KeyB']], start: ['Digit1'], pause: ['Escape', 'Digit1'], confirm: ['KeyF'], cancel: ['KeyG'] },\n  right: { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], buttons: [['Period', 'Numpad1'], ['Slash', 'Numpad2'], ['Comma', 'Numpad3'], ['KeyL', 'Numpad4'], ['Semicolon', 'Numpad5'], ['Quote', 'Numpad6'], ['KeyK', 'Numpad7'], ['KeyM', 'Numpad8']],\n    start: ['Digit2', 'Enter', 'NumpadEnter'], pause: ['Digit2', 'Backspace'], confirm: ['Period', 'Enter', 'NumpadEnter'], cancel: ['Slash', 'Backspace'] }\n};\n/** a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons\n *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /).\n *  A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action\n *  a menu reads beside confirm would take confirm's F otherwise) */\nInput.halfKeys = (preset, side) => {\n  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, own = (P.halves && P.halves[side]) || {}, out = {};\n  let k = 0;\n  for (const a in P) if (Array.isArray(P[a])) out[a] = (own[a] || H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\n  return out;\n};\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player's input: the screen's sizes, no listeners of its own)\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nfunction _pClaim(game) {   // player 1 reads no pad another player holds; the keyboard's codes go to the players sharing it\n  const P = game.players, I = P[0];\n  I._claimed = new Set(P.slice(1).filter(q => typeof q.pad === 'number').map(q => q.pad));\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n  if (!I.keysTo.length) I.keysTo = null;\n}\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\nGame.prototype.allowJoin = function (o = {}) {\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\n  this._lobby = this._join.keys && this.screen.canvas ? new Input(_pStub(this), { join: ['Digit2'] }) : null;   // (listens for 2 while player 1 has the whole keyboard)\n  _pClaim(this); return this;\n};\n/** a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the\n *  left). Returns its input (null when four play already) */\nGame.prototype.addPlayer = function (o = {}) {\n  const P = this.players; if (P.length >= 4) return null;\n  const q = new Input(_pStub(this), Input.DEFAULT), n = P.length + 1;\n  Object.assign(q, { player: n, name: 'P' + n, color: E.PLAYER_COLORS[n - 1], pad: typeof o.pad === 'number' ? o.pad : null, half: o.keys ? 'right' : null, device: o.keys ? 'keyboard' : 'gamepad' });\n  for (const k of ['glyphs', 'deadzone', 'invertAimY', 'invertMoveX', 'invertMoveY', 'rumbleScale']) q[k] = this.input[k];   // (the player's settings: button symbols, dead zone, aim, the move stick, vibration)\n  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\n  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n  q.use(_pPreset(this, q));\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\n  P.push(q); _pClaim(this);\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n  this.note(q.name + ' JOINED', 1.5); this.audio.sfx('confirm');\n  return q;\n};\n/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\nGame.prototype.removePlayer = function (p) {\n  const P = this.players, i = typeof p === 'number' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = 'P' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\n  _pClaim(this);\n};\n/** split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide\n *  screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 } */\nGame.prototype.splitScreen = function (n, o = {}) {\n  if (!(n >= 2)) { this._split = null; return this; }\n  const prev = this._split, vps = Array.from({ length: Math.min(4, n) }, (_, i) => (prev && prev.vps[i]) || _vp(i));\n  this._split = { layout: o.layout || 'auto', gap: o.gap === undefined ? 1 : o.gap, vps };\n  if (o.follow) o.follow.forEach((t, i) => vps[i] && vps[i].follow(t, o));\n  _vpLayout(this); return this;\n};\n// a viewport: where it is on the screen, and its camera (as game.cam: a focus it eases to, the bounds of game.cam)\nfunction _vp(i) {\n  const v = { i, x: 0, y: 0, w: 0, h: 0, target: null, z: 16, cam: { tx: 0, ty: 0, tz: 0, x: undefined, y: 0, vx: 0, vy: 0, smooth: .12, snap: true, bounds: null } };\n  /** look at a world point */\n  v.focus = (x, y, z = 0) => { v.target = null; Object.assign(v.cam, { tx: x, ty: y, tz: z }); };\n  /** keep the camera on an object ({ x, y, z }); o.z: the height looked at (16) */\n  v.follow = (t, o = {}) => { v.target = t || null; if (o.z !== undefined) v.z = o.z; v.cam.snap = true; };\n  return v;\n}\nfunction _vpLayout(game) {\n  const S = game._split, n = S.vps.length, W = game.screen.W, H = game.screen.H, g = S.gap;\n  const mode = S.layout === 'auto' ? (n > 2 ? 'grid' : W >= H ? 'columns' : 'rows') : S.layout;\n  S.vps.forEach((v, i) => {\n    const [c, r, cols, rows] = mode === 'grid' ? [i % 2, Math.floor(i / 2), 2, 2] : mode === 'rows' ? [0, i, 1, n] : [i, 0, n, 1];\n    const x0 = Math.round(c * W / cols), x1 = Math.round((c + 1) * W / cols), y0 = Math.round(r * H / rows), y1 = Math.round((r + 1) * H / rows);\n    Object.assign(v, { x: x0 + (c ? g : 0), y: y0 + (r ? g : 0), w: x1 - x0 - (c ? g : 0), h: y1 - y0 - (r ? g : 0) });\n  });\n}\nfunction _vpCam(game, v, dt) {   // (game.cam's rules in the viewport's size: centred on its focus, inside the bounds, eased)\n  const c = v.cam, t = v.target; if (t) { c.tx = t.x; c.ty = t.y || 0; c.tz = (t.z || 0) + v.z; }\n  const [sx, sy] = game.view.p(c.tx, c.ty, c.tz), bf = c.bounds || game.cam.bounds, b = bf && bf(game.view);\n  let tx = sx - v.w / 2, ty = sy - v.h / 2;\n  if (b) { tx = b.x1 - b.x0 < v.w ? (b.x0 + b.x1 - v.w) / 2 : clamp(tx, b.x0, b.x1 - v.w); ty = b.y1 - b.y0 < v.h ? (b.y0 + b.y1 - v.h) / 2 : clamp(ty, b.y0, b.y1 - v.h); }\n  if (c.snap || c.x === undefined || !(c.smooth > 0)) { c.x = tx; c.y = ty; c.vx = c.vy = 0; c.snap = false; return; }\n  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\n}\n// each step: the other players' inputs, a pause by any of them, a lost controller, and joining\nHOOKS.input.push((game, dt) => {\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\n  for (const q of P.slice(1)) {\n    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\n  }\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n  if (I.pressed('pause')) game.pausedBy = 1;\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === 'gamepad' && was[1] === p.index)) continue;\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\n    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host's)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > src/net/peer.js <<'EOF'\n// Manual, serverless, ordered WebRTC. Only constructed outside AI Hub.\nexport class DirectPeer{\n constructor({onOpen,onMessage,onClose,onStatus}){Object.assign(this,{onOpen,onMessage,onClose,onStatus});this.pc=null;this.channel=null;this.role=null;this.generation=0;this.closed=false;this.timers=new Set();this.resultAck=null;}\n status(text){this.onStatus?.(text);}\n delay(fn,ms){const t=setTimeout(()=>{this.timers.delete(t);fn();},ms);this.timers.add(t);return t;}\n make(){\n  if(globalThis.AIHub?.active)throw Error('Direct peer is unavailable during a Hub round.');\n  this.close(false);this.closed=false;this.pc=new RTCPeerConnection({iceServers:[]});const generation=this.generation;\n  this.pc.onconnectionstatechange=()=>{if(generation\"'!==this.generation||!this.pc)return;const state=this.pc.connectionState;this.status(state==='\"'connected'?'Connected — two swarms, one garden':\"'`Connection: ${state}`);if(state==='\"'failed'||state==='closed')this.disconnected();if(state==='disconnected')this.delay(()=>{if(this.pc?.connectionState==='disconnected')this.disconnected();},1800);};\n  this.pc.ondatachannel=e=>this.wire(e.channel);return this.pc;\n }\n wire(channel){\n  this.channel=channel;channel.onopen=()=>{this.status('Connected');this.onOpen?.(this.role);};channel.onclose=()=>this.disconnected();\n  channel.onmessage=e=>{if(this.closed||typeof e.data\"'!=='\"'string'||e.data.length>16384)return;try{const data=JSON.parse(e.data);if(data.t==='ack'){this.resultAck?.();return;}if(data.t==='end'){this.send({t:'ack'});}this.onMessage?.(data);}catch{this.status('Ignored an invalid packet.');}};\n }\n disconnected(){if(this.closed)return;this.closed=true;this.onClose?.();}\n async gather(pc){\n  if(pc.iceGatheringState==='complete')return;\n  await new Promise(resolve=>{let complete=false;const done=()=>{if(complete)return;complete=true;pc.removeEventListener('icegatheringstatechange',check);resolve();};const check=()=>{if(pc.iceGatheringState==='complete')done();};pc.addEventListener('icegatheringstatechange',check);this.delay(done,4500);check();});\n }\n encode(desc){return 'BEE1.'+btoa(JSON.stringify({v:1,type:desc.type,sdp:desc.sdp}));}\n decode(code,type){\n  const text=String(code).trim();if(text.length>65000||text.length<30||\"'!text.startsWith('\"'BEE1.'))throw Error('That is not a garden code. Paste the complete BEE1 code.');\n  let data;try{data=JSON.parse(atob(text.slice(5)));}catch{throw Error('The code is damaged. Copy it again.');}\n  if(data.v\"'!==1||data.type!==type||typeof data.sdp!=='\"'string'||data.sdp.length>48000||\"'!data.sdp.startsWith('\"'v=0')||\"'!data.sdp.includes('\"'m=application'))throw Error(\"'`This step needs an ${type} code.`);\n  return {type:data.type,sdp:data.sdp};\n }\n async offer(){const pc=this.make();this.role='\"'host';this.wire(pc.createDataChannel('midnight-garden',{ordered:true}));await pc.setLocalDescription(await pc.createOffer());await this.gather(pc);if(this.pc\"'!==pc)throw Error('\"'Connection cancelled.');this.status('Offer ready. Send it to player 2.');return this.encode(pc.localDescription);}\n async answer(code){const desc=this.decode(code,'offer'),pc=this.make();this.role='guest';await pc.setRemoteDescription(desc);await pc.setLocalDescription(await pc.createAnswer());await this.gather(pc);if(this.pc\"'!==pc)throw Error('\"'Connection cancelled.');this.status('Answer ready. Return it to player 1.');return this.encode(pc.localDescription);}\n async accept(code){if(\"'!this.pc||this.role!=='\"'host')throw Error('Make an offer first.');const desc=this.decode(code,'answer');await this.pc.setRemoteDescription(desc);this.status('Answer accepted. Opening the garden…');}\n send(data){if(this.channel?.readyState==='open'&&this.channel.bufferedAmount<64000){this.channel.send(JSON.stringify(data));return true;}return false;}\n finish(data){\n  if(\"'!this.send(data))return Promise.resolve();return new Promise(resolve=>{let done=false;const end=()=>{if(done)return;done=true;this.resultAck=null;this.delay(()=>{this.close(false);resolve();},200);};this.resultAck=end;this.delay(end,1500);});\n }\n close(notify=true){this.closed=true;this.generation++;for(const t of this.timers)clearTimeout(t);this.timers.clear();if(this.channel){this.channel.onclose=null;this.channel.close();}if(this.pc){this.pc.onconnectionstatechange=null;this.pc.close();}this.channel=null;this.pc=null;if(notify)this.onClose?.();}\n}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport{readFileSync,writeFileSync,mkdirSync}from'node:fs';\nimport{spawnSync}from'node:child_process';\nimport{resolve,dirname}from'node:path';\nimport{fileURLToPath}from'node:url';\nconst root=resolve(dirname(fileURLToPath(import.meta.url)),'..');\nconst id=JSON.parse(readFileSync(resolve(root,'identity.json'),'utf8'));\nmkdirSync(resolve(root,'build'),{recursive:true});\nconst built=spawnSync('bun',['build','src/main.js','--target=browser','--format=iife','--outfile=build/game.js'],{cwd:root,encoding:'utf8'});if(built.status\"'!==0)throw Error(built.stderr||built.stdout);\nconst sdk=readFileSync(resolve(root,'\"'vendor/hub/session.js'),'utf8'),engine=readFileSync(resolve(root,'vendor/engine/my-3d2dge.js'),'utf8'),game=readFileSync(resolve(root,'build/game.js'),'utf8'),css=readFileSync(resolve(root,'src/style.css'),'utf8');\nconst safe=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst html=\"'`<!doctype html>'\"\\\\n<html lang=\\\"en\\\">\\\\n<head>\\\\n<meta charset=\\\"utf-8\\\">\\\\n<script>\"'${sdk}</script>'\"\\\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,viewport-fit=cover\\\">\\\\n<title>\"'${id.title}</title>'\"\\\\n<meta name=\\\"description\\\" content=\\\"Twelve tiny bees. One very late garden emergency. A complete moonlit arcade campaign for one or two swarms.\\\">\\\\n<meta name=\\\"theme-color\\\" content=\\\"#101f27\\\">\\\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\">\\\\n<meta name=\\\"hub:players\\\" content=\\\"1-2\\\">\\\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\\\n<meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\">\\\\n<meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\\\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"12\\\">\\\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Sting the clockwork gardeners, save your bees, and silence the Bellwether in six garden encounters.\\\">\\\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Move: left stick / WASD / arrows. Hold R2 / Shift to Focus. Cross / Space fires a horizontal ray. Kill a gardener to recharge. Touch: left drag, right hold, Ray button.\\\">\\\\n<style>\"'${css}</style>'\"\\\\n</head>\\\\n<body>\\\\n<canvas id=\\\"screen\\\" aria-label=\\\"\"'${id.title}: moonlit swarm arcade game\"></canvas>'\"\\\\n<script>\"'${safe(engine)}</script>'\"\\\\n<script>\"'${safe(game)}</script>'\"\\\\n</body>\\\\n</html>\\\\n\"'`;\nwriteFileSync(resolve(root,'\"'../',id.artifact),html);writeFileSync(resolve(root,'build/index.html'),html);\nconsole.log(\"'`Built ${id.artifact} (${(Buffer.byteLength(html)/1024).toFixed(0)} KiB)`);\nEOF\ncat > src/style.css <<'\"'EOF'\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#0c1922;overscroll-behavior:none;color:#f6e6be}body{position:relative}canvas#screen{display:block;width:100%;height:100%;touch-action:none;image-rendering:pixelated;outline:none}.esh{--ink:#f5e9cb;--accent:#eed195;--paper:#12232bf5;--line:#68867c66;--muted:#b9c7b8;--font:system-ui,sans-serif;--title:Georgia,serif}.esh .esh-pan{border-radius:2px;box-shadow:0 0 0 3px #111c25,0 0 0 4px #a38c6260,0 15px 60px #0008}.esh .esh-sh{background:#051018bb}.esh .esh-mod{width:min(610px,100%);padding:22px 26px}.esh .esh-m{font-size:14px;line-height:1.5}.esh .esh-k{font-size:12px;letter-spacing:.14em}.esh button{border-radius:2px;letter-spacing:.06em;font-size:14px;min-height:42px}.esh button:focus{outline:2px solid #f7df9c;outline-offset:3px}.esh button.pri{color:#15272b}.esh input[type=range]{width:155px}.esh textarea{box-sizing:border-box;display:block;width:100%;min-height:75px;resize:vertical;border:1px solid #829782;background:#09171f;color:#e8e7c5;border-radius:2px;margin:10px 0;padding:8px;font:12px/1.4 monospace;user-select:text;touch-action:auto}.esh .peer-note{font-size:12px;line-height:1.5;color:#c4cebb;margin:8px 0}.esh .peer-status{color:#f5d79c}.esh .source-text{white-space:pre-line;max-height:52vh;overflow:auto;font-size:14px}.esh .esh-bind{font-size:13px}button[data-act=ray]{border-radius:50%\"'!important;border-color:#cfb67f!important;color:#fff0bf!important;background:#1e3636dd!important;box-shadow:0 0 0 4px #15252555}body[data-mode=title] [data-sys=touch]{display:none!important}@media(max-width:600px){.esh .esh-mod{padding:15px 17px}.esh .esh-m{font-size:13px}.esh .esh-row>span{flex-basis:100px}.esh .esh-sh{padding-top:52px}.esh .esh-bind{grid-template-columns:1fr 70px 70px;gap:6px}.esh .esh-bind button{min-width:0;padding:6px 2px;font-size:10px}.esh .esh-nav{width:36px;height:36px;min-height:36px}.esh .source-text{max-height:48vh}}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
