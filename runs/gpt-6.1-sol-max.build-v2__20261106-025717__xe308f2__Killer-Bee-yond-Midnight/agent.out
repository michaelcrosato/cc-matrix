oom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n      this.focus(t.x + dir[0] * f.lead, (t.y || 0) + dir[1] * f.lead, (t.z || 0) + f.z);\n    }\n    this.particles.update(dt);\n    if (this.cam.free) this._freeCam(dt);\n    this._camStep(dt);\n  }\n  // a screen-pixel move [dx, dy] as the ground's (world x, y) at the zoom the player sees (during a zoom's preview, the goal)\n  _screenToGround(dx, dy) {\n    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n    return v.inv ? [(v.inv[0] * dx + v.inv[1] * dy) * k, (v.inv[2] * dx + v.inv[3] * dy) * k] : [dx / (v.ax || 1) * k, 0];\n  }\n  // cam.free: the keys and a stick, the screen's edges, a drag, a zoom toward its point; the focus kept to bounds\n  _freeCam(dt) {\n","exit_code":0,"status":"completed"}}
