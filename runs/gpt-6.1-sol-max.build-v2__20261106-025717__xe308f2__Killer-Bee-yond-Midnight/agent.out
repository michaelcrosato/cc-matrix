{"type":"item.started","item":{"id":"item_109","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tests/browser.py';s=open(p).read();needle=\\\"    check('visual fixtures have no collected drawing errors',page.evaluate('__midnight.game.errors.length === 0'),page.evaluate('__midnight.game.errors'))\\\\n\\\";insert=\\\"\\\"\\\"    # Inspect contact, recovery, formation size and ray readability together.\n    page.evaluate('''()=>{const a=__midnight;a.game.settings.set('motion',false);a.game.settings.set('flashes',.6);a.app.ui.hide();a.game.resume();a.loadStage(2);a.game.advance(.01,{draw:false});const s=a.app.world;s.targets=[];s.rivals=[];s.husks=[];s.queue=[{at:1e9,type:'left',entrance:0}];s.nextRival=1e9;s.time=120;s.stageTime=45;const base={r:7,hp:.7,maxHp:1.65,dir:0,turn:-1,lastContact:40,warning:0,contrib:[0,0],stuck:0,think:99,recovering:false,bossPhase:'move',bossT:0,circuit:0};s.targets=[{...base,id:900,type:'left',x:170,y:120},{...base,id:901,type:'right',x:284,y:160,recovering:true}];const rival={r:8,dir:0,warning:0,turn:20,want:0,matureAt:110};s.rivals=[{...rival,id:910,x:65,y:120,age:1,state:0},{...rival,id:911,x:250,y:60,age:15,state:1},{...rival,id:912,x:310,y:100,age:30,state:2}];s.husks=[{id:920,x:205,y:85,r:10.5,type:'right',born:100}];Object.assign(s.players[0],{x:168,y:120,bees:12,charge:1,inv:0});Object.assign(s.players[1],{x:220,y:120,bees:12,charge:1,inv:0});a.app.garden.reset(s);a.command(0,{x:0,y:0,focus:false,ray:s.players[0].lastRay+1});a.command(1,{x:0,y:0,focus:true,ray:s.players[1].lastRay});a.game.advance(1/120,{draw:true});}''')\n    page.screenshot(path=str(ROOT/'evidence/combat-cues.png'))\n    checkpoint=json.loads((ROOT/'evidence/final-checkpoint.json').read_text())\n    page.evaluate('''fixture=>{const a=__midnight;a.release();a.app.ui.hide();a.game.resume();a.app.world=fixture.world;a.app.display=null;a.app.lastPhase=null;a.app.bestSaved=false;a.app.inputGate=0;a.app.garden.reset(a.app.world);fixture.commands.forEach((c,i)=>a.command(i,c));}''',checkpoint)\n    tick(page,4.5)\n    check('packaged normal replay checkpoint reaches complete ending',page.evaluate('__midnight.app.world.phase === \\\"ending\\\" && __midnight.app.runMenu.items.join(\\\"|\\\") === \\\"Play again|Title\\\"'))\n    page.screenshot(path=str(ROOT/'evidence/ending.png'))\n    # Native anatomy/material sheets for future asset authoring.\n    page.evaluate('''()=>{const a=__midnight,g=a.game,E=My3D2dge,{px,font}=E;g.setZoom(1);g.cam.offset=null;g.cam.smooth=0;const left=new a.app.garden.rigs.GardenerRig('left'),right=new a.app.garden.rigs.GardenerRig('right'),bell=new a.app.garden.rigs.GardenerRig('bell'),base={hp:1,maxHp:1,warning:0,bossPhase:'open',bossT:1};for(const rig of [left,right,bell])rig.update(.1,base);g.start({update(){g.focus(g.W/2,g.H/2,0);},draw(r){r.sky(['#10222b','#10222b']);r.actor(70,82,0,(ctx,x,y)=>a.app.garden.rigs.bee(ctx,x,y,-.4,3.4,1));r.actor(175,82,0,(ctx,x,y)=>a.app.garden.rigs.bee(ctx,x,y,-.4,3.4,1,{body:'#b9decf',light:'#effff0',dark:'#3a6460'}));r.actor(280,82,0,(ctx,x,y)=>left.draw(ctx,x,y,{...r.view,zoom:2}));r.actor(375,82,0,(ctx,x,y)=>right.draw(ctx,x,y,{...r.view,zoom:2}));r.actor(485,82,0,(ctx,x,y)=>bell.draw(ctx,x,y,{...r.view,zoom:1.5}));r.shape('garden-bed',110,182,0,{params:{w:54,d:24}});r.shape('garden-dial',285,182,0);r.shape('garden-jewel',455,182,0,{scale:2});r.overlay(ctx=>{font.title(ctx,'MIDNIGHT / NATIVE ASSETS',r.W/2,14,{scale:2,align:'center',colors:['#fff1c8','#bc9d69']});for(const[label,x]of [['GOLD',70],['MINT',175],['LEFTENANT',280],['RIGHTO',375],['BELLWETHER',485]])font.text(ctx,label,x,125,'#c8d7bf',{align:'center',outline:false});for(const[label,x]of [['GLAZED BED',110],['NIGHT DIAL',285],['DEW TUNNEL',455]])font.text(ctx,label,x,220,'#c8d7bf',{align:'center',outline:false});font.text(ctx,'Segmented bodies / paired wings / native shaded volumes',r.W/2,278,'#b7c7b3',{align:'center',outline:false});});}});g.advance(.1,{draw:true});}''')\n    page.screenshot(path=str(ROOT/'evidence/asset-sheet.png'))\n    page.evaluate('''()=>{const g=__midnight.game,E=My3D2dge,{px,font}=E;const palettes=[['MOONFLOWER',['#101f25','#3c6760','#355952','#efc28b','#edcf86']],['GLASSHOUSE',['#171c2b','#53607b','#395e60','#bc9bd5','#b7d9dd']],['MIDNIGHT ORCHARD',['#181f29','#5c6465','#466154','#e3a5a3','#f3c47c']]];g.start({update(){g.focus(g.W/2,g.H/2,0);},draw(r){r.sky(['#0c1922','#0c1922']);r.overlay(ctx=>{font.title(ctx,'THE GARDEN PALETTES',r.W/2,15,{scale:2,align:'center',colors:['#fff0c5','#c3a470']});palettes.forEach(([name,colors],row)=>{const y=65+row*76;font.text(ctx,name,25,y,'#e5d7b2',{outline:false});colors.forEach((c,i)=>{const x=25+i*105;px.rect(ctx,x,y+16,86,28,c);font.text(ctx,c,x,y+49,'#bdcebd',{outline:false});});});});}});g.advance(.1,{draw:true});}''')\n    page.screenshot(path=str(ROOT/'evidence/palette-sheet.png'))\n\\\"\\\"\\\";assert needle in s;s=s.replace(needle,insert+needle);open(p,'w').write(s)\nPY\nbiome check --write src content tools/build.mjs tools/test.mjs tests/simulation.mjs package.json identity.json interview.json > build/lint.txt 2>&1\nhead -80 build/lint.txt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
