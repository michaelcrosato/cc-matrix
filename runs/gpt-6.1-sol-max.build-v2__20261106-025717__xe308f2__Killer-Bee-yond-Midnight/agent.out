cted.y+(p.y-predicted.y)*Math.min(1,dt*6);}else{out.x=was.x+(p.x-was.x)*rate;out.y=was.y+(p.y-was.y)*rate;}return out;});\n  display.players=smooth(oldPlayers,display.players,true);display.targets=smooth(oldTargets,display.targets);display.rivals=smooth(oldRivals,display.rivals);return display;\n }\n function finishHub(won){\n  if(\"'!info||!app.host||app.finished||app.ended)return;app.finished=true;\n  const ids=info.players.filter((p,i)=>app.world.players[i]?.joined).map(p=>p.id),scores=Object.fromEntries(ids.map(id=>[id,app.world.score]));hub.finish({standings:ids.length?[ids]:[],scores,won:!!won});\n }\n function saveBest(){if(app.attract||app.bestSaved||app.mode==='\"'hub')return;app.bestSaved=true;const key=app.world.assisted?'best:assisted':'best:clean',old=E.store.get(key,0);if(app.world.score>old)E.store.set(key,app.world.score);}\n function setPhaseUI(){\n  const s=app.world;if(app.lastPhase===s.phase&&app.lastStage===s.stage)return;\n  const previous=app.lastPhase;app.lastPhase=s.phase;app.lastStage=s.stage;app.runMenu=null;app.clearInput();\n  if(previous==='result'||previous==='failed')ui.hide();\n  if(s.phase==='failed'){\n   saveBest();if(app.mode==='hub'){finishHub(false);return;}\n   if(app.mode==='peer'&&\"'!app.host)return;\n   app.runMenu=makeMenu(['\"'Retry encounter','Restart campaign','Title'],i=>{if(i===0){retry(s);app.lastPhase=null;app.audio.reset(s);app.garden?.reset(s);app.clearInput();}else if(i===1){if(app.mode==='peer'){s.score=0;s.streak=0;s.assisted=true;enterStage(s,0);app.lastPhase=null;}else startRun(app.mode,s.players.length);}else{if(app.mode==='peer')app.peer?.finish({t:'end',won:false,score:s.score}).then(title);else title();}},Math.round(game.H/2+13));\n  }\n  if(s.phase==='ending'){\n   saveBest();if(app.mode==='hub'){finishHub(true);return;}\n   if(app.mode==='peer'&&app.host){app.finished=true;app.peer?.finish({t:'end',won:true,score:s.score});}\n   app.runMenu=makeMenu(['Play again','Title'],i=>i===0?startRun('solo',1):ti