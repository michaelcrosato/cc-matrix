],dangerD=near?distance(p,near):Infinity;\n  const targets=s.targets.filter(t=>t.warning<=0).sort((a,b)=>distance(a,p)-distance(b,p));\n  const wounded=targets.filter(t=>t.hp<t.maxHp*.7).sort((a,b)=>distance(a,p)-distance(b,p));\n  const t=wounded[0]||targets[p.id%Math.max(1,targets.length)];let goal=t?{x:t.x,y:t.y}:{x:192+Math.cos(s.time*.55+p.id*2)*125,y:120+Math.sin(s.time*.55+p.id*2)*78};\n  let focus=\"'!!t&&distance(p,t)<20&&(dangerD>43||p.charge);\n  let fire=!!p.charge&&danger.some(a=>Math.abs(a.y-p.y)<s.tuning.rayWidth+a.r-1&&distance(a,p)<115);\n  if(t?.type==='\"'bell'&&t.bossPhase\"'!=='\"'open'){\n    const escorts=targets.filter(a=>a.type\"'!=='\"'bell');\n    if(escorts.length){goal=escorts[0];focus=distance(p,goal)<18&&dangerD>40;}\n    else{const a=Math.atan2(p.y-t.y,p.x-t.x);goal={x:t.x+Math.cos(a)*50,y:t.y+Math.sin(a)*50};focus=false;}\n  }\n  if(near&&dangerD<58&&\"'!fire){\n    // With a charge, slide onto the threat'\"'s row. Without one, keep enough lateral room to escape.\n    if(p.charge&&dangerD>28){goal={x:p.x+(p.x>near.x?1:-1)*20,y:near.y};focus=false;}\n    else if(dangerD<40&&\"'!(t&&distance(p,t)<15&&t.hp<.3)){\n      let ax=p.x-near.x,ay=p.y-near.y;const dd=Math.hypot(ax,ay)||1;\n      goal={x:clamp(p.x+ax/dd*65,20,364),y:clamp(p.y+ay/dd*65,20,220)};focus=false;\n      if(distance(p,goal)<15){const sign=p.x<192?1:-1;goal={x:clamp(p.x-ay/dd*90*sign,20,364),y:clamp(p.y+ax/dd*90*sign,20,220)};}\n    }\n  }\n  const direct=Math.hypot(goal.x-p.x,goal.y-p.y),nx=(goal.x-p.x)/(direct||1),ny=(goal.y-p.y)/(direct||1);\n  let point=goal;\n  if(blocked(s,p.x+nx*14,p.y+ny*14,focus?8:footprint(p))||direct>24){\n    if(!memory.path||s.tick>memory.until||distance(goal,memory.goal||goal)>20){memory.path=route(s,p,goal,8,!p.charge&&dangerD<80);memory.until=s.tick+16;memory.goal={x:goal.x,y:goal.y};}\n    point=memory.path;\n    if(blocked(s,p.x+nx*6,p.y+ny*6,footprint({...p,focus:false})))focus=true;\n  }\n  const dx=point.x-p.x,dy=point.y-p.y,d=Math.hypot(dx,dy),speed=clamp(d/6,0,1);\n  return {x:dx/(d||1)*speed,y:dy/(d||1)*speed,focus,ray:p.lastRay+(fire?1:0)};\n}\nEOF\ncat > tools/balance.mjs <<'\"'EOF'\nimport {newWorld,step,invariants,validateStages} from '../src/sim/world.js';\nimport {pilot} from '../src/sim/bot.js';\nconst count=+(process.argv[2]||1),s=newWorld({players:count,seed:4117}),memory=Array.from({length:count},()=>({}));\nlet last=-1;\nconsole.log('Content:',validateStages());\nfor(let i=0;i<120*850;i++){\n const cmds=s.players.map((p,i)=>pilot(s,p,memory[i]));step(s,cmds);\n if(s.stage\"'!==last){last=s.stage;console.log('\"'Encounter',last+1,'at',s.time.toFixed(1),'score',s.score);}\n if(i%600===0){const issues=invariants(s);if(issues.length)throw Error(issues.join(','));}\n if(s.phase==='failed'||s.phase==='ending'){console.log(JSON.stringify({phase:s.phase,seconds:s.time,stage:s.stage+1,score:s.score,bees:s.players.map(p=>p.bees),stats:s.stats,targets:s.targets.map(t=>({type:t.type,hp:t.hp,x:t.x,y:t.y})),queue:s.queue.length},null,2));break;}\n if(i===120*850-1)console.log('TIMEOUT',JSON.stringify({stage:s.stage,targets:s.targets,players:s.players,stats:s.stats}));\n}\nEOF\nnode tools/balance.mjs\"","aggregated_output":"Content: []\nEncounter 1 at 0.0 score 0\nEncounter 2 at 80.8 score 1765\n{\n  \"phase\": \"failed\",\n  \"seconds\": 286.8749999999034,\n  \"stage\": 2,\n  \"score\": 2465,\n  \"bees\": [\n    0\n  ],\n  \"stats\": {\n    \"kills\": 10,\n    \"rays\": 6,\n    \"zaps\": 6,\n    \"losses\": 12,\n    \"focusTicks\": 6524,\n    \"contactTicks\": 2791,\n    \"recoveries\": 23,\n    \"maturations\": 7,\n    \"huskNudges\": 0,\n    \"bossExposures\": 0,\n    \"bossPulses\": 0,\n    \"clears\": 1,\n    \"refills\": 5\n  },\n  \"targets\": [\n    {\n      \"type\": \"right\",\n      \"hp\": 1.65,\n      \"x\": 66.64500328282003,\n      \"y\": 167.82536976011176\n    },\n    {\n      \"type\": \"left\",\n      \"hp\": 1.65,\n      \"x\": 334.3235510101005,\n      \"y\": 7.5378179292960