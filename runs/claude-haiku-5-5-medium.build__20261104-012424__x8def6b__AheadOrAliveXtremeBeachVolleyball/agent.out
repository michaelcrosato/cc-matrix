............................#', '#.a....b....c.....d.....e...f#', '#............................#', '#..g.g.g.....h....i......j...#', '#............................#', '#...k....l.....m.....n...o...#', '#............................#', '#............................#', '##############################'];\nG.PLACES.casino.legend = { '#': 1, '.': { floor: 'carpet' }, a: 'cashier', b: 'slot_1', c: 'slot_2', d: 'slot_3', e: 'blackjack', f: 'roulette', g: 'npc_slots', h: 'npc_bar', i: 'npc_roulette', j: 'prize', k: 'npc_slots', l: 'npc_roulette', m: 'npc_bar', n: 'vip', o: 'npc_slots' };\nG.PLACES.beach.entry = [3, 9];\nG.PLACES.pool.entry = [2, 10];\nG.PLACES.promenade.entry = [8, 6];\nG.PLACES.villa.entry = [6, 7];\nG.PLACES.casino.entry = [14, 9];\nEOF\nnode --check src/04-data-world.js && echo ok","description":"Add walkable room maps for pool, promenade, villa and casino"}},"wire_ingest_context":{"toolu_01Y1igJvu6QxUfVX1VKL5RfK":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-012424__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-haiku-5-5-medium-20261104-012424"}}}
