ssed('tabR') || I.pressed('right')) this.page = Math.min(n - 1, this.page + 1);\n    if (I.pressed('tabL') || I.pressed('left')) this.page = Math.max(0, this.page - 1);\n    this.scroll = Math.max(0, (this.scroll || 0) + (I.repeat('down', .2, .05) ? 1 : 0) - (I.repeat('up', .2, .05) ? 1 : 0));\n  },\n  draw(r) {\n    const W = r.W, H = r.H, pg = G.ABOUT.pages[this.page] || { title: '', lines: [] };\n    this.bg.draw(r);\n    G.screenTitle(r, 'ABOUT & CREDITS', (this.page + 1) + ' / ' + G.ABOUT.pages.length + ' · ' + pg.title);\n    r.overlay(g => {\n      E.ui.box(g, 16, 50, W - 32, H - 98, { bg: ['#0f4c5c', '#0a2d3d'], border: '#f6d38a', alpha: .92 });\n      let y = 60 - (this.scroll || 0) * 8;\n      for (const ln of pg.lines) {\n        for (const w of G.wrapText(ln, W - 60, 1)) { if (y > 46 && y < H - 60) E.font.text(g, w, 26, y, '#fff8e8', { scale: 1, shadow: '#000' }); y += 10; }\n        y += 3;\n      }\n    });\n    G.promptBar(r, [['tabL', 'Back'], ['tabR', 'Next'], ['cancel', 'Close']]);\n  }\n};\nEOF\ncat > src/51-attract.js <<'EOF'\n/* 51-attract: the arcade demo. After ten seconds idle on the title or the menu, a match plays itself (AI against AI, perfect\n * spectacle play, the camera cutting between the broadcast and the serve), then a title card; any input exits it. */\nG.attractScene = {\n  enter() {\n    this.t = 0; this.phase = 'match'; this.bg = new E.Backdrop('dusk');\n    const ids = G.FIGHTERS.slice().sort(() => G.rng('cosmetic') - .5);\n    const suits = ['seigaiha', 'estrella', 'fjord', 'kentepop', 'reefbreak', 'peony'];\n    const teams = [[{ id: ids[0], suit: suits[0], base: .66 }, { id: ids[1], suit: suits[1], base: .66 }], [{ id: ids[2], suit: suits[2], base: .66 }, { id: ids[3], suit: suits[3], base: .66 }]];\n    this.M = G.createMatch({ teams, pointsToWin: 7, setsToWin: 1, difficulty: 'easy', court: ['day', 'sunset', 'night'][Math.floor(G.rng('cosmetic') * 3)], serveSide: 0, spectacle: true, attract: true });\n    this.M.attract = true;\n    this.M.rngOff = true;\n    G.game.setView(G.courtView());\n    G.game.follow(null);\n    G.music('spike');\n    this.matchT = 0;\n  },\n  update(dt) {\n    const I = G.game.input;\n    this.t += dt;\n    if (I.anyPressed && I.anyPressed()) { return G.game.go('title', {}); }\n    if (this.phase === 'match') {\n      const M = this.M;\n      // the demo's AI plays perfectly: the spectacle comes from the planner's own choices\n      for (const p of M.players) p.skill = .95;\n      M.step(dt);\n      if (M.phase === 'over' || M.over || this.t > 55) { this.phase = 'card'; this.t = 0; }\n    } else if (this.t > 5) G.game.go('title', {});\n    if (this.M && this.phase === 'match') { const pts = []; if (this.M.L) { const s = G.flightAt(this.M.L, this.M.t); pts.push({ x: s.x, y: s.y, z: Math.max(0, s.z) }); } for (const p of this.M.players) pts.push({ x: p.x, y: p.y, z: 0 }); const C = G.C; pts.push({ x: C.X0 - 26, y: C.Y0 - 30, z: 0 }, { x: C.X1 + 26, y: C.Y1 + 30, z: 0 }); G.game.cam.frame(pts, { margin: 16, zoom: [.6, 1] }); }\n  },\n  draw(r) {\n    const W = r.W, H = r.H;\n    if (this.phase === 'match' && this.M) {\n      this.bg.draw(r);\n      G.courtMap().drawFloor(r); G.drawCourtSet(r, 'sunset'); G.drawNet(r);\n      this.M.drawPlayers(r); this.M.drawBall(r);\n      this.M.hud(r);\n      r.overlay(g => E.font.text(g, 'DEMO', 6, H - 26, '#ffd36a', { shadow: '#000' }));\n    } else {\n      this.bg.draw(r);\n      r.overlay(g => { E.font.title(g, 'AHEAD OR ALIVE', W / 2, H * .3, { scale: 3, align: 'center', colors: ['#fff7d6', '#ffd36a'] }); E.font.text(g, 'PRESS ANY BUTTON', W / 2, H * .6, '#fff8e8', { align: 'center', shadow: '#000' }); });\n    }\n    G.promptBar(r, [['confirm', 'Press any button']]);\n  }\n};\nEOF\nnode --check src/50b-pages.js && node --check src/51-attract.js && echo ok","description":"Write How to Play, About pages and the attract demo"}},"wire_ingest_context":{"toolu_01NAGjZDNGucwqmstRUrnVoX":{"cwd":"/home/micha/dev/cc-matrix/runs/c