and back\n  const inst = G.poolLive;\n  c('pool hop has a live state to test', !!inst, 'missing');\n  if (inst) {\n    inst.start();\n    inst.slip('test');\n    c('a slip puts the hopper in the slip state', inst.state === 'slip');\n    game.advance(2.2);\n    c('the hopper recovers after the slip', inst.state === 'run', inst.state);\n    c('time keeps running while the hopper recovers', inst.timeLeft < G.T.poolTime);\n  }\n};\n// ---- playthrough (the first days, human-driven by a timing bot) ----`);\nedit('src/40-poolhop.js', \"G.poolScene = {\\n  enter(data) {\\n    this.from = data.from || 'map';\", \"G.poolScene = {\\n  enter(data) {\\n    G.poolLive = this;\\n    this.from = data.from || 'map';\");\nedit('test/run.mjs', \"const names = Object.keys(suites)\", \"suites.poolhop_unused = null;\\nconst names = Object.keys(suites)\");\nconsole.log('ok');\nEOF\nnode .tmp/p20.mjs && rm .tmp/p20.mjs && sed -i 's/^suites.poolhop_unused = null;$//' test/run.mjs && node tools/build.mjs | tail -1 && timeout 600 node test/run.mjs --skip-browser --only=poolhop,game 2>&1 | tail -4","description":"Add the browser check and a Pool Hop recovery test"}},"wire_ingest_context":{"toolu_01MKWbhooTFyc5wR4Ry5Uo4o":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-012424__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-haiku-5-5-medium-20261104-012424"}}}
