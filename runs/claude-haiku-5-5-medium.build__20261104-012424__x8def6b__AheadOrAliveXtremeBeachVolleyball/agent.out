ide === 0 ? 40 : G.C.NET_X + 6, me.side === 0 ? G.C.NET_X - 6 : 668);\\n    H.me.y = G.clamp(H.me.y, 112, 432);\\n    me.x = H.me.x; me.y = H.me.y; me.facing = H.facing || me.facing;\\n  }\\n  H.moveT = (H.moveT || 0) - dt;\\n  if (H.moveT <= 0) { H.moveT = 1 / 12; AIHub.send({ t: 'm', m: I.move(), x: H.me ? H.me.x : 0, y: H.me ? H.me.y : 0 }, { reliable: false }); }\");\nconsole.log('done, fails ' + fails);\nEOF\nnode /tmp/aoa-mv.mjs \"$PWD\" && rm /tmp/aoa-mv.mjs && node tools/build.mjs | tail -1 && (timeout 700 node tools/hub-check.mjs 4 standard 150 50 5 | tail -2); (timeout 700 node tools/hub-check.mjs 2 server | tail -1); (timeout 700 node tools/hub-check.mjs 2 host-leave | tail -1); (timeout 700 node tools/hub-check.mjs 1 standard | tail -1)","description":"Let each client move its own fighter and have the host place it, then rerun the hub scenarios"}},"wire_ingest_context":{"toolu_01VfHkimkaxiYrKHT2cZRsrH":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-012424__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-haiku-5-5-medium-20261104-012424"}}}
