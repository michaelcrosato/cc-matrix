ight into the hub card, with no pause, corner, saves or title\nedit('src/99-main.js', \"G.boot = function () {\\n  G.loadTuning();\", \"G.boot = function () {\\n  G.loadTuning();\\n  const session = G.inSession();\");\nedit('src/99-main.js', \"  G.game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', bg: '#0a2d3d', id: 'ahead-or-alive', autoPause: true, corner: true,\\n    fullscreen: true, minW: 300, minH: 190,\\n    menu: { items, settings, quit: 'title', saves: true } });\",\n\"  G.game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', bg: '#0a2d3d', id: 'ahead-or-alive', autoPause: !session, corner: !session,\\n    fullscreen: !session, minW: 300, minH: 190,\\n    menu: session ? false : { items, settings, quit: 'title', saves: true } });\");\nedit('src/99-main.js', \"  G.game.start({ scenes: G.scenes(), scene: 'title',\", \"  G.game.start({ scenes: G.scenes(), scene: session ? 'hub' : 'title',\");\nedit('src/99-main.js', \"  G.curScene = 'title';\\n  return G.game;\", \"  G.curScene = session ? 'hub' : 'title';\\n  return G.game;\");\nedit('src/99-main.js', \"    vacresult: Object.assign({}, G.vacresultScene, { input: menuMap })\", \"    vacresult: Object.assign({}, G.vacresultScene, { input: menuMap }),\\n    hub: Object.assign({}, G.hubScene, { input: G.matchKeys })\");\nedit('src/99-main.js', \"  const menuMap = G.menuKeys;\", \"  const menuMap = G.menuKeys;   // (every menu screen shares the same keys)\");\nconsole.log('ok');\nEOF\nnode .tmp/p7.mjs && rm .tmp/p7.mjs && node tools/build.mjs | tail -1","description":"Fix hub clock, remote input, standings and session boot"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8663,"cache_read_input_tokens":424464,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8663},"output_tokens":5,"service_tier":"standard","in