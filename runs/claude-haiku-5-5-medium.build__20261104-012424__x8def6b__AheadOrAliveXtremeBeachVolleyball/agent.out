|| []).length;\\n    G.screenTitle(r, 'BEACH MATCH', n > 1 ? n + ' players: P2 takes the partner seat, P3 and P4 the other side' : 'Pick your fighter, the rules and the court · press Start to join');\");\n// the serve cam: V (or the right stick click) toggles the match camera\nedit('src/26-matchscene.js', \"  update(dt) {\\n    const M = this.M;\\n    if (!M) return;\\n    if (M.over && M.phase === 'over') return;\\n    M.step(dt);\", \"  update(dt) {\\n    const M = this.M;\\n    if (!M) return;\\n    if (M.over && M.phase === 'over') return;\\n    if (M.players.some(p => p.human && p.human.pressed && p.human.pressed('view'))) { this.serveCam = !this.serveCam; G.game.setView(this.serveCam ? G.serveCamView() : G.courtView()); G.toast(this.serveCam ? 'Serve Cam' : 'Broadcast'); }\\n    M.step(dt);\");\nedit('src/26-matchscene.js', \"G.courtView = function () { if (!G._courtView) G._courtView = new E.View('court', 'Broadcast', 0, 32, 1.5, 1); return G._courtView; };\", \"G.courtView = function () { if (!G._courtView) G._courtView = new E.View('court', 'Broadcast', 0, 32, 1.5, 1); return G._courtView; };\\nG.serveCamView = function () { if (!G._serveCam) G._serveCam = new E.View('servecam', 'Serve Cam', 90, 46, 1.5, 1); return G._serveCam; };\");\n// pool hop: a wobble pad flips between its two buttons until the last beat\nedit('src/40-poolhop.js', \"      const act = p.double ? p.double[0] : p.btn;\", \"      const flip = p.wobble && i === this.at && this.nextBeat - this.t > this.beat * .5 && Math.floor(this.t * 6) % 2 === 1;\\n      const act = p.double ? p.double[0] : flip ? { hopA: 'hopB', hopB: 'hopA', hopX: 'hopY', hopY: 'hopX' }[p.btn] : p.btn;\");\n// the touch-only gate: a centred panel with the Settings button; the attract still runs\nedit('src/50-title.js', \"G.latestSave = function\", \"/* the touch-only gate: a device with a touch screen and no key or pad yet gets this panel instead of touch controls */\\nG.touchGate = function (r) {\\n  const W = r.W, H =