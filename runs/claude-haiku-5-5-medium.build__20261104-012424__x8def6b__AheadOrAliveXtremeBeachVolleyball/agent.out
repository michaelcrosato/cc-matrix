, 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  fire: ['Space', 'KeyZ', 'KeyJ', 'Mouse0', 'Pad0', 'Pad7'], bomb: ['KeyX', 'KeyK', 'Mouse2', 'Pad1', 'Pad6'], ...MENU_KEYS\n};\nE.Input = Input;\n\n848:  /** switch key layout at runtime: input.use(E.Input.PLATFORMER) or input.use('SHMUP'). The player's own bindings\n849:   *  (bindings, set by rebind() and the Controls screen) are laid over it. Every preset (E.Input.DEFAULT, PLATFORMER,\n866:    /** preset: the layout last given to use() (E.Input.DEFAULT, PLATFORMER, SHMUP or your own) */\n1014:  _check(a) { if (!this.map[a]) warn('action:' + a, 'unknown input action \"' + a + '\". Known actions: ' + Object.keys(this.map).join(', ') + '. Add your own with new E.Game({ input: { ...E.Input.\n1299:E.Input = Input;\n60: *    steps at once, game.input.tap('jump') and hold('right') script input, game.debug = { snapshot() { ... } } is\n268: * melee auto-aim, lock-on, takedowns, interaction prompts. o: { range, arc (half angle around facing, radians; default all\n770:     *  sharing it, each with half its keys: game.players) */\n772:    /** touchEnabled: false turns the touch stick off; stickSide: 'left' or 'right', the half of the screen the stick\n809:      const share = this.keysTo && this.keysTo.filter(q => q._codes[e.code]);   // (players sharing the keyboard: each answers to its half)\n827:      if (e.pointerType !== 'mouse') this.lastDevice = 'touch';   // any touch, on the stick's half or not: prompts follow it","is_error":false}]},"parent_tool_use_id":null,"session_id":"68c96722-ff85-4e7d-8e61-8c2d4dde53f4","uuid":"ac5cd104-7e37-4f0f-861e-491e77e6d7d1","timestamp":"2026-11-04T08:27:11.624Z","tool_use_result":{"stdout":"Input.DEFAULT = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  attack: ['KeyJ', 'KeyX', 'Mouse0', 'Pad0', 'Pad7'], dash: ['Space', 'ShiftLeft', 'Shi