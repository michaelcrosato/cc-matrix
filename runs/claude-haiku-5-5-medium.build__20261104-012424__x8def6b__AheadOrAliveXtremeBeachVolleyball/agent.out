 const dur = c.dur || 1;\n  rig.mocap = lib.sample(c, c.loop ? t % dur : Math.min(t, dur * .999));\n  rig.mocapW = 1;\n};\nEOF\nnode tools/build.mjs | tail -1 && cat > .tmp-t.mjs <<'EOF'\nimport { load } from './test/lib/load.mjs';\nconst { ctx, E, G } = load();\nconsole.log('Mocap', typeof ctx.Mocap, 'MOCAP', typeof ctx.MOCAP, Object.keys(ctx.MOCAP || {}));\nconst lib = ctx.Mocap.load(ctx.MOCAP.AOA); console.log('clips', Object.keys(lib.clips || lib._clips || {}).length, !!lib.clip('Victory'));\nEOF\nnode .tmp-t.mjs 2>&1 | head -5; rm .tmp-t.mjs","description":"Write the clip helpers and check the mocap library loads headless"}},"wire_ingest_context":{"toolu_01MjtEFYiL4hLGNx32NaAiE4":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-012424__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-haiku-5-5-medium-20261104-012424"}}}
