ous events.')}<div class=\"family-roster\">${app.medley.members.map((member,index)=>`<span class=\"badge\">${familyName(member,index)} · ${member.kind==='pad'?`PAD ${member.index+1}`:member.kind.toUpperCase()}</span>`).join('')||'<span class=\"badge\">NO PLAYERS YET</span>'}</div><div class=\"menu\">${button('Join with keyboard','family-join','', 'ghost')}${button('Add a bot','family-bot','', 'ghost')}${button('Start the medley','family-start',app.medley.members.length?'':'disabled','primary')}</div><p class=\"family-help\">ENTER: join keyboard · CROSS / A: join controller<br>SPACE / OPTIONS: start · B: add bot</p>${footer()}`);\n64:    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','A little wobble is better together.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">${familyName(app.medley.members[entry.index],entry.index)}</span><span class=\"sub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n83:function begin(activity,options={}){\n86:function finish(){\n97:function startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\n100:function act(action,element){\n117:  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n132:function pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\n133:window.addEventListener('keydown',event=>{if(app.hubClosed)return;const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;if(app.screen==='hub-card'&&(key==='enter'||key==='m')){event.preventDefault();globalThis.AIHub?.answer(key==='m'?'more':'ready');return;}app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\n140:function gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen==='hub-card'&&just(3))globalThis.AIHub?.answer('more');if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\n157:function frame(now){\n185:function beginHubEvent(index){app.hubEvent=index;const activity=ACTIVITIES.find(item=>item.id===app.hubPicks[index]);begin(activity,{duration:EVENT_SECONDS,random:globalThis.AIHub.rng(`event:${index}`),hard:false,tuning:{...DEFAULT_TUNABLES,timeScale:1}});}\n186:function finishHub(){if(!app.hubRound||app.hubEnded)return;const score=hubScore();app.hubEnded=true;app.hubRound=false;clearInterval(app.hubTimer);globalThis.AIHub.result({score});app.result={score};go('hub-finished');}\n201:window.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\n","exit_code":0,"status":"completed"}}
