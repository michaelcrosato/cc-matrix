{"type":"item.started","item":{"id":"item_404","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -n 'function (setupHub|advanceHub|frame|gamepad|finish|begin|activityCue)|hub-|hubRound|addEventListener\\\\(.keydown|const app=|__GAME__' \\\"\"'$DEV/src/main.js\"; cat \"$DEV/src/data/activities.js\"; sed -n '\"'1,150p' \\\"\"'$DEV/src/core/session.js\"; rg -n '\"'rng\\\\(|function rng|send\\\\(|ready\\\\(|connect\\\\(' \\\"\"'$DEV/vendor/hub/session.js\" | head -35'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
