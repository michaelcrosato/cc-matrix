)-Number(app.keys.has('a')||app.keys.has('arrowleft'));let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.keys.has('w')||app.keys.has('arrowup'));if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}if(app.attract){const time=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(Math.floor(time*3)%2===0)app.input.left=true;else app.input.right=true;}if(app.driver==='perfect'){x=0;y=0;}app.session.update(dt,{x,y,breath:app.keys.has(' ')||\"'!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;const dot=document.getElementById('\"'balance-dot'),seconds=document.getElementById('seconds'),meter=document.getElementById('meter'),score=document.getElementById('live-score');if(dot){dot.style.left=\"'`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));if(meter)meter.style.width=`${Math.min(100,app.session.elapsed/app.session.duration*100)}%`;if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'\"'KEEP GOING'}\"'`;if(app.hubRound&&now-app.hubClock>500){app.hubClock=now;const partial=app.hubTotal+app.session.result().score;globalThis.AIHub?.progress({score:partial,label:app.activity.name});globalThis.AIHub?.send({x:app.session.dot.x,y:app.session.dot.y,score:partial});}if(app.session.finished)finish();}requestAnimationFrame(frame);}\n+\n+function advanceHub(){if(app.hubEnded)return;app.hubTotal+=app.session.result().score;app.hubEvent++;if(app.hubEvent>=3){app.hubEnded=true;globalThis.AIHub?.result({score:app.hubTotal});app.result={...app.session.result(),score:app.hubTotal,stars:0,drips:0};app.hubRound=false;go('\"'results');}else begin({...ACTIVITIES.find(item=>item.id===['tree','hoop','step'][app.hubEvent])},{duration:20});}\n+function setupHub(){const hub=globalThis.AIHub;if(\"'!hub?.active)return;hub.on('\"'card',()=>go('hub-card'));hub.on('start',()=>{app.hubRound=true;app.hubEnded=false;app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&\"'!app.hubEnded){app.hubEnded=true;hub.result({score:app.hubTotal+(app.session?.result().score||0)});app.hubRound=false;}});hub.on('\"'end',()=>{app.hubRound=false;app.hubEnded=true;});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.ready();}\n+window.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\n+render();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\n*** End Patch\nPATCH\n# The standalone artifact must not depend on external font downloads.\napply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: src/ui/style.css\n@@\n-@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&display=swap');\n*** End Patch\nPATCH\nnpm run build\"","aggregated_output":"Success. Updated the following files:\nA src/data/about.js\nA src/main.js\nSuccess. Updated the following files:\nM src/ui/style.css\n\n> a-little-off-balance@1.0.0 build\n> node tools/build.mj