{"type":"item.started","item":{"id":"item_421","type":"command_execution","command":"/bin/bash -lc \"sed -n '300,370p' 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/vendor/hub/README.md'; python3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom urllib.parse import quote, urlencode\nbase='http://127.0.0.1:39559/'\ndev='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'\ngame='/' + dev + '.html'\nwith sync_playwright() as playwright:\n browser=playwright.chromium.launch(headless=True,args=['--no-sandbox'])\n for players,scenario in [(1,None),(2,None),(4,None),(4,'host-leave')]:\n  page=browser.new_page()\n  query={'game':game,'auto':'1','players':str(players)}\n  if scenario: query['scenario']=scenario\n  if players==4: query.update(latency='150',jitter='50',loss='5')\n  url=base+quote(dev)+'/vendor/hub/harness.html?'+urlencode(query)\n  try:\n   page.goto(url)\n   page.wait_for_function(\\\"document.body.dataset.complete === 'true'\\\",timeout=90000)\n   print('CASE',players,scenario,page.evaluate('JSON.stringify(window.__hubCheck)'),flush=True)\n  except Exception as error:\n   print('CASE',players,scenario,'ERROR',str(error),flush=True)\n  page.close()\n browser.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
