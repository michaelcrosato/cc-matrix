t=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(\"'!['\"'INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\n*** End Patch\nPATCH\"","aggregated_output":"Success. Updated the following files:\nA src/ui/overrides.css\nM src/main.js\nM src/core/session.js\nM tools/build.mjs\nSuccess. Updated the following files:\nM src/main.js\n","exit_code":0,"status":"completed"}}
