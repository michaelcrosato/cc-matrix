{"type":"item.completed","item":{"id":"item_453","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; cat \\\"\"'$DEV/src/ui/overrides.css\"; printf '\"'\\\\n--- game markup ---\\\\n'; rg -n 'game-hint|gameHint|WASD|F / J|kbd|controls' \\\"\"'$DEV/src/main.js\" \"$DEV/src/ui/style.css\"; printf '\"'\\\\n--- test code ---\\\\n'; sed -n '1,260p' \\\"\"'$DEV/tests/browser.py\"; printf '\"'\\\\n--- test runner ---\\\\n'; cat \\\"\"'$DEV/tests/run.mjs\"'","aggregated_output":".title-screen .glass{padding:clamp(20px,2.5vw,32px)}\n.title{font-size:clamp(48px,5vw,72px);margin:20px 0 12px}\n.title-screen .menu{margin-top:16px}\n.title-screen .footnote{margin-top:14px}\n.game-tip strong{color:#436d5d;letter-spacing:.03em}\n.ghost-dot{position:absolute;width:14px;height:14px;margin:-7px;border:2px solid white;border-radius:50%;background:#738dd4;opacity:.75;z-index:2;pointer-events:none}\n@media(max-width:700px){.title{font-size:clamp(46px,12vw,66px)}.title-screen .glass{padding:22px}}\n\n--- game markup ---\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js:40:    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',escape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to breathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','start','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js:43:    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js:147:  if(activity.family==='slack')return 'F / J TO WALK THE LINE';\n\n--- test code ---\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef complete_week(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        start_profile(page)\n        click(page, 'weigh')\n        for _ in range(3):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n        screen(page, 'weigh-result')\n        assert len(state(page)['profiles'][0]['history']) == 3\n        click(page, 'island')\n        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\n            assert state(page)['day'] == day\n        click(page, 'finale')\n        click(page, 'start')\n        finish(page)\n        screen(page, 'reveal')\n        assert state(page)['profiles'][0]['revealed'] is True\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef family(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        click(page, 'family')\n        click(page, 'family-start', '[data-count=\"2\"]')\n        for _ in range(6):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        screen(page, 'medley-board')\n        assert page.get_by_text('PLAYER 1', exact=True).count() == 1\n        assert page.get_by_text('PLAYER 2', exact=True).count() == 1\n    finally:\n        browser.close()\n\n\ndef mobile(playwright, url):\n    browser = playwright.webkit.launch(headless=True)\n    context = browser.new_context(**playwright.devices['iPhone 17 Pro'])\n    page = context.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        assert page.get_by_text('Controller or keyboard required').is_visible()\n        assert page.locator('[data-action=\"slots\"]').count() == 0\n        click(page, 'settings')\n        assert page.locator('#music').input_value() == '0.1'\n    finally:\n        context.close()\n        browser.close()\n\n\ndef attract(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_function('window.__GAME__.state().attract', timeout=13000)\n        page.keyboard.press('Enter')\n        screen(page, 'title')\n    finally:\n        browser.close()\n\n\ndef webgpu(playwright, url):\n    browser = playwright.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-angle=swiftshader', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_selector('#world canvas', timeout=12000)\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthreading.Thread(target=server.serve_forever, daemon=True).start()\nurl = f'http://127.0.0.1:{server.server_port}/' + urllib.parse.quote(FILENAME)\ntry:\n    with sync_playwright() as playwright:\n        for name in ('chromium', 'firefox', 'webkit'):\n            check(name + ' profile, activity, persistence', lambda name=name: smoke(getattr(playwright, name), url))\n        check('seven-day playthrough and all activities', lambda: complete_week(playwright.chromium, url))\n        check('family medley', lambda: family(playwright.chromium, url))\n        check('touch-only notice', lambda: mobile(playwright, url))\n        check('idle attract and wake', lambda: attract(playwright.chromium, url))\n        check('WebGPU island', lambda: webgpu(playwright, url))\nfinally:\n    server.shutdown()\nprint(json.dumps({'passed': passed, 'failures': failures}))\n\n--- test runner ---\nimport assert from 'node:assert/strict';\nimport { spawnSync } from 'node:child_process';\nimport { ACTIVITIES, activityForDay } from '../src/data/activities.js';\nimport { Dot, DEFAULT_TUNABLES } from '../src/core/dot.js';\nimport { ActivitySession, makeProfile, wobbleAge } from '../src/core/session.js';\nimport { MEDLEY_SECONDS, medleyWindow, pickMedley } from '../src/data/medley.js';\n\nlet passed = 0;\nconst failures = [];\nfunction test(name, check) {\n  try { check(); passed++; } catch (error) { failures.push(`${name}: ${error.stack || error}`); }\n}\n\ntest('activity catalog and unlocks', () => {\n  assert.equal(ACTIVITIES.length, 16);\n  assert.equal(new Set(ACTIVITIES.map(activity => activity.id)).size, 16);\n  assert.equal(activityForDay(1).length, 4);\n  assert.equal(activityForDay(5).length, 16);\n  assert.equal(activityForDay(7).length, 16);\n});\n\ntest('dot stays finite and bounded', () => {\n  const first = new Dot(() => .25), second = new Dot(() => .25);\n  for (let index = 0; index < 5000; index++) {\n    first.step(.05, Math.sin(index), Math.cos(index), DEFAULT_TUNABLES);\n    second.step(.05, Math.sin(index), Math.cos(index), DEFAULT_TUNABLES);\n    assert.ok(Number.isFinite(first.x) && Number.isFinite(first.y));\n    assert.ok(Math.hypot(first.x, first.y) <= 1.20000001);\n  }\n  assert.deepEqual(first, second);\n});\n\ntest('wobble age reveal corrects seven years', () => {\n  const profile = makeProfile('MABEL');\n  profile.history = [.6, .7, .8];\n  profile.stars = 8;\n  const before = wobbleAge(profile);\n  profile.revealed = true;\n  assert.equal(before - wobbleAge(profile), 7);\n});\n\nfor (const activity of ACTIVITIES) {\n  test(`${activity.id} completes with valid score`, () => {\n    const session = new ActivitySession(activity, { random: () => .25 });\n    for (let frame = 0; !session.finished && frame < 2000; frame++) {\n      const angle = frame * .4;\n      session.update(.05, { x: Math.cos(angle), y: Math.sin(angle), breath: frame % 40 < 20, left: frame % 14 === 0, right: frame % 14 === 7 });\n    }\n    assert.equal(session.finished, true);\n    assert.ok(session.result().score >= 0 && session.result().score <= 100);\n    assert.ok(session.result().stars >= 0 && session.result().stars <= 3);\n    const elapsed = session.elapsed;\n    session.update(.05, {});\n    assert.equal(session.elapsed, elapsed);\n  });\n}\n\ntest('live time tuning changes simulation speed', () => {\n  const normal = new ActivitySession(ACTIVITIES[0], { random: () => 0 });\n  const fast = new ActivitySession(ACTIVITIES[0], { random: () => 0, tuning: { timeScale: 2 } });\n  normal.update(.02); fast.update(.02);\n  assert.equal(fast.elapsed, normal.elapsed * 2);\n});\n\ntest('online medley choices and shared-clock windows', () => {\n  assert.deepEqual(pickMedley(() => 0), ['tree', 'squats', 'header']);\n  assert.deepEqual(pickMedley(() => .999), ['warrior', 'step', 'header']);\n  assert.deepEqual(medleyWindow(-3000), { phase: 'countdown', index: 0, remaining: 3 });\n  assert.deepEqual(medleyWindow(0), { phase: 'event', index: 0, remaining: 55 });\n  assert.deepEqual(medleyWindow(55000), { phase: 'break', index: 0, remaining: 10 });\n  assert.deepEqual(medleyWindow(65000), { phase: 'event', index: 1, remaining: 55 });\n  assert.deepEqual(medleyWindow(120000), { phase: 'break', index: 1, remaining: 10 });\n  assert.deepEqual(medleyWindow(130000), { phase: 'event', index: 2, remaining: 55 });\n  assert.equal(MEDLEY_SECONDS, 185);\n  assert.equal(medleyWindow(185000).phase, 'finished');\n});\n\nconst browser = spawnSync('python3', ['tests/browser.py'], { encoding: 'utf8', env: process.env, timeout: 180000 });\nif (browser.error || browser.status !== 0) {\n  failures.push(`browser runner: ${browser.error?.message || browser.stderr || browser.stdout || `exit ${browser.status}`}`);\n} else {\n  try {\n    const report = JSON.parse(browser.stdout);\n    passed += report.passed;\n    failures.push(...report.failures);\n  } catch (error) { failures.push(`browser report: ${error.message}\\n${browser.stdout}\\n${browser.stderr}`); }\n}\nfor (const failure of failures) console.error(`FAIL ${failure}`);\nconsole.log(`${passed} passed, ${failures.length} failed`);\nif (failures.length) process.exitCode = 1;\n","exit_code":0,"status":"completed"}}
