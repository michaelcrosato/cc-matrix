contrast</label><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js-68-    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER TOOLS':'YOUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\"stack\">${ranges}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js-69-  }else if(app.screen==='about'){\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js-70-    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js:71:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful tribute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: ${value}`))}${section('Testing Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt Feedback',about.promptFeedback)}</div>${footer()}`);\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js-72-  }else if(app.screen==='hub-card'){\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js-73- 