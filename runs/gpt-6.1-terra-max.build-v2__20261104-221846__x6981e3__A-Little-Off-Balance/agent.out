{"type":"item.started","item":{"id":"item_147","type":"command_execution","command":"/bin/bash -lc \"D='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -n 'message.*from|on\\\\(.message|message event|\\\\.on\\\\(.start|connect\\\\(' \\\"\"'$D/vendor/hub/README.md\" | head -35; rg -n '\"'hub-card|about\\\\x27|data-setting|window.addEventListener\\\\(.*pointermove' \\\"\"'$D/src/main.js\" | fold -w 180 | head -55; sed -n '\"'1,60p' \\\"\"'$D/src/ui/style.css\" | cut -c1-200'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_147","type":"command_execution","command":"/bin/bash -lc \"D='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -n 'message.*from|on\\\\(.message|message event|\\\\.on\\\\(.start|connect\\\\(' \\\"\"'$D/vendor/hub/README.md\" | head -35; rg -n '\"'hub-card|about\\\\x27|data-setting|window.addEventListener\\\\(.*pointermove' \\\"\"'$D/src/main.js\" | fold -w 180 | head -55; sed -n '\"'1,60p' \\\"\"'$D/src/ui/style.css\" | cut -c1-200'","aggregated_output":"111:- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n120:`info` (also on `AIHub` after `connect()`):\n141:AIHub.connect({ mode, seats, card: true });\n281:- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n337:- the tags, `connect()`, `ready()` with no key press, and the start;\n377:| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n397:| `message` | `data, from` |\n30:    content=panel(`${brand}<h1 class=\"title\">A little<br><span>off balance.</span></h1><p class=\"lede\">A week of movement, a talking scale, and absolutely no pressure to be grac\neful.</p><div class=\"title-tag\">YOUR ISLAND IS READY</div>${notice()?`<p class=\"description\" style=\"margin-top:18px\"><strong>Controller or keyboard required</strong></p><div class=\n\"menu\">${button('Settings','settings','','ghost')}</div>`:`<div class=\"menu\">${button('Begin your week','slots','','primary')}<div class=\"menu-row\">${button('Drop-in','dropin','','\nghost')}${button('Family Hour','family','','ghost')}</div><div class=\"menu-row\">${button('Settings','settings','','ghost')}${button('About','about','','ghost')}</div></div>${footer\n()}`}`,'title-screen')+`<div class=\"hero-note\">WELCOME TO LITTLE ISLAND<strong>Take it one wobble at a time.</strong>EST. WHENEVER YOU ARE READY</div>`;\n61:    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"rang\ne\" min=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Ma\nth.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><lab\nel for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.ef\nfects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':\n''}>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label\n><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"mot\nion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n63:  }else if(app.screen==='about'){\n66:  }else if(app.screen==='hub-card'){\n116:  else if(action==='about')go('about');\n136:function setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>go('hub-card'));hub.on('start',()=>{app.hubRound=true;app.hubEnded=false;app.hubEvent=0;\napp.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&!app.hubEnded){app.hubEn\nded=true;hub.result({score:app.hubTotal+(app.session?.result().score||0)});app.hubRound=false;}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;});hub.connect({mode:'ghost\n',seats:[1,4],card:true});hub.ready();}\n:root{font-family:'DM Sans',system-ui,sans-serif;color:#253e43;background:#cce8dc;font-synthesis:none;--ink:#253e43;--cream:#fbfaf0;--mint:#dcefe4;--orange:#ef795f;--yellow:#f7c96f;--line:#d3e0d8}*{bo\n","exit_code":0,"status":"completed"}}
