{"type":"item.completed","item":{"id":"item_339","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom urllib.parse import quote, urlencode\nimport json\nbase='http://127.0.0.1:39559/'\ndev='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'\ngame='/' + dev + '.html'\nurl=base+quote(dev)+'/vendor/hub/harness.html?'+urlencode({'game':game,'auto':'1','players':'1'})\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--disable-dev-shm-usage'])\n page=b.new_page()\n page.on('pageerror',lambda e:print('PAGEERROR',e))\n print('harness:',url)\n page.goto(url,wait_until='domcontentloaded',timeout=30000)\n try: page.wait_for_function(\\\"document.body.dataset.complete === 'true'\\\",timeout=45000)\n except Exception as e: print('WAIT',str(e)); print('log:',page.locator('#log').inner_text()[-3000:])\n report=page.evaluate('window.__hubCheck')\n print(json.dumps(report,indent=2,default=str)[-12000:])\n b.close()\nPY\"","aggregated_output":"harness: http://127.0.0.1:39559/A%20Little%20Off%20Balance-Wii%20Fit-gpt-6.1-terra-max-20261104-221846/vendor/hub/harness.html?game=%2FA+Little+Off+Balance-Wii+Fit-gpt-6.1-terra-max-20261104-221846.html&auto=1&players=1\n{\n  \"done\": true,\n  \"pass\": false,\n  \"game\": \"/A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html\",\n  \"players\": 1,\n  \"scenario\": \"standard\",\n  \"checks\": [\n    {\n      \"name\": \"head metas\",\n      \"pass\": true,\n      \"detail\": \"hub:session=1 mode=ghost\"\n    },\n    {\n      \"name\": \"hub:session-players is a range within 1\\u20134\",\n      \"pass\": true,\n      \"detail\": \"hub:session-players=1-4\"\n    },\n    {\n      \"name\": \"hub:session-minutes, when given, is a number\",\n      \"pass\": true,\n      \"detail\": \"hub:session-minutes=4\"\n    },\n    {\n      \"name\": \"every copy says hello\",\n      \"pass\": true,\n      \"detail\": \"\"\n    },\n    {\n      \"name\": \"hello names protocol 1 and the mode\",\n      \"pass\": true,\n      \"detail\": \"{\\\"v\\\":1,\\\"client\\\":\\\"1.4.0\\\",\\\"mode\\\":\\\"ghost\\\",\\\"seats\\\":[1,4],\\\"card\\\":true}\"\n    },\n    {\n      \"name\": \"hello seats cover this player count\",\n      \"pass\": true,\n      \"detail\": \"[1,4]\"\n    },\n    {\n      \"name\": \"ready without a key press (the card asks the players)\",\n      \"pass\": false,\n      \"detail\": \"p0\"\n    },\n    {\n      \"name\": \"its own card: Enter answers Ready\",\n      \"pass\": false,\n      \"detail\": \"p0 (no card yet)\"\n    },\n    {\n      \"name\": \"the round starts when the card ends\",\n      \"pass\": false,\n      \"detail\": \"p0\"\n    }\n  ],\n  \"log\": [\n    \"   0.20  round 1: 1 player, seed 1661911241, limit 360 s, mode ghost\",\n    \"   0.64  p0 \\u2192 hub: hello\",\n    \"   0.71  hub \\u2192 p0: welcome\",\n    \"  25.75  splash over: the round starts once every game has loaded\",\n    \"  40.80  conformance: FAIL\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
