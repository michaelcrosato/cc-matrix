{"type":"item.started","item":{"id":"item_466","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; sed -n '110,260p' \\\"\"'$DEV/tests/browser.py\"; cat \"$DEV/tests/run.mjs\"; rg -n '\"'state\\\\(\\\\)|__GAME__|AIHub.time|hub-finished|game-tip|gameClock' \\\"\"'$DEV/src/main.js\"; rg -n '\"'auto|iframe|test=|players|result' \\\"\"'$DEV/vendor/hub/harness.html\" | tail -60; curl -s -o /dev/null -w '\"'server: %{http_code}\\\\n' 'http://127.0.0.1:39559/'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_466","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; sed -n '110,260p' \\\"\"'$DEV/tests/browser.py\"; cat \"$DEV/tests/run.mjs\"; rg -n '\"'state\\\\(\\\\)|__GAME__|AIHub.time|hub-finished|game-tip|gameClock' \\\"\"'$DEV/src/main.js\"; rg -n '\"'auto|iframe|test=|players|result' \\\"\"'$DEV/vendor/hub/harness.html\" | tail -60; curl -s -o /dev/null -w '\"'server: %{http_code}\\\\n' 'http://127.0.0.1:39559/'\"","aggregated_output":"        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\n            assert state(page)['day'] == day\n        click(page, 'finale')\n        click(page, 'start')\n        finish(page)\n        screen(page, 'reveal')\n        assert state(page)['profiles'][0]['revealed'] is True\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef family(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        click(page, 'family')\n        click(page, 'family-start', '[data-count=\"2\"]')\n        for _ in range(6):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        screen(page, 'medley-board')\n        assert page.get_by_text('PLAYER 1', exact=True).count() == 1\n        assert page.get_by_text('PLAYER 2', exact=True).count() == 1\n    finally:\n        browser.close()\n\n\ndef mobile(playwright, url):\n    browser = playwright.webkit.launch(headless=True)\n    context = browser.new_context(**playwright.devices['iPhone 17 Pro'])\n    page = context.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        assert page.get_by_text('Controller or keyboard required').is_visible()\n        assert page.locator('[data-action=\"slots\"]').count() == 0\n        click(page, 'settings')\n        assert page.locator('#music').input_value() == '0.1'\n    finally:\n        context.close()\n        browser.close()\n\n\ndef attract(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_function('window.__GAME__.state().attract', timeout=13000)\n        page.keyboard.press('Enter')\n        screen(page, 'title')\n    finally:\n        browser.close()\n\n\ndef webgpu(playwright, url):\n    browser = playwright.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-angle=swiftshader', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_selector('#world canvas', timeout=12000)\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthreading.Thread(target=server.serve_forever, daemon=True).start()\nurl = f'http://127.0.0.1:{server.server_port}/' + urllib.parse.quote(FILENAME)\ntry:\n    with sync_playwright() as playwright:\n        for name in ('chromium', 'firefox', 'webkit'):\n            check(name + ' profile, activity, persistence', lambda name=name: smoke(getattr(playwright, name), url))\n        check('seven-day playthrough and all activities', lambda: complete_week(playwright.chromium, url))\n        check('family medley', lambda: family(playwright.chromium, url))\n        check('touch-only notice', lambda: mobile(playwright, url))\n        check('idle attract and wake', lambda: attract(playwright.chromium, url))\n        check('WebGPU island', lambda: webgpu(playwright, url))\nfinally:\n    server.shutdown()\nprint(json.dumps({'passed': passed, 'failures': failures}))\nimport assert from 'node:assert/strict';\nimport { spawnSync } from 'node:child_process';\nimport { ACTIVITIES, activityForDay } from '../src/data/activities.js';\nimport { Dot, DEFAULT_TUNABLES } from '../src/core/dot.js';\nimport { ActivitySession, makeProfile, wobbleAge } from '../src/core/session.js';\nimport { MEDLEY_SECONDS, medleyWindow, pickMedley } from '../src/data/medley.js';\n\nlet passed = 0;\nconst failures = [];\nfunction test(name, check) {\n  try { check(); passed++; } catch (error) { failures.push(`${name}: ${error.stack || error}`); }\n}\n\ntest('activity catalog and unlocks', () => {\n  assert.equal(ACTIVITIES.length, 16);\n  assert.equal(new Set(ACTIVITIES.map(activity => activity.id)).size, 16);\n  assert.equal(activityForDay(1).length, 4);\n  assert.equal(activityForDay(5).length, 16);\n  assert.equal(activityForDay(7).length, 16);\n});\n\ntest('dot stays finite and bounded', () => {\n  const first = new Dot(() => .25), second = new Dot(() => .25);\n  for (let index = 0; index < 5000; index++) {\n    first.step(.05, Math.sin(index), Math.cos(index), DEFAULT_TUNABLES);\n    second.step(.05, Math.sin(index), Math.cos(index), DEFAULT_TUNABLES);\n    assert.ok(Number.isFinite(first.x) && Number.isFinite(first.y));\n    assert.ok(Math.hypot(first.x, first.y) <= 1.20000001);\n  }\n  assert.deepEqual(first, second);\n});\n\ntest('wobble age reveal corrects seven years', () => {\n  const profile = makeProfile('MABEL');\n  profile.history = [.6, .7, .8];\n  profile.stars = 8;\n  const before = wobbleAge(profile);\n  profile.revealed = true;\n  assert.equal(before - wobbleAge(profile), 7);\n});\n\nfor (const activity of ACTIVITIES) {\n  test(`${activity.id} completes with valid score`, () => {\n    const session = new ActivitySession(activity, { random: () => .25 });\n    for (let frame = 0; !session.finished && frame < 2000; frame++) {\n      const angle = frame * .4;\n      session.update(.05, { x: Math.cos(angle), y: Math.sin(angle), breath: frame % 40 < 20, left: frame % 14 === 0, right: frame % 14 === 7 });\n    }\n    assert.equal(session.finished, true);\n    assert.ok(session.result().score >= 0 && session.result().score <= 100);\n    assert.ok(session.result().stars >= 0 && session.result().stars <= 3);\n    const elapsed = session.elapsed;\n    session.update(.05, {});\n    assert.equal(session.elapsed, elapsed);\n  });\n}\n\ntest('live time tuning changes simulation speed', () => {\n  const normal = new ActivitySession(ACTIVITIES[0], { random: () => 0 });\n  const fast = new ActivitySession(ACTIVITIES[0], { random: () => 0, tuning: { timeScale: 2 } });\n  normal.update(.02); fast.update(.02);\n  assert.equal(fast.elapsed, normal.elapsed * 2);\n});\n\ntest('online medley choices and shared-clock windows', () => {\n  assert.deepEqual(pickMedley(() => 0), ['tree', 'squats', 'header']);\n  assert.deepEqual(pickMedley(() => .999), ['warrior', 'step', 'header']);\n  assert.deepEqual(medleyWindow(-3000), { phase: 'countdown', index: 0, remaining: 3 });\n  assert.deepEqual(medleyWindow(0), { phase: 'event', index: 0, remaining: 55 });\n  assert.deepEqual(medleyWindow(55000), { phase: 'break', index: 0, remaining: 10 });\n  assert.deepEqual(medleyWindow(65000), { phase: 'event', index: 1, remaining: 55 });\n  assert.deepEqual(medleyWindow(120000), { phase: 'break', index: 1, remaining: 10 });\n  assert.deepEqual(medleyWindow(130000), { phase: 'event', index: 2, remaining: 55 });\n  assert.equal(MEDLEY_SECONDS, 185);\n  assert.equal(medleyWindow(185000).phase, 'finished');\n});\n\nconst browser = spawnSync('python3', ['tests/browser.py'], { encoding: 'utf8', env: process.env, timeout: 180000 });\nif (browser.error || browser.status !== 0) {\n  failures.push(`browser runner: ${browser.error?.message || browser.stderr || browser.stdout || `exit ${browser.status}`}`);\n} else {\n  try {\n    const report = JSON.parse(browser.stdout);\n    passed += report.passed;\n    failures.push(...report.failures);\n  } catch (error) { failures.push(`browser report: ${error.message}\\n${browser.stdout}\\n${browser.stderr}`); }\n}\nfor (const failure of failures) console.error(`FAIL ${failure}`);\nconsole.log(`${passed} passed, ${failures.length} failed`);\nif (failures.length) process.exitCode = 1;\n43:    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n70:  }else if(app.screen==='hub-finished'){\n181:function finishHub(){if(!app.hubRound||app.hubEnded)return;const score=hubScore();app.hubEnded=true;app.hubRound=false;clearInterval(app.hubTimer);globalThis.AIHub.result({score});app.result={score};go('hub-finished');}\n183:  const window=medleyWindow(globalThis.AIHub.time());\n196:window.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\n12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n27:  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n46:  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n72:const auto = params.get('auto') === '1';\n79:for (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n103:      players: meta('hub:session-players'),\n167:  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n173:  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n187:    players,\n204:    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n208:  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n210:    const frame = document.createElement('iframe');\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n301:  const players = state.cells.filter((c) => !c.server && !c.gone);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n335:    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n339:    else if (p.result) bits.push(`result ${JSON.stringify(p.result)}`);\n344:    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\n352:    const name = (id) => s.players[id]?.name ?? `#${id}`;\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n422:    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n424:    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n427:    // Every copy: the players, and in a server round the server's copy.\n428:    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n442:    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n443:    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n445:      const players = state.cells.filter((c) => !c.server);\n446:      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n447:      for (const cell of players) poke(cell, 'Enter');\n448:      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n449:      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n489:      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n500:      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n508:      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n544:if (auto) conformance();\nserver: 200\n","exit_code":0,"status":"completed"}}
