turn;const dial=event.target.closest('#dial');if(!dial)return;const rect=d\nial.getBoundingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-r\nect.height/2)/(rect.height/2)))};app.lastInput=performance.now();});\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n    second.step(.05, Math.sin(index), Math.cos(index), DEFAULT_TUNABLES);\n    assert.ok(Number.isFinite(first.x) && Number.isFinite(first.y));\n    assert.ok(Math.hypot(first.x, first.y) <= 1.20000001);\n  }\n  assert.deepEqual(first, second);\n});\n\ntest('wobble age reveal corrects seven years', () => {\n  const profile = makeProfile('MABEL');\n  profile.history = [.6, .7, .8];\n  profile.stars = 8;\n  const before = wobbleAge(profile);\n  profile.revealed = true;\n  assert.equal(before - wobbleAge(profile), 7);\n});\n\nfor (const activity of ACTIVITIES) {\n  test(`${activity.id} completes with valid score`, () => {\n    const session = new ActivitySession(activity, { random: () => .25 });\n    for (let frame = 0; !session.finished && frame < 2000; frame++) {\n      const angle = frame * .4;\n      session.update(.05, { x: Math.cos(angle), y: Math.sin(angle), breath: frame % 40 < 20, left: frame % 14 === 0, right: frame % 14 === 7 });\n    }\n    assert.equal(session.finished, true);\n    assert.ok(session.result().score >= 0 && session.result().score <= 100);\n    assert.ok(session.result().stars >= 0 && session.result().stars <= 3);\n    const elapsed = session.elapsed;\n    session.update(.05, {});\n    assert.equal(session.elapsed, elapsed);\n  });\n}\n\ntest('live time tuning changes simulation speed', () => {\n  const normal = new ActivitySession(ACTIVITIES[0], { random: () => 0 });\n  const fast = new ActivitySession(ACTIVITIES[0], { random: () => 0, tuning: { timeScale: 2 } });\n  normal.update(.02); fast.update(.02);\n  assert.equal(fast.elapsed, normal.elapsed * 2);\n});\n\ntest('online medley choices and shared-clock windows', () => {\n  assert.deepEqual(pickMedley(() => 0), ['tree', 'squats', 'header']);\n  assert.deepEqual(pickMedley(() => .999), ['warrior', 'step', 'header']);\n  assert.deepEqual(medleyWindow(-3000), { phase: 'countdown', index: 0, remaining: 3 });\n  assert.deepEqual(medleyWindow(0), { phase: 'event', index: 0, remaining: 55 });\n  assert.deepEqual(medleyWindow(55000), { phase: 'break', index: 0, remaining: 10 });\n  assert.deepEqual(medleyWindow(65000), { phase: 'event', index: 1, remaining: 55 });\n  assert.deepEqual(medleyWindow(120000), { phase: 'break', index: 1, remaining: 10 });\n  assert.deepEqual(medleyWindow(130000), { phase: 'event', index: 2, remaining: 55 });\n  assert.equal(MEDLEY_SECONDS, 185);\n  assert.equal(medleyWindow(185000).phase, 'finished');\n});\n\nconst browser = spawnSync('python3', ['tests/browser.py'], { encoding: 'utf8', env: process.env, timeout: 180000 });\nif (browser.error || browser.status !== 0) {\n  failures.push(`browser runner: ${browser.error?.message || browser.stderr || browser.stdout || `exit ${browser.status}`}`);\n} else {\n  try {\n    const report = JSON.parse(browser.stdout);\n    passed += report.passed;\n    failures.push(...report.failures);\n  } catch (error) { failures.push(`browser report: ${error.message}\\n${browser.stdout}\\n${browser.stderr}`); }\n}\nfor (const failure of failures) console.error(`FAIL ${failure}`);\nconsole.log(`${passed} passed, ${failures.length} failed`);\nif (failures.length) process.exitCode = 1;\n# Credits (Pixel Engine 0.46.0)\n\nWhat this kit carries and where it came from, generated by `npm run bundle` from each built-in model's and texture's `source` (the data the engine repository's `npm run model -- cr\n\n## Models and textures\n\n- **The engine's own work**, made in its repository: 151 of the 151 library models (`MODEL_LIBRARY`), 126 of the 126 textures (`TEXTURE_LIBRARY`) and the built-in models (`assets/c\n- **kenney-castle** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/castle-kit/a395102d20-171154361\n- **kenney-furniture** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/furniture-kit/440e0608a4-167\n- **kenney-mini-dungeon** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/mini-dungeon/6cd72dc849-1\n- **kenney-nature** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/nature-kit/37ac38a37b-167769893\n- **kenney-tiny-dungeon** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/tiny-dungeon/f8422efb44-1\n- **kenney-tiny-town** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/tiny-town/a415fbeb49-1735736\n- **Your own imports** carry a `source` too (url, licence, author): credit them as their licence asks. A pack loaded with `loadPack` carries its models' and textures' `source`s.\n\n## Palettes\n\n- **Sweetie 16** by GrafxKid: the engine's 16 colours (`PALETTE`) and the `sweetie16` filter.\n- **PICO-8** by Lexaloffle Games (the PICO-8 fantasy console): the `pico8` filter.\n\n## Code\n\n- **three.js (three)** 0.186.0, MIT: https://threejs.org/. Its licence follows.\n- **Rapier (@dimforge/rapier3d)** 0.20.0, Apache-2.0: https://rapier.rs. Its licence follows.\n\n### three.js (three) licence\n\n```text\nThe MIT License\n\nCopyright © 2010-2026 three.js authors\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in\nall copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\nTHE SOFTWARE.\n```\n\n### Rapier (@dimforge/rapier3d) licence\n\n```text\n                                 Apache License\n# Progress\n\n## Project\n- Title selected by `crypto.randomInt` from 50 candidates: **A Little Off Balance**.\n- Deliverable basename: `A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846`.\n- Read `TASK.md` and `PLAN.md`; downloaded the unmodified Pixel Engine 0.46.0 and AI Hub client into the development folder.\n- Implemented the activity catalog, unstable balance physics, progression, synthesized audio, 3D island, screens, local profiles, family sessions, and AI Hub client integration. The standalone HTML builds successfully.\n\n## Work plan\n1. Read the complete design and integration documentation; obtain the unmodified engine and hub client.\n2. Build the core game, island, activities, progression, input, audio, and multiplayer.\n3. Bundle the standalone HTML, run focused playthrough and viewport tests, and fix findings.\n4. Complete About/Credits, `exit-interview.json`, and this progress record.\n\n## Current checkpoint\n- Source lives in the development folder's `src/`; build the standalone deliverable with `npm run build` there.\n- The last completed `npm test` run passed 30 checks, including activity simulations, profile/day progression, simultaneous Family Hour, the WebGPU scene, and Chromium/Firefox/WebKit browser flows.\n- The viewport matrix reports 24 clean phone, foldable, tablet, and desktop configurations. Selected WebKit and Chromium screenshots have been inspected.\n- Fixed an unsupported-WebGPU startup overlay and an oversized title encountered during browser testing.\n- The official AI Hub harness passed one-, two-, and four-player simulations, including latency, packet loss, and host/player departures. Chromium, Firefox, and WebKit opened the standalone `file://` build.\n- Fixed an AI Hub ready/welcome race and phone gameplay hint overflow. Added a CSS fallback character for browsers without WebGPU.\n- Next: finish paginated About/Credits, replace interview placeholders, inspect simultaneous Family Hour layouts, and rebuild and retest the final artifacts.\n- The implementation is a simplified interpretation of the extensive plan: activities share the island scene rather than having full bespoke animated environments.\n\n## Constraints\n- Only work in this directory and the required development subfolder; use OS-assigned localhost ports and stop only our own processes.\n- Keep `pixel-engine.js` unchanged; synthesize audio in code; default music volume 10%.\n- Test small phones, tablets, wide screens, WebKit, and scripted game flows; no physical controller or real iOS device is available.\n","exit_code":0,"status":"completed"}}
