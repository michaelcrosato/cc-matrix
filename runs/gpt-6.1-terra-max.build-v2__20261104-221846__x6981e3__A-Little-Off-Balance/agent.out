{"type":"item.completed","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; printf '%s\\\\n' '---files---'; find \\\"\"'$DEV/src\" -type f; printf '\"'%s\\\\n' '---activities---'; sed -n '1,100p' \\\"\"'$DEV/src/data/activities.js\"; printf '\"'%s\\\\n' '---session api---'; rg -n 'export |constructor\\\\(|update\\\\(|result\\\\(|this\\\\.' \\\"\"'$DEV/src/core/session.js\" | head -85; printf '\"'%s\\\\n' '---world---'; sed -n '1,100p' \\\"\"'$DEV/src/world.js\"; printf '\"'%s\\\\n' '---build---'; cat \\\"\"'$DEV/tools/build.mjs\"'","aggregated_output":"---files---\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/ui/style.css\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/world.js\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/data/audio.js\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/data/activities.js\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/data/title.js\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/core/audio-runtime.js\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/core/dot.js\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/core/session.js\n---activities---\nexport const ACTIVITIES = [\n  { id:'tree', name:'Apologetic Tree', family:'still', place:'Pavilion', day:1, duration:25, ring:.40, instruction:'KEEP YOUR DOT IN THE RING', quip:'THE TREE ACCEPTS YOUR APOLOGY.' },\n  { id:'heron', name:'Startled Heron', family:'still', place:'Pavilion', day:1, duration:25, ring:.36, instruction:'LEAN AGAINST THE WANDERING WIND', quip:'A MOST RESPECTABLE BIRD.' },\n  { id:'squats', name:'Squats of Regret', family:'reps', place:'Rep Shed', day:1, duration:38.4, instruction:'MATCH THE MOVING MARKER', quip:'THAT WAS THE LAST ONE. PROBABLY.' },\n  { id:'hoop', name:'Hoop Economics', family:'hoop', place:'Beat Beach', day:1, duration:40, instruction:'CIRCLE YOUR STICK OR ROLL W D S A', quip:'THE ECONOMY REMAINS CIRCULAR.' },\n  { id:'header', name:'Coconut Header', family:'header', place:'Beat Beach', day:2, duration:40, instruction:'LEAN LEFT OR RIGHT TO HEAD COCONUTS', quip:'A SOUND FINANCIAL HEADBUTT.' },\n  { id:'lunges', name:'Apology Lunges', family:'reps', place:'Rep Shed', day:2, duration:38.4, instruction:'MATCH THE MARKER AND ALTERNATE SIDES', quip:'YOUR LEGS HAVE BEEN NOTIFIED.' },\n  { id:'warrior', name:'Reluctant Warrior', family:'still', place:'Pavilion', day:2, duration:30, ring:.32, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'A WARRIOR, UNDER PROTEST.' },\n  { id:'step', name:'Step Department', family:'step', place:'Town Square', day:3, duration:40, instruction:'PRESS F OR J WHEN NOTES HIT THE LINE', quip:'YOUR STEPS HAVE BEEN FILED.' },\n  { id:'slackline', name:'Slackline of Doubt', family:'slack', place:'Lookout', day:3, duration:45, instruction:'STAY CENTERED. STEP TO WALK', quip:'THE ROPE BELIEVES IN YOU.' },\n  { id:'chair', name:'The Chair Nobody Asked For', family:'still', place:'Pavilion', day:3, duration:30, ring:.30, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'SOMEWHERE A CHAIR FEELS SEEN.' },\n  { id:'tray', name:'Vitamin Tray', family:'tray', place:'Cafe', day:4, duration:40, instruction:'KEEP THE VITAMINS ON THE TRAY', quip:'NUTRITION HAS NEVER BEEN SO TENSE.' },\n  { id:'mortgage', name:'Overhead Mortgage', family:'reps', place:'Rep Shed', day:4, duration:36, instruction:'PUSH UP TO MATCH THE MARKER', quip:'INTEREST COMPOUNDS. SO DOES SWEAT.' },\n  { id:'tax', name:'Tax Season', family:'still', place:'Pavilion', day:4, duration:30, ring:.28, breath:6, instruction:'LEAN AND BREATHE THROUGH THE AUDIT', quip:'YOUR EXTENSION HAS BEEN APPROVED.' },\n  { id:'jog', name:'Island Jog', family:'jog', place:'Island Trail', day:5, duration:45, instruction:'ALTERNATE F AND J TO RUN', quip:'YOU HAVE LAPSED A COCONUT.' },\n  { id:'pier', name:'Pier Jump', family:'jump', place:'Pier', day:5, duration:40, instruction:'STEP TO THE EDGE. BREATHE TO JUMP', quip:'THE WATER GIVES YOU A TEN.' },\n  { id:'plank', name:'Plank Negotiation', family:'still', place:'Pavilion', day:5, duration:35, ring:.24, breath:6, instruction:'KEEP THE DOT IN THE RING. BREATHE', quip:'YOUR CORE HAS COUNTEROFFERED.' },\n];\n\nexport const DAY_NAMES = ['A FRESH START','THE HEAD OF IT','A NARROW VIEW','WEALTH AND HEALTH','THE LONG WAY ROUND','A LITTLE MORE','THE LONG STAND'];\nexport const FRIENDS = ['COACH PLUMB','MABEL','FRANK','KEVIN'];\nexport function activityForDay(day) { return ACTIVITIES.filter(activity => activity.day <= Math.min(day, 5)); }\n---session api---\n4:export function makeProfile(name='PLAYER') {return {name,day:1,drips:0,stars:0,history:[],played:{},goal:'FIND YOUR BALANCE',revealed:false,completedDays:[]};}\n5:export function wobbleAge(profile) {\n10:export class ActivitySession {\n11:  constructor(activity,options={}) {\n12:    this.activity=activity; this.hard=!!options.hard; this.duration=options.duration??activity.duration;\n13:    this.dot=new Dot(options.random); this.elapsed=0; this.points=0; this.samples=0; this.breathSync=.5;\n14:    this.rep=.0; this.hoopLift=.65; this.lastAngle=null; this.angleSpeed=0; this.goodSteps=0; this.lastStep=-2; this.hits=0;\n15:    this.tuning={...DEFAULT_TUNABLES,...options.tuning}; this.finished=false; this.distance=0; this.lastDirection=0;\n16:    this.eventCount=0; this.lastBeat=-1; this.notes=[];\n18:  update(dt,input={}) {\n19:    if(this.finished)return;\n20:    dt=clamp(dt,0,.1); this.elapsed+=dt;\n22:    const family=this.activity.family, t=this.elapsed;\n23:    const breathIn=this.activity.breath?Math.sin(t*Math.PI*2/this.activity.breath)>0:false;\n24:    if(this.activity.breath) this.breathSync+=(Number(breath===breathIn)-this.breathSync)*Math.min(1,dt*2);\n25:    const modifiers={noise:this.activity.breath?1.25-.55*this.breathSync:1};\n26:    if(this.activity.id==='heron')modifiers.bx=.12*Math.sin(t*.7);\n27:    if(this.activity.id==='tax')modifiers.bx=.18*Math.sin(t*.9);\n28:    if(this.activity.id==='chair')modifiers.noise*=1+.5*t/this.duration;\n29:    if(this.activity.id==='plank')modifiers.inst=1.2;\n30:    this.dot.step(dt,x,y,this.tuning,modifiers);\n31:    const distance=Math.hypot(this.dot.x,this.dot.y);\n34:      const ring=(this.activity.ring??(family==='slack'?.32:.48))*(this.hard?.8:1);\n36:      if(this.activity.breath)quality=.8*quality+.2*this.breathSync;\n38:        if((left||right)&&t-this.lastStep>.14){this.lastStep=t;this.goodSteps++;this.distance+=distance<.75?1:.15;}\n39:        quality*=.45+.55*clamp(this.goodSteps/(t*1.5),0,1);\n41:      if(family==='jump'&&breath&&t-this.lastStep>2){this.lastStep=t;this.goodSteps++;this.distance+=distance<.6?1:0;}\n42:      if(family==='jump') quality*=.5+.5*clamp(this.goodSteps/Math.max(1,t/5),0,1);\n46:      const requested=this.activity.id==='lunges'?Math.abs(x):this.activity.id==='mortgage'?Math.max(0,y):Math.max(0,-y);\n47:      this.rep+=(requested-this.rep)*Math.min(1,dt/((this.activity.id==='mortgage'?.15:.10)));\n48:      quality=clamp(1-1.6*Math.abs(this.rep-target),0,1);\n51:      if(magnitude>.5){const angle=Math.atan2(y,x);if(this.lastAngle!==null){let delta=angle-this.lastAngle;while(delta>Math.PI)delta-=Math.PI*2;while(delta< -Math.PI)delta+=Math.PI*2;this.angleSpeed+=(Math.abs(delta)/Math.max(dt,.001)-this.angleSpeed)*Math.min(1,dt/.25);}this.lastAngle=angle;}else{this.angleSpeed*=Math.max(0,1-dt*3);this.lastAngle=null;}\n52:      const inBand=this.angleSpeed>4.5&&this.angleSpeed<18;\n53:      this.hoopLift=clamp(this.hoopLift+(inBand?.35:-.15)*dt,0,1);quality=this.hoopLift;\n56:      if(beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;}\n57:      if((left||right)&&t-this.lastStep>.12){const side=left?-1:1;const phase=Math.abs((t/.7)-Math.round(t/.7));if(family==='jog'?side!==this.lastDirection:phase<.23){this.goodSteps++;}this.lastDirection=side;this.lastStep=t;}\n58:      quality=clamp(this.goodSteps/Math.max(1,this.eventCount-1),0,1);\n61:      if(beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;const target=beat%2===0?-1:1;if(Math.sign(x)===target)this.hits++;}\n62:      quality=this.hits/Math.max(1,this.eventCount);\n64:    this.points+=quality*dt;this.samples+=dt;\n65:    if(this.elapsed>=this.duration)this.finished=true;\n67:  result(){const score=Math.round(100*this.points/Math.max(.001,this.samples));const thresholds=this.activity.family==='reps'?[55,75,90]:[45,70,90];const stars=thresholds.filter(value=>score>=value).length;return {score,stars,drips:2+stars*3+Math.floor(this.duration/30),seconds:this.duration};}\n---world---\nimport { Engine, THREE, toonMaterial, withUrlOptions } from '../pixel-engine.js';\n\nconst { BoxGeometry, CylinderGeometry, SphereGeometry, ConeGeometry, Mesh, Group, Vector3 } = THREE;\n\nclass IslandScene {\n  name = 'A Little Off Balance';\n  target = new Vector3(0, .6, 0);\n  constructor(game) { this.game = game; }\n  setup({ scene, engine }) {\n    engine.sun.intensity = 1.8;\n    const material = color => toonMaterial(color);\n    const box = (parent, color, size, position) => {\n      const mesh = new Mesh(new BoxGeometry(...size), material(color));\n      mesh.position.set(...position); mesh.castShadow = true; mesh.receiveShadow = true; parent.add(mesh); return mesh;\n    };\n    const cylinder = (parent, color, top, bottom, height, position, sides = 24) => {\n      const mesh = new Mesh(new CylinderGeometry(top, bottom, height, sides), material(color));\n      mesh.position.set(...position); mesh.castShadow = true; mesh.receiveShadow = true; parent.add(mesh); return mesh;\n    };\n    cylinder(scene, 0xc8a578, 5.6, 5.15, .65, [0, -.38, 0], 48);\n    cylinder(scene, 0x8cbe8b, 5.5, 5.6, .18, [0, 0, 0], 48);\n    cylinder(scene, 0xf5e3bc, 2.45, 2.45, .035, [0, .11, .1], 48);\n    for (const [x,z,scale] of [[-4,-2,1.1],[-3.8,2.5,.8],[3.5,-2.8,1],[4.2,2,.85],[-1,-4.4,.8]]) {\n      cylinder(scene, 0x9a795d, .12, .18, 1.2*scale, [x,.6*scale,z], 8);\n      const crown = new Mesh(new SphereGeometry(.65*scale, 9, 7), material(0x5c9c70)); crown.position.set(x,1.45*scale,z); crown.castShadow=true; scene.add(crown);\n    }\n    for (const [x,z,color] of [[-2.7,-2.5,0xe38c70],[2.5,-2.7,0xe9b96f],[3.1,.45,0x82aec1]]) {\n      box(scene, 0xf7e8cf, [1.4,1.1,1.15], [x,.67,z]);\n      const roof=new Mesh(new ConeGeometry(1.14,.65,4),material(color)); roof.position.set(x,1.53,z); roof.rotation.y=Math.PI/4; roof.castShadow=true; scene.add(roof);\n      box(scene,0x759b91,[.25,.38,.03],[x,.65,z+.59]);\n    }\n    cylinder(scene,0x8cb7ba,.75,.75,.09,[2.4,.13,2.15]);\n    const board=box(scene,0xf8f4df,[.75,.15,.55],[-.3,.2,.5]); board.rotation.y=-.25;\n    this.hero=new Group(); this.hero.position.set(-.3,.3,.5); scene.add(this.hero);\n    cylinder(this.hero,0xe8866b,.27,.34,.65,[0,.58,0],12);\n    const head=new Mesh(new SphereGeometry(.29,12,10),material(0xf1c29d));head.position.set(0,1.13,0);this.hero.add(head);\n    box(this.hero,0x455d59,[.12,.42,.12],[-.17,.04,0]);box(this.hero,0x455d59,[.12,.42,.12],[.17,.04,0]);\n    const left=box(this.hero,0xe8b995,[.12,.5,.12],[-.36,.64,0]);left.rotation.z=-.7;\n    const right=box(this.hero,0xe8b995,[.12,.5,.12],[.36,.64,0]);right.rotation.z=.7;\n    this.mixer=new THREE.AnimationMixer(this.hero);\n    this.mixer.clipAction(new THREE.AnimationClip('idle',2,[new THREE.NumberKeyframeTrack('.position[y]',[0,1,2],[.3,.34,.3])])).play();\n    const ounce=box(scene,0xf9faf1,[.72,.45,.53],[.9,.35,1.3]);\n    box(scene,0x9cc5b6,[.38,.08,.015],[.9,.42,1.58]); ounce.rotation.y=-.2;\n  }\n  update(ctx, dt) {\n    this.mixer?.update(dt);\n    if (this.hero && this.game.session) {\n      this.hero.rotation.z = -this.game.session.dot.x*.27;\n      this.hero.rotation.x = this.game.session.dot.y*.2;\n    } else if (this.hero) { this.hero.rotation.z *= .95; this.hero.rotation.x *= .95; }\n    ctx.hud.clear();\n  }\n  cameraTarget() { return this.target; }\n  status() { return `island: ${this.game.screen}`; }\n}\n\nexport async function startWorld(game) {\n  return Engine.start(new IslandScene(game), withUrlOptions({container:document.getElementById('world'),aspect:'fill',touch:false,background:0xc9e8dc,camera:{preset:'iso',zoom:1.05}}));\n}\n---build---\nimport {readFileSync,writeFileSync,mkdirSync} from 'node:fs';\nimport {execFileSync} from 'node:child_process';\n\nmkdirSync('.build',{recursive:true});\nexecFileSync('esbuild',['src/main.js','--bundle','--format=esm','--platform=browser','--target=esnext','--charset=utf8','--outfile=.build/game.js','--log-level=warning'],{stdio:'inherit'});\nconst safe=source=>source.replace(/<\\/script/gi,'<\\\\/script');\nconst css=readFileSync('src/ui/style.css','utf8');\nconst hub=safe(readFileSync('vendor/hub/session.js','utf8'));\nconst game=safe(readFileSync('.build/game.js','utf8'));\nconst html=`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#cbe9dc\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\"><meta name=\"hub:session-goal\" content=\"Score the most points across three delightfully wobbly events.\"><meta name=\"hub:session-howto\" content=\"Left stick or WASD: lean. R2 or Space: breathe. L1/R1 or F/J: step.\"><meta name=\"hub:session-minutes\" content=\"4\"><meta name=\"hub:webgpu\" content=\"required\">\n<title>A Little Off Balance</title><style>${css}</style></head>\n<body><div id=\"world\" aria-hidden=\"true\"><div class=\"fallback-island\"><i></i><b></b><em></em></div></div><div id=\"ui\"><main class=\"loading\">A little moment, please<span>● ● ●</span></main></div><script type=\"module\">${game}</script></body></html>`;\nwriteFileSync('../A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html',html);\nconsole.log(`Built standalone HTML (${(Buffer.byteLength(html)/1048576).toFixed(1)} MB).`);\n","exit_code":0,"status":"completed"}}
