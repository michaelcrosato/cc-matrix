{"type":"item.started","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -lc \"D='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; cat \\\"\"'$D/src/core/dot.js\"; cat \"$D/src/core/audio-runtime.js\"; cat \"$D/tools/build.mjs\"; sed -n '\"'1,80p' \\\"\"'$D/src/data/activities.js\"; sed '\"'s/}/}\\\\n/g' \\\"\"'$D/src/ui/style.css\" | head -65'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -lc \"D='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; cat \\\"\"'$D/src/core/dot.js\"; cat \"$D/src/core/audio-runtime.js\"; cat \"$D/tools/build.mjs\"; sed -n '\"'1,80p' \\\"\"'$D/src/data/activities.js\"; sed '\"'s/}/}\\\\n/g' \\\"\"'$D/src/ui/style.css\" | head -65'","aggregated_output":"export const DEFAULT_TUNABLES = Object.freeze({dotLag:.6,dotInstability:3,dotAuthority:3.4,dotDamping:.8,dotNoise:.08,timeScale:1});\nexport class Dot {\n  constructor(random = Math.random) {\n    this.x=0; this.y=0; this.vx=0; this.vy=0; this.ux=0; this.uy=0; this.t=0;\n    this.ph=Array.from({length:4},()=>random()*Math.PI*2);\n  }\n  step(dt,inX,inY,tuning=DEFAULT_TUNABLES,modifiers={}) {\n    this.t+=dt;\n    const lag=Math.min(1,dt/Math.max(.01,tuning.dotLag));\n    this.ux+=(inX-this.ux)*lag; this.uy+=(inY-this.uy)*lag;\n    const noise=tuning.dotNoise*(modifiers.noise??1), instability=tuning.dotInstability*(modifiers.inst??1), authority=tuning.dotAuthority*(modifiers.auth??1);\n    const noiseX=noise*(Math.sin(1.7*this.t+this.ph[0])+.6*Math.sin(3.1*this.t+this.ph[1]));\n    const noiseY=noise*(Math.sin(1.3*this.t+this.ph[2])+.6*Math.sin(2.7*this.t+this.ph[3]));\n    this.vx+=(instability*this.x+authority*this.ux-tuning.dotDamping*this.vx+noiseX+(modifiers.bx??0))*dt;\n    this.vy+=(instability*this.y+authority*this.uy-tuning.dotDamping*this.vy+noiseY+(modifiers.by??0))*dt;\n    this.x+=this.vx*dt; this.y+=this.vy*dt;\n    const distance=Math.hypot(this.x,this.y);\n    if(distance>1.2){const scale=1.2/distance;this.x*=scale;this.y*=scale;this.vx*=.3;this.vy*=.3;}\n  }\n}\nexport class Sound {\n  constructor(settings) { this.settings=settings; this.context=null; this.beat=0; this.next=0; }\n  unlock() {\n    if (!this.context) {\n      const AudioContext=window.AudioContext||window.webkitAudioContext;\n      if (!AudioContext) return;\n      this.context=new AudioContext();\n    }\n    if (this.context.state==='suspended') this.context.resume().catch(()=>{});\n  }\n  tone(frequency,duration=.12,volume=.12,type='sine',delay=0) {\n    const context=this.context;\n    if (!context||context.state!=='running') return;\n    const start=context.currentTime+delay;\n    const oscillator=context.createOscillator(), gain=context.createGain();\n    oscillator.type=type; oscillator.frequency.setValueAtTime(frequency,start);\n    gain.gain.setValueAtTime(.0001,start); gain.gain.exponentialRampToValueAtTime(Math.max(.0002,volume),start+.012);\n    gain.gain.exponentialRampToValueAtTime(.0001,start+duration);\n    oscillator.connect(gain).connect(context.destination); oscillator.start(start); oscillator.stop(start+duration+.02);\n  }\n  effect(kind='select') {\n    const volume=(this.settings.effects??.7)*.14;\n    if(kind==='select') this.tone(520,.09,volume,'triangle');\n    if(kind==='back') this.tone(270,.12,volume,'sine');\n    if(kind==='good'){this.tone(523,.15,volume,'triangle');this.tone(784,.23,volume,'triangle',.09);}\n    if(kind==='voice'){for(let syllable=0;syllable<3;syllable++)this.tone(350+Math.random()*150,.075,volume*.45,'triangle',syllable*.075);}\n  }\n  update(dt) {\n    if(!this.context||this.context.state!=='running'||!this.settings.music)return;\n    this.next-=dt;\n    if(this.next>0)return;\n    this.next+=.34;\n    const notes=[392,494,587,494,440,523,659,523,392,494,587,659,698,587,523,440];\n    this.tone(notes[this.beat%notes.length],.27,(this.settings.music??.1)*.18,'sine');\n    if(this.beat%4===0)this.tone([196,220,174.6,196][Math.floor(this.beat/4)%4],.48,(this.settings.music??.1)*.12,'triangle');\n    this.beat++;\n  }\n}\nimport {readFileSync,writeFileSync,mkdirSync} from 'node:fs';\nimport {execFileSync} from 'node:child_process';\n\nmkdirSync('.build',{recursive:true});\nexecFileSync('esbuild',['src/main.js','--bundle','--format=esm','--platform=browser','--target=esnext','--charset=utf8','--outfile=.build/game.js','--log-level=warning'],{stdio:'inherit'});\nconst safe=source=>source.replace(/<\\/script/gi,'<\\\\/script');\nconst css=readFileSync('src/ui/style.css','utf8');\nconst hub=safe(readFileSync('vendor/hub/session.js','utf8'));\nconst game=safe(readFileSync('.build/game.js','utf8'));\nconst html=`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#cbe9dc\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\"><meta name=\"hub:session-goal\" content=\"Score the most points across three delightfully wobbly events.\"><meta name=\"hub:session-howto\" content=\"Left stick or WASD: lean. R2 or Space: breathe. L1/R1 or F/J: step.\"><meta name=\"hub:session-minutes\" content=\"4\"><meta name=\"hub:webgpu\" content=\"required\">\n<title>A Little Off Balance</title><style>${css}</style></head>\n<body><div id=\"world\" aria-hidden=\"true\"><div class=\"fallback-island\"><i></i><b></b><em></em></div></div><div id=\"ui\"><main class=\"loading\">A little moment, please<span>● ● ●</span></main></div><script type=\"module\">${game}</script></body></html>`;\nwriteFileSync('../A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html',html);\nconsole.log(`Built standalone HTML (${(Buffer.byteLength(html)/1048576).toFixed(1)} MB).`);\nexport const ACTIVITIES = [\n  { id:'tree', name:'Apologetic Tree', family:'still', place:'Pavilion', day:1, duration:25, ring:.40, instruction:'KEEP YOUR DOT IN THE RING', quip:'THE TREE ACCEPTS YOUR APOLOGY.' },\n  { id:'heron', name:'Startled Heron', family:'still', place:'Pavilion', day:1, duration:25, ring:.36, instruction:'LEAN AGAINST THE WANDERING WIND', quip:'A MOST RESPECTABLE BIRD.' },\n  { id:'squats', name:'Squats of Regret', family:'reps', place:'Rep Shed', day:1, duration:38.4, instruction:'MATCH THE MOVING MARKER', quip:'THAT WAS THE LAST ONE. PROBABLY.' },\n  { id:'hoop', name:'Hoop Economics', family:'hoop', place:'Beat Beach', day:1, duration:40, instruction:'CIRCLE YOUR STICK OR ROLL W D S A', quip:'THE ECONOMY REMAINS CIRCULAR.' },\n  { id:'header', name:'Coconut Header', family:'header', place:'Beat Beach', day:2, duration:40, instruction:'LEAN LEFT OR RIGHT TO HEAD COCONUTS', quip:'A SOUND FINANCIAL HEADBUTT.' },\n  { id:'lunges', name:'Apology Lunges', family:'reps', place:'Rep Shed', day:2, duration:38.4, instruction:'MATCH THE MARKER AND ALTERNATE SIDES', quip:'YOUR LEGS HAVE BEEN NOTIFIED.' },\n  { id:'warrior', name:'Reluctant Warrior', family:'still', place:'Pavilion', day:2, duration:30, ring:.32, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'A WARRIOR, UNDER PROTEST.' },\n  { id:'step', name:'Step Department', family:'step', place:'Town Square', day:3, duration:40, instruction:'PRESS F OR J WHEN NOTES HIT THE LINE', quip:'YOUR STEPS HAVE BEEN FILED.' },\n  { id:'slackline', name:'Slackline of Doubt', family:'slack', place:'Lookout', day:3, duration:45, instruction:'STAY CENTERED. STEP TO WALK', quip:'THE ROPE BELIEVES IN YOU.' },\n  { id:'chair', name:'The Chair Nobody Asked For', family:'still', place:'Pavilion', day:3, duration:30, ring:.30, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'SOMEWHERE A CHAIR FEELS SEEN.' },\n  { id:'tray', name:'Vitamin Tray', family:'tray', place:'Cafe', day:4, duration:40, instruction:'KEEP THE VITAMINS ON THE TRAY', quip:'NUTRITION HAS NEVER BEEN SO TENSE.' },\n  { id:'mortgage', name:'Overhead Mortgage', family:'reps', place:'Rep Shed', day:4, duration:36, instruction:'PUSH UP TO MATCH THE MARKER', quip:'INTEREST COMPOUNDS. SO DOES SWEAT.' },\n  { id:'tax', name:'Tax Season', family:'still', place:'Pavilion', day:4, duration:30, ring:.28, breath:6, instruction:'LEAN AND BREATHE THROUGH THE AUDIT', quip:'YOUR EXTENSION HAS BEEN APPROVED.' },\n  { id:'jog', name:'Island Jog', family:'jog', place:'Island Trail', day:5, duration:45, instruction:'ALTERNATE F AND J TO RUN', quip:'YOU HAVE LAPSED A COCONUT.' },\n  { id:'pier', name:'Pier Jump', family:'jump', place:'Pier', day:5, duration:40, instruction:'STEP TO THE EDGE. BREATHE TO JUMP', quip:'THE WATER GIVES YOU A TEN.' },\n  { id:'plank', name:'Plank Negotiation', family:'still', place:'Pavilion', day:5, duration:35, ring:.24, breath:6, instruction:'KEEP THE DOT IN THE RING. BREATHE', quip:'YOUR CORE HAS COUNTEROFFERED.' },\n];\n\nexport const DAY_NAMES = ['A FRESH START','THE HEAD OF IT','A NARROW VIEW','WEALTH AND HEALTH','THE LONG WAY ROUND','A LITTLE MORE','THE LONG STAND'];\nexport const FRIENDS = ['COACH PLUMB','MABEL','FRANK','KEVIN'];\nexport function activityForDay(day) { return ACTIVITIES.filter(activity => activity.day <= Math.min(day, 5)); }\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&display=swap');\n:root{font-family:'DM Sans',system-ui,sans-serif;color:#253e43;background:#cce8dc;font-synthesis:none;--ink:#253e43;--cream:#fbfaf0;--mint:#dcefe4;--orange:#ef795f;--yellow:#f7c96f;--line:#d3e0d8}\n*{box-sizing:border-box}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden}\nbutton,input,select{font:inherit}\nbutton{cursor:pointer}\nbutton:focus-visible,input:focus-visible,select:focus-visible{outline:4px solid #f19d5d;outline-offset:3px}\n#world,#ui{position:fixed;inset:0}\n#world{background:linear-gradient(155deg,#deefe4 0%,#c5e6dc 54%,#8dcfca 100%);overflow:hidden}\n#world canvas{display:block;width:100%;height:100%}\n#ui{z-index:2;overflow:hidden;pointer-events:none}\n.screen{position:absolute;inset:0;display:flex;align-items:center;padding:clamp(20px,4vw,64px);pointer-events:none}\n.screen>*{pointer-events:auto}\n.panel{width:min(550px,100%);max-height:100%;overflow:auto;scrollbar-width:thin;scrollbar-color:#a8bfb2 transparent}\n.glass{background:rgba(251,250,240,.96);border:1px solid rgba(255,255,255,.8);border-radius:28px;box-shadow:0 18px 60px #285a4c1c;padding:clamp(22px,3vw,40px)}\n.brand{display:inline-flex;align-items:center;gap:9px;font:700 13px 'Fredoka',sans-serif;letter-spacing:.13em;text-transform:uppercase;color:#558477}\n.brand-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:10px;background:var(--ink);color:#fff5dd;font-size:16px}\n.eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#73988a}\n.title{font:600 clamp(54px,7.5vw,100px)/.91 'Fredoka',system-ui,sans-serif;letter-spacing:-.055em;margin:30px 0 16px;color:#294943}\n.title span{color:#e97960}\n.lede{font-size:clamp(15px,1.5vw,18px);line-height:1.5;color:#607b70;max-width:390px}\n.title-tag{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:#f7dca2;font-size:10px;font-weight:700;letter-spacing:.12em;color:#785c29;text-transform:uppercase}\n.title-tag:before{content:'';width:7px;height:7px;background:#e98d5e;border-radius:100%}\n.menu{display:grid;gap:9px;margin-top:27px}\n.button{min-height:54px;border:0;border-radius:15px;padding:13px 18px;display:flex;align-items:center;gap:12px;text-align:left;font-weight:700;color:var(--ink);background:#e8f1e8;transition:transform .15s,background .15s,box-shadow .15s}\n.button:hover,.button.focused{transform:translateX(4px);background:#dcece0}\n.button.primary{color:#fff;background:#ef795f;box-shadow:0 5px 0 #d86350}\n.button.primary:hover,.button.primary.focused{background:#e76a52}\n.button .arrow{margin-left:auto;font-size:19px;font-weight:400}\n.button.small{min-height:42px;padding:9px 14px;font-size:13px;border-radius:11px}\n.button.ghost{background:#f2f4e9}\n.menu-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}\n.footnote{margin-top:23px;display:flex;gap:12px;align-items:center;color:#779288;font-size:11px;font-weight:700;letter-spacing:.05em}\n.key{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 6px;border:1px solid #bed0c4;border-radius:7px;background:#fff;font-size:11px;color:#49685c}\n.hero-note{position:absolute;right:6vw;bottom:6vh;text-align:right;color:#fff;text-shadow:0 1px 10px #28574e65;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;line-height:1.7}\n.hero-note strong{font:500 29px/1.2 'Fredoka',sans-serif;letter-spacing:0;display:block;text-transform:none}\n.topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}\n.back{border:0;background:#e9f1e8;color:#456b5c;border-radius:50%;width:40px;height:40px;font-size:19px}\n.heading{font:600 clamp(31px,4vw,45px)/1 'Fredoka',sans-serif;letter-spacing:-.035em;margin:6px 0 10px}\n.description{margin:0;color:#6b8378;line-height:1.5;font-size:14px}\n.stack{display:grid;gap:9px;margin-top:22px}\n.list-item{position:relative;border:1px solid #e1e9de;border-radius:16px;background:#fff;min-height:66px;padding:12px 14px;display:flex;align-items:center;text-align:left;gap:12px;width:100%;color:var(--ink)}\n.list-item:hover,.list-item.focused{border-color:#ef9f88;box-shadow:0 3px 0 #f5c3b0}\n.list-item:disabled{opacity:.52;cursor:not-allowed}\n.list-item .icon{flex:none;width:41px;height:41px;border-radius:13px;display:grid;place-items:center;background:#dcefe5;font-size:21px}\n.list-item .name{display:block;font:600 16px 'Fredoka',sans-serif}\n.list-item .sub{display:block;color:#89a094;font-size:11px;margin-top:3px}\n.list-item .arrow{margin-left:auto;color:#98afa1}\n.badge{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:#e5f0e6;color:#658679}\n.badge.sun{background:#ffefd2;color:#a2752c}\n.badge.coral{background:#ffebe4;color:#c96951}\n.scroll-list{max-height:min(45vh,400px);overflow:auto;padding:1px 4px 4px 1px}\n.profile-card{display:flex;align-items:center;gap:12px}\n.profile-avatar{height:44px;width:44px;border-radius:50%;background:#f3c394;display:grid;place-items:center;font-size:23px}\n.profile-info strong{font:600 15px 'Fredoka',sans-serif}\n.profile-info small{display:block;color:#86a094;margin-top:3px}\n.island-screen{align-items:stretch}\n.island-screen .panel{width:min(520px,100%)}\n.stats{display:flex;gap:7px;flex-wrap:wrap;margin:16px 0}\n.stats span{padding:7px 10px;border-radius:9px;background:#edf3e9;font-size:11px;font-weight:700;color:#6d8b7d}\n.actions{display:flex;gap:9px;margin-top:18px}\n.actions>*{flex:1}\n.section-label{margin:21px 0 10px;color:#8aa296;font-size:10px;letter-spacing:.14em;text-transform:uppercase;font-weight:700}\n.guide{display:flex;gap:13px;align-items:flex-start;background:#e5f1e7;padding:14px;border-radius:15px;margin-top:21px}\n.ounce{flex:none;width:45px;height:40px;border-radius:13px 13px 16px 16px;background:#fdfcf3;box-shadow:inset 0 -5px 0 #dce3d9;position:relative}\n","exit_code":0,"status":"completed"}}
