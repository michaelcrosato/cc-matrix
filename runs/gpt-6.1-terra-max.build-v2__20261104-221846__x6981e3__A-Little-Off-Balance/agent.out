{"type":"item.started","item":{"id":"item_487","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /tmp/viewport-matrix/alob-fallback && PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 python3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom urllib.parse import quote\nurl='http://127.0.0.1:39559/'+quote('A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html')\nwith sync_playwright() as p:\n    for name, engine, opts in [('phone', p.webkit, p.devices['iPhone SE']), ('desktop', p.webkit, {'viewport':{'width':1366,'height':768}}), ('tablet', p.webkit, p.devices['iPad Mini'])]:\n        browser=engine.launch(headless=True)\n        context=browser.new_context(**opts)\n        page=context.new_page(); page.goto(url, wait_until='load');page.wait_for_timeout(300)\n        page.screenshot(path=f'/tmp/viewport-matrix/alob-fallback/{name}.png')\n        print(name,page.title(),page.locator('.fallback-avatar').is_visible(),page.evaluate('document.documentElement.scrollWidth <= innerWidth'))\n        browser.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_487","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /tmp/viewport-matrix/alob-fallback && PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 python3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom urllib.parse import quote\nurl='http://127.0.0.1:39559/'+quote('A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html')\nwith sync_playwright() as p:\n    for name, engine, opts in [('phone', p.webkit, p.devices['iPhone SE']), ('desktop', p.webkit, {'viewport':{'width':1366,'height':768}}), ('tablet', p.webkit, p.devices['iPad Mini'])]:\n        browser=engine.launch(headless=True)\n        context=browser.new_context(**opts)\n        page=context.new_page(); page.goto(url, wait_until='load');page.wait_for_timeout(300)\n        page.screenshot(path=f'/tmp/viewport-matrix/alob-fallback/{name}.png')\n        print(name,page.title(),page.locator('.fallback-avatar').is_visible(),page.evaluate('document.documentElement.scrollWidth <= innerWidth'))\n        browser.close()\nPY\"","aggregated_output":"phone A Little Off Balance True True\ndesktop A Little Off Balance True True\ntablet A Little Off Balance True True\n","exit_code":0,"status":"completed"}}
