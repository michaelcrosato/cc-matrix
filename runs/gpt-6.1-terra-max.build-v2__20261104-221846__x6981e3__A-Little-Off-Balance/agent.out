{"type":"item.started","item":{"id":"item_440","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom urllib.parse import quote,urlencode\nbase='http://127.0.0.1:39559/'\nname='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'\nurl=base+quote(name)+'/vendor/hub/harness.html?'+urlencode({'game':'/'+name+'.html','auto':'1','players':'2'})\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True)\n page=browser.new_page()\n page.goto(url,wait_until='load')\n page.wait_for_function(\\\"Array.from(document.querySelectorAll('iframe')).filter(f=>{try{return f.contentWindow.__GAME__?.state().screen==='game'}catch{return false}}).length===2\\\",timeout=30000)\n frames=[f for f in page.frames if f\"'!=page.main_frame and f.evaluate(\"!!window.__GAME__\")]\n print('\"'players:',len(frames))\n for f in frames: print('patch time:',f.evaluate(\\\"window.fakeClock=0; AIHub.time=()=>window.fakeClock; AIHub.time()\\\"))\n for clock in [0,55000,65000,120000,130000,185000]:\n  for f in frames: f.evaluate('(value)=>window.fakeClock=value', clock)\n  page.wait_for_timeout(90)\n  print(clock,[(f.evaluate(\\\"__GAME__.state().screen\\\"),f.evaluate(\\\"__GAME__.state().activity\\\")) for f in frames])\n browser.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_440","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom urllib.parse import quote,urlencode\nbase='http://127.0.0.1:39559/'\nname='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'\nurl=base+quote(name)+'/vendor/hub/harness.html?'+urlencode({'game':'/'+name+'.html','auto':'1','players':'2'})\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True)\n page=browser.new_page()\n page.goto(url,wait_until='load')\n page.wait_for_function(\\\"Array.from(document.querySelectorAll('iframe')).filter(f=>{try{return f.contentWindow.__GAME__?.state().screen==='game'}catch{return false}}).length===2\\\",timeout=30000)\n frames=[f for f in page.frames if f\"'!=page.main_frame and f.evaluate(\"!!window.__GAME__\")]\n print('\"'players:',len(frames))\n for f in frames: print('patch time:',f.evaluate(\\\"window.fakeClock=0; AIHub.time=()=>window.fakeClock; AIHub.time()\\\"))\n for clock in [0,55000,65000,120000,130000,185000]:\n  for f in frames: f.evaluate('(value)=>window.fakeClock=value', clock)\n  page.wait_for_timeout(90)\n  print(clock,[(f.evaluate(\\\"__GAME__.state().screen\\\"),f.evaluate(\\\"__GAME__.state().activity\\\")) for f in frames])\n browser.close()\nPY\"","aggregated_output":"players: 2\npatch time: 0\npatch time: 0\n0 [('game', 'warrior'), ('game', 'warrior')]\n55000 [('game', 'warrior'), ('game', 'warrior')]\n65000 [('game', 'hoop'), ('game', 'hoop')]\n120000 [('game', 'hoop'), ('game', 'hoop')]\n130000 [('game', 'header'), ('game', 'header')]\n185000 [('hub-finished', 'header'), ('hub-finished', 'header')]\n","exit_code":0,"status":"completed"}}
