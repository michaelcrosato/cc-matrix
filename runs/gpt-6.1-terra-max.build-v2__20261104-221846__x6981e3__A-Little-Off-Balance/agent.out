{"type":"item.started","item":{"id":"item_442","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nwith sync_playwright() as p:\n print([k for k in p.devices.keys() if k.startswith('iPhone SE') or k.startswith('iPad Mini')])\nPY\nmkdir -p /tmp/viewport-matrix/alob-gameplay\npython3 - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nfrom urllib.parse import quote\nroot=Path.cwd(); title='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\nurl='http://127.0.0.1:39559/'+quote(title)\nfileurl=(root/title).as_uri()\nwith sync_playwright() as p:\n for name in ['chromium','firefox','webkit']:\n  b=getattr(p,name).launch(); page=b.new_page(viewport={'width':1280,'height':800}); errors=[]\n  page.on('pageerror',lambda e:errors.append(str(e)))\n  page.goto(fileurl); page.locator('[data-action=\\\"slots\\\"]').click(); page.locator('[data-action=\\\"slot\\\"]').first.click()\n  print(name,'file://',page.evaluate('__GAME__.state().screen'),'errors',errors)\n  b.close()\n for label,device in [('phone','iPhone SE'),('tablet','iPad Mini')]:\n  b=p.webkit.launch(); context=b.new_context(**p.devices[device]); page=context.new_page(); errors=[]\n  page.on('pageerror',lambda e:errors.append(str(e))); page.goto(url)\n  page.keyboard.press('Enter'); page.locator('[data-action=\\\"slots\\\"]').click(); page.locator('[data-action=\\\"slot\\\"]').first.click()\n  page.evaluate(\\\"__GAME__.go('game',{id:'tree'})\\\"); page.wait_for_timeout(500)\n  page.screenshot(path=f'/tmp/viewport-matrix/alob-gameplay/{label}-webkit.png',full_page=True)\n  print(label,'overflow',page.evaluate('document.documentElement.scrollWidth > innerWidth'),'errors',errors)\n  b.close()\n b=p.chromium.launch(args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-angle=swiftshader','--use-vulkan=swiftshader','--use-webgpu-adapter=swiftshader'])\n page=b.new_page(viewport={'width':1920,'height':1080}); page.goto(url); page.locator('[data-action=\\\"slots\\\"]').click(); page.locator('[data-action=\\\"slot\\\"]').first.click(); page.evaluate(\\\"__GAME__.go('game',{id:'tree'})\\\"); page.wait_for_timeout(1000); page.screenshot(path='/tmp/viewport-matrix/alob-gameplay/wide-chromium.png'); print('wide overflow',page.evaluate('document.documentElement.scrollWidth > innerWidth')); b.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
