{"type":"item.completed","item":{"id":"item_332","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -n 'params.get\\\\(.game.|gameURL|gameUrl|game=|__hubCheck|dataset.complete|player|auto' \\\"\"'$DEV/vendor/hub/harness.html\" | tail -55; rg -n '\"'connect\\\\(|ready\\\\(|function connect|connect:' \\\"\"'$DEV/vendor/hub/session.js\"; rg -n '\"'hub-card|family-start|function go|function begin|function finish|card|data-action' \\\"\"'$DEV/src/main.js\"'","aggregated_output":"26:  .cell__state { margin-left: auto; color: var(--dim); }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n46:  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n54:  <button id=\"remove\" type=\"button\">Remove player</button>\n58:  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n72:const auto = params.get('auto') === '1';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n79:for (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n103:      players: meta('hub:session-players'),\n114: * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n115: * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n117:const gameUrl = (game, { tag, seed } = {}) => {\n163:  if (!gameUrl(game)) {\n167:  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n173:  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n187:    players,\n208:  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n249:    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n254:  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n286:/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\n301:  const players = state.cells.filter((c) => !c.server && !c.gone);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n328:  $('who').replaceChildren(...state.cells.map((c) => new Option(`${c.name} (${c.key})${c.server ? ' — host, no player' : c.slot === 0 && !serverMode ? ' — host' : ''}`, c.key)));\n335:    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\n349:  const lines = [`Round ${s.round} · ${s.mode || 'mode unknown'} · phase ${s.phase}`, `Host: ${s.server ? 'the server, no player' : `player ${s.host}`} · seed ${state.seed}`];\n352:    const name = (id) => s.players[id]?.name ?? `#${id}`;\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n416:      check('game named', false, 'pass ?game=<path> of a page on this site');\n422:    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n424:    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n427:    // Every copy: the players, and in a server round the server's copy.\n428:    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n434:    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n442:    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n443:    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n445:      const players = state.cells.filter((c) => !c.server);\n446:      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n447:      for (const cell of players) poke(cell, 'Enter');\n448:      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n449:      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n486:        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n489:      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n500:      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n502:      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n527:    document.body.dataset.complete = 'true';\n544:if (auto) conformance();\n36:    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n327:  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n17:const button=(label,action,extra='',style='')=>`<button class=\"button ${style}\" data-action=\"${action}\" ${extra}>${label}<span class=\"arrow\">↗</span></button>`;\n18:const back=target=>`<button class=\"back\" data-action=\"${target}\" aria-label=\"Go back\">←</button>`;\n33:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">YOUR WEEK</span></div>${heading('A PLACE TO BEGIN','Who is stepping on?','Choose a profile. Your island remembers your progress on this device.')}<div class=\"stack\">${app.profiles.map((item,index)=>`<button class=\"list-item\" data-action=\"slot\" data-index=\"${index}\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">${item?escape(item.name):'Start a new week'}</span><span class=\"sub\">${item?`DAY ${item.day} · ${item.drips} DRIPS`:'EMPTY PROFILE'}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div>${footer()}`);\n36:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge sun\">✦ ${player.drips} DRIPS</span></div>${heading(`DAY ${day} / 7 · ${DAY_NAMES[day-1]}`,'Good to see you. ',`Ounce says: “${day===7?'Today, we stand together. And I owe you an explanation.':'The island is ready when you are.'}”`)}<div class=\"stats\"><span class=\"badge\">${escape(player.name)}</span> <span class=\"badge\">${player.stars} STARS</span> <span class=\"badge\">WOBBLE AGE ${player.history.length?wobbleAge(player):'—'}</span></div><div class=\"stack\"><button class=\"list-item\" data-action=\"weigh\"><span class=\"icon\">◉</span><span><span class=\"name\">Daily weigh-in</span><span class=\"sub\">THREE LITTLE BALANCE CHECKS</span></span><span class=\"arrow\">→</span></button>${day===7?`<button class=\"list-item\" data-action=\"finale\"><span class=\"icon\">✦</span><span><span class=\"name\">The Long Stand</span><span class=\"sub\">YOUR WEEK FINALE</span></span><span class=\"arrow\">→</span></button>`:''}</div><div class=\"eyebrow\" style=\"margin-top:20px\">PICK A PRACTICE · ${activities.length} OPEN</div><div class=\"scroll-list stack\">${activities.map(activity=>`<button class=\"list-item\" data-action=\"intro\" data-id=\"${activity.id}\"><span class=\"icon\">${iconFor(activity.family)}</span><span><span class=\"name\">${escape(activity.name)}</span><span class=\"sub\">${escape(activity.place.toUpperCase())} · ${activity.duration} SEC ${player.played[activity.id]?`· ${'★'.repeat(player.played[activity.id])}`:''}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div><div class=\"menu-row\" style=\"margin-top:12px\">${button('Day report','day-report','','small')}${button('Settings','settings','','small ghost')}</div>${footer()}`,'island-screen');\n39:    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',escape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to breathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','start','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n42:    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n52:    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have collected ${player.drips} drips and ${player.stars} stars. You showed up; the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S NOTE</strong><p>${player.day===6?'Tomorrow is the Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a perfectly planned nap. Usually.'}</p></div><div class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n56:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take turns through a three-event medley. Highest total wins; kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} ${number===1?'player':'players'}`,'family-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n67:  }else if(app.screen==='hub-card'){\n75:function go(screen){app.screen=screen;render();}\n76:function begin(activity,options={}){\n79:function finish(){\n110:  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n121:ui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\n178:function setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>{app.hubClosed=false;go('hub-card');});hub.on('start',()=>{app.hubClosed=false;app.hubRound=true;app.hubEnded=false;app.hubScores={};app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&!app.hubEnded){const result=app.hubTotal+(app.session?.result().score||0);app.hubEnded=true;hub.result({score:result});app.result={...app.session.result(),score:result,stars:0,drips:0};app.hubRound=false;go('results');}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;app.hubClosed=true;sound.context?.suspend();});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.ready();}\n","exit_code":0,"status":"completed"}}
