und();\n--\n451-    releaseRound(state);\n452-    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n453:    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n454-    if (!started || state.record) return;\n455-\n--\n494-    }\n495-\n496:    if (!state.record) state.coordinator.timeUp();\n497-    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n498-    const record = state.record;\n--\n525-    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n526-    report.done = true;\n527:    document.body.dataset.complete = 'true';\n528-    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n529-  }\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n    out.players = hub.players.slice();\n    return out;\n  }\n\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n  hub.connect = function (opts) {\n    if (connecting) return connecting.promise;\n    var done;\n    var promise = new Promise(function (resolve) {\n      done = resolve;\n    });\n    connecting = { promise: promise, resolve: done };\n    if (!hub.active) {\n      done(null);\n      return promise;\n    }\n    opts = opts || {};\n    root.addEventListener('message', onMessage);\n    var started = now();\n    var hello = function () {\n      if (welcomed) return;\n      if (now() - started > HELLO_TIMEOUT_MS) {\n        standAlone();\n        warn('no hub answered; playing normally');\n        done(null);\n        return;\n      }\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n      setTimeout(hello, HELLO_EVERY_MS);\n    };\n    hello();\n    return promise;\n  };\n\n  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n  hub.ready = function () {\n    if (!welcomed || sentReady || ended) return;\n    sentReady = true;\n    post('ready', {});\n  };\n\n  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n  hub.answer = function (what) {\n    if (!welcomed || ended || goAt !== null) return;\n    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n    post('answer', { answer: what });\n  };\n\n  hub.on = function (type, fn) {\n    (handlers[type] = handlers[type] || []).push(fn);\n    if (pending[type] && !pending[type].flushing) {\n      pending[type].flushing = true;\n      setTimeout(function () {\n        var queued = pending[type];\n        delete pending[type];\n        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n      });\n    }\n    return function () {\n      var list = handlers[type] || [];\n      var at = list.indexOf(fn);\n      if (at !== -1) list.splice(at, 1);\n    };\n  };\n\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n      h ^= s.charCodeAt(i);\n      h = Math.imul(h, 16777619);\n    }\n    return generator((hub.seed ^ h) >>> 0);\n  };\n\n  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n  function finite(v) {\n    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\nimport { Engine, THREE, toonMaterial, withUrlOptions } from '../pixel-engine.js';\n\nconst { BoxGeometry, CylinderGeometry, SphereGeometry, ConeGeometry, Mesh, Group, Vector3 } = THREE;\n\nclass IslandScene {\n  name = 'A Little Off Balance';\n  target = new Vector3(0, .6, 0);\n  constructor(game) { this.game = game; }\n  setup({ scene, engine }) {\n    engine.sun.intensity = 1.8;\n    const material = color => toonMaterial(color);\n    const box = (parent, color, size, position) => {\n      const mesh = new Mesh(new BoxGeometry(...size), material(color));\n      mesh.position.set(...position); mesh.castShadow = true; mesh.receiveShadow = true; parent.add(mesh); return mesh;\n    };\n    const cylinder = (parent, color, top, bottom, height, position, sides = 24) => {\n      const mesh = new Mesh(new CylinderGeometry(top, bottom, height, sides), material(color));\n      mesh.position.set(...position); mesh.castShadow = true; mesh.receiveShadow = true; parent.add(mesh); return mesh;\n    };\n    cylinder(scene, 0xc8a578, 5.6, 5.15, .65, [0, -.38, 0], 48);\n    cylinder(scene, 0x8cbe8b, 5.5, 5.6, .18, [0, 0, 0], 48);\n    cylinder(scene, 0xf5e3bc, 2.45, 2.45, .035, [0, .11, .1], 48);\n    for (const [x,z,scale] of [[-4,-2,1.1],[-3.8,2.5,.8],[3.5,-2.8,1],[4.2,2,.85],[-1,-4.4,.8]]) {\n      cylinder(scene, 0x9a795d, .12, .18, 1.2*scale, [x,.6*scale,z], 8);\n      const crown = new Mesh(new SphereGeometry(.65*scale, 9, 7), material(0x5c9c70)); crown.position.set(x,1.45*scale,z); crown.castShadow=true; scene.add(crown);\n    }\n    for (const [x,z,color] of [[-2.7,-2.5,0xe38c70],[2.5,-2.7,0xe9b96f],[3.1,.45,0x82aec1]]) {\n      box(scene, 0xf7e8cf, [1.4,1.1,1.15], [x,.67,z]);\n      const roof=new Mesh(new ConeGeometry(1.14,.65,4),material(color)); roof.position.set(x,1.53,z); roof.rotation.y=Math.PI/4; roof.castShadow=true; scene.add(roof);\n      box(scene,0x759b91,[.25,.38,.03],[x,.65,z+.59]);\n    }\n    cylinder(scene,0x8cb7ba,.75,.75,.09,[2.4,.13,2.15]);\n    const board=box(scene,0xf8f4df,[.75,.15,.55],[-.3,.2,.5]); board.rotation.y=-.25;\n    this.hero=new Group(); this.hero.position.set(-.3,.3,.5); scene.add(this.hero);\n    cylinder(this.hero,0xe8866b,.27,.34,.65,[0,.58,0],12);\n    const head=new Mesh(new SphereGeometry(.29,12,10),material(0xf1c29d));head.position.set(0,1.13,0);this.hero.add(head);\n    box(this.hero,0x455d59,[.12,.42,.12],[-.17,.04,0]);box(this.hero,0x455d59,[.12,.42,.12],[.17,.04,0]);\n    const left=box(this.hero,0xe8b995,[.12,.5,.12],[-.36,.64,0]);left.rotation.z=-.7;\n    const right=box(this.hero,0xe8b995,[.12,.5,.12],[.36,.64,0]);right.rotation.z=.7;\n    this.mixer=new THREE.AnimationMixer(this.hero);\n    this.mixer.clipAction(new THREE.AnimationClip('idle',2,[new THREE.NumberKeyframeTrack('.position[y]',[0,1,2],[.3,.34,.3])])).play();\n    const ounce=box(scene,0xf9faf1,[.72,.45,.53],[.9,.35,1.3]);\n    box(scene,0x9cc5b6,[.38,.08,.015],[.9,.42,1.58]); ounce.rotation.y=-.2;\n  }\n  update(ctx, dt) {\n    this.mixer?.update(dt);\n    if (this.hero && this.game.session) {\n      this.hero.rotation.z = -this.game.session.dot.x*.27;\n      this.hero.rotation.x = this.game.session.dot.y*.2;\n    } else if (this.hero) { this.hero.rotation.z *= .95; this.hero.rotation.x *= .95; }\n    ctx.hud.clear();\n  }\n  cameraTarget() { return this.target; }\n  status() { return `island: ${this.game.screen}`; }\n}\n\nexport async function startWorld(game) {\n  if (!navigator.gpu) return;\n  try { if (!await navigator.gpu.requestAdapter()) return; } catch { return; }\n  return Engine.start(new IslandScene(game), withUrlOptions({container:document.getElementById('world'),aspect:'fill',touch:false,background:0xc9e8dc,camera:{preset:'iso',zoom:1.05}}));\n}\n","exit_code":0,"status":"completed"}}
