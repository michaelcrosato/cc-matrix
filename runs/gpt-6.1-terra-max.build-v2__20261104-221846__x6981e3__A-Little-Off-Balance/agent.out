{"type":"item.completed","item":{"id":"item_348","type":"command_execution","command":"/bin/bash -lc \"nl -ba 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js' | sed -n '45,220p'; sed -n '160,320p' 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/vendor/hub/README.md'; rg -n 'function (connect|ready)|async function connect|card|function send|function progress|function result|return \\\\{|on\\\\(' 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/vendor/hub/session.js' | tail -n 70; sed -n '400,530p' 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/vendor/hub/harness.html'\"","aggregated_output":"    45\t  }else if(app.screen==='results'){\n    46\t    const result=app.result;\n    47\t    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND IS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;color:#8ca397\"> / 100</small></div><div class=\"stars\">${'★'.repeat(result.stars)}${'☆'.repeat(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS OF YOU TIME</span></div><div class=\"menu\">${button(app.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the island','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</div>${footer()}`);\n    48\t  }else if(app.screen==='weigh-result'){\n    49\t    content=panel(`<div class=\"topline\"><span class=\"badge\">DAILY CHECK-IN</span></div>${heading('A NUMBER, NOT A VERDICT','Your wobble age','Ounce has reviewed your three balance checks with tremendous confidence.')}<div class=\"score-hero\">${wobbleAge(profile())}</div><p class=\"description\">This is just a playful score, not a measure of health. Keep moving at your own pace.</p><div class=\"menu\">${button('Back to the island','island','','primary')}</div>${footer()}`);\n    50\t  }else if(app.screen==='day-report'){\n    51\t    const player=profile();\n    52\t    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have collected ${player.drips} drips and ${player.stars} stars. You showed up; the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S NOTE</strong><p>${player.day===6?'Tomorrow is the Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a perfectly planned nap. Usually.'}</p></div><div class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n    53\t  }else if(app.screen==='reveal'){\n    54\t    content=panel(`${brand}${heading('THE LONG STAND','Ounce comes clean.','“I added seven years to everyone’s wobble age. I thought you would come back if the number worried you. That was wrong.”')}<p class=\"description\" style=\"margin-top:16px\">The island agrees: a number should never tell you your worth. Your wobble age is now honest, and the island remains open.</p><div class=\"menu\">${button('A fresh start','island','','primary')}</div>`);\n    55\t  }else if(app.screen==='family'){\n    56\t    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take turns through a three-event medley. Highest total wins; kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} ${number===1?'player':'players'}`,'family-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n    57\t  }else if(app.screen==='medley-board'){\n    58\t    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n    59\t    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the spotlight.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER ${entry.index+1}</span><span class=\"sub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n    60\t  }else if(app.screen==='settings'||app.screen==='dev'){\n    61\t    const dev=app.screen==='dev';\n    62\t    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" min=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Math.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':''}>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n    63\t    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER TOOLS':'YOUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\"stack\">${ranges}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\n    64\t  }else if(app.screen==='about'){\n    65\t    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n    66\t    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful tribute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: ${value}`))}${section('Testing Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt Feedback',about.promptFeedback)}</div>${footer()}`);\n    67\t  }else if(app.screen==='hub-card'){\n    68\t    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div class=\"menu\">${button('Ready','hub-ready','','primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n    69\t  }\n    70\t  ui.innerHTML=content;\n    71\t  app.focus=0;\n    72\t  const first=ui.querySelector('button:not(:disabled)');if(first&&app.inputKind==='gamepad')first.classList.add('focused');\n    73\t}\n    74\t\n    75\tfunction go(screen){app.screen=screen;render();}\n    76\tfunction begin(activity,options={}){\n    77\t  app.activity=activity;app.session=new ActivitySession(activity,{hard:app.hard,tuning:app.tuning,...options});app.paused=false;go('game');\n    78\t}\n    79\tfunction finish(){\n    80\t  if(!app.session)return;\n    81\t  app.result=app.session.result();\n    82\t  if(app.attract){app.attractIndex++;startAttract();return;}\n    83\t  if(app.hubRound){advanceHub();return;}\n    84\t  if(app.weigh){app.weigh.push(app.result.score/100);if(app.weigh.length<3){startWeigh();return;}profile().history.push(...app.weigh);profile().history=profile().history.slice(-3);app.weigh=null;save();go('weigh-result');return;}\n    85\t  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;go('results');return;}\n    86\t  if(profile()){const player=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=Math.max(app.result.stars,player.played[app.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n    87\t  sound.effect('good');go('results');\n    88\t}\n    89\tfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the breeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});}\n    90\tfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\n    91\tfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const activity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequence.length]);begin(activity,{duration:12});}\n    92\tfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\n    93\tfunction act(action,element){\n    94\t  sound.unlock();sound.effect('select');app.lastInput=performance.now();\n    95\t  if(app.attract){leaveAttract();return;}\n    96\t  if(action==='title'){app.session=null;app.medley=null;app.guest=null;go('title');}\n    97\t  else if(action==='slots')go('slots');\n    98\t  else if(action==='slot'){app.guest=null;app.slot=Number(element.dataset.index);if(!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('island');}\n    99\t  else if(action==='dropin'){app.guest=makeProfile('GUEST');app.guest.day=7;app.guest.revealed=true;app.returnScreen='island';go('island');}\n   100\t  else if(action==='island'){app.medley=null;app.weigh=null;go('island');}\n   101\t  else if(action==='intro'){app.activity=ACTIVITIES.find(item=>item.id===element.dataset.id);app.returnScreen='island';app.hard=false;sound.effect('voice');go('intro');}\n   102\t  else if(action==='hard'){app.hard=!app.hard;render();}\n   103\t  else if(action==='start')begin(app.activity);\n   104\t  else if(action==='weigh'){app.weigh=[];startWeigh();}\n   105\t  else if(action==='finale'){app.activity={...ACTIVITIES[0],id:'finale',name:'The Long Stand',place:'Pavilion',duration:45,ring:.32,quip:'A LITTLE HONESTY GOES A LONG WAY.'};app.returnScreen='island';go('intro');}\n   106\t  else if(action==='continue'){if(app.medley){app.medley.player++;if(app.medley.player>=app.medley.scores.length){app.medley.player=0;app.medley.event++;}if(app.medley.event>=3)go('medley-board');else startMedley();}else go('island');}\n   107\t  else if(action==='day-report')go('day-report');\n   108\t  else if(action==='next-day'){if(profile().day<7)profile().day++;save();go('island');}\n   109\t  else if(action==='family')go('family');\n   110\t  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n   111\t  else if(action==='settings'){app.settingsFrom=app.screen;go('settings');}\n   112\t  else if(action==='settings-back')go(app.screen==='dev'?'pause':app.settingsFrom||'title');\n   113\t  else if(action==='dev')go('dev');\n   114\t  else if(action==='reset-tuning'){app.tuning={...DEFAULT_TUNABLES};if(app.session)app.session.tuning={...app.tuning};render();}\n   115\t  else if(action==='resume'){app.paused=false;go('game');}\n   116\t  else if(action==='leave'){app.session=null;app.medley=null;app.weigh=null;go(profile()?'island':'title');}\n   117\t  else if(action==='about')go('about');\n   118\t  else if(action==='hub-ready')globalThis.AIHub?.answer('ready');\n   119\t  else if(action==='hub-more')globalThis.AIHub?.answer('more');\n   120\t}\n   121\tui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\n   122\tui.addEventListener('pointerover',event=>{const target=event.target.closest('button');if(target){ui.querySelectorAll('button.focused').forEach(item=>item.classList.remove('focused'));target.classList.add('focused');app.focus=Array.from(ui.querySelectorAll('button:not(:disabled)')).indexOf(target);}});\n   123\tui.addEventListener('input',event=>{const target=event.target;if(target.dataset.setting){const key=target.dataset.setting;app.settings[key]=target.type==='checkbox'?target.checked:target.type==='range'?Number(target.value):target.value;save();document.body.classList.toggle('high-contrast',app.settings.contrast);document.body.classList.toggle('reduce-motion',app.settings.motion);}if(target.dataset.tune){app.tuning[target.dataset.tune]=Number(target.value);if(app.session)app.session.tuning={...app.tuning};}});\n   124\tfunction menuMove(delta){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));if(!buttons.length)return;app.focus=(app.focus+delta+buttons.length)%buttons.length;buttons.forEach((item,index)=>item.classList.toggle('focused',index===app.focus));buttons[app.focus].focus();buttons[app.focus].scrollIntoView({block:'nearest'});}\n   125\tfunction pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\n   126\twindow.addEventListener('keydown',event=>{const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\n   127\twindow.addEventListener('keyup',event=>app.keys.delete(event.key.toLowerCase()));\n   128\twindow.addEventListener('blur',()=>app.keys.clear());\n   129\twindow.addEventListener('pointerdown',event=>{app.lastInput=performance.now();if(app.attract){leaveAttract();return;}sound.unlock();if(event.pointerType==='mouse')app.inputKind='mouse';});\n   130\tui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const rect=dial.getBoundingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.height/2)/(rect.height/2)))};app.lastInput=performance.now();});\n   131\twindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n   132\t\n   133\tfunction gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\n   134\tfunction activityCue(session){\n   135\t  const activity=session.activity,time=session.elapsed;\n   136\t  if(activity.family==='reps'){\n   137\t    const phase=(time/3.2)%1;\n   138\t    const target=phase<.4?phase/.4:phase<.55?1:phase<.9?1-(phase-.55)/.35:0;\n   139\t    return `MATCH ${Math.round(target*100)}% · YOU ${Math.round(session.rep*100)}%`;\n   140\t  }\n   141\t  if(activity.family==='header')return Math.floor(time/2.4)%2===0?'← HEAD LEFT':'HEAD RIGHT →';\n   142\t  if(activity.family==='step')return Math.abs(time/.7-Math.round(time/.7))<.23?'STEP NOW · F OR J':'WAIT FOR THE BEAT';\n   143\t  if(activity.family==='jog')return 'ALTERNATE F AND J';\n   144\t  if(activity.family==='slack')return 'F / J TO WALK THE LINE';\n   145\t  if(activity.family==='jump')return 'SPACE / R2 TO JUMP';\n   146\t  if(activity.family==='hoop')return `CIRCLE THE STICK · ${Math.round(session.hoopLift*100)}% LIFT`;\n   147\t  if(activity.breath)return Math.sin(time*Math.PI*2/activity.breath)>0?'BREATHE IN · HOLD':'BREATHE OUT · RELEASE';\n   148\t  return 'KEEP THE DOT INSIDE THE RING';\n   149\t}\n   150\tfunction frame(now){\n   151\t  const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);\n   152\t  if(app.hubClosed){requestAnimationFrame(frame);return;}\n   153\t  const pad=gamepad();\n   154\t  if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();\n   155\t  if(app.screen==='game'&&app.session){\n   156\t    const seconds=document.getElementById('seconds');\n   157\t    if(app.hubRound&&globalThis.AIHub.time()<0){if(seconds)seconds.textContent=`${Math.ceil(-globalThis.AIHub.time()/1000)}`;app.input.left=false;app.input.right=false;requestAnimationFrame(frame);return;}\n   158\t    let x=Number(app.keys.has('d')||app.keys.has('arrowright'))-Number(app.keys.has('a')||app.keys.has('arrowleft'));\n   159\t    let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.keys.has('w')||app.keys.has('arrowup'));\n   160\t    if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}\n   161\t    if(app.attract){const time=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(Math.floor(time*3)%2===0)app.input.left=true;else app.input.right=true;}\n   162\t    if(app.driver==='perfect'){x=0;y=0;}\n   163\t    app.session.update(dt,{x,y,breath:app.keys.has(' ')||!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;\n   164\t    const dot=document.getElementById('balance-dot'),meter=document.getElementById('meter'),score=document.getElementById('live-score'),cue=document.getElementById('live-cue'),dial=document.getElementById('dial');\n   165\t    if(dot){dot.style.left=`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}\n   166\t    if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));\n   167\t    if(meter)meter.style.width=`${Math.min(100,app.session.elapsed/app.session.duration*100)}%`;\n   168\t    if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'KEEP GOING'}`;\n   169\t    if(cue)cue.textContent=activityCue(app.session);\n   170\t    if(dial&&app.hubRound){dial.querySelectorAll('.ghost-dot').forEach(node=>node.remove());for(const ghost of Object.values(app.hubScores).slice(0,3)){if(!Number.isFinite(ghost?.x)||!Number.isFinite(ghost?.y))continue;const marker=document.createElement('span');marker.className='ghost-dot';marker.style.left=`${50+Math.max(-1,Math.min(1,ghost.x))*38}%`;marker.style.top=`${50+Math.max(-1,Math.min(1,ghost.y))*38}%`;dial.appendChild(marker);}}\n   171\t    if(app.hubRound&&now-app.hubClock>500){app.hubClock=now;const partial=app.hubTotal+app.session.result().score;globalThis.AIHub?.progress({score:partial,label:app.activity.name});globalThis.AIHub?.send({x:app.session.dot.x,y:app.session.dot.y,score:partial});}\n   172\t    if(app.session.finished)finish();\n   173\t  }\n   174\t  requestAnimationFrame(frame);\n   175\t}\n   176\t\n   177\tfunction advanceHub(){if(app.hubEnded)return;app.hubTotal+=app.session.result().score;app.hubEvent++;if(app.hubEvent>=3){app.hubEnded=true;globalThis.AIHub?.result({score:app.hubTotal});app.result={...app.session.result(),score:app.hubTotal,stars:0,drips:0};app.hubRound=false;go('results');}else begin({...ACTIVITIES.find(item=>item.id===['tree','hoop','step'][app.hubEvent])},{duration:20});}\n   178\tfunction setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>{app.hubClosed=false;go('hub-card');});hub.on('start',()=>{app.hubClosed=false;app.hubRound=true;app.hubEnded=false;app.hubScores={};app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&!app.hubEnded){const result=app.hubTotal+(app.session?.result().score||0);app.hubEnded=true;hub.result({score:result});app.result={...app.session.result(),score:result,stars:0,drips:0};app.hubRound=false;go('results');}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;app.hubClosed=true;sound.context?.suspend();});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.ready();}\n   179\twindow.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\n   180\trender();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\n125:  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n191:  function json(value) {\n313:      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n327:  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n415:      var value = json(outcome[key]);\n449:  function sendProgress() {\n477:      return { error: String((e && e.message) || e) };\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_349","type":"reasoning","text":"**Inspecting current state**"}}
{"type":"item.completed","item":{"id":"item_350","type":"agent_message","text":"The online checks exposed a readiness race; I’m fixing it now."}}
{"type":"item.started","item":{"id":"item_351","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -n 'setupHub|hubRound|hub-card|hub\\\\.ready|AIHub|hubTotal|hubEvent' \\\"\"'$DEV/src/main.js\"; rg -n '\"'connect\\\\(|ready\\\\(|cardReady|progress\\\\(|time-up|emit\\\\(' \\\"\"'$DEV/vendor/hub/session.js\" | head -90; sed -n '\"'1,220p' \\\"\"'$DEV/tests/browser.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_351","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -n 'setupHub|hubRound|hub-card|hub\\\\.ready|AIHub|hubTotal|hubEvent' \\\"\"'$DEV/src/main.js\"; rg -n '\"'connect\\\\(|ready\\\\(|cardReady|progress\\\\(|time-up|emit\\\\(' \\\"\"'$DEV/vendor/hub/session.js\" | head -90; sed -n '\"'1,220p' \\\"\"'$DEV/tests/browser.py\"'","aggregated_output":"12:const app={screen:'title',session:null,settings:{music:.1,effects:.7,glyphs:'ps',contrast:false,motion:false,...stored('alob-settings',{})},profiles:stored('alob-profiles',[null,null,null]),slot:0,activity:null,result:null,tuning:{...DEFAULT_TUNABLES},input:{x:0,y:0,breath:false,left:false,right:false},keys:new Set(),lastInput:performance.now(),inputKind:'keyboard',focus:0,paused:false,attract:false,attractIndex:0,medley:null,weigh:null,hubRound:false,hubEnded:false,hubScores:{},hubClock:0,gamepadButtons:[],driver:null};\n42:    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n67:  }else if(app.screen==='hub-card'){\n83:  if(app.hubRound){advanceHub();return;}\n118:  else if(action==='hub-ready')globalThis.AIHub?.answer('ready');\n119:  else if(action==='hub-more')globalThis.AIHub?.answer('more');\n125:function pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\n154:  if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();\n157:    if(app.hubRound&&globalThis.AIHub.time()<0){if(seconds)seconds.textContent=`${Math.ceil(-globalThis.AIHub.time()/1000)}`;app.input.left=false;app.input.right=false;requestAnimationFrame(frame);return;}\n170:    if(dial&&app.hubRound){dial.querySelectorAll('.ghost-dot').forEach(node=>node.remove());for(const ghost of Object.values(app.hubScores).slice(0,3)){if(!Number.isFinite(ghost?.x)||!Number.isFinite(ghost?.y))continue;const marker=document.createElement('span');marker.className='ghost-dot';marker.style.left=`${50+Math.max(-1,Math.min(1,ghost.x))*38}%`;marker.style.top=`${50+Math.max(-1,Math.min(1,ghost.y))*38}%`;dial.appendChild(marker);}}\n171:    if(app.hubRound&&now-app.hubClock>500){app.hubClock=now;const partial=app.hubTotal+app.session.result().score;globalThis.AIHub?.progress({score:partial,label:app.activity.name});globalThis.AIHub?.send({x:app.session.dot.x,y:app.session.dot.y,score:partial});}\n177:function advanceHub(){if(app.hubEnded)return;app.hubTotal+=app.session.result().score;app.hubEvent++;if(app.hubEvent>=3){app.hubEnded=true;globalThis.AIHub?.result({score:app.hubTotal});app.result={...app.session.result(),score:app.hubTotal,stars:0,drips:0};app.hubRound=false;go('results');}else begin({...ACTIVITIES.find(item=>item.id===['tree','hoop','step'][app.hubEvent])},{duration:20});}\n178:function setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>{app.hubClosed=false;go('hub-card');});hub.on('start',()=>{app.hubClosed=false;app.hubRound=true;app.hubEnded=false;app.hubScores={};app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&!app.hubEnded){const result=app.hubTotal+(app.session?.result().score||0);app.hubEnded=true;hub.result({score:result});app.result={...app.session.result(),score:result,stars:0,drips:0};app.hubRound=false;go('results');}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;app.hubClosed=true;sound.context?.suspend();});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.ready();}\n180:render();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\n36:    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n210:  function emit(type, args) {\n261:      emit('start', [{ in: Number(m.in || 0) }]);\n263:      emit('message', [m.data, m.from]);\n268:      emit('leave', [{ id: m.id, reason: m.reason }]);\n269:    } else if (m.type === 'time-up') {\n270:      emit('time-up', [{ graceMs: m.graceMs }]);\n274:      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n279:      emit(m.type, [detail]);\n327:  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n341:        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef complete_week(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        start_profile(page)\n        click(page, 'weigh')\n        for _ in range(3):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n        screen(page, 'weigh-result')\n        assert len(state(page)['profiles'][0]['history']) == 3\n        click(page, 'island')\n        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\n            assert state(page)['day'] == day\n        click(page, 'finale')\n        click(page, 'start')\n        finish(page)\n        screen(page, 'reveal')\n        assert state(page)['profiles'][0]['revealed'] is True\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef family(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        click(page, 'family')\n        click(page, 'family-start', '[data-count=\"2\"]')\n        for _ in range(6):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        screen(page, 'medley-board')\n        assert page.get_by_text('PLAYER 1', exact=True).count() == 1\n        assert page.get_by_text('PLAYER 2', exact=True).count() == 1\n    finally:\n        browser.close()\n\n\ndef mobile(playwright, url):\n    browser = playwright.webkit.launch(headless=True)\n    context = browser.new_context(**playwright.devices['iPhone 17 Pro'])\n    page = context.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        assert page.get_by_text('Controller or keyboard required').is_visible()\n        assert page.locator('[data-action=\"slots\"]').count() == 0\n        click(page, 'settings')\n        assert page.locator('#music').input_value() == '0.1'\n    finally:\n        context.close()\n        browser.close()\n\n\ndef attract(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_function('window.__GAME__.state().attract', timeout=13000)\n        page.keyboard.press('Enter')\n        screen(page, 'title')\n    finally:\n        browser.close()\n\n\ndef webgpu(playwright, url):\n    browser = playwright.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-angle=swiftshader', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_selector('#world canvas', timeout=12000)\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthreading.Thread(target=server.serve_forever, daemon=True).start()\nurl = f'http://127.0.0.1:{server.server_port}/' + urllib.parse.quote(FILENAME)\ntry:\n    with sync_playwright() as playwright:\n        for name in ('chromium', 'firefox', 'webkit'):\n            check(name + ' profile, activity, persistence', lambda name=name: smoke(getattr(playwright, name), url))\n        check('seven-day playthrough and all activities', lambda: complete_week(playwright.chromium, url))\n        check('family medley', lambda: family(playwright.chromium, url))\n        check('touch-only notice', lambda: mobile(playwright, url))\n        check('idle attract and wake', lambda: attract(playwright.chromium, url))\n        check('WebGPU island', lambda: webgpu(playwright, url))\nfinally:\n    server.shutdown()\nprint(json.dumps({'passed': passed, 'failures': failures}))\n","exit_code":0,"status":"completed"}}
