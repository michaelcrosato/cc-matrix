{"type":"item.started","item":{"id":"item_484","type":"command_execution","command":"/bin/bash -lc \"apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/tools/build.mjs\n@@\n-<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Score the most points across three delightfully wobbly events.\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"Left stick or WASD: lean. R2 or Space: breathe. L1/R1 or F/J: step.\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"4\\\"><meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\n+<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Score the most points across three delightfully wobbly events.\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"Left stick or WASD: lean. R2 or Space: breathe. L1/R1 or F/J: step.\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"4\\\">\n@@\n-<body><div id=\\\"world\\\" aria-hidden=\\\"true\\\"><div class=\\\"fallback-island\\\"><i></i><b></b><em></em></div></div><div id=\\\"ui\\\"><main class=\\\"loading\\\">A little moment, please<span>● ● ●</span></main></div><script type=\\\"module\\\">\"'${game}</script></body></html>`;\n+<body><div id=\"world\" aria-hidden=\"true\"><div class=\"fallback-island\"><i></i><b></b><em></em><div class=\"fallback-board\"></div><div class=\"fallback-avatar\"><span class=\"fallback-leg left\"></span><span class=\"fallback-leg right\"></span><span class=\"fallback-arm left\"></span><span class=\"fallback-arm right\"></span><span class=\"fallback-body\"></span><span class=\"fallback-head\"></span></div></div></div><div id=\"ui\"><main class=\"loading\">A little moment, please<span>● ● ●</span></main></div><script type=\"module\">${game}</script></body></html>`;\n*** Update File: A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/ui/overrides.css\n@@\n .ghost-dot{position:absolute;width:14px;height:14px;margin:-7px;border:2px solid white;border-radius:50%;background:#738dd4;opacity:.75;z-index:2;pointer-events:none}\n+.fallback-board{position:absolute;left:50%;top:57%;width:clamp(52px,8vw,105px);height:clamp(15px,2.3vw,29px);transform:translate(-50%,-50%) rotate(8deg);border-radius:50%;background:#faf4e3;box-shadow:0 5px 0 #b5b8a6,0 8px 12px #476d5a55;z-index:2}\n+.fallback-avatar{position:absolute;left:50%;top:57%;width:clamp(45px,7vw,90px);height:clamp(70px,11vw,138px);transform:translate(-50%,-92%) rotate(calc(8deg + var(--avatar-lean,0deg)));transform-origin:50% 92%;z-index:3}\n+.fallback-avatar span{position:absolute;display:block}\n+.fallback-head{left:29%;top:0;width:42%;height:29%;border-radius:48%;background:#f2c49e;box-shadow:inset 0 5px #805f50}\n+.fallback-head:after{content:'\"'';position:absolute;left:32%;top:50%;width:4%;height:6%;border-radius:50%;background:#405d55;box-shadow:1em 0 #405d55}\n+.fallback-body{left:23%;top:25%;width:54%;height:43%;border-radius:40% 40% 30% 30%;background:#e9856c;box-shadow:inset 0 -5px #d77760}\n+.fallback-arm{top:30%;width:14%;height:35%;border-radius:30px;background:#efbd9b;transform-origin:50% 10%}\n+.fallback-arm.left{left:22%;transform:rotate(45deg)}.fallback-arm.right{right:22%;transform:rotate(-45deg)}\n+.fallback-leg{top:62%;width:14%;height:29%;border-radius:20px;background:#46645c}.fallback-leg.left{left:32%;transform:rotate(8deg)}.fallback-leg.right{right:32%;transform:rotate(-8deg)}\n*** Update File: A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js\n@@\n     app.session.update(dt,{x,y,breath:app.keys.has(' ')||\"'!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;\n+    document.documentElement.style.setProperty('\"'--avatar-lean',\"'`${-app.session.dot.x*16}deg`);\n*** End Patch\nPATCH\ncd '\"'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846' && npm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
