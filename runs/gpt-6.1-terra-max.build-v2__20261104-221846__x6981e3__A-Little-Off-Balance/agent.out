{"type":"item.completed","item":{"id":"item_287","type":"command_execution","command":"/bin/bash -lc \"sed -n '58,225p' src/main.js | fold -w 180 -s; printf '\\\\n--- TEST LIBS ---\\\\n'; command -v viewport-matrix; python3 -c 'import playwright; print(\\\"playwright available\\\")'; rg --files tests\"","aggregated_output":"    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the \nspotlight.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER \n${entry.index+1}</span><span class=\"sub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n  }else if(app.screen==='settings'||app.screen==='dev'){\n    const dev=app.screen==='dev';\n    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" \nmin=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music \n${Math.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div \nclass=\"field\"><label for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" \nvalue=\"${app.settings.effects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" \n${app.settings.glyphs==='ps'?'selected':''}>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div \nclass=\"field\"><label for=\"contrast\">High contrast</label><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div \nclass=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER \nTOOLS':'YOUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div \nclass=\"stack\">${ranges}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\n  }else if(app.screen==='about'){\n    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful \ntribute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: \n${value}`))}${section('Testing Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt \nFeedback',about.promptFeedback)}</div>${footer()}`);\n  }else if(app.screen==='hub-card'){\n    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div \nclass=\"menu\">${button('Ready','hub-ready','','primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n  }\n  ui.innerHTML=content;\n  app.focus=0;\n  const first=ui.querySelector('button:not(:disabled)');if(first&&app.inputKind==='gamepad')first.classList.add('focused');\n}\n\nfunction go(screen){app.screen=screen;render();}\nfunction begin(activity,options={}){\n  app.activity=activity;app.session=new ActivitySession(activity,{hard:app.hard,tuning:app.tuning,...options});app.paused=false;go('game');\n}\nfunction finish(){\n  if(!app.session)return;\n  app.result=app.session.result();\n  if(app.attract){app.attractIndex++;startAttract();return;}\n  if(app.hubRound){advanceHub();return;}\n  \nif(app.weigh){app.weigh.push(app.result.score/100);if(app.weigh.length<3){startWeigh();return;}profile().history.push(...app.weigh);profile().history=profile().history.slice(-3);ap\np.weigh=null;save();go('weigh-result');return;}\n  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;go('results');return;}\n  if(profile()){const \nplayer=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=Math.max(app.result.st\nars,player.played[app.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n  sound.effect('good');go('results');\n}\nfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the \nbreeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE \nDRIFT','STAY NEAR THE CENTER'][index]});}\nfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER \n${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\nfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const \nactivity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequence.length]);begin(activity,{duration:12});}\nfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\nfunction act(action,element){\n  sound.unlock();sound.effect('select');app.lastInput=performance.now();\n  if(app.attract){leaveAttract();return;}\n  if(action==='title'){app.session=null;app.medley=null;app.guest=null;go('title');}\n  else if(action==='slots')go('slots');\n  else if(action==='slot'){app.guest=null;app.slot=Number(element.dataset.index);if(!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER \n${app.slot+1}`);save();go('island');}\n  else if(action==='dropin'){app.guest=makeProfile('GUEST');app.guest.day=7;app.guest.revealed=true;app.returnScreen='island';go('island');}\n  else if(action==='island'){app.medley=null;app.weigh=null;go('island');}\n  else if(action==='intro'){app.activity=ACTIVITIES.find(item=>item.id===element.dataset.id);app.returnScreen='island';app.hard=false;sound.effect('voice');go('intro');}\n  else if(action==='hard'){app.hard=!app.hard;render();}\n  else if(action==='start')begin(app.activity);\n  else if(action==='weigh'){app.weigh=[];startWeigh();}\n  else if(action==='finale'){app.activity={...ACTIVITIES[0],id:'finale',name:'The Long Stand',place:'Pavilion',duration:45,ring:.32,quip:'A LITTLE HONESTY GOES A LONG \nWAY.'};app.returnScreen='island';go('intro');}\n  else \nif(action==='continue'){if(app.medley){app.medley.player++;if(app.medley.player>=app.medley.scores.length){app.medley.player=0;app.medley.event++;}if(app.medley.event>=3)go('medley\n-board');else startMedley();}else go('island');}\n  else if(action==='day-report')go('day-report');\n  else if(action==='next-day'){if(profile().day<7)profile().day++;save();go('island');}\n  else if(action==='family')go('family');\n  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n  else if(action==='settings'){app.settingsFrom=app.screen;go('settings');}\n  else if(action==='settings-back')go(app.screen==='dev'?'pause':app.settingsFrom||'title');\n  else if(action==='dev')go('dev');\n  else if(action==='reset-tuning'){app.tuning={...DEFAULT_TUNABLES};if(app.session)app.session.tuning={...app.tuning};render();}\n  else if(action==='resume'){app.paused=false;go('game');}\n  else if(action==='leave'){app.session=null;app.medley=null;app.weigh=null;go(profile()?'island':'title');}\n  else if(action==='about')go('about');\n  else if(action==='hub-ready')globalThis.AIHub?.answer('ready');\n  else if(action==='hub-more')globalThis.AIHub?.answer('more');\n}\nui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\nui.addEventListener('pointerover',event=>{const \ntarget=event.target.closest('button');if(target){ui.querySelectorAll('button.focused').forEach(item=>item.classList.remove('focused'));target.classList.add('focused');app.focus=Arr\nay.from(ui.querySelectorAll('button:not(:disabled)')).indexOf(target);}});\nui.addEventListener('input',event=>{const target=event.target;if(target.dataset.setting){const \nkey=target.dataset.setting;app.settings[key]=target.type==='checkbox'?target.checked:target.type==='range'?Number(target.value):target.value;save();document.body.classList.toggle('\nhigh-contrast',app.settings.contrast);document.body.classList.toggle('reduce-motion',app.settings.motion);}if(target.dataset.tune){app.tuning[target.dataset.tune]=Number(target.val\nue);if(app.session)app.session.tuning={...app.tuning};}});\nfunction menuMove(delta){const \nbuttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));if(!buttons.length)return;app.focus=(app.focus+delta+buttons.length)%buttons.length;buttons.forEach((item,index)=>i\ntem.classList.toggle('focused',index===app.focus));buttons[app.focus].focus();buttons[app.focus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\nwindow.addEventListener('keydown',event=>{const \nwasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&was\nNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' \n','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true\n;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else \nif(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const \nbuttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const \nbackButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nwindow.addEventListener('keyup',event=>app.keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur',()=>app.keys.clear());\nwindow.addEventListener('pointerdown',event=>{app.lastInput=performance.now();if(app.attract){leaveAttract();return;}sound.unlock();if(event.pointerType==='mouse')app.inputKind='mo\nuse';});\nui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const \nrect=dial.getBoundingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.\nheight/2)/(rect.height/2)))};app.lastInput=performance.now();});\nwindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n\nfunction gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const \njust=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen!=='game'){if(just(12))menuMove(-1);if\n(just(13))menuMove(1);if(just(0)){const \nbuttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(\njust(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attr\nact){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nfunction activityCue(session){\n  const activity=session.activity,time=session.elapsed;\n  if(activity.family==='reps'){\n    const phase=(time/3.2)%1;\n    const target=phase<.4?phase/.4:phase<.55?1:phase<.9?1-(phase-.55)/.35:0;\n    return `MATCH ${Math.round(target*100)}% · YOU ${Math.round(session.rep*100)}%`;\n  }\n  if(activity.family==='header')return Math.floor(time/2.4)%2===0?'← HEAD LEFT':'HEAD RIGHT →';\n  if(activity.family==='step')return Math.abs(time/.7-Math.round(time/.7))<.23?'STEP NOW · F OR J':'WAIT FOR THE BEAT';\n  if(activity.family==='jog')return 'ALTERNATE F AND J';\n  if(activity.family==='slack')return 'F / J TO WALK THE LINE';\n  if(activity.family==='jump')return 'SPACE / R2 TO JUMP';\n  if(activity.family==='hoop')return `CIRCLE THE STICK · ${Math.round(session.hoopLift*100)}% LIFT`;\n  if(activity.breath)return Math.sin(time*Math.PI*2/activity.breath)>0?'BREATHE IN · HOLD':'BREATHE OUT · RELEASE';\n  return 'KEEP THE DOT INSIDE THE RING';\n}\nfunction frame(now){\n  const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);\n  if(app.hubClosed){requestAnimationFrame(frame);return;}\n  const pad=gamepad();\n  if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();\n  if(app.screen==='game'&&app.session){\n    const seconds=document.getElementById('seconds');\n    \nif(app.hubRound&&globalThis.AIHub.time()<0){if(seconds)seconds.textContent=`${Math.ceil(-globalThis.AIHub.time()/1000)}`;app.input.left=false;app.input.right=false;requestAnimation\nFrame(frame);return;}\n    let x=Number(app.keys.has('d')||app.keys.has('arrowright'))-Number(app.keys.has('a')||app.keys.has('arrowleft'));\n    let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.keys.has('w')||app.keys.has('arrowup'));\n    if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}\n    if(app.attract){const \ntime=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(\nMath.floor(time*3)%2===0)app.input.left=true;else app.input.right=true;}\n    if(app.driver==='perfect'){x=0;y=0;}\n    app.session.update(dt,{x,y,breath:app.keys.has(' ')||!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;\n    const \ndot=document.getElementById('balance-dot'),meter=document.getElementById('meter'),score=document.getElementById('live-score'),cue=document.getElementById('live-cue'),dial=document.\ngetElementById('dial');\n    if(dot){dot.style.left=`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}\n    if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));\n    if(meter)meter.style.width=`${Math.min(100,app.session.elapsed/app.session.duration*100)}%`;\n    if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'KEEP GOING'}`;\n    if(cue)cue.textContent=activityCue(app.session);\n    if(dial&&app.hubRound){dial.querySelectorAll('.ghost-dot').forEach(node=>node.remove());for(const ghost of \nObject.values(app.hubScores).slice(0,3)){if(!Number.isFinite(ghost?.x)||!Number.isFinite(ghost?.y))continue;const \nmarker=document.createElement('span');marker.className='ghost-dot';marker.style.left=`${50+Math.max(-1,Math.min(1,ghost.x))*38}%`;marker.style.top=`${50+Math.max(-1,Math.min(1,ghos\nt.y))*38}%`;dial.appendChild(marker);}}\n    if(app.hubRound&&now-app.hubClock>500){app.hubClock=now;const \npartial=app.hubTotal+app.session.result().score;globalThis.AIHub?.progress({score:partial,label:app.activity.name});globalThis.AIHub?.send({x:app.session.dot.x,y:app.session.dot.y,\nscore:partial});}\n    if(app.session.finished)finish();\n  }\n  requestAnimationFrame(frame);\n}\n\nfunction \nadvanceHub(){if(app.hubEnded)return;app.hubTotal+=app.session.result().score;app.hubEvent++;if(app.hubEvent>=3){app.hubEnded=true;globalThis.AIHub?.result({score:app.hubTotal});app\n.result={...app.session.result(),score:app.hubTotal,stars:0,drips:0};app.hubRound=false;go('results');}else \nbegin({...ACTIVITIES.find(item=>item.id===['tree','hoop','step'][app.hubEvent])},{duration:20});}\nfunction setupHub(){const \nhub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>{app.hubClosed=false;go('hub-card');});hub.on('start',()=>{app.hubClosed=false;app.hubRound=true;app.hubEnded=false;ap\np.hubScores={};app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubR\nound&&!app.hubEnded){const \nresult=app.hubTotal+(app.session?.result().score||0);app.hubEnded=true;hub.result({score:result});app.result={...app.session.result(),score:result,stars:0,drips:0};app.hubRound=fal\nse;go('results');}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;app.hubClosed=true;sound.context?.suspend();});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.rea\ndy();}\nwindow.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else \ngo(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:\napp.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return \napp.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\nrender();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\n\n--- TEST LIBS ---\n/home/micha/.local/bin/viewport-matrix\nplaywright available\n","exit_code":1,"status":"failed"}}
