{"type":"item.completed","item":{"id":"item_258","type":"command_execution","command":"/bin/bash -lc \"cat src/data/activities.js; sed -n '30,60p' src/main.js | fold -s -w 180; sed -n '130,151p' src/main.js | fold -s -w 180; rg -n 'class Sound|context|resume|unlock' src/core/audio-runtime.js\"","aggregated_output":"export const ACTIVITIES = [\n  { id:'tree', name:'Apologetic Tree', family:'still', place:'Pavilion', day:1, duration:25, ring:.40, instruction:'KEEP YOUR DOT IN THE RING', quip:'THE TREE ACCEPTS YOUR APOLOGY.' },\n  { id:'heron', name:'Startled Heron', family:'still', place:'Pavilion', day:1, duration:25, ring:.36, instruction:'LEAN AGAINST THE WANDERING WIND', quip:'A MOST RESPECTABLE BIRD.' },\n  { id:'squats', name:'Squats of Regret', family:'reps', place:'Rep Shed', day:1, duration:38.4, instruction:'MATCH THE MOVING MARKER', quip:'THAT WAS THE LAST ONE. PROBABLY.' },\n  { id:'hoop', name:'Hoop Economics', family:'hoop', place:'Beat Beach', day:1, duration:40, instruction:'CIRCLE YOUR STICK OR ROLL W D S A', quip:'THE ECONOMY REMAINS CIRCULAR.' },\n  { id:'header', name:'Coconut Header', family:'header', place:'Beat Beach', day:2, duration:40, instruction:'LEAN LEFT OR RIGHT TO HEAD COCONUTS', quip:'A SOUND FINANCIAL HEADBUTT.' },\n  { id:'lunges', name:'Apology Lunges', family:'reps', place:'Rep Shed', day:2, duration:38.4, instruction:'MATCH THE MARKER AND ALTERNATE SIDES', quip:'YOUR LEGS HAVE BEEN NOTIFIED.' },\n  { id:'warrior', name:'Reluctant Warrior', family:'still', place:'Pavilion', day:2, duration:30, ring:.32, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'A WARRIOR, UNDER PROTEST.' },\n  { id:'step', name:'Step Department', family:'step', place:'Town Square', day:3, duration:40, instruction:'PRESS F OR J WHEN NOTES HIT THE LINE', quip:'YOUR STEPS HAVE BEEN FILED.' },\n  { id:'slackline', name:'Slackline of Doubt', family:'slack', place:'Lookout', day:3, duration:45, instruction:'STAY CENTERED. STEP TO WALK', quip:'THE ROPE BELIEVES IN YOU.' },\n  { id:'chair', name:'The Chair Nobody Asked For', family:'still', place:'Pavilion', day:3, duration:30, ring:.30, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'SOMEWHERE A CHAIR FEELS SEEN.' },\n  { id:'tray', name:'Vitamin Tray', family:'tray', place:'Cafe', day:4, duration:40, instruction:'KEEP THE VITAMINS ON THE TRAY', quip:'NUTRITION HAS NEVER BEEN SO TENSE.' },\n  { id:'mortgage', name:'Overhead Mortgage', family:'reps', place:'Rep Shed', day:4, duration:36, instruction:'PUSH UP TO MATCH THE MARKER', quip:'INTEREST COMPOUNDS. SO DOES SWEAT.' },\n  { id:'tax', name:'Tax Season', family:'still', place:'Pavilion', day:4, duration:30, ring:.28, breath:6, instruction:'LEAN AND BREATHE THROUGH THE AUDIT', quip:'YOUR EXTENSION HAS BEEN APPROVED.' },\n  { id:'jog', name:'Island Jog', family:'jog', place:'Island Trail', day:5, duration:45, instruction:'ALTERNATE F AND J TO RUN', quip:'YOU HAVE LAPSED A COCONUT.' },\n  { id:'pier', name:'Pier Jump', family:'jump', place:'Pier', day:5, duration:40, instruction:'STEP TO THE EDGE. BREATHE TO JUMP', quip:'THE WATER GIVES YOU A TEN.' },\n  { id:'plank', name:'Plank Negotiation', family:'still', place:'Pavilion', day:5, duration:35, ring:.24, breath:6, instruction:'KEEP THE DOT IN THE RING. BREATHE', quip:'YOUR CORE HAS COUNTEROFFERED.' },\n];\n\nexport const DAY_NAMES = ['A FRESH START','THE HEAD OF IT','A NARROW VIEW','WEALTH AND HEALTH','THE LONG WAY ROUND','A LITTLE MORE','THE LONG STAND'];\nexport const FRIENDS = ['COACH PLUMB','MABEL','FRANK','KEVIN'];\nexport function activityForDay(day) { return ACTIVITIES.filter(activity => activity.day <= Math.min(day, 5)); }\n  if(app.screen==='title'){\n    content=panel(`${brand}<h1 class=\"title\">${escape(TITLE.split(' ').slice(0,2).join(' '))}<br><span>${escape(TITLE.split(' ').slice(2).join(' '))}.</span></h1><p class=\"lede\">A \nweek of movement, a talking scale, and absolutely no pressure to be graceful.</p><div class=\"title-tag\">YOUR ISLAND IS READY</div>${notice()?`<p class=\"description\" \nstyle=\"margin-top:18px\"><strong>Controller or keyboard required</strong></p><div class=\"menu\">${button('Settings','settings','','ghost')}</div>`:`<div class=\"menu\">${button('Begin \nyour week','slots','','primary')}<div class=\"menu-row\">${button('Drop-in','dropin','','ghost')}${button('Family Hour','family','','ghost')}</div><div \nclass=\"menu-row\">${button('Settings','settings','','ghost')}${button('About','about','','ghost')}</div></div>${footer()}`}`,'title-screen')+`<div class=\"hero-note\">WELCOME TO \nLITTLE ISLAND<strong>Take it one wobble at a time.</strong>EST. WHENEVER YOU ARE READY</div>`;\n  }else if(app.screen==='slots'){\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">YOUR WEEK</span></div>${heading('A PLACE TO BEGIN','Who is stepping on?','Choose a profile. Your island \nremembers your progress on this device.')}<div class=\"stack\">${app.profiles.map((item,index)=>`<button class=\"list-item\" data-action=\"slot\" data-index=\"${index}\"><span \nclass=\"icon\">${index+1}</span><span><span class=\"name\">${item?escape(item.name):'Start a new week'}</span><span class=\"sub\">${item?`DAY ${item.day} · ${item.drips} DRIPS`:'EMPTY \nPROFILE'}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div>${footer()}`);\n  }else if(app.screen==='island'){\n    const player=profile(), day=Math.min(player.day,7), activities=activityForDay(day);\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge sun\">✦ ${player.drips} DRIPS</span></div>${heading(`DAY ${day} / 7 · ${DAY_NAMES[day-1]}`,'Good to see \nyou. ',`Ounce says: “${day===7?'Today, we stand together. And I owe you an explanation.':'The island is ready when you are.'}”`)}<div class=\"stats\"><span \nclass=\"badge\">${escape(player.name)}</span> <span class=\"badge\">${player.stars} STARS</span> <span class=\"badge\">WOBBLE AGE \n${player.history.length?wobbleAge(player):'—'}</span></div><div class=\"stack\"><button class=\"list-item\" data-action=\"weigh\"><span class=\"icon\">◉</span><span><span \nclass=\"name\">Daily weigh-in</span><span class=\"sub\">THREE LITTLE BALANCE CHECKS</span></span><span class=\"arrow\">→</span></button>${day===7?`<button class=\"list-item\" \ndata-action=\"finale\"><span class=\"icon\">✦</span><span><span class=\"name\">The Long Stand</span><span class=\"sub\">YOUR WEEK FINALE</span></span><span \nclass=\"arrow\">→</span></button>`:''}</div><div class=\"eyebrow\" style=\"margin-top:20px\">PICK A PRACTICE · ${activities.length} OPEN</div><div class=\"scroll-list \nstack\">${activities.map(activity=>`<button class=\"list-item\" data-action=\"intro\" data-id=\"${activity.id}\"><span class=\"icon\">${iconFor(activity.family)}</span><span><span \nclass=\"name\">${escape(activity.name)}</span><span class=\"sub\">${escape(activity.place.toUpperCase())} · ${activity.duration} SEC ${player.played[activity.id]?`· \n${'★'.repeat(player.played[activity.id])}`:''}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div><div class=\"menu-row\" style=\"margin-top:12px\">${button('Day \nreport','day-report','','small')}${button('Settings','settings','','small ghost')}</div>${footer()}`,'island-screen');\n  }else if(app.screen==='intro'){\n    const activity=app.activity;\n    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S \nPRACTICE',escape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press \nSpace / R2 to breathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div \nclass=\"menu\">${button('Let’s go','start','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n  }else if(app.screen==='game'){\n    const activity=app.session.activity;\n    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO \nPLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" \nid=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" \naria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p \nid=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div \nclass=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span \nclass=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n  }else if(app.screen==='pause'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">TAKE YOUR TIME</span></div>${heading('PAUSED','A little breather.','Your island will be right here.')}<div \nclass=\"menu\">${button('Resume','resume','','primary')}${button('Settings','settings','','ghost')}${button('Dev tools','dev','','ghost')}${button('Leave \npractice','leave','','ghost')}</div>${footer()}`);\n  }else if(app.screen==='results'){\n    const result=app.result;\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND \nIS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;color:#8ca397\"> / 100</small></div><div \nclass=\"stars\">${'★'.repeat(result.stars)}${'☆'.repeat(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS \nOF YOU TIME</span></div><div class=\"menu\">${button(app.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the \nisland','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</div>${footer()}`);\n  }else if(app.screen==='weigh-result'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">DAILY CHECK-IN</span></div>${heading('A NUMBER, NOT A VERDICT','Your wobble age','Ounce has reviewed your three balance \nchecks with tremendous confidence.')}<div class=\"score-hero\">${wobbleAge(profile())}</div><p class=\"description\">This is just a playful score, not a measure of health. Keep moving \nat your own pace.</p><div class=\"menu\">${button('Back to the island','island','','primary')}</div>${footer()}`);\n  }else if(app.screen==='day-report'){\n    const player=profile();\n    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have \ncollected ${player.drips} drips and ${player.stars} stars. You showed up; the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S \nNOTE</strong><p>${player.day===6?'Tomorrow is the Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a \nperfectly planned nap. Usually.'}</p></div><div class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n  }else if(app.screen==='reveal'){\n    content=panel(`${brand}${heading('THE LONG STAND','Ounce comes clean.','“I added seven years to everyone’s wobble age. I thought you would come back if the number worried you. \nThat was wrong.”')}<p class=\"description\" style=\"margin-top:16px\">The island agrees: a number should never tell you your worth. Your wobble age is now honest, and the island \nremains open.</p><div class=\"menu\">${button('A fresh start','island','','primary')}</div>`);\n  }else if(app.screen==='family'){\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take \nturns through a three-event medley. Highest total wins; kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} \n${number===1?'player':'players'}`,'family-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n  }else if(app.screen==='medley-board'){\n    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the \nspotlight.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER \n${entry.index+1}</span><span class=\"sub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n  }else if(app.screen==='settings'||app.screen==='dev'){\nui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const \nrect=dial.getBoundingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.\nheight/2)/(rect.height/2)))};app.lastInput=performance.now();});\nwindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n\nfunction gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const \njust=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen!=='game'){if(just(12))menuMove(-1);if\n(just(13))menuMove(1);if(just(0)){const \nbuttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(\njust(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attr\nact){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nfunction activityCue(session){\n  const activity=session.activity,time=session.elapsed;\n  if(activity.family==='reps'){\n    const phase=(time/3.2)%1;\n    const target=phase<.4?phase/.4:phase<.55?1:phase<.9?1-(phase-.55)/.35:0;\n    return `MATCH ${Math.round(target*100)}% · YOU ${Math.round(session.rep*100)}%`;\n  }\n  if(activity.family==='header')return Math.floor(time/2.4)%2===0?'← HEAD LEFT':'HEAD RIGHT →';\n  if(activity.family==='step')return Math.abs(time/.7-Math.round(time/.7))<.23?'STEP NOW · F OR J':'WAIT FOR THE BEAT';\n  if(activity.family==='jog')return 'ALTERNATE F AND J';\n  if(activity.family==='slack')return 'F / J TO WALK THE LINE';\n  if(activity.family==='jump')return 'SPACE / R2 TO JUMP';\n  if(activity.family==='hoop')return `CIRCLE THE STICK · ${Math.round(session.hoopLift*100)}% LIFT`;\n  if(activity.breath)return Math.sin(time*Math.PI*2/activity.breath)>0?'BREATHE IN · HOLD':'BREATHE OUT · RELEASE';\n  return 'KEEP THE DOT INSIDE THE RING';\n}\nfunction frame(now){\n  const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);\n1:export class Sound {\n2:  constructor(settings) { this.settings=settings; this.context=null; this.beat=0; this.next=0; }\n3:  unlock() {\n4:    if (!this.context) {\n7:      this.context=new AudioContext();\n9:    if (this.context.state==='suspended') this.context.resume().catch(()=>{});\n12:    const context=this.context;\n13:    if (!context||context.state!=='running') return;\n14:    const start=context.currentTime+delay;\n15:    const oscillator=context.createOscillator(), gain=context.createGain();\n19:    oscillator.connect(gain).connect(context.destination); oscillator.start(start); oscillator.stop(start+duration+.02);\n29:    if(!this.context||this.context.state!=='running'||!this.settings.music)return;\n","exit_code":0,"status":"completed"}}
