{"type":"item.started","item":{"id":"item_574","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; sed -n '1,145p' \\\"\"'$DEV/src/main.js\"; sed -n '\"'145,240p' \\\"\"'$DEV/src/main.js\"; sed -n '\"'1,230p' \\\"\"'$DEV/tests/browser.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_574","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; sed -n '1,145p' \\\"\"'$DEV/src/main.js\"; sed -n '\"'145,240p' \\\"\"'$DEV/src/main.js\"; sed -n '\"'1,230p' \\\"\"'$DEV/tests/browser.py\"'","aggregated_output":"import { ACTIVITIES, DAY_NAMES, activityForDay } from './data/activities.js';\nimport { makeProfile, wobbleAge, ActivitySession } from './core/session.js';\nimport { DEFAULT_TUNABLES } from './core/dot.js';\nimport { Sound } from './core/audio-runtime.js';\nimport { about } from './data/about.js';\nimport { TITLE } from './data/title.js';\nimport { EVENT_SECONDS, pickMedley, medleyWindow } from './data/medley.js';\nimport { startWorld } from './world.js';\n\nconst ui=document.getElementById('ui');\nconst stored=(key,fallback)=>{try{return JSON.parse(localStorage.getItem(key))??fallback;}catch{return fallback;}};\nconst escape=value=>String(value).replace(/[&<>\"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[character]));\nconst app={screen:'title',session:null,settings:{music:.1,effects:.7,glyphs:'ps',contrast:false,motion:false,...stored('alob-settings',{})},profiles:stored('alob-profiles',[null,null,null]),slot:0,activity:null,result:null,tuning:{...DEFAULT_TUNABLES},input:{x:0,y:0,breath:false,left:false,right:false},keys:new Set(),lastInput:performance.now(),inputKind:'keyboard',focus:0,paused:false,attract:false,attractIndex:0,medley:null,weigh:null,hubRound:false,hubEnded:false,hubScores:{},hubClock:0,gamepadButtons:[],driver:null};\nconst sound=new Sound(app.settings);\nconst save=()=>{try{localStorage.setItem('alob-profiles',JSON.stringify(app.profiles));localStorage.setItem('alob-settings',JSON.stringify(app.settings));}catch{}};\nconst profile=()=>app.guest||app.profiles[app.slot];\nconst brand='<div class=\"brand\"><span class=\"brand-icon\">✳</span> LITTLE ISLAND WELLNESS</div>';\nconst button=(label,action,extra='',style='')=>`<button class=\"button ${style}\" data-action=\"${action}\" ${extra}>${label}<span class=\"arrow\">↗</span></button>`;\nconst back=target=>`<button class=\"back\" data-action=\"${target}\" aria-label=\"Go back\">←</button>`;\nconst panel=(content,extra='')=>`<section class=\"screen ${extra}\"><div class=\"panel glass\">${content}</div></section>`;\nconst heading=(kicker,title,description)=>`<div class=\"eyebrow\">${kicker}</div><h1 class=\"heading\">${title}</h1><p class=\"description\">${description}</p>`;\nconst hint=()=>app.inputKind==='gamepad'?`<span class=\"key\">${app.settings.glyphs==='xbox'?'A':'✕'}</span> SELECT <span class=\"key\">${app.settings.glyphs==='xbox'?'B':'◯'}</span> BACK`:'<span class=\"key\">↑↓</span> CHOOSE <span class=\"key\">ENTER</span> SELECT';\nconst footer=()=>`<div class=\"footnote\">${hint()}</div>`;\nconst notice=()=>matchMedia('(hover: none) and (pointer: coarse)').matches&&!app.keyboardSeen&&!Array.from(navigator.getGamepads?.()||[]).some(Boolean);\nconst iconFor=family=>({still:'✳',reps:'↕',hoop:'◌',header:'◉',step:'♪',slack:'〰',tray:'♧',jog:'➜',jump:'↗'})[family]||'✳';\n\nfunction render(){\n  document.body.classList.toggle('high-contrast',app.settings.contrast);\n  document.body.classList.toggle('reduce-motion',app.settings.motion);\n  let content='';\n  if(app.screen==='title'){\n    content=panel(`${brand}<h1 class=\"title\">${escape(TITLE.split(' ').slice(0,2).join(' '))}<br><span>${escape(TITLE.split(' ').slice(2).join(' '))}.</span></h1><p class=\"lede\">A week of movement, a talking scale, and absolutely no pressure to be graceful.</p><div class=\"title-tag\">YOUR ISLAND IS READY</div>${notice()?`<p class=\"description\" style=\"margin-top:18px\"><strong>Controller or keyboard required</strong></p><div class=\"menu\">${button('Settings','settings','','ghost')}</div>`:`<div class=\"menu\">${button('Begin your week','slots','','primary')}<div class=\"menu-row\">${button('Drop-in','dropin','','ghost')}${button('Family Hour','family','','ghost')}</div><div class=\"menu-row\">${button('Settings','settings','','ghost')}${button('About','about','','ghost')}</div></div>${footer()}`}`,'title-screen')+`<div class=\"hero-note\">WELCOME TO LITTLE ISLAND<strong>Take it one wobble at a time.</strong>EST. WHENEVER YOU ARE READY</div>`;\n  }else if(app.screen==='slots'){\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">YOUR WEEK</span></div>${heading('A PLACE TO BEGIN','Who is stepping on?','Choose a profile. Your island remembers your progress on this device.')}<div class=\"stack\">${app.profiles.map((item,index)=>`<button class=\"list-item\" data-action=\"slot\" data-index=\"${index}\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">${item?escape(item.name):'Start a new week'}</span><span class=\"sub\">${item?`DAY ${item.day} · ${item.drips} DRIPS`:'EMPTY PROFILE'}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div>${footer()}`);\n  }else if(app.screen==='island'){\n    const player=profile(), day=Math.min(player.day,7), activities=activityForDay(day);\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge sun\">✦ ${player.drips} DRIPS</span></div>${heading(`DAY ${day} / 7 · ${DAY_NAMES[day-1]}`,'Good to see you. ',`Ounce says: “${day===7?'Today, we stand together. And I owe you an explanation.':'The island is ready when you are.'}”`)}<div class=\"stats\"><span class=\"badge\">${escape(player.name)}</span> <span class=\"badge\">${player.stars} STARS</span> <span class=\"badge\">WOBBLE AGE ${player.history.length?wobbleAge(player):'—'}</span></div><div class=\"stack\"><button class=\"list-item\" data-action=\"weigh\"><span class=\"icon\">◉</span><span><span class=\"name\">Daily weigh-in</span><span class=\"sub\">THREE LITTLE BALANCE CHECKS</span></span><span class=\"arrow\">→</span></button>${day===7?`<button class=\"list-item\" data-action=\"finale\"><span class=\"icon\">✦</span><span><span class=\"name\">The Long Stand</span><span class=\"sub\">YOUR WEEK FINALE</span></span><span class=\"arrow\">→</span></button>`:''}</div><div class=\"eyebrow\" style=\"margin-top:20px\">PICK A PRACTICE · ${activities.length} OPEN</div><div class=\"scroll-list stack\">${activities.map(activity=>`<button class=\"list-item\" data-action=\"intro\" data-id=\"${activity.id}\"><span class=\"icon\">${iconFor(activity.family)}</span><span><span class=\"name\">${escape(activity.name)}</span><span class=\"sub\">${escape(activity.place.toUpperCase())} · ${activity.duration} SEC ${player.played[activity.id]?`· ${'★'.repeat(player.played[activity.id])}`:''}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div><div class=\"menu-row\" style=\"margin-top:12px\">${button('Day report','day-report','','small')}${button('Settings','settings','','small ghost')}</div>${footer()}`,'island-screen');\n  }else if(app.screen==='intro'){\n    const activity=app.activity;\n    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',escape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to breathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','start','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n  }else if(app.screen==='game'){\n    const activity=app.session.activity;\n    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n  }else if(app.screen==='pause'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">TAKE YOUR TIME</span></div>${heading('PAUSED','A little breather.','Your island will be right here.')}<div class=\"menu\">${button('Resume','resume','','primary')}${button('Settings','settings','','ghost')}${button('Dev tools','dev','','ghost')}${button('Leave practice','leave','','ghost')}</div>${footer()}`);\n  }else if(app.screen==='results'){\n    const result=app.result;\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND IS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;color:#8ca397\"> / 100</small></div><div class=\"stars\">${'★'.repeat(result.stars)}${'☆'.repeat(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS OF YOU TIME</span></div><div class=\"menu\">${button(app.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the island','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</div>${footer()}`);\n  }else if(app.screen==='weigh-result'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">DAILY CHECK-IN</span></div>${heading('A NUMBER, NOT A VERDICT','Your wobble age','Ounce has reviewed your three balance checks with tremendous confidence.')}<div class=\"score-hero\">${wobbleAge(profile())}</div><p class=\"description\">This is just a playful score, not a measure of health. Keep moving at your own pace.</p><div class=\"menu\">${button('Back to the island','island','','primary')}</div>${footer()}`);\n  }else if(app.screen==='day-report'){\n    const player=profile();\n    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have collected ${player.drips} drips and ${player.stars} stars. You showed up; the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S NOTE</strong><p>${player.day===6?'Tomorrow is the Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a perfectly planned nap. Usually.'}</p></div><div class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n  }else if(app.screen==='reveal'){\n    content=panel(`${brand}${heading('THE LONG STAND','Ounce comes clean.','“I added seven years to everyone’s wobble age. I thought you would come back if the number worried you. That was wrong.”')}<p class=\"description\" style=\"margin-top:16px\">The island agrees: a number should never tell you your worth. Your wobble age is now honest, and the island remains open.</p><div class=\"menu\">${button('A fresh start','island','','primary')}</div>`);\n  }else if(app.screen==='family'){\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take turns through a three-event medley. Highest total wins; kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} ${number===1?'player':'players'}`,'family-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n  }else if(app.screen==='medley-board'){\n    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the spotlight.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER ${entry.index+1}</span><span class=\"sub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n  }else if(app.screen==='settings'||app.screen==='dev'){\n    const dev=app.screen==='dev';\n    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" min=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Math.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':''}>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER TOOLS':'YOUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\"stack\">${ranges}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\n  }else if(app.screen==='about'){\n    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful tribute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: ${value}`))}${section('Testing Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt Feedback',about.promptFeedback)}</div>${footer()}`);\n  }else if(app.screen==='hub-card'){\n    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div class=\"menu\">${button('Ready','hub-ready','','primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n  }else if(app.screen==='hub-finished'){\n    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Well wobbled.','Your score is in. The hub will show the final standings.')}<div class=\"badge sun\">${app.result?.score||0} POINTS</div>`);\n  }\n  ui.innerHTML=content;\n  app.focus=0;\n  const first=ui.querySelector('button:not(:disabled)');if(first&&app.inputKind==='gamepad')first.classList.add('focused');\n}\n\nfunction go(screen){app.screen=screen;render();}\nfunction begin(activity,options={}){\n  app.activity=activity;app.session=new ActivitySession(activity,{hard:app.hard,tuning:app.tuning,...options});app.paused=false;go('game');\n}\nfunction finish(){\n  if(!app.session)return;\n  app.result=app.session.result();\n  if(app.attract){app.attractIndex++;startAttract();return;}\n  if(app.hubRound)return;\n  if(app.weigh){app.weigh.push(app.result.score/100);if(app.weigh.length<3){startWeigh();return;}profile().history.push(...app.weigh);profile().history=profile().history.slice(-3);app.weigh=null;save();go('weigh-result');return;}\n  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;go('results');return;}\n  if(profile()){const player=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=Math.max(app.result.stars,player.played[app.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n  sound.effect('good');go('results');\n}\nfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the breeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});}\nfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\nfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const activity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequence.length]);begin(activity,{duration:12});}\nfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\nfunction act(action,element){\n  sound.unlock();sound.effect('select');app.lastInput=performance.now();\n  if(app.attract){leaveAttract();return;}\n  if(action==='title'){app.session=null;app.medley=null;app.guest=null;go('title');}\n  else if(action==='slots')go('slots');\n  else if(action==='slot'){app.guest=null;app.slot=Number(element.dataset.index);if(!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('island');}\n  else if(action==='dropin'){app.guest=makeProfile('GUEST');app.guest.day=7;app.guest.revealed=true;app.returnScreen='island';go('island');}\n  else if(action==='island'){app.medley=null;app.weigh=null;go('island');}\n  else if(action==='intro'){app.activity=ACTIVITIES.find(item=>item.id===element.dataset.id);app.returnScreen='island';app.hard=false;sound.effect('voice');go('intro');}\n  else if(action==='hard'){app.hard=!app.hard;render();}\n  else if(action==='start')begin(app.activity);\n  else if(action==='weigh'){app.weigh=[];startWeigh();}\n  else if(action==='finale'){app.activity={...ACTIVITIES[0],id:'finale',name:'The Long Stand',place:'Pavilion',duration:45,ring:.32,quip:'A LITTLE HONESTY GOES A LONG WAY.'};app.returnScreen='island';go('intro');}\n  else if(action==='continue'){if(app.medley){app.medley.player++;if(app.medley.player>=app.medley.scores.length){app.medley.player=0;app.medley.event++;}if(app.medley.event>=3)go('medley-board');else startMedley();}else go('island');}\n  else if(action==='day-report')go('day-report');\n  else if(action==='next-day'){if(profile().day<7)profile().day++;save();go('island');}\n  else if(action==='family')go('family');\n  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n  else if(action==='settings'){app.settingsFrom=app.screen;go('settings');}\n  else if(action==='settings-back')go(app.screen==='dev'?'pause':app.settingsFrom||'title');\n  else if(action==='dev')go('dev');\n  else if(action==='reset-tuning'){app.tuning={...DEFAULT_TUNABLES};if(app.session)app.session.tuning={...app.tuning};render();}\n  else if(action==='resume'){app.paused=false;go('game');}\n  else if(action==='leave'){app.session=null;app.medley=null;app.weigh=null;go(profile()?'island':'title');}\n  else if(action==='about')go('about');\n  else if(action==='hub-ready')globalThis.AIHub?.answer('ready');\n  else if(action==='hub-more')globalThis.AIHub?.answer('more');\n}\nui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\nui.addEventListener('pointerover',event=>{const target=event.target.closest('button');if(target){ui.querySelectorAll('button.focused').forEach(item=>item.classList.remove('focused'));target.classList.add('focused');app.focus=Array.from(ui.querySelectorAll('button:not(:disabled)')).indexOf(target);}});\nui.addEventListener('input',event=>{const target=event.target;if(target.dataset.setting){const key=target.dataset.setting;app.settings[key]=target.type==='checkbox'?target.checked:target.type==='range'?Number(target.value):target.value;save();document.body.classList.toggle('high-contrast',app.settings.contrast);document.body.classList.toggle('reduce-motion',app.settings.motion);}if(target.dataset.tune){app.tuning[target.dataset.tune]=Number(target.value);if(app.session)app.session.tuning={...app.tuning};}});\nfunction menuMove(delta){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));if(!buttons.length)return;app.focus=(app.focus+delta+buttons.length)%buttons.length;buttons.forEach((item,index)=>item.classList.toggle('focused',index===app.focus));buttons[app.focus].focus();buttons[app.focus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\nwindow.addEventListener('keydown',event=>{if(app.hubClosed)return;const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;if(app.screen==='hub-card'&&(key==='enter'||key==='m')){event.preventDefault();globalThis.AIHub?.answer(key==='m'?'more':'ready');return;}app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nwindow.addEventListener('keyup',event=>app.keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur',()=>app.keys.clear());\nwindow.addEventListener('pointerdown',event=>{app.lastInput=performance.now();if(app.attract){leaveAttract();return;}sound.unlock();if(event.pointerType==='mouse')app.inputKind='mouse';});\nui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const rect=dial.getBoundingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.height/2)/(rect.height/2)))};app.lastInput=performance.now();});\nwindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n\nfunction gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen==='hub-card'&&just(3))globalThis.AIHub?.answer('more');if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nfunction activityCue(session){\n  const activity=session.activity,time=session.elapsed;\n  if(activity.family==='reps'){\n    const phase=(time/3.2)%1;\n    const target=phase<.4?phase/.4:phase<.55?1:phase<.9?1-(phase-.55)/.35:0;\n    return `MATCH ${Math.round(target*100)}% · YOU ${Math.round(session.rep*100)}%`;\n  }\n  if(activity.family==='header')return Math.floor(time/2.4)%2===0?'← HEAD LEFT':'HEAD RIGHT →';\n  if(activity.family==='step')return Math.abs(time/.7-Math.round(time/.7))<.23?'STEP NOW · F OR J':'WAIT FOR THE BEAT';\n  if(activity.family==='step')return Math.abs(time/.7-Math.round(time/.7))<.23?'STEP NOW · F OR J':'WAIT FOR THE BEAT';\n  if(activity.family==='jog')return 'ALTERNATE F AND J';\n  if(activity.family==='slack')return 'F / J TO WALK THE LINE';\n  if(activity.family==='jump')return 'SPACE / R2 TO JUMP';\n  if(activity.family==='hoop')return `CIRCLE THE STICK · ${Math.round(session.hoopLift*100)}% LIFT`;\n  if(activity.breath)return Math.sin(time*Math.PI*2/activity.breath)>0?'BREATHE IN · HOLD':'BREATHE OUT · RELEASE';\n  return 'KEEP THE DOT INSIDE THE RING';\n}\nfunction frame(now){\n  const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);\n  if(app.hubClosed){requestAnimationFrame(frame);return;}\n  const pad=gamepad();\n  if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();\n  if(app.screen==='game'&&app.session){\n    const seconds=document.getElementById('seconds');\n    if(app.hubRound&&!syncHub()){app.input.left=false;app.input.right=false;requestAnimationFrame(frame);return;}\n    let x=Number(app.keys.has('d')||app.keys.has('arrowright'))-Number(app.keys.has('a')||app.keys.has('arrowleft'));\n    let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.keys.has('w')||app.keys.has('arrowup'));\n    if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}\n    if(app.attract){const time=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(Math.floor(time*3)%2===0)app.input.left=true;else app.input.right=true;}\n    if(app.driver==='perfect'){x=0;y=0;}\n    app.session.update(dt,{x,y,breath:app.keys.has(' ')||!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;\n    document.documentElement.style.setProperty('--avatar-lean',`${-app.session.dot.x*16}deg`);\n    const dot=document.getElementById('balance-dot'),meter=document.getElementById('meter'),score=document.getElementById('live-score'),cue=document.getElementById('live-cue'),dial=document.getElementById('dial');\n    if(dot){dot.style.left=`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}\n    if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));\n    if(meter)meter.style.width=`${Math.min(100,app.session.elapsed/app.session.duration*100)}%`;\n    if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'KEEP GOING'}`;\n    if(cue)cue.textContent=activityCue(app.session);\n    if(dial&&app.hubRound){dial.querySelectorAll('.ghost-dot').forEach(node=>node.remove());for(const ghost of Object.values(app.hubScores).slice(0,3)){if(ghost?.a!==app.hubEvent||!Number.isFinite(ghost?.x)||!Number.isFinite(ghost?.y))continue;const marker=document.createElement('span');marker.className='ghost-dot';marker.style.left=`${50+Math.max(-1,Math.min(1,ghost.x))*38}%`;marker.style.top=`${50+Math.max(-1,Math.min(1,ghost.y))*38}%`;dial.appendChild(marker);}}\n    if(app.session.finished&&!app.hubRound)finish();\n  }\n  requestAnimationFrame(frame);\n}\n\nfunction hubScore(){return app.hubTotal+(app.session?.result().score||0)*10;}\nfunction beginHubEvent(index){app.hubEvent=index;const activity=ACTIVITIES.find(item=>item.id===app.hubPicks[index]);begin(activity,{duration:EVENT_SECONDS,random:globalThis.AIHub.rng(`event:${index}`),hard:false,tuning:{...DEFAULT_TUNABLES,timeScale:1}});}\nfunction finishHub(){if(!app.hubRound||app.hubEnded)return;const score=hubScore();app.hubEnded=true;app.hubRound=false;clearInterval(app.hubTimer);globalThis.AIHub.result({score});app.result={score};go('hub-finished');}\nfunction syncHub(){\n  const window=medleyWindow(globalThis.AIHub.time());\n  if(window.phase==='finished'){finishHub();return false;}\n  if(window.index>app.hubEvent){app.hubTotal+=(app.session?.result().score||0)*10;beginHubEvent(window.index);}\n  if(window.phase!=='event'){\n    const seconds=document.getElementById('seconds'),cue=document.getElementById('live-cue');\n    if(seconds)seconds.textContent=Math.ceil(window.remaining);\n    if(cue)cue.textContent=window.phase==='countdown'?'GET READY · STARTING TOGETHER':`EVENT COMPLETE · NEXT IN ${Math.ceil(window.remaining)}`;\n    return false;\n  }\n  return true;\n}\nfunction sendHubState(){if(!app.hubRound||app.hubEnded||!app.session)return;const hub=globalThis.AIHub,score=hubScore();hub.progress({score,label:app.activity.name});hub.send({a:app.hubEvent,x:app.session.dot.x,y:app.session.dot.y,c:0,t:app.session.elapsed,s:score},{reliable:false});}\nfunction setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>{app.hubClosed=false;go('hub-card');});hub.on('start',()=>{app.hubClosed=false;app.hubRound=true;app.hubEnded=false;app.hubScores={};app.hubTotal=0;app.hubPicks=pickMedley(hub.rng('medley'));beginHubEvent(0);clearInterval(app.hubTimer);sendHubState();app.hubTimer=setInterval(sendHubState,100);});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',finishHub);hub.on('end',()=>{clearInterval(app.hubTimer);app.hubRound=false;app.hubEnded=true;app.hubClosed=true;sound.context?.suspend();});hub.connect({mode:'ghost',seats:[1,4],card:true}).then(info=>{if(info)hub.ready();});}\nwindow.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\nrender();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef complete_week(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        start_profile(page)\n        click(page, 'weigh')\n        for _ in range(3):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n        screen(page, 'weigh-result')\n        assert len(state(page)['profiles'][0]['history']) == 3\n        click(page, 'island')\n        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\n            assert state(page)['day'] == day\n        click(page, 'finale')\n        click(page, 'start')\n        finish(page)\n        screen(page, 'reveal')\n        assert state(page)['profiles'][0]['revealed'] is True\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef family(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        click(page, 'family')\n        click(page, 'family-start', '[data-count=\"2\"]')\n        for _ in range(6):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        screen(page, 'medley-board')\n        assert page.get_by_text('PLAYER 1', exact=True).count() == 1\n        assert page.get_by_text('PLAYER 2', exact=True).count() == 1\n    finally:\n        browser.close()\n\n\ndef mobile(playwright, url):\n    browser = playwright.webkit.launch(headless=True)\n    context = browser.new_context(**playwright.devices['iPhone 17 Pro'])\n    page = context.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        assert page.get_by_text('Controller or keyboard required').is_visible()\n        assert page.locator('[data-action=\"slots\"]').count() == 0\n        click(page, 'settings')\n        assert page.locator('#music').input_value() == '0.1'\n    finally:\n        context.close()\n        browser.close()\n\n\ndef attract(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_function('window.__GAME__.state().attract', timeout=13000)\n        page.keyboard.press('Enter')\n        screen(page, 'title')\n    finally:\n        browser.close()\n\n\ndef webgpu(playwright, url):\n    browser = playwright.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-angle=swiftshader', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_selector('#world canvas', timeout=12000)\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthreading.Thread(target=server.serve_forever, daemon=True).start()\nurl = f'http://127.0.0.1:{server.server_port}/' + urllib.parse.quote(FILENAME)\ntry:\n    with sync_playwright() as playwright:\n        for name in ('chromium', 'firefox', 'webkit'):\n            check(name + ' profile, activity, persistence', lambda name=name: smoke(getattr(playwright, name), url))\n        check('seven-day playthrough and all activities', lambda: complete_week(playwright.chromium, url))\n        check('family medley', lambda: family(playwright.chromium, url))\n        check('touch-only notice', lambda: mobile(playwright, url))\n        check('idle attract and wake', lambda: attract(playwright.chromium, url))\n        check('WebGPU island', lambda: webgpu(playwright, url))\nfinally:\n    server.shutdown()\nprint(json.dumps({'passed': passed, 'failures': failures}))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_575","type":"reasoning","text":"**Rendering game lines**"}}
{"type":"item.started","item":{"id":"item_576","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; nl -ba \\\"\"'$DEV/src/main.js\" | sed -n '\"'29,96p'; cat \\\"\"'$DEV/src/data/medley.js\"; cat \"$DEV/src/core/session.js\" | head -80; tail -25 \"$DEV/src/main.js\"; cat \"$DEV/src/ui/overrides.css\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_576","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; nl -ba \\\"\"'$DEV/src/main.js\" | sed -n '\"'29,96p'; cat \\\"\"'$DEV/src/data/medley.js\"; cat \"$DEV/src/core/session.js\" | head -80; tail -25 \"$DEV/src/main.js\"; cat \"$DEV/src/ui/overrides.css\"'","aggregated_output":"    29\t  document.body.classList.toggle('reduce-motion',app.settings.motion);\n    30\t  let content='';\n    31\t  if(app.screen==='title'){\n    32\t    content=panel(`${brand}<h1 class=\"title\">${escape(TITLE.split(' ').slice(0,2).join(' '))}<br><span>${escape(TITLE.split(' ').slice(2).join(' '))}.</span></h1><p class=\"lede\">A week of movement, a talking scale, and absolutely no pressure to be graceful.</p><div class=\"title-tag\">YOUR ISLAND IS READY</div>${notice()?`<p class=\"description\" style=\"margin-top:18px\"><strong>Controller or keyboard required</strong></p><div class=\"menu\">${button('Settings','settings','','ghost')}</div>`:`<div class=\"menu\">${button('Begin your week','slots','','primary')}<div class=\"menu-row\">${button('Drop-in','dropin','','ghost')}${button('Family Hour','family','','ghost')}</div><div class=\"menu-row\">${button('Settings','settings','','ghost')}${button('About','about','','ghost')}</div></div>${footer()}`}`,'title-screen')+`<div class=\"hero-note\">WELCOME TO LITTLE ISLAND<strong>Take it one wobble at a time.</strong>EST. WHENEVER YOU ARE READY</div>`;\n    33\t  }else if(app.screen==='slots'){\n    34\t    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">YOUR WEEK</span></div>${heading('A PLACE TO BEGIN','Who is stepping on?','Choose a profile. Your island remembers your progress on this device.')}<div class=\"stack\">${app.profiles.map((item,index)=>`<button class=\"list-item\" data-action=\"slot\" data-index=\"${index}\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">${item?escape(item.name):'Start a new week'}</span><span class=\"sub\">${item?`DAY ${item.day} · ${item.drips} DRIPS`:'EMPTY PROFILE'}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div>${footer()}`);\n    35\t  }else if(app.screen==='island'){\n    36\t    const player=profile(), day=Math.min(player.day,7), activities=activityForDay(day);\n    37\t    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge sun\">✦ ${player.drips} DRIPS</span></div>${heading(`DAY ${day} / 7 · ${DAY_NAMES[day-1]}`,'Good to see you. ',`Ounce says: “${day===7?'Today, we stand together. And I owe you an explanation.':'The island is ready when you are.'}”`)}<div class=\"stats\"><span class=\"badge\">${escape(player.name)}</span> <span class=\"badge\">${player.stars} STARS</span> <span class=\"badge\">WOBBLE AGE ${player.history.length?wobbleAge(player):'—'}</span></div><div class=\"stack\"><button class=\"list-item\" data-action=\"weigh\"><span class=\"icon\">◉</span><span><span class=\"name\">Daily weigh-in</span><span class=\"sub\">THREE LITTLE BALANCE CHECKS</span></span><span class=\"arrow\">→</span></button>${day===7?`<button class=\"list-item\" data-action=\"finale\"><span class=\"icon\">✦</span><span><span class=\"name\">The Long Stand</span><span class=\"sub\">YOUR WEEK FINALE</span></span><span class=\"arrow\">→</span></button>`:''}</div><div class=\"eyebrow\" style=\"margin-top:20px\">PICK A PRACTICE · ${activities.length} OPEN</div><div class=\"scroll-list stack\">${activities.map(activity=>`<button class=\"list-item\" data-action=\"intro\" data-id=\"${activity.id}\"><span class=\"icon\">${iconFor(activity.family)}</span><span><span class=\"name\">${escape(activity.name)}</span><span class=\"sub\">${escape(activity.place.toUpperCase())} · ${activity.duration} SEC ${player.played[activity.id]?`· ${'★'.repeat(player.played[activity.id])}`:''}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div><div class=\"menu-row\" style=\"margin-top:12px\">${button('Day report','day-report','','small')}${button('Settings','settings','','small ghost')}</div>${footer()}`,'island-screen');\n    38\t  }else if(app.screen==='intro'){\n    39\t    const activity=app.activity;\n    40\t    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',escape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to breathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','start','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n    41\t  }else if(app.screen==='game'){\n    42\t    const activity=app.session.activity;\n    43\t    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n    44\t  }else if(app.screen==='pause'){\n    45\t    content=panel(`<div class=\"topline\"><span class=\"badge\">TAKE YOUR TIME</span></div>${heading('PAUSED','A little breather.','Your island will be right here.')}<div class=\"menu\">${button('Resume','resume','','primary')}${button('Settings','settings','','ghost')}${button('Dev tools','dev','','ghost')}${button('Leave practice','leave','','ghost')}</div>${footer()}`);\n    46\t  }else if(app.screen==='results'){\n    47\t    const result=app.result;\n    48\t    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND IS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;color:#8ca397\"> / 100</small></div><div class=\"stars\">${'★'.repeat(result.stars)}${'☆'.repeat(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS OF YOU TIME</span></div><div class=\"menu\">${button(app.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the island','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</div>${footer()}`);\n    49\t  }else if(app.screen==='weigh-result'){\n    50\t    content=panel(`<div class=\"topline\"><span class=\"badge\">DAILY CHECK-IN</span></div>${heading('A NUMBER, NOT A VERDICT','Your wobble age','Ounce has reviewed your three balance checks with tremendous confidence.')}<div class=\"score-hero\">${wobbleAge(profile())}</div><p class=\"description\">This is just a playful score, not a measure of health. Keep moving at your own pace.</p><div class=\"menu\">${button('Back to the island','island','','primary')}</div>${footer()}`);\n    51\t  }else if(app.screen==='day-report'){\n    52\t    const player=profile();\n    53\t    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have collected ${player.drips} drips and ${player.stars} stars. You showed up; the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S NOTE</strong><p>${player.day===6?'Tomorrow is the Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a perfectly planned nap. Usually.'}</p></div><div class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n    54\t  }else if(app.screen==='reveal'){\n    55\t    content=panel(`${brand}${heading('THE LONG STAND','Ounce comes clean.','“I added seven years to everyone’s wobble age. I thought you would come back if the number worried you. That was wrong.”')}<p class=\"description\" style=\"margin-top:16px\">The island agrees: a number should never tell you your worth. Your wobble age is now honest, and the island remains open.</p><div class=\"menu\">${button('A fresh start','island','','primary')}</div>`);\n    56\t  }else if(app.screen==='family'){\n    57\t    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take turns through a three-event medley. Highest total wins; kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} ${number===1?'player':'players'}`,'family-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n    58\t  }else if(app.screen==='medley-board'){\n    59\t    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n    60\t    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the spotlight.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER ${entry.index+1}</span><span class=\"sub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n    61\t  }else if(app.screen==='settings'||app.screen==='dev'){\n    62\t    const dev=app.screen==='dev';\n    63\t    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" min=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Math.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':''}>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n    64\t    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER TOOLS':'YOUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\"stack\">${ranges}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\n    65\t  }else if(app.screen==='about'){\n    66\t    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n    67\t    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful tribute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: ${value}`))}${section('Testing Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt Feedback',about.promptFeedback)}</div>${footer()}`);\n    68\t  }else if(app.screen==='hub-card'){\n    69\t    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div class=\"menu\">${button('Ready','hub-ready','','primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n    70\t  }else if(app.screen==='hub-finished'){\n    71\t    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Well wobbled.','Your score is in. The hub will show the final standings.')}<div class=\"badge sun\">${app.result?.score||0} POINTS</div>`);\n    72\t  }\n    73\t  ui.innerHTML=content;\n    74\t  app.focus=0;\n    75\t  const first=ui.querySelector('button:not(:disabled)');if(first&&app.inputKind==='gamepad')first.classList.add('focused');\n    76\t}\n    77\t\n    78\tfunction go(screen){app.screen=screen;render();}\n    79\tfunction begin(activity,options={}){\n    80\t  app.activity=activity;app.session=new ActivitySession(activity,{hard:app.hard,tuning:app.tuning,...options});app.paused=false;go('game');\n    81\t}\n    82\tfunction finish(){\n    83\t  if(!app.session)return;\n    84\t  app.result=app.session.result();\n    85\t  if(app.attract){app.attractIndex++;startAttract();return;}\n    86\t  if(app.hubRound)return;\n    87\t  if(app.weigh){app.weigh.push(app.result.score/100);if(app.weigh.length<3){startWeigh();return;}profile().history.push(...app.weigh);profile().history=profile().history.slice(-3);app.weigh=null;save();go('weigh-result');return;}\n    88\t  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;go('results');return;}\n    89\t  if(profile()){const player=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=Math.max(app.result.stars,player.played[app.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n    90\t  sound.effect('good');go('results');\n    91\t}\n    92\tfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the breeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});}\n    93\tfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\n    94\tfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const activity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequence.length]);begin(activity,{duration:12});}\n    95\tfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\n    96\tfunction act(action,element){\nexport const EVENT_SECONDS = 55;\nexport const BREAK_SECONDS = 10;\nexport const MEDLEY_SECONDS = EVENT_SECONDS * 3 + BREAK_SECONDS * 2;\n\nexport function pickMedley(random) {\n  const choose = choices => choices[Math.floor(random() * choices.length)];\n  return [choose(['tree', 'heron', 'warrior']), choose(['squats', 'hoop', 'step']), 'header'];\n}\n\nexport function medleyWindow(milliseconds) {\n  const seconds = milliseconds / 1000;\n  if (seconds < 0) return { phase: 'countdown', index: 0, remaining: -seconds };\n  if (seconds >= MEDLEY_SECONDS) return { phase: 'finished', index: 2, remaining: 0 };\n  const span = EVENT_SECONDS + BREAK_SECONDS;\n  const index = Math.min(2, Math.floor(seconds / span));\n  const elapsed = seconds - index * span;\n  if (elapsed >= EVENT_SECONDS) return { phase: 'break', index, remaining: span - elapsed };\n  return { phase: 'event', index, remaining: EVENT_SECONDS - elapsed };\n}\nimport { Dot, DEFAULT_TUNABLES } from './dot.js';\n\nconst clamp=(value,low,high)=>Math.max(low,Math.min(high,value));\nexport function makeProfile(name='PLAYER') {return {name,day:1,drips:0,stars:0,history:[],played:{},goal:'FIND YOUR BALANCE',revealed:false,completedDays:[]};}\nexport function wobbleAge(profile) {\n  const scores=profile.history.slice(-3);\n  const average=scores.length?scores.reduce((sum,value)=>sum+value,0)/scores.length:.5;\n  return clamp(Math.round(20+60*(1-average)-Math.min(20,profile.stars*.5)),18,95)+(profile.revealed?0:7);\n}\nexport class ActivitySession {\n  constructor(activity,options={}) {\n    this.activity=activity; this.hard=!!options.hard; this.duration=options.duration??activity.duration;\n    this.dot=new Dot(options.random); this.elapsed=0; this.points=0; this.samples=0; this.breathSync=.5;\n    this.rep=.0; this.hoopLift=.65; this.lastAngle=null; this.angleSpeed=0; this.goodSteps=0; this.lastStep=-2; this.hits=0;\n    this.tuning={...DEFAULT_TUNABLES,...options.tuning}; this.finished=false; this.distance=0; this.lastDirection=0;\n    this.eventCount=0; this.lastBeat=-1; this.notes=[];\n  }\n  update(dt,input={}) {\n    if(this.finished)return;\n    dt=clamp(dt*(this.tuning.timeScale??1),0,.1); this.elapsed+=dt;\n    const {x=0,y=0,breath=false,left=false,right=false}=input;\n    const family=this.activity.family, t=this.elapsed;\n    const breathIn=this.activity.breath?Math.sin(t*Math.PI*2/this.activity.breath)>0:false;\n    if(this.activity.breath) this.breathSync+=(Number(breath===breathIn)-this.breathSync)*Math.min(1,dt*2);\n    const modifiers={noise:this.activity.breath?1.25-.55*this.breathSync:1};\n    if(this.activity.id==='heron')modifiers.bx=.12*Math.sin(t*.7);\n    if(this.activity.id==='tax')modifiers.bx=.18*Math.sin(t*.9);\n    if(this.activity.id==='chair')modifiers.noise*=1+.5*t/this.duration;\n    if(this.activity.id==='plank')modifiers.inst=1.2;\n    this.dot.step(dt,x,y,this.tuning,modifiers);\n    const distance=Math.hypot(this.dot.x,this.dot.y);\n    let quality=0;\n    if(family==='still'||family==='tray'||family==='slack'||family==='jump'){\n      const ring=(this.activity.ring??(family==='slack'?.32:.48))*(this.hard?.8:1);\n      quality=distance<ring?1:0;\n      if(this.activity.breath)quality=.8*quality+.2*this.breathSync;\n      if(family==='slack'){\n        if((left||right)&&t-this.lastStep>.14){this.lastStep=t;this.goodSteps++;this.distance+=distance<.75?1:.15;}\n        quality*=.45+.55*clamp(this.goodSteps/(t*1.5),0,1);\n      }\n      if(family==='jump'&&breath&&t-this.lastStep>2){this.lastStep=t;this.goodSteps++;this.distance+=distance<.6?1:0;}\n      if(family==='jump') quality*=.5+.5*clamp(this.goodSteps/Math.max(1,t/5),0,1);\n    } else if(family==='reps'){\n      const phase=(t/3.2)%1;\n      const target=phase<.4?phase/.4:phase<.55?1:phase<.9?1-(phase-.55)/.35:0;\n      const requested=this.activity.id==='lunges'?Math.abs(x):this.activity.id==='mortgage'?Math.max(0,y):Math.max(0,-y);\n      this.rep+=(requested-this.rep)*Math.min(1,dt/((this.activity.id==='mortgage'?.15:.10)));\n      quality=clamp(1-1.6*Math.abs(this.rep-target),0,1);\n    } else if(family==='hoop'){\n      const magnitude=Math.hypot(x,y);\n      if(magnitude>.5){const angle=Math.atan2(y,x);if(this.lastAngle!==null){let delta=angle-this.lastAngle;while(delta>Math.PI)delta-=Math.PI*2;while(delta< -Math.PI)delta+=Math.PI*2;this.angleSpeed+=(Math.abs(delta)/Math.max(dt,.001)-this.angleSpeed)*Math.min(1,dt/.25);}this.lastAngle=angle;}else{this.angleSpeed*=Math.max(0,1-dt*3);this.lastAngle=null;}\n      const inBand=this.angleSpeed>4.5&&this.angleSpeed<18;\n      this.hoopLift=clamp(this.hoopLift+(inBand?.35:-.15)*dt,0,1);quality=this.hoopLift;\n    } else if(family==='step'||family==='jog'){\n      const beat=Math.floor(t/.7);\n      if(beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;}\n      if((left||right)&&t-this.lastStep>.12){const side=left?-1:1;const phase=Math.abs((t/.7)-Math.round(t/.7));if(family==='jog'?side!==this.lastDirection:phase<.23){this.goodSteps++;}this.lastDirection=side;this.lastStep=t;}\n      quality=clamp(this.goodSteps/Math.max(1,this.eventCount-1),0,1);\n    } else if(family==='header'){\n      const beat=Math.floor((t-1.2)/2.4);\n      if(beat>=0&&beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;const target=beat%2===0?-1:1;if(Math.sign(x)===target)this.hits++;}\n      quality=this.hits/Math.max(1,this.eventCount);\n    }\n    this.points+=quality*dt;this.samples+=dt;\n    if(this.elapsed>=this.duration)this.finished=true;\n  }\n  result(){const score=Math.round(100*this.points/Math.max(.001,this.samples));const thresholds=this.activity.family==='reps'?[55,75,90]:[45,70,90];const stars=thresholds.filter(value=>score>=value).length;return {score,stars,drips:2+stars*3+Math.floor(this.duration/30),seconds:this.duration};}\n}\n    if(dial&&app.hubRound){dial.querySelectorAll('.ghost-dot').forEach(node=>node.remove());for(const ghost of Object.values(app.hubScores).slice(0,3)){if(ghost?.a!==app.hubEvent||!Number.isFinite(ghost?.x)||!Number.isFinite(ghost?.y))continue;const marker=document.createElement('span');marker.className='ghost-dot';marker.style.left=`${50+Math.max(-1,Math.min(1,ghost.x))*38}%`;marker.style.top=`${50+Math.max(-1,Math.min(1,ghost.y))*38}%`;dial.appendChild(marker);}}\n    if(app.session.finished&&!app.hubRound)finish();\n  }\n  requestAnimationFrame(frame);\n}\n\nfunction hubScore(){return app.hubTotal+(app.session?.result().score||0)*10;}\nfunction beginHubEvent(index){app.hubEvent=index;const activity=ACTIVITIES.find(item=>item.id===app.hubPicks[index]);begin(activity,{duration:EVENT_SECONDS,random:globalThis.AIHub.rng(`event:${index}`),hard:false,tuning:{...DEFAULT_TUNABLES,timeScale:1}});}\nfunction finishHub(){if(!app.hubRound||app.hubEnded)return;const score=hubScore();app.hubEnded=true;app.hubRound=false;clearInterval(app.hubTimer);globalThis.AIHub.result({score});app.result={score};go('hub-finished');}\nfunction syncHub(){\n  const window=medleyWindow(globalThis.AIHub.time());\n  if(window.phase==='finished'){finishHub();return false;}\n  if(window.index>app.hubEvent){app.hubTotal+=(app.session?.result().score||0)*10;beginHubEvent(window.index);}\n  if(window.phase!=='event'){\n    const seconds=document.getElementById('seconds'),cue=document.getElementById('live-cue');\n    if(seconds)seconds.textContent=Math.ceil(window.remaining);\n    if(cue)cue.textContent=window.phase==='countdown'?'GET READY · STARTING TOGETHER':`EVENT COMPLETE · NEXT IN ${Math.ceil(window.remaining)}`;\n    return false;\n  }\n  return true;\n}\nfunction sendHubState(){if(!app.hubRound||app.hubEnded||!app.session)return;const hub=globalThis.AIHub,score=hubScore();hub.progress({score,label:app.activity.name});hub.send({a:app.hubEvent,x:app.session.dot.x,y:app.session.dot.y,c:0,t:app.session.elapsed,s:score},{reliable:false});}\nfunction setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>{app.hubClosed=false;go('hub-card');});hub.on('start',()=>{app.hubClosed=false;app.hubRound=true;app.hubEnded=false;app.hubScores={};app.hubTotal=0;app.hubPicks=pickMedley(hub.rng('medley'));beginHubEvent(0);clearInterval(app.hubTimer);sendHubState();app.hubTimer=setInterval(sendHubState,100);});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',finishHub);hub.on('end',()=>{clearInterval(app.hubTimer);app.hubRound=false;app.hubEnded=true;app.hubClosed=true;sound.context?.suspend();});hub.connect({mode:'ghost',seats:[1,4],card:true}).then(info=>{if(info)hub.ready();});}\nwindow.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\nrender();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\n.title-screen .glass{padding:clamp(20px,2.5vw,32px)}\n.title{font-size:clamp(48px,5vw,72px);margin:20px 0 12px}\n.title-screen .menu{margin-top:16px}\n.title-screen .footnote{margin-top:14px}\n.game-tip strong{color:#436d5d;letter-spacing:.03em}\n.game-tip .key{white-space:nowrap}\n.ghost-dot{position:absolute;width:14px;height:14px;margin:-7px;border:2px solid white;border-radius:50%;background:#738dd4;opacity:.75;z-index:2;pointer-events:none}\n.fallback-board{position:absolute;left:50%;top:57%;width:clamp(52px,8vw,105px);height:clamp(15px,2.3vw,29px);transform:translate(-50%,-50%) rotate(8deg);border-radius:50%;background:#faf4e3;box-shadow:0 5px 0 #b5b8a6,0 8px 12px #476d5a55;z-index:2}\n.fallback-avatar{position:absolute;left:50%;top:57%;width:clamp(45px,7vw,90px);height:clamp(70px,11vw,138px);transform:translate(-50%,-92%) rotate(calc(8deg + var(--avatar-lean,0deg)));transform-origin:50% 92%;z-index:3}\n.fallback-avatar span{position:absolute;display:block}\n.fallback-head{left:29%;top:0;width:42%;height:29%;border-radius:48%;background:#f2c49e;box-shadow:inset 0 5px #805f50}\n.fallback-head:after{content:'';position:absolute;left:32%;top:50%;width:4%;height:6%;border-radius:50%;background:#405d55;box-shadow:1em 0 #405d55}\n.fallback-body{left:23%;top:25%;width:54%;height:43%;border-radius:40% 40% 30% 30%;background:#e9856c;box-shadow:inset 0 -5px #d77760}\n.fallback-arm{top:30%;width:14%;height:35%;border-radius:30px;background:#efbd9b;transform-origin:50% 10%}\n.fallback-arm.left{left:22%;transform:rotate(45deg)}.fallback-arm.right{right:22%;transform:rotate(-45deg)}\n.fallback-leg{top:62%;width:14%;height:29%;border-radius:20px;background:#46645c}.fallback-leg.left{left:32%;transform:rotate(8deg)}.fallback-leg.right{right:32%;transform:rotate(-8deg)}\n@media(max-width:700px){.title{font-size:clamp(46px,12vw,66px)}.title-screen .glass{padding:22px}}\n@media(max-width:360px){.game-tip .key{font-size:9px;padding:0 4px}}\n","exit_code":0,"status":"completed"}}
