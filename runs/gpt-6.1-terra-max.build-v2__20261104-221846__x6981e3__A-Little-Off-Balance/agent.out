{"type":"item.completed","item":{"id":"item_228","type":"command_execution","command":"/bin/bash -lc \"sed -n '68,150p' src/main.js | fold -w 220\"","aggregated_output":"    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div class=\"menu\">${button('Ready','hub-ready','',\n'primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n  }\n  ui.innerHTML=content;\n  app.focus=0;\n  const first=ui.querySelector('button:not(:disabled)');if(first&&app.inputKind==='gamepad')first.classList.add('focused');\n}\n\nfunction go(screen){app.screen=screen;render();}\nfunction begin(activity,options={}){\n  app.activity=activity;app.session=new ActivitySession(activity,{hard:app.hard,tuning:app.tuning,...options});app.paused=false;go('game');\n}\nfunction finish(){\n  if(!app.session)return;\n  app.result=app.session.result();\n  if(app.attract){app.attractIndex++;startAttract();return;}\n  if(app.hubRound){advanceHub();return;}\n  if(app.weigh){app.weigh.push(app.result.score/100);if(app.weigh.length<3){startWeigh();return;}profile().history.push(...app.weigh);profile().history=profile().history.slice(-3);app.weigh=null;save();go('weigh-result')\n;return;}\n  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;go('results');return;}\n  if(profile()){const player=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=Math.max(app.result.stars,player.played[\napp.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n  sound.effect('good');go('results');\n}\nfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the breeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ri\nng:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});}\nfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>act\nivity.id===id).name}`},{duration:20});}\nfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const activity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequence.length]);begin(activity,{duration:12})\n;}\nfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\nfunction act(action,element){\n  sound.unlock();sound.effect('select');app.lastInput=performance.now();\n  if(app.attract){leaveAttract();return;}\n  if(action==='title'){app.session=null;app.medley=null;app.guest=null;go('title');}\n  else if(action==='slots')go('slots');\n  else if(action==='slot'){app.guest=null;app.slot=Number(element.dataset.index);if(!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('island');}\n  else if(action==='dropin'){app.guest=makeProfile('GUEST');app.guest.day=7;app.guest.revealed=true;app.returnScreen='island';go('island');}\n  else if(action==='island'){app.medley=null;app.weigh=null;go('island');}\n  else if(action==='intro'){app.activity=ACTIVITIES.find(item=>item.id===element.dataset.id);app.returnScreen='island';app.hard=false;sound.effect('voice');go('intro');}\n  else if(action==='hard'){app.hard=!app.hard;render();}\n  else if(action==='start')begin(app.activity);\n  else if(action==='weigh'){app.weigh=[];startWeigh();}\n  else if(action==='finale'){app.activity={...ACTIVITIES[0],id:'finale',name:'The Long Stand',place:'Pavilion',duration:45,ring:.32,quip:'A LITTLE HONESTY GOES A LONG WAY.'};app.returnScreen='island';go('intro');}\n  else if(action==='continue'){if(app.medley){app.medley.player++;if(app.medley.player>=app.medley.scores.length){app.medley.player=0;app.medley.event++;}if(app.medley.event>=3)go('medley-board');else startMedley();}else\n go('island');}\n  else if(action==='day-report')go('day-report');\n  else if(action==='next-day'){if(profile().day<7)profile().day++;save();go('island');}\n  else if(action==='family')go('family');\n  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n  else if(action==='settings'){app.settingsFrom=app.screen;go('settings');}\n  else if(action==='settings-back')go(app.screen==='dev'?'pause':app.settingsFrom||'title');\n  else if(action==='dev')go('dev');\n  else if(action==='reset-tuning'){app.tuning={...DEFAULT_TUNABLES};if(app.session)app.session.tuning={...app.tuning};render();}\n  else if(action==='resume'){app.paused=false;go('game');}\n  else if(action==='leave'){app.session=null;app.medley=null;app.weigh=null;go(profile()?'island':'title');}\n  else if(action==='about')go('about');\n  else if(action==='hub-ready')globalThis.AIHub?.answer('ready');\n  else if(action==='hub-more')globalThis.AIHub?.answer('more');\n}\nui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\nui.addEventListener('pointerover',event=>{const target=event.target.closest('button');if(target){ui.querySelectorAll('button.focused').forEach(item=>item.classList.remove('focused'));target.classList.add('focused');app.f\nocus=Array.from(ui.querySelectorAll('button:not(:disabled)')).indexOf(target);}});\nui.addEventListener('input',event=>{const target=event.target;if(target.dataset.setting){const key=target.dataset.setting;app.settings[key]=target.type==='checkbox'?target.checked:target.type==='range'?Number(target.valu\ne):target.value;save();document.body.classList.toggle('high-contrast',app.settings.contrast);document.body.classList.toggle('reduce-motion',app.settings.motion);}if(target.dataset.tune){app.tuning[target.dataset.tune]=Nu\nmber(target.value);if(app.session)app.session.tuning={...app.tuning};}});\nfunction menuMove(delta){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));if(!buttons.length)return;app.focus=(app.focus+delta+buttons.length)%buttons.length;buttons.forEach((item,index)=>item.class\nList.toggle('focused',index===app.focus));buttons[app.focus].focus();buttons[app.focus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\nwindow.addEventListener('keydown',event=>{const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='tit\nle'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='ga\nme'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else i\nf(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const ba\nckButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nwindow.addEventListener('keyup',event=>app.keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur',()=>app.keys.clear());\nwindow.addEventListener('pointerdown',event=>{app.lastInput=performance.now();if(app.attract){leaveAttract();return;}sound.unlock();if(event.pointerType==='mouse')app.inputKind='mouse';});\nui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const rect=dial.getBoundingClientRect();app.mouse={x:Math.max(\n-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.height/2)/(rect.height/2)))};app.lastInput=performance.now();});\nwindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n\nfunction gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9\n)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)\n'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>ite\nm.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nfunction frame(now){const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);const pad=gamepad();if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();i\nf(app.screen==='game'&&app.session){let x=Number(app.keys.has('d')||app.keys.has('arrowright'))-Number(app.keys.has('a')||app.keys.has('arrowleft'));let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.k\neys.has('w')||app.keys.has('arrowup'));if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}if(app.attract)\n{const time=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(Math.floor(time*3)%2===0)app.inpu\nt.left=true;else app.input.right=true;}if(app.driver==='perfect'){x=0;y=0;}app.session.update(dt,{x,y,breath:app.keys.has(' ')||!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;\napp.input.right=false;const dot=document.getElementById('balance-dot'),seconds=document.getElementById('seconds'),meter=document.getElementById('meter'),score=document.getElementById('live-score');if(dot){dot.style.left=\n`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));if(meter)meter.style.width=`${Math.min(100,app.ses\nsion.elapsed/app.session.duration*100)}%`;if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'KEEP GOING'}`;if(app.hubRound&&now-app.hubClock>500){app.hubClock\n=now;const partial=app.hubTotal+app.session.result().score;globalThis.AIHub?.progress({score:partial,label:app.activity.name});globalThis.AIHub?.send({x:app.session.dot.x,y:app.session.dot.y,score:partial});}if(app.sessi\non.finished)finish();}requestAnimationFrame(frame);}\n\nfunction advanceHub(){if(app.hubEnded)return;app.hubTotal+=app.session.result().score;app.hubEvent++;if(app.hubEvent>=3){app.hubEnded=true;globalThis.AIHub?.result({score:app.hubTotal});app.result={...app.session.result(\n),score:app.hubTotal,stars:0,drips:0};app.hubRound=false;go('results');}else begin({...ACTIVITIES.find(item=>item.id===['tree','hoop','step'][app.hubEvent])},{duration:20});}\nfunction setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>go('hub-card'));hub.on('start',()=>{app.hubRound=true;app.hubEnded=false;app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{dur\nation:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&!app.hubEnded){app.hubEnded=true;hub.result({score:app.hubTotal+(app.session?.result().score||0)});app.hubRo\nund=false;}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.ready();}\nwindow.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.\nday,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return \napp.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\nrender();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\n","exit_code":0,"status":"completed"}}
