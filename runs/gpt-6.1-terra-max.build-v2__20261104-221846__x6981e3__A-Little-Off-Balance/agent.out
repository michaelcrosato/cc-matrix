{"type":"item.started","item":{"id":"item_664","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; head -11 \\\"\"'$DEV/tools/build.mjs\"; sed -n '\"'149,155p' \\\"\"'$DEV/src/main.js\"; rg -n '\"'\"'^function gamepad|''^function go'\"\\\\(' \\\"\"'$DEV/src/main.js\"; sed -n '\"'1,90p' \\\"\"'$DEV/tests/browser.py\"; head -45 \"$DEV/CREDITS.md\"; cat \"$DEV/tests/run.mjs\" | tail -45'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_664","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; head -11 \\\"\"'$DEV/tools/build.mjs\"; sed -n '\"'149,155p' \\\"\"'$DEV/src/main.js\"; rg -n '\"'\"'^function gamepad|''^function go'\"\\\\(' \\\"\"'$DEV/src/main.js\"; sed -n '\"'1,90p' \\\"\"'$DEV/tests/browser.py\"; head -45 \"$DEV/CREDITS.md\"; cat \"$DEV/tests/run.mjs\" | tail -45'","aggregated_output":"import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';\nimport {execFileSync} from 'node:child_process';\nimport {TITLE} from '../src/data/title.js';\nimport {about} from '../src/data/about.js';\n\nmkdirSync('.build',{recursive:true});\nexecFileSync('esbuild',['src/main.js','--bundle','--format=esm','--platform=browser','--target=esnext','--charset=utf8','--outfile=.build/game.js','--log-level=warning'],{stdio:'inherit'});\nconst safe=source=>source.replace(/<\\/script/gi,'<\\\\/script');\nconst css=readFileSync('src/ui/style.css','utf8')+readFileSync('src/ui/overrides.css','utf8');\nconst hub=safe(readFileSync('vendor/hub/session.js','utf8'));\nconst game=safe(readFileSync('.build/game.js','utf8'));\nwindow.addEventListener('keydown',event=>{if(app.screen!=='family'||event.repeat)return;const key=event.key.toLowerCase();if(!['enter',' ','b','escape'].includes(key))return;event.preventDefault();event.stopImmediatePropagation();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(key==='enter')familyJoin('keyboard');else if(key==='b')familyJoin('bot');else if(key===' '&&app.medley.members.length)startMedley();else if(key==='escape')act('title');},true);\nwindow.addEventListener('keydown',event=>{if(app.hubClosed)return;const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;if(app.screen==='hub-card'&&(key==='enter'||key==='m')){event.preventDefault();globalThis.AIHub?.answer(key==='m'?'more':'ready');return;}app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nwindow.addEventListener('keyup',event=>app.keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur',()=>app.keys.clear());\nwindow.addEventListener('pointerdown',event=>{app.lastInput=performance.now();if(app.attract){leaveAttract();return;}sound.unlock();if(event.pointerType==='mouse')app.inputKind='mouse';});\nui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const rect=dial.getBoundingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.height/2)/(rect.height/2)))};app.lastInput=performance.now();});\nwindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n82:function go(screen){app.screen=screen;render();}\n157:function gamepad(){if(app.medley&&['family','game'].includes(app.screen))return null;const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen==='hub-card'&&just(3))globalThis.AIHub?.answer('more');if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n# Credits (Pixel Engine 0.46.0)\n\nWhat this kit carries and where it came from, generated by `npm run bundle` from each built-in model's and texture's `source` (the data the engine repository's `npm run model -- credits` reads) and from the bundled packages' own licence files. Ship this file with a game built on the kit.\n\n## Models and textures\n\n- **The engine's own work**, made in its repository: 151 of the 151 library models (`MODEL_LIBRARY`), 126 of the 126 textures (`TEXTURE_LIBRARY`) and the built-in models (`assets/coin.glb`, `assets/hero.glb`, `assets/tree.glb`). Nothing to credit.\n- **kenney-castle** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/castle-kit/a395102d20-1711543616/kenney_castle-kit.zip. Models: kenney-castle/bridge-draw, kenney-castle/bridge-straight-pillar, kenney-castle/bridge-straight, kenney-castle/door, kenney-castle/flag-banner-long, kenney-castle/flag-banner-short, kenney-castle/flag-pennant, kenney-castle/flag-wide, kenney-castle/flag, kenney-castle/gate, kenney-castle/ground-hills, kenney-castle/ground, kenney-castle/metal-gate, kenney-castle/rocks-large, kenney-castle/rocks-small, kenney-castle/siege-ballista-demolished, kenney-castle/siege-ballista, kenney-castle/siege-catapult-demolished, kenney-castle/siege-catapult, kenney-castle/siege-ram-demolished, kenney-castle/siege-ram, kenney-castle/siege-tower-demolished, kenney-castle/siege-tower, kenney-castle/siege-trebuchet-demolished, kenney-castle/siege-trebuchet, kenney-castle/stairs-stone-square, kenney-castle/stairs-stone, kenney-castle/tower-base, kenney-castle/tower-hexagon-base, kenney-castle/tower-hexagon-mid, kenney-castle/tower-hexagon-roof-secondary, kenney-castle/tower-hexagon-roof, kenney-castle/tower-hexagon-top-wood, kenney-castle/tower-hexagon-top, kenney-castle/tower-slant-roof, kenney-castle/tower-square-arch, kenney-castle/tower-square-base-border, kenney-castle/tower-square-base-color, kenney-castle/tower-square-base, kenney-castle/tower-square-mid-color, kenney-castle/tower-square-mid-door, kenney-castle/tower-square-mid-open-simple, kenney-castle/tower-square-mid-open, kenney-castle/tower-square-mid-windows, kenney-castle/tower-square-mid, kenney-castle/tower-square-roof, kenney-castle/tower-square-top-color, kenney-castle/tower-square-top-roof-high-windows, kenney-castle/tower-square-top-roof-high, kenney-castle/tower-square-top-roof-rounded, kenney-castle/tower-square-top-roof, kenney-castle/tower-square-top, kenney-castle/tower-square, kenney-castle/tower-top, kenney-castle/tree-large, kenney-castle/tree-log, kenney-castle/tree-small, kenney-castle/tree-trunk, kenney-castle/wall-corner-half-