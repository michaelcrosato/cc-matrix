'')}</div>${footer()}`);\n6-\n7:  }else if(app.screen==='island'){\n8-    const player=profile(), day=Math.min(player.day,7), activities=activityForDay(day);\n9-\n10:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge sun\">✦ ${player.drips} DRIPS</span></div>${heading(`DAY ${day} / 7 · ${DAY_NAMES[day-1]}`,'Good to see you. ',`Ounce says: “${day===7?'Today, we stand together. And I owe you an explanation.':'The island is ready when you are.'}”`)}<div class=\"stats\"><span class=\"badge\">${escape(player.name)}</span> <span class=\"badge\">${player.stars} STARS</span> <span class=\"badge\">WOBBLE AGE ${player.history.length?wobbleAge(player):'—'}</span></div><div class=\"stack\"><button class=\"list-item\" data-action=\"weigh\"><span class=\"icon\">◉</span><span><span class=\"name\">Daily weigh-in</span><span class=\"sub\">THREE LITTLE BALANCE CHECKS</span></span><span class=\"arrow\">→</span></button>${day===7?`<button class=\"list-item\" data-action=\"finale\"><span class=\"icon\">✦</span><span><span class=\"name\">The Long Stand</span><span class=\"sub\">YOUR WEEK FINALE</span></span><span class=\"arrow\">→</span></button>`:''}</div><div class=\"eyebrow\" style=\"margin-top:20px\">PICK A PRACTICE · ${activities.length} OPEN</div><div class=\"scroll-list stack\">${activities.map(activity=>`<button class=\"list-item\" data-action=\"intro\" data-id=\"${activity.id}\"><span class=\"icon\">${iconFor(activity.family)}</span><span><span class=\"name\">${escape(activity.name)}</span><span class=\"sub\">${escape(activity.place.toUpperCase())} · ${activity.duration} SEC ${player.played[activity.id]?`· ${'★'.repeat(player.played[activity.id])}`:''}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div><div class=\"menu-row\" style=\"margin-top:12px\">${button('Day report','day-report','','small')}${button('Settings','settings','','small ghost')}</div>${footer()}`,'island-screen');\n11-\n12-  }else if(app.screen==='intro'){\n13-    const activity=app.activity;\n14-\n15:    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',escape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to breathe;\n16: use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','start','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n17-\n18-  }else if(app.screen==='game'){\n--\n22-\n23-  }else if(app.screen==='pause'){\n24:    content=panel(`<div class=\"topline\"><span class=\"badge\">TAKE YOUR TIME</span></div>${heading('PAUSED','A little breather.','Your island will be right here.')}<div class=\"menu\">${button('Resume','resume','','primary')}${button('Settings','settings','','ghost')}${button('Dev tools','dev','','ghost')}${button('Leave practice','leave','','ghost')}</div>${footer()}`);\n25-\n26-  }else if(app.screen==='results'){\n--\n28-\n29-    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND IS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;\n30:color:#8ca397\"> / 100</small></div><div class=\"stars\">${'★'.repeat(result.stars)}${'☆'.repeat(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS OF YOU TIME</span></div><div class=\"menu\">${button(app.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the island','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</div>${footer()}`);\n31-\n32:  }else if(app.screen==='weigh-result'){\n33:    content=panel(`<div class=\"topline\"><span class=\"badge\">DAILY CHECK-IN</span></div>${heading('A NUMBER, NOT A VERDICT','Your wobble age','Ounce has reviewed your three balance checks with tremendous confidence.')}<div class=\"score-hero\">${wobbleAge(profile())}</div><p class=\"description\">This is just a playful score, not a measure of health. Keep moving at your own pace.</p><div class=\"menu\">${button('Back to the island','island','','primary')}</div>${footer()}`);\n34-\n35:  }else if(app.screen==='day-report'){\n36-    const player=profile();\n37-\n38:    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have collected ${player.drips} drips and ${player.stars} stars. You showed up;\n39: the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S NOTE</strong><p>${player.day===6?'Tomorrow is the Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a perfectly planned nap. Usually.'}</p></div><div class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n40-\n41:  }else if(app.screen==='reveal'){\n42:    content=panel(`${brand}${heading('THE LONG STAND','Ounce comes clean.','“I added seven years to everyone’s wobble age. I thought you would come back if the number worried you. That was wrong.”')}<p class=\"description\" style=\"margin-top:16px\">The island agrees: a number should never tell you your worth. Your wobble age is now honest, and the island remains open.</p><div class=\"menu\">${button('A fresh start','island','','primary')}</div>`);\n43-\n44-  }else if(app.screen==='family'){\n45:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take turns through a three-event medley. Highest total wins;\n46: kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} ${number===1?'player':'players'}`,'family-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n47-\n48:  }else if(app.screen==='medley-board'){\n49:    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n50-\n51-    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the spotlight.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER ${entry.index+1}</span><span class=\"sub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n--\n56-    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" min=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Math.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':''}>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n57-\n58:    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER TOOLS':'YOUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\"stack\">${ranges}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\n59-\n60-  }else if(app.screen==='about'){\n61-    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n62-\n63:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful tribute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: ${value}`))}${section('Testing Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt Feedback',about.promptFeedback)}</div>${footer()}`);\n64-\n65-  }else if(app.screen==='hub-card'){\n66:    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div class=\"menu\">${button('Ready','hub-ready','','primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n67-\n68-  }\n--\n98-return;\n99-}\n100:  if(app.weigh){app.weigh.push(app.result.score/100);\n101:if(app.weigh.length<3){startWeigh();\n102-return;\n103:}profile().history.push(...app.weigh);\n104-profile().history=profile().history.slice(-3);\n105:app.weigh=null;\n106-save();\n107:go('weigh-result');\n108-return;\n109-}\n110:  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;\n111-go('results');\n112-return;\n--\n116-player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));\n117-player.played[app.activity.id]=Math.max(app.result.stars,player.played[app.activity.id]||0);\n118:if(app.activity.id==='finale'){player.revealed=true;\n119-save();\n120:go('reveal');\n121-return;\n122-}save();\n--\n126-\n127-}\n128:function startWeigh(){const index=app.weigh.length;\n129-const names=['Still water','A gentle shift','Chase the breeze'];\n130-begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});\n131-}\n132-function startMedley(){const sequence=['tree','hoop','step'];\n133:const id=sequence[app.medley.event];\n134:begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});\n135-}\n    } else if(family==='header'){\n      const beat=Math.floor((t-1.2)/2.4);\n      if(beat>=0&&beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;const target=beat%2===0?-1:1;if(Math.sign(x)===target)this.hits++;}\n      quality=this.hits/Math.max(1,this.eventCount);\n    }\n    this.points+=quality*dt;this.samples+=dt;\n    if(this.elapsed>=this.duration)this.finished=true;\n  }\n  result(){const score=Math.round(100*this.points/Math.max(.001,this.samples));const thresholds=this.activity.family==='reps'?[55,75,90]:[45,70,90];const stars=thresholds.filter(value=>score>=value).length;return {score,stars,drips:2+stars*3+Math.floor(this.duration/30),seconds:this.duration};}\n}\n","exit_code":0,"status":"completed"}}
