{"type":"item.completed","item":{"id":"item_356","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; sed -n '25,105p' \\\"\"'$DEV/src/main.js\" | fold -w 180; sed -n '\"'420,530p' \\\"\"'$DEV/vendor/hub/harness.html\"; sed -n '\"'570,607p' PLAN.md; sed -n '1,110p' \\\"\"'$DEV/src/core/session.js\" | fold -w 180'","aggregated_output":"\nfunction render(){\n  document.body.classList.toggle('high-contrast',app.settings.contrast);\n  document.body.classList.toggle('reduce-motion',app.settings.motion);\n  let content='';\n  if(app.screen==='title'){\n    content=panel(`${brand}<h1 class=\"title\">${escape(TITLE.split(' ').slice(0,2).join(' '))}<br><span>${escape(TITLE.split(' ').slice(2).join(' '))}.</span></h1><p class=\"lede\">A \nweek of movement, a talking scale, and absolutely no pressure to be graceful.</p><div class=\"title-tag\">YOUR ISLAND IS READY</div>${notice()?`<p class=\"description\" style=\"margin-t\nop:18px\"><strong>Controller or keyboard required</strong></p><div class=\"menu\">${button('Settings','settings','','ghost')}</div>`:`<div class=\"menu\">${button('Begin your week','slo\nts','','primary')}<div class=\"menu-row\">${button('Drop-in','dropin','','ghost')}${button('Family Hour','family','','ghost')}</div><div class=\"menu-row\">${button('Settings','setting\ns','','ghost')}${button('About','about','','ghost')}</div></div>${footer()}`}`,'title-screen')+`<div class=\"hero-note\">WELCOME TO LITTLE ISLAND<strong>Take it one wobble at a time.\n</strong>EST. WHENEVER YOU ARE READY</div>`;\n  }else if(app.screen==='slots'){\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">YOUR WEEK</span></div>${heading('A PLACE TO BEGIN','Who is stepping on?','Choose a profile. Your island \nremembers your progress on this device.')}<div class=\"stack\">${app.profiles.map((item,index)=>`<button class=\"list-item\" data-action=\"slot\" data-index=\"${index}\"><span class=\"icon\"\n>${index+1}</span><span><span class=\"name\">${item?escape(item.name):'Start a new week'}</span><span class=\"sub\">${item?`DAY ${item.day} · ${item.drips} DRIPS`:'EMPTY PROFILE'}</spa\nn></span><span class=\"arrow\">→</span></button>`).join('')}</div>${footer()}`);\n  }else if(app.screen==='island'){\n    const player=profile(), day=Math.min(player.day,7), activities=activityForDay(day);\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge sun\">✦ ${player.drips} DRIPS</span></div>${heading(`DAY ${day} / 7 · ${DAY_NAMES[day-1]}`,'Good to see yo\nu. ',`Ounce says: “${day===7?'Today, we stand together. And I owe you an explanation.':'The island is ready when you are.'}”`)}<div class=\"stats\"><span class=\"badge\">${escape(playe\nr.name)}</span> <span class=\"badge\">${player.stars} STARS</span> <span class=\"badge\">WOBBLE AGE ${player.history.length?wobbleAge(player):'—'}</span></div><div class=\"stack\"><butto\nn class=\"list-item\" data-action=\"weigh\"><span class=\"icon\">◉</span><span><span class=\"name\">Daily weigh-in</span><span class=\"sub\">THREE LITTLE BALANCE CHECKS</span></span><span cl\nass=\"arrow\">→</span></button>${day===7?`<button class=\"list-item\" data-action=\"finale\"><span class=\"icon\">✦</span><span><span class=\"name\">The Long Stand</span><span class=\"sub\">YO\nUR WEEK FINALE</span></span><span class=\"arrow\">→</span></button>`:''}</div><div class=\"eyebrow\" style=\"margin-top:20px\">PICK A PRACTICE · ${activities.length} OPEN</div><div class\n=\"scroll-list stack\">${activities.map(activity=>`<button class=\"list-item\" data-action=\"intro\" data-id=\"${activity.id}\"><span class=\"icon\">${iconFor(activity.family)}</span><span><\nspan class=\"name\">${escape(activity.name)}</span><span class=\"sub\">${escape(activity.place.toUpperCase())} · ${activity.duration} SEC ${player.played[activity.id]?`· ${'★'.repeat(p\nlayer.played[activity.id])}`:''}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div><div class=\"menu-row\" style=\"margin-top:12px\">${button('Day report','day-report\n','','small')}${button('Settings','settings','','small ghost')}</div>${footer()}`,'island-screen');\n  }else if(app.screen==='intro'){\n    const activity=app.activity;\n    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',\nescape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to \nbreathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','star\nt','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n  }else if(app.screen==='game'){\n    const activity=app.session.activity;\n    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.\nhubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(a\npp.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class\n=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div c\nlass=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span clas\ns=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n  }else if(app.screen==='pause'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">TAKE YOUR TIME</span></div>${heading('PAUSED','A little breather.','Your island will be right here.')}<div class=\"menu\">\n${button('Resume','resume','','primary')}${button('Settings','settings','','ghost')}${button('Dev tools','dev','','ghost')}${button('Leave practice','leave','','ghost')}</div>${foo\nter()}`);\n  }else if(app.screen==='results'){\n    const result=app.result;\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND \nIS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;color:#8ca397\"> / 100</small></div><div class=\"stars\">${'★'.repeat(result.stars)}${'☆'.repea\nt(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS OF YOU TIME</span></div><div class=\"menu\">${button(a\npp.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the island','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</di\nv>${footer()}`);\n  }else if(app.screen==='weigh-result'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">DAILY CHECK-IN</span></div>${heading('A NUMBER, NOT A VERDICT','Your wobble age','Ounce has reviewed your three balance \nchecks with tremendous confidence.')}<div class=\"score-hero\">${wobbleAge(profile())}</div><p class=\"description\">This is just a playful score, not a measure of health. Keep moving \nat your own pace.</p><div class=\"menu\">${button('Back to the island','island','','primary')}</div>${footer()}`);\n  }else if(app.screen==='day-report'){\n    const player=profile();\n    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have collecte\nd ${player.drips} drips and ${player.stars} stars. You showed up; the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S NOTE</strong><p>${player.day===6?'Tomorrow is t\nhe Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a perfectly planned nap. Usually.'}</p></div><div\n class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n  }else if(app.screen==='reveal'){\n    content=panel(`${brand}${heading('THE LONG STAND','Ounce comes clean.','“I added seven years to everyone’s wobble age. I thought you would come back if the number worried you. \nThat was wrong.”')}<p class=\"description\" style=\"margin-top:16px\">The island agrees: a number should never tell you your worth. Your wobble age is now honest, and the island remain\ns open.</p><div class=\"menu\">${button('A fresh start','island','','primary')}</div>`);\n  }else if(app.screen==='family'){\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take tu\nrns through a three-event medley. Highest total wins; kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} ${number===1?'player':'players'}`,'famil\ny-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n  }else if(app.screen==='medley-board'){\n    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the spotlight\n.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER ${entry.index+1}</span><span class=\"\nsub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n  }else if(app.screen==='settings'||app.screen==='dev'){\n    const dev=app.screen==='dev';\n    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" \nmin=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Math.\nround(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label \nfor=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effec\nts}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':''}\n>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label><i\nnput id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\n\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER TOOLS':'YO\nUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\"stack\">${rang\nes}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\n  }else if(app.screen==='about'){\n    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful tri\nbute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: ${value}`))}${section('Testin\ng Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt Feedback',about.promptFeedback)}</div>${footer()}`);\n  }else if(app.screen==='hub-card'){\n    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div class\n=\"menu\">${button('Ready','hub-ready','','primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n  }\n  ui.innerHTML=content;\n  app.focus=0;\n  const first=ui.querySelector('button:not(:disabled)');if(first&&app.inputKind==='gamepad')first.classList.add('focused');\n}\n\nfunction go(screen){app.screen=screen;render();}\nfunction begin(activity,options={}){\n  app.activity=activity;app.session=new ActivitySession(activity,{hard:app.hard,tuning:app.tuning,...options});app.paused=false;go('game');\n}\nfunction finish(){\n  if(!app.session)return;\n  app.result=app.session.result();\n  if(app.attract){app.attractIndex++;startAttract();return;}\n  if(app.hubRound){advanceHub();return;}\n  if(app.weigh){app.weigh.push(app.result.score/100);if(app.weigh.length<3){startWeigh();return;}profile().history.push(...app.weigh);profile().history=profile().history.slice(-3);\napp.weigh=null;save();go('weigh-result');return;}\n  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;go('results');return;}\n  if(profile()){const player=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=\nMath.max(app.result.stars,player.played[app.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n  sound.effect('good');go('results');\n}\nfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the breeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:nam\nes[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});}\nfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.pla\nyer+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\nfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const activity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequenc\ne.length]);begin(activity,{duration:12});}\nfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\nfunction act(action,element){\n  sound.unlock();sound.effect('select');app.lastInput=performance.now();\n  if(app.attract){leaveAttract();return;}\n  if(action==='title'){app.session=null;app.medley=null;app.guest=null;go('title');}\n  else if(action==='slots')go('slots');\n  else if(action==='slot'){app.guest=null;app.slot=Number(element.dataset.index);if(!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('is\nland');}\n  else if(action==='dropin'){app.guest=makeProfile('GUEST');app.guest.day=7;app.guest.revealed=true;app.returnScreen='island';go('island');}\n  else if(action==='island'){app.medley=null;app.weigh=null;go('island');}\n  else if(action==='intro'){app.activity=ACTIVITIES.find(item=>item.id===element.dataset.id);app.returnScreen='island';app.hard=false;sound.effect('voice');go('intro');}\n  else if(action==='hard'){app.hard=!app.hard;render();}\n  else if(action==='start')begin(app.activity);\n  else if(action==='weigh'){app.weigh=[];startWeigh();}\n  else if(action==='finale'){app.activity={...ACTIVITIES[0],id:'finale',name:'The Long Stand',place:'Pavilion',duration:45,ring:.32,quip:'A LITTLE HONESTY GOES A LONG WAY.'};app.re\nturnScreen='island';go('intro');}\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n```html\n<meta charset=\"utf-8\">\n<script>/* session.js pasted unmodified: first script, right after charset */</script>\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Score the most across three events. Stay in the circle.\">\n<meta name=\"hub:session-howto\" content=\"Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J: step.\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:webgpu\" content=\"required\">\n```\n\nBoot order ✔:\n\n```js\nlet info = null;\nif (window.AIHub?.active) info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\nconst engine = await Engine.start(firstScene, withUrlOptions({ /* ... */ seed: info ? info.seed : savedOrDefaultSeed }));\nif (info) AIHub.ready();                 // no key press, as soon as the card can show\n```\n\nIf `connect()` answers null, carry on as the normal game. Without WebGPU, `Engine.start` rejects and the engine prints \"Failed to start: WebGPU unavailable: ...\" on the page ✔. Catch the rejection, or it also surfaces as a page error ✔, and call `AIHub.fail(message)` in a session.\n\n**In a session:**\n- **The card (`card: true`)** is the game's own: the players' avatars lining up on mats in seat colours (`#e8443a #3b82f6 #22c55e #f5b700`), {TITLE}, ready ticks, how to win, the controls for the last device, the time left from the `card` event. Enter or Cross → `AIHub.answer('ready')`; Triangle or M → `AIHub.answer('more')`. Use a **direct `keydown` listener for Enter** ✔ here. No menus. Cosmetic randomness only from `AIHub.rng('card')`.\n- **Start:** on `start` show a countdown from `AIHub.time()`; play at `time() >= 0`. Event windows are read from `AIHub.time()`, so all copies stay in step.\n- **Same world:** gusts, pose picks and object waves come from `AIHub.rng(label)` or the seeded `ctx.random`.\n- **Ghosts:** a `setInterval` at 100 ms (not tied to rendering) sends `AIHub.send({ a: eventIndex, x, y, c: clipIndex, t: clipTime, s: score }, { reliable: false })` and calls `AIHub.progress({ score, label })`. Start as soon as `start` arrives, even with score 0: the harness needs both within seconds. Receivers lerp the other mats; they never simulate them, and they hide a ghost whose `a` differs from theirs.\n- **`leave`:** that avatar waves and walks off. The round goes on, host included.\n- **End:** `AIHub.result({ score, stats, awards })` once, at the end of the Medley or at once on `time-up`. On `end`: stop input, stop sound, send nothing.\n- **Never:** no title, attract, dev mode, saves, quit or restart; no chat or custom names; no `alert`, `window.open` or navigation. Names come from `info.players` and are drawn with `say()`.\n\n---\n\n## 13. Art direction\n\n**Base: the engine's native look**, default pixel pipeline, toon materials, 16-colour palette (`look` left unset). The scene reads clean and bright: white, mist, sky and cyan, with lime and sand for growth and warmth, orange and red as accents. Start with `quality: 'high'` (`'medium'` in sessions, where several copies may share a machine in testing).\n\nimport { Dot, DEFAULT_TUNABLES } from './dot.js';\n\nconst clamp=(value,low,high)=>Math.max(low,Math.min(high,value));\nexport function makeProfile(name='PLAYER') {return {name,day:1,drips:0,stars:0,history:[],played:{},goal:'FIND YOUR BALANCE',revealed:false,completedDays:[]};}\nexport function wobbleAge(profile) {\n  const scores=profile.history.slice(-3);\n  const average=scores.length?scores.reduce((sum,value)=>sum+value,0)/scores.length:.5;\n  return clamp(Math.round(20+60*(1-average)-Math.min(20,profile.stars*.5)),18,95)+(profile.revealed?0:7);\n}\nexport class ActivitySession {\n  constructor(activity,options={}) {\n    this.activity=activity; this.hard=!!options.hard; this.duration=options.duration??activity.duration;\n    this.dot=new Dot(options.random); this.elapsed=0; this.points=0; this.samples=0; this.breathSync=.5;\n    this.rep=.0; this.hoopLift=.65; this.lastAngle=null; this.angleSpeed=0; this.goodSteps=0; this.lastStep=-2; this.hits=0;\n    this.tuning={...DEFAULT_TUNABLES,...options.tuning}; this.finished=false; this.distance=0; this.lastDirection=0;\n    this.eventCount=0; this.lastBeat=-1; this.notes=[];\n  }\n  update(dt,input={}) {\n    if(this.finished)return;\n    dt=clamp(dt*(this.tuning.timeScale??1),0,.1); this.elapsed+=dt;\n    const {x=0,y=0,breath=false,left=false,right=false}=input;\n    const family=this.activity.family, t=this.elapsed;\n    const breathIn=this.activity.breath?Math.sin(t*Math.PI*2/this.activity.breath)>0:false;\n    if(this.activity.breath) this.breathSync+=(Number(breath===breathIn)-this.breathSync)*Math.min(1,dt*2);\n    const modifiers={noise:this.activity.breath?1.25-.55*this.breathSync:1};\n    if(this.activity.id==='heron')modifiers.bx=.12*Math.sin(t*.7);\n    if(this.activity.id==='tax')modifiers.bx=.18*Math.sin(t*.9);\n    if(this.activity.id==='chair')modifiers.noise*=1+.5*t/this.duration;\n    if(this.activity.id==='plank')modifiers.inst=1.2;\n    this.dot.step(dt,x,y,this.tuning,modifiers);\n    const distance=Math.hypot(this.dot.x,this.dot.y);\n    let quality=0;\n    if(family==='still'||family==='tray'||family==='slack'||family==='jump'){\n      const ring=(this.activity.ring??(family==='slack'?.32:.48))*(this.hard?.8:1);\n      quality=distance<ring?1:0;\n      if(this.activity.breath)quality=.8*quality+.2*this.breathSync;\n      if(family==='slack'){\n        if((left||right)&&t-this.lastStep>.14){this.lastStep=t;this.goodSteps++;this.distance+=distance<.75?1:.15;}\n        quality*=.45+.55*clamp(this.goodSteps/(t*1.5),0,1);\n      }\n      if(family==='jump'&&breath&&t-this.lastStep>2){this.lastStep=t;this.goodSteps++;this.distance+=distance<.6?1:0;}\n      if(family==='jump') quality*=.5+.5*clamp(this.goodSteps/Math.max(1,t/5),0,1);\n    } else if(family==='reps'){\n      const phase=(t/3.2)%1;\n      const target=phase<.4?phase/.4:phase<.55?1:phase<.9?1-(phase-.55)/.35:0;\n      const requested=this.activity.id==='lunges'?Math.abs(x):this.activity.id==='mortgage'?Math.max(0,y):Math.max(0,-y);\n      this.rep+=(requested-this.rep)*Math.min(1,dt/((this.activity.id==='mortgage'?.15:.10)));\n      quality=clamp(1-1.6*Math.abs(this.rep-target),0,1);\n    } else if(family==='hoop'){\n      const magnitude=Math.hypot(x,y);\n      if(magnitude>.5){const angle=Math.atan2(y,x);if(this.lastAngle!==null){let delta=angle-this.lastAngle;while(delta>Math.PI)delta-=Math.PI*2;while(delta< -Math.PI)delta+=Math.P\nI*2;this.angleSpeed+=(Math.abs(delta)/Math.max(dt,.001)-this.angleSpeed)*Math.min(1,dt/.25);}this.lastAngle=angle;}else{this.angleSpeed*=Math.max(0,1-dt*3);this.lastAngle=null;}\n      const inBand=this.angleSpeed>4.5&&this.angleSpeed<18;\n      this.hoopLift=clamp(this.hoopLift+(inBand?.35:-.15)*dt,0,1);quality=this.hoopLift;\n    } else if(family==='step'||family==='jog'){\n      const beat=Math.floor(t/.7);\n      if(beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;}\n      if((left||right)&&t-this.lastStep>.12){const side=left?-1:1;const phase=Math.abs((t/.7)-Math.round(t/.7));if(family==='jog'?side!==this.lastDirection:phase<.23){this.goodStep\ns++;}this.lastDirection=side;this.lastStep=t;}\n      quality=clamp(this.goodSteps/Math.max(1,this.eventCount-1),0,1);\n    } else if(family==='header'){\n      const beat=Math.floor((t-1.2)/2.4);\n      if(beat>=0&&beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;const target=beat%2===0?-1:1;if(Math.sign(x)===target)this.hits++;}\n      quality=this.hits/Math.max(1,this.eventCount);\n    }\n    this.points+=quality*dt;this.samples+=dt;\n    if(this.elapsed>=this.duration)this.finished=true;\n  }\n  result(){const score=Math.round(100*this.points/Math.max(.001,this.samples));const thresholds=this.activity.family==='reps'?[55,75,90]:[45,70,90];const stars=thresholds.filter(va\nlue=>score>=value).length;return {score,stars,drips:2+stars*3+Math.floor(this.duration/30),seconds:this.duration};}\n}\n","exit_code":0,"status":"completed"}}
