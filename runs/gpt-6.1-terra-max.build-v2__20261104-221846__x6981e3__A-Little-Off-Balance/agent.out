{"type":"item.completed","item":{"id":"item_666","type":"command_execution","command":"/bin/bash -lc \"pwd; ls -la; DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -n 'aboutPage|screen===.about.|action===.about.|function gamepad|addEventListener\\\\(.keydown|const app=|function go\\\\(|function act\\\\(|function panel|function footer|function heading|\\\\bescape\\\\b' \\\"\"'$DEV/src/main.js\"; sed -n '\"'1,130p' \\\"\"'$DEV/tests/browser.py\"; sed -n '\"'130,340p' \\\"\"'$DEV/tests/browser.py\"; sed -n '\"'1,70p' \\\"\"'$DEV/CREDITS.md\"'","aggregated_output":"/home/micha/dev/cc-matrix/runs/gpt-6.1-terra-max.build-v2__20261104-221846__x6981e3/work\ntotal 5228\ndrwxr-xr-x  3 micha micha    4096 Nov  4 23:25 .\ndrwxr-xr-x  4 micha micha    4096 Nov  4 22:18 ..\ndrwxr-xr-x 11 micha micha    4096 Nov  4 22:52 A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846\n-rw-r--r--  1 micha micha 5238436 Nov  5 01:33 A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html\n-rw-r--r--  1 micha micha   75100 Nov  4 22:18 PLAN.md\n-rw-r--r--  1 micha micha    2541 Nov  5 01:40 PROGRESS.md\n-rw-r--r--  1 micha micha   12573 Nov  4 22:18 TASK.md\n-rw-r--r--  1 micha micha    2415 Nov  5 01:33 exit-interview.json\n12:const escape=value=>String(value).replace(/[&<>\"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[character]));\n13:const app={screen:'title',session:null,settings:{music:.1,effects:.7,glyphs:'ps',contrast:false,motion:false,...stored('alob-settings',{})},profiles:stored('alob-profiles',[null,null,null]),slot:0,activity:null,result:null,tuning:{...DEFAULT_TUNABLES},input:{x:0,y:0,breath:false,left:false,right:false},keys:new Set(),lastInput:performance.now(),inputKind:'keyboard',focus:0,paused:false,attract:false,attractIndex:0,medley:null,weigh:null,hubRound:false,hubEnded:false,hubScores:{},hubClock:0,gamepadButtons:[],driver:null};\n32:    content=panel(`${brand}<h1 class=\"title\">${escape(TITLE.split(' ').slice(0,2).join(' '))}<br><span>${escape(TITLE.split(' ').slice(2).join(' '))}.</span></h1><p class=\"lede\">A week of movement, a talking scale, and absolutely no pressure to be graceful.</p><div class=\"title-tag\">YOUR ISLAND IS READY</div>${notice()?`<p class=\"description\" style=\"margin-top:18px\"><strong>Controller or keyboard required</strong></p><div class=\"menu\">${button('Settings','settings','','ghost')}</div>`:`<div class=\"menu\">${button('Begin your week','slots','','primary')}<div class=\"menu-row\">${button('Drop-in','dropin','','ghost')}${button('Family Hour','family','','ghost')}</div><div class=\"menu-row\">${button('Settings','settings','','ghost')}${button('About','about','','ghost')}</div></div>${footer()}`}`,'title-screen')+`<div class=\"hero-note\">WELCOME TO LITTLE ISLAND<strong>Take it one wobble at a time.</strong>EST. WHENEVER YOU ARE READY</div>`;\n34:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">YOUR WEEK</span></div>${heading('A PLACE TO BEGIN','Who is stepping on?','Choose a profile. Your island remembers your progress on this device.')}<div class=\"stack\">${app.profiles.map((item,index)=>`<button class=\"list-item\" data-action=\"slot\" data-index=\"${index}\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">${item?escape(item.name):'Start a new week'}</span><span class=\"sub\">${item?`DAY ${item.day} · ${item.drips} DRIPS`:'EMPTY PROFILE'}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div>${footer()}`);\n37:    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge sun\">✦ ${player.drips} DRIPS</span></div>${heading(`DAY ${day} / 7 · ${DAY_NAMES[day-1]}`,'Good to see you. ',`Ounce says: “${day===7?'Today, we stand together. And I owe you an explanation.':'The island is ready when you are.'}”`)}<div class=\"stats\"><span class=\"badge\">${escape(player.name)}</span> <span class=\"badge\">${player.stars} STARS</span> <span class=\"badge\">WOBBLE AGE ${player.history.length?wobbleAge(player):'—'}</span></div><div class=\"stack\"><button class=\"list-item\" data-action=\"weigh\"><span class=\"icon\">◉</span><span><span class=\"name\">Daily weigh-in</span><span class=\"sub\">THREE LITTLE BALANCE CHECKS</span></span><span class=\"arrow\">→</span></button>${day===7?`<button class=\"list-item\" data-action=\"finale\"><span class=\"icon\">✦</span><span><span class=\"name\">The Long Stand</span><span class=\"sub\">YOUR WEEK FINALE</span></span><span class=\"arrow\">→</span></button>`:''}</div><div class=\"eyebrow\" style=\"margin-top:20px\">PICK A PRACTICE · ${activities.length} OPEN</div><div class=\"scroll-list stack\">${activities.map(activity=>`<button class=\"list-item\" data-action=\"intro\" data-id=\"${activity.id}\"><span class=\"icon\">${iconFor(activity.family)}</span><span><span class=\"name\">${escape(activity.name)}</span><span class=\"sub\">${escape(activity.place.toUpperCase())} · ${activity.duration} SEC ${player.played[activity.id]?`· ${'★'.repeat(player.played[activity.id])}`:''}</span></span><span class=\"arrow\">→</span></button>`).join('')}</div><div class=\"menu-row\" style=\"margin-top:12px\">${button('Day report','day-report','','small')}${button('Settings','settings','','small ghost')}</div>${footer()}`,'island-screen');\n40:    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',escape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to breathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','start','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n44:    content=`<section class=\"screen family-game\"><div class=\"family-game-shell\"><div class=\"family-game-top\"><div><div class=\"eyebrow\">FAMILY HOUR · EVENT ${medley.event+1} / 3</div><h1>${medley.phase==='break'?'Time for a breather':escape(activity.name)}</h1><p>${medley.phase==='break'?'Next event starts shortly.':escape(activity.instruction)}</p></div><div class=\"family-clock\"><strong id=\"family-time\">${medley.phase==='break'?Math.ceil(medley.breakTime):EVENT_SECONDS}</strong><small>SECONDS</small></div></div>${medley.phase==='break'?`<div class=\"family-break\"><strong>ROUND COMPLETE</strong>${ranking.map((entry,index)=>`<div><span>${index+1}. ${familyName(medley.members[entry.index],entry.index)}</span><b>${entry.score} PTS</b></div>`).join('')}</div>`:`<div class=\"family-grid\">${medley.members.map((member,index)=>`<div class=\"family-lane\"><div class=\"family-lane-title\"><strong>${familyName(member,index)}</strong><span>${member.kind==='bot'?'BOT':member.kind==='keyboard'?'KEYBOARD':`PAD ${member.index+1}`}</span></div><div class=\"family-lane-body\"><div class=\"dial family-dial\"><span class=\"dot\" id=\"family-dot-${index}\"></span></div><div><strong id=\"family-score-${index}\">0</strong><small>POINTS</small></div></div><p id=\"family-cue-${index}\">${escape(activity.instruction)}</p></div>`).join('')}</div>`}</div><div class=\"family-game-tip\">F / J OR L1 / R1: STEP · ESC / OPTIONS: PAUSE</div></section>`;\n47:    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><strong id=\"live-cue\"></strong><br><span class=\"key\">WASD / L</span> LEAN <span class=\"key\">SPACE / R2</span> BREATHE<br><span class=\"key\">F / J · L1 / R1</span> STEP · ESC PAUSE</div></div></div></section>`;\n52:    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND IS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;color:#8ca397\"> / 100</small></div><div class=\"stars\">${'★'.repeat(result.stars)}${'☆'.repeat(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS OF YOU TIME</span></div><div class=\"menu\">${button(app.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the island','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</div>${footer()}`);\n67:    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" min=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Math.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':''}>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label><input id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n69:  }else if(app.screen==='about'){\n70:    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n82:function go(screen){app.screen=screen;render();}\n114:function act(action,element){\n140:  else if(action==='about')go('about');\n149:window.addEventListener('keydown',event=>{if(app.screen!=='family'||event.repeat)return;const key=event.key.toLowerCase();if(!['enter',' ','b','escape'].includes(key))return;event.preventDefault();event.stopImmediatePropagation();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(key==='enter')familyJoin('keyboard');else if(key==='b')familyJoin('bot');else if(key===' '&&app.medley.members.length)startMedley();else if(key==='escape')act('title');},true);\n150:window.addEventListener('keydown',event=>{if(app.hubClosed)return;const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;if(app.screen==='hub-card'&&(key==='enter'||key==='m')){event.preventDefault();globalThis.AIHub?.answer(key==='m'?'more':'ready');return;}app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\n157:function gamepad(){if(app.medley&&['family','game'].includes(app.screen))return null;const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen==='hub-card'&&just(3))globalThis.AIHub?.answer('more');if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef complete_week(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        start_profile(page)\n        click(page, 'weigh')\n        for _ in range(3):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n        screen(page, 'weigh-result')\n        assert len(state(page)['profiles'][0]['history']) == 3\n        click(page, 'island')\n        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\n            assert state(page)['day'] == day\n        click(page, 'finale')\n        click(page, 'start')\n        finish(page)\n        screen(page, 'reveal')\n        assert state(page)['profiles'][0]['revealed'] is True\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n        browser.close()\n\n\ndef family(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        click(page, 'family')\n        click(page, 'family-join')\n        click(page, 'family-bot')\n        assert state(page)['family']['players'] == 2\n        click(page, 'family-start')\n        for event in range(3):\n            screen(page, 'game')\n            assert state(page)['family']['event'] == event\n            assert page.locator('.family-lane').count() == 2\n            page.wait_for_timeout(25)\n            finish(page)\n            if event < 2:\n                assert state(page)['family']['phase'] == 'break'\n                page.evaluate('window.__GAME__.finishBreak()')\n        screen(page, 'medley-board')\n        assert page.get_by_text('PLAYER 1', exact=True).count() == 1\n        assert page.get_by_text('BOT 2', exact=True).count() == 1\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\ndef family_gamepads(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.evaluate('''() => {\n            window.fakePads = Array.from({length: 4}, (_, index) => ({\n                index, axes: [0, 0], connected: true,\n                buttons: Array.from({length: 16}, () => ({pressed: false, value: 0}))\n            }));\n            Object.defineProperty(navigator, 'getGamepads', {configurable: true, value: () => window.fakePads});\n        }''')\n        click(page, 'family')\n        for index in range(4):\n            page.evaluate('(index) => window.fakePads[index].buttons[0].pressed = true', index)\n            page.wait_for_timeout(80)\n            page.evaluate('(index) => window.fakePads[index].buttons[0].pressed = false', index)\n            page.wait_for_timeout(80)\n        assert state(page)['family']['players'] == 4\n        click(page, 'family-start')\n        page.evaluate('window.fakePads[0].axes[0] = 1; window.fakePads[1].axes[0] = -1')\n        page.wait_for_timeout(350)\n        dots = state(page)['family']['dots']\n        assert len(dots) == 4 and abs(dots[0]['x'] - dots[1]['x']) > .02, dots\n        assert page.locator('.family-lane').count() == 4\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\ndef mobile(playwright, url):\n    browser = playwright.webkit.launch(headless=True)\n    context = browser.new_context(**playwright.devices['iPhone 17 Pro'])\n    page = context.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        assert page.get_by_text('Controller or keyboard required').is_visible()\n        assert page.locator('[data-action=\"slots\"]').count() == 0\n        click(page, 'settings')\n        assert page.locator('#music').input_value() == '0.1'\n    finally:\n        context.close()\n        browser.close()\n\n\ndef attract(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_function('window.__GAME__.state().attract', timeout=13000)\n        page.keyboard.press('Enter')\n        screen(page, 'title')\n    finally:\n        browser.close()\n\n\ndef webgpu(playwright, url):\n    browser = playwright.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-angle=swiftshader', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_selector('#world canvas', timeout=12000)\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthreading.Thread(target=server.serve_forever, daemon=True).start()\nurl = f'http://127.0.0.1:{server.server_port}/' + urllib.parse.quote(FILENAME)\ntry:\n    with sync_playwright() as playwright:\n        for name in ('chromium', 'firefox', 'webkit'):\n            check(name + ' profile, activity, persistence', lambda name=name: smoke(getattr(playwright, name), url))\n        check('seven-day playthrough and all activities', lambda: complete_week(playwright.chromium, url))\n        check('family medley', lambda: family(playwright.chromium, url))\n        check('four simultaneous gamepad lanes', lambda: family_gamepads(playwright.chromium, url))\n        check('touch-only notice', lambda: mobile(playwright, url))\n        check('idle attract and wake', lambda: attract(playwright.chromium, url))\n        check('WebGPU island', lambda: webgpu(playwright, url))\nfinally:\n    server.shutdown()\nprint(json.dumps({'passed': passed, 'failures': failures}))\n# Credits (Pixel Engine 0.46.0)\n\nWhat this kit carries and where it came from, generated by `npm run bundle` from each built-in model's and texture's `source` (the data the engine repository's `npm run model -- credits` reads) and from the bundled packages' own licence files. Ship this file with a game built on the kit.\n\n## Models and textures\n\n- **The engine's own work**, made in its repository: 151 of the 151 library models (`MODEL_LIBRARY`), 126 of the 126 textures (`TEXTURE_LIBRARY`) and the built-in models (`assets/coin.glb`, `assets/hero.glb`, `assets/tree.glb`). Nothing to credit.\n- **kenney-castle** by Kenney, Creative Commons Zero 1.0 (public domain dedication) (CC0-1.0, credit optional): https://kenney.nl/media/pages/assets/castle-kit/a395102d20-1711543616/kenney_castle-kit.zip. Models: kenney-castle/bridge-draw, kenney-castle/bridge-straight-pillar, kenney-castle/bridge-straight, kenney-castle/door, kenney-castle/flag-banner-long, kenney-castle/flag-banner-short, kenney-castle/flag-pennant, kenney-castle/flag-wide, kenney-castle/flag, kenney-castle/gate, kenney-castle/ground-hills, kenney-castle/ground, kenney-castle/metal-gate, kenney-castle/rocks-large, kenney-castle/rocks-small, kenney-castle/siege-ballista-demolished, kenney-castle/siege-ballista, kenney-castle/siege-catapult-demolished, kenney-castle/siege-catapult, kenney-castle/siege-ram-demolished, kenney-castle/siege-ram, kenney-castle/siege-tower-demolished, kenney-castle/siege-tower, kenney-castle/siege-trebuchet-demolished, kenney-castle/siege-trebuchet, kenney-castle/stairs-stone-square, kenney-castle/stairs-stone, kenney-castle/tower-base, kenney-castle/tower-hexagon-base, kenney-castle/tower-hexagon-mid, kenney-castle/tower-hexagon-roof-secondary, kenney-castle/tower-hexagon-roof, kenney-castle/tower-hexagon-top-wood, kenney-castle/tower-hexagon-top, kenney-castle/tower-slant-roof, kenney-castle/tower-square-arch, kenney-castle/tower-square-base-border, kenney-castle/tower-square-base-color, kenney-castle/tower-square-base, kenney-castle/tower-square-mid-color, kenney-castle/tower-square-mid-door, kenney-castle/tower-square-mid-open-simple, kenney-castle/tower-square-mid-open, kenney-castle/tower-square-mid-windows, kenney-castle/tower-square-mid, kenney-castle/tower-square-roof, kenney-castle/tower-square-top-color, kenney-castle/tower-square-top-roof-high-windows, kenney-castle/tower-square-top-roof-high, kenney-castle/tower-square-top-roof-rounded, kenney-castle/tower-square-top-roof, kenney-castle/tower-square-top, kenney-castle/tower-square, kenney-castle/tower-top, kenney-castle/tree-large, kenney-castle/tree-log, kenney-castle/tree-small, kenney-castle/tree-trunk, kenney-castle/wall-corner-half-tower, kenney-castle/wall-corner-half, kenney-castle/wall-corner-slant, kenney-castle/wall-corner, kenney-castle/wall-doorway, kenney-castle/wall-half-modular, kenney-castle/wall-half, kenney-castle/wall-narrow-corner, kenney-castle/wall-narrow-gate, kenney-castle/wall-narrow-stairs-rail, kenney-castle/wall-narrow-stairs, kenney-castle/wall-na