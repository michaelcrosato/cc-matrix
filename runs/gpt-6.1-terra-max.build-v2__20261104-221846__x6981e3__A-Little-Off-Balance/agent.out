{"type":"item.completed","item":{"id":"item_206","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' tools/build.mjs; sed -n '1,40p' src/core/session.js; sed -n '72,145p' src/main.js; sed -n '1,100p' ../PLAN.md\"","aggregated_output":"import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';\nimport {execFileSync} from 'node:child_process';\n\nmkdirSync('.build',{recursive:true});\nexecFileSync('esbuild',['src/main.js','--bundle','--format=esm','--platform=browser','--target=esnext','--charset=utf8','--outfile=.build/game.js','--log-level=warning'],{stdio:'inherit'});\nconst safe=source=>source.replace(/<\\/script/gi,'<\\\\/script');\nconst css=readFileSync('src/ui/style.css','utf8');\nconst hub=safe(readFileSync('vendor/hub/session.js','utf8'));\nconst game=safe(readFileSync('.build/game.js','utf8'));\nconst html=`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#cbe9dc\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\"><meta name=\"hub:session-goal\" content=\"Score the most points across three delightfully wobbly events.\"><meta name=\"hub:session-howto\" content=\"Left stick or WASD: lean. R2 or Space: breathe. L1/R1 or F/J: step.\"><meta name=\"hub:session-minutes\" content=\"4\"><meta name=\"hub:webgpu\" content=\"required\">\n<title>A Little Off Balance</title><style>${css}</style></head>\n<body><div id=\"world\" aria-hidden=\"true\"><div class=\"fallback-island\"><i></i><b></b><em></em></div></div><div id=\"ui\"><main class=\"loading\">A little moment, please<span>● ● ●</span></main></div><script type=\"module\">${game}</script></body></html>`;\nwriteFileSync('../A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html',html);\nconsole.log(`Built standalone HTML (${(Buffer.byteLength(html)/1048576).toFixed(1)} MB).`);\nimport { Dot, DEFAULT_TUNABLES } from './dot.js';\n\nconst clamp=(value,low,high)=>Math.max(low,Math.min(high,value));\nexport function makeProfile(name='PLAYER') {return {name,day:1,drips:0,stars:0,history:[],played:{},goal:'FIND YOUR BALANCE',revealed:false,completedDays:[]};}\nexport function wobbleAge(profile) {\n  const scores=profile.history.slice(-3);\n  const average=scores.length?scores.reduce((sum,value)=>sum+value,0)/scores.length:.5;\n  return clamp(Math.round(20+60*(1-average)-Math.min(20,profile.stars*.5)),18,95)+(profile.revealed?0:7);\n}\nexport class ActivitySession {\n  constructor(activity,options={}) {\n    this.activity=activity; this.hard=!!options.hard; this.duration=options.duration??activity.duration;\n    this.dot=new Dot(options.random); this.elapsed=0; this.points=0; this.samples=0; this.breathSync=.5;\n    this.rep=.0; this.hoopLift=.65; this.lastAngle=null; this.angleSpeed=0; this.goodSteps=0; this.lastStep=-2; this.hits=0;\n    this.tuning={...DEFAULT_TUNABLES,...options.tuning}; this.finished=false; this.distance=0; this.lastDirection=0;\n    this.eventCount=0; this.lastBeat=-1; this.notes=[];\n  }\n  update(dt,input={}) {\n    if(this.finished)return;\n    dt=clamp(dt,0,.1); this.elapsed+=dt;\n    const {x=0,y=0,breath=false,left=false,right=false}=input;\n    const family=this.activity.family, t=this.elapsed;\n    const breathIn=this.activity.breath?Math.sin(t*Math.PI*2/this.activity.breath)>0:false;\n    if(this.activity.breath) this.breathSync+=(Number(breath===breathIn)-this.breathSync)*Math.min(1,dt*2);\n    const modifiers={noise:this.activity.breath?1.25-.55*this.breathSync:1};\n    if(this.activity.id==='heron')modifiers.bx=.12*Math.sin(t*.7);\n    if(this.activity.id==='tax')modifiers.bx=.18*Math.sin(t*.9);\n    if(this.activity.id==='chair')modifiers.noise*=1+.5*t/this.duration;\n    if(this.activity.id==='plank')modifiers.inst=1.2;\n    this.dot.step(dt,x,y,this.tuning,modifiers);\n    const distance=Math.hypot(this.dot.x,this.dot.y);\n    let quality=0;\n    if(family==='still'||family==='tray'||family==='slack'||family==='jump'){\n      const ring=(this.activity.ring??(family==='slack'?.32:.48))*(this.hard?.8:1);\n      quality=distance<ring?1:0;\n      if(this.activity.breath)quality=.8*quality+.2*this.breathSync;\n      if(family==='slack'){\n        if((left||right)&&t-this.lastStep>.14){this.lastStep=t;this.goodSteps++;this.distance+=distance<.75?1:.15;}\n        quality*=.45+.55*clamp(this.goodSteps/(t*1.5),0,1);\n      }\n}\n\nfunction go(screen){app.screen=screen;render();}\nfunction begin(activity,options={}){\n  app.activity=activity;app.session=new ActivitySession(activity,{hard:app.hard,tuning:app.tuning,...options});app.paused=false;go('game');\n}\nfunction finish(){\n  if(!app.session)return;\n  app.result=app.session.result();\n  if(app.attract){app.attractIndex++;startAttract();return;}\n  if(app.hubRound){advanceHub();return;}\n  if(app.weigh){app.weigh.push(app.result.score/100);if(app.weigh.length<3){startWeigh();return;}profile().history.push(...app.weigh);profile().history=profile().history.slice(-3);app.weigh=null;save();go('weigh-result');return;}\n  if(app.medley){app.medley.scores[app.medley.player]+=app.result.score;go('results');return;}\n  if(profile()){const player=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=Math.max(app.result.stars,player.played[app.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n  sound.effect('good');go('results');\n}\nfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the breeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});}\nfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\nfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const activity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequence.length]);begin(activity,{duration:12});}\nfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\nfunction act(action,element){\n  sound.unlock();sound.effect('select');app.lastInput=performance.now();\n  if(app.attract){leaveAttract();return;}\n  if(action==='title'){app.session=null;app.medley=null;go('title');}\n  else if(action==='slots')go('slots');\n  else if(action==='slot'){app.slot=Number(element.dataset.index);if(!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('island');}\n  else if(action==='dropin'){app.slot=0;if(!profile())app.profiles[0]=makeProfile('GUEST');app.returnScreen='island';go('island');}\n  else if(action==='island'){app.medley=null;app.weigh=null;go('island');}\n  else if(action==='intro'){app.activity=ACTIVITIES.find(item=>item.id===element.dataset.id);app.returnScreen='island';app.hard=false;sound.effect('voice');go('intro');}\n  else if(action==='hard'){app.hard=!app.hard;render();}\n  else if(action==='start')begin(app.activity);\n  else if(action==='weigh'){app.weigh=[];startWeigh();}\n  else if(action==='finale'){app.activity={...ACTIVITIES[0],id:'finale',name:'The Long Stand',place:'Pavilion',duration:45,ring:.32,quip:'A LITTLE HONESTY GOES A LONG WAY.'};app.returnScreen='island';go('intro');}\n  else if(action==='continue'){if(app.medley){app.medley.player++;if(app.medley.player>=app.medley.scores.length){app.medley.player=0;app.medley.event++;}if(app.medley.event>=3)go('medley-board');else startMedley();}else go('island');}\n  else if(action==='day-report')go('day-report');\n  else if(action==='next-day'){if(profile().day<7)profile().day++;save();go('island');}\n  else if(action==='family')go('family');\n  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n  else if(action==='settings'){app.settingsFrom=app.screen;go('settings');}\n  else if(action==='settings-back')go(app.screen==='dev'?'pause':app.settingsFrom||'title');\n  else if(action==='dev')go('dev');\n  else if(action==='reset-tuning'){app.tuning={...DEFAULT_TUNABLES};if(app.session)app.session.tuning={...app.tuning};render();}\n  else if(action==='resume'){app.paused=false;go('game');}\n  else if(action==='leave'){app.session=null;app.medley=null;app.weigh=null;go(profile()?'island':'title');}\n  else if(action==='about')go('about');\n  else if(action==='hub-ready')globalThis.AIHub?.answer('ready');\n  else if(action==='hub-more')globalThis.AIHub?.answer('more');\n}\nui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\nui.addEventListener('pointerover',event=>{const target=event.target.closest('button');if(target){ui.querySelectorAll('button.focused').forEach(item=>item.classList.remove('focused'));target.classList.add('focused');app.focus=Array.from(ui.querySelectorAll('button:not(:disabled)')).indexOf(target);}});\nui.addEventListener('input',event=>{const target=event.target;if(target.dataset.setting){const key=target.dataset.setting;app.settings[key]=target.type==='checkbox'?target.checked:target.type==='range'?Number(target.value):target.value;save();document.body.classList.toggle('high-contrast',app.settings.contrast);document.body.classList.toggle('reduce-motion',app.settings.motion);}if(target.dataset.tune){app.tuning[target.dataset.tune]=Number(target.value);if(app.session)app.session.tuning={...app.tuning};}});\nfunction menuMove(delta){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));if(!buttons.length)return;app.focus=(app.focus+delta+buttons.length)%buttons.length;buttons.forEach((item,index)=>item.classList.toggle('focused',index===app.focus));buttons[app.focus].focus();buttons[app.focus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\nwindow.addEventListener('keydown',event=>{app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nwindow.addEventListener('keyup',event=>app.keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur',()=>app.keys.clear());\nwindow.addEventListener('pointerdown',event=>{app.lastInput=performance.now();if(app.attract){leaveAttract();return;}sound.unlock();if(event.pointerType==='mouse')app.inputKind='mouse';});\nui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const rect=dial.getBoundingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.height/2)/(rect.height/2)))};app.lastInput=performance.now();});\nwindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n\nfunction gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nfunction frame(now){const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);const pad=gamepad();if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();if(app.screen==='game'&&app.session){let x=Number(app.keys.has('d')||app.keys.has('arrowright'))-Number(app.keys.has('a')||app.keys.has('arrowleft'));let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.keys.has('w')||app.keys.has('arrowup'));if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}if(app.attract){const time=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(Math.floor(time*3)%2===0)app.input.left=true;else app.input.right=true;}if(app.driver==='perfect'){x=0;y=0;}app.session.update(dt,{x,y,breath:app.keys.has(' ')||!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;const dot=document.getElementById('balance-dot'),seconds=document.getElementById('seconds'),meter=document.getElementById('meter'),score=document.getElementById('live-score');if(dot){dot.style.left=`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));if(meter)meter.style.width=`${Math.min(100,app.session.elapsed/app.session.duration*100)}%`;if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'KEEP GOING'}`;if(app.hubRound&&now-app.hubClock>500){app.hubClock=now;const partial=app.hubTotal+app.session.result().score;globalThis.AIHub?.progress({score:partial,label:app.activity.name});globalThis.AIHub?.send({x:app.session.dot.x,y:app.session.dot.y,score:partial});}if(app.session.finished)finish();}requestAnimationFrame(frame);}\n\nfunction advanceHub(){if(app.hubEnded)return;app.hubTotal+=app.session.result().score;app.hubEvent++;if(app.hubEvent>=3){app.hubEnded=true;globalThis.AIHub?.result({score:app.hubTotal});app.result={...app.session.result(),score:app.hubTotal,stars:0,drips:0};app.hubRound=false;go('results');}else begin({...ACTIVITIES.find(item=>item.id===['tree','hoop','step'][app.hubEvent])},{duration:20});}\nfunction setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>go('hub-card'));hub.on('start',()=>{app.hubRound=true;app.hubEnded=false;app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&!app.hubEnded){app.hubEnded=true;hub.result({score:app.hubTotal+(app.session?.result().score||0)});app.hubRound=false;}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.ready();}\nwindow.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\nrender();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\n# Game plan: an original fitness comedy inspired by Wii Fit\n\nYou are the builder. Build this game from this plan and your brief. Nobody will answer questions, so where the plan leaves something open, decide and move on.\n\n- **The title is yours.** Pick it the way your brief says. It lives in one constant (`src/data/title.js`) and nothing else hard-codes it. In this plan `{TITLE}` stands for it.\n- **Paths are relative to your dev folder.** \"Root\" means its parent, where your brief puts the deliverable html and the exit-interview file. Use the names your brief gives.\n- **✔ means the director ran it** on this machine against engine kit 0.46.0 and hub client 1.4.0, in the form written here. Don't re-derive it. If your download is newer, read its changelog from 0.46.0 on.\n- **Read in this order:** this plan; the kit's `GUIDE.md` and `ASSETS.md`, whole; the hub's `README.md`, whole. Search `API.md` and `LIBRARY.md`; don't read them whole.\n- Your brief's rules on folders, ports, processes, browsers and test reporting still apply. They are repeated here only where they shape the work.\n\n---\n\n## 1. The game\n\n**A week at a spotless wellness island run by a small, polite, deeply judgmental bathroom scale. Your whole body is one dot. Keep it in the circle.**\n\n- **Genre:** fitness and balance minigame collection, inside a light life-sim week. (Catalogue genre: Sports.)\n- **Perspective:** isometric on the island; fixed front-on for class activities; other fixed views per activity (section 5).\n- **Length:** a story week of 7 short days, 16 minutes at the quickest and about an hour for a player who tries everything. Everything is also playable at once from Drop-In Class.\n\n### Pillars (use these to settle any open question)\n\n1. **You are a dot.** Almost everything is one verb: lean. The left stick, WASD or the mouse moves your centre of balance, and it has weight and sway. Poses, reps, hoops, slacklines and the finale are all different ways of moving or holding the Dot.\n2. **Politely judged.** Everything you do gets a calm, clinical, faintly wounding remark. You cannot lose. You can only be noted.\n3. **One small day at a time.** Short sessions, a morning number, a chart, a jar slowly filling.\n4. **Always in class.** Other people are always beside you: classmates alone, family on the couch, friends as ghosts online. Everyone wobbles.\n\n### What it takes from the source, and how it stays original\n\n| Distinctive in the source | Here |\n|---|---|\n| Your body is the controller; a centre-of-balance dot | The Dot: real sway physics on a stick, keys or mouse |\n| A talking device that politely judges you | Ounce, a mint retro dial scale whose dial is its face |\n| A calm instructor demonstrating | Coach Plumb, 81, unblinking, never off vertical |\n| Daily check-in, one number that sums you up, a graph | Weigh-In, Wobble Age, a line chart with a twist |\n| Yoga, strength, aerobics, balance games | Four stations on the island |\n| Minutes banked toward unlocks | Drips in the Sweat Jar |\n| A bright, clean, soft-spoken world | White tile plaza on a pastel island made of giant gym equipment |\n| A household sharing one device | Family Hour on one TV, AI Hub sessions online |\n\n**Do not use** any Nintendo name, character, look, music, level or minigame name: no Wii, Mii, Balance Board, Wii Fit Trainer, Wuhu Island or Fit Age. No white-board host, no sound-alike tunes, no channel-style menus. Mechanics may rhyme; everything you can see, hear or read is new.\n\n**Taste rule:** no jokes about a real person's weight, body shape or eating, and no health claims. Ounce judges wobble, knees, posture and life choices, never bodies. The game asks for no real health data. The About screen says: \"This is not medical advice. Ounce is a scale.\"\n\n---\n\n## 2. World and cast\n\n**Tare Island** (\"Everything here starts at zero.\") is a tiny resort whose landscape is exercise equipment at enormous scale: Kettlebell Volcano (dormant, mostly), Foam Roller Hills, the Dumbbell Bridge, medicine-ball boulders. A white-tiled plaza sits at its heart, ringed by lawn, sand and calm sea.\n\n| Who | What | Voice |\n|---|---|---|\n| **Ounce** | The host, a scale. Hops after you on the island. Eyes and a red needle on a round dial: the needle is its eyebrow, and it whips, droops or spins with mood. | High, clipped, polite. \"I'd like to weigh in on that.\" |\n| **Coach Plumb** | 81, silver bun, cyan tracksuit, a plumb bob hanging from one wrist. Demonstrates everything without effort. | Low, slow, deadpan. |\n| **Marguerite** | 74, classmate. Has had everything replaced and tops every leaderboard. Friendly menace. | Warm, unhurried. |\n| **Dennis** | 47, classmate. Here after \"an incident with a deck chair\". Overconfident, always nearly injured. Beatable by Day 3. | Quick, hearty. |\n| **June** | 12, Marguerite's granddaughter. Excellent and bored. | Flat. |\n| **Kevin** | A seagull. Lands on people. Ounce speaks of him as staff. | Squawks. |\n\n**The story in one breath:** you arrive by ferry; Ounce weighs you and gives you an alarming Wobble Age. Through the week the classmates hint that something is off (\"Has anyone ever checked that scale?\"; Coach hangs her plumb line beside Ounce: \"You are leaning.\"; Kevin sits on Ounce and the dial reads 7). On Day 7 you face **The Long Stand**: 90 seconds of standing still while the whole island tries to distract you. Then Ounce confesses: *\"I have been adding seven. To everyone. For years. It felt motivating.\"* The chart of your week visibly slides down seven years. Credits. *\"See you tomorrow. Bring your knees.\"* Play continues as an open-ended Week 2.\n\n---\n\n## 3. Structure of play\n\n### Menu map\n\n```\nTitle (\"Press any button. Gently.\")      idle 10 s on title or any menu -> Attract\n└ Main Menu\n  ├ The Week        pick one of 3 guest slots -> Continue day N / start a week -> Island\n  ├ Drop-In Class   any activity at once, all open, records only, no Drips or story\n  ├ Family Hour     1-4 players on this screen -> Join -> The Medley -> Podium\n  ├ Settings\n  └ About & Credits\n```\n\nIn an AI Hub session none of this appears: the game opens on its own card, then the Medley (section 12).\n\n### Starting a week\n\nName entry, one of 6 preset avatars (the Locker Room changes it later), then the ferry cutscene and Ounce's introduction, which teaches the Dot before the first test: \"This dot is you. Keep it in the circle.\" Then the first Weigh-In. Ounce also asks \"How old do you feel? This is not binding.\" with a number picker; the answer is used once, in the joke when the Wobble Age arrives, and never saved.\n\n### A day in The Week\n\n1. **Morning Weigh-In** (about 45 s, section 6): balance test, one absurd question, today's Wobble Age.\n2. **Free time on the island:** walk between stations, do what you like. Coach's prescription (a daily goal) pays a bonus. Ounce follows and comments.\n3. **Hammock** ends the day once you've done at least one activity. Leaving early earns a guilt-trip, never a block.\n4. **Evening Report** (about 20 s): minutes, Drips, stars, the chart, tomorrow's \"concern\", new unlocks. The light goes to dusk (`applySky(engine, skyAt(19))`), then fade to morning.\n\n### The week\n\n| Day | Test | Coach's prescription (+5 Drips) | Opens today | Story beat |\n|---|---|---|---|---|\n| 1 | Stillness | Holding Still and one other | Apologetic Tree, Startled Heron, Squats of Regret, Hoop Economics | Ferry. \"Please step on me.\" \"Ow.\" \"This dot is you. Keep it in the circle. That's it. That's the game. Everything else is decoration.\" |\n| 2 | Lean | 2★ in anything | Coconut Header, Apology Lunges, Reluctant Warrior (adds breathing), Locker Room | Dennis explains the deck chair. Nobody asked. |\n| 3 | Chase | Something you haven't done | Step Class, Slackline, The Chair Nobody Asked For | Marguerite: \"Has anyone ever checked that scale?\" Ounce: \"I'd like to weigh in on that. No.\" |\n| 4 | Stillness | 3 activities | Vitamin Tray, Overhead Mortgage, Tax Season | Coach hangs her plumb line by Ounce. \"You are leaning.\" \"The island is leaning.\" |\n| 5 | Lean | Beat Dennis at anything | Island Jog, Pier Jump, Plank Negotiation | Kevin sits on Ounce. The dial reads 7. Nobody says anything. |\n| 6 | Chase | 3★ anywhere | Hard versions of everything | Ounce rehearses a speech, badly, behind the Sweat Jar. |\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_207","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,125p' src/main.js; cat src/data/activities.js; sed 's/}/}\\\\n/g' src/ui/style.css | sed -n '1,160p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_207","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,125p' src/main.js; cat src/data/activities.js; sed 's/}/}\\\\n/g' src/ui/style.css | sed -n '1,160p'\"","aggregated_output":"  if(profile()){const player=profile();player.drips+=app.result.drips;player.stars+=Math.max(0,app.result.stars-(player.played[app.activity.id]||0));player.played[app.activity.id]=Math.max(app.result.stars,player.played[app.activity.id]||0);if(app.activity.id==='finale'){player.revealed=true;save();go('reveal');return;}save();}\n  sound.effect('good');go('results');\n}\nfunction startWeigh(){const index=app.weigh.length;const names=['Still water','A gentle shift','Chase the breeze'];begin({...ACTIVITIES[0],id:['tree','heron','tax'][index],name:names[index],place:'Weigh-in',duration:8,ring:.38,instruction:['KEEP YOUR DOT IN THE RING','COUNTER THE DRIFT','STAY NEAR THE CENTER'][index]});}\nfunction startMedley(){const sequence=['tree','hoop','step'];const id=sequence[app.medley.event];begin({...ACTIVITIES.find(activity=>activity.id===id),name:`PLAYER ${app.medley.player+1} · ${ACTIVITIES.find(activity=>activity.id===id).name}`},{duration:20});}\nfunction startAttract(){app.attract=true;const sequence=['tree','hoop','step','header','slackline'];const activity=ACTIVITIES.find(item=>item.id===sequence[app.attractIndex%sequence.length]);begin(activity,{duration:12});}\nfunction leaveAttract(){app.attract=false;app.session=null;app.lastInput=performance.now();go('title');}\nfunction act(action,element){\n  sound.unlock();sound.effect('select');app.lastInput=performance.now();\n  if(app.attract){leaveAttract();return;}\n  if(action==='title'){app.session=null;app.medley=null;go('title');}\n  else if(action==='slots')go('slots');\n  else if(action==='slot'){app.slot=Number(element.dataset.index);if(!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('island');}\n  else if(action==='dropin'){app.slot=0;if(!profile())app.profiles[0]=makeProfile('GUEST');app.returnScreen='island';go('island');}\n  else if(action==='island'){app.medley=null;app.weigh=null;go('island');}\n  else if(action==='intro'){app.activity=ACTIVITIES.find(item=>item.id===element.dataset.id);app.returnScreen='island';app.hard=false;sound.effect('voice');go('intro');}\n  else if(action==='hard'){app.hard=!app.hard;render();}\n  else if(action==='start')begin(app.activity);\n  else if(action==='weigh'){app.weigh=[];startWeigh();}\n  else if(action==='finale'){app.activity={...ACTIVITIES[0],id:'finale',name:'The Long Stand',place:'Pavilion',duration:45,ring:.32,quip:'A LITTLE HONESTY GOES A LONG WAY.'};app.returnScreen='island';go('intro');}\n  else if(action==='continue'){if(app.medley){app.medley.player++;if(app.medley.player>=app.medley.scores.length){app.medley.player=0;app.medley.event++;}if(app.medley.event>=3)go('medley-board');else startMedley();}else go('island');}\n  else if(action==='day-report')go('day-report');\n  else if(action==='next-day'){if(profile().day<7)profile().day++;save();go('island');}\n  else if(action==='family')go('family');\n  else if(action==='family-start'){app.medley={scores:Array(Number(element.dataset.count)).fill(0),player:0,event:0};startMedley();}\n  else if(action==='settings'){app.settingsFrom=app.screen;go('settings');}\n  else if(action==='settings-back')go(app.screen==='dev'?'pause':app.settingsFrom||'title');\n  else if(action==='dev')go('dev');\n  else if(action==='reset-tuning'){app.tuning={...DEFAULT_TUNABLES};if(app.session)app.session.tuning={...app.tuning};render();}\n  else if(action==='resume'){app.paused=false;go('game');}\n  else if(action==='leave'){app.session=null;app.medley=null;app.weigh=null;go(profile()?'island':'title');}\n  else if(action==='about')go('about');\n  else if(action==='hub-ready')globalThis.AIHub?.answer('ready');\n  else if(action==='hub-more')globalThis.AIHub?.answer('more');\n}\nui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\nui.addEventListener('pointerover',event=>{const target=event.target.closest('button');if(target){ui.querySelectorAll('button.focused').forEach(item=>item.classList.remove('focused'));target.classList.add('focused');app.focus=Array.from(ui.querySelectorAll('button:not(:disabled)')).indexOf(target);}});\nui.addEventListener('input',event=>{const target=event.target;if(target.dataset.setting){const key=target.dataset.setting;app.settings[key]=target.type==='checkbox'?target.checked:target.type==='range'?Number(target.value):target.value;save();document.body.classList.toggle('high-contrast',app.settings.contrast);document.body.classList.toggle('reduce-motion',app.settings.motion);}if(target.dataset.tune){app.tuning[target.dataset.tune]=Number(target.value);if(app.session)app.session.tuning={...app.tuning};}});\nfunction menuMove(delta){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));if(!buttons.length)return;app.focus=(app.focus+delta+buttons.length)%buttons.length;buttons.forEach((item,index)=>item.classList.toggle('focused',index===app.focus));buttons[app.focus].focus();buttons[app.focus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\nwindow.addEventListener('keydown',event=>{app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nexport const ACTIVITIES = [\n  { id:'tree', name:'Apologetic Tree', family:'still', place:'Pavilion', day:1, duration:25, ring:.40, instruction:'KEEP YOUR DOT IN THE RING', quip:'THE TREE ACCEPTS YOUR APOLOGY.' },\n  { id:'heron', name:'Startled Heron', family:'still', place:'Pavilion', day:1, duration:25, ring:.36, instruction:'LEAN AGAINST THE WANDERING WIND', quip:'A MOST RESPECTABLE BIRD.' },\n  { id:'squats', name:'Squats of Regret', family:'reps', place:'Rep Shed', day:1, duration:38.4, instruction:'MATCH THE MOVING MARKER', quip:'THAT WAS THE LAST ONE. PROBABLY.' },\n  { id:'hoop', name:'Hoop Economics', family:'hoop', place:'Beat Beach', day:1, duration:40, instruction:'CIRCLE YOUR STICK OR ROLL W D S A', quip:'THE ECONOMY REMAINS CIRCULAR.' },\n  { id:'header', name:'Coconut Header', family:'header', place:'Beat Beach', day:2, duration:40, instruction:'LEAN LEFT OR RIGHT TO HEAD COCONUTS', quip:'A SOUND FINANCIAL HEADBUTT.' },\n  { id:'lunges', name:'Apology Lunges', family:'reps', place:'Rep Shed', day:2, duration:38.4, instruction:'MATCH THE MARKER AND ALTERNATE SIDES', quip:'YOUR LEGS HAVE BEEN NOTIFIED.' },\n  { id:'warrior', name:'Reluctant Warrior', family:'still', place:'Pavilion', day:2, duration:30, ring:.32, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'A WARRIOR, UNDER PROTEST.' },\n  { id:'step', name:'Step Department', family:'step', place:'Town Square', day:3, duration:40, instruction:'PRESS F OR J WHEN NOTES HIT THE LINE', quip:'YOUR STEPS HAVE BEEN FILED.' },\n  { id:'slackline', name:'Slackline of Doubt', family:'slack', place:'Lookout', day:3, duration:45, instruction:'STAY CENTERED. STEP TO WALK', quip:'THE ROPE BELIEVES IN YOU.' },\n  { id:'chair', name:'The Chair Nobody Asked For', family:'still', place:'Pavilion', day:3, duration:30, ring:.30, breath:8, instruction:'HOLD THE RING. BREATHE WITH THE BAR', quip:'SOMEWHERE A CHAIR FEELS SEEN.' },\n  { id:'tray', name:'Vitamin Tray', family:'tray', place:'Cafe', day:4, duration:40, instruction:'KEEP THE VITAMINS ON THE TRAY', quip:'NUTRITION HAS NEVER BEEN SO TENSE.' },\n  { id:'mortgage', name:'Overhead Mortgage', family:'reps', place:'Rep Shed', day:4, duration:36, instruction:'PUSH UP TO MATCH THE MARKER', quip:'INTEREST COMPOUNDS. SO DOES SWEAT.' },\n  { id:'tax', name:'Tax Season', family:'still', place:'Pavilion', day:4, duration:30, ring:.28, breath:6, instruction:'LEAN AND BREATHE THROUGH THE AUDIT', quip:'YOUR EXTENSION HAS BEEN APPROVED.' },\n  { id:'jog', name:'Island Jog', family:'jog', place:'Island Trail', day:5, duration:45, instruction:'ALTERNATE F AND J TO RUN', quip:'YOU HAVE LAPSED A COCONUT.' },\n  { id:'pier', name:'Pier Jump', family:'jump', place:'Pier', day:5, duration:40, instruction:'STEP TO THE EDGE. BREATHE TO JUMP', quip:'THE WATER GIVES YOU A TEN.' },\n  { id:'plank', name:'Plank Negotiation', family:'still', place:'Pavilion', day:5, duration:35, ring:.24, breath:6, instruction:'KEEP THE DOT IN THE RING. BREATHE', quip:'YOUR CORE HAS COUNTEROFFERED.' },\n];\n\nexport const DAY_NAMES = ['A FRESH START','THE HEAD OF IT','A NARROW VIEW','WEALTH AND HEALTH','THE LONG WAY ROUND','A LITTLE MORE','THE LONG STAND'];\nexport const FRIENDS = ['COACH PLUMB','MABEL','FRANK','KEVIN'];\nexport function activityForDay(day) { return ACTIVITIES.filter(activity => activity.day <= Math.min(day, 5)); }\n:root{font-family:'DM Sans',system-ui,sans-serif;color:#253e43;background:#cce8dc;font-synthesis:none;--ink:#253e43;--cream:#fbfaf0;--mint:#dcefe4;--orange:#ef795f;--yellow:#f7c96f;--line:#d3e0d8}\n*{box-sizing:border-box}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden}\nbutton,input,select{font:inherit}\nbutton{cursor:pointer}\nbutton:focus-visible,input:focus-visible,select:focus-visible{outline:4px solid #f19d5d;outline-offset:3px}\n#world,#ui{position:fixed;inset:0}\n#world{background:linear-gradient(155deg,#deefe4 0%,#c5e6dc 54%,#8dcfca 100%);overflow:hidden}\n#world canvas{display:block;width:100%;height:100%}\n#ui{z-index:2;overflow:hidden;pointer-events:none}\n.screen{position:absolute;inset:0;display:flex;align-items:center;padding:clamp(20px,4vw,64px);pointer-events:none}\n.screen>*{pointer-events:auto}\n.panel{width:min(550px,100%);max-height:100%;overflow:auto;scrollbar-width:thin;scrollbar-color:#a8bfb2 transparent}\n.glass{background:rgba(251,250,240,.96);border:1px solid rgba(255,255,255,.8);border-radius:28px;box-shadow:0 18px 60px #285a4c1c;padding:clamp(22px,3vw,40px)}\n.brand{display:inline-flex;align-items:center;gap:9px;font:700 13px 'Fredoka',sans-serif;letter-spacing:.13em;text-transform:uppercase;color:#558477}\n.brand-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:10px;background:var(--ink);color:#fff5dd;font-size:16px}\n.eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#73988a}\n.title{font:600 clamp(54px,7.5vw,100px)/.91 'Fredoka',system-ui,sans-serif;letter-spacing:-.055em;margin:30px 0 16px;color:#294943}\n.title span{color:#e97960}\n.lede{font-size:clamp(15px,1.5vw,18px);line-height:1.5;color:#607b70;max-width:390px}\n.title-tag{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:#f7dca2;font-size:10px;font-weight:700;letter-spacing:.12em;color:#785c29;text-transform:uppercase}\n.title-tag:before{content:'';width:7px;height:7px;background:#e98d5e;border-radius:100%}\n.menu{display:grid;gap:9px;margin-top:27px}\n.button{min-height:54px;border:0;border-radius:15px;padding:13px 18px;display:flex;align-items:center;gap:12px;text-align:left;font-weight:700;color:var(--ink);background:#e8f1e8;transition:transform .15s,background .15s,box-shadow .15s}\n.button:hover,.button.focused{transform:translateX(4px);background:#dcece0}\n.button.primary{color:#fff;background:#ef795f;box-shadow:0 5px 0 #d86350}\n.button.primary:hover,.button.primary.focused{background:#e76a52}\n.button .arrow{margin-left:auto;font-size:19px;font-weight:400}\n.button.small{min-height:42px;padding:9px 14px;font-size:13px;border-radius:11px}\n.button.ghost{background:#f2f4e9}\n.menu-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}\n.footnote{margin-top:23px;display:flex;gap:12px;align-items:center;color:#779288;font-size:11px;font-weight:700;letter-spacing:.05em}\n.key{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 6px;border:1px solid #bed0c4;border-radius:7px;background:#fff;font-size:11px;color:#49685c}\n.hero-note{position:absolute;right:6vw;bottom:6vh;text-align:right;color:#fff;text-shadow:0 1px 10px #28574e65;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;line-height:1.7}\n.hero-note strong{font:500 29px/1.2 'Fredoka',sans-serif;letter-spacing:0;display:block;text-transform:none}\n.topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}\n.back{border:0;background:#e9f1e8;color:#456b5c;border-radius:50%;width:40px;height:40px;font-size:19px}\n.heading{font:600 clamp(31px,4vw,45px)/1 'Fredoka',sans-serif;letter-spacing:-.035em;margin:6px 0 10px}\n.description{margin:0;color:#6b8378;line-height:1.5;font-size:14px}\n.stack{display:grid;gap:9px;margin-top:22px}\n.list-item{position:relative;border:1px solid #e1e9de;border-radius:16px;background:#fff;min-height:66px;padding:12px 14px;display:flex;align-items:center;text-align:left;gap:12px;width:100%;color:var(--ink)}\n.list-item:hover,.list-item.focused{border-color:#ef9f88;box-shadow:0 3px 0 #f5c3b0}\n.list-item:disabled{opacity:.52;cursor:not-allowed}\n.list-item .icon{flex:none;width:41px;height:41px;border-radius:13px;display:grid;place-items:center;background:#dcefe5;font-size:21px}\n.list-item .name{display:block;font:600 16px 'Fredoka',sans-serif}\n.list-item .sub{display:block;color:#89a094;font-size:11px;margin-top:3px}\n.list-item .arrow{margin-left:auto;color:#98afa1}\n.badge{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:#e5f0e6;color:#658679}\n.badge.sun{background:#ffefd2;color:#a2752c}\n.badge.coral{background:#ffebe4;color:#c96951}\n.scroll-list{max-height:min(45vh,400px);overflow:auto;padding:1px 4px 4px 1px}\n.profile-card{display:flex;align-items:center;gap:12px}\n.profile-avatar{height:44px;width:44px;border-radius:50%;background:#f3c394;display:grid;place-items:center;font-size:23px}\n.profile-info strong{font:600 15px 'Fredoka',sans-serif}\n.profile-info small{display:block;color:#86a094;margin-top:3px}\n.island-screen{align-items:stretch}\n.island-screen .panel{width:min(520px,100%)}\n.stats{display:flex;gap:7px;flex-wrap:wrap;margin:16px 0}\n.stats span{padding:7px 10px;border-radius:9px;background:#edf3e9;font-size:11px;font-weight:700;color:#6d8b7d}\n.actions{display:flex;gap:9px;margin-top:18px}\n.actions>*{flex:1}\n.section-label{margin:21px 0 10px;color:#8aa296;font-size:10px;letter-spacing:.14em;text-transform:uppercase;font-weight:700}\n.guide{display:flex;gap:13px;align-items:flex-start;background:#e5f1e7;padding:14px;border-radius:15px;margin-top:21px}\n.ounce{flex:none;width:45px;height:40px;border-radius:13px 13px 16px 16px;background:#fdfcf3;box-shadow:inset 0 -5px 0 #dce3d9;position:relative}\n.ounce:before{content:'• ᴗ •';position:absolute;left:6px;top:11px;white-space:nowrap;color:#6e8f80;font-size:12px}\n.guide p{margin:0;color:#618071;font-size:13px;line-height:1.4}\n.game-screen{display:block;padding:0}\n.game-hud{position:absolute;inset:0;padding:clamp(16px,3vw,38px);display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}\n.game-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}\n.game-title{background:#fbfaf0ed;border-radius:18px;padding:14px 18px;box-shadow:0 8px 26px #214f3f1a;max-width:min(410px,60vw)}\n.game-title strong{display:block;font:600 clamp(18px,2.6vw,27px) 'Fredoka',sans-serif}\n.game-title small{font-size:10px;letter-spacing:.11em;color:#8ba195;font-weight:700}\n.game-time{background:#fbfaf0ed;border-radius:18px;padding:12px 18px;text-align:center;font:600 30px 'Fredoka',sans-serif}\n.game-time small{display:block;font:700 9px 'DM Sans',sans-serif;letter-spacing:.15em;color:#8ba195}\n.game-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:15px}\n.balance-card{background:#fbfaf0f5;border-radius:24px;padding:15px 20px;box-shadow:0 8px 30px #214f3f20;pointer-events:auto}\n.balance-inner{display:flex;align-items:center;gap:18px}\n.dial{width:clamp(125px,18vw,210px);aspect-ratio:1;position:relative;border-radius:50%;background:radial-gradient(circle,#f9fbf2 0 28%,#dceee2 28.5% 29.5%,#edf5e9 30% 58%,#c8e0d2 58.5% 59.5%,#f5f8ee 60%);border:2px solid #d5e6d9;touch-action:none}\n.dial:before,.dial:after{content:'';position:absolute;background:#bdd7c8;opacity:.65}\n.dial:before{height:1px;left:0;right:0;top:50%}\n.dial:after{width:1px;top:0;bottom:0;left:50%}\n.dot{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px;border-radius:50%;background:#f2765c;border:3px solid white;box-shadow:0 2px 5px #d47e6770;z-index:1}\n.balance-text{width:125px}\n.balance-text strong{font:600 19px/1.1 'Fredoka',sans-serif}\n.balance-text p{font-size:11px;line-height:1.5;color:#789184}\n.meter{height:8px;border-radius:8px;background:#dbe8dd;overflow:hidden;margin-top:9px}\n.meter span{height:100%;display:block;background:#ed856a;border-radius:8px;transition:width .1s}\n.game-tip{background:#fbfaf0ed;border-radius:15px;padding:12px 15px;color:#729084;font-weight:700;font-size:11px;line-height:1.6;text-align:right}\n.game-tip .key{margin:0 2px}\n.score-hero{font:600 clamp(60px,9vw,94px)/1 'Fredoka',sans-serif;letter-spacing:-.04em;color:#e77c61;margin:18px 0 0}\n.stars{color:#f3bb53;font-size:31px;letter-spacing:4px}\n.result-box{display:flex;justify-content:space-between;gap:10px;border-top:1px solid #e3e9df;margin-top:18px;padding-top:17px;font-size:13px;color:#718b7e}\n.field{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 0;border-bottom:1px solid #e8eee5}\n.field label{font-weight:700;font-size:13px}\n.field input[type=range]{width:46%;accent-color:#ee8165}\n.field select{border:1px solid #d7e5d8;background:white;border-radius:9px;padding:7px}\n.field input[type=text]{width:62%;border:1px solid #d7e5d8;background:white;border-radius:9px;padding:10px;color:#34564a}\n.about-text{font-size:13px;line-height:1.6;color:#607a6d}\n.about-text h3{color:#355a4a;font:600 17px 'Fredoka',sans-serif;margin:20px 0 5px}\n.about-text p{margin:0 0 9px}\n.toast{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);background:#304c42;color:#fff;border-radius:12px;padding:11px 17px;font-size:12px;font-weight:700;white-space:nowrap}\n.loading{position:absolute;inset:0;display:grid;place-content:center;text-align:center;font:600 22px 'Fredoka',sans-serif;color:#4b796a}\n.loading span{font-size:10px;letter-spacing:6px;margin-top:10px}\n.fallback-island{position:absolute;width:min(68vw,900px);height:min(30vw,350px);right:4%;top:38%;border-radius:50%;background:#8cbf8d;box-shadow:0 28px 0 #d4b887,0 50px 0 #b99f78,0 60px 70px #4faaa050;transform:rotate(-8deg)}\n.fallback-island:before{content:'';position:absolute;width:36%;height:35%;top:16%;left:32%;background:#f4e7c5;border-radius:50%}\n.fallback-island:after{content:'●';position:absolute;left:47%;top:-25%;font-size:clamp(90px,14vw,200px);color:#5d9f70;text-shadow:-240px 75px 0 #7db681,240px 75px 0 #77b17b}\n.fallback-island i,.fallback-island b,.fallback-island em{position:absolute;width:50px;height:64px;border-radius:9px;background:#fff5db;z-index:1;top:12%;left:38%;box-shadow:inset 0 -10px #ecd9b4}\n.fallback-island b{left:67%;top:20%;transform:rotate(9deg)}\n.fallback-island em{left:17%;top:30%;transform:rotate(-9deg)}\n.touch-notice{position:absolute;right:3vw;top:3vw;background:#fff8e6e8;border-radius:12px;padding:10px 14px;font-size:11px;font-weight:700;color:#698678}\n.high-contrast{--ink:#142925;--line:#6c8073}\n.high-contrast .description,.high-contrast .lede{color:#355247}\n.reduce-motion *{transition:none!important;animation:none!important}\n@media(max-width:700px){.screen{padding:16px;align-items:flex-end}\n.panel{max-height:calc(100% - 12px)}\n.glass{padding:23px;border-radius:24px}\n.title{font-size:clamp(52px,15vw,72px);margin:20px 0 11px}\n.lede{font-size:14px}\n.menu{margin-top:18px}\n.button{min-height:49px}\n.hero-note{display:none}\n.fallback-island{width:100vw;height:35vw;right:-15%;top:8%}\n.fallback-island:after{left:43%;top:-60%}\n.island-screen{align-items:flex-end}\n.island-screen .panel{width:100%}\n.scroll-list{max-height:31vh}\n.game-hud{padding:14px}\n.game-title{max-width:70vw}\n.game-title small{font-size:9px}\n.game-bottom{align-items:flex-end}\n.balance-card{padding:10px;border-radius:18px}\n.balance-inner{gap:9px}\n.dial{width:120px}\n.balance-text{width:90px}\n.balance-text strong{font-size:15px}\n.balance-text p{font-size:10px}\n.game-tip{max-width:130px;font-size:10px;padding:9px}\n.touch-notice{top:12px;right:12px}\n.footnote{margin-top:14px}\n.heading{font-size:33px}\n}\n@media(max-height:600px) and (min-width:701px){.screen{padding:18px 35px}\n.glass{padding:22px}\n.title{font-size:55px;margin:12px 0}\n.lede{font-size:14px}\n.menu{margin-top:12px}\n.button{min-height:43px}\n.footnote{margin-top:12px}\n.scroll-list{max-height:34vh}\n}\n@media(max-width:360px){.balance-text{display:none}\n.game-tip{font-size:9px}\n.title{font-size:48px}\n.glass{padding:19px}\n.menu-row{gap:6px}\n}\n\n","exit_code":0,"status":"completed"}}
