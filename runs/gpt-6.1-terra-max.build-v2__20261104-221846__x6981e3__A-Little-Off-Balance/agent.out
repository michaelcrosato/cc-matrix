:0;color:#618071;font-size:13px;line-height:1.4}.game-screen{display:block;padding:0}.game-hud{position:absolute;inset:0;padding:clamp(16px,3vw,38px);display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}.game-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.game-title{background:#fbfaf0ed;border-radius:18px;padding:14px 18px;box-shadow:0 8px 26px #214f3f1a;max-width:min(410px,60vw)}.game-title strong{display:block;font:600 clamp(18px,2.6vw,27px) 'Fredoka',sans-serif}.game-title small{font-size:10px;letter-spacing:.11em;color:#8ba195;font-weight:700}.game-time{background:#fbfaf0ed;border-radius:18px;padding:12px 18px;text-align:center;font:600 30px 'Fredoka',sans-serif}.game-time small{display:block;font:700 9px 'DM Sans',sans-serif;letter-spacing:.15em;color:#8ba195}.game-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:15px}.balance-card{background:#fbfaf0f5;border-radius:24px;padding:15px 20px;box-shadow:0 8px 30px #214f3f20;pointer-events:auto}.balance-inner{display:flex;align-items:center;gap:18px}.dial{width:clamp(125px,18vw,210px);aspect-ratio:1;position:relative;border-radius:50%;background:radial-gradient(circle,#f9fbf2 0 28%,#dceee2 28.5% 29.5%,#edf5e9 30% 58%,#c8e0d2 58.5% 59.5%,#f5f8ee 60%);border:2px solid #d5e6d9;touch-action:none}.dial:before,.dial:after{content:'';position:absolute;background:#bdd7c8;opacity:.65}.dial:before{height:1px;left:0;right:0;top:50%}.dial:after{width:1px;top:0;bottom:0;left:50%}.dot{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px;border-radius:50%;background:#f2765c;border:3px solid white;box-shadow:0 2px 5px #d47e6770;z-index:1}.balance-text{width:125px}.balance-text strong{font:600 19px/1.1 'Fredoka',sans-serif}.balance-text p{font-size:11px;line-height:1.5;color:#789184}.meter{height:8px;border-radius:8px;background:#dbe8dd;overflow:hidden;margin-top:9px}.meter span{height:100%;display:block;background:#ed856a;border-radius:8px;transition:width .1s}.game-tip{background:#fbfaf0ed;border-radius:15px;padding:12px 15px;color:#729084;font-weight:700;font-size:11px;line-height:1.6;text-align:right}.game-tip .key{margin:0 2px}.score-hero{font:600 clamp(60px,9vw,94px)/1 'Fredoka',sans-serif;letter-spacing:-.04em;color:#e77c61;margin:18px 0 0}.stars{color:#f3bb53;font-size:31px;letter-spacing:4px}.result-box{display:flex;justify-content:space-between;gap:10px;border-top:1px solid #e3e9df;margin-top:18px;padding-top:17px;font-size:13px;color:#718b7e}.field{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 0;border-bottom:1px solid #e8eee5}.field label{font-weight:700;font-size:13px}.field input[type=range]{width:46%;accent-color:#ee8165}.field select{border:1px solid #d7e5d8;background:white;border-radius:9px;padding:7px}.field input[type=text]{width:62%;border:1px solid #d7e5d8;background:white;border-radius:9px;padding:10px;color:#34564a}.about-text{font-size:13px;line-height:1.6;color:#607a6d}.about-text h3{color:#355a4a;font:600 17px 'Fredoka',sans-serif;margin:20px 0 5px}.about-text p{margin:0 0 9px}.toast{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);background:#304c42;color:#fff;border-radius:12px;padding:11px 17px;font-size:12px;font-weight:700;white-space:nowrap}.loading{position:absolute;inset:0;display:grid;place-content:center;text-align:center;font:600 22px 'Fredoka',sans-serif;color:#4b796a}.loading span{font-size:10px;letter-spacing:6px;margin-top:10px}.fallback-island{position:absolute;width:min(68vw,900px);height:min(30vw,350px);right:4%;top:38%;border-radius:50%;background:#8cbf8d;box-shadow:0 28px 0 #d4b887,0 50px 0 #b99f78,0 60px 70px #4faaa050;transform:rotate(-8deg)}.fallback-island:before{content:'';position:absolute;width:36%;height:35%;top:16%;left:32%;background:#f4e7c5;border-radius:50%}.fallback-island:after{content:'●';position:absolute;left:47%;top:-25%;font-size:clamp(90px,14vw,200px);color:#5d9f70;text-shadow:-240px 75px 0 #7db681,240px 75px 0 #77b17b}.fallback-island i,.fallback-island b,.fallback-island em{position:absolute;width:50px;height:64px;border-radius:9px;background:#fff5db;z-index:1;top:12%;left:38%;box-shadow:inset 0 -10px #ecd9b4}.fallback-island b{left:67%;top:20%;transform:rotate(9deg)}.fallback-island em{left:17%;top:30%;transform:rotate(-9deg)}.touch-notice{position:absolute;right:3vw;top:3vw;background:#fff8e6e8;border-radius:12px;padding:10px 14px;font-size:11px;font-weight:700;color:#698678}.high-contrast{--ink:#142925;--line:#6c8073}.high-contrast .description,.high-contrast .lede{color:#355247}.reduce-motion *{transition:none!important;animation:none!important}@media(max-width:700px){.screen{padding:16px;align-items:flex-end}.panel{max-height:calc(100% - 12px)}.glass{padding:23px;border-radius:24px}.title{font-size:clamp(52px,15vw,72px);margin:20px 0 11px}.lede{font-size:14px}.menu{margin-top:18px}.button{min-height:49px}.hero-note{display:none}.fallback-island{width:100vw;height:35vw;right:-15%;top:8%}.fallback-island:after{left:43%;top:-60%}.island-screen{align-items:flex-end}.island-screen .panel{width:100%}.scroll-list{max-height:31vh}.game-hud{padding:14px}.game-title{max-width:70vw}.game-title small{font-size:9px}.game-bottom{align-items:flex-end}.balance-card{padding:10px;border-radius:18px}.balance-inner{gap:9px}.dial{width:120px}.balance-text{width:90px}.balance-text strong{font-size:15px}.balance-text p{font-size:10px}.game-tip{max-width:130px;font-size:10px;padding:9px}.touch-notice{top:12px;right:12px}.footnote{margin-top:14px}.heading{font-size:33px}}@media(max-height:600px) and (min-width:701px){.screen{padding:18px 35px}.glass{padding:22px}.title{font-size:55px;margin:12px 0}.lede{font-size:14px}.menu{margin-top:12px}.button{min-height:43px}.footnote{margin-top:12px}.scroll-list{max-height:34vh}}@media(max-width:360px){.balance-text{display:none}.game-tip{font-size:9px}.title{font-size:48px}.glass{padding:19px}.menu-row{gap:6px}}\nimport {readFileSync,writeFileSync,mkdirSync} from 'node:fs';\nimport {execFileSync} from 'node:child_process';\n\nmkdirSync('.build',{recursive:true});\nexecFileSync('esbuild',['src/main.js','--bundle','--format=esm','--platform=browser','--target=esnext','--charset=utf8','--outfile=.build/game.js','--log-level=warning'],{stdio:'inherit'});\nconst safe=source=>source.replace(/<\\/script/gi,'<\\\\/script');\nconst css=readFileSync('src/ui/style.css','utf8');\nconst hub=safe(readFileSync('vendor/hub/session.js','utf8'));\nconst game=safe(readFileSync('.build/game.js','utf8'));\nconst html=`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#cbe9dc\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\"><meta name=\"hub:session-goal\" content=\"Score the most points across three delightfully wobbly events.\"><meta name=\"hub:session-howto\" content=\"Left stick or WASD: lean. R2 or Space: breathe. L1/R1 or F/J: step.\"><meta name=\"hub:session-minutes\" content=\"4\"><meta name=\"hub:webgpu\" content=\"required\">\n<title>A Little Off Balance</title><style>${css}</style></head>\n<body><div id=\"world\" aria-hidden=\"true\"><div class=\"fallback-island\"><i></i><b></b><em></em></div></div><div id=\"ui\"><main class=\"loading\">A little moment, please<span>● ● ●</span></main></div><script type=\"module\">${game}</script></body></html>`;\nwriteFileSync('../A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html',html);\nconsole.log(`Built standalone HTML (${(Buffer.byteLength(html)/1048576).toFixed(1)} MB).`);\n32:| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n44:Games tagged with the older modes keep working: `race` is played as ghost,\n77:- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n94:- seeds `Math.random`, in parallel and ghost, before any of the game's own\n166:choices, and play begins only at `start`. In parallel and ghost it draws no\n184:`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\n190:- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n194:  ghost, once, when the player's round is over. `time` is milliseconds of\n195:  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n206:- The hub may call time while the round is still going. On `time-up`, the\n207:  game reports within `graceMs`: a `result()` in parallel and ghost, a\n226:- A parallel or ghost round goes on whoever leaves, the host included.\n235:- Parallel and ghost: players with a `time` rank first, lowest first; then\n258:The copies send nothing to each other. `send()` is not used.\n263:the other copies with `send()`. Each copy shows the other players' characters\n277:### `send()` and `message`\n279:- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n281:- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n328:The hub's own test also runs ghost and shared-world games with\n339:- parallel and ghost: `Math.random` the same on every copy, and progress from\n340:  every copy; parallel sends nothing, ghost sends;\n343:- a player leaving, the host leaving, time-up, a valid result, and every copy\n366:| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n380:| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n381:| `AIHub.on(event, fn)` | returns a function that removes the handler |\n382:| `AIHub.progress({ score, label })` | parallel and ghost |\n383:| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n385:| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n399:| `time-up` | `{ graceMs }` |\n","exit_code":0,"status":"completed"}}
