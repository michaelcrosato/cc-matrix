{"type":"item.completed","item":{"id":"item_478","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; cat \\\"\"'$DEV/tools/build.mjs\"; sed -n '\"'145,180p' \\\"\"'$DEV/src/main.js\"; fold -w 180 \"$DEV/src/ui/style.css\" | head -18; sed -n '\"'1,260p' \\\"\"'$DEV/tests/browser.py\"; cat PROGRESS.md'","aggregated_output":"import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';\nimport {execFileSync} from 'node:child_process';\nimport {TITLE} from '../src/data/title.js';\nimport {about} from '../src/data/about.js';\n\nmkdirSync('.build',{recursive:true});\nexecFileSync('esbuild',['src/main.js','--bundle','--format=esm','--platform=browser','--target=esnext','--charset=utf8','--outfile=.build/game.js','--log-level=warning'],{stdio:'inherit'});\nconst safe=source=>source.replace(/<\\/script/gi,'<\\\\/script');\nconst css=readFileSync('src/ui/style.css','utf8')+readFileSync('src/ui/overrides.css','utf8');\nconst hub=safe(readFileSync('vendor/hub/session.js','utf8'));\nconst game=safe(readFileSync('.build/game.js','utf8'));\nconst html=`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#cbe9dc\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\"><meta name=\"hub:session-goal\" content=\"Score the most points across three delightfully wobbly events.\"><meta name=\"hub:session-howto\" content=\"Left stick or WASD: lean. R2 or Space: breathe. L1/R1 or F/J: step.\"><meta name=\"hub:session-minutes\" content=\"4\"><meta name=\"hub:webgpu\" content=\"required\">\n<title>${TITLE}</title><style>${css}</style></head>\n<body><div id=\"world\" aria-hidden=\"true\"><div class=\"fallback-island\"><i></i><b></b><em></em></div></div><div id=\"ui\"><main class=\"loading\">A little moment, please<span>● ● ●</span></main></div><script type=\"module\">${game}</script></body></html>`;\nwriteFileSync(`../${TITLE}-Wii Fit-gpt-6.1-terra-max-20261104-221846.html`,html);\nwriteFileSync('../exit-interview.json',JSON.stringify(about,null,2)+'\\n');\nconsole.log(`Built standalone HTML (${(Buffer.byteLength(html)/1048576).toFixed(1)} MB).`);\n  if(activity.family==='step')return Math.abs(time/.7-Math.round(time/.7))<.23?'STEP NOW · F OR J':'WAIT FOR THE BEAT';\n  if(activity.family==='jog')return 'ALTERNATE F AND J';\n  if(activity.family==='slack')return 'F / J TO WALK THE LINE';\n  if(activity.family==='jump')return 'SPACE / R2 TO JUMP';\n  if(activity.family==='hoop')return `CIRCLE THE STICK · ${Math.round(session.hoopLift*100)}% LIFT`;\n  if(activity.breath)return Math.sin(time*Math.PI*2/activity.breath)>0?'BREATHE IN · HOLD':'BREATHE OUT · RELEASE';\n  return 'KEEP THE DOT INSIDE THE RING';\n}\nfunction frame(now){\n  const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);\n  if(app.hubClosed){requestAnimationFrame(frame);return;}\n  const pad=gamepad();\n  if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();\n  if(app.screen==='game'&&app.session){\n    const seconds=document.getElementById('seconds');\n    if(app.hubRound&&!syncHub()){app.input.left=false;app.input.right=false;requestAnimationFrame(frame);return;}\n    let x=Number(app.keys.has('d')||app.keys.has('arrowright'))-Number(app.keys.has('a')||app.keys.has('arrowleft'));\n    let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.keys.has('w')||app.keys.has('arrowup'));\n    if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}\n    if(app.attract){const time=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(Math.floor(time*3)%2===0)app.input.left=true;else app.input.right=true;}\n    if(app.driver==='perfect'){x=0;y=0;}\n    app.session.update(dt,{x,y,breath:app.keys.has(' ')||!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;\n    const dot=document.getElementById('balance-dot'),meter=document.getElementById('meter'),score=document.getElementById('live-score'),cue=document.getElementById('live-cue'),dial=document.getElementById('dial');\n    if(dot){dot.style.left=`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}\n    if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));\n    if(meter)meter.style.width=`${Math.min(100,app.session.elapsed/app.session.duration*100)}%`;\n    if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'KEEP GOING'}`;\n    if(cue)cue.textContent=activityCue(app.session);\n    if(dial&&app.hubRound){dial.querySelectorAll('.ghost-dot').forEach(node=>node.remove());for(const ghost of Object.values(app.hubScores).slice(0,3)){if(ghost?.a!==app.hubEvent||!Number.isFinite(ghost?.x)||!Number.isFinite(ghost?.y))continue;const marker=document.createElement('span');marker.className='ghost-dot';marker.style.left=`${50+Math.max(-1,Math.min(1,ghost.x))*38}%`;marker.style.top=`${50+Math.max(-1,Math.min(1,ghost.y))*38}%`;dial.appendChild(marker);}}\n    if(app.session.finished&&!app.hubRound)finish();\n  }\n  requestAnimationFrame(frame);\n}\n\nfunction hubScore(){return app.hubTotal+(app.session?.result().score||0)*10;}\nfunction beginHubEvent(index){app.hubEvent=index;const activity=ACTIVITIES.find(item=>item.id===app.hubPicks[index]);begin(activity,{duration:EVENT_SECONDS,random:globalThis.AIHub.rng(`event:${index}`),hard:false,tuning:{...DEFAULT_TUNABLES,timeScale:1}});}\n:root{font-family:'DM Sans',system-ui,sans-serif;color:#253e43;background:#cce8dc;font-synthesis:none;--ink:#253e43;--cream:#fbfaf0;--mint:#dcefe4;--orange:#ef795f;--yellow:#f7c96f\n;--line:#d3e0d8}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:\nfocus-visible,select:focus-visible{outline:4px solid #f19d5d;outline-offset:3px}#world,#ui{position:fixed;inset:0}#world{background:linear-gradient(155deg,#deefe4 0%,#c5e6dc 54%,#8\ndcfca 100%);overflow:hidden}#world canvas{display:block;width:100%;height:100%}#ui{z-index:2;overflow:hidden;pointer-events:none}.screen{position:absolute;inset:0;display:flex;alig\nn-items:center;padding:clamp(20px,4vw,64px);pointer-events:none}.screen>*{pointer-events:auto}.panel{width:min(550px,100%);max-height:100%;overflow:auto;scrollbar-width:thin;scroll\nbar-color:#a8bfb2 transparent}.glass{background:rgba(251,250,240,.96);border:1px solid rgba(255,255,255,.8);border-radius:28px;box-shadow:0 18px 60px #285a4c1c;padding:clamp(22px,3\nvw,40px)}.brand{display:inline-flex;align-items:center;gap:9px;font:700 13px 'Fredoka',sans-serif;letter-spacing:.13em;text-transform:uppercase;color:#558477}.brand-icon{display:gr\nid;place-items:center;width:28px;height:28px;border-radius:10px;background:var(--ink);color:#fff5dd;font-size:16px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text\n-transform:uppercase;color:#73988a}.title{font:600 clamp(54px,7.5vw,100px)/.91 'Fredoka',system-ui,sans-serif;letter-spacing:-.055em;margin:30px 0 16px;color:#294943}.title span{co\nlor:#e97960}.lede{font-size:clamp(15px,1.5vw,18px);line-height:1.5;color:#607b70;max-width:390px}.title-tag{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-r\nadius:999px;background:#f7dca2;font-size:10px;font-weight:700;letter-spacing:.12em;color:#785c29;text-transform:uppercase}.title-tag:before{content:'';width:7px;height:7px;backgrou\nnd:#e98d5e;border-radius:100%}.menu{display:grid;gap:9px;margin-top:27px}.button{min-height:54px;border:0;border-radius:15px;padding:13px 18px;display:flex;align-items:center;gap:1\n2px;text-align:left;font-weight:700;color:var(--ink);background:#e8f1e8;transition:transform .15s,background .15s,box-shadow .15s}.button:hover,.button.focused{transform:translateX\n(4px);background:#dcece0}.button.primary{color:#fff;background:#ef795f;box-shadow:0 5px 0 #d86350}.button.primary:hover,.button.primary.focused{background:#e76a52}.button .arrow{ma\nrgin-left:auto;font-size:19px;font-weight:400}.button.small{min-height:42px;padding:9px 14px;font-size:13px;border-radius:11px}.button.ghost{background:#f2f4e9}.menu-row{display:gr\nid;grid-template-columns:1fr 1fr;gap:9px}.footnote{margin-top:23px;display:flex;gap:12px;align-items:center;color:#779288;font-size:11px;font-weight:700;letter-spacing:.05em}.key{d\nisplay:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 6px;border:1px solid #bed0c4;border-radius:7px;background:#fff;font-size:11px;colo\nr:#49685c}.hero-note{position:absolute;right:6vw;bottom:6vh;text-align:right;color:#fff;text-shadow:0 1px 10px #28574e65;font-size:11px;font-weight:700;letter-spacing:.16em;text-tr\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef complete_week(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        start_profile(page)\n        click(page, 'weigh')\n        for _ in range(3):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n        screen(page, 'weigh-result')\n        assert len(state(page)['profiles'][0]['history']) == 3\n        click(page, 'island')\n        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\n            assert state(page)['day'] == day\n        click(page, 'finale')\n        click(page, 'start')\n        finish(page)\n        screen(page, 'reveal')\n        assert state(page)['profiles'][0]['revealed'] is True\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef family(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        click(page, 'family')\n        click(page, 'family-start', '[data-count=\"2\"]')\n        for _ in range(6):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        screen(page, 'medley-board')\n        assert page.get_by_text('PLAYER 1', exact=True).count() == 1\n        assert page.get_by_text('PLAYER 2', exact=True).count() == 1\n    finally:\n        browser.close()\n\n\ndef mobile(playwright, url):\n    browser = playwright.webkit.launch(headless=True)\n    context = browser.new_context(**playwright.devices['iPhone 17 Pro'])\n    page = context.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        assert page.get_by_text('Controller or keyboard required').is_visible()\n        assert page.locator('[data-action=\"slots\"]').count() == 0\n        click(page, 'settings')\n        assert page.locator('#music').input_value() == '0.1'\n    finally:\n        context.close()\n        browser.close()\n\n\ndef attract(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_function('window.__GAME__.state().attract', timeout=13000)\n        page.keyboard.press('Enter')\n        screen(page, 'title')\n    finally:\n        browser.close()\n\n\ndef webgpu(playwright, url):\n    browser = playwright.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-angle=swiftshader', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_selector('#world canvas', timeout=12000)\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthreading.Thread(target=server.serve_forever, daemon=True).start()\nurl = f'http://127.0.0.1:{server.server_port}/' + urllib.parse.quote(FILENAME)\ntry:\n    with sync_playwright() as playwright:\n        for name in ('chromium', 'firefox', 'webkit'):\n            check(name + ' profile, activity, persistence', lambda name=name: smoke(getattr(playwright, name), url))\n        check('seven-day playthrough and all activities', lambda: complete_week(playwright.chromium, url))\n        check('family medley', lambda: family(playwright.chromium, url))\n        check('touch-only notice', lambda: mobile(playwright, url))\n        check('idle attract and wake', lambda: attract(playwright.chromium, url))\n        check('WebGPU island', lambda: webgpu(playwright, url))\nfinally:\n    server.shutdown()\nprint(json.dumps({'passed': passed, 'failures': failures}))\n# Progress\n\n## Project\n- Title selected by `crypto.randomInt` from 50 candidates: **A Little Off Balance**.\n- Deliverable basename: `A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846`.\n- Read `TASK.md` and `PLAN.md`; downloaded the unmodified Pixel Engine 0.46.0 and AI Hub client into the development folder.\n- Implemented the activity catalog, unstable balance physics, progression, synthesized audio, 3D island, screens, local profiles, family sessions, and AI Hub client integration. The standalone HTML builds successfully.\n\n## Work plan\n1. Read the complete design and integration documentation; obtain the unmodified engine and hub client.\n2. Build the core game, island, activities, progression, input, audio, and multiplayer.\n3. Bundle the standalone HTML, run focused playthrough and viewport tests, and fix findings.\n4. Complete About/Credits, `exit-interview.json`, and this progress record.\n\n## Current checkpoint\n- Source lives in the development folder's `src/`; build the standalone deliverable with `npm run build` there.\n- `npm test` passes 28 checks, including activity simulations, profile/day progression, family play, the WebGPU scene, and Chromium/Firefox/WebKit browser flows.\n- The viewport matrix reports 24 clean phone, foldable, tablet, and desktop configurations. Selected WebKit and Chromium screenshots have been inspected.\n- Fixed an unsupported-WebGPU startup overlay and an oversized title encountered during browser testing.\n- Next: validate the official AI Hub harness and standalone `file://` launch, inspect in-game layouts, address important gaps, and replace interview placeholders.\n- The implementation is a simplified interpretation of the extensive plan: in particular, family play is sequential and the activities share the island scene rather than having full bespoke animated environments.\n\n## Constraints\n- Only work in this directory and the required development subfolder; use OS-assigned localhost ports and stop only our own processes.\n- Keep `pixel-engine.js` unchanged; synthesize audio in code; default music volume 10%.\n- Test small phones, tablets, wide screens, WebKit, and scripted game flows; no physical controller or real iOS device is available.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_479","type":"reasoning","text":"**Inspecting CSS line patterns**"}}
{"type":"item.started","item":{"id":"item_480","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -o '\\\\.fallback-island[\"'^}]*}'\"' \\\"\"'$DEV/src/ui/style.css\"; sed -n '\"'1,120p' \\\"\"'$DEV/tests/browser.py\"; sed -n '\"'180,205p' \\\"\"'$DEV/src/main.js\"; sed -n '\"'1,90p' \\\"\"'$DEV/tests/run.mjs\"; cat \"$DEV/package.json\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_480","type":"command_execution","command":"/bin/bash -lc \"DEV='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; rg -o '\\\\.fallback-island[\"'^}]*}'\"' \\\"\"'$DEV/src/ui/style.css\"; sed -n '\"'1,120p' \\\"\"'$DEV/tests/browser.py\"; sed -n '\"'180,205p' \\\"\"'$DEV/src/main.js\"; sed -n '\"'1,90p' \\\"\"'$DEV/tests/run.mjs\"; cat \"$DEV/package.json\"'","aggregated_output":".fallback-island{position:absolute;width:min(68vw,900px);height:min(30vw,350px);right:4%;top:38%;border-radius:50%;background:#8cbf8d;box-shadow:0 28px 0 #d4b887,0 50px 0 #b99f78,0 60px 70px #4faaa050;transform:rotate(-8deg)}\n.fallback-island:before{content:'';position:absolute;width:36%;height:35%;top:16%;left:32%;background:#f4e7c5;border-radius:50%}\n.fallback-island:after{content:'●';position:absolute;left:47%;top:-25%;font-size:clamp(90px,14vw,200px);color:#5d9f70;text-shadow:-240px 75px 0 #7db681,240px 75px 0 #77b17b}\n.fallback-island i,.fallback-island b,.fallback-island em{position:absolute;width:50px;height:64px;border-radius:9px;background:#fff5db;z-index:1;top:12%;left:38%;box-shadow:inset 0 -10px #ecd9b4}\n.fallback-island b{left:67%;top:20%;transform:rotate(9deg)}\n.fallback-island em{left:17%;top:30%;transform:rotate(-9deg)}\n.fallback-island{width:100vw;height:35vw;right:-15%;top:8%}\n.fallback-island:after{left:43%;top:-60%}\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef complete_week(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        start_profile(page)\n        click(page, 'weigh')\n        for _ in range(3):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n        screen(page, 'weigh-result')\n        assert len(state(page)['profiles'][0]['history']) == 3\n        click(page, 'island')\n        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\nfunction beginHubEvent(index){app.hubEvent=index;const activity=ACTIVITIES.find(item=>item.id===app.hubPicks[index]);begin(activity,{duration:EVENT_SECONDS,random:globalThis.AIHub.rng(`event:${index}`),hard:false,tuning:{...DEFAULT_TUNABLES,timeScale:1}});}\nfunction finishHub(){if(!app.hubRound||app.hubEnded)return;const score=hubScore();app.hubEnded=true;app.hubRound=false;clearInterval(app.hubTimer);globalThis.AIHub.result({score});app.result={score};go('hub-finished');}\nfunction syncHub(){\n  const window=medleyWindow(globalThis.AIHub.time());\n  if(window.phase==='finished'){finishHub();return false;}\n  if(window.index>app.hubEvent){app.hubTotal+=(app.session?.result().score||0)*10;beginHubEvent(window.index);}\n  if(window.phase!=='event'){\n    const seconds=document.getElementById('seconds'),cue=document.getElementById('live-cue');\n    if(seconds)seconds.textContent=Math.ceil(window.remaining);\n    if(cue)cue.textContent=window.phase==='countdown'?'GET READY · STARTING TOGETHER':`EVENT COMPLETE · NEXT IN ${Math.ceil(window.remaining)}`;\n    return false;\n  }\n  return true;\n}\nfunction sendHubState(){if(!app.hubRound||app.hubEnded||!app.session)return;const hub=globalThis.AIHub,score=hubScore();hub.progress({score,label:app.activity.name});hub.send({a:app.hubEvent,x:app.session.dot.x,y:app.session.dot.y,c:0,t:app.session.elapsed,s:score},{reliable:false});}\nfunction setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>{app.hubClosed=false;go('hub-card');});hub.on('start',()=>{app.hubClosed=false;app.hubRound=true;app.hubEnded=false;app.hubScores={};app.hubTotal=0;app.hubPicks=pickMedley(hub.rng('medley'));beginHubEvent(0);clearInterval(app.hubTimer);sendHubState();app.hubTimer=setInterval(sendHubState,100);});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',finishHub);hub.on('end',()=>{clearInterval(app.hubTimer);app.hubRound=false;app.hubEnded=true;app.hubClosed=true;sound.context?.suspend();});hub.connect({mode:'ghost',seats:[1,4],card:true}).then(info=>{if(info)hub.ready();});}\nwindow.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\nrender();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\nimport assert from 'node:assert/strict';\nimport { spawnSync } from 'node:child_process';\nimport { ACTIVITIES, activityForDay } from '../src/data/activities.js';\nimport { Dot, DEFAULT_TUNABLES } from '../src/core/dot.js';\nimport { ActivitySession, makeProfile, wobbleAge } from '../src/core/session.js';\nimport { MEDLEY_SECONDS, medleyWindow, pickMedley } from '../src/data/medley.js';\n\nlet passed = 0;\nconst failures = [];\nfunction test(name, check) {\n  try { check(); passed++; } catch (error) { failures.push(`${name}: ${error.stack || error}`); }\n}\n\ntest('activity catalog and unlocks', () => {\n  assert.equal(ACTIVITIES.length, 16);\n  assert.equal(new Set(ACTIVITIES.map(activity => activity.id)).size, 16);\n  assert.equal(activityForDay(1).length, 4);\n  assert.equal(activityForDay(5).length, 16);\n  assert.equal(activityForDay(7).length, 16);\n});\n\ntest('dot stays finite and bounded', () => {\n  const first = new Dot(() => .25), second = new Dot(() => .25);\n  for (let index = 0; index < 5000; index++) {\n    first.step(.05, Math.sin(index), Math.cos(index), DEFAULT_TUNABLES);\n    second.step(.05, Math.sin(index), Math.cos(index), DEFAULT_TUNABLES);\n    assert.ok(Number.isFinite(first.x) && Number.isFinite(first.y));\n    assert.ok(Math.hypot(first.x, first.y) <= 1.20000001);\n  }\n  assert.deepEqual(first, second);\n});\n\ntest('wobble age reveal corrects seven years', () => {\n  const profile = makeProfile('MABEL');\n  profile.history = [.6, .7, .8];\n  profile.stars = 8;\n  const before = wobbleAge(profile);\n  profile.revealed = true;\n  assert.equal(before - wobbleAge(profile), 7);\n});\n\nfor (const activity of ACTIVITIES) {\n  test(`${activity.id} completes with valid score`, () => {\n    const session = new ActivitySession(activity, { random: () => .25 });\n    for (let frame = 0; !session.finished && frame < 2000; frame++) {\n      const angle = frame * .4;\n      session.update(.05, { x: Math.cos(angle), y: Math.sin(angle), breath: frame % 40 < 20, left: frame % 14 === 0, right: frame % 14 === 7 });\n    }\n    assert.equal(session.finished, true);\n    assert.ok(session.result().score >= 0 && session.result().score <= 100);\n    assert.ok(session.result().stars >= 0 && session.result().stars <= 3);\n    const elapsed = session.elapsed;\n    session.update(.05, {});\n    assert.equal(session.elapsed, elapsed);\n  });\n}\n\ntest('live time tuning changes simulation speed', () => {\n  const normal = new ActivitySession(ACTIVITIES[0], { random: () => 0 });\n  const fast = new ActivitySession(ACTIVITIES[0], { random: () => 0, tuning: { timeScale: 2 } });\n  normal.update(.02); fast.update(.02);\n  assert.equal(fast.elapsed, normal.elapsed * 2);\n});\n\ntest('online medley choices and shared-clock windows', () => {\n  assert.deepEqual(pickMedley(() => 0), ['tree', 'squats', 'header']);\n  assert.deepEqual(pickMedley(() => .999), ['warrior', 'step', 'header']);\n  assert.deepEqual(medleyWindow(-3000), { phase: 'countdown', index: 0, remaining: 3 });\n  assert.deepEqual(medleyWindow(0), { phase: 'event', index: 0, remaining: 55 });\n  assert.deepEqual(medleyWindow(55000), { phase: 'break', index: 0, remaining: 10 });\n  assert.deepEqual(medleyWindow(65000), { phase: 'event', index: 1, remaining: 55 });\n  assert.deepEqual(medleyWindow(120000), { phase: 'break', index: 1, remaining: 10 });\n  assert.deepEqual(medleyWindow(130000), { phase: 'event', index: 2, remaining: 55 });\n  assert.equal(MEDLEY_SECONDS, 185);\n  assert.equal(medleyWindow(185000).phase, 'finished');\n});\n\nconst browser = spawnSync('python3', ['tests/browser.py'], { encoding: 'utf8', env: process.env, timeout: 180000 });\nif (browser.error || browser.status !== 0) {\n  failures.push(`browser runner: ${browser.error?.message || browser.stderr || browser.stdout || `exit ${browser.status}`}`);\n} else {\n  try {\n    const report = JSON.parse(browser.stdout);\n    passed += report.passed;\n    failures.push(...report.failures);\n  } catch (error) { failures.push(`browser report: ${error.message}\\n${browser.stdout}\\n${browser.stderr}`); }\n}\nfor (const failure of failures) console.error(`FAIL ${failure}`);\nconsole.log(`${passed} passed, ${failures.length} failed`);\nif (failures.length) process.exitCode = 1;\n{\"name\":\"a-little-off-balance\",\"version\":\"1.0.0\",\"private\":true,\"type\":\"module\",\"scripts\":{\"build\":\"node tools/build.mjs\",\"test\":\"node tests/run.mjs\"}}\n","exit_code":0,"status":"completed"}}
