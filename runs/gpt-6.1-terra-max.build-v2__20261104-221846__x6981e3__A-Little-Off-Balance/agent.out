:null,hubRound:false,hubEnded:false,hubScores:{},hubClock:0,gamepadButtons:[],driver:null};\nsrc/main.js:42:    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.hubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(app.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div class=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><span class=\"key\">WASD</span> LEAN <span class=\"key\">SPACE</span> BREATHE<br><span class=\"key\">F / J</span> STEP · ESC PAUSE</div></div></div></section>`;\nsrc/main.js:76:function begin(activity,options={}){\nsrc/main.js:79:function finish(){\nsrc/main.js:83:  if(app.hubRound){advanceHub();return;}\nsrc/main.js:125:function pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\nsrc/main.js:131:window.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\nsrc/main.js:134:function frame(now){const dt=Math.min(.05,(now-(app.previous||now))/1000);app.previous=now;sound.update(dt);const pad=gamepad();if(app.screen==='title'&&!globalThis.AIHub?.active&&now-app.lastInput>10000)startAttract();if(app.screen==='game'&&app.session){let x=Number(app.keys.has('d')||app.keys.has('arrowright'))-Number(app.keys.has('a')||app.keys.has('arrowleft'));let y=Number(app.keys.has('s')||app.keys.has('arrowdown'))-Number(app.keys.has('w')||app.keys.has('arrowup'));if(pad&&(Math.abs(pad.axes[0])>.12||Math.abs(pad.axes[1])>.12)){x=pad.axes[0];y=pad.axes[1];}else if(app.inputKind==='mouse'&&app.mouse){x=app.mouse.x;y=app.mouse.y;}if(app.attract){const time=app.session.elapsed;x=app.session.activity.family==='hoop'?Math.cos(time*7):Math.sin(time*1.2)*.2;y=app.session.activity.family==='hoop'?Math.sin(time*7):Math.cos(time)*.2;if(Math.floor(time*3)%2===0)app.input.left=true;else app.input.right=true;}if(app.driver==='perfect'){x=0;y=0;}app.session.update(dt,{x,y,breath:app.keys.has(' ')||!!pad?.buttons[7]?.pressed,left:app.input.left,right:app.input.right});app.input.left=false;app.input.right=false;const dot=document.getElementById('balance-dot'),seconds=document.getElementById('seconds'),meter=document.getElementById('meter'),score=document.getElementById('live-score');if(dot){dot.style.left=`${50+app.session.dot.x*38}%`;dot.style.top=`${50+app.session.dot.y*38}%`;}if(seconds)seconds.textContent=Math.max(0,Math.ceil(app.session.duration-app.session.elapsed));if(meter)meter.style.width=`${Math.min(100,app.session.elapsed/app.session.duration*100)}%`;if(score)score.textContent=`${app.session.result().score} POINTS · ${app.medley?`PLAYER ${app.medley.player+1}`:'KEEP GOING'}`;if(app.hubRound&&now-app.hubClock>500){app.hubClock=now;const partial=app.hubTotal+app.session.result().score;globalThis.AIHub?.progress({score:partial,label:app.activity.name});globalThis.AIHub?.send({x:app.session.dot.x,y:app.session.dot.y,score:partial});}if(app.session.finished)finish();}requestAnimationFrame(frame);}\nsrc/main.js:136:function advanceHub(){if(app.hubEnded)return;app.hubTotal+=app.session.result().score;app.hubEvent++;if(app.hubEvent>=3){app.hubEnded=true;globalThis.AIHub?.result({score:app.hubTotal});app.result={...app.session.result(),score:app.hubTotal,stars:0,drips:0};app.hubRound=false;go('results');}else begin({...ACTIVITIES.find(item=>item.id===['tree','hoop','step'][app.hubEvent])},{duration:20});}\nsrc/main.js:137:function setupHub(){const hub=globalThis.AIHub;if(!hub?.active)return;hub.on('card',()=>go('hub-card'));hub.on('start',()=>{app.hubRound=true;app.hubEnded=false;app.hubEvent=0;app.hubTotal=0;begin({...ACTIVITIES[0]},{duration:20});});hub.on('message',(data,from)=>{app.hubScores[from]=data;});hub.on('time-up',()=>{if(app.hubRound&&!app.hubEnded){app.hubEnded=true;hub.result({score:app.hubTotal+(app.session?.result().score||0)});app.hubRound=false;}});hub.on('end',()=>{app.hubRound=false;app.hubEnded=true;});hub.connect({mode:'ghost',seats:[1,4],card:true});hub.ready();}\nsrc/main.js:138:window.__GAME__={go:(screen,args={})=>{if(args.id)app.activity=ACTIVITIES.find(item=>item.id===args.id);if(screen==='game'&&app.activity)begin(app.activity);else go(screen);},state:()=>({screen:app.screen,day:profile()?.day,activity:app.activity?.id,elapsed:app.session?.elapsed,score:app.session?.result().score,attract:app.attract,profiles:app.profiles,hubScores:app.hubScores}),setDriver:skill=>{app.driver=skill;},get tunables(){return app.tuning;},finishActivity:()=>{if(app.session){app.session.elapsed=app.session.duration;app.session.finished=true;finish();}}};\nsrc/main.js:139:render();setupHub();startWorld(app).catch(error=>{console.warn('3D island unavailable:',error.message);});requestAnimationFrame(frame);\nimport { Dot, DEFAULT_TUNABLES } from './dot.js';\n\nconst clamp=(value,low,high)=>Math.max(low,Math.min(high,value));\nexport function makeProfile(name='PLAYER') {return {name,day:1,drips:0,stars:0,history:[],played:{},goal:'FIND YOUR BALANCE',revealed:false,completedDays:[]};}\nexport function wobbleAge(profile) {\n  const scores=profile.history.slice(-3);\n  const average=scores.length?scores.reduce((sum,value)=>sum+value,0)/scores.length:.5;\n  return clamp(Math.round(20+60*(1-average)-Math.min(20,profile.stars*.5)),18,95)+(profile.revealed?0:7);\n}\nexport class ActivitySession {\n  constructor(activity,options={}) {\n    this.activity=activity; this.hard=!!options.hard; this.duration=options.duration??activity.duration;\n    this.dot=new Dot(options.random); this.elapsed=0; this.points=0; this.samples=0; this.breathSync=.5;\n    this.rep=.0; this.hoopLift=.65; this.lastAngle=null; this.angleSpeed=0; this.goodSteps=0; this.lastStep=-2; this.hits=0;\n    this.tuning={...DEFAULT_TUNABLES,...options.tuning}; this.finished=false; this.distance=0; this.lastDirection=0;\n    this.eventCount=0; this.lastBeat=-1; this.notes=[];\n  }\n  update(dt,input={}) {\n    if(this.finished)return;\n    dt=clamp(dt*(this.tuning.timeScale??1),0,.1); this.elapsed+=dt;\n    const {x=0,y=0,breath=false,left=false,right=false}=input;\n    const family=this.activity.family, t=this.elapsed;\n    const breathIn=this.activity.breath?Math.sin(t*Math.PI*2/this.activity.breath)>0:false;\n    if(this.activity.breath) this.breathSync+=(Number(breath===breathIn)-this.breathSync)*Math.min(1,dt*2);\n    const modifiers={noise:this.activity.breath?1.25-.55*this.breathSync:1};\n    if(this.activity.id==='heron')modifiers.bx=.12*Math.sin(t*.7);\n    if(this.activity.id==='tax')modifiers.bx=.18*Math.sin(t*.9);\n    if(this.activity.id==='chair')modifiers.noise*=1+.5*t/this.duration;\n    if(this.activity.id==='plank')modifiers.inst=1.2;\n    this.dot.step(dt,x,y,this.tuning,modifiers);\n    const distance=Math.hypot(this.dot.x,this.dot.y);\n    let quality=0;\n    if(family==='still'||family==='tray'||family==='slack'||family==='jump'){\n      const ring=(this.activity.ring??(family==='slack'?.32:.48))*(this.hard?.8:1);\n      quality=distance<ring?1:0;\n      if(this.activity.breath)quality=.8*quality+.2*this.breathSync;\n      if(family==='slack'){\n        if((left||right)&&t-this.lastStep>.14){this.lastStep=t;this.goodSteps++;this.distance+=distance<.75?1:.15;}\n        quality*=.45+.55*clamp(this.goodSteps/(t*1.5),0,1);\n      }\n      if(family==='jump'&&breath&&t-this.lastStep>2){this.lastStep=t;this.goodSteps++;this.distance+=distance<.6?1:0;}\n      if(family==='jump') quality*=.5+.5*clamp(this.goodSteps/Math.max(1,t/5),0,1);\n    } else if(family==='reps'){\n      const phase=(t/3.2)%1;\n      const target=phase<.4?phase/.4:phase<.55?1:phase<.9?1-(phase-.55)/.35:0;\n      const requested=this.activity.id==='lunges'?Math.abs(x):this.activity.id==='mortgage'?Math.max(0,y):Math.max(0,-y);\n      this.rep+=(requested-this.rep)*Math.min(1,dt/((this.activity.id==='mortgage'?.15:.10)));\n      quality=clamp(1-1.6*Math.abs(this.rep-target),0,1);\n    } else if(family==='hoop'){\n      const magnitude=Math.hypot(x,y);\n      if(magnitude>.5){const angle=Math.atan2(y,x);if(this.lastAngle!==null){let delta=angle-this.lastAngle;while(delta>Math.PI)delta-=Math.PI*2;while(delta< -Math.PI)delta+=Math.PI*2;this.angleSpeed+=(Math.abs(delta)/Math.max(dt,.001)-this.angleSpeed)*Math.min(1,dt/.25);}this.lastAngle=angle;}else{this.angleSpeed*=Math.max(0,1-dt*3);this.lastAngle=null;}\n      const inBand=this.angleSpeed>4.5&&this.angleSpeed<18;\n      this.hoopLift=clamp(this.hoopLift+(inBand?.35:-.15)*dt,0,1);quality=this.hoopLift;\n    } else if(family==='step'||family==='jog'){\n      const beat=Math.floor(t/.7);\n      if(beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;}\n      if((left||right)&&t-this.lastStep>.12){const side=left?-1:1;const phase=Math.abs((t/.7)-Math.round(t/.7));if(family==='jog'?side!==this.lastDirection:phase<.23){this.goodSteps++;}this.lastDirection=side;this.lastStep=t;}\n      quality=clamp(this.goodSteps/Math.max(1,this.eventCount-1),0,1);\n    } else if(family==='header'){\n      const beat=Math.floor(t/2.4);\n      if(beat!==this.lastBeat){this.lastBeat=beat;this.eventCount++;const target=beat%2===0?-1:1;if(Math.sign(x)===target)this.hits++;}\n      quality=this.hits/Math.max(1,this.eventCount);\n    }\n    this.points+=quality*dt;this.samples+=dt;\n    if(this.elapsed>=this.duration)this.finished=true;\n  }\n  result(){const score=Math.round(100*this.points/Math.max(.001,this.samples));const thresholds=this.activity.family==='reps'?[55,75,90]:[45,70,90];const stars=thresholds.filter(value=>score>=value).length;return {score,stars,drips:2+stars*3+Math.floor(this.duration/30),seconds:this.duration};}\n}\n{\"name\":\"a-little-off-balance\",\"version\":\"1.0.0\",\"private\":true,\"type\":\"module\",\"scripts\":{\"build\":\"node tools/build.mjs\",\"test\":\"node tests/run.mjs\"}}\n","exit_code":0,"status":"completed"}}
