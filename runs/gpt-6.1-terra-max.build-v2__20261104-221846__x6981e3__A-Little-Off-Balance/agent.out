{"type":"item.started","item":{"id":"item_145","type":"command_execution","command":"/bin/bash -lc \"D='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; sed -n '37,72p' \\\"\"'$D/src/main.js\" | fold -w 180; sed -n '\"'120,132p' \\\"\"'$D/src/main.js\" | fold -w 180; sed '\"'s/}/}\\\\n/g' \\\"\"'$D/src/ui/style.css\" | head -100'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_145","type":"command_execution","command":"/bin/bash -lc \"D='A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846'; sed -n '37,72p' \\\"\"'$D/src/main.js\" | fold -w 180; sed -n '\"'120,132p' \\\"\"'$D/src/main.js\" | fold -w 180; sed '\"'s/}/}\\\\n/g' \\\"\"'$D/src/ui/style.css\" | head -100'","aggregated_output":"    const activity=app.activity;\n    content=panel(`<div class=\"topline\">${back(app.returnScreen||'island')}<span class=\"badge sun\">${escape(activity.place.toUpperCase())}</span></div>${heading('TODAY’S PRACTICE',\nescape(activity.name),escape(activity.instruction)+'.')}<div class=\"instruction-card\"><strong>LET’S KEEP IT SIMPLE</strong><p>Lean with the left stick or WASD. Press Space / R2 to \nbreathe; use F and J / L1 and R1 to step.</p><p>Find your own rhythm. Ounce is not a medical professional, despite the nametag.</p></div><div class=\"menu\">${button('Let’s go','star\nt','','primary')}${button(`Hard mode: ${app.hard?'ON':'OFF'}`,'hard','','ghost')}</div>${footer()}`);\n  }else if(app.screen==='game'){\n    const activity=app.session.activity;\n    content=`<section class=\"screen game-screen\"><div class=\"game-hud\"><div class=\"game-top\"><div class=\"game-title\"><small>${app.attract?'ISLAND DEMO · PRESS ANY KEY TO PLAY':app.\nhubRound?'AI HUB · THREE-EVENT MEDLEY':escape(activity.place.toUpperCase())}</small><strong>${escape(activity.name)}</strong></div><div class=\"game-time\" id=\"seconds\">${Math.ceil(a\npp.session.duration)}</div></div><div class=\"game-bottom\"><div class=\"balance-card\"><div class=\"balance-inner\"><div class=\"dial\" id=\"dial\" aria-label=\"Balance indicator\"><div class\n=\"dial-ring\"></div><div class=\"dot\" id=\"balance-dot\"></div></div><div class=\"balance-text\"><strong>Find your center.</strong><p id=\"live-score\">A little wobble is normal.</p><div c\nlass=\"meter\"><span id=\"meter\" style=\"width:0%\"></span></div></div></div></div><div class=\"game-tip\">${escape(activity.instruction)}<br><span class=\"key\">WASD</span> LEAN <span clas\ns=\"key\">SPACE</span> BREATHE<br><span class=\"key\">F / J</span> STEP · ESC PAUSE</div></div></div></section>`;\n  }else if(app.screen==='pause'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">TAKE YOUR TIME</span></div>${heading('PAUSED','A little breather.','Your island will be right here.')}<div class=\"menu\">\n${button('Resume','resume','','primary')}${button('Settings','settings','','ghost')}${button('Dev tools','dev','','ghost')}${button('Leave practice','leave','','ghost')}</div>${foo\nter()}`);\n  }else if(app.screen==='results'){\n    const result=app.result;\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">PRACTICE COMPLETE</span></div>${heading('NICE WORK',escape(app.activity.name),escape(app.activity.quip||'THE ISLAND \nIS PROUD OF YOU.'))}<div class=\"score-hero\">${result.score}<small style=\"font-size:20px;color:#8ca397\"> / 100</small></div><div class=\"stars\">${'★'.repeat(result.stars)}${'☆'.repea\nt(3-result.stars)}</div><div class=\"result-box\"><span>+ ${result.drips} DRIPS</span><span>${Math.round(result.seconds)} SECONDS OF YOU TIME</span></div><div class=\"menu\">${button(a\npp.medley?'Next player / event':app.weigh?'Continue weigh-in':'Back to the island','continue','','primary')}${!app.medley&&!app.weigh?button('Try again','start','','ghost'):''}</di\nv>${footer()}`);\n  }else if(app.screen==='weigh-result'){\n    content=panel(`<div class=\"topline\"><span class=\"badge\">DAILY CHECK-IN</span></div>${heading('A NUMBER, NOT A VERDICT','Your wobble age','Ounce has reviewed your three balance \nchecks with tremendous confidence.')}<div class=\"score-hero\">${wobbleAge(profile())}</div><p class=\"description\">This is just a playful score, not a measure of health. Keep moving \nat your own pace.</p><div class=\"menu\">${button('Back to the island','island','','primary')}</div>${footer()}`);\n  }else if(app.screen==='day-report'){\n    const player=profile();\n    content=panel(`<div class=\"topline\">${back('island')}<span class=\"badge sun\">DAY ${player.day}</span></div>${heading('YOUR DAY REPORT','Every wobble counts.',`You have collecte\nd ${player.drips} drips and ${player.stars} stars. You showed up; the rest is gravy.`)}<div class=\"instruction-card\"><strong>OUNCE’S NOTE</strong><p>${player.day===6?'Tomorrow is t\nhe Long Stand. Ounce seems unusually quiet.':player.day>=7?'The island is still yours to enjoy.':'A little movement is better than a perfectly planned nap. Usually.'}</p></div><div\n class=\"menu\">${button(player.day>=7?'Back to the island':'Start the next day','next-day','','primary')}</div>${footer()}`);\n  }else if(app.screen==='reveal'){\n    content=panel(`${brand}${heading('THE LONG STAND','Ounce comes clean.','“I added seven years to everyone’s wobble age. I thought you would come back if the number worried you. \nThat was wrong.”')}<p class=\"description\" style=\"margin-top:16px\">The island agrees: a number should never tell you your worth. Your wobble age is now honest, and the island remain\ns open.</p><div class=\"menu\">${button('A fresh start','island','','primary')}</div>`);\n  }else if(app.screen==='family'){\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">LOCAL MULTIPLAYER</span></div>${heading('PASS THE CONTROLLER','Family Hour','One to four players take tu\nrns through a three-event medley. Highest total wins; kindness is mandatory.')}<div class=\"stack\">${[1,2,3,4].map(number=>button(`${number} ${number===1?'player':'players'}`,'famil\ny-start',`data-count=\"${number}\"`,number===2?'primary':'ghost')).join('')}</div>${footer()}`);\n  }else if(app.screen==='medley-board'){\n    const ranking=app.medley.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n    content=panel(`<div class=\"topline\"><span class=\"badge sun\">FAMILY HOUR</span></div>${heading('MEDLEY COMPLETE','A standing ovation.','Every player gets a turn in the spotlight\n.')}<div class=\"stack\">${ranking.map((entry,index)=>`<div class=\"list-item\"><span class=\"icon\">${index+1}</span><span><span class=\"name\">PLAYER ${entry.index+1}</span><span class=\"\nsub\">${entry.score} POINTS</span></span></div>`).join('')}</div><div class=\"menu\">${button('Back to title','title','','primary')}</div>`);\n  }else if(app.screen==='settings'||app.screen==='dev'){\n    const dev=app.screen==='dev';\n    const ranges=dev?Object.entries(app.tuning).map(([key,value])=>`<div class=\"field\"><label for=\"${key}\">${escape(key)}</label><input id=\"${key}\" data-tune=\"${key}\" type=\"range\" \nmin=\"${key==='timeScale'?.25:0}\" max=\"${key==='timeScale'?4:key==='dotLag'?.5:8}\" step=\".01\" value=\"${value}\"></div>`).join(''):`<div class=\"field\"><label for=\"music\">Music ${Math.\nround(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label \nfor=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effec\nts}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='ps'?'selected':''}\n>PlayStation</option><option value=\"xbox\" ${app.settings.glyphs==='xbox'?'selected':''}>Xbox</option></select></div><div class=\"field\"><label for=\"contrast\">High contrast</label><i\nnput id=\"contrast\" data-setting=\"contrast\" type=\"checkbox\" ${app.settings.contrast?'checked':''}></div><div class=\"field\"><label for=\"motion\">Reduce motion</label><input id=\"motion\n\" data-setting=\"motion\" type=\"checkbox\" ${app.settings.motion?'checked':''}></div>`;\n    content=panel(`<div class=\"topline\">${back('settings-back')}<span class=\"badge\">${dev?'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>${heading(dev?'DEVELOPER TOOLS':'YO\nUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\"stack\">${rang\nes}</div><div class=\"menu\">${dev?button('Reset tuning','reset-tuning','','ghost'):''}${button('Done','settings-back','','primary')}</div>${footer()}`);\n  }else if(app.screen==='about'){\n    const section=(title,entries)=>`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('')}`;\n    content=panel(`<div class=\"topline\">${back('title')}<span class=\"badge\">CREDITS</span></div>${heading('THE FINE PRINT','About the island','A Little Off Balance is a playful tri\nbute, not medical advice.')}<div class=\"about-text\">${section('Source Information',Object.entries(about.sourceInformation).map(([key,value])=>`${key}: ${value}`))}${section('Testin\ng Feedback',about.testingFeedback)}${section('Engine Feedback',about.engineFeedback)}${section('Prompt Feedback',about.promptFeedback)}</div>${footer()}`);\n  }else if(app.screen==='hub-card'){\n    content=panel(`${brand}${heading('AI HUB · GHOST MEDLEY','Ready to wobble?','Three events, one shared clock. Earn points and watch your fellow islanders as ghosts.')}<div class\n=\"menu\">${button('Ready','hub-ready','','primary')}${button('I need more time','hub-more','','ghost')}</div>${footer()}`);\n  }\n  ui.innerHTML=content;\n  app.focus=0;\n  const first=ui.querySelector('button:not(:disabled)');if(first&&app.inputKind==='gamepad')first.classList.add('focused');\n}\nui.addEventListener('click',event=>{const target=event.target.closest('[data-action]');if(target)act(target.dataset.action,target);});\nui.addEventListener('pointerover',event=>{const target=event.target.closest('button');if(target){ui.querySelectorAll('button.focused').forEach(item=>item.classList.remove('focused'\n));target.classList.add('focused');app.focus=Array.from(ui.querySelectorAll('button:not(:disabled)')).indexOf(target);}});\nui.addEventListener('input',event=>{const target=event.target;if(target.dataset.setting){const key=target.dataset.setting;app.settings[key]=target.type==='checkbox'?target.checked:\ntarget.type==='range'?Number(target.value):target.value;save();document.body.classList.toggle('high-contrast',app.settings.contrast);document.body.classList.toggle('reduce-motion',\napp.settings.motion);}if(target.dataset.tune){app.tuning[target.dataset.tune]=Number(target.value);if(app.session)app.session.tuning={...app.tuning};}});\nfunction menuMove(delta){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));if(!buttons.length)return;app.focus=(app.focus+delta+buttons.length)%buttons.length;\nbuttons.forEach((item,index)=>item.classList.toggle('focused',index===app.focus));buttons[app.focus].focus();buttons[app.focus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(app.screen==='game'&&!app.attract&&!app.hubRound){app.paused=true;go('pause');}else if(app.screen==='pause')act('resume');}\nwindow.addEventListener('keydown',event=>{app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}const key=event.key.toLower\nCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key\n==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'|\n|key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.foc\nus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nwindow.addEventListener('keyup',event=>app.keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur',()=>app.keys.clear());\nwindow.addEventListener('pointerdown',event=>{app.lastInput=performance.now();if(app.attract){leaveAttract();return;}sound.unlock();if(event.pointerType==='mouse')app.inputKind='mo\nuse';});\nui.addEventListener('pointermove',event=>{if(app.screen!=='game'||event.pointerType!=='mouse')return;const dial=event.target.closest('#dial');if(!dial)return;const rect=dial.getBou\nndingClientRect();app.mouse={x:Math.max(-1,Math.min(1,(event.clientX-rect.left-rect.width/2)/(rect.width/2))),y:Math.max(-1,Math.min(1,(event.clientY-rect.top-rect.height/2)/(rect.\nheight/2)))};app.lastInput=performance.now();});\nwindow.addEventListener('gamepadconnected',()=>{app.lastInput=performance.now();if(app.screen==='title')render();});\n\nfunction gamepad(){const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(inde\nx)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1)\n;if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.\ninput.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='g\namepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\n:root{font-family:'DM Sans',system-ui,sans-serif;color:#253e43;background:#cce8dc;font-synthesis:none;--ink:#253e43;--cream:#fbfaf0;--mint:#dcefe4;--orange:#ef795f;--yellow:#f7c96f;--line:#d3e0d8}\n*{box-sizing:border-box}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden}\nbutton,input,select{font:inherit}\nbutton{cursor:pointer}\nbutton:focus-visible,input:focus-visible,select:focus-visible{outline:4px solid #f19d5d;outline-offset:3px}\n#world,#ui{position:fixed;inset:0}\n#world{background:linear-gradient(155deg,#deefe4 0%,#c5e6dc 54%,#8dcfca 100%);overflow:hidden}\n#world canvas{display:block;width:100%;height:100%}\n#ui{z-index:2;overflow:hidden;pointer-events:none}\n.screen{position:absolute;inset:0;display:flex;align-items:center;padding:clamp(20px,4vw,64px);pointer-events:none}\n.screen>*{pointer-events:auto}\n.panel{width:min(550px,100%);max-height:100%;overflow:auto;scrollbar-width:thin;scrollbar-color:#a8bfb2 transparent}\n.glass{background:rgba(251,250,240,.96);border:1px solid rgba(255,255,255,.8);border-radius:28px;box-shadow:0 18px 60px #285a4c1c;padding:clamp(22px,3vw,40px)}\n.brand{display:inline-flex;align-items:center;gap:9px;font:700 13px 'Fredoka',sans-serif;letter-spacing:.13em;text-transform:uppercase;color:#558477}\n.brand-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:10px;background:var(--ink);color:#fff5dd;font-size:16px}\n.eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#73988a}\n.title{font:600 clamp(54px,7.5vw,100px)/.91 'Fredoka',system-ui,sans-serif;letter-spacing:-.055em;margin:30px 0 16px;color:#294943}\n.title span{color:#e97960}\n.lede{font-size:clamp(15px,1.5vw,18px);line-height:1.5;color:#607b70;max-width:390px}\n.title-tag{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:#f7dca2;font-size:10px;font-weight:700;letter-spacing:.12em;color:#785c29;text-transform:uppercase}\n.title-tag:before{content:'';width:7px;height:7px;background:#e98d5e;border-radius:100%}\n.menu{display:grid;gap:9px;margin-top:27px}\n.button{min-height:54px;border:0;border-radius:15px;padding:13px 18px;display:flex;align-items:center;gap:12px;text-align:left;font-weight:700;color:var(--ink);background:#e8f1e8;transition:transform .15s,background .15s,box-shadow .15s}\n.button:hover,.button.focused{transform:translateX(4px);background:#dcece0}\n.button.primary{color:#fff;background:#ef795f;box-shadow:0 5px 0 #d86350}\n.button.primary:hover,.button.primary.focused{background:#e76a52}\n.button .arrow{margin-left:auto;font-size:19px;font-weight:400}\n.button.small{min-height:42px;padding:9px 14px;font-size:13px;border-radius:11px}\n.button.ghost{background:#f2f4e9}\n.menu-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}\n.footnote{margin-top:23px;display:flex;gap:12px;align-items:center;color:#779288;font-size:11px;font-weight:700;letter-spacing:.05em}\n.key{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 6px;border:1px solid #bed0c4;border-radius:7px;background:#fff;font-size:11px;color:#49685c}\n.hero-note{position:absolute;right:6vw;bottom:6vh;text-align:right;color:#fff;text-shadow:0 1px 10px #28574e65;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;line-height:1.7}\n.hero-note strong{font:500 29px/1.2 'Fredoka',sans-serif;letter-spacing:0;display:block;text-transform:none}\n.topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}\n.back{border:0;background:#e9f1e8;color:#456b5c;border-radius:50%;width:40px;height:40px;font-size:19px}\n.heading{font:600 clamp(31px,4vw,45px)/1 'Fredoka',sans-serif;letter-spacing:-.035em;margin:6px 0 10px}\n.description{margin:0;color:#6b8378;line-height:1.5;font-size:14px}\n.stack{display:grid;gap:9px;margin-top:22px}\n.list-item{position:relative;border:1px solid #e1e9de;border-radius:16px;background:#fff;min-height:66px;padding:12px 14px;display:flex;align-items:center;text-align:left;gap:12px;width:100%;color:var(--ink)}\n.list-item:hover,.list-item.focused{border-color:#ef9f88;box-shadow:0 3px 0 #f5c3b0}\n.list-item:disabled{opacity:.52;cursor:not-allowed}\n.list-item .icon{flex:none;width:41px;height:41px;border-radius:13px;display:grid;place-items:center;background:#dcefe5;font-size:21px}\n.list-item .name{display:block;font:600 16px 'Fredoka',sans-serif}\n.list-item .sub{display:block;color:#89a094;font-size:11px;margin-top:3px}\n.list-item .arrow{margin-left:auto;color:#98afa1}\n.badge{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:#e5f0e6;color:#658679}\n.badge.sun{background:#ffefd2;color:#a2752c}\n.badge.coral{background:#ffebe4;color:#c96951}\n.scroll-list{max-height:min(45vh,400px);overflow:auto;padding:1px 4px 4px 1px}\n.profile-card{display:flex;align-items:center;gap:12px}\n.profile-avatar{height:44px;width:44px;border-radius:50%;background:#f3c394;display:grid;place-items:center;font-size:23px}\n.profile-info strong{font:600 15px 'Fredoka',sans-serif}\n.profile-info small{display:block;color:#86a094;margin-top:3px}\n.island-screen{align-items:stretch}\n.island-screen .panel{width:min(520px,100%)}\n.stats{display:flex;gap:7px;flex-wrap:wrap;margin:16px 0}\n.stats span{padding:7px 10px;border-radius:9px;background:#edf3e9;font-size:11px;font-weight:700;color:#6d8b7d}\n.actions{display:flex;gap:9px;margin-top:18px}\n.actions>*{flex:1}\n.section-label{margin:21px 0 10px;color:#8aa296;font-size:10px;letter-spacing:.14em;text-transform:uppercase;font-weight:700}\n.guide{display:flex;gap:13px;align-items:flex-start;background:#e5f1e7;padding:14px;border-radius:15px;margin-top:21px}\n.ounce{flex:none;width:45px;height:40px;border-radius:13px 13px 16px 16px;background:#fdfcf3;box-shadow:inset 0 -5px 0 #dce3d9;position:relative}\n.ounce:before{content:'• ᴗ •';position:absolute;left:6px;top:11px;white-space:nowrap;color:#6e8f80;font-size:12px}\n.guide p{margin:0;color:#618071;font-size:13px;line-height:1.4}\n.game-screen{display:block;padding:0}\n.game-hud{position:absolute;inset:0;padding:clamp(16px,3vw,38px);display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}\n.game-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}\n.game-title{background:#fbfaf0ed;border-radius:18px;padding:14px 18px;box-shadow:0 8px 26px #214f3f1a;max-width:min(410px,60vw)}\n.game-title strong{display:block;font:600 clamp(18px,2.6vw,27px) 'Fredoka',sans-serif}\n.game-title small{font-size:10px;letter-spacing:.11em;color:#8ba195;font-weight:700}\n.game-time{background:#fbfaf0ed;border-radius:18px;padding:12px 18px;text-align:center;font:600 30px 'Fredoka',sans-serif}\n.game-time small{display:block;font:700 9px 'DM Sans',sans-serif;letter-spacing:.15em;color:#8ba195}\n.game-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:15px}\n.balance-card{background:#fbfaf0f5;border-radius:24px;padding:15px 20px;box-shadow:0 8px 30px #214f3f20;pointer-events:auto}\n.balance-inner{display:flex;align-items:center;gap:18px}\n.dial{width:clamp(125px,18vw,210px);aspect-ratio:1;position:relative;border-radius:50%;background:radial-gradient(circle,#f9fbf2 0 28%,#dceee2 28.5% 29.5%,#edf5e9 30% 58%,#c8e0d2 58.5% 59.5%,#f5f8ee 60%);border:2px solid #d5e6d9;touch-action:none}\n.dial:before,.dial:after{content:'';position:absolute;background:#bdd7c8;opacity:.65}\n.dial:before{height:1px;left:0;right:0;top:50%}\n.dial:after{width:1px;top:0;bottom:0;left:50%}\n.dot{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px;border-radius:50%;background:#f2765c;border:3px solid white;box-shadow:0 2px 5px #d47e6770;z-index:1}\n.balance-text{width:125px}\n.balance-text strong{font:600 19px/1.1 'Fredoka',sans-serif}\n.balance-text p{font-size:11px;line-height:1.5;color:#789184}\n.meter{height:8px;border-radius:8px;background:#dbe8dd;overflow:hidden;margin-top:9px}\n.meter span{height:100%;display:block;background:#ed856a;border-radius:8px;transition:width .1s}\n.game-tip{background:#fbfaf0ed;border-radius:15px;padding:12px 15px;color:#729084;font-weight:700;font-size:11px;line-height:1.6;text-align:right}\n.game-tip .key{margin:0 2px}\n.score-hero{font:600 clamp(60px,9vw,94px)/1 'Fredoka',sans-serif;letter-spacing:-.04em;color:#e77c61;margin:18px 0 0}\n.stars{color:#f3bb53;font-size:31px;letter-spacing:4px}\n.result-box{display:flex;justify-content:space-between;gap:10px;border-top:1px solid #e3e9df;margin-top:18px;padding-top:17px;font-size:13px;color:#718b7e}\n.field{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 0;border-bottom:1px solid #e8eee5}\n.field label{font-weight:700;font-size:13px}\n.field input[type=range]{width:46%;accent-color:#ee8165}\n.field select{border:1px solid #d7e5d8;background:white;border-radius:9px;padding:7px}\n.field input[type=text]{width:62%;border:1px solid #d7e5d8;background:white;border-radius:9px;padding:10px;color:#34564a}\n.about-text{font-size:13px;line-height:1.6;color:#607a6d}\n.about-text h3{color:#355a4a;font:600 17px 'Fredoka',sans-serif;margin:20px 0 5px}\n.about-text p{margin:0 0 9px}\n","exit_code":0,"status":"completed"}}
