\"></div>`).join('\"''):\"'`<div class=\"field\"><label for=\"music\">Music ${Math.round(app.settings.music*100)}%</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.music}\"></div><div class=\"field\"><label for=\"effects\">Effects ${Math.round(app.settings.effects*100)}%</label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${app.settings.effects}\"></div><div class=\"field\"><label for=\"glyphs\">Controller prompts</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${app.settings.glyphs==='\"'ps'?'selected':''}>PlayStation</option><option value=\\\"xbox\\\" \"'${app.settings.glyphs==='\"'xbox'?'selected':''}>Xbox</option></select></div><div class=\\\"field\\\"><label for=\\\"contrast\\\">High contrast</label><input id=\\\"contrast\\\" data-setting=\\\"contrast\\\" type=\\\"checkbox\\\" \"'${app.settings.contrast?'\"'checked':''}></div><div class=\\\"field\\\"><label for=\\\"motion\\\">Reduce motion</label><input id=\\\"motion\\\" data-setting=\\\"motion\\\" type=\\\"checkbox\\\" \"'${app.settings.motion?'\"'checked':''}></div>\"'`;\n+    content=panel(`<div class=\"topline\">${back('\"'settings-back')}<span class=\\\"badge\\\">\"'${dev?'\"'LIVE TUNING':'MAKE YOURSELF COMFORTABLE'}</span></div>\"'${heading(dev?'\"'DEVELOPER TOOLS':'YOUR PREFERENCES',dev?'Tune the wobble.':'Settings',dev?'Changes apply immediately, including during a paused practice.':'Make the island feel like yours.')}<div class=\\\"stack\\\">\"'${ranges}</div><div class=\"menu\">${dev?button('\"'Reset tuning','reset-tuning','','ghost'):''}\"'${button('\"'Done','settings-back','','primary')}</div>\"'${footer()}`);\n+  }else if(app.screen==='\"'about'){\n+    const section=(title,entries)=>\"'`<h3>${title}</h3>${entries.map(entry=>`<p>${escape(entry)}</p>`).join('\"'')}\"'`;\n+    content=panel(`<div class=\"topline\">${back('\"'title')}<span class=\\