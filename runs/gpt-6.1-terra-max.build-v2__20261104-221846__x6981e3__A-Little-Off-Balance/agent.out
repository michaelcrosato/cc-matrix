 Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js:149:window.addEventListener('keydown',event=>{if(app.screen!=='family'||event.repeat)return;const key=event.key.toLowerCase();if(!['enter',' ','b','escape'].includes(key))return;event.preventDefault();event.stopImmediatePropagation();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(key==='enter')familyJoin('keyboard');else if(key==='b')familyJoin('bot');else if(key===' '&&app.medley.members.length)startMedley();else if(key==='escape')act('title');},true);\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js:150:window.addEventListener('keydown',event=>{if(app.hubClosed)return;const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;if(app.screen==='hub-card'&&(key==='enter'||key==='m')){event.preventDefault();globalThis.AIHub?.answer(key==='m'?'more':'ready');return;}app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(!['INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/main.js:157:function gamepad(){if(app.medley&&['family','game'].includes(app.screen))return null;const pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(!pad)return null;const down=index=>!!pad.buttons[index]?.pressed;const just=index=>down(index)&&!app.gamepadButtons[index];if(just(9)){app.lastInput=performance.now();app.inputKind='gamepad';pause();}if(app.screen==='hub-card'&&just(3))globalThis.AIHub?.answer('more');if(app.screen!=='game'){if(just(12))menuMove(-1);if(just(13))menuMove(1);if(just(0)){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}if(just(1))ui.querySelector('.back')?.click();}else{if(just(4))app.input.left=true;if(just(5))app.input.right=true;}if(pad.axes.some(value=>Math.abs(value)>.2)||pad.buttons.some(item=>item.pressed)){app.lastInput=performance.now();app.inputKind='gamepad';if(app.attract){leaveAttract();return null;}}app.gamepadButtons=pad.buttons.map(item=>item.pressed);return pad;}\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/data/about.js:1:export const about = {\nA Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846/src/data/about.js:16:  aiHub:{name:'A Little Off Balance',tagline:'A very serious game about a very wobbly week.',description:'Balance, breathe, and bravely face a talking scale on a cozy island. Play a week of delightfully questionable fitness or challenge friends in a three-event medley.',type:'Game',genre:'Sports',source:'Wii Fit',series:'Wii Fit',players:'1–4',controls:'Left stick / WASD: lean; R2 / Space: breathe; L1/R1 or F/J: step; Escape / Options: pause.',tags:['3d','sports','comedy','arcade','versus']}\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport threading\nimport traceback\nimport urllib.parse\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nFILENAME = 'A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html'\npassed = 0\nfailures = []\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n\ndef check(name, operation):\n    global passed\n    try:\n        operation()\n        passed += 1\n    except Exception:\n        failures.append(name + ': ' + traceback.format_exc())\n\n\ndef state(page):\n    return page.evaluate('window.__GAME__.state()')\n\n\ndef screen(page, expected):\n    page.wait_for_function('(expected) => window.__GAME__.state().screen === expected', arg=expected, timeout=5000)\n\n\ndef click(page, action, extra=''):\n    page.locator(f'[data-action=\"{action}\"]{extra}').first.click(timeout=5000)\n\n\ndef start_profile(page):\n    click(page, 'slots')\n    click(page, 'slot', '[data-index=\"0\"]')\n    screen(page, 'island')\n\n\ndef finish(page):\n    page.evaluate('window.__GAME__.finishActivity()')\n\n\ndef smoke(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        screen(page, 'title')\n        assert page.title() == 'A Little Off Balance'\n        assert page.locator('text=Failed to start: WebGPU unavailable').count() == 0\n        start_profile(page)\n        click(page, 'intro', '[data-id=\"tree\"]')\n        click(page, 'start')\n        screen(page, 'game')\n        page.wait_for_timeout(100)\n        assert page.locator('#live-cue').inner_text()\n        page.keyboard.press('Escape')\n        screen(page, 'pause')\n        click(page, 'resume')\n        screen(page, 'game')\n        finish(page)\n        screen(page, 'results')\n        click(page, 'continue')\n        screen(page, 'island')\n        click(page, 'day-report')\n        click(page, 'next-day')\n        assert state(page)['day'] == 2\n        page.reload(wait_until='load')\n        start_profile(page)\n        assert state(page)['day'] == 2\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef complete_week(engine, url):\n    browser = engine.launch(headless=True)\n    context = browser.new_context(viewport={'width': 1280, 'height': 800})\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        start_profile(page)\n        click(page, 'weigh')\n        for _ in range(3):\n            screen(page, 'game')\n            page.wait_for_timeout(25)\n            finish(page)\n        screen(page, 'weigh-result')\n        assert len(state(page)['profiles'][0]['history']) == 3\n        click(page, 'island')\n        for activity in ['tree', 'heron', 'squats', 'hoop', 'header', 'lunges', 'warrior', 'step', 'slackline', 'chair', 'tray', 'mortgage', 'tax', 'jog', 'pier', 'plank']:\n            page.evaluate('(id) => window.__GAME__.go(\"game\", {id})', activity)\n            screen(page, 'game')\n            page.wait_for_timeout(35)\n            assert page.locator('#live-cue').inner_text(), activity\n            finish(page)\n            screen(page, 'results')\n            click(page, 'continue')\n        for day in range(2, 8):\n            click(page, 'day-report')\n            click(page, 'next-day')\n            assert state(page)['day'] == day\n        click(page, 'finale')\n        click(page, 'start')\n        finish(page)\n        screen(page, 'reveal')\n        assert state(page)['profiles'][0]['revealed'] is True\n        assert not errors, errors\n    finally:\n        context.close()\n        browser.close()\n\n\ndef family(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        click(page, 'family')\n        click(page, 'family-join')\n        click(page, 'family-bot')\n        assert state(page)['family']['players'] == 2\n        click(page, 'family-start')\n        for event in range(3):\n            screen(page, 'game')\n            assert state(page)['family']['event'] == event\n            assert page.locator('.family-lane').count() == 2\n            page.wait_for_timeout(25)\n            finish(page)\n            if event < 2:\n                assert state(page)['family']['phase'] == 'break'\n                page.evaluate('window.__GAME__.finishBreak()')\n        screen(page, 'medley-board')\n        assert page.get_by_text('PLAYER 1', exact=True).count() == 1\n        assert page.get_by_text('BOT 2', exact=True).count() == 1\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\ndef family_gamepads(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(url, wait_until='load')\n        page.evaluate('''() => {\n            window.fakePads = Array.from({length: 4}, (_, index) => ({\n                index, axes: [0, 0], connected: true,\n                buttons: Array.from({length: 16}, () => ({pressed: false, value: 0}))\n            }));\n            Object.defineProperty(navigator, 'getGamepads', {configurable: true, value: () => window.fakePads});\n        }''')\n        click(page, 'family')\n        for index in range(4):\n            page.evaluate('(index) => window.fakePads[index].buttons[0].pressed = true', index)\n            page.wait_for_timeout(80)\n            page.evaluate('(index) => window.fakePads[index].buttons[0].pressed = false', index)\n            page.wait_for_timeout(80)\n        assert state(page)['family']['players'] == 4\n        click(page, 'family-start')\n        page.evaluate('window.fakePads[0].axes[0] = 1; window.fakePads[1].axes[0] = -1')\n        page.wait_for_timeout(350)\n        dots = state(page)['family']['dots']\n        assert len(dots) == 4 and abs(dots[0]['x'] - dots[1]['x']) > .02, dots\n        assert page.locator('.family-lane').count() == 4\n        assert not errors, errors\n    finally:\n        browser.close()\n\n\ndef mobile(playwright, url):\n    browser = playwright.webkit.launch(headless=True)\n    context = browser.new_context(**playwright.devices['iPhone 17 Pro'])\n    page = context.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        assert page.get_by_text('Controller or keyboard required').is_visible()\n        assert page.locator('[data-action=\"slots\"]').count() == 0\n        click(page, 'settings')\n        assert page.locator('#music').input_value() == '0.1'\n    finally:\n        context.close()\n        browser.close()\n\n\ndef attract(engine, url):\n    browser = engine.launch(headless=True)\n    page = browser.new_page()\n    try:\n        page.goto(url, wait_until='load')\n        page.wait_for_function('window.__GAME__.state().attract', timeout=13000)\n        page.keyboard.press('Enter')\n        screen(page, 'title')\n    finally:\n        browser.close()\n\n\n.title-screen .glass{padding:clamp(20px,2.5vw,32px)}\n.title{font-size:clamp(48px,5vw,72px);margin:20px 0 12px}\n.title-screen .menu{margin-top:16px}\n.title-screen .footnote{margin-top:14px}\n.game-tip strong{color:#436d5d;letter-spacing:.03em}\n.game-tip .key{white-space:nowrap}\n.ghost-dot{position:absolute;width:14px;height:14px;margin:-7px;border:2px solid white;border-radius:50%;background:#738dd4;opacity:.75;z-index:2;pointer-events:none}\n.fallback-board{position:absolute;left:50%;top:57%;width:clamp(52px,8vw,105px);height:clamp(15px,2.3vw,29px);transform:translate(-50%,-50%) rotate(8deg);border-radius:50%;background:#faf4e3;box-shadow:0 5px 0 #b5b8a6,0 8px 12px #476d5a55;z-index:2}\n.fallback-avatar{position:absolute;left:50%;top:57%;width:clamp(45px,7vw,90px);height:clamp(70px,11vw,138px);transform:translate(-50%,-92%) rotate(calc(8deg + var(--avatar-lean,0deg)));transform-origin:50% 92%;z-index:3}\n.fallback-avatar span{position:absolute;display:block}\n.fallback-head{left:29%;top:0;width:42%;height:29%;border-radius:48%;background:#f2c49e;box-shadow:inset 0 5px #805f50}\n.fallback-head:after{content:'';position:absolute;left:32%;top:50%;width:4%;height:6%;border-radius:50%;background:#405d55;box-shadow:1em 0 #405d55}\n.fallback-body{left:23%;top:25%;width:54%;height:43%;border-radius:40% 40% 30% 30%;background:#e9856c;box-shadow:inset 0 -5px #d77760}\n.fallback-arm{top:30%;width:14%;height:35%;border-radius:30px;background:#efbd9b;transform-origin:50% 10%}\n.fallback-arm.left{left:22%;transform:rotate(45deg)}.fallback-arm.right{right:22%;transform:rotate(-45deg)}\n.fallback-leg{top:62%;width:14%;height:29%;border-radius:20px;background:#46645c}.fallback-leg.left{left:32%;transform:rotate(8deg)}.fallback-leg.right{right:32%;transform:rotate(-8deg)}\n@media(max-width:700px){.title{font-size:clamp(46px,12vw,66px)}.title-screen .glass{padding:22px}}\n@media(max-width:360px){.game-tip .key{font-size:9px;padding:0 4px}}\n.family-roster{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}\n.family-help{font-size:11px;line-height:1.5;color:#71857a}\n.family-game{display:block;overflow:auto;padding:clamp(12px,2.5vw,32px)}\n.family-game-shell{max-width:1100px;margin:0 auto;padding:clamp(14px,2vw,26px);border-radius:24px;background:#fbfaf0ed;box-shadow:0 18px 55px #315d4a24}\n.family-game-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n.family-game-top h1{margin:4px 0;font-size:clamp(24px,3vw,38px);line-height:1.1}\n.family-game-top p{margin:6px 0 16px;font-size:12px;color:#71857a}\n.family-clock{flex:none;text-align:center;color:#547a68}.family-clock strong{display:block;font-size:32px;line-height:1}.family-clock small{font-size:9px;letter-spacing:.1em}\n.family-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px}\n.family-lane{min-width:0;padding:14px;border:1px solid #dce9d9;border-radius:16px;background:#ffffffb8}\n.family-lane-title{display:flex;justify-content:space-between;gap:4px;font-size:11px}.family-lane-title span{font-size:9px;color:#8a9c8b}\n.family-lane-body{display:flex;align-items:center;gap:10px;margin:12px 0}.family-lane-body small{display:block;font-size:9px;color:#8a9c8b}\n.family-dial{flex:none;width:clamp(56px,8vw,100px)}.family-lane p{min-height:2em;margin:0;font-size:10px;line-height:1.3;color:#71857a}\n.family-break{max-width:540px;margin:12px auto}.family-break>strong{font-size:11px;letter-spacing:.12em;color:#8a9c8b}.family-break div{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #dce9d9}\n.family-game-tip{text-align:center;padding:10px;color:#355c4e;font-size:10px;font-weight:700}\n@media(max-width:520px){.family-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.family-dial{width:56px}.family-lane{padding:9px}.family-lane-body{gap:7px;margin:8px 0}.family-game-top p{margin-bottom:10px}.family-game-tip{padding:6px;font-size:9px}}\n","exit_code":0,"status":"completed"}}
