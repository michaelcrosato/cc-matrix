{"type":"item.started","item":{"id":"item_209","type":"command_execution","command":"/bin/bash -lc \"apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: src/main.js\n@@\n import { about } from './data/about.js';\n+import { TITLE } from './data/title.js';\n@@\n-const profile=()=>app.profiles[app.slot];\n+const profile=()=>app.guest||app.profiles[app.slot];\n@@\n-const notice=()=>matchMedia('(hover: none) and (pointer: coarse)').matches&&\"'!navigator.getGamepads?.().some(Boolean);\n+const notice=()=>matchMedia('\"'(hover: none) and (pointer: coarse)').matches&&\"'!app.keyboardSeen&&!Array.from(navigator.getGamepads?.()||[]).some(Boolean);\n@@\n-    content=panel(`${brand}<h1 class=\"title\">A little<br><span>off balance.</span></h1><p class=\"lede\">A week of movement, a talking scale, and absolutely no pressure to be graceful.</p><div class=\"title-tag\">YOUR ISLAND IS READY</div>${notice()?`<p class=\"description\" style=\"margin-top:18px\"><strong>Controller or keyboard required</strong></p><div class=\"menu\">${button('\"'Settings','settings','','ghost')}</div>\"'`:`<div class=\"menu\">${button('\"'Begin your week','slots','','primary')}<div class=\\\"menu-row\\\">\"'${button('\"'Drop-in','dropin','','ghost')}\"'${button('\"'Family Hour','family','','ghost')}</div><div class=\\\"menu-row\\\">\"'${button('\"'Settings','settings','','ghost')}\"'${button('\"'About','about','','ghost')}</div></div>\"'${footer()}`}`,'\"'title-screen')+\"'`<div class=\"hero-note\">WELCOME TO LITTLE ISLAND<strong>Take it one wobble at a time.</strong>EST. WHENEVER YOU ARE READY</div>`;\n+    content=panel(`${brand}<h1 class=\"title\">${escape(TITLE.split('\"' ').slice(0,2).join(' '))}<br><span>\"'${escape(TITLE.split('\"' ').slice(2).join(' '))}.</span></h1><p class=\\\"lede\\\">A week of movement, a talking scale, and absolutely no pressure to be graceful.</p><div class=\\\"title-tag\\\">YOUR ISLAND IS READY</div>\"'${notice()?`<p class=\"description\" style=\"margin-top:18px\"><strong>Controller or keyboard required</strong></p><div class=\"menu\">${button('\"'Settings','settings','','ghost')}</div>\"'`:`<div class=\"menu\">${button('\"'Begin your week','slots','','primary')}<div class=\\\"menu-row\\\">\"'${button('\"'Drop-in','dropin','','ghost')}\"'${button('\"'Family Hour','family','','ghost')}</div><div class=\\\"menu-row\\\">\"'${button('\"'Settings','settings','','ghost')}\"'${button('\"'About','about','','ghost')}</div></div>\"'${footer()}`}`,'\"'title-screen')+\"'`<div class=\"hero-note\">WELCOME TO LITTLE ISLAND<strong>Take it one wobble at a time.</strong>EST. WHENEVER YOU ARE READY</div>`;\n@@\n-  if(action==='\"'title'){app.session=null;app.medley=null;go('title');}\n+  if(action==='title'){app.session=null;app.medley=null;app.guest=null;go('title');}\n@@\n-  else if(action==='slot'){app.slot=Number(element.dataset.index);if(\"'!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('\"'island');}\n-  else if(action==='dropin'){app.slot=0;if(\"'!profile())app.profiles[0]=makeProfile('\"'GUEST');app.returnScreen='island';go('island');}\n+  else if(action==='slot'){app.guest=null;app.slot=Number(element.dataset.index);if(\"'!app.profiles[app.slot])app.profiles[app.slot]=makeProfile(`PLAYER ${app.slot+1}`);save();go('\"'island');}\n+  else if(action==='dropin'){app.guest=makeProfile('GUEST');app.guest.day=7;app.guest.revealed=true;app.returnScreen='island';go('island');}\n*** Update File: src/core/session.js\n@@\n-    dt=clamp(dt,0,.1); this.elapsed+=dt;\n+    dt=clamp(dt*(this.tuning.timeScale??1),0,.1); this.elapsed+=dt;\n*** Update File: tools/build.mjs\n@@\n import {execFileSync} from 'node:child_process';\n+import {TITLE} from '../src/data/title.js';\n+import {about} from '../src/data/about.js';\n@@\n-const css=readFileSync('src/ui/style.css','utf8');\n+const css=readFileSync('src/ui/style.css','utf8')+readFileSync('src/ui/overrides.css','utf8');\n@@\n-<title>A Little Off Balance</title><style>\"'${css}</style></head>\n+<title>${TITLE}</title><style>${css}</style></head>\n@@\n-writeFileSync('\"'../A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846.html',html);\n+writeFileSync(\"'`../${TITLE}-Wii Fit-gpt-6.1-terra-max-20261104-221846.html`,html);\n+writeFileSync('\"'../exit-interview.json',JSON.stringify(about,null,2)+'\\\\n');\n*** Add File: src/ui/overrides.css\n+.title-screen .glass{padding:clamp(20px,2.5vw,32px)}\n+.title{font-size:clamp(48px,5vw,72px);margin:20px 0 12px}\n+.title-screen .menu{margin-top:16px}\n+.title-screen .footnote{margin-top:14px}\n+.game-tip strong{color:#436d5d;letter-spacing:.03em}\n+.ghost-dot{position:absolute;width:14px;height:14px;margin:-7px;border:2px solid white;border-radius:50%;background:#738dd4;opacity:.75;z-index:2;pointer-events:none}\n+@media(max-width:700px){.title{font-size:clamp(46px,12vw,66px)}.title-screen .glass{padding:22px}}\n*** End Patch\nPATCH\napply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: src/main.js\n@@\n-window.addEventListener('keydown',event=>{app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(\"'!['\"'INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\n+window.addEventListener('keydown',event=>{const wasNotice=notice();app.keyboardSeen=true;app.lastInput=performance.now();app.inputKind='keyboard';sound.unlock();if(app.attract){leaveAttract();return;}if(app.screen==='title'&&wasNotice)render();const key=event.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(event.repeat)return;app.keys.add(key);if(app.screen==='game'){if(key==='f')app.input.left=true;if(key==='j')app.input.right=true;if(key==='escape')pause();}else if(\"'!['\"'INPUT','SELECT'].includes(document.activeElement?.tagName)){if(key==='arrowdown'||key==='s')menuMove(1);else if(key==='arrowup'||key==='w')menuMove(-1);else if(key==='enter'){event.preventDefault();const buttons=Array.from(ui.querySelectorAll('button:not(:disabled)'));buttons[app.focus]?.click();}else if(key==='escape'){const backButton=ui.querySelector('.back');if(backButton)backButton.click();else if(app.screen==='pause')pause();}}});\n*** End Patch\nPATCH\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
