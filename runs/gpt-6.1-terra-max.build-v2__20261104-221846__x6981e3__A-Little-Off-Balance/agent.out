nt:space-between;gap:12px;margin-bottom:22px}.back{border:0;background:#e9f1e8;color:#456b5c;border-radius:50%;width:40px;height:40px;font-size:19px}.heading{font:600 clamp(31px,4vw,45px)/1 'Fredoka',sans-serif;letter-spacing:-.035em;margin:6px 0 10px}.description{margin:0;color:#6b8378;line-height:1.5;font-size:14px}.stack{display:grid;gap:9px;margin-top:22px}.list-item{position:relative;border:1px solid #e1e9de;border-radius:16px;background:#fff;min-height:66px;padding:12px 14px;display:flex;align-items:center;text-align:left;gap:12px;width:100%;color:var(--ink)}.list-item:hover,.list-item.focused{border-color:#ef9f88;box-shadow:0 3px 0 #f5c3b0}.list-item:disabled{opacity:.52;cursor:not-allowed}.list-item .icon{flex:none;width:41px;height:41px;border-radius:13px;display:grid;place-items:center;background:#dcefe5;font-size:21px}.list-item .name{display:block;font:600 16px 'Fredoka',sans-serif}.list-item .sub{display:block;color:#89a094;font-size:11px;margin-top:3px}.list-item .arrow{margin-left:auto;color:#98afa1}.badge{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:#e5f0e6;color:#658679}.badge.sun{background:#ffefd2;color:#a2752c}.badge.coral{background:#ffebe4;color:#c96951}.scroll-list{max-height:min(45vh,400px);overflow:auto;padding:1px 4px 4px 1px}.profile-card{display:flex;align-items:center;gap:12px}.profile-avatar{height:44px;width:44px;border-radius:50%;background:#f3c394;display:grid;place-items:center;font-size:23px}.profile-info strong{font:600 15px 'Fredoka',sans-serif}.profile-info small{display:block;color:#86a094;margin-top:3px}.island-screen{align-items:stretch}.island-screen .panel{width:min(520px,100%)}.stats{display:flex;gap:7px;flex-wrap:wrap;margin:16px 0}.stats span{padding:7px 10px;border-radius:9px;background:#edf3e9;font-size:11px;font-weight:700;color:#6d8b7d}.actions{display:flex;gap:9px;margin-top:18px}.actions>*{flex:1}.section-label{margin:21px 0 10px;color:#8aa296;font-size:10px;letter-spacing:.14em;text-transform:uppercase;font-weight:700}.guide{display:flex;gap:13px;align-items:flex-start;background:#e5f1e7;padding:14px;border-radius:15px;margin-top:21px}.ounce{flex:none;width:45px;height:40px;border-radius:13px 13px 16px 16px;background:#fdfcf3;box-shadow:inset 0 -5px 0 #dce3d9;position:relative}.ounce:before{content:'• ᴗ •';position:absolute;left:6px;top:11px;white-space:nowrap;color:#6e8f80;font-size:12px}.guide p{margin:0;color:#618071;font-size:13px;line-height:1.4}.game-screen{display:block;padding:0}.game-hud{position:absolute;inset:0;padding:clamp(16px,3vw,38px);display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}.game-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.game-title{background:#fbfaf0ed;border-radius:18px;padding:14px 18px;box-shadow:0 8px 26px #214f3f1a;max-width:min(410px,60vw)}.game-title strong{display:block;font:600 clamp(18px,2.6vw,27px) 'Fredoka',sans-serif}.game-title small{font-size:10px;letter-spacing:.11em;color:#8ba195;font-weight:700}.game-time{background:#fbfaf0ed;border-radius:18px;padding:12px 18px;text-align:center;font:600 30px 'Fredoka',sans-serif}.game-time small{display:block;font:700 9px 'DM Sans',sans-serif;letter-spacing:.15em;color:#8ba195}.game-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:15px}.balance-card{background:#fbfaf0f5;border-radius:24px;padding:15px 20px;box-shadow:0 8px 30px #214f3f20;pointer-events:auto}.balance-inner{display:flex;align-items:center;gap:18px}.dial{width:clamp(125px,18vw,210px);aspect-ratio:1;position:relative;border-radius:50%;background:radial-gradient(circle,#f9fbf2 0 28%,#dceee2 28.5% 29.5%,#edf5e9 30% 58%,#c8e0d2 58.5% 59.5%,#f5f8ee 60%);border:2px solid #d5e6d9;touch-action:none}.dial:before,.dial:after{content:'';position:absolute;background:#bdd7c8;opacity:.65}.dial:before{height:1px;left:0;right:0;top:50%}.dial:after{width:1px;top:0;bottom:0;left:50%}.dot{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px;border-radius:50%;background:#f2765c;border:3px solid white;box-shadow:0 2px 5px #d47e6770;z-index:1}.balance-text{width:125px}.balance-text strong{font:600 19px/1.1 'Fredoka',sans-serif}.balance-text p{font-size:11px;line-height:1.5;color:#789184}.meter{height:8px;border-radius:8px;background:#dbe8dd;overflow:hidden;margin-top:9px}.meter span{height:100%;display:block;background:#ed856a;border-radius:8px;transition:width .1s}.game-tip{background:#fbfaf0ed;border-radius:15px;padding:12px 15px;color:#729084;font-weight:700;font-size:11px;line-height:1.6;text-align:right}.game-tip .key{margin:0 2px}.score-hero{font:600 clamp(60px,9vw,94px)/1 'Fredoka',sans-serif;letter-spacing:-.04em;color:#e77c61;margin:18px 0 0}.stars{color:#f3bb53;font-size:31px;letter-spacing:4px}.result-box{display:flex;justify-content:space-between;gap:10px;border-top:1px solid #e3e9df;margin-top:18px;padding-top:17px;font-size:13px;color:#718b7e}.field{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 0;border-bottom:1px solid #e8eee5}.field label{font-weight:700;font-size:13px}.field input[type=range]{width:46%;accent-color:#ee8165}.field select{border:1px solid #d7e5d8;background:white;border-radius:9px;padding:7px}.field input[type=text]{width:62%;border:1px solid #d7e5d8;background:white;border-radius:9px;padding:10px;color:#34564a}.about-text{font-size:13px;line-height:1.6;color:#607a6d}.about-text h3{color:#355a4a;font:600 17px 'Fredoka',sans-serif;margin:20px 0 5px}.about-text p{margin:0 0 9px}.toast{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);background:#304c42;color:#fff;border-radius:12px;padding:11px 17px;font-size:12px;font-weight:700;white-space:nowrap}.loading{position:absolute;inset:0;display:grid;place-content:center;text-align:center;font:600 22px 'Fredoka',sans-serif;color:#4b796a}.loading span{font-size:10px;letter-spacing:6px;margin-top:10px}.fallback-island{position:absolute;width:min(68vw,900px);height:min(30vw,350px);right:4%;top:38%;border-radius:50%;background:#8cbf8d;box-shadow:0 28px 0 #d4b887,0 50px 0 #b99f78,0 60px 70px #4faaa050;transform:rotate(-8deg)}.fallback-island:before{content:'';position:absolute;width:36%;height:35%;top:16%;left:32%;background:#f4e7c5;border-radius:50%}.fallback-island:after{content:'●';position:absolute;left:47%;top:-25%;font-size:clamp(90px,14vw,200px);color:#5d9f70;text-shadow:-240px 75px 0 #7db681,240px 75px 0 #77b17b}.fallback-island i,.fallback-island b,.fallback-island em{position:absolute;width:50px;height:64px;border-radius:9px;background:#fff5db;z-index:1;top:12%;left:38%;box-shadow:inset 0 -10px #ecd9b4}.fallback-island b{left:67%;top:20%;transform:rotate(9deg)}.fallback-island em{left:17%;top:30%;transform:rotate(-9deg)}.touch-notice{position:absolute;right:3vw;top:3vw;background:#fff8e6e8;border-radius:12px;padding:10px 14px;font-size:11px;font-weight:700;color:#698678}.high-contrast{--ink:#142925;--line:#6c8073}.high-contrast .description,.high-contrast .lede{color:#355247}.reduce-motion *{transition:none!important;animation:none!important}@media(max-width:700px){.screen{padding:16px;align-items:flex-end}.panel{max-height:calc(100% - 12px)}.glass{padding:23px;border-radius:24px}.title{font-size:clamp(52px,15vw,72px);margin:20px 0 11px}.lede{font-size:14px}.menu{margin-top:18px}.button{min-height:49px}.hero-note{display:none}.fallback-island{width:100vw;height:35vw;right:-15%;top:8%}.fallback-island:after{left:43%;top:-60%}.island-screen{align-items:flex-end}.island-screen .panel{width:100%}.scroll-list{max-height:31vh}.game-hud{padding:14px}.game-title{max-width:70vw}.game-title small{font-size:9px}.game-bottom{align-items:flex-end}.balance-card{padding:10px;border-radius:18px}.balance-inner{gap:9px}.dial{width:120px}.balance-text{width:90px}.balance-text strong{font-size:15px}.balance-text p{font-size:10px}.game-tip{max-width:130px;font-size:10px;padding:9px}.touch-notice{top:12px;right:12px}.footnote{margin-top:14px}.heading{font-size:33px}}@media(max-height:600px) and (min-width:701px){.screen{padding:18px 35px}.glass{padding:22px}.title{font-size:55px;margin:12px 0}.lede{font-size:14px}.menu{margin-top:12px}.button{min-height:43px}.footnote{margin-top:12px}.scroll-list{max-height:34vh}}@media(max-width:360px){.balance-text{display:none}.game-tip{font-size:9px}.title{font-size:48px}.glass{padding:19px}.menu-row{gap:6px}}\n# Progress\n\n## Project\n- Title selected by `crypto.randomInt` from 50 candidates: **A Little Off Balance**.\n- Deliverable basename: `A Little Off Balance-Wii Fit-gpt-6.1-terra-max-20261104-221846`.\n- Read `TASK.md` and `PLAN.md`; downloaded the unmodified Pixel Engine 0.46.0 and AI Hub client into the development folder.\n- Implemented the activity catalog, unstable balance physics, progression, synthesized audio, 3D island, screens, local profiles, family sessions, and AI Hub client integration. The standalone HTML builds successfully.\n\n## Work plan\n1. Read the complete design and integration documentation; obtain the unmodified engine and hub client.\n2. Build the core game, island, activities, progression, input, audio, and multiplayer.\n3. Bundle the standalone HTML, run focused playthrough and viewport tests, and fix findings.\n4. Complete About/Credits, `exit-interview.json`, and this progress record.\n\n## Current checkpoint\n- Source lives in the development folder's `src/`; build the standalone deliverable with `npm run build` there.\n- `npm test` passes 28 checks, including activity simulations, profile/day progression, family play, the WebGPU scene, and Chromium/Firefox/WebKit browser flows.\n- The viewport matrix reports 24 clean phone, foldable, tablet, and desktop configurations. Selected WebKit and Chromium screenshots have been inspected.\n- Fixed an unsupported-WebGPU startup overlay and an oversized title encountered during browser testing.\n- Next: validate the official AI Hub harness and standalone `file://` launch, inspect in-game layouts, address important gaps, and replace interview placeholders.\n- The implementation is a simplified interpretation of the extensive plan: in particular, family play is sequential and the activities share the island scene rather than having full bespoke animated environments.\n\n## Constraints\n- Only work in this directory and the required development subfolder; use OS-assigned localhost ports and stop only our own processes.\n- Keep `pixel-engine.js` unchanged; synthesize audio in code; default music volume 10%.\n- Test small phones, tablets, wide screens, WebKit, and scripted game flows; no physical controller or real iOS device is available.\n","exit_code":0,"status":"completed"}}
