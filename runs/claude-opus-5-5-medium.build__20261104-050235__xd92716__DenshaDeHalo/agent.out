S3', 'S4', 'S5', 'PR']) {\\n    const sg = DH.STAGES[id];\\n    for (let it = 0; it < 3; it++) {\")\ns=s.replace(\"for (const id of ids.length ? ids : ['S0', 'S1', 'S2', 'S3', 'S4', 'S5', 'PR']) {\\n  const run\",\"if (!args.includes('fit')) for (const id of ids.length ? ids : ['S0', 'S1', 'S2', 'S3', 'S4', 'S5', 'PR']) {\\n  const run\")\nopen(p,'w').write(s)\nEOF\nfor s in S1 S2 S3 S4 S5 PR; do (timeout 1500 node tools/calibrate.mjs fit $s > /tmp/dh_fit_$s.txt 2>&1 &); done; echo ok","description":"Run timetable fits in parallel"}}}
