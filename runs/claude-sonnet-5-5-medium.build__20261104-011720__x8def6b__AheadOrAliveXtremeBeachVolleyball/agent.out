{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YR1PvivDEFLTXAkuMaHq7c","type":"tool_result","content":"class Saves {\n  /** game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read }) */\n  constructor(game, o) {\n    o = o && typeof o === 'object' ? o : {};\n    /** game: its game; slots: how many slots besides the autosave (3); version: the game's version of its data (1),\n     *  saved with each save; migrate(data, from): an older version's data brought up to this one (or null: kept as it\n     *  is); write(): what a save holds ({ data, place, level }); read(save): what a load does with { data, place,\n     *  level, time, slot } */\n    this.game = game; this.slots = o.slots || 3; this.version = o.version || 1; this.migrate = o.migrate || null; this.write = o.write || null; this.read = o.read || null;\n    /** canSave: the pause menu offers Save (a JRPG turns it off away from save points); played: seconds played in the\n     *  game's scenes (paused time and titles left out), saved with each save and set by a load; blocked: storage\n     *  refused a save (they last for the visit) */\n    this.canSave = true; this.played = 0; this.blocked = false;\n    this._mem = {};   // each slot's record as text, this visit's (what storage refused stays here)\n  }\n  _key(slot) { return 'save:' + (this.game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game') + ':' + slot; }\n  _ok(slot) { return slot === 'auto' || (Number.isInteger(slot) && slot >= 0 && slot < this.slots); }\n  _raw(slot) {\n    if (slot in this._mem) return this._mem[slot];\n    if (this.game.headless) return null;\n    try { return localStorage.getItem('my3d2dge:' + this._key(slot)); } catch (e) { return null; }\n  }\n  _put(slot, text) {\n    this._mem[slot] = text; if (this.game.headless) return true;\n    try { if (text === null) localStorage.removeItem('my3d2dge:' + this._key(slot)); else localStorage.setItem('my3d2dge:' + this._key(slot), text); return true; }\n    catch (e) { if (!this.blocked) warn('saves:blocked', 'game.saves: storage is blocked or full: the saves last for this visit'); this.blocked = true; return false; }\n  }\n  /** a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer:\n   *  true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version } */\n  get(slot) {\n    if (!this._ok(slot)) return null;\n    const t = this._raw(slot); if (t === null || t === undefined) return null;\n    let s; try { s = JSON.parse(t); } catch (e) { s = null; }\n    if (!s || typeof s !== 'object' || s.v !== SAVE_FORMAT || !('data' in s)) return { slot, damaged: true };\n    const out = { slot, data: s.data, place: typeof s.place === 'string' ? s.place : '', level: s.level === undefined ? null : s.level, time: +s.time || 0, at: +s.at || 0, version: +s.version || 1 };\n    if (out.version > this.version) out.newer = true;\n    return out;\n  }\n  /** every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows) */\n  list() { return ['auto'].concat(Array.from({ length: this.slots }, (_, i) => i)).map(slot => Object.assign({ slot, empty: false }, this.get(slot) || { empty: true })); }\n  /** save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\n   *  (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save */\n  save(slot, o) {\n    if (!this._ok(slot)) { warn('saves:slot:' + slot, 'game.saves: no slot ' + slot + ' (0 to ' + (this.slots - 1) + ', or \"auto\")'); return false; }\n    if (!o && this.write) try { o = this.write(slot); } catch (e) { this.game.fail('saves.write', e); return false; }\n    if (!o || !('data' in o)) { warn('saves:write', 'game.saves: nothing to save: give save(slot, { data, place, level }) or set saves.write'); return false; }\n    let text; try { text = JSON.stringify({ v: SAVE_FORMAT, version: this.version, data: o.data, place: o.place || '', level: o.level === undefined ? null : o.level, time: Math.round(this.played * 10) / 10, at: Date.now() }); }\n    catch (e) { this.game.fail('saves.save', e); return false; }\n    this._put(slot, text); return true;\n  }\n  /** save to the autosave (what write() gives) */\n  autosave(o) { return this.save('auto', o); }\n  /** load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save\n   *  ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version */\n  load(slot) {\n    const s = this.get(slot); if (!s || s.damaged || s.newer) return null;\n    if (s.version < this.version && this.migrate) try { s.data = this.migrate(s.data, s.version); } catch (e) { this.game.fail('saves.migrate', e); return null; }\n    this.played = s.time;\n    if (this.read) try { this.read(s); } catch (e) { this.game.fail('saves.read', e); return null; }\n    return s;\n  }\n  /** copy a slot's save onto another (over what is there); false when the first is empty */\n  copy(from, to) { if (!this._ok(from) || !this._ok(to)) return false; const t = this._raw(from); if (t === null || t === undefined) return false; this._put(to, t); return true; }\n  /** erase a slot */\n  erase(slot) { if (this._ok(slot)) this._put(slot, null); }\n  /** is there any save to load (a title's Continue)? */\n  get any() { return this.list().some(s => !s.empty && !s.damaged && !s.newer); }\n  /** the most recent save that loads, or null (a title's Continue loads it) */\n  latest() { return this.list().filter(s => !s.empty && !s.damaged && !s.newer).sort((a, b) => b.at - a.at)[0] || null; }\n  /** open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or\n   *  a save. False without a menu (a headless game, menu: false) */\n  show(mode = 'load', done) {\n    const sh = this.game.shell; if (!sh || !sh._menu()) return false;\n    const T = s => { const m = Math.floor(s.time / 60); return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0'); };\n    const name = slot => slot === 'auto' ? 'Autosave' : 'Slot ' + (slot + 1);\n    const about = s => s.empty ? 'Empty' : s.damaged ? 'Damaged: it cannot be read' : s.newer ? 'From a newer version of the game' : [s.place, s.level !== null ? 'Level ' + s.level : '', T(s), s.at ? new Date(s.at).toLocaleDateStr","is_error":false}]},"parent_tool_use_id":null,"session_id":"b145291d-9dd6-4001-ae7d-69eaa59b373e","uuid":"d1b9468f-1640-44f0-9892-a44e873e7c75","timestamp":"2026-11-04T08:37:45.334Z","tool_use_result":{"stdout":"class Saves {\n  /** game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read }) */\n  constructor(game, o) {\n    o = o && typeof o === 'object' ? o : {};\n    /** game: its game; slots: how many slots besides the autosave (3); version: the game's version of its data (1),\n     *  saved with each save; migrate(data, from): an older version's data brought up to this one (or null: kept as it\n     *  is); write(): what a save holds ({ data, place, level }); read(save): what a load does with { data, place,\n     *  level, time, slot } */\n    this.game = game; this.slots = o.slots || 3; this.version = o.version || 1; this.migrate = o.migrate || null; this.write = o.write || null; this.read = o.read || null;\n    /** canSave: the pause menu offers Save (a JRPG turns it off away from save points); played: seconds played in the\n     *  game's scenes (paused time and titles left out), saved with each save and set by a load; blocked: storage\n     *  refused a save (they last for the visit) */\n    this.canSave = true; this.played = 0; this.blocked = false;\n    this._mem = {};   // each slot's record as text, this visit's (what storage refused stays here)\n  }\n  _key(slot) { return 'save:' + (this.game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game') + ':' + slot; }\n  _ok(slot) { return slot === 'auto' || (Number.isInteger(slot) && slot >= 0 && slot < this.slots); }\n  _raw(slot) {\n    if (slot in this._mem) return this._mem[slot];\n    if (this.game.headless) return null;\n    try { return localStorage.getItem('my3d2dge:' + this._key(slot)); } catch (e) { return null; }\n  }\n  _put(slot, text) {\n    this._mem[slot] = text; if (this.game.headless) return true;\n    try { if (text === null) localStorage.removeItem('my3d2dge:' + this._key(slot)); else localStorage.setItem('my3d2dge:' + this._key(slot), text); return true; }\n    catch (e) { if (!this.blocked) warn('saves:blocked', 'game.saves: storage is blocked or full: the saves last for this visit'); this.blocked = true; return false; }\n  }\n  /** a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer:\n   *  true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version } */\n  get(slot) {\n    if (!this._ok(slot)) return null;\n    const t = this._raw(slot); if (t === null || t === undefined) return null;\n    let s; try { s = JSON.parse(t); } catch (e) { s = null; }\n    if (!s || typeof s !== 'object' || s.v !== SAVE_FORMAT || !('data' in s)) return { slot, damaged: true };\n    const out = { slot, data: s.data, place: typeof s.place === 'string' ? s.place : '', level: s.level === undefined ? null : s.level, time: +s.time || 0, at: +s.at || 0, version: +s.version || 1 };\n    if (out.version > this.version) out.newer = true;\n    return out;\n  }\n  /** every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows) */\n  list() { return ['auto'].concat(Array.from({ length: this.slots }, (_, i) => i)).map(slot => Object.assign({ slot, empty: false }, this.get(slot) || { empty: true })); }\n  /** save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\n   *  (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save */\n  save(slot, o) {\n    if (!this._ok(slot)) { warn('saves:slot:' + slot, 'game.saves: no slot ' + slot + ' (0 to ' + (this.slots - 1) + ', or \"auto\")'); return false; }\n    if (!o && this.write) try { o = this.write(slot); } catch (e) { this.game.fail('saves.write', e); return false; }\n    if (!o || !('data' in o)) { warn('saves:write', 'game.saves: nothing to save: give save(slot, { data, place, level }) or set saves.write'); return false; }\n    let text; try { text = JSON.stringify({ v: SAVE_FORMAT, version: this.version, data: o.data, place: o.place || '', level: o.level === undefined ? null : o.level, time: Math.round(this.played * 10) / 10, at: Date.now() }); }\n    catch (e) { this.game.fail('saves.save', e); return false; }\n    this._put(slot, text); return true;\n  }\n  /** save to the autosave (what write() gives) */\n  autosave(o) { return this.save('auto', o); }\n  /** load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save\n   *  ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version */\n  load(slot) {\n    const s = this.get(slot); if (!s || s.damaged || s.newer) return null;\n    if (s.version < this.version && this.migrate) try { s.data = this.migrate(s.data, s.version); } catch (e) { this.game.fail('saves.migrate', e); return null; }\n    this.played = s.time;\n    if (this.read) try { this.read(s); } catch (e) { this.game.fail('saves.read', e); return null; }\n    return s;\n  }\n  /** copy a slot's save onto another (over what is there); false when the first is empty */\n  copy(from, to) { if (!this._ok(from) || !this._ok(to)) return false; const t = this._raw(from); if (t === null || t === undefined) return false; this._put(to, t); return true; }\n  /** erase a slot */\n  erase(slot) { if (this._ok(slot)) this._put(slot, null); }\n  /** is there any save to load (a title's Continue)? */\n  get any() { return this.list().some(s => !s.empty && !s.damaged && !s.newer); }\n  /** the most recent save that loads, or null (a title's Continue loads it) */\n  latest() { return this.list().filter(s => !s.empty && !s.damaged && !s.newer).sort((a, b) => b.at - a.at)[0] || null; }\n  /** open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or\n   *  a save. False without a menu (a headless game, menu: false) */\n  show(mode = 'load', done) {\n    const sh = this.game.shell; if (!sh || !sh._menu()) return false;\n    const T = s => { const m = Math.floor(s.time / 60); return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0'); };\n    const name = slot => slot === 'auto' ? 'Autosave' : 'Slot ' + (slot + 1);\n    const about = s => s.empty ? 'Empty' : s.damaged ? 'Damaged: it cannot be read' : s.newer ? 'From a newer version of the game' : [s.place, s.level !== null ? 'Level ' + s.level : '', T(s), s.at ? new Date(s.at).toLocaleDateStr","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YR1PvivDEFLTXAkuMaHq7c","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
