\")\nopen(p,'w').write(s)\np='src/12-audio.js'; s=open(p).read()\ns=s.replace(\"G.sfx = (name, o) => { try { G.game.audio.sfx(name, o); } catch (e) { /* audio unavailable headless */ } };\",\"G.sfx = (name, o) => { try { G.game.audio.sfx(name, o); } catch (e) { /* audio unavailable headless */ } };\\nG.voiceSfx = (v, o) => { const a = G.game.audio; try { if (!a._init() || a.muted || a.ctx.state !== 'running') return; for (const x of Array.isArray(v) ? v : [v]) a._voice(x, a._voxBus, a.ctx.currentTime + .005, 1 + (o && o.vary ? o.vary * (a._rnd() * 2 - 1) : 0)); } catch (e) { /* none */ } };\")\ns=s.replace(\"G.sfx({ wave: v.wave, freq: f\",\"G.voiceSfx({ wave: v.wave, freq: f\").replace(\"else G.sfx([{ wave: 'noise', freq: f * 3\",\"else G.voiceSfx([{ wave: 'noise', freq: f * 3\")\ns=s.replace(\" * vm / .8\",\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"voiceSfx\" src/12-audio.js | head -3; cat >> ENGINE-CHANGES.md <<'EOF'\n5. `touch: 'never'` game option hides touch buttons and the stick for good (touch-only devices use it).\n6. A third audio bus for voices: `audio.bus('voice')`, `audio.voiceVolume`; the 'Voices' setting drives it and Animalese plays through it.\nEOF\nnode tools/build.mjs >/dev/null; node test/run.mjs 2>&1 | tail -3; node tools/settingscheck.mjs"}}}
