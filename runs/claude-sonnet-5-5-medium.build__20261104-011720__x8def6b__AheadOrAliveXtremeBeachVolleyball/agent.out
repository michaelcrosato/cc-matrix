s}&auto=1${extra}`);\ntry { await p.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 170000 }); } catch (e) { errs.push('timeout waiting for complete'); }\nconst res = await p.evaluate(() => window.__hubCheck || null);\nconsole.log(JSON.stringify(res, null, 1).slice(0, 3500)); console.log('page errors:', errs.slice(0, 5));\nawait p.screenshot({ path: resolve(DEV, 'test-output/hub.png') });\nawait br.close(); srv.kill();\nEOF\ntimeout 220 node tools/hubcheck.mjs 2 2>&1 | head -60","is_backgrounded":false,"task_type":"local_bash","uuid":"4a1de5b5-546e-47cb-83e3-172c0ca7e747","session_id":"b145291d-9dd6-4001-ae7d-69eaa59b373e"}
