e: g.scene && g.scene.name, errors: (g.errors || []).length, paused: g.paused } : null;\n});\nawait browser.close();\nconsole.log(JSON.stringify({ info, errors: errors.slice(0, 20), errorCount: errors.length }, null, 1));\nEOF\ntimeout 200 node tools/browser.mjs --shot .tmp/title.png 2>&1 | tail -30","description":"Open the built file in headless Chromium and check for errors"}},"wire_ingest_context":{"toolu_01Ec1Rj5aZegacFX9PQURv7x":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050317__x1f94fb/work/Crackmania-TrackMania2003-claude-haiku-5-5-medium-20261104-050317"}}}
