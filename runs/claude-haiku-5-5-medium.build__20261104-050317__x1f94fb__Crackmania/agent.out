('replay', { track: TRACKS[i], frames: b.ghost.frames, ms: b.ms });\n      else game.note('NO REPLAY YET ON THIS ROAD');\n    } }),\n    puzzles: new E.Menu(game, PUZZLES.map(p => p.name)\"\"\")\n# story beat helper, placed before touchOnlyDevice\nrep(\"  function touchOnlyDevice() {\",\"\"\"  /** a one-time talk for a story beat: shown once per profile, then remembered */\n  function beat(id) {\n    S.profile.beats = S.profile.beats || {};\n    if (S.profile.beats[id]) return false;\n    const b = BEATS[id];\n    S.talk = new E.Dialog(game);\n    S.talk.say(b.lines, { name: b.name, onDone: () => { S.profile.beats[id] = true; storage.save(S.profile); } });\n    speak(b.lines[0]);\n    return true;\n  }\n  function touchOnlyDevice() {\"\"\")\n# results: first-finish beat; talk hooks\nrep(\"        enter(d) { S.res = d; A.music('victory'); if (!d.session\",\"        enter(d) { S.res = d; A.music('victory'); if (!d.session && !d.puzzle && !d.survival && !d.hotseat) beat('first'); if (!d.session\")\nrep(\"        update(dt) { S.menu.update(dt); },\\n        draw(r) {\\n          r.sky(SKY);\\n          const d = S.res;\",\n\"        update(dt) { if (S.talk && S.talk.update(dt)) return; S.menu.update(dt); },\\n        draw(r) {\\n          r.sky(SKY);\\n          const d = S.res;\\n          if (S.talk && S.talk.open) { S.talk.draw(r); return; }\")\n# survival: guild beat on entry\nrep(\"      survival: {\\n        input: INPUT,\\n        enter() { S.menu = menus.survival; },\\n        update(dt) { if (!S.menu.update(dt) && game.input.pressed('cancel')) game.go('title'); },\",\n\"      survival: {\\n        input: INPUT,\\n        enter() { S.menu = menus.survival; beat('guild'); },\\n        update(dt) { if (S.talk && S.talk.update(dt)) return; if (!S.menu.update(dt) && game.input.pressed('cancel')) game.go('title'); },\")\nrep(\"          S.menu.draw(r);\\n          prompt(r, [['confirm', 'Select'], ['cancel', 'Back']]);\\n        },\\n      },\\n      hotseat: {\",\n\"          S.menu.draw(r);\\n          if (S.talk && S.talk.open) S.talk.draw(r);\\n          prompt(r, [['confirm', 'Select'], ['cancel', 'Back']]);\\n        },\\n      },\\n      hotseat: {\")\n# replays scene\nrep(\"      puzzles: {\\n        input: INPUT,\",\n\"\"\"      replays: {\n        input: INPUT,\n        enter() { S.menu = menus.replays; },\n        update(dt) { if (!S.menu.update(dt) && game.input.pressed('cancel')) game.go('title'); },\n        draw(r) {\n          r.sky(SKY);\n          r.overlay(g => {\n            E.font.title(g, 'REPLAYS', r.W / 2, 8, { align: 'center', scale: 2, colors: ['#fff8dc', '#ffd36a'], depth: 2, depthColor: '#4a1b08' });\n            const t = TRACKS[S.menu.i], b = t && bestOf(t.id);\n            E.font.text(g, b && b.ghost ? 'Your best on ' + t.name + ': ' + fmt(b.ms) : 'Finish a road to keep its replay', r.W / 2, r.H - 30, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n          });\n          S.menu.draw(r);\n          prompt(r, [['confirm', 'Watch'], ['cancel', 'Back']]);\n        },\n      },\n      puzzles: {\n        input: INPUT,\"\"\")\nopen(p,'w').write(s)\nprint('ok')\nPYEOF\necho","description":"Add the replay library and one-time story beats"}},"wire_ingest_context":{"toolu_01MX7qVTUQEPKSXn8o8PX9Jt":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050317__x1f94fb/work/Crackmania-TrackMania2003-claude-haiku-5-5-medium-20261104-050317"}}}
