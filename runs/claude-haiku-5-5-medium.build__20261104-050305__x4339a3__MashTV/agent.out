}\n442:      foes = []; wave++; cab.card('STAGE ' + wave, 1.8); readyT = Math.max(readyT, .6);\n455:    const kill = f => { f.hp = 0; cab.add(f.kind === 'boss' ? (f.state === 'dive' ? 400 : 150) : f.kind === 'b' ? (f.state === 'dive' ? 160 : 80) : (f.state === 'dive' ? 100 : 50), { x: X0 + f.x, y: Y0 + f.y }); P.sparks(X0 + f.x, Y0 + f.y, 4, 10); P.bits(X0 + f.x, Y0 + f.y, 4, 6, ['#ffe040', '#4a8aff', '#ff4a4a']); A.sfx('explode', { vol: .45 }); };\n460:      if (dead > 0 && (dead -= dt) <= 0) { const was = cab.p, r = cab.die(); if (r === 'over') { over = true; return; } if (r === 'next') { was.save = { wave, foes }; const s = cab.p.save; if (s) { wave = s.wave; foes = s.foes; for (const f of foes) if (f.state !== 'form') { f.state = 'back'; f.y = -20; } } else { wave = 0; newWave(); } } ship.x = FW / 2; bombs.length = 0; readyT = 1.4; }\n535:    function newWave() { wave++; rocks = []; for (let i = 0; i < 3 + wave; i++) { const edge = Math.random() < .5; rocks.push(rock(edge ? 0 : Math.random() * RW, edge ? Math.random() * RH : 0, 3)); } if (wave > 1) cab.card('WAVE ' + wave, 1.4); }\n543:      if (deadT > 0 && (deadT -= dt) <= 0) { const was = cab.p, r = cab.die(); if (r === 'over') { over = true; return; } if (r === 'next') { was.save = { wave, rocks }; const s = cab.p.save; if (s) ({ wave, rocks } = s); else { wave = 0; newWave(); } } home(); readyT = 1.4; shots = shots.filter(s => !s.foe); }\n568:        for (const k of rocks) if (!k.dead && far(s, k) < k.R) { k.dead = true; s.t = 0; cab.add([0, 100, 50, 20][k.size], { x: X0 + k.x, y: Y0 + k.y }); A.sfx(k.size > 2 ? 'boom' : 'explode', { vol: .4 }); burst(k.x, k.y, 6 + k.size * 3, 60, .6, '#c8d8ff'); if (k.size > 1) for (let i = 0; i < 2; i++) rocks.push(rock(k.x, k.y, k.size - 1)); break; }\n569:        if (s.t > 0 && saucer && far(s, saucer) < 8) { cab.add(500, { x: X0 + saucer.x, y: Y0 + saucer.y }); s.t = 0; burst(saucer.x, saucer.y, 16, 70, .7, '#ff8aa8'); saucer = null; A.sfx('boom'); }\n633:  const cabs = {}; for (const G of GAMES) cabs[G.id] = new E.Arcade(game, { id: G.id, lives: 3, extra: G.extra || [], every: G.every });\n634:  const front = new E.Arcade(game, { id: 'arcade', idle: 20, demo: 1e9, scores: 6 });   // the title's attract clock (a demo ends itself: endDemo)\n640:    const ending = (order = cab.players.slice().sort((a, b) => b.score - a.score)) => {\n642:      if (cab.qualifies(p.score)) { stage = 'entry'; if (cab.players.length > 1) cab.say('PLAYER ' + p.n, 30); cab.enter(p.score, '', () => { cab.clear(); ending(order); }); } else ending(order);\n645:      view: 'overhead', views: ['overhead'], input: KEYS, res: G.res, expand: true, pausable: true, touch: G.touch, camera: { zoom: false },\n651:        cab.start(demo ? 1 : players, { demo }); G.begin(cab, demo); A.music(null);\n658:        cab.update(dt);\n660:        if (cab.entry || cab.continuing) return;\n662:        if (G.over && stage === 'play') { stage = 'cont'; cab.continue(9, yes => { if (yes) { stage = 'play'; G.revive(); } else ending(); }); return; }\n667:        if (stage === 'table') { r.overlay(g => { g.fillStyle = 'rgba(0,0,0,.78)'; g.fillRect(0, 0, r.bw, r.bh); px.reset(g); }); cab.drawTable(r, '', Math.max(16, Math.round(r.H / 2 - 82)), G.label + ' HIGH SCORES'); }\n668:        else cab.draw(r, G.box());\n672:      end(score, cont) { cab.p.score = score; cab.hi = Math.max(cab.hi, score); for (const p of cab.players) p.lives = 0; G.force(); if (!cont) { stage = 'cont'; ending(); } },\n674:      run: (n = 600) => proof('arcade-' + G.id, n, (i, k) => { walk(i, k, ['left', 'up', 'right', 'down'], 70); if (i % 30 === 5) k.tap('fire'); if (G.id === 'rocks') { if (i % 140 < 40) k.hold('thrust'); else k.up('thrust'); } }, () => [G.state(), cab.players.map(p => [p.score, p.lives])]),\n675:      state: () => ({ game: G.state(), stage, demo, entry: cab.entry && { name: cab.entry.name.slice(), i: cab.entry.i, score: cab.entry.score }, wheel: cab.entry && cab.wheel, continuing: cab.continuing,