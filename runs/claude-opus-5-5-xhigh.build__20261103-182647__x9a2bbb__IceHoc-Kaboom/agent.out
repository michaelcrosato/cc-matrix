 c.y = ty; c.vx = c.vy = 0; c.moving = false; return; }   // smooth 0 = locked camera\n3531:  const dcx = S.cx === undefined ? 0 : g.cam.x - S.cx; S.cx = g.cam.x; S.t += dt;\n3535:    if (mode === 'world') { const q = v.toGround(g.cam.x + R() * W, g.cam.y + R() * H) || [0, 0]; d.x = q[0]; d.y = q[1]; }   // (it lands on a point of the screen)\n3753:  if (c.snap || c.x === undefined || !(c.smooth > 0)) { c.x = tx; c.y = ty; c.vx = c.vy = 0; c.snap = false; return; }\n3787:    if (v.cam.x === undefined) _vpCam(game, v, 0);\n3788:    game.lights._clear(); r._begin(v.cam.x + shx - v.x, v.cam.y + shy - v.y, v); r.viewport = v;\n10254:    if (g) { parts.push(g.time, g.cam.x, g.cam.y, g.sceneName || ''); if (typeof g.stateHash === 'function') try { parts.push(...[].concat(g.stateHash())); } catch (e) { parts.push('stateHash threw'); } }\n2916:  _screenToGround(dx, dy) {\n2917-    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n2918-    return v.inv ? [(v.inv[0] * dx + v.inv[1] * dy) * k, (v.inv[2] * dx + v.inv[3] * dy) * k] : [dx / (v.ax || 1) * k, 0];\n2919-  }\n2920-  // cam.free: the keys and a stick, the screen's edges, a drag, a zoom toward its point; the focus kept to bounds\n2921-  _freeCam(dt) {\n2922-    const c = this.cam, F = c.free === true ? {} : c.free, I = this.input, S = this.screen, z = this._zoomTo || this.zoom;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01A6yX5ZkThyE4ssHjZZJ59m","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
