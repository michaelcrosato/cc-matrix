=== 0) px.rect(g, x + 1, y + 1, Math.floor((w - 2) / 2), 3 * sc, lit); else if (btn === 2) px.rect(g, x + Math.ceil(w / 2), y + 1, Math.floor((w - 2) / 2), 3 * sc, lit); else px.rect(g, x + Math.floor(w / 2), y + 1, 1 * sc, 3 * sc, '#e83a2a');\n    px.rect(g, x + Math.floor(w / 2), y + 1, 1, 3 * sc, '#8a8a90'); return Math.ceil(w + 1);\n  }\n  /** the width of a chip (to center a prompt) */\n  function chipW(action, o = {}) { const I = o.input || game.input; return widthOf(spec(I, action, o.device || dev(I)), o.scale || 1); }\n'''\ns=s[:start]+new+s[end:]\nio.open(p,'w').write(s)\nEOF\ngrep -n \"stubG\" src/11-glyphs.js | head -3","description":"Measure glyph chips analytically"}}}
