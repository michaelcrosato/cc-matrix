atures as must-have versus nice-to-have, and keep the plan's names in step with TASK.md.","ttft_ms":2159,"type":"result","duration_ms":13598106,"uuid":"9f8d7d75-a3b2-425d-a8c0-21dc9c800610","ttft_stream_ms":2026,"time_to_request_ms":112,"first_content_frame_ms":2026,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":600,"outputTokens":593736,"cacheReadInputTokens":183889702,"cacheCreationInputTokens":920026,"webSearchRequests":0,"costUSD":56.01526839999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":145766,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":920026,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"},"claude-haiku-5-5":{"inputTokens":12,"outputTokens":943,"cacheReadInputTokens":2616,"cacheCreationInputTokens":2199075,"webSearchRequests":0,"costUSD":1.3769161749999999,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"cacheCreationEphemeral5mInputTokens":2199075,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-haiku-5-5","provider":"firstParty","costBasis":"list"}}}
