{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TCCGVFSuf9wxnqY47sQwa2","type":"tool_result","content":"502\t    for (const p of all) px.rect(g, Math.round(x0 + (p.body.x - X0) * s) - 1, Math.round(y0 + (p.body.y - Y0) * s) - 1, 2, 2, TEAMS[p.side].chip);\n503\t    px.rect(g, Math.round(x0 + (ball.x - X0) * s), Math.round(y0 + (ball.y - Y0) * s), 1, 1, '#ffffff');\n504\t    if (mode === 'kickoff') E.font.text(g, 'KICK OFF', r.W / 2, r.H * .3, '#ffe7a8', { align: 'center', scale: 2, shadow: '#000', outline: false });\n505\t    if (mode === 'goal') E.font.title(g, 'GOAL!', r.W / 2, r.H * .28, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347'] });\n506\t    if (mode === 'half') E.font.text(g, 'HALF TIME', r.W / 2, r.H * .3, '#ffe7a8', { align: 'center', scale: 2, shadow: '#000', outline: false });\n507\t  }\n508\t  function results(g, r) {\n509\t    const w = score[0] > score[1] ? 0 : score[1] > score[0] ? 1 : -1;\n510\t    E.ui.box(g, r.W / 2 - 110, 52, 220, 128, { bg: '#141826', border: '#e8c070', alpha: .92 });\n511\t    E.font.title(g, w < 0 ? 'A DRAW' : TEAMS[w].name + ' WIN', r.W / 2, 60, { align: 'center', scale: 2, colors: ['#fffbe8', '#ffe08a', '#ffb347'] });\n512\t    E.font.text(g, 'GULLS ' + score[0] + ' - ' + score[1] + ' RUST', r.W / 2, 86, '#f0ecdc', { align: 'center', outline: false });\n513\t    stats.goals.slice(-5).forEach(([s, name, at], i) => E.font.text(g, mmss(at) + '  ' + name + ' (' + TEAMS[s].name + ')', r.W / 2, 100 + i * 9, '#c8d0e8', { align: 'center', font: 'tiny', outline: false }));\n514\t  }\n515\t  function drawMenu(r) {\n516\t    r.sky(['#0e1630', '#1e3050', '#2e5a3a']);\n517\t    r.overlay(g => {\n518\t      E.font.title(g, 'CAGE CUP', r.W / 2, 34, { align: 'center', scale: 3, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 2 });\n519\t      E.font.text(g, 'TWO AGAINST TWO, UP TO FOUR PLAYERS', r.W / 2, 70, '#c8d0e8', { align: 'center', outline: false });\n520\t      if (mode === 'join') {\n521\t        const P = game.players;\n522\t        E.font.text(g, 'VERSUS: PRESS 2 ON THE KEYBOARD, OR START ON A PAD, TO JOIN', r.W / 2, 96, '#ffe7a8', { align: 'center', font: 'tiny', outline: false });\n523\t        ['P1 GULLS', 'P2 RUST', 'P3 GULLS', 'P4 RUST'].forEach((s, i) => E.font.text(g, s + (P[i] ? '  READY' : '  ...'), r.W / 2 - 40, 112 + i * 12, P[i] ? E.PLAYER_COLORS[i] : '#6a7090', { outline: false }));\n524\t        E.font.text(g, prompt('confirm', 'PLAY') + '   ' + prompt('cancel', 'BACK'), r.W / 2, 172, '#c8d0e8', { align: 'center', font: 'tiny', outline: false });\n525\t      }\n526\t    });\n527\t    if (mode === 'menu') menu.draw(r);\n528\t  }\n529\t\n530\t  /* ---- THE CONTROLS: the default preset's stick with three buttons of its own ---- */\n531\t  const KEYS = Object.assign({}, E.Input.DEFAULT, { pass: ['KeyJ', 'KeyX', 'Pad0'], shoot: ['KeyK', 'KeyZ', 'Pad2'], lob: ['KeyL', 'KeyC', 'Pad3'] });\n532\t  for (const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\n533\t\n534\t  /** the proof: a match from the kickoff, player 1 running at goal, passing, lobbing, shooting; a hash of the match */\n535\t  const run = (n = 600) => proof('sports', n, (i, k) => {\n536\t    if (i === 1) start(false);\n537\t    if (i === 140) k.hold('right'); if (i === 200) k.tap('pass'); if (i === 300) k.tap('lob');\n538\t    if (i === 380) k.hold('shoot'); if (i === 440) k.up('shoot'); if (i === 520) k.up('right');\n539\t  }, () => [Math.round(ball.x), Math.round(ball.y), Math.round(ball.z), score, all.map(p => [Math.round(p.body.x), Math.round(p.body.y)]), stats.passes, stats.shots, owner ? owner.name : null]);\n540\t  /** the bot: player 1 plays a match by the game's own rules (the stick and the buttons, as a player gives them, from the\n541\t   *  CPU's own judgment for its player) to the final whistle; then four players, each holding one footballer, for a\n542\t   *  stretch. Returns { full, score, goals, passes, done, lobs, shots, curled, tackles, four, seconds, errors } */\n543\t  function bot(s = 1) {\n544\t    const was = Math.random; Math.random = E.rng(s); const I = game.input, held = new Set(), hold = (a, on) => { if (on && !held.has(a)) { held.add(a); I.hold(a); } else if (!on && held.has(a)) { held.delete(a); I.hold(a, false); } };\n545\t    scripted = true;\n546\t    try {\n547\t      game.go('sports', null, { fade: 0 }); game.advance(1 / 120); start(false);\n548\t      let n = 0;\n549\t      for (; n < 120 * 400 && mode !== 'full'; n++) {\n550\t        const me = team[0].find(p => p.input);\n551\t        if (me && mode === 'play') {\n552\t          const c = brain(me, 1 / 120), mv = curlT > 0 && last === me && !owner ? [0, 0] : c.move;   // what the CPU would do in its place, given as the stick and buttons (still while its shot flies: no curl)\n553\t          hold('right', mv[0] > .35); hold('left', mv[0] < -.35); hold('down', mv[1] > .35); hold('up', mv[1] < -.35);\n554\t          if (c.pass) I.tap('pass'); if (c.lob) I.tap('lob'); hold('shoot', c.shootHeld);\n555\t        } else for (const a of ['right', 'left', 'up', 'down', 'shoot']) hold(a, false);\n556\t        game.advance(1 / 120);\n557\t      }\n558\t      for (const a of [...held]) hold(a, false);\n559\t      const r = { full: mode === 'full', score: score.slice(), goals: stats.goals.length, passes: stats.passes, done: stats.done, lobs: stats.lobs, shots: stats.shots, curled: stats.curled, tackles: stats.tackles, walls: stats.walls, seconds: Math.round(n / 120) };\n560\t      // four players: three more join, each footballer held by an input; a stretch of play, each pushing its stick\n561\t      while (game.players.length < 4) game.addPlayer(game.players.length === 1 ? { keys: 'right' } : { pad: game.players.length - 1 });\n562\t      start(true); const moved = all.map(p => [p.body.x, p.body.y]);\n563\t      for (let k = 0; k < 240; k++) { for (const p of all) if (p.input && p.input !== I) p.input.hold(p.side ? 'left' : 'right', k > 140); game.advance(1 / 120); }\n564\t      r.four = { held: all.filter(p => p.input).length, moved: all.filter((p, i) => Math.hypot(p.body.x - moved[i][0], p.body.y - moved[i][1]) > 4).length };\n565\t      for (const p of all) if (p.input && p.input !== I) p.input.hold(p.side ? 'left' : 'right', false);\n566\t      while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\n567\t      r.errors = game.errors.length; toMenu(); return r;\n568\t    } finally { for (const a of [...held]) hold(a, false); Math.random = was; scripted = false; }\n569\t  }\n570\t\n571\t  return { view: 'threequarter', views: ['threequarter', 'topdown'], input: KEYS, res: 'ps1', pausable: true, touch: ['lob', 'shoot', 'pass'], camera: { zoom: [.7, 1.6] },\n572\t    enter(d) { game.cam.bounds = null; t = 0; if (d && d.part === 'match') start(false); else if (d && d.part === 'vs') versus(); else toMenu(); },\n573\t    back() { if (mode === 'menu') { game.go('title'); return true; } if (mode === 'join' || mode === 'full') { toMenu(); return true; } return false; },\n574\t    update, draw, bot, run,\n575\t    state: () => { const you = all.find(p => p.input === game.input);   // (for tests)\n576\t      return { mode, clock: +clock.toFixed(2), score: score.slice(), half, golden, owner: owner && owner.name, ball: ball && [Math.round(ball.x), Math.round(ball.y), Math.round(ball.z)],\n577\t        you: you && { name: you.name, x: Math.round(you.body.x), y: Math.round(you.body.y) }, passes: stats ? stats.passes : 0, shots: stats ? stats.shots : 0 }; } };\n578\t})();\n579\tscenes.sports = SPORTS;\n580\t\n581\t/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n582\t// a genre kit file holds one slice: the menu lists only the slices in this file\n583\tfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\n584\ttitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n585\t// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n586\t// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\n587\tconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\n588\tgame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\n589\twindow.__game = { game, scenes, titleMenu };   // for tests\n590\t})();\n591\t/* =============================== GAME END =============================== */\n592\t"}]},"parent_tool_use_id":null,"session_id":"2bfc1153-d85f-4cc7-a4e9-74837d1d317d","uuid":"f1639944-d3e6-446f-ab5f-5777e4821501","timestamp":"2026-11-04T01:27:54.536Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-182647__x9a2bbb/work/IceHoc-Kaboom-IceHockey-claude-opus-5-5-xhigh-20261103-182647/engine/kits/sports.js","content":"    for (const p of all) px.rect(g, Math.round(x0 + (p.body.x - X0) * s) - 1, Math.round(y0 + (p.body.y - Y0) * s) - 1, 2, 2, TEAMS[p.side].chip);\n    px.rect(g, Math.round(x0 + (ball.x - X0) * s), Math.round(y0 + (ball.y - Y0) * s), 1, 1, '#ffffff');\n    if (mode === 'kickoff') E.font.text(g, 'KICK OFF', r.W / 2, r.H * .3, '#ffe7a8', { align: 'center', scale: 2, shadow: '#000', outline: false });\n    if (mode === 'goal') E.font.title(g, 'GOAL!', r.W / 2, r.H * .28, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347'] });\n    if (mode === 'half') E.font.text(g, 'HALF TIME', r.W / 2, r.H * .3, '#ffe7a8', { align: 'center', scale: 2, shadow: '#000', outline: false });\n  }\n  function results(g, r) {\n    const w = score[0] > score[1] ? 0 : score[1] > score[0] ? 1 : -1;\n    E.ui.box(g, r.W / 2 - 110, 52, 220, 128, { bg: '#141826', border: '#e8c070', alpha: .92 });\n    E.font.title(g, w < 0 ? 'A DRAW' : TEAMS[w].name + ' WIN', r.W / 2, 60, { align: 'center', scale: 2, colors: ['#fffbe8', '#ffe08a', '#ffb347'] });\n    E.font.text(g, 'GULLS ' + score[0] + ' - ' + score[1] + ' RUST', r.W / 2, 86, '#f0ecdc', { align: 'center', outline: false });\n    stats.goals.slice(-5).forEach(([s, name, at], i) => E.font.text(g, mmss(at) + '  ' + name + ' (' + TEAMS[s].name + ')', r.W / 2, 100 + i * 9, '#c8d0e8', { align: 'center', font: 'tiny', outline: false }));\n  }\n  function drawMenu(r) {\n    r.sky(['#0e1630', '#1e3050', '#2e5a3a']);\n    r.overlay(g => {\n      E.font.title(g, 'CAGE CUP', r.W / 2, 34, { align: 'center', scale: 3, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 2 });\n      E.font.text(g, 'TWO AGAINST TWO, UP TO FOUR PLAYERS', r.W / 2, 70, '#c8d0e8', { align: 'center', outline: false });\n      if (mode === 'join') {\n        const P = game.players;\n        E.font.text(g, 'VERSUS: PRESS 2 ON THE KEYBOARD, OR START ON A PAD, TO JOIN', r.W / 2, 96, '#ffe7a8', { align: 'center', font: 'tiny', outline: false });\n        ['P1 GULLS', 'P2 RUST', 'P3 GULLS', 'P4 RUST'].forEach((s, i) => E.font.text(g, s + (P[i] ? '  READY' : '  ...'), r.W / 2 - 40, 112 + i * 12, P[i] ? E.PLAYER_COLORS[i] : '#6a7090', { outline: false }));\n        E.font.text(g, prompt('confirm', 'PLAY') + '   ' + prompt('cancel', 'BACK'), r.W / 2, 172, '#c8d0e8', { align: 'center', font: 'tiny', outline: false });\n      }\n    });\n    if (mode === 'menu') menu.draw(r);\n  }\n\n  /* ---- THE CONTROLS: the default preset's stick with three buttons of its own ---- */\n  const KEYS = Object.assign({}, E.Input.DEFAULT, { pass: ['KeyJ', 'KeyX', 'Pad0'], shoot: ['KeyK', 'KeyZ', 'Pad2'], lob: ['KeyL', 'KeyC', 'Pad3'] });\n  for (const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\n\n  /** the proof: a match from the kickoff, player 1 running at goal, passing, lobbing, shooting; a hash of the match */\n  const run = (n = 600) => proof('sports', n, (i, k) => {\n    if (i === 1) start(false);\n    if (i === 140) k.hold('right'); if (i === 200) k.tap('pass'); if (i === 300) k.tap('lob');\n    if (i === 380) k.hold('shoot'); if (i === 440) k.up('shoot'); if (i === 520) k.up('right');\n  }, () => [Math.round(ball.x), Math.round(ball.y), Math.round(ball.z), score, all.map(p => [Math.round(p.body.x), Math.round(p.body.y)]), stats.passes, stats.shots, owner ? owner.name : null]);\n  /** the bot: player 1 plays a match by the game's own rules (the stick and the buttons, as a player gives them, from the\n   *  CPU's own judgment for its player) to the final whistle; then four players, each holding one footballer, for a\n   *  stretch. Returns { full, score, goals, passes, done, lobs, shots, curled, tackles, four, seconds, errors } */\n  function bot(s = 1) {\n    const was = Math.random; Math.random = E.rng(s); const I = game.input, held = new Set(), hold = (a, on) => { if (on && !held.has(a)) { held.add(a); I.hold(a); } else if (!on && held.has(a)) { held.delete(a); I.hold(a, false); } };\n    scripted = true;\n    try {\n      game.go('sports', null, { fade: 0 }); game.advance(1 / 120); start(false);\n      let n = 0;\n      for (; n < 120 * 400 && mode !== 'full'; n++) {\n        const me = team[0].find(p => p.input);\n        if (me && mode === 'play') {\n          const c = brain(me, 1 / 120), mv = curlT > 0 && last === me && !owner ? [0, 0] : c.move;   // what the CPU would do in its place, given as the stick and buttons (still while its shot flies: no curl)\n          hold('right', mv[0] > .35); hold('left', mv[0] < -.35); hold('down', mv[1] > .35); hold('up', mv[1] < -.35);\n          if (c.pass) I.tap('pass'); if (c.lob) I.tap('lob'); hold('shoot', c.shootHeld);\n        } else for (const a of ['right', 'left', 'up', 'down', 'shoot']) hold(a, false);\n        game.advance(1 / 120);\n      }\n      for (const a of [...held]) hold(a, false);\n      const r = { full: mode === 'full', score: score.slice(), goals: stats.goals.length, passes: stats.passes, done: stats.done, lobs: stats.lobs, shots: stats.shots, curled: stats.curled, tackles: stats.tackles, walls: stats.walls, seconds: Math.round(n / 120) };\n      // four players: three more join, each footballer held by an input; a stretch of play, each pushing its stick\n      while (game.players.length < 4) game.addPlayer(game.players.length === 1 ? { keys: 'right' } : { pad: game.players.length - 1 });\n      start(true); const moved = all.map(p => [p.body.x, p.body.y]);\n      for (let k = 0; k < 240; k++) { for (const p of all) if (p.input && p.input !== I) p.input.hold(p.side ? 'left' : 'right', k > 140); game.advance(1 / 120); }\n      r.four = { held: all.filter(p => p.input).length, moved: all.filter((p, i) => Math.hypot(p.body.x - moved[i][0], p.body.y - moved[i][1]) > 4).length };\n      for (const p of all) if (p.input && p.input !== I) p.input.hold(p.side ? 'left' : 'right', false);\n      while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\n      r.errors = game.errors.length; toMenu(); return r;\n    } finally { for (const a of [...held]) hold(a, false); Math.random = was; scripted = false; }\n  }\n\n  return { view: 'threequarter', views: ['threequarter', 'topdown'], input: KEYS, res: 'ps1', pausable: true, touch: ['lob', 'shoot', 'pass'], camera: { zoom: [.7, 1.6] },\n    enter(d) { game.cam.bounds = null; t = 0; if (d && d.part === 'match') start(false); else if (d && d.part === 'vs') versus(); else toMenu(); },\n    back() { if (mode === 'menu') { game.go('title'); return true; } if (mode === 'join' || mode === 'full') { toMenu(); return true; } return false; },\n    update, draw, bot, run,\n    state: () => { const you = all.find(p => p.input === game.input);   // (for tests)\n      return { mode, clock: +clock.toFixed(2), score: score.slice(), half, golden, owner: owner && owner.name, ball: ball && [Math.round(ball.x), Math.round(ball.y), Math.round(ball.z)],\n        you: you && { name: you.name, x: Math.round(you.body.x), y: Math.round(you.body.y) }, passes: stats ? stats.passes : 0, shots: stats ? stats.shots : 0 }; } };\n})();\nscenes.sports = SPORTS;\n\n/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n// a genre kit file holds one slice: the menu lists only the slices in this file\nfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\ntitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\nconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\ngame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\nwindow.__game = { game, scenes, titleMenu };   // for tests\n})();\n/* =============================== GAME END =============================== */\n","numLines":91,"startLine":502,"totalLines":592}},"tool_result_meta":[{"id":"toolu_01TCCGVFSuf9wxnqY47sQwa2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh265NBbLnySDGNeePe3","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4144,"cache_read_input_tokens":144387,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4144},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2bfc1153-d85f-4cc7-a4e9-74837d1d317d","uuid":"5349490d-b4b8-4f8b-9c17-a25cf9cfb3b5","timestamp":"2026-11-04T01:27:56.693Z","request_id":"req_011Cgh2659Ht1bz1BwazVVZJ","thinking_duration_ms":146,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh265NBbLnySDGNeePe3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015x2pBNh1Y9vsi8cE4GtX8N","name":"Bash","input":{"command":"cat ../vendor/README.md","description":"Read the AI Hub protocol README"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4144,"cache_read_input_tokens":144387,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4144},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2bfc1153-d85f-4cc7-a4e9-74837d1d317d","uuid":"1fbcef7c-634e-4f86-96f3-0e73ad209066","timestamp":"2026-11-04T01:27:57.130Z","request_id":"req_011Cgh2659Ht1bz1BwazVVZJ","wire_tool_inputs":{"toolu_015x2pBNh1Y9vsi8cE4GtX8N":{"command":"cat ../vendor/README.md","description":"Read the AI Hub protocol README"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015x2pBNh1Y9vsi8cE4GtX8N","type":"tool_result","content":"# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card: what the game is, how to win, the\n   controls. The card is the hub's, from the game's tags, or the game's own\n   (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. By default the hub shows its own card over\nthe game. A game can make the card its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n| `hub:session-goal` | how to win, shown on the hub's card |\n| `hub:session-howto` | the controls, shown on the hub's card |\n| `hub:session-minutes` | optional: how many minutes a round takes |\n| `hub:webgpu` | optional: `required` when the game cannot run without WebGPU |\n\n### API\n\n| | |\n|---|---|\n| `AIHub.active` | `true` in a session, from the first line |\n| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n| `AIHub.ready()` | once, when the round can start |\n| `AIHub.answer('ready' \\| 'more')` | on the game's own card, before `start` |\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\nread them.\n\n| Event | Arguments |\n|---|---|\n| `card` | `{ left, paused, starting, ready, asking, asked }`, with the game's own card |\n| `start` | `{ in }`: milliseconds until play begins |\n| `message` | `data, from` |\n| `leave` | `{ id, reason }` |\n| `time-up` | `{ graceMs }` |\n| `end` | `{ reason, standings }` |\n\nEvents that arrive before a handler is attached are kept, and delivered in\norder when the first handler is attached. Fields and events a newer hub adds\nreach the game through the client unchanged.\n\n### Versions\n\nThis is protocol **1**, client **1.4.0**. Changes within version 1 only add:\ngames on older clients keep working. A change that would break a game becomes\nprotocol 2, with its own `hub:session` value.","is_error":false}]},"parent_tool_use_id":null,"session_id":"2bfc1153-d85f-4cc7-a4e9-74837d1d317d","uuid":"bf774143-f4e2-4812-836a-cf76b712eeef","timestamp":"2026-11-04T01:27:57.145Z","tool_use_result":{"stdout":"# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card: what the game is, how to win, the\n   controls. The card is the hub's, from the game's tags, or the game's own\n   (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. By default the hub shows its own card over\nthe game. A game can make the card its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n| `hub:session-goal` | how to win, shown on the hub's card |\n| `hub:session-howto` | the controls, shown on the hub's card |\n| `hub:session-minutes` | optional: how many minutes a round takes |\n| `hub:webgpu` | optional: `required` when the game cannot run without WebGPU |\n\n### API\n\n| | |\n|---|---|\n| `AIHub.active` | `true` in a session, from the first line |\n| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n| `AIHub.ready()` | once, when the round can start |\n| `AIHub.answer('ready' \\| 'more')` | on the game's own card, before `start` |\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\nread them.\n\n| Event | Arguments |\n|---|---|\n| `card` | `{ left, paused, starting, ready, asking, asked }`, with the game's own card |\n| `start` | `{ in }`: milliseconds until play begins |\n| `message` | `data, from` |\n| `leave` | `{ id, reason }` |\n| `time-up` | `{ graceMs }` |\n| `end` | `{ reason, standings }` |\n\nEvents that arrive before a handler is attached are kept, and delivered in\norder when the first handler is attached. Fields and events a newer hub adds\nreach the game through the client unchanged.\n\n### Versions\n\nThis is protocol **1**, client **1.4.0**. Changes within version 1 only add:\ngames on older clients keep working. A change that would break a game becomes\nprotocol 2, with its own `hub:session` value.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015x2pBNh1Y9vsi8cE4GtX8N","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
