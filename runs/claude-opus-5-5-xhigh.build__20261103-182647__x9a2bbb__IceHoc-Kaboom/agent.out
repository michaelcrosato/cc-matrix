d' ? 'gamepad' : d === 'mouse' ? 'mouse' : d === 'touch' ? 'touch' : 'keyboard'; };\n  function codeFor(I, action, kind) {\n    const m = (I.map && I.map[action]) || []; if (kind === 'gamepad') return m.find(c => /^Pad\\d+$/.test(c)); if (kind === 'mouse') return m.find(c => /^Mouse\\d$/.test(c)) || m.find(c => !/^Pad|^Mouse|^Act:|^PadAxis/.test(c));\n    return m.find(c => !/^Pad|^Mouse|^Act:|^PadAxis/.test(c));\n  }\n  const W = (str, sc = 1) => E.font.width(str, { scale: sc });\n  /** draw one chip; returns its width. o: { input, device, scale } */\n  function chip(g, action, x, y, o = {}) {\n    const I = o.input || game.input, d = o.device || dev(I), sc = o.scale || 1, h = 9 * sc;\n    x = Math.round(x); y = Math.round(y);\n    if (d === 'gamepad') {\n      const code = codeFor(I, action, 'gamepad'); if (!code) return keycap(g, '?', x, y, sc);\n      const n = +code.slice(3), xb = xbox(I);\n      if (n <= 3) { const [ch, col] = (xb ? XB : PS)[n], r = 4.5 * sc; px.disc(g, x + r, y + r, r + .5, '#0c1018'); px.disc(g, x + r, y + r, r - .5, '#1e2636'); E.font.text(g, ch, x + r + .5, y + r - 3 * sc, col, { align: 'center', scale: sc, outline: false }); return Math.ceil(r * 2 + 1); }\n      if (n >= 4 && n <= 7) { const lab = SH[xb ? 'xb' : 'ps'][n - 4], w = W(lab, sc) + 6 * sc; px.rect(g, x, y, w, h, '#0c1018'); px.rect(g, x + 1, y + 1, w - 2, h - 2, '#2a3448'); px.rect(g, x + 1, y + 1, w - 2, 1, '#4a5a78'); E.font.text(g, lab, x + w / 2, y + 1 * sc, '#e8eef8', { align: 'center', scale: sc, outline: false }); return w; }\n      const lab = OTHER[xb ? 'xb' : 'ps'][n] || code; return keycap(g, lab, x, y, sc, '#2a3448');\n    }\n    if (d === 'mouse') { const code = codeFor(I, action, 'mouse'); if (code && /^Mouse/.test(code)) return mouse(g, +code.slice(5), x, y, sc); return keycap(g, code ? I.codeLabel(code) : '?', x, y, sc); }\n    if (d === 'touch') return keycap(g, action.toUpperCase(), x, y, sc);\n    const code = codeFor(I, action, 'keyboard'); return keycap(g, code ? I.codeLabel(code) : '?', x, y, sc);\n  }\n  function keycap(g, lab, x, y, sc = 1, bg = '#e8e4d8') {\n    lab = String(lab).toUpperCase(); const w = Math.max(9 * sc, W(lab, sc) + 6 * sc), h = 9 * sc, dark = bg !== '#e8e4d8';\n    px.rect(g, x, y + 1, w, h, '#0c1018'); px.rect(g, x, y, w, h - 1, dark ? bg : '#c8c4b8'); px.rect(g, x + 1, y, w - 2, h - 2, dark ? bg : bg); px.rect(g, x + 1, y, w - 2, 1, dark ? '#4a5a78' : '#ffffff');\n    E.font.text(g, lab, x + w / 2, y + 1 * sc, dark ? '#e8eef8' : '#1a1a22', { align: 'center', scale: sc, outline: false }); return Math.ceil(w);\n  }\n  function mouse(g, btn, x, y, sc = 1) {\n    const w = 7 * sc, h = 10 * sc; px.rect(g, x, y, w, h, '#0c1018'); px.rect(g, x + 1, y + 1, w - 2, h - 2, '#e8e4d8'); px.rect(g, x + 1, y + 4 * sc, w - 2, 1, '#8a8a90');\n    const lit = '#ffd36a'; if (btn === 0) px.rect(g, x + 1, y + 1, Math.floor((w - 2) / 2), 3 * sc, lit); else if (btn === 2) px.rect(g, x + Math.ceil(w / 2), y + 1, Math.floor((w - 2) / 2), 3 * sc, lit); else px.rect(g, x + Math.floor(w / 2) - 0, y + 1, 1 * sc, 3 * sc, '#e83a2a');\n    px.rect(g, x + Math.floor(w / 2), y + 1, 1, 3 * sc, '#8a8a90'); return w + 1;\n  }\n  /** the width of a chip (to center a prompt) */\n  function chipW(action, o = {}) { const cv = NODE ? null : (chipW._cv || (chipW._cv = E.mkCanvas(80, 30))); const g = cv ? cv.getContext('2d') : stubG; return chip(g, action, 0, 0, o); }\n  const stubG = { fillRect() {}, drawImage() {}, getImageData: () => ({ data: [] }), putImageData() {}, save() {}, restore() {}, set fillStyle(v) {}, get fillStyle() { return '#000'; }, set globalAlpha(v) {}, set globalCompositeOperation(v) {} };\n  /** text with {action} chips; o: { align, color, scale, input, shadow }; returns its width */\n  function text(g, str, x, y, o = {}) {\n    const parts = String(str).split(/(\\{[a-z]+\\})/), sc = o.scale || 1, col = o.color || '#eef4ff';\n    const widths = parts.map(p => /^\\{[a-z]+\\}$/.test(p) ? chipW(p.slice(1, -1), o) + 2 : E.font.width(p, { scale: sc }));\n    const total = widths.reduce((a, b) => a + b, 0);\n    let cx = o.align === 'center' ? x - total / 2 : o.align === 'right' ? x - total : x;\n    parts.forEach((p, i) => {\n      if (/^\\{[a-z]+\\}$/.test(p)) { chip(g, p.slice(1, -1), cx + 1, y - 1 * sc, o); }\n      else if (p) E.font.text(g, p, Math.round(cx), Math.round(y), col, { scale: sc, outline: false, shadow: o.shadow === undefined ? '#000' : o.shadow });\n      cx += widths[i];\n    });\n    return total;\n  }\n  /** a plain-text label for logs and hub tags: 'J', '✕', 'Left click' */\n  const label = (action, I = game.input) => { const d = dev(I), c = codeFor(I, action, d === 'mouse' ? 'mouse' : d === 'gamepad' ? 'gamepad' : 'keyboard'); if (!c) return '?'; if (/^Pad(\\d+)$/.test(c)) { const n = +c.slice(3); return n <= 3 ? (xbox(I) ? XB : PS)[n][0] : n <= 7 ? SH[xbox(I) ? 'xb' : 'ps'][n - 4] : OTHER[xbox(I) ? 'xb' : 'ps'][n]; } return I.codeLabel(c); };\n  return { chip, chipW, text, keycap, mouse, label, dev, PS, XB };\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01YGYK8bSistxFpBcxy1u4Qz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
