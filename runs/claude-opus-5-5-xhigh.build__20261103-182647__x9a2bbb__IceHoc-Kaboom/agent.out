{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgh25UWwC9LioNWKubquS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011eyy7Es7RHtAvchDHwDT4P","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-182647__x9a2bbb/work/IceHoc-Kaboom-IceHockey-claude-opus-5-5-xhigh-20261103-182647/engine/kits/sports.js"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":869,"cache_read_input_tokens":120772,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":869},"output_tokens":54,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2bfc1153-d85f-4cc7-a4e9-74837d1d317d","uuid":"ced9b46e-a7b5-4df0-b30f-79acfac23518","timestamp":"2026-11-04T01:27:50.117Z","request_id":"req_011Cgh25UGYypiMdmA1MKBeu","wire_tool_inputs":{"toolu_011eyy7Es7RHtAvchDHwDT4P":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-182647__x9a2bbb/work/IceHoc-Kaboom-IceHockey-claude-opus-5-5-xhigh-20261103-182647/engine/kits/sports.js"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011eyy7Es7RHtAvchDHwDT4P","type":"tool_result","content":"1\t// The SPORTS kit's game (two against two in a walled cage, up to four players: a ball that bounces and curls, passes, lobs, shots on a meter, formations, a match clock; Sensible Soccer and NBA Jam), readable: the starter's shell (src/starter/00-shell.js), then\n2\t// the slice from line 159 (src/starter/68-sports.js: its header says what it plays and how), then the start (90-start.js), as the\n3\t// single-file kit holds them between GAME START and GAME END. sports.html plays it; node kits/test.mjs sports runs it headless.\n4\t/* ============================== GAME START ==============================\n5\t * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n6\t * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n7\t * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n8\t * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n9\t * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n10\t * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n11\t * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n12\t * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n13\t * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n14\t * ======================================================================== */\n15\t(() => {\n16\t'use strict';\n17\tconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n18\t\n19\t/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n20\t * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\n21\tconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\n22\tconst P = game.particles, L = game.lights, A = game.audio;\n23\tconst scenes = {};\n24\tlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\n25\tconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n26\t// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n27\t// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\n28\tconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n29\t// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\n30\tconst SLICES = [\n31\t  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n32\t  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n33\t  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n34\t  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n35\t  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n36\t  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n37\t  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n38\t  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n39\t  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n40\t  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n41\t  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n42\t  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n43\t  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n44\t  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n45\t  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n46\t  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n47\t  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n48\t  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n49\t  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n50\t  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n51\t  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n52\t  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n53\t];\n54\t/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n55\t   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n56\t   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n57\t   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\n58\tconst camOpt = () => (game.scene && game.scene.camera) || {};\n59\taddEventListener('keydown', e => {\n60\t  if (e.repeat) return;\n61\t  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n62\t  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n63\t  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n64\t  else if (e.code === 'KeyM') A.mute();\n65\t  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n66\t});\n67\t\n68\t/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n69\t * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\n70\tconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n71\t  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\n72\tconst titleBg = new E.Backdrop('castle-night');\n73\tconst HEROES = [   // six heroes, each dressed with the HD rig options\n74\t  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n75\t  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n76\t  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n77\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n78\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n79\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n80\t];\n81\tHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n82\t// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\n83\tconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n84\t// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\n85\tconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n86\t/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n87\t * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n88\t * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n89\t * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n90\t * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\n91\tconst proof = (id, n, script, state, fresh) => {\n92\t  const was = Math.random, I = game.input, held = new Set();\n93\t  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n94\t  Math.random = E.rng(7);\n95\t  try {\n96\t    if (fresh) fresh();\n97\t    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n98\t    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n99\t    const s = JSON.stringify(state()); let h = 2166136261;\n100\t    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n101\t    return h >>> 0;\n102\t  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n103\t};\n104\t// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\n105\tconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n106\t// START picks too (the touch START, a pad's Start), as Enter does: any player's\n107\tconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n108\t/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n109\t *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\n110\tconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\n111\tlet titleMenu = null;   // (made at the start, once the file's slices are known)\n112\tscenes.title = {\n113\t  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n114\t  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n115\t  update(dt) {\n116\t    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n117\t    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n118\t    const t = game.time;\n119\t    HEROES.forEach((h, i) => {\n120\t      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n121\t      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n122\t    });\n123\t  },\n124\t  draw(r) {\n125\t    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n126\t    titleMenu.y = 76 + top;\n127\t    titleBg.draw(r);\n128\t    stage.draw(r);\n129\t    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n130\t    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n131\t    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n132\t    r.overlay(g => {\n133\t      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n134\t      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n135\t      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n136\t    });\n137\t    titleMenu.draw(r);\n138\t    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n139\t      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n140\t    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n141\t  }\n142\t};\n143\t\n144\t/* ---- GAME OVER: shared by every slice ---- */\n145\tconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\n146\tconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n147\t  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\n148\tscenes.over = {\n149\t  view: 'side', input: 'DEFAULT', res: 'ps1',\n150\t  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n151\t  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n152\t  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n153\t  draw(r) {   // centred on any screen\n154\t    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n155\t    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n156\t  }\n157\t};\n158\t\n159\t/* =====================================================================================\n160\t * SLICE 22  SPORTS  (Sensible Soccer, NBA Jam, Tecmo Bowl).\n161\t * Two against two in a walled cage, for up to four players: the GULLS against the RUST, two halves on the clock, a\n162\t * golden goal if it ends level. The ball is a Body: it rolls, bounces off the ground and the boards, and curls.\n163\t * KEYS: the stick runs; J passes (to the teammate the stick points at, led to where it is going), L lobs one over a\n164\t * defender (its arc solved by E.arc to land at the teammate's feet), K held fills the shot meter and shoots on letting go\n165\t * (the stick across the goal aims it; pushed sideways just after, it curls: aftertouch). Without the ball: J slides in\n166\t * to tackle, K switches to the teammate nearer the ball. TOUCH: the stick, PASS, SHOOT (hold), LOB.\n167\t * PLAYERS: MATCH is you against the CPU; VERSUS lets players 2 to 4 in (2 on the keyboard, or Start on a pad): player 2\n168\t * takes the RUST, 3 and 4 the second of each side. The rest are run by formation: with the ball, the other one runs\n169\t * ahead on the far side; without it, the nearer presses and the other covers the goal. Commentary on Dialog's radio.\n170\t * Deep links: #sports/match (a match against the CPU), #sports/vs (VERSUS: players 2 to 4 join).\n171\t * HOW IT WORKS: a TileMap cage (boards that cut low before the camera, nets), the ball and the players as E.Body, rigs\n172\t * that kick and slide (E.Attack), E.arc for the lob, game.allowJoin for players; SPORTS.run(n) is the proof,\n173\t * SPORTS.bot() plays a match through to its whistle and then a short one with four players.\n174\t * ===================================================================================== */\n175\tconst SPORTS = (() => {\n176\t  const A = game.audio, T = 16, FW = 36, FH = 22, ND = 2, GOAL = 5, BAR = 28, HALF = 60, GOLDEN = 45, PI = Math.PI;\n177\t  /* ---- THE CAGE: a field of FW x FH tiles inside boards (cut low where they hide it), a goal in each end with its net,\n178\t   * a stand of three tiers behind the north boards; built from rows: # boards, N net, . the field, : the net's floor,\n179\t   * 1 2 3 the stand's tiers (back to front), , outside ---- */\n180\t  const STAND = 3, COLS = ND + FW + 2 + ND, ROWS = STAND + FH + 2, MID = FH / 2, goalRow = r => r > MID - GOAL / 2 && r <= MID + GOAL / 2;\n181\t  const rows = [];\n182\t  for (let R = 0; R < ROWS; R++) {\n183\t    let s = ''; const r = R - STAND;   // (the cage's own row)\n184\t    for (let c = 0; c < COLS; c++) {\n185\t      const field = c > ND && c <= ND + FW && r > 0 && r <= FH, endCol = c === ND || c === ND + FW + 1, net = (c < ND || c > ND + FW + 1);\n186\t      if (r < 0) s += c >= ND && c <= ND + FW + 1 ? String(R + 1) : ',';\n187\t      else if (field) s += '.';\n188\t      else if (endCol && r > 0 && r <= FH) s += goalRow(r) ? '.' : '#';\n189\t      else if ((r === 0 || r === FH + 1) && c >= ND && c <= ND + FW + 1) s += '#';\n190\t      else if (net && goalRow(r)) s += c === 0 || c === COLS - 1 ? 'N' : ':';\n191\t      else if (net && (goalRow(r + 1) || goalRow(r - 1))) s += 'N';\n192\t      else s += ',';\n193\t    }\n194\t    rows.push(s);\n195\t  }\n196\t  const X0 = (ND + 1) * T, X1 = (ND + 1 + FW) * T, Y0 = (STAND + 1) * T, Y1 = (STAND + FH + 1) * T, CX = (X0 + X1) / 2, CY = (Y0 + Y1) / 2, GH = GOAL * T / 2;\n197\t  // the pitch: mown stripes with the grass's own grain, painted lines a little worn (the halfway line, the centre circle,\n198\t  // an arc before each goal), the nets' shadow on their floor, tarmac outside\n199\t  const line = (x, y) => {\n200\t    const d = Math.hypot(x - CX, y - CY), ex = Math.min(Math.abs(x - X0), Math.abs(x - X1)), ey = Math.min(Math.abs(y - Y0), Math.abs(y - Y1));\n201\t    if (ex < 1.5 || ey < 1.5 || Math.abs(x - CX) < 1 || Math.abs(d - 48) < 1) return true;\n202\t    for (const gx of [X0, X1]) if (Math.abs(Math.hypot(x - gx, y - CY) - 72) < 1 && Math.abs(x - gx) < 72) return true;\n203\t    return false;\n204\t  };\n205\t  const floorTex = (x, y, tag) => {\n206\t    const n = E.hash2(Math.floor(x), Math.floor(y)) - .5, m = E.noise2(x * .06, y * .06) * .5;\n207\t    if (tag === 'net') { const mesh = Math.floor(x) % 4 === 0 || Math.floor(y) % 4 === 0; return mesh ? [30, 66, 36] : [44 + n * 10, 92 + n * 14, 50 + n * 10]; }\n208\t    if (tag === 'out') return [44 + n * 18, 42 + n * 18, 50 + n * 18];\n209\t    if (line(x, y)) { const w = 228 + n * 24 + m * 10; return [w, w + 4, w - 8]; }\n210\t    const k = Math.floor((x - X0) / 32) % 2 ? 1 : 0, g = (k ? 140 : 106) + n * 34 + m * 24;   // (a stripe mown each way: lighter, darker)\n211\t    return [g * .42, g, g * .46];\n212\t  };\n213\t  let map = null;\n214\t  const makeMap = () => new E.TileMap({ rows, legend: { '#': 1, N: 2, 1: 5, 2: 4, 3: 3, '.': { floor: 'grass' }, ':': { floor: 'net' }, ',': { floor: 'out' } }, floorTex, outside: '#1e1c24', ao: 4,\n215\t    types: { 1: { h: 26, cut: true, cutH: 6, face: 'plank', side: '#3a4a6a', top: '#d8dce8', line: '#2a3450' }, 2: { h: BAR + 4, face: 'none', side: '#b8bcc8', top: '#e0e4ec' },\n216\t      3: { h: 34, face: 'stone', side: '#5a5468', top: '#6a6478' }, 4: { h: 44, face: 'stone', side: '#4e4a5e', top: '#5e586e' }, 5: { h: 54, face: 'stone', side: '#44405a', top: '#544e66' } } });\n217\t  // the crowd: two on each tile of the stand, in their colors, bobbing; on a goal, those of the side that scored jump\n218\t  const CROWD = [];\n219\t  for (let R = 0; R < STAND; R++) for (let c = ND; c <= ND + FW + 1; c++) for (const dx of [4, 12]) {\n220\t    const h = E.hash2(c * 3 + dx, R * 7 + 1), side = h < .5 ? 0 : 1;\n221\t    CROWD.push({ x: c * T + dx, y: R * T + 9, z: [54, 44, 34][R], side, shirt: side ? ['#c8502a', '#e07040', '#a83a1a'][(h * 30 | 0) % 3] : ['#eef0f6', '#2a5ab8', '#8ab0f0'][(h * 30 | 0) % 3], skin: ['#e0b090', '#a87050', '#6a4028', '#f0c8a8'][(h * 50 | 0) % 4], ph: h * 9 });\n222\t  }\n223\t  /* ---- THE TEAMS: their colors, names and players; the ball ---- */\n224\t  const TEAMS = [\n225\t    { name: 'GULLS', colors: { cloth: '#eef0f6', pants: '#2a5ab8', boot: '#1e2030', belt: '#2a5ab8', trim: '#2a5ab8' }, chip: '#eef0f6', players: [['NOOR', '#3a2418', '#c89070'], ['BEX', '#e8c070', '#f0c8a8']] },\n226\t    { name: 'RUST', colors: { cloth: '#c8502a', pants: '#2a2a30', boot: '#1a1a1e', belt: '#1a1a1e', trim: '#e8c070' }, chip: '#c8502a', players: [['DRAGO', '#1e1c1a', '#a87050'], ['KIT', '#6a3a22', '#e0b090']] }];\n227\t  const SPEED = 92, AI_SPEED = 86, KICK_CD = .3;\n228\t  const BALL = E.sprite(['.www.', 'wwkww', 'wkkkw', 'wwkww', '.www.'], { w: '#f4f4f0', k: '#2a2a30' });\n229\t  const BALL2 = E.sprite(['.www.', 'wkwkw', 'wwwww', 'wkwkw', '.www.'], { w: '#f4f4f0', k: '#2a2a30' });\n230\t  const SOUNDS = {\n231\t    kick: { wave: 'noise', freq: 900, to: 200, dur: .07, vol: .3, filter: 'lowpass' }, thump: { wave: 'sine', freq: 120, to: 70, dur: .08, vol: .3 },\n232\t    whistle: { wave: 'square', freq: 2200, vib: [30, .05], dur: .32, vol: .14 }, post: { wave: 'triangle', freq: 1400, to: 1100, dur: .3, vol: .25 },\n233\t    crowd: { wave: 'noise', freq: 600, to: 900, dur: 1.4, vol: .18, filter: 'lowpass' }, slide: { wave: 'noise', freq: 400, to: 200, dur: .25, vol: .18 }\n234\t  };\n235\t  for (const [k, v] of Object.entries(SOUNDS)) A.define(k, v);\n236\t  const SONG = { bpm: 140, steps: 4, tracks: [   // the cage: a bright chant over a bouncing bass\n237\t    { wave: 'square', vol: .07, notes: 'E5 . E5 G5 . E5 D5 . | C5 . C5 E5 . C5 B4 . | A4 . C5 . E5 . A5 . | G5 - - . . . . .' },\n238\t    { wave: 'triangle', vol: .3, notes: 'C3 . G2 . C3 . G2 . | A2 . E2 . A2 . E2 . | F2 . C3 . F2 . C3 . | G2 . D3 . G2 . B2 .' },\n239\t    { wave: 'drums', vol: .1, notes: 'k . h . s . h k | k . h . s h h .' }] };\n240\t\n241\t  /* ---- THE STATE ---- */\n242\t  let mode = 'menu', vs = false, team = [], all = [], ball = null, owner = null, last = null, clock = 0, half = 1, score = [0, 0], kickT = 0, t = 0, scripted = false;\n243\t  let stats = null, curlT = 0, golden = false, restartBy = 0, over = false, kickHold = 0;   // kickHold: the kickoff's rule (the other side out of the circle) until the ball is played\n244\t  const menu = new E.Menu(game, ['MATCH', 'VERSUS (2-4 PLAYERS)', 'BACK'], { onPick: i => i === 2 ? game.go('title') : i === 1 ? versus() : start(false) });\n245\t  const after = new E.Menu(game, ['REMATCH', 'MENU'], { y: 150, onPick: i => i === 0 ? start(vs) : toMenu() });\n246\t  const talk = new E.Dialog(game, { lines: 2, place: 'bottom', border: '#e8c070' });   // (at the bottom: clear of the score and of the touch buttons)\n247\t  const VOICE = new E.Humanoid({ weapon: null, hat: 'band', colors: { cloth: '#3a3a4a', hair: '#5a3a2a', skin: '#e0b090', hat: '#2a2a30' } });\n248\t  const say = text => { if (!scripted) talk.say(text, { name: 'CAGE RADIO', auto: 2.2, modal: false, alpha: .8, portrait: VOICE, portraitOpts: { zoom: 3, turn: .4 } }); };\n249\t\n250\t  function toMenu() { mode = 'menu'; game.splitScreen(0); game.allowJoin(false); A.music('title'); menu.i = 0; }\n251\t  function versus() { vs = true; mode = 'join'; game.allowJoin({ max: 4 }); A.sfx('select'); }\n252\t  /** a match: the four on the pitch, the ball at the centre, the clock at 0; players: who holds which (the inputs) */\n253\t  function start(versus) {\n254\t    vs = versus; map = map || makeMap(); score = [0, 0]; clock = 0; half = 1; golden = false; over = false; owner = null; last = null;\n255\t    stats = { passes: 0, done: 0, shots: 0, lobs: 0, tackles: 0, goals: [], walls: 0, curled: 0 };\n256\t    all = []; team = [[], []];\n257\t    TEAMS.forEach((tm, s) => tm.players.forEach(([name, hair, skin], k) => {\n258\t      const b = new E.Body({ x: CX, y: CY, r: 5, friction: 0, gravity: 700 });\n259\t      const p = { side: s, k, name, body: b, rig: new E.Humanoid({ weapon: null, build: 'heroic', size: 1.05, hair: k ? 'spiky' : 'short', colors: Object.assign({ hair, skin }, tm.colors), speedRef: 80 }),\n260\t        input: null, facing: s ? PI : 0, kick: null, slide: 0, stun: 0, cool: 0, meter: 0, charging: false, cheer: 0 };\n261\t      team[s].push(p); all.push(p);\n262\t    }));\n263\t    // who holds whom: player 1 the GULLS' first (and, alone, whichever GULL is nearer the ball); in versus 2 the RUST, 3 and 4\n264\t    // the second of each side\n265\t    const P = game.players;\n266\t    team[0][0].input = P[0];\n267\t    if (vs) { if (P[1]) team[1][0].input = P[1]; if (P[2]) team[0][1].input = P[2]; if (P[3]) team[1][1].input = P[3]; }\n268\t    ball = new E.Body({ x: CX, y: CY, r: 3, friction: 0, bounce: .55, gravity: 600 }); ball.spin = 0; ball.roll = 0;\n269\t    kickoff(0); game.allowJoin(false); A.music(SONG); game.input.consumeAll();\n270\t    game.follow(ball, { z: 8, lead: 10 }); game.cam.smooth = .18; game.cam.bounds = v => map.bounds(v);\n271\t    say('THE GULLS AGAINST THE RUST IN THE CAGE. HERE WE GO!');\n272\t  }\n273\t  /** the formation's spots: kicking off (s kicks), or in play (a team's two by where the ball is and who has it) */\n274\t  const goalX = s => s ? X0 : X1;   // where side s shoots (the GULLS attack the right end)\n275\t  function kickoff(s) {\n276\t    owner = null; ball.x = CX; ball.y = CY; ball.z = 0; ball.onGround = true; ball.vx = ball.vy = ball.vz = 0; ball.spin = 0;\n277\t    for (const p of all) {\n278\t      const dir = p.side ? 1 : -1, b = p.body;\n279\t      b.x = p.side === s && p.k === 0 ? CX + dir * 8 : CX + dir * (p.k ? 150 : 60); b.y = p.side === s && p.k === 0 ? CY : CY + (p.k ? 40 : -40) * (p.side ? -1 : 1);\n280\t      b.vx = b.vy = 0; b.z = 0; p.facing = p.side ? PI : 0; p.kick = null; p.slide = 0; p.stun = 0; p.meter = 0; p.charging = false;\n281\t    }\n282\t    mode = 'kickoff'; kickT = 1; restartBy = s;\n283\t  }\n284\t  /** a player's spot in the formation now: with the ball (or near it), go for it; else, attacking, ahead on the far\n285\t   *  side; defending, between the ball and its own goal */\n286\t  function spot(p) {\n287\t    const s = p.side, mate = team[s][1 - p.k], dir = s ? -1 : 1, has = owner && owner.side === s;\n288\t    if (has) return [clamp(ball.x + dir * 90, X0 + 30, X1 - 30), CY + (ball.y < CY ? 60 : -60)];\n289\t    const own = goalX(1 - s), near = Math.hypot(p.body.x - ball.x, p.body.y - ball.y) <= Math.hypot(mate.body.x - ball.x, mate.body.y - ball.y);\n290\t    if (near) return [ball.x, ball.y];\n291\t    return [lerp(ball.x, own, .55), lerp(ball.y, CY, .5)];\n292\t  }\n293\t\n294\t  /* ---- THE BALL: owned (at its owner's feet), or loose: a Body that rolls, bounces off the ground and the boards and\n295\t   * curls by its spin; a goal, over the bar, out of the cage ---- */\n296\t  function ballStep(dt) {\n297\t    if (owner) {\n298\t      const b = owner.body, f = owner.facing; ball.x = b.x + Math.cos(f) * 7; ball.y = b.y + Math.sin(f) * 7; ball.z = 0; ball.onGround = true;\n299\t      ball.vx = b.vx; ball.vy = b.vy; ball.vz = 0; ball.roll += Math.hypot(b.vx, b.vy) * dt; return;\n300\t    }\n301\t    const vx0 = ball.vx, vy0 = ball.vy, sp = Math.hypot(ball.vx, ball.vy);\n302\t    if (ball.spin && sp > 20) { const k = ball.spin * dt; ball.vx += -vy0 / sp * k * sp; ball.vy += vx0 / sp * k * sp; ball.spin *= Math.exp(-dt * 1.4); }   // curl: across its path\n303\t    if (ball.z <= .5) { const f = Math.exp(-dt * 1.1); ball.vx *= f; ball.vy *= f; }   // rolling slows it\n304\t    ball.update(dt, map);   // (the Body bounces off the boards and the ground by its bounce)\n305\t    if (ball.hitWall) { ball.spin = 0; stats.walls++; if (Math.hypot(vx0, vy0) > 60) A.sfx('thump'); }\n306\t    if (ball.bounced) A.sfx('thump');\n307\t    ball.roll += Math.hypot(ball.vx, ball.vy) * dt;\n308\t    // a goal: over the line between the posts and under the bar; over it, a goal kick; out of the cage, thrown back in\n309\t    for (const s of [0, 1]) {\n310\t      const gx = goalX(s), past = s ? ball.x < gx - 2 : ball.x > gx + 2;\n311\t      if (past && Math.abs(ball.y - CY) < GH && ball.z < BAR) return goal(s);\n312\t      if (past && (ball.z >= BAR || Math.abs(ball.y - CY) >= GH)) return restart(1 - s, s ? X0 + 24 : X1 - 24, CY, 'OVER THE BAR. A GOAL KICK');\n313\t    }\n314\t    if (ball.x < X0 - 40 || ball.x > X1 + 40 || ball.y < Y0 - 4 || ball.y > Y1 + 4) restart(last ? 1 - last.side : 0, clamp(ball.x, X0 + 12, X1 - 12), clamp(ball.y, Y0 + 12, Y1 - 12), 'OUT OF THE CAGE! THROWN BACK IN');\n315\t  }\n316\t  /** play goes on from (x, y) with the ball at the feet of side s's nearer player */\n317\t  function restart(s, x, y, line) {\n318\t    const p = team[s].slice().sort((a, b) => Math.hypot(a.body.x - x, a.body.y - y) - Math.hypot(b.body.x - x, b.body.y - y))[0];\n319\t    p.body.x = x - (s ? -8 : 8); p.body.y = y; p.facing = s ? PI : 0; owner = p; ball.spin = 0; A.sfx('whistle'); if (line) say(line);\n320\t  }\n321\t  function goal(s) {\n322\t    score[s]++; stats.goals.push([s, last ? last.name : '?', Math.round(clock)]); owner = null; mode = 'goal'; kickT = 2.4; restartBy = 1 - s;\n323\t    for (const p of team[s]) p.cheer = 2.4; game.shake(3); A.sfx('crowd'); A.sfx('whistle');\n324\t    P.sparks(ball.x, ball.y, 16, 16, null, { color: '#ffe08a' }); P.ring(ball.x, ball.y, 4, 34, '#fff6c0', .5);\n325\t    say(golden ? 'GOLDEN GOAL! ' + (last ? last.name : '') + ' WINS IT FOR THE ' + TEAMS[s].name + '!' : 'GOAL! ' + (last ? last.name + ' SCORES FOR THE ' : 'THE ') + TEAMS[s].name + '! ' + score[0] + ' - ' + score[1]);\n326\t    if (golden) { over = true; }\n327\t  }\n328\t\n329\t  /* ---- KICKS: a pass along the ground led to the teammate, a lob over by E.arc, a shot from the meter with aftertouch ---- */\n330\t  /** the teammate a pass goes to: the one the stick points at (within 70 degrees), else the other */\n331\t  const mateOf = p => team[p.side][1 - p.k];\n332\t  function pass(p) {\n333\t    const m = mateOf(p), b = p.body, d = Math.hypot(m.body.x - b.x, m.body.y - b.y), sp = clamp(d * 1.5 + 90, 150, 270), lead = d / sp;\n334\t    const tx = m.body.x + m.body.vx * lead * .8, ty = m.body.y + m.body.vy * lead * .8, a = Math.atan2(ty - b.y, tx - b.x);\n335\t    release(p, Math.cos(a) * sp, Math.sin(a) * sp, 0); stats.passes++; ball.to = m;\n336\t  }\n337\t  function lob(p) {\n338\t    const m = mateOf(p), lead = .55, tx = m.body.x + m.body.vx * lead, ty = m.body.y + m.body.vy * lead;\n339\t    const v = E.arc({ x: ball.x, y: ball.y, z: 0 }, { x: tx, y: ty, z: 0 }, ball.gravity, { apex: 30 });\n340\t    release(p, v.vx, v.vy, v.vz); stats.lobs++; stats.passes++; ball.to = m;\n341\t  }\n342\t  /** a shot: power from the meter (0..1), aimed across the goal mouth by the stick's up and down */\n343\t  function shoot(p, power, aimY) {\n344\t    const gx = goalX(p.side), gy = CY + clamp(aimY, -1, 1) * (GH - 6), b = p.body, a = Math.atan2(gy - b.y, gx - b.x), sp = 170 + power * 230;\n345\t    release(p, Math.cos(a) * sp, Math.sin(a) * sp, 30 + power * 95); stats.shots++; curlT = .4; ball.to = null; A.sfx('kick');\n346\t  }\n347\t  function release(p, vx, vy, vz) {\n348\t    owner = null; last = p; kickHold = 0; ball.vx = vx; ball.vy = vy; ball.vz = vz; ball.onGround = vz <= 0; ball.spin = 0; p.cool = KICK_CD; p.kick = new E.Attack('kick'); p.kick.start(); A.sfx('kick');\n349\t  }\n350\t  /** a slide tackle: a dash along its facing; whoever it meets with the ball loses it */\n351\t  function tackle(p) { p.slide = .35; p.kick = new E.Attack('sweep'); p.kick.start(); stats.tackles++; A.sfx('slide'); const b = p.body; b.vx = Math.cos(p.facing) * 170; b.vy = Math.sin(p.facing) * 170; }\n352\t\n353\t  /* ---- A PLAYER'S STEP: from its input (a human's) or its brain (the formation's), then its body and its rig ---- */\n354\t  function playerStep(p, dt) {\n355\t    const b = p.body; p.cool = Math.max(0, p.cool - dt); p.stun = Math.max(0, p.stun - dt); p.cheer = Math.max(0, p.cheer - dt);\n356\t    let mx = 0, my = 0;\n357\t    if (p.slide > 0) { p.slide -= dt; const f = Math.exp(-dt * 3); b.vx *= f; b.vy *= f; }\n358\t    else if (p.stun > 0 || mode !== 'play') { b.vx = approach(b.vx, 0, 600 * dt); b.vy = approach(b.vy, 0, 600 * dt); }\n359\t    else {\n360\t      const c = p.input ? human(p, dt) : brain(p, dt); mx = c.move[0]; my = c.move[1];\n361\t      const sp = p.input ? SPEED : AI_SPEED, m = Math.hypot(mx, my);\n362\t      b.vx = approach(b.vx, mx * sp, 900 * dt); b.vy = approach(b.vy, my * sp, 900 * dt);\n363\t      if (m > .2) p.facing = E.approachAng(p.facing, Math.atan2(my, mx), dt * (owner === p ? 9 : 14));\n364\t      act(p, c, dt);\n365\t    }\n366\t    b.update(dt, map);\n367\t    // the loose ball: whoever reaches it first takes it (not just after kicking it, nor a ball high in the air, and a fast one only\n368\t    // right at its feet)\n369\t    if (!owner && mode === 'play' && p.cool <= 0 && p.stun <= 0 && ball.z < 9 && Math.hypot(ball.x - b.x, ball.y - b.y) < (Math.hypot(ball.vx, ball.vy) > 210 ? 4.5 : 9)) {   // (a hard shot is hard to trap)\n370\t      owner = p; ball.spin = 0; if (ball.to === p && last && last.side === p.side) stats.done++; ball.to = null;\n371\t      if (p.slide > 0) p.slide = 0;\n372\t    }\n373\t    // a slide that meets the ball's holder knocks it loose\n374\t    if (p.slide > 0 && owner && owner.side !== p.side && Math.hypot(owner.body.x - b.x, owner.body.y - b.y) < 12) {\n375\t      const o = owner; owner = null; o.stun = .5; last = p; ball.vx = Math.cos(p.facing) * 120; ball.vy = Math.sin(p.facing) * 120; ball.vz = 40; ball.onGround = false; p.cool = .2; A.sfx('thump');\n376\t    }\n377\t    if (p.kick) { p.kick.update(dt); if (!p.kick.busy) p.kick = null; }\n378\t    p.rig.update(dt, { x: b.x, y: b.y, z: b.z, vx: b.vx, vy: b.vy, facing: p.facing, attack: p.kick && p.kick.state, hurt: p.stun > 0, pose: p.cheer > 0 ? 'cheer' : null, expr: p.cheer > 0 ? 'shout' : null });\n379\t  }\n380\t  /** what a human's input asks: the stick; pass, lob, the shot's meter (held), a tackle or a switch */\n381\t  function human(p, dt) {\n382\t    const I = p.input, mv = I.move(), c = { move: mv, pass: I.pressed('pass'), lob: I.pressed('lob'), shootHeld: I.down('shoot'), shootUp: I.released('shoot'), aim: mv[1] * (p.side ? -1 : 1) };\n383\t    if (c.pass) I.consume('pass'); if (c.lob) I.consume('lob');\n384\t    // aftertouch: just after a shot, the stick across its path curls the ball\n385\t    if (curlT > 0 && last === p && !owner) { const sp = Math.hypot(ball.vx, ball.vy) || 1, across = (mv[0] * -ball.vy + mv[1] * ball.vx) / sp; if (Math.abs(across) > .3) { ball.spin = clamp(ball.spin + across * 3.2 * dt, -1.6, 1.6); stats.curled++; } }\n386\t    return c;\n387\t  }\n388\t  /** the CPU's footballer: to its spot in the formation; with the ball, run at goal, pass when pressed, shoot in range */\n389\t  function brain(p, dt) {\n390\t    const b = p.body, c = { move: [0, 0], pass: false, lob: false, shootHeld: false, shootUp: false, aim: 0 }, s = p.side;\n391\t    if (owner === p) {\n392\t      const gx = goalX(s), dg = Math.hypot(gx - b.x, CY - b.y), foe = team[1 - s].find(o => Math.hypot(o.body.x - b.x, o.body.y - b.y) < 30 && Math.abs(E.angDiff(Math.atan2(o.body.y - b.y, o.body.x - b.x), p.facing)) < 1.2);\n393\t      const a = Math.atan2(CY - b.y, gx - b.x); c.move = [Math.cos(a), Math.sin(a)];\n394\t      const shot = (meter, aim) => { c.shootHeld = p.meter < meter; c.shootUp = !c.shootHeld; c.aim = b.y < CY ? aim : -aim; };   // (held until the meter is where it wants it)\n395\t      if (dg < 95 && p.cool <= 0) shot(.4, .45);   // close in: shoot, pressed or not\n396\t      else if (foe) { const m = mateOf(p), lane = team[1 - s].some(o => segDist(o.body, b, m.body) < 14); if (p.cool <= 0) { if (lane) c.lob = true; else c.pass = true; } else c.move = [Math.cos(a + 1.1), Math.sin(a + 1.1)]; }\n397\t      else if (dg < 160 && p.cool <= 0) shot(.55 + p.k * .2, .55);\n398\t      return c;\n399\t    }\n400\t    let [tx, ty] = spot(p);\n401\t    if (kickHold > 0 && s !== restartBy) { const cd = Math.hypot(tx - CX, ty - CY) || 1; if (cd < 56) { tx = CX + (tx - CX) / cd * 56; ty = CY + (ty - CY) / cd * 56; } }   // (the kickoff: out of the circle)\n402\t    const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy);\n403\t    if (d > 6) c.move = [dx / d, dy / d];\n404\t    // pressing the holder: slide in when close and in front of it\n405\t    if (owner && owner.side !== s && d < 18 && p.cool <= 0 && Math.hypot(owner.body.x - b.x, owner.body.y - b.y) < 16) c.pass = true;\n406\t    return c;\n407\t  }\n408\t  const segDist = (o, a, b) => { const vx = b.x - a.x, vy = b.y - a.y, l = vx * vx + vy * vy || 1, u = clamp(((o.x - a.x) * vx + (o.y - a.y) * vy) / l, 0, 1); return Math.hypot(a.x + vx * u - o.x, a.y + vy * u - o.y); };\n409\t  /** the buttons: with the ball, pass, lob or the shot's meter; without it, a tackle (pass) or a switch (shoot) */\n410\t  function act(p, c, dt) {\n411\t    if (owner === p) {\n412\t      if (c.pass && p.cool <= 0) return pass(p);\n413\t      if (c.lob && p.cool <= 0) return lob(p);\n414\t      if (c.shootHeld) { p.charging = true; p.meter = Math.min(1, p.meter + dt * 1.25); }\n415\t      else if (p.charging && (c.shootUp || !c.shootHeld)) { p.charging = false; shoot(p, p.meter, c.aim); p.meter = 0; }\n416\t      return;\n417\t    }\n418\t    p.charging = false; p.meter = 0;\n419\t    if (c.pass && p.cool <= 0 && p.slide <= 0 && !(kickHold > 0 && p.side !== restartBy)) tackle(p);\n420\t    else if (c.shootUp && p.input && !vs) swap(p);\n421\t  }\n422\t  /** player 1 alone holds whichever GULL is nearer the ball when the other side has it (or K switches) */\n423\t  function swap(p) { const m = mateOf(p); if (m.input) return; m.input = p.input; p.input = null; }\n424\t  function autoSwitch() {\n425\t    if (vs) return;\n426\t    const s = 0, cur = team[s].find(p => p.input), m = cur && mateOf(cur);\n427\t    if (!cur || !m || m.input) return;\n428\t    if (owner === m || (ball.to === m) || ((!owner || owner.side !== s) && Math.hypot(m.body.x - ball.x, m.body.y - ball.y) + 24 < Math.hypot(cur.body.x - ball.x, cur.body.y - ball.y))) swap(cur);\n429\t  }\n430\t\n431\t  /* ---- A STEP OF THE MATCH: the clock, the halves, golden goal, the whistle ---- */\n432\t  function update(dt) {\n433\t    t += dt;\n434\t    if (mode === 'menu') { if (!menu.update(dt)) pickOnStart(menu); return; }\n435\t    if (mode === 'join') {\n436\t      if (game.input.pressed('start') || game.input.pressed('confirm')) { game.input.consumeAll(); start(true); }\n437\t      else if (game.input.pressed('cancel')) toMenu();\n438\t      return;\n439\t    }\n440\t    if (mode === 'full') { after.update(dt); for (const p of all) playerStep(p, dt); return; }\n441\t    talk.update(dt);\n442\t    if (mode === 'kickoff' || mode === 'goal' || mode === 'half') {\n443\t      for (const p of all) playerStep(p, dt);\n444\t      if ((kickT -= dt) <= 0) {\n445\t        if (mode === 'goal' && over) return fullTime();\n446\t        if (mode === 'goal' || mode === 'half') kickoff(restartBy);\n447\t        else { mode = 'play'; owner = team[restartBy][0]; kickHold = 2.5; A.sfx('whistle'); }\n448\t      }\n449\t      return;\n450\t    }\n451\t    clock += dt; kickHold = Math.max(0, kickHold - dt);\n452\t    for (const p of all) playerStep(p, dt);\n453\t    ballStep(dt); curlT = Math.max(0, curlT - dt); autoSwitch();\n454\t    if (!golden && half === 1 && clock >= HALF) { half = 2; mode = 'half'; kickT = 2.4; restartBy = 1; owner = null; A.sfx('whistle'); say('HALF TIME: GULLS ' + score[0] + ', RUST ' + score[1] + '.'); }\n455\t    else if (!golden && clock >= HALF * 2) {\n456\t      if (score[0] === score[1]) { golden = true; clock = HALF * 2; A.sfx('whistle'); say('LEVEL AT FULL TIME: GOLDEN GOAL! THE NEXT ONE WINS IT.'); kickoff(0); }\n457\t      else fullTime();\n458\t    } else if (golden && clock >= HALF * 2 + GOLDEN) fullTime();\n459\t  }\n460\t  function fullTime() {\n461\t    mode = 'full'; over = true; owner = null; A.sfx('whistle'); after.i = 0;\n462\t    const w = score[0] > score[1] ? 0 : score[1] > score[0] ? 1 : -1; for (const p of all) p.cheer = p.side === w ? 99 : 0;\n463\t    say(w < 0 ? 'FULL TIME: A DRAW IN THE CAGE.' : 'FULL TIME! THE ' + TEAMS[w].name + ' WIN IT, ' + Math.max(...score) + ' - ' + Math.min(...score) + '.');\n464\t    if (!scripted) A.music(w === 0 || vs ? 'victory' : null);\n465\t  }\n466\t\n467\t  /* ---- DRAWING: the cage, the posts, the players, the ball and its shadow; the score, the clock, the meter, the radar ---- */\n468\t  function draw(r) {\n469\t    if (mode === 'menu' || mode === 'join') return drawMenu(r);\n470\t    const view = E.charView(r.view);\n471\t    map.drawFloor(r); map.queueWalls(r);\n472\t    for (const f of CROWD) {   // (cheering on the scoring side's goal, else a sway)\n473\t      const up = mode === 'goal' && stats.goals.length && stats.goals[stats.goals.length - 1][0] === f.side ? Math.abs(Math.sin(t * 9 + f.ph)) * 5 : Math.sin(t * 2 + f.ph) * .6;\n474\t      r.queue(f.x, f.y, f.z + up, g => { const [x, y] = r.w(f.x, f.y, f.z + up), X = Math.round(x), Y = Math.round(y); px.rect(g, X - 2, Y - 5, 4, 5, f.shirt); px.rect(g, X - 1, Y - 8, 3, 3, f.skin); });\n475\t    }\n476\t    for (const gx of [X0, X1]) for (const py of [CY - GH, CY + GH]) r.queue(gx, py, 0, g => { const [x, y] = r.w(gx, py, 0), [, y1] = r.w(gx, py, BAR); px.rect(g, Math.round(x) - 1, Math.round(y1), 2, Math.round(y - y1), '#f4f4f0'); });\n477\t    for (const gx of [X0, X1]) r.queue(gx, CY + GH, BAR, g => { const [x0, y0] = r.w(gx, CY - GH, BAR), [x1, y1] = r.w(gx, CY + GH, BAR); px.line(g, Math.round(x0), Math.round(y0), Math.round(x1), Math.round(y1), '#f4f4f0', 2); }, { bias: 1 });\n478\t    for (const p of all) {\n479\t      const b = p.body; r.shadow(b.x, b.y, 6, .35);\n480\t      r.actor(b.x, b.y, b.z, (g, ox, oy) => p.rig.draw(g, ox, oy, view));\n481\t      if (p.input) r.queue(b.x, b.y, 40, g => { const [x, y] = r.w(b.x, b.y, 40), c = E.PLAYER_COLORS[p.input.player || 0] || '#ffe08a'; px.poly(g, [[x - 3, y - 4], [x + 3, y - 4], [x, y]], c); }, { emissive: true });\n482\t      if (p.charging) r.queue(b.x, b.y, 44, g => { const [x, y] = r.w(b.x, b.y, 44); E.ui.bar(g, Math.round(x) - 10, Math.round(y) - 6, 20, 4, p.meter, p.meter > .8 ? '#ff6a3a' : '#ffd36a'); });\n483\t    }\n484\t    r.shadow(ball.x, ball.y, 3 - Math.min(1.5, ball.z * .05), .4);\n485\t    r.sprite(ball.x, ball.y, ball.z + 2.5, Math.floor(ball.roll / 8) % 2 ? BALL2 : BALL, { anchor: 'center' });\n486\t    r.overlay(g => hud(g, r));\n487\t    talk.draw(r);\n488\t    if (mode === 'full') { r.overlay(g => results(g, r)); after.draw(r); }\n489\t  }\n490\t  const mmss = s => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');\n491\t  function hud(g, r) {\n492\t    // the score bug: the sides' chips and scores, the clock (counting down each half; golden goal says so)\n493\t    const left = golden ? 'GOLDEN GOAL' : (half === 1 ? '1ST ' : '2ND ') + mmss(Math.max(0, HALF * half - clock));\n494\t    E.ui.box(g, 4, 4, 132, 16, { bg: '#141826', border: '#6a7090', alpha: .85 });\n495\t    px.rect(g, 8, 9, 6, 6, TEAMS[0].chip); px.rect(g, 70, 9, 6, 6, TEAMS[1].chip);\n496\t    E.font.text(g, TEAMS[0].name + ' ' + score[0], 17, 8, '#f0ecdc', { font: 'tiny', outline: false });\n497\t    E.font.text(g, score[1] + ' ' + TEAMS[1].name, 79, 8, '#f0ecdc', { font: 'tiny', outline: false });\n498\t    E.font.text(g, left, 4, 24, golden ? '#ffd36a' : '#c8d0e8', { font: 'tiny', outline: '#000' });\n499\t    // the radar: the cage small, the players as their colors, the ball white\n500\t    const s = 2.4 / T, w = Math.round((X1 - X0) * s), h = Math.round((Y1 - Y0) * s), x0 = r.W - w - 6, ca = game.cornerArea(), y0 = ca && ca.x0 < x0 + w ? Math.ceil(ca.y1) + 4 : 26;   // (top right, under the corner's buttons or a kit's API button: the radio and the touch buttons have the bottom)\n501\t    E.ui.box(g, x0 - 2, y0 - 2, w + 4, h + 4, { bg: '#183a1e', border: '#6a9070', alpha: .75 });"}]},"parent_tool_use_id":null,"session_id":"2bfc1153-d85f-4cc7-a4e9-74837d1d317d","uuid":"8006854a-cb39-4424-ba13-e38784e7824e","timestamp":"2026-11-04T01:27:50.256Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261103-182647__x9a2bbb/work/IceHoc-Kaboom-IceHockey-claude-opus-5-5-xhigh-20261103-182647/engine/kits/sports.js","content":"// The SPORTS kit's game (two against two in a walled cage, up to four players: a ball that bounces and curls, passes, lobs, shots on a meter, formations, a match clock; Sensible Soccer and NBA Jam), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/68-sports.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. sports.html plays it; node kits/test.mjs sports runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 22  SPORTS  (Sensible Soccer, NBA Jam, Tecmo Bowl).\n * Two against two in a walled cage, for up to four players: the GULLS against the RUST, two halves on the clock, a\n * golden goal if it ends level. The ball is a Body: it rolls, bounces off the ground and the boards, and curls.\n * KEYS: the stick runs; J passes (to the teammate the stick points at, led to where it is going), L lobs one over a\n * defender (its arc solved by E.arc to land at the teammate's feet), K held fills the shot meter and shoots on letting go\n * (the stick across the goal aims it; pushed sideways just after, it curls: aftertouch). Without the ball: J slides in\n * to tackle, K switches to the teammate nearer the ball. TOUCH: the stick, PASS, SHOOT (hold), LOB.\n * PLAYERS: MATCH is you against the CPU; VERSUS lets players 2 to 4 in (2 on the keyboard, or Start on a pad): player 2\n * takes the RUST, 3 and 4 the second of each side. The rest are run by formation: with the ball, the other one runs\n * ahead on the far side; without it, the nearer presses and the other covers the goal. Commentary on Dialog's radio.\n * Deep links: #sports/match (a match against the CPU), #sports/vs (VERSUS: players 2 to 4 join).\n * HOW IT WORKS: a TileMap cage (boards that cut low before the camera, nets), the ball and the players as E.Body, rigs\n * that kick and slide (E.Attack), E.arc for the lob, game.allowJoin for players; SPORTS.run(n) is the proof,\n * SPORTS.bot() plays a match through to its whistle and then a short one with four players.\n * ===================================================================================== */\nconst SPORTS = (() => {\n  const A = game.audio, T = 16, FW = 36, FH = 22, ND = 2, GOAL = 5, BAR = 28, HALF = 60, GOLDEN = 45, PI = Math.PI;\n  /* ---- THE CAGE: a field of FW x FH tiles inside boards (cut low where they hide it), a goal in each end with its net,\n   * a stand of three tiers behind the north boards; built from rows: # boards, N net, . the field, : the net's floor,\n   * 1 2 3 the stand's tiers (back to front), , outside ---- */\n  const STAND = 3, COLS = ND + FW + 2 + ND, ROWS = STAND + FH + 2, MID = FH / 2, goalRow = r => r > MID - GOAL / 2 && r <= MID + GOAL / 2;\n  const rows = [];\n  for (let R = 0; R < ROWS; R++) {\n    let s = ''; const r = R - STAND;   // (the cage's own row)\n    for (let c = 0; c < COLS; c++) {\n      const field = c > ND && c <= ND + FW && r > 0 && r <= FH, endCol = c === ND || c === ND + FW + 1, net = (c < ND || c > ND + FW + 1);\n      if (r < 0) s += c >= ND && c <= ND + FW + 1 ? String(R + 1) : ',';\n      else if (field) s += '.';\n      else if (endCol && r > 0 && r <= FH) s += goalRow(r) ? '.' : '#';\n      else if ((r === 0 || r === FH + 1) && c >= ND && c <= ND + FW + 1) s += '#';\n      else if (net && goalRow(r)) s += c === 0 || c === COLS - 1 ? 'N' : ':';\n      else if (net && (goalRow(r + 1) || goalRow(r - 1))) s += 'N';\n      else s += ',';\n    }\n    rows.push(s);\n  }\n  const X0 = (ND + 1) * T, X1 = (ND + 1 + FW) * T, Y0 = (STAND + 1) * T, Y1 = (STAND + FH + 1) * T, CX = (X0 + X1) / 2, CY = (Y0 + Y1) / 2, GH = GOAL * T / 2;\n  // the pitch: mown stripes with the grass's own grain, painted lines a little worn (the halfway line, the centre circle,\n  // an arc before each goal), the nets' shadow on their floor, tarmac outside\n  const line = (x, y) => {\n    const d = Math.hypot(x - CX, y - CY), ex = Math.min(Math.abs(x - X0), Math.abs(x - X1)), ey = Math.min(Math.abs(y - Y0), Math.abs(y - Y1));\n    if (ex < 1.5 || ey < 1.5 || Math.abs(x - CX) < 1 || Math.abs(d - 48) < 1) return true;\n    for (const gx of [X0, X1]) if (Math.abs(Math.hypot(x - gx, y - CY) - 72) < 1 && Math.abs(x - gx) < 72) return true;\n    return false;\n  };\n  const floorTex = (x, y, tag) => {\n    const n = E.hash2(Math.floor(x), Math.floor(y)) - .5, m = E.noise2(x * .06, y * .06) * .5;\n    if (tag === 'net') { const mesh = Math.floor(x) % 4 === 0 || Math.floor(y) % 4 === 0; return mesh ? [30, 66, 36] : [44 + n * 10, 92 + n * 14, 50 + n * 10]; }\n    if (tag === 'out') return [44 + n * 18, 42 + n * 18, 50 + n * 18];\n    if (line(x, y)) { const w = 228 + n * 24 + m * 10; return [w, w + 4, w - 8]; }\n    const k = Math.floor((x - X0) / 32) % 2 ? 1 : 0, g = (k ? 140 : 106) + n * 34 + m * 24;   // (a stripe mown each way: lighter, darker)\n    return [g * .42, g, g * .46];\n  };\n  let map = null;\n  const makeMap = () => new E.TileMap({ rows, legend: { '#': 1, N: 2, 1: 5, 2: 4, 3: 3, '.': { floor: 'grass' }, ':': { floor: 'net' }, ',': { floor: 'out' } }, floorTex, outside: '#1e1c24', ao: 4,\n    types: { 1: { h: 26, cut: true, cutH: 6, face: 'plank', side: '#3a4a6a', top: '#d8dce8', line: '#2a3450' }, 2: { h: BAR + 4, face: 'none', side: '#b8bcc8', top: '#e0e4ec' },\n      3: { h: 34, face: 'stone', side: '#5a5468', top: '#6a6478' }, 4: { h: 44, face: 'stone', side: '#4e4a5e', top: '#5e586e' }, 5: { h: 54, face: 'stone', side: '#44405a', top: '#544e66' } } });\n  // the crowd: two on each tile of the stand, in their colors, bobbing; on a goal, those of the side that scored jump\n  const CROWD = [];\n  for (let R = 0; R < STAND; R++) for (let c = ND; c <= ND + FW + 1; c++) for (const dx of [4, 12]) {\n    const h = E.hash2(c * 3 + dx, R * 7 + 1), side = h < .5 ? 0 : 1;\n    CROWD.push({ x: c * T + dx, y: R * T + 9, z: [54, 44, 34][R], side, shirt: side ? ['#c8502a', '#e07040', '#a83a1a'][(h * 30 | 0) % 3] : ['#eef0f6', '#2a5ab8', '#8ab0f0'][(h * 30 | 0) % 3], skin: ['#e0b090', '#a87050', '#6a4028', '#f0c8a8'][(h * 50 | 0) % 4], ph: h * 9 });\n  }\n  /* ---- THE TEAMS: their colors, names and players; the ball ---- */\n  const TEAMS = [\n    { name: 'GULLS', colors: { cloth: '#eef0f6', pants: '#2a5ab8', boot: '#1e2030', belt: '#2a5ab8', trim: '#2a5ab8' }, chip: '#eef0f6', players: [['NOOR', '#3a2418', '#c89070'], ['BEX', '#e8c070', '#f0c8a8']] },\n    { name: 'RUST', colors: { cloth: '#c8502a', pants: '#2a2a30', boot: '#1a1a1e', belt: '#1a1a1e', trim: '#e8c070' }, chip: '#c8502a', players: [['DRAGO', '#1e1c1a', '#a87050'], ['KIT', '#6a3a22', '#e0b090']] }];\n  const SPEED = 92, AI_SPEED = 86, KICK_CD = .3;\n  const BALL = E.sprite(['.www.', 'wwkww', 'wkkkw', 'wwkww', '.www.'], { w: '#f4f4f0', k: '#2a2a30' });\n  const BALL2 = E.sprite(['.www.', 'wkwkw', 'wwwww', 'wkwkw', '.www.'], { w: '#f4f4f0', k: '#2a2a30' });\n  const SOUNDS = {\n    kick: { wave: 'noise', freq: 900, to: 200, dur: .07, vol: .3, filter: 'lowpass' }, thump: { wave: 'sine', freq: 120, to: 70, dur: .08, vol: .3 },\n    whistle: { wave: 'square', freq: 2200, vib: [30, .05], dur: .32, vol: .14 }, post: { wave: 'triangle', freq: 1400, to: 1100, dur: .3, vol: .25 },\n    crowd: { wave: 'noise', freq: 600, to: 900, dur: 1.4, vol: .18, filter: 'lowpass' }, slide: { wave: 'noise', freq: 400, to: 200, dur: .25, vol: .18 }\n  };\n  for (const [k, v] of Object.entries(SOUNDS)) A.define(k, v);\n  const SONG = { bpm: 140, steps: 4, tracks: [   // the cage: a bright chant over a bouncing bass\n    { wave: 'square', vol: .07, notes: 'E5 . E5 G5 . E5 D5 . | C5 . C5 E5 . C5 B4 . | A4 . C5 . E5 . A5 . | G5 - - . . . . .' },\n    { wave: 'triangle', vol: .3, notes: 'C3 . G2 . C3 . G2 . | A2 . E2 . A2 . E2 . | F2 . C3 . F2 . C3 . | G2 . D3 . G2 . B2 .' },\n    { wave: 'drums', vol: .1, notes: 'k . h . s . h k | k . h . s h h .' }] };\n\n  /* ---- THE STATE ---- */\n  let mode = 'menu', vs = false, team = [], all = [], ball = null, owner = null, last = null, clock = 0, half = 1, score = [0, 0], kickT = 0, t = 0, scripted = false;\n  let stats = null, curlT = 0, golden = false, restartBy = 0, over = false, kickHold = 0;   // kickHold: the kickoff's rule (the other side out of the circle) until the ball is played\n  const menu = new E.Menu(game, ['MATCH', 'VERSUS (2-4 PLAYERS)', 'BACK'], { onPick: i => i === 2 ? game.go('title') : i === 1 ? versus() : start(false) });\n  const after = new E.Menu(game, ['REMATCH', 'MENU'], { y: 150, onPick: i => i === 0 ? start(vs) : toMenu() });\n  const talk = new E.Dialog(game, { lines: 2, place: 'bottom', border: '#e8c070' });   // (at the bottom: clear of the score and of the touch buttons)\n  const VOICE = new E.Humanoid({ weapon: null, hat: 'band', colors: { cloth: '#3a3a4a', hair: '#5a3a2a', skin: '#e0b090', hat: '#2a2a30' } });\n  const say = text => { if (!scripted) talk.say(text, { name: 'CAGE RADIO', auto: 2.2, modal: false, alpha: .8, portrait: VOICE, portraitOpts: { zoom: 3, turn: .4 } }); };\n\n  function toMenu() { mode = 'menu'; game.splitScreen(0); game.allowJoin(false); A.music('title'); menu.i = 0; }\n  function versus() { vs = true; mode = 'join'; game.allowJoin({ max: 4 }); A.sfx('select'); }\n  /** a match: the four on the pitch, the ball at the centre, the clock at 0; players: who holds which (the inputs) */\n  function start(versus) {\n    vs = versus; map = map || makeMap(); score = [0, 0]; clock = 0; half = 1; golden = false; over = false; owner = null; last = null;\n    stats = { passes: 0, done: 0, shots: 0, lobs: 0, tackles: 0, goals: [], walls: 0, curled: 0 };\n    all = []; team = [[], []];\n    TEAMS.forEach((tm, s) => tm.players.forEach(([name, hair, skin], k) => {\n      const b = new E.Body({ x: CX, y: CY, r: 5, friction: 0, gravity: 700 });\n      const p = { side: s, k, name, body: b, rig: new E.Humanoid({ weapon: null, build: 'heroic', size: 1.05, hair: k ? 'spiky' : 'short', colors: Object.assign({ hair, skin }, tm.colors), speedRef: 80 }),\n        input: null, facing: s ? PI : 0, kick: null, slide: 0, stun: 0, cool: 0, meter: 0, charging: false, cheer: 0 };\n      team[s].push(p); all.push(p);\n    }));\n    // who holds whom: player 1 the GULLS' first (and, alone, whichever GULL is nearer the ball); in versus 2 the RUST, 3 and 4\n    // the second of each side\n    const P = game.players;\n    team[0][0].input = P[0];\n    if (vs) { if (P[1]) team[1][0].input = P[1]; if (P[2]) team[0][1].input = P[2]; if (P[3]) team[1][1].input = P[3]; }\n    ball = new E.Body({ x: CX, y: CY, r: 3, friction: 0, bounce: .55, gravity: 600 }); ball.spin = 0; ball.roll = 0;\n    kickoff(0); game.allowJoin(false); A.music(SONG); game.input.consumeAll();\n    game.follow(ball, { z: 8, lead: 10 }); game.cam.smooth = .18; game.cam.bounds = v => map.bounds(v);\n    say('THE GULLS AGAINST THE RUST IN THE CAGE. HERE WE GO!');\n  }\n  /** the formation's spots: kicking off (s kicks), or in play (a team's two by where the ball is and who has it) */\n  const goalX = s => s ? X0 : X1;   // where side s shoots (the GULLS attack the right end)\n  function kickoff(s) {\n    owner = null; ball.x = CX; ball.y = CY; ball.z = 0; ball.onGround = true; ball.vx = ball.vy = ball.vz = 0; ball.spin = 0;\n    for (const p of all) {\n      const dir = p.side ? 1 : -1, b = p.body;\n      b.x = p.side === s && p.k === 0 ? CX + dir * 8 : CX + dir * (p.k ? 150 : 60); b.y = p.side === s && p.k === 0 ? CY : CY + (p.k ? 40 : -40) * (p.side ? -1 : 1);\n      b.vx = b.vy = 0; b.z = 0; p.facing = p.side ? PI : 0; p.kick = null; p.slide = 0; p.stun = 0; p.meter = 0; p.charging = false;\n    }\n    mode = 'kickoff'; kickT = 1; restartBy = s;\n  }\n  /** a player's spot in the formation now: with the ball (or near it), go for it; else, attacking, ahead on the far\n   *  side; defending, between the ball and its own goal */\n  function spot(p) {\n    const s = p.side, mate = team[s][1 - p.k], dir = s ? -1 : 1, has = owner && owner.side === s;\n    if (has) return [clamp(ball.x + dir * 90, X0 + 30, X1 - 30), CY + (ball.y < CY ? 60 : -60)];\n    const own = goalX(1 - s), near = Math.hypot(p.body.x - ball.x, p.body.y - ball.y) <= Math.hypot(mate.body.x - ball.x, mate.body.y - ball.y);\n    if (near) return [ball.x, ball.y];\n    return [lerp(ball.x, own, .55), lerp(ball.y, CY, .5)];\n  }\n\n  /* ---- THE BALL: owned (at its owner's feet), or loose: a Body that rolls, bounces off the ground and the boards and\n   * curls by its spin; a goal, over the bar, out of the cage ---- */\n  function ballStep(dt) {\n    if (owner) {\n      const b = owner.body, f = owner.facing; ball.x = b.x + Math.cos(f) * 7; ball.y = b.y + Math.sin(f) * 7; ball.z = 0; ball.onGround = true;\n      ball.vx = b.vx; ball.vy = b.vy; ball.vz = 0; ball.roll += Math.hypot(b.vx, b.vy) * dt; return;\n    }\n    const vx0 = ball.vx, vy0 = ball.vy, sp = Math.hypot(ball.vx, ball.vy);\n    if (ball.spin && sp > 20) { const k = ball.spin * dt; ball.vx += -vy0 / sp * k * sp; ball.vy += vx0 / sp * k * sp; ball.spin *= Math.exp(-dt * 1.4); }   // curl: across its path\n    if (ball.z <= .5) { const f = Math.exp(-dt * 1.1); ball.vx *= f; ball.vy *= f; }   // rolling slows it\n    ball.update(dt, map);   // (the Body bounces off the boards and the ground by its bounce)\n    if (ball.hitWall) { ball.spin = 0; stats.walls++; if (Math.hypot(vx0, vy0) > 60) A.sfx('thump'); }\n    if (ball.bounced) A.sfx('thump');\n    ball.roll += Math.hypot(ball.vx, ball.vy) * dt;\n    // a goal: over the line between the posts and under the bar; over it, a goal kick; out of the cage, thrown back in\n    for (const s of [0, 1]) {\n      const gx = goalX(s), past = s ? ball.x < gx - 2 : ball.x > gx + 2;\n      if (past && Math.abs(ball.y - CY) < GH && ball.z < BAR) return goal(s);\n      if (past && (ball.z >= BAR || Math.abs(ball.y - CY) >= GH)) return restart(1 - s, s ? X0 + 24 : X1 - 24, CY, 'OVER THE BAR. A GOAL KICK');\n    }\n    if (ball.x < X0 - 40 || ball.x > X1 + 40 || ball.y < Y0 - 4 || ball.y > Y1 + 4) restart(last ? 1 - last.side : 0, clamp(ball.x, X0 + 12, X1 - 12), clamp(ball.y, Y0 + 12, Y1 - 12), 'OUT OF THE CAGE! THROWN BACK IN');\n  }\n  /** play goes on from (x, y) with the ball at the feet of side s's nearer player */\n  function restart(s, x, y, line) {\n    const p = team[s].slice().sort((a, b) => Math.hypot(a.body.x - x, a.body.y - y) - Math.hypot(b.body.x - x, b.body.y - y))[0];\n    p.body.x = x - (s ? -8 : 8); p.body.y = y; p.facing = s ? PI : 0; owner = p; ball.spin = 0; A.sfx('whistle'); if (line) say(line);\n  }\n  function goal(s) {\n    score[s]++; stats.goals.push([s, last ? last.name : '?', Math.round(clock)]); owner = null; mode = 'goal'; kickT = 2.4; restartBy = 1 - s;\n    for (const p of team[s]) p.cheer = 2.4; game.shake(3); A.sfx('crowd'); A.sfx('whistle');\n    P.sparks(ball.x, ball.y, 16, 16, null, { color: '#ffe08a' }); P.ring(ball.x, ball.y, 4, 34, '#fff6c0', .5);\n    say(golden ? 'GOLDEN GOAL! ' + (last ? last.name : '') + ' WINS IT FOR THE ' + TEAMS[s].name + '!' : 'GOAL! ' + (last ? last.name + ' SCORES FOR THE ' : 'THE ') + TEAMS[s].name + '! ' + score[0] + ' - ' + score[1]);\n    if (golden) { over = true; }\n  }\n\n  /* ---- KICKS: a pass along the ground led to the teammate, a lob over by E.arc, a shot from the meter with aftertouch ---- */\n  /** the teammate a pass goes to: the one the stick points at (within 70 degrees), else the other */\n  const mateOf = p => team[p.side][1 - p.k];\n  function pass(p) {\n    const m = mateOf(p), b = p.body, d = Math.hypot(m.body.x - b.x, m.body.y - b.y), sp = clamp(d * 1.5 + 90, 150, 270), lead = d / sp;\n    const tx = m.body.x + m.body.vx * lead * .8, ty = m.body.y + m.body.vy * lead * .8, a = Math.atan2(ty - b.y, tx - b.x);\n    release(p, Math.cos(a) * sp, Math.sin(a) * sp, 0); stats.passes++; ball.to = m;\n  }\n  function lob(p) {\n    const m = mateOf(p), lead = .55, tx = m.body.x + m.body.vx * lead, ty = m.body.y + m.body.vy * lead;\n    const v = E.arc({ x: ball.x, y: ball.y, z: 0 }, { x: tx, y: ty, z: 0 }, ball.gravity, { apex: 30 });\n    release(p, v.vx, v.vy, v.vz); stats.lobs++; stats.passes++; ball.to = m;\n  }\n  /** a shot: power from the meter (0..1), aimed across the goal mouth by the stick's up and down */\n  function shoot(p, power, aimY) {\n    const gx = goalX(p.side), gy = CY + clamp(aimY, -1, 1) * (GH - 6), b = p.body, a = Math.atan2(gy - b.y, gx - b.x), sp = 170 + power * 230;\n    release(p, Math.cos(a) * sp, Math.sin(a) * sp, 30 + power * 95); stats.shots++; curlT = .4; ball.to = null; A.sfx('kick');\n  }\n  function release(p, vx, vy, vz) {\n    owner = null; last = p; kickHold = 0; ball.vx = vx; ball.vy = vy; ball.vz = vz; ball.onGround = vz <= 0; ball.spin = 0; p.cool = KICK_CD; p.kick = new E.Attack('kick'); p.kick.start(); A.sfx('kick');\n  }\n  /** a slide tackle: a dash along its facing; whoever it meets with the ball loses it */\n  function tackle(p) { p.slide = .35; p.kick = new E.Attack('sweep'); p.kick.start(); stats.tackles++; A.sfx('slide'); const b = p.body; b.vx = Math.cos(p.facing) * 170; b.vy = Math.sin(p.facing) * 170; }\n\n  /* ---- A PLAYER'S STEP: from its input (a human's) or its brain (the formation's), then its body and its rig ---- */\n  function playerStep(p, dt) {\n    const b = p.body; p.cool = Math.max(0, p.cool - dt); p.stun = Math.max(0, p.stun - dt); p.cheer = Math.max(0, p.cheer - dt);\n    let mx = 0, my = 0;\n    if (p.slide > 0) { p.slide -= dt; const f = Math.exp(-dt * 3); b.vx *= f; b.vy *= f; }\n    else if (p.stun > 0 || mode !== 'play') { b.vx = approach(b.vx, 0, 600 * dt); b.vy = approach(b.vy, 0, 600 * dt); }\n    else {\n      const c = p.input ? human(p, dt) : brain(p, dt); mx = c.move[0]; my = c.move[1];\n      const sp = p.input ? SPEED : AI_SPEED, m = Math.hypot(mx, my);\n      b.vx = approach(b.vx, mx * sp, 900 * dt); b.vy = approach(b.vy, my * sp, 900 * dt);\n      if (m > .2) p.facing = E.approachAng(p.facing, Math.atan2(my, mx), dt * (owner === p ? 9 : 14));\n      act(p, c, dt);\n    }\n    b.update(dt, map);\n    // the loose ball: whoever reaches it first takes it (not just after kicking it, nor a ball high in the air, and a fast one only\n    // right at its feet)\n    if (!owner && mode === 'play' && p.cool <= 0 && p.stun <= 0 && ball.z < 9 && Math.hypot(ball.x - b.x, ball.y - b.y) < (Math.hypot(ball.vx, ball.vy) > 210 ? 4.5 : 9)) {   // (a hard shot is hard to trap)\n      owner = p; ball.spin = 0; if (ball.to === p && last && last.side === p.side) stats.done++; ball.to = null;\n      if (p.slide > 0) p.slide = 0;\n    }\n    // a slide that meets the ball's holder knocks it loose\n    if (p.slide > 0 && owner && owner.side !== p.side && Math.hypot(owner.body.x - b.x, owner.body.y - b.y) < 12) {\n      const o = owner; owner = null; o.stun = .5; last = p; ball.vx = Math.cos(p.facing) * 120; ball.vy = Math.sin(p.facing) * 120; ball.vz = 40; ball.onGround = false; p.cool = .2; A.sfx('thump');\n    }\n    if (p.kick) { p.kick.update(dt); if (!p.kick.busy) p.kick = null; }\n    p.rig.update(dt, { x: b.x, y: b.y, z: b.z, vx: b.vx, vy: b.vy, facing: p.facing, attack: p.kick && p.kick.state, hurt: p.stun > 0, pose: p.cheer > 0 ? 'cheer' : null, expr: p.cheer > 0 ? 'shout' : null });\n  }\n  /** what a human's input asks: the stick; pass, lob, the shot's meter (held), a tackle or a switch */\n  function human(p, dt) {\n    const I = p.input, mv = I.move(), c = { move: mv, pass: I.pressed('pass'), lob: I.pressed('lob'), shootHeld: I.down('shoot'), shootUp: I.released('shoot'), aim: mv[1] * (p.side ? -1 : 1) };\n    if (c.pass) I.consume('pass'); if (c.lob) I.consume('lob');\n    // aftertouch: just after a shot, the stick across its path curls the ball\n    if (curlT > 0 && last === p && !owner) { const sp = Math.hypot(ball.vx, ball.vy) || 1, across = (mv[0] * -ball.vy + mv[1] * ball.vx) / sp; if (Math.abs(across) > .3) { ball.spin = clamp(ball.spin + across * 3.2 * dt, -1.6, 1.6); stats.curled++; } }\n    return c;\n  }\n  /** the CPU's footballer: to its spot in the formation; with the ball, run at goal, pass when pressed, shoot in range */\n  function brain(p, dt) {\n    const b = p.body, c = { move: [0, 0], pass: false, lob: false, shootHeld: false, shootUp: false, aim: 0 }, s = p.side;\n    if (owner === p) {\n      const gx = goalX(s), dg = Math.hypot(gx - b.x, CY - b.y), foe = team[1 - s].find(o => Math.hypot(o.body.x - b.x, o.body.y - b.y) < 30 && Math.abs(E.angDiff(Math.atan2(o.body.y - b.y, o.body.x - b.x), p.facing)) < 1.2);\n      const a = Math.atan2(CY - b.y, gx - b.x); c.move = [Math.cos(a), Math.sin(a)];\n      const shot = (meter, aim) => { c.shootHeld = p.meter < meter; c.shootUp = !c.shootHeld; c.aim = b.y < CY ? aim : -aim; };   // (held until the meter is where it wants it)\n      if (dg < 95 && p.cool <= 0) shot(.4, .45);   // close in: shoot, pressed or not\n      else if (foe) { const m = mateOf(p), lane = team[1 - s].some(o => segDist(o.body, b, m.body) < 14); if (p.cool <= 0) { if (lane) c.lob = true; else c.pass = true; } else c.move = [Math.cos(a + 1.1), Math.sin(a + 1.1)]; }\n      else if (dg < 160 && p.cool <= 0) shot(.55 + p.k * .2, .55);\n      return c;\n    }\n    let [tx, ty] = spot(p);\n    if (kickHold > 0 && s !== restartBy) { const cd = Math.hypot(tx - CX, ty - CY) || 1; if (cd < 56) { tx = CX + (tx - CX) / cd * 56; ty = CY + (ty - CY) / cd * 56; } }   // (the kickoff: out of the circle)\n    const dx = tx - b.x, dy = ty - b.y, d = Math.hypot(dx, dy);\n    if (d > 6) c.move = [dx / d, dy / d];\n    // pressing the holder: slide in when close and in front of it\n    if (owner && owner.side !== s && d < 18 && p.cool <= 0 && Math.hypot(owner.body.x - b.x, owner.body.y - b.y) < 16) c.pass = true;\n    return c;\n  }\n  const segDist = (o, a, b) => { const vx = b.x - a.x, vy = b.y - a.y, l = vx * vx + vy * vy || 1, u = clamp(((o.x - a.x) * vx + (o.y - a.y) * vy) / l, 0, 1); return Math.hypot(a.x + vx * u - o.x, a.y + vy * u - o.y); };\n  /** the buttons: with the ball, pass, lob or the shot's meter; without it, a tackle (pass) or a switch (shoot) */\n  function act(p, c, dt) {\n    if (owner === p) {\n      if (c.pass && p.cool <= 0) return pass(p);\n      if (c.lob && p.cool <= 0) return lob(p);\n      if (c.shootHeld) { p.charging = true; p.meter = Math.min(1, p.meter + dt * 1.25); }\n      else if (p.charging && (c.shootUp || !c.shootHeld)) { p.charging = false; shoot(p, p.meter, c.aim); p.meter = 0; }\n      return;\n    }\n    p.charging = false; p.meter = 0;\n    if (c.pass && p.cool <= 0 && p.slide <= 0 && !(kickHold > 0 && p.side !== restartBy)) tackle(p);\n    else if (c.shootUp && p.input && !vs) swap(p);\n  }\n  /** player 1 alone holds whichever GULL is nearer the ball when the other side has it (or K switches) */\n  function swap(p) { const m = mateOf(p); if (m.input) return; m.input = p.input; p.input = null; }\n  function autoSwitch() {\n    if (vs) return;\n    const s = 0, cur = team[s].find(p => p.input), m = cur && mateOf(cur);\n    if (!cur || !m || m.input) return;\n    if (owner === m || (ball.to === m) || ((!owner || owner.side !== s) && Math.hypot(m.body.x - ball.x, m.body.y - ball.y) + 24 < Math.hypot(cur.body.x - ball.x, cur.body.y - ball.y))) swap(cur);\n  }\n\n  /* ---- A STEP OF THE MATCH: the clock, the halves, golden goal, the whistle ---- */\n  function update(dt) {\n    t += dt;\n    if (mode === 'menu') { if (!menu.update(dt)) pickOnStart(menu); return; }\n    if (mode === 'join') {\n      if (game.input.pressed('start') || game.input.pressed('confirm')) { game.input.consumeAll(); start(true); }\n      else if (game.input.pressed('cancel')) toMenu();\n      return;\n    }\n    if (mode === 'full') { after.update(dt); for (const p of all) playerStep(p, dt); return; }\n    talk.update(dt);\n    if (mode === 'kickoff' || mode === 'goal' || mode === 'half') {\n      for (const p of all) playerStep(p, dt);\n      if ((kickT -= dt) <= 0) {\n        if (mode === 'goal' && over) return fullTime();\n        if (mode === 'goal' || mode === 'half') kickoff(restartBy);\n        else { mode = 'play'; owner = team[restartBy][0]; kickHold = 2.5; A.sfx('whistle'); }\n      }\n      return;\n    }\n    clock += dt; kickHold = Math.max(0, kickHold - dt);\n    for (const p of all) playerStep(p, dt);\n    ballStep(dt); curlT = Math.max(0, curlT - dt); autoSwitch();\n    if (!golden && half === 1 && clock >= HALF) { half = 2; mode = 'half'; kickT = 2.4; restartBy = 1; owner = null; A.sfx('whistle'); say('HALF TIME: GULLS ' + score[0] + ', RUST ' + score[1] + '.'); }\n    else if (!golden && clock >= HALF * 2) {\n      if (score[0] === score[1]) { golden = true; clock = HALF * 2; A.sfx('whistle'); say('LEVEL AT FULL TIME: GOLDEN GOAL! THE NEXT ONE WINS IT.'); kickoff(0); }\n      else fullTime();\n    } else if (golden && clock >= HALF * 2 + GOLDEN) fullTime();\n  }\n  function fullTime() {\n    mode = 'full'; over = true; owner = null; A.sfx('whistle'); after.i = 0;\n    const w = score[0] > score[1] ? 0 : score[1] > score[0] ? 1 : -1; for (const p of all) p.cheer = p.side === w ? 99 : 0;\n    say(w < 0 ? 'FULL TIME: A DRAW IN THE CAGE.' : 'FULL TIME! THE ' + TEAMS[w].name + ' WIN IT, ' + Math.max(...score) + ' - ' + Math.min(...score) + '.');\n    if (!scripted) A.music(w === 0 || vs ? 'victory' : null);\n  }\n\n  /* ---- DRAWING: the cage, the posts, the players, the ball and its shadow; the score, the clock, the meter, the radar ---- */\n  function draw(r) {\n    if (mode === 'menu' || mode === 'join') return drawMenu(r);\n    const view = E.charView(r.view);\n    map.drawFloor(r); map.queueWalls(r);\n    for (const f of CROWD) {   // (cheering on the scoring side's goal, else a sway)\n      const up = mode === 'goal' && stats.goals.length && stats.goals[stats.goals.length - 1][0] === f.side ? Math.abs(Math.sin(t * 9 + f.ph)) * 5 : Math.sin(t * 2 + f.ph) * .6;\n      r.queue(f.x, f.y, f.z + up, g => { const [x, y] = r.w(f.x, f.y, f.z + up), X = Math.round(x), Y = Math.round(y); px.rect(g, X - 2, Y - 5, 4, 5, f.shirt); px.rect(g, X - 1, Y - 8, 3, 3, f.skin); });\n    }\n    for (const gx of [X0, X1]) for (const py of [CY - GH, CY + GH]) r.queue(gx, py, 0, g => { const [x, y] = r.w(gx, py, 0), [, y1] = r.w(gx, py, BAR); px.rect(g, Math.round(x) - 1, Math.round(y1), 2, Math.round(y - y1), '#f4f4f0'); });\n    for (const gx of [X0, X1]) r.queue(gx, CY + GH, BAR, g => { const [x0, y0] = r.w(gx, CY - GH, BAR), [x1, y1] = r.w(gx, CY + GH, BAR); px.line(g, Math.round(x0), Math.round(y0), Math.round(x1), Math.round(y1), '#f4f4f0', 2); }, { bias: 1 });\n    for (const p of all) {\n      const b = p.body; r.shadow(b.x, b.y, 6, .35);\n      r.actor(b.x, b.y, b.z, (g, ox, oy) => p.rig.draw(g, ox, oy, view));\n      if (p.input) r.queue(b.x, b.y, 40, g => { const [x, y] = r.w(b.x, b.y, 40), c = E.PLAYER_COLORS[p.input.player || 0] || '#ffe08a'; px.poly(g, [[x - 3, y - 4], [x + 3, y - 4], [x, y]], c); }, { emissive: true });\n      if (p.charging) r.queue(b.x, b.y, 44, g => { const [x, y] = r.w(b.x, b.y, 44); E.ui.bar(g, Math.round(x) - 10, Math.round(y) - 6, 20, 4, p.meter, p.meter > .8 ? '#ff6a3a' : '#ffd36a'); });\n    }\n    r.shadow(ball.x, ball.y, 3 - Math.min(1.5, ball.z * .05), .4);\n    r.sprite(ball.x, ball.y, ball.z + 2.5, Math.floor(ball.roll / 8) % 2 ? BALL2 : BALL, { anchor: 'center' });\n    r.overlay(g => hud(g, r));\n    talk.draw(r);\n    if (mode === 'full') { r.overlay(g => results(g, r)); after.draw(r); }\n  }\n  const mmss = s => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');\n  function hud(g, r) {\n    // the score bug: the sides' chips and scores, the clock (counting down each half; golden goal says so)\n    const left = golden ? 'GOLDEN GOAL' : (half === 1 ? '1ST ' : '2ND ') + mmss(Math.max(0, HALF * half - clock));\n    E.ui.box(g, 4, 4, 132, 16, { bg: '#141826', border: '#6a7090', alpha: .85 });\n    px.rect(g, 8, 9, 6, 6, TEAMS[0].chip); px.rect(g, 70, 9, 6, 6, TEAMS[1].chip);\n    E.font.text(g, TEAMS[0].name + ' ' + score[0], 17, 8, '#f0ecdc', { font: 'tiny', outline: false });\n    E.font.text(g, score[1] + ' ' + TEAMS[1].name, 79, 8, '#f0ecdc', { font: 'tiny', outline: false });\n    E.font.text(g, left, 4, 24, golden ? '#ffd36a' : '#c8d0e8', { font: 'tiny', outline: '#000' });\n    // the radar: the cage small, the players as their colors, the ball white\n    const s = 2.4 / T, w = Math.round((X1 - X0) * s), h = Math.round((Y1 - Y0) * s), x0 = r.W - w - 6, ca = game.cornerArea(), y0 = ca && ca.x0 < x0 + w ? Math.ceil(ca.y1) + 4 : 26;   // (top right, under the corner's buttons or a kit's API button: the radio and the touch buttons have the bottom)\n    E.ui.box(g, x0 - 2, y0 - 2, w + 4, h + 4, { bg: '#183a1e', border: '#6a9070', alpha: .75 });","numLines":501,"startLine":1,"totalLines":592,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_011eyy7Es7RHtAvchDHwDT4P","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
