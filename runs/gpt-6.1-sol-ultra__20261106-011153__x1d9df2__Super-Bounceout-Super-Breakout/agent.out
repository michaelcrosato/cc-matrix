{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat > index.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<!--HUB_SESSION-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#f5f1e6\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-2\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Clear four brick constellations together. Highest team score wins.\">\n<meta name=\"hub:session-howto\" content=\"Move with left stick or mouse. Cross/Space serves. Triangle/Shift unleashes a charged piercing ball.\">\n<meta name=\"hub:session-minutes\" content=\"10\">\n<title>Super Bounceout — An ink & arcade original</title>\n<style>\n@import url('\"'https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap');\n:root{--paper:#f4f0e5;--ink:#162d37;--muted:#65777a;--orange:#f2663e;--yellow:#f8ce68;--teal:#1c8581;--line:#c9cec4;--display:'Barlow Condensed','Arial Narrow',Impact,sans-serif;--body:'DM Sans',Arial,sans-serif}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--paper);color:var(--ink);font-family:var(--body);user-select:none}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--orange);outline-offset:4px}button:disabled{opacity:.45;cursor:default}canvas{display:block;width:100%;height:100%;touch-action:none}#game{position:absolute;inset:0}#screenwash{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,transparent 0px,transparent 3px,#162d3705 3px,#162d3705 4px);mix-blend-mode:multiply}#loading{position:absolute;inset:0;background:var(--paper);display:grid;place-content:center;text-align:center;z-index:99}#loading b{font:900 clamp(40px,6vw,90px)/.9 var(--display);text-transform:uppercase}#loading p{letter-spacing:4px;font-size:13px}#error{display:none;color:#ac3a2d;max-width:600px;letter-spacing:0\"'!important}\n#topbar{position:absolute;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:27px 3.3vw;pointer-events:none;z-index:4}.brand{font:800 23px/.9 var(--display);letter-spacing:.5px;text-transform:uppercase}.brand .mark{display:inline-block;width:23px;height:18px;border:3px solid var(--ink);transform:skew(-12deg);margin-right:8px;position:relative}.brand .mark:after{content:'\"'';position:absolute;width:7px;height:7px;background:var(--orange);right:-7px;top:-8px;border-radius:50%}.edition{font-size:10px;letter-spacing:3px;color:var(--muted);text-transform:uppercase}.topright{display:flex;gap:20px;align-items:center}#menuButton{pointer-events:auto;border:1px solid #aab8b0;background:var(--paper);padding:10px 15px;border-radius:4px;display:none;color:var(--ink);font-weight:700}.statusdot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--teal);margin-right:7px}\n#title{position:absolute;inset:0;display:flex;align-items:center;z-index:3;padding:96px 7.5vw 72px;pointer-events:none}.titlecopy{width:45%;max-width:660px;pointer-events:auto}.eyebrow{font-size:11px;font-weight:700;letter-spacing:3.5px;text-transform:uppercase;display:flex;align-items:center;gap:13px}.eyebrow:before{content:'';height:2px;width:34px;background:var(--orange)}h1{font:900 clamp(74px,8.5vw,158px)/.79 var(--display);text-transform:uppercase;letter-spacing:-2px;margin:30px 0 26px;transform:rotate(-2deg);position:relative}h1 span{display:block;color:var(--orange);-webkit-text-stroke:1px var(--orange)}h1 em{font-style:normal;display:block;padding-left:3px}.subtitle{font-size:clamp(15px,1.1vw,18px);line-height:1.6;max-width:360px;color:#52666b;margin:0 0 27px}.titleactions{display:flex;flex-direction:column;gap:9px;max-width:330px}.primary,.secondary{min-height:53px;text-transform:uppercase;font:700 23px/1 var(--display);letter-spacing:1px;border:2px solid var(--ink);padding:13px 21px;border-radius:4px;text-align:left;display:flex;align-items:center;justify-content:space-between;gap:25px;color:var(--ink);transition:transform .12s,background .12s,box-shadow .12s}.primary{background:var(--ink);color:var(--paper);box-shadow:4px 4px 0 var(--orange)}.primary:hover,.primary.focused{background:var(--orange);transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}.secondary{background:transparent;min-height:44px;font-size:19px;border-color:#9caca4}.secondary:hover,.secondary.focused{background:#e1e6d9;transform:translateX(4px)}.buttonhint{font-family:var(--body);font-size:12px;font-weight:500;white-space:nowrap;opacity:.7}.minorlinks{display:flex;gap:24px;margin-top:27px;flex-wrap:wrap}.textbutton{border:0;border-bottom:1px solid transparent;padding:2px 0;background:none;color:#4f6668;font-size:12px;letter-spacing:.3px;font-weight:600}.textbutton:hover,.textbutton.focused{color:var(--orange);border-bottom-color:var(--orange)}.titlebadge{display:flex;gap:15px;align-items:center;margin-top:28px;font-size:10px;line-height:1.5;letter-spacing:1.6px;text-transform:uppercase;color:var(--muted)}.titlebadge b{font:800 34px var(--display);color:var(--ink);border-right:1px solid var(--line);padding-right:14px}.decorlabel{position:absolute;right:6vw;bottom:12%;transform:rotate(-7deg);pointer-events:none;font:700 18px var(--display);letter-spacing:1px;color:var(--teal);border:2px solid var(--teal);border-radius:50%;padding:15px 23px;text-align:center}.decorlabel b{display:block;font-size:33px;line-height:1}#footer{position:absolute;bottom:25px;left:3.3vw;right:3.3vw;display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:1.7px;color:var(--muted);z-index:3;pointer-events:none}\n#hud{display:none;position:absolute;inset:0;pointer-events:none;z-index:2}#hudTop{position:absolute;top:88px;left:3.3vw;right:3.3vw;display:flex;justify-content:space-between;align-items:start}.hudblock small{display:block;letter-spacing:2.5px;font-size:10px;text-transform:uppercase;color:var(--muted);margin-bottom:4px}.hudblock strong{font:700 40px/1 var(--display)}.hudblock.right{text-align:right}.hudleft,.hudright{display:flex;flex-direction:column;gap:30px}.lives{font-size:22px;color:var(--orange);letter-spacing:4px}#stageName{font:800 29px/1 var(--display);text-transform:uppercase;max-width:170px}#stageLabel{display:block;font-size:11px;letter-spacing:2px;margin-bottom:7px;color:var(--teal)}#chargebox{position:absolute;bottom:70px;left:3.3vw;width:min(210px,17vw)}.meterlabel{display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:9px}.meter{height:8px;background:#d5d9ce;transform:skew(-14deg);border:1px solid #9aaaa2}.meter i{display:block;height:100%;background:var(--orange);width:0%}#chargeButton{pointer-events:auto;background:var(--ink);border:0;border-radius:4px;color:var(--paper);font-size:12px;padding:12px;width:100%;margin-top:10px;display:none}#chargeButton.ready{display:block}#chargeTip{font-size:11px;line-height:1.5;color:var(--muted);margin-top:9px}#combo{position:absolute;right:3.3vw;bottom:85px;text-align:right}.comboNum{font:800 65px/.9 var(--display);color:var(--orange)}#combo small{font-size:10px;letter-spacing:2px;display:block;margin-top:6px}#playPrompt{position:absolute;bottom:8%;left:50%;transform:translateX(-50%);text-align:center;padding:12px 22px;border:1px solid #9eafa5;background:#f4f0e5e8;border-radius:3px;min-width:240px}.promptMain{font:700 22px var(--display);letter-spacing:1px;text-transform:uppercase}.promptSub{font-size:11px;color:var(--muted);margin-top:5px}#toast{position:absolute;left:50%;top:19%;transform:translateX(-50%) rotate(-2deg);padding:13px 26px;background:var(--yellow);color:var(--ink);border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);font:800 26px var(--display);text-transform:uppercase;opacity:0;transition:opacity .15s;pointer-events:none;z-index:6;white-space:nowrap}#attract{display:none;position:absolute;bottom:8%;left:50%;transform:translateX(-50%);text-align:center;color:var(--ink);z-index:3;background:var(--paper);padding:14px 25px;border:2px solid var(--ink);box-shadow:4px 4px 0 var(--orange)}#attract b{font:800 25px var(--display);letter-spacing:2px}#attract small{display:block;font-size:11px;margin-top:5px}\n#overlay{position:absolute;inset:0;background:#142a34a8;backdrop-filter:blur(9px);z-index:12;display:none;align-items:center;justify-content:center;padding:55px 20px}.panel{background:var(--paper);border:2px solid var(--ink);box-shadow:8px 8px 0 #0e2029;border-radius:5px;padding:32px 40px;max-width:760px;width:100%;max-height:88vh;overflow:auto;position:relative}.panel h2{font:800 52px/.9 var(--display);text-transform:uppercase;letter-spacing:-.6px;margin:10px 0 24px}.panel h3{font:800 26px var(--display);text-transform:uppercase;margin:21px 0 9px}.panel p{font-size:14px;line-height:1.65;color:#53696a}.panel .eyebrow{font-size:10px}.panel .actions{display:flex;flex-direction:column;gap:12px;max-width:420px}.back{position:absolute;right:25px;top:23px;background:none;border:1px solid #9dafa4;padding:7px 12px;color:var(--ink);border-radius:3px;font-size:12px}.setting{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:19px 0;font-size:15px}.setting label{font-weight:600}.setting small{display:block;font-size:11px;font-weight:400;color:var(--muted);margin-top:4px}.setting input[type=range]{accent-color:var(--teal);width:200px;height:26px}.setting output{min-width:42px;font:700 21px var(--display);text-align:right}.sliderpack{display:flex;align-items:center;gap:12px}.setting select,.setting input[type=text]{background:#e7eade;color:var(--ink);border:1px solid #a3b1a4;padding:10px;border-radius:4px;max-width:55%}.setting input[type=checkbox]{width:23px;height:23px;accent-color:var(--teal)}.hintrow{display:flex;gap:14px;align-items:center;padding:13px 0;border-bottom:1px solid #cbd1c4}.key{min-width:72px;font:800 22px var(--display);color:var(--teal)}.hintrow p{margin:0;font-size:13px}.tiles{display:grid;grid-template-columns:1fr 1fr;gap:13px}.tile{padding:16px;background:#e6e9dd;border-left:4px solid var(--teal);font-size:12px;line-height:1.6}.tile b{font:800 22px var(--display);display:block;text-transform:uppercase}.metadata{display:grid;grid-template-columns:120px 1fr;gap:7px;font-size:11px;line-height:1.6}.metadata dt{font-weight:700}.metadata dd{margin:0;color:#53696a}.feedback p{font-size:12px;margin:5px 0}.roomcode{font:800 46px var(--display);letter-spacing:6px;text-align:center;background:#e4e8db;border:1px dashed #8b9e91;padding:20px;margin:15px 0}.networkstatus{font-size:12px;color:var(--teal);min-height:36px;line-height:1.6}.endScore{font:800 90px var(--display);color:var(--orange);line-height:1;margin:16px 0}.statgrid{display:flex;gap:35px;margin:15px 0 25px}.statgrid b{display:block;font:800 30px var(--display)}.statgrid small{font-size:10px;text-transform:uppercase;letter-spacing:1px}.tiny{font-size:11px\"'!important;color:var(--muted)}#devBadge{display:none;position:absolute;top:58px;left:50%;transform:translateX(-50%);background:var(--yellow);padding:5px 15px;font-size:10px;letter-spacing:2px;z-index:3}.boardcaption{position:absolute;top:16%;right:5%;font:700 13px var(--display);letter-spacing:3px;writing-mode:vertical-rl;color:#8a9b92;z-index:1;pointer-events:none}\n@media(min-width:1700px){.panel{max-width:860px;padding:42px 50px}.panel p,.setting{font-size:18px}.panel .primary{font-size:27px;min-height:62px}.metadata{font-size:13px}}@media(max-width:850px){#topbar{padding:20px 5vw}.edition{display:none}.brand{font-size:20px}#title{padding:100px 6vw 75px}.titlecopy{width:52%}h1{font-size:clamp(65px,11vw,100px)}.subtitle{font-size:13px;max-width:250px}.titleactions{max-width:250px}.primary{font-size:20px;min-height:48px}.secondary{font-size:17px;min-height:40px}.minorlinks{gap:15px;margin-top:20px}.titlebadge{margin-top:20px}.decorlabel{display:none}.hudblock strong{font-size:30px}#stageName{font-size:22px;max-width:110px}.hudleft,.hudright{gap:22px}#hudTop{top:80px}.hudblock small{font-size:9px}.comboNum{font-size:45px}#chargeTip{display:none}#chargebox{width:16vw}#footer{font-size:8px}.panel{max-width:650px;padding:26px}.panel h2{font-size:43px}.boardcaption{display:none}}\n@media(max-width:560px) and (orientation:portrait){#title{align-items:flex-end;padding:75px 7vw 70px;background:linear-gradient(0deg,var(--paper) 0%,#f4f0e5f9 35%,#f4f0e500 83%)}.titlecopy{width:100%;max-width:none}h1{font-size:83px;line-height:.8;margin:0 0 20px}.eyebrow{font-size:9px;margin-bottom:21px}.subtitle{font-size:13px;max-width:310px;margin-bottom:18px}.titleactions{max-width:none;display:grid;grid-template-columns:1fr 1fr;gap:10px}.primary{grid-column:1/-1}.secondary{font-size:16px;padding:12px;gap:8px}.titlebadge,.decorlabel,.buttonhint,.titlecopy>.eyebrow{display:none}.minorlinks{justify-content:space-between;gap:15px}#topbar{padding:18px 6vw}.brand{font-size:18px}.textbutton{font-size:11px}#footer{bottom:18px;left:6vw;right:6vw;letter-spacing:1px}#footer span:last-child{display:none}#hudTop{top:67px;left:6vw;right:6vw}.hudleft,.hudright{flex-direction:row;gap:22px}.hudright .hudblock:last-child{display:none}#stageLabel{font-size:9px}#stageName{font-size:18px;max-width:120px}.hudblock strong{font-size:27px}.lives{font-size:15px}.hudblock small{font-size:8px;letter-spacing:1px}#chargebox{bottom:43px;left:6vw;width:130px}#combo{bottom:42px;right:6vw}.comboNum{font-size:34px}#combo small{font-size:8px}#playPrompt{bottom:17%;min-width:230px}.panel{padding:25px 22px;max-height:90vh}.panel h2{font-size:39px;margin:8px 0 22px}.panel .eyebrow{font-size:9px;letter-spacing:2px}.back{right:17px;top:18px}.panel p{font-size:12px}.setting{font-size:12px;gap:10px}.setting input[type=range]{width:125px}.setting output{font-size:18px}.tiles{grid-template-columns:1fr}.metadata{grid-template-columns:82px 1fr;font-size:10px}.panel h3{font-size:22px}#toast{font-size:20px;max-width:90vw;white-space:normal;text-align:center}#devBadge{top:40px}#chargeButton{font-size:10px;padding:9px}.sliderpack{gap:6px}.hintrow{padding:10px 0}.key{min-width:60px;font-size:18px}.hintrow p{font-size:12px}}\n@media(max-height:650px) and (min-width:561px){#title{padding-top:70px;padding-bottom:45px}h1{font-size:90px;margin:18px 0}.subtitle{margin-bottom:18px;font-size:13px}.titlebadge{display:none}.titleactions{gap:7px}.primary{min-height:43px;padding:10px 16px}.secondary{min-height:37px;padding:9px 16px}.minorlinks{margin-top:17px}#topbar{padding-top:17px}#footer{bottom:16px}.panel{padding:24px 32px;max-height:91vh}.panel h2{font-size:38px;margin:7px 0 18px}#hudTop{top:68px}.hudleft,.hudright{gap:18px}}\n</style>\n</head>\n<body>\n<div id=\"game\"></div><div id=\"screenwash\"></div>\n<div id=\"loading\"><b>Super<br><span style=\"color:#f2663e\">Bounceout</span></b><p id=\"loadtext\">WARMING UP THE INK…</p><p id=\"error\"></p></div>\n<header id=\"topbar\"><div class=\"brand\"><i class=\"mark\"></i> Bounceout<span class=\"edition\"> &nbsp; / &nbsp; INK ARCADE NO. 01</span></div><div class=\"topright\"><span class=\"edition\"><i class=\"statusdot\"></i><span id=\"engineTag\">WEBGPU ARCADE</span></span><button id=\"menuButton\" aria-label=\"Pause game\">Ⅱ <span data-prompt=\"pause\">Esc</span></button></div></header>\n<main id=\"title\"><div class=\"titlecopy\"><div class=\"eyebrow\">A little spin on a big classic</div><h1><em>Super</em><span>Bounceout</span></h1><p class=\"subtitle\">Good angles. Bad intentions.<br>One paddle against a whole wall of trouble.</p><div class=\"titleactions\"><button class=\"primary\" data-action=\"start\">Start run <span class=\"buttonhint\" data-prompt=\"serve\">Space ↵</span></button><button class=\"secondary\" data-action=\"coop\">Couch co-op <span class=\"buttonhint\">1–2 PLAYERS</span></button><button class=\"secondary\" data-action=\"online\">Online co-op <span class=\"buttonhint\">HOST / JOIN ↗</span></button></div><div class=\"minorlinks\"><button class=\"textbutton\" data-action=\"how\">How to play</button><button class=\"textbutton\" data-action=\"settings\">Settings</button><button class=\"textbutton\" data-action=\"about\">About & credits</button></div><div class=\"titlebadge\"><b>04</b><span>HANDCRAFTED STAGES<br>ONE UNREASONABLY GOOD BOUNCE</span></div></div><div class=\"decorlabel\">FRESH INK.<b>BIG BREAKS.</b></div></main>\n<div class=\"boardcaption\" id=\"boardCaption\">A STUDY IN CONTROLLED CHAOS / 1981 → 2026</div>\n<div id=\"hud\"><div id=\"hudTop\"><div class=\"hudleft\"><div class=\"hudblock\"><small>Team score</small><strong id=\"score\">000000</strong></div><div class=\"hudblock\"><small>Best run</small><strong id=\"best\">000000</strong></div></div><div class=\"hudright\"><div class=\"hudblock right\"><span id=\"stageLabel\">01 / 04</span><div id=\"stageName\">First impressions</div></div><div class=\"hudblock right\"><small>Balls to spare</small><div class=\"lives\" id=\"lives\">● ● ●</div></div></div></div><div id=\"chargebox\"><div class=\"meterlabel\"><span>Ink burst</span><b id=\"chargePct\">0%</b></div><div class=\"meter\"><i id=\"chargeFill\"></i></div><button id=\"chargeButton\">Unleash <span data-prompt=\"burst\">Shift</span> ✦</button><div id=\"chargeTip\">Break bricks to charge.<br>Pierce the wall for 5 seconds.</div></div><div id=\"combo\"><div class=\"comboNum\" id=\"comboValue\">×1</div><small id=\"comboLabel\">Make your mark</small></div><div id=\"playPrompt\"><div class=\"promptMain\" id=\"promptMain\">Press Space to serve</div><div class=\"promptSub\" id=\"promptSub\">Move the paddle to choose your angle</div></div></div>\n<div id=\"toast\"></div><div id=\"attract\"><b>LET’S MAKE A BREAK FOR IT</b><small>Attract mode · Any input to take over</small></div><div id=\"devBadge\">DEVELOPER TOOLS ACTIVE</div><div id=\"overlay\"><section class=\"panel\" id=\"panel\"></section></div>\n<footer id=\"footer\"><span id=\"footerLeft\">Move: mouse / ← → &nbsp; · &nbsp; Serve: Space &nbsp; · &nbsp; Burst: Shift</span><span>Made of ink. Powered by angles.</span></footer>\n<script type=\"module\">/*GAME_SCRIPT*/</script>\n</body></html>\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat > index.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<!--HUB_SESSION-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#f5f1e6\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-2\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Clear four brick constellations together. Highest team score wins.\">\n<meta name=\"hub:session-howto\" content=\"Move with left stick or mouse. Cross/Space serves. Triangle/Shift unleashes a charged piercing ball.\">\n<meta name=\"hub:session-minutes\" content=\"10\">\n<title>Super Bounceout — An ink & arcade original</title>\n<style>\n@import url('\"'https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap');\n:root{--paper:#f4f0e5;--ink:#162d37;--muted:#65777a;--orange:#f2663e;--yellow:#f8ce68;--teal:#1c8581;--line:#c9cec4;--display:'Barlow Condensed','Arial Narrow',Impact,sans-serif;--body:'DM Sans',Arial,sans-serif}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--paper);color:var(--ink);font-family:var(--body);user-select:none}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--orange);outline-offset:4px}button:disabled{opacity:.45;cursor:default}canvas{display:block;width:100%;height:100%;touch-action:none}#game{position:absolute;inset:0}#screenwash{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,transparent 0px,transparent 3px,#162d3705 3px,#162d3705 4px);mix-blend-mode:multiply}#loading{position:absolute;inset:0;background:var(--paper);display:grid;place-content:center;text-align:center;z-index:99}#loading b{font:900 clamp(40px,6vw,90px)/.9 var(--display);text-transform:uppercase}#loading p{letter-spacing:4px;font-size:13px}#error{display:none;color:#ac3a2d;max-width:600px;letter-spacing:0\"'!important}\n#topbar{position:absolute;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:27px 3.3vw;pointer-events:none;z-index:4}.brand{font:800 23px/.9 var(--display);letter-spacing:.5px;text-transform:uppercase}.brand .mark{display:inline-block;width:23px;height:18px;border:3px solid var(--ink);transform:skew(-12deg);margin-right:8px;position:relative}.brand .mark:after{content:'\"'';position:absolute;width:7px;height:7px;background:var(--orange);right:-7px;top:-8px;border-radius:50%}.edition{font-size:10px;letter-spacing:3px;color:var(--muted);text-transform:uppercase}.topright{display:flex;gap:20px;align-items:center}#menuButton{pointer-events:auto;border:1px solid #aab8b0;background:var(--paper);padding:10px 15px;border-radius:4px;display:none;color:var(--ink);font-weight:700}.statusdot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--teal);margin-right:7px}\n#title{position:absolute;inset:0;display:flex;align-items:center;z-index:3;padding:96px 7.5vw 72px;pointer-events:none}.titlecopy{width:45%;max-width:660px;pointer-events:auto}.eyebrow{font-size:11px;font-weight:700;letter-spacing:3.5px;text-transform:uppercase;display:flex;align-items:center;gap:13px}.eyebrow:before{content:'';height:2px;width:34px;background:var(--orange)}h1{font:900 clamp(74px,8.5vw,158px)/.79 var(--display);text-transform:uppercase;letter-spacing:-2px;margin:30px 0 26px;transform:rotate(-2deg);position:relative}h1 span{display:block;color:var(--orange);-webkit-text-stroke:1px var(--orange)}h1 em{font-style:normal;display:block;padding-left:3px}.subtitle{font-size:clamp(15px,1.1vw,18px);line-height:1.6;max-width:360px;color:#52666b;margin:0 0 27px}.titleactions{display:flex;flex-direction:column;gap:9px;max-width:330px}.primary,.secondary{min-height:53px;text-transform:uppercase;font:700 23px/1 var(--display);letter-spacing:1px;border:2px solid var(--ink);padding:13px 21px;border-radius:4px;text-align:left;display:flex;align-items:center;justify-content:space-between;gap:25px;color:var(--ink);transition:transform .12s,background .12s,box-shadow .12s}.primary{background:var(--ink);color:var(--paper);box-shadow:4px 4px 0 var(--orange)}.primary:hover,.primary.focused{background:var(--orange);transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}.secondary{background:transparent;min-height:44px;font-size:19px;border-color:#9caca4}.secondary:hover,.secondary.focused{background:#e1e6d9;transform:translateX(4px)}.buttonhint{font-family:var(--body);font-size:12px;font-weight:500;white-space:nowrap;opacity:.7}.minorlinks{display:flex;gap:24px;margin-top:27px;flex-wrap:wrap}.textbutton{border:0;border-bottom:1px solid transparent;padding:2px 0;background:none;color:#4f6668;font-size:12px;letter-spacing:.3px;font-weight:600}.textbutton:hover,.textbutton.focused{color:var(--orange);border-bottom-color:var(--orange)}.titlebadge{display:flex;gap:15px;align-items:center;margin-top:28px;font-size:10px;line-height:1.5;letter-spacing:1.6px;text-transform:uppercase;color:var(--muted)}.titlebadge b{font:800 34px var(--display);color:var(--ink);border-right:1px solid var(--line);padding-right:14px}.decorlabel{position:absolute;right:6vw;bottom:12%;transform:rotate(-7deg);pointer-events:none;font:700 18px var(--display);letter-spacing:1px;color:var(--teal);border:2px solid var(--teal);border-radius:50%;padding:15px 23px;text-align:center}.decorlabel b{display:block;font-size:33px;line-height:1}#footer{position:absolute;bottom:25px;left:3.3vw;right:3.3vw;display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:1.7px;color:var(--muted);z-index:3;pointer-events:none}\n#hud{display:none;position:absolute;inset:0;pointer-events:none;z-index:2}#hudTop{position:absolute;top:88px;left:3.3vw;right:3.3vw;display:flex;justify-content:space-between;align-items:start}.hudblock small{display:block;letter-spacing:2.5px;font-size:10px;text-transform:uppercase;color:var(--muted);margin-bottom:4px}.hudblock strong{font:700 40px/1 var(--display)}.hudblock.right{text-align:right}.hudleft,.hudright{display:flex;flex-direction:column;gap:30px}.lives{font-size:22px;color:var(--orange);letter-spacing:4px}#stageName{font:800 29px/1 var(--display);text-transform:uppercase;max-width:170px}#stageLabel{display:block;font-size:11px;letter-spacing:2px;margin-bottom:7px;color:var(--teal)}#chargebox{position:absolute;bottom:70px;left:3.3vw;width:min(210px,17vw)}.meterlabel{display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:9px}.meter{height:8px;background:#d5d9ce;transform:skew(-14deg);border:1px solid #9aaaa2}.meter i{display:block;height:100%;background:var(--orange);width:0%}#chargeButton{pointer-events:auto;background:var(--ink);border:0;border-radius:4px;color:var(--paper);font-size:12px;padding:12px;width:100%;margin-top:10px;display:none}#chargeButton.ready{display:block}#chargeTip{font-size:11px;line-height:1.5;color:var(--muted);margin-top:9px}#combo{position:absolute;right:3.3vw;bottom:85px;text-align:right}.comboNum{font:800 65px/.9 var(--display);color:var(--orange)}#combo small{font-size:10px;letter-spacing:2px;display:block;margin-top:6px}#playPrompt{position:absolute;bottom:8%;left:50%;transform:translateX(-50%);text-align:center;padding:12px 22px;border:1px solid #9eafa5;background:#f4f0e5e8;border-radius:3px;min-width:240px}.promptMain{font:700 22px var(--display);letter-spacing:1px;text-transform:uppercase}.promptSub{font-size:11px;color:var(--muted);margin-top:5px}#toast{position:absolute;left:50%;top:19%;transform:translateX(-50%) rotate(-2deg);padding:13px 26px;background:var(--yellow);color:var(--ink);border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);font:800 26px var(--display);text-transform:uppercase;opacity:0;transition:opacity .15s;pointer-events:none;z-index:6;white-space:nowrap}#attract{display:none;position:absolute;bottom:8%;left:50%;transform:translateX(-50%);text-align:center;color:var(--ink);z-index:3;background:var(--paper);padding:14px 25px;border:2px solid var(--ink);box-shadow:4px 4px 0 var(--orange)}#attract b{font:800 25px var(--display);letter-spacing:2px}#attract small{display:block;font-size:11px;margin-top:5px}\n#overlay{position:absolute;inset:0;background:#142a34a8;backdrop-filter:blur(9px);z-index:12;display:none;align-items:center;justify-content:center;padding:55px 20px}.panel{background:var(--paper);border:2px solid var(--ink);box-shadow:8px 8px 0 #0e2029;border-radius:5px;padding:32px 40px;max-width:760px;width:100%;max-height:88vh;overflow:auto;position:relative}.panel h2{font:800 52px/.9 var(--display);text-transform:uppercase;letter-spacing:-.6px;margin:10px 0 24px}.panel h3{font:800 26px var(--display);text-transform:uppercase;margin:21px 0 9px}.panel p{font-size:14px;line-height:1.65;color:#53696a}.panel .eyebrow{font-size:10px}.panel .actions{display:flex;flex-direction:column;gap:12px;max-width:420px}.back{position:absolute;right:25px;top:23px;background:none;border:1px solid #9dafa4;padding:7px 12px;color:var(--ink);border-radius:3px;font-size:12px}.setting{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:19px 0;font-size:15px}.setting label{font-weight:600}.setting small{display:block;font-size:11px;font-weight:400;color:var(--muted);margin-top:4px}.setting input[type=range]{accent-color:var(--teal);width:200px;height:26px}.setting output{min-width:42px;font:700 21px var(--display);text-align:right}.sliderpack{display:flex;align-items:center;gap:12px}.setting select,.setting input[type=text]{background:#e7eade;color:var(--ink);border:1px solid #a3b1a4;padding:10px;border-radius:4px;max-width:55%}.setting input[type=checkbox]{width:23px;height:23px;accent-color:var(--teal)}.hintrow{display:flex;gap:14px;align-items:center;padding:13px 0;border-bottom:1px solid #cbd1c4}.key{min-width:72px;font:800 22px var(--display);color:var(--teal)}.hintrow p{margin:0;font-size:13px}.tiles{display:grid;grid-template-columns:1fr 1fr;gap:13px}.tile{padding:16px;background:#e6e9dd;border-left:4px solid var(--teal);font-size:12px;line-height:1.6}.tile b{font:800 22px var(--display);display:block;text-transform:uppercase}.metadata{display:grid;grid-template-columns:120px 1fr;gap:7px;font-size:11px;line-height:1.6}.metadata dt{font-weight:700}.metadata dd{margin:0;color:#53696a}.feedback p{font-size:12px;margin:5px 0}.roomcode{font:800 46px var(--display);letter-spacing:6px;text-align:center;background:#e4e8db;border:1px dashed #8b9e91;padding:20px;margin:15px 0}.networkstatus{font-size:12px;color:var(--teal);min-height:36px;line-height:1.6}.endScore{font:800 90px var(--display);color:var(--orange);line-height:1;margin:16px 0}.statgrid{display:flex;gap:35px;margin:15px 0 25px}.statgrid b{display:block;font:800 30px var(--display)}.statgrid small{font-size:10px;text-transform:uppercase;letter-spacing:1px}.tiny{font-size:11px\"'!important;color:var(--muted)}#devBadge{display:none;position:absolute;top:58px;left:50%;transform:translateX(-50%);background:var(--yellow);padding:5px 15px;font-size:10px;letter-spacing:2px;z-index:3}.boardcaption{position:absolute;top:16%;right:5%;font:700 13px var(--display);letter-spacing:3px;writing-mode:vertical-rl;color:#8a9b92;z-index:1;pointer-events:none}\n@media(min-width:1700px){.panel{max-width:860px;padding:42px 50px}.panel p,.setting{font-size:18px}.panel .primary{font-size:27px;min-height:62px}.metadata{font-size:13px}}@media(max-width:850px){#topbar{padding:20px 5vw}.edition{display:none}.brand{font-size:20px}#title{padding:100px 6vw 75px}.titlecopy{width:52%}h1{font-size:clamp(65px,11vw,100px)}.subtitle{font-size:13px;max-width:250px}.titleactions{max-width:250px}.primary{font-size:20px;min-height:48px}.secondary{font-size:17px;min-height:40px}.minorlinks{gap:15px;margin-top:20px}.titlebadge{margin-top:20px}.decorlabel{display:none}.hudblock strong{font-size:30px}#stageName{font-size:22px;max-width:110px}.hudleft,.hudright{gap:22px}#hudTop{top:80px}.hudblock small{font-size:9px}.comboNum{font-size:45px}#chargeTip{display:none}#chargebox{width:16vw}#footer{font-size:8px}.panel{max-width:650px;padding:26px}.panel h2{font-size:43px}.boardcaption{display:none}}\n@media(max-width:560px) and (orientation:portrait){#title{align-items:flex-end;padding:75px 7vw 70px;background:linear-gradient(0deg,var(--paper) 0%,#f4f0e5f9 35%,#f4f0e500 83%)}.titlecopy{width:100%;max-width:none}h1{font-size:83px;line-height:.8;margin:0 0 20px}.eyebrow{font-size:9px;margin-bottom:21px}.subtitle{font-size:13px;max-width:310px;margin-bottom:18px}.titleactions{max-width:none;display:grid;grid-template-columns:1fr 1fr;gap:10px}.primary{grid-column:1/-1}.secondary{font-size:16px;padding:12px;gap:8px}.titlebadge,.decorlabel,.buttonhint,.titlecopy>.eyebrow{display:none}.minorlinks{justify-content:space-between;gap:15px}#topbar{padding:18px 6vw}.brand{font-size:18px}.textbutton{font-size:11px}#footer{bottom:18px;left:6vw;right:6vw;letter-spacing:1px}#footer span:last-child{display:none}#hudTop{top:67px;left:6vw;right:6vw}.hudleft,.hudright{flex-direction:row;gap:22px}.hudright .hudblock:last-child{display:none}#stageLabel{font-size:9px}#stageName{font-size:18px;max-width:120px}.hudblock strong{font-size:27px}.lives{font-size:15px}.hudblock small{font-size:8px;letter-spacing:1px}#chargebox{bottom:43px;left:6vw;width:130px}#combo{bottom:42px;right:6vw}.comboNum{font-size:34px}#combo small{font-size:8px}#playPrompt{bottom:17%;min-width:230px}.panel{padding:25px 22px;max-height:90vh}.panel h2{font-size:39px;margin:8px 0 22px}.panel .eyebrow{font-size:9px;letter-spacing:2px}.back{right:17px;top:18px}.panel p{font-size:12px}.setting{font-size:12px;gap:10px}.setting input[type=range]{width:125px}.setting output{font-size:18px}.tiles{grid-template-columns:1fr}.metadata{grid-template-columns:82px 1fr;font-size:10px}.panel h3{font-size:22px}#toast{font-size:20px;max-width:90vw;white-space:normal;text-align:center}#devBadge{top:40px}#chargeButton{font-size:10px;padding:9px}.sliderpack{gap:6px}.hintrow{padding:10px 0}.key{min-width:60px;font-size:18px}.hintrow p{font-size:12px}}\n@media(max-height:650px) and (min-width:561px){#title{padding-top:70px;padding-bottom:45px}h1{font-size:90px;margin:18px 0}.subtitle{margin-bottom:18px;font-size:13px}.titlebadge{display:none}.titleactions{gap:7px}.primary{min-height:43px;padding:10px 16px}.secondary{min-height:37px;padding:9px 16px}.minorlinks{margin-top:17px}#topbar{padding-top:17px}#footer{bottom:16px}.panel{padding:24px 32px;max-height:91vh}.panel h2{font-size:38px;margin:7px 0 18px}#hudTop{top:68px}.hudleft,.hudright{gap:18px}}\n</style>\n</head>\n<body>\n<div id=\"game\"></div><div id=\"screenwash\"></div>\n<div id=\"loading\"><b>Super<br><span style=\"color:#f2663e\">Bounceout</span></b><p id=\"loadtext\">WARMING UP THE INK…</p><p id=\"error\"></p></div>\n<header id=\"topbar\"><div class=\"brand\"><i class=\"mark\"></i> Bounceout<span class=\"edition\"> &nbsp; / &nbsp; INK ARCADE NO. 01</span></div><div class=\"topright\"><span class=\"edition\"><i class=\"statusdot\"></i><span id=\"engineTag\">WEBGPU ARCADE</span></span><button id=\"menuButton\" aria-label=\"Pause game\">Ⅱ <span data-prompt=\"pause\">Esc</span></button></div></header>\n<main id=\"title\"><div class=\"titlecopy\"><div class=\"eyebrow\">A little spin on a big classic</div><h1><em>Super</em><span>Bounceout</span></h1><p class=\"subtitle\">Good angles. Bad intentions.<br>One paddle against a whole wall of trouble.</p><div class=\"titleactions\"><button class=\"primary\" data-action=\"start\">Start run <span class=\"buttonhint\" data-prompt=\"serve\">Space ↵</span></button><button class=\"secondary\" data-action=\"coop\">Couch co-op <span class=\"buttonhint\">1–2 PLAYERS</span></button><button class=\"secondary\" data-action=\"online\">Online co-op <span class=\"buttonhint\">HOST / JOIN ↗</span></button></div><div class=\"minorlinks\"><button class=\"textbutton\" data-action=\"how\">How to play</button><button class=\"textbutton\" data-action=\"settings\">Settings</button><button class=\"textbutton\" data-action=\"about\">About & credits</button></div><div class=\"titlebadge\"><b>04</b><span>HANDCRAFTED STAGES<br>ONE UNREASONABLY GOOD BOUNCE</span></div></div><div class=\"decorlabel\">FRESH INK.<b>BIG BREAKS.</b></div></main>\n<div class=\"boardcaption\" id=\"boardCaption\">A STUDY IN CONTROLLED CHAOS / 1981 → 2026</div>\n<div id=\"hud\"><div id=\"hudTop\"><div class=\"hudleft\"><div class=\"hudblock\"><small>Team score</small><strong id=\"score\">000000</strong></div><div class=\"hudblock\"><small>Best run</small><strong id=\"best\">000000</strong></div></div><div class=\"hudright\"><div class=\"hudblock right\"><span id=\"stageLabel\">01 / 04</span><div id=\"stageName\">First impressions</div></div><div class=\"hudblock right\"><small>Balls to spare</small><div class=\"lives\" id=\"lives\">● ● ●</div></div></div></div><div id=\"chargebox\"><div class=\"meterlabel\"><span>Ink burst</span><b id=\"chargePct\">0%</b></div><div class=\"meter\"><i id=\"chargeFill\"></i></div><button id=\"chargeButton\">Unleash <span data-prompt=\"burst\">Shift</span> ✦</button><div id=\"chargeTip\">Break bricks to charge.<br>Pierce the wall for 5 seconds.</div></div><div id=\"combo\"><div class=\"comboNum\" id=\"comboValue\">×1</div><small id=\"comboLabel\">Make your mark</small></div><div id=\"playPrompt\"><div class=\"promptMain\" id=\"promptMain\">Press Space to serve</div><div class=\"promptSub\" id=\"promptSub\">Move the paddle to choose your angle</div></div></div>\n<div id=\"toast\"></div><div id=\"attract\"><b>LET’S MAKE A BREAK FOR IT</b><small>Attract mode · Any input to take over</small></div><div id=\"devBadge\">DEVELOPER TOOLS ACTIVE</div><div id=\"overlay\"><section class=\"panel\" id=\"panel\"></section></div>\n<footer id=\"footer\"><span id=\"footerLeft\">Move: mouse / ← → &nbsp; · &nbsp; Serve: Space &nbsp; · &nbsp; Burst: Shift</span><span>Made of ink. Powered by angles.</span></footer>\n<script type=\"module\">/*GAME_SCRIPT*/</script>\n</body></html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"The random title draw picked **Super Bounceout**. The visual design uses warm paper, thick navy ink, coral and teal blocks, and a playable 3D board on the title screen. The audio and multiplayer modules are ready; I’m building the stage flow, physics, and controls now.\n"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {color, float, normalWorld, vec3} from 'three/tsl';\nimport RAPIER from '@dimforge/rapier2d-compat';\nimport {ArcadeAudio} from './audio.js';\nimport {createOnline} from './online.js';\n\nconst \"'$=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), rand=(a,b)=>a+Math.random()*(b-a);\nconst C={ink:0x162d37,paper:0xf4f0e5,teal:0x2a9690,coral:0xf2663e,yellow:0xf8ce68,blue:0x6ba5b7,cream:0xe6ddbd};\nconst palette=[C.teal,C.blue,C.yellow,C.coral];\nconst STAGES=[\n {name:'\"'First impressions',type:'CLASSIC',tag:'Find your angle. Leave your mark.',tip:'Hit the paddle edge for a sharper angle.',rows:6},\n {name:'Pocket universe',type:'CAVITY',tag:'A little company in the cosmos.',tip:'Break open the pockets to free two captive balls.',rows:7},\n {name:'Double trouble',type:'DOUBLE',tag:'Two paddles. Twice the possibilities.',tip:'Your second paddle moves with you. Mind the gap.',rows:7},\n {name:'The big squeeze',type:'PROGRESSIVE',tag:'The wall has places to be.',tip:'The wall steps down every 22 seconds. Keep it moving.',rows:8}\n];\nconst DEFAULTS={speed:11,paddleWidth:3.1,chargeRate:1,god:false,auto:false};\nconst settings=Object.assign({music:.1,sfx:.65,glyphs:'ps',shake:true,assist:false},readStore('bounceout-settings',{}));\nlet best=+readStore('bounceout-best',0)||0;\nfunction readStore(k,f){try{return JSON.parse(localStorage.getItem(k))??f}catch{return f}}\nfunction saveSettings(){try{localStorage.setItem('bounceout-settings',JSON.stringify(settings))}catch{}}\nconst audio=new ArcadeAudio();audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);\nlet renderer,scene,camera,world,events,playGroup,boardGroup,titleGroup,paddles=[],bricks=[],balls=[],powerups=[],particles=[],mixers=[],captive=[];\nconst colliders=new Map();let fixedBodies=[];\nconst cfg={...DEFAULTS};\nlet phase='title',mode='solo',stage=0,score=0,lives=3,combo=0,charge=0,burst=0,wideTime=0,slowTime=0,gameTime=0,phaseTime=0,progressTime=0,elapsed=0;\nlet lastTime=0,accumulator=0,idleAt=performance.now(),lastInput='keyboard',menuName='',returnMenu='title',menuFocus=0,menuRepeat=0,keys=new Set(),padPrevious=[],pointerX=0,pointerActive=false,remoteInput={x:0},devUsed=false;\nlet toastTime=0,shake=0,networkTimer=0,netBuild=-1,lastNetState=null,netMode='solo',ballID=1,dropID=0,hubEnded=false;\nlet stats={brickHits:0,paddleHits:0,lostBalls:0,powers:0,bursts:0};\nlet metrics={frames:0,steps:0,renderErrors:0};\nlet inputSeats=[{x:0,axis:0},{x:0,axis:0}];let fxTexture;\nconst online=createOnline({\n onStatus(text){if(\"'$('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent=text;},\n onRole(role){if(role==='guest')netMode='guest';else if(role==='host')netMode='host';else netMode='solo';},\n onStart(info){if(\"'!renderer)return;startRun('\"'online');toast(online.isHub?'SESSION READY':'PARTNER CONNECTED');},\n onInput(input,seat){remoteInput=input||{};if(online.isHub&&seat===0&&online.mySeat\"'!==0)inputSeats[0]=input||{x:0};else inputSeats[1]=input||{x:0};if(input.serve)serve();if(input.burst)activateBurst();},\n onState(s){lastNetState=s;applyNet(s);},\n onEnd(reason){hubEnded=true;keys.clear();phase='\"'gameover';showEnd(false,'SESSION COMPLETE');audio.setMuted(true);},\n onTimeUp(){finishRun(false,'TIME’S UP');},\n onLeave(){if(phase==='playing'){toast('PARTNER LEFT · SOLO PADDLE');mode='solo';paddles.forEach((p,i)=>{if(i===1)p.group.visible=false;});}}\n});\n\nfunction cel(c){const m=new THREE.MeshBasicNodeMaterial();m.colorNode=color(c).mul(float(.56).add(normalWorld.dot(vec3(-.35,.6,1).normalize()).max(0).mul(3).floor().div(3).mul(.44)));return m;}\nconst mats={};function mat(c){return mats[c]??(mats[c]=cel(c))}\nconst inkMat=new THREE.MeshBasicMaterial({color:C.ink});\nconst outlineMat=new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide});\nfunction box(w,h,d,c,outline=true){const g=new THREE.Group();const geo=new THREE.BoxGeometry(w,h,d);if(outline){const edge=new THREE.Mesh(geo,outlineMat);edge.scale.set(1+.065/Math.max(w,.2),1+.065/Math.max(h,.2),1+.065/Math.max(d,.2));g.add(edge)}const mesh=new THREE.Mesh(geo,mat(c));g.add(mesh);return g;}\nfunction ballMesh(c=C.paper,r=.2){const g=new THREE.Group();const geo=new THREE.IcosahedronGeometry(r,2);const edge=new THREE.Mesh(geo,outlineMat);edge.scale.setScalar(1.2);g.add(edge,new THREE.Mesh(geo,mat(c)));return g;}\nfunction line(points,c=C.ink,opacity=1){const m=new THREE.LineBasicMaterial({color:c,transparent:opacity<1,opacity});return new THREE.Line(new THREE.BufferGeometry().setFromPoints(points.map(p=>new THREE.Vector3(...p))),m)}\nfunction labelTexture(text,fg='#162d37',bg=null,size=64){const canvas=document.createElement('canvas');canvas.width=1024;canvas.height=128;const ctx=canvas.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,1024,128)}ctx.fillStyle=fg;ctx.font=\"'`800 ${size}px \"Barlow Condensed\", \"Arial Narrow\", sans-serif`;ctx.textAlign='\"'center';ctx.textBaseline='middle';ctx.fillText(text,512,68);const t=new THREE.CanvasTexture(canvas);t.colorSpace=THREE.SRGBColorSpace;return t;}\nfunction worldLabel(text,x,y,w=10,h=1,fg='#162d37'){const m=new THREE.MeshBasicMaterial({map:labelTexture(text,fg),transparent:true,depthWrite:false});const o=new THREE.Mesh(new THREE.PlaneGeometry(w,h),m);o.position.set(x,y,.12);return o}\nfunction animatePop(object,remove=true,duration=.3){const mix=new THREE.AnimationMixer(object);const clip=new THREE.AnimationClip('ink-pop',duration,[new THREE.VectorKeyframeTrack('.scale',[0,duration*.3,duration],[1,1,1,1.25,1.25,1.25,0,0,0]),new THREE.NumberKeyframeTrack('.rotation[z]',[0,duration],[0,rand(-.7,.7)])]);mix.clipAction(clip).setLoop(THREE.LoopOnce).play();mixers.push({mix,object,time:duration,remove});}\nfunction burstParticles(x,y,c,count=9){for(let i=0;i<count;i++){const o=box(rand(.05,.15),rand(.1,.27),.08,c,false);o.position.set(x,y,.5);playGroup.add(o);particles.push({o,vx:rand(-3,3),vy:rand(-3,3),vz:rand(0,2),life:rand(.3,.6),max:.6,spin:rand(-8,8)})}}\nfunction toast(t,seconds=2.4){\"'$('\"'#toast').textContent=t;toastTime=seconds;\"'$('\"'#toast').style.opacity=1;}\nfunction bump(p){p.squish=.16;}\nfunction buildScene(){\n scene=new THREE.Scene();scene.background=new THREE.Color(C.paper);camera=new THREE.OrthographicCamera(-18,18,14,-14,.1,150);camera.position.set(0,-3.8,50);camera.lookAt(0,0,0);\n boardGroup=new THREE.Group();scene.add(boardGroup);playGroup=new THREE.Group();boardGroup.add(playGroup);\n const back=box(19.3,25,.35,0xe3e8dc,true);back.position.z=-.8;boardGroup.add(back);\n const inner=new THREE.Mesh(new THREE.PlaneGeometry(18.35,24),new THREE.MeshBasicMaterial({color:0xeef0e3}));inner.position.z=-.58;boardGroup.add(inner);\n // Registration grid, rails and paper-cut shadows.\n for(let x=-9;x<=9;x+=1){boardGroup.add(line([[x,-11.8,-.55],[x,11.8,-.55]],0xc0cdbb,.4))}\n for(let y=-11;y<=11;y+=1){boardGroup.add(line([[-9.1,y,-.55],[9.1,y,-.55]],0xc0cdbb,.4))}\n for(const x of [-9.45,9.45]){const rail=box(.33,24.5,.6,C.ink,false);rail.position.set(x,0,-.2);boardGroup.add(rail);for(let y=-11;y<12;y+=1.2){const dash=box(.07,.45,.03,0x54716f,false);dash.position.set(x,y,.13);boardGroup.add(dash)}}\n const top=box(19.25,.38,.55,C.ink,false);top.position.set(0,12.2,-.1);boardGroup.add(top);\n const drain=line([[-9,-11.6,-.1],[9,-11.6,-.1]],C.coral,.7);boardGroup.add(drain);\n boardGroup.add(worldLabel('THE ANGLE IS EVERYTHING',0,-11.9,8,.7,'#657e72'));\n boardGroup.add(worldLabel('BOUNCE / BREAK / REPEAT',0,11.55,11,.75,'#657e72'));\n for(const x of [-8.8,8.8])for(const y of [-11.9,11.8]){const screw=ballMesh(0x9fae9e,.1);screw.position.set(x,y,-.2);boardGroup.add(screw)}\n titleGroup=new THREE.Group();scene.add(titleGroup);\n // Print-shop orbital doodles behind the cabinet.\n for(let i=0;i<3;i++){const radius=10.5+i*.45;const pts=[];for(let j=0;j<=110;j++){const a=j/110*Math.PI*2;pts.push([Math.cos(a)*radius,Math.sin(a)*radius,0])}const ring=line(pts,0xa9bab0,.5);ring.scale.y=.8;ring.position.set(8,0,-3);titleGroup.add(ring)}\n for(let i=0;i<11;i++){const star=new THREE.Group();star.add(box(.4,.06,.03,C.teal,false),box(.06,.4,.03,C.teal,false));star.position.set(rand(-12,17),rand(-12,12),-2);titleGroup.add(star);}\n resize();\n}\nfunction disposeWorld(){if(world)world.free();world=new RAPIER.World({x:0,y:0});world.timestep=1/120;events?.free();events=new RAPIER.EventQueue(true);colliders.clear();fixedBodies=[];}\nfunction fixedBox(x,y,w,h,type='wall',data=null,sensor=false){const b=world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x,y));const c=world.createCollider(RAPIER.ColliderDesc.cuboid(w/2,h/2).setRestitution(1).setFriction(0).setSensor(sensor).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),b);colliders.set(c.handle,{type,data});fixedBodies.push(b);return {body:b,collider:c};}\nfunction createPaddle(i){const g=new THREE.Group();const c=i===0?C.teal:C.coral;const body=box(3.1,.32,.42,c);g.add(body);const inset=box(2.45,.055,.02,C.paper,false);inset.position.set(0,.055,.23);g.add(inset);for(const x of [-1.2,1.2]){const cap=box(.16,.39,.48,C.ink,false);cap.position.x=x;g.add(cap)}const y=mode==='coop'||mode==='online'?-9.8+i*.58:-9.6;\n g.position.set(0,y,.3);playGroup.add(g);const rb=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0,y));const col=world.createCollider(RAPIER.ColliderDesc.cuboid(1.55,.2).setRestitution(1).setFriction(0).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),rb);const p={group:g,body:rb,collider:col,x:0,y,width:3.1,seat:i,squish:0};colliders.set(col.handle,{type:'paddle',data:p});paddles.push(p);return p;\n}\nfunction addBall(x,y,vx=0,vy=0){const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,y).setLinvel(vx,vy).setCcdEnabled(true).lockRotations().setLinearDamping(0).setCanSleep(false));const collider=world.createCollider(RAPIER.ColliderDesc.ball(.2).setRestitution(1).setRestitutionCombineRule(RAPIER.CoefficientCombineRule.Max).setFriction(0).setDensity(1).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);const g=ballMesh(C.paper,.2);g.position.set(x,y,.4);playGroup.add(g);const trail=[];for(let i=0;i<10;i++){const o=ballMesh(i<3?C.yellow:C.teal,.15*(1-i/12));o.visible=false;playGroup.add(o);trail.push(o)}const b={id:ballID++,body,collider,group:g,trail,history:[],docked:\"'!vx&&!vy,prev:{x:vx,y:vy},lastY:y,stuck:0};balls.push(b);colliders.set(collider.handle,{type:'\"'ball',data:b});return b;}\nfunction addBrick(col,row,c,hp=1,kind='normal',offset=0){const w=1.78,h=.64,x=-7.68+col*1.92,y=8.8-row*.87+offset;const group=box(w,h,.48,c);group.position.set(x,y,.02);const shine=box(w-.2,.045,.01,0xffffff,false);shine.position.set(0,.16,.25);group.add(shine);if(hp>1){for(const dx of [-.22,.22]){const mark=box(.11,.11,.02,C.ink,false);mark.position.set(dx,-.07,.26);group.add(mark)}}if(kind==='power'){const mark=box(.18,.23,.025,C.paper,false);mark.rotation.z=Math.PI/4;mark.position.z=.27;group.add(mark)}playGroup.add(group);const b={id:row*9+col,col,row,x,y,w,h,hp,maxHp:hp,c,kind,group,alive:true};Object.assign(b,fixedBox(x,y,w,h,'brick',b));bricks.push(b);return b;}\nfunction layout(n){for(let r=0;r<STAGES[n].rows;r++)for(let c=0;c<9;c++){\n let skip=false,hp=1,kind='normal';const colorIndex=clamp(Math.floor(r/2),0,3);let cc=palette[3-colorIndex];\n if(n===0){skip=(r===0&&(c<2||c>6))||(r===1&&(c===0||c===8));if(r===4&&(c===2||c===6))kind='power';}\n if(n===1){skip=(r>=2&&r<=3&&(c===2||c===6))||(r===0&&(c===0||c===8));if(r===4&&(c===2||c===6)){kind='cavity';cc=C.yellow;}if(r===1&&(c===2||c===6))hp=2;}\n if(n===2){skip=((c+r)%7===0);hp=r<2?2:1;if(r===5&&(c===2||c===6))kind='power';}\n if(n===3){skip=(r===0&&(c%2===0));hp=r<2?2:1;if(r===6&&(c===1||c===7))kind='power';cc=palette[(r+c)%4];}\n if(\"'!skip)addBrick(c,r,cc,hp,kind);\n }\n if(n===1){for(const x of [-3.84,3.84]){const g=ballMesh(C.yellow,.25);g.position.set(x,6.6,.4);playGroup.add(g);captive.push({x,y:6.6,g});}}\n}\nfunction clearVisuals(){while(playGroup.children.length)playGroup.remove(playGroup.children[0]);paddles=[];bricks=[];balls=[];powerups=[];particles=[];mixers=[];captive=[];}\nfunction loadStage(n){stage=n;clearVisuals();disposeWorld();fixedBox(-9.36,0,.3,25);fixedBox(9.36,0,.3,25);fixedBox(0,12.2,19,.4);createPaddle(0);if(mode==='\"'coop'||mode==='online')createPaddle(1);if(n===2){const p=createPaddle(2);p.seat=0;p.y=-7.4;p.body.setTranslation({x:0,y:p.y},true);p.group.position.y=p.y;p.group.children[0].children[1].material=mat(C.blue);}\n layout(n);addBall(0,-9,0,0);combo=0;burst=0;wideTime=0;slowTime=0;progressTime=0;phaseTime=0;audio.setStage(n);netBuild=n;\n}\nfunction startRun(m='solo'){if(hubEnded&&online.isHub)return;mode=m;score=0;lives=3;charge=0;elapsed=0;stats={brickHits:0,paddleHits:0,lostBalls:0,powers:0,bursts:0};phase='playing';loadStage(0);hideOverlay();pointerActive=false;\"'$('\"'#title').style.display='none';\"'$('\"'#hud').style.display='block';\"'$('\"'#attract').style.display='none';\"'$('\"'#menuButton').style.display='block';\"'$('\"'#boardCaption').style.display='none';\"'$('\"'#footer').style.display='flex';\"'$('\"'#footerLeft').textContent=mode==='coop'?'P1: A / D · P2: ← / → · Space: serve · Shift: burst':'MOVE THE PADDLE · FIND YOUR ANGLE · MAKE YOUR MARK';audio.play('stage');audio.speak('ready');toast(\"'`${STAGES[stage].type} / ${STAGES[stage].name}`);updateUI();resize();}\nfunction showTitle(){if(online.isHub)return;phase='\"'title';mode='solo';online.leave();netMode='solo';hubEnded=false;cfg.auto=false;hideOverlay();loadStage(0);\"'$('\"'#title').style.display='flex';\"'$('\"'#hud').style.display='none';\"'$('\"'#attract').style.display='none';\"'$('\"'#menuButton').style.display='none';\"'$('\"'#boardCaption').style.display='block';\"'$('\"'#footer').style.display='flex';idleAt=performance.now();setPrompts();resize();}\nfunction serve(){if(netMode==='guest'){sendAction('serve');return;}if(phase==='clear'){nextStage();return}if(phase\"'!=='\"'playing'&&phase\"'!=='\"'attract')return;let did=false;for(const b of balls)if(b.docked){const x=clamp(paddles[0]?.x/10,-.55,.55);const v=cfg.speed; b.docked=false;b.body.setLinvel({x:(x||.28)*v,y:Math.sqrt(1-(x||.28)**2)*v},true);did=true;}if(did){audio.play('launch');phaseTime=0;}}\nfunction activateBurst(){if(netMode==='guest'){sendAction('burst');return}if(charge<100||\"'!['\"'playing','attract'].includes(phase))return;charge=0;burst=5;stats.bursts++;toast('INK BURST\"'! · PIERCE THE WALL'\"');audio.play('burst');audio.speak('power');shake=.2;serve();}\nfunction nextStage(){if(stage>=3){finishRun(true);return}phase='playing';loadStage(stage+1);audio.play('stage');audio.speak('ready');toast(\"'`${STAGES[stage].type} / ${STAGES[stage].name}`,3);}\nfunction stageComplete(){if(!['\"'playing','attract'].includes(phase))return;score+=500+(lives*100);if(phase==='attract'){loadStage((stage+1)%4);phase='attract';return}phase='clear';phaseTime=0;audio.play('win');toast('A CLEAN BREAK. +'+(500+lives*100),3);if(stage===3){finishRun(true);return}updateUI();}\nfunction finishRun(won,heading){phase=won?'victory':'gameover';if(score>best){best=score;try{localStorage.setItem('bounceout-best',best)}catch{}}if(online.active&&netMode==='host')online.finish(score,won);audio.play(won?'win':'lose');if(won)audio.speak('win');showEnd(won,heading);}\nfunction showEnd(won,heading){showPanel('end',\"'`<div class=\"eyebrow\">${won?'\"'ALL FOUR STAGES CLEARED':'THANKS FOR MAKING A MARK'}</div><h2>\"'${heading||(won?'\"'A super clean break.':'Out of bounce.')}</h2><p>\"'${won?'\"'Four walls. Countless angles. One very good paddle.':'The wall won this round. The next angle could be yours.'}</p><div class=\\\"endScore\\\">\"'${String(score).padStart(6,'\"'0')}</div><div class=\\\"statgrid\\\"><div><b>\"'${stats.brickHits}</b><small>Brick hits</small></div><div><b>${stats.paddleHits}</b><small>Returns</small></div><div><b>${stats.bursts}</b><small>Ink bursts</small></div></div><div class=\"actions\"><button class=\"primary\" data-action=\"again\">One more run <span>↗</span></button>${online.isHub?'\"'':'<button class=\\\"secondary\\\" data-action=\\\"title\\\">Back to title</button>'}</div>\"'`);}\nfunction loseBall(force=false){if(netMode==='\"'guest')return;const b=balls.pop();if(b){colliders.delete(b.collider.handle);world.removeRigidBody(b.body);playGroup.remove(b.group);b.trail.forEach(o=>playGroup.remove(o));}if(balls.length&&\"'!force)return;if(force){for(const bb of [...balls]){colliders.delete(bb.collider.handle);world.removeRigidBody(bb.body);playGroup.remove(bb.group);bb.trail.forEach(o=>playGroup.remove(o));}balls=[];}\n stats.lostBalls++;combo=0;burst=0;charge=Math.max(0,charge-15);if(phase==='\"'attract'||cfg.god||cfg.auto){lives=Math.max(3,lives);addBall(paddles[0].x,-9);return}lives--;audio.play('lose');shake=.3;if(lives<=0){finishRun(false);return}addBall(paddles[0].x,-9);toast(lives===1?'LAST BALL. MAKE IT COUNT.':'SHAKE IT OFF. SERVE AGAIN.');}\nfunction hitBrick(b,ball){if(\"'!b.alive)return;b.hp--;stats.brickHits++;combo++;const mult=1+Math.floor(combo/8);score+=25*mult*(b.maxHp>1?2:1);charge=clamp(charge+4*cfg.chargeRate,0,100);audio.play('\"'brick',b.row);burstParticles(b.x,b.y,b.c,b.hp<=0?10:5);shake=Math.max(shake,.035);if(b.hp>0){b.group.scale.set(1.08,.8,1);b.group.children[1].material=mat(C.yellow);return}\n b.alive=false;b.group.removeFromParent();playGroup.add(b.group);animatePop(b.group);if(b.kind==='cavity'){const cap=captive.sort((a,c)=>Math.abs(a.x-b.x)-Math.abs(c.x-b.x)).shift();if(cap){playGroup.remove(cap.g);const v=cfg.speed;addBall(cap.x,cap.y,v*.35,-v*.94);toast('POCKET OPEN · MULTIBALL\"'!'\"');audio.play('powerup');}}\n if(b.kind==='power')dropPower(b.x,b.y,['wide','slow','multi'][dropID++%3]);else if(stats.brickHits%18===0)dropPower(b.x,b.y,['wide','multi','slow'][dropID++%3]);\n}\nfunction dropPower(x,y,type){const cc=type==='wide'?C.blue:type==='multi'?C.coral:C.yellow;const g=box(.65,.65,.23,cc);const symbol=type==='multi'?'×3':type==='wide'?'↔':'~';const s=worldLabel(symbol,0,0,.7,.65);s.position.z=.2;g.add(s);g.position.set(x,y,.5);playGroup.add(g);powerups.push({x,y,type,g});}\nfunction takePower(type){stats.powers++;audio.play('powerup');audio.speak('power');if(type==='wide'){wideTime=16;toast('WIDE LOAD · 16 SECONDS');}if(type==='slow'){slowTime=12;toast('EASY DOES IT · 12 SECONDS');}if(type==='multi'){const source=balls.find(b=>\"'!b.docked)||balls[0];if(source){const p=source.body.translation();for(const sign of [-1,1])if(balls.length<6)addBall(p.x+sign*.3,p.y,sign*cfg.speed*.55,cfg.speed*.84);}toast('\"'THREE’S A CROWD · MULTIBALL\"'!'\"');}}\nfunction applyPaddle(p,dt){const wide=cfg.paddleWidth*(wideTime>0?1.45:1);p.width=wide;p.collider.setShape(new RAPIER.Cuboid(wide/2,.2));let target=p.x;const seat=clamp(p.seat,0,1),auto=cfg.auto||phase==='attract'||(lastInput==='touch'&&settings.assist);if(auto){const targetBall=balls.filter(b=>\"'!b.docked).sort((a,b)=>a.body.translation().y-b.body.translation().y)[0];if(targetBall){const bp=targetBall.body.translation(),bv=targetBall.body.linvel();let tx=bp.x;if(bv.y<0){tx=bp.x+(p.y+.45-bp.y)/bv.y*bv.x;while(tx>8.9||tx<-8.9){if(tx>8.9)tx=17.8-tx;if(tx<-8.9)tx=-17.8-tx;}}target=tx+Math.sin(gameTime*2)*.38;}else target=Math.sin(gameTime)*4;}\n else if(mode==='\"'online'&&((seat===1&&online.mySeat===0)||(online.server))){target=Number(inputSeats[seat]?.x)||0;}\n else {const pad=getPads()[seat];const axis=pad?.axes?.[0]||0;if(Math.abs(axis)>.12){target+=axis*21*dt;lastInput='gamepad';}else if(seat===0){if(keys.has('KeyA')||keys.has('ArrowLeft')&&mode\"'!=='\"'coop')target-=20*dt;if(keys.has('KeyD')||keys.has('ArrowRight')&&mode\"'!=='\"'coop')target+=20*dt;if(pointerActive&&lastInput\"'!=='\"'gamepad')target=pointerX;}else{if(keys.has('ArrowLeft'))target-=20*dt;if(keys.has('ArrowRight'))target+=20*dt;}}\n target=clamp(target,-9+wide/2,9-wide/2);p.x+=clamp(target-p.x,-35*dt,35*dt);p.body.setNextKinematicTranslation({x:p.x,y:p.y});p.group.position.x=p.x;p.group.scale.x=wide/3.1;p.squish=Math.max(0,p.squish-dt);p.group.scale.y=1+Math.sin(p.squish/.16*Math.PI)*.5;\n}\nfunction simulate(dt){if(\"'!['\"'playing','attract','clear'].includes(phase))return;gameTime+=dt;phaseTime+=dt;if(phase==='clear'){if((cfg.auto||phase==='attract')&&phaseTime>2)nextStage();return}elapsed+=dt;metrics.steps++;burst=Math.max(0,burst-dt);wideTime=Math.max(0,wideTime-dt);slowTime=Math.max(0,slowTime-dt);for(const p of paddles)applyPaddle(p,dt);\n if((cfg.auto||phase==='attract')&&phaseTime>1.1){serve();if(charge>=100)activateBurst();if(phase==='attract'&&phaseTime>25){loadStage((stage+1)%4);phase='attract';return}}\n for(const b of balls){if(b.docked){const p=paddles[0];b.body.setTranslation({x:p.x,y:p.y+.65},true);b.body.setLinvel({x:0,y:0},true);}b.prev={...b.body.linvel()};}\n world.step(events);const remove=[];const touched=new Set();events.drainCollisionEvents((a,b,started)=>{if(\"'!started)return;const ca=colliders.get(a),cb=colliders.get(b);if(!ca||!cb)return;const bc=ca.type==='\"'ball'?ca:cb.type==='ball'?cb:null;const other=bc===ca?cb:ca;if(\"'!bc)return;const ball=bc.data;if(ball.docked)return;if(other.type==='\"'brick'&&other.data.alive){const brick=other.data;if(\"'!touched.has(brick.id)){touched.add(brick.id);hitBrick(brick,ball);if(!brick.alive)remove.push(brick);}if(burst>0)ball.body.setLinvel(ball.prev,true);}\n if(other.type==='\"'paddle'){const p=other.data,bp=ball.body.translation();if(ball.prev.y>0&&bp.y<p.y)return;const hit=clamp((bp.x-p.x)/(p.width/2),-1,1);const angle=hit*1.05;const v=cfg.speed*(slowTime>0?.72:1);ball.body.setTranslation({x:bp.x,y:p.y+.43},true);ball.body.setLinvel({x:Math.sin(angle)*v,y:Math.cos(angle)*v},true);stats.paddleHits++;combo=0;audio.play('paddle',hit);bump(p);burstParticles(bp.x,p.y+.3,C.teal,4);}\n if(other.type==='wall'){audio.play('wall');}});\n for(const b of remove){colliders.delete(b.collider.handle);world.removeRigidBody(b.body);}\n for(const b of [...balls]){const p=b.body.translation();if(\"'!b.docked){const v=b.body.linvel(),speed=cfg.speed*(slowTime>0?.72:1);let vx=v.x,vy=v.y;const l=Math.hypot(vx,vy)||1;vx=vx/l*speed;vy=vy/l*speed;if(Math.abs(vy)<speed*.28)vy=Math.sign(vy||1)*speed*.28;if(Math.abs(vx)<speed*.05)vx=Math.sign(vx||1)*speed*.1;const ll=Math.hypot(vx,vy);b.body.setLinvel({x:vx/ll*speed,y:vy/ll*speed},true);b.stuck+=dt;if(Math.abs(p.y-b.lastY)>1){b.lastY=p.y;b.stuck=0;}if(b.stuck>7){b.body.setLinvel({x:speed*.42,y:-speed*.9},true);b.stuck=0;}}\n b.group.position.set(p.x,p.y,.4);b.group.children[1].material=mat(burst>0?C.coral:C.paper);b.history.unshift({x:p.x,y:p.y});if(b.history.length>40)b.history.pop();b.trail.forEach((o,i)=>{const h=b.history[i*3+2];o.visible=!!h&&!b.docked;if(h)o.position.set(h.x,h.y,.1-i*.005)});\n if(p.y<-12.7){const ix=balls.indexOf(b);if(ix!==balls.length-1){balls.splice(ix,1);balls.push(b)}loseBall();}}\n for(let i=powerups.length-1;i>=0;i--){const p=powerups[i];p.y-=3.5*dt;p.g.position.y=p.y;p.g.rotation.z=Math.sin(gameTime*3)*.12;if(paddles.some(q=>Math.abs(p.x-q.x)<q.width/2+.3&&Math.abs(p.y-q.y)<.45)){takePower(p.type);playGroup.remove(p.g);powerups.splice(i,1);}else if(p.y<-12.5){playGroup.remove(p.g);powerups.splice(i,1);}}\n if(stage===3){progressTime+=dt;if(progressTime>=22){progressTime=0;for(const b of bricks)if(b.alive){b.y-=.65;b.body.setTranslation({x:b.x,y:b.y},true);b.group.position.y=b.y;}toast('\"'HERE COMES THE WALL');audio.play('charge');if(bricks.some(b=>b.alive&&b.y<-7.1)){if(cfg.god||cfg.auto||phase==='attract'){for(const b of bricks)if(b.alive){b.y+=4;b.body.setTranslation({x:b.x,y:b.y},true);b.group.position.y=b.y;}}else{finishRun(false,'WALL TOO CLOSE.');return}}}}\n if(\"'!bricks.some(b=>b.alive))stageComplete();\n}\nfunction updateFX(dt){for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.life-=dt;p.o.position.x+=p.vx*dt;p.o.position.y+=p.vy*dt;p.o.position.z+=p.vz*dt;p.vy-=5*dt;p.o.rotation.z+=p.spin*dt;p.o.scale.setScalar(Math.max(0,p.life/p.max));if(p.life<=0){p.o.removeFromParent();particles.splice(i,1)}}for(let i=mixers.length-1;i>=0;i--){const m=mixers[i];m.mix.update(dt);m.time-=dt;if(m.time<=0){if(m.remove)m.object.removeFromParent();m.mix.stopAllAction();mixers.splice(i,1)}}for(const c of captive){c.g.position.y=c.y+Math.sin(gameTime*3+c.x)*.1;c.g.rotation.z=gameTime;}toastTime-=dt;if(toastTime<=0)$('\"'#toast').style.opacity=0;shake=Math.max(0,shake-dt*1.8);}\nfunction updateUI(){if(\"'!renderer)return;$('\"'#score').textContent=String(score).padStart(6,'0');\"'$('\"'#best').textContent=String(Math.max(best,score)).padStart(6,'0');\"'$('\"'#stageLabel').textContent=\"'`0${stage+1} / 04 · ${STAGES[stage].type}`;$('\"'#stageName').textContent=STAGES[stage].name;\"'$('\"'#lives').textContent='● '.repeat(Math.max(0,lives));\"'$('\"'#chargePct').textContent=burst>0?'BURST\"'!'\"':Math.floor(charge)+'%';\"'$('\"'#chargeFill').style.width=(burst>0?burst/5*100:charge)+'%';\"'$('\"'#chargeButton').classList.toggle('ready',charge>=100);\"'$('\"'#comboValue').textContent='×'+(1+Math.floor(combo/8));\"'$('\"'#comboLabel').textContent=combo>=8?'INK CREDIBLE COMBO':wideTime>0?'WIDE PADDLE':slowTime>0?'SLOW MOTION':'MAKE YOUR MARK';const docked=balls.some(b=>b.docked);\"'$('\"'#playPrompt').style.display=(phase==='clear'||docked)&&phase\"'!=='\"'attract'?'block':'none';\"'$('\"'#promptMain').textContent=phase==='clear'?\"'`NEXT: ${STAGES[Math.min(stage+1,3)].name}`:`${prompt('\"'serve')} to serve\"'`;$('\"'#promptSub').textContent=phase==='clear'?\"'`${prompt('\"'serve')} · Keep the good angles coming\"'`:STAGES[stage].tip;$('\"'#devBadge').style.display=devUsed?'block':'none';}\nfunction resize(){if(\"'!renderer)return;const w=innerWidth,h=innerHeight;renderer.setSize(w,h);const aspect=w/h;let vh=28;if(aspect<.8)vh=26/aspect;const vw=vh*aspect;camera.left=-vw/2;camera.right=vw/2;camera.top=vh/2;camera.bottom=-vh/2;camera.updateProjectionMatrix();if(phase==='\"'title'){boardGroup.position.set(aspect<.8?0:vw*.24,aspect<.8?8:0,0);boardGroup.rotation.z=aspect<.8?-.09:-.1;boardGroup.scale.setScalar(aspect<.8?.9:.88);}else{boardGroup.position.set(0,aspect<.8?.7:0,0);boardGroup.rotation.z=0;boardGroup.scale.setScalar(1);}titleGroup.visible=phase==='title';}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {color, float, normalWorld, vec3} from 'three/tsl';\nimport RAPIER from '@dimforge/rapier2d-compat';\nimport {ArcadeAudio} from './audio.js';\nimport {createOnline} from './online.js';\n\nconst \"'$=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), rand=(a,b)=>a+Math.random()*(b-a);\nconst C={ink:0x162d37,paper:0xf4f0e5,teal:0x2a9690,coral:0xf2663e,yellow:0xf8ce68,blue:0x6ba5b7,cream:0xe6ddbd};\nconst palette=[C.teal,C.blue,C.yellow,C.coral];\nconst STAGES=[\n {name:'\"'First impressions',type:'CLASSIC',tag:'Find your angle. Leave your mark.',tip:'Hit the paddle edge for a sharper angle.',rows:6},\n {name:'Pocket universe',type:'CAVITY',tag:'A little company in the cosmos.',tip:'Break open the pockets to free two captive balls.',rows:7},\n {name:'Double trouble',type:'DOUBLE',tag:'Two paddles. Twice the possibilities.',tip:'Your second paddle moves with you. Mind the gap.',rows:7},\n {name:'The big squeeze',type:'PROGRESSIVE',tag:'The wall has places to be.',tip:'The wall steps down every 22 seconds. Keep it moving.',rows:8}\n];\nconst DEFAULTS={speed:11,paddleWidth:3.1,chargeRate:1,god:false,auto:false};\nconst settings=Object.assign({music:.1,sfx:.65,glyphs:'ps',shake:true,assist:false},readStore('bounceout-settings',{}));\nlet best=+readStore('bounceout-best',0)||0;\nfunction readStore(k,f){try{return JSON.parse(localStorage.getItem(k))??f}catch{return f}}\nfunction saveSettings(){try{localStorage.setItem('bounceout-settings',JSON.stringify(settings))}catch{}}\nconst audio=new ArcadeAudio();audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);\nlet renderer,scene,camera,world,events,playGroup,boardGroup,titleGroup,paddles=[],bricks=[],balls=[],powerups=[],particles=[],mixers=[],captive=[];\nconst colliders=new Map();let fixedBodies=[];\nconst cfg={...DEFAULTS};\nlet phase='title',mode='solo',stage=0,score=0,lives=3,combo=0,charge=0,burst=0,wideTime=0,slowTime=0,gameTime=0,phaseTime=0,progressTime=0,elapsed=0;\nlet lastTime=0,accumulator=0,idleAt=performance.now(),lastInput='keyboard',menuName='',returnMenu='title',menuFocus=0,menuRepeat=0,keys=new Set(),padPrevious=[],pointerX=0,pointerActive=false,remoteInput={x:0},devUsed=false;\nlet toastTime=0,shake=0,networkTimer=0,netBuild=-1,lastNetState=null,netMode='solo',ballID=1,dropID=0,hubEnded=false;\nlet stats={brickHits:0,paddleHits:0,lostBalls:0,powers:0,bursts:0};\nlet metrics={frames:0,steps:0,renderErrors:0};\nlet inputSeats=[{x:0,axis:0},{x:0,axis:0}];let fxTexture;\nconst online=createOnline({\n onStatus(text){if(\"'$('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent=text;},\n onRole(role){if(role==='guest')netMode='guest';else if(role==='host')netMode='host';else netMode='solo';},\n onStart(info){if(\"'!renderer)return;startRun('\"'online');toast(online.isHub?'SESSION READY':'PARTNER CONNECTED');},\n onInput(input,seat){remoteInput=input||{};if(online.isHub&&seat===0&&online.mySeat\"'!==0)inputSeats[0]=input||{x:0};else inputSeats[1]=input||{x:0};if(input.serve)serve();if(input.burst)activateBurst();},\n onState(s){lastNetState=s;applyNet(s);},\n onEnd(reason){hubEnded=true;keys.clear();phase='\"'gameover';showEnd(false,'SESSION COMPLETE');audio.setMuted(true);},\n onTimeUp(){finishRun(false,'TIME’S UP');},\n onLeave(){if(phase==='playing'){toast('PARTNER LEFT · SOLO PADDLE');mode='solo';paddles.forEach((p,i)=>{if(i===1)p.group.visible=false;});}}\n});\n\nfunction cel(c){const m=new THREE.MeshBasicNodeMaterial();m.colorNode=color(c).mul(float(.56).add(normalWorld.dot(vec3(-.35,.6,1).normalize()).max(0).mul(3).floor().div(3).mul(.44)));return m;}\nconst mats={};function mat(c){return mats[c]??(mats[c]=cel(c))}\nconst inkMat=new THREE.MeshBasicMaterial({color:C.ink});\nconst outlineMat=new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide});\nfunction box(w,h,d,c,outline=true){const g=new THREE.Group();const geo=new THREE.BoxGeometry(w,h,d);if(outline){const edge=new THREE.Mesh(geo,outlineMat);edge.scale.set(1+.065/Math.max(w,.2),1+.065/Math.max(h,.2),1+.065/Math.max(d,.2));g.add(edge)}const mesh=new THREE.Mesh(geo,mat(c));g.add(mesh);return g;}\nfunction ballMesh(c=C.paper,r=.2){const g=new THREE.Group();const geo=new THREE.IcosahedronGeometry(r,2);const edge=new THREE.Mesh(geo,outlineMat);edge.scale.setScalar(1.2);g.add(edge,new THREE.Mesh(geo,mat(c)));return g;}\nfunction line(points,c=C.ink,opacity=1){const m=new THREE.LineBasicMaterial({color:c,transparent:opacity<1,opacity});return new THREE.Line(new THREE.BufferGeometry().setFromPoints(points.map(p=>new THREE.Vector3(...p))),m)}\nfunction labelTexture(text,fg='#162d37',bg=null,size=64){const canvas=document.createElement('canvas');canvas.width=1024;canvas.height=128;const ctx=canvas.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,1024,128)}ctx.fillStyle=fg;ctx.font=\"'`800 ${size}px \"Barlow Condensed\", \"Arial Narrow\", sans-serif`;ctx.textAlign='\"'center';ctx.textBaseline='middle';ctx.fillText(text,512,68);const t=new THREE.CanvasTexture(canvas);t.colorSpace=THREE.SRGBColorSpace;return t;}\nfunction worldLabel(text,x,y,w=10,h=1,fg='#162d37'){const m=new THREE.MeshBasicMaterial({map:labelTexture(text,fg),transparent:true,depthWrite:false});const o=new THREE.Mesh(new THREE.PlaneGeometry(w,h),m);o.position.set(x,y,.12);return o}\nfunction animatePop(object,remove=true,duration=.3){const mix=new THREE.AnimationMixer(object);const clip=new THREE.AnimationClip('ink-pop',duration,[new THREE.VectorKeyframeTrack('.scale',[0,duration*.3,duration],[1,1,1,1.25,1.25,1.25,0,0,0]),new THREE.NumberKeyframeTrack('.rotation[z]',[0,duration],[0,rand(-.7,.7)])]);mix.clipAction(clip).setLoop(THREE.LoopOnce).play();mixers.push({mix,object,time:duration,remove});}\nfunction burstParticles(x,y,c,count=9){for(let i=0;i<count;i++){const o=box(rand(.05,.15),rand(.1,.27),.08,c,false);o.position.set(x,y,.5);playGroup.add(o);particles.push({o,vx:rand(-3,3),vy:rand(-3,3),vz:rand(0,2),life:rand(.3,.6),max:.6,spin:rand(-8,8)})}}\nfunction toast(t,seconds=2.4){\"'$('\"'#toast').textContent=t;toastTime=seconds;\"'$('\"'#toast').style.opacity=1;}\nfunction bump(p){p.squish=.16;}\nfunction buildScene(){\n scene=new THREE.Scene();scene.background=new THREE.Color(C.paper);camera=new THREE.OrthographicCamera(-18,18,14,-14,.1,150);camera.position.set(0,-3.8,50);camera.lookAt(0,0,0);\n boardGroup=new THREE.Group();scene.add(boardGroup);playGroup=new THREE.Group();boardGroup.add(playGroup);\n const back=box(19.3,25,.35,0xe3e8dc,true);back.position.z=-.8;boardGroup.add(back);\n const inner=new THREE.Mesh(new THREE.PlaneGeometry(18.35,24),new THREE.MeshBasicMaterial({color:0xeef0e3}));inner.position.z=-.58;boardGroup.add(inner);\n // Registration grid, rails and paper-cut shadows.\n for(let x=-9;x<=9;x+=1){boardGroup.add(line([[x,-11.8,-.55],[x,11.8,-.55]],0xc0cdbb,.4))}\n for(let y=-11;y<=11;y+=1){boardGroup.add(line([[-9.1,y,-.55],[9.1,y,-.55]],0xc0cdbb,.4))}\n for(const x of [-9.45,9.45]){const rail=box(.33,24.5,.6,C.ink,false);rail.position.set(x,0,-.2);boardGroup.add(rail);for(let y=-11;y<12;y+=1.2){const dash=box(.07,.45,.03,0x54716f,false);dash.position.set(x,y,.13);boardGroup.add(dash)}}\n const top=box(19.25,.38,.55,C.ink,false);top.position.set(0,12.2,-.1);boardGroup.add(top);\n const drain=line([[-9,-11.6,-.1],[9,-11.6,-.1]],C.coral,.7);boardGroup.add(drain);\n boardGroup.add(worldLabel('THE ANGLE IS EVERYTHING',0,-11.9,8,.7,'#657e72'));\n boardGroup.add(worldLabel('BOUNCE / BREAK / REPEAT',0,11.55,11,.75,'#657e72'));\n for(const x of [-8.8,8.8])for(const y of [-11.9,11.8]){const screw=ballMesh(0x9fae9e,.1);screw.position.set(x,y,-.2);boardGroup.add(screw)}\n titleGroup=new THREE.Group();scene.add(titleGroup);\n // Print-shop orbital doodles behind the cabinet.\n for(let i=0;i<3;i++){const radius=10.5+i*.45;const pts=[];for(let j=0;j<=110;j++){const a=j/110*Math.PI*2;pts.push([Math.cos(a)*radius,Math.sin(a)*radius,0])}const ring=line(pts,0xa9bab0,.5);ring.scale.y=.8;ring.position.set(8,0,-3);titleGroup.add(ring)}\n for(let i=0;i<11;i++){const star=new THREE.Group();star.add(box(.4,.06,.03,C.teal,false),box(.06,.4,.03,C.teal,false));star.position.set(rand(-12,17),rand(-12,12),-2);titleGroup.add(star);}\n resize();\n}\nfunction disposeWorld(){if(world)world.free();world=new RAPIER.World({x:0,y:0});world.timestep=1/120;events?.free();events=new RAPIER.EventQueue(true);colliders.clear();fixedBodies=[];}\nfunction fixedBox(x,y,w,h,type='wall',data=null,sensor=false){const b=world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x,y));const c=world.createCollider(RAPIER.ColliderDesc.cuboid(w/2,h/2).setRestitution(1).setFriction(0).setSensor(sensor).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),b);colliders.set(c.handle,{type,data});fixedBodies.push(b);return {body:b,collider:c};}\nfunction createPaddle(i){const g=new THREE.Group();const c=i===0?C.teal:C.coral;const body=box(3.1,.32,.42,c);g.add(body);const inset=box(2.45,.055,.02,C.paper,false);inset.position.set(0,.055,.23);g.add(inset);for(const x of [-1.2,1.2]){const cap=box(.16,.39,.48,C.ink,false);cap.position.x=x;g.add(cap)}const y=mode==='coop'||mode==='online'?-9.8+i*.58:-9.6;\n g.position.set(0,y,.3);playGroup.add(g);const rb=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0,y));const col=world.createCollider(RAPIER.ColliderDesc.cuboid(1.55,.2).setRestitution(1).setFriction(0).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),rb);const p={group:g,body:rb,collider:col,x:0,y,width:3.1,seat:i,squish:0};colliders.set(col.handle,{type:'paddle',data:p});paddles.push(p);return p;\n}\nfunction addBall(x,y,vx=0,vy=0){const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,y).setLinvel(vx,vy).setCcdEnabled(true).lockRotations().setLinearDamping(0).setCanSleep(false));const collider=world.createCollider(RAPIER.ColliderDesc.ball(.2).setRestitution(1).setRestitutionCombineRule(RAPIER.CoefficientCombineRule.Max).setFriction(0).setDensity(1).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),body);const g=ballMesh(C.paper,.2);g.position.set(x,y,.4);playGroup.add(g);const trail=[];for(let i=0;i<10;i++){const o=ballMesh(i<3?C.yellow:C.teal,.15*(1-i/12));o.visible=false;playGroup.add(o);trail.push(o)}const b={id:ballID++,body,collider,group:g,trail,history:[],docked:\"'!vx&&!vy,prev:{x:vx,y:vy},lastY:y,stuck:0};balls.push(b);colliders.set(collider.handle,{type:'\"'ball',data:b});return b;}\nfunction addBrick(col,row,c,hp=1,kind='normal',offset=0){const w=1.78,h=.64,x=-7.68+col*1.92,y=8.8-row*.87+offset;const group=box(w,h,.48,c);group.position.set(x,y,.02);const shine=box(w-.2,.045,.01,0xffffff,false);shine.position.set(0,.16,.25);group.add(shine);if(hp>1){for(const dx of [-.22,.22]){const mark=box(.11,.11,.02,C.ink,false);mark.position.set(dx,-.07,.26);group.add(mark)}}if(kind==='power'){const mark=box(.18,.23,.025,C.paper,false);mark.rotation.z=Math.PI/4;mark.position.z=.27;group.add(mark)}playGroup.add(group);const b={id:row*9+col,col,row,x,y,w,h,hp,maxHp:hp,c,kind,group,alive:true};Object.assign(b,fixedBox(x,y,w,h,'brick',b));bricks.push(b);return b;}\nfunction layout(n){for(let r=0;r<STAGES[n].rows;r++)for(let c=0;c<9;c++){\n let skip=false,hp=1,kind='normal';const colorIndex=clamp(Math.floor(r/2),0,3);let cc=palette[3-colorIndex];\n if(n===0){skip=(r===0&&(c<2||c>6))||(r===1&&(c===0||c===8));if(r===4&&(c===2||c===6))kind='power';}\n if(n===1){skip=(r>=2&&r<=3&&(c===2||c===6))||(r===0&&(c===0||c===8));if(r===4&&(c===2||c===6)){kind='cavity';cc=C.yellow;}if(r===1&&(c===2||c===6))hp=2;}\n if(n===2){skip=((c+r)%7===0);hp=r<2?2:1;if(r===5&&(c===2||c===6))kind='power';}\n if(n===3){skip=(r===0&&(c%2===0));hp=r<2?2:1;if(r===6&&(c===1||c===7))kind='power';cc=palette[(r+c)%4];}\n if(\"'!skip)addBrick(c,r,cc,hp,kind);\n }\n if(n===1){for(const x of [-3.84,3.84]){const g=ballMesh(C.yellow,.25);g.position.set(x,6.6,.4);playGroup.add(g);captive.push({x,y:6.6,g});}}\n}\nfunction clearVisuals(){while(playGroup.children.length)playGroup.remove(playGroup.children[0]);paddles=[];bricks=[];balls=[];powerups=[];particles=[];mixers=[];captive=[];}\nfunction loadStage(n){stage=n;clearVisuals();disposeWorld();fixedBox(-9.36,0,.3,25);fixedBox(9.36,0,.3,25);fixedBox(0,12.2,19,.4);createPaddle(0);if(mode==='\"'coop'||mode==='online')createPaddle(1);if(n===2){const p=createPaddle(2);p.seat=0;p.y=-7.4;p.body.setTranslation({x:0,y:p.y},true);p.group.position.y=p.y;p.group.children[0].children[1].material=mat(C.blue);}\n layout(n);addBall(0,-9,0,0);combo=0;burst=0;wideTime=0;slowTime=0;progressTime=0;phaseTime=0;audio.setStage(n);netBuild=n;\n}\nfunction startRun(m='solo'){if(hubEnded&&online.isHub)return;mode=m;score=0;lives=3;charge=0;elapsed=0;stats={brickHits:0,paddleHits:0,lostBalls:0,powers:0,bursts:0};phase='playing';loadStage(0);hideOverlay();pointerActive=false;\"'$('\"'#title').style.display='none';\"'$('\"'#hud').style.display='block';\"'$('\"'#attract').style.display='none';\"'$('\"'#menuButton').style.display='block';\"'$('\"'#boardCaption').style.display='none';\"'$('\"'#footer').style.display='flex';\"'$('\"'#footerLeft').textContent=mode==='coop'?'P1: A / D · P2: ← / → · Space: serve · Shift: burst':'MOVE THE PADDLE · FIND YOUR ANGLE · MAKE YOUR MARK';audio.play('stage');audio.speak('ready');toast(\"'`${STAGES[stage].type} / ${STAGES[stage].name}`);updateUI();resize();}\nfunction showTitle(){if(online.isHub)return;phase='\"'title';mode='solo';online.leave();netMode='solo';hubEnded=false;cfg.auto=false;hideOverlay();loadStage(0);\"'$('\"'#title').style.display='flex';\"'$('\"'#hud').style.display='none';\"'$('\"'#attract').style.display='none';\"'$('\"'#menuButton').style.display='none';\"'$('\"'#boardCaption').style.display='block';\"'$('\"'#footer').style.display='flex';idleAt=performance.now();setPrompts();resize();}\nfunction serve(){if(netMode==='guest'){sendAction('serve');return;}if(phase==='clear'){nextStage();return}if(phase\"'!=='\"'playing'&&phase\"'!=='\"'attract')return;let did=false;for(const b of balls)if(b.docked){const x=clamp(paddles[0]?.x/10,-.55,.55);const v=cfg.speed; b.docked=false;b.body.setLinvel({x:(x||.28)*v,y:Math.sqrt(1-(x||.28)**2)*v},true);did=true;}if(did){audio.play('launch');phaseTime=0;}}\nfunction activateBurst(){if(netMode==='guest'){sendAction('burst');return}if(charge<100||\"'!['\"'playing','attract'].includes(phase))return;charge=0;burst=5;stats.bursts++;toast('INK BURST\"'! · PIERCE THE WALL'\"');audio.play('burst');audio.speak('power');shake=.2;serve();}\nfunction nextStage(){if(stage>=3){finishRun(true);return}phase='playing';loadStage(stage+1);audio.play('stage');audio.speak('ready');toast(\"'`${STAGES[stage].type} / ${STAGES[stage].name}`,3);}\nfunction stageComplete(){if(!['\"'playing','attract'].includes(phase))return;score+=500+(lives*100);if(phase==='attract'){loadStage((stage+1)%4);phase='attract';return}phase='clear';phaseTime=0;audio.play('win');toast('A CLEAN BREAK. +'+(500+lives*100),3);if(stage===3){finishRun(true);return}updateUI();}\nfunction finishRun(won,heading){phase=won?'victory':'gameover';if(score>best){best=score;try{localStorage.setItem('bounceout-best',best)}catch{}}if(online.active&&netMode==='host')online.finish(score,won);audio.play(won?'win':'lose');if(won)audio.speak('win');showEnd(won,heading);}\nfunction showEnd(won,heading){showPanel('end',\"'`<div class=\"eyebrow\">${won?'\"'ALL FOUR STAGES CLEARED':'THANKS FOR MAKING A MARK'}</div><h2>\"'${heading||(won?'\"'A super clean break.':'Out of bounce.')}</h2><p>\"'${won?'\"'Four walls. Countless angles. One very good paddle.':'The wall won this round. The next angle could be yours.'}</p><div class=\\\"endScore\\\">\"'${String(score).padStart(6,'\"'0')}</div><div class=\\\"statgrid\\\"><div><b>\"'${stats.brickHits}</b><small>Brick hits</small></div><div><b>${stats.paddleHits}</b><small>Returns</small></div><div><b>${stats.bursts}</b><small>Ink bursts</small></div></div><div class=\"actions\"><button class=\"primary\" data-action=\"again\">One more run <span>↗</span></button>${online.isHub?'\"'':'<button class=\\\"secondary\\\" data-action=\\\"title\\\">Back to title</button>'}</div>\"'`);}\nfunction loseBall(force=false){if(netMode==='\"'guest')return;const b=balls.pop();if(b){colliders.delete(b.collider.handle);world.removeRigidBody(b.body);playGroup.remove(b.group);b.trail.forEach(o=>playGroup.remove(o));}if(balls.length&&\"'!force)return;if(force){for(const bb of [...balls]){colliders.delete(bb.collider.handle);world.removeRigidBody(bb.body);playGroup.remove(bb.group);bb.trail.forEach(o=>playGroup.remove(o));}balls=[];}\n stats.lostBalls++;combo=0;burst=0;charge=Math.max(0,charge-15);if(phase==='\"'attract'||cfg.god||cfg.auto){lives=Math.max(3,lives);addBall(paddles[0].x,-9);return}lives--;audio.play('lose');shake=.3;if(lives<=0){finishRun(false);return}addBall(paddles[0].x,-9);toast(lives===1?'LAST BALL. MAKE IT COUNT.':'SHAKE IT OFF. SERVE AGAIN.');}\nfunction hitBrick(b,ball){if(\"'!b.alive)return;b.hp--;stats.brickHits++;combo++;const mult=1+Math.floor(combo/8);score+=25*mult*(b.maxHp>1?2:1);charge=clamp(charge+4*cfg.chargeRate,0,100);audio.play('\"'brick',b.row);burstParticles(b.x,b.y,b.c,b.hp<=0?10:5);shake=Math.max(shake,.035);if(b.hp>0){b.group.scale.set(1.08,.8,1);b.group.children[1].material=mat(C.yellow);return}\n b.alive=false;b.group.removeFromParent();playGroup.add(b.group);animatePop(b.group);if(b.kind==='cavity'){const cap=captive.sort((a,c)=>Math.abs(a.x-b.x)-Math.abs(c.x-b.x)).shift();if(cap){playGroup.remove(cap.g);const v=cfg.speed;addBall(cap.x,cap.y,v*.35,-v*.94);toast('POCKET OPEN · MULTIBALL\"'!'\"');audio.play('powerup');}}\n if(b.kind==='power')dropPower(b.x,b.y,['wide','slow','multi'][dropID++%3]);else if(stats.brickHits%18===0)dropPower(b.x,b.y,['wide','multi','slow'][dropID++%3]);\n}\nfunction dropPower(x,y,type){const cc=type==='wide'?C.blue:type==='multi'?C.coral:C.yellow;const g=box(.65,.65,.23,cc);const symbol=type==='multi'?'×3':type==='wide'?'↔':'~';const s=worldLabel(symbol,0,0,.7,.65);s.position.z=.2;g.add(s);g.position.set(x,y,.5);playGroup.add(g);powerups.push({x,y,type,g});}\nfunction takePower(type){stats.powers++;audio.play('powerup');audio.speak('power');if(type==='wide'){wideTime=16;toast('WIDE LOAD · 16 SECONDS');}if(type==='slow'){slowTime=12;toast('EASY DOES IT · 12 SECONDS');}if(type==='multi'){const source=balls.find(b=>\"'!b.docked)||balls[0];if(source){const p=source.body.translation();for(const sign of [-1,1])if(balls.length<6)addBall(p.x+sign*.3,p.y,sign*cfg.speed*.55,cfg.speed*.84);}toast('\"'THREE’S A CROWD · MULTIBALL\"'!'\"');}}\nfunction applyPaddle(p,dt){const wide=cfg.paddleWidth*(wideTime>0?1.45:1);p.width=wide;p.collider.setShape(new RAPIER.Cuboid(wide/2,.2));let target=p.x;const seat=clamp(p.seat,0,1),auto=cfg.auto||phase==='attract'||(lastInput==='touch'&&settings.assist);if(auto){const targetBall=balls.filter(b=>\"'!b.docked).sort((a,b)=>a.body.translation().y-b.body.translation().y)[0];if(targetBall){const bp=targetBall.body.translation(),bv=targetBall.body.linvel();let tx=bp.x;if(bv.y<0){tx=bp.x+(p.y+.45-bp.y)/bv.y*bv.x;while(tx>8.9||tx<-8.9){if(tx>8.9)tx=17.8-tx;if(tx<-8.9)tx=-17.8-tx;}}target=tx+Math.sin(gameTime*2)*.38;}else target=Math.sin(gameTime)*4;}\n else if(mode==='\"'online'&&((seat===1&&online.mySeat===0)||(online.server))){target=Number(inputSeats[seat]?.x)||0;}\n else {const pad=getPads()[seat];const axis=pad?.axes?.[0]||0;if(Math.abs(axis)>.12){target+=axis*21*dt;lastInput='gamepad';}else if(seat===0){if(keys.has('KeyA')||keys.has('ArrowLeft')&&mode\"'!=='\"'coop')target-=20*dt;if(keys.has('KeyD')||keys.has('ArrowRight')&&mode\"'!=='\"'coop')target+=20*dt;if(pointerActive&&lastInput\"'!=='\"'gamepad')target=pointerX;}else{if(keys.has('ArrowLeft'))target-=20*dt;if(keys.has('ArrowRight'))target+=20*dt;}}\n target=clamp(target,-9+wide/2,9-wide/2);p.x+=clamp(target-p.x,-35*dt,35*dt);p.body.setNextKinematicTranslation({x:p.x,y:p.y});p.group.position.x=p.x;p.group.scale.x=wide/3.1;p.squish=Math.max(0,p.squish-dt);p.group.scale.y=1+Math.sin(p.squish/.16*Math.PI)*.5;\n}\nfunction simulate(dt){if(\"'!['\"'playing','attract','clear'].includes(phase))return;gameTime+=dt;phaseTime+=dt;if(phase==='clear'){if((cfg.auto||phase==='attract')&&phaseTime>2)nextStage();return}elapsed+=dt;metrics.steps++;burst=Math.max(0,burst-dt);wideTime=Math.max(0,wideTime-dt);slowTime=Math.max(0,slowTime-dt);for(const p of paddles)applyPaddle(p,dt);\n if((cfg.auto||phase==='attract')&&phaseTime>1.1){serve();if(charge>=100)activateBurst();if(phase==='attract'&&phaseTime>25){loadStage((stage+1)%4);phase='attract';return}}\n for(const b of balls){if(b.docked){const p=paddles[0];b.body.setTranslation({x:p.x,y:p.y+.65},true);b.body.setLinvel({x:0,y:0},true);}b.prev={...b.body.linvel()};}\n world.step(events);const remove=[];const touched=new Set();events.drainCollisionEvents((a,b,started)=>{if(\"'!started)return;const ca=colliders.get(a),cb=colliders.get(b);if(!ca||!cb)return;const bc=ca.type==='\"'ball'?ca:cb.type==='ball'?cb:null;const other=bc===ca?cb:ca;if(\"'!bc)return;const ball=bc.data;if(ball.docked)return;if(other.type==='\"'brick'&&other.data.alive){const brick=other.data;if(\"'!touched.has(brick.id)){touched.add(brick.id);hitBrick(brick,ball);if(!brick.alive)remove.push(brick);}if(burst>0)ball.body.setLinvel(ball.prev,true);}\n if(other.type==='\"'paddle'){const p=other.data,bp=ball.body.translation();if(ball.prev.y>0&&bp.y<p.y)return;const hit=clamp((bp.x-p.x)/(p.width/2),-1,1);const angle=hit*1.05;const v=cfg.speed*(slowTime>0?.72:1);ball.body.setTranslation({x:bp.x,y:p.y+.43},true);ball.body.setLinvel({x:Math.sin(angle)*v,y:Math.cos(angle)*v},true);stats.paddleHits++;combo=0;audio.play('paddle',hit);bump(p);burstParticles(bp.x,p.y+.3,C.teal,4);}\n if(other.type==='wall'){audio.play('wall');}});\n for(const b of remove){colliders.delete(b.collider.handle);world.removeRigidBody(b.body);}\n for(const b of [...balls]){const p=b.body.translation();if(\"'!b.docked){const v=b.body.linvel(),speed=cfg.speed*(slowTime>0?.72:1);let vx=v.x,vy=v.y;const l=Math.hypot(vx,vy)||1;vx=vx/l*speed;vy=vy/l*speed;if(Math.abs(vy)<speed*.28)vy=Math.sign(vy||1)*speed*.28;if(Math.abs(vx)<speed*.05)vx=Math.sign(vx||1)*speed*.1;const ll=Math.hypot(vx,vy);b.body.setLinvel({x:vx/ll*speed,y:vy/ll*speed},true);b.stuck+=dt;if(Math.abs(p.y-b.lastY)>1){b.lastY=p.y;b.stuck=0;}if(b.stuck>7){b.body.setLinvel({x:speed*.42,y:-speed*.9},true);b.stuck=0;}}\n b.group.position.set(p.x,p.y,.4);b.group.children[1].material=mat(burst>0?C.coral:C.paper);b.history.unshift({x:p.x,y:p.y});if(b.history.length>40)b.history.pop();b.trail.forEach((o,i)=>{const h=b.history[i*3+2];o.visible=!!h&&!b.docked;if(h)o.position.set(h.x,h.y,.1-i*.005)});\n if(p.y<-12.7){const ix=balls.indexOf(b);if(ix!==balls.length-1){balls.splice(ix,1);balls.push(b)}loseBall();}}\n for(let i=powerups.length-1;i>=0;i--){const p=powerups[i];p.y-=3.5*dt;p.g.position.y=p.y;p.g.rotation.z=Math.sin(gameTime*3)*.12;if(paddles.some(q=>Math.abs(p.x-q.x)<q.width/2+.3&&Math.abs(p.y-q.y)<.45)){takePower(p.type);playGroup.remove(p.g);powerups.splice(i,1);}else if(p.y<-12.5){playGroup.remove(p.g);powerups.splice(i,1);}}\n if(stage===3){progressTime+=dt;if(progressTime>=22){progressTime=0;for(const b of bricks)if(b.alive){b.y-=.65;b.body.setTranslation({x:b.x,y:b.y},true);b.group.position.y=b.y;}toast('\"'HERE COMES THE WALL');audio.play('charge');if(bricks.some(b=>b.alive&&b.y<-7.1)){if(cfg.god||cfg.auto||phase==='attract'){for(const b of bricks)if(b.alive){b.y+=4;b.body.setTranslation({x:b.x,y:b.y},true);b.group.position.y=b.y;}}else{finishRun(false,'WALL TOO CLOSE.');return}}}}\n if(\"'!bricks.some(b=>b.alive))stageComplete();\n}\nfunction updateFX(dt){for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.life-=dt;p.o.position.x+=p.vx*dt;p.o.position.y+=p.vy*dt;p.o.position.z+=p.vz*dt;p.vy-=5*dt;p.o.rotation.z+=p.spin*dt;p.o.scale.setScalar(Math.max(0,p.life/p.max));if(p.life<=0){p.o.removeFromParent();particles.splice(i,1)}}for(let i=mixers.length-1;i>=0;i--){const m=mixers[i];m.mix.update(dt);m.time-=dt;if(m.time<=0){if(m.remove)m.object.removeFromParent();m.mix.stopAllAction();mixers.splice(i,1)}}for(const c of captive){c.g.position.y=c.y+Math.sin(gameTime*3+c.x)*.1;c.g.rotation.z=gameTime;}toastTime-=dt;if(toastTime<=0)$('\"'#toast').style.opacity=0;shake=Math.max(0,shake-dt*1.8);}\nfunction updateUI(){if(\"'!renderer)return;$('\"'#score').textContent=String(score).padStart(6,'0');\"'$('\"'#best').textContent=String(Math.max(best,score)).padStart(6,'0');\"'$('\"'#stageLabel').textContent=\"'`0${stage+1} / 04 · ${STAGES[stage].type}`;$('\"'#stageName').textContent=STAGES[stage].name;\"'$('\"'#lives').textContent='● '.repeat(Math.max(0,lives));\"'$('\"'#chargePct').textContent=burst>0?'BURST\"'!'\"':Math.floor(charge)+'%';\"'$('\"'#chargeFill').style.width=(burst>0?burst/5*100:charge)+'%';\"'$('\"'#chargeButton').classList.toggle('ready',charge>=100);\"'$('\"'#comboValue').textContent='×'+(1+Math.floor(combo/8));\"'$('\"'#comboLabel').textContent=combo>=8?'INK CREDIBLE COMBO':wideTime>0?'WIDE PADDLE':slowTime>0?'SLOW MOTION':'MAKE YOUR MARK';const docked=balls.some(b=>b.docked);\"'$('\"'#playPrompt').style.display=(phase==='clear'||docked)&&phase\"'!=='\"'attract'?'block':'none';\"'$('\"'#promptMain').textContent=phase==='clear'?\"'`NEXT: ${STAGES[Math.min(stage+1,3)].name}`:`${prompt('\"'serve')} to serve\"'`;$('\"'#promptSub').textContent=phase==='clear'?\"'`${prompt('\"'serve')} · Keep the good angles coming\"'`:STAGES[stage].tip;$('\"'#devBadge').style.display=devUsed?'block':'none';}\nfunction resize(){if(\"'!renderer)return;const w=innerWidth,h=innerHeight;renderer.setSize(w,h);const aspect=w/h;let vh=28;if(aspect<.8)vh=26/aspect;const vw=vh*aspect;camera.left=-vw/2;camera.right=vw/2;camera.top=vh/2;camera.bottom=-vh/2;camera.updateProjectionMatrix();if(phase==='\"'title'){boardGroup.position.set(aspect<.8?0:vw*.24,aspect<.8?8:0,0);boardGroup.rotation.z=aspect<.8?-.09:-.1;boardGroup.scale.setScalar(aspect<.8?.9:.88);}else{boardGroup.position.set(0,aspect<.8?.7:0,0);boardGroup.rotation.z=0;boardGroup.scale.setScalar(1);}titleGroup.visible=phase==='title';}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat >> main.js <<'EOF'\n\nfunction prompt(action){const gp=lastInput==='gamepad',x=settings.glyphs==='xbox';return action==='serve'?(gp?(x?'A':'✕'):lastInput==='touch'?'Tap':'Space'):action==='burst'?(gp?(x?'Y':'△'):lastInput==='touch'?'Tap burst':'Shift'):gp?'Options':'Esc';}\nfunction setPrompts(){\"'$$('\"'[data-prompt]').forEach(e=>e.textContent=prompt(e.dataset.prompt));if(phase==='title')\"'$('\"'#footerLeft').textContent=lastInput==='gamepad'?\"'`${settings.glyphs==='\"'xbox'?'A':'✕'} Select · \"'${settings.glyphs==='\"'xbox'?'B':'○'} Back · Left stick / D-pad Move\"'`:'\"'Move: mouse / ← → · Serve: Space · Burst: Shift';updateUI();}\nfunction focusButtons(){return \"'$$(menuName?'\"'#panel button:not(:disabled),#panel input,#panel select':'#title button:not(:disabled)');}\nfunction focusMenu(i){const list=focusButtons();if(\"'!list.length)return;menuFocus=(i+list.length)%list.length;$$('\"'.focused').forEach(e=>e.classList.remove('focused'));list[menuFocus].classList.add('focused');list[menuFocus].focus({preventScroll:true});list[menuFocus].scrollIntoView({block:'nearest'});}\nfunction showPanel(name,html){menuName=name;\"'$('\"'#panel').innerHTML=html;\"'$('\"'#overlay').style.display='flex';menuFocus=0;\"'$$('\"'.focused').forEach(e=>e.classList.remove('focused'));if(lastInput==='gamepad'||lastInput==='keyboard')focusMenu(0);}\nfunction hideOverlay(){menuName='';\"'$('\"'#overlay').style.display='none';\"'$('\"'#panel').innerHTML='';}\nfunction backButton(action='back'){return \"'`<button class=\"back\" data-action=\"${action}\">${lastInput==='\"'gamepad'?(settings.glyphs==='xbox'?'B':'○'):'Esc'} Back</button>\"'`;}\nfunction pause(){if(phase!=='\"'playing'&&phase\"'!=='\"'clear')return;returnMenu=phase;phase='paused';showPause();}\nfunction showPause(){showPanel('pause',\"'`<div class=\"eyebrow\">TAKE A BREATHER</div><h2>Hold that thought.</h2><p>Even a good bounce needs a little space.</p><div class=\"actions\"><button class=\"primary\" data-action=\"resume\">Keep bouncing <span data-prompt=\"serve\">${prompt('\"'serve')}</span></button><button class=\\\"secondary\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"secondary\\\" data-action=\\\"dev\\\">Developer tools</button><button class=\\\"secondary\\\" data-action=\\\"how\\\">How to play</button><button class=\\\"secondary\\\" data-action=\\\"about\\\">About & credits</button>\"'${online.isHub?'\"'':'<button class=\\\"secondary\\\" data-action=\\\"title\\\">Back to title</button>'}</div>\"'`);}\nfunction resume(){if(phase!=='\"'paused')return;phase=returnMenu==='clear'?'clear':'playing';hideOverlay();}\nfunction back(){audio.play('cancel');if(menuName==='pause')resume();else if(phase==='paused')showPause();else if(menuName==='online'&&online.active&&\"'!online.connected){online.leave();netMode='\"'solo';hideOverlay();}else if(menuName)hideOverlay();else if(phase==='playing'||phase==='clear')pause();}\nfunction showSettings(){showPanel('settings',\"'`${backButton()}<div class=\"eyebrow\">MAKE YOURSELF AT HOME</div><h2>Your kind of bounce.</h2><div class=\"setting\"><label for=\"musicVol\">Music<small>A little groove goes a long way.</small></label><div class=\"sliderpack\"><input id=\"musicVol\" type=\"range\" min=\"0\" max=\"100\" value=\"${Math.round(settings.music*100)}\" data-setting=\"music\" aria-label=\"Music volume\"><output>${Math.round(settings.music*100)}%</output></div></div><div class=\"setting\"><label for=\"sfxVol\">Effects & voices</label><div class=\"sliderpack\"><input id=\"sfxVol\" type=\"range\" min=\"0\" max=\"100\" value=\"${Math.round(settings.sfx*100)}\" data-setting=\"sfx\" aria-label=\"Effects volume\"><output>${Math.round(settings.sfx*100)}%</output></div></div><div class=\"setting\"><label for=\"glyphs\">Controller symbols</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · ✕ ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div><div class=\\\"setting\\\"><label for=\\\"shake\\\">Screen shake<small>Keep the ink from rattling.</small></label><input type=\\\"checkbox\\\" id=\\\"shake\\\" data-setting=\\\"shake\\\" \"'${settings.shake?'\"'checked':''}></div><div class=\\\"setting\\\"><label for=\\\"assist\\\">Touch auto-paddle<small>Follow the ball on touch devices.</small></label><input type=\\\"checkbox\\\" id=\\\"assist\\\" data-setting=\\\"assist\\\" \"'${settings.assist?'\"'checked':''}></div><p class=\\\"tiny\\\">Settings are saved on this device. Touch: drag anywhere to move, tap to serve. A second finger unleashes a full burst.</p>\"'`);}\nfunction howTo(){showPanel('\"'how',\"'`${backButton()}<div class=\"eyebrow\">THE ART OF A GOOD RETURN</div><h2>Small paddle. Big ideas.</h2><div class=\"hintrow\"><span class=\"key\">${lastInput==='\"'gamepad'?'L / D-pad':'← → / A D'}</span><p>Move. The middle sends a straight shot. The edges cut a sharper angle.</p></div><div class=\\\"hintrow\\\"><span class=\\\"key\\\">\"'${prompt('\"'serve')}</span><p>Serve a ball, or begin the next stage. Mouse click and touch tap also serve.</p></div><div class=\\\"hintrow\\\"><span class=\\\"key\\\">\"'${prompt('\"'burst')}</span><p>At 100% charge, unleash 5 seconds of piercing ink. Break through whole rows.</p></div><div class=\\\"hintrow\\\"><span class=\\\"key\\\">\"'${prompt('\"'pause')}</span><p>Pause, change settings, or open the developer tools.</p></div><div class=\\\"tiles\\\" style=\\\"margin-top:20px\\\"><div class=\\\"tile\\\"><b>Catch the good stuff</b>↔ Wide paddle · ×3 Multiball · ~ Slow ball.<br>Three spare balls. Clear four stages to win.</div><div class=\\\"tile\\\"><b>Better together</b>Couch: P1 A/D, P2 arrows, or two pads.<br>Online: host a room and share its code. Both paddles share score and lives.</div></div><p class=\\\"tiny\\\">Gold pockets hold extra balls. Double adds an upper paddle. Progressive steps the wall toward you. Lose a life only when every active ball is gone.</p>\"'`);}\nfunction slider(name,label,min,max,step=1,help='\"''){return \"'`<div class=\"setting\"><label for=\"dev-${name}\">${label}${help?`<small>${help}</small>`:'\"''}</label><div class=\\\"sliderpack\\\"><input id=\\\"dev-\"'${name}\" data-dev=\"${name}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${cfg[name]}\"><output>${cfg[name]}</output></div></div>`;}\nfunction showDev(){devUsed=true;showPanel('\"'dev',\"'`${backButton('\"'pausemenu')}<div class=\\\"eyebrow\\\">THE PRINT SHOP / LIVE TUNING</div><h2>Make a little trouble.</h2>\"'${slider('\"'speed','Ball speed',8,20,.5)}\"'${slider('\"'paddleWidth','Paddle width',1.8,4.8,.1)}\"'${slider('\"'chargeRate','Charge gain',.5,3,.25)}<div class=\\\"setting\\\"><label for=\\\"dev-god\\\">Infinite spare balls</label><input id=\\\"dev-god\\\" type=\\\"checkbox\\\" data-dev=\\\"god\\\" \"'${cfg.god?'\"'checked':''}></div><div class=\\\"setting\\\"><label for=\\\"dev-auto\\\">AI paddle<small>Plays and advances stages automatically.</small></label><input id=\\\"dev-auto\\\" type=\\\"checkbox\\\" data-dev=\\\"auto\\\" \"'${cfg.auto?'\"'checked':''}></div><div class=\\\"tiles\\\"><button class=\\\"secondary\\\" data-action=\\\"devcharge\\\">Fill burst</button><button class=\\\"secondary\\\" data-action=\\\"devmulti\\\">Multiball</button><button class=\\\"secondary\\\" data-action=\\\"devnext\\\">Next stage</button><button class=\\\"secondary\\\" data-action=\\\"devreset\\\">Reset defaults</button></div><p class=\\\"tiny\\\">Tuning applies on resume. Developer tools mark this run. Settings reset at page reload. Network hosts control the simulation.</p>\"'`);}\nconst aboutTabs=[['\"'origin','Origin'],['craft','Craft'],['testing','Testing'],['engine','Engine'],['prompt','Prompt']];let aboutTab='origin';\nimport credits from './credits.json';\nfunction showAbout(tab='origin'){aboutTab=tab;const s=credits.sourceInformation;let content='';if(tab==='origin'||tab==='craft'){const fields=tab==='origin'?['date','source','plan','genre','perspective','research','environment','model','usage']:['tech','artDirection','animation','audio','online','testing'];content=\"'`<p>${tab==='\"'origin'?'A playful, independent tribute to the paddle-and-wall rhythm of Super Breakout (1981). All art is built from geometry and ink.':'Built for the big screen, from a small sheet of paper.'}</p><dl class=\\\"metadata\\\">\"'${fields.map(k=>`<dt>${k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,x=>x.toUpperCase())}</dt><dd>${s[k]}</dd>`).join('\"'')}</dl>\"'`;}else{const questions=tab==='\"'testing'?['Issues caught','Critical issues','Most helpful test','Least helpful test']:tab==='engine'?['Best part','Wrong guesses','Built by hand','Hardest part','Engine changes','One wish']:['Best part','Confusing','Hardest part','One change'];const answers=credits[tab==='testing'?'testingFeedback':tab==='engine'?'engineFeedback':'promptFeedback'];content=\"'`<div class=\"feedback\">${answers.map((a,i)=>`<h3>${questions[i]}</h3><p>${a}</p>`).join('\"'')}</div>\"'`;}\n showPanel('\"'about',\"'`${backButton()}<div class=\"eyebrow\">SOURCE INFORMATION & FIELD NOTES</div><h2>Behind the bounce.</h2><div class=\"minorlinks\" style=\"margin:0 0 20px\">${aboutTabs.map(([key,label])=>`<button class=\"textbutton\" data-about=\"${key}\" style=\"${tab===key?'\"'color:var(--orange);border-bottom-color:var(--orange)':''}\\\">\"'${label}</button>`).join('\"'')}</div>\"'${content}`);}\nfunction showOnline(){showPanel('\"'online',\"'`${backButton()}<div class=\"eyebrow\">ONE WALL. TWO PADDLES.</div><h2>Make a connection.</h2><p>Host a room, then share its six-letter code with a friend. Your score, spare balls and glorious mistakes are shared.</p><div class=\"actions\"><button class=\"primary\" data-action=\"host\">Host a room <span>↗</span></button></div><div class=\"setting\"><label for=\"joinCode\">Or join a friend</label><input id=\"joinCode\" type=\"text\" maxlength=\"6\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"ROOM CODE\" aria-label=\"Room code\" style=\"text-transform:uppercase;letter-spacing:3px;width:180px\"></div><div class=\"actions\"><button class=\"secondary\" data-action=\"join\">Join room</button></div><div id=\"roomDisplay\"></div><p id=\"networkStatus\" class=\"networkstatus\">Cross-device play uses a WebRTC peer connection. Keep the host’s game open.</p><p class=\"tiny\">Same-device tabs also work. The room starts when your partner connects.</p>`);}\nasync function hostRoom(){if($('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent='Opening the ink line…';try{const code=await online.host();if(\"'$('\"'#roomDisplay'))\"'$('\"'#roomDisplay').innerHTML=\"'`<div class=\"roomcode\">${code}</div><button class=\"textbutton\" data-action=\"copycode\">Copy room code</button>`;}catch(e){if($('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent=e.message;}}\nasync function joinRoom(){const code=\"'$('\"'#joinCode')?.value?.trim();if(\"'!code)return;if($('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent='Finding your partner…';try{await online.join(code);}catch(e){if(\"'$('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent=e.message;}}\nfunction setSetting(key,value){settings[key]=value;if(key==='music')audio.setMusicVolume(value);if(key==='sfx')audio.setSfxVolume(value);saveSettings();setPrompts();}\nfunction handleAction(a){audio.unlock();audio.play('menu');switch(a){case'start':startRun();break;case'coop':startRun('coop');break;case'online':showOnline();break;case'host':hostRoom();break;case'join':joinRoom();break;case'copycode':navigator.clipboard?.writeText(online.roomCode).then(()=>toast('ROOM CODE COPIED')).catch(()=>toast(online.roomCode));break;case'settings':showSettings();break;case'how':howTo();break;case'about':showAbout();break;case'back':back();break;case'pausemenu':showPause();break;case'resume':resume();break;case'dev':showDev();break;case'title':showTitle();break;case'again':if(online.active){startRun('online')}else startRun(mode==='coop'?'coop':'solo');break;case'devcharge':charge=100;toast('BURST FILLED');break;case'devmulti':takePower('multi');break;case'devnext':if(stage<3)loadStage(stage+1);else{hideOverlay();finishRun(true)}break;case'devreset':Object.assign(cfg,DEFAULTS);showDev();toast('DEFAULTS RESTORED');break;}}\nfunction userActivity(kind){idleAt=performance.now();if(kind&&kind\"'!==lastInput){lastInput=kind;setPrompts();}if(phase==='\"'attract'){showTitle();return true}return false;}\nfunction sendAction(action){const p=paddles.find(p=>p.seat===1)||paddles[0];online.sendInput({x:p?.x||0,[action]:true});}\nfunction pointerWorld(event){const v=new THREE.Vector3(event.clientX/innerWidth*2-1,-event.clientY/innerHeight*2+1,0);v.unproject(camera);v.sub(boardGroup.position);return v.x;}\nfunction getPads(){try{return [...navigator.getGamepads()].filter(Boolean)}catch{return[]}}\nfunction pollPads(dt){const pads=getPads();let active=false;for(let index=0;index<pads.length;index++){const p=pads[index],prev=padPrevious[index]||[];const pressed=i=>\"'!!p.buttons?.[i]?.pressed;const down=i=>pressed(i)&&!prev[i];const ax=p.axes?.[0]||0,ay=p.axes?.[1]||0;if(Math.abs(ax)>.18||Math.abs(ay)>.18||p.buttons.some(b=>b.pressed)){active=true;if(userActivity('\"'gamepad')){padPrevious[index]=p.buttons.map(b=>b.pressed);continue;}}\n if(index===0){if(down(9)&&\"'!pressed(8)){if(menuName)back();else pause();}if(menuName||phase==='\"'title'){menuRepeat-=dt;const up=pressed(12)||ay<-.5,downDir=pressed(13)||ay>.5;if((up||downDir)&&menuRepeat<=0){focusMenu(menuFocus+(up?-1:1));audio.play('menu');menuRepeat=.2;}if(\"'!up&&!downDir)menuRepeat=0;const focused=focusButtons()[menuFocus];if(focused?.matches('\"'input[type=range]')&&(pressed(14)||pressed(15)||Math.abs(ax)>.5)&&menuRepeat<=0){const sign=pressed(14)||ax<-.5?-1:1;focused.value=clamp(+focused.value+sign*Number(focused.step||1),+focused.min,+focused.max);focused.dispatchEvent(new Event('input',{bubbles:true}));menuRepeat=.15;}if(focused?.tagName==='SELECT'&&(down(14)||down(15))){focused.selectedIndex=1-focused.selectedIndex;focused.dispatchEvent(new Event('change',{bubbles:true}));}if(down(0)){if(focused?.matches('input[type=checkbox]')){focused.checked=\"'!focused.checked;focused.dispatchEvent(new Event('\"'change',{bubbles:true}));}else focused?.click();}if(down(1))back();}else{if(down(0))serve();if(down(3))activateBurst();}}\n else if(\"'!menuName){if(down(0))serve();if(down(3))activateBurst();}\n padPrevious[index]=p.buttons.map(b=>b.pressed);}\n if(active)setPrompts();}\nfunction setupInput(){document.addEventListener('\"'click',e=>{const about=e.target.closest('[data-about]');if(about){showAbout(about.dataset.about);return}const b=e.target.closest('[data-action]');if(b)handleAction(b.dataset.action);});document.addEventListener('pointerover',e=>{const b=e.target.closest('button,input,select');if(b){const i=focusButtons().indexOf(b);if(i>=0){menuFocus=i;\"'$$('\"'.focused').forEach(x=>x.classList.remove('focused'));b.classList.add('focused');}}});\n for(const type of ['input','change'])document.addEventListener(type,e=>{const el=e.target;if(el.dataset.setting){const key=el.dataset.setting;let value=el.type==='checkbox'?el.checked:el.type==='range'?+el.value/100:el.value;setSetting(key,value);if(el.nextElementSibling?.tagName==='OUTPUT')el.nextElementSibling.textContent=Math.round(value*100)+'%';}if(el.dataset.dev){const key=el.dataset.dev;cfg[key]=el.type==='checkbox'?el.checked:+el.value;if(el.nextElementSibling?.tagName==='OUTPUT')el.nextElementSibling.textContent=cfg[key];}});\n document.addEventListener('keydown',e=>{if(e.target.matches('input[type=text]')){if(e.code==='Enter')joinRoom();if(e.code\"'!=='\"'Escape')return;}if(userActivity('keyboard'))return;audio.unlock();keys.add(e.code);if(['Space','ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Tab'].includes(e.code))e.preventDefault();if(e.repeat)return;if(e.code==='Escape'||e.code==='KeyP'){if(menuName)back();else pause();return;}if(menuName||phase==='title'){if(e.code==='ArrowDown'||e.code==='Tab')focusMenu(menuFocus+1);else if(e.code==='ArrowUp')focusMenu(menuFocus-1);else if(e.code==='Enter'||e.code==='Space'){const f=focusButtons()[menuFocus];if(f?.type==='checkbox'){f.checked=\"'!f.checked;f.dispatchEvent(new Event('\"'change',{bubbles:true}));}else f?.click();}else if((e.code==='ArrowLeft'||e.code==='ArrowRight')&&document.activeElement?.type==='range'){const el=document.activeElement;el.value=+el.value+(e.code==='ArrowLeft'?-1:1)*Number(el.step||1);el.dispatchEvent(new Event('input',{bubbles:true}));}return;}if(e.code==='Space'||e.code==='Enter')serve();if(e.code==='ShiftLeft'||e.code==='ShiftRight')activateBurst();});\n document.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();if(phase==='playing'&&\"'!online.active)pause();});document.addEventListener('\"'visibilitychange',()=>{if(document.hidden&&phase==='playing'&&\"'!online.active)pause();});\n let touchCount=0;renderer.domElement.addEventListener('\"'pointerdown',e=>{const touch=e.pointerType==='touch';if(userActivity(touch?'touch':'mouse'))return;audio.unlock();pointerX=pointerWorld(e);pointerActive=true;if(touch){touchCount++;renderer.domElement.setPointerCapture(e.pointerId);if(touchCount>=2)activateBurst();else serve();}else if(e.button===2)activateBurst();else serve();});renderer.domElement.addEventListener('pointermove',e=>{const touch=e.pointerType==='touch';if(\"'!touch&&userActivity('\"'mouse'))return;if(touch&&e.buttons===0)return;pointerX=pointerWorld(e);pointerActive=true;});renderer.domElement.addEventListener('pointerup',e=>{if(e.pointerType==='touch')touchCount=Math.max(0,touchCount-1);});renderer.domElement.addEventListener('contextmenu',e=>e.preventDefault());\"'$('\"'#menuButton').onclick=()=>{userActivity(lastInput);pause();};\"'$('\"'#chargeButton').onclick=()=>{audio.unlock();activateBurst();};window.addEventListener('resize',resize);\n}\nfunction startAttract(){hideOverlay();startRun('solo');phase='attract';loadStage(0);\"'$('\"'#title').style.display='none';\"'$('\"'#hud').style.display='block';\"'$('\"'#attract').style.display='block';\"'$('\"'#menuButton').style.display='none';\"'$('\"'#playPrompt').style.display='none';\"'$('\"'#footerLeft').textContent='AI AT THE PADDLE · FOUR WAYS TO MAKE A BREAK';resize();}\nfunction snapshot(){return {phase,mode,stage,score,lives,charge,combo,burst,wideTime,slowTime,elapsed,balls:balls.length,remaining:bricks.filter(b=>b.alive).length,renderer:renderer?.backend?.isWebGPUBackend?'WebGPU':'WebGL2 fallback',physics:'Rapier 0.19.3',three:'180',stats:{...stats},settings:{...settings},config:{...cfg},ballState:balls.map(b=>({x:b.body.translation().x,y:b.body.translation().y,vx:b.body.linvel().x,vy:b.body.linvel().y,docked:b.docked})),paddles:paddles.map(p=>({x:p.x,y:p.y,seat:p.seat,width:p.width})),metrics:{...metrics}};}\nfunction networkState(){const s=snapshot();return {...s,bricks:bricks.filter(b=>b.alive).map(b=>({id:b.id,hp:b.hp,y:b.y})),ballList:balls.map(b=>({id:b.id,x:b.body.translation().x,y:b.body.translation().y})),powerups:powerups.map(p=>({x:p.x,y:p.y,type:p.type}))};}\nfunction applyNet(s){if(\"'!renderer||!s||online.role!=='\"'guest')return;if(netBuild\"'!==s.stage||!paddles.length){mode='\"'online';loadStage(s.stage);netBuild=s.stage;}const oldPhase=phase;phase=s.phase;score=s.score;lives=s.lives;stage=s.stage;charge=s.charge;combo=s.combo;burst=s.burst;stats=s.stats||stats;wideTime=s.wideTime;slowTime=s.slowTime;const activeBricks=new Map((s.bricks||[]).map(b=>[b.id,b]));for(const b of bricks){const n=activeBricks.get(b.id);if(\"'!n&&b.alive){b.alive=false;burstParticles(b.x,b.y,b.c,5);b.group.removeFromParent();}if(n){b.group.visible=true;b.hp=n.hp;b.y=n.y;b.group.position.y=n.y;}}\n for(const b of balls){playGroup.remove(b.group);b.trail.forEach(t=>playGroup.remove(t));}balls=[];for(const b of s.ballList||[]){const o=ballMesh(burst>0?C.coral:C.paper,.2);o.position.set(b.x,b.y,.4);playGroup.add(o);balls.push({group:o,body:{translation:()=>({x:b.x,y:b.y}),linvel:()=>({x:0,y:0})},docked:false,trail:[]});}\n s.paddles?.forEach((p,i)=>{if(paddles[i]){if(p.seat!==online.mySeat){paddles[i].x=p.x;paddles[i].group.position.x=p.x;}paddles[i].width=p.width;paddles[i].group.scale.x=p.width/3.1;}});if(['\"'gameover','victory'].includes(phase)&&oldPhase\"'!==phase)showEnd(phase==='\"'victory');if(oldPhase==='paused'&&phase==='playing')hideOverlay();if(phase==='paused'&&\"'!menuName)showPanel('\"'netpause','<div class=\\\"eyebrow\\\">A MOMENT OF STILLNESS</div><h2>Host has paused.</h2><p>Your partner will be right back.</p>');updateUI();}\nfunction updateGuest(dt){const p=paddles.find(p=>p.seat===online.mySeat)||paddles[1];if(\"'!p)return;const pad=getPads()[0];let tx=p.x;if(pointerActive)tx=pointerX;if(keys.has('\"'KeyA')||keys.has('ArrowLeft'))tx-=20*dt;if(keys.has('KeyD')||keys.has('ArrowRight'))tx+=20*dt;if(Math.abs(pad?.axes?.[0]||0)>.12)tx+=(pad.axes[0])*21*dt;p.x=clamp(tx,-9+p.width/2,9-p.width/2);p.group.position.x=p.x;online.sendInput({x:p.x});}\nfunction frame(t){const dt=Math.min((t-lastTime)/1000||.016,.06);lastTime=t;metrics.frames++;pollPads(dt);if(phase==='title'&&performance.now()-idleAt>=10000)startAttract();if(netMode==='guest'&&online.connected){updateGuest(dt);}else{accumulator+=dt;if(\"'!['\"'playing','attract','clear'].includes(phase))accumulator=0;while(accumulator>=1/120){simulate(1/120);accumulator-=1/120;}}\n if(mode==='online'&&netMode==='host'&&online.connected)online.sendState(networkState());updateFX(dt);audio.update(dt,['playing','attract','title'].includes(phase));if(settings.shake&&shake>0){camera.position.x=Math.sin(t*.13)*shake*.3;camera.position.y=-3.8+Math.cos(t*.1)*shake*.3;}else{camera.position.x=0;camera.position.y=-3.8;}if(phase==='title'){boardGroup.rotation.z=-.1+Math.sin(t*.0004)*.012;titleGroup.rotation.z=Math.sin(t*.00008)*.025;}updateUI();renderer.render(scene,camera);requestAnimationFrame(frame);}\nasync function init(){try{\n \"'$('\"'#loadtext').textContent='MIXING THE PHYSICS…';await RAPIER.init();renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));await renderer.init();renderer.outputColorSpace=THREE.SRGBColorSpace;\"'$('\"'#game').appendChild(renderer.domElement);\"'$('\"'#engineTag').textContent=renderer.backend.isWebGPUBackend?'WEBGPU ARCADE':'WEBGL2 ARCADE';buildScene();disposeWorld();loadStage(0);setupInput();setPrompts();\"'$('\"'#loading').style.display='none';\n window.__BOUNCEOUT__={ready:true,state:snapshot,start:startRun,step(seconds){for(let i=0;i<Math.min(seconds,120)*120;i++){simulate(1/120);updateFX(1/120)}updateUI();return snapshot();},setAuto(v){cfg.auto=v;},clearStage(){for(const b of bricks)if(b.alive){b.hp=1;hitBrick(b,null);colliders.delete(b.collider.handle);world.removeRigidBody(b.body);}stageComplete();},loseBall:()=>loseBall(true),pause,resume,setSetting,dev(v){Object.assign(cfg,v);devUsed=true;},spawnPower(type){const p=paddles[0];dropPower(p.x,p.y+.6,type);},launch:serve,idle(seconds){idleAt=performance.now()-seconds*1000;},audio:()=>audio.metrics,online,showTitle,showAbout,async audioTest(){const ctx=new OfflineAudioContext(2,48000,48000);const a=new ArcadeAudio({context:ctx});await a.unlock();const promise=ctx.startRendering();a.update(.016,true);for(const n of ['brick','paddle','wall','launch','powerup','lose','win','charge','burst','menu','confirm','cancel','stage'])a.play(n);a.speak('ready');const b=await promise;const data=b.getChannelData(0);let peak=0,ss=0;for(const x of data){peak=Math.max(peak,Math.abs(x));ss+=x*x;}return {peak,rms:Math.sqrt(ss/data.length),metrics:a.metrics};}};\n if(online.isHub){await online.init();await online.ready();}requestAnimationFrame(frame);\n }catch(e){console.error(e);\"'$('\"'#loadtext').textContent='THE INK DIDN’T QUITE DRY.';\"'$('\"'#error').style.display='block';\"'$('\"'#error').textContent=e.message+' · Try a current browser with WebGPU or WebGL2 enabled.';window.__BOUNCEOUT_ERROR__=String(e);}}\ninit();\nEOF\ncat > build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport fs from 'node:fs';\nimport path from 'node:path';\nconst dir=path.dirname(new URL(import.meta.url).pathname);\nconst name=JSON.parse(fs.readFileSync(path.join(dir,'title-selection.json'))).slug;\nconst result=await build({entryPoints:[path.join(dir,'main.js')],bundle:true,format:'esm',minify:true,target:'es2022',write:false,legalComments:'none'});\nlet html=fs.readFileSync(path.join(dir,'index.html'),'utf8');\nhtml=html.replace('<\"'!--HUB_SESSION-->'\"','<script>\\\\n'+fs.readFileSync(path.join(dir,'hub/session.js'),'utf8').replace(/<\\\\/script/gi,'<\\\\\\\\/script')+'\\\\n</script>');\nhtml=html.replace('/*GAME_SCRIPT*/',result.outputFiles[0].text.replace(/<\\\\/script/gi,'<\\\\\\\\/script'));\nfs.writeFileSync(path.join(dir,'../',name+'.html'),html);\nconsole.log(name+'.html ('+(Buffer.byteLength(html)/1024/1024).toFixed(2)+' MB)');\nEOF\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('package.json');d=json.loads(p.read_text());d['type']='module';d['scripts']={'build':'node build.mjs','test':'/home/micha/.local/share/pipx/venvs/playwright/bin/python tests.py'};d['private']=True;p.write_text(json.dumps(d,indent=2)+'\\\\n')\ns={'date':'2026-11-06 01:11:53','source':'Super Breakout (1981)','plan':'none','genre':'Arcade action / brick breaker','perspective':'Fixed overhead orthographic 3D','tech':'Three.js r180 WebGPURenderer, TSL cel materials; Rapier 2D 0.19.3; Gamepad API; Web Audio; PeerJS 1.5.5; AI Hub session client','artDirection':'Stylized cel shading, navy ink outlines, warm paper, coral / teal print palette','animation':'Three.js AnimationMixer and AnimationClip for brick destruction; procedural trails, particles and paddle squash','audio':'Code-generated synth music (10% default), effects and Animalese-style gibberish voices; no audio files','online':'1–2 player shared-world co-op, AI Hub sessions, standalone WebRTC rooms and same-device BroadcastChannel','testing':'Headless Chromium WebGPU, simulated keyboard, standard gamepads and touch, scripted campaign, two-page networking and offline Web Audio','research':'none; supplied AI Hub integration specification read directly','environment':'Codex CLI (headless); Linux','model':'OpenAI, gpt-6.1-sol, reasoning effort ultra','usage':'added on import'}\nd={'sourceInformation':s,'testingFeedback':['unknown','unknown','unknown','unknown'],'engineFeedback':['TSL materials and native animation clips make a cohesive procedural arcade scene.','unknown','Arcade paddle rebound rules, stage flow, controller UI and multiplayer synchronization.','Keeping fast-ball physics predictable while preserving satisfying angle control.','none','A first-class cel material and outline pass across both rendering backends.'],'promptFeedback':['The source, complete-demo scope and TV controller focus give a strong design direction.','The no-research instruction and linked integration documentation need a distinction; only the supplied specification was fetched.','Delivering a single file with WebGPU, embedded physics, full controls and multiplayer.','Define the required standalone online transport and include the hub contract inline.'],'aiHub':{'name':'Super Bounceout','tagline':'Good angles. Bad intentions.','description':'An ink-and-paper brick breaker with four handcrafted stages, captive multiballs, double paddles and a wall that won’t sit still. Make a clean break solo or share the paddle work in local and online co-op.','type':'Game','genre':'Action','source':'Super Breakout (1981)','series':'','players':'1–2','controls':'Move: left stick / D-pad, mouse or A/D / arrows; serve: Cross / A / Space / tap; ink burst: Triangle / Y / Shift / right click; pause: Options / Esc.','tags':['arcade','3d','retro','co-op','top-down','cel-shaded']}}\nPath('credits.json').write_text(json.dumps(d,indent=2)+'\\\\n')\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat >> main.js <<'EOF'\n\nfunction prompt(action){const gp=lastInput==='gamepad',x=settings.glyphs==='xbox';return action==='serve'?(gp?(x?'A':'✕'):lastInput==='touch'?'Tap':'Space'):action==='burst'?(gp?(x?'Y':'△'):lastInput==='touch'?'Tap burst':'Shift'):gp?'Options':'Esc';}\nfunction setPrompts(){\"'$$('\"'[data-prompt]').forEach(e=>e.textContent=prompt(e.dataset.prompt));if(phase==='title')\"'$('\"'#footerLeft').textContent=lastInput==='gamepad'?\"'`${settings.glyphs==='\"'xbox'?'A':'✕'} Select · \"'${settings.glyphs==='\"'xbox'?'B':'○'} Back · Left stick / D-pad Move\"'`:'\"'Move: mouse / ← → · Serve: Space · Burst: Shift';updateUI();}\nfunction focusButtons(){return \"'$$(menuName?'\"'#panel button:not(:disabled),#panel input,#panel select':'#title button:not(:disabled)');}\nfunction focusMenu(i){const list=focusButtons();if(\"'!list.length)return;menuFocus=(i+list.length)%list.length;$$('\"'.focused').forEach(e=>e.classList.remove('focused'));list[menuFocus].classList.add('focused');list[menuFocus].focus({preventScroll:true});list[menuFocus].scrollIntoView({block:'nearest'});}\nfunction showPanel(name,html){menuName=name;\"'$('\"'#panel').innerHTML=html;\"'$('\"'#overlay').style.display='flex';menuFocus=0;\"'$$('\"'.focused').forEach(e=>e.classList.remove('focused'));if(lastInput==='gamepad'||lastInput==='keyboard')focusMenu(0);}\nfunction hideOverlay(){menuName='';\"'$('\"'#overlay').style.display='none';\"'$('\"'#panel').innerHTML='';}\nfunction backButton(action='back'){return \"'`<button class=\"back\" data-action=\"${action}\">${lastInput==='\"'gamepad'?(settings.glyphs==='xbox'?'B':'○'):'Esc'} Back</button>\"'`;}\nfunction pause(){if(phase!=='\"'playing'&&phase\"'!=='\"'clear')return;returnMenu=phase;phase='paused';showPause();}\nfunction showPause(){showPanel('pause',\"'`<div class=\"eyebrow\">TAKE A BREATHER</div><h2>Hold that thought.</h2><p>Even a good bounce needs a little space.</p><div class=\"actions\"><button class=\"primary\" data-action=\"resume\">Keep bouncing <span data-prompt=\"serve\">${prompt('\"'serve')}</span></button><button class=\\\"secondary\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"secondary\\\" data-action=\\\"dev\\\">Developer tools</button><button class=\\\"secondary\\\" data-action=\\\"how\\\">How to play</button><button class=\\\"secondary\\\" data-action=\\\"about\\\">About & credits</button>\"'${online.isHub?'\"'':'<button class=\\\"secondary\\\" data-action=\\\"title\\\">Back to title</button>'}</div>\"'`);}\nfunction resume(){if(phase!=='\"'paused')return;phase=returnMenu==='clear'?'clear':'playing';hideOverlay();}\nfunction back(){audio.play('cancel');if(menuName==='pause')resume();else if(phase==='paused')showPause();else if(menuName==='online'&&online.active&&\"'!online.connected){online.leave();netMode='\"'solo';hideOverlay();}else if(menuName)hideOverlay();else if(phase==='playing'||phase==='clear')pause();}\nfunction showSettings(){showPanel('settings',\"'`${backButton()}<div class=\"eyebrow\">MAKE YOURSELF AT HOME</div><h2>Your kind of bounce.</h2><div class=\"setting\"><label for=\"musicVol\">Music<small>A little groove goes a long way.</small></label><div class=\"sliderpack\"><input id=\"musicVol\" type=\"range\" min=\"0\" max=\"100\" value=\"${Math.round(settings.music*100)}\" data-setting=\"music\" aria-label=\"Music volume\"><output>${Math.round(settings.music*100)}%</output></div></div><div class=\"setting\"><label for=\"sfxVol\">Effects & voices</label><div class=\"sliderpack\"><input id=\"sfxVol\" type=\"range\" min=\"0\" max=\"100\" value=\"${Math.round(settings.sfx*100)}\" data-setting=\"sfx\" aria-label=\"Effects volume\"><output>${Math.round(settings.sfx*100)}%</output></div></div><div class=\"setting\"><label for=\"glyphs\">Controller symbols</label><select id=\"glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · ✕ ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div><div class=\\\"setting\\\"><label for=\\\"shake\\\">Screen shake<small>Keep the ink from rattling.</small></label><input type=\\\"checkbox\\\" id=\\\"shake\\\" data-setting=\\\"shake\\\" \"'${settings.shake?'\"'checked':''}></div><div class=\\\"setting\\\"><label for=\\\"assist\\\">Touch auto-paddle<small>Follow the ball on touch devices.</small></label><input type=\\\"checkbox\\\" id=\\\"assist\\\" data-setting=\\\"assist\\\" \"'${settings.assist?'\"'checked':''}></div><p class=\\\"tiny\\\">Settings are saved on this device. Touch: drag anywhere to move, tap to serve. A second finger unleashes a full burst.</p>\"'`);}\nfunction howTo(){showPanel('\"'how',\"'`${backButton()}<div class=\"eyebrow\">THE ART OF A GOOD RETURN</div><h2>Small paddle. Big ideas.</h2><div class=\"hintrow\"><span class=\"key\">${lastInput==='\"'gamepad'?'L / D-pad':'← → / A D'}</span><p>Move. The middle sends a straight shot. The edges cut a sharper angle.</p></div><div class=\\\"hintrow\\\"><span class=\\\"key\\\">\"'${prompt('\"'serve')}</span><p>Serve a ball, or begin the next stage. Mouse click and touch tap also serve.</p></div><div class=\\\"hintrow\\\"><span class=\\\"key\\\">\"'${prompt('\"'burst')}</span><p>At 100% charge, unleash 5 seconds of piercing ink. Break through whole rows.</p></div><div class=\\\"hintrow\\\"><span class=\\\"key\\\">\"'${prompt('\"'pause')}</span><p>Pause, change settings, or open the developer tools.</p></div><div class=\\\"tiles\\\" style=\\\"margin-top:20px\\\"><div class=\\\"tile\\\"><b>Catch the good stuff</b>↔ Wide paddle · ×3 Multiball · ~ Slow ball.<br>Three spare balls. Clear four stages to win.</div><div class=\\\"tile\\\"><b>Better together</b>Couch: P1 A/D, P2 arrows, or two pads.<br>Online: host a room and share its code. Both paddles share score and lives.</div></div><p class=\\\"tiny\\\">Gold pockets hold extra balls. Double adds an upper paddle. Progressive steps the wall toward you. Lose a life only when every active ball is gone.</p>\"'`);}\nfunction slider(name,label,min,max,step=1,help='\"''){return \"'`<div class=\"setting\"><label for=\"dev-${name}\">${label}${help?`<small>${help}</small>`:'\"''}</label><div class=\\\"sliderpack\\\"><input id=\\\"dev-\"'${name}\" data-dev=\"${name}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${cfg[name]}\"><output>${cfg[name]}</output></div></div>`;}\nfunction showDev(){devUsed=true;showPanel('\"'dev',\"'`${backButton('\"'pausemenu')}<div class=\\\"eyebrow\\\">THE PRINT SHOP / LIVE TUNING</div><h2>Make a little trouble.</h2>\"'${slider('\"'speed','Ball speed',8,20,.5)}\"'${slider('\"'paddleWidth','Paddle width',1.8,4.8,.1)}\"'${slider('\"'chargeRate','Charge gain',.5,3,.25)}<div class=\\\"setting\\\"><label for=\\\"dev-god\\\">Infinite spare balls</label><input id=\\\"dev-god\\\" type=\\\"checkbox\\\" data-dev=\\\"god\\\" \"'${cfg.god?'\"'checked':''}></div><div class=\\\"setting\\\"><label for=\\\"dev-auto\\\">AI paddle<small>Plays and advances stages automatically.</small></label><input id=\\\"dev-auto\\\" type=\\\"checkbox\\\" data-dev=\\\"auto\\\" \"'${cfg.auto?'\"'checked':''}></div><div class=\\\"tiles\\\"><button class=\\\"secondary\\\" data-action=\\\"devcharge\\\">Fill burst</button><button class=\\\"secondary\\\" data-action=\\\"devmulti\\\">Multiball</button><button class=\\\"secondary\\\" data-action=\\\"devnext\\\">Next stage</button><button class=\\\"secondary\\\" data-action=\\\"devreset\\\">Reset defaults</button></div><p class=\\\"tiny\\\">Tuning applies on resume. Developer tools mark this run. Settings reset at page reload. Network hosts control the simulation.</p>\"'`);}\nconst aboutTabs=[['\"'origin','Origin'],['craft','Craft'],['testing','Testing'],['engine','Engine'],['prompt','Prompt']];let aboutTab='origin';\nimport credits from './credits.json';\nfunction showAbout(tab='origin'){aboutTab=tab;const s=credits.sourceInformation;let content='';if(tab==='origin'||tab==='craft'){const fields=tab==='origin'?['date','source','plan','genre','perspective','research','environment','model','usage']:['tech','artDirection','animation','audio','online','testing'];content=\"'`<p>${tab==='\"'origin'?'A playful, independent tribute to the paddle-and-wall rhythm of Super Breakout (1981). All art is built from geometry and ink.':'Built for the big screen, from a small sheet of paper.'}</p><dl class=\\\"metadata\\\">\"'${fields.map(k=>`<dt>${k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,x=>x.toUpperCase())}</dt><dd>${s[k]}</dd>`).join('\"'')}</dl>\"'`;}else{const questions=tab==='\"'testing'?['Issues caught','Critical issues','Most helpful test','Least helpful test']:tab==='engine'?['Best part','Wrong guesses','Built by hand','Hardest part','Engine changes','One wish']:['Best part','Confusing','Hardest part','One change'];const answers=credits[tab==='testing'?'testingFeedback':tab==='engine'?'engineFeedback':'promptFeedback'];content=\"'`<div class=\"feedback\">${answers.map((a,i)=>`<h3>${questions[i]}</h3><p>${a}</p>`).join('\"'')}</div>\"'`;}\n showPanel('\"'about',\"'`${backButton()}<div class=\"eyebrow\">SOURCE INFORMATION & FIELD NOTES</div><h2>Behind the bounce.</h2><div class=\"minorlinks\" style=\"margin:0 0 20px\">${aboutTabs.map(([key,label])=>`<button class=\"textbutton\" data-about=\"${key}\" style=\"${tab===key?'\"'color:var(--orange);border-bottom-color:var(--orange)':''}\\\">\"'${label}</button>`).join('\"'')}</div>\"'${content}`);}\nfunction showOnline(){showPanel('\"'online',\"'`${backButton()}<div class=\"eyebrow\">ONE WALL. TWO PADDLES.</div><h2>Make a connection.</h2><p>Host a room, then share its six-letter code with a friend. Your score, spare balls and glorious mistakes are shared.</p><div class=\"actions\"><button class=\"primary\" data-action=\"host\">Host a room <span>↗</span></button></div><div class=\"setting\"><label for=\"joinCode\">Or join a friend</label><input id=\"joinCode\" type=\"text\" maxlength=\"6\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"ROOM CODE\" aria-label=\"Room code\" style=\"text-transform:uppercase;letter-spacing:3px;width:180px\"></div><div class=\"actions\"><button class=\"secondary\" data-action=\"join\">Join room</button></div><div id=\"roomDisplay\"></div><p id=\"networkStatus\" class=\"networkstatus\">Cross-device play uses a WebRTC peer connection. Keep the host’s game open.</p><p class=\"tiny\">Same-device tabs also work. The room starts when your partner connects.</p>`);}\nasync function hostRoom(){if($('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent='Opening the ink line…';try{const code=await online.host();if(\"'$('\"'#roomDisplay'))\"'$('\"'#roomDisplay').innerHTML=\"'`<div class=\"roomcode\">${code}</div><button class=\"textbutton\" data-action=\"copycode\">Copy room code</button>`;}catch(e){if($('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent=e.message;}}\nasync function joinRoom(){const code=\"'$('\"'#joinCode')?.value?.trim();if(\"'!code)return;if($('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent='Finding your partner…';try{await online.join(code);}catch(e){if(\"'$('\"'#networkStatus'))\"'$('\"'#networkStatus').textContent=e.message;}}\nfunction setSetting(key,value){settings[key]=value;if(key==='music')audio.setMusicVolume(value);if(key==='sfx')audio.setSfxVolume(value);saveSettings();setPrompts();}\nfunction handleAction(a){audio.unlock();audio.play('menu');switch(a){case'start':startRun();break;case'coop':startRun('coop');break;case'online':showOnline();break;case'host':hostRoom();break;case'join':joinRoom();break;case'copycode':navigator.clipboard?.writeText(online.roomCode).then(()=>toast('ROOM CODE COPIED')).catch(()=>toast(online.roomCode));break;case'settings':showSettings();break;case'how':howTo();break;case'about':showAbout();break;case'back':back();break;case'pausemenu':showPause();break;case'resume':resume();break;case'dev':showDev();break;case'title':showTitle();break;case'again':if(online.active){startRun('online')}else startRun(mode==='coop'?'coop':'solo');break;case'devcharge':charge=100;toast('BURST FILLED');break;case'devmulti':takePower('multi');break;case'devnext':if(stage<3)loadStage(stage+1);else{hideOverlay();finishRun(true)}break;case'devreset':Object.assign(cfg,DEFAULTS);showDev();toast('DEFAULTS RESTORED');break;}}\nfunction userActivity(kind){idleAt=performance.now();if(kind&&kind\"'!==lastInput){lastInput=kind;setPrompts();}if(phase==='\"'attract'){showTitle();return true}return false;}\nfunction sendAction(action){const p=paddles.find(p=>p.seat===1)||paddles[0];online.sendInput({x:p?.x||0,[action]:true});}\nfunction pointerWorld(event){const v=new THREE.Vector3(event.clientX/innerWidth*2-1,-event.clientY/innerHeight*2+1,0);v.unproject(camera);v.sub(boardGroup.position);return v.x;}\nfunction getPads(){try{return [...navigator.getGamepads()].filter(Boolean)}catch{return[]}}\nfunction pollPads(dt){const pads=getPads();let active=false;for(let index=0;index<pads.length;index++){const p=pads[index],prev=padPrevious[index]||[];const pressed=i=>\"'!!p.buttons?.[i]?.pressed;const down=i=>pressed(i)&&!prev[i];const ax=p.axes?.[0]||0,ay=p.axes?.[1]||0;if(Math.abs(ax)>.18||Math.abs(ay)>.18||p.buttons.some(b=>b.pressed)){active=true;if(userActivity('\"'gamepad')){padPrevious[index]=p.buttons.map(b=>b.pressed);continue;}}\n if(index===0){if(down(9)&&\"'!pressed(8)){if(menuName)back();else pause();}if(menuName||phase==='\"'title'){menuRepeat-=dt;const up=pressed(12)||ay<-.5,downDir=pressed(13)||ay>.5;if((up||downDir)&&menuRepeat<=0){focusMenu(menuFocus+(up?-1:1));audio.play('menu');menuRepeat=.2;}if(\"'!up&&!downDir)menuRepeat=0;const focused=focusButtons()[menuFocus];if(focused?.matches('\"'input[type=range]')&&(pressed(14)||pressed(15)||Math.abs(ax)>.5)&&menuRepeat<=0){const sign=pressed(14)||ax<-.5?-1:1;focused.value=clamp(+focused.value+sign*Number(focused.step||1),+focused.min,+focused.max);focused.dispatchEvent(new Event('input',{bubbles:true}));menuRepeat=.15;}if(focused?.tagName==='SELECT'&&(down(14)||down(15))){focused.selectedIndex=1-focused.selectedIndex;focused.dispatchEvent(new Event('change',{bubbles:true}));}if(down(0)){if(focused?.matches('input[type=checkbox]')){focused.checked=\"'!focused.checked;focused.dispatchEvent(new Event('\"'change',{bubbles:true}));}else focused?.click();}if(down(1))back();}else{if(down(0))serve();if(down(3))activateBurst();}}\n else if(\"'!menuName){if(down(0))serve();if(down(3))activateBurst();}\n padPrevious[index]=p.buttons.map(b=>b.pressed);}\n if(active)setPrompts();}\nfunction setupInput(){document.addEventListener('\"'click',e=>{const about=e.target.closest('[data-about]');if(about){showAbout(about.dataset.about);return}const b=e.target.closest('[data-action]');if(b)handleAction(b.dataset.action);});document.addEventListener('pointerover',e=>{const b=e.target.closest('button,input,select');if(b){const i=focusButtons().indexOf(b);if(i>=0){menuFocus=i;\"'$$('\"'.focused').forEach(x=>x.classList.remove('focused'));b.classList.add('focused');}}});\n for(const type of ['input','change'])document.addEventListener(type,e=>{const el=e.target;if(el.dataset.setting){const key=el.dataset.setting;let value=el.type==='checkbox'?el.checked:el.type==='range'?+el.value/100:el.value;setSetting(key,value);if(el.nextElementSibling?.tagName==='OUTPUT')el.nextElementSibling.textContent=Math.round(value*100)+'%';}if(el.dataset.dev){const key=el.dataset.dev;cfg[key]=el.type==='checkbox'?el.checked:+el.value;if(el.nextElementSibling?.tagName==='OUTPUT')el.nextElementSibling.textContent=cfg[key];}});\n document.addEventListener('keydown',e=>{if(e.target.matches('input[type=text]')){if(e.code==='Enter')joinRoom();if(e.code\"'!=='\"'Escape')return;}if(userActivity('keyboard'))return;audio.unlock();keys.add(e.code);if(['Space','ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Tab'].includes(e.code))e.preventDefault();if(e.repeat)return;if(e.code==='Escape'||e.code==='KeyP'){if(menuName)back();else pause();return;}if(menuName||phase==='title'){if(e.code==='ArrowDown'||e.code==='Tab')focusMenu(menuFocus+1);else if(e.code==='ArrowUp')focusMenu(menuFocus-1);else if(e.code==='Enter'||e.code==='Space'){const f=focusButtons()[menuFocus];if(f?.type==='checkbox'){f.checked=\"'!f.checked;f.dispatchEvent(new Event('\"'change',{bubbles:true}));}else f?.click();}else if((e.code==='ArrowLeft'||e.code==='ArrowRight')&&document.activeElement?.type==='range'){const el=document.activeElement;el.value=+el.value+(e.code==='ArrowLeft'?-1:1)*Number(el.step||1);el.dispatchEvent(new Event('input',{bubbles:true}));}return;}if(e.code==='Space'||e.code==='Enter')serve();if(e.code==='ShiftLeft'||e.code==='ShiftRight')activateBurst();});\n document.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();if(phase==='playing'&&\"'!online.active)pause();});document.addEventListener('\"'visibilitychange',()=>{if(document.hidden&&phase==='playing'&&\"'!online.active)pause();});\n let touchCount=0;renderer.domElement.addEventListener('\"'pointerdown',e=>{const touch=e.pointerType==='touch';if(userActivity(touch?'touch':'mouse'))return;audio.unlock();pointerX=pointerWorld(e);pointerActive=true;if(touch){touchCount++;renderer.domElement.setPointerCapture(e.pointerId);if(touchCount>=2)activateBurst();else serve();}else if(e.button===2)activateBurst();else serve();});renderer.domElement.addEventListener('pointermove',e=>{const touch=e.pointerType==='touch';if(\"'!touch&&userActivity('\"'mouse'))return;if(touch&&e.buttons===0)return;pointerX=pointerWorld(e);pointerActive=true;});renderer.domElement.addEventListener('pointerup',e=>{if(e.pointerType==='touch')touchCount=Math.max(0,touchCount-1);});renderer.domElement.addEventListener('contextmenu',e=>e.preventDefault());\"'$('\"'#menuButton').onclick=()=>{userActivity(lastInput);pause();};\"'$('\"'#chargeButton').onclick=()=>{audio.unlock();activateBurst();};window.addEventListener('resize',resize);\n}\nfunction startAttract(){hideOverlay();startRun('solo');phase='attract';loadStage(0);\"'$('\"'#title').style.display='none';\"'$('\"'#hud').style.display='block';\"'$('\"'#attract').style.display='block';\"'$('\"'#menuButton').style.display='none';\"'$('\"'#playPrompt').style.display='none';\"'$('\"'#footerLeft').textContent='AI AT THE PADDLE · FOUR WAYS TO MAKE A BREAK';resize();}\nfunction snapshot(){return {phase,mode,stage,score,lives,charge,combo,burst,wideTime,slowTime,elapsed,balls:balls.length,remaining:bricks.filter(b=>b.alive).length,renderer:renderer?.backend?.isWebGPUBackend?'WebGPU':'WebGL2 fallback',physics:'Rapier 0.19.3',three:'180',stats:{...stats},settings:{...settings},config:{...cfg},ballState:balls.map(b=>({x:b.body.translation().x,y:b.body.translation().y,vx:b.body.linvel().x,vy:b.body.linvel().y,docked:b.docked})),paddles:paddles.map(p=>({x:p.x,y:p.y,seat:p.seat,width:p.width})),metrics:{...metrics}};}\nfunction networkState(){const s=snapshot();return {...s,bricks:bricks.filter(b=>b.alive).map(b=>({id:b.id,hp:b.hp,y:b.y})),ballList:balls.map(b=>({id:b.id,x:b.body.translation().x,y:b.body.translation().y})),powerups:powerups.map(p=>({x:p.x,y:p.y,type:p.type}))};}\nfunction applyNet(s){if(\"'!renderer||!s||online.role!=='\"'guest')return;if(netBuild\"'!==s.stage||!paddles.length){mode='\"'online';loadStage(s.stage);netBuild=s.stage;}const oldPhase=phase;phase=s.phase;score=s.score;lives=s.lives;stage=s.stage;charge=s.charge;combo=s.combo;burst=s.burst;stats=s.stats||stats;wideTime=s.wideTime;slowTime=s.slowTime;const activeBricks=new Map((s.bricks||[]).map(b=>[b.id,b]));for(const b of bricks){const n=activeBricks.get(b.id);if(\"'!n&&b.alive){b.alive=false;burstParticles(b.x,b.y,b.c,5);b.group.removeFromParent();}if(n){b.group.visible=true;b.hp=n.hp;b.y=n.y;b.group.position.y=n.y;}}\n for(const b of balls){playGroup.remove(b.group);b.trail.forEach(t=>playGroup.remove(t));}balls=[];for(const b of s.ballList||[]){const o=ballMesh(burst>0?C.coral:C.paper,.2);o.position.set(b.x,b.y,.4);playGroup.add(o);balls.push({group:o,body:{translation:()=>({x:b.x,y:b.y}),linvel:()=>({x:0,y:0})},docked:false,trail:[]});}\n s.paddles?.forEach((p,i)=>{if(paddles[i]){if(p.seat!==online.mySeat){paddles[i].x=p.x;paddles[i].group.position.x=p.x;}paddles[i].width=p.width;paddles[i].group.scale.x=p.width/3.1;}});if(['\"'gameover','victory'].includes(phase)&&oldPhase\"'!==phase)showEnd(phase==='\"'victory');if(oldPhase==='paused'&&phase==='playing')hideOverlay();if(phase==='paused'&&\"'!menuName)showPanel('\"'netpause','<div class=\\\"eyebrow\\\">A MOMENT OF STILLNESS</div><h2>Host has paused.</h2><p>Your partner will be right back.</p>');updateUI();}\nfunction updateGuest(dt){const p=paddles.find(p=>p.seat===online.mySeat)||paddles[1];if(\"'!p)return;const pad=getPads()[0];let tx=p.x;if(pointerActive)tx=pointerX;if(keys.has('\"'KeyA')||keys.has('ArrowLeft'))tx-=20*dt;if(keys.has('KeyD')||keys.has('ArrowRight'))tx+=20*dt;if(Math.abs(pad?.axes?.[0]||0)>.12)tx+=(pad.axes[0])*21*dt;p.x=clamp(tx,-9+p.width/2,9-p.width/2);p.group.position.x=p.x;online.sendInput({x:p.x});}\nfunction frame(t){const dt=Math.min((t-lastTime)/1000||.016,.06);lastTime=t;metrics.frames++;pollPads(dt);if(phase==='title'&&performance.now()-idleAt>=10000)startAttract();if(netMode==='guest'&&online.connected){updateGuest(dt);}else{accumulator+=dt;if(\"'!['\"'playing','attract','clear'].includes(phase))accumulator=0;while(accumulator>=1/120){simulate(1/120);accumulator-=1/120;}}\n if(mode==='online'&&netMode==='host'&&online.connected)online.sendState(networkState());updateFX(dt);audio.update(dt,['playing','attract','title'].includes(phase));if(settings.shake&&shake>0){camera.position.x=Math.sin(t*.13)*shake*.3;camera.position.y=-3.8+Math.cos(t*.1)*shake*.3;}else{camera.position.x=0;camera.position.y=-3.8;}if(phase==='title'){boardGroup.rotation.z=-.1+Math.sin(t*.0004)*.012;titleGroup.rotation.z=Math.sin(t*.00008)*.025;}updateUI();renderer.render(scene,camera);requestAnimationFrame(frame);}\nasync function init(){try{\n \"'$('\"'#loadtext').textContent='MIXING THE PHYSICS…';await RAPIER.init();renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));await renderer.init();renderer.outputColorSpace=THREE.SRGBColorSpace;\"'$('\"'#game').appendChild(renderer.domElement);\"'$('\"'#engineTag').textContent=renderer.backend.isWebGPUBackend?'WEBGPU ARCADE':'WEBGL2 ARCADE';buildScene();disposeWorld();loadStage(0);setupInput();setPrompts();\"'$('\"'#loading').style.display='none';\n window.__BOUNCEOUT__={ready:true,state:snapshot,start:startRun,step(seconds){for(let i=0;i<Math.min(seconds,120)*120;i++){simulate(1/120);updateFX(1/120)}updateUI();return snapshot();},setAuto(v){cfg.auto=v;},clearStage(){for(const b of bricks)if(b.alive){b.hp=1;hitBrick(b,null);colliders.delete(b.collider.handle);world.removeRigidBody(b.body);}stageComplete();},loseBall:()=>loseBall(true),pause,resume,setSetting,dev(v){Object.assign(cfg,v);devUsed=true;},spawnPower(type){const p=paddles[0];dropPower(p.x,p.y+.6,type);},launch:serve,idle(seconds){idleAt=performance.now()-seconds*1000;},audio:()=>audio.metrics,online,showTitle,showAbout,async audioTest(){const ctx=new OfflineAudioContext(2,48000,48000);const a=new ArcadeAudio({context:ctx});await a.unlock();const promise=ctx.startRendering();a.update(.016,true);for(const n of ['brick','paddle','wall','launch','powerup','lose','win','charge','burst','menu','confirm','cancel','stage'])a.play(n);a.speak('ready');const b=await promise;const data=b.getChannelData(0);let peak=0,ss=0;for(const x of data){peak=Math.max(peak,Math.abs(x));ss+=x*x;}return {peak,rms:Math.sqrt(ss/data.length),metrics:a.metrics};}};\n if(online.isHub){await online.init();await online.ready();}requestAnimationFrame(frame);\n }catch(e){console.error(e);\"'$('\"'#loadtext').textContent='THE INK DIDN’T QUITE DRY.';\"'$('\"'#error').style.display='block';\"'$('\"'#error').textContent=e.message+' · Try a current browser with WebGPU or WebGL2 enabled.';window.__BOUNCEOUT_ERROR__=String(e);}}\ninit();\nEOF\ncat > build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport fs from 'node:fs';\nimport path from 'node:path';\nconst dir=path.dirname(new URL(import.meta.url).pathname);\nconst name=JSON.parse(fs.readFileSync(path.join(dir,'title-selection.json'))).slug;\nconst result=await build({entryPoints:[path.join(dir,'main.js')],bundle:true,format:'esm',minify:true,target:'es2022',write:false,legalComments:'none'});\nlet html=fs.readFileSync(path.join(dir,'index.html'),'utf8');\nhtml=html.replace('<\"'!--HUB_SESSION-->'\"','<script>\\\\n'+fs.readFileSync(path.join(dir,'hub/session.js'),'utf8').replace(/<\\\\/script/gi,'<\\\\\\\\/script')+'\\\\n</script>');\nhtml=html.replace('/*GAME_SCRIPT*/',result.outputFiles[0].text.replace(/<\\\\/script/gi,'<\\\\\\\\/script'));\nfs.writeFileSync(path.join(dir,'../',name+'.html'),html);\nconsole.log(name+'.html ('+(Buffer.byteLength(html)/1024/1024).toFixed(2)+' MB)');\nEOF\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('package.json');d=json.loads(p.read_text());d['type']='module';d['scripts']={'build':'node build.mjs','test':'/home/micha/.local/share/pipx/venvs/playwright/bin/python tests.py'};d['private']=True;p.write_text(json.dumps(d,indent=2)+'\\\\n')\ns={'date':'2026-11-06 01:11:53','source':'Super Breakout (1981)','plan':'none','genre':'Arcade action / brick breaker','perspective':'Fixed overhead orthographic 3D','tech':'Three.js r180 WebGPURenderer, TSL cel materials; Rapier 2D 0.19.3; Gamepad API; Web Audio; PeerJS 1.5.5; AI Hub session client','artDirection':'Stylized cel shading, navy ink outlines, warm paper, coral / teal print palette','animation':'Three.js AnimationMixer and AnimationClip for brick destruction; procedural trails, particles and paddle squash','audio':'Code-generated synth music (10% default), effects and Animalese-style gibberish voices; no audio files','online':'1–2 player shared-world co-op, AI Hub sessions, standalone WebRTC rooms and same-device BroadcastChannel','testing':'Headless Chromium WebGPU, simulated keyboard, standard gamepads and touch, scripted campaign, two-page networking and offline Web Audio','research':'none; supplied AI Hub integration specification read directly','environment':'Codex CLI (headless); Linux','model':'OpenAI, gpt-6.1-sol, reasoning effort ultra','usage':'added on import'}\nd={'sourceInformation':s,'testingFeedback':['unknown','unknown','unknown','unknown'],'engineFeedback':['TSL materials and native animation clips make a cohesive procedural arcade scene.','unknown','Arcade paddle rebound rules, stage flow, controller UI and multiplayer synchronization.','Keeping fast-ball physics predictable while preserving satisfying angle control.','none','A first-class cel material and outline pass across both rendering backends.'],'promptFeedback':['The source, complete-demo scope and TV controller focus give a strong design direction.','The no-research instruction and linked integration documentation need a distinction; only the supplied specification was fetched.','Delivering a single file with WebGPU, embedded physics, full controls and multiplayer.','Define the required standalone online transport and include the hub contract inline.'],'aiHub':{'name':'Super Bounceout','tagline':'Good angles. Bad intentions.','description':'An ink-and-paper brick breaker with four handcrafted stages, captive multiballs, double paddles and a wall that won’t sit still. Make a clean break solo or share the paddle work in local and online co-op.','type':'Game','genre':'Action','source':'Super Breakout (1981)','series':'','players':'1–2','controls':'Move: left stick / D-pad, mouse or A/D / arrows; serve: Cross / A / Space / tap; ink burst: Triangle / Y / Shift / right click; pause: Options / Esc.','tags':['arcade','3d','retro','co-op','top-down','cel-shaded']}}\nPath('credits.json').write_text(json.dumps(d,indent=2)+'\\\\n')\nPY\nnode build.mjs\"","aggregated_output":"Super-Bounceout-Super-Breakout-gpt-6.1-sol-ultra-20261106-011153.html (2.44 MB)\n","exit_code":0,"status":"completed"}}
