{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text();old=\\\"onLeave(){if(phase==='playing'){toast('PARTNER LEFT · SOLO PADDLE');mode='solo';paddles=paddles.filter(p=>{if(p.seat===1){p.group.removeFromParent();colliders.delete(p.collider.handle);world.removeRigidBody(p.body);return false;}return true;});}}\\\"\nnew=\\\"onLeave(seat){toast(online.isHub?'PARTNER LEFT THE ROUND':'PARTNER LEFT · SOLO PADDLE');if(\"'!online.isHub)mode='\"'solo';if(netMode==='host')paddles=paddles.filter(p=>{if(p.seat===seat){p.group.removeFromParent();colliders.delete(p.collider.handle);world.removeRigidBody(p.body);return false;}return true;});}\\\"\nassert old in s;s=s.replace(old,new)\n# Restore only actual alive meshes in replicated world after a late snapshot.\ns=s.replace(\\\"if(n){b.group.visible=true;b.hp=n.hp;\\\", \\\"if(n){if(\"'!b.alive){b.alive=true;playGroup.add(b.group);}b.group.visible=true;b.hp=n.hp;\")\np.write_text(s)\nPY\nnode build.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
