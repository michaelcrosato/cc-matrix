r;justify-content:center;padding:55px 20px}.panel{background:var(--paper);border:2px solid var(--ink);box-shadow:8px 8px 0 #0e2029;border-radius:5px;padding:32px 40px;max-width:760px;width:100%;max-height:88vh;overflow:auto;position:relative}.panel h2{font:800 52px/.9 var(--display);text-transform:uppercase;letter-spacing:-.6px;margin:10px 0 24px}.panel h3{font:800 26px var(--display);text-transform:uppercase;margin:21px 0 9px}.panel p{font-size:14px;line-height:1.65;color:#53696a}.panel .eyebrow{font-size:10px}.panel .actions{display:flex;flex-direction:column;gap:12px;max-width:420px}.back{position:absolute;right:25px;top:23px;background:none;border:1px solid #9dafa4;padding:7px 12px;color:var(--ink);border-radius:3px;font-size:12px}.setting{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:19px 0;font-size:15px}.setting label{font-weight:600}.setting small{display:block;font-size:11px;font-weight:400;color:var(--muted);margin-top:4px}.setting input[type=range]{accent-color:var(--teal);width:200px;height:26px}.setting output{min-width:42px;font:700 21px var(--display);text-align:right}.sliderpack{display:flex;align-items:center;gap:12px}.setting select,.setting input[type=text]{background:#e7eade;color:var(--ink);border:1px solid #a3b1a4;padding:10px;border-radius:4px;max-width:55%}.setting input[type=checkbox]{width:23px;height:23px;accent-color:var(--teal)}.hintrow{display:flex;gap:14px;align-items:center;padding:13px 0;border-bottom:1px solid #cbd1c4}.key{min-width:72px;font:800 22px var(--display);color:var(--teal)}.hintrow p{margin:0;font-size:13px}.tiles{display:grid;grid-template-columns:1fr 1fr;gap:13px}.tile{padding:16px;background:#e6e9dd;border-left:4px solid var(--teal);font-size:12px;line-height:1.6}.tile b{font:800 22px var(--display);display:block;text-transform:uppercase}.metadata{display:grid;grid-template-columns:125px 1fr;gap:13px;font-size:14px;line-height:1.6}.metadata dt{font-weight:700}.metadata dd{margin:0;color:#53696a}.feedback p{font-size:15px;margin:5px 0}.roomcode{font:800 46px var(--display);letter-spacing:6px;text-align:center;background:#e4e8db;border:1px dashed #8b9e91;padding:20px;margin:15px 0}.networkstatus{font-size:12px;color:var(--teal);min-height:36px;line-height:1.6}.endScore{font:800 90px var(--display);color:var(--orange);line-height:1;margin:16px 0}.statgrid{display:flex;gap:35px;margin:15px 0 25px}.statgrid b{display:block;font:800 30px var(--display)}.statgrid small{font-size:10px;text-transform:uppercase;letter-spacing:1px}.tiny{font-size:11px!important;color:var(--muted)}#devBadge{display:none;position:absolute;top:58px;left:50%;transform:translateX(-50%);background:var(--yellow);padding:5px 15px;font-size:10px;letter-spacing:2px;z-index:3}.boardcaption{position:absolute;top:16%;right:5%;font:700 13px var(--display);letter-spacing:3px;writing-mode:vertical-rl;color:#8a9b92;z-index:1;pointer-events:none}\n@media(min-width:1700px){.panel{max-width:860px;padding:42px 50px}.panel p,.setting{font-size:18px}.panel .primary{font-size:27px;min-height:62px}.metadata{font-size:13px}}@media(max-width:850px){#topbar{padding:20px 5vw}.edition{display:none}.brand{font-size:20px}#title{padding:100px 6vw 75px}.titlecopy{width:52%}h1{font-size:clamp(65px,11vw,100px)}.subtitle{font-size:13px;max-width:250px}.titleactions{max-width:250px}.primary{font-size:20px;min-height:48px}.secondary{font-size:17px;min-height:40px}.minorlinks{gap:15px;margin-top:20px}.titlebadge{margin-top:20px}.decorlabel{display:none}.hudblock strong{font-size:30px}#stageName{font-size:22px;max-width:110px}.hudleft,.hudright{gap:22px}#hudTop{top:80px}.hudblock small{font-size:9px}.comboNum{font-size:45px}#chargeTip{display:none}#chargebox{width:16vw}#footer{font-size:8px}.panel{max-width:650px;padding:26px}.panel h2{font-size:43px}.boardcaption{display:none}}\n@media(max-width:560px) and (orientation:portrait){#title{align-items:flex-end;padding:75px 7vw 70px;background:linear-gradient(0deg,var(--paper) 0%,#f4f0e5f9 35%,#f4f0e500 83%)}.titlecopy{width:100%;max-width:none}h1{font-size:83px;line-height:.8;margin:0 0 20px}.eyebrow{font-size:9px;margin-bottom:21px}.subtitle{font-size:13px;max-width:310px;margin-bottom:18px}.titleactions{max-width:none;display:grid;grid-template-columns:1fr 1fr;gap:10px}.primary{grid-column:1/-1}.secondary{font-size:16px;padding:12px;gap:8px}.titlebadge,.decorlabel,.buttonhint,.titlecopy>.eyebrow{display:none}.minorlinks{justify-content:space-between;gap:15px}#topbar{padding:18px 6vw}.brand{font-size:18px}.textbutton{font-size:11px}#footer{bottom:18px;left:6vw;right:6vw;letter-spacing:1px}#footer span:last-child{display:none}#hudTop{top:67px;left:6vw;right:6vw}.hudleft,.hudright{flex-direction:row;gap:22px}.hudright .hudblock:last-child{display:none}#stageLabel{font-size:9px}#stageName{font-size:18px;max-width:120px}.hudblock strong{font-size:27px}.lives{font-size:15px}.hudblock small{font-size:8px;letter-spacing:1px}#chargebox{bottom:43px;left:6vw;width:130px}#combo{bottom:42px;right:6vw}.comboNum{font-size:34px}#combo small{font-size:8px}#playPrompt{bottom:17%;min-width:230px}.panel{padding:25px 22px;max-height:90vh}.panel h2{font-size:39px;margin:8px 0 22px}.panel .eyebrow{font-size:9px;letter-spacing:2px}.back{right:17px;top:18px}.panel p{font-size:12px}.setting{font-size:12px;gap:10px}.setting input[type=range]{width:125px}.setting output{font-size:18px}.tiles{grid-template-columns:1fr}.metadata{grid-template-columns:82px 1fr;font-size:10px}.panel h3{font-size:22px}#toast{font-size:20px;max-width:90vw;white-space:normal;text-align:center}#devBadge{top:40px}#chargeButton{font-size:10px;padding:9px}.sliderpack{gap:6px}.hintrow{padding:10px 0}.key{min-width:60px;font-size:18px}.hintrow p{font-size:12px}}\n@media(max-height:650px) and (min-width:561px){#title{padding-top:70px;padding-bottom:45px}h1{font-size:90px;margin:18px 0}.subtitle{margin-bottom:18px;font-size:13px}.titlebadge{display:none}.titleactions{gap:7px}.primary{min-height:43px;padding:10px 16px}.secondary{min-height:37px;padding:9px 16px}.minorlinks{margin-top:17px}#topbar{padding-top:17px}#footer{bottom:16px}.panel{padding:24px 32px;max-height:91vh}.panel h2{font-size:38px;margin:7px 0 18px}#hudTop{top:68px}.hudleft,.hudright{gap:18px}}\n                    )\n                    guest.evaluate(\"__BOUNCEOUT__.online.leave()\")\n                    page.wait_for_timeout(200)\n                    require(\n                        not page.evaluate(\"__BOUNCEOUT__.online.connected\"),\n                        \"host did not detect guest departure\",\n                    )\n                    require(\n                        state(page)[\"phase\"] != \"gameover\",\n                        \"partner departure killed host game\",\n                    )\n                    page.evaluate(\"__BOUNCEOUT__.online.leave()\")\n                finally:\n                    guest.close()\n\n            check(\"two-page online co-op replication and departure\", online_gameplay)\n\n            def file_boot():\n                local = context.new_page()\n                local.route(\"https://**\", lambda route: route.abort())\n                local.route(\"http://**\", lambda route: route.abort())\n                try:\n                    boot(local, HTML.as_uri())\n                    require(\n                        \"webgpu\" in state(local)[\"renderer\"].lower(),\n                        \"file:// did not initialize WebGPU\",\n                    )\n                    action(\n                        local,\n                        \"__BOUNCEOUT__.start('solo'); __BOUNCEOUT__.setAuto(true); __BOUNCEOUT__.launch(); __BOUNCEOUT__.step(5);\",\n                    )\n                    require(\n                        state(local)[\"score\"] > 0,\n                        \"delivered file:// game could not play\",\n                    )\n                finally:\n                    local.close()\n\n            check(\"self-contained file delivery boots and plays offline\", file_boot)\n            context.close()\n\n            mobile = browser.new_context(\n                viewport={\"width\": 390, \"height\": 844},\n                is_mobile=True,\n                has_touch=True,\n                device_scale_factor=1,\n            )\n            mp = mobile.new_page()\n            mobile_errors = []\n            mp.on(\"pageerror\", lambda err: mobile_errors.append(str(err)))\n            boot(mp, url)\n\n            def mobile_flow():\n                require(\n                    mp.evaluate(\n                        \"document.documentElement.scrollWidth <= innerWidth + 1\"\n                    ),\n                    \"mobile page overflows horizontally\",\n                )\n                action(mp, \"__BOUNCEOUT__.start('solo');\")\n                mp.touchscreen.tap(190, 650)\n                mp.wait_for_timeout(300)\n                require(state(mp)[\"balls\"], \"touch did not launch\")\n                require(not mobile_errors, \" | \".join(mobile_errors[:3]))\n\n            check(\"touch viewport and launch\", mobile_flow)\n            mobile.close()\n            spec = importlib.util.spec_from_file_location(\n                \"hub_test\", Path(__file__).with_name(\"hub-test.py\")\n            )\n            hub_tests = importlib.util.module_from_spec(spec)\n            spec.loader.exec_module(hub_tests)\n            hub_tests.run_hub_checks(browser, url, check, require)\n            browser.close()\n    finally:\n        server.shutdown()\n        server.server_close()\n    return 1 if FAILURES else 0\n\n\nif __name__ == \"__main__\":\n    try:\n        code = run()\n    except Exception as exc:  # noqa: BLE001 — collect independent test failures\n        FAILURES.append(f\"FAIL harness: {exc}\")\n        code = 1\n    for failure in FAILURES:\n        print(failure)\n    print(f\"{COUNT} checks; {len(FAILURES)} failures\")\n    raise SystemExit(code)\n\"\"\"AI Hub conformance scenarios; imported by the game's single test command.\"\"\"\n\nfrom pathlib import Path\nimport subprocess\nfrom urllib.parse import quote, urlencode, urlsplit\n\n\nPROJECT = Path(__file__).resolve().parent\nSCENARIOS = (\n    (\"single-player\", 1, \"standard\", 0, 0, 0),\n    (\"two-player\", 2, \"standard\", 60, 20, 0),\n    (\"dedicated server\", 2, \"server\", 60, 20, 0),\n    (\"host departure\", 2, \"host-leave\", 60, 20, 0),\n    (\"lossy network\", 2, \"standard\", 150, 50, 5),\n)\n\n\n\ndef adapter_check(require):\n    script = r\"\"\"\nimport fs from 'node:fs';\nglobalThis.window = globalThis;\nwindow.addEventListener = () => {};\nglobalThis.document = {createElement: () => ({}),head:{appendChild(script) {queueMicrotask(() => script.onerror());}}};\nconst {createOnline} = await import('data:text/javascript;base64,' + Buffer.from(fs.readFileSync('online.js','utf8')).toString('base64'));\nconst require = (ok,msg) => {if(!ok) throw new Error(msg);};\nconst wait = ms => new Promise(r=>setTimeout(r,ms));\nconst seen={hostStart:0,guestStart:0,state:null,input:null,seat:null,left:0,end:''};\nconst host=createOnline({onStart:()=>seen.hostStart++,onInput:(x,seat)=>{seen.input=x;seen.seat=seat;},onLeave:()=>seen.left++});\nconst guest=createOnline({onStart:()=>seen.guestStart++,onState:x=>seen.state=x,onEnd:x=>seen.end=x});\n","exit_code":0,"status":"completed"}}
