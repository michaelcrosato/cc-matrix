hs\": \"ps\", \"shake\": true, \"assist\": false}, \"config\": {\"speed\": 11, \"paddleWidth\": 3.1, \"chargeRate\": 1, \"god\": false, \"auto\": true}, \"ballState\": [{\"x\": 2.4073333740234375, \"y\": -7.80174446105957, \"vx\": 1.0871390104293823, \"vy\": 10.946146965026855, \"docked\": false}], \"paddles\": [{\"x\": 2.123423134793968, \"y\": -9.6, \"seat\": 0, \"width\": 3.1}], \"metrics\": {\"frames\": 13, \"steps\": 614, \"renderErrors\": 0}}, \"errors\": []}\n","exit_code":0,"status":"completed"}}
