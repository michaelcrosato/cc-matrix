{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c90f","stream":{"kind":"session","id":"01a1aa23-73f9-7152-a6b5-3fcdf5d3c2f1"},"sequence":738,"recorded_at":1780531400001471,"record_type":"event","durability":"durable","causation_id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","event":{"chunk":"Read text file `Fit Getaway-Wii Fit-muse-wonder-1.0-max-20261104-221652/src/main.js`.\n(149 line(s) above)\n150|  return action === 'confirm' ? '[Enter]' : action === 'back' ? '[Esc]' : '[P]';\n151|}\n152|// Keyboard lean with smoothing + Shift half lean; mouse lean from pointer offset to dial centre.\n153|export class LeanInput {\n154|  constructor() { this.kx = 0; this.ky = 0; this.mode = 'keys'; this.mx = 0; this.my = 0; }\n155|  read(ctx, dt, dialCX, dialCY) {\n156|    const input = ctx.input;\n157|    const ax = input.moveAxis();\n158|    let tx = 0, ty = 0;\n159|    if (input.isDown('KeyA') || input.isDown('ArrowLeft')) tx -= 1;\n160|    if (input.isDown('KeyD') || input.isDown('ArrowRight')) tx += 1;\n161|    if (input.isDown('KeyW') || input.isDown('ArrowUp')) ty += 1;\n162|    if (input.isDown('KeyS') || input.isDown('ArrowDown')) ty -= 1;\n163|    if (Math.abs(ax.x) > 0.12 || Math.abs(ax.y) > 0.12) { tx = ax.x; ty = -ax.y; this.mode = 'stick'; }\n164|    const half = (input.isDown('ShiftLeft') || input.isDown('ShiftRight')) ? 0.5 : 1;\n165|    tx *= half; ty *= half;\n166|    const atk = dt / 0.10, rel = dt / 0.06;\n167|    const step = (cur, tgt) => cur + clamp(tgt - cur, -(tgt === 0 ? rel : atk) * Math.sign(tgt - cur || 1) * Math.abs(tgt - cur || 1), (tgt === 0 ? rel : atk)) ;\n168|    // simpler exponential smoothing toward target\n169|    const k = 1 - Math.exp(-dt / (tx !== 0 || ty !== 0 ? 0.10 : 0.06));\n170|    if (tx !== 0 || ty !== 0 || this.mode !== 'mouse') { this.kx += (tx - this.kx) * k; this.ky += (ty - this.ky) * k; }\n171|    // Mouse: pointer offset from dial centre / radius, as force.\n172|    try {\n173|      const p = input.pointer;\n174|      if (p && p.over && (Math.abs(input.mouseDelta?.x || 0) > 0 || Math.abs(input.mouseDelta?.y || 0) > 0)) this.mode = 'mouse';\n175|      if (this.mode === 'mouse' && p && dialCX !== undefined) {\n176|        const hud = ctx.hud; const axp = (p.x + 1) / 2 * hud.width, ayp = (1 - p.y) / 2 * hud.height;\n177|        const R = App.tunables.mouseLeanRadius;\n178|        this.mx = clamp((axp - dialCX) / R, -1, 1); this.my = clamp(-(ayp - dialCY) / R, -1, 1);\n179|        const d = Math.hypot(this.mx, this.my); if (d > 1) { this.mx /= d; this.my /= d; }\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1aa25-ad7c-7a60-96c8-183decbf9ec0"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","kind":"run"},"task_id":"01a1aa25-ad7c-7a60-96c8-183decbf9ec0","task_stream":{"id":"01a1aa25-ad7c-7a60-96c8-183decbf9ec0","kind":"task"}}}
