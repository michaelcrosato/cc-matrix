{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf89","stream":{"kind":"session","id":"01a1aa23-73f9-7152-a6b5-3fcdf5d3c2f1"},"sequence":1567,"recorded_at":1780531400003129,"record_type":"event","durability":"durable","causation_id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","event":{"chunk":"Read text file `Fit Getaway-Wii Fit-muse-wonder-1.0-max-20261104-221652/src/main.js`.\n(419 line(s) above)\n420|    // Attract after 10s idle on title/menus.\n421|    if (App.idleTime > 10 && !App.session) { App.idleTime = 0; void goTo(ctx, new ActivityGame('still-tree', { attract: true, playlistIdx: 0 }), CAM.lane3); return; }\n422|    const hud = ctx.hud; hud.clear(); if (App.hideHud) return;\n423|    drawCentered(hud, 18, TITLE, { color: 'white', scale: 3 });\n424|    drawCentered(hud, 42, TAGLINE + '  Press any button. Gently.', { color: 'sand', scale: 1 });\n425|    if (touchOnlyDevice()) { drawCentered(hud, 58, 'Controller or keyboard required', { color: 'orange', scale: 1 }); drawCentered(hud, 68, 'Attract mode will run. Tap to return here.', { color: 'white', scale: 1 }); }\n426|    if (this.mode === 'name') {\n427|      drawCentered(hud, 80, 'Name entry (type, 8 max): ' + this.nameText, { color: 'white', scale: 1 });\n428|      drawCentered(hud, 94, 'Avatar ' + (this.avatarIdx + 1) + '/6 — Left/Right to change', { color: 'cyan', scale: 1 });\n429|      drawCentered(hud, 108, glyphFor('confirm') + ' Start week    ' + glyphFor('back') + ' Back', { color: 'sand', scale: 1 });\n430|      try {\n431|        for (const e of (ctx.input.buttonEvents || [])) { /* clicks handled below */ }\n432|      } catch { /* ignore */ }\n433|      if (ctx.input.wasPressed('ArrowLeft')) this.avatarIdx = (this.avatarIdx + 5) % 6;\n434|      if (ctx.input.wasPressed('ArrowRight')) this.avatarIdx = (this.avatarIdx + 1) % 6;\n435|      if (confirmPressed(ctx)) {\n436|        const s = newSlot(this.nameText.slice(0, 8) || 'Guest', this.avatarIdx); App.data.slots[App.slotIndex] = s; App.persist();\n437|        void goTo(ctx, new WeighInGame({ intro: true }), CAM.weighin);\n438|      }\n439|      if (backPressed(ctx)) { this.mode = 'slots'; this.buildMenu(); }\n440|      return;\n441|    }\n442|    if (this.mode === 'settings') { this.drawSettings(ctx); return; }\n443|    if (this.mode === 'about') { this.drawAbout(ctx); return; }\n444|    this.menu.draw(hud, 24, 78, { scale: 1, gap: 13, width: Math.min(300, hud.width - 40) });\n445|    drawCentered(hud, hud.height - 16, `${glyphFor('confirm')} Confirm   ${glyphFor('back')} Back   Lean: stick / WASD / mouse`, { color: 'mist', scale: 1 });\n446|    const pick = this.menu.update(ctx, dt);\n447|    if (pick) this.onPick(ctx, pick);\n448|    if (backPressed(ctx) && this.mode !== 'main') { this.mode = 'main'; this.buildMenu(); }\n449|  }\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1aa29-2ab5-78d1-b3a9-ffb38433c2e3"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","kind":"run"},"task_id":"01a1aa29-2ab5-78d1-b3a9-ffb38433c2e3","task_stream":{"id":"01a1aa29-2ab5-78d1-b3a9-ffb38433c2e3","kind":"task"}}}
