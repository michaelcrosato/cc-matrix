{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc5b","stream":{"kind":"session","id":"01a1aa23-73f9-7152-a6b5-3fcdf5d3c2f1"},"sequence":1160,"recorded_at":1780531400002315,"record_type":"event","durability":"durable","causation_id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","event":{"chunk":"Read text file `Fit Getaway-Wii Fit-muse-wonder-1.0-max-20261104-221652/src/main.js`.\n(1204 line(s) above)\n1205|  }\n1206|  cameraTarget() { return new Vector3(0, 1.15, 0); }\n1207|  status() { return `activity ${this.act.id} | ${this.phase} | t ${this.playT.toFixed(1)} | score ${Math.round(this.score || this.computeScore(this.local || { dot: { x: 0, y: 0 }, frames: 1, inFrames: 0 } ))} device ${App.device}`; }\n1208|  fingerprint(ctx) { const l = this.local; return l ? `act:${this.act.id}:${this.computeScore(l)}:${l.dot.x.toFixed(3)},${l.dot.y.toFixed(3)}` : `act:${this.act.id}:none`; }\n1209|}\n1210|function coachLineFor(a) { return { still: 'You are a tree. A tree does not check its phone.', reps: 'Good. Again. That was also good. Again.', hoop: 'Circles. Small, smug circles.', step: 'On the beat. The floor is your friend.', header: 'Head the coconut. Not the flip-flop.', slack: 'Walk when steady. Stop to recover.', tray: 'Tilt gently. The tray believes in you.', jog: 'Alternate feet. I shall pace you.', pier: 'Tuck. Leap. Cannonball, if you must.', longstand: 'Stand.' }[a.kind] || 'Stand.'; }\n1211|function goalLineFor(a) { if (a.kind === 'still') return `Hold the Dot in the ring for ${a.hold}s.`; if (a.kind === 'reps') return `Match the tempo for ${a.reps} reps. (Plus two. Coach lies.)`; if (a.kind === 'hoop') return 'Keep the hoop up for 60s.'; if (a.kind === 'step') return 'Step on the beat at 104 BPM.'; if (a.kind === 'header') return 'Head coconuts. Dodge flip-flops.'; if (a.kind === 'slack') return 'Cross 30m. Stopping to recover is wise.'; if (a.kind === 'tray') return 'Roll vitamins into matching cups.'; if (a.kind === 'jog') return 'Jog the island. Alternate feet.'; if (a.kind === 'pier') return 'Three attempts. Jump far.'; return 'Stand still for 90s.'; }\n1212|function controlLineFor(a) { return 'Lean: stick / WASD / mouse. ' + (a.breath ? 'Breathe: hold Space/R2. ' : '') + (a.kind === 'step' || a.kind === 'jog' ? 'Feet: F/J or L1/R1.' : ''); }\n1213|function longStandCaption(t) { if (t < 10) return 'Coach: Stand.'; if (t < 20) return 'Kevin lands on your head.'; if (t < 30) return 'Dennis sneezes.'; if (t < 45) return 'Light rain. Noise rises.'; if (t < 55) return 'Marguerite applauds, slowly. Ounce: Ignore her.'; if (t < 65) return 'June: Are you nearly done?'; if (t < 75) return 'Kettlebell Volcano rumbles.'; if (t < 85) return 'Rain stops. Sun out.'; return 'Coach: You may blink.'; }\n1214|\n1215|\n1216|\n1217|\n1218|","final_result":true,"kind":"output","task_id":"01a1aa27-c7e6-7950-ae4b-9a70cb601825"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","kind":"run"},"task_id":"01a1aa27-c7e6-7950-ae4b-9a70cb601825","task_stream":{"id":"01a1aa27-c7e6-7950-ae4b-9a70cb601825","kind":"task"}}}
