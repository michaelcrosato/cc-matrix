iginal_output_bytes\": 1223,\n  \"original_output_tokens\": 306,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a1aa26-6106-7911-8b22-d781bd533ca8"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa23-76a1-7912-8c1f-0bbd20af817a","kind":"run"},"task_id":"01a1aa26-6106-7911-8b22-d781bd533ca8","task_stream":{"id":"01a1aa26-6106-7911-8b22-d781bd533ca8","kind":"task"}}}
