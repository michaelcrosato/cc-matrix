hips(win); R.last.unshift(n); R.last = R.last.slice(0, 10); this.msg = n + (n === 0 || n === 37 ? ' GREEN' : G.REDS.has(n) ? ' RED' : ' BLACK') + (win ? '  · you win ' + win + ' chips' : ''); if (win) G.sfx('cash'); R.bets = []; G.say('kai', win ? 'Nice one. The wheel likes you.' : 'Wheel giveth, wheel taketh.', { auto: 2, modal: false }); }","+      if (u >= 1) { R.phase = 'bet'; const n = R.result; let win = 0; for (const b of R.bets) win += G.roulettePay(b, n) * b.chips; this.addChips(win); R.last.unshift(n); R.last = R.last.slice(0, 10); this.msg = n + (n === 0 || n === 37 ? ' GREEN' : G.REDS.has(n) ? ' RED' : ' BLACK') + (win ? '  • you win ' + win + ' chips' : ''); if (win) G.sfx('cash'); R.bets = []; G.say('kai', win ? 'Nice one. The wheel likes you.' : 'Wheel giveth, wheel taketh.', { auto: 2, modal: false }); }","       return;","     }","     if (I.pressed('cancel')) { if (R.bets.length) { for (const b of R.bets) this.addChips(b.chips); R.bets = []; } return this.leave(); }"]},{"oldStart":19133,"oldLines":8,"newStart":19133,"newLines":8,"lines":["       for (let row = 0; row < 3; row++) { const f = Sl.pos[k], idx = Math.floor(f) + row - 1, frac = Sl.spin[k] ? f % 1 : 0, sym = G.SLOT_STRIPS[k][(idx + 21) % 21], y = y0 + row * rh - frac * rh; if (y < y0 - 4 || y > y0 + rh * 2 + 4) continue; G.slotIcon(g, x + cw / 2, y + rh / 2, sym, Sl.spin[k]); }","       if (Sl.spin[k]) px.blend(g, .3, 'normal', () => { for (let yy = 0; yy < rh * 3; yy += 3) px.rect(g, x, y0 + yy, cw, 1, '#a0a0b0'); }); }","     for (let b = 0; b < 3; b++) for (const L of G.SLOT_LINES[b]) { const on = b < Sl.bet, won = Sl.win && Sl.win.lines.includes(L), y = (row) => y0 + row * rh + rh / 2; if (!on) continue; px.line(g, x0 - 6, y(L[0]), x0 + 3 * (cw + 6) + 2, y(L[2]), won ? '#ffd36a' : '#ff5fa255', won ? 2 : 1); }","-    E.font.text(g, 'Bet ' + Sl.bet + (Sl.bet === 1 ? ' · centre line' : Sl.bet === 2 ? ' · three lines' : ' · five lines'), W / 2, y0 + 3 * rh + 16, '#fff8e8', { align: 'cente