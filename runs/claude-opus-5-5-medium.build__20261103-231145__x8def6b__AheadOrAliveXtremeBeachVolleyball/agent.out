 + .8, h * .55, C.dk); px.ell(g, ex + sd * h * .15, ey - h * .5, w, h * .5 - .6, C.base); px.ell(g, ex + sd * h * .15, ey - h * .45, Math.max(.6, w * .45), h * .32, C.inner || '#f5a3b8');\n4930:    px.ell(g, cx, cy, rx, ry, C.dk);\n4931:    px.ell(g, cx + .5, cy - .8, Math.max(1, rx - 1.2), Math.max(1, ry - 1.3), C.base);\n4932:    px.ell(g, cx - rx * .15, cy + ry * .35, Math.max(1, rx * .7), Math.max(.6, ry * .3), tb.sh);\n4933:    px.ell(g, cx + rx * .3, cy - ry * .42, Math.max(1, rx * .38), Math.max(.6, ry * .28), C.lt);\n313:   world, under the overlays; rot(spr, a, steps): a sprite turned (section 2b); frame(game, shx, shy): a split screen's\n529: * the game's time by default); a.frame(t) is the sprite at time t, a.index(t) its number, a.duration one play (seconds)\n1860:    if (spr && spr.isAnim) spr = spr.frame(o.t === undefined ? this.game.time : o.t);\n2338:     *  or nears the screen's edge (side-scrollers); frame(targets, { margin: 24, zoom: [min, max] or false }) keeps\n2340:     *  when they spread apart, until frame(null); free: a free camera (strategy, sims, board games): true or { keys: true,\n2939:    if (this._split && HOOKS.frame) HOOKS.frame(this, shx, shy);   // a split screen: the scene drawn in each viewport (section 10j)\n3630: * 10i. CAMERA WINDOW AND FRAMING  game.cam.window (a dead zone), cam.snapY (height on landing), cam.frame(targets)\n12400:      const sp = spr.isAnim ? spr.frame(o.t === undefined ? this._t : o.t) : spr, s = k * (o.scale || 1), w = sp.w * s, h = sp.h * s; if (w < .5) return;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KZbDwP78VTExSPYz1DJGK5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
