ve: Xtreme Beach Volleyball', tagline: 'Stay ahead. Stay alive. Stay tanned.', description: 'A five-day island vacation of 2-on-2 beach volleyball, friendships, swimsuit shopping, pool hopping and casino nights, ending with a match for the island against its owner.', type: 'Game', genre: 'Sports', source: 'Dead or Alive Xtreme Beach Volleyball', series: 'Dead or Alive', players: '1–4', controls: 'Stick/WASD move · Cross/Space/click hit on time · Square/E shot and block · Circle/Shift dive · Triangle/Q call', tags: ['sports', 'versus', 'co-op', 'pixel art', 'comedy', 'arcade'] }\n};\nconst path = new URL('../../exit-interview.json', import.meta.url);\nwriteFileSync(path, JSON.stringify(out, null, 2) + '\\n');\nconst back = JSON.parse(readFileSync(path, 'utf8'));\nconst empty = []; const walk = (o, k) => { if (typeof o === 'string') { if (!o.trim()) empty.push(k); } else if (Array.isArray(o)) o.forEach((v, i) => walk(v, k + '[' + i + ']')); else for (const kk in o) walk(o[kk], k + '.' + kk); };\nwalk(back, 'root'); console.log('parses; empty fields:', empty.length, 'testing', back.testingFeedback.length, 'engine', back.engineFeedback.length, 'prompt', back.promptFeedback.length);\nEOF\nnode .tmp/exit.mjs && node -e \"JSON.parse(require('fs').readFileSync('../exit-interview.json','utf8')); console.log('ok')\"","description":"Write and validate exit-interview.json"}}}
