e);","+  // an idle human loses; a perfect bot beats Easy CPUs","+  G.game.settings.set('difficulty', 'Easy');","+  const idle = runMatch(game, G, { mode: 'exhibition', pointsToWin: 7, difficulty: 'Easy', teams: [[{ id: 'rin', suit: 'seigaiha', acc: [], input: game.input }, { id: 'lola', suit: 'estrella', acc: [], base: .3 }], [{ id: 'tess', suit: 'reefbreak', acc: [], base: .5 }, { id: 'mei', suit: 'peony', acc: [], base: .5 }]] }).res;","+  t('an idle human loses', idle && idle.winner === 1, idle && idle.finalScore);","+  let wins = 0; for (let s = 0; s < 3; s++) { G.seed('match', 40 + s); const r = runMatch(game, G, { mode: 'exhibition', pointsToWin: 7, difficulty: 'Easy', teams: [[{ id: 'rin', suit: 'seigaiha', acc: [], input: game.input }, { id: 'lola', suit: 'estrella', acc: [], base: .5 }], [{ id: 'tess', suit: 'reefbreak', acc: [], base: .4 }, { id: 'mei', suit: 'peony', acc: [], base: .4 }]] }, { bot: true }).res; if (r && r.winner === 0) wins++; }","+  t('a perfect bot beats Easy (2 of 3 or better)', wins >= 2, wins);","+  // the final's Golden Glare hides the ring for a receiver without sunglasses","+  const M = new G.Match({ mode: 'final', specials: { glare: true }, teams: [[{ id: 'rin', suit: 'seigaiha', acc: [], input: game.input }, { id: 'lola', suit: 'estrella', acc: [] }], [{ id: 'sonny', suit: 'house_sonny', acc: ['aviators'] }, { id: 'pepper', suit: 'pinstripe', acc: [] }]] });","+  t('glare flags shades', !M.players[0].rig.acc.some(a => G.ITEMS[a].shades) && M.players[2].rig.acc.some(a => G.ITEMS[a].shades));","+  t('no errors in matches', game.errors.length === 0, game.errors.map(e => e.message + ' ' + (e.stack || '').split('\\n')[1]).join(' | '));","+};"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/06-vacation.test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":29,"lines":["+import { load } from '../lib/load.mjs';","+export default async t => {","+  const { G, game } = load(); game.advance(.5); const T = game.debug.tools;","+  const S = T.newVacation('rin', 11);","+  t('day 1 morning', S.day === 1 && S.slot === 0); t('five NPCs with affinity', Object.keys(S.affinity).length === 5);","+  t('weather table day 3 rain afternoon', G.WEATHER_TABLE[3][1] === 'rain');","+  t('a pair at the beach by day', S.teams.some(tm => S.where[tm[0]] === 'beach' && S.where[tm[1]] === 'beach'));","+  const same = JSON.stringify(S.where); G.scheduleSlot(); t('same seed, same places', JSON.stringify(S.where) === same);","+  t('teams go together', S.teams.every(tm => S.where[tm[0]] === S.where[tm[1]]));","+  // gifts","+  S.bag = { plush_seal: 1, energy_drink: 1, hot_sauce: 1 }; S.mood.mei = 'normal'; S.mood.lola = 'normal';","+  const a0 = G.aff('mei'), r1 = G.giveGift('mei', 'plush_seal'); t('a liked gift is accepted', r1.accepted && G.aff('mei') > a0, JSON.stringify(r1));","+  t('one gift a slot', !G.canGift('mei'));","+  S.affinity.lola = 10; S.mood.lola = 'gloomy'; const r2 = G.giveGift('lola', 'energy_drink'); t('a neutral gift to a gloomy stranger is refused', !r2.accepted && S.bag.energy_drink === 1, JSON.stringify(r2));","+  t('known likes are recorded', S.known.mei.plush_seal === 'like');","+  // invites","+  S.affinity.tess = 10; S.mood.tess = 'normal'; t('a stranger declines', !G.invite('tess').ok);","+  S.affinity.tess = 70; const inv = G.invite('tess'); t('a friend teams up', inv.ok && S.partner === 'tess');","+  // slots and days","+  G.endSlot('test'); t('the slot advances', S.slot === 1);","+  S.slot = 2; S.lostToday = true; S.affinity.tess = 20; game.advance(.1); G.nextDay(); t('a partner who lost and likes you less than 35 walks', S.partner === null && S.day === 2);","+  // money","+  const m0 = S.money; G.earn(1000); t('prize money with prizeMul', S.money === m0 + 1000); t('cannot overspend', !G.spend(S.money + 1));","+  // save and load in the middle of a day","+  G.setupSaves(); S.slot = 1; S.money = 12345; game.saves.save(0); G.state = null; game.saves.load(0); t('save and load mid-slot', G.state && G.state.money === 12345 && G.state.slot === 1 && G.state.day === 2);","+  // the vacation match flow pays and moves on","+  const S2 = G.state; S2.partner = 'mei'; const cfg = G.vacationMatchCfg(['lola', 'tess']); t('a vacation match config', cfg.teams[0][1].id === 'mei' && cfg.partnerAff === G.aff('mei'));","+  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));","+};"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/07-casino.test.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":15,"lines":["+import { load } from '../lib/load.mjs';","+export default async t => {","+  const { G } = load();","+  let paid = 0, n = 0; for (let a = 0; a < 21; a++) for (let b = 0; b < 21; b++) for (let c = 0; c < 21; c++) { paid += G.slotWin([a, b, c], 1).win; n++; }","+  const rtp = paid / n; t('slots return 89-95% (exact over every stop)', rtp >= .89 && rtp <= .95, rtp);","+  t('7-7-7 pays 100', G.slotLine('7', '7', '7') === 100); t('Sonny is wild', G.slotLine('BAR', 'SONNY', 'BAR') === 30); t('one cherry pays 2', G.slotLine('CHERRY', 'COCO', 'PALM') === 2);","+  t('roulette straight pays 35:1', G.roulettePay({ kind: 'num', v: 17 }, 17) === 36); t('red pays 1:1', G.roulettePay({ kind: 'red' }, 1) === 2 && G.roulettePay({ kind: 'red' }, 2) === 0);","+  t('dozens pay 2:1', G.roulettePay({ kind: 'dozen', v: 2 }, 20) === 3); t('columns', G.roulettePay({ kind: 'col', v: 1 }, 34) === 3); t('zero loses outside bets', G.roulettePay({ kind: 'even' }, 0) === 0);","+  t('wheel order', G.WHEEL.length === 37 && G.WHEEL[1] === 32 && new Set(G.WHEEL).size === 37);","+  G.seed('casino', 1); const counts = new Array(37).fill(0); for (let i = 0; i < 37000; i++) counts[G.WHEEL[Math.floor(G.rng('casino') * 37)]]++; const chi = counts.reduce((a, c) => a + (c - 1000) ** 2 / 1000, 0); t('wheel results uniform (chi-square)', chi < 80, chi);","+  const BJ = G.BJ, h = (...r) => r.map(x => ({ r: x, s: '♠' }));","+  t('blackjack values', BJ.value(h('A', 'K')).v === 21 && BJ.bj(h('A', 'K')) && BJ.value(h('A', 'A', '9')).v === 21 && BJ.value(h('K', 'Q', '5')).v === 25);","+  t('soft 17 is soft', BJ.value(h('A', '6')).soft && BJ.value(h('A', '6')).v === 17);","+  BJ.newShoe(); t('six-deck shoe', BJ.shoe.length === 312);","+};"]}],"created":true}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/lib/bots.mjs","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/05-match.test.mjs","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/06-vacation.test.mjs","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145/test/suites/07-casino.test.mjs"]}},"tool_result_meta":[{"id":"toolu_01RUKYB1mH16T8cmDzNh9a4t","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghU4rgwVFBk9irA6XnEm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0146K6Shctw9sKvqTkCfBsvF","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145; cat > test/suites/08-poolhop.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(.5); game.debug.tools.newVacation('lola', 4);\n  G.poolBot = true; G.go('poolhop', null, { fade: 0 }); game.advance(.1); const P = G.SCENES.poolhop;\n  for (let i = 0; i < 60 && P.state !== 'end'; i++) game.advance(1);\n  t('a perfect bot clears under the time', P.won && P.k === 32, P.k + ' ' + P.state + ' left ' + P.timeLeft);\n  t('all PERFECT, no falls', P.perfects === 32 && P.falls === 0, P.perfects + '/' + P.falls);\n  t('prize formula', P.prize === Math.round((2000 + 400 * 32 + 150 * P.timeLeft) / 100) * 100 * 1, P.prize);\n  G.poolBot = false; G.go('poolhop', null, { fade: 0 }); game.advance(.1); const Q = G.SCENES.poolhop;\n  // a wrong-button bot: press the button after the right one, on the beat\n  for (let s = 0; s < 120 * 12 && Q.falls === 0; s++) { if (Q.state === 'play') { const due = (Q.startBeat + Q.k + 1 + Q.offset) * Q.spb; if (Math.abs(Q.clock - due) < 1 / 240) game.input.tap(G.HOPS[(Q.padNeed(Q.k)[0] + 1) % 4]); } game.advance(1 / 120); }\n  t('a wrong button falls', Q.falls >= 1);\n  for (let s = 0; s < 120 * 5; s++) game.advance(1 / 120);\n  t('and recovers to play on', Q.state === 'play' || Q.state === 'wait', Q.state);\n  t('double pads need two buttons', G.SCENES.poolhop.pads[25].need.length === 2 && G.SCENES.poolhop.pads[5].need.length === 1);\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n};\nEOF\ncat > test/suites/09-ui.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(.5); const I = game.input;\n  I.use(G.INPUT.MATCH);\n  I.lastDevice = 'gamepad'; game.settings.set('glyphs', 'playstation'); t('PlayStation glyph for play', G.btn('play') === '✕', G.btn('play'));\n  game.settings.set('glyphs', 'xbox'); t('Xbox glyph after the setting', G.btn('play') === 'A', G.btn('play'));\n  I.lastDevice = 'keyboard'; t('keycaps on a keyboard', G.btn('play') === 'Space', G.btn('play'));\n  I.lastDevice = 'mouse'; t('mouse button for the mouse', /click/i.test(G.btn('play')), G.btn('play'));\n  game.settings.set('glyphs', 'playstation');\n  t('Button symbols setting defaults to PlayStation', game.settings.spec('glyphs').value === 'playstation' && game.settings.spec('glyphs').group === 'Game');\n  // focus: d-pad moves, hover focuses, click activates\n  G.go('menu', null, { fade: 0 }); game.advance(.2); const m = G.SCENES.menu;\n  I.tap('down'); game.advance(.05); t('the d-pad moves the focus', m.focus.i === 1, m.focus.i);\n  const L = m.layout(), it = L[3]; I.feed('move', it.x + 5, it.y + 5); game.advance(.05); t('hover moves the focus', m.focus.i === 3, m.focus.i);\n  I.feed('down', it.x + 5, it.y + 5); I.feed('up', it.x + 5, it.y + 5); game.advance(.2); t('a click activates', game.sceneName === G.SCENES.menu.items()[3].id || game.sceneName !== 'menu', game.sceneName);\n  t('pause actions list Dev Mode', G.pauseItems().filter(Boolean).some(a => a[0] === 'Dev Mode') && G.pauseItems().filter(Boolean).some(a => a[0] === 'How to Play'));\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n};\nEOF\ncat > test/suites/10-attract.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(1);\n  G.go('title', null, { fade: 0 }); game.advance(.5); G.attract.reset();\n  game.advance(9.4); t('9.9 s idle stays on the title', !G.attract.active && game.sceneName === 'title');\n  game.advance(.7); t('10 s idle starts the attract', G.attract.active, G.attract.idle);\n  game.advance(2); t('it plays a match first', game.sceneName === 'match' && G.M.spectacle);\n  const seen = [];\n  for (let s = 0; s < 120; s++) { game.advance(1); const b = G.attract.BEATS[G.attract.beat].id; if (seen[seen.length - 1] !== b) seen.push(b); }\n  t('then the montage beats in order', seen.join(',').includes('map,gift,shop,poolhop,casino,photo,final'), seen.join(','));\n  game.input.tap('confirm'); game.advance(1);\n  t('any input returns to the title', !G.attract.active && game.sceneName === 'title', game.sceneName);\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message + (e.stack || '').split('\\n')[1]).join(' | '));\n};\nEOF\ncat > test/suites/11-dev.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(.5); const T = game.debug.tools;\n  T.newVacation('rin', 2); G.go('location', { loc: 'beach' }, { fade: 0 }); game.advance(.3);\n  G.dev.open(); game.advance(.1); t('Dev Mode opens and freezes time', G.overlay.has('dev') && game.timeScale === 0);\n  G.dev.tab = 5; G.dev.focus.i = 2; game.advance(.05); const row = G.dev.focus.cur; t('the Tuning tab lists sliders', row && row.kind === 'slider', row && row.label);\n  const k0 = row.key, v0 = G.T[k0]; game.input.tap('right'); game.advance(.05); t('a slider changes G.T live', G.T[k0] !== v0, k0 + ' ' + v0 + ' -> ' + G.T[k0]);\n  G.resetTuning(); t('reset restores defaults', G.T[k0] === v0);\n  // gravity changes the flight time\n  const B = G.Ball, L1 = B.make(0, [0, 0, 20], [0, 0, 150]); G.T.ballGravity = 450; const L2 = B.make(0, [0, 0, 20], [0, 0, 150]); G.resetTuning();\n  t('gravity changes the flight', L2.tLand < L1.tLand);\n  game.input.tap('cancel'); game.advance(.1); t('Back restores time', !G.overlay.has('dev') && game.timeScale === 1);\n  T.match({ opp: ['lola', 'tess'] }); game.advance(1); t('jump tools land in the right scenes', game.sceneName === 'match');\n  T.forcePoint(0); game.advance(.1); t('force a point', G.M.score[0] === 1, G.M.score);\n  T.goto('poolhop'); game.advance(.2); t('goto Pool Hop', game.sceneName === 'poolhop');\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n};\nEOF\necho ok","description":"Write poolhop, ui, attract and dev suites"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4830,"cache_read_input_tokens":642019,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4830},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7b48fecc-086c-4274-afae-e17752649adf","uuid":"2658f330-9096-4939-b604-5181a245de1a","timestamp":"2026-11-04T07:09:00.657Z","request_id":"req_011CghU4rP5WvwCEiRQxzxeY","wire_tool_inputs":{"toolu_0146K6Shctw9sKvqTkCfBsvF":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-231145__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-opus-5-5-medium-20261103-231145; cat > test/suites/08-poolhop.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(.5); game.debug.tools.newVacation('lola', 4);\n  G.poolBot = true; G.go('poolhop', null, { fade: 0 }); game.advance(.1); const P = G.SCENES.poolhop;\n  for (let i = 0; i < 60 && P.state !== 'end'; i++) game.advance(1);\n  t('a perfect bot clears under the time', P.won && P.k === 32, P.k + ' ' + P.state + ' left ' + P.timeLeft);\n  t('all PERFECT, no falls', P.perfects === 32 && P.falls === 0, P.perfects + '/' + P.falls);\n  t('prize formula', P.prize === Math.round((2000 + 400 * 32 + 150 * P.timeLeft) / 100) * 100 * 1, P.prize);\n  G.poolBot = false; G.go('poolhop', null, { fade: 0 }); game.advance(.1); const Q = G.SCENES.poolhop;\n  // a wrong-button bot: press the button after the right one, on the beat\n  for (let s = 0; s < 120 * 12 && Q.falls === 0; s++) { if (Q.state === 'play') { const due = (Q.startBeat + Q.k + 1 + Q.offset) * Q.spb; if (Math.abs(Q.clock - due) < 1 / 240) game.input.tap(G.HOPS[(Q.padNeed(Q.k)[0] + 1) % 4]); } game.advance(1 / 120); }\n  t('a wrong button falls', Q.falls >= 1);\n  for (let s = 0; s < 120 * 5; s++) game.advance(1 / 120);\n  t('and recovers to play on', Q.state === 'play' || Q.state === 'wait', Q.state);\n  t('double pads need two buttons', G.SCENES.poolhop.pads[25].need.length === 2 && G.SCENES.poolhop.pads[5].need.length === 1);\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n};\nEOF\ncat > test/suites/09-ui.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(.5); const I = game.input;\n  I.use(G.INPUT.MATCH);\n  I.lastDevice = 'gamepad'; game.settings.set('glyphs', 'playstation'); t('PlayStation glyph for play', G.btn('play') === '✕', G.btn('play'));\n  game.settings.set('glyphs', 'xbox'); t('Xbox glyph after the setting', G.btn('play') === 'A', G.btn('play'));\n  I.lastDevice = 'keyboard'; t('keycaps on a keyboard', G.btn('play') === 'Space', G.btn('play'));\n  I.lastDevice = 'mouse'; t('mouse button for the mouse', /click/i.test(G.btn('play')), G.btn('play'));\n  game.settings.set('glyphs', 'playstation');\n  t('Button symbols setting defaults to PlayStation', game.settings.spec('glyphs').value === 'playstation' && game.settings.spec('glyphs').group === 'Game');\n  // focus: d-pad moves, hover focuses, click activates\n  G.go('menu', null, { fade: 0 }); game.advance(.2); const m = G.SCENES.menu;\n  I.tap('down'); game.advance(.05); t('the d-pad moves the focus', m.focus.i === 1, m.focus.i);\n  const L = m.layout(), it = L[3]; I.feed('move', it.x + 5, it.y + 5); game.advance(.05); t('hover moves the focus', m.focus.i === 3, m.focus.i);\n  I.feed('down', it.x + 5, it.y + 5); I.feed('up', it.x + 5, it.y + 5); game.advance(.2); t('a click activates', game.sceneName === G.SCENES.menu.items()[3].id || game.sceneName !== 'menu', game.sceneName);\n  t('pause actions list Dev Mode', G.pauseItems().filter(Boolean).some(a => a[0] === 'Dev Mode') && G.pauseItems().filter(Boolean).some(a => a[0] === 'How to Play'));\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n};\nEOF\ncat > test/suites/10-attract.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(1);\n  G.go('title', null, { fade: 0 }); game.advance(.5); G.attract.reset();\n  game.advance(9.4); t('9.9 s idle stays on the title', !G.attract.active && game.sceneName === 'title');\n  game.advance(.7); t('10 s idle starts the attract', G.attract.active, G.attract.idle);\n  game.advance(2); t('it plays a match first', game.sceneName === 'match' && G.M.spectacle);\n  const seen = [];\n  for (let s = 0; s < 120; s++) { game.advance(1); const b = G.attract.BEATS[G.attract.beat].id; if (seen[seen.length - 1] !== b) seen.push(b); }\n  t('then the montage beats in order', seen.join(',').includes('map,gift,shop,poolhop,casino,photo,final'), seen.join(','));\n  game.input.tap('confirm'); game.advance(1);\n  t('any input returns to the title', !G.attract.active && game.sceneName === 'title', game.sceneName);\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message + (e.stack || '').split('\\n')[1]).join(' | '));\n};\nEOF\ncat > test/suites/11-dev.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async t => {\n  const { G, game } = load(); game.advance(.5); const T = game.debug.tools;\n  T.newVacation('rin', 2); G.go('location', { loc: 'beach' }, { fade: 0 }); game.advance(.3);\n  G.dev.open(); game.advance(.1); t('Dev Mode opens and freezes time', G.overlay.has('dev') && game.timeScale === 0);\n  G.dev.tab = 5; G.dev.focus.i = 2; game.advance(.05); const row = G.dev.focus.cur; t('the Tuning tab lists sliders', row && row.kind === 'slider', row && row.label);\n  const k0 = row.key, v0 = G.T[k0]; game.input.tap('right'); game.advance(.05); t('a slider changes G.T live', G.T[k0] !== v0, k0 + ' ' + v0 + ' -> ' + G.T[k0]);\n  G.resetTuning(); t('reset restores defaults', G.T[k0] === v0);\n  // gravity changes the flight time\n  const B = G.Ball, L1 = B.make(0, [0, 0, 20], [0, 0, 150]); G.T.ballGravity = 450; const L2 = B.make(0, [0, 0, 20], [0, 0, 150]); G.resetTuning();\n  t('gravity changes the flight', L2.tLand < L1.tLand);\n  game.input.tap('cancel'); game.advance(.1); t('Back restores time', !G.overlay.has('dev') && game.timeScale === 1);\n  T.match({ opp: ['lola', 'tess'] }); game.advance(1); t('jump tools land in the right scenes', game.sceneName === 'match');\n  T.forcePoint(0); game.advance(.1); t('force a point', G.M.score[0] === 1, G.M.score);\n  T.goto('poolhop'); game.advance(.2); t('goto Pool Hop', game.sceneName === 'poolhop');\n  t('no errors', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n};\nEOF\necho ok","description":"Write poolhop, ui, attract and dev suites"}}}
