', cam: [352, 240], caption: 'DAY 4 • THE SEMIFINAL', cast: [{ id: S.me, x: 320, y: 250, f: 0 }, { id: partner, x: 300, y: 262, f: 0 }, { id: best[0], x: 390, y: 244, f: Math.PI }, { id: best[1], x: 410, y: 258, f: Math.PI }, { id: 'sonny', x: 352, y: 200, f: Math.PI / 2 }],","     steps: [['say', 'sonny', 'SEMIFINAL TIME! The best record on the island wants a piece of YOU!'], ['say', best[0], G.LINES[best[0]].taunt[0]], ['say', best[1], G.LINES[best[1]].taunt[1]], ['say', partner, 'Let\\'s show them.']],","     then: () => G.startMatch(G.vacationMatchCfg(best, { partner, title: 'SEMIFINAL', base: [.74, .74], prize: 30000, losePrize: 5000, onResult: won => { S.flags.semiDone = true; S.flags.seeded = won; }, next: () => G.endSlot('match') })) });"," };"]},{"oldStart":18920,"oldLines":7,"newStart":18920,"newLines":7,"lines":["       if (this.state === 'count') { const n = Math.max(1, Math.ceil(this.startBeat - beat)); E.font.title(g, n > 3 ? 'READY' : String(n), W / 2, Math.round(H * .3), { scale: 3, align: 'center', colors: ['#fff7d6', '#ffd36a', '#ff9e5e'] }); }","       if (this.judge) { this.judge.t += 1 / 60; if (this.judge.t < .6) E.font.text(g, this.judge.q, W / 2, Math.round(H * .22), this.judge.q === 'PERFECT' ? '#ffd36a' : this.judge.q === 'GOOD' ? '#5ff0ff' : '#9ff3e8', { scale: 2, align: 'center', shadow: '#000', outline: false }); }","       if (this.streak >= 2) E.font.text(g, this.streak + ' in a row', W / 2, Math.round(H * .14), '#fff8e8', { align: 'center', shadow: '#000', outline: false });","-      if (this.state === 'end') { G.UI.panel(g, W / 2 - 110, H * .32, 220, 76); E.font.title(g, this.won ? 'CLEARED!' : 'TIME UP', W / 2, H * .32 + 8, { scale: 2, align: 'center', colors: ['#fff7d6', '#ffd36a', '#ff9e5e'] }); E.font.text(g, this.perfects + ' PERFECT · ' + this.goods + ' GOOD · ' + this.falls + ' falls', W / 2, H * .32 + 32, '#fff8e8', { align: 'center', outline: false }); if (G.state) G.UI.money(g, W / 2 - 40, H * .32 + 46, this.prize); }","+  