h(['act', id, G.rpick('cosmetic', ['partydance', 'dance', 'groove', 'cheer2']), 2.4],\")\ns=s.replace(\"for (const c of sc.cast) c.act = { kind: 'clap', t: 0, dur: 3, o: { hop: 3 } };\",\"for (const c of sc.cast) c.act = { kind: G.rpick('cosmetic', ['partydance', 'groove', 'dance']), t: 0, dur: 3, o: {} };\")\ns=s.replace(\"['emote', 'sonny', '!'], ['say', 'sonny', 'PEPPER?!'],\",\"['emote', 'sonny', '!'], ['act', 'sonny', 'confused', 2], ['say', 'sonny', 'PEPPER?!'],\")\ns=s.replace(\"['wait', .6], ['say', 'sonny', '...It\\\\'s red. Why is it always red.'],\",\"['wait', .6], ['act', 'sonny', 'angry', 2], ['say', 'sonny', '...It\\\\'s red. Why is it always red.'],\")\nopen(p,'w').write(s)\np='src/32-location.js'; s=open(p).read()\ns=s.replace(\"else { n.react = { kind: 'shrug', t: 0, dur: 1.2, expr: 'angry' }; G.sting('gift_refuse'); }\",\"else { n.react = { kind: 'reject', t: 0, dur: 1.6, expr: 'angry' }; G.sting('gift_refuse'); }\")\ns=s.replace(\"if (k === 'stool' || k === 'bench' || k === 'slot' || k === 'edge') pose = 'kneel';\",\"if (k === 'stool' || k === 'bench' || k === 'slot' || k === 'edge') { pose = 'kneel'; }\\n      else if (k === 'stand' && Math.sin(this.t * .4 + n.x) > .3) vb = { kind: 'foldarms', u: 0, w: .9 };\")\nopen(p,'w').write(s)\np='src/24-match.js'; s=open(p).read()\ns=s.replace(\"const k = G.rng('cosmetic'); p.setAct(k < .4 ? 'shrug' : k < .7 ? 'facepalm' : 'nod', 1.1, { expr: 'wince' });\",\"const k = G.rng('cosmetic'); p.setAct(k < .4 ? 'shrug' : k < .7 ? 'facepalm' : 'confused', 1.3, { expr: 'wince' });\")\nopen(p,'w').write(s)\np='src/15-anim.js'; s=open(p).read()\ns=s.replace(\"backflip: { move: null, dur: 1, flip: true }, cheer2: { move: null, dur: 1.4, pose: 'cheer', hop: 3 },\",\"backflip: { move: 'backflip', dur: 1.4 }, cheer2: { move: 'cheer2', dur: 1.6 },\")\ns=s.replace(\"dance: { move: 'clap', dur: 1.4, hop: 3, sway: 1 },\",\"dance: { move: 'dance', dur: 1.6 },\")\nopen(p,'w').write(s)\n# build: inline the mocap scripts after t