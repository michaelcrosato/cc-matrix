 'Idle_FoldArms_Loop', confused: 'Confused', angry: 'Angry', cartwheel: 'Cartwheel', sit: 'Sitting_Idle_Loop', groove: 'Dance_Loop' };\nG.clipLib = () => { if (G._clips !== undefined) return G._clips; try { G._clips = window.Mocap && window.MOCAP && window.MOCAP.AOA ? window.Mocap.load(window.MOCAP.AOA) : null; } catch (e) { G._clips = null; G.game && G.game.fail('mocap', e); } return G._clips; };\nG.clipPlaying = rig => !!(rig._mocapOn && rig.mocapW > 0 && rig._clipName);\nconst MOVE_POSE = {\"\"\")\ns=s.replace(\"\"\"    if (rig._vbWrapped) return rig; rig._vbWrapped = true;\n    const base = rig.solvePose;\"\"\",\"\"\"    if (rig._vbWrapped) return rig; rig._vbWrapped = true;\n    const baseUpdate = rig.update;\n    rig.update = function (dt, st) {\n      const vb = this.vb, lib = G.clipLib(), name = vb && vb.kind && G.CLIP_OF[vb.kind], clip = name && lib && lib.clip(name);\n      if (clip) {\n        if (!this._mocapOn) { window.Mocap.drive(this, lib); this._mocapOn = true; }\n        const u = clamp(vb.u || 0, 0, 1), tt = clip.loop ? (this.t || 0) : u * clip.dur;\n        this.mocap = lib.sample(clip, tt, this._mocapBuf || (this._mocapBuf = undefined)); this.mocapW = clamp(vb.w === undefined ? 1 : vb.w, 0, 1); this._clipName = name;\n        this.mocapMask = st && Math.hypot(st.vx || 0, st.vy || 0) > 5 ? 'upper' : null;\n      } else if (this._mocapOn) { this.mocapW = 0; this._clipName = null; }\n      return baseUpdate.call(this, dt, st);\n    };\n    const base = rig.solvePose;\"\"\")\nopen(p,'w').write(s)\n# callers: use clip-backed kinds\np='src/50-title.js'; s=open(p).read()\ns=s.replace(\"G.TITLE_IDLE = { rin: 'stretch', lola: 'fistpump', ingrid: 'hips', amara: 'clap', tess: 'shaka', mei: 'wave' };\",\"G.TITLE_IDLE = { rin: 'stretch', lola: 'fistpump', ingrid: 'foldarms', amara: 'dance', tess: 'shaka', mei: 'backflip' };\")\nopen(p,'w').write(s)\np='src/34-story.js'; s=open(p).read()\ns=s.replace(\"['act', 'sonny', 'dive', 1.4, { fall: true }]\",\"['act', 'sonny', 'fall', 2.2]\")\ns=s.replace(\"for (const id of others) steps.push(['act', id, 'clap', 1.4, { hop: 3 }],\",\"for (const id of others) steps.push(['act', id, G.rpick('cosmetic', ['partydance', 'dance', 'groove', 'cheer2']), 2.4],\")\ns=s.replace(\"for (const c of sc.cast) c.act = { kind: 'clap', t: 0, dur: 3, o: { hop: 3 } };\",\"for (const c of sc.cast) c.act = { kind: G.rpick('cosmetic', ['partydance', 'groove', 'dance']), t: 0, dur: 3, o: {} };\")\ns=s.replace(\"['emote', 'sonny', '!'], ['say', 'sonny', 'PEPPER?!'],\",\"['emote', 'sonny', '!'], ['act', 'sonny', 'confused', 2], ['say', 'sonny', 'PEPPER?!'],\")\ns=s.replace(\"['wait', .6], ['say', 'sonny', '...It\\\\'s red. Why is it always red.'],\",\"['wait', .6], ['act', 'sonny', 'angry', 2], ['say', 'sonny', '...It\\\\'s red. Why is it always red.'],\")\nopen(p,'w').write(s)\np='src/32-location.js'; s=open(p).read()\ns=s.replace(\"else { n.react = { kind: 'shrug', t: 0, dur: 1.2, expr: 'angry' }; G.sting('gift_refuse'); }\",\"else { n.react = { kind: 'reject', t: 0, dur: 1.6, expr: 'angry' }; G.sting('gift_refuse'); }\")\ns=s.replace(\"if (k === 'stool' || k === 'bench' || k === 'slot' || k === 'edge') pose = 'kneel';\",\"if (k === 'stool' || k === 'bench' || k === 'slot' || k === 'edge') { pose = 'kneel'; }\\n      else if (k === 'stand' && Math.sin(this.t * .4 + n.x) > .3) vb = { kind: 'foldarms', u: 0, w: .9 };\")\nopen(p,'w').write(s)\np='src/24-match.js'; s=open(p).read()\ns=s.replace(\"const k = G.rng('cosmetic'); p.setAct(k < .4 ? 'shrug' : k < .7 ? 'facepalm' : 'nod', 1.1, { expr: 'wince' });\",\"const k = G.rng('cosmetic'); p.setAct(k < .4 ? 'shrug' : k < .7 ? 'facepalm' : 'confused', 1.3, { expr: 'wince' });\")\nopen(p,'w').write(s)\np='src/15-anim.js'; s=open(p).read()\ns=s.replace(\"backflip: { move: null, dur: 1, flip: true }, cheer2: { move: null, dur: 1.4, pose: 'cheer', hop: 3 },\",\"backflip: { move: 'backflip', dur: 1.4 }, cheer2: { move: 'cheer2', dur: 1.6 },\")\ns=s.replace(\"dance: