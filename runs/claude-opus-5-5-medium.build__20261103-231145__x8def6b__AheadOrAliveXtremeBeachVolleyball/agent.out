ove: 'clap', dur: 1.4, hop: 3, sway: 1 },\n  shaka: { move: 'shaka', dur: 1.2 }, backflip: { move: null, dur: 1, flip: true }, cheer2: { move: null, dur: 1.4, pose: 'cheer', hop: 3 }, salute: { move: 'salute', dur: 1.2 }\n};\n/** a small speech bubble over someone's head (\"MINE!\") */\nG.bubble = (r, x, y, z, text, col = '#ffffff') => {\n  r.queue(x, y, z, g => {\n    const [sx, sy] = r.w(x, y, z), w = E.font.width(text) + 6, X = Math.round(sx - w / 2), Y = Math.round(sy - 12);\n    px.rect(g, X, Y, w, 10, '#101820'); px.rect(g, X + 1, Y + 1, w - 2, 8, col); px.rect(g, Math.round(sx) - 1, Y + 10, 3, 2, '#101820');\n    E.font.text(g, text, X + 3, Y + 2, '#101820', { outline: false });\n  }, { bias: 50 });\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Fp55tfntn8fc96QU69Fge4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
