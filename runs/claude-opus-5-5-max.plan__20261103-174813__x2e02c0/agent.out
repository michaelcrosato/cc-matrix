{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q79s5Tb1yip1FPAo3Xeetm","type":"tool_result","content":"const STANDARD_SETTINGS = {\n  fullscreen: { group: 'Display', label: 'Full screen', type: 'fullscreen', value: null },   // the player's choice: true, false (turned it off), null (never chose)\n  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApp\n  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\'t. 60: every other refre\n  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\'s refresh and a frame\\'s cost' },\n  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\n  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\'s rows. CRT: those, its colored stripes and its dark\n  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\n  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value