apAngle(desired - kart.heading);\"},{\"line_number\":496,\"content\":\"    input.steer = clamp(wrapAngle(desired - kart.heading) / 0.6, -1, 1);\"},{\"line_number\":545,\"content\":\"    kart.heading += dt * 9;\"},{\"line_number\":554,\"content\":\"      kart.heading += (input.steer || 0) * kart.stats.handle * grip * control * reverse * dt;\"},{\"line_number\":564,\"content\":\"  kart.x += Math.sin(kart.heading) * kart.speed * dt;\"},{\"line_number\":565,\"content\":\"  kart.z += Math.cos(kart.heading) * kart.speed * dt;\"},{\"line_number\":577,\"content\":\"        kart.heading = Math.atan2(ahead.x - kart.x, ahead.z - kart.z);\"},{\"line_number\":603,\"content\":\"      kart.heading -= sign * 0.35;\"},{\"line_number\":720,\"content\":\"function reflectHeading(heading, nx, nz) {\"},{\"line_number\":721,\"content\":\"  const vx = Math.sin(heading);\"},{\"line_number\":722,\"content\":\"  const vz = Math.cos(heading);\"},{\"line_number\":733,\"content\":\"      projectile.heading = reflectHeading(projectile.heading, Math.sign(projectile.x), 0);\"},{\"line_number\":738,\"content\":\"      projectile.heading = reflectHeading(projectile.heading, 0, Math.sign(projectile.z));\"},{\"line_number\":760,\"content\":\"    projectile.heading = reflectHeading(projectile.heading, near.right.x * sign, near.right.z * sign);\"},{\"line_number\":796,\"content\":\"        const diff = wrapAngle(desired - projectile.heading);\"},{\"line_number\":798,\"content\":\"        projectile.heading += clamp(diff, -turn, turn);\"},{\"line_number\":801,\"content\":\"    projectile.x += Math.sin(projectile.heading) * projectile.speed * dt;\"},{\"line_number\":802,\"content\":\"    projectile.z += Math.cos(projectile.heading) * projectile.speed * dt;\"},{\"line_number\":843,\"content\":\"    const x = kart.x - Math.sin(kart.heading) * 1.7;\"},{\"line_number\":844,\"content\":\"    const z = kart.z - Math.cos(kart.heading) * 1.7;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh__example__v2_