ace.coneImpulse.y, liveRace.coneImpulse.z);\\n        liveRace.coneImpulse = null;\\n      }\\n    }\\n  }\\n  try {\\n    renderViews(dt, time);\\n  } catch (err) {\\n890→    console.error(err);\\n  }\\n  updateHud(time);\\n  mouse.dx = 0;\\n  mouse.dy = 0;\\n  mouse.wheel = false;\\n  requestAnimationFrame(frame);\\n}\\n\\nfunction showGate(message) {\\n900→  const gate = $(\\\"gate\\\");\\n  if (gate) {\\n    gate.hidden = false;\\n    gate.textContent = message;\\n  }\\n  document.body.dataset.boot = \\\"gate\\\";\\n}\\n\\nfunction mount() {\\n  document.title = GAME_TITLE;\\n910→  const title = $(\\\"product-title\\\");\\n  if (title) title.textContent = GAME_TITLE;\\n  loadSession();\\n  setupTouch();\\n  bindInput();\\n  renderAll();\\n}\\n\\nasync function bootGpu() {\\n  const canvas = $(\\\"view\\\");\\n920→  const secure = window.isSecureContext && location.protocol !== \\\"file:\\\";\\n  if (!secure || !navigator.gpu) {\\n    showGate(\\\"WebGPU and a local server are required.\\\");\\n    return;\\n  }\\n  let adapter = null;\\n  try {\\n    adapter = await navigator.gpu.requestAdapter();\\n  } catch (err) {\\n    adapter = null;\\n930→  }\\n  if (!adapter) {\\n    showGate(\\\"WebGPU and a local server are required.\\\");\\n    return;\\n  }\\n  try {\\n    renderer = await createRenderer(canvas);\\n    renderer.onDeviceLost = () => {\\n      showGate(\\\"WebGPU and a local server are required.\\\");\\n    };\\n940→    fitBuffer(canvas, renderer);\\n    await showLot();\\n    document.body.dataset.boot = \\\"ready\\\";\\n    requestAnimationFrame(frame);\\n  } catch {\\n    showGate(\\\"WebGPU and a local server are required.\\\");\\n  }\\n}\\n\\nmount();\\n950→bootGpu();\\n\",\"content_concise\":\"500→  renderKey = \\\"\\\";\\n  renderAll();\\n}\\n\\nfunction cycleCharacter(dir) {\\n  const count = draft.mode === \\\"cup\\\" || draft.mode === \\\"trial\\\" ? 1 : draft.playerCount;\\n  const index = CHARACTERS.findIndex((character) => character.id === 