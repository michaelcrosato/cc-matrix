tx.clearRect(0, 0, w, h);\\n  ctx.fillStyle = \\\"rgba(8, 10, 16, 0.55)\\\";\\n  ctx.fillRect(0, 0, w, h);\\n  const bounds = course.bounds;\\n  const spanX = Math.max(1, bounds.maxX - bounds.minX);\\n  const spanZ = Math.max(1, bounds.maxZ - bounds.minZ);\\n  const scale = Math.min((w - 16) / spanX, (h - 16) / spanZ);\\n  const ox = w / 2 - ((bounds.minX + bounds.maxX) / 2) * scale;\\n  const oy = h / 2 + ((bounds.minZ + bounds.maxZ) / 2) * scale;\\n  const X = (x) => ox + x * scale;\\n  const Y = (z) => oy - z * scale;\\n  ctx.strokeStyle = \\\"#f3d7a4\\\";\\n  ctx.lineWidth = 5;\\n  ctx.lineJoin = \\\"round\\\";\\n  ctx.beginPath();\\n  if (course.kind === \\\"circuit\\\" && course.points.length) {\\n    course.points.forEach((point, index) => {\\n      if (index === 0) ctx.moveTo(X(point.x), Y(point.z));\\n      else ctx.lineTo(X(point.x), Y(point.z));\\n    });\\n    ctx.closePath();\\n    ctx.stroke();\\n  } else {\\n    ctx.strokeRect(X(-course.width / 2), Y(course.depth / 2), course.width * scale, course.depth * scale);\\n  }\\n  for (const kart of karts) {\\n    ctx.fillStyle = kart.id === selfId ? \\\"#ffb703\\\" : \\\"#f7f3ea\\\";\\n    ctx.beginPath();\\n    ctx.arc(X(kart.x), Y(kart.z), kart.id === selfId ? 5 : 3.2, 0, Math.PI * 2);\\n    ctx.fill();\\n  }\\n}\\n\\nfunction bindInput() {\\n  window.addEventListener(\\\"keydown\\\", (event) => {\\n    keys[event.code] = true;\\n    if ([\\\"Space\\\", \\\"ArrowUp\\\", \\\"ArrowDown\\\", \\\"ArrowLeft\\\", \\\"ArrowRight\\\"].includes(event.code)) event.preventDefault();\\n    audio.unlock();\\n  });\\n  window.addEventListener(\\\"keyup\\\", (event) => {\\n    keys[event.code] = false;\\n  });\\n  window.addEventListener(\\\"blur\\\", () => {\\n    for (const code of Object.keys(keys)) keys[code] = false;\\n  });\\n  const canvas = $(\\\"view\\\");\\n  canvas.addEventListener(\\\"click\\\", () => {\\n    if (session.screen === \\\"race\\\" || session.screen === \\\"attract\\\") canvas.requestPointerLock();\\n  });\\n  window.addEventListener(\\\"mousedown\\\", (event) => {\\n    mouse.buttons[event.button] = true;\\n  });\\n  window.addEventListener(\\\"mouseup\\\", (event) => {\\n    mouse.buttons[event.button] = false;\\n  });\\n  window.addEventListener(\\\"mousemove\\\", (event) => {\\n    if (document.pointerLockElement === canvas) {\\n      mouse.dx += event.movementX;\\n      mouse.dy += event.movementY;\\n    }\\n  });\\n  window.addEventListener(\\\"wheel\\\", (event) => {\\n    if (session.screen === \\\"race\\\") {\\n      mouse.wheel = true;\\n      event.preventDefault();\\n    }\\n  }, { passive: false });\\n  window.addEventListener(\\\"resize\\\", () => {\\n    if (renderer) fitBuffer($(\\\"view\\\"), renderer);\\n  });\\n  const touchSettings = $(\\\"touch-settings\\\");\\n  if (touchSettings) {\\n    touchSettings.addEventListener(\\\"click\\\", () => {\\n      session.screen = \\\"settings\\\";\\n      session.focus = 0;\\n      session.idle = 0;\\n      renderKey = \\\"\\\";\\n      renderAll();\\n    });\\n  }\\n}\\n\\nfunction setupTouch() {\\n  const gate = $(\\\"touch-gate\\\");\\n  if (!gate) return;\\n  const visible = touchGateVisible({\\n    coarsePointer: window.matchMedia(\\\"(pointer: coarse)\\\").matches,\\n    hover: window.matchMedia(\\\"(hover: hover)\\\").matches,\\n    maxTouchPoints: navigator.maxTouchPoints || 0,\\n  });\\n  gate.hidden = !visible;\\n}\\n\\nfunction drainAudio() {\\n  if (!race) return;\\n  for (const event of race.events) {\\n    if (event.type === \\\"countdown\\\") audio.countdown(event.value);\\n    else if (event.type === \\\"impact\\\") audio.impact();\\n    else if (event.type === \\\"item\\\" && (event.phase === \\\"use\\\" || event.phase === \\\"roll\\\" || event.phase === \\\"pulse\\\")) audio.item();\\n  }\\n  race.events.length = 0;\\n  if (session.screen === \\\"race\\\" || session.screen === \\\"attract\\\") {\\n    const humans = race.karts.filter((kart) => kart.isPlayer);\\n    const heard = humans.length ? humans : race.karts.slice(0, 1);\\n    heard.forEach((kart, index) => audio.engine(index, kart.speed));\\n  } else audio.silence();\\n}\\n\\nfunction renderViews(dt, time) {\\n  if (!renderer || !sim) return;\\n  const canvas = $(\\\"view\\\");\\n  const size = fitBuffer(canvas, renderer);\\n  const shownRace = sim.race;\\n  animateScene(sim.view, shownRace, dt, time);\\n  const live = race && (session.screen === \\\"race\\\" || session.screen === \\\"attract\\\" || session.screen === \\\"pause\\\" || session.screen === \\\"results\\\");\\n  const humans = live ? race.karts.filter((kart) => kart.isPlayer) : [];\\n  const views = live && humans.length ? humans : [shownRace.karts[0]];\\n  const ports = live && humans.length > 1 ? viewports(humans.length, size.width, size.height) : viewports(1, size.width, size.height);\\n  renderer.setScissorTest(ports.length > 1);\\n  for (let i = 0; i < ports.length; i++) {\\n    const port = ports[i];\\n    const kart = views[i] || views[0];\\n    const camera = sim.view.cameras[i] || sim.view.camera;\\n    if (!(live && humans.length)) orbitCamera(camera, sim.course, time, port.w, port.h);\\n    else frameCamera(camera, kart, camModes[i] || \\\"chase\\\", dt, port.w, port.h);\\n    renderer.setViewport(port.x, port.y, port.w, port.h);\\n    renderer.setScissor(port.x, port.y, port.w, port.h);\\n    renderer.render(sim.view.scene, camera);\\n  }\\n}\\n\\nasync function frame(now) {\\n  const dt = Math.min(0.05, lastFrame ? (now - lastFrame) / 1000 : 1 / 60);\\n  lastFrame = now;\\n  const time = now / 1000;\\n  const pads = readPads();\\n  const any = inputAny(pads);\\n  if (swallow) swallow = false;\\n  else {\\n    const wasAttract = session.attract;\\n    stepSession(session, dt, session.screen === \\\"race\\\" || session.screen === \\\"pause\\\" || session.screen === \\\"results\\\" ? false : any);\\n    if (wasAttract && !session.attract) {\\n      swallow = true;\\n      race = null;\\n      renderKey = \\\"\\\";\\n      renderAll();\\n      if (!busy) {\\n        busy = true;\\n        showLot().finally(() => {\\n          busy = false;\\n        });\\n      }\\n    } else if (!wasAttract && session.attract && !busy) {\\n      busy = true;\\n      launchAttract().finally(() => {\\n        busy = false;\\n      });\\n    }\\n  }\\n  if (session.screen === \\\"race\\\" && race && !race.attract) {\\n    const humans = race.karts.filter((kart) => kart.isPlayer);\\n    const actions = humans.map((kart, index) => drivingActions({\\n      pad: pads[kart.playerIndex] || pads[index] || null,\\n      keys,\\n      mouse,\\n      settings: session.settings,\\n      playerIndex: kart.playerIndex || 0,\\n      useMouse: index === 0 && document.pointerLockElement === $(\\\"view\\\"),\\n    }));\\n    let paused = false;\\n    actions.forEach((action, index) => {\\n      const prev = drivePrev[index];\\n      if (action.camera && !prev.camera) {\\n        const at = CAM_CYCLE.indexOf(camModes[index] || \\\"chase\\\");\\n        camModes[index] = CAM_CYCLE[(at + 1) % CAM_CYCLE.length];\\n      }\\n      if (action.pause && !prev.pause) paused = true;\\n      drivePrev[index] = action;\\n    });\\n    if (paused) {\\n      session.screen = \\\"pause\\\";\\n      session.focus = 0;\\n      renderKey = \\\"\\\";\\n      renderAll();\\n    } else if (race.phase !== \\\"finished\\\") {\\n      stepRace(race, actions, dt);\\n      drainAudio();\\n      if (race.phase === \\\"finished\\\") enterResults();\\n    }\\n  } else if (session.screen === \\\"attract\\\" && race && !busy) {\\n    if (race.phase !== \\\"finished\\\") {\\n      stepRace(race, null, dt);\\n      drainAudio();\\n    } else {\\n      busy = true;\\n      launchAttract().finally(() => {\\n        busy = false;\\n      });\\n    }\\n  } else if (session.screen !== \\\"race\\\") {\\n    const menuAction = drivingActions({\\n      pad: pads[0] || null,\\n      keys,\\n      mouse: null,\\n      settings: session.settings,\\n      playerIndex: 0,\\n      useMouse: false,\\n    });\\n    const pauseEdge = session.screen === \\\"pause\\\" && menuAction.pause && !menuPrev.pause;\\n    if (!swallow && session.screen !== \\\"attract\\\") {\\n      const edgeX = menuAction.menuX && !menuPrev.menuX ? menuAction.menuX : 0;\\n      const edgeY = menuAction.menuY && !menuPrev.menuY ? menuAction.menuY : 0;\\n      const confirm = menuAction.confirm && !menuPrev.confirm;\\n      const back = menuAction.back && !menuPrev.back;\\n      if (edgeX || edgeY || confirm || back) onMenuEdges(edgeX, edgeY, confirm, back);\\n    }\\n    menuPrev = menuAction;\\n    if (pauseEdge && race) {\\n      session.screen = \\\"race\\\";\\n      renderKey = \\\"\\\";\\n      renderAll();\\n    }\\n  }\\n  if (sim && sim.world) {\\n    stepWorld(sim.world, 1);\\n    const pos = bodyTranslation(sim.cone);\\n    sim.view.cone.position.set(pos.x, pos.y, pos.z);\\n    const liveRace = race && sim.race === race ? race : null;\\n    if (liveRace) {\\n      liveRace.conePos = pos;\\n      if (liveRace.coneImpulse) {\\n        pushBody(sim.cone, liveRace.coneImpulse.x, liveRace.coneImpulse.y, liveRace.coneImpulse.z);\\n        liveRace.coneImpulse = null;\\n      }\\n    }\\n  }\\n  try {\\n    renderViews(dt, time);\\n  } catch (err) {\\n    console.error(err);\\n  }\\n  updateHud(time);\\n  mouse.dx = 0;\\n  mouse.dy = 0;\\n  mouse.wheel = false;\\n  requestAnimationFrame(frame);\\n}\\n\\nfunction showGate(message) {\\n  const gate = $(\\\"gate\\\");\\n  if (gate) {\\n    gate.hidden = false;\\n    gate.textContent = message;\\n  }\\n  document.body.dataset.boot = \\\"gate\\\";\\n}\\n\\nfunction mount() {\\n  document.title = GAME_TITLE;\\n  const title = $(\\\"product-title\\\");\\n  if (title) title.textContent = GAME_TITLE;\\n  loadSession();\\n  setupTouch();\\n  bindInput();\\n  renderAll();\\n}\\n\\nasync function bootGpu() {\\n  const canvas = $(\\\"view\\\");\\n  const secure = window.isSecureContext && location.protocol !== \\\"file:\\\";\\n  if (!secure || !navigator.gpu) {\\n    showGate(\\\"WebGPU and a local server are required.\\\");\\n    return;\\n  }\\n  let adapter = null;\\n  try {\\n    adapter = await navigator.gpu.requestAdapter();\\n  } catch (err) {\\n    adapter = null;\\n  }\\n  if (!adapter) {\\n    showGate(\\\"WebGPU and a local server are required.\\\");\\n    return;\\n  }\\n  try {\\n    renderer = await createRenderer(canvas);\\n    renderer.onDeviceLost = () => {\\n      showGate(\\\"WebGPU and a local server are required.\\\");\\n    };\\n    fitBuffer(canvas, renderer);\\n    await showLot();\\n    document.body.dataset.boot = \\\"ready\\\";\\n    requestAnimationFrame(frame);\\n  } catch {\\n    showGate(\\\"WebGPU and a local server are required.\\\");\\n  }\\n}\\n\\nmount();\\nbootGpu();\\n\",\"total_lines\":950}}","is_error":false},{"type":"tool_result","tool_use_id":"call-26ad097a-ab17-4276-ba37-de976963a163-27","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→function dedupe(points) {\\n  const out = [];\\n  for (const point of points) {\\n    const prev = out[out.length - 1];\\n    if (!prev || Math.hypot(point.x - prev.x, point.y - prev.y, point.z - prev.z) > 0.08) {\\n      out.push(point);\\n    }\\n  }\\n  if (out.length > 2) {\\n10→    const first = out[0];\\n    const last = out[out.length - 1];\\n    if (Math.hypot(first.x - last.x, first.y - last.y, first.z - last.z) < 0.08) out.pop();\\n  }\\n  return out;\\n}\\n\\nfunction stadiumPoints(straight, radius, hill) {\\n  const half = straight / 2;\\n  const side = Math.max(12, Math.round(straight / 5));\\n20→  const cap = 28;\\n  const raw = [];\\n  const push = (x, z) => {\\n    const y = hill(x, z, raw.length);\\n    raw.push({ x, y, z });\\n  };\\n  for (let i = 0; i <= side; i++) push(-half + (straight * i) / side, -radius);\\n  for (let i = 1; i <= cap; i++) {\\n    const angle = -Math.PI / 2 + (Math.PI * i) / cap;\\n    push(half + Math.cos(angle) * radius, Math.sin(angle) * radius);\\n30→  }\\n  for (let i = 1; i <= side; i++) push(half - (straight * i) / side, radius);\\n  for (let i = 1; i < cap; i++) {\\n    const angle = Math.PI / 2 + (Math.PI * i) / cap;\\n    push(-half + Math.cos(angle) * radius, Math.sin(angle) * radius);\\n  }\\n  return dedupe(raw);\\n}\\n\\nfunction smoothHill(t) {\\n40→  const x = Math.max(0, Math.min(1, t));\\n  return x * x * (3 - 2 * x);\\n}\\n\\nexport function buildCourse(def) {\\n  const points = def.points;\\n  const segLen = [];\\n  let total = 0;\\n  for (let i = 0; i < points.length; i++) {\\n    const a = points[i];\\n50→    const b = points[(i + 1) % points.length];\\n    const len = Math.hypot(b.x - a.x, b.y - a.y, b.z - a.z);\\n    segLen.push(len);\\n    total += len;\\n  }\\n  let minX = Infinity;\\n  let maxX = -Infinity;\\n  let minZ = Infinity;\\n  let maxZ = -Infinity;\\n  let maxY = 0;\\n60→  for (const point of points) {\\n    minX = Math.min(minX, point.x);\\n    maxX = Math.max(maxX, point.x);\\n    minZ = Math.min(minZ, point.z);\\n    maxZ = Math.max(maxZ, point.z);\\n    maxY = Math.max(maxY, point.y);\\n  }\\n  return {\\n    ...def,\\n    points,\\n70→    segLen,\\n    length: total,\\n    bounds: { minX, maxX, minZ, maxZ, maxY },\\n  };\\n}\\n\\nexport function sampleCourse(course, distance) {\\n  const length = course.length;\\n  let d = distance % length;\\n  if (d < 0) d += length;\\n80→  let acc = 0;\\n  for (let i = 0; i < course.points.length; i++) {\\n    const seg = course.segLen[i];\\n    const last = i === course.points.length - 1;\\n    if (d <= acc + seg || last) {\\n      const t = seg > 0 ? Math.max(0, Math.min(1, (d - acc) / seg)) : 0;\\n      const a = course.points[i];\\n      const b = course.points[(i + 1) % course.points.length];\\n      const x = a.x + (b.x - a.x) * t;\\n      const y = a.y + (b.y - a.y) * t;\\n90→      const z = a.z + (b.z - a.z) * t;\\n      const heading = Math.atan2(b.x - a.x, b.z - a.z);\\n      return {\\n        x,\\n        y,\\n        z,\\n        heading,\\n        right: { x: Math.cos(heading), y: 0, z: -Math.sin(heading) },\\n      };\\n    }\\n100→    acc += seg;\\n  }\\n  const a = course.points[0];\\n  return { x: a.x, y: a.y, z: a.z, heading: 0, right: { x: 1, y: 0, z: 0 } };\\n}\\n\\nexport function pointOnCourse(course, progress, lateral, lift = 0) {\\n  const sample = sampleCourse(course, progress);\\n  return {\\n    x: sample.x + sample.right.x * lateral,\\n110→    y: sample.y + lift,\\n    z: sample.z + sample.right.z * lateral,\\n    heading: sample.heading,\\n    right: sample.right,\\n  };\\n}\\n\\nexport function placeKart(course, kart, progress, lateral) {\\n  const sample = pointOnCourse(course, progress, lateral, 0);\\n  kart.progress = progress;\\n120→  kart.lateral = lateral;\\n  kart.x = sample.x;\\n  kart.y = sample.y;\\n  kart.z = sample.z;\\n  kart.heading = sample.heading;\\n  return sample;\\n}\\n\\nexport function lapForProgress(progress, length) {\\n  if (progress < length) return 1;\\n130→  if (progress < length * 2) return 2;\\n  return 3;\\n}\\n\\n// Road strip in the same frame as sampleCourse. Vertex pairs are (right, left).\\n// Triangle order is right, left, next-right so the cross product points +y\\n// (heading π/2 travels +x and right is -z; that cross is +y).\\nexport function roadStrip(course, half, lift) {\\n  const count = Math.max(24, Math.floor(course.length / 4));\\n  const positions = [];\\n140→  const normals = [];\\n  const indices = [];\\n  for (let i = 0; i <= count; i++) {\\n    const sample = sampleCourse(course, (i % count) * (course.length / count));\\n    const y = sample.y + lift;\\n    positions.push(\\n      sample.x + sample.right.x * half, y, sample.z + sample.right.z * half,\\n      sample.x - sample.right.x * half, y, sample.z - sample.right.z * half,\\n    );\\n    normals.push(0, 1, 0, 0, 1, 0);\\n150→  }\\n  for (let i = 0; i < count; i++) {\\n    const a = i * 2;\\n    indices.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);\\n  }\\n  return { positions, normals, indices };\\n}\\n\\nconst cinder = buildCourse({\\n  id: \\\"cinder-loop\\\",\\n160→  name: \\\"Cinder Loop\\\",\\n  kind: \\\"circuit\\\",\\n  blurb: \\\"A warm quarry oval. The shoulders are made of bad ideas.\\\",\\n  laps: 3,\\n  roadHalf: 8,\\n  wallHalf: 12.2,\\n  sky: 0xf2b48a,\\n  road: 0x3c4454,\\n  shoulder: 0xc6a36e,\\n  grass: 0x6ea24a,\\n170→  wall: 0x8d4636,\\n  fog: 0xf2b48a,\\n  accent: 0xffb703,\\n  points: stadiumPoints(130, 42, (x, z) => {\\n    const ramp = smoothHill((x - 40) / 50);\\n    const cap = Math.max(0, 1 - Math.abs(z) / 42);\\n    return ramp * cap * 7.5;\\n  }),\\n});\\n\\n180→const lantern = buildCourse({\\n  id: \\\"lantern-causeway\\\",\\n  name: \\\"Lantern Causeway\\\",\\n  kind: \\\"circuit\\\",\\n  blurb: \\\"Night harbor, narrow bridge, one rude hairpin.\\\",\\n  laps: 3,\\n  roadHalf: 6.6,\\n  wallHalf: 10.4,\\n  sky: 0x14182e,\\n  road: 0x2c3448,\\n190→  shoulder: 0x3e4c5c,\\n  grass: 0x16343c,\\n  wall: 0xd0893a,\\n  fog: 0x14182e,\\n  accent: 0xffc56b,\\n  points: stadiumPoints(168, 30, (x, z) => {\\n    if (z > 10) {\\n      const along = smoothHill((x + 84) / 168);\\n      const crest = Math.sin(along * Math.PI);\\n      return crest * 8.2;\\n200→    }\\n    if (x < -70) return smoothHill((Math.abs(z) - 8) / 24) * 2.2;\\n    return 0;\\n  }),\\n});\\n\\nexport const BALLOON_YARD = {\\n  id: \\\"balloon-yard\\\",\\n  name: \\\"Balloon Yard\\\",\\n  kind: \\\"arena\\\",\\n210→  blurb: \\\"A walled yard. Three balloons. Do not be polite.\\\",\\n  laps: 0,\\n  roadHalf: 99,\\n  wallHalf: 99,\\n  width: 72,\\n  depth: 52,\\n  sky: 0x9fd4ff,\\n  road: 0xd9c7a6,\\n  shoulder: 0xcbb892,\\n  grass: 0xd9c7a6,\\n220→  wall: 0x6b4a38,\\n  fog: 0x9fd4ff,\\n  accent: 0xff5d8f,\\n  obstacles: [\\n    { type: \\\"cyl\\\", x: 0, z: 0, r: 4.2 },\\n    { type: \\\"box\\\", x: -18, z: -10, hx: 4.2, hz: 2.6 },\\n    { type: \\\"box\\\", x: 18, z: 10, hx: 4.2, hz: 2.6 },\\n    { type: \\\"cyl\\\", x: -20, z: 14, r: 2.4 },\\n    { type: \\\"cyl\\\", x: 20, z: -14, r: 2.4 },\\n    { type: \\\"box\\\", x: 0, z: 16, hx: 7, hz: 1.6 },\\n230→    { type: \\\"box\\\", x: 0, z: -16, hx: 7, hz: 1.6 },\\n  ],\\n  spawns: [\\n    { x: 0, z: -18, heading: 0 },\\n    { x: 0, z: 18, heading: Math.PI },\\n    { x: -26, z: 0, heading: Math.PI / 2 },\\n    { x: 26, z: 0, heading: -Math.PI / 2 },\\n  ],\\n  boxSpots: [\\n    { x: -12, z: -12 },\\n240→    { x: 12, z: -12 },\\n    { x: -12, z: 12 },\\n    { x: 12, z: 12 },\\n    { x: -28, z: -18 },\\n    { x: 28, z: 18 },\\n  ],\\n  bounds: { minX: -36, maxX: 36, minZ: -26, maxZ: 26, maxY: 0 },\\n  length: 1,\\n  points: [],\\n  segLen: [],\\n250→};\\n\\nfunction withBoxes(course) {\\n  if (course.kind !== \\\"circuit\\\") return course;\\n  const boxes = [];\\n  const count = 8;\\n  for (let i = 0; i < count; i++) {\\n    boxes.push({\\n      progress: ((i + 0.5) * course.length) / count,\\n      lateral: i % 2 === 0 ? -3.1 : 3.1,\\n260→    });\\n  }\\n  return { ...course, boxSpots: boxes };\\n}\\n\\nexport const CINDER_LOOP = withBoxes(cinder);\\nexport const LANTERN_CAUSEWAY = withBoxes(lantern);\\nexport const COURSES = [CINDER_LOOP, LANTERN_CAUSEWAY];\\nexport const CUP_IDS = [\\\"cinder-loop\\\", \\\"lantern-causeway\\\"];\\n\\n270→export function courseById(id) {\\n  if (id === BALLOON_YARD.id) return BALLOON_YARD;\\n  return COURSES.find((course) => course.id === id) || CINDER_LOOP;\\n}\\n\",\"content_concise\":\"1→function dedupe(points) {\\n  const out = [];\\n  for (const point of points) {\\n    const prev = out[out.length - 1];\\n    if (!prev || Math.hypot(point.x - prev.x, point.y - prev.y, point.z - prev.z) > 0.08) {\\n      out.push(point);\\n    }\\n  }\\n  if (out.length > 2) {\\n10→    const first = out[0];\\n    const last = out[out.length - 1];\\n    if (Math.hypot(first.x - last.x, first.y - last.y, first.z - last.z) < 0.08) out.pop();\\n  }\\n  return out;\\n}\\n\\nfunction stadiumPoints(straight, radius, hill) {\\n  const half = straight / 2;\\n  const side = Math.max(12, Math.round(straight / 5));\\n20→  const cap = 28;\\n  const raw = [];\\n  const push = (x, z) => {\\n    const y = hill(x, z, raw.length);\\n    raw.push({ x, y, z });\\n  };\\n  for (let i = 0; i <= side; i++) push(-half + (straight * i) / side, -radius);\\n  for (let i = 1; i <= cap; i++) {\\n    const angle = -Math.PI / 2 + (Math.PI * i) / cap;\\n    push(half + Math.cos(angle) * radius, Math.sin(angle) * radius);\\n30→  }\\n  for (let i = 1; i <= side; i++) push(half - (straight * i) / side, radius);\\n  for (let i = 1; i < cap; i++) {\\n    const angle = Math.PI / 2 + (Math.PI * i) / cap;\\n    push(-half + Math.cos(angle) * radius, Math.sin(angle) * radius);\\n  }\\n  return dedupe(raw);\\n}\\n\\nfunction smoothHill(t) {\\n40→  const x = Math.max(0, Math.min(1, t));\\n  return x * x * (3 - 2 * x);\\n}\\n\\nexport function buildCourse(def) {\\n  const points = def.points;\\n  const segLen = [];\\n  let total = 0;\\n  for (let i = 0; i < points.length; i++) {\\n    const a = points[i];\\n50→    const b = points[(i + 1) % points.length];\\n    const len = Math.hypot(b.x - a.x, b.y - a.y, b.z - a.z);\\n    segLen.push(len);\\n    total += len;\\n  }\\n  let minX = Infinity;\\n  let maxX = -Infinity;\\n  let minZ = Infinity;\\n  let maxZ = -Infinity;\\n  let maxY = 0;\\n60→  for (const point of points) {\\n    minX = Math.min(minX, point.x);\\n    maxX = Math.max(maxX, point.x);\\n    minZ = Math.min(minZ, point.z);\\n    maxZ = Math.max(maxZ, point.z);\\n    maxY = Math.max(maxY, point.y);\\n  }\\n  return {\\n    ...def,\\n    points,\\n70→    segLen,\\n    length: total,\\n    bounds: { minX, maxX, minZ, maxZ, maxY },\\n  };\\n}\\n\\nexport function sampleCourse(course, distance) {\\n  const length = course.length;\\n  let d = distance % length;\\n  if (d < 0) d += length;\\n80→  let acc = 0;\\n  for (let i = 0; i < course.points.length; i++) {\\n    const seg = course.segLen[i];\\n    const last = i === course.points.length - 1;\\n    if (d <= acc + seg || last) {\\n      const t = seg > 0 ? Math.max(0, Math.min(1, (d - acc) / seg)) : 0;\\n      const a = course.points[i];\\n      const b = course.points[(i + 1) % course.points.length];\\n      const x = a.x + (b.x - a.x) * t;\\n      const y = a.y + (b.y - a.y) * t;\\n90→      const z = a.z + (b.z - a.z) * t;\\n      const heading = Math.atan2(b.x - a.x, b.z - a.z);\\n      return {\\n        x,\\n        y,\\n        z,\\n        heading,\\n        right: { x: Math.cos(heading), y: 0, z: -Math.sin(heading) },\\n      };\\n    }\\n100→    acc += seg;\\n  }\\n  const a = course.points[0];\\n  return { x: a.x, y: a.y, z: a.z, heading: 0, right: { x: 1, y: 0, z: 0 } };\\n}\\n\\nexport function pointOnCourse(course, progress, lateral, lift = 0) {\\n  const sample = sampleCourse(course, progress);\\n  return {\\n    x: sample.x + sample.right.x * lateral,\\n110→    y: sample.y + lift,\\n    z: sample.z + sample.right.z * lateral,\\n    heading: sample.heading,\\n    right: sample.right,\\n  };\\n}\\n\\nexport function placeKart(course, kart, progress, lateral) {\\n  const sample = pointOnCourse(course, progress, lateral, 0);\\n  kart.progress = progress;\\n120→  kart.lateral = lateral;\\n  kart.x = sample.x;\\n  kart.y = sample.y;\\n  kart.z = sample.z;\\n  kart.heading = sample.heading;\\n  return sample;\\n}\\n\\nexport function lapForProgress(progress, length) {\\n  if (progress < length) return 1;\\n130→  if (progress < length * 2) return 2;\\n  return 3;\\n}\\n\\n// Road strip in the same frame as sampleCourse. Vertex pairs are (right, left).\\n// Triangle order is right, left, next-right so the cross product points +y\\n// (heading π/2 travels +x and right is -z; that cross is +y).\\nexport function roadStrip(course, half, lift) {\\n  const count = Math.max(24, Math.floor(course.length / 4));\\n  const positions = [];\\n140→  const normals = [];\\n  const indices = [];\\n  for (let i = 0; i <= count; i++) {\\n    const sample = sampleCourse(course, (i % count) * (course.length / count));\\n    const y = sample.y + lift;\\n    positions.push(\\n      sample.x + sample.right.x * half, y, sample.z + sample.right.z * half,\\n      sample.x - sample.right.x * half, y, sample.z - sample.right.z * half,\\n    );\\n    normals.push(0, 1, 0, 0, 1, 0);\\n150→  }\\n  for (let i = 0; i < count; i++) {\\n    const a = i * 2;\\n    indices.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);\\n  }\\n  return { positions, normals, indices };\\n}\\n\\nconst cinder = buildCourse({\\n  id: \\\"cinder-loop\\\",\\n160→  name: \\\"Cinder Loop\\\",\\n  kind: \\\"circuit\\\",\\n  blurb: \\\"A warm quarry oval. The shoulders are made of bad ideas.\\\",\\n  laps: 3,\\n  roadHalf: 8,\\n  wallHalf: 12.2,\\n  sky: 0xf2b48a,\\n  road: 0x3c4454,\\n  shoulder: 0xc6a36e,\\n  grass: 0x6ea24a,\\n170→  wall: 0x8d4636,\\n  fog: 0xf2b48a,\\n  accent: 0xffb703,\\n  points: stadiumPoints(130, 42, (x, z) => {\\n    const ramp = smoothHill((x - 40) / 50);\\n    const cap = Math.max(0, 1 - Math.abs(z) / 42);\\n    return ramp * cap * 7.5;\\n  }),\\n});\\n\\n180→const lantern = buildCourse({\\n  id: \\\"lantern-causeway\\\",\\n  name: \\\"Lantern Causeway\\\",\\n  kind: \\\"circuit\\\",\\n  blurb: \\\"Night harbor, narrow bridge, one rude hairpin.\\\",\\n  laps: 3,\\n  roadHalf: 6.6,\\n  wallHalf: 10.4,\\n  sky: 0x14182e,\\n  road: 0x2c3448,\\n190→  shoulder: 0x3e4c5c,\\n  grass: 0x16343c,\\n  wall: 0xd0893a,\\n  fog: 0x14182e,\\n  accent: 0xffc56b,\\n  points: stadiumPoints(168, 30, (x, z) => {\\n    if (z > 10) {\\n      const along = smoothHill((x + 84) / 168);\\n      const crest = Math.sin(along * Math.PI);\\n      return crest * 8.2;\\n200→    }\\n    if (x < -70) return smoothHill((Math.abs(z) - 8) / 24) * 2.2;\\n    return 0;\\n  }),\\n});\\n\\nexport const BALLOON_YARD = {\\n  id: \\\"balloon-yard\\\",\\n  name: \\\"Balloon Yard\\\",\\n  kind: \\\"arena\\\",\\n210→  blurb: \\\"A walled yard. Three balloons.