tmp/s55pw or PW_DIR).\n- Exit interview: `node tools/exit.mjs` writes ../exit-interview.json from src/49-about.js.\n- Balance defaults live in BZ.TUNE_META (src/00-core.js); the dev mode sliders edit BZ.TUNE live.\nEOF\nnode tools/build.mjs | tail -1; node tests/run.mjs --browser 2>&1 | tail -5"}],"uuid":"b9b9b439-b7bc-49ac-9eef-c9a785a37a85","session_id":"ae684082-f21f-4a2b-8baf-c73d93056a9d"}
