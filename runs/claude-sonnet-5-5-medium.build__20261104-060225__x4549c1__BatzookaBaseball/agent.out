(ib) {\n  const M = BZ.M, o = off();\n  if (o.human && o.ctl) { if (ib.steal && !M.steal) BZ.trySteal(); return; }\n  if (!M.stealChecked && M.pitch && M.pitch.released) { M.stealChecked = true; if (!M.attract || rnd() < .5) if (rnd() < .035 + .08 * M.diff) BZ.trySteal(); }\n  else if (!M.stealChecked && M.phase === 'windup') { M.stealChecked = true; if (rnd() < .03 + .08 * M.diff + (M.attract ? .08 : 0)) BZ.trySteal(); }\n}\"\"\")\n# finishPlay: stealPlay branch\nrep(\"\"\"function finishPlay(force) {\n  const M = BZ.M, b = M.ball, bs = off();\n  if (M.phase === 'resolved') return;\"\"\",\"\"\"function finishPlay(force) {\n  const M = BZ.M, b = M.ball, bs = off();\n  if (M.phase === 'resolved') return;\n  if (M.stealPlay) {\n    M.stealPlay = false; M.steal = false; M.outsThisPlay = 0; M.outsTimer = undefined;\n    M.runners = M.runners.filter(q => q.state === 'run');\n    for (const q of M.runners) { q.stealing = false; q.pos = clamp(Math.round(q.pos), 1, 3); [q.actor.x, q.actor.y] = segPos(q.pos); q.dir = 0; q.origin = q.pos; q.mustReturn = false; q.floorBase = undefined; }\n    const seen = new Set(); M.runners.sort((a, c) => c.pos - a.pos).forEach(q => { while (seen.has(q.pos) && q.pos < 3) q.pos++; seen.add(q.pos); [q.actor.x, q.actor.y] = segPos(q.pos); });\n    M.phase = 'resolved'; M.ball.state = 'none'; return checkHalfEnd(true);\n  }\"\"\")\nrep(\"function checkHalfEnd() {\\n  const M = BZ.M;\",\"function checkHalfEnd(keep) {\\n  const M = BZ.M;\")\nrep(\"  BZ.nextBatter(); fieldersHome(); M.phase = 'setup'; M.t = 0; M.balls = M.balls; M.pitch = null;\",\"  if (keep) { const rs = M.runners; M.cur.u = 0; M.cur.v = 0; M.sw = null; M.swCool = 0; M.pitch = null; fieldersHome(); M.phase = 'setup'; M.t = 0; M.ball.state = 'none'; M.batter.anim = null; return; }\\n  BZ.nextBatter(); fieldersHome(); M.phase = 'setup'; M.t = 0; M.pitch = null;\")\n# arrival clears stealing\nrep(\"BZ.emit('arrive', { runner: r, base: rb }); }\",\"r.stealing = false; BZ.emit('arrive', { runner: r, base: rb }); if (r.wasSteal) { } }\")\n# steal success event\nrep(\"M.steal = r; r.stealing = true;\",\"M.steal = r; r.stealing = true; r.wasSteal = true;\")\nopen(p,'w').write(s)\nEOF\nnode tests/sim2.mjs .5 | head -3","uuid":"0c62c967-7aed-4d5b-befb-a9bdec1cc13c","session_id":"ae684082-f21f-4a2b-8baf-c73d93056a9d"}
