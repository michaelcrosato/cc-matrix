2, 40, 5, '#14162a'); px.rect(g, x + 51, yy + 3, Math.round(38 * s.meter / 100), 3, s.meter >= 100 ? (Math.floor(M.clock * 6) % 2 ? '#ffee66' : '#ff7a2a') : '#ff9a30');\n    if (at) shadowText(g, '\\\\u25b8', x + 92, yy + 1, '#ffd23a');\n  }\n  shadowText(g, (M.half ? 'BOT ' : 'TOP ') + M.inn, x + 4, y + 29, '#ffd23a');\n  shadowText(g, M.balls + '-' + M.strikes, x + 40, y + 29, '#e8e8ff');\n  for (let i = 0; i < 3; i++) px.disc(g, x + 66 + i * 7, y + 32, 2, i < M.outs ? '#ff5a5a' : '#3a3a58');\n  diamond(g, x + w - 26, y + 14, M);\n};\n'''\ns=s.replace(old,new)\nopen(p,'w').write(s)\np='src/45-screens.js'\ns=open(p).read()\ns=s.replace(\"game.setZoom(.82); BZ.stage.cx = G.HX; BZ.stage.cy = G.HY - 140;\",\"game.setZoom(.6); BZ.stage.cx = G.HX; BZ.stage.cy = G.HY - 170;\")\ns=s.replace(\"let tx = G.HX, ty = G.HY - 120;\",\"let tx = G.HX, ty = G.HY - 170;\")\ns=s.replace(\"game.setZoom(.8);\",\"game.setZoom(.62);\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"const pts = \\[\\[8, 16\\]\" src/34-hud.js | head -2; python3 - <<'EOF'\np='/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-060225__x4549c1/work/BatzookaBaseball-Baseball-claude-sonnet-5-5-medium-20261104-060225/src/34-hud.js'\ns=open(p).read()\na=s.index(\"function diamond(\")\nb=s.index(\"const onBaseSafe\")\ns=s[:a]+'''function diamond(g, x, y, M) {\n  px.poly(g, [[x + 11, y], [x + 22, y + 11], [x + 11, y + 22], [x, y + 11]], 'rgba(30,34,70,.9)');\n  const occ = [false, false, false]; for (const r of M.runners) if (r.state === 'run' && onBaseSafe(r)) occ[Math.round(r.pos) - 1] = true;\n  [[1, 22, 11], [2, 11, 0], [3, 0, 11]].forEach(([b, dx, dy]) => { px.rect(g, x + dx - 3, y + dy - 3, 7, 7, occ[b - 1] ? '#ffd23a' : '#4a4a68'); });\n}\n'''+s[b:]\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs >/dev/null; node tools/shot.mjs match /tmp/s55shots/m2 wait:3500 shot:a hold:Space:60 wait:500 shot:b 2>&1 | head"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,