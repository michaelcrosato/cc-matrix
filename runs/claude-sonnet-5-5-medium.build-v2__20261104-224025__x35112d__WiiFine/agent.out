ressed |= B::PAUSE | B::BACK;\n        }\n        if right_tap {\n            pressed |= B::BACK;\n        }\n        // Schedule / Wave\n        if pad_edge(Button::North, was) || tap(KeyCode::Tab) {\n            pressed |= B::SCHEDULE;\n        }\n        if pad_edge(Button::West, was) || tap(KeyCode::KeyF) {\n            pressed |= B::WAVE;\n        }\n        // Jog\n        if input.pad.rt2 || shift {\n            held |= B::JOG;\n        }\n\n        // ---- menu navigation with repeat: d-pad, left stick, arrows, WASD\n        let dirs = [\n            padhold & bit(Button::DPadUp) != 0 || stick.y > 0.6 || k(KeyCode::ArrowUp) || k(KeyCode::KeyW),\n            padhold & bit(Button::DPadDown) != 0 || stick.y < -0.6 || k(KeyCode::ArrowDown) || k(KeyCode::KeyS),\n            padhold & bit(Button::DPadLeft) != 0 || stick.x < -0.6 || k(KeyCode::ArrowLeft) || k(KeyCode::KeyA),\n            padhold & bit(Button::DPadRight) != 0 || stick.x > 0.6 || k(KeyCode::ArrowRight) || k(KeyCode::KeyD),\n        ];\n        let bits = [B::MENU_UP, B::MENU_DOWN, B::MENU_LEFT, B::MENU_RIGHT];\n        for i in 0..4 {\n            if dirs[i] {\n                if self.rep[i] == 0.0 {\n                    pressed |= bits[i];\n                    self.rep[i] = 0.001;\n                } else {\n                    self.rep[i] += dt;\n                    if self.rep[i] > 0.38 {\n                        pressed |= bits[i];\n                        self.rep[i] = 0.28;\n                    }\n                }\n            } else {\n                self.rep[i] = 0.0;\n            }\n        }\n        // ---- the pointer on the UI\n        f.ui = ui;\n        if matches!(ui, Some(UiEvent::Click(_)) | Some(UiEvent::Slider(..))) {\n            // the UI took the click: it is not an action press\n            pressed &= !(B::ACT | B::CONFIRM | B::STEP_L | B::STEP_R | B::TAB_L | B::TAB_R);\n        }\n        // the island walk (world space, rotated by the camera)\n        let walk = if stick_active { stick_lean } else { kdir.clamp_length_max(1.0) };\n        f.move_dir = move_world(walk);\n        f.held = held | pressed;\n        f.pressed = pressed;\n        let any = pad.any_activity || !taps.is_empty() || left_tap || right_tap || moved || stick.length() > 0.3 || pad.right.length() > 0.3;\n        f.any = any;\n        self.cursor_visible = input.last_device == Device::KeyboardMouse;\n        self.prev_pad = padhold;\n        self.prev_keys = input.keys.clone();\n        f\n    }\n}\nE\npython3 - <<'E'\np='crates/pav_app/src/input.rs'\ns=open(p).read()\ns=s.replace(\"    pub back_held: bool,\\n    pub any_activity: bool,\\n}\",\"    pub back_held: bool,\\n    pub any_activity: bool,\\n    /// Fit: every held button (raw) and the two analog triggers.\\n    pub raw: Vec<gilrs::Button>,\\n    pub lt2: bool,\\n    pub rt2: bool,\\n}\",1)\ns=s.replace(\"            pad.a_held = is(Button::South);\",\"            pad.raw = st.held.clone();\\n            pad.lt2 = st.lt2;\\n            pad.rt2 = st.rt2;\\n            pad.a_held = is(Button::South);\",1)\ns=s.replace(\"    key_taps: HashSet<KeyCode>,\\n    pub mouse_taps\",\"    pub key_taps: HashSet<KeyCode>,\\n    pub mouse_taps\",1)\ns=s.replace(\"    pub fn rewind_held(&self) -> bool {\",\"    /// Fit: the keys pressed since the last call (consumed).\\n    pub fn key_taps_pub(&mut self) -> HashSet<KeyCode> {\\n        std::mem::take(&mut self.key_taps)\\n    }\\n\\n    pub fn rewind_held(&self) -> bool {\",1)\nopen(p,'w').write(s)\ns=open('crates/pav_app/src/fit_input.rs').read()\ns=s.replace(\"let taps = std::mem::take(&mut input.key_taps_pub());\",\"let taps = input.key_taps_pub();\")\ns=s.replace(\"    pub shown_lean: Vec2,\\n}\",\"    pub shown_lean: Vec2,\\n    prev_lt2: bool,\\n}\")\nopen('crates/pav_app/src/fit_input.rs','w').write(s)\nE\ngrep -n \"^mod \\|^pub mod \" crates/pav_app/src/main.rs | head -30"}}}
