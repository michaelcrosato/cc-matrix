}\"),\n        };\"\"\",\"\"\"        // The mixer lives in the stream's callback, so a failed attempt with the small buffer\n        // starts over with the device's default one.\n        let attempt = |config: cpal::StreamConfig, rx: Receiver<Cmd>| match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, clock.clone()),\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, clock.clone()),\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, clock.clone()),\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        let stream = match attempt(config.clone(), rx) {\n            Ok(s) => s,\n            Err(_) => {\n                let (tx2, rx2) = channel::<Cmd>();\n                tx_slot = tx2;\n                let mut c = config;\n                c.buffer_size = cpal::BufferSize::Default;\n                attempt(c, rx2)?\n            }\n        };\"\"\",1)\ns=s.replace(\"        let (tx, rx) = channel::<Cmd>();\\n        let clock = Arc::new(AtomicU64::new(0));\",\"        let (tx, rx) = channel::<Cmd>();\\n        let mut tx_slot = tx;\\n        let clock = Arc::new(AtomicU64::new(0));\",1)\ns=s.replace(\"        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, clock })\",\"        Ok(Self { _stream: stream, tx: tx_slot, sample_rate: rate, device: name, clock })\",1)\nopen(p,'w').write(s)\nE\n(CARGO_BUILD_JOBS=8 cargo check --locked -p pav_core -p pav_app -p pav_audio 2>&1 | grep -E \"^error\" -A12 | head -30)","uuid":"100448c2-4717-4281-a3f1-95d974878154","session_id":"6bcbd63b-6fd6-450e-b613-afa8a801fe09"}
