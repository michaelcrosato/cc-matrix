rx) = channel::<Cmd>();\n        let clock = Arc::new(AtomicU64::new(0));\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, clock.clone())?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, clock.clone())?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, clock.clone())?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, clock })''',1)\ns=s.replace('''        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n        }\n    }''','''        if let SimEvent::Music { song } = ev {\n            let _ = self.tx.send(Cmd::Song(*song));\n            return;\n        }\n        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx * ev_gain(ev), delay, bus_of(ev)));\n        }\n    }\n\n    /// Music, sound effects and voices, each 0..1.\n    pub fn set_buses(&self, music: f32, sfx: f32, voice: f32) {\n        let _ = self.tx.send(Cmd::Buses([music, sfx, voice]));\n    }\n\n    /// Seconds of the current song played (the rhythm clock's source, read each frame).\n    pub fn song_clock(&self) -> f32 {\n        self.clock.load(Ordering::Relaxed) as f32 / self.sample_rate as f32\n    }''',1)\ns=s.replace(\"fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\",\"fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize, clock: Arc<AtomicU64>) -> anyhow::Result<cpal::Stream>\",1)\ns=s.replace(\"    let mut mixer = Mixer::new(config.sample_rate as f32);\\n    let mut buf\",\"    let mut mixer = Mixer::new(config.sample_rate as f32);\\n    mixer.clock = clock;\\n    let mut b