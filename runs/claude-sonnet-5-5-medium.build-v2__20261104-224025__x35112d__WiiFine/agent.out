ape: Shape,\n47-    /// Reusable procedural prop. Its named parts replace shape/color/look for rendering.\n48-    #[serde(default)]\n49-    pub asset: Option<String>,\n50-    #[serde(default = \"one\")]\n51-    pub scale: f32,\n52-    /// A prop's variant: its chance, jitter and pick (0: as authored).\n53-    #[serde(default, skip_serializing_if = \"is_zero\")]\n54-    pub seed: u32,\n55-    /// A prop's palette: colours for the theme roles its parts name (`$wall` = \"#5a6b7c\").\n56-    #[serde(default, skip_serializing_if = \"BTreeMap::is_empty\")]\n57-    pub roles: BTreeMap<String, String>,\n58-    /// A family's knob values (`params = { height = 70 }`), over the preset `asset` names\n59-    /// (`LIB/core/fence:low`).\n60-    #[serde(default, skip_serializing_if = \"BTreeMap::is_empty\")]\n61-    pub params: crate::props::Params,\n62-    /// `asset_edit` patch ops applied to this copy only (`patch = [{ op = \"scale\", by = 0.5 }]`):\n63-    /// a one-off variant such as a defect on show. Publish a variant that rooms reuse instead.\n64-    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n65-    pub patch: Vec<serde_json::Value>,\n66-    pub pos: Vec3,\n67-    /// Rotation about the vertical axis (degrees).\n68-    #[serde(default)]\n69-    pub yaw: f32,\n70-    /// Tilt about the object's X axis and Z axis (degrees): ramps, seesaws.\n71-    #[serde(default)]\n72-    pub pitch: f32,\n73-    #[serde(default)]\n74-    pub roll: f32,\n75-    #[serde(default = \"gray\")]\n76-    pub color: String,\n77-    #[serde(default = \"dynamic\")]\n78-    pub body: BodyKind,\n79-    #[serde(default)]\n80-    pub look: Look,\n81-    #[serde(default)]\n82-    pub emissive: f32,\n83-    #[serde(default)]\n84-    pub behavior: Behavior,\n85-    #[serde(default)]\n86-    pub hazard: Option<Hazard>,\n87-    #[serde(default = \"one\")]\n88-    pub density: f32,\n89-    #[serde(default = \"half\")]\n90-    pub friction: f32,\n91-    #[serde(default)]\n92-    pub restitution: