          && p.z >= self.min.z\n78-            && p.z <= self.max.z\ncrates/pav_core/src/world.rs:385:    pub fn build_room(&mut self, id: u16) {\ncrates/pav_core/src/world.rs-386-        let Some(slot) = self.state.world.rooms.get(id as usize).cloned() else { return };\ncrates/pav_core/src/world.rs-387-        let region = RegionKey::Room(id);\ncrates/pav_core/src/world.rs-388-        let built = slot.def.layout.build_at(self, &slot.place, Some(region));\ncrates/pav_core/src/world.rs-389-        for warn in built.warnings {\ncrates/pav_core/src/world.rs-390-            log::warn!(\"room {}: {warn}\", slot.key);\ncrates/pav_core/src/world.rs-391-        }\ncrates/pav_core/src/world.rs-392-        let mut named: BTreeMap<String, EntityId> = BTreeMap::new();\ncrates/pav_core/src/world.rs-393-        for o in &slot.def.objects {\ncrates/pav_core/src/world.rs-394-            if o.asset.is_some() {\ncrates/pav_core/src/world.rs-395-                let placed = o\ncrates/pav_core/src/world.rs-396-                    .placed()\ncrates/pav_core/src/world.rs-397-                    .and_then(|(name, definition, params)| {\ncrates/pav_core/src/world.rs-398-                        crate::prop_instance::PropInstance::new(&name, definition, o.scale, o.body == BodyKind::Fixed)?\ncrates/pav_core/src/world.rs-399-                            .with_seed(o.seed)\ncrates/pav_core/src/world.rs-400-                            .with_patch(&o.patch)\ncrates/pav_core/src/world.rs-401-                            .with_params(&params)\ncrates/pav_core/src/world.rs-402-                    })\ncrates/pav_core/src/world.rs-403-                    .and_then(|copy| copy.with_roles(o.roles.clone()))\ncrates/pav_core/src/world.rs-404-                    .and_then(|copy| {\ncrates/pav_core/src/world.rs-405-                        self.place_prop(copy, slot.place.point(o.pos), slot.place.quat() * o.local_rot(), Some(region))\ncrates/pav_core/src/world.rs-406-                    });\ncrates/pav_core/sr