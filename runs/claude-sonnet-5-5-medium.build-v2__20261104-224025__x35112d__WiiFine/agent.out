 character::tick(\n581-                &mut self.state,\n582-                id,\n583-                inp,\n584-                &self.config.movement,\n585-                &self.config.bombs,\n586-                own.as_deref().unwrap_or(&self.config.puppet),\n587-                self.config.gravity,\n588-                dt,\n589-                &mut events,\n590-                &mut actions,\n591-            );","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NeXpAPVJc3dmzZunPJT9Rp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
