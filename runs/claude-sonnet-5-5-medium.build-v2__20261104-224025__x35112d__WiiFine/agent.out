dless,\n16:    overlay: Option<pav_ui::headless::Overlay>,\n53:    /// Set by the native bridge. Headless sessions do not wait for or report window frames.\n55:    /// Live requests share owner 0; independent headless sessions adopt only their own jobs.\n58:    pub ui: pav_ui::headless::Headless,\n159:            let headless = Headless::new()?;\n160:            let renderer = Renderer::new(&headless.device, &headless.queue);\n162:                headless,\n350:        input: pav_ui::headless::Input,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LbbpRdR1bJPgbHULJuMNp1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
