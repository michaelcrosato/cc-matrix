{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N6E2hYazh598k2HmC49AJ4","type":"tool_result","content":"100style\ncatalogs\ncmu\ncmu.json\nmesh2motion.json\nmoves.toml\nquaternius.json\nstyle100.json\nanim/mesh2motion.json (1.542, 8)\n{\"t\": 0, \"hips\": [-7, 0, 49], \"body\": [0, 75, 0], \"chest\": [0, -12, 0], \"head\": [0, 17, 0], \"shL\": [0, 0], \"shR\": [0, 0], \"armL\": [95, 28, -17, 61, 23], \"armR\": [95, 28, -17, 61, -23], \"legL\": [-4, 0, -100, 4, -3], \"legR\": [-4, 0, -100, 4, 3], \"footL\": [-3, 0, 48], \"footR\": [-3, 0, 48]}\n109:pub const LEGEND: &[&str] = &[\n110-    \"Readable key poses (the my-3D2dge format). Times in seconds; every other number is a whole number. Rig frame: forward, right, up.\",\n111-    \"L and R are the figure's own sides. Directions are percentages and need not add up: [100, 0, 0] and [50, 0, 0] agree.\",\n112-    \"hips   [forward, right, up]   the pelvis, in percent of standing hip height (100 = standing, 55 = sitting on a chair)\",\n113-    \"body   [turn, lean, tilt]     the pelvis, degrees: turn + = toward the right, lean + = forward, tilt + = toward the right\",\n114-    \"chest  [turn, lean, tilt]     the chest, relative to the pelvis; head [turn, lean, tilt] relative to the chest\",\n115-    \"shL shR    [reach, shrug]     degrees the shoulder swings forward (into a punch or an aim) and up, from rest\",\n116-    \"armL armR  [forward, out, up, bend, twist]  which way the arm points from the shoulder to the fist, in chest space (out + = away from the body on that side; [0, 0, -100] hangs down, [100, 0, 0] punches ahead); bend = elbow bend in degrees (0 = straight); twist = degrees the elbow swings round the arm from its natural direction (back and down)\",\n117-    \"legL legR  [forward, out, up, bend, twist]  hip to ankle in pelvis space; bend: the knee; twist: from pointing forward\",\n118-    \"footL footR [down, out, toes]   degrees the foot points down from standing, turns outward, and the toes bend up\",\n119-    \"blade  [forward, right, up]   (sword clips) the direction of a blade held in the right fist, in chest space\",\n120-    \"root   [forward, right]       (clips that travel) how far the whole body has moved, in percent of standing hip height\",\n121-    \"speed  (a clip's header: loops that walk or run in place) how fast the capture travelled, percent of standing hip height a second\",\n122-];\n123-\n124-/// One clip.\n125-#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n126-#[serde(deny_unknown_fields)]\n127-pub struct Clip {\n128-    /// Its name within the set (filled in from the set's key when absent).\n129-    #[serde(default)]\n130-    pub clip: String,\n131-    /// Which of the set's sources it came from.\n132-    #[serde(default, skip_serializing_if = \"String::is_empty\")]\n133-    pub src: String,\n134-    /// What it was cut from: the source's own clip name, or a capture database's take.\n135-    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n136-    pub orig: Option<String>,\n137-    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n138-    pub take: Option<String>,\n139-    pub dur: f32,\n140-    #[serde(rename = \"loop\", default)]\n141-    pub looping: bool,\n142-    /// A loop that walks or runs in place: how fast its capture travelled, in percent of\n143-    /// standing hip height a second (`walk_rate` matches it to a character's ground speed).\n144-    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n145-    pub speed: Option<f32>,\n146-    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n147-    pub tags: Vec<String>,\n148-    #[serde(default, skip_serializing_if = \"String::is_empty\")]\n149-    pub desc: String,","is_error":false}]},"parent_tool_use_id":null,"session_id":"6bcbd63b-6fd6-450e-b613-afa8a801fe09","uuid":"c6979089-3260-42df-a5fd-0796b0b57219","timestamp":"2026-11-05T06:02:14.605Z","tool_use_result":{"stdout":"100style\ncatalogs\ncmu