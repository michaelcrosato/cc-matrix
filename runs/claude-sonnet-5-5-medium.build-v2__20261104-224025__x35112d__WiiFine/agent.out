ings | Screen::About | Screen::HowTo | Screen::Calendar | Screen::Wardrobe | Screen::Schedule | Screen::ConfirmReset | Screen::Dev => {\n                self.stack.pop();\n                self.focus = 0;\n            }\"\"\",1)\nopen(p,'w').write(s)\n# fit_ui: dev overlays + pages drawing\np='crates/pav_ui/src/fit_ui.rs'\ns=open(p).read()\ns=s.replace(\"\"\"    if f.demo {\n        let r = Rect::from_min_size(Pos2::new(40.0 * s, 40.0 * s), vec2(260.0, 76.0) * s);\"\"\",\"\"\"    if let Some((lean, held)) = f.dev_input {\n        let r = Rect::from_min_size(Pos2::new(screen.max.x - 520.0 * s, 220.0 * s), vec2(480.0, 140.0) * s);\n        cx.p.rect_filled(r, 24.0 * s, Color32::from_black_alpha(150));\n        cx.text(r.min + vec2(24.0 * s, 40.0 * s), Align2::LEFT_CENTER, &format!(\"lean {:+.2} {:+.2}\", lean[0], lean[1]), 34.0, false, Color32::WHITE);\n        cx.text(r.min + vec2(24.0 * s, 100.0 * s), Align2::LEFT_CENTER, &format!(\"held {:#x}\", held), 34.0, false, Color32::WHITE);\n    }\n    if !f.dev_trace.is_empty() {\n        let r = Rect::from_min_size(Pos2::new(40.0 * s, screen.max.y - 420.0 * s), vec2(300.0, 300.0) * s);\n        cx.p.rect_filled(r, 24.0 * s, Color32::from_black_alpha(110));\n        let pts: Vec<Pos2> = f.dev_trace.iter().map(|t| r.center() + vec2(t[0], -t[1]) * 130.0 * s).collect();\n        cx.p.add(egui::Shape::line(pts, Stroke::new(3.0 * s, SUN)));\n    }\n    if !f.stats.is_empty() {\n        cx.text(Pos2::new(40.0 * s, screen.max.y - 40.0 * s), Align2::LEFT_CENTER, &f.stats, 34.0, false, Color32::WHITE);\n    }\n    if f.demo {\n        let r = Rect::from_min_size(Pos2::new(40.0 * s, 40.0 * s), vec2(260.0, 76.0) * s);\"\"\",1)\ns=s.replace(\"    let h = (290.0 + rows as f32 * 98.0 + if has_lines { 110.0 * f.lines.len().min(3) as f32 } else { 0.0 }\",\"    let page_rows = if matches!(f.layout, Layout::Pages) { f.lines.len().min(8) as f32 } else { 0.0 };\\n    let h = (290.0 + rows as f32 * 98.0 + page_rows * 54.0 + if has_lines && page_rows == 0.0 { 110.0 * f.lines.len().min(3) as f32 } else { 0.0 }\",1)\ns=s.replace(\"\"\"        _ => {\n            for l in f.lines.iter().take(4) {\n                let (a, b) = split_lines(l, if matches!(f.layout, Layout::Pages) { 64 } else { 48 });\"\"\",\"\"\"        Layout::Pages => {\n            for l in f.lines.iter().take(8) {\n                cx.text(Pos2::new(r.min.x + 90.0 * s, y), Align2::LEFT_CENTER, l, 36.0, false, INK);\n                y += 54.0 * s;\n            }\n            y += 20.0 * s;\n        }\n        _ => {\n            for l in f.lines.iter().take(4) {\n                let (a, b) = split_lines(l, 48);\"\"\",1)\nopen(p,'w').write(s)\nE\n(CARGO_BUILD_JOBS=8 cargo check --locked -p pav_core -p pav_ui 2>&1 | grep -E \"^error\" -A9 | head -30)"}}}
