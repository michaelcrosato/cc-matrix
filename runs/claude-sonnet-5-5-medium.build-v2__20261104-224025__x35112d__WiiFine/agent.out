{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjFMRaJPbZ3ckwijnpsb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XJ2FG5vv2dYVHsjtRkorrh","name":"Bash","input":{"command":"mkdir -p crates/pav_core/src/games/fit/sets && cd crates/pav_core/src/games/fit && cat > core.rs <<'E'\n//! The Balance Core: one analog dot driven by lean, used by every event.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse crate::rng::Rng;\n\n/// Tunable numbers of the core (`rules.toml` `[core]`).\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct CoreRules {\n    pub stiffness: f32,\n    pub damping: f32,\n    pub reach: f32,\n    pub tip_time: f32,\n    pub wobble: f32,\n    pub kick: f32,\n    pub stick_deadzone: f32,\n    pub stick_curve: f32,\n    pub key_rate: f32,\n    pub key_return: f32,\n    pub mouse_span: f32,\n}\n\nimpl Default for CoreRules {\n    fn default() -> Self {\n        Self {\n            stiffness: 40.0,\n            damping: 8.5,\n            reach: 0.92,\n            tip_time: 0.35,\n            wobble: 0.12,\n            kick: 0.1,\n            stick_deadzone: 0.12,\n            stick_curve: 1.5,\n            key_rate: 1.6,\n            key_return: 1.2,\n            mouse_span: 0.38,\n        }\n    }\n}\n\nimpl crate::params::Tunable for CoreRules {\n    fn visit(&mut self, v: &mut dyn crate::params::ParamVisitor) {\n        v.float(\"stiffness\", &mut self.stiffness, 10.0, 90.0, \"How hard the dot is pulled to your lean\");\n        v.float(\"damping\", &mut self.damping, 2.0, 20.0, \"How quickly the dot settles\");\n        v.float(\"reach\", &mut self.reach, 0.5, 1.2, \"How far full lean pushes the dot\");\n        v.float(\"tip_time\", &mut self.tip_time, 0.1, 1.5, \"Seconds outside the disc before a tip\");\n        v.float(\"wobble\", &mut self.wobble, 0.0, 0.4, \"Base wobble amplitude\");\n        v.float(\"kick\", &mut self.kick, 0.0, 0.4, \"Random velocity kicks (units/s)\");\n        v.float(\"stick_deadzone\", &mut self.stick_deadzone, 0.0, 0.4, \"Stick deadzone\");\n        v.float(\"stick_curve\", &mut self.stick_curve, 1.0, 3.0, \"Stick response exponent\");\n        v.float(\"key_rate\", &mut self.key_rate, 0.5, 4.0, \"Keyboard lean rate (units/s)\");\n        v.float(\"key_return\", &mut self.key_return, 0.5, 4.0, \"Keyboard return rate (units/s)\");\n        v.float(\"mouse_span\", &mut self.mouse_span, 0.15, 0.8, \"Mouse offset for full lean (window heights)\");\n    }\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct BalanceCore {\n    pub cob: Vec2,\n    pub vel: Vec2,\n    pub phase_a: Vec2,\n    pub phase_b: Vec2,\n    pub t: f32,\n    pub kick_in: f32,\n    pub kick_vel: Vec2,\n    /// Seconds spent outside the disc.\n    pub outside: f32,\n    pub tipped: bool,\n    /// Wobble multiplier (event, fatigue, gull...).\n    pub wobble_scale: f32,\n    /// External shove (gusts), units/s^2.\n    pub gust: Vec2,\n    /// Constant posture offset added to the target (Balance Age slump).\n    pub slump: Vec2,\n    /// Wobble assist setting, 0 (off) to 1.\n    pub assist: f32,\n}\n\nimpl Default for BalanceCore {\n    fn default() -> Self {\n        Self {\n            cob: Vec2::ZERO,\n            vel: Vec2::ZERO,\n            phase_a: Vec2::ZERO,\n            phase_b: Vec2::ZERO,\n            t: 0.0,\n            kick_in: 1.0,\n            kick_vel: Vec2::ZERO,\n            outside: 0.0,\n            tipped: false,\n            wobble_scale: 1.0,\n            gust: Vec2::ZERO,\n            slump: Vec2::ZERO,\n            assist: 0.0,\n        }\n    }\n}\n\nimpl BalanceCore {\n    pub fn new(rng: &mut Rng) -> Self {\n        let tau = std::f32::consts::TAU;\n        Self {\n            phase_a: Vec2::new(rng.range(0.0, tau), rng.range(0.0, tau)),\n            phase_b: Vec2::new(rng.range(0.0, tau), rng.range(0.0, tau)),\n            ..Default::default()\n        }\n    }\n\n    pub fn reset(&mut self) {\n        self.cob = Vec2::ZERO;\n        self.vel = Vec2::ZERO;\n        self.outside = 0.0;\n        self.tipped = false;\n        self.gust = Vec2::ZERO;\n    }\n\n    /// The wobble signal at time `t`.\n    pub fn wobble(&self, amp: f32) -> Vec2 {\n        let tau = std::f32::consts::TAU;\n        let f = |a: f32, b: f32| amp * (0.7 * (tau * 1.3 * self.t + a).sin() + 0.3 * (tau * 2.9 * self.t + b).sin());\n        Vec2::new(f(self.phase_a.x, self.phase_b.x), f(self.phase_a.y, self.phase_b.y))\n    }\n\n    /// One tick. `lean` is the shaped lean on screen axes; `nudge` an extra acceleration.\n    /// Returns true on the tick a tip happens.\n    pub fn step(&mut self, r: &CoreRules, lean: Vec2, nudge: Vec2, dt: f32, rng: &mut Rng) -> bool {\n        self.t += dt;\n        self.kick_in -= dt;\n        if self.kick_in <= 0.0 {\n            self.kick_in = rng.range(1.0, 2.0);\n            let a = rng.range(0.0, std::f32::consts::TAU);\n            self.kick_vel = Vec2::new(a.cos(), a.sin()) * r.kick * self.wobble_scale.min(2.0);\n            self.vel += self.kick_vel;\n        }\n        let amp = r.wobble * self.wobble_scale * (1.0 - 0.5 * self.assist);\n        let target = lean.clamp_length_max(1.0) * r.reach + self.wobble(amp) + self.slump;\n        let acc = (target - self.cob) * r.stiffness - self.vel * r.damping + self.gust + nudge;\n        self.vel += acc * dt;\n        self.cob += self.vel * dt;\n        let mut tipped_now = false;\n        if self.cob.length() > 1.0 {\n            self.outside += dt;\n            if self.outside >= r.tip_time && !self.tipped {\n                self.tipped = true;\n                tipped_now = true;\n            }\n        } else {\n            self.outside = 0.0;\n            self.tipped = false;\n        }\n        tipped_now\n    }\n}\n\n/// Shapes a stick into lean (deadzone and curve).\npub fn shape_stick(raw: Vec2, dead: f32, curve: f32) -> Vec2 {\n    let m = raw.length();\n    if m <= dead {\n        return Vec2::ZERO;\n    }\n    let n = ((m - dead) / (1.0 - dead)).clamp(0.0, 1.0);\n    raw / m * n.powf(curve)\n}\nE\ncat > rules.rs <<'E'\n//! Every balance number of the game, in `rules.toml` (hot-reloads from disk when running from\n//! the repository) and tunable live from Dev Mode.\n\nuse serde::{Deserialize, Serialize};\n\nuse super::core::CoreRules;\nuse crate::params::{ParamVisitor, Tunable};\n\nmacro_rules! rules_struct {\n    ($name:ident { $($f:ident : $t:ty = $d:expr, $min:expr, $max:expr, $help:expr;)* }) => {\n        #[derive(Clone, Debug, Serialize, Deserialize)]\n        #[serde(default)]\n        pub struct $name { $(pub $f: $t,)* }\n        impl Default for $name { fn default() -> Self { Self { $($f: $d,)* } } }\n        impl Tunable for $name {\n            fn visit(&mut self, v: &mut dyn ParamVisitor) {\n                $( rules_field!(v, self.$f, $t, $min, $max, $help, stringify!($f)); )*\n            }\n        }\n    };\n}\nmacro_rules! rules_field {\n    ($v:ident, $field:expr, f32, $min:expr, $max:expr, $help:expr, $n:expr) => { $v.float($n, &mut $field, $min as f32, $max as f32, $help); };\n    ($v:ident, $field:expr, i32, $min:expr, $max:expr, $help:expr, $n:expr) => { $v.int($n, &mut $field, $min as i32, $max as i32, $help); };\n}\n\nrules_struct!(BreathRules {\n    seconds: f32 = 45.0, 20, 80, \"Length of the event (s)\";\n    inhale: f32 = 4.0, 2, 8, \"Seconds in per cycle\";\n    ring: f32 = 0.35, 0.15, 0.6, \"Radius of the centre ring\";\n    wobble: f32 = 0.7, 0.0, 2.0, \"Wobble scale\";\n});\nrules_struct!(PoseRules {\n    pose_seconds: f32 = 20.0, 8, 40, \"Seconds per pose\";\n    ring_start: f32 = 0.30, 0.15, 0.5, \"Target ring radius at the start\";\n    ring_end: f32 = 0.18, 0.1, 0.4, \"Target ring radius at the end\";\n    drift_amp: f32 = 0.35, 0.0, 0.7, \"Ring drift amplitude\";\n    drift_hz: f32 = 0.12, 0.02, 0.4, \"Ring drift frequency\";\n    step_secs: f32 = 2.0, 0.5, 5, \"Seconds per streak step\";\n    gull_wobble: f32 = 1.6, 1.0, 3.0, \"Wobble scale with a gull on your head\";\n    wobble: f32 = 1.0, 0.0, 2.5, \"Wobble scale\";\n});\nrules_struct!(SquatRules {\n    reps: i32 = 10, 3, 15, \"Repetitions\";\n    down_secs: f32 = 2.0, 0.8, 4, \"Seconds to full depth\";\n    up_secs: f32 = 1.0, 0.5, 3, \"Seconds to rise\";\n    band: f32 = 0.25, 0.1, 0.5, \"Allowed sideways lean\";\n    growth: f32 = 0.08, 0.0, 0.3, \"Wobble growth per rep\";\n});\nrules_struct!(PlankRules {\n    max_secs: f32 = 60.0, 30, 90, \"Longest plank (s)\";\n    ring_start: f32 = 0.40, 0.2, 0.6, \"Ring radius at the start\";\n    ring_end: f32 = 0.20, 0.1, 0.4, \"Ring radius at the end\";\n    leave_secs: f32 = 1.0, 0.3, 3, \"Seconds outside the ring before collapse\";\n    fatigue: f32 = 1.0, 0.0, 3, \"Fatigue ramp\";\n});\nrules_struct!(StepRules {\n    bpm: f32 = 96.0, 60, 140, \"Tempo\";\n    perfect_ms: f32 = 55.0, 20, 120, \"Perfect window (ms)\";\n    good_ms: f32 = 120.0, 40, 250, \"Good window (ms)\";\n    seconds: f32 = 64.0, 30, 90, \"Length (s)\";\n});\nrules_struct!(FloatieRules {\n    seconds: f32 = 50.0, 20, 90, \"Length (s)\";\n    band_lo: f32 = 6.0, 2, 10, \"Sweet band low (rad/s)\";\n    band_hi: f32 = 9.0, 5, 14, \"Sweet band high (rad/s)\";\n    spin_band_scale: f32 = 1.0, 0.5, 2.5, \"Band width multiplier (keyboard)\";\n    catch_window: f32 = 0.25, 0.1, 0.6, \"Seconds to catch a ring\";\n    switch_secs: f32 = 15.0, 5, 30, \"Seconds between direction switches\";\n});\nrules_struct!(LapRules {\n    seconds: f32 = 90.0, 40, 150, \"Length (s)\";\n    zone_lo: f32 = 1.6, 0.8, 3, \"Pace zone low (steps/s)\";\n    zone_hi: f32 = 2.4, 1.5, 4, \"Pace zone high (steps/s)\";\n    stitch_rate: f32 = 0.5, 0.1, 2, \"Stitch growth when too fast\";\n});\nrules_struct!(TideRules {\n    gravity: f32 = 6.0, 2, 14, \"Tilt gravity\";\n    friction: f32 = 1.4, 0.2, 4, \"Shell friction\";\n    seconds: f32 = 60.0, 30, 100, \"Total time (s)\";\n});\nrules_struct!(PaddleRules {\n    par: f32 = 36.0, 20, 70, \"Par time (s)\";\n    gust: f32 = 1.2, 0.0, 4, \"Gust strength\";\n    gate_penalty: f32 = 2.0, 0.0, 6, \"Seconds added for a missed gate\";\n    speed: f32 = 4.0, 2, 8, \"Cruising speed (m/s)\";\n});\nrules_struct!(TrayRules {\n    seconds: f32 = 50.0, 25, 90, \"Length (s)\";\n    jolt: f32 = 1.0, 0.0, 3, \"Jolt strength\";\n    slide: f32 = 1.0, 0.3, 3, \"How easily glasses slide\";\n});\nrules_struct!(DiveRules {\n    period: f32 = 1.2, 0.8, 2, \"Board bounce period (s)\";\n    gain: f32 = 1.0, 0.3, 2.5, \"Bounce power gain\";\n});\nrules_struct!(StandRules {\n    gust: f32 = 1.0, 0.0, 3, \"Big Stand gusts\";\n    stillness: f32 = 30.0, 10, 60, \"The Long Stillness (s)\";\n});\nrules_struct!(CheckRules {\n    still_secs: f32 = 8.0, 4, 14, \"Stand Still length (s)\";\n    blind_secs: f32 = 6.0, 3, 12, \"Eyes Closed length (s)\";\n});\n\n#[derive(Clone, Debug, Serialize, Deserialize, Default)]\n#[serde(default)]\npub struct Rules {\n    pub core: CoreRules,\n    pub breath: BreathRules,\n    pub pose: PoseRules,\n    pub squat: SquatRules,\n    pub plank: PlankRules,\n    pub step: StepRules,\n    pub floatie: FloatieRules,\n    pub lap: LapRules,\n    pub tide: TideRules,\n    pub paddle: PaddleRules,\n    pub tray: TrayRules,\n    pub dive: DiveRules,\n    pub stand: StandRules,\n    pub check: CheckRules,\n}\n\nimpl Tunable for Rules {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        crate::params::nested(v, \"core\", &mut self.core);\n        crate::params::nested(v, \"breath\", &mut self.breath);\n        crate::params::nested(v, \"pose\", &mut self.pose);\n        crate::params::nested(v, \"squat\", &mut self.squat);\n        crate::params::nested(v, \"plank\", &mut self.plank);\n        crate::params::nested(v, \"step\", &mut self.step);\n        crate::params::nested(v, \"floatie\", &mut self.floatie);\n        crate::params::nested(v, \"lap\", &mut self.lap);\n        crate::params::nested(v, \"tide\", &mut self.tide);\n        crate::params::nested(v, \"paddle\", &mut self.paddle);\n        crate::params::nested(v, \"tray\", &mut self.tray);\n        crate::params::nested(v, \"dive\", &mut self.dive);\n        crate::params::nested(v, \"stand\", &mut self.stand);\n        crate::params::nested(v, \"check\", &mut self.check);\n    }\n}\n\nimpl Rules {\n    /// Parses `rules.toml` (missing keys keep their defaults).\n    pub fn parse(text: &str) -> Result<Rules, String> {\n        toml::from_str(text).map_err(|e| e.to_string())\n    }\n}\nE\necho \"# Every balance number. Keys left out keep their defaults (rules.rs). Hot-reloads from disk.\" > rules.toml\ncat >> rules.toml <<'E'\n[core]\nstiffness = 40.0\ndamping = 8.5\nreach = 0.92\ntip_time = 0.35\nwobble = 0.12\nE\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4396,"cache_read_input_tokens":137929,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4396},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6bcbd63b-6fd6-450e-b613-afa8a801fe09","uuid":"0789c128-41d8-4fd1-94dc-69253acadfe9","timestamp":"2026-11-05T05:43:35.894Z","request_id":"req_011CgjFMRMu62CgfH8FAkn5W","wire_tool_inputs":{"toolu_01XJ2FG5vv2dYVHsjtRkorrh":{"command":"mkdir -p crates/pav_core/src/games/fit/sets && cd crates/pav_core/src/games/fit && cat > core.rs <<'E'\n//! The Balance Core: one analog dot driven by lean, used by every event.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse crate::rng::Rng;\n\n/// Tunable numbers of the core (`rules.toml` `[core]`).\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct CoreRules {\n    pub stiffness: f32,\n    pub damping: f32,\n    pub reach: f32,\n    pub tip_time: f32,\n    pub wobble: f32,\n    pub kick: f32,\n    pub stick_deadzone: f32,\n    pub stick_curve: f32,\n    pub key_rate: f32,\n    pub key_return: f32,\n    pub mouse_span: f32,\n}\n\nimpl Default for CoreRules {\n    fn default() -> Self {\n        Self {\n            stiffness: 40.0,\n            damping: 8.5,\n            reach: 0.92,\n            tip_time: 0.35,\n            wobble: 0.12,\n            kick: 0.1,\n            stick_deadzone: 0.12,\n            stick_curve: 1.5,\n            key_rate: 1.6,\n            key_return: 1.2,\n            mouse_span: 0.38,\n        }\n    }\n}\n\nimpl crate::params::Tunable for CoreRules {\n    fn visit(&mut self, v: &mut dyn crate::params::ParamVisitor) {\n        v.float(\"stiffness\", &mut self.stiffness, 10.0, 90.0, \"How hard the dot is pulled to your lean\");\n        v.float(\"damping\", &mut self.damping, 2.0, 20.0, \"How quickly the dot settles\");\n        v.float(\"reach\", &mut self.reach, 0.5, 1.2, \"How far full lean pushes the dot\");\n        v.float(\"tip_time\", &mut self.tip_time, 0.1, 1.5, \"Seconds outside the disc before a tip\");\n        v.float(\"wobble\", &mut self.wobble, 0.0, 0.4, \"Base wobble amplitude\");\n        v.float(\"kick\", &mut self.kick, 0.0, 0.4, \"Random velocity kicks (units/s)\");\n        v.float(\"stick_deadzone\", &mut self.stick_deadzone, 0.0, 0.4, \"Stick deadzone\");\n        v.float(\"stick_curve\", &mut self.stick_curve, 1.0, 3.0, \"Stick response exponent\");\n        v.float(\"key_rate\", &mut self.key_rate, 0.5, 4.0, \"Keyboard lean rate (units/s)\");\n        v.float(\"key_return\", &mut self.key_return, 0.5, 4.0, \"Keyboard return rate (units/s)\");\n        v.float(\"mouse_span\", &mut self.mouse_span, 0.15, 0.8, \"Mouse offset for full lean (window heights)\");\n    }\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct BalanceCore {\n    pub cob: Vec2,\n    pub vel: Vec2,\n    pub phase_a: Vec2,\n    pub phase_b: Vec2,\n    pub t: f32,\n    pub kick_in: f32,\n    pub kick_vel: Vec2,\n    /// Seconds spent outside the disc.\n    pub outside: f32,\n    pub tipped: bool,\n    /// Wobble multiplier (event, fatigue, gull...).\n    pub wobble_scale: f32,\n    /// External shove (gusts), units/s^2.\n    pub gust: Vec2,\n    /// Constant posture offset added to the target (Balance Age slump).\n    pub slump: Vec2,\n    /// Wobble assist setting, 0 (off) to 1.\n    pub assist: f32,\n}\n\nimpl Default for BalanceCore {\n    fn default() -> Self {\n        Self {\n            cob: Vec2::ZERO,\n            vel: Vec2::ZERO,\n            phase_a: Vec2::ZERO,\n            phase_b: Vec2::ZERO,\n            t: 0.0,\n            kick_in: 1.0,\n            kick_vel: Vec2::ZERO,\n            outside: 0.0,\n            tipped: false,\n            wobble_scale: 1.0,\n            gust: Vec2::ZERO,\n            slump: Vec2::ZERO,\n            assist: 0.0,\n        }\n    }\n}\n\nimpl BalanceCore {\n    pub fn new(rng: &mut Rng) -> Self {\n        let tau = std::f32::consts::TAU;\n        Self {\n            phase_a: Vec2::new(rng.range(0.0, tau), rng.range(0.0, tau)),\n            phase_b: Vec2::new(rng.range(0.0, tau), rng.range(0.0, tau)),\n            ..Default::default()\n        }\n    }\n\n    pub fn reset(&mut self) {\n        self.cob = Vec2::ZERO;\n        self.vel = Vec2::ZERO;\n        self.outside = 0.0;\n        self.tipped = false;\n        self.gust = Vec2::ZERO;\n    }\n\n    /// The wobble signal at time `t`.\n    pub fn wobble(&self, amp: f32) -> Vec2 {\n        let tau = std::f32::consts::TAU;\n        let f = |a: f32, b: f32| amp * (0.7 * (tau * 1.3 * self.t + a).sin() + 0.3 * (tau * 2.9 * self.t + b).sin());\n        Vec2::new(f(self.phase_a.x, self.phase_b.x), f(self.phase_a.y, self.phase_b.y))\n    }\n\n    /// One tick. `lean` is the shaped lean on screen axes; `nudge` an extra acceleration.\n    /// Returns true on the tick a tip happens.\n    pub fn step(&mut self, r: &CoreRules, lean: Vec2, nudge: Vec2, dt: f32, rng: &mut Rng) -> bool {\n        self.t += dt;\n        self.kick_in -= dt;\n        if self.kick_in <= 0.0 {\n            self.kick_in = rng.range(1.0, 2.0);\n            let a = rng.range(0.0, std::f32::consts::TAU);\n            self.kick_vel = Vec2::new(a.cos(), a.sin()) * r.kick * self.wobble_scale.min(2.0);\n            self.vel += self.kick_vel;\n        }\n        let amp = r.wobble * self.wobble_scale * (1.0 - 0.5 * self.assist);\n        let target = lean.clamp_length_max(1.0) * r.reach + self.wobble(amp) + self.slump;\n        let acc = (target - self.cob) * r.stiffness - self.vel * r.damping + self.gust + nudge;\n        self.vel += acc * dt;\n        self.cob += self.vel * dt;\n        let mut tipped_now = false;\n        if self.cob.length() > 1.0 {\n            self.outside += dt;\n            if self.outside >= r.tip_time && !self.tipped {\n                self.tipped = true;\n                tipped_now = true;\n            }\n        } else {\n            self.outside = 0.0;\n            self.tipped = false;\n        }\n        tipped_now\n    }\n}\n\n/// Shapes a stick into lean (deadzone and curve).\npub fn shape_stick(raw: Vec2, dead: f32, curve: f32) -> Vec2 {\n    let m = raw.length();\n    if m <= dead {\n        return Vec2::ZERO;\n    }\n    let n = ((m - dead) / (1.0 - dead)).clamp(0.0, 1.0);\n    raw / m * n.powf(curve)\n}\nE\ncat > rules.rs <<'E'\n//! Every balance number of the game, in `rules.toml` (hot-reloads from disk when running from\n//! the repository) and tunable live from Dev Mode.\n\nuse serde::{Deserialize, Serialize};\n\nuse super::core::CoreRules;\nuse crate::params::{ParamVisitor, Tunable};\n\nmacro_rules! rules_struct {\n    ($name:ident { $($f:ident : $t:ty = $d:expr, $min:expr, $max:expr, $help:expr;)* }) => {\n        #[derive(Clone, Debug, Serialize, Deserialize)]\n        #[serde(default)]\n        pub struct $name { $(pub $f: $t,)* }\n        impl Default for $name { fn default() -> Self { Self { $($f: $d,)* } } }\n        impl Tunable for $name {\n            fn visit(&mut self, v: &mut dyn ParamVisitor) {\n                $( rules_field!(v, self.$f, $t, $min, $max, $help, stringify!($f)); )*\n            }\n        }\n    };\n}\nmacro_rules! rules_field {\n    ($v:ident, $field:expr, f32, $min:expr, $max:expr, $help:expr, $n:expr) => { $v.float($n, &mut $field, $min as f32, $max as f32, $help); };\n    ($v:ident, $field:expr, i32, $min:expr, $max:expr, $help:expr, $n:expr) => { $v.int($n, &mut $field, $min as i32, $max as i32, $help); };\n}\n\nrules_struct!(BreathRules {\n    seconds: f32 = 45.0, 20, 80, \"Length of the event (s)\";\n    inhale: f32 = 4.0, 2, 8, \"Seconds in per cycle\";\n    ring: f32 = 0.35, 0.15, 0.6, \"Radius of the centre ring\";\n    wobble: f32 = 0.7, 0.0, 2.0, \"Wobble scale\";\n});\nrules_struct!(PoseRules {\n    pose_seconds: f32 = 20.0, 8, 40, \"Seconds per pose\";\n    ring_start: f32 = 0.30, 0.15, 0.5, \"Target ring radius at the start\";\n    ring_end: f32 = 0.18, 0.1, 0.4, \"Target ring radius at the end\";\n    drift_amp: f32 = 0.35, 0.0, 0.7, \"Ring drift amplitude\";\n    drift_hz: f32 = 0.12, 0.02, 0.4, \"Ring drift frequency\";\n    step_secs: f32 = 2.0, 0.5, 5, \"Seconds per streak step\";\n    gull_wobble: f32 = 1.6, 1.0, 3.0, \"Wobble scale with a gull on your head\";\n    wobble: f32 = 1.0, 0.0, 2.5, \"Wobble scale\";\n});\nrules_struct!(SquatRules {\n    reps: i32 = 10, 3, 15, \"Repetitions\";\n    down_secs: f32 = 2.0, 0.8, 4, \"Seconds to full depth\";\n    up_secs: f32 = 1.0, 0.5, 3, \"Seconds to rise\";\n    band: f32 = 0.25, 0.1, 0.5, \"Allowed sideways lean\";\n    growth: f32 = 0.08, 0.0, 0.3, \"Wobble growth per rep\";\n});\nrules_struct!(PlankRules {\n    max_secs: f32 = 60.0, 30, 90, \"Longest plank (s)\";\n    ring_start: f32 = 0.40, 0.2, 0.6, \"Ring radius at the start\";\n    ring_end: f32 = 0.20, 0.1, 0.4, \"Ring radius at the end\";\n    leave_secs: f32 = 1.0, 0.3, 3, \"Seconds outside the ring before collapse\";\n    fatigue: f32 = 1.0, 0.0, 3, \"Fatigue ramp\";\n});\nrules_struct!(StepRules {\n    bpm: f32 = 96.0, 60, 140, \"Tempo\";\n    perfect_ms: f32 = 55.0, 20, 120, \"Perfect window (ms)\";\n    good_ms: f32 = 120.0, 40, 250, \"Good window (ms)\";\n    seconds: f32 = 64.0, 30, 90, \"Length (s)\";\n});\nrules_struct!(FloatieRules {\n    seconds: f32 = 50.0, 20, 90, \"Length (s)\";\n    band_lo: f32 = 6.0, 2, 10, \"Sweet band low (rad/s)\";\n    band_hi: f32 = 9.0, 5, 14, \"Sweet band high (rad/s)\";\n    spin_band_scale: f32 = 1.0, 0.5, 2.5, \"Band width multiplier (keyboard)\";\n    catch_window: f32 = 0.25, 0.1, 0.6, \"Seconds to catch a ring\";\n    switch_secs: f32 = 15.0, 5, 30, \"Seconds between direction switches\";\n});\nrules_struct!(LapRules {\n    seconds: f32 = 90.0, 40, 150, \"Length (s)\";\n    zone_lo: f32 = 1.6, 0.8, 3, \"Pace zone low (steps/s)\";\n    zone_hi: f32 = 2.4, 1.5, 4, \"Pace zone high (steps/s)\";\n    stitch_rate: f32 = 0.5, 0.1, 2, \"Stitch growth when too fast\";\n});\nrules_struct!(TideRules {\n    gravity: f32 = 6.0, 2, 14, \"Tilt gravity\";\n    friction: f32 = 1.4, 0.2, 4, \"Shell friction\";\n    seconds: f32 = 60.0, 30, 100, \"Total time (s)\";\n});\nrules_struct!(PaddleRules {\n    par: f32 = 36.0, 20, 70, \"Par time (s)\";\n    gust: f32 = 1.2, 0.0, 4, \"Gust strength\";\n    gate_penalty: f32 = 2.0, 0.0, 6, \"Seconds added for a missed gate\";\n    speed: f32 = 4.0, 2, 8, \"Cruising speed (m/s)\";\n});\nrules_struct!(TrayRules {\n    seconds: f32 = 50.0, 25, 90, \"Length (s)\";\n    jolt: f32 = 1.0, 0.0, 3, \"Jolt strength\";\n    slide: f32 = 1.0, 0.3, 3, \"How easily glasses slide\";\n});\nrules_struct!(DiveRules {\n    period: f32 = 1.2, 0.8, 2, \"Board bounce period (s)\";\n    gain: f32 = 1.0, 0.3, 2.5, \"Bounce power gain\";\n});\nrules_struct!(StandRules {\n    gust: f32 = 1.0, 0.0, 3, \"Big Stand gusts\";\n    stillness: f32 = 30.0, 10, 60, \"The Long Stillness (s)\";\n});\nrules_struct!(CheckRules {\n    still_secs: f32 = 8.0, 4, 14, \"Stand Still length (s)\";\n    blind_secs: f32 = 6.0, 3, 12, \"Eyes Closed length (s)\";\n});\n\n#[derive(Clone, Debug, Serialize, Deserialize, Default)]\n#[serde(default)]\npub struct Rules {\n    pub core: CoreRules,\n    pub breath: BreathRules,\n    pub pose: PoseRules,\n    pub squat: SquatRules,\n    pub plank: PlankRules,\n    pub step: StepRules,\n    pub floatie: FloatieRules,\n    pub lap: LapRules,\n    pub tide: TideRules,\n    pub paddle: PaddleRules,\n    pub tray: TrayRules,\n    pub dive: DiveRules,\n    pub stand: StandRules,\n    pub check: CheckRules,\n}\n\nimpl Tunable for Rules {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        crate::params::nested(v, \"core\", &mut self.core);\n        crate::params::nested(v, \"breath\", &mut self.breath);\n        crate::params::nested(v, \"pose\", &mut self.pose);\n        crate::params::nested(v, \"squat\", &mut self.squat);\n        crate::params::nested(v, \"plank\", &mut self.plank);\n        crate::params::nested(v, \"step\", &mut self.step);\n        crate::params::nested(v, \"floatie\", &mut self.floatie);\n        crate::params::nested(v, \"lap\", &mut self.lap);\n        crate::params::nested(v, \"tide\", &mut self.tide);\n        crate::params::nested(v, \"paddle\", &mut self.paddle);\n        crate::params::nested(v, \"tray\", &mut self.tray);\n        crate::params::nested(v, \"dive\", &mut self.dive);\n        crate::params::nested(v, \"stand\", &mut self.stand);\n        crate::params::nested(v, \"check\", &mut self.check);\n    }\n}\n\nimpl Rules {\n    /// Parses `rules.toml` (missing keys keep their defaults).\n    pub fn parse(text: &str) -> Result<Rules, String> {\n        toml::from_str(text).map_err(|e| e.to_string())\n    }\n}\nE\necho \"# Every balance number. Keys left out keep their defaults (rules.rs). Hot-reloads from disk.\" > rules.toml\ncat >> rules.toml <<'E'\n[core]\nstiffness = 40.0\ndamping = 8.5\nreach = 0.92\ntip_time = 0.35\nwobble = 0.12\nE\n"}}}
