{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014rzdjBuSGAKciyqBvTnp5h","type":"tool_result","content":"250:    pub fn swing(&self, combo: u32) -> &str {\n259:    pub fn names(&self) -> &[String] {\n267:    pub fn per_swing(&self) -> bool {\n337:    pub fn is_look_setting(table: &toml::Table, key: &str) -> bool {\n342:    pub fn preset(plan: BodyPlan) -> Self {\n421:    pub fn leg_pairs(&self) -> usize {\n596:    pub fn update(&mut self, def: &PuppetDef, i: &AnimInput, dt: f32) {\n695:    pub fn set_action(&mut self, id: crate::moves::MoveId, t: f32, hit: f32, side: f32) {\n731:    pub fn play_clip(&mut self, id: u32, flags: u8, speed: f32) {\n756:    pub fn replay_clip(&mut self, id: u32, flags: u8, speed: f32) {\n769:    pub fn stop_clip(&mut self) {\n776:    pub fn hit(&mut self, dir: Vec3, strength: f32) {\n788:    pub fn lerp(&self, o: &PuppetState, t: f32) -> PuppetState {\n886:pub fn pose(def: &PuppetDef, st: &PuppetState, rig: Option<&RigView>, feet: Vec3, cam_fwd: Vec3) -> Vec<PuppetPart> {\n892:pub fn pose_ex(\n933:pub fn body_motion(def: &PuppetDef, st: &PuppetState) -> (Quat, Vec3) {\n1035:    pub fn transform(&mut self, q: Quat, lift: Vec3) {\n1078:pub fn biped_skel(def: &PuppetDef, st: &PuppetState) -> Skel {\n1091:pub fn procedural(def: &PuppetDef, st: &PuppetState, table: &crate::moves::MoveTable) -> Skel {\n1495:pub fn weapon_length(k: WeaponKind) -> f32 {\n1513:pub fn weapon_parts(w: &WeaponLook, k: f32, h: Vec3, d: Vec3, off: Vec3, out: &mut Vec<PuppetPart>) {\n154:pub struct PuppetDef {\n155-    pub scale: f32,\n156-    pub head_radius: f32,\n157-    pub torso_length: f32,\n158-    pub torso_radius: f32,\n159-    pub hip_width: f32,\n160-    pub shoulder_width: f32,\n161-    pub leg_length: f32,\n162-    pub arm_length: f32,\n163-    pub limb_radius: f32,\n164-    pub skin: String,\n165-    pub shirt: String,\n166-    pub pants: String,\n167-    pub shoes: String,\n168-    pub eyes: String,\n169-    pub look: Look,\n170-    /// Metres travelled per full walk cycle (two steps).\n171-    pub stride: f32,\n172-    pub step_height: f32,\n173-    pub arm_swing: f32,\n174-    pub bob: f32,\n175-    pub lean: f32,\n176-    pub squash: f32,\n177-    /// Stepped animation: 0 = smooth, 12 = \"on twos\" at 24 fps, etc.\n178-    pub anim_fps: f32,\n179-    /// Tilt the eyes toward the camera so they stay visible from above (0..1).\n180-    pub eyes_to_camera: f32,\n181-    /// Lean the whole body toward the camera (0..1): a 2D \"cheat\" for high camera angles.\n182-    pub face_camera: f32,\n183-    /// Skeleton: biped, or a creature with planted feet (spider, lizard, beetle) or a blob.\n184-    pub body: BodyPlan,\n185-    /// Leg pairs of creatures (0 = the body plan's usual number).\n186-    pub legs: i32,\n187-    /// Creature body length (m).\n188-    pub body_length: f32,\n189-    /// Tail length (m, 0 = none); swings with secondary motion.\n190-    pub tail_length: f32,\n191-    /// Antenna length (m, 0 = none).\n192-    pub antenna_length: f32,\n193-    /// Seconds a creature foot takes for one step.\n194-    pub step_time: f32,\n195-    /// Floppiness of tails, antennae and abdomens (0 = stiff, 2 = very floppy).\n196-    pub wobble: f32,\n197-    /// Second colour (shells, stripes, tail tips).\n198-    pub accent: String,\n199-    /// Held weapon and off hand.\n200-    pub weapon: WeaponLook,\n201-    /// Worn armour.\n202-    pub gear: GearLook,\n203-    /// Horns, spikes, wings... (any body plan).\n204-    pub parts: Vec<crate::parts::Attach>,\n205-    /// A motion clip (`SET/Clip`, see the `clips` tool) the character plays while it stands\n206-    /// still with nothing to do, in place of the procedural idle (bipeds). Empty = none.\n207-    pub idle_clip: String,\n208-    /// A walk loop (`STYLE100/Old_Walk`...) the character walks with in place of the\n209-    /// procedural walk while it heads forward on the ground, played as fast as it moves\n210-    /// (bipeds). Empty = none.