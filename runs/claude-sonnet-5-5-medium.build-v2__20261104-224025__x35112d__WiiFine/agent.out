s (?room=NAME&seed=N)\".into())\"\"\",\"\"\"        // The page (an AI Hub session) can set the scene and the seed itself.\n        let boot = crate::weblink::boot();\n        if let Some(scene) = boot.scene.filter(|x| !x.is_empty()) {\n            s.scene = scene;\n        }\n        if let Some(seed) = boot.seed {\n            s.seed = seed;\n        }\n        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {\n            s.scene = \"empty\".into();\n        }\n        if s.scene.is_empty() {\n            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\n            s.scene = \"town\".into();\n        }\n        (s, \"page address (?room=NAME&seed=N)\".into())\"\"\",1)\nopen(p,'w').write(s)\nE\ngrep -n \"scene\" crates/pav_app/src/main.rs | head"}}}
