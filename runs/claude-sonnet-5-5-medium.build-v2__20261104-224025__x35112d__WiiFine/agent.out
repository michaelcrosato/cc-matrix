{"type":"system","subtype":"task_started","task_id":"bp0gu259t","run_id":"0mw36vwfb-907104a3","tool_use_id":"toolu_01GVBnFGfpQh5Ka3WXge7ftN","description":"python3 - <<'E'\np='crates/pav_core/src/games/fit/run.rs'\ns=open(p).read()\nold=s[s.index(\"    pub fn apply_camera(&mut self, sim: &mut Sim, cam: [f32; 4], key: usize) {\"):s.index(\"    fn look_def(&self) -> PuppetDef {\")]\nnew='''    /// Asks for a camera. It is applied two ticks later: a change of set sets that room's own\n    /// camera first, and the cue must come after it to win.\n    pub fn apply_camera(&mut self, _sim: &mut Sim, cam: [f32; 4], key: usize) {\n        self.pending_cam = Some((cam, key, 2));\n        self.cam_key = (key, [cam[0] as i32, cam[1] as i32, cam[2] as i32, cam[3] as i32]);\n    }\n\n    fn flush_camera(&mut self, sim: &mut Sim) {\n        use crate::params::ParamValue;\n        let Some((cam, _key, wait)) = self.pending_cam else { return };\n        if wait > 0 {\n            self.pending_cam = self.pending_cam.map(|(c, k, w)| (c, k, w - 1));\n            return;\n        }\n        self.pending_cam = None;\n        let mut set = std::collections::BTreeMap::new();\n        set.insert(\"tilt\".to_string(), ParamValue::Float(cam[0] as f64));\n        set.insert(\"yaw\".to_string(), ParamValue::Float(cam[1] as f64));\n        set.insert(\"distance\".to_string(), ParamValue::Float(cam[2] as f64));\n        set.insert(\"fov\".to_string(), ParamValue::Float(cam[3] as f64));\n        let cue = crate::zones::CameraCue { set, sweep: vec![], flip_ortho: 0.0 };\n        sim.state.courses.sticky_cue = Some(Arc::new(cue));\n        sim.state.courses.cue_serial += 1;\n    }\n\n'''\ns=s.replace(old,new)\ns=s.replace(\"    pub fn stage(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\\n        self.ensure_cast(sim);\",\"    pub fn stage(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\\n        self.ensure_cast(sim);\\n        self.flush_camera(sim);\",1)\n# title camera: also deferred\nold=s[s.index(\"        if matches!(self.top(), Screen::Title | Screen::Guests { .. }) {\\n            if self.cam_key.0 != 99 {\"):s.index(\"        // the figure in an event or the check\")]\nnew='''        if matches!(self.top(), Screen::Title | Screen::Guests { .. }) {\n            if self.cam_key.0 != 99 {\n                self.title_camera(sim);\n                if let Some(p) = sim.state.player {\n                    sim.set_position(p, at(0, 0.0, 0.3, 4.0));\n                }\n            }\n        } else if island_like && self.play.is_none() && self.check.is_none() && self.cam_key.0 != 100 {\n            self.apply_camera(sim, [52.0, 0.0, 17.0, 40.0], 100);\n        }\n'''\ns=s.replace(old,new)\ns=s.replace(\"    fn look_def(&self) -> PuppetDef {\",\"\"\"    /// The title's slow sweep round the island.\n    pub fn title_camera(&mut self, sim: &mut Sim) {\n        use crate::params::ParamValue;\n        let mut set = std::collections::BTreeMap::new();\n        set.insert(\"tilt\".to_string(), ParamValue::Float(30.0));\n        set.insert(\"distance\".to_string(), ParamValue::Float(26.0));\n        set.insert(\"fov\".to_string(), ParamValue::Float(40.0));\n        let cue = crate::zones::CameraCue {\n            set,\n            sweep: vec![crate::zones::Sweep { param: \"yaw\".into(), from: -50.0, to: 50.0, period: 40.0, phase: 0.0 }],\n            flip_ortho: 0.0,\n        };\n        sim.state.courses.sticky_cue = Some(Arc::new(cue));\n        sim.state.courses.cue_serial += 1;\n        self.pending_cam = None;\n        self.cam_key = (99, [0; 4]);\n    }\n\n    fn look_def(&self) -> PuppetDef {\"\"\",1)\nopen(p,'w').write(s)\np='crates/pav_core/src/games/fit/mod.rs'\ns=open(p).read()\ns=s.replace(\"    pub cam_key: (usize, [i32; 4]),\",\"    pub cam_key: (usize, [i32; 4]),\\n    pub pending_cam: Option<([f32; 4], usize, u8)>,\",1)\ns=s.replace(\"            cam_key: (usize::MAX, [0; 4]),\",\"            cam_key: (usize::MAX, [0; 4]),\\n            pending_cam: None,\",1)\nopen(p,'w').write(s)\np='crates/pav_core/src/games/fit/story.rs'\ns=open(p).read()\ns=s.replace(\"        self.apply_camera(sim, [30.0, 0.0, 26.0, 40.0], 98);\\n        events.push(SimEvent::Music { song: 1 });\",\"        self.title_camera(sim);\\n        events.push(SimEvent::Music { song: 1 });\",1)\ns=s.replace(\"            a.t = 0.0;\\n            self.apply_camera(sim, [30.0, 0.0, 26.0, 40.0], 98);\",\"            a.t = 0.0;\\n            self.title_camera(sim);\",1)\nopen(p,'w').write(s)\nE\ngrep -n \"apply_camera(sim, \\[30\" crates/pav_core/src/games/fit/*.rs; (CARGO_BUILD_JOBS=8 cargo check --locked -p pav_core 2>&1 | grep -E \"^error\" -A9 | head -30)","is_backgrounded":false,"task_type":"local_bash","uuid":"e9a4caa4-fc22-498a-ae46-4e5b67a7d18f","session_id":"6bcbd63b-6fd6-450e-b613-afa8a801fe09"}
