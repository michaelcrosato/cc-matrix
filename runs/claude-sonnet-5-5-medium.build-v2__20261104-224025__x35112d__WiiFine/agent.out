extContent = 'Starting…';\n    await paint();\n    const init = await glue;\n    await init({ module_or_path: wasm });\n  };\n})();\n\"\"\"\n\n\ndef fail(text):\n    sys.exit(f\"pack_single_html: {text}\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NwRr72tnDe1nf587a7mYwH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
