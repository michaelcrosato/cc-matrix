 apart in a lane', sameLane.length === 0, JSON.stringify(sameLane.slice(0, 3)));\n    let walled = 0; for (const v of vs) { const near = vs.filter(o => Math.abs(o.z - v.z) < 1500), lanes = new Set(near.map(o => o.lane)); if (3 - lanes.size < 1) walled++; }\n    t('the road is never walled off', walled === 0, walled);\n    // lane changes avoid overlaps; the horn moves the car ahead\n    const v0 = race.traffic.spawn(L, race.p1.car.z + 2000, { lane: 1, v: 90 }); race.traffic.spawn(L, race.p1.car.z + 2600, { lane: 1, v: 60 });\n    run(race, 4); t('a blocked car changes lane', v0 && (v0.lane !== 1 || v0.changeT > 0 || v0.blink > 0), v0 && v0.lane);\n    const h = race.traffic.spawn(L, race.p1.car.z + 1500, { lane: 1, v: 100 }); race.p1.car.x = 0; race.traffic.hornCool = {}; const moved = race.traffic.horn(race.p1);\n    t('the horn makes the car ahead move over', moved === h && h.toLane !== 1, moved && moved.toLane); }\n  // overtakes and near misses with exact geometry\n  { const { race, OB } = raceIn({ traffic: false, players: [{ car: 'orchidea' }] }); const d = race.p1, L = race.traffic.list('S1'); d.car.v = 250; d.car.x = 0; d.input = null;\n    const near = race.traffic.spawn(L, d.car.z + 1200, { lane: 2, v: 100 }); near.x = OB.PLAYER_HW + near.hw + .06; near.lane = 2; near.fixedLane = true;\n    const ev = []; OB.bus.on('*', (e, n) => { if (n === 'nearmiss' || n === 'overtake') ev.push(n); });\n    for (let i = 0; i < 120; i++) { d.car.v = 250; near.x = OB.PLAYER_HW + near.hw + .06; race.step(1 / 120); }\n    t('a close pass is a near miss', ev.includes('nearmiss'), ev.join());\n    t('a close pass is an overtake', ev.includes('overtake'), ev.join()); }\n  // the clock, the checkpoint, difficulty\n  { const { race, OB } = raceIn({ players: [{ car: 'orchidea' }] }); const c0 = race.clock; run(race, 2); t('the clock counts down', race.clock < c0 - 1.9 && race.clock > c0 - 2.1, race.clock);\n    const d = race.p1; race.place(d, 'S1', d.road.length - 3 * SEG, .5); d.car.v = 250; const before = race.clock; let cp = null; OB.bus.on('checkpoint', e => { cp = e; });\n    run(race, 3, () => cp); t('a checkpoint extends the clock by its row bonus', cp && cp.bonus === Math.round(OB.tune('checkpointBonus2')) && race.clock > before + cp.bonus - 2, JSON.stringify(cp)); }\n  { const { race } = raceIn({ difficulty: 'Easy', players: [{ car: 'orchidea' }] }), { race: r2 } = raceIn({ difficulty: 'Hard', players: [{ car: 'orchidea' }] }); t('difficulty scales the clock', race.clock > r2.clock); }\n  { const { race, OB } = raceIn({ startTime: 1, players: [{ car: 'orchidea' }] }); let up = false; OB.bus.on('time:up', () => { up = true; }); run(race, 6); t('time up ends the run', up && race.phase === 'done' && race.endReason === 'timeup'); }\n  // the goal and score maths\n  { const { race, OB } = raceIn({ players: [{ car: 'orchidea', bot: {} }] }); const d = race.p1; race.place(d, 'S11', d.road && OB.World.stage('S11').goalZ - 4 * SEG, 0); d.routeIdx = 4; d.routeStr = 'LLLL'; d.car.v = 200;\n    const left = race.clock; let goal = null; OB.bus.on('goal', e => { goal = e; }); run(race, 6);\n    t('the goal arch ends the run at goal A', goal && goal.id === 'A' && race.phase === 'done' && race.endReason === 'goal', JSON.stringify(goal));\n    t('the goal adds the seconds left and the route bonus', d.score >= Math.round(race.clock) * 1000 + 4 * 5000, d.score); }\n  // the Bloom chain\n  { const { race, OB } = raceIn({ players: [{ car: 'orchidea' }] }); const d = race.p1; for (let i = 0; i < 9; i++) OB.bus.emit('nearmiss', { car: d.id, id: 99 }); t('style events raise the Bloom level', d.bloom.level >= 2, d.bloom.points);\n    for (let i = 0; i < 25; i++) OB.bus.emit('nearmiss', { car: d.id, id: 99 }); t('Full Bloom at 10,000 points', d.bloom.level === 5, d.bloom.points);\n    const s0 = d.score; OB.bus.emit('nearmiss', { car: d.id, id: 99 }); t('events score times the level', d.score - s0 === 500 * 5, d.score - s0);\n    OB.bus.emit('car:crash', { car: d.id }); t('a crash halves the chain and drops a level', d.bloom.level <= 4, d.bloom.level);\n    const p0 = d.bloom.points; race.t += 10; run(race, 1); t('the chain decays with no style', d.bloom.points < p0, p0 + ' -> ' + d.bloom.points); }\n  // the route string is recorded\n  { const { race } = raceIn({ players: [{ car: 'orchidea', bot: { route: 'RLRL' } }] }); const d = race.p1; race.place(d, 'S1', d.road.junctionAt - 20 * SEG, .6); d.car.v = 250; run(race, 12, () => d.stage !== 'S1'); t('the route string records the fork', d.routeStr === 'R', d.routeStr); }\n}\nEOF\ncat > tests/suites/requests.mjs <<'EOF'\n// Love in Bloom: for each of the 14 request types the pipeline rates Perfect for petals, an honest bot run rates\n// something for the object types, a deliberate failure rates Miss; loved types x1.2; fork preference; penalties; grade\nimport { raceIn, run } from '../lib/boot.mjs';\nconst STAGE_FOR = { pass: 'S1', drift: 'S3', ribbons: 'S9', balloons: 'S1', gnomes: 'S9', bees: 'S2', cones: 'S3', arches: 'S5', speed: 'S4', clean: 'S7', draft: 'S4', close: 'S3', bouquets: 'S5', photo: 'S8' };\nconst go = (type, mode, passenger = 'vivi') => {\n  const stage = STAGE_FOR[type]; const B = raceIn({ route: { stages: [stage], sprint: true }, rules: [r => new (r.cfg._D)(r, { passenger })], _D: null, players: [{ car: 'orchidea', passenger, bot: mode === 'bot' ? { targets: true } : null }] }, {});\n  const { race, OB } = B;\n  if (!race.req) new OB.Requests.Director(race, { passenger });\n  const d = race.p1; race.place(d, stage, 160 * 200, 0); d.car.v = 230;\n  if (mode === 'perfect') OB.cheats.perfectRequests = true;\n  if (mode === 'fail') { d.input = null; d.brain = { intent: () => ({ steer: 0, gas: type === 'speed' ? .3 : 1, brake: 0 }) }; d.car.x = -.66; }\n  race.req.start({ key: 't', stage, z: d.car.z + 2600, type });\n  let end = null; OB.bus.on('req:end', e => { end = e; });\n  if (mode === 'fail' && (type === 'clean' || type === 'bees')) { run(race, 2.5); d.car.spin('test', (n, x) => OB.bus.emit(n, Object.assign({ car: d.id }, x))); if (type === 'bees') { race.req.cur.hits = 5; } }\n  run(race, 40, () => end);\n  return { end, race, OB, d };\n};\nexport default async function (t) {\n  for (const type of Object.keys(STAGE_FOR)) {\n    const p = go(type, 'perfect'); t(type + ': the pipeline rates Perfect', p.end && p.end.rating === 'Perfect' && p.end.petals >= 5, JSON.stringify(p.end));\n    const f = go(type, 'fail'); t(type + ': a deliberate failure rates Miss or Good', f.end && (f.end.rating === 'Miss' || (f.end.rating === 'Good' && ['clean'].includes(type))), JSON.stringify(f.end));\n    if (['balloons', 'gnomes', 'bouquets', 'arches', 'cones', 'speed', 'photo'].includes(type)) { const b = go(type, 'bot'); t(type + ': the bot earns a rating', b.end && b.end.rating !== 'Miss', JSON.stringify(b.end)); }\n  }\n  // loved types earn x1.2 (Marisol loves balloons)\n  { const m = go('balloons', 'perfect', 'marisol'); t('a loved request earns x1.2', m.end.petals === 6, m.end.petals); }\n  // fork preference and penalties\n  { const { race, OB } = raceIn({ players: [{ car: 'orchidea', passenger: 'marisol', bot: { route: 'L' } }] }); const dir = new OB.Requests.Director(race, { passenger: 'marisol' }); race.rules.push(dir); const d = race.p1;\n    race.place(d, 'S1', d.road.junctionAt - 610 * 200, -.5); d.car.v = 260; dir.done.add('S1:0'); dir.done.add('S1:1');\n    run(race, 60, () => d.stage !== 'S1');\n    const pref = race.forkPref; t('the passenger states a fork preference', dir.prefStated.S1);\n    t('taking or refusing it moves petals', dir.history.length === 0 && (dir.petals === 2 || dir.petals === 0), dir.petals);\n    const p0 = dir.petals; OB.bus.emit('car:crash', { car: d.id }); t('a spin-out costs 2 petals', dir.petals === Math.max(0, p0 - 2), dir.petals); }\n  // the grade maths\n  { const { race, OB } = raceIn({ players: [{ car: 'orchidea', passenger: 'juni' }] }); const dir = new OB.Requests.Director(race, { passenger: 'juni' });\n    dir.max = 100; dir.petals = 92; const g1 = dir.grade(); dir.petals = 70; const g2 = dir.grade(); dir.petals = 30; const g3 = dir.grade();\n    t('grades: AAA at 92%, A at 70%, D at 30%', g1 === 'AAA' && g2 === 'A' && g3 === 'D', [g1, g2, g3].join());\n    t('moods follow the grade', OB.moodOfGrade('AA') === 'bloom' && OB.moodOfGrade('C') === 'bud' && OB.moodOfGrade('E') === 'wilt'); }\n}\nEOF\ncat > tests/suites/missions.mjs <<'EOF'\n// missions: each one runs with its rules to a result (cleared by its bot with the cheats that help a bot, failing\n// when it should), rewards pay once per rank improvement, unlock chains open postcards, the Finale opens at 9; economy\nimport { boot, raceIn, run } from '../lib/boot.mjs';\nexport default async function (t) {\n  for (const m of boot().OB.MISSIONS) {\n    if (m.kind === 'love') continue;\n    const B = boot(); const { OB, game } = B; game.advance(.1);\n    const cfg = OB.Missions.configure({ mode: 'mission', mission: m.id, car: 'orchidea', passenger: 'marisol', noIntro: true, seed: 3 });\n    cfg.players = [{ car: 'gardenia', passenger: 'marisol', bot: { targets: true, drift: true, driftAt: 3 } }]; cfg.after = () => {};\n    OB.cheats.perfectRequests = true; OB.cheats.noCollide = m.kind !== 'clean'; OB.cheats.autoDrift = m.kind === 'driftduel';\n    if (m.kind === 'heartbreak' || m.kind === 'knockout' || m.kind === 'draftdash') OB.tuning.rivalSkill = .9;\n    const race = OB.Race.create(cfg); race.phase = 'race';\n    run(race, 400);\n    const R = race.result || {};\n    t(m.id + ' ' + m.title + ': runs to a result', race.phase === 'done' && R.stats, race.phase + ' ' + JSON.stringify(R.stats));\n    t(m.id + ': a rank when cleared', !R.cleared || OB.RANKS.includes(R.rank), JSON.stringify({ c: R.cleared, r: R.rank }));\n    if (['sprint', 'collect', 'count', 'photo3', 'memory', 'speedkeep', 'driftduel'].includes(m.kind)) t(m.id + ': the bot clears it', R.cleared, JSON.stringify(R.stats) + ' ' + R.reason);\n  }\n  // failure paths: a scratch ends Not a Scratch; Heartbreakers drains to zero behind them\n  { const B = boot(); const { OB, game } = B; game.advance(.1); const cfg = OB.Missions.configure({ mode: 'mission', mission: 'V1', car: 'orchidea', passenger: 'vivi', noIntro: true, seed: 3 }); cfg.after = () => {};\n    const race = OB.Race.create(cfg); race.phase = 'race'; run(race, 1); OB.bus.emit('car:bump', { car: race.p1.id }); run(race, 1); t('V1 fails on a scratch', race.phase === 'done' && !race.result.cleared); }\n  // rewards and unlocks\n  { const { OB } = boot(); const P = OB.Profile; P.reset();\n    let r = P.missionResult('B1', { cleared: true, rank: 'C' }); t('a first clear pays the base seeds', r.paid === 150, r.paid);\n    r = P.missionResult('B1', { cleared: true, rank: 'C' }); t('the same rank pays nothing again', r.paid === 0, r.paid);\n    r = P.missionResult('B1', { cleared: true, rank: 'AAA' }); t('a better rank pays the improvement', r.paid === 150, r.paid);\n    t('clearing B1 opens B2', P.missionOpen('B2') && !P.missionOpen('B3'));\n    t('the Finale is locked before 9 clears', !P.missionOpen('F'));\n    for (const id of ['M1', 'M2', 'M3', 'V1', 'V2', 'V3', 'J1', 'J2']) P.missionResult(id, { cleared: true, rank: 'C' });\n    t('the Finale opens at 9 clears', P.missionOpen('F'), P.clearedCount());\n    // the economy: 14 missions at A plus 6 arcade runs buy every bed\n    P.reset(); for (const m of OB.MISSIONS) P.missionResult(m.id, { cleared: true, rank: 'A' }); for (let i = 0; i < 6; i++) P.grant(Math.floor(400000 / 20000) + 50 + 100, 'run');\n    let bought = 0; for (const b of OB.BEDS) if (P.buy(b.id)) bought++;\n    t('14 A-ranks and 6 arcade runs buy every bed', bought === OB.BEDS.length, bought + ' of ' + OB.BEDS.length + ', seeds left ' + P.data.seeds);\n    P.reset(); t('buying with too few seeds is refused', !P.buy('gardenia') && !P.buy('pastel'));\n    P.data.seeds = 1000; t('a locked bed is refused', !P.buy('gardenia')); t('an open bed is bought', P.buy('pastel') && P.data.unlocked.paints.includes('pastel'));\n    t('a bought paint pack shows in the garage', OB.paintsFor('orchidea', P.data).length === 8); }\n}\nEOF\ncat > tests/suites/modes.mjs <<'EOF'\n// Time Trial (a ghost records, saves, loads and replays to the same positions; medals from par) and Versus (two bots finish; places)\nimport { boot, raceIn, run } from '../lib/boot.mjs';\nexport default async function (t) {\n  { const B = boot(); const { OB, game } = B; game.advance(.1); OB.cheats.noCollide = true;\n    const cfg = OB.Trial.configure({ mode: 'trial', trialKey: 'S1', car: 'orchidea', noIntro: true, seed: 2, players: [{ car: 'orchidea', bot: {} }] });\n    const race = OB.Race.create(cfg); race.phase = 'race'; run(race, 120); const R = race.result;\n    t('a trial run finishes', R && R.players[0].finished, R && R.reason);\n    const out = OB.Trial.after(R); t('the first run is a record with a medal', out.record && out.medal, JSON.stringify(out));\n    const rec = OB.Profile.data.records.stage.S1; t('the ghost is saved', rec && rec.ghost.length > 100, rec && rec.ghost.length);\n    OB.Profile.save(); OB.Profile.load(); const rec2 = OB.Profile.data.records.stage.S1; t('the ghost survives save and load', rec2 && rec2.ghost.length === rec.ghost.length);\n    const cfg2 = OB.Trial.configure({ mode: 'trial', trialKey: 'S1', car: 'orchidea', noIntro: true, seed: 2, players: [{ car: 'orchidea', bot: {} }] });\n    const r2 = OB.Race.create(cfg2); r2.phase = 'race'; run(r2, 20); const gh = r2.ghosts[0], s = OB.ghostAt(r2, gh, 'S1'), sample = rec2.ghost[Math.floor(r2.t * 10)];\n    t('the ghost replays to the same positions', s && Math.abs(s.z - sample[1]) < 400, s && (Math.round(s.z) + ' vs ' + sample[1]));\n    t('medals from par', OB.medalFor('S1', OB.PAR.S1 * .9) === 'bloom' && OB.medalFor('S1', OB.PAR.S1 * 1.2) === 'bronze' && OB.medalFor('S1', OB.PAR.S1 * 2) === 'none'); }\n  { const B = boot(); const { OB, game } = B; game.advance(.1); OB.cheats.noCollide = true;\n    const p2 = game.addPlayer({ keys: 'right' });\n    t('a second player joins on the keyboard', game.players.length === 2 && p2);\n    const race = OB.Race.create({ mode: 'versus', route: { stages: ['S1', 'S2', 'S5'], sprint: true }, noIntro: true, seed: 4, startTime: 400, players: [{ car: 'orchidea', bot: {} }, { car: 'gardenia', bot: {}, cpu: true }] }); race.phase = 'race';\n    run(race, 260); const R = race.result;\n    t('a split-screen race of two bots finishes', R && R.players.length === 2 && R.players.every(p => p.finished), R && JSON.stringify(R.players.map(p => [p.finished, p.stage])));\n    t('places are given', R && new Set(R.players.map(p => p.place)).size === 2, R && R.players.map(p => p.place).join()); }\n}\nEOF\nnode tests/run.mjs --quick --only race,requests,missions,modes 2>&1 | tail -40","description":"Write race, requests, missions, modes suites and run"}},"wire_ingest_context":{"toolu_01JuxSA7FEu1wY7hZ46wEB7h":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-035148__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-xhigh-20261104-035148"}}}
