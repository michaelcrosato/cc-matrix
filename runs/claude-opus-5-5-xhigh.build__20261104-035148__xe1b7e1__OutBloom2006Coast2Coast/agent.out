OURCE INFORMATION (2/3)', lines: kv(['tech', 'artDirection', 'animation']) },\n    { title: 'SOURCE INFORMATION (3/3)', lines: kv(['audio', 'online', 'testing', 'research', 'environment', 'model', 'usage']) },\"\"\",\"\"\"    { title: 'SOURCE INFORMATION (1/4)', lines: kv(['date', 'source', 'plan', 'genre', 'perspective']) },\n    { title: 'SOURCE INFORMATION (2/4)', lines: kv(['tech', 'artDirection']) },\n    { title: 'SOURCE INFORMATION (3/4)', lines: kv(['animation', 'audio']) },\n    { title: 'SOURCE INFORMATION (4/4)', lines: kv(['online', 'testing', 'research', 'environment', 'model', 'usage']) },\"\"\")\ns=s.replace(\"\"\"    { title: 'TESTING FEEDBACK', lines: ['Q: How many issues did testing catch?  ' + TF[0], 'Q: How many were critical?  ' + TF[1], 'Q: Most helpful test?  ' + TF[2], 'Q: Least helpful test?  ' + TF[3]] },\"\"\",\"\"\"    { title: 'TESTING FEEDBACK (1/2)', lines: ['Q: How many issues did testing catch?  ' + TF[0], 'Q: How many were critical?  ' + TF[1]] },\n    { title: 'TESTING FEEDBACK (2/2)', lines: ['Q: Most helpful test?  ' + TF[2], 'Q: Least helpful test?  ' + TF[3]] },\"\"\")\ns=s.replace(\"\"\"    { title: 'ENGINE FEEDBACK (1/2)', lines: ['Q: What did you like most?  ' + EF[0], 'Q: Did you get stuck or guess wrong?  ' + EF[1], 'Q: The most important thing you built?  ' + EF[2]] },\n    { title: 'ENGINE FEEDBACK (2/2)', lines: ['Q: The hardest part?  ' + EF[3], 'Q: What did you change, and why?  ' + EF[4], 'Q: One thing to change?  ' + EF[5]] },\n    { title: 'PROMPT FEEDBACK', lines: ['Q: What did you like most?  ' + PF[0], 'Q: What was confusing?  ' + PF[1], 'Q: The hardest thing to do?  ' + PF[2], 'Q: What would you change?  ' + PF[3]] }\"\"\",\"\"\"    { title: 'ENGINE FEEDBACK (1/3)', lines: ['Q: What did you like most?  ' + EF[0], 'Q: Did you get stuck or guess wrong?  ' + EF[1]] },\n    { title: 'ENGINE FEEDBACK (2/3)', lines: ['Q: The most important thing you built?  ' + EF[2], 'Q: The hardest part?  ' + EF[3]] },\n    { title