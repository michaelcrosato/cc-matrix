\"file\":\"16-10-1440x900__webkit.png\"}\n{\"label\":\"16:9 1920x1080\",\"category\":\"desktop\",\"engine\":\"firefox\",\"width\":1920,\"height\":1080,\"dpr\":1,\"console_errors\":[],\"page_errors\":[],\"failed_requests\":[],\"overflow\":null,\"status\":null,\"file\":\"16-9-1920x1080__firefox.png\"}\n{\"label\":\"16:9 1920x1080\",\"category\":\"desktop\",\"engine\":\"webkit\",\"width\":1920,\"height\":1080,\"dpr\":1,\"console_errors\":[],\"page_errors\":[],\"failed_requests\":[],\"overflow\":null,\"status\":0,\"file\":\"16-9-1920x1080__webkit.png\"}\n{\"label\":\"21:9 2560x1080\",\"category\":\"desktop\",\"engine\":\"firefox\",\"width\":2560,\"height\":1080,\"dpr\":1,\"console_errors\":[],\"page_errors\":[],\"failed_requests\":[],\"overflow\":null,\"status\":null,\"file\":\"21-9-2560x1080__firefox.png\"}\n{\"label\":\"21:9 2560x1080\",\"category\":\"desktop\",\"engine\":\"webkit\",\"width\":2560,\"height\":1080,\"dpr\":1,\"console_errors\":[],\"page_errors\":[],\"failed_requests\":[],\"overflow\":null,\"status\":0,\"file\":\"21-9-2560x1080__webkit.png\"}\n8/24 viewport checks passed\n","exit_code":1,"status":"failed"}}
