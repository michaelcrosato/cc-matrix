se,ghostTrail:[]}; setScreen('event'); }\n192:    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\n256:    if(state.together?.online && hub && time-lastHubUpdate>.1){lastHubUpdate=time;hub.send({event:state.together.event,x:center.x,y:center.y,progress:time/round.length},{reliable:false});}\nrg: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.js: No such file or directory (os error 2)\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:224:    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:238:      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:241:        cell.progress.push({ at: performance.now(), ...report });\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:242:        state.coordinator.progress(id, report.score);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:272:/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:343:    const last = cell.progress.at(-1);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:344:    if (last && !p.result) bits.push(`progress ${last.score}${last.label ? ` (${last.label})` : ''}`);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:393:function poke(cell, key) {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:430:    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:447:      for (const cell of players) poke(cell, 'Enter');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:461:        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:468:    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:469:    // still tagged race was built to race's contract: no seeded start, and no progress asked.\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:474:      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:486:        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:489:      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/hub/harness.html:490:        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n:root{--ink:#173f48;--muted:#52747a;--paper:#fffdf2;--aqua:#7fe0d8;--teal:#117a79;--coral:#ff826d;--sun:#ffd67b;--line:rgba(23,63,72,.16);font-family:ui-rounded,\"Trebuchet MS\",system-ui,sans-serif;color:var(--ink)}\nimport json\nimport os\nimport sys\nimport threading\nimport traceback\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nHTML = ROOT / f\"{DEV.name}.html\"\nARTIFACTS = DEV / \"tests\" / \"artifacts\"\nfailures = []\nchecks = 0\n\n\ndef test(name, function):\n    global checks\n    checks += 1\n    try:\n        function()\n    except Exception:\n        failures.append(f\"{name}:\\n{traceback.format_exc()}\")\n\n\ndef status(page):\n    return json.loads(page.evaluate(\"window.__gameStatus()\"))\n\n\ndef click(page, action):\n    page.locator(f'[data-action=\"{action}\"]').first.click(timeout=5000)\n\n\ndef advance(page):\n    page.evaluate(\"window.__testAdvance(200)\")\n    assert status(page)[\"scene\"] == \"result\", status(page)\n\n\ndef load(browser, **kwargs):\n    context = browser.new_context(**kwargs)\n    page = context.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda error: errors.append(str(error)))\n    page.goto(HTML.as_uri() + \"?test=1\", wait_until=\"domcontentloaded\")\n    page.wait_for_function(\"window.__gameBoot?.ready === true\")\n    return context, page, errors\n\n\ndef new_guest(page):\n    click(page, \"slots-new\")\n    click(page, \"slot:0\")\n    page.locator(\"#guest-name\").select_option(label=\"Ari\")\n    click(page, \"skin:2\")\n    click(page, \"outfit:3\")\n    click(page, \"create-guest\")\n    click(page, \"island\")\n    assert status(page)[\"guest\"] == \"Ari\"\n\n\ndef browser_tests(playwright):\n    for engine in (\"chromium\", \"firefox\", \"webkit\"):\n        browser = getattr(playwright, engine).launch(headless=True)\n\n        def smoke():\n            context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n","exit_code":0,"status":"completed"}}
