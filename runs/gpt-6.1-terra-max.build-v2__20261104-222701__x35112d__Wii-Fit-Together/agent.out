{"type":"item.started","item":{"id":"item_277","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; nl -ba \\\"\"'$dev/web/game.js\" | sed -n '\"'105,170p;184,278p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_277","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; nl -ba \\\"\"'$dev/web/game.js\" | sed -n '\"'105,170p;184,278p'\"","aggregated_output":"   105\t    } else if (state.screen === 'settings') {\n   106\t      html = modal('Make it yours','SETTINGS & CONTROLS', `<label class=\"field\">Music volume: <span id=\"music-value\">${Math.round(settings.music*100)}%</span><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"${Math.round(settings.music*100)}\"></label><label class=\"field\">Sound effects <select id=\"sound\"><option value=\"on\" ${settings.sound?'selected':''}>On</option><option value=\"off\" ${!settings.sound?'selected':''}>Off</option></select></label><label class=\"field\">Controller labels <select id=\"glyph\"><option ${settings.glyph==='PlayStation'?'selected':''}>PlayStation</option><option ${settings.glyph==='Xbox'?'selected':''}>Xbox</option></select></label><p>Keyboard: WASD or arrow keys to lean; Space / Enter to act; Esc to pause. Controller: left stick and ${settings.glyph==='Xbox'?'A':'Cross'}. Mouse: move to lean and click to act. Arrow keys navigate menus.</p><p>Touch-only devices can view the island; connect a controller or keyboard to play.</p><div class=\"row\">${button('Done','settings-back','primary')}</div>`, 'settings-back');\n   107\t    } else if (state.screen === 'about') {\n   108\t      const info = window.__aboutData || {};\n   109\t      const blocks = [['Source Information',info.sourceInformation],['Testing Feedback',info.testingFeedback],['Engine Feedback',info.engineFeedback],['Prompt Feedback',info.promptFeedback]];\n   110\t      html = modal('About this game','THE FINE PRINT', `<p>Made with Shardfall and an original island full of questionable advice.</p>${blocks.map(([label,value])=>`<h3>${esc(label)}</h3><div class=\"about-list\">${Array.isArray(value)?value.map(line=>`<p>${esc(line)}</p>`).join(''):Object.entries(value||{}).map(([key,line])=>`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('')}</div>`).join('')}<div class=\"row\">${button('Back to the island','title','primary')}</div>`);\n   111\t    }\n   112\t    if (state.attract && state.screen==='title') html += `<div class=\"attract-label\">A LITTLE ISLAND DAYDREAM · PRESS ANY KEY TO RETURN</div>`;\n   113\t    if (isTouchOnly() && !state.hasHardwareInput && !['settings','about'].includes(state.screen)) html += `<div class=\"touch-guard\"><div><strong>Controller or keyboard required</strong><p>Connect one to play. The island will wait for you.</p><button class=\"button\" data-action=\"settings\">Settings</button></div></div>`;\n   114\t    app.innerHTML = html;\n   115\t    const musicInput=document.getElementById('music');\n   116\t    if (musicInput) musicInput.addEventListener('input', event=>{ settings.music=Number(event.target.value)/100; document.getElementById('music-value').textContent=Math.round(settings.music*100)+'%'; save(); });\n   117\t    const soundInput=document.getElementById('sound');\n   118\t    if (soundInput) soundInput.addEventListener('change', event=>{ settings.sound=event.target.value==='on'; save(); });\n   119\t    const glyphInput=document.getElementById('glyph');\n   120\t    if (glyphInput) glyphInput.addEventListener('change', event=>{ settings.glyph=event.target.value; save(); render(); });\n   121\t    const nameInput=document.getElementById('guest-name');\n   122\t    if (nameInput) nameInput.addEventListener('change', event=>{ state.setup.name=event.target.value; });\n   123\t    for (const kind of ['stiffness','damping']) { const input=document.getElementById('dev-'+kind); if(input) input.addEventListener('input', event=>{state[kind]=Number(event.target.value);}); }\n   124\t  }\n   125\t\n   126\t  function isTouchOnly() { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; }\n   127\t  function newProfile() { return {name:state.setup.name,skin:state.setup.skin,outfit:state.setup.outfit,day:1,dayMinutes:0,minutesTotal:0,stars:0,age:null,checked:false,finaleDone:false,freePlay:false,bests:{},clearedToday:{},lastDate:new Date().toISOString().slice(0,10)}; }\n   128\t  function setScreen(screen) { state.screen=screen; render(); }\n   129\t  function selectAction(action) {\n   130\t    if (!action) return;\n   131\t    sound(520,.05);\n   132\t    if (action === 'title') { state.paused=false; state.together=null; state.round=null; setScreen('title'); }\n   133\t    else if (action === 'slots-new' || action === 'slots-continue') { state.slotMode=action==='slots-new'?'new':'continue'; setScreen('slots'); }\n   134\t    else if (action.startsWith('slot:')) { const index=Number(action.slice(5)), guest=(saved.slots||[])[index]; state.slot=index; if (guest) { state.profile=guest; setScreen('island'); } else { state.setup={name:names[index],skin:index%skins.length,outfit:index%outfits.length}; setScreen('customize'); } }\n   135\t    else if (action.startsWith('skin:')) { state.setup.skin=Number(action.slice(5)); render(); }\n   136\t    else if (action.startsWith('outfit:')) { state.setup.outfit=Number(action.slice(7)); render(); }\n   137\t    else if (action==='create-guest') { state.profile=newProfile(); save(); voice(); setScreen('intro'); }\n   138\t    else if (action==='island') { if (state.profile) {state.paused=false;setScreen('island');} else setScreen('title'); }\n   139\t    else if (action==='calendar') setScreen('calendar');\n   140\t    else if (action==='check') { voice(); setScreen('checkIntro'); }\n   141\t    else if (action==='begin-check') startCheck();\n   142\t    else if (action.startsWith('intro:')) { state.eventId=action.slice(6); voice(); setScreen('eventIntro'); }\n   143\t    else if (action==='cancel-event') setScreen(state.together?'handoff':'island');\n   144\t    else if (action==='begin-event') startRound(state.eventId);\n   145\t    else if (action==='pause') { state.paused=true; render(); }\n   146\t    else if (action==='resume') { state.paused=false; render(); }\n   147\t    else if (action==='reset-tuning') { state.stiffness=40; state.damping=8.5; render(); }\n   148\t    else if (action==='leave-event') { state.paused=false; if (state.together && state.together.online) reportHub(); else setScreen(state.together?'handoff':'island'); }\n   149\t    else if (action==='result-next') advanceResult();\n   150\t    else if (action==='end-day') setScreen('endDay');\n   151\t    else if (action==='sleep') { if (state.profile.day===5) setScreen('ending'); else { state.profile.day++; state.profile.dayMinutes=0; state.profile.clearedToday={}; state.profile.checked=false; state.profile.lastDate=new Date().toISOString().slice(0,10); save(); setScreen('island'); } }\n   152\t    else if (action==='free-play') { state.profile.freePlay=true; save(); setScreen('island'); }\n   153\t    else if (action==='together') { state.together=null; setScreen('together'); }\n   154\t    else if (action.startsWith('hotseat:')) { state.together={count:Number(action.slice(8)),player:0,event:0,scores:[0,0,0,0],online:false,ghosts:{}}; setScreen('handoff'); }\n   155\t    else if (action==='hotseat-next') { state.eventId=medley[state.together.event]; setScreen('eventIntro'); }\n   156\t    else if (action==='settings') { state.returnScreen=state.screen; setScreen('settings'); }\n   157\t    else if (action==='settings-back') setScreen(state.returnScreen || 'title');\n   158\t    else if (action==='about') setScreen('about');\n   159\t    else if (action==='hub-ready') { if(hub) hub.ready(); state.message='Ready! Waiting for the other guests.'; render(); }\n   160\t  }\n   161\t\n   162\t  function startCheck() { center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; state.paused=false; state.round={name:'Morning Wobble Check',place:'Stillness Studio',instruction:'Stand still. This is the whole test.',controls:'Keep the dot near the center.',length:37,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,targets:0,phase:0,steps:0,lastStep:'',metric:[0,0,0,0],phaseSamples:[0,0,0,0]}; setScreen('check'); }\n   163\t  function startRound(id) { const item=eventById(id); if(!item) return; center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; lastHubUpdate=0; lastHubProgress=0; state.paused=false; state.round={...item,instruction:item.controls,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,steps:0,lastStep:'',shellX:0,shellY:0,shellVx:0,shellVy:0,potted:0,spin:0,prevAngle:0,gates:0,gateIndex:-1,stillBroken:false,ghostTrail:[]}; setScreen('event'); if(state.together?.online && hub) hub.progress({score:state.together.scores[0],label:`${item.name}: starting`}); }\n   164\t  function triggerAction(side='action') {\n   165\t    if (!state.round || !['event','check'].includes(state.screen) || state.paused) return;\n   166\t    const round=state.round, time=round.elapsed;\n   167\t    if (round.id==='finale' && time>60) round.stillBroken=true;\n   168\t    round.actionCount++;\n   169\t    if (side==='left' || side==='right') { if (round.lastStep!==side) {round.steps++; round.lastStep=side;} }\n   170\t    if (round.id==='squat' || round.id==='step' || round.id==='lap' || round.id==='dive' || state.screen==='check') {\n   184\t  }\n   185\t  function finishRound() {\n   186\t    const round=state.round; let score=Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000);\n   187\t    if (round.id==='tide') score=Math.round(clamp(round.potted*200+score*.4,0,1000));\n   188\t    if (round.id==='paddle') score=Math.round(clamp(round.gates*125+score*.3,0,1000));\n   189\t    if (round.id==='dive') score=Math.round(clamp(score*.5+Math.min(round.actionHits,8)*65,0,1000));\n   190\t    if (round.id==='finale' && !round.stillBroken) score=Math.min(1000,score+100);\n   191\t    const stars=score>=850?3:score>=650?2:score>=400?1:0;\n   192\t    let banked=0;\n   193\t    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\n   194\t    else if (state.profile) { const guest=state.profile; guest.clearedToday=guest.clearedToday||{}; banked=guest.clearedToday[round.id]?1:1+stars; guest.clearedToday[round.id]=true; guest.dayMinutes=(guest.dayMinutes||0)+banked; guest.minutesTotal=(guest.minutesTotal||0)+banked; guest.stars=(guest.stars||0)+stars; guest.bests[round.id]=Math.max(guest.bests[round.id]||0,score); if(round.id==='finale') {guest.finaleDone=true;guest.age=Math.max(18,Math.round((guest.age||60)-score/100));} save(); }\n   195\t    state.result={isCheck:false,name:round.name,score,stars,comment:`${titles[Math.min(titles.length-1,Math.floor(score/1000*titles.length))]}. We’ve banked ${state.together?'your points':`${banked} minute${banked===1?'':'s'} in the clam`}.`}; sound(660,.25,'sine'); voice(); setScreen('result');\n   196\t  }\n   197\t  function advanceResult() {\n   198\t    if(!state.together) {setScreen('island');return;}\n   199\t    const group=state.together; group.event++;\n   200\t    if(group.online) { if(group.event>=3) reportHub(); else {state.eventId=medley[group.event];startRound(state.eventId);} return; }\n   201\t    if(group.event>=3) {group.event=0;group.player++;}\n   202\t    if(group.player>=group.count) setScreen('podium'); else setScreen('handoff');\n   203\t  }\n   204\t  function reportHub() { if(!state.together || !state.together.online) return; const score=clamp(Math.round(state.together.scores[0]),0,3000); if(hub && !state.together.reported) {state.together.reported=true;hub.result({score,stats:{events:Math.min(3,state.together.event)},awards:[{name:'Island Enthusiast',description:'Completed the Tippy Cay medley.'}]});} state.message=`Medley complete: ${formatScore(score)} points. Waiting for the group.`;setScreen('waiting'); }\n   205\t\n   206\t  function updateInput(dt) {\n   207\t    let x=(keys.has('arrowright')||keys.has('d')?1:0)-(keys.has('arrowleft')||keys.has('a')?1:0), y=(keys.has('arrowdown')||keys.has('s')?1:0)-(keys.has('arrowup')||keys.has('w')?1:0);\n   208\t    let gamepad=null; try { gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean); } catch (_) {}\n   209\t    if(gamepad) {\n   210\t      const dead=value=>Math.abs(value)<.12?0:Math.sign(value)*Math.pow((Math.abs(value)-.12)/.88,1.5);\n   211\t      const gx=dead(gamepad.axes[0]||0), gy=dead(gamepad.axes[1]||0); if(Math.abs(gx)+Math.abs(gy)>.03) {x=gx;y=gy;markInput('gamepad');state.hasHardwareInput=true;}\n   212\t      const pressed=gamepad.buttons.map(item=>item.pressed);\n   213\t      for(const index of [0,9,12,13,14,15]) if(pressed[index]&&!previousButtons[index]) { markInput('gamepad');state.hasHardwareInput=true; if(index===9){if(['event','check'].includes(state.screen)) selectAction(state.paused?'resume':'pause');} else if(['event','check'].includes(state.screen)&&!state.paused) triggerAction(index===14?'left':index===15?'right':'action'); else if(index===0) { const focused=document.activeElement; if(focused && focused.tagName==='BUTTON') focused.click(); else app.querySelector('button:not([disabled])')?.focus(); } else if([12,13,14,15].includes(index)) moveFocus(index===12||index===14?-1:1); }\n   214\t      previousButtons=pressed;\n   215\t    }\n   216\t    const speed=keys.has('shift')?.5:1;\n   217\t    if(x||y) { aim.x=clamp(aim.x+x*1.6*dt*speed,-1,1); aim.y=clamp(aim.y+y*1.6*dt*speed,-1,1); }\n   218\t    else if(mouseAim && state.device==='mouse') { aim.x=mouseAim.x;aim.y=mouseAim.y; }\n   219\t    else {aim.x=smooth(aim.x,0,1.2,dt);aim.y=smooth(aim.y,0,1.2,dt);}\n   220\t    const round=state.round, time=round?.elapsed||0, wobble=.12;\n   221\t    const targetX=aim.x*.92+wobble*(Math.sin(time*2.13)*.6+Math.sin(time*3.71)*.4), targetY=aim.y*.92+wobble*(Math.sin(time*1.79)*.6+Math.sin(time*3.31)*.4);\n   222\t    const stiffness=state.stiffness||40, damping=state.damping||8.5;\n   223\t    center.vx+=((targetX-center.x)*stiffness-center.vx*damping)*dt;center.vy+=((targetY-center.y)*stiffness-center.vy*damping)*dt;\n   224\t    center.x=clamp(center.x+center.vx*dt,-1.2,1.2);center.y=clamp(center.y+center.vy*dt,-1.2,1.2);\n   225\t  }\n   226\t  function heldAction() { try { const gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);return mouseHeld||keys.has(' ')||keys.has('enter')||!!gamepad?.buttons[0]?.pressed; } catch (_) { return mouseHeld||keys.has(' '); } }\n   227\t  function tickRound(dt) {\n   228\t    const round=state.round; if(!round || state.paused || !['event','check'].includes(state.screen)) return;\n   229\t    round.elapsed+=dt; const time=round.elapsed;\n   230\t    let quality=clamp(1-Math.hypot(center.x,center.y)*.8,0,1), targetX=0,targetY=0, instruction=round.controls;\n   231\t    if(state.screen==='check') {\n   232\t      const phase=time<8?0:time<23?1:time<29?2:3;round.phase=phase;\n   233\t      if(phase===1) {targetX=[-.7,.7,-.7][Math.min(2,Math.floor((time-8)/5))];quality=clamp(1-Math.abs(center.x-targetX),0,1);instruction='Lean into the target ring.';}\n   234\t      else if(phase===2) instruction='Eyes closed. Trust the sound and find your center.';\n   235\t      else if(phase===3) instruction='Alternate left and right steps to the beat.';\n   236\t      else instruction='Stand still. This is the whole test.';\n   237\t      round.metric[phase]+=quality;round.phaseSamples[phase]++;\n   238\t    } else {\n   239\t      if(round.id==='breath') { const inhale=(time%8)<4;quality=(heldAction()===inhale)?1:.15;instruction=inhale?'Breathe in · hold Action':'Breathe out · release Action'; }\n   240\t      else if(round.id==='pose') { targetX=Math.sin(time*.58)*.55;targetY=Math.cos(time*.43)*.25;quality=clamp(1-Math.hypot(center.x-targetX,center.y-targetY),0,1);instruction='Follow the drifting ring.'; }\n   241\t      else if(round.id==='squat') {quality=clamp(round.actionHits/Math.max(1,time/.6)*1.1,0,1)*.7+quality*.3;instruction='Press Action as the beat lands.';}\n   242\t      else if(round.id==='plank') { quality=quality*(heldAction()?1:.35);instruction='Hold Action. Be one with the plank.'; }\n   243\t      else if(round.id==='step'||round.id==='lap') {quality=clamp(round.steps/Math.max(1,time/.625),0,1)*.65+clamp(round.actionHits/Math.max(1,round.actionCount),0,1)*.35;instruction='Alternate Left and Right on the beat.';}\n   244\t      else if(round.id==='spin') {const angle=Math.atan2(center.y,center.x);let diff=angle-round.prevAngle;while(diff>Math.PI)diff-=Math.PI*2;while(diff<-Math.PI)diff+=Math.PI*2;round.prevAngle=angle;round.spin=smooth(round.spin,Math.abs(diff)/Math.max(dt,.001),3,dt);quality=clamp(round.spin/4,0,1)*(Math.hypot(center.x,center.y)>.25?1:.3);instruction='Circle your lean. Keep the floaties moving!';}\n   245\t      else if(round.id==='tide') {round.shellVx=(round.shellVx+center.x*dt*.9)*Math.exp(-1.6*dt);round.shellVy=(round.shellVy+center.y*dt*.9)*Math.exp(-1.6*dt);round.shellX=clamp(round.shellX+round.shellVx*dt,-.9,.9);round.shellY=clamp(round.shellY+round.shellVy*dt,-.9,.9);targetX=Math.sin(round.potted*3)*.6;targetY=Math.cos(round.potted*2)*.55;if(Math.hypot(round.shellX-targetX,round.shellY-targetY)<.16){round.potted++;round.shellX=0;round.shellY=0;sound(780,.12);}quality=clamp(1-Math.hypot(round.shellX-targetX,round.shellY-targetY)*.5,0,1);instruction=`Shells in pools: ${round.potted} · Tilt toward the pool.`;}\n   246\t      else if(round.id==='paddle') {targetX=Math.sin(Math.floor(time/4.5)*1.9)*.65;quality=clamp(1-Math.abs(center.x-targetX),0,1);const gate=Math.floor(time/4.5);if(gate!==round.gateIndex){round.gateIndex=gate;if(quality>.63)round.gates++;}instruction=`Gates cleared: ${round.gates} · Steer to the ring.`;}\n   247\t      else if(round.id==='tray') {quality=clamp(quality-.08*Math.abs(Math.sin(time*1.7)),0,1);instruction='Keep the smoothies aboard.';}\n   248\t      else if(round.id==='dive') {quality=clamp(round.actionHits/Math.max(1,time/1.2)*1.5,0,1)*.7+(heldAction()?.3:0);instruction='Press at the bottom of the bounce; hold to tuck.';}\n   249\t      else if(round.id==='finale') {if(time<16){instruction=(time%8)<4?'Breathe in · hold Action':'Breathe out · release Action';quality=(heldAction()===((time%8)<4))?1:.2;}else if(time<36){targetX=Math.sin(time*.5)*.5;quality=clamp(1-Math.abs(center.x-targetX),0,1);instruction='Follow the pose through the breeze.';}else if(time<48){quality=clamp(round.steps/Math.max(1,(time-36)/.625),0,1);instruction='Step with the island marching band.';}else if(time<60){quality*=heldAction()?1:.3;instruction='Brace against the waves. Hold Action.';}else{instruction=time>75?'Press Action to skip? Or simply stay.':'The Long Stillness. Do nothing.';quality=round.stillBroken?.2:1;}}\n   250\t      round.sum+=quality;round.samples++;\n   251\t    }\n   252\t    const dot=document.getElementById('dot'), target=document.getElementById('target');\n   253\t    if(dot){dot.style.transform=`translate(${center.x*43}px,${center.y*43}px)`;dot.style.opacity=state.screen==='check'&&round.phase===2?'0':'1';}\n   254\t    if(target){target.style.transform=`translate(${targetX*43}px,${targetY*43}px)`;target.style.opacity=state.screen==='check'&&round.phase===2?'0':'1';}\n   255\t    const timer=document.getElementById('timer'), subtitle=document.getElementById('round-subtitle'), phase=document.getElementById('phase-card'), score=document.getElementById('round-score'), fill=document.getElementById('meter-fill');\n   256\t    if(timer)timer.textContent=Math.max(0,Math.ceil(round.length-time))+'s';if(subtitle)subtitle.textContent=instruction;if(phase)phase.textContent=instruction;if(score)score.textContent=state.screen==='check'?['STILL','LEAN','LISTEN','STEP'][round.phase]:formatScore(round.sum/Math.max(1,round.samples)*1000);if(fill)fill.style.width=clamp(time/round.length*100,0,100)+'%';\n   257\t    if(state.together?.online && hub && time-lastHubUpdate>.1){lastHubUpdate=time;hub.send({event:state.together.event,x:center.x,y:center.y,progress:time/round.length},{reliable:false});}\n   258\t    if(state.together?.online && hub && time-lastHubProgress>=2){lastHubProgress=time;hub.progress({score:state.together.scores[0]+Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000),label:round.name});}\n   259\t    if(time>=round.length) { if(state.screen==='check')finishCheck();else finishRound(); }\n   260\t  }\n   261\t\n   262\t  function moveFocus(direction) { const items=Array.from(app.querySelectorAll('button:not([disabled]),select,input')).filter(item=>item.offsetParent!==null);if(!items.length)return;const index=items.indexOf(document.activeElement);items[(index+direction+items.length)%items.length].focus(); }\n   263\t  app.addEventListener('click', event=>{const target=event.target.closest('[data-action]');if(target){markInput('mouse');selectAction(target.dataset.action);} });\n   264\t  window.addEventListener('keydown', event=>{const key=event.key.toLowerCase(); const inRound=['event','check'].includes(state.screen); if(['arrowup','arrowdown','arrowleft','arrowright','escape'].includes(key)||(key===' '&&inRound))event.preventDefault();if(!keys.has(key)){markInput('keyboard');if(key==='escape'&&inRound){selectAction(state.paused?'resume':'pause');}else if(inRound&&!state.paused){if(key===' '||key==='enter')triggerAction();if(key==='arrowleft'||key==='a')triggerAction('left');if(key==='arrowright'||key==='d')triggerAction('right');}else if(['arrowup','arrowleft','arrowdown','arrowright'].includes(key)&&!['INPUT','SELECT'].includes(document.activeElement?.tagName))moveFocus(key==='arrowup'||key==='arrowleft'?-1:1);else if(key==='enter'&&document.activeElement===document.body)app.querySelector('button:not([disabled])')?.click();}\n   265\t    keys.add(key);\n   266\t  });\n   267\t  window.addEventListener('keyup',event=>keys.delete(event.key.toLowerCase()));\n   268\t  window.addEventListener('blur',()=>{keys.clear();mouseHeld=false;});\n   269\t  window.addEventListener('pointermove',event=>{if(event.pointerType==='mouse'&&['event','check'].includes(state.screen)&&!state.paused){mouseAim={x:clamp((event.clientX-innerWidth/2)/(innerWidth*.35),-1,1),y:clamp((event.clientY-innerHeight/2)/(innerHeight*.35),-1,1)};markInput('mouse');}});\n   270\t  window.addEventListener('pointerdown',event=>{if(event.target.closest('button,input,select,details,summary'))return;if(event.pointerType==='mouse'&&['event','check'].includes(state.screen)){mouseHeld=true;triggerAction();}});\n   271\t  window.addEventListener('pointerup',()=>{mouseHeld=false;});\n   272\t\n   273\t  function resize() {const ratio=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(innerWidth*ratio);canvas.height=Math.round(innerHeight*ratio);viewport.width=canvas.width;viewport.height=canvas.height;viewport.scale=Math.max(canvas.width/1600,canvas.height/900);viewport.ox=(canvas.width-1600*viewport.scale)/2;viewport.oy=(canvas.height-900*viewport.scale)/2;}\n   274\t  window.addEventListener('resize',resize);resize();\n   275\t  function ellipse(x,y,rx,ry,color) {context.fillStyle=color;context.beginPath();context.ellipse(x,y,rx,ry,0,0,Math.PI*2);context.fill();}\n   276\t  function line(x1,y1,x2,y2,color,width=5) {context.strokeStyle=color;context.lineWidth=width;context.lineCap='round';context.beginPath();context.moveTo(x1,y1);context.lineTo(x2,y2);context.stroke();}\n   277\t  function palm(x,y,size,flip=1) {context.save();context.translate(x,y);context.scale(size*flip,size);line(0,0,12,-95,'#b87f5a',13);for(let index=0;index<5;index++){const angle=-2.9+index*.54;context.save();context.translate(12,-95);context.rotate(angle);ellipse(42,0,48,11,index%2?'#61b58b':'#449e83');context.restore();}context.restore();}\n   278\t  function human(x,y,size,skin,outfit,lean=0,step=0) {context.save();context.translate(x,y);context.scale(size,size);ellipse(0,5,29,9,'#347c7060');line(-8,-10,-13+step*8,2,'#526e73',8);line(8,-10,13-step*8,2,'#526e73',8);context.rotate(lean*.23);context.fillStyle=outfit;context.beginPath();context.roundRect(-16,-56,32,48,13);context.fill();line(-13,-47,-24+lean*8,-20,skin,8);line(13,-47,24+lean*8,-20,skin,8);ellipse(0,-67,15,17,skin);ellipse(-5,-68,1.4,1.5,'#28494a');ellipse(5,-68,1.4,1.5,'#28494a');context.restore();}\n","exit_code":0,"status":"completed"}}
