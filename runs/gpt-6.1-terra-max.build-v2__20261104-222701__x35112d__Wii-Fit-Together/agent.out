dayline span{height:8px;flex:1;border-radius:10px;background:#d7e6db}.dayline span.done{background:#27a69b}.dayline span.current{background:#ff9c7e}.activity-list{display:grid;gap:8px}.activity{width:100%;border:0;background:#eaf6ed;border-radius:13px;padding:12px 14px;text-align:left;font-weight:900;display:flex;align-items:center;justify-content:space-between;gap:8px}.activity small{font-size:11px;font-weight:800;color:#66827c}.activity:hover,.activity:focus-visible{background:#fff0d4}.island-note{align-self:end;justify-self:end;background:#fff9df;border-radius:16px;padding:16px 20px;max-width:245px;font-weight:800;box-shadow:0 9px 30px #1c656020}.hud{display:flex;justify-content:space-between;gap:12px;align-items:start}.hud .pill{font-size:14px}.event-center{position:absolute;top:17%;left:50%;transform:translateX(-50%);width:min(680px,80vw);text-align:center;pointer-events:none}.event-center h2{font-size:clamp(28px,4.2vw,60px);line-height:1;margin:10px 0;color:white;text-shadow:0 3px 14px #155c6080;letter-spacing:-.04em}.event-center p{font-size:clamp(16px,1.8vw,24px);font-weight:900;color:white;text-shadow:0 2px 8px #155c60}.puck{position:absolute;right:clamp(20px,4vw,70px);bottom:clamp(70px,11vh,120px);width:clamp(110px,14vw,185px);aspect-ratio:1;border:9px solid #fffefa;border-radius:50%;background:#245c6688;box-shadow:0 7px 0 #1a585b28, inset 0 0 0 2px #fff5}.puck:before,.puck:after{content:\"\";position:absolute;background:#ffffff55}.puck:before{left:50%;top:8%;width:1px;height:84%}.puck:after{top:50%;left:8%;height:1px;width:84%}.puck .target{position:absolute;left:50%;top:50%;width:24%;height:24%;transform:translate(-50%,-50%);border:2px dashed #fff9;border-radius:50%}.puck .dot{position:absolute;left:50%;top:50%;width:15%;height:15%;border-radius:50%;background:#ffe378;border:3px solid white;box-shadow:0 2px 6px #124b4d66;transform:translate(-50%,-50%)}.event-bottom{position:absolute;bottom:clamp(18px,3vw,40px);left:clamp(18px,3.2vw,54px);display:flex;gap:10px;align-items:center;flex-wrap:wrap}.meter{height:12px;border-radius:99px;background:#d9e8dd;overflow:hidden}.meter>span{display:block;height:100%;border-radius:inherit;background:#ff9478;transition:width .2s}.big-score{font-size:clamp(64px,9vw,110px);font-weight:1000;line-height:.9;letter-spacing:-.07em;color:var(--teal);margin:15px 0}.stars{color:#f6b94d;font-size:34px;letter-spacing:6px}.dialogue{border-left:5px solid #8adbd1;padding-left:16px;font-size:clamp(17px,1.7vw,22px);line-height:1.35;font-weight:800}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-grid div{padding:12px;background:#f2f8ee;border-radius:12px;overflow-wrap:anywhere;font-size:13px;line-height:1.4}.info-grid b{display:block;text-transform:uppercase;font-size:10px;letter-spacing:.1em;color:#498279}.about-list{font-size:13px;line-height:1.5;color:#50716d}.touch-guard{position:fixed;z-index:10;inset:0;background:#cff0e9ed;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}.touch-guard>div{max-width:440px}.touch-guard h2{font-size:clamp(28px,7vw,44px);line-height:1;margin:16px 0}.touch-guard .button{text-align:center}.touch-guard.settings-open{display:none}.attract-label{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);font-weight:1000;color:white;text-align:center;text-shadow:0 2px 7px #226}.hidden{display:none!important}\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css:4:@media(max-height:550px){.screen{padding:14px 24px}.title-layout{align-items:center;padding:0}.title-panel h1{font-size:clamp(42px,7vw,72px);margin:8px 0}.title-panel .lede{font-size:15px;margin:8px 0}.title-actions{margin-top:12px}.button{min-height:42px;padding:9px 14px}.hero-note{margin-bottom:4vh}.panel{padding:20px}.panel h2{font-size:32px}.panel-wrap{padding:8px 0}.event-center{top:12%}.event-center h2{font-size:30px}.event-center p{font-size:16px}.puck{bottom:55px;width:100px}.island-panel{padding:16px;max-height:80vh}.dayline{margin:8px 0}.activity{padding:8px 12px}.section-title{margin:10px 0 5px}}\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py:174:            (\"two players\", {\"players\": 2}),\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py:175:            (\"four players with network jitter\", {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5}),\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py:176:            (\"host leaves\", {\"players\": 3, \"scenario\": \"host-leave\"}),\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py:178:            def conformance():\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py:189:            test(\"AI Hub \" + name, conformance)\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:33:  let center = {x:0,y:0,vx:0,vy:0}, aim = {x:0,y:0}, mouseAim = null, mouseHeld = false, previousButtons = [], audio, musicClock = 0, lastFrame = performance.now(), lastHubUpdate = 0;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:73:      html = shell(`<div class=\"island-layout\"><section class=\"island-panel\"><div class=\"eyebrow\">HELLO, ${esc(guest.name.toUpperCase())} · ${guest.freePlay?'FREE PLAY':'YOUR ISLAND STAY'}</div><h2>Find your<br>happy wobble.</h2><div class=\"dayline\"><span>DAY ${day} / 5</span><span>✳ ${guest.dayMinutes || 0} / ${goal || '∞'} MIN</span><span>★ ${guest.stars || 0} STARS</span></div><p class=\"island-note\">${guest.checked ? `Pip says your Balance Age is ${guest.age}. The clam looks impressed.` : 'Pip is waiting for your morning Wobble Check.'}</p><div class=\"activity-list\">${!guest.checked ? `<button class=\"activity highlight\" data-action=\"check\"><span>◉</span><strong>Morning Wobble Check<small>Say hello to Pip · about a minute</small></strong><b>→</b></button>` : ''}${available.map(item=>`<button class=\"activity\" data-action=\"intro:${item.id}\"><span>${item.day===4?'≈':item.day===3?'✳':item.day===5?'★':'◌'}</span><strong>${item.name}<small>${item.place} · ${item.coach}</small></strong><b>→</b></button>`).join('')}</div><div class=\"row island-actions\">${button('Guest book','calendar')}${button(day===5?'Finish the stay':'Call it a day','end-day','primary')}</div></section></div><div class=\"footer\"><span>MINUTE CLAM: ${guest.minutesTotal || 0} MINUTES SAVED</span><button class=\"pill\" data-action=\"settings\">Settings</button></div>`, guest.freePlay ? 'FREE PLAY' : `DAY ${day} OF 5`);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:113:    if (isTouchOnly() && !state.hasHardwareInput && !['settings','about'].includes(state.screen)) html += `<div class=\"touch-guard\"><div><strong>Controller or keyboard required</strong><p>Connect one to play. The island will wait for you.</p><button class=\"button\" data-action=\"settings\">Settings</button></div></div>`;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:162:  function startCheck() { center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; state.paused=false; state.round={name:'Morning Wobble Check',place:'Stillness Studio',instruction:'Stand still. This is the whole test.',controls:'Keep the dot near the center.',length:37,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,targets:0,phase:0,steps:0,lastStep:'',metric:[0,0,0,0],phaseSamples:[0,0,0,0]}; setScreen('check'); }\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:163:  function startRound(id) { const item=eventById(id); if(!item) return; center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; lastHubUpdate=0; state.paused=false; state.round={...item,instruction:item.controls,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,steps:0,lastStep:'',shellX:0,shellY:0,shellVx:0,shellVy:0,potted:0,spin:0,prevAngle:0,gates:0,gateIndex:-1,stillBroken:false,ghostTrail:[]}; setScreen('event'); }\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:192:    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:256:    if(state.together?.online && hub && time-lastHubUpdate>.1){lastHubUpdate=time;hub.send({event:state.together.event,x:center.x,y:center.y,progress:time/round.length},{reliable:false});}\nimport json\nimport os\nimport sys\nimport threading\nimport traceback\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nHTML = ROOT / f\"{DEV.name}.html\"\nARTIFACTS = DEV / \"tests\" / \"artifacts\"\nfailures = []\nchecks = 0\n\n\ndef test(name, function):\n    global checks\n    checks += 1\n    try:\n        function()\n    except Exception:\n        failures.append(f\"{name}:\\n{traceback.format_exc()}\")\n\n\ndef status(page):\n    return json.loads(page.evaluate(\"window.__gameStatus()\"))\n\n\ndef click(page, action):\n    page.locator(f'[data-action=\"{action}\"]').first.click(timeout=5000)\n\n\ndef advance(page):\n    page.evaluate(\"window.__testAdvance(200)\")\n    assert status(page)[\"scene\"] == \"result\", status(page)\n\n\ndef load(browser, **kwargs):\n    context = browser.new_context(**kwargs)\n    page = context.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda error: errors.append(str(error)))\n    page.goto(HTML.as_uri() + \"?test=1\", wait_until=\"domcontentloaded\")\n    page.wait_for_function(\"window.__gameBoot?.ready === true\")\n    return context, page, errors\n\n\ndef new_guest(page):\n    click(page, \"slots-new\")\n    click(page, \"slot:0\")\n    page.locator(\"#guest-name\").select_option(label=\"Ari\")\n    click(page, \"skin:2\")\n    click(page, \"outfit:3\")\n    click(page, \"create-guest\")\n    click(page, \"island\")\n    assert status(page)[\"guest\"] == \"Ari\"\n\n\ndef browser_tests(playwright):\n    for engine in (\"chromium\", \"firefox\", \"webkit\"):\n        browser = getattr(playwright, engine).launch(headless=True)\n\n        def smoke():\n            context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n            assert \"Wii Fit\" in page.title()\n            click(page, \"about\")\n            assert \"Source Information\" in page.locator(\"#app\").inner_text()\n            click(page, \"title\")\n            new_guest(page)\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            page.keyboard.press(\"Escape\")\n            assert status(page)[\"paused\"]\n            page.keyboard.press(\"Escape\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"checked\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            page.keyboard.press(\"Space\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"minutes\"] == 2\n            page.screenshot(path=str(ARTIFACTS / f\"{engine}-island.png\"))\n            assert not errors, errors\n            context.close()\n\n        test(f\"{engine} guest, check and activity\", smoke)\n        browser.close()\n\n    browser = playwright.chromium.launch(headless=True)\n\n    def stay():\n        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n        new_guest(page)\n        for day, repetitions in enumerate((2, 3, 4, 5, 1), 1):\n            assert status(page)[\"day\"] == day\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            advance(page)\n            click(page, \"result-next\")\n            for _ in range(repetitions):\n                click(page, \"intro:finale\" if day == 5 else \"intro:breath\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n            click(page, \"end-day\")\n            click(page, \"sleep\")\n        assert status(page)[\"scene\"] == \"ending\"\n        click(page, \"free-play\")\n        assert status(page)[\"scene\"] == \"island\"\n        page.reload(wait_until=\"domcontentloaded\")\n        page.wait_for_function(\"window.__gameBoot?.ready === true\")\n        click(page, \"slots-continue\")\n        click(page, \"slot:0\")\n        assert status(page)[\"guest\"] == \"Ari\" and status(page)[\"day\"] == 5\n        assert not errors, errors\n        context.close()\n\n    test(\"five-day stay, ending and save persistence\", stay)\n\n    def medley():\n        context, page, errors = load(browser)\n        click(page, \"together\")\n        click(page, \"hotseat:2\")\n        for player in range(2):\n            for event in range(3):\n                current = status(page)[\"together\"]\n                assert current[\"player\"] == player and current[\"event\"] == event, current\n                click(page, \"hotseat-next\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n        assert status(page)[\"scene\"] == \"podium\"\n        assert not errors, errors\n        context.close()\n\n    test(\"two-player local medley\", medley)\n    browser.close()\n\n    browser = playwright.webkit.launch(headless=True)\n\n    def touch_guard():\n        context, page, errors = load(browser, **playwright.devices[\"iPhone SE (3rd gen)\"])\n        assert \"Controller or keyboard required\" in page.locator(\"#app\").inner_text()\n        page.screenshot(path=str(ARTIFACTS / \"iphone-touch.png\"))\n        click(page, \"settings\")\n        assert status(page)[\"scene\"] == \"settings\"\n        assert not errors, errors\n        context.close()\n\n    test(\"touch-only guard and settings\", touch_guard)\n    browser.close()\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef hub_tests(playwright):\n    server = ThreadingHTTPServer((\"127.0.0.1\", 0), partial(QuietHandler, directory=str(ROOT)))\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    browser = playwright.chromium.launch(headless=True)\n    try:\n        for name, settings in [\n            (\"two players\", {\"players\": 2}),\n            (\"four players with network jitter\", {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5}),\n            (\"host leaves\", {\"players\": 3, \"scenario\": \"host-leave\"}),\n        ]:\n            def conformance():\n                page = browser.new_page()\n                query = urlencode({\"auto\": 1, \"game\": \"../../\" + HTML.name, **settings})\n                url = f\"http://127.0.0.1:{server.server_port}/{DEV.name}/hub/harness.html?{query}\"\n                page.goto(url, wait_until=\"domcontentloaded\")\n                page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=60000)\n                result = page.evaluate(\"window.__hubCheck\")\n                bad = [f'{item[\"name\"]}: {item.get(\"detail\", \"\")}' for item in result[\"checks\"] if not item[\"pass\"]]\n                assert result[\"pass\"], \"\\n\".join(bad)\n                page.close()\n\n            test(\"AI Hub \" + name, conformance)\n    finally:\n        browser.close()\n        server.shutdown()\n        server.server_close()\n        thread.join()\n\n\ndef main():\n    os.environ.setdefault(\"PLAYWRIGHT_HOST_PLATFORM_OVERRIDE\", \"ubuntu24.04-x64\")\n    ARTIFACTS.mkdir(parents=True, exist_ok=True)\n    with sync_playwright() as playwright:\n        if len(sys.argv) == 1 or sys.argv[1] in (\"browser\", \"all\"):\n            browser_tests(playwright)\n        if len(sys.argv) == 1 or sys.argv[1] in (\"hub\", \"all\"):\n            hub_tests(playwright)\n    for failure in failures:\n        print(f\"FAIL {failure}\")\n    print(f\"{checks - len(failures)}/{checks} checks passed\")\n    sys.exit(bool(failures))\n\n\nif __name__ == \"__main__\":\n    main()\n# Progress\n\n- Title: **Wii Fit Together**, selected uniformly using Node.js `crypto.randomInt` from 50 brainstormed candidates.\n- Deliverable: `Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701.html` in the workspace root; source and development files in the identically named directory.\n- Engine and Hub client acquired; native engine build succeeds. Registered a Tippy Cay scene and deterministic balance spring in Shardfall.\n- Current phase: bundle the standalone browser game and embedded AI Hub client.\n- Next: test gameplay, persistence, Hub and viewport behavior; complete the exit interview and final hand-in.\n- Limitation: the playable presentation and most activity logic are Canvas 2D / JavaScript over a Shardfall hook, not the planned full native 3D engine implementation.\n","exit_code":0,"status":"completed"}}
