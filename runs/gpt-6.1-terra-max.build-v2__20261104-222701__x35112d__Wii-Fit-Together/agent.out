{"type":"item.started","item":{"id":"item_358","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '1,120p' \\\"\"'$dev/tests/test_game.py\"; sed -n '\"'130,240p' \\\"\"'$dev/tests/test_game.py\"; rg -n '\"'settings-back|begin-check|data-action=\\\"pause\\\"|scene.*settings' \\\"\"'$dev/web/game.js\" | head -40; cat \"$dev/tests/run.sh\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_358","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '1,120p' \\\"\"'$dev/tests/test_game.py\"; sed -n '\"'130,240p' \\\"\"'$dev/tests/test_game.py\"; rg -n '\"'settings-back|begin-check|data-action=\\\"pause\\\"|scene.*settings' \\\"\"'$dev/web/game.js\" | head -40; cat \"$dev/tests/run.sh\"'","aggregated_output":"import json\nimport os\nimport sys\nimport threading\nimport traceback\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nHTML = ROOT / f\"{DEV.name}.html\"\nARTIFACTS = DEV / \"tests\" / \"artifacts\"\nfailures = []\nchecks = 0\n\n\ndef test(name, function):\n    global checks\n    checks += 1\n    try:\n        function()\n    except Exception:\n        failures.append(f\"{name}:\\n{traceback.format_exc()}\")\n\n\ndef status(page):\n    return json.loads(page.evaluate(\"window.__gameStatus()\"))\n\n\ndef click(page, action):\n    page.locator(f'[data-action=\"{action}\"]').first.click(timeout=5000)\n\n\ndef advance(page):\n    page.evaluate(\"window.__testAdvance(200)\")\n    assert status(page)[\"scene\"] == \"result\", status(page)\n\n\ndef load(browser, **kwargs):\n    context = browser.new_context(**kwargs)\n    page = context.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda error: errors.append(str(error)))\n    page.goto(HTML.as_uri() + \"?test=1\", wait_until=\"domcontentloaded\")\n    page.wait_for_function(\"window.__gameBoot?.ready === true\")\n    return context, page, errors\n\n\ndef new_guest(page):\n    click(page, \"slots-new\")\n    click(page, \"slot:0\")\n    page.locator(\"#guest-name\").select_option(label=\"Ari\")\n    click(page, \"skin:2\")\n    click(page, \"outfit:3\")\n    click(page, \"create-guest\")\n    click(page, \"island\")\n    assert status(page)[\"guest\"] == \"Ari\"\n\n\ndef browser_tests(playwright):\n    for engine in (\"chromium\", \"firefox\", \"webkit\"):\n        browser = getattr(playwright, engine).launch(headless=True)\n\n        def smoke():\n            context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n            assert \"Wii Fit\" in page.title()\n            click(page, \"about\")\n            assert \"Source Information\" in page.locator(\"#app\").inner_text()\n            click(page, \"title\")\n            new_guest(page)\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            page.keyboard.press(\"Escape\")\n            assert status(page)[\"paused\"]\n            page.keyboard.press(\"Escape\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"checked\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            page.keyboard.press(\"Space\")\n            advance(page)\n            assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n            click(page, \"result-next\")\n            page.screenshot(path=str(ARTIFACTS / f\"{engine}-island.png\"))\n            assert not errors, errors\n            context.close()\n\n        test(f\"{engine} guest, check and activity\", smoke)\n        browser.close()\n\n    browser = playwright.chromium.launch(headless=True)\n\n    def stay():\n        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n        new_guest(page)\n        for day, goal in enumerate((3, 5, 7, 9, 0), 1):\n            assert status(page)[\"day\"] == day\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            advance(page)\n            click(page, \"result-next\")\n            for _ in range(goal if day < 5 else 1):\n                if day < 5 and status(page)[\"minutes\"] >= goal:\n                    break\n                click(page, \"intro:finale\" if day == 5 else \"intro:breath\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n            click(page, \"end-day\")\n            click(page, \"sleep\")\n        assert status(page)[\"scene\"] == \"ending\"\n        click(page, \"free-play\")\n        assert status(page)[\"scene\"] == \"island\"\n        page.reload(wait_until=\"domcontentloaded\")\n    def minute_rewards():\n        context, page, errors = load(browser)\n        new_guest(page)\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\n        for attempt in range(2):\n            before = status(page)[\"minutes\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            earned = status(page)[\"minutes\"] - before\n            assert earned == (1 + status(page)[\"resultStars\"] if attempt == 0 else 1)\n            click(page, \"result-next\")\n        while status(page)[\"minutes\"] < 3:\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            click(page, \"result-next\")\n        click(page, \"end-day\")\n        click(page, \"sleep\")\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\n        click(page, \"intro:breath\")\n        click(page, \"begin-event\")\n        advance(page)\n        assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n        assert not errors, errors\n        context.close()\n\n    test(\"first-clear and repeat minute rewards\", minute_rewards)\n\n    def medley():\n        context, page, errors = load(browser)\n        click(page, \"together\")\n        click(page, \"hotseat:2\")\n        for player in range(2):\n            for event in range(3):\n                current = status(page)[\"together\"]\n                assert current[\"player\"] == player and current[\"event\"] == event, current\n                click(page, \"hotseat-next\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n        assert status(page)[\"scene\"] == \"podium\"\n        assert not errors, errors\n        context.close()\n\n    test(\"two-player local medley\", medley)\n\n    def tuning():\n        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n        new_guest(page)\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        click(page, \"pause\")\n        before = status(page)[\"elapsed\"]\n        page.wait_for_timeout(250)\n        assert status(page)[\"elapsed\"] == before\n        page.locator(\"summary\").click()\n        page.screenshot(path=str(ARTIFACTS / \"pause-tuning.png\"))\n        for kind, value in ((\"stiffness\", 55), (\"damping\", 10), (\"wobble\", .2), (\"timeScale\", 2)):\n            page.locator(f\"#dev-{kind}\").evaluate(\"(element, value) => { element.value = value; element.dispatchEvent(new Event('input', {bubbles:true})); }\", str(value))\n        click(page, \"reset-tuning\")\n        page.locator(\"summary\").click()\n        for kind, value in ((\"stiffness\", 40), (\"damping\", 8.5), (\"wobble\", .12), (\"timeScale\", 1)):\n            assert float(page.locator(f\"#dev-{kind}\").input_value()) == value\n        click(page, \"give-minutes\")\n        assert status(page)[\"minutes\"] == 5\n        page.locator(\"summary\").click()\n        click(page, \"finish-now\")\n        assert status(page)[\"scene\"] == \"result\" and status(page)[\"checked\"]\n        assert not errors, errors\n        context.close()\n\n    test(\"offline pause and developer controls\", tuning)\n\n    def online_pause():\n        context = browser.new_context(viewport={\"width\": 1280, \"height\": 800})\n        context.add_init_script(\"\"\"window.AIHub={active:true,handlers:{},on(name,fn){this.handlers[name]=fn},connect(){return Promise.resolve({players:[{},{}],splash:true})},ready(){this.handlers.start({in:0})},progress(){},send(){},result(){},probe(){}};\"\"\")\n        page = context.new_page()\n        errors = []\n        page.on(\"pageerror\", lambda error: errors.append(str(error)))\n        page.goto(HTML.as_uri() + \"?test=1\", wait_until=\"domcontentloaded\")\n        page.wait_for_function(\"window.__gameStatus && JSON.parse(window.__gameStatus()).scene === 'event'\")\n        click(page, \"pause\")\n        assert page.locator(\"summary\").count() == 0\n        assert page.locator('[data-action=\"leave-event\"]').count() == 0\n        before = status(page)[\"elapsed\"]\n        page.wait_for_timeout(350)\n        assert status(page)[\"elapsed\"] > before + .15\n        click(page, \"settings\")\n        before = status(page)[\"elapsed\"]\n        page.wait_for_timeout(350)\n        assert status(page)[\"elapsed\"] > before + .15\n        click(page, \"settings-back\")\n        assert status(page)[\"paused\"]\n        click(page, \"resume\")\n        advance(page)\n        page.wait_for_function(\"JSON.parse(window.__gameStatus()).together.event === 1\", timeout=5000)\n        assert status(page)[\"scene\"] == \"event\"\n        assert not errors, errors\n        context.close()\n\n    test(\"online pause and automatic medley progression\", online_pause)\n    browser.close()\n\n    browser = playwright.webkit.launch(headless=True)\n81:      html = modal('Morning Wobble Check','PIP · RECEPTION CUSHION', `<div class=\"dialogue\"><p>“This is not a test of your worth. It is a test of whether the dot stays near the middle.”</p></div><p>Four little checks: stand still, lean toward targets, close your eyes, and alternate steps. Your Balance Age is a playful score, not medical advice.</p><div class=\"row\">${button('Back','island')}${button('Begin the check','begin-check','primary')}</div>`, 'island');\n84:      html = shell(`<div class=\"hud\"><div><div class=\"eyebrow\">${esc(round.place.toUpperCase())}</div><h2 id=\"round-name\">${esc(round.name)}</h2><div id=\"round-subtitle\">${esc(round.instruction)}</div></div><div class=\"hud-right\"><div class=\"pill\" id=\"timer\">${Math.ceil(round.length)}s</div><button class=\"pill\" data-action=\"pause\">Ⅱ Pause</button></div></div><div class=\"event-center\"><div class=\"phase-card\" id=\"phase-card\">${esc(round.instruction)}</div></div><div class=\"event-bottom\"><div class=\"puck\" aria-label=\"Balance puck\"><div class=\"target\" id=\"target\"></div><div class=\"dot\" id=\"dot\"></div></div><div class=\"meter\"><div><strong id=\"round-score\">0</strong> <span id=\"score-label\">POINTS</span></div><div class=\"meter-track\"><div id=\"meter-fill\"></div></div><small id=\"round-help\">${esc(round.controls)}</small></div></div>`, state.together ? `PLAYER ${state.together.player+1} · MEDLEY` : 'FIND YOUR BALANCE');\n106:      html = modal('Make it yours','SETTINGS & CONTROLS', `<label class=\"field\">Music volume: <span id=\"music-value\">${Math.round(settings.music*100)}%</span><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"${Math.round(settings.music*100)}\"></label><label class=\"field\">Sound effects <select id=\"sound\"><option value=\"on\" ${settings.sound?'selected':''}>On</option><option value=\"off\" ${!settings.sound?'selected':''}>Off</option></select></label><label class=\"field\">Controller labels <select id=\"glyph\"><option ${settings.glyph==='PlayStation'?'selected':''}>PlayStation</option><option ${settings.glyph==='Xbox'?'selected':''}>Xbox</option></select></label><p>Keyboard: WASD or arrow keys to lean; Space / Enter to act; Esc to pause. Controller: left stick and ${settings.glyph==='Xbox'?'A':'Cross'}. Mouse: move to lean and click to act. Arrow keys navigate menus.</p><p>Touch-only devices can view the island; connect a controller or keyboard to play.</p><div class=\"row\">${button('Done','settings-back','primary')}</div>`, 'settings-back');\n141:    else if (action==='begin-check') startCheck();\n159:    else if (action==='settings-back') setScreen(state.returnScreen || 'title');\n#!/usr/bin/env bash\nset -euo pipefail\nexport PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64\nexec python3 \"$(dirname \"$0\")/test_game.py\" \"${1:-all}\"\n","exit_code":0,"status":"completed"}}
