{"type":"item.started","item":{"id":"item_416","type":"command_execution","command":"/bin/bash -lc \"set -eu\nexport PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64\npython3 - <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nhtml = next(Path.cwd().glob('Wii Fit Together-*.html')).as_uri()\nwith sync_playwright() as playwright:\n    browser = playwright.chromium.launch(headless=True, args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n    page = browser.new_page(viewport={'width':1280,'height':800})\n    errors, console = [], []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    page.on('console', lambda message: console.append(f'{message.type}: {message.text}') if message.type in ('error','warning') else None)\n    page.goto(html+'?test=1', wait_until='domcontentloaded')\n    page.wait_for_function('window.__gameBoot?.ready === true')\n    page.wait_for_timeout(12000)\n    print('WebGPU:', page.evaluate('async () => ({available:\"'!!navigator.gpu, adapter:!!(await navigator.gpu?.requestAdapter()), canvases:[...document.querySelectorAll(\"canvas\")].map(x => ({id:x.id, width:x.width, height:x.height}))})'\"'))\n    print('Page errors:',errors)\n    print('Warnings/errors:',console[:12])\n    browser.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
