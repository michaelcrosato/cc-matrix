d=\"sound\"><option value=\"on\" ${settings.sound?'selected':''}>On</option><option value=\"off\" ${!settings.sound?'selected':''}>Off</option></select></label><label class=\"field\">Controller labels <select id=\"glyph\"><option ${settings.glyph==='PlayStation'?'selected':''}>PlayStation</option><option ${settings.glyph==='Xbox'?'selected':''}>Xbox</option></select></label><p>Keyboard: WASD or arrow keys to lean; Space / Enter to act; Esc to pause. Controller: left stick and ${settings.glyph==='Xbox'?'A':'Cross'}. Mouse: move to lean and click to act. Arrow keys navigate menus.</p><p>Touch-only devices can view the island; connect a controller or keyboard to play.</p><div class=\"row\">${button('Done','settings-back','primary')}</div>`, 'settings-back');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:123:    for (const kind of ['stiffness','damping']) { const input=document.getElementById('dev-'+kind); if(input) input.addEventListener('input', event=>{state[kind]=Number(event.target.value);}); }\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:145:    else if (action==='pause') { state.paused=true; render(); }\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:147:    else if (action==='reset-tuning') { state.stiffness=40; state.damping=8.5; render(); }\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:156:    else if (action==='settings') { state.returnScreen=state.screen; setScreen('settings'); }\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:157:    else if (action==='settings-back') setScreen(state.returnScreen || 'title');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:185:  function finishRound() {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:220:    const round=state.round, time=round?.elapsed||0, wobble=.12;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:221:    const