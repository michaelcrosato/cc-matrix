round:rgba(255,253,242,.95);border-radius:24px;padding:clamp(20px,2.2vw,32px);max-height:100%;overflow:auto;box-shadow:0 15px 50px #2d797929}.island-panel h2{font-size:clamp(30px,3.1vw,46px);line-height:1;letter-spacing:-.05em;margin:9px 0}.dayline{display:flex;gap:6px;margin:16px 0}.dayline span{height:8px;flex:1;border-radius:10px;background:#d7e6db}.dayline span.done{background:#27a69b}.dayline span.current{background:#ff9c7e}.activity-list{display:grid;gap:8px}.activity{width:100%;border:0;background:#eaf6ed;border-radius:13px;padding:12px 14px;text-align:left;font-weight:900;display:flex;align-items:center;justify-content:space-between;gap:8px}.activity small{font-size:11px;font-weight:800;color:#66827c}.activity:hover,.activity:focus-visible{background:#fff0d4}.island-note{align-self:end;justify-self:end;background:#fff9df;border-radius:16px;padding:16px 20px;max-width:245px;font-weight:800;box-shadow:0 9px 30px #1c656020}.hud{display:flex;justify-content:space-between;gap:12px;align-items:start}.hud .pill{font-size:14px}.event-center{position:absolute;top:17%;left:50%;transform:translateX(-50%);width:min(680px,80vw);text-align:center;pointer-events:none}.event-center h2{font-size:clamp(28px,4.2vw,60px);line-height:1;margin:10px 0;color:white;text-shadow:0 3px 14px #155c6080;letter-spacing:-.04em}.event-center p{font-size:clamp(16px,1.8vw,24px);font-weight:900;color:white;text-shadow:0 2px 8px #155c60}.puck{position:absolute;right:clamp(20px,4vw,70px);bottom:clamp(70px,11vh,120px);width:clamp(110px,14vw,185px);aspect-ratio:1;border:9px solid #fffefa;border-radius:50%;background:#245c6688;box-shadow:0 7px 0 #1a585b28, inset 0 0 0 2px #fff5}.puck:before,.puck:after{content:\"\";position:absolute;background:#ffffff55}.puck:before{left:50%;top:8%;width:1px;height:84%}.puck:after{top:50%;left:8%;height:1px;width:84%}.puck .target{position:absolute;left:50%;top:50%;width:24%;height:24%;transform:translate(-50%,-50%);border:2px dashed #fff9;border-radius:50%}.puck .d