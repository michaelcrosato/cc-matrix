n:9px 0 10px}.panel p{line-height:1.4;margin:8px 0 18px;color:var(--muted);font-weight:650}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:20px;margin-bottom:16px}.close{background:#edf6ec;border:0;border-radius:50%;width:42px;height:42px;font-size:23px;font-weight:800;flex:none}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.cards.three{grid-template-columns:repeat(3,minmax(0,1fr))}.card{min-width:0;border:1px solid #dce9df;border-radius:17px;background:#f6faf1;padding:16px;text-align:left}.card strong{font-size:18px;display:block;line-height:1.1}.card small{display:block;margin-top:7px;font-size:12px;line-height:1.3;color:#638079;font-weight:700}.card:hover,.card:focus-visible{border-color:#ffad7a;background:#fff6e4}.card.selected{border:3px solid var(--teal);padding:14px}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.row>.button{flex:1}.field{display:block;font-size:13px;font-weight:900;margin:14px 0}.field select,.field input{display:block;box-sizing:border-box;width:100%;margin-top:6px;border:1px solid #cfdfd8;border-radius:12px;background:white;padding:12px;font:inherit;color:var(--ink)}.swatches{display:flex;gap:10px;flex-wrap:wrap;margin:9px 0 17px}.swatch{width:40px;height:40px;border:3px solid white;border-radius:50%;box-shadow:0 0 0 1px #aac8bf}.swatch.selected{box-shadow:0 0 0 3px var(--teal)}.section-title{font-size:12px;font-weight:1000;letter-spacing:.13em;text-transform:uppercase;color:#61817d;margin:18px 0 9px}.island-layout{display:grid;grid-template-columns:minmax(280px,370px) 1fr;gap:20px;flex:1;min-height:0;align-items:center}.island-panel{background:rgba(255,253,242,.95);border-radius:24px;padding:clamp(20px,2.2vw,32px);max-height:100%;overflow:auto;box-shadow:0 15px 50px #2d797929}.island-panel h2{font-size:clamp(30px,3.1vw,46px);line-height:1;letter-spacing:-.05em;margin:9px 0}.dayline{display:flex;gap:6px;margin:16px 0}.dayline span{height:8px;flex:1;border-radius:10px;background:#d7e6db}.dayline span.done{background:#27a69b}.dayline span.current{background:#ff9c7e}.activity-list{display:grid;gap:8px}.activity{width:100%;border:0;background:#eaf6ed;border-radius:13px;padding:12px 14px;text-align:left;font-weight:900;display:flex;align-items:center;justify-content:space-between;gap:8px}.activity small{font-size:11px;font-weight:800;color:#66827c}.activity:hover,.activity:focus-visible{background:#fff0d4}.island-note{align-self:end;justify-self:end;background:#fff9df;border-radius:16px;padding:16px 20px;max-width:245px;font-weight:800;box-shadow:0 9px 30px #1c656020}.hud{display:flex;justify-content:space-between;gap:12px;align-items:start}.hud .pill{font-size:14px}.event-center{position:absolute;top:17%;left:50%;transform:translateX(-50%);width:min(680px,80vw);text-align:center;pointer-events:none}.event-center h2{font-size:clamp(28px,4.2vw,60px);line-height:1;margin:10px 0;color:white;text-shadow:0 3px 14px #155c6080;letter-spacing:-.04em}.event-center p{font-size:clamp(16px,1.8vw,24px);font-weight:900;color:white;text-shadow:0 2px 8px #155c60}.puck{position:absolute;right:clamp(20px,4vw,70px);bottom:clamp(70px,11vh,120px);width:clamp(110px,14vw,185px);aspect-ratio:1;border:9px solid #fffefa;border-radius:50%;background:#245c6688;box-shadow:0 7px 0 #1a585b28, inset 0 0 0 2px #fff5}.puck:before,.puck:after{content:\"\";position:absolute;background:#ffffff55}.puck:before{left:50%;top:8%;width:1px;height:84%}.puck:after{top:50%;left:8%;height:1px;width:84%}.puck .target{position:absolute;left:50%;top:50%;width:24%;height:24%;transform:translate(-50%,-50%);border:2px dashed #fff9;border-radius:50%}.puck .dot{position:absolute;left:50%;top:50%;width:15%;height:15%;border-radius:50%;background:#ffe378;border:3px solid white;box-shadow:0 2px 6px #124b4d66;transform:translate(-50%,-50%)}.event-bottom{position:absolute;bottom:clamp(18px,3vw,40px);left:clamp(18px,3.2vw,54px);display:flex;gap:10px;align-items:center;flex-wrap:wrap}.meter{height:12px;border-radius:99px;background:#d9e8dd;overflow:hidden}.meter>span{display:block;height:100%;border-radius:inherit;background:#ff9478;transition:width .2s}.big-score{font-size:clamp(64px,9vw,110px);font-weight:1000;line-height:.9;letter-spacing:-.07em;color:var(--teal);margin:15px 0}.stars{color:#f6b94d;font-size:34px;letter-spacing:6px}.dialogue{border-left:5px solid #8adbd1;padding-left:16px;font-size:clamp(17px,1.7vw,22px);line-height:1.35;font-weight:800}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-grid div{padding:12px;background:#f2f8ee;border-radius:12px;overflow-wrap:anywhere;font-size:13px;line-height:1.4}.info-grid b{display:block;text-transform:uppercase;font-size:10px;letter-spacing:.1em;color:#498279}.about-list{font-size:13px;line-height:1.5;color:#50716d}.touch-guard{position:fixed;z-index:10;inset:0;background:#cff0e9ed;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}.touch-guard>div{max-width:440px}.touch-guard h2{font-size:clamp(28px,7vw,44px);line-height:1;margin:16px 0}.touch-guard .button{text-align:center}.touch-guard.settings-open{display:none}.attract-label{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);font-weight:1000;color:white;text-align:center;text-shadow:0 2px 7px #226}.hidden{display:none!important}\n+@media(max-width:700px){.screen{padding:18px}.title-layout{grid-template-columns:1fr;align-items:start;padding-top:8vh}.title-panel{max-width:400px}.title-panel h1{font-size:clamp(52px,12vw,78px)}.title-panel .lede{max-width:310px}.hero-note{display:none}.title-actions{max-width:360px}.island-layout{grid-template-columns:1fr;align-items:end}.island-panel{max-height:69vh}.island-note{display:none}.footer{font-size:10px}.panel-wrap{align-items:center}.cards.three{grid-template-columns:1fr 1fr}.event-center{top:19%;width:90vw}.puck{width:105px;border-width:6px}.event-bottom{max-width:58vw}.hud .pill{font-size:11px}.info-grid{grid-template-columns:1fr}}\n+@media(max-height:550px){.screen{padding:14px 24px}.title-layout{align-items:center;padding:0}.title-panel h1{font-size:clamp(42px,7vw,72px);margin:8px 0}.title-panel .lede{font-size:15px;margin:8px 0}.title-actions{margin-top:12px}.button{min-height:42px;padding:9px 14px}.hero-note{margin-bottom:4vh}.panel{padding:20px}.panel h2{font-size:32px}.panel-wrap{padding:8px 0}.event-center{top:12%}.event-center h2{font-size:30px}.event-center p{font-size:16px}.puck{bottom:55px;width:100px}.island-panel{padding:16px;max-height:80vh}.dayline{margin:8px 0}.activity{padding:8px 12px}.section-title{margin:10px 0 5px}}\n*** End Patch\nPATCH'","aggregated_output":"Success. Updated the following files:\nA Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css\n","exit_code":0,"status":"completed"}}
