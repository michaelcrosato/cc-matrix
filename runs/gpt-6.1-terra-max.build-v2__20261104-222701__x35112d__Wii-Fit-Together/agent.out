{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc \"DEV='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; rg -ni '</script' \\\"\"'$DEV/web/game.js\" \"$DEV/hub/session.js\" || true; sed -n '\"'25,85p' \\\"\"'$DEV/engine/web/index.html\"; sed -n '\"'120,200p' \\\"\"'$DEV/web/game.js\"; cat \"$DEV/engine/crates/pav_core/src/games/fit.rs\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc \"DEV='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; rg -ni '</script' \\\"\"'$DEV/web/game.js\" \"$DEV/hub/session.js\" || true; sed -n '\"'25,85p' \\\"\"'$DEV/engine/web/index.html\"; sed -n '\"'120,200p' \\\"\"'$DEV/web/game.js\"; cat \"$DEV/engine/crates/pav_core/src/games/fit.rs\"'","aggregated_output":"  /* Phones held upright: a hint to turn sideways that fades by itself. */\n  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\n          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\n          pointer-events: none; animation: fade 1s 5s forwards; }\n  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\n  @keyframes fade { to { opacity: 0; } }\n</style>\n</head>\n<body>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading Shardfall…</div>\n<div id=\"turn\">Turn your phone sideways for the best view</div>\n<script type=\"module\">\n  // Start in a demo room with ?room=NAME, or the pavilion with ?scene=world.\n  // Messages name the game by the page title (a single-file build may retitle it).\n  const name = document.title;\n  const msg = document.getElementById('msg');\n  if (!navigator.gpu) {\n    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\n      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\n  } else {\n    // The game hides this message once its canvas exists, and takes keyboard focus.\n    new MutationObserver((_, obs) => {\n      const c = document.querySelector('canvas');\n      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\n    }).observe(document.body, { childList: true });\n    // Phones and tablets: the first tap goes full screen and turns sideways, where the browser\n    // allows it (Android; an iPhone keeps its bars, or plays full screen from the home screen).\n    if (matchMedia('(pointer: coarse)').matches) {\n      addEventListener('pointerup', () => {\n        const el = document.documentElement;\n        if (!document.fullscreenElement && el.requestFullscreen) {\n          el.requestFullscreen({ navigationUI: 'hide' })\n            .then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape'))\n            .catch(() => {});\n        }\n      }, { once: true, capture: true });\n    }\n    try {\n      // The game is shardfall.js and its .wasm beside this page. A single-file build\n      // (scripts/pack_single_html.py) carries both inside the page and sets window.loadGame.\n      if (window.loadGame) await window.loadGame();\n      else await (await import('./shardfall.js')).default();\n    } catch (error) {\n      console.error(`${name} failed to load:`, error);\n      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\n      document.body.append(msg);\n    }\n  }\n</script>\n</body>\n</html>\n    if (glyphInput) glyphInput.addEventListener('change', event=>{ settings.glyph=event.target.value; save(); render(); });\n    const nameInput=document.getElementById('guest-name');\n    if (nameInput) nameInput.addEventListener('change', event=>{ state.setup.name=event.target.value; });\n    for (const kind of ['stiffness','damping']) { const input=document.getElementById('dev-'+kind); if(input) input.addEventListener('input', event=>{state[kind]=Number(event.target.value);}); }\n  }\n\n  function isTouchOnly() { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; }\n  function newProfile() { return {name:state.setup.name,skin:state.setup.skin,outfit:state.setup.outfit,day:1,dayMinutes:0,minutesTotal:0,stars:0,age:null,checked:false,finaleDone:false,freePlay:false,bests:{},lastDate:new Date().toISOString().slice(0,10)}; }\n  function setScreen(screen) { state.screen=screen; render(); }\n  function selectAction(action) {\n    if (!action) return;\n    sound(520,.05);\n    if (action === 'title') { state.paused=false; state.together=null; state.round=null; setScreen('title'); }\n    else if (action === 'slots-new' || action === 'slots-continue') { state.slotMode=action==='slots-new'?'new':'continue'; setScreen('slots'); }\n    else if (action.startsWith('slot:')) { const index=Number(action.slice(5)), guest=(saved.slots||[])[index]; state.slot=index; if (guest) { state.profile=guest; setScreen('island'); } else { state.setup={name:names[index],skin:index%skins.length,outfit:index%outfits.length}; setScreen('customize'); } }\n    else if (action.startsWith('skin:')) { state.setup.skin=Number(action.slice(5)); render(); }\n    else if (action.startsWith('outfit:')) { state.setup.outfit=Number(action.slice(7)); render(); }\n    else if (action==='create-guest') { state.profile=newProfile(); save(); voice(); setScreen('intro'); }\n    else if (action==='island') { if (state.profile) {state.paused=false;setScreen('island');} else setScreen('title'); }\n    else if (action==='calendar') setScreen('calendar');\n    else if (action==='check') { voice(); setScreen('checkIntro'); }\n    else if (action==='begin-check') startCheck();\n    else if (action.startsWith('intro:')) { state.eventId=action.slice(6); voice(); setScreen('eventIntro'); }\n    else if (action==='cancel-event') setScreen(state.together?'handoff':'island');\n    else if (action==='begin-event') startRound(state.eventId);\n    else if (action==='pause') { state.paused=true; render(); }\n    else if (action==='resume') { state.paused=false; render(); }\n    else if (action==='reset-tuning') { state.stiffness=40; state.damping=8.5; render(); }\n    else if (action==='leave-event') { state.paused=false; if (state.together && state.together.online) reportHub(); else setScreen(state.together?'handoff':'island'); }\n    else if (action==='result-next') advanceResult();\n    else if (action==='end-day') setScreen('endDay');\n    else if (action==='sleep') { if (state.profile.day===5) setScreen('ending'); else { state.profile.day++; state.profile.dayMinutes=0; state.profile.checked=false; state.profile.lastDate=new Date().toISOString().slice(0,10); save(); setScreen('island'); } }\n    else if (action==='free-play') { state.profile.freePlay=true; save(); setScreen('island'); }\n    else if (action==='together') { state.together=null; setScreen('together'); }\n    else if (action.startsWith('hotseat:')) { state.together={count:Number(action.slice(8)),player:0,event:0,scores:[0,0,0,0],online:false,ghosts:{}}; setScreen('handoff'); }\n    else if (action==='hotseat-next') { state.eventId=medley[state.together.event]; setScreen('eventIntro'); }\n    else if (action==='settings') { state.returnScreen=state.screen; setScreen('settings'); }\n    else if (action==='settings-back') setScreen(state.returnScreen || 'title');\n    else if (action==='about') setScreen('about');\n    else if (action==='hub-ready') { if(hub) hub.ready(); state.message='Ready! Waiting for the other guests.'; render(); }\n  }\n\n  function startCheck() { center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; state.paused=false; state.round={name:'Morning Wobble Check',place:'Stillness Studio',instruction:'Stand still. This is the whole test.',controls:'Keep the dot near the center.',length:37,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,targets:0,phase:0,steps:0,lastStep:'',metric:[0,0,0,0],phaseSamples:[0,0,0,0]}; setScreen('check'); }\n  function startRound(id) { const item=eventById(id); if(!item) return; center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; lastHubUpdate=0; state.paused=false; state.round={...item,instruction:item.controls,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,steps:0,lastStep:'',shellX:0,shellY:0,shellVx:0,shellVy:0,potted:0,spin:0,prevAngle:0,gates:0,gateIndex:-1,stillBroken:false,ghostTrail:[]}; setScreen('event'); }\n  function triggerAction(side='action') {\n    if (!state.round || !['event','check'].includes(state.screen) || state.paused) return;\n    const round=state.round, time=round.elapsed;\n    if (round.id==='finale' && time>60) round.stillBroken=true;\n    round.actionCount++;\n    if (side==='left' || side==='right') { if (round.lastStep!==side) {round.steps++; round.lastStep=side;} }\n    if (round.id==='squat' || round.id==='step' || round.id==='lap' || round.id==='dive' || state.screen==='check') {\n      const interval=round.id==='dive'?1.2:round.id==='step'?.625:.6;\n      const phase=time%interval; if(Math.min(phase,interval-phase)<.22) round.actionHits++;\n      sound(round.id==='dive'?240:420,.09,'sine',.045);\n    } else sound(360,.06,'sine',.03);\n  }\n  function finishCheck() {\n    const round=state.round;\n    const metric=round.metric.map((value,index)=>round.phaseSamples[index] ? value/round.phaseSamples[index] : 0);\n    metric[3]=clamp(round.steps/8,0,1)*.6 + clamp(round.actionHits/8,0,1)*.4;\n    const skill=.30*metric[0]+.25*metric[1]+.25*metric[2]+.20*metric[3];\n    const age=Math.round(clamp(24+56*Math.pow(1-clamp(skill,0,1),1.1)-2*(profileDay()-1)-Math.min((state.profile.stars||0)/3,8),18,99));\n    state.profile.checked=true; state.profile.age=age; save();\n    state.result={isCheck:true,age,stars:skill>.8?3:skill>.5?2:1,comment:'A number! We can put it on a postcard. The important part is that you showed up.'}; voice(); setScreen('result');\n  }\n  function finishRound() {\n    const round=state.round; let score=Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000);\n    if (round.id==='tide') score=Math.round(clamp(round.potted*200+score*.4,0,1000));\n    if (round.id==='paddle') score=Math.round(clamp(round.gates*125+score*.3,0,1000));\n    if (round.id==='dive') score=Math.round(clamp(score*.5+Math.min(round.actionHits,8)*65,0,1000));\n    if (round.id==='finale' && !round.stillBroken) score=Math.min(1000,score+100);\n    const stars=score>=850?3:score>=650?2:score>=400?1:0;\n    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\n    else if (state.profile) { const guest=state.profile; guest.dayMinutes=(guest.dayMinutes||0)+2; guest.minutesTotal=(guest.minutesTotal||0)+2; guest.stars=(guest.stars||0)+stars; guest.bests[round.id]=Math.max(guest.bests[round.id]||0,score); if(round.id==='finale') {guest.finaleDone=true;guest.age=Math.max(18,Math.round((guest.age||60)-score/100));} save(); }\n    state.result={isCheck:false,name:round.name,score,stars,comment:`${titles[Math.min(titles.length-1,Math.floor(score/1000*titles.length))]}. We’ve banked ${state.together?'your points':'two minutes in the clam'}.`}; sound(660,.25,'sine'); voice(); setScreen('result');\n  }\n  function advanceResult() {\n    if(!state.together) {setScreen('island');return;}\n    const group=state.together; group.event++;\n    if(group.online) { if(group.event>=3) reportHub(); else {state.eventId=medley[group.event];startRound(state.eventId);} return; }\n    if(group.event>=3) {group.event=0;group.player++;}\nuse anyhow::{Result, anyhow};\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::{Game, GameBox};\nuse crate::input::InputFrame;\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\n\nconst LEVEL: &str = include_str!(\"fit.toml\");\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct FitGame {\n    pub center: Vec2,\n    pub velocity: Vec2,\n    pub elapsed: f32,\n    pub stable: f32,\n}\n\nimpl Default for FitGame {\n    fn default() -> Self {\n        Self { center: Vec2::ZERO, velocity: Vec2::ZERO, elapsed: 0.0, stable: 0.0 }\n    }\n}\n\nimpl FitGame {\n    pub fn advance(&mut self, lean: Vec2, dt: f32) {\n        self.elapsed += dt;\n        let wobble = Vec2::new((self.elapsed * 1.7).sin(), (self.elapsed * 1.3).cos()) * 0.12;\n        let target = lean.clamp_length_max(1.0) * 0.92 + wobble;\n        let acceleration = (target - self.center) * 40.0 - self.velocity * 8.5;\n        self.velocity += acceleration * dt;\n        self.center += self.velocity * dt;\n        if self.center.length() < 0.32 {\n            self.stable += dt;\n        }\n    }\n}\n\npub fn build(sim: &mut Sim, _rest: Option<&str>) -> Result<()> {\n    let def = RoomDef::parse(&super::level_text(FitGame::KEY, LEVEL)).map_err(|error| anyhow!(\"fit.toml: {error}\"))?;\n    crate::scenes::build_standalone_room(sim, FitGame::KEY, def);\n    sim.state.play = Some(GameBox::new(FitGame::default()));\n    Ok(())\n}\n\nimpl Game for FitGame {\n    const KEY: &'static str = \"fit\";\n\n    fn pre(&mut self, _sim: &mut Sim, input: &InputFrame, dt: f32, _events: &mut Vec<crate::frame::SimEvent>) -> std::collections::BTreeMap<crate::entity::EntityId, InputFrame> {\n        self.advance(input.move_dir, dt);\n        std::collections::BTreeMap::new()\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        json!({ \"center\": [self.center.x, self.center.y], \"elapsed\": self.elapsed, \"stable\": self.stable })\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn balance_stays_finite_and_follows_input() {\n        let mut game = FitGame::default();\n        for _ in 0..120 {\n            game.advance(Vec2::X, 1.0 / 60.0);\n        }\n        assert!(game.center.x > 0.7 && game.center.x < 1.1);\n        assert!(game.center.is_finite());\n    }\n\n    #[test]\n    fn center_resting_is_stable() {\n        let mut game = FitGame::default();\n        for _ in 0..120 {\n            game.advance(Vec2::ZERO, 1.0 / 60.0);\n        }\n        assert!(game.stable > 1.9);\n    }\n}\n","exit_code":0,"status":"completed"}}
