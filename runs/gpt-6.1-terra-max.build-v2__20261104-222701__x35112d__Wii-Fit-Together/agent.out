crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:25:/// See [Google Fonts](https://fonts.google.com/noto/specimen/Noto+Emoji) for\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:27:pub const NOTO_EMOJI_REGULAR: &[u8] = include_bytes!(\"../fonts/NotoEmoji-Regular.ttf\");\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:29:/// A typeface designed for use by Ubuntu.\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:31:/// The Ubuntu typeface has been specially created to complement the Ubuntu tone\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:33:/// the Ubuntu brand that convey a precise, reliable and free attitude.\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:35:/// See [Ubuntu design](https://design.ubuntu.com/font) for more information.\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:36:pub const UBUNTU_LIGHT: &[u8] = include_bytes!(\"../fonts/Ubuntu-Light.ttf\");\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:40:/// for icon fonts.\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:42:/// The icons in this font are designed to be styled with minimal effort. Each\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:45:/// See [the `emoji-icon-font` repository](https://github.com/jslegers/emoji-icon-font)\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/src/lib.rs:47:pub const EMOJI_ICON: &[u8] = include_bytes!(\"../fonts/emoji-icon-font.ttf\");\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/README.md:1:# `epaint_default_fonts` -  fonts for epaint and egui\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/README.md:3:[![Latest version](https://img.shields.io/crates/v/epaint_default_fonts.svg)](https://crates.io/crates/epaint_default_fonts)\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/README.md:4:[![Documentation](https://docs.rs/epaint_default_fonts/badge.svg)](https://docs.rs/epaint_default_fonts)\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/README.md:6:![MIT](https://img.shields.io/badge/license-MIT-blue.svg)\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/README.md:7:![Apache](https://img.shields.io/badge/license-Apache-blue.svg)\n/home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/README.md:9:Default fonts that are used in `epaint` and `egui`. Not intended for use as a standalone library.\n","exit_code":0,"status":"completed"}}
