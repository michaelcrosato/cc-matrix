agName))moveFocus(key==='arrowup'||key==='arrowleft'?-1:1);else if(key==='enter'&&document.activeElement===document.body)app.querySelector('button:not([disabled])')?.click();}\n@@\n-  window.addEventListener('blur',()=>keys.clear());\n+  window.addEventListener('blur',()=>{keys.clear();mouseHeld=false;});\n@@\n-  window.addEventListener('pointerdown',event=>{if(event.target.closest('button,input,select,details,summary'))return;if(event.pointerType==='mouse'&&['event','check'].includes(state.screen))triggerAction();});\n+  window.addEventListener('pointerdown',event=>{if(event.target.closest('button,input,select,details,summary'))return;if(event.pointerType==='mouse'&&['event','check'].includes(state.screen)){mouseHeld=true;triggerAction();}});\n+  window.addEventListener('pointerup',()=>{mouseHeld=false;});\n@@\n   window.__gameStatus=()=>JSON.stringify({scene:state.screen,guest:profileName(),day:state.profile?.day||0,checked:\"'!!state.profile?.checked,minutes:state.profile?.dayMinutes||0,age:state.profile?.age??null,event:state.round?.id||null,elapsed:state.round?.elapsed||0,paused:state.paused,together:state.together?{player:state.together.player,event:state.together.event,scores:state.together.scores}:null});\n+  if (new URLSearchParams(location.search).has('\"'test')) window.__testAdvance=seconds=>{for(let elapsed=0;elapsed<seconds&&['event','check'].includes(state.screen);elapsed+=.025){updateInput(.025);tickRound(.025);}};\n*** End Patch\nPATCH\nnode --check 'Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js'\nls 'Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/scripts'; sed -n '1,100p' 'Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/scripts/build-web.sh' | head -60\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
