height:84%}.puck:after{top:50%;left:8%;height:1px;width:84%}.puck .target{position:absolute;left:50%;top:50%;width:24%;height:24%;transform:translate(-50%,-50%);border:2px dashed #fff9;border-radius:50%}.puck .dot{position:absolute;left:50%;top:50%;width:15%;height:15%;border-radius:50%;background:#ffe378;border:3px solid white;box-shadow:0 2px 6px #124b4d66;transform:translate(-50%,-50%)}.event-bottom{position:absolute;bottom:clamp(18px,3vw,40px);left:clamp(18px,3.2vw,54px);display:flex;gap:10px;align-items:center;flex-wrap:wrap}.meter{height:12px;border-radius:99px;background:#d9e8dd;overflow:hidden}.meter>span{display:block;height:100%;border-radius:inherit;background:#ff9478;transition:width .2s}.big-score{font-size:clamp(64px,9vw,110px);font-weight:1000;line-height:.9;letter-spacing:-.07em;color:var(--teal);margin:15px 0}.stars{color:#f6b94d;font-size:34px;letter-spacing:6px}.dialogue{border-left:5px solid #8adbd1;padding-left:16px;font-size:clamp(17px,1.7vw,22px);line-height:1.35;font-weight:800}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-grid div{padding:12px;background:#f2f8ee;border-radius:12px;overflow-wrap:anywhere;font-size:13px;line-height:1.4}.info-grid b{display:block;text-transform:uppercase;font-size:10px;letter-spacing:.1em;color:#498279}.about-list{font-size:13px;line-height:1.5;color:#50716d}.touch-guard{position:fixed;z-index:10;inset:0;background:#cff0e9ed;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}.touch-guard>div{max-width:440px}.touch-guard h2{font-size:clamp(28px,7vw,44px);line-height:1;margin:16px 0}.touch-guard .button{text-align:center}.touch-guard.settings-open{display:none}.attract-label{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);font-weight:1000;color:white;text-align:center;text-shadow:0 2px 7px #226}.hidden{display:none!important}\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css-4-@media(max-width:700px){.