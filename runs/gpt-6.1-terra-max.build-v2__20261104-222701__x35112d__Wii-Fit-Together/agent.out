creen('event'); if(state.together?.online && hub) hub.progress({score:state.together.scores[0],label:`${item.name}: starting`}); }\n166-  function triggerAction(side='action') {\n167-    if (!state.round || !['event','check'].includes(state.screen) || state.paused) return;\n168-    const round=state.round, time=round.elapsed;\n169-    if (round.id==='finale' && time>60) round.stillBroken=true;\n170-    round.actionCount++;\n171-    if (side==='left' || side==='right') { if (round.lastStep!==side) {round.steps++; round.lastStep=side;} }\n172-    if (round.id==='squat' || round.id==='step' || round.id==='lap' || round.id==='dive' || state.screen==='check') {\n173-      const interval=round.id==='dive'?1.2:round.id==='step'?.625:.6;\n174-      const phase=time%interval; if(Math.min(phase,interval-phase)<.22) round.actionHits++;\n175-      sound(round.id==='dive'?240:420,.09,'sine',.045);\n176-    } else sound(360,.06,'sine',.03);\n177-  }\n178-  function finishCheck() {\n179-    const round=state.round;\n180-    const metric=round.metric.map((value,index)=>round.phaseSamples[index] ? value/round.phaseSamples[index] : 0);\n181-    metric[3]=clamp(round.steps/8,0,1)*.6 + clamp(round.actionHits/8,0,1)*.4;\n182-    const skill=.30*metric[0]+.25*metric[1]+.25*metric[2]+.20*metric[3];\n183-    const age=Math.round(clamp(24+56*Math.pow(1-clamp(skill,0,1),1.1)-2*(profileDay()-1)-Math.min((state.profile.stars||0)/3,8),18,99));\n184-    state.profile.checked=true; state.profile.age=age; save();\n185-    state.result={isCheck:true,age,stars:skill>.8?3:skill>.5?2:1,comment:'A number! We can put it on a postcard. The important part is that you showed up.'}; voice(); setScreen('result');\n186-  }\n187-  function finishRound() {\n188-    const round=state.round; let score=Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000);\n189-    if (round.id==='tide') score=Math.round(clamp(round.potted*200+score*.4,0,1000));\n190-    if (round.id==='paddle') score=Math.round(clamp(round.gates*125+score*.3,0,1000));\n191-    if (round.id==='dive') score=Math.round(clamp(score*.5+Math.min(round.actionHits,8)*65,0,1000));\n192-    if (round.id==='finale' && !round.stillBroken) score=Math.min(1000,score+100);\n193-    const stars=score>=850?3:score>=650?2:score>=400?1:0;\n194-    let banked=0;\n--\n220-    const speed=keys.has('shift')?.5:1;\n221-    if(x||y) { aim.x=clamp(aim.x+x*1.6*dt*speed,-1,1); aim.y=clamp(aim.y+y*1.6*dt*speed,-1,1); }\n222-    else if(mouseAim && state.device==='mouse') { aim.x=mouseAim.x;aim.y=mouseAim.y; }\n#!/usr/bin/env bash\nset -euo pipefail\nexport PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64\nexec python3 \"$(dirname \"$0\")/test_game.py\" \"${1:-all}\"\n","exit_code":0,"status":"completed"}}
