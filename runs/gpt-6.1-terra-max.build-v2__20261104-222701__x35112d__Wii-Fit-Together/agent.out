{"type":"item.started","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -lc \"D='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '120,245p' \\\"\"'$D/web/game.js\" | fold -w 200 | head -180; printf '\"'\\\\n--- INPUT ---\\\\n'; sed -n '245,320p' \\\"\"'$D/web/game.js\" | fold -w 200 | head -160; printf '\"'\\\\n--- ABOUT ---\\\\n'; rg -n -o '.{0,130}__aboutData.{0,350}' \\\"\"'$D/web/game.js\"; printf '\"'\\\\n--- scripts directory ---\\\\n'; ls -l \\\"\"'$D/scripts\" \"$D/tests\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -lc \"D='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '120,245p' \\\"\"'$D/web/game.js\" | fold -w 200 | head -180; printf '\"'\\\\n--- INPUT ---\\\\n'; sed -n '245,320p' \\\"\"'$D/web/game.js\" | fold -w 200 | head -160; printf '\"'\\\\n--- ABOUT ---\\\\n'; rg -n -o '.{0,130}__aboutData.{0,350}' \\\"\"'$D/web/game.js\"; printf '\"'\\\\n--- scripts directory ---\\\\n'; ls -l \\\"\"'$D/scripts\" \"$D/tests\"'","aggregated_output":"    if (glyphInput) glyphInput.addEventListener('change', event=>{ settings.glyph=event.target.value; save(); render(); });\n    const nameInput=document.getElementById('guest-name');\n    if (nameInput) nameInput.addEventListener('change', event=>{ state.setup.name=event.target.value; });\n    for (const kind of ['stiffness','damping']) { const input=document.getElementById('dev-'+kind); if(input) input.addEventListener('input', event=>{state[kind]=Number(event.target.value);}); }\n  }\n\n  function isTouchOnly() { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; }\n  function newProfile() { return {name:state.setup.name,skin:state.setup.skin,outfit:state.setup.outfit,day:1,dayMinutes:0,minutesTotal:0,stars:0,age:null,checked:false,finaleDone:false,freePlay:false\n,bests:{},lastDate:new Date().toISOString().slice(0,10)}; }\n  function setScreen(screen) { state.screen=screen; render(); }\n  function selectAction(action) {\n    if (!action) return;\n    sound(520,.05);\n    if (action === 'title') { state.paused=false; state.together=null; state.round=null; setScreen('title'); }\n    else if (action === 'slots-new' || action === 'slots-continue') { state.slotMode=action==='slots-new'?'new':'continue'; setScreen('slots'); }\n    else if (action.startsWith('slot:')) { const index=Number(action.slice(5)), guest=(saved.slots||[])[index]; state.slot=index; if (guest) { state.profile=guest; setScreen('island'); } else { state.\nsetup={name:names[index],skin:index%skins.length,outfit:index%outfits.length}; setScreen('customize'); } }\n    else if (action.startsWith('skin:')) { state.setup.skin=Number(action.slice(5)); render(); }\n    else if (action.startsWith('outfit:')) { state.setup.outfit=Number(action.slice(7)); render(); }\n    else if (action==='create-guest') { state.profile=newProfile(); save(); voice(); setScreen('intro'); }\n    else if (action==='island') { if (state.profile) {state.paused=false;setScreen('island');} else setScreen('title'); }\n    else if (action==='calendar') setScreen('calendar');\n    else if (action==='check') { voice(); setScreen('checkIntro'); }\n    else if (action==='begin-check') startCheck();\n    else if (action.startsWith('intro:')) { state.eventId=action.slice(6); voice(); setScreen('eventIntro'); }\n    else if (action==='cancel-event') setScreen(state.together?'handoff':'island');\n    else if (action==='begin-event') startRound(state.eventId);\n    else if (action==='pause') { state.paused=true; render(); }\n    else if (action==='resume') { state.paused=false; render(); }\n    else if (action==='reset-tuning') { state.stiffness=40; state.damping=8.5; render(); }\n    else if (action==='leave-event') { state.paused=false; if (state.together && state.together.online) reportHub(); else setScreen(state.together?'handoff':'island'); }\n    else if (action==='result-next') advanceResult();\n    else if (action==='end-day') setScreen('endDay');\n    else if (action==='sleep') { if (state.profile.day===5) setScreen('ending'); else { state.profile.day++; state.profile.dayMinutes=0; state.profile.checked=false; state.profile.lastDate=new Date().\ntoISOString().slice(0,10); save(); setScreen('island'); } }\n    else if (action==='free-play') { state.profile.freePlay=true; save(); setScreen('island'); }\n    else if (action==='together') { state.together=null; setScreen('together'); }\n    else if (action.startsWith('hotseat:')) { state.together={count:Number(action.slice(8)),player:0,event:0,scores:[0,0,0,0],online:false,ghosts:{}}; setScreen('handoff'); }\n    else if (action==='hotseat-next') { state.eventId=medley[state.together.event]; setScreen('eventIntro'); }\n    else if (action==='settings') { state.returnScreen=state.screen; setScreen('settings'); }\n    else if (action==='settings-back') setScreen(state.returnScreen || 'title');\n    else if (action==='about') setScreen('about');\n    else if (action==='hub-ready') { if(hub) hub.ready(); state.message='Ready! Waiting for the other guests.'; render(); }\n  }\n\n  function startCheck() { center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; state.paused=false; state.round={name:'Morning Wobble Check',place:'Stillness Studio',instruction:'Stand still. This is the whole t\nest.',controls:'Keep the dot near the center.',length:37,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,targets:0,phase:0,steps:0,lastStep:'',metric:[0,0,0,0],phaseSamples:[0,0,0,0]}; setScreen(\n'check'); }\n  function startRound(id) { const item=eventById(id); if(!item) return; center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; state.paused=false; state.round={...item,instruction:item.controls,elapsed:0,sum:0,sa\nmples:0,actionHits:0,actionCount:0,steps:0,lastStep:'',shellX:0,shellY:0,shellVx:0,shellVy:0,potted:0,spin:0,prevAngle:0,gates:0,gateIndex:-1,stillBroken:false,ghostTrail:[]}; setScreen('event'); }\n  function triggerAction(side='action') {\n    if (!state.round || !['event','check'].includes(state.screen) || state.paused) return;\n    const round=state.round, time=round.elapsed;\n    if (round.id==='finale' && time>60) round.stillBroken=true;\n    round.actionCount++;\n    if (side==='left' || side==='right') { if (round.lastStep!==side) {round.steps++; round.lastStep=side;} }\n    if (round.id==='squat' || round.id==='step' || round.id==='lap' || round.id==='dive' || state.screen==='check') {\n      const interval=round.id==='dive'?1.2:round.id==='step'?.625:.6;\n      const phase=time%interval; if(Math.min(phase,interval-phase)<.22) round.actionHits++;\n      sound(round.id==='dive'?240:420,.09,'sine',.045);\n    } else sound(360,.06,'sine',.03);\n  }\n  function finishCheck() {\n    const round=state.round;\n    const metric=round.metric.map((value,index)=>round.phaseSamples[index] ? value/round.phaseSamples[index] : 0);\n    metric[3]=clamp(round.steps/8,0,1)*.6 + clamp(round.actionHits/8,0,1)*.4;\n    const skill=.30*metric[0]+.25*metric[1]+.25*metric[2]+.20*metric[3];\n    const age=Math.round(clamp(24+56*Math.pow(1-clamp(skill,0,1),1.1)-2*(profileDay()-1)-Math.min((state.profile.stars||0)/3,8),18,99));\n    state.profile.checked=true; state.profile.age=age; save();\n    state.result={isCheck:true,age,stars:skill>.8?3:skill>.5?2:1,comment:'A number! We can put it on a postcard. The important part is that you showed up.'}; voice(); setScreen('result');\n  }\n  function finishRound() {\n    const round=state.round; let score=Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000);\n    if (round.id==='tide') score=Math.round(clamp(round.potted*200+score*.4,0,1000));\n    if (round.id==='paddle') score=Math.round(clamp(round.gates*125+score*.3,0,1000));\n    if (round.id==='dive') score=Math.round(clamp(score*.5+Math.min(round.actionHits,8)*65,0,1000));\n    if (round.id==='finale' && !round.stillBroken) score=Math.min(1000,score+100);\n    const stars=score>=800?3:score>=500?2:1;\n    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\n    else if (state.profile) { const guest=state.profile; guest.dayMinutes=(guest.dayMinutes||0)+2; guest.minutesTotal=(guest.minutesTotal||0)+2; guest.stars=(guest.stars||0)+stars; guest.bests[round.i\nd]=Math.max(guest.bests[round.id]||0,score); if(round.id==='finale') {guest.finaleDone=true;guest.age=Math.max(18,Math.round((guest.age||60)-score/100));} save(); }\n    state.result={isCheck:false,name:round.name,score,stars,comment:`${titles[Math.min(titles.length-1,Math.floor(score/1000*titles.length))]}. We’ve banked ${state.together?'your points':'two minutes\n in the clam'}.`}; sound(660,.25,'sine'); voice(); setScreen('result');\n  }\n  function advanceResult() {\n    if(!state.together) {setScreen('island');return;}\n    const group=state.together; group.event++;\n    if(group.online) { if(group.event>=3) reportHub(); else {state.eventId=medley[group.event];startRound(state.eventId);} return; }\n    if(group.event>=3) {group.event=0;group.player++;}\n    if(group.player>=group.count) setScreen('podium'); else setScreen('handoff');\n  }\n  function reportHub() { if(!state.together || !state.together.online) return; const score=clamp(Math.round(state.together.scores[0]),0,3000); if(hub && !state.together.reported) {state.together.repor\nted=true;hub.result({score,stats:{events:Math.min(3,state.together.event)},awards:[{name:'Island Enthusiast',description:'Completed the Tippy Cay medley.'}]});} state.message=`Medley complete: ${forma\ntScore(score)} points. Waiting for the group.`;setScreen('waiting'); }\n\n  function updateInput(dt) {\n    let x=(keys.has('arrowright')||keys.has('d')?1:0)-(keys.has('arrowleft')||keys.has('a')?1:0), y=(keys.has('arrowdown')||keys.has('s')?1:0)-(keys.has('arrowup')||keys.has('w')?1:0);\n    let gamepad=null; try { gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean); } catch (_) {}\n    if(gamepad) {\n      const dead=value=>Math.abs(value)<.12?0:Math.sign(value)*Math.pow((Math.abs(value)-.12)/.88,1.5);\n      const gx=dead(gamepad.axes[0]||0), gy=dead(gamepad.axes[1]||0); if(Math.abs(gx)+Math.abs(gy)>.03) {x=gx;y=gy;markInput('gamepad');state.hasHardwareInput=true;}\n      const pressed=gamepad.buttons.map(item=>item.pressed);\n      for(const index of [0,9,12,13,14,15]) if(pressed[index]&&!previousButtons[index]) { markInput('gamepad');state.hasHardwareInput=true; if(index===9){if(['event','check'].includes(state.screen)) s\nelectAction(state.paused?'resume':'pause');} else if(['event','check'].includes(state.screen)&&!state.paused) triggerAction(index===14?'left':index===15?'right':'action'); else if(index===0) { const f\nocused=document.activeElement; if(focused && focused.tagName==='BUTTON') focused.click(); else app.querySelector('button:not([disabled])')?.focus(); } else if([12,13,14,15].includes(index)) moveFocus(\nindex===12||index===14?-1:1); }\n      previousButtons=pressed;\n    }\n    const speed=keys.has('shift')?.5:1;\n    if(x||y) { aim.x=clamp(aim.x+x*1.6*dt*speed,-1,1); aim.y=clamp(aim.y+y*1.6*dt*speed,-1,1); }\n    else if(mouseAim && state.device==='mouse') { aim.x=mouseAim.x;aim.y=mouseAim.y; }\n    else {aim.x=smooth(aim.x,0,1.2,dt);aim.y=smooth(aim.y,0,1.2,dt);}\n    const round=state.round, time=round?.elapsed||0, wobble=.12;\n    const targetX=aim.x*.92+wobble*(Math.sin(time*2.13)*.6+Math.sin(time*3.71)*.4), targetY=aim.y*.92+wobble*(Math.sin(time*1.79)*.6+Math.sin(time*3.31)*.4);\n    const stiffness=state.stiffness||40, damping=state.damping||8.5;\n    center.vx+=((targetX-center.x)*stiffness-center.vx*damping)*dt;center.vy+=((targetY-center.y)*stiffness-center.vy*damping)*dt;\n    center.x=clamp(center.x+center.vx*dt,-1.2,1.2);center.y=clamp(center.y+center.vy*dt,-1.2,1.2);\n  }\n  function heldAction() { try { const gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);return keys.has(' ')||keys.has('enter')||!!gamepad?.buttons[0]?.pressed; } catch (_) { return keys\n.has(' '); } }\n  function tickRound(dt) {\n    const round=state.round; if(!round || state.paused || !['event','check'].includes(state.screen)) return;\n    round.elapsed+=dt; const time=round.elapsed;\n    let quality=clamp(1-Math.hypot(center.x,center.y)*.8,0,1), targetX=0,targetY=0, instruction=round.controls;\n    if(state.screen==='check') {\n      const phase=time<8?0:time<23?1:time<29?2:3;round.phase=phase;\n      if(phase===1) {targetX=[-.7,.7,-.7][Math.min(2,Math.floor((time-8)/5))];quality=clamp(1-Math.abs(center.x-targetX),0,1);instruction='Lean into the target ring.';}\n      else if(phase===2) instruction='Eyes closed. Trust the sound and find your center.';\n      else if(phase===3) instruction='Alternate left and right steps to the beat.';\n      else instruction='Stand still. This is the whole test.';\n      round.metric[phase]+=quality;round.phaseSamples[phase]++;\n    } else {\n      if(round.id==='breath') { const inhale=(time%8)<4;quality=(heldAction()===inhale)?1:.15;instruction=inhale?'Breathe in · hold Action':'Breathe out · release Action'; }\n      else if(round.id==='pose') { targetX=Math.sin(time*.58)*.55;targetY=Math.cos(time*.43)*.25;quality=clamp(1-Math.hypot(center.x-targetX,center.y-targetY),0,1);instruction='Follow the drifting rin\ng.'; }\n      else if(round.id==='squat') {quality=clamp(round.actionHits/Math.max(1,time/.6)*1.1,0,1)*.7+quality*.3;instruction='Press Action as the beat lands.';}\n      else if(round.id==='plank') { quality=quality*(heldAction()?1:.35);instruction='Hold Action. Be one with the plank.'; }\n      else if(round.id==='step'||round.id==='lap') {quality=clamp(round.steps/Math.max(1,time/.625),0,1)*.65+clamp(round.actionHits/Math.max(1,round.actionCount),0,1)*.35;instruction='Alternate Left a\nnd Right on the beat.';}\n      else if(round.id==='spin') {const angle=Math.atan2(center.y,center.x);let diff=angle-round.prevAngle;while(diff>Math.PI)diff-=Math.PI*2;while(diff<-Math.PI)diff+=Math.PI*2;round.prevAngle=angle;\nround.spin=smooth(round.spin,Math.abs(diff)/Math.max(dt,.001),3,dt);quality=clamp(round.spin/4,0,1)*(Math.hypot(center.x,center.y)>.25?1:.3);instruction='Circle your lean. Keep the floaties moving!';}\n      else if(round.id==='tide') {round.shellVx=(round.shellVx+center.x*dt*.9)*Math.exp(-1.6*dt);round.shellVy=(round.shellVy+center.y*dt*.9)*Math.exp(-1.6*dt);round.shellX=clamp(round.shellX+round.sh\nellVx*dt,-.9,.9);round.shellY=clamp(round.shellY+round.shellVy*dt,-.9,.9);targetX=Math.sin(round.potted*3)*.6;targetY=Math.cos(round.potted*2)*.55;if(Math.hypot(round.shellX-targetX,round.shellY-targe\ntY)<.16){round.potted++;round.shellX=0;round.shellY=0;sound(780,.12);}quality=clamp(1-Math.hypot(round.shellX-targetX,round.shellY-targetY)*.5,0,1);instruction=`Shells in pools: ${round.potted} · Tilt\n toward the pool.`;}\n      else if(round.id==='paddle') {targetX=Math.sin(Math.floor(time/4.5)*1.9)*.65;quality=clamp(1-Math.abs(center.x-targetX),0,1);const gate=Math.floor(time/4.5);if(gate!==round.gateIndex){round.gate\nIndex=gate;if(quality>.63)round.gates++;}instruction=`Gates cleared: ${round.gates} · Steer to the ring.`;}\n\n--- INPUT ---\n      else if(round.id==='paddle') {targetX=Math.sin(Math.floor(time/4.5)*1.9)*.65;quality=clamp(1-Math.abs(center.x-targetX),0,1);const gate=Math.floor(time/4.5);if(gate!==round.gateIndex){round.gate\nIndex=gate;if(quality>.63)round.gates++;}instruction=`Gates cleared: ${round.gates} · Steer to the ring.`;}\n      else if(round.id==='tray') {quality=clamp(quality-.08*Math.abs(Math.sin(time*1.7)),0,1);instruction='Keep the smoothies aboard.';}\n      else if(round.id==='dive') {quality=clamp(round.actionHits/Math.max(1,time/1.2)*1.5,0,1)*.7+(heldAction()?.3:0);instruction='Press at the bottom of the bounce; hold to tuck.';}\n      else if(round.id==='finale') {if(time<16){instruction=(time%8)<4?'Breathe in · hold Action':'Breathe out · release Action';quality=(heldAction()===((time%8)<4))?1:.2;}else if(time<36){targetX=Ma\nth.sin(time*.5)*.5;quality=clamp(1-Math.abs(center.x-targetX),0,1);instruction='Follow the pose through the breeze.';}else if(time<48){quality=clamp(round.steps/Math.max(1,(time-36)/.625),0,1);instruc\ntion='Step with the island marching band.';}else if(time<60){quality*=heldAction()?1:.3;instruction='Brace against the waves. Hold Action.';}else{instruction=time>75?'Press Action to skip? Or simply s\ntay.':'The Long Stillness. Do nothing.';quality=round.stillBroken?.2:1;}}\n      round.sum+=quality;round.samples++;\n    }\n    const dot=document.getElementById('dot'), target=document.getElementById('target');\n    if(dot){dot.style.transform=`translate(${center.x*43}px,${center.y*43}px)`;dot.style.opacity=state.screen==='check'&&round.phase===2?'0':'1';}\n    if(target){target.style.transform=`translate(${targetX*43}px,${targetY*43}px)`;target.style.opacity=state.screen==='check'&&round.phase===2?'0':'1';}\n    const timer=document.getElementById('timer'), subtitle=document.getElementById('round-subtitle'), phase=document.getElementById('phase-card'), score=document.getElementById('round-score'), fill=do\ncument.getElementById('meter-fill');\n    if(timer)timer.textContent=Math.max(0,Math.ceil(round.length-time))+'s';if(subtitle)subtitle.textContent=instruction;if(phase)phase.textContent=instruction;if(score)score.textContent=state.screen=\n=='check'?['STILL','LEAN','LISTEN','STEP'][round.phase]:formatScore(round.sum/Math.max(1,round.samples)*1000);if(fill)fill.style.width=clamp(time/round.length*100,0,100)+'%';\n    if(state.together?.online && hub && time-lastHubUpdate>.1){lastHubUpdate=time;hub.send({event:state.together.event,x:center.x,y:center.y,progress:time/round.length},{reliable:false});}\n    if(time>=round.length) { if(state.screen==='check')finishCheck();else finishRound(); }\n  }\n\n  function moveFocus(direction) { const items=Array.from(app.querySelectorAll('button:not([disabled]),select,input')).filter(item=>item.offsetParent!==null);if(!items.length)return;const index=items.i\nndexOf(document.activeElement);items[(index+direction+items.length)%items.length].focus(); }\n  app.addEventListener('click', event=>{const target=event.target.closest('[data-action]');if(target){markInput('mouse');selectAction(target.dataset.action);} });\n  window.addEventListener('keydown', event=>{const key=event.key.toLowerCase(); if(['arrowup','arrowdown','arrowleft','arrowright',' ','escape'].includes(key))event.preventDefault();if(!keys.has(key))\n{markInput('keyboard');state.hasHardwareInput=true;if(key==='escape'&&['event','check'].includes(state.screen)){selectAction(state.paused?'resume':'pause');}else if(['event','check'].includes(state.sc\nreen)&&!state.paused){if(key===' '||key==='enter')triggerAction();if(key==='arrowleft'||key==='a')triggerAction('left');if(key==='arrowright'||key==='d')triggerAction('right');}else if(['arrowup','arr\nowleft','arrowdown','arrowright'].includes(key)&&!['INPUT','SELECT'].includes(document.activeElement?.tagName))moveFocus(key==='arrowup'||key==='arrowleft'?-1:1);}\n    keys.add(key);\n  });\n  window.addEventListener('keyup',event=>keys.delete(event.key.toLowerCase()));\n  window.addEventListener('blur',()=>keys.clear());\n  window.addEventListener('pointermove',event=>{if(event.pointerType==='mouse'&&['event','check'].includes(state.screen)&&!state.paused){mouseAim={x:clamp((event.clientX-innerWidth/2)/(innerWidth*.35)\n,-1,1),y:clamp((event.clientY-innerHeight/2)/(innerHeight*.35),-1,1)};markInput('mouse');}});\n  window.addEventListener('pointerdown',event=>{if(event.target.closest('button,input,select,details,summary'))return;if(event.pointerType==='mouse'&&['event','check'].includes(state.screen))triggerAc\ntion();});\n\n  function resize() {const ratio=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(innerWidth*ratio);canvas.height=Math.round(innerHeight*ratio);viewport.width=canvas.width;viewport.height=canva\ns.height;viewport.scale=Math.max(canvas.width/1600,canvas.height/900);viewport.ox=(canvas.width-1600*viewport.scale)/2;viewport.oy=(canvas.height-900*viewport.scale)/2;}\n  window.addEventListener('resize',resize);resize();\n  function ellipse(x,y,rx,ry,color) {context.fillStyle=color;context.beginPath();context.ellipse(x,y,rx,ry,0,0,Math.PI*2);context.fill();}\n  function line(x1,y1,x2,y2,color,width=5) {context.strokeStyle=color;context.lineWidth=width;context.lineCap='round';context.beginPath();context.moveTo(x1,y1);context.lineTo(x2,y2);context.stroke();}\n  function palm(x,y,size,flip=1) {context.save();context.translate(x,y);context.scale(size*flip,size);line(0,0,12,-95,'#b87f5a',13);for(let index=0;index<5;index++){const angle=-2.9+index*.54;context.\nsave();context.translate(12,-95);context.rotate(angle);ellipse(42,0,48,11,index%2?'#61b58b':'#449e83');context.restore();}context.restore();}\n  function human(x,y,size,skin,outfit,lean=0,step=0) {context.save();context.translate(x,y);context.scale(size,size);ellipse(0,5,29,9,'#347c7060');line(-8,-10,-13+step*8,2,'#526e73',8);line(8,-10,13-s\ntep*8,2,'#526e73',8);context.rotate(lean*.23);context.fillStyle=outfit;context.beginPath();context.roundRect(-16,-56,32,48,13);context.fill();line(-13,-47,-24+lean*8,-20,skin,8);line(13,-47,24+lean*8,\n-20,skin,8);ellipse(0,-67,15,17,skin);ellipse(-5,-68,1.4,1.5,'#28494a');ellipse(5,-68,1.4,1.5,'#28494a');context.restore();}\n  function pip(x,y,size=1) {context.save();context.translate(x,y);context.scale(size,size);ellipse(0,4,38,9,'#337e7660');ellipse(0,-19,32,25,'#71cfd6');ellipse(0,-27,27,20,'#92e7e5');ellipse(-8,-28,2.\n5,3,'#295a5a');ellipse(8,-28,2.5,3,'#295a5a');line(-4,-19,4,-19,'#295a5a',2);context.restore();}\n  function hut(x,y,size,color) {context.save();context.translate(x,y);context.scale(size,size);ellipse(0,0,110,28,'#4e9d8e70');context.fillStyle='#fff5d7';context.fillRect(-62,-87,124,83);context.fill\nStyle=color;context.beginPath();context.moveTo(-88,-85);context.lineTo(0,-140);context.lineTo(88,-85);context.closePath();context.fill();context.fillStyle='#57a99f';context.fillRect(-15,-54,30,50);con\ntext.fillStyle='#b4e6dd';context.fillRect(-49,-67,23,21);context.fillRect(26,-67,23,21);context.restore();}\n  function drawWorld(now) {\n    const scale=viewport.scale;context.setTransform(scale,0,0,scale,viewport.ox,viewport.oy);context.clearRect(-500,-500,2600,1900);\n    const sky=context.createLinearGradient(0,0,0,600);sky.addColorStop(0,'#a7e9e5');sky.addColorStop(1,'#e6f8d8');context.fillStyle=sky;context.fillRect(-500,-500,2600,1250);\n    ellipse(1310,140,68,68,'#fff4b5');ellipse(1280,122,100,100,'#fff2b728');\n    for(let index=0;index<5;index++){const x=280+index*310+Math.sin(now*.00012+index)*18;ellipse(x,145+index%2*48,72,18,'#ffffffa8');ellipse(x-35,150+index%2*48,45,16,'#ffffffa8');}\n    context.fillStyle='#73cfd0';context.fillRect(-500,390,2600,1010);ellipse(260,409,300,58,'#9bdacc');ellipse(1210,420,380,72,'#89cfc3');\n    for(let index=0;index<12;index++){let x=(index*241+now*.012)%1900-150;line(x,475+(index%4)*77,x+50,475+(index%4)*77,'#d3f7e690',3);}\n    ellipse(910,715,660,235,'#55a99b');ellipse(900,682,650,215,'#efd69c');ellipse(895,664,614,188,'#f7e7b7');ellipse(890,615,520,133,'#bbdea5');\n    context.fillStyle='#deba82';context.beginPath();context.moveTo(620,645);context.lineTo(1020,645);context.lineTo(1150,820);context.lineTo(760,820);context.closePath();context.fill();\n    for(let index=0;index<8;index++)line(660+index*44,666,810+index*44,810,'#f4d09a',4);\n    hut(704,538,.83,'#ff987b');hut(1015,527,.95,'#78cfc2');hut(1230,570,.65,'#f6c46f');\n    palm(500,612,.95);palm(1320,630,1.1,-1);palm(1140,512,.55);palm(565,500,.5,-1);\n    const guest=state.profile||state.setup||{skin:0,outfit:0};\n    human(1070,750,1.2,skins[guest.skin||0],outfits[guest.outfit||0],center.x,Math.sin(now*.005));pip(1160,770,1.15);\n    human(725,586,.55,skins[3],outfits[4],0,0);human(940,583,.5,skins[1],outfits[2],0,0);\n    if(['event','check'].includes(state.screen)) {\n      context.fillStyle='#fff4d7ba';context.beginPath();context.roundRect(585,195,430,405,42);context.fill();\n      ellipse(800,547,185,48,'#91d5bf');ellipse(800,533,158,35,'#fbecc7');\n      const round=state.round; const act=heldAction();human(800,532,2.75,skins[guest.skin||0],outfits[guest.outfit||0],center.x,Math.sin(now*.008)*(round?.id==='step'?.8:.1));\n      if(round?.id==='breath'){const r=80+30*Math.sin(round.elapsed*Math.PI/4);context.strokeStyle='#ffb2a6';context.lineWidth=8;context.beginPath();context.arc(800,348,r,0,Math.PI*2);context.stroke()\n;}\n      if(round?.id==='tide'){ellipse(800+round.shellX*145,500+round.shellY*45,12,10,'#f58a73');ellipse(800+Math.sin(round.potted*3)*87,500+Math.cos(round.potted*2)*25,16,9,'#61b8c2');}\n      if(round?.id==='paddle'){context.strokeStyle='#ff9c72';context.lineWidth=10;context.beginPath();context.arc(800+Math.sin(Math.floor(round.elapsed/4.5)*1.9)*100,300,58,0,Math.PI*2);context.stroke\n();}\n      if(round?.id==='dive'&&act){for(let index=0;index<8;index++)ellipse(700+index*27,545-Math.abs(Math.sin(now*.005+index))*45,8,12,'#9be7e5');}\n      for(const [id,ghost] of Object.entries(state.together?.ghosts||{})) if(ghost.event===state.together.event){context.globalAlpha=.35;human(800+ghost.x*180,530,2.25,'#c3eee5','#78a3c5',ghost.x,0);c\nontext.globalAlpha=1;}\n    }\n  }\n  function frame(now) { const dt=Math.min((now-lastFrame)/1000,.05);lastFrame=now;if(!state.paused){updateInput(dt);tickRound(dt);}music(dt);if(state.screen==='title'&&!state.attract&&now-state.lastIn\nput>10000){state.attract=true;render();}drawWorld(now);requestAnimationFrame(frame); }\n  requestAnimationFrame(frame);\n\n  if (hub && hub.active) {\n    hub.on('start', data=>{state.together={count:state.hub?.players?.length||1,player:0,event:0,scores:[0,0,0,0],online:true,ghosts:{}};setTimeout(()=>startRound(medley[0]),Math.max(0,Number(data?.in)\n||0));});\n    hub.on('message',(data,from)=>{if(state.together?.online && data && Number.isFinite(data.x) && Number.isFinite(data.y))state.together.ghosts[from||'guest']=data;});\n    hub.on('time-up',()=>reportHub());hub.on('end',()=>{state.paused=true;state.message='The online session has ended.';setScreen('waiting');});\n    hub.connect({mode:'ghost',seats:[1,4]}).then(info=>{if(!info)return;state.hub=info;state.message='Connected! Getting the medley ready.';setScreen('waiting');if(info.splash)hub.ready();}).catch(()=\n>{state.message='Could not connect to AI Hub. Local play is still available.';setScreen('waiting');});\n    hub.probe(()=>({scene:state.screen,menu:{screen:state.screen},world:{event:state.round?.id,elapsed:state.round?.elapsed},input:{device:state.device}}));\n  }\n  window.__gameBoot={ready:true,title:'Wii Fit Together'};\n  window.__gameStatus=()=>JSON.stringify({scene:state.screen,guest:profileName(),day:state.profile?.day||0,checked:!!state.profile?.checked,minutes:state.profile?.dayMinutes||0,age:state.profile?.age?\n?null,event:state.round?.id||null,elapsed:state.round?.elapsed||0,paused:state.paused,together:state.together?{player:state.together.player,event:state.together.event,scores:state.together.scores}:nul\nl});\n  render();\n})();\n\n--- ABOUT ---\n108:      const info = window.__aboutData || {};\n\n--- scripts directory ---\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/scripts:\ntotal 0\n\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests:\ntotal 0\n","exit_code":0,"status":"completed"}}
