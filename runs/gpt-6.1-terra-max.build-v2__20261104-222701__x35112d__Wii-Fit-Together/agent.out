{"type":"item.started","item":{"id":"item_341","type":"command_execution","command":"/bin/bash -lc \"apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css\n@@\n-#app .activity small{display:block;margin-top:3px}#app .dayline{flex-wrap:wrap}#app .dayline span{height:auto;flex:0 0 auto;background:#edf6ec;color:#52747a;border-radius:999px;padding:6px 8px;font-size:10px;font-weight:900;white-space:nowrap}\n+.overlay{position:fixed;inset:0;z-index:12;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(23,63,72,.48);box-sizing:border-box}.overlay .panel{max-height:100%;overflow-y:auto}.overlay details{margin-top:20px}.overlay summary{cursor:pointer;font-weight:900}\n+#app .activity small{display:block;margin-top:3px}#app .dayline{flex-wrap:wrap}#app .dayline span{height:auto;flex:0 0 auto;background:#edf6ec;color:#52747a;border-radius:999px;padding:6px 8px;font-size:10px;font-weight:900;white-space:nowrap}\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js\n@@\n       previousButtons=pressed;\n     }\n+    if(state.paused && \"'!state.together?.online) return;\n@@\n-  function frame(now) { const realDt=Math.max(0,(now-lastFrame)/1000), dt=Math.min(realDt,.05);lastFrame=now;if(!state.paused || state.together?.online){updateInput(dt);tickRound(state.together?.online?realDt:dt*(state.timeScale ?? 1));}music(dt);if(state.screen==='\"'title'&&\"'!state.attract&&now-state.lastInput>10000){state.attract=true;render();}drawWorld(now);requestAnimationFrame(frame); }\n+  function frame(now) { const realDt=Math.max(0,(now-lastFrame)/1000), dt=Math.min(realDt,.05);lastFrame=now;updateInput(dt);if(!state.paused || state.together?.online)tickRound(state.together?.online?realDt:dt*(state.timeScale ?? 1));music(dt);if(state.screen==='\"'title'&&\"'!state.attract&&now-state.lastInput>10000){state.attract=true;render();}drawWorld(now);requestAnimationFrame(frame); }\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py\n@@\n     test(\"two-player local medley\", medley)\n+\n+    def tuning():\n+        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n+        new_guest(page)\n+        click(page, \"check\")\n+        click(page, \"begin-check\")\n+        click(page, \"pause\")\n+        before = status(page)[\"elapsed\"]\n+        page.wait_for_timeout(250)\n+        assert status(page)[\"elapsed\"] == before\n+        page.locator(\"summary\").click()\n+        page.screenshot(path=str(ARTIFACTS / \"pause-tuning.png\"))\n+        for kind, value in ((\"stiffness\", 55), (\"damping\", 10), (\"wobble\", .2), (\"timeScale\", 2)):\n+            page.locator(f\"#dev-{kind}\").evaluate(\"(element, value) => { element.value = value; element.dispatchEvent(new Event('\"'input', {bubbles:true})); }\\\", str(value))\n+        click(page, \\\"reset-tuning\\\")\n+        page.locator(\\\"summary\\\").click()\n+        for kind, value in ((\\\"stiffness\\\", 40), (\\\"damping\\\", 8.5), (\\\"wobble\\\", .12), (\\\"timeScale\\\", 1)):\n+            assert float(page.locator(f\\\"#dev-{kind}\\\").input_value()) == value\n+        click(page, \\\"give-minutes\\\")\n+        assert status(page)[\\\"minutes\\\"] == 5\n+        page.locator(\\\"summary\\\").click()\n+        click(page, \\\"finish-now\\\")\n+        assert status(page)[\\\"scene\\\"] == \\\"result\\\" and status(page)[\\\"checked\\\"]\n+        assert not errors, errors\n+        context.close()\n+\n+    test(\\\"offline pause and developer controls\\\", tuning)\n+\n+    def online_pause():\n+        context = browser.new_context(viewport={\\\"width\\\": 1280, \\\"height\\\": 800})\n+        context.add_init_script(\\\"\\\"\\\"window.AIHub={active:true,handlers:{},on(name,fn){this.handlers[name]=fn},connect(){return Promise.resolve({players:[{},{}],splash:true})},ready(){this.handlers.start({in:0})},progress(){},send(){},result(){},probe(){}};\\\"\\\"\\\")\n+        page = context.new_page()\n+        errors = []\n+        page.on(\\\"pageerror\\\", lambda error: errors.append(str(error)))\n+        page.goto(HTML.as_uri() + \\\"?test=1\\\", wait_until=\\\"domcontentloaded\\\")\n+        page.wait_for_function(\\\"window.__gameStatus && JSON.parse(window.__gameStatus()).scene === 'event'\\\")\n+        click(page, \\\"pause\\\")\n+        assert page.locator(\\\"summary\\\").count() == 0\n+        assert page.locator('[data-action=\\\"leave-event\\\"]').count() == 0\n+        before = status(page)[\\\"elapsed\\\"]\n+        page.wait_for_timeout(350)\n+        assert status(page)[\\\"elapsed\\\"] > before + .15\n+        click(page, \\\"settings\\\")\n+        before = status(page)[\\\"elapsed\\\"]\n+        page.wait_for_timeout(350)\n+        assert status(page)[\\\"elapsed\\\"] > before + .15\n+        click(page, \\\"settings-back\\\")\n+        assert status(page)[\\\"paused\\\"]\n+        click(page, \\\"resume\\\")\n+        advance(page)\n+        page.wait_for_function(\\\"JSON.parse(window.__gameStatus()).together.event === 1\\\", timeout=5000)\n+        assert status(page)[\\\"scene\\\"] == \\\"event\\\"\n+        assert not errors, errors\n+        context.close()\n+\n+    test(\\\"online pause and automatic medley progression\\\", online_pause)\n     browser.close()\n*** End Patch\nPATCH\n\ndev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; node --check \\\"\"'$dev/web/game.js\" && python3 \"$dev/scripts/bundle.py\" && \"$dev/tests/run.sh\" all'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
