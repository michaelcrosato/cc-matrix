    }\n\n    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {\n            self.on_touch(t, &event);\n            return;\n        }\n        let consumed = match (&mut self.egui_state, &self.gfx) {\n            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n            _ => false,\n        };\n        match event {\n            WindowEvent::CloseRequested => {\n                if let Some(host) = &self.host {\n                    host.exec(|sim| crate::save::save_from(sim));\n                }\n                self.look_ui.save_if_dirty(true);\n                el.exit()\n            }\n            WindowEvent::Focused(false) => {\n                self.input.clear();\n                self.touch.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    let system = matches!(\n                        code,\n                        KeyCode::Escape\n                            | KeyCode::F1\n                            | KeyCode::F2\n                            | KeyCode::F3\n                            | KeyCode::F4\n                            | KeyCode::F5\n                            | KeyCode::F6\n                            | KeyCode::F7\n                            | KeyCode::F8\n                            | KeyCode::F9\n                            | KeyCode::F10\n                            | KeyCode::F11\n                            | KeyCode::F12\n                    );\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/sim.rs:761:            if let Some(b) = st.statics.destroy(&mut st.physics, r) {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/destruct.rs:30:        let b = st.statics.destroy(&mut st.physics, r)?;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/destruct.rs:101:                    st.statics.destroy(&mut st.physics, c.block);\nfrom pathlib import Path\nimport json\n\n\ndev = Path(__file__).resolve().parent.parent\nroot = dev.parent\nhtml = (dev / \"game.raw.html\").read_text(encoding=\"utf-8\")\ncss = (dev / \"web/game.css\").read_text(encoding=\"utf-8\")\nhub = (dev / \"hub/session.js\").read_text(encoding=\"utf-8\")\ngame = (dev / \"web/game.js\").read_text(encoding=\"utf-8\")\nabout = json.loads((root / \"exit-interview.json\").read_text(encoding=\"utf-8\"))\n\nfor script in (hub, game):\n    if \"</script\" in script.lower():\n        raise ValueError(\"Inline script contains an HTML closing script tag\")\n\nabout_json = json.dumps(about, ensure_ascii=True).replace(\"</\", \"<\\\\/\")\nmetadata = '''<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Highest total across three balance events wins\">\n<meta name=\"hub:session-howto\" content=\"Lean: stick, WASD or mouse. Act: Cross, Space or click\">\n<meta name=\"hub:webgpu\" content=\"required\">'''\nhtml = html.replace(\"</head>\", f'<script>{hub}</script>{metadata}<script id=\"about-data\" type=\"application/json\">{about_json}</script><style>{css}\\n#msg,#turn{{display:none!important}}</style></head>', 1)\nbody_tag = \"\\n<body>\\n\"\nif html.count(body_tag) != 1:\n    raise ValueError(\"Could not