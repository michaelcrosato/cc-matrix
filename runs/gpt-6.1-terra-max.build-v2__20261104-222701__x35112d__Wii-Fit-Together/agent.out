{"type":"item.started","item":{"id":"item_161","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '70,165p' \\\"\"'$dev/hub/harness.html\"; sed -n '\"'360,440p' \\\"\"'$dev/hub/harness.html\"; sed -n '\"'80,150p' \\\"\"'$dev/web/game.js\"; cat PROGRESS.md; cat TASK.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_161","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '70,165p' \\\"\"'$dev/hub/harness.html\"; sed -n '\"'360,440p' \\\"\"'$dev/hub/harness.html\"; sed -n '\"'80,150p' \\\"\"'$dev/web/game.js\"; cat PROGRESS.md; cat TASK.md'","aggregated_output":"const params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n$('restart').onclick = () => newRound();\n$('release').onclick = () => releaseRound();\n$('timeup').onclick = () => current?.coordinator.timeUp();\n$('remove').onclick = () => {\n  const cell = current?.cells.find((c) => c.key === $('who').value);\n  if (cell) removeCell(cell);\n};\n$('hide').onclick = () => {\n  if (!current) return;\n  current.hidden = !current.hidden;\n  $('hide').setAttribute('aria-pressed', String(current.hidden));\n  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n};\nfor (const id of ['latency', 'jitter', 'loss']) $(id).onchange = applyNet;\n\n/* ---------------------------------------------------------------------------\n * ?auto=1 — the conformance run. It presses keys inside each frame with\n * synthetic events while the round plays (the frames must be served from this\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\n * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    } else if (state.screen === 'checkIntro') {\n      html = modal('Morning Wobble Check','PIP · RECEPTION CUSHION', `<div class=\"dialogue\"><p>“This is not a test of your worth. It is a test of whether the dot stays near the middle.”</p></div><p>Four little checks: stand still, lean toward targets, close your eyes, and alternate steps. Your Balance Age is a playful score, not medical advice.</p><div class=\"row\">${button('Back','island')}${button('Begin the check','begin-check','primary')}</div>`, 'island');\n    } else if (state.screen === 'event' || state.screen === 'check') {\n      const round=state.round;\n      html = shell(`<div class=\"hud\"><div><div class=\"eyebrow\">${esc(round.place.toUpperCase())}</div><h2 id=\"round-name\">${esc(round.name)}</h2><div id=\"round-subtitle\">${esc(round.instruction)}</div></div><div class=\"hud-right\"><div class=\"pill\" id=\"timer\">${Math.ceil(round.length)}s</div><button class=\"pill\" data-action=\"pause\">Ⅱ Pause</button></div></div><div class=\"event-center\"><div class=\"phase-card\" id=\"phase-card\">${esc(round.instruction)}</div></div><div class=\"event-bottom\"><div class=\"puck\" aria-label=\"Balance puck\"><div class=\"target\" id=\"target\"></div><div class=\"dot\" id=\"dot\"></div></div><div class=\"meter\"><div><strong id=\"round-score\">0</strong> <span id=\"score-label\">POINTS</span></div><div class=\"meter-track\"><div id=\"meter-fill\"></div></div><small id=\"round-help\">${esc(round.controls)}</small></div></div>`, state.together ? `PLAYER ${state.together.player+1} · MEDLEY` : 'FIND YOUR BALANCE');\n      if (state.paused) html += `<div class=\"overlay\"><section class=\"panel narrow\"><div class=\"eyebrow\">TAKE YOUR TIME</div><h2>Paused.</h2><p>The island isn’t going anywhere.</p><div class=\"row\">${button('Resume','resume','primary')}${button('Settings','settings')}${button('Leave activity','leave-event')}</div><details><summary>Developer tuning</summary><label class=\"field\">Spring stiffness<input id=\"dev-stiffness\" type=\"range\" min=\"10\" max=\"80\" value=\"${state.stiffness || 40}\"></label><label class=\"field\">Damping<input id=\"dev-damping\" type=\"range\" min=\"2\" max=\"20\" value=\"${state.damping || 8.5}\" step=\".5\"></label>${button('Reset tuning','reset-tuning')}</details></section></div>`;\n    } else if (state.screen === 'result') {\n      const result=state.result;\n      html = modal(result.isCheck ? `Balance Age: ${result.age}` : result.name, result.isCheck?'MORNING CHECK COMPLETE':'THAT WAS A GOOD WOBBLE', `<div class=\"big-score\">${result.isCheck ? esc(result.age) : formatScore(result.score)}<small>${result.isCheck?'PLAYFUL BALANCE AGE · NOT A HEALTH MEASURE':'POINTS'}</small></div><div class=\"stars\">${'★'.repeat(result.stars || 0)}${'☆'.repeat(3-(result.stars || 0))}</div><div class=\"dialogue\"><span class=\"speaker\">PIP SAYS</span><p>“${esc(result.comment)}”</p></div><div class=\"row\">${button(state.together?'Continue medley':'Back to the island','result-next','primary')}</div>`, state.together?'result-next':'island');\n    } else if (state.screen === 'endDay') {\n      const guest=state.profile, goal=goals[profileDay()-1];\n      const canFinish=guest.checked && (guest.freePlay || guest.day===5 ? guest.finaleDone || guest.freePlay : guest.dayMinutes>=goal);\n      html = modal(guest.day===5?'Check out?':'Time to rest?','THE MINUTE CLAM', `<div class=\"dialogue\"><span class=\"speaker\">PIP · RECEPTION CUSHION</span><p>“The clam has swallowed ${guest.dayMinutes || 0} minutes today. This is apparently a good thing.”</p></div><p>${!guest.checked?'Complete the morning Wobble Check first.':guest.day===5&&!guest.finaleDone&&!guest.freePlay?'Complete The Big Stand before checking out.':!canFinish?`The clam is hoping for ${goal} minutes today. Complete another activity or two.`:'You have done enough for today. The island will be here when you wake.'}</p><div class=\"row\">${button('Keep exploring','island')}${canFinish ? button(guest.day===5?'See the finale':'Sleep until tomorrow','sleep','primary') : ''}</div>`, 'island');\n    } else if (state.screen === 'ending') {\n      html = modal(state.profile.age<=40?'A standing ovation.':'An extended stay.','THE BIG STAND · CHECKOUT', `<div class=\"big-score\">${state.profile.age}<small>FINAL BALANCE AGE</small></div><div class=\"dialogue\"><p>${state.profile.age<=40?'“You did it,” says Pip. “You stood there, and we all felt something.”':'“We’ve extended your stay,” says Pip. “The paperwork is a napkin.”'}</p><p>The cast waves from the water. Your island adventure continues in free play.</p></div><p>Created for Tippy Cay · A playful original game inspired by Wii Fit.</p><div class=\"row\">${button('Continue in free play','free-play','primary')}</div>`, 'island');\n    } else if (state.screen === 'together') {\n      html = modal('Play together','THE ISLAND MEDLEY', `<p>Take turns on one device through Paddle Slalom, Tide Table, and Cannonball Cup. Add up to four guests; each score is out of 3,000.</p><div class=\"cards three\">${[2,3,4].map(number=>`<button class=\"card\" data-action=\"hotseat:${number}\"><strong>${number} guests</strong><small>Pass the controller after each medley</small></button>`).join('')}</div><p class=\"tiny\">When launched from AI Hub, the same medley runs online with translucent ghost guests.</p>`);\n    } else if (state.screen === 'handoff') {\n      const group=state.together, item=eventById(medley[group.event]);\n      html = modal(`Guest ${group.player+1}, you’re up!`,'PASS THE CONTROLLER', `<p>Round ${group.event+1} of 3: <strong>${item.name}</strong></p><div class=\"dialogue\"><p>“No rush,” says Pip. “The sea will wait. The gull might not.”</p></div><div class=\"row\">${button('Start '+item.name,'hotseat-next','primary')}</div>`, 'title');\n    } else if (state.screen === 'podium') {\n      const group=state.together, ranking=group.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n      html = modal('A very good medley','ISLAND PODIUM', `<p>The clam would like to thank every guest for their outstanding participation.</p><div class=\"cards\">${ranking.map((entry,index)=>`<div class=\"card\"><strong>${['🥇','🥈','🥉','✳'][index]} Guest ${entry.index+1}</strong><small>${formatScore(entry.score)} / 3,000 points</small></div>`).join('')}</div><div class=\"row\">${button('Play again','together')}${button('Return to title','title','primary')}</div>`);\n    } else if (state.screen === 'waiting') {\n      html = modal('Waiting for the island','AI HUB · ONLINE MEDLEY', `<p>${esc(state.message || 'Getting your group together…')}</p><div class=\"dialogue\"><p>Three events. One shared island. Everyone plays at their own pace with live ghost guests.</p></div>${state.hub && !state.hub.splash ? `<div class=\"row\">${button('Ready to play','hub-ready','primary')}</div>` : ''}`);\n    } else if (state.screen === 'settings') {\n      html = modal('Make it yours','SETTINGS & CONTROLS', `<label class=\"field\">Music volume: <span id=\"music-value\">${Math.round(settings.music*100)}%</span><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"${Math.round(settings.music*100)}\"></label><label class=\"field\">Sound effects <select id=\"sound\"><option value=\"on\" ${settings.sound?'selected':''}>On</option><option value=\"off\" ${!settings.sound?'selected':''}>Off</option></select></label><label class=\"field\">Controller labels <select id=\"glyph\"><option ${settings.glyph==='PlayStation'?'selected':''}>PlayStation</option><option ${settings.glyph==='Xbox'?'selected':''}>Xbox</option></select></label><p>Keyboard: WASD or arrow keys to lean; Space / Enter to act; Esc to pause. Controller: left stick and ${settings.glyph==='Xbox'?'A':'Cross'}. Mouse: move to lean and click to act. Arrow keys navigate menus.</p><p>Touch-only devices can view the island; connect a controller or keyboard to play.</p><div class=\"row\">${button('Done','settings-back','primary')}</div>`, 'settings-back');\n    } else if (state.screen === 'about') {\n      const info = window.__aboutData || {};\n      const blocks = [['Source Information',info.sourceInformation],['Testing Feedback',info.testingFeedback],['Engine Feedback',info.engineFeedback],['Prompt Feedback',info.promptFeedback]];\n      html = modal('About this game','THE FINE PRINT', `<p>Made with Shardfall and an original island full of questionable advice.</p>${blocks.map(([label,value])=>`<h3>${esc(label)}</h3><div class=\"about-list\">${Array.isArray(value)?value.map(line=>`<p>${esc(line)}</p>`).join(''):Object.entries(value||{}).map(([key,line])=>`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('')}</div>`).join('')}<div class=\"row\">${button('Back to the island','title','primary')}</div>`);\n    }\n    if (state.attract && state.screen==='title') html += `<div class=\"attract-label\">A LITTLE ISLAND DAYDREAM · PRESS ANY KEY TO RETURN</div>`;\n    if (isTouchOnly() && !state.hasHardwareInput && !['settings','about'].includes(state.screen)) html += `<div class=\"touch-guard\"><div><strong>Controller or keyboard required</strong><p>Connect one to play. The island will wait for you.</p><button class=\"button\" data-action=\"settings\">Settings</button></div></div>`;\n    app.innerHTML = html;\n    const musicInput=document.getElementById('music');\n    if (musicInput) musicInput.addEventListener('input', event=>{ settings.music=Number(event.target.value)/100; document.getElementById('music-value').textContent=Math.round(settings.music*100)+'%'; save(); });\n    const soundInput=document.getElementById('sound');\n    if (soundInput) soundInput.addEventListener('change', event=>{ settings.sound=event.target.value==='on'; save(); });\n    const glyphInput=document.getElementById('glyph');\n    if (glyphInput) glyphInput.addEventListener('change', event=>{ settings.glyph=event.target.value; save(); render(); });\n    const nameInput=document.getElementById('guest-name');\n    if (nameInput) nameInput.addEventListener('change', event=>{ state.setup.name=event.target.value; });\n    for (const kind of ['stiffness','damping']) { const input=document.getElementById('dev-'+kind); if(input) input.addEventListener('input', event=>{state[kind]=Number(event.target.value);}); }\n  }\n\n  function isTouchOnly() { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; }\n  function newProfile() { return {name:state.setup.name,skin:state.setup.skin,outfit:state.setup.outfit,day:1,dayMinutes:0,minutesTotal:0,stars:0,age:null,checked:false,finaleDone:false,freePlay:false,bests:{},lastDate:new Date().toISOString().slice(0,10)}; }\n  function setScreen(screen) { state.screen=screen; render(); }\n  function selectAction(action) {\n    if (!action) return;\n    sound(520,.05);\n    if (action === 'title') { state.paused=false; state.together=null; state.round=null; setScreen('title'); }\n    else if (action === 'slots-new' || action === 'slots-continue') { state.slotMode=action==='slots-new'?'new':'continue'; setScreen('slots'); }\n    else if (action.startsWith('slot:')) { const index=Number(action.slice(5)), guest=(saved.slots||[])[index]; state.slot=index; if (guest) { state.profile=guest; setScreen('island'); } else { state.setup={name:names[index],skin:index%skins.length,outfit:index%outfits.length}; setScreen('customize'); } }\n    else if (action.startsWith('skin:')) { state.setup.skin=Number(action.slice(5)); render(); }\n    else if (action.startsWith('outfit:')) { state.setup.outfit=Number(action.slice(7)); render(); }\n    else if (action==='create-guest') { state.profile=newProfile(); save(); voice(); setScreen('intro'); }\n    else if (action==='island') { if (state.profile) {state.paused=false;setScreen('island');} else setScreen('title'); }\n    else if (action==='calendar') setScreen('calendar');\n    else if (action==='check') { voice(); setScreen('checkIntro'); }\n    else if (action==='begin-check') startCheck();\n    else if (action.startsWith('intro:')) { state.eventId=action.slice(6); voice(); setScreen('eventIntro'); }\n    else if (action==='cancel-event') setScreen(state.together?'handoff':'island');\n    else if (action==='begin-event') startRound(state.eventId);\n    else if (action==='pause') { state.paused=true; render(); }\n    else if (action==='resume') { state.paused=false; render(); }\n    else if (action==='reset-tuning') { state.stiffness=40; state.damping=8.5; render(); }\n    else if (action==='leave-event') { state.paused=false; if (state.together && state.together.online) reportHub(); else setScreen(state.together?'handoff':'island'); }\n    else if (action==='result-next') advanceResult();\n    else if (action==='end-day') setScreen('endDay');\n# Progress\n\n- Title: **Wii Fit Together**, selected uniformly using Node.js `crypto.randomInt` from 50 brainstormed candidates.\n- Deliverable: `Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701.html` in the workspace root; source and development files in the identically named directory.\n- Engine and Hub client acquired; native engine build succeeds. Registered a Tippy Cay scene and deterministic balance spring in Shardfall.\n- Current phase: bundle the standalone browser game and embedded AI Hub client.\n- Next: test gameplay, persistence, Hub and viewport behavior; complete the exit interview and final hand-in.\n- Limitation: the playable presentation and most activity logic are Canvas 2D / JavaScript over a Shardfall hook, not the planned full native 3D engine implementation.\nSOURCE: Wii Fit\n\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\n\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\n\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\n\nResearch: Whether and how much to research is your choice.\n\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-222701].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\n\nTech Stack: Build on https://github.com/michaelcrosato/shardfall/blob/main/START_HERE.md, making a new game on its engine. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\n\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\n\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\n\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\n\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\n\nWorking Environment and deliverable:\nCreate a subfolder called [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-222701] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-222701].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\n\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\n\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\n\nEffort: Spend effort however you see fit.\n\n## This computer\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\n\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\n  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\n- **Not installed:** sox, bun, deno.\n- **Network:** internet works (github.com, registry.npmjs.org).\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \"Target closed\", \"page crashed\" or \"browser has been closed\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\n\n### What this computer doesn't have\n\nNo script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\n\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\n\n### Sharing this computer\n\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\n\n## Goal\n\nBuild an original game inspired by the source.\n\nScope\n\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\n\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\n\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\n\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\n\nNarrative tone: Use a writing style similar to the source’s.\n\n## UI & UX: 10-Foot Controller-First Philosophy\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\n\nDo not use overly dense, web-style data screens.\n\nTouch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.\n\n## Done\nNo TODOs, placeholders, or stubbed features. The demo is complete.\n\n## Source Information\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n- Date: 2026-11-04 22:27:01\n- Source: the work it's based on\n- Plan: the file name of the plan you were given to build from, or none\n- Genre and Perspective: genre and camera perspective used\n- Tech: stack, libraries/engines, with versions if applicable\n- Art Direction: style used\n- Animation: system used\n- Audio: music, sound effects and voice used\n- Online: network features used, or none\n- Testing: testing parameters allowed\n- Research: research done, or none\n- Environment: Codex CLI (headless); Linux\n- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n{\n  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n  \"aiHub\": {\n    \"name\": \"the game's title, as on its title screen\",\n    \"tagline\": \"a few words to go under the title\",\n    \"description\": \"one or two sentences for the catalogue\",\n    \"type\": \"Game, Tech demo or Tool\",\n    \"genre\": \"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\",\n    \"source\": \"the work it's based on, e.g. Moby-Dick\",\n    \"series\": \"its franchise, e.g. Star Fox, or empty\",\n    \"players\": \"how many can play: 1, 1–2 or 1–4\",\n    \"controls\": \"the controls, in one line\",\n    \"tags\": [\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\"]\n  }\n}\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n\nTesting Feedback\n\n- How many issues did testing catch?\n- How many would be considered critical issues / game breaking?\n- What was the most helpful test you ran?\n- What was the least helpful test you ran?\n\nEngine Feedback\n\n- What did you like most about the engine?\n- Did you get stuck or guess wrong?\n- What was the most important thing you had to build yourself?\n- What was the hardest part about using the engine?\n- What did you change in the engine, and why? (none if nothing)\n- If you could change one thing about the engine, what would it be?\n\nPrompt Feedback\n\n- What did you like most about this prompt?\n- What was confusing?\n- What was the hardest thing to do?\n- What would you change in this prompt?\n","exit_code":0,"status":"completed"}}
