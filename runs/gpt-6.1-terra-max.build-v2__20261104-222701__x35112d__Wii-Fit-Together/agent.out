{"type":"item.started","item":{"id":"item_165","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '55,112p' \\\"\"'$dev/web/game.js\" | fold -w 220 -s; sed -n '\"'129,205p' \\\"\"'$dev/web/game.js\" | fold -w 220 -s; ls -la \"$dev/tests\"; viewport-matrix --help | head -50'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_165","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '55,112p' \\\"\"'$dev/web/game.js\" | fold -w 220 -s; sed -n '\"'129,205p' \\\"\"'$dev/web/game.js\" | fold -w 220 -s; ls -la \"$dev/tests\"; viewport-matrix --help | head -50'","aggregated_output":"  function unlocked(item) { return state.profile && (state.profile.freePlay || item.day <= state.profile.day); }\n  function formatScore(score) { return Math.round(score).toLocaleString(); }\n\n  function render() {\n    let html = '';\n    if (state.screen === 'title') {\n      const hasSave = (saved.slots || []).some(Boolean);\n      html = shell(`<div class=\"title-layout\"><section class=\"title-panel\"><div class=\"overline\">A rather uplifting island escape</div><h1>Wii Fit<br><span>Together.</span></h1><p class=\"lede\">Welcome to Tippy Cay, \nwhere the sea is calm, the company is questionable, and balance is a journey.</p><div class=\"title-actions\">${button('New Stay','slots-new','primary','A five-day island \nadventure')}${button('Continue','slots-continue','',hasSave?'Welcome back to the island':'Choose a guest to continue')}${button('Play Together','together','coral','Local or AI Hub \nmedley')}${button('Settings','settings','', 'Controls, sound & accessibility')}</div></section><aside class=\"hero-note\"><b>A note from Pip</b>“We believe in you.<br>Gravity has declined to comment.”</aside></div><div \nclass=\"footer\"><span>✳ AN ORIGINAL TIPPY CAY GETAWAY</span><div><button class=\"pill\" data-action=\"about\">About this game</button> <span class=\"hint\">WASD / arrows · Space · Controller</span></div></div>`, 'THE ISLAND IS \nOPEN');\n    } else if (state.screen === 'slots') {\n      const slots = saved.slots || [null,null,null,null];\n      html = modal(state.slotMode === 'new' ? 'Choose a guest' : 'Welcome back', 'THE GUEST BOOK', `<p>Every guest gets a little corner of the island. Choose an empty book to begin.</p><div \nclass=\"cards\">${slots.map((guest,index) => `<button class=\"card\" data-action=\"slot:${index}\"><strong>${guest ? esc(guest.name) : 'Guest '+(index+1)+' · Empty'}</strong><small>${guest ? `Day ${guest.day} · \n${guest.minutesTotal || 0} minutes banked` : 'Ready for a new stay'}</small></button>`).join('')}</div><p class=\"tiny\">Your progress stays in this browser on this device.</p>`);\n    } else if (state.screen === 'customize') {\n      html = modal('Make yourself at home','YOUR ISLAND LOOK', `<p>Pick a name and an outfit. Your look is always welcome here.</p><label class=\"field\">Guest name<select id=\"guest-name\">${names.map(name=>`<option ${name \n=== state.setup.name ? 'selected' : ''}>${name}</option>`).join('')}</select></label><div class=\"field\">Skin tone<div class=\"swatches\">${skins.map((color,index)=>`<button class=\"swatch \n${index===state.setup.skin?'selected':''}\" style=\"background:${color}\" data-action=\"skin:${index}\" aria-label=\"Skin tone ${index+1}\"></button>`).join('')}</div></div><div class=\"field\">Outfit color<div \nclass=\"swatches\">${outfits.map((color,index)=>`<button class=\"swatch ${index===state.setup.outfit?'selected':''}\" style=\"background:${color}\" data-action=\"outfit:${index}\" aria-label=\"Outfit color \n${index+1}\"></button>`).join('')}</div></div><div class=\"row\">${button('Back','slots-new')}${button('Arrive on the island','create-guest','primary')}</div>`, 'slots-new');\n    } else if (state.screen === 'intro') {\n      html = modal(`Welcome, ${esc(profileName())}!`,'A WORD FROM PIP', `<div class=\"dialogue\"><span class=\"speaker\">PIP · RECEPTION CUSHION</span><p>“I’m Pip. I run reception, mostly by remaining in one place. You’ll \nfit right in.”</p><p>Each morning starts with a Wobble Check. Try activities, collect minutes for the giant clam, and take the week at your own pace.</p></div><div class=\"row\">${button('Let’s \nexplore','island','primary')}</div>`);\n    } else if (state.screen === 'island') {\n      const guest=state.profile, day=profileDay(), goal=goals[day-1];\n      const available=events.filter(item=>unlocked(item));\n      html = shell(`<div class=\"island-layout\"><section class=\"island-panel\"><div class=\"eyebrow\">HELLO, ${esc(guest.name.toUpperCase())} · ${guest.freePlay?'FREE PLAY':'YOUR ISLAND STAY'}</div><h2>Find your<br>happy \nwobble.</h2><div class=\"dayline\"><span>DAY ${day} / 5</span><span>✳ ${guest.dayMinutes || 0} / ${goal || '∞'} MIN</span><span>★ ${guest.stars || 0} STARS</span></div><p class=\"island-note\">${guest.checked ? `Pip says \nyour Balance Age is ${guest.age}. The clam looks impressed.` : 'Pip is waiting for your morning Wobble Check.'}</p><div class=\"activity-list\">${!guest.checked ? `<button class=\"activity highlight\" \ndata-action=\"check\"><span>◉</span><strong>Morning Wobble Check<small>Say hello to Pip · about a minute</small></strong><b>→</b></button>` : ''}${available.map(item=>`<button class=\"activity\" \ndata-action=\"intro:${item.id}\"><span>${item.day===4?'≈':item.day===3?'✳':item.day===5?'★':'◌'}</span><strong>${item.name}<small>${item.place} · ${item.coach}</small></strong><b>→</b></button>`).join('')}</div><div \nclass=\"row island-actions\">${button('Guest book','calendar')}${button(day===5?'Finish the stay':'Call it a day','end-day','primary')}</div></section></div><div class=\"footer\"><span>MINUTE CLAM: ${guest.minutesTotal || \n0} MINUTES SAVED</span><button class=\"pill\" data-action=\"settings\">Settings</button></div>`, guest.freePlay ? 'FREE PLAY' : `DAY ${day} OF 5`);\n    } else if (state.screen === 'calendar') {\n      const guest=state.profile;\n      html = modal('Your island log','THE GUEST BOOK', `<p>Every visit is worth a stamp. Your best moments stay right here.</p><div class=\"cards\">${[1,2,3,4,5].map(day=>`<div class=\"card\"><strong>${day < guest.day || \nguest.freePlay ? '✓' : '○'} Day ${day}</strong><small>${day===guest.day&&!guest.freePlay?'Currently exploring':day < guest.day || guest.freePlay?'A day well spent':'A day to look forward \nto'}</small></div>`).join('')}</div><p>Balance Age: <strong>${guest.age ?? 'not checked yet'}</strong> · Total: <strong>${guest.minutesTotal || 0} minutes</strong></p><div class=\"row\">${button('Back to the \nisland','island','primary')}</div>`, 'island');\n    } else if (state.screen === 'eventIntro') {\n      const item=eventById(state.eventId);\n      html = modal(item.name, `${esc(item.place.toUpperCase())} · WITH ${esc(item.coach.toUpperCase())}`, `<div class=\"dialogue\"><span class=\"speaker\">${esc(item.coach.toUpperCase())} \nSAYS</span><p>“${esc(item.description)}”</p></div><p><strong>How to play:</strong> ${esc(item.controls)}</p><p>Move with WASD, arrows, a controller stick, or your mouse. Action is Space, Enter, controller south button, \nor click.</p><div class=\"row\">${button('Not yet','cancel-event')}${button('I’m ready','begin-event','primary')}</div>`, 'cancel-event');\n    } else if (state.screen === 'checkIntro') {\n      html = modal('Morning Wobble Check','PIP · RECEPTION CUSHION', `<div class=\"dialogue\"><p>“This is not a test of your worth. It is a test of whether the dot stays near the middle.”</p></div><p>Four little checks: \nstand still, lean toward targets, close your eyes, and alternate steps. Your Balance Age is a playful score, not medical advice.</p><div class=\"row\">${button('Back','island')}${button('Begin the \ncheck','begin-check','primary')}</div>`, 'island');\n    } else if (state.screen === 'event' || state.screen === 'check') {\n      const round=state.round;\n      html = shell(`<div class=\"hud\"><div><div class=\"eyebrow\">${esc(round.place.toUpperCase())}</div><h2 id=\"round-name\">${esc(round.name)}</h2><div id=\"round-subtitle\">${esc(round.instruction)}</div></div><div \nclass=\"hud-right\"><div class=\"pill\" id=\"timer\">${Math.ceil(round.length)}s</div><button class=\"pill\" data-action=\"pause\">Ⅱ Pause</button></div></div><div class=\"event-center\"><div class=\"phase-card\" \nid=\"phase-card\">${esc(round.instruction)}</div></div><div class=\"event-bottom\"><div class=\"puck\" aria-label=\"Balance puck\"><div class=\"target\" id=\"target\"></div><div class=\"dot\" id=\"dot\"></div></div><div \nclass=\"meter\"><div><strong id=\"round-score\">0</strong> <span id=\"score-label\">POINTS</span></div><div class=\"meter-track\"><div id=\"meter-fill\"></div></div><small \nid=\"round-help\">${esc(round.controls)}</small></div></div>`, state.together ? `PLAYER ${state.together.player+1} · MEDLEY` : 'FIND YOUR BALANCE');\n      if (state.paused) html += `<div class=\"overlay\"><section class=\"panel narrow\"><div class=\"eyebrow\">TAKE YOUR TIME</div><h2>Paused.</h2><p>The island isn’t going anywhere.</p><div \nclass=\"row\">${button('Resume','resume','primary')}${button('Settings','settings')}${button('Leave activity','leave-event')}</div><details><summary>Developer tuning</summary><label class=\"field\">Spring stiffness<input \nid=\"dev-stiffness\" type=\"range\" min=\"10\" max=\"80\" value=\"${state.stiffness || 40}\"></label><label class=\"field\">Damping<input id=\"dev-damping\" type=\"range\" min=\"2\" max=\"20\" value=\"${state.damping || 8.5}\" \nstep=\".5\"></label>${button('Reset tuning','reset-tuning')}</details></section></div>`;\n    } else if (state.screen === 'result') {\n      const result=state.result;\n      html = modal(result.isCheck ? `Balance Age: ${result.age}` : result.name, result.isCheck?'MORNING CHECK COMPLETE':'THAT WAS A GOOD WOBBLE', `<div class=\"big-score\">${result.isCheck ? esc(result.age) : \nformatScore(result.score)}<small>${result.isCheck?'PLAYFUL BALANCE AGE · NOT A HEALTH MEASURE':'POINTS'}</small></div><div class=\"stars\">${'★'.repeat(result.stars || 0)}${'☆'.repeat(3-(result.stars || 0))}</div><div \nclass=\"dialogue\"><span class=\"speaker\">PIP SAYS</span><p>“${esc(result.comment)}”</p></div><div class=\"row\">${button(state.together?'Continue medley':'Back to the island','result-next','primary')}</div>`, \nstate.together?'result-next':'island');\n    } else if (state.screen === 'endDay') {\n      const guest=state.profile, goal=goals[profileDay()-1];\n      const canFinish=guest.checked && (guest.freePlay || guest.day===5 ? guest.finaleDone || guest.freePlay : guest.dayMinutes>=goal);\n      html = modal(guest.day===5?'Check out?':'Time to rest?','THE MINUTE CLAM', `<div class=\"dialogue\"><span class=\"speaker\">PIP · RECEPTION CUSHION</span><p>“The clam has swallowed ${guest.dayMinutes || 0} minutes \ntoday. This is apparently a good thing.”</p></div><p>${!guest.checked?'Complete the morning Wobble Check first.':guest.day===5&&!guest.finaleDone&&!guest.freePlay?'Complete The Big Stand before checking \nout.':!canFinish?`The clam is hoping for ${goal} minutes today. Complete another activity or two.`:'You have done enough for today. The island will be here when you wake.'}</p><div class=\"row\">${button('Keep \nexploring','island')}${canFinish ? button(guest.day===5?'See the finale':'Sleep until tomorrow','sleep','primary') : ''}</div>`, 'island');\n    } else if (state.screen === 'ending') {\n      html = modal(state.profile.age<=40?'A standing ovation.':'An extended stay.','THE BIG STAND · CHECKOUT', `<div class=\"big-score\">${state.profile.age}<small>FINAL BALANCE AGE</small></div><div \nclass=\"dialogue\"><p>${state.profile.age<=40?'“You did it,” says Pip. “You stood there, and we all felt something.”':'“We’ve extended your stay,” says Pip. “The paperwork is a napkin.”'}</p><p>The cast waves from the \nwater. Your island adventure continues in free play.</p></div><p>Created for Tippy Cay · A playful original game inspired by Wii Fit.</p><div class=\"row\">${button('Continue in free play','free-play','primary')}</div>`, \n'island');\n    } else if (state.screen === 'together') {\n      html = modal('Play together','THE ISLAND MEDLEY', `<p>Take turns on one device through Paddle Slalom, Tide Table, and Cannonball Cup. Add up to four guests; each score is out of 3,000.</p><div class=\"cards \nthree\">${[2,3,4].map(number=>`<button class=\"card\" data-action=\"hotseat:${number}\"><strong>${number} guests</strong><small>Pass the controller after each medley</small></button>`).join('')}</div><p class=\"tiny\">When \nlaunched from AI Hub, the same medley runs online with translucent ghost guests.</p>`);\n    } else if (state.screen === 'handoff') {\n      const group=state.together, item=eventById(medley[group.event]);\n      html = modal(`Guest ${group.player+1}, you’re up!`,'PASS THE CONTROLLER', `<p>Round ${group.event+1} of 3: <strong>${item.name}</strong></p><div class=\"dialogue\"><p>“No rush,” says Pip. “The sea will wait. The \ngull might not.”</p></div><div class=\"row\">${button('Start '+item.name,'hotseat-next','primary')}</div>`, 'title');\n    } else if (state.screen === 'podium') {\n      const group=state.together, ranking=group.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\n      html = modal('A very good medley','ISLAND PODIUM', `<p>The clam would like to thank every guest for their outstanding participation.</p><div class=\"cards\">${ranking.map((entry,index)=>`<div \nclass=\"card\"><strong>${['🥇','🥈','🥉','✳'][index]} Guest ${entry.index+1}</strong><small>${formatScore(entry.score)} / 3,000 points</small></div>`).join('')}</div><div class=\"row\">${button('Play \nagain','together')}${button('Return to title','title','primary')}</div>`);\n    } else if (state.screen === 'waiting') {\n      html = modal('Waiting for the island','AI HUB · ONLINE MEDLEY', `<p>${esc(state.message || 'Getting your group together…')}</p><div class=\"dialogue\"><p>Three events. One shared island. Everyone plays at their own \npace with live ghost guests.</p></div>${state.hub && !state.hub.splash ? `<div class=\"row\">${button('Ready to play','hub-ready','primary')}</div>` : ''}`);\n    } else if (state.screen === 'settings') {\n      html = modal('Make it yours','SETTINGS & CONTROLS', `<label class=\"field\">Music volume: <span id=\"music-value\">${Math.round(settings.music*100)}%</span><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" \nvalue=\"${Math.round(settings.music*100)}\"></label><label class=\"field\">Sound effects <select id=\"sound\"><option value=\"on\" ${settings.sound?'selected':''}>On</option><option value=\"off\" \n${!settings.sound?'selected':''}>Off</option></select></label><label class=\"field\">Controller labels <select id=\"glyph\"><option ${settings.glyph==='PlayStation'?'selected':''}>PlayStation</option><option \n${settings.glyph==='Xbox'?'selected':''}>Xbox</option></select></label><p>Keyboard: WASD or arrow keys to lean; Space / Enter to act; Esc to pause. Controller: left stick and ${settings.glyph==='Xbox'?'A':'Cross'}. \nMouse: move to lean and click to act. Arrow keys navigate menus.</p><p>Touch-only devices can view the island; connect a controller or keyboard to play.</p><div \nclass=\"row\">${button('Done','settings-back','primary')}</div>`, 'settings-back');\n    } else if (state.screen === 'about') {\n      const info = window.__aboutData || {};\n      const blocks = [['Source Information',info.sourceInformation],['Testing Feedback',info.testingFeedback],['Engine Feedback',info.engineFeedback],['Prompt Feedback',info.promptFeedback]];\n      html = modal('About this game','THE FINE PRINT', `<p>Made with Shardfall and an original island full of questionable advice.</p>${blocks.map(([label,value])=>`<h3>${esc(label)}</h3><div \nclass=\"about-list\">${Array.isArray(value)?value.map(line=>`<p>${esc(line)}</p>`).join(''):Object.entries(value||{}).map(([key,line])=>`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('')}</div>`).join('')}<div \nclass=\"row\">${button('Back to the island','title','primary')}</div>`);\n    }\n    if (state.attract && state.screen==='title') html += `<div class=\"attract-label\">A LITTLE ISLAND DAYDREAM · PRESS ANY KEY TO RETURN</div>`;\n  function selectAction(action) {\n    if (!action) return;\n    sound(520,.05);\n    if (action === 'title') { state.paused=false; state.together=null; state.round=null; setScreen('title'); }\n    else if (action === 'slots-new' || action === 'slots-continue') { state.slotMode=action==='slots-new'?'new':'continue'; setScreen('slots'); }\n    else if (action.startsWith('slot:')) { const index=Number(action.slice(5)), guest=(saved.slots||[])[index]; state.slot=index; if (guest) { state.profile=guest; setScreen('island'); } else { \nstate.setup={name:names[index],skin:index%skins.length,outfit:index%outfits.length}; setScreen('customize'); } }\n    else if (action.startsWith('skin:')) { state.setup.skin=Number(action.slice(5)); render(); }\n    else if (action.startsWith('outfit:')) { state.setup.outfit=Number(action.slice(7)); render(); }\n    else if (action==='create-guest') { state.profile=newProfile(); save(); voice(); setScreen('intro'); }\n    else if (action==='island') { if (state.profile) {state.paused=false;setScreen('island');} else setScreen('title'); }\n    else if (action==='calendar') setScreen('calendar');\n    else if (action==='check') { voice(); setScreen('checkIntro'); }\n    else if (action==='begin-check') startCheck();\n    else if (action.startsWith('intro:')) { state.eventId=action.slice(6); voice(); setScreen('eventIntro'); }\n    else if (action==='cancel-event') setScreen(state.together?'handoff':'island');\n    else if (action==='begin-event') startRound(state.eventId);\n    else if (action==='pause') { state.paused=true; render(); }\n    else if (action==='resume') { state.paused=false; render(); }\n    else if (action==='reset-tuning') { state.stiffness=40; state.damping=8.5; render(); }\n    else if (action==='leave-event') { state.paused=false; if (state.together && state.together.online) reportHub(); else setScreen(state.together?'handoff':'island'); }\n    else if (action==='result-next') advanceResult();\n    else if (action==='end-day') setScreen('endDay');\n    else if (action==='sleep') { if (state.profile.day===5) setScreen('ending'); else { state.profile.day++; state.profile.dayMinutes=0; state.profile.checked=false; state.profile.lastDate=new \nDate().toISOString().slice(0,10); save(); setScreen('island'); } }\n    else if (action==='free-play') { state.profile.freePlay=true; save(); setScreen('island'); }\n    else if (action==='together') { state.together=null; setScreen('together'); }\n    else if (action.startsWith('hotseat:')) { state.together={count:Number(action.slice(8)),player:0,event:0,scores:[0,0,0,0],online:false,ghosts:{}}; setScreen('handoff'); }\n    else if (action==='hotseat-next') { state.eventId=medley[state.together.event]; setScreen('eventIntro'); }\n    else if (action==='settings') { state.returnScreen=state.screen; setScreen('settings'); }\n    else if (action==='settings-back') setScreen(state.returnScreen || 'title');\n    else if (action==='about') setScreen('about');\n    else if (action==='hub-ready') { if(hub) hub.ready(); state.message='Ready! Waiting for the other guests.'; render(); }\n  }\n\n  function startCheck() { center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; state.paused=false; state.round={name:'Morning Wobble Check',place:'Stillness Studio',instruction:'Stand still. This is the whole \ntest.',controls:'Keep the dot near the center.',length:37,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,targets:0,phase:0,steps:0,lastStep:'',metric:[0,0,0,0],phaseSamples:[0,0,0,0]}; setScreen('check'); }\n  function startRound(id) { const item=eventById(id); if(!item) return; center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; lastHubUpdate=0; state.paused=false; \nstate.round={...item,instruction:item.controls,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,steps:0,lastStep:'',shellX:0,shellY:0,shellVx:0,shellVy:0,potted:0,spin:0,prevAngle:0,gates:0,gateIndex:-1,stillBroken:f\nalse,ghostTrail:[]}; setScreen('event'); }\n  function triggerAction(side='action') {\n    if (!state.round || !['event','check'].includes(state.screen) || state.paused) return;\n    const round=state.round, time=round.elapsed;\n    if (round.id==='finale' && time>60) round.stillBroken=true;\n    round.actionCount++;\n    if (side==='left' || side==='right') { if (round.lastStep!==side) {round.steps++; round.lastStep=side;} }\n    if (round.id==='squat' || round.id==='step' || round.id==='lap' || round.id==='dive' || state.screen==='check') {\n      const interval=round.id==='dive'?1.2:round.id==='step'?.625:.6;\n      const phase=time%interval; if(Math.min(phase,interval-phase)<.22) round.actionHits++;\n      sound(round.id==='dive'?240:420,.09,'sine',.045);\n    } else sound(360,.06,'sine',.03);\n  }\n  function finishCheck() {\n    const round=state.round;\n    const metric=round.metric.map((value,index)=>round.phaseSamples[index] ? value/round.phaseSamples[index] : 0);\n    metric[3]=clamp(round.steps/8,0,1)*.6 + clamp(round.actionHits/8,0,1)*.4;\n    const skill=.30*metric[0]+.25*metric[1]+.25*metric[2]+.20*metric[3];\n    const age=Math.round(clamp(24+56*Math.pow(1-clamp(skill,0,1),1.1)-2*(profileDay()-1)-Math.min((state.profile.stars||0)/3,8),18,99));\n    state.profile.checked=true; state.profile.age=age; save();\n    state.result={isCheck:true,age,stars:skill>.8?3:skill>.5?2:1,comment:'A number! We can put it on a postcard. The important part is that you showed up.'}; voice(); setScreen('result');\n  }\n  function finishRound() {\n    const round=state.round; let score=Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000);\n    if (round.id==='tide') score=Math.round(clamp(round.potted*200+score*.4,0,1000));\n    if (round.id==='paddle') score=Math.round(clamp(round.gates*125+score*.3,0,1000));\n    if (round.id==='dive') score=Math.round(clamp(score*.5+Math.min(round.actionHits,8)*65,0,1000));\n    if (round.id==='finale' && !round.stillBroken) score=Math.min(1000,score+100);\n    const stars=score>=850?3:score>=650?2:score>=400?1:0;\n    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\n    else if (state.profile) { const guest=state.profile; guest.dayMinutes=(guest.dayMinutes||0)+2; guest.minutesTotal=(guest.minutesTotal||0)+2; guest.stars=(guest.stars||0)+stars; \nguest.bests[round.id]=Math.max(guest.bests[round.id]||0,score); if(round.id==='finale') {guest.finaleDone=true;guest.age=Math.max(18,Math.round((guest.age||60)-score/100));} save(); }\n    state.result={isCheck:false,name:round.name,score,stars,comment:`${titles[Math.min(titles.length-1,Math.floor(score/1000*titles.length))]}. We’ve banked ${state.together?'your points':'two minutes in the clam'}.`}; \nsound(660,.25,'sine'); voice(); setScreen('result');\n  }\n  function advanceResult() {\n    if(!state.together) {setScreen('island');return;}\n    const group=state.together; group.event++;\n    if(group.online) { if(group.event>=3) reportHub(); else {state.eventId=medley[group.event];startRound(state.eventId);} return; }\n    if(group.event>=3) {group.event=0;group.player++;}\n    if(group.player>=group.count) setScreen('podium'); else setScreen('handoff');\n  }\n  function reportHub() { if(!state.together || !state.together.online) return; const score=clamp(Math.round(state.together.scores[0]),0,3000); if(hub && !state.together.reported) \n{state.together.reported=true;hub.result({score,stats:{events:Math.min(3,state.together.event)},awards:[{name:'Island Enthusiast',description:'Completed the Tippy Cay medley.'}]});} state.message=`Medley complete: \n${formatScore(score)} points. Waiting for the group.`;setScreen('waiting'); }\n\n  function updateInput(dt) {\ntotal 8\ndrwxr-xr-x 2 micha micha 4096 Nov  4 22:41 .\ndrwxr-xr-x 7 micha micha 4096 Nov  4 23:02 ..\nusage: viewport-matrix [-h] [-o OUT] [--engines ENGINES] [--all-engines]\n                       [--only ONLY] [--devices DEVICES] [--full-page]\n                       [--dpr1] [--wait WAIT] [--timeout TIMEOUT] [--headed]\n                       url\n\nScreenshot a URL across phone / foldable / tablet / desktop viewports in Chromium, WebKit and Firefox.\n\nWrites one PNG per (device, engine) plus index.html (contact sheet drawn to relative scale) and\nreport.json, and flags horizontal overflow, console errors, page errors and failed requests.\n\nBy default each device runs on the engine it really ships with (iPhone/iPad -> WebKit,\nAndroid -> Chromium) and desktop sizes run on all three engines.\n\n  viewport-matrix http://localhost:5173\n  viewport-matrix http://localhost:5173/play -o /tmp/shots --full-page\n  viewport-matrix URL --engines firefox              # everything in Firefox\n  viewport-matrix URL --all-engines                  # every device x every engine\n  viewport-matrix URL --only phone,foldable --dpr1   # small files, mobile only\n\npositional arguments:\n  url\n\noptions:\n  -h, --help         show this help message and exit\n  -o, --out OUT      output dir (default: $TMPDIR/viewport-matrix/<timestamp>)\n  --engines ENGINES  comma list from chromium,webkit,firefox\n  --all-engines      run every device on every selected engine\n  --only ONLY        comma list of categories: phone,foldable,tablet,desktop\n  --devices DEVICES  comma list of Playwright device names to use instead of\n                     the built-in matrix\n  --full-page        capture the whole scrollable page, not just the viewport\n  --dpr1             force device pixel ratio 1 (smaller PNGs)\n  --wait WAIT        extra ms to wait after load for animations (default 800)\n  --timeout TIMEOUT  navigation timeout in seconds (default 45)\n  --headed           show the browser windows\n","exit_code":0,"status":"completed"}}
