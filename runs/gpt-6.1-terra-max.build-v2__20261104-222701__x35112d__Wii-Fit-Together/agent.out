{"type":"item.started","item":{"id":"item_537","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; mkdir -p \\\"\"'$dev/web/licenses\"; cp /home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/fonts/{Hack-Regular.txt,OFL.txt,UFL.txt,emoji-icon-font-mit-license.txt} \"$dev/web/licenses/\"; apply_patch <<'\"'PATCH'\n*** Begin Patch\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/scripts/bundle.py\n@@\n about = json.loads((root / \\\"exit-interview.json\\\").read_text(encoding=\\\"utf-8\\\"))\n+licenses = {\n+    \\\"Hack\\\": (dev / \\\"web/licenses/Hack-Regular.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+    \\\"Noto Emoji\\\": (dev / \\\"web/licenses/OFL.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+    \\\"Ubuntu Light\\\": (dev / \\\"web/licenses/UFL.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+    \\\"Emoji Icon Font\\\": (dev / \\\"web/licenses/emoji-icon-font-mit-license.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+}\n@@\n about_json = json.dumps(about, ensure_ascii=True).replace(\\\"</\\\", \\\"<\\\\\\\\/\\\")\n+licenses_json = json.dumps(licenses, ensure_ascii=True).replace(\\\"</\\\", \\\"<\\\\\\\\/\\\")\n@@\n-html = html.replace(\\\"</body>\\\", f\\\"<script>window.__aboutData={about_json};</script><script>{game}</script></body>\\\", 1)\n+html = html.replace(\\\"</body>\\\", f\\\"<script>window.__aboutData={about_json};window.__licenseData={licenses_json};</script><script>{game}</script></body>\\\", 1)\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js\n@@\n-      html = modal('About this game','THE FINE PRINT', \"'`<p>Made with Shardfall and an original island full of questionable advice.</p>${blocks.map(([label,value])=>`<h3>${esc(label)}</h3><div class=\"about-list\">${Array.isArray(value)?value.map(line=>`<p>${esc(line)}</p>`).join('\"''):Object.entries(value||{}).map(([key,line])=>\"'`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('\"'')}</div>\"'`).join('\"'')}<div class=\\\"row\\\">\"'${button('\"'Back to the island','title','primary')}</div>\"'`);\n+      html = modal('\"'About this game','THE FINE PRINT', \"'`<p>Made with Shardfall and an original island full of questionable advice.</p>${blocks.map(([label,value])=>`<h3>${esc(label)}</h3><div class=\"about-list\">${Array.isArray(value)?value.map(line=>`<p>${esc(line)}</p>`).join('\"''):Object.entries(value||{}).map(([key,line])=>\"'`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('\"'')}</div>\"'`).join('\"'')}<h3>Library credits</h3><div class=\\\"about-list\\\"><p>Shardfall core assets: Shardfall contributors (CC0 1.0).</p><p>100STYLE motion: Mason, Starke and Komura (CC BY 4.0).</p><p>Mesh2Motion and its contributors; Universal Animation Libraries 1 and 2 by Quaternius (CC0 1.0).</p><p>CMU Graphics Lab Motion Capture Database: free to use, copy, modify and redistribute; the data may not be resold, even in converted form.</p><p>The interface uses system fonts. Shardfall's embedded egui fonts include Hack, Noto Emoji, Ubuntu Light and Emoji Icon Font.</p></div><details class=\\\"licenses\\\"><summary>Font license texts</summary>\"'${Object.entries(window.__licenseData || {}).map(([label,text])=>`<h4>${esc(label)}</h4><pre>${esc(text)}</pre>`).join('\"'')}</details><div class=\\\"row\\\">\"'${button('\"'Back to the island','title','primary')}</div>\"'`);\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css\n@@\n .overlay{position:fixed;inset:0;z-index:12;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(23,63,72,.48);box-sizing:border-box}.overlay .panel{max-height:100%;overflow-y:auto}.overlay details{margin-top:20px}.overlay summary{cursor:pointer;font-weight:900}\n+.licenses summary{cursor:pointer;font-weight:900}.licenses pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.5 ui-monospace,monospace}\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py\n@@\n             click(page, \"about\")\n             assert \"Source Information\" in page.locator(\"#app\").inner_text()\n+            assert \"Library credits\" in page.locator(\"#app\").inner_text()\n+            page.locator(\".licenses summary\").click()\n+            assert \"SIL OPEN FONT LICENSE\" in page.locator(\".licenses\").inner_text()\n             click(page, \"title\")\n@@\n         page.keyboard.press(\"ArrowDown\")\n         click(page, \"settings-back\")\n+        click(page, \"about\")\n+        page.locator(\".licenses summary\").click()\n+        page.locator(\".licenses\").scroll_into_view_if_needed()\n+        page.screenshot(path=str(ARTIFACTS / \"iphone-about.png\"))\n+        assert page.evaluate(\"document.documentElement.scrollWidth <= window.innerWidth\")\n+        click(page, \"title\")\n         new_guest(page)\n*** End Patch\nPATCH\npython3 \"$dev/scripts/bundle.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_537","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; mkdir -p \\\"\"'$dev/web/licenses\"; cp /home/micha/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/epaint_default_fonts-0.36.2/fonts/{Hack-Regular.txt,OFL.txt,UFL.txt,emoji-icon-font-mit-license.txt} \"$dev/web/licenses/\"; apply_patch <<'\"'PATCH'\n*** Begin Patch\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/scripts/bundle.py\n@@\n about = json.loads((root / \\\"exit-interview.json\\\").read_text(encoding=\\\"utf-8\\\"))\n+licenses = {\n+    \\\"Hack\\\": (dev / \\\"web/licenses/Hack-Regular.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+    \\\"Noto Emoji\\\": (dev / \\\"web/licenses/OFL.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+    \\\"Ubuntu Light\\\": (dev / \\\"web/licenses/UFL.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+    \\\"Emoji Icon Font\\\": (dev / \\\"web/licenses/emoji-icon-font-mit-license.txt\\\").read_text(encoding=\\\"utf-8\\\"),\n+}\n@@\n about_json = json.dumps(about, ensure_ascii=True).replace(\\\"</\\\", \\\"<\\\\\\\\/\\\")\n+licenses_json = json.dumps(licenses, ensure_ascii=True).replace(\\\"</\\\", \\\"<\\\\\\\\/\\\")\n@@\n-html = html.replace(\\\"</body>\\\", f\\\"<script>window.__aboutData={about_json};</script><script>{game}</script></body>\\\", 1)\n+html = html.replace(\\\"</body>\\\", f\\\"<script>window.__aboutData={about_json};window.__licenseData={licenses_json};</script><script>{game}</script></body>\\\", 1)\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js\n@@\n-      html = modal('About this game','THE FINE PRINT', \"'`<p>Made with Shardfall and an original island full of questionable advice.</p>${blocks.map(([label,value])=>`<h3>${esc(label)}</h3><div class=\"about-list\">${Array.isArray(value)?value.map(line=>`<p>${esc(line)}</p>`).join('\"''):Object.entries(value||{}).map(([key,line])=>\"'`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('\"'')}</div>\"'`).join('\"'')}<div class=\\\"row\\\">\"'${button('\"'Back to the island','title','primary')}</div>\"'`);\n+      html = modal('\"'About this game','THE FINE PRINT', \"'`<p>Made with Shardfall and an original island full of questionable advice.</p>${blocks.map(([label,value])=>`<h3>${esc(label)}</h3><div class=\"about-list\">${Array.isArray(value)?value.map(line=>`<p>${esc(line)}</p>`).join('\"''):Object.entries(value||{}).map(([key,line])=>\"'`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('\"'')}</div>\"'`).join('\"'')}<h3>Library credits</h3><div class=\\\"about-list\\\"><p>Shardfall core assets: Shardfall contributors (CC0 1.0).</p><p>100STYLE motion: Mason, Starke and Komura (CC BY 4.0).</p><p>Mesh2Motion and its contributors; Universal Animation Libraries 1 and 2 by Quaternius (CC0 1.0).</p><p>CMU Graphics Lab Motion Capture Database: free to use, copy, modify and redistribute; the data may not be resold, even in converted form.</p><p>The interface uses system fonts. Shardfall's embedded egui fonts include Hack, Noto Emoji, Ubuntu Light and Emoji Icon Font.</p></div><details class=\\\"licenses\\\"><summary>Font license texts</summary>\"'${Object.entries(window.__licenseData || {}).map(([label,text])=>`<h4>${esc(label)}</h4><pre>${esc(text)}</pre>`).join('\"'')}</details><div class=\\\"row\\\">\"'${button('\"'Back to the island','title','primary')}</div>\"'`);\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css\n@@\n .overlay{position:fixed;inset:0;z-index:12;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(23,63,72,.48);box-sizing:border-box}.overlay .panel{max-height:100%;overflow-y:auto}.overlay details{margin-top:20px}.overlay summary{cursor:pointer;font-weight:900}\n+.licenses summary{cursor:pointer;font-weight:900}.licenses pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.5 ui-monospace,monospace}\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py\n@@\n             click(page, \"about\")\n             assert \"Source Information\" in page.locator(\"#app\").inner_text()\n+            assert \"Library credits\" in page.locator(\"#app\").inner_text()\n+            page.locator(\".licenses summary\").click()\n+            assert \"SIL OPEN FONT LICENSE\" in page.locator(\".licenses\").inner_text()\n             click(page, \"title\")\n@@\n         page.keyboard.press(\"ArrowDown\")\n         click(page, \"settings-back\")\n+        click(page, \"about\")\n+        page.locator(\".licenses summary\").click()\n+        page.locator(\".licenses\").scroll_into_view_if_needed()\n+        page.screenshot(path=str(ARTIFACTS / \"iphone-about.png\"))\n+        assert page.evaluate(\"document.documentElement.scrollWidth <= window.innerWidth\")\n+        click(page, \"title\")\n         new_guest(page)\n*** End Patch\nPATCH\npython3 \"$dev/scripts/bundle.py\"'","aggregated_output":"Success. Updated the following files:\nM Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/scripts/bundle.py\nM Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js\nM Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css\nM Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py\n","exit_code":0,"status":"completed"}}
