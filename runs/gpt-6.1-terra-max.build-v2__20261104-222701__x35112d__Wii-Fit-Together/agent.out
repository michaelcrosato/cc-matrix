late-columns:1fr;align-items:end}.island-panel{max-height:69vh}.island-note{display:none}.footer{font-size:10px}.panel-wrap{align-items:center}.cards.three{grid-template-columns:1fr 1fr}.event-center{top:19%;width:90vw}.puck{width:105px;border-width:6px}.event-bottom{max-width:58vw}.hud .pill{font-size:11px}.info-grid{grid-template-columns:1fr}}\n@media(max-height:550px){.screen{padding:14px 24px}.title-layout{align-items:center;padding:0}.title-panel h1{font-size:clamp(42px,7vw,72px);margin:8px 0}.title-panel .lede{font-size:15px;margin:8px 0}.title-actions{margin-top:12px}.button{min-height:42px;padding:9px 14px}.hero-note{margin-bottom:4vh}.panel{padding:20px}.panel h2{font-size:32px}.panel-wrap{padding:8px 0}.event-center{top:12%}.event-center h2{font-size:30px}.event-center p{font-size:16px}.puck{bottom:55px;width:100px}.island-panel{padding:16px;max-height:80vh}.dayline{margin:8px 0}.activity{padding:8px 12px}.section-title{margin:10px 0 5px}}\n  function startRound(id) { const item=eventById(id); if(!item) return; center={x:0,y:0,vx:0,vy:0}; aim={x:0,y:0}; lastHubUpdate=0; lastHubProgress=0; state.paused=false; state.round={...item,instruction:item.controls,elapsed:0,sum:0,samples:0,actionHits:0,actionCount:0,steps:0,lastStep:'',shellX:0,shellY:0,shellVx:0,shellVy:0,potted:0,spin:0,prevAngle:0,gates:0,gateIndex:-1,stillBroken:false,ghostTrail:[]}; setScreen('event'); if(state.together?.online && hub) hub.progress({score:state.together.scores[0],label:`${item.name}: starting`}); }\n  function triggerAction(side='action') {\n    if (!state.round || !['event','check'].includes(state.screen) || state.paused) return;\n    const round=state.round, time=round.elapsed;\n    if (round.id==='finale' && time>60) round.stillBroken=true;\n    round.actionCount++;\n    if (side==='left' || side==='right') { if (round.lastStep!==side) {round.steps++; round.lastStep=side;} }\n    if (round.id==='squat' || round.id==='step' || round.id==='lap' || round.id==='dive' || state.screen==='check') {\n      const interval=round.id==='dive'?1.2:round.id==='step'?.625:.6;\n      const phase=time%interval; if(Math.min(phase,interval-phase)<.22) round.actionHits++;\n      sound(round.id==='dive'?240:420,.09,'sine',.045);\n    } else sound(360,.06,'sine',.03);\n  }\n  function finishCheck() {\n    const round=state.round;\n    const metric=round.metric.map((value,index)=>round.phaseSamples[index] ? value/round.phaseSamples[index] : 0);\n    metric[3]=clamp(round.steps/8,0,1)*.6 + clamp(round.actionHits/8,0,1)*.4;\n    const skill=.30*metric[0]+.25*metric[1]+.25*metric[2]+.20*metric[3];\n    const age=Math.round(clamp(24+56*Math.pow(1-clamp(skill,0,1),1.1)-2*(profileDay()-1)-Math.min((state.profile.stars||0)/3,8),18,99));\n    state.profile.checked=true; state.profile.age=age; save();\n    state.result={isCheck:true,age,stars:skill>.8?3:skill>.5?2:1,comment:'A number! We can put it on a postcard. The important part is that you showed up.'}; voice(); setScreen('result');\n  }\n  function finishRound() {\n    const round=state.round; let score=Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000);\n    if (round.id==='tide') score=Math.round(clamp(round.potted*200+score*.4,0,1000));\n    if (round.id==='paddle') score=Math.round(clamp(round.gates*125+score*.3,0,1000));\n    if (round.id==='dive') score=Math.round(clamp(score*.5+Math.min(round.actionHits,8)*65,0,1000));\n    if (round.id==='finale' && !round.stillBroken) score=Math.min(1000,score+100);\n    const stars=score>=850?3:score>=650?2:score>=400?1:0;\n    let banked=0;\n    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\n    else if (state.profile) { const guest=state.profile; guest.clearedToday=guest.clearedToday||{}; banked=guest.clearedToday[round.id]?1:1+stars; guest.clearedToday[round.id]=true; guest.dayMinutes=(guest.dayMinutes||0)+banked; guest.minutesTotal=(guest.minutesTotal||0)+banked; guest.stars=(guest.stars||0)+stars; guest.bests[round.id]=Math.max(guest.bests[round.id]||0,score); if(round.id==='finale') {guest.finaleDone=true;guest.age=Math.max(18,Math.round((guest.age||60)-score/100));} save(); }\n    state.result={isCheck:false,name:round.name,score,stars,comment:`${titles[Math.min(titles.length-1,Math.floor(score/1000*titles.length))]}. We’ve banked ${state.together?'your points':`${banked} minute${banked===1?'':'s'} in the clam`}.`}; state.paused=false; sound(660,.25,'sine'); voice(); setScreen('result');\n    if(state.together?.online) setTimeout(()=>{if(state.screen==='result' && state.round===round && state.together?.online) advanceResult();},1500);\n  }\n  function advanceResult() {\n    if(!state.together) {setScreen('island');return;}\n    const group=state.together; group.event++;\n    if(group.online) { if(group.event>=3) reportHub(); else {state.eventId=medley[group.event];startRound(state.eventId);} return; }\n    if(group.event>=3) {group.event=0;group.player++;}\n    if(group.player>=group.count) setScreen('podium'); else setScreen('handoff');\n  }\n  function reportHub() { if(!state.together || !state.together.online) return; const score=clamp(Math.round(state.together.scores[0]),0,3000); if(hub && !state.together.reported) {state.together.reported=true;hub.result({score,stats:{events:Math.min(3,state.together.event)},awards:[{name:'Island Enthusiast',description:'Completed the Tippy Cay medley.'}]});} state.message=`Medley complete: ${formatScore(score)} points. Waiting for the group.`;setScreen('waiting'); }\n\n  function updateInput(dt) {\n    let x=(keys.has('arrowright')||keys.has('d')?1:0)-(keys.has('arrowleft')||keys.has('a')?1:0), y=(keys.has('arrowdown')||keys.has('s')?1:0)-(keys.has('arrowup')||keys.has('w')?1:0);\n    let gamepad=null; try { gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean); } catch (_) {}\n    if(gamepad) {\n      const dead=value=>Math.abs(value)<.12?0:Math.sign(value)*Math.pow((Math.abs(value)-.12)/.88,1.5);\n      const gx=dead(gamepad.axes[0]||0), gy=dead(gamepad.axes[1]||0); if(Math.abs(gx)+Math.abs(gy)>.03) {x=gx;y=gy;markInput('gamepad');state.hasHardwareInput=true;}\n      const pressed=gamepad.buttons.map(item=>item.pressed);\n      for(const index of [0,9,12,13,14,15]) if(pressed[index]&&!previousButtons[index]) { markInput('gamepad');state.hasHardwareInput=true; if(index===9){if(['event','check'].includes(state.screen)) selectAction(state.paused?'resume':'pause');} else if(['event','check'].includes(state.screen)&&!state.paused) triggerAction(index===14?'left':index===15?'right':'action'); else if(index===0) { const focused=document.activeElement; if(focused && focused.tagName==='BUTTON') focused.click(); else app.querySelector('button:not([disabled])')?.focus(); } else if([12,13,14,15].includes(index)) moveFocus(index===12||index===14?-1:1); }\n      previousButtons=pressed;\n    }\n    const speed=keys.has('shift')?.5:1;\n    if(x||y) { aim.x=clamp(aim.x+x*1.6*dt*speed,-1,1); aim.y=clamp(aim.y+y*1.6*dt*speed,-1,1); }\n    else if(mouseAim && state.device==='mouse') { aim.x=mouseAim.x;aim.y=mouseAim.y; }\n    else {aim.x=smooth(aim.x,0,1.2,dt);aim.y=smooth(aim.y,0,1.2,dt);}\n    const round=state.round, time=round?.elapsed||0, wobble=state.wobble ?? .12;\n    const targetX=aim.x*.92+wobble*(Math.sin(time*2.13)*.6+Math.sin(time*3.71)*.4), targetY=aim.y*.92+wobble*(Math.sin(time*1.79)*.6+Math.sin(time*3.31)*.4);\n    const stiffness=state.stiffness||40, damping=state.damping||8.5;\n    center.vx+=((targetX-center.x)*stiffness-center.vx*damping)*dt;center.vy+=((targetY-center.y)*stiffness-center.vy*damping)*dt;\n    center.x=clamp(center.x+center.vx*dt,-1.2,1.2);center.y=clamp(center.y+center.vy*dt,-1.2,1.2);\n  }\n  function heldAction() { try { const gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);return mouseHeld||keys.has(' ')||keys.has('enter')||!!gamepad?.buttons[0]?.pressed; } catch (_) { return mouseHeld||keys.has(' '); } }\n  function tickRound(dt) {\n    const round=state.round, online=!!state.together?.online, onlineSettings=online && state.screen==='settings' && state.returnScreen==='event'; if(!round || (state.paused && !online) || (!['event','check'].includes(state.screen) && !onlineSettings)) return;\n    round.elapsed+=dt; const time=round.elapsed;\n    let quality=clamp(1-Math.hypot(center.x,center.y)*.8,0,1), targetX=0,targetY=0, instruction=round.controls;\n    if(state.screen==='check') {\n      const phase=time<8?0:time<23?1:time<29?2:3;round.phase=phase;\n      if(phase===1) {targetX=[-.7,.7,-.7][Math.min(2,Math.floor((time-8)/5))];quality=clamp(1-Math.abs(center.x-targetX),0,1);instruction='Lean into the target ring.';}\n      else if(phase===2) instruction='Eyes closed. Trust the sound and find your center.';\n      else if(phase===3) instruction='Alternate left and right steps to the beat.';\n      else instruction='Stand still. This is the whole test.';\n      round.metric[phase]+=quality;round.phaseSamples[phase]++;\n    } else {\n      if(round.id==='breath') { const inhale=(time%8)<4;quality=(heldAction()===inhale)?1:.15;instruction=inhale?'Breathe in · hold Action':'Breathe out · release Action'; }\n      else if(round.id==='pose') { targetX=Math.sin(time*.58)*.55;targetY=Math.cos(time*.43)*.25;quality=clamp(1-Math.hypot(center.x-targetX,center.y-targetY),0,1);instruction='Follow the drifting ring.'; }\n      else if(round.id==='squat') {quality=clamp(round.actionHits/Math.max(1,time/.6)*1.1,0,1)*.7+quality*.3;instruction='Press Action as the beat lands.';}\n      else if(round.id==='plank') { quality=quality*(heldAction()?1:.35);instruction='Hold Action. Be one with the plank.'; }\n      else if(round.id==='step'||round.id==='lap') {quality=clamp(round.steps/Math.max(1,time/.625),0,1)*.65+clamp(round.actionHits/Math.max(1,round.actionCount),0,1)*.35;instruction='Alternate Left and Right on the beat.';}\n      else if(round.id==='spin') {const angle=Math.atan2(center.y,center.x);let diff=angle-round.prevAngle;while(diff>Math.PI)diff-=Math.PI*2;while(diff<-Math.PI)diff+=Math.PI*2;round.prevAngle=angle;round.spin=smooth(round.spin,Math.abs(diff)/Math.max(dt,.001),3,dt);quality=clamp(round.spin/4,0,1)*(Math.hypot(center.x,center.y)>.25?1:.3);instruction='Circle your lean. Keep the floaties moving!';}\n      else if(round.id==='tide') {round.shellVx=(round.shellVx+center.x*dt*.9)*Math.exp(-1.6*dt);round.shellVy=(round.shellVy+center.y*dt*.9)*Math.exp(-1.6*dt);round.shellX=clamp(round.shellX+round.shellVx*dt,-.9,.9);round.shellY=clamp(round.shellY+round.shellVy*dt,-.9,.9);targetX=Math.sin(round.potted*3)*.6;targetY=Math.cos(round.potted*2)*.55;if(Math.hypot(round.shellX-targetX,round.shellY-targetY)<.16){round.potted++;round.shellX=0;round.shellY=0;sound(780,.12);}quality=clamp(1-Math.hypot(round.shellX-targetX,round.shellY-targetY)*.5,0,1);instruction=`Shells in pools: ${round.potted} · Tilt toward the pool.`;}\n      else if(round.id==='paddle') {targetX=Math.sin(Math.floor(time/4.5)*1.9)*.65;quality=clamp(1-Math.abs(center.x-targetX),0,1);const gate=Math.floor(time/4.5);if(gate!==round.gateIndex){round.gateIndex=gate;if(quality>.63)round.gates++;}instruction=`Gates cleared: ${round.gates} · Steer to the ring.`;}\n      else if(round.id==='tray') {quality=clamp(quality-.08*Math.abs(Math.sin(time*1.7)),0,1);instruction='Keep the smoothies aboard.';}\n      else if(round.id==='dive') {quality=clamp(round.actionHits/Math.max(1,time/1.2)*1.5,0,1)*.7+(heldAction()?.3:0);instruction='Press at the bottom of the bounce; hold to tuck.';}\n      else if(round.id==='finale') {if(time<16){instruction=(time%8)<4?'Breathe in · hold Action':'Breathe out · release Action';quality=(heldAction()===((time%8)<4))?1:.2;}else if(time<36){targetX=Math.sin(time*.5)*.5;quality=clamp(1-Math.abs(center.x-targetX),0,1);instruction='Follow the pose through the breeze.';}else if(time<48){quality=clamp(round.steps/Math.max(1,(time-36)/.625),0,1);instruction='Step with the island marching band.';}else if(time<60){quality*=heldAction()?1:.3;instruction='Brace against the waves. Hold Action.';}else{instruction=time>75?'Press Action to skip? Or simply stay.':'The Long Stillness. Do nothing.';quality=round.stillBroken?.2:1;}}\n      round.sum+=quality;round.samples++;\n    }\n    const dot=document.getElementById('dot'), target=document.getElementById('target');\ndef browser_tests(playwright):\n    for engine in (\"chromium\", \"firefox\", \"webkit\"):\n        browser = getattr(playwright, engine).launch(headless=True)\n\n        def smoke():\n            context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n            assert \"Wii Fit\" in page.title()\n            click(page, \"about\")\n            assert \"Source Information\" in page.locator(\"#app\").inner_text()\n            click(page, \"title\")\n            new_guest(page)\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            page.keyboard.press(\"Escape\")\n            assert status(page)[\"paused\"]\n            page.keyboard.press(\"Escape\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"checked\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            page.keyboard.press(\"Space\")\n            advance(page)\n            assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n            click(page, \"result-next\")\n            page.screenshot(path=str(ARTIFACTS / f\"{engine}-island.png\"))\n            assert not errors, errors\n            context.close()\n\n        test(f\"{engine} guest, check and activity\", smoke)\n        browser.close()\n\n    browser = playwright.chromium.launch(headless=True)\n\n    def stay():\n        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n        new_guest(page)\n        for day, goal in enumerate((3, 5, 7, 9, 0), 1):\n            assert status(page)[\"day\"] == day\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            advance(page)\n            click(page, \"result-next\")\n            for _ in range(goal if day < 5 else 1):\n                if day < 5 and status(page)[\"minutes\"] >= goal:\n                    break\n                click(page, \"intro:finale\" if day == 5 else \"intro:breath\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n            click(page, \"end-day\")\n            click(page, \"sleep\")\n        assert status(page)[\"scene\"] == \"ending\"\n        click(page, \"free-play\")\n        assert status(page)[\"scene\"] == \"island\"\n        page.reload(wait_until=\"domcontentloaded\")\n        page.wait_for_function(\"window.__gameBoot?.ready === true\")\n        click(page, \"slots-continue\")\n        click(page, \"slot:0\")\n        assert status(page)[\"guest\"] == \"Ari\" and status(page)[\"day\"] == 5\n        assert not errors, errors\n        context.close()\n\n    test(\"five-day stay, ending and save persistence\", stay)\n\n    def minute_rewards():\n        context, page, errors = load(browser)\n        new_guest(page)\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\n        for attempt in range(2):\n            before = status(page)[\"minutes\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            earned = status(page)[\"minutes\"] - before\n            assert earned == (1 + status(page)[\"resultStars\"] if attempt == 0 else 1)\n            click(page, \"result-next\")\n        while status(page)[\"minutes\"] < 3:\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            click(page, \"result-next\")\n        click(page, \"end-day\")\n        click(page, \"sleep\")\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\nSOURCE: Wii Fit\n\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\n\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\n\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\n\nResearch: Whether and how much to research is your choice.\n\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-222701].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\n\nTech Stack: Build on https://github.com/michaelcrosato/shardfall/blob/main/START_HERE.md, making a new game on its engine. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\n\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\n\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\n\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\n\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\n\nWorking Environment and deliverable:\nCreate a subfolder called [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-222701] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-222701].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\n\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\n\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\n\nEffort: Spend effort however you see fit.\n\n## This computer\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\n\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\n  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\n- **Not installed:** sox, bun, deno.\n- **Network:** internet works (github.com, registry.npmjs.org).\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \"Target closed\", \"page crashed\" or \"browser has been closed\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\n\n### What this computer doesn't have\n\nNo script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\n\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\n\n### Sharing this computer\n\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\n\n## Goal\n\nBuild an original game inspired by the source.\n\nScope\n\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\n\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\n\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\n\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\n\nNarrative tone: Use a writing style similar to the source’s.\n\n## UI & UX: 10-Foot Controller-First Philosophy\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\n\nDo not use overly dense, web-style data screens.\n\nTouch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.\n\n## Done\nNo TODOs, placeholders, or stubbed features. The demo is complete.\n\n## Source Information\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n- Date: 2026-11-04 22:27:01\n- Source: the work it's based on\n- Plan: the file name of the plan you were given to build from, or none\n- Genre and Perspective: genre and camera perspective used\n- Tech: stack, libraries/engines, with versions if applicable\n- Art Direction: style used\n- Animation: system used\n- Audio: music, sound effects and voice used\n- Online: network features used, or none\n- Testing: testing parameters allowed\n- Research: research done, or none\n- Environment: Codex CLI (headless); Linux\n- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n{\n  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n  \"aiHub\": {\n    \"name\": \"the game's title, as on its title screen\",\n    \"tagline\": \"a few words to go under the title\",\n    \"description\": \"one or two sentences for the catalogue\",\n    \"type\": \"Game, Tech demo or Tool\",\n    \"genre\": \"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\",\n    \"source\": \"the work it's based on, e.g. Moby-Dick\",\n    \"series\": \"its franchise, e.g. Star Fox, or empty\",\n    \"players\": \"how many can play: 1, 1–2 or 1–4\",\n    \"controls\": \"the controls, in one line\",\n    \"tags\": [\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\"]\n  }\n}\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n\nTesting Feedback\n\n- How many issues did testing catch?\n- How many would be considered critical issues / game breaking?\n- What was the most helpful test you ran?\n- What was the least helpful test you ran?\n\nEngine Feedback\n\n- What did you like most about the engine?\n- Did you get stuck or guess wrong?\n- What was the most important thing you had to build yourself?\n- What was the hardest part about using the engine?\n- What did you change in the engine, and why? (none if nothing)\n- If you could change one thing about the engine, what would it be?\n\nPrompt Feedback\n\n- What did you like most about this prompt?\n- What was confusing?\n- What was the hardest thing to do?\n- What would you change in this prompt?\n# Progress\n\n- Title: **Wii Fit Together**, selected uniformly using Node.js `crypto.randomInt` from 50 brainstormed candidates.\n- Deliverable: `Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701.html` in the workspace root; source and development files in the identically named directory.\n- Engine and Hub client acquired; native engine build succeeds. Registered a Tippy Cay scene and deterministic balance spring in Shardfall.\n- The standalone build is bundled. All 24 phone, tablet, desktop and cross-browser viewport launches passed after fixing a startup injection bug.\n- The browser suite passed ten checks, including three engines, the five-day stay, save persistence, the local medley, and 2–4-player AI Hub runs. Two Rust balance-spring tests passed.\n- First-clear and repeat minute rewards now follow the plan. Rebuild the HTML, re-run the changed browser suite, and complete the exit interview.\n- Limitation: the playable presentation and most activity logic are Canvas 2D / JavaScript over a Shardfall hook, not the planned full native 3D engine implementation.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_326","type":"reasoning","text":"**Preparing focused CSS output**"}}
{"type":"item.started","item":{"id":"item_327","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '180,250p' \\\"\"'$dev/web/game.js\"; sed -n '\"'75,165p' \\\"\"'$dev/tests/test_game.py\"; tail -c 2500 \"$dev/web/game.css\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_327","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '180,250p' \\\"\"'$dev/web/game.js\"; sed -n '\"'75,165p' \\\"\"'$dev/tests/test_game.py\"; tail -c 2500 \"$dev/web/game.css\"'","aggregated_output":"    const metric=round.metric.map((value,index)=>round.phaseSamples[index] ? value/round.phaseSamples[index] : 0);\n    metric[3]=clamp(round.steps/8,0,1)*.6 + clamp(round.actionHits/8,0,1)*.4;\n    const skill=.30*metric[0]+.25*metric[1]+.25*metric[2]+.20*metric[3];\n    const age=Math.round(clamp(24+56*Math.pow(1-clamp(skill,0,1),1.1)-2*(profileDay()-1)-Math.min((state.profile.stars||0)/3,8),18,99));\n    state.profile.checked=true; state.profile.age=age; save();\n    state.result={isCheck:true,age,stars:skill>.8?3:skill>.5?2:1,comment:'A number! We can put it on a postcard. The important part is that you showed up.'}; voice(); setScreen('result');\n  }\n  function finishRound() {\n    const round=state.round; let score=Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000);\n    if (round.id==='tide') score=Math.round(clamp(round.potted*200+score*.4,0,1000));\n    if (round.id==='paddle') score=Math.round(clamp(round.gates*125+score*.3,0,1000));\n    if (round.id==='dive') score=Math.round(clamp(score*.5+Math.min(round.actionHits,8)*65,0,1000));\n    if (round.id==='finale' && !round.stillBroken) score=Math.min(1000,score+100);\n    const stars=score>=850?3:score>=650?2:score>=400?1:0;\n    let banked=0;\n    if(state.together) { state.together.scores[state.together.player]+=score; if(state.together.online && hub) hub.progress({score:state.together.scores[0],label:`${round.name}: ${score}`}); }\n    else if (state.profile) { const guest=state.profile; guest.clearedToday=guest.clearedToday||{}; banked=guest.clearedToday[round.id]?1:1+stars; guest.clearedToday[round.id]=true; guest.dayMinutes=(guest.dayMinutes||0)+banked; guest.minutesTotal=(guest.minutesTotal||0)+banked; guest.stars=(guest.stars||0)+stars; guest.bests[round.id]=Math.max(guest.bests[round.id]||0,score); if(round.id==='finale') {guest.finaleDone=true;guest.age=Math.max(18,Math.round((guest.age||60)-score/100));} save(); }\n    state.result={isCheck:false,name:round.name,score,stars,comment:`${titles[Math.min(titles.length-1,Math.floor(score/1000*titles.length))]}. We’ve banked ${state.together?'your points':`${banked} minute${banked===1?'':'s'} in the clam`}.`}; state.paused=false; sound(660,.25,'sine'); voice(); setScreen('result');\n    if(state.together?.online) setTimeout(()=>{if(state.screen==='result' && state.round===round && state.together?.online) advanceResult();},1500);\n  }\n  function advanceResult() {\n    if(!state.together) {setScreen('island');return;}\n    const group=state.together; group.event++;\n    if(group.online) { if(group.event>=3) reportHub(); else {state.eventId=medley[group.event];startRound(state.eventId);} return; }\n    if(group.event>=3) {group.event=0;group.player++;}\n    if(group.player>=group.count) setScreen('podium'); else setScreen('handoff');\n  }\n  function reportHub() { if(!state.together || !state.together.online) return; const score=clamp(Math.round(state.together.scores[0]),0,3000); if(hub && !state.together.reported) {state.together.reported=true;hub.result({score,stats:{events:Math.min(3,state.together.event)},awards:[{name:'Island Enthusiast',description:'Completed the Tippy Cay medley.'}]});} state.message=`Medley complete: ${formatScore(score)} points. Waiting for the group.`;setScreen('waiting'); }\n\n  function updateInput(dt) {\n    let x=(keys.has('arrowright')||keys.has('d')?1:0)-(keys.has('arrowleft')||keys.has('a')?1:0), y=(keys.has('arrowdown')||keys.has('s')?1:0)-(keys.has('arrowup')||keys.has('w')?1:0);\n    let gamepad=null; try { gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean); } catch (_) {}\n    if(gamepad) {\n      const dead=value=>Math.abs(value)<.12?0:Math.sign(value)*Math.pow((Math.abs(value)-.12)/.88,1.5);\n      const gx=dead(gamepad.axes[0]||0), gy=dead(gamepad.axes[1]||0); if(Math.abs(gx)+Math.abs(gy)>.03) {x=gx;y=gy;markInput('gamepad');state.hasHardwareInput=true;}\n      const pressed=gamepad.buttons.map(item=>item.pressed);\n      for(const index of [0,9,12,13,14,15]) if(pressed[index]&&!previousButtons[index]) { markInput('gamepad');state.hasHardwareInput=true; if(index===9){if(['event','check'].includes(state.screen)) selectAction(state.paused?'resume':'pause');} else if(['event','check'].includes(state.screen)&&!state.paused) triggerAction(index===14?'left':index===15?'right':'action'); else if(index===0) { const focused=document.activeElement; if(focused && focused.tagName==='BUTTON') focused.click(); else app.querySelector('button:not([disabled])')?.focus(); } else if([12,13,14,15].includes(index)) moveFocus(index===12||index===14?-1:1); }\n      previousButtons=pressed;\n    }\n    const speed=keys.has('shift')?.5:1;\n    if(x||y) { aim.x=clamp(aim.x+x*1.6*dt*speed,-1,1); aim.y=clamp(aim.y+y*1.6*dt*speed,-1,1); }\n    else if(mouseAim && state.device==='mouse') { aim.x=mouseAim.x;aim.y=mouseAim.y; }\n    else {aim.x=smooth(aim.x,0,1.2,dt);aim.y=smooth(aim.y,0,1.2,dt);}\n    const round=state.round, time=round?.elapsed||0, wobble=state.wobble ?? .12;\n    const targetX=aim.x*.92+wobble*(Math.sin(time*2.13)*.6+Math.sin(time*3.71)*.4), targetY=aim.y*.92+wobble*(Math.sin(time*1.79)*.6+Math.sin(time*3.31)*.4);\n    const stiffness=state.stiffness||40, damping=state.damping||8.5;\n    center.vx+=((targetX-center.x)*stiffness-center.vx*damping)*dt;center.vy+=((targetY-center.y)*stiffness-center.vy*damping)*dt;\n    center.x=clamp(center.x+center.vx*dt,-1.2,1.2);center.y=clamp(center.y+center.vy*dt,-1.2,1.2);\n  }\n  function heldAction() { try { const gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);return mouseHeld||keys.has(' ')||keys.has('enter')||!!gamepad?.buttons[0]?.pressed; } catch (_) { return mouseHeld||keys.has(' '); } }\n  function tickRound(dt) {\n    const round=state.round, online=!!state.together?.online, onlineSettings=online && state.screen==='settings' && state.returnScreen==='event'; if(!round || (state.paused && !online) || (!['event','check'].includes(state.screen) && !onlineSettings)) return;\n    round.elapsed+=dt; const time=round.elapsed;\n    let quality=clamp(1-Math.hypot(center.x,center.y)*.8,0,1), targetX=0,targetY=0, instruction=round.controls;\n    if(state.screen==='check') {\n      const phase=time<8?0:time<23?1:time<29?2:3;round.phase=phase;\n      if(phase===1) {targetX=[-.7,.7,-.7][Math.min(2,Math.floor((time-8)/5))];quality=clamp(1-Math.abs(center.x-targetX),0,1);instruction='Lean into the target ring.';}\n      else if(phase===2) instruction='Eyes closed. Trust the sound and find your center.';\n      else if(phase===3) instruction='Alternate left and right steps to the beat.';\n      else instruction='Stand still. This is the whole test.';\n      round.metric[phase]+=quality;round.phaseSamples[phase]++;\n    } else {\n      if(round.id==='breath') { const inhale=(time%8)<4;quality=(heldAction()===inhale)?1:.15;instruction=inhale?'Breathe in · hold Action':'Breathe out · release Action'; }\n      else if(round.id==='pose') { targetX=Math.sin(time*.58)*.55;targetY=Math.cos(time*.43)*.25;quality=clamp(1-Math.hypot(center.x-targetX,center.y-targetY),0,1);instruction='Follow the drifting ring.'; }\n      else if(round.id==='squat') {quality=clamp(round.actionHits/Math.max(1,time/.6)*1.1,0,1)*.7+quality*.3;instruction='Press Action as the beat lands.';}\n      else if(round.id==='plank') { quality=quality*(heldAction()?1:.35);instruction='Hold Action. Be one with the plank.'; }\n      else if(round.id==='step'||round.id==='lap') {quality=clamp(round.steps/Math.max(1,time/.625),0,1)*.65+clamp(round.actionHits/Math.max(1,round.actionCount),0,1)*.35;instruction='Alternate Left and Right on the beat.';}\n      else if(round.id==='spin') {const angle=Math.atan2(center.y,center.x);let diff=angle-round.prevAngle;while(diff>Math.PI)diff-=Math.PI*2;while(diff<-Math.PI)diff+=Math.PI*2;round.prevAngle=angle;round.spin=smooth(round.spin,Math.abs(diff)/Math.max(dt,.001),3,dt);quality=clamp(round.spin/4,0,1)*(Math.hypot(center.x,center.y)>.25?1:.3);instruction='Circle your lean. Keep the floaties moving!';}\n      else if(round.id==='tide') {round.shellVx=(round.shellVx+center.x*dt*.9)*Math.exp(-1.6*dt);round.shellVy=(round.shellVy+center.y*dt*.9)*Math.exp(-1.6*dt);round.shellX=clamp(round.shellX+round.shellVx*dt,-.9,.9);round.shellY=clamp(round.shellY+round.shellVy*dt,-.9,.9);targetX=Math.sin(round.potted*3)*.6;targetY=Math.cos(round.potted*2)*.55;if(Math.hypot(round.shellX-targetX,round.shellY-targetY)<.16){round.potted++;round.shellX=0;round.shellY=0;sound(780,.12);}quality=clamp(1-Math.hypot(round.shellX-targetX,round.shellY-targetY)*.5,0,1);instruction=`Shells in pools: ${round.potted} · Tilt toward the pool.`;}\n      else if(round.id==='paddle') {targetX=Math.sin(Math.floor(time/4.5)*1.9)*.65;quality=clamp(1-Math.abs(center.x-targetX),0,1);const gate=Math.floor(time/4.5);if(gate!==round.gateIndex){round.gateIndex=gate;if(quality>.63)round.gates++;}instruction=`Gates cleared: ${round.gates} · Steer to the ring.`;}\n      else if(round.id==='tray') {quality=clamp(quality-.08*Math.abs(Math.sin(time*1.7)),0,1);instruction='Keep the smoothies aboard.';}\n            new_guest(page)\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            page.keyboard.press(\"Escape\")\n            assert status(page)[\"paused\"]\n            page.keyboard.press(\"Escape\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"checked\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            page.keyboard.press(\"Space\")\n            advance(page)\n            assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n            click(page, \"result-next\")\n            page.screenshot(path=str(ARTIFACTS / f\"{engine}-island.png\"))\n            assert not errors, errors\n            context.close()\n\n        test(f\"{engine} guest, check and activity\", smoke)\n        browser.close()\n\n    browser = playwright.chromium.launch(headless=True)\n\n    def stay():\n        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n        new_guest(page)\n        for day, goal in enumerate((3, 5, 7, 9, 0), 1):\n            assert status(page)[\"day\"] == day\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            advance(page)\n            click(page, \"result-next\")\n            for _ in range(goal if day < 5 else 1):\n                if day < 5 and status(page)[\"minutes\"] >= goal:\n                    break\n                click(page, \"intro:finale\" if day == 5 else \"intro:breath\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n            click(page, \"end-day\")\n            click(page, \"sleep\")\n        assert status(page)[\"scene\"] == \"ending\"\n        click(page, \"free-play\")\n        assert status(page)[\"scene\"] == \"island\"\n        page.reload(wait_until=\"domcontentloaded\")\n        page.wait_for_function(\"window.__gameBoot?.ready === true\")\n        click(page, \"slots-continue\")\n        click(page, \"slot:0\")\n        assert status(page)[\"guest\"] == \"Ari\" and status(page)[\"day\"] == 5\n        assert not errors, errors\n        context.close()\n\n    test(\"five-day stay, ending and save persistence\", stay)\n\n    def minute_rewards():\n        context, page, errors = load(browser)\n        new_guest(page)\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\n        for attempt in range(2):\n            before = status(page)[\"minutes\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            earned = status(page)[\"minutes\"] - before\n            assert earned == (1 + status(page)[\"resultStars\"] if attempt == 0 else 1)\n            click(page, \"result-next\")\n        while status(page)[\"minutes\"] < 3:\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            click(page, \"result-next\")\n        click(page, \"end-day\")\n        click(page, \"sleep\")\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\n        click(page, \"intro:breath\")\n        click(page, \"begin-event\")\n        advance(page)\n        assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n        assert not errors, errors\n        context.close()\n\n    test(\"first-clear and repeat minute rewards\", minute_rewards)\n\n    def medley():\nground:#ff9478;transition:width .2s}.big-score{font-size:clamp(64px,9vw,110px);font-weight:1000;line-height:.9;letter-spacing:-.07em;color:var(--teal);margin:15px 0}.stars{color:#f6b94d;font-size:34px;letter-spacing:6px}.dialogue{border-left:5px solid #8adbd1;padding-left:16px;font-size:clamp(17px,1.7vw,22px);line-height:1.35;font-weight:800}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-grid div{padding:12px;background:#f2f8ee;border-radius:12px;overflow-wrap:anywhere;font-size:13px;line-height:1.4}.info-grid b{display:block;text-transform:uppercase;font-size:10px;letter-spacing:.1em;color:#498279}.about-list{font-size:13px;line-height:1.5;color:#50716d}.touch-guard{position:fixed;z-index:10;inset:0;background:#cff0e9ed;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}.touch-guard>div{max-width:440px}.touch-guard h2{font-size:clamp(28px,7vw,44px);line-height:1;margin:16px 0}.touch-guard .button{text-align:center}.touch-guard.settings-open{display:none}.attract-label{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);font-weight:1000;color:white;text-align:center;text-shadow:0 2px 7px #226}.hidden{display:none!important}\n@media(max-width:700px){.screen{padding:18px}.title-layout{grid-template-columns:1fr;align-items:start;padding-top:8vh}.title-panel{max-width:400px}.title-panel h1{font-size:clamp(52px,12vw,78px)}.title-panel .lede{max-width:310px}.hero-note{display:none}.title-actions{max-width:360px}.island-layout{grid-template-columns:1fr;align-items:end}.island-panel{max-height:69vh}.island-note{display:none}.footer{font-size:10px}.panel-wrap{align-items:center}.cards.three{grid-template-columns:1fr 1fr}.event-center{top:19%;width:90vw}.puck{width:105px;border-width:6px}.event-bottom{max-width:58vw}.hud .pill{font-size:11px}.info-grid{grid-template-columns:1fr}}\n@media(max-height:550px){.screen{padding:14px 24px}.title-layout{align-items:center;padding:0}.title-panel h1{font-size:clamp(42px,7vw,72px);margin:8px 0}.title-panel .lede{font-size:15px;margin:8px 0}.title-actions{margin-top:12px}.button{min-height:42px;padding:9px 14px}.hero-note{margin-bottom:4vh}.panel{padding:20px}.panel h2{font-size:32px}.panel-wrap{padding:8px 0}.event-center{top:12%}.event-center h2{font-size:30px}.event-center p{font-size:16px}.puck{bottom:55px;width:100px}.island-panel{padding:16px;max-height:80vh}.dayline{margin:8px 0}.activity{padding:8px 12px}.section-title{margin:10px 0 5px}}\n","exit_code":0,"status":"completed"}}
