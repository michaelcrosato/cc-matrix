ver.shutdown()\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py-193-        server.server_close()\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py-194-        thread.join()\n--\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css-1-:root{--ink:#173f48;--muted:#52747a;--paper:#fffdf2;--aqua:#7fe0d8;--teal:#117a79;--coral:#ff826d;--sun:#ffd67b;--line:rgba(23,63,72,.16);font-family:ui-rounded,\"Trebuchet MS\",system-ui,sans-serif;color:var(--ink)}\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css:2:html,body{background:#a7e8e5}body{overflow:hidden}#msg,#turn{display:none!important}body>canvas:not(#world){position:fixed!important;inset:0;z-index:-2;pointer-events:none}#world{position:fixed;inset:0;z-index:0;display:block;width:100vw!important;height:100vh!important;height:100dvh!important;pointer-events:none}#app{position:fixed;inset:0;z-index:2;overflow:hidden}button{font:inherit;color:inherit;cursor:pointer}button:focus-visible{outline:4px solid #ffca66;outline-offset:3px}.screen{height:100%;box-sizing:border-box;padding:clamp(18px,3.2vw,54px);display:flex;flex-direction:column}.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex:none}.logo{font-size:14px;font-weight:1000;letter-spacing:.14em;text-transform:uppercase}.logo i{font-style:normal;color:#ec765f}.pill,.eyebrow{display:inline-flex;align-items:center;gap:8px;border-radius:999px;font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.pill{padding:10px 14px;background:rgba(255,253,242,.84);box-shadow:0 3px 0 rgba(25,90,91,.12)}.eyebrow{color:#087e7a}.sun-dot{width:9px;height:9px;border-radius:50%;background:#ffab65}.title-layout{flex:1;min-height:0;display:grid;grid-template-columns:minmax(300px,520px) 1fr;align-items:center;gap:3vw}.title-panel{max-width:530px}.overline{font-size:clamp(11px,1vw,15px);font-weight:900;letter-spacing:.2em;text-transform:uppercase;color:#1c7775}.title-panel h1,.headline{font-size:clamp(50px,7vw,102px);line-height:.88;letter-spacing:-.065em;margin:18px 0 20px;font-weight:1000}.title-panel h1 span{color:#f67862}.lede{font-size:clamp(16px,1.45vw,21px);line-height:1.38;max-width:450px;font-weight:650}.title-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:26px;max-width:470px}.button{border:0;border-radius:15px;min-height:52px;padding:13px 18px;background:var(--paper);box-shadow:0 5px 0 rgba(17,91,91,.16);font-weight:900;text-align:left;transition:transform .13s,box-shadow .13s,background .13s}.button:hover,.button:focus-visible{transform:translateY(-2px);box-shadow:0 7px 0 rgba(17,91,91,.18)}.button:active{transform:translateY(3px);box-shadow:0 2px 0 rgba(17,91,91,.16)}.button.primary{background:var(--ink);color:white}.button.coral{background:var(--coral);color:#fff}.button:disabled{opacity:.45;cursor:default}.button small{display:block;font-size:11px;letter-spacing:.02em;font-weight:700;opacity:.7;margin-top:3px}.footer{flex:none;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:12px;font-weight:800;letter-spacing:.04em}.footer .hint{background:rgba(255,253,242,.72);padding:9px 12px;border-radius:999px}.hero-note{justify-self:end;align-self:end;margin:0 1vw 9vh 0;max-width:220px;transform:rotate(4deg);background:#fff9d7;padding:16px 20px;border-radius:4px 16px 16px 16px;box-shadow:0 6px 25px #287d7a29;font-weight:900;line-height:1.25}.hero-note b{display:block;font-size:12px;color:#e07965;letter-spacing:.12em;text-transform:uppercase;margin-bottom:7px}.panel-wrap{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:18px 0}.panel{background:rgba(255,253,242,.96);border:1px solid #fff;border-radius:26px;box-shadow:0 18px 60px #1d686b27;max-height:100%;overflow:auto;box-sizing:border-box;padding:clamp(20px,3vw,42px);width:min(900px,100%);scrollbar-color:#9acdc5 transparent}.panel.narrow{width:min(620px,100%)}.panel h2{font-size:clamp(30px,3.4vw,52px);line-height:1;letter-spacing:-.045em;margin:9px 0 10px}.panel p{line-height:1.4;margin:8px 0 18px;color:var(--muted);font-weight:650}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:20px;margin-bottom:16px}.close{background:#edf6ec;border:0;border-radius:50%;width:42px;height:42px;font-size:23px;font-weight:800;flex:none}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.cards.three{grid-template-columns:repeat(3,minmax(0,1fr))}.card{min-width:0;border:1px solid #dce9df;border-radius:17px;background:#f6faf1;padding:16px;text-align:left}.card strong{font-size:18px;display:block;line-height:1.1}.card small{display:block;margin-top:7px;font-size:12px;line-height:1.3;color:#638079;font-weight:700}.card:hover,.card:focus-visible{border-color:#ffad7a;background:#fff6e4}.card.selected{border:3px solid var(--teal);padding:14px}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.row>.button{flex:1}.field{display:block;font-size:13px;font-weight:900;margin:14px 0}.field select,.field input{display:block;box-sizing:border-box;width:100%;margin-top:6px;border:1px solid #cfdfd8;border-radius:12px;background:white;padding:12px;font:inherit;color:var(--ink)}.swatches{display:flex;gap:10px;flex-wrap:wrap;margin:9px 0 17px}.swatch{width:40px;height:40px;border:3px solid white;border-radius:50%;box-shadow:0 0 0 1px #aac8bf}.swatch.selected{box-shadow:0 0 0 3px var(--teal)}.section-title{font-size:12px;font-weight:1000;letter-spacing:.13em;text-transform:uppercase;color:#61817d;margin:18px 0 9px}.island-layout{display:grid;grid-template-columns:minmax(280px,370px) 1fr;gap:20px;flex:1;min-height:0;align-items:center}.island-panel{background:rgba(255,253,242,.95);border-radius:24px;padding:clamp(20px,2.2vw,32px);max-height:100%;overflow:auto;box-shadow:0 15px 50px #2d797929}.island-panel h2{font-size:clamp(30px,3.1vw,46px);line-height:1;letter-spacing:-.05em;margin:9px 0}.dayline{display:flex;gap:6px;margin:16px 0}.dayline span{height:8px;flex:1;border-radius:10px;background:#d7e6db}.dayline span.done{background:#27a69b}.dayline span.current{background:#ff9c7e}.activity-list{display:grid;gap:8px}.activity{width:100%;border:0;background:#eaf6ed;border-radius:13px;padding:12px 14px;text-align:left;font-weight:900;display:flex;align-items:center;justify-content:space-between;gap:8px}.activity small{font-size:11px;font-weight:800;color:#66827c}.activity:hover,.activity:focus-visible{background:#fff0d4}.island-note{align-self:end;justify-self:end;background:#fff9df;border-radius:16px;padding:16px 20px;max-width:245px;font-weight:800;box-shadow:0 9px 30px #1c656020}.hud{display:flex;justify-content:space-between;gap:12px;align-items:start}.hud .pill{font-size:14px}.event-center{position:absolute;top:17%;left:50%;transform:translateX(-50%);width:min(680px,80vw);text-align:center;pointer-events:none}.event-center h2{font-size:clamp(28px,4.2vw,60px);line-height:1;margin:10px 0;color:white;text-shadow:0 3px 14px #155c6080;letter-spacing:-.04em}.event-center p{font-size:clamp(16px,1.8vw,24px);font-weight:900;color:white;text-shadow:0 2px 8px #155c60}.puck{position:absolute;right:clamp(20px,4vw,70px);bottom:clamp(70px,11vh,120px);width:clamp(110px,14vw,185px);aspect-ratio:1;border:9px solid #fffefa;border-radius:50%;background:#245c6688;box-shadow:0 7px 0 #1a585b28, inset 0 0 0 2px #fff5}.puck:before,.puck:after{content:\"\";position:absolute;background:#ffffff55}.puck:before{left:50%;top:8%;width:1px;height:84%}.puck:after{top:50%;left:8%;height:1px;width:84%}.puck .target{position:absolute;left:50%;top:50%;width:24%;height:24%;transform:translate(-50%,-50%);border:2px dashed #fff9;border-radius:50%}.puck .dot{position:absolute;left:50%;top:50%;width:15%;height:15%;border-radius:50%;background:#ffe378;border:3px solid white;box-shadow:0 2px 6px #124b4d66;transform:translate(-50%,-50%)}.event-bottom{position:absolute;bottom:clamp(18px,3vw,40px);left:clamp(18px,3.2vw,54px);display:flex;gap:10px;align-items:center;flex-wrap:wrap}.meter{height:12px;border-radius:99px;background:#d9e8dd;overflow:hidden}.meter>span{display:block;height:100%;border-radius:inherit;background:#ff9478;transition:width .2s}.big-score{font-size:clamp(64px,9vw,110px);font-weight:1000;line-height:.9;letter-spacing:-.07em;color:var(--teal);margin:15px 0}.stars{color:#f6b94d;font-size:34px;letter-spacing:6px}.dialogue{border-left:5px solid #8adbd1;padding-left:16px;font-size:clamp(17px,1.7vw,22px);line-height:1.35;font-weight:800}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-grid div{padding:12px;background:#f2f8ee;border-radius:12px;overflow-wrap:anywhere;font-size:13px;line-height:1.4}.info-grid b{display:block;text-transform:uppercase;font-size:10px;letter-spacing:.1em;color:#498279}.about-list{font-size:13px;line-height:1.5;color:#50716d}.touch-guard{position:fixed;z-index:10;inset:0;background:#cff0e9ed;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}.touch-guard>div{max-width:440px}.touch-guard h2{font-size:clamp(28px,7vw,44px);line-height:1;margin:16px 0}.touch-guard .button{text-align:center}.touch-guard.settings-open{display:none}.attract-label{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);font-weight:1000;color:white;text-align:center;text-shadow:0 2px 7px #226}.hidden{display:none!important}\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css-3-@media(max-width:700px){.screen{padding:18px}.title-layout{grid-template-columns:1fr;align-items:start;padding-top:8vh}.title-panel{max-width:400px}.title-panel h1{font-size:clamp(52px,12vw,78px)}.title-panel .lede{max-width:310px}.hero-note{display:none}.title-actions{max-width:360px}.island-layout{grid-template-columns:1fr;align-items:end}.island-panel{max-height:69vh}.island-note{display:none}.footer{font-size:10px}.panel-wrap{align-items:center}.cards.three{grid-template-columns:1fr 1fr}.event-center{top:19%;width:90vw}.puck{width:105px;border-width:6px}.event-bottom{max-width:58vw}.hud .pill{font-size:11px}.info-grid{grid-template-columns:1fr}}\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css-4-@media(max-height:550px){.screen{padding:14px 24px}.title-layout{align-items:center;padding:0}.title-panel h1{font-size:clamp(42px,7vw,72px);margin:8px 0}.title-panel .lede{font-size:15px;margin:8px 0}.title-actions{margin-top:12px}.button{min-height:42px;padding:9px 14px}.hero-note{margin-bottom:4vh}.panel{padding:20px}.panel h2{font-size:32px}.panel-wrap{padding:8px 0}.event-center{top:12%}.event-center h2{font-size:30px}.event-center p{font-size:16px}.puck{bottom:55px;width:100px}.island-panel{padding:16px;max-height:80vh}.dayline{margin:8px 0}.activity{padding:8px 12px}.section-title{margin:10px 0 5px}}\n--\nPLAN.md-6-\nPLAN.md-7-- **Your brief** means the brief in your own working folder. It wins on the title method, file and folder names, dates, the deliverables and the feedback questions. This plan names none of them.\nPLAN.md-8-- **Paths** are relative to the dev folder your brief tells you to create. Clone the engine to `engine/` inside it.\nPLAN.md-9-- **Numbers** are starting values. Tune them with the dev sliders and the bot. The structure is decided; change it only if it fails in play.\nPLAN.md-10-- **Gaps:** if something is not covered, decide, write one line in `notes/decisions.md`, and carry on.\nPLAN.md:11:- **Verified** means it was run on this computer on 2026-11-04, against engine commit `49ef2ba` and AI Hub client 1.4.0. Section 15 lists those results.\nPLAN.md-12-- **Title:** pick it first, the way your brief says. Keep it in one constant. This plan calls it \"the game\". The resort's name, Tippy Cay, belongs to the world and does not depend on the title.\nPLAN.md-13-- **Reading cost:** you do not need to read the engine's source to start. Read `engine/docs/MAKE_A_GAME.md` whole (about 3k tokens) and `engine/crates/pav_core/src/games/starter.rs`, then use this plan. Search `engine/docs/REFERENCE.md` and `engine/docs/ASSET_STUDIO.md` when you need a tool or a prop field.\nPLAN.md-14-\nPLAN.md-15-## 1. The game in one page\nPLAN.md-16-\n--\nPLAN.md-27-| Equipment that talks: cheerful, polite, quietly rude | Pip, a talking wobble cushion, plus a whole staff of talking gear |\nPLAN.md-28-| A calm, uncanny instructor | Posey, a faceless wooden artist's mannequin |\nPLAN.md-29-| Four disciplines: yoga, strength, aerobics, balance games | Four pavilions, each with its own coach and events |\nPLAN.md-30-| The daily ritual: calendar stamps, banked minutes that unlock more | Calendar stamps and the Minute Clam |\nPLAN.md-31-| Noticing how long you stayed away | Real-date absence comments from Pip |\nPLAN.md:32:| A family sharing one board and comparing progress | Hot-seat Medley, Yesterday You ghosts, AI Hub sessions |\nPLAN.md-33-| Clean, quiet, pastel, unintentionally funny | High-key pastel look, gentle lounge music, short deadpan text |\nPLAN.md-34-\nPLAN.md-35-**Pillars.** Check every decision against these.\nPLAN.md-36-1. **Small movements, big consequences.** Mastery means doing less. The best moments are held breaths.\nPLAN.md-37-2. **Deadpan encouragement.** Everything you do is commented on, kindly, and slightly too honestly.\n--\nPLAN.md-87-| Schedule | Triangle | Tab | |\nPLAN.md-88-| Island camera | Right stick | | Right-drag, wheel zooms |\nPLAN.md-89-| Pause | Options | Esc | |\nPLAN.md-90-| Menus | D-pad or left stick, Cross confirms, Circle backs, L1/R1 change tabs | Arrows or W A S D, Enter or Space, Esc backs, Q/E change tabs | Hover moves focus, click activates, right-click backs |\nPLAN.md-91-\nPLAN.md:92:Xbox glyphs (Settings option) swap A B X Y, LB RB LT RT, Menu. Ignore Options while Create is held: that pair belongs to the AI Hub. Disable the engine's own keys (F1 to F10, digits, H, Backspace rewind, right-drag tilt) outside dev mode. Keep F11 for fullscreen.\nPLAN.md-93-\nPLAN.md-94-## 4. The Balance Core\nPLAN.md-95-\nPLAN.md-96-One struct, `BalanceCore`, used by every event. Its state is `cob` (the dot, unit disc, x right, y up on screen) and `vel`.\nPLAN.md-97-\n--\nPLAN.md-312-- **Buses:** music, sfx and voice, each a gain applied per voice in `Mixer::render`. Settings defaults: **music 10%** as your brief requires (0.10 linear), sfx 80%, voice 80%.\nPLAN.md-313-- **New events:** add `SimEvent` variants `Sfx { id, gain, pitch }`, `Syllable { speaker, vowel, pitch }`, `Music { song }`, `BigSplash { pos, size }`. `pav_audio::sounds_for` is a closed match; add arms there.\nPLAN.md-314-- **Sequencer:** `pav_audio/src/music.rs`, running inside `Mixer::render` so timing is sample-accurate. A song is BPM, steps per beat and tracks of patch plus pattern, written by hand as arrays of scale degrees over a chord progression. Add a low-pass LFO patch option for pads.\nPLAN.md-315-- **Rhythm clock:** the mixer counts rendered samples in an atomic. `pav_app` reads it, runs a small phase-locked clock (`clock += dt; clock += (audio_pos - clock) * 0.05`), subtracts a latency offset (default 0.10 s, Settings: Rhythm Offset), and sends it as `InputFrame.song_pos`. The sim uses `song_pos` when present, its own tick time otherwise. Replays and tests stay deterministic, because the value is part of the recorded input.\nPLAN.md-316-- **Latency:** cpal's web backend defaults to 2048 frames per buffer, about 43 ms (read in its source, not measured on a real device). Try `BufferSize::Fixed(1024)` in `AudioOut::start` for snappier effects.\nPLAN.md:317:- **Autoplay:** `resume_audio` runs on key, mouse and touch only. Also call it on the first gamepad activity. Attract mode is silent until a real input arrives; that is expected.\nPLAN.md-318-\nPLAN.md-319-| Song | Where | Feel (all original) |\nPLAN.md-320-|---|---|---|\nPLAN.md-321-| 1 Lobby Bossa | Title, island | 84 BPM, soft nylon-like pluck, brushed noise, walking bass: resort lounge, not gym |\nPLAN.md-322-| 2 Tide Pad | Stillness | Slow pads and sparse bells, no beat |\n--\nPLAN.md-356-| About | Pages for each block your brief requires (section 18) |\nPLAN.md-357-| Play Together | Choose 2 to 4 guests, pass-the-pad interstitial, podium |\nPLAN.md-358-\nPLAN.md-359-**Mouse in the world:** on the island `InputFrame.aim` already holds the cursor's ground point. The nearest interactable within 1.2 m of it gets a highlight ring; clicking walks there with `NavGrid::path`, then interacts. Clicking open ground walks there.\nPLAN.md-360-\nPLAN.md:361:**Touch-only devices:** detect with `matchMedia('(pointer: coarse)')`, no `(any-pointer: fine)`, and no gamepad or key seen yet. Show a centred card \"Controller or keyboard required\" and a Settings button (tap works; Settings is usable by tap). No touch controls: skip Shardfall's `touch.draw` for this game, and route touches directly to egui in `on_touch`, because the engine's touch layer otherwise treats a finger as a stick. Attract mode runs behind the card. Remove the phone-rotation hint and fullscreen-on-tap from `web/index.html`. If a pad connects or a key is pressed, drop the card and start normally. A touch device without WebGPU cannot run the game at all, so the page's own fallback message there says both things: \"Controller or keyboard required\" and that the game needs WebGPU.\nPLAN.md-362-\nPLAN.md-363-**Dev Mode** (from Pause, not shown in hub sessions). Big rows, pad-navigable, in tabs:\nPLAN.md-364-- **Jump:** any day, any event, any finale phase, attract, medley.\nPLAN.md-365-- **Cheats:** no tips, autoplay with the bot, give minutes, unlock all, all stars, skip dialogue, win or lose this event now.\nPLAN.md-366-- **Time:** scale 0.25x to 4x, pause, single step (`TimeControl`).\n--\nPLAN.md-374-\nPLAN.md-375-Use the same event code with the bot replacing input in `pre`. No separate replay system.\nPLAN.md-376-\nPLAN.md-377-## 13. Multiplayer\nPLAN.md-378-\nPLAN.md:379:**AI Hub session: mode `ghost`, 1 to 4 players.** Follow `lib/hub/README.md` in `michaelcrosato/ai-hub`. `ghost` is the choice because seeing friends wobble on the next mat is the fun of it, and it is barely more work than `parallel`; `shared-world` would need a host-run world this game does not need. Download `session.js`, `harness.html`, `bridge.js` and `round.js` from `https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/` to `hub/`; these URLs work without auth (verified).\nPLAN.md-380-\nPLAN.md-381-**The round, the Inter-Resort Medley:** Paddle Slalom, Tide Table, Cannonball Cup, one after another, about 2 minutes, then final score = sum of the three event scores (0 to 3000), reported as `AIHub.result({ score, stats, awards })`. The same seed on every copy gives the same course. On a copy, other players appear as seat-coloured figures with their names in the same event: in another lane or on a neighbouring raft or board. They affect nothing. Use the hub's own card: do not pass `card: true`.\nPLAN.md-382-\nPLAN.md-383-In a session there is no title, menu or attract. The game opens straight into the round. Pause shows only Resume and Settings; the world keeps running, because the hub's clock does. Quit, restart and dev mode do not exist there.\nPLAN.md-384-\n--\nPLAN.md-531-- Chromium flags that work: `--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-angle=swiftshader`. The set with `--use-webgpu-adapter=swiftshader` also works. Only Chromium has WebGPU here: Firefox and WebKit show the page's no-WebGPU message.\nPLAN.md-532-- Run your own Playwright scripts with plain `python3`. `python3 -I` cannot import Playwright here (verified).\nPLAN.md-533-- **Server port through a pipe:** `python3 -m http.server 0` buffers its \"port\" line when piped, and a script reading it hangs forever. Use `python3 -u -m http.server 0 --bind 127.0.0.1 --directory <dir>`. Stop only that PID, from a `finally` and a SIGTERM handler.\nPLAN.md-534-- **Controller stub (verified: gilrs reads it, stick moves the player, Cross registers):**\nPLAN.md-535-```js\nPLAN.md:536:const btn = () => ({ pressed: false, touched: false, value: 0 });\nPLAN.md-537-const pad = { id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: 0, connected: true, mapping: 'standard', timestamp: 1,\nPLAN.md-538-              axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, btn) };\nPLAN.md-539-navigator.getGamepads = () => [pad, null, null, null];\nPLAN.md:540:window.__setPad = (axes, pressed) => { pad.axes = axes; pad.timestamp++; pad.buttons.forEach((b, i) => { const on = pressed.includes(i); b.pressed = on; b.touched = on; b.value = on ? 1 : 0; }); };\nPLAN.md-541-```\nPLAN.md-542-- **Measuring sound (verified):** cpal plays `AudioBufferSourceNode`s, so patch `AudioBufferSourceNode.prototype.start` in an init script, read `this.buffer.getChannelData(0)`, and accumulate RMS and peak. Sample rate 48000; context `running` after a click.\nPLAN.md-543-\nPLAN.md-544-Engine:\nPLAN.md-545-- `egui::Context::set_fonts` takes effect next pass; using a font family in the same pass panics \"not bound to any fonts\". Install fonts before the first `run_ui`, in `App::new` and in `Headless::frame`, which makes a new context per frame. In the browser that panic stopped the frame loop with nothing on the page to say so: `__gameStatus` simply stopped changing (verified). Log console errors and assert that the tick advances in every browser test.\n--\nPLAN.md-569-- Snapshot, rewind and replay exactness (copy `crates/pav_core/tests/games.rs`).\nPLAN.md-570-- UI: `Headless::frame` readings show the right prompts per device and glyph setting; no text under the size rule (enforce in the draw helper).\nPLAN.md-571-- Audio: music at 10% is 0.10 of full-scale render; every SFX and song is non-silent; speakers differ.\nPLAN.md-572-- Content lint: no `TODO` or placeholder text in `script.toml`, and every event has a card, rules and a bot.\nPLAN.md-573-\nPLAN.md:574:**`browser` (Playwright, one browser, 320x180, `file://`):** boots with no errors; `__gameStatus` appears; the pad stub moves focus and confirms; keyboard does the same; mouse hover moves focus and click activates, using rects the UI publishes in `window.__gameUi`; prompts switch with the device; Settings has the Xbox option; attract starts after 10 s and any input exits it; music reaches about 10% by the sound patch. Touch: Chromium with a phone and a tablet profile (it has WebGPU) must show \"Controller or keyboard required\", run attract, and respond to a Settings tap by `page.touchscreen.tap`. WebKit with an iPhone profile, which has no WebGPU here, must show the fallback message from section 11.\nPLAN.md-575-\nPLAN.md-576-**`hub`:** copy the page and `harness.html`, `bridge.js`, `round.js` into one served folder, open `harness.html?game=<page>&players=N&auto=1`, wait for `document.body.dataset.complete === \"true\"`, and require `window.__hubCheck.pass`. Run 2 players; 3 and 4 players with `latency=150&jitter=50&loss=5`; and `scenario=host-leave`. Then a solo check like the hub's: open outside a session, press Enter and Space, expect no errors, `AIHub.active` false, and `Math.random` not seeded. Also byte-compare the pasted client with `hub/session.js`.\nPLAN.md-577-\nPLAN.md-578-**Second player:** the harness's copies, the only multi-player check possible on one computer. **TV:** judge 1920x1080 `pav capture`s.\nPLAN.md-579-\n--\nPLAN.md-588-3. **First slice.** Balance Core, Puck, tilt, `studio` set, Pose Parade, event card and result, bot, one result screen in full art. Play it by bot and capture it. Tune until a ring streak feels good.\nPLAN.md-589-4. **Island and voice.** `hub` set and props, walking, interactables, dialogue with syllables, audio buses, Lobby Bossa, Pip, the Morning Check, Balance Age, Calendar, Clam.\nPLAN.md-590-5. **Events** in this order: Cannonball Cup, Paddle Slalom, Tide Table, Tempo Squats, Breath Bloom, Step Party (with sequencer and rhythm clock), Morning Lap, Plank Standoff, Floatie Spin, Tray Trek.\nPLAN.md-591-6. **Meta.** Days, unlocks, titles, wardrobe, flip-flops, Yesterday You, absence comments, all songs and SFX.\nPLAN.md-592-7. **Finale and endings.** Big Stand, both endings, credits, Free Play.\nPLAN.md:593:8. **Shell.** Attract, Settings, Dev Mode, touch-only card, How to Play, About.\nPLAN.md-594-9. **Multiplayer.** Full Medley, hub ghosts in every lane, Play Together.\nPLAN.md-595-10. **Polish.** Write the script to full length, feel pass on every event using the sliders, extra set dressing, particles, transitions, stingers.\nPLAN.md-596-11. **Finish** (section 18).\nPLAN.md-597-\nPLAN.md-598-**If time runs short,** cut in this order and remove all traces, leaving no stubs: Tray Trek, Floatie Spin, Plank Standoff. The roster, day table, attract list and Schedule all read from data, so a removed event leaves no hole; move its day's minute goal down to match. Everything else is required. Nothing may ship half-working; your brief says no TODOs, placeholders or stubs.\n--\nPLAN.md-619-| Audio in code, gibberish voices, music at 10% | 10, 16 |\nPLAN.md-620-| Online and multiplayer, in the hub and on its own | 13, 16 |\nPLAN.md-621-| Dev folder, bundling, shared machine, ports and processes | 0, 15, 16; your brief has the rules |\nPLAN.md-622-| Performance out of scope, as much detail as the scene needs | 8, 15 |\nPLAN.md-623-| One test command, scripted playthrough, screenshots only when needed, no review agents | 16 |\nPLAN.md:624:| Stand-ins: pad, touch, sound, second player, iPhone, TV | 15, 16 |\nPLAN.md-625-| Original game, feature-complete vertical slice, extendable with normal tools | 1, 14 (all data in TOML, JSON clips and props; `README.md` explains adding an event, a set and a song) |\nPLAN.md-626-| Dev mode from pause, live sliders, reset | 11 |\nPLAN.md-627-| Attract mode | 12 |\nPLAN.md-628-| Narrative tone | 7 |\nPLAN.md:629:| 10-foot, controller-first, native keyboard and mouse, glyphs, Xbox option, no dense screens | 3, 11 |\nPLAN.md-630-| Touch-only behaviour | 11, 12 |\nPLAN.md-631-| No TODOs or stubs | 16, 17 |\nPLAN.md-632-| Source Information and all feedback in chat and on About, exit interview | 11, 14, 18 |\n--\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-57-\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-58-  function render() {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-59-    let html = '';\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-60-    if (state.screen === 'title') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-61-      const hasSave = (saved.slots || []).some(Boolean);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:62:      html = shell(`<div class=\"title-layout\"><section class=\"title-panel\"><div class=\"overline\">A rather uplifting island escape</div><h1>Wii Fit<br><span>Together.</span></h1><p class=\"lede\">Welcome to Tippy Cay, where the sea is calm, the company is questionable, and balance is a journey.</p><div class=\"title-actions\">${button('New Stay','slots-new','primary','A five-day island adventure')}${button('Continue','slots-continue','',hasSave?'Welcome back to the island':'Choose a guest to continue')}${button('Play Together','together','coral','Local or AI Hub medley')}${button('Settings','settings','', 'Controls, sound & accessibility')}</div></section><aside class=\"hero-note\"><b>A note from Pip</b>“We believe in you.<br>Gravity has declined to comment.”</aside></div><div class=\"footer\"><span>✳ AN ORIGINAL TIPPY CAY GETAWAY</span><div><button class=\"pill\" data-action=\"about\">About this game</button> <span class=\"hint\">WASD / arrows · Space · Controller</span></div></div>`, 'THE ISLAND IS OPEN');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-63-    } else if (state.screen === 'slots') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-64-      const slots = saved.slots || [null,null,null,null];\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-65-      html = modal(state.slotMode === 'new' ? 'Choose a guest' : 'Welcome back', 'THE GUEST BOOK', `<p>Every guest gets a little corner of the island. Choose an empty book to begin.</p><div class=\"cards\">${slots.map((guest,index) => `<button class=\"card\" data-action=\"slot:${index}\"><strong>${guest ? esc(guest.name) : 'Guest '+(index+1)+' · Empty'}</strong><small>${guest ? `Day ${guest.day} · ${guest.minutesTotal || 0} minutes banked` : 'Ready for a new stay'}</small></button>`).join('')}</div><p class=\"tiny\">Your progress stays in this browser on this device.</p>`);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-66-    } else if (state.screen === 'customize') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-67-      html = modal('Make yourself at home','YOUR ISLAND LOOK', `<p>Pick a name and an outfit. Your look is always welcome here.</p><label class=\"field\">Guest name<select id=\"guest-name\">${names.map(name=>`<option ${name === state.setup.name ? 'selected' : ''}>${name}</option>`).join('')}</select></label><div class=\"field\">Skin tone<div class=\"swatches\">${skins.map((color,index)=>`<button class=\"swatch ${index===state.setup.skin?'selected':''}\" style=\"background:${color}\" data-action=\"skin:${index}\" aria-label=\"Skin tone ${index+1}\"></button>`).join('')}</div></div><div class=\"field\">Outfit color<div class=\"swatches\">${outfits.map((color,index)=>`<button class=\"swatch ${index===state.setup.outfit?'selected':''}\" style=\"background:${color}\" data-action=\"outfit:${index}\" aria-label=\"Outfit color ${index+1}\"></button>`).join('')}</div></div><div class=\"row\">${button('Back','slots-new')}${button('Arrive on the island','create-guest','primary')}</div>`, 'slots-new');\n--\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-74-    } else if (state.screen === 'calendar') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-75-      const guest=state.profile;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-76-      html = modal('Your island log','THE GUEST BOOK', `<p>Every visit is worth a stamp. Your best moments stay right here.</p><div class=\"cards\">${[1,2,3,4,5].map(day=>`<div class=\"card\"><strong>${day < guest.day || guest.freePlay ? '✓' : '○'} Day ${day}</strong><small>${day===guest.day&&!guest.freePlay?'Currently exploring':day < guest.day || guest.freePlay?'A day well spent':'A day to look forward to'}</small></div>`).join('')}</div><p>Balance Age: <strong>${guest.age ?? 'not checked yet'}</strong> · Total: <strong>${guest.minutesTotal || 0} minutes</strong></p><div class=\"row\">${button('Back to the island','island','primary')}</div>`, 'island');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-77-    } else if (state.screen === 'eventIntro') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-78-      const item=eventById(state.eventId);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:79:      html = modal(item.name, `${esc(item.place.toUpperCase())} · WITH ${esc(item.coach.toUpperCase())}`, `<div class=\"dialogue\"><span class=\"speaker\">${esc(item.coach.toUpperCase())} SAYS</span><p>“${esc(item.description)}”</p></div><p><strong>How to play:</strong> ${esc(item.controls)}</p><p>Move with WASD, arrows, a controller stick, or your mouse. Action is Space, Enter, controller south button, or click.</p><div class=\"row\">${button('Not yet','cancel-event')}${button('I’m ready','begin-event','primary')}</div>`, 'cancel-event');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-80-    } else if (state.screen === 'checkIntro') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-81-      html = modal('Morning Wobble Check','PIP · RECEPTION CUSHION', `<div class=\"dialogue\"><p>“This is not a test of your worth. It is a test of whether the dot stays near the middle.”</p></div><p>Four little checks: stand still, lean toward targets, close your eyes, and alternate steps. Your Balance Age is a playful score, not medical advice.</p><div class=\"row\">${button('Back','island')}${button('Begin the check','begin-check','primary')}</div>`, 'island');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-82-    } else if (state.screen === 'event' || state.screen === 'check') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-83-      const round=state.round;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-84-      html = shell(`<div class=\"hud\"><div><div class=\"eyebrow\">${esc(round.place.toUpperCase())}</div><h2 id=\"round-name\">${esc(round.name)}</h2><div id=\"round-subtitle\">${esc(round.instruction)}</div></div><div class=\"hud-right\"><div class=\"pill\" id=\"timer\">${Math.ceil(round.length)}s</div><button class=\"pill\" data-action=\"pause\">Ⅱ Pause</button></div></div><div class=\"event-center\"><div class=\"phase-card\" id=\"phase-card\">${esc(round.instruction)}</div></div><div class=\"event-bottom\"><div class=\"puck\" aria-label=\"Balance puck\"><div class=\"target\" id=\"target\"></div><div class=\"dot\" id=\"dot\"></div></div><div class=\"meter\"><div><strong id=\"round-score\">0</strong> <span id=\"score-label\">POINTS</span></div><div class=\"meter-track\"><div id=\"meter-fill\"></div></div><small id=\"round-help\">${esc(round.controls)}</small></div></div>`, state.together ? `PLAYER ${state.together.player+1} · MEDLEY` : 'FIND YOUR BALANCE');\n--\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-91-      const canFinish=guest.checked && (guest.freePlay || guest.day===5 ? guest.finaleDone || guest.freePlay : guest.dayMinutes>=goal);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-92-      html = modal(guest.day===5?'Check out?':'Time to rest?','THE MINUTE CLAM', `<div class=\"dialogue\"><span class=\"speaker\">PIP · RECEPTION CUSHION</span><p>“The clam has swallowed ${guest.dayMinutes || 0} minutes today. This is apparently a good thing.”</p></div><p>${!guest.checked?'Complete the morning Wobble Check first.':guest.day===5&&!guest.finaleDone&&!guest.freePlay?'Complete The Big Stand before checking out.':!canFinish?`The clam is hoping for ${goal} minutes today. Complete another activity or two.`:'You have done enough for today. The island will be here when you wake.'}</p><div class=\"row\">${button('Keep exploring','island')}${canFinish ? button(guest.day===5?'See the finale':'Sleep until tomorrow','sleep','primary') : ''}</div>`, 'island');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-93-    } else if (state.screen === 'ending') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-94-      html = modal(state.profile.age<=40?'A standing ovation.':'An extended stay.','THE BIG STAND · CHECKOUT', `<div class=\"big-score\">${state.profile.age}<small>FINAL BALANCE AGE</small></div><div class=\"dialogue\"><p>${state.profile.age<=40?'“You did it,” says Pip. “You stood there, and we all felt something.”':'“We’ve extended your stay,” says Pip. “The paperwork is a napkin.”'}</p><p>The cast waves from the water. Your island adventure continues in free play.</p></div><p>Created for Tippy Cay · A playful original game inspired by Wii Fit.</p><div class=\"row\">${button('Continue in free play','free-play','primary')}</div>`, 'island');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-95-    } else if (state.screen === 'together') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js:96:      html = modal('Play together','THE ISLAND MEDLEY', `<p>Take turns on one device through Paddle Slalom, Tide Table, and Cannonball Cup. Add up to four guests; each score is out of 3,000.</p><div class=\"cards three\">${[2,3,4].map(number=>`<button class=\"card\" data-action=\"hotseat:${number}\"><strong>${number} guests</strong><small>Pass the controller after each medley</small></button>`).join('')}</div><p class=\"tiny\">When launched from AI Hub, the same medley runs online with translucent ghost guests.</p>`);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-97-    } else if (state.screen === 'handoff') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-98-      const group=state.together, item=eventById(medley[group.event]);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-99-      html = modal(`Guest ${group.player+1}, you’re up!`,'PASS THE CONTROLLER', `<p>Round ${group.event+1} of 3: <strong>${item.name}</strong></p><div class=\"dialogue\"><p>“No rush,” says Pip. “The sea will wait. The gull might not.”</p></div><div class=\"row\">${button('Start '+item.name,'hotseat-next','primary')}</div>`, 'title');\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-100-    } else if (state.screen === 'podium') {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-101-      const group=state.together, ranking=group.scores.map((score,index)=>({score,index})).sort((left,right)=>right.score-left.score);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.js-102-      html = modal('A very good medley','ISLAND PODIUM', `<p>The clam would like to thank every guest for their outstanding participation.</p><div class=\"cards\">${ranking.map((entry,index)=>`<div class=\"card\"><strong>${['🥇','🥈','🥉','✳'][index]} Guest ${entry.index+1}</strong><small>${formatScore(entry.score)} / 3,000 points</small></div>`).join('')}</div><div class=\"row\">${button('Play again','together')}${button('Return to title','title','primary')}</div>`);\nWii Fit Together-Wii Fit-gpt-6