{"type":"item.completed","item":{"id":"item_337","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; rg -n -o '.{0,200}(dev-stiffness|dev-timeScale|reset-tuning|finish-now|give-minutes|data-action=\\\"pause\\\"|function tickRound|function finishRound|result-next|settings-back).{0,400}' \\\"\"'$dev/web/game.js\" | head -35; sed -n '\"'1,90p' \\\"\"'$dev/tests/test_game.py\"'","aggregated_output":"84:nd-name\">${esc(round.name)}</h2><div id=\"round-subtitle\">${esc(round.instruction)}</div></div><div class=\"hud-right\"><div class=\"pill\" id=\"timer\">${Math.ceil(round.length)}s</div><button class=\"pill\" data-action=\"pause\">Ⅱ Pause</button></div></div><div class=\"event-center\"><div class=\"phase-card\" id=\"phase-card\">${esc(round.instruction)}</div></div><div class=\"event-bottom\"><div class=\"puck\" aria-label=\"Balance puck\"><div class=\"target\" id=\"target\"></div><div class=\"dot\" id=\"dot\"></div></div><div class=\"meter\"><div><strong id=\"round-score\">0</strong> <span id=\"score-label\">POINTS</span></div><div class=\"meter-tr\n85:ngs')}${state.together?.online?'':button('Leave activity','leave-event')}</div>${state.together?.online?'':`<details><summary>Developer tuning</summary><label class=\"field\">Spring stiffness<input id=\"dev-stiffness\" type=\"range\" min=\"10\" max=\"80\" value=\"${state.stiffness ?? 40}\"></label><label class=\"field\">Damping<input id=\"dev-damping\" type=\"range\" min=\"2\" max=\"20\" value=\"${state.damping ?? 8.5}\" step=\".5\"></label><label class=\"field\">Wobble<input id=\"dev-wobble\" type=\"range\" min=\"0\" max=\".4\" value=\"${state.wobble ?? .12}\" step=\".01\"></label><label class=\"field\">Time scale<input id=\"dev-timeScale\" type=\"r\n85:ange\" min=\".25\" max=\"4\" value=\"${state.timeScale ?? 1}\" step=\".25\"></label><div class=\"row\">${button('Reset tuning','reset-tuning')}${button('Finish activity now','finish-now')}${!state.together?button('Give 5 minutes','give-minutes'):''}</div></details>`}</section></div>`;\n88:ult.stars || 0))}</div><div class=\"dialogue\"><span class=\"speaker\">PIP SAYS</span><p>“${esc(result.comment)}”</p></div><div class=\"row\">${button(state.together?'Continue medley':'Back to the island','result-next','primary')}</div>`, state.together?'result-next':'island');\n106:'Cross'}. Mouse: move to lean and click to act. Arrow keys navigate menus.</p><p>Touch-only devices can view the island; connect a controller or keyboard to play.</p><div class=\"row\">${button('Done','settings-back','primary')}</div>`, 'settings-back');\n147:    else if (action==='reset-tuning') { state.stiffness=40; state.damping=8.5; state.wobble=.12; state.timeScale=1; render(); }\n148:    else if (action==='finish-now') { state.paused=false; if(state.screen==='check') finishCheck(); else finishRound(); }\n149:    else if (action==='give-minutes') { if(state.profile && !state.together) {state.profile.dayMinutes=(state.profile.dayMinutes||0)+5;state.profile.minutesTotal=(state.profile.minutesTotal||0)+5;save();} render(); }\n151:    else if (action==='result-next') advanceResult();\n159:    else if (action==='settings-back') setScreen(state.returnScreen || 'title');\n187:  function finishRound() {\n230:  function tickRound(dt) {\nimport json\nimport os\nimport sys\nimport threading\nimport traceback\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nHTML = ROOT / f\"{DEV.name}.html\"\nARTIFACTS = DEV / \"tests\" / \"artifacts\"\nfailures = []\nchecks = 0\n\n\ndef test(name, function):\n    global checks\n    checks += 1\n    try:\n        function()\n    except Exception:\n        failures.append(f\"{name}:\\n{traceback.format_exc()}\")\n\n\ndef status(page):\n    return json.loads(page.evaluate(\"window.__gameStatus()\"))\n\n\ndef click(page, action):\n    page.locator(f'[data-action=\"{action}\"]').first.click(timeout=5000)\n\n\ndef advance(page):\n    page.evaluate(\"window.__testAdvance(200)\")\n    assert status(page)[\"scene\"] == \"result\", status(page)\n\n\ndef load(browser, **kwargs):\n    context = browser.new_context(**kwargs)\n    page = context.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda error: errors.append(str(error)))\n    page.goto(HTML.as_uri() + \"?test=1\", wait_until=\"domcontentloaded\")\n    page.wait_for_function(\"window.__gameBoot?.ready === true\")\n    return context, page, errors\n\n\ndef new_guest(page):\n    click(page, \"slots-new\")\n    click(page, \"slot:0\")\n    page.locator(\"#guest-name\").select_option(label=\"Ari\")\n    click(page, \"skin:2\")\n    click(page, \"outfit:3\")\n    click(page, \"create-guest\")\n    click(page, \"island\")\n    assert status(page)[\"guest\"] == \"Ari\"\n\n\ndef browser_tests(playwright):\n    for engine in (\"chromium\", \"firefox\", \"webkit\"):\n        browser = getattr(playwright, engine).launch(headless=True)\n\n        def smoke():\n            context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n            assert \"Wii Fit\" in page.title()\n            click(page, \"about\")\n            assert \"Source Information\" in page.locator(\"#app\").inner_text()\n            click(page, \"title\")\n            new_guest(page)\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            page.keyboard.press(\"Escape\")\n            assert status(page)[\"paused\"]\n            page.keyboard.press(\"Escape\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"checked\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            page.keyboard.press(\"Space\")\n            advance(page)\n            assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n            click(page, \"result-next\")\n            page.screenshot(path=str(ARTIFACTS / f\"{engine}-island.png\"))\n","exit_code":0,"status":"completed"}}
