   if(state.together?.online && hub && time-lastHubProgress>=2){lastHubProgress=time;hub.progress({score:state.together.scores[0]+Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000),label:round.name});}\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css\n@@\n-:root{--ink:#173f48;--muted:#52747a;--paper:#fffdf2;--aqua:#7fe0d8;--teal:#117a79;--coral:#ff826d;--sun:#ffd67b;--line:rgba(23,63,72,.16);font-family:ui-rounded,\"Trebuchet MS\",system-ui,sans-serif;color:var(--ink)}\n+#app .activity small{display:block;margin-top:3px}#app .dayline{flex-wrap:wrap}#app .dayline span{height:auto;flex:0 0 auto;background:#edf6ec;color:#52747a;border-radius:999px;padding:6px 8px;font-size:10px;font-weight:900;white-space:nowrap}\n+:root{--ink:#173f48;--muted:#52747a;--paper:#fffdf2;--aqua:#7fe0d8;--teal:#117a79;--coral:#ff826d;--sun:#ffd67b;--line:rgba(23,63,72,.16);font-family:ui-rounded,\"Trebuchet MS\",system-ui,sans-serif;color:var(--ink)}\n*** Update File: Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/tests/test_game.py\n@@\n-        click(page, \"settings\")\n+        page.locator('\"'.touch-guard [data-action=\\\"settings\\\"]').tap(timeout=5000)\n@@\n         for name, settings in [\n             (\\\"two players\\\", {\\\"players\\\": 2}),\n+            (\\\"three players\\\", {\\\"players\\\": 3}),\n             (\\\"four players with network jitter\\\", {\\\"players\\\": 4, \\\"latency\\\": 150, \\\"jitter\\\": 50, \\\"loss\\\": 5}),\n*** Update File: PROGRESS.md\n@@\n-- Current phase: bundle the standalone browser game and embedded AI Hub client.\n-- Next: test gameplay, persistence, Hub and viewport behavior; complete the exit interview and final hand-in.\n+- The standalone build is bundled. All 24 phone, tablet, desktop and cross-browser viewport launches passed after fixing a startup injection bug.\n+- Browser tests cover three engines, the five-day stay, save persistence and a two-player local medley; a