ine/crates/pav_core/src/games/mod.rs:41:/// else is read-only. While `pre` or `post` runs, the game is out of `sim.state.play`, so use\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:53:        _input: &InputFrame,\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:56:    ) -> BTreeMap<EntityId, InputFrame> {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:80:    fn bot(&self, _sim: &Sim) -> InputFrame {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:81:        InputFrame::default()\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:85:/// One line of [`GAMES`]: made with [`entry`].\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:89:    /// Builds the scene and sets `sim.state.play`. The `&str` is the rest of the scene name\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:95:/// A [`GAMES`] line for the game type `G`.\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:120:    GAMES.iter().find(|g| g.key == key)\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:157:    pub fn bot(&self, sim: &Sim) -> InputFrame {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:185:            let known: Vec<&str> = GAMES.iter().map(|g| g.key).collect();\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:197:    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame>;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:202:    fn bot(&self, sim: &Sim) -> InputFrame;\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:217:    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:232:    fn bot(&self, sim: &Sim) -> InputFrame {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:244:    /// The running game from [`GAMES`], if this scene is one.\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:246:        self.state.play.as_ref()\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:255:    pub fn bot_input(&self) -> InputFrame {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:259:    pub(crate) fn play_pre(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:260:        let Some(mut g) = self.state.play.take() else { return BTreeMap::new() };\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:262:        self.state.play = Some(g);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:267:        let Some(mut g) = self.state.play.take() else { return };\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/crates/pav_core/src/games/mod.rs:269:        self.state.play = Some(g);\n# The starter game's level: a room file (every field: rooms/_template.toml). Column = x (east),\n# row = z (south), 1 cell = 1 m. `o` cells are shards and `P` is the start (legend markers,\n# read by starter.rs with `scenes::markers`); the slimes are [[npc]] entries the game drives.\n# Check it with `pav room_check path=crates/pav_core/src/games/starter.toml`.\n\nname = \"Starter\"\nabout = \"Collect every shard while slimes chase you.\"\nentrance = { at = [8, 12], facing = \"south\" }   # required by the format; the `P` marker is the start\n\n# The rules' numbers (starter.rs `Rules`). Running from the repository, `pav` reads this file at\n# each `load`: edit, then `load scene=starter` or `play bot=true seeds=10`, no rebuild.\n[game]\nlives = 3\nslime_speed = 0.5\nslime_sight = 9.0\ncatch = 0.8\npick = 0.9\ngrace = 2.0\n\n[camera]\ntilt = 58.0\ndistance = 17.0\n\n[layout]\norigin = [-9.0, 0.0, -6.5]\n\n[[layout.layer]]\ny = 0\nmap = '''\n##################\n#o......#.......o#\n#.......#........#\n#..##.......##...#\n#..#.........#...#\n#.......o........#\n#....#.....#.....#\n#.......P........#\n#..#.........#...#\n#..##.......##...#\n#.......#........#\n#o......#.......o#\n##################\n'''\n\n[layout.legend.'.']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }]\n\n[layout.legend.'#']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }, { y0 = 0, y1 = 1.2, color = \"#8a6f9e\", rounded = true }]\n\n[layout.legend.'o']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }]\nmarker = \"shard\"\n\n[layout.legend.'P']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }]\nmarker = \"player\"\n\n[[npc]]\nname = \"slime\"\nkind = \"blob\"\npos = [12.5, 0, 2.5]\nlook = { skin = \"#6cd66c\" }\n\n[[npc]]\nname = \"slime\"\nkind = \"blob\"\npos = [5.5, 0, 10.5]\nlook = { skin = \"#6cd66c\" }\n\n[[npc]]\nname = \"slime\"\nkind = \"blob\"\npos = [15.5, 0, 7.5]\nlook = { skin = \"#6cd66c\" }\n//! Device-independent input for one simulation tick. The host (window, agent, replay) fills\n//! it; the simulation never sees devices. Directions are already in world space.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\npub mod buttons {\n    pub const JUMP: u32 = 1 << 0;\n    pub const CROUCH: u32 = 1 << 1;\n    pub const INTERACT: u32 = 1 << 2;\n    pub const USE: u32 = 1 << 3;\n    pub const FOCUS: u32 = 1 << 4;\n    pub const SPRINT: u32 = 1 << 5;\n    pub const PRIMARY: u32 = 1 << 6;\n    pub const SECONDARY: u32 = 1 << 7;\n    pub const CRAWL: u32 = 1 << 8;\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\n    pub const SKILL3: u32 = 1 << 9;\n    pub const SKILL4: u32 = 1 << 10;\n    pub const SKILL5: u32 = 1 << 11;\n    pub const SKILL6: u32 = 1 << 12;\n    pub const DODGE: u32 = 1 << 13;\n    pub const POTION: u32 = 1 << 14;\n\n    pub const NAMES: &[(&str, u32)] = &[\n        (\"jump\", JUMP),\n        (\"crouch\", CROUCH),\n        (\"interact\", INTERACT),\n        (\"use\", USE),\n        (\"focus\", FOCUS),\n        (\"sprint\", SPRINT),\n        (\"primary\", PRIMARY),\n        (\"secondary\", SECONDARY),\n        (\"crawl\", CRAWL),\n        (\"skill3\", SKILL3),\n        (\"skill4\", SKILL4),\n        (\"skill5\", SKILL5),\n        (\"skill6\", SKILL6),\n        (\"dodge\", DODGE),\n        (\"potion\", POTION),\n    ];\n\n    pub fn from_name(n: &str) -> Option<u32> {\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct InputFrame {\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\n    pub move_dir: Vec2,\n    /// Vertical intent for climbing/flying/swimming (-1..1).\n    #[serde(default)]\n    pub vertical: f32,\n    /// World-space aim point (mouse on the ground plane, or stick projection).\n    #[serde(default)]\n    pub aim: Option<Vec3>,\n    /// Buttons held this tick.\n    #[serde(default)]\n    pub held: u32,\n    /// Buttons that went down since the previous tick (never lost, even for short taps).\n    #[serde(default)]\n    pub pressed: u32,\n    /// A menu action this tick (Shardfall: equip, sell, travel...), queued one per tick.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub cmd: Option<crate::arpg::GameCmd>,\n}\n\nimpl InputFrame {\n    pub fn down(&self, b: u32) -> bool {\n        self.held & b != 0\n    }\n    pub fn just(&self, b: u32) -> bool {\n        self.pressed & b != 0\n    }\n}\n#!/usr/bin/env python3\n\"\"\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\n\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\n           [--theme-color C] [--scene NAME] [--out PATH]\n\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\n--single-file makes it and runs this. The page is web/index.html with the options written into\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\ngiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\nURLs are needed. Out: target/web/<title>.html.\n\"\"\"\nimport argparse\nimport base64\nimport gzip\nimport html\nimport json\nimport pathlib\nimport re\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nPAGE = ROOT / \"web\" / \"index.html\"\n\n# Runs while the page parses, before index.html's module script.\nLOADER = \"\"\"\n(() => {\n  const msg = document.getElementById('msg');\n  // The start scene baked in at build time, unless the address names a room or a scene.\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\n  if (scene && !query.get('room') && !query.get('scene')) {\n    query.set('scene', scene);\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\n  }\n  const line = document.createElement('div');\n  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\n  msg.style.flexDirection = 'column';\n  msg.style.gap = '8px';\n  msg.replaceChildren(`Loading ${document.title}…`, line);\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\n  // The JS glue is the module script at the end of the page: it hands over its init function.\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\n  window.loadGame = async () => {\n    line.textContent = 'Unpacking…';\n    await paint();\n    // The gzipped wasm's base64 block leaves the page once read, to free its text.\n    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\n    block.remove();\n    let packed;\n    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\n    else {\n      const bin = atob(text);\n      packed = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\n    }\n    const wasm = new Uint8Array(size);\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\n    let n = 0;\n    for (let r = await reader.read(); !r.done; r = await reader.read()) {\n      wasm.set(r.value, n);\n      n += r.value.length;\n      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\n    }\n    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\n    line.textContent = 'Starting…';\n    await paint();\n    const init = await glue;\n    await init({ module_or_path: wasm });\n  };\n})();\n\"\"\"\n\n\ndef fail(text):\n    sys.exit(f\"pack_single_html: {text}\")\n\n\ndef replace_one(page, pattern, make, what):\n    \"\"\"Replaces the one match of `pattern` in the page; anything else means index.html changed.\"\"\"\n    page, n = re.subn(pattern, make, page)\n    if n != 1:\n        fail(f\"expected one {what} in {PAGE.relative_to(ROOT)}, found {n}: update this script\")\n    return page\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n    ap.add_argument(\"bindgen_dir\", type=pathlib.Path, help=\"wasm-bindgen output (shardfall.js, shardfall_bg.wasm)\")\n    ap.add_argument(\"--title\", help=\"<title> (default: index.html's)\")\n    ap.add_argument(\"--description\", help=\"<meta name=description> (default: index.html's)\")\n    ap.add_argument(\"--theme-color\", help=\"<meta name=theme-color> (default: index.html's)\")\n    ap.add_argument(\"--scene\", help=\"start scene when the address names no room or scene (default: the game's)\")\n    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")\n    a = ap.parse_args()\n\n    js, wasm_path = a.bindgen_dir / \"shardfall.js\", a.bindgen_dir / \"shardfall_bg.wasm\"\n","exit_code":0,"status":"completed"}}
