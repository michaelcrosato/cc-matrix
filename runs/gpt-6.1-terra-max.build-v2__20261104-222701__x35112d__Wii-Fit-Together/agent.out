entries(value||{}).map(([key,line])=>`<p><strong>${esc(key)}:</strong> ${esc(line)}</p>`).join('')}</div>`).join('')}<div class=\"row\">${button('Back to the island','title','primary')}</div>`);\nWii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/web/game.css:5::root{--ink:#173f48;--muted:#52747a;--paper:#fffdf2;--aqua:#7fe0d8;--teal:#117a79;--coral:#ff826d;--sun:#ffd67b;--line:rgba(23,63,72,.16);font-family:ui-rounded,\"Trebuchet MS\",system-ui,sans-serif;color:var(--ink)}\n","exit_code":0,"status":"completed"}}
