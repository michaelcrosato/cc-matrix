">${skins.map((color,index)=>`<button class=\"swatch ${index===state.setup.skin?'selected':''}\" style=\"background:${color}\" data-action=\"skin:${index}\" aria-label=\"Skin tone ${index+1}\"></button>`).join('')}</div></div><div class=\"field\">Outfit color<div class=\"swatches\">${outfits.map((color,index)=>`<button class=\"swatch ${index===state.setup.outfit?'selected':''}\" style=\"background:${color}\" data-action=\"outfit:${index}\" aria-label=\"Outfit color ${index+1}\"></button>`).join('')}</div></div><div class=\"row\">${button('Back','slots-new')}${button('Arrive on the island','create-guest','primary')}</div>`, 'slots-new');\n68-    } else if (state.screen === 'intro') {\n--\n72-      const available=events.filter(item=>unlocked(item));\n73:      html = shell(`<div class=\"island-layout\"><section class=\"island-panel\"><div class=\"eyebrow\">HELLO, ${esc(guest.name.toUpperCase())} · ${guest.freePlay?'FREE PLAY':'YOUR ISLAND STAY'}</div><h2>Find your<br>happy wobble.</h2><div class=\"dayline\"><span>DAY ${day} / 5</span><span>✳ ${guest.dayMinutes || 0} / ${goal || '∞'} MIN</span><span>★ ${guest.stars || 0} STARS</span></div><p class=\"island-note\">${guest.checked ? `Pip says your Balance Age is ${guest.age}. The clam looks impressed.` : 'Pip is waiting for your morning Wobble Check.'}</p><div class=\"activity-list\">${!guest.checked ? `<button class=\"activity highlight\" data-action=\"check\"><span>◉</span><strong>Morning Wobble Check<small>Say hello to Pip · about a minute</small></strong><b>→</b></button>` : ''}${available.map(item=>`<button class=\"activity\" data-action=\"intro:${item.id}\"><span>${item.day===4?'≈':item.day===3?'✳':item.day===5?'★':'◌'}</span><strong>${item.name}<small>${item.place} · ${item.coach}</small></strong><b>→</b></button>`).join('')}</div><div class=\"row island-actions\">${button('Guest book','calendar')}${button(day===5?'Finish the stay':'Call it a day','end-day','primary')}</div></section></div><div class=\"footer\"><s