.pill,.eyebrow{display:inline-flex;align-items:center;gap:8px;border-radius:999px;font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}\n.pill{padding:10px 14px;background:rgba(255,253,242,.84);box-shadow:0 3px 0 rgba(25,90,91,.12)}\n.eyebrow{color:#087e7a}\n.sun-dot{width:9px;height:9px;border-radius:50%;background:#ffab65}\n.title-layout{flex:1;min-height:0;display:grid;grid-template-columns:minmax(300px,520px) 1fr;align-items:center;gap:3vw}\n.title-panel{max-width:530px}\n.overline{font-size:clamp(11px,1vw,15px);font-weight:900;letter-spacing:.2em;text-transform:uppercase;color:#1c7775}\n.title-panel h1,.headline{font-size:clamp(50px,7vw,102px);line-height:.88;letter-spacing:-.065em;margin:18px 0 20px;font-weight:1000}\n.title-panel h1 span{color:#f67862}\n.lede{font-size:clamp(16px,1.45vw,21px);line-height:1.38;max-width:450px;font-weight:650}\n.title-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:26px;max-width:470px}\n.button{border:0;border-radius:15px;min-height:52px;padding:13px 18px;background:var(--paper);box-shadow:0 5px 0 rgba(17,91,91,.16);font-weight:900;text-align:left;transition:transform .13s,box-shadow .13s,background .13s}\n.button:hover,.button:focus-visible{transform:translateY(-2px);box-shadow:0 7px 0 rgba(17,91,91,.18)}\n.button:active{transform:translateY(3px);box-shadow:0 2px 0 rgba(17,91,91,.16)}\n.button.primary{background:var(--ink);color:white}\n.button.coral{background:var(--coral);color:#fff}\n.button:disabled{opacity:.45;cursor:default}\n.button small{display:block;font-size:11px;letter-spacing:.02em;font-weight:700;opacity:.7;margin-top:3px}\n.footer{flex:none;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:12px;font-weight:800;letter-spacing:.04em}\n.footer .hint{background:rgba(255,253,242,.72);padding:9px 12px;border-radius:999px}\n.hero-note{justify-self:end;align-self:end;margin:0 1vw 9vh 0;max-width:220px;transform:rotate(4deg);background:#fff9d7;padding:16px 20px;border-radius:4px 16px 16px 16px;box-shadow:0 6px 25px #287d7a29;font-weight:900;line-height:1.25}\n.hero-note b{display:block;font-size:12px;color:#e07965;letter-spacing:.12em;text-transform:uppercase;margin-bottom:7px}\n.panel-wrap{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:18px 0}\n.panel{background:rgba(255,253,242,.96);border:1px solid #fff;border-radius:26px;box-shadow:0 18px 60px #1d686b27;max-height:100%;overflow:auto;box-sizing:border-box;padding:clamp(20px,3vw,42px);width:min(900px,100%);scrollbar-color:#9acdc5 transparent}\n.panel.narrow{width:min(620px,100%)}\n.panel h2{font-size:clamp(30px,3.4vw,52px);line-height:1;letter-spacing:-.045em;margin:9px 0 10px}\n.panel p{line-height:1.4;margin:8px 0 18px;color:var(--muted);font-weight:650}\n.panel-head{display:flex;justify-content:space-between;align-items:start;gap:20px;margin-bottom:16px}\n.close{background:#edf6ec;border:0;border-radius:50%;width:42px;height:42px;font-size:23px;font-weight:800;flex:none}\n.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n.cards.three{grid-template-columns:repeat(3,minmax(0,1fr))}\n.card{min-width:0;border:1px solid #dce9df;border-radius:17px;background:#f6faf1;padding:16px;text-align:left}\n.card strong{font-size:18px;display:block;line-height:1.1}\n.card small{display:block;margin-top:7px;font-size:12px;line-height:1.3;color:#638079;font-weight:700}\n.card:hover,.card:focus-visible{border-color:#ffad7a;background:#fff6e4}\n.card.selected{border:3px solid var(--teal);padding:14px}\n.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.row>.button{flex:1}\n.field{display:block;font-size:13px;font-weight:900;margin:14px 0}\n.field select,.field input{display:block;box-sizing:border-box;width:100%;margin-top:6px;border:1px solid #cfdfd8;border-radius:12px;background:white;padding:12px;font:inherit;color:var(--ink)}\n.swatches{display:flex;gap:10px;flex-wrap:wrap;margin:9px 0 17px}\n.swatch{width:40px;height:40px;border:3px solid white;border-radius:50%;box-shadow:0 0 0 1px #aac8bf}\n.swatch.selected{box-shadow:0 0 0 3px var(--teal)}\n.section-title{font-size:12px;font-weight:1000;letter-spacing:.13em;text-transform:uppercase;color:#61817d;margin:18px 0 9px}\n.island-layout{display:grid;grid-template-columns:minmax(280px,370px) 1fr;gap:20px;flex:1;min-height:0;align-items:center}\n.island-panel{background:rgba(255,253,242,.95);border-radius:24px;padding:clamp(20px,2.2vw,32px);max-height:100%;overflow:auto;box-shadow:0 15px 50px #2d797929}\n.island-panel h2{font-size:clamp(30px,3.1vw,46px);line-height:1;letter-spacing:-.05em;margin:9px 0}\n.dayline{display:flex;gap:6px;margin:16px 0}\n.dayline span{height:8px;flex:1;border-radius:10px;background:#d7e6db}\n.dayline span.done{background:#27a69b}\n.dayline span.current{background:#ff9c7e}\n.activity-list{display:grid;gap:8px}\n.activity{width:100%;border:0;background:#eaf6ed;border-radius:13px;padding:12px 14px;text-align:left;font-weight:900;display:flex;align-items:center;justify-content:space-between;gap:8px}\n.activity small{font-size:11px;font-weight:800;color:#66827c}\n.activity:hover,.activity:focus-visible{background:#fff0d4}\n.island-note{align-self:end;justify-self:end;background:#fff9df;border-radius:16px;padding:16px 20px;max-width:245px;font-weight:800;box-shadow:0 9px 30px #1c656020}\n.hud{display:flex;justify-content:space-between;gap:12px;align-items:start}\n.hud .pill{font-size:14px}\n.event-center{position:absolute;top:17%;left:50%;transform:translateX(-50%);width:min(680px,80vw);text-align:center;pointer-events:none}\n.event-center h2{font-size:clamp(28px,4.2vw,60px);line-height:1;margin:10px 0;color:white;text-shadow:0 3px 14px #155c6080;letter-spacing:-.04em}\n.event-center p{font-size:clamp(16px,1.8vw,24px);font-weight:900;color:white;text-shadow:0 2px 8px #155c60}\n.puck{position:absolute;right:clamp(20px,4vw,70px);bottom:clamp(70px,11vh,120px);width:clamp(110px,14vw,185px);aspect-ratio:1;border:9px solid #fffefa;border-radius:50%;background:#245c6688;box-shadow:0 7px 0 #1a585b28, inset 0 0 0 2px #fff5}\n.puck:before,.puck:after{content:\"\";position:absolute;background:#ffffff55}\n.puck:before{left:50%;top:8%;width:1px;height:84%}\n.puck:after{top:50%;left:8%;height:1px;width:84%}\n.puck .target{position:absolute;left:50%;top:50%;width:24%;height:24%;transform:translate(-50%,-50%);border:2px dashed #fff9;border-radius:50%}\n.puck .dot{position:absolute;left:50%;top:50%;width:15%;height:15%;border-radius:50%;background:#ffe378;border:3px solid white;box-shadow:0 2px 6px #124b4d66;transform:translate(-50%,-50%)}\n.event-bottom{position:absolute;bottom:clamp(18px,3vw,40px);left:clamp(18px,3.2vw,54px);display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.meter{height:12px;border-radius:99px;background:#d9e8dd;overflow:hidden}\n.meter>span{display:block;height:100%;border-radius:inherit;background:#ff9478;transition:width .2s}\n.big-score{font-size:clamp(64px,9vw,110px);font-weight:1000;line-height:.9;letter-spacing:-.07em;color:var(--teal);margin:15px 0}\n.stars{color:#f6b94d;font-size:34px;letter-spacing:6px}\n.dialogue{border-left:5px solid #8adbd1;padding-left:16px;font-size:clamp(17px,1.7vw,22px);line-height:1.35;font-weight:800}\n.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}\n.info-grid div{padding:12px;background:#f2f8ee;border-radius:12px;overflow-wrap:anywhere;font-size:13px;line-height:1.4}\n.info-grid b{display:block;text-transform:uppercase;font-size:10px;letter-spacing:.1em;color:#498279}\n.about-list{font-size:13px;line-height:1.5;color:#50716d}\n.touch-guard{position:fixed;z-index:10;inset:0;background:#cff0e9ed;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}\n.touch-guard>div{max-width:440px}\n.touch-guard h2{font-size:clamp(28px,7vw,44px);line-height:1;margin:16px 0}\n.touch-guard .button{text-align:center}\n.touch-guard.settings-open{display:none}\n.attract-label{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);font-weight:1000;color:white;text-align:center;text-shadow:0 2px 7px #226}\n.hidden{display:none!important}\n\n@media(max-width:700px){.screen{padding:18px}\n.title-layout{grid-template-columns:1fr;align-items:start;padding-top:8vh}\n.title-panel{max-width:400px}\n.title-panel h1{font-size:clamp(52px,12vw,78px)}\n.title-panel .lede{max-width:310px}\n.hero-note{display:none}\n.title-actions{max-width:360px}\n.island-layout{grid-template-columns:1fr;align-items:end}\n.island-panel{max-height:69vh}\n.island-note{display:none}\n.footer{font-size:10px}\n.panel-wrap{align-items:center}\n.cards.three{grid-template-columns:1fr 1fr}\n.event-center{top:19%;width:90vw}\n.puck{width:105px;border-width:6px}\n.event-bottom{max-width:58vw}\n.hud .pill{font-size:11px}\n.info-grid{grid-template-columns:1fr}\n}\n\n@media(max-height:550px){.screen{padding:14px 24px}\n.title-layout{align-items:center;padding:0}\n.title-panel h1{font-size:clamp(42px,7vw,72px);margin:8px 0}\n.title-panel .lede{font-size:15px;margin:8px 0}\n.title-actions{margin-top:12px}\n.button{min-height:42px;padding:9px 14px}\n.hero-note{margin-bottom:4vh}\n.panel{padding:20px}\n.panel h2{font-size:32px}\n.panel-wrap{padding:8px 0}\n.event-center{top:12%}\n.event-center h2{font-size:30px}\n.event-center p{font-size:16px}\n.puck{bottom:55px;width:100px}\n.island-panel{padding:16px;max-height:80vh}\n.dayline{margin:8px 0}\n.activity{padding:8px 12px}\n.section-title{margin:10px 0 5px}\n}\n\n50:  function shell(content, right) { return `<div class=\"screen\">${header(right)}${content}</div>`; }\n58:  function render() {\n84:      html = shell(`<div class=\"hud\"><div><div class=\"eyebrow\">${esc(round.place.toUpperCase())}</div><h2 id=\"round-name\">${esc(round.name)}</h2><div id=\"round-subtitle\">${esc(round.instruction)}</div></div><div class=\"hud-right\"><div class=\"pill\" id=\"timer\">${Math.ceil(round.length)}s</div><button class=\"pill\" data-action=\"pause\">Ⅱ Pause</button></div></div><div class=\"event-center\"><div class=\"phase-card\" id=\"phase-card\">${esc(round.instruction)}</div></div><div class=\"event-bottom\"><div class=\"puck\" aria-label=\"Balance puck\"><div class=\"target\" id=\"target\"></div><div class=\"dot\" id=\"dot\"></div></div><div class=\"meter\"><div><strong id=\"round-score\">0</strong> <span id=\"score-label\">POINTS</span></div><div class=\"meter-track\"><div id=\"meter-fill\"></div></div><small id=\"round-help\">${esc(round.controls)}</small></div></div>`, state.together ? `PLAYER ${state.together.player+1} · MEDLEY` : 'FIND YOUR BALANCE');\n259:    const timer=document.getElementById('timer'), subtitle=document.getElementById('round-subtitle'), phase=document.getElementById('phase-card'), score=document.getElementById('round-score'), fill=document.getElementById('meter-fill');\n","exit_code":0,"status":"completed"}}
