fits[guest.outfit||0],center.x,Math.sin(now*.008)*(round?.id==='step'?.8:.1));\n   297\t      if(round?.id==='breath'){const r=80+30*Math.sin(round.elapsed*Math.PI/4);context.strokeStyle='#ffb2a6';context.lineWidth=8;context.beginPath();context.arc(800,348,r,0,Math.PI*2);context.stroke();}\n   298\t      if(round?.id==='tide'){ellipse(800+round.shellX*145,500+round.shellY*45,12,10,'#f58a73');ellipse(800+Math.sin(round.potted*3)*87,500+Math.cos(round.potted*2)*25,16,9,'#61b8c2');}\n   299\t      if(round?.id==='paddle'){context.strokeStyle='#ff9c72';context.lineWidth=10;context.beginPath();context.arc(800+Math.sin(Math.floor(round.elapsed/4.5)*1.9)*100,300,58,0,Math.PI*2);context.stroke();}\n   300\t      if(round?.id==='dive'&&act){for(let index=0;index<8;index++)ellipse(700+index*27,545-Math.abs(Math.sin(now*.005+index))*45,8,12,'#9be7e5');}\n   301\t      for(const [id,ghost] of Object.entries(state.together?.ghosts||{})) if(ghost.event===state.together.event){context.globalAlpha=.35;human(800+ghost.x*180,530,2.25,'#c3eee5','#78a3c5',ghost.x,0);context.globalAlpha=1;}\n   302\t    }\n   303\t  }\n   304\t  function frame(now) { const dt=Math.min((now-lastFrame)/1000,.05);lastFrame=now;if(!state.paused){updateInput(dt);tickRound(dt);}music(dt);if(state.screen==='title'&&!state.attract&&now-state.lastInput>10000){state.attrac\n   305\t  requestAnimationFrame(frame);\n   306\t\n   307\t  if (hub && hub.active) {\n   308\t    hub.on('start', data=>{state.together={count:state.hub?.players?.length||1,player:0,event:0,scores:[0,0,0,0],online:true,ghosts:{}};setTimeout(()=>startRound(medley[0]),Math.max(0,Number(data?.in)||0));});\n   309\t    hub.on('message',(data,from)=>{if(state.together?.online && data && Number.isFinite(data.x) && Number.isFinite(data.y))state.together.ghosts[from||'guest']=data;});\n   310\t    hub.on('time-up',()=>reportHub());hub.on('end',()=>{state.paused=true;state.message='The online session has ended.';setScreen('waiting');});\n   311\t    hub.connect({mode:'ghost',seats:[1,4]}).then(info=>{if(!info)return;state.hub=info;state.message='Connected! Getting the medley ready.';setScreen('waiting');if(info.splash)hub.ready();}).catch(()=>{state.message='Could \n   312\t    hub.probe(()=>({scene:state.screen,menu:{screen:state.screen},world:{event:state.round?.id,elapsed:state.round?.elapsed},input:{device:state.device}}));\n   313\t  }\n   314\t  window.__gameBoot={ready:true,title:'Wii Fit Together'};\n   315\t  window.__gameStatus=()=>JSON.stringify({scene:state.screen,guest:profileName(),day:state.profile?.day||0,checked:!!state.profile?.checked,minutes:state.profile?.dayMinutes||0,age:state.profile?.age??null,event:state.round\n   316\t  render();\n   317\t})();\n--- hub contract ---\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n--- engine loader ---\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<title>Shardfall</title>\n<meta name=\"description\" content=\"Play Shardfall, a procedural hack-and-slash adventure with an interactive tech demo pavilion.\">\n<meta name=\"theme-color\" content=\"#15171c\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<link rel=\"icon\" href=\"data:,\">\n<style>\n  /* The page is the game: no scrolling, zooming, text selection, callouts or tap flashes. */\n  html, body { margin: 0; height: 100%; overflow: hidden; background: #15171c; overscroll-behavior: none;\n               touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n               -webkit-tap-highlight-color: transparent; }\n  /* winit appends the game canvas to <body>; it fills the page and the game follows its size.\n     dvh: the height that is visible while a phone's browser bars come and go. */\n  canvas { display: block; width: 100vw !important; height: 100vh !important; height: 100dvh !important;\n           outline: none; touch-action: none; }\n  #msg { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;\n         font: 18px system-ui, sans-serif; color: #c9ccd4; text-align: center; padding: 24px; pointer-events: none; }\n  /* Phones held upright: a hint to turn sideways that fades by itself. */\n  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\n          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\n          pointer-events: none; animation: fade 1s 5s forwards; }\n  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\n  @keyframes fade { to { opacity: 0; } }\n</style>\n</head>\n<body>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading Shardfall…</div>\n<div id=\"turn\">Turn your phone sideways for the best view</div>\n<script type=\"module\">\n  // Start in a demo room with ?room=NAME, or the pavilion with ?scene=world.\n  // Messages name the game by the page title (a single-file build may retitle it).\n  const name = document.title;\n  const msg = document.getElementById('msg');\n  if (!navigator.gpu) {\n    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\n      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\n  } else {\n    // The game hides this message once its canvas exists, and takes keyboard focus.\n    new MutationObserver((_, obs) => {\n      const c = document.querySelector('canvas');\n      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\n    }).observe(document.body, { childList: true });\n    // Phones and tablets: the first tap goes full screen and turns sideways, where the browser\n    // allows it (Android; an iPhone keeps its bars, or plays full screen from the home screen).\n    if (matchMedia('(pointer: coarse)').matches) {\n      addEventListener('pointerup', () => {\n        const el = document.documentElement;\n        if (!document.fullscreenElement && el.requestFullscreen) {\n          el.requestFullscreen({ navigationUI: 'hide' })\n            .then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape'))\n            .catch(() => {});\n        }\n      }, { once: true, capture: true });\n    }\n    try {\n      // The game is shardfall.js and its .wasm beside this page. A single-file build\n      // (scripts/pack_single_html.py) carries both inside the page and sets window.loadGame.\n      if (window.loadGame) await window.loadGame();\n      else await (await import('./shardfall.js')).default();\n    } catch (error) {\n      console.error(`${name} failed to load:`, error);\n      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\n      document.body.append(msg);\n    }\n  }\n</script>\n</body>\n</html>\n--- hand-in questions ---\n89-## Done\n90-No TODOs, placeholders, or stubbed features. The demo is complete.\n91-\n92:## Source Information\n93:CRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n94-- Date: 2026-11-04 22:27:01\n95-- Source: the work it's based on\n96-- Plan: the file name of the plan you were given to build from, or none\n--\n106-- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n107-- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n108-\n109:Exit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools \n110-{\n111-  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"add\n112:  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n113:  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n114:  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n115:  \"aiHub\": {\n116-    \"name\": \"the game's title, as on its title screen\",\n117-    \"tagline\": \"a few words to go under the title\",\n118-    \"description\": \"one or two sentences for the catalogue\",\n--\n127-}\n128-The catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n129-\n130:Testing Feedback\n131-\n132-- How many issues did testing catch?\n133-- How many would be considered critical issues / game breaking?\n134-- What was the most helpful test you ran?\n135-- What was the least helpful test you ran?\n136-\n137:Engine Feedback\n138-\n139-- What did you like most about the engine?\n140-- Did you get stuck or guess wrong?\n--\n143-- What did you change in the engine, and why? (none if nothing)\n144-- If you could change one thing about the engine, what would it be?\n145-\n146:Prompt Feedback\n147-\n148-- What did you like most about this prompt?\n149-- What was confusing?\n","exit_code":0,"status":"completed"}}
