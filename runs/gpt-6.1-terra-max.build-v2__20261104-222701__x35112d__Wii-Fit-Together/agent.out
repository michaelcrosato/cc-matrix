{"type":"item.started","item":{"id":"item_428","type":"command_execution","command":"/bin/bash -lc \"export PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64\npython3 - <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path.cwd(); dev=next(p for p in root.glob('Wii Fit Together-*') if p.is_dir())\ncases=[('original', (dev/'game.raw.html').as_uri(), ['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader']), ('game',(root/(dev.name+'.html')).as_uri(), ['--enable-unsafe-webgpu','--use-webgpu-adapter=swiftshader'])]\nwith sync_playwright() as pw:\n for name,url,flags in cases:\n  browser=pw.chromium.launch(headless=True,args=flags); page=browser.new_page(); errs=[]\n  page.on('console',lambda msg:errs.append(msg.text) if msg.type in ('error','warning') else None)\n  page.on('pageerror',lambda error:errs.append(str(error)))\n  page.goto(url,wait_until='domcontentloaded'); page.wait_for_timeout(5000)\n  print(name, 'issues:',errs[:4], 'canvas:',page.locator('canvas').count())\n  browser.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
