{"type":"item.completed","item":{"id":"item_441","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; sed -n '1,100p' \\\"\"'$dev/tests/test_game.py\"; sed -n '\"'2050,2180p' \\\"\"'$dev/engine/crates/pav_app/src/app.rs\"; ls -l \"$dev/engine/target/wasm32-unknown-unknown/dist/pav_app.wasm\"'","aggregated_output":"import json\nimport os\nimport sys\nimport threading\nimport traceback\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nHTML = ROOT / f\"{DEV.name}.html\"\nARTIFACTS = DEV / \"tests\" / \"artifacts\"\nfailures = []\nchecks = 0\n\n\ndef test(name, function):\n    global checks\n    checks += 1\n    try:\n        function()\n    except Exception:\n        failures.append(f\"{name}:\\n{traceback.format_exc()}\")\n\n\ndef status(page):\n    return json.loads(page.evaluate(\"window.__gameStatus()\"))\n\n\ndef click(page, action):\n    page.locator(f'[data-action=\"{action}\"]').first.click(timeout=5000)\n\n\ndef advance(page):\n    page.evaluate(\"window.__testAdvance(200)\")\n    assert status(page)[\"scene\"] == \"result\", status(page)\n\n\ndef load(browser, **kwargs):\n    context = browser.new_context(**kwargs)\n    page = context.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda error: errors.append(str(error)))\n    page.goto(HTML.as_uri() + \"?test=1\", wait_until=\"domcontentloaded\")\n    page.wait_for_function(\"window.__gameBoot?.ready === true\")\n    return context, page, errors\n\n\ndef new_guest(page):\n    click(page, \"slots-new\")\n    click(page, \"slot:0\")\n    page.locator(\"#guest-name\").select_option(label=\"Ari\")\n    click(page, \"skin:2\")\n    click(page, \"outfit:3\")\n    click(page, \"create-guest\")\n    click(page, \"island\")\n    assert status(page)[\"guest\"] == \"Ari\"\n\n\ndef browser_tests(playwright):\n    for engine in (\"chromium\", \"firefox\", \"webkit\"):\n        browser = getattr(playwright, engine).launch(headless=True)\n\n        def smoke():\n            context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n            assert \"Wii Fit\" in page.title()\n            click(page, \"about\")\n            assert \"Source Information\" in page.locator(\"#app\").inner_text()\n            click(page, \"title\")\n            new_guest(page)\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            page.keyboard.press(\"Escape\")\n            assert status(page)[\"paused\"]\n            page.keyboard.press(\"Escape\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"checked\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            page.keyboard.press(\"Space\")\n            advance(page)\n            assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n            click(page, \"result-next\")\n            page.screenshot(path=str(ARTIFACTS / f\"{engine}-island.png\"))\n            assert not errors, errors\n            context.close()\n\n        test(f\"{engine} guest, check and activity\", smoke)\n        browser.close()\n\n    browser = playwright.chromium.launch(headless=True)\n\n    def stay():\n        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n            }\n            MenuAction::FieldGuide => {\n                self.set_menu(false);\n                self.guide.field = true;\n            }\n            MenuAction::Rooms => {\n                self.set_menu(false);\n                self.open_teleport();\n            }\n            MenuAction::RoomCard => {\n                self.set_menu(false);\n                self.hud.show_card();\n            }\n            MenuAction::Screenshot => {\n                self.set_menu(false);\n                self.screenshot_requested = true;\n            }\n            MenuAction::Feel => {\n                self.set_menu(false);\n                self.feel.open = !self.feel.open;\n                self.feel.auto = false;\n            }\n            MenuAction::Physics => {\n                self.set_menu(false);\n                self.physics.open = !self.physics.open;\n                self.physics.auto = false;\n            }\n            MenuAction::Quit => {\n                self.look_ui.save_if_dirty(true);\n                self.quit = true;\n            }\n            MenuAction::TownPortal => {\n                self.set_menu(false);\n                if let Some(host) = &self.host {\n                    host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n                }\n            }\n            MenuAction::Fullscreen => {\n                if let Some(g) = &self.gfx {\n                    crate::platform::toggle_fullscreen(&g.window);\n                }\n            }\n        }\n    }\n}\n\nimpl App {\n    /// The browser only allows sound after the first click or key press.\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio(&mut self) {\n        if !self.audio_resumed {\n            self.audio_resumed = true;\n            if let Some(a) = &self.audio {\n                a.resume();\n            }\n        }\n    }\n\n    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(\"Shardfall could not start\", &msg);\n        self.fatal = Some(msg);\n        el.exit();\n    }\n}\n\nimpl ApplicationHandler for App {\n    fn resumed(&mut self, el: &ActiveEventLoop) {\n        if self.init_started || self.fatal.is_some() {\n            return;\n        }\n        self.init_started = true;\n        if let Err(e) = self.init(el) {\n            self.fail(el, e);\n        }\n    }\n\n    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {\n            self.on_touch(t, &event);\n            return;\n        }\n        let consumed = match (&mut self.egui_state, &self.gfx) {\n            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n            _ => false,\n        };\n        match event {\n            WindowEvent::CloseRequested => {\n                if let Some(host) = &self.host {\n                    host.exec(|sim| crate::save::save_from(sim));\n                }\n                self.look_ui.save_if_dirty(true);\n                el.exit()\n            }\n            WindowEvent::Focused(false) => {\n                self.input.clear();\n                self.touch.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    let system = matches!(\n                        code,\n                        KeyCode::Escape\n                            | KeyCode::F1\n                            | KeyCode::F2\n                            | KeyCode::F3\n                            | KeyCode::F4\n                            | KeyCode::F5\n                            | KeyCode::F6\n                            | KeyCode::F7\n                            | KeyCode::F8\n                            | KeyCode::F9\n                            | KeyCode::F10\n                            | KeyCode::F11\n                            | KeyCode::F12\n                    );\nls: cannot access 'Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701/engine/target/wasm32-unknown-unknown/dist/pav_app.wasm': No such file or directory\n","exit_code":2,"status":"failed"}}
