{"type":"item.started","item":{"id":"item_448","type":"command_execution","command":"/bin/bash -lc \"dev='Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701'; rg -n 'quit:|self\\\\.quit|struct Gfx|impl Drop|destroy\\\\(' \\\"\"'$dev/engine/crates/pav_app/src\" \"$dev/engine/crates/pav_render/src\" | head -100; sed -n '\"'110,330p' \\\"\"'$dev/engine/crates/pav_app/src/app.rs\"; rg -n '\"'first frame|start_frame|pending|gfx =|\\\\binit\\\\(' \\\"\"'$dev/engine/crates/pav_app/src/app.rs\" | head -80'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
