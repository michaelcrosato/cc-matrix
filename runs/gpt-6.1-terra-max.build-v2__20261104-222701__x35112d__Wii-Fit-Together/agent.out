f(group.player>=group.count) setScreen('podium'); else setScreen('handoff');\n203-  }\n204-  function reportHub() { if(!state.together || !state.together.online) return; const score=clamp(Math.round(state.together.scores[0]),0,3000); if(hub && !state.together.reported) {state.together.reported=true;hub.result({score,stats:{events:Math.min(3,state.together.event)},awards:[{name:'Island Enthusiast',description:'Completed the Tippy Cay medley.'}]});} state.message=`Medley complete: ${formatScore(score)} points. Waiting for the group.`;setScreen('waiting'); }\n205-\n206:  function updateInput(dt) {\n207-    let x=(keys.has('arrowright')||keys.has('d')?1:0)-(keys.has('arrowleft')||keys.has('a')?1:0), y=(keys.has('arrowdown')||keys.has('s')?1:0)-(keys.has('arrowup')||keys.has('w')?1:0);\n208-    let gamepad=null; try { gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean); } catch (_) {}\n209-    if(gamepad) {\n210-      const dead=value=>Math.abs(value)<.12?0:Math.sign(value)*Math.pow((Math.abs(value)-.12)/.88,1.5);\n--\n223-    center.vx+=((targetX-center.x)*stiffness-center.vx*damping)*dt;center.vy+=((targetY-center.y)*stiffness-center.vy*damping)*dt;\n224-    center.x=clamp(center.x+center.vx*dt,-1.2,1.2);center.y=clamp(center.y+center.vy*dt,-1.2,1.2);\n225-  }\n226-  function heldAction() { try { const gamepad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);return mouseHeld||keys.has(' ')||keys.has('enter')||!!gamepad?.buttons[0]?.pressed; } catch (_) { return mouseHeld||keys.has(' '); } }\n227:  function tickRound(dt) {\n228-    const round=state.round; if(!round || state.paused || !['event','check'].includes(state.screen)) return;\n229-    round.elapsed+=dt; const time=round.elapsed;\n230-    let quality=clamp(1-Math.hypot(center.x,center.y)*.8,0,1), targetX=0,targetY=0, instruction=round.controls;\n231-    if(state.screen==='check') {\n--\n254-    if(target){target.style.transform=`translate(${targetX*43}px,${targetY*43}px)`;target.style.opacity=state.screen==='check'&&round.phase===2?'0':'1';}\n255-    const timer=document.getElementById('timer'), subtitle=document.getElementById('round-subtitle'), phase=document.getElementById('phase-card'), score=document.getElementById('round-score'), fill=document.getElementById('meter-fill');\n256-    if(timer)timer.textContent=Math.max(0,Math.ceil(round.length-time))+'s';if(subtitle)subtitle.textContent=instruction;if(phase)phase.textContent=instruction;if(score)score.textContent=state.screen==='check'?['STILL','LEAN','LISTEN','STEP'][round.phase]:formatScore(round.sum/Math.max(1,round.samples)*1000);if(fill)fill.style.width=clamp(time/round.length*100,0,100)+'%';\n257-    if(state.together?.online && hub && time-lastHubUpdate>.1){lastHubUpdate=time;hub.send({event:state.together.event,x:center.x,y:center.y,progress:time/round.length},{reliable:false});}\n258:    if(state.together?.online && hub && time-lastHubProgress>=2){lastHubProgress=time;hub.progress({score:state.together.scores[0]+Math.round(clamp(round.sum/Math.max(round.samples,1),0,1)*1000),label:round.name});}\n259-    if(time>=round.length) { if(state.screen==='check')finishCheck();else finishRound(); }\n260-  }\n261-\n262-  function moveFocus(direction) { const items=Array.from(app.querySelectorAll('button:not([disabled]),select,input')).filter(item=>item.offsetParent!==null);if(!items.length)return;const index=items.indexOf(document.activeElement);items[(index+direction+items.length)%items.length].focus(); }\n--\n303-      if(round?.id==='dive'&&act){for(let index=0;index<8;index++)ellipse(700+index*27,545-Math.abs(Math.sin(now*.005+index))*45,8,12,'#9be7e5');}\n304-      for(const [id,ghost] of Object.entries(state.together?.ghosts||{})) if(ghost.event===state.together.event){context.globalAlpha=.35;human(800+ghost.x*180,530,2.25,'#c3eee5','#78a3c5',ghost.x,0);context.globalAlpha=1;}\n305-    }\n306-  }\n307:  function frame(now) { const dt=Math.min((now-lastFrame)/1000,.05);lastFrame=now;if(!state.paused){updateInput(dt);tickRound(dt);}music(dt);if(state.screen==='title'&&!state.attract&&now-state.lastInput>10000){state.attract=true;render();}drawWorld(now);requestAnimationFrame(frame); }\n308-  requestAnimationFrame(frame);\n309-\n310-  if (hub && hub.active) {\n311-    hub.on('start', data=>{state.together={count:state.hub?.players?.length||1,player:0,event:0,scores:[0,0,0,0],online:true,ghosts:{}};setTimeout(()=>startRound(medley[0]),Math.max(0,Number(data?.in)||0));});\nimport json\nimport os\nimport sys\nimport threading\nimport traceback\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nHTML = ROOT / f\"{DEV.name}.html\"\nARTIFACTS = DEV / \"tests\" / \"artifacts\"\nfailures = []\nchecks = 0\n\n\ndef test(name, function):\n    global checks\n    checks += 1\n    try:\n        function()\n    except Exception:\n        failures.append(f\"{name}:\\n{traceback.format_exc()}\")\n\n\ndef status(page):\n    return json.loads(page.evaluate(\"window.__gameStatus()\"))\n\n\ndef click(page, action):\n    page.locator(f'[data-action=\"{action}\"]').first.click(timeout=5000)\n\n\ndef advance(page):\n    page.evaluate(\"window.__testAdvance(200)\")\n    assert status(page)[\"scene\"] == \"result\", status(page)\n\n\ndef load(browser, **kwargs):\n    context = browser.new_context(**kwargs)\n    page = context.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda error: errors.append(str(error)))\n    page.goto(HTML.as_uri() + \"?test=1\", wait_until=\"domcontentloaded\")\n    page.wait_for_function(\"window.__gameBoot?.ready === true\")\n    return context, page, errors\n\n\ndef new_guest(page):\n    click(page, \"slots-new\")\n    click(page, \"slot:0\")\n    page.locator(\"#guest-name\").select_option(label=\"Ari\")\n    click(page, \"skin:2\")\n    click(page, \"outfit:3\")\n    click(page, \"create-guest\")\n    click(page, \"island\")\n    assert status(page)[\"guest\"] == \"Ari\"\n\n\ndef browser_tests(playwright):\n    for engine in (\"chromium\", \"firefox\", \"webkit\"):\n        browser = getattr(playwright, engine).launch(headless=True)\n\n        def smoke():\n            context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n            assert \"Wii Fit\" in page.title()\n            click(page, \"about\")\n            assert \"Source Information\" in page.locator(\"#app\").inner_text()\n            click(page, \"title\")\n            new_guest(page)\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            page.keyboard.press(\"Escape\")\n            assert status(page)[\"paused\"]\n            page.keyboard.press(\"Escape\")\n            advance(page)\n            click(page, \"result-next\")\n            assert status(page)[\"checked\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            page.keyboard.press(\"Space\")\n            advance(page)\n            assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n            click(page, \"result-next\")\n            page.screenshot(path=str(ARTIFACTS / f\"{engine}-island.png\"))\n            assert not errors, errors\n            context.close()\n\n        test(f\"{engine} guest, check and activity\", smoke)\n        browser.close()\n\n    browser = playwright.chromium.launch(headless=True)\n\n    def stay():\n        context, page, errors = load(browser, viewport={\"width\": 1280, \"height\": 800})\n        new_guest(page)\n        for day, goal in enumerate((3, 5, 7, 9, 0), 1):\n            assert status(page)[\"day\"] == day\n            click(page, \"check\")\n            click(page, \"begin-check\")\n            advance(page)\n            click(page, \"result-next\")\n            for _ in range(goal if day < 5 else 1):\n                if day < 5 and status(page)[\"minutes\"] >= goal:\n                    break\n                click(page, \"intro:finale\" if day == 5 else \"intro:breath\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n            click(page, \"end-day\")\n            click(page, \"sleep\")\n        assert status(page)[\"scene\"] == \"ending\"\n        click(page, \"free-play\")\n        assert status(page)[\"scene\"] == \"island\"\n        page.reload(wait_until=\"domcontentloaded\")\n        page.wait_for_function(\"window.__gameBoot?.ready === true\")\n        click(page, \"slots-continue\")\n        click(page, \"slot:0\")\n        assert status(page)[\"guest\"] == \"Ari\" and status(page)[\"day\"] == 5\n        assert not errors, errors\n        context.close()\n\n    test(\"five-day stay, ending and save persistence\", stay)\n\n    def minute_rewards():\n        context, page, errors = load(browser)\n        new_guest(page)\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\n        for attempt in range(2):\n            before = status(page)[\"minutes\"]\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            earned = status(page)[\"minutes\"] - before\n            assert earned == (1 + status(page)[\"resultStars\"] if attempt == 0 else 1)\n            click(page, \"result-next\")\n        while status(page)[\"minutes\"] < 3:\n            click(page, \"intro:breath\")\n            click(page, \"begin-event\")\n            advance(page)\n            click(page, \"result-next\")\n        click(page, \"end-day\")\n        click(page, \"sleep\")\n        click(page, \"check\")\n        click(page, \"begin-check\")\n        advance(page)\n        click(page, \"result-next\")\n        click(page, \"intro:breath\")\n        click(page, \"begin-event\")\n        advance(page)\n        assert status(page)[\"minutes\"] == 1 + status(page)[\"resultStars\"]\n        assert not errors, errors\n        context.close()\n\n    test(\"first-clear and repeat minute rewards\", minute_rewards)\n\n    def medley():\n        context, page, errors = load(browser)\n        click(page, \"together\")\n        click(page, \"hotseat:2\")\n        for player in range(2):\n            for event in range(3):\n                current = status(page)[\"together\"]\n                assert current[\"player\"] == player and current[\"event\"] == event, current\n                click(page, \"hotseat-next\")\n                click(page, \"begin-event\")\n                advance(page)\n                click(page, \"result-next\")\n        assert status(page)[\"scene\"] == \"podium\"\n        assert not errors, errors\n        context.close()\n\n    test(\"two-player local medley\", medley)\n    browser.close()\n\n    browser = playwright.webkit.launch(headless=True)\n\n    def touch_guard():\n        context, page, errors = load(browser, **playwright.devices[\"iPhone SE (3rd gen)\"])\n        assert \"Controller or keyboard required\" in page.locator(\"#app\").inner_text()\n        page.screenshot(path=str(ARTIFACTS / \"iphone-touch.png\"))\n        page.locator('.touch-guard [data-action=\"settings\"]').tap(timeout=5000)\n        assert status(page)[\"scene\"] == \"settings\"\n        assert not errors, errors\n        context.close()\n\n    test(\"touch-only guard and settings\", touch_guard)\n    browser.close()\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef hub_tests(playwright):\n    server = ThreadingHTTPServer((\"127.0.0.1\", 0), partial(QuietHandler, directory=str(ROOT)))\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    browser = playwright.chromium.launch(headless=True)\n    try:\n        for name, settings in [\n            (\"two players\", {\"players\": 2}),\n            (\"three players\", {\"players\": 3}),\n            (\"four players with network jitter\", {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5}),\n            (\"host leaves\", {\"players\": 3, \"scenario\": \"host-leave\"}),\n        ]:\n            def conformance():\n                page = browser.new_page()\n                query = urlencode({\"auto\": 1, \"game\": \"../../\" + HTML.name, **settings})\n                url = f\"http://127.0.0.1:{server.server_port}/{DEV.name}/hub/harness.html?{query}\"\n                page.goto(url, wait_until=\"domcontentloaded\")\n                page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=60000)\n                result = page.evaluate(\"window.__hubCheck\")\n                bad = [f'{item[\"name\"]}: {item.get(\"detail\", \"\")}' for item in result[\"checks\"] if not item[\"pass\"]]\n                assert result[\"pass\"], \"\\n\".join(bad)\n                page.close()\n\n            test(\"AI Hub \" + name, conformance)\n    finally:\n        browser.close()\n        server.shutdown()\n        server.server_close()\n        thread.join()\n\n\ndef main():\n    os.environ.setdefault(\"PLAYWRIGHT_HOST_PLATFORM_OVERRIDE\", \"ubuntu24.04-x64\")\n    ARTIFACTS.mkdir(parents=True, exist_ok=True)\n    with sync_playwright() as playwright:\n        if len(sys.argv) == 1 or sys.argv[1] in (\"browser\", \"all\"):\n            browser_tests(playwright)\n        if len(sys.argv) == 1 or sys.argv[1] in (\"hub\", \"all\"):\n            hub_tests(playwright)\n    for failure in failures:\n        print(f\"FAIL {failure}\")\n    print(f\"{checks - len(failures)}/{checks} checks passed\")\n    sys.exit(bool(failures))\n\n\nif __name__ == \"__main__\":\n    main()\n# Progress\n\n- Title: **Wii Fit Together**, selected uniformly using Node.js `crypto.randomInt` from 50 brainstormed candidates.\n- Deliverable: `Wii Fit Together-Wii Fit-gpt-6.1-terra-max-20261104-222701.html` in the workspace root; source and development files in the identically named directory.\n- Engine and Hub client acquired; native engine build succeeds. Registered a Tippy Cay scene and deterministic balance spring in Shardfall.\n- The standalone build is bundled. All 24 phone, tablet, desktop and cross-browser viewport launches passed after fixing a startup injection bug.\n- The browser suite passed ten checks, including three engines, the five-day stay, save persistence, the local medley, and 2–4-player AI Hub runs. Two Rust balance-spring tests passed.\n- First-clear and repeat minute rewards now follow the plan. Rebuild the HTML, re-run the changed browser suite, and complete the exit interview.\n- Limitation: the playable presentation and most activity logic are Canvas 2D / JavaScript over a Shardfall hook, not the planned full native 3D engine implementation.\n","exit_code":0,"status":"completed"}}
