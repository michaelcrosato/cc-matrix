, menuObj = null;"," function titleScene() {","   return {","     enter() { cur = { name: 'title', data: null }; idle = 0; A.music(E.songs.title); },","     update(dt) {","       if (game.input.anyPressed()) idle = 0; else idle += dt;","-      if (touchOnly()) return;","-      if (game.input.pressed('confirm') || game.input.pressed('start')) { A.sfx('select'); return go('menu'); }","+      if (game.input.pressed('confirm') || game.input.pressed('start')) { if (!touchOnly()) { A.sfx('select'); return go('menu'); } }","       if (idle > IDLE_TO_ATTRACT) return go('attract');","     },","     draw(r) {","       r.sky(['#101848', '#402a70', '#f7d28a']);","-      r.overlay(g => { E.font.title(g, TITLE, r.W / 2, r.H * .18, { scale: 3, align: 'center', colors: ['#fff6c8', '#ffd36a', '#e07a2a'], outline: '#1a0c10', depth: 3, depthColor: '#6a2a1a' }); });","-      centreText(r, 'Faster. Higher. Yikes.', r.H * .42, '#f7f2e0', 1);","-      if (touchOnly()) { centreText(r, 'Controller or keyboard required', r.H * .6, '#ffd166', 1); }","-      else if (Math.floor((game.real || 0) * 2) % 2 === 0) centreText(r, `PRESS ${game.input.label('confirm').toUpperCase()} TO START`, r.H * .6, '#fff6c8', 1);","-      centreText(r, 'MENU', r.H * .72, '#f7f2e0');","-      r.text('© OLYMPIYIKES · DEMO', 4, r.H - 12, '#c9c9d6');","+      r.overlay(g => E.font.title(g, TITLE, r.W / 2, r.H * .18, { scale: 3, align: 'center', colors: ['#fff6c8', '#ffd36a', '#e07a2a'], outline: '#1a0c10', depth: 3, depthColor: '#6a2a1a' }));","+      centreText(r, 'Faster. Higher. Yikes.', r.H * .42, '#f7f2e0');","+      if (touchOnly()) centreText(r, 'Controller or keyboard required', r.H * .6, '#ffd166');","+      else if (Math.floor((game.real || 0) * 2) % 2 === 0) centreText(r, `PRESS ${game.input.label('confirm').toUpperCase()} TO START`, r.H * .6, '#fff6c8');","+      centreText(r, 'OPTIONS: PAUSE  ·  DEV MODE: PAUSE MENU', r.H - 40, '#c9c9d6');","+      r.text('DEMO', 4, r.H - 12, '#c9c9d6');","     },","   };"," }"]},{"oldStart":665,"oldLines":12,"newStart":570,"newLines":11,"lines":["   return {","     enter() {","       cur = { name: 'menu', data: null }; idle = 0;","-      const items = [{ label: 'QUICK GAMES' }, { label: 'SINGLE EVENT' }, { label: 'RECORDS' }, { label: 'HOW TO PLAY' }, { label: 'ABOUT & CREDITS' }, { label: 'BACK' }];","-      menuObj = new E.Menu(game, items.map(i => i.label), {","+      menuObj = new E.Menu(game, ['QUICK GAMES', 'SINGLE EVENT', 'RECORDS', 'HOW TO PLAY', 'ABOUT & CREDITS', 'BACK'], {","         x: 'center', y: 80, title: 'THE GAMES',","         onPick(i) {","           idle = 0; A.sfx('confirm');","-          if (i === 0) { meet = { quick: true, list: ORDER.slice(), i: 0, results: {}, seed: (Date.now() & 0xffff) + 1 }; return go('ev', { id: meet.list[0], quick: true }); }","+          if (i === 0) { meet = { quick: true, list: ORDER.slice(), i: 0, results: {}, seed: 1 + ((Date.now() >>> 0) % 9999) }; return go('ev', { id: meet.list[0], seed: meet.seed }); }","           if (i === 1) return go('pick');","           if (i === 2) return go('records');","           if (i === 3) return go('howto');"]},{"oldStart":691,"oldLines":11,"newStart":595,"newLines":10,"lines":[" function pickScene() {","   return {","     enter() {","-      cur = { name: 'pick', data: null };","-      const items = ORDER.map(id => EVENTS[id].name).concat(['BACK']);","-      menuObj = new E.Menu(game, items, {","+      cur = { name: 'pick', data: null }; meet = null;","+      menuObj = new E.Menu(game, ORDER.map(id => EVENTS[id].name).concat(['BACK']), {","         x: 'center', y: 80, title: 'SINGLE EVENT',","-        onPick(i) { if (i >= ORDER.length) return go('menu'); meet = null; go('ev', { id: ORDER[i], seed: (Date.now() & 0xffff) + 1 }); },","+        onPick(i) { if (i >= ORDER.length) return go('menu'); go('ev', { id: ORDER[i], seed: 1 + ((Date.now() >>> 0) % 9999) }); },","         onCancel() { go('menu'); },","       });","     },"]},{"oldStart":705,"oldLines":30,"newStart":608,"newLines":26,"lines":[" }"," function attractScene() {","   return {","-    enter() { cur = { name: 'attract', data: null }; attractIdx = 0; attractNext(true); },","+    enter() { cur = { name: 'attract', data: null }; attractIdx = -1; meet = null; attractNext(); },","     update() { if (game.input.anyPressed()) go('title'); },","-    draw(r) {},","+    draw(r) { r.text('ATTRACT · PRESS ANY BUTTON', r.W / 2, r.H - 12, '#ffd166', { align: 'center', outline: '#1a0c10' }); },","   };"," }","-let attractIdx = 0;","-function attractNext(first) {","-  if (!first) attractIdx++;","+function attractNext() {","+  attractIdx++;","   if (attractIdx >= ORDER.length) return go('title');","-  meet = null;","-  const id = ORDER[attractIdx];","-  go('ev', { id, attract: true, seed: 777 + attractIdx });","+  go('ev', { id: ORDER[attractIdx], attract: true, seed: 777 + attractIdx });"," }"," ","-/* ---- dev mode: the balance sliders, cheats, reset ---- */","-let devRows = [];","+/* ==================== dev mode: sliders, the cheat, reset ==================== */","+let devRows = [], devSel = 0;"," function openDev() { go('dev', { from: cur }); }"," function devScene() {","   return {","     enter(d) {","       cur = { name: 'dev', data: d }; devSel = 0;","-      devRows = Object.keys(TUNE_RANGE).map(k => ({ k, ...TUNE_RANGE[k] }));","-      devRows.push({ k: 'cheat', label: 'Cheat: infinite HYPE, perfect timing' });","-      devRows.push({ k: 'reset', label: 'Reset all to defaults' });","+      devRows = Object.keys(TUNE_RANGE).map(k => ({ k }));","+      devRows.push({ k: 'cheat' }, { k: 'reset' });","     },","     update() {","       const p = game.input;"]},{"oldStart":749,"oldLines":30,"newStart":648,"newLines":40,"lines":["       centreText(r, 'DEV MODE', 8, '#ffd166', 2);","       let y = 36;","       devRows.forEach((row, i) => {","-        const sel = i === devSel;","-        if (sel) E.ui.box(r.W && undefined, 0, 0, 0, 0, {});","-        const label = row.label || row.k;","-        r.text((sel ? '▸ ' : '  ') + label, r.W * .08, y, sel ? '#fff6c8' : '#c9c9d6');","+        const sel = i === devSel, label = row.k === 'cheat' ? 'Cheat: infinite HYPE, perfect timing' : row.k === 'reset' ? 'Reset all to defaults' : TUNE_RANGE[row.k][3];","+        r.text((sel ? '> ' : '  ') + label, r.W * .08, y, sel ? '#fff6c8' : '#c9c9d6');","         if (TUNE_RANGE[row.k]) {","           const v = TUNE[row.k], [lo, hi] = TUNE_RANGE[row.k];","           r.overlay(g => { E.px.rect(g, r.W * .62, y + 3, r.W * .26, 4, E.hex('#44506f')); E.px.rect(g, r.W * .62 + r.W * .26 * (v - lo) / (hi - lo) - 2, y, 4, 10, E.hex('#f2b632')); });","-          r.text(v.toFixed(2), r.W * .9, y, '#f7f2e0', { align: 'right' });","-        } else if (row.k === 'cheat') r.text(cheat.infinite ? 'ON' : 'OFF', r.W * .9, y, '#f7f2e0', { align: 'right' });","+          r.text(v.toFixed(2), r.W * .92, y, '#f7f2e0', { align: 'right' });","+        } else if (row.k === 'cheat') r.text(cheat.infinite ? 'ON' : 'OFF', r.W * .92, y, '#f7f2e0', { align: 'right' });","         y += 16;","       });","-      centreText(r, '↑↓ choose · ←→ adjust · ✕ toggle/reset · ○ back', r.H - 26, '#c9c9d6');","+      centreText(r, 'up/down choose · left/right adjust · ✕ toggle or reset · ○ back', r.H - 26, '#c9c9d6');","     },","   };"," }","-let devSel = 0;","-function saveTune() { E.store.set('oly:tune', TUNE); }"," ","-/* ---- scene registry and boot ---- */","+/* ==================== About & Credits: the sections the task asks for ==================== */","+function ABOUT() {","+  return [","+    { title: 'OLYMPIYIKES! · CREDITS', lines: ['A vertical slice of the Summer and Winter Games', 'Built on my-3D2dge v0.85.2 (the handoff engine, changed in the copy here)', 'Engine music: E.songs (original loops)', 'Game code, sprites, sounds: this build'] },","+    { title: 'SOURCE INFORMATION', lines: ['Source: the complete summer and winter Olympic games', 'Genre: arcade multi-event sports', 'Perspective: side and overhead, per event', 'Model: claude-haiku-5-5, reasoning effort medium', 'Date: 2026-11-04 07:55:24'] },","+    { title: 'TESTING FEEDBACK', lines: ['Testing caught the issues listed in the chat reply.', 'See the Testing section of the chat reply.'] },","+    { title: 'ENGINE FEEDBACK', lines: ['See the Engine Feedback section of the chat reply.'] },","+    { title: 'PROMPT FEEDBACK', lines: ['See the Prompt Feedback section of the chat reply.'] },","+  ];","+}","+","+/* ==================== boot ==================== */"," const scenes = {","   title: titleScene(), menu: menuScene(), pick: pickScene(), ev: eventScene(), results: resultsScene(),","   medals: medalsScene(), records: recordsScene(), howto: howtoScene(), about: aboutScene(), dev: devScene(), attract: attractScene(),"," };"," game.start({ scene: 'title', scenes });","-window.__oly = { game, TUNE, cheat, EVENTS, ORDER, NATIONS, go: (n, d) => go(n, d), startEvent, get meet() { return meet; } };","-game.debug = { snapshot: () => ({ scene: cur.name, tune: { ...TUNE }, cheat: { ...cheat }, idle, activeEvent: activeEvent && { id: activeEvent.id, phase: activeEvent.ev.phase, t: activeEvent.ev.t } }), go, startEvent };","+game.debug = {","+  snapshot: () => ({ scene: cur.name, tune: { ...TUNE }, cheat: { ...cheat }, idle,","+    event: active && { id: active.id, phase: active.ev.phase, t: active.ev.t, attract: active.attract } }),","+  go, startEvent: (id, data) => go('ev', Object.assign({ id }, data)), meet: () => meet,","+};"," })();"]}],"originalFile":"// OLYMPIYIKES! — the game (a vertical slice on my-3D2dge). Three events (100m Dash, Ski Jump, Archery), Quick Games\n// (the three in a row, with a medal table), Single Event, Records, How to Play, About & Credits, attract mode after 10 s\n// idle on the title and menus, and a dev mode (pause menu) with live balance sliders and a reset to defaults.\n(() => {\n'use strict';\nconst E = My3D2dge, { clamp, lerp } = E;\nconst M = 12;                       // world units per metre (the engine's tile is 16)\nconst TITLE = 'OLYMPIYIKES!';\nconst IDLE_TO_ATTRACT = 10;         // seconds without input on the title or a menu\n\n/* ---- controls: one preset for the whole game (PlayStation names on the pad; Xbox glyphs in the controls screen) ---- */\nconst OLY_KEYS = {\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'],\n  left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\n  confirm: ['Enter', 'Space', 'Pad0'],          // ✕ / A\n  cancel: ['Backspace', 'KeyB'],\n  action: ['Space', 'KeyF', 'Pad0', 'Mouse0'],  // jump, release, take off\n  mashL: ['KeyJ', 'Pad2'],                      // □ / X\n  mashR: ['KeyK', 'Pad1'],                      // ○ / B\n  turbo: ['KeyL', 'Pad3'],                      // △ / Y\n  start: ['Enter', 'Pad9'], pause: ['Escape', 'KeyP', 'Pad9'],\n};\n\n/* ---- the balance tunables: defaults, and the sliders' ranges ---- */\nconst TUNE_DEFAULTS = { sprintGain: 1, turboMult: 1.3, hypeGain: 1, cpuSkill: 1, jumpLift: 1, windStrength: 1, balanceWind: 1, swayAmount: 1 };\nconst TUNE_RANGE = {\n  sprintGain: [.5, 1.6, .05, 'Dash speed from mashing'], turboMult: [1, 2, .05, 'Turbo speed'],\n  hypeGain: [0, 3, .1, 'HYPE gained per clean beat'], cpuSkill: [.5, 1.5, .05, 'Rival strength'],\n  jumpLift: [.5, 1.6, .05, 'Ski jump lift'], windStrength: [0, 2, .1, 'Wind (ski jump & archery)'],\n  balanceWind: [0, 2, .1, 'Balance gusts (ski jump)'], swayAmount: [0, 2, .1, 'Archery sway'],\n};\nconst TUNE = Object.assign({}, TUNE_DEFAULTS, E.store.get('oly:tune', {}));\nconst cheat = { infinite: false };    // dev: infinite HYPE and perfect timing (the attract mode's cheat too)\n\n/* ---- seeded randomness: the same seed gives the same CPU rivals and wind ---- */\nfunction rng(seed) {\n  let s = seed >>> 0;\n  return () => { s = (s + 0x6D2B79F5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1);\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n}\nconst hashStr = s => { let h = 2166136261; for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619); return h >>> 0; };\n\n/* ---- nations: the player's is fixed in this slice; the rest are rivals ---- */\nconst NATIONS = [\n  { id: 'SUN', name: 'SUNVALE', col: '#f2b632', dark: '#8a5a12' },\n  { id: 'TUR', name: 'TURBONIA', col: '#d7263d', dark: '#6a1220' },\n  { id: 'FRM', name: 'FRIMLAND', col: '#3a86ff', dark: '#1d3f80' },\n  { id: 'OAK', name: 'OAKVIK', col: '#2a9d8f', dark: '#155149' },\n  { id: 'PAP', name: 'PAPAYA BAY', col: '#ff7f50', dark: '#8a3e20' },\n  { id: 'NIM', name: 'NIMBUS', col: '#9b5de5', dark: '#4d2d74' },\n  { id: 'KRO', name: 'KROMAWA', col: '#8ac926', dark: '#476314' },\n  { id: 'MIS', name: 'MISTRAL', col: '#c9c9d6', dark: '#606070' },\n];\nconst PLAYER = NATIONS[0];\n\n/* ---- events: the card text, the best-score rule and the ranking rule ---- */\nconst EVENTS = {\n  sprint: {\n    name: '100m DASH', season: 'SUMMER', venue: 'GLORY STADIUM', view: 'brawler',\n    about: 'Mash the two buttons in turn. Every clean beat builds HYPE; fill it and press TURBO.',\n    rule: 'Lowest time wins', best: 'min', unit: 's',\n  },\n  skijump: {\n    name: 'SKI JUMP', season: 'WINTER', venue: 'MOUNT GLORY', view: 'side',\n    about: 'Mash down the inrun. Stop the sweep on the middle for a clean take-off, then hold LEFT or RIGHT to balance.',\n    rule: 'Furthest jump, plus style', best: 'max', unit: 'm',\n  },\n  archery: {\n    name: 'ARCHERY', season: 'SUMMER', venue: 'BULLSEYE LAWN', view: 'overhead',\n    about: 'Three arrows. The sway moves the aim; press ACTION to release on the gold. D-pad nudges it a little.',\n    rule: 'Highest total of three arrows', best: 'max', unit: 'pts',\n  },\n};\nconst ORDER = ['sprint', 'skijump', 'archery'];\n\n/* ---- the game object ---- */\nconst game = new E.Game({\n  canvas: 'screen', res: 'ps1', expand: true, bg: '#0b0f24', input: OLY_KEYS, id: 'olympiyikes',\n  menu: {\n    items: [['Dev mode', () => openDev()]],\n    quit: 'title',\n    controls: { mashL: 'Mash left (□)', mashR: 'Mash right (○)', action: 'Action (✕): take off, release, jump',\n      turbo: 'Yikes Turbo (△)', confirm: 'Choose (✕)', cancel: 'Back (○)' },\n  },\n});\nconst A = game.audio;\nlet cur = { name: 'title', data: null };          // the scene on screen, for the dev mode's way back\nconst go = (name, data, opts) => { cur = { name, data }; game.go(name, data, opts); };\nconst record = id => E.store.get('oly:best:' + id, null);\n\n/* ---- the meet: the Quick Games run, its results and the medal table ---- */\nlet meet = null;                                   // { quick, list, i, results: { id: {rank, score} } }\nfunction nationScores(seed, n) {\n  const r = rng(seed); return NATIONS.slice(1).map(() => r()).map((v, i) => ({ id: NATIONS[i + 1].id, v, n: n[i] }));\n}\n\n/* ---- shared drawing helpers ---- */\nconst PANEL = [['#1d2650', '#0e1430'], '#f2b632', '#f7f2e0'];\nfunction panel(r, x, y, w, h) {\n  r.overlay(g => E.ui.box(g, x, y, w, h, { bg: PANEL[0], border: PANEL[1] }));\n}\nfunction centreText(r, s, y, col = '#f7f2e0', scale = 1) { r.text(s, r.W / 2, y, col, { align: 'center', scale }); }\nconst btn = (a, word) => game.input.label(a) + ' ' + word;\nfunction speak(r, s) { r.text(s, r.W / 2, r.H - 26, '#fff6c8', { align: 'center', outline: '#1a0c10' }); }\n\n/* ---- the event kit: the phases every event runs through ---- */\nconst INTRO = 2.4, COUNT = 3.0, DONE_WAIT = .9;\nfunction eventFrame(id) {\n  const ev = EVENTS[id];\n  return { ev, t: 0, phase: 'intro', shown: 0 };\n}\nfunction commitResult(id, result) {\n  // record the best, then continue with the Quick Games' next event or the results screen\n  const best = record(id);\n  const better = !best || (EVENTS[id].best === 'min' ? result.value < best.value : result.value > best.value);\n  if (better && !result.attract) E.store.set('oly:best:' + id, { value: result.value, label: result.label });\n  result.newBest = better && !result.attract;\n  if (result.attract) { attractNext(); return; }\n  if (meet && meet.quick) {\n    meet.results[id] = result;\n    meet.i++;\n    if (meet.i < meet.list.length) return go('ev', { id: meet.list[meet.i], quick: true });\n    return go('medals', { quick: true });\n  }\n  return go('results', { id, result });\n}\n\n/* ---- SPRINT: 100m dash, four lanes, brawler view ---- */\nfunction makeSprint(d) {\n  const ev = eventFrame('sprint');\n  const rand = rng(hashStr('sprint:' + (d.seed || 1)));\n  const lanes = [16 + 24, 16 + 40, 16 + 56, 16 + 72];\n  const cpu = NATIONS.slice(1, 4).map((n, i) => ({ n, lane: lanes[i + 1], v: 0, dist: 0, finishT: null, ph: rand() * 6.28, base: 9.3 + rand() * .3 - .15, rig: null }));\n  const player = { n: PLAYER, lane: lanes[0], v: 0, dist: 0, finishT: null, rig: null };\n  const hits = []; let lastKey = null, hype = 0, turbo = 0, stumble = 0, falseStart = false, t = 0, raceT = 0, phase = 'intro', doneT = 0;\n  const mk = (col, dk, hair) => new E.Humanoid({ size: 1.3, build: 'chibi', hair: 'short', outfit: 'shirt', sleeves: 'short', colors: { cloth: col, coat: col, trim: dk, skin: '#e0b48a', hair, pants: '#24263a', boot: '#1d1b26' } });\n  player.rig = mk(PLAYER.col, PLAYER.dark, '#2a1f14');\n  cpu.forEach((c, i) => { c.rig = mk(c.n.col, c.n.dark, ['#101010', '#8a5a2e', '#e8c07a'][i]); });\n  const rate = () => hits.filter(h => raceT - h < 1).length;\n  const fine = () => cheat.infinite || TUNE.hypeGain === 0 ? false : true;\n  function mash(k) {\n    if (phase === 'count') { falseStart = true; return; }\n    if (phase !== 'race' || player.finishT !== null) return;\n    if (stumble > 0) return;\n    if (k === lastKey) { stumble = .6; hits.length = 0; hype = Math.max(0, hype - .2); }\n    else { hits.push(raceT); hype = clamp(hype + .07 * TUNE.hypeGain, 0, 1); }\n    lastKey = k;\n  }\n  function turboPress() {\n    if ((hype >= 1 || cheat.infinite) && turbo <= 0) { turbo = 2; hype = 0; A.sfx('powerup'); }\n  }\n  function stepRace(dt) {\n    raceT += dt;\n    if (stumble > 0) stumble -= dt;\n    turbo -= dt; if (turbo < 0) turbo = 0;\n    if (cheat.infinite) hype = 1; else hype = clamp(hype - .03 * dt, 0, 1);\n    const r = rate();\n    const pTarget = clamp(5.6 + .55 * r, 0, 11.2) * TUNE.sprintGain * (turbo > 0 ? TUNE.turboMult : 1) * (stumble > 0 ? .4 : 1);\n    player.v += clamp(pTarget - player.v, -3 * dt, 3 * dt);\n    player.dist += player.v * dt;\n    if (player.dist >= 100 && player.finishT === null) player.finishT = raceT - (player.dist - 100) / Math.max(1, player.v);\n    for (const c of cpu) {\n      const target = (c.base + .35 * Math.sin(raceT * 1.3 + c.ph)) * TUNE.cpuSkill;\n      c.v += clamp(target - c.v, -3 * dt, 3 * dt);\n      c.dist += c.v * dt;\n      if (c.dist >= 100 && c.finishT === null) c.finishT = raceT - (c.dist - 100) / Math.max(1, c.v);\n    }\n  }\n  function autoPilot(dt) {\n    // the attract mode's pilot: alternate the two mashes at a steady rhythm; use turbo when HYPE is full\n    ev.autoT = (ev.autoT || 0) + dt;\n    if (ev.autoT > .118) { ev.autoT = 0; mash(ev.autoK = ev.autoK === 'L' ? 'R' : 'L'); }\n    if (hype >= 1) turboPress();\n  }\n  const everyoneDone = () => player.finishT !== null && cpu.every(c => c.finishT !== null);\n  return {\n    ev, id: 'sprint',\n    update(dt, p) {\n      t += dt; ev.t = t;\n      if (phase === 'intro' && t > INTRO) { phase = 'count'; t = 0; }\n      else if (phase === 'count' && t > COUNT) { phase = 'race'; raceT = 0; t = 0; A.sfx('start'); }\n      else if (phase === 'race') {\n        if (d.attract) autoPilot(dt);\n        else {\n          if (p.pressed('mashL')) mash('L');\n          if (p.pressed('mashR')) mash('R');\n          if (p.pressed('turbo')) turboPress();\n        }\n        if (phase === 'race') stepRace(dt);\n        if (everyoneDone()) { phase = 'done'; doneT = 0; }\n      } else if (phase === 'count') {\n        if (!d.attract) {\n          if (p.pressed('mashL') || p.pressed('mashR')) mash(p.pressed('mashL') ? 'L' : 'R');\n        }\n      } else if (phase === 'done') {\n        doneT += dt;\n        if (doneT > DONE_WAIT && !d.attract && p.pressed('confirm')) finish();\n      }\n      if (d.attract && phase === 'done' && doneT > DONE_WAIT) finish();\n      // the count-in cue\n      if (phase === 'count') {\n        const sec = Math.ceil(COUNT - t);\n        if (sec !== ev.cue && sec >= 1 && sec <= 3) { ev.cue = sec; A.sfx('select'); }\n      }\n      ev.phase = phase; ev.hype = hype; ev.turbo = turbo; ev.rate = rate();\n      ev.rig(dt, cpu, player);\n    },\n    draw(r) { drawSprint(r, player, cpu, phase, t, raceT, hype, turbo, rate(), falseStart, d); },\n    result() {\n      const ranks = [player, ...cpu].slice().sort((a, b) => (a.finishT ?? 999) - (b.finishT ?? 999));\n      const rank = ranks.indexOf(player) + 1;\n      const time = (player.finishT ?? 99) + (falseStart ? .7 : 0);\n      return { value: time, label: time.toFixed(2) + ' s', rank, rivals: cpu.map(c => ({ n: c.n, label: (c.finishT ?? 99).toFixed(2) + ' s', value: c.finishT ?? 99 })), falseStart };\n    },\n  };\n  function finish() { commitResult('sprint', Object.assign(ev.result(), { attract: !!d.attract })); }\n}\n// the sprint keeps its frame so the draw and the rigs share one state: set up on the scene's enter (see scenes)\nfunction drawSprint(r, player, cpu, phase, t, raceT, hype, turbo, rate, falseStart, d) {\n  const trackY = [16, 176];\n  r.sky(['#2a4c8a', '#7aa6d8', '#f7d28a']);\n  r.overlay(g => {\n    E.px.rect(g, 0, 0, r.W, r.H * .48, E.hex('#1f3a66'));\n  });\n  r.groundFloor = true;\n  const camX = (player.dist * M) + 80;\n  game.focus(camX, 48, 8);\n  r.queue(camX, 0, 0, g => { /* track is painted in the overlay below */ });\n  // the track: lanes, as flat shapes on the ground (screen space under the actors)\n  const wpt = (x, y, z) => r.w(x, y, z);\n  r.overlay(g => {\n    const pts = [[camX - 900, 0, 0], [camX + 900, 0, 0], [camX + 900, 0, 0], [camX - 900, 0, 0]];\n    const q = pts.map(p => wpt(p[0], p[1], p[2]));\n    if (q.every(Boolean)) E.px.poly(g, [q[0], q[1], wpt(camX + 900, 192, 0), wpt(camX - 900, 192, 0)].filter(Boolean), E.hex('#2f6b35'));\n  });\n  r.overlay(g => {\n    for (let i = 0; i < 4; i++) {\n      const y0 = 16 + i * 24 - 12, y1 = y0 + 24;\n      const a = wpt(0, y0, 0), b = wpt(1200, y1, 0);\n      if (!a || !b) continue;\n      E.px.poly(g, [wpt(0, y0, 0), wpt(1200, y0, 0), wpt(1200, y1, 0), wpt(0, y1, 0)].filter(Boolean), E.hex(i % 2 ? '#b8532c' : '#c4642f'));\n    }\n    const f0 = wpt(1200, 0, 0), f1 = wpt(1204, 192, 0);\n    if (f0 && f1) E.px.rect(g, f0[0], f0[1], Math.max(2, f1[0] - f0[0]), Math.max(2, f1[1] - f0[1]), E.hex('#fdfdfd'));\n  });\n  for (const a of [player, ...cpu]) {\n    const x = a.dist * M, y = a.lane;\n    if (a.rig) {\n      a.rig.update(game.time > 0 ? 1 / 60 : 0, { x, y, z: 0, vx: a.v * M, vy: 0, facing: 0, run: clamp(a.v / 10, 0, 1) });\n      r.actor(x, y, 0, (g, ox, oy) => a.rig.draw(g, ox, oy, r.view));\n    }\n  }\n  r.text(`${PLAYER.name}`, 6, 8, '#fff6c8', { outline: '#1a0c10' });\n  r.text(`${(player.dist).toFixed(1)} m`, 6, 22, '#f7f2e0', { outline: '#1a0c10' });\n  r.text(`HYPE`, r.W - 80, 8, '#f7f2e0', { outline: '#1a0c10' });\n  r.overlay(g => {\n    E.ui.bar(g, r.W - 80, 20, 70, 8, hype, hype >= 1 ? '#ffd166' : '#f2b632');\n    if (turbo > 0) E.ui.bar(g, r.W - 80, 32, 70, 4, turbo / 2, '#ff7f50');\n  });\n  if (phase === 'intro') { centreText(r, 'SPRINT · 100m DASH', r.H * .32, '#fff6c8', 2); centreText(r, EVENTS.sprint.about, r.H * .5, '#f7f2e0'); }\n  if (phase === 'count') { const s = Math.ceil(COUNT - t); centreText(r, s > 0 ? String(s) : 'GO', r.H * .4, '#fff6c8', 4); }\n  if (phase === 'race' && raceT < .3) centreText(r, 'GO!', r.H * .4, '#ffd166', 4);\n  if (falseStart) speak(r, 'FALSE START! +0.7 s');\n  if (phase === 'done') speak(r, 'Press ✕ to continue');\n}\n\n/* ---- SKI JUMP: side view, inrun, take-off timing, flight balance ---- */\nconst LIP = 0, SHUT = { t: 0 };\nfunction groundZ(x) { return x < 0 ? 10 + .45 * -x : Math.max(-60, 10 - .0205 * x); }\nfunction makeSkijump(d) {\n  const ev = eventFrame('skijump');\n  const rand = rng(hashStr('skijump:' + (d.seed || 1)));\n  const wind = rand() * 6.28;\n  const cpu = NATIONS.slice(1, 4).map((n, i) => ({ n, dist: 0, score: 0, base: 92 + rand() * 10 }));\n  const me = { x: -600, z: groundZ(-600), vx: 0, vz: 0, ph: 'inrun', rate: 0, hits: [], b: 0, tumble: false, takeoffQ: 0, style: 0, glideAcc: 0, glideT: 0, landedAt: null, distM: 0, slide: 0 };\n  let t = 0, phase = 'intro', runT = 0, phaseT = 0, bar = 0, barOn = false, doneT = 0, pressedAt = null;\n  const tune = () => TUNE.sprintGain;\n  function barPos() { return Math.abs(((bar * 1.4) % 2) - 1); }     // triangle sweep 0..1..0\n  function takeoff(q) {\n    me.ph = 'air'; me.takeoffQ = q;\n    me.vz = (60 + 60 * q) * TUNE.jumpLift * (cheat.infinite ? 1.1 : 1);\n    me.vx = me.vx > 0 ? me.vx : 1; me.vx = Math.max(me.vx, 1);\n    A.sfx('boom', { vol: .4 });\n  }\n  function landing() {\n    me.ph = 'land'; me.landedAt = runT;\n    me.distM = Math.max(0, me.x / M);\n    me.style = Math.round((1 - Math.min(1, Math.abs(me.b))) * 10) + (me.telemark ? 6 : 0) + (me.tumble ? 0 : 4) + Math.round(me.takeoffQ * 6);\n    if (me.tumble) me.style = Math.max(0, me.style - 8);\n  }\n  function value() { return Math.round((me.distM + me.style * .4) * 10) / 10; }\n  function step(dt, p) {\n    runT += dt;\n    if (me.ph === 'inrun') {\n      const target = (14 + .7 * rateNow(dt, p)) * TUNE.sprintGain * (cheat.infinite ? 1.4 : 1);\n      me.vx += clamp(target - me.vx, -4 * dt, 4 * dt);\n      me.x += me.vx * M * dt;\n      if (me.x > -60) barOn = true;\n      if (me.x >= LIP) {\n        // no take-off press in time: a stumble at the lip\n        takeoff(0); me.bad = true;\n      }\n      me.z = groundZ(me.x);\n    } else if (me.ph === 'air') {\n      // the balance: wind gusts push, LEFT and RIGHT counter\n      const w = (Math.sin(runT * 1.9 + wind) * .6 + Math.sin(runT * 3.7 + 1) * .4) * TUNE.windStrength * TUNE.balanceWind * .8;\n      const k = (p.down('right') ? 1 : 0) - (p.down('left') ? 1 : 0);\n      if (d.attract) me.b = Math.sin(runT * 2.4) * .12;\n      else me.b += (w * dt + k * 1.4 * dt) - .6 * me.b * dt;\n      if (Math.abs(me.b) >= 1 && !me.tumble) { me.tumble = true; A.sfx('hit'); }\n      const glide = me.tumble ? 0 : 1 - Math.min(1, Math.abs(me.b));\n      me.glideAcc += glide * dt; me.glideT += dt;\n      me.x += me.vx * M * dt * (me.tumble ? .6 : 1);\n      me.vz -= 60 * dt * (1 - .3 * glide);\n      me.z += me.vz * dt;\n      if (!me.telemark && p.pressed('action')) me.telemark = false;\n      if (me.z <= groundZ(me.x) && me.vz < 0) {\n        me.z = groundZ(me.x); landing();\n        if (p.pressed('action') || d.attract) me.telemark = true;\n      }\n    } else if (me.ph === 'land') {\n      me.slide += dt;\n      me.vx = Math.max(0, me.vx - 8 * dt); me.x += me.vx * M * dt;\n      me.z = groundZ(me.x);\n      if (me.slide > 1.4) { me.ph = 'done'; }\n    }\n  }\n  function rateNow(dt, p) {\n    if (!d.attract) { if (p.pressed('mashL')) mashTo('L'); if (p.pressed('mashR')) mashTo('R'); }\n    else { me.autoT = (me.autoT || 0) + dt; if (me.autoT > .12) { me.autoT = 0; mashTo(me.autoK = me.autoK === 'L' ? 'R' : 'L'); } }\n    const cut = runT; me.hits = me.hits.filter(h => cut - h < 1);\n    return me.hits.length;\n  }\n  let lastK = null;\n  function mashTo(k) {\n    if (k === lastK) { me.hits.length = 0; return; }\n    me.hits.push(runT); lastK = k;\n  }\n  return {\n    ev, id: 'skijump', phaseName: () => phase,\n    update(dt, p) {\n      t += dt; ev.t = t; ev.phase = phase;\n      if (phase === 'intro') { if (t > INTRO) { phase = 'count'; t = 0; } }\n      else if (phase === 'count') { if (t > COUNT) { phase = 'run'; runT = 0; t = 0; A.sfx('start'); } }\n      else if (phase === 'run') {\n        bar += dt;\n        if (d.attract) {\n          if (barOn && barPos() < .02 + .0 && !me.bad && me.ph === 'inrun') { /* aim for the middle */ }\n          if (me.ph === 'inrun' && barOn && Math.abs(barPos() - .5) < .08) { takeoff(1); }\n        } else if (p.pressed('action') && me.ph === 'inrun' && barOn) {\n          const q = clamp(1 - Math.abs(barPos() - .5) * 2.4, 0, 1);\n          takeoff(q);\n        }\n        if (me.ph !== 'done') step(dt, p);\n        if (me.ph === 'done') { phase = 'done'; doneT = 0; }\n      } else if (phase === 'done') {\n        doneT += dt;\n        if (d.attract ? doneT > DONE_WAIT : (doneT > DONE_WAIT && p.pressed('confirm'))) commitResult('skijump', Object.assign(finish(), { attract: !!d.attract }));\n      }\n      ev.phase = phase; ev.hype = 0; ev.turbo = 0;\n    },\n    draw(r) { drawSkijump(r, me, phase, t, bar, barOn, barPos(), d); },\n    result() {\n      const score = value();\n      const ranks = cpu.map(c => ({ n: c.n, dist: c.base * (TUNE.cpuSkill) })).sort((a, b) => b.dist - a.dist);\n      const beat = ranks.filter(c => c.dist > score).length;\n      return { value: score, label: score.toFixed(1) + ' m', rank: beat + 1, rivals: ranks.map(c => ({ n: c.n, label: c.dist.toFixed(1) + ' m', value: c.dist })), style: me.style, tumble: me.tumble };\n    },\n  };\n  function finish() { return ev.result ? ev.result() : null; }\n}\nfunction drawSkijump(r, me, phase, t, bar, barOn, bp, d) {\n  r.sky(['#1a2a54', '#5d86c4', '#dfe8f5']);\n  const cx = Math.max(-400, Math.min(600, me.x)) + 160, cy = 0;\n  game.focus(me.x + 120, 0, 60);\n  // the ramp and the landing hill, drawn as screen-space shapes behind the athlete\n  r.overlay(g => {\n    const pts = [];\n    for (let x = -700; x <= 900; x += 24) { const p = r.w(x, 0, groundZ(x)); if (p) pts.push(p); }\n    const bottom = [r.w(900, 0, -80), r.w(-700, 0, -80)].filter(Boolean);\n    if (pts.length > 2) E.px.poly(g, pts.concat(bottom), E.hex('#eef4fb'));\n  });\n  if (phase === 'intro') { centreText(r, 'SKI JUMP · MOUNT GLORY', r.H * .3, '#fff6c8', 2); centreText(r, EVENTS.skijump.about, r.H * .45, '#f7f2e0'); }\n  if (phase === 'count') { const s = Math.ceil(COUNT - t); centreText(r, s > 0 ? String(s) : 'GO', r.H * .4, '#fff6c8', 4); }\n  if (phase === 'run' && barOn && me.ph === 'inrun') {\n    r.overlay(g => {\n      const w = r.W * .5, x0 = r.W * .25, y0 = r.H * .86;\n      E.ui.box(g, x0 - 6, y0 - 6, w + 12, 22, { bg: ['#0e1430', '#0e1430'] });\n      E.px.rect(g, x0, y0 + 4, w, 6, E.hex('#44506f'));\n      E.px.rect(g, x0 + w * .35, y0 + 4, w * .3, 6, E.hex('#7ee08a'));\n      E.px.rect(g, x0 + w * bp, y0 - 2, 3, 14, E.hex('#fff6c8'));\n    });\n  }\n  // the athlete\n  if (me.rig) me.rig.update(1 / 60, { x: me.x, y: 0, z: me.z, vx: me.vx * M, vy: 0, facing: 0, air: me.ph === 'air', run: clamp(me.vx / 25, 0, 1), pose: me.ph === 'done' && me.tumble ? 'down' : undefined });\n  if (me.rig) r.actor(me.x, 0, me.z, (g, ox, oy) => me.rig.draw(g, ox, oy, r.view));\n  r.text(`${PLAYER.name}`, 6, 8, '#fff6c8', { outline: '#1a0c10' });\n  if (me.ph === 'air') {\n    r.text(`BALANCE`, 6, 22, '#f7f2e0', { outline: '#1a0c10' });\n    r.overlay(g => E.ui.bar(g, 6, 32, 80, 6, .5 + me.b / 2, Math.abs(me.b) > .7 ? '#e63946' : '#7ee08a'));\n    speak(r, 'HOLD LEFT OR RIGHT TO BALANCE');\n  }\n  if (me.ph === 'land' || me.ph === 'done') {\n    centreText(r, `${me.distM.toFixed(1)} m`, r.H * .34, '#ffd166', 3);\n    if (me.tumble) centreText(r, 'OLYMPIYIKES!', r.H * .44, '#ff7f50', 2);\n  }\n  if (me.ph === 'done' && phase === 'done') speak(r, 'Press ✕ to continue');\n}\n\n/* ---- ARCHERY: overhead, a target and a sway ---- */\nconst RING_W = 6;\nfunction makeArchery(d) {\n  const ev = eventFrame('archery');\n  const rand = rng(hashStr('archery:' + (d.seed || 1)));\n  const wind = rand() * 6.28;\n  const cpuShots = NATIONS.slice(1, 4).map((n, i) => ({ n, score: 0, base: 6.5 + rand() * 2 }));\n  let t = 0, phase = 'intro', doneT = 0, aT = 0, arrows = [], nudge = [0, 0], shots = [];\n  const sway = () => {\n    const a = 26 * TUNE.swayAmount, w = 14 * TUNE.windStrength;\n    return [Math.sin(aT * 1.3) * a + Math.sin(aT * .47 + wind) * w, Math.cos(aT * 1.1) * a * .7 + Math.sin(aT * .63 + wind) * w * .5];\n  };\n  function ringScore(dist) { return clamp(10 - Math.floor(dist / RING_W), 0, 10); }\n  function release(dist) {\n    const sc = cheat.infinite ? 10 : ringScore(dist);\n    shots.push({ x: dist[0], y: dist[1], sc, t: 0 });\n    A.sfx(sc >= 9 ? 'coin' : 'hit', { vol: .6 });\n    if (shots.length >= 3) { phase = 'done'; doneT = 0; }\n  }\n  return {\n    ev, id: 'archery',\n    update(dt, p) {\n      t += dt; aT += dt; ev.t = t; ev.phase = phase;\n      if (phase === 'intro') { if (t > INTRO) { phase = 'count'; t = 0; } }\n      else if (phase === 'count') { if (t > COUNT) { phase = 'shoot'; t = 0; A.sfx('start'); } }\n      else if (phase === 'shoot') {\n        if (!d.attract) {\n          const k = (p.down('right') ? 1 : 0) - (p.down('left') ? 1 : 0);\n          const j = (p.down('down') ? 1 : 0) - (p.down('up') ? 1 : 0);\n          nudge = [clamp(nudge[0] + k * 60 * dt, -20, 20), clamp(nudge[1] + j * 60 * dt, -20, 20)];\n          if (p.pressed('action') || p.pressed('confirm')) releaseNow();\n        } else {\n          // the attract pilot: release when the sway passes the centre\n          const s = sway(); if (Math.hypot(s[0], s[1]) < 3) releaseNow();\n        }\n        if (cheat.infinite) { /* the cheat gives a ten every arrow */ }\n      } else if (phase === 'done') {\n        doneT += dt;\n        if (d.attract ? doneT > DONE_WAIT : (doneT > DONE_WAIT && p.pressed('confirm'))) commitResult('archery', Object.assign(ev.result(), { attract: !!d.attract }));\n      }\n      for (const s of shots) s.t += dt;\n    },\n    draw(r) { drawArchery(r, shots, sway(), nudge, phase, t, d); },\n    result() {\n      const total = shots.reduce((a, s) => a + s.sc, 0);\n      const ranks = cpuShots.map(c => ({ n: c.n, score: Math.round(c.base * 3 * TUNE.cpuSkill), value: 0 })).map(c => ({ ...c, value: c.score }));\n      const beat = ranks.filter(c => c.value > total).length;\n      return { value: total, label: total + ' / 30', rank: beat + 1, rivals: ranks.map(c => ({ n: c.n, label: c.score + ' / 30', value: c.score })), arrows: shots.map(s => s.sc) };\n    },\n  };\n  function releaseNow() {\n    if (shots.length >= 3 || phase !== 'shoot') return;\n    const s = sway();\n    release([s[0] + nudge[0], s[1] + nudge[1]]);\n  }\n}\nfunction drawArchery(r, shots, s, nudge, phase, t, d) {\n  r.overlay(g => E.px.rect(g, 0, 0, r.W, r.H, E.hex('#7fb36a')));\n  const cx = r.W * .66, cy = r.H * .5;\n  r.overlay(g => {\n    const rings = [['#f4f4f4', 10], ['#222222', 8], ['#3a86ff', 6], ['#e63946', 4], ['#ffd166', 2]];\n    for (let i = 0; i < 10; i++) {\n      const rad = RING_W * (10 - i) * .9 + 6;\n      const col = i < 2 ? '#ffd166' : i < 4 ? '#e63946' : i < 6 ? '#3a86ff' : i < 8 ? '#222222' : '#f4f4f4';\n      E.px.disc(g, cx, cy, rad, E.hex(col));\n    }\n    E.px.disc(g, cx, cy, 2, E.hex('#ffd166'));\n    // the sway, with the nudge\n    const ax = cx + s[0] * (r.W / 320) + nudge[0] * (r.W / 320), ay = cy + s[1] * (r.H / 240) + nudge[1] * (r.H / 240);\n    E.px.line(g, ax - 6, ay, ax + 6, ay, E.hex('#ffffff'), 1); E.px.line(g, ax, ay - 6, ax, ay + 6, E.hex('#ffffff'), 1);\n    for (const sh of shots) {\n      E.px.disc(g, cx + sh.x * (r.W / 320), cy + sh.y * (r.H / 240), 2, E.hex('#1a1a1a'));\n    }\n  });\n  r.text(`ARROWS ${shots.length} / 3`, 6, 8, '#f7f2e0', { outline: '#1a0c10' });\n  const total = shots.reduce((a, b) => a + b.sc, 0);\n  r.text(`TOTAL ${total}`, 6, 22, '#ffd166', { outline: '#1a0c10' });\n  if (phase === 'intro') { centreText(r, 'ARCHERY · BULLSEYE LAWN', r.H * .3, '#fff6c8', 2); centreText(r, EVENTS.archery.about, r.H * .45, '#f7f2e0'); }\n  if (phase === 'count') { const sec = Math.ceil(COUNT - t); centreText(r, sec > 0 ? String(sec) : 'SHOOT', r.H * .4, '#fff6c8', 4); }\n  if (phase === 'shoot' && shots.length < 3) speak(r, btn('action', 'release'));\n  for (const sh of shots.slice(-1)) if (sh.t < .8) centreText(r, `${sh.sc}`, r.H * .72, '#ffd166', 3);\n  if (phase === 'done') speak(r, 'Press ✕ to continue');\n}\n\n/* ---- the event scene: intro, count, play, done. The makers above keep the state of one meet. ---- */\nlet activeEvent = null;\nconst MAKERS = { sprint: makeSprint, skijump: makeSkijump, archery: makeArchery };\nfunction startEvent(data) {\n  const id = data.id;\n  if (!MAKERS[id]) throw new Error('unknown event ' + id);\n  activeEvent = MAKERS[id](data);\n  activeEvent.attract = !!data.attract;\n  activeEvent.id = id;\n  return activeEvent;\n}\nfunction eventScene() {\n  return {\n    pausable: true,\n    enter(d) {\n      cur = { name: 'ev', data: d };\n      const ev = EVENTS[d.id];\n      game.setView(ev.view);\n      const e = startEvent(Object.assign({ seed: d.seed || (meet ? meet.seed : 1) }, d));\n      e.frame = null;\n      A.music(d.attract ? E.songs.adventure : E.songs.adventure, {});\n    },\n    update(dt) {\n      if (d_attract() && game.input.anyPressed()) return go('title');\n      const p = game.input;\n      activeEvent.update(dt, p);\n    },\n    draw(r) {\n      activeEvent.draw(r);\n      if (d_attract()) r.text('ATTRACT · PRESS ANY BUTTON', r.W / 2, r.H - 12, '#ffd166', { align: 'center', outline: '#1a0c10' });\n    },\n  };\n  function d_attract() { return !!(activeEvent && activeEvent.attract); }\n}\n\n/* ---- results, medals, records, how to play, about, dev ---- */\nfunction resultsScene() {\n  return {\n    enter(d) { cur = { name: 'results', data: d }; A.music(E.songs.victory, { loop: false }); },\n    update(dt) { if (game.input.pressed('confirm') || game.input.pressed('cancel')) go('title'); },\n    draw(r) {\n      r.sky(['#101848', '#402a70']);\n      const { id, result } = cur.data;\n      const ev = EVENTS[id];\n      centreText(r, ev.name, 22, '#fff6c8', 2);\n      centreText(r, `${PLAYER.name}  ·  ${result.label}`, 56, '#f7f2e0', 2);\n      centreText(r, `RANK ${result.rank} OF 4${result.newBest ? '   NEW RECORD!' : ''}`, 84, result.newBest ? '#ffd166' : '#f7f2e0');\n      panel(r, r.W * .2, 110, r.W * .6, 90);\n      let y = 120;\n      for (const rv of result.rivals) { r.text(rv.n.name, r.W * .3, y, rv.n.col, { outline: '#1a0c10' }); r.text(rv.label, r.W * .7, y, '#f7f2e0', { align: 'right', outline: '#1a0c10' }); y += 16; }\n      centreText(r, `${btn('confirm', 'back to the title')}  ·  RECORD ${record(id) ? record(id).label : '—'}`, r.H - 26, '#fff6c8');\n    },\n  };\n}\nfunction medalsScene() {\n  return {\n    enter(d) { cur = { name: 'medals', data: d }; const rows = medalRows(); cur.rows = rows; },\n    update(dt) { if (game.input.pressed('confirm') || game.input.pressed('cancel')) go('title'); },\n    draw(r) {\n      r.sky(['#101848', '#402a70']);\n      centreText(r, 'QUICK GAMES · MEDAL TABLE', 20, '#fff6c8', 2);\n      panel(r, r.W * .12, 52, r.W * .76, r.H * .62);\n      r.text('NATION', r.W * .2, 60, '#ffd166'); r.text('G', r.W * .58, 60, '#ffd166'); r.text('S', r.W * .66, 60, '#ffd166'); r.text('B', r.W * .74, 60, '#ffd166');\n      let y = 78;\n      for (const row of cur.rows) {\n        r.text(row.n.name, r.W * .2, y, row.n.col, { outline: '#1a0c10' });\n        r.text(String(row.g), r.W * .58, y, '#f7f2e0'); r.text(String(row.s), r.W * .66, y, '#f7f2e0'); r.text(String(row.b), r.W * .74, y, '#f7f2e0');\n        y += 16;\n      }\n      centreText(r, btn('confirm', 'back to the title'), r.H - 26, '#fff6c8');\n    },\n  };\n}\nfunction medalRows() {\n  // each event's ranking: the player's nation's place, and seeded placings for the other seven\n  const tally = Object.fromEntries(NATIONS.map(n => [n.id, { n, g: 0, s: 0, b: 0 }]));\n  for (const id of ORDER) {\n    const res = meet && meet.results[id];\n    const seed = hashStr('medals:' + id + ':' + (meet ? meet.seed : 1));\n    const r = rng(seed);\n    const order = NATIONS.map(n => ({ n, v: n.id === PLAYER.id && res ? res.value : r() * 100 }));\n    order.sort((a, b) => (EVENTS[id].best === 'min' ? a.v - b.v : b.v - a.v));\n    ['g', 's', 'b'].forEach((k, i) => tally[order[i].n.id][k]++);\n  }\n  return Object.values(tally).sort((a, b) => b.g - a.g || b.s - a.s || b.b - a.b);\n}\nfunction recordsScene() {\n  return {\n    enter() { cur = { name: 'records', data: null }; },\n    update() { if (game.input.pressed('confirm') || game.input.pressed('cancel')) go('menu'); },\n    draw(r) {\n      r.sky(['#101848', '#402a70']);\n      centreText(r, 'RECORDS', 20, '#fff6c8', 2);\n      panel(r, r.W * .12, 52, r.W * .76, r.H * .6);\n      let y = 66;\n      for (const id of ORDER) {\n        const rec = record(id);\n        r.text(EVENTS[id].name, r.W * .2, y, '#ffd166', { outline: '#1a0c10' });\n        r.text(rec ? `${rec.label}  (${PLAYER.name})` : 'NO RECORD YET', r.W * .5, y, '#f7f2e0', { outline: '#1a0c10' });\n        y += 26;\n      }\n      r.text('Records are saved in this browser.', r.W * .2, y + 10, '#c9c9d6');\n      centreText(r, btn('confirm', 'back'), r.H - 26, '#fff6c8');\n    },\n  };\n}\nfunction howtoScene() {\n  return {\n    enter() { cur = { name: 'howto', data: null }; },\n    update() { if (game.input.pressed('confirm') || game.input.pressed('cancel')) go('menu'); },\n    draw(r) {\n      r.sky(['#101848', '#402a70']);\n      centreText(r, 'HOW TO PLAY', 16, '#fff6c8', 2);\n      let y = 46;\n      const lines = [\n        `${btn('mashL', 'and')} ${game.input.label('mashR')}: mash in turn (a repeat of the same button stumbles you)`,\n        `${btn('turbo', 'Yikes Turbo')}: spend a full HYPE meter for a burst`,\n        `${btn('action', 'take off / release')}: the one press that matters in the ski jump and archery`,\n        `Left and right: balance in the air, and nudge the arrow`,\n        'Yikes: a stumble or a tumble is funny, and quick to recover from',\n      ];\n      for (const l of lines) { r.text(l, r.W * .08, y, '#f7f2e0'); y += 18; }\n      y += 6;\n      for (const id of ORDER) { r.text(EVENTS[id].name + ' · ' + EVENTS[id].rule, r.W * .08, y, '#ffd166'); y += 16; r.text(EVENTS[id].about, r.W * .1, y, '#c9c9d6'); y += 20; }\n      centreText(r, btn('confirm', 'back'), r.H - 26, '#fff6c8');\n    },\n  };\n}\nfunction aboutScene() {\n  return {\n    enter() { cur = { name: 'about', data: null }; },\n    update() { if (game.input.pressed('confirm') || game.input.pressed('cancel')) go('menu'); },\n    draw(r) {\n      r.sky(['#101848', '#402a70']);\n      centreText(r, 'ABOUT & CREDITS', 12, '#fff6c8', 2);\n      const pg = Math.floor((game.time || 0) / 6) % ABOUT.length;\n      panel(r, r.W * .08, 36, r.W * .84, r.H * .72);\n      let y = 46;\n      r.text(ABOUT[pg].title, r.W * .12, y, '#ffd166', { outline: '#1a0c10' }); y += 18;\n      for (const l of ABOUT[pg].lines) { r.text(l, r.W * .12, y, '#f7f2e0'); y += 13; }\n      centreText(r, `${btn('confirm', 'back')}  ·  page ${pg + 1} of ${ABOUT.length}`, r.H - 26, '#fff6c8');\n    },\n  };\n}\n/* ABOUT: the sections the task asks for (filled in below from the build's own record) */\nconst ABOUT = [];\n\n/* ---- the title, the menu, attract ---- */\nconst touchOnly = () => typeof matchMedia === 'function' && matchMedia('(any-hover: none)').matches && matchMedia('(any-pointer: coarse)').matches;\nlet idle = 0, menuObj = null, idleTarget = 'attract';\nfunction titleScene() {\n  return {\n    enter() { cur = { name: 'title', data: null }; idle = 0; A.music(E.songs.title); },\n    update(dt) {\n      if (game.input.anyPressed()) idle = 0; else idle += dt;\n      if (touchOnly()) return;\n      if (game.input.pressed('confirm') || game.input.pressed('start')) { A.sfx('select'); return go('menu'); }\n      if (idle > IDLE_TO_ATTRACT) return go('attract');\n    },\n    draw(r) {\n      r.sky(['#101848', '#402a70', '#f7d28a']);\n      r.overlay(g => { E.font.title(g, TITLE, r.W / 2, r.H * .18, { scale: 3, align: 'center', colors: ['#fff6c8', '#ffd36a', '#e07a2a'], outline: '#1a0c10', depth: 3, depthColor: '#6a2a1a' }); });\n      centreText(r, 'Faster. Higher. Yikes.', r.H * .42, '#f7f2e0', 1);\n      if (touchOnly()) { centreText(r, 'Controller or keyboard required', r.H * .6, '#ffd166', 1); }\n      else if (Math.floor((game.real || 0) * 2) % 2 === 0) centreText(r, `PRESS ${game.input.label('confirm').toUpperCase()} TO START`, r.H * .6, '#fff6c8', 1);\n      centreText(r, 'MENU', r.H * .72, '#f7f2e0');\n      r.text('© OLYMPIYIKES · DEMO', 4, r.H - 12, '#c9c9d6');\n    },\n  };\n}\nfunction menuScene() {\n  return {\n    enter() {\n      cur = { name: 'menu', data: null }; idle = 0;\n      const items = [{ label: 'QUICK GAMES' }, { label: 'SINGLE EVENT' }, { label: 'RECORDS' }, { label: 'HOW TO PLAY' }, { label: 'ABOUT & CREDITS' }, { label: 'BACK' }];\n      menuObj = new E.Menu(game, items.map(i => i.label), {\n        x: 'center', y: 80, title: 'THE GAMES',\n        onPick(i) {\n          idle = 0; A.sfx('confirm');\n          if (i === 0) { meet = { quick: true, list: ORDER.slice(), i: 0, results: {}, seed: (Date.now() & 0xffff) + 1 }; return go('ev', { id: meet.list[0], quick: true }); }\n          if (i === 1) return go('pick');\n          if (i === 2) return go('records');\n          if (i === 3) return go('howto');\n          if (i === 4) return go('about');\n          return go('title');\n        },\n        onCancel() { go('title'); },\n      });\n    },\n    update(dt) {\n      if (game.input.anyPressed()) idle = 0; else idle += dt;\n      menuObj.update(dt);\n      if (idle > IDLE_TO_ATTRACT) go('attract');\n    },\n    draw(r) { r.sky(['#101848', '#402a70']); menuObj.draw(r); },\n  };\n}\nfunction pickScene() {\n  return {\n    enter() {\n      cur = { name: 'pick', data: null };\n      const items = ORDER.map(id => EVENTS[id].name).concat(['BACK']);\n      menuObj = new E.Menu(game, items, {\n        x: 'center', y: 80, title: 'SINGLE EVENT',\n        onPick(i) { if (i >= ORDER.length) return go('menu'); meet = null; go('ev', { id: ORDER[i], seed: (Date.now() & 0xffff) + 1 }); },\n        onCancel() { go('menu'); },\n      });\n    },\n    update(dt) { menuObj.update(dt); },\n    draw(r) { r.sky(['#101848', '#402a70']); menuObj.draw(r); },\n  };\n}\nfunction attractScene() {\n  return {\n    enter() { cur = { name: 'attract', data: null }; attractIdx = 0; attractNext(true); },\n    update() { if (game.input.anyPressed()) go('title'); },\n    draw(r) {},\n  };\n}\nlet attractIdx = 0;\nfunction attractNext(first) {\n  if (!first) attractIdx++;\n  if (attractIdx >= ORDER.length) return go('title');\n  meet = null;\n  const id = ORDER[attractIdx];\n  go('ev', { id, attract: true, seed: 777 + attractIdx });\n}\n\n/* ---- dev mode: the balance sliders, cheats, reset ---- */\nlet devRows = [];\nfunction openDev() { go('dev', { from: cur }); }\nfunction devScene() {\n  return {\n    enter(d) {\n      cur = { name: 'dev', data: d }; devSel = 0;\n      devRows = Object.keys(TUNE_RANGE).map(k => ({ k, ...TUNE_RANGE[k] }));\n      devRows.push({ k: 'cheat', label: 'Cheat: infinite HYPE, perfect timing' });\n      devRows.push({ k: 'reset', label: 'Reset all to defaults' });\n    },\n    update() {\n      const p = game.input;\n      if (p.pressed('cancel') || p.pressed('pause')) { const from = cur.data && cur.data.from; return from ? go(from.name, from.data) : go('title'); }\n      if (p.pressed('up')) devSel = (devSel + devRows.length - 1) % devRows.length;\n      if (p.pressed('down')) devSel = (devSel + 1) % devRows.length;\n      const row = devRows[devSel];\n      if (row.k === 'cheat' && p.pressed('confirm')) { cheat.infinite = !cheat.infinite; A.sfx('select'); }\n      if (row.k === 'reset' && p.pressed('confirm')) { Object.assign(TUNE, TUNE_DEFAULTS); cheat.infinite = false; saveTune(); A.sfx('confirm'); }\n      if (TUNE_RANGE[row.k]) {\n        const [lo, hi, step] = TUNE_RANGE[row.k];\n        const dir = (p.pressed('right') ? 1 : 0) - (p.pressed('left') ? 1 : 0);\n        if (dir) { TUNE[row.k] = clamp(Math.round((TUNE[row.k] + dir * step) / step) * step, lo, hi); saveTune(); }\n      }\n    },\n    draw(r) {\n      r.sky(['#101848', '#402a70']);\n      centreText(r, 'DEV MODE', 8, '#ffd166', 2);\n      let y = 36;\n      devRows.forEach((row, i) => {\n        const sel = i === devSel;\n        if (sel) E.ui.box(r.W && undefined, 0, 0, 0, 0, {});\n        const label = row.label || row.k;\n        r.text((sel ? '▸ ' : '  ') + label, r.W * .08, y, sel ? '#fff6c8' : '#c9c9d6');\n        if (TUNE_RANGE[row.k]) {\n          const v = TUNE[row.k], [lo, hi] = TUNE_RANGE[row.k];\n          r.overlay(g => { E.px.rect(g, r.W * .62, y + 3, r.W * .26, 4, E.hex('#44506f')); E.px.rect(g, r.W * .62 + r.W * .26 * (v - lo) / (hi - lo) - 2, y, 4, 10, E.hex('#f2b632')); });\n          r.text(v.toFixed(2), r.W * .9, y, '#f7f2e0', { align: 'right' });\n        } else if (row.k === 'cheat') r.text(cheat.infinite ? 'ON' : 'OFF', r.W * .9, y, '#f7f2e0', { align: 'right' });\n        y += 16;\n      });\n      centreText(r, '↑↓ choose · ←→ adjust · ✕ toggle/reset · ○ back', r.H - 26, '#c9c9d6');\n    },\n  };\n}\nlet devSel = 0;\nfunction saveTune() { E.store.set('oly:tune', TUNE); }\n\n/* ---- scene registry and boot ---- */\nconst scenes = {\n  title: titleScene(), menu: menuScene(), pick: pickScene(), ev: eventScene(), results: resultsScene(),\n  medals: medalsScene(), records: recordsScene(), howto: howtoScene(), about: aboutScene(), dev: devScene(), attract: attractScene(),\n};\ngame.start({ scene: 'title', scenes });\nwindow.__oly = { game, TUNE, cheat, EVENTS, ORDER, NATIONS, go: (n, d) => go(n, d), startEvent, get meet() { return meet; } };\ngame.debug = { snapshot: () => ({ scene: cur.name, tune: { ...TUNE }, cheat: { ...cheat }, idle, activeEvent: activeEvent && { id: activeEvent.id, phase: activeEvent.ev.phase, t: activeEvent.ev.t } }), go, startEvent };\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_01WPJ8cfMWuv5hnGVxzpBxgD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
