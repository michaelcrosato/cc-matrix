"   }","-  function rateNow(dt, p) {","-    if (!d.attract) { if (p.pressed('mashL')) mashTo('L'); if (p.pressed('mashR')) mashTo('R'); }","-    else { me.autoT = (me.autoT || 0) + dt; if (me.autoT > .12) { me.autoT = 0; mashTo(me.autoK = me.autoK === 'L' ? 'R' : 'L'); } }","-    const cut = runT; me.hits = me.hits.filter(h => cut - h < 1);","-    return me.hits.length;","-  }","-  let lastK = null;","-  function mashTo(k) {","-    if (k === lastK) { me.hits.length = 0; return; }","-    me.hits.push(runT); lastK = k;","-  }","   return {","-    ev, id: 'skijump', phaseName: () => phase,","+    id: 'skijump', ev, attract: !!d.attract,","     update(dt, p) {","-      t += dt; ev.t = t; ev.phase = phase;","-      if (phase === 'intro') { if (t > INTRO) { phase = 'count'; t = 0; } }","-      else if (phase === 'count') { if (t > COUNT) { phase = 'run'; runT = 0; t = 0; A.sfx('start'); } }","-      else if (phase === 'run') {","-        bar += dt;","-        if (d.attract) {","-          if (barOn && barPos() < .02 + .0 && !me.bad && me.ph === 'inrun') { /* aim for the middle */ }","-          if (me.ph === 'inrun' && barOn && Math.abs(barPos() - .5) < .08) { takeoff(1); }","-        } else if (p.pressed('action') && me.ph === 'inrun' && barOn) {","-          const q = clamp(1 - Math.abs(barPos() - .5) * 2.4, 0, 1);","-          takeoff(q);","+      ev.t += dt;","+      if (ev.phase === 'intro') { if (ev.t > INTRO) { ev.phase = 'count'; ev.t = 0; } }","+      else if (ev.phase === 'count') {","+        if (ev.t > COUNT) { ev.phase = 'run'; ev.t = 0; ev.runT = 0; A.sfx('confirm'); }","+        else { const s = Math.ceil(COUNT - ev.t); if (s !== ev.cueNum && s >= 1) { ev.cueNum = s; A.sfx('blip'); } }","+      } else if (ev.phase === 'run') {","+        ev.bar += dt;","+        if (me.ph === 'inrun' && ev.barOn) {","+          if (d.attract && Math.abs(barPos() - .5) < .08) takeoff(1);","+          else if (!d.attract && p.pressed('action')) takeoff(clamp(1 - Math.abs(barPos() - .5) * 2.4, 0, 1));","         }","         if (me.ph !== 'done') step(dt, p);","-        if (me.ph === 'done') { phase = 'done'; doneT = 0; }","-      } else if (phase === 'done') {","-        doneT += dt;","-        if (d.attract ? doneT > DONE_WAIT : (doneT > DONE_WAIT && p.pressed('confirm'))) commitResult('skijump', Object.assign(finish(), { attract: !!d.attract }));","-      }","-      ev.phase = phase; ev.hype = 0; ev.turbo = 0;","+        if (me.ph === 'done') { ev.phase = 'done'; ev.doneT = 0; }","+      } else if (ev.phase === 'done') ev.doneT += dt;","+      me.rig.update(dt, { x: me.x, y: 0, z: me.z, vx: me.vx * M, vy: 0, facing: 0, air: me.ph === 'air', run: clamp(me.vx / 25, 0, 1),","+        pose: me.ph === 'done' && me.tumble ? 'down' : undefined });","+      game.focus(me.x + 120, 0, 60);","     },","-    draw(r) { drawSkijump(r, me, phase, t, bar, barOn, barPos(), d); },","+    draw(r) { drawSkijump(r, me, ev, barPos()); },","+    ready: () => ev.phase === 'done' && ev.doneT > DONE_WAIT,","     result() {","-      const score = value();","-      const ranks = cpu.map(c => ({ n: c.n, dist: c.base * (TUNE.cpuSkill) })).sort((a, b) => b.dist - a.dist);","-      const beat = ranks.filter(c => c.dist > score).length;","-      return { value: score, label: score.toFixed(1) + ' m', rank: beat + 1, rivals: ranks.map(c => ({ n: c.n, label: c.dist.toFixed(1) + ' m', value: c.dist })), style: me.style, tumble: me.tumble };","+      const score = Math.round((me.distM + me.style * .4) * 10) / 10;","+      const rivals = cpu.map(c => ({ n: c.n, dist: c.base * TUNE.cpuSkill })).sort((a, b) => b.dist - a.dist);","+      const rank = rivals.filter(c => c.dist > score).length + 1;","+      return { value: score, label: score.toFixed(1) + ' m', rank, rivals: rivals.map(c => ({ n: c.n, label: c.dist.toFixed(1) + ' m' })), style: me.style, tumble: me.tumble };","     },","   };","-  function finish() { return ev.result ? ev.result() : null; }"," }","-function drawSkijump(r, me, phase, t, bar, barOn, bp, d) {","+function drawSkijump(r, me, ev, bp) {","   r.sky(['#1a2a54', '#5d86c4', '#dfe8f5']);","-  const cx = Math.max(-400, Math.min(600, me.x)) + 160, cy = 0;","-  game.focus(me.x + 120, 0, 60);","-  // the ramp and the landing hill, drawn as screen-space shapes behind the athlete","-  r.overlay(g => {","-    const pts = [];","-    for (let x = -700; x <= 900; x += 24) { const p = r.w(x, 0, groundZ(x)); if (p) pts.push(p); }","-    const bottom = [r.w(900, 0, -80), r.w(-700, 0, -80)].filter(Boolean);","-    if (pts.length > 2) E.px.poly(g, pts.concat(bottom), E.hex('#eef4fb'));","-  });","-  if (phase === 'intro') { centreText(r, 'SKI JUMP · MOUNT GLORY', r.H * .3, '#fff6c8', 2); centreText(r, EVENTS.skijump.about, r.H * .45, '#f7f2e0'); }","-  if (phase === 'count') { const s = Math.ceil(COUNT - t); centreText(r, s > 0 ? String(s) : 'GO', r.H * .4, '#fff6c8', 4); }","-  if (phase === 'run' && barOn && me.ph === 'inrun') {","+  // the slope: a row of depth-sorted boxes, from the inrun, over the lip, down the landing hill","+  for (let x = -700; x < 900; x += 24) {","+    const z = groundZ(x + 12);","+    r.queue(x + 12, 0, z / 2, g => r.box(g, x, -40, -80, x + 24, 40, z, E.hex('#f2f7fc'), E.hex('#9fb7d2')));","+  }","+  if (me.rig) r.actor(me.x, 0, me.z, (g, ox, oy) => me.rig.draw(g, ox, oy, r.view));","+  r.text(PLAYER.name, 6, 8, '#fff6c8', { outline: '#1a0c10' });","+  if (ev.phase === 'intro') { centreText(r, 'SKI JUMP · MOUNT GLORY', r.H * .3, '#fff6c8', 2); centreText(r, EVENTS.skijump.about, r.H * .45); }","+  if (ev.phase === 'count') centreText(r, cue(Math.ceil(COUNT - ev.t)), r.H * .4, '#fff6c8', 4);","+  if (ev.phase === 'run' && ev.barOn && me.ph === 'inrun') {","     r.overlay(g => {","       const w = r.W * .5, x0 = r.W * .25, y0 = r.H * .86;","-      E.ui.box(g, x0 - 6, y0 - 6, w + 12, 22, { bg: ['#0e1430', '#0e1430'] });","+      E.px.rect(g, x0 - 4, y0 - 4, w + 8, 18, E.hex('#0e1430'));","       E.px.rect(g, x0, y0 + 4, w, 6, E.hex('#44506f'));","       E.px.rect(g, x0 + w * .35, y0 + 4, w * .3, 6, E.hex('#7ee08a'));","       E.px.rect(g, x0 + w * bp, y0 - 2, 3, 14, E.hex('#fff6c8'));","     });","+    speak(r, `${btn('action', 'take off')} on the green`);","   }","-  // the athlete","-  if (me.rig) me.rig.update(1 / 60, { x: me.x, y: 0, z: me.z, vx: me.vx * M, vy: 0, facing: 0, air: me.ph === 'air', run: clamp(me.vx / 25, 0, 1), pose: me.ph === 'done' && me.tumble ? 'down' : undefined });","-  if (me.rig) r.actor(me.x, 0, me.z, (g, ox, oy) => me.rig.draw(g, ox, oy, r.view));","-  r.text(`${PLAYER.name}`, 6, 8, '#fff6c8', { outline: '#1a0c10' });","   if (me.ph === 'air') {","-    r.text(`BALANCE`, 6, 22, '#f7f2e0', { outline: '#1a0c10' });","+    r.text('BALANCE', 6, 22, '#f7f2e0', { outline: '#1a0c10' });","     r.overlay(g => E.ui.bar(g, 6, 32, 80, 6, .5 + me.b / 2, Math.abs(me.b) > .7 ? '#e63946' : '#7ee08a'));","     speak(r, 'HOLD LEFT OR RIGHT TO BALANCE');","   }"]},{"oldStart":404,"oldLines":138,"newStart":329,"newLines":122,"lines":["     centreText(r, `${me.distM.toFixed(1)} m`, r.H * .34, '#ffd166', 3);","     if (me.tumble) centreText(r, 'OLYMPIYIKES!', r.H * .44, '#ff7f50', 2);","   }","-  if (me.ph === 'done' && phase === 'done') speak(r, 'Press ✕ to continue');","+  if (ev.phase === 'done') speak(r, `${btn('confirm', 'to continue')}`);"," }"," ","-/* ---- ARCHERY: overhead, a target and a sway ---- */","-const RING_W = 6;","+/* ==================== ARCHERY: overhead, a target and a sway ==================== */","+const RING = 6;                                     // virtual pixels per ring (ten rings: 60 px)"," function makeArchery(d) {","-  const ev = eventFrame('archery');","-  const rand = rng(hashStr('archery:' + (d.seed || 1)));","+  const rand = rng(hashStr('archery:' + d.seed));","   const wind = rand() * 6.28;","-  const cpuShots = NATIONS.slice(1, 4).map((n, i) => ({ n, score: 0, base: 6.5 + rand() * 2 }));","-  let t = 0, phase = 'intro', doneT = 0, aT = 0, arrows = [], nudge = [0, 0], shots = [];","+  const cpu = NATIONS.slice(1, 4).map(n => ({ n, base: 6.5 + rand() * 2 }));","+  const ev = { t: 0, aT: 0, phase: 'intro', doneT: 0, shots: [], nudge: [0, 0] };","   const sway = () => {","     const a = 26 * TUNE.swayAmount, w = 14 * TUNE.windStrength;","-    return [Math.sin(aT * 1.3) * a + Math.sin(aT * .47 + wind) * w, Math.cos(aT * 1.1) * a * .7 + Math.sin(aT * .63 + wind) * w * .5];","+    return [Math.sin(ev.aT * 1.3) * a + Math.sin(ev.aT * .47 + wind) * w, Math.cos(ev.aT * 1.1) * a * .7 + Math.sin(ev.aT * .63 + wind) * w * .5];","   };","-  function ringScore(dist) { return clamp(10 - Math.floor(dist / RING_W), 0, 10); }","-  function release(dist) {","-    const sc = cheat.infinite ? 10 : ringScore(dist);","-    shots.push({ x: dist[0], y: dist[1], sc, t: 0 });","+  function release() {","+    if (ev.phase !== 'shoot' || ev.shots.length >= 3) return;","+    const s = sway();","+    const x = s[0] + ev.nudge[0], y = s[1] + ev.nudge[1];","+    const dist = Math.hypot(x, y);","+    const sc = cheat.infinite ? 10 : clamp(10 - Math.floor(dist / RING), 0, 10);","+    ev.shots.push({ x, y, sc, t: 0 });","     A.sfx(sc >= 9 ? 'coin' : 'hit', { vol: .6 });","-    if (shots.length >= 3) { phase = 'done'; doneT = 0; }","+    if (ev.shots.length >= 3) { ev.phase = 'done'; ev.doneT = 0; }","   }","   return {","-    ev, id: 'archery',","+    id: 'archery', ev, attract: !!d.attract,","     update(dt, p) {","-      t += dt; aT += dt; ev.t = t; ev.phase = phase;","-      if (phase === 'intro') { if (t > INTRO) { phase = 'count'; t = 0; } }","-      else if (phase === 'count') { if (t > COUNT) { phase = 'shoot'; t = 0; A.sfx('start'); } }","-      else if (phase === 'shoot') {","-        if (!d.attract) {","+      ev.t += dt; ev.aT += dt;","+      if (ev.phase === 'intro') { if (ev.t > INTRO) { ev.phase = 'count'; ev.t = 0; } }","+      else if (ev.phase === 'count') {","+        if (ev.t > COUNT) { ev.phase = 'shoot'; ev.t = 0; A.sfx('confirm'); }","+        else { const s = Math.ceil(COUNT - ev.t); if (s !== ev.cueNum && s >= 1) { ev.cueNum = s; A.sfx('blip'); } }","+      } else if (ev.phase === 'shoot') {","+        if (d.attract) { const s = sway(); if (Math.hypot(s[0], s[1]) < 3) release(); }","+        else {","           const k = (p.down('right') ? 1 : 0) - (p.down('left') ? 1 : 0);","           const j = (p.down('down') ? 1 : 0) - (p.down('up') ? 1 : 0);","-          nudge = [clamp(nudge[0] + k * 60 * dt, -20, 20), clamp(nudge[1] + j * 60 * dt, -20, 20)];","-          if (p.pressed('action') || p.pressed('confirm')) releaseNow();","-        } else {","-          // the attract pilot: release when the sway passes the centre","-          const s = sway(); if (Math.hypot(s[0], s[1]) < 3) releaseNow();","+          ev.nudge = [clamp(ev.nudge[0] + k * 60 * dt, -20, 20), clamp(ev.nudge[1] + j * 60 * dt, -20, 20)];","+          if (p.pressed('action') || p.pressed('confirm')) release();","         }","-        if (cheat.infinite) { /* the cheat gives a ten every arrow */ }","-      } else if (phase === 'done') {","-        doneT += dt;","-        if (d.attract ? doneT > DONE_WAIT : (doneT > DONE_WAIT && p.pressed('confirm'))) commitResult('archery', Object.assign(ev.result(), { attract: !!d.attract }));","-      }","-      for (const s of shots) s.t += dt;","+      } else if (ev.phase === 'done') ev.doneT += dt;","+      for (const s of ev.shots) s.t += dt;","     },","-    draw(r) { drawArchery(r, shots, sway(), nudge, phase, t, d); },","+    draw(r) { drawArchery(r, ev, sway()); },","+    ready: () => ev.phase === 'done' && ev.doneT > DONE_WAIT,","     result() {","-      const total = shots.reduce((a, s) => a + s.sc, 0);","-      const ranks = cpuShots.map(c => ({ n: c.n, score: Math.round(c.base * 3 * TUNE.cpuSkill), value: 0 })).map(c => ({ ...c, value: c.score }));","-      const beat = ranks.filter(c => c.value > total).length;","-      return { value: total, label: total + ' / 30', rank: beat + 1, rivals: ranks.map(c => ({ n: c.n, label: c.score + ' / 30', value: c.score })), arrows: shots.map(s => s.sc) };","+      const total = ev.shots.reduce((a, s) => a + s.sc, 0);","+      const rivals = cpu.map(c => ({ n: c.n, score: Math.round(c.base * 3 * TUNE.cpuSkill) }));","+      const rank = rivals.filter(c => c.score > total).length + 1;","+      return { value: total, label: total + ' / 30', rank, rivals: rivals.map(c => ({ n: c.n, label: c.score + ' / 30' })), arrows: ev.shots.map(s => s.sc) };","     },","   };","-  function releaseNow() {","-    if (shots.length >= 3 || phase !== 'shoot') return;","-    const s = sway();","-    release([s[0] + nudge[0], s[1] + nudge[1]]);","-  }"," }","-function drawArchery(r, shots, s, nudge, phase, t, d) {","-  r.overlay(g => E.px.rect(g, 0, 0, r.W, r.H, E.hex('#7fb36a')));","+function drawArchery(r, ev, s) {","+  const sc = Math.min(r.W / 320, r.H / 240);","   const cx = r.W * .66, cy = r.H * .5;","   r.overlay(g => {","-    const rings = [['#f4f4f4', 10], ['#222222', 8], ['#3a86ff', 6], ['#e63946', 4], ['#ffd166', 2]];","-    for (let i = 0; i < 10; i++) {","-      const rad = RING_W * (10 - i) * .9 + 6;","-      const col = i < 2 ? '#ffd166' : i < 4 ? '#e63946' : i < 6 ? '#3a86ff' : i < 8 ? '#222222' : '#f4f4f4';","-      E.px.disc(g, cx, cy, rad, E.hex(col));","+    E.px.rect(g, 0, 0, r.W, r.H, E.hex('#7fb36a'));","+    for (let score = 1; score <= 10; score++) {","+      const col = score >= 9 ? '#ffd166' : score >= 7 ? '#e63946' : score >= 5 ? '#3a86ff' : score >= 3 ? '#222222' : '#f4f4f4';","+      E.px.disc(g, cx, cy, RING * (11 - score) * sc, E.hex(col));","     }","-    E.px.disc(g, cx, cy, 2, E.hex('#ffd166'));","-    // the sway, with the nudge","-    const ax = cx + s[0] * (r.W / 320) + nudge[0] * (r.W / 320), ay = cy + s[1] * (r.H / 240) + nudge[1] * (r.H / 240);","-    E.px.line(g, ax - 6, ay, ax + 6, ay, E.hex('#ffffff'), 1); E.px.line(g, ax, ay - 6, ax, ay + 6, E.hex('#f