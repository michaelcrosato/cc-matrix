ove('roundhouse', .5) }) // any move at any moment, for previews and cutscenes The same move works on every build and in every view: heights are relative to the shoulders (rel: true), reaches scale with arm length, and horizontal swings turn into screen-plane swings in side views. A move's spec fields:\n884:- `hero.swingFrom(x, z, len)` †: hang from a point (a grapple's hook, a whip's ring): a pendulum from (x, z) to its hands, len long (the distance now by default); left and right pump it, jump lets go with its speed (release() does too)","is_error":false}]},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"a23f825b-e201-4ce1-a4e1-facb63b3eec3","timestamp":"2026-11-04T01:00:31.389Z","tool_use_result":{"stdout":"316:const HOOKS = { input: [], step: [], enter: [], draw: [], rot: null, frame: null, pose: null, pause: null }, FADES = {};\n475:const _turn = (spr, o) => HOOKS.rot ? HOOKS.rot(spr, o.rot, o.steps) : (warn('rot', 'sprite turns (rot) are left out of this kit (section 2b): the full engine has them'), spr);\n537:HOOKS.rot = rotSprite;\n2219:      this._tg = this._vG; for (const f of HOOKS.draw) f(game, this, this._vG); for (const f of this._overlays) f(this._vG); this._tg = null;\n2232:      for (const f of HOOKS.draw) f(game, this, g);\n2859:    for (const f of HOOKS.enter) f(this, old);\n2877:    for (const f of HOOKS.input) f(this, dt);\n2900:    for (const f of HOOKS.step) f(this, dt);\n2936:    if (this._split && HOOKS.frame) HOOKS.frame(this, shx, shy);   // a split screen: the scene drawn in each viewport (section 10j)\n3303:HOOKS.step.push((g, dt) => {\n3309:HOOKS.enter.push(g => { const J = g._jobs; if (J) for (const j of J.slice()) if (!j.keep) j.cancel(); });\n3509:HOOKS.enter.push((g, old) => { if (old) g.weather = null; });\n502:- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is 