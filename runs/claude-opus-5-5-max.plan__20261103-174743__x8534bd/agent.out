{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cggyt4bj3KmemhPNYBGYs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RhNLrcitC129Yedu9GeTj3","name":"Bash","input":{"command":"R=/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff; cat $R/game/test.mjs; echo ======; cat $R/kits/test.mjs; echo ======; sed -n 1,60p $R/game/index.html","description":"Read the template game's tests and page"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3536,"cache_read_input_tokens":208871,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3536},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"1af7545e-0e7d-4c3f-a9ce-8ab766004b8a","timestamp":"2026-11-04T00:59:02.789Z","request_id":"req_011Cggyt4P5hKKgBed4DBT8n","wire_tool_inputs":{"toolu_01RhNLrcitC129Yedu9GeTj3":{"command":"R=/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff; cat $R/game/test.mjs; echo ======; cat $R/kits/test.mjs; echo ======; sed -n 1,60p $R/game/index.html","description":"Read the template game's tests and page"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RhNLrcitC129Yedu9GeTj3","type":"tool_result","content":"// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n======\n// A headless test of the genre kits: each kit's game runs in Node with no screen (new E.Game is headless where there is no\n// DOM) after the scripts its page loads before it (the engine, an asset set), starts its slice (the page's deep link,\n// #<id>), plays two seconds, then runs the slice's proof twice: run(600), scripted play from a seed, gives a hash of how\n// it went, the same every time. Run it: node kits/test.mjs [id ...] (every kit without one; exit code 1 on a failure).\n// A game copied from a kit tests the same way: a kit's code reads three of the page's globals, given stand-ins here\n// (window, addEventListener, location); drive it with game.advance and input.tap / hold, as game/test.mjs does.\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync } from 'node:fs';\n\nconst here = new URL('./', import.meta.url), read = f => readFileSync(new URL(f, here), 'utf8');\nconst ids = process.argv.slice(2).length ? process.argv.slice(2) : readdirSync(here).filter(f => f.endsWith('.html')).map(f => f.slice(0, -5)).sort();\nlet failed = 0;\nfor (const id of ids) {\n  const ctx = { console: { log() {}, info() {}, warn() {}, error: console.error }, addEventListener() {}, location: { hash: '#' + id } };\n  ctx.window = ctx; vm.createContext(ctx);\n  try {\n    // the page's scripts, in its order: ../my-3d2dge.js, any asset set, then the kit's game\n    for (const [, src] of read(id + '.html').matchAll(/<script src=\"([^\"]+)\"><\\/script>/g)) vm.runInContext(read(src), ctx, { filename: src });\n    const game = ctx.My3D2dge.current, slice = ctx.__game.scenes[id];\n    game.advance(2);\n    const scene = game.sceneName, a = slice.run(600), b = slice.run(600), errors = game.errors.map(e => e.message), ok = a === b && !errors.length;\n    console.log((ok ? 'ok   ' : 'FAIL ') + id + ': ' + scene + ' plays; its proof twice ' + (a === b ? 'the same (' + a + ')' : a + ', then ' + b) + (errors.length ? '; errors: ' + errors.join(' | ') : ''));\n    if (!ok) failed++;\n  } catch (e) { console.log('FAIL ' + id + ': ' + (e && e.stack || e).toString().split('\\n').slice(0, 3).join(' / ')); failed++; }\n}\nconsole.log(failed ? `${failed} of ${ids.length} kit(s) failed` : `all ${ids.length} kit(s) passed`);\nprocess.exit(failed ? 1 : 0);\n======\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.85.2</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>","is_error":false}]},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"dfebe26d-d7ab-4156-a41f-53da3c2e971c","timestamp":"2026-11-04T00:59:03.157Z","tool_use_result":{"stdout":"// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n======\n// A headless test of the genre kits: each kit's game runs in Node with no screen (new E.Game is headless where there is no\n// DOM) after the scripts its page loads before it (the engine, an asset set), starts its slice (the page's deep link,\n// #<id>), plays two seconds, then runs the slice's proof twice: run(600), scripted play from a seed, gives a hash of how\n// it went, the same every time. Run it: node kits/test.mjs [id ...] (every kit without one; exit code 1 on a failure).\n// A game copied from a kit tests the same way: a kit's code reads three of the page's globals, given stand-ins here\n// (window, addEventListener, location); drive it with game.advance and input.tap / hold, as game/test.mjs does.\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync } from 'node:fs';\n\nconst here = new URL('./', import.meta.url), read = f => readFileSync(new URL(f, here), 'utf8');\nconst ids = process.argv.slice(2).length ? process.argv.slice(2) : readdirSync(here).filter(f => f.endsWith('.html')).map(f => f.slice(0, -5)).sort();\nlet failed = 0;\nfor (const id of ids) {\n  const ctx = { console: { log() {}, info() {}, warn() {}, error: console.error }, addEventListener() {}, location: { hash: '#' + id } };\n  ctx.window = ctx; vm.createContext(ctx);\n  try {\n    // the page's scripts, in its order: ../my-3d2dge.js, any asset set, then the kit's game\n    for (const [, src] of read(id + '.html').matchAll(/<script src=\"([^\"]+)\"><\\/script>/g)) vm.runInContext(read(src), ctx, { filename: src });\n    const game = ctx.My3D2dge.current, slice = ctx.__game.scenes[id];\n    game.advance(2);\n    const scene = game.sceneName, a = slice.run(600), b = slice.run(600), errors = game.errors.map(e => e.message), ok = a === b && !errors.length;\n    console.log((ok ? 'ok   ' : 'FAIL ') + id + ': ' + scene + ' plays; its proof twice ' + (a === b ? 'the same (' + a + ')' : a + ', then ' + b) + (errors.length ? '; errors: ' + errors.join(' | ') : ''));\n    if (!ok) failed++;\n  } catch (e) { console.log('FAIL ' + id + ': ' + (e && e.stack || e).toString().split('\\n').slice(0, 3).join(' / ')); failed++; }\n}\nconsole.log(failed ? `${failed} of ${ids.length} kit(s) failed` : `all ${ids.length} kit(s) passed`);\nprocess.exit(failed ? 1 : 0);\n======\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.85.2</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174737__x193f88/agent.out","hunks":[{"oldStart":489,"oldLines":3,"newStart":489,"newLines":4,"lines":[" {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":211,\"estimated_tokens_delta\":167,\"session_id\":\"041395ab-5146-4633-b27b-c7bc1bdf7a40\",\"uuid\":\"0d544ce7-2345-4258-a5ec-55dfa742fb4e\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011CggysXsY8JXEJUE4ZV9rp\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"The engine's built-in Button symbols setting, dialog blips, attract-mode helper and save slots are noted; I'm checking the rpg and story modules next.\\n\\n\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1163,\"cache_read_input_tokens\":183606,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1163},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"041395ab-5146-4633-b27b-c7bc1bdf7a40\",\"uuid\":\"f88b56b9-6b3e-4716-a73a-ef3a94414083\",\"timestamp\":\"2026-11-04T00:59:02.235Z\",\"request_id\":\"req_011CggysXduGyB2ntT7xTXm6\",\"narration_block_indexes\":[0],\"thinking_duration_ms\":1,\"thinking_display\":\"updates\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011CggysXsY8JXEJUE4ZV9rp\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_011WrFQgTu4inq8QxQ5mggqv\",\"name\":\"Bash\",\"input\":{\"command\":\"cd $HOME/.cache/plan-x193f88-research/engine/repo/dist/handoff && sed -n 1,60p modules/rpg.js | cut -c1-400\",\"description\":\"Read the rpg module header\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1163,\"cache_read_input_tokens\":183606,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1163},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"041395ab-5146-4633-b27b-c7bc1bdf7a40\",\"uuid\":\"8d4d5118-0606-4bd6-b93f-c4221d0fd86e\",\"timestamp\":\"2026-11-04T00:59:02.567Z\",\"request_id\":\"req_011CggysXduGyB2ntT7xTXm6\",\"wire_tool_inputs\":{\"toolu_011WrFQgTu4inq8QxQ5mggqv\":{\"command\":\"cd $HOME/.cache/plan-x193f88-research/engine/repo/dist/handoff && sed -n 1,60p modules/rpg.js | cut -c1-400\",\"description\":\"Read the rpg module header\"}}}","+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_011WrFQgTu4inq8QxQ5mggqv\",\"type\":\"tool_result\",\"content\":\"/*!\\nmy-3D2dge module RPG v0.85.2: items, inventories, equipment, shops, a party's stats and levels, status, damage, encounters\\nhttps://github.com/michaelcrosato/my-3d2dge (MIT License)\\nLoads after: the full engine or the agent edition. Needs: no other module.\\n\\nThe systems under a JRPG (Dragon Quest, Final Fantasy, Chrono Trigger), and the inventory grid of a Resident Evil.\\n- const rpg = new E.RPG({ items, monsters, status, curve }). items: { id: { name, kind: 'use' | 'weapon' | 'armor' |\\n  'helm' | 'accessory' | 'key', price, stack (99), heal, mp, cure: ['poison'], revive (a share of HP), stats: { atk: 4 }\\n  (worn: slot = its kind), size: [w, h] (grid cells), icon (a sprite; else one for its kind), info } }. monsters: { id:\\n  { name, hp, atk, def, mag, spd, exp, gold, drops: [[chance, item]] } }. status: over the defaults (poison: a\\n  sixteenth of HP each tick; regen heals that; sleep and stop skip turns; silence bars skills; haste and slow change\\n  spd), each { turns (0: till cured), hurt, heal, skip, mute, spd }. curve(lv): the experience a level needs in all.\\n- const hero = rpg.member({ name, level, stats: { hp, mp, atk, def, mag, spd }, growth: { hp: 10, atk: 2 } (a level),\\n  equip: { weapon: 'sword' }, data }): hero.stat(k) (base, growth, gear, status), hero.max('hp'), hero.hp, mp, level,\\n  exp, next (to the next level), dead, data (the game's own); gain(exp) → the levels reached [{ level, up: { hp: 11 } }];\\n  equip(id, inv) (the old piece back into inv), unequip(slot, inv), compare(id) → { atk: 3, def: -1 } (equipping it); afflict(k, turns), cure(k) (k left out: all), has(k), acts() (no skip), tick() (a turn: hurt, heal,\\n  effects run out; → [[k, hp change or 'ends']]).\\n- const party = rpg.party([hero], { gold, inv }): members, alive, gold, inv (rpg.inventory() by default); use(id, m)\\n  (heal, mp, cure, revive; → true when it did something, and the item is gone); rest() (an inn); reward(troop) (monster\\n  ids, or { exp, gold, items }) → { exp, gold, items, levels: [[member, levels]] } (exp shared by the living).\\n- const inv = rpg.inventory({ slots: 32 } | { grid: [8, 5] }): add(id, n) (false, and nothing added, when it won't\\n  fit), remove(id, n), count(id), has(id, n), list() → [{ id, n, item, x, y }]; a grid's: fits(id, x, y), place(id, x,\\n  y), at(x, y).\\n- const shop = rpg.shop(['potion', 'sword']): price(id), worth(id) (selling: half), buy(party, id, n), sell(party, id,\\n  n) (→ true when done; key items don't sell).\\n- rpg.damage(a, b, { power: 1, kind: 'phys' | 'mag', crit: .08, guard }) → { hp, crit }: attack less half the defense\\n  (members' stats, or a monster's fields), a tenth either way; a critical hit ignores armor.\\n- const enc = rpg.encounters({ field: { every: [12, 28] (cells walked), troops: [[3, ['slime', 'slime']], [1, ['bat']]] } }):\\n  enc.walk(zone, units) each step → a troop when the count runs out (it starts again), else null.\\n- party.state() → JSON for a save; rpg.restore(state) → that party.\\n- Windows (in r.overlay): rpg.list(g, x, y, w, rows, { cursor, title, top, show, rowH, bg }) (rows: [{ label, note,\\n  icon, off }]; → { x, y, w, h, row(px, py): the row under a tap, at(i) }), rpg.card(g, x, y, member, { portrait } (full engine)),\\n  rpg.icon(id).\\n\\n```js rpg\\nconst E = My3D2dge, rpg = new E.RPG({ items: { potion: { name: 'Potion', kind: 'use', heal: 30, price: 10 }, sword: { name: 'Sword', kind: 'weapon', stats: { atk: 5 }, price: 60 } },\\n  monsters: { slime: { name: 'Slime', hp: 10, atk: 4, def: 1, exp: 9, gold: 6 } } });\\nconst hero = rpg.member({ name: 'Rowan', stats: { hp: 40, mp: 4, atk: 10, def: 4 }, growth: { hp: 8, atk: 2 } });\\nconst party = rpg.party([hero], { gold: 100 }), shop = rpg.shop(['potion', 'sword']);\\nif (!shop.buy(party, 'sword') || hero.compare('sword').atk !== 5 || !hero.equip('sword', party.inv) || hero.stat('atk') !== 15) throw new Error('a sword bought and worn');\\nconst won = party.reward(['slime', 'slime', 'slime', 'slime']);\\nif (won.exp !== 36 || party.gold !== 64 || hero.level < 2 || hero.max('hp') !== 40 + 8 * (hero.level - 1)) throw new Error('the reward, a level');\\nhero.hp = 5; shop.buy(party, 'potion'); if (!party.use('potion', hero) || hero.hp !== 35 || party.inv.has('potion')) throw new Error('a potion drunk');\\nif (rpg.restore(JSON.parse(JSON.stringify(party.state()))).members[0].stat('atk') !== hero.stat('atk')) throw new Error('saved and back');\\n```\\nRules: ids in the save, never objects; a battle reads members' stat() and writes their hp and mp back; draw windows\\nin r.overlay; randomness is Math.random's (a proof seeds it).\\n*/\\n(function (E) {\\n'use strict';\\nif (!E) throw new Error('my-3D2dge module RPG: load engine/my-3d2dge.js (or the agent edition) first');\\n\\n/* =============================================================================\\n * RPG  items, inventories, equipment, shops, members and their party, status, damage, encounters, windows\\n * ========================================================================== */\\nconst { px } = E, STATS = ['hp', 'mp', 'atk', 'def', 'mag', 'spd'], SLOTS = ['weapon', 'armor', 'helm', 'accessory'];\\nconst STATUS = {   // the default effects: hurt and heal (a share of max HP a tick), skip (no turns), mute (no skills), spd (its speed)\\n  poison: { hurt: 1 / 16, turns: 0, color: '#b060e0' }, regen: { heal: 1 / 16, turns: 5, color: '#58d068' }, sleep: { skip: true, turns: 3, color: '#8ab0ff' },\\n  stop: { skip: true, turns: 2, color: '#c0c0c0' }, silence: { mute: true, turns: 4, color: '#e0e0a0' }, haste: { spd: 1.5, turns: 5, color: '#ffd060' }, slow: { spd: .5, turns: 5, color: '#6