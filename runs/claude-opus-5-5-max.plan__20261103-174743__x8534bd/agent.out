1h_input_tokens\":7541},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"01565e32-5dd5-4107-91e6-1b53667edea6\",\"uuid\":\"488d0a50-bb22-45e9-b1f0-c739fb80b84b\",\"timestamp\":\"2026-11-04T00:54:21.610Z\",\"request_id\":\"req_011CggyXDpHF2Wb5ffAtESJ8\",\"thinking_duration_ms\":3250,\"thinking_display\":\"updates\"}","+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"msg_011CggyXE4RQuzjEZYX2Asn7\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01RYd1DSfRbi9YcnTrJhALuH\",\"name\":\"Bash\",\"input\":{\"command\":\"cd /home/micha/.cache/gauntlet-plan-research-x8cc180/my-3d2dge/dist/handoff && sed -n 440,600p API-INDEX.md\",\"description\":\"Read API index game, menu, settings sections\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":7541,\"cache_read_input_tokens\":158763,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":7541},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"01565e32-5dd5-4107-91e6-1b53667edea6\",\"uuid\":\"7bd99a6f-abbe-4248-861d-98f58161a6d1\",\"timestamp\":\"2026-11-04T00:54:22.743Z\",\"request_id\":\"req_011CggyXDpHF2Wb5ffAtESJ8\",\"wire_tool_inputs\":{\"toolu_01RYd1DSfRbi9YcnTrJhALuH\":{\"command\":\"cd /home/micha/.cache/gauntlet-plan-research-x8cc180/my-3d2dge/dist/handoff && sed -n 440,600p API-INDEX.md\",\"description\":\"Read API index game, menu, settings sections\"}}}","+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01RYd1DSfRbi9YcnTrJhALuH\",\"type\":\"tool_result\",\"content\":\"- `r.w(x, y, z = 0)`: world -> buffer pixel coords\\n- `r.game`: its game; items: this frame's queue (sorted by depth when the frame ends)\\n- `r.glowMask = true` †: false lets emissive glows show over everything under canvas lighting (cheaper: the default keeps walls and bodies in front of a glow dark)\\n- `r.gpu = false` †: true during a frame drawn with GPU lighting (draw code can check r.gpu)\\n- `r.ix`, `r.iy`: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer)\\n- `r.outline = '#140c1c'`: the color of the 1-pixel outline round every actor\\n- `r.rim = '#ffe2b8'` †: the rim light's color on actors' lit edges\\n- `r.rimAlpha = .28` †: its strength 0..1\\n- `r.xrayColor = '#8fe3ff'` †: the default color of x-ray silhouettes\\n- `r.xrayOutline = '#e8fdff'` †: the default 1-px outline round a silhouette's hidden part (null for none)\\n\\n## 10. Game\\n\\n- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, id, pace, camera }). The standard features (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\\n- `new E.Game({ res })`: a fixed resolution ('ps1' or [w, h]), whole pixels\\n- `new E.Game({ expand })`: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars (expand: { maxW, maxH } stops it growing there)\\n- `new E.Game({ bg })`: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture under it (a 3D world, engine/my-3d2dge-3d.js)\\n- `new E.Game({ headless })`: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default): scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\\n- `new E.Game({ loop })`: false makes a game in a page that runs only by advance()\\n- `new E.Game({ menu })`: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\\n- `new E.Game({ fullscreen })`: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it off), 'button' (only when asked) or false\\n- `new E.Game({ corner, backGesture })`: corner: the menu and full-screen buttons (top right); backGesture: a phone's back steps back in the game first (false: it leaves the page)\\n- `new E.Game({ autoPause })`: a pausable scene pauses when the page is hidden or loses focus\\n- `new E.Game({ id })`: the name the player's settings are saved under (the page's path)\\n- `new E.Game({ pace })`: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every other one, evenly), unless the player picks Frame rate 60\\n- `new E.Game({ camera })`: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\\n- `game.H`: the screen's height in game pixels (W is its width)\\n- `game.W`: internal buffer size in pixels (HUD layout)\\n- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\\n- `game.advance(seconds = this.o.step, o = {})`: run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). Returns the updates run\\n- `game.after(seconds, fn)`: run fn once after `seconds` of game time. Cleared on scene change. Returns { cancel() }\\n- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\\n- `game.back()`: a step back, as a phone's back gesture asks for (the engine calls it for one; a back button of the game's own can): the open menu screen goes back one; else the scene's own back() takes it (it returns true when it did); else a scene in play pauses into the menu, and a paused one goes on. Returns false where there is nowhere to go (a title)\\n- `game.cornerArea()` †: where the corner's buttons (menu and full screen, top right; the touch START) cover the screen, in screen pixels { x0, y0, x1, y1 } (r.W and r.H's space), or null while none show: keep a HUD clear of it\\n- `game.dispose()`: end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window, the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and tools that make many games call it; the canvas stays\\n- `game.enableGPU(o = {})` †: turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... }\\n- `game.every(seconds, fn)`: run fn every `seconds` of game time. Cleared on scene change. Returns { cancel() }\\n- `game.fail(where, e)`: report an error in game code without stopping the game: logged once per place and message, kept in game.errors and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err)\\n- `game.flash(color = '#ffffff', seconds = .12, strength = 1)`: flash the whole screen with a color for `seconds` (dithered fade out): hits, explosions, lightning. Shorter when reduceMotion, dimmer by the player's settings.flashes\\n- `game.focus(x, y, z = 0)`: camera follows this world point. Side-scrollers: game.focus(x, 0, z)\\n- `game.follow(target, o = {})`: keep the camera on an object automatically (instead of calling focus every update). opts: { z: extra height to look at (default 16), lead: look ahead in the facing / moving direction }. follow(null) stops.\\n- `game.freeze(s)`: hit-stop: the game stands still for s seconds (.04-.08 for a hit); input still ticks\\n- `game.go(name, data, o = {})`: switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\\n- `game.hitFx(x, y, z, o = {})`: everything a good hit needs in one call: hit-stop, shake, an impact star, sparks along the hit direction, a sound, a damage number and a rumble on a gamepad. hitFx(x, y, z, { power: 1, angle, damage, color, sound: 'hit', rumble: true })\\n- `game.menu(name)`: open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play. Returns true when a menu opened\\n- `game.mouseGround()`: mouse position on the ground (world units), or null\\n- `game.nextView(dir = 1)`: cycle through game.views (or every view): bind it to a key for players who like to switch\\n- `game.note(text, seconds = 1.2)`, `game.shownNote`: a short notice at the top of the screen (zoom level, saved, ...): game.note('ZOOM 1.5x', 1). game.shownNote is the one showing, { text, end } (end in game.real seconds), or null: a game that draws it its own way takes it and sets shownNote to null\\n- `game.onView(f)` †: call f(view) whenever the view changes (re-bake caches, move HUD)\\n- `game.pause(reason = 'player')`: pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused. The player resumes (Escape, Start, Resume); resume() does it from code\\n- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\\n- `game.removePlayer(p)` †: a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it\\n- `game.resetCamera()` †: undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1 without), no turn. The player's zoom stays (settings.zoom)\\n- `game.resume()`: take the game out of pause (and close the pause screen)\\n- `game.rotateView(deg)` †: turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn\\n- `game.saves()` †: game.saves: the save slots (section 10k), made when first read\\n- `game.script(fn, o)` †: run a coroutine on game time, in the update step: game.script(function* (game) { yield .5; yield E.until(() => door.open); yield game.tween(cam, { y: 0 }, 1); yield E.all([a, b]); ... }, { keep }). Each yield waits: a number (seconds), nothing (one step), a condition (a function, or E.until(fn)), a tween or script (until it is done), a generator (run as a script of its own, and waited for), E.all([...]) or E.any([...]) (each of these). It runs at once to its first yield. Cutscenes, boss patterns, wave timelines, tutorials, attract modes. Returns the Script\\n- `game.setView(v)`: switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn\\n- `game.setZoom(z)` †: camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\\n- `game.shake(a)`: shake the screen by a (pixels, decaying; at most 10 in all); none when reduceMotion, scaled by the player's settings.shake\\n- `game.shaking` †: how hard the screen shakes now (0 still, up to 10): shake() adds to it and it dies away. A camera of the game's own (a 3D world's) shakes by it\\n- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 }\\n- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera } (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only by advance().\\n- `game.start({ view, views, input, res, expand, touch })`: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'), expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\\n- `game.start({ back })`: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a sub-menu closed)\\n- `game.start({ camera })`: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\\n- `game.start({ boot })`: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\\n- `game.stop()`: stop the loop; the game keeps its state, and start() resumes it\\n- `game.tween(target, to, seconds, o)` †: ease target's numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }). ease: a name in E.ease ('outQuad' by default) or a function of u 0..1. It starts from the values the target has once its delay is over. Returns the Tween: tween.done, tween.cancel()\\n- `game.upright`: true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom applies then: it zooms a tall picture in to fill it\\n- `game.viewports` †: a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or [] on one screen\\n- `game.zoomBy(k)` †: the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does nothing where the scene doesn't let the player zoom. Returns the zoom\\n- `game.zoomRange()` †: the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of the game gives one per screen shape or level), or null where they can't (camera.zoom false or none)\\n- `game.alpha = .5`: the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count\\n- `game.audio`: chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song)\\n- `game.baseView` †: the chosen view without zoom and turn\\n- `game.bootError = null`: the error a boot step failed with (the game did not start), or null\\n- `game.booted`: a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a test whose boot steps return promises\\n- `game.cam`: camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the screen's centre to where the focus sits (above a phone's touch buttons: [0, -40]); x, y: the camera's position in projected pixels (its top-left corner); vx, vy: how fast it is moving there; tx, ty, tz: the world point it is following (focus sets it); snap: true makes it jump there at the next step instead of gliding (a new level, a teleport); window: [w, h] screen pixels, a dead zone round the focus it moves in before the camera follows (Super Mario World's; [48, 0] for sideways only); snapY: true follows a followed body's height only when it lands (onGround) or nears the screen's edge (side-scrollers); frame(targets, { margin: 24, zoom: [min, max] or false }) keeps every one of them (anything with x, y, z) in view, centered between them and zoomed out (no further than min) when they spread apart, until frame(null); free: a free camera (strategy, sims, board games): true or { keys: true, edge: 10, drag: true, speed: 300, bounds: [x0, y0, x1, y1] }: the keys or a pad's stick pan it (input.move(), speed screen pixels a second), the mouse at the screen's edge (within edge pixels), a drag (input.pan(): a finger on open ground, a mouse's middle or right button) one to one; a zoom (wheel, pinch) zooms toward the pointer or the pinch; its focus keeps to bounds (world x, y); focus() still moves it; in every view and turn; null (as it starts): off\\n- `game.debug = null`: a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }. tools/check.mjs prints snapshot() and tools/replay.mjs logs it at the end\\n- `game.disposed = true`: true after dispose()\\n- `game.drawEvery = 1`: 1, or 2 while a fast display (a 120 Hz phone) refreshes quicker than the game can draw (a frame's cost, or refreshes missed: its GPU behind): every other refresh is drawn, evenly, instead of random ones missed (the updates still run every refresh). The player's Frame rate setting (game.settings.frameRate: 'auto', '60', 'full') can fix it at 2 or 1\\n- `game.errors = []`: the errors caught in update and draw, each { where, scene, message, stack }, once per kind\\n- `game.fadeTime = .22`: seconds for the dithered fade between scenes (0 = instant cuts)\\n- `game.fps = 60`: frames drawn per second over the last half second of real time\\n- `game.fullscreen`: full screen: game.fullscreen.toggle(), .on, .supported\\n- `game.gpu = null` †: the WebGPU lighting after enableGPU(), or null\\n- `game.headless`: true for a game with no display (o.headless, or no DOM: Node)\\n- `game.hitstop = 0`: seconds of hit-stop left (freeze)\\n- `game.hz = 60`: the display's refresh rate, measured\\n- `game.input`: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...)\\n- `game.lights` †: canvas lighting (lights.enabled, lights.add in draw)\\n- `game.o`: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg, step, input, loop, headless)\\n- `game.particles`: dust, sparks, debris and text in the world\\n- `game.pauseOverlay = true`: false hides the engine's PAUSED overlay (a game drawing its own pause screen)\\n- `game.pauseReason = null`: why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null\\n- `game.paused = false`: true while paused (a pausable scene toggles it on 'pause'; steps still run, scenes don't update)\\n- `game.r`: the renderer handed to draw(r) (null when headless)\\n- `game.real = 0`: seconds the game has stepped through, pauses and hit-stop included (blinking HUD, notes)\\n- `game.reduceMotion`: the player asked for less motion (prefers-reduced-motion): shake and flashes are softened\\n- `game.scene = null`: the scene running\\n- `game.sceneName = null`: its name ('main' for a game started with one scene)\\n- `game.scenes = null`: the scenes given to start(), by name\\n- `game.screen`: the low-resolution screen (its W, H, scale and buffer)\\n- `game.settings`: the player's choices (game.settings.volume, game.settings.set('volume', .5), your own from menu.settings), saved and applied (section 10b)\\n- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\\n- `game.stats`: per-frame timings (ms) and counts, for profiling overlays\\n- `game.stats.updateMs`, `game.stats.renderMs`: milliseconds the last frame spent updating and drawing\\n- `game.stats.frameMs`: the real time since the last frame\\n- `game.stats.steps`: the updates it ran\\n- `game.stats.items`: what it queued for drawing\\n- `game.stats.actors`: actors drawn\\n- `game.stats.culled`: actors skipped off screen\\n- `game.time = 0`: game seconds since start (it stops during pause and hit-stop, and slows with timeScale)\\n- `game.timeScale = 1`: game speed, 1 normal, .25 slow motion, 0 stopped\\n- `game.view`: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView)\\n- `game.views`: views this game is designed for (view cycling and the checker use it). null = every view\\n- `game.yaw = 0` †: its turn in degrees on top of the view (rotateView)\\n- `game.zoom = 1` †: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range\\n- `E.PLAYER_COLORS: #4a8aff, #ff4a4a, #4ad860, #ffd040` †: the players' colors: player 1 blue, 2 red, 3 green, 4 yellow (game.players)\\n- `E.showError(title, e)`: show an error in the red box at the top of the page (the engine does it for errors in update and draw); a click hides it. Before play has started it shows on the boot screen instead, as a report a player can screenshot\\n\\n## 10b. Standard features\\n\\n- `settings.default(key)`: a setting's default value\\n- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and applied; it shows on the settings screen. Returns its value\\n- `settings.keys(group)`: the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key\\n- `settings.reset(group)`: put a group's settings (or all of them) back to their defaults; a game's saves are not touched\\n- `settings.set(key, v)`: change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told. Returns the value kept (the old one when v is not a valid value)\\n- `settings.spec(key)`: the spec a setting was defined with (its label, type, range, options), or undefined\\n- `settings.saved`: false when the last save failed (storage blocked or full: the choices last for this visit)\\n- `fullscreen.enter(quiet)`: go full screen. Browsers allow it only from a tap, click or key press: call it from one (a button, the menu, a key's update step). Returns a promise of whether it worked (a refusal is kept in failed and noted on screen, unless quiet)\\n- `fullscreen.exit()`: leave full screen (Escape and the phone's back gesture do it too)\\n- `fullscreen.on`: true while the page is full screen\\n- `fullscreen.standalone`: true when the page was opened from a home screen as an app (no browser bars: nothing to go full screen from)\\n- `fullscreen.supported`: true where this page can go full screen (not an iPhone, which has Add to Home Screen instead; not a frame without permission; not headless)\\n- `fullscreen.toggle()`: full screen on or off, as the player asked (the corner's button, the menu): their choice is kept in settings.fullscreen, so a game starting on a phone goes full screen by itself only while they haven't turned it off\\n- `fullscreen.failed = null`: game: the game it serves; failed: why the last request was refused (a message), or null\\n\\n## 10c. Boot\\n\\n- `E.bootSplash(title = '')`: the boot screen's markup, for the very start of a page's <body>: it shows from the first paint, its bar moving while the page's scripts load (a pure CSS animation), and says so if the game's script never runs. The engine takes it over\\n- `E.diagnose(game = E.current)`: the report a bug needs, at any time (and on the boot screen when a game can't start): { engine, game, time, page, browser, device, screen, canvas, gpu, sound, storage, input, scene, errors, text (all of it, one line each, for a screenshot or a bug report), short (one line) }. game: the game to report on (E.current)\\n\\n## 10d. Tweens and scripts\\n\\n- `new E.Script(game, fn, o = {}) → script` †: a script, made by game.script: done (it returned, or was cancelled), value (what it returned), cancel(); another script can yield it\\n- `script.cancel()` †: stop it, and the scripts it is waiting on (its finally blocks run)\\n- `script.done = false` †: it returned, or was cancelled\\n- `script.keep` †: it outlives the scene\\n- `script.value` †: what it returned\\n- `new E.Tween(game, target, to, seconds, o = {}) → tween` †: a tween, made by game.tween: done (it ended, or was cancelled), cancel(); a script can yield it\\n- `tween.cancel()` †: stop it where it is (no onDone)\\n- `tween.done = false` †: it ended, or was cancelled\\n- `tween.keep` †: it outlives the scene\\n- `tween.target` †: what it moves\\n- `tween.to` †: the values it moves them to\\n- `E.all(list)` †: a script's wait for every one of its waits (seconds, conditions, tweens, scripts): yield E.all([a, b])\\n- `E.any(list)` †: a script's wait for the first of its waits to be over: yield E.any([boss.script, 30])\\n- `E.until(fn)` †: a script's wait until fn() is true: yield E.until(() => door.open)\\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174804__x8cc180/work\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"01565e32-5dd5-4107-91e6-1b53667edea6\",\"uuid\":\"f52da258-d797-4ca1-b601-f71f680e17f1\",\"timestamp\":\"2026-11-04T00:54:22.755Z\",\"tool_use_result\":{\"stdout\":\"- `r.w(x, y, z = 0)`: world -> buffer pixel coords\\n- `r.game`: its game; items: this frame's queue (sorted by depth when the frame ends)\\n- `r.glowMask = true` †: false lets emissive glows show over everything under canvas lighting (cheaper: the default keeps walls and bodies in front of a glow dark)\\n- `r.gpu = false` †: true during a frame drawn with GPU lighting (draw code can check r.gpu)\\n- `r.ix`, `r.iy`: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer)\\n- `r.outline = '#140c1c'`: the color of the 1-pixel outline round every actor\\n- `r.rim = '#ffe2b8'` †: the rim light's color on actors' lit edges\\n- `r.rimAlpha = .28` †: its strength 0..1\\n- `r.xrayColor = '#8fe3ff'` †: the default color of x-ray silhouettes\\n- `r.xrayOutline = '#e8fdff'` †: the default 1-px outline round a silhouette's hidden part (null for none)\\n\\n## 10. Game\\n\\n- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, id, pace, camera }). The standard features (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\\n- `new E.Game({ res })`: a fixed resolution ('ps1' or [w, h]), whole pixels\\n- `new E.Game({ expand })`: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars (expand: { maxW, maxH } stops it growing there)\\n- `new E.Game({ bg })`: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture under it (a 3D world, engine/my-3d2dge-3d.js)\\n- `new E.Game({ headless })`: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default): scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\\n- `new E.Game({ loop })`: false makes a game in a page that runs only by advance()\\n- `new E.Game({ menu })`: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\\n- `new E.Game({ fullscreen })`: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it off), 'button' (only when asked) or false\\n- `new E.Game({ corner, backGesture })`: corner: the menu and full-screen buttons (top right); backGesture: a phone's back steps back in the game first (false: it leaves the page)\\n- `new E.Game({ autoPause })`: a pausable scene pauses when the page is hidden or loses focus\\n- `new E.Game({ id })`: the name the player's settings are saved under (the page's path)\\n- `new E.Game({ pace })`: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every other one, evenly), unless the player picks Frame rate 60\\n- `new E.Game({ camera })`: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\\n- `game.H`: the screen's height in game pixels (W is its width)\\n- `game.W`: internal buffer size in pixels (HUD layout)\\n- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\\n- `game.advance(seconds = this.o.step, o = {})`: run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). Returns the updates run\\n- `game.after(seconds, fn)`: run fn once after `seconds` of game time. Cleared on scene change. Returns { cancel() }\\n- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\\n- `game.back()`: a step back, as a phone's back gesture asks for (the engine calls it for one; a back button of the game's own can): the open menu screen goes back one; else the scene's own back() takes it (it returns true when it did); else a scene in play pauses into the menu, and a paused one goes on. Returns false where there is nowhere to go (a title)\\n- `game.cornerArea()` †: where the corner's buttons (menu and full screen, top right; the touch START) cover the screen, in screen pixels { x0, y0, x1, y1 } (r.W and r.H's space), or null while none show: keep a HUD clear of it\\n- `game.dispose()`: end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window, the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and tools that make many games call it; the canvas stays\\n- `game.enableGPU(o = {})` †: turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... }\\n- `game.every(seconds, fn)`: run fn every `seconds` of game time. Cleared on scene change. Returns { cancel() }\\n- `game.fail(where, e)`: report an error in game code without stopping the game: logged once per place and message, kept in game.errors and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err)\\n- `game.flash(color = '#ffffff', seconds = .12, strength = 1)`: flash the whole screen with a color for `seconds` (dithered fade out): hits, explosions, lightning. Shorter when reduceMotion, dimmer by the player's settings.flashes\\n- `game.focus(x, y, z = 0)`: camera follows this world point. Side-scrollers: game.focus(x, 0, z)\\n- `game.follow(target, o = {})`: keep the camera on an object automatically (instead of calling focus every update). opts: { z: extra height to look at (default 16), lead: look ahead in the facing / moving direction }. follow(null) stops.\\n- `game.freeze(s)`: hit-stop: the game stands still for s seconds (.04-.08 for a hit); input still ticks\\n- `game.go(name, data, o = {})`: switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\\n- `game.hitFx(x, y, z, o = {})`: everything a good hit needs in one call: hit-stop, shake, an impact star, sparks along the hit direction, a sound, a damage number and a rumble on a gamepad. hitFx(x, y, z, { power: 1, angle, damage, color, sound: 'hit', rumble: true })\\n- `game.menu(name)`: open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play. Returns true when a menu opened\\n- `game.mouseGround()`: mouse position on the ground (world units), or null\\n- `game.nextView(dir = 1)`: cycle through game.views (or every view): bind it to a key for players who like to switch\\n- `game.note(text, seconds = 1.2)`, `game.shownNote`: a short notice at the top of the screen (zoom level, saved, ...): game.note('ZOOM 1.5x', 1). game.shownNote is the one showing, { text, end } (end in game.real seconds), or null: a game that draws it its own way takes it and sets shownNote to null\\n- `game.onView(f)` †: call f(view) whenever the view changes (re-bake caches, move HUD)\\n- `game.pause(reason = 'player')`: pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused. The player resumes (Escape, Start, Resume); resume() does it from code\\n- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\\n- `game.removePlayer(p)` †: a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it\\n- `game.resetCamera()` †: undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1 without), no turn. The player's zoom stays (settings.zoom)\\n- `game.resume()`: take the game out of pause (and close the pause screen)\\n- `game.rotateView(deg)` †: turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn\\n- `game.saves()` †: game.saves: the save slots (section 10k), made when first read\\n- `game.script(fn, o)` †: run a coroutine on game time, in the update step: game.script(function* (game) { yield .5; yield E.until(() => door.open); yield game.tween(cam, { y: 0 }, 1); yield E.all([a, b]); ... }, { keep }). Each yield waits: a number (seconds), nothing (one step), a condition (a function, or E.until(fn)), a tween or script (until it is done), a generator (run as a script of its own, and waited for), E.all([...]) or E.any([...]) (each of these). It runs at once to its first yield. Cutscenes, boss patterns, wave timelines, tutorials, attract modes. Returns the Script\\n- `game.setView(v)`: switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn\\n- `game.setZoom(z)` †: camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\\n- `game.shake(a)`: shake the screen by a (pixels, decaying; at most 10 in all); none when reduceMotion, scaled by the player's settings.shake\\n- `game.shaking` †: how hard the screen shakes now (0 still, up to 10): shake() adds to it and it dies away. A camera of the game's own (a 3D world's) shakes by it\\n- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 }\\n- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera } (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only by advance().\\n- `game.start({ view, views, input, res, expand, touch })`: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'), expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\\n- `game.start({ back })`: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a sub-menu closed)\\n- `game.start({ camera })`: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\\n- `game.start({ boot })`: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\\n- `game.stop()`: stop the loop; the game keeps its state, and start() resumes it\\n- `game.tween(target, to, seconds, o)` †: ease target's numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }). ease: a name in E.ease ('outQuad' by default) or a function of u 0..1. It starts from the values the target has once its delay is over. Returns the Tween: tween.done, tween.cancel()\\n- `game.upright`: true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom applies then: it zooms a tall picture in to fill it\\n- `game.viewports` †: a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or [] on one screen\\n- `game.zoomBy(k)` †: the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does nothing where the scene doesn't let the player zoom. Returns the zoom\\n- `game.zoomRange()` †: the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of the game gives one per screen shape or level), or null where they can't (camera.zoom false or none)\\n- `game.alpha = .5`: the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count\\n- `game.audio`: chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song)\\n- `game.baseView` †: the chosen view without zoom and turn\\n- `game.bootError = null`: the error a boot step failed with (the game did not start), or null\\n- `game.booted`: a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a test whose boot steps return promises\\n- `game.cam`: camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the screen's centre to where the focus sits (above a phone's touch buttons: [0, -40]); x, y: the camera's position in projected pixels (its top-left corner); vx, vy: how fast it is moving there; tx, ty, tz: the world point it is following (focus sets it); snap: true makes it jump there at the next step instead of gliding (a new level, a teleport); window: [w, h] screen pixels, a dead zone round the focus it moves in before the camera follows (Super Mario World's; [48, 0] for sideways only); snapY: true follows a followed body's height only when it lands (onGround) or nears the screen's edge (side-scrollers); frame(targets, { margin: 24, zoom: [min, max] or false }) keeps every one of them (anything with x, y, z) in view, centered between them and zoomed out (no further than min) when they spread apart, until frame(null); free: a free camera (strategy, sims, board games): true or { keys: true, edge: 10, drag: true, speed: 300, bounds: [x0, y0, x1, y1] }: the keys or a pad's stick pan it (input.move(), speed screen pixels a second), the mouse at the screen's edge (within edge pixels), a drag (input.pan(): a finger on open ground, a mouse's middle or right button) one to one; a zoom (wheel, pinch) zooms toward the pointer or the pinch; its focus keeps to bounds (world x, y); focus() still moves it; in every view and turn; null (as it starts): off\\n- `game.debug = null`: a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }. tools/check.mjs prints snapshot() and tools/replay.mjs logs it at the end\\n- `game.disposed = true`: true after dispose()\\n- `game.drawEvery = 1`: 1, or 2 while a fast display (a 120 Hz phone) refreshes quicker than the game can draw (a frame's cost, or refreshes missed: its GPU behind): every other refresh is drawn, evenly, instead of random ones missed (the updates still run every refresh). The player's Frame rate setting (game.settings.frameRate: 'auto', '60', 'full') can fix it at 2 or 1\\n- `game.errors = []`: the errors caught in update and draw, each { where, scene, message, stack }, once per kind\\n- `game.fadeTime = .22`: seconds for the dithered fade between scenes (0 = instant cuts)\\n- `game.fps = 60`: frames drawn per second over the last half second of real time\\n- `game.fullscreen`: full screen: game.fullscreen.toggle(), .on, .supported\\n- `game.gpu = null` †: the WebGPU lighting after enableGPU(), or null\\n- `game.headless`: true for a game with no display (o.headless, or no DOM: Node)\\n- `game.hitstop = 0`: seconds of hit-stop left (freeze)\\n- `game.hz = 60`: the display's refresh rate, measured\\n- `game.input`: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...)\\n- `game.lights` †: canvas lighting (lights.enabled, lights.add in draw)\\n- `game.o`: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg, step, input, loop, headless)\\n- `game.particles`: dust, sparks, debris and text in the world\\n- `game.pauseOverlay = true`: false hides the engine's PAUSED overlay (a game drawing its own pause screen)\\n- `game.pauseReason = null`: why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null\\n- `game.paused = false`: true while paused (a pausable scene toggles it on 'pause'; steps still run, scenes don't update)\\n- `game.r`: the renderer handed to draw(r) (null when headless)\\n- `game.real = 0`: seconds the game has stepped through, pauses and hit-stop included (blinking HUD, notes)\\n- `game.reduceMotion`: the player asked for less motion (prefers-reduced-motion): shake and flashes are softened\\n- `game.scene = null`: the scene running\\n- `game.sceneName = null`: its name ('main' for a game started with one scene)\\n- `game.scenes = null`: the scenes given to start(), by name\\n- `game.screen`: the low-resolution screen (its W, H, scale and buffer)\\n- `game.settings`: the player's choices (game.settings.volume, game.settings.set('volume', .5), your own from menu.settings), saved and applied (section 10b)\\n- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\\n- `game.stats`: per-frame timings (ms) and counts, for profiling overlays\\n- `game.stats.updateMs`, `game.stats.renderMs`: milliseconds the last frame spent updating and drawing\\n- `game.stats.frameMs`: the real time since the last frame\\n- `game.stats.steps`: the updates it ran\\n- `game.stats.items`: what it queued for drawing\\n- `game.stats.actors`: actors drawn\\n- `game.stats.culled`: actors skipped off screen\\n- `game.time = 0`: game seconds since start (it stops during pause and hit-stop, and slows with timeScale)\\n- `game.timeScale = 1`: game speed, 1 normal, .25 slow motion, 0 stopped\\n- `game.view`: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView)\\n- `game.views`: views this game is designed for (view cycling and the checker use it). null = every view\\n- `game.yaw = 0` †: its turn in degrees on top of the view (rotateView)\\n- `game.zoom = 1` †: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range\\n- `E.PLAYER_COLORS: #4a8aff, #ff4a4a, #4ad860, #ffd040` †: the players' colors: player 1 blue, 2 red, 3 green, 4 yellow (game.players)\\n- `E.showError(title, e)`: show an error in the red box at the top of the page (the engine does it for errors in update and draw); a click hides it. Before play has started it shows on the boot screen instead, as a report a player can screenshot\\n\\n## 10b. Standard features\\n\\n- `settings.default(key)`: a setting's default value\\n- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and applied; it shows on the settings screen. Returns its value\\n- `settings.keys(group)`: the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key\\n- `settings.reset(group)`: put a group's settings (or all of them) back to their defaults; a game's saves are not touched\\n- `settings.set(key, v)`: change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told. Returns the value kept (the old one when v is not a valid value)\\n- `settings.spec(key)`: the spec a setting was defined with (its label, type, range, options), or undefined\\n- `settings.saved`: false when the last save failed (storage blocked or full: the choices last for this visit)\\n- `fullscreen.enter(quiet)`: go full screen. Browsers allow it only from a tap, click or key press: call it from one (a button, the menu, a key's update step). Returns a promise of whether it worked (a refusal is kept in failed and noted on screen, unless quiet)\\n- `fullscreen.exit()`: leave full screen (Escape and the phone's back gesture do it too)\\n- `fullscreen.on`: true while the page is full screen\\n- `fullscreen.standalone`: true when the page was opened from a home screen as an app (no browser bars: nothing to go full screen from)\\n- `fullscreen.supported`: true where this page can go full screen (not an iPhone, which has Add to Home Screen instead; not a frame without permission; not headless)\\n- `fullscreen.toggle()`: full screen on or off, as the player asked (the corner's button, the menu): their choice is kept in settings.fullscreen, so a game starting on a phone goes full screen by itself only while they haven't turned it off\\n- `fullscreen.failed = null`: game: the game it serves; failed: why the last request was refused (a message), or null\\n\\n## 10c. Boot\\n\\n- `E.bootSplash(title = '')`: the boot screen's markup, for the very start of a page's <body>: it shows from the first paint, its bar moving while the page's scripts load (a pure CSS animation), and says so if the game's script never runs. The engine takes it over\\n- `E.diagnose(game = E.current)`: the report a bug needs, at any time (and on the boot screen when a game can't start): { engine, game, time, page, browser, device, screen, canvas, gpu, sound, storage, input, scene, errors, text (all of it, one line each, for a screenshot or a bug report), short (one line) }. game: the game to report on (E.current)\\n\\n## 10d. Tweens and scripts\\n\\n- `new E.Script(game, fn, o = {}) → script` †: a script, made by game.script: done (it returned, or was cancelled), value (what it returned), cancel(); another script can yield it\\n- `script.cancel()` †: stop it, and the scripts it is waiting on (its finally blocks run)\\n- `script.done = false` †: it returned, or was cancelled\\n- `script.keep` †: it outlives the scene\\n- `script.value` †: what it returned\\n- `new E.Tween(game, target, to, seconds, o = {}) → tween` †: a tween, made by game.tween: done (it ended, or was cancelled), cancel(); a script can yield it\\n- `tween.cancel()` †: stop it where it is (no onDone)\\n- `tween.done = false` †: it ended, or was cancelled\\n- `tween.keep` †: it outlives the scene\\n- `tween.target` †: what it moves\\n- `tween.to` †: the values it moves them to\\n- `E.all(list)` †: a script's wait for every one of its waits (seconds, conditions, tweens, scripts): yield E.all([a, b])\\n- `E.any(list)` †: a script's wait for the first of its waits to be over: yield E.any([boss.script, 30])\\n- `E.until(fn)` †: a script's wait until fn() is true: yield E.until(() => door.open)\",\"stderr\":\"\\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174804__x8cc180/work\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false},\"tool_result_meta\":[{\"id\":\"toolu_01RYd1DSfRbi9YcnTrJhALuH\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174737__x193f88/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174746__xe37f55/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174804__x8cc180/agent.out"]}},"tool_result_meta":[{"id":"toolu_019Avjm5zVNHv9zsUjDaixtR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CggyXo2YStcpJBjau9ULq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013CGQijgLhP6XFG6zpnZr7C","name":"Read","input":{"file_path":"/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff/modules/fight.js","limit":140},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4884,"cache_read_input_tokens":67286,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4884},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"997856d5-565c-4fe5-9a2a-c84837121a02","timestamp":"2026-11-04T00:54:25.890Z","request_id":"req_011CggyXnq8z15J9Q2bqR43t","wire_tool_inputs":{"toolu_013CGQijgLhP6XFG6zpnZr7C":{"file_path":"/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff/modules/fight.js","limit":140}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013CGQijgLhP6XFG6zpnZr7C","type":"tool_result","content":"1\t/*!\n2\tmy-3D2dge module FIGHT v0.85.2: one-on-one fighting: fighters with frame data, guards, throws, specials, a meter; rounds; a CPU; training\n3\thttps://github.com/michaelcrosato/my-3d2dge (MIT License)\n4\tLoads after: the full engine only. Needs: no other module.\n5\t\n6\tStreet Fighter II's rules, in the side view: for fighting games, and a boss duel in any side-scroller.\n7\t- const f = new E.Fighter(game, { name, x, rig: { size: 2.6, build: 'heroic', colors }, life: 1000, walk: 75, back: 60,\n8\t  moves }); E.Match gives each its foe and its control: an E.Input (the scene's input: E.FIGHT_KEYS; player 2's is\n9\t  game.players[1]) or a CPU. It faces its foe, walks, crouches on down, jumps on up (straight, forward or back), and\n10\t  holds back to block.\n11\t- moves: { id: spec }. A spec: move (an E.MOVES name the rig plays: 'jab', 'uppercut', 'roundhouse'; or its own\n12\t  fields), btn ('lp' | 'hp' | 'lk' | 'hk': the preset E.FIGHT_KEYS), when ('stand' | 'crouch' | 'air' | 'close'), or\n13\t  motion ('236', '623', '214', '41236': numpad notation, mirrored by facing) or charge ('46': back held .7 s, then\n14\t  forward; '28') for a special; f: [startup, active, recovery] (frames at 60; else the move's seconds), dmg, stun and\n15\t  block (frames of hit- and block-stun), guard ('mid' | 'low': blocked crouching | 'overhead': standing | 'throw'),\n16\t  chip (the share of dmg a block still takes: specials .25), push, launch (up speed: a juggle, then a knockdown), down\n17\t  (a knockdown), cancel (true: a special may cut it short once it connects), meter (a super's cost; 100 a bar), vx and\n18\t  vz (it travels: a spinning kick, a rising uppercut), inv (frames invulnerable from its start), shot ({ speed, r,\n19\t  dmg, color }: a projectile on E.Bullets, one at a time), teleport (units past the foe), throw (true: a command grab,\n20\t  range in units), r (the hit box's radius).\n21\t- A throw: the throw button (o.throwBtn, 'hp') with forward or back, close, on a foe standing or walking; it can't be\n22\t  blocked. Hits in a row scale down to half; a juggled foe takes three hits at most; a knockdown gets up invulnerable.\n23\t- f.life, f.meter, f.combo (the hits it has taken in a row), f.ko, f.boxes ({ hurt: [boxes], hit, push }: boxes\n24\t  { x, z, w, h }, x the left), f.last (the frame data of its last move: { id, startup, active, recovery, adv }).\n25\t- const m = new E.Match(game, { fighters: [a, b], ai: [null, new E.FightAI({ level: 4, seed: 1 })], rounds: 2 (wins\n26\t  needed), time: 99, x0: 0, x1: 520 (the stage's walls), training: false | { dummy: 'stand' | 'crouch' | 'jump' |\n27\t  'guard' } }): m.update(dt) runs it (ROUND 1, FIGHT!, K.O., TIME, PERFECT, the win poses, the next round); m.draw(r) draws the\n28\t  fighters, their shots and the HUD (life, timer, rounds, meters, combos, the calls; in training the boxes, the frame\n29\t  data and the input display). m.phase ('intro' | 'fight' | 'ko' | 'win' | 'over'), m.winner (0 or 1), m.wins, m.x.\n30\t- new E.FightAI({ level: 1..8, seed }): reads its foe after a reaction time (shorter at higher levels), keeps its\n31\t  range, guards, answers jumps with an anti-air (a move with aa: true), throws, confirms hits into specials. Its\n32\t  randomness is its own E.rng, so the same seed fights the same match.\n33\t- new E.FightSelect(game, { roster: [{ id, name, rig, about }], inputs: [p1, p2 or null], cpu: [false, true], onDone:\n34\t  ids => {} }): pick a fighter each (left, right, confirm; a tap on a portrait); update(dt), draw(r).\n35\t\n36\t```js fight\n37\tconst E = My3D2dge, game = new E.Game({ headless: true });\n38\tconst moves = { jab: { move: 'jab', btn: 'lp', dmg: 40, stun: 14, block: 10, cancel: true }, sweep: { move: 'sweep', btn: 'lk', when: 'crouch', guard: 'low', down: true, dmg: 70 },\n39\t  fire: { move: 'cast', btn: 'lp', motion: '236', shot: { speed: 160, dmg: 60 } }, rise: { move: 'uppercut', btn: 'hp', motion: '623', inv: 6, vz: 300, launch: 300, dmg: 110, aa: true } };\n40\tconst a = new E.Fighter(game, { name: 'A', moves }), b = new E.Fighter(game, { name: 'B', moves });\n41\tconst m = new E.Match(game, { fighters: [a, b], ai: [new E.FightAI({ level: 7, seed: 1 }), new E.FightAI({ level: 2, seed: 2 })], time: 30 });\n42\tgame.start({ update: dt => m.update(dt), draw: r => m.draw(r) });   // once a step, 120 times a second\n43\tfor (let s = 0; s < 300 && m.phase !== 'over'; s++) game.advance(1);\n44\tif (m.phase !== 'over' || m.wins[m.winner] < 2) throw new Error('a match ends with a winner');\n45\t```\n46\tRules: a fighter reads its input at the engine's 120 Hz step (motions too), so update it once a step; f.update(dt, ctl) takes an\n47\tE.Input or a CPU's intent ({ x, y: -1..1 on screen, press: a button, do: a move id }); frame data is in frames at 60.\n48\t*/\n49\t(function (E) {\n50\t'use strict';\n51\tif (!E) throw new Error('my-3D2dge module FIGHT: load engine/my-3d2dge.js first');\n52\tif (!E.Platformer || !E.Input.prototype.motion) throw new Error('my-3D2dge module FIGHT: it needs the full engine (E.Platformer, input.motion)');\n53\t\n54\t/* =============================================================================\n55\t * FIGHT  fighters, matches, a CPU, a character select and training\n56\t * ========================================================================== */\n57\tconst { clamp, lerp, approach, px } = E, FPS = 60, sec = n => n / FPS, frames = s => Math.round(s * FPS), PI = Math.PI;\n58\tconst D = E.Input.DEFAULT;\n59\t/** the fighting preset (a scene's input): the moves and menu keys of E.Input.DEFAULT, light and heavy punch (U, I; a\n60\t *  pad's X, Y), light and heavy kick (J, K; A, B) */\n61\tE.FIGHT_KEYS = { up: D.up, down: D.down, left: D.left, right: D.right, lp: ['KeyU', 'Pad2'], hp: ['KeyI', 'Pad3'], lk: ['KeyJ', 'Pad0'], hk: ['KeyK', 'Pad1'], start: D.start, pause: D.pause, confirm: D.confirm, cancel: D.cancel };\n62\tconst BTN = ['lp', 'hp', 'lk', 'hk'];\n63\t// what a move does by its button when the spec doesn't say: [dmg, stun, block, push]\n64\tconst BASE = { lp: [30, 13, 9, 70], hp: [80, 20, 15, 120], lk: [35, 14, 10, 80], hk: [90, 21, 16, 130] };\n65\tconst overlap = (a, b) => a.x < b.x + b.w && b.x < a.x + a.w && a.z < b.z + b.h && b.z < a.z + a.h;\n66\t\n67\t/** the floor the fighters stand on when no level is given: z 0 between walls at x0 and x1 (a Platformer's level) */\n68\tclass FightStage {\n69\t  /** new E.FightStage(x0, x1): a flat floor at z 0. x0: its left wall; x1: its right wall */\n70\t  constructor(x0 = 0, x1 = 520) { this.x0 = x0; this.x1 = x1; }\n71\t  /** move a body one step: the floor and the walls stop it */\n72\t  move(b, dt) {\n73\t    b.x += b.vx * dt; b.z += b.vz * dt; b.hitWall = 0; const h = b.w / 2;\n74\t    if (b.x - h < this.x0) { b.x = this.x0 + h; b.hitWall = -1; if (b.vx < 0) b.vx = 0; }\n75\t    if (b.x + h > this.x1) { b.x = this.x1 - h; b.hitWall = 1; if (b.vx > 0) b.vx = 0; }\n76\t    b.onGround = b.z <= 0 && b.vz <= 0; if (b.onGround) { b.z = 0; b.vz = 0; } b.onOneWay = false;\n77\t  }\n78\t  /** no ladders on a stage */\n79\t  touching() { return false; }\n80\t  /** no cells either */\n81\t  cellsTouching() { return []; }\n82\t}\n83\tE.FightStage = FightStage;\n84\t\n85\tclass Fighter {\n86\t  /** new E.Fighter(game, { name, x, side: 1 (faces right), rig: Humanoid options (or a Humanoid), life: 1000, walk: 75,\n87\t   *  back: 60, jump: 390, jumpX: 90, moves, throwBtn: 'hp', throwRange, throwDmg: 120, input }) */\n88\t  constructor(game, o = {}) {\n89\t    /** game: the game it fights in; name: its name on the HUD */\n90\t    this.game = game; this.name = o.name || 'FIGHTER';\n91\t    /** rig: its E.Humanoid (drawn and posed from its state every step) */\n92\t    this.rig = o.rig instanceof E.Humanoid ? o.rig : new E.Humanoid(Object.assign({ size: 2.6, build: 'heroic', weapon: null }, o.rig));\n93\t    const sz = this.rig.o.size;\n94\t    /** o: its options, with the defaults filled in */\n95\t    this.o = Object.assign({ life: 1000, walk: 75, back: 60, jump: 390, jumpX: 90, throwBtn: 'hp', throwRange: 13 * sz, throwDmg: 120 }, o);\n96\t    /** body: its E.Platformer (x, z: its feet; w, h: its push box) */\n97\t    this.body = new E.Platformer({ x: o.x || 0, w: 8 * sz, h: 30 * sz, run: this.o.walk, accel: 2400, decel: 3200, airAccel: 0, gravity: 1000, fallGravity: 1000, maxFall: 700, coyote: 0, buffer: 0, cut: 1 });\n98\t    /** moves: { id: spec }, each spec with its E.Attack (atk) and its frame data (frames: [startup, active, recovery]) */\n99\t    this.moves = {}; for (const id in o.moves || {}) this.moves[id] = this._spec(id, o.moves[id]);\n100\t    /** input: its E.Input, or null (a CPU passes its intent to update); foe: the other fighter (E.Match sets it); shots: its\n101\t   *  projectiles (E.Bullets, the side plane) */\n102\t    this.input = o.input || null; this.foe = null; this.shots = new E.Bullets(game, { plane: 'side', sparks: false, max: 4 }); this._level = o.stage || new FightStage();\n103\t    this._throwM = this._spec('throw', { move: 'throw', btn: this.o.throwBtn, f: [3, 10, 20], dmg: this.o.throwDmg });\n104\t    /** facing: 1 right, -1 left */\n105\t    this.facing = o.side || 1; this.reset(this.body.x, this.facing);\n106\t  }\n107\t  _spec(id, s) {\n108\t    const b = BASE[s.btn] || BASE.lp, m = Object.assign({ id, when: s.motion || s.charge ? null : 'stand', guard: 'mid', dmg: b[0], stun: b[1], block: b[2], push: b[3], chip: s.motion || s.charge ? .25 : 0, r: 5 }, s);\n109\t    const shape = typeof m.move === 'string' ? E.MOVES[m.move] || E.MOVES.jab : m.move || {};\n110\t    const t = m.f ? { wind: sec(m.f[0]), active: sec(m.f[1]), recover: sec(m.f[2]) } : {};\n111\t    m.atk = new E.Attack(Object.assign({ name: typeof m.move === 'string' ? m.move : id }, shape, t, { hitAt: 0 }));\n112\t    m.frames = [frames(m.atk.spec.wind), frames(m.atk.spec.active), frames(m.atk.spec.recover)];\n113\t    return m;\n114\t  }\n115\t  /** back to the start of a round: at x, facing side (1 right), full life (the meter stays) */\n116\t  reset(x, side = this.facing) {\n117\t    const b = this.body; Object.assign(b, { x, z: 0, vx: 0, vz: 0, stun: 0, onGround: true });\n118\t    /** life: what it has left (o.life at the start); meter: 0 to 100 a bar (bars: o.bars, 1), kept between rounds; combo:\n119\t     *  the hits it has taken in a row; ko: knocked out; win: in its win pose */\n120\t    this.life = this.o.life; this.meter = this.meter || 0; this.combo = 0; this.ko = false; this.win = false;\n121\t    /** act: the move playing ({ m, hit: it connected, blocked }), or null; stun: seconds of hit- or block-stun left; kind:\n122\t     *  'hit' | 'block' (which stun); down: seconds lying down; rise: seconds getting up; inv: seconds invulnerable; juggle:\n123\t     *  hits taken in the air; thrown: a throw holding it ({ by, t, dur, dir, dmg }), or null; air: flying from a hit */\n124\t    this.act = null; this.stun = 0; this.kind = null; this.down = 0; this.rise = 0; this.inv = 0; this.juggle = 0; this.thrown = null; this.air = false;\n125\t    /** facing: 1 right, -1 left; crouch: crouching; blocking: guarding (holding back as an attack comes, or in block-stun);\n126\t     *  last: the frame data of its last move to connect ({ id, startup, active, recovery, adv, on: 'hit' | 'block' }) */\n127\t    this.facing = side; this.crouch = false; this.blocking = false; this.last = null; this.shots.clear();\n128\t    this._want = null; this._chB = this._chD = this._gB = this._gD = 0; this._airUsed = false; this._lag = 1; this._t = 0;\n129\t  }\n130\t  /** x and z: the body's feet */\n131\t  get x() { return this.body.x; }\n132\t  /** its feet's height */\n133\t  get z() { return this.body.z; }\n134\t  /** true while it can act: on the ground, not stunned, down, thrown or out */\n135\t  get free() { return !this.ko && !this.win && !this.act && this.stun <= 0 && this.down <= 0 && this.rise <= 0 && !this.thrown && this.body.onGround && !this.air; }\n136\t  // read the control: an E.Input or a CPU's intent -> { x (+ toward the foe), y (+ down), raw x, buttons pressed, do }\n137\t  _read(ctl) {\n138\t    if (!ctl) return { x: 0, y: 0, sx: 0, press: [], do: null };\n139\t    if (typeof ctl.move === 'function') {\n140\t      const mv = ctl.move(), press = BTN.filter(k => ctl.map[k] && ctl.buffered(k, .1));"}]},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"bb65cb58-35a4-43b3-be7c-23dc26210be4","timestamp":"2026-11-04T00:54:25.896Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff/modules/fight.js","content":"/*!\nmy-3D2dge module FIGHT v0.85.2: one-on-one fighting: fighters with frame data, guards, throws, specials, a meter; rounds; a CPU; training\nhttps://github.com/michaelcrosato/my-3d2dge (MIT License)\nLoads after: the full engine only. Needs: no other module.\n\nStreet Fighter II's rules, in the side view: for fighting games, and a boss duel in any side-scroller.\n- const f = new E.Fighter(game, { name, x, rig: { size: 2.6, build: 'heroic', colors }, life: 1000, walk: 75, back: 60,\n  moves }); E.Match gives each its foe and its control: an E.Input (the scene's input: E.FIGHT_KEYS; player 2's is\n  game.players[1]) or a CPU. It faces its foe, walks, crouches on down, jumps on up (straight, forward or back), and\n  holds back to block.\n- moves: { id: spec }. A spec: move (an E.MOVES name the rig plays: 'jab', 'uppercut', 'roundhouse'; or its own\n  fields), btn ('lp' | 'hp' | 'lk' | 'hk': the preset E.FIGHT_KEYS), when ('stand' | 'crouch' | 'air' | 'close'), or\n  motion ('236', '623', '214', '41236': numpad notation, mirrored by facing) or charge ('46': back held .7 s, then\n  forward; '28') for a special; f: [startup, active, recovery] (frames at 60; else the move's seconds), dmg, stun and\n  block (frames of hit- and block-stun), guard ('mid' | 'low': blocked crouching | 'overhead': standing | 'throw'),\n  chip (the share of dmg a block still takes: specials .25), push, launch (up speed: a juggle, then a knockdown), down\n  (a knockdown), cancel (true: a special may cut it short once it connects), meter (a super's cost; 100 a bar), vx and\n  vz (it travels: a spinning kick, a rising uppercut), inv (frames invulnerable from its start), shot ({ speed, r,\n  dmg, color }: a projectile on E.Bullets, one at a time), teleport (units past the foe), throw (true: a command grab,\n  range in units), r (the hit box's radius).\n- A throw: the throw button (o.throwBtn, 'hp') with forward or back, close, on a foe standing or walking; it can't be\n  blocked. Hits in a row scale down to half; a juggled foe takes three hits at most; a knockdown gets up invulnerable.\n- f.life, f.meter, f.combo (the hits it has taken in a row), f.ko, f.boxes ({ hurt: [boxes], hit, push }: boxes\n  { x, z, w, h }, x the left), f.last (the frame data of its last move: { id, startup, active, recovery, adv }).\n- const m = new E.Match(game, { fighters: [a, b], ai: [null, new E.FightAI({ level: 4, seed: 1 })], rounds: 2 (wins\n  needed), time: 99, x0: 0, x1: 520 (the stage's walls), training: false | { dummy: 'stand' | 'crouch' | 'jump' |\n  'guard' } }): m.update(dt) runs it (ROUND 1, FIGHT!, K.O., TIME, PERFECT, the win poses, the next round); m.draw(r) draws the\n  fighters, their shots and the HUD (life, timer, rounds, meters, combos, the calls; in training the boxes, the frame\n  data and the input display). m.phase ('intro' | 'fight' | 'ko' | 'win' | 'over'), m.winner (0 or 1), m.wins, m.x.\n- new E.FightAI({ level: 1..8, seed }): reads its foe after a reaction time (shorter at higher levels), keeps its\n  range, guards, answers jumps with an anti-air (a move with aa: true), throws, confirms hits into specials. Its\n  randomness is its own E.rng, so the same seed fights the same match.\n- new E.FightSelect(game, { roster: [{ id, name, rig, about }], inputs: [p1, p2 or null], cpu: [false, true], onDone:\n  ids => {} }): pick a fighter each (left, right, confirm; a tap on a portrait); update(dt), draw(r).\n\n```js fight\nconst E = My3D2dge, game = new E.Game({ headless: true });\nconst moves = { jab: { move: 'jab', btn: 'lp', dmg: 40, stun: 14, block: 10, cancel: true }, sweep: { move: 'sweep', btn: 'lk', when: 'crouch', guard: 'low', down: true, dmg: 70 },\n  fire: { move: 'cast', btn: 'lp', motion: '236', shot: { speed: 160, dmg: 60 } }, rise: { move: 'uppercut', btn: 'hp', motion: '623', inv: 6, vz: 300, launch: 300, dmg: 110, aa: true } };\nconst a = new E.Fighter(game, { name: 'A', moves }), b = new E.Fighter(game, { name: 'B', moves });\nconst m = new E.Match(game, { fighters: [a, b], ai: [new E.FightAI({ level: 7, seed: 1 }), new E.FightAI({ level: 2, seed: 2 })], time: 30 });\ngame.start({ update: dt => m.update(dt), draw: r => m.draw(r) });   // once a step, 120 times a second\nfor (let s = 0; s < 300 && m.phase !== 'over'; s++) game.advance(1);\nif (m.phase !== 'over' || m.wins[m.winner] < 2) throw new Error('a match ends with a winner');\n```\nRules: a fighter reads its input at the engine's 120 Hz step (motions too), so update it once a step; f.update(dt, ctl) takes an\nE.Input or a CPU's intent ({ x, y: -1..1 on screen, press: a button, do: a move id }); frame data is in frames at 60.\n*/\n(function (E) {\n'use strict';\nif (!E) throw new Error('my-3D2dge module FIGHT: load engine/my-3d2dge.js first');\nif (!E.Platformer || !E.Input.prototype.motion) throw new Error('my-3D2dge module FIGHT: it needs the full engine (E.Platformer, input.motion)');\n\n/* =============================================================================\n * FIGHT  fighters, matches, a CPU, a character select and training\n * ========================================================================== */\nconst { clamp, lerp, approach, px } = E, FPS = 60, sec = n => n / FPS, frames = s => Math.round(s * FPS), PI = Math.PI;\nconst D = E.Input.DEFAULT;\n/** the fighting preset (a scene's input): the moves and menu keys of E.Input.DEFAULT, light and heavy punch (U, I; a\n *  pad's X, Y), light and heavy kick (J, K; A, B) */\nE.FIGHT_KEYS = { up: D.up, down: D.down, left: D.left, right: D.right, lp: ['KeyU', 'Pad2'], hp: ['KeyI', 'Pad3'], lk: ['KeyJ', 'Pad0'], hk: ['KeyK', 'Pad1'], start: D.start, pause: D.pause, confirm: D.confirm, cancel: D.cancel };\nconst BTN = ['lp', 'hp', 'lk', 'hk'];\n// what a move does by its button when the spec doesn't say: [dmg, stun, block, push]\nconst BASE = { lp: [30, 13, 9, 70], hp: [80, 20, 15, 120], lk: [35, 14, 10, 80], hk: [90, 21, 16, 130] };\nconst overlap = (a, b) => a.x < b.x + b.w && b.x < a.x + a.w && a.z < b.z + b.h && b.z < a.z + a.h;\n\n/** the floor the fighters stand on when no level is given: z 0 between walls at x0 and x1 (a Platformer's level) */\nclass FightStage {\n  /** new E.FightStage(x0, x1): a flat floor at z 0. x0: its left wall; x1: its right wall */\n  constructor(x0 = 0, x1 = 520) { this.x0 = x0; this.x1 = x1; }\n  /** move a body one step: the floor and the walls stop it */\n  move(b, dt) {\n    b.x += b.vx * dt; b.z += b.vz * dt; b.hitWall = 0; const h = b.w / 2;\n    if (b.x - h < this.x0) { b.x = this.x0 + h; b.hitWall = -1; if (b.vx < 0) b.vx = 0; }\n    if (b.x + h > this.x1) { b.x = this.x1 - h; b.hitWall = 1; if (b.vx > 0) b.vx = 0; }\n    b.onGround = b.z <= 0 && b.vz <= 0; if (b.onGround) { b.z = 0; b.vz = 0; } b.onOneWay = false;\n  }\n  /** no ladders on a stage */\n  touching() { return false; }\n  /** no cells either */\n  cellsTouching() { return []; }\n}\nE.FightStage = FightStage;\n\nclass Fighter {\n  /** new E.Fighter(game, { name, x, side: 1 (faces right), rig: Humanoid options (or a Humanoid), life: 1000, walk: 75,\n   *  back: 60, jump: 390, jumpX: 90, moves, throwBtn: 'hp', throwRange, throwDmg: 120, input }) */\n  constructor(game, o = {}) {\n    /** game: the game it fights in; name: its name on the HUD */\n    this.game = game; this.name = o.name || 'FIGHTER';\n    /** rig: its E.Humanoid (drawn and posed from its state every step) */\n    this.rig = o.rig instanceof E.Humanoid ? o.rig : new E.Humanoid(Object.assign({ size: 2.6, build: 'heroic', weapon: null }, o.rig));\n    const sz = this.rig.o.size;\n    /** o: its options, with the defaults filled in */\n    this.o = Object.assign({ life: 1000, walk: 75, back: 60, jump: 390, jumpX: 90, throwBtn: 'hp', throwRange: 13 * sz, throwDmg: 120 }, o);\n    /** body: its E.Platformer (x, z: its feet; w, h: its push box) */\n    this.body = new E.Platformer({ x: o.x || 0, w: 8 * sz, h: 30 * sz, run: this.o.walk, accel: 2400, decel: 3200, airAccel: 0, gravity: 1000, fallGravity: 1000, maxFall: 700, coyote: 0, buffer: 0, cut: 1 });\n    /** moves: { id: spec }, each spec with its E.Attack (atk) and its frame data (frames: [startup, active, recovery]) */\n    this.moves = {}; for (const id in o.moves || {}) this.moves[id] = this._spec(id, o.moves[id]);\n    /** input: its E.Input, or null (a CPU passes its intent to update); foe: the other fighter (E.Match sets it); shots: its\n   *  projectiles (E.Bullets, the side plane) */\n    this.input = o.input || null; this.foe = null; this.shots = new E.Bullets(game, { plane: 'side', sparks: false, max: 4 }); this._level = o.stage || new FightStage();\n    this._throwM = this._spec('throw', { move: 'throw', btn: this.o.throwBtn, f: [3, 10, 20], dmg: this.o.throwDmg });\n    /** facing: 1 right, -1 left */\n    this.facing = o.side || 1; this.reset(this.body.x, this.facing);\n  }\n  _spec(id, s) {\n    const b = BASE[s.btn] || BASE.lp, m = Object.assign({ id, when: s.motion || s.charge ? null : 'stand', guard: 'mid', dmg: b[0], stun: b[1], block: b[2], push: b[3], chip: s.motion || s.charge ? .25 : 0, r: 5 }, s);\n    const shape = typeof m.move === 'string' ? E.MOVES[m.move] || E.MOVES.jab : m.move || {};\n    const t = m.f ? { wind: sec(m.f[0]), active: sec(m.f[1]), recover: sec(m.f[2]) } : {};\n    m.atk = new E.Attack(Object.assign({ name: typeof m.move === 'string' ? m.move : id }, shape, t, { hitAt: 0 }));\n    m.frames = [frames(m.atk.spec.wind), frames(m.atk.spec.active), frames(m.atk.spec.recover)];\n    return m;\n  }\n  /** back to the start of a round: at x, facing side (1 right), full life (the meter stays) */\n  reset(x, side = this.facing) {\n    const b = this.body; Object.assign(b, { x, z: 0, vx: 0, vz: 0, stun: 0, onGround: true });\n    /** life: what it has left (o.life at the start); meter: 0 to 100 a bar (bars: o.bars, 1), kept between rounds; combo:\n     *  the hits it has taken in a row; ko: knocked out; win: in its win pose */\n    this.life = this.o.life; this.meter = this.meter || 0; this.combo = 0; this.ko = false; this.win = false;\n    /** act: the move playing ({ m, hit: it connected, blocked }), or null; stun: seconds of hit- or block-stun left; kind:\n     *  'hit' | 'block' (which stun); down: seconds lying down; rise: seconds getting up; inv: seconds invulnerable; juggle:\n     *  hits taken in the air; thrown: a throw holding it ({ by, t, dur, dir, dmg }), or null; air: flying from a hit */\n    this.act = null; this.stun = 0; this.kind = null; this.down = 0; this.rise = 0; this.inv = 0; this.juggle = 0; this.thrown = null; this.air = false;\n    /** facing: 1 right, -1 left; crouch: crouching; blocking: guarding (holding back as an attack comes, or in block-stun);\n     *  last: the frame data of its last move to connect ({ id, startup, active, recovery, adv, on: 'hit' | 'block' }) */\n    this.facing = side; this.crouch = false; this.blocking = false; this.last = null; this.shots.clear();\n    this._want = null; this._chB = this._chD = this._gB = this._gD = 0; this._airUsed = false; this._lag = 1; this._t = 0;\n  }\n  /** x and z: the body's feet */\n  get x() { return this.body.x; }\n  /** its feet's height */\n  get z() { return this.body.z; }\n  /** true while it can act: on the ground, not stunned, down, thrown or out */\n  get free() { return !this.ko && !this.win && !this.act && this.stun <= 0 && this.down <= 0 && this.rise <= 0 && !this.thrown && this.body.onGround && !this.air; }\n  // read the control: an E.Input or a CPU's intent -> { x (+ toward the foe), y (+ down), raw x, buttons pressed, do }\n  _read(ctl) {\n    if (!ctl) return { x: 0, y: 0, sx: 0, press: [], do: null };\n    if (typeof ctl.move === 'function') {\n      const mv = ctl.move(), press = BTN.filter(k => ctl.map[k] && ctl.buffered(k, .1));","numLines":140,"startLine":1,"totalLines":551}},"tool_result_meta":[{"id":"toolu_013CGQijgLhP6XFG6zpnZr7C","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
