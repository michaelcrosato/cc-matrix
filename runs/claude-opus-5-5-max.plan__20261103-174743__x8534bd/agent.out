{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013REF4e1KZ28makBUG96SS2","type":"tool_result","content":"355\t  /** new E.FightAI({ level: 1..8 (4), seed }): a CPU for a fighter. level: how well it fights; react: seconds before it\n356\t   *  sees what its foe does; rng: its own randomness */\n357\t  constructor(o = {}) {\n358\t    /** level: how well it fights (1 to 8); react: seconds before it sees what its foe does; rng: its own randomness (the\n359\t     *  seed's: the same match each time) */\n360\t    this.level = clamp(o.level || 4, 1, 8); this.react = lerp(.42, .12, (this.level - 1) / 7); this.rng = E.rng(o.seed || 1);\n361\t    this._seen = []; this._plan = null; this._t = 0; this._think = 0;\n362\t  }\n363\t  /** what it does this step: an intent for fighter f.update(dt, intent) ({ x, y: -1..1 on screen, press, do }) */\n364\t  intent(f, foe, dt) {\n365\t    const R = this.rng, L = this.level / 8, out = { x: 0, y: 0, press: null, do: null }, dist = Math.abs(foe.x - f.x), toward = Math.sign(foe.x - f.x) || f.facing;\n366\t    this._t += dt; this._seen.push({ t: this._t, atk: foe.act && foe.act.m.atk.phase !== 'recover' ? foe.act.m : null, air: !foe.body.onGround && !foe.air, vx: foe.body.vx, shot: foe.shots.list.length > 0, x: foe.x });\n367\t    while (this._seen.length > 2 && this._seen[1].t <= this._t - this.react) this._seen.shift();\n368\t    const seen = this._seen[0], moves = Object.values(f.moves);\n369\t    // a hit that landed: cancel into a special\n370\t    if (f.act && f.act.hit && f.act.m.cancel && R() < L) { const sp = moves.filter(m => m.motion && !m.meter && !m.shot && !m.throw && !m.teleport); if (sp.length) { out.do = sp[Math.floor(R() * sp.length)].id; return out; } }\n371\t    if (!f.free) { if (!f.body.onGround && !f.act && !f.air && dist < 60 && R() < .1) out.press = 'hk'; else if (this._plan && this._plan.guard) out.x = -toward; return out; }\n372\t    // its foe jumps at it: an anti-air\n373\t    const aa = moves.find(m => m.aa);\n374\t    if (seen.air && dist < 90 && aa && R() < L * .9) { out.do = aa.id; return out; }\n375\t    // an attack or a shot comes: guard (low against a low move)\n376\t    if ((seen.atk && dist < 100 || seen.shot) && R() < .35 + L * .6) { out.x = -toward; out.y = seen.atk && seen.atk.guard === 'low' ? 1 : 0; this._plan = { guard: true, t: .25 }; return out; }\n377\t    if (this._plan && (this._plan.t -= dt) > 0) { if (this._plan.guard) { out.x = -toward; return out; } Object.assign(out, this._plan.out); return out; }\n378\t    this._plan = null;\n379\t    if ((this._think -= dt) > 0) { out.x = this._walk || 0; return out; }\n380\t    this._think = lerp(.35, .12, L) + R() * .2;\n381\t    const shot = moves.find(m => m.shot), normals = moves.filter(m => !m.motion && !m.charge && m.when !== 'air');\n382\t    const reach = m => (m.atk.spec.reach || m.atk.spec.r1 || 7) * f.rig.o.size + 18;\n383\t    const inReach = normals.filter(m => dist < reach(m));\n384\t    const r = R();\n385\t    if (dist > 150 && shot && !f.shots.list.length && r < .5) { out.do = shot.id; return out; }\n386\t    if (dist < f.o.throwRange && r < .25 * L + .05 && foe._throwable()) { out.x = toward; out.press = f.o.throwBtn; return out; }\n387\t    if (inReach.length && r < .55 + L * .3) {\n388\t      const m = inReach[Math.floor(R() * inReach.length)]; out.press = m.btn; if (m.when === 'crouch') out.y = 1;\n389\t      this._plan = { t: .05, out: { y: out.y } }; return out;\n390\t    }\n391\t    if (r < .12 + L * .05 && dist < 160 && dist > 50) { out.y = -1; out.x = toward; this._walk = 0; return out; }   // a jump in\n392\t    this._walk = dist > 70 ? toward : dist < 40 ? -toward : (R() < .5 ? toward : 0); out.x = this._walk; return out;\n393\t  }\n394\t}\n395\tE.FightAI = FightAI;\n396\t\n397\tconst CALL = ['#fff6d0', '#ffd060', '#e8782a'];\n398\tclass Match {\n399\t  /** new E.Match(game, { fighters: [a, b], ai: [null, null] (E.FightAI each, or null for its input), inputs: [game.\n400\t   *  input, null], rounds: 2 (wins needed), time: 99, x0: 0, x1: 520, span: 250 (how far apart they may be), camera:\n401\t   *  true (the game's camera follows them), training: false | { dummy }, onEnd: winner => {} }) */\n402\t  constructor(game, o = {}) {\n403\t    /** game: the game it runs in; o: its options, with the defaults filled in */\n404\t    this.game = game; this.o = Object.assign({ rounds: 2, time: 99, x0: 0, x1: 520, span: 250, camera: true, training: false }, o);\n405\t    /** f: the two fighters; ai: each one's CPU (E.FightAI), or null; inputs: each one's E.Input when no CPU plays it */\n406\t    this.f = o.fighters; this.ai = o.ai || [null, null]; this.inputs = o.inputs || [game.input, game.players ? game.players[1] || null : null];\n407\t    /** stage: the floor and walls they stand in (E.FightStage) */\n408\t    this.stage = o.stage || new FightStage(this.o.x0, this.o.x1);\n409\t    this.f[0].foe = this.f[1]; this.f[1].foe = this.f[0]; for (const f of this.f) f._level = this.stage;\n410\t    /** wins: the rounds each has won; round: the round's number; winner: 0 or 1 once known (a round's, then the match's), or\n411\t     *  null */\n412\t    this.wins = [0, 0]; this.round = 0; this.winner = null; this.startRound();\n413\t  }\n414\t  /** the stage's middle */\n415\t  get x() { return (this.f[0].x + this.f[1].x) / 2; }\n416\t  /** the next round: both back at the middle, full life */\n417\t  startRound() {\n418\t    const mid = (this.o.x0 + this.o.x1) / 2; this.round++;\n419\t    this.f[0].reset(mid - 60, 1); this.f[1].reset(mid + 60, -1);\n420\t    /** phase: 'intro' | 'fight' | 'ko' | 'win' | 'over'; clock: the round's seconds left; call: the words on the screen\n421\t     *  (ROUND 1, FIGHT!, K.O., TIME, PERFECT), or null */\n422\t    this.phase = this.o.training ? 'fight' : 'intro'; this._t = 0; this.clock = this.o.time; this.winner = null; this.call = this.o.training ? null : 'ROUND ' + this.round; this._slow = 0;\n423\t  }\n424\t  _control(i) {\n425\t    if (this.phase !== 'fight') return null;\n426\t    const ai = this.ai[i]; if (ai) return ai.intent(this.f[i], this.f[1 - i], this._dt);\n427\t    if (this.o.training && i === 1) {   // the dummy\n428\t      const d = this.o.training.dummy || 'stand', f = this.f[1], foe = this.f[0], back = -Math.sign(foe.x - f.x);\n429\t      if (d === 'crouch') return { y: 1 }; if (d === 'jump') return { y: f.body.onGround ? -1 : 0 };\n430\t      if (d === 'guard') return { x: back, y: foe.act && foe.act.m.guard === 'low' ? 1 : 0 };\n431\t      return {};\n432\t    }\n433\t    return this.inputs[i];\n434\t  }\n435\t  /** one step: the fighters, their exchange, the clock, the calls and the rounds */\n436\t  update(dt) {\n437\t    const [a, b] = this.f; this._t += dt; this._dt = dt;\n438\t    a.update(dt, this._control(0)); b.update(dt, this._control(1)); Fighter.exchange(a, b);\n439\t    const span = this.o.span, d = b.x - a.x;   // never farther apart than the screen\n440\t    if (Math.abs(d) > span) { const fix = (Math.abs(d) - span) * Math.sign(d) / 2; a.body.x += fix; b.body.x -= fix; }\n441\t    if (this.o.camera) this.game.focus(this.x, 0, 52);\n442\t    if (this.o.training) {   // no KO; life back once a combo ends\n443\t      for (const f of this.f) if (f.life <= 0) { f.life = 1; f.ko = false; }\n444\t      for (const f of this.f) if (f.combo === 0 && f.stun <= 0 && f.down <= 0 && !f.air) { f.life = Math.min(f.o.life, f.life + f.o.life * dt); if (f.ko) f.ko = false; }\n445\t      for (const f of this.f) f.meter = 100 * (f.o.bars || 1);\n446\t      return;\n447\t    }\n448\t    if (this.phase === 'intro') { if (this._t > 1.1) this.call = 'FIGHT!'; if (this._t > 1.8) { this.phase = 'fight'; this.call = null; this._t = 0; } }\n449\t    else if (this.phase === 'fight') {\n450\t      this.clock = Math.max(0, this.clock - dt);\n451\t      if (a.ko || b.ko || this.clock <= 0) {\n452\t        this.phase = 'ko'; this._t = 0; this.call = a.ko || b.ko ? 'K.O.' : 'TIME';\n453\t        this.winner = a.ko && b.ko ? null : a.ko ? 1 : b.ko ? 0 : a.life === b.life ? null : a.life > b.life ? 0 : 1;\n454\t        if (a.ko || b.ko) { this.game.timeScale = .35; this._slow = .9; this.game.flash('#ffffff', .2); this.game.audio.sfx('boom'); }\n455\t      }\n456\t    } else if (this.phase === 'ko') {\n457\t      if (this._slow > 0 && (this._slow -= dt / Math.max(.01, this.game.timeScale)) <= 0) this.game.timeScale = 1;\n458\t      if (this._t > 2.2 && [a, b].every(f => f.body.onGround && !f.thrown)) {\n459\t        this.phase = 'win'; this._t = 0;\n460\t        if (this.winner === null) { this.wins[0]++; this.wins[1]++; this.call = 'DRAW'; }\n461\t        else { const w = this.f[this.winner]; this.wins[this.winner]++; w.win = true; this.call = w.life >= w.o.life ? 'PERFECT' : w.name + ' WINS'; this.game.audio.sfx('powerup'); }\n462\t      }\n463\t    } else if (this.phase === 'win' && this._t > 2.6) {\n464\t      const done = this.wins.map(n => n >= this.o.rounds);\n465\t      if (done[0] !== done[1]) { this.phase = 'over'; this.winner = done[0] ? 0 : 1; this.call = this.f[this.winner].name + ' WINS'; if (this.o.onEnd) this.o.onEnd(this.winner); }\n466\t      else this.startRound();\n467\t    }\n468\t  }\n469\t  /** draw the fighters, their shots and the HUD; in training the boxes, the frame data and player 1's inputs */\n470\t  draw(r) {\n471\t    const [a, b] = this.f; a.draw(r); b.draw(r);\n472\t    if (this.o.training) { a.drawBoxes(r); b.drawBoxes(r); }\n473\t    r.overlay(g => this._hud(g, r.W, r.H));\n474\t  }\n475\t  _hud(g, W, H) {   // (below a phone's corner button when it sits on top)\n476\t    const font = E.font, bw = Math.floor(W / 2) - 34, ca = this.game.input.lastDevice === 'touch' && this.game.cornerArea ? this.game.cornerArea() : null, y = ca && ca.y0 < 40 ? Math.ceil(ca.y1) + 6 : 10;\n477\t    this.f.forEach((f, i) => {\n478\t      const x = i ? W - 12 - bw : 12, k = f.life / f.o.life, lag = f._lag, flip = i === 1;\n479\t      px.rect(g, x - 1, y - 1, bw + 2, 10, '#140b12'); px.rect(g, x, y, bw, 8, '#3a1a26');\n480\t      const fill = (u, c) => { const w = Math.round(bw * clamp(u, 0, 1)); if (w > 0) px.rect(g, flip ? x : x + bw - w, y, w, 8, c); };\n481\t      fill(lag, '#e0463c'); fill(k, k < .25 ? '#ff9a2a' : '#ffd23a'); px.rect(g, x, y, bw, 1, '#fff6c0');\n482\t      font.text(g, f.name, flip ? x + bw : x, y + 12, '#ffffff', { align: flip ? 'right' : 'left', shadow: '#000', outline: false });\n483\t      for (let w = 0; w < this.o.rounds; w++) { const sx = flip ? x + w * 9 : x + bw - 7 - w * 9; px.disc(g, sx + 3, y + 16, 3, w < this.wins[i] ? '#ffd23a' : '#3a2a4a'); }\n484\t      const mb = Math.round(bw * .6), mx = flip ? W - 12 - mb : 12, my = H - 12, mk = f.meter / 100, full = mk >= 1;\n485\t      E.ui.bar(g, mx, my, mb, 6, mk % 1 || (full ? 1 : 0), full && Math.floor(this.game.real * 6) % 2 ? '#a0f0ff' : '#3a8aff');\n486\t      if (f.combo > 1 && f.stun > 0) font.title(g, f.combo + ' HITS', flip ? 14 : W - 14, y + 44, { scale: 2, align: flip ? 'left' : 'right', colors: CALL });\n487\t    });\n488\t    if (!this.o.training) { const box = Math.round(W / 2); E.ui.box(g, box - 15, y - 6, 30, 22, { bg: ['#2a1a4a', '#120a28'] }); font.title(g, String(Math.ceil(this.clock)).padStart(2, '0'), box, y - 3, { scale: 2, align: 'center', colors: ['#ffffff', '#c8d8ff'] }); }\n489\t    if (this.call) font.title(g, this.call, W / 2, H / 2 - 30, { scale: 4, align: 'center', colors: CALL, depth: 3 });\n490\t    if (this.o.training) {   // frame data and player 1's last second of inputs\n491\t      const L = this.f[0].last; if (L) font.text(g, L.id.toUpperCase() + '  STARTUP ' + L.startup + '  ACTIVE ' + L.active + '  RECOVERY ' + L.recovery + (L.adv === null ? '  KNOCKDOWN' : '  ON ' + L.on.toUpperCase() + ' ' + (L.adv > 0 ? '+' : '') + L.adv), 12, y + 24, '#c8f0ff', { shadow: '#000', outline: false, font: 'tiny' });\n492\t      const I = this.inputs[0], hist = I && I.history ? I.history.slice(-12) : [], mir = { 1: 3, 3: 1, 4: 6, 6: 4, 7: 9, 9: 7 };   // (numpad digits, as the fighter faces)\n493\t      hist.forEach((h, k) => font.text(g, (this.f[0].facing < 0 ? mir[h.dir] || h.dir : h.dir) + ' ' + h.pressed.filter(p => BTN.includes(p)).join('+').toUpperCase(), 12, y + 36 + k * 8, '#ffffff', { shadow: '#000', outline: false, font: 'tiny' }));\n494\t    }\n495\t  }\n496\t}\n497\tE.Match = Match;\n498\t\n499\tclass FightSelect {\n500\t  /** new E.FightSelect(game, { roster: [{ id, name, rig, about }], inputs: [p1, p2 or null], cpu: [false, true],\n501\t   *  seed, onDone: ids => {} }): a character select. picks: each side's id once chosen; at: each side's cursor */\n502\t  constructor(game, o = {}) {\n503\t    /** game: the game it runs in; o: its options; roster: the fighters to pick from; inputs: each side's E.Input; cpu: which\n504\t     *  sides the CPU picks for */\n505\t    this.game = game; this.o = o; this.roster = o.roster || []; this.inputs = o.inputs || [game.input, null]; this.cpu = o.cpu || [false, true];\n506\t    /** at: each side's cursor; picks: each side's id once chosen; rects: where each portrait was drawn ([x, y, w, h] in\n507\t     *  screen pixels: a tap there picks it) */\n508\t    this.at = [0, Math.min(1, this.roster.length - 1)]; this.picks = [null, null]; this.rects = null; this._t = 0; this._cpuT = [0, 0]; this._rng = E.rng(o.seed || 7);\n509\t    /** rigs: each fighter's portrait rig */\n510\t    this.rigs = this.roster.map(e => { const r = new E.Humanoid(Object.assign({ size: 1, weapon: null }, e.rig, { size: 1 })); r.update(0, { x: 0, y: 0, z: 0, stance: 'guard' }); return r; });\n511\t  }\n512\t  /** move the cursors, take the picks; onDone(ids) once both have one */\n513\t  update(dt) {\n514\t    this._t += dt; const n = this.roster.length;\n515\t    for (let i = 0; i < 2; i++) {\n516\t      if (this.picks[i]) continue;\n517\t      if (this.cpu[i]) { if ((this._cpuT[i] += dt) > .8 && this.picks[0]) this.picks[i] = this.roster[this.at[i] = Math.floor(this._rng() * n)].id; continue; }\n518\t      const I = this.inputs[i]; if (!I) continue;\n519\t      const tap = i === 0 && this.rects && I.clicked ? I.clicked() : null, k = tap ? this.rects.findIndex(([x, y, w, h]) => tap[0] >= x && tap[0] < x + w && tap[1] >= y && tap[1] < y + h) : -1;\n520\t      if (k >= 0) { this.at[0] = k; this.picks[0] = this.roster[k].id; this.game.audio.sfx('confirm'); continue; }   // a tap on a portrait picks it\n521\t      if (I.repeat('left')) { this.at[i] = (this.at[i] + n - 1) % n; this.game.audio.sfx('select'); }\n522\t      if (I.repeat('right')) { this.at[i] = (this.at[i] + 1) % n; this.game.audio.sfx('select'); }\n523\t      if (BTN.some(k => I.map[k] && I.pressed(k)) || I.pressed('confirm') || I.pressed('start')) { this.picks[i] = this.roster[this.at[i]].id; this.game.audio.sfx('confirm'); I.consumeAll(); }\n524\t    }\n525\t    if (this.picks[0] && this.picks[1] && !this._done) { this._done = this._t + .7; }\n526\t    if (this._done && this._t >= this._done && this.o.onDone) { this.o.onDone(this.picks.slice()); this.o.onDone = null; }\n527\t  }\n528\t  /** draw the roster, the cursors and each side's fighter large */\n529\t  draw(r) {\n530\t    r.overlay(g => {\n531\t      const W = r.W, H = r.H, n = this.roster.length, s = Math.min(46, Math.floor((W - 40) / n) - 6), x0 = Math.round(W / 2 - (n * (s + 6) - 6) / 2), y = H - s - 34;\n532\t      E.font.title(g, 'SELECT YOUR FIGHTER', W / 2, 10, { scale: 2, align: 'center', colors: CALL });\n533\t      for (let i = 0; i < 2; i++) {\n534\t        const e = this.roster[this.at[i]], big = Math.min(96, Math.round(H * .42)), bx = i ? W - 16 - big : 16;\n535\t        this.rigs[this.at[i]].drawPortrait(g, bx, 36, big, { zoom: 2.4, turn: i ? -.6 : .6, bg: i ? ['#ff8a6a', '#5a1a2a'] : ['#6ab0ff', '#1a2a5a'], border: E.PLAYER_COLORS[i] });\n536\t        E.font.text(g, e.name, bx + big / 2, 40 + big, '#ffffff', { align: 'center', shadow: '#000', outline: false });\n537\t        if (e.about) E.font.text(g, e.about, bx + big / 2, 50 + big, '#c8b8e8', { align: 'center', outline: false, font: 'tiny' });\n538\t        if (this.picks[i]) E.font.text(g, 'READY', bx + big / 2, 30, E.PLAYER_COLORS[i], { align: 'center', shadow: '#000', outline: false });\n539\t      }\n540\t      E.font.title(g, 'VS', W / 2, 70, { scale: 3, align: 'center', colors: ['#ffffff', '#ff8a6a', '#c0302a'] });\n541\t      this.rects = this.roster.map((e, k) => [x0 + k * (s + 6), y, s, s]);   // (where a tap picks)\n542\t      this.roster.forEach((e, k) => {\n543\t        const x = x0 + k * (s + 6); this.rigs[k].drawPortrait(g, x, y, s, { zoom: 2, turn: .5 });\n544\t        for (let i = 0; i < 2; i++) if (this.at[i] === k && (!this.cpu[i] || this.picks[0])) { const c = E.PLAYER_COLORS[i], o = i * 2; px.rect(g, x - 2 - o, y - 2 - o, s + 4 + o * 2, 2, c); px.rect(g, x - 2 - o, y + s + o, s + 4 + o * 2, 2, c); px.rect(g, x - 2 - o, y - 2 - o, 2, s + 4 + o * 2, c); px.rect(g, x + s + o, y - 2 - o, 2, s + 4 + o * 2, c); E.font.text(g, this.cpu[i] ? 'CPU' : 'P' + (i + 1), x + s / 2, y + s + 6, c, { align: 'center', outline: false, font: 'tiny' }); }\n545\t      });\n546\t    });\n547\t  }\n548\t}\n549\tE.FightSelect = FightSelect;\n550\t})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);"}]},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"38e897c8-d7af-482e-8181-f345435e6d90","timestamp":"2026-11-04T00:54:31.481Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff/modules/fight.js","content":"  /** new E.FightAI({ level: 1..8 (4), seed }): a CPU for a fighter. level: how well it fights; react: seconds before it\n   *  sees what its foe does; rng: its own randomness */\n  constructor(o = {}) {\n    /** level: how well it fights (1 to 8); react: seconds before it sees what its foe does; rng: its own randomness (the\n     *  seed's: the same match each time) */\n    this.level = clamp(o.level || 4, 1, 8); this.react = lerp(.42, .12, (this.level - 1) / 7); this.rng = E.rng(o.seed || 1);\n    this._seen = []; this._plan = null; this._t = 0; this._think = 0;\n  }\n  /** what it does this step: an intent for fighter f.update(dt, intent) ({ x, y: -1..1 on screen, press, do }) */\n  intent(f, foe, dt) {\n    const R = this.rng, L = this.level / 8, out = { x: 0, y: 0, press: null, do: null }, dist = Math.abs(foe.x - f.x), toward = Math.sign(foe.x - f.x) || f.facing;\n    this._t += dt; this._seen.push({ t: this._t, atk: foe.act && foe.act.m.atk.phase !== 'recover' ? foe.act.m : null, air: !foe.body.onGround && !foe.air, vx: foe.body.vx, shot: foe.shots.list.length > 0, x: foe.x });\n    while (this._seen.length > 2 && this._seen[1].t <= this._t - this.react) this._seen.shift();\n    const seen = this._seen[0], moves = Object.values(f.moves);\n    // a hit that landed: cancel into a special\n    if (f.act && f.act.hit && f.act.m.cancel && R() < L) { const sp = moves.filter(m => m.motion && !m.meter && !m.shot && !m.throw && !m.teleport); if (sp.length) { out.do = sp[Math.floor(R() * sp.length)].id; return out; } }\n    if (!f.free) { if (!f.body.onGround && !f.act && !f.air && dist < 60 && R() < .1) out.press = 'hk'; else if (this._plan && this._plan.guard) out.x = -toward; return out; }\n    // its foe jumps at it: an anti-air\n    const aa = moves.find(m => m.aa);\n    if (seen.air && dist < 90 && aa && R() < L * .9) { out.do = aa.id; return out; }\n    // an attack or a shot comes: guard (low against a low move)\n    if ((seen.atk && dist < 100 || seen.shot) && R() < .35 + L * .6) { out.x = -toward; out.y = seen.atk && seen.atk.guard === 'low' ? 1 : 0; this._plan = { guard: true, t: .25 }; return out; }\n    if (this._plan && (this._plan.t -= dt) > 0) { if (this._plan.guard) { out.x = -toward; return out; } Object.assign(out, this._plan.out); return out; }\n    this._plan = null;\n    if ((this._think -= dt) > 0) { out.x = this._walk || 0; return out; }\n    this._think = lerp(.35, .12, L) + R() * .2;\n    const shot = moves.find(m => m.shot), normals = moves.filter(m => !m.motion && !m.charge && m.when !== 'air');\n    const reach = m => (m.atk.spec.reach || m.atk.spec.r1 || 7) * f.rig.o.size + 18;\n    const inReach = normals.filter(m => dist < reach(m));\n    const r = R();\n    if (dist > 150 && shot && !f.shots.list.length && r < .5) { out.do = shot.id; return out; }\n    if (dist < f.o.throwRange && r < .25 * L + .05 && foe._throwable()) { out.x = toward; out.press = f.o.throwBtn; return out; }\n    if (inReach.length && r < .55 + L * .3) {\n      const m = inReach[Math.floor(R() * inReach.length)]; out.press = m.btn; if (m.when === 'crouch') out.y = 1;\n      this._plan = { t: .05, out: { y: out.y } }; return out;\n    }\n    if (r < .12 + L * .05 && dist < 160 && dist > 50) { out.y = -1; out.x = toward; this._walk = 0; return out; }   // a jump in\n    this._walk = dist > 70 ? toward : dist < 40 ? -toward : (R() < .5 ? toward : 0); out.x = this._walk; return out;\n  }\n}\nE.FightAI = FightAI;\n\nconst CALL = ['#fff6d0', '#ffd060', '#e8782a'];\nclass Match {\n  /** new E.Match(game, { fighters: [a, b], ai: [null, null] (E.FightAI each, or null for its input), inputs: [game.\n   *  input, null], rounds: 2 (wins needed), time: 99, x0: 0, x1: 520, span: 250 (how far apart they may be), camera:\n   *  true (the game's camera follows them), training: false | { dummy }, onEnd: winner => {} }) */\n  constructor(game, o = {}) {\n    /** game: the game it runs in; o: its options, with the defaults filled in */\n    this.game = game; this.o = Object.assign({ rounds: 2, time: 99, x0: 0, x1: 520, span: 250, camera: true, training: false }, o);\n    /** f: the two fighters; ai: each one's CPU (E.FightAI), or null; inputs: each one's E.Input when no CPU plays it */\n    this.f = o.fighters; this.ai = o.ai || [null, null]; this.inputs = o.inputs || [game.input, game.players ? game.players[1] || null : null];\n    /** stage: the floor and walls they stand in (E.FightStage) */\n    this.stage = o.stage || new FightStage(this.o.x0, this.o.x1);\n    this.f[0].foe = this.f[1]; this.f[1].foe = this.f[0]; for (const f of this.f) f._level = this.stage;\n    /** wins: the rounds each has won; round: the round's number; winner: 0 or 1 once known (a round's, then the match's), or\n     *  null */\n    this.wins = [0, 0]; this.round = 0; this.winner = null; this.startRound();\n  }\n  /** the stage's middle */\n  get x() { return (this.f[0].x + this.f[1].x) / 2; }\n  /** the next round: both back at the middle, full life */\n  startRound() {\n    const mid = (this.o.x0 + this.o.x1) / 2; this.round++;\n    this.f[0].reset(mid - 60, 1); this.f[1].reset(mid + 60, -1);\n    /** phase: 'intro' | 'fight' | 'ko' | 'win' | 'over'; clock: the round's seconds left; call: the words on the screen\n     *  (ROUND 1, FIGHT!, K.O., TIME, PERFECT), or null */\n    this.phase = this.o.training ? 'fight' : 'intro'; this._t = 0; this.clock = this.o.time; this.winner = null; this.call = this.o.training ? null : 'ROUND ' + this.round; this._slow = 0;\n  }\n  _control(i) {\n    if (this.phase !== 'fight') return null;\n    const ai = this.ai[i]; if (ai) return ai.intent(this.f[i], this.f[1 - i], this._dt);\n    if (this.o.training && i === 1) {   // the dummy\n      const d = this.o.training.dummy || 'stand', f = this.f[1], foe = this.f[0], back = -Math.sign(foe.x - f.x);\n      if (d === 'crouch') return { y: 1 }; if (d === 'jump') return { y: f.body.onGround ? -1 : 0 };\n      if (d === 'guard') return { x: back, y: foe.act && foe.act.m.guard === 'low' ? 1 : 0 };\n      return {};\n    }\n    return this.inputs[i];\n  }\n  /** one step: the fighters, their exchange, the clock, the calls and the rounds */\n  update(dt) {\n    const [a, b] = this.f; this._t += dt; this._dt = dt;\n    a.update(dt, this._control(0)); b.update(dt, this._control(1)); Fighter.exchange(a, b);\n    const span = this.o.span, d = b.x - a.x;   // never farther apart than the screen\n    if (Math.abs(d) > span) { const fix = (Math.abs(d) - span) * Math.sign(d) / 2; a.body.x += fix; b.body.x -= fix; }\n    if (this.o.camera) this.game.focus(this.x, 0, 52);\n    if (this.o.training) {   // no KO; life back once a combo ends\n      for (const f of this.f) if (f.life <= 0) { f.life = 1; f.ko = false; }\n      for (const f of this.f) if (f.combo === 0 && f.stun <= 0 && f.down <= 0 && !f.air) { f.life = Math.min(f.o.life, f.life + f.o.life * dt); if (f.ko) f.ko = false; }\n      for (const f of this.f) f.meter = 100 * (f.o.bars || 1);\n      return;\n    }\n    if (this.phase === 'intro') { if (this._t > 1.1) this.call = 'FIGHT!'; if (this._t > 1.8) { this.phase = 'fight'; this.call = null; this._t = 0; } }\n    else if (this.phase === 'fight') {\n      this.clock = Math.max(0, this.clock - dt);\n      if (a.ko || b.ko || this.clock <= 0) {\n        this.phase = 'ko'; this._t = 0; this.call = a.ko || b.ko ? 'K.O.' : 'TIME';\n        this.winner = a.ko && b.ko ? null : a.ko ? 1 : b.ko ? 0 : a.life === b.life ? null : a.life > b.life ? 0 : 1;\n        if (a.ko || b.ko) { this.game.timeScale = .35; this._slow = .9; this.game.flash('#ffffff', .2); this.game.audio.sfx('boom'); }\n      }\n    } else if (this.phase === 'ko') {\n      if (this._slow > 0 && (this._slow -= dt / Math.max(.01, this.game.timeScale)) <= 0) this.game.timeScale = 1;\n      if (this._t > 2.2 && [a, b].every(f => f.body.onGround && !f.thrown)) {\n        this.phase = 'win'; this._t = 0;\n        if (this.winner === null) { this.wins[0]++; this.wins[1]++; this.call = 'DRAW'; }\n        else { const w = this.f[this.winner]; this.wins[this.winner]++; w.win = true; this.call = w.life >= w.o.life ? 'PERFECT' : w.name + ' WINS'; this.game.audio.sfx('powerup'); }\n      }\n    } else if (this.phase === 'win' && this._t > 2.6) {\n      const done = this.wins.map(n => n >= this.o.rounds);\n      if (done[0] !== done[1]) { this.phase = 'over'; this.winner = done[0] ? 0 : 1; this.call = this.f[this.winner].name + ' WINS'; if (this.o.onEnd) this.o.onEnd(this.winner); }\n      else this.startRound();\n    }\n  }\n  /** draw the fighters, their shots and the HUD; in training the boxes, the frame data and player 1's inputs */\n  draw(r) {\n    const [a, b] = this.f; a.draw(r); b.draw(r);\n    if (this.o.training) { a.drawBoxes(r); b.drawBoxes(r); }\n    r.overlay(g => this._hud(g, r.W, r.H));\n  }\n  _hud(g, W, H) {   // (below a phone's corner button when it sits on top)\n    const font = E.font, bw = Math.floor(W / 2) - 34, ca = this.game.input.lastDevice === 'touch' && this.game.cornerArea ? this.game.cornerArea() : null, y = ca && ca.y0 < 40 ? Math.ceil(ca.y1) + 6 : 10;\n    this.f.forEach((f, i) => {\n      const x = i ? W - 12 - bw : 12, k = f.life / f.o.life, lag = f._lag, flip = i === 1;\n      px.rect(g, x - 1, y - 1, bw + 2, 10, '#140b12'); px.rect(g, x, y, bw, 8, '#3a1a26');\n      const fill = (u, c) => { const w = Math.round(bw * clamp(u, 0, 1)); if (w > 0) px.rect(g, flip ? x : x + bw - w, y, w, 8, c); };\n      fill(lag, '#e0463c'); fill(k, k < .25 ? '#ff9a2a' : '#ffd23a'); px.rect(g, x, y, bw, 1, '#fff6c0');\n      font.text(g, f.name, flip ? x + bw : x, y + 12, '#ffffff', { align: flip ? 'right' : 'left', shadow: '#000', outline: false });\n      for (let w = 0; w < this.o.rounds; w++) { const sx = flip ? x + w * 9 : x + bw - 7 - w * 9; px.disc(g, sx + 3, y + 16, 3, w < this.wins[i] ? '#ffd23a' : '#3a2a4a'); }\n      const mb = Math.round(bw * .6), mx = flip ? W - 12 - mb : 12, my = H - 12, mk = f.meter / 100, full = mk >= 1;\n      E.ui.bar(g, mx, my, mb, 6, mk % 1 || (full ? 1 : 0), full && Math.floor(this.game.real * 6) % 2 ? '#a0f0ff' : '#3a8aff');\n      if (f.combo > 1 && f.stun > 0) font.title(g, f.combo + ' HITS', flip ? 14 : W - 14, y + 44, { scale: 2, align: flip ? 'left' : 'right', colors: CALL });\n    });\n    if (!this.o.training) { const box = Math.round(W / 2); E.ui.box(g, box - 15, y - 6, 30, 22, { bg: ['#2a1a4a', '#120a28'] }); font.title(g, String(Math.ceil(this.clock)).padStart(2, '0'), box, y - 3, { scale: 2, align: 'center', colors: ['#ffffff', '#c8d8ff'] }); }\n    if (this.call) font.title(g, this.call, W / 2, H / 2 - 30, { scale: 4, align: 'center', colors: CALL, depth: 3 });\n    if (this.o.training) {   // frame data and player 1's last second of inputs\n      const L = this.f[0].last; if (L) font.text(g, L.id.toUpperCase() + '  STARTUP ' + L.startup + '  ACTIVE ' + L.active + '  RECOVERY ' + L.recovery + (L.adv === null ? '  KNOCKDOWN' : '  ON ' + L.on.toUpperCase() + ' ' + (L.adv > 0 ? '+' : '') + L.adv), 12, y + 24, '#c8f0ff', { shadow: '#000', outline: false, font: 'tiny' });\n      const I = this.inputs[0], hist = I && I.history ? I.history.slice(-12) : [], mir = { 1: 3, 3: 1, 4: 6, 6: 4, 7: 9, 9: 7 };   // (numpad digits, as the fighter faces)\n      hist.forEach((h, k) => font.text(g, (this.f[0].facing < 0 ? mir[h.dir] || h.dir : h.dir) + ' ' + h.pressed.filter(p => BTN.includes(p)).join('+').toUpperCase(), 12, y + 36 + k * 8, '#ffffff', { shadow: '#000', outline: false, font: 'tiny' }));\n    }\n  }\n}\nE.Match = Match;\n\nclass FightSelect {\n  /** new E.FightSelect(game, { roster: [{ id, name, rig, about }], inputs: [p1, p2 or null], cpu: [false, true],\n   *  seed, onDone: ids => {} }): a character select. picks: each side's id once chosen; at: each side's cursor */\n  constructor(game, o = {}) {\n    /** game: the game it runs in; o: its options; roster: the fighters to pick from; inputs: each side's E.Input; cpu: which\n     *  sides the CPU picks for */\n    this.game = game; this.o = o; this.roster = o.roster || []; this.inputs = o.inputs || [game.input, null]; this.cpu = o.cpu || [false, true];\n    /** at: each side's cursor; picks: each side's id once chosen; rects: where each portrait was drawn ([x, y, w, h] in\n     *  screen pixels: a tap there picks it) */\n    this.at = [0, Math.min(1, this.roster.length - 1)]; this.picks = [null, null]; this.rects = null; this._t = 0; this._cpuT = [0, 0]; this._rng = E.rng(o.seed || 7);\n    /** rigs: each fighter's portrait rig */\n    this.rigs = this.roster.map(e => { const r = new E.Humanoid(Object.assign({ size: 1, weapon: null }, e.rig, { size: 1 })); r.update(0, { x: 0, y: 0, z: 0, stance: 'guard' }); return r; });\n  }\n  /** move the cursors, take the picks; onDone(ids) once both have one */\n  update(dt) {\n    this._t += dt; const n = this.roster.length;\n    for (let i = 0; i < 2; i++) {\n      if (this.picks[i]) continue;\n      if (this.cpu[i]) { if ((this._cpuT[i] += dt) > .8 && this.picks[0]) this.picks[i] = this.roster[this.at[i] = Math.floor(this._rng() * n)].id; continue; }\n      const I = this.inputs[i]; if (!I) continue;\n      const tap = i === 0 && this.rects && I.clicked ? I.clicked() : null, k = tap ? this.rects.findIndex(([x, y, w, h]) => tap[0] >= x && tap[0] < x + w && tap[1] >= y && tap[1] < y + h) : -1;\n      if (k >= 0) { this.at[0] = k; this.picks[0] = this.roster[k].id; this.game.audio.sfx('confirm'); continue; }   // a tap on a portrait picks it\n      if (I.repeat('left')) { this.at[i] = (this.at[i] + n - 1) % n; this.game.audio.sfx('select'); }\n      if (I.repeat('right')) { this.at[i] = (this.at[i] + 1) % n; this.game.audio.sfx('select'); }\n      if (BTN.some(k => I.map[k] && I.pressed(k)) || I.pressed('confirm') || I.pressed('start')) { this.picks[i] = this.roster[this.at[i]].id; this.game.audio.sfx('confirm'); I.consumeAll(); }\n    }\n    if (this.picks[0] && this.picks[1] && !this._done) { this._done = this._t + .7; }\n    if (this._done && this._t >= this._done && this.o.onDone) { this.o.onDone(this.picks.slice()); this.o.onDone = null; }\n  }\n  /** draw the roster, the cursors and each side's fighter large */\n  draw(r) {\n    r.overlay(g => {\n      const W = r.W, H = r.H, n = this.roster.length, s = Math.min(46, Math.floor((W - 40) / n) - 6), x0 = Math.round(W / 2 - (n * (s + 6) - 6) / 2), y = H - s - 34;\n      E.font.title(g, 'SELECT YOUR FIGHTER', W / 2, 10, { scale: 2, align: 'center', colors: CALL });\n      for (let i = 0; i < 2; i++) {\n        const e = this.roster[this.at[i]], big = Math.min(96, Math.round(H * .42)), bx = i ? W - 16 - big : 16;\n        this.rigs[this.at[i]].drawPortrait(g, bx, 36, big, { zoom: 2.4, turn: i ? -.6 : .6, bg: i ? ['#ff8a6a', '#5a1a2a'] : ['#6ab0ff', '#1a2a5a'], border: E.PLAYER_COLORS[i] });\n        E.font.text(g, e.name, bx + big / 2, 40 + big, '#ffffff', { align: 'center', shadow: '#000', outline: false });\n        if (e.about) E.font.text(g, e.about, bx + big / 2, 50 + big, '#c8b8e8', { align: 'center', outline: false, font: 'tiny' });\n        if (this.picks[i]) E.font.text(g, 'READY', bx + big / 2, 30, E.PLAYER_COLORS[i], { align: 'center', shadow: '#000', outline: false });\n      }\n      E.font.title(g, 'VS', W / 2, 70, { scale: 3, align: 'center', colors: ['#ffffff', '#ff8a6a', '#c0302a'] });\n      this.rects = this.roster.map((e, k) => [x0 + k * (s + 6), y, s, s]);   // (where a tap picks)\n      this.roster.forEach((e, k) => {\n        const x = x0 + k * (s + 6); this.rigs[k].drawPortrait(g, x, y, s, { zoom: 2, turn: .5 });\n        for (let i = 0; i < 2; i++) if (this.at[i] === k && (!this.cpu[i] || this.picks[0])) { const c = E.PLAYER_COLORS[i], o = i * 2; px.rect(g, x - 2 - o, y - 2 - o, s + 4 + o * 2, 2, c); px.rect(g, x - 2 - o, y + s + o, s + 4 + o * 2, 2, c); px.rect(g, x - 2 - o, y - 2 - o, 2, s + 4 + o * 2, c); px.rect(g, x + s + o, y - 2 - o, 2, s + 4 + o * 2, c); E.font.text(g, this.cpu[i] ? 'CPU' : 'P' + (i + 1), x + s / 2, y + s + 6, c, { align: 'center', outline: false, font: 'tiny' }); }\n      });\n    });\n  }\n}\nE.FightSelect = FightSelect;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);","numLines":196,"startLine":355,"totalLines":551}},"tool_result_meta":[{"id":"toolu_013REF4e1KZ28makBUG96SS2","permission_decision":{"decision"