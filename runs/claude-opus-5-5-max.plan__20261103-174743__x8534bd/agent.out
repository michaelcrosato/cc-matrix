{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015S21HEgJnZ7JtWsXLJ6g6T","type":"tool_result","content":"1\t// The FIGHTING kit's game (one on one: three fighters, versus, arcade, training), readable: the starter's shell (src/starter/00-shell.js), then\n2\t// the slice from line 159 (src/starter/55-fighting.js: its header says what it plays and how), then the start (90-start.js), as the\n3\t// single-file kit holds them between GAME START and GAME END. fighting.html plays it; node kits/test.mjs fighting runs it headless.\n4\t/* ============================== GAME START ==============================\n5\t * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n6\t * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n7\t * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n8\t * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n9\t * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n10\t * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n11\t * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n12\t * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n13\t * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n14\t * ======================================================================== */\n15\t(() => {\n16\t'use strict';\n17\tconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n18\t\n19\t/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n20\t * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\n21\tconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\n22\tconst P = game.particles, L = game.lights, A = game.audio;\n23\tconst scenes = {};\n24\tlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\n25\tconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n26\t// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n27\t// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\n28\tconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n29\t// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\n30\tconst SLICES = [\n31\t  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n32\t  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n33\t  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n34\t  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n35\t  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n36\t  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n37\t  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n38\t  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n39\t  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n40\t  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n41\t  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n42\t  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n43\t  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n44\t  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n45\t  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n46\t  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n47\t  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n48\t  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n49\t  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n50\t  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n51\t  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n52\t  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n53\t];\n54\t/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n55\t   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n56\t   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n57\t   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\n58\tconst camOpt = () => (game.scene && game.scene.camera) || {};\n59\taddEventListener('keydown', e => {\n60\t  if (e.repeat) return;\n61\t  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n62\t  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n63\t  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n64\t  else if (e.code === 'KeyM') A.mute();\n65\t  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n66\t});\n67\t\n68\t/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n69\t * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\n70\tconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n71\t  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\n72\tconst titleBg = new E.Backdrop('castle-night');\n73\tconst HEROES = [   // six heroes, each dressed with the HD rig options\n74\t  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n75\t  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n76\t  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n77\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n78\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n79\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n80\t];\n81\tHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n82\t// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\n83\tconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n84\t// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\n85\tconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n86\t/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n87\t * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n88\t * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n89\t * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n90\t * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\n91\tconst proof = (id, n, script, state, fresh) => {\n92\t  const was = Math.random, I = game.input, held = new Set();\n93\t  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n94\t  Math.random = E.rng(7);\n95\t  try {\n96\t    if (fresh) fresh();\n97\t    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n98\t    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n99\t    const s = JSON.stringify(state()); let h = 2166136261;\n100\t    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n101\t    return h >>> 0;\n102\t  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n103\t};\n104\t// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\n105\tconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n106\t// START picks too (the touch START, a pad's Start), as Enter does: any player's\n107\tconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n108\t/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n109\t *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\n110\tconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\n111\tlet titleMenu = null;   // (made at the start, once the file's slices are known)\n112\tscenes.title = {\n113\t  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n114\t  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n115\t  update(dt) {\n116\t    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n117\t    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n118\t    const t = game.time;\n119\t    HEROES.forEach((h, i) => {\n120\t      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n121\t      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n122\t    });\n123\t  },\n124\t  draw(r) {\n125\t    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n126\t    titleMenu.y = 76 + top;\n127\t    titleBg.draw(r);\n128\t    stage.draw(r);\n129\t    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n130\t    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n131\t    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n132\t    r.overlay(g => {\n133\t      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n134\t      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n135\t      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n136\t    });\n137\t    titleMenu.draw(r);\n138\t    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n139\t      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n140\t    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n141\t  }\n142\t};\n143\t\n144\t/* ---- GAME OVER: shared by every slice ---- */\n145\tconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\n146\tconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n147\t  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\n148\tscenes.over = {\n149\t  view: 'side', input: 'DEFAULT', res: 'ps1',\n150\t  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n151\t  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n152\t  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n153\t  draw(r) {   // centred on any screen\n154\t    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n155\t    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n156\t  }\n157\t};\n158\t\n159\t/* =====================================================================================\n160\t * SLICE 11  FIGHTING  (Street Fighter II, Darkstalkers, Samurai Shodown). @modules fight\n161\t * One on one in the side view, best of three rounds, on a temple courtyard at dusk with a crowd that cheers the blows.\n162\t *   RYO, the all-rounder: a fireball (236 + a punch), a rising uppercut (623 + HP), a spinning kick (214 + HK); his\n163\t *     super, a great fireball (236236 + HP), once his meter is full.\n164\t *   GORM, the grappler: big, slow and hard to move: a spinning slam (41236 + HP, close: it can't be blocked), a shoulder\n165\t *     charge (hold back, then forward + HP), a lariat (623 + LP), an overhead axe kick (HK); his super slam 41236 + HK.\n166\t *   VEX, the fast one: quick strikes, a teleport behind her foe (214 + LK), a rising flip kick (623 + LK), a dashing\n167\t *     elbow (236 + LP); her super, a whirlwind of kicks (236236 + HK).\n168\t * The numbers are a number pad for a fighter facing right (2 down, 6 forward, 4 back; 236 is a quarter circle forward):\n169\t * they mirror when it faces left. Hold back to block (down-back for low moves; jump attacks must be blocked standing);\n170\t * forward or back + HP close to a foe throws it.\n171\t * MODES: VERSUS (a second player joins with 2 on the keyboard or Start on a pad), ARCADE (the other two, then your own\n172\t * shadow, each CPU stronger), TRAINING (the boxes drawn, frame data, your inputs; Tab or a pad's Back changes the dummy:\n173\t * stand, crouch, jump, guard). Deep links: #fighting/versus, #fighting/arcade, #fighting/training.\n174\t * KEYS: arrows / WASD move, jump (up) and crouch (down); U, I punch and J, K kick (light, heavy); a pad's X, Y, A, B.\n175\t * Two on one keyboard: each takes half, and the menus say whose keys are which. TOUCH: the stick (motions work on it)\n176\t * and four buttons.\n177\t * HOW IT WORKS: E.Fighter, E.Match, E.FightAI and E.FightSelect (the fight module) hold the rules; this file is the\n178\t * roster with each fighter's moves, the stage and the menus.\n179\t * ===================================================================================== */\n180\tconst FIGHT = (() => {\n181\t  const A = game.audio, X0 = 0, X1 = 560, KEYS = Object.assign({}, E.FIGHT_KEYS, { dummy: ['Tab', 'Pad8'] });\n182\t  const M = E.MOVES, spin = (name, o) => Object.assign({}, M[name], { spin: true }, o);   // (a move turned into a spin)\n183\t\n184\t  /* ---- THE ROSTER: each a rig and a move list (frame data in frames at 60: [startup, active, recovery]) ---- */\n185\t  const ROSTER = [\n186\t    { id: 'ryo', name: 'RYO', about: 'ALL-ROUNDER', o: { walk: 78, back: 62 }, alt: { cloth: '#2a2a34', pants: '#2a2a34', glove: '#3a6ac8' },\n187\t      rig: { size: 2.35, build: 'heroic', hair: 'short', sleeves: 'short', hat: { style: 'band', color: '#e0302a' }, colors: { skin: '#e8b088', hair: '#2a1a18', cloth: '#f2eee4', pants: '#f2eee4', boot: '#e8b088', belt: '#1a1a22', glove: '#c83a2a' } },\n188\t      moves: {\n189\t        jab: { move: 'jab', btn: 'lp', f: [3, 3, 7], dmg: 30, cancel: true }, cjab: { move: 'jab', btn: 'lp', when: 'crouch', f: [3, 3, 7], dmg: 25, cancel: true }, ajab: { move: 'jab', btn: 'lp', when: 'air', guard: 'overhead', dmg: 35 },\n190\t        cross: { move: 'cross', btn: 'hp', f: [5, 4, 16], dmg: 80, cancel: true }, cup: { move: 'uppercut', btn: 'hp', when: 'crouch', f: [5, 6, 18], dmg: 85 }, ahook: { move: 'hook', btn: 'hp', when: 'air', guard: 'overhead', dmg: 85 },\n191\t        kick: { move: 'kick', btn: 'lk', f: [4, 3, 9], dmg: 35, cancel: true }, ckick: { move: 'kick', btn: 'lk', when: 'crouch', guard: 'low', f: [4, 3, 9], dmg: 30, cancel: true }, akick: { move: 'flyingkick', btn: 'lk', when: 'air', guard: 'overhead', dmg: 50 },\n192\t        round: { move: 'roundhouse', btn: 'hk', f: [7, 5, 18], dmg: 95 }, sweep: { move: 'sweep', btn: 'hk', when: 'crouch', guard: 'low', down: true, f: [6, 5, 20], dmg: 90 }, afly: { move: 'flyingkick', btn: 'hk', when: 'air', guard: 'overhead', dmg: 95 },\n193\t        fire: { move: 'cast', btn: 'lp', motion: '236', f: [12, 2, 30], shot: { speed: 150, r: 7, dmg: 70, color: '#58b8ff' } },\n194\t        fire2: { move: 'cast', btn: 'hp', motion: '236', f: [12, 2, 30], shot: { speed: 220, r: 7, dmg: 80, color: '#58b8ff' } },\n195\t        rise: { move: 'uppercut', btn: 'hp', motion: '623', f: [3, 12, 26], inv: 8, vz: 360, vx: 40, launch: 340, dmg: 120, aa: true },\n196\t        whirl: { move: spin('roundhouse', { active: .4 }), btn: 'hk', motion: '214', f: [8, 24, 14], vx: 130, vz: 170, dmg: 90, down: true },\n197\t        super: { move: 'cast', btn: 'hp', motion: '236236', meter: 100, f: [8, 3, 30], inv: 10, shot: { speed: 200, r: 13, dmg: 260, color: '#ff7a3a', core: '#fff0c0' } } } },\n198\t    { id: 'gorm', name: 'GORM', about: 'GRAPPLER', alt: { pants: '#2a5ac8', belt: '#e0e0e8', glove: '#e0e0e8' }, o: { walk: 56, back: 46, life: 1150, throwDmg: 150, jump: 360, jumpX: 70 },\n199\t      rig: { size: 2.65, build: 'bulky', hair: 'bald', sleeves: 'none', stubble: '#4a2a1a', hunch: .2, colors: { skin: '#c88a5a', hair: '#2a1a10', cloth: '#c88a5a', pants: '#b82a2a', boot: '#3a2a20', belt: '#ffd040', glove: '#3a2a20' } },\n200\t      moves: {\n201\t        jab: { move: 'jab', btn: 'lp', f: [4, 3, 9], dmg: 40, cancel: true }, cjab: { move: 'elbow', btn: 'lp', when: 'crouch', f: [4, 3, 10], dmg: 40, cancel: true }, abash: { move: 'bash', btn: 'lp', when: 'air', guard: 'overhead', dmg: 50 },\n202\t        chop: { move: 'haymaker', btn: 'hp', f: [10, 4, 22], dmg: 120 }, butt: { move: 'bash', btn: 'hp', when: 'close', f: [6, 4, 18], dmg: 100, cancel: true }, cup: { move: 'uppercut', btn: 'hp', when: 'crouch', f: [7, 5, 22], dmg: 100 },\n203\t        ahay: { move: 'haymaker', btn: 'hp', when: 'air', guard: 'overhead', dmg: 110 },\n204\t        kick: { move: 'kick', btn: 'lk', f: [6, 3, 12], dmg: 45 }, ckick: { move: 'kick', btn: 'lk', when: 'crouch', guard: 'low', f: [6, 3, 12], dmg: 40 }, aknee: { move: 'knee', btn: 'lk', when: 'air', guard: 'overhead', dmg: 70 },\n205\t        axe: { move: 'axekick', btn: 'hk', f: [16, 4, 18], guard: 'overhead', dmg: 110 }, sweep: { move: 'sweep', btn: 'hk', when: 'crouch', guard: 'low', down: true, f: [8, 5, 24], dmg: 100 }, astomp: { move: 'axekick', btn: 'hk', when: 'air', guard: 'overhead', dmg: 110 },\n206\t        slam: { move: 'throw', btn: 'hp', motion: '41236', throw: true, range: 40, f: [4, 3, 34], dmg: 230 },\n207\t        rush: { move: 'bash', btn: 'hp', charge: '46', f: [8, 14, 20], vx: 220, dmg: 110, down: true },\n208\t        lariat: { move: spin('hook', { active: .4 }), btn: 'lp', motion: '623', f: [5, 22, 18], inv: 5, vx: 60, r: 7, dmg: 100, down: true, aa: true },\n209\t        super: { move: 'throw', btn: 'hk', motion: '41236', meter: 100, throw: true, range: 48, f: [2, 4, 34], dmg: 400 } } },\n210\t    { id: 'vex', name: 'VEX', about: 'FAST, TELEPORTS', alt: { cloth: '#8a2a3a', hair: '#e0c060', trim: '#e8e8f0' }, o: { walk: 96, back: 80, life: 900, jump: 410, jumpX: 105 },\n211\t      rig: { size: 2.2, build: 'heroic', hair: 'ponytail', sleeves: 'long', outfit: 'tunic', hood: true, colors: { skin: '#f0c8a0', hair: '#4a2a7a', cloth: '#2a6a6a', pants: '#1a2a3a', boot: '#1a1a2a', belt: '#e0b040', glove: '#1a2a3a', trim: '#e0b040' } },\n212\t      moves: {\n213\t        jab: { move: 'jab', btn: 'lp', f: [2, 2, 6], dmg: 25, cancel: true }, cjab: { move: 'jab', btn: 'lp', when: 'crouch', f: [2, 2, 6], dmg: 22, cancel: true }, ajab: { move: 'elbow', btn: 'lp', when: 'air', guard: 'overhead', dmg: 35 },\n214\t        palm: { move: 'cross', btn: 'hp', f: [4, 3, 13], dmg: 65, cancel: true }, knee: { move: 'knee', btn: 'hp', when: 'close', f: [3, 3, 12], dmg: 60, cancel: true }, cup: { move: 'uppercut', btn: 'hp', when: 'crouch', f: [4, 5, 15], dmg: 70 },\n215\t        ahook: { move: 'hook', btn: 'hp', when: 'air', guard: 'overhead', dmg: 70 },\n216\t        kick: { move: 'kick', btn: 'lk', f: [3, 3, 8], dmg: 30, cancel: true }, ckick: { move: 'kick', btn: 'lk', when: 'crouch', guard: 'low', f: [3, 3, 8], dmg: 28, cancel: true }, akick: { move: 'flyingkick', btn: 'lk', when: 'air', guard: 'overhead', dmg: 45 },\n217\t        round: { move: 'roundhouse', btn: 'hk', f: [5, 5, 15], dmg: 80 }, slide: { move: 'sweep', btn: 'hk', when: 'crouch', guard: 'low', down: true, f: [5, 8, 18], vx: 150, dmg: 75 }, afly: { move: 'flyingkick', btn: 'hk', when: 'air', guard: 'overhead', dmg: 80 },\n218\t        port: { move: 'cast', btn: 'lk', motion: '214', f: [10, 1, 12], teleport: 36, inv: 12 },\n219\t        flip: { move: 'flyingkick', btn: 'lk', motion: '623', f: [3, 12, 22], inv: 6, vz: 340, vx: 70, launch: 320, dmg: 100, aa: true },\n220\t        dash: { move: 'elbow', btn: 'lp', motion: '236', f: [6, 10, 16], vx: 260, dmg: 70 },\n221\t        super: { move: spin('roundhouse', { active: .5 }), btn: 'hk', motion: '236236', meter: 100, f: [4, 30, 20], inv: 10, vx: 170, vz: 220, dmg: 260, down: true } } }];\n222\t  const byId = id => ROSTER.find(e => e.id === id);\n223\t  // a fighter of the roster; alt: its second palette (a mirror match's player 2); shadow: the arcade's last foe, the\n224\t  // fighter's own moves in a dark palette\n225\t  const make = (id, x, side, shadow, alt) => {\n226\t    const e = byId(id), rig = Object.assign({}, e.rig, { weapon: null, speedRef: 40, colors: Object.assign({}, e.rig.colors, alt ? e.alt : {}, shadow ? { cloth: '#2a2a3a', pants: '#1a1a24', hair: '#0a0a12', glove: '#6a2a8a', skin: '#8a7a9a', eye: '#ff4a4a' } : {}) });\n227\t    return new E.Fighter(game, Object.assign({ name: shadow ? 'SHADOW ' + e.name : e.name, x, side, rig, moves: e.moves }, e.o));\n228\t  };\n229\t\n230\t  /* ---- THE STAGE: a temple courtyard at dusk; a crowd behind the rope that cheers the blows ---- */\n231\t  const bg = new E.Backdrop({ sky: ['#1a1440', '#5a3070', '#d86a5a', '#f8b878'], sun: { x: .7, y: .58, r: 18, color: '#ffd8a0' },\n232\t    layers: [{ kind: 'mountains', color: '#4a2e5e', y: .5, height: .26, parallax: .05 }, { kind: 'castle', color: '#2e1c3c', y: .6, height: .34, parallax: .12, windows: '#ffb85a' }, { kind: 'forest', color: '#1e1428', y: .7, height: .14, parallax: .25 }] });\n233\t  const CROWD = Array.from({ length: 70 }, (_, i) => ({ x: X0 - 60 + i * ((X1 - X0 + 120) / 70) + E.hash2(i, 3) * 6, row: i % 3, h: 18 + E.hash2(i, 5) * 8, c: ['#5a3a6a', '#3a4a7a', '#7a3a3a', '#4a6a4a', '#7a5a3a', '#3a3a4a'][Math.floor(E.hash2(i, 7) * 6)], ph: E.hash2(i, 9) * 6 }));\n234\t  let cheer = 0;\n235\t  function stage(r) {\n236\t    const g = r.ctx, v = r.view; bg.draw(r);\n237\t    const W = r.bw, floor = Math.round(r.w(0, 0, 0)[1]), sx = x => r.w(x, 0, 0)[0];\n238\t    // the far wall and its lanterns, then the crowd behind the rope (parallax: the back rows move slower)\n239\t    px.rect(g, 0, floor - 70, W, 70, '#2a1a2a'); px.rect(g, 0, floor - 72, W, 2, '#5a3a4a');\n240\t    for (let k = 0; k < 9; k++) { const lx = Math.round(sx(X0 + k * 70) * .9 + W * .05), ly = floor - 66, glow = .6 + .4 * Math.sin(game.time * 3 + k); px.blend(g, .3 * glow, 'add', () => px.disc(g, lx, ly + 8, 14, '#ff9a4a')); px.rect(g, lx - 4, ly, 8, 12, '#e04a3a'); px.rect(g, lx - 4, ly + 5, 8, 1, '#ffd060'); }\n241\t    for (const p of CROWD) {\n242\t      const par = [.7, .82, .94][p.row], x = Math.round((sx(p.x) - W / 2) * par + W / 2), bob = Math.abs(Math.sin(game.time * (3 + cheer * 6) + p.ph)) * (1 + cheer * 4), y = floor - 18 - p.row * 9 - p.h + 18 - bob;\n243\t      const c = E.shade(p.c, -.1 * (2 - p.row)); px.rect(g, x - 5, y + 6, 10, p.h, c); px.disc(g, x, y + 3, 4, E.shade(c, .15));\n244\t      if (cheer > .3 && E.hash2(Math.floor(p.ph * 10), 1) > .5) { px.rect(g, x - 7, y - 4 - bob, 2, 8, c); px.rect(g, x + 5, y - 4 - bob, 2, 8, c); }   // arms up\n245\t    }\n246\t    px.rect(g, 0, floor - 12, W, 2, '#c8a060');   // the rope\n247\t    // the floor: planks to the horizon, lit in the middle\n248\t    for (let y = floor; y < r.bh; y++) { const k = (y - floor) / Math.max(1, r.bh - floor); px.rect(g, 0, y, W, 1, E.mix('#6a4a3a', '#3a2620', k)); }\n249\t    for (let k = -12; k <= 12; k++) { const x0 = sx(X0 + (X1 - X0) / 2 + k * 40); px.line(g, Math.round(x0), floor, Math.round(W / 2 + (x0 - W / 2) * 1.8), r.bh, '#4a3028'); }\n250\t    px.blend(g, .18, 'add', () => px.ell(g, W / 2, floor + 14, W * .45, 10, '#ffb878'));\n251\t  }\n252\t\n253\t  /* ---- MODES: the menu, the select, the match, the results ---- */\n254\t  let mode = 'menu', match = null, select = null, kind = 'versus', picks = null, ladder = [], step = 0, dummy = 0, result = null, t = 0;\n255\t  const DUMMY = ['stand', 'crouch', 'jump', 'guard'];\n256\t  const menu = new E.Menu(game, ['VERSUS', 'ARCADE', 'TRAINING'], { y: 0, onPick: i => choose(['versus', 'arcade', 'training'][i]) });\n257\t  const after = new E.Menu(game, ['REMATCH', 'CHARACTER SELECT', 'TITLE'], { y: 0, onPick: i => i === 0 ? fight(picks) : i === 1 ? choose(kind) : game.go('title') });\n258\t  const cont = new E.Menu(game, ['CONTINUE', 'TITLE'], { y: 0, onPick: i => i ? game.go('title') : fight(picks) });\n259\t  const p2 = () => game.players[1] || null;\n260\t  function choose(k) {\n261\t    kind = k; mode = 'select'; t = 0;\n262\t    select = new E.FightSelect(game, { roster: ROSTER, inputs: [game.input, k === 'versus' ? p2() : null], cpu: [false, k !== 'versus'], seed: 1 + Math.floor(Math.random() * 1e6),\n263\t      onDone: ids => { if (k === 'arcade') { ladder = ROSTER.filter(e => e.id !== ids[0]).map(e => e.id).concat([ids[0]]); step = 0; picks = [ids[0], ladder[0]]; } else picks = ids; fight(picks); } });\n264\t  }\n265\t  function fight(ids) {\n266\t    const a = make(ids[0], 0, 1), shadow = kind === 'arcade' && step === ladder.length - 1, b = make(ids[1], 0, -1, shadow, ids[0] === ids[1] && !shadow), cpu = kind === 'arcade';\n267\t    const s = game.view.p(1, 0, 0)[0] - game.view.p(0, 0, 0)[0], span = Math.max(160, game.W / s - 36);\n268\t    match = new E.Match(game, { fighters: [a, b], ai: [null, cpu ? new E.FightAI({ level: 3 + step * 2, seed: 1 + Math.floor(Math.random() * 1e6) }) : null], inputs: [game.input, p2()], x0: X0, x1: X1, span,\n269\t      training: kind === 'training' ? { dummy: DUMMY[dummy] } : false, onEnd: w => end(w) });\n270\t    mode = 'fight'; result = null; t = 0; A.music(SONG); game.input.consumeAll();\n271\t  }\n272\t  function end(w) {\n273\t    result = { w, t: 0 }; t = 0; A.music(null);\n274\t    if (kind === 'arcade') { if (w === 0) { step++; result.next = step < ladder.length; } else cont.i = 0; } else after.i = 0;\n275\t  }\n276\t  // a fighting song: a driving bass under a modal lead (the step sequencer's format)\n277\t  const SONG = { bpm: 150, steps: 4, tracks: [\n278\t    { wave: 'pulse12', vol: .1, notes: 'A4 - C5 D5 E5 - D5 C5 | D5 - G4 - C5 B4 A4 G4 | F4 - A4 C5 D5 - E5 - | G5 F5 E5 D5 E5 - - -' },\n279\t    { wave: 'triangle', vol: .3, notes: 'A2 . A2 A3 A2 . A2 G2 | G2 . G2 G3 G2 . G2 E2 | F2 . F2 F3 F2 . F2 G2 | G2 . G2 B2 D3 . E3 .' },\n280\t    { wave: 'drums', vol: .1, notes: 'k . h . s . h k k . h . s . h h' }] };\n281\t\n282\t  function update(dt) {\n283\t    t += dt; cheer = Math.max(0, cheer - dt * .8);\n284\t    for (const k of ['lp', 'hp', 'lk', 'hk']) game.input.touchSet(k, null, mode === 'fight' && !(result && result.t > 1.2));   // (the fight's buttons only in a fight: taps pick on the menus)\n285\t    if (mode === 'menu') { if (!menu.update(dt)) pickOnStart(menu); return; }\n286\t    if (mode === 'select') {\n287\t      if (kind === 'versus' && !select.inputs[1] && p2()) select.inputs[1] = p2();   // player 2 joined: its cursor comes alive\n288\t      select.update(dt); return;\n289\t    }\n290\t    if (!match) return;\n291\t    const lifeWas = match.f.map(f => f.life);\n292\t    match.update(dt);\n293\t    match.f.forEach((f, i) => { if (f.life < lifeWas[i]) cheer = Math.min(1, cheer + (lifeWas[i] - f.life) / 150); });\n294\t    if (kind === 'training' && game.input.pressed('dummy')) { dummy = (dummy + 1) % DUMMY.length; match.o.training.dummy = DUMMY[dummy]; A.sfx('select'); }\n295\t    if (result) {\n296\t      result.t += dt; if (result.t < 1.2) return;\n297\t      match.call = null;   // (the menu's own title instead)\n298\t      if (kind === 'arcade') { if (result.w === 0) { if (result.next) { picks = [picks[0], ladder[step]]; fight(picks); } else if (result.t > 5 || game.input.pressed('start')) game.go('title'); } else if (!cont.update(dt)) pickOnStart(cont); }\n299\t      else if (!after.update(dt)) pickOnStart(after);\n300\t    }\n301\t  }\n302\t  function draw(r) {\n303\t    stage(r);\n304\t    if (match && (mode === 'fight')) match.draw(r);\n305\t    r.overlay(g => {\n306\t      const W = r.W, H = r.H;\n307\t      if (mode === 'menu') {\n308\t        px.blend(g, .55, 'normal', () => px.rect(g, 0, 0, W, H, '#0a0614'));\n309\t        E.font.title(g, 'FIGHTING', W / 2, 30, { scale: 4, align: 'center', colors: ['#fff6d0', '#ff9a4a', '#c0302a'], depth: 3 });\n310\t        const two = game.players.length > 1, line = menu.i === 0 ? (two ? 'TWO PLAYERS: PICK YOUR FIGHTERS' : 'PLAYER 2: PRESS 2 OR START ON A PAD') : menu.i === 1 ? 'BEAT THE OTHER TWO, THEN YOUR SHADOW' : 'THE BOXES, FRAME DATA AND YOUR INPUTS';\n311\t        E.font.text(g, line, W / 2, H - 34, '#e8d8ff', { align: 'center', shadow: '#000', outline: false });\n312\t        const keys = I => (two ? I.name + ' ' : '') + ['lp', 'hp', 'lk', 'hk'].map(k => I.label(k)).join(' ') + ' PUNCH, KICK';\n313\t        E.font.text(g, two ? game.players.map(keys).join('     ') : 'ARROWS MOVE   ' + keys(game.input) + '   HOLD BACK TO BLOCK', W / 2, H - 22, '#9a8ac8', { align: 'center', outline: false, font: 'tiny' });\n314\t        E.font.text(g, '236 + PUNCH: A FIREBALL (NUMPAD NOTATION, FACING RIGHT)', W / 2, H - 12, '#7a6aa8', { align: 'center', outline: false, font: 'tiny' });\n315\t      }\n316\t      if (mode === 'select' && kind === 'versus' && !select.inputs[1]) E.font.text(g, 'PLAYER 2: PRESS 2 OR START ON A PAD', W / 2, 26, '#ff8a6a', { align: 'center', shadow: '#000', outline: false });\n317\t      if (mode === 'fight' && kind === 'arcade' && match.phase === 'intro') E.font.text(g, 'STAGE ' + (step + 1) + ' OF ' + ladder.length, W / 2, H / 2 + 6, '#ffffff', { align: 'center', shadow: '#000', outline: false });\n318\t      const ta = game.input.touchArea && game.input.touchArea();   // (clear of the touch buttons)\n319\t      if (mode === 'fight' && kind === 'training') E.font.text(g, 'DUMMY: ' + DUMMY[dummy].toUpperCase() + '  (TAB OR BACK CHANGES IT)', W / 2, ta ? Math.round(ta.y0) - 10 : H - 24, '#ffd060', { align: 'center', shadow: '#000', outline: false, font: 'tiny' });\n320\t      if (result && result.t > 1.2) {\n321\t        if (kind === 'arcade' && result.w === 0 && !result.next) { E.font.title(g, 'CHAMPION!', W / 2, H / 2 - 34, { scale: 3, align: 'center', colors: ['#fff6d0', '#ffd060', '#e8782a'] }); }\n322\t        else if (kind === 'arcade' && result.w === 1) { E.font.title(g, 'CONTINUE?', W / 2, H / 2 - 40, { scale: 2, align: 'center', colors: ['#ffffff', '#ff8a6a', '#c0302a'] }); }\n323\t        else if (kind !== 'arcade') E.font.title(g, match.f[result.w].name + ' WINS', W / 2, H / 2 - 44, { scale: 3, align: 'center', colors: ['#fff6d0', '#ffd060', '#e8782a'] });\n324\t      }\n325\t    });\n326\t    if (mode === 'menu') { menu.y = Math.round(r.H / 2) - 10; menu.draw(r); }\n327\t    if (mode === 'select') select.draw(r);\n328\t    if (result && result.t > 1.2 && !(kind === 'arcade' && result.w === 0)) { const m = kind === 'arcade' ? cont : after; m.y = Math.round(r.H / 2) - 12; m.draw(r); }\n329\t  }\n330\t\n331\t  /** the bot (tools/kits-test.mjs): two CPUs fight a match with seed s, twice; who won, the rounds, and whether the second\n332\t   *  match repeated the first exactly (the CPU's randomness is its own) */\n333\t  function bot(s = 1) {\n334\t    const one = () => {\n335\t      const was = Math.random; Math.random = E.rng(s);\n336\t      try {\n337\t        game.go('fighting', null, { fade: 0 }); game.advance(1 / 120); kind = 'versus'; picks = ['ryo', 'gorm'];\n338\t        fight(picks); match.ai = [new E.FightAI({ level: 6, seed: s }), new E.FightAI({ level: 5, seed: s + 1 })];\n339\t        let h = 2166136261, n = 0; for (; n < 260 && match.phase !== 'over'; n++) { game.advance(1); const v = match.f.map(f => Math.round(f.life) + ':' + Math.round(f.x)).join(','); for (let i = 0; i < v.length; i++) h = Math.imul(h ^ v.charCodeAt(i), 16777619); }\n340\t        return { winner: match.winner, wins: match.wins.slice(), rounds: match.round, seconds: n, over: match.phase === 'over', hash: h >>> 0 };\n341\t      } finally { Math.random = was; }\n342\t    };\n343\t    const a = one(), b = one(); return Object.assign(a, { repeat: a.hash === b.hash, errors: game.errors.length });\n344\t  }\n345\t\n346\t  return { view: 'side', views: ['side'], input: KEYS, res: 'ps1', pausable: true, touch: ['lp', 'hp', 'lk', 'hk'], camera: { zoom: false, tall: 1.8 },   // (a phone held upright: closer, the fight filling it)\n347\t    enter(d) {\n348\t      mode = 'menu'; match = null; select = null; result = null; menu.i = 0; game.follow(null); game.cam.snap = true; game.focus((X0 + X1) / 2, 0, 52);\n349\t      game.cam.bounds = v => { const a = v.p(X0, 0, 0), b = v.p(X1, 0, 0), top = v.p(0, 0, 200)[1], bot2 = v.p(0, 0, -70)[1]; return { x0: a[0], x1: b[0], y0: top, y1: bot2 }; };\n350\t      game.allowJoin({ max: 2 }); A.music('title');\n351\t      if (d && d.part) choose(d.part === 'training' ? 'training' : d.part === 'arcade' ? 'arcade' : 'versus');\n352\t    },\n353\t    exit() { game.timeScale = 1; },\n354\t    back() { if (mode === 'menu') { game.go('title'); return true; } if (mode === 'select') { mode = 'menu'; return true; } return false; },\n355\t    update, draw, bot,\n356\t    state: () => ({ mode, kind, picks, phase: match && match.phase, wins: match && match.wins.slice(), life: match && match.f.map(f => f.life), x: match && match.f.map(f => f.x), winner: match && match.winner, dummy: DUMMY[dummy] }),   // for tests\n357\t    match: () => match, select: () => select,   // (for tests)\n358\t    /** the proof: player 1 (RYO) walks in on a standing GORM, jabs, sweeps and throws fireballs by motion; a hash of the\n359\t     *  fight */\n360\t    run: (n = 600) => proof('fighting', n, (i, k) => {\n361\t      if (i === 2) { kind = 'training'; dummy = 0; fight(['ryo', 'gorm']); }\n362\t      if (i < 120) { if (i === 3) k.hold('right'); if (i === 100) k.up('right'); }\n363\t      if (i % 40 === 20 && i < 300) k.tap('lp');\n364\t      if (i === 320) k.hold('down'); if (i === 330) k.hold('right'); if (i === 336) { k.up('down'); } if (i === 338) k.tap('lp'); if (i === 345) k.up('right');\n365\t      if (i === 400) k.hold('down'); if (i === 406) k.tap('hk'); if (i === 420) k.up('down');\n366\t    }, () => match ? [match.f.map(f => [f.x, f.z, f.life, f.meter, f.combo]), match.f[0].last] : null) };\n367\t})();\n368\tscenes.fighting = FIGHT;\n369\t\n370\t/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n371\t// a genre kit file holds one slice: the menu lists only the slices in this file\n372\tfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\n373\ttitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n374\t// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n375\t// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\n376\tconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\n377\tgame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\n378\twindow.__game = { game, scenes, titleMenu };   // for tests\n379\t})();\n380\t/* =============================== GAME END =============================== */\n381\t"}]},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"314d7d04-ab3b-4a37-826c-d58413a89a23","timestamp":"2026-11-04T00:54:34.903Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff/kits/fighting.js","content":"// The FIGHTING kit's game (one on one: three fighters, versus, arcade, training), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/55-fighting.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. fighting.html plays it; node kits/test.mjs fighting runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 11  FIGHTING  (Street Fighter II, Darkstalkers, Samurai Shodown). @modules fight\n * One on one in the side view, best of three rounds, on a temple courtyard at dusk with a crowd that cheers the blows.\n *   RYO, the all-rounder: a fireball (236 + a punch), a rising uppercut (623 + HP), a spinning kick (214 + HK); his\n *     super, a great fireball (236236 + HP), once his meter is full.\n *   GORM, the grappler: big, slow and hard to move: a spinning slam (41236 + HP, close: it can't be blocked), a shoulder\n *     charge (hold back, then forward + HP), a lariat (623 + LP), an overhead axe kick (HK); his super slam 41236 + HK.\n *   VEX, the fast one: quick strikes, a teleport behind her foe (214 + LK), a rising flip kick (623 + LK), a dashing\n *     elbow (236 + LP); her super, a whirlwind of kicks (236236 + HK).\n * The numbers are a number pad for a fighter facing right (2 down, 6 forward, 4 back; 236 is a quarter circle forward):\n * they mirror when it faces left. Hold back to block (down-back for low moves; jump attacks must be blocked standing);\n * forward or back + HP close to a foe throws it.\n * MODES: VERSUS (a second player joins with 2 on the keyboard or Start on a pad), ARCADE (the other two, then your own\n * shadow, each CPU stronger), TRAINING (the boxes drawn, frame data, your inputs; Tab or a pad's Back changes the dummy:\n * stand, crouch, jump, guard). Deep links: #fighting/versus, #fighting/arcade, #fighting/training.\n * KEYS: arrows / WASD move, jump (up) and crouch (down); U, I punch and J, K kick (light, heavy); a pad's X, Y, A, B.\n * Two on one keyboard: each takes half, and the menus say whose keys are which. TOUCH: the stick (motions work on it)\n * and four buttons.\n * HOW IT WORKS: E.Fighter, E.Match, E.FightAI and E.FightSelect (the fight module) hold the rules; this file is the\n * roster with each fighter's moves, the stage and the menus.\n * ===================================================================================== */\nconst FIGHT = (() => {\n  const A = game.audio, X0 = 0, X1 = 560, KEYS = Object.assign({}, E.FIGHT_KEYS, { dummy: ['Tab', 'Pad8'] });\n  const M = E.MOVES, spin = (name, o) => Object.assign({}, M[name], { spin: true }, o);   // (a move turned into a spin)\n\n  /* ---- THE ROSTER: each a rig and a move list (frame data in frames at 60: [startup, active, recovery]) ---- */\n  const ROSTER = [\n    { id: 'ryo', name: 'RYO', about: 'ALL-ROUNDER', o: { walk: 78, back: 62 }, alt: { cloth: '#2a2a34', pants: '#2a2a34', glove: '#3a6ac8' },\n      rig: { size: 2.35, build: 'heroic', hair: 'short', sleeves: 'short', hat: { style: 'band', color: '#e0302a' }, colors: { skin: '#e8b088', hair: '#2a1a18', cloth: '#f2eee4', pants: '#f2eee4', boot: '#e8b088', belt: '#1a1a22', glove: '#c83a2a' } },\n      moves: {\n        jab: { move: 'jab', btn: 'lp', f: [3, 3, 7], dmg: 30, cancel: true }, cjab: { move: 'jab', btn: 'lp', when: 'crouch', f: [3, 3, 7], dmg: 25, cancel: true }, ajab: { move: 'jab', btn: 'lp', when: 'air', guard: 'overhead', dmg: 35 },\n        cross: { move: 'cross', btn: 'hp', f: [5, 4, 16], dmg: 80, cancel: true }, cup: { move: 'uppercut', btn: 'hp', when: 'crouch', f: [5, 6, 18], dmg: 85 }, ahook: { move: 'hook', btn: 'hp', when: 'air', guard: 'overhead', dmg: 85 },\n        kick: { move: 'kick', btn: 'lk', f: [4, 3, 9], dmg: 35, cancel: true }, ckick: { move: 'kick', btn: 'lk', when: 'crouch', guard: 'low', f: [4, 3, 9], dmg: 30, cancel: true }, akick: { move: 'flyingkick', btn: 'lk', when: 'air', guard: 'overhead', dmg: 50 },\n        round: { move: 'roundhouse', btn: 'hk', f: [7, 5, 18], dmg: 95 }, sweep: { move: 'sweep', btn: 'hk', when: 'crouch', guard: 'low', down: true, f: [6, 5, 20], dmg: 90 }, afly: { move: 'flyingkick', btn: 'hk', when: 'air', guard: 'overhead', dmg: 95 },\n        fire: { move: 'cast', btn: 'lp', motion: '236', f: [12, 2, 30], shot: { speed: 150, r: 7, dmg: 70, color: '#58b8ff' } },\n        fire2: { move: 'cast', btn: 'hp', motion: '236', f: [12, 2, 30], shot: { speed: 220, r: 7, dmg: 80, color: '#58b8ff' } },\n        rise: { move: 'uppercut', btn: 'hp', motion: '623', f: [3, 12, 26], inv: 8, vz: 360, vx: 40, launch: 340, dmg: 120, aa: true },\n        whirl: { move: spin('roundhouse', { active: .4 }), btn: 'hk', motion: '214', f: [8, 24, 14], vx: 130, vz: 170, dmg: 90, down: true },\n        super: { move: 'cast', btn: 'hp', motion: '236236', meter: 100, f: [8, 3, 30], inv: 10, shot: { speed: 200, r: 13, dmg: 260, color: '#ff7a3a', core: '#fff0c0' } } } },\n    { id: 'gorm', name: 'GORM', about: 'GRAPPLER', alt: { pants: '#2a5ac8', belt: '#e0e0e8', glove: '#e0e0e8' }, o: { walk: 56, back: 46, life: 1150, throwDmg: 150, jump: 360, jumpX: 70 },\n      rig: { size: 2.65, build: 'bulky', hair: 'bald', sleeves: 'none', stubble: '#4a2a1a', hunch: .2, colors: { skin: '#c88a5a', hair: '#2a1a10', cloth: '#c88a5a', pants: '#b82a2a', boot: '#3a2a20', belt: '#ffd040', glove: '#3a2a20' } },\n      moves: {\n        jab: { move: 'jab', btn: 'lp', f: [4, 3, 9], dmg: 40, cancel: true }, cjab: { move: 'elbow', btn: 'lp', when: 'crouch', f: [4, 3, 10], dmg: 40, cancel: true }, abash: { move: 'bash', btn: 'lp', when: 'air', guard: 'overhead', dmg: 50 },\n        chop: { move: 'haymaker', btn: 'hp', f: [10, 4, 22], dmg: 120 }, butt: { move: 'bash', btn: 'hp', when: 'close', f: [6, 4, 18], dmg: 100, cancel: true }, cup: { move: 'uppercut', btn: 'hp', when: 'crouch', f: [7, 5, 22], dmg: 100 },\n        ahay: { move: 'haymaker', btn: 'hp', when: 'air', guard: 'overhead', dmg: 110 },\n        kick: { move: 'kick', btn: 'lk', f: [6, 3, 12], dmg: 45 }, ckick: { move: 'kick', btn: 'lk', when: 'crouch', guard: 'low', f: [6, 3, 12], dmg: 40 }, aknee: { move: 'knee', btn: 'lk', when: 'air', guard: 'overhead', dmg: 70 },\n        axe: { move: 'axekick', btn: 'hk', f: [16, 4, 18], guard: 'overhead', dmg: 110 }, sweep: { move: 'sweep', btn: 'hk', when: 'crouch', guard: 'low', down: true, f: [8, 5, 24], dmg: 100 }, astomp: { move: 'axekick', btn: 'hk', when: 'air', guard: 'overhead', dmg: 110 },\n        slam: { move: 'throw', btn: 'hp', motion: '41236', throw: true, range: 40, f: [4, 3, 34], dmg: 230 },\n        rush: { move: 'bash', btn: 'hp', charge: '46', f: [8, 14, 20], vx: 220, dmg: 110, down: true },\n        lariat: { move: spin('hook', { active: .4 }), btn: 'lp', motion: '623', f: [5, 22, 18], inv: 5, vx: 60, r: 7, dmg: 100, down: true, aa: true },\n        super: { move: 'throw', btn: 'hk', motion: '41236', meter: 100, throw: true, range: 48, f: [2, 4, 34], dmg: 400 } } },\n    { id: 'vex', name: 'VEX', about: 'FAST, TELEPORTS', alt: { cloth: '#8a2a3a', hair: '#e0c060', trim: '#e8e8f0' }, o: { walk: 96, back: 80, life: 900, jump: 410, jumpX: 105 },\n      rig: { size: 2.2, build: 'heroic', hair: 'ponytail', sleeves: 'long', outfit: 'tunic', hood: true, colors: { skin: '#f0c8a0', hair: '#4a2a7a', cloth: '#2a6a6a', pants: '#1a2a3a', boot: '#1a1a2a', belt: '#e0b040', glove: '#1a2a3a', trim: '#e0b040' } },\n      moves: {\n        jab: { move: 'jab', btn: 'lp', f: [2, 2, 6], dmg: 25, cancel: true }, cjab: { move: 'jab', btn: 'lp', when: 'crouch', f: [2, 2, 6], dmg: 22, cancel: true }, ajab: { move: 'elbow', btn: 'lp', when: 'air', guard: 'overhead', dmg: 35 },\n        palm: { move: 'cross', btn: 'hp', f: [4, 3, 13], dmg: 65, cancel: true }, knee: { move: 'knee', btn: 'hp', when: 'close', f: [3, 3, 12], dmg: 60, cancel: true }, cup: { move: 'uppercut', btn: 'hp', when: 'crouch', f: [4, 5, 15], dmg: 70 },\n        ahook: { move: 'hook', btn: 'hp', when: 'air', guard: 'overhead', dmg: 70 },\n        kick: { move: 'kick', btn: 'lk', f: [3, 3, 8], dmg: 30, cancel: true }, ckick: { move: 'kick', btn: 'lk', when: 'crouch', guard: 'low', f: [3, 3, 8], dmg: 28, cancel: true }, akick: { move: 'flyingkick', btn: 'lk', when: 'air', guard: 'overhead', dmg: 45 },\n        round: { move: 'roundhouse', btn: 'hk', f: [5, 5, 15], dmg: 80 }, slide: { move: 'sweep', btn: 'hk', when: 'crouch', guard: 'low', down: true, f: [5, 8, 18], vx: 150, dmg: 75 }, afly: { move: 'flyingkick', btn: 'hk', when: 'air', guard: 'overhead', dmg: 80 },\n        port: { move: 'cast', btn: 'lk', motion: '214', f: [10, 1, 12], teleport: 36, inv: 12 },\n        flip: { move: 'flyingkick', btn: 'lk', motion: '623', f: [3, 12, 22], inv: 6, vz: 340, vx: 70, launch: 320, dmg: 100, aa: true },\n        dash: { move: 'elbow', btn: 'lp', motion: '236', f: [6, 10, 16], vx: 260, dmg: 70 },\n        super: { move: spin('roundhouse', { active: .5 }), btn: 'hk', motion: '236236', meter: 100, f: [4, 30, 20], inv: 10, vx: 170, vz: 220, dmg: 260, down: true } } }];\n  const byId = id => ROSTER.find(e => e.id === id);\n  // a fighter of the roster; alt: its second palette (a mirror match's player 2); shadow: the arcade's last foe, the\n  // fighter's own moves in a dark palette\n  const make = (id, x, side, shadow, alt) => {\n    const e = byId(id), rig = Object.assign({}, e.rig, { weapon: null, speedRef: 40, colors: Object.assign({}, e.rig.colors, alt ? e.alt : {}, shadow ? { cloth: '#2a2a3a', pants: '#1a1a24', hair: '#0a0a12', glove: '#6a2a8a', skin: '#8a7a9a', eye: '#ff4a4a' } : {}) });\n    return new E.Fighter(game, Object.assign({ name: shadow ? 'SHADOW ' + e.name : e.name, x, side, rig, moves: e.moves }, e.o));\n  };\n\n  /* ---- THE STAGE: a temple courtyard at dusk; a crowd behind the rope that cheers the blows ---- */\n  const bg = new E.Backdrop({ sky: ['#1a1440', '#5a3070', '#d86a5a', '#f8b878'], sun: { x: .7, y: .58, r: 18, color: '#ffd8a0' },\n    layers: [{ kind: 'mountains', color: '#4a2e5e', y: .5, height: .26, parallax: .05 }, { kind: 'castle', color: '#2e1c3c', y: .6, height: .34, parallax: .12, windows: '#ffb85a' }, { kind: 'forest', color: '#1e1428', y: .7, height: .14, parallax: .25 }] });\n  const CROWD = Array.from({ length: 70 }, (_, i) => ({ x: X0 - 60 + i * ((X1 - X0 + 120) / 70) + E.hash2(i, 3) * 6, row: i % 3, h: 18 + E.hash2(i, 5) * 8, c: ['#5a3a6a', '#3a4a7a', '#7a3a3a', '#4a6a4a', '#7a5a3a', '#3a3a4a'][Math.floor(E.hash2(i, 7) * 6)], ph: E.hash2(i, 9) * 6 }));\n  let cheer = 0;\n  function stage(r) {\n    const g = r.ctx, v = r.view; bg.draw(r);\n    const W = r.bw, floor = Math.round(r.w(0, 0, 0)[1]), sx = x => r.w(x, 0, 0)[0];\n    // the far wall and its lanterns, then the crowd behind the rope (parallax: the back rows move slower)\n    px.rect(g, 0, floor - 70, W, 70, '#2a1a2a'); px.rect(g, 0, floor - 72, W, 2, '#5a3a4a');\n    for (let k = 0; k < 9; k++) { const lx = Math.round(sx(X0 + k * 70) * .9 + W * .05), ly = floor - 66, glow = .6 + .4 * Math.sin(game.time * 3 + k); px.blend(g, .3 * glow, 'add', () => px.disc(g, lx, ly + 8, 14, '#ff9a4a')); px.rect(g, lx - 4, ly, 8, 12, '#e04a3a'); px.rect(g, lx - 4, ly + 5, 8, 1, '#ffd060'); }\n    for (const p of CROWD) {\n      const par = [.7, .82, .94][p.row], x = Math.round((sx(p.x) - W / 2) * par + W / 2), bob = Math.abs(Math.sin(game.time * (3 + cheer * 6) + p.ph)) * (1 + cheer * 4), y = floor - 18 - p.row * 9 - p.h + 18 - bob;\n      const c = E.shade(p.c, -.1 * (2 - p.row)); px.rect(g, x - 5, y + 6, 10, p.h, c); px.disc(g, x, y + 3, 4, E.shade(c, .15));\n      if (cheer > .3 && E.hash2(Math.floor(p.ph * 10), 1) > .5) { px.rect(g, x - 7, y - 4 - bob, 2, 8, c); px.rect(g, x + 5, y - 4 - bob, 2, 8, c); }   // arms up\n    }\n    px.rect(g, 0, floor - 12, W, 2, '#c8a060');   // the rope\n    // the floor: planks to the horizon, lit in the middle\n    for (let y = floor; y < r.bh; y++) { const k = (y - floor) / Math.max(1, r.bh - floor); px.rect(g, 0, y, W, 1, E.mix('#6a4a3a', '#3a2620', k)); }\n    for (let k = -12; k <= 12; k++) { const x0 = sx(X0 + (X1 - X0) / 2 + k * 40); px.line(g, Math.round(x0), floor, Math.round(W / 2 + (x0 - W / 2) * 1.8), r.bh, '#4a3028'); }\n    px.blend(g, .18, 'add', () => px.ell(g, W / 2, floor + 14, W * .45, 10, '#ffb878'));\n  }\n\n  /* ---- MODES: the menu, the select, the match, the results ---- */\n  let mode = 'menu', match = null, select = null, kind = 'versus', picks = null, ladder = [], step = 0, dummy = 0, result = null, t = 0;\n  const DUMMY = ['stand', 'crouch', 'jump', 'guard'];\n  const menu = new E.Menu(game, ['VERSUS', 'ARCADE', 'TRAINING'], { y: 0, onPick: i => choose(['versus', 'arcade', 'training'][i]) });\n  const after = new E.Menu(game, ['REMATCH', 'CHARACTER SELECT', 'TITLE'], { y: 0, onPick: i => i === 0 ? fight(picks) : i === 1 ? choose(kind) : game.go('title') });\n  const cont = new E.Menu(game, ['CONTINUE', 'TITLE'], { y: 0, onPick: i => i ? game.go('title') : fight(picks) });\n  const p2 = () => game.players[1] || null;\n  function choose(k) {\n    kind = k; mode = 'select'; t = 0;\n    select = new E.FightSelect(game, { roster: ROSTER, inputs: [game.input, k === 'versus' ? p2() : null], cpu: [false, k !== 'versus'], seed: 1 + Math.floor(Math.random() * 1e6),\n      onDone: ids => { if (k === 'arcade') { ladder = ROSTER.filter(e => e.id !== ids[0]).map(e => e.id).concat([ids[0]]); step = 0; picks = [ids[0], ladder[0]]; } else picks = ids; fight(picks); } });\n  }\n  function fight(ids) {\n    const a = make(ids[0], 0, 1), shadow = kind === 'arcade' && step === ladder.length - 1, b = make(ids[1], 0, -1, shadow, ids[0] === ids[1] && !shadow), cpu = kind === 'arcade';\n    const s = game.view.p(1, 0, 0)[0] - game.view.p(0, 0, 0)[0], span = Math.max(160, game.W / s - 36);\n    match = new E.Match(game, { fighters: [a, b], ai: [null, cpu ? new E.FightAI({ level: 3 + step * 2, seed: 1 + Math.floor(Math.random() * 1e6) }) : null], inputs: [game.input, p2()], x0: X0, x1: X1, span,\n      training: kind === 'training' ? { dummy: DUMMY[dummy] } : false, onEnd: w => end(w) });\n    mode = 'fight'; result = null; t = 0; A.music(SONG); game.input.consumeAll();\n  }\n  function end(w) {\n    result = { w, t: 0 }; t = 0; A.music(null);\n    if (kind === 'arcade') { if (w === 0) { step++; result.next = step < ladder.length; } else cont.i = 0; } else after.i = 0;\n  }\n  // a fighting song: a driving bass under a modal lead (the step sequencer's format)\n  const SONG = { bpm: 150, steps: 4, tracks: [\n    { wave: 'pulse12', vol: .1, notes: 'A4 - C5 D5 E5 - D5 C5 | D5 - G4 - C5 B4 A4 G4 | F4 - A4 C5 D5 - E5 - | G5 F5 E5 D5 E5 - - -' },\n    { wave: 'triangle', vol: .3, notes: 'A2 . A2 A3 A2 . A2 G2 | G2 . G2 G3 G2 . G2 E2 | F2 . F2 F3 F2 . F2 G2 | G2 . G2 B2 D3 . E3 .' },\n    { wave: 'drums', vol: .1, notes: 'k . h . s . h k k . h . s . h h' }] };\n\n  function update(dt) {\n    t += dt; cheer = Math.max(0, cheer - dt * .8);\n    for (const k of ['lp', 'hp', 'lk', 'hk']) game.input.touchSet(k, null, mode === 'fight' && !(result && result.t > 1.2));   // (the fight's buttons only in a fight: taps pick on the menus)\n    if (mode === 'menu') { if (!menu.update(dt)) pickOnStart(menu); return; }\n    if (mode === 'select') {\n      if (kind === 'versus' && !select.inputs[1] && p2()) select.inputs[1] = p2();   // player 2 joined: its cursor comes alive\n      select.update(dt); return;\n    }\n    if (!match) return;\n    const lifeWas = match.f.map(f => f.life);\n    match.update(dt);\n    match.f.forEach((f, i) => { if (f.life < lifeWas[i]) cheer = Math.min(1, cheer + (lifeWas[i] - f.life) / 150); });\n    if (kind === 'training' && game.input.pressed('dummy')) { dummy = (dummy + 1) % DUMMY.length; match.o.training.dummy = DUMMY[dummy]; A.sfx('select'); }\n    if (result) {\n      result.t += dt; if (result.t < 1.2) return;\n      match.call = null;   // (the menu's own title instead)\n      if (kind === 'arcade') { if (result.w === 0) { if (result.next) { picks = [picks[0], ladder[step]]; fight(picks); } else if (result.t > 5 || game.input.pressed('start')) game.go('title'); } else if (!cont.update(dt)) pickOnStart(cont); }\n      else if (!after.update(dt)) pickOnStart(after);\n    }\n  }\n  function draw(r) {\n    stage(r);\n    if (match && (mode === 'fight')) match.draw(r);\n    r.overlay(g => {\n      const W = r.W, H = r.H;\n      if (mode === 'menu') {\n        px.blend(g, .55, 'normal', () => px.rect(g, 0, 0, W, H, '#0a0614'));\n        E.font.title(g, 'FIGHTING', W / 2, 30, { scale: 4, align: 'center', colors: ['#fff6d0', '#ff9a4a', '#c0302a'], depth: 3 });\n        const two = game.players.length > 1, line = menu.i === 0 ? (two ? 'TWO PLAYERS: PICK YOUR FIGHTERS' : 'PLAYER 2: PRESS 2 OR START ON A PAD') : menu.i === 1 ? 'BEAT THE OTHER TWO, THEN YOUR SHADOW' : 'THE BOXES, FRAME DATA AND YOUR INPUTS';\n        E.font.text(g, line, W / 2, H - 34, '#e8d8ff', { align: 'center', shadow: '#000', outline: false });\n        const keys = I => (two ? I.name + ' ' : '') + ['lp', 'hp', 'lk', 'hk'].map(k => I.label(k)).join(' ') + ' PUNCH, KICK';\n        E.font.text(g, two ? game.players.map(keys).join('     ') : 'ARROWS MOVE   ' + keys(game.input) + '   HOLD BACK TO BLOCK', W / 2, H - 22, '#9a8ac8', { align: 'center', outline: false, font: 'tiny' });\n        E.font.text(g, '236 + PUNCH: A FIREBALL (NUMPAD NOTATION, FACING RIGHT)', W / 2, H - 12, '#7a6aa8', { align: 'center', outline: false, font: 'tiny' });\n      }\n      if (mode === 'select' && kind === 'versus' && !select.inputs[1]) E.font.text(g, 'PLAYER 2: PRESS 2 OR START ON A PAD', W / 2, 26, '#ff8a6a', { align: 'center', shadow: '#000', outline: false });\n      if (mode === 'fight' && kind === 'arcade' && match.phase === 'intro') E.font.text(g, 'STAGE ' + (step + 1) + ' OF ' + ladder.length, W / 2, H / 2 + 6, '#ffffff', { align: 'center', shadow: '#000', outline: false });\n      const ta = game.input.touchArea && game.input.touchArea();   // (clear of the touch buttons)\n      if (mode === 'fight' && kind === 'training') E.font.text(g, 'DUMMY: ' + DUMMY[dummy].toUpperCase() + '  (TAB OR BACK CHANGES IT)', W / 2, ta ? Math.round(ta.y0) - 10 : H - 24, '#ffd060', { align: 'center', shadow: '#000', outline: false, font: 'tiny' });\n      if (result && result.t > 1.2) {\n        if (kind === 'arcade' && result.w === 0 && !result.next) { E.font.title(g, 'CHAMPION!', W / 2, H / 2 - 34, { scale: 3, align: 'center', colors: ['#fff6d0', '#ffd060', '#e8782a'] }); }\n        else if (kind === 'arcade' && result.w === 1) { E.font.title(g, 'CONTINUE?', W / 2, H / 2 - 40, { scale: 2, align: 'center', colors: ['#ffffff', '#ff8a6a', '#c0302a'] }); }\n        else if (kind !== 'arcade') E.font.title(g, match.f[result.w].name + ' WINS', W / 2, H / 2 - 44, { scale: 3, align: 'center', colors: ['#fff6d0', '#ffd060', '#e8782a'] });\n      }\n    });\n    if (mode === 'menu') { menu.y = Math.round(r.H / 2) - 10; menu.draw(r); }\n    if (mode === 'select') select.draw(r);\n    if (result && result.t > 1.2 && !(kind === 'arcade' && result.w === 0)) { const m = kind === 'arcade' ? cont : after; m.y = Math.round(r.H / 2) - 12; m.draw(r); }\n  }\n\n  /** the bot (tools/kits-test.mjs): two CPUs fight a match with seed s, twice; who won, the rounds, and whether the second\n   *  match repeated the first exactly (the CPU's randomness is its own) */\n  function bot(s = 1) {\n    const one = () => {\n      const was = Math.random; Math.random = E.rng(s);\n      try {\n        game.go('fighting', null, { fade: 0 }); game.advance(1 / 120); kind = 'versus'; picks = ['ryo', 'gorm'];\n        fight(picks); match.ai = [new E.FightAI({ level: 6, seed: s }), new E.FightAI({ level: 5, seed: s + 1 })];\n        let h = 2166136261, n = 0; for (; n < 260 && match.phase !== 'over'; n++) { game.advance(1); const v = match.f.map(f => Math.round(f.life) + ':' + Math.round(f.x)).join(','); for (let i = 0; i < v.length; i++) h = Math.imul(h ^ v.charCodeAt(i), 16777619); }\n        return { winner: match.winner, wins: match.wins.slice(), rounds: match.round, seconds: n, over: match.phase === 'over', hash: h >>> 0 };\n      } finally { Math.random = was; }\n    };\n    const a = one(), b = one(); return Object.assign(a, { repeat: a.hash === b.hash, errors: game.errors.length });\n  }\n\n  return { view: 'side', views: ['side'], input: KEYS, res: 'ps1', pausable: true, touch: ['lp', 'hp', 'lk', 'hk'], camera: { zoom: false, tall: 1.8 },   // (a phone held upright: closer, the fight filling it)\n    enter(d) {\n      mode = 'menu'; match = null; select = null; result = null; menu.i = 0; game.follow(null); game.cam.snap = true; game.focus((X0 + X1) / 2, 0, 52);\n      game.cam.bounds = v => { const a = v.p(X0, 0, 0), b = v.p(X1, 0, 0), top = v.p(0, 0, 200)[1], bot2 = v.p(0, 0, -70)[1]; return { x0: a[0], x1: b[0], y0: top, y1: bot2 }; };\n      game.allowJoin({ max: 2 }); A.music('title');\n      if (d && d.part) choose(d.part === 'training' ? 'training' : d.part === 'arcade' ? 'arcade' : 'versus');\n    },\n    exit() { game.timeScale = 1; },\n    back() { if (mode === 'menu') { game.go('title'); return true; } if (mode === 'select') { mode = 'menu'; return true; } return false; },\n    update, draw, bot,\n    state: () => ({ mode, kind, picks, phase: match && match.phase, wins: match && match.wins.slice(), life: match && match.f.map(f => f.life), x: match && match.f.map(f => f.x), winner: match && match.winner, dummy: DUMMY[dummy] }),   // for tests\n    match: () => match, select: () => select,   // (for tests)\n    /** the proof: player 1 (RYO) walks in on a standing GORM, jabs, sweeps and throws fireballs by motion; a hash of the\n     *  fight */\n    run: (n = 600) => proof('fighting', n, (i, k) => {\n      if (i === 2) { kind = 'training'; dummy = 0; fight(['ryo', 'gorm']); }\n      if (i < 120) { if (i === 3) k.hold('right'); if (i === 100) k.up('right'); }\n      if (i % 40 === 20 && i < 300) k.tap('lp');\n      if (i === 320) k.hold('down'); if (i === 330) k.hold('right'); if (i === 336) { k.up('down'); } if (i === 338) k.tap('lp'); if (i === 345) k.up('right');\n      if (i === 400) k.hold('down'); if (i === 406) k.tap('hk'); if (i === 420) k.up('down');\n    }, () => match ? [match.f.map(f => [f.x, f.z, f.life, f.meter, f.combo]), match.f[0].last] : null) };\n})();\nscenes.fighting = FIGHT;\n\n/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n// a genre kit file holds one slice: the menu lists only the slices in this file\nfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\ntitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\nconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\ngame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\nwindow.__game = { game, scenes, titleMenu };   // for tests\n})();\n/* =============================== GAME END =============================== */\n","numLines":381,"startLine":1,"totalLines":381}},"tool_result_meta":[{"id":"toolu_015S21HEgJnZ7JtWsXLJ6g6T","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
