{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XfRJw3MqWzxuicbEN4ywn3","type":"tool_result","content":"140\t      const mv = ctl.move(), press = BTN.filter(k => ctl.map[k] && ctl.buffered(k, .1));\n141\t      return { x: mv[0] * this.facing, y: mv[1], sx: mv[0], press, do: null, input: ctl };\n142\t    }\n143\t    return { x: (ctl.x || 0) * this.facing, y: ctl.y || 0, sx: ctl.x || 0, press: ctl.press ? [ctl.press] : [], do: ctl.do || null };\n144\t  }\n145\t  // the special this step's input calls for (motion or charge, a super first while the meter has it), or null\n146\t  _special(c) {\n147\t    let best = null;\n148\t    for (const id in this.moves) {\n149\t      const m = this.moves[id]; if (!m.motion && !m.charge) continue;\n150\t      if (m.meter && this.meter < m.meter) continue;\n151\t      if (m.shot && this.shots.list.length) continue;\n152\t      let ok = false;\n153\t      if (c.do) ok = c.do === id;\n154\t      else if (m.motion && c.input) ok = c.input.motion(m.motion, m.btn, { facing: this.facing, window: m.window || (m.motion.length > 4 ? .8 : .45) });\n155\t      else if (m.charge && c.press.includes(m.btn)) ok = m.charge === '46' ? this._chB >= (m.time || .7) && c.x > .5 : this._chD >= (m.time || .7) && c.y < -.5;\n156\t      if (ok && (!best || (m.meter || 0) > (best.meter || 0) || (m.motion || '').length > (best.motion || '').length)) best = m;\n157\t    }\n158\t    return best;\n159\t  }\n160\t  // the normal for a button in this state: air, crouching, close, standing\n161\t  _normal(btn, close) {\n162\t    const air = !this.body.onGround, list = Object.values(this.moves).filter(m => m.btn === btn && !m.motion && !m.charge);\n163\t    if (air) return list.find(m => m.when === 'air') || null;\n164\t    if (this.crouch) return list.find(m => m.when === 'crouch') || null;\n165\t    return (close && list.find(m => m.when === 'close')) || list.find(m => m.when === 'stand') || null;\n166\t  }\n167\t  // start move m: its Attack from the top, its invulnerability, its travel at the active frames\n168\t  _start(m) {\n169\t    if (this.act) this.act.m.atk.cancel();\n170\t    m.atk.start(); this.act = { m, hit: false, blocked: false, fired: false, moved: false };\n171\t    if (m.inv) this.inv = Math.max(this.inv, sec(m.inv));\n172\t    if (m.meter) { this.meter -= m.meter; this.game.flash('#ffffff', .1, .6); this.game.freeze(.2); this.game.audio.sfx('charge'); }   // a super: its cost, a flash, the world holds its breath\n173\t    if (!this.body.onGround) this._airUsed = true;\n174\t    this.game.audio.sfx(m.motion || m.charge ? 'whoosh' : 'select', { pitch: m.btn === 'hp' || m.btn === 'hk' ? .8 : 1.1 });\n175\t  }\n176\t  /** move one step (once a step, 120 times a second): ctl is its E.Input (this.input by default) or a CPU's intent */\n177\t  update(dt, ctl = this.input) {\n178\t    const b = this.body, foe = this.foe;\n179\t    if (foe && this.free && foe.x !== this.x) this.facing = foe.x > this.x ? 1 : -1;   // it faces its foe (sides switch on a cross-up)\n180\t    const c = this._read(ctl); this._t += dt; this.inv -= dt; this._c = c;\n181\t    // charges: back or down held, kept a quarter second after letting go\n182\t    if (c.x < -.5) { this._chB += dt; this._gB = .25; } else if ((this._gB -= dt) <= 0) this._chB = 0;\n183\t    if (c.y > .5) { this._chD += dt; this._gD = .25; } else if ((this._gD -= dt) <= 0) this._chD = 0;\n184\t    if (!this.ko && !this.thrown) { const s = this._special(c); if (s) this._want = { m: s, t: .12 }; }   // a motion stays wanted for a moment\n185\t    if (this._want && (this._want.t -= dt) <= 0) this._want = null;\n186\t    let ix = 0;\n187\t    if (this.thrown) this._thrownStep(dt);\n188\t    else if (this.ko || this.win) { if (b.onGround && this.ko) this.down = 1; }\n189\t    else if (this.down > 0) { if ((this.down -= dt) <= 0) { this.rise = .45; this.inv = Math.max(this.inv, .6); } }\n190\t    else if (this.rise > 0) { this.rise -= dt; }\n191\t    else if (this.stun > 0) { if ((this.stun -= dt) <= 0) { this.kind = null; if (b.onGround) this.combo = 0; } }\n192\t    else if (this.air) { if (b.onGround) { this.air = false; this.down = .55; this.combo = 0; this.juggle = 0; b.vx = 0; this.game.shake(2); this.game.audio.sfx('land'); } }   // flying from a hit, then down\n193\t    else {\n194\t      const close = foe && Math.abs(foe.x - this.x) < this.o.throwRange * 1.6;\n195\t      if (this.act) {   // a move playing: a special may cancel it once it connects (until early in its recovery)\n196\t        const a = this.act, st = a.m.atk; if (this._want && a.m.cancel && (a.hit || a.blocked) && (st.phase !== 'recover' || st.u < .4) && !a.m.motion) { this._start(this._want.m); this._want = null; }\n197\t      } else if (b.onGround && this.free) {\n198\t        this.crouch = c.y > .5;\n199\t        const thr = this.o.throwBtn;\n200\t        if (this._want) { this._start(this._want.m); if (c.input && this._want.m.btn) c.input.consume(this._want.m.btn); this._want = null; }\n201\t        else if (c.press.includes(thr) && Math.abs(c.x) > .5 && foe && foe._throwable() && Math.abs(foe.x - this.x) < this.o.throwRange) this._throw(c.x > 0 ? 1 : -1);\n202\t        else { for (const k of c.press) { const m = this._normal(k, close); if (m) { this._start(m); if (c.input) c.input.consume(k); break; } } }\n203\t        if (!this.act && !this.crouch && c.y < -.5) {   // a jump: straight, forward or back\n204\t          b.vz = this.o.jump; b.vx = Math.sign(Math.round(c.sx)) * this.o.jumpX; b.onGround = false; this._airUsed = false; this.game.audio.sfx('jump');\n205\t        } else if (!this.act && !this.crouch) {   // walking, or holding back to guard as an attack comes\n206\t          const back = c.x < -.5, threat = foe && (foe.act && foe.act.m.atk.phase !== 'recover' || foe.shots.list.length) && Math.abs(foe.x - this.x) < 110;\n207\t          this.blocking = back && threat;\n208\t          if (!this.blocking && Math.abs(c.x) > .5) { b.run = back ? this.o.back : this.o.walk; ix = Math.sign(c.sx); }\n209\t        }\n210\t        if (this.crouch) this.blocking = c.x < -.5;\n211\t      } else if (!b.onGround && !this.act && !this._airUsed) {   // a jump's one attack\n212\t        for (const k of c.press) { const m = this._normal(k, false); if (m) { this._start(m); if (c.input) c.input.consume(k); break; } }\n213\t      }\n214\t    }\n215\t    if (!this.free) this.blocking = this.stun > 0 && this.kind === 'block';\n216\t    // the move: its phases, its shot and travel at the active frames\n217\t    if (this.act) {\n218\t      const a = this.act, m = a.m, began = m.atk.update(dt);\n219\t      if (began === 'active') {\n220\t        if (m.shot && !a.fired) this._fire(m);\n221\t        if ((m.vx || m.vz) && !a.moved) { if (m.vx) { b.vx = this.facing * m.vx; if (!m.vz) b.stun = m.atk.spec.active + m.atk.spec.recover * .5; } if (m.vz) { b.vz = m.vz; b.onGround = false; } a.moved = true; }\n222\t        if (m.teleport && foe) { b.x = foe.x + this.facing * m.teleport; this.facing = -this.facing; this.game.particles.sparks(b.x, 0, 40, 10, null, { color: '#c8a0ff' }); }\n223\t        if (m.throw && foe && foe._throwable() && Math.abs(foe.x - this.x) < (m.range || this.o.throwRange)) this._throw(1, m);\n224\t      }\n225\t      if (!m.atk.busy) { this.act = null; if (b.onGround) this._airUsed = false; }\n226\t    }\n227\t    if (b.onGround && !this.air && this.act && !this.act.m.vx && !this.act.moved) b.vx = approach(b.vx, 0, 1600 * dt);\n228\t    if (!this.thrown) b.update(dt, this._level, { x: ix });\n229\t    if (b.landed && this.act && (this.act.m.when === 'air' || this.act.m.vz)) { this.act.m.atk.cancel(); this.act = null; }   // a jump's attack ends on landing\n230\t    if (b.landed) this._airUsed = false;\n231\t    this.shots.update(dt);\n232\t    this._lag = Math.max(this.life / this.o.life, this._lag - dt * .4);\n233\t    this._rig(dt);\n234\t  }\n235\t  _throwable() { return !this.ko && this.body.onGround && !this.air && this.stun <= 0 && this.down <= 0 && this.rise <= 0 && this.inv <= 0 && !this.thrown && !(this.act && this.act.m.atk.phase === 'active'); }\n236\t  // grab the foe: dir 1 throws it forward, -1 behind; m: a command grab's spec\n237\t  _throw(dir, m) {\n238\t    const foe = this.foe; if (!m) this._start(this._throwM);\n239\t    foe.thrown = { by: this, t: 0, dur: .45, dir: dir * this.facing, dmg: m ? m.dmg : this.o.throwDmg, x0: foe.x }; foe.act = null; foe.combo = 0;\n240\t    this.game.audio.sfx('swing');\n241\t  }\n242\t  _thrownStep(dt) {\n243\t    const T = this.thrown, b = this.body, by = T.by, u = clamp((T.t += dt) / T.dur, 0, 1), x1 = by.x + T.dir * 28;\n244\t    b.x = lerp(T.x0, x1, u); b.z = Math.sin(u * PI) * 50; b.vx = b.vz = 0;\n245\t    if (u >= 1) {\n246\t      this.thrown = null; b.z = 0; this.life -= T.dmg; this.down = .7; this.inv = .3; this.facing = by.x > b.x ? 1 : -1;\n247\t      this.game.hitFx(b.x, 0, 8, { power: 2, color: '#ffe070', sound: 'kick' }); this.game.shake(4);\n248\t      by.meter = Math.min(100 * (by.o.bars || 1), by.meter + 15);\n249\t      if (this.life <= 0) { this.life = 0; this.ko = true; }\n250\t    }\n251\t  }\n252\t  _fire(m) {\n253\t    const s = m.shot, h = this.rig.hand('R');\n254\t    this.shots.fire({ x: h[0] + this.facing * 6, y: 0, z: h[2], vx: this.facing * (s.speed || 150), r: s.r || 7, life: s.life || 3, color: s.color || '#60c8ff', core: s.core || '#ffffff', team: this.name, data: m });\n255\t    this.act.fired = true; this.game.audio.sfx('laser');\n256\t  }\n257\t  // the rig from the state: guard, crouch, block, hurt, flying, down, getting up, the move, the win pose\n258\t  _rig(dt) {\n259\t    const b = this.body, st = this.act && this.act.m.atk.state, fly = (this.air || this.ko) && !b.onGround;\n260\t    this.rig.update(dt, Object.assign(b.rigState(), {\n261\t      facing: this.facing > 0 ? 0 : PI, vx: this.stun > 0 || this.act ? 0 : b.vx, air: !b.onGround && !this.air && !this.thrown,\n262\t      stance: this.free && !this.blocking ? 'guard' : null, hurt: (this.stun > 0 && this.kind === 'hit') || !!this.thrown,\n263\t      down: fly ? clamp(.6 - b.vz / 500, 0, 1) : undefined, attack: st,\n264\t      pose: this.win ? 'cheer' : this.down > 0 || (this.ko && b.onGround) ? 'down' : this.rise > .2 ? 'kneel' : this.rise > 0 || this.crouch ? 'crouch' : this.blocking ? 'block' : null,\n265\t      expr: this.win ? 'smile' : this.stun > 0 || this.ko ? 'wince' : st ? 'shout' : null }));\n266\t    this._boxes();\n267\t  }\n268\t  // its boxes this step, from the rig's joints: hurt (head, body, legs), hit (the striking fist or foot), push\n269\t  _boxes() {\n270\t    const r = this.rig, J = r.J, sz = r.o.size, P = k => { const w = r.worldOffset(J[k]); return [r.x + w[0], r.z + w[2]]; };\n271\t    const box = (pts, pad) => { let x0 = 1e9, x1 = -1e9, z0 = 1e9, z1 = -1e9; for (const [x, z] of pts) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); z0 = Math.min(z0, z); z1 = Math.max(z1, z); } return { x: x0 - pad, z: z0 - pad, w: x1 - x0 + pad * 2, h: z1 - z0 + pad * 2 }; };\n272\t    const hd = P('head'), hurt = [box([hd], 3.2 * sz), box([P('shC'), P('hipC'), P('shL'), P('shR')], 2.4 * sz), box([P('hipC'), P('kneeL'), P('kneeR'), P('footL'), P('footR')], 1.6 * sz)];\n273\t    let hit = null; const a = this.act;\n274\t    if (a && !a.hit && !a.blocked && a.m.atk.active && !a.m.shot && !a.m.throw && !a.m.teleport) {\n275\t      const s = a.m.atk.spec, p = s.kick ? P('footR') : P(s.hand === 'L' ? 'handL' : 'handR'), R = a.m.r * sz / 2;\n276\t      hit = { x: p[0] - R, z: p[1] - R, w: R * 2, h: R * 2 };\n277\t    }\n278\t    /** boxes: this step's boxes ({ hurt: [head, body, legs], hit: the striking fist or foot's, or null, push }: each\n279\t     *  { x, z, w, h }, x its left, z its bottom) */\n280\t    const b = this.body; this.boxes = { hurt, hit, push: { x: b.x - b.w / 2, z: b.z, w: b.w, h: b.h } };\n281\t  }\n282\t  // does it block move m now: holding back, on the ground, and low moves crouching, overheads standing\n283\t  _blocks(m) {\n284\t    if (m.guard === 'throw' || !this.body.onGround || this.air || this.stun > 0 && this.kind === 'hit' || this.act || this.down > 0 || this.ko) return false;\n285\t    if (!(this._c && this._c.x < -.5)) return false;\n286\t    return m.guard === 'low' ? this.crouch : m.guard === 'overhead' ? !this.crouch : true;\n287\t  }\n288\t  // this fighter's move m lands on the foe at (x, z): blocked or a hit (a shot passes its own spec as m)\n289\t  _lands(foe, m, x, z) {\n290\t    const g = this.game, dir = foe.x > this.x ? 1 : foe.x < this.x ? -1 : this.facing, a = this.act, bars = 100 * (this.o.bars || 1);\n291\t    if (a && a.m === m) a.hit = true;\n292\t    const rec = a && a.m === m ? Math.max(0, frames(m.atk.spec.recover) + frames(m.atk.spec.active * (1 - m.atk.u))) : 0;\n293\t    if (foe._blocks(m)) {\n294\t      if (a && a.m === m) { a.blocked = true; a.hit = false; }\n295\t      foe.stun = sec(m.block); foe.kind = 'block'; foe.life = Math.max(1, foe.life - Math.round(m.dmg * m.chip)); foe.body.vx = dir * m.push * .8; foe.body.stun = foe.stun;\n296\t      this.meter = Math.min(bars, this.meter + m.dmg * .06); foe.meter = Math.min(100 * (foe.o.bars || 1), foe.meter + m.dmg * .04);\n297\t      g.particles.impact(x, 0, z, 6, '#a0d8ff'); g.particles.sparks(x, 0, z, 5, null, { color: '#a0d8ff' }); g.audio.sfx('bump'); g.freeze(.04);\n298\t      this.last = { id: m.id, startup: m.frames[0], active: m.frames[1], recovery: m.frames[2], adv: m.block - rec, on: 'block' };\n299\t      return;\n300\t    }\n301\t    const scale = Math.max(.5, 1 - foe.combo * .1), dmg = Math.round(m.dmg * scale);\n302\t    foe.combo++; foe.life -= dmg; foe.act && foe.act.m.atk.cancel(); foe.act = null; foe.crouch = false;\n303\t    this.meter = Math.min(bars, this.meter + m.dmg * .12); foe.meter = Math.min(100 * (foe.o.bars || 1), foe.meter + m.dmg * .06);\n304\t    const lift = foe.life <= 0 ? Math.max(m.launch || 0, 260) : m.launch || ((m.down || !foe.body.onGround || foe.air) ? 200 : 0);\n305\t    if (lift) { foe.air = true; foe.juggle++; foe.body.knock(dir, foe.life <= 0 ? 150 : 70, lift, 1); foe.stun = 0; foe.kind = 'hit'; }\n306\t    else { foe.stun = sec(m.stun); foe.kind = 'hit'; foe.body.vx = dir * m.push; foe.body.stun = foe.stun; }\n307\t    if (foe.life <= 0) { foe.life = 0; foe.ko = true; }\n308\t    const heavy = m.dmg >= 70; g.hitFx(x, 0, z, { power: heavy ? 1.8 : 1.1, angle: dir > 0 ? 0 : PI, color: '#ffe070', sound: heavy ? 'kick' : 'punch' });\n309\t    this.last = { id: m.id, startup: m.frames[0], active: m.frames[1], recovery: m.frames[2], adv: lift ? null : m.stun - rec, on: 'hit' };\n310\t  }\n311\t  /** draw it (and its shots) in the scene: r.actor with its rig */\n312\t  draw(r) {\n313\t    const b = this.body;\n314\t    r.actor(b.x, 0, b.z, (g, ox, oy) => this.rig.draw(g, ox, oy, r.view));\n315\t    for (const s of this.shots.list) r.queue(s.x, 0, s.z, g => {   // an energy ball: a glow, a bright core, a flickering trail\n316\t      const [x, y] = r.w(s.x, 0, s.z), R = s.r * r.view.scale, f = Math.floor(s.t * 30) % 2;\n317\t      px.glow(g, 1); for (let k = 3; k > 0; k--) px.disc(g, x - Math.sign(s.vx) * k * R * .7, y, R * (1 - k * .2), E.shade(s.color, -.2 * k));\n318\t      px.disc(g, x, y, R + f, s.color); px.disc(g, x, y, R * .55, s.core);\n319\t    }, { bias: .5, emissive: true });\n320\t  }\n321\t  /** the boxes drawn (training): hurt green, hit red, push blue */\n322\t  drawBoxes(r) {\n323\t    const B = this.boxes; if (!B) return;\n324\t    r.overlay(g => {\n325\t      const out = (b, c) => { const [x0, y0] = r.w(b.x, 0, b.z + b.h), [x1, y1] = r.w(b.x + b.w, 0, b.z); const x = Math.round(x0), y = Math.round(y0), w = Math.round(x1 - x0), h = Math.round(y1 - y0); px.rect(g, x, y, w, 1, c); px.rect(g, x, y + h - 1, w, 1, c); px.rect(g, x, y, 1, h, c); px.rect(g, x + w - 1, y, 1, h, c); };\n326\t      out(B.push, '#4a8aff'); for (const h of B.hurt) out(h, this.inv > 0 ? '#ffffff' : '#4ad860'); if (B.hit) out(B.hit, '#ff4a4a');\n327\t    });\n328\t  }\n329\t  /** settle one step between two fighters (E.Match calls it after both update): hits (both may land: a trade), shots\n330\t   *  against each other and against the fighters, push boxes apart */\n331\t  static exchange(a, b) {\n332\t    const hits = (p, q) => { const h = p.boxes && p.boxes.hit; if (!h || q.inv > 0 || q.thrown || q.ko || q.down > 0 || (q.air && q.juggle >= 3)) return null; return q.boxes.hurt.find(u => overlap(h, u)) ? h : null; };\n333\t    const ha = hits(a, b), hb = hits(b, a), ma = ha && a.act.m, mb = hb && b.act.m;   // (a trade: both land)\n334\t    if (ha) a._lands(b, ma, ha.x + ha.w / 2, ha.z + ha.h / 2);\n335\t    if (hb) b._lands(a, mb, hb.x + hb.w / 2, hb.z + hb.h / 2);\n336\t    for (const s of a.shots.list) for (const t of b.shots.list) if (!s.dead && !t.dead && Math.abs(s.x - t.x) < s.r + t.r && Math.abs(s.z - t.z) < s.r + t.r) { s.dead = t.dead = true; a.game.particles.sparks((s.x + t.x) / 2, 0, s.z, 12, null, { color: '#ffffff' }); a.game.audio.sfx('bump'); }\n337\t    for (const [p, q] of [[a, b], [b, a]]) for (const s of p.shots.list) {\n338\t      if (s.dead || q.inv > 0 || q.thrown || q.ko || q.down > 0) continue;\n339\t      const sb = { x: s.x - s.r, z: s.z - s.r, w: s.r * 2, h: s.r * 2 };\n340\t      if (q.boxes.hurt.some(u => overlap(sb, u))) { s.dead = true; const m = Object.assign({ id: s.data.id, dmg: 60, guard: 'mid', stun: 18, block: 14, push: 90, chip: .25, frames: s.data.frames, atk: s.data.atk }, s.data.shot); p._lands(q, m, s.x, s.z); }\n341\t    }\n342\t    for (const p of [a, b]) E.prune(p.shots.list, s => s.dead);\n343\t    // push boxes: never inside each other (a wall keeps one where it is)\n344\t    const A = a.body, B = b.body, need = (A.w + B.w) / 2, dx = B.x - A.x;\n345\t    if (Math.abs(dx) < need && A.z < B.z + B.h && B.z < A.z + A.h && !a.thrown && !b.thrown) {\n346\t      const d = (need - Math.abs(dx)) * (dx >= 0 ? 1 : -1) / 2, st = a._level;\n347\t      A.x -= d; B.x += d;\n348\t      if (st) for (const [P, Q, s] of [[A, B, 1], [B, A, -1]]) { if (P.x - P.w / 2 < st.x0) { const k = st.x0 + P.w / 2 - P.x; P.x += k; Q.x += k; } if (P.x + P.w / 2 > st.x1) { const k = P.x + P.w / 2 - st.x1; P.x -= k; Q.x -= k; } }\n349\t    }\n350\t  }\n351\t}\n352\tE.Fighter = Fighter;\n353\t\n354\tclass FightAI {"}]},"parent_tool_use_id":null,"session_id":"6ff8a465-a3dc-4463-ad61-3d7e016e47ef","uuid":"c9bc97a4-c02a-4f85-9815-6b03dcc7222c","timestamp":"2026-11-04T00:54:30.311Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/plan-x8534bd-wzXO/engine/my-3d2dge/dist/handoff/modules/fight.js","content":"      const mv = ctl.move(), press = BTN.filter(k => ctl.map[k] && ctl.buffered(k, .1));\n      return { x: mv[0] * this.facing, y: mv[1], sx: mv[0], press, do: null, input: ctl };\n    }\n    return { x: (ctl.x || 0) * this.facing, y: ctl.y || 0, sx: ctl.x || 0, press: ctl.press ? [ctl.press] : [], do: ctl.do || null };\n  }\n  // the special this step's input calls for (motion or charge, a super first while the meter has it), or null\n  _special(c) {\n    let best = null;\n    for (const id in this.moves) {\n      const m = this.moves[id]; if (!m.motion && !m.charge) continue;\n      if (m.meter && this.meter < m.meter) continue;\n      if (m.shot && this.shots.list.length) continue;\n      let ok = false;\n      if (c.do) ok = c.do === id;\n      else if (m.motion && c.input) ok = c.input.motion(m.motion, m.btn, { facing: this.facing, window: m.window || (m.motion.length > 4 ? .8 : .45) });\n      else if (m.charge && c.press.includes(m.btn)) ok = m.charge === '46' ? this._chB >= (m.time || .7) && c.x > .5 : this._chD >= (m.time || .7) && c.y < -.5;\n      if (ok && (!best || (m.meter || 0) > (best.meter || 0) || (m.motion || '').length > (best.motion || '').length)) best = m;\n    }\n    return best;\n  }\n  // the normal for a button in this state: air, crouching, close, standing\n  _normal(btn, close) {\n    const air = !this.body.onGround, list = Object.values(this.moves).filter(m => m.btn === btn && !m.motion && !m.charge);\n    if (air) return list.find(m => m.when === 'air') || null;\n    if (this.crouch) return list.find(m => m.when === 'crouch') || null;\n    return (close && list.find(m => m.when === 'close')) || list.find(m => m.when === 'stand') || null;\n  }\n  // start move m: its Attack from the top, its invulnerability, its travel at the active frames\n  _start(m) {\n    if (this.act) this.act.m.atk.cancel();\n    m.atk.start(); this.act = { m, hit: false, blocked: false, fired: false, moved: false };\n    if (m.inv) this.inv = Math.max(this.inv, sec(m.inv));\n    if (m.meter) { this.meter -= m.meter; this.game.flash('#ffffff', .1, .6); this.game.freeze(.2); this.game.audio.sfx('charge'); }   // a super: its cost, a flash, the world holds its breath\n    if (!this.body.onGround) this._airUsed = true;\n    this.game.audio.sfx(m.motion || m.charge ? 'whoosh' : 'select', { pitch: m.btn === 'hp' || m.btn === 'hk' ? .8 : 1.1 });\n  }\n  /** move one step (once a step, 120 times a second): ctl is its E.Input (this.input by default) or a CPU's intent */\n  update(dt, ctl = this.input) {\n    const b = this.body, foe = this.foe;\n    if (foe && this.free && foe.x !== this.x) this.facing = foe.x > this.x ? 1 : -1;   // it faces its foe (sides switch on a cross-up)\n    const c = this._read(ctl); this._t += dt; this.inv -= dt; this._c = c;\n    // charges: back or down held, kept a quarter second after letting go\n    if (c.x < -.5) { this._chB += dt; this._gB = .25; } else if ((this._gB -= dt) <= 0) this._chB = 0;\n    if (c.y > .5) { this._chD += dt; this._gD = .25; } else if ((this._gD -= dt) <= 0) this._chD = 0;\n    if (!this.ko && !this.thrown) { const s = this._special(c); if (s) this._want = { m: s, t: .12 }; }   // a motion stays wanted for a moment\n    if (this._want && (this._want.t -= dt) <= 0) this._want = null;\n    let ix = 0;\n    if (this.thrown) this._thrownStep(dt);\n    else if (this.ko || this.win) { if (b.onGround && this.ko) this.down = 1; }\n    else if (this.down > 0) { if ((this.down -= dt) <= 0) { this.rise = .45; this.inv = Math.max(this.inv, .6); } }\n    else if (this.rise > 0) { this.rise -= dt; }\n    else if (this.stun > 0) { if ((this.stun -= dt) <= 0) { this.kind = null; if (b.onGround) this.combo = 0; } }\n    else if (this.air) { if (b.onGround) { this.air = false; this.down = .55; this.combo = 0; this.juggle = 0; b.vx = 0; this.game.shake(2); this.game.audio.sfx('land'); } }   // flying from a hit, then down\n    else {\n      const close = foe && Math.abs(foe.x - this.x) < this.o.throwRange * 1.6;\n      if (this.act) {   // a move playing: a special may cancel it once it connects (until early in its recovery)\n        const a = this.act, st = a.m.atk; if (this._want && a.m.cancel && (a.hit || a.blocked) && (st.phase !== 'recover' || st.u < .4) && !a.m.motion) { this._start(this._want.m); this._want = null; }\n      } else if (b.onGround && this.free) {\n        this.crouch = c.y > .5;\n        const thr = this.o.throwBtn;\n        if (this._want) { this._start(this._want.m); if (c.input && this._want.m.btn) c.input.consume(this._want.m.btn); this._want = null; }\n        else if (c.press.includes(thr) && Math.abs(c.x) > .5 && foe && foe._throwable() && Math.abs(foe.x - this.x) < this.o.throwRange) this._throw(c.x > 0 ? 1 : -1);\n        else { for (const k of c.press) { const m = this._normal(k, close); if (m) { this._start(m); if (c.input) c.input.consume(k); break; } } }\n        if (!this.act && !this.crouch && c.y < -.5) {   // a jump: straight, forward or back\n          b.vz = this.o.jump; b.vx = Math.sign(Math.round(c.sx)) * this.o.jumpX; b.onGround = false; this._airUsed = false; this.game.audio.sfx('jump');\n        } else if (!this.act && !this.crouch) {   // walking, or holding back to guard as an attack comes\n          const back = c.x < -.5, threat = foe && (foe.act && foe.act.m.atk.phase !== 'recover' || foe.shots.list.length) && Math.abs(foe.x - this.x) < 110;\n          this.blocking = back && threat;\n          if (!this.blocking && Math.abs(c.x) > .5) { b.run = back ? this.o.back : this.o.walk; ix = Math.sign(c.sx); }\n        }\n        if (this.crouch) this.blocking = c.x < -.5;\n      } else if (!b.onGround && !this.act && !this._airUsed) {   // a jump's one attack\n        for (const k of c.press) { const m = this._normal(k, false); if (m) { this._start(m); if (c.input) c.input.consume(k); break; } }\n      }\n    }\n    if (!this.free) this.blocking = this.stun > 0 && this.kind === 'block';\n    // the move: its phases, its shot and travel at the active frames\n    if (this.act) {\n      const a = this.act, m = a.m, began = m.atk.update(dt);\n      if (began === 'active') {\n        if (m.shot && !a.fired) this._fire(m);\n        if ((m.vx || m.vz) && !a.moved) { if (m.vx) { b.vx = this.facing * m.vx; if (!m.vz) b.stun = m.atk.spec.active + m.atk.spec.recover * .5; } if (m.vz) { b.vz = m.vz; b.onGround = false; } a.moved = true; }\n        if (m.teleport && foe) { b.x = foe.x + this.facing * m.teleport; this.facing = -this.facing; this.game.particles.sparks(b.x, 0, 40, 10, null, { color: '#c8a0ff' }); }\n        if (m.throw && foe && foe._throwable() && Math.abs(foe.x - this.x) < (m.range || this.o.throwRange)) this._throw(1, m);\n      }\n      if (!m.atk.busy) { this.act = null; if (b.onGround) this._airUsed = false; }\n    }\n    if (b.onGround && !this.air && this.act && !this.act.m.vx && !this.act.moved) b.vx = approach(b.vx, 0, 1600 * dt);\n    if (!this.thrown) b.update(dt, this._level, { x: ix });\n    if (b.landed && this.act && (this.act.m.when === 'air' || this.act.m.vz)) { this.act.m.atk.cancel(); this.act = null; }   // a jump's attack ends on landing\n    if (b.landed) this._airUsed = false;\n    this.shots.update(dt);\n    this._lag = Math.max(this.life / this.o.life, this._lag - dt * .4);\n    this._rig(dt);\n  }\n  _throwable() { return !this.ko && this.body.onGround && !this.air && this.stun <= 0 && this.down <= 0 && this.rise <= 0 && this.inv <= 0 && !this.thrown && !(this.act && this.act.m.atk.phase === 'active'); }\n  // grab the foe: dir 1 throws it forward, -1 behind; m: a command grab's spec\n  _throw(dir, m) {\n    const foe = this.foe; if (!m) this._start(this._throwM);\n    foe.thrown = { by: this, t: 0, dur: .45, dir: dir * this.facing, dmg: m ? m.dmg : this.o.throwDmg, x0: foe.x }; foe.act = null; foe.combo = 0;\n    this.game.audio.sfx('swing');\n  }\n  _thrownStep(dt) {\n    const T = this.thrown, b = this.body, by = T.by, u = clamp((T.t += dt) / T.dur, 0, 1), x1 = by.x + T.dir * 28;\n    b.x = lerp(T.x0, x1, u); b.z = Math.sin(u * PI) * 50; b.vx = b.vz = 0;\n    if (u >= 1) {\n      this.thrown = null; b.z = 0; this.life -= T.dmg; this.down = .7; this.inv = .3; this.facing = by.x > b.x ? 1 : -1;\n      this.game.hitFx(b.x, 0, 8, { power: 2, color: '#ffe070', sound: 'kick' }); this.game.shake(4);\n      by.meter = Math.min(100 * (by.o.bars || 1), by.meter + 15);\n      if (this.life <= 0) { this.life = 0; this.ko = true; }\n    }\n  }\n  _fire(m) {\n    const s = m.shot, h = this.rig.hand('R');\n    this.shots.fire({ x: h[0] + this.facing * 6, y: 0, z: h[2], vx: this.facing * (s.speed || 150), r: s.r || 7, life: s.life || 3, color: s.color || '#60c8ff', core: s.core || '#ffffff', team: this.name, data: m });\n    this.act.fired = true; this.game.audio.sfx('laser');\n  }\n  // the rig from the state: guard, crouch, block, hurt, flying, down, getting up, the move, the win pose\n  _rig(dt) {\n    const b = this.body, st = this.act && this.act.m.atk.state, fly = (this.air || this.ko) && !b.onGround;\n    this.rig.update(dt, Object.assign(b.rigState(), {\n      facing: this.facing > 0 ? 0 : PI, vx: this.stun > 0 || this.act ? 0 : b.vx, air: !b.onGround && !this.air && !this.thrown,\n      stance: this.free && !this.blocking ? 'guard' : null, hurt: (this.stun > 0 && this.kind === 'hit') || !!this.thrown,\n      down: fly ? clamp(.6 - b.vz / 500, 0, 1) : undefined, attack: st,\n      pose: this.win ? 'cheer' : this.down > 0 || (this.ko && b.onGround) ? 'down' : this.rise > .2 ? 'kneel' : this.rise > 0 || this.crouch ? 'crouch' : this.blocking ? 'block' : null,\n      expr: this.win ? 'smile' : this.stun > 0 || this.ko ? 'wince' : st ? 'shout' : null }));\n    this._boxes();\n  }\n  // its boxes this step, from the rig's joints: hurt (head, body, legs), hit (the striking fist or foot), push\n  _boxes() {\n    const r = this.rig, J = r.J, sz = r.o.size, P = k => { const w = r.worldOffset(J[k]); return [r.x + w[0], r.z + w[2]]; };\n    const box = (pts, pad) => { let x0 = 1e9, x1 = -1e9, z0 = 1e9, z1 = -1e9; for (const [x, z] of pts) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); z0 = Math.min(z0, z); z1 = Math.max(z1, z); } return { x: x0 - pad, z: z0 - pad, w: x1 - x0 + pad * 2, h: z1 - z0 + pad * 2 }; };\n    const hd = P('head'), hurt = [box([hd], 3.2 * sz), box([P('shC'), P('hipC'), P('shL'), P('shR')], 2.4 * sz), box([P('hipC'), P('kneeL'), P('kneeR'), P('footL'), P('footR')], 1.6 * sz)];\n    let hit = null; const a = this.act;\n    if (a && !a.hit && !a.blocked && a.m.atk.active && !a.m.shot && !a.m.throw && !a.m.teleport) {\n      const s = a.m.atk.spec, p = s.kick ? P('footR') : P(s.hand === 'L' ? 'handL' : 'handR'), R = a.m.r * sz / 2;\n      hit = { x: p[0] - R, z: p[1] - R, w: R * 2, h: R * 2 };\n    }\n    /** boxes: this step's boxes ({ hurt: [head, body, legs], hit: the striking fist or foot's, or null, push }: each\n     *  { x, z, w, h }, x its left, z its bottom) */\n    const b = this.body; this.boxes = { hurt, hit, push: { x: b.x - b.w / 2, z: b.z, w: b.w, h: b.h } };\n  }\n  // does it block move m now: holding back, on the ground, and low moves crouching, overheads standing\n  _blocks(m) {\n    if (m.guard === 'throw' || !this.body.onGround || this.air || this.stun > 0 && this.kind === 'hit' || this.act || this.down > 0 || this.ko) return false;\n    if (!(this._c && this._c.x < -.5)) return false;\n    return m.guard === 'low' ? this.crouch : m.guard === 'overhead' ? !this.crouch : true;\n  }\n  // this fighter's move m lands on the foe at (x, z): blocked or a hit (a shot passes its own spec as m)\n  _lands(foe, m, x, z) {\n    const g = this.game, dir = foe.x > this.x ? 1 : foe.x < this.x ? -1 : this.facing, a = this.act, bars = 100 * (this.o.bars || 1);\n    if (a && a.m === m) a.hit = true;\n    const rec = a && a.m === m ? Math.max(0, frames(m.atk.spec.recover) + frames(m.atk.spec.active * (1 - m.atk.u))) : 0;\n    if (foe._blocks(m)) {\n      if (a && a.m === m) { a.blocked = true; a.hit = false; }\n      foe.stun = sec(m.block); foe.kind = 'block'; foe.life = Math.max(1, foe.life - Math.round(m.dmg * m.chip)); foe.body.vx = dir * m.push * .8; foe.body.stun = foe.stun;\n      this.meter = Math.min(bars, this.meter + m.dmg * .06); foe.meter = Math.min(100 * (foe.o.bars || 1), foe.meter + m.dmg * .04);\n      g.particles.impact(x, 0, z, 6, '#a0d8ff'); g.particles.sparks(x, 0, z, 5, null, { color: '#a0d8ff' }); g.audio.sfx('bump'); g.freeze(.04);\n      this.last = { id: m.id, startup: m.frames[0], active: m.frames[1], recovery: m.frames[2], adv: m.block - rec, on: 'block' };\n      return;\n    }\n    const scale = Math.max(.5, 1 - foe.combo * .1), dmg = Math.round(m.dmg * scale);\n    foe.combo++; foe.life -= dmg; foe.act && foe.act.m.atk.cancel(); foe.act = null; foe.crouch = false;\n    this.meter = Math.min(bars, this.meter + m.dmg * .12); foe.meter = Math.min(100 * (foe.o.bars || 1), foe.meter + m.dmg * .06);\n    const lift = foe.life <= 0 ? Math.max(m.launch || 0, 260) : m.launch || ((m.down || !foe.body.onGround || foe.air) ? 200 : 0);\n    if (lift) { foe.air = true; foe.juggle++; foe.body.knock(dir, foe.life <= 0 ? 150 : 70, lift, 1); foe.stun = 0; foe.kind = 'hit'; }\n    else { foe.stun = sec(m.stun); foe.kind = 'hit'; foe.body.vx = dir * m.push; foe.body.stun = foe.stun; }\n    if (foe.life <= 0) { foe.life = 0; foe.ko = true; }\n    const heavy = m.dmg >= 70; g.hitFx(x, 0, z, { power: heavy ? 1.8 : 1.1, angle: dir > 0 ? 0 : PI, color: '#ffe070', sound: heavy ? 'kick' : 'punch' });\n    this.last = { id: m.id, startup: m.frames[0], active: m.frames[1], recovery: m.frames[2], adv: lift ? null : m.stun - rec, on: 'hit' };\n  }\n  /** draw it (and its shots) in the scene: r.actor with its rig */\n  draw(r) {\n    const b = this.body;\n    r.actor(b.x, 0, b.z, (g, ox, oy) => this.rig.draw(g, ox, oy, r.view));\n    for (const s of this.shots.list) r.queue(s.x, 0, s.z, g => {   // an energy ball: a glow, a bright core, a flickering trail\n      const [x, y] = r.w(s.x, 0, s.z), R = s.r * r.view.scale, f = Math.floor(s.t * 30) % 2;\n      px.glow(g, 1); for (let k = 3; k > 0; k--) px.disc(g, x - Math.sign(s.vx) * k * R * .7, y, R * (1 - k * .2), E.shade(s.color, -.2 * k));\n      px.disc(g, x, y, R + f, s.color); px.disc(g, x, y, R * .55, s.core);\n    }, { bias: .5, emissive: true });\n  }\n  /** the boxes drawn (training): hurt green, hit red, push blue */\n  drawBoxes(r) {\n    const B = this.boxes; if (!B) return;\n    r.overlay(g => {\n      const out = (b, c) => { const [x0, y0] = r.w(b.x, 0, b.z + b.h), [x1, y1] = r.w(b.x + b.w, 0, b.z); const x = Math.round(x0), y = Math.round(y0), w = Math.round(x1 - x0), h = Math.round(y1 - y0); px.rect(g, x, y, w, 1, c); px.rect(g, x, y + h - 1, w, 1, c); px.rect(g, x, y, 1, h, c); px.rect(g, x + w - 1, y, 1, h, c); };\n      out(B.push, '#4a8aff'); for (const h of B.hurt) out(h, this.inv > 0 ? '#ffffff' : '#4ad860'); if (B.hit) out(B.hit, '#ff4a4a');\n    });\n  }\n  /** settle one step between two fighters (E.Match calls it after both update): hits (both may land: a trade), shots\n   *  against each other and against the fighters, push boxes apart */\n  static exchange(a, b) {\n    const hits = (p, q) => { const h = p.boxes && p.boxes.hit; if (!h || q.inv > 0 || q.thrown || q.ko || q.down > 0 || (q.air && q.juggle >= 3)) return null; return q.boxes.hurt.find(u => overlap(h, u)) ? h : null; };\n    const ha = hits(a, b), hb = hits(b, a), ma = ha && a.act.m, mb = hb && b.act.m;   // (a trade: both land)\n    if (ha) a._lands(b, ma, ha.x + ha.w / 2, ha.z + ha.h / 2);\n    if (hb) b._lands(a, mb, hb.x + hb.w / 2, hb.z + hb.h / 2);\n    for (const s of a.shots.list) for (const t of b.shots.list) if (!s.dead && !t.dead && Math.abs(s.x - t.x) < s.r + t.r && Math.abs(s.z - t.z) < s.r + t.r) { s.dead = t.dead = true; a.game.particles.sparks((s.x + t.x) / 2, 0, s.z, 12, null, { color: '#ffffff' }); a.game.audio.sfx('bump'); }\n    for (const [p, q] of [[a, b], [b, a]]) for (const s of p.shots.list) {\n      if (s.dead || q.inv > 0 || q.thrown || q.ko || q.down > 0) continue;\n      const sb = { x: s.x - s.r, z: s.z - s.r, w: s.r * 2, h: s.r * 2 };\n      if (q.boxes.hurt.some(u => overlap(sb, u))) { s.dead = true; const m = Object.assign({ id: s.data.id, dmg: 60, guard: 'mid', stun: 18, block: 14, push: 90, chip: .25, frames: s.data.frames, atk: s.data.atk }, s.data.shot); p._lands(q, m, s.x, s.z); }\n    }\n    for (const p of [a, b]) E.prune(p.shots.list, s => s.dead);\n    // push boxes: never inside each other (a wall keeps one where it is)\n    const A = a.body, B = b.body, need = (A.w + B.w) / 2, dx = B.x - A.x;\n    if (Math.abs(dx) < need && A.z < B.z + B.h && B.z < A.z + A.h && !a.thrown && !b.thrown) {\n      const d = (need - Math.abs(dx)) * (dx >= 0 ? 1 : -1) / 2, st = a._level;\n      A.x -= d; B.x += d;\n      if (st) for (const [P, Q, s] of [[A, B, 1], [B, A, -1]]) { if (P.x - P.w / 2 < st.x0) { const k = st.x0 + P.w / 2 - P.x; P.x += k; Q.x += k; } if (P.x + P.w / 2 > st.x1) { const k = P.x + P.w / 2 - st.x1; P.x -= k; Q.x -= k; } }\n    }\n  }\n}\nE.Fighter = Fighter;\n\nclass FightAI {","numLines":215,"startLine":140,"totalLines":551}},"tool_result_meta":[{"id":"toolu_01XfRJw3MqWzxuicbEN4ywn3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
