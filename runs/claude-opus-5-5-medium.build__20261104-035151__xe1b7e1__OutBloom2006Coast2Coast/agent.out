e', freq: 2093, dur: .3, vol: .12, delay: .05 }],\n  shutter: [{ wave: 'noise', freq: 4000, dur: .03, vol: .35 }, { wave: 'noise', freq: 2500, dur: .03, vol: .3, delay: .06 }, { wave: 'sine', freq: 1800, to: 3000, dur: .15, vol: .08, delay: .06 }],\n  beep: { wave: 'square', freq: 660, dur: .14, vol: .2 },\n  go: [{ wave: 'square', freq: 1320, dur: .5, vol: .22, hold: true }, { wave: 'square', freq: 1980, dur: .5, vol: .1, hold: true }],\n  whoosh: [{ wave: 'noise', freq: 600, to: 3000, dur: .35, vol: .3 }],\n  tick: { wave: 'square', freq: 1500, dur: .03, vol: .12 },\n  heartbeat: [{ wave: 'sine', freq: 70, to: 45, dur: .12, vol: .5 }, { wave: 'sine', freq: 65, to: 40, dur: .1, vol: .35, delay: .18 }],\n  zing: [{ wave: 'saw', freq: 1800, to: 900, dur: .16, vol: .12 }, { wave: 'noise', freq: 5000, dur: .1, vol: .1 }],\n  sparkle: { wave: 'sine', freq: 1568, arp: [0, 7, 12, 16, 19, 24, 28], step: .045, dur: .4, vol: .14 },\n  crowd: [{ wave: 'noise', freq: 1200, dur: 1.2, vol: .22, q: .6 }, { wave: 'noise', freq: 2400, dur: .9, vol: .12, delay: .2 }],\n  thunk: [{ wave: 'sine', freq: 160, to: 60, dur: .16, vol: .45 }, { wave: 'noise', freq: 500, dur: .1, vol: .25, filter: 'lowpass' }],\n  squeal: [{ wave: 'triangle', freq: 1300, to: 700, dur: .6, vol: .14, vib: [18, .04] }],\n  scrape: [{ wave: 'noise', freq: 2500, dur: .25, vol: .22 }, { wave: 'square', freq: 3000, dur: .02, vol: .05, delay: .1 }],\n  splash: [{ wave: 'noise', freq: 900, to: 200, dur: .6, vol: .4, filter: 'lowpass' }],\n  backfire: [{ wave: 'noise', freq: 400, dur: .07, vol: .4, filter: 'lowpass' }, { wave: 'noise', freq: 300, dur: .06, vol: .3, filter: 'lowpass', delay: .09 }],\n  shift: [{ wave: 'noise', freq: 900, dur: .05, vol: .12, filter: 'lowpass' }],\n  hornA: [{ wave: 'square', freq: 392, dur: .32, vol: .14, hold: true }, { wave: 'square', freq: 494, dur: .32, vol: .12, hold: true }],\n  hornB: [{ wave: 'square', freq: 330, dur: .3, vol: .14, hold: true }, { wave: 'square', freq: 415, dur: .3, vol: .12, hold: true }],\n  honk: [{ wave: 'square', freq: 290, dur: .2, vol: .1, hold: true }],\n  thump: [{ wave: 'sine', freq: 90, to: 40, dur: .3, vol: .4 }],\n  crackle: [{ wave: 'noise', freq: 6000, dur: .5, vol: .1, filter: 'highpass' }],\n  air: [{ wave: 'sine', freq: 300, to: 700, dur: .3, vol: .08 }],\n  land: [{ wave: 'sine', freq: 120, to: 50, dur: .18, vol: .45 }, { wave: 'noise', freq: 400, dur: .12, vol: .2, filter: 'lowpass' }],\n  focus: { wave: 'square', freq: 990, dur: .03, vol: .07 },\n  ok: { wave: 'square', freq: 784, arp: [0, 7, 12], step: .045, dur: .15, vol: .16 },\n  back: { wave: 'square', freq: 520, to: 330, dur: .1, vol: .14 },\n  error: [{ wave: 'square', freq: 200, dur: .1, vol: .16 }, { wave: 'square', freq: 160, dur: .12, vol: .16, delay: .1 }],\n  toggle: { wave: 'square', freq: 1200, dur: .03, vol: .1 },\n  slide: { wave: 'triangle', freq: 1000, dur: .02, vol: .08 },\n  plant: [{ wave: 'sine', freq: 300, to: 600, dur: .1, vol: .3 }, { wave: 'sine', freq: 1568, arp: [0, 4, 7, 12], step: .06, dur: .3, vol: .12, delay: .15 }],\n  static: [{ wave: 'noise', freq: 3000, dur: .3, vol: .12, q: .3 }],\n  gust: [{ wave: 'noise', freq: 400, to: 1400, dur: .9, vol: .25, q: .5 }],\n  cash: [{ wave: 'square', freq: 1568, dur: .05, vol: .1 }, { wave: 'square', freq: 2093, dur: .08, vol: .1, delay: .05 }]\n};\nOB.SFX = SFX;\nOB.Sound = {\n  init() { const a = A(); if (!a) return; for (const k in SFX) a.define('ob:' + k, SFX[k]); },\n  play(name, o = {}) { const a = A(); if (!a || OB.env.headless) return; if (OB.Sound.mutedFx) return; a.sfx('ob:' + name, o); },\n  sting(name) { const a = A(); if (!a || OB.env.headless) return; const j = OB.JINGLES[name]; if (j) a.sting(j, { duck: .45 }); }\n};\n\n/* ---- engine notes, tyres, wind, ambience: continuous loops ---- */\nclass CarSound {\n  constructor(car, vol = 1) {\n    const a = A(); this.car = car; this.vol = vol; this.L = [];\n    if (!a || OB.env.headless || !a.loop) return;\n    const c = OB.CARS[car.model];\n    this.eng = a.loop({ voices: [{ wave: 'saw', mul: 1, vol: .22 }, { wave: 'saw', mul: 2, vol: .1, detune: 8 }, { wave: 'square', mul: .5, vol: .14 }].concat(c.hybrid ? [{ wave: 'sine', mul: 6, vol: .05 }] : []), lowpass: 900 });\n    this.tyre = a.loop({ voices: [{ wave: 'triangle', mul: 1, vol: .2 }, { wave: 'triangle', mul: 1.34, vol: .14 }], lowpass: 3000 });\n    this.wind = a.loop({ noise: { filter: 'bandpass', freq: 900, q: .6, vol: .5, direct: true } });\n    this.L = [this.eng, this.tyre, this.wind]; this.cyl = c.cyl; this.tone = c.tone; this.lastRpm = 0;\n  }\n  update(dt, gas, tunnel) {\n    if (!this.eng) return;\n    const c = this.car, f = Math.max(30, c.rpm / 60 * this.cyl / 2) * (c.crash.t > 0 ? .7 : 1), paused = OB.game.paused;\n    this.eng.set({ freq: f, vol: paused ? 0 : (.09 + .07 * gas) * this.vol * (tunnel ? 1.35 : 1), lowpass: 500 + this.tone * (.3 + .7 * gas) }, .05);\n    const sq = Math.min(1, Math.abs(c.drift.a) * 1.6 + (c.scrape ? .5 : 0)) * (c.v > 60 ? 1 : 0);\n    this.tyre.set({ freq: 1000 + Math.sin(OB.game.time * 37) * 90, vol: paused ? 0 : sq * .07 * this.vol }, .04);\n    const w = Math.min(1, c.v / 300);\n    this.wind.set({ vol: paused ? 0 : w * w * .09 * this.vol * (c.slip > .5 ? .4 : 1), noiseFreq: c.slip > .5 ? 500 : 900 + w * 900 }, .1);\n    if (this.lastRpm > 6000 && c.rpm < this.lastRpm - 900 && gas < .1 && !OB.FX.reduce()) OB.Sound.play('backfire', { vol: .6 * this.vol });\n    this.lastRpm = c.rpm;\n  }\n  stop(f = .3) { for (const l of this.L) l.stop(f); this.L = []; this.eng = null; }\n}\nOB.CarSound = CarSound;\nconst AMB = { beach: { filter: 'lowpass', freq: 500, vol: .08 }, lagoon: { filter: 'lowpass', freq: 600, vol: .07 }, lake: { filter: 'lowpass', freq: 400, vol: .05 }, fields: { filter: 'highpass', freq: 5000, vol: .02 }, vineyard: { filter: 'highpass', freq: 6000, vol: .03 }, canyon: { filter: 'highpass', freq: 6500, vol: .03 }, nightcity: { filter: 'lowpass', freq: 250, vol: .06 }, jungle: { filter: 'bandpass', freq: 3500, vol: .03 } };\nOB.Ambience = {\n  cur: null, kit: null,\n  set(kit) {\n    if (this.kit === kit) return; this.kit = kit; const a = A(); if (!a || OB.env.headless || !a.loop) return;\n    if (this.cur) this.cur.stop(1.5);\n    const s = AMB[kit]; if (!s) { this.cur = null; return; }\n    this.cur = a.loop({ noise: { filter: s.filter, freq: s.freq, q: .7, vol: 1, direct: true } }); this.base = s.vol; this.cur.set({ vol: s.vol }, 1.5);\n  },\n  update(t) { if (this.cur && (this.kit === 'beach' || this.kit === 'lagoon')) this.cur.set({ vol: OB.game.paused ? 0 : this.base * (.6 + .4 * Math.sin(t * .7)) }, .3); else if (this.cur) this.cur.set({ vol: OB.game.paused ? 0 : this.base }, .3); },\n  stop() { if (this.cur) this.cur.stop(.5); this.cur = null; this.kit = null; }\n};\n\n/* ---- the radio ---- */\nOB.Radio = {\n  i: 0, song: null, duckT: 0,\n  available() { const p = OB.Profile.p; return OB.STATIONS.map((s, i) => i).filter(i => p.unlocked.songs.includes(i)); },\n  tune(i, o = {}) {\n    const st = OB.STATIONS[i]; if (!st) return; this.i = i; this.song = OB.SONGS[st.song];\n    OB.Sound.play('static', { vol: .6 });\n    const a = A(); if (a) a.music(this.song, { fade: o.fade === undefined ? .4 : o.fade, restart: o.restart });\n    OB.bus.emit('radio:tune', { i, name: st.name, song: this.song.name });\n  },\n  next() { const av = this.available(), k = av.indexOf(this.i); this.tune(av[(k + 1) % av.length], { fade: 1 }); },\n  theme(name) { const a = A(); if (a && OB.SONGS[name]) a.music(OB.SONGS[name], { fade: .6 }); },\n  bloom(on) { const a = A(); if (a && a.song) a.layer('sparkle', on ? 1 : 0, 1); },\n  duck(t) { this.duckT = Math.max(this.duckT, t); },\n  update(dt) {\n    const a = A(); if (!a) return; const base = OB.game.settings.music;\n    if (this.duckT > 0) { this.duckT -= dt; a.musicVolume = base * .6; } else a.musicVolume = base;\n    a.applyVolume();\n  }\n};\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01CTaVKeY6a7xDJuM3hztpmK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cghon2yB5VGTtxPhdi7vs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JoJkFABPkt5GiXUEb6hW2y","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/31-voice.js","content":"/* Voices (PLAN §7.16): Animalese / Simlish-style babble. The text is split into syllables (a consonant onset and a\n * vowel); each is synthesised as a buzzy source through two formant filters set by its vowel, at a pitch that follows\n * the line's intonation (statements fall, questions rise, \"!\" lifts), coloured by the character and the mood.\n * plan(text, who, mood) is pure (tests run it headless); say() schedules it on Web Audio. Subtitles always show. */\n(() => {\n'use strict';\nconst OB = window.OB, E = OB.E;\nconst VOWELS = { a: [800, 1200], e: [500, 1900], i: [300, 2300], o: [500, 900], u: [350, 800], y: [300, 2300] };\nconst PLOSIVE = 'pbtdkgcq', FRIC = 'szfvhxj', NASAL = 'mnlrw';\nconst MOODS = { happy: { st: 3, rate: 1, spread: 1.3 }, excited: { st: 5, rate: 1.2, spread: 1.2 }, angry: { st: -2, rate: 1, spread: .8, loud: 1.3 }, sad: { st: -4, rate: .8, spread: .7, breath: .3 }, scared: { st: 6, rate: 1.1, spread: 1, trem: 1 } };\nOB.Voice = {\n  /** the plan: { syllables: [{ t, dur, f0, F1, F2, onset, vol }], duration } */\n  plan(text, who = 'marisol', mood = 'happy') {\n    const v = (OB.CAST[who] && OB.CAST[who].voice) || { f0: 200, fmt: 1, rate: 12 }, md = MOODS[mood] || MOODS.happy;\n    const rng = OB.rand.stream('voice:' + text, 5), out = [];\n    const words = String(text).split(/(\\s+|[,.!?…]+)/).filter(s => s && s.trim().length);\n    const question = /\\?\\s*$/.test(text), exclaim = /!/.test(text);\n    let t = 0;\n    const sylls = [];\n    for (const w of words) {\n      if (/^[,.!?…]+$/.test(w)) { sylls.push({ pause: w.includes('…') || w.includes('...') ? .3 : w.includes(',') ? .08 : .16 }); continue; }\n      const caps = w.length > 1 && w === w.toUpperCase() && /[A-Z]/.test(w), lw = w.toLowerCase().replace(/[^a-z']/g, '');\n      const re = /([^aeiouy]*)([aeiouy]+)/g; let m, n = 0;\n      while ((m = re.exec(lw))) { sylls.push({ onset: m[1].slice(-1) || '', vowel: m[2][0], shout: caps }); n++; }\n      if (!n && lw) sylls.push({ onset: lw[0], vowel: 'u', shout: caps });\n    }\n    const N = sylls.filter(s => !s.pause).length; let k = 0;\n    const rate = v.rate * md.rate, base = v.f0 * Math.pow(2, md.st / 12);\n    for (const s of sylls) {\n      if (s.pause) { t += s.pause / md.rate; continue; }\n      const u = N > 1 ? k / (N - 1) : 0;\n      let contour = question ? -.1 + u * .5 : (exclaim ? .25 : .1) - u * .35;\n      if (exclaim && k === 0) contour += .2;\n      const f0 = base * Math.pow(2, (contour * md.spread * 4 + (rng() - .5) * 1.6 + (s.shout ? 2 : 0)) / 12);\n      const [F1, F2] = VOWELS[s.vowel] || VOWELS.a, fmt = v.fmt || 1;\n      const dur = (1 / rate) * (.8 + rng() * .4) * (v.swoop && s.vowel === 'a' ? 1.5 : 1);\n      out.push({ t: +t.toFixed(3), dur: +dur.toFixed(3), f0: Math.round(f0), F1: Math.round(F1 * fmt), F2: Math.round(F2 * fmt), onset: PLOSIVE.includes(s.onset) ? 'plosive' : FRIC.includes(s.onset) ? 'fric' : NASAL.includes(s.onset) ? 'nasal' : '', vol: (md.loud || 1) * (s.shout ? 1.4 : 1) });\n      t += dur * .92; k++;\n    }\n    return { syllables: out, duration: +t.toFixed(3) };\n  },\n  /** speak a line: returns its length in seconds (also headless, from the plan) */\n  say(text, who, mood, o = {}) {\n    const p = this.plan(text, who, mood), a = OB.game && OB.game.audio;\n    if (o.silent || OB.env.headless || !a || !a._init || !a._init() || a.muted || a.ctx.state !== 'running') return p.duration;\n    const c = a.ctx, now = c.currentTime + .02, v = (OB.CAST[who] && OB.CAST[who].voice) || {}, md = MOODS[mood] || MOODS.happy;\n    if (!this.bus) { this.bus = c.createGain(); this.bus.connect(a._sfxBus); }\n    this.bus.gain.value = (OB.game.settings.voices !== undefined ? OB.game.settings.voices : .8) * .9;\n    OB.Radio && OB.Radio.duck(p.duration + .3);\n    try {\n      for (const s of p.syllables) {\n        const t0 = now + s.t, t1 = t0 + s.dur, osc = c.createOscillator(), g = c.createGain();\n        if (v.wave === 'pulse') osc.setPeriodicWave(a._pulse(.25)); else osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(s.f0 * (s.onset === 'nasal' ? .92 : 1), t0); osc.frequency.linearRampToValueAtTime(s.f0, t0 + .03); osc.frequency.linearRampToValueAtTime(s.f0 * .97, t1);\n        if (md.trem) { const l = c.createOscillator(), lg = c.createGain(); l.frequency.value = 22; lg.gain.value = s.f0 * .04; l.connect(lg); lg.connect(osc.frequency); l.start(t0); l.stop(t1 + .02); }\n        for (const [F, q, amt] of [[s.F1, 6, 1], [s.F2, 9, .6]]) { const bp = c.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = F; bp.Q.value = q; const bg = c.createGain(); bg.gain.value = amt; osc.connect(bp); bp.connect(bg); bg.connect(g); }\n        const vol = .5 * s.vol;\n        g.gain.setValueAtTime(0, t0); g.gain.linearRampToValueAtTime(vol, t0 + .012); g.gain.setValueAtTime(vol, t1 - .025); g.gain.linearRampToValueAtTime(0, t1);\n        g.connect(this.bus); osc.start(t0); osc.stop(t1 + .02);\n        if (s.onset === 'plosive' || s.onset === 'fric' || v.rasp || md.breath) {\n          const n = c.createBufferSource(), f = c.createBiquadFilter(), ng = c.createGain(), long = s.onset === 'fric' ? .04 : .012;\n          n.buffer = a._noise; f.type = 'bandpass'; f.frequency.value = s.onset === 'fric' ? 5000 : 3000; f.Q.value = 1.2;\n          ng.gain.setValueAtTime(.25 * s.vol, t0); ng.gain.linearRampToValueAtTime(0, t0 + (v.rasp || md.breath ? s.dur : long));\n          n.connect(f); f.connect(ng); ng.connect(this.bus); n.start(t0); n.stop(t0 + s.dur + .02);\n        }\n      }\n    } catch (e) { /* sound unavailable */ }\n    return p.duration;\n  }\n};\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9374,"cache_read_input_tokens":424604,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9374},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b31a73a4-a38b-4945-9f7b-620b7871a8e6","uuid":"a4aa1f05-9801-4325-b795-245fbb9681f2","timestamp":"2026-11-04T11:28:19.318Z","request_id":"req_011Cghon2fKf7z43UwcnsBF4","wire_tool_inputs":{"toolu_01JoJkFABPkt5GiXUEb6hW2y":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/31-voice.js","content":"/* Voices (PLAN §7.16): Animalese / Simlish-style babble. The text is split into syllables (a consonant onset and a\n * vowel); each is synthesised as a buzzy source through two formant filters set by its vowel, at a pitch that follows\n * the line's intonation (statements fall, questions rise, \"!\" lifts), coloured by the character and the mood.\n * plan(text, who, mood) is pure (tests run it headless); say() schedules it on Web Audio. Subtitles always show. */\n(() => {\n'use strict';\nconst OB = window.OB, E = OB.E;\nconst VOWELS = { a: [800, 1200], e: [500, 1900], i: [300, 2300], o: [500, 900], u: [350, 800], y: [300, 2300] };\nconst PLOSIVE = 'pbtdkgcq', FRIC = 'szfvhxj', NASAL = 'mnlrw';\nconst MOODS = { happy: { st: 3, rate: 1, spread: 1.3 }, excited: { st: 5, rate: 1.2, spread: 1.2 }, angry: { st: -2, rate: 1, spread: .8, loud: 1.3 }, sad: { st: -4, rate: .8, spread: .7, breath: .3 }, scared: { st: 6, rate: 1.1, spread: 1, trem: 1 } };\nOB.Voice = {\n  /** the plan: { syllables: [{ t, dur, f0, F1, F2, onset, vol }], duration } */\n  plan(text, who = 'marisol', mood = 'happy') {\n    const v = (OB.CAST[who] && OB.CAST[who].voice) || { f0: 200, fmt: 1, rate: 12 }, md = MOODS[mood] || MOODS.happy;\n    const rng = OB.rand.stream('voice:' + text, 5), out = [];\n    const words = String(text).split(/(\\s+|[,.!?…]+)/).filter(s => s && s.trim().length);\n    const question = /\\?\\s*$/.test(text), exclaim = /!/.test(text);\n    let t = 0;\n    const sylls = [];\n    for (const w of words) {\n      if (/^[,.!?…]+$/.test(w)) { sylls.push({ pause: w.includes('…') || w.includes('...') ? .3 : w.includes(',') ? .08 : .16 }); continue; }\n      const caps = w.length > 1 && w === w.toUpperCase() && /[A-Z]/.test(w), lw = w.toLowerCase().replace(/[^a-z']/g, '');\n      const re = /([^aeiouy]*)([aeiouy]+)/g; let m, n = 0;\n      while ((m = re.exec(lw))) { sylls.push({ onset: m[1].slice(-1) || '', vowel: m[2][0], shout: caps }); n++; }\n      if (!n && lw) sylls.push({ onset: lw[0], vowel: 'u', shout: caps });\n    }\n    const N = sylls.filter(s => !s.pause).length; let k = 0;\n    const rate = v.rate * md.rate, base = v.f0 * Math.pow(2, md.st / 12);\n    for (const s of sylls) {\n      if (s.pause) { t += s.pause / md.rate; continue; }\n      const u = N > 1 ? k / (N - 1) : 0;\n      let contour = question ? -.1 + u * .5 : (exclaim ? .25 : .1) - u * .35;\n      if (exclaim && k === 0) contour += .2;\n      const f0 = base * Math.pow(2, (contour * md.spread * 4 + (rng() - .5) * 1.6 + (s.shout ? 2 : 0)) / 12);\n      const [F1, F2] = VOWELS[s.vowel] || VOWELS.a, fmt = v.fmt || 1;\n      const dur = (1 / rate) * (.8 + rng() * .4) * (v.swoop && s.vowel === 'a' ? 1.5 : 1);\n      out.push({ t: +t.toFixed(3), dur: +dur.toFixed(3), f0: Math.round(f0), F1: Math.round(F1 * fmt), F2: Math.round(F2 * fmt), onset: PLOSIVE.includes(s.onset) ? 'plosive' : FRIC.includes(s.onset) ? 'fric' : NASAL.includes(s.onset) ? 'nasal' : '', vol: (md.loud || 1) * (s.shout ? 1.4 : 1) });\n      t += dur * .92; k++;\n    }\n    return { syllables: out, duration: +t.toFixed(3) };\n  },\n  /** speak a line: returns its length in seconds (also headless, from the plan) */\n  say(text, who, mood, o = {}) {\n    const p = this.plan(text, who, mood), a = OB.game && OB.game.audio;\n    if (o.silent || OB.env.headless || !a || !a._init || !a._init() || a.muted || a.ctx.state !== 'running') return p.duration;\n    const c = a.ctx, now = c.currentTime + .02, v = (OB.CAST[who] && OB.CAST[who].voice) || {}, md = MOODS[mood] || MOODS.happy;\n    if (!this.bus) { this.bus = c.createGain(); this.bus.connect(a._sfxBus); }\n    this.bus.gain.value = (OB.game.settings.voices !== undefined ? OB.game.settings.voices : .8) * .9;\n    OB.Radio && OB.Radio.duck(p.duration + .3);\n    try {\n      for (const s of p.syllables) {\n        const t0 = now + s.t, t1 = t0 + s.dur, osc = c.createOscillator(), g = c.createGain();\n        if (v.wave === 'pulse') osc.setPeriodicWave(a._pulse(.25)); else osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(s.f0 * (s.onset === 'nasal' ? .92 : 1), t0); osc.frequency.linearRampToValueAtTime(s.f0, t0 + .03); osc.frequency.linearRampToValueAtTime(s.f0 * .97, t1);\n        if (md.trem) { const l = c.createOscillator(), lg = c.createGain(); l.frequency.value = 22; lg.gain.value = s.f0 * .04; l.connect(lg); lg.connect(osc.frequency); l.start(t0); l.stop(t1 + .02); }\n        for (const [F, q, amt] of [[s.F1, 6, 1], [s.F2, 9, .6]]) { const bp = c.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = F; bp.Q.value = q; const bg = c.createGain(); bg.gain.value = amt; osc.connect(bp); bp.connect(bg); bg.connect(g); }\n        const vol = .5 * s.vol;\n        g.gain.setValueAtTime(0, t0); g.gain.linearRampToValueAtTime(vol, t0 + .012); g.gain.setValueAtTime(vol, t1 - .025); g.gain.linearRampToValueAtTime(0, t1);\n        g.connect(this.bus); osc.start(t0); osc.stop(t1 + .02);\n        if (s.onset === 'plosive' || s.onset === 'fric' || v.rasp || md.breath) {\n          const n = c.createBufferSource(), f = c.createBiquadFilter(), ng = c.createGain(), long = s.onset === 'fric' ? .04 : .012;\n          n.buffer = a._noise; f.type = 'bandpass'; f.frequency.value = s.onset === 'fric' ? 5000 : 3000; f.Q.value = 1.2;\n          ng.gain.setValueAtTime(.25 * s.vol, t0); ng.gain.linearRampToValueAtTime(0, t0 + (v.rasp || md.breath ? s.dur : long));\n          n.connect(f); f.connect(ng); ng.connect(this.bus); n.start(t0); n.stop(t0 + s.dur + .02);\n        }\n      }\n    } catch (e) { /* sound unavailable */ }\n    return p.duration;\n  }\n};\n})();\n"}}}
