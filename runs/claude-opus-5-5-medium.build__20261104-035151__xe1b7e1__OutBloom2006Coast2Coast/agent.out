urn R;\n  },\n  /** advance a rig: pose, expression, facing, walking speed */\n  pose(R, dt, st) { if (!R || !R.rig) return; Object.assign(R.state, st); R.t += dt; try { R.rig.update(dt, R.state); } catch (e) { /* a pose this rig lacks */ } },\n  /** a live portrait: the rig's own close-up, framed */\n  portrait(g, id, x, y, size, o = {}) {\n    const R = OB.Cast.rig(id, o.outfit || 0); if (!R.rig) { px.disc(g, x + size / 2, y + size / 2, size / 2, (OB.CAST[id] || {}).color || '#888'); return; }\n    if (o.expr) R.state.expr = o.expr;\n    try { R.rig.drawPortrait(g, x, y, size, { zoom: o.zoom || 2.6, turn: o.turn !== undefined ? o.turn : .35, bg: o.bg === undefined ? (OB.CAST[id].color ? E.shade(OB.CAST[id].color, -.45) : '#2a1450') : o.bg, frame: o.frame !== false }); }\n    catch (e) { px.disc(g, x + size / 2, y + size / 2, size / 2, '#888'); }\n  },\n  /** draw a rig into a scratch canvas and paste it scaled at (sx, sy) on screen: hUnits tall in world units */\n  paste(g, R, sx, sy, k, hUnits, view) {\n    if (!R || !R.rig || !view) return;\n    const ph = hUnits * k; if (ph < 3) return;\n    const cv = R.cv || (R.cv = E.mkCanvas(96, 112)), cg = E.ctx2d(cv);\n    if (!cg || !cg.clearRect) return;\n    cg.clearRect(0, 0, 96, 112);\n    try { R.rig.draw(cg, 48, 104, view); } catch (e) { return; }\n    const s = ph / 70, w = 96 * s, h = 112 * s;\n    g.drawImage(cv, Math.round(sx - w / 2), Math.round(sy - h * (104 / 112)), Math.max(1, Math.round(w)), Math.max(1, Math.round(h)));\n  },\n  tickAll(dt) { for (const k in rigs) { const R = rigs[k]; if (R.rig && R.live) OB.Cast.pose(R, dt, {}); } }\n};\n\n/** Bruno at the roadside: a flag on a pole, waved overhead in a loop until GO, then a cheer */\nOB.brunoObj = (race, stage, z) => ({ stage, z, x: -1.55, draw(g, X, Y, k, c) {\n  const R = OB.Cast.rig('bruno'), t = c.t, go = race.phase !== 'countdown';\n  OB.Cast.pose(R, 1 / 60, { facing: 0, pose: go ? 'cheer' : null, expr: go ? 'shout' : 'smile', point: !go, aim: !go ? .9 + Math.sin(t * 7) * .6 : 0 });\n  OB.Cast.paste(g, R, X, Y, k, 1900, OB.game && OB.game.view);\n  // the sunflower flag over his raised arm, waving\n  if (k * 1900 > 6) {\n    const a = !go ? Math.sin(t * 7) * .8 : Math.sin(t * 12) * .3, hx = X + 120 * k, hy = Y - 1900 * k, tx = hx + Math.sin(a) * 900 * k, ty = hy - Math.cos(a) * 900 * k;\n    px.line(g, hx, hy, tx, ty, '#6a4a2a', Math.max(1, 30 * k));\n    const wv = Math.sin(t * 14) * 80 * k;\n    px.poly(g, [[tx, ty], [tx + 700 * k, ty + wv], [tx + 650 * k, ty + 450 * k + wv], [tx, ty + 420 * k]], '#f8d020');\n    px.disc(g, tx + 330 * k, ty + 220 * k + wv / 2, 130 * k, '#6a3a1a');\n  }\n} });\n/** spectators by the start grid: the cast's colours, waving */\nOB.fanObj = (stage, z, x, seed) => ({ stage, z, x, draw(g, X, Y, k, c) { OB.ART.crowd.draw(g, X, Y, k, { t: c.t, seed }); } });\n\n/** a car in side view (endings, the garage): pointing right, wheels turning by roll */\nOB.drawCarSide = function (g, x, y, s, model, paint, o = {}) {\n  const car = OB.CARS[model] || OB.CARS.orchidea, t = E.tones(paint || car.paint), L = 92 * s, H = 16 * s, roll = o.roll || 0;\n  px.blend(g, .35, 'multiply', () => px.ell(g, x + L / 2, y, L * .55, 3 * s, '#20202a'));\n  const low = car.look === 'wedge' || car.look === 'hyper';\n  px.poly(g, [[x, y - 6 * s], [x + 4 * s, y - H], [x + L * .3, y - H - (low ? 0 : 2 * s)], [x + L * .62, y - H], [x + L * .9, y - H * .8], [x + L, y - 8 * s], [x + L, y - 4 * s], [x, y - 4 * s]], t.base);\n  px.poly(g, [[x + 2 * s, y - H + 2 * s], [x + L * .9, y - H * .8 + 1 * s], [x + L * .9, y - H * .8 + 3 * s], [x + 2 * s, y - H + 4 * s]], t.lt);\n  px.rect(g, x, y - 6 * s, L, 2 * s, t.sh);\n  px.poly(g, [[x + L * .55, y - H], [x + L * .62, y - H - 7 * s], [x + L * .64, y - H - 7 * s], [x + L * .6, y - H]], '#a8d8f0');\n  if (car.hoops) px.rect(g, x + L * .34, y - H - 6 * s, 3 * s, 6 * s, '#c8c8d0');\n  for (const wx of [x + L * .2, x + L * .8]) { px.disc(g, wx, y - 4 * s, 7 * s, '#1a1a20'); px.disc(g, wx, y - 4 * s, 4 * s, '#c8c8d0'); px.line(g, wx, y - 4 * s, wx + Math.cos(roll) * 4 * s, y - 4 * s + Math.sin(roll) * 4 * s, '#6a6a70'); }\n  px.rect(g, x + L - 3 * s, y - 11 * s, 3 * s, 3 * s, '#fff4c0'); px.rect(g, x, y - 11 * s, 2 * s, 3 * s, '#e83020');\n  if (o.people) for (const [i, id] of o.people.entries()) { const hx = x + L * (.4 + i * .12), hd = OB.CAST[id] && OB.CAST[id].head; if (!hd) continue; px.disc(g, hx, y - H - 5 * s, 3.4 * s, hd.skin); px.disc(g, hx - .6 * s, y - H - 6 * s, 3.4 * s, hd.color); }\n};\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01AEmVza39wLCWC6ax9LYwbj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghogGqwHyNaYejtNRv9C","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QokSSgmc9P7ug18Q3hjWTW","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/14-fx.js","content":"/* Screen effects (PLAN §7.2): particles in screen space (tyre smoke, petals, sparks, dust, spray, confetti, fireworks),\n * the night grade with emissive glows drawn after it, the pixel bloom (bright pixels summed into a quarter grid,\n * blurred, quantised and added back through an ordered dither: it never blurs the pixel art), the lens flare, speed\n * lines, a sun-shower's rain and a petal storm. Cosmetic only: their own random stream. */\n(() => {\n'use strict';\nconst OB = window.OB, E = OB.E, { px } = E;\nconst rnd = E.rng(0xB100);\nconst BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + .5) / 16);\nOB.FX = {\n  parts: [],\n  reduce() { return !!(OB.game && OB.game.reduceMotion); },\n  emit(kind, x, y, n = 1, o = {}) {\n    if (OB.env.headless) return;\n    for (let i = 0; i < n; i++) {\n      const p = { kind, x: x + (rnd() - .5) * (o.spread || 6), y: y + (rnd() - .5) * (o.spreadY || o.spread || 4), vx: (o.vx || 0) + (rnd() - .5) * (o.vs || 30), vy: (o.vy || 0) + (rnd() - .5) * (o.vs || 30), life: 0, max: (o.life || .8) * (.7 + rnd() * .6), size: (o.size || 2) * (.7 + rnd() * .6), color: o.color || (o.colors ? o.colors[Math.floor(rnd() * o.colors.length)] : '#ffffff'), g: o.g || 0, spin: rnd() * 6, vp: o.vp };\n      this.parts.push(p);\n    }\n    if (this.parts.length > 900) this.parts.splice(0, this.parts.length - 900);\n  },\n  step(dt) { for (const p of this.parts) { p.life += dt; p.x += p.vx * dt; p.y += p.vy * dt; p.vy += p.g * dt; p.spin += dt * 5; } this.parts = this.parts.filter(p => p.life < p.max); },\n  clear() { this.parts = []; },\n  draw(g, vp) {\n    for (const p of this.parts) {\n      if (p.vp !== undefined && vp && p.vp !== vp.i) continue;\n      const u = p.life / p.max, a = 1 - u;\n      if (p.kind === 'smoke' || p.kind === 'dust' || p.kind === 'spray') { const r = p.size * (1 + u * 2.5); px.blend(g, a * (p.kind === 'smoke' ? .55 : .5), 'normal', () => px.disc(g, p.x, p.y, r, p.color)); }\n      else if (p.kind === 'spark') px.blend(g, a, 'add', () => px.rect(g, p.x, p.y, Math.max(1, p.size), 1, p.color));\n      else if (p.kind === 'petal') { const w = Math.max(1, Math.round(Math.abs(Math.cos(p.spin)) * p.size)); px.rect(g, p.x, p.y, w, Math.max(1, p.size * .7), p.color); }\n      else if (p.kind === 'confetti') { const w = Math.max(1, Math.round(Math.abs(Math.cos(p.spin)) * p.size)); px.rect(g, p.x, p.y, w, p.size, p.color); }\n      else if (p.kind === 'star') px.blend(g, a, 'add', () => { px.rect(g, p.x - p.size, p.y, p.size * 2 + 1, 1, p.color); px.rect(g, p.x, p.y - p.size, 1, p.size * 2 + 1, p.color); });\n      else if (p.kind === 'flame') px.blend(g, a, 'add', () => px.disc(g, p.x, p.y, p.size * (1 - u * .5), u < .4 ? '#fff0a0' : '#ff7a20'));\n      else if (p.kind === 'text') E.font.text(g, p.text, Math.round(p.x), Math.round(p.y), p.color, { align: 'center', shadow: '#000', outline: false });\n    }\n  },\n  text(x, y, text, color, vp) { if (OB.env.headless) return; this.parts.push({ kind: 'text', x, y, vx: 0, vy: -22, life: 0, max: 1.1, text, color, g: 0, vp }); },\n  /** the night grade (multiply) then every glow collected while drawing, added back */\n  grade(g, vp, tod, glows, tunnel) {\n    const night = tod.night || 0;\n    if (tod.grade) px.blend(g, night ? .55 + .35 * night : .25, 'multiply', () => px.rect(g, vp.x, vp.y, vp.w, vp.h, tod.grade));\n    if (tunnel) px.blend(g, .55, 'multiply', () => px.rect(g, vp.x, vp.y, vp.w, vp.h, '#806a58'));\n    for (const [x, y, r, c, a, kind, s] of glows) {\n      if (kind === 'pool') { if (!night && !tunnel) continue; px.blend(g, .22 * a, 'add', () => px.ell(g, x, y, r, Math.max(1, r * .25), c)); continue; }\n      if (!night && !tunnel && kind !== 'lamp' && a < .85 && r > 20) continue;\n      const rr = Math.max(1, r * (night || tunnel ? 1 : .5));\n      px.blend(g, .18 * a, 'add', () => px.disc(g, x, y, rr, c));\n      px.blend(g, .3 * a, 'add', () => px.disc(g, x, y, Math.max(1, rr * .45), c));\n    }\n  },\n  /** the pixel bloom: quarter-resolution bright sums, two box blurs, 4 levels, added back through a Bayer dither */\n  bloom(g, vp, strength, tint) {\n    if (OB.env.headless || strength <= 0 || !g.getImageData) return;\n    const W = Math.floor(vp.w / 4), H = Math.floor(vp.h / 4); if (W < 4 || H < 4) return;\n    let img; try { img = g.getImageData(vp.x, vp.y, W * 4, H * 4); } catch (e) { return; }\n    const d = img.data, grid = new Float32Array(W * H), th = 200;\n    for (let y = 0; y < H * 4; y += 2) for (let x = 0; x < W * 4; x += 2) { const i = (y * W * 4 + x) * 4, l = d[i] * .3 + d[i + 1] * .59 + d[i + 2] * .11; if (l > th) grid[(y >> 2) * W + (x >> 2)] += (l - th) / 55 / 4; }\n    const tmp = new Float32Array(W * H);\n    for (let pass = 0; pass < 2; pass++) {\n      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) { let s = 0, n = 0; for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) { const xx = x + dx, yy = y + dy; if (xx >= 0 && yy >= 0 && xx < W && yy < H) { s += grid[yy * W + xx]; n++; } } tmp[y * W + x] = s / n; }\n      grid.set(tmp);\n    }\n    const tc = E.hex(tint || '#fff0d0');\n    g.save(); g.globalCompositeOperation = 'lighter';\n    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n      const v = Math.min(1, grid[y * W + x] * strength * 2.2); if (v < .08) continue;\n      const q = Math.round(v * 4) / 4;\n      for (let sy = 0; sy < 4; sy++) for (let sx = 0; sx < 4; sx++) if (q > BAYER[(sy & 3) * 4 + (sx & 3)] * 1.6) { g.fillStyle = `rgb(${tc[0] * .35 | 0},${tc[1] * .32 | 0},${tc[2] * .26 | 0})`; g.fillRect(vp.x + x * 4 + sx, vp.y + y * 4 + sy, 1, 1); }\n    }\n    g.restore(); px.reset(g);\n  },\n  /** the lens flare: ghosts along the line from the sun through the screen's centre */\n  flare(g, vp, sun, k) {\n    if (!sun || k <= 0) return;\n    const sx = vp.x + sun.x * vp.w, sy = vp.y + sun.y * vp.h, cx = vp.x + vp.w / 2, cy = vp.y + vp.h / 2;\n    const cols = ['#ffe0a0', '#a0ffd0', '#ffa0e0', '#a0c0ff', '#fff0c0'], sizes = [7, 4, 10, 3, 14], at = [.3, .55, .8, 1.1, 1.4];\n    for (let i = 0; i < 5; i++) { const x = sx + (cx - sx) * at[i] * 2, y = sy + (cy - sy) * at[i] * 2; px.blend(g, .12 * k, 'add', () => i % 2 ? px.disc(g, x, y, sizes[i], cols[i]) : px.poly(g, [0, 1, 2, 3, 4, 5].map(j => [x + Math.cos(j * 1.047) * sizes[i], y + Math.sin(j * 1.047) * sizes[i]]), cols[i])); }\n  },\n  speedLines(g, vp, k, t) {\n    if (k <= 0 || this.reduce()) return;\n    const cx = vp.x + vp.w / 2, cy = vp.y + vp.h * .45;\n    px.blend(g, .35 * k, 'add', () => { for (let i = 0; i < 14; i++) { const a = i * 2.39 + Math.floor(t * 20) * .7, r0 = vp.w * (.42 + (i % 3) * .05), r1 = r0 + 24 + 30 * k; px.line(g, cx + Math.cos(a) * r0, cy + Math.sin(a) * r0 * .6, cx + Math.cos(a) * r1, cy + Math.sin(a) * r1 * .6, '#ffffff'); } });\n  },\n  rain(g, vp, t, amt) {\n    if (this.reduce()) amt *= .4;\n    px.blend(g, .45, 'normal', () => { for (let i = 0; i < 70 * amt; i++) { const x = vp.x + ((i * 97.3 + t * 40) % vp.w), y = vp.y + ((i * 53.1 + t * 380) % vp.h); px.line(g, x, y, x - 2, y + 6, '#d8e8ff'); } });\n  },\n  petalStorm(g, vp, t, amt) {\n    const cs = ['#ffc0d8', '#ffffff', '#ff90b8'];\n    for (let i = 0; i < 60 * amt; i++) { const x = vp.x + ((i * 71.7 - t * 90 + Math.sin(t + i) * 20) % vp.w + vp.w) % vp.w, y = vp.y + ((i * 37.3 + t * 70) % vp.h); px.rect(g, x, y, 2, 1, cs[i % 3]); }\n  },\n  heat(g, vp, t) {\n    if (OB.env.headless || this.reduce() || !g.canvas) return;\n    const y0 = Math.round(vp.y + vp.h * .38), h = Math.round(vp.h * .12);\n    for (let y = 0; y < h; y += 2) { const off = Math.round(Math.sin(t * 9 + y * .7)); if (off) try { g.drawImage(g.canvas, vp.x, y0 + y, vp.w, 2, vp.x + off, y0 + y, vp.w, 2); } catch (e) { return; } }\n  }\n};\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3731,"cache_read_input_tokens":420873,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3731},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b31a73a4-a38b-4945-9f7b-620b7871a8e6","uuid":"6cecab18-fc36-47bf-8c71-a8cece133541","timestamp":"2026-11-04T11:27:03.526Z","request_id":"req_011CghogGbK4suDTCSnattpS","wire_tool_inputs":{"toolu_01QokSSgmc9P7ug18Q3hjWTW":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/14-fx.js","content":"/* Screen effects (PLAN §7.2): particles in screen space (tyre smoke, petals, sparks, dust, spray, confetti, fireworks),\n * the night grade with emissive glows drawn after it, the pixel bloom (bright pixels summed into a quarter grid,\n * blurred, quantised and added back through an ordered dither: it never blurs the pixel art), the lens flare, speed\n * lines, a sun-shower's rain and a petal storm. Cosmetic only: their own random stream. */\n(() => {\n'use strict';\nconst OB = window.OB, E = OB.E, { px } = E;\nconst rnd = E.rng(0xB100);\nconst BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + .5) / 16);\nOB.FX = {\n  parts: [],\n  reduce() { return !!(OB.game && OB.game.reduceMotion); },\n  emit(kind, x, y, n = 1, o = {}) {\n    if (OB.env.headless) return;\n    for (let i = 0; i < n; i++) {\n      const p = { kind, x: x + (rnd() - .5) * (o.spread || 6), y: y + (rnd() - .5) * (o.spreadY || o.spread || 4), vx: (o.vx || 0) + (rnd() - .5) * (o.vs || 30), vy: (o.vy || 0) + (rnd() - .5) * (o.vs || 30), life: 0, max: (o.life || .8) * (.7 + rnd() * .6), size: (o.size || 2) * (.7 + rnd() * .6), color: o.color || (o.colors ? o.colors[Math.floor(rnd() * o.colors.length)] : '#ffffff'), g: o.g || 0, spin: rnd() * 6, vp: o.vp };\n      this.parts.push(p);\n    }\n    if (this.parts.length > 900) this.parts.splice(0, this.parts.length - 900);\n  },\n  step(dt) { for (const p of this.parts) { p.life += dt; p.x += p.vx * dt; p.y += p.vy * dt; p.vy += p.g * dt; p.spin += dt * 5; } this.parts = this.parts.filter(p => p.life < p.max); },\n  clear() { this.parts = []; },\n  draw(g, vp) {\n    for (const p of this.parts) {\n      if (p.vp !== undefined && vp && p.vp !== vp.i) continue;\n      const u = p.life / p.max, a = 1 - u;\n      if (p.kind === 'smoke' || p.kind === 'dust' || p.kind === 'spray') { const r = p.size * (1 + u * 2.5); px.blend(g, a * (p.kind === 'smoke' ? .55 : .5), 'normal', () => px.disc(g, p.x, p.y, r, p.color)); }\n      else if (p.kind === 'spark') px.blend(g, a, 'add', () => px.rect(g, p.x, p.y, Math.max(1, p.size), 1, p.color));\n      else if (p.kind === 'petal') { const w = Math.max(1, Math.round(Math.abs(Math.cos(p.spin)) * p.size)); px.rect(g, p.x, p.y, w, Math.max(1, p.size * .7), p.color); }\n      else if (p.kind === 'confetti') { const w = Math.max(1, Math.round(Math.abs(Math.cos(p.spin)) * p.size)); px.rect(g, p.x, p.y, w, p.size, p.color); }\n      else if (p.kind === 'star') px.blend(g, a, 'add', () => { px.rect(g, p.x - p.size, p.y, p.size * 2 + 1, 1, p.color); px.rect(g, p.x, p.y - p.size, 1, p.size * 2 + 1, p.color); });\n      else if (p.kind === 'flame') px.blend(g, a, 'add', () => px.disc(g, p.x, p.y, p.size * (1 - u * .5), u < .4 ? '#fff0a0' : '#ff7a20'));\n      else if (p.kind === 'text') E.font.text(g, p.text, Math.round(p.x), Math.round(p.y), p.color, { align: 'center', shadow: '#000', outline: false });\n    }\n  },\n  text(x, y, text, color, vp) { if (OB.env.headless) return; this.parts.push({ kind: 'text', x, y, vx: 0, vy: -22, life: 0, max: 1.1, text, color, g: 0, vp }); },\n  /** the night grade (multiply) then every glow collected while drawing, added back */\n  grade(g, vp, tod, glows, tunnel) {\n    const night = tod.night || 0;\n    if (tod.grade) px.blend(g, night ? .55 + .35 * night : .25, 'multiply', () => px.rect(g, vp.x, vp.y, vp.w, vp.h, tod.grade));\n    if (tunnel) px.blend(g, .55, 'multiply', () => px.rect(g, vp.x, vp.y, vp.w, vp.h, '#806a58'));\n    for (const [x, y, r, c, a, kind, s] of glows) {\n      if (kind === 'pool') { if (!night && !tunnel) continue; px.blend(g, .22 * a, 'add', () => px.ell(g, x, y, r, Math.max(1, r * .25), c)); continue; }\n      if (!night && !tunnel && kind !== 'lamp' && a < .85 && r > 20) continue;\n      const rr = Math.max(1, r * (night || tunnel ? 1 : .5));\n      px.blend(g, .18 * a, 'add', () => px.disc(g, x, y, rr, c));\n      px.blend(g, .3 * a, 'add', () => px.disc(g, x, y, Math.max(1, rr * .45), c));\n    }\n  },\n  /** the pixel bloom: quarter-resolution bright sums, two box blurs, 4 levels, added back through a Bayer dither */\n  bloom(g, vp, strength, tint) {\n    if (OB.env.headless || strength <= 0 || !g.getImageData) return;\n    const W = Math.floor(vp.w / 4), H = Math.floor(vp.h / 4); if (W < 4 || H < 4) return;\n    let img; try { img = g.getImageData(vp.x, vp.y, W * 4, H * 4); } catch (e) { return; }\n    const d = img.data, grid = new Float32Array(W * H), th = 200;\n    for (let y = 0; y < H * 4; y += 2) for (let x = 0; x < W * 4; x += 2) { const i = (y * W * 4 + x) * 4, l = d[i] * .3 + d[i + 1] * .59 + d[i + 2] * .11; if (l > th) grid[(y >> 2) * W + (x >> 2)] += (l - th) / 55 / 4; }\n    const tmp = new Float32Array(W * H);\n    for (let pass = 0; pass < 2; pass++) {\n      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) { let s = 0, n = 0; for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) { const xx = x + dx, yy = y + dy; if (xx >= 0 && yy >= 0 && xx < W && yy < H) { s += grid[yy * W + xx]; n++; } } tmp[y * W + x] = s / n; }\n      grid.set(tmp);\n    }\n    const tc = E.hex(tint || '#fff0d0');\n    g.save(); g.globalCompositeOperation = 'lighter';\n    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n      const v = Math.min(1, grid[y * W + x] * strength * 2.2); if (v < .08) continue;\n      const q = Math.round(v * 4) / 4;\n      for (let sy = 0; sy < 4; sy++) for (let sx = 0; sx < 4; sx++) if (q > BAYER[(sy & 3) * 4 + (sx & 3)] * 1.6) { g.fillStyle = `rgb(${tc[0] * .35 | 0},${tc[1] * .32 | 0},${tc[2] * .26 | 0})`; g.fillRect(vp.x + x * 4 + sx, vp.y + y * 4 + sy, 1, 1); }\n    }\n    g.restore(); px.reset(g);\n  },\n  /** the lens flare: ghosts along the line from the sun through the screen's centre */\n  flare(g, vp, sun, k) {\n    if (!sun || k <= 0) return;\n    const sx = vp.x + sun.x * vp.w, sy = vp.y + sun.y * vp.h, cx = vp.x + vp.w / 2, cy = vp.y + vp.h / 2;\n    const cols = ['#ffe0a0', '#a0ffd0', '#ffa0e0', '#a0c0ff', '#fff0c0'], sizes = [7, 4, 10, 3, 14], at = [.3, .55, .8, 1.1, 1.4];\n    for (let i = 0; i < 5; i++) { const x = sx + (cx - sx) * at[i] * 2, y = sy + (cy - sy) * at[i] * 2; px.blend(g, .12 * k, 'add', () => i % 2 ? px.disc(g, x, y, sizes[i], cols[i]) : px.poly(g, [0, 1, 2, 3, 4, 5].map(j => [x + Math.cos(j * 1.047) * sizes[i], y + Math.sin(j * 1.047) * sizes[i]]), cols[i])); }\n  },\n  speedLines(g, vp, k, t) {\n    if (k <= 0 || this.reduce()) return;\n    const cx = vp.x + vp.w / 2, cy = vp.y + vp.h * .45;\n    px.blend(g, .35 * k, 'add', () => { for (let i = 0; i < 14; i++) { const a = i * 2.39 + Math.floor(t * 20) * .7, r0 = vp.w * (.42 + (i % 3) * .05), r1 = r0 + 24 + 30 * k; px.line(g, cx + Math.cos(a) * r0, cy + Math.sin(a) * r0 * .6, cx + Math.cos(a) * r1, cy + Math.sin(a) * r1 * .6, '#ffffff'); } });\n  },\n  rain(g, vp, t, amt) {\n    if (this.reduce()) amt *= .4;\n    px.blend(g, .45, 'normal', () => { for (let i = 0; i < 70 * amt; i++) { const x = vp.x + ((i * 97.3 + t * 40) % vp.w), y = vp.y + ((i * 53.1 + t * 380) % vp.h); px.line(g, x, y, x - 2, y + 6, '#d8e8ff'); } });\n  },\n  petalStorm(g, vp, t, amt) {\n    const cs = ['#ffc0d8', '#ffffff', '#ff90b8'];\n    for (let i = 0; i < 60 * amt; i++) { const x = vp.x + ((i * 71.7 - t * 90 + Math.sin(t + i) * 20) % vp.w + vp.w) % vp.w, y = vp.y + ((i * 37.3 + t * 70) % vp.h); px.rect(g, x, y, 2, 1, cs[i % 3]); }\n  },\n  heat(g, vp, t) {\n    if (OB.env.headless || this.reduce() || !g.canvas) return;\n    const y0 = Math.round(vp.y + vp.h * .38), h = Math.round(vp.h * .12);\n    for (let y = 0; y < h; y += 2) { const off = Math.round(Math.sin(t * 9 + y * .7)); if (off) try { g.drawImage(g.canvas, vp.x, y0 + y, vp.w, 2, vp.x + off, y0 + y, vp.w, 2); } catch (e) { return; } }\n  }\n};\n})();\n"}}}
