ringify(snap().race));\nconsole.log('errors', game.errors.map(e => e.message || e).slice(0,5));\nEOF\nnode /tmp/ob_boot.mjs 2>&1 | head -40","description":"Patch overrides, write dev page, boot headless"}}}
