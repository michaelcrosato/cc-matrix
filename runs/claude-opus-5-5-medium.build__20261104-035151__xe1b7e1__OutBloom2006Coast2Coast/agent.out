{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghnPckBA69jCxKjx9wgR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CU3di4zQ4Qg9ajJKVDL2tF","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/11-art.js","content":"/* Roadside art (PLAN §9.4): every piece of scenery, landmark, span, arch and sign, drawn in world units by code with\n * E.px and shaded with E.tones, so it scales cleanly with distance. OB.ART[name] = { w (half roads it blocks),\n * solid, draw(g, sx, sy, k, o) } where (sx, sy) is its foot on screen and k the pixels per world unit. Engine props\n * (E.prop) are used for the generic plants and furniture. */\n(() => {\n'use strict';\nconst OB = window.OB, E = OB.E, { px } = E;\nconst T = c => E.tones(c);\n// unit-space helpers: x across from the foot, y up from the ground, both in world units\nconst R = (g, sx, sy, k, x, y, w, h, c) => { const W = w * k, H = h * k; if (W < .4 && H < .4) return; px.rect(g, Math.round(sx + x * k), Math.round(sy - (y + h) * k), Math.max(1, Math.round(W)), Math.max(1, Math.round(H)), c); };\nconst D = (g, sx, sy, k, x, y, r, c) => { if (r * k < .5) return px.dot(g, sx + x * k, sy - y * k, c); px.disc(g, sx + x * k, sy - y * k, r * k, c); };\nconst PL = (g, sx, sy, k, pts, c) => px.poly(g, pts.map(([x, y]) => [sx + x * k, sy - y * k]), c);\nconst TX = (g, s, sx, sy, k, x, y, c, size) => { const sc = Math.max(1, Math.floor(size * k / 7)); if (size * k < 5) return; E.font.text(g, s, Math.round(sx + x * k), Math.round(sy - y * k), c, { align: 'center', scale: sc, outline: false }); };\nconst PROPS = {};\nconst prop = (name, o) => { const key = name + JSON.stringify(o || {}); if (!PROPS[key]) { try { PROPS[key] = E.prop(name, o || {}).frames[0]; } catch (e) { PROPS[key] = null; } } return PROPS[key]; };\nconst SPR = (g, spr, sx, sy, k, hUnits, flip) => { if (!spr || !spr.cv) return; const sc = hUnits / spr.h * k, w = spr.w * sc, h = spr.h * sc; if (w < .5) return; if (flip) { g.save(); g.translate(Math.round(sx), 0); g.scale(-1, 1); g.drawImage(spr.cv, Math.round(-w / 2), Math.round(sy - h), Math.max(1, Math.round(w)), Math.max(1, Math.round(h))); g.restore(); } else g.drawImage(spr.cv, Math.round(sx - w / 2), Math.round(sy - h), Math.max(1, Math.round(w)), Math.max(1, Math.round(h))); };\nconst rnd = (seed, i) => ((Math.imul(seed + 1, 2654435761) ^ (i * 40503)) >>> 0) % 1000 / 1000;\nOB.artHelpers = { R, D, PL, TX, SPR, prop, T };\n\nconst ART = OB.ART = {};\nconst def = (name, w, solid, draw) => { ART[name] = { w, solid, draw }; };\n\n/* ---- plants ---- */\ndef('palm', .12, true, (g, sx, sy, k, o) => SPR(g, prop('palm'), sx, sy, k, 3400 + rnd(o.seed, 1) * 900, o.seed & 1));\ndef('pine', .14, true, (g, sx, sy, k, o) => SPR(g, prop('pine'), sx, sy, k, 3600 + rnd(o.seed, 1) * 1400, o.seed & 1));\ndef('bush', .1, false, (g, sx, sy, k, o) => SPR(g, prop('bush'), sx, sy, k, 700 + rnd(o.seed, 2) * 300, o.seed & 1));\ndef('cactus', .1, true, (g, sx, sy, k, o) => { SPR(g, prop('cactus'), sx, sy, k, 1500 + rnd(o.seed, 1) * 900, o.seed & 1); if (rnd(o.seed, 3) < .5) D(g, sx, sy, k, 60, 1500, 70, '#ff6ab0'); });\ndef('rock', .14, true, (g, sx, sy, k, o) => SPR(g, prop('rock'), sx, sy, k, 600 + rnd(o.seed, 1) * 600, o.seed & 1));\ndef('cypress', .07, true, (g, sx, sy, k, o) => { const h = 3200 + rnd(o.seed, 1) * 1200, t = T('#2a6a3a'); R(g, sx, sy, k, -40, 0, 80, 300, '#5a3a2a'); PL(g, sx, sy, k, [[-260, 250], [0, h], [260, 250]], t.sh); PL(g, sx, sy, k, [[-200, 300], [0, h], [40, 300]], t.base); PL(g, sx, sy, k, [[-120, 500], [-20, h * .85], [0, 600]], t.lt); });\ndef('lemon', .12, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -50, 0, 100, 700, '#6a4a2a'); D(g, sx, sy, k, 0, 1100, 600, '#3a8a3a'); D(g, sx, sy, k, -150, 1250, 380, '#4aa048'); for (let i = 0; i < 7; i++) D(g, sx, sy, k, -400 + rnd(o.seed, i) * 800, 800 + rnd(o.seed, i + 9) * 700, 70, '#f8e040'); });\ndef('cherry', .12, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -60, 0, 120, 900, '#5a3a3a'); const t = T('#f8a8c8'); D(g, sx, sy, k, 0, 1400, 750, t.sh); D(g, sx, sy, k, -200, 1550, 520, t.base); D(g, sx, sy, k, 250, 1300, 420, t.lt); D(g, sx, sy, k, -100, 1700, 220, t.hi); });\ndef('leaf', .06, false, (g, sx, sy, k, o) => { const t = T('#2a9a3a'), f = o.seed & 1 ? 1 : -1; PL(g, sx, sy, k, [[0, 0], [f * 300, 900], [f * 700, 1300], [f * 400, 500]], t.base); PL(g, sx, sy, k, [[0, 0], [f * 700, 1300], [f * 550, 700]], t.sh); });\ndef('fern', .05, false, (g, sx, sy, k, o) => { const t = T('#3aa04a'); for (let i = -2; i <= 2; i++) PL(g, sx, sy, k, [[0, 0], [i * 220 - 60, 500 + Math.abs(i) * -60], [i * 260, 520], [i * 200 + 60, 480]], i % 2 ? t.sh : t.base); });\ndef('orchid', .04, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -10, 0, 20, 500, '#2a6a2a'); for (let i = 0; i < 3; i++) { const c = ['#e060ff', '#ff70c0', '#ffffff'][(o.seed + i) % 3]; D(g, sx, sy, k, -100 + i * 100, 450 + i * 60, 70, c); o.glow(sx + (-100 + i * 100) * k, sy - (450 + i * 60) * k, 150 * k, c, .6); } });\ndef('nightcactus', .1, true, (g, sx, sy, k, o) => { SPR(g, prop('cactus', { color: '#2a5a4a' }), sx, sy, k, 1500, o.seed & 1); for (let i = 0; i < 3; i++) { D(g, sx, sy, k, -150 + i * 150, 1300 + (i & 1) * 200, 70, '#ffffff'); o.glow(sx + (-150 + i * 150) * k, sy - (1300 + (i & 1) * 200) * k, 200 * k, '#e0f0ff', .7); } });\n\n/* ---- the beach ---- */\ndef('umbrella', .1, false, (g, sx, sy, k, o) => { const c = ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][o.seed % 4]; R(g, sx, sy, k, -12, 0, 24, 900, '#e8e0d0'); PL(g, sx, sy, k, [[-560, 800], [0, 1060], [560, 800]], c); PL(g, sx, sy, k, [[-560, 800], [-190, 950], [-190, 800]], '#ffffff'); PL(g, sx, sy, k, [[190, 800], [190, 950], [560, 800]], '#ffffff'); R(g, sx, sy, k, -400, 0, 300, 120, '#f4f0e8'); });\ndef('hut', .3, true, (g, sx, sy, k, o) => { const c = ['#f8c8d8', '#a8e0f0', '#f8e8a0', '#c8f0c8'][o.seed % 4], t = T(c); R(g, sx, sy, k, -500, 0, 1000, 900, t.base); for (let i = 0; i < 5; i++) R(g, sx, sy, k, -500 + i * 200, 0, 100, 900, t.lt); PL(g, sx, sy, k, [[-620, 900], [0, 1400], [620, 900]], '#e85a4a'); R(g, sx, sy, k, -150, 0, 300, 600, t.deep); });\ndef('lifeguard', .2, true, (g, sx, sy, k) => { for (const x of [-350, 330]) R(g, sx, sy, k, x, 0, 30, 1300, '#f4f4f4'); R(g, sx, sy, k, -420, 1300, 840, 450, '#e83a3a'); R(g, sx, sy, k, -420, 1600, 840, 80, '#ffffff'); PL(g, sx, sy, k, [[-500, 1750], [0, 2000], [500, 1750]], '#f8c020'); });\ndef('surfrack', .14, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -400, 0, 800, 60, '#8a5a3a'); ['#3ac0e0', '#f8a020', '#f05a8a'].forEach((c, i) => PL(g, sx, sy, k, [[-300 + i * 250, 0], [-220 + i * 250, 1200], [-140 + i * 250, 0]], c)); });\ndef('buoy', 0, false, (g, sx, sy, k, o) => { const bob = Math.sin(o.t * 2 + o.seed) * 40; D(g, sx, sy, k, 0, 120 + bob, 140, '#f04a2a'); R(g, sx, sy, k, -140, 100 + bob, 280, 40, '#ffffff'); });\ndef('sailboat', 0, false, (g, sx, sy, k, o) => { const b = Math.sin(o.t + 1) * 60; PL(g, sx, sy, k, [[-900, 100 + b], [900, 100 + b], [700, -100 + b], [-700, -100 + b]], '#ffffff'); PL(g, sx, sy, k, [[0, 150 + b], [0, 2600 + b], [800, 300 + b]], '#f8f4ec'); PL(g, sx, sy, k, [[-60, 300 + b], [-60, 2200 + b], [-700, 300 + b]], '#e85a7a'); });\ndef('volley', .1, false, (g, sx, sy, k) => { for (const x of [-900, 900]) R(g, sx, sy, k, x, 0, 40, 1300, '#e8e0d0'); R(g, sx, sy, k, -900, 900, 1840, 350, '#ffffff'); for (let i = 0; i < 9; i++) R(g, sx, sy, k, -900 + i * 220, 900, 8, 350, '#c8c8c8'); D(g, sx, sy, k, 200, 1800, 90, '#f8e040'); });\ndef('ferris', 0, false, (g, sx, sy, k, o) => { const r = 2600, cy = 3200, t = T('#e8e8f0'); PL(g, sx, sy, k, [[-1400, 0], [-80, cy], [80, cy], [1400, 0], [1200, 0], [0, cy - 300], [-1200, 0]], t.sh); for (let i = 0; i < 12; i++) { const a = o.t * .15 + i / 12 * Math.PI * 2, x = Math.cos(a) * r, y = cy + Math.sin(a) * r; px.line(g, sx, sy - cy * k, sx + x * k, sy - y * k, t.base); R(g, sx, sy, k, x - 160, y - 300, 320, 280, ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][i % 4]); if (o.night) o.glow(sx + x * k, sy - y * k, 200 * k, '#ffe080', .6); } R(g, sx, sy, k, -6000, 0, 12000, 200, '#8a6a4a'); });\ndef('billboard', .3, true, (g, sx, sy, k, o) => { const ads = [['GELATO', 'GELATISSIMO', '#f8a0c0'], ['FIORETTI', 'BORN TO BLOOM', '#e83a3a'], ['RADIO', 'PETAL FM 88.6', '#8a5ad0'], ['HOTEL', 'VESPERA', '#2a3a6a']], a = ads[o.seed % 4]; for (const x of [-700, 600]) R(g, sx, sy, k, x, 0, 100, 1600, '#6a6a70'); R(g, sx, sy, k, -1000, 1500, 2000, 1000, '#f8f4e8'); R(g, sx, sy, k, -950, 1550, 1900, 900, a[2]); TX(g, a[0], sx, sy, k, 0, 2350, '#ffffff', 300); TX(g, a[1], sx, sy, k, 0, 1950, '#fff4c0', 200); });\n\n/* ---- fields, farms ---- */\ndef('farmhouse', .3, true, (g, sx, sy, k) => { const t = T('#e8d8b8'); R(g, sx, sy, k, -1300, 0, 2600, 1500, t.base); R(g, sx, sy, k, 600, 0, 700, 1500, t.sh); PL(g, sx, sy, k, [[-1450, 1500], [-1100, 2200], [1450, 2200], [1450, 1500]], '#c8603a'); for (const x of [-900, -300, 300]) R(g, sx, sy, k, x, 700, 300, 400, '#5a7aa0'); R(g, sx, sy, k, 1400, 0, 500, 3000, '#8a8a90'); D(g, sx, sy, k, 1650, 3100, 450, '#a0a0a8'); });\ndef('beehives', .2, true, (g, sx, sy, k) => { for (let i = 0; i < 3; i++) { R(g, sx, sy, k, -900 + i * 650, 0, 500, 500, ['#f8f0d8', '#a8d8f0', '#f8d8e8'][i]); R(g, sx, sy, k, -950 + i * 650, 500, 600, 80, '#8a6a4a'); } });\ndef('silo', .2, true, (g, sx, sy, k) => { const t = T('#c8c8d0'); R(g, sx, sy, k, -500, 0, 1000, 4200, t.base); R(g, sx, sy, k, 200, 0, 300, 4200, t.sh); D(g, sx, sy, k, 0, 4200, 500, t.lt); });\ndef('barn', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1500, 0, 3000, 2000, '#c8302a'); PL(g, sx, sy, k, [[-1700, 2000], [0, 3200], [1700, 2000]], '#5a2a2a'); R(g, sx, sy, k, -500, 0, 1000, 1400, '#f4f0e8'); PL(g, sx, sy, k, [[-500, 0], [500, 1400], [440, 1400], [-500, 80]], '#c8302a'); });\ndef('turbine', .1, true, (g, sx, sy, k, o) => { const h = 7000; PL(g, sx, sy, k, [[-140, 0], [-50, h], [50, h], [140, 0]], '#f4f4f8'); for (let i = 0; i < 3; i++) { const a = o.t * 1.6 + o.seed + i * 2.094; px.poly(g, [[sx, sy - h * k], [sx + Math.cos(a) * 3000 * k, sy - (h + Math.sin(a) * 3000) * k], [sx + Math.cos(a + .1) * 2800 * k, sy - (h + Math.sin(a + .1) * 2800) * k]], '#e8e8f0'); } D(g, sx, sy, k, 0, h, 120, '#c8c8d0'); });\ndef('haybale', .14, true, (g, sx, sy, k, o) => { const t = T('#e8c060'); D(g, sx, sy, k, 0, 420, 420, t.base); D(g, sx, sy, k, -100, 500, 250, t.lt); if (o.th && o.th.big) { D(g, sx, sy, k, 0, 1800, 900, '#f8c020'); D(g, sx, sy, k, 0, 1800, 400, '#6a3a1a'); } });\ndef('fence', 0, false, (g, sx, sy, k) => { R(g, sx, sy, k, -20, 0, 40, 400, '#a07a50'); R(g, sx, sy, k, -600, 250, 1200, 40, '#a07a50'); R(g, sx, sy, k, -600, 120, 1200, 40, '#a07a50'); });\n\n/* ---- cliffs, lake, canyon, alpine ---- */\ndef('lamp', .03, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -15, 0, 30, 1400, '#5a5a68'); R(g, sx, sy, k, -100, 1400, 200, 60, '#5a5a68'); D(g, sx, sy, k, 0, 1380, 60, '#fff0c0'); if (o.night) o.glow(sx, sy - 1380 * k, 500 * k, '#ffd890', .8); });\ndef('streetlamp', .03, false, (g, sx, sy, k, o) => { SPR(g, prop('streetlamp'), sx, sy, k, 2200, o.th && o.th.x > 0); if (o.night) o.glow(sx, sy - 2100 * k, 600 * k, '#ffd890', .9); });\ndef('village', 0, false, (g, sx, sy, k, o) => { const cs = ['#f8c8a8', '#f8e8b0', '#c8e0f0', '#f0b0b8', '#ffffff']; for (let i = 0; i < 9; i++) { const x = -3000 + i * 700, y = (i % 3) * 600 + rnd(o.seed, i) * 400; R(g, sx, sy, k, x, y, 650, 700, cs[i % 5]); PL(g, sx, sy, k, [[x - 40, y + 700], [x + 325, y + 950], [x + 690, y + 700]], '#d8704a'); R(g, sx, sy, k, x + 250, y + 200, 150, 200, '#3a5a8a'); } });\ndef('chapel', 0, false, (g, sx, sy, k) => { R(g, sx, sy, k, -600, 0, 1200, 1600, '#f8f4ec'); PL(g, sx, sy, k, [[-700, 1600], [0, 2300], [700, 1600]], '#3a6ad0'); R(g, sx, sy, k, -200, 2100, 400, 900, '#f8f4ec'); D(g, sx, sy, k, 0, 3100, 260, '#3a6ad0'); R(g, sx, sy, k, -20, 3300, 40, 300, '#e8c060'); });\ndef('boathouse', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1200, 0, 2400, 1300, '#8a5a3a'); for (let i = 0; i < 8; i++) R(g, sx, sy, k, -1200 + i * 300, 0, 30, 1300, '#6a4028'); PL(g, sx, sy, k, [[-1400, 1300], [0, 2100], [1400, 1300]], '#3a5a6a'); R(g, sx, sy, k, -600, 0, 1200, 900, '#2a1a10'); });\ndef('steamer', 0, false, (g, sx, sy, k, o) => { const x0 = Math.sin(o.t * .05) * 2000; PL(g, sx, sy, k, [[x0 - 2500, 300], [x0 + 2500, 300], [x0 + 2100, -200], [x0 - 2100, -200]], '#f4f0e8'); R(g, sx, sy, k, x0 - 1600, 300, 3200, 700, '#ffffff'); R(g, sx, sy, k, x0 - 1600, 300, 3200, 150, '#e83a3a'); R(g, sx, sy, k, x0 - 200, 1000, 400, 1200, '#2a2a30'); for (let i = 0; i < 3; i++) D(g, sx, sy, k, x0 + 100 + i * 300, 2400 + i * 300 + (o.t * 300) % 300, 200 + i * 60, '#e8e8f0'); D(g, sx, sy, k, x0 + 1900, 200, 600, '#c83a2a'); });\ndef('waterfall', .4, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -1500, 0, 3000, 5200, '#6a7a7a'); R(g, sx, sy, k, -1500, 0, 600, 5200, '#5a6868'); for (let i = 0; i < 6; i++) R(g, sx, sy, k, -700 + i * 230, 0, 200, 5000, ((Math.floor(o.t * 10) + i) % 3) ? '#d8f0ff' : '#a8d8f8'); for (let i = 0; i < 5; i++) D(g, sx, sy, k, -800 + i * 400, 200 + ((o.t * 900 + i * 300) % 500), 260, '#ffffff'); });\ndef('mesa', 0, false, (g, sx, sy, k, o) => { const h = 4000 + rnd(o.seed, 1) * 3000, t = T('#c86a4a'); PL(g, sx, sy, k, [[-2200, 0], [-1500, h], [1300, h], [2100, 0]], t.base); PL(g, sx, sy, k, [[600, h], [1300, h], [2100, 0], [1000, 0]], t.sh); R(g, sx, sy, k, -1500, h - 300, 2800, 300, t.lt); });\ndef('stand', .3, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -900, 0, 1800, 900, '#e8c88a'); PL(g, sx, sy, k, [[-1100, 900], [1100, 900], [900, 1400], [-900, 1400]], '#e83a5a'); for (let i = 0; i < 4; i++) { D(g, sx, sy, k, -600 + i * 400, 1050, 120, '#f8f0e0'); PL(g, sx, sy, k, [[-720 + i * 400, 1100], [-600 + i * 400, 1500], [-480 + i * 400, 1100]], '#e83a3a'); } TX(g, 'GNOMES', sx, sy, k, 0, 650, '#6a2a1a', 220); });\ndef('chalet', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1300, 0, 2600, 1600, '#c88a5a'); R(g, sx, sy, k, -1300, 0, 2600, 500, '#f4f0e8'); PL(g, sx, sy, k, [[-1700, 1500], [0, 2700], [1700, 1500]], '#6a3a2a'); PL(g, sx, sy, k, [[-1500, 1600], [0, 2600], [1500, 1600]], '#f8f8ff'); R(g, sx, sy, k, -800, 1000, 500, 350, '#4a5a8a'); R(g, sx, sy, k, 300, 1000, 500, 350, '#4a5a8a'); for (let i = 0; i < 6; i++) D(g, sx, sy, k, -700 + i * 300, 950, 90, '#e83a5a'); });\ndef('cow', .1, true, (g, sx, sy, k, o) => { const f = o.seed & 1 ? 1 : -1; R(g, sx, sy, k, -500, 400, 1000, 500, '#f8f8f8'); R(g, sx, sy, k, -300, 600, 300, 250, '#2a2a2a'); R(g, sx, sy, k, f * 450 - 180, 550, 360, 380, '#f8f8f8'); R(g, sx, sy, k, f * 450 - 180, 550, 360, 120, '#f0b0b0'); for (const x of [-450, -150, 250, 400]) R(g, sx, sy, k, x, 0, 80, 400, '#e8e8e8'); });\n\n/* ---- town, vineyard ---- */\ndef('stall', .12, true, (g, sx, sy, k, o) => { const c = ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][o.seed % 4]; R(g, sx, sy, k, -600, 0, 1200, 700, '#a0704a'); for (let i = 0; i < 6; i++) PL(g, sx, sy, k, [[-600 + i * 200, 1300], [-500 + i * 200, 1100], [-400 + i * 200, 1300]], i % 2 ? c : '#ffffff'); R(g, sx, sy, k, -600, 1300, 1200, 120, c); for (let i = 0; i < 8; i++) D(g, sx, sy, k, -500 + i * 140, 760, 70, ['#ff6aa0', '#f8e040', '#ffffff', '#a060ff'][i % 4]); });\ndef('dome', 0, false, (g, sx, sy, k) => { const t = T('#e8d8c0'); R(g, sx, sy, k, -2200, 0, 4400, 3000, t.base); for (let i = 0; i < 5; i++) R(g, sx, sy, k, -1900 + i * 900, 400, 300, 1800, t.sh); D(g, sx, sy, k, 0, 3600, 1500, '#c8603a'); R(g, sx, sy, k, -1500, 3000, 3000, 600, t.base); R(g, sx, sy, k, -150, 5000, 300, 600, t.lt); D(g, sx, sy, k, 0, 5700, 150, '#e8c060'); });\ndef('fountain', .4, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -1200, 0, 2400, 400, '#d8d0c0'); R(g, sx, sy, k, -200, 400, 400, 1000, '#c8c0b0'); D(g, sx, sy, k, 0, 1400, 400, '#d8d0c0'); for (let i = -3; i <= 3; i++) { const h = 1400 + Math.abs(Math.sin(o.t * 4 + i)) * 400; px.line(g, sx, sy - h * k, sx + i * 300 * k, sy - 500 * k, '#a8e0ff'); } });\ndef('villa', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1500, 0, 3000, 1500, '#f0d8b0'); PL(g, sx, sy, k, [[-1700, 1500], [0, 2100], [1700, 1500]], '#c8603a'); for (const x of [-1100, -400, 300, 1000]) R(g, sx, sy, k, x, 600, 250, 500, '#4a6a4a'); R(g, sx, sy, k, 1100, 1500, 300, 1100, '#f0d8b0'); });\ndef('barrel', .06, true, (g, sx, sy, k) => SPR(g, prop('barrel'), sx, sy, k, 500));\ndef('cart', .2, true, (g, sx, sy, k) => { R(g, sx, sy, k, -600, 300, 1200, 400, '#8a5a3a'); for (let i = 0; i < 5; i++) D(g, sx, sy, k, -450 + i * 220, 800, 140, '#6a2a5a'); D(g, sx, sy, k, -400, 250, 250, '#4a3020'); D(g, sx, sy, k, 400, 250, 250, '#4a3020'); });\ndef('castle', 0, false, (g, sx, sy, k) => { const t = T('#c8b8a0'); PL(g, sx, sy, k, [[-5000, 0], [-2000, 2000], [2500, 2200], [5000, 0]], '#6a8a48'); R(g, sx, sy, k, -2200, 2000, 4400, 2200, t.base); for (let i = 0; i < 11; i++) if (i % 2) R(g, sx, sy, k, -2200 + i * 400, 4200, 400, 300, t.base); for (const x of [-2600, 1800]) { R(g, sx, sy, k, x, 2000, 800, 3600, t.sh); PL(g, sx, sy, k, [[x - 100, 5600], [x + 400, 6800], [x + 900, 5600]], '#5a3a5a'); } });\n\n/* ---- lagoon, jungle, night ---- */\ndef('flamingo', .05, false, (g, sx, sy, k, o) => { const up = Math.sin(o.t * 3 + o.seed) > .95 ? 300 : 0, c = '#ff8ab0'; R(g, sx, sy, k, -10, 0, 20, 700 + up, '#e8708a'); D(g, sx, sy, k, 0, 800 + up, 180, c); px.line(g, sx, sy - (850 + up) * k, sx + 60 * k, sy - (1300 + up) * k, c); D(g, sx, sy, k, 80, 1320 + up, 60, c); R(g, sx, sy, k, 120, 1300 + up, 60, 20, '#2a2a2a'); });\ndef('saltpile', .1, true, (g, sx, sy, k) => { PL(g, sx, sy, k, [[-600, 0], [0, 800], [600, 0]], '#f8f8ff'); PL(g, sx, sy, k, [[0, 800], [600, 0], [200, 0]], '#d8d8f0'); });\ndef('liftbridge', 0, false, (g, sx, sy, k, o) => { for (const x of [-1600, 1400]) R(g, sx, sy, k, x, 0, 200, 4200, '#7a5a8a'); R(g, sx, sy, k, -1700, 4000, 3400, 300, '#7a5a8a'); TX(g, 'PONTE ROSA', sx, sy, k, 0, 4380, '#ffe0f0', 260); });\ndef('ruin', .4, true, (g, sx, sy, k) => { const t = T('#9aa08a'); R(g, sx, sy, k, -1500, 0, 600, 2600, t.base); R(g, sx, sy, k, 900, 0, 600, 2000, t.sh); R(g, sx, sy, k, -1500, 2300, 2200, 400, t.base); D(g, sx, sy, k, -1100, 2700, 400, '#3a8a3a'); D(g, sx, sy, k, 1200, 2100, 300, '#3a8a3a'); });\ndef('neon', .1, true, (g, sx, sy, k, o) => { const msgs = [['GELATO', '#ff5aa0'], ['CASINO', '#ffe040'], ['BAR', '#40e0ff'], ['HOTEL', '#a060ff'], ['FIORI', '#60ff90'], ['DISCO', '#ff8040']], m = msgs[o.seed % 6], on = (Math.floor(o.t * 2 + o.seed) % 7) !== 0; R(g, sx, sy, k, -40, 0, 80, 1600, '#3a3a48'); R(g, sx, sy, k, -900, 1600, 1800, 700, '#1a1a28'); if (on) { TX(g, m[0], sx, sy, k, 0, 2200, m[1], 360); o.glow(sx, sy - 1950 * k, 1100 * k, m[1], .7); } });\ndef('yacht', 0, false, (g, sx, sy, k, o) => { PL(g, sx, sy, k, [[-1800, 300], [1800, 300], [1500, -100], [-1600, -100]], '#f8f8ff'); R(g, sx, sy, k, -1000, 300, 1800, 500, '#f0f0f8'); R(g, sx, sy, k, -800, 450, 1400, 150, '#2a3a6a'); if (o.night) for (let i = 0; i < 5; i++) o.glow(sx + (-800 + i * 350) * k, sy - 520 * k, 160 * k, '#ffe0a0', .7); });\ndef('casino', 0, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -2500, 0, 5000, 3500, '#2a2040'); for (let i = 0; i < 8; i++) { const a = i / 8 * Math.PI * 2 + o.t * .4, c = i % 2 ? '#ff5ab0' : '#ffd040'; px.poly(g, [[sx, sy - 5200 * k], [sx + Math.cos(a) * 1500 * k, sy - (5200 + Math.sin(a) * 1500) * k], [sx + Math.cos(a + .35) * 1500 * k, sy - (5200 + Math.sin(a + .35) * 1500) * k]], c); } D(g, sx, sy, k, 0, 5200, 400, '#ffffff'); o.glow(sx, sy - 5200 * k, 2600 * k, '#ff70c0', .8); TX(g, 'CASINO FIORE', sx, sy, k, 0, 3100, '#ffe060', 360); for (let i = 0; i < 12; i++) R(g, sx, sy, k, -2200 + i * 380, 600 + (i % 3) * 800, 200, 300, '#ffe080'); });\ndef('motel', .3, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -60, 0, 120, 2400, '#3a3a48'); R(g, sx, sy, k, -1000, 2400, 2000, 900, '#2a1a3a'); const on = Math.floor(o.t * 3) % 6 !== 0; if (on) { TX(g, 'MOTEL', sx, sy, k, 0, 3150, '#ff4a7a', 380); o.glow(sx, sy - 2850 * k, 1200 * k, '#ff4a7a', .7); } TX(g, 'VACANCY', sx, sy, k, 0, 2650, '#60ffb0', 220); });\ndef('dish', 0, false, (g, sx, sy, k) => { R(g, sx, sy, k, -200, 0, 400, 2500, '#c8c8d8'); PL(g, sx, sy, k, [[-2200, 4200], [0, 2400], [2200, 4800], [1600, 5600], [-1600, 5200]], '#e8e8f4'); R(g, sx, sy, k, -40, 4000, 80, 900, '#a8a8b8'); });\ndef('stone', .1, true, (g, sx, sy, k, o) => { const h = 1600 + rnd(o.seed, 1) * 1200, t = T('#8a8a9a'); PL(g, sx, sy, k, [[-350, 0], [-280, h], [250, h * .95], [350, 0]], t.base); PL(g, sx, sy, k, [[100, 0], [180, h * .95], [250, h * .95], [350, 0]], t.sh); });\ndef('sheep', .08, true, (g, sx, sy, k, o) => { const f = o.seed & 1 ? 1 : -1; D(g, sx, sy, k, 0, 450, 380, '#f4f4f0'); D(g, sx, sy, k, f * 300, 550, 160, '#2a2a2a'); for (const x of [-200, 150]) R(g, sx, sy, k, x, 0, 60, 250, '#2a2a2a'); });\ndef('castleruin', 0, false, (g, sx, sy, k) => { const t = T('#6a6a7a'); R(g, sx, sy, k, -2500, 0, 1000, 4500, t.base); R(g, sx, sy, k, -1500, 0, 2600, 2500, t.sh); R(g, sx, sy, k, 1100, 0, 900, 3400, t.base); for (let i = 0; i < 4; i++) R(g, sx, sy, k, -2500 + i * 280, 4500, 160, 300, t.base); R(g, sx, sy, k, -2200, 2600, 300, 600, '#1a1a2a'); });\n\n/* ---- spans over the road (o.rw: half the road in pixels) ---- */\nconst span = (name, fn) => def('span_' + name, 0, false, fn);\nspan('palms', (g, sx, sy, k, o) => { const W = o.rw / k * 1.35, t = T('#3a9a4a'); for (const s of [-1, 1]) { R(g, sx, sy, k, s * W - 80, 0, 160, 3000, '#8a6a3a'); PL(g, sx, sy, k, [[s * W, 3000], [s * W * .2, 3600], [0, 3300], [s * W * .3, 3200]], t.base); PL(g, sx, sy, k, [[s * W, 3000], [s * W * .5, 3900], [s * W * .1, 3700]], t.sh); } });\nspan('gallery', (g, sx, sy, k, o) => { const W = o.rw / k * 1.3; R(g, sx, sy, k, W - 300, 0, 400, 2800, '#c8b090'); R(g, sx, sy, k, -W - 100, 0, 200, 2800, '#d8c8a8'); R(g, sx, sy, k, -W - 100, 2600, W * 2 + 400, 500, '#b8a080'); });\nspan('truss', (g, sx, sy, k, o) => { const W = o.rw / k * 1.25; for (const s of [-1, 1]) R(g, sx, sy, k, s * W - 60, 0, 120, 2400, '#8a4a2a'); R(g, sx, sy, k, -W, 2300, W * 2, 140, '#8a4a2a'); px.line(g, sx - W * k, sy - 2300 * k, sx, sy - 400 * k, '#7a3a20'); px.line(g, sx + W * k, sy - 2300 * k, sx, sy - 400 * k, '#7a3a20'); });\nspan('bunting', (g, sx, sy, k, o) => { const W = o.rw / k * 1.3, cs = ['#e83a5a', '#f8c020', '#3a9ae8', '#3ac080', '#ffffff']; for (let i = 0; i < 12; i++) { const x = -W + i * W / 6, y = 2600 - Math.sin(i / 11 * Math.PI) * 400; PL(g, sx, sy, k, [[x, y], [x + W / 6, y], [x + W / 12, y - 260]], cs[i % 5]); } });\nspan('canopy', (g, sx, sy, k, o) => { const W = o.rw / k * 1.4, t = T('#1a6a2a'); PL(g, sx, sy, k, [[-W - 600, 2600], [-W * .2, 3400], [0, 3000], [W * .3, 3500], [W + 600, 2600], [W + 600, 3800], [-W - 600, 3800]], t.sh); D(g, sx, sy, k, -W * .5, 3200, 600, t.base); D(g, sx, sy, k, W * .4, 3300, 500, t.base); if (!o.night) px.blend(g, .25, 'add', () => PL(g, sx, sy, k, [[-W * .3, 3000], [-W * .1, 3000], [W * .3, 0], [W * .1, 0]], '#fff4c0')); });\ndef('checkpoint', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.25, t = T('#3ac080'); for (const s of [-1, 1]) { R(g, sx, sy, k, s * W - 150, 0, 300, 3000, '#f4f4f8'); for (let i = 0; i < 6; i++) D(g, sx, sy, k, s * W, 400 + i * 450, 230, ['#ff6aa0', '#f8e040', '#ffffff'][i % 3]); } R(g, sx, sy, k, -W, 2700, W * 2, 700, t.base); R(g, sx, sy, k, -W, 2700, W * 2, 120, t.sh); TX(g, 'CHECKPOINT', sx, sy, k, 0, 3300, '#ffffff', 420); });\ndef('goalarch', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.3; for (const s of [-1, 1]) { R(g, sx, sy, k, s * W - 200, 0, 400, 3600, '#f8e8f0'); for (let i = 0; i < 8; i++) D(g, sx, sy, k, s * W, 300 + i * 420, 260, ['#ff5aa0', '#ffd040', '#ffffff', '#ff8a40'][i % 4]); } R(g, sx, sy, k, -W, 3200, W * 2, 900, '#e83a6a'); for (let i = 0; i < 16; i++) R(g, sx, sy, k, -W + i * W / 8, 3200, W / 16, 120, i % 2 ? '#ffffff' : '#2a2a2a'); const goal = o.th && o.th.goal; TX(g, goal ? 'GOAL ' + goal : 'GOAL', sx, sy, k, 0, 3900, '#fff4c0', 520); });\ndef('sprintarch', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.3; for (const s of [-1, 1]) R(g, sx, sy, k, s * W - 160, 0, 320, 3200, '#ffffff'); R(g, sx, sy, k, -W, 2800, W * 2, 800, '#ff8a2a'); for (let i = 0; i < 16; i++) R(g, sx, sy, k, -W + i * W / 8, 2800, W / 16, 140, i % 2 ? '#ffffff' : '#2a2a2a'); TX(g, 'FINISH', sx, sy, k, 0, 3450, '#ffffff', 460); });\ndef('startgantry', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.3, lights = o.th && o.th.lights || 0; for (const s of [-1, 1]) R(g, sx, sy, k, s * W - 150, 0, 300, 3400, '#3a3a48'); R(g, sx, sy, k, -W, 3000, W * 2, 800, '#2a2a38'); for (let i = 0; i < 5; i++) { const on = i < lights, c = lights >= 6 ? '#40ff70' : on ? '#ff3a3a' : '#4a2a2a'; D(g, sx, sy, k, -1200 + i * 600, 3400, 220, c); if (on || lights >= 6) o.glow(sx + (-1200 + i * 600) * k, sy - 3400 * k, 500 * k, c, .8); } TX(g, 'COAST 2 COAST', sx, sy, k, 0, 4200, '#ffd8a0', 300); });\ndef('gridline', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k; for (let i = 0; i < 12; i++) R(g, sx, sy, k, -W + i * W / 6, 0, W / 12, 60, i % 2 ? '#ffffff' : '#2a2a2a'); });\ndef('cushion', .14, true, (g, sx, sy, k, o) => { for (const x of [-180, 180]) { R(g, sx, sy, k, x - 160, 0, 320, 380, '#e85a2a'); R(g, sx, sy, k, x - 160, 260, 320, 60, '#f8f0e0'); D(g, sx, sy, k, x, 460, 160, '#ff70a0'); } });\ndef('forksign', .2, true, (g, sx, sy, k, o) => {\n  const V = o.V, next = V && OB.forkOf(V.stage); if (!next) return;\n  for (const x of [-600, 500]) R(g, sx, sy, k, x, 0, 100, 1800, '#6a6a78');\n  R(g, sx, sy, k, -2600, 1800, 5200, 1500, '#1a4a8a'); R(g, sx, sy, k, -2550, 1850, 5100, 1400, '#2a6ad0'); R(g, sx, sy, k, -40, 1850, 80, 1400, '#ffffff');\n  const [L, Rr] = next.map(id => OB.STAGES[id]);\n  TX(g, '← ' + L.name.toUpperCase(), sx, sy, k, -1300, 2950, '#ffffff', 230); TX(g, Rr.name.toUpperCase() + ' →', sx, sy, k, 1300, 2950, '#ffffff', 230);\n  for (let i = 0; i < 5; i++) { D(g, sx, sy, k, -2000 + i * 300, 2200, 100, i < L.diff ? '#ffd040' : '#3a5a9a'); D(g, sx, sy, k, 800 + i * 300, 2200, 100, i < Rr.diff ? '#ffd040' : '#3a5a9a'); }\n  if (V.closed) { const cx = V.closed < 0 ? -1300 : 1300; R(g, sx, sy, k, cx - 1200, 2400, 2400, 300, '#e83a3a'); TX(g, 'ROAD CLOSED', sx, sy, k, cx, 2650, '#ffffff', 200); }\n});\ndef('barrier', .9, true, (g, sx, sy, k, o) => { const W = o.rw / k * 1.05; for (let i = 0; i < 10; i++) R(g, sx, sy, k, -W + i * W / 5, 300, W / 5, 300, i % 2 ? '#ffffff' : '#e83a3a'); for (const s of [-1, 1]) R(g, sx, sy, k, s * W * .8 - 40, 0, 80, 650, '#3a3a48'); TX(g, 'ROAD CLOSED', sx, sy, k, 0, 1100, '#ffe040', 260); });\ndef('crowd', 0, false, (g, sx, sy, k, o) => { const c = ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080', '#a060e0'], up = Math.floor(o.t * 4 + o.seed) % 2; for (let i = 0; i < 3; i++) { const x = -400 + i * 400, sk = ['#f0c8a0', '#c89070', '#8a5a3a'][(o.seed + i) % 3]; R(g, sx, sy, k, x - 120, 0, 240, 900, c[(o.seed + i) % 5]); D(g, sx, sy, k, x, 1050, 150, sk); R(g, sx, sy, k, x - 160, up && i % 2 ? 1000 : 600, 60, 400, sk); R(g, sx, sy, k, x + 100, !up && i % 2 === 0 ? 1000 : 600, 60, 400, sk); } });\nOB.artNames = () => Object.keys(ART);\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3182,"cache_read_input_tokens":307133,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3182},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b31a73a4-a38b-4945-9f7b-620b7871a8e6","uuid":"667d7d52-386e-4cf9-9231-e3ddd4750bc7","timestamp":"2026-11-04T11:11:23.600Z","request_id":"req_011CghnPcT4nne9T2waTTe4U","wire_tool_inputs":{"toolu_01CU3di4zQ4Qg9ajJKVDL2tF":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/11-art.js","content":"/* Roadside art (PLAN §9.4): every piece of scenery, landmark, span, arch and sign, drawn in world units by code with\n * E.px and shaded with E.tones, so it scales cleanly with distance. OB.ART[name] = { w (half roads it blocks),\n * solid, draw(g, sx, sy, k, o) } where (sx, sy) is its foot on screen and k the pixels per world unit. Engine props\n * (E.prop) are used for the generic plants and furniture. */\n(() => {\n'use strict';\nconst OB = window.OB, E = OB.E, { px } = E;\nconst T = c => E.tones(c);\n// unit-space helpers: x across from the foot, y up from the ground, both in world units\nconst R = (g, sx, sy, k, x, y, w, h, c) => { const W = w * k, H = h * k; if (W < .4 && H < .4) return; px.rect(g, Math.round(sx + x * k), Math.round(sy - (y + h) * k), Math.max(1, Math.round(W)), Math.max(1, Math.round(H)), c); };\nconst D = (g, sx, sy, k, x, y, r, c) => { if (r * k < .5) return px.dot(g, sx + x * k, sy - y * k, c); px.disc(g, sx + x * k, sy - y * k, r * k, c); };\nconst PL = (g, sx, sy, k, pts, c) => px.poly(g, pts.map(([x, y]) => [sx + x * k, sy - y * k]), c);\nconst TX = (g, s, sx, sy, k, x, y, c, size) => { const sc = Math.max(1, Math.floor(size * k / 7)); if (size * k < 5) return; E.font.text(g, s, Math.round(sx + x * k), Math.round(sy - y * k), c, { align: 'center', scale: sc, outline: false }); };\nconst PROPS = {};\nconst prop = (name, o) => { const key = name + JSON.stringify(o || {}); if (!PROPS[key]) { try { PROPS[key] = E.prop(name, o || {}).frames[0]; } catch (e) { PROPS[key] = null; } } return PROPS[key]; };\nconst SPR = (g, spr, sx, sy, k, hUnits, flip) => { if (!spr || !spr.cv) return; const sc = hUnits / spr.h * k, w = spr.w * sc, h = spr.h * sc; if (w < .5) return; if (flip) { g.save(); g.translate(Math.round(sx), 0); g.scale(-1, 1); g.drawImage(spr.cv, Math.round(-w / 2), Math.round(sy - h), Math.max(1, Math.round(w)), Math.max(1, Math.round(h))); g.restore(); } else g.drawImage(spr.cv, Math.round(sx - w / 2), Math.round(sy - h), Math.max(1, Math.round(w)), Math.max(1, Math.round(h))); };\nconst rnd = (seed, i) => ((Math.imul(seed + 1, 2654435761) ^ (i * 40503)) >>> 0) % 1000 / 1000;\nOB.artHelpers = { R, D, PL, TX, SPR, prop, T };\n\nconst ART = OB.ART = {};\nconst def = (name, w, solid, draw) => { ART[name] = { w, solid, draw }; };\n\n/* ---- plants ---- */\ndef('palm', .12, true, (g, sx, sy, k, o) => SPR(g, prop('palm'), sx, sy, k, 3400 + rnd(o.seed, 1) * 900, o.seed & 1));\ndef('pine', .14, true, (g, sx, sy, k, o) => SPR(g, prop('pine'), sx, sy, k, 3600 + rnd(o.seed, 1) * 1400, o.seed & 1));\ndef('bush', .1, false, (g, sx, sy, k, o) => SPR(g, prop('bush'), sx, sy, k, 700 + rnd(o.seed, 2) * 300, o.seed & 1));\ndef('cactus', .1, true, (g, sx, sy, k, o) => { SPR(g, prop('cactus'), sx, sy, k, 1500 + rnd(o.seed, 1) * 900, o.seed & 1); if (rnd(o.seed, 3) < .5) D(g, sx, sy, k, 60, 1500, 70, '#ff6ab0'); });\ndef('rock', .14, true, (g, sx, sy, k, o) => SPR(g, prop('rock'), sx, sy, k, 600 + rnd(o.seed, 1) * 600, o.seed & 1));\ndef('cypress', .07, true, (g, sx, sy, k, o) => { const h = 3200 + rnd(o.seed, 1) * 1200, t = T('#2a6a3a'); R(g, sx, sy, k, -40, 0, 80, 300, '#5a3a2a'); PL(g, sx, sy, k, [[-260, 250], [0, h], [260, 250]], t.sh); PL(g, sx, sy, k, [[-200, 300], [0, h], [40, 300]], t.base); PL(g, sx, sy, k, [[-120, 500], [-20, h * .85], [0, 600]], t.lt); });\ndef('lemon', .12, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -50, 0, 100, 700, '#6a4a2a'); D(g, sx, sy, k, 0, 1100, 600, '#3a8a3a'); D(g, sx, sy, k, -150, 1250, 380, '#4aa048'); for (let i = 0; i < 7; i++) D(g, sx, sy, k, -400 + rnd(o.seed, i) * 800, 800 + rnd(o.seed, i + 9) * 700, 70, '#f8e040'); });\ndef('cherry', .12, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -60, 0, 120, 900, '#5a3a3a'); const t = T('#f8a8c8'); D(g, sx, sy, k, 0, 1400, 750, t.sh); D(g, sx, sy, k, -200, 1550, 520, t.base); D(g, sx, sy, k, 250, 1300, 420, t.lt); D(g, sx, sy, k, -100, 1700, 220, t.hi); });\ndef('leaf', .06, false, (g, sx, sy, k, o) => { const t = T('#2a9a3a'), f = o.seed & 1 ? 1 : -1; PL(g, sx, sy, k, [[0, 0], [f * 300, 900], [f * 700, 1300], [f * 400, 500]], t.base); PL(g, sx, sy, k, [[0, 0], [f * 700, 1300], [f * 550, 700]], t.sh); });\ndef('fern', .05, false, (g, sx, sy, k, o) => { const t = T('#3aa04a'); for (let i = -2; i <= 2; i++) PL(g, sx, sy, k, [[0, 0], [i * 220 - 60, 500 + Math.abs(i) * -60], [i * 260, 520], [i * 200 + 60, 480]], i % 2 ? t.sh : t.base); });\ndef('orchid', .04, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -10, 0, 20, 500, '#2a6a2a'); for (let i = 0; i < 3; i++) { const c = ['#e060ff', '#ff70c0', '#ffffff'][(o.seed + i) % 3]; D(g, sx, sy, k, -100 + i * 100, 450 + i * 60, 70, c); o.glow(sx + (-100 + i * 100) * k, sy - (450 + i * 60) * k, 150 * k, c, .6); } });\ndef('nightcactus', .1, true, (g, sx, sy, k, o) => { SPR(g, prop('cactus', { color: '#2a5a4a' }), sx, sy, k, 1500, o.seed & 1); for (let i = 0; i < 3; i++) { D(g, sx, sy, k, -150 + i * 150, 1300 + (i & 1) * 200, 70, '#ffffff'); o.glow(sx + (-150 + i * 150) * k, sy - (1300 + (i & 1) * 200) * k, 200 * k, '#e0f0ff', .7); } });\n\n/* ---- the beach ---- */\ndef('umbrella', .1, false, (g, sx, sy, k, o) => { const c = ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][o.seed % 4]; R(g, sx, sy, k, -12, 0, 24, 900, '#e8e0d0'); PL(g, sx, sy, k, [[-560, 800], [0, 1060], [560, 800]], c); PL(g, sx, sy, k, [[-560, 800], [-190, 950], [-190, 800]], '#ffffff'); PL(g, sx, sy, k, [[190, 800], [190, 950], [560, 800]], '#ffffff'); R(g, sx, sy, k, -400, 0, 300, 120, '#f4f0e8'); });\ndef('hut', .3, true, (g, sx, sy, k, o) => { const c = ['#f8c8d8', '#a8e0f0', '#f8e8a0', '#c8f0c8'][o.seed % 4], t = T(c); R(g, sx, sy, k, -500, 0, 1000, 900, t.base); for (let i = 0; i < 5; i++) R(g, sx, sy, k, -500 + i * 200, 0, 100, 900, t.lt); PL(g, sx, sy, k, [[-620, 900], [0, 1400], [620, 900]], '#e85a4a'); R(g, sx, sy, k, -150, 0, 300, 600, t.deep); });\ndef('lifeguard', .2, true, (g, sx, sy, k) => { for (const x of [-350, 330]) R(g, sx, sy, k, x, 0, 30, 1300, '#f4f4f4'); R(g, sx, sy, k, -420, 1300, 840, 450, '#e83a3a'); R(g, sx, sy, k, -420, 1600, 840, 80, '#ffffff'); PL(g, sx, sy, k, [[-500, 1750], [0, 2000], [500, 1750]], '#f8c020'); });\ndef('surfrack', .14, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -400, 0, 800, 60, '#8a5a3a'); ['#3ac0e0', '#f8a020', '#f05a8a'].forEach((c, i) => PL(g, sx, sy, k, [[-300 + i * 250, 0], [-220 + i * 250, 1200], [-140 + i * 250, 0]], c)); });\ndef('buoy', 0, false, (g, sx, sy, k, o) => { const bob = Math.sin(o.t * 2 + o.seed) * 40; D(g, sx, sy, k, 0, 120 + bob, 140, '#f04a2a'); R(g, sx, sy, k, -140, 100 + bob, 280, 40, '#ffffff'); });\ndef('sailboat', 0, false, (g, sx, sy, k, o) => { const b = Math.sin(o.t + 1) * 60; PL(g, sx, sy, k, [[-900, 100 + b], [900, 100 + b], [700, -100 + b], [-700, -100 + b]], '#ffffff'); PL(g, sx, sy, k, [[0, 150 + b], [0, 2600 + b], [800, 300 + b]], '#f8f4ec'); PL(g, sx, sy, k, [[-60, 300 + b], [-60, 2200 + b], [-700, 300 + b]], '#e85a7a'); });\ndef('volley', .1, false, (g, sx, sy, k) => { for (const x of [-900, 900]) R(g, sx, sy, k, x, 0, 40, 1300, '#e8e0d0'); R(g, sx, sy, k, -900, 900, 1840, 350, '#ffffff'); for (let i = 0; i < 9; i++) R(g, sx, sy, k, -900 + i * 220, 900, 8, 350, '#c8c8c8'); D(g, sx, sy, k, 200, 1800, 90, '#f8e040'); });\ndef('ferris', 0, false, (g, sx, sy, k, o) => { const r = 2600, cy = 3200, t = T('#e8e8f0'); PL(g, sx, sy, k, [[-1400, 0], [-80, cy], [80, cy], [1400, 0], [1200, 0], [0, cy - 300], [-1200, 0]], t.sh); for (let i = 0; i < 12; i++) { const a = o.t * .15 + i / 12 * Math.PI * 2, x = Math.cos(a) * r, y = cy + Math.sin(a) * r; px.line(g, sx, sy - cy * k, sx + x * k, sy - y * k, t.base); R(g, sx, sy, k, x - 160, y - 300, 320, 280, ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][i % 4]); if (o.night) o.glow(sx + x * k, sy - y * k, 200 * k, '#ffe080', .6); } R(g, sx, sy, k, -6000, 0, 12000, 200, '#8a6a4a'); });\ndef('billboard', .3, true, (g, sx, sy, k, o) => { const ads = [['GELATO', 'GELATISSIMO', '#f8a0c0'], ['FIORETTI', 'BORN TO BLOOM', '#e83a3a'], ['RADIO', 'PETAL FM 88.6', '#8a5ad0'], ['HOTEL', 'VESPERA', '#2a3a6a']], a = ads[o.seed % 4]; for (const x of [-700, 600]) R(g, sx, sy, k, x, 0, 100, 1600, '#6a6a70'); R(g, sx, sy, k, -1000, 1500, 2000, 1000, '#f8f4e8'); R(g, sx, sy, k, -950, 1550, 1900, 900, a[2]); TX(g, a[0], sx, sy, k, 0, 2350, '#ffffff', 300); TX(g, a[1], sx, sy, k, 0, 1950, '#fff4c0', 200); });\n\n/* ---- fields, farms ---- */\ndef('farmhouse', .3, true, (g, sx, sy, k) => { const t = T('#e8d8b8'); R(g, sx, sy, k, -1300, 0, 2600, 1500, t.base); R(g, sx, sy, k, 600, 0, 700, 1500, t.sh); PL(g, sx, sy, k, [[-1450, 1500], [-1100, 2200], [1450, 2200], [1450, 1500]], '#c8603a'); for (const x of [-900, -300, 300]) R(g, sx, sy, k, x, 700, 300, 400, '#5a7aa0'); R(g, sx, sy, k, 1400, 0, 500, 3000, '#8a8a90'); D(g, sx, sy, k, 1650, 3100, 450, '#a0a0a8'); });\ndef('beehives', .2, true, (g, sx, sy, k) => { for (let i = 0; i < 3; i++) { R(g, sx, sy, k, -900 + i * 650, 0, 500, 500, ['#f8f0d8', '#a8d8f0', '#f8d8e8'][i]); R(g, sx, sy, k, -950 + i * 650, 500, 600, 80, '#8a6a4a'); } });\ndef('silo', .2, true, (g, sx, sy, k) => { const t = T('#c8c8d0'); R(g, sx, sy, k, -500, 0, 1000, 4200, t.base); R(g, sx, sy, k, 200, 0, 300, 4200, t.sh); D(g, sx, sy, k, 0, 4200, 500, t.lt); });\ndef('barn', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1500, 0, 3000, 2000, '#c8302a'); PL(g, sx, sy, k, [[-1700, 2000], [0, 3200], [1700, 2000]], '#5a2a2a'); R(g, sx, sy, k, -500, 0, 1000, 1400, '#f4f0e8'); PL(g, sx, sy, k, [[-500, 0], [500, 1400], [440, 1400], [-500, 80]], '#c8302a'); });\ndef('turbine', .1, true, (g, sx, sy, k, o) => { const h = 7000; PL(g, sx, sy, k, [[-140, 0], [-50, h], [50, h], [140, 0]], '#f4f4f8'); for (let i = 0; i < 3; i++) { const a = o.t * 1.6 + o.seed + i * 2.094; px.poly(g, [[sx, sy - h * k], [sx + Math.cos(a) * 3000 * k, sy - (h + Math.sin(a) * 3000) * k], [sx + Math.cos(a + .1) * 2800 * k, sy - (h + Math.sin(a + .1) * 2800) * k]], '#e8e8f0'); } D(g, sx, sy, k, 0, h, 120, '#c8c8d0'); });\ndef('haybale', .14, true, (g, sx, sy, k, o) => { const t = T('#e8c060'); D(g, sx, sy, k, 0, 420, 420, t.base); D(g, sx, sy, k, -100, 500, 250, t.lt); if (o.th && o.th.big) { D(g, sx, sy, k, 0, 1800, 900, '#f8c020'); D(g, sx, sy, k, 0, 1800, 400, '#6a3a1a'); } });\ndef('fence', 0, false, (g, sx, sy, k) => { R(g, sx, sy, k, -20, 0, 40, 400, '#a07a50'); R(g, sx, sy, k, -600, 250, 1200, 40, '#a07a50'); R(g, sx, sy, k, -600, 120, 1200, 40, '#a07a50'); });\n\n/* ---- cliffs, lake, canyon, alpine ---- */\ndef('lamp', .03, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -15, 0, 30, 1400, '#5a5a68'); R(g, sx, sy, k, -100, 1400, 200, 60, '#5a5a68'); D(g, sx, sy, k, 0, 1380, 60, '#fff0c0'); if (o.night) o.glow(sx, sy - 1380 * k, 500 * k, '#ffd890', .8); });\ndef('streetlamp', .03, false, (g, sx, sy, k, o) => { SPR(g, prop('streetlamp'), sx, sy, k, 2200, o.th && o.th.x > 0); if (o.night) o.glow(sx, sy - 2100 * k, 600 * k, '#ffd890', .9); });\ndef('village', 0, false, (g, sx, sy, k, o) => { const cs = ['#f8c8a8', '#f8e8b0', '#c8e0f0', '#f0b0b8', '#ffffff']; for (let i = 0; i < 9; i++) { const x = -3000 + i * 700, y = (i % 3) * 600 + rnd(o.seed, i) * 400; R(g, sx, sy, k, x, y, 650, 700, cs[i % 5]); PL(g, sx, sy, k, [[x - 40, y + 700], [x + 325, y + 950], [x + 690, y + 700]], '#d8704a'); R(g, sx, sy, k, x + 250, y + 200, 150, 200, '#3a5a8a'); } });\ndef('chapel', 0, false, (g, sx, sy, k) => { R(g, sx, sy, k, -600, 0, 1200, 1600, '#f8f4ec'); PL(g, sx, sy, k, [[-700, 1600], [0, 2300], [700, 1600]], '#3a6ad0'); R(g, sx, sy, k, -200, 2100, 400, 900, '#f8f4ec'); D(g, sx, sy, k, 0, 3100, 260, '#3a6ad0'); R(g, sx, sy, k, -20, 3300, 40, 300, '#e8c060'); });\ndef('boathouse', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1200, 0, 2400, 1300, '#8a5a3a'); for (let i = 0; i < 8; i++) R(g, sx, sy, k, -1200 + i * 300, 0, 30, 1300, '#6a4028'); PL(g, sx, sy, k, [[-1400, 1300], [0, 2100], [1400, 1300]], '#3a5a6a'); R(g, sx, sy, k, -600, 0, 1200, 900, '#2a1a10'); });\ndef('steamer', 0, false, (g, sx, sy, k, o) => { const x0 = Math.sin(o.t * .05) * 2000; PL(g, sx, sy, k, [[x0 - 2500, 300], [x0 + 2500, 300], [x0 + 2100, -200], [x0 - 2100, -200]], '#f4f0e8'); R(g, sx, sy, k, x0 - 1600, 300, 3200, 700, '#ffffff'); R(g, sx, sy, k, x0 - 1600, 300, 3200, 150, '#e83a3a'); R(g, sx, sy, k, x0 - 200, 1000, 400, 1200, '#2a2a30'); for (let i = 0; i < 3; i++) D(g, sx, sy, k, x0 + 100 + i * 300, 2400 + i * 300 + (o.t * 300) % 300, 200 + i * 60, '#e8e8f0'); D(g, sx, sy, k, x0 + 1900, 200, 600, '#c83a2a'); });\ndef('waterfall', .4, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -1500, 0, 3000, 5200, '#6a7a7a'); R(g, sx, sy, k, -1500, 0, 600, 5200, '#5a6868'); for (let i = 0; i < 6; i++) R(g, sx, sy, k, -700 + i * 230, 0, 200, 5000, ((Math.floor(o.t * 10) + i) % 3) ? '#d8f0ff' : '#a8d8f8'); for (let i = 0; i < 5; i++) D(g, sx, sy, k, -800 + i * 400, 200 + ((o.t * 900 + i * 300) % 500), 260, '#ffffff'); });\ndef('mesa', 0, false, (g, sx, sy, k, o) => { const h = 4000 + rnd(o.seed, 1) * 3000, t = T('#c86a4a'); PL(g, sx, sy, k, [[-2200, 0], [-1500, h], [1300, h], [2100, 0]], t.base); PL(g, sx, sy, k, [[600, h], [1300, h], [2100, 0], [1000, 0]], t.sh); R(g, sx, sy, k, -1500, h - 300, 2800, 300, t.lt); });\ndef('stand', .3, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -900, 0, 1800, 900, '#e8c88a'); PL(g, sx, sy, k, [[-1100, 900], [1100, 900], [900, 1400], [-900, 1400]], '#e83a5a'); for (let i = 0; i < 4; i++) { D(g, sx, sy, k, -600 + i * 400, 1050, 120, '#f8f0e0'); PL(g, sx, sy, k, [[-720 + i * 400, 1100], [-600 + i * 400, 1500], [-480 + i * 400, 1100]], '#e83a3a'); } TX(g, 'GNOMES', sx, sy, k, 0, 650, '#6a2a1a', 220); });\ndef('chalet', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1300, 0, 2600, 1600, '#c88a5a'); R(g, sx, sy, k, -1300, 0, 2600, 500, '#f4f0e8'); PL(g, sx, sy, k, [[-1700, 1500], [0, 2700], [1700, 1500]], '#6a3a2a'); PL(g, sx, sy, k, [[-1500, 1600], [0, 2600], [1500, 1600]], '#f8f8ff'); R(g, sx, sy, k, -800, 1000, 500, 350, '#4a5a8a'); R(g, sx, sy, k, 300, 1000, 500, 350, '#4a5a8a'); for (let i = 0; i < 6; i++) D(g, sx, sy, k, -700 + i * 300, 950, 90, '#e83a5a'); });\ndef('cow', .1, true, (g, sx, sy, k, o) => { const f = o.seed & 1 ? 1 : -1; R(g, sx, sy, k, -500, 400, 1000, 500, '#f8f8f8'); R(g, sx, sy, k, -300, 600, 300, 250, '#2a2a2a'); R(g, sx, sy, k, f * 450 - 180, 550, 360, 380, '#f8f8f8'); R(g, sx, sy, k, f * 450 - 180, 550, 360, 120, '#f0b0b0'); for (const x of [-450, -150, 250, 400]) R(g, sx, sy, k, x, 0, 80, 400, '#e8e8e8'); });\n\n/* ---- town, vineyard ---- */\ndef('stall', .12, true, (g, sx, sy, k, o) => { const c = ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][o.seed % 4]; R(g, sx, sy, k, -600, 0, 1200, 700, '#a0704a'); for (let i = 0; i < 6; i++) PL(g, sx, sy, k, [[-600 + i * 200, 1300], [-500 + i * 200, 1100], [-400 + i * 200, 1300]], i % 2 ? c : '#ffffff'); R(g, sx, sy, k, -600, 1300, 1200, 120, c); for (let i = 0; i < 8; i++) D(g, sx, sy, k, -500 + i * 140, 760, 70, ['#ff6aa0', '#f8e040', '#ffffff', '#a060ff'][i % 4]); });\ndef('dome', 0, false, (g, sx, sy, k) => { const t = T('#e8d8c0'); R(g, sx, sy, k, -2200, 0, 4400, 3000, t.base); for (let i = 0; i < 5; i++) R(g, sx, sy, k, -1900 + i * 900, 400, 300, 1800, t.sh); D(g, sx, sy, k, 0, 3600, 1500, '#c8603a'); R(g, sx, sy, k, -1500, 3000, 3000, 600, t.base); R(g, sx, sy, k, -150, 5000, 300, 600, t.lt); D(g, sx, sy, k, 0, 5700, 150, '#e8c060'); });\ndef('fountain', .4, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -1200, 0, 2400, 400, '#d8d0c0'); R(g, sx, sy, k, -200, 400, 400, 1000, '#c8c0b0'); D(g, sx, sy, k, 0, 1400, 400, '#d8d0c0'); for (let i = -3; i <= 3; i++) { const h = 1400 + Math.abs(Math.sin(o.t * 4 + i)) * 400; px.line(g, sx, sy - h * k, sx + i * 300 * k, sy - 500 * k, '#a8e0ff'); } });\ndef('villa', .3, true, (g, sx, sy, k) => { R(g, sx, sy, k, -1500, 0, 3000, 1500, '#f0d8b0'); PL(g, sx, sy, k, [[-1700, 1500], [0, 2100], [1700, 1500]], '#c8603a'); for (const x of [-1100, -400, 300, 1000]) R(g, sx, sy, k, x, 600, 250, 500, '#4a6a4a'); R(g, sx, sy, k, 1100, 1500, 300, 1100, '#f0d8b0'); });\ndef('barrel', .06, true, (g, sx, sy, k) => SPR(g, prop('barrel'), sx, sy, k, 500));\ndef('cart', .2, true, (g, sx, sy, k) => { R(g, sx, sy, k, -600, 300, 1200, 400, '#8a5a3a'); for (let i = 0; i < 5; i++) D(g, sx, sy, k, -450 + i * 220, 800, 140, '#6a2a5a'); D(g, sx, sy, k, -400, 250, 250, '#4a3020'); D(g, sx, sy, k, 400, 250, 250, '#4a3020'); });\ndef('castle', 0, false, (g, sx, sy, k) => { const t = T('#c8b8a0'); PL(g, sx, sy, k, [[-5000, 0], [-2000, 2000], [2500, 2200], [5000, 0]], '#6a8a48'); R(g, sx, sy, k, -2200, 2000, 4400, 2200, t.base); for (let i = 0; i < 11; i++) if (i % 2) R(g, sx, sy, k, -2200 + i * 400, 4200, 400, 300, t.base); for (const x of [-2600, 1800]) { R(g, sx, sy, k, x, 2000, 800, 3600, t.sh); PL(g, sx, sy, k, [[x - 100, 5600], [x + 400, 6800], [x + 900, 5600]], '#5a3a5a'); } });\n\n/* ---- lagoon, jungle, night ---- */\ndef('flamingo', .05, false, (g, sx, sy, k, o) => { const up = Math.sin(o.t * 3 + o.seed) > .95 ? 300 : 0, c = '#ff8ab0'; R(g, sx, sy, k, -10, 0, 20, 700 + up, '#e8708a'); D(g, sx, sy, k, 0, 800 + up, 180, c); px.line(g, sx, sy - (850 + up) * k, sx + 60 * k, sy - (1300 + up) * k, c); D(g, sx, sy, k, 80, 1320 + up, 60, c); R(g, sx, sy, k, 120, 1300 + up, 60, 20, '#2a2a2a'); });\ndef('saltpile', .1, true, (g, sx, sy, k) => { PL(g, sx, sy, k, [[-600, 0], [0, 800], [600, 0]], '#f8f8ff'); PL(g, sx, sy, k, [[0, 800], [600, 0], [200, 0]], '#d8d8f0'); });\ndef('liftbridge', 0, false, (g, sx, sy, k, o) => { for (const x of [-1600, 1400]) R(g, sx, sy, k, x, 0, 200, 4200, '#7a5a8a'); R(g, sx, sy, k, -1700, 4000, 3400, 300, '#7a5a8a'); TX(g, 'PONTE ROSA', sx, sy, k, 0, 4380, '#ffe0f0', 260); });\ndef('ruin', .4, true, (g, sx, sy, k) => { const t = T('#9aa08a'); R(g, sx, sy, k, -1500, 0, 600, 2600, t.base); R(g, sx, sy, k, 900, 0, 600, 2000, t.sh); R(g, sx, sy, k, -1500, 2300, 2200, 400, t.base); D(g, sx, sy, k, -1100, 2700, 400, '#3a8a3a'); D(g, sx, sy, k, 1200, 2100, 300, '#3a8a3a'); });\ndef('neon', .1, true, (g, sx, sy, k, o) => { const msgs = [['GELATO', '#ff5aa0'], ['CASINO', '#ffe040'], ['BAR', '#40e0ff'], ['HOTEL', '#a060ff'], ['FIORI', '#60ff90'], ['DISCO', '#ff8040']], m = msgs[o.seed % 6], on = (Math.floor(o.t * 2 + o.seed) % 7) !== 0; R(g, sx, sy, k, -40, 0, 80, 1600, '#3a3a48'); R(g, sx, sy, k, -900, 1600, 1800, 700, '#1a1a28'); if (on) { TX(g, m[0], sx, sy, k, 0, 2200, m[1], 360); o.glow(sx, sy - 1950 * k, 1100 * k, m[1], .7); } });\ndef('yacht', 0, false, (g, sx, sy, k, o) => { PL(g, sx, sy, k, [[-1800, 300], [1800, 300], [1500, -100], [-1600, -100]], '#f8f8ff'); R(g, sx, sy, k, -1000, 300, 1800, 500, '#f0f0f8'); R(g, sx, sy, k, -800, 450, 1400, 150, '#2a3a6a'); if (o.night) for (let i = 0; i < 5; i++) o.glow(sx + (-800 + i * 350) * k, sy - 520 * k, 160 * k, '#ffe0a0', .7); });\ndef('casino', 0, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -2500, 0, 5000, 3500, '#2a2040'); for (let i = 0; i < 8; i++) { const a = i / 8 * Math.PI * 2 + o.t * .4, c = i % 2 ? '#ff5ab0' : '#ffd040'; px.poly(g, [[sx, sy - 5200 * k], [sx + Math.cos(a) * 1500 * k, sy - (5200 + Math.sin(a) * 1500) * k], [sx + Math.cos(a + .35) * 1500 * k, sy - (5200 + Math.sin(a + .35) * 1500) * k]], c); } D(g, sx, sy, k, 0, 5200, 400, '#ffffff'); o.glow(sx, sy - 5200 * k, 2600 * k, '#ff70c0', .8); TX(g, 'CASINO FIORE', sx, sy, k, 0, 3100, '#ffe060', 360); for (let i = 0; i < 12; i++) R(g, sx, sy, k, -2200 + i * 380, 600 + (i % 3) * 800, 200, 300, '#ffe080'); });\ndef('motel', .3, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -60, 0, 120, 2400, '#3a3a48'); R(g, sx, sy, k, -1000, 2400, 2000, 900, '#2a1a3a'); const on = Math.floor(o.t * 3) % 6 !== 0; if (on) { TX(g, 'MOTEL', sx, sy, k, 0, 3150, '#ff4a7a', 380); o.glow(sx, sy - 2850 * k, 1200 * k, '#ff4a7a', .7); } TX(g, 'VACANCY', sx, sy, k, 0, 2650, '#60ffb0', 220); });\ndef('dish', 0, false, (g, sx, sy, k) => { R(g, sx, sy, k, -200, 0, 400, 2500, '#c8c8d8'); PL(g, sx, sy, k, [[-2200, 4200], [0, 2400], [2200, 4800], [1600, 5600], [-1600, 5200]], '#e8e8f4'); R(g, sx, sy, k, -40, 4000, 80, 900, '#a8a8b8'); });\ndef('stone', .1, true, (g, sx, sy, k, o) => { const h = 1600 + rnd(o.seed, 1) * 1200, t = T('#8a8a9a'); PL(g, sx, sy, k, [[-350, 0], [-280, h], [250, h * .95], [350, 0]], t.base); PL(g, sx, sy, k, [[100, 0], [180, h * .95], [250, h * .95], [350, 0]], t.sh); });\ndef('sheep', .08, true, (g, sx, sy, k, o) => { const f = o.seed & 1 ? 1 : -1; D(g, sx, sy, k, 0, 450, 380, '#f4f4f0'); D(g, sx, sy, k, f * 300, 550, 160, '#2a2a2a'); for (const x of [-200, 150]) R(g, sx, sy, k, x, 0, 60, 250, '#2a2a2a'); });\ndef('castleruin', 0, false, (g, sx, sy, k) => { const t = T('#6a6a7a'); R(g, sx, sy, k, -2500, 0, 1000, 4500, t.base); R(g, sx, sy, k, -1500, 0, 2600, 2500, t.sh); R(g, sx, sy, k, 1100, 0, 900, 3400, t.base); for (let i = 0; i < 4; i++) R(g, sx, sy, k, -2500 + i * 280, 4500, 160, 300, t.base); R(g, sx, sy, k, -2200, 2600, 300, 600, '#1a1a2a'); });\n\n/* ---- spans over the road (o.rw: half the road in pixels) ---- */\nconst span = (name, fn) => def('span_' + name, 0, false, fn);\nspan('palms', (g, sx, sy, k, o) => { const W = o.rw / k * 1.35, t = T('#3a9a4a'); for (const s of [-1, 1]) { R(g, sx, sy, k, s * W - 80, 0, 160, 3000, '#8a6a3a'); PL(g, sx, sy, k, [[s * W, 3000], [s * W * .2, 3600], [0, 3300], [s * W * .3, 3200]], t.base); PL(g, sx, sy, k, [[s * W, 3000], [s * W * .5, 3900], [s * W * .1, 3700]], t.sh); } });\nspan('gallery', (g, sx, sy, k, o) => { const W = o.rw / k * 1.3; R(g, sx, sy, k, W - 300, 0, 400, 2800, '#c8b090'); R(g, sx, sy, k, -W - 100, 0, 200, 2800, '#d8c8a8'); R(g, sx, sy, k, -W - 100, 2600, W * 2 + 400, 500, '#b8a080'); });\nspan('truss', (g, sx, sy, k, o) => { const W = o.rw / k * 1.25; for (const s of [-1, 1]) R(g, sx, sy, k, s * W - 60, 0, 120, 2400, '#8a4a2a'); R(g, sx, sy, k, -W, 2300, W * 2, 140, '#8a4a2a'); px.line(g, sx - W * k, sy - 2300 * k, sx, sy - 400 * k, '#7a3a20'); px.line(g, sx + W * k, sy - 2300 * k, sx, sy - 400 * k, '#7a3a20'); });\nspan('bunting', (g, sx, sy, k, o) => { const W = o.rw / k * 1.3, cs = ['#e83a5a', '#f8c020', '#3a9ae8', '#3ac080', '#ffffff']; for (let i = 0; i < 12; i++) { const x = -W + i * W / 6, y = 2600 - Math.sin(i / 11 * Math.PI) * 400; PL(g, sx, sy, k, [[x, y], [x + W / 6, y], [x + W / 12, y - 260]], cs[i % 5]); } });\nspan('canopy', (g, sx, sy, k, o) => { const W = o.rw / k * 1.4, t = T('#1a6a2a'); PL(g, sx, sy, k, [[-W - 600, 2600], [-W * .2, 3400], [0, 3000], [W * .3, 3500], [W + 600, 2600], [W + 600, 3800], [-W - 600, 3800]], t.sh); D(g, sx, sy, k, -W * .5, 3200, 600, t.base); D(g, sx, sy, k, W * .4, 3300, 500, t.base); if (!o.night) px.blend(g, .25, 'add', () => PL(g, sx, sy, k, [[-W * .3, 3000], [-W * .1, 3000], [W * .3, 0], [W * .1, 0]], '#fff4c0')); });\ndef('checkpoint', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.25, t = T('#3ac080'); for (const s of [-1, 1]) { R(g, sx, sy, k, s * W - 150, 0, 300, 3000, '#f4f4f8'); for (let i = 0; i < 6; i++) D(g, sx, sy, k, s * W, 400 + i * 450, 230, ['#ff6aa0', '#f8e040', '#ffffff'][i % 3]); } R(g, sx, sy, k, -W, 2700, W * 2, 700, t.base); R(g, sx, sy, k, -W, 2700, W * 2, 120, t.sh); TX(g, 'CHECKPOINT', sx, sy, k, 0, 3300, '#ffffff', 420); });\ndef('goalarch', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.3; for (const s of [-1, 1]) { R(g, sx, sy, k, s * W - 200, 0, 400, 3600, '#f8e8f0'); for (let i = 0; i < 8; i++) D(g, sx, sy, k, s * W, 300 + i * 420, 260, ['#ff5aa0', '#ffd040', '#ffffff', '#ff8a40'][i % 4]); } R(g, sx, sy, k, -W, 3200, W * 2, 900, '#e83a6a'); for (let i = 0; i < 16; i++) R(g, sx, sy, k, -W + i * W / 8, 3200, W / 16, 120, i % 2 ? '#ffffff' : '#2a2a2a'); const goal = o.th && o.th.goal; TX(g, goal ? 'GOAL ' + goal : 'GOAL', sx, sy, k, 0, 3900, '#fff4c0', 520); });\ndef('sprintarch', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.3; for (const s of [-1, 1]) R(g, sx, sy, k, s * W - 160, 0, 320, 3200, '#ffffff'); R(g, sx, sy, k, -W, 2800, W * 2, 800, '#ff8a2a'); for (let i = 0; i < 16; i++) R(g, sx, sy, k, -W + i * W / 8, 2800, W / 16, 140, i % 2 ? '#ffffff' : '#2a2a2a'); TX(g, 'FINISH', sx, sy, k, 0, 3450, '#ffffff', 460); });\ndef('startgantry', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k * 1.3, lights = o.th && o.th.lights || 0; for (const s of [-1, 1]) R(g, sx, sy, k, s * W - 150, 0, 300, 3400, '#3a3a48'); R(g, sx, sy, k, -W, 3000, W * 2, 800, '#2a2a38'); for (let i = 0; i < 5; i++) { const on = i < lights, c = lights >= 6 ? '#40ff70' : on ? '#ff3a3a' : '#4a2a2a'; D(g, sx, sy, k, -1200 + i * 600, 3400, 220, c); if (on || lights >= 6) o.glow(sx + (-1200 + i * 600) * k, sy - 3400 * k, 500 * k, c, .8); } TX(g, 'COAST 2 COAST', sx, sy, k, 0, 4200, '#ffd8a0', 300); });\ndef('gridline', 0, false, (g, sx, sy, k, o) => { const W = o.rw / k; for (let i = 0; i < 12; i++) R(g, sx, sy, k, -W + i * W / 6, 0, W / 12, 60, i % 2 ? '#ffffff' : '#2a2a2a'); });\ndef('cushion', .14, true, (g, sx, sy, k, o) => { for (const x of [-180, 180]) { R(g, sx, sy, k, x - 160, 0, 320, 380, '#e85a2a'); R(g, sx, sy, k, x - 160, 260, 320, 60, '#f8f0e0'); D(g, sx, sy, k, x, 460, 160, '#ff70a0'); } });\ndef('forksign', .2, true, (g, sx, sy, k, o) => {\n  const V = o.V, next = V && OB.forkOf(V.stage); if (!next) return;\n  for (const x of [-600, 500]) R(g, sx, sy, k, x, 0, 100, 1800, '#6a6a78');\n  R(g, sx, sy, k, -2600, 1800, 5200, 1500, '#1a4a8a'); R(g, sx, sy, k, -2550, 1850, 5100, 1400, '#2a6ad0'); R(g, sx, sy, k, -40, 1850, 80, 1400, '#ffffff');\n  const [L, Rr] = next.map(id => OB.STAGES[id]);\n  TX(g, '\\u2190 ' + L.name.toUpperCase(), sx, sy, k, -1300, 2950, '#ffffff', 230); TX(g, Rr.name.toUpperCase() + ' \\u2192', sx, sy, k, 1300, 2950, '#ffffff', 230);\n  for (let i = 0; i < 5; i++) { D(g, sx, sy, k, -2000 + i * 300, 2200, 100, i < L.diff ? '#ffd040' : '#3a5a9a'); D(g, sx, sy, k, 800 + i * 300, 2200, 100, i < Rr.diff ? '#ffd040' : '#3a5a9a'); }\n  if (V.closed) { const cx = V.closed < 0 ? -1300 : 1300; R(g, sx, sy, k, cx - 1200, 2400, 2400, 300, '#e83a3a'); TX(g, 'ROAD CLOSED', sx, sy, k, cx, 2650, '#ffffff', 200); }\n});\ndef('barrier', .9, true, (g, sx, sy, k, o) => { const W = o.rw / k * 1.05; for (let i = 0; i < 10; i++) R(g, sx, sy, k, -W + i * W / 5, 300, W / 5, 300, i % 2 ? '#ffffff' : '#e83a3a'); for (const s of [-1, 1]) R(g, sx, sy, k, s * W * .8 - 40, 0, 80, 650, '#3a3a48'); TX(g, 'ROAD CLOSED', sx, sy, k, 0, 1100, '#ffe040', 260); });\ndef('crowd', 0, false, (g, sx, sy, k, o) => { const c = ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080', '#a060e0'], up = Math.floor(o.t * 4 + o.seed) % 2; for (let i = 0; i < 3; i++) { const x = -400 + i * 400, sk = ['#f0c8a0', '#c89070', '#8a5a3a'][(o.seed + i) % 3]; R(g, sx, sy, k, x - 120, 0, 240, 900, c[(o.seed + i) % 5]); D(g, sx, sy, k, x, 1050, 150, sk); R(g, sx, sy, k, x - 160, up && i % 2 ? 1000 : 600, 60, 400, sk); R(g, sx, sy, k, x + 100, !up && i % 2 === 0 ? 1000 : 600, 60, 400, sk); } });\nOB.artNames = () => Object.keys(ART);\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CU3di4zQ4Qg9ajJKVDL2tF","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/11-art.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"b31a73a4-a38b-4945-9f7b-620b7871a8e6","uuid":"b9fbc643-9a2a-456e-921e-afe09b89c4ab","timestamp":"2026-11-04T11:11:23.614Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-035151__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-opus-5-5-medium-20261104-035151/src/11-art.js","content":"/* Roadside art (PLAN §9.4): every piece of scenery, landmark, span, arch and sign, drawn in world units by code with\n * E.px and shaded with E.tones, so it scales cleanly with distance. OB.ART[name] = { w (half roads it blocks),\n * solid, draw(g, sx, sy, k, o) } where (sx, sy) is its foot on screen and k the pixels per world unit. Engine props\n * (E.prop) are used for the generic plants and furniture. */\n(() => {\n'use strict';\nconst OB = window.OB, E = OB.E, { px } = E;\nconst T = c => E.tones(c);\n// unit-space helpers: x across from the foot, y up from the ground, both in world units\nconst R = (g, sx, sy, k, x, y, w, h, c) => { const W = w * k, H = h * k; if (W < .4 && H < .4) return; px.rect(g, Math.round(sx + x * k), Math.round(sy - (y + h) * k), Math.max(1, Math.round(W)), Math.max(1, Math.round(H)), c); };\nconst D = (g, sx, sy, k, x, y, r, c) => { if (r * k < .5) return px.dot(g, sx + x * k, sy - y * k, c); px.disc(g, sx + x * k, sy - y * k, r * k, c); };\nconst PL = (g, sx, sy, k, pts, c) => px.poly(g, pts.map(([x, y]) => [sx + x * k, sy - y * k]), c);\nconst TX = (g, s, sx, sy, k, x, y, c, size) => { const sc = Math.max(1, Math.floor(size * k / 7)); if (size * k < 5) return; E.font.text(g, s, Math.round(sx + x * k), Math.round(sy - y * k), c, { align: 'center', scale: sc, outline: false }); };\nconst PROPS = {};\nconst prop = (name, o) => { const key = name + JSON.stringify(o || {}); if (!PROPS[key]) { try { PROPS[key] = E.prop(name, o || {}).frames[0]; } catch (e) { PROPS[key] = null; } } return PROPS[key]; };\nconst SPR = (g, spr, sx, sy, k, hUnits, flip) => { if (!spr || !spr.cv) return; const sc = hUnits / spr.h * k, w = spr.w * sc, h = spr.h * sc; if (w < .5) return; if (flip) { g.save(); g.translate(Math.round(sx), 0); g.scale(-1, 1); g.drawImage(spr.cv, Math.round(-w / 2), Math.round(sy - h), Math.max(1, Math.round(w)), Math.max(1, Math.round(h))); g.restore(); } else g.drawImage(spr.cv, Math.round(sx - w / 2), Math.round(sy - h), Math.max(1, Math.round(w)), Math.max(1, Math.round(h))); };\nconst rnd = (seed, i) => ((Math.imul(seed + 1, 2654435761) ^ (i * 40503)) >>> 0) % 1000 / 1000;\nOB.artHelpers = { R, D, PL, TX, SPR, prop, T };\n\nconst ART = OB.ART = {};\nconst def = (name, w, solid, draw) => { ART[name] = { w, solid, draw }; };\n\n/* ---- plants ---- */\ndef('palm', .12, true, (g, sx, sy, k, o) => SPR(g, prop('palm'), sx, sy, k, 3400 + rnd(o.seed, 1) * 900, o.seed & 1));\ndef('pine', .14, true, (g, sx, sy, k, o) => SPR(g, prop('pine'), sx, sy, k, 3600 + rnd(o.seed, 1) * 1400, o.seed & 1));\ndef('bush', .1, false, (g, sx, sy, k, o) => SPR(g, prop('bush'), sx, sy, k, 700 + rnd(o.seed, 2) * 300, o.seed & 1));\ndef('cactus', .1, true, (g, sx, sy, k, o) => { SPR(g, prop('cactus'), sx, sy, k, 1500 + rnd(o.seed, 1) * 900, o.seed & 1); if (rnd(o.seed, 3) < .5) D(g, sx, sy, k, 60, 1500, 70, '#ff6ab0'); });\ndef('rock', .14, true, (g, sx, sy, k, o) => SPR(g, prop('rock'), sx, sy, k, 600 + rnd(o.seed, 1) * 600, o.seed & 1));\ndef('cypress', .07, true, (g, sx, sy, k, o) => { const h = 3200 + rnd(o.seed, 1) * 1200, t = T('#2a6a3a'); R(g, sx, sy, k, -40, 0, 80, 300, '#5a3a2a'); PL(g, sx, sy, k, [[-260, 250], [0, h], [260, 250]], t.sh); PL(g, sx, sy, k, [[-200, 300], [0, h], [40, 300]], t.base); PL(g, sx, sy, k, [[-120, 500], [-20, h * .85], [0, 600]], t.lt); });\ndef('lemon', .12, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -50, 0, 100, 700, '#6a4a2a'); D(g, sx, sy, k, 0, 1100, 600, '#3a8a3a'); D(g, sx, sy, k, -150, 1250, 380, '#4aa048'); for (let i = 0; i < 7; i++) D(g, sx, sy, k, -400 + rnd(o.seed, i) * 800, 800 + rnd(o.seed, i + 9) * 700, 70, '#f8e040'); });\ndef('cherry', .12, true, (g, sx, sy, k, o) => { R(g, sx, sy, k, -60, 0, 120, 900, '#5a3a3a'); const t = T('#f8a8c8'); D(g, sx, sy, k, 0, 1400, 750, t.sh); D(g, sx, sy, k, -200, 1550, 520, t.base); D(g, sx, sy, k, 250, 1300, 420, t.lt); D(g, sx, sy, k, -100, 1700, 220, t.hi); });\ndef('leaf', .06, false, (g, sx, sy, k, o) => { const t = T('#2a9a3a'), f = o.seed & 1 ? 1 : -1; PL(g, sx, sy, k, [[0, 0], [f * 300, 900], [f * 700, 1300], [f * 400, 500]], t.base); PL(g, sx, sy, k, [[0, 0], [f * 700, 1300], [f * 550, 700]], t.sh); });\ndef('fern', .05, false, (g, sx, sy, k, o) => { const t = T('#3aa04a'); for (let i = -2; i <= 2; i++) PL(g, sx, sy, k, [[0, 0], [i * 220 - 60, 500 + Math.abs(i) * -60], [i * 260, 520], [i * 200 + 60, 480]], i % 2 ? t.sh : t.base); });\ndef('orchid', .04, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -10, 0, 20, 500, '#2a6a2a'); for (let i = 0; i < 3; i++) { const c = ['#e060ff', '#ff70c0', '#ffffff'][(o.seed + i) % 3]; D(g, sx, sy, k, -100 + i * 100, 450 + i * 60, 70, c); o.glow(sx + (-100 + i * 100) * k, sy - (450 + i * 60) * k, 150 * k, c, .6); } });\ndef('nightcactus', .1, true, (g, sx, sy, k, o) => { SPR(g, prop('cactus', { color: '#2a5a4a' }), sx, sy, k, 1500, o.seed & 1); for (let i = 0; i < 3; i++) { D(g, sx, sy, k, -150 + i * 150, 1300 + (i & 1) * 200, 70, '#ffffff'); o.glow(sx + (-150 + i * 150) * k, sy - (1300 + (i & 1) * 200) * k, 200 * k, '#e0f0ff', .7); } });\n\n/* ---- the beach ---- */\ndef('umbrella', .1, false, (g, sx, sy, k, o) => { const c = ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][o.seed % 4]; R(g, sx, sy, k, -12, 0, 24, 900, '#e8e0d0'); PL(g, sx, sy, k, [[-560, 800], [0, 1060], [560, 800]], c); PL(g, sx, sy, k, [[-560, 800], [-190, 950], [-190, 800]], '#ffffff'); PL(g, sx, sy, k, [[190, 800], [190, 950], [560, 800]], '#ffffff'); R(g, sx, sy, k, -400, 0, 300, 120, '#f4f0e8'); });\ndef('hut', .3, true, (g, sx, sy, k, o) => { const c = ['#f8c8d8', '#a8e0f0', '#f8e8a0', '#c8f0c8'][o.seed % 4], t = T(c); R(g, sx, sy, k, -500, 0, 1000, 900, t.base); for (let i = 0; i < 5; i++) R(g, sx, sy, k, -500 + i * 200, 0, 100, 900, t.lt); PL(g, sx, sy, k, [[-620, 900], [0, 1400], [620, 900]], '#e85a4a'); R(g, sx, sy, k, -150, 0, 300, 600, t.deep); });\ndef('lifeguard', .2, true, (g, sx, sy, k) => { for (const x of [-350, 330]) R(g, sx, sy, k, x, 0, 30, 1300, '#f4f4f4'); R(g, sx, sy, k, -420, 1300, 840, 450, '#e83a3a'); R(g, sx, sy, k, -420, 1600, 840, 80, '#ffffff'); PL(g, sx, sy, k, [[-500, 1750], [0, 2000], [500, 1750]], '#f8c020'); });\ndef('surfrack', .14, false, (g, sx, sy, k, o) => { R(g, sx, sy, k, -400, 0, 800, 60, '#8a5a3a'); ['#3ac0e0', '#f8a020', '#f05a8a'].forEach((c, i) => PL(g, sx, sy, k, [[-300 + i * 250, 0], [-220 + i * 250, 1200], [-140 + i * 250, 0]], c)); });\ndef('buoy', 0, false, (g, sx, sy, k, o) => { const bob = Math.sin(o.t * 2 + o.seed) * 40; D(g, sx, sy, k, 0, 120 + bob, 140, '#f04a2a'); R(g, sx, sy, k, -140, 100 + bob, 280, 40, '#ffffff'); });\ndef('sailboat', 0, false, (g, sx, sy, k, o) => { const b = Math.sin(o.t + 1) * 60; PL(g, sx, sy, k, [[-900, 100 + b], [900, 100 + b], [700, -100 + b], [-700, -100 + b]], '#ffffff'); PL(g, sx, sy, k, [[0, 150 + b], [0, 2600 + b], [800, 300 + b]], '#f8f4ec'); PL(g, sx, sy, k, [[-60, 300 + b], [-60, 2200 + b], [-700, 300 + b]], '#e85a7a'); });\ndef('volley', .1, false, (g, sx, sy, k) => { for (const x of [-900, 900]) R(g, sx, sy, k, x, 0, 40, 1300, '#e8e0d0'); R(g, sx, sy, k, -900, 900, 1840, 350, '#ffffff'); for (let i = 0; i < 9; i++) R(g, sx, sy, k, -900 + i * 220, 900, 8, 350, '#c8c8c8'); D(g, sx, sy, k, 200, 1800, 90, '#f8e040'); });\ndef('ferris', 0, false, (g, sx, sy, k, o) => { const r = 2600, cy = 3200, t = T('#e8e8f0'); PL(g, sx, sy, k, [[-1400, 0], [-80, cy], [80, cy], [1400, 0], [1200, 0], [0, cy - 300], [-1200, 0]], t.sh); for (let i = 0; i < 12; i++) { const a = o.t * .15 + i / 12 * Math.PI * 2, x = Math.cos(a) * r, y = cy + Math.sin(a) * r; px.line(g, sx, sy - cy * k, sx + x * k, sy - y * k, t.base); R(g, sx, sy, k, x - 160, y - 300, 320, 280, ['#e83a5a', '#3a9ae8', '#f8c020', '#3ac080'][i % 4]); if (o.night) o.glow(sx + x * k, sy - y * k, 200 * k, '#ffe080', .6); } R(g, sx, sy, k, -6000, 0, 12000, 200, '#8a6a4a'); });\ndef('billboard', .3, true, (g, sx, sy, k, o) => { const ads = [['GELATO', 'GELATISSIMO', '#f8a0c0'], ['FIORETTI', 'BORN TO BLOOM', '#e83a3a'], ['RADIO', 'PETAL FM 88.6', '#8a5ad0'], ['HOTEL', 'VESPERA', '#2a3a6a']], a = ads[o.seed % 4]; for (const x of [-700, 600]) R(g, sx, sy, k, x, 0, 100, 1600, '#6a6a70'); R(g, sx, sy, k, -1000, 1500, 2000, 1000, '#f8f4e8'); R(g, sx, sy, k, -950, 1550, 1900, 900, a[2]); TX(g, a[0], sx, sy, k, 0, 2350, '#ffffff', 300); TX(g, a[1], sx, sy, k, 0, 1950, '#fff4c0', 200); });\n\n/* ---- fields, farms ---- */\ndef('farmhouse', .3, true, (g, sx, sy, k) => { const t = T('#e8d8b8'); R(g, sx, sy, k, -1300, 0, 2600, 1500, t.base); R(g, sx, sy, k, 600, 0, 700, 1500, t.sh); PL(g, sx, sy, k, [[-1450, 1500], [-1100, 2200], [1450, 2200], [1450, 1500]], '#c8603a'); for (const x of [-900, -300, 300]) R(g, sx, sy, k, x, 700, 300, 400, '#5a7aa0'); R(g, sx, sy, k, 1400, 0, 500, 3000, '#8a8a90'); D(g, sx, sy, k, 1650, 3100, 450, '#a0a0a8'); });\ndef('beehives', .2, true, (g, sx, sy, k) => { for (let i = 0; i < 3; i++) { R(g, sx, sy, k, -900 + i * 650, 0, 500, 500, ['#f8f0d8', '#a8d8f0', '#f8d8e8'][i]); R(g, sx, sy, k, -950 + i * 650, 500, 600, 80, '#8a6a4a'); } });\ndef('silo', .2, true, (g, sx, sy, k) => { const t = T('#c8c8d0'); R(g, sx, sy, k, -500, 0, 1000, 4200, t.base); R(