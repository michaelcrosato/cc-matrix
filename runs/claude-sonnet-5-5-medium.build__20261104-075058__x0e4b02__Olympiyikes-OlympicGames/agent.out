ess tests)\nO.store = {\n  get: (k, d) => { if (k in mem) return JSON.parse(mem[k]); try { const v = E.store.get('oly:' + k, d); return v === null || v === undefined ? d : v; } catch (e) { return d; } },\n  set: (k, v) => { mem[k] = JSON.stringify(v === undefined ? null : v); try { E.store.set('oly:' + k, v); } catch (e) { /* ignore */ } }\n};\n\"\"\"\ns=s.replace(old,new); open(p,'w').write(s)\nEOF\nnode tests/misc.mjs 2>&1 | head"}},"wire_ingest_context":{"toolu_01BFf7rMapWGjQoEbeVPjVuG":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-075058__x0e4b02/work/Olympiyikes-OlympicGames-claude-sonnet-5-5-medium-20261104-075058"}}}
