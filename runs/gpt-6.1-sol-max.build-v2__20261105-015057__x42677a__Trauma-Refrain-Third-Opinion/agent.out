{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); cat >> \"$d/engine/crates/pav_core/tests/surgery.rs\" <<'\"'EOF'\n#[test]\nfn careless_extraction_is_sloppy_and_tears_tissue(){\n let mut g=Surgery::new(0,false,false);let p=g.hazards[1].pos;let mut f=[SurgeonInput::default();4];f[0]=SurgeonInput{active:true,aim:p,tool:1,held:USE,pressure:1.,..Default::default()};g.tick(f,1./60.);f[0].aim+=glam::Vec2::X*1.2;g.tick(f,1./60.);\n assert\"'!(g.coverage.contains_key(\"rating:SLOPPY\"));assert!(!g.hazards[1].alive);assert!(g.hazards.iter().any(|h|h.kind==\"laceration\"&&h.alive));assert_eq!(g.surgeons[0].chain,0);\n}\n#[test]\nfn iv_release_and_shock_timing_change_the_patient(){\n let mut g=Surgery::new(0,false,false);g.vitals=40.;let mut f=[SurgeonInput::default();4];f[0]=SurgeonInput{active:true,tool:7,held:USE,pressure:1.,..Default::default()};for _ in 0..104{g.tick(f,1./60.);}f[0].held=0;g.tick(f,1./60.);assert!(g.vitals>55.&&g.surgeons[0].iv_cool>3.9);\n g.start_code(1,true);f[0].held=SHOCK;for _ in 0..78{g.tick(f,1./60.);}g.beat=0.02;f[0].held=0;g.tick(f,1./60.);assert_eq!(g.shocks,0);assert_eq!(g.code,0.);assert!(g.vitals>30.);assert!(g.coverage.contains_key(\"defibrillated\"));\n}\n#[test]\nfn echo_does_not_steal_a_fourth_human_seat(){\n let mut g=Surgery::new(5,false,false);g.phase=1;g.load_phase();g.gift_kind=\"Echo\".into();g.gift_left=8.;g.surgeons[3].active=true;g.surgeons[3].cursor=glam::Vec2::new(7.,2.);\n let p=g.hazards[0].pos;let mut f=[SurgeonInput::default();4];f[0]=SurgeonInput{active:true,aim:p,tool:4,held:USE,pressure:1.,precision:true,..Default::default()};for _ in 0..65{g.tick(f,1./60.);}f[0].held=0;g.tick(f,1./60.);\n assert!(!g.surgeons[3].ghost);assert_eq!(g.surgeons[3].cursor,glam::Vec2::new(7.,2.));assert!(g.coverage.contains_key(\"echo_repeat\"));\n}\n#[test]\nfn expert_balance_measurements(){for n in 0..8{let mut g=Surgery::new(n,false,false);play(&mut g,60*900);assert_eq!(g.outcome,Outcome::Won);println!(\"BALANCE {n} score={} par={} rank={} elapsed={}\",g.total(),g.chart().par,g.rank(),g.time);}}\nEOF\ncd \"$d/engine\"; CARGO_BUILD_JOBS=6 cargo test --locked -p pav_core --test surgery -- --nocapture > ../test-core.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
