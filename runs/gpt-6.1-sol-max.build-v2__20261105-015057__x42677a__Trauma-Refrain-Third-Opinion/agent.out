{"type":"item.started","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nr=Path(Path('.game-path').read_text());p=r/'engine/crates/pav_tools/src/tools.rs';s=p.read_text();needle='fn t_input(s: &mut Session, a: &Args) -> Result<Output> {\\\\n';insert='''    if a.contains_key(\\\"surgeon\\\") {\n        use pav_core::games::surgery::{SurgeonInput, Surgery, USE, GIFT, SHOCK, CANCEL};\n        let seat = get_u64(a, \\\"surgeon\\\", 0)?.min(3) as usize;\n        let aim = vec_arg(a, \\\"aim\\\")?.unwrap_or_else(|| vec\"'![0., 0.]);\n        let mut held = 0;\n        for name in get_str(a, \"hold\").unwrap_or(\"\").split('\"',') {\n            held |= match name.trim() { \\\"use\\\" => USE, \\\"gift\\\" => GIFT, \\\"shock\\\" => SHOCK, \\\"cancel\\\" => CANCEL, \\\"\\\" => 0, other => bail\"'!(\"unknown surgical action '\"'{other}'\\\") };\n        }\n        let mut frame = pav_core::InputFrame::default();\n        frame.surgeons[seat] = SurgeonInput { active: true, aim: glam::Vec2::new(aim.first().copied().unwrap_or(0.), aim.get(1).copied().unwrap_or(0.)), tool: get_u64(a,\\\"tool\\\",1)?.min(8) as u8, held, pressure:get_f32(a,\\\"pressure\\\",1.)?, rotate:get_f32(a,\\\"rotate\\\",0.)?, ..Default::default() };\n        for _ in 0..get_u64(a,\\\"ticks\\\",1)?.max(1) { s.sim.step(&frame); s.sync_camera(); }\n        s.keep_events();\n        return Ok(Output::Json(s.sim.play().and_then(|p|p.get::<Surgery>()).map(|g|g.status_json()).unwrap_or_default()));\n    }\n''';s=s.replace(needle,needle+insert).replace('            cmd: None,\\\\n        };','            cmd: None,\\\\n            surgeons: Default::default(),\\\\n        };',1);p.write_text(s)\nPY\nd=\"'$(cat .game-path); cd \"$d/engine\"; cargo fmt --all; CARGO_BUILD_JOBS=6 cargo build --locked -p pav_tools --bin pav > ../build-native.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
