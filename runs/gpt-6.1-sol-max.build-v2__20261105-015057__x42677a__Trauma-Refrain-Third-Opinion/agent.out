{"type":"item.completed","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); tail -70 \"$d/engine/crates/pav_core/src/games/surgery/mod.rs\"'","aggregated_output":"    let d = b - a;\n    let t = ((p - a).dot(d) / d.length_squared().max(0.001)).clamp(0., 1.);\n    (p.distance(a + d * t), t)\n}\n\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let level = include_str!(\"level.toml\");\n    let def = crate::room::RoomDef::parse(level).map_err(|e| anyhow!(\"surgery/level.toml: {e}\"))?;\n    crate::scenes::build_standalone_room(sim, \"surgery\", def);\n    if let Some(id) = sim.state.player {\n        sim.despawn(id);\n    }\n    sim.state.focus = Vec3::ZERO;\n    let rest = rest.unwrap_or(\"title\");\n    let case = rest.strip_prefix(\"case/\").and_then(|n| n.parse().ok()).unwrap_or(0);\n    let mut game = Surgery::new(case, rest == \"campaign\", rest == \"codeblue\");\n    if rest == \"title\" || rest == \"card\" || rest == \"mirror\" {\n        game.mode = rest.into();\n    }\n    if rest == \"attract\" {\n        game = Surgery::new(3, false, false);\n        game.tune.bot = true;\n        game.tune.immortal = true;\n        game.surgeons[0].gift = 100.;\n    }\n    sim.state.play = Some(GameBox::new(game));\n    Ok(())\n}\nimpl Game for Surgery {\n    const KEY: &'static str = \"surgery\";\n    fn pre(\n        &mut self,\n        _sim: &mut Sim,\n        input: &InputFrame,\n        dt: f32,\n        _events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<crate::entity::EntityId, InputFrame> {\n        if self.mode == \"results\" && self.campaign && self.case < 7 {\n            let coverage = self.coverage.clone();\n            let completed = self.completed.clone();\n            let difficulty = self.difficulty;\n            let mut next = Self::new(self.case + 1, true, false);\n            next.coverage = coverage;\n            next.completed = completed;\n            next.difficulty = difficulty;\n            next.mark(&format!(\"phase:{}:0\", next.case));\n            *self = next;\n        }\n        let mut inputs = input.surgeons;\n        if self.tune.bot {\n            inputs[0] = self.bot_seat(0);\n        }\n        if self.case == 7 && !inputs[1].active && !self.blue {\n            inputs[1] = self.bot_seat(1);\n        }\n        self.tick(inputs, dt);\n        BTreeMap::new()\n    }\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        self.status_json()\n    }\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        f.surgeons[0] = self.bot_seat(0);\n        f\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_112","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\nr=Path(Path('.game-path').read_text());p=r/'engine/crates/pav_core/src/games/surgery/mod.rs';s=p.read_text().replace('''        if self.case == 7 && \"'!inputs[1].active && !self.blue {\n            inputs[1] = self.bot_seat(1);\n        }'\"''','''        if self.case == 7 && \"'!inputs[1].active && !self.blue {\n            // Pet follows the lead surgeon; she cannot finish the operation for an idle player.\n            if self.time - self.surgeons[0].last_good < 5.0 || self.tune.bot {\n                inputs[1] = self.bot_seat(1);\n            } else {\n                self.surgeons[1].held = 0;\n            }\n        }'\"''');p.write_text(s)\np=r/'engine/crates/pav_core/tests/surgery.rs';p.write_text(p.read_text()+'''\n#[test]\nfn the_partner_cannot_win_for_an_idle_lead_surgeon() {\n    let mut sim = Sim::new(\\\"surgery/case/7\\\", 2).unwrap();\n    for _ in 0..60*600 { if sim.outcome()\"'!=Outcome::Playing {break;} sim.step(&pav_core::InputFrame::default()); }\n    assert_eq!(sim.outcome(), Outcome::Lost);\n}\n'\"''')\np=r/'engine/crates/pav_core/src/games/surgery/content/cases.json';v=json.loads(p.read_text());v['cases'][7]['phases'][1]['objective']='Strip the nodules and clear the pools. Pet follows your lead.';p.write_text(json.dumps(v,indent=2)+'\\\\n')\np=r/'tools/bundle.py';s=p.read_text().replace(\\\"out=workspace/(root.name+'.html')\\\", \\\"html=html.replace('</head>','<script type=\\\\\\\"application/json\\\\\\\" id=\\\\\\\"font-license\\\\\\\">'+json.dumps({'font':'Barlow Condensed Semibold','license':(root/'vendor/Barlow-OFL.txt').read_text()},ensure_ascii=False)+'</script>\\\\\\\\n</head>')\\\\nout=workspace/(root.name+'.html')\\\")\np.write_text(s)\nPY\nd=\"'$(cat .game-path); cd \"$d/engine\"; cargo fmt --all; CARGO_BUILD_JOBS=6 cargo test --locked -p pav_core --test surgery --test games > ../test-core.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
