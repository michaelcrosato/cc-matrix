{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); cat > \"$d/engine/crates/pav_core/src/games/surgery/mod.rs\" <<'\"'EOF'\n//\"'! The First Movement: deterministic surgical action, content-driven cases and surgeon seats.\nuse std::collections::BTreeMap;\nuse anyhow::{Result, anyhow};\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse super::{Game, GameBox, Outcome};\nuse crate::{InputFrame, Sim};\nuse crate::frame::SimEvent;\n\npub const TITLE: &str = \"Trauma Refrain: Third Opinion\";\npub const USE: u32 = 1;\npub const GIFT: u32 = 2;\npub const SHOCK: u32 = 4;\npub const CANCEL: u32 = 8;\npub const TOOLS: [&str;9] = [\"Scalpel\",\"Forceps\",\"Suture\",\"Suction\",\"Laser\",\"Gel\",\"Scanner\",\"IV Push\",\"Dressing\"];\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct SurgeonInput {\n    pub active: bool,\n    pub aim: Vec2,\n    pub tool: u8,\n    pub held: u32,\n    pub pressure: f32,\n    pub rotate: f32,\n    pub assisted: bool,\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct Tune {\n    pub drain: f32, pub timer: f32, pub power: f32, pub heal: f32, pub strain_speed: f32,\n    pub toughness: f32, pub heart_coupling: f32, pub beat_window: f32, pub cursor_speed: f32,\n    pub assist: f32, pub gift_gain: f32, pub gift_duration: f32, pub hush_scale: f32,\n    pub echo_duration: f32, pub chain_window: f32, pub strictness: f32, pub wrong_penalty: f32,\n    pub code_window: f32, pub score: f32, pub time_scale: f32,\n    pub immortal: bool, pub freeze: bool, pub one_hit: bool, pub bot: bool,\n    pub tremor: bool, pub clinical: bool,\n}\nimpl Default for Tune {\n    fn default()->Self { Self {drain:1.,timer:1.,power:1.,heal:1.,strain_speed:1.,toughness:1.,heart_coupling:1.,beat_window:110.,cursor_speed:15.,assist:0.7,gift_gain:1.,gift_duration:1.,hush_scale:0.3,echo_duration:10.,chain_window:20.,strictness:1.,wrong_penalty:1.,code_window:7.,score:1.,time_scale:1.,immortal:false,freeze:false,one_hit:false,bot:false,tremor:true,clinical:false} }\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct HazardSpec {\n    pub kind: String, pub pos: [f32;2],\n    #[serde(default)] pub end: Option<[f32;2]>,\n    #[serde(default)] pub hidden: bool,\n    #[serde(default)] pub stage: u8,\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Phase {pub name:String,pub objective:String,pub line:String,pub plate:String,#[serde(default)]pub strain:String,#[serde(default)]pub hazards:Vec<HazardSpec>,#[serde(default)]pub code:u8}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Case {pub name:String,pub patient:String,pub life:String,pub diagnosis:String,pub surgeon:String,pub timer:f32,pub par:f32,pub fate:String,pub phases:Vec<Phase>}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Content {pub cases:Vec<Case>}\npub fn content()->Result<Content> {\n    let built=include_str!(\"content/cases.json\");\n    #[cfg(not(target_arch=\"wasm32\"))]\n    let text=std::fs::read_to_string(\"crates/pav_core/src/games/surgery/content/cases.json\").unwrap_or_else(|_|built.into());\n    #[cfg(target_arch=\"wasm32\")]\n    let text=built;\n    serde_json::from_str(&text).map_err(|e|anyhow!(\"surgery/content/cases.json: {e}\"))\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Hazard {\n    pub id:u32,pub kind:String,pub pos:Vec2,pub end:Vec2,pub home:Vec2,pub progress:f32,pub stage:u8,\n    pub hidden:bool,pub reveal:f32,pub age:f32,pub alive:bool,pub side:f32,pub count:u8,pub angle:f32,\n}\nimpl Hazard {\n    pub fn tool(&self,case:usize)->u8 { match self.kind.as_str() {\n        \"incision\"|\"tether\"|\"soloist\"=>0,\n        \"hook\"|\"shard\"=>1,\"bone\"=>if self.stage==0{1}else{2},\n        \"laceration\"|\"bleeder\"=>2,\"pool\"=>3,\"polyp\"|\"sac\"=>4,\n        \"burn\"|\"inflammation\"=>5,\"dressing\"=>8,\n        \"tumor\"=>[0,1,5][self.stage.min(2) as usize],\n        \"nodule\"=>if self.hidden && self.reveal<=0.{6}else if self.stage==0{4}else{1},\n        \"ember\"=>if self.stage==0{if case==7{6}else{4}}else if self.stage==1{0}else{1},\n        \"tendril\"=>1,_=>5,\n    }}\n    pub fn radius(&self)->f32 {match self.kind.as_str(){\"pool\"=>1.15,\"tumor\"=>1.,\"dressing\"=>1.,\"sac\"=>0.65,_=>0.55}}\n    pub fn drain(&self)->f32 {match self.kind.as_str(){\"bleeder\"=>1.7,\"laceration\"=>0.24,\"pool\"=>0.2,\"nodule\"|\"ember\"=>0.17,\"tumor\"=>0.25,\"burn\"=>0.13,\"hook\"|\"shard\"=>0.10,\"sac\"=>0.16,_=>0.03}}\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Surgeon {\n    pub active:bool,pub cursor:Vec2,pub tool:u8,pub held:u32,pub charge:f32,pub gift_hold:f32,\n    pub grabbed:Option<u32>,pub origin:Vec2,pub last:Vec2,pub score:f32,pub chain:u32,\n    pub best_chain:u32,pub gift:f32,pub iv_cool:f32,pub last_good:f32,pub strokes:u32,\n    pub error:f32,pub ghost:bool,\n}\nimpl Default for Surgeon {fn default()->Self{Self{active:false,cursor:Vec2::ZERO,tool:1,held:0,charge:0.,gift_hold:0.,grabbed:None,origin:Vec2::ZERO,last:Vec2::ZERO,score:0.,chain:0,best_chain:0,gift:0.,iv_cool:0.,last_good:0.,strokes:0,error:0.,ghost:false}}}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Cue {pub seq:u32,pub text:String,pub kind:String,pub pos:Vec2,pub age:f32,pub seat:usize,pub on_beat:bool}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Surgery {\n    pub case:usize,pub phase:usize,pub mode:String,pub campaign:bool,pub blue:bool,\n    pub time:f32,pub remaining:f32,pub vitals:f32,pub bpm:f32,pub beat:f32,pub beats:u32,\n    pub phase_time:f32,pub hazards:Vec<Hazard>,pub surgeons:[Surgeon;4],pub tune:Tune,\n    pub cues:Vec<Cue>,pub serial:u32,pub next_id:u32,pub callout:String,pub code:f32,\n    pub shocks:u8,pub defibs:u8,pub scripted:bool,pub gift_left:f32,pub gift_kind:String,\n    pub fever:f32,pub heat_radius:f32,pub mistake_cd:f32,pub mistakes:u32,pub actions:u32,\n    pub coverage:BTreeMap<String,u32>,pub phase_results:Vec<f32>,pub completed:Vec<usize>,\n    pub outcome:Outcome,pub difficulty:u8,pub data:Content,pub wave:u32,pub blue_at:f32,\n}\nimpl Surgery {\n    pub fn new(case:usize,campaign:bool,blue:bool)->Self{\n        let data=content().expect(\"embedded surgery content\");\n        let mut g=Self {case:case.min(7),phase:0,mode:\"operation\".into(),campaign,blue,time:0.,remaining:240.,vitals:100.,bpm:72.,beat:0.,beats:0,phase_time:0.,hazards:vec![],surgeons:std::array::from_fn(|_|Surgeon::default()),tune:Tune::default(),cues:vec![],serial:0,next_id:0,callout:String::new(),code:0.,shocks:0,defibs:2,scripted:false,gift_left:0.,gift_kind:String::new(),fever:0.,heat_radius:-1.,mistake_cd:0.,mistakes:0,actions:0,coverage:BTreeMap::new(),phase_results:vec![],completed:vec![],outcome:Outcome::Playing,difficulty:0,data,wave:0,blue_at:0.};\n        g.surgeons[0].active=true;g.surgeons[0].cursor=Vec2::new(-6.,0.);\n        g.remaining=if blue {240.}else{g.chart().timer};g.load_phase();g\n    }\n    pub fn chart(&self)->&Case{&self.data.cases[self.case]}\n    pub fn stage(&self)->&Phase{&self.chart().phases[self.phase.min(self.chart().phases.len()-1)]}\n    pub fn mark(&mut self,key:&str){*self.coverage.entry(key.into()).or_default()+=1;}\n    pub fn emit(&mut self,text:&str,kind:&str,pos:Vec2,seat:usize,on_beat:bool){\n        self.serial+=1;self.cues.push(Cue{seq:self.serial,text:text.into(),kind:kind.into(),pos,age:0.,seat,on_beat});\n        if self.cues.len()>8{self.cues.remove(0);}\n    }\n    pub fn spawn(&mut self,spec:&HazardSpec){\n        self.next_id+=1;let p=Vec2::from_array(spec.pos);let end=spec.end.map(Vec2::from_array).unwrap_or(p+Vec2::new(0.,-1.2));\n        self.hazards.push(Hazard{id:self.next_id,kind:spec.kind.clone(),pos:p,end,home:p,progress:0.,stage:spec.stage,hidden:spec.hidden,reveal:0.,age:0.,alive:true,side:0.,count:0,angle:0.});\n        self.mark(&format!(\"hazard:{}\",spec.kind));\n    }\n    pub fn load_phase(&mut self){\n        self.hazards.clear();self.phase_time=0.;self.fever=0.;self.heat_radius=-1.;\n        let p=self.stage().clone();self.callout=p.line.clone();self.mark(&format!(\"phase:{}:{}\",self.case,self.phase));\n        if p.strain!=\"\" {self.mark(&format!(\"strain:{}\",p.strain));}\n        for s in &p.hazards{self.spawn(s);}\n        if p.code>0{self.start_code(p.code,true);}\n        if (self.case==3 && self.phase>=3)||(self.case>=4){self.surgeons[0].gift=100.;}\n        if p.hazards.iter().any(|h|h.kind==\"dressing\"){for s in &mut self.surgeons{s.tool=8;}}\n        self.emit(&p.name,\"phase\",Vec2::ZERO,0,false);\n    }\n    pub fn start_code(&mut self,n:u8,scripted:bool){\n        self.code=self.tune.code_window+if scripted{8.}else{0.};self.vitals=0.;self.shocks=n;self.scripted=scripted;\n        self.callout=if n>1{\"Three shocks. Count the ghost beats.\"}else{\"No pulse. Charge, then release on the ghost beat.\"}.into();\n        self.mark(\"code\");self.emit(\"CODE BLUE\",\"code\",Vec2::ZERO,0,false);\n    }\n    pub fn rank(&self)->&'\"'static str{let score=self.total();let ratio=score/self.chart().par; if ratio>=1.15{\\\"ENCORE\\\"}else if ratio>=1.{\\\"S\\\"}else if ratio>=0.85{\\\"A\\\"}else if ratio>=0.70{\\\"B\\\"}else{\\\"C\\\"}}\n    pub fn total(&self)->f32{self.surgeons.iter().map(|s|s.score).sum::<f32>()+self.vitals*20.+self.remaining.max(0.)*5.-self.mistakes as f32*100.}\n    pub fn finish(&mut self){self.mode=\\\"results\\\".into();self.outcome=if self.campaign && self.case<7{Outcome::Playing}else{Outcome::Won};self.completed.push(self.case);self.emit(\\\"OPERATION COMPLETE\\\",\\\"complete\\\",Vec2::ZERO,0,false);}\n    pub fn fail(&mut self){self.mode=\\\"dead\\\".into();self.outcome=Outcome::Lost;self.callout=\\\"Time of death: 03:42.\\\".into();self.emit(\\\"FLATLINE\\\",\\\"flatline\\\",Vec2::ZERO,0,false);}\n    pub fn next(&mut self){\n        if self.phase+1<self.chart().phases.len(){self.phase+=1;self.load_phase();}\n        else{self.finish();}\n    }\n    pub fn retry(&mut self,checkpoint:bool){\n        self.mode=\\\"operation\\\".into();self.outcome=Outcome::Playing;self.vitals=85.;self.code=0.;self.remaining=self.chart().timer*0.85;self.defibs=2u8.saturating_sub(self.difficulty);\n        if \"'!checkpoint {self.phase=0;for s in &mut self.surgeons{s.score=0.;s.chain=0;}}\n        self.load_phase();\n    }\n    pub fn on_beat(&self)->bool{self.beat.min(1.-self.beat)*60./self.bpm <=self.tune.beat_window/1000.}\n    fn mistake(&mut self,line:&str,damage:f32,seat:usize){\n        if self.mistake_cd>0.{return;}self.mistake_cd=0.8;self.mistakes+=1;\n        if !self.tune.immortal{self.vitals=(self.vitals-damage*self.tune.wrong_penalty).max(0.);}\n        self.surgeons[seat].chain=0;self.callout=line.into();self.emit(line,\"mistake\",self.surgeons[seat].cursor,seat,false);\n    }\n    fn rate(&mut self,seat:usize,quality:f32,pos:Vec2){\n        let q=quality/self.tune.strictness.max(0.2);\n        let (word,points,gain)=if q>=0.88{(\"IMMACULATE\",400.,8.)}else if q>=0.66{(\"CLEAN\",250.,4.)}else if q>=0.34{(\"GOOD\",120.,2.)}else{(\"SLOPPY\",10.,0.)};\n        let beat=self.on_beat();let s=&mut self.surgeons[seat];\n        if q>=0.66{s.chain+=1;}else if q<0.34{s.chain=0;}\n        s.best_chain=s.best_chain.max(s.chain);s.last_good=self.time;\n        let mult=if s.chain>=20{2.}else if s.chain>=10{1.5}else if s.chain>=5{1.25}else{1.};\n        s.score+=points*mult*if beat{1.25}else{1.}*self.tune.score;\n        s.gift=(s.gift+(gain+if beat{2.}else{0.})*self.tune.gift_gain).min(100.);\n        self.actions+=1;self.mark(&format!(\"rating:{word}\"));if beat{self.mark(\"on_beat\");}\n        self.emit(word,\"rating\",pos,seat,beat);\n        if beat && self.gift_left>0. && self.gift_kind!=\"Echo\" {self.gift_left+=60./self.bpm;}\n    }\n    fn complete(&mut self,index:usize,seat:usize,quality:f32){\n        let pos=self.hazards[index].pos;let kind=self.hazards[index].kind.clone();let tool=self.hazards[index].tool(self.case);\n        let stage=self.hazards[index].stage;self.mark(&format!(\"tool:{tool}\"));\n        let mut done=true;\n        if kind==\"tumor\" && stage<2 || kind==\"nodule\" && stage==0 || kind==\"ember\" && stage<2 || kind==\"bone\" && stage==0 {\n            self.hazards[index].stage+=1;self.hazards[index].progress=0.;done=false;\n            if kind==\"ember\" && stage==0{self.callout=\"Brittle. Crack the shell with the scalpel.\".into();}\n            if kind==\"bone\"{self.callout=\"Aligned. Wire it with two even crossings.\".into();}\n        }\n        if done{self.hazards[index].alive=false;self.mark(&format!(\"cleared:{kind}\"));}\n        self.rate(seat,quality,pos);\n        if self.gift_left>0. && (self.gift_kind==\"Echo\"||self.gift_kind==\"Duet\") && seat!=3{\n            if let Some(j)=self.hazards.iter().position(|h|h.alive && h.tool(self.case)==tool && h.id!=self.hazards[index].id){\n                let p=self.hazards[j].pos;\n                self.surgeons[3].active=true;self.surgeons[3].ghost=true;self.surgeons[3].cursor=p;self.surgeons[3].tool=tool;\n                self.hazards[j].progress=0.;\n                if self.hazards[j].kind==\"ember\" && self.hazards[j].stage<2 || self.hazards[j].kind==\"tumor\" && self.hazards[j].stage<2 || self.hazards[j].kind==\"nodule\" && self.hazards[j].stage==0{self.hazards[j].stage+=1;}else{self.hazards[j].alive=false;}\n                self.mark(\"echo_repeat\");self.rate(seat,quality,p);self.emit(\"ECHO\",\"gift\",p,3,false);\n            }\n        }\n    }\n    fn target(&self,p:Vec2,tool:u8)->Option<usize>{\n        self.hazards.iter().enumerate().filter(|(_,h)|h.alive && (!h.hidden || h.reveal>0. || tool==6) )\n            .filter(|(_,h)|{let d=if matches!(h.kind.as_str(),\"incision\"|\"laceration\"|\"bleeder\"|\"dressing\"|\"tether\"|\"soloist\"){line_distance(p,h.pos,h.end).0}else{p.distance(h.pos)}; d<h.radius()+0.4})\n            .min_by(|(_,a),(_,b)|p.distance_squared(a.pos).total_cmp(&p.distance_squared(b.pos))).map(|(i,_)|i)\n    }\n    pub fn tick(&mut self,inputs:[SurgeonInput;4],dt:f32){\n        if self.mode!=\"operation\" {return;}\n        let slow=if self.gift_left>0. && self.gift_kind!=\"Echo\" {self.tune.hush_scale}else{1.};\n        let world=dt*self.tune.time_scale*slow;\n        self.time+=world;self.phase_time+=world;\n        for c in &mut self.cues{c.age+=dt;}\n        self.cues.retain(|c|c.age<4.);\n        self.mistake_cd=(self.mistake_cd-dt).max(0.);self.gift_left=(self.gift_left-dt).max(0.);\n        if self.gift_left==0.{self.surgeons[3].active=false;}\n        self.bpm=72.+(1.-self.vitals/100.)*76.*self.tune.heart_coupling;\n        let oldbeat=self.beat;self.beat=(self.beat+world*self.bpm/60.).fract();\n        let pulse=self.beat<oldbeat;if pulse {self.beats+=1;}\n        if !self.tune.freeze{self.remaining-=world/self.tune.timer.max(0.1);}\n        if self.remaining<=0. {self.fail();return;}\n        for h in &mut self.hazards {h.age+=world;h.reveal=(h.reveal-world).max(0.);}\n        if self.code<=0. {\n            let difficulty=[0.7,1.,1.3][self.difficulty.min(2) as usize];\n            let drain=self.hazards.iter().filter(|h|h.alive).map(|h|h.drain()).sum::<f32>()+0.05;\n            if !self.tune.immortal{self.vitals=(self.vitals-drain*world*self.tune.drain*difficulty).max(0.);}\n            if self.vitals==0. {if self.defibs>0{self.defibs-=1;self.start_code(1,false);}else{self.fail();return;}}\n        } else {\n            self.code-=dt;\n            if self.code<=0. {if self.tune.immortal {self.vitals=30.;self.shocks=0;}else{self.fail();return;}}\n        }\n        self.strain(world,pulse);\n        for (seat,input) in inputs.iter().enumerate(){\n            if seat==3 && self.surgeons[3].ghost {continue;}\n            if !input.active{continue;}\n            self.surgeons[seat].active=true;\n            self.operate(seat,*input,dt,world);\n        }\n        if self.mode!=\"operation\" {return;}\n        if self.blue {\n            if self.time>=self.blue_at && self.hazards.iter().filter(|h|h.alive).count()<10 {self.blue_wave();}\n            if self.remaining<0.1{self.finish();}\n        }else if self.code<=0. && self.shocks==0 && self.phase_time>1. && !self.hazards.iter().any(|h|h.alive){\n            self.phase_results.push(self.vitals);self.next();\n        }\n    }\n    fn operate(&mut self,seat:usize,input:SurgeonInput,dt:f32,world:f32){\n        let old=self.surgeons[seat].held;let was=old&USE!=0;let held=input.held&USE!=0;\n        let mut p=input.aim.clamp(Vec2::new(-9.,-4.1),Vec2::new(9.,4.15));\n        let tool=if self.stage().hazards.iter().any(|h|h.kind==\"dressing\"){8}else{input.tool.min(8)};\n        if self.case>=5 && self.case<=6 && self.tune.tremor && !input.assisted && self.gift_left==0. {p+=Vec2::new((self.time*2.3).sin(),(self.time*1.7).cos())*0.08;}\n        if input.assisted && tool!=7 && self.tune.assist>0. {\n            if let Some(h)=self.hazards.iter().filter(|h|h.alive && h.tool(self.case)==tool).min_by(|a,b|p.distance_squared(a.pos).total_cmp(&p.distance_squared(b.pos))) {\n                if p.distance(h.pos)<1.2 && p.distance(self.surgeons[seat].cursor)>0.001 {p=p.lerp(h.pos,self.tune.assist*dt*3.);}\n                if held && tool==2 {let dir=(h.end-h.pos).normalize_or_zero();let t=(h.progress+0.18).min(0.95);let at=h.pos.lerp(h.end,t);let side=Vec2::new(-dir.y,dir.x);p=at+side*(p-at).dot(side).clamp(-0.65,0.65);}\n            }\n        }\n        self.surgeons[seat].last=self.surgeons[seat].cursor;\n        self.surgeons[seat].cursor=p;\n        self.surgeons[seat].iv_cool=(self.surgeons[seat].iv_cool-world).max(0.);\n        if tool!=self.surgeons[seat].tool {self.surgeons[seat].charge=0.;self.surgeons[seat].grabbed=None;}\n        self.surgeons[seat].tool=tool;self.surgeons[seat].held=input.held;\n        if input.held&CANCEL!=0{self.surgeons[seat].grabbed=None;self.surgeons[seat].charge=0.;return;}\n        if input.held&GIFT!=0 && self.surgeons[seat].gift>=35. {\n            self.surgeons[seat].gift_hold+=dt;\n        }else if old&GIFT!=0 && self.surgeons[seat].gift_hold>0. {\n            if self.on_beat() && self.surgeons[seat].gift_hold>=0.2{\n                let kind=if self.case==7{\"Duet\"}else if self.case>=5{\"Echo\"}else{\"Hush\"};\n                self.gift_kind=kind.into();self.gift_left=if kind==\"Echo\"{self.tune.echo_duration}else{6.*60./self.bpm}*self.tune.gift_duration;\n                self.surgeons[seat].gift=0.;self.mark(&format!(\"gift:{kind}\"));self.callout=match kind{\"Hush\"=>\"The space between two heartbeats. Stay here.\",\"Echo\"=>\"The hands I had before I learned to be afraid.\",_=>\"Two surgeons. One heartbeat.\"}.into();\n                self.emit(kind,\"gift\",p,seat,false);\n            } self.surgeons[seat].gift_hold=0.;\n        }\n        if self.code>0. {\n            if input.held&SHOCK!=0 {self.surgeons[seat].charge+=dt;}\n            else if old&SHOCK!=0{\n                let charge=self.surgeons[seat].charge;self.surgeons[seat].charge=0.;\n                if charge>=1.1 && self.beat.min(1.-self.beat)<0.25 {\n                    self.shocks=self.shocks.saturating_sub(1);self.mark(\"defibrillated\");self.rate(seat,0.95,p);self.emit(\"SINUS RHYTHM\",\"shock\",p,seat,true);\n                    if self.shocks==0 {self.code=0.;self.vitals=40.;self.callout=\"We have a rhythm. Keep it.\".into();}else{self.code=self.tune.code_window+5.;}\n                }else{self.callout=\"Charge fully. Release as the ghost beat meets the line.\".into();}\n            }return;\n        }\n        if tool==7 {\n            self.surgeons[seat].cursor=Vec2::new(8.3,-3.1);\n            if held && self.surgeons[seat].iv_cool<=0. {self.surgeons[seat].charge+=dt*0.5;}\n            if !held && was && self.surgeons[seat].charge>0.{\n                let c=self.surgeons[seat].charge;self.surgeons[seat].charge=0.;self.surgeons[seat].iv_cool=4.;self.mark(\"tool:7\");\n                if c>1.12{self.mistake(\"Overdose. Watch the green band.\",8.,seat);}else{self.vitals=(self.vitals+(if c>=0.75{18.}else{9.*c})*self.tune.heal).min(100.);self.rate(seat,if c>=0.75{0.96}else{0.5},p);}\n            }return;\n        }\n        if tool==6 && self.case!=7 {\n            if held{self.mark(\"tool:6\");for h in &mut self.hazards{if h.pos.distance(p)<3.{h.reveal=8.;}}}\n            return;\n        }\n        // Forceps keep their own target while the hand pulls away.\n        let target=self.surgeons[seat].grabbed.and_then(|id|self.hazards.iter().position(|h|h.id==id&&h.alive)).or_else(||self.target(p,tool));\n        let Some(i)=target else {\n            if held && !was && tool==0 && p.length()<7.0 {\n                self.mistake(\"Doctor, that'\"'s healthy tissue.\\\",2.,seat);\n                let h=HazardSpec{kind:\\\"laceration\\\".into(),pos:p.to_array(),end:Some((p+Vec2::new(0.9,0.2)).to_array()),hidden:false,stage:0};\n                self.spawn(&h);\n            }\n            if \"'!held{self.surgeons[seat].grabbed=None;self.surgeons[seat].charge=0.;}return;\n        };\n        let correct=self.hazards[i].tool(self.case)==tool || tool==3 && self.hazards[i].kind==\"sac\";\n        if !correct{if held && !was{self.mistake(\"Wrong instrument, Doctor.\",0.,seat);}return;}\n        if self.hazards[i].hidden && self.hazards[i].reveal<=0.{return;}\n        let power=self.tune.power/if matches!(self.hazards[i].kind.as_str(),\"nodule\"|\"ember\"|\"sac\"){self.tune.toughness.max(0.1)}else{1.};\n        if self.tune.one_hit && held && matches!(self.hazards[i].kind.as_str(),\"nodule\"|\"ember\"|\"sac\") {self.complete(i,seat,1.);return;}\n        match tool {\n            0|8=>{\n                if held {\n                    let h=&mut self.hazards[i];\n                    if h.kind==\"tumor\" {let r=p.distance(h.pos);if (r-0.65).abs()<0.5 {h.progress+=p.distance(self.surgeons[seat].last)*power/3.4;}}\n                    else if h.kind==\"ember\" {h.progress+=dt*power/0.7;}\n                    else {let (error,t)=line_distance(p,h.pos,h.end);if error<0.6 && t<=h.progress+0.24 {h.progress=h.progress.max((t+0.07)*power.min(1.25));self.surgeons[seat].error+=error*dt;}}\n                    if h.progress>=0.98{let q=1.-self.surgeons[seat].error.min(0.6);self.surgeons[seat].error=0.;self.complete(i,seat,q);}\n                }\n            },\n            1=>{\n                if held{\n                    if self.surgeons[seat].grabbed.is_none(){self.surgeons[seat].grabbed=Some(self.hazards[i].id);self.surgeons[seat].origin=p;}\n                    if self.hazards[i].kind==\"bone\" {\n                        self.hazards[i].pos=p;self.hazards[i].angle+=input.rotate*dt*2.;\n                        if p.distance(self.hazards[i].end)<0.4 && self.hazards[i].angle.abs()<0.25 {self.hazards[i].pos=self.hazards[i].end;self.hazards[i].end+=Vec2::new(0.,1.2);self.surgeons[seat].grabbed=None;self.complete(i,seat,0.95);}\n                    }else{\n                        let delta=p-self.surgeons[seat].origin;let dir=(self.hazards[i].end-self.hazards[i].home).normalize_or_zero();\n                        let angle=delta.normalize_or_zero().dot(dir);let diastole=self.beat>0.28;\n                        if delta.length()>0.85 && (self.hazards[i].kind!=\"tendril\" || diastole){\n                            self.surgeons[seat].grabbed=None;\n                            if angle>0.7 {self.complete(i,seat,angle);}else{self.mistake(\"Pull along the axis, Doctor.\",3.,seat);self.surgeons[seat].origin=p;}\n                        }\n                    }\n                }else{self.surgeons[seat].grabbed=None;}\n            },\n            2=>{if held{\n                let h=&mut self.hazards[i];let dir=(h.end-h.pos).normalize_or_zero();let side=dir.perp_dot(p-h.pos);let (_,along)=line_distance(p,h.pos,h.end);\n                if side.abs()>0.09 && (h.side==0. || side.signum()!=h.side.signum()) && along<h.progress+0.42 {\n                    h.count+=1;h.side=side;let need=if h.kind==\"bone\"{2.}else{(h.end.distance(h.pos)*2.).ceil().max(3.)};h.progress=h.count as f32/need;\n                }\n                if h.progress>=1.{self.complete(i,seat,0.93);}\n            }},\n            3|5=>{if held{let h=&mut self.hazards[i];h.progress+=dt*power*(if tool==3{0.65*input.pressure.max(0.2)}else{0.8});if h.progress>=1.{self.complete(i,seat,if tool==3{0.55}else{0.94});}}},\n            4|6=>{\n                if held {self.surgeons[seat].charge+=dt*power/if self.hazards[i].kind==\"sac\"{0.75}else{1.2};self.hazards[i].progress=self.surgeons[seat].charge;\n                    if self.surgeons[seat].charge>1.35{self.surgeons[seat].charge=0.;self.hazards[i].progress=0.;self.mistake(if tool==6 || self.case==6{\"Frostbite. Lift off.\"}else{\"Overheated. Lift off.\"},4.,seat);}\n                }else if was{let c=self.surgeons[seat].charge;self.surgeons[seat].charge=0.;if c>=0.72{self.complete(i,seat,if c<=1.08{0.98}else{0.45});}else{self.hazards[i].progress=0.;}}\n            },_=>{}\n        }\n        if held && self.surgeons[seat].chain>0 && self.time-self.surgeons[seat].last_good>self.tune.chain_window {self.surgeons[seat].chain=0;}\n    }\n    fn strain(&mut self,dt:f32,pulse:bool){\n        let strain=self.stage().strain.clone();\n        if strain.contains(\"introit\") || strain.contains(\"libera\") {\n            if pulse && self.beats.is_multiple_of(3) {\n                let speed=self.tune.strain_speed*(self.bpm/72.).min(1.4);\n                for h in &mut self.hazards{if h.alive && h.kind==\"nodule\" && h.stage==0 && h.age>1.5 {\n                    let k=h.id as f32;h.pos=h.home+Vec2::new((self.beats as f32*0.7+k).sin(),(self.beats as f32*0.5+k).cos())*0.8*speed;h.end=h.pos+Vec2::new(0.,-1.2);\n                }}\n            }\n        }\n        if strain.contains(\"lacrimosa\") || strain.contains(\"libera\") {\n            let mut burst=vec![];\n            for h in &mut self.hazards {if h.alive && h.kind==\"sac\" && h.age>16./self.tune.strain_speed.max(0.1){h.kind=\"pool\".into();h.progress=0.;h.hidden=false;burst.push(h.pos);}}\n            for p in burst {self.mark(\"sac_burst\");self.callout=\"The sac has ruptured. Suction the caustic pool.\".into();self.emit(\"CAUSTIC\",\"burst\",p,0,false);}\n        }\n        if strain.contains(\"dies\") || strain.contains(\"furnace\") || strain.contains(\"libera\") {\n            let count=self.hazards.iter().filter(|h|h.alive&&h.kind==\"ember\").count();\n            self.fever=(self.fever+dt*(count as f32*1.1-1.5)).clamp(0.,120.);\n            if self.fever>100. && !self.tune.immortal {self.vitals=(self.vitals-dt*3.).max(0.);}\n            if count>0 && pulse && self.beats.is_multiple_of(5) {self.heat_radius=0.;self.callout=\"Heat ring. Lift off!\".into();self.mark(\"heat_ring\");}\n            if self.heat_radius>=0. {\n                self.heat_radius+=dt*4.;\n                for s in 0..4 {if self.surgeons[s].active && self.surgeons[s].held&USE!=0 && (self.surgeons[s].cursor.length()-self.heat_radius).abs()<0.3{self.mistake(\"Lift off! Lift off!\",3.,s);}}\n                if self.heat_radius>11.{self.heat_radius=-1.;}\n            }\n        }\n    }\n    pub fn bot_seat(&self,seat:usize)->SurgeonInput {\n        let s=&self.surgeons[seat];let mut input=SurgeonInput{active:true,aim:s.cursor,tool:s.tool,pressure:1.,..Default::default()};\n        if self.code>0.{input.held=if s.charge<1.22 || self.beat.min(1.-self.beat)>0.17{SHOCK}else{0};return input;}\n        if s.gift>=60. && self.case>=3 && self.gift_left<=0. {input.held=if s.gift_hold<0.25 || !self.on_beat(){GIFT}else{0};return input;}\n        if self.vitals<65. && s.iv_cool<=0. || s.tool==7 && s.charge>0. {input.tool=7;input.held=if s.charge<0.86{USE}else{0};return input;}\n        let target=s.grabbed.and_then(|id|self.hazards.iter().find(|h|h.id==id && h.alive)).or_else(||self.hazards.iter().filter(|h|h.alive).min_by(|a,b| {\n            let weight=|h:&Hazard|s.cursor.distance(h.pos)-if h.kind==\"bleeder\"{8.}else{0.};weight(a).total_cmp(&weight(b))\n        }));\n        let Some(h)=target else{return input};\n        let tool=if h.hidden && h.reveal<=0.{6}else{h.tool(self.case)};input.tool=tool;\n        let mut goal=h.pos;let mut hold=true;\n        match tool{\n            0|8=>{if h.kind==\"tumor\"{let a=self.time*4.;goal=h.pos+Vec2::new(a.cos(),a.sin())*0.65;}else if h.kind!=\"ember\"{goal=h.pos.lerp(h.end,(h.progress+0.1).min(1.));}},\n            1=>{if s.grabbed.is_some(){goal=if h.kind==\"bone\"{h.end}else{s.origin+(h.end-h.home).normalize_or_zero()*1.1};}},\n            2=>{let dir=(h.end-h.pos).normalize_or_zero();let side=Vec2::new(-dir.y,dir.x);goal=h.pos.lerp(h.end,(h.progress+0.05).min(0.95))+side*if h.side>0.{-0.35}else{0.35};},\n            4|6=>{hold=!(s.charge>=0.88 && (tool==4 || self.case==7));},_=>{}\n        }\n        let delta=goal-s.cursor;input.aim=s.cursor+delta.clamp_length_max(self.tune.cursor_speed/60.);\n        if delta.length()>0.65 && s.grabbed.is_none(){hold=false;}\n        if tool!=s.tool{hold=false;}\n        if self.heat_radius>=0. && (input.aim.length()-self.heat_radius).abs()<0.75 {hold=false;}\n        input.held=if hold{USE}else{0};input\n    }\n    fn blue_wave(&mut self){\n        self.wave+=1;self.blue_at=self.time+12.;self.mark(\"codeblue_wave\");\n        let count=2+self.surgeons.iter().filter(|s|s.active && !s.ghost).count();\n        let kinds=[\"laceration\",\"pool\",\"polyp\",\"hook\",\"burn\",\"nodule\"];\n        for i in 0..count{let a=(self.wave as f32*1.7+i as f32*2.4).sin()*5.;let z=(self.wave as f32+i as f32).cos()*2.6;let kind=kinds[(self.wave as usize+i)%kinds.len()];self.spawn(&HazardSpec{kind:kind.into(),pos:[a,z],end:Some([a+1.,z-0.4]),hidden:false,stage:0});}\n        self.callout=format!(\"Triage wave {}. Keep the patient alive.\",self.wave);\n    }\n    pub fn status_json(&self)->serde_json::Value {serde_json::to_value(self).unwrap_or_default()}\n}\nfn line_distance(p:Vec2,a:Vec2,b:Vec2)->(f32,f32){let d=b-a;let t=((p-a).dot(d)/d.length_squared().max(0.001)).clamp(0.,1.);(p.distance(a+d*t),t)}\n\npub fn build(sim:&mut Sim,rest:Option<&str>)->Result<()> {\n    let level=include_str!(\"level.toml\");let def=crate::room::RoomDef::parse(level)?;\n    crate::scenes::build_standalone_room(sim,\"surgery\",def);\n    if let Some(id)=sim.state.player{sim.despawn(id);}\n    sim.state.focus=Vec3::ZERO;\n    let rest=rest.unwrap_or(\"title\");let case=rest.strip_prefix(\"case/\").and_then(|n|n.parse().ok()).unwrap_or(0);\n    let mut game=Surgery::new(case,rest==\"campaign\",rest==\"codeblue\");\n    if rest==\"title\"||rest==\"card\"||rest==\"mirror\" {game.mode=rest.into();}\n    if rest==\"attract\"{game=Surgery::new(3,false,false);game.tune.bot=true;game.tune.immortal=true;game.surgeons[0].gift=100.;}\n    sim.state.play=Some(GameBox::new(game));Ok(())\n}\nimpl Game for Surgery {\n    const KEY:&'\"'static str=\\\"surgery\\\";\n    fn pre(&mut self,_sim:&mut Sim,input:&InputFrame,dt:f32,_events:&mut Vec<SimEvent>)->BTreeMap<crate::entity::EntityId,InputFrame>{\n        if self.mode==\\\"results\\\" && self.campaign && self.case<7 {\n            let coverage=self.coverage.clone();let completed=self.completed.clone();let difficulty=self.difficulty;let mut next=Self::new(self.case+1,true,false);next.coverage=coverage;next.completed=completed;next.difficulty=difficulty;next.mark(&format\"'!(\"phase:{}:0\",next.case));*self=next;\n        }\n        let mut inputs=input.surgeons;\n        if self.tune.bot {inputs[0]=self.bot_seat(0);}\n        if self.case==7 && !inputs[1].active && !self.blue {inputs[1]=self.bot_seat(1);}\n        self.tick(inputs,dt);BTreeMap::new()\n    }\n    fn status(&self,_sim:&Sim)->serde_json::Value{self.status_json()}\n    fn outcome(&self)->Outcome{self.outcome}\n    fn bot(&self,_sim:&Sim)->InputFrame{let mut f=InputFrame::default();f.surgeons[0]=self.bot_seat(0);f}\n}\nEOF\ncat > \"$d/engine/crates/pav_core/src/games/surgery/level.toml\" <<'\"'EOF'\nname = \\\"Mercy Harbor General\\\"\nabout = \\\"The First Movement\\\"\nentrance = { at = [0, 0], facing = \\\"north\\\" }\n[camera]\ntilt = 73.0\ndistance = 19.9\nfov = 36.0\nheight_offset = 0.0\nfollow_lag = 0.0\n[view]\n[layout]\norigin = [90.0, 0.0, -8.0]\n[[layout.layer]]\ny = 0\nmap = '''\n...\n.P.\n...\n'''\n[layout.legend.'.']\nblocks = [{ y0 = -0.3, y1 = 0.0, color = \\\"#10383d\\\" }]\n[layout.legend.'P']\nmarker = \\\"player\\\"\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); cat > \"$d/engine/crates/pav_core/src/games/surgery/mod.rs\" <<'\"'EOF'\n//\"'! The First Movement: deterministic surgical action, content-driven cases and surgeon seats.\nuse std::collections::BTreeMap;\nuse anyhow::{Result, anyhow};\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse super::{Game, GameBox, Outcome};\nuse crate::{InputFrame, Sim};\nuse crate::frame::SimEvent;\n\npub const TITLE: &str = \"Trauma Refrain: Third Opinion\";\npub const USE: u32 = 1;\npub const GIFT: u32 = 2;\npub const SHOCK: u32 = 4;\npub const CANCEL: u32 = 8;\npub const TOOLS: [&str;9] = [\"Scalpel\",\"Forceps\",\"Suture\",\"Suction\",\"Laser\",\"Gel\",\"Scanner\",\"IV Push\",\"Dressing\"];\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct SurgeonInput {\n    pub active: bool,\n    pub aim: Vec2,\n    pub tool: u8,\n    pub held: u32,\n    pub pressure: f32,\n    pub rotate: f32,\n    pub assisted: bool,\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct Tune {\n    pub drain: f32, pub timer: f32, pub power: f32, pub heal: f32, pub strain_speed: f32,\n    pub toughness: f32, pub heart_coupling: f32, pub beat_window: f32, pub cursor_speed: f32,\n    pub assist: f32, pub gift_gain: f32, pub gift_duration: f32, pub hush_scale: f32,\n    pub echo_duration: f32, pub chain_window: f32, pub strictness: f32, pub wrong_penalty: f32,\n    pub code_window: f32, pub score: f32, pub time_scale: f32,\n    pub immortal: bool, pub freeze: bool, pub one_hit: bool, pub bot: bool,\n    pub tremor: bool, pub clinical: bool,\n}\nimpl Default for Tune {\n    fn default()->Self { Self {drain:1.,timer:1.,power:1.,heal:1.,strain_speed:1.,toughness:1.,heart_coupling:1.,beat_window:110.,cursor_speed:15.,assist:0.7,gift_gain:1.,gift_duration:1.,hush_scale:0.3,echo_duration:10.,chain_window:20.,strictness:1.,wrong_penalty:1.,code_window:7.,score:1.,time_scale:1.,immortal:false,freeze:false,one_hit:false,bot:false,tremor:true,clinical:false} }\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct HazardSpec {\n    pub kind: String, pub pos: [f32;2],\n    #[serde(default)] pub end: Option<[f32;2]>,\n    #[serde(default)] pub hidden: bool,\n    #[serde(default)] pub stage: u8,\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Phase {pub name:String,pub objective:String,pub line:String,pub plate:String,#[serde(default)]pub strain:String,#[serde(default)]pub hazards:Vec<HazardSpec>,#[serde(default)]pub code:u8}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Case {pub name:String,pub patient:String,pub life:String,pub diagnosis:String,pub surgeon:String,pub timer:f32,pub par:f32,pub fate:String,pub phases:Vec<Phase>}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Content {pub cases:Vec<Case>}\npub fn content()->Result<Content> {\n    let built=include_str!(\"content/cases.json\");\n    #[cfg(not(target_arch=\"wasm32\"))]\n    let text=std::fs::read_to_string(\"crates/pav_core/src/games/surgery/content/cases.json\").unwrap_or_else(|_|built.into());\n    #[cfg(target_arch=\"wasm32\")]\n    let text=built;\n    serde_json::from_str(&text).map_err(|e|anyhow!(\"surgery/content/cases.json: {e}\"))\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Hazard {\n    pub id:u32,pub kind:String,pub pos:Vec2,pub end:Vec2,pub home:Vec2,pub progress:f32,pub stage:u8,\n    pub hidden:bool,pub reveal:f32,pub age:f32,pub alive:bool,pub side:f32,pub count:u8,pub angle:f32,\n}\nimpl Hazard {\n    pub fn tool(&self,case:usize)->u8 { match self.kind.as_str() {\n        \"incision\"|\"tether\"|\"soloist\"=>0,\n        \"hook\"|\"shard\"=>1,\"bone\"=>if self.stage==0{1}else{2},\n        \"laceration\"|\"bleeder\"=>2,\"pool\"=>3,\"polyp\"|\"sac\"=>4,\n        \"burn\"|\"inflammation\"=>5,\"dressing\"=>8,\n        \"tumor\"=>[0,1,5][self.stage.min(2) as usize],\n        \"nodule\"=>if self.hidden && self.reveal<=0.{6}else if self.stage==0{4}else{1},\n        \"ember\"=>if self.stage==0{if case==7{6}else{4}}else if self.stage==1{0}else{1},\n        \"tendril\"=>1,_=>5,\n    }}\n    pub fn radius(&self)->f32 {match self.kind.as_str(){\"pool\"=>1.15,\"tumor\"=>1.,\"dressing\"=>1.,\"sac\"=>0.65,_=>0.55}}\n    pub fn drain(&self)->f32 {match self.kind.as_str(){\"bleeder\"=>1.7,\"laceration\"=>0.24,\"pool\"=>0.2,\"nodule\"|\"ember\"=>0.17,\"tumor\"=>0.25,\"burn\"=>0.13,\"hook\"|\"shard\"=>0.10,\"sac\"=>0.16,_=>0.03}}\n}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Surgeon {\n    pub active:bool,pub cursor:Vec2,pub tool:u8,pub held:u32,pub charge:f32,pub gift_hold:f32,\n    pub grabbed:Option<u32>,pub origin:Vec2,pub last:Vec2,pub score:f32,pub chain:u32,\n    pub best_chain:u32,pub gift:f32,pub iv_cool:f32,pub last_good:f32,pub strokes:u32,\n    pub error:f32,pub ghost:bool,\n}\nimpl Default for Surgeon {fn default()->Self{Self{active:false,cursor:Vec2::ZERO,tool:1,held:0,charge:0.,gift_hold:0.,grabbed:None,origin:Vec2::ZERO,last:Vec2::ZERO,score:0.,chain:0,best_chain:0,gift:0.,iv_cool:0.,last_good:0.,strokes:0,error:0.,ghost:false}}}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Cue {pub seq:u32,pub text:String,pub kind:String,pub pos:Vec2,pub age:f32,pub seat:usize,pub on_beat:bool}\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Surgery {\n    pub case:usize,pub phase:usize,pub mode:String,pub campaign:bool,pub blue:bool,\n    pub time:f32,pub remaining:f32,pub vitals:f32,pub bpm:f32,pub beat:f32,pub beats:u32,\n    pub phase_time:f32,pub hazards:Vec<Hazard>,pub surgeons:[Surgeon;4],pub tune:Tune,\n    pub cues:Vec<Cue>,pub serial:u32,pub next_id:u32,pub callout:String,pub code:f32,\n    pub shocks:u8,pub defibs:u8,pub scripted:bool,pub gift_left:f32,pub gift_kind:String,\n    pub fever:f32,pub heat_radius:f32,pub mistake_cd:f32,pub mistakes:u32,pub actions:u32,\n    pub coverage:BTreeMap<String,u32>,pub phase_results:Vec<f32>,pub completed:Vec<usize>,\n    pub outcome:Outcome,pub difficulty:u8,pub data:Content,pub wave:u32,pub blue_at:f32,\n}\nimpl Surgery {\n    pub fn new(case:usize,campaign:bool,blue:bool)->Self{\n        let data=content().expect(\"embedded surgery content\");\n        let mut g=Self {case:case.min(7),phase:0,mode:\"operation\".into(),campaign,blue,time:0.,remaining:240.,vitals:100.,bpm:72.,beat:0.,beats:0,phase_time:0.,hazards:vec![],surgeons:std::array::from_fn(|_|Surgeon::default()),tune:Tune::default(),cues:vec![],serial:0,next_id:0,callout:String::new(),code:0.,shocks:0,defibs:2,scripted:false,gift_left:0.,gift_kind:String::new(),fever:0.,heat_radius:-1.,mistake_cd:0.,mistakes:0,actions:0,coverage:BTreeMap::new(),phase_results:vec![],completed:vec![],outcome:Outcome::Playing,difficulty:0,data,wave:0,blue_at:0.};\n        g.surgeons[0].active=true;g.surgeons[0].cursor=Vec2::new(-6.,0.);\n        g.remaining=if blue {240.}else{g.chart().timer};g.load_phase();g\n    }\n    pub fn chart(&self)->&Case{&self.data.cases[self.case]}\n    pub fn stage(&self)->&Phase{&self.chart().phases[self.phase.min(self.chart().phases.len()-1)]}\n    pub fn mark(&mut self,key:&str){*self.coverage.entry(key.into()).or_default()+=1;}\n    pub fn emit(&mut self,text:&str,kind:&str,pos:Vec2,seat:usize,on_beat:bool){\n        self.serial+=1;self.cues.push(Cue{seq:self.serial,text:text.into(),kind:kind.into(),pos,age:0.,seat,on_beat});\n        if self.cues.len()>8{self.cues.remove(0);}\n    }\n    pub fn spawn(&mut self,spec:&HazardSpec){\n        self.next_id+=1;let p=Vec2::from_array(spec.pos);let end=spec.end.map(Vec2::from_array).unwrap_or(p+Vec2::new(0.,-1.2));\n        self.hazards.push(Hazard{id:self.next_id,kind:spec.kind.clone(),pos:p,end,home:p,progress:0.,stage:spec.stage,hidden:spec.hidden,reveal:0.,age:0.,alive:true,side:0.,count:0,angle:0.});\n        self.mark(&format!(\"hazard:{}\",spec.kind));\n    }\n    pub fn load_phase(&mut self){\n        self.hazards.clear();self.phase_time=0.;self.fever=0.;self.heat_radius=-1.;\n        let p=self.stage().clone();self.callout=p.line.clone();self.mark(&format!(\"phase:{}:{}\",self.case,self.phase));\n        if p.strain!=\"\" {self.mark(&format!(\"strain:{}\",p.strain));}\n        for s in &p.hazards{self.spawn(s);}\n        if p.code>0{self.start_code(p.code,true);}\n        if (self.case==3 && self.phase>=3)||(self.case>=4){self.surgeons[0].gift=100.;}\n        if p.hazards.iter().any(|h|h.kind==\"dressing\"){for s in &mut self.surgeons{s.tool=8;}}\n        self.emit(&p.name,\"phase\",Vec2::ZERO,0,false);\n    }\n    pub fn start_code(&mut self,n:u8,scripted:bool){\n        self.code=self.tune.code_window+if scripted{8.}else{0.};self.vitals=0.;self.shocks=n;self.scripted=scripted;\n        self.callout=if n>1{\"Three shocks. Count the ghost beats.\"}else{\"No pulse. Charge, then release on the ghost beat.\"}.into();\n        self.mark(\"code\");self.emit(\"CODE BLUE\",\"code\",Vec2::ZERO,0,false);\n    }\n    pub fn rank(&self)->&'\"'static str{let score=self.total();let ratio=score/self.chart().par; if ratio>=1.15{\\\"ENCORE\\\"}else if ratio>=1.{\\\"S\\\"}else if ratio>=0.85{\\\"A\\\"}else if ratio>=0.70{\\\"B\\\"}else{\\\"C\\\"}}\n    pub fn total(&self)->f32{self.surgeons.iter().map(|s|s.score).sum::<f32>()+self.vitals*20.+self.remaining.max(0.)*5.-self.mistakes as f32*100.}\n    pub fn finish(&mut self){self.mode=\\\"results\\\".into();self.outcome=if self.campaign && self.case<7{Outcome::Playing}else{Outcome::Won};self.completed.push(self.case);self.emit(\\\"OPERATION COMPLETE\\\",\\\"complete\\\",Vec2::ZERO,0,false);}\n    pub fn fail(&mut self){self.mode=\\\"dead\\\".into();self.outcome=Outcome::Lost;self.callout=\\\"Time of death: 03:42.\\\".into();self.emit(\\\"FLATLINE\\\",\\\"flatline\\\",Vec2::ZERO,0,false);}\n    pub fn next(&mut self){\n        if self.phase+1<self.chart().phases.len(){self.phase+=1;self.load_phase();}\n        else{self.finish();}\n    }\n    pub fn retry(&mut self,checkpoint:bool){\n        self.mode=\\\"operation\\\".into();self.outcome=Outcome::Playing;self.vitals=85.;self.code=0.;self.remaining=self.chart().timer*0.85;self.defibs=2u8.saturating_sub(self.difficulty);\n        if \"'!checkpoint {self.phase=0;for s in &mut self.surgeons{s.score=0.;s.chain=0;}}\n        self.load_phase();\n    }\n    pub fn on_beat(&self)->bool{self.beat.min(1.-self.beat)*60./self.bpm <=self.tune.beat_window/1000.}\n    fn mistake(&mut self,line:&str,damage:f32,seat:usize){\n        if self.mistake_cd>0.{return;}self.mistake_cd=0.8;self.mistakes+=1;\n        if !self.tune.immortal{self.vitals=(self.vitals-damage*self.tune.wrong_penalty).max(0.);}\n        self.surgeons[seat].chain=0;self.callout=line.into();self.emit(line,\"mistake\",self.surgeons[seat].cursor,seat,false);\n    }\n    fn rate(&mut self,seat:usize,quality:f32,pos:Vec2){\n        let q=quality/self.tune.strictness.max(0.2);\n        let (word,points,gain)=if q>=0.88{(\"IMMACULATE\",400.,8.)}else if q>=0.66{(\"CLEAN\",250.,4.)}else if q>=0.34{(\"GOOD\",120.,2.)}else{(\"SLOPPY\",10.,0.)};\n        let beat=self.on_beat();let s=&mut self.surgeons[seat];\n        if q>=0.66{s.chain+=1;}else if q<0.34{s.chain=0;}\n        s.best_chain=s.best_chain.max(s.chain);s.last_good=self.time;\n        let mult=if s.chain>=20{2.}else if s.chain>=10{1.5}else if s.chain>=5{1.25}else{1.};\n        s.score+=points*mult*if beat{1.25}else{1.}*self.tune.score;\n        s.gift=(s.gift+(gain+if beat{2.}else{0.})*self.tune.gift_gain).min(100.);\n        self.actions+=1;self.mark(&format!(\"rating:{word}\"));if beat{self.mark(\"on_beat\");}\n        self.emit(word,\"rating\",pos,seat,beat);\n        if beat && self.gift_left>0. && self.gift_kind!=\"Echo\" {self.gift_left+=60./self.bpm;}\n    }\n    fn complete(&mut self,index:usize,seat:usize,quality:f32){\n        let pos=self.hazards[index].pos;let kind=self.hazards[index].kind.clone();let tool=self.hazards[index].tool(self.case);\n        let stage=self.hazards[index].stage;self.mark(&format!(\"tool:{tool}\"));\n        let mut done=true;\n        if kind==\"tumor\" && stage<2 || kind==\"nodule\" && stage==0 || kind==\"ember\" && stage<2 || kind==\"bone\" && stage==0 {\n            self.hazards[index].stage+=1;self.hazards[index].progress=0.;done=false;\n            if kind==\"ember\" && stage==0{self.callout=\"Brittle. Crack the shell with the scalpel.\".into();}\n            if kind==\"bone\"{self.callout=\"Aligned. Wire it with two even crossings.\".into();}\n        }\n        if done{self.hazards[index].alive=false;self.mark(&format!(\"cleared:{kind}\"));}\n        self.rate(seat,quality,pos);\n        if self.gift_left>0. && (self.gift_kind==\"Echo\"||self.gift_kind==\"Duet\") && seat!=3{\n            if let Some(j)=self.hazards.iter().position(|h|h.alive && h.tool(self.case)==tool && h.id!=self.hazards[index].id){\n                let p=self.hazards[j].pos;\n                self.surgeons[3].active=true;self.surgeons[3].ghost=true;self.surgeons[3].cursor=p;self.surgeons[3].tool=tool;\n                self.hazards[j].progress=0.;\n                if self.hazards[j].kind==\"ember\" && self.hazards[j].stage<2 || self.hazards[j].kind==\"tumor\" && self.hazards[j].stage<2 || self.hazards[j].kind==\"nodule\" && self.hazards[j].stage==0{self.hazards[j].stage+=1;}else{self.hazards[j].alive=false;}\n                self.mark(\"echo_repeat\");self.rate(seat,quality,p);self.emit(\"ECHO\",\"gift\",p,3,false);\n            }\n        }\n    }\n    fn target(&self,p:Vec2,tool:u8)->Option<usize>{\n        self.hazards.iter().enumerate().filter(|(_,h)|h.alive && (!h.hidden || h.reveal>0. || tool==6) )\n            .filter(|(_,h)|{let d=if matches!(h.kind.as_str(),\"incision\"|\"laceration\"|\"bleeder\"|\"dressing\"|\"tether\"|\"soloist\"){line_distance(p,h.pos,h.end).0}else{p.distance(h.pos)}; d<h.radius()+0.4})\n            .min_by(|(_,a),(_,b)|p.distance_squared(a.pos).total_cmp(&p.distance_squared(b.pos))).map(|(i,_)|i)\n    }\n    pub fn tick(&mut self,inputs:[SurgeonInput;4],dt:f32){\n        if self.mode!=\"operation\" {return;}\n        let slow=if self.gift_left>0. && self.gift_kind!=\"Echo\" {self.tune.hush_scale}else{1.};\n        let world=dt*self.tune.time_scale*slow;\n        self.time+=world;self.phase_time+=world;\n        for c in &mut self.cues{c.age+=dt;}\n        self.cues.retain(|c|c.age<4.);\n        self.mistake_cd=(self.mistake_cd-dt).max(0.);self.gift_left=(self.gift_left-dt).max(0.);\n        if self.gift_left==0.{self.surgeons[3].active=false;}\n        self.bpm=72.+(1.-self.vitals/100.)*76.*self.tune.heart_coupling;\n        let oldbeat=self.beat;self.beat=(self.beat+world*self.bpm/60.).fract();\n        let pulse=self.beat<oldbeat;if pulse {self.beats+=1;}\n        if !self.tune.freeze{self.remaining-=world/self.tune.timer.max(0.1);}\n        if self.remaining<=0. {self.fail();return;}\n        for h in &mut self.hazards {h.age+=world;h.reveal=(h.reveal-world).max(0.);}\n        if self.code<=0. {\n            let difficulty=[0.7,1.,1.3][self.difficulty.min(2) as usize];\n            let drain=self.hazards.iter().filter(|h|h.alive).map(|h|h.drain()).sum::<f32>()+0.05;\n            if !self.tune.immortal{self.vitals=(self.vitals-drain*world*self.tune.drain*difficulty).max(0.);}\n            if self.vitals==0. {if self.defibs>0{self.defibs-=1;self.start_code(1,false);}else{self.fail();return;}}\n        } else {\n            self.code-=dt;\n            if self.code<=0. {if self.tune.immortal {self.vitals=30.;self.shocks=0;}else{self.fail();return;}}\n        }\n        self.strain(world,pulse);\n        for (seat,input) in inputs.iter().enumerate(){\n            if seat==3 && self.surgeons[3].ghost {continue;}\n            if !input.active{continue;}\n            self.surgeons[seat].active=true;\n            self.operate(seat,*input,dt,world);\n        }\n        if self.mode!=\"operation\" {return;}\n        if self.blue {\n            if self.time>=self.blue_at && self.hazards.iter().filter(|h|h.alive).count()<10 {self.blue_wave();}\n            if self.remaining<0.1{self.finish();}\n        }else if self.code<=0. && self.shocks==0 && self.phase_time>1. && !self.hazards.iter().any(|h|h.alive){\n            self.phase_results.push(self.vitals);self.next();\n        }\n    }\n    fn operate(&mut self,seat:usize,input:SurgeonInput,dt:f32,world:f32){\n        let old=self.surgeons[seat].held;let was=old&USE!=0;let held=input.held&USE!=0;\n        let mut p=input.aim.clamp(Vec2::new(-9.,-4.1),Vec2::new(9.,4.15));\n        let tool=if self.stage().hazards.iter().any(|h|h.kind==\"dressing\"){8}else{input.tool.min(8)};\n        if self.case>=5 && self.case<=6 && self.tune.tremor && !input.assisted && self.gift_left==0. {p+=Vec2::new((self.time*2.3).sin(),(self.time*1.7).cos())*0.08;}\n        if input.assisted && tool!=7 && self.tune.assist>0. {\n            if let Some(h)=self.hazards.iter().filter(|h|h.alive && h.tool(self.case)==tool).min_by(|a,b|p.distance_squared(a.pos).total_cmp(&p.distance_squared(b.pos))) {\n                if p.distance(h.pos)<1.2 && p.distance(self.surgeons[seat].cursor)>0.001 {p=p.lerp(h.pos,self.tune.assist*dt*3.);}\n                if held && tool==2 {let dir=(h.end-h.pos).normalize_or_zero();let t=(h.progress+0.18).min(0.95);let at=h.pos.lerp(h.end,t);let side=Vec2::new(-dir.y,dir.x);p=at+side*(p-at).dot(side).clamp(-0.65,0.65);}\n            }\n        }\n        self.surgeons[seat].last=self.surgeons[seat].cursor;\n        self.surgeons[seat].cursor=p;\n        self.surgeons[seat].iv_cool=(self.surgeons[seat].iv_cool-world).max(0.);\n        if tool!=self.surgeons[seat].tool {self.surgeons[seat].charge=0.;self.surgeons[seat].grabbed=None;}\n        self.surgeons[seat].tool=tool;self.surgeons[seat].held=input.held;\n        if input.held&CANCEL!=0{self.surgeons[seat].grabbed=None;self.surgeons[seat].charge=0.;return;}\n        if input.held&GIFT!=0 && self.surgeons[seat].gift>=35. {\n            self.surgeons[seat].gift_hold+=dt;\n        }else if old&GIFT!=0 && self.surgeons[seat].gift_hold>0. {\n            if self.on_beat() && self.surgeons[seat].gift_hold>=0.2{\n                let kind=if self.case==7{\"Duet\"}else if self.case>=5{\"Echo\"}else{\"Hush\"};\n                self.gift_kind=kind.into();self.gift_left=if kind==\"Echo\"{self.tune.echo_duration}else{6.*60./self.bpm}*self.tune.gift_duration;\n                self.surgeons[seat].gift=0.;self.mark(&format!(\"gift:{kind}\"));self.callout=match kind{\"Hush\"=>\"The space between two heartbeats. Stay here.\",\"Echo\"=>\"The hands I had before I learned to be afraid.\",_=>\"Two surgeons. One heartbeat.\"}.into();\n                self.emit(kind,\"gift\",p,seat,false);\n            } self.surgeons[seat].gift_hold=0.;\n        }\n        if self.code>0. {\n            if input.held&SHOCK!=0 {self.surgeons[seat].charge+=dt;}\n            else if old&SHOCK!=0{\n                let charge=self.surgeons[seat].charge;self.surgeons[seat].charge=0.;\n                if charge>=1.1 && self.beat.min(1.-self.beat)<0.25 {\n                    self.shocks=self.shocks.saturating_sub(1);self.mark(\"defibrillated\");self.rate(seat,0.95,p);self.emit(\"SINUS RHYTHM\",\"shock\",p,seat,true);\n                    if self.shocks==0 {self.code=0.;self.vitals=40.;self.callout=\"We have a rhythm. Keep it.\".into();}else{self.code=self.tune.code_window+5.;}\n                }else{self.callout=\"Charge fully. Release as the ghost beat meets the line.\".into();}\n            }return;\n        }\n        if tool==7 {\n            self.surgeons[seat].cursor=Vec2::new(8.3,-3.1);\n            if held && self.surgeons[seat].iv_cool<=0. {self.surgeons[seat].charge+=dt*0.5;}\n            if !held && was && self.surgeons[seat].charge>0.{\n                let c=self.surgeons[seat].charge;self.surgeons[seat].charge=0.;self.surgeons[seat].iv_cool=4.;self.mark(\"tool:7\");\n                if c>1.12{self.mistake(\"Overdose. Watch the green band.\",8.,seat);}else{self.vitals=(self.vitals+(if c>=0.75{18.}else{9.*c})*self.tune.heal).min(100.);self.rate(seat,if c>=0.75{0.96}else{0.5},p);}\n            }return;\n        }\n        if tool==6 && self.case!=7 {\n            if held{self.mark(\"tool:6\");for h in &mut self.hazards{if h.pos.distance(p)<3.{h.reveal=8.;}}}\n            return;\n        }\n        // Forceps keep their own target while the hand pulls away.\n        let target=self.surgeons[seat].grabbed.and_then(|id|self.hazards.iter().position(|h|h.id==id&&h.alive)).or_else(||self.target(p,tool));\n        let Some(i)=target else {\n            if held && !was && tool==0 && p.length()<7.0 {\n                self.mistake(\"Doctor, that'\"'s healthy tissue.\\\",2.,seat);\n                let h=HazardSpec{kind:\\\"laceration\\\".into(),pos:p.to_array(),end:Some((p+Vec2::new(0.9,0.2)).to_array()),hidden:false,stage:0};\n                self.spawn(&h);\n            }\n            if \"'!held{self.surgeons[seat].grabbed=None;self.surgeons[seat].charge=0.;}return;\n        };\n        let correct=self.hazards[i].tool(self.case)==tool || tool==3 && self.hazards[i].kind==\"sac\";\n        if !correct{if held && !was{self.mistake(\"Wrong instrument, Doctor.\",0.,seat);}return;}\n        if self.hazards[i].hidden && self.hazards[i].reveal<=0.{return;}\n        let power=self.tune.power/if matches!(self.hazards[i].kind.as_str(),\"nodule\"|\"ember\"|\"sac\"){self.tune.toughness.max(0.1)}else{1.};\n        if self.tune.one_hit && held && matches!(self.hazards[i].kind.as_str(),\"nodule\"|\"ember\"|\"sac\") {self.complete(i,seat,1.);return;}\n        match tool {\n            0|8=>{\n                if held {\n                    let h=&mut self.hazards[i];\n                    if h.kind==\"tumor\" {let r=p.distance(h.pos);if (r-0.65).abs()<0.5 {h.progress+=p.distance(self.surgeons[seat].last)*power/3.4;}}\n                    else if h.kind==\"ember\" {h.progress+=dt*power/0.7;}\n                    else {let (error,t)=line_distance(p,h.pos,h.end);if error<0.6 && t<=h.progress+0.24 {h.progress=h.progress.max((t+0.07)*power.min(1.25));self.surgeons[seat].error+=error*dt;}}\n                    if h.progress>=0.98{let q=1.-self.surgeons[seat].error.min(0.6);self.surgeons[seat].error=0.;self.complete(i,seat,q);}\n                }\n            },\n            1=>{\n                if held{\n                    if self.surgeons[seat].grabbed.is_none(){self.surgeons[seat].grabbed=Some(self.hazards[i].id);self.surgeons[seat].origin=p;}\n                    if self.hazards[i].kind==\"bone\" {\n                        self.hazards[i].pos=p;self.hazards[i].angle+=input.rotate*dt*2.;\n                        if p.distance(self.hazards[i].end)<0.4 && self.hazards[i].angle.abs()<0.25 {self.hazards[i].pos=self.hazards[i].end;self.hazards[i].end+=Vec2::new(0.,1.2);self.surgeons[seat].grabbed=None;self.complete(i,seat,0.95);}\n                    }else{\n                        let delta=p-self.surgeons[seat].origin;let dir=(self.hazards[i].end-self.hazards[i].home).normalize_or_zero();\n                        let angle=delta.normalize_or_zero().dot(dir);let diastole=self.beat>0.28;\n                        if delta.length()>0.85 && (self.hazards[i].kind!=\"tendril\" || diastole){\n                            self.surgeons[seat].grabbed=None;\n                            if angle>0.7 {self.complete(i,seat,angle);}else{self.mistake(\"Pull along the axis, Doctor.\",3.,seat);self.surgeons[seat].origin=p;}\n                        }\n                    }\n                }else{self.surgeons[seat].grabbed=None;}\n            },\n            2=>{if held{\n                let h=&mut self.hazards[i];let dir=(h.end-h.pos).normalize_or_zero();let side=dir.perp_dot(p-h.pos);let (_,along)=line_distance(p,h.pos,h.end);\n                if side.abs()>0.09 && (h.side==0. || side.signum()!=h.side.signum()) && along<h.progress+0.42 {\n                    h.count+=1;h.side=side;let need=if h.kind==\"bone\"{2.}else{(h.end.distance(h.pos)*2.).ceil().max(3.)};h.progress=h.count as f32/need;\n                }\n                if h.progress>=1.{self.complete(i,seat,0.93);}\n            }},\n            3|5=>{if held{let h=&mut self.hazards[i];h.progress+=dt*power*(if tool==3{0.65*input.pressure.max(0.2)}else{0.8});if h.progress>=1.{self.complete(i,seat,if tool==3{0.55}else{0.94});}}},\n            4|6=>{\n                if held {self.surgeons[seat].charge+=dt*power/if self.hazards[i].kind==\"sac\"{0.75}else{1.2};self.hazards[i].progress=self.surgeons[seat].charge;\n                    if self.surgeons[seat].charge>1.35{self.surgeons[seat].charge=0.;self.hazards[i].progress=0.;self.mistake(if tool==6 || self.case==6{\"Frostbite. Lift off.\"}else{\"Overheated. Lift off.\"},4.,seat);}\n                }else if was{let c=self.surgeons[seat].charge;self.surgeons[seat].charge=0.;if c>=0.72{self.complete(i,seat,if c<=1.08{0.98}else{0.45});}else{self.hazards[i].progress=0.;}}\n            },_=>{}\n        }\n        if held && self.surgeons[seat].chain>0 && self.time-self.surgeons[seat].last_good>self.tune.chain_window {self.surgeons[seat].chain=0;}\n    }\n    fn strain(&mut self,dt:f32,pulse:bool){\n        let strain=self.stage().strain.clone();\n        if strain.contains(\"introit\") || strain.contains(\"libera\") {\n            if pulse && self.beats.is_multiple_of(3) {\n                let speed=self.tune.strain_speed*(self.bpm/72.).min(1.4);\n                for h in &mut self.hazards{if h.alive && h.kind==\"nodule\" && h.stage==0 && h.age>1.5 {\n                    let k=h.id as f32;h.pos=h.home+Vec2::new((self.beats as f32*0.7+k).sin(),(self.beats as f32*0.5+k).cos())*0.8*speed;h.end=h.pos+Vec2::new(0.,-1.2);\n                }}\n            }\n        }\n        if strain.contains(\"lacrimosa\") || strain.contains(\"libera\") {\n            let mut burst=vec![];\n            for h in &mut self.hazards {if h.alive && h.kind==\"sac\" && h.age>16./self.tune.strain_speed.max(0.1){h.kind=\"pool\".into();h.progress=0.;h.hidden=false;burst.push(h.pos);}}\n            for p in burst {self.mark(\"sac_burst\");self.callout=\"The sac has ruptured. Suction the caustic pool.\".into();self.emit(\"CAUSTIC\",\"burst\",p,0,false);}\n        }\n        if strain.contains(\"dies\") || strain.contains(\"furnace\") || strain.contains(\"libera\") {\n            let count=self.hazards.iter().filter(|h|h.alive&&h.kind==\"ember\").count();\n            self.fever=(self.fever+dt*(count as f32*1.1-1.5)).clamp(0.,120.);\n            if self.fever>100. && !self.tune.immortal {self.vitals=(self.vitals-dt*3.).max(0.);}\n            if count>0 && pulse && self.beats.is_multiple_of(5) {self.heat_radius=0.;self.callout=\"Heat ring. Lift off!\".into();self.mark(\"heat_ring\");}\n            if self.heat_radius>=0. {\n                self.heat_radius+=dt*4.;\n                for s in 0..4 {if self.surgeons[s].active && self.surgeons[s].held&USE!=0 && (self.surgeons[s].cursor.length()-self.heat_radius).abs()<0.3{self.mistake(\"Lift off! Lift off!\",3.,s);}}\n                if self.heat_radius>11.{self.heat_radius=-1.;}\n            }\n        }\n    }\n    pub fn bot_seat(&self,seat:usize)->SurgeonInput {\n        let s=&self.surgeons[seat];let mut input=SurgeonInput{active:true,aim:s.cursor,tool:s.tool,pressure:1.,..Default::default()};\n        if self.code>0.{input.held=if s.charge<1.22 || self.beat.min(1.-self.beat)>0.17{SHOCK}else{0};return input;}\n        if s.gift>=60. && self.case>=3 && self.gift_left<=0. {input.held=if s.gift_hold<0.25 || !self.on_beat(){GIFT}else{0};return input;}\n        if self.vitals<65. && s.iv_cool<=0. || s.tool==7 && s.charge>0. {input.tool=7;input.held=if s.charge<0.86{USE}else{0};return input;}\n        let target=s.grabbed.and_then(|id|self.hazards.iter().find(|h|h.id==id && h.alive)).or_else(||self.hazards.iter().filter(|h|h.alive).min_by(|a,b| {\n            let weight=|h:&Hazard|s.cursor.distance(h.pos)-if h.kind==\"bleeder\"{8.}else{0.};weight(a).total_cmp(&weight(b))\n        }));\n        let Some(h)=target else{return input};\n        let tool=if h.hidden && h.reveal<=0.{6}else{h.tool(self.case)};input.tool=tool;\n        let mut goal=h.pos;let mut hold=true;\n        match tool{\n            0|8=>{if h.kind==\"tumor\"{let a=self.time*4.;goal=h.pos+Vec2::new(a.cos(),a.sin())*0.65;}else if h.kind!=\"ember\"{goal=h.pos.lerp(h.end,(h.progress+0.1).min(1.));}},\n            1=>{if s.grabbed.is_some(){goal=if h.kind==\"bone\"{h.end}else{s.origin+(h.end-h.home).normalize_or_zero()*1.1};}},\n            2=>{let dir=(h.end-h.pos).normalize_or_zero();let side=Vec2::new(-dir.y,dir.x);goal=h.pos.lerp(h.end,(h.progress+0.05).min(0.95))+side*if h.side>0.{-0.35}else{0.35};},\n            4|6=>{hold=!(s.charge>=0.88 && (tool==4 || self.case==7));},_=>{}\n        }\n        let delta=goal-s.cursor;input.aim=s.cursor+delta.clamp_length_max(self.tune.cursor_speed/60.);\n        if delta.length()>0.65 && s.grabbed.is_none(){hold=false;}\n        if tool!=s.tool{hold=false;}\n        if self.heat_radius>=0. && (input.aim.length()-self.heat_radius).abs()<0.75 {hold=false;}\n        input.held=if hold{USE}else{0};input\n    }\n    fn blue_wave(&mut self){\n        self.wave+=1;self.blue_at=self.time+12.;self.mark(\"codeblue_wave\");\n        let count=2+self.surgeons.iter().filter(|s|s.active && !s.ghost).count();\n        let kinds=[\"laceration\",\"pool\",\"polyp\",\"hook\",\"burn\",\"nodule\"];\n        for i in 0..count{let a=(self.wave as f32*1.7+i as f32*2.4).sin()*5.;let z=(self.wave as f32+i as f32).cos()*2.6;let kind=kinds[(self.wave as usize+i)%kinds.len()];self.spawn(&HazardSpec{kind:kind.into(),pos:[a,z],end:Some([a+1.,z-0.4]),hidden:false,stage:0});}\n        self.callout=format!(\"Triage wave {}. Keep the patient alive.\",self.wave);\n    }\n    pub fn status_json(&self)->serde_json::Value {serde_json::to_value(self).unwrap_or_default()}\n}\nfn line_distance(p:Vec2,a:Vec2,b:Vec2)->(f32,f32){let d=b-a;let t=((p-a).dot(d)/d.length_squared().max(0.001)).clamp(0.,1.);(p.distance(a+d*t),t)}\n\npub fn build(sim:&mut Sim,rest:Option<&str>)->Result<()> {\n    let level=include_str!(\"level.toml\");let def=crate::room::RoomDef::parse(level)?;\n    crate::scenes::build_standalone_room(sim,\"surgery\",def);\n    if let Some(id)=sim.state.player{sim.despawn(id);}\n    sim.state.focus=Vec3::ZERO;\n    let rest=rest.unwrap_or(\"title\");let case=rest.strip_prefix(\"case/\").and_then(|n|n.parse().ok()).unwrap_or(0);\n    let mut game=Surgery::new(case,rest==\"campaign\",rest==\"codeblue\");\n    if rest==\"title\"||rest==\"card\"||rest==\"mirror\" {game.mode=rest.into();}\n    if rest==\"attract\"{game=Surgery::new(3,false,false);game.tune.bot=true;game.tune.immortal=true;game.surgeons[0].gift=100.;}\n    sim.state.play=Some(GameBox::new(game));Ok(())\n}\nimpl Game for Surgery {\n    const KEY:&'\"'static str=\\\"surgery\\\";\n    fn pre(&mut self,_sim:&mut Sim,input:&InputFrame,dt:f32,_events:&mut Vec<SimEvent>)->BTreeMap<crate::entity::EntityId,InputFrame>{\n        if self.mode==\\\"results\\\" && self.campaign && self.case<7 {\n            let coverage=self.coverage.clone();let completed=self.completed.clone();let difficulty=self.difficulty;let mut next=Self::new(self.case+1,true,false);next.coverage=coverage;next.completed=completed;next.difficulty=difficulty;next.mark(&format\"'!(\"phase:{}:0\",next.case));*self=next;\n        }\n        let mut inputs=input.surgeons;\n        if self.tune.bot {inputs[0]=self.bot_seat(0);}\n        if self.case==7 && !inputs[1].active && !self.blue {inputs[1]=self.bot_seat(1);}\n        self.tick(inputs,dt);BTreeMap::new()\n    }\n    fn status(&self,_sim:&Sim)->serde_json::Value{self.status_json()}\n    fn outcome(&self)->Outcome{self.outcome}\n    fn bot(&self,_sim:&Sim)->InputFrame{let mut f=InputFrame::default();f.surgeons[0]=self.bot_seat(0);f}\n}\nEOF\ncat > \"$d/engine/crates/pav_core/src/games/surgery/level.toml\" <<'\"'EOF'\nname = \\\"Mercy Harbor General\\\"\nabout = \\\"The First Movement\\\"\nentrance = { at = [0, 0], facing = \\\"north\\\" }\n[camera]\ntilt = 73.0\ndistance = 19.9\nfov = 36.0\nheight_offset = 0.0\nfollow_lag = 0.0\n[view]\n[layout]\norigin = [90.0, 0.0, -8.0]\n[[layout.layer]]\ny = 0\nmap = '''\n...\n.P.\n...\n'''\n[layout.legend.'.']\nblocks = [{ y0 = -0.3, y1 = 0.0, color = \\\"#10383d\\\" }]\n[layout.legend.'P']\nmarker = \\\"player\\\"\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nr=Path(Path('.game-path').read_text()); p=r/'engine/crates/pav_core/src/games/surgery/content'\ndef h(kind,x,z,ex=None,ez=None,hidden=False,stage=0):\n v={'kind':kind,'pos':[x,z]}\n if ex is not None:v['end']=[ex,ez]\n if hidden:v['hidden']=True\n if stage:v['stage']=stage\n return v\ndef phase(name,obj,line,plate,hazards=None,strain='',code=0):return dict(name=name,objective=obj,line=line,plate=plate,hazards=hazards or [],strain=strain,code=code)\ndef close(plate):return phase('Closure','Paint along the closure with the dressing.','A steady hand all the way to the end, Doctor.',plate,[h('dressing',-3,0,3,0)])\ncases=[\n dict(name='Barbs',patient='Anton Deverell',life='A net-mender. His daughter is waiting by the harbour.',diagnosis='Cable splinters and embedded fishing hooks',surgeon='Mara',timer=240,par=4800,fate='Anton Deverell will mend nets again by spring.',phases=[\n phase('Your hands','Gel the inflamed tissue. Then lift each hook along its arrow.','Forceps, Doctor. Hold to grasp. Draw it out along the pale arrow.','forearm',[h('inflammation',-4,0),h('hook',-1.2,-1.1,-1.2,-2.4),h('hook',2.1,1.1,2.9,0.1)]),\n phase('Under the surface','Suction the pool. Something is still underneath.','There is one more barb. The blood is hiding it.','forearm',[h('pool',0,-0.3),h('hook',0,-0.3,0.3,-1.7,hidden=True)]),\n phase('A seam','Suture across the wound, alternating sides of the moving needle.','Hold the needle. Cross the line. Keep your spacing even.','forearm',[h('laceration',-2,0.6,2,0.6)]),close('forearm')]),\n dict(name='Routine',patient='Rosalind Pike',life='She brings ships home through water no one else can read.',diagnosis='Acute appendicitis; routine laparoscopic conversion',surgeon='Mara',timer=270,par=6800,fate='Rosalind Pike will bring the morning ferry home.',phases=[\n phase('Routine','Trace the dashed incision in one continuous stroke.','Chief Voss is in the gallery. Count only the patient.','abdomen',[h('incision',-2.5,0,2.5,0)]),\n phase('The appendix','Laser the polyps: hold to heat, release inside the mint band.','Release before the ring turns red. Living tissue is not forgiving.','bowel',[h('polyp',-3,-1),h('polyp',0,0.7),h('polyp',3,-0.7),h('inflammation',2.7,1.5)]),\n phase('A routine complication','Suture the artery immediately. Use IV Push if vitals fall.','Arterial rupture. Suction, then three fast crossings. Now, Doctor.','bowel',[h('bleeder',-1,-0.8,1,-0.8),h('pool',2,1.2),h('laceration',-3,1,-0.5,1)]),close('abdomen')]),\n dict(name='Shrapnel Night',patient='Ivo Senn',life='A grain-terminal foreman who sent his crew out first.',diagnosis='Blast injury; thoracic shrapnel',surgeon='Mara',timer=300,par=8200,fate='Ivo Senn will hear his crew call him stubborn again.',phases=[\n phase('The corridor','Open the chest along the guide.','One table. One life. That is all the room we need.','chest',[h('incision',0,-2.5,0,2)]),\n phase('What the light misses','Hold Scanner near the tissue. Forceps the revealed fragments.','Sweep slowly. Metal answers the scanner.','lung',[h('shard',-3,-1,-2,-2,hidden=True),h('shard',2,0.8,3,0,hidden=True),h('pool',-0.6,1.7)]),\n phase('Half a beat before','Charge the defibrillator. Release on a ghost heartbeat.','Mara: Now. Teddy: How did you know?','lung',code=1),\n phase('Stay with us','Close the lacerations and gel the bruised lung.','We have him back. Finish what you came here to do.','lung',[h('laceration',-3,-1,0,-1),h('laceration',1,1.3,4,1.3),h('burn',-1,1.8)]),close('chest')]),\n dict(name='Something Moved',patient='Elian Firth',life='A bicycle courier. He has never missed a delivery.',diagnosis='A benign hepatic mass, according to the chart',surgeon='Mara',timer=360,par=15000,fate='Elian Firth will have one story he cannot put in a delivery note.',phases=[\n phase('The benign mass','Scalpel around the mass, Forceps to lift, then Gel the bed.','Lift the mass. Slowly. We are guests in this liver.','liver',[h('tumor',0,0)]),\n phase('It moved','Scanner the violet bump. Heat its shell, then pull it out.','It moved. Masses do not move. Bashir. It moved.','liver',[h('nodule',0,-0.4,0,-1.7,hidden=True)],'introit'),\n phase('The first division','Two shells. Scanner, Laser, Forceps. Count in three.','Teddy: The ECG is in three-four time. Hearts are not allowed to waltz.','liver',[h('nodule',-2,-1,-2,-2.2,hidden=True),h('nodule',2,1,2,-0.3,hidden=True)],'introit'),\n phase('Between heartbeats','Four voices. Hold the gift button, then release on a beat.','Doctor... your hands. The world is slowing around them.','liver',[h('nodule',-3,-1,-3,-2.3,hidden=True),h('nodule',0,-1.6,0,-2.8,hidden=True),h('nodule',3,-0.4,3,-1.6,hidden=True),h('nodule',-1,1.8,-1,0.5,hidden=True)],'introit'),\n phase('Amen','Sever the three tethers. Heat the core. Pull the last voice free.','It has gathered itself. Give it nowhere left to hold.','liver',[h('tether',-4,-1,-1,-0.2),h('tether',1,-0.2,4,-1),h('tether',0,1,0,3),h('nodule',0,0,0,-1.3)],'introit'),close('liver')]),\n dict(name='The Night Ward',patient='Rosalind Pike',life='She was supposed to go home this morning.',diagnosis='R.E.Q.U.I.E.M. / Lacrimosa; pulmonary colonisation',surgeon='Mara',timer=360,par=12500,fate='Rosalind Pike will learn to trust the sound of rain again.',phases=[\n phase('Six tears','Laser the stems before the sacs burst. Suction any caustic pools.','No more lessons. You have heard the rhythm.','lung',[h('sac',-4,-1.3),h('sac',-2,-1.8),h('sac',0,-1.3),h('sac',2,-1.8),h('sac',4,-1.3),h('sac',0,1.8)],'lacrimosa'),\n phase('The eye opens','Cut across the exposed eye.','There. The crown has opened.','lung',[h('incision',-1.5,0,1.5,0)],'lacrimosa'),\n phase('A rising tide','Clear the second crown and the flooded field.','I can hear her lungs filling.','lung',[h('sac',-3.5,-1),h('sac',-1,-1.5),h('sac',1.5,-1),h('sac',3.7,0),h('pool',-2,1.5),h('burn',2,1.8)],'lacrimosa'),\n phase('Tear out the eye','Forceps the eye. Gel what it leaves behind.','One last attachment. Then she can breathe.','lung',[h('tumor',0,0,stage=1)],'lacrimosa'),close('lung')]),\n dict(name='Second Opinion',patient='Solomon Eke',life='A longshoreman who has carried everyone else for forty years.',diagnosis='Comminuted femoral fracture; intramedullary cysts',surgeon='Pet',timer=360,par=10000,fate='Solomon Eke will walk to the docks on his own legs.',phases=[\n phase('Old hands','Forceps each bone into its pale outline. Rotate if needed; wire it.','Pet: Bones remember their shape. Help them remember.','femur',[h('bone',-4,-0.5,-1,-0.5),h('bone',4,0.8,1,0.8)]),\n phase('Two of you','Laser the marrow cysts. The Echo repeats your finished technique.','Bashir: There were two of you. Pet: One of us retired.','femur',[h('polyp',-3,-1.6),h('polyp',0,-1.6),h('polyp',3,-1.6),h('polyp',-3,1.8),h('polyp',0,1.8),h('polyp',3,1.8)]),\n phase('The years between','Close the deep tears. Gel the exposed marrow.','My hands are steady. I had forgotten the silence of them.','femur',[h('laceration',-3,-0.4,0,-0.4),h('laceration',1,0.8,4,0.8),h('burn',-1,1.7)]),close('femur')]),\n dict(name='Dies Irae',patient='Ottoline Voss',life='Chief of Surgery. Eleven years carrying the truth under her ribs.',diagnosis='R.E.Q.U.I.E.M. / Dies Irae; pericardial furnace',surgeon='Pet',timer=420,par=16000,fate='Ottoline Voss will live long enough to sign her confession.',phases=[\n phase('The five embers','Cryoprobe to frost. Scalpel to crack. Forceps to extract.','Voss: If I die, Perpetua, you will have to fill out the form.','pericardium',[h('ember',-4,-1),h('ember',-2,1.5),h('ember',0,-1.7),h('ember',2,1.5),h('ember',4,-1)],'dies'),\n phase('Lift off','The heat ring punishes a held tool. Lift as it passes.','Pet: I have been looking forward to the form.','pericardium',[h('ember',-2,0),h('ember',2,0),h('burn',0,2)],'dies'),\n phase('The furnace','Open the furnace, then clear its machinery.','There is a rhythm beneath the rhythm.','pericardium',[h('incision',-2,0,2,0)],'furnace'),\n phase('All the instruments','Freeze the ember, remove the debris, suction, suture and gel.','She helped make this. Today she helps us end it.','heart',[h('ember',0,0),h('shard',-3,-1,-3,-2.4),h('pool',3,-1),h('bleeder',-2,1.5,1,1.5),h('burn',3,1.8)],'furnace'),close('pericardium')]),\n dict(name='Libera Me',patient='Bashir Haddad',life='The voice that has guided every one of your hands.',diagnosis='R.E.Q.U.I.E.M. / Libera Me; systemic convergence',surgeon='Mara + Pet',timer=540,par=19000,fate='Bashir Haddad wakes, and says: Clean, Doctor.',phases=[\n phase('Scalpel','Open the field. Teddy is your scrub nurse now.','Mara: Scalpel. Teddy: I have seen this done. Mostly.','chest',[h('incision',0,-2.5,0,2.5)]),\n phase('Remember the waltz','Strip the nodules and clear the pools. Pet is with you.','Pet: You take the left. I will take the impossible.','heart',[h('nodule',-3,-0.5,-3,-1.8),h('nodule',3,-0.5,3,-1.8),h('pool',0,2)],'libera'),\n phase('Remember the rain','Sever the sacs before the coronary arteries flood.','Teddy: The flowers. They sent us flowers.','heart',[h('sac',-4,-1.2),h('sac',-1.5,1.5),h('sac',1.5,-1.3),h('sac',4,1.2)],'libera'),\n phase('Remember the fire','Freeze with Scanner-slot Cryoprobe. Crack and extract. Lift off.','Pet: Different instrument. Same pair of hands.','heart',[h('ember',-2,0),h('ember',2,0),h('burn',0,2.3)],'libera'),\n phase('The silence','Three shocks. Three ghost beats. Refuse the silence.','Mara: You do not get to stop counting, Bashir.','heart',code=3),\n phase('The Soloist','Trace the strokes. Release the Duet on the heartbeat.','Pet: I can hear it now. Mara: Then play with me.','heart',[h('soloist',-4,-1.5,-1,0),h('soloist',1,0,4,-1.5),h('soloist',-3,1.5,3,1.5)],'libera'),\n phase('Let him go','Grasp the tendril. Pull only when the heart relaxes.','Teddy: Between the beats. Pull between the beats.','heart',[h('tendril',0,0,0,-1.5)],'libera'),close('heart')])]\n(p/'cases.json').write_text(json.dumps({'cases':cases},indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
