q!(g.outcome,Outcome::Won);println!(\"BALANCE {n} score={} par={} rank={} elapsed={}\",g.total(),g.chart().par,g.rank(),g.time);}}\nEOF\ncd \"$d/engine\"; CARGO_BUILD_JOBS=6 cargo test --locked -p pav_core --test surgery -- --nocapture > ../test-core.log 2>&1'","aggregated_output":"","exit_code":0,"status":"completed"}}
