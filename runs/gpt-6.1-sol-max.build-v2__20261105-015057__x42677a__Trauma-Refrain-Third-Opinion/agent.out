{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); cat > \"$d/engine/crates/pav_view/src/surgery.rs\" <<'\"'EOF'\n//\"'! Original procedural medical illustrations, steel instruments and extruded paper actors.\nuse glam::{Mat4,Quat,Vec2,Vec3};\nuse pav_core::games::surgery::{Surgery,Hazard};\nuse pav_render::scene::*;\nuse pav_render::mesh::{MeshData,Vertex};\nuse crate::{CameraParams,CameraRig};\nuse std::f32::consts::{PI,TAU};\n\npub fn camera()->CameraRig{CameraRig::new(CameraParams{tilt:73.,yaw:0.,distance:22.0,fov:36.,follow_lag:0.,height_offset:0.,ortho:false})}\npub fn height(x:f32,z:f32,plate:&str,beat:f32)->f32{\n    let e=x*x/77.+z*z/16.;\n    if e>1. {return 0.24+0.05*(x*3.+z*2.).sin();}\n    let pulse=(beat*TAU).cos().max(0.).powi(6);\n    let dome=(1.-e).max(0.).powf(0.55);\n    let lobes=match plate{\n        \"heart\"|\"pericardium\"=>{let a=((x+0.9).powi(2)/14.+z*z/8.).min(((x-2.).powi(2)/7.)+(z+0.5).powi(2)/5.);(1.-a).max(0.).powf(0.65)*0.85},\n        \"lung\"=>{let a=((x.abs()-2.6).powi(2)/9.+z*z/10.).min(1.);(1.-a).max(0.)*0.5},\n        \"liver\"=>(1.-((x+1.).powi(2)/38.+(z+0.2).powi(2)/9.)).max(0.).powf(0.55)*0.45,\n        \"forearm\"=>0.20*(1.-z*z/8.).max(0.),_=>0.12*(x*1.8+z*0.5).cos(),\n    };\n    0.38+dome*0.55+lobes+0.025*((x*4.+z*1.7).sin()+(z*6.-x).sin())+pulse*if plate==\"heart\"{0.15*dome}else{0.035*dome}\n}\nfn color_plate(x:f32,z:f32,y:f32,plate:&str,clinical:bool)->Vec3{\n    let e=x*x/77.+z*z/16.;\n    if e>1. {\n        let fold=((x*0.8+z*1.7).sin()*0.5+0.5)*0.10;\n        return srgb(28,105,108)*(0.75+fold)+srgb(30,61,67)*((x*9.).sin()*(z*9.).cos()*0.04);\n    }\n    let mut c=if clinical{srgb(84,118,134).lerp(srgb(171,196,196),(y/1.7).clamp(0.,1.))}else{\n        let (dark,light)=match plate{\n            \"liver\"=>(srgb(103,36,48),srgb(224,103,93)),\n            \"heart\"|\"pericardium\"=>(srgb(104,33,55),srgb(237,107,111)),\n            \"lung\"=>(srgb(155,61,80),srgb(249,158,150)),\n            \"femur\"=>(srgb(147,67,69),srgb(236,153,126)),_ =>(srgb(163,60,65),srgb(248,157,132)),\n        };dark.lerp(light,((y-0.35)/1.25).clamp(0.,1.))\n    };\n    let grain=(x*31.+z*17.).sin()*(x*7.-z*23.).cos();c*=0.96+0.04*grain;\n    if e>0.89 {c*=0.56+(1.-e)*2.;}\n    let vein=(z*1.8+(x*0.8).sin()*0.65).sin().abs();\n    if vein<0.035 && e<0.8 {c=c.lerp(if clinical{srgb(56,77,100)}else{srgb(130,40,64)},0.65);}\n    let shine=(x*0.7+z*1.4+(x*0.6).sin()).sin();\n    if shine>0.96 && y>0.7 {c=c.lerp(srgb(255,218,191),0.26);}\n    c\n}\nfn box_at(scene:&mut Scene,p:Vec3,size:Vec3,color:Vec3,style:Style,group:u32){\n    scene.meshes.push(MeshInstance{mesh:MeshKey::Cube,transform:Mat4::from_scale_rotation_translation(size,Quat::IDENTITY,p),color,emissive:0.,style,flags:0,group,material:0,ext:Vec3::ZERO});\n}\nfn sphere(scene:&mut Scene,p:Vec3,size:Vec3,color:Vec3,style:Style,group:u32,emissive:f32){\n    scene.meshes.push(MeshInstance{mesh:MeshKey::Sphere,transform:Mat4::from_scale_rotation_translation(size,Quat::IDENTITY,p),color,emissive,style,flags:0,group,material:0,ext:Vec3::ZERO});\n}\nfn line(scene:&mut Scene,a:Vec3,b:Vec3,r:f32,c:Vec3,group:u32,glow:f32){let mut v=SdfInstance::capsule(a,b,r,c);v.group=group;v.style=if glow>0.{Style::Unlit}else{Style::Lit};v.emissive=glow;scene.sdfs.push(v);}\nfn ring(scene:&mut Scene,p:Vec3,r:f32,progress:f32,c:Vec3,group:u32){for i in 0..48{let t=i as f32/48.;if t>progress{continue;}let a=t*TAU;let b=(t+1./48.)*TAU;line(scene,p+Vec3::new(a.cos()*r,0.,a.sin()*r),p+Vec3::new(b.cos()*r,0.,b.sin()*r),0.018,c,group,0.45);}}\nfn ground(p:Vec2,plate:&str,beat:f32,offset:f32)->Vec3{Vec3::new(p.x,height(p.x,p.y,plate,beat)+offset,p.y)}\n\npub fn emit(scene:&mut Scene,g:&Surgery){\n    scene.meshes.clear();scene.sdfs.clear();scene.dynamic.clear();scene.texts.clear();\n    scene.clear_color=srgb(9,27,31);scene.sun.direction=Vec3::new(-0.25,-1.,-0.35).normalize();scene.sun.color=Vec3::new(1.,0.95,0.88)*0.42;scene.sun.shadow_radius=18.;\n    scene.ambient=Ambient{sky:Vec3::splat(0.5),ground:Vec3::new(0.3,0.22,0.22)};\n    scene.style.cel_bands=3.;scene.style.rim=0.12;scene.style.specular=0.7;\n    scene.post.outline_px=1.25;scene.post.outline_darken=0.4;scene.post.bloom=0.27;scene.post.bloom_threshold=1.15;scene.post.gi=0.55;\n    scene.filter.vignette=0.35;scene.filter.grain=0.035;\n    if g.gift_left>0. && g.gift_kind!=\"Echo\"{scene.filter.saturation=0.3;scene.filter.chroma=0.9;}\n    scene.point_lights.push(PointLight{position:Vec3::new(-1.,7.,-1.),color:Vec3::new(1.,0.97,0.90)*0.9,radius:17.,shadows:true});\n    let plate=g.stage().plate.as_str();\n    // The drape and organ are a single finely tessellated, vertex-painted living surface.\n    let (nx,nz)=(180,104);let mut mesh=MeshData::default();\n    for iz in 0..=nz {for ix in 0..=nx {\n        let x=-13.+26.*ix as f32/nx as f32;let z=-7.+14.*iz as f32/nz as f32;\n        let y=height(x,z,plate,g.beat);let eps=0.035;\n        let n=Vec3::new(height(x-eps,z,plate,g.beat)-height(x+eps,z,plate,g.beat),eps*2.,height(x,z-eps,plate,g.beat)-height(x,z+eps,plate,g.beat)).normalize();\n        let mut col=color_plate(x,z,y,plate,g.tune.clinical);\n        for h in &g.hazards{if !h.alive{continue;}let dist=Vec2::new(x,z).distance(h.pos);if h.kind==\"pool\" && dist<1.3*(1.-h.progress).max(0.05).sqrt()*(1.+0.08*(x*13.+z*9.).sin()) {col=col.lerp(if g.tune.clinical{srgb(34,59,91)}else{srgb(118,10,28)},0.95);}if h.kind==\"burn\" && dist<0.65{col=col.lerp(srgb(119,60,63),0.65);}}\n        debug_assert!(y.is_finite()&&n.is_finite()&&col.is_finite());\n        mesh.vertices.push(Vertex{pos:[x,y,z],normal:n.to_array(),uv:[ix as f32/nx as f32,iz as f32/nz as f32],color:[col.x,col.y,col.z,1.]});\n    }}\n    for iz in 0..nz {for ix in 0..nx{let a=(iz*(nx+1)+ix) as u32;let b=a+(nx+1) as u32;mesh.indices.extend([a,b,a+1,a+1,b,b+1]);}}\n    scene.dynamic.push(DynamicMesh{data:mesh,color:Vec3::ONE,emissive:0.,style:Style::Cel,flags:0,group:5,material:0});\n    let steel=srgb(168,197,200);let dark=srgb(44,67,75);let mint=srgb(140,244,210);\n    // Drape stitching, towel clamps, and shadow-casting retractors.\n    for side in [-1.,1.] {for i in 0..42{let x=-10.+i as f32*0.49;line(scene,Vec3::new(x,0.39,side*5.),Vec3::new(x+0.22,0.39,side*5.),0.009,srgb(72,151,151),10,0.);}\n        for x in [-7.,0.,7.] {let z=side*3.65;let p=Vec3::new(x,0.6,z);box_at(scene,p,Vec3::new(0.6,0.2,1.),steel,Style::Lit,11);line(scene,p+Vec3::Y*0.1,p+Vec3::new(0.,0.4,side*1.5),0.08,steel,12,0.);ring(scene,p+Vec3::new(0.,0.4,side*1.7),0.22,1.,steel,12);}}\n    // Painted vessels and organ-specific structures stay underneath the tasks.\n    for sign in [-1.,1.] {let mut prev=ground(Vec2::new(-6.,sign*1.2),plate,g.beat,0.018);for k in 1..42{let x=-6.+k as f32*0.29;let z=sign*(1.2+0.18*(x*1.4).sin());let at=ground(Vec2::new(x,z),plate,g.beat,0.018);line(scene,prev,at,0.035,if g.tune.clinical{srgb(56,78,115)}else{srgb(143,38,69)},15,0.);prev=at;}}\n    if plate==\"lung\" {for side in [-1.,1.]{for j in 0..5{let x=side*(1.6+j as f32*0.65);let p=ground(Vec2::new(x,-0.5),plate,g.beat,0.02);line(scene,p,p+Vec3::new(0.4*side,0.1,1.7),0.07,srgb(221,141,135),16,0.);}}}\n    if plate==\"femur\" {line(scene,ground(Vec2::new(0.,-3.),plate,g.beat,0.25),ground(Vec2::new(0.,3.),plate,g.beat,0.25),0.48,srgb(244,219,177),17,0.);}\n    for h in &g.hazards {hazard(scene,h,g);}\n    if g.heat_radius>=0.{ring(scene,Vec3::new(0.,2.1,0.),g.heat_radius,1.,srgb(255,157,69),60);}\n    // Steel tray and eight independently articulated instruments.\n    box_at(scene,Vec3::new(0.,0.2,5.8),Vec3::new(18.4,0.18,1.65),dark,Style::Lit,70);\n    for i in 0..8 {let p=Vec3::new(-7.4+i as f32*2.1,0.5,5.8);instrument(scene,i,p,0.,false,80+i as u32*10,0.7,g.case);}\n    for (i,s) in g.surgeons.iter().enumerate(){if !s.active{continue;}let p=ground(s.cursor,plate,g.beat,0.32);let col=[mint,srgb(104,163,255),srgb(125,240,139),srgb(176,208,255)][i];\n        ring(scene,p,0.30,1.,col,200+i as u32);\n        instrument(scene,s.tool,p+Vec3::new(0.25,0.2,0.05),s.charge,s.held&1!=0,240+i as u32*20,1.,g.case);\n        if s.charge>0.01 {ring(scene,p+Vec3::Y*0.12,0.53,s.charge.min(1.),if s.charge>1.1{srgb(255,99,89)}else{mint},202+i as u32);}\n    }\n    for cue in &g.cues {if cue.age<0.7 && (cue.kind==\"rating\"||cue.kind==\"gift\"||cue.kind==\"shock\"){\n        for i in 0..10{let a=i as f32*TAU/10.;let r=cue.age*1.4;let p=ground(cue.pos,plate,g.beat,0.2+cue.age*0.6)+Vec3::new(a.cos()*r,0.,a.sin()*r);sphere(scene,p,Vec3::splat(0.055*(1.-cue.age)),mint,Style::Unlit,400+i,0.7);}\n    }}\n}\nfn hazard(scene:&mut Scene,h:&Hazard,g:&Surgery){\n    let plate=g.stage().plate.as_str();let p=ground(h.pos,plate,g.beat,0.06);let q=ground(h.end,plate,g.beat,0.06);let id=500+h.id*12;\n    let mint=srgb(140,244,210);let blood=if g.tune.clinical{srgb(32,66,106)}else{srgb(99,13,34)};\n    if !h.alive{\n        if matches!(h.kind.as_str(),\"laceration\"|\"bleeder\"|\"bone\") {let d=q-p;for j in 0..7{let a=p+d*(j as f32/7.);line(scene,a+Vec3::new(0.,0.06,-0.18),a+Vec3::new(0.09,0.06,0.18),0.022,srgb(56,61,87),id,0.);}}\n        return;\n    }\n    if h.hidden && h.reveal<=0. {if h.kind==\"nodule\"{sphere(scene,p,Vec3::new(0.8,0.23,0.6),srgb(154,77,104),Style::Cel,id,0.);}return;}\n    match h.kind.as_str(){\n        \"incision\"|\"tether\"|\"soloist\"|\"dressing\"=>{\n            let color=if h.kind==\"soloist\"{srgb(254,211,117)}else{mint};let d=q-p;\n            for k in 0..20 {let t=k as f32/20.;if t<h.progress {line(scene,p+d*t,p+d*(t+0.035),0.06,blood,id,0.);}else{line(scene,p+d*t+Vec3::Y*0.035,p+d*(t+0.024)+Vec3::Y*0.035,0.022,color,id,0.3);}}\n            ring(scene,p+Vec3::Y*0.08,0.15,1.,color,id+1);\n        },\n        \"laceration\"|\"bleeder\"=>{\n            let d=q-p;for j in 0..20{let a=p+d*(j as f32/20.);let b=p+d*((j+1) as f32/20.);line(scene,a+Vec3::Y*((j as f32*2.).sin()*0.03),b,if h.kind==\"bleeder\"{0.10}else{0.065},blood,id,0.);}\n            let dir=(q-p).normalize_or_zero();for j in 0..h.count {let a=p+(q-p)*(j as f32/(h.count as f32+1.));line(scene,a+dir.cross(Vec3::Y)*0.2+Vec3::Y*0.07,a-dir.cross(Vec3::Y)*0.2+Vec3::Y*0.07,0.025,srgb(49,67,79),id+1,0.);}\n            let at=p+(q-p)*(h.progress+0.1).min(0.95);ring(scene,at+Vec3::Y*0.10,0.22,1.,mint,id+2);\n            if h.kind==\"bleeder\" {let t=g.time*4.;for j in 0..4{let a=t+j as f32;let rise=a.fract();sphere(scene,p+Vec3::new((a*2.).sin()*0.2,rise*0.8,0.),Vec3::splat(0.055),srgb(206,55,77),Style::Cel,id+3,0.);}}\n        },\n        \"hook\"|\"shard\"=>{\n            if h.kind==\"hook\"{for j in 0..9 {let a=j as f32*PI/8.;let b=(j+1) as f32*PI/8.;line(scene,p+Vec3::new(a.cos()*0.25,0.08,a.sin()*0.25),p+Vec3::new(b.cos()*0.25,0.08,b.sin()*0.25),0.06,srgb(191,204,204),id,0.);}line(scene,p+Vec3::new(-0.25,0.08,0.),p+Vec3::new(-0.25,0.1,-0.42),0.06,srgb(191,204,204),id,0.);}\n            else{box_at(scene,p+Vec3::Y*0.12,Vec3::new(0.24,0.3,0.7),srgb(173,201,207),Style::Lit,id);}\n            let d=(q-p).normalize_or_zero();line(scene,p+Vec3::Y*0.26,p+d*0.8+Vec3::Y*0.26,0.016,mint,id+1,0.4);line(scene,p+d*0.8+Vec3::Y*0.26,p+d*0.55+Vec3::X*0.15+Vec3::Y*0.26,0.016,mint,id+1,0.4);\n        },\n        \"polyp\"|\"tumor\"|\"nodule\"|\"sac\"|\"ember\"|\"tendril\"=>{\n            let strain=matches!(h.kind.as_str(),\"nodule\"|\"sac\"|\"ember\"|\"tendril\");let r=if h.kind==\"tumor\"{0.7}else{0.43};\n            let c=if h.kind==\"ember\"{if h.stage==0{srgb(210,68,44)}else{srgb(117,218,236)}}else if strain{srgb(68,35,101)}else{srgb(188,63,91)};\n            if h.kind==\"sac\"{line(scene,p,p+Vec3::Y*0.65,0.08,srgb(90,42,109),id,0.);sphere(scene,p+Vec3::Y*0.55,Vec3::new(0.65,0.85,0.65)*(1.+h.age/30.),srgb(155,235,181),Style::Cel,id+1,0.3);}\n            else {sphere(scene,p+Vec3::Y*0.12,Vec3::new(r*2.,r*0.9,r*1.65),c,Style::Cel,id,0.05);}\n            if strain {\n                sphere(scene,p+Vec3::new(0.,0.4,-0.03),Vec3::new(0.22,0.13,0.26),srgb(255,211,101),Style::Unlit,id+2,0.9);\n                for j in 0..5 {let a=j as f32*TAU/5.;let mut prev=p;for k in 1..5{let d=k as f32*0.22;let ang=a+(g.time*1.2+j as f32).sin()*0.15*d;let at=p+Vec3::new(ang.cos()*d,0.03+(g.time*2.+k as f32).sin()*0.04,ang.sin()*d);line(scene,prev,at,0.06*(1.-d*0.5),c,id+3,0.);prev=at;}}\n            }\n            if h.progress>0.{ring(scene,p+Vec3::Y*0.38,r+0.15,h.progress.min(1.),if h.progress>1.1{srgb(255,103,85)}else{mint},id+4);}\n            if h.kind==\"tumor\"&&h.stage==0 {ring(scene,p+Vec3::Y*0.12,0.65,1.,mint,id+5);}\n        },\n        \"pool\"=>{let r=(1.-h.progress).max(0.01).sqrt();sphere(scene,p+Vec3::Y*0.025,Vec3::new(2.3*r,0.06,1.9*r),blood,Style::Lit,id,0.);for i in 0..3{let a=i as f32*2.1;ring(scene,p+Vec3::new(a.sin()*0.4*r,0.06,a.cos()*0.4*r),0.1*r,1.,srgb(167,49,66),id+1);}},\n        \"burn\"|\"inflammation\"=>{sphere(scene,p,Vec3::new(1.2,0.08,1.),srgb(186,87,94).lerp(mint,h.progress),Style::Cel,id,0.);ring(scene,p+Vec3::Y*0.08,0.57,h.progress,mint,id+1);},\n        \"bone\"=>{if h.stage==0 {line(scene,q,q+Vec3::new(0.,0.,0.7),0.22,srgb(99,139,139),id,0.15);line(scene,p,p+Vec3::new(h.angle.sin()*0.9,0.2,h.angle.cos()*0.9),0.24,srgb(248,228,184),id+1,0.);}else {line(scene,p,q,0.24,srgb(248,228,184),id+1,0.);}},_=>{}\n    }\n}\nfn instrument(scene:&mut Scene,tool:u8,p:Vec3,charge:f32,held:bool,id:u32,scale:f32,case:usize){\n    let steel=srgb(192,217,220);let dark=srgb(57,85,96);let mint=srgb(123,235,198);let cyan=srgb(125,213,245);\n    let v=|x:f32,y:f32,z:f32|p+Vec3::new(x,y,z)*scale;\n    let squeeze=if held{0.055}else{0.14};\n    match tool{\n        0=>{line(scene,v(0.12,0.5,0.85),v(0.,0.15,0.05),0.07*scale,dark,id,0.);line(scene,v(0.,0.15,0.05),v(-0.12,0.,-0.35),0.045*scale,steel,id+1,0.);},\n        1=>{for side in [-1.,1.]{line(scene,v(0.,0.5,1.),v(side*0.16,0.25,0.4),0.045*scale,steel,id,0.);line(scene,v(side*0.16,0.25,0.4),v(side*squeeze,0.,-0.1),0.035*scale,steel,id,0.);}},\n        2=>{line(scene,v(0.16,0.5,0.8),v(0.,0.10,0.),0.045*scale,steel,id,0.);for i in 0..8{let a=i as f32*PI/8.;let b=(i+1) as f32*PI/8.;line(scene,v(a.cos()*0.17,0.06,a.sin()*0.17),v(b.cos()*0.17,0.06,b.sin()*0.17),0.015*scale,steel,id+1,0.);}line(scene,v(-0.17,0.05,0.),v(-0.4,0.02,0.5),0.015*scale,srgb(68,94,119),id+2,0.);},\n        3=>{line(scene,v(0.3,0.65,0.9),v(0.12,0.3,0.35),0.12*scale,dark,id,0.);line(scene,v(0.12,0.3,0.35),v(0.,0.,0.),0.06*scale,steel,id+1,0.);if held{ring(scene,v(0.,0.02,0.),0.2*scale,1.,cyan,id+2);}},\n        4|6=>{let frost=tool==6&&case==7 || tool==4&&case==6;let col=if frost{cyan}else if tool==6{mint}else{srgb(255,127,103)};\n            line(scene,v(0.1,0.6,0.85),v(0.,0.15,0.1),0.10*scale,dark,id,0.);line(scene,v(0.,0.15,0.1),v(0.,0.05,-0.25),0.035*scale,steel,id+1,0.);line(scene,v(0.1,0.56,0.75),v(0.04,0.3,0.3),0.05*scale,col,id+2,0.5);\n            if held {line(scene,v(0.,0.05,-0.25),v(0.,-0.08,-0.35),0.025*scale,col,id+3,1.);ring(scene,v(0.,-0.07,-0.35),0.18*scale,1.,col,id+4);}\n        },\n        5=>{sphere(scene,v(0.1,0.5,0.6),Vec3::new(0.32,0.24,0.65)*scale,mint,Style::Lit,id,0.);line(scene,v(0.1,0.35,0.35),v(0.,0.,0.),0.055*scale,steel,id+1,0.);if held{sphere(scene,v(0.,-0.03,-0.05),Vec3::new(0.26,0.04,0.22)*scale,mint,Style::Lit,id+2,0.3);}},\n        7=>{line(scene,v(0.,0.3,0.8-charge*0.2),v(0.,0.2,0.1),0.12*scale,steel,id,0.);line(scene,v(0.,0.2,0.1),v(0.,0.,-0.35),0.018*scale,steel,id+1,0.);line(scene,v(0.,0.3,0.6),v(0.,0.2,0.18),0.07*scale,mint,id+2,0.);},\n        _=>{box_at(scene,v(0.,0.1,0.),Vec3::new(0.9,0.16,0.65)*scale,srgb(241,229,198),Style::Cel,id);}\n    }\n}\n\n// Paper theatre. Chaikin silhouettes are triangulated as convex fans; concave hair is split into locks.\nfn card(scene:&mut Scene,points:&[Vec2],z:f32,color:Vec3,transform:Mat4,id:u32,rounds:u8){\n    let mut pts=points.to_vec();for _ in 0..rounds{let mut out=vec![];for i in 0..pts.len(){let a=pts[i];let b=pts[(i+1)%pts.len()];out.push(a.lerp(b,0.25));out.push(a.lerp(b,0.75));}pts=out;}\n    let area=(0..pts.len()).map(|i|pts[i].perp_dot(pts[(i+1)%pts.len()])).sum::<f32>();if area<0.{pts.reverse();}\n    let mut data=MeshData::default();for a in &pts{let v=transform.transform_point3(Vec3::new(a.x,a.y,z));data.vertices.push(Vertex{pos:v.to_array(),normal:transform.transform_vector3(Vec3::Z).to_array(),uv:[0.,0.],color:[1.;4]});}\n    // Ear clipping allows the same card format to hold brows, V-necks and hair.\n    let mut remaining:Vec<usize>=(0..pts.len()).collect();let mut guard=0;\n    while remaining.len()>2 && guard<pts.len()*pts.len(){guard+=1;let mut cut=false;for j in 0..remaining.len(){let a=remaining[(j+remaining.len()-1)%remaining.len()];let b=remaining[j];let c=remaining[(j+1)%remaining.len()];if (pts[b]-pts[a]).perp_dot(pts[c]-pts[b])<=0.{continue;}\n        let inside=remaining.iter().any(|&i|i!=a&&i!=b&&i!=c&&(pts[b]-pts[a]).perp_dot(pts[i]-pts[a])>=0.&&(pts[c]-pts[b]).perp_dot(pts[i]-pts[b])>=0.&&(pts[a]-pts[c]).perp_dot(pts[i]-pts[c])>=0.);\n        if inside{continue;}data.indices.extend([a as u32,b as u32,c as u32]);remaining.remove(j);cut=true;break;\n    }if !cut{break;}}\n    for i in 0..pts.len(){let a=pts[i];let b=pts[(i+1)%pts.len()];let normal=Vec3::new(b.y-a.y,a.x-b.x,0.).normalize_or_zero();data.push_quad([transform.transform_point3(a.extend(z)),transform.transform_point3(a.extend(z-0.055)),transform.transform_point3(b.extend(z-0.055)),transform.transform_point3(b.extend(z))],transform.transform_vector3(normal));}\n    scene.dynamic.push(DynamicMesh{data,color,emissive:0.,style:Style::Cel,flags:0,group:id,material:0});\n}\nfn oval(scene:&mut Scene,c:Vec2,r:Vec2,z:f32,color:Vec3,m:Mat4,id:u32){let pts:Vec<Vec2>=(0..30).map(|i|{let a=i as f32*TAU/30.;c+Vec2::new(a.cos(),a.sin())*r}).collect();card(scene,&pts,z,color,m,id,0);}\npub fn theatre(scene:&mut Scene,left:&str,right:&str,speaker:&str,expr:&str,time:f32,set:&str){\n    scene.meshes.clear();scene.sdfs.clear();scene.dynamic.clear();scene.texts.clear();scene.point_lights.clear();\n    scene.camera=CameraData{view:glam::camera::rh::view::look_to_mat4(Vec3::new(0.,0.,17.),Vec3::NEG_Z,Vec3::Y),proj:glam::camera::rh::proj::directx::perspective(26f32.to_radians(),16./9.,0.1,100.),eye:Vec3::new(0.,0.,17.),forward:Vec3::NEG_Z,ortho:false};\n    scene.clear_color=srgb(11,29,35);scene.ambient=Ambient{sky:Vec3::splat(0.72),ground:Vec3::splat(0.55)};scene.sun.direction=Vec3::new(0.3,-0.45,-0.85).normalize();scene.sun.color=Vec3::splat(0.34);scene.post.outline_px=1.5;scene.post.outline_darken=0.32;scene.filter.vignette=0.32;\n    // Eight sets share architectural pieces, with their own lighting and window compositions.\n    let warm=set==\"gala\"||set==\"ship\";let base=if warm{srgb(59,45,45)}else{srgb(22,57,65)};\n    box_at(scene,Vec3::new(0.,0.,-1.),Vec3::new(20.,12.,0.15),base,Style::Cel,801);\n    for i in -4..=4 {box_at(scene,Vec3::new(i as f32*2.5,0.,-0.6),Vec3::new(0.12,12.,0.3),srgb(13,33,43),Style::Cel,802);}\n    for i in -2..=2 {box_at(scene,Vec3::new(0.,i as f32*2.,-0.7),Vec3::new(20.,0.1,0.2),srgb(46,78,81),Style::Cel,803);}\n    if warm {for i in -4..=4{sphere(scene,Vec3::new(i as f32*2.,2.5,-0.3),Vec3::splat(0.12),srgb(255,199,129),Style::Unlit,804,1.);}}\n    else {for i in 0..36 {let x=(i as f32*2.73).sin()*9.;let y=4.-(time*2.4+i as f32*0.91).rem_euclid(9.);line(scene,Vec3::new(x,y,-0.4),Vec3::new(x-0.08,y-0.45,-0.4),0.009,srgb(90,154,175),810,0.15);}}\n    for (i,name) in [left,right].iter().enumerate(){if name.is_empty(){continue;}let x=if i==0{-3.15}else{3.15};let active=*name==speaker;let yaw=if i==0{0.13}else{-0.13};let lift=if active{0.02*(time*2.).sin()}else{0.};let m=Mat4::from_scale_rotation_translation(Vec3::splat(1.55),Quat::from_rotation_y(yaw),Vec3::new(x,-0.4+lift,0.));actor(scene,name,expr,active,time,m,900+i as u32*60);}\n}\nfn actor(scene:&mut Scene,name:&str,expr:&str,talking:bool,t:f32,m:Mat4,id:u32){\n    let (skin,shade,hair,scrub)=match name{\n        \"Pet\"=>(srgb(122,80,58),srgb(107,68,53),srgb(226,226,232),srgb(98,70,136)),\n        \"Bashir\"=>(srgb(190,142,104),srgb(167,118,89),srgb(42,37,43),srgb(60,104,164)),\n        \"Teddy\"=>(srgb(229,181,151),srgb(205,155,132),srgb(127,79,49),srgb(53,116,136)),\n        \"Voss\"=>(srgb(225,191,174),srgb(198,163,152),srgb(182,179,180),srgb(52,70,86)),\n        \"Vane\"=>(srgb(237,196,168),srgb(218,169,143),srgb(155,96,50),srgb(221,196,152)),\n        _=>(srgb(242,200,172),srgb(226,178,153),srgb(46,36,60),srgb(46,150,146)),\n    };\n    let cv=|p:&[[f32;2]]|p.iter().map(|v|Vec2::from_array(*v)).collect::<Vec<_>>();\n    oval(scene,Vec2::new(0.,0.6),Vec2::new(0.89,1.03),0.,hair,m,id);\n    card(scene,&cv(&[[-1.72,-2.5],[-1.66,-1.36],[-1.2,-1.02],[-0.52,-0.82],[-0.3,-0.72],[0.,-1.34],[0.3,-0.72],[0.52,-0.82],[1.2,-1.02],[1.66,-1.36],[1.72,-2.5]]),0.035,scrub,m,id+1,2);\n    card(scene,&cv(&[[-0.3,-0.8],[-0.28,-0.24],[0.28,-0.24],[0.3,-0.8],[0.,-1.2]]),0.055,skin,m,id+2,2);\n    card(scene,&cv(&[[-0.76,0.76],[-0.74,0.28],[-0.56,-0.16],[-0.26,-0.5],[0.,-0.6],[0.26,-0.5],[0.56,-0.16],[0.74,0.28],[0.76,0.76],[0.52,1.22],[0.,1.32],[-0.52,1.22]]),0.105,skin,m,id+3,3);\n    oval(scene,Vec2::new(0.52,-0.03),Vec2::new(0.12,0.19),0.112,shade,m,id+3);\n    let blink=(t*0.7).sin()>0.994;let alarm=expr==\"alarmed\";let stern=expr==\"stern\";\n    for side in [-1.,1.] {\n        let eye=Vec2::new(side*0.34,0.34);let open=if blink{0.015}else if alarm{0.11}else{0.075};\n        oval(scene,eye,Vec2::new(0.19,open),0.13,srgb(255,247,222),m,id+4);\n        if !blink{oval(scene,eye+Vec2::new(-side*0.02,0.),Vec2::new(0.06,0.07),0.14,srgb(70,85,86),m,id+5);oval(scene,eye,Vec2::splat(0.03),0.145,srgb(26,28,39),m,id+6);oval(scene,eye+Vec2::new(-0.025,0.025),Vec2::splat(0.015),0.15,srgb(255,250,231),m,id+7);}\n        let by=if alarm{0.62}else{0.53};card(scene,&cv(&[[side*0.17,by+if stern{-0.03}else{0.}], [side*0.55,by+if stern{0.08}else{0.01}],[side*0.55,by+0.065],[side*0.17,by+0.055]]),0.155,hair,m,id+8,1);\n    }\n    card(scene,&cv(&[[-0.03,0.27],[0.055,-0.01],[-0.065,-0.025]]),0.14,shade,m,id+9,1);\n    let mouth=if talking&&(t*15.).sin()>0.{cv(&[[-0.15,-0.255],[0.,-0.20],[0.15,-0.255],[0.08,-0.36],[-0.08,-0.36]])}else{cv(&[[-0.16,-0.26],[0.,-0.235],[0.16,-0.26],[0.,-0.285]])};card(scene,&mouth,0.15,srgb(117,59,65),m,id+10,1);\n    card(scene,&cv(&[[-0.86,0.38],[-0.9,1.1],[-0.42,1.62],[0.26,1.68],[0.8,1.36],[0.92,0.8],[0.84,0.3],[0.68,0.74],[0.36,1.02],[-0.16,0.98],[-0.42,0.72],[-0.68,0.56]]),0.175,hair,m,id+11,3);\n    if name==\"Pet\" {oval(scene,Vec2::new(-0.62,1.29),Vec2::new(0.34,0.3),0.01,hair,m,id+12);}\n    if name==\"Bashir\"||name==\"Teddy\"{card(scene,&cv(&[[-0.8,0.9],[-0.8,1.45],[0.8,1.45],[0.8,0.9]]),0.19,scrub,m,id+13,2);}\n    card(scene,&cv(&[[-0.46,-0.89],[-0.15,-1.4],[-0.28,-1.5],[-0.65,-1.03]]),0.09,scrub*0.7,m,id+14,0);\n    card(scene,&cv(&[[0.46,-0.89],[0.15,-1.4],[0.28,-1.5],[0.65,-1.03]]),0.09,scrub*0.7,m,id+14,0);\n    card(scene,&cv(&[[0.55,-1.45],[0.92,-1.45],[0.92,-1.72],[0.55,-1.72]]),0.09,srgb(230,231,216),m,id+15,0);\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\nr=Path(Path('.game-path').read_text())/'engine'\np=r/'crates/pav_view/src/lib.rs';p.write_text(p.read_text()+'\\\\npub mod surgery;\\\\n')\np=r/'crates/pav_view/src/build.rs';s=p.read_text().replace('        lock(&self.materials).attach(&mut scene);','        if let Some(g) = &curr.surgery { crate::surgery::emit(&mut scene, g); }\\\\n        lock(&self.materials).attach(&mut scene);');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); cat > \"$d/engine/crates/pav_view/src/surgery.rs\" <<'\"'EOF'\n//\"'! Original procedural medical illustrations, steel instruments and extruded paper actors.\nuse glam::{Mat4,Quat,Vec2,Vec3};\nuse pav_core::games::surgery::{Surgery,Hazard};\nuse pav_render::scene::*;\nuse pav_render::mesh::{MeshData,Vertex};\nuse crate::{CameraParams,CameraRig};\nuse std::f32::consts::{PI,TAU};\n\npub fn camera()->CameraRig{CameraRig::new(CameraParams{tilt:73.,yaw:0.,distance:22.0,fov:36.,follow_lag:0.,height_offset:0.,ortho:false})}\npub fn height(x:f32,z:f32,plate:&str,beat:f32)->f32{\n    let e=x*x/77.+z*z/16.;\n    if e>1. {return 0.24+0.05*(x*3.+z*2.).sin();}\n    let pulse=(beat*TAU).cos().max(0.).powi(6);\n    let dome=(1.-e).max(0.).powf(0.55);\n    let lobes=match plate{\n        \"heart\"|\"pericardium\"=>{let a=((x+0.9).powi(2)/14.+z*z/8.).min(((x-2.).powi(2)/7.)+(z+0.5).powi(2)/5.);(1.-a).max(0.).powf(0.65)*0.85},\n        \"lung\"=>{let a=((x.abs()-2.6).powi(2)/9.+z*z/10.).min(1.);(1.-a).max(0.)*0.5},\n        \"liver\"=>(1.-((x+1.).powi(2)/38.+(z+0.2).powi(2)/9.)).max(0.).powf(0.55)*0.45,\n        \"forearm\"=>0.20*(1.-z*z/8.).max(0.),_=>0.12*(x*1.8+z*0.5).cos(),\n    };\n    0.38+dome*0.55+lobes+0.025*((x*4.+z*1.7).sin()+(z*6.-x).sin())+pulse*if plate==\"heart\"{0.15*dome}else{0.035*dome}\n}\nfn color_plate(x:f32,z:f32,y:f32,plate:&str,clinical:bool)->Vec3{\n    let e=x*x/77.+z*z/16.;\n    if e>1. {\n        let fold=((x*0.8+z*1.7).sin()*0.5+0.5)*0.10;\n        return srgb(28,105,108)*(0.75+fold)+srgb(30,61,67)*((x*9.).sin()*(z*9.).cos()*0.04);\n    }\n    let mut c=if clinical{srgb(84,118,134).lerp(srgb(171,196,196),(y/1.7).clamp(0.,1.))}else{\n        let (dark,light)=match plate{\n            \"liver\"=>(srgb(103,36,48),srgb(224,103,93)),\n            \"heart\"|\"pericardium\"=>(srgb(104,33,55),srgb(237,107,111)),\n            \"lung\"=>(srgb(155,61,80),srgb(249,158,150)),\n            \"femur\"=>(srgb(147,67,69),srgb(236,153,126)),_ =>(srgb(163,60,65),srgb(248,157,132)),\n        };dark.lerp(light,((y-0.35)/1.25).clamp(0.,1.))\n    };\n    let grain=(x*31.+z*17.).sin()*(x*7.-z*23.).cos();c*=0.96+0.04*grain;\n    if e>0.89 {c*=0.56+(1.-e)*2.;}\n    let vein=(z*1.8+(x*0.8).sin()*0.65).sin().abs();\n    if vein<0.035 && e<0.8 {c=c.lerp(if clinical{srgb(56,77,100)}else{srgb(130,40,64)},0.65);}\n    let shine=(x*0.7+z*1.4+(x*0.6).sin()).sin();\n    if shine>0.96 && y>0.7 {c=c.lerp(srgb(255,218,191),0.26);}\n    c\n}\nfn box_at(scene:&mut Scene,p:Vec3,size:Vec3,color:Vec3,style:Style,group:u32){\n    scene.meshes.push(MeshInstance{mesh:MeshKey::Cube,transform:Mat4::from_scale_rotation_translation(size,Quat::IDENTITY,p),color,emissive:0.,style,flags:0,group,material:0,ext:Vec3::ZERO});\n}\nfn sphere(scene:&mut Scene,p:Vec3,size:Vec3,color:Vec3,style:Style,group:u32,emissive:f32){\n    scene.meshes.push(MeshInstance{mesh:MeshKey::Sphere,transform:Mat4::from_scale_rotation_translation(size,Quat::IDENTITY,p),color,emissive,style,flags:0,group,material:0,ext:Vec3::ZERO});\n}\nfn line(scene:&mut Scene,a:Vec3,b:Vec3,r:f32,c:Vec3,group:u32,glow:f32){let mut v=SdfInstance::capsule(a,b,r,c);v.group=group;v.style=if glow>0.{Style::Unlit}else{Style::Lit};v.emissive=glow;scene.sdfs.push(v);}\nfn ring(scene:&mut Scene,p:Vec3,r:f32,progress:f32,c:Vec3,group:u32){for i in 0..48{let t=i as f32/48.;if t>progress{continue;}let a=t*TAU;let b=(t+1./48.)*TAU;line(scene,p+Vec3::new(a.cos()*r,0.,a.sin()*r),p+Vec3::new(b.cos()*r,0.,b.sin()*r),0.018,c,group,0.45);}}\nfn ground(p:Vec2,plate:&str,beat:f32,offset:f32)->Vec3{Vec3::new(p.x,height(p.x,p.y,plate,beat)+offset,p.y)}\n\npub fn emit(scene:&mut Scene,g:&Surgery){\n    scene.meshes.clear();scene.sdfs.clear();scene.dynamic.clear();scene.texts.clear();\n    scene.clear_color=srgb(9,27,31);scene.sun.direction=Vec3::new(-0.25,-1.,-0.35).normalize();scene.sun.color=Vec3::new(1.,0.95,0.88)*0.42;scene.sun.shadow_radius=18.;\n    scene.ambient=Ambient{sky:Vec3::splat(0.5),ground:Vec3::new(0.3,0.22,0.22)};\n    scene.style.cel_bands=3.;scene.style.rim=0.12;scene.style.specular=0.7;\n    scene.post.outline_px=1.25;scene.post.outline_darken=0.4;scene.post.bloom=0.27;scene.post.bloom_threshold=1.15;scene.post.gi=0.55;\n    scene.filter.vignette=0.35;scene.filter.grain=0.035;\n    if g.gift_left>0. && g.gift_kind!=\"Echo\"{scene.filter.saturation=0.3;scene.filter.chroma=0.9;}\n    scene.point_lights.push(PointLight{position:Vec3::new(-1.,7.,-1.),color:Vec3::new(1.,0.97,0.90)*0.9,radius:17.,shadows:true});\n    let plate=g.stage().plate.as_str();\n    // The drape and organ are a single finely tessellated, vertex-painted living surface.\n    let (nx,nz)=(180,104);let mut mesh=MeshData::default();\n    for iz in 0..=nz {for ix in 0..=nx {\n        let x=-13.+26.*ix as f32/nx as f32;let z=-7.+14.*iz as f32/nz as f32;\n        let y=height(x,z,plate,g.beat);let eps=0.035;\n        let n=Vec3::new(height(x-eps,z,plate,g.beat)-height(x+eps,z,plate,g.beat),eps*2.,height(x,z-eps,plate,g.beat)-height(x,z+eps,plate,g.beat)).normalize();\n        let mut col=color_plate(x,z,y,plate,g.tune.clinical);\n        for h in &g.hazards{if !h.alive{continue;}let dist=Vec2::new(x,z).distance(h.pos);if h.kind==\"pool\" && dist<1.3*(1.-h.progress).max(0.05).sqrt()*(1.+0.08*(x*13.+z*9.).sin()) {col=col.lerp(if g.tune.clinical{srgb(34,59,91)}else{srgb(118,10,28)},0.95);}if h.kind==\"burn\" && dist<0.65{col=col.lerp(srgb(119,60,63),0.65);}}\n        debug_assert!(y.is_finite()&&n.is_finite()&&col.is_finite());\n        mesh.vertices.push(Vertex{pos:[x,y,z],normal:n.to_array(),uv:[ix as f32/nx as f32,iz as f32/nz as f32],color:[col.x,col.y,col.z,1.]});\n    }}\n    for iz in 0..nz {for ix in 0..nx{let a=(iz*(nx+1)+ix) as u32;let b=a+(nx+1) as u32;mesh.indices.extend([a,b,a+1,a+1,b,b+1]);}}\n    scene.dynamic.push(DynamicMesh{data:mesh,color:Vec3::ONE,emissive:0.,style:Style::Cel,flags:0,group:5,material:0});\n    let steel=srgb(168,197,200);let dark=srgb(44,67,75);let mint=srgb(140,244,210);\n    // Drape stitching, towel clamps, and shadow-casting retractors.\n    for side in [-1.,1.] {for i in 0..42{let x=-10.+i as f32*0.49;line(scene,Vec3::new(x,0.39,side*5.),Vec3::new(x+0.22,0.39,side*5.),0.009,srgb(72,151,151),10,0.);}\n        for x in [-7.,0.,7.] {let z=side*3.65;let p=Vec3::new(x,0.6,z);box_at(scene,p,Vec3::new(0.6,0.2,1.),steel,Style::Lit,11);line(scene,p+Vec3::Y*0.1,p+Vec3::new(0.,0.4,side*1.5),0.08,steel,12,0.);ring(scene,p+Vec3::new(0.,0.4,side*1.7),0.22,1.,steel,12);}}\n    // Painted vessels and organ-specific structures stay underneath the tasks.\n    for sign in [-1.,1.] {let mut prev=ground(Vec2::new(-6.,sign*1.2),plate,g.beat,0.018);for k in 1..42{let x=-6.+k as f32*0.29;let z=sign*(1.2+0.18*(x*1.4).sin());let at=ground(Vec2::new(x,z),plate,g.beat,0.018);line(scene,prev,at,0.035,if g.tune.clinical{srgb(56,78,115)}else{srgb(143,38,69)},15,0.);prev=at;}}\n    if plate==\"lung\" {for side in [-1.,1.]{for j in 0..5{let x=side*(1.6+j as f32*0.65);let p=ground(Vec2::new(x,-0.5),plate,g.beat,0.02);line(scene,p,p+Vec3::new(0.4*side,0.1,1.7),0.07,srgb(221,141,135),16,0.);}}}\n    if plate==\"femur\" {line(scene,ground(Vec2::new(0.,-3.),plate,g.beat,0.25),ground(Vec2::new(0.,3.),plate,g.beat,0.25),0.48,srgb(244,219,177),17,0.);}\n    for h in &g.hazards {hazard(scene,h,g);}\n    if g.heat_radius>=0.{ring(scene,Vec3::new(0.,2.1,0.),g.heat_radius,1.,srgb(255,157,69),60);}\n    // Steel tray and eight independently articulated instruments.\n    box_at(scene,Vec3::new(0.,0.2,5.8),Vec3::new(18.4,0.18,1.65),dark,Style::Lit,70);\n    for i in 0..8 {let p=Vec3::new(-7.4+i as f32*2.1,0.5,5.8);instrument(scene,i,p,0.,false,80+i as u32*10,0.7,g.case);}\n    for (i,s) in g.surgeons.iter().enumerate(){if !s.active{continue;}let p=ground(s.cursor,plate,g.beat,0.32);let col=[mint,srgb(104,163,255),srgb(125,240,139),srgb(176,208,255)][i];\n        ring(scene,p,0.30,1.,col,200+i as u32);\n        instrument(scene,s.tool,p+Vec3::new(0.25,0.2,0.05),s.charge,s.held&1!=0,240+i as u32*20,1.,g.case);\n        if s.charge>0.01 {ring(scene,p+Vec3::Y*0.12,0.53,s.charge.min(1.),if s.charge>1.1{srgb(255,99,89)}else{mint},202+i as u32);}\n    }\n    for cue in &g.cues {if cue.age<0.7 && (cue.kind==\"rating\"||cue.kind==\"gift\"||cue.kind==\"shock\"){\n        for i in 0..10{let a=i as f32*TAU/10.;let r=cue.age*1.4;let p=ground(cue.pos,plate,g.beat,0.2+cue.age*0.6)+Vec3::new(a.cos()*r,0.,a.sin()*r);sphere(scene,p,Vec3::splat(0.055*(1.-cue.age)),mint,Style::Unlit,400+i,0.7);}\n    }}\n}\nfn hazard(scene:&mut Scene,h:&Hazard,g:&Surgery){\n    let plate=g.stage().plate.as_str();let p=ground(h.pos,plate,g.beat,0.06);let q=ground(h.end,plate,g.beat,0.06);let id=500+h.id*12;\n    let mint=srgb(140,244,210);let blood=if g.tune.clinical{srgb(32,66,106)}else{srgb(99,13,34)};\n    if !h.alive{\n        if matches!(h.kind.as_str(),\"laceration\"|\"bleeder\"|\"bone\") {let d=q-p;for j in 0..7{let a=p+d*(j as f32/7.);line(scene,a+Vec3::new(0.,0.06,-0.18),a+Vec3::new(0.09,0.06,0.18),0.022,srgb(56,61,87),id,0.);}}\n        return;\n    }\n    if h.hidden && h.reveal<=0. {if h.kind==\"nodule\"{sphere(scene,p,Vec3::new(0.8,0.23,0.6),srgb(154,77,104),Style::Cel,id,0.);}return;}\n    match h.kind.as_str(){\n        \"incision\"|\"tether\"|\"soloist\"|\"dressing\"=>{\n            let color=if h.kind==\"soloist\"{srgb(254,211,117)}else{mint};let d=q-p;\n            for k in 0..20 {let t=k as f32/20.;if t<h.progress {line(scene,p+d*t,p+d*(t+0.035),0.06,blood,id,0.);}else{line(scene,p+d*t+Vec3::Y*0.035,p+d*(t+0.024)+Vec3::Y*0.035,0.022,color,id,0.3);}}\n            ring(scene,p+Vec3::Y*0.08,0.15,1.,color,id+1);\n        },\n        \"laceration\"|\"bleeder\"=>{\n            let d=q-p;for j in 0..20{let a=p+d*(j as f32/20.);let b=p+d*((j+1) as f32/20.);line(scene,a+Vec3::Y*((j as f32*2.).sin()*0.03),b,if h.kind==\"bleeder\"{0.10}else{0.065},blood,id,0.);}\n            let dir=(q-p).normalize_or_zero();for j in 0..h.count {let a=p+(q-p)*(j as f32/(h.count as f32+1.));line(scene,a+dir.cross(Vec3::Y)*0.2+Vec3::Y*0.07,a-dir.cross(Vec3::Y)*0.2+Vec3::Y*0.07,0.025,srgb(49,67,79),id+1,0.);}\n            let at=p+(q-p)*(h.progress+0.1).min(0.95);ring(scene,at+Vec3::Y*0.10,0.22,1.,mint,id+2);\n            if h.kind==\"bleeder\" {let t=g.time*4.;for j in 0..4{let a=t+j as f32;let rise=a.fract();sphere(scene,p+Vec3::new((a*2.).sin()*0.2,rise*0.8,0.),Vec3::splat(0.055),srgb(206,55,77),Style::Cel,id+3,0.);}}\n        },\n        \"hook\"|\"shard\"=>{\n            if h.kind==\"hook\"{for j in 0..9 {let a=j as f32*PI/8.;let b=(j+1) as f32*PI/8.;line(scene,p+Vec3::new(a.cos()*0.25,0.08,a.sin()*0.25),p+Vec3::new(b.cos()*0.25,0.08,b.sin()*0.25),0.06,srgb(191,204,204),id,0.);}line(scene,p+Vec3::new(-0.25,0.08,0.),p+Vec3::new(-0.25,0.1,-0.42),0.06,srgb(191,204,204),id,0.);}\n            else{box_at(scene,p+Vec3::Y*0.12,Vec3::new(0.24,0.3,0.7),srgb(173,201,207),Style::Lit,id);}\n            let d=(q-p).normalize_or_zero();line(scene,p+Vec3::Y*0.26,p+d*0.8+Vec3::Y*0.26,0.016,mint,id+1,0.4);line(scene,p+d*0.8+Vec3::Y*0.26,p+d*0.55+Vec3::X*0.15+Vec3::Y*0.26,0.016,mint,id+1,0.4);\n        },\n        \"polyp\"|\"tumor\"|\"nodule\"|\"sac\"|\"ember\"|\"tendril\"=>{\n            let strain=matches!(h.kind.as_str(),\"nodule\"|\"sac\"|\"ember\"|\"tendril\");let r=if h.kind==\"tumor\"{0.7}else{0.43};\n            let c=if h.kind==\"ember\"{if h.stage==0{srgb(210,68,44)}else{srgb(117,218,236)}}else if strain{srgb(68,35,101)}else{srgb(188,63,91)};\n            if h.kind==\"sac\"{line(scene,p,p+Vec3::Y*0.65,0.08,srgb(90,42,109),id,0.);sphere(scene,p+Vec3::Y*0.55,Vec3::new(0.65,0.85,0.65)*(1.+h.age/30.),srgb(155,235,181),Style::Cel,id+1,0.3);}\n            else {sphere(scene,p+Vec3::Y*0.12,Vec3::new(r*2.,r*0.9,r*1.65),c,Style::Cel,id,0.05);}\n            if strain {\n                sphere(scene,p+Vec3::new(0.,0.4,-0.03),Vec3::new(0.22,0.13,0.26),srgb(255,211,101),Style::Unlit,id+2,0.9);\n                for j in 0..5 {let a=j as f32*TAU/5.;let mut prev=p;for k in 1..5{let d=k as f32*0.22;let ang=a+(g.time*1.2+j as f32).sin()*0.15*d;let at=p+Vec3::new(ang.cos()*d,0.03+(g.time*2.+k as f32).sin()*0.04,ang.sin()*d);line(scene,prev,at,0.06*(1.-d*0.5),c,id+3,0.);prev=at;}}\n            }\n            if h.progress>0.{ring(scene,p+Vec3::Y*0.38,r+0.15,h.progress.min(1.),if h.progress>1.1{srgb(255,103,85)}else{mint},id+4);}\n            if h.kind==\"tumor\"&&h.stage==0 {ring(scene,p+Vec3::Y*0.12,0.65,1.,mint,id+5);}\n        },\n        \"pool\"=>{let r=(1.-h.progress).max(0.01).sqrt();sphere(scene,p+Vec3::Y*0.025,Vec3::new(2.3*r,0.06,1.9*r),blood,Style::Lit,id,0.);for i in 0..3{let a=i as f32*2.1;ring(scene,p+Vec3::new(a.sin()*0.4*r,0.06,a.cos()*0.4*r),0.1*r,1.,srgb(167,49,66),id+1);}},\n        \"burn\"|\"inflammation\"=>{sphere(scene,p,Vec3::new(1.2,0.08,1.),srgb(186,87,94).lerp(mint,h.progress),Style::Cel,id,0.);ring(scene,p+Vec3::Y*0.08,0.57,h.progress,mint,id+1);},\n        \"bone\"=>{if h.stage==0 {line(scene,q,q+Vec3::new(0.,0.,0.7),0.22,srgb(99,139,139),id,0.15);line(scene,p,p+Vec3::new(h.angle.sin()*0.9,0.2,h.angle.cos()*0.9),0.24,srgb(248,228,184),id+1,0.);}else {line(scene,p,q,0.24,srgb(248,228,184),id+1,0.);}},_=>{}\n    }\n}\nfn instrument(scene:&mut Scene,tool:u8,p:Vec3,charge:f32,held:bool,id:u32,scale:f32,case:usize){\n    let steel=srgb(192,217,220);let dark=srgb(57,85,96);let mint=srgb(123,235,198);let cyan=srgb(125,213,245);\n    let v=|x:f32,y:f32,z:f32|p+Vec3::new(x,y,z)*scale;\n    let squeeze=if held{0.055}else{0.14};\n    match tool{\n        0=>{line(scene,v(0.12,0.5,0.85),v(0.,0.15,0.05),0.07*scale,dark,id,0.);line(scene,v(0.,0.15,0.05),v(-0.12,0.,-0.35),0.045*scale,steel,id+1,0.);},\n        1=>{for side in [-1.,1.]{line(scene,v(0.,0.5,1.),v(side*0.16,0.25,0.4),0.045*scale,steel,id,0.);line(scene,v(side*0.16,0.25,0.4),v(side*squeeze,0.,-0.1),0.035*scale,steel,id,0.);}},\n        2=>{line(scene,v(0.16,0.5,0.8),v(0.,0.10,0.),0.045*scale,steel,id,0.);for i in 0..8{let a=i as f32*PI/8.;let b=(i+1) as f32*PI/8.;line(scene,v(a.cos()*0.17,0.06,a.sin()*0.17),v(b.cos()*0.17,0.06,b.sin()*0.17),0.015*scale,steel,id+1,0.);}line(scene,v(-0.17,0.05,0.),v(-0.4,0.02,0.5),0.015*scale,srgb(68,94,119),id+2,0.);},\n        3=>{line(scene,v(0.3,0.65,0.9),v(0.12,0.3,0.35),0.12*scale,dark,id,0.);line(scene,v(0.12,0.3,0.35),v(0.,0.,0.),0.06*scale,steel,id+1,0.);if held{ring(scene,v(0.,0.02,0.),0.2*scale,1.,cyan,id+2);}},\n        4|6=>{let frost=tool==6&&case==7 || tool==4&&case==6;let col=if frost{cyan}else if tool==6{mint}else{srgb(255,127,103)};\n            line(scene,v(0.1,0.6,0.85),v(0.,0.15,0.1),0.10*scale,dark,id,0.);line(scene,v(0.,0.15,0.1),v(0.,0.05,-0.25),0.035*scale,steel,id+1,0.);line(scene,v(0.1,0.56,0.75),v(0.04,0.3,0.3),0.05*scale,col,id+2,0.5);\n            if held {line(scene,v(0.,0.05,-0.25),v(0.,-0.08,-0.35),0.025*scale,col,id+3,1.);ring(scene,v(0.,-0.07,-0.35),0.18*scale,1.,col,id+4);}\n        },\n        5=>{sphere(scene,v(0.1,0.5,0.6),Vec3::new(0.32,0.24,0.65)*scale,mint,Style::Lit,id,0.);line(scene,v(0.1,0.35,0.35),v(0.,0.,0.),0.055*scale,steel,id+1,0.);if held{sphere(scene,v(0.,-0.03,-0.05),Vec3::new(0.26,0.04,0.22)*scale,mint,Style::Lit,id+2,0.3);}},\n        7=>{line(scene,v(0.,0.3,0.8-charge*0.2),v(0.,0.2,0.1),0.12*scale,steel,id,0.);line(scene,v(0.,0.2,0.1),v(0.,0.,-0.35),0.018*scale,steel,id+1,0.);line(scene,v(0.,0.3,0.6),v(0.,0.2,0.18),0.07*scale,mint,id+2,0.);},\n        _=>{box_at(scene,v(0.,0.1,0.),Vec3::new(0.9,0.16,0.65)*scale,srgb(241,229,198),Style::Cel,id);}\n    }\n}\n\n// Paper theatre. Chaikin silhouettes are triangulated as convex fans; concave hair is split into locks.\nfn card(scene:&mut Scene,points:&[Vec2],z:f32,color:Vec3,transform:Mat4,id:u32,rounds:u8){\n    let mut pts=points.to_vec();for _ in 0..rounds{let mut out=vec![];for i in 0..pts.len(){let a=pts[i];let b=pts[(i+1)%pts.len()];out.push(a.lerp(b,0.25));out.push(a.lerp(b,0.75));}pts=out;}\n    let area=(0..pts.len()).map(|i|pts[i].perp_dot(pts[(i+1)%pts.len()])).sum::<f32>();if area<0.{pts.reverse();}\n    let mut data=MeshData::default();for a in &pts{let v=transform.transform_point3(Vec3::new(a.x,a.y,z));data.vertices.push(Vertex{pos:v.to_array(),normal:transform.transform_vector3(Vec3::Z).to_array(),uv:[0.,0.],color:[1.;4]});}\n    // Ear clipping allows the same card format to hold brows, V-necks and hair.\n    let mut remaining:Vec<usize>=(0..pts.len()).collect();let mut guard=0;\n    while remaining.len()>2 && guard<pts.len()*pts.len(){guard+=1;let mut cut=false;for j in 0..remaining.len(){let a=remaining[(j+remaining.len()-1)%remaining.len()];let b=remaining[j];let c=remaining[(j+1)%remaining.len()];if (pts[b]-pts[a]).perp_dot(pts[c]-pts[b])<=0.{continue;}\n        let inside=remaining.iter().any(|&i|i!=a&&i!=b&&i!=c&&(pts[b]-pts[a]).perp_dot(pts[i]-pts[a])>=0.&&(pts[c]-pts[b]).perp_dot(pts[i]-pts[b])>=0.&&(pts[a]-pts[c]).perp_dot(pts[i]-pts[c])>=0.);\n        if inside{continue;}data.indices.extend([a as u32,b as u32,c as u32]);remaining.remove(j);cut=true;break;\n    }if !cut{break;}}\n    for i in 0..pts.len(){let a=pts[i];let b=pts[(i+1)%pts.len()];let normal=Vec3::new(b.y-a.y,a.x-b.x,0.).normalize_or_zero();data.push_quad([transform.transform_point3(a.extend(z)),transform.transform_point3(a.extend(z-0.055)),transform.transform_point3(b.extend(z-0.055)),transform.transform_point3(b.extend(z))],transform.transform_vector3(normal));}\n    scene.dynamic.push(DynamicMesh{data,color,emissive:0.,style:Style::Cel,flags:0,group:id,material:0});\n}\nfn oval(scene:&mut Scene,c:Vec2,r:Vec2,z:f32,color:Vec3,m:Mat4,id:u32){let pts:Vec<Vec2>=(0..30).map(|i|{let a=i as f32*TAU/30.;c+Vec2::new(a.cos(),a.sin())*r}).collect();card(scene,&pts,z,color,m,id,0);}\npub fn theatre(scene:&mut Scene,left:&str,right:&str,speaker:&str,expr:&str,time:f32,set:&str){\n    scene.meshes.clear();scene.sdfs.clear();scene.dynamic.clear();scene.texts.clear();scene.point_lights.clear();\n    scene.camera=CameraData{view:glam::camera::rh::view::look_to_mat4(Vec3::new(0.,0.,17.),Vec3::NEG_Z,Vec3::Y),proj:glam::camera::rh::proj::directx::perspective(26f32.to_radians(),16./9.,0.1,100.),eye:Vec3::new(0.,0.,17.),forward:Vec3::NEG_Z,ortho:false};\n    scene.clear_color=srgb(11,29,35);scene.ambient=Ambient{sky:Vec3::splat(0.72),ground:Vec3::splat(0.55)};scene.sun.direction=Vec3::new(0.3,-0.45,-0.85).normalize();scene.sun.color=Vec3::splat(0.34);scene.post.outline_px=1.5;scene.post.outline_darken=0.32;scene.filter.vignette=0.32;\n    // Eight sets share architectural pieces, with their own lighting and window compositions.\n    let warm=set==\"gala\"||set==\"ship\";let base=if warm{srgb(59,45,45)}else{srgb(22,57,65)};\n    box_at(scene,Vec3::new(0.,0.,-1.),Vec3::new(20.,12.,0.15),base,Style::Cel,801);\n    for i in -4..=4 {box_at(scene,Vec3::new(i as f32*2.5,0.,-0.6),Vec3::new(0.12,12.,0.3),srgb(13,33,43),Style::Cel,802);}\n    for i in -2..=2 {box_at(scene,Vec3::new(0.,i as f32*2.,-0.7),Vec3::new(20.,0.1,0.2),srgb(46,78,81),Style::Cel,803);}\n    if warm {for i in -4..=4{sphere(scene,Vec3::new(i as f32*2.,2.5,-0.3),Vec3::splat(0.12),srgb(255,199,129),Style::Unlit,804,1.);}}\n    else {for i in 0..36 {let x=(i as f32*2.73).sin()*9.;let y=4.-(time*2.4+i as f32*0.91).rem_euclid(9.);line(scene,Vec3::new(x,y,-0.4),Vec3::new(x-0.08,y-0.45,-0.4),0.009,srgb(90,154,175),810,0.15);}}\n    for (i,name) in [left,right].iter().enumerate(){if name.is_empty(){continue;}let x=if i==0{-3.15}else{3.15};let active=*name==speaker;let yaw=if i==0{0.13}else{-0.13};let lift=if active{0.02*(time*2.).sin()}else{0.};let m=Mat4::from_scale_rotation_translation(Vec3::splat(1.55),Quat::from_rotation_y(yaw),Vec3::new(x,-0.4+lift,0.));actor(scene,name,expr,active,time,m,900+i as u32*60);}\n}\nfn actor(scene:&mut Scene,name:&str,expr:&str,talking:bool,t:f32,m:Mat4,id:u32){\n    let (skin,shade,hair,scrub)=match name{\n        \"Pet\"=>(srgb(122,80,58),srgb(107,68,53),srgb(226,226,232),srgb(98,70,136)),\n        \"Bashir\"=>(srgb(190,142,104),srgb(167,118,89),srgb(42,37,43),srgb(60,104,164)),\n        \"Teddy\"=>(srgb(229,181,151),srgb(205,155,132),srgb(127,79,49),srgb(53,116,136)),\n        \"Voss\"=>(srgb(225,191,174),srgb(198,163,152),srgb(182,179,180),srgb(52,70,86)),\n        \"Vane\"=>(srgb(237,196,168),srgb(218,169,143),srgb(155,96,50),srgb(221,196,152)),\n        _=>(srgb(242,200,172),srgb(226,178,153),srgb(46,36,60),srgb(46,150,146)),\n    };\n    let cv=|p:&[[f32;2]]|p.iter().map(|v|Vec2::from_array(*v)).collect::<Vec<_>>();\n    oval(scene,Vec2::new(0.,0.6),Vec2::new(0.89,1.03),0.,hair,m,id);\n    card(scene,&cv(&[[-1.72,-2.5],[-1.66,-1.36],[-1.2,-1.02],[-0.52,-0.82],[-0.3,-0.72],[0.,-1.34],[0.3,-0.72],[0.52,-0.82],[1.2,-1.02],[1.66,-1.36],[1.72,-2.5]]),0.035,scrub,m,id+1,2);\n    card(scene,&cv(&[[-0.3,-0.8],[-0.28,-0.24],[0.28,-0.24],[0.3,-0.8],[0.,-1.2]]),0.055,skin,m,id+2,2);\n    card(scene,&cv(&[[-0.76,0.76],[-0.74,0.28],[-0.56,-0.16],[-0.26,-0.5],[0.,-0.6],[0.26,-0.5],[0.56,-0.16],[0.74,0.28],[0.76,0.76],[0.52,1.22],[0.,1.32],[-0.52,1.22]]),0.105,skin,m,id+3,3);\n    oval(scene,Vec2::new(0.52,-0.03),Vec2::new(0.12,0.19),0.112,shade,m,id+3);\n    let blink=(t*0.7).sin()>0.994;let alarm=expr==\"alarmed\";let stern=expr==\"stern\";\n    for side in [-1.,1.] {\n        let eye=Vec2::new(side*0.34,0.34);let open=if blink{0.015}else if alarm{0.11}else{0.075};\n        oval(scene,eye,Vec2::new(0.19,open),0.13,srgb(255,247,222),m,id+4);\n        if !blink{oval(scene,eye+Vec2::new(-side*0.02,0.),Vec2::new(0.06,0.07),0.14,srgb(70,85,86),m,id+5);oval(scene,eye,Vec2::splat(0.03),0.145,srgb(26,28,39),m,id+6);oval(scene,eye+Vec2::new(-0.025,0.025),Vec2::splat(0.015),0.15,srgb(255,250,231),m,id+7);}\n        let by=if alarm{0.62}else{0.53};card(scene,&cv(&[[side*0.17,by+if stern{-0.03}else{0.}], [side*0.55,by+if stern{0.08}else{0.01}],[side*0.55,by+0.065],[side*0.17,by+0.055]]),0.155,hair,m,id+8,1);\n    }\n    card(scene,&cv(&[[-0.03,0.27],[0.055,-0.01],[-0.065,-0.025]]),0.14,shade,m,id+9,1);\n    let mouth=if talking&&(t*15.).sin()>0.{cv(&[[-0.15,-0.255],[0.,-0.20],[0.15,-0.255],[0.08,-0.36],[-0.08,-0.36]])}else{cv(&[[-0.16,-0.26],[0.,-0.235],[0.16,-0.26],[0.,-0.285]])};card(scene,&mouth,0.15,srgb(117,59,65),m,id+10,1);\n    card(scene,&cv(&[[-0.86,0.38],[-0.9,1.1],[-0.42,1.62],[0.26,1.68],[0.8,1.36],[0.92,0.8],[0.84,0.3],[0.68,0.74],[0.36,1.02],[-0.16,0.98],[-0.42,0.72],[-0.68,0.56]]),0.175,hair,m,id+11,3);\n    if name==\"Pet\" {oval(scene,Vec2::new(-0.62,1.29),Vec2::new(0.34,0.3),0.01,hair,m,id+12);}\n    if name==\"Bashir\"||name==\"Teddy\"{card(scene,&cv(&[[-0.8,0.9],[-0.8,1.45],[0.8,1.45],[0.8,0.9]]),0.19,scrub,m,id+13,2);}\n    card(scene,&cv(&[[-0.46,-0.89],[-0.15,-1.4],[-0.28,-1.5],[-0.65,-1.03]]),0.09,scrub*0.7,m,id+14,0);\n    card(scene,&cv(&[[0.46,-0.89],[0.15,-1.4],[0.28,-1.5],[0.65,-1.03]]),0.09,scrub*0.7,m,id+14,0);\n    card(scene,&cv(&[[0.55,-1.45],[0.92,-1.45],[0.92,-1.72],[0.55,-1.72]]),0.09,srgb(230,231,216),m,id+15,0);\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\nr=Path(Path('.game-path').read_text())/'engine'\np=r/'crates/pav_view/src/lib.rs';p.write_text(p.read_text()+'\\\\npub mod surgery;\\\\n')\np=r/'crates/pav_view/src/build.rs';s=p.read_text().replace('        lock(&self.materials).attach(&mut scene);','        if let Some(g) = &curr.surgery { crate::surgery::emit(&mut scene, g); }\\\\n        lock(&self.materials).attach(&mut scene);');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"The simulation now has tool gestures, ratings, vitals, heartbeat timing, gifts, Code events, and all eight case definitions. I’m building the operative field and paper-theatre cast next. The first bot playthroughs will check whether the gestures can complete each case before I tune the timing.\n"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); mkdir -p \"$d/engine/crates/pav_surgery/src\"; cat > \"$d/engine/crates/pav_surgery/Cargo.toml\" <<'\"'EOF'\n[package]\nname = \\\"pav_surgery\\\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n[lib]\ncrate-type = [\\\"cdylib\\\", \\\"rlib\\\"]\n[dependencies]\npav_core.workspace = true\npav_view.workspace = true\npav_render.workspace = true\nglam.workspace = true\nserde_json.workspace = true\n[target.'cfg(target_arch = \\\"wasm32\\\")'.dependencies]\nwasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\nweb-sys = { workspace = true, features = [\\\"Window\\\", \\\"Document\\\", \\\"HtmlCanvasElement\\\", \\\"console\\\"] }\n[lints]\nworkspace = true\nEOF\ncat > \\\"\"'$d/engine/crates/pav_surgery/src/lib.rs\" <<'\"'EOF'\n//\"'! Dedicated browser product host. All rules, snapshots and art use Pavilion'\"'s crates.\n#[cfg(target_arch=\\\"wasm32\\\")]\nmod web {\nuse wasm_bindgen::prelude::*;\nuse pav_core::{Sim,InputFrame,SimState};\nuse pav_core::games::surgery::{Surgery,SurgeonInput,HazardSpec};\nuse pav_render::{wgpu,Renderer,Scene};\nuse pav_render::gpu::{self,BackendChoice};\nuse pav_view::{CameraRig,surgery};\nuse glam::{Vec2,Vec3};\nuse serde_json::{Value,json};\n\nstruct Graphics {surface:wgpu::Surface<'static>,device:wgpu::Device,queue:wgpu::Queue,config:wgpu::SurfaceConfiguration,renderer:Renderer}\n#[wasm_bindgen]\npub struct Hospital {sim:Sim,graphics:Option<Graphics>,camera:CameraRig,saved:Option<SimState>}\n#[wasm_bindgen]\nimpl Hospital {\n    #[wasm_bindgen(constructor)]\n    pub fn new()->Self {\n        std::panic::set_hook(Box::new(|p|web_sys::console::error_1(&p.to_string().into())));\n        Self{sim:Sim::new(\\\"surgery/title\\\",42).expect(\\\"surgical scene\\\"),graphics:None,camera:surgery::camera(),saved:None}\n    }\n    pub async fn graphics(&mut self,canvas:web_sys::HtmlCanvasElement)->Result<(),JsValue>{\n        let instance=gpu::create_instance(BackendChoice::Vulkan);\n        let surface=instance.create_surface(wgpu::SurfaceTarget::Canvas(canvas.clone())).map_err(err)?;\n        let adapter=gpu::request_adapter_async(&instance,Some(&surface)).await.map_err(err)?;\n        let (device,queue)=gpu::request_device_async(&adapter).await.map_err(err)?;\n        device.on_uncaptured_error(std::sync::Arc::new(|e|web_sys::console::error_1(&format\"'!(\"Pavilion GPU: {e}\").into())));\n        let caps=surface.get_capabilities(&adapter);\n        let mut config=surface.get_default_config(&adapter,canvas.width().max(1),canvas.height().max(1)).ok_or(\"No drawing surface\")?;\n        config.format=caps.formats.iter().copied().find(|f|!f.is_srgb()).unwrap_or(config.format);\n        surface.configure(&device,&config);\n        let scope=device.push_error_scope(wgpu::ErrorFilter::Validation);\n        let renderer=Renderer::new(&device,&queue);\n        if let Some(e)=scope.pop().await{return Err(err(e));}\n        self.graphics=Some(Graphics{surface,device,queue,config,renderer});Ok(())\n    }\n    pub fn load(&mut self,scene:&str,seed:u32)->Result<(),JsValue>{self.sim=Sim::new(scene,seed as u64).map_err(err)?;self.camera=surgery::camera();Ok(())}\n    pub fn state(&self)->String{\n        let mut value=self.sim.play().unwrap().status(&self.sim);\n        value.as_object_mut().unwrap().remove(\"data\");\n        value[\"tick\"]=json!(self.sim.state.tick);value.to_string()\n    }\n    pub fn content(&self)->String{json!({\"title\":pav_core::games::surgery::TITLE,\"cases\":self.game().data.cases}).to_string()}\n    pub fn step(&mut self,raw:&str,n:u32,bot:bool)->Result<String,JsValue>{\n        let inputs:[SurgeonInput;4]=serde_json::from_str(raw).map_err(err)?;\n        for _ in 0..n.min(200000){let mut f=InputFrame{surgeons:inputs,..Default::default()};if bot {f=self.sim.bot_input();}self.sim.step(&f);}\n        Ok(self.state())\n    }\n    pub fn command(&mut self,raw:&str)->Result<String,JsValue>{\n        let v:Value=serde_json::from_str(raw).map_err(err)?;\n        let kind=v[\"type\"].as_str().unwrap_or(\"\");\n        if kind==\"snapshot\"{self.saved=Some(self.sim.snapshot());return Ok(self.state());}\n        if kind==\"restore\"{if let Some(s)=self.saved.clone(){self.sim.restore(s);}return Ok(self.state());}\n        if kind==\"rewind\"{let tick=self.sim.state.tick.saturating_sub(300);self.sim.rewind_to(tick);return Ok(self.state());}\n        let g=self.sim.state.play.as_mut().unwrap().get_mut::<Surgery>().unwrap();\n        match kind {\n            \"tune\"=>{let mut values=serde_json::to_value(&g.tune).unwrap();for (k,val) in v[\"values\"].as_object().ok_or(\"Expected tune values\")?{values[k]=val.clone();}g.tune=serde_json::from_value(values).map_err(err)?;},\n            \"defaults\"=>g.tune=Default::default(),\n            \"phase\"=>{g.phase=(v[\"phase\"].as_u64().unwrap_or(0) as usize).min(g.chart().phases.len()-1);g.mode=\"operation\".into();g.code=0.;g.shocks=0;g.load_phase();},\n            \"skip\"=>g.next(),\"win\"=>g.finish(),\"kill\"=>g.fail(),\"code\"=>g.start_code(1,false),\n            \"retry\"=>g.retry(v[\"checkpoint\"].as_bool().unwrap_or(true)),\n            \"gift\"=>{for s in &mut g.surgeons{s.gift=100.;}},\n            \"difficulty\"=>{g.difficulty=v[\"value\"].as_u64().unwrap_or(0).min(2) as u8;g.defibs=2-g.difficulty;},\n            \"spawn\"=>{let kind=v[\"kind\"].as_str().unwrap_or(\"pool\");let p=g.surgeons[0].cursor;g.spawn(&HazardSpec{kind:kind.into(),pos:p.to_array(),end:Some((p+Vec2::X*1.5).to_array()),hidden:false,stage:0});},\n            \"mirror\"=>{let mut state=serde_json::to_value(&*g).unwrap();for (key,value) in v[\"state\"].as_object().ok_or(\"Expected mirror frame\")?{state[key]=value.clone();}*g=serde_json::from_value(state).map_err(err)?;},\n            _=>return Err(JsValue::from_str(\"Unknown game command\")),\n        }Ok(self.state())\n    }\n    pub fn render(&mut self,width:u32,height:u32,mode:&str,story:&str,time:f32){\n        let g=self.game().clone();let Some(gfx)=&mut self.graphics else{return};\n        if width!=gfx.config.width || height!=gfx.config.height {gfx.config.width=width.max(1);gfx.config.height=height.max(1);gfx.surface.configure(&gfx.device,&gfx.config);}\n        self.camera.snap(Vec3::ZERO);\n        let mut scene=Scene{camera:self.camera.data(16./9.),time,..Default::default()};\n        surgery::emit(&mut scene,&g);\n        if mode==\"story\" {\n            let v:Value=serde_json::from_str(story).unwrap_or_default();let text=|key:&str|v[key].as_str().unwrap_or(\"\");\n            surgery::theatre(&mut scene,text(\"left\"),text(\"right\"),text(\"who\"),text(\"expr\"),time,text(\"set\"));\n        }\n        match gfx.surface.get_current_texture(){\n            wgpu::CurrentSurfaceTexture::Success(frame)|wgpu::CurrentSurfaceTexture::Suboptimal(frame)=>{\n                let view=frame.texture.create_view(&Default::default());let mut encoder=gfx.device.create_command_encoder(&Default::default());\n                gfx.renderer.render(&mut encoder,&scene,&view,gfx.config.format,(gfx.config.width,gfx.config.height));gfx.queue.submit([encoder.finish()]);gfx.queue.present(frame);\n            },_=>gfx.surface.configure(&gfx.device,&gfx.config),\n        }\n    }\n    pub fn aim(&self,x:f32,y:f32)->String{\n        let mut point=self.camera.ground_point(Vec2::new(x,y),Vec2::new(1920.,1080.),1.0).unwrap_or_default();\n        for _ in 0..3{let h=surgery::height(point.x,point.z,&self.game().stage().plate,self.game().beat);point=self.camera.ground_point(Vec2::new(x,y),Vec2::new(1920.,1080.),h).unwrap_or(point);}\n        json!([point.x,point.z]).to_string()\n    }\n    pub fn project(&self,x:f32,z:f32)->String{\n        let h=surgery::height(x,z,&self.game().stage().plate,self.game().beat)+0.1;\n        let n=self.camera.view_proj(16./9.).project_point3(Vec3::new(x,h,z));json!([(n.x+1.)*960.,(1.-n.y)*540.]).to_string()\n    }\n    pub fn hash(&self)->String{format!(\"{:?}\",self.sim.state_hash())}\n}\nimpl Hospital{fn game(&self)->&Surgery{self.sim.play().unwrap().get::<Surgery>().unwrap()}}\nfn err(e:impl std::fmt::Display)->JsValue{JsValue::from_str(&e.to_string())}\n}\nEOF\ncat > \"$d/engine/crates/pav_core/tests/surgery.rs\" <<'\"'EOF'\nuse pav_core::games::surgery::*;\nuse pav_core::games::Outcome;\nuse pav_core::{Sim,InputFrame,SimState};\n\nfn play(g:&mut Surgery,limit:usize){for _ in 0..limit{if g.mode\"'!=\"operation\"{break;}let mut i=[SurgeonInput::default();4];i[0]=g.bot_seat(0);if g.case==7{i[1]=g.bot_seat(1);}g.tick(i,1./60.);}}\n#[test]\nfn every_case_is_winnable(){for n in 0..8{for _ in 0..3{let mut g=Surgery::new(n,false,false);play(&mut g,60*900);assert_eq!(g.outcome,Outcome::Won,\"Case {n}: {} phase {}, vitals {}, hazards {:?}\",g.mode,g.phase,g.vitals,g.hazards);}}}\n#[test]\nfn idle_loses_every_case(){for n in 0..8{let mut g=Surgery::new(n,false,false);for _ in 0..60*900{g.tick([SurgeonInput::default();4],1./60.);if g.outcome==Outcome::Lost{break;}}assert_eq!(g.outcome,Outcome::Lost,\"case {n}\");}}\n#[test]\nfn campaign_exercises_the_whole_language(){\n let mut sim=Sim::new(\"surgery/campaign\",7).unwrap();let (result,_)=sim.run_bot(60*3600);let g=sim.play().unwrap().get::<Surgery>().unwrap();assert_eq!(result,Outcome::Won,\"phase {} case {} {:?}\",g.phase,g.case,g.hazards);\n for n in 0..9{assert!(g.coverage.contains_key(&format!(\"tool:{n}\")),\"missing tool {n}, {:?}\",g.coverage);}\n for key in [\"gift:Hush\",\"gift:Echo\",\"gift:Duet\",\"defibrillated\",\"strain:introit\",\"strain:lacrimosa\",\"strain:dies\",\"strain:libera\"]{assert!(g.coverage.contains_key(key),\"missing {key}\");}\n assert_eq!(g.completed.len(),8);\n}\n#[test]\nfn snapshots_and_replays_are_exact(){\n let mut a=Sim::new(\"surgery/case/3\",17).unwrap();for _ in 0..300{a.step(&a.bot_input());}\n let mut bytes=Vec::new();ciborium::into_writer(&a.snapshot(),&mut bytes).unwrap();let state:SimState=ciborium::from_reader(bytes.as_slice()).unwrap();let mut b=Sim::new(\"surgery/case/3\",17).unwrap();b.restore(state);\n for _ in 0..200{let f=a.bot_input();a.step(&f);b.step(&f);}assert_eq!(a.state_hash(),b.state_hash());\n let mut replay=Sim::new(\"surgery/case/3\",17).unwrap();for f in &a.recording{replay.step(f);}assert_eq!(a.state_hash(),replay.state_hash());\n}\n#[test]\nfn wrong_tool_and_checkpoint_are_real(){let mut g=Surgery::new(0,false,false);let p=g.hazards[0].pos;let mut i=[SurgeonInput::default();4];i[0]=SurgeonInput{active:true,aim:p,tool:2,held:USE,pressure:1.,..Default::default()};g.tick(i,1./60.);assert_eq!(g.mistakes,1);g.phase=2;g.fail();g.retry(true);assert_eq!(g.phase,2);assert_eq!(g.mode,\"operation\");assert!(!g.hazards.is_empty());}\n#[test]\nfn editable_content_is_complete(){let data=content().unwrap();assert_eq!(data.cases.len(),8);for c in data.cases{assert!(!c.patient.is_empty()&&!c.fate.is_empty());assert!(c.phases.len()>=4);for p in c.phases{assert!(!p.objective.is_empty());for h in p.hazards{assert!(h.pos.iter().all(|x|x.is_finite()));}}}}\nEOF\ncd \"$d/engine\"; CARGO_BUILD_JOBS=6 cargo test -p pav_core --test surgery > ../test-core.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); mkdir -p \"$d/engine/crates/pav_surgery/src\"; cat > \"$d/engine/crates/pav_surgery/Cargo.toml\" <<'\"'EOF'\n[package]\nname = \\\"pav_surgery\\\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n[lib]\ncrate-type = [\\\"cdylib\\\", \\\"rlib\\\"]\n[dependencies]\npav_core.workspace = true\npav_view.workspace = true\npav_render.workspace = true\nglam.workspace = true\nserde_json.workspace = true\n[target.'cfg(target_arch = \\\"wasm32\\\")'.dependencies]\nwasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\nweb-sys = { workspace = true, features = [\\\"Window\\\", \\\"Document\\\", \\\"HtmlCanvasElement\\\", \\\"console\\\"] }\n[lints]\nworkspace = true\nEOF\ncat > \\\"\"'$d/engine/crates/pav_surgery/src/lib.rs\" <<'\"'EOF'\n//\"'! Dedicated browser product host. All rules, snapshots and art use Pavilion'\"'s crates.\n#[cfg(target_arch=\\\"wasm32\\\")]\nmod web {\nuse wasm_bindgen::prelude::*;\nuse pav_core::{Sim,InputFrame,SimState};\nuse pav_core::games::surgery::{Surgery,SurgeonInput,HazardSpec};\nuse pav_render::{wgpu,Renderer,Scene};\nuse pav_render::gpu::{self,BackendChoice};\nuse pav_view::{CameraRig,surgery};\nuse glam::{Vec2,Vec3};\nuse serde_json::{Value,json};\n\nstruct Graphics {surface:wgpu::Surface<'static>,device:wgpu::Device,queue:wgpu::Queue,config:wgpu::SurfaceConfiguration,renderer:Renderer}\n#[wasm_bindgen]\npub struct Hospital {sim:Sim,graphics:Option<Graphics>,camera:CameraRig,saved:Option<SimState>}\n#[wasm_bindgen]\nimpl Hospital {\n    #[wasm_bindgen(constructor)]\n    pub fn new()->Self {\n        std::panic::set_hook(Box::new(|p|web_sys::console::error_1(&p.to_string().into())));\n        Self{sim:Sim::new(\\\"surgery/title\\\",42).expect(\\\"surgical scene\\\"),graphics:None,camera:surgery::camera(),saved:None}\n    }\n    pub async fn graphics(&mut self,canvas:web_sys::HtmlCanvasElement)->Result<(),JsValue>{\n        let instance=gpu::create_instance(BackendChoice::Vulkan);\n        let surface=instance.create_surface(wgpu::SurfaceTarget::Canvas(canvas.clone())).map_err(err)?;\n        let adapter=gpu::request_adapter_async(&instance,Some(&surface)).await.map_err(err)?;\n        let (device,queue)=gpu::request_device_async(&adapter).await.map_err(err)?;\n        device.on_uncaptured_error(std::sync::Arc::new(|e|web_sys::console::error_1(&format\"'!(\"Pavilion GPU: {e}\").into())));\n        let caps=surface.get_capabilities(&adapter);\n        let mut config=surface.get_default_config(&adapter,canvas.width().max(1),canvas.height().max(1)).ok_or(\"No drawing surface\")?;\n        config.format=caps.formats.iter().copied().find(|f|!f.is_srgb()).unwrap_or(config.format);\n        surface.configure(&device,&config);\n        let scope=device.push_error_scope(wgpu::ErrorFilter::Validation);\n        let renderer=Renderer::new(&device,&queue);\n        if let Some(e)=scope.pop().await{return Err(err(e));}\n        self.graphics=Some(Graphics{surface,device,queue,config,renderer});Ok(())\n    }\n    pub fn load(&mut self,scene:&str,seed:u32)->Result<(),JsValue>{self.sim=Sim::new(scene,seed as u64).map_err(err)?;self.camera=surgery::camera();Ok(())}\n    pub fn state(&self)->String{\n        let mut value=self.sim.play().unwrap().status(&self.sim);\n        value.as_object_mut().unwrap().remove(\"data\");\n        value[\"tick\"]=json!(self.sim.state.tick);value.to_string()\n    }\n    pub fn content(&self)->String{json!({\"title\":pav_core::games::surgery::TITLE,\"cases\":self.game().data.cases}).to_string()}\n    pub fn step(&mut self,raw:&str,n:u32,bot:bool)->Result<String,JsValue>{\n        let inputs:[SurgeonInput;4]=serde_json::from_str(raw).map_err(err)?;\n        for _ in 0..n.min(200000){let mut f=InputFrame{surgeons:inputs,..Default::default()};if bot {f=self.sim.bot_input();}self.sim.step(&f);}\n        Ok(self.state())\n    }\n    pub fn command(&mut self,raw:&str)->Result<String,JsValue>{\n        let v:Value=serde_json::from_str(raw).map_err(err)?;\n        let kind=v[\"type\"].as_str().unwrap_or(\"\");\n        if kind==\"snapshot\"{self.saved=Some(self.sim.snapshot());return Ok(self.state());}\n        if kind==\"restore\"{if let Some(s)=self.saved.clone(){self.sim.restore(s);}return Ok(self.state());}\n        if kind==\"rewind\"{let tick=self.sim.state.tick.saturating_sub(300);self.sim.rewind_to(tick);return Ok(self.state());}\n        let g=self.sim.state.play.as_mut().unwrap().get_mut::<Surgery>().unwrap();\n        match kind {\n            \"tune\"=>{let mut values=serde_json::to_value(&g.tune).unwrap();for (k,val) in v[\"values\"].as_object().ok_or(\"Expected tune values\")?{values[k]=val.clone();}g.tune=serde_json::from_value(values).map_err(err)?;},\n            \"defaults\"=>g.tune=Default::default(),\n            \"phase\"=>{g.phase=(v[\"phase\"].as_u64().unwrap_or(0) as usize).min(g.chart().phases.len()-1);g.mode=\"operation\".into();g.code=0.;g.shocks=0;g.load_phase();},\n            \"skip\"=>g.next(),\"win\"=>g.finish(),\"kill\"=>g.fail(),\"code\"=>g.start_code(1,false),\n            \"retry\"=>g.retry(v[\"checkpoint\"].as_bool().unwrap_or(true)),\n            \"gift\"=>{for s in &mut g.surgeons{s.gift=100.;}},\n            \"difficulty\"=>{g.difficulty=v[\"value\"].as_u64().unwrap_or(0).min(2) as u8;g.defibs=2-g.difficulty;},\n            \"spawn\"=>{let kind=v[\"kind\"].as_str().unwrap_or(\"pool\");let p=g.surgeons[0].cursor;g.spawn(&HazardSpec{kind:kind.into(),pos:p.to_array(),end:Some((p+Vec2::X*1.5).to_array()),hidden:false,stage:0});},\n            \"mirror\"=>{let mut state=serde_json::to_value(&*g).unwrap();for (key,value) in v[\"state\"].as_object().ok_or(\"Expected mirror frame\")?{state[key]=value.clone();}*g=serde_json::from_value(state).map_err(err)?;},\n            _=>return Err(JsValue::from_str(\"Unknown game command\")),\n        }Ok(self.state())\n    }\n    pub fn render(&mut self,width:u32,height:u32,mode:&str,story:&str,time:f32){\n        let g=self.game().clone();let Some(gfx)=&mut self.graphics else{return};\n        if width!=gfx.config.width || height!=gfx.config.height {gfx.config.width=width.max(1);gfx.config.height=height.max(1);gfx.surface.configure(&gfx.device,&gfx.config);}\n        self.camera.snap(Vec3::ZERO);\n        let mut scene=Scene{camera:self.camera.data(16./9.),time,..Default::default()};\n        surgery::emit(&mut scene,&g);\n        if mode==\"story\" {\n            let v:Value=serde_json::from_str(story).unwrap_or_default();let text=|key:&str|v[key].as_str().unwrap_or(\"\");\n            surgery::theatre(&mut scene,text(\"left\"),text(\"right\"),text(\"who\"),text(\"expr\"),time,text(\"set\"));\n        }\n        match gfx.surface.get_current_texture(){\n            wgpu::CurrentSurfaceTexture::Success(frame)|wgpu::CurrentSurfaceTexture::Suboptimal(frame)=>{\n                let view=frame.texture.create_view(&Default::default());let mut encoder=gfx.device.create_command_encoder(&Default::default());\n                gfx.renderer.render(&mut encoder,&scene,&view,gfx.config.format,(gfx.config.width,gfx.config.height));gfx.queue.submit([encoder.finish()]);gfx.queue.present(frame);\n            },_=>gfx.surface.configure(&gfx.device,&gfx.config),\n        }\n    }\n    pub fn aim(&self,x:f32,y:f32)->String{\n        let mut point=self.camera.ground_point(Vec2::new(x,y),Vec2::new(1920.,1080.),1.0).unwrap_or_default();\n        for _ in 0..3{let h=surgery::height(point.x,point.z,&self.game().stage().plate,self.game().beat);point=self.camera.ground_point(Vec2::new(x,y),Vec2::new(1920.,1080.),h).unwrap_or(point);}\n        json!([point.x,point.z]).to_string()\n    }\n    pub fn project(&self,x:f32,z:f32)->String{\n        let h=surgery::height(x,z,&self.game().stage().plate,self.game().beat)+0.1;\n        let n=self.camera.view_proj(16./9.).project_point3(Vec3::new(x,h,z));json!([(n.x+1.)*960.,(1.-n.y)*540.]).to_string()\n    }\n    pub fn hash(&self)->String{format!(\"{:?}\",self.sim.state_hash())}\n}\nimpl Hospital{fn game(&self)->&Surgery{self.sim.play().unwrap().get::<Surgery>().unwrap()}}\nfn err(e:impl std::fmt::Display)->JsValue{JsValue::from_str(&e.to_string())}\n}\nEOF\ncat > \"$d/engine/crates/pav_core/tests/surgery.rs\" <<'\"'EOF'\nuse pav_core::games::surgery::*;\nuse pav_core::games::Outcome;\nuse pav_core::{Sim,InputFrame,SimState};\n\nfn play(g:&mut Surgery,limit:usize){for _ in 0..limit{if g.mode\"'!=\"operation\"{break;}let mut i=[SurgeonInput::default();4];i[0]=g.bot_seat(0);if g.case==7{i[1]=g.bot_seat(1);}g.tick(i,1./60.);}}\n#[test]\nfn every_case_is_winnable(){for n in 0..8{for _ in 0..3{let mut g=Surgery::new(n,false,false);play(&mut g,60*900);assert_eq!(g.outcome,Outcome::Won,\"Case {n}: {} phase {}, vitals {}, hazards {:?}\",g.mode,g.phase,g.vitals,g.hazards);}}}\n#[test]\nfn idle_loses_every_case(){for n in 0..8{let mut g=Surgery::new(n,false,false);for _ in 0..60*900{g.tick([SurgeonInput::default();4],1./60.);if g.outcome==Outcome::Lost{break;}}assert_eq!(g.outcome,Outcome::Lost,\"case {n}\");}}\n#[test]\nfn campaign_exercises_the_whole_language(){\n let mut sim=Sim::new(\"surgery/campaign\",7).unwrap();let (result,_)=sim.run_bot(60*3600);let g=sim.play().unwrap().get::<Surgery>().unwrap();assert_eq!(result,Outcome::Won,\"phase {} case {} {:?}\",g.phase,g.case,g.hazards);\n for n in 0..9{assert!(g.coverage.contains_key(&format!(\"tool:{n}\")),\"missing tool {n}, {:?}\",g.coverage);}\n for key in [\"gift:Hush\",\"gift:Echo\",\"gift:Duet\",\"defibrillated\",\"strain:introit\",\"strain:lacrimosa\",\"strain:dies\",\"strain:libera\"]{assert!(g.coverage.contains_key(key),\"missing {key}\");}\n assert_eq!(g.completed.len(),8);\n}\n#[test]\nfn snapshots_and_replays_are_exact(){\n let mut a=Sim::new(\"surgery/case/3\",17).unwrap();for _ in 0..300{a.step(&a.bot_input());}\n let mut bytes=Vec::new();ciborium::into_writer(&a.snapshot(),&mut bytes).unwrap();let state:SimState=ciborium::from_reader(bytes.as_slice()).unwrap();let mut b=Sim::new(\"surgery/case/3\",17).unwrap();b.restore(state);\n for _ in 0..200{let f=a.bot_input();a.step(&f);b.step(&f);}assert_eq!(a.state_hash(),b.state_hash());\n let mut replay=Sim::new(\"surgery/case/3\",17).unwrap();for f in &a.recording{replay.step(f);}assert_eq!(a.state_hash(),replay.state_hash());\n}\n#[test]\nfn wrong_tool_and_checkpoint_are_real(){let mut g=Surgery::new(0,false,false);let p=g.hazards[0].pos;let mut i=[SurgeonInput::default();4];i[0]=SurgeonInput{active:true,aim:p,tool:2,held:USE,pressure:1.,..Default::default()};g.tick(i,1./60.);assert_eq!(g.mistakes,1);g.phase=2;g.fail();g.retry(true);assert_eq!(g.phase,2);assert_eq!(g.mode,\"operation\");assert!(!g.hazards.is_empty());}\n#[test]\nfn editable_content_is_complete(){let data=content().unwrap();assert_eq!(data.cases.len(),8);for c in data.cases{assert!(!c.patient.is_empty()&&!c.fate.is_empty());assert!(c.phases.len()>=4);for p in c.phases{assert!(!p.objective.is_empty());for h in p.hazards{assert!(h.pos.iter().all(|x|x.is_finite()));}}}}\nEOF\ncd \"$d/engine\"; CARGO_BUILD_JOBS=6 cargo test -p pav_core --test surgery > ../test-core.log 2>&1'","aggregated_output":"","exit_code":101,"status":"failed"}}
