{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); cat > \"$d/tests/browser_checks.py\" <<'\"'PY'\nfrom pathlib import Path\nimport json,time\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parents[1]\nURL=(ROOT.parent/(ROOT.name+'.html')).as_uri()\nPAD='''window.__pad={id:'DualSense Wireless Controller (STANDARD GAMEPAD)',index:0,connected:true,mapping:'standard',timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[__pad,null,null,null];'''\nresults=[]\ndef check(name,func):\n try:func();results.append({'name':name,'pass':True})\n except Exception as e:results.append({'name':name,'pass':False,'error':str(e)})\ndef expect(condition,message='assertion failed'):\n if not condition:raise AssertionError(message)\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n ctx=browser.new_context(viewport={'width':1280,'height':720})\n ctx.add_init_script('window.__surgeryTestNoGPU=true;'+PAD)\n page=ctx.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n page.goto(URL);page.wait_for_function('window.__game',timeout=60000)\n def status():return page.evaluate('__game.status()')\n def do(v):page.evaluate('(c)=>__game.do(c)',v)\n def wait(js,timeout=7000):page.wait_for_function(js,timeout=timeout)\n def pad(button,down=True):page.evaluate('([i,b])=>{__pad.buttons[i].pressed=b;__pad.buttons[i].value=b?1:0;__pad.timestamp++;}',[button,down]);page.wait_for_timeout(70)\n def tap(button):pad(button);pad(button,False)\n def point(x,z):\n  return page.evaluate('([x,z])=>{const a=__game.project(x,z),r=document.querySelector(\\\"#stage\\\").getBoundingClientRect();return [r.left+a[0]*r.width/1920,r.top+a[1]*r.height/1080]}',[x,z])\n check('single-file boot and music default',lambda:expect(status()['title']=='Trauma Refrain: Third Opinion' and status()['settings']['music']==.1 and not errors))\n def keyboard_menu():\n  page.keyboard.press('Enter');expect(status()['screen']=='menu');page.keyboard.press('Enter');expect(status()['screen']=='difficulty')\n check('keyboard menu navigation',keyboard_menu)\n def pad_menu():\n  tap(13);expect(status()['focus']==1);tap(0);expect(status()['screen']=='story');expect(status()['device']=='pad')\n check('DualSense menu and prompt detection',pad_menu)\n def story():\n  do({'action':'advance'});a=page.locator('.story-text').inner_text();page.wait_for_timeout(100);expect(page.locator('.story-text').inner_text()==a,'revealed text regressed');do({'action':'skipstory'});expect(status()['screen']=='chart')\n check('story reveal and skip to chart',story)\n def mouse_menu():\n  do({'action':'title'});page.keyboard.press('Enter');el=page.locator('[data-action=\\\"codeblue\\\"]');el.hover();expect('focused' in el.get_attribute('class'));el.click();expect(status()['sim']['blue'])\n check('mouse hover focus and Code Blue entry',mouse_menu)\n def tool_digits():\n  do({'load':0});page.keyboard.press('6');wait('__game.status().sim.surgeons[0].tool===5');expect(status()['device']=='keyboard')\n check('instrument digit input',tool_digits)\n def gel_gesture():\n  page.mouse.move(*point(-4,0));page.mouse.down();wait('(__game.status().sim.surgeons[0].held&1)\"'!==0'\"');page.evaluate('__game.step(95,false)');page.mouse.up();expect(not status()['sim']['hazards'][0]['alive'],'gel was not painted')\n check('actual mouse paint gesture',gel_gesture)\n def forceps_gesture():\n  page.keyboard.press('2');page.mouse.move(*point(-1.2,-1.1));page.mouse.down();wait('__game.status().sim.surgeons[0].grabbed\"'!==null'\"');page.mouse.move(*point(-1.2,-2.4),steps=12);wait('\"'!__game.status().sim.hazards[1].alive'\"');page.mouse.up()\n check('actual mouse forceps pull gesture',forceps_gesture)\n def suture_gesture():\n  do({'type':'phase','phase':2});page.keyboard.press('3');page.mouse.move(*point(-1.6,.95));page.mouse.down()\n  for n in range(10):\n   g=status()['sim'];h=g['hazards'][0]\n   if not h['alive']:break\n   x=-2+4*min(.95,h['progress']+.08);z=.6+(-.35 if n%2 else .35);page.mouse.move(*point(x,z),steps=4);page.wait_for_timeout(90)\n  page.mouse.up();expect(not status()['sim']['hazards'][0]['alive'],'zigzag did not produce stitches')\n check('actual mouse suture crossings',suture_gesture)\n def laser_gesture():\n  do({'load':1});do({'type':'phase','phase':1});page.keyboard.press('5');page.mouse.move(*point(-3,-1));page.mouse.down();wait('__game.status().sim.surgeons[0].charge>.8');page.mouse.up();wait('\"'!__game.status().sim.hazards[0].alive'\"')\n check('actual laser hold and release',laser_gesture)\n def keyboard_cursor():\n  do({'load':0});before=status()['sim']['surgeons'][0]['cursor'];page.keyboard.down('d');page.wait_for_timeout(160);page.keyboard.up('d');expect(status()['sim']['surgeons'][0]['cursor'][0]>before[0]+.4)\n check('keyboard-only cursor movement',keyboard_cursor)\n def flick():\n  page.evaluate('__pad.axes[0]=1;__pad.timestamp++');page.wait_for_timeout(120);expect(status()['sim']['surgeons'][0]['tool']==2);page.evaluate('__pad.axes[0]=0;__pad.timestamp++');pad(7);expect(status()['sim']['surgeons'][0]['held']&1);pad(7,False)\n check('DualSense flick and analog trigger',flick)\n def pause_dev():\n  tap(9);expect(status()['screen']=='pause');do({'action':'dev'});expect(status()['screen']=='dev');el=page.locator('[data-tune=\\\"drain\\\"]');el.fill('2');el.dispatch_event('input');expect(abs(status()['sim']['tune']['drain']-2)<.01);do({'action':'devreset'});expect(status()['sim']['tune']['drain']==1)\n check('pause to dev live sliders and reset',pause_dev)\n def checkpoint():\n  do({'type':'phase','phase':2});do({'type':'kill'});before=time.monotonic();do({'action':'retry'});expect(status()['sim']['phase']==2 and status()['screen']=='operation');expect(time.monotonic()-before<2)\n check('checkpoint retry under two seconds',checkpoint)\n def audio():\n  page.keyboard.press('Escape');page.evaluate('__game.sound()');page.wait_for_timeout(120);expect(status()['audioPeak']>.001,'synthesized output is silent')\n check('Web Audio output is non-silent',audio)\n def settings_persist():\n  do({'action':'settings'});do({'action':'settingstab:1'});do({'action':'setting:glyphs'});expect(status()['glyphs']=='Xbox');page.reload();page.wait_for_function('window.__game');expect(status()['glyphs']=='Xbox');do({'action':'settings'});do({'action':'resetsettings'});expect(status()['settings']['music']==.1)\n check('settings and prompt preference persist',settings_persist)\n def attract():\n  do({'action':'title'});do({'idle':10050});wait('__game.status().screen===\\\"attract\\\"');page.keyboard.press('k');wait('__game.status().screen===\\\"title\\\"');do({'idle':10050});wait('__game.status().screen===\\\"attract\\\"');tap(0);expect(status()['screen']=='title')\n check('attract idle threshold and key/pad exit',attract)\n def campaign():\n  do({'scene':'surgery/campaign'});g=page.evaluate('__game.step(120000,true)');expect(g['outcome']=='won' and len(g['completed'])==8);expect(all('tool:'+str(i) in g['coverage'] for i in range(9)));expect(all('gift:'+x in g['coverage'] for x in ['Hush','Echo','Duet']))\n check('full browser campaign and feature coverage',campaign)\n def about():\n  do({'action':'about'});text=page.locator('#ui').inner_text();expect(all(k in text for k in ['Credits','Source Information','Testing Feedback','Engine Feedback','Prompt Feedback']));do({'action':'aboutsection:1'});do({'action':'aboutnext:15'});expect('Trauma Center: Second Opinion' in page.locator('#ui').inner_text())\n check('About includes all required sections',about)\n check('no browser script errors',lambda:expect(not errors,json.dumps(errors)))\n ctx.close()\n mobile=browser.new_context(**p.devices['iPhone 17 Pro']);mobile.add_init_script('window.__surgeryTestNoGPU=true;');mp=mobile.new_page();mp.goto(URL);mp.wait_for_function('window.__game')\n def touch_only():\n  expect(mp.locator('#touch-note').is_visible());expect('Controller or keyboard required' in mp.locator('#touch-note').inner_text());mp.locator('#touch-settings').tap();expect(mp.locator('[data-setting=\\\"music\\\"]').is_visible());expect(mp.evaluate('__game.status().screen')=='settings');expect(mp.locator('[data-setting=\\\"music\\\"]').bounding_box()['width']>100)\n check('touch-only message and usable settings',touch_only)\n def touch_attract():\n  mp.evaluate('__game.do({action:\\\"back\\\"});__game.do({idle:10050})');mp.wait_for_function('__game.status().screen===\\\"attract\\\"');mp.touchscreen.tap(100,100)\n  # A touch is an exit gesture even though it never becomes a gameplay control.\n  mp.wait_for_timeout(100);expect(mp.evaluate('__game.status().screen')=='title')\n check('touch attract and tap exit',touch_attract)\n mobile.close();browser.close()\n with p.webkit.launch(headless=True) as webkit:\n  wp=webkit.new_page(**p.devices['iPhone 13']);wp.goto(URL);wp.wait_for_function('window.__game',timeout=60000)\n  check('WebKit graceful WebGPU requirement and phone UI',lambda:expect(wp.locator('#touch-note').is_visible() and wp.locator('#gpu-note').is_visible()))\n(ROOT/'tests/out/browser-results.json').write_text(json.dumps(results,indent=2))\nfor r in results:\n if not r['pass']:print('FAIL '+r['name']+': '+r['error'])\nprint(json.dumps({'passed':sum(r['pass'] for r in results),'failed':sum(not r['pass'] for r in results)}))\nPY\ncat > \\\"\"'$d/tests/run_all.py\" <<'\"'PY'\n#\"'!/usr/bin/env python3\n\"\"\"One command; only failures and a final count are printed. Subsets: --rust --web --hub.\"\"\"\nimport sys,subprocess,re,json\nfrom pathlib import Path\nROOT=Path(__file__).resolve().parents[1]\nargs=set(sys.argv[1:]);all_parts=not args\npassed=failed=0\nif all_parts or '\"'--rust' in args:\n r=subprocess.run(['cargo','test','--locked','-p','pav_core','--test','surgery'],cwd=ROOT/'engine',capture_output=True,text=True)\n text=r.stdout+r.stderr\n m=re.search(r'test result: .*?(\\\\d+) passed; (\\\\d+) failed',text)\n if m:passed+=int(m[1]);failed+=int(m[2])\n else:failed+=1\n if r.returncode:print('FAIL Rust simulation checks\\\\n'+text[-12000:])\nfor part,script in [('--web','browser_checks.py'),('--hub','hub_checks.py')]:\n if not(all_parts or part in args):continue\n r=subprocess.run([sys.executable,str(ROOT/'tests'/script)],cwd=ROOT,capture_output=True,text=True)\n lines=r.stdout.splitlines();found=False\n for line in lines:\n  if line.startswith('FAIL '):print(line)\n  if line.startswith('{'):\n   try:\n    counts=json.loads(line);passed+=counts['passed'];failed+=counts['failed'];found=True\n   except (ValueError,KeyError):pass\n if r.returncode or not found:failed+=1;print('FAIL '+script+'\\\\n'+r.stderr[-9000:]+'\\\\n'+r.stdout[-2000:])\nprint(f'{passed} passed, {failed} failed')\nsys.exit(bool(failed))\nPY\npython3 \\\"\"'$d/tests/run_all.py\" --web'","aggregated_output":"FAIL instrument digit input: Page.wait_for_function: Timeout 7000ms exceeded.\nFAIL actual mouse paint gesture: gel was not painted\nFAIL actual mouse forceps pull gesture: Page.wait_for_function: Timeout 7000ms exceeded.\nFAIL actual mouse suture crossings: zigzag did not produce stitches\nFAIL actual laser hold and release: Page.wait_for_function: Timeout 7000ms exceeded.\nFAIL About includes all required sections: assertion failed\nFAIL touch attract and tap exit: assertion failed\n16 passed, 7 failed\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); cat > \"$d/tests/visuals.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parents[1]\nURL=(ROOT.parent/(ROOT.name+'.html')).as_uri()\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n page=browser.new_page(viewport={'width':1920,'height':1080},device_scale_factor=1);page.goto(URL);page.wait_for_function('window.__game',timeout=90000)\n page.evaluate('__game.do({action:\\\"new\\\"});__game.do({action:\\\"difficulty:0\\\"});__game.do({action:\\\"advance\\\"})');page.wait_for_timeout(200)\n page.screenshot(path=str(ROOT/'tests/out/story.png'))\n page.evaluate('__game.do({load:3});__game.step(30000,true)');page.wait_for_timeout(100)\n page.screenshot(path=str(ROOT/'tests/out/results.png'))\n page.evaluate('__game.do({load:6});__game.do({screen:\\\"pause\\\"});__game.do({action:\\\"dev\\\"})');page.wait_for_timeout(100)\n page.screenshot(path=str(ROOT/'tests/out/dev.png'))\n page.evaluate('__game.do({action:\\\"about\\\"})');page.wait_for_timeout(100)\n page.screenshot(path=str(ROOT/'tests/out/about.png'))\n browser.close()\nprint('Visual captures written.')\nPY\npython3 \\\"\"'$d/tests/visuals.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); sed -n '\"'400,532p' \\\"\"'$d/vendor/harness.html\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc 'd=$(cat .game-path); sed -n '\"'400,532p' \\\"\"'$d/vendor/harness.html\"'","aggregated_output":"  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_61","type":"agent_message","text":"Browser testing caught an input conflict: a connected but idle controller could overwrite mouse and keyboard tool selection. I also found that tapping outside the game canvas on a phone didn’t exit attract mode. I’m fixing both and rerunning the affected gesture checks before multiplayer testing.\n"}}
{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nr=Path(Path('.game-path').read_text());p=r/'web/app.js';s=p.read_text().replace(\\\"if(seat\"'!==undefined && inputs[seat] && screen!=='\"'attract'){\\\", \\\"if(seat\"'!==undefined && inputs[seat] && screen!=='\"'attract' && (device==='pad'||seat\"'!==(H.active?H.me:0))){\")\ns=s.replace(\"addEventListener('\"'pointerup',e=>\\\", \\\"addEventListener('pointerdown',e=>{if(screen==='attract')activity(e.pointerType==='touch'?'touch':'mouse');},true);\\\\naddEventListener('pointerup',e=>\\\")\ns=s.replace(\\\"if(typeof c==='string')c=JSON.parse(c);\\\", \\\"if(typeof c==='string')c=JSON.parse(c);\\\\n   lastInput=performance.now();\\\")\np.write_text(s)\np=r/'tests/browser_checks.py';s=p.read_text().replace(\\\"expect(all(k in text for k in ['Credits','Source Information','Testing Feedback','Engine Feedback','Prompt Feedback']));\\\", \\\"expect(all(k in text for k in ['Credits','Source Information','Testing Feedback','Engine Feedback','Prompt Feedback']),text);\\\")\ns=s.replace(\\\"expect('Trauma Center: Second Opinion' in page.locator('#ui').inner_text())\\\", \\\"expect('Trauma Center: Second Opinion' in page.locator('#ui').inner_text(),page.locator('#ui').inner_text())\\\")\np.write_text(s)\nPY\nd=\"'$(cat .game-path); python3 \"$d/tools/bundle.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
