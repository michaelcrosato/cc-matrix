{"type":"item.started","item":{"id":"item_94","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nr=Path(Path('.game-path').read_text());p=r/'engine/crates/pav_core/src/games/surgery/mod.rs';s=p.read_text().replace('if seat == 3 && self.surgeons[3].ghost {\\\\n                continue;\\\\n            }', 'if seat == 3 && self.surgeons[3].ghost {\\\\n                if input.active { self.surgeons[3].ghost = false; } else { continue; }\\\\n            }');p.write_text(s)\np=r/'engine/crates/pav_core/tests/surgery.rs';s=p.read_text();needle='assert\"'!(g.coverage.contains_key(\"echo_repeat\"));'\"';s=s.replace(needle,needle+'\\\\n    g.surgeons[3].ghost = true; f[3] = SurgeonInput { active: true, aim: glam::Vec2::new(6., 2.), tool: 5, ..Default::default() }; g.tick(f, 1./60.); assert\"'!(!g.surgeons[3].ghost);'\"');p.write_text(s)\np=r/'web/app.js';s=p.read_text().replace(\\\"const pads=navigator.getGamepads?.()||[];\\\\n for(const pad\\\", \\\"const pads=navigator.getGamepads?.()||[];\\\\n const present=new Set([...pads].filter(Boolean).map(p=>p.index));for(const [index,seat] of padSeats){if(\"'!present.has(index)){padSeats.delete(index);if(inputs[seat])inputs[seat]=empty();if(ready&&S.surgeons[seat]){const ss=S.surgeons.map((s,i)=>i===seat?{...s,active:false,held:0}:s);command({type:'\"'mirror',state:{surgeons:ss}});}}}\\\\n for(const pad\\\")\np.write_text(s)\nPY\nd=\"'$(cat .game-path); cd \"$d/engine\"; cargo fmt --all; CARGO_BUILD_JOBS=6 cargo build --locked -p pav_tools --bin pav > ../build-native.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
