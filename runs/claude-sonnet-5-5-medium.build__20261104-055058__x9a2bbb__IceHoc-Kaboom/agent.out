x('star'); const st = this.m.res.stars[3 - n]; if (st) { const gk = st.goalie; Synth.babble(['Third star of the game!', 'Second star!', 'And the first star of the game!'][n - 1], 'chuck', { excl: true }); } }\n    if (this.revealed >= 3 && this.t > 7) this.tiles.update(dt); else if (game.input.pressed('confirm')) this.t += 1.8;\n  },\n  draw(r) { Backdrop.draw(r); const m = this.m; r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, 'rgba(5,8,20,.72)'); UI.title(g, m.res.win < 0 ? 'A TIE!' : this.win ? (this.story ? 'VICTORY!' : m.teams[0].name.split(' ').pop() + ' WIN') : (this.story ? 'DEFEAT' : m.teams[1].name.split(' ').pop() + ' WIN'), r.W / 2, 6, 3);\n    UI.txt(g, m.teams[0].abbr + '  ' + m.score[0] + '  -  ' + m.score[1] + '  ' + m.teams[1].abbr + (m.so && m.so.final ? '  (SO)' : m.ot ? '  (OT)' : ''), r.W / 2, 34, '#fff', { align: 'center', scale: 3 });\n    const names = ['3RD STAR', '2ND STAR', '1ST STAR']; for (let i = 0; i < this.revealed; i++) { const st = m.res.stars[2 - i]; if (!st) continue; const k = 2 - i, x = 20 + k * 98, y = 64, big = k === 0; const rig = st.goalie ? st.s.rig : st.s.rig; UI.box(g, x, y, 92, 80, { border: big ? '#ffd36a' : '#6a7aaa', alpha: .95 }); UI.txt(g, ['1ST STAR', '2ND STAR', '3RD STAR'][k], x + 46, y + 4, big ? '#ffd36a' : '#cfe', { align: 'center' }); rig.drawPortrait(g, x + 26, y + 14, 40, { zoom: 2.4, turn: .5, bg: [m.teams[st.side].home.cloth, '#10131f'] }); UI.txt(g, st.s.nick, x + 46, y + 58, '#fff', { align: 'center' }); UI.txt(g, st.line, x + 46, y + 68, '#9ab', { align: 'center', font: 'tiny' }); }\n    if (this.story && this.t > 3) { this.story.objectives.forEach((o, i) => { const ok = Objectives.done(o.id); UI.txt(g, (ok ? '★ ' : '☆ ') + o.text, r.W / 2, 150 + i * 0, ok ? '#ffd36a' : '#667', { align: 'center' }); }); const ob = this.story.objectives; ob.forEach((o, i) => UI.txt(g, (Objectives.done(o.id) && this.t > 3 + i * .6 ? '★ ' : '☆ ') + o.text, r.W / 2, 148 + i * 9, Objectives.done(o.id) && this.t > 3 + i * .6 ? 