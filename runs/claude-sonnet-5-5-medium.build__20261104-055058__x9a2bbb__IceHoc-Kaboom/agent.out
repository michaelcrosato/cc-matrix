= 'stoppage' && m.pt > .5 && m.pt < 1.7 && !m.over) lowerThird(g, r, m);\n    if (m.phase === 'flood' && m.fl) floodHud(g, r, m);\n    if (m.phase === 'final') finalCard(g, r, m);\n    UI.drawBanners(g, r, dt); UI.drawToasts(g, r, dt); Talk.drawTip(g, r, dt);\n    if (m.phase === 'play' && m.cfg.story) { const o = m.cfg.story.objectives; }\n  }\n  function lowerThird(g, r, m) { const w = 190, x = 8, y = r.H - 54; UI.box(g, x, y, w, 30, { border: '#6a7aaa', alpha: .9 }); UI.txt(g, 'SHOTS  ' + m.stats.shots[0] + ' - ' + m.stats.shots[1] + '   HITS  ' + m.stats.hits[0] + ' - ' + m.stats.hits[1], x + 6, y + 6, '#cfe0ff'); UI.txt(g, 'FACEOFFS  ' + m.stats.faceoffs[0] + ' - ' + m.stats.faceoffs[1], x + 6, y + 18, '#9ab'); }\n  function introCard(g, r, m) { const u = clamp(m.pt / (m.cfg.introLen || 4.2), 0, .999), idx = Math.floor(u * 6), side = idx < 3 ? 0 : 1, s = Sim.teamOf(m, side)[idx % 3]; if (!s) return; const hw = 110; UI.box(g, r.W / 2 - hw, r.H - 80, hw * 2, 48, { border: m.teams[side].home.trim, alpha: .92 }); s.rig.drawPortrait(g, r.W / 2 - hw + 6, r.H - 76, 38, { zoom: 2.4, turn: .5, bg: [m.teams[side].home.cloth, '#10131f'] }); UI.txt(g, '#' + s.num + '  ' + s.nick, r.W / 2 - hw + 52, r.H - 72, '#fff', { scale: 2 }); UI.txt(g, s.name + ' · ' + m.teams[side].abbr, r.W / 2 - hw + 52, r.H - 54, '#9ab'); if (Math.floor(u * 60) % 10 === 0 && !s.said) { s.said = true; Synth.babble('Number ' + s.num + '! ' + s.name + '!', 'ref', { excl: true }); } if (u > .95) for (const q of m.sk) q.said = false; }\n  function periodCard(g, r, m) { const w = 200, h = 70, x = r.W / 2 - w / 2, y = r.H / 2 - h / 2 + 20; UI.box(g, x, y, w, h, { border: '#ffd36a' }); UI.txt(g, m.ot ? 'END OF OVERTIME' : 'END OF PERIOD ' + m.period, r.W / 2, y + 6, '#ffd36a', { align: 'center', scale: 2 }); UI.txt(g, m.teams[0].abbr + ' ' + m.score[0] + '    ' + m.teams[1].abbr + ' ' + m.score[1], r.W / 2, y + 26, '#fff', { align: 'center', scale: 2 }); UI.txt(g, 'SHOTS ' + m.stats.shots[0] + '-' + m.sta