away' : 'home']) n = ids[(ids.indexOf(n) + d + ids.length) % ids.length]; ex[k] = n; } Synth.sfx('mv'); },\n    go() { const ch = ex.cheat; const cfg = { home: ex.home, away: ex.away, arena: ex.arena, periods: ex.periods, periodLen: ex.len, diff: ex.diff < 0 ? undefined : ex.diff, humans: ex.humans, intros: true, cheats: ch, alwaysKaboom: ch === 'always', bigHeads: ch === 'bigHeads', retro: ch === 'retro' }; Save.get().cheats = { bigHeads: ch === 'bigHeads', retro: ch === 'retro' }; game.go('match', { cfg, ret: 'setup', kind: 'exh' }, { fade: 'wipe' }); },\n    draw(r) { Backdrop.draw(r); r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, 'rgba(5,8,20,.62)'); UI.title(g, 'EXHIBITION', r.W / 2, 8, 3);\n      const cw = 96, ch = 96, gap = 8, x0 = r.W / 2 - (cw * 3 + gap * 2) / 2; ['home', 'arena', 'away'].forEach((k, ci) => { const x = x0 + ci * (cw + gap), foc = this.i === 0 && (this.card || 0) === ci; UI.box(g, x - (foc ? 3 : 0), 34 - (foc ? 3 : 0), cw + (foc ? 6 : 0), ch + (foc ? 6 : 0), { border: foc ? UI.GOLD : '#4a5a8a', bg: foc ? ['#24346a', '#141c3c'] : UI.PANEL });\n        if (k === 'arena') { const a = ARENAS[ex.arena]; px.rect(g, x + 6, 42, cw - 12, 38, a.sky[1]); px.rect(g, x + 6, 62, cw - 12, 18, `rgb(${a.floor.join(',')})`); UI.txt(g, a.name, x + cw / 2, 86, '#fff', { align: 'center' }); UI.txt(g, a.town, x + cw / 2, 98, '#9ab', { align: 'center', font: 'tiny' }); UI.txt(g, 'ARENA', x + cw / 2, 108, UI.GOLD, { align: 'center', font: 'tiny' }); }\n        else { const t = TEAM[ex[k]]; Logo.draw(g, t.id, x + cw / 2, 58, 30); UI.txt(g, t.name.split(' ').slice(-1)[0].toUpperCase(), x + cw / 2, 80, '#fff', { align: 'center', scale: 1 }); const bars = [['SPD', t.skaters.reduce((a, s) => a + s[4][0], 0) / 3], ['SHT', t.skaters.reduce((a, s) => a + s[4][1], 0) / 3], ['HIT', t.skaters.reduce((a, s) => a + s[4][3], 0) / 3], ['GOL', t.rating[0] ]]; bars.forEach(([n, v], bi) => { UI.txt(g, n, x + 8, 92 + bi * 8, '#9ab', { font: 'tiny' }); px.rect(g, x + 28, 93 + bi * 8, 5