le idle timer starts attract mode\", True)\n178:                \"Any key exits attract mode to title\",\n180:                    \"!__game.getState().attract && __game.getState().screen==='menu'\"\n185:                \"Attract replay demonstrates combat, grapple, puzzle and relic\",\n192:            check(\"Attract replay demonstrates successful escape\", demo[\"won\"], demo)\n195:                \"Attract replay loops into a new expedition\",\n196:                loop[\"attract\"] and loop[\"time\"] < 15 and not loop[\"relic\"],\n200:            audio = page.evaluate(\"__game.audioTest()\")\n203:                audio.get(\"supported\")\n204:                and audio.get(\"finite\")\n205:                and audio.get(\"rms\", 0) > 0.001\n206:                and 0 < audio.get(\"peak\", 0) < 1,\n207:                audio,\n273:        except Exception as error:  # noqa: BLE001 - report unexpected test failures\n274:            check(\"Gameplay test execution\", False, str(error))\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst dir=path.dirname(fileURLToPath(import.meta.url));\nconst stem=path.basename(dir);\nconst read=n=>fs.readFileSync(path.join(dir,n),'utf8');\nlet html=read('index.template.html');\nlet main=read('main.js').replace(/^import \\{(?:buildWorld|createAudio,renderAudioTest|createOnline)\\} from '\\.\\/(?:scene|audio|online)\\.js';\\n/gm,'');\nlet feedback={};\ntry{feedback=JSON.parse(fs.readFileSync(path.join(dir,'..','exit-interview.json'),'utf8'));}catch{}\nif(feedback.sourceInformation)main=main.replace(/const metadata=\\{.*?\\};\\n/,()=>`const metadata=${JSON.stringify(feedback.sourceInformation)};\\n`);\nmain=main.replace('/*FEEDBACK*/{}',JSON.stringify({testingFeedback:feedback.testingFeedback,engineFeedback:feedback.engineFeedback,promptFeedback:feedback.promptFeedback}));\n// Scope each module to preserve its private constants in the single-file build.\nconst wrap=(file,names)=>`const {${names}}=(()=>{\\n${read(file).replace(/^import .*;\\n/gm,'').replace(/^export /gm,'')}\\nreturn {${names}};\\n})();\\n`;\nconst externalImports=(read('scene.js').match(/^import .*;$/gm)||[]).join('\\n')+'\\n';\nconst app=externalImports+wrap('scene.js','buildWorld')+wrap('audio.js','createAudio,renderAudioTest')+wrap('online.js','createOnline')+main;\nhtml=html.replace('<!--HUB_SESSION-->',`<script>\\n${read('session.js')}\\n</script>`).replace('/*CSS*/',()=>read('style.css')).replace('/*APP*/',()=>app);\nfor(const name of ['players','mode','minutes','goal','howto'])html=html.replace(`name=\"hub:${name}\"`,`name=\"hub:session-${name}\"`);\nconst out=path.join(dir,'..',stem+'.html');fs.writeFileSync(out,html);\nconsole.log(path.basename(out));\n","exit_code":0,"status":"completed"}}
