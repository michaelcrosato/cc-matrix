{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/scene.js\"","aggregated_output":"// Procedural ink-and-sandstone art. No image or model assets.\nconst C={ink:0x172a27,sand:0xb59b6c,pale:0xe7d3a0,stone:0x927e58,dark:0x4d6556,jade:0x397a67,leaf:0x34654d,leafLight:0x64825a,gold:0xffc65b,red:0xa54f36,blue:0x51827b};\nlet T,cache=new Map();\nfunction material(color,rough=1){const key=color+':'+rough;if(!cache.has(key))cache.set(key,new T.MeshStandardMaterial({color,roughness:rough,flatShading:true,metalness:rough<.5?.4:0}));return cache.get(key);}\nfunction inkMesh(geo,color,parent,x=0,y=0,z=0,outline=true){const mesh=new T.Mesh(geo,material(color));mesh.position.set(x,y,z);mesh.castShadow=true;mesh.receiveShadow=true;parent.add(mesh);if(outline){const line=new T.Mesh(geo,new T.MeshBasicMaterial({color:C.ink,side:T.BackSide}));line.scale.setScalar(1.045);mesh.add(line);}return mesh;}\nfunction box(parent,w,h,d,x,y,z,color=C.sand,outline=true){return inkMesh(new T.BoxGeometry(w,h,d),color,parent,x,y,z,outline);}\nfunction cyl(parent,r1,r2,h,x,y,z,color=C.sand,n=8,outline=true){return inkMesh(new T.CylinderGeometry(r1,r2,h,n),color,parent,x,y,z,outline);}\nfunction ico(parent,r,x,y,z,color=C.sand,detail=0,outline=true){return inkMesh(new T.IcosahedronGeometry(r,detail),color,parent,x,y,z,outline);}\nfunction line(parent,points,color=C.ink,width=.04){const p=points.map(a=>new T.Vector3(...a));const curve=new T.CatmullRomCurve3(p);return inkMesh(new T.TubeGeometry(curve,Math.max(8,points.length*4),width,5,false),color,parent,0,0,0,false);}\nfunction rng(seed=71){return()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;};}\n\nexport function createExplorer(THREE,color=0x965c3b,guard=false){T=THREE;const group=new T.Group();const rig=new T.Group();rig.name='rig';group.add(rig);const jacket=guard?0x526b5d:color,pants=guard?0x334e48:0x4c5346,skin=guard?0xc9946f:0xd9a77a;\nbox(rig,.64,.65,.38,0,1.02,0,jacket);box(rig,.5,.12,.42,0,.73,0,0x463729);box(rig,.13,.16,.04,.08,.76,.235,C.gold);box(rig,.07,.53,.025,0,1.12,.207,0xdbbe85,false);\nconst head=new T.Group();head.name='head';head.position.y=1.47;rig.add(head);box(head,.47,.47,.43,0,.04,0,skin);box(head,.49,.12,.4,0,.22,-.04,0x463729);box(head,.08,.08,.025,-.12,.075,.226,C.ink,false);box(head,.08,.08,.025,.12,.075,.226,C.ink,false);box(head,.07,.09,.09,0,-.015,.248,skin);box(head,.15,.025,.025,.025,-.12,.223,0x674739,false);\nif(guard){cyl(head,.35,.34,.13,0,.30,-.01,0x3c574c,10);box(head,.43,.04,.17,0,.27,.24,0x344a40);}else{cyl(head,.48,.5,.065,0,.30,0,0x78543a,12);cyl(head,.29,.35,.31,0,.47,-.035,0x9b744c,8);cyl(head,.342,.35,.085,0,.35,-.035,0x493b2d,8);}\nconst joints={};for(const [name,x,y]of[['armL',-.43,1.27],['armR',.43,1.27],['legL',-.19,.66],['legR',.19,.66]]){const limb=new T.Group();limb.name=name;limb.position.set(x,y,0);rig.add(limb);joints[name]=limb;const arm=name.startsWith('arm');box(limb,arm?.22:.25,arm?.46:.54,arm?.23:.27,0,arm?-.18:-.22,0,arm?jacket:pants);if(arm)box(limb,.21,.19,.22,0,-.47,0,skin);else box(limb,.27,.17,.42,0,-.56,.075,0x332e24);}\nconst strap=box(rig,.075,.85,.035,-.06,1.13,.225,0x3f3829);strap.rotation.z=-.48;box(rig,.32,.34,.2,-.42,.79,.12,0x9b744b);box(rig,.34,.12,.24,-.42,.94,.135,0xc39b60);\nconst whip=new T.Group();whip.visible=false;whip.name='whip';rig.add(whip);const lash=line(whip,[[.43,.82,.05],[.8,1.0,.6],[1.15,1.05,1.5],[.85,.95,2.6],[.2,.8,3.4]],0xf3d499,.045);lash.add(new T.Mesh(new T.TubeGeometry(new T.CatmullRomCurve3([new T.Vector3(.43,.82,.05),new T.Vector3(.8,1,.6),new T.Vector3(1.15,1.05,1.5),new T.Vector3(.85,.95,2.6),new T.Vector3(.2,.8,3.4)]),24,.075,5,false),new T.MeshBasicMaterial({color:C.ink,side:T.BackSide})));\nconst times=[0,.16,.32,.48,.64];const tracks=(mult=1)=>[['legL',1],['legR',-1],['armL',-1],['armR',1]].map(([name,s])=>new T.NumberKeyframeTrack(name+'.rotation[x]',times,[0,.65*s*mult,0,-.65*s*mult,0]));\nconst idle=new T.AnimationClip('idle',2,[new T.NumberKeyframeTrack('rig.position[y]',[0,1,2],[0,.035,0]),new T.NumberKeyframeTrack('head.rotation[z]',[0,1,2],[-.025,.025,-.025])]);\nconst walk=new T.AnimationClip('walk',.64,tracks());const run=new T.AnimationClip('run',.64,tracks(1.45));\nconst strike=new T.AnimationClip('whip',.38,[new T.NumberKeyframeTrack('armR.rotation[x]',[0,.12,.23,.38],[0,-2,-.6,0]),new T.NumberKeyframeTrack('rig.rotation[y]',[0,.12,.24,.38],[0,-.45,.35,0])]);\nconst hurt=new T.AnimationClip('hurt',.3,[new T.NumberKeyframeTrack('rig.rotation[z]',[0,.08,.2,.3],[0,-.18,.1,0])]);\nconst mixer=new T.AnimationMixer(group),actions={};for(const clip of[idle,walk,run,strike,hurt]){actions[clip.name]=mixer.clipAction(clip);if(clip.name==='whip'||clip.name==='hurt'){actions[clip.name].setLoop(T.LoopOnce,1);actions[clip.name].clampWhenFinished=false;}}actions.idle.play();\nconst shadow=new T.Mesh(new T.CircleGeometry(.52,16),new T.MeshBasicMaterial({color:0x13231c,transparent:true,opacity:.35,depthWrite:false}));shadow.rotation.x=-Math.PI/2;shadow.position.y=.025;group.add(shadow);\nreturn{group,mixer,actions,whip,joints,rig};}\n\nexport function buildWorld(THREE,scene){T=THREE;cache=new Map();const random=rng();const root=new T.Group();scene.add(root);scene.background=new T.Color(0x172f2b);scene.fog=new T.Fog(0x172f2b,44,100);const solidBoxes=[],torches=[],foliage=[];\nconst hemi=new T.HemisphereLight(0xf3e6bf,0x1d4943,2.1);scene.add(hemi);const sun=new T.DirectionalLight(0xffd5a0,3.4);sun.position.set(-12,28,9);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-35;sun.shadow.camera.right=35;sun.shadow.camera.top=35;sun.shadow.camera.bottom=-35;sun.shadow.camera.far=90;sun.shadow.bias=-.001;scene.add(sun);const fill=new T.DirectionalLight(0x73bba9,1.5);fill.position.set(15,12,-35);scene.add(fill);\nbox(root,23,.8,59,0,-.5,-16,C.ink,false);\nfor(let row=0;row<28;row++)for(let col=0;col<10;col++){const x=(col-4.5)*2.06,z=11-row*2.02;const broken=random()<.09;const tile=box(root,2.00,.16,1.96,x,-.04+(broken?-.04:0),z,[0xa58e60,0xb49c6c,0xc2aa76,0xb9a071][Math.floor(random()*4)],false);if(broken)tile.rotation.y=(random()-.5)*.05;}\n// The ink-colored mortar makes the pavers read as an illustrated map.\nfor(let z=10;z>-44;z-=4){box(root,.07,.018,1.1,-2.5,.06,z,0x6d7854,false);box(root,.07,.018,1.1,2.5,.06,z,0x6d7854,false);}\nfor(let side of[-1,1]){for(let z=10;z>-44;z-=2.1){const h=.45+random()*.4;box(root,.7,h,2,side*10.5,h/2-.03,z,0x78805a);if(random()<.4){const rock=ico(root,.6+random()*.7,side*(11.5+random()*2),-.6-random(),z,C.dark);rock.scale.set(1,1.5,1);}}box(root,5,1.8,61,side*14,-2,-16,0x143c33,false);}\nfunction fern(x,z,s=1){const g=new T.Group();g.position.set(x,.12,z);g.scale.setScalar(s);root.add(g);for(let k=0;k<7;k++){const leaf=inkMesh(new T.ConeGeometry(.25,1.7,3),k%2?C.leaf:C.leafLight,g,Math.sin(k*2.4)*.45,.5,Math.cos(k*2.4)*.45,false);leaf.rotation.set(Math.cos(k*2.4)*.7,k*2.4,Math.sin(k*2.4)*.7);}foliage.push(g);return g;}\nfor(let i=0;i<65;i++)fern((i%2?1:-1)*(8.6+random()*3),10-random()*53,.7+random()*.8);\nfunction glyph(parent,kind,x,y,z,s=.5,color=C.gold){const g=new T.Group();g.position.set(x,y,z);g.scale.setScalar(s);parent.add(g);if(kind===0){const ring=inkMesh(new T.TorusGeometry(.46,.065,4,12),color,g,0,0,0,false);for(let i=0;i<8;i++){const a=i*Math.PI/4;const p=box(g,.08,.24,.04,Math.sin(a)*.78,Math.cos(a)*.78,0,color,false);p.rotation.z=-a;}}else if(kind===1){line(g,[[-.5,-.6,0],[.42,-.35,0],[-.4,.05,0],[.42,.4,0],[0,.65,0]],color,.085);ico(g,.16,.05,.66,0,color,0,false);}else{const ring=inkMesh(new T.TorusGeometry(.48,.12,4,14,Math.PI*1.5),color,g,0,0,0,false);ring.rotation.z=.7;ico(g,.12,.55,.55,0,color,0,false);}return g;}\nfunction column(x,z,h=5){const g=new T.Group();g.position.set(x,0,z);root.add(g);box(g,1.6,.3,1.6,0,.15,0,0x7e7754);box(g,1.35,.3,1.35,0,.45,0,C.pale);cyl(g,.49,.64,h-.95,0,(h-.95)/2+.6,0,C.sand,8);for(let yy=1.05;yy<h-.5;yy+=.72){cyl(g,.57,.57,.12,0,yy,0,0x756e4a,8);}box(g,1.4,.25,1.4,0,h-.25,0,C.pale);box(g,1.75,.25,1.7,0,h,0,C.sand);solidBoxes.push({x,z,w:1.35,d:1.35,h});return g;}\nfor(const z of[7,0,-7,-15,-25,-33,-41])for(let side of[-1,1]){const h=(z===-7||z===-25)?5.8:3.4+random()*1.5;const g=column(side*8.2,z,h);if(z%2!==0)line(g,[[.3,h,.3],[-.2,h*.7,.55],[.4,h*.4,.6],[-.2,.2,.7]],C.leaf,.12);}\n// Monumental gateway into the inner temple.\nfor(const z of[-7,-27]){const h=z===-7?6.2:5.7;box(root,18.3,.8,2,0,h,z,C.sand);box(root,18.7,.22,2.3,0,h+.49,z,C.pale);for(let i=-6;i<=6;i+=2){box(root,1.6,.48,.14,i,h,z+1.07,0x786b4c);glyph(root,(i+6)%3,i,h,z+1.16,.22,C.pale);}for(let side of[-1,1]){const head=ico(root,1.05,side*7.8,h-1.15,z+.25,0xc3a571,1);head.scale.set(.9,1.2,.75);box(root,.24,.20,.12,side*7.8-.3,h-1,z+1.01,C.ink,false);box(root,.24,.20,.12,side*7.8+.3,h-1,z+1.01,C.ink,false);box(root,.25,.43,.25,side*7.8,h-1.4,z+1.08,C.pale);}}\nfunction torch(x,z){const g=new T.Group();g.position.set(x,0,z);root.add(g);cyl(g,.45,.6,.25,0,.15,0,0x59664c);cyl(g,.15,.23,1.3,0,.87,0,0x5a4834);cyl(g,.48,.2,.35,0,1.5,0,0x584938);const flame=inkMesh(new T.ConeGeometry(.28,.9,5),0xffba46,g,0,2,0,false);const inner=inkMesh(new T.ConeGeometry(.14,.6,4),0xffe8a0,g,0,1.95,.06,false);const glow=new T.PointLight(0xffa54b,5,8,2);glow.position.set(x,2.4,z);scene.add(glow);torches.push({group:g,flame,inner,light:glow,seed:random()*10});}\nfor(let z of[6,-5,-13,-24,-32,-40])for(let x of[-6.9,6.9])torch(x,z);\n// Broken lintels, fallen slabs, pottery, and ancient ink carvings.\nfor(let i=0;i<30;i++){const side=i%2?1:-1,x=side*(7.3+random()*1.5),z=9-random()*50;const rock=box(root,.4+random(),.2+random()*.5,.4+random(),x,.15,z,random()<.5?C.stone:C.sand);rock.rotation.y=random()*3;rock.rotation.z=(random()-.5)*.4;}\nfor(let side of[-1,1])for(let z of[4,-12,-31]){const pot=cyl(root,.32,.45,.75,side*6.1,.42,z,side===1?0xa15d3d:0x697f68,8);cyl(root,.24,.34,.1,side*6.1,.83,z,0xe3bf7c,8);cyl(root,.19,.19,.015,side*6.1,.89,z,C.ink,8,false);}\n// Entry expedition camp and the return landmark.\nbox(root,4.4,.18,1.1,0,.12,10.4,0xc7b582);for(let x of[-1.7,1.7]){cyl(root,.06,.06,3.4,x,1.7,11,0x6f6142,6);}\nconst banner=box(root,3.5,.8,.04,0,2.7,11,0xad6c42);box(root,1.3,.11,.07,0,2.72,11.04,C.pale,false);box(root,1.3,.11,.07,0,2.47,11.04,C.pale,false);\nfor(let i=0;i<3;i++){const crate=box(root,1,.8,.9,-4.7+i*.95,.4,9+i%2*.5,0x7c6343);box(root,1.05,.1,.95,-4.7+i*.95,.5,9+i%2*.5,0xc2a16e);}\n// Room boundaries are framed with low parapets rather than opaque walls.\nfor(let z of[-9,-26])for(let side of[-1,1]){box(root,4.4,1.35,.7,side*8, .67,z,C.stone);box(root,4.8,.18,.9,side*8,1.43,z,C.pale);}\n// Three-face astronomical tumblers. Front-facing symbols at rotation 0, 2π/3, 4π/3.\nconst puzzle=[];for(let i=0;i<3;i++){const x=[-5,0,5][i],z=-21;const group=new T.Group();group.position.set(x,0,z);root.add(group);cyl(root,1.05,1.15,.25,x,.15,z,0x626e50,8);cyl(group,.7,.85,2.3,0,1.4,0,0x887c58,3);cyl(group,.95,.75,.25,0,2.7,0,C.pale,6);cyl(group,.9,.9,.15,0,.3,0,C.gold,6);for(let k=0;k<3;k++){const face=new T.Group();face.rotation.y=k*Math.PI*2/3;group.add(face);box(face,.9,1.1,.1,0,1.58,.51,0x284e43);glyph(face,k,0,1.58,.58,.44,C.pale);}puzzle.push({group,x,z,value:0});}\n// Puzzle clue: sun, crescent, serpent arranged in carved plaques.\nconst clue=new T.Group();clue.position.set(0,0,-16.9);root.add(clue);box(clue,5.9,.17,1.5,0,.17,0,0x5f7053);for(let i=0;i<3;i++){const p=new T.Group();p.position.set((i-1)*1.8,.28,0);p.rotation.x=-Math.PI/2;clue.add(p);box(p,1.3,1,.07,0,0,0,0x263f35);glyph(p,[0,2,1][i],0,0,.05,.38,C.pale);}\nconst gate=new T.Group();gate.position.set(0,0,-27);root.add(gate);for(let i=-5;i<=5;i++){box(gate,.17,4.8,.22,i*.86,2.4,0,0x52604b);ico(gate,.15,i*.86,.08,0,C.gold,0);}box(gate,9,.25,.4,0,4.5,0,0x8d8457);box(gate,9,.2,.4,0,1.1,0,0x8d8457);\n// The reliquary: gold against jade, with a deliberately ominous floor mosaic.\nfor(let j=0;j<3;j++)box(root,5.8-j*1.0,.2,5.1-j*.8,0,.10+j*.18,-37,C.stone);cyl(root,1.1,1.35,.5,0,.83,-37,C.sand,8);cyl(root,1.35,1.1,.18,0,1.17,-37,C.pale,8);const relic=new T.Group();relic.position.set(0,1.5,-37);root.add(relic);box(relic,1.25,.64,.8,0,.17,0,C.gold);box(relic,1.5,.14,1.0,0,.55,0,0xffdf87);box(relic,1.5,.14,1.0,0,-.22,0,0xb18435);for(let side of[-1,1]){const wing=new T.Group();wing.position.set(side*.5,.64,0);wing.rotation.z=-side*.5;relic.add(wing);for(let j=0;j<4;j++)box(wing,.17,.55-j*.06,.13,side*j*.12,j*.07,0,0xffdf87);ico(relic,.17,side*.38,.66,0,0xffd27b,1);}const halo=new T.PointLight(0xffc05a,9,9,2);halo.position.set(0,3,-37);scene.add(halo);\nfor(let i=0;i<12;i++){const a=i*Math.PI/6;const piece=box(root,.7,.04,1.2,Math.sin(a)*3.3,.58,-37+Math.cos(a)*2.8,i%2?0x315e4e:0xc7b57c,false);piece.rotation.y=a;}\n// Guardian relief, visible above the relic from the gameplay camera.\nbox(root,10,4,1.2,0,2,-43,0x536d55);box(root,10.8,.3,1.6,0,4.1,-43,C.sand);const mask=ico(root,2.25,0,3.2,-42.1,C.sand,1);mask.scale.set(1.1,1.1,.35);for(let side of[-1,1]){box(root,.75,.3,.14,side*.85,3.65,-41.3,C.ink,false);box(root,.4,.15,.17,side*.85,3.69,-41.2,C.gold,false);}box(root,.5,1,.6,0,3,-41.3,C.pale);box(root,1.4,.25,.15,0,2.25,-41.2,C.ink,false);\nconst boulder=new T.Group();boulder.position.set(0,2.2,-40);boulder.visible=false;root.add(boulder);const sphere=ico(boulder,2.45,0,0,0,0x8e8a63,1);for(let i=0;i<7;i++){const band=new T.Mesh(new T.TorusGeometry(2.43,.045,4,24),material(C.ink));band.rotation.set(random()*3,random()*3,random()*3);boulder.add(band);}\nconst player=createExplorer(T);player.group.position.set(0,0,7);scene.add(player.group);const partner=createExplorer(T,0x427b79);partner.group.position.set(1.4,0,7);partner.group.visible=false;scene.add(partner.group);\nconst enemies=[];for(let i=0;i<8;i++){const x=[-3.5,3.6,-1,4,-5,5,-3,3][i],z=[2,-1,-5,-6,-12,-14,-18,-24][i];if(i<5){const e=createExplorer(T,0x526b5d,true);e.group.position.set(x,0,z);e.group.rotation.y=Math.PI;scene.add(e.group);enemies.push({...e,hp:2,type:'guard',x,z,homeX:x,homeZ:z});}else{const group=new T.Group();group.position.set(x,0,z);scene.add(group);for(let j=0;j<7;j++){const bead=ico(group,.19,j*.24-.7,.18,Math.sin(j*.7)*.15,j%2?0x485d3b:0x899550,0);bead.name='segment'+j;}const head=ico(group,.28,.84,.25,.04,0x899550,1);head.scale.set(1.4,.7,1);box(group,.055,.055,.02,.92,.31,.22,C.ink,false);box(group,.055,.055,.02,.75,.31,.22,C.ink,false);const mixer=new T.AnimationMixer(group),actions={};const tr=[];for(let j=0;j<7;j++)tr.push(new T.NumberKeyframeTrack('segment'+j+'.position[z]',[0,.3,.6],[Math.sin(j*.7)*.15,Math.sin(j*.7+Math.PI)*.15,Math.sin(j*.7)*.15]));actions.walk=mixer.clipAction(new T.AnimationClip('slither',.6,tr));actions.idle=actions.walk;actions.run=actions.walk;actions.walk.play();enemies.push({group,mixer,actions,hp:2,type:'snake',x,z,homeX:x,homeZ:z});}}\nconst pickups=[];for(let i=0;i<9;i++){const x=[-4,5,0,-6,6,-3,4,-5,5][i],z=[5,2,-4,-11,-16,-25,-30,-33,-39][i];const group=new T.Group();group.position.set(x,.4,z);root.add(group);const gem=inkMesh(new T.OctahedronGeometry(.25),i%3===0?0xe89367:C.gold,group,0,0,0);pickups.push({group,x,z,type:i%3===0?'health':'coin',collected:false});}\nconst motesGeo=new T.BufferGeometry(),motesPos=new Float32Array(180*3);for(let i=0;i<180;i++){motesPos[i*3]=(random()-.5)*21;motesPos[i*3+1]=.5+random()*6;motesPos[i*3+2]=11-random()*54;}motesGeo.setAttribute('position',new T.BufferAttribute(motesPos,3));const motes=new T.Points(motesGeo,new T.PointsMaterial({color:0xffd89b,size:.065,transparent:true,opacity:.6,depthWrite:false}));root.add(motes);\nfunction update(time,dt){for(const q of torches){const f=1+Math.sin(time*11+q.seed)*.12+Math.sin(time*19+q.seed)*.06;q.flame.scale.set(1/f,f,1/f);q.inner.scale.y=1.1-f*.25;q.light.intensity=4.6+f*.6;}for(let i=0;i<foliage.length;i++){foliage[i].rotation.z=Math.sin(time*.7+i)*.025;}for(const p of pickups){if(!p.collected){p.group.rotation.y=time*1.7;p.group.position.y=.55+Math.sin(time*2.5+p.z)*.12;}}relic.rotation.y=Math.sin(time*.65)*.07;halo.intensity=relic.visible?8+Math.sin(time*2)*1.5:0;for(let i=0;i<180;i++){motesPos[i*3+1]+=.002+dt*.025;if(motesPos[i*3+1]>6.7)motesPos[i*3+1]=.5;}motesGeo.attributes.position.needsUpdate=true;}\nreturn{root,player,partner,enemies,relic,gate,boulder,puzzle,pickups,torches,solidBoxes,update,clue,lights:{sun,hemi,fill},bounds:{minX:-10,maxX:10,minZ:-43,maxZ:11}};\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/integration-notes.md && sed -n '1,160p' Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/integration-notes.md && sed -n '1,160p' Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/harness.html\"","aggregated_output":"AI Hub Session Protocol v1, exact session.js client 1.4.0 downloaded from the user-specified repository. No general internet research was performed.\n\nBundle session.js unchanged as the first script in head immediately after meta charset. Include hub:session=1, hub:session-players=1-2, hub:session-mode=shared-world and goal/howto/minutes metadata. WebGPU requires hub:webgpu=required if there is no fallback.\n\ncreateOnline(callbacks) exposes init() → info/null; ready() after renderer/world load; finish({won,score,stats}); sendState(state) at host; sendInput(input) at guest; createRoom() → six-character code; joinRoom(code); leave(); destroy(). Getters: hub, role (solo/host/guest), room, connected, me, players, server, ended, canPlay.\n\nCallbacks: onState(state,from), onInput(input,from), onStatus(message,details), onStart({role,room,me,players,server,hub}), onEnd(reason), onLeave(id), optional onTimeUp() or getResult() returning {won,score,stats}. Host authoritative: only the host advances physics, AI and mission state. Guest sends local input and renders snapshots. Server host has no player of its own: enumerate players and never bind a local input to a player when server=true. AI Hub readiness takes no user gesture. Gate play on canPlay (synchronized start countdown), skip title/attract in hub, and stop audio/input in onEnd. Ignore controller Options while Create is held in hub. Restart/quit must have no effect in hub.\n\nState/input are throttled independently to 12.5 Hz, comfortably within the hub's 20 messages/s limit; messages under 15 KB only. Reliable packets preserve button edge inputs if input code latches them until sent. Root should consume action inputs once per sequence or send held action state with game cooldowns.\n\nStandalone rooms use BroadcastChannel when both pages share an origin and PeerJS 1.5.5 WebRTC across devices; PeerJS is loaded only on standalone room creation/join, never in AI Hub. Public PeerJS signaling needs internet. Leaving a host voids an AI Hub round through the hub; standalone host can continue solo after guest departure. Guest returns to title on host departure.\n\nHarness files are in this development folder. Serve this folder or copy harness.html/bridge.js/round.js next to bundled HTML. Test harness.html?game=GAME.html&players=2&auto=1, plus players=2&scenario=server, players=2&scenario=host-leave and players=2&latency=150&jitter=50&loss=5&auto=1. Success: window.__hubCheck.pass === true and body.dataset.complete === 'true'. Read __hubCheck for failures.\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n","exit_code":0,"status":"completed"}}
