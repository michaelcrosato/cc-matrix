{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,235p' Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/online.js && sed -n '1,35p' Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/audio.js\"","aggregated_output":"/* Lost Fortune networking. AI Hub owns every connection while embedded. */\nexport function createOnline(callbacks = {}) {\n  const cb = Object.assign({onState(){},onInput(){},onStatus(){},onStart(){},onEnd(){},onLeave(){}}, callbacks);\n  const client = window.AIHub;\n  let hub = !!client?.active, role = 'solo', room = '', me = 0, players = [{id:0,name:'Dr. Vale',color:'#e8b95f'}];\n  let connected = false, server = false, ended = false, started = !hub, loaded = false, reported = false;\n  let initPromise, startTimer, heartbeat, joinTimer, channel, peer, connection, transport = '', instance = makeCode(12), partner = '', lastState;\n  let stateAt = -Infinity, inputAt = -Infinity, lastSeen = 0, lastSequence = -1, sequence = 0, peerLoader;\n  const cleanup = [], timers = new Set();\n  const status = (message, extra = {}) => cb.onStatus(message, {role,room,connected,me,players,hub,server,...extra});\n  function makeCode(n = 6) {\n    const bytes = new Uint8Array(n); crypto.getRandomValues(bytes);\n    return Array.from(bytes, x => 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[x % 32]).join('');\n  }\n  function callStart() {\n    if (ended || started && hub) return;\n    started = true;\n    cb.onStart({role,room,me,players,server,hub});\n  }\n  function finitePayload(value) {\n    try { const text = JSON.stringify(value); return text && text.length < 15000 ? JSON.parse(text) : null; }\n    catch { return null; }\n  }\n  function receive(message, from) {\n    if (ended || !message || message.protocol !== 'lost-fortune-1') return;\n    if (message.type === 'input' && role === 'host' && players.some(p => p.id === from) && from !== me) {\n      cb.onInput(message.value, from);\n    } else if (message.type === 'state' && role === 'guest' && from === (hub ? client.host : 0)) {\n      if (typeof message.seq === 'number' && message.seq <= lastSequence) return;\n      lastSequence = message.seq; cb.onState(message.value, from);\n    } else if (message.type === 'finished' && !hub && role === 'guest') {\n      cb.onState(message.value, from);\n    }\n  }\n  function send(type, value) {\n    if (ended || !connected) return false;\n    const clean = finitePayload(value); if (clean === null) return false;\n    const message = {protocol:'lost-fortune-1', type, value:clean, seq:sequence++};\n    if (hub) return client.send(message, type === 'input' ? {to:client.host,reliable:true} : {reliable:true});\n    if (transport === 'local') { channel?.postMessage({kind:'data',instance,from:me,message}); return true; }\n    if (transport === 'rtc' && connection?.open) { connection.send(message); return true; }\n    return false;\n  }\n  async function init() {\n    if (initPromise) return initPromise;\n    initPromise = (async () => {\n      if (!hub) return null;\n      cleanup.push(client.on('message', receive));\n      cleanup.push(client.on('start', detail => {\n        started = false;\n        const begin = () => {\n          if (ended) return;\n          if (client.time() >= 0) callStart();\n          else startTimer = setTimeout(begin, Math.min(100, Math.max(1, -client.time())));\n        };\n        status('The expedition starts in a moment.'); begin();\n      }));\n      cleanup.push(client.on('leave', ({id}) => {\n        players = players.filter(p => p.id !== id); cb.onLeave(id); status('An explorer left the expedition.');\n      }));\n      cleanup.push(client.on('time-up', () => {\n        if (role !== 'host' || ended || reported) return;\n        let outcome;\n        try { outcome = cb.onTimeUp?.() || cb.getResult?.(); } catch { outcome = null; }\n        finish(outcome || {won:false,score:Number(lastState?.score)||0});\n      }));\n      cleanup.push(client.on('end', ({reason}) => {\n        ended = true; started = false; clearTimeout(startTimer); cb.onEnd(reason); status('The expedition has ended.');\n      }));\n      const info = await client.connect({mode:'shared-world',seats:[1,2]});\n      if (!info) { hub = false; started = true; return null; }\n      role = info.isHost ? 'host' : 'guest'; me = info.me; players = info.players; server = !!info.server; connected = true;\n      status(server ? 'The expedition host is ready.' : 'Connected to AI Hub.');\n      if (loaded) client.ready();\n      return info;\n    })();\n    return initPromise;\n  }\n  function ready() { loaded = true; if (hub && connected && !ended) client.ready(); }\n  function finish(outcome = {}) {\n    if (ended || reported) return;\n    reported = true;\n    if (hub && role === 'host') {\n      const ids = players.map(p => p.id), score = Number(outcome.score)||0;\n      const scores = Object.fromEntries(ids.map(id => [id,score]));\n      const stats = Object.fromEntries(ids.map(id => [id,outcome.stats || {Fortune:score}]));\n      client.finish({standings:[ids],scores,won:!!outcome.won,stats});\n    }\n  }\n  function clearStandalone() {\n    clearInterval(heartbeat); clearTimeout(joinTimer); heartbeat = null; joinTimer = null;\n    for (const timer of timers) clearTimeout(timer); timers.clear();\n    channel?.close(); channel = null;\n    connection?.close(); connection = null;\n    peer?.destroy(); peer = null;\n    connected = false; transport = ''; partner = ''; lastSequence = -1;\n  }\n  function loadPeer() {\n    if (window.Peer) return Promise.resolve(window.Peer);\n    if (peerLoader) return peerLoader;\n    peerLoader = new Promise((resolve,reject) => {\n      const script = document.createElement('script');\n      script.src = 'https://cdn.jsdelivr.net/npm/peerjs@1.5.5/dist/peerjs.min.js';\n      script.onload = () => window.Peer ? resolve(window.Peer) : reject(new Error('The room service could not start.'));\n      script.onerror = () => reject(new Error('The room service is unavailable. Same-browser rooms still work.'));\n      document.head.appendChild(script);\n    });\n    return peerLoader;\n  }\n  function acceptRemote(kind) {\n    if (ended || connected) return;\n    connected = true; transport = kind; started = true; lastSeen = performance.now();\n    players = [{id:0,name:'Dr. Vale',color:'#e8b95f'},{id:1,name:'Kit Mercer',color:'#5fd7ca'}];\n    clearTimeout(joinTimer);\n    if (kind === 'local') { connection?.close(); connection = null; peer?.destroy(); peer = null; }\n    status('Partner connected. Two hats. One terrible idea.');\n    cb.onStart({role,room,me,players,server:false,hub:false});\n  }\n  function localMessage(event) {\n    const data = event.data;\n    if (!data || data.instance === instance || ended) return;\n    if (partner && data.instance !== partner) return;\n    if (data.kind === 'hello' && role === 'host') {\n      if (connected && transport !== 'local') return;\n      partner = data.instance; channel.postMessage({kind:'welcome',instance,to:data.instance}); acceptRemote('local');\n    } else if (data.kind === 'welcome' && role === 'guest' && data.to === instance) {\n      partner = data.instance; acceptRemote('local');\n    } else if (data.kind === 'ping' && connected && transport === 'local') {\n      lastSeen = performance.now();\n    } else if (data.kind === 'data' && connected && transport === 'local') {\n      lastSeen = performance.now(); receive(data.message, data.from);\n    } else if (data.kind === 'leave' && connected && transport === 'local') {\n      disconnectPartner();\n    }\n  }\n  function disconnectPartner() {\n    if (!connected || hub) return;\n    connected = false; transport = ''; partner = ''; cb.onLeave(role === 'host' ? 1 : 0);\n    players = [{id:me,name:role === 'host'?'Dr. Vale':'Kit Mercer',color:role === 'host'?'#e8b95f':'#5fd7ca'}];\n    status(role === 'host' ? 'Your partner left. The expedition can continue solo.' : 'The host left. Return to the title to join another room.');\n  }\n  function beginLocal() {\n    try { channel = new BroadcastChannel('lost-fortune-room-'+room); channel.onmessage = localMessage; }\n    catch { channel = null; }\n    heartbeat = setInterval(() => {\n      if (ended) return;\n      if (connected && transport === 'local') {\n        channel?.postMessage({kind:'ping',instance});\n        if (performance.now()-lastSeen > 12000) disconnectPartner();\n      } else if (!connected && role === 'guest') channel?.postMessage({kind:'hello',instance});\n    }, 500);\n    if (role === 'guest') channel?.postMessage({kind:'hello',instance});\n  }\n  function wireConnection(conn) {\n    conn.on('open', () => {\n      if (connected && transport !== 'rtc') { conn.close(); return; }\n      connection = conn; acceptRemote('rtc');\n    });\n    conn.on('data', message => { if (transport === 'rtc') receive(message,role==='host'?1:0); });\n    conn.on('close', () => { if (transport === 'rtc') disconnectPartner(); });\n    conn.on('error', () => { if (transport === 'rtc') disconnectPartner(); });\n  }\n  async function beginRTC(expectedRoom, expectedRole) {\n    try {\n      const Peer = await loadPeer();\n      if (hub || room !== expectedRoom || role !== expectedRole || connected || ended) return;\n      peer = role === 'host' ? new Peer('lost-fortune-'+room) : new Peer();\n      peer.on('open', () => {\n        if (role === 'guest' && !connected) wireConnection(peer.connect('lost-fortune-'+room,{reliable:true,serialization:'json'}));\n      });\n      peer.on('connection', conn => {\n        if (role !== 'host' || connected) { conn.close(); return; }\n        wireConnection(conn);\n      });\n      peer.on('error', error => {\n        if (!connected) status(error?.type === 'unavailable-id' ? 'That room is already in use. Create a fresh room.' : 'Room service unavailable or room not found. Check the code and try again.');\n      });\n    } catch (error) { if (!connected && room === expectedRoom) status(error.message); }\n  }\n  async function createRoom() {\n    if (hub) return null;\n    clearStandalone(); role = 'host'; me = 0; room = makeCode(); ended = false; reported = false; started = false;\n    players = [{id:0,name:'Dr. Vale',color:'#e8b95f'}];\n    beginLocal(); status('Room '+room+' — share this code with your partner.');\n    beginRTC(room,role); return room;\n  }\n  async function joinRoom(value) {\n    if (hub) return false;\n    const code = String(value||'').toUpperCase().replace(/[^A-Z0-9]/g,'');\n    if (code.length !== 6) { status('Enter the six-character room code.'); return false; }\n    clearStandalone(); role = 'guest'; me = 1; room = code; ended = false; reported = false; started = false;\n    players = [{id:1,name:'Kit Mercer',color:'#5fd7ca'}];\n    beginLocal(); status('Looking for room '+room+'…');\n    const timer = setTimeout(() => { timers.delete(timer); beginRTC(room,role); },700); timers.add(timer);\n    joinTimer = setTimeout(() => { if (!connected) status('No expedition found. Check the room code and try again.'); },20000);\n    return true;\n  }\n  function leave() {\n    if (hub) return false;\n    if (connected && transport === 'local') channel?.postMessage({kind:'leave',instance});\n    clearStandalone(); role = 'solo'; room = ''; me = 0; server = false; ended = false; started = true; reported = false;\n    players = [{id:0,name:'Dr. Vale',color:'#e8b95f'}]; status('Solo expedition.'); return true;\n  }\n  return {\n    init,ready,createRoom,joinRoom,leave,finish,\n    sendState(state) {\n      lastState = state;\n      if (role !== 'host' || performance.now()-stateAt < 80) return false;\n      stateAt = performance.now(); return send('state',state);\n    },\n    sendInput(input) {\n      if (role !== 'guest' || performance.now()-inputAt < 80) return false;\n      inputAt = performance.now(); return send('input',input);\n    },\n    get hub(){return hub;}, get role(){return role;}, get room(){return room;}, get connected(){return connected;},\n    get me(){return me;},get players(){return players;},get server(){return server;},get ended(){return ended;},\n    get canPlay(){return !ended && (hub ? connected && client.time()>=0 : started);},\n    destroy(){ if (!hub) clearStandalone(); clearTimeout(startTimer); for (const remove of cleanup) remove(); }\n  };\n}\n// All sounds are synthesized here. No audio assets, samples, or speech services.\nconst clamp = (x, a, b) => Math.min(b, Math.max(a, Number(x) || 0));\nconst midi = n => 440 * 2 ** ((n - 69) / 12);\nconst MUSIC_DEFAULT = .10;\n\nfunction makeGraph(context, destination, initialMusic = MUSIC_DEFAULT, initialSfx = .68) {\n  const master = context.createGain(); master.gain.value = .8;\n  const music = context.createGain(); music.gain.value = initialMusic;\n  const fx = context.createGain(); fx.gain.value = initialSfx;\n  const ambient = context.createGain(); ambient.gain.value = .13;\n  const compressor = context.createDynamicsCompressor();\n  compressor.threshold.value = -13; compressor.knee.value = 12; compressor.ratio.value = 6;\n  compressor.attack.value = .003; compressor.release.value = .16;\n  const analyser = context.createAnalyser(); analyser.fftSize = 1024;\n  music.connect(master); fx.connect(master); ambient.connect(master);\n  master.connect(compressor); compressor.connect(analyser); analyser.connect(destination);\n  let seed = 271828183, active = 0, notes = 0;\n  const random = () => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed / 4294967296; };\n  const noiseBuffer = context.createBuffer(1, context.sampleRate * 2, context.sampleRate);\n  const noiseData = noiseBuffer.getChannelData(0);\n  let brown = 0;\n  for (let i = 0; i < noiseData.length; i++) {\n    brown = (brown + (random() * 2 - 1) * .045) / 1.045;\n    noiseData[i] = (random() * 2 - 1) * .64 + brown * 1.9;\n  }\n  function disposeAtEnd(source, nodes) {\n    active++; source.onended = () => { active--; for (const node of nodes) { try { node.disconnect(); } catch {} } };\n  }\n  function tone({ frequency = 440, end = frequency, duration = .2, gain = .2, type = 'sine', bus = fx, at = context.currentTime, attack = .005, detune = 0, filter = 0 }) {\n    at = Math.max(context.currentTime, at);\n    const oscillator = context.createOscillator(); oscillator.type = type;\n    const envelope = context.createGain();\n    oscillator.frequency.setValueAtTime(Math.max(12, frequency), at);\n    oscillator.frequency.exponentialRampToValueAtTime(Math.max(12, end), at + duration);\n    oscillator.detune.value = detune;\n","exit_code":0,"status":"completed"}}
