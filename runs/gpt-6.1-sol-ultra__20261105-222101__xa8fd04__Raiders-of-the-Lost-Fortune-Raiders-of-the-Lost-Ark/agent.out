{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,90p' Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/tests/gameplay.py && sed -n '1,70p' Raiders-of-the-Lost-Fortune-Raiders-of-the-Lost-Ark-gpt-6.1-sol-ultra-20261105-222101/tests/hub.py\"","aggregated_output":"\"\"\"Deterministic game checks plus real keyboard, standard gamepad and touch input.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nGAME = ROOT / (DEV.name + \".html\")\n\n\ndef run_checks():\n    failures = []\n    count = 0\n\n    def check(label, passed, detail=\"\"):\n        nonlocal count\n        count += 1\n        if not passed:\n            failures.append(label + (\": \" + str(detail) if detail else \"\"))\n\n    with sync_playwright() as playwright:\n        browser = playwright.chromium.launch(\n            headless=True,\n            args=[\n                \"--enable-unsafe-webgpu\",\n                \"--enable-features=Vulkan\",\n                \"--use-webgpu-adapter=swiftshader\",\n                \"--ignore-certificate-errors\",\n                \"--disable-dev-shm-usage\",\n                \"--autoplay-policy=no-user-gesture-required\",\n            ],\n        )\n        context = browser.new_context(viewport={\"width\": 1280, \"height\": 900})\n        page = context.new_page()\n        errors = []\n        page.on(\"pageerror\", lambda error: errors.append(str(error)))\n        try:\n            page.goto(GAME.as_uri(), wait_until=\"domcontentloaded\", timeout=60000)\n            page.wait_for_function(\n                \"window.__game?.ready || window.__game?.error\", timeout=120000\n            )\n            check(\n                \"Single-file game boots\",\n                page.evaluate(\"window.__game.ready\"),\n                page.evaluate(\"window.__game.error\"),\n            )\n            if not page.evaluate(\"window.__game.ready\"):\n                return count, failures\n            check(\n                \"Required engine versions and actual WebGPU\",\n                page.evaluate(\n                    \"__game.engine.three === '180' && __game.engine.physics === '0.19.3' && __game.engine.backend === 'WebGPU'\"\n                ),\n                page.evaluate(\"__game.engine\"),\n            )\n            check(\n                \"Title screen is the expected game\",\n                \"RAIDERS\" in page.locator(\"h1\").inner_text()\n                and \"LOST FORTUNE\" in page.locator(\"h1\").inner_text(),\n            )\n            page.locator(\"#begin\").click()\n            initial_z = page.evaluate(\"__game.getState().actors[0].z\")\n            page.keyboard.down(\"w\")\n            page.wait_for_timeout(650)\n            page.keyboard.up(\"w\")\n            check(\n                \"Real keyboard W moves north\",\n                page.evaluate(\"__game.getState().actors[0].z\") < initial_z - 0.1,\n            )\n            page.keyboard.press(\"Escape\")\n            check(\n                \"Escape pauses simulation\",\n                page.evaluate(\n                    \"__game.getState().screen==='pause' && !__game.getState().running\"\n                ),\n            )\n            paused_time = page.evaluate(\"__game.getState().time\")\n            page.wait_for_timeout(150)\n            check(\n                \"Paused world clock is frozen\",\n                abs(page.evaluate(\"__game.getState().time\") - paused_time) < 0.001,\n            )\n            page.locator(\"#dev\").click()\n            page.locator('input[data-key=\"speed\"]').evaluate(\n                \"e=>{e.value='8.4';e.dispatchEvent(new Event('input'))}\"\n            )\n            check(\n\"\"\"AI Hub's actual browser conformance harness; no invented protocol stand-in.\"\"\"\nfrom __future__ import annotations\n\nimport functools\nimport http.server\nimport json\nfrom pathlib import Path\nimport threading\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\nDEV = Path(__file__).resolve().parent.parent\nROOT = DEV.parent\nGAME = DEV.name + '.html'\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef run_checks():\n    failures = []\n    count = 0\n    handler = functools.partial(QuietHandler, directory=str(ROOT))\n    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\n    worker = threading.Thread(target=server.serve_forever, daemon=True)\n    worker.start()\n    url = f'http://127.0.0.1:{server.server_port}'\n    reports = []\n    try:\n        with sync_playwright() as playwright:\n            browser = playwright.chromium.launch(headless=True, args=[\n                '--enable-unsafe-webgpu', '--enable-features=Vulkan',\n                '--use-webgpu-adapter=swiftshader', '--ignore-certificate-errors',\n                '--disable-dev-shm-usage',\n            ])\n            context = browser.new_context(viewport={'width':1280,'height':900})\n            try:\n                for label, extra in [\n                    ('two-player', {}),\n                    ('latency-loss', {'latency':150,'jitter':50,'loss':5}),\n                    ('host-leave', {'scenario':'host-leave'}),\n                    ('server-host', {'scenario':'server'}),\n                ]:\n                    page = context.new_page()\n                    errors = []\n                    page.on('pageerror', lambda error: errors.append(str(error)))\n                    try:\n                        query = {'game':'../'+GAME,'players':2,'auto':1,'play':3500, **extra}\n                        page.goto(url+'/'+DEV.name+'/harness.html?'+urlencode(query), wait_until='domcontentloaded', timeout=45000)\n                        page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=120000)\n                        report = page.evaluate('window.__hubCheck')\n                        reports.append({'scenario':label, 'browserErrors':errors, **report})\n                        for check in report.get('checks', []):\n                            count += 1\n                            if not check['pass']:\n                                failures.append(f\"{label}: {check['name']}: {check.get('detail','')}\")\n                        count += 1\n                        if not report.get('pass'):\n                            failures.append(f'{label}: overall conformance failed')\n                        count += 1\n                        if errors:\n                            failures.append(f'{label}: no browser errors: '+ '; '.join(dict.fromkeys(errors)))\n                    except Exception as error:\n                        count += 1\n                        failures.append(f'{label}: {error}')\n                    finally:\n                        page.close()\n","exit_code":0,"status":"completed"}}
