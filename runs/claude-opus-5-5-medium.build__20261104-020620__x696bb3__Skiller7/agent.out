nexport async function boot(page, q = '?backend=webgl', hash = '') {\n  await page.goto(FILE + q + hash);\n  await page.waitForFunction(() => window.S7 && window.S7.started && window.__game && window.__game.game.sceneName, null, { timeout: 60000 });\n  await page.waitForTimeout(500);\n}\nEOF\nnode tools/build.mjs && cat > tmp/smoke.mjs <<'EOF'\nimport { launch, boot } from '../tests/lib/browser.mjs';\nconst { browser, page, errors } = await launch();\ntry {\n  await boot(page);\n  await page.waitForTimeout(1500);\n  console.log('scene', await page.evaluate(() => window.__game.game.sceneName));\n  await page.screenshot({ path: 'tmp/title.png' });\n  await page.keyboard.press('Enter'); await page.waitForTimeout(400); await page.keyboard.press('Enter'); await page.waitForTimeout(2500);\n  console.log('after new game', JSON.stringify(await page.evaluate(() => { const s = window.__game.game.debug.snapshot(); return { scene: s.scene, mode: s.mode, area: s.area }; })));\n  await page.screenshot({ path: 'tmp/coldopen.png' });\n} catch (e) { console.log('ERR', e.message); }\nconsole.log(errors.slice(0, 12).join('\\n'));\nawait browser.close();\nEOF\nTMPDIR=$PWD/tmp timeout 180 node tmp/smoke.mjs 2>&1 | tail -20","description":"Build HTML and run browser smoke test"}},"wire_ingest_context":{"toolu_01Mnkr4NEGxXii1Tsq9PwtLg":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-020620__x696bb3/work/Skiller7-Killer7-claude-opus-5-5-medium-20261104-020620"}}}
