 G.T.reach + .4 * pd.p.stat('TEC') + 12) return;","+  const q = ['perfect', 'great', 'ok'].includes(d.q) ? d.q : 'ok';","+  pd.judged = true;","+  M.resolveTouch(pd.p, pd, q, d.a === 'shot' ? 'shot' : 'play');","+  H.claims = (H.claims || 0) + 1;","+};"," G.hubClientUpdate = function (dt) {","   const M = G.hub.M; if (!M) return;","   for (const p of M.players) { if (!p.rig) continue; p.rig.update(dt, G.rigStateFor(p)); }"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-012424__x8def6b/work/AheadOrAliveXtremeBeachVolleyball-DeadOrAliveXtremeBeachVolleyball-claude-haiku-5-5-medium-20261104-012424/src/25-netplay.js","hunks":[{"oldStart":127,"oldLines":7,"newStart":127,"newLines":8,"lines":["   const H = G.hub;","   if (!d || typeof d !== 'object') return;","   if (H.role === 'host') {","-    if (d.t === 'i') { const I = H.remote[from]; if (I) { for (const a of d.a || []) I.pend.add(a); if (d.m) I.mv = d.m; } }","+    if (d.t === 'c') G.hubClaim(from, d);","+    if (d.t === 'i') { const I = H.remote[from]; if (I) { for (const a of d.a || []) if (a === 'dive' || a === 'call') I.pend.add(a); if (d.m) I.mv = d.m; } }","     if (d.t === 'm') { const I = H.remote[from]; if (I) I.mv = d.m || [0, 0]; }","     return;","   }"]},{"oldStart":140,"oldLines":7,"newStart":141,"newLines":7,"lines":["   const H = G.hub, M = H.M; if (!M) return;","   H.sendT -= dt; if (H.sendT > 0) return; H.sendT = 1 / 12;","   const pl = M.players.map(p => [p.seat, +p.x.toFixed(1), +p.y.toFixed(1), +(p.facing || 0).toFixed(2), p.act, p.down ? 1 : 0]);","-  AIHub.send({ t: 's', at: AIHub.time(), p: pl, sc: M.score.slice(), ph: M.phase, sv: M.server ? M.server.seat : 0, ll: M.L ? M.L.id : 0, tc: M.callText ? M.callText.text : '' }, { reliable: false });","+  AIHub.send({ t: 's', at: AIHub.time(), p: pl, sc: M.score.slice(), ph: M.phase, sv: M.server ? M.server.seat : 0, ll: M.L ? M.L.id : 0, tc: M.callText ? M.callText.text : '', pd: M.pending && !M.pending.judg