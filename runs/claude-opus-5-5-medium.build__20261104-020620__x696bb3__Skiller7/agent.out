id, 'trigger ' + t.id + ' has an unknown wave'); if (t.tip && !S7.TIPDEFS[t.tip]) bad(id, 'trigger ' + t.id + ' has an unknown tip'); }","+    for (const s of A.spots) { if (s.item && !S7.ITEMS[s.item]) bad(id, 'spot ' + s.id + ' has an unknown item'); if (s.beat && !S7.BEATS[s.beat]) bad(id, 'spot ' + s.id + ' has an unknown beat'); if (s.lines && typeof s.lines === 'string' && !S7.LINES[s.lines]) bad(id, 'spot ' + s.id + ' has unknown lines'); if (s.gate && !(area.gates || {})[s.gate]) bad(id, 'spot ' + s.id + ' has an unknown gate'); }","+    for (const t of A.targets || []) if (t.beat && !S7.BEATS[t.beat]) bad(id, 'target ' + t.id + ' has an unknown beat');","+  }","+  for (const id in S7.PERSONAS) { const P = S7.PERSONAS[id]; if (!S7.WEAPONS[P.weapon]) bad('persona ' + id, 'unknown weapon'); }","+  const strs = JSON.stringify([S7.LINES, S7.AREAS, S7.ITEMS, S7.PERSONAS]);","+  const MARK = new RegExp('\\\\b(' + ['TO' + 'DO', 'T' + 'BD', 'lo' + 'rem', 'place' + 'holder', 'X' + 'XX'].join('|') + ')\\\\b', 'i');","+  if (MARK.test(strs)) bad('content', 'an unfinished marker in the text');","+  return out;","+};","+S7.validateQuick = () => { const v = S7.validate(); if (v.length && S7.game) S7.game.fail('content', new Error(v.slice(0, 5).join('; '))); return v; };","+"," /* ==== src/20-sim.js ==== */"," /* SKILLER7 — the sim: one state object (S7.G), the walker on the rails, the modes, personas and switching, Red and","  * Rime, items, gates, talk and beats, Room 7, freezing and the Sweep's rescue, saves. It never touches the DOM or 3D. */"]},{"oldStart":2065,"oldLines":7,"newStart":2089,"newLines":7,"lines":["   }","   // the interview: wait, then fire (the \"shot\" ending), or not","   if (G.boss && G.boss.id === 'hansi' && G.boss.phase === 3) { if (G.boss.t3 > 12 && BOT.shootInterview !== false) { I.fire = I.firePressed = true; } return I; }","-  if (botFight(I, dt)) { BOT.fightT = (BOT.fightT || 0) + dt; return I; }","+  if (botFight(I, dt)) { BOT.fightT = (BOT.