{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkoFPY5KTfzwF8XvfB5u","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Festivals are written; the remaining screens (title, pause, settings, map, almanac, letter, keyboard, pattern studio, chime, placement, auction, theatre and credits) come next before first boot.\n\n","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19824,"cache_read_input_tokens":609723,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19824},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"a4c2622d-5ccf-4124-ac0e-a7c226bfb5b2","timestamp":"2026-11-06T01:21:58.096Z","request_id":"req_011CgkoFPB1EwtLjef6HHNi9","narration_block_indexes":[0],"thinking_duration_ms":1,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkoFPY5KTfzwF8XvfB5u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KsQg4XEiriXQ5a9k6KVTUf","name":"Bash","input":{"command":"cat > src/ui/screens/numbers.js <<'EOF'\n// A big number with up and down; and a plain free-standing menu.\nimport { panel, drawText, inRect, dim } from '../draw.js';\nimport { Menu } from '../ui.js';\n\nclass NumberScreen {\n  constructor({ title, max, step, onDone }) { this.id = 'number'; this.title = title; this.max = max; this.step = step; this.value = Math.min(max, step * 10); this.onDone = onDone; }\n  focusIndex() { return this.value; }\n  labels() { return [String(this.value)]; }\n  update(g, inp) {\n    const m = inp.mouse;\n    const big = this.step * 10;\n    let v = this.value;\n    if (inp.nav.up) v += this.step;\n    if (inp.nav.down) v -= this.step;\n    if (inp.nav.right) v += big;\n    if (inp.nav.left) v -= big;\n    if (m.click) {\n      if (inRect(m, 160, 100, 30, 30)) v -= big;\n      if (inRect(m, 290, 100, 30, 30)) v += big;\n      if (inRect(m, 200, 154, 80, 22)) { g.sound('uiConfirm'); g.ui.pop(this); this.onDone(this.value); return; }\n    }\n    if (g.ctx.input.wasPressed('KeyM') || inp.square) v = this.max;\n    v = Math.max(0, Math.min(this.max, v));\n    if (v !== this.value) { this.value = v; g.sound('uiTick'); }\n    if (inp.confirm) { g.sound('uiConfirm'); g.ui.pop(this); this.onDone(this.value); return; }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onDone(0); }\n  }\n  prompts() { return [['confirm', 'OK'], ['fill', 'All of it'], ['back', 'Cancel']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 120, 60, 240, 130, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 70, this.title, { align: 'center', color: 'ink' });\n    drawText(hud, 240, 104, this.value.toLocaleString('en-US'), { align: 'center', color: 'ink', scale: 3 });\n    drawText(hud, 240, 132, `of ${this.max.toLocaleString('en-US')}`, { align: 'center', color: 'slate' });\n    panel(hud, 160, 100, 30, 30, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 175, 110, '<', { align: 'center', color: 'ink' });\n    panel(hud, 290, 100, 30, 30, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 305, 110, '>', { align: 'center', color: 'ink' });\n    panel(hud, 200, 154, 80, 22, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 240, 161, 'OK', { align: 'center', color: 'ink' });\n  }\n}\nexport function* numberPicker(g, { title, max, step = 100 }) {\n  if (max <= 0) return 0;\n  let done = null;\n  g.ui.push(new NumberScreen({ title, max, step: Math.min(step, Math.max(1, max)), onDone: (v) => { done = v; } }));\n  while (done === null) yield;\n  return done;\n}\nexport function* menuChoiceFree(g, title, labels, o = {}) {\n  let result = -2;\n  const items = labels.map((l, i) => ({ label: l, action: (gg, m) => { result = i; gg.ui.pop(m); } }));\n  g.ui.push(new Menu({ id: o.id ?? 'choice', title, items, x: o.x ?? 130, y: o.y ?? 70, w: o.w ?? 220, back: (gg, m) => { result = -1; gg.ui.pop(m); } }));\n  while (result === -2) yield;\n  return result;\n}\nEOF\ncat > src/ui/screens/keyboard.js <<'EOF'\n// The on-screen keyboard: a chunky grid for the pad, real typing for the keyboard.\nimport { panel, drawText, inRect, dim, textWidth } from '../draw.js';\n\nconst ROWS = ['ABCDEFGHIJKLM', 'NOPQRSTUVWXYZ', 'abcdefghijklm', 'nopqrstuvwxyz', \"0123456789.,!\", \"?'-&() _\"];\nconst CELL = 24;\nclass Keyboard {\n  constructor({ title, max = 12, value = '', hint = '', random = null, onDone, onCancel, multi = false }) {\n    this.id = 'keyboard'; this.title = title; this.max = max; this.value = value; this.hint = hint; this.random = random; this.onDone = onDone; this.onCancel = onCancel;\n    this.cx = 0; this.cy = 0;\n    this.multi = multi;\n    this.randomI = 0;\n  }\n  labels() { return ROWS; }\n  currentText() { return this.value; }\n  focusIndex() { return this.cy * 20 + this.cx; }\n  rect(cx, cy) { return [240 - (13 * CELL) / 2 + cx * CELL, 90 + cy * CELL, CELL - 2, CELL - 2]; }\n  type(g, ch) { if (this.value.length < this.max) { this.value += ch; g.sound('uiTick'); } else g.sound('uiError'); }\n  rowsAt(y) { return y < ROWS.length ? ROWS[y].length : 2; }\n  commit(g) { const v = this.value.trim(); if (!v) { g.sound('uiError'); return; } g.sound('uiConfirm'); g.ui.pop(this); this.onDone(v); }\n  update(g, inp) {\n    for (const k of inp.keysTyped) {\n      if (k === 'Enter') { this.commit(g); return; }\n      if (k === 'Backspace') { this.value = this.value.slice(0, -1); g.sound('uiTick'); continue; }\n      if (k.length === 1 && /[A-Za-z0-9 .,!?'&()_-]/.test(k)) this.type(g, k);\n    }\n    const typing = inp.keysTyped.length > 0;\n    if (inp.nav.right && !typing) { this.cx++; g.sound('uiTick'); }\n    if (inp.nav.left && !typing) { this.cx--; g.sound('uiTick'); }\n    if (inp.nav.up && !typing) { this.cy = (this.cy + ROWS.length) % (ROWS.length + 1); g.sound('uiTick'); }\n    if (inp.nav.down && !typing) { this.cy = (this.cy + 1) % (ROWS.length + 1); g.sound('uiTick'); }\n    const len = this.rowsAt(this.cy);\n    this.cx = ((this.cx % len) + len) % len;\n    const m = inp.mouse;\n    if (m.moved || m.click) for (let y = 0; y < ROWS.length; y++) for (let x = 0; x < ROWS[y].length; x++) if (inRect(m, ...this.rect(x, y))) { this.cx = x; this.cy = y; if (m.click) this.type(g, ROWS[y][x]); }\n    const r0 = [150, 90 + ROWS.length * CELL + 2, 80, 20], r1 = [250, 90 + ROWS.length * CELL + 2, 80, 20];\n    if (m.click && inRect(m, ...r0)) { this.value = this.value.slice(0, -1); g.sound('uiTick'); }\n    if (m.click && inRect(m, ...r1)) { this.commit(g); return; }\n    if (inp.confirm && !inp.keysTyped.includes('Enter')) {\n      if (this.cy >= ROWS.length) { if (this.cx === 0) { this.value = this.value.slice(0, -1); g.sound('uiTick'); } else { this.commit(g); return; } }\n      else this.type(g, ROWS[this.cy][this.cx]);\n    }\n    if (inp.square) { this.value = this.value.slice(0, -1); g.sound('uiTick'); }\n    if (inp.triangle && this.random) { this.value = this.random[this.randomI++ % this.random.length]; g.sound('uiConfirm'); }\n    if (g.ctx.input.wasPressed('Tab') && this.random) { this.value = this.random[this.randomI++ % this.random.length]; g.sound('uiConfirm'); }\n    if (g.ctx.input.wasPressed('PadCircle') || (m.rclick) || g.ctx.input.wasPressed('Escape')) {\n      if (this.onCancel) { g.sound('uiCancel'); g.ui.pop(this); this.onCancel(); }\n      else if (this.value) { this.value = this.value.slice(0, -1); g.sound('uiTick'); }\n    }\n  }\n  prompts() {\n    const p = [['confirm', 'Type'], ['fill', 'Rub out']];\n    if (this.random) p.push(['random', 'Suggest']);\n    return p;\n  }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 60, 14, 360, 240, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 24, this.title, { align: 'center', color: 'ink', scale: 1 });\n    panel(hud, 80, 40, 320, 26, { fill: 'sand', trim: 'orange' });\n    const shown = this.value.length > 44 ? `…${this.value.slice(-44)}` : this.value;\n    const w = textWidth(shown);\n    drawText(hud, 88, 49, shown, { color: 'ink' });\n    if (Math.floor(g.ctx.time * 2) % 2 === 0) hud.rect(89 + w, 48, 2, 9, 'plum');\n    if (this.hint) drawText(hud, 240, 74, this.hint, { align: 'center', color: 'slate' });\n    ROWS.forEach((row, y) => [...row].forEach((ch, x) => {\n      const [rx, ry, rw, rh] = this.rect(x, y);\n      const f = this.cy === y && this.cx === x;\n      panel(hud, rx, ry, rw, rh, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      drawText(hud, rx + rw / 2, ry + 7, ch === ' ' ? '_' : ch, { align: 'center', color: 'ink' });\n    }));\n    const by = 90 + ROWS.length * CELL + 2;\n    const f0 = this.cy === ROWS.length && this.cx === 0, f1 = this.cy === ROWS.length && this.cx === 1;\n    panel(hud, 150, by, 80, 20, { fill: f0 ? 'sand' : 'white', trim: f0 ? 'orange' : 'mist' });\n    drawText(hud, 190, by + 6, 'Rub out', { align: 'center', color: 'ink' });\n    panel(hud, 250, by, 80, 20, { fill: f1 ? 'sand' : 'white', trim: f1 ? 'orange' : 'mist' });\n    drawText(hud, 290, by + 6, 'Done', { align: 'center', color: 'ink' });\n  }\n}\nexport function* keyboardFlow(g, opts) {\n  let result = null;\n  g.ui.push(new Keyboard({ ...opts, onDone: (v) => { result = v; }, onCancel: opts.canCancel ? () => { result = ''; } : null }));\n  while (result === null) yield;\n  return result;\n}\nexport const openKeyboard = (g, opts) => g.ui.push(new Keyboard(opts));\nEOF\ncat > src/ui/screens/letter.js <<'EOF'\n// Letters: choose who, write on a sheet of paper with big type, attach a gift.\nimport { panel, drawText, inRect, dim, textBlock, wrap } from '../draw.js';\nimport { keyboardFlow } from './keyboard.js';\nimport { menuChoiceFree } from './numbers.js';\nimport { NEIGHBOURS, NEIGHBOUR_ORDER } from '../../data/neighbours.js';\nimport { ITEMS } from '../../data/items.js';\nimport { removeSlot } from '../../systems/economy.js';\nimport { pocketsPicker } from './pockets.js';\nimport { replyTo } from '../../systems/mail.js';\nimport { completeErrand } from '../../systems/dayone.js';\nimport { say } from '../../systems/say.js';\nimport { remember } from '../../systems/memory.js';\nimport { hostLine } from '../../systems/lines.js';\n\nexport function* letterFlow(g) {\n  const w = g.world;\n  const others = NEIGHBOUR_ORDER.filter((n) => w.npcs[n].moved === 'here');\n  const labels = ['Gran', ...others.map((n) => NEIGHBOURS[n].name), 'Never mind'];\n  const list = ['gran', ...others];\n  const c = yield* menuChoiceFree(g, 'Write to whom?', labels, { id: 'letterTo' });\n  if (c < 0 || c >= list.length) return;\n  const to = list[c];\n  const text = yield* keyboardFlow(g, { title: `Dear ${labels[c]},`, max: 120, hint: 'Say whatever you like. Clementine will read it, and so will the bee.', random: ['Everything is fine.', 'I owe a goose.', 'It rained. Then it stopped.', 'Send fruit.'], canCancel: true });\n  if (!text) return;\n  // Gift?\n  let gift = null;\n  const a = yield* menuChoiceFree(g, 'Attach a gift?', ['Yes', 'No']);\n  if (a === 0) {\n    let picked = -2;\n    g.ui.push(pocketsPicker(g, { title: 'Attach what?', filter: (s) => ITEMS[s.id]?.cat !== 'tool' && ITEMS[s.id]?.cat !== 'quest', onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n    while (picked === -2) yield;\n    if (picked >= 0) { gift = removeSlot(g, picked).id; }\n  }\n  let closed = false;\n  g.ui.push(new PaperScreen(labels[c], text, gift, () => { closed = true; }));\n  while (!closed) yield;\n  g.sound('stamp');\n  replyTo(g, to, text, gift);\n  w.mail.sentToday += 1;\n  w.stats.lettersSent = (w.stats.lettersSent ?? 0) + 1;\n  remember(g, 'letter', { about: to === 'gran' ? null : to });\n  g.events.emit('letterSent', { to, text, gift });\n  if (w.story.day1Active && to === 'gran') completeErrand(g, 'letter');\n  if (g.place?.id === 'hall') yield* say(g, 'clementine', hostLine(g, 'clementine', 'post'));\n}\nclass PaperScreen {\n  constructor(name, text, gift, onDone) { this.id = 'paper'; this.name = name; this.text = text; this.gift = gift; this.onDone = onDone; }\n  currentText() { return this.text; }\n  update(g, inp) { if (inp.confirm || inp.back || inp.mouse.click) { g.ui.pop(this); this.onDone(); } }\n  prompts() { return [['confirm', 'Post it']]; }\n  draw(g, hud) {\n    dim(hud);\n    drawPaper(hud, `Dear ${this.name},`, this.text, g.world.player.name, this.gift ? `Enclosed: ${ITEMS[this.gift]?.name}` : '');\n  }\n}\nexport function drawPaper(hud, head, body, sign, foot) {\n  panel(hud, 70, 22, 340, 214, { fill: 'white', trim: 'sand' });\n  for (let y = 58; y < 200; y += 14) hud.rect(84, y, 312, 1, 'mist');\n  drawText(hud, 88, 34, head, { color: 'ink', scale: 1 });\n  const lines = wrap(body, 300);\n  lines.slice(0, 11).forEach((l, i) => drawText(hud, 88, 50 + i * 14, l, { color: 'ink' }));\n  if (sign) drawText(hud, 392, 206, sign, { color: 'plum', align: 'right' });\n  if (foot) drawText(hud, 88, 218, foot, { color: 'slate' });\n}\nexport { inRect, textBlock };\nEOF\ncat > src/ui/screens/mail.js <<'EOF'\n// The mailbox: a stack of letters on a sheet of paper, big type.\nimport { panel, drawText, dim, inRect } from '../draw.js';\nimport { drawPaper } from './letter.js';\nimport { resolveTags } from '../../systems/lines.js';\nimport { senderName } from '../../systems/mail.js';\nimport { ITEMS } from '../../data/items.js';\nimport { addItem, hasRoom, addBeans } from '../../systems/economy.js';\nimport { Menu } from '../ui.js';\n\nclass Reader {\n  constructor(letter, onDone) { this.id = 'letterRead'; this.letter = letter; this.onDone = onDone; }\n  currentText() { return this.letter.body; }\n  open(g) { g.sound('paper'); if (!this.letter.read) { this.letter.read = true; g.events.emit('letterRead', { from: this.letter.from }); } }\n  update(g, inp) {\n    if (inp.confirm || inp.back || inp.mouse.click || inp.mouse.rclick) {\n      g.ui.pop(this);\n      const l = this.letter;\n      if (l.gift && !l.taken) {\n        const id = typeof l.gift === 'string' ? l.gift : l.gift.id;\n        if (typeof l.gift === 'object' && l.gift.beans) { addBeans(g, l.gift.beans, 'mail'); g.sound('beanLots'); l.taken = true; g.ui.toastMsg(`+${l.gift.beans.toLocaleString('en-US')} beans`); }\n        else if (hasRoom(g.world)) { addItem(g, id, typeof l.gift === 'object' && l.gift.from ? { from: l.gift.from } : null); l.taken = true; g.sound('pickUp'); g.ui.toastMsg(`You take the ${ITEMS[id]?.name ?? 'present'}.`); g.events.emit('giftOpened', { id, from: l.from }); }\n        else g.ui.toastMsg('Your pockets are full. It stays in the letter.');\n      }\n      this.onDone?.();\n    }\n  }\n  prompts() { return [['confirm', 'Fold it up']]; }\n  draw(g, hud) {\n    dim(hud);\n    const l = this.letter;\n    const body = resolveTags(l.body, g);\n    const parts = body.split('\\n');\n    const sign = parts.length > 1 ? parts[parts.length - 1] : '';\n    const text = parts.slice(0, parts.length > 1 ? -1 : undefined).join(' ');\n    const gift = l.gift && !l.taken ? (typeof l.gift === 'object' && l.gift.beans ? `Enclosed: ${l.gift.beans.toLocaleString('en-US')} beans` : `Enclosed: ${ITEMS[typeof l.gift === 'string' ? l.gift : l.gift.id]?.name ?? 'something'}`) : '';\n    drawPaper(hud, `From ${senderName(l.from)}`, text, sign, gift);\n  }\n}\nexport function mailScreen(g, onClose) {\n  const w = g.world;\n  const close = (gg, m) => { gg.ui.pop(m); onClose?.(); };\n  const rebuild = () => w.mail.inbox.slice(-8).reverse().map((l) => ({\n    label: `${l.read ? '' : '* '}${senderName(l.from)}`,\n    icon: 'letter', iconColors: { o: 'red', x: 'mist', w: 'white' },\n    action: (gg) => { gg.ui.push(new Reader(l)); },\n  }));\n  const items = rebuild();\n  if (!items.length) items.push({ label: 'Nothing. Not even a bill. Enjoy it.', action: close });\n  return new Menu({ id: 'mailbox', title: 'The mailbox', items, x: 120, y: 60, w: 240, itemH: 20, back: close, prompts: [['confirm', 'Read'], ['back', 'Close']] });\n}\nexport { panel, drawText, inRect };\nEOF\ncat > src/ui/screens/map.js <<'EOF'\n// The map: a pixel map, pins, who's where now.\nimport { panel, drawText, inRect, dim, textWidth } from '../draw.js';\nimport { COLS, ROWS, tileChar } from '../../world/tiles.js';\nimport { BUILDINGS, LANDMARKS, ACRE_NAMES } from '../../data/town.js';\nimport { NEIGHBOUR_ORDER, NEIGHBOURS } from '../../data/neighbours.js';\n\nconst LEGEND = { '.': 'green', ':': 'lime', '=': 'sand', '\"': 'sand', _: 'mist', s: 'sand', '~': 'blue', w: 'sky', o: 'sky', m: 'blue', t: 'sky', W: 'sky', f: 'white', B: 'orange', '^': 'sand', b: 'orange', d: 'orange', C: 'slate', '#': 'teal', H: 'teal', X: 'plum' };\nconst SEASON_LAWN = ['lime', 'green', 'sand', 'white'];\nconst SEASON_HIGH = ['lime', 'lime', 'orange', 'mist'];\nconst CHAR_MAP = { '.': 'a', ':': 'b', '=': 'c', '\"': 'c', _: 'd', s: 'c', '~': 'e', w: 'f', o: 'f', m: 'e', t: 'f', W: 'f', f: 'g', B: 'h', '^': 'c', b: 'h', d: 'h', C: 'i', '#': 'j', H: 'j' };\nlet rowsCache = null;\nfunction mapRows() {\n  if (rowsCache) return rowsCache;\n  const s = 3;\n  const grid = [];\n  for (let z = 0; z < ROWS; z++) { let line = ''; for (let x = 0; x < COLS; x++) line += (CHAR_MAP[tileChar(x, z)] ?? 'a').repeat(s); for (let i = 0; i < s; i++) grid.push(line); }\n  const out = grid.map((l) => l.split(''));\n  for (const b of BUILDINGS) for (let z = b.z * s; z < (b.z + b.d) * s; z++) for (let x = b.x * s; x < (b.x + b.w) * s; x++) out[z][x] = 'k';\n  rowsCache = out.map((l) => l.join(''));\n  return rowsCache;\n}\nclass MapScreen {\n  constructor(g) {\n    this.id = 'map';\n    this.focus = 0;\n    this.pins = [];\n    for (const b of BUILDINGS) this.pins.push({ name: b.id === 'home' ? 'Your place' : b.name, x: b.x + b.w / 2, z: b.z + b.d / 2, kind: 'b' });\n    this.pins.push({ name: 'Bus stop', x: LANDMARKS.busStop[0], z: LANDMARKS.busStop[1], kind: 'b' });\n    this.pins.push({ name: 'The Old Pear', x: LANDMARKS.oldPear[0], z: LANDMARKS.oldPear[1], kind: 'b' });\n    this.pins.push({ name: 'The Lookout', x: LANDMARKS.lookoutBench[0], z: LANDMARKS.lookoutBench[1], kind: 'b' });\n    this.pins.push({ name: 'The Lighthouse', x: LANDMARKS.lighthouse[0], z: LANDMARKS.lighthouse[1], kind: 'b' });\n    for (const id of NEIGHBOUR_ORDER) if (g.world.npcs[id].moved === 'here') { const a = g.npcs.actor(id); const inside = g.npcs.get(id).inside; this.pins.push({ name: inside ? `${NEIGHBOURS[id].name}, indoors` : NEIGHBOURS[id].name, x: a.x, z: a.z, kind: 'n', dim: inside }); }\n    this.focusPin = this.pins.findIndex((p) => p.kind === 'n');\n    if (this.focusPin < 0) this.focusPin = 0;\n  }\n  focusIndex() { return this.focusPin; }\n  labels() { return this.pins.map((p) => p.name); }\n  update(g, inp) {\n    if (inp.nav.right || inp.nav.down) { this.focusPin = (this.focusPin + 1) % this.pins.length; g.sound('uiTick'); }\n    if (inp.nav.left || inp.nav.up) { this.focusPin = (this.focusPin + this.pins.length - 1) % this.pins.length; g.sound('uiTick'); }\n    const m = inp.mouse;\n    if (m.moved) this.pins.forEach((p, i) => { const [x, y] = this.at(p); if (Math.hypot(m.x - x, m.y - y) < 5) this.focusPin = i; });\n    if (inp.back || inp.map || inp.confirm || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); }\n  }\n  at(p) { return [120 + Math.round(p.x * 3), 22 + Math.round(p.z * 3)]; }\n  prompts() { return [['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 112, 14, 256, 208, { fill: 'navy', trim: 'sand' });\n    const season = g.season;\n    hud.sprite(120, 22, mapRows(), { a: SEASON_LAWN[season], b: SEASON_HIGH[season], c: 'sand', d: 'mist', e: 'blue', f: 'sky', g: 'white', h: 'orange', i: 'slate', j: 'teal', k: 'plum' }, { shadow: false });\n    this.pins.forEach((p, i) => {\n      const [x, y] = this.at(p);\n      if (i === this.focusPin) { hud.rect(x - 3, y - 3, 7, 7, 'ink'); hud.rect(x - 2, y - 2, 5, 5, 'sand'); }\n      else if (p.kind === 'n') { hud.rect(x - 1, y - 1, 3, 3, p.dim ? 'slate' : 'red'); }\n    });\n    if (g.place === g.town) {\n      const [x, y] = this.at({ x: g.player.x, z: g.player.z });\n      const on = Math.floor(g.ctx.time * 3) % 2 === 0;\n      hud.rect(x - 2, y - 2, 5, 5, on ? 'white' : 'ink');\n    }\n    const name = this.pins[this.focusPin].name;\n    const col = Math.max(0, Math.min(4, Math.floor(g.player.x / 16))), row = Math.max(0, Math.min(3, Math.floor(g.player.z / 16)));\n    const where = g.place === g.town ? `You are in ${ACRE_NAMES[row][col]}.` : `You are at ${g.place.def?.name ?? g.place.name}.`;\n    panel(hud, 112, 224, 256, 26, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 228, name, { align: 'center', color: 'ink' });\n    drawText(hud, 240, 238, where, { align: 'center', color: 'slate' });\n  }\n}\nexport const mapScreen = (g) => new MapScreen(g);\nexport { LEGEND, inRect, textWidth };\nEOF\ncat > src/ui/screens/almanac.js <<'EOF'\n// The Almanac: tabs, big silhouettes that fill in. Fish, Bugs, Fossils, Art, Stars, Calendar.\nimport { panel, drawText, inRect, dim, textBlock } from '../draw.js';\nimport { drawIcon } from '../../art/icons.js';\nimport { FISH } from '../../data/fish.js';\nimport { BUGS } from '../../data/bugs.js';\nimport { FOSSILS } from '../../data/fossils.js';\nimport { ART } from '../../data/art.js';\nimport { CONSTELLATIONS } from '../../systems/stargaze.js';\nimport { ITEMS } from '../../data/items.js';\nimport { SEASON_NAMES, DAY_TYPES, villageDay } from '../../core/calendar.js';\n\nconst TABS = ['Fish', 'Bugs', 'Fossils', 'Art', 'Stars', 'Calendar'];\nconst SIL = { o: 'night', x: 'night', w: 'night', '#': 'ink' };\nconst when = (d) => { const seas = d.seasons?.map((s) => SEASON_NAMES[s]).join(', ') ?? ''; const h = d.hours ? (d.hours[0] > 16 ? ', evenings' : d.hours[1] < 12 ? ', mornings' : ', daytime') : ''; return `${seas}${h}`; };\nconst YEAR_NOTES = { 1: 'Arrival', 2: 'Museum opens', 3: 'Set the Chime; Vesper', 4: 'The Seed Toss', 5: 'Season turns; Old Rind', 6: 'Fishing Derby', 7: 'Vesper', 8: 'The Lantern Float', 9: 'Fitch moves in', 10: 'Bug-Off', 11: 'Vesper', 12: 'The Great Soup', 13: 'First snow', 14: 'Snowman Contest', 15: 'Vesper', 16: 'The Long Night' };\nclass Almanac {\n  constructor() { this.id = 'almanac'; this.tab = 0; this.focus = 0; this.cols = 6; }\n  labels() { return TABS; }\n  focusIndex() { return this.tab * 100 + this.focus; }\n  entries(g) {\n    const w = g.world;\n    switch (this.tab) {\n      case 0: return FISH.map((f) => ({ id: f.id, name: f.name, known: !!w.almanac.fish[f.id], icon: f.icon, colors: ITEMS[f.id].iconColors, line: f.line, where: `${f.where === 'mouth' ? 'River mouth' : f.where[0].toUpperCase() + f.where.slice(1)}. ${when(f)}.`, donated: w.museum.fish[f.id], beans: f.beans }));\n      case 1: return BUGS.map((b) => ({ id: b.id, name: b.name, known: !!w.almanac.bug[b.id], icon: b.icon, colors: ITEMS[b.id].iconColors, line: b.line, where: `On ${b.spot === 'near' ? 'the banks' : b.spot}. ${when(b)}.`, donated: w.museum.bug[b.id], beans: b.beans }));\n      case 2: return FOSSILS.map((f) => ({ id: f.id, name: f.name, known: !!w.almanac.fossil[f.id], icon: f.set ? 'bone' : 'ammonite', colors: { o: 'sand', x: 'orange' }, line: f.line, where: f.set ? (f.set === 'moatosaur' ? 'Part of the Moatosaur.' : 'Part of the Long-Necked Regretodon.') : 'A piece on its own.', donated: w.museum.fossil[f.id], beans: f.beans }));\n      case 3: return ART.map((a) => ({ id: a.id, name: a.name, known: !!w.almanac.art[a.id], icon: 'picture', colors: { o: 'sky', x: 'orange' }, line: a.line, where: 'Sold after dark, in an alley. Compare it with the print.', donated: w.museum.art[a.id], beans: a.beans }));\n      case 4: return CONSTELLATIONS.map((c) => ({ id: c.id, name: c.name, known: !!w.almanac.stars[c.id], icon: 'star', colors: { o: 'sand', x: 'white' }, line: 'Up at the Lookout, on a clear night.', where: 'Named by you, more or less.', donated: false }));\n      default: return [];\n    }\n  }\n  update(g, inp) {\n    if (inp.tabPrev) { this.tab = (this.tab + TABS.length - 1) % TABS.length; this.focus = 0; g.sound('almanacTurn'); }\n    if (inp.tabNext) { this.tab = (this.tab + 1) % TABS.length; this.focus = 0; g.sound('almanacTurn'); }\n    const n = this.entries(g).length;\n    if (n) {\n      if (inp.nav.right) { this.focus = (this.focus + 1) % n; g.sound('uiTick'); }\n      if (inp.nav.left) { this.focus = (this.focus + n - 1) % n; g.sound('uiTick'); }\n      if (inp.nav.down) { this.focus = Math.min(n - 1, this.focus + this.cols); g.sound('uiTick'); }\n      if (inp.nav.up) { this.focus = Math.max(0, this.focus - this.cols); g.sound('uiTick'); }\n    }\n    const m = inp.mouse;\n    TABS.forEach((_, i) => { if (m.click && inRect(m, 78 + i * 54, 20, 52, 18)) { this.tab = i; this.focus = 0; g.sound('almanacTurn'); } });\n    for (let i = 0; i < n; i++) if (inRect(m, ...this.rect(i))) { if (m.moved || m.click) this.focus = i; }\n    if (inp.back || inp.almanac || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); }\n  }\n  rect(i) { return [84 + (i % this.cols) * 52, 44 + Math.floor(i / this.cols) * 42, 50, 40]; }\n  prompts() { return [['tabs', 'Turn page'], ['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 70, 14, 340, 240, { fill: 'white', trim: 'sand' });\n    TABS.forEach((t, i) => {\n      const on = this.tab === i;\n      panel(hud, 78 + i * 54, 20, 52, 18, { fill: on ? 'sand' : 'white', trim: on ? 'orange' : 'mist' });\n      drawText(hud, 78 + i * 54 + 26, 26, t, { align: 'center', color: 'ink' });\n    });\n    if (this.tab === 5) { this.drawCalendar(g, hud); return; }\n    const list = this.entries(g);\n    list.forEach((e, i) => {\n      const [x, y, w, h] = this.rect(i);\n      const f = i === this.focus;\n      panel(hud, x, y, w, h, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      drawIcon(hud, x + 9, y + 4, e.icon, e.known ? e.colors : SIL, 2);\n      if (e.donated) hud.rect(x + w - 8, y + 4, 4, 4, 'green');\n    });\n    const e = list[this.focus];\n    if (e) {\n      const known = e.known;\n      drawText(hud, 240, 182 + (list.length > 12 ? 8 : 0) + 8, known ? e.name : '???', { align: 'center', color: 'ink' });\n      const y0 = 202 + (list.length > 12 ? 0 : -6);\n      textBlock(hud, 88, y0, 304, known ? `${e.line}` : 'Not yet. The page is waiting.', { color: 'slate' });\n      if (known) drawText(hud, 240, 234, `${e.where}${e.donated ? ' In the museum.' : ''}`, { align: 'center', color: 'plum' });\n    }\n  }\n  drawCalendar(g, hud) {\n    const today = villageDay(g.world.clock.day).calendarDay;\n    for (let d = 1; d <= 16; d++) {\n      const col = (d - 1) % 4, row = Math.floor((d - 1) / 4);\n      const x = 84 + col * 78, y = 46 + row * 46;\n      const f = d === today;\n      panel(hud, x, y, 74, 42, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      const v = villageDay(d);\n      drawText(hud, x + 5, y + 5, `${d} ${DAY_TYPES[v.type].split(' ')[0]}`, { color: 'ink' });\n      const note = YEAR_NOTES[d];\n      const words = note.split(' ');\n      let line = '', ln = 0;\n      for (const wd of words) {\n        if ((line + wd).length > 11) { drawText(hud, x + 5, y + 16 + ln * 11, line.trim(), { color: 'slate' }); ln++; line = ''; }\n        line += `${wd} `;\n      }\n      drawText(hud, x + 5, y + 16 + ln * 11, line.trim(), { color: 'slate' });\n    }\n    SEASON_NAMES.forEach((s, i) => drawText(hud, 82, 46 + i * 46 - 0, '', { color: 'ink' }));\n  }\n}\nexport const almanacScreen = () => new Almanac();\nEOF\ncat > src/ui/screens/emote.js <<'EOF'\n// The emote wheel: eight wedges. Unlearned ones are dark; you learn them at the theatre.\nimport { panel, drawText, inRect, dim } from '../draw.js';\n\nexport const ALL_EMOTES = ['wave', 'laugh', 'cry', 'shock', 'anger', 'love', 'shrug', 'bow', 'dance'];\nconst CLIP = { wave: 'Wave', laugh: 'Laugh', cry: 'Cry', shock: 'Shock', anger: 'Anger', love: 'Love', shrug: 'Shrug', bow: 'Bow', dance: 'Dance' };\nconst WHEEL = ['laugh', 'cry', 'shock', 'anger', 'love', 'shrug', 'bow', 'dance'];\nclass Wheel {\n  constructor() { this.id = 'emote'; this.focus = 0; }\n  labels() { return WHEEL; }\n  focusIndex() { return this.focus; }\n  pos(i) { const a = -Math.PI / 2 + (i / 8) * Math.PI * 2; return [240 + Math.cos(a) * 92 - 34, 135 + Math.sin(a) * 76 - 11, 68, 22]; }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.nav.right || inp.nav.down) { this.focus = (this.focus + 1) % 8; g.sound('uiTick'); }\n    if (inp.nav.left || inp.nav.up) { this.focus = (this.focus + 7) % 8; g.sound('uiTick'); }\n    // the stick picks a wedge directly\n    const ax = inp.axisX, ay = inp.axisY;\n    if (Math.hypot(ax, ay) > 0.6 && inp.device === 'pad') { const a = Math.atan2(-ay, ax) + Math.PI / 2; this.focus = (Math.round((a / (Math.PI * 2)) * 8) + 8) % 8; }\n    for (let i = 0; i < 8; i++) if (inRect(m, ...this.pos(i))) { if (m.moved) this.focus = i; if (m.click) { this.focus = i; this.pick(g); return; } }\n    if (inp.confirm || g.ctx.input.wasPressed('PadLeft', 'KeyG') && false) { this.pick(g); return; }\n    if (inp.back || inp.emote || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); }\n  }\n  pick(g) {\n    const em = WHEEL[this.focus];\n    if (!g.world.player.emotes.includes(em)) { g.sound('uiError'); g.ui.toastMsg('You haven\\'t learned that yet. Sir Reginald could teach you.'); return; }\n    g.ui.pop(this);\n    g.player.pose(CLIP[em]);\n    g.sound('uiConfirm');\n    g.events.emit('emoted', { em });\n    if (em === 'love') g.ctx.particles.burst('hearts', [g.player.x + g.place.ox, 2.2, g.player.z + g.place.oz]);\n    g.net?.emote?.(em);\n  }\n  prompts() { return [['confirm', 'Do it'], ['back', 'Close']]; }\n  draw(g, hud) {\n    for (let i = 0; i < 8; i++) {\n      const [x, y, w, h] = this.pos(i);\n      const f = i === this.focus;\n      const known = g.world.player.emotes.includes(WHEEL[i]);\n      panel(hud, x, y, w, h, { fill: f ? 'sand' : known ? 'white' : 'mist', trim: f ? 'orange' : 'slate' });\n      drawText(hud, x + w / 2, y + 7, known ? WHEEL[i] : '?', { align: 'center', color: known ? 'ink' : 'slate' });\n    }\n  }\n}\nexport const emoteWheel = () => new Wheel();\nexport { dim };\nEOF\ncat > src/ui/screens/pause.js <<'EOF'\n// Pause: Resume, Map, Almanac, Settings, Save & Quit, About, Dev Mode.\nimport { Menu } from '../ui.js';\nimport { mapScreen } from './map.js';\nimport { almanacScreen } from './almanac.js';\nimport { settingsScreen } from './settings.js';\nimport { aboutScreen } from './about.js';\nimport { devScreen } from './dev.js';\nimport { saveNow, markSessionClean } from '../../systems/session.js';\n\nexport function pauseMenu(g) {\n  const items = [\n    { label: 'Resume', action: (gg, m) => gg.ui.pop(m) },\n    { label: 'Map', action: (gg) => gg.ui.push(mapScreen(gg)) },\n    { label: 'Almanac', action: (gg) => gg.ui.push(almanacScreen(gg)) },\n    { label: 'Settings', action: (gg) => gg.ui.push(settingsScreen(gg)) },\n    { label: 'Save & Quit to Title', action: (gg) => { saveNow(gg); markSessionClean(gg); gg.quitToTitle(); } },\n    { label: 'About', action: (gg) => gg.ui.push(aboutScreen(gg)) },\n    { label: 'Dev Mode', action: (gg) => gg.ui.push(devScreen(gg)) },\n  ];\n  return new Menu({ id: 'pause', title: 'Paused', items, x: 150, y: 52, w: 180, itemH: 20, gap: 3, back: (gg, m) => gg.ui.pop(m), prompts: [['confirm', 'Select'], ['back', 'Resume']] });\n}\nEOF\ncat > src/ui/screens/settings.js <<'EOF'\n// Settings: everything a player wants, big and few to a page. Reset to defaults restores 10% music.\nimport { Menu } from '../ui.js';\nimport { tuning } from '../../dev/tuning.js';\nimport { store } from '../../core/storage.js';\nimport { DEFAULT_SETTINGS, DEFAULT_MUSIC } from '../../gameDefaults.js';\n\nconst pct = (v) => `${Math.round(v * 100)}%`;\nconst STYLES = ['gibberish', 'beeps', 'off'];\nconst SPEEDS = [null, 20, 35, 60, 120];\nconst speedName = (v) => (v == null ? 'Normal' : v <= 20 ? 'Slow' : v <= 35 ? 'Normal' : v <= 60 ? 'Quick' : 'Very quick');\nexport function settingsScreen(g) {\n  const a = g.ctx.audio;\n  const vol = (label, ch) => ({\n    label, value: (gg) => pct(a.volume[ch]),\n    left: () => { a.setVolume(ch, Math.max(0, Math.round((a.volume[ch] - 0.1) * 10) / 10)); g.sound('uiTick'); },\n    right: () => { a.setVolume(ch, Math.min(1, Math.round((a.volume[ch] + 0.1) * 10) / 10)); g.sound('uiTick'); },\n    action: () => {},\n  });\n  const toggle = (label, get, set, on = 'On', off = 'Off') => ({ label, value: () => (get() ? on : off), action: () => { set(!get()); g.saveSettings(); }, left: () => { set(!get()); g.saveSettings(); }, right: () => { set(!get()); g.saveSettings(); } });\n  const s = g.settings;\n  const items = [\n    vol('Music', 'music'),\n    vol('Effects', 'sfx'),\n    { label: 'Voices', value: () => pct(s.voices), left: () => { s.voices = Math.max(0, Math.round((s.voices - 0.1) * 10) / 10); g.saveSettings(); g.voice.syllable('a', 'player', ''); }, right: () => { s.voices = Math.min(1, Math.round((s.voices + 0.1) * 10) / 10); g.saveSettings(); g.voice.syllable('a', 'player', ''); }, action: () => {} },\n    { label: 'Voice style', value: () => ({ gibberish: 'Gibberish', beeps: 'Soft beeps', off: 'Off' }[s.voiceStyle]), left: () => cycle(-1), right: () => cycle(1), action: () => cycle(1) },\n    { label: 'Text speed', value: () => speedName(s.textSpeed), left: () => speed(-1), right: () => speed(1), action: () => speed(1) },\n    toggle('Controller glyphs', () => s.xbox, (v) => { s.xbox = v; }, 'Xbox', 'PlayStation'),\n    toggle('Rumble', () => s.rumble, (v) => { s.rumble = v; }),\n    toggle('Camera shake', () => s.shake, (v) => { s.shake = v; }),\n    { label: 'Clock', value: () => (g.world.clock.mode === 'real' ? 'Real Clock' : 'Village Time'), left: () => clock(), right: () => clock(), action: () => clock() },\n    { label: 'Fullscreen', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'On' : 'Off'), action: () => fullscreen(), left: () => fullscreen(), right: () => fullscreen() },\n    { label: 'Pixel size', value: () => (g.engine.settings.values.pixelSize === 'chunky' ? 'Chunky' : 'Fine'), action: () => pixel(), left: () => pixel(), right: () => pixel() },\n    { label: 'Picture quality', value: () => qualityName(), action: () => quality(1), left: () => quality(-1), right: () => quality(1) },\n    { label: 'Reset to defaults', action: () => reset() },\n    { label: 'Back', action: (gg, m) => gg.ui.pop(m) },\n  ];\n  function cycle(d) { const i = STYLES.indexOf(s.voiceStyle); s.voiceStyle = STYLES[(i + d + STYLES.length) % STYLES.length]; g.saveSettings(); g.voice.syllable('a', 'player', ''); }\n  function speed(d) { const i = SPEEDS.indexOf(s.textSpeed); s.textSpeed = SPEEDS[(Math.max(0, i) + d + SPEEDS.length) % SPEEDS.length]; g.saveSettings(); }\n  function clock() { const w = g.world; w.clock.mode = w.clock.mode === 'real' ? 'village' : 'real'; g.weatherKey = null; g.refreshSeason(); g.sound('uiTick'); g.events.emit('clockMode', { mode: w.clock.mode }); }\n  function fullscreen() { if (typeof document === 'undefined') return; if (document.fullscreenElement) document.exitFullscreen?.(); else document.documentElement.requestFullscreen?.(); }\n  function pixel() { const v = g.engine.settings.values.pixelSize === 'chunky' ? 'fine' : 'chunky'; g.engine.settings.set({ pixelSize: v }); }\n  function qualityName() { const q = g.engine.settings.values.quality ?? 'high'; return q[0].toUpperCase() + q.slice(1); }\n  function quality(d) { const list = ['low', 'medium', 'high']; const q = g.engine.settings.values.quality ?? 'high'; g.engine.settings.set({ quality: list[(list.indexOf(q) + d + 3) % 3] }); }\n  function reset() {\n    Object.assign(s, DEFAULT_SETTINGS);\n    g.saveSettings();\n    a.resetVolumes();\n    a.setVolume('music', DEFAULT_MUSIC);\n    g.engine.settings.reset();\n    g.events.emit('settingsReset', {});\n    g.ui.toastMsg('Back to how it was. Music at 10%.');\n  }\n  const m = new Menu({ id: 'settings', title: 'Settings', items, x: 110, y: 46, w: 260, itemH: 19, gap: 2, back: (gg, mm) => gg.ui.pop(mm), prompts: [['confirm', 'Change'], ['back', 'Back']] });\n  m.perPage = 8;\n  return m;\n}\nexport { tuning, store };\nEOF\ncat > src/gameDefaults.js <<'EOF'\nexport const DEFAULT_SETTINGS = { voices: 1, voiceStyle: 'gibberish', textSpeed: null, xbox: false, rumble: true, shake: true };\nexport const DEFAULT_MUSIC = 0.1;\nEOF\npython3 - <<'EOF'\np='src/game.js'\ns=open(p).read()\ns=s.replace(\"export const DEFAULT_SETTINGS = { voices: 1, voiceStyle: 'gibberish', textSpeed: null, xbox: false, rumble: true, shake: true };\\nexport const DEFAULT_MUSIC = 0.1;\\n\",\"\")\ns=s.replace(\"const SETTINGS_KEY = 'honk:settings';\",\"const SETTINGS_KEY = 'honk:settings';\\nimport { DEFAULT_SETTINGS, DEFAULT_MUSIC } from './gameDefaults.js';\")\nopen(p,'w').write(s)\nEOF\necho ok","description":"Write number, keyboard, letter, mail, map, almanac, pause and settings screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19824,"cache_read_input_tokens":609723,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19824},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"7c91ac33-fca7-4129-8702-6bf37875bd94","timestamp":"2026-11-06T01:24:03.042Z","request_id":"req_011CgkoFPB1EwtLjef6HHNi9","wire_tool_inputs":{"toolu_01KsQg4XEiriXQ5a9k6KVTUf":{"command":"cat > src/ui/screens/numbers.js <<'EOF'\n// A big number with up and down; and a plain free-standing menu.\nimport { panel, drawText, inRect, dim } from '../draw.js';\nimport { Menu } from '../ui.js';\n\nclass NumberScreen {\n  constructor({ title, max, step, onDone }) { this.id = 'number'; this.title = title; this.max = max; this.step = step; this.value = Math.min(max, step * 10); this.onDone = onDone; }\n  focusIndex() { return this.value; }\n  labels() { return [String(this.value)]; }\n  update(g, inp) {\n    const m = inp.mouse;\n    const big = this.step * 10;\n    let v = this.value;\n    if (inp.nav.up) v += this.step;\n    if (inp.nav.down) v -= this.step;\n    if (inp.nav.right) v += big;\n    if (inp.nav.left) v -= big;\n    if (m.click) {\n      if (inRect(m, 160, 100, 30, 30)) v -= big;\n      if (inRect(m, 290, 100, 30, 30)) v += big;\n      if (inRect(m, 200, 154, 80, 22)) { g.sound('uiConfirm'); g.ui.pop(this); this.onDone(this.value); return; }\n    }\n    if (g.ctx.input.wasPressed('KeyM') || inp.square) v = this.max;\n    v = Math.max(0, Math.min(this.max, v));\n    if (v !== this.value) { this.value = v; g.sound('uiTick'); }\n    if (inp.confirm) { g.sound('uiConfirm'); g.ui.pop(this); this.onDone(this.value); return; }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onDone(0); }\n  }\n  prompts() { return [['confirm', 'OK'], ['fill', 'All of it'], ['back', 'Cancel']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 120, 60, 240, 130, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 70, this.title, { align: 'center', color: 'ink' });\n    drawText(hud, 240, 104, this.value.toLocaleString('en-US'), { align: 'center', color: 'ink', scale: 3 });\n    drawText(hud, 240, 132, `of ${this.max.toLocaleString('en-US')}`, { align: 'center', color: 'slate' });\n    panel(hud, 160, 100, 30, 30, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 175, 110, '<', { align: 'center', color: 'ink' });\n    panel(hud, 290, 100, 30, 30, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 305, 110, '>', { align: 'center', color: 'ink' });\n    panel(hud, 200, 154, 80, 22, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 240, 161, 'OK', { align: 'center', color: 'ink' });\n  }\n}\nexport function* numberPicker(g, { title, max, step = 100 }) {\n  if (max <= 0) return 0;\n  let done = null;\n  g.ui.push(new NumberScreen({ title, max, step: Math.min(step, Math.max(1, max)), onDone: (v) => { done = v; } }));\n  while (done === null) yield;\n  return done;\n}\nexport function* menuChoiceFree(g, title, labels, o = {}) {\n  let result = -2;\n  const items = labels.map((l, i) => ({ label: l, action: (gg, m) => { result = i; gg.ui.pop(m); } }));\n  g.ui.push(new Menu({ id: o.id ?? 'choice', title, items, x: o.x ?? 130, y: o.y ?? 70, w: o.w ?? 220, back: (gg, m) => { result = -1; gg.ui.pop(m); } }));\n  while (result === -2) yield;\n  return result;\n}\nEOF\ncat > src/ui/screens/keyboard.js <<'EOF'\n// The on-screen keyboard: a chunky grid for the pad, real typing for the keyboard.\nimport { panel, drawText, inRect, dim, textWidth } from '../draw.js';\n\nconst ROWS = ['ABCDEFGHIJKLM', 'NOPQRSTUVWXYZ', 'abcdefghijklm', 'nopqrstuvwxyz', \"0123456789.,!\", \"?'-&() _\"];\nconst CELL = 24;\nclass Keyboard {\n  constructor({ title, max = 12, value = '', hint = '', random = null, onDone, onCancel, multi = false }) {\n    this.id = 'keyboard'; this.title = title; this.max = max; this.value = value; this.hint = hint; this.random = random; this.onDone = onDone; this.onCancel = onCancel;\n    this.cx = 0; this.cy = 0;\n    this.multi = multi;\n    this.randomI = 0;\n  }\n  labels() { return ROWS; }\n  currentText() { return this.value; }\n  focusIndex() { return this.cy * 20 + this.cx; }\n  rect(cx, cy) { return [240 - (13 * CELL) / 2 + cx * CELL, 90 + cy * CELL, CELL - 2, CELL - 2]; }\n  type(g, ch) { if (this.value.length < this.max) { this.value += ch; g.sound('uiTick'); } else g.sound('uiError'); }\n  rowsAt(y) { return y < ROWS.length ? ROWS[y].length : 2; }\n  commit(g) { const v = this.value.trim(); if (!v) { g.sound('uiError'); return; } g.sound('uiConfirm'); g.ui.pop(this); this.onDone(v); }\n  update(g, inp) {\n    for (const k of inp.keysTyped) {\n      if (k === 'Enter') { this.commit(g); return; }\n      if (k === 'Backspace') { this.value = this.value.slice(0, -1); g.sound('uiTick'); continue; }\n      if (k.length === 1 && /[A-Za-z0-9 .,!?'&()_-]/.test(k)) this.type(g, k);\n    }\n    const typing = inp.keysTyped.length > 0;\n    if (inp.nav.right && !typing) { this.cx++; g.sound('uiTick'); }\n    if (inp.nav.left && !typing) { this.cx--; g.sound('uiTick'); }\n    if (inp.nav.up && !typing) { this.cy = (this.cy + ROWS.length) % (ROWS.length + 1); g.sound('uiTick'); }\n    if (inp.nav.down && !typing) { this.cy = (this.cy + 1) % (ROWS.length + 1); g.sound('uiTick'); }\n    const len = this.rowsAt(this.cy);\n    this.cx = ((this.cx % len) + len) % len;\n    const m = inp.mouse;\n    if (m.moved || m.click) for (let y = 0; y < ROWS.length; y++) for (let x = 0; x < ROWS[y].length; x++) if (inRect(m, ...this.rect(x, y))) { this.cx = x; this.cy = y; if (m.click) this.type(g, ROWS[y][x]); }\n    const r0 = [150, 90 + ROWS.length * CELL + 2, 80, 20], r1 = [250, 90 + ROWS.length * CELL + 2, 80, 20];\n    if (m.click && inRect(m, ...r0)) { this.value = this.value.slice(0, -1); g.sound('uiTick'); }\n    if (m.click && inRect(m, ...r1)) { this.commit(g); return; }\n    if (inp.confirm && !inp.keysTyped.includes('Enter')) {\n      if (this.cy >= ROWS.length) { if (this.cx === 0) { this.value = this.value.slice(0, -1); g.sound('uiTick'); } else { this.commit(g); return; } }\n      else this.type(g, ROWS[this.cy][this.cx]);\n    }\n    if (inp.square) { this.value = this.value.slice(0, -1); g.sound('uiTick'); }\n    if (inp.triangle && this.random) { this.value = this.random[this.randomI++ % this.random.length]; g.sound('uiConfirm'); }\n    if (g.ctx.input.wasPressed('Tab') && this.random) { this.value = this.random[this.randomI++ % this.random.length]; g.sound('uiConfirm'); }\n    if (g.ctx.input.wasPressed('PadCircle') || (m.rclick) || g.ctx.input.wasPressed('Escape')) {\n      if (this.onCancel) { g.sound('uiCancel'); g.ui.pop(this); this.onCancel(); }\n      else if (this.value) { this.value = this.value.slice(0, -1); g.sound('uiTick'); }\n    }\n  }\n  prompts() {\n    const p = [['confirm', 'Type'], ['fill', 'Rub out']];\n    if (this.random) p.push(['random', 'Suggest']);\n    return p;\n  }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 60, 14, 360, 240, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 24, this.title, { align: 'center', color: 'ink', scale: 1 });\n    panel(hud, 80, 40, 320, 26, { fill: 'sand', trim: 'orange' });\n    const shown = this.value.length > 44 ? `…${this.value.slice(-44)}` : this.value;\n    const w = textWidth(shown);\n    drawText(hud, 88, 49, shown, { color: 'ink' });\n    if (Math.floor(g.ctx.time * 2) % 2 === 0) hud.rect(89 + w, 48, 2, 9, 'plum');\n    if (this.hint) drawText(hud, 240, 74, this.hint, { align: 'center', color: 'slate' });\n    ROWS.forEach((row, y) => [...row].forEach((ch, x) => {\n      const [rx, ry, rw, rh] = this.rect(x, y);\n      const f = this.cy === y && this.cx === x;\n      panel(hud, rx, ry, rw, rh, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      drawText(hud, rx + rw / 2, ry + 7, ch === ' ' ? '_' : ch, { align: 'center', color: 'ink' });\n    }));\n    const by = 90 + ROWS.length * CELL + 2;\n    const f0 = this.cy === ROWS.length && this.cx === 0, f1 = this.cy === ROWS.length && this.cx === 1;\n    panel(hud, 150, by, 80, 20, { fill: f0 ? 'sand' : 'white', trim: f0 ? 'orange' : 'mist' });\n    drawText(hud, 190, by + 6, 'Rub out', { align: 'center', color: 'ink' });\n    panel(hud, 250, by, 80, 20, { fill: f1 ? 'sand' : 'white', trim: f1 ? 'orange' : 'mist' });\n    drawText(hud, 290, by + 6, 'Done', { align: 'center', color: 'ink' });\n  }\n}\nexport function* keyboardFlow(g, opts) {\n  let result = null;\n  g.ui.push(new Keyboard({ ...opts, onDone: (v) => { result = v; }, onCancel: opts.canCancel ? () => { result = ''; } : null }));\n  while (result === null) yield;\n  return result;\n}\nexport const openKeyboard = (g, opts) => g.ui.push(new Keyboard(opts));\nEOF\ncat > src/ui/screens/letter.js <<'EOF'\n// Letters: choose who, write on a sheet of paper with big type, attach a gift.\nimport { panel, drawText, inRect, dim, textBlock, wrap } from '../draw.js';\nimport { keyboardFlow } from './keyboard.js';\nimport { menuChoiceFree } from './numbers.js';\nimport { NEIGHBOURS, NEIGHBOUR_ORDER } from '../../data/neighbours.js';\nimport { ITEMS } from '../../data/items.js';\nimport { removeSlot } from '../../systems/economy.js';\nimport { pocketsPicker } from './pockets.js';\nimport { replyTo } from '../../systems/mail.js';\nimport { completeErrand } from '../../systems/dayone.js';\nimport { say } from '../../systems/say.js';\nimport { remember } from '../../systems/memory.js';\nimport { hostLine } from '../../systems/lines.js';\n\nexport function* letterFlow(g) {\n  const w = g.world;\n  const others = NEIGHBOUR_ORDER.filter((n) => w.npcs[n].moved === 'here');\n  const labels = ['Gran', ...others.map((n) => NEIGHBOURS[n].name), 'Never mind'];\n  const list = ['gran', ...others];\n  const c = yield* menuChoiceFree(g, 'Write to whom?', labels, { id: 'letterTo' });\n  if (c < 0 || c >= list.length) return;\n  const to = list[c];\n  const text = yield* keyboardFlow(g, { title: `Dear ${labels[c]},`, max: 120, hint: 'Say whatever you like. Clementine will read it, and so will the bee.', random: ['Everything is fine.', 'I owe a goose.', 'It rained. Then it stopped.', 'Send fruit.'], canCancel: true });\n  if (!text) return;\n  // Gift?\n  let gift = null;\n  const a = yield* menuChoiceFree(g, 'Attach a gift?', ['Yes', 'No']);\n  if (a === 0) {\n    let picked = -2;\n    g.ui.push(pocketsPicker(g, { title: 'Attach what?', filter: (s) => ITEMS[s.id]?.cat !== 'tool' && ITEMS[s.id]?.cat !== 'quest', onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n    while (picked === -2) yield;\n    if (picked >= 0) { gift = removeSlot(g, picked).id; }\n  }\n  let closed = false;\n  g.ui.push(new PaperScreen(labels[c], text, gift, () => { closed = true; }));\n  while (!closed) yield;\n  g.sound('stamp');\n  replyTo(g, to, text, gift);\n  w.mail.sentToday += 1;\n  w.stats.lettersSent = (w.stats.lettersSent ?? 0) + 1;\n  remember(g, 'letter', { about: to === 'gran' ? null : to });\n  g.events.emit('letterSent', { to, text, gift });\n  if (w.story.day1Active && to === 'gran') completeErrand(g, 'letter');\n  if (g.place?.id === 'hall') yield* say(g, 'clementine', hostLine(g, 'clementine', 'post'));\n}\nclass PaperScreen {\n  constructor(name, text, gift, onDone) { this.id = 'paper'; this.name = name; this.text = text; this.gift = gift; this.onDone = onDone; }\n  currentText() { return this.text; }\n  update(g, inp) { if (inp.confirm || inp.back || inp.mouse.click) { g.ui.pop(this); this.onDone(); } }\n  prompts() { return [['confirm', 'Post it']]; }\n  draw(g, hud) {\n    dim(hud);\n    drawPaper(hud, `Dear ${this.name},`, this.text, g.world.player.name, this.gift ? `Enclosed: ${ITEMS[this.gift]?.name}` : '');\n  }\n}\nexport function drawPaper(hud, head, body, sign, foot) {\n  panel(hud, 70, 22, 340, 214, { fill: 'white', trim: 'sand' });\n  for (let y = 58; y < 200; y += 14) hud.rect(84, y, 312, 1, 'mist');\n  drawText(hud, 88, 34, head, { color: 'ink', scale: 1 });\n  const lines = wrap(body, 300);\n  lines.slice(0, 11).forEach((l, i) => drawText(hud, 88, 50 + i * 14, l, { color: 'ink' }));\n  if (sign) drawText(hud, 392, 206, sign, { color: 'plum', align: 'right' });\n  if (foot) drawText(hud, 88, 218, foot, { color: 'slate' });\n}\nexport { inRect, textBlock };\nEOF\ncat > src/ui/screens/mail.js <<'EOF'\n// The mailbox: a stack of letters on a sheet of paper, big type.\nimport { panel, drawText, dim, inRect } from '../draw.js';\nimport { drawPaper } from './letter.js';\nimport { resolveTags } from '../../systems/lines.js';\nimport { senderName } from '../../systems/mail.js';\nimport { ITEMS } from '../../data/items.js';\nimport { addItem, hasRoom, addBeans } from '../../systems/economy.js';\nimport { Menu } from '../ui.js';\n\nclass Reader {\n  constructor(letter, onDone) { this.id = 'letterRead'; this.letter = letter; this.onDone = onDone; }\n  currentText() { return this.letter.body; }\n  open(g) { g.sound('paper'); if (!this.letter.read) { this.letter.read = true; g.events.emit('letterRead', { from: this.letter.from }); } }\n  update(g, inp) {\n    if (inp.confirm || inp.back || inp.mouse.click || inp.mouse.rclick) {\n      g.ui.pop(this);\n      const l = this.letter;\n      if (l.gift && !l.taken) {\n        const id = typeof l.gift === 'string' ? l.gift : l.gift.id;\n        if (typeof l.gift === 'object' && l.gift.beans) { addBeans(g, l.gift.beans, 'mail'); g.sound('beanLots'); l.taken = true; g.ui.toastMsg(`+${l.gift.beans.toLocaleString('en-US')} beans`); }\n        else if (hasRoom(g.world)) { addItem(g, id, typeof l.gift === 'object' && l.gift.from ? { from: l.gift.from } : null); l.taken = true; g.sound('pickUp'); g.ui.toastMsg(`You take the ${ITEMS[id]?.name ?? 'present'}.`); g.events.emit('giftOpened', { id, from: l.from }); }\n        else g.ui.toastMsg('Your pockets are full. It stays in the letter.');\n      }\n      this.onDone?.();\n    }\n  }\n  prompts() { return [['confirm', 'Fold it up']]; }\n  draw(g, hud) {\n    dim(hud);\n    const l = this.letter;\n    const body = resolveTags(l.body, g);\n    const parts = body.split('\\n');\n    const sign = parts.length > 1 ? parts[parts.length - 1] : '';\n    const text = parts.slice(0, parts.length > 1 ? -1 : undefined).join(' ');\n    const gift = l.gift && !l.taken ? (typeof l.gift === 'object' && l.gift.beans ? `Enclosed: ${l.gift.beans.toLocaleString('en-US')} beans` : `Enclosed: ${ITEMS[typeof l.gift === 'string' ? l.gift : l.gift.id]?.name ?? 'something'}`) : '';\n    drawPaper(hud, `From ${senderName(l.from)}`, text, sign, gift);\n  }\n}\nexport function mailScreen(g, onClose) {\n  const w = g.world;\n  const close = (gg, m) => { gg.ui.pop(m); onClose?.(); };\n  const rebuild = () => w.mail.inbox.slice(-8).reverse().map((l) => ({\n    label: `${l.read ? '' : '* '}${senderName(l.from)}`,\n    icon: 'letter', iconColors: { o: 'red', x: 'mist', w: 'white' },\n    action: (gg) => { gg.ui.push(new Reader(l)); },\n  }));\n  const items = rebuild();\n  if (!items.length) items.push({ label: 'Nothing. Not even a bill. Enjoy it.', action: close });\n  return new Menu({ id: 'mailbox', title: 'The mailbox', items, x: 120, y: 60, w: 240, itemH: 20, back: close, prompts: [['confirm', 'Read'], ['back', 'Close']] });\n}\nexport { panel, drawText, inRect };\nEOF\ncat > src/ui/screens/map.js <<'EOF'\n// The map: a pixel map, pins, who's where now.\nimport { panel, drawText, inRect, dim, textWidth } from '../draw.js';\nimport { COLS, ROWS, tileChar } from '../../world/tiles.js';\nimport { BUILDINGS, LANDMARKS, ACRE_NAMES } from '../../data/town.js';\nimport { NEIGHBOUR_ORDER, NEIGHBOURS } from '../../data/neighbours.js';\n\nconst LEGEND = { '.': 'green', ':': 'lime', '=': 'sand', '\"': 'sand', _: 'mist', s: 'sand', '~': 'blue', w: 'sky', o: 'sky', m: 'blue', t: 'sky', W: 'sky', f: 'white', B: 'orange', '^': 'sand', b: 'orange', d: 'orange', C: 'slate', '#': 'teal', H: 'teal', X: 'plum' };\nconst SEASON_LAWN = ['lime', 'green', 'sand', 'white'];\nconst SEASON_HIGH = ['lime', 'lime', 'orange', 'mist'];\nconst CHAR_MAP = { '.': 'a', ':': 'b', '=': 'c', '\"': 'c', _: 'd', s: 'c', '~': 'e', w: 'f', o: 'f', m: 'e', t: 'f', W: 'f', f: 'g', B: 'h', '^': 'c', b: 'h', d: 'h', C: 'i', '#': 'j', H: 'j' };\nlet rowsCache = null;\nfunction mapRows() {\n  if (rowsCache) return rowsCache;\n  const s = 3;\n  const grid = [];\n  for (let z = 0; z < ROWS; z++) { let line = ''; for (let x = 0; x < COLS; x++) line += (CHAR_MAP[tileChar(x, z)] ?? 'a').repeat(s); for (let i = 0; i < s; i++) grid.push(line); }\n  const out = grid.map((l) => l.split(''));\n  for (const b of BUILDINGS) for (let z = b.z * s; z < (b.z + b.d) * s; z++) for (let x = b.x * s; x < (b.x + b.w) * s; x++) out[z][x] = 'k';\n  rowsCache = out.map((l) => l.join(''));\n  return rowsCache;\n}\nclass MapScreen {\n  constructor(g) {\n    this.id = 'map';\n    this.focus = 0;\n    this.pins = [];\n    for (const b of BUILDINGS) this.pins.push({ name: b.id === 'home' ? 'Your place' : b.name, x: b.x + b.w / 2, z: b.z + b.d / 2, kind: 'b' });\n    this.pins.push({ name: 'Bus stop', x: LANDMARKS.busStop[0], z: LANDMARKS.busStop[1], kind: 'b' });\n    this.pins.push({ name: 'The Old Pear', x: LANDMARKS.oldPear[0], z: LANDMARKS.oldPear[1], kind: 'b' });\n    this.pins.push({ name: 'The Lookout', x: LANDMARKS.lookoutBench[0], z: LANDMARKS.lookoutBench[1], kind: 'b' });\n    this.pins.push({ name: 'The Lighthouse', x: LANDMARKS.lighthouse[0], z: LANDMARKS.lighthouse[1], kind: 'b' });\n    for (const id of NEIGHBOUR_ORDER) if (g.world.npcs[id].moved === 'here') { const a = g.npcs.actor(id); const inside = g.npcs.get(id).inside; this.pins.push({ name: inside ? `${NEIGHBOURS[id].name}, indoors` : NEIGHBOURS[id].name, x: a.x, z: a.z, kind: 'n', dim: inside }); }\n    this.focusPin = this.pins.findIndex((p) => p.kind === 'n');\n    if (this.focusPin < 0) this.focusPin = 0;\n  }\n  focusIndex() { return this.focusPin; }\n  labels() { return this.pins.map((p) => p.name); }\n  update(g, inp) {\n    if (inp.nav.right || inp.nav.down) { this.focusPin = (this.focusPin + 1) % this.pins.length; g.sound('uiTick'); }\n    if (inp.nav.left || inp.nav.up) { this.focusPin = (this.focusPin + this.pins.length - 1) % this.pins.length; g.sound('uiTick'); }\n    const m = inp.mouse;\n    if (m.moved) this.pins.forEach((p, i) => { const [x, y] = this.at(p); if (Math.hypot(m.x - x, m.y - y) < 5) this.focusPin = i; });\n    if (inp.back || inp.map || inp.confirm || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); }\n  }\n  at(p) { return [120 + Math.round(p.x * 3), 22 + Math.round(p.z * 3)]; }\n  prompts() { return [['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 112, 14, 256, 208, { fill: 'navy', trim: 'sand' });\n    const season = g.season;\n    hud.sprite(120, 22, mapRows(), { a: SEASON_LAWN[season], b: SEASON_HIGH[season], c: 'sand', d: 'mist', e: 'blue', f: 'sky', g: 'white', h: 'orange', i: 'slate', j: 'teal', k: 'plum' }, { shadow: false });\n    this.pins.forEach((p, i) => {\n      const [x, y] = this.at(p);\n      if (i === this.focusPin) { hud.rect(x - 3, y - 3, 7, 7, 'ink'); hud.rect(x - 2, y - 2, 5, 5, 'sand'); }\n      else if (p.kind === 'n') { hud.rect(x - 1, y - 1, 3, 3, p.dim ? 'slate' : 'red'); }\n    });\n    if (g.place === g.town) {\n      const [x, y] = this.at({ x: g.player.x, z: g.player.z });\n      const on = Math.floor(g.ctx.time * 3) % 2 === 0;\n      hud.rect(x - 2, y - 2, 5, 5, on ? 'white' : 'ink');\n    }\n    const name = this.pins[this.focusPin].name;\n    const col = Math.max(0, Math.min(4, Math.floor(g.player.x / 16))), row = Math.max(0, Math.min(3, Math.floor(g.player.z / 16)));\n    const where = g.place === g.town ? `You are in ${ACRE_NAMES[row][col]}.` : `You are at ${g.place.def?.name ?? g.place.name}.`;\n    panel(hud, 112, 224, 256, 26, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 228, name, { align: 'center', color: 'ink' });\n    drawText(hud, 240, 238, where, { align: 'center', color: 'slate' });\n  }\n}\nexport const mapScreen = (g) => new MapScreen(g);\nexport { LEGEND, inRect, textWidth };\nEOF\ncat > src/ui/screens/almanac.js <<'EOF'\n// The Almanac: tabs, big silhouettes that fill in. Fish, Bugs, Fossils, Art, Stars, Calendar.\nimport { panel, drawText, inRect, dim, textBlock } from '../draw.js';\nimport { drawIcon } from '../../art/icons.js';\nimport { FISH } from '../../data/fish.js';\nimport { BUGS } from '../../data/bugs.js';\nimport { FOSSILS } from '../../data/fossils.js';\nimport { ART } from '../../data/art.js';\nimport { CONSTELLATIONS } from '../../systems/stargaze.js';\nimport { ITEMS } from '../../data/items.js';\nimport { SEASON_NAMES, DAY_TYPES, villageDay } from '../../core/calendar.js';\n\nconst TABS = ['Fish', 'Bugs', 'Fossils', 'Art', 'Stars', 'Calendar'];\nconst SIL = { o: 'night', x: 'night', w: 'night', '#': 'ink' };\nconst when = (d) => { const seas = d.seasons?.map((s) => SEASON_NAMES[s]).join(', ') ?? ''; const h = d.hours ? (d.hours[0] > 16 ? ', evenings' : d.hours[1] < 12 ? ', mornings' : ', daytime') : ''; return `${seas}${h}`; };\nconst YEAR_NOTES = { 1: 'Arrival', 2: 'Museum opens', 3: 'Set the Chime; Vesper', 4: 'The Seed Toss', 5: 'Season turns; Old Rind', 6: 'Fishing Derby', 7: 'Vesper', 8: 'The Lantern Float', 9: 'Fitch moves in', 10: 'Bug-Off', 11: 'Vesper', 12: 'The Great Soup', 13: 'First snow', 14: 'Snowman Contest', 15: 'Vesper', 16: 'The Long Night' };\nclass Almanac {\n  constructor() { this.id = 'almanac'; this.tab = 0; this.focus = 0; this.cols = 6; }\n  labels() { return TABS; }\n  focusIndex() { return this.tab * 100 + this.focus; }\n  entries(g) {\n    const w = g.world;\n    switch (this.tab) {\n      case 0: return FISH.map((f) => ({ id: f.id, name: f.name, known: !!w.almanac.fish[f.id], icon: f.icon, colors: ITEMS[f.id].iconColors, line: f.line, where: `${f.where === 'mouth' ? 'River mouth' : f.where[0].toUpperCase() + f.where.slice(1)}. ${when(f)}.`, donated: w.museum.fish[f.id], beans: f.beans }));\n      case 1: return BUGS.map((b) => ({ id: b.id, name: b.name, known: !!w.almanac.bug[b.id], icon: b.icon, colors: ITEMS[b.id].iconColors, line: b.line, where: `On ${b.spot === 'near' ? 'the banks' : b.spot}. ${when(b)}.`, donated: w.museum.bug[b.id], beans: b.beans }));\n      case 2: return FOSSILS.map((f) => ({ id: f.id, name: f.name, known: !!w.almanac.fossil[f.id], icon: f.set ? 'bone' : 'ammonite', colors: { o: 'sand', x: 'orange' }, line: f.line, where: f.set ? (f.set === 'moatosaur' ? 'Part of the Moatosaur.' : 'Part of the Long-Necked Regretodon.') : 'A piece on its own.', donated: w.museum.fossil[f.id], beans: f.beans }));\n      case 3: return ART.map((a) => ({ id: a.id, name: a.name, known: !!w.almanac.art[a.id], icon: 'picture', colors: { o: 'sky', x: 'orange' }, line: a.line, where: 'Sold after dark, in an alley. Compare it with the print.', donated: w.museum.art[a.id], beans: a.beans }));\n      case 4: return CONSTELLATIONS.map((c) => ({ id: c.id, name: c.name, known: !!w.almanac.stars[c.id], icon: 'star', colors: { o: 'sand', x: 'white' }, line: 'Up at the Lookout, on a clear night.', where: 'Named by you, more or less.', donated: false }));\n      default: return [];\n    }\n  }\n  update(g, inp) {\n    if (inp.tabPrev) { this.tab = (this.tab + TABS.length - 1) % TABS.length; this.focus = 0; g.sound('almanacTurn'); }\n    if (inp.tabNext) { this.tab = (this.tab + 1) % TABS.length; this.focus = 0; g.sound('almanacTurn'); }\n    const n = this.entries(g).length;\n    if (n) {\n      if (inp.nav.right) { this.focus = (this.focus + 1) % n; g.sound('uiTick'); }\n      if (inp.nav.left) { this.focus = (this.focus + n - 1) % n; g.sound('uiTick'); }\n      if (inp.nav.down) { this.focus = Math.min(n - 1, this.focus + this.cols); g.sound('uiTick'); }\n      if (inp.nav.up) { this.focus = Math.max(0, this.focus - this.cols); g.sound('uiTick'); }\n    }\n    const m = inp.mouse;\n    TABS.forEach((_, i) => { if (m.click && inRect(m, 78 + i * 54, 20, 52, 18)) { this.tab = i; this.focus = 0; g.sound('almanacTurn'); } });\n    for (let i = 0; i < n; i++) if (inRect(m, ...this.rect(i))) { if (m.moved || m.click) this.focus = i; }\n    if (inp.back || inp.almanac || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); }\n  }\n  rect(i) { return [84 + (i % this.cols) * 52, 44 + Math.floor(i / this.cols) * 42, 50, 40]; }\n  prompts() { return [['tabs', 'Turn page'], ['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 70, 14, 340, 240, { fill: 'white', trim: 'sand' });\n    TABS.forEach((t, i) => {\n      const on = this.tab === i;\n      panel(hud, 78 + i * 54, 20, 52, 18, { fill: on ? 'sand' : 'white', trim: on ? 'orange' : 'mist' });\n      drawText(hud, 78 + i * 54 + 26, 26, t, { align: 'center', color: 'ink' });\n    });\n    if (this.tab === 5) { this.drawCalendar(g, hud); return; }\n    const list = this.entries(g);\n    list.forEach((e, i) => {\n      const [x, y, w, h] = this.rect(i);\n      const f = i === this.focus;\n      panel(hud, x, y, w, h, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      drawIcon(hud, x + 9, y + 4, e.icon, e.known ? e.colors : SIL, 2);\n      if (e.donated) hud.rect(x + w - 8, y + 4, 4, 4, 'green');\n    });\n    const e = list[this.focus];\n    if (e) {\n      const known = e.known;\n      drawText(hud, 240, 182 + (list.length > 12 ? 8 : 0) + 8, known ? e.name : '???', { align: 'center', color: 'ink' });\n      const y0 = 202 + (list.length > 12 ? 0 : -6);\n      textBlock(hud, 88, y0, 304, known ? `${e.line}` : 'Not yet. The page is waiting.', { color: 'slate' });\n      if (known) drawText(hud, 240, 234, `${e.where}${e.donated ? ' In the museum.' : ''}`, { align: 'center', color: 'plum' });\n    }\n  }\n  drawCalendar(g, hud) {\n    const today = villageDay(g.world.clock.day).calendarDay;\n    for (let d = 1; d <= 16; d++) {\n      const col = (d - 1) % 4, row = Math.floor((d - 1) / 4);\n      const x = 84 + col * 78, y = 46 + row * 46;\n      const f = d === today;\n      panel(hud, x, y, 74, 42, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      const v = villageDay(d);\n      drawText(hud, x + 5, y + 5, `${d} ${DAY_TYPES[v.type].split(' ')[0]}`, { color: 'ink' });\n      const note = YEAR_NOTES[d];\n      const words = note.split(' ');\n      let line = '', ln = 0;\n      for (const wd of words) {\n        if ((line + wd).length > 11) { drawText(hud, x + 5, y + 16 + ln * 11, line.trim(), { color: 'slate' }); ln++; line = ''; }\n        line += `${wd} `;\n      }\n      drawText(hud, x + 5, y + 16 + ln * 11, line.trim(), { color: 'slate' });\n    }\n    SEASON_NAMES.forEach((s, i) => drawText(hud, 82, 46 + i * 46 - 0, '', { color: 'ink' }));\n  }\n}\nexport const almanacScreen = () => new Almanac();\nEOF\ncat > src/ui/screens/emote.js <<'EOF'\n// The emote wheel: eight wedges. Unlearned ones are dark; you learn them at the theatre.\nimport { panel, drawText, inRect, dim } from '../draw.js';\n\nexport const ALL_EMOTES = ['wave', 'laugh', 'cry', 'shock', 'anger', 'love', 'shrug', 'bow', 'dance'];\nconst CLIP = { wave: 'Wave', laugh: 'Laugh', cry: 'Cry', shock: 'Shock', anger: 'Anger', love: 'Love', shrug: 'Shrug', bow: 'Bow', dance: 'Dance' };\nconst WHEEL = ['laugh', 'cry', 'shock', 'anger', 'love', 'shrug', 'bow', 'dance'];\nclass Wheel {\n  constructor() { this.id = 'emote'; this.focus = 0; }\n  labels() { return WHEEL; }\n  focusIndex() { return this.focus; }\n  pos(i) { const a = -Math.PI / 2 + (i / 8) * Math.PI * 2; return [240 + Math.cos(a) * 92 - 34, 135 + Math.sin(a) * 76 - 11, 68, 22]; }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.nav.right || inp.nav.down) { this.focus = (this.focus + 1) % 8; g.sound('uiTick'); }\n    if (inp.nav.left || inp.nav.up) { this.focus = (this.focus + 7) % 8; g.sound('uiTick'); }\n    // the stick picks a wedge directly\n    const ax = inp.axisX, ay = inp.axisY;\n    if (Math.hypot(ax, ay) > 0.6 && inp.device === 'pad') { const a = Math.atan2(-ay, ax) + Math.PI / 2; this.focus = (Math.round((a / (Math.PI * 2)) * 8) + 8) % 8; }\n    for (let i = 0; i < 8; i++) if (inRect(m, ...this.pos(i))) { if (m.moved) this.focus = i; if (m.click) { this.focus = i; this.pick(g); return; } }\n    if (inp.confirm || g.ctx.input.wasPressed('PadLeft', 'KeyG') && false) { this.pick(g); return; }\n    if (inp.back || inp.emote || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); }\n  }\n  pick(g) {\n    const em = WHEEL[this.focus];\n    if (!g.world.player.emotes.includes(em)) { g.sound('uiError'); g.ui.toastMsg('You haven\\'t learned that yet. Sir Reginald could teach you.'); return; }\n    g.ui.pop(this);\n    g.player.pose(CLIP[em]);\n    g.sound('uiConfirm');\n    g.events.emit('emoted', { em });\n    if (em === 'love') g.ctx.particles.burst('hearts', [g.player.x + g.place.ox, 2.2, g.player.z + g.place.oz]);\n    g.net?.emote?.(em);\n  }\n  prompts() { return [['confirm', 'Do it'], ['back', 'Close']]; }\n  draw(g, hud) {\n    for (let i = 0; i < 8; i++) {\n      const [x, y, w, h] = this.pos(i);\n      const f = i === this.focus;\n      const known = g.world.player.emotes.includes(WHEEL[i]);\n      panel(hud, x, y, w, h, { fill: f ? 'sand' : known ? 'white' : 'mist', trim: f ? 'orange' : 'slate' });\n      drawText(hud, x + w / 2, y + 7, known ? WHEEL[i] : '?', { align: 'center', color: known ? 'ink' : 'slate' });\n    }\n  }\n}\nexport const emoteWheel = () => new Wheel();\nexport { dim };\nEOF\ncat > src/ui/screens/pause.js <<'EOF'\n// Pause: Resume, Map, Almanac, Settings, Save & Quit, About, Dev Mode.\nimport { Menu } from '../ui.js';\nimport { mapScreen } from './map.js';\nimport { almanacScreen } from './almanac.js';\nimport { settingsScreen } from './settings.js';\nimport { aboutScreen } from './about.js';\nimport { devScreen } from './dev.js';\nimport { saveNow, markSessionClean } from '../../systems/session.js';\n\nexport function pauseMenu(g) {\n  const items = [\n    { label: 'Resume', action: (gg, m) => gg.ui.pop(m) },\n    { label: 'Map', action: (gg) => gg.ui.push(mapScreen(gg)) },\n    { label: 'Almanac', action: (gg) => gg.ui.push(almanacScreen(gg)) },\n    { label: 'Settings', action: (gg) => gg.ui.push(settingsScreen(gg)) },\n    { label: 'Save & Quit to Title', action: (gg) => { saveNow(gg); markSessionClean(gg); gg.quitToTitle(); } },\n    { label: 'About', action: (gg) => gg.ui.push(aboutScreen(gg)) },\n    { label: 'Dev Mode', action: (gg) => gg.ui.push(devScreen(gg)) },\n  ];\n  return new Menu({ id: 'pause', title: 'Paused', items, x: 150, y: 52, w: 180, itemH: 20, gap: 3, back: (gg, m) => gg.ui.pop(m), prompts: [['confirm', 'Select'], ['back', 'Resume']] });\n}\nEOF\ncat > src/ui/screens/settings.js <<'EOF'\n// Settings: everything a player wants, big and few to a page. Reset to defaults restores 10% music.\nimport { Menu } from '../ui.js';\nimport { tuning } from '../../dev/tuning.js';\nimport { store } from '../../core/storage.js';\nimport { DEFAULT_SETTINGS, DEFAULT_MUSIC } from '../../gameDefaults.js';\n\nconst pct = (v) => `${Math.round(v * 100)}%`;\nconst STYLES = ['gibberish', 'beeps', 'off'];\nconst SPEEDS = [null, 20, 35, 60, 120];\nconst speedName = (v) => (v == null ? 'Normal' : v <= 20 ? 'Slow' : v <= 35 ? 'Normal' : v <= 60 ? 'Quick' : 'Very quick');\nexport function settingsScreen(g) {\n  const a = g.ctx.audio;\n  const vol = (label, ch) => ({\n    label, value: (gg) => pct(a.volume[ch]),\n    left: () => { a.setVolume(ch, Math.max(0, Math.round((a.volume[ch] - 0.1) * 10) / 10)); g.sound('uiTick'); },\n    right: () => { a.setVolume(ch, Math.min(1, Math.round((a.volume[ch] + 0.1) * 10) / 10)); g.sound('uiTick'); },\n    action: () => {},\n  });\n  const toggle = (label, get, set, on = 'On', off = 'Off') => ({ label, value: () => (get() ? on : off), action: () => { set(!get()); g.saveSettings(); }, left: () => { set(!get()); g.saveSettings(); }, right: () => { set(!get()); g.saveSettings(); } });\n  const s = g.settings;\n  const items = [\n    vol('Music', 'music'),\n    vol('Effects', 'sfx'),\n    { label: 'Voices', value: () => pct(s.voices), left: () => { s.voices = Math.max(0, Math.round((s.voices - 0.1) * 10) / 10); g.saveSettings(); g.voice.syllable('a', 'player', ''); }, right: () => { s.voices = Math.min(1, Math.round((s.voices + 0.1) * 10) / 10); g.saveSettings(); g.voice.syllable('a', 'player', ''); }, action: () => {} },\n    { label: 'Voice style', value: () => ({ gibberish: 'Gibberish', beeps: 'Soft beeps', off: 'Off' }[s.voiceStyle]), left: () => cycle(-1), right: () => cycle(1), action: () => cycle(1) },\n    { label: 'Text speed', value: () => speedName(s.textSpeed), left: () => speed(-1), right: () => speed(1), action: () => speed(1) },\n    toggle('Controller glyphs', () => s.xbox, (v) => { s.xbox = v; }, 'Xbox', 'PlayStation'),\n    toggle('Rumble', () => s.rumble, (v) => { s.rumble = v; }),\n    toggle('Camera shake', () => s.shake, (v) => { s.shake = v; }),\n    { label: 'Clock', value: () => (g.world.clock.mode === 'real' ? 'Real Clock' : 'Village Time'), left: () => clock(), right: () => clock(), action: () => clock() },\n    { label: 'Fullscreen', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'On' : 'Off'), action: () => fullscreen(), left: () => fullscreen(), right: () => fullscreen() },\n    { label: 'Pixel size', value: () => (g.engine.settings.values.pixelSize === 'chunky' ? 'Chunky' : 'Fine'), action: () => pixel(), left: () => pixel(), right: () => pixel() },\n    { label: 'Picture quality', value: () => qualityName(), action: () => quality(1), left: () => quality(-1), right: () => quality(1) },\n    { label: 'Reset to defaults', action: () => reset() },\n    { label: 'Back', action: (gg, m) => gg.ui.pop(m) },\n  ];\n  function cycle(d) { const i = STYLES.indexOf(s.voiceStyle); s.voiceStyle = STYLES[(i + d + STYLES.length) % STYLES.length]; g.saveSettings(); g.voice.syllable('a', 'player', ''); }\n  function speed(d) { const i = SPEEDS.indexOf(s.textSpeed); s.textSpeed = SPEEDS[(Math.max(0, i) + d + SPEEDS.length) % SPEEDS.length]; g.saveSettings(); }\n  function clock() { const w = g.world; w.clock.mode = w.clock.mode === 'real' ? 'village' : 'real'; g.weatherKey = null; g.refreshSeason(); g.sound('uiTick'); g.events.emit('clockMode', { mode: w.clock.mode }); }\n  function fullscreen() { if (typeof document === 'undefined') return; if (document.fullscreenElement) document.exitFullscreen?.(); else document.documentElement.requestFullscreen?.(); }\n  function pixel() { const v = g.engine.settings.values.pixelSize === 'chunky' ? 'fine' : 'chunky'; g.engine.settings.set({ pixelSize: v }); }\n  function qualityName() { const q = g.engine.settings.values.quality ?? 'high'; return q[0].toUpperCase() + q.slice(1); }\n  function quality(d) { const list = ['low', 'medium', 'high']; const q = g.engine.settings.values.quality ?? 'high'; g.engine.settings.set({ quality: list[(list.indexOf(q) + d + 3) % 3] }); }\n  function reset() {\n    Object.assign(s, DEFAULT_SETTINGS);\n    g.saveSettings();\n    a.resetVolumes();\n    a.setVolume('music', DEFAULT_MUSIC);\n    g.engine.settings.reset();\n    g.events.emit('settingsReset', {});\n    g.ui.toastMsg('Back to how it was. Music at 10%.');\n  }\n  const m = new Menu({ id: 'settings', title: 'Settings', items, x: 110, y: 46, w: 260, itemH: 19, gap: 2, back: (gg, mm) => gg.ui.pop(mm), prompts: [['confirm', 'Change'], ['back', 'Back']] });\n  m.perPage = 8;\n  return m;\n}\nexport { tuning, store };\nEOF\ncat > src/gameDefaults.js <<'EOF'\nexport const DEFAULT_SETTINGS = { voices: 1, voiceStyle: 'gibberish', textSpeed: null, xbox: false, rumble: true, shake: true };\nexport const DEFAULT_MUSIC = 0.1;\nEOF\npython3 - <<'EOF'\np='src/game.js'\ns=open(p).read()\ns=s.replace(\"export const DEFAULT_SETTINGS = { voices: 1, voiceStyle: 'gibberish', textSpeed: null, xbox: false, rumble: true, shake: true };\\nexport const DEFAULT_MUSIC = 0.1;\\n\",\"\")\ns=s.replace(\"const SETTINGS_KEY = 'honk:settings';\",\"const SETTINGS_KEY = 'honk:settings';\\nimport { DEFAULT_SETTINGS, DEFAULT_MUSIC } from './gameDefaults.js';\")\nopen(p,'w').write(s)\nEOF\necho ok","description":"Write number, keyboard, letter, mail, map, almanac, pause and settings screens"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KsQg4XEiriXQ5a9k6KVTUf","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"8783fcd3-4a01-4524-ae9a-adefc8f85a96","timestamp":"2026-11-06T01:24:03.161Z","tool_use_result":{"stdout":"ok","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KsQg4XEiriXQ5a9k6KVTUf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkoQrYHP99CCwioty7A1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FpMtDnCTCCM6GwuHkM3dDb","name":"Bash","input":{"command":"cat > src/ui/screens/catalogue.js <<'EOF'\n// The catalogue: one big item card at a time, by category. Arrives by mail next day.\nimport { panel, drawText, inRect, dim, textBlock } from '../draw.js';\nimport { drawIcon } from '../../art/icons.js';\nimport { ITEMS } from '../../data/items.js';\nimport { buyPrice, spend } from '../../systems/economy.js';\nimport { sendMail } from '../../systems/mail.js';\n\nconst CATS = [['furniture', 'Furniture'], ['clothes', 'Clothes'], ['hat', 'Hats'], ['glasses', 'Glasses'], ['umbrella', 'Umbrellas'], ['wall', 'Wallpaper'], ['floor', 'Floors']];\nclass Catalogue {\n  constructor(g, onClose) { this.id = 'catalogue'; this.onClose = onClose; this.cat = 0; this.i = 0; }\n  list(g) { return Object.keys(g.world.player.catalog).filter((id) => ITEMS[id]?.cat === CATS[this.cat][0]); }\n  labels(g) { return CATS.map((c) => c[1]); }\n  focusIndex() { return this.cat * 100 + this.i; }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.tabPrev) { this.cat = (this.cat + CATS.length - 1) % CATS.length; this.i = 0; g.sound('uiTab'); }\n    if (inp.tabNext) { this.cat = (this.cat + 1) % CATS.length; this.i = 0; g.sound('uiTab'); }\n    const list = this.list(g);\n    if (list.length) {\n      if (inp.nav.right || inp.nav.down) { this.i = (this.i + 1) % list.length; g.sound('uiTick'); }\n      if (inp.nav.left || inp.nav.up) { this.i = (this.i + list.length - 1) % list.length; g.sound('uiTick'); }\n    }\n    if (m.click && inRect(m, 100, 70, 24, 24)) { this.i = (this.i + list.length - 1) % Math.max(1, list.length); g.sound('uiTick'); }\n    if (m.click && inRect(m, 356, 70, 24, 24)) { this.i = (this.i + 1) % Math.max(1, list.length); g.sound('uiTick'); }\n    if ((inp.confirm || (m.click && inRect(m, 180, 190, 120, 22))) && list.length) {\n      const id = list[this.i];\n      const price = buyPrice(id);\n      if (g.world.player.beans < price) { g.sound('uiError'); g.ui.toastMsg('Not enough beans. The book says nothing, but it notices.'); return; }\n      spend(g, price);\n      sendMail(g, { from: 'clementine', body: `Dear {player},\\nYour order. The bee signed for it.\\nClementine`, gift: id });\n      g.sound('stamp');\n      g.ui.toastMsg('Ordered. It comes by post tomorrow.');\n      g.events.emit('ordered', { id, price });\n      return;\n    }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onClose?.(); }\n  }\n  prompts() { return [['confirm', 'Order'], ['tabs', 'Category'], ['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 90, 20, 300, 212, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 28, CATS[this.cat][1], { align: 'center', color: 'ink', scale: 2 });\n    const list = this.list(g);\n    if (!list.length) { textBlock(hud, 120, 100, 240, \"Nothing here yet. Everything you've ever owned ends up in this book. So far, this hasn't come up.\", { color: 'slate' }); return; }\n    const id = list[this.i];\n    const it = ITEMS[id];\n    panel(hud, 100, 70, 24, 24, { fill: 'white', trim: 'mist' }); drawText(hud, 112, 78, '<', { align: 'center', color: 'ink' });\n    panel(hud, 356, 70, 24, 24, { fill: 'white', trim: 'mist' }); drawText(hud, 368, 78, '>', { align: 'center', color: 'ink' });\n    panel(hud, 192, 54, 96, 72, { fill: 'white', trim: 'mist' });\n    drawIcon(hud, 216, 66, it.icon, it.iconColors, 3);\n    drawText(hud, 240, 134, it.name, { align: 'center', color: 'ink' });\n    drawText(hud, 240, 148, `${buyPrice(id).toLocaleString('en-US')} beans`, { align: 'center', color: 'plum' });\n    if (it.line) textBlock(hud, 110, 162, 260, it.line, { color: 'slate' });\n    panel(hud, 180, 204, 120, 22, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 240, 211, 'Order it', { align: 'center', color: 'ink' });\n    drawText(hud, 240, 192, `${this.i + 1} of ${list.length}`, { align: 'center', color: 'slate' });\n  }\n}\nexport const catalogueScreen = (g, onClose) => new Catalogue(g, onClose);\nEOF\ncat > src/ui/screens/chime.js <<'EOF'\n// The Village Chime: sixteen tall chunky columns. Played on the Old Bell every hour.\nimport { panel, drawText, inRect, dim } from '../draw.js';\nimport { noteOf } from '../../systems/bell.js';\n\nconst N = 16, LEVELS = 11; // -1 rest, 0..9 notes\nconst X0 = 58, W = 22, Y0 = 56, CELL = 13;\nclass Chime {\n  constructor(g, onClose) { this.id = 'chime'; this.onClose = onClose; this.col = 0; this.notes = g.world.chime.slice(); this.play = null; }\n  focusIndex() { return this.col; }\n  labels() { return this.notes.map(String); }\n  noteRow(n) { return n < 0 ? LEVELS - 1 : LEVELS - 2 - n; }\n  update(g, inp, dt) {\n    const m = inp.mouse;\n    if (inp.nav.left) { this.col = (this.col + N - 1) % N; g.sound('uiTick'); }\n    if (inp.nav.right) { this.col = (this.col + 1) % N; g.sound('uiTick'); }\n    const set = (v) => { this.notes[this.col] = v; if (v >= 0) g.ctx.audio.play('bellNote', { pitch: noteOf(v) - 5, volume: 0.7 }); };\n    if (inp.nav.up) set(Math.min(9, this.notes[this.col] + 1));\n    if (inp.nav.down) set(Math.max(-1, this.notes[this.col] - 1));\n    for (let c = 0; c < N; c++) {\n      if (m.x >= X0 + c * W && m.x < X0 + c * W + W - 2 && m.y >= Y0 && m.y < Y0 + LEVELS * CELL) {\n        if (m.moved) this.col = c;\n        if (m.click) { this.col = c; const row = Math.floor((m.y - Y0) / CELL); set(row >= LEVELS - 1 ? -1 : LEVELS - 2 - row); }\n      }\n    }\n    if (inp.square) this.startPlay();\n    if (inp.confirm || (m.click && inRect(m, 360, 212, 70, 20))) {\n      g.world.chime = this.notes.slice();\n      g.events.emit('chimeComposed', { notes: this.notes });\n      g.world.flags.chimeSet = true;\n      g.sound('uiConfirm');\n      g.ui.pop(this);\n      this.onClose?.();\n      return;\n    }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onClose?.(); return; }\n    if (this.play !== null) {\n      this.playT -= dt;\n      if (this.playT <= 0) {\n        const n = this.notes[this.play];\n        if (n >= 0) g.ctx.audio.play('bellNote', { pitch: noteOf(n) - 5, volume: 0.7 });\n        this.play++;\n        this.playT = 0.2;\n        if (this.play >= N) this.play = null;\n      }\n    }\n  }\n  startPlay() { this.play = 0; this.playT = 0; }\n  prompts() { return [['confirm', 'Keep it'], ['fill', 'Hear it'], ['back', 'Cancel']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 48, 18, 384, 222, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 26, 'The Village Chime', { align: 'center', color: 'ink', scale: 2 });\n    for (let c = 0; c < N; c++) {\n      const x = X0 + c * W;\n      const focused = c === this.col;\n      for (let r = 0; r < LEVELS; r++) hud.rect(x, Y0 + r * CELL, W - 2, CELL - 2, r === LEVELS - 1 ? 'mist' : focused ? 'sand' : (c % 4 === 0 ? 'white' : 'white'));\n      hud.rect(x, Y0 + LEVELS * CELL - 2, W - 2, 1, 'slate');\n      const n = this.notes[c];\n      const row = this.noteRow(n);\n      hud.rect(x, Y0 + row * CELL, W - 2, CELL - 2, this.play === c ? 'red' : n < 0 ? 'slate' : 'orange');\n      if (n >= 0) hud.rect(x, Y0 + (row + 1) * CELL, W - 2, Math.max(0, (LEVELS - 2 - row)) * CELL, 'sand');\n    }\n    drawText(hud, 240, 44, 'Up and down sets the note. The bottom row is a rest.', { align: 'center', color: 'slate' });\n    panel(hud, 360, 212, 70, 20, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 395, 218, 'Keep it', { align: 'center', color: 'ink' });\n  }\n}\nexport const chimeScreen = (g, onClose) => new Chime(g, onClose);\nEOF\ncat > src/ui/screens/pattern.js <<'EOF'\n// The pattern studio: big 16×16 grid, palette strip, live preview on you. Pad or mouse.\nimport { panel, drawText, inRect, dim } from '../draw.js';\nimport { PATTERN_COLORS, blankPattern } from '../../systems/patterns.js';\nimport { Menu } from '../ui.js';\n\nconst CELL = 10, X0 = 80, Y0 = 34;\nclass Studio {\n  constructor(g, onClose) {\n    this.id = 'pattern';\n    this.onClose = onClose;\n    this.slot = 0;\n    const w = g.world;\n    this.data = (w.patterns[this.slot] ?? blankPattern()).slice();\n    this.cx = 8; this.cy = 8;\n    this.color = 2;\n    this.mode = 'pen'; // pen, fill\n    this.mirror = false;\n    this.undoStack = [];\n    this.dirty = false;\n  }\n  labels() { return ['pen', 'fill', 'mirror', 'undo', 'save', 'wear']; }\n  focusIndex() { return this.cy * 16 + this.cx; }\n  push() { this.undoStack.push(this.data.slice()); if (this.undoStack.length > 30) this.undoStack.shift(); }\n  paint(g, x, y) {\n    if (this.data[y * 16 + x] === this.color && (!this.mirror || this.data[y * 16 + 15 - x] === this.color)) return;\n    this.push();\n    this.data[y * 16 + x] = this.color;\n    if (this.mirror) this.data[y * 16 + 15 - x] = this.color;\n    this.dirty = true;\n    g.sound('uiTick');\n    g.events.emit('patternEdit', {});\n  }\n  fill(g, x, y) {\n    const from = this.data[y * 16 + x];\n    if (from === this.color) return;\n    this.push();\n    const stack = [[x, y]];\n    while (stack.length) {\n      const [px, py] = stack.pop();\n      if (px < 0 || py < 0 || px > 15 || py > 15 || this.data[py * 16 + px] !== from) continue;\n      this.data[py * 16 + px] = this.color;\n      if (this.mirror) this.data[py * 16 + 15 - px] = this.color;\n      stack.push([px + 1, py], [px - 1, py], [px, py + 1], [px, py - 1]);\n    }\n    this.dirty = true;\n    g.sound('uiConfirm');\n  }\n  save(g) {\n    const w = g.world;\n    w.patterns[this.slot] = this.data.slice();\n    w.player.pattern = this.slot;\n    this.dirty = false;\n    g.sound('stamp');\n    g.events.emit('patternSaved', { slot: this.slot });\n  }\n  wear(g) {\n    const w = g.world;\n    this.save(g);\n    w.player.look.pattern = this.slot;\n    g.player.applyLook();\n    g.events.emit('patternWorn', { slot: this.slot });\n    g.ui.toastMsg('You are wearing your own pattern. It is very you.');\n  }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.nav.left) { this.cx = (this.cx + 15) % 16; }\n    if (inp.nav.right) { this.cx = (this.cx + 1) % 16; }\n    if (inp.nav.up) { this.cy = (this.cy + 15) % 16; }\n    if (inp.nav.down) { this.cy = (this.cy + 1) % 16; }\n    const input = g.ctx.input;\n    if (inp.tabPrev) { this.color = (this.color + 15) % 16; g.sound('uiTab'); }\n    if (inp.tabNext) { this.color = (this.color + 1) % 16; g.sound('uiTab'); }\n    if (inp.confirm) { if (this.mode === 'fill') this.fill(g, this.cx, this.cy); else this.paint(g, this.cx, this.cy); }\n    if (input.isDown('PadCross') && this.mode === 'pen') this.paint(g, this.cx, this.cy);\n    if (inp.square || input.wasPressed('KeyF')) { this.mode = this.mode === 'fill' ? 'pen' : 'fill'; g.sound('uiTab'); }\n    if (inp.triangle || input.wasPressed('KeyM')) { this.mirror = !this.mirror; g.sound('uiTab'); }\n    if (input.wasPressed('PadL2', 'KeyZ')) this.undo(g);\n    if (input.wasPressed('PadR2', 'KeyV')) this.save(g);\n    if (input.wasPressed('PadOptions', 'KeyC')) this.wear(g);\n    // Mouse\n    if (m.x >= X0 && m.x < X0 + 160 && m.y >= Y0 && m.y < Y0 + 160) {\n      const x = Math.floor((m.x - X0) / CELL), y = Math.floor((m.y - Y0) / CELL);\n      if (m.moved) { this.cx = x; this.cy = y; }\n      if (m.click && this.mode === 'fill') this.fill(g, x, y);\n      else if (m.down && this.mode === 'pen') this.paint(g, x, y);\n      this.cx = x; this.cy = y;\n    }\n    for (let i = 0; i < 16; i++) { const [px, py, pw, ph] = this.swatch(i); if (m.click && inRect(m, px, py, pw, ph)) { this.color = i; g.sound('uiTab'); } }\n    const b = this.buttons();\n    for (const [name, x, y, w, h, fn] of b) if (m.click && inRect(m, x, y, w, h)) fn(g);\n    // Slots\n    if (input.wasPressed('Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6', 'Digit7', 'Digit8')) {\n      for (let d = 1; d <= 8; d++) if (input.wasPressed(`Digit${d}`)) this.setSlot(g, d - 1);\n    }\n    if (inp.back || m.rclick) {\n      if (this.dirty) this.save(g);\n      g.sound('uiCancel');\n      g.ui.pop(this);\n      this.onClose?.();\n    }\n  }\n  setSlot(g, s) { this.slot = s; this.data = (g.world.patterns[s] ?? blankPattern()).slice(); this.undoStack = []; g.sound('uiTab'); }\n  undo(g) { if (this.undoStack.length) { this.data = this.undoStack.pop(); g.sound('uiTick'); } }\n  swatch(i) { return [X0 + 170 + (i % 4) * 22, Y0 + Math.floor(i / 4) * 22, 20, 20]; }\n  buttons() {\n    return [\n      ['Pen', 340, 130, 60, 18, () => { this.mode = 'pen'; }], ['Fill', 340, 150, 60, 18, () => { this.mode = 'fill'; }],\n      ['Mirror', 340, 170, 60, 18, () => { this.mirror = !this.mirror; }], ['Undo', 250, 130, 60, 18, (g) => this.undo(g)],\n      ['Save', 250, 150, 60, 18, (g) => this.save(g)], ['Wear', 250, 170, 60, 18, (g) => this.wear(g)],\n    ];\n  }\n  prompts() { return [['confirm', 'Paint'], ['fill', this.mode === 'fill' ? 'To pen' : 'To fill'], ['mirror', this.mirror ? 'Mirror off' : 'Mirror on'], ['back', 'Save & leave']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 66, 18, 348, 196, { fill: 'white', trim: 'sand' });\n    for (let y = 0; y < 16; y++) for (let x = 0; x < 16; x++) hud.rect(X0 + x * CELL, Y0 + y * CELL, CELL - 1, CELL - 1, PATTERN_COLORS[this.data[y * 16 + x]]);\n    const cx = X0 + this.cx * CELL, cy = Y0 + this.cy * CELL;\n    hud.rect(cx - 1, cy - 1, CELL + 1, 1, 'white'); hud.rect(cx - 1, cy + CELL - 1, CELL + 1, 1, 'white');\n    hud.rect(cx - 1, cy - 1, 1, CELL + 1, 'white'); hud.rect(cx + CELL - 1, cy - 1, 1, CELL + 1, 'white');\n    for (let i = 0; i < 16; i++) { const [px, py, pw, ph] = this.swatch(i); hud.rect(px - 1, py - 1, pw + 2, ph + 2, i === this.color ? 'ink' : 'mist'); hud.rect(px, py, pw, ph, PATTERN_COLORS[i]); }\n    for (const [name, x, y, w, h] of this.buttons()) {\n      const on = (name === 'Pen' && this.mode === 'pen') || (name === 'Fill' && this.mode === 'fill') || (name === 'Mirror' && this.mirror);\n      panel(hud, x, y, w, h, { fill: on ? 'sand' : 'white', trim: on ? 'orange' : 'mist' });\n      drawText(hud, x + w / 2, y + 5, name, { align: 'center', color: 'ink' });\n    }\n    drawText(hud, 325, 192, `Slot ${this.slot + 1} of 8`, { align: 'center', color: 'slate' });\n    // Live preview: the pattern, at wearable size\n    drawText(hud, 80, 22, `Sixteen by sixteen. Make me cry.`, { color: 'slate' });\n  }\n}\nexport const patternStudio = (g, onClose) => new Studio(g, onClose);\nexport { Menu };\nEOF\ncat > src/ui/screens/placement.js <<'EOF'\n// Placement: an in-room grid, nothing else on screen. Cross lifts or drops, L1/R1 rotates, mouse drags.\nimport { drawText, panel } from '../draw.js';\nimport { ITEMS } from '../../data/items.js';\nimport { addItem, removeSlot, hasRoom } from '../../systems/economy.js';\nimport { THREE, toonMaterial, PALETTE } from '../../engine.js';\n\nconst { Mesh, BoxGeometry, Group } = THREE;\nclass Placement {\n  constructor(g, pocketIndex) {\n    this.id = 'placement';\n    this.modal = true;\n    this.room = g.place;\n    this.cx = Math.floor(this.room.w / 2); this.cz = Math.floor(this.room.d / 2);\n    this.held = null;\n    this.pocketIndex = pocketIndex;\n    this.ghost = new Group();\n    this.cursor = new Group();\n    const mat = toonMaterial(PALETTE.sand);\n    for (const [w, d, x, z] of [[1, 0.08, 0.5, 0.04], [1, 0.08, 0.5, 0.96], [0.08, 1, 0.04, 0.5], [0.08, 1, 0.96, 0.5]]) { const m = new Mesh(new BoxGeometry(w, 0.04, d), mat); m.position.set(x, 0.05, z); this.cursor.add(m); }\n    this.room.group.add(this.cursor);\n    this.grid = new Group();\n    const gm = toonMaterial(PALETTE.mist);\n    for (let x = 0; x <= this.room.w; x++) { const l = new Mesh(new BoxGeometry(0.02, 0.01, this.room.d), gm); l.position.set(x, 0.02, this.room.d / 2); this.grid.add(l); }\n    for (let z = 0; z <= this.room.d; z++) { const l = new Mesh(new BoxGeometry(this.room.w, 0.01, 0.02), gm); l.position.set(this.room.w / 2, 0.02, z); this.grid.add(l); }\n    this.room.group.add(this.grid);\n    if (pocketIndex >= 0) {\n      const slot = g.world.player.pockets[pocketIndex];\n      if (slot) { this.held = { id: slot.id, x: this.cx, z: this.cz, rot: 0, on: true, fresh: pocketIndex }; this.makeGhost(g); }\n    }\n    this.prevHideHud = g.hideHud;\n    g.hideHud = true;\n    g.camFocus = { x: this.room.w / 2, y: 0.6, z: this.room.d / 2 };\n  }\n  focusIndex() { return this.cz * 100 + this.cx; }\n  labels() { return []; }\n  makeGhost(g) {\n    this.ghost.clear();\n    this.ghost.removeFromParent();\n    const it = ITEMS[this.held.id];\n    const box = new Mesh(new BoxGeometry(it.w * 0.9, 0.5, it.d * 0.9), toonMaterial(PALETTE.sand));\n    box.position.y = 0.3;\n    this.ghost.add(box);\n    this.room.group.add(this.ghost);\n  }\n  fits(g, item) {\n    const it = ITEMS[item.id];\n    const rotated = item.rot % 2 === 1;\n    const w = rotated ? it.d : it.w, d = rotated ? it.w : it.d;\n    const room = this.room;\n    if (item.x < 0 || item.z < 0 || item.x + w > room.w || item.z + d > room.d) return false;\n    const e = room.def.exit;\n    if (e && item.z + d >= room.d - 0.5 && Math.abs(item.x + w / 2 - e.x) < 1.2) return false;\n    if (it.flat) return true;\n    for (const other of room.roomData.items) {\n      const ot = ITEMS[other.id];\n      if (ot.flat || other === item) continue;\n      const orot = other.rot % 2 === 1;\n      const ow = orot ? ot.d : ot.w, od = orot ? ot.w : ot.d;\n      if (item.x < other.x + ow && item.x + w > other.x && item.z < other.z + od && item.z + d > other.z) return false;\n    }\n    return true;\n  }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.nav.left) { this.cx = Math.max(0, this.cx - 1); g.sound('uiTick'); }\n    if (inp.nav.right) { this.cx = Math.min(this.room.w - 1, this.cx + 1); g.sound('uiTick'); }\n    if (inp.nav.up) { this.cz = Math.max(0, this.cz - 1); g.sound('uiTick'); }\n    if (inp.nav.down) { this.cz = Math.min(this.room.d - 1, this.cz + 1); g.sound('uiTick'); }\n    if (m.moved && m.over) { const h = g.interact.groundPoint(); if (h) { this.cx = Math.max(0, Math.min(this.room.w - 1, Math.floor(h.x))); this.cz = Math.max(0, Math.min(this.room.d - 1, Math.floor(h.z))); } }\n    this.cursor.position.set(this.cx, 0, this.cz);\n    if (this.held) {\n      this.held.x = this.cx; this.held.z = this.cz;\n      const it = ITEMS[this.held.id];\n      const rotated = this.held.rot % 2 === 1;\n      const w = rotated ? it.d : it.w, d = rotated ? it.w : it.d;\n      this.ghost.position.set(this.cx + w / 2, 0, this.cz + d / 2);\n      this.ghost.rotation.y = (this.held.rot * Math.PI) / 2;\n      if (inp.prevTool || inp.tabPrev) { this.held.rot = (this.held.rot + 3) % 4; g.sound('uiTab'); }\n      if (inp.nextTool || inp.tabNext) { this.held.rot = (this.held.rot + 1) % 4; g.sound('uiTab'); }\n    }\n    const act = inp.confirm || m.click;\n    if (act) {\n      if (this.held) {\n        if (!this.fits(g, this.held)) { g.sound('uiError'); g.ui.toastMsg(\"It won't go there. Mind the door.\"); }\n        else {\n          const placed = { id: this.held.id, x: this.held.x, z: this.held.z, rot: this.held.rot, on: true };\n          if (this.held.fresh !== undefined) removeSlot(g, this.held.fresh);\n          this.room.roomData.items.push(placed);\n          this.held = null;\n          this.ghost.removeFromParent();\n          this.room.placeItems();\n          this.room.syncLamps();\n          this.room.attachViews();\n          g.sound('drop');\n          g.events.emit('placed', { id: placed.id });\n          g.world.player.catalog[placed.id] = true;\n        }\n      } else {\n        const list = this.room.roomData.items;\n        const i = list.findIndex((o) => { const it = ITEMS[o.id]; const r = o.rot % 2 === 1; const w = r ? it.d : it.w, d = r ? it.w : it.d; return this.cx >= o.x && this.cx < o.x + w && this.cz >= o.z && this.cz < o.z + d; });\n        if (i >= 0) {\n          const o = list.splice(i, 1)[0];\n          this.held = { id: o.id, x: o.x, z: o.z, rot: o.rot };\n          this.makeGhost(g);\n          this.room.placeItems();\n          this.room.syncLamps();\n          this.room.attachViews();\n          g.sound('pickUp');\n          g.events.emit('lifted', { id: o.id });\n        } else g.sound('uiTick');\n      }\n    }\n    if (inp.square && this.held && this.held.fresh === undefined) {\n      if (hasRoom(g.world)) { addItem(g, this.held.id); this.held = null; this.ghost.removeFromParent(); g.sound('pickUp'); }\n    }\n    if (inp.back || m.rclick) {\n      if (this.held && this.held.fresh === undefined) {\n        // Something still in hand goes back in your pockets\n        if (hasRoom(g.world)) addItem(g, this.held.id);\n        else this.room.roomData.items.push({ id: this.held.id, x: this.held.x, z: this.held.z, rot: this.held.rot, on: true });\n      }\n      this.leave(g);\n    }\n  }\n  leave(g) {\n    g.sound('uiCancel');\n    this.ghost.removeFromParent();\n    this.cursor.removeFromParent();\n    this.grid.removeFromParent();\n    g.hideHud = this.prevHideHud;\n    g.camFocus = null;\n    this.room.placeItems();\n    this.room.syncLamps();\n    this.room.attachViews();\n    g.ui.pop(this);\n  }\n  prompts() { return this.held ? [['confirm', 'Drop'], ['tools', 'Rotate'], ['fill', 'To pockets'], ['back', 'Finish']] : [['confirm', 'Lift'], ['back', 'Finish']]; }\n  draw(g, hud) {\n    if (this.held) {\n      const it = ITEMS[this.held.id];\n      const w = 12 + it.name.length * 6;\n      panel(hud, 240 - w / 2, 14, w, 17, { fill: 'white', trim: 'sand' });\n      drawText(hud, 240, 19, it.name, { align: 'center', color: 'ink' });\n    }\n  }\n}\nexport const placementScreen = (g, i = -1) => new Placement(g, i);\nEOF\ncat > src/ui/screens/bed.js <<'EOF'\n// The bed: it saves, and offers sleep, naps, and hibernation (with a scolding).\nimport { say } from '../../systems/say.js';\nimport { menuChoiceFree } from './numbers.js';\nimport { HOSTS } from '../../data/dialogue/hosts.js';\nimport { villageDay, SEASON_NAMES } from '../../core/calendar.js';\nimport { saveNow, markSessionClean } from '../../systems/session.js';\nimport { hostLine } from '../../systems/lines.js';\nimport { panel, drawText } from '../draw.js';\nimport { tuning } from '../../dev/tuning.js';\nimport { newDay } from '../../systems/flow.js';\nimport { deliverMail } from '../../systems/mail.js';\n\n/** Move the clock forward to a target day and minute, running each night. */\nexport function advanceTo(g, targetDay, minute) {\n  const w = g.world;\n  while (w.clock.day < targetDay) { w.clock.minute = 5 * 60; newDay(g); }\n  w.clock.minute = minute;\n  if (minute >= 9 * 60) deliverMail(g);\n}\nclass AlmanacPage {\n  constructor(title, sub, onDone, seasonSting) { this.id = 'seasonPage'; this.title = title; this.sub = sub; this.onDone = onDone; this.t = 0; this.seasonSting = seasonSting; }\n  currentText() { return this.title; }\n  open(g) { g.sound('almanacTurn'); if (this.seasonSting) g.sound(this.seasonSting); }\n  update(g, inp, dt) {\n    this.t += dt;\n    if (this.t > 0.6 && !this.done) { this.done = true; this.onDone?.(); }\n    if (this.t > 1.2 && (inp.confirm || inp.back || inp.mouse.click) || this.t > 3.4) g.ui.pop(this);\n  }\n  prompts() { return null; }\n  draw(g, hud) {\n    const w = Math.min(480, Math.round(this.t * 1400));\n    hud.rect(0, 0, w, 270, 'white');\n    hud.rect(w, 0, 3, 270, 'mist');\n    if (this.t > 0.32) {\n      drawText(hud, 240, 104, this.title, { align: 'center', color: 'ink', scale: 3 });\n      drawText(hud, 240, 138, this.sub, { align: 'center', color: 'slate' });\n    }\n  }\n}\nexport function* sleepTo(g, kind) {\n  const w = g.world;\n  const c0 = villageDay(w.clock.day);\n  saveNow(g);\n  markSessionClean(g);\n  g.player.play('Sleep', 0.2);\n  g.music.setOverride('lullaby');\n  g.engine.screen.cover('fade', { duration: 0.8 });\n  g.events.emit('sleep', { kind });\n  yield 0.9;\n  w.stats.sleeps += 1;\n  if (kind === 'morning') {\n    const nextDay = w.clock.minute >= 5 * 60 ? w.clock.day + 1 : w.clock.day;\n    advanceTo(g, nextDay, 8 * 60);\n  } else if (kind === 'noon') {\n    if (w.clock.minute >= 12 * 60) advanceTo(g, w.clock.day + 1, 12 * 60);\n    else { w.clock.minute = 12 * 60; deliverMail(g); }\n  } else if (kind === 'dusk') {\n    if (w.clock.minute >= 18 * 60) advanceTo(g, w.clock.day + 1, 18 * 60);\n    else { w.clock.minute = 18 * 60; deliverMail(g); }\n  } else if (kind === 'hibernate') {\n    const now = villageDay(w.clock.day);\n    const toFestival = 4 - ((now.calendarDay - 1) % 4);\n    advanceTo(g, w.clock.day + (toFestival === 1 && now.type === 3 ? 4 : toFestival === 0 ? 4 : toFestival - (now.type === 3 ? 0 : 0)), 8 * 60);\n    g.events.emit('hibernated', {});\n  }\n  g.lastHour = -1;\n  g.sky.placeChanged();\n  const c1 = villageDay(w.clock.day);\n  const seasonChanged = c1.season !== c0.season;\n  g.music.setOverride(null);\n  g.engine.screen.reveal('fade', { duration: 0.4 });\n  if (seasonChanged) {\n    let closed = false;\n    const page = new AlmanacPage(SEASON_NAMES[c1.season], { 0: 'Everything is starting again. It would like you to know.', 1: 'The cicadas have been told.', 2: 'It all goes a nice colour, and then it all goes.', 3: 'Everything is under something.' }[c1.season], () => g.refreshSeason(true), `sting_${['spring', 'summer', 'autumn', 'winter'][c1.season]}`);\n    const origClose = page.close;\n    page.close = () => { closed = true; origClose?.(); };\n    g.ui.push(page);\n    while (!closed) yield;\n  } else g.refreshSeason(true);\n  g.player.play('Idle', 0.2);\n  saveNow(g);\n  g.events.emit('woke', { day: w.clock.day });\n}\nexport function* bedMenu(g) {\n  const w = g.world;\n  const c = yield* menuChoiceFree(g, 'The bed', ['Sleep till morning', 'Nap till noon', 'Nap till dusk', 'Hibernate until the next festival', 'Not yet'], { id: 'bed', w: 240, x: 120 });\n  if (c < 0 || c === 4) return;\n  if (c === 3) yield* say(g, 'gander', hostLine(g, 'gander', 'hibernate'));\n  yield* sleepTo(g, ['morning', 'noon', 'dusk', 'hibernate'][c]);\n}\nexport { HOSTS, panel, tuning };\nEOF\ncat > src/ui/screens/clockFace.js <<'EOF'\nimport { formatTime } from '../../core/calendar.js';\nexport function flavourOfClock(g) {\n  const t = formatTime(g.world.clock.minute);\n  return `It says ${t}. You've no reason to doubt it. Mrs. Gander had it set.`;\n}\nEOF\ncat > src/ui/screens/lookEditor.js <<'EOF'\n// Change your look with a live preview: hair, colour, eyes. Used by the mirror, the salon and the bus.\nimport { panel, drawText, inRect } from '../draw.js';\nimport { HAIR_STYLES, HAIR_COLORS, EYE_STYLES } from '../../art/critter.js';\nimport { wear } from '../../systems/pocketActions.js';\nimport { ITEMS } from '../../data/items.js';\nimport { Menu } from '../ui.js';\n\nconst SKIN = ['sand', 'orange', 'white', 'mist', 'plum', 'lime'];\nclass LookEditor {\n  constructor(g, { title, turntable, hairOnly, free, onDone }) {\n    this.id = 'lookEditor';\n    this.title = title;\n    this.turn = !!turntable;\n    this.hairOnly = hairOnly;\n    this.free = free;\n    this.onDone = onDone;\n    this.focus = 0;\n    this.saved = JSON.stringify(g.world.player.look);\n    this.rows = [\n      { label: 'Hair', get: (l) => HAIR_STYLES[l.hair], step: (l, d) => { l.hair = (l.hair + d + HAIR_STYLES.length) % HAIR_STYLES.length; } },\n      { label: 'Colour', get: (l) => HAIR_COLORS.indexOf(l.hairColor) + 1, step: (l, d) => { l.hairColor = HAIR_COLORS[(HAIR_COLORS.indexOf(l.hairColor) + d + HAIR_COLORS.length) % HAIR_COLORS.length]; } },\n    ];\n    if (!hairOnly) {\n      this.rows.push({ label: 'Eyes', get: (l) => EYE_STYLES[l.eyes], step: (l, d) => { l.eyes = (l.eyes + d + EYE_STYLES.length) % EYE_STYLES.length; } });\n      this.rows.push({ label: 'Skin', get: (l) => SKIN.indexOf(l.skin) + 1, step: (l, d) => { l.skin = SKIN[(SKIN.indexOf(l.skin) + d + SKIN.length) % SKIN.length]; } });\n    }\n    if (free) this.rows.push({ label: 'Wardrobe', get: (l) => ITEMS[l.outfit]?.name ?? '', step: null, action: (gg) => this.wardrobe(gg) });\n    this.face = g.player.facing;\n  }\n  labels() { return this.rows.map((r) => r.label); }\n  focusIndex() { return this.focus; }\n  wardrobe(g) {\n    const w = g.world;\n    const items = [];\n    w.player.pockets.forEach((s, i) => { if (s && ['clothes', 'hat', 'glasses', 'umbrella'].includes(ITEMS[s.id]?.cat)) items.push({ label: ITEMS[s.id].name, icon: ITEMS[s.id].icon, iconColors: ITEMS[s.id].iconColors, action: (gg, m) => { wear(gg, i, s); gg.ui.pop(m); } }); });\n    const look = w.player.look;\n    if (look.hatItem) items.push({ label: 'Take off your hat', action: (gg, m) => { gg.world.player.pockets[gg.world.player.pockets.indexOf(null)] = { id: look.hatItem }; look.hatItem = null; gg.player.applyLook(); gg.ui.pop(m); } });\n    if (look.glassesItem) items.push({ label: 'Take off your glasses', action: (gg, m) => { gg.world.player.pockets[gg.world.player.pockets.indexOf(null)] = { id: look.glassesItem }; look.glassesItem = null; gg.player.applyLook(); gg.ui.pop(m); } });\n    items.push({ label: 'Back', action: (gg, m) => gg.ui.pop(m) });\n    g.ui.push(new Menu({ id: 'wardrobe', title: 'Wardrobe', items, x: 130, y: 66, w: 220, itemH: 19, gap: 2, back: (gg, m) => gg.ui.pop(m) }));\n  }\n  rowRect(i) { return [300, 60 + i * 26, 160, 22]; }\n  update(g, inp, dt) {\n    const m = inp.mouse;\n    if (inp.nav.up) { this.focus = (this.focus + this.rows.length - 1) % this.rows.length; g.sound('uiTick'); }\n    if (inp.nav.down) { this.focus = (this.focus + 1) % this.rows.length; g.sound('uiTick'); }\n    const l = g.world.player.look;\n    const r = this.rows[this.focus];\n    const change = (d) => { if (r.step) { r.step(l, d); g.player.applyLook(); g.player.play('Idle', 0); g.sound('uiTick'); } };\n    if (inp.nav.left) change(-1);\n    if (inp.nav.right) change(1);\n    this.rows.forEach((row, i) => {\n      const [x, y, w, h] = this.rowRect(i);\n      if (inRect(m, x, y, w, h)) {\n        if (m.moved) this.focus = i;\n        if (m.click) { this.focus = i; if (row.action) row.action(g); else { row.step(l, m.x < x + w / 2 ? -1 : 1); g.player.applyLook(); g.sound('uiTick'); } }\n      }\n    });\n    if (this.turn || g.ui.top === this) g.player.facing += dt * (this.turn ? 1.2 : 0.5);\n    if (inp.confirm) {\n      if (r.action) { r.action(g); return; }\n      g.sound('uiConfirm');\n      g.player.facing = this.face;\n      g.ui.pop(this);\n      this.onDone(true);\n      return;\n    }\n    if (inp.back || m.rclick) {\n      g.sound('uiCancel');\n      g.world.player.look = JSON.parse(this.saved);\n      g.player.applyLook();\n      g.player.facing = this.face;\n      g.ui.pop(this);\n      this.onDone(false);\n    }\n  }\n  prompts() { return [['confirm', this.rows[this.focus]?.action ? 'Open' : 'Keep this'], ['back', 'As I was']]; }\n  draw(g, hud) {\n    panel(hud, 292, 22, 176, 44 + this.rows.length * 26, { fill: 'white', trim: 'sand' });\n    drawText(hud, 380, 32, this.title, { align: 'center', color: 'ink' });\n    drawText(hud, 380, 44, 'A very honest reflection.', { align: 'center', color: 'slate' });\n    this.rows.forEach((r, i) => {\n      const [x, y, w, h] = this.rowRect(i);\n      const f = i === this.focus;\n      panel(hud, x, y, w, h, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      drawText(hud, x + 8, y + 7, r.label, { color: 'ink' });\n      drawText(hud, x + w - 8, y + 7, String(r.get(g.world.player.look)), { color: 'plum', align: 'right' });\n    });\n  }\n}\nexport function* lookEditor(g, o) {\n  let result = null;\n  const prev = g.camState.zoomOverride;\n  g.camState.zoomOverride = 2.3;\n  g.ui.push(new LookEditor(g, { ...o, onDone: (r) => { result = r; } }));\n  while (result === null) yield;\n  g.camState.zoomOverride = prev;\n  return result;\n}\nEOF\ncat > src/ui/screens/compare.js <<'EOF'\n// Compare a painting with the catalogue print: a missing star, an extra earring.\nimport { panel, drawText, dim, inRect } from '../draw.js';\nimport { ITEMS } from '../../data/items.js';\nimport { ART } from '../../data/art.js';\nimport { paintingSprite } from '../../art/paintingSprites.js';\n\nclass Compare {\n  constructor(g, stock, onClose) { this.id = 'compare'; this.stock = stock; this.onClose = onClose; this.t = 0; }\n  update(g, inp, dt) { this.t += dt; if (inp.back || inp.confirm || inp.mouse.click || inp.mouse.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onClose?.(); } }\n  currentText() { return this.stock.id; }\n  prompts() { return [['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 40, 30, 400, 190, { fill: 'white', trim: 'sand' });\n    const it = ITEMS[this.stock.id];\n    const genuine = ART.find((a) => a.id === (it.of ?? it.id));\n    drawText(hud, 240, 38, genuine.name, { align: 'center', color: 'ink' });\n    drawText(hud, 140, 54, 'Catalogue print', { align: 'center', color: 'slate' });\n    drawText(hud, 340, 54, 'On the easel', { align: 'center', color: 'slate' });\n    const left = paintingSprite(genuine.id);\n    const right = paintingSprite(this.stock.id);\n    hud.sprite(140 - 88, 66, left.rows, left.colors, { shadow: false, scale: 1 });\n    hud.sprite(340 - 88, 66, right.rows, right.colors, { shadow: false, scale: 1 });\n    drawText(hud, 240, 204, 'Look closely. Magda is pretending not to watch.', { align: 'center', color: 'plum' });\n  }\n}\nexport const compareScreen = (g, stock, onClose) => new Compare(g, stock, onClose);\nexport { inRect };\nEOF\ncat > src/art/paintingSprites.js <<'EOF'\n// Paintings as HUD sprites, baked from the same texture defs, scaled to 176×132.\nimport { PAINTINGS } from './paintings.js';\nimport { bakeTexture, PALETTE } from '../engine.js';\n\nconst NAMES = Object.keys(PALETTE);\nconst cache = new Map();\nconst HEX = Object.fromEntries(NAMES.map((n) => [PALETTE[n], n]));\nfunction nearest(r, g, b) {\n  let best = 'ink', bd = 1e9;\n  for (const n of NAMES) { const h = PALETTE[n]; const d = (((h >> 16) & 255) - r) ** 2 + (((h >> 8) & 255) - g) ** 2 + ((h & 255) - b) ** 2; if (d < bd) { bd = d; best = n; } }\n  return best;\n}\nexport function paintingSprite(id) {\n  if (cache.has(id)) return cache.get(id);\n  const def = PAINTINGS.find((p) => p.id === `art-${id}`);\n  const baked = bakeTexture(def);\n  const w = baked.width ?? baked.size?.[0] ?? 32, h = baked.height ?? baked.size?.[1] ?? 24;\n  const data = baked.data ?? baked.pixels ?? baked.rgba;\n  const chars = 'abcdefghijklmnop';\n  const colors = {};\n  NAMES.forEach((n, i) => { colors[chars[i]] = n; });\n  const S = 5;\n  const rows = [];\n  for (let y = 0; y < h; y++) {\n    let line = '';\n    for (let x = 0; x < w; x++) {\n      const o = (y * w + x) * 4;\n      const name = nearest(data[o], data[o + 1], data[o + 2]);\n      line += chars[NAMES.indexOf(name)].repeat(S);\n    }\n    for (let k = 0; k < S; k++) rows.push(line);\n  }\n  const out = { rows, colors };\n  cache.set(id, out);\n  return out;\n}\nexport { HEX };\nEOF\ngrep -n \"interface BakedTexture\" -A10 kit/API.md | cut -c1-160; grep -n \"bakeTexture\" kit/API.md | head -3","description":"Write catalogue, chime, pattern, placement, bed, look editor, compare"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17973,"cache_read_input_tokens":629547,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17973},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"ba47450d-1696-4423-abf5-8a909cefe7d9","timestamp":"2026-11-06T01:26:02.668Z","request_id":"req_011CgkoQrGfQ512jjc5YJHLx","wire_tool_inputs":{"toolu_01FpMtDnCTCCM6GwuHkM3dDb":{"command":"cat > src/ui/screens/catalogue.js <<'EOF'\n// The catalogue: one big item card at a time, by category. Arrives by mail next day.\nimport { panel, drawText, inRect, dim, textBlock } from '../draw.js';\nimport { drawIcon } from '../../art/icons.js';\nimport { ITEMS } from '../../data/items.js';\nimport { buyPrice, spend } from '../../systems/economy.js';\nimport { sendMail } from '../../systems/mail.js';\n\nconst CATS = [['furniture', 'Furniture'], ['clothes', 'Clothes'], ['hat', 'Hats'], ['glasses', 'Glasses'], ['umbrella', 'Umbrellas'], ['wall', 'Wallpaper'], ['floor', 'Floors']];\nclass Catalogue {\n  constructor(g, onClose) { this.id = 'catalogue'; this.onClose = onClose; this.cat = 0; this.i = 0; }\n  list(g) { return Object.keys(g.world.player.catalog).filter((id) => ITEMS[id]?.cat === CATS[this.cat][0]); }\n  labels(g) { return CATS.map((c) => c[1]); }\n  focusIndex() { return this.cat * 100 + this.i; }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.tabPrev) { this.cat = (this.cat + CATS.length - 1) % CATS.length; this.i = 0; g.sound('uiTab'); }\n    if (inp.tabNext) { this.cat = (this.cat + 1) % CATS.length; this.i = 0; g.sound('uiTab'); }\n    const list = this.list(g);\n    if (list.length) {\n      if (inp.nav.right || inp.nav.down) { this.i = (this.i + 1) % list.length; g.sound('uiTick'); }\n      if (inp.nav.left || inp.nav.up) { this.i = (this.i + list.length - 1) % list.length; g.sound('uiTick'); }\n    }\n    if (m.click && inRect(m, 100, 70, 24, 24)) { this.i = (this.i + list.length - 1) % Math.max(1, list.length); g.sound('uiTick'); }\n    if (m.click && inRect(m, 356, 70, 24, 24)) { this.i = (this.i + 1) % Math.max(1, list.length); g.sound('uiTick'); }\n    if ((inp.confirm || (m.click && inRect(m, 180, 190, 120, 22))) && list.length) {\n      const id = list[this.i];\n      const price = buyPrice(id);\n      if (g.world.player.beans < price) { g.sound('uiError'); g.ui.toastMsg('Not enough beans. The book says nothing, but it notices.'); return; }\n      spend(g, price);\n      sendMail(g, { from: 'clementine', body: `Dear {player},\\nYour order. The bee signed for it.\\nClementine`, gift: id });\n      g.sound('stamp');\n      g.ui.toastMsg('Ordered. It comes by post tomorrow.');\n      g.events.emit('ordered', { id, price });\n      return;\n    }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onClose?.(); }\n  }\n  prompts() { return [['confirm', 'Order'], ['tabs', 'Category'], ['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 90, 20, 300, 212, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 28, CATS[this.cat][1], { align: 'center', color: 'ink', scale: 2 });\n    const list = this.list(g);\n    if (!list.length) { textBlock(hud, 120, 100, 240, \"Nothing here yet. Everything you've ever owned ends up in this book. So far, this hasn't come up.\", { color: 'slate' }); return; }\n    const id = list[this.i];\n    const it = ITEMS[id];\n    panel(hud, 100, 70, 24, 24, { fill: 'white', trim: 'mist' }); drawText(hud, 112, 78, '<', { align: 'center', color: 'ink' });\n    panel(hud, 356, 70, 24, 24, { fill: 'white', trim: 'mist' }); drawText(hud, 368, 78, '>', { align: 'center', color: 'ink' });\n    panel(hud, 192, 54, 96, 72, { fill: 'white', trim: 'mist' });\n    drawIcon(hud, 216, 66, it.icon, it.iconColors, 3);\n    drawText(hud, 240, 134, it.name, { align: 'center', color: 'ink' });\n    drawText(hud, 240, 148, `${buyPrice(id).toLocaleString('en-US')} beans`, { align: 'center', color: 'plum' });\n    if (it.line) textBlock(hud, 110, 162, 260, it.line, { color: 'slate' });\n    panel(hud, 180, 204, 120, 22, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 240, 211, 'Order it', { align: 'center', color: 'ink' });\n    drawText(hud, 240, 192, `${this.i + 1} of ${list.length}`, { align: 'center', color: 'slate' });\n  }\n}\nexport const catalogueScreen = (g, onClose) => new Catalogue(g, onClose);\nEOF\ncat > src/ui/screens/chime.js <<'EOF'\n// The Village Chime: sixteen tall chunky columns. Played on the Old Bell every hour.\nimport { panel, drawText, inRect, dim } from '../draw.js';\nimport { noteOf } from '../../systems/bell.js';\n\nconst N = 16, LEVELS = 11; // -1 rest, 0..9 notes\nconst X0 = 58, W = 22, Y0 = 56, CELL = 13;\nclass Chime {\n  constructor(g, onClose) { this.id = 'chime'; this.onClose = onClose; this.col = 0; this.notes = g.world.chime.slice(); this.play = null; }\n  focusIndex() { return this.col; }\n  labels() { return this.notes.map(String); }\n  noteRow(n) { return n < 0 ? LEVELS - 1 : LEVELS - 2 - n; }\n  update(g, inp, dt) {\n    const m = inp.mouse;\n    if (inp.nav.left) { this.col = (this.col + N - 1) % N; g.sound('uiTick'); }\n    if (inp.nav.right) { this.col = (this.col + 1) % N; g.sound('uiTick'); }\n    const set = (v) => { this.notes[this.col] = v; if (v >= 0) g.ctx.audio.play('bellNote', { pitch: noteOf(v) - 5, volume: 0.7 }); };\n    if (inp.nav.up) set(Math.min(9, this.notes[this.col] + 1));\n    if (inp.nav.down) set(Math.max(-1, this.notes[this.col] - 1));\n    for (let c = 0; c < N; c++) {\n      if (m.x >= X0 + c * W && m.x < X0 + c * W + W - 2 && m.y >= Y0 && m.y < Y0 + LEVELS * CELL) {\n        if (m.moved) this.col = c;\n        if (m.click) { this.col = c; const row = Math.floor((m.y - Y0) / CELL); set(row >= LEVELS - 1 ? -1 : LEVELS - 2 - row); }\n      }\n    }\n    if (inp.square) this.startPlay();\n    if (inp.confirm || (m.click && inRect(m, 360, 212, 70, 20))) {\n      g.world.chime = this.notes.slice();\n      g.events.emit('chimeComposed', { notes: this.notes });\n      g.world.flags.chimeSet = true;\n      g.sound('uiConfirm');\n      g.ui.pop(this);\n      this.onClose?.();\n      return;\n    }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onClose?.(); return; }\n    if (this.play !== null) {\n      this.playT -= dt;\n      if (this.playT <= 0) {\n        const n = this.notes[this.play];\n        if (n >= 0) g.ctx.audio.play('bellNote', { pitch: noteOf(n) - 5, volume: 0.7 });\n        this.play++;\n        this.playT = 0.2;\n        if (this.play >= N) this.play = null;\n      }\n    }\n  }\n  startPlay() { this.play = 0; this.playT = 0; }\n  prompts() { return [['confirm', 'Keep it'], ['fill', 'Hear it'], ['back', 'Cancel']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 48, 18, 384, 222, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 26, 'The Village Chime', { align: 'center', color: 'ink', scale: 2 });\n    for (let c = 0; c < N; c++) {\n      const x = X0 + c * W;\n      const focused = c === this.col;\n      for (let r = 0; r < LEVELS; r++) hud.rect(x, Y0 + r * CELL, W - 2, CELL - 2, r === LEVELS - 1 ? 'mist' : focused ? 'sand' : (c % 4 === 0 ? 'white' : 'white'));\n      hud.rect(x, Y0 + LEVELS * CELL - 2, W - 2, 1, 'slate');\n      const n = this.notes[c];\n      const row = this.noteRow(n);\n      hud.rect(x, Y0 + row * CELL, W - 2, CELL - 2, this.play === c ? 'red' : n < 0 ? 'slate' : 'orange');\n      if (n >= 0) hud.rect(x, Y0 + (row + 1) * CELL, W - 2, Math.max(0, (LEVELS - 2 - row)) * CELL, 'sand');\n    }\n    drawText(hud, 240, 44, 'Up and down sets the note. The bottom row is a rest.', { align: 'center', color: 'slate' });\n    panel(hud, 360, 212, 70, 20, { fill: 'sand', trim: 'orange' });\n    drawText(hud, 395, 218, 'Keep it', { align: 'center', color: 'ink' });\n  }\n}\nexport const chimeScreen = (g, onClose) => new Chime(g, onClose);\nEOF\ncat > src/ui/screens/pattern.js <<'EOF'\n// The pattern studio: big 16×16 grid, palette strip, live preview on you. Pad or mouse.\nimport { panel, drawText, inRect, dim } from '../draw.js';\nimport { PATTERN_COLORS, blankPattern } from '../../systems/patterns.js';\nimport { Menu } from '../ui.js';\n\nconst CELL = 10, X0 = 80, Y0 = 34;\nclass Studio {\n  constructor(g, onClose) {\n    this.id = 'pattern';\n    this.onClose = onClose;\n    this.slot = 0;\n    const w = g.world;\n    this.data = (w.patterns[this.slot] ?? blankPattern()).slice();\n    this.cx = 8; this.cy = 8;\n    this.color = 2;\n    this.mode = 'pen'; // pen, fill\n    this.mirror = false;\n    this.undoStack = [];\n    this.dirty = false;\n  }\n  labels() { return ['pen', 'fill', 'mirror', 'undo', 'save', 'wear']; }\n  focusIndex() { return this.cy * 16 + this.cx; }\n  push() { this.undoStack.push(this.data.slice()); if (this.undoStack.length > 30) this.undoStack.shift(); }\n  paint(g, x, y) {\n    if (this.data[y * 16 + x] === this.color && (!this.mirror || this.data[y * 16 + 15 - x] === this.color)) return;\n    this.push();\n    this.data[y * 16 + x] = this.color;\n    if (this.mirror) this.data[y * 16 + 15 - x] = this.color;\n    this.dirty = true;\n    g.sound('uiTick');\n    g.events.emit('patternEdit', {});\n  }\n  fill(g, x, y) {\n    const from = this.data[y * 16 + x];\n    if (from === this.color) return;\n    this.push();\n    const stack = [[x, y]];\n    while (stack.length) {\n      const [px, py] = stack.pop();\n      if (px < 0 || py < 0 || px > 15 || py > 15 || this.data[py * 16 + px] !== from) continue;\n      this.data[py * 16 + px] = this.color;\n      if (this.mirror) this.data[py * 16 + 15 - px] = this.color;\n      stack.push([px + 1, py], [px - 1, py], [px, py + 1], [px, py - 1]);\n    }\n    this.dirty = true;\n    g.sound('uiConfirm');\n  }\n  save(g) {\n    const w = g.world;\n    w.patterns[this.slot] = this.data.slice();\n    w.player.pattern = this.slot;\n    this.dirty = false;\n    g.sound('stamp');\n    g.events.emit('patternSaved', { slot: this.slot });\n  }\n  wear(g) {\n    const w = g.world;\n    this.save(g);\n    w.player.look.pattern = this.slot;\n    g.player.applyLook();\n    g.events.emit('patternWorn', { slot: this.slot });\n    g.ui.toastMsg('You are wearing your own pattern. It is very you.');\n  }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.nav.left) { this.cx = (this.cx + 15) % 16; }\n    if (inp.nav.right) { this.cx = (this.cx + 1) % 16; }\n    if (inp.nav.up) { this.cy = (this.cy + 15) % 16; }\n    if (inp.nav.down) { this.cy = (this.cy + 1) % 16; }\n    const input = g.ctx.input;\n    if (inp.tabPrev) { this.color = (this.color + 15) % 16; g.sound('uiTab'); }\n    if (inp.tabNext) { this.color = (this.color + 1) % 16; g.sound('uiTab'); }\n    if (inp.confirm) { if (this.mode === 'fill') this.fill(g, this.cx, this.cy); else this.paint(g, this.cx, this.cy); }\n    if (input.isDown('PadCross') && this.mode === 'pen') this.paint(g, this.cx, this.cy);\n    if (inp.square || input.wasPressed('KeyF')) { this.mode = this.mode === 'fill' ? 'pen' : 'fill'; g.sound('uiTab'); }\n    if (inp.triangle || input.wasPressed('KeyM')) { this.mirror = !this.mirror; g.sound('uiTab'); }\n    if (input.wasPressed('PadL2', 'KeyZ')) this.undo(g);\n    if (input.wasPressed('PadR2', 'KeyV')) this.save(g);\n    if (input.wasPressed('PadOptions', 'KeyC')) this.wear(g);\n    // Mouse\n    if (m.x >= X0 && m.x < X0 + 160 && m.y >= Y0 && m.y < Y0 + 160) {\n      const x = Math.floor((m.x - X0) / CELL), y = Math.floor((m.y - Y0) / CELL);\n      if (m.moved) { this.cx = x; this.cy = y; }\n      if (m.click && this.mode === 'fill') this.fill(g, x, y);\n      else if (m.down && this.mode === 'pen') this.paint(g, x, y);\n      this.cx = x; this.cy = y;\n    }\n    for (let i = 0; i < 16; i++) { const [px, py, pw, ph] = this.swatch(i); if (m.click && inRect(m, px, py, pw, ph)) { this.color = i; g.sound('uiTab'); } }\n    const b = this.buttons();\n    for (const [name, x, y, w, h, fn] of b) if (m.click && inRect(m, x, y, w, h)) fn(g);\n    // Slots\n    if (input.wasPressed('Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6', 'Digit7', 'Digit8')) {\n      for (let d = 1; d <= 8; d++) if (input.wasPressed(`Digit${d}`)) this.setSlot(g, d - 1);\n    }\n    if (inp.back || m.rclick) {\n      if (this.dirty) this.save(g);\n      g.sound('uiCancel');\n      g.ui.pop(this);\n      this.onClose?.();\n    }\n  }\n  setSlot(g, s) { this.slot = s; this.data = (g.world.patterns[s] ?? blankPattern()).slice(); this.undoStack = []; g.sound('uiTab'); }\n  undo(g) { if (this.undoStack.length) { this.data = this.undoStack.pop(); g.sound('uiTick'); } }\n  swatch(i) { return [X0 + 170 + (i % 4) * 22, Y0 + Math.floor(i / 4) * 22, 20, 20]; }\n  buttons() {\n    return [\n      ['Pen', 340, 130, 60, 18, () => { this.mode = 'pen'; }], ['Fill', 340, 150, 60, 18, () => { this.mode = 'fill'; }],\n      ['Mirror', 340, 170, 60, 18, () => { this.mirror = !this.mirror; }], ['Undo', 250, 130, 60, 18, (g) => this.undo(g)],\n      ['Save', 250, 150, 60, 18, (g) => this.save(g)], ['Wear', 250, 170, 60, 18, (g) => this.wear(g)],\n    ];\n  }\n  prompts() { return [['confirm', 'Paint'], ['fill', this.mode === 'fill' ? 'To pen' : 'To fill'], ['mirror', this.mirror ? 'Mirror off' : 'Mirror on'], ['back', 'Save & leave']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 66, 18, 348, 196, { fill: 'white', trim: 'sand' });\n    for (let y = 0; y < 16; y++) for (let x = 0; x < 16; x++) hud.rect(X0 + x * CELL, Y0 + y * CELL, CELL - 1, CELL - 1, PATTERN_COLORS[this.data[y * 16 + x]]);\n    const cx = X0 + this.cx * CELL, cy = Y0 + this.cy * CELL;\n    hud.rect(cx - 1, cy - 1, CELL + 1, 1, 'white'); hud.rect(cx - 1, cy + CELL - 1, CELL + 1, 1, 'white');\n    hud.rect(cx - 1, cy - 1, 1, CELL + 1, 'white'); hud.rect(cx + CELL - 1, cy - 1, 1, CELL + 1, 'white');\n    for (let i = 0; i < 16; i++) { const [px, py, pw, ph] = this.swatch(i); hud.rect(px - 1, py - 1, pw + 2, ph + 2, i === this.color ? 'ink' : 'mist'); hud.rect(px, py, pw, ph, PATTERN_COLORS[i]); }\n    for (const [name, x, y, w, h] of this.buttons()) {\n      const on = (name === 'Pen' && this.mode === 'pen') || (name === 'Fill' && this.mode === 'fill') || (name === 'Mirror' && this.mirror);\n      panel(hud, x, y, w, h, { fill: on ? 'sand' : 'white', trim: on ? 'orange' : 'mist' });\n      drawText(hud, x + w / 2, y + 5, name, { align: 'center', color: 'ink' });\n    }\n    drawText(hud, 325, 192, `Slot ${this.slot + 1} of 8`, { align: 'center', color: 'slate' });\n    // Live preview: the pattern, at wearable size\n    drawText(hud, 80, 22, `Sixteen by sixteen. Make me cry.`, { color: 'slate' });\n  }\n}\nexport const patternStudio = (g, onClose) => new Studio(g, onClose);\nexport { Menu };\nEOF\ncat > src/ui/screens/placement.js <<'EOF'\n// Placement: an in-room grid, nothing else on screen. Cross lifts or drops, L1/R1 rotates, mouse drags.\nimport { drawText, panel } from '../draw.js';\nimport { ITEMS } from '../../data/items.js';\nimport { addItem, removeSlot, hasRoom } from '../../systems/economy.js';\nimport { THREE, toonMaterial, PALETTE } from '../../engine.js';\n\nconst { Mesh, BoxGeometry, Group } = THREE;\nclass Placement {\n  constructor(g, pocketIndex) {\n    this.id = 'placement';\n    this.modal = true;\n    this.room = g.place;\n    this.cx = Math.floor(this.room.w / 2); this.cz = Math.floor(this.room.d / 2);\n    this.held = null;\n    this.pocketIndex = pocketIndex;\n    this.ghost = new Group();\n    this.cursor = new Group();\n    const mat = toonMaterial(PALETTE.sand);\n    for (const [w, d, x, z] of [[1, 0.08, 0.5, 0.04], [1, 0.08, 0.5, 0.96], [0.08, 1, 0.04, 0.5], [0.08, 1, 0.96, 0.5]]) { const m = new Mesh(new BoxGeometry(w, 0.04, d), mat); m.position.set(x, 0.05, z); this.cursor.add(m); }\n    this.room.group.add(this.cursor);\n    this.grid = new Group();\n    const gm = toonMaterial(PALETTE.mist);\n    for (let x = 0; x <= this.room.w; x++) { const l = new Mesh(new BoxGeometry(0.02, 0.01, this.room.d), gm); l.position.set(x, 0.02, this.room.d / 2); this.grid.add(l); }\n    for (let z = 0; z <= this.room.d; z++) { const l = new Mesh(new BoxGeometry(this.room.w, 0.01, 0.02), gm); l.position.set(this.room.w / 2, 0.02, z); this.grid.add(l); }\n    this.room.group.add(this.grid);\n    if (pocketIndex >= 0) {\n      const slot = g.world.player.pockets[pocketIndex];\n      if (slot) { this.held = { id: slot.id, x: this.cx, z: this.cz, rot: 0, on: true, fresh: pocketIndex }; this.makeGhost(g); }\n    }\n    this.prevHideHud = g.hideHud;\n    g.hideHud = true;\n    g.camFocus = { x: this.room.w / 2, y: 0.6, z: this.room.d / 2 };\n  }\n  focusIndex() { return this.cz * 100 + this.cx; }\n  labels() { return []; }\n  makeGhost(g) {\n    this.ghost.clear();\n    this.ghost.removeFromParent();\n    const it = ITEMS[this.held.id];\n    const box = new Mesh(new BoxGeometry(it.w * 0.9, 0.5, it.d * 0.9), toonMaterial(PALETTE.sand));\n    box.position.y = 0.3;\n    this.ghost.add(box);\n    this.room.group.add(this.ghost);\n  }\n  fits(g, item) {\n    const it = ITEMS[item.id];\n    const rotated = item.rot % 2 === 1;\n    const w = rotated ? it.d : it.w, d = rotated ? it.w : it.d;\n    const room = this.room;\n    if (item.x < 0 || item.z < 0 || item.x + w > room.w || item.z + d > room.d) return false;\n    const e = room.def.exit;\n    if (e && item.z + d >= room.d - 0.5 && Math.abs(item.x + w / 2 - e.x) < 1.2) return false;\n    if (it.flat) return true;\n    for (const other of room.roomData.items) {\n      const ot = ITEMS[other.id];\n      if (ot.flat || other === item) continue;\n      const orot = other.rot % 2 === 1;\n      const ow = orot ? ot.d : ot.w, od = orot ? ot.w : ot.d;\n      if (item.x < other.x + ow && item.x + w > other.x && item.z < other.z + od && item.z + d > other.z) return false;\n    }\n    return true;\n  }\n  update(g, inp) {\n    const m = inp.mouse;\n    if (inp.nav.left) { this.cx = Math.max(0, this.cx - 1); g.sound('uiTick'); }\n    if (inp.nav.right) { this.cx = Math.min(this.room.w - 1, this.cx + 1); g.sound('uiTick'); }\n    if (inp.nav.up) { this.cz = Math.max(0, this.cz - 1); g.sound('uiTick'); }\n    if (inp.nav.down) { this.cz = Math.min(this.room.d - 1, this.cz + 1); g.sound('uiTick'); }\n    if (m.moved && m.over) { const h = g.interact.groundPoint(); if (h) { this.cx = Math.max(0, Math.min(this.room.w - 1, Math.floor(h.x))); this.cz = Math.max(0, Math.min(this.room.d - 1, Math.floor(h.z))); } }\n    this.cursor.position.set(this.cx, 0, this.cz);\n    if (this.held) {\n      this.held.x = this.cx; this.held.z = this.cz;\n      const it = ITEMS[this.held.id];\n      const rotated = this.held.rot % 2 === 1;\n      const w = rotated ? it.d : it.w, d = rotated ? it.w : it.d;\n      this.ghost.position.set(this.cx + w / 2, 0, this.cz + d / 2);\n      this.ghost.rotation.y = (this.held.rot * Math.PI) / 2;\n      if (inp.prevTool || inp.tabPrev) { this.held.rot = (this.held.rot + 3) % 4; g.sound('uiTab'); }\n      if (inp.nextTool || inp.tabNext) { this.held.rot = (this.held.rot + 1) % 4; g.sound('uiTab'); }\n    }\n    const act = inp.confirm || m.click;\n    if (act) {\n      if (this.held) {\n        if (!this.fits(g, this.held)) { g.sound('uiError'); g.ui.toastMsg(\"It won't go there. Mind the door.\"); }\n        else {\n          const placed = { id: this.held.id, x: this.held.x, z: this.held.z, rot: this.held.rot, on: true };\n          if (this.held.fresh !== undefined) removeSlot(g, this.held.fresh);\n          this.room.roomData.items.push(placed);\n          this.held = null;\n          this.ghost.removeFromParent();\n          this.room.placeItems();\n          this.room.syncLamps();\n          this.room.attachViews();\n          g.sound('drop');\n          g.events.emit('placed', { id: placed.id });\n          g.world.player.catalog[placed.id] = true;\n        }\n      } else {\n        const list = this.room.roomData.items;\n        const i = list.findIndex((o) => { const it = ITEMS[o.id]; const r = o.rot % 2 === 1; const w = r ? it.d : it.w, d = r ? it.w : it.d; return this.cx >= o.x && this.cx < o.x + w && this.cz >= o.z && this.cz < o.z + d; });\n        if (i >= 0) {\n          const o = list.splice(i, 1)[0];\n          this.held = { id: o.id, x: o.x, z: o.z, rot: o.rot };\n          this.makeGhost(g);\n          this.room.placeItems();\n          this.room.syncLamps();\n          this.room.attachViews();\n          g.sound('pickUp');\n          g.events.emit('lifted', { id: o.id });\n        } else g.sound('uiTick');\n      }\n    }\n    if (inp.square && this.held && this.held.fresh === undefined) {\n      if (hasRoom(g.world)) { addItem(g, this.held.id); this.held = null; this.ghost.removeFromParent(); g.sound('pickUp'); }\n    }\n    if (inp.back || m.rclick) {\n      if (this.held && this.held.fresh === undefined) {\n        // Something still in hand goes back in your pockets\n        if (hasRoom(g.world)) addItem(g, this.held.id);\n        else this.room.roomData.items.push({ id: this.held.id, x: this.held.x, z: this.held.z, rot: this.held.rot, on: true });\n      }\n      this.leave(g);\n    }\n  }\n  leave(g) {\n    g.sound('uiCancel');\n    this.ghost.removeFromParent();\n    this.cursor.removeFromParent();\n    this.grid.removeFromParent();\n    g.hideHud = this.prevHideHud;\n    g.camFocus = null;\n    this.room.placeItems();\n    this.room.syncLamps();\n    this.room.attachViews();\n    g.ui.pop(this);\n  }\n  prompts() { return this.held ? [['confirm', 'Drop'], ['tools', 'Rotate'], ['fill', 'To pockets'], ['back', 'Finish']] : [['confirm', 'Lift'], ['back', 'Finish']]; }\n  draw(g, hud) {\n    if (this.held) {\n      const it = ITEMS[this.held.id];\n      const w = 12 + it.name.length * 6;\n      panel(hud, 240 - w / 2, 14, w, 17, { fill: 'white', trim: 'sand' });\n      drawText(hud, 240, 19, it.name, { align: 'center', color: 'ink' });\n    }\n  }\n}\nexport const placementScreen = (g, i = -1) => new Placement(g, i);\nEOF\ncat > src/ui/screens/bed.js <<'EOF'\n// The bed: it saves, and offers sleep, naps, and hibernation (with a scolding).\nimport { say } from '../../systems/say.js';\nimport { menuChoiceFree } from './numbers.js';\nimport { HOSTS } from '../../data/dialogue/hosts.js';\nimport { villageDay, SEASON_NAMES } from '../../core/calendar.js';\nimport { saveNow, markSessionClean } from '../../systems/session.js';\nimport { hostLine } from '../../systems/lines.js';\nimport { panel, drawText } from '../draw.js';\nimport { tuning } from '../../dev/tuning.js';\nimport { newDay } from '../../systems/flow.js';\nimport { deliverMail } from '../../systems/mail.js';\n\n/** Move the clock forward to a target day and minute, running each night. */\nexport function advanceTo(g, targetDay, minute) {\n  const w = g.world;\n  while (w.clock.day < targetDay) { w.clock.minute = 5 * 60; newDay(g); }\n  w.clock.minute = minute;\n  if (minute >= 9 * 60) deliverMail(g);\n}\nclass AlmanacPage {\n  constructor(title, sub, onDone, seasonSting) { this.id = 'seasonPage'; this.title = title; this.sub = sub; this.onDone = onDone; this.t = 0; this.seasonSting = seasonSting; }\n  currentText() { return this.title; }\n  open(g) { g.sound('almanacTurn'); if (this.seasonSting) g.sound(this.seasonSting); }\n  update(g, inp, dt) {\n    this.t += dt;\n    if (this.t > 0.6 && !this.done) { this.done = true; this.onDone?.(); }\n    if (this.t > 1.2 && (inp.confirm || inp.back || inp.mouse.click) || this.t > 3.4) g.ui.pop(this);\n  }\n  prompts() { return null; }\n  draw(g, hud) {\n    const w = Math.min(480, Math.round(this.t * 1400));\n    hud.rect(0, 0, w, 270, 'white');\n    hud.rect(w, 0, 3, 270, 'mist');\n    if (this.t > 0.32) {\n      drawText(hud, 240, 104, this.title, { align: 'center', color: 'ink', scale: 3 });\n      drawText(hud, 240, 138, this.sub, { align: 'center', color: 'slate' });\n    }\n  }\n}\nexport function* sleepTo(g, kind) {\n  const w = g.world;\n  const c0 = villageDay(w.clock.day);\n  saveNow(g);\n  markSessionClean(g);\n  g.player.play('Sleep', 0.2);\n  g.music.setOverride('lullaby');\n  g.engine.screen.cover('fade', { duration: 0.8 });\n  g.events.emit('sleep', { kind });\n  yield 0.9;\n  w.stats.sleeps += 1;\n  if (kind === 'morning') {\n    const nextDay = w.clock.minute >= 5 * 60 ? w.clock.day + 1 : w.clock.day;\n    advanceTo(g, nextDay, 8 * 60);\n  } else if (kind === 'noon') {\n    if (w.clock.minute >= 12 * 60) advanceTo(g, w.clock.day + 1, 12 * 60);\n    else { w.clock.minute = 12 * 60; deliverMail(g); }\n  } else if (kind === 'dusk') {\n    if (w.clock.minute >= 18 * 60) advanceTo(g, w.clock.day + 1, 18 * 60);\n    else { w.clock.minute = 18 * 60; deliverMail(g); }\n  } else if (kind === 'hibernate') {\n    const now = villageDay(w.clock.day);\n    const toFestival = 4 - ((now.calendarDay - 1) % 4);\n    advanceTo(g, w.clock.day + (toFestival === 1 && now.type === 3 ? 4 : toFestival === 0 ? 4 : toFestival - (now.type === 3 ? 0 : 0)), 8 * 60);\n    g.events.emit('hibernated', {});\n  }\n  g.lastHour = -1;\n  g.sky.placeChanged();\n  const c1 = villageDay(w.clock.day);\n  const seasonChanged = c1.season !== c0.season;\n  g.music.setOverride(null);\n  g.engine.screen.reveal('fade', { duration: 0.4 });\n  if (seasonChanged) {\n    let closed = false;\n    const page = new AlmanacPage(SEASON_NAMES[c1.season], { 0: 'Everything is starting again. It would like you to know.', 1: 'The cicadas have been told.', 2: 'It all goes a nice colour, and then it all goes.', 3: 'Everything is under something.' }[c1.season], () => g.refreshSeason(true), `sting_${['spring', 'summer', 'autumn', 'winter'][c1.season]}`);\n    const origClose = page.close;\n    page.close = () => { closed = true; origClose?.(); };\n    g.ui.push(page);\n    while (!closed) yield;\n  } else g.refreshSeason(true);\n  g.player.play('Idle', 0.2);\n  saveNow(g);\n  g.events.emit('woke', { day: w.clock.day });\n}\nexport function* bedMenu(g) {\n  const w = g.world;\n  const c = yield* menuChoiceFree(g, 'The bed', ['Sleep till morning', 'Nap till noon', 'Nap till dusk', 'Hibernate until the next festival', 'Not yet'], { id: 'bed', w: 240, x: 120 });\n  if (c < 0 || c === 4) return;\n  if (c === 3) yield* say(g, 'gander', hostLine(g, 'gander', 'hibernate'));\n  yield* sleepTo(g, ['morning', 'noon', 'dusk', 'hibernate'][c]);\n}\nexport { HOSTS, panel, tuning };\nEOF\ncat > src/ui/screens/clockFace.js <<'EOF'\nimport { formatTime } from '../../core/calendar.js';\nexport function flavourOfClock(g) {\n  const t = formatTime(g.world.clock.minute);\n  return `It says ${t}. You've no reason to doubt it. Mrs. Gander had it set.`;\n}\nEOF\ncat > src/ui/screens/lookEditor.js <<'EOF'\n// Change your look with a live preview: hair, colour, eyes. Used by the mirror, the salon and the bus.\nimport { panel, drawText, inRect } from '../draw.js';\nimport { HAIR_STYLES, HAIR_COLORS, EYE_STYLES } from '../../art/critter.js';\nimport { wear } from '../../systems/pocketActions.js';\nimport { ITEMS } from '../../data/items.js';\nimport { Menu } from '../ui.js';\n\nconst SKIN = ['sand', 'orange', 'white', 'mist', 'plum', 'lime'];\nclass LookEditor {\n  constructor(g, { title, turntable, hairOnly, free, onDone }) {\n    this.id = 'lookEditor';\n    this.title = title;\n    this.turn = !!turntable;\n    this.hairOnly = hairOnly;\n    this.free = free;\n    this.onDone = onDone;\n    this.focus = 0;\n    this.saved = JSON.stringify(g.world.player.look);\n    this.rows = [\n      { label: 'Hair', get: (l) => HAIR_STYLES[l.hair], step: (l, d) => { l.hair = (l.hair + d + HAIR_STYLES.length) % HAIR_STYLES.length; } },\n      { label: 'Colour', get: (l) => HAIR_COLORS.indexOf(l.hairColor) + 1, step: (l, d) => { l.hairColor = HAIR_COLORS[(HAIR_COLORS.indexOf(l.hairColor) + d + HAIR_COLORS.length) % HAIR_COLORS.length]; } },\n    ];\n    if (!hairOnly) {\n      this.rows.push({ label: 'Eyes', get: (l) => EYE_STYLES[l.eyes], step: (l, d) => { l.eyes = (l.eyes + d + EYE_STYLES.length) % EYE_STYLES.length; } });\n      this.rows.push({ label: 'Skin', get: (l) => SKIN.indexOf(l.skin) + 1, step: (l, d) => { l.skin = SKIN[(SKIN.indexOf(l.skin) + d + SKIN.length) % SKIN.length]; } });\n    }\n    if (free) this.rows.push({ label: 'Wardrobe', get: (l) => ITEMS[l.outfit]?.name ?? '', step: null, action: (gg) => this.wardrobe(gg) });\n    this.face = g.player.facing;\n  }\n  labels() { return this.rows.map((r) => r.label); }\n  focusIndex() { return this.focus; }\n  wardrobe(g) {\n    const w = g.world;\n    const items = [];\n    w.player.pockets.forEach((s, i) => { if (s && ['clothes', 'hat', 'glasses', 'umbrella'].includes(ITEMS[s.id]?.cat)) items.push({ label: ITEMS[s.id].name, icon: ITEMS[s.id].icon, iconColors: ITEMS[s.id].iconColors, action: (gg, m) => { wear(gg, i, s); gg.ui.pop(m); } }); });\n    const look = w.player.look;\n    if (look.hatItem) items.push({ label: 'Take off your hat', action: (gg, m) => { gg.world.player.pockets[gg.world.player.pockets.indexOf(null)] = { id: look.hatItem }; look.hatItem = null; gg.player.applyLook(); gg.ui.pop(m); } });\n    if (look.glassesItem) items.push({ label: 'Take off your glasses', action: (gg, m) => { gg.world.player.pockets[gg.world.player.pockets.indexOf(null)] = { id: look.glassesItem }; look.glassesItem = null; gg.player.applyLook(); gg.ui.pop(m); } });\n    items.push({ label: 'Back', action: (gg, m) => gg.ui.pop(m) });\n    g.ui.push(new Menu({ id: 'wardrobe', title: 'Wardrobe', items, x: 130, y: 66, w: 220, itemH: 19, gap: 2, back: (gg, m) => gg.ui.pop(m) }));\n  }\n  rowRect(i) { return [300, 60 + i * 26, 160, 22]; }\n  update(g, inp, dt) {\n    const m = inp.mouse;\n    if (inp.nav.up) { this.focus = (this.focus + this.rows.length - 1) % this.rows.length; g.sound('uiTick'); }\n    if (inp.nav.down) { this.focus = (this.focus + 1) % this.rows.length; g.sound('uiTick'); }\n    const l = g.world.player.look;\n    const r = this.rows[this.focus];\n    const change = (d) => { if (r.step) { r.step(l, d); g.player.applyLook(); g.player.play('Idle', 0); g.sound('uiTick'); } };\n    if (inp.nav.left) change(-1);\n    if (inp.nav.right) change(1);\n    this.rows.forEach((row, i) => {\n      const [x, y, w, h] = this.rowRect(i);\n      if (inRect(m, x, y, w, h)) {\n        if (m.moved) this.focus = i;\n        if (m.click) { this.focus = i; if (row.action) row.action(g); else { row.step(l, m.x < x + w / 2 ? -1 : 1); g.player.applyLook(); g.sound('uiTick'); } }\n      }\n    });\n    if (this.turn || g.ui.top === this) g.player.facing += dt * (this.turn ? 1.2 : 0.5);\n    if (inp.confirm) {\n      if (r.action) { r.action(g); return; }\n      g.sound('uiConfirm');\n      g.player.facing = this.face;\n      g.ui.pop(this);\n      this.onDone(true);\n      return;\n    }\n    if (inp.back || m.rclick) {\n      g.sound('uiCancel');\n      g.world.player.look = JSON.parse(this.saved);\n      g.player.applyLook();\n      g.player.facing = this.face;\n      g.ui.pop(this);\n      this.onDone(false);\n    }\n  }\n  prompts() { return [['confirm', this.rows[this.focus]?.action ? 'Open' : 'Keep this'], ['back', 'As I was']]; }\n  draw(g, hud) {\n    panel(hud, 292, 22, 176, 44 + this.rows.length * 26, { fill: 'white', trim: 'sand' });\n    drawText(hud, 380, 32, this.title, { align: 'center', color: 'ink' });\n    drawText(hud, 380, 44, 'A very honest reflection.', { align: 'center', color: 'slate' });\n    this.rows.forEach((r, i) => {\n      const [x, y, w, h] = this.rowRect(i);\n      const f = i === this.focus;\n      panel(hud, x, y, w, h, { fill: f ? 'sand' : 'white', trim: f ? 'orange' : 'mist' });\n      drawText(hud, x + 8, y + 7, r.label, { color: 'ink' });\n      drawText(hud, x + w - 8, y + 7, String(r.get(g.world.player.look)), { color: 'plum', align: 'right' });\n    });\n  }\n}\nexport function* lookEditor(g, o) {\n  let result = null;\n  const prev = g.camState.zoomOverride;\n  g.camState.zoomOverride = 2.3;\n  g.ui.push(new LookEditor(g, { ...o, onDone: (r) => { result = r; } }));\n  while (result === null) yield;\n  g.camState.zoomOverride = prev;\n  return result;\n}\nEOF\ncat > src/ui/screens/compare.js <<'EOF'\n// Compare a painting with the catalogue print: a missing star, an extra earring.\nimport { panel, drawText, dim, inRect } from '../draw.js';\nimport { ITEMS } from '../../data/items.js';\nimport { ART } from '../../data/art.js';\nimport { paintingSprite } from '../../art/paintingSprites.js';\n\nclass Compare {\n  constructor(g, stock, onClose) { this.id = 'compare'; this.stock = stock; this.onClose = onClose; this.t = 0; }\n  update(g, inp, dt) { this.t += dt; if (inp.back || inp.confirm || inp.mouse.click || inp.mouse.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onClose?.(); } }\n  currentText() { return this.stock.id; }\n  prompts() { return [['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 40, 30, 400, 190, { fill: 'white', trim: 'sand' });\n    const it = ITEMS[this.stock.id];\n    const genuine = ART.find((a) => a.id === (it.of ?? it.id));\n    drawText(hud, 240, 38, genuine.name, { align: 'center', color: 'ink' });\n    drawText(hud, 140, 54, 'Catalogue print', { align: 'center', color: 'slate' });\n    drawText(hud, 340, 54, 'On the easel', { align: 'center', color: 'slate' });\n    const left = paintingSprite(genuine.id);\n    const right = paintingSprite(this.stock.id);\n    hud.sprite(140 - 88, 66, left.rows, left.colors, { shadow: false, scale: 1 });\n    hud.sprite(340 - 88, 66, right.rows, right.colors, { shadow: false, scale: 1 });\n    drawText(hud, 240, 204, 'Look closely. Magda is pretending not to watch.', { align: 'center', color: 'plum' });\n  }\n}\nexport const compareScreen = (g, stock, onClose) => new Compare(g, stock, onClose);\nexport { inRect };\nEOF\ncat > src/art/paintingSprites.js <<'EOF'\n// Paintings as HUD sprites, baked from the same texture defs, scaled to 176×132.\nimport { PAINTINGS } from './paintings.js';\nimport { bakeTexture, PALETTE } from '../engine.js';\n\nconst NAMES = Object.keys(PALETTE);\nconst cache = new Map();\nconst HEX = Object.fromEntries(NAMES.map((n) => [PALETTE[n], n]));\nfunction nearest(r, g, b) {\n  let best = 'ink', bd = 1e9;\n  for (const n of NAMES) { const h = PALETTE[n]; const d = (((h >> 16) & 255) - r) ** 2 + (((h >> 8) & 255) - g) ** 2 + ((h & 255) - b) ** 2; if (d < bd) { bd = d; best = n; } }\n  return best;\n}\nexport function paintingSprite(id) {\n  if (cache.has(id)) return cache.get(id);\n  const def = PAINTINGS.find((p) => p.id === `art-${id}`);\n  const baked = bakeTexture(def);\n  const w = baked.width ?? baked.size?.[0] ?? 32, h = baked.height ?? baked.size?.[1] ?? 24;\n  const data = baked.data ?? baked.pixels ?? baked.rgba;\n  const chars = 'abcdefghijklmnop';\n  const colors = {};\n  NAMES.forEach((n, i) => { colors[chars[i]] = n; });\n  const S = 5;\n  const rows = [];\n  for (let y = 0; y < h; y++) {\n    let line = '';\n    for (let x = 0; x < w; x++) {\n      const o = (y * w + x) * 4;\n      const name = nearest(data[o], data[o + 1], data[o + 2]);\n      line += chars[NAMES.indexOf(name)].repeat(S);\n    }\n    for (let k = 0; k < S; k++) rows.push(line);\n  }\n  const out = { rows, colors };\n  cache.set(id, out);\n  return out;\n}\nexport { HEX };\nEOF\ngrep -n \"interface BakedTexture\" -A10 kit/API.md | cut -c1-160; grep -n \"bakeTexture\" kit/API.md | head -3","description":"Write catalogue, chime, pattern, placement, bed, look editor, compare"}}}
