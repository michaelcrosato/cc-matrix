n// solid [w, d] cells it blocks (default its footprint or none), act: what pressing on it does.\nconst K = (m) => `kenney-furniture/${m}`;\nconst WOOD = { wood: 'orange', woodDark: 'red', metal: 'mist', metalLight: 'white', metalDark: 'slate', carpet: 'red', carpetDarker: 'plum', lamp: 'sand', plant: 'green', carpetBlue: 'sky' };\nconst DARK = { wood: 'night', woodDark: 'ink', metal: 'slate', metalLight: 'mist', metalDark: 'ink', carpet: 'plum', carpetDarker: 'night', lamp: 'sand', plant: 'teal', carpetBlue: 'navy' };\nconst PALE = { wood: 'white', woodDark: 'mist', metal: 'mist', metalLight: 'white', metalDark: 'slate', carpet: 'sky', carpetDarker: 'blue', lamp: 'cyan', plant: 'green', carpetBlue: 'sky' };\nconst YELLOW = { wood: 'sand', woodDark: 'orange', metal: 'sand', metalLight: 'white', metalDark: 'orange', carpet: 'sand', carpetDarker: 'orange', lamp: 'white', plant: 'lime', carpetBlue: 'sand' };\nconst P = (m, x, z, o = {}) => ({ m, x, z, ...o });\nconst counter = (x, z, w, o = {}) => P('counter', x, z, { params: { w }, solid: [Math.ceil(w), 1], ...o });\nconst bookcase = (x, z, pal = WOOD, o = {}) => P(K('bookcase-open'), x, z, { palette: pal, solid: [1, 1], ...o });\nconst lampRound = (x, z, pal = WOOD) => P(K('lamp-round-floor'), x, z, { palette: pal, solid: [1, 1], light: true });\nconst pot = (x, z, y = 0) => P('soup-pot', x, z, { scale: 0.34, y, solid: y ? null : [1, 1] });\n\nexport const ROOMS = {\n  store: { name: \"Mrs. Gander's\", w: 11, d: 8, wall: 'wall-cream', floor: 'floor-oak', music: 'store', exit: { x: 5.5, z: 7.5, to: 'town', tx: 56, tz: 40.4, facing: 0 }, host: { id: 'gander', x: 8.6, z: 1.5, face: 0.4 },\n    props: [counter(8.4, 2.2, 3, { act: 'ganderCounter', label: 'Talk to Mrs. Gander', r: 1.6, talkTo: 'gander' }), P('shelf', 2, 0.6, { params: { w: 3 }, solid: [3, 1], collide: true }), P('shelf', 5.4, 0.6, { params: { w: 2.4 }, solid: [3, 1] }), P('shelf', 0.6, 3.5, { rot: 90, params: { w: 3 }, solid: [1, 3] }), P('shelf', 0.6, 6.4