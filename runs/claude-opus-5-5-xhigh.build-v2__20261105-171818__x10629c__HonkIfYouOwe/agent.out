dy to lay on the ground or nail to a post.' });\\nSOFT('parcel', 'Parcel',\")\nopen(p,'w').write(s)\np='src/ui/screens/pattern.js'\ns=open(p).read()\ns=s.replace(\"\"\"      ['Save', 250, 150, 60, 18, (g) => this.save(g)], ['Wear', 250, 170, 60, 18, (g) => this.wear(g)],\n    ];\"\"\",\"\"\"      ['Save', 250, 150, 60, 18, (g) => this.save(g)], ['Wear', 250, 170, 60, 18, (g) => this.wear(g)],\n      ['Kit', 250, 190, 60, 18, (g) => this.kit(g)],\n    ];\"\"\")\ns=s.replace(\"\"\"  setSlot(g, s) {\"\"\",\"\"\"  kit(g) {\n    this.save(g);\n    if (addItem(g, 'patternKit', { slot: this.slot }) < 0) { g.ui.toastMsg('Your pockets are full.'); return; }\n    g.sound('pickUp');\n    g.ui.toastMsg('A Pattern Kit, in your pockets. Lay it on the ground, or nail it to a post.');\n  }\n  setSlot(g, s) {\"\"\")\ns=s.replace(\"import { Menu } from '../ui.js';\",\"import { Menu } from '../ui.js';\\nimport { addItem } from '../../systems/economy.js';\")\nopen(p,'w').write(s)\np='src/systems/pocketActions.js'\ns=open(p).read()\ns=s.replace(\"\"\"  if (slot.id === 'medicine') add('Take it',\"\"\",\"\"\"  if (slot.id === 'patternKit' && inTown) {\n    const put = (k) => (gg, m) => {\n      const [tx, tz] = frontTile(gg);\n      if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not here. Find a clear patch of ground.'); return; }\n      removeSlot(gg, i);\n      w.town.objects[`${tx},${tz}`] = { k, slot: slot.slot ?? 0 };\n      gg.town.dirty.add(`${tx},${tz}`);\n      gg.sound('drop');\n      gg.events.emit('patternPlaced', { k });\n      closeAll(gg, m);\n    };\n    add('Lay it here', put('pattern'));\n    add('Put up a sign', put('patternSign'));\n  }\n  if (slot.id === 'medicine') add('Take it',\"\"\")\nopen(p,'w').write(s)\np='src/world/objectsView.js'\ns=open(p).read()\ns=s.replace(\"\"\"    default: break;\n  }\n  return group;\"\"\",\"\"\"    case 'patternSign': {\n      const tex = town.g.patternTexture?.(o.slot);\n      const post = new Mesh(new BoxGeometry(0.1, 1.1, 0.1), toonMaterial(PALETTE.plum));\n      post.position.y = 0.55;\n      group.add(post);\n      if (tex) { const board = new Mesh(new BoxGeometry(0.9, 0.9, 0.06), toonMaterial(PALETTE.white, { map: tex })); board.position.set(0, 1.3, 0.06); group.add(board); }\n      break;\n    }\n    default: break;\n  }\n  return group;\"\"\")\nopen(p,'w').write(s)\np='src/systems/townVerbs.js'\ns=open(p).read()\ns=s.replace(\"\"\"    case 'pattern': return { label: 'Scuff the pattern off', act: 'clearPattern' };\"\"\",\"\"\"    case 'pattern': return { label: 'Scuff the pattern off', act: 'clearPattern' };\n    case 'patternSign': return { label: 'Take the sign down', act: 'clearPattern' };\"\"\")\nopen(p,'w').write(s)\np='src/world/town.js'\ns=open(p).read()\ns=s.replace(\"export const SOLID_KINDS = new Set(['tree', 'stump', 'sapling', 'rock', 'hole', 'snowman', 'beanstalk']);\",\"export const SOLID_KINDS = new Set(['tree', 'stump', 'sapling', 'rock', 'hole', 'snowman', 'beanstalk', 'patternSign']);\")\nopen(p,'w').write(s)\np='tests/play/part2.mjs'\ns=open(p).read()\ns=s.replace(\"\"\"  const bedItem = { id: 'cottageBed', x: 1, z: 1, rot: 0, on: true };\n  w().home.rooms.main.items.push(bedItem);\n  g.place.rebuild();\n\"\"\",\"\"\"  g.place.rebuild();\n\"\"\")\nopen(p,'w').write(s)\np='tests/play/playthrough.mjs'\ns=open(p).read()\ns=s.replace(\"w().clock.minute = Math.max(w().clock.minute, 8 * 60); g.weatherKey = null; g.lastHour = -1; b.step(4); g.refreshSeason(); };\",\"w().clock.minute = Math.max(w().clock.minute, 8 * 60); g.weatherKey = null; g.lastHour = -1; b.step(4); for (let i = 0; i < 400 && b.top?.id === 'seasonPage'; i++) b.step(2); g.refreshSeason(); };\")\nopen(p,'w').write(s)\nEOF\nnode tools/modelcheck.mjs | tail -3 | cut -c1-200; timeout 60 node tests/sim/cli.mjs | tail -4 | cut -c1-200; tools/smoke.sh tests/play/cli.mjs 280 14","description":"Apply the polish batch and rerun sim and playthrough"},"caller":{"type":"direct"}}],"con