ft', at: [tx, tz], item: slot.id });\n    else { w.town.objects[`${tx},${tz}`] = { k: 'drop', item: slot.id }; gg.town.dirty.add(`${tx},${tz}`); gg.net?.t.send({ t: 'ev', k: 'obj', key: `${tx},${tz}`, o: w.town.objects[`${tx},${tz}`] }); }\n    gg.sound('drop');\n    closeAll(gg, m);\"\"\")\nopen(p,'w').write(s)\np='src/ui/screens/pause.js'\ns=open(p).read()\ns=s.replace(\"\"\"    { label: 'Save & Quit to Title', action: (gg) => { saveNow(gg); markSessionClean(gg); gg.quitToTitle(); } },\"\"\",\"\"\"    { label: g.net?.role === 'guest' ? 'Catch the bus home' : 'Save & Quit to Title', action: (gg) => { saveNow(gg); markSessionClean(gg); gg.quitToTitle(); } },\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"guest\" src/systems/actions.js | head -5 | cut -c1-120; sed -i \"s/  \\*busStop(g) {\\n    const w = g.world;/&/\" src/systems/actions.js; python3 - <<'EOF'\np='/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171818__x10629c/work/HonkIfYouOwe-AnimalCrossingCityFolk-claude-opus-5-5-xhigh-20261105-171818/src/systems/actions.js'\ns=open(p).read()\ns=s.replace(\"if (g.visiting) { g.ui.toastMsg(\\\"Bus doesn't run while you have company.\\\"); return; }\\n    const c = yield* ask(g, 'hester'\",\"if (g.visiting) { g.ui.toastMsg(\\\"Bus doesn't run while you have company.\\\"); return; }\\n    const c = yield* ask(g, 'hester'\")\ns=s.replace(\"\"\"    if (w.story.day1Active) { yield* narrate(g, \"A sign on the stop says: 'Bus suspended pending your errands. Signed, a goose.'\"); return; }\n    if (g.visiting) {\"\"\",\"\"\"    if (w.story.day1Active) { yield* narrate(g, \"A sign on the stop says: 'Bus suspended pending your errands. Signed, a goose.'\"); return; }\n    if (g.net) {\"\"\")\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs | tail -1; tools/smoke.sh tests/play/try1.mjs 300 3","description":"Write Visit: BroadcastChannel, WebRTC codes and menus"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20715,"cache_read_input_tokens":778186,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20715},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"0cc9e52b-907e-410d-9149-74cd9520f65e","timestamp":"2026-11-06T01:46:49.425Z","request_id":"req_011Cgkq23F4B9C7oAs7Be8BX","wire_tool_inputs":{"toolu_01NRssrsRVqguXMBscAHSytZ":{"command":"cat >> ../PROGRESS.md <<'EOF'\n- [x] net/arena.js (Bean Bazaar), net/hubStart.js, tests/hub/run_hub.py (players=2 passes). In progress: Visit (net/visit.js, visitUi.js placeholder).\nEOF\ncat > src/net/visit.js <<'EOF'\n// Visit: a friend comes to your village, on its own. BroadcastChannel on one computer; serverless\n// WebRTC with invite codes across two. Star of up to 3 guests; the host's world is authoritative.\n// These objects are only ever created outside a Hub session.\nimport { Transport } from './transport.js';\nimport { packAvatar, unpackAvatar, RemoteTrack, SEND_RATE, chunkString } from './protocol.js';\nimport { Actor } from '../actors/rig.js';\nimport { avatarDef } from '../art/critter.js';\nimport { newWorld } from '../core/save.js';\nimport { store } from '../core/storage.js';\nimport { ITEMS } from '../data/items.js';\nimport { LANDMARKS } from '../data/town.js';\nimport { addItem, hasRoom } from '../systems/economy.js';\nimport { drawText } from '../ui/draw.js';\n\nconst CHANNEL = 'honk-if-you-owe:gates';\nconst GUEST_KEY = 'honk:guest';\nconst uid = () => Math.floor(Math.random() * 1e9).toString(36);\n\n/** One BroadcastChannel per open gate; same browser profile only. */\nexport class BroadcastTransport extends Transport {\n  constructor(role, gateId = null, onHosts = null) {\n    super();\n    this.id = uid();\n    this.isHost = role === 'host';\n    this.gateId = gateId ?? (this.isHost ? this.id : null);\n    this.onHosts = onHosts;\n    this.lobby = new BroadcastChannel(CHANNEL);\n    this.lobby.onmessage = (e) => this.onLobby(e.data);\n    if (this.isHost) { this.open(); this.announceT = setInterval(() => this.announce(), 1000); this.announce(); }\n    else this.lobby.postMessage({ k: 'who' });\n  }\n  open() {\n    this.ch = new BroadcastChannel(`${CHANNEL}:${this.gateId}`);\n    this.ch.onmessage = (e) => {\n      const m = e.data;\n      if (m.to && m.to !== this.id) return;\n      if (m.from === this.id) return;\n      if (m.join && this.isHost) { this.emit('join', m.from, m.join); return; }\n      if (m.bye) { this.emit('leave', m.from); return; }\n      this.emit('message', m.d, m.from);\n    };\n  }\n  announce() { this.lobby.postMessage({ k: 'gate', id: this.gateId, name: this.hostName ?? 'A village', count: this.guestCount ?? 0 }); }\n  onLobby(m) {\n    if (m.k === 'who' && this.isHost) this.announce();\n    if (m.k === 'gate' && !this.isHost) this.onHosts?.(m);\n  }\n  joinGate(gateId, hello) { this.gateId = gateId; this.open(); this.ch.postMessage({ from: this.id, join: hello }); }\n  send(d, { to } = {}) {\n    if (!this.budget.take(performance.now())) return false;\n    this.ch?.postMessage({ from: this.id, to, d });\n    return true;\n  }\n  close() {\n    clearInterval(this.announceT);\n    this.ch?.postMessage({ from: this.id, bye: true });\n    this.ch?.close();\n    this.lobby?.close();\n  }\n}\n\n// ---- WebRTC with invite codes: a Gate Pass goes to the friend, a Reply Slip comes back ---------------\nconst ICE = typeof location !== 'undefined' && /iceServers=none/.test(location.search) ? [] : [{ urls: 'stun:stun.l.google.com:19302' }];\nexport async function packCode(obj) {\n  const bytes = new TextEncoder().encode(JSON.stringify(obj));\n  const stream = new Blob([bytes]).stream().pipeThrough(new CompressionStream('deflate-raw'));\n  const out = new Uint8Array(await new Response(stream).arrayBuffer());\n  let bin = '';\n  for (const b of out) bin += String.fromCharCode(b);\n  return btoa(bin);\n}\nexport async function unpackCode(code) {\n  const bin = atob(code.trim());\n  const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));\n  const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate-raw'));\n  return JSON.parse(await new Response(stream).text());\n}\nconst waitForIce = (pc) => new Promise((resolve) => {\n  if (pc.iceGatheringState === 'complete') { resolve(); return; }\n  const t = setTimeout(resolve, 4000);\n  pc.addEventListener('icegatheringstatechange', () => { if (pc.iceGatheringState === 'complete') { clearTimeout(t); resolve(); } });\n});\nexport class RtcTransport extends Transport {\n  constructor(role) { super(); this.id = uid(); this.isHost = role === 'host'; this.peers = new Map(); this.pending = null; }\n  wire(peerId, pc, ch) {\n    const peer = { id: peerId, pc, rel: ch, unrel: null };\n    this.peers.set(peerId, peer);\n    ch.onmessage = (e) => this.deliver(peer, e.data);\n    ch.onopen = () => this.emit('open', peer.id);\n    ch.onclose = () => { this.peers.delete(peer.id); this.emit('leave', peer.id); };\n    pc.ondatachannel = (e) => this.acceptChannel(peer, e.channel);\n    return peer;\n  }\n  acceptChannel(peer, ch) {\n    if (ch.label === 'rel') { peer.rel = ch; ch.onmessage = (e) => this.deliver(peer, e.data); ch.onopen = () => this.emit('open', peer.id); if (ch.readyState === 'open') this.emit('open', peer.id); ch.onclose = () => { this.peers.delete(peer.id); this.emit('leave', peer.id); }; }\n    else { peer.unrel = ch; ch.onmessage = (e) => this.deliver(peer, e.data); }\n  }\n  deliver(peer, raw) {\n    const m = JSON.parse(raw);\n    if (m.join && this.isHost) { peer.gid = m.from; peer.id = m.from; this.peers.set(m.from, peer); this.emit('join', m.from, m.join); return; }\n    this.emit('message', m.d, peer.gid ?? peer.id);\n  }\n  /** Host: make a Gate Pass for one more friend. */\n  async makePass() {\n    const pc = new RTCPeerConnection({ iceServers: ICE });\n    const rel = pc.createDataChannel('rel', { ordered: true });\n    const unrel = pc.createDataChannel('unrel', { ordered: false, maxRetransmits: 0 });\n    const peerId = `p${uid()}`;\n    const peer = this.wire(peerId, pc, rel);\n    peer.unrel = unrel;\n    unrel.onmessage = (e) => this.deliver(peer, e.data);\n    await pc.setLocalDescription(await pc.createOffer());\n    await waitForIce(pc);\n    this.pending = peer;\n    return packCode({ t: pc.localDescription.type, s: pc.localDescription.sdp });\n  }\n  /** Guest: read a Gate Pass, make a Reply Slip. */\n  async answerPass(code) {\n    const offer = await unpackCode(code);\n    const pc = new RTCPeerConnection({ iceServers: ICE });\n    const peer = { id: 'host', pc, rel: null, unrel: null };\n    this.peers.set('host', peer);\n    pc.ondatachannel = (e) => this.acceptChannel(peer, e.channel);\n    await pc.setRemoteDescription({ type: offer.t, sdp: offer.s });\n    await pc.setLocalDescription(await pc.createAnswer());\n    await waitForIce(pc);\n    return packCode({ t: pc.localDescription.type, s: pc.localDescription.sdp });\n  }\n  /** Host: read the Reply Slip. */\n  async acceptReply(code) {\n    const answer = await unpackCode(code);\n    await this.pending.pc.setRemoteDescription({ type: answer.t, sdp: answer.s });\n  }\n  joinGate(_, hello) { const p = this.peers.get('host'); p?.rel?.send(JSON.stringify({ from: this.id, join: hello })); }\n  send(d, { to, reliable = true } = {}) {\n    if (!this.budget.take(performance.now())) return false;\n    const raw = JSON.stringify({ d });\n    for (const [id, peer] of this.peers) {\n      if (to && id !== to) continue;\n      const ch = reliable ? peer.rel : (peer.unrel?.readyState === 'open' ? peer.unrel : peer.rel);\n      if (ch?.readyState === 'open') ch.send(raw);\n    }\n    return true;\n  }\n  close() { for (const p of this.peers.values()) p.pc.close(); this.peers.clear(); }\n}\n\n/** Host and guest sides of a visit, behind one Transport. */\nexport class VisitSession {\n  constructor(g, transport, role) {\n    this.g = g;\n    this.t = transport;\n    this.role = role;\n    this.remotes = new Map();\n    this.sendT = 0;\n    this.incoming = [];\n    this.emoteT = new Map();\n    transport.on('message', (d, from) => this.onMessage(d, from));\n    transport.on('join', (id, hello) => this.onJoin(id, hello));\n    transport.on('leave', (id) => this.onLeave(id));\n    g.net = this;\n    g.visiting = true;\n    g.events.emit('visitStart', { role });\n  }\n  addRemote(id, name, seat) {\n    if (this.remotes.has(id)) return this.remotes.get(id);\n    const a = new Actor(avatarDef({ shirt: ['red', 'blue', 'green', 'sand'][seat % 4], hair: seat % 8, hairColor: 'orange' }, `visit-${id}`), { name, seed: seat + 3 });\n    a.addTo(this.g.town.group);\n    const r = { id, name, a, track: new RemoteTrack(), seat };\n    this.remotes.set(id, r);\n    return r;\n  }\n  onJoin(id, hello) {\n    const g = this.g;\n    if (this.remotes.size >= 3) { this.t.send({ t: 'full' }, { to: id }); return; }\n    const seat = this.remotes.size + 1;\n    this.addRemote(id, clean(hello.name), seat);\n    // A chunked reliable town snapshot: tiles, objects, weather, time, neighbours\n    const w = g.world;\n    const snapshot = JSON.stringify({ seed: w.seed, clock: w.clock, town: w.town, npcs: w.npcs, flags: { forceWeather: w.flags.forceWeather ?? null, shackRoof: w.flags.shackRoof }, player: { homeTier: w.player.homeTier, name: w.player.name, town: w.player.town }, home: { wallColor: w.home.wallColor, roofColor: w.home.roofColor }, store: w.store, museum: { open: true }, hostName: w.player.name });\n    const chunks = chunkString(snapshot);\n    chunks.forEach((c, i) => this.t.send({ t: 'town', i, n: chunks.length, c }, { to: id, reliable: true }));\n    this.t.send({ t: 'hello', seat, host: w.player.name }, { to: id, reliable: true });\n    g.events.emit('visitJoined', { id, name: hello.name });\n    g.ui.toastMsg(`${clean(hello.name)} has come by bus.`);\n    g.sound('busHorn');\n  }\n  onLeave(id) {\n    const g = this.g;\n    if (this.role === 'guest' && (id === 'host' || id === this.hostId)) { g.ui.toastMsg('The host went home. So do you.'); this.leave(); return; }\n    const r = this.remotes.get(id);\n    if (r) { r.a.remove(); this.remotes.delete(id); g.ui.toastMsg(`${r.name} caught the bus home.`); g.events.emit('visitLeft', { id }); }\n  }\n  onMessage(d, from) {\n    const g = this.g;\n    switch (d.t) {\n      case 'me': {\n        const r = this.remotes.get(from);\n        if (r) r.track.push(g.ctx.time * 1000, unpackAvatar(d.a));\n        break;\n      }\n      case 'snap': {\n        for (const raw of d.a) { const u = unpackAvatar(raw); if (u.id === this.t.id) continue; const r = this.remotes.get(u.id) ?? this.addRemote(u.id, u.id === 'host' ? this.hostName ?? 'Host' : 'Visitor', this.remotes.size + 1); r.track.push(g.ctx.time * 1000, u); }\n        break;\n      }\n      case 'town': {\n        this.incoming[d.i] = d.c;\n        if (this.incoming.filter(Boolean).length === d.n) this.buildGuestTown(JSON.parse(this.incoming.join('')));\n        break;\n      }\n      case 'hello': this.hostName = clean(d.host); break;\n      case 'do': this.onDo(d, from); break;\n      case 'ev': this.onEv(d, from); break;\n      case 'emote': { const r = this.remotes.get(from) ?? [...this.remotes.values()].find((x) => x.id === d.id); r?.a.play(d.clip, 0.1, { once: true }); if (this.role === 'host') this.t.send({ t: 'emote', id: from, clip: d.clip }); break; }\n      case 'full': g.ui.toastMsg('That gate is full.'); this.leave(); break;\n      case 'bye': this.leave(); break;\n      default: break;\n    }\n  }\n  /** Guest: build a temporary town from the host's. Your own save is untouched. */\n  buildGuestTown(snap) {\n    const g = this.g;\n    const w = newWorld(snap.seed, { demo: true });\n    Object.assign(w.clock, snap.clock);\n    w.town = snap.town;\n    w.npcs = snap.npcs;\n    w.player.homeTier = snap.player.homeTier;\n    w.player.name = g.guestProfile?.name ?? 'Visitor';\n    w.player.town = snap.player.town;\n    w.player.beans = g.guestProfile?.beans ?? 0;\n    w.player.pockets = g.guestProfile?.pockets ?? Array(15).fill(null);\n    w.player.tools = ['net', 'rod'];\n    w.player.look = g.guestProfile?.look ?? w.player.look;\n    w.flags = { ...w.flags, ...snap.flags, visiting: true };\n    w.home.wallColor = snap.home.wallColor; w.home.roofColor = snap.home.roofColor;\n    w.store = snap.store;\n    w.museum.open = true;\n    this.hostName = clean(snap.hostName);\n    g.visitArrive(w);\n    g.events.emit('visitArrived', {});\n    g.ui.toastMsg(`Welcome to ${clean(snap.player.town)}. Bus doesn't run while you have company.`);\n  }\n  /** Host validates: catches and pickups claimed by a guest. */\n  onDo(d, from) {\n    const g = this.g;\n    const w = g.world;\n    if (d.a === 'pick') {\n      const o = w.town.objects[d.k];\n      if (!o || !['drop', 'shell', 'driftwood', 'flowerGift'].includes(o.k)) { this.t.send({ t: 'ev', k: 'denied', key: d.k }, { to: from }); return; }\n      delete w.town.objects[d.k];\n      g.town.dirty.add(d.k);\n      this.t.send({ t: 'ev', k: 'obj', key: d.k, o: null });\n      this.t.send({ t: 'ev', k: 'granted', item: o.item, key: d.k }, { to: from });\n      g.events.emit('visitPick', { from, item: o.item });\n    } else if (d.a === 'shake') {\n      const o = w.town.objects[d.k];\n      if (!o || o.k !== 'tree') return;\n      g.life.shakeTree(d.k, o);\n      for (const k of Object.keys(w.town.objects)) if (w.town.objects[k].k === 'drop') this.t.send({ t: 'ev', k: 'obj', key: k, o: w.town.objects[k] });\n      this.t.send({ t: 'ev', k: 'obj', key: d.k, o });\n    } else if (d.a === 'gift') {\n      const [x, z] = d.at;\n      const key = `${x},${z}`;\n      if (!w.town.objects[key]) { w.town.objects[key] = { k: 'drop', item: d.item }; g.town.dirty.add(key); this.t.send({ t: 'ev', k: 'obj', key, o: w.town.objects[key] }); }\n      g.events.emit('visitGift', { from, item: d.item });\n    }\n  }\n  onEv(d) {\n    const g = this.g;\n    const w = g.world;\n    if (d.k === 'obj') { if (d.o) w.town.objects[d.key] = d.o; else delete w.town.objects[d.key]; g.town.dirty.add(d.key); }\n    if (d.k === 'granted') { addItem(g, d.item); g.sound('pickUp'); }\n    if (d.k === 'denied') g.ui.toastMsg('Somebody got there first.');\n  }\n  /** Each frame. Own avatar is predicted; remotes render 120 ms in the past and snap if 3 m off. */\n  update(dt) {\n    const g = this.g;\n    const now = g.ctx.time * 1000;\n    for (const r of this.remotes.values()) {\n      const tr = r.track.at(now);\n      if (tr.seen) { r.a.x = tr.x; r.a.z = tr.z; r.a.y = g.town.height(tr.x, tr.z); r.a.turnTo = tr.facing; if (!r.a.current?.once || r.a.finished) r.a.play(tr.action ? 'Jog' : 'Idle', 0.15); }\n      r.a.update(dt);\n      r.a.visible = g.place === g.town;\n    }\n    this.sendT -= dt;\n    if (this.sendT > 0) return;\n    this.sendT = SEND_RATE;\n    const p = g.player;\n    const self = { id: this.t.id, x: p.x, z: p.z, facing: p.facing, action: p.speed > 0.2 ? 1 : 0 };\n    if (this.role === 'guest') this.t.send({ t: 'me', a: packAvatar(self) }, { reliable: false });\n    else {\n      const list = [packAvatar({ ...self, id: 'host' })];\n      for (const r of this.remotes.values()) list.push(packAvatar({ id: r.id, x: r.a.x, z: r.a.z, facing: r.a.facing, action: r.track.action }));\n      this.t.send({ t: 'snap', a: list }, { reliable: false });\n    }\n  }\n  emote(em) {\n    const CLIP = { wave: 'Wave', laugh: 'Laugh', cry: 'Cry', shock: 'Shock', anger: 'Anger', love: 'Love', shrug: 'Shrug', bow: 'Bow', dance: 'Dance' };\n    this.t.send({ t: 'emote', clip: CLIP[em] });\n  }\n  /** Leave: a guest keeps pockets and beans, nothing else. */\n  leave() {\n    const g = this.g;\n    if (this.left) return;\n    this.left = true;\n    const role = this.role;\n    if (role === 'guest') {\n      store.set(GUEST_KEY, { pockets: g.world.player.pockets, beans: g.world.player.beans });\n      const saved = store.get('honk:save');\n      if (saved) { saved.player.pockets = g.world.player.pockets; saved.player.beans = g.world.player.beans; store.set('honk:save', saved); }\n    } else this.t.send({ t: 'bye' });\n    this.t.close();\n    for (const r of this.remotes.values()) r.a.remove();\n    this.remotes.clear();\n    g.net = null;\n    g.visiting = false;\n    g.events.emit('visitEnd', { role });\n    if (role === 'guest') g.goTitleFromVisit();\n  }\n}\nconst clean = (s) => String(s ?? '').replace(/[^A-Za-z0-9 .,!?'&()_-]/g, '').slice(0, 14);\nexport const visitActors = { LANDMARKS, ITEMS, hasRoom, drawText };\nEOF\ncat > src/net/visitUi.js <<'EOF'\n// The Visit menus: Open my gate, Visit a friend, on one computer or by Gate Pass.\nimport { Menu } from '../ui/ui.js';\nimport { panel, drawText, dim, wrap, textBlock } from '../ui/draw.js';\nimport { loadWorld } from '../core/save.js';\nimport { BroadcastTransport, RtcTransport, VisitSession } from './visit.js';\nimport { continueGame, installWorld } from '../systems/newgame.js';\nimport { rebuildAllObjects } from '../world/objectsView.js';\n\nconst box = () => {\n  // A pixel-styled DOM textarea for pasting codes: it needs a keyboard, and says so.\n  if (typeof document === 'undefined') return null;\n  let t = document.getElementById('gate-code');\n  if (!t) {\n    t = document.createElement('textarea');\n    t.id = 'gate-code';\n    t.style.cssText = 'position:fixed;left:18%;top:42%;width:64%;height:22%;background:#f4f4f4;color:#1a1c2c;border:6px solid #ffcd75;font:bold 16px monospace;z-index:30;padding:8px;outline:none;';\n    t.spellcheck = false;\n    document.body.appendChild(t);\n  }\n  t.style.display = 'block';\n  return t;\n};\nconst hideBox = () => { const t = typeof document !== 'undefined' && document.getElementById('gate-code'); if (t) t.style.display = 'none'; };\nclass CodeScreen {\n  constructor({ title, text, readOnly, value = '', onDone, onCancel, allowCopy }) {\n    this.id = 'gateCode'; this.title = title; this.text = text; this.readOnly = readOnly; this.onDone = onDone; this.onCancel = onCancel; this.allowCopy = allowCopy; this.value = value; this.copied = false;\n  }\n  labels() { return ['OK', 'Copy']; }\n  open() {\n    this.el = box();\n    if (this.el) { this.el.value = this.value; this.el.readOnly = !!this.readOnly; this.el.focus(); if (this.readOnly) this.el.select(); this.el.oninput = () => { this.value = this.el.value; }; }\n  }\n  close() { hideBox(); }\n  currentText() { return this.el?.value ?? this.value; }\n  update(g, inp) {\n    const input = g.ctx.input;\n    // Enter finishes; Escape backs out; while the box has focus keys type into it.\n    if (input.wasPressed('Enter') || input.wasPressed('PadCross')) { if (this.el) this.value = this.el.value; g.sound('uiConfirm'); g.ui.pop(this); this.onDone?.(this.value); return; }\n    if (input.wasPressed('Escape') || input.wasPressed('PadCircle')) { g.sound('uiCancel'); g.ui.pop(this); this.onCancel?.(); return; }\n    if (this.allowCopy && (input.wasPressed('KeyC') || input.wasPressed('PadSquare')) && this.readOnly) { navigator.clipboard?.writeText(this.value).catch(() => {}); this.el?.select(); this.copied = true; g.sound('stamp'); }\n  }\n  prompts() { return [['confirm', this.readOnly ? 'Done' : 'Go'], ['back', 'Back']]; }\n  draw(g, hud) {\n    dim(hud);\n    panel(hud, 60, 24, 360, 216, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, 34, this.title, { align: 'center', color: 'ink', scale: 2 });\n    textBlock(hud, 76, 62, 330, this.text, { color: 'slate' });\n    if (this.allowCopy) drawText(hud, 240, 222, this.copied ? 'Copied. Or select it and copy by hand.' : 'Press C to copy, or select it by hand.', { align: 'center', color: 'plum' });\n  }\n}\n/** The host opens their gate on their own save. */\nexport function openGate(g, kind) {\n  const saved = loadWorld();\n  if (!saved) { g.ui.toastMsg('You need a village first. Try New Arrival.'); return; }\n  continueGame(g);\n  if (kind === 'local') {\n    const t = new BroadcastTransport('host');\n    t.hostName = g.world.player.name;\n    const s = new VisitSession(g, t, 'host');\n    g.events.emit('gateOpen', { kind });\n    g.ui.toastMsg('Your gate is open. A second window on this computer can visit.');\n    return s;\n  }\n  const t = new RtcTransport('host');\n  const s = new VisitSession(g, t, 'host');\n  g.scripts.run(hostRtcFlow(g, t), { name: 'gatePass' });\n  return s;\n}\nfunction* hostRtcFlow(g, t) {\n  let code = null;\n  t.makePass().then((c) => { code = c; });\n  g.ui.toastMsg('Writing your Gate Pass…');\n  while (code === null) yield;\n  let closed = false;\n  g.ui.push(new CodeScreen({ title: 'Your Gate Pass', text: 'Send this to your friend, however friends send things. Then paste the Reply Slip they send back. This is a very long friend code, and we are sorry. A little.', readOnly: true, value: code, allowCopy: true, onDone: () => { closed = true; }, onCancel: () => { closed = true; } }));\n  while (!closed) yield;\n  let reply = null;\n  g.ui.push(new CodeScreen({ title: 'Their Reply Slip', text: 'Paste what they sent. It needs a keyboard. Sorry about that too.', readOnly: false, onDone: (v) => { reply = v; }, onCancel: () => { reply = ''; } }));\n  while (reply === null) yield;\n  if (reply) t.acceptReply(reply).catch(() => g.ui.toastMsg(\"That Reply Slip doesn't read right.\"));\n}\n/** A guest's temporary profile: only pockets and beans come along. */\nfunction guestProfile() {\n  const saved = loadWorld();\n  return { name: saved?.player.name ?? 'Visitor', beans: saved?.player.beans ?? 500, pockets: saved?.player.pockets ?? Array(15).fill(null), look: saved?.player.look ?? null };\n}\nexport function visitFriendLocal(g, onList) {\n  g.guestProfile = guestProfile();\n  const t = new BroadcastTransport('guest', null, (m) => onList?.(m, t));\n  return t;\n}\nfunction localGuestMenu(g) {\n  const seen = new Map();\n  const items = [{ label: 'Looking for gates…', disabled: true }, { label: 'Back', action: (gg, m) => { t.close(); gg.ui.pop(m); } }];\n  let m = null;\n  const t = visitFriendLocal(g, (gate) => {\n    if (seen.has(gate.id)) return;\n    seen.set(gate.id, gate);\n    items.unshift({ label: `${gate.name}'s village`, action: (gg, mm) => { gg.ui.pop(mm); joinLocal(gg, t, gate.id); } });\n    if (m) { m.items = items; m.focus = 0; }\n  });\n  m = new Menu({ id: 'visitLocal', title: 'Gates on this computer', items, x: 110, y: 90, w: 260, back: (gg, mm) => { t.close(); gg.ui.pop(mm); } });\n  return m;\n}\nexport function joinLocal(g, t, gateId) {\n  g.guestProfile ??= guestProfile();\n  const s = new VisitSession(g, t, 'guest');\n  s.hostId = gateId;\n  t.joinGate(gateId, { name: g.guestProfile.name });\n  g.ui.toastMsg('You wait at the stop. The bus comes.');\n  return s;\n}\nfunction* guestRtcFlow(g) {\n  g.guestProfile = guestProfile();\n  let pass = null;\n  g.ui.push(new CodeScreen({ title: 'Their Gate Pass', text: 'Paste the Gate Pass your friend sent. It needs a keyboard.', readOnly: false, onDone: (v) => { pass = v; }, onCancel: () => { pass = ''; } }));\n  while (pass === null) yield;\n  if (!pass) return;\n  const t = new RtcTransport('guest');\n  const s = new VisitSession(g, t, 'guest');\n  s.hostId = 'host';\n  let slip = null;\n  t.answerPass(pass).then((c) => { slip = c; }).catch(() => { slip = ''; });\n  while (slip === null) yield;\n  if (!slip) { g.ui.toastMsg(\"That Gate Pass doesn't read right.\"); s.leave(); return; }\n  t.on('open', () => t.joinGate(null, { name: g.guestProfile.name }));\n  let closed = false;\n  g.ui.push(new CodeScreen({ title: 'Your Reply Slip', text: 'Send this back to your friend. When they paste it, the bus comes.', readOnly: true, value: slip, allowCopy: true, onDone: () => { closed = true; }, onCancel: () => { closed = true; } }));\n  while (!closed) yield;\n}\nexport function visitMenu(g) {\n  const items = [\n    { label: 'Open my gate, on this computer', action: (gg) => openGate(gg, 'local') },\n    { label: 'Open my gate, by Gate Pass', action: (gg) => openGate(gg, 'rtc') },\n    { label: 'Visit a friend, on this computer', action: (gg) => gg.ui.push(localGuestMenu(gg)) },\n    { label: 'Visit a friend, by Gate Pass', action: (gg, m) => { gg.scripts.run(guestRtcFlow(gg), { name: 'gatePassGuest' }); } },\n    { label: 'Back', action: (gg, m) => gg.ui.pop(m) },\n  ];\n  return new Menu({ id: 'visit', title: 'Visit', items, x: 90, y: 80, w: 300, back: (gg, m) => gg.ui.pop(m) });\n}\nexport { CodeScreen, wrap, installWorld, rebuildAllObjects };\nEOF\npython3 - <<'EOF'\np='src/game.js'\ns=open(p).read()\ns=s.replace(\"\"\"  quitToTitle() { quitToTitle(this); }\"\"\",\"\"\"  quitToTitle() { if (this.net) this.net.leave(); quitToTitle(this); }\n  /** A guest arrives by bus in the host's town: a temporary world, not their own save. */\n  visitArrive(world) {\n    this.ui.popAll();\n    this.mode = 'play';\n    this.demo = true; // nothing a guest does writes a save\n    this.camFocus = null;\n    this.place.group.visible = false;\n    this.place.leave?.(this);\n    this.player.remove();\n    this.place = this.town;\n    this.town.group.visible = true;\n    this.player.addTo(this.town.group);\n    installWorld(this, world);\n    rebuildAllObjects(this.town);\n    this.swapPlace(this.town, LANDMARKS.busStop[0], LANDMARKS.busStop[1] + 0.3, 0);\n  }\n  goTitleFromVisit() { this.ui.popAll(); this.scripts.cancelAll(); this.goTitle(); }\"\"\")\ns=s.replace(\"\"\"    this.ambience.update(dt);\"\"\",\"\"\"    this.net?.update(dt);\n    this.ambience.update(dt);\"\"\")\ns=s.replace(\"import { fingerprintOf } from './dev/fingerprint.js';\",\"import { fingerprintOf } from './dev/fingerprint.js';\\nimport { LANDMARKS } from './data/town.js';\")\nopen(p,'w').write(s)\np='src/ui/screens/emote.js'\ns=open(p).read()\ns=s.replace(\"g.net?.emote?.(em);\",\"g.net?.emote(em);\")\nopen(p,'w').write(s)\n# Guests may catch, pick fruit, chat through emotes, drop gifts; they can't fell trees, pull flowers or use the bus.\np='src/systems/actions.js'\ns=open(p).read()\ns=s.replace(\"\"\"  *shakeTree(g, t) {\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('ShakeTree');\n    yield 0.25;\n    g.life.shakeTree(t.key, t.obj);\"\"\",\"\"\"  *shakeTree(g, t) {\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('ShakeTree');\n    yield 0.25;\n    if (g.net?.role === 'guest') { g.net.t.send({ t: 'do', a: 'shake', k: t.key }); g.sound('shakeTree'); return; }\n    g.life.shakeTree(t.key, t.obj);\"\"\")\ns=s.replace(\"\"\"  *pickObject(g, t) {\n    const w = g.world;\n    g.player.faceToward(t.x, t.z);\"\"\",\"\"\"  *pickObject(g, t) {\n    const w = g.world;\n    if (g.net?.role === 'guest') {\n      if (t.obj?.k === 'flower') { g.ui.toastMsg(\"It's not your flower. Leave it.\"); return; }\n      g.player.pose('PickUp');\n      g.net.t.send({ t: 'do', a: 'pick', k: t.key });\n      return;\n    }\n    g.player.faceToward(t.x, t.z);\"\"\")\ns=s.replace(\"\"\"  *pullWeed(g, t) {\n    const w = g.world;\"\"\",\"\"\"  *pullWeed(g, t) {\n    const w = g.world;\n    if (g.net?.role === 'guest') { g.ui.toastMsg(\"It's not your village to weed. Very kind, though.\"); return; }\"\"\")\nopen(p,'w').write(s)\np='src/systems/tools.js'\ns=open(p).read()\ns=s.replace(\"\"\"  if (tool === 'axe') return g.scripts.run(useAxe(g), { name: 'axe' });\"\"\",\"\"\"  if (g.net?.role === 'guest' && (tool === 'axe' || tool === 'shovel')) { g.ui.toastMsg(\"Not in someone else's village.\"); return undefined; }\n  if (tool === 'axe') return g.scripts.run(useAxe(g), { name: 'axe' });\"\"\")\ns=s.replace(\"\"\"  if (tool === 'shovel') return g.scripts.run(useShovel(g), { name: 'shovel' });\"\"\",\"\"\"  if (tool === 'shovel' && g.net?.role !== 'guest') return g.scripts.run(useShovel(g), { name: 'shovel' });\"\"\")\nopen(p,'w').write(s)\np='src/systems/pocketActions.js'\ns=open(p).read()\ns=s.replace(\"\"\"    removeSlot(gg, i);\n    w.town.objects[`${tx},${tz}`] = { k: 'drop', item: slot.id };\n    gg.town.dirty.add(`${tx},${tz}`);\n    gg.sound('drop');\n    closeAll(gg, m);\"\"\",\"\"\"    removeSlot(gg, i);\n    if (gg.net?.role === 'guest') gg.net.t.send({ t: 'do', a: 'gift', at: [tx, tz], item: slot.id });\n    else { w.town.objects[`${tx},${tz}`] = { k: 'drop', item: slot.id }; gg.town.dirty.add(`${tx},${tz}`); gg.net?.t.send({ t: 'ev', k: 'obj', key: `${tx},${tz}`, o: w.town.objects[`${tx},${tz}`] }); }\n    gg.sound('drop');\n    closeAll(gg, m);\"\"\")\nopen(p,'w').write(s)\np='src/ui/screens/pause.js'\ns=open(p).read()\ns=s.replace(\"\"\"    { label: 'Save & Quit to Title', action: (gg) => { saveNow(gg); markSessionClean(gg); gg.quitToTitle(); } },\"\"\",\"\"\"    { label: g.net?.role === 'guest' ? 'Catch the bus home' : 'Save & Quit to Title', action: (gg) => { saveNow(gg); markSessionClean(gg); gg.quitToTitle(); } },\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"guest\" src/systems/actions.js | head -5 | cut -c1-120; sed -i \"s/  \\*busStop(g) {\\n    const w = g.world;/&/\" src/systems/actions.js; python3 - <<'EOF'\np='/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171818__x10629c/work/HonkIfYouOwe-AnimalCrossingCityFolk-claude-opus-5-5-xhigh-20261105-171818/src/systems/actions.js'\ns=open(p).read()\ns=s.replace(\"if (g.visiting) { g.ui.toastMsg(\\\"Bus doesn't run while you have company.\\\"); return; }\\n    const c = yield* ask(g, 'hester'\",\"if (g.visiting) { g.ui.toastMsg(\\\"Bus doesn't run while you have company.\\\"); return; }\\n    const c = yield* ask(g, 'hester'\")\ns=s.replace(\"\"\"    if (w.story.day1Active) { yield* narrate(g, \"A sign on the stop says: 'Bus suspended pending your errands. Signed, a goose.'\"); return; }\n    if (g.visiting) {\"\"\",\"\"\"    if (w.story.day1Active) { yield* narrat