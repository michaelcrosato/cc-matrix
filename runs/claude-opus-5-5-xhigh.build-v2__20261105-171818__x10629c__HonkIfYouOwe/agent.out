ferAttributes, BufferGeometryEventMap>, Material<...> | Material…`\n4131-- `readonly o: { capacity?: number }`\n4132-- `add(shape: DecalShape, at: Vector3Like, normal: Vector3Like, o: DecalOptions = {}): number`: Lay a mark at `at` on a surface facing `normal`. Returns its index in that shape's pool.\n--\n5073:### interface WaterOptions\n5074-\n5075-- `size: readonly [number, number]`: Width (x) and depth (z) of the surface, m.\n5076-- `at: readonly [number, number, number]`: Centre of the surface at rest.\n5077-- `segments?: readonly [number, number]`: Grid quads along x and z (default: one per ripple cell, or 4 per metre without ripples).\n5078-- `waves?: readonly Wave[]`\n5079-- `ripples?: RippleField | null`: A ripple field covering the same rectangle (its size and centre must match).\n5080-- `deep?: number`: Colours (hex): troughs, crests, foam.\n5081-- `shallow?: number`\n5082-- `foam?: number`\n5083-- `foamAt?: number`: Height above rest (m) where foam starts. Default: 75% of the waves' combined height (the tallest crests).\n5084-- `opacity?: number`: 1: opaque; less: see-through by a 4×4 ordered dither per art pixel.\n5085-\nDebugUI.d.ts\nEngine.d.ts\nLoadingScreen.d.ts\nSettingsPanel.d.ts\nTouchControls.d.ts\nai\nanimation\nassets.d.ts\naudio\ncamera.d.ts\ncatalog.d.ts\ncharacter\ncinematic\nclock.d.ts\ndataUrl.d.ts\ndebugKeys.d.ts\nframing.d.ts\nhud\nindex.d.ts\ninput.d.ts\ninspect\nlifecycle.d.ts\nmodel\npalette.d.ts\nparticles\nphysics\npng.d.ts\nprocgen\nquality.d.ts\nrandom.d.ts\nrender\nreplay.d.ts\nsettings.d.ts\nshake.d.ts\nsnapshot.d.ts\ntexture\ntween.d.ts\nversion.d.ts\nkit/types/engine/index.d.ts:27:export { TEXTURE_FAMILIES, TEXTURE_LIBRARY, TextureCatalog, TextureError, bakeTexture, hudSprite, importSheet, meanColour, spriteSheet, textureDef, textureMap, validateTexture, type BakedTexture, type SheetImport, type SheetImportOptions, type TextureCheck, type TextureDef, type Layer as TextureLayer, } from './texture';\nkit/types/engine/animation/t