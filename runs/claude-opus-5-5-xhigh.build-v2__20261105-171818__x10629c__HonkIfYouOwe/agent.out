{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkn5Cgpm89AGGcj8GSG7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01W1u9ZNr2FSP33hfRshyvj5","name":"Bash","input":{"command":"cat > src/systems/interact.js <<'EOF'\n// Targeting and the world's verbs: what's in front of you, what pressing does, and the prompts.\nimport { THREE, toonMaterial, PALETTE } from '../engine.js';\nimport { drawText, textWidth, panel } from '../ui/draw.js';\nimport { drawPromptGlyph } from '../ui/glyphs.js';\nimport { tileChar, tileInfo, key } from '../world/tiles.js';\nimport { objectVerb, townInteractables } from './townVerbs.js';\nimport { runAction } from './actions.js';\nimport { toolInput, toolPrompt, cycleTool, setToolByDigit, drawToolRing } from './tools.js';\nimport { pauseMenu } from '../ui/screens/pause.js';\nimport { pocketsScreen } from '../ui/screens/pockets.js';\nimport { mapScreen } from '../ui/screens/map.js';\nimport { almanacScreen } from '../ui/screens/almanac.js';\nimport { emoteWheel } from '../ui/screens/emote.js';\n\nconst { Mesh, BoxGeometry, Group, Vector3 } = THREE;\nconst v = new Vector3();\nconst origin = new Vector3();\nconst dir = new Vector3();\n\nexport class Interact {\n  constructor(g) {\n    this.g = g;\n    this.target = null;\n    this.hover = null;\n    this.tile = null;\n    this.chevronT = 0;\n    this.lastList = [];\n    this.hoverPoint = null;\n    this.highlight = new Group();\n    const mat = toonMaterial(PALETTE.sand);\n    for (const [w, d, x, z] of [[1, 0.06, 0.5, 0.03], [1, 0.06, 0.5, 0.97], [0.06, 1, 0.03, 0.5], [0.06, 1, 0.97, 0.5]]) {\n      const m = new Mesh(new BoxGeometry(w, 0.03, d), mat);\n      m.position.set(x, 0.03, z);\n      this.highlight.add(m);\n    }\n    this.highlight.visible = false;\n  }\n  clear() { this.target = null; this.hover = null; this.highlight.visible = false; this.tile = null; }\n  list() {\n    const g = this.g;\n    const place = g.place;\n    const out = [];\n    if (place.interactables) out.push(...place.interactables(g));\n    if (place === g.town) {\n      out.push(...townInteractables(g));\n      const p = g.player;\n      const px = Math.floor(p.x), pz = Math.floor(p.z);\n      for (let dz = -2; dz <= 2; dz++) for (let dx = -2; dx <= 2; dx++) {\n        const k = `${px + dx},${pz + dz}`;\n        const o = g.world.town.objects[k];\n        if (!o) continue;\n        const verb = objectVerb(g, k, o, px + dx, pz + dz);\n        if (verb) out.push({ id: `obj:${k}`, x: px + dx + 0.5, z: pz + dz + 0.5, r: 1.25, key: k, obj: o, ...verb });\n      }\n    }\n    for (const n of g.npcs.all()) {\n      const a = n.actor;\n      if (!a.visible) continue;\n      if (a.root.parent !== place.group) continue;\n      out.push({ id: `npc:${n.id}`, x: a.x, z: a.z, r: 1.6, label: `Talk to ${n.data.short ?? n.data.name}`, act: 'npcTalk', npc: n.id, moving: true });\n    }\n    out.push(...g.life.interactables());\n    out.push(...g.festivals.interactables());\n    return out;\n  }\n  update() {\n    const g = this.g;\n    const p = g.player;\n    const list = this.list();\n    this.lastList = list;\n    const fx = Math.sin(p.facing), fz = Math.cos(p.facing);\n    let best = null, bestScore = 1e9;\n    for (const t of list) {\n      const dx = t.x - p.x, dz = t.z - p.z;\n      const d = Math.hypot(dx, dz);\n      if (d > t.r) continue;\n      const dot = d > 0.01 ? (dx * fx + dz * fz) / d : 1;\n      if (dot < 0.5 && d > 0.75) continue;\n      const score = d - dot * 0.6;\n      if (score < bestScore) { bestScore = score; best = t; }\n    }\n    // The mouse's hover drives targeting instead\n    const m = g.inp.mouse;\n    this.hover = null;\n    if (g.inp.device === 'kbm' && m.used && m.over) {\n      const hit = this.groundPoint();\n      if (hit) {\n        this.hoverPoint = hit;\n        let h = null, hd = 1.0;\n        for (const t of list) { const d = Math.hypot(t.x - hit.x, t.z - hit.z); if (d < hd) { hd = d; h = t; } }\n        this.hover = h;\n        if (h) best = Math.hypot(h.x - p.x, h.z - p.z) <= h.r ? h : best;\n      }\n    } else this.hoverPoint = null;\n    this.target = best;\n    // The tile in front (or under the cursor)\n    let tx = Math.floor(p.x + fx * 0.9), tz = Math.floor(p.z + fz * 0.9);\n    if (this.hoverPoint && g.place === g.town) { tx = Math.floor(this.hoverPoint.x); tz = Math.floor(this.hoverPoint.z); }\n    this.tile = [tx, tz];\n    const show = g.place === g.town && !!g.world.player.tool && g.world.player.tool !== 'net' && g.world.player.tool !== 'slingshot';\n    if (show && !this.highlight.parent) g.town.group.add(this.highlight);\n    this.highlight.visible = show;\n    if (show) this.highlight.position.set(tx, g.town.height(tx + 0.5, tz + 0.5) + 0.02, tz);\n  }\n  /** World point under the mouse, on the ground. */\n  groundPoint() {\n    const g = this.g;\n    const cam = g.ctx.camera;\n    const p = g.ctx.input.pointer;\n    cam.rayAt(p.x, p.y, origin, dir);\n    const place = g.place;\n    let y = g.player.y;\n    let hx = 0, hz = 0;\n    for (let i = 0; i < 3; i++) {\n      const t = (y - origin.y) / dir.y;\n      hx = origin.x + dir.x * t - place.ox;\n      hz = origin.z + dir.z * t - place.oz;\n      y = place.height(hx, hz);\n    }\n    return { x: hx, z: hz };\n  }\n  activate(t) {\n    const g = this.g;\n    g.scripts.run(runAction(g, t), { name: t.act ?? 'verb' });\n  }\n  drawPrompts(hud) {\n    const g = this.g;\n    if (!this.g.canAct()) return;\n    const t = this.target;\n    const prompts = [];\n    if (t) prompts.push(['confirm', t.label]);\n    const tp = toolPrompt(g);\n    if (tp) prompts.push(['use', tp]);\n    if (prompts.length < 3 && !t && !tp) prompts.push(['pockets', 'Pockets']);\n    g.ui.prompts = prompts;\n    if (g.ui.hudAlpha > 0.5 || prompts.length) g.ui.drawPrompts(hud, prompts.slice(0, 3), 'corner');\n    // Chevron over the target, name tooltip for the mouse\n    const c = this.hover ?? t;\n    if (c) {\n      const s = g.project(c.x, g.place.height(c.x, c.z) + (c.npc ? 2 : 1.3), c.z);\n      this.chevronT += 0.016;\n      const bob = Math.round(Math.sin(this.chevronT * 7) * 2);\n      if (s) hud.sprite(s.x - 3, s.y - 8 + bob, CHEVRON, CHEV_COL, { shadow: false });\n      if (this.hover && s) {\n        const w = textWidth(this.hover.label) + 10;\n        panel(hud, s.x - w / 2, s.y - 26, w, 15, { fill: 'white', trim: 'sand' });\n        drawText(hud, s.x, s.y - 22, this.hover.label, { align: 'center', color: 'ink' });\n      }\n    }\n    drawToolRing(g, hud);\n  }\n}\nconst CHEVRON = ['#######', '#ooooo#', '.#ooo#.', '..#o#..', '...#...'];\nconst CHEV_COL = { '#': 'ink', o: 'sand' };\n\n/** The per-frame world input: menus, tools, camera, verbs, mouse. */\nexport function worldInput(g, dt) {\n  const inp = g.inp;\n  const m = inp.mouse;\n  g.interact.update();\n  if (inp.pause) { g.sound('uiConfirm'); g.ui.push(pauseMenu(g)); return; }\n  if (inp.pockets) { g.sound('uiConfirm'); g.ui.push(pocketsScreen(g)); return; }\n  if (inp.map) { g.sound('uiConfirm'); g.ui.push(mapScreen(g)); return; }\n  if (inp.almanac) { g.sound('uiConfirm'); g.ui.push(almanacScreen(g)); return; }\n  if (inp.emote) { g.sound('uiConfirm'); g.ui.push(emoteWheel(g)); return; }\n  if (inp.camL) g.turnCamera(-1);\n  if (inp.camR) g.turnCamera(1);\n  if (inp.zoomIn) g.zoomStep(1);\n  if (inp.zoomOut) g.zoomStep(-1);\n  if (inp.prevTool) cycleTool(g, -1);\n  if (inp.nextTool) cycleTool(g, 1);\n  if (inp.digit) setToolByDigit(g, inp.digit);\n  if (g.player.poseTimer > 0) return;\n  toolInput(g, dt);\n  if (inp.confirm) {\n    const t = g.interact.target;\n    if (t) { g.interact.activate(t); return; }\n  }\n  // Mouse: click a thing to walk into reach and use it; click the ground to walk; hold to follow.\n  if (m.click && m.over) {\n    const hit = g.interact.groundPoint();\n    const h = g.interact.hover;\n    if (h) {\n      const d = Math.hypot(h.x - g.player.x, h.z - g.player.z);\n      if (d <= h.r) { g.interact.activate(h); return; }\n      g.player.walkTo(h.x, h.z, { stop: Math.max(0.8, h.r - 0.3), then: () => { g.player.faceToward(h.x, h.z); g.interact.activate(h); } });\n    } else if (hit) {\n      g.player.walkTo(hit.x, hit.z, { path: !g.place.blocked(hit.x, hit.z) });\n    }\n  } else if (m.down && m.over && !g.interact.hover && g.idleMouseHold !== false) {\n    const hit = g.interact.groundPoint();\n    if (hit && !g.place.blocked(hit.x, hit.z)) { const pl = g.player; if (Math.hypot(hit.x - pl.x, hit.z - pl.z) > 0.8) { pl.walkTarget = { x: hit.x, z: hit.z, stop: 0.2 }; pl.walkPath = null; pl.walkThen = null; } }\n  }\n  // Wandering off the mat leaves the room\n  const place = g.place;\n  if (place.kind === 'room') {\n    const e = place.def.exit;\n    if (e && g.player.z > place.d - 0.3) g.scripts.run(runAction(g, { act: 'leaveRoom', exit: e }), { name: 'leaveRoom' });\n  }\n  if (place === g.city || place === g.town) g.interact.tileUnderfoot = tileChar(Math.floor(g.player.x), Math.floor(g.player.z));\n}\nexport { tileInfo, key, v, panel, drawPromptGlyph };\nEOF\npython3 - <<'EOF'\np='src/game.js'\ns=open(p).read()\ns=s.replace(\"  patternTexture(slot) {\",\"\"\"  baseLook() { return LOOK_PRESETS.none; }\n  /** World point → art pixels, for bubbles and chevrons. */\n  project(x, y, z) {\n    const cam = this.ctx.camera.camera;\n    this.tmpV ??= new Vector3();\n    this.tmpV.set(x + this.place.ox, y, z + this.place.oz).project(cam);\n    if (this.tmpV.z > 1) return null;\n    return { x: Math.round((this.tmpV.x + 1) * 240), y: Math.round((1 - this.tmpV.y) * 135) };\n  }\n  patternTexture(slot) {\"\"\")\ns=s.replace(\"import { THREE, PALETTE, applySky, skyAt, loadPack, Engine, withUrlOptions } from './engine.js';\",\"import { THREE, PALETTE, applySky, skyAt, loadPack, Engine, withUrlOptions, LOOK_PRESETS } from './engine.js';\")\nopen(p,'w').write(s)\nEOF\ncat > src/systems/tools.js <<'EOF'\n// The six tools. Each verb has anticipation, an impact, a sound, a sparkle and usually a joke.\nimport { ITEMS } from '../data/items.js';\nimport { drawIcon } from '../art/icons.js';\nimport { panel, drawText } from '../ui/draw.js';\nimport { tileChar, tileInfo, waterKind, isWaterTile } from '../world/tiles.js';\nimport { addItem, hasRoom, findItem, removeSlot } from './economy.js';\nimport { revealCatch } from './reveal.js';\nimport { SOLID_KINDS } from '../world/town.js';\nimport { BUGS } from '../data/bugs.js';\nimport { remember } from './memory.js';\nimport { tuning } from '../dev/tuning.js';\n\nexport const TOOL_ORDER = ['net', 'rod', 'shovel', 'axe', 'can', 'slingshot'];\nconst TOOL_MODEL = { net: 'tool-net', rod: 'tool-rod', shovel: 'tool-shovel', axe: 'tool-axe', can: 'tool-can', slingshot: 'tool-slingshot' };\nexport function equip(g, tool) {\n  const w = g.world;\n  w.player.tool = tool;\n  g.player.hold(tool ? TOOL_MODEL[tool] : null);\n  g.heldNet = false;\n  g.life.endFishing?.();\n  g.toolRingT = 1.2;\n}\nexport function cycleTool(g, d) {\n  const w = g.world;\n  const owned = TOOL_ORDER.filter((t) => w.player.tools.includes(t));\n  if (!owned.length) return;\n  const list = [null, ...owned];\n  const i = list.indexOf(w.player.tool);\n  const next = list[(i + d + list.length) % list.length];\n  equip(g, next);\n  g.sound('uiTab');\n}\nexport function setToolByDigit(g, d) {\n  const t = TOOL_ORDER[d - 1];\n  const w = g.world;\n  if (!w.player.tools.includes(t)) { g.sound('uiError'); return; }\n  equip(g, w.player.tool === t ? null : t);\n  g.sound('uiTab');\n}\nexport function grantTool(g, tool) {\n  const w = g.world;\n  if (!w.player.tools.includes(tool)) w.player.tools.push(tool);\n  equip(g, tool);\n  g.events.emit('toolGained', { tool });\n}\n/** Ring of tools around you while cycling. */\nexport function drawToolRing(g, hud) {\n  if (!(g.toolRingT > 0)) return;\n  g.toolRingT -= 0.016;\n  const w = g.world;\n  const c = g.project(g.player.x, g.player.y + 1, g.player.z);\n  if (!c) return;\n  const owned = TOOL_ORDER.filter((t) => w.player.tools.includes(t));\n  const n = owned.length;\n  owned.forEach((t, i) => {\n    const a = -Math.PI / 2 + (i / Math.max(1, n)) * Math.PI * 2;\n    const x = Math.round(c.x + Math.cos(a) * 42) - 11;\n    const y = Math.round(c.y + Math.sin(a) * 36) - 11;\n    const eq = w.player.tool === t;\n    panel(hud, x, y, 22, 22, { fill: eq ? 'sand' : 'white', trim: eq ? 'orange' : 'mist' });\n    drawIcon(hud, x + 3, y + 3, ITEMS[t].icon, ITEMS[t].iconColors);\n  });\n}\nexport function toolPrompt(g) {\n  const w = g.world;\n  const t = w.player.tool;\n  if (!t || g.place !== g.town) return null;\n  const f = g.life.fishing;\n  if (t === 'rod' && f) return f.state === 'bite' ? 'REEL!' : 'Reel in';\n  if (t === 'rod') return 'Cast';\n  if (t === 'net') return g.heldNet ? 'Release to swing' : 'Ready the net';\n  if (t === 'can') return 'Water';\n  if (t === 'axe') return 'Chop';\n  if (t === 'shovel') { const o = g.interact.tile ? w.town.objects[`${g.interact.tile[0]},${g.interact.tile[1]}`] : null; return o?.k === 'hole' ? 'Fill' : 'Dig'; }\n  if (t === 'slingshot') return 'Fire';\n  return null;\n}\n/** Tool button with the mouse aims at the cursor. */\nexport function toolInput(g, dt) {\n  const inp = g.inp;\n  const w = g.world;\n  const tool = w.player.tool;\n  const m = inp.mouse;\n  const pressed = inp.useTool || (m.rclick && m.over);\n  if (!tool) {\n    if (pressed && !w.player.gagJump) { w.player.gagJump = true; g.ui.toastMsg(\"You can't jump. You're in escrow.\"); g.events.emit('gag', {}); }\n    return;\n  }\n  if (g.place !== g.town) {\n    if (pressed) g.sound('uiError');\n    return;\n  }\n  if (pressed && m.rclick && g.interact.hoverPoint) { const h = g.interact.hoverPoint; g.player.faceToward(h.x, h.z); g.player.facing = Math.atan2(h.x - g.player.x, h.z - g.player.z); }\n  if (tool === 'net') {\n    if (pressed) { g.heldNet = true; g.player.play('NetReady', 0.06); }\n    else if (g.heldNet && !inp.toolHeld) { g.heldNet = false; netSweep(g); }\n    return;\n  }\n  if (!pressed) return;\n  if (tool === 'rod') {\n    if (g.life.fishing) g.life.reel();\n    else g.life.cast();\n    return;\n  }\n  if (tool === 'shovel') return g.scripts.run(useShovel(g), { name: 'shovel' });\n  if (tool === 'axe') return g.scripts.run(useAxe(g), { name: 'axe' });\n  if (tool === 'can') return g.scripts.run(useCan(g), { name: 'can' });\n  if (tool === 'slingshot') return g.scripts.run(useSling(g), { name: 'sling' });\n  return undefined;\n}\nfunction netSweep(g) {\n  const p = g.player;\n  p.pose('NetSweep');\n  g.sound('netSwing');\n  const reachSq = 1.8 * 1.8;\n  const fx = Math.sin(p.facing), fz = Math.cos(p.facing);\n  // Bugs in a 90° cone\n  const caught = g.life.bugs.find((b) => {\n    const dx = b.x - p.x, dz = b.z - p.z;\n    const d2 = dx * dx + dz * dz;\n    if (d2 > reachSq) return false;\n    const d = Math.sqrt(d2) || 1;\n    return (dx * fx + dz * fz) / d > 0.7 && !b.gone;\n  });\n  // Neighbours are also in the way, sometimes\n  const bonked = !caught ? g.npcs.all().find((n) => n.actor.visible && Math.hypot(n.actor.x - p.x - fx * 1.0, n.actor.z - p.z - fz * 1.0) < 0.9 && n.actor.root.parent === g.place.group) : null;\n  const wasps = g.life.waspsNear?.(p.x + fx, p.z + fz);\n  g.scripts.run((function* () {\n    yield 0.15;\n    if (caught) {\n      g.sound('netCatch');\n      g.rumble(0.3, 80);\n      g.life.catchBug(caught);\n      yield* revealCatch(g, caught.def.id, caught.def.line, 'bug');\n    } else if (bonked) {\n      g.sound('bonk');\n      const npc = bonked;\n      g.world.npcs[npc.id].friend = Math.max(0, g.world.npcs[npc.id].friend - 2);\n      g.world.stats.netBonks += 1;\n      remember(g, 'bonk', { about: npc.id });\n      npc.actor.play(npc.id === 'ozzie' ? 'PlayDead' : 'Shock', 0.05, { once: true });\n      npc.emoting = true;\n      g.events.emit('bonk', { id: npc.id });\n    } else if (wasps) {\n      g.life.netWasps();\n      g.sound('netCatch');\n    } else g.sound('netMiss');\n  })(), { name: 'netResult', hold: !!caught });\n}\nfunction* useShovel(g) {\n  const w = g.world;\n  const [tx, tz] = g.interact.tile;\n  const k = `${tx},${tz}`;\n  const o = w.town.objects[k];\n  const p = g.player;\n  const info = tileInfo(tileChar(tx, tz));\n  p.pose('Dig');\n  yield 0.34;\n  if (o?.k === 'stump') { g.sound('hitRock'); delete w.town.objects[k]; g.town.dirty.add(k); g.ui.toastMsg('You dug up the stump. It had nothing to say.'); g.sound('dirtFall'); g.events.emit('stumpOut', { k }); return; }\n  if (o?.k === 'rock') { g.sound('hitRock'); g.rumble(0.3, 80); g.engine.hitstop(0.05); g.life.hitRock(tx, tz, o); return; }\n  if (o?.k === 'hole') {\n    g.sound('dirtFall');\n    const fillItem = g.pendingBury;\n    delete w.town.objects[k];\n    g.town.dirty.add(k);\n    g.ctx.particles.burst('dirt', [tx + 0.5, 0.2, tz + 0.5], { count: 6 });\n    return;\n  }\n  if (!info.walk || info.surface === 'dock' || info.surface === 'plaza' && !o?.k || tileChar(tx, tz) === '^') {\n    if (info.surface !== 'plaza' || o?.k !== 'crack') { g.sound('hitRock'); g.ui.toastMsg(\"That's not the sort of ground you can dig.\"); return; }\n  }\n  if (o && o.k !== 'crack' && o.k !== 'sparkle' && o.k !== 'weed') { g.sound('uiError'); return; }\n  g.sound('dig');\n  g.rumble(0.4, 100);\n  g.ctx.particles.burst('dirt', [tx + 0.5, 0.25, tz + 0.5], { count: 10 });\n  yield 0.1;\n  const was = o;\n  w.town.objects[k] = { k: 'hole', item: was?.item ?? null };\n  g.town.dirty.add(k);\n  g.events.emit('dug', { k, was: was?.k ?? null });\n  if (was?.k === 'crack' || was?.k === 'sparkle') {\n    w.town.objects[k].item = null;\n    const item = was.item;\n    if (!hasRoom(w)) { w.town.objects[k] = { k: 'drop', item }; g.town.dirty.add(k); g.ui.toastMsg('Your pockets are full. It stays on the ground.'); return; }\n    addItem(g, item);\n    g.events.emit('dugUp', { item });\n    yield* revealCatch(g, item, ITEMS[item].line, 'find');\n  }\n}\nfunction* useAxe(g) {\n  const w = g.world;\n  const [tx, tz] = g.interact.tile;\n  const k = `${tx},${tz}`;\n  const o = w.town.objects[k];\n  const p = g.player;\n  p.pose('Chop');\n  yield 0.34;\n  if (o?.k === 'tree' || o?.k === 'sapling') {\n    g.sound('chop');\n    g.rumble(0.4, 90);\n    o.hits = (o.hits ?? 0) + 1;\n    const v = g.town.objectViews.get(k);\n    if (v) { g.ctx.tweens.value(0, 1, { duration: 0.3 }, (t) => { v.rotation.z = Math.sin(t * 20) * 0.04 * (1 - t); }); }\n    g.ctx.particles.burst('sparkle', [tx + 0.5, 1, tz + 0.5], { count: 4, colors: ['sand', 'orange'] });\n    if (o.hits >= 3 || o.k === 'sapling') {\n      g.sound('treeFall');\n      g.engine.shake.add(g.settings.shake ? 0.25 : 0);\n      w.town.objects[k] = { k: 'stump' };\n      g.town.dirty.add(k);\n      g.ctx.particles.burst('leaf', [tx + 0.5, 2, tz + 0.5], { count: 20 });\n      g.events.emit('treeFelled', { k });\n      w.stats.trees = (w.stats.trees ?? 0) + 1;\n    }\n  } else if (o?.k === 'rock') { g.sound('hitRock'); g.life.hitRock(tx, tz, o); }\n  else if (o?.k === 'stump') { g.sound('chop'); g.ui.toastMsg('The stump is unmoved. Try a shovel.'); }\n  else g.sound('netMiss');\n}\nfunction* useCan(g) {\n  const w = g.world;\n  const [tx, tz] = g.interact.tile;\n  const p = g.player;\n  p.pose('Water');\n  g.sound('waterPour');\n  g.ctx.particles.burst('splash', [tx + 0.5, 0.5, tz + 0.5], { count: 10 });\n  yield 0.5;\n  let watered = 0;\n  for (let dz = -1; dz <= 1; dz++) for (let dx = -1; dx <= 1; dx++) {\n    const k = `${tx + dx},${tz + dz}`;\n    const o = w.town.objects[k];\n    if (!o) continue;\n    if (o.k === 'flower') { o.wet = w.clock.day; if (o.wilt) { o.wilt = 0; g.town.dirty.add(k); } watered++; }\n    if (o.k === 'sapling') { o.wet = w.clock.day; watered++; if (o.mayor) g.events.emit('wateredMayorSapling', {}); }\n  }\n  if (watered) g.events.emit('watered', { n: watered });\n}\nfunction* useSling(g) {\n  const p = g.player;\n  // Aim at the nearest balloon ahead; with a mouse, the one under the cursor.\n  const b = g.life.balloonAhead();\n  p.pose('Slingshot');\n  yield 0.4;\n  g.sound('slingFire');\n  g.life.fireShot(b);\n}\nexport { waterKind, isWaterTile, SOLID_KINDS, BUGS, findItem, removeSlot, tuning };\nEOF\ncat > src/systems/reveal.js <<'EOF'\n// A first catch or find plays the hold-up pose, a jingle and its line. Repeats are quick.\nimport { ITEMS } from '../data/items.js';\nimport { say, narrate } from './say.js';\nimport { drawIcon } from '../art/icons.js';\nimport { addItem, hasRoom } from './economy.js';\n\n/** Add to the almanac and play the moment. kind: fish | bug | find. */\nexport function* revealCatch(g, id, line, kind) {\n  const w = g.world;\n  const it = ITEMS[id];\n  const cat = it?.cat;\n  const book = cat === 'fish' ? w.almanac.fish : cat === 'bug' ? w.almanac.bug : cat === 'fossil' || cat === 'rawFossil' ? w.almanac.fossil : null;\n  const first = book ? !book[id] : !w.flags[`seen:${id}`];\n  if (book) book[id] = (book[id] ?? 0) + 1;\n  else w.flags[`seen:${id}`] = true;\n  if (cat === 'fish') { w.stats.fish += 1; w.stats.caught += 1; if ((it.beans ?? 0) > w.stats.biggestBeans) { w.stats.biggestBeans = it.beans; w.stats.biggest = it.name; } }\n  if (cat === 'bug') { w.stats.bugs += 1; w.stats.caught += 1; }\n  g.events.emit('caught', { id, kind, first });\n  if (!first) {\n    g.sound('revealQuick');\n    g.ui.toastMsg(`Another ${it.name}.`);\n    return;\n  }\n  const p = g.player;\n  p.pose('HoldUp', 1.2);\n  g.sound('reveal');\n  g.revealIcon = { id, t: 0 };\n  g.rumble(0.3, 120);\n  yield 0.5;\n  yield* narrate(g, `You caught a ${it.name}! ${line ?? it.line ?? ''}`.replace('You caught a', kind === 'find' ? 'You found a' : 'You caught a'));\n  g.revealIcon = null;\n  p.poseTimer = 0; p.poseClip = null;\n}\nexport function drawReveal(g, hud) {\n  const r = g.revealIcon;\n  if (!r) return;\n  const it = ITEMS[r.id];\n  const s = g.project(g.player.x, g.player.y + 1.8, g.player.z);\n  if (s) drawIcon(hud, s.x - 16, s.y - 34, it.icon, it.iconColors, 2);\n}\nexport { say, addItem, hasRoom };\nEOF\necho ok","description":"Write interaction system, tools and reveal moments"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11563,"cache_read_input_tokens":498991,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11563},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"2d398c86-a8a5-4ef5-b58c-1298c2579998","timestamp":"2026-11-06T01:08:10.829Z","request_id":"req_011Cgkn5CNUfSyAEubtn8D9E","wire_tool_inputs":{"toolu_01W1u9ZNr2FSP33hfRshyvj5":{"command":"cat > src/systems/interact.js <<'EOF'\n// Targeting and the world's verbs: what's in front of you, what pressing does, and the prompts.\nimport { THREE, toonMaterial, PALETTE } from '../engine.js';\nimport { drawText, textWidth, panel } from '../ui/draw.js';\nimport { drawPromptGlyph } from '../ui/glyphs.js';\nimport { tileChar, tileInfo, key } from '../world/tiles.js';\nimport { objectVerb, townInteractables } from './townVerbs.js';\nimport { runAction } from './actions.js';\nimport { toolInput, toolPrompt, cycleTool, setToolByDigit, drawToolRing } from './tools.js';\nimport { pauseMenu } from '../ui/screens/pause.js';\nimport { pocketsScreen } from '../ui/screens/pockets.js';\nimport { mapScreen } from '../ui/screens/map.js';\nimport { almanacScreen } from '../ui/screens/almanac.js';\nimport { emoteWheel } from '../ui/screens/emote.js';\n\nconst { Mesh, BoxGeometry, Group, Vector3 } = THREE;\nconst v = new Vector3();\nconst origin = new Vector3();\nconst dir = new Vector3();\n\nexport class Interact {\n  constructor(g) {\n    this.g = g;\n    this.target = null;\n    this.hover = null;\n    this.tile = null;\n    this.chevronT = 0;\n    this.lastList = [];\n    this.hoverPoint = null;\n    this.highlight = new Group();\n    const mat = toonMaterial(PALETTE.sand);\n    for (const [w, d, x, z] of [[1, 0.06, 0.5, 0.03], [1, 0.06, 0.5, 0.97], [0.06, 1, 0.03, 0.5], [0.06, 1, 0.97, 0.5]]) {\n      const m = new Mesh(new BoxGeometry(w, 0.03, d), mat);\n      m.position.set(x, 0.03, z);\n      this.highlight.add(m);\n    }\n    this.highlight.visible = false;\n  }\n  clear() { this.target = null; this.hover = null; this.highlight.visible = false; this.tile = null; }\n  list() {\n    const g = this.g;\n    const place = g.place;\n    const out = [];\n    if (place.interactables) out.push(...place.interactables(g));\n    if (place === g.town) {\n      out.push(...townInteractables(g));\n      const p = g.player;\n      const px = Math.floor(p.x), pz = Math.floor(p.z);\n      for (let dz = -2; dz <= 2; dz++) for (let dx = -2; dx <= 2; dx++) {\n        const k = `${px + dx},${pz + dz}`;\n        const o = g.world.town.objects[k];\n        if (!o) continue;\n        const verb = objectVerb(g, k, o, px + dx, pz + dz);\n        if (verb) out.push({ id: `obj:${k}`, x: px + dx + 0.5, z: pz + dz + 0.5, r: 1.25, key: k, obj: o, ...verb });\n      }\n    }\n    for (const n of g.npcs.all()) {\n      const a = n.actor;\n      if (!a.visible) continue;\n      if (a.root.parent !== place.group) continue;\n      out.push({ id: `npc:${n.id}`, x: a.x, z: a.z, r: 1.6, label: `Talk to ${n.data.short ?? n.data.name}`, act: 'npcTalk', npc: n.id, moving: true });\n    }\n    out.push(...g.life.interactables());\n    out.push(...g.festivals.interactables());\n    return out;\n  }\n  update() {\n    const g = this.g;\n    const p = g.player;\n    const list = this.list();\n    this.lastList = list;\n    const fx = Math.sin(p.facing), fz = Math.cos(p.facing);\n    let best = null, bestScore = 1e9;\n    for (const t of list) {\n      const dx = t.x - p.x, dz = t.z - p.z;\n      const d = Math.hypot(dx, dz);\n      if (d > t.r) continue;\n      const dot = d > 0.01 ? (dx * fx + dz * fz) / d : 1;\n      if (dot < 0.5 && d > 0.75) continue;\n      const score = d - dot * 0.6;\n      if (score < bestScore) { bestScore = score; best = t; }\n    }\n    // The mouse's hover drives targeting instead\n    const m = g.inp.mouse;\n    this.hover = null;\n    if (g.inp.device === 'kbm' && m.used && m.over) {\n      const hit = this.groundPoint();\n      if (hit) {\n        this.hoverPoint = hit;\n        let h = null, hd = 1.0;\n        for (const t of list) { const d = Math.hypot(t.x - hit.x, t.z - hit.z); if (d < hd) { hd = d; h = t; } }\n        this.hover = h;\n        if (h) best = Math.hypot(h.x - p.x, h.z - p.z) <= h.r ? h : best;\n      }\n    } else this.hoverPoint = null;\n    this.target = best;\n    // The tile in front (or under the cursor)\n    let tx = Math.floor(p.x + fx * 0.9), tz = Math.floor(p.z + fz * 0.9);\n    if (this.hoverPoint && g.place === g.town) { tx = Math.floor(this.hoverPoint.x); tz = Math.floor(this.hoverPoint.z); }\n    this.tile = [tx, tz];\n    const show = g.place === g.town && !!g.world.player.tool && g.world.player.tool !== 'net' && g.world.player.tool !== 'slingshot';\n    if (show && !this.highlight.parent) g.town.group.add(this.highlight);\n    this.highlight.visible = show;\n    if (show) this.highlight.position.set(tx, g.town.height(tx + 0.5, tz + 0.5) + 0.02, tz);\n  }\n  /** World point under the mouse, on the ground. */\n  groundPoint() {\n    const g = this.g;\n    const cam = g.ctx.camera;\n    const p = g.ctx.input.pointer;\n    cam.rayAt(p.x, p.y, origin, dir);\n    const place = g.place;\n    let y = g.player.y;\n    let hx = 0, hz = 0;\n    for (let i = 0; i < 3; i++) {\n      const t = (y - origin.y) / dir.y;\n      hx = origin.x + dir.x * t - place.ox;\n      hz = origin.z + dir.z * t - place.oz;\n      y = place.height(hx, hz);\n    }\n    return { x: hx, z: hz };\n  }\n  activate(t) {\n    const g = this.g;\n    g.scripts.run(runAction(g, t), { name: t.act ?? 'verb' });\n  }\n  drawPrompts(hud) {\n    const g = this.g;\n    if (!this.g.canAct()) return;\n    const t = this.target;\n    const prompts = [];\n    if (t) prompts.push(['confirm', t.label]);\n    const tp = toolPrompt(g);\n    if (tp) prompts.push(['use', tp]);\n    if (prompts.length < 3 && !t && !tp) prompts.push(['pockets', 'Pockets']);\n    g.ui.prompts = prompts;\n    if (g.ui.hudAlpha > 0.5 || prompts.length) g.ui.drawPrompts(hud, prompts.slice(0, 3), 'corner');\n    // Chevron over the target, name tooltip for the mouse\n    const c = this.hover ?? t;\n    if (c) {\n      const s = g.project(c.x, g.place.height(c.x, c.z) + (c.npc ? 2 : 1.3), c.z);\n      this.chevronT += 0.016;\n      const bob = Math.round(Math.sin(this.chevronT * 7) * 2);\n      if (s) hud.sprite(s.x - 3, s.y - 8 + bob, CHEVRON, CHEV_COL, { shadow: false });\n      if (this.hover && s) {\n        const w = textWidth(this.hover.label) + 10;\n        panel(hud, s.x - w / 2, s.y - 26, w, 15, { fill: 'white', trim: 'sand' });\n        drawText(hud, s.x, s.y - 22, this.hover.label, { align: 'center', color: 'ink' });\n      }\n    }\n    drawToolRing(g, hud);\n  }\n}\nconst CHEVRON = ['#######', '#ooooo#', '.#ooo#.', '..#o#..', '...#...'];\nconst CHEV_COL = { '#': 'ink', o: 'sand' };\n\n/** The per-frame world input: menus, tools, camera, verbs, mouse. */\nexport function worldInput(g, dt) {\n  const inp = g.inp;\n  const m = inp.mouse;\n  g.interact.update();\n  if (inp.pause) { g.sound('uiConfirm'); g.ui.push(pauseMenu(g)); return; }\n  if (inp.pockets) { g.sound('uiConfirm'); g.ui.push(pocketsScreen(g)); return; }\n  if (inp.map) { g.sound('uiConfirm'); g.ui.push(mapScreen(g)); return; }\n  if (inp.almanac) { g.sound('uiConfirm'); g.ui.push(almanacScreen(g)); return; }\n  if (inp.emote) { g.sound('uiConfirm'); g.ui.push(emoteWheel(g)); return; }\n  if (inp.camL) g.turnCamera(-1);\n  if (inp.camR) g.turnCamera(1);\n  if (inp.zoomIn) g.zoomStep(1);\n  if (inp.zoomOut) g.zoomStep(-1);\n  if (inp.prevTool) cycleTool(g, -1);\n  if (inp.nextTool) cycleTool(g, 1);\n  if (inp.digit) setToolByDigit(g, inp.digit);\n  if (g.player.poseTimer > 0) return;\n  toolInput(g, dt);\n  if (inp.confirm) {\n    const t = g.interact.target;\n    if (t) { g.interact.activate(t); return; }\n  }\n  // Mouse: click a thing to walk into reach and use it; click the ground to walk; hold to follow.\n  if (m.click && m.over) {\n    const hit = g.interact.groundPoint();\n    const h = g.interact.hover;\n    if (h) {\n      const d = Math.hypot(h.x - g.player.x, h.z - g.player.z);\n      if (d <= h.r) { g.interact.activate(h); return; }\n      g.player.walkTo(h.x, h.z, { stop: Math.max(0.8, h.r - 0.3), then: () => { g.player.faceToward(h.x, h.z); g.interact.activate(h); } });\n    } else if (hit) {\n      g.player.walkTo(hit.x, hit.z, { path: !g.place.blocked(hit.x, hit.z) });\n    }\n  } else if (m.down && m.over && !g.interact.hover && g.idleMouseHold !== false) {\n    const hit = g.interact.groundPoint();\n    if (hit && !g.place.blocked(hit.x, hit.z)) { const pl = g.player; if (Math.hypot(hit.x - pl.x, hit.z - pl.z) > 0.8) { pl.walkTarget = { x: hit.x, z: hit.z, stop: 0.2 }; pl.walkPath = null; pl.walkThen = null; } }\n  }\n  // Wandering off the mat leaves the room\n  const place = g.place;\n  if (place.kind === 'room') {\n    const e = place.def.exit;\n    if (e && g.player.z > place.d - 0.3) g.scripts.run(runAction(g, { act: 'leaveRoom', exit: e }), { name: 'leaveRoom' });\n  }\n  if (place === g.city || place === g.town) g.interact.tileUnderfoot = tileChar(Math.floor(g.player.x), Math.floor(g.player.z));\n}\nexport { tileInfo, key, v, panel, drawPromptGlyph };\nEOF\npython3 - <<'EOF'\np='src/game.js'\ns=open(p).read()\ns=s.replace(\"  patternTexture(slot) {\",\"\"\"  baseLook() { return LOOK_PRESETS.none; }\n  /** World point → art pixels, for bubbles and chevrons. */\n  project(x, y, z) {\n    const cam = this.ctx.camera.camera;\n    this.tmpV ??= new Vector3();\n    this.tmpV.set(x + this.place.ox, y, z + this.place.oz).project(cam);\n    if (this.tmpV.z > 1) return null;\n    return { x: Math.round((this.tmpV.x + 1) * 240), y: Math.round((1 - this.tmpV.y) * 135) };\n  }\n  patternTexture(slot) {\"\"\")\ns=s.replace(\"import { THREE, PALETTE, applySky, skyAt, loadPack, Engine, withUrlOptions } from './engine.js';\",\"import { THREE, PALETTE, applySky, skyAt, loadPack, Engine, withUrlOptions, LOOK_PRESETS } from './engine.js';\")\nopen(p,'w').write(s)\nEOF\ncat > src/systems/tools.js <<'EOF'\n// The six tools. Each verb has anticipation, an impact, a sound, a sparkle and usually a joke.\nimport { ITEMS } from '../data/items.js';\nimport { drawIcon } from '../art/icons.js';\nimport { panel, drawText } from '../ui/draw.js';\nimport { tileChar, tileInfo, waterKind, isWaterTile } from '../world/tiles.js';\nimport { addItem, hasRoom, findItem, removeSlot } from './economy.js';\nimport { revealCatch } from './reveal.js';\nimport { SOLID_KINDS } from '../world/town.js';\nimport { BUGS } from '../data/bugs.js';\nimport { remember } from './memory.js';\nimport { tuning } from '../dev/tuning.js';\n\nexport const TOOL_ORDER = ['net', 'rod', 'shovel', 'axe', 'can', 'slingshot'];\nconst TOOL_MODEL = { net: 'tool-net', rod: 'tool-rod', shovel: 'tool-shovel', axe: 'tool-axe', can: 'tool-can', slingshot: 'tool-slingshot' };\nexport function equip(g, tool) {\n  const w = g.world;\n  w.player.tool = tool;\n  g.player.hold(tool ? TOOL_MODEL[tool] : null);\n  g.heldNet = false;\n  g.life.endFishing?.();\n  g.toolRingT = 1.2;\n}\nexport function cycleTool(g, d) {\n  const w = g.world;\n  const owned = TOOL_ORDER.filter((t) => w.player.tools.includes(t));\n  if (!owned.length) return;\n  const list = [null, ...owned];\n  const i = list.indexOf(w.player.tool);\n  const next = list[(i + d + list.length) % list.length];\n  equip(g, next);\n  g.sound('uiTab');\n}\nexport function setToolByDigit(g, d) {\n  const t = TOOL_ORDER[d - 1];\n  const w = g.world;\n  if (!w.player.tools.includes(t)) { g.sound('uiError'); return; }\n  equip(g, w.player.tool === t ? null : t);\n  g.sound('uiTab');\n}\nexport function grantTool(g, tool) {\n  const w = g.world;\n  if (!w.player.tools.includes(tool)) w.player.tools.push(tool);\n  equip(g, tool);\n  g.events.emit('toolGained', { tool });\n}\n/** Ring of tools around you while cycling. */\nexport function drawToolRing(g, hud) {\n  if (!(g.toolRingT > 0)) return;\n  g.toolRingT -= 0.016;\n  const w = g.world;\n  const c = g.project(g.player.x, g.player.y + 1, g.player.z);\n  if (!c) return;\n  const owned = TOOL_ORDER.filter((t) => w.player.tools.includes(t));\n  const n = owned.length;\n  owned.forEach((t, i) => {\n    const a = -Math.PI / 2 + (i / Math.max(1, n)) * Math.PI * 2;\n    const x = Math.round(c.x + Math.cos(a) * 42) - 11;\n    const y = Math.round(c.y + Math.sin(a) * 36) - 11;\n    const eq = w.player.tool === t;\n    panel(hud, x, y, 22, 22, { fill: eq ? 'sand' : 'white', trim: eq ? 'orange' : 'mist' });\n    drawIcon(hud, x + 3, y + 3, ITEMS[t].icon, ITEMS[t].iconColors);\n  });\n}\nexport function toolPrompt(g) {\n  const w = g.world;\n  const t = w.player.tool;\n  if (!t || g.place !== g.town) return null;\n  const f = g.life.fishing;\n  if (t === 'rod' && f) return f.state === 'bite' ? 'REEL!' : 'Reel in';\n  if (t === 'rod') return 'Cast';\n  if (t === 'net') return g.heldNet ? 'Release to swing' : 'Ready the net';\n  if (t === 'can') return 'Water';\n  if (t === 'axe') return 'Chop';\n  if (t === 'shovel') { const o = g.interact.tile ? w.town.objects[`${g.interact.tile[0]},${g.interact.tile[1]}`] : null; return o?.k === 'hole' ? 'Fill' : 'Dig'; }\n  if (t === 'slingshot') return 'Fire';\n  return null;\n}\n/** Tool button with the mouse aims at the cursor. */\nexport function toolInput(g, dt) {\n  const inp = g.inp;\n  const w = g.world;\n  const tool = w.player.tool;\n  const m = inp.mouse;\n  const pressed = inp.useTool || (m.rclick && m.over);\n  if (!tool) {\n    if (pressed && !w.player.gagJump) { w.player.gagJump = true; g.ui.toastMsg(\"You can't jump. You're in escrow.\"); g.events.emit('gag', {}); }\n    return;\n  }\n  if (g.place !== g.town) {\n    if (pressed) g.sound('uiError');\n    return;\n  }\n  if (pressed && m.rclick && g.interact.hoverPoint) { const h = g.interact.hoverPoint; g.player.faceToward(h.x, h.z); g.player.facing = Math.atan2(h.x - g.player.x, h.z - g.player.z); }\n  if (tool === 'net') {\n    if (pressed) { g.heldNet = true; g.player.play('NetReady', 0.06); }\n    else if (g.heldNet && !inp.toolHeld) { g.heldNet = false; netSweep(g); }\n    return;\n  }\n  if (!pressed) return;\n  if (tool === 'rod') {\n    if (g.life.fishing) g.life.reel();\n    else g.life.cast();\n    return;\n  }\n  if (tool === 'shovel') return g.scripts.run(useShovel(g), { name: 'shovel' });\n  if (tool === 'axe') return g.scripts.run(useAxe(g), { name: 'axe' });\n  if (tool === 'can') return g.scripts.run(useCan(g), { name: 'can' });\n  if (tool === 'slingshot') return g.scripts.run(useSling(g), { name: 'sling' });\n  return undefined;\n}\nfunction netSweep(g) {\n  const p = g.player;\n  p.pose('NetSweep');\n  g.sound('netSwing');\n  const reachSq = 1.8 * 1.8;\n  const fx = Math.sin(p.facing), fz = Math.cos(p.facing);\n  // Bugs in a 90° cone\n  const caught = g.life.bugs.find((b) => {\n    const dx = b.x - p.x, dz = b.z - p.z;\n    const d2 = dx * dx + dz * dz;\n    if (d2 > reachSq) return false;\n    const d = Math.sqrt(d2) || 1;\n    return (dx * fx + dz * fz) / d > 0.7 && !b.gone;\n  });\n  // Neighbours are also in the way, sometimes\n  const bonked = !caught ? g.npcs.all().find((n) => n.actor.visible && Math.hypot(n.actor.x - p.x - fx * 1.0, n.actor.z - p.z - fz * 1.0) < 0.9 && n.actor.root.parent === g.place.group) : null;\n  const wasps = g.life.waspsNear?.(p.x + fx, p.z + fz);\n  g.scripts.run((function* () {\n    yield 0.15;\n    if (caught) {\n      g.sound('netCatch');\n      g.rumble(0.3, 80);\n      g.life.catchBug(caught);\n      yield* revealCatch(g, caught.def.id, caught.def.line, 'bug');\n    } else if (bonked) {\n      g.sound('bonk');\n      const npc = bonked;\n      g.world.npcs[npc.id].friend = Math.max(0, g.world.npcs[npc.id].friend - 2);\n      g.world.stats.netBonks += 1;\n      remember(g, 'bonk', { about: npc.id });\n      npc.actor.play(npc.id === 'ozzie' ? 'PlayDead' : 'Shock', 0.05, { once: true });\n      npc.emoting = true;\n      g.events.emit('bonk', { id: npc.id });\n    } else if (wasps) {\n      g.life.netWasps();\n      g.sound('netCatch');\n    } else g.sound('netMiss');\n  })(), { name: 'netResult', hold: !!caught });\n}\nfunction* useShovel(g) {\n  const w = g.world;\n  const [tx, tz] = g.interact.tile;\n  const k = `${tx},${tz}`;\n  const o = w.town.objects[k];\n  const p = g.player;\n  const info = tileInfo(tileChar(tx, tz));\n  p.pose('Dig');\n  yield 0.34;\n  if (o?.k === 'stump') { g.sound('hitRock'); delete w.town.objects[k]; g.town.dirty.add(k); g.ui.toastMsg('You dug up the stump. It had nothing to say.'); g.sound('dirtFall'); g.events.emit('stumpOut', { k }); return; }\n  if (o?.k === 'rock') { g.sound('hitRock'); g.rumble(0.3, 80); g.engine.hitstop(0.05); g.life.hitRock(tx, tz, o); return; }\n  if (o?.k === 'hole') {\n    g.sound('dirtFall');\n    const fillItem = g.pendingBury;\n    delete w.town.objects[k];\n    g.town.dirty.add(k);\n    g.ctx.particles.burst('dirt', [tx + 0.5, 0.2, tz + 0.5], { count: 6 });\n    return;\n  }\n  if (!info.walk || info.surface === 'dock' || info.surface === 'plaza' && !o?.k || tileChar(tx, tz) === '^') {\n    if (info.surface !== 'plaza' || o?.k !== 'crack') { g.sound('hitRock'); g.ui.toastMsg(\"That's not the sort of ground you can dig.\"); return; }\n  }\n  if (o && o.k !== 'crack' && o.k !== 'sparkle' && o.k !== 'weed') { g.sound('uiError'); return; }\n  g.sound('dig');\n  g.rumble(0.4, 100);\n  g.ctx.particles.burst('dirt', [tx + 0.5, 0.25, tz + 0.5], { count: 10 });\n  yield 0.1;\n  const was = o;\n  w.town.objects[k] = { k: 'hole', item: was?.item ?? null };\n  g.town.dirty.add(k);\n  g.events.emit('dug', { k, was: was?.k ?? null });\n  if (was?.k === 'crack' || was?.k === 'sparkle') {\n    w.town.objects[k].item = null;\n    const item = was.item;\n    if (!hasRoom(w)) { w.town.objects[k] = { k: 'drop', item }; g.town.dirty.add(k); g.ui.toastMsg('Your pockets are full. It stays on the ground.'); return; }\n    addItem(g, item);\n    g.events.emit('dugUp', { item });\n    yield* revealCatch(g, item, ITEMS[item].line, 'find');\n  }\n}\nfunction* useAxe(g) {\n  const w = g.world;\n  const [tx, tz] = g.interact.tile;\n  const k = `${tx},${tz}`;\n  const o = w.town.objects[k];\n  const p = g.player;\n  p.pose('Chop');\n  yield 0.34;\n  if (o?.k === 'tree' || o?.k === 'sapling') {\n    g.sound('chop');\n    g.rumble(0.4, 90);\n    o.hits = (o.hits ?? 0) + 1;\n    const v = g.town.objectViews.get(k);\n    if (v) { g.ctx.tweens.value(0, 1, { duration: 0.3 }, (t) => { v.rotation.z = Math.sin(t * 20) * 0.04 * (1 - t); }); }\n    g.ctx.particles.burst('sparkle', [tx + 0.5, 1, tz + 0.5], { count: 4, colors: ['sand', 'orange'] });\n    if (o.hits >= 3 || o.k === 'sapling') {\n      g.sound('treeFall');\n      g.engine.shake.add(g.settings.shake ? 0.25 : 0);\n      w.town.objects[k] = { k: 'stump' };\n      g.town.dirty.add(k);\n      g.ctx.particles.burst('leaf', [tx + 0.5, 2, tz + 0.5], { count: 20 });\n      g.events.emit('treeFelled', { k });\n      w.stats.trees = (w.stats.trees ?? 0) + 1;\n    }\n  } else if (o?.k === 'rock') { g.sound('hitRock'); g.life.hitRock(tx, tz, o); }\n  else if (o?.k === 'stump') { g.sound('chop'); g.ui.toastMsg('The stump is unmoved. Try a shovel.'); }\n  else g.sound('netMiss');\n}\nfunction* useCan(g) {\n  const w = g.world;\n  const [tx, tz] = g.interact.tile;\n  const p = g.player;\n  p.pose('Water');\n  g.sound('waterPour');\n  g.ctx.particles.burst('splash', [tx + 0.5, 0.5, tz + 0.5], { count: 10 });\n  yield 0.5;\n  let watered = 0;\n  for (let dz = -1; dz <= 1; dz++) for (let dx = -1; dx <= 1; dx++) {\n    const k = `${tx + dx},${tz + dz}`;\n    const o = w.town.objects[k];\n    if (!o) continue;\n    if (o.k === 'flower') { o.wet = w.clock.day; if (o.wilt) { o.wilt = 0; g.town.dirty.add(k); } watered++; }\n    if (o.k === 'sapling') { o.wet = w.clock.day; watered++; if (o.mayor) g.events.emit('wateredMayorSapling', {}); }\n  }\n  if (watered) g.events.emit('watered', { n: watered });\n}\nfunction* useSling(g) {\n  const p = g.player;\n  // Aim at the nearest balloon ahead; with a mouse, the one under the cursor.\n  const b = g.life.balloonAhead();\n  p.pose('Slingshot');\n  yield 0.4;\n  g.sound('slingFire');\n  g.life.fireShot(b);\n}\nexport { waterKind, isWaterTile, SOLID_KINDS, BUGS, findItem, removeSlot, tuning };\nEOF\ncat > src/systems/reveal.js <<'EOF'\n// A first catch or find plays the hold-up pose, a jingle and its line. Repeats are quick.\nimport { ITEMS } from '../data/items.js';\nimport { say, narrate } from './say.js';\nimport { drawIcon } from '../art/icons.js';\nimport { addItem, hasRoom } from './economy.js';\n\n/** Add to the almanac and play the moment. kind: fish | bug | find. */\nexport function* revealCatch(g, id, line, kind) {\n  const w = g.world;\n  const it = ITEMS[id];\n  const cat = it?.cat;\n  const book = cat === 'fish' ? w.almanac.fish : cat === 'bug' ? w.almanac.bug : cat === 'fossil' || cat === 'rawFossil' ? w.almanac.fossil : null;\n  const first = book ? !book[id] : !w.flags[`seen:${id}`];\n  if (book) book[id] = (book[id] ?? 0) + 1;\n  else w.flags[`seen:${id}`] = true;\n  if (cat === 'fish') { w.stats.fish += 1; w.stats.caught += 1; if ((it.beans ?? 0) > w.stats.biggestBeans) { w.stats.biggestBeans = it.beans; w.stats.biggest = it.name; } }\n  if (cat === 'bug') { w.stats.bugs += 1; w.stats.caught += 1; }\n  g.events.emit('caught', { id, kind, first });\n  if (!first) {\n    g.sound('revealQuick');\n    g.ui.toastMsg(`Another ${it.name}.`);\n    return;\n  }\n  const p = g.player;\n  p.pose('HoldUp', 1.2);\n  g.sound('reveal');\n  g.revealIcon = { id, t: 0 };\n  g.rumble(0.3, 120);\n  yield 0.5;\n  yield* narrate(g, `You caught a ${it.name}! ${line ?? it.line ?? ''}`.replace('You caught a', kind === 'find' ? 'You found a' : 'You caught a'));\n  g.revealIcon = null;\n  p.poseTimer = 0; p.poseClip = null;\n}\nexport function drawReveal(g, hud) {\n  const r = g.revealIcon;\n  if (!r) return;\n  const it = ITEMS[r.id];\n  const s = g.project(g.player.x, g.player.y + 1.8, g.player.z);\n  if (s) drawIcon(hud, s.x - 16, s.y - 34, it.icon, it.iconColors, 2);\n}\nexport { say, addItem, hasRoom };\nEOF\necho ok","description":"Write interaction system, tools and reveal moments"}}}
