glyphs written with shorthand above\nG['.'] = './././././#'.split('/').concat(['#']).join('/').replace('./././././#/#', '././././././#');\nG[\"'\"] = '#/#/./././././.'.split('/').slice(0, 7).join('/');\nG['’'] = G[\"'\"];\nG[','] = '././././././#/#'.replace('././././././#/#', '../../../../../.#/.#/#.');\nG[';'] = '../.#/.#/../.#/.#/#.';\n\nexport const GLYPHS = {};\nfor (const [ch, s] of Object.entries(G)) {\n  const rows = s.split('/');\n  const w = Math.max(...rows.map((r) => r.length));\n  GLYPHS[ch] = { rows: rows.map((r) => r.padEnd(w, '.')), w, skip: false };\n}\nconst SPACE_W = 3;\nconst COLOR = (c) => ({ '#': c });\nconst colorCache = new Map();\nconst col = (c) => { let v = colorCache.get(c); if (!v) colorCache.set(c, (v = COLOR(c))); return v; };\n\nexport const LINE_H = 12;\n\n/** Width of a string (plain characters) in art pixels at a scale. */\nexport function textWidth(s, scale = 1) {\n  let w = 0;\n  for (const ch of s) {\n    const g = GLYPHS[ch];\n    w += (g ? g.w : SPACE_W) + 1;\n  }\n  return Math.max(0, (w - 1) * scale);\n}\n\n/** Draws a string; x,y is the top left of the caps. Returns the width. Unknown characters draw as spaces. */\nexport function drawText(hud, x, y, s, o = {}) {\n  const { color = 'ink', scale = 1, shadow = false, align = 'left' } = o;\n  let cx = x;\n  if (align !== 'left') {\n    const w = textWidth(s, scale);\n    cx = align === 'center' ? x - Math.floor(w / 2) : x - w;\n  }\n  const start = cx;\n  const sc = scale === 1 ? NOSHADOW1 : { shadow: false, scale };\n  for (const ch of s) {\n    const g = GLYPHS[ch];\n    if (!g) { cx += (SPACE_W + 1) * scale; continue; }\n    if (shadow) hud.sprite(cx + scale, y + scale, g.rows, col(shadow), sc);\n    hud.sprite(cx, y, g.rows, col(color), sc);\n    cx += (g.w + 1) * scale;\n  }\n  return cx - start;\n}\nconst NOSHADOW1 = { shadow: false };\n\n/** Word wrap to a pixel width. Keeps explicit \\n. Markup characters (* and |) are treated as zero width. */\nexport function wrap(s, width, scale = 1) {\n  const lines = [];\n  for (const para of s.split('\\n')) {\n    let line = '';\n    for (const word of para.split(' ')) {\n      const trial = line ? `${line} ${word}` : word;\n      if (textWidth(trial.replace(/[*|]/g, ''), scale) > width && line) { lines.push(line); line = word; } else line = trial;\n    }\n    lines.push(line);\n  }\n  return lines;\n}\nEOF\ncat > /tmp/fonttest.mjs 2>/dev/null <<'EOF'\nEOF\nrm -f /tmp/fonttest.mjs\ncat > tools/fontcheck.mjs <<'EOF'\nimport { GLYPHS, textWidth } from '../src/ui/font.js';\nfor (const c of \".,;'’…·♪!?\") console.log(JSON.stringify(c), GLYPHS[c].rows.join(' / '));\nconst missing=[];for(let i=32;i<127;i++){const c=String.fromCharCode(i);if(c!==' '&&!GLYPHS[c])missing.push(c);}console.log('missing',missing.join(''));\nfor (const [k,g] of Object.entries(GLYPHS)) if(g.rows.length<7||g.rows.length>9) console.log('bad rows',k,g.rows.length);\nconsole.log(textWidth('Hello'));\nEOF\nnode tools/fontcheck.mjs","description":"Write the bitmap font and check every glyph parses"}}}
