{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjpKBrBiFnRd1popk7d","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8981,"cache_read_input_tokens":292245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8981},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"7f9f6743-a523-4ba4-8707-aaff27270926","timestamp":"2026-11-06T00:37:06.881Z","request_id":"req_011CgkjpJxwmDUdMPhB6oGe6","thinking_duration_ms":11946,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjpKBrBiFnRd1popk7d","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BYxUxwJYesEP4vJHeewXMK","name":"Bash","input":{"command":"cat > src/ui/ui.js <<'EOF'\n// The screen stack, focus and hit areas as data, prompts, the HUD.\nimport { drawText, textWidth, panel, dim, inRect, wrap, LINE_H } from './draw.js';\nimport { drawPromptGlyph } from './glyphs.js';\nimport { drawIcon } from '../art/icons.js';\nimport { dateLine, formatTime } from '../core/calendar.js';\nimport { ITEMS } from '../data/items.js';\n\nexport class UI {\n  constructor(g) {\n    this.g = g;\n    this.stack = [];\n    this.toast = null;\n    this.toasts = [];\n    this.hudAlpha = 1;\n    this.idle = 0;\n    this.prompts = []; // corner prompts this frame\n    this.tooltip = null;\n    this.reveal = null;\n    this.hoverTip = null;\n  }\n  get top() { return this.stack[this.stack.length - 1] ?? null; }\n  get blocking() { return this.stack.some((s) => s.modal !== false); }\n  push(screen) {\n    screen.g = this.g;\n    this.stack.push(screen);\n    screen.open?.(this.g);\n    return screen;\n  }\n  pop(screen = this.top) {\n    const i = this.stack.indexOf(screen);\n    if (i >= 0) { this.stack.splice(i, 1); screen.close?.(this.g); }\n  }\n  popAll() { while (this.stack.length) this.pop(); }\n  has(id) { return this.stack.some((s) => s.id === id); }\n  toastMsg(text, color = 'ink') { this.toasts.push({ text, color, t: 3.2 }); if (this.toasts.length > 3) this.toasts.shift(); }\n  update(dt) {\n    const g = this.g;\n    const top = this.top;\n    if (top) top.update?.(g, g.inp, dt);\n    for (const t of this.toasts) t.t -= dt;\n    this.toasts = this.toasts.filter((t) => t.t > 0);\n  }\n  /** Everything a test needs: the current screen, focus and prompts. */\n  model() {\n    const t = this.top;\n    return { screen: t?.id ?? null, depth: this.stack.length, focus: t?.focusIndex?.() ?? t?.focus ?? null, items: t?.labels?.() ?? [], prompts: (t?.prompts?.(this.g) ?? this.prompts).map((p) => p[1]), text: t?.currentText?.() ?? null };\n  }\n  draw(hud) {\n    const g = this.g;\n    for (const s of this.stack) s.draw?.(g, hud);\n    const t = this.top;\n    if (t) {\n      const prompts = t.prompts?.(g);\n      if (prompts) this.drawPrompts(hud, prompts, 'bottom');\n    }\n    this.drawToasts(hud);\n  }\n  drawToasts(hud) {\n    this.toasts.forEach((t, i) => {\n      const w = textWidth(t.text) + 16;\n      const x = 240 - Math.floor(w / 2);\n      const y = 20 + i * 18;\n      panel(hud, x, y, w, 16, { fill: 'white', trim: 'sand' });\n      drawText(hud, 240, y + 5, t.text, { color: t.color, align: 'center' });\n    });\n  }\n  drawPrompts(hud, prompts, where = 'corner') {\n    const g = this.g;\n    const dev = g.inp.device;\n    const xbox = g.settings.xbox;\n    const mouseUsed = g.inp.mouse.used;\n    let total = 0;\n    const widths = prompts.map(([a, label]) => textWidth(label) + 28);\n    for (const w of widths) total += w;\n    const y = 270 - 21;\n    let x = where === 'corner' ? 480 - 12 - total : 240 - Math.floor(total / 2);\n    panel(hud, x - 4, y - 5, total + 8, 19, { fill: 'night', trim: 'night', edge: 'ink' });\n    prompts.forEach(([action, label], i) => {\n      const w = drawPromptGlyph(hud, x + 2, y, action, dev, xbox, mouseUsed);\n      drawText(hud, x + w + 5, y, label, { color: 'white' });\n      x += widths[i];\n    });\n  }\n}\n\n/** A vertical menu of big buttons. Up to 8 things at once; pages if more. */\nexport class Menu {\n  constructor({ id, title, items, back, x = 120, y = 60, w = 240, itemH = 22, gap = 4, prompts, subtitle, onDraw, modal = true, onFocus, cols = 1, dim: dimBack = true, footer }) {\n    this.id = id;\n    this.title = title;\n    this.items = items;\n    this.onBack = back;\n    this.x = x; this.y = y; this.w = w; this.itemH = itemH; this.gap = gap;\n    this.promptList = prompts;\n    this.focus = 0;\n    this.page = 0;\n    this.perPage = 8;\n    this.modal = modal;\n    this.subtitle = subtitle;\n    this.onDraw = onDraw;\n    this.onFocus = onFocus;\n    this.cols = cols;\n    this.dimBack = dimBack;\n    this.footer = footer;\n    this.focus = this.firstEnabled();\n  }\n  firstEnabled() { const i = this.items.findIndex((it) => !it.disabled); return i < 0 ? 0 : i; }\n  labels() { return this.items.map((it) => it.label); }\n  focusIndex() { return this.focus; }\n  visible() {\n    const start = Math.floor(this.focus / this.perPage) * this.perPage;\n    return { start, list: this.items.slice(start, start + this.perPage) };\n  }\n  rect(i) {\n    const { start } = this.visible();\n    const k = i - start;\n    return [this.x, this.y + k * (this.itemH + this.gap), this.w, this.itemH];\n  }\n  move(d) {\n    const n = this.items.length;\n    if (!n) return;\n    let i = this.focus;\n    for (let k = 0; k < n; k++) {\n      i = (i + d + n) % n;\n      if (!this.items[i].disabled) break;\n    }\n    if (i !== this.focus) { this.focus = i; this.g?.sound('uiTick'); this.onFocus?.(this.items[i]); }\n  }\n  activate(g) {\n    const it = this.items[this.focus];\n    if (!it) return;\n    if (it.disabled) { g.sound('uiCancel'); return; }\n    g.sound(it.sound ?? 'uiConfirm');\n    it.action?.(g, this);\n  }\n  update(g, inp) {\n    if (inp.nav.up) this.move(-1);\n    if (inp.nav.down) this.move(1);\n    if (inp.nav.left) this.items[this.focus]?.left?.(g, this);\n    if (inp.nav.right) this.items[this.focus]?.right?.(g, this);\n    const m = inp.mouse;\n    if (m.moved) {\n      const { start, list } = this.visible();\n      list.forEach((it, k) => { if (!it.disabled && inRect(m, ...this.rect(start + k)) && this.focus !== start + k) { this.focus = start + k; this.onFocus?.(it); } });\n    }\n    if (m.click) {\n      const { start, list } = this.visible();\n      list.forEach((it, k) => { if (inRect(m, ...this.rect(start + k))) { this.focus = start + k; this.activate(g); } });\n      return;\n    }\n    if (inp.confirm) { this.activate(g); return; }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); (this.onBack ?? (() => g.ui.pop(this)))(g, this); }\n  }\n  prompts() { return this.promptList ?? [['confirm', 'Select'], ['back', 'Back']]; }\n  draw(g, hud) {\n    if (this.dimBack) dim(hud);\n    const { start, list } = this.visible();\n    const hasTitle = !!this.title;\n    const pageCount = Math.ceil(this.items.length / this.perPage);\n    const totalH = list.length * (this.itemH + this.gap) - this.gap;\n    if (hasTitle) {\n      panel(hud, this.x - 8, this.y - 34, this.w + 16, totalH + 44 + (this.footer ? 14 : 0), { fill: 'white', trim: 'sand' });\n      drawText(hud, this.x + this.w / 2, this.y - 26, this.title, { color: 'ink', scale: 2, align: 'center' });\n    }\n    if (this.subtitle) drawText(hud, this.x + this.w / 2, this.y - 8, this.subtitle, { color: 'slate', align: 'center' });\n    list.forEach((it, k) => {\n      const i = start + k;\n      const [x, y, w, h] = this.rect(i);\n      const focused = i === this.focus;\n      panel(hud, x, y, w, h, { fill: focused ? 'sand' : 'white', trim: focused ? 'orange' : 'mist' });\n      const label = typeof it.label === 'function' ? it.label(g) : it.label;\n      const ty = y + Math.floor((h - 7) / 2);\n      if (it.icon) drawIcon(hud, x + 6, y + Math.floor((h - 16) / 2), it.icon, it.iconColors);\n      drawText(hud, x + (it.icon ? 26 : 10), ty, label, { color: it.disabled ? 'mist' : 'ink' });\n      if (it.value !== undefined) {\n        const val = typeof it.value === 'function' ? it.value(g) : it.value;\n        drawText(hud, x + w - 10, ty, String(val), { color: 'plum', align: 'right' });\n      }\n      if (focused && (it.left || it.right)) {\n        drawText(hud, x + w - 92, ty, '<', { color: 'plum' });\n        drawText(hud, x + w - 6, ty, '>', { color: 'plum', align: 'right' });\n      }\n    });\n    if (pageCount > 1) drawText(hud, this.x + this.w / 2, this.y + totalH + 3, `Page ${Math.floor(this.focus / this.perPage) + 1} of ${pageCount}`, { color: 'slate', align: 'center' });\n    if (this.footer) drawText(hud, this.x + this.w / 2, this.y + totalH + 4, typeof this.footer === 'function' ? this.footer(g) : this.footer, { color: 'slate', align: 'center' });\n    this.onDraw?.(g, hud, this);\n  }\n}\n\n/** The in-world HUD: date and time top left, beans top right, tool bottom left, context prompt bottom right. */\nexport function drawWorldHud(g, hud, dt) {\n  const ui = g.ui;\n  const w = g.world;\n  const alpha = ui.hudAlpha;\n  if (alpha <= 0.02 || !w) return;\n  if (alpha > 0.5 || true) {\n    const line = dateLine(w, g.realNow);\n    const lw = textWidth(line);\n    panel(hud, 12, 12, lw + 14, 17, { fill: 'white', trim: 'sand' });\n    drawText(hud, 19, 17, line, { color: 'ink' });\n    const beans = `${w.player.beans.toLocaleString('en-US')} beans`;\n    const bw = textWidth(beans);\n    panel(hud, 480 - 12 - bw - 26, 12, bw + 26, 17, { fill: 'white', trim: 'sand' });\n    drawIcon(hud, 480 - 12 - bw - 23, 13, 'bean', null, 1);\n    drawText(hud, 480 - 19 - bw, 17, beans, { color: 'ink' });\n    // errands list\n    if (w.story?.day1Active) {\n      const items = g.day1Lines?.() ?? [];\n      if (items.length) {\n        const pw = Math.max(...items.map((t) => textWidth(t))) + 16;\n        panel(hud, 480 - 12 - pw, 32, pw, items.length * 11 + 8, { fill: 'white', trim: 'mist' });\n        items.forEach((t, i) => drawText(hud, 480 - 12 - pw + 8, 37 + i * 11, t, { color: t.startsWith('+') ? 'slate' : 'ink' }));\n      }\n    }\n    // tool\n    const tool = w.player.tool;\n    if (tool) {\n      panel(hud, 12, 270 - 12 - 28, 28, 28, { fill: 'white', trim: 'sand' });\n      drawIcon(hud, 18, 270 - 12 - 22, ITEMS[tool]?.icon ?? tool, ITEMS[tool]?.iconColors);\n      const name = ITEMS[tool]?.name ?? tool;\n      const nw = textWidth(name);\n      panel(hud, 42, 270 - 12 - 17, nw + 12, 17, { fill: 'white', trim: 'mist' });\n      drawText(hud, 48, 270 - 12 - 12, name, { color: 'ink' });\n    }\n  }\n}\nEOF\ncat > src/ui/dialogue.js <<'EOF'\n// Bottom panel, three lines, nameplate, typewriter with voice, skip to end then advance.\nimport { drawText, panel, inRect, textWidth, LINE_H } from './draw.js';\nimport { tuning } from '../dev/tuning.js';\n\nconst PANEL = { x: 28, y: 186, w: 424, h: 64 };\nconst LINE_W = PANEL.w - 32;\n\n/** Parse markup: *emphasis*, ~name~, | beat. Returns chars [{c, color, beat}]. */\nexport function parseLine(text) {\n  const out = [];\n  let color = 'ink';\n  for (const ch of text) {\n    if (ch === '*') { color = color === 'red' ? 'ink' : 'red'; continue; }\n    if (ch === '~') { color = color === 'blue' ? 'ink' : 'blue'; continue; }\n    if (ch === '|') { out.push({ c: '', color, beat: true }); continue; }\n    out.push({ c: ch, color, beat: false });\n  }\n  return out;\n}\nfunction wrapChars(chars) {\n  const lines = [[]];\n  let lineW = 0;\n  let word = [];\n  let wordW = 0;\n  const glyphW = (c) => textWidth(c) + 1;\n  const flush = () => {\n    if (lineW + wordW > LINE_W && lines[lines.length - 1].length) { lines.push([]); lineW = 0; }\n    lines[lines.length - 1].push(...word);\n    lineW += wordW;\n    word = []; wordW = 0;\n  };\n  for (const ch of chars) {\n    if (ch.c === '\\n') { flush(); lines.push([]); lineW = 0; continue; }\n    word.push(ch);\n    wordW += ch.beat ? 0 : ch.c === ' ' ? 4 : glyphW(ch.c);\n    if (ch.c === ' ') flush();\n  }\n  flush();\n  return lines;\n}\n\nexport class Dialogue {\n  /** beats: array of strings (pages), or items { text, emote, sound, who, name }. */\n  constructor({ who = null, name = '', beats, choices = null, onDone = null, voice = null, id = 'dialogue', dimmed = false }) {\n    this.id = id;\n    this.who = who;\n    this.name = name;\n    this.beats = beats.map((b) => (typeof b === 'string' ? { text: b } : b));\n    this.choices = choices;\n    this.onDone = onDone;\n    this.voice = voice;\n    this.index = 0;\n    this.choiceFocus = 0;\n    this.chosen = -1;\n    this.dimmed = dimmed;\n    this.setBeat(0);\n  }\n  currentText() { return this.beats[this.index]?.text ?? ''; }\n  setBeat(i) {\n    this.index = i;\n    const b = this.beats[i];\n    const chars = parseLine(b.text);\n    this.lines = wrapChars(chars);\n    this.total = chars.filter((c) => !c.beat).length;\n    this.seq = chars;\n    this.shown = 0;\n    this.pos = 0;\n    this.timer = 0;\n    this.beat = 0;\n    this.done = false;\n    if (b.who) this.who = b.who;\n    if (b.name) this.name = b.name;\n    if (b.voice) this.voice = b.voice;\n    if (b.emote && this.g) this.g.actorEmote?.(this.who, b.emote);\n    if (b.sound && this.g) this.g.sound(b.sound);\n  }\n  open(g) { this.g = g; const b = this.beats[0]; if (b.emote) g.actorEmote?.(this.who, b.emote); if (b.sound) g.sound(b.sound); }\n  update(g, inp, dt) {\n    const speed = g.settings.textSpeed ?? tuning.textSpeed;\n    if (!this.done) {\n      if (this.beat > 0) this.beat -= dt;\n      else {\n        this.timer += dt * speed;\n        while (this.timer >= 1 && !this.done && this.beat <= 0) {\n          this.timer -= 1;\n          const ch = this.seq[this.pos++];\n          if (!ch) { this.done = true; break; }\n          if (ch.beat) { this.beat = 0.3; continue; }\n          this.shown++;\n          if (ch.c !== ' ') {\n            g.voice?.syllable(ch.c, this.voice, this.currentText());\n            if (this.who) { const a = g.actorOf?.(this.who); if (a && /[aeiouy]/i.test(ch.c)) a.talkAmp = 1; }\n          }\n        }\n        if (this.pos >= this.seq.length) this.done = true;\n      }\n    }\n    const m = inp.mouse;\n    const last = this.index === this.beats.length - 1;\n    if (this.done && last && this.choices) {\n      const n = this.choices.length;\n      if (inp.nav.up) { this.choiceFocus = (this.choiceFocus + n - 1) % n; g.sound('uiTick'); }\n      if (inp.nav.down) { this.choiceFocus = (this.choiceFocus + 1) % n; g.sound('uiTick'); }\n      const rects = this.choiceRects();\n      if (m.moved) rects.forEach((r, i) => { if (inRect(m, ...r)) this.choiceFocus = i; });\n      let pick = inp.confirm;\n      if (m.click) rects.forEach((r, i) => { if (inRect(m, ...r)) { this.choiceFocus = i; pick = true; } });\n      if (pick) {\n        g.sound('uiConfirm');\n        this.chosen = this.choiceFocus;\n        g.ui.pop(this);\n        this.onDone?.(this.chosen);\n      } else if (inp.back || m.rclick) {\n        // Back picks the last option: the one that means \"never mind\"\n        this.chosen = n - 1;\n        g.sound('uiCancel');\n        g.ui.pop(this);\n        this.onDone?.(this.chosen);\n      }\n      return;\n    }\n    if (inp.confirm || m.click || inp.back || m.rclick) {\n      if (!this.done) {\n        this.shown = this.total; this.pos = this.seq.length; this.done = true;\n      } else if (!last) {\n        g.sound('uiTick');\n        this.setBeat(this.index + 1);\n      } else {\n        g.sound('uiTick');\n        g.ui.pop(this);\n        this.onDone?.(-1);\n      }\n    }\n  }\n  choiceRects() {\n    const n = this.choices.length;\n    let w = 0;\n    for (const c of this.choices) w = Math.max(w, textWidth(c) + 26);\n    w = Math.max(90, Math.min(300, w));\n    const h = 19;\n    const x = 480 - 28 - w;\n    const y0 = PANEL.y - 8 - n * (h + 2);\n    return this.choices.map((_, i) => [x, y0 + i * (h + 2), w, h]);\n  }\n  prompts() {\n    const last = this.index === this.beats.length - 1;\n    if (this.done && last && this.choices) return null;\n    return null;\n  }\n  draw(g, hud) {\n    const { x, y, w, h } = PANEL;\n    panel(hud, x, y, w, h, { fill: 'white', trim: 'sand' });\n    if (this.name) {\n      const nw = textWidth(this.name) + 16;\n      panel(hud, x + 10, y - 11, nw, 16, { fill: 'navy', trim: 'sky' });\n      drawText(hud, x + 18, y - 6, this.name, { color: 'white' });\n    }\n    let left = this.shown;\n    this.lines.slice(0, 4).forEach((line, li) => {\n      let cx = x + 14;\n      const ly = y + 11 + li * LINE_H;\n      for (const ch of line) {\n        if (ch.beat) continue;\n        if (left <= 0) break;\n        left--;\n        if (ch.c === ' ') { cx += 4; continue; }\n        cx += drawText(hud, cx, ly, ch.c, { color: ch.color });\n      }\n    });\n    const last = this.index === this.beats.length - 1;\n    if (this.done && !(last && this.choices)) {\n      const bob = Math.floor((g.ctx.time * 4) % 2);\n      drawText(hud, x + w - 18, y + h - 15 + bob, 'v', { color: 'orange', scale: 1 });\n    }\n    if (this.done && last && this.choices) {\n      this.choiceRects().forEach((r, i) => {\n        const focused = i === this.choiceFocus;\n        panel(hud, r[0], r[1], r[2], r[3], { fill: focused ? 'sand' : 'white', trim: focused ? 'orange' : 'mist' });\n        if (focused) drawText(hud, r[0] + 7, r[1] + 6, '>', { color: 'plum' });\n        drawText(hud, r[0] + 16, r[1] + 6, this.choices[i], { color: 'ink' });\n      });\n    }\n  }\n}\nEOF\ncat > src/art/icons.js <<'EOF'\n// About 45 category icons, 16×16, drawn with tiny shape helpers and an automatic ink outline.\n// Rows are authored once as data; colours are slots (o main, x accent, w highlight, # outline).\nconst S = 16;\nfunction canvas() { return Array.from({ length: S }, () => Array(S).fill('.')); }\nfunction ell(g, cx, cy, rx, ry, c) { for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) if (((x + 0.5 - cx) / rx) ** 2 + ((y + 0.5 - cy) / ry) ** 2 <= 1) g[y][x] = c; }\nfunction box(g, x0, y0, x1, y1, c) { for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) if (g[y]?.[x] !== undefined) g[y][x] = c; }\nfunction line(g, x0, y0, x1, y1, c) { const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0)); for (let i = 0; i <= n; i++) { const x = Math.round(x0 + (x1 - x0) * i / (n || 1)); const y = Math.round(y0 + (y1 - y0) * i / (n || 1)); if (g[y]?.[x] !== undefined) g[y][x] = c; } }\nfunction tri(g, x0, y0, x1, y1, x2, y2, c) { for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) { const a = (x1 - x0) * (y + 0.5 - y0) - (y1 - y0) * (x + 0.5 - x0); const b = (x2 - x1) * (y + 0.5 - y1) - (y2 - y1) * (x + 0.5 - x1); const d = (x0 - x2) * (y + 0.5 - y2) - (y0 - y2) * (x + 0.5 - x2); if ((a >= 0 && b >= 0 && d >= 0) || (a <= 0 && b <= 0 && d <= 0)) g[y][x] = c; } }\nfunction outline(g) {\n  const out = g.map((r) => r.slice());\n  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {\n    if (g[y][x] !== '.') continue;\n    if ([[1, 0], [-1, 0], [0, 1], [0, -1]].some(([dx, dy]) => (g[y + dy]?.[x + dx] ?? '.') !== '.')) out[y][x] = '#';\n  }\n  return out.map((r) => r.join(''));\n}\nconst D = {\n  bean: (g) => { ell(g, 8, 8, 4.5, 6, 'o'); box(g, 6, 5, 8, 5, 'w'); line(g, 9, 5, 7, 11, 'x'); },\n  fish1: (g) => { ell(g, 7, 8, 5.5, 3.5, 'o'); tri(g, 12, 8, 15, 4, 15, 12, 'x'); box(g, 4, 7, 4, 7, '#'); box(g, 6, 10, 9, 10, 'w'); },\n  fish2: (g) => { ell(g, 8, 8, 6.5, 2.5, 'o'); tri(g, 13, 8, 15, 5, 15, 11, 'x'); box(g, 3, 7, 3, 7, '#'); line(g, 6, 6, 11, 6, 'x'); },\n  fish3: (g) => { ell(g, 7, 8, 5, 5, 'o'); tri(g, 11, 8, 15, 5, 15, 11, 'x'); tri(g, 7, 3, 10, 1, 10, 4, 'x'); box(g, 4, 6, 4, 6, '#'); },\n  crab: (g) => { ell(g, 8, 9, 5, 3.5, 'o'); box(g, 2, 4, 3, 7, 'x'); box(g, 12, 4, 13, 7, 'x'); box(g, 6, 7, 6, 7, '#'); box(g, 9, 7, 9, 7, '#'); line(g, 4, 12, 3, 14, 'x'); line(g, 11, 12, 12, 14, 'x'); },\n  boot: (g) => { box(g, 4, 2, 9, 11, 'o'); box(g, 4, 10, 13, 13, 'o'); box(g, 4, 12, 13, 13, 'x'); box(g, 4, 3, 9, 3, 'w'); },\n  butterfly: (g) => { ell(g, 4.5, 6, 3.5, 4, 'o'); ell(g, 11.5, 6, 3.5, 4, 'o'); ell(g, 5, 11, 2.5, 2.5, 'x'); ell(g, 11, 11, 2.5, 2.5, 'x'); box(g, 8, 4, 8, 13, '#'); },\n  beetle: (g) => { ell(g, 8, 9, 4.5, 5.5, 'o'); ell(g, 8, 3.5, 2.5, 2, 'x'); line(g, 8, 4, 8, 14, '#'); box(g, 2, 8, 3, 8, '#'); box(g, 12, 8, 13, 8, '#'); box(g, 2, 11, 3, 11, '#'); box(g, 12, 11, 13, 11, '#'); },\n  flier: (g) => { box(g, 7, 2, 8, 13, 'x'); ell(g, 4, 6, 3.5, 1.5, 'o'); ell(g, 11, 6, 3.5, 1.5, 'o'); ell(g, 4, 9, 3, 1.5, 'o'); ell(g, 11, 9, 3, 1.5, 'o'); },\n  hopper: (g) => { ell(g, 7, 9, 5, 2.5, 'o'); ell(g, 12, 8, 2, 2, 'x'); line(g, 4, 8, 2, 4, 'x'); line(g, 2, 4, 1, 11, 'x'); line(g, 8, 11, 7, 14, 'x'); },\n  bee: (g) => { ell(g, 8, 9, 5.5, 4, 'o'); box(g, 5, 6, 6, 12, '#'); box(g, 9, 6, 10, 12, '#'); ell(g, 6, 3.5, 2.5, 2, 'w'); ell(g, 10, 3.5, 2.5, 2, 'w'); },\n  snail: (g) => { ell(g, 8, 7, 4.5, 4.5, 'o'); ell(g, 8, 7, 2, 2, 'x'); box(g, 2, 11, 14, 12, 'w'); box(g, 13, 8, 14, 11, 'w'); box(g, 13, 6, 13, 7, '#'); },\n  bone: (g) => { box(g, 4, 7, 11, 9, 'o'); ell(g, 3.5, 6, 2, 2, 'o'); ell(g, 3.5, 10, 2, 2, 'o'); ell(g, 12.5, 6, 2, 2, 'o'); ell(g, 12.5, 10, 2, 2, 'o'); },\n  ammonite: (g) => { ell(g, 8, 8, 6, 6, 'o'); ell(g, 8, 8, 3.5, 3.5, 'x'); ell(g, 8, 8, 1.5, 1.5, 'o'); },\n  rockIcon: (g) => { ell(g, 8, 9, 6, 5, 'o'); box(g, 5, 6, 8, 6, 'w'); line(g, 9, 9, 12, 11, 'x'); },\n  picture: (g) => { box(g, 1, 3, 14, 12, 'x'); box(g, 3, 5, 12, 10, 'o'); ell(g, 7, 7, 2, 2, 'w'); },\n  pear: (g) => { ell(g, 8, 10, 4.5, 4.5, 'o'); ell(g, 8, 6, 2.5, 3, 'o'); box(g, 8, 1, 8, 3, 'x'); box(g, 9, 2, 10, 2, 'x'); box(g, 6, 8, 6, 9, 'w'); },\n  fruitRound: (g) => { ell(g, 8, 9, 5.5, 5.5, 'o'); box(g, 8, 2, 8, 4, 'x'); box(g, 9, 3, 11, 3, 'x'); box(g, 5, 7, 6, 8, 'w'); },\n  flowerIcon: (g) => { for (const [x, y] of [[8, 4], [4.5, 7], [11.5, 7], [6, 11], [10, 11]]) ell(g, x, y, 2.5, 2.5, 'o'); ell(g, 8, 8, 2, 2, 'x'); },\n  seed: (g) => { box(g, 3, 3, 12, 13, 'o'); box(g, 3, 3, 12, 5, 'x'); ell(g, 8, 9, 2.5, 2.5, 'w'); },\n  sapling: (g) => { ell(g, 8, 5, 4, 3.5, 'o'); box(g, 7, 8, 8, 13, 'x'); box(g, 5, 13, 10, 14, 'x'); },\n  weedIcon: (g) => { line(g, 8, 13, 8, 4, 'o'); line(g, 8, 11, 4, 6, 'o'); line(g, 8, 11, 12, 6, 'o'); box(g, 6, 13, 9, 14, 'x'); },\n  shell: (g) => { tri(g, 8, 13, 1, 5, 15, 5, 'o'); ell(g, 8, 6, 6.5, 3, 'o'); line(g, 8, 13, 4, 4, 'x'); line(g, 8, 13, 8, 3, 'x'); line(g, 8, 13, 12, 4, 'x'); },\n  driftIcon: (g) => { line(g, 2, 11, 13, 5, 'o'); line(g, 2, 10, 13, 4, 'o'); line(g, 3, 12, 14, 6, 'o'); line(g, 7, 8, 9, 3, 'x'); },\n  bag: (g) => { ell(g, 8, 10, 5, 5, 'o'); box(g, 6, 3, 9, 5, 'o'); box(g, 5, 5, 10, 5, 'x'); box(g, 7, 8, 8, 12, 'w'); },\n  cheese: (g) => { tri(g, 2, 12, 14, 5, 14, 12, 'o'); box(g, 2, 12, 14, 13, 'x'); ell(g, 10, 10, 1.5, 1.5, 'x'); ell(g, 6, 11, 1, 1, 'x'); },\n  chair: (g) => { box(g, 4, 2, 5, 13, 'o'); box(g, 4, 8, 11, 9, 'x'); box(g, 10, 9, 11, 13, 'o'); },\n  table: (g) => { box(g, 1, 6, 14, 8, 'o'); box(g, 3, 9, 4, 13, 'x'); box(g, 11, 9, 12, 13, 'x'); },\n  bed: (g) => { box(g, 1, 5, 2, 13, 'x'); box(g, 13, 8, 14, 13, 'x'); box(g, 2, 8, 13, 11, 'o'); box(g, 3, 6, 6, 8, 'w'); },\n  lamp: (g) => { tri(g, 8, 2, 3, 8, 13, 8, 'o'); box(g, 7, 8, 8, 12, 'x'); box(g, 5, 13, 10, 14, 'x'); },\n  shelfIcon: (g) => { box(g, 2, 2, 13, 14, 'x'); box(g, 4, 4, 11, 7, 'o'); box(g, 4, 9, 11, 12, 'w'); },\n  sofa: (g) => { box(g, 2, 5, 13, 9, 'o'); box(g, 1, 8, 14, 12, 'x'); box(g, 2, 13, 3, 14, '#'); box(g, 12, 13, 13, 14, '#'); },\n  plantIcon: (g) => { ell(g, 8, 5, 5, 4, 'o'); box(g, 5, 9, 10, 14, 'x'); },\n  tv: (g) => { box(g, 1, 3, 14, 11, 'x'); box(g, 3, 5, 12, 9, 'o'); box(g, 6, 12, 9, 13, 'x'); },\n  stereo: (g) => { box(g, 2, 4, 13, 12, 'x'); ell(g, 5, 8, 2.5, 2.5, 'o'); ell(g, 11, 8, 2.5, 2.5, 'o'); box(g, 7, 2, 8, 3, 'x'); },\n  clock: (g) => { ell(g, 8, 8, 6, 6, 'o'); line(g, 8, 8, 8, 4, 'x'); line(g, 8, 8, 11, 9, 'x'); },\n  rug: (g) => { box(g, 1, 4, 14, 12, 'o'); box(g, 3, 6, 12, 10, 'x'); box(g, 5, 8, 10, 8, 'w'); },\n  trophy: (g) => { box(g, 4, 2, 11, 7, 'o'); ell(g, 8, 7, 4, 3, 'o'); box(g, 7, 9, 8, 11, 'x'); box(g, 4, 12, 11, 13, 'x'); box(g, 2, 3, 3, 6, 'o'); box(g, 12, 3, 13, 6, 'o'); },\n  shirt: (g) => { box(g, 4, 3, 11, 13, 'o'); box(g, 1, 3, 3, 7, 'o'); box(g, 12, 3, 14, 7, 'o'); box(g, 6, 3, 9, 4, 'x'); },\n  hat: (g) => { box(g, 5, 4, 10, 10, 'o'); box(g, 2, 10, 13, 12, 'o'); box(g, 5, 8, 10, 9, 'x'); },\n  glasses: (g) => { ell(g, 4.5, 8, 3, 3, 'w'); ell(g, 11.5, 8, 3, 3, 'w'); ell(g, 4.5, 8, 1.5, 1.5, 'o'); ell(g, 11.5, 8, 1.5, 1.5, 'o'); box(g, 7, 7, 8, 7, 'x'); },\n  umbrella: (g) => { ell(g, 8, 7, 6.5, 5, 'o'); box(g, 1, 7, 14, 12, '.'); box(g, 8, 7, 8, 13, 'x'); box(g, 6, 13, 8, 13, 'x'); },\n  wallpaper: (g) => { box(g, 3, 2, 11, 13, 'o'); for (let x = 4; x < 11; x += 3) box(g, x, 2, x, 13, 'x'); box(g, 11, 2, 13, 4, 'w'); },\n  floorIcon: (g) => { box(g, 2, 3, 13, 12, 'o'); for (let y = 5; y < 12; y += 3) box(g, 2, y, 13, y, 'x'); },\n  letter: (g) => { box(g, 1, 4, 14, 12, 'w'); line(g, 1, 4, 8, 9, 'x'); line(g, 14, 4, 8, 9, 'x'); box(g, 11, 5, 13, 7, 'o'); },\n  record: (g) => { ell(g, 8, 8, 6.5, 6.5, 'o'); ell(g, 8, 8, 2.5, 2.5, 'x'); ell(g, 8, 8, 1, 1, 'w'); },\n  gift: (g) => { box(g, 2, 6, 13, 13, 'o'); box(g, 7, 6, 8, 13, 'x'); box(g, 2, 8, 13, 9, 'x'); ell(g, 6, 4, 2, 1.5, 'x'); ell(g, 10, 4, 2, 1.5, 'x'); },\n  net: (g) => { line(g, 2, 14, 9, 7, 'x'); ell(g, 10, 5, 4, 4, 'w'); ell(g, 10, 5, 2.5, 2.5, 'o'); },\n  rod: (g) => { line(g, 2, 14, 13, 1, 'x'); line(g, 13, 1, 14, 9, 'w'); ell(g, 14, 10, 1, 1, 'o'); ell(g, 5, 11, 1.5, 1.5, 'o'); },\n  shovel: (g) => { line(g, 12, 2, 6, 8, 'x'); box(g, 2, 9, 7, 14, 'o'); line(g, 11, 1, 14, 4, 'x'); },\n  axe: (g) => { line(g, 4, 14, 11, 3, 'x'); box(g, 6, 2, 13, 7, 'o'); box(g, 12, 2, 13, 7, 'w'); },\n  can: (g) => { box(g, 5, 6, 12, 13, 'o'); line(g, 5, 8, 1, 4, 'o'); box(g, 0, 3, 2, 4, 'x'); ell(g, 9, 5, 3, 2.5, '.'); line(g, 7, 6, 8, 3, 'x'); line(g, 11, 6, 9, 3, 'x'); },\n  sling: (g) => { line(g, 8, 14, 8, 8, 'x'); line(g, 8, 8, 4, 3, 'x'); line(g, 8, 8, 12, 3, 'x'); line(g, 4, 3, 12, 3, 'o'); ell(g, 8, 4, 1.5, 1.5, 'o'); },\n  coffee: (g) => { box(g, 3, 5, 10, 12, 'w'); box(g, 4, 6, 9, 7, 'x'); box(g, 11, 7, 13, 10, 'w'); line(g, 5, 1, 6, 4, 'o'); line(g, 8, 1, 9, 4, 'o'); },\n  medicine: (g) => { box(g, 5, 3, 10, 13, 'o'); box(g, 6, 1, 9, 2, 'x'); box(g, 7, 6, 8, 10, 'w'); box(g, 6, 7, 9, 8, 'w'); },\n  star: (g) => { tri(g, 8, 1, 3, 14, 13, 14, 'o'); tri(g, 1, 5, 15, 5, 8, 11, 'o'); },\n  mush: (g) => { ell(g, 8, 6, 6, 4.5, 'o'); box(g, 2, 7, 13, 10, '.'); box(g, 6, 7, 9, 13, 'w'); ell(g, 6, 4, 1, 1, 'w'); ell(g, 10, 5, 1, 1, 'w'); },\n  gem: (g) => { tri(g, 8, 14, 2, 6, 14, 6, 'o'); box(g, 4, 3, 11, 6, 'o'); line(g, 8, 3, 8, 13, 'x'); },\n  ticket: (g) => { box(g, 1, 5, 14, 11, 'o'); box(g, 5, 5, 5, 11, 'x'); ell(g, 10, 8, 1.5, 1.5, 'w'); },\n  question: (g) => { box(g, 2, 2, 13, 13, 'o'); box(g, 6, 4, 9, 4, 'w'); box(g, 9, 4, 9, 7, 'w'); box(g, 7, 7, 9, 7, 'w'); box(g, 7, 7, 7, 9, 'w'); box(g, 7, 11, 7, 11, 'w'); },\n};\nexport const ICONS = {};\nfor (const [id, fn] of Object.entries(D)) { const g = canvas(); fn(g); ICONS[id] = outline(g); }\nconst DEFAULT = { o: 'sand', x: 'orange', w: 'white', '#': 'ink' };\nconst cache = new Map();\nconst cols = (c) => {\n  if (!c) return DEFAULT;\n  let v = cache.get(c);\n  if (!v) { v = { ...DEFAULT, ...c }; cache.set(c, v); }\n  return v;\n};\nexport function drawIcon(hud, x, y, id, colors, scale = 1) {\n  const rows = ICONS[id] ?? ICONS.question;\n  hud.sprite(x, y, rows, cols(colors), { shadow: false, scale });\n}\nEOF\nnode -e \"import('./src/art/icons.js').then(m=>{console.log(Object.keys(m.ICONS).length,'icons');console.log(m.ICONS.pear.join('\\n'))})\"","description":"Write UI stack, menus, dialogue screen and icon set"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8981,"cache_read_input_tokens":292245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8981},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"b5af528d-e34a-4dbd-a34a-12b9951f6fee","timestamp":"2026-11-06T00:38:57.776Z","request_id":"req_011CgkjpJxwmDUdMPhB6oGe6","wire_tool_inputs":{"toolu_01BYxUxwJYesEP4vJHeewXMK":{"command":"cat > src/ui/ui.js <<'EOF'\n// The screen stack, focus and hit areas as data, prompts, the HUD.\nimport { drawText, textWidth, panel, dim, inRect, wrap, LINE_H } from './draw.js';\nimport { drawPromptGlyph } from './glyphs.js';\nimport { drawIcon } from '../art/icons.js';\nimport { dateLine, formatTime } from '../core/calendar.js';\nimport { ITEMS } from '../data/items.js';\n\nexport class UI {\n  constructor(g) {\n    this.g = g;\n    this.stack = [];\n    this.toast = null;\n    this.toasts = [];\n    this.hudAlpha = 1;\n    this.idle = 0;\n    this.prompts = []; // corner prompts this frame\n    this.tooltip = null;\n    this.reveal = null;\n    this.hoverTip = null;\n  }\n  get top() { return this.stack[this.stack.length - 1] ?? null; }\n  get blocking() { return this.stack.some((s) => s.modal !== false); }\n  push(screen) {\n    screen.g = this.g;\n    this.stack.push(screen);\n    screen.open?.(this.g);\n    return screen;\n  }\n  pop(screen = this.top) {\n    const i = this.stack.indexOf(screen);\n    if (i >= 0) { this.stack.splice(i, 1); screen.close?.(this.g); }\n  }\n  popAll() { while (this.stack.length) this.pop(); }\n  has(id) { return this.stack.some((s) => s.id === id); }\n  toastMsg(text, color = 'ink') { this.toasts.push({ text, color, t: 3.2 }); if (this.toasts.length > 3) this.toasts.shift(); }\n  update(dt) {\n    const g = this.g;\n    const top = this.top;\n    if (top) top.update?.(g, g.inp, dt);\n    for (const t of this.toasts) t.t -= dt;\n    this.toasts = this.toasts.filter((t) => t.t > 0);\n  }\n  /** Everything a test needs: the current screen, focus and prompts. */\n  model() {\n    const t = this.top;\n    return { screen: t?.id ?? null, depth: this.stack.length, focus: t?.focusIndex?.() ?? t?.focus ?? null, items: t?.labels?.() ?? [], prompts: (t?.prompts?.(this.g) ?? this.prompts).map((p) => p[1]), text: t?.currentText?.() ?? null };\n  }\n  draw(hud) {\n    const g = this.g;\n    for (const s of this.stack) s.draw?.(g, hud);\n    const t = this.top;\n    if (t) {\n      const prompts = t.prompts?.(g);\n      if (prompts) this.drawPrompts(hud, prompts, 'bottom');\n    }\n    this.drawToasts(hud);\n  }\n  drawToasts(hud) {\n    this.toasts.forEach((t, i) => {\n      const w = textWidth(t.text) + 16;\n      const x = 240 - Math.floor(w / 2);\n      const y = 20 + i * 18;\n      panel(hud, x, y, w, 16, { fill: 'white', trim: 'sand' });\n      drawText(hud, 240, y + 5, t.text, { color: t.color, align: 'center' });\n    });\n  }\n  drawPrompts(hud, prompts, where = 'corner') {\n    const g = this.g;\n    const dev = g.inp.device;\n    const xbox = g.settings.xbox;\n    const mouseUsed = g.inp.mouse.used;\n    let total = 0;\n    const widths = prompts.map(([a, label]) => textWidth(label) + 28);\n    for (const w of widths) total += w;\n    const y = 270 - 21;\n    let x = where === 'corner' ? 480 - 12 - total : 240 - Math.floor(total / 2);\n    panel(hud, x - 4, y - 5, total + 8, 19, { fill: 'night', trim: 'night', edge: 'ink' });\n    prompts.forEach(([action, label], i) => {\n      const w = drawPromptGlyph(hud, x + 2, y, action, dev, xbox, mouseUsed);\n      drawText(hud, x + w + 5, y, label, { color: 'white' });\n      x += widths[i];\n    });\n  }\n}\n\n/** A vertical menu of big buttons. Up to 8 things at once; pages if more. */\nexport class Menu {\n  constructor({ id, title, items, back, x = 120, y = 60, w = 240, itemH = 22, gap = 4, prompts, subtitle, onDraw, modal = true, onFocus, cols = 1, dim: dimBack = true, footer }) {\n    this.id = id;\n    this.title = title;\n    this.items = items;\n    this.onBack = back;\n    this.x = x; this.y = y; this.w = w; this.itemH = itemH; this.gap = gap;\n    this.promptList = prompts;\n    this.focus = 0;\n    this.page = 0;\n    this.perPage = 8;\n    this.modal = modal;\n    this.subtitle = subtitle;\n    this.onDraw = onDraw;\n    this.onFocus = onFocus;\n    this.cols = cols;\n    this.dimBack = dimBack;\n    this.footer = footer;\n    this.focus = this.firstEnabled();\n  }\n  firstEnabled() { const i = this.items.findIndex((it) => !it.disabled); return i < 0 ? 0 : i; }\n  labels() { return this.items.map((it) => it.label); }\n  focusIndex() { return this.focus; }\n  visible() {\n    const start = Math.floor(this.focus / this.perPage) * this.perPage;\n    return { start, list: this.items.slice(start, start + this.perPage) };\n  }\n  rect(i) {\n    const { start } = this.visible();\n    const k = i - start;\n    return [this.x, this.y + k * (this.itemH + this.gap), this.w, this.itemH];\n  }\n  move(d) {\n    const n = this.items.length;\n    if (!n) return;\n    let i = this.focus;\n    for (let k = 0; k < n; k++) {\n      i = (i + d + n) % n;\n      if (!this.items[i].disabled) break;\n    }\n    if (i !== this.focus) { this.focus = i; this.g?.sound('uiTick'); this.onFocus?.(this.items[i]); }\n  }\n  activate(g) {\n    const it = this.items[this.focus];\n    if (!it) return;\n    if (it.disabled) { g.sound('uiCancel'); return; }\n    g.sound(it.sound ?? 'uiConfirm');\n    it.action?.(g, this);\n  }\n  update(g, inp) {\n    if (inp.nav.up) this.move(-1);\n    if (inp.nav.down) this.move(1);\n    if (inp.nav.left) this.items[this.focus]?.left?.(g, this);\n    if (inp.nav.right) this.items[this.focus]?.right?.(g, this);\n    const m = inp.mouse;\n    if (m.moved) {\n      const { start, list } = this.visible();\n      list.forEach((it, k) => { if (!it.disabled && inRect(m, ...this.rect(start + k)) && this.focus !== start + k) { this.focus = start + k; this.onFocus?.(it); } });\n    }\n    if (m.click) {\n      const { start, list } = this.visible();\n      list.forEach((it, k) => { if (inRect(m, ...this.rect(start + k))) { this.focus = start + k; this.activate(g); } });\n      return;\n    }\n    if (inp.confirm) { this.activate(g); return; }\n    if (inp.back || m.rclick) { g.sound('uiCancel'); (this.onBack ?? (() => g.ui.pop(this)))(g, this); }\n  }\n  prompts() { return this.promptList ?? [['confirm', 'Select'], ['back', 'Back']]; }\n  draw(g, hud) {\n    if (this.dimBack) dim(hud);\n    const { start, list } = this.visible();\n    const hasTitle = !!this.title;\n    const pageCount = Math.ceil(this.items.length / this.perPage);\n    const totalH = list.length * (this.itemH + this.gap) - this.gap;\n    if (hasTitle) {\n      panel(hud, this.x - 8, this.y - 34, this.w + 16, totalH + 44 + (this.footer ? 14 : 0), { fill: 'white', trim: 'sand' });\n      drawText(hud, this.x + this.w / 2, this.y - 26, this.title, { color: 'ink', scale: 2, align: 'center' });\n    }\n    if (this.subtitle) drawText(hud, this.x + this.w / 2, this.y - 8, this.subtitle, { color: 'slate', align: 'center' });\n    list.forEach((it, k) => {\n      const i = start + k;\n      const [x, y, w, h] = this.rect(i);\n      const focused = i === this.focus;\n      panel(hud, x, y, w, h, { fill: focused ? 'sand' : 'white', trim: focused ? 'orange' : 'mist' });\n      const label = typeof it.label === 'function' ? it.label(g) : it.label;\n      const ty = y + Math.floor((h - 7) / 2);\n      if (it.icon) drawIcon(hud, x + 6, y + Math.floor((h - 16) / 2), it.icon, it.iconColors);\n      drawText(hud, x + (it.icon ? 26 : 10), ty, label, { color: it.disabled ? 'mist' : 'ink' });\n      if (it.value !== undefined) {\n        const val = typeof it.value === 'function' ? it.value(g) : it.value;\n        drawText(hud, x + w - 10, ty, String(val), { color: 'plum', align: 'right' });\n      }\n      if (focused && (it.left || it.right)) {\n        drawText(hud, x + w - 92, ty, '<', { color: 'plum' });\n        drawText(hud, x + w - 6, ty, '>', { color: 'plum', align: 'right' });\n      }\n    });\n    if (pageCount > 1) drawText(hud, this.x + this.w / 2, this.y + totalH + 3, `Page ${Math.floor(this.focus / this.perPage) + 1} of ${pageCount}`, { color: 'slate', align: 'center' });\n    if (this.footer) drawText(hud, this.x + this.w / 2, this.y + totalH + 4, typeof this.footer === 'function' ? this.footer(g) : this.footer, { color: 'slate', align: 'center' });\n    this.onDraw?.(g, hud, this);\n  }\n}\n\n/** The in-world HUD: date and time top left, beans top right, tool bottom left, context prompt bottom right. */\nexport function drawWorldHud(g, hud, dt) {\n  const ui = g.ui;\n  const w = g.world;\n  const alpha = ui.hudAlpha;\n  if (alpha <= 0.02 || !w) return;\n  if (alpha > 0.5 || true) {\n    const line = dateLine(w, g.realNow);\n    const lw = textWidth(line);\n    panel(hud, 12, 12, lw + 14, 17, { fill: 'white', trim: 'sand' });\n    drawText(hud, 19, 17, line, { color: 'ink' });\n    const beans = `${w.player.beans.toLocaleString('en-US')} beans`;\n    const bw = textWidth(beans);\n    panel(hud, 480 - 12 - bw - 26, 12, bw + 26, 17, { fill: 'white', trim: 'sand' });\n    drawIcon(hud, 480 - 12 - bw - 23, 13, 'bean', null, 1);\n    drawText(hud, 480 - 19 - bw, 17, beans, { color: 'ink' });\n    // errands list\n    if (w.story?.day1Active) {\n      const items = g.day1Lines?.() ?? [];\n      if (items.length) {\n        const pw = Math.max(...items.map((t) => textWidth(t))) + 16;\n        panel(hud, 480 - 12 - pw, 32, pw, items.length * 11 + 8, { fill: 'white', trim: 'mist' });\n        items.forEach((t, i) => drawText(hud, 480 - 12 - pw + 8, 37 + i * 11, t, { color: t.startsWith('+') ? 'slate' : 'ink' }));\n      }\n    }\n    // tool\n    const tool = w.player.tool;\n    if (tool) {\n      panel(hud, 12, 270 - 12 - 28, 28, 28, { fill: 'white', trim: 'sand' });\n      drawIcon(hud, 18, 270 - 12 - 22, ITEMS[tool]?.icon ?? tool, ITEMS[tool]?.iconColors);\n      const name = ITEMS[tool]?.name ?? tool;\n      const nw = textWidth(name);\n      panel(hud, 42, 270 - 12 - 17, nw + 12, 17, { fill: 'white', trim: 'mist' });\n      drawText(hud, 48, 270 - 12 - 12, name, { color: 'ink' });\n    }\n  }\n}\nEOF\ncat > src/ui/dialogue.js <<'EOF'\n// Bottom panel, three lines, nameplate, typewriter with voice, skip to end then advance.\nimport { drawText, panel, inRect, textWidth, LINE_H } from './draw.js';\nimport { tuning } from '../dev/tuning.js';\n\nconst PANEL = { x: 28, y: 186, w: 424, h: 64 };\nconst LINE_W = PANEL.w - 32;\n\n/** Parse markup: *emphasis*, ~name~, | beat. Returns chars [{c, color, beat}]. */\nexport function parseLine(text) {\n  const out = [];\n  let color = 'ink';\n  for (const ch of text) {\n    if (ch === '*') { color = color === 'red' ? 'ink' : 'red'; continue; }\n    if (ch === '~') { color = color === 'blue' ? 'ink' : 'blue'; continue; }\n    if (ch === '|') { out.push({ c: '', color, beat: true }); continue; }\n    out.push({ c: ch, color, beat: false });\n  }\n  return out;\n}\nfunction wrapChars(chars) {\n  const lines = [[]];\n  let lineW = 0;\n  let word = [];\n  let wordW = 0;\n  const glyphW = (c) => textWidth(c) + 1;\n  const flush = () => {\n    if (lineW + wordW > LINE_W && lines[lines.length - 1].length) { lines.push([]); lineW = 0; }\n    lines[lines.length - 1].push(...word);\n    lineW += wordW;\n    word = []; wordW = 0;\n  };\n  for (const ch of chars) {\n    if (ch.c === '\\n') { flush(); lines.push([]); lineW = 0; continue; }\n    word.push(ch);\n    wordW += ch.beat ? 0 : ch.c === ' ' ? 4 : glyphW(ch.c);\n    if (ch.c === ' ') flush();\n  }\n  flush();\n  return lines;\n}\n\nexport class Dialogue {\n  /** beats: array of strings (pages), or items { text, emote, sound, who, name }. */\n  constructor({ who = null, name = '', beats, choices = null, onDone = null, voice = null, id = 'dialogue', dimmed = false }) {\n    this.id = id;\n    this.who = who;\n    this.name = name;\n    this.beats = beats.map((b) => (typeof b === 'string' ? { text: b } : b));\n    this.choices = choices;\n    this.onDone = onDone;\n    this.voice = voice;\n    this.index = 0;\n    this.choiceFocus = 0;\n    this.chosen = -1;\n    this.dimmed = dimmed;\n    this.setBeat(0);\n  }\n  currentText() { return this.beats[this.index]?.text ?? ''; }\n  setBeat(i) {\n    this.index = i;\n    const b = this.beats[i];\n    const chars = parseLine(b.text);\n    this.lines = wrapChars(chars);\n    this.total = chars.filter((c) => !c.beat).length;\n    this.seq = chars;\n    this.shown = 0;\n    this.pos = 0;\n    this.timer = 0;\n    this.beat = 0;\n    this.done = false;\n    if (b.who) this.who = b.who;\n    if (b.name) this.name = b.name;\n    if (b.voice) this.voice = b.voice;\n    if (b.emote && this.g) this.g.actorEmote?.(this.who, b.emote);\n    if (b.sound && this.g) this.g.sound(b.sound);\n  }\n  open(g) { this.g = g; const b = this.beats[0]; if (b.emote) g.actorEmote?.(this.who, b.emote); if (b.sound) g.sound(b.sound); }\n  update(g, inp, dt) {\n    const speed = g.settings.textSpeed ?? tuning.textSpeed;\n    if (!this.done) {\n      if (this.beat > 0) this.beat -= dt;\n      else {\n        this.timer += dt * speed;\n        while (this.timer >= 1 && !this.done && this.beat <= 0) {\n          this.timer -= 1;\n          const ch = this.seq[this.pos++];\n          if (!ch) { this.done = true; break; }\n          if (ch.beat) { this.beat = 0.3; continue; }\n          this.shown++;\n          if (ch.c !== ' ') {\n            g.voice?.syllable(ch.c, this.voice, this.currentText());\n            if (this.who) { const a = g.actorOf?.(this.who); if (a && /[aeiouy]/i.test(ch.c)) a.talkAmp = 1; }\n          }\n        }\n        if (this.pos >= this.seq.length) this.done = true;\n      }\n    }\n    const m = inp.mouse;\n    const last = this.index === this.beats.length - 1;\n    if (this.done && last && this.choices) {\n      const n = this.choices.length;\n      if (inp.nav.up) { this.choiceFocus = (this.choiceFocus + n - 1) % n; g.sound('uiTick'); }\n      if (inp.nav.down) { this.choiceFocus = (this.choiceFocus + 1) % n; g.sound('uiTick'); }\n      const rects = this.choiceRects();\n      if (m.moved) rects.forEach((r, i) => { if (inRect(m, ...r)) this.choiceFocus = i; });\n      let pick = inp.confirm;\n      if (m.click) rects.forEach((r, i) => { if (inRect(m, ...r)) { this.choiceFocus = i; pick = true; } });\n      if (pick) {\n        g.sound('uiConfirm');\n        this.chosen = this.choiceFocus;\n        g.ui.pop(this);\n        this.onDone?.(this.chosen);\n      } else if (inp.back || m.rclick) {\n        // Back picks the last option: the one that means \"never mind\"\n        this.chosen = n - 1;\n        g.sound('uiCancel');\n        g.ui.pop(this);\n        this.onDone?.(this.chosen);\n      }\n      return;\n    }\n    if (inp.confirm || m.click || inp.back || m.rclick) {\n      if (!this.done) {\n        this.shown = this.total; this.pos = this.seq.length; this.done = true;\n      } else if (!last) {\n        g.sound('uiTick');\n        this.setBeat(this.index + 1);\n      } else {\n        g.sound('uiTick');\n        g.ui.pop(this);\n        this.onDone?.(-1);\n      }\n    }\n  }\n  choiceRects() {\n    const n = this.choices.length;\n    let w = 0;\n    for (const c of this.choices) w = Math.max(w, textWidth(c) + 26);\n    w = Math.max(90, Math.min(300, w));\n    const h = 19;\n    const x = 480 - 28 - w;\n    const y0 = PANEL.y - 8 - n * (h + 2);\n    return this.choices.map((_, i) => [x, y0 + i * (h + 2), w, h]);\n  }\n  prompts() {\n    const last = this.index === this.beats.length - 1;\n    if (this.done && last && this.choices) return null;\n    return null;\n  }\n  draw(g, hud) {\n    const { x, y, w, h } = PANEL;\n    panel(hud, x, y, w, h, { fill: 'white', trim: 'sand' });\n    if (this.name) {\n      const nw = textWidth(this.name) + 16;\n      panel(hud, x + 10, y - 11, nw, 16, { fill: 'navy', trim: 'sky' });\n      drawText(hud, x + 18, y - 6, this.name, { color: 'white' });\n    }\n    let left = this.shown;\n    this.lines.slice(0, 4).forEach((line, li) => {\n      let cx = x + 14;\n      const ly = y + 11 + li * LINE_H;\n      for (const ch of line) {\n        if (ch.beat) continue;\n        if (left <= 0) break;\n        left--;\n        if (ch.c === ' ') { cx += 4; continue; }\n        cx += drawText(hud, cx, ly, ch.c, { color: ch.color });\n      }\n    });\n    const last = this.index === this.beats.length - 1;\n    if (this.done && !(last && this.choices)) {\n      const bob = Math.floor((g.ctx.time * 4) % 2);\n      drawText(hud, x + w - 18, y + h - 15 + bob, 'v', { color: 'orange', scale: 1 });\n    }\n    if (this.done && last && this.choices) {\n      this.choiceRects().forEach((r, i) => {\n        const focused = i === this.choiceFocus;\n        panel(hud, r[0], r[1], r[2], r[3], { fill: focused ? 'sand' : 'white', trim: focused ? 'orange' : 'mist' });\n        if (focused) drawText(hud, r[0] + 7, r[1] + 6, '>', { color: 'plum' });\n        drawText(hud, r[0] + 16, r[1] + 6, this.choices[i], { color: 'ink' });\n      });\n    }\n  }\n}\nEOF\ncat > src/art/icons.js <<'EOF'\n// About 45 category icons, 16×16, drawn with tiny shape helpers and an automatic ink outline.\n// Rows are authored once as data; colours are slots (o main, x accent, w highlight, # outline).\nconst S = 16;\nfunction canvas() { return Array.from({ length: S }, () => Array(S).fill('.')); }\nfunction ell(g, cx, cy, rx, ry, c) { for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) if (((x + 0.5 - cx) / rx) ** 2 + ((y + 0.5 - cy) / ry) ** 2 <= 1) g[y][x] = c; }\nfunction box(g, x0, y0, x1, y1, c) { for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) if (g[y]?.[x] !== undefined) g[y][x] = c; }\nfunction line(g, x0, y0, x1, y1, c) { const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0)); for (let i = 0; i <= n; i++) { const x = Math.round(x0 + (x1 - x0) * i / (n || 1)); const y = Math.round(y0 + (y1 - y0) * i / (n || 1)); if (g[y]?.[x] !== undefined) g[y][x] = c; } }\nfunction tri(g, x0, y0, x1, y1, x2, y2, c) { for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) { const a = (x1 - x0) * (y + 0.5 - y0) - (y1 - y0) * (x + 0.5 - x0); const b = (x2 - x1) * (y + 0.5 - y1) - (y2 - y1) * (x + 0.5 - x1); const d = (x0 - x2) * (y + 0.5 - y2) - (y0 - y2) * (x + 0.5 - x2); if ((a >= 0 && b >= 0 && d >= 0) || (a <= 0 && b <= 0 && d <= 0)) g[y][x] = c; } }\nfunction outline(g) {\n  const out = g.map((r) => r.slice());\n  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {\n    if (g[y][x] !== '.') continue;\n    if ([[1, 0], [-1, 0], [0, 1], [0, -1]].some(([dx, dy]) => (g[y + dy]?.[x + dx] ?? '.') !== '.')) out[y][x] = '#';\n  }\n  return out.map((r) => r.join(''));\n}\nconst D = {\n  bean: (g) => { ell(g, 8, 8, 4.5, 6, 'o'); box(g, 6, 5, 8, 5, 'w'); line(g, 9, 5, 7, 11, 'x'); },\n  fish1: (g) => { ell(g, 7, 8, 5.5, 3.5, 'o'); tri(g, 12, 8, 15, 4, 15, 12, 'x'); box(g, 4, 7, 4, 7, '#'); box(g, 6, 10, 9, 10, 'w'); },\n  fish2: (g) => { ell(g, 8, 8, 6.5, 2.5, 'o'); tri(g, 13, 8, 15, 5, 15, 11, 'x'); box(g, 3, 7, 3, 7, '#'); line(g, 6, 6, 11, 6, 'x'); },\n  fish3: (g) => { ell(g, 7, 8, 5, 5, 'o'); tri(g, 11, 8, 15, 5, 15, 11, 'x'); tri(g, 7, 3, 10, 1, 10, 4, 'x'); box(g, 4, 6, 4, 6, '#'); },\n  crab: (g) => { ell(g, 8, 9, 5, 3.5, 'o'); box(g, 2, 4, 3, 7, 'x'); box(g, 12, 4, 13, 7, 'x'); box(g, 6, 7, 6, 7, '#'); box(g, 9, 7, 9, 7, '#'); line(g, 4, 12, 3, 14, 'x'); line(g, 11, 12, 12, 14, 'x'); },\n  boot: (g) => { box(g, 4, 2, 9, 11, 'o'); box(g, 4, 10, 13, 13, 'o'); box(g, 4, 12, 13, 13, 'x'); box(g, 4, 3, 9, 3, 'w'); },\n  butterfly: (g) => { ell(g, 4.5, 6, 3.5, 4, 'o'); ell(g, 11.5, 6, 3.5, 4, 'o'); ell(g, 5, 11, 2.5, 2.5, 'x'); ell(g, 11, 11, 2.5, 2.5, 'x'); box(g, 8, 4, 8, 13, '#'); },\n  beetle: (g) => { ell(g, 8, 9, 4.5, 5.5, 'o'); ell(g, 8, 3.5, 2.5, 2, 'x'); line(g, 8, 4, 8, 14, '#'); box(g, 2, 8, 3, 8, '#'); box(g, 12, 8, 13, 8, '#'); box(g, 2, 11, 3, 11, '#'); box(g, 12, 11, 13, 11, '#'); },\n  flier: (g) => { box(g, 7, 2, 8, 13, 'x'); ell(g, 4, 6, 3.5, 1.5, 'o'); ell(g, 11, 6, 3.5, 1.5, 'o'); ell(g, 4, 9, 3, 1.5, 'o'); ell(g, 11, 9, 3, 1.5, 'o'); },\n  hopper: (g) => { ell(g, 7, 9, 5, 2.5, 'o'); ell(g, 12, 8, 2, 2, 'x'); line(g, 4, 8, 2, 4, 'x'); line(g, 2, 4, 1, 11, 'x'); line(g, 8, 11, 7, 14, 'x'); },\n  bee: (g) => { ell(g, 8, 9, 5.5, 4, 'o'); box(g, 5, 6, 6, 12, '#'); box(g, 9, 6, 10, 12, '#'); ell(g, 6, 3.5, 2.5, 2, 'w'); ell(g, 10, 3.5, 2.5, 2, 'w'); },\n  snail: (g) => { ell(g, 8, 7, 4.5, 4.5, 'o'); ell(g, 8, 7, 2, 2, 'x'); box(g, 2, 11, 14, 12, 'w'); box(g, 13, 8, 14, 11, 'w'); box(g, 13, 6, 13, 7, '#'); },\n  bone: (g) => { box(g, 4, 7, 11, 9, 'o'); ell(g, 3.5, 6, 2, 2, 'o'); ell(g, 3.5, 10, 2, 2, 'o'); ell(g, 12.5, 6, 2, 2, 'o'); ell(g, 12.5, 10, 2, 2, 'o'); },\n  ammonite: (g) => { ell(g, 8, 8, 6, 6, 'o'); ell(g, 8, 8, 3.5, 3.5, 'x'); ell(g, 8, 8, 1.5, 1.5, 'o'); },\n  rockIcon: (g) => { ell(g, 8, 9, 6, 5, 'o'); box(g, 5, 6, 8, 6, 'w'); line(g, 9, 9, 12, 11, 'x'); },\n  picture: (g) => { box(g, 1, 3, 14, 12, 'x'); box(g, 3, 5, 12, 10, 'o'); ell(g, 7, 7, 2, 2, 'w'); },\n  pear: (g) => { ell(g, 8, 10, 4.5, 4.5, 'o'); ell(g, 8, 6, 2.5, 3, 'o'); box(g, 8, 1, 8, 3, 'x'); box(g, 9, 2, 10, 2, 'x'); box(g, 6, 8, 6, 9, 'w'); },\n  fruitRound: (g) => { ell(g, 8, 9, 5.5, 5.5, 'o'); box(g, 8, 2, 8, 4, 'x'); box(g, 9, 3, 11, 3, 'x'); box(g, 5, 7, 6, 8, 'w'); },\n  flowerIcon: (g) => { for (const [x, y] of [[8, 4], [4.5, 7], [11.5, 7], [6, 11], [10, 11]]) ell(g, x, y, 2.5, 2.5, 'o'); ell(g, 8, 8, 2, 2, 'x'); },\n  seed: (g) => { box(g, 3, 3, 12, 13, 'o'); box(g, 3, 3, 12, 5, 'x'); ell(g, 8, 9, 2.5, 2.5, 'w'); },\n  sapling: (g) => { ell(g, 8, 5, 4, 3.5, 'o'); box(g, 7, 8, 8, 13, 'x'); box(g, 5, 13, 10, 14, 'x'); },\n  weedIcon: (g) => { line(g, 8, 13, 8, 4, 'o'); line(g, 8, 11, 4, 6, 'o'); line(g, 8, 11, 12, 6, 'o'); box(g, 6, 13, 9, 14, 'x'); },\n  shell: (g) => { tri(g, 8, 13, 1, 5, 15, 5, 'o'); ell(g, 8, 6, 6.5, 3, 'o'); line(g, 8, 13, 4, 4, 'x'); line(g, 8, 13, 8, 3, 'x'); line(g, 8, 13, 12, 4, 'x'); },\n  driftIcon: (g) => { line(g, 2, 11, 13, 5, 'o'); line(g, 2, 10, 13, 4, 'o'); line(g, 3, 12, 14, 6, 'o'); line(g, 7, 8, 9, 3, 'x'); },\n  bag: (g) => { ell(g, 8, 10, 5, 5, 'o'); box(g, 6, 3, 9, 5, 'o'); box(g, 5, 5, 10, 5, 'x'); box(g, 7, 8, 8, 12, 'w'); },\n  cheese: (g) => { tri(g, 2, 12, 14, 5, 14, 12, 'o'); box(g, 2, 12, 14, 13, 'x'); ell(g, 10, 10, 1.5, 1.5, 'x'); ell(g, 6, 11, 1, 1, 'x'); },\n  chair: (g) => { box(g, 4, 2, 5, 13, 'o'); box(g, 4, 8, 11, 9, 'x'); box(g, 10, 9, 11, 13, 'o'); },\n  table: (g) => { box(g, 1, 6, 14, 8, 'o'); box(g, 3, 9, 4, 13, 'x'); box(g, 11, 9, 12, 13, 'x'); },\n  bed: (g) => { box(g, 1, 5, 2, 13, 'x'); box(g, 13, 8, 14, 13, 'x'); box(g, 2, 8, 13, 11, 'o'); box(g, 3, 6, 6, 8, 'w'); },\n  lamp: (g) => { tri(g, 8, 2, 3, 8, 13, 8, 'o'); box(g, 7, 8, 8, 12, 'x'); box(g, 5, 13, 10, 14, 'x'); },\n  shelfIcon: (g) => { box(g, 2, 2, 13, 14, 'x'); box(g, 4, 4, 11, 7, 'o'); box(g, 4, 9, 11, 12, 'w'); },\n  sofa: (g) => { box(g, 2, 5, 13, 9, 'o'); box(g, 1, 8, 14, 12, 'x'); box(g, 2, 13, 3, 14, '#'); box(g, 12, 13, 13, 14, '#'); },\n  plantIcon: (g) => { ell(g, 8, 5, 5, 4, 'o'); box(g, 5, 9, 10, 14, 'x'); },\n  tv: (g) => { box(g, 1, 3, 14, 11, 'x'); box(g, 3, 5, 12, 9, 'o'); box(g, 6, 12, 9, 13, 'x'); },\n  stereo: (g) => { box(g, 2, 4, 13, 12, 'x'); ell(g, 5, 8, 2.5, 2.5, 'o'); ell(g, 11, 8, 2.5, 2.5, 'o'); box(g, 7, 2, 8, 3, 'x'); },\n  clock: (g) => { ell(g, 8, 8, 6, 6, 'o'); line(g, 8, 8, 8, 4, 'x'); line(g, 8, 8, 11, 9, 'x'); },\n  rug: (g) => { box(g, 1, 4, 14, 12, 'o'); box(g, 3, 6, 12, 10, 'x'); box(g, 5, 8, 10, 8, 'w'); },\n  trophy: (g) => { box(g, 4, 2, 11, 7, 'o'); ell(g, 8, 7, 4, 3, 'o'); box(g, 7, 9, 8, 11, 'x'); box(g, 4, 12, 11, 13, 'x'); box(g, 2, 3, 3, 6, 'o'); box(g, 12, 3, 13, 6, 'o'); },\n  shirt: (g) => { box(g, 4, 3, 11, 13, 'o'); box(g, 1, 3, 3, 7, 'o'); box(g, 12, 3, 14, 7, 'o'); box(g, 6, 3, 9, 4, 'x'); },\n  hat: (g) => { box(g, 5, 4, 10, 10, 'o'); box(g, 2, 10, 13, 12, 'o'); box(g, 5, 8, 10, 9, 'x'); },\n  glasses: (g) => { ell(g, 4.5, 8, 3, 3, 'w'); ell(g, 11.5, 8, 3, 3, 'w'); ell(g, 4.5, 8, 1.5, 1.5, 'o'); ell(g, 11.5, 8, 1.5, 1.5, 'o'); box(g, 7, 7, 8, 7, 'x'); },\n  umbrella: (g) => { ell(g, 8, 7, 6.5, 5, 'o'); box(g, 1, 7, 14, 12, '.'); box(g, 8, 7, 8, 13, 'x'); box(g, 6, 13, 8, 13, 'x'); },\n  wallpaper: (g) => { box(g, 3, 2, 11, 13, 'o'); for (let x = 4; x < 11; x += 3) box(g, x, 2, x, 13, 'x'); box(g, 11, 2, 13, 4, 'w'); },\n  floorIcon: (g) => { box(g, 2, 3, 13, 12, 'o'); for (let y = 5; y < 12; y += 3) box(g, 2, y, 13, y, 'x'); },\n  letter: (g) => { box(g, 1, 4, 14, 12, 'w'); line(g, 1, 4, 8, 9, 'x'); line(g, 14, 4, 8, 9, 'x'); box(g, 11, 5, 13, 7, 'o'); },\n  record: (g) => { ell(g, 8, 8, 6.5, 6.5, 'o'); ell(g, 8, 8, 2.5, 2.5, 'x'); ell(g, 8, 8, 1, 1, 'w'); },\n  gift: (g) => { box(g, 2, 6, 13, 13, 'o'); box(g, 7, 6, 8, 13, 'x'); box(g, 2, 8, 13, 9, 'x'); ell(g, 6, 4, 2, 1.5, 'x'); ell(g, 10, 4, 2, 1.5, 'x'); },\n  net: (g) => { line(g, 2, 14, 9, 7, 'x'); ell(g, 10, 5, 4, 4, 'w'); ell(g, 10, 5, 2.5, 2.5, 'o'); },\n  rod: (g) => { line(g, 2, 14, 13, 1, 'x'); line(g, 13, 1, 14, 9, 'w'); ell(g, 14, 10, 1, 1, 'o'); ell(g, 5, 11, 1.5, 1.5, 'o'); },\n  shovel: (g) => { line(g, 12, 2, 6, 8, 'x'); box(g, 2, 9, 7, 14, 'o'); line(g, 11, 1, 14, 4, 'x'); },\n  axe: (g) => { line(g, 4, 14, 11, 3, 'x'); box(g, 6, 2, 13, 7, 'o'); box(g, 12, 2, 13, 7, 'w'); },\n  can: (g) => { box(g, 5, 6, 12, 13, 'o'); line(g, 5, 8, 1, 4, 'o'); box(g, 0, 3, 2, 4, 'x'); ell(g, 9, 5, 3, 2.5, '.'); line(g, 7, 6, 8, 3, 'x'); line(g, 11, 6, 9, 3, 'x'); },\n  sling: (g) => { line(g, 8, 14, 8, 8, 'x'); line(g, 8, 8, 4, 3, 'x'); line(g, 8, 8, 12, 3, 'x'); line(g, 4, 3, 12, 3, 'o'); ell(g, 8, 4, 1.5, 1.5, 'o'); },\n  coffee: (g) => { box(g, 3, 5, 10, 12, 'w'); box(g, 4, 6, 9, 7, 'x'); box(g, 11, 7, 13, 10, 'w'); line(g, 5, 1, 6, 4, 'o'); line(g, 8, 1, 9, 4, 'o'); },\n  medicine: (g) => { box(g, 5, 3, 10, 13, 'o'); box(g, 6, 1, 9, 2, 'x'); box(g, 7, 6, 8, 10, 'w'); box(g, 6, 7, 9, 8, 'w'); },\n  star: (g) => { tri(g, 8, 1, 3, 14, 13, 14, 'o'); tri(g, 1, 5, 15, 5, 8, 11, 'o'); },\n  mush: (g) => { ell(g, 8, 6, 6, 4.5, 'o'); box(g, 2, 7, 13, 10, '.'); box(g, 6, 7, 9, 13, 'w'); ell(g, 6, 4, 1, 1, 'w'); ell(g, 10, 5, 1, 1, 'w'); },\n  gem: (g) => { tri(g, 8, 14, 2, 6, 14, 6, 'o'); box(g, 4, 3, 11, 6, 'o'); line(g, 8, 3, 8, 13, 'x'); },\n  ticket: (g) => { box(g, 1, 5, 14, 11, 'o'); box(g, 5, 5, 5, 11, 'x'); ell(g, 10, 8, 1.5, 1.5, 'w'); },\n  question: (g) => { box(g, 2, 2, 13, 13, 'o'); box(g, 6, 4, 9, 4, 'w'); box(g, 9, 4, 9, 7, 'w'); box(g, 7, 7, 9, 7, 'w'); box(g, 7, 7, 7, 9, 'w'); box(g, 7, 11, 7, 11, 'w'); },\n};\nexport const ICONS = {};\nfor (const [id, fn] of Object.entries(D)) { const g = canvas(); fn(g); ICONS[id] = outline(g); }\nconst DEFAULT = { o: 'sand', x: 'orange', w: 'white', '#': 'ink' };\nconst cache = new Map();\nconst cols = (c) => {\n  if (!c) return DEFAULT;\n  let v = cache.get(c);\n  if (!v) { v = { ...DEFAULT, ...c }; cache.set(c, v); }\n  return v;\n};\nexport function drawIcon(hud, x, y, id, colors, scale = 1) {\n  const rows = ICONS[id] ?? ICONS.question;\n  hud.sprite(x, y, rows, cols(colors), { shadow: false, scale });\n}\nEOF\nnode -e \"import('./src/art/icons.js').then(m=>{console.log(Object.keys(m.ICONS).length,'icons');console.log(m.ICONS.pear.join('\\n'))})\"","description":"Write UI stack, menus, dialogue screen and icon set"}}}
