{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmnkKcmVcdUD29nq1yd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EqSyJ1CLSxjZBnQWiJmt4w","name":"Bash","input":{"command":"cat > src/world/rooms.js <<'EOF'\n// Every interior: a dollhouse cutaway with two back walls. Built from data in data/rooms.js.\nimport { THREE, buildModel, toonMaterial, PALETTE, textureMap, setLookLayer, glowMaterial, Mirror, RenderView } from '../engine.js';\nimport { Place, circleBlocked } from './place.js';\nimport { MODELS } from '../art/models.js';\nimport { ROOMS } from '../data/rooms.js';\nimport { ITEMS } from '../data/items.js';\nimport { CRITTER_DEFS } from '../art/critter.js';\nimport { Actor } from '../actors/rig.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { dailyStock, mothwickStock } from '../systems/shop.js';\nimport { FISH_LEN } from '../data/fish.js';\nimport { FISH } from '../data/fish.js';\nimport { BUGS } from '../data/bugs.js';\nimport { FOSSILS } from '../data/fossils.js';\nimport { ART } from '../data/art.js';\nimport { paintingMaterial } from '../art/paintings.js';\n\nconst { BoxGeometry, Group, Mesh, PlaneGeometry, Vector3 } = THREE;\nconst ROOM_OX = 1000;\nconst WALL_H = 3.0;\n\nfunction surfaceMesh(w, d, texId) {\n  const g = new PlaneGeometry(w, d).rotateX(-Math.PI / 2);\n  const uv = g.attributes.uv.array;\n  for (let i = 0; i < uv.length; i += 2) { uv[i] *= w / 4; uv[i + 1] *= d / 4; }\n  const m = new Mesh(g, toonMaterial(PALETTE.white, { map: textureMap(texId) }));\n  m.receiveShadow = true;\n  return m;\n}\nfunction wallMesh(len, texId, axis) {\n  const g = new PlaneGeometry(len, WALL_H);\n  const uv = g.attributes.uv.array;\n  for (let i = 0; i < uv.length; i += 2) { uv[i] *= len / 4; uv[i + 1] *= WALL_H / 4; }\n  const m = new Mesh(g, toonMaterial(PALETTE.white, { map: textureMap(texId) }));\n  m.receiveShadow = true;\n  if (axis === 'w') m.rotation.y = Math.PI / 2;\n  return m;\n}\nconst build = (id, o = {}) => {\n  const obj = buildModel(id, { catalog: MODELS, ...o }).object;\n  obj.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } });\n  return obj;\n};\nconst box = (w, h, d, c) => { const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(typeof c === 'string' ? PALETTE[c] : c)); m.castShadow = true; m.receiveShadow = true; return m; };\n\nexport class RoomPlace extends Place {\n  constructor(g, id, def) {\n    super(id, 'room', { ox: ROOM_OX, oz: 0, name: def.name });\n    this.g = g;\n    this.def = def;\n    this.w = def.w; this.d = def.d;\n    this.camZoom = def.w > 10 ? 1.55 : def.w > 7 ? 1.75 : 2.0;\n    this.music = def.music ?? null;\n    this.owner = def.owner ?? null;\n    this.ownerSpot = def.ownerSpot ?? null;\n    this.lightsReq = [];\n    this.dyn = new Group();\n    this.group.add(this.dyn);\n    this.items = [];\n    this.movers = [];\n    this.actors = new Map();\n    this.built = false;\n    this.group.visible = false;\n  }\n  keepVisible() { return false; }\n  surfaceAt() { const f = this.def.floor ?? ''; return f.includes('carpet') || f.includes('moss') || f.includes('shag') ? 'stepGrass' : f.includes('marble') || f.includes('chess') || f.includes('kitchen') ? 'stepStone' : 'stepWood'; }\n  height() { return 0; }\n  ensureSolid() { this.solid = new Uint8Array(this.w * this.d); }\n  markSolid(x, z, sw, sd) {\n    const x0 = Math.max(0, Math.floor(x - sw / 2 + 0.01)), z0 = Math.max(0, Math.floor(z - sd / 2 + 0.01));\n    for (let j = z0; j < Math.min(this.d, z0 + sd); j++) for (let i = x0; i < Math.min(this.w, x0 + sw); i++) this.solid[j * this.w + i] = 1;\n  }\n  blocked(x, z) {\n    if (this.g.noclip) return x < 0.1 || z < 0.1 || x > this.w - 0.1 || z > this.d;\n    if (x < 0.25 || z < 0.25 || x > this.w - 0.25) return true;\n    const e = this.def.exit;\n    if (z > this.d - 0.25) { if (!e || Math.abs(x - e.x) > 1) return true; return z > this.d + 0.2; }\n    return this.solid[Math.floor(z) * this.w + Math.floor(x)] === 1;\n  }\n  // ---- building ------------------------------------------------------------------------------------\n  buildShell(wallTex, floorTex) {\n    if (this.shell) this.shell.removeFromParent();\n    const s = new Group();\n    const f = surfaceMesh(this.w, this.d, floorTex);\n    f.position.set(this.w / 2, 0, this.d / 2);\n    s.add(f);\n    const under = box(this.w + 0.4, 0.3, this.d + 0.4, 'ink');\n    under.position.set(this.w / 2, -0.17, this.d / 2);\n    s.add(under);\n    const n = wallMesh(this.w, wallTex, 'n');\n    n.position.set(this.w / 2, WALL_H / 2, 0);\n    s.add(n);\n    const wWall = wallMesh(this.d, wallTex, 'w');\n    wWall.position.set(0, WALL_H / 2, this.d / 2);\n    s.add(wWall);\n    const skirting = (len, axis) => { const m = box(axis === 'n' ? len : 0.1, 0.22, axis === 'n' ? 0.1 : len, 'plum'); m.position.set(axis === 'n' ? len / 2 : 0.05, 0.11, axis === 'n' ? 0.05 : len / 2); return m; };\n    s.add(skirting(this.w, 'n'), skirting(this.d, 'w'));\n    const top = (len, axis) => { const m = box(axis === 'n' ? len : 0.3, 0.1, axis === 'n' ? 0.3 : len, 'night'); m.position.set(axis === 'n' ? len / 2 : -0.15, WALL_H + 0.05, axis === 'n' ? -0.15 : len / 2); return m; };\n    s.add(top(this.w + 0.3, 'n'), top(this.d + 0.3, 'w'));\n    // back shells so the cutaway reads as solid from the camera's side\n    const bn = box(this.w + 0.3, WALL_H, 0.3, 'night'); bn.position.set(this.w / 2, WALL_H / 2, -0.15); s.add(bn);\n    const bw = box(0.3, WALL_H, this.d + 0.3, 'night'); bw.position.set(-0.15, WALL_H / 2, this.d / 2); s.add(bw);\n    // mat at the way out\n    const e = this.def.exit;\n    if (e) {\n      const mat = box(1.6, 0.03, 0.6, 'orange');\n      mat.position.set(e.x, 0.02, this.d - 0.3);\n      s.add(mat);\n    }\n    // doors on the back walls\n    for (const door of this.def.doors ?? []) {\n      const frame = box(door.wall === 'n' ? 1.3 : 0.06, 2.2, door.wall === 'n' ? 0.06 : 1.3, 'plum');\n      frame.position.set(door.wall === 'n' ? door.x : 0.04, 1.1, door.wall === 'n' ? 0.04 : door.z);\n      const leaf = box(door.wall === 'n' ? 1.05 : 0.08, 2.0, door.wall === 'n' ? 0.08 : 1.05, 'ink');\n      leaf.position.set(door.wall === 'n' ? door.x : 0.05, 1.0, door.wall === 'n' ? 0.05 : door.z);\n      s.add(frame, leaf);\n    }\n    this.shell = s;\n    this.group.add(s);\n  }\n  placeProp(p, parent = this.group) {\n    const o = build(p.m, { params: p.params, palette: p.palette, seed: p.seed });\n    o.position.set(p.x, p.y ?? 0, p.z);\n    o.rotation.y = ((p.rot ?? 0) * Math.PI) / 180;\n    if (p.scale) o.scale.setScalar(p.scale);\n    parent.add(o);\n    return o;\n  }\n  buildProps() {\n    this.ensureSolid();\n    if (this.propsGroup) this.propsGroup.removeFromParent();\n    this.propsGroup = new Group();\n    this.group.add(this.propsGroup);\n    this.interactList = [];\n    this.lamps = [];\n    for (const p of this.def.props ?? []) {\n      this.placeProp(p, this.propsGroup);\n      if (p.solid) this.markSolid(p.x, p.z, p.solid[0], p.solid[1]);\n      if (p.act) this.interactList.push({ id: `${p.act}:${p.x},${p.z}`, x: p.x, z: p.z, r: p.r ?? 1.3, label: p.label ?? 'Look', act: p.act, prop: p, talkTo: p.talkTo });\n      if (p.light) this.lamps.push({ x: p.x, z: p.z, y: (p.y ?? 0) + 1.7 });\n    }\n    if (this.def.corkboard) {\n      const cb = box(2.4, 1.4, 0.05, 'orange'); cb.position.set(2.4, 1.7, 0.05); this.propsGroup.add(cb);\n      for (const [x, y, c] of [[1.6, 2.1, 'white'], [2.2, 1.5, 'sand'], [2.9, 2.0, 'white'], [3.2, 1.4, 'mist'], [1.9, 1.3, 'sand']]) { const n = box(0.34, 0.26, 0.04, c); n.position.set(x, y, 0.09); this.propsGroup.add(n); }\n      const string = (x0, y0, x1, y1) => { const len = Math.hypot(x1 - x0, y1 - y0); const m = box(len, 0.03, 0.03, 'red'); m.position.set((x0 + x1) / 2, (y0 + y1) / 2, 0.12); m.rotation.z = Math.atan2(y1 - y0, x1 - x0); this.propsGroup.add(m); };\n      string(1.6, 2.1, 2.2, 1.5); string(2.2, 1.5, 2.9, 2.0); string(2.9, 2.0, 3.2, 1.4); string(1.9, 1.3, 3.2, 1.4); string(1.6, 2.1, 2.9, 2.0);\n    }\n    if (this.def.host) this.buildHost();\n    this.built = true;\n  }\n  buildHost() {\n    const h = this.def.host;\n    if (this.host) return;\n    const a = new Actor(CRITTER_DEFS[h.id], { name: h.id, seed: h.id.length });\n    a.x = h.x; a.z = h.z; a.facing = h.face ?? 0;\n    a.addTo(this.group);\n    this.host = a;\n    this.hostId = h.id;\n    this.actors.set(h.id, a);\n    // A host you can talk to directly when no counter prop does it.\n    if (!(this.def.props ?? []).some((p) => p.talkTo === h.id)) this.interactList.push({ id: `host:${h.id}`, x: h.x, z: h.z, r: 1.5, label: `Talk to ${hostName(h.id)}`, act: 'hostTalk', talkTo: h.id });\n  }\n  hostActor(id) { return this.actors.get(id) ?? null; }\n  enter(g) {\n    if (!this.built) { this.buildShell(this.def.wall, this.def.floor); this.buildProps(); }\n    this.refreshDynamic();\n    this.lightsReq = (this.lamps ?? []).map((l) => g.ctx.lights.request({ position: [l.x + ROOM_OX, l.y, l.z], color: 0xffd9a0, intensity: 7, radius: 7 }));\n  }\n  leave() {\n    for (const l of this.lightsReq) l.release();\n    this.lightsReq = [];\n  }\n  refreshDynamic() {\n    const g = this.g;\n    this.dyn.clear();\n    this.dynInteract = [];\n    this.movers.length = 0;\n    this.ownerNow = null;\n    const def = this.def;\n    if (this.id === 'store') this.buildStock(dailyStock(g), def.stockSlots);\n    if (this.id === 'mothwick') this.buildStock(mothwickStock(g), def.stockSlots);\n    if (def.wing) this.buildWing(def.wing);\n    if (this.id === 'house_rocco') this.applyRoccoHouse();\n    if (def.easels) this.buildEasels();\n    if (this.id === 'auction') this.buildLot();\n  }\n  applyRoccoHouse() {\n    const g = this.g;\n    const gone = g.world.npcs.rocco.moved !== 'here';\n    this.owner = gone ? 'fitch' : 'rocco';\n    const leaving = g.world.npcs.rocco.moved === 'here' && g.world.flags.roccoBoxes;\n    if (gone || leaving) {\n      const spots = [[1, 3], [2.2, 4.4], [5, 1.2], [4.6, 4.6], [1.1, 1.6], [3.4, 4.8]];\n      for (const [x, z] of spots) { const b = build('kenney-furniture/cardboard-box-closed', { palette: { wood: 'sand', woodDark: 'orange' } }); b.position.set(x, 0, z); b.scale.setScalar(1.5); b.rotation.y = x; this.dyn.add(b); }\n    }\n  }\n  buildStock(stock, slots) {\n    const g = this.g;\n    stock.forEach((s, i) => {\n      if (i >= slots.length) return;\n      const [x, z] = slots[i];\n      const onShelf = this.nearShelf(x, z);\n      const it = ITEMS[s.id];\n      const prop = stockProp(s.id);\n      prop.position.set(x, onShelf ? 1.15 : 0, z);\n      this.dyn.add(prop);\n      if (!onShelf) this.markSolid(x, z, 1, 1);\n      this.dynInteract.push({ id: `stock:${i}`, x, z, r: 1.35, label: `Look at ${it.name}`, act: 'stockLook', stock: s, index: i, mesh: prop });\n    });\n  }\n  nearShelf(x, z) { return (this.def.props ?? []).some((p) => p.m === 'shelf' && Math.abs(p.z - z) < 1 && Math.abs(p.x - x) < 2.2 && (p.rot ? Math.abs(p.x - x) < 0.5 : Math.abs(p.z - z) < 0.5)); }\n  buildEasels() {\n    const g = this.g;\n    const stock = g.life.magdaStock();\n    this.def.easels.forEach(([x, z], i) => {\n      const s = stock[i];\n      if (!s) return;\n      this.markSolid(x, z, 1, 1);\n      const easel = new Group();\n      easel.position.set(x, 0, z);\n      const legs = box(0.08, 1.4, 0.08, 'plum'); legs.position.set(0, 0.7, 0); easel.add(legs);\n      const canvas = new Mesh(new BoxGeometry(1.12, 0.86, 0.05), paintingMaterial(s.id));\n      canvas.position.set(0, 1.4, 0.05);\n      easel.add(canvas);\n      const frame = box(1.24, 0.98, 0.04, 'sand'); frame.position.set(0, 1.4, 0.02); easel.add(frame);\n      easel.rotation.y = 0.5;\n      this.dyn.add(easel);\n      this.dynInteract.push({ id: `easel:${i}`, x, z, r: 1.5, label: `Look at ${ITEMS[s.id].name}`, act: 'magdaLook', stock: s });\n    });\n  }\n  buildLot() {\n    const lot = this.g.life.auctionLot?.();\n    if (!lot) return;\n    const it = ITEMS[lot.id];\n    const p = stockProp(lot.id);\n    p.position.set(5, 0.6, 2.6);\n    this.dyn.add(p);\n  }\n  // ---- Museum wings: every donation appears in place --------------------------------------------------\n  buildWing(wing) {\n    const g = this.g;\n    const m = g.world.museum[wing];\n    const addLook = (x, z, id, name, line) => this.dynInteract.push({ id: `wing:${id}`, x, z, r: 1.3, label: `Look at ${name}`, act: 'museumLook', lookName: name, line });\n    if (wing === 'fish') {\n      const slots = wingSlots(FISH.length, this.w, this.d);\n      FISH.forEach((f, i) => {\n        const [x, z] = slots[i];\n        const t = build('tank', { params: { w: 1.2 } });\n        t.position.set(x, 0, z);\n        this.dyn.add(t);\n        this.markSolid(x, z, 1, 1);\n        if (m[f.id]) {\n          const fm = build('fish', { params: { len: FISH_LEN[f.size] * 0.5 }, palette: { body: f.color } });\n          fm.position.set(x, 1, z);\n          this.dyn.add(fm);\n          this.movers.push({ o: fm, kind: 'swim', cx: x, cz: z, cy: 0.98, t: i * 1.3, r: 0.32 });\n          addLook(x, z, f.id, f.name, f.line);\n        } else {\n          this.dynInteract.push({ id: `wing:${f.id}`, x, z, r: 1.3, label: 'Empty tank', act: 'museumLook', lookName: 'An empty tank', line: 'A little brass plate says this one is expected. Dr. Quill has drawn a very hopeful fish on it.' });\n        }\n      });\n    } else if (wing === 'bug') {\n      const slots = wingSlots(BUGS.length, this.w, this.d);\n      BUGS.forEach((b, i) => {\n        const [x, z] = slots[i];\n        const t = build('tank', { params: { w: 1.0 }, palette: { water: 'green', frame: 'plum', sand: 'teal', top: 'plum' } });\n        t.position.set(x, 0, z);\n        this.dyn.add(t);\n        this.markSolid(x, z, 1, 1);\n        if (m[b.id]) {\n          const fm = b.kind === 'flier' ? build('winged', { params: { size: 0.34 }, palette: { wing: b.color === 'white' ? 'white' : b.color, spot: 'ink' } }) : build('bug', { params: { size: 0.24 }, palette: { body: b.color } });\n          fm.position.set(x, 1, z);\n          this.dyn.add(fm);\n          this.movers.push({ o: fm, kind: b.kind === 'flier' ? 'flutter' : 'crawl', cx: x, cz: z, cy: 0.98, t: i, r: 0.24 });\n          addLook(x, z, b.id, b.name, b.line);\n        } else this.dynInteract.push({ id: `wing:${b.id}`, x, z, r: 1.3, label: 'Empty case', act: 'museumLook', lookName: 'An empty case', line: \"Dr. Quill's note reads: 'something small, I think. Possibly with legs.'\" });\n      });\n    } else if (wing === 'fossil') {\n      const layout = { moatSkull: [3, 2], moatTorso: [4.8, 2], moatTail: [6.6, 2], regretSkull: [3, 5.4], regretNeck: [4.8, 5.4], regretTorso: [6.6, 5.4], trilobite: [9.8, 1.6], ammonite: [9.8, 3.2], amberFly: [9.8, 4.8], mysteryTooth: [9.8, 6.4] };\n      FOSSILS.forEach((f) => {\n        const [x, z] = layout[f.id];\n        const pl = build('plinth');\n        pl.position.set(x, 0, z);\n        pl.scale.set(f.set ? 1.6 : 1, 1, 1.4);\n        this.dyn.add(pl);\n        this.markSolid(x, z, 2, 1);\n        if (m[f.id]) {\n          const bone = build(f.model);\n          bone.position.set(x, 0.58, z);\n          if (f.set) bone.rotation.y = Math.PI / 2;\n          this.dyn.add(bone);\n          addLook(x, z, f.id, f.name, f.line);\n        } else this.dynInteract.push({ id: `wing:${f.id}`, x, z, r: 1.4, label: 'Empty plinth', act: 'museumLook', lookName: 'An empty plinth', line: 'It says \"COMING SOON\" in very small, very hopeful letters.' });\n      });\n    } else if (wing === 'art') {\n      const spots = [[2, 0.1, 'n'], [4.5, 0.1, 'n'], [7, 0.1, 'n'], [9.5, 0.1, 'n'], [0.1, 2, 'w'], [0.1, 4.2, 'w'], [0.1, 6.4, 'w'], [0.1, 8.4, 'w']];\n      ART.forEach((a, i) => {\n        const [x, z, side] = spots[i];\n        const frame = box(side === 'n' ? 1.6 : 0.06, 1.3, side === 'n' ? 0.06 : 1.6, 'sand');\n        frame.position.set(x, 1.8, z);\n        this.dyn.add(frame);\n        if (m[a.id]) {\n          const pic = new Mesh(new BoxGeometry(side === 'n' ? 1.4 : 0.04, 1.08, side === 'n' ? 0.04 : 1.4), paintingMaterial(a.id));\n          pic.position.set(side === 'n' ? x : x + 0.04, 1.8, side === 'n' ? z + 0.04 : z);\n          this.dyn.add(pic);\n          addLook(side === 'n' ? x : 1, side === 'n' ? 1 : z, a.id, a.name, a.line);\n        } else {\n          const pic = box(side === 'n' ? 1.4 : 0.04, 1.08, side === 'n' ? 0.04 : 1.4, 'night');\n          pic.position.set(side === 'n' ? x : x + 0.04, 1.8, side === 'n' ? z + 0.04 : z);\n          this.dyn.add(pic);\n        }\n      });\n    }\n    if (g.world.museum.plaques[wing]) {\n      const plaque = box(1.2, 0.5, 0.06, 'sand');\n      plaque.position.set(this.w - 1.2, 2.3, 0.1);\n      this.dyn.add(plaque);\n    }\n  }\n  /** Fish swim, bugs flutter, hosts idle. */\n  update(dt, t) {\n    for (const m of this.movers) {\n      m.t += dt;\n      if (m.kind === 'swim') {\n        m.o.position.x = m.cx + Math.sin(m.t * 0.7) * m.r;\n        m.o.position.z = m.cz + Math.sin(m.t * 1.3) * 0.1;\n        m.o.position.y = m.cy + Math.sin(m.t * 1.1) * 0.06;\n        m.o.rotation.y = Math.cos(m.t * 0.7) > 0 ? Math.PI / 2 : -Math.PI / 2;\n      } else if (m.kind === 'flutter') {\n        m.o.position.x = m.cx + Math.sin(m.t * 1.3) * m.r;\n        m.o.position.z = m.cz + Math.cos(m.t * 1.7) * 0.1;\n        m.o.position.y = m.cy + Math.abs(Math.sin(m.t * 2.3)) * 0.22;\n        const wl = m.o.getObjectByName('WingL'), wr = m.o.getObjectByName('WingR');\n        if (wl) wl.rotation.z = Math.sin(m.t * 22) * 0.8;\n        if (wr) wr.rotation.z = -Math.sin(m.t * 22) * 0.8;\n      } else if (m.kind === 'crawl') {\n        m.o.position.x = m.cx + Math.sin(m.t * 0.4) * m.r;\n      }\n    }\n    for (const a of this.actors.values()) {\n      if (!a.current || a.finished) a.play('Idle', 0.2);\n      a.update(dt);\n    }\n    this.extraUpdate?.(dt, t);\n  }\n  interactables() {\n    const out = [...(this.interactList ?? []), ...(this.dynInteract ?? [])];\n    const e = this.def.exit;\n    for (const door of this.def.doors ?? []) out.push({ id: `door:${door.to}`, x: door.wall === 'n' ? door.x : 0.8, z: door.wall === 'n' ? 0.8 : door.z, r: 1.3, label: `To the ${door.label}`, act: 'roomDoor', door });\n    return out;\n  }\n}\nconst hostName = (id) => ({ gander: 'Mrs. Gander', clementine: 'Clementine', quill: 'Dr. Quill', mothwick: 'Madame Mothwick', fleece: 'Monsieur Fleece', flavia: 'Flavia Rosé', magda: 'Magda', bellows: 'Sir Reginald', pemberton: 'Pemberton', brisket: 'Agent Brisket', lou: 'Languid Lou', nibbles: 'Madame Nibbles' }[id] ?? id);\nfunction wingSlots(n, w, d) {\n  const out = [];\n  for (let x = 1.5; x < w - 0.5 && out.length < n; x += 1.5) out.push([x, 0.9]);\n  for (let z = 2.4; z < d - 1.5 && out.length < n; z += 1.5) out.push([0.9, z]);\n  for (let z = 2.4; z < d - 1.5 && out.length < n; z += 1.5) out.push([w - 0.9, z]);\n  for (let x = 3.2; x < w - 2 && out.length < n; x += 1.5) out.push([x, 4.2]);\n  for (let x = 3.2; x < w - 2 && out.length < n; x += 1.5) out.push([x, 6.0]);\n  return out;\n}\n/** A small object standing for a stock item. */\nexport function stockProp(id) {\n  const it = ITEMS[id];\n  const g = new Group();\n  const c = it?.iconColors?.o ?? 'sand';\n  const add = (m, y = 0) => { m.position.y += y; g.add(m); return m; };\n  switch (it?.cat) {\n    case 'furniture': {\n      const o = build(it.model, { palette: it.palette ?? undefined, params: it.params });\n      const f = Math.max(it.w, it.d);\n      const s = 0.62 / Math.max(1, f * 0.7);\n      o.scale.setScalar(s);\n      add(o);\n      break;\n    }\n    case 'clothes': { const b = box(0.5, 0.52, 0.2, it.shirt); add(b, 0.45); const t = box(0.22, 0.08, 0.21, it.trim); add(t, 0.7); const stand = box(0.06, 0.2, 0.06, 'plum'); add(stand, 0.1); const arm = box(0.72, 0.16, 0.2, it.shirt); add(arm, 0.6); break; }\n    case 'hat': { const b = box(0.36, 0.24, 0.36, it.hatColor); add(b, 0.32); add(box(0.56, 0.05, 0.56, it.hatColor), 0.2); add(box(0.1, 0.2, 0.1, 'plum'), 0.1); break; }\n    case 'glasses': { add(box(0.5, 0.14, 0.04, it.glassesColor === 'white' ? 'mist' : it.glassesColor), 0.3); add(box(0.08, 0.2, 0.08, 'plum'), 0.1); break; }\n    case 'umbrella': { add(box(0.08, 0.7, 0.08, it.b), 0.35); add(box(0.5, 0.1, 0.5, it.a), 0.7); break; }\n    case 'wall': { add(box(0.5, 0.26, 0.26, 'sand'), 0.13); add(box(0.52, 0.04, 0.28, 'orange'), 0.14); break; }\n    case 'floor': { add(box(0.56, 0.14, 0.44, 'orange'), 0.07); add(box(0.56, 0.02, 0.44, 'plum'), 0.15); break; }\n    case 'tool': { const m = { net: 'tool-net', rod: 'tool-rod', shovel: 'tool-shovel', axe: 'tool-axe', can: 'tool-can', slingshot: 'tool-slingshot' }[id]; const o = build(m); o.rotation.z = 0.5; o.position.y = 0.3; g.add(o); break; }\n    case 'seed': { add(box(0.26, 0.34, 0.08, c), 0.17); add(box(0.26, 0.08, 0.09, 'white'), 0.26); break; }\n    case 'cheese': { const o = build('cheese-wheel'); add(o); break; }\n    case 'plant': { const o = build('sapling', { params: { stage: 0 } }); o.scale.setScalar(0.7); add(o); break; }\n    default: { add(box(0.3, 0.3, 0.3, c), 0.15); add(box(0.32, 0.08, 0.1, it?.iconColors?.x ?? 'orange'), 0.2); break; }\n  }\n  return g;\n}\nexport class RoomPlaces {\n  constructor(g) { this.g = g; this.map = new Map(); }\n  get(id) {\n    let r = this.map.get(id);\n    if (!r) {\n      const def = ROOMS[id];\n      if (!def && id.startsWith('home')) { r = new HomeRoom(this.g, id); }\n      else if (!def) throw new Error(`no room ${id}`);\n      else r = new RoomPlace(this.g, id, def);\n      this.map.set(id, r);\n      this.g.ctx.scene.add(r.group);\n    }\n    return r;\n  }\n}\n// ---- The player's home ------------------------------------------------------------------------------\nimport { HomeRoom } from './home.js';\nexport { circleBlocked, setLookLayer, glowMaterial, Mirror, RenderView, Vector3, NEIGHBOURS };\nEOF\ncat > src/world/home.js <<'EOF'\n// Your home: rooms by tier, real furniture on a 1 m grid, lamps, stereo, TV, mirror, fish tank.\nimport { THREE, buildModel, toonMaterial, PALETTE, Mirror, RenderView } from '../engine.js';\nimport { RoomPlace } from './rooms.js';\nimport { ITEMS } from '../data/items.js';\nimport { MODELS } from '../art/models.js';\nimport { BUILDINGS } from '../data/town.js';\nimport { FISH_LEN } from '../data/fish.js';\n\nconst { Group, Mesh, BoxGeometry, Vector3 } = THREE;\nconst HOME_DOOR = BUILDINGS.find((b) => b.id === 'home').door;\nexport const HOME_SIZES = { 1: { main: [6, 6] }, 2: { main: [8, 8] }, 3: { main: [8, 8], annex: [6, 6] }, 4: { main: [8, 8], annex: [6, 6], upstairs: [8, 8] } };\nconst roomKey = (id) => (id === 'home' ? 'main' : id.replace('home_', ''));\n\nexport class HomeRoom extends RoomPlace {\n  constructor(g, id) {\n    const key = roomKey(id);\n    const def = { name: 'Your Home', wall: 'wall-plaster', floor: 'floor-oak', w: 8, d: 8, props: [], home: true };\n    super(g, id, def);\n    this.key = key;\n    this.music = (gg) => gg.world.home.stereo ? gg.world.home.stereo : gg.world.home.dust?.length ? null : null;\n  }\n  get roomData() { return this.g.world.home.rooms[this.key]; }\n  keepVisible(old) { return old === this.g.town && this.hasFunc('tv'); }\n  hasFunc(f) { return this.roomData.items.some((i) => ITEMS[i.id]?.func === f); }\n  rebuild() {\n    const g = this.g;\n    const tier = g.world.player.homeTier;\n    const size = HOME_SIZES[tier][this.key] ?? [6, 6];\n    this.w = size[0]; this.d = size[1];\n    this.camZoom = this.w > 6 ? 1.75 : 2.0;\n    const e = this.key === 'main' ? { x: this.w / 2, z: this.d - 0.5, to: 'town', tx: HOME_DOOR[0], tz: HOME_DOOR[1] + 0.6, facing: 0 } : this.key === 'annex' ? { x: this.w / 2, z: this.d - 0.5, to: 'home', tx: 1.1, tz: 2, facing: 1.57 } : { x: this.w / 2, z: this.d - 0.5, to: 'home', tx: 6.8, tz: 2, facing: 0 };\n    this.def.exit = e;\n    this.def.w = this.w; this.def.d = this.d;\n    const rd = this.roomData;\n    this.def.wall = rd.wall; this.def.floor = rd.floor;\n    this.buildShell(rd.wall, rd.floor);\n    this.ensureSolid();\n    this.interactList = [];\n    if (this.key === 'main' && tier >= 3) this.interactList.push({ id: 'toAnnex', x: 0.8, z: 2, r: 1.2, label: 'To the annex', act: 'roomDoor', door: { to: 'home_annex', tx: 3, tz: 5, label: 'annex' } });\n    if (this.key === 'main' && tier >= 4) this.interactList.push({ id: 'toUp', x: 6.8, z: 0.8, r: 1.2, label: 'Upstairs', act: 'roomDoor', door: { to: 'home_upstairs', tx: 4, tz: 7, label: 'upstairs' } });\n    if (this.key === 'main' && tier >= 3) { const f = new Mesh(new BoxGeometry(0.06, 2.2, 1.3), toonMaterial(PALETTE.plum)); f.position.set(0.04, 1.1, 2); this.shell.add(f); }\n    if (this.key === 'main' && tier >= 4) { const st = buildModel('kenney-furniture/stairs', { catalog: MODELS, palette: { wood: 'orange', woodDark: 'red' } }).object; st.scale.setScalar(0.5); st.position.set(6.8, 0, 0.5); this.shell.add(st); this.markSolid(6.8, 0.5, 2, 1); }\n    this.placeItems();\n    this.built = true;\n  }\n  placeItems() {\n    const g = this.g;\n    if (this.itemsGroup) this.itemsGroup.removeFromParent();\n    this.itemsGroup = new Group();\n    this.group.add(this.itemsGroup);\n    this.lamps = [];\n    this.ensureSolid();\n    this.stopMirrors();\n    this.itemViews = new Map();\n    this.funcItems = [];\n    for (const item of this.roomData.items) this.addItemView(item);\n  }\n  addItemView(item) {\n    const it = ITEMS[item.id];\n    if (!it) return;\n    const o = buildModel(it.model, { catalog: MODELS, palette: it.palette ?? undefined, params: it.params }).object;\n    o.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } });\n    const rotated = item.rot % 2 === 1;\n    const w = rotated ? it.d : it.w, d = rotated ? it.w : it.d;\n    o.position.set(item.x + w / 2, 0, item.z + d / 2);\n    o.rotation.y = (item.rot * Math.PI) / 2;\n    const group = new Group();\n    group.add(o);\n    this.itemsGroup.add(group);\n    this.itemViews.set(item, group);\n    if (!it.flat) for (let z = item.z; z < item.z + d; z++) for (let x = item.x; x < item.x + w; x++) if (x >= 0 && z >= 0 && x < this.w && z < this.d) this.solid[z * this.w + x] = 1;\n    if (it.func) {\n      this.funcItems.push({ item, it, x: item.x + w / 2, z: item.z + d / 2, w, d, o, group });\n      if (it.func === 'tank' || it.func === 'cage') this.addCreatures(item, group, item.x + w / 2, item.z + d / 2);\n      if (it.func === 'tv') this.attachTV(item, group, item.x + w / 2, item.z + d / 2);\n      if (it.func === 'mirror') this.attachMirror(item, group, item.x + w / 2, item.z + d / 2);\n    }\n  }\n  addCreatures(item, group, cx, cz) {\n    const list = this.g.world.home[item.id === 'fishTank' ? 'tankFish' : 'cageBugs'];\n    let i = 0;\n    for (const id of Object.keys(list)) {\n      const e = ITEMS[id];\n      const m = item.id === 'fishTank' ? buildModel('fish', { catalog: MODELS, params: { len: FISH_LEN[e.size ?? 'S'] * 0.4 }, palette: { body: e.color } }).object : buildModel('bug', { catalog: MODELS, params: { size: 0.2 }, palette: { body: e.color } }).object;\n      m.position.set(cx, 0.9, cz);\n      group.add(m);\n      this.movers.push({ o: m, kind: item.id === 'fishTank' ? 'swim' : 'crawl', cx, cz, cy: 0.9, t: i++ * 1.7, r: 0.45 });\n    }\n  }\n  attachTV(item, group, cx, cz) {\n    const g = this.g;\n    if (!this.tvView) {\n      this.tvView = new RenderView({ size: [64, 40], fov: 42, every: 3 });\n      this.tvView.camera.position.set(24, 7, 52);\n      this.tvView.camera.lookAt(24, 0.6, 38);\n    }\n    const screen = new Mesh(new BoxGeometry(0.5, 0.34, 0.02), this.tvView.screenMaterial());\n    screen.position.set(cx, 0.36, cz + 0.28);\n    RenderView.screen(screen);\n    group.add(screen);\n    this.tvScreen = screen;\n  }\n  attachMirror(item, group, cx, cz) {\n    const m = new Mirror({ size: [0.8, 1.6], tintAmount: 0.12 });\n    m.mesh.position.set(cx, 1.0, cz + 0.2);\n    group.add(m.mesh);\n    this.mirrors = this.mirrors ?? [];\n    this.mirrors.push(m);\n  }\n  stopMirrors() {\n    for (const s of this.mirrorStops ?? []) s();\n    this.mirrorStops = [];\n    if (this.tvStop) { this.tvStop(); this.tvStop = null; }\n    for (const m of this.mirrors ?? []) m.dispose();\n    this.mirrors = [];\n    this.movers = [];\n  }\n  attachViews() {\n    const g = this.g;\n    for (const m of this.mirrors ?? []) this.mirrorStops.push(m.attach(g.engine.renderer, g.ctx.scene));\n    if (this.tvView && this.hasFunc('tv')) { this.tvStop = this.tvView.attach(g.engine.renderer, g.ctx.scene); g.town.group.visible = true; }\n  }\n  enter(g) {\n    this.rebuild();\n    this.syncLamps();\n    this.attachViews();\n    this.buildDust();\n  }\n  leave(g) {\n    this.stopMirrors();\n    for (const l of this.lightsReq) l.release();\n    this.lightsReq = [];\n    if (this.key === 'main' || this.g.place?.kind !== 'room') this.g.town.group.visible = false;\n  }\n  buildDust() {\n    const g = this.g;\n    if (this.key !== 'main') return;\n    if (this.dustGroup) this.dustGroup.removeFromParent();\n    this.dustGroup = new Group();\n    this.group.add(this.dustGroup);\n    this.dust = [];\n    for (const d of g.world.home.dust) {\n      const m = new Mesh(new BoxGeometry(0.3, 0.2, 0.3), toonMaterial(PALETTE.mist));\n      const eye = new Mesh(new BoxGeometry(0.05, 0.05, 0.02), toonMaterial(PALETTE.ink));\n      eye.position.set(0.06, 0.04, 0.16);\n      m.add(eye);\n      m.position.set(d.x, 0.14, d.z);\n      this.dustGroup.add(m);\n      this.dust.push({ d, m, t: d.x });\n    }\n  }\n  syncLamps() {\n    const g = this.g;\n    for (const l of this.lightsReq) l.release();\n    this.lightsReq = [];\n    for (const f of this.funcItems ?? []) {\n      if (f.it.func === 'lamp' && f.item.on !== false) {\n        const col = f.it.palette?.lamp === 'cyan' ? 0x73eff7 : f.it.palette?.lamp === 'lime' ? 0xa7f070 : 0xffd9a0;\n        this.lightsReq.push(g.ctx.lights.request({ position: [f.x + 1000, 1.6, f.z], color: col, intensity: 8, radius: 7 }));\n      }\n    }\n  }\n  /** The room as seen by the interact system. */\n  interactables() {\n    const out = [...this.interactList];\n    const g = this.g;\n    for (const f of this.funcItems ?? []) {\n      const lab = { lamp: f.item.on === false ? 'Turn the lamp on' : 'Turn the lamp off', seat: `Sit on ${f.it.name}`, bed: 'Go to bed', stereo: 'Stereo', tv: 'Watch the plaza', mirror: 'Mirror', tank: 'Fish tank', cage: 'Bug cage', clock: 'Check the clock', toilet: 'Flush', plant: 'Water the plant', rug: null }[f.it.func];\n      if (lab) out.push({ id: `fn:${f.item.id}:${f.x},${f.z}`, x: f.x, z: f.z, r: 0.9 + Math.max(f.w, f.d) / 2, label: lab, act: 'furniture', furn: f });\n    }\n    if (g.world.player.homeTier >= 1 && this.key === 'main') {\n      out.push({ id: 'placement', x: this.w - 1, z: this.d - 1.6, r: 1.2, label: 'Arrange furniture', act: 'arrange' });\n    }\n    return out;\n  }\n  extraUpdate(dt, t) {\n    if (!this.dust) return;\n    const p = this.g.player;\n    for (const b of this.dust) {\n      b.t += dt;\n      const dx = b.d.x - p.x, dz = b.d.z - p.z;\n      const dist = Math.hypot(dx, dz);\n      if (dist < 2.2 && dist > 0.01) {\n        b.d.x = Math.max(0.5, Math.min(this.w - 0.5, b.d.x + (dx / dist) * dt * 1.6));\n        b.d.z = Math.max(0.5, Math.min(this.d - 0.8, b.d.z + (dz / dist) * dt * 1.6));\n      } else {\n        b.d.x = Math.max(0.5, Math.min(this.w - 0.5, b.d.x + Math.sin(b.t * 1.1) * dt * 0.3));\n      }\n      b.m.position.set(b.d.x, 0.14 + Math.abs(Math.sin(b.t * 7)) * 0.06, b.d.z);\n    }\n  }\n}\nexport { Vector3 };\nEOF\necho ok","description":"Write room builder, museum wings and the player's home"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13244,"cache_read_input_tokens":468296,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13244},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"d09f692e-6f37-4984-b5e3-6c04a9fa5bec","timestamp":"2026-11-06T01:04:59.211Z","request_id":"req_011Cgkmnk3VUGuZnGN15Z6YH","wire_tool_inputs":{"toolu_01EqSyJ1CLSxjZBnQWiJmt4w":{"command":"cat > src/world/rooms.js <<'EOF'\n// Every interior: a dollhouse cutaway with two back walls. Built from data in data/rooms.js.\nimport { THREE, buildModel, toonMaterial, PALETTE, textureMap, setLookLayer, glowMaterial, Mirror, RenderView } from '../engine.js';\nimport { Place, circleBlocked } from './place.js';\nimport { MODELS } from '../art/models.js';\nimport { ROOMS } from '../data/rooms.js';\nimport { ITEMS } from '../data/items.js';\nimport { CRITTER_DEFS } from '../art/critter.js';\nimport { Actor } from '../actors/rig.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { dailyStock, mothwickStock } from '../systems/shop.js';\nimport { FISH_LEN } from '../data/fish.js';\nimport { FISH } from '../data/fish.js';\nimport { BUGS } from '../data/bugs.js';\nimport { FOSSILS } from '../data/fossils.js';\nimport { ART } from '../data/art.js';\nimport { paintingMaterial } from '../art/paintings.js';\n\nconst { BoxGeometry, Group, Mesh, PlaneGeometry, Vector3 } = THREE;\nconst ROOM_OX = 1000;\nconst WALL_H = 3.0;\n\nfunction surfaceMesh(w, d, texId) {\n  const g = new PlaneGeometry(w, d).rotateX(-Math.PI / 2);\n  const uv = g.attributes.uv.array;\n  for (let i = 0; i < uv.length; i += 2) { uv[i] *= w / 4; uv[i + 1] *= d / 4; }\n  const m = new Mesh(g, toonMaterial(PALETTE.white, { map: textureMap(texId) }));\n  m.receiveShadow = true;\n  return m;\n}\nfunction wallMesh(len, texId, axis) {\n  const g = new PlaneGeometry(len, WALL_H);\n  const uv = g.attributes.uv.array;\n  for (let i = 0; i < uv.length; i += 2) { uv[i] *= len / 4; uv[i + 1] *= WALL_H / 4; }\n  const m = new Mesh(g, toonMaterial(PALETTE.white, { map: textureMap(texId) }));\n  m.receiveShadow = true;\n  if (axis === 'w') m.rotation.y = Math.PI / 2;\n  return m;\n}\nconst build = (id, o = {}) => {\n  const obj = buildModel(id, { catalog: MODELS, ...o }).object;\n  obj.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } });\n  return obj;\n};\nconst box = (w, h, d, c) => { const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(typeof c === 'string' ? PALETTE[c] : c)); m.castShadow = true; m.receiveShadow = true; return m; };\n\nexport class RoomPlace extends Place {\n  constructor(g, id, def) {\n    super(id, 'room', { ox: ROOM_OX, oz: 0, name: def.name });\n    this.g = g;\n    this.def = def;\n    this.w = def.w; this.d = def.d;\n    this.camZoom = def.w > 10 ? 1.55 : def.w > 7 ? 1.75 : 2.0;\n    this.music = def.music ?? null;\n    this.owner = def.owner ?? null;\n    this.ownerSpot = def.ownerSpot ?? null;\n    this.lightsReq = [];\n    this.dyn = new Group();\n    this.group.add(this.dyn);\n    this.items = [];\n    this.movers = [];\n    this.actors = new Map();\n    this.built = false;\n    this.group.visible = false;\n  }\n  keepVisible() { return false; }\n  surfaceAt() { const f = this.def.floor ?? ''; return f.includes('carpet') || f.includes('moss') || f.includes('shag') ? 'stepGrass' : f.includes('marble') || f.includes('chess') || f.includes('kitchen') ? 'stepStone' : 'stepWood'; }\n  height() { return 0; }\n  ensureSolid() { this.solid = new Uint8Array(this.w * this.d); }\n  markSolid(x, z, sw, sd) {\n    const x0 = Math.max(0, Math.floor(x - sw / 2 + 0.01)), z0 = Math.max(0, Math.floor(z - sd / 2 + 0.01));\n    for (let j = z0; j < Math.min(this.d, z0 + sd); j++) for (let i = x0; i < Math.min(this.w, x0 + sw); i++) this.solid[j * this.w + i] = 1;\n  }\n  blocked(x, z) {\n    if (this.g.noclip) return x < 0.1 || z < 0.1 || x > this.w - 0.1 || z > this.d;\n    if (x < 0.25 || z < 0.25 || x > this.w - 0.25) return true;\n    const e = this.def.exit;\n    if (z > this.d - 0.25) { if (!e || Math.abs(x - e.x) > 1) return true; return z > this.d + 0.2; }\n    return this.solid[Math.floor(z) * this.w + Math.floor(x)] === 1;\n  }\n  // ---- building ------------------------------------------------------------------------------------\n  buildShell(wallTex, floorTex) {\n    if (this.shell) this.shell.removeFromParent();\n    const s = new Group();\n    const f = surfaceMesh(this.w, this.d, floorTex);\n    f.position.set(this.w / 2, 0, this.d / 2);\n    s.add(f);\n    const under = box(this.w + 0.4, 0.3, this.d + 0.4, 'ink');\n    under.position.set(this.w / 2, -0.17, this.d / 2);\n    s.add(under);\n    const n = wallMesh(this.w, wallTex, 'n');\n    n.position.set(this.w / 2, WALL_H / 2, 0);\n    s.add(n);\n    const wWall = wallMesh(this.d, wallTex, 'w');\n    wWall.position.set(0, WALL_H / 2, this.d / 2);\n    s.add(wWall);\n    const skirting = (len, axis) => { const m = box(axis === 'n' ? len : 0.1, 0.22, axis === 'n' ? 0.1 : len, 'plum'); m.position.set(axis === 'n' ? len / 2 : 0.05, 0.11, axis === 'n' ? 0.05 : len / 2); return m; };\n    s.add(skirting(this.w, 'n'), skirting(this.d, 'w'));\n    const top = (len, axis) => { const m = box(axis === 'n' ? len : 0.3, 0.1, axis === 'n' ? 0.3 : len, 'night'); m.position.set(axis === 'n' ? len / 2 : -0.15, WALL_H + 0.05, axis === 'n' ? -0.15 : len / 2); return m; };\n    s.add(top(this.w + 0.3, 'n'), top(this.d + 0.3, 'w'));\n    // back shells so the cutaway reads as solid from the camera's side\n    const bn = box(this.w + 0.3, WALL_H, 0.3, 'night'); bn.position.set(this.w / 2, WALL_H / 2, -0.15); s.add(bn);\n    const bw = box(0.3, WALL_H, this.d + 0.3, 'night'); bw.position.set(-0.15, WALL_H / 2, this.d / 2); s.add(bw);\n    // mat at the way out\n    const e = this.def.exit;\n    if (e) {\n      const mat = box(1.6, 0.03, 0.6, 'orange');\n      mat.position.set(e.x, 0.02, this.d - 0.3);\n      s.add(mat);\n    }\n    // doors on the back walls\n    for (const door of this.def.doors ?? []) {\n      const frame = box(door.wall === 'n' ? 1.3 : 0.06, 2.2, door.wall === 'n' ? 0.06 : 1.3, 'plum');\n      frame.position.set(door.wall === 'n' ? door.x : 0.04, 1.1, door.wall === 'n' ? 0.04 : door.z);\n      const leaf = box(door.wall === 'n' ? 1.05 : 0.08, 2.0, door.wall === 'n' ? 0.08 : 1.05, 'ink');\n      leaf.position.set(door.wall === 'n' ? door.x : 0.05, 1.0, door.wall === 'n' ? 0.05 : door.z);\n      s.add(frame, leaf);\n    }\n    this.shell = s;\n    this.group.add(s);\n  }\n  placeProp(p, parent = this.group) {\n    const o = build(p.m, { params: p.params, palette: p.palette, seed: p.seed });\n    o.position.set(p.x, p.y ?? 0, p.z);\n    o.rotation.y = ((p.rot ?? 0) * Math.PI) / 180;\n    if (p.scale) o.scale.setScalar(p.scale);\n    parent.add(o);\n    return o;\n  }\n  buildProps() {\n    this.ensureSolid();\n    if (this.propsGroup) this.propsGroup.removeFromParent();\n    this.propsGroup = new Group();\n    this.group.add(this.propsGroup);\n    this.interactList = [];\n    this.lamps = [];\n    for (const p of this.def.props ?? []) {\n      this.placeProp(p, this.propsGroup);\n      if (p.solid) this.markSolid(p.x, p.z, p.solid[0], p.solid[1]);\n      if (p.act) this.interactList.push({ id: `${p.act}:${p.x},${p.z}`, x: p.x, z: p.z, r: p.r ?? 1.3, label: p.label ?? 'Look', act: p.act, prop: p, talkTo: p.talkTo });\n      if (p.light) this.lamps.push({ x: p.x, z: p.z, y: (p.y ?? 0) + 1.7 });\n    }\n    if (this.def.corkboard) {\n      const cb = box(2.4, 1.4, 0.05, 'orange'); cb.position.set(2.4, 1.7, 0.05); this.propsGroup.add(cb);\n      for (const [x, y, c] of [[1.6, 2.1, 'white'], [2.2, 1.5, 'sand'], [2.9, 2.0, 'white'], [3.2, 1.4, 'mist'], [1.9, 1.3, 'sand']]) { const n = box(0.34, 0.26, 0.04, c); n.position.set(x, y, 0.09); this.propsGroup.add(n); }\n      const string = (x0, y0, x1, y1) => { const len = Math.hypot(x1 - x0, y1 - y0); const m = box(len, 0.03, 0.03, 'red'); m.position.set((x0 + x1) / 2, (y0 + y1) / 2, 0.12); m.rotation.z = Math.atan2(y1 - y0, x1 - x0); this.propsGroup.add(m); };\n      string(1.6, 2.1, 2.2, 1.5); string(2.2, 1.5, 2.9, 2.0); string(2.9, 2.0, 3.2, 1.4); string(1.9, 1.3, 3.2, 1.4); string(1.6, 2.1, 2.9, 2.0);\n    }\n    if (this.def.host) this.buildHost();\n    this.built = true;\n  }\n  buildHost() {\n    const h = this.def.host;\n    if (this.host) return;\n    const a = new Actor(CRITTER_DEFS[h.id], { name: h.id, seed: h.id.length });\n    a.x = h.x; a.z = h.z; a.facing = h.face ?? 0;\n    a.addTo(this.group);\n    this.host = a;\n    this.hostId = h.id;\n    this.actors.set(h.id, a);\n    // A host you can talk to directly when no counter prop does it.\n    if (!(this.def.props ?? []).some((p) => p.talkTo === h.id)) this.interactList.push({ id: `host:${h.id}`, x: h.x, z: h.z, r: 1.5, label: `Talk to ${hostName(h.id)}`, act: 'hostTalk', talkTo: h.id });\n  }\n  hostActor(id) { return this.actors.get(id) ?? null; }\n  enter(g) {\n    if (!this.built) { this.buildShell(this.def.wall, this.def.floor); this.buildProps(); }\n    this.refreshDynamic();\n    this.lightsReq = (this.lamps ?? []).map((l) => g.ctx.lights.request({ position: [l.x + ROOM_OX, l.y, l.z], color: 0xffd9a0, intensity: 7, radius: 7 }));\n  }\n  leave() {\n    for (const l of this.lightsReq) l.release();\n    this.lightsReq = [];\n  }\n  refreshDynamic() {\n    const g = this.g;\n    this.dyn.clear();\n    this.dynInteract = [];\n    this.movers.length = 0;\n    this.ownerNow = null;\n    const def = this.def;\n    if (this.id === 'store') this.buildStock(dailyStock(g), def.stockSlots);\n    if (this.id === 'mothwick') this.buildStock(mothwickStock(g), def.stockSlots);\n    if (def.wing) this.buildWing(def.wing);\n    if (this.id === 'house_rocco') this.applyRoccoHouse();\n    if (def.easels) this.buildEasels();\n    if (this.id === 'auction') this.buildLot();\n  }\n  applyRoccoHouse() {\n    const g = this.g;\n    const gone = g.world.npcs.rocco.moved !== 'here';\n    this.owner = gone ? 'fitch' : 'rocco';\n    const leaving = g.world.npcs.rocco.moved === 'here' && g.world.flags.roccoBoxes;\n    if (gone || leaving) {\n      const spots = [[1, 3], [2.2, 4.4], [5, 1.2], [4.6, 4.6], [1.1, 1.6], [3.4, 4.8]];\n      for (const [x, z] of spots) { const b = build('kenney-furniture/cardboard-box-closed', { palette: { wood: 'sand', woodDark: 'orange' } }); b.position.set(x, 0, z); b.scale.setScalar(1.5); b.rotation.y = x; this.dyn.add(b); }\n    }\n  }\n  buildStock(stock, slots) {\n    const g = this.g;\n    stock.forEach((s, i) => {\n      if (i >= slots.length) return;\n      const [x, z] = slots[i];\n      const onShelf = this.nearShelf(x, z);\n      const it = ITEMS[s.id];\n      const prop = stockProp(s.id);\n      prop.position.set(x, onShelf ? 1.15 : 0, z);\n      this.dyn.add(prop);\n      if (!onShelf) this.markSolid(x, z, 1, 1);\n      this.dynInteract.push({ id: `stock:${i}`, x, z, r: 1.35, label: `Look at ${it.name}`, act: 'stockLook', stock: s, index: i, mesh: prop });\n    });\n  }\n  nearShelf(x, z) { return (this.def.props ?? []).some((p) => p.m === 'shelf' && Math.abs(p.z - z) < 1 && Math.abs(p.x - x) < 2.2 && (p.rot ? Math.abs(p.x - x) < 0.5 : Math.abs(p.z - z) < 0.5)); }\n  buildEasels() {\n    const g = this.g;\n    const stock = g.life.magdaStock();\n    this.def.easels.forEach(([x, z], i) => {\n      const s = stock[i];\n      if (!s) return;\n      this.markSolid(x, z, 1, 1);\n      const easel = new Group();\n      easel.position.set(x, 0, z);\n      const legs = box(0.08, 1.4, 0.08, 'plum'); legs.position.set(0, 0.7, 0); easel.add(legs);\n      const canvas = new Mesh(new BoxGeometry(1.12, 0.86, 0.05), paintingMaterial(s.id));\n      canvas.position.set(0, 1.4, 0.05);\n      easel.add(canvas);\n      const frame = box(1.24, 0.98, 0.04, 'sand'); frame.position.set(0, 1.4, 0.02); easel.add(frame);\n      easel.rotation.y = 0.5;\n      this.dyn.add(easel);\n      this.dynInteract.push({ id: `easel:${i}`, x, z, r: 1.5, label: `Look at ${ITEMS[s.id].name}`, act: 'magdaLook', stock: s });\n    });\n  }\n  buildLot() {\n    const lot = this.g.life.auctionLot?.();\n    if (!lot) return;\n    const it = ITEMS[lot.id];\n    const p = stockProp(lot.id);\n    p.position.set(5, 0.6, 2.6);\n    this.dyn.add(p);\n  }\n  // ---- Museum wings: every donation appears in place --------------------------------------------------\n  buildWing(wing) {\n    const g = this.g;\n    const m = g.world.museum[wing];\n    const addLook = (x, z, id, name, line) => this.dynInteract.push({ id: `wing:${id}`, x, z, r: 1.3, label: `Look at ${name}`, act: 'museumLook', lookName: name, line });\n    if (wing === 'fish') {\n      const slots = wingSlots(FISH.length, this.w, this.d);\n      FISH.forEach((f, i) => {\n        const [x, z] = slots[i];\n        const t = build('tank', { params: { w: 1.2 } });\n        t.position.set(x, 0, z);\n        this.dyn.add(t);\n        this.markSolid(x, z, 1, 1);\n        if (m[f.id]) {\n          const fm = build('fish', { params: { len: FISH_LEN[f.size] * 0.5 }, palette: { body: f.color } });\n          fm.position.set(x, 1, z);\n          this.dyn.add(fm);\n          this.movers.push({ o: fm, kind: 'swim', cx: x, cz: z, cy: 0.98, t: i * 1.3, r: 0.32 });\n          addLook(x, z, f.id, f.name, f.line);\n        } else {\n          this.dynInteract.push({ id: `wing:${f.id}`, x, z, r: 1.3, label: 'Empty tank', act: 'museumLook', lookName: 'An empty tank', line: 'A little brass plate says this one is expected. Dr. Quill has drawn a very hopeful fish on it.' });\n        }\n      });\n    } else if (wing === 'bug') {\n      const slots = wingSlots(BUGS.length, this.w, this.d);\n      BUGS.forEach((b, i) => {\n        const [x, z] = slots[i];\n        const t = build('tank', { params: { w: 1.0 }, palette: { water: 'green', frame: 'plum', sand: 'teal', top: 'plum' } });\n        t.position.set(x, 0, z);\n        this.dyn.add(t);\n        this.markSolid(x, z, 1, 1);\n        if (m[b.id]) {\n          const fm = b.kind === 'flier' ? build('winged', { params: { size: 0.34 }, palette: { wing: b.color === 'white' ? 'white' : b.color, spot: 'ink' } }) : build('bug', { params: { size: 0.24 }, palette: { body: b.color } });\n          fm.position.set(x, 1, z);\n          this.dyn.add(fm);\n          this.movers.push({ o: fm, kind: b.kind === 'flier' ? 'flutter' : 'crawl', cx: x, cz: z, cy: 0.98, t: i, r: 0.24 });\n          addLook(x, z, b.id, b.name, b.line);\n        } else this.dynInteract.push({ id: `wing:${b.id}`, x, z, r: 1.3, label: 'Empty case', act: 'museumLook', lookName: 'An empty case', line: \"Dr. Quill's note reads: 'something small, I think. Possibly with legs.'\" });\n      });\n    } else if (wing === 'fossil') {\n      const layout = { moatSkull: [3, 2], moatTorso: [4.8, 2], moatTail: [6.6, 2], regretSkull: [3, 5.4], regretNeck: [4.8, 5.4], regretTorso: [6.6, 5.4], trilobite: [9.8, 1.6], ammonite: [9.8, 3.2], amberFly: [9.8, 4.8], mysteryTooth: [9.8, 6.4] };\n      FOSSILS.forEach((f) => {\n        const [x, z] = layout[f.id];\n        const pl = build('plinth');\n        pl.position.set(x, 0, z);\n        pl.scale.set(f.set ? 1.6 : 1, 1, 1.4);\n        this.dyn.add(pl);\n        this.markSolid(x, z, 2, 1);\n        if (m[f.id]) {\n          const bone = build(f.model);\n          bone.position.set(x, 0.58, z);\n          if (f.set) bone.rotation.y = Math.PI / 2;\n          this.dyn.add(bone);\n          addLook(x, z, f.id, f.name, f.line);\n        } else this.dynInteract.push({ id: `wing:${f.id}`, x, z, r: 1.4, label: 'Empty plinth', act: 'museumLook', lookName: 'An empty plinth', line: 'It says \"COMING SOON\" in very small, very hopeful letters.' });\n      });\n    } else if (wing === 'art') {\n      const spots = [[2, 0.1, 'n'], [4.5, 0.1, 'n'], [7, 0.1, 'n'], [9.5, 0.1, 'n'], [0.1, 2, 'w'], [0.1, 4.2, 'w'], [0.1, 6.4, 'w'], [0.1, 8.4, 'w']];\n      ART.forEach((a, i) => {\n        const [x, z, side] = spots[i];\n        const frame = box(side === 'n' ? 1.6 : 0.06, 1.3, side === 'n' ? 0.06 : 1.6, 'sand');\n        frame.position.set(x, 1.8, z);\n        this.dyn.add(frame);\n        if (m[a.id]) {\n          const pic = new Mesh(new BoxGeometry(side === 'n' ? 1.4 : 0.04, 1.08, side === 'n' ? 0.04 : 1.4), paintingMaterial(a.id));\n          pic.position.set(side === 'n' ? x : x + 0.04, 1.8, side === 'n' ? z + 0.04 : z);\n          this.dyn.add(pic);\n          addLook(side === 'n' ? x : 1, side === 'n' ? 1 : z, a.id, a.name, a.line);\n        } else {\n          const pic = box(side === 'n' ? 1.4 : 0.04, 1.08, side === 'n' ? 0.04 : 1.4, 'night');\n          pic.position.set(side === 'n' ? x : x + 0.04, 1.8, side === 'n' ? z + 0.04 : z);\n          this.dyn.add(pic);\n        }\n      });\n    }\n    if (g.world.museum.plaques[wing]) {\n      const plaque = box(1.2, 0.5, 0.06, 'sand');\n      plaque.position.set(this.w - 1.2, 2.3, 0.1);\n      this.dyn.add(plaque);\n    }\n  }\n  /** Fish swim, bugs flutter, hosts idle. */\n  update(dt, t) {\n    for (const m of this.movers) {\n      m.t += dt;\n      if (m.kind === 'swim') {\n        m.o.position.x = m.cx + Math.sin(m.t * 0.7) * m.r;\n        m.o.position.z = m.cz + Math.sin(m.t * 1.3) * 0.1;\n        m.o.position.y = m.cy + Math.sin(m.t * 1.1) * 0.06;\n        m.o.rotation.y = Math.cos(m.t * 0.7) > 0 ? Math.PI / 2 : -Math.PI / 2;\n      } else if (m.kind === 'flutter') {\n        m.o.position.x = m.cx + Math.sin(m.t * 1.3) * m.r;\n        m.o.position.z = m.cz + Math.cos(m.t * 1.7) * 0.1;\n        m.o.position.y = m.cy + Math.abs(Math.sin(m.t * 2.3)) * 0.22;\n        const wl = m.o.getObjectByName('WingL'), wr = m.o.getObjectByName('WingR');\n        if (wl) wl.rotation.z = Math.sin(m.t * 22) * 0.8;\n        if (wr) wr.rotation.z = -Math.sin(m.t * 22) * 0.8;\n      } else if (m.kind === 'crawl') {\n        m.o.position.x = m.cx + Math.sin(m.t * 0.4) * m.r;\n      }\n    }\n    for (const a of this.actors.values()) {\n      if (!a.current || a.finished) a.play('Idle', 0.2);\n      a.update(dt);\n    }\n    this.extraUpdate?.(dt, t);\n  }\n  interactables() {\n    const out = [...(this.interactList ?? []), ...(this.dynInteract ?? [])];\n    const e = this.def.exit;\n    for (const door of this.def.doors ?? []) out.push({ id: `door:${door.to}`, x: door.wall === 'n' ? door.x : 0.8, z: door.wall === 'n' ? 0.8 : door.z, r: 1.3, label: `To the ${door.label}`, act: 'roomDoor', door });\n    return out;\n  }\n}\nconst hostName = (id) => ({ gander: 'Mrs. Gander', clementine: 'Clementine', quill: 'Dr. Quill', mothwick: 'Madame Mothwick', fleece: 'Monsieur Fleece', flavia: 'Flavia Rosé', magda: 'Magda', bellows: 'Sir Reginald', pemberton: 'Pemberton', brisket: 'Agent Brisket', lou: 'Languid Lou', nibbles: 'Madame Nibbles' }[id] ?? id);\nfunction wingSlots(n, w, d) {\n  const out = [];\n  for (let x = 1.5; x < w - 0.5 && out.length < n; x += 1.5) out.push([x, 0.9]);\n  for (let z = 2.4; z < d - 1.5 && out.length < n; z += 1.5) out.push([0.9, z]);\n  for (let z = 2.4; z < d - 1.5 && out.length < n; z += 1.5) out.push([w - 0.9, z]);\n  for (let x = 3.2; x < w - 2 && out.length < n; x += 1.5) out.push([x, 4.2]);\n  for (let x = 3.2; x < w - 2 && out.length < n; x += 1.5) out.push([x, 6.0]);\n  return out;\n}\n/** A small object standing for a stock item. */\nexport function stockProp(id) {\n  const it = ITEMS[id];\n  const g = new Group();\n  const c = it?.iconColors?.o ?? 'sand';\n  const add = (m, y = 0) => { m.position.y += y; g.add(m); return m; };\n  switch (it?.cat) {\n    case 'furniture': {\n      const o = build(it.model, { palette: it.palette ?? undefined, params: it.params });\n      const f = Math.max(it.w, it.d);\n      const s = 0.62 / Math.max(1, f * 0.7);\n      o.scale.setScalar(s);\n      add(o);\n      break;\n    }\n    case 'clothes': { const b = box(0.5, 0.52, 0.2, it.shirt); add(b, 0.45); const t = box(0.22, 0.08, 0.21, it.trim); add(t, 0.7); const stand = box(0.06, 0.2, 0.06, 'plum'); add(stand, 0.1); const arm = box(0.72, 0.16, 0.2, it.shirt); add(arm, 0.6); break; }\n    case 'hat': { const b = box(0.36, 0.24, 0.36, it.hatColor); add(b, 0.32); add(box(0.56, 0.05, 0.56, it.hatColor), 0.2); add(box(0.1, 0.2, 0.1, 'plum'), 0.1); break; }\n    case 'glasses': { add(box(0.5, 0.14, 0.04, it.glassesColor === 'white' ? 'mist' : it.glassesColor), 0.3); add(box(0.08, 0.2, 0.08, 'plum'), 0.1); break; }\n    case 'umbrella': { add(box(0.08, 0.7, 0.08, it.b), 0.35); add(box(0.5, 0.1, 0.5, it.a), 0.7); break; }\n    case 'wall': { add(box(0.5, 0.26, 0.26, 'sand'), 0.13); add(box(0.52, 0.04, 0.28, 'orange'), 0.14); break; }\n    case 'floor': { add(box(0.56, 0.14, 0.44, 'orange'), 0.07); add(box(0.56, 0.02, 0.44, 'plum'), 0.15); break; }\n    case 'tool': { const m = { net: 'tool-net', rod: 'tool-rod', shovel: 'tool-shovel', axe: 'tool-axe', can: 'tool-can', slingshot: 'tool-slingshot' }[id]; const o = build(m); o.rotation.z = 0.5; o.position.y = 0.3; g.add(o); break; }\n    case 'seed': { add(box(0.26, 0.34, 0.08, c), 0.17); add(box(0.26, 0.08, 0.09, 'white'), 0.26); break; }\n    case 'cheese': { const o = build('cheese-wheel'); add(o); break; }\n    case 'plant': { const o = build('sapling', { params: { stage: 0 } }); o.scale.setScalar(0.7); add(o); break; }\n    default: { add(box(0.3, 0.3, 0.3, c), 0.15); add(box(0.32, 0.08, 0.1, it?.iconColors?.x ?? 'orange'), 0.2); break; }\n  }\n  return g;\n}\nexport class RoomPlaces {\n  constructor(g) { this.g = g; this.map = new Map(); }\n  get(id) {\n    let r = this.map.get(id);\n    if (!r) {\n      const def = ROOMS[id];\n      if (!def && id.startsWith('home')) { r = new HomeRoom(this.g, id); }\n      else if (!def) throw new Error(`no room ${id}`);\n      else r = new RoomPlace(this.g, id, def);\n      this.map.set(id, r);\n      this.g.ctx.scene.add(r.group);\n    }\n    return r;\n  }\n}\n// ---- The player's home ------------------------------------------------------------------------------\nimport { HomeRoom } from './home.js';\nexport { circleBlocked, setLookLayer, glowMaterial, Mirror, RenderView, Vector3, NEIGHBOURS };\nEOF\ncat > src/world/home.js <<'EOF'\n// Your home: rooms by tier, real furniture on a 1 m grid, lamps, stereo, TV, mirror, fish tank.\nimport { THREE, buildModel, toonMaterial, PALETTE, Mirror, RenderView } from '../engine.js';\nimport { RoomPlace } from './rooms.js';\nimport { ITEMS } from '../data/items.js';\nimport { MODELS } from '../art/models.js';\nimport { BUILDINGS } from '../data/town.js';\nimport { FISH_LEN } from '../data/fish.js';\n\nconst { Group, Mesh, BoxGeometry, Vector3 } = THREE;\nconst HOME_DOOR = BUILDINGS.find((b) => b.id === 'home').door;\nexport const HOME_SIZES = { 1: { main: [6, 6] }, 2: { main: [8, 8] }, 3: { main: [8, 8], annex: [6, 6] }, 4: { main: [8, 8], annex: [6, 6], upstairs: [8, 8] } };\nconst roomKey = (id) => (id === 'home' ? 'main' : id.replace('home_', ''));\n\nexport class HomeRoom extends RoomPlace {\n  constructor(g, id) {\n    const key = roomKey(id);\n    const def = { name: 'Your Home', wall: 'wall-plaster', floor: 'floor-oak', w: 8, d: 8, props: [], home: true };\n    super(g, id, def);\n    this.key = key;\n    this.music = (gg) => gg.world.home.stereo ? gg.world.home.stereo : gg.world.home.dust?.length ? null : null;\n  }\n  get roomData() { return this.g.world.home.rooms[this.key]; }\n  keepVisible(old) { return old === this.g.town && this.hasFunc('tv'); }\n  hasFunc(f) { return this.roomData.items.some((i) => ITEMS[i.id]?.func === f); }\n  rebuild() {\n    const g = this.g;\n    const tier = g.world.player.homeTier;\n    const size = HOME_SIZES[tier][this.key] ?? [6, 6];\n    this.w = size[0]; this.d = size[1];\n    this.camZoom = this.w > 6 ? 1.75 : 2.0;\n    const e = this.key === 'main' ? { x: this.w / 2, z: this.d - 0.5, to: 'town', tx: HOME_DOOR[0], tz: HOME_DOOR[1] + 0.6, facing: 0 } : this.key === 'annex' ? { x: this.w / 2, z: this.d - 0.5, to: 'home', tx: 1.1, tz: 2, facing: 1.57 } : { x: this.w / 2, z: this.d - 0.5, to: 'home', tx: 6.8, tz: 2, facing: 0 };\n    this.def.exit = e;\n    this.def.w = this.w; this.def.d = this.d;\n    const rd = this.roomData;\n    this.def.wall = rd.wall; this.def.floor = rd.floor;\n    this.buildShell(rd.wall, rd.floor);\n    this.ensureSolid();\n    this.interactList = [];\n    if (this.key === 'main' && tier >= 3) this.interactList.push({ id: 'toAnnex', x: 0.8, z: 2, r: 1.2, label: 'To the annex', act: 'roomDoor', door: { to: 'home_annex', tx: 3, tz: 5, label: 'annex' } });\n    if (this.key === 'main' && tier >= 4) this.interactList.push({ id: 'toUp', x: 6.8, z: 0.8, r: 1.2, label: 'Upstairs', act: 'roomDoor', door: { to: 'home_upstairs', tx: 4, tz: 7, label: 'upstairs' } });\n    if (this.key === 'main' && tier >= 3) { const f = new Mesh(new BoxGeometry(0.06, 2.2, 1.3), toonMaterial(PALETTE.plum)); f.position.set(0.04, 1.1, 2); this.shell.add(f); }\n    if (this.key === 'main' && tier >= 4) { const st = buildModel('kenney-furniture/stairs', { catalog: MODELS, palette: { wood: 'orange', woodDark: 'red' } }).object; st.scale.setScalar(0.5); st.position.set(6.8, 0, 0.5); this.shell.add(st); this.markSolid(6.8, 0.5, 2, 1); }\n    this.placeItems();\n    this.built = true;\n  }\n  placeItems() {\n    const g = this.g;\n    if (this.itemsGroup) this.itemsGroup.removeFromParent();\n    this.itemsGroup = new Group();\n    this.group.add(this.itemsGroup);\n    this.lamps = [];\n    this.ensureSolid();\n    this.stopMirrors();\n    this.itemViews = new Map();\n    this.funcItems = [];\n    for (const item of this.roomData.items) this.addItemView(item);\n  }\n  addItemView(item) {\n    const it = ITEMS[item.id];\n    if (!it) return;\n    const o = buildModel(it.model, { catalog: MODELS, palette: it.palette ?? undefined, params: it.params }).object;\n    o.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } });\n    const rotated = item.rot % 2 === 1;\n    const w = rotated ? it.d : it.w, d = rotated ? it.w : it.d;\n    o.position.set(item.x + w / 2, 0, item.z + d / 2);\n    o.rotation.y = (item.rot * Math.PI) / 2;\n    const group = new Group();\n    group.add(o);\n    this.itemsGroup.add(group);\n    this.itemViews.set(item, group);\n    if (!it.flat) for (let z = item.z; z < item.z + d; z++) for (let x = item.x; x < item.x + w; x++) if (x >= 0 && z >= 0 && x < this.w && z < this.d) this.solid[z * this.w + x] = 1;\n    if (it.func) {\n      this.funcItems.push({ item, it, x: item.x + w / 2, z: item.z + d / 2, w, d, o, group });\n      if (it.func === 'tank' || it.func === 'cage') this.addCreatures(item, group, item.x + w / 2, item.z + d / 2);\n      if (it.func === 'tv') this.attachTV(item, group, item.x + w / 2, item.z + d / 2);\n      if (it.func === 'mirror') this.attachMirror(item, group, item.x + w / 2, item.z + d / 2);\n    }\n  }\n  addCreatures(item, group, cx, cz) {\n    const list = this.g.world.home[item.id === 'fishTank' ? 'tankFish' : 'cageBugs'];\n    let i = 0;\n    for (const id of Object.keys(list)) {\n      const e = ITEMS[id];\n      const m = item.id === 'fishTank' ? buildModel('fish', { catalog: MODELS, params: { len: FISH_LEN[e.size ?? 'S'] * 0.4 }, palette: { body: e.color } }).object : buildModel('bug', { catalog: MODELS, params: { size: 0.2 }, palette: { body: e.color } }).object;\n      m.position.set(cx, 0.9, cz);\n      group.add(m);\n      this.movers.push({ o: m, kind: item.id === 'fishTank' ? 'swim' : 'crawl', cx, cz, cy: 0.9, t: i++ * 1.7, r: 0.45 });\n    }\n  }\n  attachTV(item, group, cx, cz) {\n    const g = this.g;\n    if (!this.tvView) {\n      this.tvView = new RenderView({ size: [64, 40], fov: 42, every: 3 });\n      this.tvView.camera.position.set(24, 7, 52);\n      this.tvView.camera.lookAt(24, 0.6, 38);\n    }\n    const screen = new Mesh(new BoxGeometry(0.5, 0.34, 0.02), this.tvView.screenMaterial());\n    screen.position.set(cx, 0.36, cz + 0.28);\n    RenderView.screen(screen);\n    group.add(screen);\n    this.tvScreen = screen;\n  }\n  attachMirror(item, group, cx, cz) {\n    const m = new Mirror({ size: [0.8, 1.6], tintAmount: 0.12 });\n    m.mesh.position.set(cx, 1.0, cz + 0.2);\n    group.add(m.mesh);\n    this.mirrors = this.mirrors ?? [];\n    this.mirrors.push(m);\n  }\n  stopMirrors() {\n    for (const s of this.mirrorStops ?? []) s();\n    this.mirrorStops = [];\n    if (this.tvStop) { this.tvStop(); this.tvStop = null; }\n    for (const m of this.mirrors ?? []) m.dispose();\n    this.mirrors = [];\n    this.movers = [];\n  }\n  attachViews() {\n    const g = this.g;\n    for (const m of this.mirrors ?? []) this.mirrorStops.push(m.attach(g.engine.renderer, g.ctx.scene));\n    if (this.tvView && this.hasFunc('tv')) { this.tvStop = this.tvView.attach(g.engine.renderer, g.ctx.scene); g.town.group.visible = true; }\n  }\n  enter(g) {\n    this.rebuild();\n    this.syncLamps();\n    this.attachViews();\n    this.buildDust();\n  }\n  leave(g) {\n    this.stopMirrors();\n    for (const l of this.lightsReq) l.release();\n    this.lightsReq = [];\n    if (this.key === 'main' || this.g.place?.kind !== 'room') this.g.town.group.visible = false;\n  }\n  buildDust() {\n    const g = this.g;\n    if (this.key !== 'main') return;\n    if (this.dustGroup) this.dustGroup.removeFromParent();\n    this.dustGroup = new Group();\n    this.group.add(this.dustGroup);\n    this.dust = [];\n    for (const d of g.world.home.dust) {\n      const m = new Mesh(new BoxGeometry(0.3, 0.2, 0.3), toonMaterial(PALETTE.mist));\n      const eye = new Mesh(new BoxGeometry(0.05, 0.05, 0.02), toonMaterial(PALETTE.ink));\n      eye.position.set(0.06, 0.04, 0.16);\n      m.add(eye);\n      m.position.set(d.x, 0.14, d.z);\n      this.dustGroup.add(m);\n      this.dust.push({ d, m, t: d.x });\n    }\n  }\n  syncLamps() {\n    const g = this.g;\n    for (const l of this.lightsReq) l.release();\n    this.lightsReq = [];\n    for (const f of this.funcItems ?? []) {\n      if (f.it.func === 'lamp' && f.item.on !== false) {\n        const col = f.it.palette?.lamp === 'cyan' ? 0x73eff7 : f.it.palette?.lamp === 'lime' ? 0xa7f070 : 0xffd9a0;\n        this.lightsReq.push(g.ctx.lights.request({ position: [f.x + 1000, 1.6, f.z], color: col, intensity: 8, radius: 7 }));\n      }\n    }\n  }\n  /** The room as seen by the interact system. */\n  interactables() {\n    const out = [...this.interactList];\n    const g = this.g;\n    for (const f of this.funcItems ?? []) {\n      const lab = { lamp: f.item.on === false ? 'Turn the lamp on' : 'Turn the lamp off', seat: `Sit on ${f.it.name}`, bed: 'Go to bed', stereo: 'Stereo', tv: 'Watch the plaza', mirror: 'Mirror', tank: 'Fish tank', cage: 'Bug cage', clock: 'Check the clock', toilet: 'Flush', plant: 'Water the plant', rug: null }[f.it.func];\n      if (lab) out.push({ id: `fn:${f.item.id}:${f.x},${f.z}`, x: f.x, z: f.z, r: 0.9 + Math.max(f.w, f.d) / 2, label: lab, act: 'furniture', furn: f });\n    }\n    if (g.world.player.homeTier >= 1 && this.key === 'main') {\n      out.push({ id: 'placement', x: this.w - 1, z: this.d - 1.6, r: 1.2, label: 'Arrange furniture', act: 'arrange' });\n    }\n    return out;\n  }\n  extraUpdate(dt, t) {\n    if (!this.dust) return;\n    const p = this.g.player;\n    for (const b of this.dust) {\n      b.t += dt;\n      const dx = b.d.x - p.x, dz = b.d.z - p.z;\n      const dist = Math.hypot(dx, dz);\n      if (dist < 2.2 && dist > 0.01) {\n        b.d.x = Math.max(0.5, Math.min(this.w - 0.5, b.d.x + (dx / dist) * dt * 1.6));\n        b.d.z = Math.max(0.5, Math.min(this.d - 0.8, b.d.z + (dz / dist) * dt * 1.6));\n      } else {\n        b.d.x = Math.max(0.5, Math.min(this.w - 0.5, b.d.x + Math.sin(b.t * 1.1) * dt * 0.3));\n      }\n      b.m.position.set(b.d.x, 0.14 + Math.abs(Math.sin(b.t * 7)) * 0.06, b.d.z);\n    }\n  }\n}\nexport { Vector3 };\nEOF\necho ok","description":"Write room builder, museum wings and the player's home"}}}
