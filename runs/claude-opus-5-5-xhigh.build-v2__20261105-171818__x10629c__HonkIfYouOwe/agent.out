{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkoh5xdVdBkGYHuVLu9q","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13353,"cache_read_input_tokens":665467,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13353},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"44124ee4-1de6-436a-a225-e2bb2d23b6ad","timestamp":"2026-11-06T01:27:45.930Z","request_id":"req_011Cgkoh5i1JxdehkWLddcYy","thinking_duration_ms":1647,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkoh5xdVdBkGYHuVLu9q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019Ud4Stjiop85Pg2xqfW4BQ","name":"Bash","input":{"command":"cat > src/systems/newgame.js <<'EOF'\n// Starting, continuing and leaving: world resets, the night bus in, Mrs. Gander at the stop, Inspector Pimm.\nimport { newWorld, loadWorld, saveWorld, SAVE_KEY, clearSave } from '../core/save.js';\nimport { hash32 } from '../core/rng.js';\nimport { say, ask, narrate } from './say.js';\nimport { keyboardFlow } from '../ui/screens/keyboard.js';\nimport { lookEditor } from '../ui/screens/lookEditor.js';\nimport { prepareDayOne } from './dayone.js';\nimport { dailyRespawn, handleAbsence } from './flow.js';\nimport { rebuildAllObjects } from '../world/objectsView.js';\nimport { BusPlace } from './bus.js';\nimport { LANDMARKS } from '../data/town.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { markSessionOpen, markSessionClean, lastSessionUnclean, saveNow } from './session.js';\nimport { titleScreen } from '../ui/screens/title.js';\nimport { hourNow } from './time.js';\nimport { dailyFavours } from './favours.js';\nimport { Actor } from '../actors/rig.js';\nimport { CRITTER_DEFS, HAIR_COLORS } from '../art/critter.js';\nimport { equip } from './tools.js';\nimport { deliverMail } from './mail.js';\nimport { cheeseDayReset } from './cheese.js';\n\nconst NAMES = ['Pip', 'Moss', 'Juniper', 'Wren', 'Ash', 'Bramble', 'Tuck', 'Fern', 'Quill', 'Sorrel', 'Basil', 'Hob'];\nconst TOWNS = ['Lower Nowhere', 'Much Owing', 'Little Regret', 'Bean Hollow', 'Far Enough', 'Dunhonkin', 'Upper Lateness', 'Pear Bottom'];\n\n/** Swap in a world and make the scene match it. */\nexport function installWorld(g, world) {\n  g.world = world;\n  g.scripts.cancelAll();\n  g.weatherKey = null;\n  g.lastHour = -1;\n  g.town.syncNav();\n  g.refreshSeason(true);\n  rebuildAllObjects(g.town);\n  g.rooms.reset();\n  g.town.refreshHome();\n  g.town.refreshStore();\n  g.player.applyLook();\n  g.life.resetDay();\n  g.festivals.resetDay();\n  g.npcs.scatter();\n  for (const n of g.npcs.all()) { n.talking = false; n.overrideClip = null; }\n  g.sky.placeChanged();\n  equip(g, world.player.tool);\n}\nexport function startNewGame(g, mode) {\n  const seed = g.opts.seed ?? hash32(`arrival:${g.ctx.time}:${g.realNow ?? 0}`);\n  const w = newWorld(seed, { mode });\n  g.ui.popAll();\n  g.mode = 'play';\n  g.demo = false;\n  g.camState.zoomOverride = undefined;\n  g.fixedCam = false;\n  g.ctx.engine.screen.set('fade', 1);\n  installWorld(g, w);\n  dailyRespawn(g);\n  rebuildAllObjects(g.town);\n  g.events.emit('newGame', { mode });\n  g.scripts.run(arrival(g), { name: 'arrival' });\n}\n/** Title → the night bus → the stop. Answers set your hair, colours and eyes. */\nfunction* arrival(g) {\n  const w = g.world;\n  w.clock.minute = 23 * 60;\n  w.flags.forceWeather = 'rain';\n  g.weatherKey = null;\n  g.hideHud = true;\n  const bus = g.busPlace ??= new BusPlace(g);\n  g.ctx.scene.add(bus.group);\n  bus.setScene(0, 1, { night: true });\n  g.swapPlace(bus, 0, 0, 0);\n  const p = g.player;\n  p.remove();\n  bus.bodyGroup.add(p.root);\n  p.x = 0.6; p.z = -0.8; p.y = 0.86; p.facing = Math.PI * 0.5;\n  p.sitting = true;\n  p.play('Sit', 0);\n  g.camFocus = { x: 1.5, y: 1.2, z: 0 };\n  g.camTeleport();\n  g.sky.apply();\n  bus.hester.play('Sit', 0);\n  g.ctx.engine.screen.reveal('fade', { duration: 1 });\n  yield 1.2;\n  g.sound('thunder');\n  yield* say(g, 'hester', [\"End of the line? Nobody gets off there on purpose.\"]);\n  yield* say(g, 'hester', [\"I'm Hester. I drive the bus. Who've I got?\"]);\n  w.player.name = yield* keyboardFlow(g, { title: 'What do they call you?', max: 12, random: NAMES, hint: 'Type, or use the grid. Suggest asks Hester to guess.' });\n  yield* say(g, 'hester', [`${w.player.name}. All right. I've heard worse. I've driven worse.`, \"And what's the town called? The one at the end? Nobody's ever told me. I only drive the bus.\"]);\n  w.player.town = yield* keyboardFlow(g, { title: \"What's the town called?\", max: 16, random: TOWNS, hint: \"It's up to you. It's always been up to someone.\" });\n  yield* say(g, 'hester', `${w.player.town}. Sounds about right. It's raining there. It's raining everywhere. I've checked.`);\n  const a = yield* ask(g, 'hester', 'So what are you running from?', ['The usual', 'Nothing, honest', 'A very large bill', 'My family']);\n  w.player.look.hair = [0, 3, 5, 4][a < 0 ? 0 : a];\n  const b = yield* ask(g, 'hester', 'Favourite weather?', ['Rain', 'Sun', 'Snow', 'I like a good fog']);\n  w.player.look.hairColor = ['navy', 'orange', 'white', 'plum'][b < 0 ? 0 : b];\n  const c = yield* ask(g, 'hester', 'How do you take bad news?', ['Sitting down', 'Very well', 'Loudly', 'I write a letter']);\n  w.player.look.eyes = [2, 1, 3, 0][c < 0 ? 0 : c];\n  p.applyLook();\n  p.play('Sit', 0);\n  yield* narrate(g, 'A wet face looks back at you from the bus window. Is that what you look like? You could do something about that. Now would be the time.');\n  yield* lookEditor(g, { title: 'The bus window' });\n  p.play('Sit', 0);\n  yield* say(g, 'hester', 'You look like someone who owes money.');\n  yield* say(g, 'hester', \"Here we are. Mind the step. There isn't a step. Mind it anyway.\");\n  g.sound('busBrake');\n  g.engine.screen.cover('iris', { duration: 0.6 });\n  yield 0.7;\n  // Morning, at the stop\n  p.sitting = false;\n  p.remove();\n  w.flags.forceWeather = null;\n  w.clock.minute = 8 * 60;\n  g.weatherKey = null;\n  prepareDayOne(g);\n  rebuildAllObjects(g.town);\n  dailyFavours(g);\n  g.swapPlace(g.town, LANDMARKS.busStop[0] + 1, LANDMARKS.busStop[1] + 0.3, Math.PI / 2);\n  g.lastHour = hourNow(w);\n  g.npcs.scatter();\n  g.life.resetDay();\n  g.hideHud = false;\n  const gander = new Actor(CRITTER_DEFS.gander, { name: 'gander', seed: 4 });\n  gander.addTo(g.town.group);\n  gander.x = LANDMARKS.busStop[0] + 3; gander.z = LANDMARKS.busStop[1] + 0.3; gander.facing = -Math.PI / 2;\n  g.townGander = gander;\n  g.engine.screen.reveal('iris', { duration: 0.6 });\n  g.actorOverride = { gander };\n  yield 0.8;\n  gander.play('Honk', 0.1, { once: true });\n  g.sound('honk');\n  yield* say(g, 'gander', [\"You're late. No, you're exactly on time. I've already billed you for being late.\", `Mrs. Gander. I own the store, the road you're standing on, and as of ninety seconds ago, a good part of you, ${w.player.name} dear.`, \"Your new home is this way. Do keep up. I'm charging by the minute.\"]);\n  g.engine.screen.cover('iris', { duration: 0.5 });\n  yield 0.6;\n  g.swapPlace(g.town, 69, 41.6, Math.PI);\n  gander.x = 66.4; gander.z = 41.2; gander.facing = Math.PI / 2;\n  g.engine.screen.reveal('iris', { duration: 0.5 });\n  yield 0.7;\n  yield* say(g, 'gander', [\"Here we are. The roof is included. The rain is complimentary. The 8,000 beans are not.\", \"I see you've no way to pay. How lovely. Put this apron on. You'll work some of it off with errands. Look at your list, dear. Top right.\"]);\n  w.player.look.outfit = 'apron';\n  p.applyLook();\n  g.sound('uiConfirm');\n  yield* say(g, 'gander', \"Dorrit has a parcel. Tavi has a net. Bartleby has a rod and would prefer not. The Mayor is around, slowly. Clementine at the Hall has the rest. Off you go. HONK. Pardon me. That was my indoor voice.\");\n  gander.remove();\n  g.townGander = null;\n  g.actorOverride = null;\n  markSessionOpen(g);\n  saveNow(g);\n  g.events.emit('arrived', {});\n}\nexport function continueGame(g) {\n  const w = loadWorld();\n  if (!w) { g.sound('uiError'); return; }\n  const unclean = lastSessionUnclean();\n  g.ui.popAll();\n  g.mode = 'play';\n  g.demo = false;\n  g.fixedCam = false;\n  g.camState.zoomOverride = undefined;\n  installWorld(g, w);\n  const place = w.player.place === 'town' || !w.player.place ? g.town : w.player.place === 'city' ? g.city : (w.player.place === 'bus' ? g.town : g.rooms.get(w.player.place));\n  g.place.group.visible = false;\n  g.swapPlace(place, w.player.x, w.player.z, w.player.facing);\n  if (g.realNow) handleAbsence(g, g.realNow);\n  deliverMail(g);\n  markSessionOpen(g);\n  g.events.emit('continued', {});\n  if (unclean) g.scripts.run(pimmVisit(g), { name: 'pimm' });\n}\n/** Inspector Pimm: three escalating monologues, then one last resigned one. */\nexport function* pimmVisit(g) {\n  const w = g.world;\n  w.pimm.visits += 1;\n  const v = w.pimm.visits;\n  const bank = v === 1 ? HOSTS.pimm.first : v === 2 ? HOSTS.pimm.second : v === 3 ? HOSTS.pimm.third : v === 4 ? HOSTS.pimm.last : null;\n  if (!bank) return;\n  yield 0.6;\n  const a = new Actor(CRITTER_DEFS.pimm, { name: 'pimm', seed: 11 });\n  a.addTo(g.place.group);\n  a.x = g.player.x + 6; a.z = g.player.z; a.y = g.place.height(g.player.x, g.player.z); a.facing = -Math.PI / 2;\n  a.play('PimmScuttle', 0);\n  g.actorOverride = { pimm: a };\n  g.pimmActor = a;\n  while (a.x > g.player.x + 1.6) { a.x -= 1 / 60 * 2.4; a.update(1 / 60); yield; }\n  a.play('Idle', 0.2);\n  g.player.faceToward(a.x, a.z);\n  yield* say(g, 'pimm', bank);\n  g.events.emit('pimm', { visit: v });\n  a.play('PimmScuttle', 0.2);\n  for (let i = 0; i < 120; i++) { a.x += 1 / 60 * 3; a.update(1 / 60); yield; }\n  a.remove();\n  g.pimmActor = null;\n  g.actorOverride = null;\n}\nexport function quitToTitle(g) {\n  g.ui.popAll();\n  g.scripts.cancelAll();\n  g.engine.screen.set('fade', 0);\n  g.goTitle();\n}\nexport { saveWorld, SAVE_KEY, clearSave, cheeseDayReset, HAIR_COLORS, titleScreen, markSessionClean };\nEOF\npython3 - <<'EOF'\np='src/game.js'\ns=open(p).read()\ns=s.replace(\"  actorOf(id) { return id === 'player' ? this.player : this.npcs.actor(id) ?? this.place?.hostActor?.(id) ?? null; }\",\"\"\"  actorOf(id) { return id === 'player' ? this.player : this.actorOverride?.[id] ?? this.npcs.actor(id) ?? this.place?.hostActor?.(id) ?? (id === 'trundle' ? this.life.trundle : id === 'rind' ? this.life.rind : id === 'vesper' ? this.life.vesper : id === 'hester' ? this.busPlace?.hester : null) ?? null; }\"\"\")\ns=s.replace(\"  newDay() { newDay(this); }\",\"\"\"  newDay() { newDay(this); }\n  openPlacement(i) { this.ui.push(placementScreen(this, i)); }\n  quitToTitle() { quitToTitle(this); }\n  /** Back to the live diorama on a throwaway world. */\n  goTitle() {\n    const w = newWorld(hash32('title-diorama'), { demo: true });\n    w.clock.minute = 9.5 * 60;\n    w.clock.day = 5;\n    w.player.tools = ['net', 'rod', 'shovel', 'axe', 'can', 'slingshot'];\n    this.mode = 'title';\n    this.demo = true;\n    this.place.group.visible = false;\n    this.place.leave?.(this);\n    this.player.remove();\n    this.place = this.town;\n    this.town.group.visible = true;\n    this.player.addTo(this.town.group);\n    installWorld(this, w);\n    dailyRespawn(this);\n    rebuildAllObjects(this.town);\n    this.player.x = 24; this.player.z = 30;\n    this.camState.zoomOverride = undefined;\n    this.camState.yawT = 45; this.camState.yaw = 45; this.camState.applied = '';\n    this.titleDrift = 0;\n    this.noInput = 0;\n    this.camFocus = { x: 24, y: 1, z: 40 };\n    this.updateCamera(1);\n    this.camTeleport();\n    this.music.refresh();\n    this.ui.push(titleScreen(this));\n  }\"\"\")\ns=s.replace(\"import { titleScreen } from './ui/screens/title.js';\",\"import { titleScreen } from './ui/screens/title.js';\\nimport { placementScreen } from './ui/screens/placement.js';\\nimport { installWorld, quitToTitle } from './systems/newgame.js';\\nimport { dailyRespawn } from './systems/flow.js';\")\n# title start: use goTitle equivalent\ns=s.replace(\"\"\"    this.player.x = 24; this.player.z = 30;\n    this.sky = new Sky(this);\"\"\",\"\"\"    this.player.x = 24; this.player.z = 30;\n    this.camFocus = { x: 24, y: 1, z: 40 };\n    this.sky = new Sky(this);\"\"\")\ns=s.replace(\"\"\"    this.life.resetDay();\n    this.mode = 'title';\n    this.ui.push(titleScreen(this));\n    this.camTeleport();\"\"\",\"\"\"    dailyRespawn(this);\n    rebuildAllObjects(this.town);\n    this.life.resetDay();\n    this.festivals.resetDay();\n    this.mode = 'title';\n    this.ui.push(titleScreen(this));\n    this.camTeleport();\"\"\")\ns=s.replace(\"\"\"    if (this.mode === 'attract') this.attract.update(dt);\"\"\",\"\"\"    if (this.mode === 'attract') this.attract.update(dt);\n    if (this.mode === 'title') this.updateTitle(dt);\"\"\")\ns=s.replace(\"\"\"  readCommands(ctx) {\"\"\",\"\"\"  updateTitle(dt) {\n    // The camera drifts over the diorama; after 10 quiet seconds the attract loop takes over.\n    this.titleDrift = (this.titleDrift ?? 0) + dt;\n    const t = this.titleDrift * 0.03;\n    this.camFocus = { x: 24 + Math.sin(t) * 16, y: 1, z: 40 + Math.cos(t * 1.3) * 8 };\n    const top = this.ui.top;\n    if (top?.isTitle && this.noInput >= 10) this.attract.start();\n  }\n  readCommands(ctx) {\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/dev/attract.js <<'EOF'\n// The attract loop: after 10 quiet seconds on the title, a looping AI-played demo on a throwaway save.\n// It cheats freely. Any input exits, at once. Its only job is to show as much as possible.\nimport { newWorld } from '../core/save.js';\nimport { drawText, panel } from '../ui/draw.js';\nimport { installWorld } from '../systems/newgame.js';\nimport { dailyRespawn } from '../systems/flow.js';\nimport { rebuildAllObjects } from '../world/objectsView.js';\nimport { villageDay } from '../core/calendar.js';\nimport { LANDMARKS, BUILDINGS } from '../data/town.js';\nimport { CITY_BUS_STOP } from '../world/city.js';\nimport { busRide } from '../systems/bus.js';\nimport { typeLine, hostLine } from '../systems/lines.js';\nimport { Dialogue } from '../ui/dialogue.js';\nimport { nameOf } from '../systems/say.js';\nimport { CLOTHES } from '../data/clothes.js';\nimport { ITEMS } from '../data/items.js';\nimport { titleScreen } from '../ui/screens/title.js';\nimport { drawLogo } from '../ui/screens/title.js';\nimport { FISH } from '../data/fish.js';\nimport { THREE, toonMaterial, PALETTE, buildModel } from '../engine.js';\nimport { MODELS } from '../art/models.js';\n\nconst BEAT = 7.5;\nexport class AttractMode {\n  constructor(g) { this.g = g; this.running = false; this.tune = null; this.t = 0; this.script = null; this.savedPlace = null; }\n  start() {\n    const g = this.g;\n    g.ui.popAll();\n    g.mode = 'attract';\n    this.running = true;\n    this.t = 0;\n    this.loops = (this.loops ?? 0) + 1;\n    const w = newWorld(777 + this.loops, { demo: true });\n    w.player.name = 'Pip'; w.player.town = 'Far Enough';\n    w.player.look.hair = 3; w.player.look.hairColor = 'orange'; w.player.look.outfit = 'plainRed'; w.player.look.hatItem = 'strawHat';\n    w.player.tools = ['net', 'rod', 'shovel', 'axe', 'can', 'slingshot'];\n    w.player.beans = 999999;\n    w.story.stage = 'free';\n    w.flags.shackRoof = true;\n    w.player.homeTier = 2;\n    w.museum.open = true;\n    g.demo = true;\n    this.goDay(1, 10);\n    g.world = w;\n    installWorld(g, w);\n    dailyRespawn(g);\n    rebuildAllObjects(g.town);\n    g.events.emit('attractStart', {});\n    this.beat = 0;\n    this.scene = this.play();\n    this.wait = 0;\n    this.scriptDone = false;\n    g.camFocus = null;\n    g.music.refresh();\n  }\n  goDay(day, hour) {\n    const g = this.g;\n    if (!g.world) return;\n    g.world.clock.day = day;\n    g.world.clock.minute = hour * 60;\n    g.weatherKey = null;\n    g.lastHour = -1;\n  }\n  /** Any input exits to the title at once. */\n  stop() {\n    const g = this.g;\n    if (!this.running) return;\n    this.running = false;\n    g.scripts.cancelAll();\n    g.ui.popAll();\n    g.engine.screen.set('iris', 0);\n    g.inTransition = false;\n    g.hideHud = false;\n    g.music.setOverride(null);\n    this.tune = null;\n    for (const m of this.extra ?? []) m.removeFromParent();\n    this.extra = [];\n    g.player.sitting = false;\n    g.player.poseTimer = 0;\n    g.player.poseClip = null;\n    g.player.locked = false;\n    g.events.emit('attractStop', {});\n    g.goTitle();\n  }\n  fixedStep(dt) { if (this.running) this.walk(dt); }\n  walk(dt) {\n    const g = this.g;\n    const p = g.player;\n    if (!this.dest) { p.speed = 0; return; }\n    const dx = this.dest.x - p.x, dz = this.dest.z - p.z;\n    const d = Math.hypot(dx, dz);\n    if (d < 0.25) { this.dest = null; p.speed = 0; return; }\n    const sp = this.dest.speed ?? 4.2;\n    p.x += (dx / d) * sp * dt; p.z += (dz / d) * sp * dt; // no clip: it may cheat\n    p.y = g.place.height(p.x, p.z);\n    p.speed = sp;\n    p.turnTo = Math.atan2(dx, dz);\n  }\n  update(dt) {\n    const g = this.g;\n    if (!this.running) return;\n    // Any input (key, button, stick, mouse move, tap) exits at once.\n    if (g.inp.any) { this.stop(); return; }\n    if (this.wait > 0) { this.wait -= dt; return; }\n    const r = this.scene.next();\n    if (r.done) { this.scene = this.play(); return; }\n    if (typeof r.value === 'number') this.wait = r.value;\n  }\n  say(who, text, dur = 3) {\n    const g = this.g;\n    g.ui.popAll();\n    const d = new Dialogue({ who, name: nameOf(who), voice: who, beats: [text] });\n    d.update = function (gg, inp, dt) { this.timer += dt * 40; while (this.timer >= 1 && this.shown < this.total) { this.timer -= 1; const ch = this.seq[this.pos++]; if (!ch) break; if (ch.beat) continue; this.shown++; if (ch.c !== ' ') { gg.voice.syllable(ch.c, this.voice, text); const a = gg.actorOf(this.who); if (a && /[aeiou]/i.test(ch.c)) a.talkAmp = 1; } } };\n    g.ui.push(d);\n    return dur;\n  }\n  iris() { const g = this.g; g.engine.screen.cover('iris', { duration: 0.2 }); return 0.22; }\n  reveal() { this.g.engine.screen.reveal('iris', { duration: 0.2 }); }\n  moveTo(place, x, z, facing = 0) { this.g.swapPlace(place, x, z, facing); }\n  setDay(day, hour) { this.goDay(day, hour); this.g.refreshSeason(true); this.g.sky.placeChanged(); this.g.life.resetDay(); this.g.festivals.resetDay(); this.g.npcs.scatter(); }\n  *play() {\n    const g = this.g;\n    const town = g.town;\n    const p = g.player;\n    const w = g.world;\n    // Tree shake\n    this.tune = null;\n    this.setDay(1, 10);\n    this.moveTo(town, 52, 11, Math.PI);\n    const treeKey = Object.keys(w.town.objects).find((k) => w.town.objects[k].k === 'tree' && w.town.objects[k].kind === 'pear');\n    const [tx, tz] = treeKey.split(',').map(Number);\n    p.x = tx + 0.5; p.z = tz + 1.5; p.facing = Math.PI;\n    g.camTeleport();\n    p.pose('ShakeTree');\n    yield 0.3;\n    g.life.shakeTree(treeKey, w.town.objects[treeKey]);\n    yield 2;\n    // Butterfly\n    p.hold('tool-net');\n    p.play('NetReady', 0.1);\n    this.moveTo(town, 18, 26, 0);\n    const butterfly = g.life.addBug(g.life.bugs[0]?.def ?? { id: 'cabbageButterfly', name: 'Butterfly', kind: 'flier', color: 'white', spot: 'flower', beans: 90, line: '' }, 19.5, 27, null);\n    yield 1;\n    p.pose('NetSweep');\n    g.sound('netSwing');\n    yield 0.3;\n    g.life.catchBug(butterfly);\n    p.pose('HoldUp', 1.4);\n    g.sound('reveal');\n    yield 2;\n    // Cast and catch\n    p.hold('tool-rod');\n    this.moveTo(town, 37.2, 22, Math.PI / 2);\n    p.pose('Cast');\n    g.sound('cast');\n    yield 0.5;\n    g.life.bobberMesh.visible = true;\n    g.life.bobberMesh.position.set(40, -0.2, 22);\n    g.sound('plop');\n    yield 1.4;\n    g.sound('nibble');\n    g.life.bobberMesh.position.y = -0.3;\n    yield 0.9;\n    g.life.bobberMesh.position.y = -0.5;\n    g.sound('bite');\n    g.ctx.particles.burst('splash', [40, -0.15, 22]);\n    yield 0.5;\n    g.life.bobberMesh.visible = false;\n    p.pose('HoldUp', 1.4);\n    g.sound('reveal');\n    yield this.say('player', 'You caught a pike! Someone should tell it about the other end of the hook.', 2.4);\n    g.ui.popAll();\n    // Fossil\n    p.hold('tool-shovel');\n    this.moveTo(town, 25, 30, 0);\n    p.pose('Dig');\n    g.sound('dig');\n    g.ctx.particles.burst('dirt', [25, 0.2, 31]);\n    yield 1.6;\n    p.pose('HoldUp', 1.2);\n    g.sound('reveal');\n    yield 1.6;\n    // Neighbour chat with voice\n    p.hold(null);\n    const n = g.npcs.get('bartleby');\n    n.inside = false; n.setPos(30, 35); g.npcs.syncVisibility(n); n.held = true;\n    const t = g.npcs.get('tavi');\n    t.inside = false; t.setPos(28, 35); g.npcs.syncVisibility(t); t.held = true;\n    this.moveTo(town, 29, 37, Math.PI);\n    t.actor.play('Wave', 0.1, { once: true });\n    yield this.say('tavi', 'I smiled at a rock today and I think it\\'s going really well, isn\\'t it?!', 3.2);\n    yield this.say('bartleby', \"You're standing in my good spot. No, there isn't another one. I'd prefer not.\", 3.2);\n    g.ui.popAll();\n    n.held = false; t.held = false;\n    // Store\n    yield this.iris();\n    const store = g.rooms.get('store');\n    this.moveTo(store, 6, 4.8, Math.PI);\n    this.reveal();\n    store.host?.play('Honk', 0.1, { once: true });\n    g.sound('honk');\n    yield this.say('gander', 'No rush on the payment, dear. I\\'ve simply noted the time you didn\\'t pay, and I\\'ll be noting it again tomorrow.', 3.6);\n    g.ui.popAll();\n    // Furnishing\n    yield this.iris();\n    w.home.rooms.main.items.push({ id: 'cottageSofa', x: 2, z: 1, rot: 0, on: true }, { id: 'cottageLamp', x: 1, z: 1, rot: 0, on: true }, { id: 'cottageRug', x: 3, z: 3, rot: 0, on: true }, { id: 'cottageTable', x: 3, z: 3, rot: 0, on: true }, { id: 'mossyPlant', x: 6, z: 1, rot: 0, on: true }, { id: 'stereo', x: 7, z: 1, rot: 0, on: true });\n    const home = g.rooms.get('home');\n    home.rebuild();\n    this.moveTo(home, 4, 5.5, Math.PI);\n    this.reveal();\n    yield 2.5;\n    p.play('Dance', 0.2);\n    yield 2;\n    // Museum donation\n    yield this.iris();\n    w.museum.fish = Object.fromEntries(FISH.slice(0, 12).map((f) => [f.id, true]));\n    const aq = g.rooms.get('museum_fish');\n    this.moveTo(aq, 6, 5.4, Math.PI);\n    this.reveal();\n    yield 3;\n    // Summer lanterns and fireworks\n    yield this.iris();\n    this.setDay(8, 20);\n    this.moveTo(town, 37, 26, Math.PI / 2);\n    g.festivals.launchLanterns('red');\n    for (const d of g.festivals.lanternData) d.t += 0.5;\n    this.reveal();\n    this.tune = 'festivalSummer';\n    g.music.refresh();\n    yield 3.4;\n    this.moveTo(town, 36, 52, 0);\n    g.camFocus = { x: 40, y: 2, z: 54 };\n    g.camTeleport();\n    for (let i = 0; i < 4; i++) { g.sound('fireworkBurst'); g.ctx.particles.burst('firework', [34 + i * 4, 11 + (i % 2) * 3, 62], { colors: [['red', 'sand', 'white'], ['sky', 'white', 'cyan'], ['lime', 'sand', 'white'], ['plum', 'orange', 'sand']][i] }); yield 0.9; }\n    g.camFocus = null;\n    this.tune = null;\n    // The bus singing\n    yield this.iris();\n    g.music.setOverride('bus');\n    const bus = g.busPlace ??= new (await_bus(g))(g);\n    g.ctx.scene.add(bus.group);\n    bus.setScene(g.season, g.calendarDay);\n    g.swapPlace(bus, 0, 0, 0);\n    p.remove();\n    bus.bodyGroup.add(p.root);\n    p.x = -1.2; p.z = -0.8; p.y = 0.86; p.facing = Math.PI / 2;\n    p.sitting = true;\n    p.play('Sit', 0);\n    g.camFocus = { x: 0, y: 1.2, z: 0 };\n    g.camTeleport();\n    this.reveal();\n    bus.hester.play('Talk', 0.2);\n    yield this.say('hester', '♪ Oh, you fished up an old boot and you sold it for ten, and you\\'d do it, you\\'d do it, you\\'d do it again… ♪', 3.8);\n    g.ui.popAll();\n    p.sitting = false;\n    p.remove();\n    bus.group.add(p.root);\n    // City neon\n    yield this.iris();\n    this.goDay(10, 21);\n    g.sky.placeChanged();\n    this.moveTo(g.city, 12, 11, 0);\n    g.music.setOverride('cityNight');\n    this.reveal();\n    this.dest = { x: 26, z: 11, speed: 3.4 };\n    yield 4;\n    // Salon, auction paddle\n    yield this.iris();\n    const salon = g.rooms.get('salon');\n    this.moveTo(salon, 4, 3.4, 0);\n    this.reveal();\n    g.music.setOverride('salon');\n    g.sound('scissors');\n    yield this.say('fleece', 'Monsieur! Madame! Whichever! Your hair, it speaks to me, and it is begging.', 2.6);\n    g.ui.popAll();\n    yield this.iris();\n    const auc = g.rooms.get('auction');\n    this.moveTo(auc, 5, 5.2, Math.PI);\n    this.reveal();\n    g.music.setOverride('auction');\n    p.play('Paddle', 0.05, { once: true });\n    g.sound('paddle');\n    yield this.say('pemberton', 'Going-once-going-twice-do-I-hear-more-oh-you\\'re-serious-SOLD!', 2.2);\n    g.sound('gavel');\n    g.ui.popAll();\n    g.music.setOverride(null);\n    // Soup\n    yield this.iris();\n    this.setDay(12, 13);\n    this.moveTo(town, 25, 44, Math.PI);\n    this.tune = 'festivalAutumn';\n    g.music.refresh();\n    this.reveal();\n    yield this.say('dorrit', 'That\\'s a soup, mmhm. That\\'s the soup. I\\'ve waited my whole life.', 3);\n    g.ui.popAll();\n    // Snowman\n    yield this.iris();\n    this.setDay(14, 11);\n    this.tune = null;\n    g.music.refresh();\n    w.town.objects['26,30'] = { k: 'snowman', ratio: 0.72, good: true };\n    town.dirty.add('26,30');\n    this.moveTo(town, 26, 33, Math.PI);\n    this.reveal();\n    p.play('Wave', 0.1, { once: true });\n    yield 3;\n    // Long Night\n    yield this.iris();\n    this.setDay(16, 23.9);\n    const [px, pz] = LANDMARKS.oldPear;\n    w.flags.pearLit = true;\n    town.seasonBuilt = -1;\n    g.refreshSeason(true);\n    this.moveTo(town, px + 0.5, pz + 4.6, Math.PI);\n    g.camFocus = { x: px, y: 2.4, z: pz + 1 };\n    g.camTeleport();\n    this.tune = 'festivalWinter';\n    g.music.refresh();\n    for (const [i, id] of ['dorrit', 'tavi', 'bartleby', 'ottoline', 'nib', 'yolanda', 'ozzie'].entries()) { const a = (i / 7) * Math.PI * 2; const nn = g.npcs.get(id); nn.inside = false; nn.setPos(px + Math.cos(a) * 4, pz + 1 + Math.sin(a) * 4); g.npcs.syncVisibility(nn); nn.overrideClip = 'Sway'; nn.actor.faceToward(px, pz); }\n    this.reveal();\n    yield 5;\n    for (const nn of g.npcs.all()) nn.overrideClip = null;\n    // Logo, and round again\n    g.camFocus = null;\n    this.showLogo = true;\n    this.tune = 'title';\n    g.music.refresh();\n    yield 3.5;\n    this.showLogo = false;\n    g.world = newWorld(777 + (++this.loops), { demo: true });\n    const nw = g.world;\n    nw.player.name = 'Pip'; nw.player.look = { ...w.player.look };\n    nw.player.tools = w.player.tools;\n    nw.player.beans = 999999; nw.flags.shackRoof = true; nw.player.homeTier = 2; nw.museum.open = true;\n    installWorld(g, nw);\n    dailyRespawn(g);\n    rebuildAllObjects(g.town);\n    this.reveal();\n  }\n  drawHud(hud) {\n    const g = this.g;\n    if (g.mode !== 'attract') return;\n    if (this.showLogo) drawLogo(g, hud);\n    const on = Math.floor(g.ctx.time * 1.6) % 2 === 0;\n    panel(hud, 12, 12, 40, 16, { fill: 'red', trim: 'orange' });\n    drawText(hud, 32, 17, 'DEMO', { align: 'center', color: 'white' });\n    if (on) {\n      const text = g.opts.touchOnly ? 'Controller or keyboard required' : 'Press anything to play';\n      const w = text.length * 6 + 14;\n      panel(hud, 240 - w / 2, 244, w, 16, { fill: 'navy', trim: 'sky' });\n      drawText(hud, 240, 249, text, { align: 'center', color: 'white' });\n    }\n  }\n}\nimport { BusPlace } from '../systems/bus.js';\nconst await_bus = () => BusPlace;\nexport { villageDay, BUILDINGS, CITY_BUS_STOP, busRide, typeLine, hostLine, CLOTHES, ITEMS, titleScreen, THREE, toonMaterial, PALETTE, buildModel, MODELS, BEAT };\nEOF\ncat > src/ui/screens/dev.js <<'EOF'\n// Dev mode: paged, pad-playable, still big type. Time, World, Player, Neighbours, Events, Collections, Debug, Save, Balance.\nimport { Menu } from '../ui.js';\nimport { TUNING, tuning, setTuning, resetTuning } from '../../dev/tuning.js';\nimport { advanceTo } from './bed.js';\nimport { calendar, FESTIVALS, CONTESTS, villageDay } from '../../core/calendar.js';\nimport { BUILDINGS, LANDMARKS } from '../../data/town.js';\nimport { NEIGHBOUR_ORDER, NEIGHBOURS } from '../../data/neighbours.js';\nimport { ITEMS } from '../../data/items.js';\nimport { addItem, addBeans } from '../../systems/economy.js';\nimport { TOOL_ORDER, grantTool } from '../../systems/tools.js';\nimport { FISH } from '../../data/fish.js';\nimport { BUGS } from '../../data/bugs.js';\nimport { FOSSILS } from '../../data/fossils.js';\nimport { ART } from '../../data/art.js';\nimport { ALL_EMOTES } from './emote.js';\nimport { saveNow } from '../../systems/session.js';\nimport { loadWorld, saveWorld, clearSave, migrate } from '../../core/save.js';\nimport { installWorld, pimmVisit } from '../../systems/newgame.js';\nimport { offerFavour } from '../../systems/favours.js';\nimport { roccoLeaves } from '../../systems/story.js';\nimport { rebuildAllObjects } from '../../world/objectsView.js';\nimport { CONSTELLATIONS } from '../../systems/stargaze.js';\nimport { CITY_DOORS } from '../../data/cityMap.js';\nimport { sendMail } from '../../systems/mail.js';\n\nconst refreshTime = (g) => { g.weatherKey = null; g.lastHour = -1; g.refreshSeason(true); g.sky.placeChanged(); g.life.placeSpecials(); g.festivals.resetDay(); g.npcs.scatter(); };\nconst pageMenu = (g, title, items) => {\n  const m = new Menu({ id: `dev:${title}`, title: `Dev: ${title}`, items: [...items, { label: 'Back', action: (gg, mm) => gg.ui.pop(mm) }], x: 60, y: 44, w: 360, itemH: 19, gap: 2, back: (gg, mm) => gg.ui.pop(mm), prompts: [['confirm', 'Do'], ['back', 'Back']] });\n  return m;\n};\nconst timePage = (g) => {\n  const w = g.world;\n  return pageMenu(g, 'Time', [\n    { label: 'Hour', value: () => Math.floor(w.clock.minute / 60), left: () => { w.clock.minute = (w.clock.minute + 1380) % 1440; refreshTime(g); }, right: () => { w.clock.minute = (w.clock.minute + 60) % 1440; refreshTime(g); }, action: () => {} },\n    { label: 'Next day', action: () => { advanceTo(g, w.clock.day + 1, 8 * 60); refreshTime(g); g.events.emit('devNextDay', {}); } },\n    { label: 'Set calendar day', value: () => villageDay(w.clock.day).calendarDay, left: () => { const d = villageDay(w.clock.day).calendarDay; advanceTo(g, w.clock.day + ((d + 14) % 16) + 0, w.clock.minute); refreshTime(g); }, right: () => { advanceTo(g, w.clock.day + 1, w.clock.minute); refreshTime(g); }, action: () => {} },\n    { label: 'Next season', action: () => { const d = villageDay(w.clock.day); advanceTo(g, w.clock.day + (4 - (d.calendarDay - 1) % 4), 8 * 60); refreshTime(g); } },\n    { label: 'Freeze time', value: () => (g.timeFrozen ? 'Yes' : 'No'), action: () => { g.timeFrozen = !g.timeFrozen; } },\n    { label: 'Clock mode', value: () => w.clock.mode, action: () => { w.clock.mode = w.clock.mode === 'real' ? 'village' : 'real'; g.weatherKey = null; refreshTime(g); } },\n  ]);\n};\nconst worldPage = (g) => {\n  const w = g.world;\n  const places = [['Plaza', g.town, 24, 41], ['Bus stop', g.town, 8.5, 29], ...BUILDINGS.map((b) => [b.name, g.town, b.door[0], b.door[1] + 0.6]), ...NEIGHBOUR_ORDER.map((id) => [NEIGHBOURS[id].name, null, id]), ['The City', g.city, 2.5, 10]];\n  return pageMenu(g, 'World', [\n    { label: 'Weather', value: () => w.flags.forceWeather ?? 'natural', action: () => { const list = [null, 'sun', 'rain', 'storm', 'fog', 'wind', 'snow', 'clear']; const i = list.indexOf(w.flags.forceWeather ?? null); w.flags.forceWeather = list[(i + 1) % list.length]; g.weatherKey = null; } },\n    { label: 'Teleport…', action: (gg) => gg.ui.push(pageMenu(gg, 'Teleport', places.map(([name, place, x, z]) => ({ label: name, action: (g2) => { g2.ui.popAll(); if (!place) { const a = g2.npcs.actor(x); g2.swapPlace(g2.town, a.x + 1, a.z + 1); } else g2.swapPlace(place, x, z); } })))) },\n    { label: 'No-clip', value: () => (g.noclip ? 'On' : 'Off'), action: () => { g.noclip = !g.noclip; } },\n    { label: 'Free camera', value: () => (g.freeCam ? 'On' : 'Off'), action: () => { g.freeCam = !g.freeCam; g.engine.setCamera(g.freeCam ? { preset: 'free' } : { preset: 'iso', yaw: 45, pitch: 35, zoom: 1.6, minZoom: 1.6, maxZoom: 1.6 }, { syncUrl: false }); g.fixedCam = g.freeCam; } },\n    { label: 'Zoom-out overview', value: () => (g.camState.zoomOverride === 0.6 ? 'On' : 'Off'), action: () => { g.camState.zoomOverride = g.camState.zoomOverride === 0.6 ? undefined : 0.6; } },\n  ]);\n};\nconst playerPage = (g) => {\n  const w = g.world;\n  const categories = ['fish', 'bug', 'fossil', 'art', 'furniture', 'clothes', 'hat', 'glasses', 'umbrella', 'fruit', 'seed', 'bag', 'cheese', 'record', 'wall', 'floor'];\n  return pageMenu(g, 'Player', [\n    { label: 'Beans', value: () => w.player.beans.toLocaleString('en-US'), left: () => addBeans(g, -10000), right: () => addBeans(g, 10000), action: () => addBeans(g, 100000) },\n    { label: 'Clear debt', value: () => w.player.debt.toLocaleString('en-US'), action: () => { w.player.debt = 0; } },\n    { label: 'Home tier', value: () => w.player.homeTier, left: () => { w.player.homeTier = Math.max(1, w.player.homeTier - 1); g.town.refreshHome(); g.rooms.reset(); }, right: () => { w.player.homeTier = Math.min(4, w.player.homeTier + 1); g.town.refreshHome(); g.rooms.reset(); }, action: () => {} },\n    { label: 'Give any item…', action: (gg) => gg.ui.push(pageMenu(gg, 'Give', categories.map((c) => ({ label: c, action: (g2) => { const ids = Object.keys(ITEMS).filter((id) => ITEMS[id].cat === c); g2.ui.push(pageMenu(g2, c, ids.map((id) => ({ label: ITEMS[id].name, action: (g3) => { addItem(g3, id); g3.sound('pickUp'); } })))); } })))) },\n    { label: 'All tools', action: () => { for (const t of TOOL_ORDER) if (!w.player.tools.includes(t)) w.player.tools.push(t); grantTool(g, 'net'); } },\n    { label: 'All emotes', action: () => { w.player.emotes = ALL_EMOTES.slice(); } },\n    { label: 'Empty pockets', action: () => { w.player.pockets.fill(null); } },\n  ]);\n};\nconst neighboursPage = (g) => pageMenu(g, 'Neighbours', [\n  ...NEIGHBOUR_ORDER.map((id) => ({ label: NEIGHBOURS[id].name, value: () => g.world.npcs[id].friend, left: () => { g.world.npcs[id].friend = Math.max(0, g.world.npcs[id].friend - 10); }, right: () => { g.world.npcs[id].friend = Math.min(100, g.world.npcs[id].friend + 10); }, action: () => { offerFavour(g, id); g.sound('uiConfirm'); } })),\n  { label: 'Move Rocco out, Fitch in, now', action: () => roccoLeaves(g) },\n  { label: 'Show routines', value: () => (g.overlay.npc ? 'On' : 'Off'), action: () => { g.overlay.npc = !g.overlay.npc; } },\n]);\nconst eventsPage = (g) => {\n  const w = g.world;\n  const go = (day, hour) => { const d = villageDay(w.clock.day).calendarDay; let add = (day - d + 16) % 16; if (add === 0 && hour * 60 < w.clock.minute) add = 16; advanceTo(g, w.clock.day + add, hour * 60); refreshTime(g); g.ui.popAll(); };\n  return pageMenu(g, 'Events', [\n    { label: 'The Seed Toss', action: () => go(4, 10) }, { label: 'The Lantern Float', action: () => go(8, 18) }, { label: 'The Great Soup', action: () => go(12, 13) }, { label: 'The Long Night', action: () => go(16, 20) },\n    { label: 'Fishing Derby', action: () => go(6, 10) }, { label: 'Bug-Off', action: () => go(10, 10) }, { label: 'Snowman Contest', action: () => go(14, 10) },\n    { label: 'Vesper, tonight', action: () => { w.flags.vesperForced = true; w.clock.minute = 20 * 60; refreshTime(g); g.ui.popAll(); } },\n    { label: 'Inspector Pimm', action: () => { g.ui.popAll(); g.scripts.run(pimmVisit(g), { name: 'pimm' }); } },\n    { label: 'Cheese day', action: () => { w.flags.rindForced = true; g.life.placeSpecials(); g.ui.popAll(); } },\n    { label: 'Wasps', action: () => { g.ui.popAll(); g.life.startWasps(g.player.x + 3, g.player.z + 3); } },\n    { label: 'A balloon', action: () => { g.ui.popAll(); const b = g.life.launchBalloon({ z: Math.floor(g.player.z), gift: 'bagOfBeans' }); b.x = g.player.x - 6; } },\n    { label: 'The ending', action: () => { go(16, 23.8); w.flags.lightsDoors = { a: 1, b: 1, c: 1, d: 1 }; } },\n  ]);\n};\nconst collectionsPage = (g) => {\n  const w = g.world;\n  const fill = (v) => {\n    for (const [list, wing] of [[FISH, 'fish'], [BUGS, 'bug'], [FOSSILS, 'fossil'], [ART, 'art']]) {\n      w.museum[wing] = v ? Object.fromEntries(list.map((x) => [x.id, true])) : {};\n      w.almanac[wing] = v ? Object.fromEntries(list.map((x) => [x.id, 1])) : {};\n    }\n    if (v) for (const c of CONSTELLATIONS) w.almanac.stars[c.id] = true; else w.almanac.stars = {};\n    g.rooms.reset();\n  };\n  return pageMenu(g, 'Collections', [{ label: 'Fill museum and Almanac', action: () => fill(true) }, { label: 'Empty museum and Almanac', action: () => fill(false) }]);\n};\nconst debugPage = (g) => pageMenu(g, 'Debug', [\n  { label: 'Collision tiles', value: () => (g.overlay.collision ? 'On' : 'Off'), action: () => { g.overlay.collision = !g.overlay.collision; } },\n  { label: 'Nav paths', value: () => (g.overlay.nav ? 'On' : 'Off'), action: () => { g.overlay.nav = !g.overlay.nav; } },\n  { label: 'Target', value: () => (g.overlay.target ? 'On' : 'Off'), action: () => { g.overlay.target = !g.overlay.target; } },\n  { label: 'Neighbour state', value: () => (g.overlay.npc ? 'On' : 'Off'), action: () => { g.overlay.npc = !g.overlay.npc; } },\n  { label: 'Engine state line', value: () => (g.overlay.engine ? 'On' : 'Off'), action: () => { g.overlay.engine = !g.overlay.engine; } },\n  { label: 'Look switcher', value: () => g.devLook ?? 'none', action: () => { const names = ['none', 'pixel_world', 'dream', 'cel_cartoon', 'neon_nights', 'storybook']; const i = names.indexOf(g.devLook ?? 'none'); g.devLook = names[(i + 1) % names.length]; g.engine.setLook(g.engine.lookPresets[g.devLook]); } },\n]);\nconst savePage = (g) => pageMenu(g, 'Save', [\n  { label: 'Save now', action: () => { if (g.demo) { g.ui.toastMsg('Not on a demo.'); return; } saveNow(g); g.ui.toastMsg('Saved.'); } },\n  { label: 'Load', action: () => { const w = loadWorld(); if (w) { installWorld(g, w); g.swapPlace(g.town, w.player.x, w.player.z); g.ui.popAll(); } else g.ui.toastMsg('Nothing saved.'); } },\n  { label: 'Reset save', action: () => { clearSave(); g.ui.toastMsg('The save is gone. The goose remembers.'); } },\n  { label: 'Export save (JSON)', action: () => exportText(g, JSON.stringify(g.world), 'honk-save.json') },\n  { label: 'Import save (JSON)', action: () => importText(g, (t) => { try { const w = migrate(JSON.parse(t)); saveWorld(w); installWorld(g, w); g.swapPlace(g.town, w.player.x, w.player.z); g.ui.popAll(); } catch { g.ui.toastMsg('That is not a save.'); } }) },\n  { label: 'Export recording', action: () => exportText(g, JSON.stringify(g.engine.recording()), 'honk-recording.json') },\n  { label: 'Replay this session', action: () => { const rec = g.engine.recording(); g.ui.popAll(); g.engine.replay(rec, () => g.engine.loadGame(new g.constructor(g.opts))).catch(() => g.ui.toastMsg('That replay did not take.')); } },\n]);\nfunction exportText(g, text, name) {\n  g.lastExport = text;\n  if (typeof document === 'undefined') { g.ui.toastMsg('Exported.'); return; }\n  const a = document.createElement('a');\n  a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));\n  a.download = name;\n  a.click();\n  g.ui.toastMsg(`Exported ${name}.`);\n}\nfunction importText(g, fn) {\n  if (typeof document === 'undefined') return;\n  const i = document.createElement('input');\n  i.type = 'file';\n  i.accept = '.json,application/json';\n  i.onchange = () => { const f = i.files[0]; if (f) f.text().then(fn); };\n  i.click();\n}\nconst balancePage = (g) => {\n  const items = TUNING.map((t) => ({\n    label: t.label,\n    value: () => { const v = tuning[t.id]; return Number.isInteger(t.step) ? v : v.toFixed(2); },\n    left: () => { setTuning(t.id, tuning[t.id] - t.step); g.sound('uiTick'); g.events.emit('tuningChanged', { id: t.id }); },\n    right: () => { setTuning(t.id, tuning[t.id] + t.step); g.sound('uiTick'); g.events.emit('tuningChanged', { id: t.id }); },\n    action: () => { resetTuning(t.id); g.sound('uiCancel'); },\n  }));\n  items.push({ label: 'Reset All', action: () => { resetTuning(); g.sound('uiConfirm'); g.ui.toastMsg('All sliders back to their defaults.'); } });\n  const m = pageMenu(g, 'Balance', items);\n  m.promptList = [['confirm', 'Reset this one'], ['back', 'Back']];\n  return m;\n};\nexport function devScreen(g) {\n  const items = [['Time', timePage], ['World', worldPage], ['Player', playerPage], ['Neighbours', neighboursPage], ['Events', eventsPage], ['Collections', collectionsPage], ['Debug', debugPage], ['Save', savePage], ['Balance', balancePage]].map(([label, fn]) => ({ label, action: (gg) => gg.ui.push(fn(gg)) }));\n  items.push({ label: 'Back', action: (gg, m) => gg.ui.pop(m) });\n  const m = new Menu({ id: 'dev', title: 'Dev Mode', items, x: 130, y: 44, w: 220, itemH: 19, gap: 2, back: (gg, mm) => gg.ui.pop(mm) });\n  m.perPage = 10;\n  return m;\n}\nexport { calendar, FESTIVALS, CONTESTS, LANDMARKS, CITY_DOORS, sendMail, rebuildAllObjects };\nEOF\nmkdir -p src/net; cat > src/net/visitUi.js <<'EOF'\nimport { Menu } from '../ui/ui.js';\nexport function visitMenu(g) { return new Menu({ id: 'visit', title: 'Visit', items: [{ label: 'Back', action: (gg, m) => gg.ui.pop(m) }], x: 150, y: 90, w: 180, back: (gg, m) => gg.ui.pop(m) }); }\nEOF\ncat > src/main.js <<'EOF'\n// Page entry: a Hub session opens straight into the round; otherwise the normal start.\nimport { Engine, withUrlOptions, PALETTE } from './engine.js';\nimport { createGame } from './game.js';\n\nconst touchOnly = typeof navigator !== 'undefined' && navigator.maxTouchPoints > 0 && !matchMedia('(any-pointer: fine)').matches;\nfunction failure(message) {\n  const el = document.createElement('div');\n  el.style.cssText = 'position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#1a1c2c;color:#f4f4f4;font:20px monospace;text-align:center;padding:24px';\n  el.textContent = message;\n  el.id = 'no-webgpu';\n  document.body.appendChild(el);\n}\nasync function start() {\n  const hub = globalThis.AIHub;\n  if (hub?.active) {\n    const { startRound } = await import('./net/hubStart.js');\n    const started = await startRound(hub, { touchOnly });\n    if (started) return;\n  }\n  const realNow = Date.now();\n  const game = createGame({ touchOnly, realNow });\n  window.addEventListener('keydown', (e) => {\n    if (e.key === 'Tab' || e.key === 'Escape' || e.key === 'Backspace') e.preventDefault();\n    window.__PIXEL_ENGINE__?.input.send({ t: 'key', key: e.key });\n  });\n  window.addEventListener('contextmenu', (e) => e.preventDefault());\n  try {\n    const engine = await Engine.start(game, withUrlOptions({\n      container: document.getElementById('app'),\n      aspect: 'fixed',\n      quality: 'high',\n      camera: { preset: 'iso', yaw: 45, pitch: 35, zoom: 1.6, minZoom: 1.6, maxZoom: 1.6 },\n      settings: { button: touchOnly ? 'top-right' : false, key: 'honk-if-you-owe' },\n      touch: false, touchBar: false, background: PALETTE.ink,\n    }));\n    setInterval(() => engine.input.send({ t: 'now', ms: Date.now() }), 20000);\n    engine.input.send({ t: 'now', ms: Date.now() });\n    window.addEventListener('beforeunload', () => { game.autosave?.(); });\n  } catch (err) {\n    console.warn(err);\n    failure(`Honk If You Owe needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox 141 on Windows. (${err?.message ?? err})`);\n  }\n}\nif (typeof document !== 'undefined') start();\nEOF\ncat > src/net/hubStart.js <<'EOF'\nexport async function startRound() { return false; }\nEOF\nnode tools/build.mjs 2>&1 | tail -20","description":"Write dev mode, attract, new game flow and main, then build"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13353,"cache_read_input_tokens":665467,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13353},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"1d1ed835-0d14-4d2d-a140-09af42c59442","timestamp":"2026-11-06T01:30:15.294Z","request_id":"req_011Cgkoh5i1JxdehkWLddcYy","wire_tool_inputs":{"toolu_019Ud4Stjiop85Pg2xqfW4BQ":{"command":"cat > src/systems/newgame.js <<'EOF'\n// Starting, continuing and leaving: world resets, the night bus in, Mrs. Gander at the stop, Inspector Pimm.\nimport { newWorld, loadWorld, saveWorld, SAVE_KEY, clearSave } from '../core/save.js';\nimport { hash32 } from '../core/rng.js';\nimport { say, ask, narrate } from './say.js';\nimport { keyboardFlow } from '../ui/screens/keyboard.js';\nimport { lookEditor } from '../ui/screens/lookEditor.js';\nimport { prepareDayOne } from './dayone.js';\nimport { dailyRespawn, handleAbsence } from './flow.js';\nimport { rebuildAllObjects } from '../world/objectsView.js';\nimport { BusPlace } from './bus.js';\nimport { LANDMARKS } from '../data/town.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { markSessionOpen, markSessionClean, lastSessionUnclean, saveNow } from './session.js';\nimport { titleScreen } from '../ui/screens/title.js';\nimport { hourNow } from './time.js';\nimport { dailyFavours } from './favours.js';\nimport { Actor } from '../actors/rig.js';\nimport { CRITTER_DEFS, HAIR_COLORS } from '../art/critter.js';\nimport { equip } from './tools.js';\nimport { deliverMail } from './mail.js';\nimport { cheeseDayReset } from './cheese.js';\n\nconst NAMES = ['Pip', 'Moss', 'Juniper', 'Wren', 'Ash', 'Bramble', 'Tuck', 'Fern', 'Quill', 'Sorrel', 'Basil', 'Hob'];\nconst TOWNS = ['Lower Nowhere', 'Much Owing', 'Little Regret', 'Bean Hollow', 'Far Enough', 'Dunhonkin', 'Upper Lateness', 'Pear Bottom'];\n\n/** Swap in a world and make the scene match it. */\nexport function installWorld(g, world) {\n  g.world = world;\n  g.scripts.cancelAll();\n  g.weatherKey = null;\n  g.lastHour = -1;\n  g.town.syncNav();\n  g.refreshSeason(true);\n  rebuildAllObjects(g.town);\n  g.rooms.reset();\n  g.town.refreshHome();\n  g.town.refreshStore();\n  g.player.applyLook();\n  g.life.resetDay();\n  g.festivals.resetDay();\n  g.npcs.scatter();\n  for (const n of g.npcs.all()) { n.talking = false; n.overrideClip = null; }\n  g.sky.placeChanged();\n  equip(g, world.player.tool);\n}\nexport function startNewGame(g, mode) {\n  const seed = g.opts.seed ?? hash32(`arrival:${g.ctx.time}:${g.realNow ?? 0}`);\n  const w = newWorld(seed, { mode });\n  g.ui.popAll();\n  g.mode = 'play';\n  g.demo = false;\n  g.camState.zoomOverride = undefined;\n  g.fixedCam = false;\n  g.ctx.engine.screen.set('fade', 1);\n  installWorld(g, w);\n  dailyRespawn(g);\n  rebuildAllObjects(g.town);\n  g.events.emit('newGame', { mode });\n  g.scripts.run(arrival(g), { name: 'arrival' });\n}\n/** Title → the night bus → the stop. Answers set your hair, colours and eyes. */\nfunction* arrival(g) {\n  const w = g.world;\n  w.clock.minute = 23 * 60;\n  w.flags.forceWeather = 'rain';\n  g.weatherKey = null;\n  g.hideHud = true;\n  const bus = g.busPlace ??= new BusPlace(g);\n  g.ctx.scene.add(bus.group);\n  bus.setScene(0, 1, { night: true });\n  g.swapPlace(bus, 0, 0, 0);\n  const p = g.player;\n  p.remove();\n  bus.bodyGroup.add(p.root);\n  p.x = 0.6; p.z = -0.8; p.y = 0.86; p.facing = Math.PI * 0.5;\n  p.sitting = true;\n  p.play('Sit', 0);\n  g.camFocus = { x: 1.5, y: 1.2, z: 0 };\n  g.camTeleport();\n  g.sky.apply();\n  bus.hester.play('Sit', 0);\n  g.ctx.engine.screen.reveal('fade', { duration: 1 });\n  yield 1.2;\n  g.sound('thunder');\n  yield* say(g, 'hester', [\"End of the line? Nobody gets off there on purpose.\"]);\n  yield* say(g, 'hester', [\"I'm Hester. I drive the bus. Who've I got?\"]);\n  w.player.name = yield* keyboardFlow(g, { title: 'What do they call you?', max: 12, random: NAMES, hint: 'Type, or use the grid. Suggest asks Hester to guess.' });\n  yield* say(g, 'hester', [`${w.player.name}. All right. I've heard worse. I've driven worse.`, \"And what's the town called? The one at the end? Nobody's ever told me. I only drive the bus.\"]);\n  w.player.town = yield* keyboardFlow(g, { title: \"What's the town called?\", max: 16, random: TOWNS, hint: \"It's up to you. It's always been up to someone.\" });\n  yield* say(g, 'hester', `${w.player.town}. Sounds about right. It's raining there. It's raining everywhere. I've checked.`);\n  const a = yield* ask(g, 'hester', 'So what are you running from?', ['The usual', 'Nothing, honest', 'A very large bill', 'My family']);\n  w.player.look.hair = [0, 3, 5, 4][a < 0 ? 0 : a];\n  const b = yield* ask(g, 'hester', 'Favourite weather?', ['Rain', 'Sun', 'Snow', 'I like a good fog']);\n  w.player.look.hairColor = ['navy', 'orange', 'white', 'plum'][b < 0 ? 0 : b];\n  const c = yield* ask(g, 'hester', 'How do you take bad news?', ['Sitting down', 'Very well', 'Loudly', 'I write a letter']);\n  w.player.look.eyes = [2, 1, 3, 0][c < 0 ? 0 : c];\n  p.applyLook();\n  p.play('Sit', 0);\n  yield* narrate(g, 'A wet face looks back at you from the bus window. Is that what you look like? You could do something about that. Now would be the time.');\n  yield* lookEditor(g, { title: 'The bus window' });\n  p.play('Sit', 0);\n  yield* say(g, 'hester', 'You look like someone who owes money.');\n  yield* say(g, 'hester', \"Here we are. Mind the step. There isn't a step. Mind it anyway.\");\n  g.sound('busBrake');\n  g.engine.screen.cover('iris', { duration: 0.6 });\n  yield 0.7;\n  // Morning, at the stop\n  p.sitting = false;\n  p.remove();\n  w.flags.forceWeather = null;\n  w.clock.minute = 8 * 60;\n  g.weatherKey = null;\n  prepareDayOne(g);\n  rebuildAllObjects(g.town);\n  dailyFavours(g);\n  g.swapPlace(g.town, LANDMARKS.busStop[0] + 1, LANDMARKS.busStop[1] + 0.3, Math.PI / 2);\n  g.lastHour = hourNow(w);\n  g.npcs.scatter();\n  g.life.resetDay();\n  g.hideHud = false;\n  const gander = new Actor(CRITTER_DEFS.gander, { name: 'gander', seed: 4 });\n  gander.addTo(g.town.group);\n  gander.x = LANDMARKS.busStop[0] + 3; gander.z = LANDMARKS.busStop[1] + 0.3; gander.facing = -Math.PI / 2;\n  g.townGander = gander;\n  g.engine.screen.reveal('iris', { duration: 0.6 });\n  g.actorOverride = { gander };\n  yield 0.8;\n  gander.play('Honk', 0.1, { once: true });\n  g.sound('honk');\n  yield* say(g, 'gander', [\"You're late. No, you're exactly on time. I've already billed you for being late.\", `Mrs. Gander. I own the store, the road you're standing on, and as of ninety seconds ago, a good part of you, ${w.player.name} dear.`, \"Your new home is this way. Do keep up. I'm charging by the minute.\"]);\n  g.engine.screen.cover('iris', { duration: 0.5 });\n  yield 0.6;\n  g.swapPlace(g.town, 69, 41.6, Math.PI);\n  gander.x = 66.4; gander.z = 41.2; gander.facing = Math.PI / 2;\n  g.engine.screen.reveal('iris', { duration: 0.5 });\n  yield 0.7;\n  yield* say(g, 'gander', [\"Here we are. The roof is included. The rain is complimentary. The 8,000 beans are not.\", \"I see you've no way to pay. How lovely. Put this apron on. You'll work some of it off with errands. Look at your list, dear. Top right.\"]);\n  w.player.look.outfit = 'apron';\n  p.applyLook();\n  g.sound('uiConfirm');\n  yield* say(g, 'gander', \"Dorrit has a parcel. Tavi has a net. Bartleby has a rod and would prefer not. The Mayor is around, slowly. Clementine at the Hall has the rest. Off you go. HONK. Pardon me. That was my indoor voice.\");\n  gander.remove();\n  g.townGander = null;\n  g.actorOverride = null;\n  markSessionOpen(g);\n  saveNow(g);\n  g.events.emit('arrived', {});\n}\nexport function continueGame(g) {\n  const w = loadWorld();\n  if (!w) { g.sound('uiError'); return; }\n  const unclean = lastSessionUnclean();\n  g.ui.popAll();\n  g.mode = 'play';\n  g.demo = false;\n  g.fixedCam = false;\n  g.camState.zoomOverride = undefined;\n  installWorld(g, w);\n  const place = w.player.place === 'town' || !w.player.place ? g.town : w.player.place === 'city' ? g.city : (w.player.place === 'bus' ? g.town : g.rooms.get(w.player.place));\n  g.place.group.visible = false;\n  g.swapPlace(place, w.player.x, w.player.z, w.player.facing);\n  if (g.realNow) handleAbsence(g, g.realNow);\n  deliverMail(g);\n  markSessionOpen(g);\n  g.events.emit('continued', {});\n  if (unclean) g.scripts.run(pimmVisit(g), { name: 'pimm' });\n}\n/** Inspector Pimm: three escalating monologues, then one last resigned one. */\nexport function* pimmVisit(g) {\n  const w = g.world;\n  w.pimm.visits += 1;\n  const v = w.pimm.visits;\n  const bank = v === 1 ? HOSTS.pimm.first : v === 2 ? HOSTS.pimm.second : v === 3 ? HOSTS.pimm.third : v === 4 ? HOSTS.pimm.last : null;\n  if (!bank) return;\n  yield 0.6;\n  const a = new Actor(CRITTER_DEFS.pimm, { name: 'pimm', seed: 11 });\n  a.addTo(g.place.group);\n  a.x = g.player.x + 6; a.z = g.player.z; a.y = g.place.height(g.player.x, g.player.z); a.facing = -Math.PI / 2;\n  a.play('PimmScuttle', 0);\n  g.actorOverride = { pimm: a };\n  g.pimmActor = a;\n  while (a.x > g.player.x + 1.6) { a.x -= 1 / 60 * 2.4; a.update(1 / 60); yield; }\n  a.play('Idle', 0.2);\n  g.player.faceToward(a.x, a.z);\n  yield* say(g, 'pimm', bank);\n  g.events.emit('pimm', { visit: v });\n  a.play('PimmScuttle', 0.2);\n  for (let i = 0; i < 120; i++) { a.x += 1 / 60 * 3; a.update(1 / 60); yield; }\n  a.remove();\n  g.pimmActor = null;\n  g.actorOverride = null;\n}\nexport function quitToTitle(g) {\n  g.ui.popAll();\n  g.scripts.cancelAll();\n  g.engine.screen.set('fade', 0);\n  g.goTitle();\n}\nexport { saveWorld, SAVE_KEY, clearSave, cheeseDayReset, HAIR_COLORS, titleScreen, markSessionClean };\nEOF\npython3 - <<'EOF'\np='src/game.js'\ns=open(p).read()\ns=s.replace(\"  actorOf(id) { return id === 'player' ? this.player : this.npcs.actor(id) ?? this.place?.hostActor?.(id) ?? null; }\",\"\"\"  actorOf(id) { return id === 'player' ? this.player : this.actorOverride?.[id] ?? this.npcs.actor(id) ?? this.place?.hostActor?.(id) ?? (id === 'trundle' ? this.life.trundle : id === 'rind' ? this.life.rind : id === 'vesper' ? this.life.vesper : id === 'hester' ? this.busPlace?.hester : null) ?? null; }\"\"\")\ns=s.replace(\"  newDay() { newDay(this); }\",\"\"\"  newDay() { newDay(this); }\n  openPlacement(i) { this.ui.push(placementScreen(this, i)); }\n  quitToTitle() { quitToTitle(this); }\n  /** Back to the live diorama on a throwaway world. */\n  goTitle() {\n    const w = newWorld(hash32('title-diorama'), { demo: true });\n    w.clock.minute = 9.5 * 60;\n    w.clock.day = 5;\n    w.player.tools = ['net', 'rod', 'shovel', 'axe', 'can', 'slingshot'];\n    this.mode = 'title';\n    this.demo = true;\n    this.place.group.visible = false;\n    this.place.leave?.(this);\n    this.player.remove();\n    this.place = this.town;\n    this.town.group.visible = true;\n    this.player.addTo(this.town.group);\n    installWorld(this, w);\n    dailyRespawn(this);\n    rebuildAllObjects(this.town);\n    this.player.x = 24; this.player.z = 30;\n    this.camState.zoomOverride = undefined;\n    this.camState.yawT = 45; this.camState.yaw = 45; this.camState.applied = '';\n    this.titleDrift = 0;\n    this.noInput = 0;\n    this.camFocus = { x: 24, y: 1, z: 40 };\n    this.updateCamera(1);\n    this.camTeleport();\n    this.music.refresh();\n    this.ui.push(titleScreen(this));\n  }\"\"\")\ns=s.replace(\"import { titleScreen } from './ui/screens/title.js';\",\"import { titleScreen } from './ui/screens/title.js';\\nimport { placementScreen } from './ui/screens/placement.js';\\nimport { installWorld, quitToTitle } from './systems/newgame.js';\\nimport { dailyRespawn } from './systems/flow.js';\")\n# title start: use goTitle equivalent\ns=s.replace(\"\"\"    this.player.x = 24; this.player.z = 30;\n    this.sky = new Sky(this);\"\"\",\"\"\"    this.player.x = 24; this.player.z = 30;\n    this.camFocus = { x: 24, y: 1, z: 40 };\n    this.sky = new Sky(this);\"\"\")\ns=s.replace(\"\"\"    this.life.resetDay();\n    this.mode = 'title';\n    this.ui.push(titleScreen(this));\n    this.camTeleport();\"\"\",\"\"\"    dailyRespawn(this);\n    rebuildAllObjects(this.town);\n    this.life.resetDay();\n    this.festivals.resetDay();\n    this.mode = 'title';\n    this.ui.push(titleScreen(this));\n    this.camTeleport();\"\"\")\ns=s.replace(\"\"\"    if (this.mode === 'attract') this.attract.update(dt);\"\"\",\"\"\"    if (this.mode === 'attract') this.attract.update(dt);\n    if (this.mode === 'title') this.updateTitle(dt);\"\"\")\ns=s.replace(\"\"\"  readCommands(ctx) {\"\"\",\"\"\"  updateTitle(dt) {\n    // The camera drifts over the diorama; after 10 quiet seconds the attract loop takes over.\n    this.titleDrift = (this.titleDrift ?? 0) + dt;\n    const t = this.titleDrift * 0.03;\n    this.camFocus = { x: 24 + Math.sin(t) * 16, y: 1, z: 40 + Math.cos(t * 1.3) * 8 };\n    const top = this.ui.top;\n    if (top?.isTitle && this.noInput >= 10) this.attract.start();\n  }\n  readCommands(ctx) {\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/dev/attract.js <<'EOF'\n// The attract loop: after 10 quiet seconds on the title, a looping AI-played demo on a throwaway save.\n// It cheats freely. Any input exits, at once. Its only job is to show as much as possible.\nimport { newWorld } from '../core/save.js';\nimport { drawText, panel } from '../ui/draw.js';\nimport { installWorld } from '../systems/newgame.js';\nimport { dailyRespawn } from '../systems/flow.js';\nimport { rebuildAllObjects } from '../world/objectsView.js';\nimport { villageDay } from '../core/calendar.js';\nimport { LANDMARKS, BUILDINGS } from '../data/town.js';\nimport { CITY_BUS_STOP } from '../world/city.js';\nimport { busRide } from '../systems/bus.js';\nimport { typeLine, hostLine } from '../systems/lines.js';\nimport { Dialogue } from '../ui/dialogue.js';\nimport { nameOf } from '../systems/say.js';\nimport { CLOTHES } from '../data/clothes.js';\nimport { ITEMS } from '../data/items.js';\nimport { titleScreen } from '../ui/screens/title.js';\nimport { drawLogo } from '../ui/screens/title.js';\nimport { FISH } from '../data/fish.js';\nimport { THREE, toonMaterial, PALETTE, buildModel } from '../engine.js';\nimport { MODELS } from '../art/models.js';\n\nconst BEAT = 7.5;\nexport class AttractMode {\n  constructor(g) { this.g = g; this.running = false; this.tune = null; this.t = 0; this.script = null; this.savedPlace = null; }\n  start() {\n    const g = this.g;\n    g.ui.popAll();\n    g.mode = 'attract';\n    this.running = true;\n    this.t = 0;\n    this.loops = (this.loops ?? 0) + 1;\n    const w = newWorld(777 + this.loops, { demo: true });\n    w.player.name = 'Pip'; w.player.town = 'Far Enough';\n    w.player.look.hair = 3; w.player.look.hairColor = 'orange'; w.player.look.outfit = 'plainRed'; w.player.look.hatItem = 'strawHat';\n    w.player.tools = ['net', 'rod', 'shovel', 'axe', 'can', 'slingshot'];\n    w.player.beans = 999999;\n    w.story.stage = 'free';\n    w.flags.shackRoof = true;\n    w.player.homeTier = 2;\n    w.museum.open = true;\n    g.demo = true;\n    this.goDay(1, 10);\n    g.world = w;\n    installWorld(g, w);\n    dailyRespawn(g);\n    rebuildAllObjects(g.town);\n    g.events.emit('attractStart', {});\n    this.beat = 0;\n    this.scene = this.play();\n    this.wait = 0;\n    this.scriptDone = false;\n    g.camFocus = null;\n    g.music.refresh();\n  }\n  goDay(day, hour) {\n    const g = this.g;\n    if (!g.world) return;\n    g.world.clock.day = day;\n    g.world.clock.minute = hour * 60;\n    g.weatherKey = null;\n    g.lastHour = -1;\n  }\n  /** Any input exits to the title at once. */\n  stop() {\n    const g = this.g;\n    if (!this.running) return;\n    this.running = false;\n    g.scripts.cancelAll();\n    g.ui.popAll();\n    g.engine.screen.set('iris', 0);\n    g.inTransition = false;\n    g.hideHud = false;\n    g.music.setOverride(null);\n    this.tune = null;\n    for (const m of this.extra ?? []) m.removeFromParent();\n    this.extra = [];\n    g.player.sitting = false;\n    g.player.poseTimer = 0;\n    g.player.poseClip = null;\n    g.player.locked = false;\n    g.events.emit('attractStop', {});\n    g.goTitle();\n  }\n  fixedStep(dt) { if (this.running) this.walk(dt); }\n  walk(dt) {\n    const g = this.g;\n    const p = g.player;\n    if (!this.dest) { p.speed = 0; return; }\n    const dx = this.dest.x - p.x, dz = this.dest.z - p.z;\n    const d = Math.hypot(dx, dz);\n    if (d < 0.25) { this.dest = null; p.speed = 0; return; }\n    const sp = this.dest.speed ?? 4.2;\n    p.x += (dx / d) * sp * dt; p.z += (dz / d) * sp * dt; // no clip: it may cheat\n    p.y = g.place.height(p.x, p.z);\n    p.speed = sp;\n    p.turnTo = Math.atan2(dx, dz);\n  }\n  update(dt) {\n    const g = this.g;\n    if (!this.running) return;\n    // Any input (key, button, stick, mouse move, tap) exits at once.\n    if (g.inp.any) { this.stop(); return; }\n    if (this.wait > 0) { this.wait -= dt; return; }\n    const r = this.scene.next();\n    if (r.done) { this.scene = this.play(); return; }\n    if (typeof r.value === 'number') this.wait = r.value;\n  }\n  say(who, text, dur = 3) {\n    const g = this.g;\n    g.ui.popAll();\n    const d = new Dialogue({ who, name: nameOf(who), voice: who, beats: [text] });\n    d.update = function (gg, inp, dt) { this.timer += dt * 40; while (this.timer >= 1 && this.shown < this.total) { this.timer -= 1; const ch = this.seq[this.pos++]; if (!ch) break; if (ch.beat) continue; this.shown++; if (ch.c !== ' ') { gg.voice.syllable(ch.c, this.voice, text); const a = gg.actorOf(this.who); if (a && /[aeiou]/i.test(ch.c)) a.talkAmp = 1; } } };\n    g.ui.push(d);\n    return dur;\n  }\n  iris() { const g = this.g; g.engine.screen.cover('iris', { duration: 0.2 }); return 0.22; }\n  reveal() { this.g.engine.screen.reveal('iris', { duration: 0.2 }); }\n  moveTo(place, x, z, facing = 0) { this.g.swapPlace(place, x, z, facing); }\n  setDay(day, hour) { this.goDay(day, hour); this.g.refreshSeason(true); this.g.sky.placeChanged(); this.g.life.resetDay(); this.g.festivals.resetDay(); this.g.npcs.scatter(); }\n  *play() {\n    const g = this.g;\n    const town = g.town;\n    const p = g.player;\n    const w = g.world;\n    // Tree shake\n    this.tune = null;\n    this.setDay(1, 10);\n    this.moveTo(town, 52, 11, Math.PI);\n    const treeKey = Object.keys(w.town.objects).find((k) => w.town.objects[k].k === 'tree' && w.town.objects[k].kind === 'pear');\n    const [tx, tz] = treeKey.split(',').map(Number);\n    p.x = tx + 0.5; p.z = tz + 1.5; p.facing = Math.PI;\n    g.camTeleport();\n    p.pose('ShakeTree');\n    yield 0.3;\n    g.life.shakeTree(treeKey, w.town.objects[treeKey]);\n    yield 2;\n    // Butterfly\n    p.hold('tool-net');\n    p.play('NetReady', 0.1);\n    this.moveTo(town, 18, 26, 0);\n    const butterfly = g.life.addBug(g.life.bugs[0]?.def ?? { id: 'cabbageButterfly', name: 'Butterfly', kind: 'flier', color: 'white', spot: 'flower', beans: 90, line: '' }, 19.5, 27, null);\n    yield 1;\n    p.pose('NetSweep');\n    g.sound('netSwing');\n    yield 0.3;\n    g.life.catchBug(butterfly);\n    p.pose('HoldUp', 1.4);\n    g.sound('reveal');\n    yield 2;\n    // Cast and catch\n    p.hold('tool-rod');\n    this.moveTo(town, 37.2, 22, Math.PI / 2);\n    p.pose('Cast');\n    g.sound('cast');\n    yield 0.5;\n    g.life.bobberMesh.visible = true;\n    g.life.bobberMesh.position.set(40, -0.2, 22);\n    g.sound('plop');\n    yield 1.4;\n    g.sound('nibble');\n    g.life.bobberMesh.position.y = -0.3;\n    yield 0.9;\n    g.life.bobberMesh.position.y = -0.5;\n    g.sound('bite');\n    g.ctx.particles.burst('splash', [40, -0.15, 22]);\n    yield 0.5;\n    g.life.bobberMesh.visible = false;\n    p.pose('HoldUp', 1.4);\n    g.sound('reveal');\n    yield this.say('player', 'You caught a pike! Someone should tell it about the other end of the hook.', 2.4);\n    g.ui.popAll();\n    // Fossil\n    p.hold('tool-shovel');\n    this.moveTo(town, 25, 30, 0);\n    p.pose('Dig');\n    g.sound('dig');\n    g.ctx.particles.burst('dirt', [25, 0.2, 31]);\n    yield 1.6;\n    p.pose('HoldUp', 1.2);\n    g.sound('reveal');\n    yield 1.6;\n    // Neighbour chat with voice\n    p.hold(null);\n    const n = g.npcs.get('bartleby');\n    n.inside = false; n.setPos(30, 35); g.npcs.syncVisibility(n); n.held = true;\n    const t = g.npcs.get('tavi');\n    t.inside = false; t.setPos(28, 35); g.npcs.syncVisibility(t); t.held = true;\n    this.moveTo(town, 29, 37, Math.PI);\n    t.actor.play('Wave', 0.1, { once: true });\n    yield this.say('tavi', 'I smiled at a rock today and I think it\\'s going really well, isn\\'t it?!', 3.2);\n    yield this.say('bartleby', \"You're standing in my good spot. No, there isn't another one. I'd prefer not.\", 3.2);\n    g.ui.popAll();\n    n.held = false; t.held = false;\n    // Store\n    yield this.iris();\n    const store = g.rooms.get('store');\n    this.moveTo(store, 6, 4.8, Math.PI);\n    this.reveal();\n    store.host?.play('Honk', 0.1, { once: true });\n    g.sound('honk');\n    yield this.say('gander', 'No rush on the payment, dear. I\\'ve simply noted the time you didn\\'t pay, and I\\'ll be noting it again tomorrow.', 3.6);\n    g.ui.popAll();\n    // Furnishing\n    yield this.iris();\n    w.home.rooms.main.items.push({ id: 'cottageSofa', x: 2, z: 1, rot: 0, on: true }, { id: 'cottageLamp', x: 1, z: 1, rot: 0, on: true }, { id: 'cottageRug', x: 3, z: 3, rot: 0, on: true }, { id: 'cottageTable', x: 3, z: 3, rot: 0, on: true }, { id: 'mossyPlant', x: 6, z: 1, rot: 0, on: true }, { id: 'stereo', x: 7, z: 1, rot: 0, on: true });\n    const home = g.rooms.get('home');\n    home.rebuild();\n    this.moveTo(home, 4, 5.5, Math.PI);\n    this.reveal();\n    yield 2.5;\n    p.play('Dance', 0.2);\n    yield 2;\n    // Museum donation\n    yield this.iris();\n    w.museum.fish = Object.fromEntries(FISH.slice(0, 12).map((f) => [f.id, true]));\n    const aq = g.rooms.get('museum_fish');\n    this.moveTo(aq, 6, 5.4, Math.PI);\n    this.reveal();\n    yield 3;\n    // Summer lanterns and fireworks\n    yield this.iris();\n    this.setDay(8, 20);\n    this.moveTo(town, 37, 26, Math.PI / 2);\n    g.festivals.launchLanterns('red');\n    for (const d of g.festivals.lanternData) d.t += 0.5;\n    this.reveal();\n    this.tune = 'festivalSummer';\n    g.music.refresh();\n    yield 3.4;\n    this.moveTo(town, 36, 52, 0);\n    g.camFocus = { x: 40, y: 2, z: 54 };\n    g.camTeleport();\n    for (let i = 0; i < 4; i++) { g.sound('fireworkBurst'); g.ctx.particles.burst('firework', [34 + i * 4, 11 + (i % 2) * 3, 62], { colors: [['red', 'sand', 'white'], ['sky', 'white', 'cyan'], ['lime', 'sand', 'white'], ['plum', 'orange', 'sand']][i] }); yield 0.9; }\n    g.camFocus = null;\n    this.tune = null;\n    // The bus singing\n    yield this.iris();\n    g.music.setOverride('bus');\n    const bus = g.busPlace ??= new (await_bus(g))(g);\n    g.ctx.scene.add(bus.group);\n    bus.setScene(g.season, g.calendarDay);\n    g.swapPlace(bus, 0, 0, 0);\n    p.remove();\n    bus.bodyGroup.add(p.root);\n    p.x = -1.2; p.z = -0.8; p.y = 0.86; p.facing = Math.PI / 2;\n    p.sitting = true;\n    p.play('Sit', 0);\n    g.camFocus = { x: 0, y: 1.2, z: 0 };\n    g.camTeleport();\n    this.reveal();\n    bus.hester.play('Talk', 0.2);\n    yield this.say('hester', '♪ Oh, you fished up an old boot and you sold it for ten, and you\\'d do it, you\\'d do it, you\\'d do it again… ♪', 3.8);\n    g.ui.popAll();\n    p.sitting = false;\n    p.remove();\n    bus.group.add(p.root);\n    // City neon\n    yield this.iris();\n    this.goDay(10, 21);\n    g.sky.placeChanged();\n    this.moveTo(g.city, 12, 11, 0);\n    g.music.setOverride('cityNight');\n    this.reveal();\n    this.dest = { x: 26, z: 11, speed: 3.4 };\n    yield 4;\n    // Salon, auction paddle\n    yield this.iris();\n    const salon = g.rooms.get('salon');\n    this.moveTo(salon, 4, 3.4, 0);\n    this.reveal();\n    g.music.setOverride('salon');\n    g.sound('scissors');\n    yield this.say('fleece', 'Monsieur! Madame! Whichever! Your hair, it speaks to me, and it is begging.', 2.6);\n    g.ui.popAll();\n    yield this.iris();\n    const auc = g.rooms.get('auction');\n    this.moveTo(auc, 5, 5.2, Math.PI);\n    this.reveal();\n    g.music.setOverride('auction');\n    p.play('Paddle', 0.05, { once: true });\n    g.sound('paddle');\n    yield this.say('pemberton', 'Going-once-going-twice-do-I-hear-more-oh-you\\'re-serious-SOLD!', 2.2);\n    g.sound('gavel');\n    g.ui.popAll();\n    g.music.setOverride(null);\n    // Soup\n    yield this.iris();\n    this.setDay(12, 13);\n    this.moveTo(town, 25, 44, Math.PI);\n    this.tune = 'festivalAutumn';\n    g.music.refresh();\n    this.reveal();\n    yield this.say('dorrit', 'That\\'s a soup, mmhm. That\\'s the soup. I\\'ve waited my whole life.', 3);\n    g.ui.popAll();\n    // Snowman\n    yield this.iris();\n    this.setDay(14, 11);\n    this.tune = null;\n    g.music.refresh();\n    w.town.objects['26,30'] = { k: 'snowman', ratio: 0.72, good: true };\n    town.dirty.add('26,30');\n    this.moveTo(town, 26, 33, Math.PI);\n    this.reveal();\n    p.play('Wave', 0.1, { once: true });\n    yield 3;\n    // Long Night\n    yield this.iris();\n    this.setDay(16, 23.9);\n    const [px, pz] = LANDMARKS.oldPear;\n    w.flags.pearLit = true;\n    town.seasonBuilt = -1;\n    g.refreshSeason(true);\n    this.moveTo(town, px + 0.5, pz + 4.6, Math.PI);\n    g.camFocus = { x: px, y: 2.4, z: pz + 1 };\n    g.camTeleport();\n    this.tune = 'festivalWinter';\n    g.music.refresh();\n    for (const [i, id] of ['dorrit', 'tavi', 'bartleby', 'ottoline', 'nib', 'yolanda', 'ozzie'].entries()) { const a = (i / 7) * Math.PI * 2; const nn = g.npcs.get(id); nn.inside = false; nn.setPos(px + Math.cos(a) * 4, pz + 1 + Math.sin(a) * 4); g.npcs.syncVisibility(nn); nn.overrideClip = 'Sway'; nn.actor.faceToward(px, pz); }\n    this.reveal();\n    yield 5;\n    for (const nn of g.npcs.all()) nn.overrideClip = null;\n    // Logo, and round again\n    g.camFocus = null;\n    this.showLogo = true;\n    this.tune = 'title';\n    g.music.refresh();\n    yield 3.5;\n    this.showLogo = false;\n    g.world = newWorld(777 + (++this.loops), { demo: true });\n    const nw = g.world;\n    nw.player.name = 'Pip'; nw.player.look = { ...w.player.look };\n    nw.player.tools = w.player.tools;\n    nw.player.beans = 999999; nw.flags.shackRoof = true; nw.player.homeTier = 2; nw.museum.open = true;\n    installWorld(g, nw);\n    dailyRespawn(g);\n    rebuildAllObjects(g.town);\n    this.reveal();\n  }\n  drawHud(hud) {\n    const g = this.g;\n    if (g.mode !== 'attract') return;\n    if (this.showLogo) drawLogo(g, hud);\n    const on = Math.floor(g.ctx.time * 1.6) % 2 === 0;\n    panel(hud, 12, 12, 40, 16, { fill: 'red', trim: 'orange' });\n    drawText(hud, 32, 17, 'DEMO', { align: 'center', color: 'white' });\n    if (on) {\n      const text = g.opts.touchOnly ? 'Controller or keyboard required' : 'Press anything to play';\n      const w = text.length * 6 + 14;\n      panel(hud, 240 - w / 2, 244, w, 16, { fill: 'navy', trim: 'sky' });\n      drawText(hud, 240, 249, text, { align: 'center', color: 'white' });\n    }\n  }\n}\nimport { BusPlace } from '../systems/bus.js';\nconst await_bus = () => BusPlace;\nexport { villageDay, BUILDINGS, CITY_BUS_STOP, busRide, typeLine, hostLine, CLOTHES, ITEMS, titleScreen, THREE, toonMaterial, PALETTE, buildModel, MODELS, BEAT };\nEOF\ncat > src/ui/screens/dev.js <<'EOF'\n// Dev mode: paged, pad-playable, still big type. Time, World, Player, Neighbours, Events, Collections, Debug, Save, Balance.\nimport { Menu } from '../ui.js';\nimport { TUNING, tuning, setTuning, resetTuning } from '../../dev/tuning.js';\nimport { advanceTo } from './bed.js';\nimport { calendar, FESTIVALS, CONTESTS, villageDay } from '../../core/calendar.js';\nimport { BUILDINGS, LANDMARKS } from '../../data/town.js';\nimport { NEIGHBOUR_ORDER, NEIGHBOURS } from '../../data/neighbours.js';\nimport { ITEMS } from '../../data/items.js';\nimport { addItem, addBeans } from '../../systems/economy.js';\nimport { TOOL_ORDER, grantTool } from '../../systems/tools.js';\nimport { FISH } from '../../data/fish.js';\nimport { BUGS } from '../../data/bugs.js';\nimport { FOSSILS } from '../../data/fossils.js';\nimport { ART } from '../../data/art.js';\nimport { ALL_EMOTES } from './emote.js';\nimport { saveNow } from '../../systems/session.js';\nimport { loadWorld, saveWorld, clearSave, migrate } from '../../core/save.js';\nimport { installWorld, pimmVisit } from '../../systems/newgame.js';\nimport { offerFavour } from '../../systems/favours.js';\nimport { roccoLeaves } from '../../systems/story.js';\nimport { rebuildAllObjects } from '../../world/objectsView.js';\nimport { CONSTELLATIONS } from '../../systems/stargaze.js';\nimport { CITY_DOORS } from '../../data/cityMap.js';\nimport { sendMail } from '../../systems/mail.js';\n\nconst refreshTime = (g) => { g.weatherKey = null; g.lastHour = -1; g.refreshSeason(true); g.sky.placeChanged(); g.life.placeSpecials(); g.festivals.resetDay(); g.npcs.scatter(); };\nconst pageMenu = (g, title, items) => {\n  const m = new Menu({ id: `dev:${title}`, title: `Dev: ${title}`, items: [...items, { label: 'Back', action: (gg, mm) => gg.ui.pop(mm) }], x: 60, y: 44, w: 360, itemH: 19, gap: 2, back: (gg, mm) => gg.ui.pop(mm), prompts: [['confirm', 'Do'], ['back', 'Back']] });\n  return m;\n};\nconst timePage = (g) => {\n  const w = g.world;\n  return pageMenu(g, 'Time', [\n    { label: 'Hour', value: () => Math.floor(w.clock.minute / 60), left: () => { w.clock.minute = (w.clock.minute + 1380) % 1440; refreshTime(g); }, right: () => { w.clock.minute = (w.clock.minute + 60) % 1440; refreshTime(g); }, action: () => {} },\n    { label: 'Next day', action: () => { advanceTo(g, w.clock.day + 1, 8 * 60); refreshTime(g); g.events.emit('devNextDay', {}); } },\n    { label: 'Set calendar day', value: () => villageDay(w.clock.day).calendarDay, left: () => { const d = villageDay(w.clock.day).calendarDay; advanceTo(g, w.clock.day + ((d + 14) % 16) + 0, w.clock.minute); refreshTime(g); }, right: () => { advanceTo(g, w.clock.day + 1, w.clock.minute); refreshTime(g); }, action: () => {} },\n    { label: 'Next season', action: () => { const d = villageDay(w.clock.day); advanceTo(g, w.clock.day + (4 - (d.calendarDay - 1) % 4), 8 * 60); refreshTime(g); } },\n    { label: 'Freeze time', value: () => (g.timeFrozen ? 'Yes' : 'No'), action: () => { g.timeFrozen = !g.timeFrozen; } },\n    { label: 'Clock mode', value: () => w.clock.mode, action: () => { w.clock.mode = w.clock.mode === 'real' ? 'village' : 'real'; g.weatherKey = null; refreshTime(g); } },\n  ]);\n};\nconst worldPage = (g) => {\n  const w = g.world;\n  const places = [['Plaza', g.town, 24, 41], ['Bus stop', g.town, 8.5, 29], ...BUILDINGS.map((b) => [b.name, g.town, b.door[0], b.door[1] + 0.6]), ...NEIGHBOUR_ORDER.map((id) => [NEIGHBOURS[id].name, null, id]), ['The City', g.city, 2.5, 10]];\n  return pageMenu(g, 'World', [\n    { label: 'Weather', value: () => w.flags.forceWeather ?? 'natural', action: () => { const list = [null, 'sun', 'rain', 'storm', 'fog', 'wind', 'snow', 'clear']; const i = list.indexOf(w.flags.forceWeather ?? null); w.flags.forceWeather = list[(i + 1) % list.length]; g.weatherKey = null; } },\n    { label: 'Teleport…', action: (gg) => gg.ui.push(pageMenu(gg, 'Teleport', places.map(([name, place, x, z]) => ({ label: name, action: (g2) => { g2.ui.popAll(); if (!place) { const a = g2.npcs.actor(x); g2.swapPlace(g2.town, a.x + 1, a.z + 1); } else g2.swapPlace(place, x, z); } })))) },\n    { label: 'No-clip', value: () => (g.noclip ? 'On' : 'Off'), action: () => { g.noclip = !g.noclip; } },\n    { label: 'Free camera', value: () => (g.freeCam ? 'On' : 'Off'), action: () => { g.freeCam = !g.freeCam; g.engine.setCamera(g.freeCam ? { preset: 'free' } : { preset: 'iso', yaw: 45, pitch: 35, zoom: 1.6, minZoom: 1.6, maxZoom: 1.6 }, { syncUrl: false }); g.fixedCam = g.freeCam; } },\n    { label: 'Zoom-out overview', value: () => (g.camState.zoomOverride === 0.6 ? 'On' : 'Off'), action: () => { g.camState.zoomOverride = g.camState.zoomOverride === 0.6 ? undefined : 0.6; } },\n  ]);\n};\nconst playerPage = (g) => {\n  const w = g.world;\n  const categories = ['fish', 'bug', 'fossil', 'art', 'furniture', 'clothes', 'hat', 'glasses', 'umbrella', 'fruit', 'seed', 'bag', 'cheese', 'record', 'wall', 'floor'];\n  return pageMenu(g, 'Player', [\n    { label: 'Beans', value: () => w.player.beans.toLocaleString('en-US'), left: () => addBeans(g, -10000), right: () => addBeans(g, 10000), action: () => addBeans(g, 100000) },\n    { label: 'Clear debt', value: () => w.player.debt.toLocaleString('en-US'), action: () => { w.player.debt = 0; } },\n    { label: 'Home tier', value: () => w.player.homeTier, left: () => { w.player.homeTier = Math.max(1, w.player.homeTier - 1); g.town.refreshHome(); g.rooms.reset(); }, right: () => { w.player.homeTier = Math.min(4, w.player.homeTier + 1); g.town.refreshHome(); g.rooms.reset(); }, action: () => {} },\n    { label: 'Give any item…', action: (gg) => gg.ui.push(pageMenu(gg, 'Give', categories.map((c) => ({ label: c, action: (g2) => { const ids = Object.keys(ITEMS).filter((id) => ITEMS[id].cat === c); g2.ui.push(pageMenu(g2, c, ids.map((id) => ({ label: ITEMS[id].name, action: (g3) => { addItem(g3, id); g3.sound('pickUp'); } })))); } })))) },\n    { label: 'All tools', action: () => { for (const t of TOOL_ORDER) if (!w.player.tools.includes(t)) w.player.tools.push(t); grantTool(g, 'net'); } },\n    { label: 'All emotes', action: () => { w.player.emotes = ALL_EMOTES.slice(); } },\n    { label: 'Empty pockets', action: () => { w.player.pockets.fill(null); } },\n  ]);\n};\nconst neighboursPage = (g) => pageMenu(g, 'Neighbours', [\n  ...NEIGHBOUR_ORDER.map((id) => ({ label: NEIGHBOURS[id].name, value: () => g.world.npcs[id].friend, left: () => { g.world.npcs[id].friend = Math.max(0, g.world.npcs[id].friend - 10); }, right: () => { g.world.npcs[id].friend = Math.min(100, g.world.npcs[id].friend + 10); }, action: () => { offerFavour(g, id); g.sound('uiConfirm'); } })),\n  { label: 'Move Rocco out, Fitch in, now', action: () => roccoLeaves(g) },\n  { label: 'Show routines', value: () => (g.overlay.npc ? 'On' : 'Off'), action: () => { g.overlay.npc = !g.overlay.npc; } },\n]);\nconst eventsPage = (g) => {\n  const w = g.world;\n  const go = (day, hour) => { const d = villageDay(w.clock.day).calendarDay; let add = (day - d + 16) % 16; if (add === 0 && hour * 60 < w.clock.minute) add = 16; advanceTo(g, w.clock.day + add, hour * 60); refreshTime(g); g.ui.popAll(); };\n  return pageMenu(g, 'Events', [\n    { label: 'The Seed Toss', action: () => go(4, 10) }, { label: 'The Lantern Float', action: () => go(8, 18) }, { label: 'The Great Soup', action: () => go(12, 13) }, { label: 'The Long Night', action: () => go(16, 20) },\n    { label: 'Fishing Derby', action: () => go(6, 10) }, { label: 'Bug-Off', action: () => go(10, 10) }, { label: 'Snowman Contest', action: () => go(14, 10) },\n    { label: 'Vesper, tonight', action: () => { w.flags.vesperForced = true; w.clock.minute = 20 * 60; refreshTime(g); g.ui.popAll(); } },\n    { label: 'Inspector Pimm', action: () => { g.ui.popAll(); g.scripts.run(pimmVisit(g), { name: 'pimm' }); } },\n    { label: 'Cheese day', action: () => { w.flags.rindForced = true; g.life.placeSpecials(); g.ui.popAll(); } },\n    { label: 'Wasps', action: () => { g.ui.popAll(); g.life.startWasps(g.player.x + 3, g.player.z + 3); } },\n    { label: 'A balloon', action: () => { g.ui.popAll(); const b = g.life.launchBalloon({ z: Math.floor(g.player.z), gift: 'bagOfBeans' }); b.x = g.player.x - 6; } },\n    { label: 'The ending', action: () => { go(16, 23.8); w.flags.lightsDoors = { a: 1, b: 1, c: 1, d: 1 }; } },\n  ]);\n};\nconst collectionsPage = (g) => {\n  const w = g.world;\n  const fill = (v) => {\n    for (const [list, wing] of [[FISH, 'fish'], [BUGS, 'bug'], [FOSSILS, 'fossil'], [ART, 'art']]) {\n      w.museum[wing] = v ? Object.fromEntries(list.map((x) => [x.id, true])) : {};\n      w.almanac[wing] = v ? Object.fromEntries(list.map((x) => [x.id, 1])) : {};\n    }\n    if (v) for (const c of CONSTELLATIONS) w.almanac.stars[c.id] = true; else w.almanac.stars = {};\n    g.rooms.reset();\n  };\n  return pageMenu(g, 'Collections', [{ label: 'Fill museum and Almanac', action: () => fill(true) }, { label: 'Empty museum and Almanac', action: () => fill(false) }]);\n};\nconst debugPage = (g) => pageMenu(g, 'Debug', [\n  { label: 'Collision tiles', value: () => (g.overlay.collision ? 'On' : 'Off'), action: () => { g.overlay.collision = !g.overlay.collision; } },\n  { label: 'Nav paths', value: () => (g.overlay.nav ? 'On' : 'Off'), action: () => { g.overlay.nav = !g.overlay.nav; } },\n  { label: 'Target', value: () => (g.overlay.target ? 'On' : 'Off'), action: () => { g.overlay.target = !g.overlay.target; } },\n  { label: 'Neighbour state', value: () => (g.overlay.npc ? 'On' : 'Off'), action: () => { g.overlay.npc = !g.overlay.npc; } },\n  { label: 'Engine state line', value: () => (g.overlay.engine ? 'On' : 'Off'), action: () => { g.overlay.engine = !g.overlay.engine; } },\n  { label: 'Look switcher', value: () => g.devLook ?? 'none', action: () => { const names = ['none', 'pixel_world', 'dream', 'cel_cartoon', 'neon_nights', 'storybook']; const i = names.indexOf(g.devLook ?? 'none'); g.devLook = names[(i + 1) % names.length]; g.engine.setLook(g.engine.lookPresets[g.devLook]); } },\n]);\nconst savePage = (g) => pageMenu(g, 'Save', [\n  { label: 'Save now', action: () => { if (g.demo) { g.ui.toastMsg('Not on a demo.'); return; } saveNow(g); g.ui.toastMsg('Saved.'); } },\n  { label: 'Load', action: () => { const w = loadWorld(); if (w) { installWorld(g, w); g.swapPlace(g.town, w.player.x, w.player.z); g.ui.popAll(); } else g.ui.toastMsg('Nothing saved.'); } },\n  { label: 'Reset save', action: () => { clearSave(); g.ui.toastMsg('The save is gone. The goose remembers.'); } },\n  { label: 'Export save (JSON)', action: () => exportText(g, JSON.stringify(g.world), 'honk-save.json') },\n  { label: 'Import save (JSON)', action: () => importText(g, (t) => { try { const w = migrate(JSON.parse(t)); saveWorld(w); installWorld(g, w); g.swapPlace(g.town, w.player.x, w.player.z); g.ui.popAll(); } catch { g.ui.toastMsg('That is not a save.'); } }) },\n  { label: 'Export recording', action: () => exportText(g, JSON.stringify(g.engine.recording()), 'honk-recording.json') },\n  { label: 'Replay this session', action: () => { const rec = g.engine.recording(); g.ui.popAll(); g.engine.replay(rec, () => g.engine.loadGame(new g.constructor(g.opts))).catch(() => g.ui.toastMsg('That replay did not take.')); } },\n]);\nfunction exportText(g, text, name) {\n  g.lastExport = text;\n  if (typeof document === 'undefined') { g.ui.toastMsg('Exported.'); return; }\n  const a = document.createElement('a');\n  a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));\n  a.download = name;\n  a.click();\n  g.ui.toastMsg(`Exported ${name}.`);\n}\nfunction importText(g, fn) {\n  if (typeof document === 'undefined') return;\n  const i = document.createElement('input');\n  i.type = 'file';\n  i.accept = '.json,application/json';\n  i.onchange = () => { const f = i.files[0]; if (f) f.text().then(fn); };\n  i.click();\n}\nconst balancePage = (g) => {\n  const items = TUNING.map((t) => ({\n    label: t.label,\n    value: () => { const v = tuning[t.id]; return Number.isInteger(t.step) ? v : v.toFixed(2); },\n    left: () => { setTuning(t.id, tuning[t.id] - t.step); g.sound('uiTick'); g.events.emit('tuningChanged', { id: t.id }); },\n    right: () => { setTuning(t.id, tuning[t.id] + t.step); g.sound('uiTick'); g.events.emit('tuningChanged', { id: t.id }); },\n    action: () => { resetTuning(t.id); g.sound('uiCancel'); },\n  }));\n  items.push({ label: 'Reset All', action: () => { resetTuning(); g.sound('uiConfirm'); g.ui.toastMsg('All sliders back to their defaults.'); } });\n  const m = pageMenu(g, 'Balance', items);\n  m.promptList = [['confirm', 'Reset this one'], ['back', 'Back']];\n  return m;\n};\nexport function devScreen(g) {\n  const items = [['Time', timePage], ['World', worldPage], ['Player', playerPage], ['Neighbours', neighboursPage], ['Events', eventsPage], ['Collections', collectionsPage], ['Debug', debugPage], ['Save', savePage], ['Balance', balancePage]].map(([label, fn]) => ({ label, action: (gg) => gg.ui.push(fn(gg)) }));\n  items.push({ label: 'Back', action: (gg, m) => gg.ui.pop(m) });\n  const m = new Menu({ id: 'dev', title: 'Dev Mode', items, x: 130, y: 44, w: 220, itemH: 19, gap: 2, back: (gg, mm) => gg.ui.pop(mm) });\n  m.perPage = 10;\n  return m;\n}\nexport { calendar, FESTIVALS, CONTESTS, LANDMARKS, CITY_DOORS, sendMail, rebuildAllObjects };\nEOF\nmkdir -p src/net; cat > src/net/visitUi.js <<'EOF'\nimport { Menu } from '../ui/ui.js';\nexport function visitMenu(g) { return new Menu({ id: 'visit', title: 'Visit', items: [{ label: 'Back', action: (gg, m) => gg.ui.pop(m) }], x: 150, y: 90, w: 180, back: (gg, m) => gg.ui.pop(m) }); }\nEOF\ncat > src/main.js <<'EOF'\n// Page entry: a Hub session opens straight into the round; otherwise the normal start.\nimport { Engine, withUrlOptions, PALETTE } from './engine.js';\nimport { createGame } from './game.js';\n\nconst touchOnly = typeof navigator !== 'undefined' && navigator.maxTouchPoints > 0 && !matchMedia('(any-pointer: fine)').matches;\nfunction failure(message) {\n  const el = document.createElement('div');\n  el.style.cssText = 'position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#1a1c2c;color:#f4f4f4;font:20px monospace;text-align:center;padding:24px';\n  el.textContent = message;\n  el.id = 'no-webgpu';\n  document.body.appendChild(el);\n}\nasync function start() {\n  const hub = globalThis.AIHub;\n  if (hub?.active) {\n    const { startRound } = await import('./net/hubStart.js');\n    const started = await startRound(hub, { touchOnly });\n    if (started) return;\n  }\n  const realNow = Date.now();\n  const game = createGame({ touchOnly, realNow });\n  window.addEventListener('keydown', (e) => {\n    if (e.key === 'Tab' || e.key === 'Escape' || e.key === 'Backspace') e.preventDefault();\n    window.__PIXEL_ENGINE__?.input.send({ t: 'key', key: e.key });\n  });\n  window.addEventListener('contextmenu', (e) => e.preventDefault());\n  try {\n    const engine = await Engine.start(game, withUrlOptions({\n      container: document.getElementById('app'),\n      aspect: 'fixed',\n      quality: 'high',\n      camera: { preset: 'iso', yaw: 45, pitch: 35, zoom: 1.6, minZoom: 1.6, maxZoom: 1.6 },\n      settings: { button: touchOnly ? 'top-right' : false, key: 'honk-if-you-owe' },\n      touch: false, touchBar: false, background: PALETTE.ink,\n    }));\n    setInterval(() => engine.input.send({ t: 'now', ms: Date.now() }), 20000);\n    engine.input.send({ t: 'now', ms: Date.now() });\n    window.addEventListener('beforeunload', () => { game.autosave?.(); });\n  } catch (err) {\n    console.warn(err);\n    failure(`Honk If You Owe needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox 141 on Windows. (${err?.message ?? err})`);\n  }\n}\nif (typeof document !== 'undefined') start();\nEOF\ncat > src/net/hubStart.js <<'EOF'\nexport async function startRound() { return false; }\nEOF\nnode tools/build.mjs 2>&1 | tail -20","description":"Write dev mode, attract, new game flow and main, then build"}}}
