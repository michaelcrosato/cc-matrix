{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkixoEfJ3iDYAE7fGwPz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01G2Xp4DL4x5cDJPx3k2vipT","name":"Bash","input":{"command":"python3 - <<'EOF'\np='tools/genmap.mjs'\ns=open(p).read()\ns=s.replace(\"path(0, 27, 13, 29); // the road out\\npath(8, 29, 9, 41); path(9, 41, 15, 42);\",\"path(0, 27, 14, 29); // the road out\\npath(13, 29, 14, 42); path(8, 40, 15, 42);\")\ns=s.replace(\"path(32, 37, 37, 38); // plaza to bend\",\"path(32, 37, 41, 38); // plaza to bend\")\ns=s.replace(\"path(46, 38, 51, 39); path(46, 39, 66, 40); path(55, 40, 56, 47);\",\"path(46, 38, 51, 39); path(46, 39, 66, 40); path(50, 40, 51, 48); path(50, 48, 56, 48);\")\ns=s.replace(\"path(24, 23, 37, 24); path(42, 24, 56, 25); // upper row across north bridge\",\"path(24, 25, 37, 26); path(42, 24, 56, 25); // upper row across north bridge\")\ns=s.replace(\"path(18, 24, 24, 25); path(20, 31, 23, 32); path(51, 23, 53, 25); path(31, 25, 32, 25);\",\"path(17, 24, 24, 25); path(20, 31, 23, 32); path(51, 23, 53, 25);\")\ns=s.replace('tpath(23, 10, 24, 11); tpath(23, 11, 58, 11);','tpath(22, 10, 24, 11); tpath(23, 11, 37, 11); tpath(36, 12, 37, 13); tpath(42, 12, 43, 13); tpath(42, 11, 58, 11);')\nopen(p,'w').write(s)\nEOF\nnode tools/genmap.mjs > /dev/null\ncat > src/world/tiles.js <<'EOF'\n// What a map character means. Pure: used by collision, nav, terrain and tests.\nimport { TOWN_ROWS } from '../data/townMap.js';\n\nexport const COLS = 80, ROWS = 64;\nconst T = {\n  '.': { surface: 'lawn', h: 0, walk: true },\n  ':': { surface: 'lawn', h: 2, walk: true },\n  '=': { surface: 'path', h: 0, walk: true },\n  '\"': { surface: 'path', h: 2, walk: true },\n  _: { surface: 'plaza', h: 0, walk: true },\n  s: { surface: 'sand', h: 0, walk: true },\n  '~': { water: 'sea', h: -1, walk: false },\n  w: { water: 'river', h: -1, walk: false },\n  o: { water: 'pond', h: -1, walk: false },\n  m: { water: 'mouth', h: -1, walk: false },\n  t: { water: 'sea', h: -1, walk: false },\n  W: { water: 'river', h: 1.2, walk: false, high: true },\n  f: { surface: 'cliff', h: 2, walk: false, fall: true },\n  B: { surface: 'dock', h: 2.04, walk: true, bridge: true },\n  '^': { surface: 'path', h: 0, walk: true, ramp: true },\n  b: { surface: 'dock', h: 0.04, walk: true, bridge: true },\n  d: { surface: 'dock', h: 0.04, walk: true, bridge: true },\n  C: { surface: 'lawn', h: 2, walk: false, cliff: true },\n  '#': { surface: 'lawn', h: 0, walk: false, ring: true },\n  H: { surface: 'lawn', h: 2, walk: false, ring: true },\n};\nexport const tileInfo = (c) => T[c] ?? T['#'];\nexport const tileChar = (x, z) => (x < 0 || z < 0 || x >= COLS || z >= ROWS ? '#' : TOWN_ROWS[z][x]);\nexport const tileAt = (x, z) => tileChar(Math.floor(x), Math.floor(z));\n\n/** The ground's height at a point: a pure function. Ramps run from the terrace (north) to the ground (south). */\nexport function groundHeight(x, z) {\n  const c = tileAt(x, z);\n  if (c === '^') {\n    const z0 = Math.floor(z);\n    let top = z0;\n    while (tileChar(Math.floor(x), top - 1) === '^') top--;\n    let bottom = z0;\n    while (tileChar(Math.floor(x), bottom + 1) === '^') bottom++;\n    const t = (z - top) / (bottom + 1 - top);\n    return 2 * (1 - t);\n  }\n  const info = tileInfo(c);\n  return info.h;\n}\nexport const isWaterTile = (x, z) => !!tileInfo(tileAt(x, z)).water;\nexport const waterKind = (x, z) => tileInfo(tileAt(x, z)).water ?? null;\nexport const walkableTile = (x, z) => tileInfo(tileAt(x, z)).walk === true;\nexport const acreOf = (x, z) => ({ col: Math.min(4, Math.max(0, Math.floor(x / 16))), row: Math.min(3, Math.max(0, Math.floor(z / 16))) });\nexport const key = (x, z) => `${Math.floor(x)},${Math.floor(z)}`;\nexport const unkey = (k) => k.split(',').map(Number);\nEOF\ncat > src/art/textures.js <<'EOF'\n// Quiet ground and the game's own pixel textures, as data. Paintings live in art/paintings.js.\nimport { textureDef, TEXTURE_LIBRARY, TextureCatalog } from '../engine.js';\n\nconst full = (c) => ({ path: 'M0 0H32V32H0Z', fill: c });\nconst quiet = (id, about, a, b, c, count = 9, seed = 4) => textureDef({\n  id, about, tags: ['surface'], size: [32, 32], tile: true,\n  palette: c ? { a, b, c } : { a, b },\n  layers: [full('a'), { pattern: 'scatter', colors: c ? ['b', 'c'] : ['b'], count, size: 1, seed }],\n});\n\nexport const SURFACES = [\n  quiet('lawn-spring', 'Spring lawn: lime with green and white specks', 'lime', 'green', 'white', 10, 4),\n  quiet('lawn-summer', 'Summer lawn: green with lime specks', 'green', 'lime', null, 9, 4),\n  quiet('lawn-autumn', 'Autumn lawn: sand with orange specks', 'sand', 'orange', null, 9, 7),\n  quiet('lawn-winter', 'Winter lawn: snow with mist specks', 'white', 'mist', null, 7, 2),\n  quiet('path-spring', 'Spring path: sand with orange specks', 'sand', 'orange', null, 7, 11),\n  quiet('path-summer', 'Summer path: sand with orange specks', 'sand', 'orange', null, 7, 11),\n  quiet('path-autumn', 'Autumn path: orange with red specks', 'orange', 'red', null, 7, 12),\n  quiet('path-winter', 'Winter path: mist with slate specks', 'mist', 'slate', null, 6, 13),\n  quiet('sand-spring', 'Beach sand', 'sand', 'white', null, 8, 5),\n  quiet('sand-summer', 'Beach sand', 'sand', 'white', null, 8, 5),\n  quiet('sand-autumn', 'Pale autumn beach', 'white', 'sand', null, 8, 5),\n  quiet('sand-winter', 'Frosted beach', 'white', 'mist', 'sky', 6, 5),\n  textureDef({ id: 'plaza-warm', about: 'Plaza paving, big quiet slabs', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'mist', b: 'slate' },\n    layers: [full('a'), { pattern: 'tiles', colors: ['b', 'a', 'a'], w: 16, h: 16, mortar: 1, seed: 3 }] }),\n  textureDef({ id: 'plaza-winter', about: 'Plaza paving under snow', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'white', b: 'mist' },\n    layers: [full('a'), { pattern: 'tiles', colors: ['b', 'a', 'a'], w: 16, h: 16, mortar: 1, seed: 3 }] }),\n  textureDef({ id: 'cliff-warm', about: 'Cliff face, layered rock', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'slate', b: 'night', c: 'mist' },\n    layers: [full('a'), { pattern: 'bricks', colors: ['b', 'a', 'a'], w: 16, h: 8, mortar: 1, offset: 0.5, seed: 8 }, { pattern: 'scatter', colors: ['c'], count: 6, size: 1, seed: 2 }] }),\n  textureDef({ id: 'bank-warm', about: 'River bank earth', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'plum', b: 'night' },\n    layers: [full('a'), { pattern: 'scatter', colors: ['b'], count: 10, size: 1, seed: 9 }] }),\n  textureDef({ id: 'dock-boards', about: 'Dock and bridge boards', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'orange', b: 'red', c: 'plum' },\n    layers: [{ pattern: 'planks', colors: ['c', 'b', 'a'], w: 8, gap: 1, length: 32, grain: 1, seed: 6 }] }),\n  textureDef({ id: 'city-pavement', about: 'City pavement', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'slate', b: 'night' },\n    layers: [full('a'), { pattern: 'tiles', colors: ['b', 'a', 'a'], w: 8, h: 8, mortar: 1, seed: 4 }] }),\n  textureDef({ id: 'city-road', about: 'City road, dark', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'night', b: 'ink' },\n    layers: [full('a'), { pattern: 'scatter', colors: ['b'], count: 8, size: 1, seed: 8 }] }),\n];\n\n// Floors and wallpaper the player can buy: id → texture.\nconst planks = (id, a, b, c) => textureDef({ id, about: `Floor boards ${id}`, tags: ['surface', 'floor'], size: [32, 32], tile: true, palette: { a, b, c },\n  layers: [{ pattern: 'planks', colors: ['c', 'b', 'a'], w: 8, gap: 1, length: 32, grain: 1, seed: 3 }] });\nconst tiles = (id, a, b) => textureDef({ id, about: `Floor tiles ${id}`, tags: ['surface', 'floor'], size: [32, 32], tile: true, palette: { a, b },\n  layers: [{ pattern: 'checker', colors: ['a', 'b'], cell: 8 }] });\nconst plain = (id, a, b) => quiet(id, `Plain ${id}`, a, b, null, 8, 6);\nconst stripes = (id, a, b) => textureDef({ id, about: `Wallpaper stripes ${id}`, tags: ['surface', 'wall'], size: [32, 32], tile: true, palette: { a, b },\n  layers: [{ pattern: 'stripes', colors: ['a', 'b'], width: 4, dir: 'v' }] });\nconst dots = (id, a, b, seed = 7) => textureDef({ id, about: `Wallpaper dots ${id}`, tags: ['surface', 'wall'], size: [32, 32], tile: true, palette: { a, b },\n  layers: [full('a'), { pattern: 'scatter', colors: ['b'], count: 14, size: 2, seed }] });\nconst brick = (id, a, b, c) => textureDef({ id, about: `Wall bricks ${id}`, tags: ['surface', 'wall'], size: [32, 32], tile: true, palette: { a, b, c },\n  layers: [{ pattern: 'bricks', colors: ['a', 'b', 'c'], w: 8, h: 4, seed: 2 }] });\n\nexport const FLOORS = [\n  planks('floor-oak', 'orange', 'red', 'plum'), planks('floor-pine', 'sand', 'orange', 'red'), planks('floor-ash', 'mist', 'slate', 'night'),\n  tiles('floor-chess', 'white', 'night'), tiles('floor-kitchen', 'white', 'sky'), tiles('floor-garish', 'orange', 'plum'),\n  plain('floor-moss', 'green', 'teal'), plain('floor-sandy', 'sand', 'white'), plain('floor-carpet-red', 'red', 'plum'), plain('floor-carpet-blue', 'navy', 'blue'), plain('floor-cheese', 'sand', 'orange'), plain('floor-shag', 'plum', 'red'),\n  planks('floor-gym', 'sand', 'orange', 'plum'), tiles('floor-marble', 'white', 'mist'), plain('floor-night', 'night', 'ink'),\n];\nexport const WALLS = [\n  stripes('wall-cream', 'white', 'sand'), stripes('wall-mint', 'lime', 'white'), stripes('wall-sea', 'sky', 'white'), stripes('wall-plum', 'plum', 'red'),\n  dots('wall-rose', 'red', 'orange'), dots('wall-night', 'navy', 'sand'), dots('wall-spores', 'green', 'lime'), dots('wall-cheese', 'sand', 'orange', 3),\n  brick('wall-brick', 'plum', 'red', 'orange'), brick('wall-stone', 'night', 'slate', 'mist'), plain('wall-plaster', 'white', 'mist'), plain('wall-mud', 'orange', 'red'),\n  plain('wall-teal', 'teal', 'green'), plain('wall-bureau', 'mist', 'slate'), stripes('wall-regal', 'navy', 'plum'), plain('wall-knit', 'orange', 'sand'),\n];\nexport const ALL_TEXTURES = [...SURFACES, ...FLOORS, ...WALLS];\nlet added = false;\nexport function installTextures() {\n  if (added) return;\n  added = true;\n  for (const t of ALL_TEXTURES) TEXTURE_LIBRARY.add(t);\n}\nexport const TEXTURES = new TextureCatalog(ALL_TEXTURES);\nEOF\ncat > src/world/terrainMesh.js <<'EOF'\n// Terrain: 16×16 chunks of merged meshes, one per surface, rebuilt when a tile changes.\nimport { THREE, toonMaterial, PALETTE, textureMap } from '../engine.js';\nimport { COLS, ROWS, tileChar, tileInfo, groundHeight } from './tiles.js';\n\nconst { BufferGeometry, Float32BufferAttribute, Group, Mesh } = THREE;\nconst CHUNK = 16;\nconst SEASON_IDS = ['spring', 'summer', 'autumn', 'winter'];\nconst SEASONAL = { lawn: true, path: true, sand: true };\nconst matCache = new Map();\nexport function surfaceMaterial(surface, season) {\n  const s = SEASON_IDS[season];\n  const id = SEASONAL[surface] ? `${surface}-${s}`\n    : surface === 'plaza' ? (season === 3 ? 'plaza-winter' : 'plaza-warm')\n      : surface === 'cliff' ? 'cliff-warm' : surface === 'bank' ? 'bank-warm' : surface === 'dock' ? 'dock-boards' : surface === 'worn' ? `path-${s}` : surface;\n  let m = matCache.get(id);\n  if (!m) matCache.set(id, (m = toonMaterial(PALETTE.white, { map: textureMap(id) })));\n  return m;\n}\nconst TILE_M = 4; // a 32-texel tile at 8 texels a metre covers 4 m\n\nclass Builder {\n  constructor() { this.s = new Map(); }\n  get(surface) {\n    let b = this.s.get(surface);\n    if (!b) this.s.set(surface, (b = { pos: [], nor: [], uv: [], idx: [] }));\n    return b;\n  }\n  quad(surface, a, b, c, d, n, uvA, uvB, uvC, uvD) {\n    const q = this.get(surface);\n    const i = q.pos.length / 3;\n    q.pos.push(...a, ...b, ...c, ...d);\n    for (let k = 0; k < 4; k++) q.nor.push(...n);\n    q.uv.push(...uvA, ...uvB, ...uvC, ...uvD);\n    q.idx.push(i, i + 1, i + 2, i, i + 2, i + 3);\n  }\n}\nconst topUV = (x, z) => [x / TILE_M, z / TILE_M];\n\nfunction addTile(b, x, z, surfaceOf) {\n  const c = tileChar(x, z);\n  const info = tileInfo(c);\n  const heightAt = (px, pz) => groundHeight(px, pz);\n  const hT = info.h;\n  if (!info.water) {\n    const surface = surfaceOf(x, z, info);\n    if (info.ramp) {\n      const hN = heightAt(x + 0.5, z + 0.001);\n      const hS = heightAt(x + 0.5, z + 0.999);\n      const n = [0, 4, 2 * (hN - hS)];\n      b.quad(surface, [x, hN, z], [x, hS, z + 1], [x + 1, hS, z + 1], [x + 1, hN, z], n, topUV(x, z), topUV(x, z + 1), topUV(x + 1, z + 1), topUV(x + 1, z));\n    } else {\n      b.quad(surface, [x, hT, z], [x, hT, z + 1], [x + 1, hT, z + 1], [x + 1, hT, z], [0, 1, 0], topUV(x, z), topUV(x, z + 1), topUV(x + 1, z + 1), topUV(x + 1, z));\n    }\n  }\n  // Side faces down to the neighbour on each side.\n  const myTop = info.water ? null : hT;\n  if (myTop === null) return;\n  const side = (nx, nz, ax, az, bx, bz, n) => {\n    const nc = tileChar(nx, nz);\n    const ni = tileInfo(nc);\n    const nh = ni.water ? -1.2 : ni.ramp ? Math.min(groundHeight(nx + 0.5, nz + 0.05), groundHeight(nx + 0.5, nz + 0.95)) : ni.h;\n    if (info.ramp) return;\n    if (nh >= myTop - 0.01) return;\n    const surface = ni.water && myTop < 1 ? 'bank' : myTop >= 1 ? 'cliff' : 'bank';\n    const h = myTop - nh;\n    const len = Math.hypot(ax - bx, az - bz);\n    const u0 = (ax + az) / TILE_M, u1 = u0 + len / TILE_M;\n    b.quad(surface, [ax, myTop, az], [ax, nh, az], [bx, nh, bz], [bx, myTop, bz], n, [u0, myTop / TILE_M], [u0, (myTop - h) / TILE_M], [u1, (myTop - h) / TILE_M], [u1, myTop / TILE_M]);\n  };\n  side(x, z + 1, x, z + 1, x + 1, z + 1, [0, 0, 1]);\n  side(x + 1, z, x + 1, z + 1, x + 1, z, [1, 0, 0]);\n  side(x, z - 1, x + 1, z, x, z, [0, 0, -1]);\n  side(x - 1, z, x, z, x, z + 1, [-1, 0, 0]);\n}\nfunction geometryOf(q) {\n  const g = new BufferGeometry();\n  g.setAttribute('position', new Float32BufferAttribute(q.pos, 3));\n  g.setAttribute('normal', new Float32BufferAttribute(q.nor, 3));\n  g.setAttribute('uv', new Float32BufferAttribute(q.uv, 2));\n  g.setIndex(q.idx);\n  g.computeBoundingSphere();\n  return g;\n}\n\nexport class TownTerrain {\n  /** @param surfaceOf (x, z, info) → surface name: gives worn paths their say. */\n  constructor(surfaceOf) {\n    this.group = new Group();\n    this.surfaceOf = surfaceOf;\n    this.season = 1;\n    this.chunks = new Map();\n    this.groundHeight = groundHeight;\n    for (let cz = 0; cz < Math.ceil(ROWS / CHUNK); cz++) for (let cx = 0; cx < Math.ceil(COLS / CHUNK); cx++) this.buildChunk(cx, cz);\n  }\n  buildChunk(cx, cz) {\n    const k = `${cx},${cz}`;\n    const old = this.chunks.get(k);\n    if (old) for (const m of old) { this.group.remove(m); m.geometry.dispose(); }\n    const b = new Builder();\n    for (let z = cz * CHUNK; z < Math.min(ROWS, (cz + 1) * CHUNK); z++) for (let x = cx * CHUNK; x < Math.min(COLS, (cx + 1) * CHUNK); x++) addTile(b, x, z, this.surfaceOf);\n    const meshes = [];\n    for (const [surface, q] of b.s) {\n      const mesh = new Mesh(geometryOf(q), surfaceMaterial(surface, this.season));\n      mesh.userData.surface = surface;\n      mesh.receiveShadow = true;\n      this.group.add(mesh);\n      meshes.push(mesh);\n    }\n    this.chunks.set(k, meshes);\n  }\n  rebuildTile(x, z) { this.buildChunk(Math.floor(x / CHUNK), Math.floor(z / CHUNK)); }\n  setSeason(season) {\n    this.season = season;\n    for (const list of this.chunks.values()) for (const m of list) m.material = surfaceMaterial(m.userData.surface, season);\n  }\n}\nEOF\ngrep -n \"pattern: 'planks'\\|pattern: 'tiles'\\|stripes\\b.*dir\\|dir:\" kit/LIBRARY.md | head -3; grep -n \"stripes\\|checker\" kit/types/engine/texture/*.d.ts | head; echo ok","description":"Write tile rules, textures and chunked terrain mesh"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6990,"cache_read_input_tokens":204804,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6990},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"51f47472-8843-4ed2-a558-b48965608f72","timestamp":"2026-11-06T00:27:21.925Z","request_id":"req_011CgkixnwojmLBJViAvvJx2","wire_tool_inputs":{"toolu_01G2Xp4DL4x5cDJPx3k2vipT":{"command":"python3 - <<'EOF'\np='tools/genmap.mjs'\ns=open(p).read()\ns=s.replace(\"path(0, 27, 13, 29); // the road out\\npath(8, 29, 9, 41); path(9, 41, 15, 42);\",\"path(0, 27, 14, 29); // the road out\\npath(13, 29, 14, 42); path(8, 40, 15, 42);\")\ns=s.replace(\"path(32, 37, 37, 38); // plaza to bend\",\"path(32, 37, 41, 38); // plaza to bend\")\ns=s.replace(\"path(46, 38, 51, 39); path(46, 39, 66, 40); path(55, 40, 56, 47);\",\"path(46, 38, 51, 39); path(46, 39, 66, 40); path(50, 40, 51, 48); path(50, 48, 56, 48);\")\ns=s.replace(\"path(24, 23, 37, 24); path(42, 24, 56, 25); // upper row across north bridge\",\"path(24, 25, 37, 26); path(42, 24, 56, 25); // upper row across north bridge\")\ns=s.replace(\"path(18, 24, 24, 25); path(20, 31, 23, 32); path(51, 23, 53, 25); path(31, 25, 32, 25);\",\"path(17, 24, 24, 25); path(20, 31, 23, 32); path(51, 23, 53, 25);\")\ns=s.replace('tpath(23, 10, 24, 11); tpath(23, 11, 58, 11);','tpath(22, 10, 24, 11); tpath(23, 11, 37, 11); tpath(36, 12, 37, 13); tpath(42, 12, 43, 13); tpath(42, 11, 58, 11);')\nopen(p,'w').write(s)\nEOF\nnode tools/genmap.mjs > /dev/null\ncat > src/world/tiles.js <<'EOF'\n// What a map character means. Pure: used by collision, nav, terrain and tests.\nimport { TOWN_ROWS } from '../data/townMap.js';\n\nexport const COLS = 80, ROWS = 64;\nconst T = {\n  '.': { surface: 'lawn', h: 0, walk: true },\n  ':': { surface: 'lawn', h: 2, walk: true },\n  '=': { surface: 'path', h: 0, walk: true },\n  '\"': { surface: 'path', h: 2, walk: true },\n  _: { surface: 'plaza', h: 0, walk: true },\n  s: { surface: 'sand', h: 0, walk: true },\n  '~': { water: 'sea', h: -1, walk: false },\n  w: { water: 'river', h: -1, walk: false },\n  o: { water: 'pond', h: -1, walk: false },\n  m: { water: 'mouth', h: -1, walk: false },\n  t: { water: 'sea', h: -1, walk: false },\n  W: { water: 'river', h: 1.2, walk: false, high: true },\n  f: { surface: 'cliff', h: 2, walk: false, fall: true },\n  B: { surface: 'dock', h: 2.04, walk: true, bridge: true },\n  '^': { surface: 'path', h: 0, walk: true, ramp: true },\n  b: { surface: 'dock', h: 0.04, walk: true, bridge: true },\n  d: { surface: 'dock', h: 0.04, walk: true, bridge: true },\n  C: { surface: 'lawn', h: 2, walk: false, cliff: true },\n  '#': { surface: 'lawn', h: 0, walk: false, ring: true },\n  H: { surface: 'lawn', h: 2, walk: false, ring: true },\n};\nexport const tileInfo = (c) => T[c] ?? T['#'];\nexport const tileChar = (x, z) => (x < 0 || z < 0 || x >= COLS || z >= ROWS ? '#' : TOWN_ROWS[z][x]);\nexport const tileAt = (x, z) => tileChar(Math.floor(x), Math.floor(z));\n\n/** The ground's height at a point: a pure function. Ramps run from the terrace (north) to the ground (south). */\nexport function groundHeight(x, z) {\n  const c = tileAt(x, z);\n  if (c === '^') {\n    const z0 = Math.floor(z);\n    let top = z0;\n    while (tileChar(Math.floor(x), top - 1) === '^') top--;\n    let bottom = z0;\n    while (tileChar(Math.floor(x), bottom + 1) === '^') bottom++;\n    const t = (z - top) / (bottom + 1 - top);\n    return 2 * (1 - t);\n  }\n  const info = tileInfo(c);\n  return info.h;\n}\nexport const isWaterTile = (x, z) => !!tileInfo(tileAt(x, z)).water;\nexport const waterKind = (x, z) => tileInfo(tileAt(x, z)).water ?? null;\nexport const walkableTile = (x, z) => tileInfo(tileAt(x, z)).walk === true;\nexport const acreOf = (x, z) => ({ col: Math.min(4, Math.max(0, Math.floor(x / 16))), row: Math.min(3, Math.max(0, Math.floor(z / 16))) });\nexport const key = (x, z) => `${Math.floor(x)},${Math.floor(z)}`;\nexport const unkey = (k) => k.split(',').map(Number);\nEOF\ncat > src/art/textures.js <<'EOF'\n// Quiet ground and the game's own pixel textures, as data. Paintings live in art/paintings.js.\nimport { textureDef, TEXTURE_LIBRARY, TextureCatalog } from '../engine.js';\n\nconst full = (c) => ({ path: 'M0 0H32V32H0Z', fill: c });\nconst quiet = (id, about, a, b, c, count = 9, seed = 4) => textureDef({\n  id, about, tags: ['surface'], size: [32, 32], tile: true,\n  palette: c ? { a, b, c } : { a, b },\n  layers: [full('a'), { pattern: 'scatter', colors: c ? ['b', 'c'] : ['b'], count, size: 1, seed }],\n});\n\nexport const SURFACES = [\n  quiet('lawn-spring', 'Spring lawn: lime with green and white specks', 'lime', 'green', 'white', 10, 4),\n  quiet('lawn-summer', 'Summer lawn: green with lime specks', 'green', 'lime', null, 9, 4),\n  quiet('lawn-autumn', 'Autumn lawn: sand with orange specks', 'sand', 'orange', null, 9, 7),\n  quiet('lawn-winter', 'Winter lawn: snow with mist specks', 'white', 'mist', null, 7, 2),\n  quiet('path-spring', 'Spring path: sand with orange specks', 'sand', 'orange', null, 7, 11),\n  quiet('path-summer', 'Summer path: sand with orange specks', 'sand', 'orange', null, 7, 11),\n  quiet('path-autumn', 'Autumn path: orange with red specks', 'orange', 'red', null, 7, 12),\n  quiet('path-winter', 'Winter path: mist with slate specks', 'mist', 'slate', null, 6, 13),\n  quiet('sand-spring', 'Beach sand', 'sand', 'white', null, 8, 5),\n  quiet('sand-summer', 'Beach sand', 'sand', 'white', null, 8, 5),\n  quiet('sand-autumn', 'Pale autumn beach', 'white', 'sand', null, 8, 5),\n  quiet('sand-winter', 'Frosted beach', 'white', 'mist', 'sky', 6, 5),\n  textureDef({ id: 'plaza-warm', about: 'Plaza paving, big quiet slabs', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'mist', b: 'slate' },\n    layers: [full('a'), { pattern: 'tiles', colors: ['b', 'a', 'a'], w: 16, h: 16, mortar: 1, seed: 3 }] }),\n  textureDef({ id: 'plaza-winter', about: 'Plaza paving under snow', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'white', b: 'mist' },\n    layers: [full('a'), { pattern: 'tiles', colors: ['b', 'a', 'a'], w: 16, h: 16, mortar: 1, seed: 3 }] }),\n  textureDef({ id: 'cliff-warm', about: 'Cliff face, layered rock', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'slate', b: 'night', c: 'mist' },\n    layers: [full('a'), { pattern: 'bricks', colors: ['b', 'a', 'a'], w: 16, h: 8, mortar: 1, offset: 0.5, seed: 8 }, { pattern: 'scatter', colors: ['c'], count: 6, size: 1, seed: 2 }] }),\n  textureDef({ id: 'bank-warm', about: 'River bank earth', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'plum', b: 'night' },\n    layers: [full('a'), { pattern: 'scatter', colors: ['b'], count: 10, size: 1, seed: 9 }] }),\n  textureDef({ id: 'dock-boards', about: 'Dock and bridge boards', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'orange', b: 'red', c: 'plum' },\n    layers: [{ pattern: 'planks', colors: ['c', 'b', 'a'], w: 8, gap: 1, length: 32, grain: 1, seed: 6 }] }),\n  textureDef({ id: 'city-pavement', about: 'City pavement', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'slate', b: 'night' },\n    layers: [full('a'), { pattern: 'tiles', colors: ['b', 'a', 'a'], w: 8, h: 8, mortar: 1, seed: 4 }] }),\n  textureDef({ id: 'city-road', about: 'City road, dark', tags: ['surface'], size: [32, 32], tile: true, palette: { a: 'night', b: 'ink' },\n    layers: [full('a'), { pattern: 'scatter', colors: ['b'], count: 8, size: 1, seed: 8 }] }),\n];\n\n// Floors and wallpaper the player can buy: id → texture.\nconst planks = (id, a, b, c) => textureDef({ id, about: `Floor boards ${id}`, tags: ['surface', 'floor'], size: [32, 32], tile: true, palette: { a, b, c },\n  layers: [{ pattern: 'planks', colors: ['c', 'b', 'a'], w: 8, gap: 1, length: 32, grain: 1, seed: 3 }] });\nconst tiles = (id, a, b) => textureDef({ id, about: `Floor tiles ${id}`, tags: ['surface', 'floor'], size: [32, 32], tile: true, palette: { a, b },\n  layers: [{ pattern: 'checker', colors: ['a', 'b'], cell: 8 }] });\nconst plain = (id, a, b) => quiet(id, `Plain ${id}`, a, b, null, 8, 6);\nconst stripes = (id, a, b) => textureDef({ id, about: `Wallpaper stripes ${id}`, tags: ['surface', 'wall'], size: [32, 32], tile: true, palette: { a, b },\n  layers: [{ pattern: 'stripes', colors: ['a', 'b'], width: 4, dir: 'v' }] });\nconst dots = (id, a, b, seed = 7) => textureDef({ id, about: `Wallpaper dots ${id}`, tags: ['surface', 'wall'], size: [32, 32], tile: true, palette: { a, b },\n  layers: [full('a'), { pattern: 'scatter', colors: ['b'], count: 14, size: 2, seed }] });\nconst brick = (id, a, b, c) => textureDef({ id, about: `Wall bricks ${id}`, tags: ['surface', 'wall'], size: [32, 32], tile: true, palette: { a, b, c },\n  layers: [{ pattern: 'bricks', colors: ['a', 'b', 'c'], w: 8, h: 4, seed: 2 }] });\n\nexport const FLOORS = [\n  planks('floor-oak', 'orange', 'red', 'plum'), planks('floor-pine', 'sand', 'orange', 'red'), planks('floor-ash', 'mist', 'slate', 'night'),\n  tiles('floor-chess', 'white', 'night'), tiles('floor-kitchen', 'white', 'sky'), tiles('floor-garish', 'orange', 'plum'),\n  plain('floor-moss', 'green', 'teal'), plain('floor-sandy', 'sand', 'white'), plain('floor-carpet-red', 'red', 'plum'), plain('floor-carpet-blue', 'navy', 'blue'), plain('floor-cheese', 'sand', 'orange'), plain('floor-shag', 'plum', 'red'),\n  planks('floor-gym', 'sand', 'orange', 'plum'), tiles('floor-marble', 'white', 'mist'), plain('floor-night', 'night', 'ink'),\n];\nexport const WALLS = [\n  stripes('wall-cream', 'white', 'sand'), stripes('wall-mint', 'lime', 'white'), stripes('wall-sea', 'sky', 'white'), stripes('wall-plum', 'plum', 'red'),\n  dots('wall-rose', 'red', 'orange'), dots('wall-night', 'navy', 'sand'), dots('wall-spores', 'green', 'lime'), dots('wall-cheese', 'sand', 'orange', 3),\n  brick('wall-brick', 'plum', 'red', 'orange'), brick('wall-stone', 'night', 'slate', 'mist'), plain('wall-plaster', 'white', 'mist'), plain('wall-mud', 'orange', 'red'),\n  plain('wall-teal', 'teal', 'green'), plain('wall-bureau', 'mist', 'slate'), stripes('wall-regal', 'navy', 'plum'), plain('wall-knit', 'orange', 'sand'),\n];\nexport const ALL_TEXTURES = [...SURFACES, ...FLOORS, ...WALLS];\nlet added = false;\nexport function installTextures() {\n  if (added) return;\n  added = true;\n  for (const t of ALL_TEXTURES) TEXTURE_LIBRARY.add(t);\n}\nexport const TEXTURES = new TextureCatalog(ALL_TEXTURES);\nEOF\ncat > src/world/terrainMesh.js <<'EOF'\n// Terrain: 16×16 chunks of merged meshes, one per surface, rebuilt when a tile changes.\nimport { THREE, toonMaterial, PALETTE, textureMap } from '../engine.js';\nimport { COLS, ROWS, tileChar, tileInfo, groundHeight } from './tiles.js';\n\nconst { BufferGeometry, Float32BufferAttribute, Group, Mesh } = THREE;\nconst CHUNK = 16;\nconst SEASON_IDS = ['spring', 'summer', 'autumn', 'winter'];\nconst SEASONAL = { lawn: true, path: true, sand: true };\nconst matCache = new Map();\nexport function surfaceMaterial(surface, season) {\n  const s = SEASON_IDS[season];\n  const id = SEASONAL[surface] ? `${surface}-${s}`\n    : surface === 'plaza' ? (season === 3 ? 'plaza-winter' : 'plaza-warm')\n      : surface === 'cliff' ? 'cliff-warm' : surface === 'bank' ? 'bank-warm' : surface === 'dock' ? 'dock-boards' : surface === 'worn' ? `path-${s}` : surface;\n  let m = matCache.get(id);\n  if (!m) matCache.set(id, (m = toonMaterial(PALETTE.white, { map: textureMap(id) })));\n  return m;\n}\nconst TILE_M = 4; // a 32-texel tile at 8 texels a metre covers 4 m\n\nclass Builder {\n  constructor() { this.s = new Map(); }\n  get(surface) {\n    let b = this.s.get(surface);\n    if (!b) this.s.set(surface, (b = { pos: [], nor: [], uv: [], idx: [] }));\n    return b;\n  }\n  quad(surface, a, b, c, d, n, uvA, uvB, uvC, uvD) {\n    const q = this.get(surface);\n    const i = q.pos.length / 3;\n    q.pos.push(...a, ...b, ...c, ...d);\n    for (let k = 0; k < 4; k++) q.nor.push(...n);\n    q.uv.push(...uvA, ...uvB, ...uvC, ...uvD);\n    q.idx.push(i, i + 1, i + 2, i, i + 2, i + 3);\n  }\n}\nconst topUV = (x, z) => [x / TILE_M, z / TILE_M];\n\nfunction addTile(b, x, z, surfaceOf) {\n  const c = tileChar(x, z);\n  const info = tileInfo(c);\n  const heightAt = (px, pz) => groundHeight(px, pz);\n  const hT = info.h;\n  if (!info.water) {\n    const surface = surfaceOf(x, z, info);\n    if (info.ramp) {\n      const hN = heightAt(x + 0.5, z + 0.001);\n      const hS = heightAt(x + 0.5, z + 0.999);\n      const n = [0, 4, 2 * (hN - hS)];\n      b.quad(surface, [x, hN, z], [x, hS, z + 1], [x + 1, hS, z + 1], [x + 1, hN, z], n, topUV(x, z), topUV(x, z + 1), topUV(x + 1, z + 1), topUV(x + 1, z));\n    } else {\n      b.quad(surface, [x, hT, z], [x, hT, z + 1], [x + 1, hT, z + 1], [x + 1, hT, z], [0, 1, 0], topUV(x, z), topUV(x, z + 1), topUV(x + 1, z + 1), topUV(x + 1, z));\n    }\n  }\n  // Side faces down to the neighbour on each side.\n  const myTop = info.water ? null : hT;\n  if (myTop === null) return;\n  const side = (nx, nz, ax, az, bx, bz, n) => {\n    const nc = tileChar(nx, nz);\n    const ni = tileInfo(nc);\n    const nh = ni.water ? -1.2 : ni.ramp ? Math.min(groundHeight(nx + 0.5, nz + 0.05), groundHeight(nx + 0.5, nz + 0.95)) : ni.h;\n    if (info.ramp) return;\n    if (nh >= myTop - 0.01) return;\n    const surface = ni.water && myTop < 1 ? 'bank' : myTop >= 1 ? 'cliff' : 'bank';\n    const h = myTop - nh;\n    const len = Math.hypot(ax - bx, az - bz);\n    const u0 = (ax + az) / TILE_M, u1 = u0 + len / TILE_M;\n    b.quad(surface, [ax, myTop, az], [ax, nh, az], [bx, nh, bz], [bx, myTop, bz], n, [u0, myTop / TILE_M], [u0, (myTop - h) / TILE_M], [u1, (myTop - h) / TILE_M], [u1, myTop / TILE_M]);\n  };\n  side(x, z + 1, x, z + 1, x + 1, z + 1, [0, 0, 1]);\n  side(x + 1, z, x + 1, z + 1, x + 1, z, [1, 0, 0]);\n  side(x, z - 1, x + 1, z, x, z, [0, 0, -1]);\n  side(x - 1, z, x, z, x, z + 1, [-1, 0, 0]);\n}\nfunction geometryOf(q) {\n  const g = new BufferGeometry();\n  g.setAttribute('position', new Float32BufferAttribute(q.pos, 3));\n  g.setAttribute('normal', new Float32BufferAttribute(q.nor, 3));\n  g.setAttribute('uv', new Float32BufferAttribute(q.uv, 2));\n  g.setIndex(q.idx);\n  g.computeBoundingSphere();\n  return g;\n}\n\nexport class TownTerrain {\n  /** @param surfaceOf (x, z, info) → surface name: gives worn paths their say. */\n  constructor(surfaceOf) {\n    this.group = new Group();\n    this.surfaceOf = surfaceOf;\n    this.season = 1;\n    this.chunks = new Map();\n    this.groundHeight = groundHeight;\n    for (let cz = 0; cz < Math.ceil(ROWS / CHUNK); cz++) for (let cx = 0; cx < Math.ceil(COLS / CHUNK); cx++) this.buildChunk(cx, cz);\n  }\n  buildChunk(cx, cz) {\n    const k = `${cx},${cz}`;\n    const old = this.chunks.get(k);\n    if (old) for (const m of old) { this.group.remove(m); m.geometry.dispose(); }\n    const b = new Builder();\n    for (let z = cz * CHUNK; z < Math.min(ROWS, (cz + 1) * CHUNK); z++) for (let x = cx * CHUNK; x < Math.min(COLS, (cx + 1) * CHUNK); x++) addTile(b, x, z, this.surfaceOf);\n    const meshes = [];\n    for (const [surface, q] of b.s) {\n      const mesh = new Mesh(geometryOf(q), surfaceMaterial(surface, this.season));\n      mesh.userData.surface = surface;\n      mesh.receiveShadow = true;\n      this.group.add(mesh);\n      meshes.push(mesh);\n    }\n    this.chunks.set(k, meshes);\n  }\n  rebuildTile(x, z) { this.buildChunk(Math.floor(x / CHUNK), Math.floor(z / CHUNK)); }\n  setSeason(season) {\n    this.season = season;\n    for (const list of this.chunks.values()) for (const m of list) m.material = surfaceMaterial(m.userData.surface, season);\n  }\n}\nEOF\ngrep -n \"pattern: 'planks'\\|pattern: 'tiles'\\|stripes\\b.*dir\\|dir:\" kit/LIBRARY.md | head -3; grep -n \"stripes\\|checker\" kit/types/engine/texture/*.d.ts | head; echo ok","description":"Write tile rules, textures and chunked terrain mesh"}}}
