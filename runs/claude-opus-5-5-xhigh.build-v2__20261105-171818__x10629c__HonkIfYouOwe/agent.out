{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgknecR1BgnHQ2WW2zPcH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UbwSRS2W8HbkYXcPt8jmrJ","name":"Bash","input":{"command":"cat > src/ui/screens/pockets.js <<'EOF'\n// Pockets: 5×3 big cells, the selected item's name and one sentence, actions on press.\nimport { panel, drawText, textBlock, inRect, dim, textWidth } from '../draw.js';\nimport { drawIcon } from '../../art/icons.js';\nimport { ITEMS } from '../../data/items.js';\nimport { Menu } from '../ui.js';\nimport { pocketActions } from '../../systems/pocketActions.js';\n\nconst CELL = 40, COLS = 5, ROWS = 3;\nconst X0 = 240 - (COLS * CELL) / 2, Y0 = 44;\nclass Grid {\n  constructor({ id, title, onPick, onBack, filter, actions = true }) {\n    this.id = id;\n    this.title = title;\n    this.focus = 0;\n    this.onPick = onPick;\n    this.onBack = onBack;\n    this.filter = filter;\n    this.actions = actions;\n  }\n  labels() { return this.g.world.player.pockets.map((s) => (s ? ITEMS[s.id]?.name : '')); }\n  focusIndex() { return this.focus; }\n  rect(i) { return [X0 + (i % COLS) * CELL, Y0 + Math.floor(i / COLS) * CELL, CELL - 2, CELL - 2]; }\n  update(g, inp) {\n    if (inp.nav.left) { this.focus = (this.focus + 14) % 15; g.sound('uiTick'); }\n    if (inp.nav.right) { this.focus = (this.focus + 1) % 15; g.sound('uiTick'); }\n    if (inp.nav.up) { this.focus = (this.focus + 10) % 15; g.sound('uiTick'); }\n    if (inp.nav.down) { this.focus = (this.focus + 5) % 15; g.sound('uiTick'); }\n    const m = inp.mouse;\n    let clicked = false;\n    for (let i = 0; i < 15; i++) if (inRect(m, ...this.rect(i))) { if (m.moved) this.focus = i; if (m.click) { this.focus = i; clicked = true; } }\n    if (inp.confirm || clicked) this.press(g);\n    else if (inp.back || inp.pockets || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onBack?.(); }\n  }\n  press(g) {\n    const slot = g.world.player.pockets[this.focus];\n    if (!slot) { g.sound('uiError'); return; }\n    if (this.filter && !this.filter(slot, this.focus)) { g.sound('uiError'); return; }\n    g.sound('uiConfirm');\n    if (this.onPick) { g.ui.pop(this); this.onPick(this.focus, slot); return; }\n    const list = pocketActions(g, this.focus, slot);\n    const it = ITEMS[slot.id];\n    const menu = new Menu({ id: 'pocketAction', title: null, items: list.concat([{ label: 'Never mind', action: (gg, m) => gg.ui.pop(m) }]), x: 330, y: 150 - list.length * 10, w: 130, itemH: 18, gap: 2, dim: false, dimBack: false });\n    g.ui.push(menu);\n  }\n  prompts() { return this.onPick ? [['confirm', 'Choose'], ['back', 'Back']] : [['confirm', 'Use'], ['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    const w = g.world.player;\n    panel(hud, X0 - 12, Y0 - 28, COLS * CELL + 22, ROWS * CELL + 88, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, Y0 - 21, this.title, { align: 'center', scale: 2, color: 'ink' });\n    for (let i = 0; i < 15; i++) {\n      const [x, y, cw, ch] = this.rect(i);\n      const slot = w.pockets[i];\n      const focused = i === this.focus;\n      const allowed = !this.filter || !slot || this.filter(slot, i);\n      panel(hud, x, y, cw, ch, { fill: focused ? 'sand' : 'white', trim: focused ? 'orange' : 'mist' });\n      if (slot) {\n        const it = ITEMS[slot.id];\n        drawIcon(hud, x + 3, y + 3, it?.icon ?? 'question', allowed ? it?.iconColors : GREY, 2);\n      }\n    }\n    const s = w.pockets[this.focus];\n    if (s) {\n      const it = ITEMS[s.id];\n      drawText(hud, 240, Y0 + ROWS * CELL + 3, it?.name ?? s.id, { align: 'center', color: 'ink' });\n      textBlock(hud, X0 - 4, Y0 + ROWS * CELL + 15, COLS * CELL + 8, it?.line ?? '', { color: 'slate' });\n    } else drawText(hud, 240, Y0 + ROWS * CELL + 3, 'An empty pocket.', { align: 'center', color: 'slate' });\n    this.extraDraw?.(g, hud);\n  }\n}\nconst GREY = { o: 'mist', x: 'mist', w: 'white', '#': 'slate' };\nexport const pocketsScreen = () => new Grid({ id: 'pockets', title: 'Pockets' });\nexport const pocketsPicker = (g, { title, filter, onPick, onCancel, extraDraw }) => { const gr = new Grid({ id: 'pocketPick', title, filter, onPick, onBack: onCancel }); gr.extraDraw = extraDraw; return gr; };\nexport { textWidth };\nEOF\ncat > src/systems/pocketActions.js <<'EOF'\n// What pressing on a thing in your pockets offers. Wear, eat, plant, bury, place.\nimport { ITEMS } from '../data/items.js';\nimport { removeSlot, addItem, addBeans, hasRoom } from './economy.js';\nimport { tileChar, tileInfo } from '../world/tiles.js';\nimport { remember } from './memory.js';\nimport { PATTERN_COLORS } from './patterns.js';\nimport { narrate } from './say.js';\n\nconst closeAll = (g, m) => { g.ui.pop(m); while (g.ui.top && (g.ui.top.id === 'pockets' || g.ui.top.id === 'pocketAction')) g.ui.pop(); };\nfunction frontTile(g) {\n  const p = g.player;\n  return [Math.floor(p.x + Math.sin(p.facing) * 0.9), Math.floor(p.z + Math.cos(p.facing) * 0.9)];\n}\nexport function wear(g, i, slot) {\n  const w = g.world;\n  const it = ITEMS[slot.id];\n  const look = w.player.look;\n  removeSlot(g, i);\n  const giveBack = (id) => { if (id) { if (!addItem(g, id) && false) return; } };\n  if (it.cat === 'clothes') { giveBack(look.outfit); look.outfit = slot.id; look.pattern = null; }\n  else if (it.cat === 'hat') { giveBack(look.hatItem); look.hatItem = slot.id; }\n  else if (it.cat === 'glasses') { giveBack(look.glassesItem); look.glassesItem = slot.id; }\n  else if (it.cat === 'umbrella') { giveBack(look.umbrella); look.umbrella = slot.id; }\n  g.player.applyLook();\n  remember(g, 'outfit', { item: it.name });\n  g.sound('uiConfirm');\n  g.events.emit('wore', { id: slot.id });\n}\nfunction plantable(g, tx, tz) {\n  const inf = tileInfo(tileChar(tx, tz));\n  return inf.walk && inf.surface !== 'dock' && inf.surface !== 'plaza' && !g.world.town.objects[`${tx},${tz}`] && !g.town.solid[tz * 80 + tx];\n}\nexport function pocketActions(g, i, slot) {\n  const w = g.world;\n  const it = ITEMS[slot.id];\n  const out = [];\n  const inTown = g.place === g.town;\n  const atHome = g.place?.key !== undefined;\n  const add = (label, action) => out.push({ label, action });\n  switch (it?.cat) {\n    case 'clothes': case 'hat': case 'glasses': case 'umbrella':\n      add('Wear', (gg, m) => { wear(gg, i, slot); closeAll(gg, m); });\n      break;\n    case 'furniture':\n      if (atHome) add('Place here', (gg, m) => { closeAll(gg, m); gg.openPlacement(i); });\n      break;\n    case 'wall':\n      if (atHome) add('Hang here', (gg, m) => { const r = gg.place.roomData; const old = r.wall; r.wall = slot.id; removeSlot(gg, i); addItem(gg, old); gg.place.rebuild(); gg.events.emit('wallpaper', { id: slot.id }); closeAll(gg, m); });\n      break;\n    case 'floor':\n      if (atHome) add('Lay it here', (gg, m) => { const r = gg.place.roomData; const old = r.floor; r.floor = slot.id; removeSlot(gg, i); addItem(gg, old); gg.place.rebuild(); gg.events.emit('floorLaid', { id: slot.id }); closeAll(gg, m); });\n      break;\n    case 'fruit':\n      add('Eat', (gg, m) => { removeSlot(gg, i); gg.player.pose('Eat'); gg.sound('chew'); gg.events.emit('ate', { id: slot.id }); closeAll(gg, m); gg.ui.toastMsg(`You eat the ${it.name.toLowerCase()}. It's ${it.foreign ? 'not from here' : 'fine'}.`); });\n      if (inTown && (it.foreign || slot.id === 'pear')) add('Plant', (gg, m) => {\n        const [tx, tz] = frontTile(gg);\n        if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not here. Find a clear patch of ground.'); return; }\n        removeSlot(gg, i);\n        w.town.objects[`${tx},${tz}`] = { k: 'sapling', stage: 0, kind: 'pear', fruitItem: slot.id, wet: 0 };\n        gg.town.dirty.add(`${tx},${tz}`);\n        gg.sound('dig');\n        gg.events.emit('planted', { what: slot.id });\n        closeAll(gg, m);\n      });\n      break;\n    case 'plant':\n      if (inTown) add('Plant', (gg, m) => {\n        const [tx, tz] = frontTile(gg);\n        if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not here. Find a clear patch of ground.'); return; }\n        removeSlot(gg, i);\n        w.town.objects[`${tx},${tz}`] = { k: 'sapling', stage: 0, kind: 'pear', wet: 0 };\n        gg.town.dirty.add(`${tx},${tz}`);\n        gg.sound('dig');\n        gg.events.emit('planted', { what: 'sapling' });\n        closeAll(gg, m);\n      });\n      break;\n    case 'seed': case 'flower':\n      if (inTown) add('Plant', (gg, m) => {\n        const [tx, tz] = frontTile(gg);\n        if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not here. Find a clear patch of ground.'); return; }\n        removeSlot(gg, i);\n        const species = it.species;\n        const color = it.color ?? ((tx + tz) % 3);\n        w.town.objects[`${tx},${tz}`] = { k: 'flower', species, color, wet: 0, wilt: 0 };\n        gg.town.dirty.add(`${tx},${tz}`);\n        gg.sound('dirtFall');\n        gg.events.emit('planted', { what: 'flower', species });\n        closeAll(gg, m);\n      });\n      break;\n    case 'bag':\n      add('Open it', (gg, m) => { removeSlot(gg, i); addBeans(gg, it.beans, 'bag'); gg.sound('beanLots'); gg.ui.toastMsg(`+${it.beans.toLocaleString('en-US')} beans`); gg.events.emit('openedBag', {}); closeAll(gg, m); });\n      break;\n    case 'record':\n      if (atHome && g.place.hasFunc('stereo')) add('Play it', (gg, m) => { w.home.stereo = it.song; gg.music.refresh(); closeAll(gg, m); gg.events.emit('stereo', { song: it.song }); });\n      break;\n    default: break;\n  }\n  if (slot.id === 'medicine') add('Take it', (gg, m) => { removeSlot(gg, i); w.player.puffy = false; if (gg.player.eyeL) gg.player.eyeL.scale.x = 1; gg.sound('chew'); gg.ui.toastMsg('You feel told off. Your face goes back.'); gg.events.emit('cured', {}); closeAll(gg, m); });\n  if (slot.id === 'coffeeBean') add('Drink it', (gg, m) => { removeSlot(gg, i); w.player.buffUntil = gg.absMinute() + 120; gg.sound('chew'); closeAll(gg, m); });\n  if (it?.cat !== 'tool' && it?.cat !== 'quest') add('Drop it', (gg, m) => {\n    if (!inTown) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not indoors. Somebody will have words.'); return; }\n    const [tx, tz] = frontTile(gg);\n    if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg(\"There's no room to drop it there.\"); return; }\n    removeSlot(gg, i);\n    w.town.objects[`${tx},${tz}`] = { k: 'drop', item: slot.id };\n    gg.town.dirty.add(`${tx},${tz}`);\n    gg.sound('drop');\n    closeAll(gg, m);\n  });\n  return out;\n}\nexport { PATTERN_COLORS, hasRoom, narrate };\nEOF\ncat > src/systems/actions.js <<'EOF'\n// What pressing does. Data entries (rooms, verbs) name an act; each act is a scene here.\nimport { say, ask, narrate } from './say.js';\nimport { talkTo } from './talk.js';\nimport { addItem, hasRoom, removeSlot, addBeans } from './economy.js';\nimport { ITEMS } from '../data/items.js';\nimport { hostLine } from './lines.js';\nimport { playChime } from './bell.js';\nimport { hourNow } from './time.js';\nimport { day1Mayor } from './dayone.js';\nimport { remember } from './memory.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { SERVICES } from './services.js';\nimport { VENUES } from './venues.js';\nimport { mailScreen } from '../ui/screens/mail.js';\nimport { pocketsPicker } from '../ui/screens/pockets.js';\nimport { busRide } from './bus.js';\nimport { stargaze } from './stargaze.js';\nimport { cheeseState, buyCheese, cheesePriceNow } from './cheese.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { CITY_DOORS } from '../data/cityMap.js';\nimport { saveNow } from './session.js';\nimport { festivalAction } from './festivals/festivals.js';\n\nconst ACTIONS = {\n  npcTalk: (g, t) => talkTo(g, t.npc),\n  *shakeTree(g, t) {\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('ShakeTree');\n    yield 0.25;\n    g.life.shakeTree(t.key, t.obj);\n    g.rumble(0.25, 100);\n    yield 0.4;\n  },\n  *pickObject(g, t) {\n    const w = g.world;\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('PickUp');\n    yield 0.25;\n    if (!hasRoom(w)) { g.ui.toastMsg('Your pockets are full.'); g.sound('uiError'); return; }\n    const it = ITEMS[t.give];\n    addItem(g, t.give);\n    delete w.town.objects[t.key];\n    g.town.dirty.add(t.key);\n    g.sound('pickUp');\n    g.ctx.particles.burst('sparkle', [t.x, 0.3, t.z], { count: 4 });\n    g.events.emit('picked', { id: t.give });\n    if (it?.cat === 'flower') g.events.emit('pickedFlower', {});\n    if (it?.cat === 'shell' || it?.cat === 'oddity') { if (!w.flags[`seen:${t.give}`]) { w.flags[`seen:${t.give}`] = true; yield* narrate(g, `You found ${/^[aeiouAEIOU]/.test(it.name) ? 'an' : 'a'} ${it.name}. ${it.line ?? ''}`); } else g.ui.toastMsg(it.name); }\n    else g.ui.toastMsg(it?.name ?? 'Got it.');\n  },\n  *pullWeed(g, t) {\n    const w = g.world;\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('PickUp');\n    yield 0.25;\n    delete w.town.objects[t.key];\n    g.town.dirty.add(t.key);\n    g.sound('pullWeed');\n    g.ctx.particles.burst('dirt', [t.x, 0.2, t.z], { count: 3 });\n    w.stats.weeds += 1;\n    if (w.stats.weeds % 5 === 0) remember(g, 'weeds', {});\n    g.events.emit('weedPulled', {});\n    if (hasRoom(w) && (w.story.day1Active || w.player.pockets.filter((s) => s?.id === 'weed').length < 2)) addItem(g, 'weed');\n  },\n  *bury(g, t) {\n    const w = g.world;\n    let picked = -2;\n    g.ui.push(pocketsPicker(g, { title: 'Bury what?', filter: (s) => ITEMS[s.id]?.cat === 'bag', onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n    while (picked === -2) yield;\n    if (picked < 0) return;\n    const slot = removeSlot(g, picked);\n    const it = ITEMS[slot.id];\n    w.town.objects[t.hole] = { k: 'beanstalk', stage: 0, beans: it.beans * 3, planted: w.clock.day };\n    g.town.dirty.add(t.hole);\n    g.sound('dirtFall');\n    remember(g, 'plantedBeans', {});\n    g.events.emit('buried', { beans: it.beans });\n    yield* say(g, 'player', ['\"Beans are currency, dear. You can\\'t plant them.\"', '\"You can absolutely plant them. You didn\\'t hear it from me.\"'], { name: 'You remember' });\n  },\n  *lookStalk(g, t) { yield* narrate(g, 'A beanstalk. It looks at you like it has plans. Come back tomorrow.'); },\n  *harvestStalk(g, t) {\n    const w = g.world;\n    g.player.pose('PickUp');\n    yield 0.25;\n    const beans = t.obj.beans ?? 3000;\n    delete w.town.objects[t.key];\n    g.town.dirty.add(t.key);\n    addBeans(g, beans, 'beanstalk');\n    g.sound('beanLots');\n    g.ctx.particles.burst('sparkle', [t.x, 1, t.z], { count: 20, colors: ['sand', 'orange', 'white'] });\n    g.events.emit('harvested', { beans });\n    yield* narrate(g, `The beanstalk gives up ${beans.toLocaleString('en-US')} beans. Mrs. Gander is going to have questions.`);\n  },\n  *snowmanTalk(g, t) {\n    const o = t.obj;\n    if (o.good) yield* say(g, 'player', \"Good proportions. I'm told that's rare. I'll write to you. Don't ask how.\", { name: 'Snowman', voice: 'crowd' });\n    else yield* say(g, 'player', o.ratio <= 0.55 ? 'My head is very small. Is that a comment? It feels like a comment.' : 'My head is nearly the size of my body. I can see over everything. It\\'s awful.', { name: 'Snowman', voice: 'crowd' });\n    if (o.good && !o.mailed) { o.mailed = true; g.world.mail.pending.push({ from: 'snowman', body: \"Dear {player},\\nI've melted a bit. I wanted you to have this while there's still enough of me to post it.\\nA Snowman\", gift: 'bobbleHat', arriveDay: g.world.clock.day + 1 }); }\n  },\n  *crackHint(g) { yield* narrate(g, \"There's a star-shaped crack in the ground. Something's under it. A shovel would be the polite way to ask.\"); },\n  *sitStump(g, t) { yield* sit(g, t.x, t.z); },\n  *sitBench(g, t) { yield* sit(g, t.seat[0], t.seat[1]); },\n  *lookoutBench(g, t) {\n    if (g.isNight()) yield* stargaze(g, t);\n    else yield* sit(g, t.seat[0], t.seat[1]);\n  },\n  *clearPattern(g, t) { delete g.world.town.objects[t.key]; g.town.dirty.add(t.key); },\n  *enterBuilding(g, t) {\n    const w = g.world;\n    const b = t.building;\n    const h = hourNow(w);\n    if (b.id === 'store' && (h < 8 || h >= 22) && !w.story.day1Active) { yield* say(g, 'gander', HOSTS.gander.closed); return; }\n    if (b.id === 'mothwick' && (h < 8 || h >= 22)) { yield* say(g, 'mothwick', \"We're closed! Oh! I'm so sorry! I'm in the middle of something terrible! Come back at eight!\"); return; }\n    if (b.id === 'museum' && !w.museum.open) { yield* say(g, 'quill', [\"We're not open! I've got a whole wing that's just a hat! Come back tomorrow! Bring a fossil!\"]); return; }\n    if (b.id === 'home' && w.story.day1Active && !w.flags.shackEntered) { w.flags.shackEntered = true; }\n    const npcId = Object.keys(NEIGHBOURS).find((n) => NEIGHBOURS[n].building === b.id && g.world.npcs[n].moved === 'here');\n    if (b.id !== 'home' && NEIGHBOURS[npcId]) {\n      const npc = g.npcs.get(npcId);\n      if (!npc.inside) { g.sound('knock'); yield 0.15; g.sound('knock'); yield 0.3; yield* narrate(g, `Nobody's home. Somewhere, ${NEIGHBOURS[npcId].short ?? NEIGHBOURS[npcId].name} is being somebody else's problem.`); return; }\n    }\n    const next = g.rooms.get(b.room);\n    const def = next.def;\n    let tx = def.exit?.x ?? 3, tz = (def.exit?.z ?? 5) - 0.6;\n    if (b.id === 'home') { next.rebuild?.(); tx = next.def.exit.x; tz = next.def.exit.z - 0.6; }\n    yield* g.travel(next, tx, tz, Math.PI);\n    g.events.emit('entered', { room: b.room });\n  },\n  *leaveRoom(g, t) {\n    const e = t.exit;\n    if (e.to === 'town') { yield* g.travel(g.town, e.tx, e.tz, e.facing ?? 0, { sound: 'doorClose' }); g.events.emit('left', {}); return; }\n    if (e.to === 'city') {\n      const d = CITY_DOORS.find((x) => x.id === e.door);\n      yield* g.travel(g.city, d.tx, d.tz + (d.id === 'theatre' || d.id === 'auction' ? 0 : 0.4), d.id === 'theatre' || d.id === 'auction' ? Math.PI / 2 : 0, { sound: 'doorClose' });\n      return;\n    }\n    yield* g.travel(g.rooms.get(e.to), e.tx, e.tz, e.facing ?? 0, { sound: 'doorClose' });\n  },\n  *roomDoor(g, t) {\n    const d = t.door;\n    const r = g.rooms.get(d.to);\n    yield* g.travel(r, d.tx ?? r.def.exit.x, d.tz ?? r.def.exit.z - 0.6, Math.PI);\n    g.events.emit('entered', { room: d.to });\n  },\n  *venueDoor(g, t) {\n    const v = t.venue;\n    const h = hourNow(g.world);\n    if (v.id === 'auction' && (h < 10 || h >= 18)) { yield* narrate(g, \"Pemberton's Auction Rooms. A sign says TEN-TO-SIX-TEN-TO-SIX. It seems to be still going.\"); return; }\n    if (v.id === 'theatre' && (h < 17 && h >= 5)) { yield* narrate(g, 'The Palace Theatre. Evenings only. A very faint voice from inside is telling someone they were robbed.'); return; }\n    const r = g.rooms.get(v.id);\n    yield* g.travel(r, r.def.exit.x, r.def.exit.z - 0.6, Math.PI);\n    g.world.flags.venuesVisited ??= {};\n    g.world.flags.venuesVisited[v.id] = true;\n    g.events.emit('entered', { room: v.id });\n  },\n  *mailbox(g) {\n    const w = g.world;\n    g.sound('mailFlag');\n    let closed = false;\n    g.ui.push(mailScreen(g, () => { closed = true; }));\n    while (!closed) yield;\n  },\n  *ringBell(g) {\n    g.player.pose('Wave', 0.6);\n    playChime(g);\n    g.events.emit('bellRung', {});\n    yield 0.6;\n  },\n  *noticeBoard(g) {\n    const w = g.world;\n    const c = g.cal;\n    const st = cheeseState(w, g.season, w.cheese.day || w.clock.day);\n    const lines = [];\n    lines.push(`NOTICE. Today is ${['Market', 'Errand', 'Show', 'Festival'][c.type]} Day.`);\n    if (c.contest) lines.push(`CONTEST TODAY: ${{ derby: 'the Fishing Derby', bugOff: 'the Bug-Off', snowman: 'the Snowman Contest' }[c.contest]}, 10 till 1. Ask at the plaza.`);\n    if (c.festival) lines.push(`FESTIVAL TODAY: ${{ seedToss: 'the Seed Toss', lanternFloat: 'the Lantern Float', greatSoup: 'the Great Soup', longNight: 'the Long Night' }[c.festival]}.`);\n    if (c.show) lines.push('SHOW TONIGHT: Vesper, on the plaza lamp post, from 7. Bring nothing. She has it.');\n    if (c.market) lines.push('MARKET: Old Rind sells cheese on the plaza from 6 till noon. You did not read this here.');\n    lines.push(`CHEESE: This week's pattern looks like ${st.pattern}. Today's store price: ${cheesePriceNow(g)} beans a wheel. Whoever pinned this has been very careful not to sign it.`);\n    lines.push(`YOUR DEBT: ${w.player.debt.toLocaleString('en-US')} beans. It's on here so everyone can see. Mrs. Gander pinned it herself.`);\n    yield* narrate(g, lines.join('//'));\n    g.events.emit('readBoard', {});\n  },\n  *oldPear(g) {\n    const w = g.world;\n    const lines = ['The Old Pear. Older than the Mayor. Older than the Bell. It has seen everything twice, and fruited.', w.flags.pearLit ? 'It is hung with your lights. It looks embarrassed, in a good way.' : 'Someone has carved \"D + a bowl\" into the bark.'];\n    yield* narrate(g, lines[w.clock.day % 2]);\n  },\n  *busStop(g) {\n    const w = g.world;\n    if (w.story.day1Active) { yield* narrate(g, \"A sign on the stop says: 'Bus suspended pending your errands. Signed, a goose.'\"); return; }\n    if (g.visiting) { g.ui.toastMsg(\"Bus doesn't run while you have company.\"); return; }\n    const c = yield* ask(g, 'hester', 'Big City? It\\'s just the one stop. You\\'ll know it when you\\'re in it.', ['To the City', 'Not today'], { name: 'Sign at the stop', voice: 'hester' });\n    if (c !== 0) return;\n    yield* busRide(g, 'city');\n  },\n  *busHome(g) {\n    const c = yield* ask(g, 'hester', 'Back to the end of the line, is it? Everyone does, in the end.', ['Home', 'Not yet']);\n    if (c !== 0) return;\n    yield* busRide(g, 'town');\n  },\n  *mayorTalk(g) {\n    const w = g.world;\n    const a = g.life.trundle;\n    if (yield* day1Mayor(g)) return;\n    if (w.flags.ribbonGone) yield* say(g, 'trundle', HOSTS.trundle.arrived);\n    else yield* say(g, 'trundle', hostLine(g, 'trundle', w.clock.day % 2 ? 'greet' : 'moving'));\n    if (w.flags.mayorBumped !== w.clock.day) { w.flags.mayorBumped = w.clock.day; addBeans(g, 50, 'mayor'); g.ui.toastMsg('The Mayor tips his sash. +50 beans, for the election.'); }\n    g.events.emit('talkedMayor', {});\n  },\n  *rindTalk(g) {\n    const w = g.world;\n    const st = cheeseState(w, g.season, w.cheese.day || w.clock.day);\n    const c = g.cal;\n    if (!c.market && !w.flags.rindForced) { yield* say(g, 'rind', HOSTS.rind.closed); return; }\n    const choice = yield* ask(g, 'rind', `${hostLine(g, 'rind', 'greet')}//${st.base} beans a wheel. No receipts.`, ['Buy one', 'Buy five', 'What happens to it?', 'Not today']);\n    if (choice === 0 || choice === 1) {\n      const n = choice === 0 ? 1 : 5;\n      if (buyCheese(g, n)) { g.sound('bean'); yield* say(g, 'rind', hostLine(g, 'rind', 'buy')); }\n      else yield* say(g, 'rind', \"Not enough beans. Or not enough pocket. I don't ask which.\");\n    } else if (choice === 2) yield* say(g, 'rind', hostLine(g, 'rind', 'warn'));\n  },\n  *vesperTalk(g) {\n    const w = g.world;\n    yield* say(g, 'vesper', hostLine(g, 'vesper', 'greet'));\n    const moods = ['Quiet', 'Hopeful', 'Blue', 'Upside Down', 'Hungry', 'In Debt'];\n    const c = yield* ask(g, 'vesper', hostLine(g, 'vesper', 'ask'), [moods[(w.clock.day) % 6], moods[(w.clock.day + 2) % 6], moods[(w.clock.day + 4) % 6], 'Just listening']);\n    if (c < 0 || c === 3) return;\n    const idx = (w.clock.day + c * 2) % 6;\n    g.music.setOverride(`vesper${idx}`);\n    g.events.emit('vesperPlays', { idx });\n    g.life.vesper.play('Accordion', 0.2);\n    for (const n of g.npcs.all()) if (!n.inside && n.here) { n.overrideClip = 'Sway'; }\n    const song = `vesper${idx}`;\n    g.scripts.run(g.festivals.singAlong(song, 'vesper', 20), { hold: false, name: 'vesperSing' });\n    yield* narrate(g, 'She plays. The whole plaza goes a bit quiet, and then a bit quieter. Somebody sniffs. It might be Bartleby.');\n    if (!w.records.includes(idx)) {\n      w.records.push(idx);\n      if (hasRoom(w)) { addItem(g, `record${idx}`); yield* say(g, 'vesper', hostLine(g, 'vesper', 'give')); g.sound('reveal'); g.events.emit('gotRecord', { idx }); }\n    }\n    g.ctx.tweens.call(18, () => { g.music.setOverride(null); for (const n of g.npcs.all()) n.overrideClip = null; g.life.vesper.play('VesperHang', 0.2); });\n  },\n  *lighthouseKnock(g) {\n    g.sound('knock');\n    yield 0.2;\n    g.sound('knock');\n    yield 0.5;\n    yield* narrate(g, 'Nobody answers. The light goes round. A note on the door says: \"Back in a moment.\" The note is very old.');\n    g.events.emit('lighthouse', {});\n  },\n  ...SERVICES,\n  ...VENUES,\n};\nfunction* sit(g, x, z) {\n  const p = g.player;\n  p.x = x; p.z = z + 0.05;\n  p.y = g.place.height(x, z) + 0.28;\n  p.facing = 0;\n  p.turnTo = null;\n  p.sitting = true;\n  p.play('Sit', 0.12);\n  g.events.emit('sat', {});\n  yield 0.4;\n  g.frozenHoldSit = true;\n  while (true) {\n    const inp = g.inp;\n    if (inp.confirm || inp.back || inp.mouse.click || Math.hypot(inp.axisX, inp.axisY) > 0.3) break;\n    yield;\n  }\n  p.sitting = false;\n  p.z = z + 0.8;\n  if (g.place.blocked(p.x, p.z)) p.z = z - 0.8;\n  p.y = g.place.height(p.x, p.z);\n  p.play('Idle', 0.15);\n}\nexport function* runAction(g, t) {\n  const fn = ACTIONS[t.act] ?? ((gg, tt) => festivalAction(gg, tt));\n  const r = fn(g, t);\n  if (r && r.next) yield* r;\n  saveNow(g);\n}\nexport { sit, removeSlot };\nEOF\necho ok","description":"Write pocket actions and the main action registry"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9242,"cache_read_input_tokens":559998,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9242},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"d650ae9e-81d4-49bb-b77a-60b238e17dbc","timestamp":"2026-11-06T01:15:58.205Z","request_id":"req_011Cgknec892N486HURs2jTs","wire_tool_inputs":{"toolu_01UbwSRS2W8HbkYXcPt8jmrJ":{"command":"cat > src/ui/screens/pockets.js <<'EOF'\n// Pockets: 5×3 big cells, the selected item's name and one sentence, actions on press.\nimport { panel, drawText, textBlock, inRect, dim, textWidth } from '../draw.js';\nimport { drawIcon } from '../../art/icons.js';\nimport { ITEMS } from '../../data/items.js';\nimport { Menu } from '../ui.js';\nimport { pocketActions } from '../../systems/pocketActions.js';\n\nconst CELL = 40, COLS = 5, ROWS = 3;\nconst X0 = 240 - (COLS * CELL) / 2, Y0 = 44;\nclass Grid {\n  constructor({ id, title, onPick, onBack, filter, actions = true }) {\n    this.id = id;\n    this.title = title;\n    this.focus = 0;\n    this.onPick = onPick;\n    this.onBack = onBack;\n    this.filter = filter;\n    this.actions = actions;\n  }\n  labels() { return this.g.world.player.pockets.map((s) => (s ? ITEMS[s.id]?.name : '')); }\n  focusIndex() { return this.focus; }\n  rect(i) { return [X0 + (i % COLS) * CELL, Y0 + Math.floor(i / COLS) * CELL, CELL - 2, CELL - 2]; }\n  update(g, inp) {\n    if (inp.nav.left) { this.focus = (this.focus + 14) % 15; g.sound('uiTick'); }\n    if (inp.nav.right) { this.focus = (this.focus + 1) % 15; g.sound('uiTick'); }\n    if (inp.nav.up) { this.focus = (this.focus + 10) % 15; g.sound('uiTick'); }\n    if (inp.nav.down) { this.focus = (this.focus + 5) % 15; g.sound('uiTick'); }\n    const m = inp.mouse;\n    let clicked = false;\n    for (let i = 0; i < 15; i++) if (inRect(m, ...this.rect(i))) { if (m.moved) this.focus = i; if (m.click) { this.focus = i; clicked = true; } }\n    if (inp.confirm || clicked) this.press(g);\n    else if (inp.back || inp.pockets || m.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onBack?.(); }\n  }\n  press(g) {\n    const slot = g.world.player.pockets[this.focus];\n    if (!slot) { g.sound('uiError'); return; }\n    if (this.filter && !this.filter(slot, this.focus)) { g.sound('uiError'); return; }\n    g.sound('uiConfirm');\n    if (this.onPick) { g.ui.pop(this); this.onPick(this.focus, slot); return; }\n    const list = pocketActions(g, this.focus, slot);\n    const it = ITEMS[slot.id];\n    const menu = new Menu({ id: 'pocketAction', title: null, items: list.concat([{ label: 'Never mind', action: (gg, m) => gg.ui.pop(m) }]), x: 330, y: 150 - list.length * 10, w: 130, itemH: 18, gap: 2, dim: false, dimBack: false });\n    g.ui.push(menu);\n  }\n  prompts() { return this.onPick ? [['confirm', 'Choose'], ['back', 'Back']] : [['confirm', 'Use'], ['back', 'Close']]; }\n  draw(g, hud) {\n    dim(hud);\n    const w = g.world.player;\n    panel(hud, X0 - 12, Y0 - 28, COLS * CELL + 22, ROWS * CELL + 88, { fill: 'white', trim: 'sand' });\n    drawText(hud, 240, Y0 - 21, this.title, { align: 'center', scale: 2, color: 'ink' });\n    for (let i = 0; i < 15; i++) {\n      const [x, y, cw, ch] = this.rect(i);\n      const slot = w.pockets[i];\n      const focused = i === this.focus;\n      const allowed = !this.filter || !slot || this.filter(slot, i);\n      panel(hud, x, y, cw, ch, { fill: focused ? 'sand' : 'white', trim: focused ? 'orange' : 'mist' });\n      if (slot) {\n        const it = ITEMS[slot.id];\n        drawIcon(hud, x + 3, y + 3, it?.icon ?? 'question', allowed ? it?.iconColors : GREY, 2);\n      }\n    }\n    const s = w.pockets[this.focus];\n    if (s) {\n      const it = ITEMS[s.id];\n      drawText(hud, 240, Y0 + ROWS * CELL + 3, it?.name ?? s.id, { align: 'center', color: 'ink' });\n      textBlock(hud, X0 - 4, Y0 + ROWS * CELL + 15, COLS * CELL + 8, it?.line ?? '', { color: 'slate' });\n    } else drawText(hud, 240, Y0 + ROWS * CELL + 3, 'An empty pocket.', { align: 'center', color: 'slate' });\n    this.extraDraw?.(g, hud);\n  }\n}\nconst GREY = { o: 'mist', x: 'mist', w: 'white', '#': 'slate' };\nexport const pocketsScreen = () => new Grid({ id: 'pockets', title: 'Pockets' });\nexport const pocketsPicker = (g, { title, filter, onPick, onCancel, extraDraw }) => { const gr = new Grid({ id: 'pocketPick', title, filter, onPick, onBack: onCancel }); gr.extraDraw = extraDraw; return gr; };\nexport { textWidth };\nEOF\ncat > src/systems/pocketActions.js <<'EOF'\n// What pressing on a thing in your pockets offers. Wear, eat, plant, bury, place.\nimport { ITEMS } from '../data/items.js';\nimport { removeSlot, addItem, addBeans, hasRoom } from './economy.js';\nimport { tileChar, tileInfo } from '../world/tiles.js';\nimport { remember } from './memory.js';\nimport { PATTERN_COLORS } from './patterns.js';\nimport { narrate } from './say.js';\n\nconst closeAll = (g, m) => { g.ui.pop(m); while (g.ui.top && (g.ui.top.id === 'pockets' || g.ui.top.id === 'pocketAction')) g.ui.pop(); };\nfunction frontTile(g) {\n  const p = g.player;\n  return [Math.floor(p.x + Math.sin(p.facing) * 0.9), Math.floor(p.z + Math.cos(p.facing) * 0.9)];\n}\nexport function wear(g, i, slot) {\n  const w = g.world;\n  const it = ITEMS[slot.id];\n  const look = w.player.look;\n  removeSlot(g, i);\n  const giveBack = (id) => { if (id) { if (!addItem(g, id) && false) return; } };\n  if (it.cat === 'clothes') { giveBack(look.outfit); look.outfit = slot.id; look.pattern = null; }\n  else if (it.cat === 'hat') { giveBack(look.hatItem); look.hatItem = slot.id; }\n  else if (it.cat === 'glasses') { giveBack(look.glassesItem); look.glassesItem = slot.id; }\n  else if (it.cat === 'umbrella') { giveBack(look.umbrella); look.umbrella = slot.id; }\n  g.player.applyLook();\n  remember(g, 'outfit', { item: it.name });\n  g.sound('uiConfirm');\n  g.events.emit('wore', { id: slot.id });\n}\nfunction plantable(g, tx, tz) {\n  const inf = tileInfo(tileChar(tx, tz));\n  return inf.walk && inf.surface !== 'dock' && inf.surface !== 'plaza' && !g.world.town.objects[`${tx},${tz}`] && !g.town.solid[tz * 80 + tx];\n}\nexport function pocketActions(g, i, slot) {\n  const w = g.world;\n  const it = ITEMS[slot.id];\n  const out = [];\n  const inTown = g.place === g.town;\n  const atHome = g.place?.key !== undefined;\n  const add = (label, action) => out.push({ label, action });\n  switch (it?.cat) {\n    case 'clothes': case 'hat': case 'glasses': case 'umbrella':\n      add('Wear', (gg, m) => { wear(gg, i, slot); closeAll(gg, m); });\n      break;\n    case 'furniture':\n      if (atHome) add('Place here', (gg, m) => { closeAll(gg, m); gg.openPlacement(i); });\n      break;\n    case 'wall':\n      if (atHome) add('Hang here', (gg, m) => { const r = gg.place.roomData; const old = r.wall; r.wall = slot.id; removeSlot(gg, i); addItem(gg, old); gg.place.rebuild(); gg.events.emit('wallpaper', { id: slot.id }); closeAll(gg, m); });\n      break;\n    case 'floor':\n      if (atHome) add('Lay it here', (gg, m) => { const r = gg.place.roomData; const old = r.floor; r.floor = slot.id; removeSlot(gg, i); addItem(gg, old); gg.place.rebuild(); gg.events.emit('floorLaid', { id: slot.id }); closeAll(gg, m); });\n      break;\n    case 'fruit':\n      add('Eat', (gg, m) => { removeSlot(gg, i); gg.player.pose('Eat'); gg.sound('chew'); gg.events.emit('ate', { id: slot.id }); closeAll(gg, m); gg.ui.toastMsg(`You eat the ${it.name.toLowerCase()}. It's ${it.foreign ? 'not from here' : 'fine'}.`); });\n      if (inTown && (it.foreign || slot.id === 'pear')) add('Plant', (gg, m) => {\n        const [tx, tz] = frontTile(gg);\n        if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not here. Find a clear patch of ground.'); return; }\n        removeSlot(gg, i);\n        w.town.objects[`${tx},${tz}`] = { k: 'sapling', stage: 0, kind: 'pear', fruitItem: slot.id, wet: 0 };\n        gg.town.dirty.add(`${tx},${tz}`);\n        gg.sound('dig');\n        gg.events.emit('planted', { what: slot.id });\n        closeAll(gg, m);\n      });\n      break;\n    case 'plant':\n      if (inTown) add('Plant', (gg, m) => {\n        const [tx, tz] = frontTile(gg);\n        if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not here. Find a clear patch of ground.'); return; }\n        removeSlot(gg, i);\n        w.town.objects[`${tx},${tz}`] = { k: 'sapling', stage: 0, kind: 'pear', wet: 0 };\n        gg.town.dirty.add(`${tx},${tz}`);\n        gg.sound('dig');\n        gg.events.emit('planted', { what: 'sapling' });\n        closeAll(gg, m);\n      });\n      break;\n    case 'seed': case 'flower':\n      if (inTown) add('Plant', (gg, m) => {\n        const [tx, tz] = frontTile(gg);\n        if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not here. Find a clear patch of ground.'); return; }\n        removeSlot(gg, i);\n        const species = it.species;\n        const color = it.color ?? ((tx + tz) % 3);\n        w.town.objects[`${tx},${tz}`] = { k: 'flower', species, color, wet: 0, wilt: 0 };\n        gg.town.dirty.add(`${tx},${tz}`);\n        gg.sound('dirtFall');\n        gg.events.emit('planted', { what: 'flower', species });\n        closeAll(gg, m);\n      });\n      break;\n    case 'bag':\n      add('Open it', (gg, m) => { removeSlot(gg, i); addBeans(gg, it.beans, 'bag'); gg.sound('beanLots'); gg.ui.toastMsg(`+${it.beans.toLocaleString('en-US')} beans`); gg.events.emit('openedBag', {}); closeAll(gg, m); });\n      break;\n    case 'record':\n      if (atHome && g.place.hasFunc('stereo')) add('Play it', (gg, m) => { w.home.stereo = it.song; gg.music.refresh(); closeAll(gg, m); gg.events.emit('stereo', { song: it.song }); });\n      break;\n    default: break;\n  }\n  if (slot.id === 'medicine') add('Take it', (gg, m) => { removeSlot(gg, i); w.player.puffy = false; if (gg.player.eyeL) gg.player.eyeL.scale.x = 1; gg.sound('chew'); gg.ui.toastMsg('You feel told off. Your face goes back.'); gg.events.emit('cured', {}); closeAll(gg, m); });\n  if (slot.id === 'coffeeBean') add('Drink it', (gg, m) => { removeSlot(gg, i); w.player.buffUntil = gg.absMinute() + 120; gg.sound('chew'); closeAll(gg, m); });\n  if (it?.cat !== 'tool' && it?.cat !== 'quest') add('Drop it', (gg, m) => {\n    if (!inTown) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg('Not indoors. Somebody will have words.'); return; }\n    const [tx, tz] = frontTile(gg);\n    if (!plantable(gg, tx, tz)) { gg.sound('uiError'); closeAll(gg, m); gg.ui.toastMsg(\"There's no room to drop it there.\"); return; }\n    removeSlot(gg, i);\n    w.town.objects[`${tx},${tz}`] = { k: 'drop', item: slot.id };\n    gg.town.dirty.add(`${tx},${tz}`);\n    gg.sound('drop');\n    closeAll(gg, m);\n  });\n  return out;\n}\nexport { PATTERN_COLORS, hasRoom, narrate };\nEOF\ncat > src/systems/actions.js <<'EOF'\n// What pressing does. Data entries (rooms, verbs) name an act; each act is a scene here.\nimport { say, ask, narrate } from './say.js';\nimport { talkTo } from './talk.js';\nimport { addItem, hasRoom, removeSlot, addBeans } from './economy.js';\nimport { ITEMS } from '../data/items.js';\nimport { hostLine } from './lines.js';\nimport { playChime } from './bell.js';\nimport { hourNow } from './time.js';\nimport { day1Mayor } from './dayone.js';\nimport { remember } from './memory.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { SERVICES } from './services.js';\nimport { VENUES } from './venues.js';\nimport { mailScreen } from '../ui/screens/mail.js';\nimport { pocketsPicker } from '../ui/screens/pockets.js';\nimport { busRide } from './bus.js';\nimport { stargaze } from './stargaze.js';\nimport { cheeseState, buyCheese, cheesePriceNow } from './cheese.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { CITY_DOORS } from '../data/cityMap.js';\nimport { saveNow } from './session.js';\nimport { festivalAction } from './festivals/festivals.js';\n\nconst ACTIONS = {\n  npcTalk: (g, t) => talkTo(g, t.npc),\n  *shakeTree(g, t) {\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('ShakeTree');\n    yield 0.25;\n    g.life.shakeTree(t.key, t.obj);\n    g.rumble(0.25, 100);\n    yield 0.4;\n  },\n  *pickObject(g, t) {\n    const w = g.world;\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('PickUp');\n    yield 0.25;\n    if (!hasRoom(w)) { g.ui.toastMsg('Your pockets are full.'); g.sound('uiError'); return; }\n    const it = ITEMS[t.give];\n    addItem(g, t.give);\n    delete w.town.objects[t.key];\n    g.town.dirty.add(t.key);\n    g.sound('pickUp');\n    g.ctx.particles.burst('sparkle', [t.x, 0.3, t.z], { count: 4 });\n    g.events.emit('picked', { id: t.give });\n    if (it?.cat === 'flower') g.events.emit('pickedFlower', {});\n    if (it?.cat === 'shell' || it?.cat === 'oddity') { if (!w.flags[`seen:${t.give}`]) { w.flags[`seen:${t.give}`] = true; yield* narrate(g, `You found ${/^[aeiouAEIOU]/.test(it.name) ? 'an' : 'a'} ${it.name}. ${it.line ?? ''}`); } else g.ui.toastMsg(it.name); }\n    else g.ui.toastMsg(it?.name ?? 'Got it.');\n  },\n  *pullWeed(g, t) {\n    const w = g.world;\n    g.player.faceToward(t.x, t.z);\n    g.player.pose('PickUp');\n    yield 0.25;\n    delete w.town.objects[t.key];\n    g.town.dirty.add(t.key);\n    g.sound('pullWeed');\n    g.ctx.particles.burst('dirt', [t.x, 0.2, t.z], { count: 3 });\n    w.stats.weeds += 1;\n    if (w.stats.weeds % 5 === 0) remember(g, 'weeds', {});\n    g.events.emit('weedPulled', {});\n    if (hasRoom(w) && (w.story.day1Active || w.player.pockets.filter((s) => s?.id === 'weed').length < 2)) addItem(g, 'weed');\n  },\n  *bury(g, t) {\n    const w = g.world;\n    let picked = -2;\n    g.ui.push(pocketsPicker(g, { title: 'Bury what?', filter: (s) => ITEMS[s.id]?.cat === 'bag', onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n    while (picked === -2) yield;\n    if (picked < 0) return;\n    const slot = removeSlot(g, picked);\n    const it = ITEMS[slot.id];\n    w.town.objects[t.hole] = { k: 'beanstalk', stage: 0, beans: it.beans * 3, planted: w.clock.day };\n    g.town.dirty.add(t.hole);\n    g.sound('dirtFall');\n    remember(g, 'plantedBeans', {});\n    g.events.emit('buried', { beans: it.beans });\n    yield* say(g, 'player', ['\"Beans are currency, dear. You can\\'t plant them.\"', '\"You can absolutely plant them. You didn\\'t hear it from me.\"'], { name: 'You remember' });\n  },\n  *lookStalk(g, t) { yield* narrate(g, 'A beanstalk. It looks at you like it has plans. Come back tomorrow.'); },\n  *harvestStalk(g, t) {\n    const w = g.world;\n    g.player.pose('PickUp');\n    yield 0.25;\n    const beans = t.obj.beans ?? 3000;\n    delete w.town.objects[t.key];\n    g.town.dirty.add(t.key);\n    addBeans(g, beans, 'beanstalk');\n    g.sound('beanLots');\n    g.ctx.particles.burst('sparkle', [t.x, 1, t.z], { count: 20, colors: ['sand', 'orange', 'white'] });\n    g.events.emit('harvested', { beans });\n    yield* narrate(g, `The beanstalk gives up ${beans.toLocaleString('en-US')} beans. Mrs. Gander is going to have questions.`);\n  },\n  *snowmanTalk(g, t) {\n    const o = t.obj;\n    if (o.good) yield* say(g, 'player', \"Good proportions. I'm told that's rare. I'll write to you. Don't ask how.\", { name: 'Snowman', voice: 'crowd' });\n    else yield* say(g, 'player', o.ratio <= 0.55 ? 'My head is very small. Is that a comment? It feels like a comment.' : 'My head is nearly the size of my body. I can see over everything. It\\'s awful.', { name: 'Snowman', voice: 'crowd' });\n    if (o.good && !o.mailed) { o.mailed = true; g.world.mail.pending.push({ from: 'snowman', body: \"Dear {player},\\nI've melted a bit. I wanted you to have this while there's still enough of me to post it.\\nA Snowman\", gift: 'bobbleHat', arriveDay: g.world.clock.day + 1 }); }\n  },\n  *crackHint(g) { yield* narrate(g, \"There's a star-shaped crack in the ground. Something's under it. A shovel would be the polite way to ask.\"); },\n  *sitStump(g, t) { yield* sit(g, t.x, t.z); },\n  *sitBench(g, t) { yield* sit(g, t.seat[0], t.seat[1]); },\n  *lookoutBench(g, t) {\n    if (g.isNight()) yield* stargaze(g, t);\n    else yield* sit(g, t.seat[0], t.seat[1]);\n  },\n  *clearPattern(g, t) { delete g.world.town.objects[t.key]; g.town.dirty.add(t.key); },\n  *enterBuilding(g, t) {\n    const w = g.world;\n    const b = t.building;\n    const h = hourNow(w);\n    if (b.id === 'store' && (h < 8 || h >= 22) && !w.story.day1Active) { yield* say(g, 'gander', HOSTS.gander.closed); return; }\n    if (b.id === 'mothwick' && (h < 8 || h >= 22)) { yield* say(g, 'mothwick', \"We're closed! Oh! I'm so sorry! I'm in the middle of something terrible! Come back at eight!\"); return; }\n    if (b.id === 'museum' && !w.museum.open) { yield* say(g, 'quill', [\"We're not open! I've got a whole wing that's just a hat! Come back tomorrow! Bring a fossil!\"]); return; }\n    if (b.id === 'home' && w.story.day1Active && !w.flags.shackEntered) { w.flags.shackEntered = true; }\n    const npcId = Object.keys(NEIGHBOURS).find((n) => NEIGHBOURS[n].building === b.id && g.world.npcs[n].moved === 'here');\n    if (b.id !== 'home' && NEIGHBOURS[npcId]) {\n      const npc = g.npcs.get(npcId);\n      if (!npc.inside) { g.sound('knock'); yield 0.15; g.sound('knock'); yield 0.3; yield* narrate(g, `Nobody's home. Somewhere, ${NEIGHBOURS[npcId].short ?? NEIGHBOURS[npcId].name} is being somebody else's problem.`); return; }\n    }\n    const next = g.rooms.get(b.room);\n    const def = next.def;\n    let tx = def.exit?.x ?? 3, tz = (def.exit?.z ?? 5) - 0.6;\n    if (b.id === 'home') { next.rebuild?.(); tx = next.def.exit.x; tz = next.def.exit.z - 0.6; }\n    yield* g.travel(next, tx, tz, Math.PI);\n    g.events.emit('entered', { room: b.room });\n  },\n  *leaveRoom(g, t) {\n    const e = t.exit;\n    if (e.to === 'town') { yield* g.travel(g.town, e.tx, e.tz, e.facing ?? 0, { sound: 'doorClose' }); g.events.emit('left', {}); return; }\n    if (e.to === 'city') {\n      const d = CITY_DOORS.find((x) => x.id === e.door);\n      yield* g.travel(g.city, d.tx, d.tz + (d.id === 'theatre' || d.id === 'auction' ? 0 : 0.4), d.id === 'theatre' || d.id === 'auction' ? Math.PI / 2 : 0, { sound: 'doorClose' });\n      return;\n    }\n    yield* g.travel(g.rooms.get(e.to), e.tx, e.tz, e.facing ?? 0, { sound: 'doorClose' });\n  },\n  *roomDoor(g, t) {\n    const d = t.door;\n    const r = g.rooms.get(d.to);\n    yield* g.travel(r, d.tx ?? r.def.exit.x, d.tz ?? r.def.exit.z - 0.6, Math.PI);\n    g.events.emit('entered', { room: d.to });\n  },\n  *venueDoor(g, t) {\n    const v = t.venue;\n    const h = hourNow(g.world);\n    if (v.id === 'auction' && (h < 10 || h >= 18)) { yield* narrate(g, \"Pemberton's Auction Rooms. A sign says TEN-TO-SIX-TEN-TO-SIX. It seems to be still going.\"); return; }\n    if (v.id === 'theatre' && (h < 17 && h >= 5)) { yield* narrate(g, 'The Palace Theatre. Evenings only. A very faint voice from inside is telling someone they were robbed.'); return; }\n    const r = g.rooms.get(v.id);\n    yield* g.travel(r, r.def.exit.x, r.def.exit.z - 0.6, Math.PI);\n    g.world.flags.venuesVisited ??= {};\n    g.world.flags.venuesVisited[v.id] = true;\n    g.events.emit('entered', { room: v.id });\n  },\n  *mailbox(g) {\n    const w = g.world;\n    g.sound('mailFlag');\n    let closed = false;\n    g.ui.push(mailScreen(g, () => { closed = true; }));\n    while (!closed) yield;\n  },\n  *ringBell(g) {\n    g.player.pose('Wave', 0.6);\n    playChime(g);\n    g.events.emit('bellRung', {});\n    yield 0.6;\n  },\n  *noticeBoard(g) {\n    const w = g.world;\n    const c = g.cal;\n    const st = cheeseState(w, g.season, w.cheese.day || w.clock.day);\n    const lines = [];\n    lines.push(`NOTICE. Today is ${['Market', 'Errand', 'Show', 'Festival'][c.type]} Day.`);\n    if (c.contest) lines.push(`CONTEST TODAY: ${{ derby: 'the Fishing Derby', bugOff: 'the Bug-Off', snowman: 'the Snowman Contest' }[c.contest]}, 10 till 1. Ask at the plaza.`);\n    if (c.festival) lines.push(`FESTIVAL TODAY: ${{ seedToss: 'the Seed Toss', lanternFloat: 'the Lantern Float', greatSoup: 'the Great Soup', longNight: 'the Long Night' }[c.festival]}.`);\n    if (c.show) lines.push('SHOW TONIGHT: Vesper, on the plaza lamp post, from 7. Bring nothing. She has it.');\n    if (c.market) lines.push('MARKET: Old Rind sells cheese on the plaza from 6 till noon. You did not read this here.');\n    lines.push(`CHEESE: This week's pattern looks like ${st.pattern}. Today's store price: ${cheesePriceNow(g)} beans a wheel. Whoever pinned this has been very careful not to sign it.`);\n    lines.push(`YOUR DEBT: ${w.player.debt.toLocaleString('en-US')} beans. It's on here so everyone can see. Mrs. Gander pinned it herself.`);\n    yield* narrate(g, lines.join('//'));\n    g.events.emit('readBoard', {});\n  },\n  *oldPear(g) {\n    const w = g.world;\n    const lines = ['The Old Pear. Older than the Mayor. Older than the Bell. It has seen everything twice, and fruited.', w.flags.pearLit ? 'It is hung with your lights. It looks embarrassed, in a good way.' : 'Someone has carved \"D + a bowl\" into the bark.'];\n    yield* narrate(g, lines[w.clock.day % 2]);\n  },\n  *busStop(g) {\n    const w = g.world;\n    if (w.story.day1Active) { yield* narrate(g, \"A sign on the stop says: 'Bus suspended pending your errands. Signed, a goose.'\"); return; }\n    if (g.visiting) { g.ui.toastMsg(\"Bus doesn't run while you have company.\"); return; }\n    const c = yield* ask(g, 'hester', 'Big City? It\\'s just the one stop. You\\'ll know it when you\\'re in it.', ['To the City', 'Not today'], { name: 'Sign at the stop', voice: 'hester' });\n    if (c !== 0) return;\n    yield* busRide(g, 'city');\n  },\n  *busHome(g) {\n    const c = yield* ask(g, 'hester', 'Back to the end of the line, is it? Everyone does, in the end.', ['Home', 'Not yet']);\n    if (c !== 0) return;\n    yield* busRide(g, 'town');\n  },\n  *mayorTalk(g) {\n    const w = g.world;\n    const a = g.life.trundle;\n    if (yield* day1Mayor(g)) return;\n    if (w.flags.ribbonGone) yield* say(g, 'trundle', HOSTS.trundle.arrived);\n    else yield* say(g, 'trundle', hostLine(g, 'trundle', w.clock.day % 2 ? 'greet' : 'moving'));\n    if (w.flags.mayorBumped !== w.clock.day) { w.flags.mayorBumped = w.clock.day; addBeans(g, 50, 'mayor'); g.ui.toastMsg('The Mayor tips his sash. +50 beans, for the election.'); }\n    g.events.emit('talkedMayor', {});\n  },\n  *rindTalk(g) {\n    const w = g.world;\n    const st = cheeseState(w, g.season, w.cheese.day || w.clock.day);\n    const c = g.cal;\n    if (!c.market && !w.flags.rindForced) { yield* say(g, 'rind', HOSTS.rind.closed); return; }\n    const choice = yield* ask(g, 'rind', `${hostLine(g, 'rind', 'greet')}//${st.base} beans a wheel. No receipts.`, ['Buy one', 'Buy five', 'What happens to it?', 'Not today']);\n    if (choice === 0 || choice === 1) {\n      const n = choice === 0 ? 1 : 5;\n      if (buyCheese(g, n)) { g.sound('bean'); yield* say(g, 'rind', hostLine(g, 'rind', 'buy')); }\n      else yield* say(g, 'rind', \"Not enough beans. Or not enough pocket. I don't ask which.\");\n    } else if (choice === 2) yield* say(g, 'rind', hostLine(g, 'rind', 'warn'));\n  },\n  *vesperTalk(g) {\n    const w = g.world;\n    yield* say(g, 'vesper', hostLine(g, 'vesper', 'greet'));\n    const moods = ['Quiet', 'Hopeful', 'Blue', 'Upside Down', 'Hungry', 'In Debt'];\n    const c = yield* ask(g, 'vesper', hostLine(g, 'vesper', 'ask'), [moods[(w.clock.day) % 6], moods[(w.clock.day + 2) % 6], moods[(w.clock.day + 4) % 6], 'Just listening']);\n    if (c < 0 || c === 3) return;\n    const idx = (w.clock.day + c * 2) % 6;\n    g.music.setOverride(`vesper${idx}`);\n    g.events.emit('vesperPlays', { idx });\n    g.life.vesper.play('Accordion', 0.2);\n    for (const n of g.npcs.all()) if (!n.inside && n.here) { n.overrideClip = 'Sway'; }\n    const song = `vesper${idx}`;\n    g.scripts.run(g.festivals.singAlong(song, 'vesper', 20), { hold: false, name: 'vesperSing' });\n    yield* narrate(g, 'She plays. The whole plaza goes a bit quiet, and then a bit quieter. Somebody sniffs. It might be Bartleby.');\n    if (!w.records.includes(idx)) {\n      w.records.push(idx);\n      if (hasRoom(w)) { addItem(g, `record${idx}`); yield* say(g, 'vesper', hostLine(g, 'vesper', 'give')); g.sound('reveal'); g.events.emit('gotRecord', { idx }); }\n    }\n    g.ctx.tweens.call(18, () => { g.music.setOverride(null); for (const n of g.npcs.all()) n.overrideClip = null; g.life.vesper.play('VesperHang', 0.2); });\n  },\n  *lighthouseKnock(g) {\n    g.sound('knock');\n    yield 0.2;\n    g.sound('knock');\n    yield 0.5;\n    yield* narrate(g, 'Nobody answers. The light goes round. A note on the door says: \"Back in a moment.\" The note is very old.');\n    g.events.emit('lighthouse', {});\n  },\n  ...SERVICES,\n  ...VENUES,\n};\nfunction* sit(g, x, z) {\n  const p = g.player;\n  p.x = x; p.z = z + 0.05;\n  p.y = g.place.height(x, z) + 0.28;\n  p.facing = 0;\n  p.turnTo = null;\n  p.sitting = true;\n  p.play('Sit', 0.12);\n  g.events.emit('sat', {});\n  yield 0.4;\n  g.frozenHoldSit = true;\n  while (true) {\n    const inp = g.inp;\n    if (inp.confirm || inp.back || inp.mouse.click || Math.hypot(inp.axisX, inp.axisY) > 0.3) break;\n    yield;\n  }\n  p.sitting = false;\n  p.z = z + 0.8;\n  if (g.place.blocked(p.x, p.z)) p.z = z - 0.8;\n  p.y = g.place.height(p.x, p.z);\n  p.play('Idle', 0.15);\n}\nexport function* runAction(g, t) {\n  const fn = ACTIONS[t.act] ?? ((gg, tt) => festivalAction(gg, tt));\n  const r = fn(g, t);\n  if (r && r.next) yield* r;\n  saveNow(g);\n}\nexport { sit, removeSlot };\nEOF\necho ok","description":"Write pocket actions and the main action registry"}}}
