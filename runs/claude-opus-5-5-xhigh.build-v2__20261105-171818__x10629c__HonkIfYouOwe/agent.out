.ink, night: 1 };\")\n# outdoors-ness of the bus\nsub('systems/sky.js',\"if (place?.kind === 'room') { applySky(g.engine, place.def?.dim ? ROOM_DIM : ROOM_SKY); return; }\",\"if (place?.kind === 'room' && !place.outdoors) { applySky(g.engine, place.def?.dim ? ROOM_DIM : ROOM_SKY); return; }\")\nsub('systems/sky.js',\"const out = g.place?.kind !== 'room';\",\"const out = g.place?.kind !== 'room' || !!g.place?.outdoors;\")\nsub('systems/bus.js',\"    this.camZoom = 2.1;\\n\",\"    this.camZoom = 2.1;\\n    this.outdoors = true;\\n\")\nsub('audio/ambience.js',\"const out = place?.kind !== 'room';\",\"const out = place?.kind !== 'room' || !!place?.outdoors;\")\n# occluder sparkle in the material's own colour\nsub('world/occluders.js',\"m = toonMaterial(hex, { dissolve: true });\",\"m = toonMaterial(hex, { dissolve: true, rim: hex });\")\n# hourly: specials and bugs follow the clock\nsub('systems/flow.js',\"\"\"  const w = g.world;\n  if (g.mode === 'play') {\n    if (hour === 9)\"\"\",\"\"\"  const w = g.world;\n  g.life.placeSpecials();\n  if (hour % 3 === 0 && g.place === g.town) g.life.spawnBugs();\n  if (g.mode === 'play') {\n    if (hour === 9)\"\"\")\n# fish species by the hour you actually cast\nsub('systems/life.js',\"\"\"          fi.target = best;\n          best.state = 'come';\n          fi.t = 1.2 + bd * 0.4;\n          const rng = new Stream(`${g.world.seed}:nib:${g.ctx.time}`);\"\"\",\"\"\"          fi.target = best;\n          best.state = 'come';\n          fi.t = 1.2 + bd * 0.4;\n          const rng = new Stream(`${g.world.seed}:nib:${g.ctx.time}`);\n          best.def = this.rollFish(best.kind, rng);\"\"\")\n# Freeze time\nsub('game.js',\"\"\"      if (!this.frozen && !this.inTransition) {\n        advanceClock(this, dt);\"\"\",\"\"\"      if (!this.frozen && !this.inTransition) {\n        if (!this.timeFrozen) advanceClock(this, dt);\"\"\")\n# Town footsteps per surface\nsub('world/town.js',\"\"\"  height(x, z) { return groundHeight(x, z); }\"\"\",\"\"\"  height(x, z) { return groundHeight(x, z); }\n  surfaceAt(x, z) {\n    const info = tileInfo(tileChar(Math.floor(x), Math.floor(z)));\n    const s = info.surface;\n    if (s === 'dock') return 'stepWood';\n    if (s === 'sand') return 'stepSand';\n    if (s === 'plaza' || s === 'cliff') return 'stepStone';\n    if (s === 'path') return this.g.season === 3 ? 'stepSnow' : 'stepPath';\n    return this.g.season === 3 ? 'stepSnow' : 'stepGrass';\n  }\"\"\")\nsub('game.js',\"\"\"    const surface = this.place?.surfaceAt?.(p.x, p.z) ?? 'stepStone';\n    this.sound(surface, { volume: p.speed < 2 ? 0.4 : 0.8 });\"\"\",\"\"\"    const surface = this.place?.surfaceAt?.(p.x, p.z);\n    if (surface) this.sound(surface, { volume: p.speed < 2 ? 0.4 : 0.8 });\"\"\")\n# Starter bed\nsub('core/save.js',\"rooms: { main: { wall: 'wall-plaster', floor: 'floor-oak', items: [] },\",\"rooms: { main: { wall: 'wall-plaster', floor: 'floor-oak', items: [{ id: 'cottageBed', x: 0, z: 0, rot: 0, on: true }, { id: 'boxes', x: 5, z: 0, rot: 0, on: true }] },\")\n# Jar interest on season change, and a note about weeds\nsub('systems/flow.js',\"\"\"  if (c.season !== g.season) g.seasonChanging = true;\"\"\",\"\"\"  if (c.season !== g.season) {\n    g.seasonChanging = true;\n    const interest = Math.floor(w.player.jar * 0.005);\n    if (interest > 0) { w.player.jar += interest; sendMail(g, { from: 'clementine', body: `Dear {player},\\\\nYour Bean Jar earned ${interest} beans of interest. We are very interested.\\\\nClementine`, arriveDay: w.clock.day }); }\n    g.events.emit('jarInterest', { interest });\n  }\n  if (Object.values(w.town.objects).filter((o) => o.k === 'weed').length > 15 && !w.story.day1Active) remember(g, 'noWeeds', {});\"\"\")\nsub('systems/flow.js',\"import { saveNow } from './session.js';\",\"import { saveNow } from './session.js';\\nimport { remember } from './memory.js';\")\n# Catalogue: everything you've owned\nsub('systems/economy.js',\"\"\"  p[i] = meta ? { id, ...meta } : { id };\n  g.events.emit('gotItem', { id, slot: i });\"\"\",\"\"\"  p[i] = meta ? { id, ...meta } : { id };\n  if (['furniture', 'clothes', 'hat', 'glasses', 'umbrella', 'wall', 'floor'].includes(ITEMS[id]?.cat)) g.world.player.catalog[id] = true;\n  g.events.emit('gotItem', { id, slot: i });\"\"\")\n# Bureau reward is collected in person\nsub('systems/rating.js',\"\"\"sendMail(g, { from: 'bureau', body: `BETTER BURROWS BUREAU\\\\nGrade: ${grade.g}. ${score} points.\\\\n${crit}\\\\nAgent Brisket`, gift: improved ? grade.reward : null, arriveDay: w.clock.day });\"\"\",\"\"\"sendMail(g, { from: 'bureau', body: `BETTER BURROWS BUREAU\\\\nGrade: ${grade.g}. ${score} points.\\\\n${crit}${improved ? ' A new grade. Collect your plaque at the Bureau.' : ''}\\\\nAgent Brisket`, arriveDay: w.clock.day });\"\"\")\n# Store door jingle\nsub('systems/actions.js',\"\"\"    yield* g.travel(next, tx, tz, Math.PI);\n    g.events.emit('entered', { room: b.room });\"\"\",\"\"\"    yield* g.travel(next, tx, tz, Math.PI);\n    if (b.id === 'store') g.scripts.run(doorJingle(g), { hold: false, name: 'jingle' });\n    g.events.emit('entered', { room: b.room });\"\"\")\nsub('systems/actions.js',\"\"\"function* sit(g, x, z) {\"\"\",\"\"\"/** The Village Chime is also the store's door jingle: the first few notes, played small. */\nfunction* doorJingle(g) {\n  for (const n of g.world.chime.slice(0, 4)) {\n    if (n >= 0) g.ctx.audio.play('bellNote', { pitch: noteOf(n) + 2, volume: 0.35 });\n    yield 0.13;\n  }\n}\nfunction* sit(g, x, z) {\"\"\")\nsub('systems/actions.js',\"import { playChime } from './bell.js';\",\"import { playChime, noteOf } from './bell.js';\")\n# Tent sign reads\nsub('art/models.js',\"front('tent', 'NIBBLES', { wall: 'plum', trim: 'orange', door: 'red', glass: 'orange', neon: 'sand', neon2: 'orange', w: 4, h: 3.4, d: 4, signPx: 0.06 })\",\"front('tent', 'FORTUNES', { wall: 'plum', trim: 'orange', door: 'red', glass: 'orange', neon: 'sand', neon2: 'orange', w: 4, h: 3.4, d: 4, signPx: 0.07 })\")\n# Dust bunnies can be stomped\nsub('world/home.js',\"\"\"      const dist = Math.hypot(dx, dz);\n      if (dist < 2.2 && dist > 0.01) {\"\"\",\"\"\"      const dist = Math.hypot(dx, dz);\n      if (dist < 0.42 && !b.gone) {\n        b.gone = true;\n        b.m.removeFromParent();\n        this.g.world.home.dust.splice(this.g.world.home.dust.indexOf(b.d), 1);\n        this.g.sound('bonk');\n        this.g.ctx.particles.burst('dust', [b.d.x + 1000, 0.2, b.d.z], { count: 6 });\n        this.g.events.emit('dustStomped', {});\n        continue;\n      }\n      if (b.gone) continue;\n      if (dist < 2.2 && dist > 0.01) {\"\"\")\n# Clean attract's import\ns=open(root+'dev/attract.js').read()\ns=s.replace(\"const bus = g.busPlace ??= new (await_bus(g))(g);\",\"const bus = g.busPlace ??= new BusPlace(g);\")\ns=s.replace(\"import { BusPlace } from '../systems/bus.js';\\nconst await_bus = () => BusPlace;\\n\",\"\")\ns=s.replace(\"import { busRide } from '../systems/bus.js';\",\"import { busRide, BusPlace } from '../systems/bus.js';\")\nopen(root+'dev/attract.js','w').write(s)\n# city: leave restores the base look\nsub('world/city.js',\"\"\"    g.engine.setLook(this.dayLook());\n    this.lookNight = false;\"\"\",\"\"\"    g.engine.setLook(g.baseLook());\n    this.lookNight = false;\"\"\")\nsub('world/city.js',\"\"\"  dayLook() { return { scene: [], actors: { pixel: { size: 1, outline: 0.85, crease: 0.15 }, filters: [] }, environment: { pixel: { size: 1, outline: 0.85, crease: 0.15 }, filters: [] } }; }\\n\"\"\",\"\")\n# mailbox flag, cheese smell, frosted windows, umbrellas, puddles\nsub('systems/life.js',\"\"\"      // sparkle spots glint; chimneys smoke\"\"\",\"\"\"      // the mailbox flag goes up when there's mail\n      if (g.town.mailFlag) g.town.mailFlag.rotation.z = g.world.mail.inbox.some((l) => !l.read) ? 0 : -1.5;\n      // gone-off cheese has a visible smell\n      this.smellT = (this.smellT ?? 0) - dt;\n      if (this.smellT <= 0) {\n        this.smellT = 0.8;\n        if (g.world.player.pockets.some((s) => s?.id === 'cheeseOff')) { g.ctx.particles.burst({ count: [2, 3], life: [0.7, 1.1], speed: [0.2, 0.5], gravity: -0.8, size: [1, 1], colors: ['lime', 'green'], spread: 40 }, [p.x, p.y + 1, p.z]); if ((this.smellN = (this.smellN ?? 0) + 1) % 4 === 0) g.sound('cheeseSmell', { volume: 0.5 }); }\n        // puddles while it rains\n        const k = g.sky?.kind;\n        if ((k === 'rain' || k === 'storm') && g.town.decals) { const r = g.cosmetic; const x = p.x + r.range(-7, 7), z = p.z + r.range(-7, 7); if (g.town.height(x, z) >= 0 && !g.town.blocked(x, z)) g.town.decals.add('splat', { x, y: g.town.height(x, z) + 0.02, z }, { x: 0, y: 1, z: 0 }, { size: r.range(0.6, 1.3), color: 0x41a6f6, life: 18 }); }\n      }\n      // sparkle spots glint; chimneys smoke\"\"\")\nsub('world/town.js',\"\"\"    this.terrain.setSeason(season);\n    if (this.seasonBuilt === key2) { this.viewsDirtyAll(); return; }\"\"\",\"\"\"    this.terrain.setSeason(season);\n    this.frostWindows(season);\n    if (this.seasonBuilt === key2) { this.viewsDirtyAll(); return; }\"\"\")\nsub('world/town.js',\"\"\"  viewsDirtyAll() {\"\"\",\"\"\"  /** Frost on the glass in winter. */\n  frostWindows(season) {\n    const glass = [PALETTE.navy, PALETTE.sky];\n    const frost = toonMaterial(PALETTE.white);\n    for (const e of this.buildings.values()) {\n      e.object.traverse((m) => {\n        if (!m.isMesh || m.parent?.name === 'lit') return;\n        const hex = m.userData.glassBase ?? m.material?.color?.getHex?.();\n        if (!glass.includes(hex)) return;\n        if (!m.userData.glassMat) { m.userData.glassMat = m.material; m.userData.glassBase = hex; }\n        m.material = season === 3 ? frost : m.userData.glassMat;\n      });\n    }\n  }\n  viewsDirtyAll() {\"\"\")\nsub('art/itemModels.js',\"export const cheeseWheel = model(\",\"export const umbrellaProp = model({ id: 'umbrella-prop', about: 'An open umbrella', tags: ['item'], float