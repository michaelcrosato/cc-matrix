{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmRaF4XYeUzfThP54bu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013zmg7tH5vUaJMjcMGaL5dq","name":"Bash","input":{"command":"sed -i 's/You look like a boiled turnip with a grudge/You look like a boiled potato with a grudge/' src/data/dialogue/unique.js\ncat > src/data/neighbours.js <<'EOF'\n// The neighbours, as data. Adding one needs only an entry here, a critter spec and a line bank.\nexport const NEIGHBOURS = {\n  dorrit: { name: 'Dorrit', species: 'wombat', type: 'hearth', tic: 'mmhm', building: 'dorrit', wake: 6, sleep: 21, loves: ['soupy', 'mushroom', 'fish', 'fruit', 'kitchen'], hates: ['loud'], room: { wall: 'wall-cream', floor: 'floor-kitchen', style: 'kitchen' } },\n  tavi: { name: 'Tavi', species: 'quokka', type: 'sunshine', tic: \"isn't it?!\", building: 'tavi', wake: 6, sleep: 22, loves: ['loud', 'fruit', 'flower', 'toy', 'plain', 'leafy'], hates: [], room: { wall: 'wall-cheese', floor: 'floor-sandy', style: 'yellow' } },\n  bartleby: { name: 'Bartleby', species: 'moose', type: 'grouch', tic: \"I'd prefer not.\", building: 'bartleby', wake: 9, sleep: 22, loves: ['sapling', 'drab', 'plain', 'oddity', 'plant'], hates: ['loud', 'dramatic', 'toy'], room: { wall: 'wall-stone', floor: 'floor-ash', style: 'bare' } },\n  ottoline: { name: 'Lady Ottoline', short: 'Ottoline', species: 'platypus', type: 'diva', tic: 'darling dear', building: 'ottoline', wake: 10, sleep: 23, loves: ['dramatic', 'formal', 'couture', 'art', 'shell', 'money'], hates: ['damp', 'drab', 'practical'], room: { wall: 'wall-regal', floor: 'floor-carpet-red', style: 'faded' } },\n  rocco: { name: 'Rocco', species: 'armadillo', type: 'goGetter', tic: \"let's roll!\", building: 'rocco', wake: 5, sleep: 21, loves: ['fish', 'sporty', 'trophy', 'bug'], hates: ['sleepy', 'cosy'], room: { wall: 'wall-brick', floor: 'floor-gym', style: 'gym' } },\n  nib: { name: 'Nib', species: 'lemur', type: 'dreamer', tic: '…or so the moon says', building: 'nib', wake: 11, sleep: 28, loves: ['bug', 'sleepy', 'oddity', 'star'], hates: ['electronics', 'clock', 'sporty'], room: { wall: 'wall-night', floor: 'floor-ash', style: 'books' } },\n  ozzie: { name: 'Ozzie', species: 'possum', type: 'schemer', tic: \"You didn't hear it from me.\", building: 'ozzie', wake: 7, sleep: 24, loves: ['cheese', 'clutter', 'gift', 'gross', 'oddity'], hates: ['money', 'formal'], room: { wall: 'wall-mud', floor: 'floor-oak', style: 'corkboard' } },\n  yolanda: { name: 'Yolanda', species: 'yak', type: 'auntie', tic: 'hon', building: 'yolanda', wake: 6, sleep: 22, loves: ['wool', 'cosy', 'flower', 'fruit'], hates: ['dramatic'], room: { wall: 'wall-knit', floor: 'floor-carpet-red', style: 'knitted' } },\n  fitch: { name: 'Fitch', species: 'ferret', type: 'hustler', tic: 'no refunds', building: 'rocco', wake: 7, sleep: 25, loves: ['art', 'money', 'oddity', 'cheese'], hates: ['plain', 'drab'], room: { wall: 'wall-plaster', floor: 'floor-oak', style: 'boxes' }, movesIn: 9 },\n};\nexport const NEIGHBOUR_ORDER = ['dorrit', 'tavi', 'bartleby', 'ottoline', 'rocco', 'nib', 'ozzie', 'yolanda', 'fitch'];\n/** Points of interest neighbours wander between. kind drives what they do there. */\nexport const POIS = [\n  { id: 'benchW', x: 20.5, z: 46.4, kind: 'sit', face: Math.PI }, { id: 'benchE', x: 27.5, z: 46.4, kind: 'sit', face: Math.PI },\n  { id: 'plazaN', x: 21, z: 35, kind: 'stand' }, { id: 'plazaS', x: 25, z: 44.5, kind: 'stand' }, { id: 'plazaE', x: 30, z: 39, kind: 'stand' }, { id: 'bellSide', x: 18, z: 42, kind: 'stand' }, { id: 'pearSide', x: 26, z: 38.5, kind: 'stare' },\n  { id: 'riverN', x: 37, z: 22, kind: 'fish' }, { id: 'riverE', x: 46.5, z: 30, kind: 'fish' }, { id: 'pondSide', x: 39.5, z: 43, kind: 'fish' }, { id: 'dockEnd', x: 24, z: 60, kind: 'fish' },\n  { id: 'store', x: 54, z: 40.5, kind: 'stand' }, { id: 'museum', x: 22, z: 11.5, kind: 'stare' }, { id: 'hall', x: 10, z: 41.5, kind: 'stand' }, { id: 'lookoutPath', x: 66, z: 9.5, kind: 'stare' },\n  { id: 'beachW', x: 15, z: 54, kind: 'stare' }, { id: 'beachE', x: 60, z: 55, kind: 'stare' }, { id: 'orchard', x: 53, z: 10.5, kind: 'stare' }, { id: 'mossy', x: 68, z: 29, kind: 'stare' },\n  { id: 'doorDorrit', x: 17.5, z: 25.5, kind: 'stand' }, { id: 'doorBart', x: 51.5, z: 24.5, kind: 'stand' }, { id: 'doorOzzie', x: 65.5, z: 47.5, kind: 'stand' }, { id: 'doorYolanda', x: 74.5, z: 47.5, kind: 'stand' },\n];\nexport const FAVOURS = [\n  { kind: 'fetch', item: 'pear', ask: 'I could really do with a pear. A proper one. Shake something.', done: 'A pear! That\\'s the good stuff.' },\n  { kind: 'fetch', item: 'weed', ask: 'I need a weed. Don\\'t ask. It\\'s for a thing. Any weed.', done: 'That\\'s a good weed. It really is. Thank you.' },\n  { kind: 'fetch', item: 'shellCommon', ask: 'Bring me a shell from the beach? Any old one. I just want to hold something from the sea.', done: 'Oh, that\\'s the sea all right.', anyCat: 'shell' },\n  { kind: 'fetch', item: 'flower', ask: 'I want a flower for the table. Don\\'t tell me which. Surprise me.', done: 'A flower! It\\'ll be dead by Thursday. It\\'s the thought.', anyCat: 'flower' },\n  { kind: 'fetch', item: 'fish', ask: 'Fetch me a fish, would you? Any fish. I\\'ve a very specific plan that doesn\\'t depend on which.', done: 'That\\'s a fish, all right. No need to tell me where it\\'s been.', anyCat: 'fish' },\n  { kind: 'fetch', item: 'bug', ask: 'Bring me a bug. It\\'s for company.', done: 'Hello, little one. Oh, you\\'re going to be such a disappointment.', anyCat: 'bug' },\n  { kind: 'fetch', item: 'mushroom', ask: 'I\\'m out of mushrooms. Have a look in the woods. Careful of the ones that look back.', done: 'Lovely. It\\'s still looking at me. Lovely.', seasons: [2] },\n  { kind: 'catch', item: 'perch', cat: 'fish', mins: 60, ask: 'Catch me a fish within the hour. Doesn\\'t matter what. I\\'ve got a pan on.', done: 'Still flapping! That\\'s how I like it.', anyCat: 'fish' },\n  { kind: 'catch', item: 'bug', cat: 'bug', mins: 60, ask: 'I bet you can\\'t catch me a bug in an hour. It\\'s a small bet. It\\'s just me, and I\\'ve already lost.', done: 'Ha! Well, I owe me a pie.', anyCat: 'bug' },\n  { kind: 'deliver', ask: 'Run this parcel over to {target}, would you? Don\\'t shake it. Don\\'t sniff it either.', done: 'Oh, is that from them? Thank you. I won\\'t open it in front of you.' },\n  { kind: 'deliver', ask: 'This is for {target}. If they ask who it\\'s from, I\\'m out.', done: 'For me? Hm. I know who that\\'s from. I\\'ll be having words.' },\n  { kind: 'deliver', ask: 'Take this round to {target}. It\\'s only an apology. It\\'s quite heavy.', done: 'An apology! I\\'ll put it with the others.' },\n  { kind: 'deliver', ask: 'Do me a kindness and carry this to {target}. Tell them it\\'s not what it looks like.', done: 'Oh, it\\'s exactly what it looks like. Bless them.' },\n  { kind: 'return', ask: 'I\\'ve lost something. It was mine. It might be on the beach. Or {target} might know. Could you ask around?', done: 'That\\'s it! That\\'s the very thing! I don\\'t remember what it\\'s for.' },\n  { kind: 'return', ask: '{target} borrowed a thing of mine, about a year back. Would you get it for me? I\\'d ask, but then I\\'d have to talk to them.', done: 'Thank you. Now I can lend it to them again.' },\n  { kind: 'trade', item: 'pear', ask: 'I\\'ll swap you something for a pear. What? It\\'s a surprise. It\\'s a very small surprise.', done: 'A deal is a deal. You got a good one. I got a pear.' },\n  { kind: 'trade', item: 'weed', ask: 'Swap you for a weed. Yes, a weed. Don\\'t look at me like that, you\\'ve got plenty.', done: 'A fair trade. I\\'d like that noted, if anyone asks.' },\n  { kind: 'trade', item: 'shellCommon', anyCat: 'shell', ask: 'Got a shell? I\\'ve got something much better. Or different. Swap?', done: 'Pleasure. You\\'ll thank me. You will not, but you could.' },\n  { kind: 'fetch', item: 'furniture', anyCat: 'furniture', ask: 'I\\'ve got a gap in my house. A chair-sized gap, or similar. Bring me anything you\\'re not using.', done: 'That fills the gap. Now there\\'s a new gap, where I was standing.' },\n  { kind: 'fetch', item: 'fruit', anyCat: 'fruit', ask: 'Bring me a bit of fruit. I\\'ve been told it\\'s good for me. I want to see for myself.', done: 'Mm. Yes. No. Yes. I\\'ll need more time with it.' },\n];\nEOF\ncat > src/systems/lines.js <<'EOF'\n// Lines are data: { id, text, when: { season, weather, hour, friendMin, memory }, weight }.\n// Each line is seen once before it repeats.\nimport { TYPE_LINES } from '../data/dialogue/types.js';\nimport { UNIQUE, MEMORY_LINES, GOSSIP } from '../data/dialogue/unique.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { NEIGHBOURS, NEIGHBOUR_ORDER } from '../data/neighbours.js';\nimport { calendar, SEASON_NAMES } from '../core/calendar.js';\nimport { hash32, Stream } from '../core/rng.js';\nimport { ITEMS } from '../data/items.js';\n\nconst BANK_WHEN = {\n  morning: { hour: [5, 11] }, noon: { hour: [11, 16] }, evening: { hour: [16, 21] }, night: { hour: [21, 29] },\n  rain: { weather: ['rain', 'storm'] }, snow: { weather: ['snow'] }, sun: { weather: ['sun', 'clear'] }, wind: { weather: ['wind'] },\n  spring: { season: 0 }, summer: { season: 1 }, autumn: { season: 2 }, winter: { season: 3 },\n};\nexport function lineObjects() {\n  const out = [];\n  for (const [type, banks] of Object.entries(TYPE_LINES)) {\n    for (const [bank, list] of Object.entries(banks)) list.forEach((text, i) => out.push({ id: `${type}.${bank}.${i}`, type, bank, text, when: BANK_WHEN[bank] ?? {}, weight: 1 }));\n  }\n  return out;\n}\nexport function allLineTexts() {\n  const out = [];\n  for (const banks of Object.values(TYPE_LINES)) for (const list of Object.values(banks)) out.push(...list);\n  for (const list of Object.values(UNIQUE)) out.push(...list);\n  for (const list of Object.values(MEMORY_LINES)) out.push(...list);\n  out.push(...GOSSIP);\n  for (const host of Object.values(HOSTS)) for (const v of Object.values(host)) { if (Array.isArray(v)) for (const e of v) out.push(typeof e === 'string' ? e : e.text); else if (typeof v === 'object') out.push(...Object.values(v)); }\n  return out;\n}\nconst TAGS = /\\{(\\w+)\\}/g;\nexport const KNOWN_TAGS = new Set(['player', 'town', 'item', 'neighbour', 'catch', 'target', 'debt', 'beans', 'season', 'text']);\n/** Resolve tags. Names come out wrapped so the dialogue draws them in colour. */\nexport function resolveTags(text, g, extra = {}) {\n  return text.replace(TAGS, (m, tag) => {\n    if (extra[tag] !== undefined) return String(extra[tag]);\n    const w = g?.world;\n    switch (tag) {\n      case 'player': return w?.player.name ?? 'you';\n      case 'town': return w?.player.town ?? 'here';\n      case 'neighbour': return 'someone';\n      case 'item': return 'thing';\n      case 'catch': return 'fish';\n      case 'debt': return (w?.player.debt ?? 0).toLocaleString('en-US');\n      case 'season': return SEASON_NAMES[calendar(w).season].toLowerCase();\n      default: return m;\n    }\n  });\n}\nfunction order(w, ownerBank, n) {\n  const s = new Stream(`${w.seed}:lines:${ownerBank}`);\n  return s.shuffle(Array.from({ length: n }, (_, i) => i));\n}\n/** Next unseen line in a bank. Cycles through all of them before repeating. */\nexport function nextFrom(w, owner, bank, list) {\n  if (!list?.length) return null;\n  w.flags.seen ??= {};\n  const k = `${owner}.${bank}`;\n  const i = w.flags.seen[k] ?? 0;\n  w.flags.seen[k] = i + 1;\n  const ord = order(w, k, list.length);\n  return list[ord[i % list.length]];\n}\nexport const hostLine = (g, host, bank) => {\n  const list = HOSTS[host]?.[bank];\n  return nextFrom(g.world, host, bank, list);\n};\nexport const typeLine = (g, npcId, bank) => {\n  const t = NEIGHBOURS[npcId].type;\n  return nextFrom(g.world, npcId, bank, TYPE_LINES[t][bank]);\n};\nexport const uniqueLine = (g, npcId) => nextFrom(g.world, npcId, 'unique', UNIQUE[npcId]);\nexport const otherNeighbour = (g, not) => {\n  const here = NEIGHBOUR_ORDER.filter((n) => n !== not && g.world.npcs[n].moved === 'here');\n  const s = new Stream(`${g.world.seed}:other:${g.world.clock.day}:${not}:${g.world.stats.talks[not] ?? 0}`);\n  return NEIGHBOURS[s.pick(here)].short ?? NEIGHBOURS[s.pick(here)].name;\n};\nexport const gossipLine = (g, npcId) => {\n  const t = nextFrom(g.world, npcId, 'gossip', GOSSIP);\n  return t.replace(/\\{neighbour\\}/g, otherNeighbour(g, npcId));\n};\nexport { hash32, ITEMS };\nEOF\ncat > src/systems/memory.js <<'EOF'\n// What the village remembers about you. Neighbours bring it up, each one once.\nimport { MEMORY_LINES } from '../data/dialogue/unique.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { nextFrom } from './lines.js';\n\nconst CAP = 80;\nexport function remember(g, k, data = {}) {\n  const w = g.world;\n  w.memory.push({ k, day: w.clock.day, heard: [], ...data });\n  if (w.memory.length > CAP) w.memory.shift();\n  g.events.emit('memory', { k, ...data });\n}\n/** The freshest thing this neighbour hasn't mentioned yet, as a resolved line. */\nexport function memoryLine(g, npcId) {\n  const w = g.world;\n  for (let i = w.memory.length - 1; i >= 0; i--) {\n    const m = w.memory[i];\n    if (m.heard.includes(npcId)) continue;\n    if (m.about === npcId && m.k !== 'bonk') continue;\n    if (m.k === 'bonk' && m.about !== npcId) continue;\n    if (w.clock.day - m.day > 5) break;\n    const list = MEMORY_LINES[m.k];\n    if (!list) continue;\n    m.heard.push(npcId);\n    const t = nextFrom(w, npcId, `mem.${m.k}`, list);\n    const neighbour = m.about ? (NEIGHBOURS[m.about]?.short ?? NEIGHBOURS[m.about]?.name ?? m.about) : 'someone';\n    return { text: t.replace(/\\{item\\}/g, m.item ?? 'thing').replace(/\\{catch\\}/g, m.catch ?? 'fish').replace(/\\{neighbour\\}/g, neighbour), memory: m };\n  }\n  return null;\n}\nEOF\ncat > src/systems/economy.js <<'EOF'\n// Pockets, beans, selling and buying, the debt. Pure-ish: only ever touches world and events.\nimport { ITEMS, SELLABLE } from '../data/items.js';\nimport { tuning } from '../dev/tuning.js';\nimport { remember } from './memory.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\n\nexport const POCKET_SLOTS = 15;\nexport const HOME_TIERS = [\n  { tier: 1, debt: 8000, name: 'Starter Shack' },\n  { tier: 2, debt: 30000, name: 'Proper Cottage' },\n  { tier: 3, debt: 80000, name: 'Cottage with Annex' },\n  { tier: 4, debt: 150000, name: 'Two Storeys' },\n];\nexport const hasRoom = (w) => w.player.pockets.some((s) => s === null);\n/** Add to Pockets. Returns the slot, or -1. A record of who gave it stays with the slot. */\nexport function addItem(g, id, meta = null) {\n  const p = g.world.player.pockets;\n  const i = p.indexOf(null);\n  if (i < 0) return -1;\n  p[i] = meta ? { id, ...meta } : { id };\n  g.events.emit('gotItem', { id, slot: i });\n  g.pocketsDirty = true;\n  return i;\n}\nexport const slotId = (s) => (s ? s.id : null);\nexport const countItem = (w, id) => w.player.pockets.filter((s) => s && s.id === id).length;\nexport function findItem(w, pred) {\n  return w.player.pockets.findIndex((s) => s && pred(s, ITEMS[s.id]));\n}\nexport function removeSlot(g, i) { const s = g.world.player.pockets[i]; g.world.player.pockets[i] = null; g.pocketsDirty = true; return s; }\nexport function addBeans(g, n, reason = '') {\n  const w = g.world;\n  w.player.beans = Math.max(0, w.player.beans + n);\n  if (n > 0) { w.stats.beansEarned += n; }\n  g.events.emit('beans', { n, reason });\n}\nexport const sellPrice = (g, slot) => {\n  const it = ITEMS[slot.id];\n  if (!it) return 0;\n  if (it.cat === 'cheese' && slot.id === 'cheese') return Math.round((g.life?.cheesePrice?.() ?? 100) * tuning.sellMult);\n  return Math.max(1, Math.round((it.sell ?? 10) * tuning.sellMult));\n};\nexport const buyPrice = (id) => Math.max(1, Math.round((ITEMS[id]?.price ?? 100) * tuning.buyMult));\nexport function sellSlot(g, i) {\n  const w = g.world;\n  const slot = w.player.pockets[i];\n  if (!slot || !SELLABLE(slot.id)) return 0;\n  const it = ITEMS[slot.id];\n  const price = sellPrice(g, slot);\n  removeSlot(g, i);\n  addBeans(g, price, 'sell');\n  w.stats.sold[slot.id] = (w.stats.sold[slot.id] ?? 0) + 1;\n  w.stats.soldTotal = (w.stats.soldTotal ?? 0) + 1;\n  if (slot.from || it.handmade) {\n    const from = slot.from ?? it.handmade;\n    remember(g, slot.id === 'scarfGift' ? 'soldScarf' : 'soldGift', { item: it.name, about: from });\n    w.npcs[from] && (w.npcs[from].friend = Math.max(0, w.npcs[from].friend - 2));\n  } else if ((w.stats.soldTotal % 6) === 0) remember(g, 'sold', { item: it.name });\n  g.events.emit('sold', { id: slot.id, price });\n  return price;\n}\nexport function payDebt(g, amount) {\n  const w = g.world;\n  const p = w.player;\n  const pay = Math.min(amount, p.beans, p.debt);\n  if (pay <= 0) return 0;\n  p.beans -= pay;\n  p.debt -= pay;\n  p.debtPaid += pay;\n  g.events.emit('debtPaid', { pay, left: p.debt });\n  return pay;\n}\nexport const nextTierCost = (w) => { const t = HOME_TIERS.find((x) => x.tier === w.player.homeTier + 1); return t ? Math.round(t.debt * tuning.debtMult) : null; };\n/** Take on the next tier. The house changes overnight in the source of these things; here, on signature. */\nexport function upgradeHome(g) {\n  const w = g.world;\n  const cost = nextTierCost(w);\n  if (cost == null || w.player.debt > 0) return false;\n  w.player.homeTier += 1;\n  w.player.debt += cost;\n  w.player.debtTier = w.player.homeTier;\n  g.town?.refreshHome();\n  remember(g, 'debtTier', {});\n  g.events.emit('homeTier', { tier: w.player.homeTier });\n  return true;\n}\nexport function spend(g, n) {\n  const w = g.world;\n  if (w.player.beans < n) return false;\n  w.player.beans -= n;\n  w.player.lifeSpend += n;\n  const tier = w.player.lifeSpend >= 120000 ? 3 : w.player.lifeSpend >= 25000 ? 2 : 1;\n  if (tier > w.store.tier) { w.store.tier = tier; w.flags.storeUpgraded = true; g.town?.refreshStore(); }\n  return true;\n}\nexport const giftScore = (npcId, itemId) => {\n  const n = NEIGHBOURS[npcId];\n  const it = ITEMS[itemId];\n  if (!n || !it) return 0;\n  if (n.id === 'tavi' || npcId === 'tavi') return 1;\n  const tags = new Set([...(it.tags ?? []), it.cat]);\n  if (n.hates.some((t) => tags.has(t))) return -1;\n  if (n.loves.some((t) => tags.has(t))) return 2;\n  return (it.sell ?? 0) > 300 ? 1 : 0;\n};\nEOF\necho done","description":"Write neighbours data, line picker, memory and economy"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20796,"cache_read_input_tokens":424459,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20796},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"b5cdbeaf-3a17-4db0-ae71-128d9f6162eb","timestamp":"2026-11-06T00:59:35.087Z","request_id":"req_011CgkmRZwwysZE9fUSNaciC","wire_tool_inputs":{"toolu_013zmg7tH5vUaJMjcMGaL5dq":{"command":"sed -i 's/You look like a boiled turnip with a grudge/You look like a boiled potato with a grudge/' src/data/dialogue/unique.js\ncat > src/data/neighbours.js <<'EOF'\n// The neighbours, as data. Adding one needs only an entry here, a critter spec and a line bank.\nexport const NEIGHBOURS = {\n  dorrit: { name: 'Dorrit', species: 'wombat', type: 'hearth', tic: 'mmhm', building: 'dorrit', wake: 6, sleep: 21, loves: ['soupy', 'mushroom', 'fish', 'fruit', 'kitchen'], hates: ['loud'], room: { wall: 'wall-cream', floor: 'floor-kitchen', style: 'kitchen' } },\n  tavi: { name: 'Tavi', species: 'quokka', type: 'sunshine', tic: \"isn't it?!\", building: 'tavi', wake: 6, sleep: 22, loves: ['loud', 'fruit', 'flower', 'toy', 'plain', 'leafy'], hates: [], room: { wall: 'wall-cheese', floor: 'floor-sandy', style: 'yellow' } },\n  bartleby: { name: 'Bartleby', species: 'moose', type: 'grouch', tic: \"I'd prefer not.\", building: 'bartleby', wake: 9, sleep: 22, loves: ['sapling', 'drab', 'plain', 'oddity', 'plant'], hates: ['loud', 'dramatic', 'toy'], room: { wall: 'wall-stone', floor: 'floor-ash', style: 'bare' } },\n  ottoline: { name: 'Lady Ottoline', short: 'Ottoline', species: 'platypus', type: 'diva', tic: 'darling dear', building: 'ottoline', wake: 10, sleep: 23, loves: ['dramatic', 'formal', 'couture', 'art', 'shell', 'money'], hates: ['damp', 'drab', 'practical'], room: { wall: 'wall-regal', floor: 'floor-carpet-red', style: 'faded' } },\n  rocco: { name: 'Rocco', species: 'armadillo', type: 'goGetter', tic: \"let's roll!\", building: 'rocco', wake: 5, sleep: 21, loves: ['fish', 'sporty', 'trophy', 'bug'], hates: ['sleepy', 'cosy'], room: { wall: 'wall-brick', floor: 'floor-gym', style: 'gym' } },\n  nib: { name: 'Nib', species: 'lemur', type: 'dreamer', tic: '…or so the moon says', building: 'nib', wake: 11, sleep: 28, loves: ['bug', 'sleepy', 'oddity', 'star'], hates: ['electronics', 'clock', 'sporty'], room: { wall: 'wall-night', floor: 'floor-ash', style: 'books' } },\n  ozzie: { name: 'Ozzie', species: 'possum', type: 'schemer', tic: \"You didn't hear it from me.\", building: 'ozzie', wake: 7, sleep: 24, loves: ['cheese', 'clutter', 'gift', 'gross', 'oddity'], hates: ['money', 'formal'], room: { wall: 'wall-mud', floor: 'floor-oak', style: 'corkboard' } },\n  yolanda: { name: 'Yolanda', species: 'yak', type: 'auntie', tic: 'hon', building: 'yolanda', wake: 6, sleep: 22, loves: ['wool', 'cosy', 'flower', 'fruit'], hates: ['dramatic'], room: { wall: 'wall-knit', floor: 'floor-carpet-red', style: 'knitted' } },\n  fitch: { name: 'Fitch', species: 'ferret', type: 'hustler', tic: 'no refunds', building: 'rocco', wake: 7, sleep: 25, loves: ['art', 'money', 'oddity', 'cheese'], hates: ['plain', 'drab'], room: { wall: 'wall-plaster', floor: 'floor-oak', style: 'boxes' }, movesIn: 9 },\n};\nexport const NEIGHBOUR_ORDER = ['dorrit', 'tavi', 'bartleby', 'ottoline', 'rocco', 'nib', 'ozzie', 'yolanda', 'fitch'];\n/** Points of interest neighbours wander between. kind drives what they do there. */\nexport const POIS = [\n  { id: 'benchW', x: 20.5, z: 46.4, kind: 'sit', face: Math.PI }, { id: 'benchE', x: 27.5, z: 46.4, kind: 'sit', face: Math.PI },\n  { id: 'plazaN', x: 21, z: 35, kind: 'stand' }, { id: 'plazaS', x: 25, z: 44.5, kind: 'stand' }, { id: 'plazaE', x: 30, z: 39, kind: 'stand' }, { id: 'bellSide', x: 18, z: 42, kind: 'stand' }, { id: 'pearSide', x: 26, z: 38.5, kind: 'stare' },\n  { id: 'riverN', x: 37, z: 22, kind: 'fish' }, { id: 'riverE', x: 46.5, z: 30, kind: 'fish' }, { id: 'pondSide', x: 39.5, z: 43, kind: 'fish' }, { id: 'dockEnd', x: 24, z: 60, kind: 'fish' },\n  { id: 'store', x: 54, z: 40.5, kind: 'stand' }, { id: 'museum', x: 22, z: 11.5, kind: 'stare' }, { id: 'hall', x: 10, z: 41.5, kind: 'stand' }, { id: 'lookoutPath', x: 66, z: 9.5, kind: 'stare' },\n  { id: 'beachW', x: 15, z: 54, kind: 'stare' }, { id: 'beachE', x: 60, z: 55, kind: 'stare' }, { id: 'orchard', x: 53, z: 10.5, kind: 'stare' }, { id: 'mossy', x: 68, z: 29, kind: 'stare' },\n  { id: 'doorDorrit', x: 17.5, z: 25.5, kind: 'stand' }, { id: 'doorBart', x: 51.5, z: 24.5, kind: 'stand' }, { id: 'doorOzzie', x: 65.5, z: 47.5, kind: 'stand' }, { id: 'doorYolanda', x: 74.5, z: 47.5, kind: 'stand' },\n];\nexport const FAVOURS = [\n  { kind: 'fetch', item: 'pear', ask: 'I could really do with a pear. A proper one. Shake something.', done: 'A pear! That\\'s the good stuff.' },\n  { kind: 'fetch', item: 'weed', ask: 'I need a weed. Don\\'t ask. It\\'s for a thing. Any weed.', done: 'That\\'s a good weed. It really is. Thank you.' },\n  { kind: 'fetch', item: 'shellCommon', ask: 'Bring me a shell from the beach? Any old one. I just want to hold something from the sea.', done: 'Oh, that\\'s the sea all right.', anyCat: 'shell' },\n  { kind: 'fetch', item: 'flower', ask: 'I want a flower for the table. Don\\'t tell me which. Surprise me.', done: 'A flower! It\\'ll be dead by Thursday. It\\'s the thought.', anyCat: 'flower' },\n  { kind: 'fetch', item: 'fish', ask: 'Fetch me a fish, would you? Any fish. I\\'ve a very specific plan that doesn\\'t depend on which.', done: 'That\\'s a fish, all right. No need to tell me where it\\'s been.', anyCat: 'fish' },\n  { kind: 'fetch', item: 'bug', ask: 'Bring me a bug. It\\'s for company.', done: 'Hello, little one. Oh, you\\'re going to be such a disappointment.', anyCat: 'bug' },\n  { kind: 'fetch', item: 'mushroom', ask: 'I\\'m out of mushrooms. Have a look in the woods. Careful of the ones that look back.', done: 'Lovely. It\\'s still looking at me. Lovely.', seasons: [2] },\n  { kind: 'catch', item: 'perch', cat: 'fish', mins: 60, ask: 'Catch me a fish within the hour. Doesn\\'t matter what. I\\'ve got a pan on.', done: 'Still flapping! That\\'s how I like it.', anyCat: 'fish' },\n  { kind: 'catch', item: 'bug', cat: 'bug', mins: 60, ask: 'I bet you can\\'t catch me a bug in an hour. It\\'s a small bet. It\\'s just me, and I\\'ve already lost.', done: 'Ha! Well, I owe me a pie.', anyCat: 'bug' },\n  { kind: 'deliver', ask: 'Run this parcel over to {target}, would you? Don\\'t shake it. Don\\'t sniff it either.', done: 'Oh, is that from them? Thank you. I won\\'t open it in front of you.' },\n  { kind: 'deliver', ask: 'This is for {target}. If they ask who it\\'s from, I\\'m out.', done: 'For me? Hm. I know who that\\'s from. I\\'ll be having words.' },\n  { kind: 'deliver', ask: 'Take this round to {target}. It\\'s only an apology. It\\'s quite heavy.', done: 'An apology! I\\'ll put it with the others.' },\n  { kind: 'deliver', ask: 'Do me a kindness and carry this to {target}. Tell them it\\'s not what it looks like.', done: 'Oh, it\\'s exactly what it looks like. Bless them.' },\n  { kind: 'return', ask: 'I\\'ve lost something. It was mine. It might be on the beach. Or {target} might know. Could you ask around?', done: 'That\\'s it! That\\'s the very thing! I don\\'t remember what it\\'s for.' },\n  { kind: 'return', ask: '{target} borrowed a thing of mine, about a year back. Would you get it for me? I\\'d ask, but then I\\'d have to talk to them.', done: 'Thank you. Now I can lend it to them again.' },\n  { kind: 'trade', item: 'pear', ask: 'I\\'ll swap you something for a pear. What? It\\'s a surprise. It\\'s a very small surprise.', done: 'A deal is a deal. You got a good one. I got a pear.' },\n  { kind: 'trade', item: 'weed', ask: 'Swap you for a weed. Yes, a weed. Don\\'t look at me like that, you\\'ve got plenty.', done: 'A fair trade. I\\'d like that noted, if anyone asks.' },\n  { kind: 'trade', item: 'shellCommon', anyCat: 'shell', ask: 'Got a shell? I\\'ve got something much better. Or different. Swap?', done: 'Pleasure. You\\'ll thank me. You will not, but you could.' },\n  { kind: 'fetch', item: 'furniture', anyCat: 'furniture', ask: 'I\\'ve got a gap in my house. A chair-sized gap, or similar. Bring me anything you\\'re not using.', done: 'That fills the gap. Now there\\'s a new gap, where I was standing.' },\n  { kind: 'fetch', item: 'fruit', anyCat: 'fruit', ask: 'Bring me a bit of fruit. I\\'ve been told it\\'s good for me. I want to see for myself.', done: 'Mm. Yes. No. Yes. I\\'ll need more time with it.' },\n];\nEOF\ncat > src/systems/lines.js <<'EOF'\n// Lines are data: { id, text, when: { season, weather, hour, friendMin, memory }, weight }.\n// Each line is seen once before it repeats.\nimport { TYPE_LINES } from '../data/dialogue/types.js';\nimport { UNIQUE, MEMORY_LINES, GOSSIP } from '../data/dialogue/unique.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { NEIGHBOURS, NEIGHBOUR_ORDER } from '../data/neighbours.js';\nimport { calendar, SEASON_NAMES } from '../core/calendar.js';\nimport { hash32, Stream } from '../core/rng.js';\nimport { ITEMS } from '../data/items.js';\n\nconst BANK_WHEN = {\n  morning: { hour: [5, 11] }, noon: { hour: [11, 16] }, evening: { hour: [16, 21] }, night: { hour: [21, 29] },\n  rain: { weather: ['rain', 'storm'] }, snow: { weather: ['snow'] }, sun: { weather: ['sun', 'clear'] }, wind: { weather: ['wind'] },\n  spring: { season: 0 }, summer: { season: 1 }, autumn: { season: 2 }, winter: { season: 3 },\n};\nexport function lineObjects() {\n  const out = [];\n  for (const [type, banks] of Object.entries(TYPE_LINES)) {\n    for (const [bank, list] of Object.entries(banks)) list.forEach((text, i) => out.push({ id: `${type}.${bank}.${i}`, type, bank, text, when: BANK_WHEN[bank] ?? {}, weight: 1 }));\n  }\n  return out;\n}\nexport function allLineTexts() {\n  const out = [];\n  for (const banks of Object.values(TYPE_LINES)) for (const list of Object.values(banks)) out.push(...list);\n  for (const list of Object.values(UNIQUE)) out.push(...list);\n  for (const list of Object.values(MEMORY_LINES)) out.push(...list);\n  out.push(...GOSSIP);\n  for (const host of Object.values(HOSTS)) for (const v of Object.values(host)) { if (Array.isArray(v)) for (const e of v) out.push(typeof e === 'string' ? e : e.text); else if (typeof v === 'object') out.push(...Object.values(v)); }\n  return out;\n}\nconst TAGS = /\\{(\\w+)\\}/g;\nexport const KNOWN_TAGS = new Set(['player', 'town', 'item', 'neighbour', 'catch', 'target', 'debt', 'beans', 'season', 'text']);\n/** Resolve tags. Names come out wrapped so the dialogue draws them in colour. */\nexport function resolveTags(text, g, extra = {}) {\n  return text.replace(TAGS, (m, tag) => {\n    if (extra[tag] !== undefined) return String(extra[tag]);\n    const w = g?.world;\n    switch (tag) {\n      case 'player': return w?.player.name ?? 'you';\n      case 'town': return w?.player.town ?? 'here';\n      case 'neighbour': return 'someone';\n      case 'item': return 'thing';\n      case 'catch': return 'fish';\n      case 'debt': return (w?.player.debt ?? 0).toLocaleString('en-US');\n      case 'season': return SEASON_NAMES[calendar(w).season].toLowerCase();\n      default: return m;\n    }\n  });\n}\nfunction order(w, ownerBank, n) {\n  const s = new Stream(`${w.seed}:lines:${ownerBank}`);\n  return s.shuffle(Array.from({ length: n }, (_, i) => i));\n}\n/** Next unseen line in a bank. Cycles through all of them before repeating. */\nexport function nextFrom(w, owner, bank, list) {\n  if (!list?.length) return null;\n  w.flags.seen ??= {};\n  const k = `${owner}.${bank}`;\n  const i = w.flags.seen[k] ?? 0;\n  w.flags.seen[k] = i + 1;\n  const ord = order(w, k, list.length);\n  return list[ord[i % list.length]];\n}\nexport const hostLine = (g, host, bank) => {\n  const list = HOSTS[host]?.[bank];\n  return nextFrom(g.world, host, bank, list);\n};\nexport const typeLine = (g, npcId, bank) => {\n  const t = NEIGHBOURS[npcId].type;\n  return nextFrom(g.world, npcId, bank, TYPE_LINES[t][bank]);\n};\nexport const uniqueLine = (g, npcId) => nextFrom(g.world, npcId, 'unique', UNIQUE[npcId]);\nexport const otherNeighbour = (g, not) => {\n  const here = NEIGHBOUR_ORDER.filter((n) => n !== not && g.world.npcs[n].moved === 'here');\n  const s = new Stream(`${g.world.seed}:other:${g.world.clock.day}:${not}:${g.world.stats.talks[not] ?? 0}`);\n  return NEIGHBOURS[s.pick(here)].short ?? NEIGHBOURS[s.pick(here)].name;\n};\nexport const gossipLine = (g, npcId) => {\n  const t = nextFrom(g.world, npcId, 'gossip', GOSSIP);\n  return t.replace(/\\{neighbour\\}/g, otherNeighbour(g, npcId));\n};\nexport { hash32, ITEMS };\nEOF\ncat > src/systems/memory.js <<'EOF'\n// What the village remembers about you. Neighbours bring it up, each one once.\nimport { MEMORY_LINES } from '../data/dialogue/unique.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { nextFrom } from './lines.js';\n\nconst CAP = 80;\nexport function remember(g, k, data = {}) {\n  const w = g.world;\n  w.memory.push({ k, day: w.clock.day, heard: [], ...data });\n  if (w.memory.length > CAP) w.memory.shift();\n  g.events.emit('memory', { k, ...data });\n}\n/** The freshest thing this neighbour hasn't mentioned yet, as a resolved line. */\nexport function memoryLine(g, npcId) {\n  const w = g.world;\n  for (let i = w.memory.length - 1; i >= 0; i--) {\n    const m = w.memory[i];\n    if (m.heard.includes(npcId)) continue;\n    if (m.about === npcId && m.k !== 'bonk') continue;\n    if (m.k === 'bonk' && m.about !== npcId) continue;\n    if (w.clock.day - m.day > 5) break;\n    const list = MEMORY_LINES[m.k];\n    if (!list) continue;\n    m.heard.push(npcId);\n    const t = nextFrom(w, npcId, `mem.${m.k}`, list);\n    const neighbour = m.about ? (NEIGHBOURS[m.about]?.short ?? NEIGHBOURS[m.about]?.name ?? m.about) : 'someone';\n    return { text: t.replace(/\\{item\\}/g, m.item ?? 'thing').replace(/\\{catch\\}/g, m.catch ?? 'fish').replace(/\\{neighbour\\}/g, neighbour), memory: m };\n  }\n  return null;\n}\nEOF\ncat > src/systems/economy.js <<'EOF'\n// Pockets, beans, selling and buying, the debt. Pure-ish: only ever touches world and events.\nimport { ITEMS, SELLABLE } from '../data/items.js';\nimport { tuning } from '../dev/tuning.js';\nimport { remember } from './memory.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\n\nexport const POCKET_SLOTS = 15;\nexport const HOME_TIERS = [\n  { tier: 1, debt: 8000, name: 'Starter Shack' },\n  { tier: 2, debt: 30000, name: 'Proper Cottage' },\n  { tier: 3, debt: 80000, name: 'Cottage with Annex' },\n  { tier: 4, debt: 150000, name: 'Two Storeys' },\n];\nexport const hasRoom = (w) => w.player.pockets.some((s) => s === null);\n/** Add to Pockets. Returns the slot, or -1. A record of who gave it stays with the slot. */\nexport function addItem(g, id, meta = null) {\n  const p = g.world.player.pockets;\n  const i = p.indexOf(null);\n  if (i < 0) return -1;\n  p[i] = meta ? { id, ...meta } : { id };\n  g.events.emit('gotItem', { id, slot: i });\n  g.pocketsDirty = true;\n  return i;\n}\nexport const slotId = (s) => (s ? s.id : null);\nexport const countItem = (w, id) => w.player.pockets.filter((s) => s && s.id === id).length;\nexport function findItem(w, pred) {\n  return w.player.pockets.findIndex((s) => s && pred(s, ITEMS[s.id]));\n}\nexport function removeSlot(g, i) { const s = g.world.player.pockets[i]; g.world.player.pockets[i] = null; g.pocketsDirty = true; return s; }\nexport function addBeans(g, n, reason = '') {\n  const w = g.world;\n  w.player.beans = Math.max(0, w.player.beans + n);\n  if (n > 0) { w.stats.beansEarned += n; }\n  g.events.emit('beans', { n, reason });\n}\nexport const sellPrice = (g, slot) => {\n  const it = ITEMS[slot.id];\n  if (!it) return 0;\n  if (it.cat === 'cheese' && slot.id === 'cheese') return Math.round((g.life?.cheesePrice?.() ?? 100) * tuning.sellMult);\n  return Math.max(1, Math.round((it.sell ?? 10) * tuning.sellMult));\n};\nexport const buyPrice = (id) => Math.max(1, Math.round((ITEMS[id]?.price ?? 100) * tuning.buyMult));\nexport function sellSlot(g, i) {\n  const w = g.world;\n  const slot = w.player.pockets[i];\n  if (!slot || !SELLABLE(slot.id)) return 0;\n  const it = ITEMS[slot.id];\n  const price = sellPrice(g, slot);\n  removeSlot(g, i);\n  addBeans(g, price, 'sell');\n  w.stats.sold[slot.id] = (w.stats.sold[slot.id] ?? 0) + 1;\n  w.stats.soldTotal = (w.stats.soldTotal ?? 0) + 1;\n  if (slot.from || it.handmade) {\n    const from = slot.from ?? it.handmade;\n    remember(g, slot.id === 'scarfGift' ? 'soldScarf' : 'soldGift', { item: it.name, about: from });\n    w.npcs[from] && (w.npcs[from].friend = Math.max(0, w.npcs[from].friend - 2));\n  } else if ((w.stats.soldTotal % 6) === 0) remember(g, 'sold', { item: it.name });\n  g.events.emit('sold', { id: slot.id, price });\n  return price;\n}\nexport function payDebt(g, amount) {\n  const w = g.world;\n  const p = w.player;\n  const pay = Math.min(amount, p.beans, p.debt);\n  if (pay <= 0) return 0;\n  p.beans -= pay;\n  p.debt -= pay;\n  p.debtPaid += pay;\n  g.events.emit('debtPaid', { pay, left: p.debt });\n  return pay;\n}\nexport const nextTierCost = (w) => { const t = HOME_TIERS.find((x) => x.tier === w.player.homeTier + 1); return t ? Math.round(t.debt * tuning.debtMult) : null; };\n/** Take on the next tier. The house changes overnight in the source of these things; here, on signature. */\nexport function upgradeHome(g) {\n  const w = g.world;\n  const cost = nextTierCost(w);\n  if (cost == null || w.player.debt > 0) return false;\n  w.player.homeTier += 1;\n  w.player.debt += cost;\n  w.player.debtTier = w.player.homeTier;\n  g.town?.refreshHome();\n  remember(g, 'debtTier', {});\n  g.events.emit('homeTier', { tier: w.player.homeTier });\n  return true;\n}\nexport function spend(g, n) {\n  const w = g.world;\n  if (w.player.beans < n) return false;\n  w.player.beans -= n;\n  w.player.lifeSpend += n;\n  const tier = w.player.lifeSpend >= 120000 ? 3 : w.player.lifeSpend >= 25000 ? 2 : 1;\n  if (tier > w.store.tier) { w.store.tier = tier; w.flags.storeUpgraded = true; g.town?.refreshStore(); }\n  return true;\n}\nexport const giftScore = (npcId, itemId) => {\n  const n = NEIGHBOURS[npcId];\n  const it = ITEMS[itemId];\n  if (!n || !it) return 0;\n  if (n.id === 'tavi' || npcId === 'tavi') return 1;\n  const tags = new Set([...(it.tags ?? []), it.cat]);\n  if (n.hates.some((t) => tags.has(t))) return -1;\n  if (n.loves.some((t) => tags.has(t))) return 2;\n  return (it.sell ?? 0) > 300 ? 1 : 0;\n};\nEOF\necho done","description":"Write neighbours data, line picker, memory and economy"}}}
