 up: false, down: false, left: false, right: false };\n    this.held = { up: 0, down: 0, left: 0, right: 0 };\n    this.any = false;\n    this.mouse = { x: 240, y: 135, moved: false, over: false, down: false, click: false, rclick: false, used: false, seen: false };\n    this.lastPointer = { x: null, y: null };\n    this.keysTyped = [];\n    this.stickFlick = 0;\n    this.axisX = 0; this.axisY = 0;\n    this.padTilt = 0;\n    this.hudW = 480; this.hudH = 270;\n  }\n  /** Called once per rendered frame before anything reads it. */\n  begin(ctx, dt) {\n    const i = ctx.input;\n    this.i = i;\n    const axis = i.moveAxis();\n    this.axisX = axis.x; this.axisY = axis.y;\n    this.padTilt = Math.hypot(i.padAxis.x, i.padAxis.y);\n    // Any input, and which device\n    let padPress = false;\n    for (const c of PAD_CODES) if (i.wasPressed(c)) { padPress = true; break; }\n    if (padPress || this.padTilt > 0.25) this.device = 'pad';\n    let kbPress = false;\n    for (const c of KB_WATCH) if (i.wasPressed(c)) { kbPress = true; break; }\n    const p = i.pointer;\n    const moved = this.lastPointer.x !== null && (Math.abs(p.x - this.lastPointer.x) > 1e-3 || Math.abs(p.y - this.lastPointer.y) > 1e-3);\n    this.lastPointer.x = p.x; this.lastPointer.y = p.y;\n    const m = this.mouse;\n    m.moved = moved;\n    m.over = p.over;\n    m.x = Math.floor((p.x + 1) / 2 * this.hudW);\n    m.y = Math.floor((1 - p.y) / 2 * this.hudH);\n    m.click = i.wasPressed('MouseLeft');\n    m.rclick = i.wasPressed('MouseRight');\n    m.down = i.isDown('MouseLeft');\n    const mousePress = m.click || m.rclick || i.wasPressed('MouseMiddle');\n    if (kbPress || moved || mousePress || i.wheel !== 0) this.device = 'kbm';\n    this.any = padPress || this.padTilt > 0.25 || kbPress || moved || mousePress || i.wheel !== 0 || i.isDown('Touch') || i.wasPressed('Touch');\n    if (moved || mousePress) { m.used = true; m.seen = true; }\n    if (kbPress || padPress) m.used = false;\n    // Menu navigation with repeats; the stick and WASD count\n    const stick = { up: i.padAxis.y > 0.5, down: i.padAxis.y < -0.5, left: i.padAxis.x < -0.5, right: i.padAxis.x > 0.5 };\n    for (const dir of ['up', 'down', 'left', 'right']) {\n      const down = stick[dir] || i.anyDown(NAV[dir]);\n      this.nav[dir] = false;\n      if (down) {\n        if (this.held[dir] === 0) this.nav[dir] = true;\n        this.held[dir] += dt;\n        if (this.held[dir] > REPEAT_FIRST) { this.nav[dir] = true; this.held[dir] = REPEAT_FIRST - REPEAT_NEXT; }\n      } else this.held[dir] = 0;\n    }\n    // Right stick arrives as pointer movement with no button held\n    this.stickFlick = 0;\n    this.stickVert = 0;\n    if (this.device === 'pad' && !m.down) {\n      if (i.mouseDelta.x > 2) this.stickFlick = 1;\n      else if (i.mouseDelta.x < -2) this.stickFlick = -1;\n      if (i.mouseDelta.y > 2) this.stickVert = 1;\n      else if (i.mouseDelta.y < -2) this.stickVert = -1;\n    }\n    // Typed characters come through input.send\n    this.keysTyped.length = 0;\n    for (const c of i.commands) if (c && c.t === 'key') this.keysTyped.push(c.key);\n    const createHeld = i.isDown('PadCreate');\n    this.confirm = i.wasPressed('PadCross', 'KeyE', 'Enter');\n    this.back = i.wasPressed('PadCircle', 'Escape', 'Backspace');\n    this.useTool = i.wasPressed('PadSquare', 'Space', 'KeyF');\n    this.toolHeld = i.isDown('PadSquare', 'Space', 'KeyF', 'MouseRight');\n    this.pockets = i.wasPressed('PadTriangle', 'Tab', 'KeyI');\n    this.prevTool = i.wasPressed('PadL1') || i.wheel < 0;\n    this.nextTool = i.wasPressed('PadR1') || i.wheel > 0;\n    this.camL = i.wasPressed('PadL2', 'KeyQ') || this.stickFlick < 0;\n    this.camR = i.wasPressed('PadR2', 'KeyR') || this.stickFlick > 0;\n    this.map = i.wasPressed('PadTouch', 'PadUp', 'KeyM');\n    this.almanac = i.wasPressed('PadDown', 'KeyJ');\n    this.emote = i.wasPressed('PadLeft', 'KeyG');\n    this.pause = !createHeld && i.wasPressed('PadOptions', 'Escape');\n    this.running = i.isDown('PadCircle', 'ShiftLeft', 'ShiftRight');\n    this.sneaking = i.isDown('ControlLeft', 'ControlRight');\n    this.triangle = i.wasPressed('PadTriangle');\n    this.square = i.wasPressed('PadSquare');\n    this.tabPrev = i.wasPressed('PadL1', 'KeyQ');\n    this.tabNext = i.wasPressed('PadR1', 'KeyR');\n    this.digit = 0;\n    for (let d = 1; d <= 6; d++) if (i.wasPressed(`Digit${d}`)) this.digit = d;\n    this.zoomIn = i.wasPressed('Equal', 'NumpadAdd') || this.stickVert < 0;\n    this.zoomOut = i.wasPressed('Minus', 'NumpadSubtract') || this.stickVert > 0;\n  }\n  anyAction() { return this.confirm || this.back; }\n}\nEOF\ncat > src/ui/draw.js <<'EOF'\n// Panels and small drawing helpers, all in art pixels on the HUD.\nimport { drawText, textWidth, wrap, LINE_H } from './font.js';\nexport { drawText, textWidth, wrap, LINE_H };\n\nexport function panel(hud, x, y, w, h, { fill = 'white', trim = 'sand', edge = 'ink' } = {}) {\n  hud.rect(x + 1, y, w - 2, h, edge);\n  hud.rect(x, y + 1, w, h - 2, edge);\n  hud.rect(x + 1, y + 1, w - 2, h - 2, trim);\n  hud.rect(x + 3, y + 3, w - 6, h - 6, fill);\n}\nexport const dim = (hud, color = 'ink') => {\n  // A dither curtain: every other pixel row and column, cheap and legible behind panels.\n  hud.sprite(0, 0, DITHER_ROWS, { '#': color }, { shadow: false });\n};\nconst DITHER_ROWS = [];\nfor (let y = 0; y < 270; y++) {\n  let row = '';\n  for (let x = 0; x < 480; x++) row += (x + y) % 2 === 0 ? '#' : '.';\n  DITHER_ROWS.push(row);\n}\nexport function button(hud, x, y, w, h, label, { focused = false, disabled = false, scale = 1, align = 'center' } = {}) {\n  const fill = focused ? 'sand' : 'white';\n  panel(hud, x, y, w, h, { fill, trim: focused ? 'orange' : 'mist' });\n  const ty = y + Math.floor((h - 7 * scale) / 2);\n  if (align === 'center') drawText(hud, x + Math.floor(w / 2), ty, label, { color: disabled ? 'mist' : 'ink', align: 'center', scale });\n  else drawText(hud, x + 10, ty, label, { color: disabled ? 'mist' : 'ink', scale });\n}\nexport function bar(hud, x, y, w, h, t, color = 'green', back = 'night') {\n  hud.rect(x, y, w, h, back);\n  hud.rect(x, y, Math.round(w * Math.max(0, Math.min(1, t))), h, color);\n}\nexport function textBlock(hud, x, y, width, s, o = {}) {\n  const lines = wrap(s, width, o.scale ?? 1);\n  lines.forEach((l, i) => drawText(hud, x, y + i * (o.lineH ?? LINE_H), l, o));\n  return lines.length;\n}\nexport const inRect = (m, x, y, w, h) => m.x >= x && m.y >= y && m.x < x + w && m.y < y + h;\nEOF\ncat > src/ui/glyphs.js <<'EOF'\n// Button prompts: PlayStation glyphs, Xbox glyphs, keycaps and mouse icons, drawn as pixel sprites.\nimport { drawText, textWidth } from './font.js';\n\nconst ROUND = ['..#####..', '.#######.', '#########', '#########', '#########', '#########', '#########', '.#######.', '..#####..'];\nconst FACE = { cross: '✕', circle: '○', square: '□', triangle: '△' };\nconst FACE_COLOR = { cross: 'sky', circle: 'red', square: 'plum', triangle: 'green' };\nconst XBOX = { cross: 'A', circle: 'B', square: 'X', triangle: 'Y' };\nconst XBOX_COLOR = { cross: 'green', circle: 'red', square: 'blue', triangle: 'sand' };\nconst SHOULDER = { l1: ['L1', 'LB'], r1: ['R1', 'RB'], l2: ['L2', 'LT'], r2: ['R2', 'RT'], options: ['OPT', 'MENU'], dup: ['D↑', 'D↑'], ddown: ['D↓', 'D↓'], dleft: ['D←', 'D←'], touch: ['PAD', 'VIEW'], stick: ['LS', 'LS'] };\nconst MOUSE_L = ['.##.##.', '#..#..#', '####..#', '####..#', '#.....#', '#.....#', '.#####.'];\nconst MOUSE_R = ['.##.##.', '#..#..#', '#..####', '#..####', '#.....#', '#.....#', '.#####.'];\nconst WHEEL = ['.##.##.', '#..#..#', '#..#..#', '#.....#', '#.....#', '#.....#', '.#####.'];\nconst COL = { '#': 'ink' };\n/** A prompt per action and device. */\nconst KEY_FOR = {\n  confirm: 'E', back: 'Esc', use: 'Space', pockets: 'Tab', tools: '1-6', map: 'M', almanac: 'J', emote: 'G', pause: 'Esc', camera: 'Q R', run: 'Shift', sneak: 'Ctrl', more: 'R', random: 'Tab', zoom: '+ -', tabs: 'Q R', fill: 'F', mirror: 'M', undo: 'Z', pick: 'E',\n};\nconst PAD_FOR = {\n  confirm: 'cross', back: 'circle', use: 'square', pockets: 'triangle', map: 'touch', almanac: 'ddown', emote: 'dleft', pause: 'options', camera: 'l2', run: 'circle', more: 'triangle', random: 'triangle', zoom: 'stick', tools: 'l1', tabs: 'l1', fill: 'square', mirror: 'triangle', undo: 'l2', pick: 'cross',\n};\nconst MOUSE_FOR = { confirm: MOUSE_L, pick: MOUSE_L, use: MOUSE_R, back: MOUSE_R };\n\nfunction faceGlyph(hud, x, y, which, xbox) {\n  const color = xbox ? XBOX_COLOR[which] : FACE_COLOR[which];\n  hud.sprite(x, y - 1, ROUND, { '#': 'ink' }, { shadow: false });\n  hud.sprite(x + 1, y, ROUND.slice(1, 8).map((r) => r.slice(1, 8)), { '#': 'white' }, { shadow: false });\n  drawText(hud, x + 2, y + 1, xbox ? XBOX[which] : FACE[which], { color });\n  return 10;\n}\nfunction capGlyph(hud, x, y, label) {\n  const w = textWidth(label) + 6;\n  hud.rect(x, y - 1, w, 10, 'ink');\n  hud.rect(x + 1, y, w - 2, 7, 'white');\n  hud.rect(x + 1, y + 7, w - 2, 1, 'mist');\n  drawText(hud, x + 3, y, label, { color: 'ink' });\n  return w;\n}\nexport function drawPromptGlyph(hud, x, y, action, device, xboxGlyphs, mouseUsed) {\n  if (device === 'pad') {\n    const code = PAD_FOR[action];\n    if (FACE[code]) return faceGlyph(hud, x, y, code, xboxGlyphs);\n    const s = SHOULDER[code];\n    return capGlyph(hud, x, y, (s ? s[xboxGlyphs ? 1 : 0] : code ?? '?').replace('↑', '^').replace('↓', 'v').replace('←', '<'));\n  }\n  if (mouseUsed && MOUSE_FOR[action]) {\n    hud.sprite(x, y, MOUSE_FOR[action], COL, { shadow: false });\n    return 8;\n  }\n  return capGlyph(hud, x, y, KEY_FOR[action] ?? action);\n}\nexport const promptGlyphText = (action, device, xbox) => {\n  if (device === 'pad') {\n    const c = PAD_FOR[action];\n    return FACE[c] ? (xbox ? XBOX[c] : FACE[c]) : (SHOULDER[c]?.[xbox ? 1 : 0] ?? c);\n  }\n  return KEY_FOR[action] ?? action;\n};\nexport const WHEEL_ICON = WHEEL;\nEOF\necho ok","description":"Write input layer, panel helpers and button glyphs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14005,"cache_read_input_tokens":278240,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14005},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"764f4112-0961-40a2-b092-707d918d2932","timestamp":"2026-11-06T00:36:53.959Z","request_id":"req_011Cgkjiikmg7yGFSBsiwwia","wire_tool_inputs":{"toolu_01Bct8XUc3JZJJfNYXEfvdJu":{"command":"python3 - <<'EOF'\np='src/actors/clips.js'\ns=open(p).read()\ns=s.replace(\"loop('Idle', 60, [[0, REST], [60, REST]], { layers: breathe() })\",\"loop('Idle', 80, [[0, REST], [80, REST]], { layers: breathe() })\")\ns=s.replace(\"[48, { Head: [3, 0, 3] }]], { layers: breathe() })\",\"[48, { Head: [3, 0, 3] }]], { layers: breathe(48) })\")\nopen(p,'w').write(s)\nEOF\nnode tools/clipcheck.mjs\ncat > src/ui/input.js <<'EOF'\n// One view of the three devices: named actions, last device, art-pixel mouse, menu repeats.\nexport const PAD_BUTTONS = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight', 16: 'PadPS', 17: 'PadTouch' };\nconst PAD_CODES = Object.values(PAD_BUTTONS);\nconst KB_WATCH = ['KeyA', 'KeyB', 'KeyC', 'KeyD', 'KeyE', 'KeyF', 'KeyG', 'KeyH', 'KeyI', 'KeyJ', 'KeyK', 'KeyL', 'KeyM', 'KeyN', 'KeyO', 'KeyP', 'KeyQ', 'KeyR', 'KeyS', 'KeyT', 'KeyU', 'KeyV', 'KeyW', 'KeyX', 'KeyY', 'KeyZ', 'Space', 'Enter', 'Escape', 'Backspace', 'Tab', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ShiftLeft', 'ShiftRight', 'ControlLeft', 'ControlRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6', 'Digit7', 'Digit8', 'Digit9', 'Digit0', 'Minus', 'Equal', 'NumpadAdd', 'NumpadSubtract'];\nconst MOUSE = ['MouseLeft', 'MouseRight', 'MouseMiddle'];\nconst NAV = {\n  up: ['PadUp', 'ArrowUp', 'KeyW'], down: ['PadDown', 'ArrowDown', 'KeyS'],\n  left: ['PadLeft', 'ArrowLeft', 'KeyA'], right: ['PadRight', 'ArrowRight', 'KeyD'],\n};\nconst REPEAT_FIRST = 0.34, REPEAT_NEXT = 0.11;\n\nexport class GameInput {\n  constructor() {\n    this.device = 'kbm';\n    this.nav = { up: false, down: false, left: false, right: false };\n    this.held = { up: 0, down: 0, left: 0, right: 0 };\n    this.any = false;\n    this.mouse = { x: 240, y: 135, moved: false, over: false, down: false, click: false, rclick: false, used: false, seen: false };\n    this.lastPointer = { x: null, y: null };\n    this.keysTyped = [];\n    this.stickFlick = 0;\n    this.axisX = 0; this.axisY = 0;\n    this.padTilt = 0;\n    this.hudW = 480; this.hudH = 270;\n  }\n  /** Called once per rendered frame before anything reads it. */\n  begin(ctx, dt) {\n    const i = ctx.input;\n    this.i = i;\n    const axis = i.moveAxis();\n    this.axisX = axis.x; this.axisY = axis.y;\n    this.padTilt = Math.hypot(i.padAxis.x, i.padAxis.y);\n    // Any input, and which device\n    let padPress = false;\n    for (const c of PAD_CODES) if (i.wasPressed(c)) { padPress = true; break; }\n    if (padPress || this.padTilt > 0.25) this.device = 'pad';\n    let kbPress = false;\n    for (const c of KB_WATCH) if (i.wasPressed(c)) { kbPress = true; break; }\n    const p = i.pointer;\n    const moved = this.lastPointer.x !== null && (Math.abs(p.x - this.lastPointer.x) > 1e-3 || Math.abs(p.y - this.lastPointer.y) > 1e-3);\n    this.lastPointer.x = p.x; this.lastPointer.y = p.y;\n    const m = this.mouse;\n    m.moved = moved;\n    m.over = p.over;\n    m.x = Math.floor((p.x + 1) / 2 * this.hudW);\n    m.y = Math.floor((1 - p.y) / 2 * this.hudH);\n    m.click = i.wasPressed('MouseLeft');\n    m.rclick = i.wasPressed('MouseRight');\n    m.down = i.isDown('MouseLeft');\n    const mousePress = m.click || m.rclick || i.wasPressed('MouseMiddle');\n    if (kbPress || moved || mousePress || i.wheel !== 0) this.device = 'kbm';\n    this.any = padPress || this.padTilt > 0.25 || kbPress || moved || mousePress || i.wheel !== 0 || i.isDown('Touch') || i.wasPressed('Touch');\n    if (moved || mousePress) { m.used = true; m.seen = true; }\n    if (kbPress || padPress) m.used = false;\n    // Menu navigation with repeats; the stick and WASD count\n    const stick = { up: i.padAxis.y > 0.5, down: i.padAxis.y < -0.5, left: i.padAxis.x < -0.5, right: i.padAxis.x > 0.5 };\n    for (const dir of ['up', 'down', 'left', 'right']) {\n      const down = stick[dir] || i.anyDown(NAV[dir]);\n      this.nav[dir] = false;\n      if (down) {\n        if (this.held[dir] === 0) this.nav[dir] = true;\n        this.held[dir] += dt;\n        if (this.held[dir] > REPEAT_FIRST) { this.nav[dir] = true; this.held[dir] = REPEAT_FIRST - REPEAT_NEXT; }\n      } else this.held[dir] = 0;\n    }\n    // Right stick arrives as pointer movement with no button held\n    this.stickFlick = 0;\n    this.stickVert = 0;\n    if (this.device === 'pad' && !m.down) {\n      if (i.mouseDelta.x > 2) this.stickFlick = 1;\n      else if (i.mouseDelta.x < -2) this.stickFlick = -1;\n      if (i.mouseDelta.y > 2) this.stickVert = 1;\n      else if (i.mouseDelta.y < -2) this.stickVert = -1;\n    }\n    // Typed characters come through input.send\n    this.keysTyped.length = 0;\n    for (const c of i.commands) if (c && c.t === 'key') this.keysTyped.push(c.key);\n    const createHeld = i.isDown('PadCreate');\n    this.confirm = i.wasPressed('PadCross', 'KeyE', 'Enter');\n    this.back = i.wasPressed('PadCircle', 'Escape', 'Backspace');\n    this.useTool = i.wasPressed('PadSquare', 'Space', 'KeyF');\n    this.toolHeld = i.isDown('PadSquare', 'Space', 'KeyF', 'MouseRight');\n    this.pockets = i.wasPressed('PadTriangle', 'Tab', 'KeyI');\n    this.prevTool = i.wasPressed('PadL1') || i.wheel < 0;\n    this.nextTool = i.wasPressed('PadR1') || i.wheel > 0;\n    this.camL = i.wasPressed('PadL2', 'KeyQ') || this.stickFlick < 0;\n    this.camR = i.wasPressed('PadR2', 'KeyR') || this.stickFlick > 0;\n    this.map = i.wasPressed('PadTouch', 'PadUp', 'KeyM');\n    this.almanac = i.wasPressed('PadDown', 'KeyJ');\n    this.emote = i.wasPressed('PadLeft', 'KeyG');\n    this.pause = !createHeld && i.wasPressed('PadOptions', 'Escape');\n    this.running = i.isDown('PadCircle', 'ShiftLeft', 'ShiftRight');\n    this.sneaking = i.isDown('ControlLeft', 'ControlRight');\n    this.triangle = i.wasPressed('PadTriangle');\n    this.square = i.wasPressed('PadSquare');\n    this.tabPrev = i.wasPressed('PadL1', 'KeyQ');\n    this.tabNext = i.wasPressed('PadR1', 'KeyR');\n    this.digit = 0;\n    for (let d = 1; d <= 6; d++) if (i.wasPressed(`Digit${d}`)) this.digit = d;\n    this.zoomIn = i.wasPressed('Equal', 'NumpadAdd') || this.stickVert < 0;\n    this.zoomOut = i.wasPressed('Minus', 'NumpadSubtract') || this.stickVert > 0;\n  }\n  anyAction() { return this.confirm || this.back; }\n}\nEOF\ncat > src/ui/draw.js <<'EOF'\n// Panels and small drawing helpers, all in art pixels on the HUD.\nimport { drawText, textWidth, wrap, LINE_H } from './font.js';\nexport { drawText, textWidth, wrap, LINE_H };\n\nexport function panel(hud, x, y, w, h, { fill = 'white', trim = 'sand', edge = 'ink' } = {}) {\n  hud.rect(x + 1, y, w - 2, h, edge);\n  hud.rect(x, y + 1, w, h - 2, edge);\n  hud.rect(x + 1, y + 1, w - 2, h - 2, trim);\n  hud.rect(x + 3, y + 3, w - 6, h - 6, fill);\n}\nexport const dim = (hud, color = 'ink') => {\n  // A dither curtain: every other pixel row and column, cheap and legible behind panels.\n  hud.sprite(0, 0, DITHER_ROWS, { '#': color }, { shadow: false });\n};\nconst DITHER_ROWS = [];\nfor (let y = 0; y < 270; y++) {\n  let row = '';\n  for (let x = 0; x < 480; x++) row += (x + y) % 2 === 0 ? '#' : '.';\n  DITHER_ROWS.push(row);\n}\nexport function button(hud, x, y, w, h, label, { focused = false, disabled = false, scale = 1, align = 'center' } = {}) {\n  const fill = focused ? 'sand' : 'white';\n  panel(hud, x, y, w, h, { fill, trim: focused ? 'orange' : 'mist' });\n  const ty = y + Math.floor((h - 7 * scale) / 2);\n  if (align === 'center') drawText(hud, x + Math.floor(w / 2), ty, label, { color: disabled ? 'mist' : 'ink', align: 'center', scale });\n  else drawText(hud, x + 10, ty, label, { color: disabled ? 'mist' : 'ink', scale });\n}\nexport function bar(hud, x, y, w, h, t, color = 'green', back = 'night') {\n  hud.rect(x, y, w, h, back);\n  hud.rect(x, y, Math.round(w * Math.max(0, Math.min(1, t))), h, color);\n}\nexport function textBlock(hud, x, y, width, s, o = {}) {\n  const lines = wrap(s, width, o.scale ?? 1);\n  lines.forEach((l, i) => drawText(hud, x, y + i * (o.lineH ?? LINE_H), l, o));\n  return lines.length;\n}\nexport const inRect = (m, x, y, w, h) => m.x >= x && m.y >= y && m.x < x + w && m.y < y + h;\nEOF\ncat > src/ui/glyphs.js <<'EOF'\n// Button prompts: PlayStation glyphs, Xbox glyphs, keycaps and mouse icons, drawn as pixel sprites.\nimport { drawText, textWidth } from './font.js';\n\nconst ROUND = ['..#####..', '.#######.', '#########', '#########', '#########', '#########', '#########', '.#######.', '..#####..'];\nconst FACE = { cross: '✕', circle: '○', square: '□', triangle: '△' };\nconst FACE_COLOR = { cross: 'sky', circle: 'red', square: 'plum', triangle: 'green' };\nconst XBOX = { cross: 'A', circle: 'B', square: 'X', triangle: 'Y' };\nconst XBOX_COLOR = { cross: 'green', circle: 'red', square: 'blue', triangle: 'sand' };\nconst SHOULDER = { l1: ['L1', 'LB'], r1: ['R1', 'RB'], l2: ['L2', 'LT'], r2: ['R2', 'RT'], options: ['OPT', 'MENU'], dup: ['D↑', 'D↑'], ddown: ['D↓', 'D↓'], dleft: ['D←', 'D←'], touch: ['PAD', 'VIEW'], stick: ['LS', 'LS'] };\nconst MOUSE_L = ['.##.##.', '#..#..#', '####..#', '####..#', '#.....#', '#.....#', '.#####.'];\nconst MOUSE_R = ['.##.##.', '#..#..#', '#..####', '#..####', '#.....#', '#.....#', '.#####.'];\nconst WHEEL = ['.##.##.', '#..#..#', '#..#..#', '#.....#', '#.....#', '#.....#', '.#####.'];\nconst COL = { '#': 'ink' };\n/** A prompt per action and device. */\nconst KEY_FOR = {\n  confirm: 'E', back: 'Esc', use: 'Space', pockets: 'Tab', tools: '1-6', map: 'M', almanac: 'J', emote: 'G', pause: 'Esc', camera: 'Q R', run: 'Shift', sneak: 'Ctrl', more: 'R', random: 'Tab', zoom: '+ -', tabs: 'Q R', fill: 'F', mirror: 'M', undo: 'Z', pick: 'E',\n};\nconst PAD_FOR = {\n  confirm: 'cross', back: 'circle', use: 'square', pockets: 'triangle', map: 'touch', almanac: 'ddown', emote: 'dleft', pause: 'options', camera: 'l2', run: 'circle', more: 'triangle', random: 'triangle', zoom: 'stick', tools: 'l1', tabs: 'l1', fill: 'square', mirror: 'triangle', undo: 'l2', pick: 'cross',\n};\nconst MOUSE_FOR = { confirm: MOUSE_L, pick: MOUSE_L, use: MOUSE_R, back: MOUSE_R };\n\nfunction faceGlyph(hud, x, y, which, xbox) {\n  const color = xbox ? XBOX_COLOR[which] : FACE_COLOR[which];\n  hud.sprite(x, y - 1, ROUND, { '#': 'ink' }, { shadow: false });\n  hud.sprite(x + 1, y, ROUND.slice(1, 8).map((r) => r.slice(1, 8)), { '#': 'white' }, { shadow: false });\n  drawText(hud, x + 2, y + 1, xbox ? XBOX[which] : FACE[which], { color });\n  return 10;\n}\nfunction capGlyph(hud, x, y, label) {\n  const w = textWidth(label) + 6;\n  hud.rect(x, y - 1, w, 10, 'ink');\n  hud.rect(x + 1, y, w - 2, 7, 'white');\n  hud.rect(x + 1, y + 7, w - 2, 1, 'mist');\n  drawText(hud, x + 3, y, label, { color: 'ink' });\n  return w;\n}\nexport function drawPromptGlyph(hud, x, y, action, device, xboxGlyphs, mouseUsed) {\n  if (device === 'pad') {\n    const code = PAD_FOR[action];\n    if (FACE[code]) return faceGlyph(hud, x, y, code, xboxGlyphs);\n    const s = SHOULDER[code];\n    return capGlyph(hud, x, y, (s ? s[xboxGlyphs ? 1 : 0] : code ?? '?').replace('↑', '^').replace('↓', 'v').replace('←', '<'));\n  }\n  if (mouseUsed && MOUSE_FOR[action]) {\n    hud.sprite(x, y, MOUSE_FOR[action], COL, { shadow: false });\n    return 8;\n  }\n  return capGlyph(hud, x, y, KEY_FOR[action] ?? action);\n}\nexport const promptGlyphText = (action, device, xbox) => {\n  if (device === 'pad') {\n    const c = PAD_FOR[action];\n    return FACE[c] ? (xbox ? XBOX[c] : FACE[c]) : (SHOULDER[c]?.[xbox ? 1 : 0] ?? c);\n  }\n  return KEY_FOR[action] ?? action;\n};\nexport const WHEEL_ICON = WHEEL;\nEOF\necho ok","description":"Write input layer, panel helpers and button glyphs"}}}
