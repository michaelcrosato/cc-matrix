{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgknttZVxFaP1UH7HHk7u","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10473,"cache_read_input_tokens":583840,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10473},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"71037a6a-ebab-4199-ab59-6413e27671e3","timestamp":"2026-11-06T01:17:18.921Z","request_id":"req_011Cgkntt8Ceow6GpBPHtYXc","thinking_duration_ms":1334,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgknttZVxFaP1UH7HHk7u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013afjzrJiAw7iX7k1LPZ6e4","name":"Bash","input":{"command":"python3 - <<'EOF'\np='src/systems/services.js'\ns=open(p).read()\ns=s.replace(\"function quoteLabel(g, hud, text) { g.ui.drawText?.(hud, text); import('../ui/draw.js').then(() => {}); drawQuote(hud, text); }\\nimport { drawText, panel, textWidth } from '../ui/draw.js';\\n\",\"function quoteLabel(g, hud, text) { drawQuote(hud, text); }\\n\")\ns=s.replace(\"import { wear } from './pocketActions.js';\\n\",\"import { wear } from './pocketActions.js';\\nimport { drawText, panel, textWidth } from '../ui/draw.js';\\n\")\nopen(p,'w').write(s)\nEOF\ncat > src/systems/venues.js <<'EOF'\n// The City's venues. Each has its own fun, not a bare menu.\nimport { say, ask, narrate } from './say.js';\nimport { hostLine } from './lines.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { ITEMS } from '../data/items.js';\nimport { addItem, hasRoom, removeSlot, spend, sellPrice, addBeans } from './economy.js';\nimport { CLOTHES, HAT_ITEMS, UMBRELLAS } from '../data/clothes.js';\nimport { Stream } from '../core/rng.js';\nimport { lookEditor } from '../ui/screens/lookEditor.js';\nimport { pocketsPicker } from '../ui/screens/pockets.js';\nimport { sendMail } from './mail.js';\nimport { remember } from './memory.js';\nimport { scoreHome, gradeOf, GRADES } from './rating.js';\nimport { ART } from '../data/art.js';\nimport { FURNITURE } from '../data/furniture.js';\nimport { auctionScreen, consignResult } from '../ui/screens/auction.js';\nimport { compareScreen } from '../ui/screens/compare.js';\nimport { theatreScreen } from '../ui/screens/theatre.js';\nimport { menuChoiceFree } from '../ui/screens/numbers.js';\nimport { hourNow } from './time.js';\nimport { ALL_EMOTES } from '../ui/screens/emote.js';\n\nexport const FASHION_THEMES = [\n  { name: 'Something damp', tags: ['damp', 'nautical'] }, { name: 'Formal, but sorry about it', tags: ['formal', 'drab'] }, { name: 'Loud enough to hear from the bus', tags: ['loud', 'dramatic'] }, { name: 'Cosy to the point of concern', tags: ['cosy', 'wool', 'sleepy'] }, { name: 'Money', tags: ['money', 'formal'] }, { name: 'Leafy', tags: ['leafy', 'plain'] }, { name: 'A person who sleeps well', tags: ['sleepy', 'plain'] }, { name: 'Cheese, obviously', tags: ['cheese', 'loud'] }, { name: 'Tragedy', tags: ['dramatic', 'drab'] }, { name: 'Ready for anything but this', tags: ['practical', 'sporty'] },\n];\nexport function fashionScore(look, theme) {\n  const tags = new Set();\n  for (const k of ['outfit', 'hatItem', 'glassesItem', 'umbrella']) { const it = ITEMS[look[k]]; for (const t of it?.tags ?? []) tags.add(t); }\n  let hits = 0;\n  for (const t of theme.tags) if (tags.has(t)) hits++;\n  let score = hits * 2;\n  if (ITEMS[look.outfit]?.couture) score += 1;\n  if (look.hatItem) score += 1;\n  if (tags.has('couture')) score += 1;\n  if (look.outfit === 'tatteredShirt') score -= 1;\n  return { score: Math.max(0, Math.min(5, score)), hits, tags: [...tags] };\n}\nconst hatCommentary = (look) => (ITEMS[look.hatItem] ? `The ${ITEMS[look.hatItem].name}. Well. It's on your head, and I suppose that's somewhere.` : 'No hat. Bold. Bold in the way a cliff is bold.');\nexport const VENUES = {\n  *salonChair(g, t) {\n    const w = g.world;\n    const a = g.actorOf('fleece');\n    a.play('Talk', 0.15);\n    const c = yield* ask(g, 'fleece', hostLine(g, 'fleece', 'greet'), ['A cut, please. 800 beans.', 'Just the gossip', 'Never mind']);\n    if (c === 1) { yield* say(g, 'fleece', hostLine(g, 'fleece', 'gossip')); return; }\n    if (c !== 0) return;\n    if (w.player.beans < 800) { yield* say(g, 'fleece', \"Ah, non. For this money I can only look at it sadly. I am doing it now.\"); return; }\n    const before = JSON.stringify(w.player.look);\n    const seat = t.prop;\n    g.player.x = seat.x; g.player.z = seat.z + 0.55; g.player.facing = 0;\n    g.player.turnTo = null;\n    g.sound('scissors');\n    const changed = yield* lookEditor(g, { title: 'Snip & Gossip', turntable: true, hairOnly: true });\n    if (changed && JSON.stringify(w.player.look) !== before) {\n      spend(g, 800);\n      g.sound('scissors');\n      g.events.emit('haircut', {});\n      yield* say(g, 'fleece', [hostLine(g, 'fleece', 'done'), hostLine(g, 'fleece', 'gossip')]);\n    }\n  },\n  *coutureRail(g) {\n    const w = g.world;\n    if (w.player.plumes < 3) { yield* say(g, 'flavia', \"Darling. That rail is for people with three plumes. You are not one of them, in several senses.\"); return; }\n    yield* say(g, 'flavia', hostLine(g, 'flavia', 'rope'));\n    const stock = [...CLOTHES, ...HAT_ITEMS, ...UMBRELLAS].filter((c) => c.couture && !w.flags[`bought:couture:${c.id}`]);\n    if (!stock.length) { yield* say(g, 'flavia', \"You've bought it all. There's nothing left for you to be wrong in.\"); return; }\n    const labels = stock.slice(0, 5).map((s) => `${s.name}: ${s.price.toLocaleString('en-US')}`);\n    labels.push('Never mind');\n    const c = yield* menuChoiceFree(g, 'The couture rail', labels);\n    if (c < 0 || c >= stock.length || c >= 5) return;\n    const it = stock[c];\n    if (w.player.beans < it.price) { yield* say(g, 'flavia', \"You can't afford to be that person yet.\"); return; }\n    if (!hasRoom(w)) { yield* say(g, 'flavia', 'Your pockets are full. Of what? No. Do not tell me.'); return; }\n    spend(g, it.price);\n    addItem(g, it.id);\n    w.flags[`bought:couture:${it.id}`] = true;\n    g.sound('plume');\n    g.events.emit('bought', { id: it.id, price: it.price });\n  },\n  *hostTalkFlavia(g) { yield* VENUES.fashionCheck(g); },\n  *fashionCheck(g) {\n    const w = g.world;\n    const s = new Stream(`${w.seed}:theme:${w.clock.day}`);\n    const theme = s.pick(FASHION_THEMES);\n    const a = g.actorOf('flavia');\n    if (w.player.fashionDay === w.clock.day) { yield* say(g, 'flavia', \"I've seen you today. I'm still recovering. Come back tomorrow, in something else.\"); return; }\n    a.play('Talk', 0.15);\n    const c = yield* ask(g, 'flavia', [hostLine(g, 'flavia', 'greet')].join('//') + `//Today's theme: \"${theme.name}\". Shall I look at you?`, ['Judge me', 'Not yet']);\n    if (c !== 0) return;\n    const look = w.player.look;\n    yield* say(g, 'flavia', [hostLine(g, 'flavia', 'judge'), ITEMS[look.outfit] ? `The ${ITEMS[look.outfit].name}. ${ITEMS[look.outfit].tags?.includes(theme.tags[0]) ? 'Yes. I see what you were reaching for.' : 'I see what you were running from.'}` : 'Nothing about that makes sense.', hatCommentary(look)]);\n    const r = fashionScore(look, theme);\n    w.player.fashionDay = w.clock.day;\n    for (let i = 0; i < r.score; i++) { g.sound('plume'); yield 0.35; }\n    a.play(r.score >= 3 ? 'Nod' : 'ShakeHead', 0.1, { once: true });\n    yield* say(g, 'flavia', HOSTS.flavia[`result${r.score}`]);\n    const before = w.player.plumes;\n    w.player.plumes = Math.max(before, r.score);\n    w.player.plumesTotal = (w.player.plumesTotal ?? 0) + r.score;\n    remember(g, 'fashion', { item: String(r.score) });\n    g.events.emit('fashionChecked', { score: r.score, theme: theme.name });\n    if (w.player.plumes >= 3 && before < 3) yield* say(g, 'flavia', hostLine(g, 'flavia', 'rope'));\n  },\n  *magdaCounter(g) {\n    const w = g.world;\n    const a = g.actorOf('magda');\n    const c = yield* ask(g, 'magda', hostLine(g, 'magda', 'greet'), ['Rare furniture?', 'Chat', 'Goodbye']);\n    if (c === 0) {\n      const rare = FURNITURE.filter((f) => f.rare && !w.flags[`bought:rare:${f.id}`]);\n      if (!rare.length) { yield* say(g, 'magda', \"Sold out. Wagon's been very careful lately.\"); return; }\n      const it = rare[w.clock.day % rare.length];\n      const price = it.price;\n      const b = yield* ask(g, 'magda', `${hostLine(g, 'magda', 'rare')}//${it.name}. ${price.toLocaleString('en-US')} beans.`, ['Buy it', 'No']);\n      if (b === 0) {\n        if (w.player.beans < price || !hasRoom(w)) { yield* say(g, 'magda', 'Come back when you can carry it, and pay for it. In that order, ideally.'); return; }\n        spend(g, price);\n        addItem(g, it.id);\n        w.flags[`bought:rare:${it.id}`] = true;\n        g.sound('bean');\n        g.events.emit('bought', { id: it.id, price });\n      }\n    } else if (c === 1) yield* say(g, 'magda', hostLine(g, 'magda', 'idle'));\n    if (a === null) yield;\n  },\n  *magdaLook(g, t) {\n    const w = g.world;\n    const s = t.stock;\n    const it = ITEMS[s.id];\n    if (w.flags[`bought:${w.clock.day}:${s.id}`]) { yield* narrate(g, 'An empty easel. It looks relieved.'); return; }\n    const c = yield* ask(g, 'magda', `${it.name}. ${s.price.toLocaleString('en-US')} beans. ${hostLine(g, 'magda', 'sell')}`, ['Buy it', 'Compare with the print', 'Leave it']);\n    if (c === 1) {\n      let closed = false;\n      g.ui.push(compareScreen(g, s, () => { closed = true; }));\n      while (!closed) yield;\n      g.events.emit('compared', { id: s.id, forged: !!it.forged });\n      return;\n    }\n    if (c !== 0) return;\n    if (w.player.beans < s.price) { yield* say(g, 'magda', \"No. Beans first. Then the painting. Then we've never met.\"); return; }\n    if (!hasRoom(w)) { yield* say(g, 'magda', 'Pockets full. It does not fold. Well. It does once.'); return; }\n    spend(g, s.price);\n    addItem(g, s.id);\n    w.flags[`bought:${w.clock.day}:${s.id}`] = true;\n    g.sound('bean');\n    g.place.refreshDynamic();\n    g.events.emit('boughtArt', { id: s.id, forged: !!it.forged });\n    yield* say(g, 'magda', hostLine(g, 'magda', 'sold'));\n  },\n  *catalogueCompare(g) {\n    const stock = g.life.magdaStock();\n    let closed = false;\n    g.ui.push(compareScreen(g, stock[0], () => { closed = true; }));\n    while (!closed) yield;\n  },\n  *theatreSeat(g, t) {\n    const w = g.world;\n    if (w.flags.theatreDay === w.clock.day) { yield* say(g, 'bellows', \"One show a day! My throat is a delicate instrument, and also it's insured!\"); return; }\n    g.player.x = t.prop.x; g.player.z = t.prop.z - 0.1; g.player.facing = Math.PI; g.player.turnTo = null;\n    g.player.play('Sit', 0.12);\n    g.player.locked = true;\n    yield* say(g, 'bellows', [hostLine(g, 'bellows', 'greet'), hostLine(g, 'bellows', 'sketch')]);\n    let result = null;\n    g.ui.push(theatreScreen(g, (r) => { result = r; }));\n    while (result === null) yield;\n    w.flags.theatreDay = w.clock.day;\n    g.player.locked = false;\n    g.player.z = t.prop.z + 0.8;\n    g.player.play('Idle', 0.15);\n    if (result.won) {\n      const left = ALL_EMOTES.filter((e) => !w.player.emotes.includes(e));\n      if (left.length) {\n        const em = left[w.clock.day % left.length];\n        w.player.emotes.push(em);\n        g.sound('reveal');\n        yield* say(g, 'bellows', hostLine(g, 'bellows', 'win'));\n        g.ui.toastMsg(`You learned an emote: ${em}!`);\n        g.events.emit('emoteLearned', { em });\n      } else yield* say(g, 'bellows', \"You know everything I do! Get out! Bravo!\");\n    } else yield* say(g, 'bellows', hostLine(g, 'bellows', 'miss'));\n  },\n  *auctionStart(g) {\n    const w = g.world;\n    const h = hourNow(w);\n    if (w.flags.auctionDay === w.clock.day) { yield* say(g, 'pemberton', \"That's-it-that's-all-three-lots-gone-see-you-tomorrow-go-home-I-have-to-lie-down!\"); return; }\n    yield* say(g, 'pemberton', hostLine(g, 'pemberton', 'greet'));\n    let done = false;\n    g.ui.push(auctionScreen(g, () => { done = true; }));\n    while (!done) yield;\n    w.flags.auctionDay = w.clock.day;\n    if (h < 0) yield;\n  },\n  *consign(g) {\n    const w = g.world;\n    if (w.flags.consignedDay === w.clock.day) { yield* say(g, 'pemberton', 'One-box-a-day-one-box-a-day-it-is-a-very-small-box!'); return; }\n    let picked = -2;\n    g.ui.push(pocketsPicker(g, { title: 'Consign what?', filter: (s) => { const it = ITEMS[s.id]; return !!it && it.cat !== 'quest' && it.cat !== 'tool' && it.cat !== 'bag'; }, onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n    while (picked === -2) yield;\n    if (picked < 0) return;\n    const slot = removeSlot(g, picked);\n    const it = ITEMS[slot.id];\n    const r = consignResult(w, slot.id, sellPrice(g, slot));\n    sendMail(g, { from: 'auction', body: `Dear-Sir-Madam-Or-Other,\\nYour ${it.name} sold for ${r.price.toLocaleString('en-US')} beans to ${r.buyer}! Congratulations! We've kept a little! Enclosed is the rest!\\nPemberton`, gift: { beans: r.price }, arriveDay: w.clock.day + 1 });\n    w.flags.consignedDay = w.clock.day;\n    g.sound('stamp');\n    g.events.emit('consigned', { id: slot.id, price: r.price });\n    yield* say(g, 'pemberton', 'In-the-box-in-the-box-result-by-post-mind-the-step!');\n  },\n  *brisketDesk(g) {\n    const w = g.world;\n    yield* say(g, 'brisket', hostLine(g, 'brisket', 'greet'));\n    const c = yield* ask(g, 'brisket', 'State your business.', ['Critique my home', 'How is it scored?', 'Any rewards for me?', 'Goodbye']);\n    if (c === 0) {\n      const r = scoreHome(w);\n      const grade = gradeOf(r.score);\n      yield* say(g, 'brisket', [`I've seen your home. ${r.score} points. That's grade ${grade.g}.`, hostLine(g, 'brisket', 'critique')]);\n      g.events.emit('critiqued', { score: r.score, grade: grade.g });\n    } else if (c === 1) {\n      yield* say(g, 'brisket', [\"Points for what things are worth. Bonus for four or more from a set. Harmony in your wood. Cosy rules: a lamp by a seat, a rug under a table, something growing.\", \"Music playing, that's a bonus. Clutter loses you points. We score on Show Day nights, and the result comes by mail. We know where you live. That's the job.\"]);\n    } else if (c === 2) {\n      const bi = GRADES.findIndex((x) => x.g === w.home.bestGrade);\n      if (bi < 0) { yield* say(g, 'brisket', 'No grade on file. Wait for a Show Day night. Tidy something.'); return; }\n      const claimed = w.flags.bureauClaim ?? -1;\n      if (claimed >= bi) { yield* say(g, 'brisket', \"You've had what you're owed. Improve.\"); return; }\n      const reward = GRADES[bi].reward;\n      if (!hasRoom(w)) { yield* say(g, 'brisket', 'Your pockets are a disgrace. Empty them.'); return; }\n      addItem(g, reward);\n      w.flags.bureauClaim = bi;\n      g.sound('reveal');\n      g.events.emit('bureauReward', { reward });\n      yield* say(g, 'brisket', hostLine(g, 'brisket', 'reward'));\n    }\n  },\n  *louCounter(g) {\n    const w = g.world;\n    const a = g.actorOf('lou');\n    const c = yield* ask(g, 'lou', hostLine(g, 'lou', 'greet'), ['House Blend: 200', 'Morning Regret: 350', 'The Slow One: 500', 'Nothing']);\n    if (c < 0 || c === 3) return;\n    const price = [200, 350, 500][c];\n    if (w.player.beans < price) { yield* say(g, 'lou', '…no… beans… | …it\\'s… okay.'); return; }\n    spend(g, price);\n    g.sound('bean');\n    // Lou takes a while, and it's worth it.\n    a.play('Give', 0.3, { speed: 0.3, once: true });\n    yield 1.2;\n    g.player.pose('Eat');\n    g.sound('chew');\n    const untilNoon = w.clock.day * 1440 + 12 * 60;\n    const until = w.clock.minute < 12 * 60 ? untilNoon : w.clock.day * 1440 + w.clock.minute + [60, 120, 180][c];\n    w.player.buffUntil = Math.max(w.player.buffUntil, until);\n    g.events.emit('coffee', { blend: c });\n    yield* say(g, 'lou', hostLine(g, 'lou', 'serve'));\n    yield* say(g, 'lou', hostLine(g, 'lou', 'hint'));\n  },\n  *fortuneTable(g) {\n    const w = g.world;\n    if (w.player.fortuneDay === w.clock.day) { yield* say(g, 'nibbles', 'I already ate your future today. It was very filling. Come back tomorrow.'); return; }\n    const c = yield* ask(g, 'nibbles', hostLine(g, 'nibbles', 'greet'), ['A reading: 300 beans', 'No, thank you']);\n    if (c !== 0) return;\n    if (w.player.beans < 300) { yield* say(g, 'nibbles', \"I see no beans in your future. Or your pocket. That one's free.\"); return; }\n    spend(g, 300);\n    const s = new Stream(`${w.seed}:fortune:${w.clock.day}`);\n    const f = s.pick(HOSTS.nibbles.fortunes);\n    g.sound('chew');\n    yield 0.35;\n    g.sound('chew');\n    yield* say(g, 'nibbles', f.text);\n    w.player.luck = f.luck === 'none' ? null : f.luck;\n    w.player.fortuneDay = w.clock.day;\n    g.events.emit('fortune', { luck: f.luck });\n  },\n};\nexport { ART, addBeans };\nEOF\ncat > src/systems/bus.js <<'EOF'\n// The bus: it arrives in seconds, the ride is a skippable scene, Hester sings your recent life.\nimport { THREE, buildModel, toonMaterial, PALETTE, setLookLayer } from '../engine.js';\nimport { Place } from '../world/place.js';\nimport { MODELS } from '../art/models.js';\nimport { Actor } from '../actors/rig.js';\nimport { CRITTER_DEFS } from '../art/critter.js';\nimport { BALLAD } from '../data/dialogue/hosts.js';\nimport { LANDMARKS } from '../data/town.js';\nimport { CITY_BUS_STOP } from '../world/city.js';\nimport { say } from './say.js';\nimport { hostLine } from './lines.js';\nimport { resolveTags } from './lines.js';\nimport { melodyNotes } from '../audio/composer.js';\nimport { noteFrequency } from '../engine.js';\nimport { drawText, panel, wrap, textWidth } from '../ui/draw.js';\nimport { remember } from './memory.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { Stream } from '../core/rng.js';\nimport { leafFor } from '../world/town.js';\n\nconst { BoxGeometry, Group, Mesh } = THREE;\nconst box = (w, h, d, c, x = 0, y = 0, z = 0) => { const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(PALETTE[c])); m.position.set(x, y, z); m.castShadow = true; m.receiveShadow = true; return m; };\n\n/** A rocking bus, cut away, with the countryside going past. */\nexport class BusPlace extends Place {\n  constructor(g) {\n    super('bus', 'room', { ox: 1500, oz: 0, name: 'The Bus' });\n    this.g = g;\n    this.def = { name: 'The Bus', exit: null, dim: false, w: 14, d: 8 };\n    this.w = 14; this.d = 8;\n    this.camZoom = 2.1;\n    this.music = 'bus';\n    this.scenery = new Group();\n    this.group.add(this.scenery);\n    this.bodyGroup = new Group();\n    this.group.add(this.bodyGroup);\n    const b = this.bodyGroup;\n    b.add(box(9, 0.2, 3, 'navy', 0, 0.6, 0));\n    b.add(box(9, 1.9, 0.14, 'sky', 0, 1.6, -1.45));\n    b.add(box(0.14, 1.9, 3, 'sky', -4.5, 1.6, 0));\n    b.add(box(0.14, 0.7, 3, 'sky', 4.5, 1.0, 0));\n    for (const x of [-3.1, -1.4, 0.4, 2.1]) { const win = box(1.3, 0.8, 0.08, 'cyan', x, 1.95, -1.4); b.add(win); }\n    this.glass = b.children.filter((c) => c.material?.color?.getHex?.() === PALETTE.cyan);\n    for (const x of [-3, -1.2, 0.6]) { b.add(box(1, 0.5, 0.6, 'plum', x, 0.95, -0.95)); b.add(box(1, 0.8, 0.14, 'red', x, 1.3, -1.25)); }\n    b.add(box(0.8, 0.5, 0.6, 'night', 3.2, 0.95, -0.3));\n    b.add(box(0.1, 0.6, 0.6, 'ink', 3.95, 1.3, -0.3));\n    for (const x of [-3, 3]) for (const z of [-1.5, 1.5]) { const w = box(1, 1, 0.3, 'ink', x, 0.5, z); w.userData.wheel = true; b.add(w); }\n    this.hester = new Actor(CRITTER_DEFS.hester, { name: 'hester', seed: 8 });\n    this.hester.x = 3.2; this.hester.z = -0.3; this.hester.y = 0.72; this.hester.facing = Math.PI / 2;\n    this.hester.root.removeFromParent();\n    this.hester.hasShadow = false;\n    b.add(this.hester.root);\n    this.hester.play('Sit', 0);\n    this.trees = [];\n    this.ground = box(80, 0.3, 30, 'green', 0, -0.15, -8);\n    this.group.add(this.ground);\n    this.road = box(80, 0.04, 5, 'slate', 0, 0.02, 0);\n    this.group.add(this.road);\n    this.rockT = 0;\n    this.speed = 7;\n    this.group.visible = false;\n    this.rain = false;\n  }\n  height() { return 0.72; }\n  blocked() { return true; }\n  surfaceAt() { return null; }\n  setScene(season, cal, { night = false } = {}) {\n    this.scenery.clear();\n    this.trees.length = 0;\n    this.ground.material = toonMaterial([PALETTE.lime, PALETTE.green, PALETTE.sand, PALETTE.white][season]);\n    const rng = new Stream(`bus-scene:${season}`);\n    for (let i = 0; i < 26; i++) {\n      const kind = rng.chance(0.6) ? 'pine' : 'pear';\n      const leaf = leafFor(season, cal, kind);\n      const t = buildModel(kind === 'pine' ? 'tree-pine' : 'tree-pear', { catalog: MODELS, palette: { leaf: leaf.leaf, leaf2: leaf.leaf2 } }).object;\n      const fruit = t.getObjectByName('fruit');\n      if (fruit) fruit.visible = false;\n      const x = rng.range(-30, 30), z = rng.range(-16, -3.4);\n      t.position.set(x, 0, z);\n      this.scenery.add(t);\n      this.trees.push(t);\n    }\n    this.night = night;\n  }\n  enter(g) {}\n  leave(g) {}\n  update(dt, t) {\n    this.rockT += dt;\n    this.bodyGroup.rotation.z = Math.sin(this.rockT * 3.1) * 0.012 + Math.sin(this.rockT * 7.3) * 0.004;\n    this.bodyGroup.position.y = Math.abs(Math.sin(this.rockT * 5.3)) * 0.03;\n    for (const tr of this.trees) { tr.position.x -= dt * this.speed * (1 + tr.position.z * -0.03); if (tr.position.x < -32) tr.position.x += 62; }\n    this.hester.update(dt);\n    if (Math.floor(this.rockT * 4) % 2 === 0 && this.rockT % 0.25 < dt) this.g.sound('busEngine', { volume: 0.05 });\n  }\n  interactables() { return []; }\n}\n/** Pick verses from memory events. */\nexport function ballad(g) {\n  const w = g.world;\n  const s = new Stream(`${w.seed}:ballad:${w.clock.day}:${w.stats.busRides ?? 0}`);\n  const mems = w.memory.slice(-16).reverse();\n  const verses = [];\n  const seen = new Set();\n  const take = (key, extra = {}) => { if (!seen.has(key) && BALLAD[key] && verses.length < 2) { seen.add(key); verses.push({ key, lines: BALLAD[key].map((l) => resolveTags(l, g, { neighbour: 'someone', item: 'thing', catch: 'fish', beans: '300', ...extra })) }); } };\n  for (const m of mems) {\n    const n = m.about ? (NEIGHBOURS[m.about]?.short ?? NEIGHBOURS[m.about]?.name) : 'someone';\n    if (m.k === 'boot') take('boot');\n    else if (m.k === 'catch' || m.k === 'bigCatch') take('catch', { catch: m.catch, beans: '300' });\n    else if (m.k === 'gift') take('gift', { neighbour: n, item: m.item });\n    else if (m.k === 'bonk') take('bonk', { neighbour: n });\n    else if (m.k === 'debtTier') take('home');\n    else if (m.k === 'wish') take('wish');\n    else if (m.k === 'fashion') take('fashion');\n    else if (m.k === 'letter') take('letter');\n  }\n  if (w.npcs.rocco.moved !== 'here') take('rocco');\n  const fill = s.shuffle(['debt', 'mayor', 'store', 'city', 'fish', 'weather', 'lonely', 'friend', 'home2', 'rain']);\n  for (const k of fill) take(k, { neighbour: NEIGHBOURS[s.pick(['dorrit', 'tavi', 'nib', 'yolanda'])].name });\n  verses.push({ key: 'chorus', lines: BALLAD.chorus });\n  return verses;\n}\nconst midiOf = (noteName) => { const f = noteFrequency(noteName); return f ? 69 + 12 * Math.log2(f / 440) : null; };\nclass BalladOverlay {\n  constructor(lines) { this.id = 'ballad'; this.modal = true; this.line = ''; this.lines = lines; }\n  update() {}\n  draw(g, hud) {\n    if (!this.line) return;\n    const parts = wrap(this.line, 400);\n    const h = parts.length * 12 + 12;\n    panel(hud, 32, 212 - h + 30, 416, h, { fill: 'white', trim: 'sky' });\n    parts.forEach((p, i) => drawText(hud, 240, 212 - h + 37 + i * 12, p, { align: 'center', color: 'ink' }));\n    drawText(hud, 46, 212 - h + 22, 'Hester', { color: 'navy', shadow: 'white' });\n  }\n  currentText() { return this.line; }\n  prompts() { return [['confirm', 'Skip']]; }\n}\n/** The ride itself. */\nexport function* busRide(g, to) {\n  const w = g.world;\n  const fromTown = g.place === g.town;\n  const stop = fromTown ? LANDMARKS.busStop : CITY_BUS_STOP;\n  g.sound('busHorn');\n  g.ui.toastMsg('You wait. The bus arrives in seconds. It always does. It is always late.');\n  yield 1.6;\n  w.stats.busRides = (w.stats.busRides ?? 0) + 1;\n  g.events.emit('busBoard', { to });\n  const bus = g.busPlace ??= new BusPlace(g);\n  g.ctx.scene.add(bus.group);\n  bus.setScene(g.season, g.calendarDay);\n  yield* g.travel(bus, 0, 0, 0, { kind: 'iris', sound: 'busBrake' });\n  // Sit in a seat in the rocking body\n  const p = g.player;\n  p.remove();\n  bus.bodyGroup.add(p.root);\n  p.x = -1.2; p.z = -0.8; p.y = 0.86; p.facing = Math.PI * 0.5; p.turnTo = null;\n  p.sitting = true;\n  p.play('Sit', 0);\n  g.camFocus = { x: 0, y: 1.2, z: 0 };\n  g.camTeleport();\n  g.hideHud = true;\n  const verses = ballad(g);\n  const overlay = new BalladOverlay(verses);\n  g.ui.push(overlay);\n  bus.hester.play('Talk', 0.2);\n  const notes = melodyNotes('bus').filter((n) => n !== '.' && n !== '-');\n  let ni = 0;\n  let skip = false;\n  const allLines = verses.flatMap((v) => v.lines);\n  g.events.emit('ballad', { verses: verses.map((v) => v.key) });\n  for (const line of allLines) {\n    overlay.line = line;\n    let shown = 0;\n    const clean = line.replace(/♪/g, '').trim();\n    const stepT = 0.13;\n    for (const ch of clean) {\n      if (/[a-z]/i.test(ch) && shown % 2 === 0) {\n        const m = midiOf(notes[ni++ % notes.length]) ?? 60;\n        g.voice.sing(ch, 'hester', m);\n        bus.hester.talkAmp = 1;\n      }\n      shown++;\n      let t = 0;\n      const dt = 0.04;\n      while (t < stepT * 0.42) {\n        t += g.engine.manual ? 1 / 60 : 1 / 60;\n        yield;\n        if (g.inp.confirm || g.inp.back || g.inp.mouse.click) skip = true;\n        if (skip) break;\n      }\n      if (skip) break;\n    }\n    if (skip) break;\n    yield 0.25;\n  }\n  g.ui.pop(overlay);\n  bus.hester.play('Sit', 0.2);\n  g.hideHud = false;\n  p.sitting = false;\n  p.remove();\n  bus.group.add(p.root);\n  if (to === 'city') {\n    yield* g.travel(g.city, CITY_BUS_STOP[0], CITY_BUS_STOP[1], Math.PI / 2, { kind: 'iris', sound: 'busBrake' });\n    remember(g, 'city', {});\n    g.events.emit('arrivedCity', {});\n    if (!w.flags.cityFirst) { w.flags.cityFirst = true; yield* say(g, 'hester', 'Big City. Mind your pockets. Mind your hair. Mind everything. I\\'ll be here. I\\'m always here.'); }\n  } else {\n    yield* g.travel(g.town, LANDMARKS.busStop[0], LANDMARKS.busStop[1], 0, { kind: 'iris', sound: 'busBrake' });\n    g.events.emit('arrivedTown', {});\n  }\n  g.autosave();\n}\nexport { hostLine, stop as _unused, textWidth, setLookLayer };\nvar stop;\nEOF\ncat > src/systems/stargaze.js <<'EOF'\n// The Lookout bench at night: the camera glides up to a star field; press on a shooting star to wish.\nimport { THREE, toonMaterial, PALETTE, glowMaterial, Timeline } from '../engine.js';\nimport { drawText, panel, inRect, dim } from '../ui/draw.js';\nimport { sendMail } from './mail.js';\nimport { remember } from './memory.js';\nimport { say, narrate } from './say.js';\nimport { keyboardFlow } from '../ui/screens/keyboard.js';\nimport { LANDMARKS } from '../data/town.js';\n\nexport const CONSTELLATIONS = [\n  { id: 'book', name: 'The Overdue Library Book', stars: [[60, 50], [100, 44], [104, 74], [64, 80], [60, 50]] },\n  { id: 'spoon', name: 'The Big Spoon', stars: [[160, 40], [176, 52], [190, 64], [204, 78], [226, 76], [230, 96], [208, 100], [204, 78]] },\n  { id: 'gander', name: 'The Ledger', stars: [[280, 40], [320, 40], [320, 80], [280, 80], [280, 40], [320, 60], [280, 60]] },\n  { id: 'trundle', name: 'The Mayor, Eventually', stars: [[380, 60], [396, 44], [412, 52], [408, 68], [392, 72], [380, 60], [352, 74]] },\n  { id: 'bus', name: 'The Late Bus', stars: [[80, 130], [148, 130], [148, 158], [80, 158], [80, 130]] },\n  { id: 'soup', name: \"Tuesday's Bowl\", stars: [[250, 130], [264, 164], [306, 164], [320, 130]] },\n];\nconst STAR_FIELD = (() => { const out = []; let s = 7; for (let i = 0; i < 120; i++) { s = (s * 1664525 + 1013904223) >>> 0; const x = s % 480; s = (s * 1664525 + 1013904223) >>> 0; const y = s % 200; s = (s * 1664525 + 1013904223) >>> 0; out.push([x, y, s % 3]); } return out; })();\nclass StarScreen {\n  constructor(g, onExit) { this.id = 'stargaze'; this.onExit = onExit; this.t = 0; this.next = 2 + ((g.world.clock.minute * 7) % 5); this.shooter = null; this.focus = 0; this.wishes = 0; }\n  labels() { return CONSTELLATIONS.map((c) => c.name); }\n  focusIndex() { return this.focus; }\n  update(g, inp, dt) {\n    this.t += dt;\n    if (inp.nav.left) { this.focus = (this.focus + 5) % 6; g.sound('uiTick'); }\n    if (inp.nav.right) { this.focus = (this.focus + 1) % 6; g.sound('uiTick'); }\n    this.next -= dt;\n    if (this.next <= 0 && !this.shooter) {\n      const s = (g.world.clock.day * 131 + Math.floor(this.t * 37)) % 400;\n      this.shooter = { x: 40 + s, y: 20 + (s % 60), vx: -180, vy: 90, life: 1.2 };\n      this.next = 5 + (s % 7);\n      g.sound('star');\n      g.events.emit('shootingStar', {});\n    }\n    if (this.shooter) {\n      const st = this.shooter;\n      st.x += st.vx * dt; st.y += st.vy * dt; st.life -= dt;\n      if (st.life <= 0) this.shooter = null;\n    }\n    if (inp.confirm || inp.mouse.click) {\n      if (this.shooter) { this.wish(g); return; }\n      this.nameIt(g);\n      return;\n    }\n    if (inp.back || inp.mouse.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onExit?.(); }\n  }\n  wish(g) {\n    this.shooter = null;\n    this.wishes++;\n    g.sound('wish');\n    g.world.stats.wishes += 1;\n    const gifts = ['driftSpoon', 'gem', 'shellConch', 'moonRobe', 'starShades', 'mossyLamp', 'seasideLamp'];\n    const gift = gifts[(g.world.stats.wishes + g.world.seed) % gifts.length];\n    sendMail(g, { from: 'wish', body: 'Dear {player},\\nWe got your wish. We have looked into it. Here is what we could do.\\nA Passing Star', gift: gift === 'gem' ? 'driftBottle' : gift });\n    remember(g, 'wish', {});\n    g.events.emit('wished', { gift });\n    g.ui.toastMsg('You wished. Check the post in the morning.');\n  }\n  nameIt(g) {\n    const c = CONSTELLATIONS[this.focus];\n    const w = g.world;\n    if (!w.almanac.stars[c.id]) { w.almanac.stars[c.id] = true; g.sound('star'); g.ui.toastMsg(`You found ${c.name}. It's in the Almanac now.`); g.events.emit('constellation', { id: c.id }); }\n    else g.sound('uiTick');\n  }\n  prompts() { return this.shooter ? [['confirm', 'WISH!'], ['back', 'Stand up']] : [['confirm', 'Mark it'], ['back', 'Stand up']]; }\n  draw(g, hud) {\n    hud.rect(0, 0, 480, 270, 'night');\n    hud.rect(0, 0, 480, 150, 'ink');\n    for (const [x, y, k] of STAR_FIELD) hud.rect(x, y, 1, 1, k === 0 ? 'white' : k === 1 ? 'mist' : 'sky');\n    CONSTELLATIONS.forEach((c, i) => {\n      const focused = i === this.focus;\n      const known = g.world.almanac.stars[c.id];\n      for (let k = 0; k < c.stars.length; k++) {\n        const [x, y] = c.stars[k];\n        hud.rect(x - 1, y - 1, 3, 3, focused ? 'sand' : 'white');\n        if ((focused || known) && k + 1 < c.stars.length) {\n          const [x2, y2] = c.stars[k + 1];\n          const n = Math.max(Math.abs(x2 - x), Math.abs(y2 - y));\n          for (let j = 0; j < n; j += 3) hud.rect(Math.round(x + ((x2 - x) * j) / n), Math.round(y + ((y2 - y) * j) / n), 1, 1, focused ? 'sand' : 'slate');\n        }\n      }\n    });\n    if (this.shooter) { const st = this.shooter; for (let i = 0; i < 12; i++) hud.rect(Math.round(st.x - st.vx * 0.012 * i), Math.round(st.y - st.vy * 0.012 * i), 2, 2, i < 3 ? 'white' : 'sky'); }\n    hud.rect(0, 212, 480, 58, 'ink');\n    const c = CONSTELLATIONS[this.focus];\n    drawText(hud, 240, 222, g.world.almanac.stars[c.id] ? c.name : 'Which one is that, then?', { align: 'center', color: 'sand', scale: 1 });\n    drawText(hud, 240, 236, 'Press when a shooting star goes past to make a wish.', { align: 'center', color: 'mist' });\n  }\n}\nexport function* stargaze(g) {\n  const p = g.player;\n  p.play('Sit', 0.15);\n  g.engine.screen.cover('fade', { duration: 0.5 });\n  yield 0.5;\n  let closed = false;\n  g.hideHud = true;\n  g.ui.push(new StarScreen(g, () => { closed = true; }));\n  g.engine.screen.reveal('fade', { duration: 0.5 });\n  g.events.emit('stargaze', {});\n  while (!closed) yield;\n  g.hideHud = false;\n  p.play('Idle', 0.15);\n}\nexport { narrate, say, keyboardFlow, panel, inRect, dim, THREE, toonMaterial, PALETTE, glowMaterial, Timeline, LANDMARKS };\nEOF\necho ok","description":"Write City venues, Hester's bus ride and stargazing"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10473,"cache_read_input_tokens":583840,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10473},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"cddf2c49-afc3-4036-88b3-5cdf9ed12992","timestamp":"2026-11-06T01:19:14.822Z","request_id":"req_011Cgkntt8Ceow6GpBPHtYXc","wire_tool_inputs":{"toolu_013afjzrJiAw7iX7k1LPZ6e4":{"command":"python3 - <<'EOF'\np='src/systems/services.js'\ns=open(p).read()\ns=s.replace(\"function quoteLabel(g, hud, text) { g.ui.drawText?.(hud, text); import('../ui/draw.js').then(() => {}); drawQuote(hud, text); }\\nimport { drawText, panel, textWidth } from '../ui/draw.js';\\n\",\"function quoteLabel(g, hud, text) { drawQuote(hud, text); }\\n\")\ns=s.replace(\"import { wear } from './pocketActions.js';\\n\",\"import { wear } from './pocketActions.js';\\nimport { drawText, panel, textWidth } from '../ui/draw.js';\\n\")\nopen(p,'w').write(s)\nEOF\ncat > src/systems/venues.js <<'EOF'\n// The City's venues. Each has its own fun, not a bare menu.\nimport { say, ask, narrate } from './say.js';\nimport { hostLine } from './lines.js';\nimport { HOSTS } from '../data/dialogue/hosts.js';\nimport { ITEMS } from '../data/items.js';\nimport { addItem, hasRoom, removeSlot, spend, sellPrice, addBeans } from './economy.js';\nimport { CLOTHES, HAT_ITEMS, UMBRELLAS } from '../data/clothes.js';\nimport { Stream } from '../core/rng.js';\nimport { lookEditor } from '../ui/screens/lookEditor.js';\nimport { pocketsPicker } from '../ui/screens/pockets.js';\nimport { sendMail } from './mail.js';\nimport { remember } from './memory.js';\nimport { scoreHome, gradeOf, GRADES } from './rating.js';\nimport { ART } from '../data/art.js';\nimport { FURNITURE } from '../data/furniture.js';\nimport { auctionScreen, consignResult } from '../ui/screens/auction.js';\nimport { compareScreen } from '../ui/screens/compare.js';\nimport { theatreScreen } from '../ui/screens/theatre.js';\nimport { menuChoiceFree } from '../ui/screens/numbers.js';\nimport { hourNow } from './time.js';\nimport { ALL_EMOTES } from '../ui/screens/emote.js';\n\nexport const FASHION_THEMES = [\n  { name: 'Something damp', tags: ['damp', 'nautical'] }, { name: 'Formal, but sorry about it', tags: ['formal', 'drab'] }, { name: 'Loud enough to hear from the bus', tags: ['loud', 'dramatic'] }, { name: 'Cosy to the point of concern', tags: ['cosy', 'wool', 'sleepy'] }, { name: 'Money', tags: ['money', 'formal'] }, { name: 'Leafy', tags: ['leafy', 'plain'] }, { name: 'A person who sleeps well', tags: ['sleepy', 'plain'] }, { name: 'Cheese, obviously', tags: ['cheese', 'loud'] }, { name: 'Tragedy', tags: ['dramatic', 'drab'] }, { name: 'Ready for anything but this', tags: ['practical', 'sporty'] },\n];\nexport function fashionScore(look, theme) {\n  const tags = new Set();\n  for (const k of ['outfit', 'hatItem', 'glassesItem', 'umbrella']) { const it = ITEMS[look[k]]; for (const t of it?.tags ?? []) tags.add(t); }\n  let hits = 0;\n  for (const t of theme.tags) if (tags.has(t)) hits++;\n  let score = hits * 2;\n  if (ITEMS[look.outfit]?.couture) score += 1;\n  if (look.hatItem) score += 1;\n  if (tags.has('couture')) score += 1;\n  if (look.outfit === 'tatteredShirt') score -= 1;\n  return { score: Math.max(0, Math.min(5, score)), hits, tags: [...tags] };\n}\nconst hatCommentary = (look) => (ITEMS[look.hatItem] ? `The ${ITEMS[look.hatItem].name}. Well. It's on your head, and I suppose that's somewhere.` : 'No hat. Bold. Bold in the way a cliff is bold.');\nexport const VENUES = {\n  *salonChair(g, t) {\n    const w = g.world;\n    const a = g.actorOf('fleece');\n    a.play('Talk', 0.15);\n    const c = yield* ask(g, 'fleece', hostLine(g, 'fleece', 'greet'), ['A cut, please. 800 beans.', 'Just the gossip', 'Never mind']);\n    if (c === 1) { yield* say(g, 'fleece', hostLine(g, 'fleece', 'gossip')); return; }\n    if (c !== 0) return;\n    if (w.player.beans < 800) { yield* say(g, 'fleece', \"Ah, non. For this money I can only look at it sadly. I am doing it now.\"); return; }\n    const before = JSON.stringify(w.player.look);\n    const seat = t.prop;\n    g.player.x = seat.x; g.player.z = seat.z + 0.55; g.player.facing = 0;\n    g.player.turnTo = null;\n    g.sound('scissors');\n    const changed = yield* lookEditor(g, { title: 'Snip & Gossip', turntable: true, hairOnly: true });\n    if (changed && JSON.stringify(w.player.look) !== before) {\n      spend(g, 800);\n      g.sound('scissors');\n      g.events.emit('haircut', {});\n      yield* say(g, 'fleece', [hostLine(g, 'fleece', 'done'), hostLine(g, 'fleece', 'gossip')]);\n    }\n  },\n  *coutureRail(g) {\n    const w = g.world;\n    if (w.player.plumes < 3) { yield* say(g, 'flavia', \"Darling. That rail is for people with three plumes. You are not one of them, in several senses.\"); return; }\n    yield* say(g, 'flavia', hostLine(g, 'flavia', 'rope'));\n    const stock = [...CLOTHES, ...HAT_ITEMS, ...UMBRELLAS].filter((c) => c.couture && !w.flags[`bought:couture:${c.id}`]);\n    if (!stock.length) { yield* say(g, 'flavia', \"You've bought it all. There's nothing left for you to be wrong in.\"); return; }\n    const labels = stock.slice(0, 5).map((s) => `${s.name}: ${s.price.toLocaleString('en-US')}`);\n    labels.push('Never mind');\n    const c = yield* menuChoiceFree(g, 'The couture rail', labels);\n    if (c < 0 || c >= stock.length || c >= 5) return;\n    const it = stock[c];\n    if (w.player.beans < it.price) { yield* say(g, 'flavia', \"You can't afford to be that person yet.\"); return; }\n    if (!hasRoom(w)) { yield* say(g, 'flavia', 'Your pockets are full. Of what? No. Do not tell me.'); return; }\n    spend(g, it.price);\n    addItem(g, it.id);\n    w.flags[`bought:couture:${it.id}`] = true;\n    g.sound('plume');\n    g.events.emit('bought', { id: it.id, price: it.price });\n  },\n  *hostTalkFlavia(g) { yield* VENUES.fashionCheck(g); },\n  *fashionCheck(g) {\n    const w = g.world;\n    const s = new Stream(`${w.seed}:theme:${w.clock.day}`);\n    const theme = s.pick(FASHION_THEMES);\n    const a = g.actorOf('flavia');\n    if (w.player.fashionDay === w.clock.day) { yield* say(g, 'flavia', \"I've seen you today. I'm still recovering. Come back tomorrow, in something else.\"); return; }\n    a.play('Talk', 0.15);\n    const c = yield* ask(g, 'flavia', [hostLine(g, 'flavia', 'greet')].join('//') + `//Today's theme: \"${theme.name}\". Shall I look at you?`, ['Judge me', 'Not yet']);\n    if (c !== 0) return;\n    const look = w.player.look;\n    yield* say(g, 'flavia', [hostLine(g, 'flavia', 'judge'), ITEMS[look.outfit] ? `The ${ITEMS[look.outfit].name}. ${ITEMS[look.outfit].tags?.includes(theme.tags[0]) ? 'Yes. I see what you were reaching for.' : 'I see what you were running from.'}` : 'Nothing about that makes sense.', hatCommentary(look)]);\n    const r = fashionScore(look, theme);\n    w.player.fashionDay = w.clock.day;\n    for (let i = 0; i < r.score; i++) { g.sound('plume'); yield 0.35; }\n    a.play(r.score >= 3 ? 'Nod' : 'ShakeHead', 0.1, { once: true });\n    yield* say(g, 'flavia', HOSTS.flavia[`result${r.score}`]);\n    const before = w.player.plumes;\n    w.player.plumes = Math.max(before, r.score);\n    w.player.plumesTotal = (w.player.plumesTotal ?? 0) + r.score;\n    remember(g, 'fashion', { item: String(r.score) });\n    g.events.emit('fashionChecked', { score: r.score, theme: theme.name });\n    if (w.player.plumes >= 3 && before < 3) yield* say(g, 'flavia', hostLine(g, 'flavia', 'rope'));\n  },\n  *magdaCounter(g) {\n    const w = g.world;\n    const a = g.actorOf('magda');\n    const c = yield* ask(g, 'magda', hostLine(g, 'magda', 'greet'), ['Rare furniture?', 'Chat', 'Goodbye']);\n    if (c === 0) {\n      const rare = FURNITURE.filter((f) => f.rare && !w.flags[`bought:rare:${f.id}`]);\n      if (!rare.length) { yield* say(g, 'magda', \"Sold out. Wagon's been very careful lately.\"); return; }\n      const it = rare[w.clock.day % rare.length];\n      const price = it.price;\n      const b = yield* ask(g, 'magda', `${hostLine(g, 'magda', 'rare')}//${it.name}. ${price.toLocaleString('en-US')} beans.`, ['Buy it', 'No']);\n      if (b === 0) {\n        if (w.player.beans < price || !hasRoom(w)) { yield* say(g, 'magda', 'Come back when you can carry it, and pay for it. In that order, ideally.'); return; }\n        spend(g, price);\n        addItem(g, it.id);\n        w.flags[`bought:rare:${it.id}`] = true;\n        g.sound('bean');\n        g.events.emit('bought', { id: it.id, price });\n      }\n    } else if (c === 1) yield* say(g, 'magda', hostLine(g, 'magda', 'idle'));\n    if (a === null) yield;\n  },\n  *magdaLook(g, t) {\n    const w = g.world;\n    const s = t.stock;\n    const it = ITEMS[s.id];\n    if (w.flags[`bought:${w.clock.day}:${s.id}`]) { yield* narrate(g, 'An empty easel. It looks relieved.'); return; }\n    const c = yield* ask(g, 'magda', `${it.name}. ${s.price.toLocaleString('en-US')} beans. ${hostLine(g, 'magda', 'sell')}`, ['Buy it', 'Compare with the print', 'Leave it']);\n    if (c === 1) {\n      let closed = false;\n      g.ui.push(compareScreen(g, s, () => { closed = true; }));\n      while (!closed) yield;\n      g.events.emit('compared', { id: s.id, forged: !!it.forged });\n      return;\n    }\n    if (c !== 0) return;\n    if (w.player.beans < s.price) { yield* say(g, 'magda', \"No. Beans first. Then the painting. Then we've never met.\"); return; }\n    if (!hasRoom(w)) { yield* say(g, 'magda', 'Pockets full. It does not fold. Well. It does once.'); return; }\n    spend(g, s.price);\n    addItem(g, s.id);\n    w.flags[`bought:${w.clock.day}:${s.id}`] = true;\n    g.sound('bean');\n    g.place.refreshDynamic();\n    g.events.emit('boughtArt', { id: s.id, forged: !!it.forged });\n    yield* say(g, 'magda', hostLine(g, 'magda', 'sold'));\n  },\n  *catalogueCompare(g) {\n    const stock = g.life.magdaStock();\n    let closed = false;\n    g.ui.push(compareScreen(g, stock[0], () => { closed = true; }));\n    while (!closed) yield;\n  },\n  *theatreSeat(g, t) {\n    const w = g.world;\n    if (w.flags.theatreDay === w.clock.day) { yield* say(g, 'bellows', \"One show a day! My throat is a delicate instrument, and also it's insured!\"); return; }\n    g.player.x = t.prop.x; g.player.z = t.prop.z - 0.1; g.player.facing = Math.PI; g.player.turnTo = null;\n    g.player.play('Sit', 0.12);\n    g.player.locked = true;\n    yield* say(g, 'bellows', [hostLine(g, 'bellows', 'greet'), hostLine(g, 'bellows', 'sketch')]);\n    let result = null;\n    g.ui.push(theatreScreen(g, (r) => { result = r; }));\n    while (result === null) yield;\n    w.flags.theatreDay = w.clock.day;\n    g.player.locked = false;\n    g.player.z = t.prop.z + 0.8;\n    g.player.play('Idle', 0.15);\n    if (result.won) {\n      const left = ALL_EMOTES.filter((e) => !w.player.emotes.includes(e));\n      if (left.length) {\n        const em = left[w.clock.day % left.length];\n        w.player.emotes.push(em);\n        g.sound('reveal');\n        yield* say(g, 'bellows', hostLine(g, 'bellows', 'win'));\n        g.ui.toastMsg(`You learned an emote: ${em}!`);\n        g.events.emit('emoteLearned', { em });\n      } else yield* say(g, 'bellows', \"You know everything I do! Get out! Bravo!\");\n    } else yield* say(g, 'bellows', hostLine(g, 'bellows', 'miss'));\n  },\n  *auctionStart(g) {\n    const w = g.world;\n    const h = hourNow(w);\n    if (w.flags.auctionDay === w.clock.day) { yield* say(g, 'pemberton', \"That's-it-that's-all-three-lots-gone-see-you-tomorrow-go-home-I-have-to-lie-down!\"); return; }\n    yield* say(g, 'pemberton', hostLine(g, 'pemberton', 'greet'));\n    let done = false;\n    g.ui.push(auctionScreen(g, () => { done = true; }));\n    while (!done) yield;\n    w.flags.auctionDay = w.clock.day;\n    if (h < 0) yield;\n  },\n  *consign(g) {\n    const w = g.world;\n    if (w.flags.consignedDay === w.clock.day) { yield* say(g, 'pemberton', 'One-box-a-day-one-box-a-day-it-is-a-very-small-box!'); return; }\n    let picked = -2;\n    g.ui.push(pocketsPicker(g, { title: 'Consign what?', filter: (s) => { const it = ITEMS[s.id]; return !!it && it.cat !== 'quest' && it.cat !== 'tool' && it.cat !== 'bag'; }, onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n    while (picked === -2) yield;\n    if (picked < 0) return;\n    const slot = removeSlot(g, picked);\n    const it = ITEMS[slot.id];\n    const r = consignResult(w, slot.id, sellPrice(g, slot));\n    sendMail(g, { from: 'auction', body: `Dear-Sir-Madam-Or-Other,\\nYour ${it.name} sold for ${r.price.toLocaleString('en-US')} beans to ${r.buyer}! Congratulations! We've kept a little! Enclosed is the rest!\\nPemberton`, gift: { beans: r.price }, arriveDay: w.clock.day + 1 });\n    w.flags.consignedDay = w.clock.day;\n    g.sound('stamp');\n    g.events.emit('consigned', { id: slot.id, price: r.price });\n    yield* say(g, 'pemberton', 'In-the-box-in-the-box-result-by-post-mind-the-step!');\n  },\n  *brisketDesk(g) {\n    const w = g.world;\n    yield* say(g, 'brisket', hostLine(g, 'brisket', 'greet'));\n    const c = yield* ask(g, 'brisket', 'State your business.', ['Critique my home', 'How is it scored?', 'Any rewards for me?', 'Goodbye']);\n    if (c === 0) {\n      const r = scoreHome(w);\n      const grade = gradeOf(r.score);\n      yield* say(g, 'brisket', [`I've seen your home. ${r.score} points. That's grade ${grade.g}.`, hostLine(g, 'brisket', 'critique')]);\n      g.events.emit('critiqued', { score: r.score, grade: grade.g });\n    } else if (c === 1) {\n      yield* say(g, 'brisket', [\"Points for what things are worth. Bonus for four or more from a set. Harmony in your wood. Cosy rules: a lamp by a seat, a rug under a table, something growing.\", \"Music playing, that's a bonus. Clutter loses you points. We score on Show Day nights, and the result comes by mail. We know where you live. That's the job.\"]);\n    } else if (c === 2) {\n      const bi = GRADES.findIndex((x) => x.g === w.home.bestGrade);\n      if (bi < 0) { yield* say(g, 'brisket', 'No grade on file. Wait for a Show Day night. Tidy something.'); return; }\n      const claimed = w.flags.bureauClaim ?? -1;\n      if (claimed >= bi) { yield* say(g, 'brisket', \"You've had what you're owed. Improve.\"); return; }\n      const reward = GRADES[bi].reward;\n      if (!hasRoom(w)) { yield* say(g, 'brisket', 'Your pockets are a disgrace. Empty them.'); return; }\n      addItem(g, reward);\n      w.flags.bureauClaim = bi;\n      g.sound('reveal');\n      g.events.emit('bureauReward', { reward });\n      yield* say(g, 'brisket', hostLine(g, 'brisket', 'reward'));\n    }\n  },\n  *louCounter(g) {\n    const w = g.world;\n    const a = g.actorOf('lou');\n    const c = yield* ask(g, 'lou', hostLine(g, 'lou', 'greet'), ['House Blend: 200', 'Morning Regret: 350', 'The Slow One: 500', 'Nothing']);\n    if (c < 0 || c === 3) return;\n    const price = [200, 350, 500][c];\n    if (w.player.beans < price) { yield* say(g, 'lou', '…no… beans… | …it\\'s… okay.'); return; }\n    spend(g, price);\n    g.sound('bean');\n    // Lou takes a while, and it's worth it.\n    a.play('Give', 0.3, { speed: 0.3, once: true });\n    yield 1.2;\n    g.player.pose('Eat');\n    g.sound('chew');\n    const untilNoon = w.clock.day * 1440 + 12 * 60;\n    const until = w.clock.minute < 12 * 60 ? untilNoon : w.clock.day * 1440 + w.clock.minute + [60, 120, 180][c];\n    w.player.buffUntil = Math.max(w.player.buffUntil, until);\n    g.events.emit('coffee', { blend: c });\n    yield* say(g, 'lou', hostLine(g, 'lou', 'serve'));\n    yield* say(g, 'lou', hostLine(g, 'lou', 'hint'));\n  },\n  *fortuneTable(g) {\n    const w = g.world;\n    if (w.player.fortuneDay === w.clock.day) { yield* say(g, 'nibbles', 'I already ate your future today. It was very filling. Come back tomorrow.'); return; }\n    const c = yield* ask(g, 'nibbles', hostLine(g, 'nibbles', 'greet'), ['A reading: 300 beans', 'No, thank you']);\n    if (c !== 0) return;\n    if (w.player.beans < 300) { yield* say(g, 'nibbles', \"I see no beans in your future. Or your pocket. That one's free.\"); return; }\n    spend(g, 300);\n    const s = new Stream(`${w.seed}:fortune:${w.clock.day}`);\n    const f = s.pick(HOSTS.nibbles.fortunes);\n    g.sound('chew');\n    yield 0.35;\n    g.sound('chew');\n    yield* say(g, 'nibbles', f.text);\n    w.player.luck = f.luck === 'none' ? null : f.luck;\n    w.player.fortuneDay = w.clock.day;\n    g.events.emit('fortune', { luck: f.luck });\n  },\n};\nexport { ART, addBeans };\nEOF\ncat > src/systems/bus.js <<'EOF'\n// The bus: it arrives in seconds, the ride is a skippable scene, Hester sings your recent life.\nimport { THREE, buildModel, toonMaterial, PALETTE, setLookLayer } from '../engine.js';\nimport { Place } from '../world/place.js';\nimport { MODELS } from '../art/models.js';\nimport { Actor } from '../actors/rig.js';\nimport { CRITTER_DEFS } from '../art/critter.js';\nimport { BALLAD } from '../data/dialogue/hosts.js';\nimport { LANDMARKS } from '../data/town.js';\nimport { CITY_BUS_STOP } from '../world/city.js';\nimport { say } from './say.js';\nimport { hostLine } from './lines.js';\nimport { resolveTags } from './lines.js';\nimport { melodyNotes } from '../audio/composer.js';\nimport { noteFrequency } from '../engine.js';\nimport { drawText, panel, wrap, textWidth } from '../ui/draw.js';\nimport { remember } from './memory.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { Stream } from '../core/rng.js';\nimport { leafFor } from '../world/town.js';\n\nconst { BoxGeometry, Group, Mesh } = THREE;\nconst box = (w, h, d, c, x = 0, y = 0, z = 0) => { const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(PALETTE[c])); m.position.set(x, y, z); m.castShadow = true; m.receiveShadow = true; return m; };\n\n/** A rocking bus, cut away, with the countryside going past. */\nexport class BusPlace extends Place {\n  constructor(g) {\n    super('bus', 'room', { ox: 1500, oz: 0, name: 'The Bus' });\n    this.g = g;\n    this.def = { name: 'The Bus', exit: null, dim: false, w: 14, d: 8 };\n    this.w = 14; this.d = 8;\n    this.camZoom = 2.1;\n    this.music = 'bus';\n    this.scenery = new Group();\n    this.group.add(this.scenery);\n    this.bodyGroup = new Group();\n    this.group.add(this.bodyGroup);\n    const b = this.bodyGroup;\n    b.add(box(9, 0.2, 3, 'navy', 0, 0.6, 0));\n    b.add(box(9, 1.9, 0.14, 'sky', 0, 1.6, -1.45));\n    b.add(box(0.14, 1.9, 3, 'sky', -4.5, 1.6, 0));\n    b.add(box(0.14, 0.7, 3, 'sky', 4.5, 1.0, 0));\n    for (const x of [-3.1, -1.4, 0.4, 2.1]) { const win = box(1.3, 0.8, 0.08, 'cyan', x, 1.95, -1.4); b.add(win); }\n    this.glass = b.children.filter((c) => c.material?.color?.getHex?.() === PALETTE.cyan);\n    for (const x of [-3, -1.2, 0.6]) { b.add(box(1, 0.5, 0.6, 'plum', x, 0.95, -0.95)); b.add(box(1, 0.8, 0.14, 'red', x, 1.3, -1.25)); }\n    b.add(box(0.8, 0.5, 0.6, 'night', 3.2, 0.95, -0.3));\n    b.add(box(0.1, 0.6, 0.6, 'ink', 3.95, 1.3, -0.3));\n    for (const x of [-3, 3]) for (const z of [-1.5, 1.5]) { const w = box(1, 1, 0.3, 'ink', x, 0.5, z); w.userData.wheel = true; b.add(w); }\n    this.hester = new Actor(CRITTER_DEFS.hester, { name: 'hester', seed: 8 });\n    this.hester.x = 3.2; this.hester.z = -0.3; this.hester.y = 0.72; this.hester.facing = Math.PI / 2;\n    this.hester.root.removeFromParent();\n    this.hester.hasShadow = false;\n    b.add(this.hester.root);\n    this.hester.play('Sit', 0);\n    this.trees = [];\n    this.ground = box(80, 0.3, 30, 'green', 0, -0.15, -8);\n    this.group.add(this.ground);\n    this.road = box(80, 0.04, 5, 'slate', 0, 0.02, 0);\n    this.group.add(this.road);\n    this.rockT = 0;\n    this.speed = 7;\n    this.group.visible = false;\n    this.rain = false;\n  }\n  height() { return 0.72; }\n  blocked() { return true; }\n  surfaceAt() { return null; }\n  setScene(season, cal, { night = false } = {}) {\n    this.scenery.clear();\n    this.trees.length = 0;\n    this.ground.material = toonMaterial([PALETTE.lime, PALETTE.green, PALETTE.sand, PALETTE.white][season]);\n    const rng = new Stream(`bus-scene:${season}`);\n    for (let i = 0; i < 26; i++) {\n      const kind = rng.chance(0.6) ? 'pine' : 'pear';\n      const leaf = leafFor(season, cal, kind);\n      const t = buildModel(kind === 'pine' ? 'tree-pine' : 'tree-pear', { catalog: MODELS, palette: { leaf: leaf.leaf, leaf2: leaf.leaf2 } }).object;\n      const fruit = t.getObjectByName('fruit');\n      if (fruit) fruit.visible = false;\n      const x = rng.range(-30, 30), z = rng.range(-16, -3.4);\n      t.position.set(x, 0, z);\n      this.scenery.add(t);\n      this.trees.push(t);\n    }\n    this.night = night;\n  }\n  enter(g) {}\n  leave(g) {}\n  update(dt, t) {\n    this.rockT += dt;\n    this.bodyGroup.rotation.z = Math.sin(this.rockT * 3.1) * 0.012 + Math.sin(this.rockT * 7.3) * 0.004;\n    this.bodyGroup.position.y = Math.abs(Math.sin(this.rockT * 5.3)) * 0.03;\n    for (const tr of this.trees) { tr.position.x -= dt * this.speed * (1 + tr.position.z * -0.03); if (tr.position.x < -32) tr.position.x += 62; }\n    this.hester.update(dt);\n    if (Math.floor(this.rockT * 4) % 2 === 0 && this.rockT % 0.25 < dt) this.g.sound('busEngine', { volume: 0.05 });\n  }\n  interactables() { return []; }\n}\n/** Pick verses from memory events. */\nexport function ballad(g) {\n  const w = g.world;\n  const s = new Stream(`${w.seed}:ballad:${w.clock.day}:${w.stats.busRides ?? 0}`);\n  const mems = w.memory.slice(-16).reverse();\n  const verses = [];\n  const seen = new Set();\n  const take = (key, extra = {}) => { if (!seen.has(key) && BALLAD[key] && verses.length < 2) { seen.add(key); verses.push({ key, lines: BALLAD[key].map((l) => resolveTags(l, g, { neighbour: 'someone', item: 'thing', catch: 'fish', beans: '300', ...extra })) }); } };\n  for (const m of mems) {\n    const n = m.about ? (NEIGHBOURS[m.about]?.short ?? NEIGHBOURS[m.about]?.name) : 'someone';\n    if (m.k === 'boot') take('boot');\n    else if (m.k === 'catch' || m.k === 'bigCatch') take('catch', { catch: m.catch, beans: '300' });\n    else if (m.k === 'gift') take('gift', { neighbour: n, item: m.item });\n    else if (m.k === 'bonk') take('bonk', { neighbour: n });\n    else if (m.k === 'debtTier') take('home');\n    else if (m.k === 'wish') take('wish');\n    else if (m.k === 'fashion') take('fashion');\n    else if (m.k === 'letter') take('letter');\n  }\n  if (w.npcs.rocco.moved !== 'here') take('rocco');\n  const fill = s.shuffle(['debt', 'mayor', 'store', 'city', 'fish', 'weather', 'lonely', 'friend', 'home2', 'rain']);\n  for (const k of fill) take(k, { neighbour: NEIGHBOURS[s.pick(['dorrit', 'tavi', 'nib', 'yolanda'])].name });\n  verses.push({ key: 'chorus', lines: BALLAD.chorus });\n  return verses;\n}\nconst midiOf = (noteName) => { const f = noteFrequency(noteName); return f ? 69 + 12 * Math.log2(f / 440) : null; };\nclass BalladOverlay {\n  constructor(lines) { this.id = 'ballad'; this.modal = true; this.line = ''; this.lines = lines; }\n  update() {}\n  draw(g, hud) {\n    if (!this.line) return;\n    const parts = wrap(this.line, 400);\n    const h = parts.length * 12 + 12;\n    panel(hud, 32, 212 - h + 30, 416, h, { fill: 'white', trim: 'sky' });\n    parts.forEach((p, i) => drawText(hud, 240, 212 - h + 37 + i * 12, p, { align: 'center', color: 'ink' }));\n    drawText(hud, 46, 212 - h + 22, 'Hester', { color: 'navy', shadow: 'white' });\n  }\n  currentText() { return this.line; }\n  prompts() { return [['confirm', 'Skip']]; }\n}\n/** The ride itself. */\nexport function* busRide(g, to) {\n  const w = g.world;\n  const fromTown = g.place === g.town;\n  const stop = fromTown ? LANDMARKS.busStop : CITY_BUS_STOP;\n  g.sound('busHorn');\n  g.ui.toastMsg('You wait. The bus arrives in seconds. It always does. It is always late.');\n  yield 1.6;\n  w.stats.busRides = (w.stats.busRides ?? 0) + 1;\n  g.events.emit('busBoard', { to });\n  const bus = g.busPlace ??= new BusPlace(g);\n  g.ctx.scene.add(bus.group);\n  bus.setScene(g.season, g.calendarDay);\n  yield* g.travel(bus, 0, 0, 0, { kind: 'iris', sound: 'busBrake' });\n  // Sit in a seat in the rocking body\n  const p = g.player;\n  p.remove();\n  bus.bodyGroup.add(p.root);\n  p.x = -1.2; p.z = -0.8; p.y = 0.86; p.facing = Math.PI * 0.5; p.turnTo = null;\n  p.sitting = true;\n  p.play('Sit', 0);\n  g.camFocus = { x: 0, y: 1.2, z: 0 };\n  g.camTeleport();\n  g.hideHud = true;\n  const verses = ballad(g);\n  const overlay = new BalladOverlay(verses);\n  g.ui.push(overlay);\n  bus.hester.play('Talk', 0.2);\n  const notes = melodyNotes('bus').filter((n) => n !== '.' && n !== '-');\n  let ni = 0;\n  let skip = false;\n  const allLines = verses.flatMap((v) => v.lines);\n  g.events.emit('ballad', { verses: verses.map((v) => v.key) });\n  for (const line of allLines) {\n    overlay.line = line;\n    let shown = 0;\n    const clean = line.replace(/♪/g, '').trim();\n    const stepT = 0.13;\n    for (const ch of clean) {\n      if (/[a-z]/i.test(ch) && shown % 2 === 0) {\n        const m = midiOf(notes[ni++ % notes.length]) ?? 60;\n        g.voice.sing(ch, 'hester', m);\n        bus.hester.talkAmp = 1;\n      }\n      shown++;\n      let t = 0;\n      const dt = 0.04;\n      while (t < stepT * 0.42) {\n        t += g.engine.manual ? 1 / 60 : 1 / 60;\n        yield;\n        if (g.inp.confirm || g.inp.back || g.inp.mouse.click) skip = true;\n        if (skip) break;\n      }\n      if (skip) break;\n    }\n    if (skip) break;\n    yield 0.25;\n  }\n  g.ui.pop(overlay);\n  bus.hester.play('Sit', 0.2);\n  g.hideHud = false;\n  p.sitting = false;\n  p.remove();\n  bus.group.add(p.root);\n  if (to === 'city') {\n    yield* g.travel(g.city, CITY_BUS_STOP[0], CITY_BUS_STOP[1], Math.PI / 2, { kind: 'iris', sound: 'busBrake' });\n    remember(g, 'city', {});\n    g.events.emit('arrivedCity', {});\n    if (!w.flags.cityFirst) { w.flags.cityFirst = true; yield* say(g, 'hester', 'Big City. Mind your pockets. Mind your hair. Mind everything. I\\'ll be here. I\\'m always here.'); }\n  } else {\n    yield* g.travel(g.town, LANDMARKS.busStop[0], LANDMARKS.busStop[1], 0, { kind: 'iris', sound: 'busBrake' });\n    g.events.emit('arrivedTown', {});\n  }\n  g.autosave();\n}\nexport { hostLine, stop as _unused, textWidth, setLookLayer };\nvar stop;\nEOF\ncat > src/systems/stargaze.js <<'EOF'\n// The Lookout bench at night: the camera glides up to a star field; press on a shooting star to wish.\nimport { THREE, toonMaterial, PALETTE, glowMaterial, Timeline } from '../engine.js';\nimport { drawText, panel, inRect, dim } from '../ui/draw.js';\nimport { sendMail } from './mail.js';\nimport { remember } from './memory.js';\nimport { say, narrate } from './say.js';\nimport { keyboardFlow } from '../ui/screens/keyboard.js';\nimport { LANDMARKS } from '../data/town.js';\n\nexport const CONSTELLATIONS = [\n  { id: 'book', name: 'The Overdue Library Book', stars: [[60, 50], [100, 44], [104, 74], [64, 80], [60, 50]] },\n  { id: 'spoon', name: 'The Big Spoon', stars: [[160, 40], [176, 52], [190, 64], [204, 78], [226, 76], [230, 96], [208, 100], [204, 78]] },\n  { id: 'gander', name: 'The Ledger', stars: [[280, 40], [320, 40], [320, 80], [280, 80], [280, 40], [320, 60], [280, 60]] },\n  { id: 'trundle', name: 'The Mayor, Eventually', stars: [[380, 60], [396, 44], [412, 52], [408, 68], [392, 72], [380, 60], [352, 74]] },\n  { id: 'bus', name: 'The Late Bus', stars: [[80, 130], [148, 130], [148, 158], [80, 158], [80, 130]] },\n  { id: 'soup', name: \"Tuesday's Bowl\", stars: [[250, 130], [264, 164], [306, 164], [320, 130]] },\n];\nconst STAR_FIELD = (() => { const out = []; let s = 7; for (let i = 0; i < 120; i++) { s = (s * 1664525 + 1013904223) >>> 0; const x = s % 480; s = (s * 1664525 + 1013904223) >>> 0; const y = s % 200; s = (s * 1664525 + 1013904223) >>> 0; out.push([x, y, s % 3]); } return out; })();\nclass StarScreen {\n  constructor(g, onExit) { this.id = 'stargaze'; this.onExit = onExit; this.t = 0; this.next = 2 + ((g.world.clock.minute * 7) % 5); this.shooter = null; this.focus = 0; this.wishes = 0; }\n  labels() { return CONSTELLATIONS.map((c) => c.name); }\n  focusIndex() { return this.focus; }\n  update(g, inp, dt) {\n    this.t += dt;\n    if (inp.nav.left) { this.focus = (this.focus + 5) % 6; g.sound('uiTick'); }\n    if (inp.nav.right) { this.focus = (this.focus + 1) % 6; g.sound('uiTick'); }\n    this.next -= dt;\n    if (this.next <= 0 && !this.shooter) {\n      const s = (g.world.clock.day * 131 + Math.floor(this.t * 37)) % 400;\n      this.shooter = { x: 40 + s, y: 20 + (s % 60), vx: -180, vy: 90, life: 1.2 };\n      this.next = 5 + (s % 7);\n      g.sound('star');\n      g.events.emit('shootingStar', {});\n    }\n    if (this.shooter) {\n      const st = this.shooter;\n      st.x += st.vx * dt; st.y += st.vy * dt; st.life -= dt;\n      if (st.life <= 0) this.shooter = null;\n    }\n    if (inp.confirm || inp.mouse.click) {\n      if (this.shooter) { this.wish(g); return; }\n      this.nameIt(g);\n      return;\n    }\n    if (inp.back || inp.mouse.rclick) { g.sound('uiCancel'); g.ui.pop(this); this.onExit?.(); }\n  }\n  wish(g) {\n    this.shooter = null;\n    this.wishes++;\n    g.sound('wish');\n    g.world.stats.wishes += 1;\n    const gifts = ['driftSpoon', 'gem', 'shellConch', 'moonRobe', 'starShades', 'mossyLamp', 'seasideLamp'];\n    const gift = gifts[(g.world.stats.wishes + g.world.seed) % gifts.length];\n    sendMail(g, { from: 'wish', body: 'Dear {player},\\nWe got your wish. We have looked into it. Here is what we could do.\\nA Passing Star', gift: gift === 'gem' ? 'driftBottle' : gift });\n    remember(g, 'wish', {});\n    g.events.emit('wished', { gift });\n    g.ui.toastMsg('You wished. Check the post in the morning.');\n  }\n  nameIt(g) {\n    const c = CONSTELLATIONS[this.focus];\n    const w = g.world;\n    if (!w.almanac.stars[c.id]) { w.almanac.stars[c.id] = true; g.sound('star'); g.ui.toastMsg(`You found ${c.name}. It's in the Almanac now.`); g.events.emit('constellation', { id: c.id }); }\n    else g.sound('uiTick');\n  }\n  prompts() { return this.shooter ? [['confirm', 'WISH!'], ['back', 'Stand up']] : [['confirm', 'Mark it'], ['back', 'Stand up']]; }\n  draw(g, hud) {\n    hud.rect(0, 0, 480, 270, 'night');\n    hud.rect(0, 0, 480, 150, 'ink');\n    for (const [x, y, k] of STAR_FIELD) hud.rect(x, y, 1, 1, k === 0 ? 'white' : k === 1 ? 'mist' : 'sky');\n    CONSTELLATIONS.forEach((c, i) => {\n      const focused = i === this.focus;\n      const known = g.world.almanac.stars[c.id];\n      for (let k = 0; k < c.stars.length; k++) {\n        const [x, y] = c.stars[k];\n        hud.rect(x - 1, y - 1, 3, 3, focused ? 'sand' : 'white');\n        if ((focused || known) && k + 1 < c.stars.length) {\n          const [x2, y2] = c.stars[k + 1];\n          const n = Math.max(Math.abs(x2 - x), Math.abs(y2 - y));\n          for (let j = 0; j < n; j += 3) hud.rect(Math.round(x + ((x2 - x) * j) / n), Math.round(y + ((y2 - y) * j) / n), 1, 1, focused ? 'sand' : 'slate');\n        }\n      }\n    });\n    if (this.shooter) { const st = this.shooter; for (let i = 0; i < 12; i++) hud.rect(Math.round(st.x - st.vx * 0.012 * i), Math.round(st.y - st.vy * 0.012 * i), 2, 2, i < 3 ? 'white' : 'sky'); }\n    hud.rect(0, 212, 480, 58, 'ink');\n    const c = CONSTELLATIONS[this.focus];\n    drawText(hud, 240, 222, g.world.almanac.stars[c.id] ? c.name : 'Which one is that, then?', { align: 'center', color: 'sand', scale: 1 });\n    drawText(hud, 240, 236, 'Press when a shooting star goes past to make a wish.', { align: 'center', color: 'mist' });\n  }\n}\nexport function* stargaze(g) {\n  const p = g.player;\n  p.play('Sit', 0.15);\n  g.engine.screen.cover('fade', { duration: 0.5 });\n  yield 0.5;\n  let closed = false;\n  g.hideHud = true;\n  g.ui.push(new StarScreen(g, () => { closed = true; }));\n  g.engine.screen.reveal('fade', { duration: 0.5 });\n  g.events.emit('stargaze', {});\n  while (!closed) yield;\n  g.hideHud = false;\n  p.play('Idle', 0.15);\n}\nexport { narrate, say, keyboardFlow, panel, inRect, dim, THREE, toonMaterial, PALETTE, glowMaterial, Timeline, LANDMARKS };\nEOF\necho ok","description":"Write City venues, Hester's bus ride and stargazing"}}}
