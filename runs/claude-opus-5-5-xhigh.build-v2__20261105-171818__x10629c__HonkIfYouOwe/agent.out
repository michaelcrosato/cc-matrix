{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmYe2iB1ipxrKiH87rD","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11307,"cache_read_input_tokens":445255,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11307},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"20a301c7-b5b7-45d1-ae2e-b5b1e9f7772e","timestamp":"2026-11-06T00:59:37.401Z","request_id":"req_011CgkmYdnL8uyHZkgHUonhe","thinking_duration_ms":1231,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmYe2iB1ipxrKiH87rD","type":"message","role":"assistant","content":[{"type":"text","text":"Neighbour data, line selection and the economy are done. Next is the NPC brains and talk flow, then interiors and the City, so the game can finally boot."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11307,"cache_read_input_tokens":445255,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11307},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"80a82484-3691-4a92-b3bd-3446dd9704e5","timestamp":"2026-11-06T00:59:37.402Z","request_id":"req_011CgkmYdnL8uyHZkgHUonhe"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmYe2iB1ipxrKiH87rD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LXS18BkELEqLGETnXCuH8B","name":"Bash","input":{"command":"cat > src/actors/npc.js <<'EOF'\n// Neighbours keep living whether you are there or not: routines, paths, chats, bubbles.\nimport { Actor } from './rig.js';\nimport { CRITTER_DEFS } from '../art/critter.js';\nimport { NEIGHBOURS, NEIGHBOUR_ORDER, POIS } from '../data/neighbours.js';\nimport { BUILDINGS, LANDMARKS } from '../data/town.js';\nimport { tuning } from '../dev/tuning.js';\nimport { Stream } from '../core/rng.js';\nimport { hourNow } from '../systems/time.js';\nimport { CHATS } from '../data/dialogue/unique.js';\nimport { weatherNow } from '../systems/time.js';\n\nconst doorOf = (id) => { const b = BUILDINGS.find((x) => x.id === NEIGHBOURS[id].building); return b.door; };\n\nclass Npc {\n  constructor(g, id) {\n    this.g = g;\n    this.id = id;\n    this.data = NEIGHBOURS[id];\n    this.actor = new Actor(CRITTER_DEFS[id], { name: id, seed: id.length + id.charCodeAt(0) });\n    this.state = 'idle';\n    this.timer = 1;\n    this.path = null;\n    this.inside = false;\n    this.talking = false;\n    this.bubble = null;\n    this.bubbleT = 0;\n    this.chatPartner = null;\n    this.poi = null;\n    this.poiIdx = 0;\n    this.umbrella = null;\n    this.tailT = 0;\n  }\n  get saved() { return this.g.world.npcs[this.id]; }\n  get here() { return this.saved.moved === 'here' || this.saved.moved === 'leaving'; }\n  setPos(x, z) {\n    const p = this.g.town;\n    this.actor.x = x; this.actor.z = z; this.actor.y = p.height(x, z);\n  }\n  shouldBeOut() {\n    const w = this.g.world;\n    if (!this.here) return false;\n    if (this.g.festivals?.holdsNpc?.(this.id)) return true;\n    const h = hourNow(w) < 5 ? hourNow(w) + 24 : hourNow(w);\n    if (h < this.data.wake || h >= this.data.sleep) return false;\n    const k = weatherNow(this.g);\n    const wet = k === 'rain' || k === 'storm';\n    const s = new Stream(`${w.seed}:rainy:${w.clock.day}:${this.id}`);\n    if (wet && s.chance(0.4)) return false;\n    if (this.g.cal.festival === 'longNight' && h >= 22) return true;\n    return true;\n  }\n  walkTo(x, z) {\n    const nav = this.g.town.nav;\n    const p = nav.path([this.actor.x, 0, this.actor.z], [x, 0, z]);\n    if (p && p.length > 1) { this.path = p.slice(1); this.state = 'walk'; return true; }\n    this.path = null;\n    return false;\n  }\n  pickPoi() {\n    const w = this.g.world;\n    const s = new Stream(`${w.seed}:poi:${w.clock.day}:${this.id}`);\n    const list = s.shuffle(POIS);\n    this.poiIdx = (this.poiIdx + 1) % list.length;\n    return list[this.poiIdx];\n  }\n  fixedStep(dt) {\n    if (this.talking || this.held) return;\n    const g = this.g;\n    if (!this.here) { this.inside = true; return; }\n    const out = this.shouldBeOut();\n    if (!out && !this.inside && this.state !== 'goingHome') {\n      const [dx, dz] = doorOf(this.id);\n      if (this.walkTo(dx, dz)) this.state = 'goingHome'; else { this.inside = true; this.state = 'idle'; }\n    }\n    if (out && this.inside) {\n      const [dx, dz] = doorOf(this.id);\n      this.inside = false;\n      this.setPos(dx, dz + 0.4);\n      this.state = 'idle';\n      this.timer = 2;\n      this.g.npcs.syncVisibility(this);\n    }\n    if (this.inside) return;\n    switch (this.state) {\n      case 'walk': case 'goingHome': {\n        const a = this.actor;\n        const n = this.path?.[0];\n        if (!n) { this.arrive(); break; }\n        const ddx = n[0] - a.x, ddz = n[2] - a.z;\n        const d = Math.hypot(ddx, ddz);\n        const sp = tuning.npcSpeed * (this.id === 'rocco' ? 1.7 : this.id === 'nib' ? 0.8 : 1);\n        if (d < 0.1) { this.path.shift(); if (!this.path.length) this.arrive(); break; }\n        a.x += (ddx / d) * sp * dt; a.z += (ddz / d) * sp * dt;\n        a.y = g.town.height(a.x, a.z);\n        a.turnTo = Math.atan2(ddx, ddz);\n        break;\n      }\n      case 'idle': case 'sit': case 'stare': case 'fish': case 'chat': {\n        this.timer -= dt;\n        if (this.timer <= 0) {\n          if (this.state === 'chat') { this.chatPartner = null; }\n          const next = this.pickPoi();\n          this.poi = next;\n          if (!this.walkTo(next.x, next.z)) { this.state = 'idle'; this.timer = 4; }\n        }\n        break;\n      }\n      default: break;\n    }\n  }\n  arrive() {\n    this.path = null;\n    if (this.state === 'goingHome') { this.inside = true; this.state = 'idle'; this.g.npcs.syncVisibility(this); return; }\n    const kind = this.poi?.kind ?? 'stand';\n    this.state = kind === 'sit' ? 'sit' : kind === 'fish' ? 'fish' : kind === 'stare' ? 'stare' : 'idle';\n    this.timer = 18 + ((this.actor.x * 37 + this.actor.z * 13) % 24);\n    if (this.poi?.face !== undefined) this.actor.turnTo = this.poi.face;\n  }\n  presentation(dt, near) {\n    const a = this.actor;\n    if (this.inside && !this.g.npcs.roomGuest(this)) return;\n    if (!near) { a.time += dt; a.root.position.set(a.x, a.y, a.z); if (a.shadow) a.shadow.place(a.x, a.y, a.z, 0); return; }\n    if (!this.talking && !a.finished === false) { /* finished a once clip */ }\n    let clip = 'Idle';\n    if (this.state === 'walk' || this.state === 'goingHome') clip = this.id === 'rocco' ? 'RoccoRoll' : 'Walk';\n    else if (this.state === 'sit') clip = 'Sit';\n    else if (this.state === 'fish') clip = 'Reel';\n    else if (this.state === 'stare') clip = 'Hum';\n    else if (this.state === 'chat') clip = 'Talk';\n    else if (this.talking) clip = 'Listen';\n    if (this.g.festivals?.pose?.(this.id)) clip = this.g.festivals.pose(this.id);\n    if (this.overrideClip) clip = this.overrideClip;\n    if (!this.emoting || a.finished) {\n      this.emoting = false;\n      if (a.playing !== clip) a.play(clip, 0.2);\n    }\n    a.update(dt);\n    if (this.bubbleT > 0) this.bubbleT -= dt;\n  }\n}\n\nexport class NpcManager {\n  constructor(g) { this.g = g; this.list = []; this.map = new Map(); this.chatT = 6; this.chatSeq = 0; this.roomOwner = null; }\n  buildAll() {\n    const g = this.g;\n    for (const id of NEIGHBOUR_ORDER) {\n      const n = new Npc(g, id);\n      n.actor.addTo(g.town.group);\n      this.list.push(n);\n      this.map.set(id, n);\n    }\n    this.scatter();\n  }\n  /** Put everyone where their routine says (a new day, a save, a long sleep). */\n  scatter() {\n    const g = this.g;\n    const w = g.world;\n    const s = new Stream(`${w.seed}:scatter:${w.clock.day}:${Math.floor(w.clock.minute / 60)}`);\n    for (const n of this.list) {\n      n.talking = false; n.path = null; n.chatPartner = null; n.state = 'idle'; n.timer = s.range(2, 15);\n      const [dx, dz] = doorOf(n.id);\n      if (!n.here || !n.shouldBeOut()) { n.inside = true; n.setPos(dx, dz + 0.4); }\n      else {\n        n.inside = false;\n        const poi = s.pick(POIS);\n        n.poi = poi;\n        n.setPos(poi.x, poi.z);\n        n.state = poi.kind === 'sit' ? 'sit' : poi.kind === 'fish' ? 'fish' : poi.kind === 'stare' ? 'stare' : 'idle';\n        n.timer = s.range(6, 30);\n        if (poi.face !== undefined) n.actor.facing = poi.face;\n      }\n      this.syncVisibility(n);\n    }\n  }\n  roomGuest(n) { const p = this.g.place; return p?.kind === 'room' && p.owner === n.id && n.here && n.inside; }\n  syncVisibility(n) {\n    const g = this.g;\n    const p = g.place;\n    if (this.roomGuest(n)) {\n      n.actor.addTo(p.group);\n      n.actor.visible = true;\n      const spot = p.ownerSpot ?? [0, 0];\n      n.actor.x = spot[0]; n.actor.z = spot[1]; n.actor.y = 0; n.actor.facing = 0;\n      return;\n    }\n    if (n.actor.root.parent !== g.town.group) n.actor.addTo(g.town.group);\n    n.actor.visible = !n.inside && n.here;\n    if (!n.inside) n.setPos(n.actor.x, n.actor.z);\n  }\n  placeChanged() { for (const n of this.list) this.syncVisibility(n); }\n  get(id) { return this.map.get(id); }\n  actor(id) { return this.map.get(id)?.actor ?? null; }\n  fixedStep(dt) {\n    for (const n of this.list) n.fixedStep(dt);\n    this.chatT -= dt * tuning.chatRate;\n    if (this.chatT <= 0 && tuning.chatRate > 0) {\n      this.chatT = 9;\n      this.tryChat();\n    }\n  }\n  tryChat() {\n    const idle = this.list.filter((n) => !n.inside && !n.talking && (n.state === 'idle' || n.state === 'stare') && !n.chatPartner && n.here);\n    for (let i = 0; i < idle.length; i++) for (let j = i + 1; j < idle.length; j++) {\n      const a = idle[i], b = idle[j];\n      if (Math.hypot(a.actor.x - b.actor.x, a.actor.z - b.actor.z) > 6) continue;\n      const chat = CHATS.find((c) => (c[0] === a.id && c[1] === b.id) || (c[0] === b.id && c[1] === a.id));\n      if (!chat) continue;\n      const first = chat[0] === a.id ? a : b;\n      const second = first === a ? b : a;\n      for (const n of [first, second]) { n.state = 'chat'; n.timer = 12; n.chatPartner = n === first ? second : first; n.path = null; }\n      first.actor.faceToward(second.actor.x, second.actor.z);\n      second.actor.faceToward(first.actor.x, first.actor.z);\n      first.bubble = chat[2]; first.bubbleT = 6;\n      second.bubble = chat[3]; second.bubbleT = 0;\n      second.pendingBubble = 3;\n      this.g.events.emit('chat', { a: first.id, b: second.id });\n      return;\n    }\n  }\n  presentation(dt) {\n    const g = this.g;\n    const p = g.player;\n    const camX = p.x, camZ = p.z;\n    const inTown = g.place === g.town;\n    for (const n of this.list) {\n      const a = n.actor;\n      if (n.pendingBubble > 0) { n.pendingBubble -= dt; if (n.pendingBubble <= 0) { n.bubbleT = 4; } }\n      if (!a.visible) continue;\n      const near = !inTown ? true : Math.abs(a.x - camX) < 16 && Math.abs(a.z - camZ) < 16;\n      n.presentation(dt, near);\n    }\n  }\n  /** Who should show a \"!\"? */\n  markerList() { return this.list.filter((n) => n.saved.favour && n.saved.favour.state === 'offer' && !n.inside && n.actor.visible); }\n  all() { return this.list; }\n}\nexport { LANDMARKS };\nEOF\ncat > src/systems/say.js <<'EOF'\n// Small helpers for scenes: say, choose, and a host conversation.\nimport { Dialogue } from '../ui/dialogue.js';\nimport { resolveTags } from './lines.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { CHAR_NAMES } from '../data/names.js';\n\nexport const nameOf = (id) => CHAR_NAMES[id] ?? NEIGHBOURS[id]?.name ?? id;\nfunction pages(g, text, extra) {\n  const t = resolveTags(text, g, extra);\n  return t.split('//').map((s) => s.trim()).filter(Boolean);\n}\n/** Generator: speak one or more lines as a character, wait for the player. */\nexport function* say(g, who, lines, { extra = {}, name = null, voice = null, emote = null } = {}) {\n  const list = (Array.isArray(lines) ? lines : [lines]).flatMap((l) => pages(g, l, extra));\n  let done = false;\n  const d = new Dialogue({ who, name: name ?? nameOf(who), voice: voice ?? who, beats: list.map((text, i) => (i === 0 && emote ? { text, emote } : { text })), onDone: () => { done = true; } });\n  g.ui.push(d);\n  faceTalk(g, who, true);\n  while (!done) yield;\n  faceTalk(g, who, false);\n}\n/** Generator: a line and a choice. Returns the index chosen. Back picks the last option. */\nexport function* ask(g, who, text, choices, { extra = {}, name = null, voice = null } = {}) {\n  const list = pages(g, text, extra);\n  let done = false;\n  let result = -1;\n  const d = new Dialogue({ who, name: name ?? nameOf(who), voice: voice ?? who, beats: list, choices, onDone: (c) => { done = true; result = c; } });\n  g.ui.push(d);\n  faceTalk(g, who, true);\n  while (!done) yield;\n  faceTalk(g, who, false);\n  return result;\n}\n/** Narration with no speaker. */\nexport function* narrate(g, text, extra = {}) {\n  let done = false;\n  g.ui.push(new Dialogue({ who: null, name: '', voice: null, beats: pages(g, text, extra), onDone: () => { done = true; } }));\n  while (!done) yield;\n}\nfunction faceTalk(g, who, on) {\n  const npc = g.npcs?.get?.(who);\n  const a = g.actorOf?.(who);\n  if (npc) npc.talking = on;\n  if (a && on) {\n    a.faceToward(g.player.x, g.player.z);\n    g.player.faceToward(a.x, a.z);\n    a.headLook = null;\n  }\n}\nEOF\ncat > src/data/names.js <<'EOF'\nexport const CHAR_NAMES = {\n  gander: 'Mrs. Gander', clementine: 'Clementine', trundle: 'Mayor Trundle', quill: 'Dr. Quill', mothwick: 'Madame Mothwick', rind: 'Old Rind', vesper: 'Vesper', hester: 'Hester', fleece: 'Monsieur Fleece', flavia: 'Flavia Rosé', magda: 'Magda', bellows: 'Sir Reginald', pemberton: 'Pemberton', brisket: 'Agent Brisket', lou: 'Languid Lou', nibbles: 'Madame Nibbles', pimm: 'Inspector Pimm', player: 'You', gran: 'Gran',\n};\nEOF\ncat > src/systems/talk.js <<'EOF'\n// Talking to a neighbour: friendship, memory, favours, gifts. The thing players tell friends about.\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { TYPE_LINES } from '../data/dialogue/types.js';\nimport { typeLine, uniqueLine, gossipLine, resolveTags } from './lines.js';\nimport { memoryLine, remember } from './memory.js';\nimport { say, ask } from './say.js';\nimport { tuning } from '../dev/tuning.js';\nimport { weatherNow, hourNow } from './time.js';\nimport { giftScore, removeSlot, addItem, addBeans, findItem, hasRoom } from './economy.js';\nimport { ITEMS, SELLABLE } from '../data/items.js';\nimport { pocketsPicker } from '../ui/screens/pockets.js';\nimport { favourTalk, offerFavour } from './favours.js';\nimport { day1Talk } from './dayone.js';\nimport { storyTalk } from './story.js';\nimport { Stream } from '../core/rng.js';\n\nexport const gainFriend = (g, id, n) => {\n  const s = g.world.npcs[id];\n  s.friend = Math.min(100, Math.max(0, s.friend + Math.round(n * (n > 0 ? tuning.friendMult : 1) * (g.world.player.luck === 'friend' && n > 0 ? 1.5 : 1))));\n  g.events.emit('friend', { id, friend: s.friend });\n};\nconst friendTier = (f) => (f >= 70 ? 'best friend' : f >= 40 ? 'friend' : f >= 15 ? 'acquaintance' : 'stranger');\nexport const friendLabel = friendTier;\n\nfunction contextLine(g, id) {\n  const w = g.world;\n  const h = hourNow(w);\n  const hh = h < 5 ? h + 24 : h;\n  const k = weatherNow(g);\n  const season = ['spring', 'summer', 'autumn', 'winter'][g.season];\n  const s = new Stream(`${w.seed}:ctx:${id}:${w.clock.day}:${w.stats.talks[id] ?? 0}`);\n  const r = s.next();\n  if (r < 0.2) return typeLine(g, id, hh < 11 ? 'morning' : hh < 16 ? 'noon' : hh < 21 ? 'evening' : 'night');\n  if (r < 0.38) return typeLine(g, id, k === 'storm' ? 'rain' : k === 'fog' || k === 'clear' ? 'sun' : k);\n  if (r < 0.5) return typeLine(g, id, season);\n  if (r < 0.75) return uniqueLine(g, id);\n  return typeLine(g, id, 'chatter');\n}\n\n/** A neighbour conversation as a scene. */\nexport function* talkTo(g, id) {\n  const w = g.world;\n  const s = w.npcs[id];\n  const data = NEIGHBOURS[id];\n  const npc = g.npcs.get(id);\n  const first = s.talkedDay !== w.clock.day;\n  w.stats.talks[id] = (w.stats.talks[id] ?? 0) + 1;\n  g.events.emit('talked', { id, first });\n  npc.talking = true;\n  // Knock after bedtime\n  const hr = hourNow(w) < 5 ? hourNow(w) + 24 : hourNow(w);\n  if (npc.inside && (hr < data.wake || hr >= data.sleep)) {\n    g.player.play('Idle');\n    yield* say(g, id, typeLine(g, id, 'night'));\n    npc.talking = false;\n    return;\n  }\n  const a = g.actorOf(id);\n  a.play('Talk', 0.15);\n  if (first) {\n    s.talkedDay = w.clock.day;\n    gainFriend(g, id, 3);\n  }\n  // Story beats come first: Day One errands, Rocco's news.\n  const handled = yield* day1Talk(g, id);\n  if (handled) { npc.talking = false; return; }\n  const storyDone = yield* storyTalk(g, id);\n  if (storyDone) { npc.talking = false; return; }\n  let opening = null;\n  if (first && s.absentNote) { opening = typeLine(g, id, 'absent'); s.absentNote = false; }\n  else if (g.world.player.puffy && !s.sawPuffy) { s.sawPuffy = true; opening = \"Your *face*! What happened to your face?! No. Don't tell me. It's wasps. It's always wasps.\"; }\n  else if (first && s.friend < 12) { opening = typeLine(g, id, 'greet'); }\n  else {\n    const m = first ? memoryLine(g, id) : null;\n    if (m) opening = m.text;\n    else if (first) opening = typeLine(g, id, 'greet');\n    else opening = contextLine(g, id);\n  }\n  // A favour on offer shows here.\n  const fav = s.favour;\n  const options = [];\n  if (fav && fav.state === 'active') options.push('About that favour…');\n  if (fav && fav.state === 'offer') options.push('Need anything?');\n  options.push('Chat');\n  options.push('Give a gift');\n  options.push('Bye');\n  const c = yield* ask(g, id, opening, options, { extra: { neighbour: 'someone' } });\n  const pick = options[c];\n  if (pick === 'Chat') {\n    a.play('Talk', 0.15);\n    const r = new Stream(`${w.seed}:chat:${id}:${w.stats.talks[id]}`).next();\n    const line = r < 0.35 ? gossipLine(g, id) : r < 0.6 ? uniqueLine(g, id) : r < 0.82 ? typeLine(g, id, 'chatter') : typeLine(g, id, 'hungry');\n    yield* say(g, id, line);\n  } else if (pick === 'Give a gift') {\n    yield* giveGift(g, id);\n  } else if (pick === 'About that favour…' || pick === 'Need anything?') {\n    yield* favourTalk(g, id);\n  }\n  a.play('Idle', 0.2);\n  npc.talking = false;\n}\n\nexport function* giveGift(g, id) {\n  const w = g.world;\n  const s = w.npcs[id];\n  let picked = -2;\n  g.ui.push(pocketsPicker(g, { title: `Give to ${NEIGHBOURS[id].short ?? NEIGHBOURS[id].name}`, filter: (slot) => ITEMS[slot.id] && ITEMS[slot.id].cat !== 'tool' && !ITEMS[slot.id].noSell, onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n  while (picked === -2) yield;\n  if (picked < 0) return false;\n  const slot = removeSlot(g, picked);\n  const it = ITEMS[slot.id];\n  const score = giftScore(id, slot.id);\n  const bank = score >= 2 ? 'giftLove' : score === 1 ? 'giftLike' : score === 0 ? 'giftMeh' : 'giftHate';\n  gainFriend(g, id, score >= 2 ? 10 : score === 1 ? 5 : score === 0 ? 2 : 0);\n  remember(g, 'gift', { item: it.name, about: id });\n  g.events.emit('gift', { id, item: slot.id, score });\n  w.stats.gifts = (w.stats.gifts ?? 0) + 1;\n  g.player.pose('Give', 0.5);\n  yield 0.35;\n  const a = g.actorOf(id);\n  a.play(score >= 1 ? 'Love' : score === 0 ? 'Shrug' : 'ShakeHead', 0.1, { once: true });\n  yield* say(g, id, typeLine(g, id, bank));\n  if (slot.id === 'cheeseOff' && id === 'ozzie') yield* say(g, id, 'This has gone off. Do you know what that means? It means it was *on*. You didn\\'t hear it from me.');\n  return true;\n}\nexport { offerFavour, addItem, addBeans, findItem, hasRoom, SELLABLE, resolveTags, TYPE_LINES };\nEOF\ncat > src/systems/favours.js <<'EOF'\n// Two favours a day, a \"!\" over the head: fetch, deliver, catch within an hour, return, trade.\nimport { FAVOURS, NEIGHBOURS, NEIGHBOUR_ORDER } from '../data/neighbours.js';\nimport { ITEMS } from '../data/items.js';\nimport { Stream } from '../core/rng.js';\nimport { say, ask } from './say.js';\nimport { typeLine } from './lines.js';\nimport { addItem, addBeans, findItem, removeSlot, hasRoom } from './economy.js';\nimport { tuning } from '../dev/tuning.js';\nimport { gainFriend, giveGift } from './talk.js';\nimport { absMinute } from './time.js';\nimport { remember } from './memory.js';\n\nconst REWARDS = ['shellConch', 'driftBottle', 'mushroom', 'stationery', 'seedTulip', 'seedDaisy', 'seedRose', 'seedBellflower', 'medicine', 'plainGreen', 'capBlue', 'pottedPlant', 'bearToy', 'cottageSide', 'mossyPlant', 'bureauCan'];\nexport function dailyFavours(g) {\n  const w = g.world;\n  const s = new Stream(`${w.seed}:favours:${w.clock.day}`);\n  for (const id of NEIGHBOUR_ORDER) { const f = w.npcs[id].favour; if (f && f.state === 'offer') w.npcs[id].favour = null; }\n  const here = NEIGHBOUR_ORDER.filter((n) => w.npcs[n].moved === 'here' && !w.npcs[n].favour);\n  for (const id of s.shuffle(here).slice(0, 2)) offerFavour(g, id, s);\n}\nexport function offerFavour(g, id, s = null) {\n  const w = g.world;\n  s ??= new Stream(`${w.seed}:favour:${id}:${w.clock.day}:${w.clock.minute}`);\n  const pool = FAVOURS.filter((f) => !f.seasons || f.seasons.includes(g.season));\n  const idx = FAVOURS.indexOf(s.pick(pool));\n  const f = FAVOURS[idx];\n  const others = NEIGHBOUR_ORDER.filter((n) => n !== id && w.npcs[n].moved === 'here');\n  const target = s.pick(others);\n  w.npcs[id].favour = { idx, state: 'offer', target, deadline: null, reward: s.pick(REWARDS), day: w.clock.day };\n  g.events.emit('favourOffered', { id, idx });\n}\nconst matches = (f, slot) => {\n  if (!slot) return false;\n  const it = ITEMS[slot.id];\n  if (f.anyCat) return it?.cat === f.anyCat;\n  return slot.id === f.item;\n};\nconst beanReward = (g, friend) => Math.round((300 + friend * 12) * tuning.favourMult);\nfunction* payOff(g, id, f, st) {\n  const w = g.world;\n  yield* say(g, id, f.done);\n  const a = g.actorOf(id);\n  a.play('Nod', 0.1, { once: true });\n  gainFriend(g, id, 8);\n  const bean = beanReward(g, w.npcs[id].friend);\n  addBeans(g, bean, 'favour');\n  g.sound('bean');\n  if (hasRoom(w)) { addItem(g, st.reward, { from: id }); }\n  yield* say(g, id, typeLine(g, id, 'thanks'));\n  g.ui.toastMsg(`+${bean} beans and a ${ITEMS[st.reward]?.name ?? 'thing'}`);\n  w.npcs[id].favour = null;\n  w.stats.favoursDone += 1;\n  g.events.emit('favourDone', { id });\n}\nexport function* favourTalk(g, id) {\n  const w = g.world;\n  const st = w.npcs[id].favour;\n  if (!st) return;\n  const f = FAVOURS[st.idx];\n  const name = NEIGHBOURS[st.target]?.short ?? NEIGHBOURS[st.target]?.name ?? 'someone';\n  const extra = { target: name };\n  if (st.state === 'offer') {\n    const lead = typeLine(g, id, 'favour');\n    yield* say(g, id, lead);\n    const c = yield* ask(g, id, f.ask, ['All right', 'Not today'], { extra });\n    if (c !== 0) return;\n    st.state = 'active';\n    if (f.kind === 'catch') st.deadline = absMinute(w) + f.mins;\n    if (f.kind === 'deliver') {\n      if (!hasRoom(w)) { yield* say(g, id, 'Your pockets are full. Come back when there\\'s room for it.'); st.state = 'offer'; return; }\n      addItem(g, 'parcel', { questFor: st.target, from: id });\n      g.sound('pickUp');\n    }\n    if (f.kind === 'return') g.world.flags.lostFor = { owner: id, holder: st.target };\n    g.events.emit('favourAccepted', { id, kind: f.kind });\n    return;\n  }\n  // active\n  if (f.kind === 'catch' && st.deadline && absMinute(w) > st.deadline) {\n    yield* say(g, id, \"Too late. The moment's gone. I've made other arrangements with the moment.\");\n    w.npcs[id].favour = null;\n    return;\n  }\n  if (f.kind === 'fetch' || f.kind === 'catch' || f.kind === 'trade') {\n    const i = w.player.pockets.findIndex((sl) => matches(f, sl));\n    if (i < 0) { yield* say(g, id, f.kind === 'catch' ? 'Well? The clock\\'s going. Where is it?' : 'You haven\\'t got it. I can tell. You\\'re walking too lightly.'); return; }\n    const c = yield* ask(g, id, `That ${ITEMS[w.player.pockets[i].id].name}. Is that for me?`, ['Here you go', 'Not this one']);\n    if (c !== 0) return;\n    removeSlot(g, i);\n    g.player.pose('Give', 0.5);\n    yield 0.35;\n    yield* payOff(g, id, f, st);\n    return;\n  }\n  if (f.kind === 'return') {\n    const i = w.player.pockets.findIndex((sl) => sl?.id === 'lostThing');\n    if (i < 0) { yield* say(g, id, `Have you asked ${name}? Go on. I'll wait. I'm very good at it.`); return; }\n    removeSlot(g, i);\n    yield* payOff(g, id, f, st);\n    return;\n  }\n  if (f.kind === 'deliver') yield* say(g, id, `It's for ${name}. Off you go.`);\n}\n/** Called from talk when the neighbour is the far end of someone else's errand. */\nexport function* favourFarEnd(g, id) {\n  const w = g.world;\n  const i = w.player.pockets.findIndex((sl) => sl?.id === 'parcel' && sl.questFor === id);\n  if (i >= 0) {\n    const slot = removeSlot(g, i);\n    const owner = slot.from;\n    const st = w.npcs[owner]?.favour;\n    const f = st ? FAVOURS[st.idx] : null;\n    g.player.pose('Give', 0.5);\n    yield 0.3;\n    yield* say(g, id, f?.done ?? 'Oh. Thank you.');\n    if (st) {\n      gainFriend(g, owner, 6);\n      gainFriend(g, id, 3);\n      const bean = beanReward(g, w.npcs[owner].friend);\n      addBeans(g, bean, 'favour');\n      g.sound('bean');\n      g.ui.toastMsg(`+${bean} beans, from ${NEIGHBOURS[owner]?.short ?? owner}'s errand`);\n      w.npcs[owner].favour = null;\n      w.stats.favoursDone += 1;\n      remember(g, 'gift', { item: 'parcel', about: id });\n      g.events.emit('favourDone', { id: owner });\n    }\n    return true;\n  }\n  if (w.flags.lostFor?.holder === id) {\n    if (!hasRoom(w)) { yield* say(g, id, 'I\\'ve got it here, but your pockets are full. Come back.'); return true; }\n    yield* say(g, id, 'Oh, that. It\\'s been holding up a table. Take it. The table can face the truth.');\n    addItem(g, 'lostThing', {});\n    g.sound('pickUp');\n    w.flags.lostFor = null;\n    return true;\n  }\n  return false;\n}\nexport { findItem, giveGift };\nEOF\necho ok","description":"Write NPC routines, scene helpers, talk and favours"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11307,"cache_read_input_tokens":445255,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11307},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a4cb4937-9264-42cc-b44d-b76eca04b6e6","uuid":"1827c7b4-00d6-43be-ae08-33e15e9d6d1b","timestamp":"2026-11-06T01:01:02.334Z","request_id":"req_011CgkmYdnL8uyHZkgHUonhe","wire_tool_inputs":{"toolu_01LXS18BkELEqLGETnXCuH8B":{"command":"cat > src/actors/npc.js <<'EOF'\n// Neighbours keep living whether you are there or not: routines, paths, chats, bubbles.\nimport { Actor } from './rig.js';\nimport { CRITTER_DEFS } from '../art/critter.js';\nimport { NEIGHBOURS, NEIGHBOUR_ORDER, POIS } from '../data/neighbours.js';\nimport { BUILDINGS, LANDMARKS } from '../data/town.js';\nimport { tuning } from '../dev/tuning.js';\nimport { Stream } from '../core/rng.js';\nimport { hourNow } from '../systems/time.js';\nimport { CHATS } from '../data/dialogue/unique.js';\nimport { weatherNow } from '../systems/time.js';\n\nconst doorOf = (id) => { const b = BUILDINGS.find((x) => x.id === NEIGHBOURS[id].building); return b.door; };\n\nclass Npc {\n  constructor(g, id) {\n    this.g = g;\n    this.id = id;\n    this.data = NEIGHBOURS[id];\n    this.actor = new Actor(CRITTER_DEFS[id], { name: id, seed: id.length + id.charCodeAt(0) });\n    this.state = 'idle';\n    this.timer = 1;\n    this.path = null;\n    this.inside = false;\n    this.talking = false;\n    this.bubble = null;\n    this.bubbleT = 0;\n    this.chatPartner = null;\n    this.poi = null;\n    this.poiIdx = 0;\n    this.umbrella = null;\n    this.tailT = 0;\n  }\n  get saved() { return this.g.world.npcs[this.id]; }\n  get here() { return this.saved.moved === 'here' || this.saved.moved === 'leaving'; }\n  setPos(x, z) {\n    const p = this.g.town;\n    this.actor.x = x; this.actor.z = z; this.actor.y = p.height(x, z);\n  }\n  shouldBeOut() {\n    const w = this.g.world;\n    if (!this.here) return false;\n    if (this.g.festivals?.holdsNpc?.(this.id)) return true;\n    const h = hourNow(w) < 5 ? hourNow(w) + 24 : hourNow(w);\n    if (h < this.data.wake || h >= this.data.sleep) return false;\n    const k = weatherNow(this.g);\n    const wet = k === 'rain' || k === 'storm';\n    const s = new Stream(`${w.seed}:rainy:${w.clock.day}:${this.id}`);\n    if (wet && s.chance(0.4)) return false;\n    if (this.g.cal.festival === 'longNight' && h >= 22) return true;\n    return true;\n  }\n  walkTo(x, z) {\n    const nav = this.g.town.nav;\n    const p = nav.path([this.actor.x, 0, this.actor.z], [x, 0, z]);\n    if (p && p.length > 1) { this.path = p.slice(1); this.state = 'walk'; return true; }\n    this.path = null;\n    return false;\n  }\n  pickPoi() {\n    const w = this.g.world;\n    const s = new Stream(`${w.seed}:poi:${w.clock.day}:${this.id}`);\n    const list = s.shuffle(POIS);\n    this.poiIdx = (this.poiIdx + 1) % list.length;\n    return list[this.poiIdx];\n  }\n  fixedStep(dt) {\n    if (this.talking || this.held) return;\n    const g = this.g;\n    if (!this.here) { this.inside = true; return; }\n    const out = this.shouldBeOut();\n    if (!out && !this.inside && this.state !== 'goingHome') {\n      const [dx, dz] = doorOf(this.id);\n      if (this.walkTo(dx, dz)) this.state = 'goingHome'; else { this.inside = true; this.state = 'idle'; }\n    }\n    if (out && this.inside) {\n      const [dx, dz] = doorOf(this.id);\n      this.inside = false;\n      this.setPos(dx, dz + 0.4);\n      this.state = 'idle';\n      this.timer = 2;\n      this.g.npcs.syncVisibility(this);\n    }\n    if (this.inside) return;\n    switch (this.state) {\n      case 'walk': case 'goingHome': {\n        const a = this.actor;\n        const n = this.path?.[0];\n        if (!n) { this.arrive(); break; }\n        const ddx = n[0] - a.x, ddz = n[2] - a.z;\n        const d = Math.hypot(ddx, ddz);\n        const sp = tuning.npcSpeed * (this.id === 'rocco' ? 1.7 : this.id === 'nib' ? 0.8 : 1);\n        if (d < 0.1) { this.path.shift(); if (!this.path.length) this.arrive(); break; }\n        a.x += (ddx / d) * sp * dt; a.z += (ddz / d) * sp * dt;\n        a.y = g.town.height(a.x, a.z);\n        a.turnTo = Math.atan2(ddx, ddz);\n        break;\n      }\n      case 'idle': case 'sit': case 'stare': case 'fish': case 'chat': {\n        this.timer -= dt;\n        if (this.timer <= 0) {\n          if (this.state === 'chat') { this.chatPartner = null; }\n          const next = this.pickPoi();\n          this.poi = next;\n          if (!this.walkTo(next.x, next.z)) { this.state = 'idle'; this.timer = 4; }\n        }\n        break;\n      }\n      default: break;\n    }\n  }\n  arrive() {\n    this.path = null;\n    if (this.state === 'goingHome') { this.inside = true; this.state = 'idle'; this.g.npcs.syncVisibility(this); return; }\n    const kind = this.poi?.kind ?? 'stand';\n    this.state = kind === 'sit' ? 'sit' : kind === 'fish' ? 'fish' : kind === 'stare' ? 'stare' : 'idle';\n    this.timer = 18 + ((this.actor.x * 37 + this.actor.z * 13) % 24);\n    if (this.poi?.face !== undefined) this.actor.turnTo = this.poi.face;\n  }\n  presentation(dt, near) {\n    const a = this.actor;\n    if (this.inside && !this.g.npcs.roomGuest(this)) return;\n    if (!near) { a.time += dt; a.root.position.set(a.x, a.y, a.z); if (a.shadow) a.shadow.place(a.x, a.y, a.z, 0); return; }\n    if (!this.talking && !a.finished === false) { /* finished a once clip */ }\n    let clip = 'Idle';\n    if (this.state === 'walk' || this.state === 'goingHome') clip = this.id === 'rocco' ? 'RoccoRoll' : 'Walk';\n    else if (this.state === 'sit') clip = 'Sit';\n    else if (this.state === 'fish') clip = 'Reel';\n    else if (this.state === 'stare') clip = 'Hum';\n    else if (this.state === 'chat') clip = 'Talk';\n    else if (this.talking) clip = 'Listen';\n    if (this.g.festivals?.pose?.(this.id)) clip = this.g.festivals.pose(this.id);\n    if (this.overrideClip) clip = this.overrideClip;\n    if (!this.emoting || a.finished) {\n      this.emoting = false;\n      if (a.playing !== clip) a.play(clip, 0.2);\n    }\n    a.update(dt);\n    if (this.bubbleT > 0) this.bubbleT -= dt;\n  }\n}\n\nexport class NpcManager {\n  constructor(g) { this.g = g; this.list = []; this.map = new Map(); this.chatT = 6; this.chatSeq = 0; this.roomOwner = null; }\n  buildAll() {\n    const g = this.g;\n    for (const id of NEIGHBOUR_ORDER) {\n      const n = new Npc(g, id);\n      n.actor.addTo(g.town.group);\n      this.list.push(n);\n      this.map.set(id, n);\n    }\n    this.scatter();\n  }\n  /** Put everyone where their routine says (a new day, a save, a long sleep). */\n  scatter() {\n    const g = this.g;\n    const w = g.world;\n    const s = new Stream(`${w.seed}:scatter:${w.clock.day}:${Math.floor(w.clock.minute / 60)}`);\n    for (const n of this.list) {\n      n.talking = false; n.path = null; n.chatPartner = null; n.state = 'idle'; n.timer = s.range(2, 15);\n      const [dx, dz] = doorOf(n.id);\n      if (!n.here || !n.shouldBeOut()) { n.inside = true; n.setPos(dx, dz + 0.4); }\n      else {\n        n.inside = false;\n        const poi = s.pick(POIS);\n        n.poi = poi;\n        n.setPos(poi.x, poi.z);\n        n.state = poi.kind === 'sit' ? 'sit' : poi.kind === 'fish' ? 'fish' : poi.kind === 'stare' ? 'stare' : 'idle';\n        n.timer = s.range(6, 30);\n        if (poi.face !== undefined) n.actor.facing = poi.face;\n      }\n      this.syncVisibility(n);\n    }\n  }\n  roomGuest(n) { const p = this.g.place; return p?.kind === 'room' && p.owner === n.id && n.here && n.inside; }\n  syncVisibility(n) {\n    const g = this.g;\n    const p = g.place;\n    if (this.roomGuest(n)) {\n      n.actor.addTo(p.group);\n      n.actor.visible = true;\n      const spot = p.ownerSpot ?? [0, 0];\n      n.actor.x = spot[0]; n.actor.z = spot[1]; n.actor.y = 0; n.actor.facing = 0;\n      return;\n    }\n    if (n.actor.root.parent !== g.town.group) n.actor.addTo(g.town.group);\n    n.actor.visible = !n.inside && n.here;\n    if (!n.inside) n.setPos(n.actor.x, n.actor.z);\n  }\n  placeChanged() { for (const n of this.list) this.syncVisibility(n); }\n  get(id) { return this.map.get(id); }\n  actor(id) { return this.map.get(id)?.actor ?? null; }\n  fixedStep(dt) {\n    for (const n of this.list) n.fixedStep(dt);\n    this.chatT -= dt * tuning.chatRate;\n    if (this.chatT <= 0 && tuning.chatRate > 0) {\n      this.chatT = 9;\n      this.tryChat();\n    }\n  }\n  tryChat() {\n    const idle = this.list.filter((n) => !n.inside && !n.talking && (n.state === 'idle' || n.state === 'stare') && !n.chatPartner && n.here);\n    for (let i = 0; i < idle.length; i++) for (let j = i + 1; j < idle.length; j++) {\n      const a = idle[i], b = idle[j];\n      if (Math.hypot(a.actor.x - b.actor.x, a.actor.z - b.actor.z) > 6) continue;\n      const chat = CHATS.find((c) => (c[0] === a.id && c[1] === b.id) || (c[0] === b.id && c[1] === a.id));\n      if (!chat) continue;\n      const first = chat[0] === a.id ? a : b;\n      const second = first === a ? b : a;\n      for (const n of [first, second]) { n.state = 'chat'; n.timer = 12; n.chatPartner = n === first ? second : first; n.path = null; }\n      first.actor.faceToward(second.actor.x, second.actor.z);\n      second.actor.faceToward(first.actor.x, first.actor.z);\n      first.bubble = chat[2]; first.bubbleT = 6;\n      second.bubble = chat[3]; second.bubbleT = 0;\n      second.pendingBubble = 3;\n      this.g.events.emit('chat', { a: first.id, b: second.id });\n      return;\n    }\n  }\n  presentation(dt) {\n    const g = this.g;\n    const p = g.player;\n    const camX = p.x, camZ = p.z;\n    const inTown = g.place === g.town;\n    for (const n of this.list) {\n      const a = n.actor;\n      if (n.pendingBubble > 0) { n.pendingBubble -= dt; if (n.pendingBubble <= 0) { n.bubbleT = 4; } }\n      if (!a.visible) continue;\n      const near = !inTown ? true : Math.abs(a.x - camX) < 16 && Math.abs(a.z - camZ) < 16;\n      n.presentation(dt, near);\n    }\n  }\n  /** Who should show a \"!\"? */\n  markerList() { return this.list.filter((n) => n.saved.favour && n.saved.favour.state === 'offer' && !n.inside && n.actor.visible); }\n  all() { return this.list; }\n}\nexport { LANDMARKS };\nEOF\ncat > src/systems/say.js <<'EOF'\n// Small helpers for scenes: say, choose, and a host conversation.\nimport { Dialogue } from '../ui/dialogue.js';\nimport { resolveTags } from './lines.js';\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { CHAR_NAMES } from '../data/names.js';\n\nexport const nameOf = (id) => CHAR_NAMES[id] ?? NEIGHBOURS[id]?.name ?? id;\nfunction pages(g, text, extra) {\n  const t = resolveTags(text, g, extra);\n  return t.split('//').map((s) => s.trim()).filter(Boolean);\n}\n/** Generator: speak one or more lines as a character, wait for the player. */\nexport function* say(g, who, lines, { extra = {}, name = null, voice = null, emote = null } = {}) {\n  const list = (Array.isArray(lines) ? lines : [lines]).flatMap((l) => pages(g, l, extra));\n  let done = false;\n  const d = new Dialogue({ who, name: name ?? nameOf(who), voice: voice ?? who, beats: list.map((text, i) => (i === 0 && emote ? { text, emote } : { text })), onDone: () => { done = true; } });\n  g.ui.push(d);\n  faceTalk(g, who, true);\n  while (!done) yield;\n  faceTalk(g, who, false);\n}\n/** Generator: a line and a choice. Returns the index chosen. Back picks the last option. */\nexport function* ask(g, who, text, choices, { extra = {}, name = null, voice = null } = {}) {\n  const list = pages(g, text, extra);\n  let done = false;\n  let result = -1;\n  const d = new Dialogue({ who, name: name ?? nameOf(who), voice: voice ?? who, beats: list, choices, onDone: (c) => { done = true; result = c; } });\n  g.ui.push(d);\n  faceTalk(g, who, true);\n  while (!done) yield;\n  faceTalk(g, who, false);\n  return result;\n}\n/** Narration with no speaker. */\nexport function* narrate(g, text, extra = {}) {\n  let done = false;\n  g.ui.push(new Dialogue({ who: null, name: '', voice: null, beats: pages(g, text, extra), onDone: () => { done = true; } }));\n  while (!done) yield;\n}\nfunction faceTalk(g, who, on) {\n  const npc = g.npcs?.get?.(who);\n  const a = g.actorOf?.(who);\n  if (npc) npc.talking = on;\n  if (a && on) {\n    a.faceToward(g.player.x, g.player.z);\n    g.player.faceToward(a.x, a.z);\n    a.headLook = null;\n  }\n}\nEOF\ncat > src/data/names.js <<'EOF'\nexport const CHAR_NAMES = {\n  gander: 'Mrs. Gander', clementine: 'Clementine', trundle: 'Mayor Trundle', quill: 'Dr. Quill', mothwick: 'Madame Mothwick', rind: 'Old Rind', vesper: 'Vesper', hester: 'Hester', fleece: 'Monsieur Fleece', flavia: 'Flavia Rosé', magda: 'Magda', bellows: 'Sir Reginald', pemberton: 'Pemberton', brisket: 'Agent Brisket', lou: 'Languid Lou', nibbles: 'Madame Nibbles', pimm: 'Inspector Pimm', player: 'You', gran: 'Gran',\n};\nEOF\ncat > src/systems/talk.js <<'EOF'\n// Talking to a neighbour: friendship, memory, favours, gifts. The thing players tell friends about.\nimport { NEIGHBOURS } from '../data/neighbours.js';\nimport { TYPE_LINES } from '../data/dialogue/types.js';\nimport { typeLine, uniqueLine, gossipLine, resolveTags } from './lines.js';\nimport { memoryLine, remember } from './memory.js';\nimport { say, ask } from './say.js';\nimport { tuning } from '../dev/tuning.js';\nimport { weatherNow, hourNow } from './time.js';\nimport { giftScore, removeSlot, addItem, addBeans, findItem, hasRoom } from './economy.js';\nimport { ITEMS, SELLABLE } from '../data/items.js';\nimport { pocketsPicker } from '../ui/screens/pockets.js';\nimport { favourTalk, offerFavour } from './favours.js';\nimport { day1Talk } from './dayone.js';\nimport { storyTalk } from './story.js';\nimport { Stream } from '../core/rng.js';\n\nexport const gainFriend = (g, id, n) => {\n  const s = g.world.npcs[id];\n  s.friend = Math.min(100, Math.max(0, s.friend + Math.round(n * (n > 0 ? tuning.friendMult : 1) * (g.world.player.luck === 'friend' && n > 0 ? 1.5 : 1))));\n  g.events.emit('friend', { id, friend: s.friend });\n};\nconst friendTier = (f) => (f >= 70 ? 'best friend' : f >= 40 ? 'friend' : f >= 15 ? 'acquaintance' : 'stranger');\nexport const friendLabel = friendTier;\n\nfunction contextLine(g, id) {\n  const w = g.world;\n  const h = hourNow(w);\n  const hh = h < 5 ? h + 24 : h;\n  const k = weatherNow(g);\n  const season = ['spring', 'summer', 'autumn', 'winter'][g.season];\n  const s = new Stream(`${w.seed}:ctx:${id}:${w.clock.day}:${w.stats.talks[id] ?? 0}`);\n  const r = s.next();\n  if (r < 0.2) return typeLine(g, id, hh < 11 ? 'morning' : hh < 16 ? 'noon' : hh < 21 ? 'evening' : 'night');\n  if (r < 0.38) return typeLine(g, id, k === 'storm' ? 'rain' : k === 'fog' || k === 'clear' ? 'sun' : k);\n  if (r < 0.5) return typeLine(g, id, season);\n  if (r < 0.75) return uniqueLine(g, id);\n  return typeLine(g, id, 'chatter');\n}\n\n/** A neighbour conversation as a scene. */\nexport function* talkTo(g, id) {\n  const w = g.world;\n  const s = w.npcs[id];\n  const data = NEIGHBOURS[id];\n  const npc = g.npcs.get(id);\n  const first = s.talkedDay !== w.clock.day;\n  w.stats.talks[id] = (w.stats.talks[id] ?? 0) + 1;\n  g.events.emit('talked', { id, first });\n  npc.talking = true;\n  // Knock after bedtime\n  const hr = hourNow(w) < 5 ? hourNow(w) + 24 : hourNow(w);\n  if (npc.inside && (hr < data.wake || hr >= data.sleep)) {\n    g.player.play('Idle');\n    yield* say(g, id, typeLine(g, id, 'night'));\n    npc.talking = false;\n    return;\n  }\n  const a = g.actorOf(id);\n  a.play('Talk', 0.15);\n  if (first) {\n    s.talkedDay = w.clock.day;\n    gainFriend(g, id, 3);\n  }\n  // Story beats come first: Day One errands, Rocco's news.\n  const handled = yield* day1Talk(g, id);\n  if (handled) { npc.talking = false; return; }\n  const storyDone = yield* storyTalk(g, id);\n  if (storyDone) { npc.talking = false; return; }\n  let opening = null;\n  if (first && s.absentNote) { opening = typeLine(g, id, 'absent'); s.absentNote = false; }\n  else if (g.world.player.puffy && !s.sawPuffy) { s.sawPuffy = true; opening = \"Your *face*! What happened to your face?! No. Don't tell me. It's wasps. It's always wasps.\"; }\n  else if (first && s.friend < 12) { opening = typeLine(g, id, 'greet'); }\n  else {\n    const m = first ? memoryLine(g, id) : null;\n    if (m) opening = m.text;\n    else if (first) opening = typeLine(g, id, 'greet');\n    else opening = contextLine(g, id);\n  }\n  // A favour on offer shows here.\n  const fav = s.favour;\n  const options = [];\n  if (fav && fav.state === 'active') options.push('About that favour…');\n  if (fav && fav.state === 'offer') options.push('Need anything?');\n  options.push('Chat');\n  options.push('Give a gift');\n  options.push('Bye');\n  const c = yield* ask(g, id, opening, options, { extra: { neighbour: 'someone' } });\n  const pick = options[c];\n  if (pick === 'Chat') {\n    a.play('Talk', 0.15);\n    const r = new Stream(`${w.seed}:chat:${id}:${w.stats.talks[id]}`).next();\n    const line = r < 0.35 ? gossipLine(g, id) : r < 0.6 ? uniqueLine(g, id) : r < 0.82 ? typeLine(g, id, 'chatter') : typeLine(g, id, 'hungry');\n    yield* say(g, id, line);\n  } else if (pick === 'Give a gift') {\n    yield* giveGift(g, id);\n  } else if (pick === 'About that favour…' || pick === 'Need anything?') {\n    yield* favourTalk(g, id);\n  }\n  a.play('Idle', 0.2);\n  npc.talking = false;\n}\n\nexport function* giveGift(g, id) {\n  const w = g.world;\n  const s = w.npcs[id];\n  let picked = -2;\n  g.ui.push(pocketsPicker(g, { title: `Give to ${NEIGHBOURS[id].short ?? NEIGHBOURS[id].name}`, filter: (slot) => ITEMS[slot.id] && ITEMS[slot.id].cat !== 'tool' && !ITEMS[slot.id].noSell, onPick: (i) => { picked = i; }, onCancel: () => { picked = -1; } }));\n  while (picked === -2) yield;\n  if (picked < 0) return false;\n  const slot = removeSlot(g, picked);\n  const it = ITEMS[slot.id];\n  const score = giftScore(id, slot.id);\n  const bank = score >= 2 ? 'giftLove' : score === 1 ? 'giftLike' : score === 0 ? 'giftMeh' : 'giftHate';\n  gainFriend(g, id, score >= 2 ? 10 : score === 1 ? 5 : score === 0 ? 2 : 0);\n  remember(g, 'gift', { item: it.name, about: id });\n  g.events.emit('gift', { id, item: slot.id, score });\n  w.stats.gifts = (w.stats.gifts ?? 0) + 1;\n  g.player.pose('Give', 0.5);\n  yield 0.35;\n  const a = g.actorOf(id);\n  a.play(score >= 1 ? 'Love' : score === 0 ? 'Shrug' : 'ShakeHead', 0.1, { once: true });\n  yield* say(g, id, typeLine(g, id, bank));\n  if (slot.id === 'cheeseOff' && id === 'ozzie') yield* say(g, id, 'This has gone off. Do you know what that means? It means it was *on*. You didn\\'t hear it from me.');\n  return true;\n}\nexport { offerFavour, addItem, addBeans, findItem, hasRoom, SELLABLE, resolveTags, TYPE_LINES };\nEOF\ncat > src/systems/favours.js <<'EOF'\n// Two favours a day, a \"!\" over the head: fetch, deliver, catch within an hour, return, trade.\nimport { FAVOURS, NEIGHBOURS, NEIGHBOUR_ORDER } from '../data/neighbours.js';\nimport { ITEMS } from '../data/items.js';\nimport { Stream } from '../core/rng.js';\nimport { say, ask } from './say.js';\nimport { typeLine } from './lines.js';\nimport { addItem, addBeans, findItem, removeSlot, hasRoom } from './economy.js';\nimport { tuning } from '../dev/tuning.js';\nimport { gainFriend, giveGift } from './talk.js';\nimport { absMinute } from './time.js';\nimport { remember } from './memory.js';\n\nconst REWARDS = ['shellConch', 'driftBottle', 'mushroom', 'stationery', 'seedTulip', 'seedDaisy', 'seedRose', 'seedBellflower', 'medicine', 'plainGreen', 'capBlue', 'pottedPlant', 'bearToy', 'cottageSide', 'mossyPlant', 'bureauCan'];\nexport function dailyFavours(g) {\n  const w = g.world;\n  const s = new Stream(`${w.seed}:favours:${w.clock.day}`);\n  for (const id of NEIGHBOUR_ORDER) { const f = w.npcs[id].favour; if (f && f.state === 'offer') w.npcs[id].favour = null; }\n  const here = NEIGHBOUR_ORDER.filter((n) => w.npcs[n].moved === 'here' && !w.npcs[n].favour);\n  for (const id of s.shuffle(here).slice(0, 2)) offerFavour(g, id, s);\n}\nexport function offerFavour(g, id, s = null) {\n  const w = g.world;\n  s ??= new Stream(`${w.seed}:favour:${id}:${w.clock.day}:${w.clock.minute}`);\n  const pool = FAVOURS.filter((f) => !f.seasons || f.seasons.includes(g.season));\n  const idx = FAVOURS.indexOf(s.pick(pool));\n  const f = FAVOURS[idx];\n  const others = NEIGHBOUR_ORDER.filter((n) => n !== id && w.npcs[n].moved === 'here');\n  const target = s.pick(others);\n  w.npcs[id].favour = { idx, state: 'offer', target, deadline: null, reward: s.pick(REWARDS), day: w.clock.day };\n  g.events.emit('favourOffered', { id, idx });\n}\nconst matches = (f, slot) => {\n  if (!slot) return false;\n  const it = ITEMS[slot.id];\n  if (f.anyCat) return it?.cat === f.anyCat;\n  return slot.id === f.item;\n};\nconst beanReward = (g, friend) => Math.round((300 + friend * 12) * tuning.favourMult);\nfunction* payOff(g, id, f, st) {\n  const w = g.world;\n  yield* say(g, id, f.done);\n  const a = g.actorOf(id);\n  a.play('Nod', 0.1, { once: true });\n  gainFriend(g, id, 8);\n  const bean = beanReward(g, w.npcs[id].friend);\n  addBeans(g, bean, 'favour');\n  g.sound('bean');\n  if (hasRoom(w)) { addItem(g, st.reward, { from: id }); }\n  yield* say(g, id, typeLine(g, id, 'thanks'));\n  g.ui.toastMsg(`+${bean} beans and a ${ITEMS[st.reward]?.name ?? 'thing'}`);\n  w.npcs[id].favour = null;\n  w.stats.favoursDone += 1;\n  g.events.emit('favourDone', { id });\n}\nexport function* favourTalk(g, id) {\n  const w = g.world;\n  const st = w.npcs[id].favour;\n  if (!st) return;\n  const f = FAVOURS[st.idx];\n  const name = NEIGHBOURS[st.target]?.short ?? NEIGHBOURS[st.target]?.name ?? 'someone';\n  const extra = { target: name };\n  if (st.state === 'offer') {\n    const lead = typeLine(g, id, 'favour');\n    yield* say(g, id, lead);\n    const c = yield* ask(g, id, f.ask, ['All right', 'Not today'], { extra });\n    if (c !== 0) return;\n    st.state = 'active';\n    if (f.kind === 'catch') st.deadline = absMinute(w) + f.mins;\n    if (f.kind === 'deliver') {\n      if (!hasRoom(w)) { yield* say(g, id, 'Your pockets are full. Come back when there\\'s room for it.'); st.state = 'offer'; return; }\n      addItem(g, 'parcel', { questFor: st.target, from: id });\n      g.sound('pickUp');\n    }\n    if (f.kind === 'return') g.world.flags.lostFor = { owner: id, holder: st.target };\n    g.events.emit('favourAccepted', { id, kind: f.kind });\n    return;\n  }\n  // active\n  if (f.kind === 'catch' && st.deadline && absMinute(w) > st.deadline) {\n    yield* say(g, id, \"Too late. The moment's gone. I've made other arrangements with the moment.\");\n    w.npcs[id].favour = null;\n    return;\n  }\n  if (f.kind === 'fetch' || f.kind === 'catch' || f.kind === 'trade') {\n    const i = w.player.pockets.findIndex((sl) => matches(f, sl));\n    if (i < 0) { yield* say(g, id, f.kind === 'catch' ? 'Well? The clock\\'s going. Where is it?' : 'You haven\\'t got it. I can tell. You\\'re walking too lightly.'); return; }\n    const c = yield* ask(g, id, `That ${ITEMS[w.player.pockets[i].id].name}. Is that for me?`, ['Here you go', 'Not this one']);\n    if (c !== 0) return;\n    removeSlot(g, i);\n    g.player.pose('Give', 0.5);\n    yield 0.35;\n    yield* payOff(g, id, f, st);\n    return;\n  }\n  if (f.kind === 'return') {\n    const i = w.player.pockets.findIndex((sl) => sl?.id === 'lostThing');\n    if (i < 0) { yield* say(g, id, `Have you asked ${name}? Go on. I'll wait. I'm very good at it.`); return; }\n    removeSlot(g, i);\n    yield* payOff(g, id, f, st);\n    return;\n  }\n  if (f.kind === 'deliver') yield* say(g, id, `It's for ${name}. Off you go.`);\n}\n/** Called from talk when the neighbour is the far end of someone else's errand. */\nexport function* favourFarEnd(g, id) {\n  const w = g.world;\n  const i = w.player.pockets.findIndex((sl) => sl?.id === 'parcel' && sl.questFor === id);\n  if (i >= 0) {\n    const slot = removeSlot(g, i);\n    const owner = slot.from;\n    const st = w.npcs[owner]?.favour;\n    const f = st ? FAVOURS[st.idx] : null;\n    g.player.pose('Give', 0.5);\n    yield 0.3;\n    yield* say(g, id, f?.done ?? 'Oh. Thank you.');\n    if (st) {\n      gainFriend(g, owner, 6);\n      gainFriend(g, id, 3);\n      const bean = beanReward(g, w.npcs[owner].friend);\n      addBeans(g, bean, 'favour');\n      g.sound('bean');\n      g.ui.toastMsg(`+${bean} beans, from ${NEIGHBOURS[owner]?.short ?? owner}'s errand`);\n      w.npcs[owner].favour = null;\n      w.stats.favoursDone += 1;\n      remember(g, 'gift', { item: 'parcel', about: id });\n      g.events.emit('favourDone', { id: owner });\n    }\n    return true;\n  }\n  if (w.flags.lostFor?.holder === id) {\n    if (!hasRoom(w)) { yield* say(g, id, 'I\\'ve got it here, but your pockets are full. Come back.'); return true; }\n    yield* say(g, id, 'Oh, that. It\\'s been holding up a table. Take it. The table can face the truth.');\n    addItem(g, 'lostThing', {});\n    g.sound('pickUp');\n    w.flags.lostFor = null;\n    return true;\n  }\n  return false;\n}\nexport { findItem, giveGift };\nEOF\necho ok","description":"Write NPC routines, scene helpers, talk and favours"}}}
