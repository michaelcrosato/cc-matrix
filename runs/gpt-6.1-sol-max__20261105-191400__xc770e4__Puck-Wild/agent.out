,\"url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/examples?ref=main\",\"html_url\":\"https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub/examples\",\"git_url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/trees/e14acb070e492eb9b98138adc8fe7d8c1a1e81f4\",\"download_url\":null,\"type\":\"dir\",\"_links\":{\"self\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/examples?ref=main\",\"git\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/trees/e14acb070e492eb9b98138adc8fe7d8c1a1e81f4\",\"html\":\"https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub/examples\"}},{\"name\":\"harness.html\",\"path\":\"lib/hub/harness.html\",\"sha\":\"2f05ce03d2c681849debe8653c6e4b78bcaa3877\",\"size\":27469,\"url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/harness.html?ref=main\",\"html_url\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/harness.html\",\"git_url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/2f05ce03d2c681849debe8653c6e4b78bcaa3877\",\"download_url\":\"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\",\"type\":\"file\",\"_links\":{\"self\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/harness.html?ref=main\",\"git\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/2f05ce03d2c681849debe8653c6e4b78bcaa3877\",\"html\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/harness.html\"}},{\"name\":\"retrofit.md\",\"path\":\"lib/hub/retrofit.md\",\"sha\":\"fb5a352492f8ebd34250ff11c72392ea86a8f864\",\"size\":3988,\"url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/retrofit.md?ref=main\",\"html_url\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/retrofit.md\",\"git_url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/fb5a352492f8ebd34250ff11c72392ea86a8f864\",\"download_url\":\"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/retrofit.md\",\"type\":\"file\",\"_links\":{\"self\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/retrofit.md?ref=main\",\"git\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/fb5a352492f8ebd34250ff11c72392ea86a8f864\",\"html\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/retrofit.md\"}},{\"name\":\"round.js\",\"path\":\"lib/hub/round.js\",\"sha\":\"3bc016f35b44db9749aad946e77bab6959b8d501\",\"size\":20268,\"url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/round.js?ref=main\",\"html_url\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/round.js\",\"git_url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/3bc016f35b44db9749aad946e77bab6959b8d501\",\"download_url\":\"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\",\"type\":\"file\",\"_links\":{\"self\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/round.js?ref=main\",\"git\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/3bc016f35b44db9749aad946e77bab6959b8d501\",\"html\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/round.js\"}},{\"name\":\"session.js\",\"path\":\"lib/hub/session.js\",\"sha\":\"472495d5a5939531220e8e0b626bc4be9146102b\",\"size\":16707,\"url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/session.js?ref=main\",\"html_url\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/session.js\",\"git_url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/472495d5a5939531220e8e0b626bc4be9146102b\",\"download_url\":\"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\",\"type\":\"file\",\"_links\":{\"self\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/session.js?ref=main\",\"git\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/472495d5a5939531220e8e0b626bc