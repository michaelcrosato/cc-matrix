{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' test.py\"","aggregated_output":"import json, sys, pathlib, time, traceback, os, subprocess\nfrom playwright.sync_api import sync_playwright\n\nROOT=pathlib.Path(__file__).resolve().parent\n(ROOT/'browser-temp').mkdir(exist_ok=True)\nos.environ['TMPDIR']=str(ROOT/'browser-temp')\nproject=json.loads((ROOT/'project.json').read_text())\nserver=json.loads((ROOT/'server.json').read_text())\nURL=f\"http://127.0.0.1:{server['port']}/{project['name']}.html\"+('?graphics=webgl' if os.environ.get('PUCK_VISUAL') else '')\nfailures=[]\ncount=0\ndef check(name, condition, detail=''):\n global count\n count+=1\n if not condition: failures.append(f'{name}: {detail}')\n\nsim=subprocess.run(['node',str(ROOT/'simulation-tests.mjs')],capture_output=True,text=True,cwd=ROOT)\ntry:\n for r in json.loads(sim.stdout):check(r['name'],r['pass'],r['detail'])\nexcept Exception:check('simulation subprocess',False,sim.stderr+sim.stdout)\n\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox'])\n page=browser.new_page(viewport={'width':1440,'height':900},device_scale_factor=1)\n errors=[]\n messages=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.on('console',lambda m:messages.append({'type':m.type,'text':m.text}))\n try:\n  page.goto(URL,wait_until='load',timeout=90000)\n  page.wait_for_function('window.__PUCK__?.ready || window.__PUCK_ERROR__',timeout=90000)\n  check('boot',page.evaluate('!!window.__PUCK__?.ready'),page.evaluate('window.__PUCK_ERROR__||\"\"'))\n  if page.evaluate('!!window.__PUCK__?.ready'):\n   check('correct game',page.title().startswith('Puck Wild'),page.title())\n   check('renderer backend',page.evaluate('__PUCK__.backend')==('WebGL 2 compatibility' if os.environ.get('PUCK_VISUAL') else 'WebGPU'),page.evaluate('__PUCK__.backend'))\n   check('title screen',page.evaluate('__PUCK__.screen')=='title')\n   if os.environ.get('PUCK_VISUAL'):\n    page.wait_for_timeout(1500)\n    page.screenshot(path=str(ROOT/'title.png'))\n    page.evaluate('__PUCK__.title()')\n   page.locator('#title-screen [data-action=\"play\"]').click()\n   page.wait_for_function('__PUCK__.game.phase===\"play\"',timeout=20000)\n   check('cup started',page.evaluate('__PUCK__.screen')=='play')\n   if os.environ.get('PUCK_VISUAL'):\n    page.wait_for_timeout(1000)\n    page.screenshot(path=str(ROOT/'match.png'))\n except Exception as e:\n  check('browser suite',False,str(e))\n finally:\n  check('runtime errors',not errors,'; '.join(errors[:8]))\n  (ROOT/'test-errors.json').write_text(json.dumps(errors))\n  (ROOT/'browser-console.json').write_text(json.dumps(messages,indent=2))\n  browser.close()\nfor failure in failures:print('FAIL '+failure)\nprint(f'{count-len(failures)}/{count} checks passed')\nsys.exit(bool(failures))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat > test.py <<'PY'\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport subprocess\nimport sys\nimport threading\nimport urllib.parse\nfrom playwright.sync_api import sync_playwright\n\nROOT=pathlib.Path(__file__).resolve().parent\n(ROOT/'browser-temp').mkdir(exist_ok=True)\nos.environ['TMPDIR']=str(ROOT/'browser-temp')\nproject=json.loads((ROOT/'project.json').read_text())\nVISUAL=bool(os.environ.get('PUCK_VISUAL'))\nfailures=[]\nreports={}\ncount=0\n\ndef check(name,condition,detail=''):\n global count\n count+=1\n if not condition:failures.append(f'{name}: {detail}')\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n def log_message(self,*_):pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(ROOT.parent)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nbase=f'http://127.0.0.1:{server.server_port}'\nURL=f\\\"{base}/{project['name']}.html\\\"+('?graphics=webgl' if VISUAL else '')\nsim=subprocess.run(['node',str(ROOT/'simulation-tests.mjs')],capture_output=True,text=True,cwd=ROOT)\ntry:\n reports['simulation']=json.loads(sim.stdout)\n for r in reports['simulation']:check(r['name'],r['pass'],r['detail'])\nexcept Exception:check('simulation subprocess',False,sim.stderr+sim.stdout)\n\nPAD_STUB='''window.__pads=Array.from({length:4},(_,i)=>({id:'Emulated standard DualSense '+i,index:i,connected:false,mapping:'standard',timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))}));Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});'''\n\ndef ready(page):\n page.wait_for_function('window.__PUCK__?.ready || window.__PUCK_ERROR__',timeout=90000)\n if not page.evaluate('\"'!!window.__PUCK__?.ready'\"'):raise RuntimeError(page.evaluate('window.__PUCK_ERROR__'))\n\ndef isolate(page,players=1):\n page.evaluate('''n=>{__PUCK__.start({players:n});const g=__PUCK__.game;g.phase='play';for(const i of [1,2,3]){const p=g.players[i];p.x=i%2?-17:19;p.z=10;p.body.setTranslation({x:p.x,y:.65,z:10},true);}}''',players)\n\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox','--enable-unsafe-swiftshader'])\n errors,messages=[],[]\n context=browser.new_context(viewport={'width':1440,'height':900},device_scale_factor=1)\n context.add_init_script(PAD_STUB)\n page=context.new_page()\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.on('console',lambda m:messages.append({'type':m.type,'text':m.text}))\n try:\n  page.goto(URL,wait_until='load',timeout=90000)\n  ready(page)\n  check('correct game',page.title().startswith('Puck Wild'),page.title())\n  backend=page.evaluate('__PUCK__.backend')\n  check('renderer backend',backend==('WebGL 2 compatibility' if VISUAL else 'WebGPU'),backend)\n  check('title screen',page.evaluate('__PUCK__.screen')=='title')\n  check('music defaults to ten percent',page.evaluate('__PUCK__.audio.musicVolume')==.1)\n  if VISUAL:\n   page.wait_for_timeout(1200)\n   page.screenshot(path=str(ROOT/'title.png'))\n   page.evaluate('__PUCK__.title()')\n  page.locator('#title-screen [data-action=\\\"play\\\"]').click()\n  page.wait_for_function('__PUCK__.game.phase===\\\"play\\\"',timeout=20000)\n  check('cup starts from menu',page.evaluate('__PUCK__.screen')=='play')\n  if VISUAL:\n   page.wait_for_timeout(700)\n   page.screenshot(path=str(ROOT/'match.png'))\n  isolate(page)\n  start_x=page.evaluate('__PUCK__.game.players[0].x')\n  page.keyboard.down('d');page.wait_for_timeout(450);page.keyboard.up('d')\n  check('keyboard controls skating',page.evaluate('__PUCK__.game.players[0].x')>start_x+1)\n  page.keyboard.press('Escape')\n  page.wait_for_function('__PUCK__.modal===\\\"pause\\\"')\n  old_time=page.evaluate('__PUCK__.game.remaining')\n  page.wait_for_timeout(250)\n  check('pause freezes standalone simulation',page.evaluate('__PUCK__.game.remaining')==old_time)\n  page.locator('[data-action=\\\"dev\\\"]').click()\n  page.locator('#speed').evaluate(\\\"e=>{e.value=12;e.dispatchEvent(new Event('input',{bubbles:true}))}\\\")\n  check('developer slider is live',page.evaluate('__PUCK__.game.tune.speed')==12)\n  page.locator('[data-action=\\\"reset-tuning\\\"]').click()\n  check('developer defaults reset',page.evaluate('__PUCK__.game.tune.speed')==8.8)\n  page.locator('[data-action=\\\"back\\\"]').click()\n  page.locator('[data-action=\\\"settings\\\"]').click()\n  page.locator('[data-action=\\\"glyph\\\"]').click()\n  page.evaluate(\\\"__PUCK__.controls.activity('pad',true)\\\")\n  check('Xbox prompt follows input','RT' in page.locator('#game-prompts').inner_text())\n  page.locator('[data-action=\\\"reset-settings\\\"]').click()\n  page.locator('[data-action=\\\"back\\\"]').click()\n  page.locator('[data-action=\\\"about\\\"]').click()\n  check('source information in credits','Ice Hockey - 1981' in page.locator('#credit-text').inner_text())\n  for tab in ['testing','engine','prompt']:\n   page.locator(f'[data-credit=\\\"{tab}\\\"]').click()\n   check(f'{tab} feedback in credits',len(page.locator('#credit-text').inner_text())>20)\n  page.evaluate(\\\"__PUCK__.action('resume')\\\")\n  isolate(page)\n  page.evaluate('__pads[0].connected=true;__pads[0].axes[0]=.8')\n  start_x=page.evaluate('__PUCK__.game.players[0].x')\n  page.wait_for_timeout(450)\n  page.evaluate('__pads[0].axes[0]=0')\n  check('emulated standard pad moves skater',page.evaluate('__PUCK__.game.players[0].x')>start_x+1)\n  check('PlayStation glyphs follow pad','R2' in page.locator('#game-prompts').inner_text())\n  page.evaluate('__pads[0].buttons[8].pressed=true;__pads[0].buttons[9].pressed=true')\n  page.wait_for_timeout(180)\n  check('Create + Options reserved for Hub',page.evaluate('__PUCK__.modal') is None)\n  page.evaluate('__pads[0].buttons[8].pressed=false;__pads[0].buttons[9].pressed=false')\n  page.wait_for_timeout(100)\n  page.evaluate('__pads[0].buttons[9].pressed=true')\n  page.wait_for_function('__PUCK__.modal===\\\"pause\\\"')\n  check('Options opens pause',page.evaluate('__PUCK__.modal')=='pause')\n  page.evaluate('__pads[0].buttons[9].pressed=false;__PUCK__.action(\\\"resume\\\")')\n  isolate(page)\n  page.evaluate('__PUCK__.game.givePuck(0);__pads[0].buttons[7].pressed=true')\n  page.wait_for_timeout(450)\n  check('R2 charges shot',page.evaluate('__PUCK__.game.players[0].charge')>.2)\n  page.evaluate('__pads[0].buttons[7].pressed=false')\n  page.wait_for_function('__PUCK__.game.stats.shots[0]>0')\n  check('R2 release shoots',page.evaluate('__PUCK__.game.stats.shots[0]')==1)\n  page.evaluate('__PUCK__.audio.event({type:\\\"goal\\\",team:0})')\n  page.wait_for_timeout(180)\n  sound=page.evaluate('''()=>{const a=__PUCK__.audio,b=new Uint8Array(a.analyser.fftSize);a.analyser.getByteTimeDomainData(b);return{state:a.ctx.state,level:Math.max(...b)-Math.min(...b),voices:a.voiceCount,volume:a.music.gain.value}}''')\n  check('synthesized sound has signal',sound['state']=='running' and sound['level']>0,str(sound))\n  check('gibberish voices generated',sound['voices']>0)\n  check('music bus remains ten percent',abs(sound['volume']-.1)<.001)\n  page.evaluate('__pads.forEach(p=>p.connected=false);__PUCK__.start({players:2});__PUCK__.game.phase=\\\"play\\\"')\n  old=page.evaluate('[__PUCK__.game.players[0].z,__PUCK__.game.players[2].z]')\n  page.keyboard.down('w');page.keyboard.down('i');page.wait_for_timeout(450);page.keyboard.up('w');page.keyboard.up('i')\n  new=page.evaluate('[__PUCK__.game.players[0].z,__PUCK__.game.players[2].z]')\n  check('two keyboard players move independently',all(new[i]<old[i]-1 for i in range(2)),str((old,new)))\n  page.evaluate('__pads.forEach((p,i)=>{p.connected=true;p.axes[0]=i%2?-.7:.7});__PUCK__.start({players:4});__PUCK__.game.phase=\\\"play\\\"')\n  old=page.evaluate('__PUCK__.game.players.slice(0,4).map(p=>p.x)')\n  page.wait_for_timeout(450)\n  new=page.evaluate('__PUCK__.game.players.slice(0,4).map(p=>p.x)')\n  check('four controller seats move',all(abs(new[i]-old[i])>.5 for i in range(4)),str((old,new)))\n  page.evaluate('__pads.forEach(p=>{p.connected=false;p.axes[0]=0});__PUCK__.title()')\n  page.wait_for_function('__PUCK__.screen===\\\"attract\\\"',timeout=18000)\n  check('attract starts after idle',page.evaluate('__PUCK__.game.attract') is True)\n  page.keyboard.press('Escape')\n  page.wait_for_function('__PUCK__.screen===\\\"title\\\"')\n  check('any input exits attract',page.evaluate('__PUCK__.screen')=='title')\n  page.evaluate('__PUCK__.start();const g=__PUCK__.game;g.phase=\\\"play\\\";g.tune.periodLength=.2;g.remaining=.2;g.score=[3,0];__PUCK__.step(1000,{0:{}})')\n  check('complete match reaches results screen',page.evaluate('__PUCK__.modal')=='result')\n  check('results display winner and stats','NORTH STARS TAKE THE CUP' in page.locator('#panel-content').inner_text())\n except Exception as e:check('desktop browser suite',False,str(e))\n finally:\n  check('desktop runtime errors',not errors,'; '.join(errors[:8]))\n  reports['browserConsole']=messages\n  context.close()\n\n mobile=browser.new_context(**p.devices['Pixel 7'])\n phone=mobile.new_page()\n mobile_errors=[]\n phone.on('pageerror',lambda e:mobile_errors.append(str(e)))\n try:\n  phone.goto(URL,wait_until='load',timeout=90000)\n  ready(phone)\n  phone.locator('#title-screen [data-action=\\\"play\\\"]').tap()\n  phone.wait_for_function('__PUCK__.game.phase===\\\"play\\\"',timeout=20000)\n  check('touch layout detected',phone.evaluate('__PUCK__.controls.last')=='touch')\n  check('touch action is contextual',phone.locator('#touch-action').is_visible())\n  check('desktop prompts hidden on touch',not phone.locator('#game-prompts').is_visible())\n  if VISUAL:phone.screenshot(path=str(ROOT/'phone.png'))\n  isolate(phone)\n  cdp=mobile.new_cdp_session(phone)\n  old=phone.evaluate('[__PUCK__.game.players[0].x,__PUCK__.game.players[0].z]')\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':70,'y':650,'id':1}]})\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':150,'y':620,'id':1}]})\n  phone.wait_for_timeout(500)\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n  new=phone.evaluate('[__PUCK__.game.players[0].x,__PUCK__.game.players[0].z]')\n  check('invisible touch stick moves player',sum((new[i]-old[i])**2 for i in range(2))>1,str((old,new)))\n  check('touch release clears stick',phone.evaluate('Math.abs(__PUCK__.controls.touch.x)+Math.abs(__PUCK__.controls.touch.z)')==0)\n  phone.evaluate('__PUCK__.game.givePuck(__PUCK__.game.seats[0].index)')\n  box=phone.locator('#touch-action').bounding_box()\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':box['x']+box['width']/2,'y':box['y']+box['height']/2,'id':2}]})\n  phone.wait_for_timeout(400)\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n  phone.wait_for_function('__PUCK__.game.stats.shots[0]>0')\n  check('touch hold and release shoots',phone.evaluate('__PUCK__.game.stats.shots[0]')>0)\n  phone.locator('[data-action=\\\"pause\\\"]').tap()\n  phone.wait_for_function('__PUCK__.modal===\\\"pause\\\"')\n  check('touch menu opens pause',phone.evaluate('__PUCK__.modal')=='pause')\n  phone.locator('[data-action=\\\"resume\\\"]').tap()\n  check('touch resumes',phone.evaluate('__PUCK__.modal') is None)\n except Exception as e:check('touch browser suite',False,str(e))\n finally:\n  check('touch runtime errors',not mobile_errors,'; '.join(mobile_errors[:8]))\n  mobile.close()\n\n if not VISUAL:\n  fc=browser.new_context();fp=fc.new_page()\n  try:\n   fp.goto((ROOT.parent/(project['name']+'.html')).as_uri(),timeout=90000)\n   ready(fp)\n   check('single HTML boots from file URL',fp.evaluate('__PUCK__.screen')=='title')\n  except Exception as e:check('file URL boot',False,str(e))\n  finally:fc.close()\n  for players,scenario,stress in [(2,'standard',False),(4,'standard',True),(4,'host-leave',True),(2,'server',False)]:\n   hc=browser.new_context(viewport={'width':1280,'height':900});hp=hc.new_page()\n   name=f'hub-{players}-{scenario}'\n   params={'game':'../../'+project['name']+'.html','players':players,'auto':1,'limit':20,'play':5000,'scenario':scenario}\n   if stress:params.update(latency=150,jitter=50,loss=5)\n   try:\n    hp.goto(f\\\"{base}/{project['name']}/vendor/harness.html?\\\"+urllib.parse.urlencode(params),timeout=90000)\n    hp.wait_for_function('window.__hubCheck?.done',timeout=120000)\n    report=hp.evaluate('window.__hubCheck');reports[name]=report\n    for c in report['checks']:check(name+': '+c['name'],c['pass'],c['detail'])\n    check(name+': overall conformance',report['pass'])\n    ended=hp.evaluate('''()=>Array.from(document.querySelectorAll('iframe')).map(f=>f.contentWindow?.__PUCK__).filter(Boolean).every(g=>g.audio.ended&&g.network.hubEnded)''')\n    check(name+': sound and input stop at end',ended)\n   except Exception as e:check(name,False,str(e))\n   finally:hc.close()\n browser.close()\nserver.shutdown();server.server_close()\nreports['summary']={'checks':count,'passed':count-len(failures),'failures':failures,'visualBackend':'WebGL compatibility' if VISUAL else 'WebGPU'}\n(ROOT/('visual-results.json' if VISUAL else 'test-results.json')).write_text(json.dumps(reports,indent=2))\nfor failure in failures:print('FAIL '+failure)\nprint(f'{count-len(failures)}/{count} checks passed')\nsys.exit(bool(failures))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat > test.py <<'PY'\nimport functools\nimport http.server\nimport json\nimport os\nimport pathlib\nimport subprocess\nimport sys\nimport threading\nimport urllib.parse\nfrom playwright.sync_api import sync_playwright\n\nROOT=pathlib.Path(__file__).resolve().parent\n(ROOT/'browser-temp').mkdir(exist_ok=True)\nos.environ['TMPDIR']=str(ROOT/'browser-temp')\nproject=json.loads((ROOT/'project.json').read_text())\nVISUAL=bool(os.environ.get('PUCK_VISUAL'))\nfailures=[]\nreports={}\ncount=0\n\ndef check(name,condition,detail=''):\n global count\n count+=1\n if not condition:failures.append(f'{name}: {detail}')\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n def log_message(self,*_):pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(ROOT.parent)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nbase=f'http://127.0.0.1:{server.server_port}'\nURL=f\\\"{base}/{project['name']}.html\\\"+('?graphics=webgl' if VISUAL else '')\nsim=subprocess.run(['node',str(ROOT/'simulation-tests.mjs')],capture_output=True,text=True,cwd=ROOT)\ntry:\n reports['simulation']=json.loads(sim.stdout)\n for r in reports['simulation']:check(r['name'],r['pass'],r['detail'])\nexcept Exception:check('simulation subprocess',False,sim.stderr+sim.stdout)\n\nPAD_STUB='''window.__pads=Array.from({length:4},(_,i)=>({id:'Emulated standard DualSense '+i,index:i,connected:false,mapping:'standard',timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))}));Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});'''\n\ndef ready(page):\n page.wait_for_function('window.__PUCK__?.ready || window.__PUCK_ERROR__',timeout=90000)\n if not page.evaluate('\"'!!window.__PUCK__?.ready'\"'):raise RuntimeError(page.evaluate('window.__PUCK_ERROR__'))\n\ndef isolate(page,players=1):\n page.evaluate('''n=>{__PUCK__.start({players:n});const g=__PUCK__.game;g.phase='play';for(const i of [1,2,3]){const p=g.players[i];p.x=i%2?-17:19;p.z=10;p.body.setTranslation({x:p.x,y:.65,z:10},true);}}''',players)\n\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox','--enable-unsafe-swiftshader'])\n errors,messages=[],[]\n context=browser.new_context(viewport={'width':1440,'height':900},device_scale_factor=1)\n context.add_init_script(PAD_STUB)\n page=context.new_page()\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.on('console',lambda m:messages.append({'type':m.type,'text':m.text}))\n try:\n  page.goto(URL,wait_until='load',timeout=90000)\n  ready(page)\n  check('correct game',page.title().startswith('Puck Wild'),page.title())\n  backend=page.evaluate('__PUCK__.backend')\n  check('renderer backend',backend==('WebGL 2 compatibility' if VISUAL else 'WebGPU'),backend)\n  check('title screen',page.evaluate('__PUCK__.screen')=='title')\n  check('music defaults to ten percent',page.evaluate('__PUCK__.audio.musicVolume')==.1)\n  if VISUAL:\n   page.wait_for_timeout(1200)\n   page.screenshot(path=str(ROOT/'title.png'))\n   page.evaluate('__PUCK__.title()')\n  page.locator('#title-screen [data-action=\\\"play\\\"]').click()\n  page.wait_for_function('__PUCK__.game.phase===\\\"play\\\"',timeout=20000)\n  check('cup starts from menu',page.evaluate('__PUCK__.screen')=='play')\n  if VISUAL:\n   page.wait_for_timeout(700)\n   page.screenshot(path=str(ROOT/'match.png'))\n  isolate(page)\n  start_x=page.evaluate('__PUCK__.game.players[0].x')\n  page.keyboard.down('d');page.wait_for_timeout(450);page.keyboard.up('d')\n  check('keyboard controls skating',page.evaluate('__PUCK__.game.players[0].x')>start_x+1)\n  page.keyboard.press('Escape')\n  page.wait_for_function('__PUCK__.modal===\\\"pause\\\"')\n  old_time=page.evaluate('__PUCK__.game.remaining')\n  page.wait_for_timeout(250)\n  check('pause freezes standalone simulation',page.evaluate('__PUCK__.game.remaining')==old_time)\n  page.locator('[data-action=\\\"dev\\\"]').click()\n  page.locator('#speed').evaluate(\\\"e=>{e.value=12;e.dispatchEvent(new Event('input',{bubbles:true}))}\\\")\n  check('developer slider is live',page.evaluate('__PUCK__.game.tune.speed')==12)\n  page.locator('[data-action=\\\"reset-tuning\\\"]').click()\n  check('developer defaults reset',page.evaluate('__PUCK__.game.tune.speed')==8.8)\n  page.locator('[data-action=\\\"back\\\"]').click()\n  page.locator('[data-action=\\\"settings\\\"]').click()\n  page.locator('[data-action=\\\"glyph\\\"]').click()\n  page.evaluate(\\\"__PUCK__.controls.activity('pad',true)\\\")\n  check('Xbox prompt follows input','RT' in page.locator('#game-prompts').inner_text())\n  page.locator('[data-action=\\\"reset-settings\\\"]').click()\n  page.locator('[data-action=\\\"back\\\"]').click()\n  page.locator('[data-action=\\\"about\\\"]').click()\n  check('source information in credits','Ice Hockey - 1981' in page.locator('#credit-text').inner_text())\n  for tab in ['testing','engine','prompt']:\n   page.locator(f'[data-credit=\\\"{tab}\\\"]').click()\n   check(f'{tab} feedback in credits',len(page.locator('#credit-text').inner_text())>20)\n  page.evaluate(\\\"__PUCK__.action('resume')\\\")\n  isolate(page)\n  page.evaluate('__pads[0].connected=true;__pads[0].axes[0]=.8')\n  start_x=page.evaluate('__PUCK__.game.players[0].x')\n  page.wait_for_timeout(450)\n  page.evaluate('__pads[0].axes[0]=0')\n  check('emulated standard pad moves skater',page.evaluate('__PUCK__.game.players[0].x')>start_x+1)\n  check('PlayStation glyphs follow pad','R2' in page.locator('#game-prompts').inner_text())\n  page.evaluate('__pads[0].buttons[8].pressed=true;__pads[0].buttons[9].pressed=true')\n  page.wait_for_timeout(180)\n  check('Create + Options reserved for Hub',page.evaluate('__PUCK__.modal') is None)\n  page.evaluate('__pads[0].buttons[8].pressed=false;__pads[0].buttons[9].pressed=false')\n  page.wait_for_timeout(100)\n  page.evaluate('__pads[0].buttons[9].pressed=true')\n  page.wait_for_function('__PUCK__.modal===\\\"pause\\\"')\n  check('Options opens pause',page.evaluate('__PUCK__.modal')=='pause')\n  page.evaluate('__pads[0].buttons[9].pressed=false;__PUCK__.action(\\\"resume\\\")')\n  isolate(page)\n  page.evaluate('__PUCK__.game.givePuck(0);__pads[0].buttons[7].pressed=true')\n  page.wait_for_timeout(450)\n  check('R2 charges shot',page.evaluate('__PUCK__.game.players[0].charge')>.2)\n  page.evaluate('__pads[0].buttons[7].pressed=false')\n  page.wait_for_function('__PUCK__.game.stats.shots[0]>0')\n  check('R2 release shoots',page.evaluate('__PUCK__.game.stats.shots[0]')==1)\n  page.evaluate('__PUCK__.audio.event({type:\\\"goal\\\",team:0})')\n  page.wait_for_timeout(180)\n  sound=page.evaluate('''()=>{const a=__PUCK__.audio,b=new Uint8Array(a.analyser.fftSize);a.analyser.getByteTimeDomainData(b);return{state:a.ctx.state,level:Math.max(...b)-Math.min(...b),voices:a.voiceCount,volume:a.music.gain.value}}''')\n  check('synthesized sound has signal',sound['state']=='running' and sound['level']>0,str(sound))\n  check('gibberish voices generated',sound['voices']>0)\n  check('music bus remains ten percent',abs(sound['volume']-.1)<.001)\n  page.evaluate('__pads.forEach(p=>p.connected=false);__PUCK__.start({players:2});__PUCK__.game.phase=\\\"play\\\"')\n  old=page.evaluate('[__PUCK__.game.players[0].z,__PUCK__.game.players[2].z]')\n  page.keyboard.down('w');page.keyboard.down('i');page.wait_for_timeout(450);page.keyboard.up('w');page.keyboard.up('i')\n  new=page.evaluate('[__PUCK__.game.players[0].z,__PUCK__.game.players[2].z]')\n  check('two keyboard players move independently',all(new[i]<old[i]-1 for i in range(2)),str((old,new)))\n  page.evaluate('__pads.forEach((p,i)=>{p.connected=true;p.axes[0]=i%2?-.7:.7});__PUCK__.start({players:4});__PUCK__.game.phase=\\\"play\\\"')\n  old=page.evaluate('__PUCK__.game.players.slice(0,4).map(p=>p.x)')\n  page.wait_for_timeout(450)\n  new=page.evaluate('__PUCK__.game.players.slice(0,4).map(p=>p.x)')\n  check('four controller seats move',all(abs(new[i]-old[i])>.5 for i in range(4)),str((old,new)))\n  page.evaluate('__pads.forEach(p=>{p.connected=false;p.axes[0]=0});__PUCK__.title()')\n  page.wait_for_function('__PUCK__.screen===\\\"attract\\\"',timeout=18000)\n  check('attract starts after idle',page.evaluate('__PUCK__.game.attract') is True)\n  page.keyboard.press('Escape')\n  page.wait_for_function('__PUCK__.screen===\\\"title\\\"')\n  check('any input exits attract',page.evaluate('__PUCK__.screen')=='title')\n  page.evaluate('__PUCK__.start();const g=__PUCK__.game;g.phase=\\\"play\\\";g.tune.periodLength=.2;g.remaining=.2;g.score=[3,0];__PUCK__.step(1000,{0:{}})')\n  check('complete match reaches results screen',page.evaluate('__PUCK__.modal')=='result')\n  check('results display winner and stats','NORTH STARS TAKE THE CUP' in page.locator('#panel-content').inner_text())\n except Exception as e:check('desktop browser suite',False,str(e))\n finally:\n  check('desktop runtime errors',not errors,'; '.join(errors[:8]))\n  reports['browserConsole']=messages\n  context.close()\n\n mobile=browser.new_context(**p.devices['Pixel 7'])\n phone=mobile.new_page()\n mobile_errors=[]\n phone.on('pageerror',lambda e:mobile_errors.append(str(e)))\n try:\n  phone.goto(URL,wait_until='load',timeout=90000)\n  ready(phone)\n  phone.locator('#title-screen [data-action=\\\"play\\\"]').tap()\n  phone.wait_for_function('__PUCK__.game.phase===\\\"play\\\"',timeout=20000)\n  check('touch layout detected',phone.evaluate('__PUCK__.controls.last')=='touch')\n  check('touch action is contextual',phone.locator('#touch-action').is_visible())\n  check('desktop prompts hidden on touch',not phone.locator('#game-prompts').is_visible())\n  if VISUAL:phone.screenshot(path=str(ROOT/'phone.png'))\n  isolate(phone)\n  cdp=mobile.new_cdp_session(phone)\n  old=phone.evaluate('[__PUCK__.game.players[0].x,__PUCK__.game.players[0].z]')\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':70,'y':650,'id':1}]})\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':150,'y':620,'id':1}]})\n  phone.wait_for_timeout(500)\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n  new=phone.evaluate('[__PUCK__.game.players[0].x,__PUCK__.game.players[0].z]')\n  check('invisible touch stick moves player',sum((new[i]-old[i])**2 for i in range(2))>1,str((old,new)))\n  check('touch release clears stick',phone.evaluate('Math.abs(__PUCK__.controls.touch.x)+Math.abs(__PUCK__.controls.touch.z)')==0)\n  phone.evaluate('__PUCK__.game.givePuck(__PUCK__.game.seats[0].index)')\n  box=phone.locator('#touch-action').bounding_box()\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':box['x']+box['width']/2,'y':box['y']+box['height']/2,'id':2}]})\n  phone.wait_for_timeout(400)\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n  phone.wait_for_function('__PUCK__.game.stats.shots[0]>0')\n  check('touch hold and release shoots',phone.evaluate('__PUCK__.game.stats.shots[0]')>0)\n  phone.locator('[data-action=\\\"pause\\\"]').tap()\n  phone.wait_for_function('__PUCK__.modal===\\\"pause\\\"')\n  check('touch menu opens pause',phone.evaluate('__PUCK__.modal')=='pause')\n  phone.locator('[data-action=\\\"resume\\\"]').tap()\n  check('touch resumes',phone.evaluate('__PUCK__.modal') is None)\n except Exception as e:check('touch browser suite',False,str(e))\n finally:\n  check('touch runtime errors',not mobile_errors,'; '.join(mobile_errors[:8]))\n  mobile.close()\n\n if not VISUAL:\n  fc=browser.new_context();fp=fc.new_page()\n  try:\n   fp.goto((ROOT.parent/(project['name']+'.html')).as_uri(),timeout=90000)\n   ready(fp)\n   check('single HTML boots from file URL',fp.evaluate('__PUCK__.screen')=='title')\n  except Exception as e:check('file URL boot',False,str(e))\n  finally:fc.close()\n  for players,scenario,stress in [(2,'standard',False),(4,'standard',True),(4,'host-leave',True),(2,'server',False)]:\n   hc=browser.new_context(viewport={'width':1280,'height':900});hp=hc.new_page()\n   name=f'hub-{players}-{scenario}'\n   params={'game':'../../'+project['name']+'.html','players':players,'auto':1,'limit':20,'play':5000,'scenario':scenario}\n   if stress:params.update(latency=150,jitter=50,loss=5)\n   try:\n    hp.goto(f\\\"{base}/{project['name']}/vendor/harness.html?\\\"+urllib.parse.urlencode(params),timeout=90000)\n    hp.wait_for_function('window.__hubCheck?.done',timeout=120000)\n    report=hp.evaluate('window.__hubCheck');reports[name]=report\n    for c in report['checks']:check(name+': '+c['name'],c['pass'],c['detail'])\n    check(name+': overall conformance',report['pass'])\n    ended=hp.evaluate('''()=>Array.from(document.querySelectorAll('iframe')).map(f=>f.contentWindow?.__PUCK__).filter(Boolean).every(g=>g.audio.ended&&g.network.hubEnded)''')\n    check(name+': sound and input stop at end',ended)\n   except Exception as e:check(name,False,str(e))\n   finally:hc.close()\n browser.close()\nserver.shutdown();server.server_close()\nreports['summary']={'checks':count,'passed':count-len(failures),'failures':failures,'visualBackend':'WebGL compatibility' if VISUAL else 'WebGPU'}\n(ROOT/('visual-results.json' if VISUAL else 'test-results.json')).write_text(json.dumps(reports,indent=2))\nfor failure in failures:print('FAIL '+failure)\nprint(f'{count-len(failures)}/{count} checks passed')\nsys.exit(bool(failures))\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
