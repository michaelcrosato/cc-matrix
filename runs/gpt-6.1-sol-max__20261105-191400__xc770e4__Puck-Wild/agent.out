{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os,json\nroot=os.getcwd()\nfor name in os.listdir('/proc'):\n if not name.isdigit():continue\n try:\n  if os.readlink('/proc/'+name+'/cwd')\"'!=root:continue\n  cmd=open('\"'/proc/'+name+'/cmdline','rb').read().split(b'\\\\0')\n  if cmd[:4]\"'!=[b'\"'python3',b'-m',b'http.server',b'0']:continue\n  sockets={os.readlink('/proc/'+name+'/fd/'+fd) for fd in os.listdir('/proc/'+name+'/fd')}\n  for line in open('/proc/'+name+'/net/tcp').readlines()[1:]:\n   fields=line.split()\n   if 'socket:['+fields[9]+']' in sockets and fields[3]=='0A':\n    result={'pid':int(name),'port':int(fields[1].split(':')[1],16)}\n    open('Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-max-20261105-191400/server.json','w').write(json.dumps(result));print(json.dumps(result))\n except (FileNotFoundError,PermissionError,ProcessLookupError):pass\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
