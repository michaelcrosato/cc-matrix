);\",\"F.add('b:sheet', x0 + 112, py + 80, 48, 12); F.add('b:ability', x0 + 112, py + 94, 98, 12, { skip: !(p.members[this.m] && B.abilityOf(p.members[this.m])) });\")\ns=s.replace(\"if (id === 'b:sheet') { this.sheet = !this.sheet; return; }\",\"if (id === 'b:ability') { B.cmdAbility(this.m); return; } if (id === 'b:sheet') { this.sheet = !this.sheet; return; }\")\ns=s.replace(\"      for (const id of ['sheet', 'dismiss']) {\",\"      { const q = F.items[F.index('b:ability')], mm = m, ab = B.abilityOf(mm); if (q && !q.skip && ab) { const sel = F.cur === F.index('b:ability'); UI.panel(g, q.x, q.y, q.w, q.h, { focus: sel }); UI.text(g, ab.n + ' (' + (mm.lay > 0 ? 'ready' : 'used') + ')', q.x + q.w / 2, q.y + 2, sel ? P.focus : P.text, { align: 'center', font: 'tiny' }); } }\\n      for (const id of ['sheet', 'dismiss']) {\",1)\nopen(p,'w').write(s)\np='tests/sim.test.mjs'; s=open(p).read()\ns=s.replace(\"  // ---- progress\",\"\"\"  { const B = mk(), S = B.S, p = S.party; const cl = p.members[1]; cl.cls = 'paladin'; cl.lay = 1; p.members[0].hp = 2; ok(B.cmdAbility(1) && p.members[0].hp > 2 && cl.lay === 0, 'Lay on Hands heals once per rest'); ok(!B.cmdAbility(1), 'only once'); cl.cls = 'cleric'; cl.lay = 1; at(B, 'f2', 9, 10, 1); B.F().mons = [B.makeMon('skeleton', 11, 10, 'hunt', { aware: true })]; ok(B.cmdAbility(1) && B.F().mons[0].state === 'flee', 'Turn the Dead sends the dead fleeing'); }\n  { const B = mk(), S = B.S; at(B, 'f1', 11, 5, 2); B.cmdUse(); at(B, 'f1', 15, 5, 2); B.cmdUse(); ok((B.F().items['13,5'] || []).length === 2, 'two buttons within the window drop a reward'); }\n  { const B = mk(), S = B.S; ok(B.def('f2').locks['8,8'].kind === 'warded', 'warded lock exists'); at(B, 'f2', 8, 9, 0); B.give('brasskey'); B.S.party.members[3].pack = B.S.party.members[3].pack.map(r => r && r.id === 'lockpicks' ? null : r); B.cmdUse(); ok(B.F().doors['8,8'].open, 'the brass key opens a warded lock'); }\n  // ---- progress\"\"\",1)\nopen(p,'w').write(s)\nEOF\nnode tests/lint.mjs && node tools/build.mjs >/dev/null && node tests/run.mjs 2>&1 | tail -4","uuid":"2c48cdf2-99e0-4e80-b20c-5c99dc0fcb84","session_id":"6c69a81a-1298-4714-b95d-17fe664f547a"}
