ls memorized at camp, and the caged Eye that holds the city\\'s bolts. Race the Rat Run against up to three other parties.', type: 'Game', genre: 'RPG', source: 'Eye of the Beholder (1991)', series: 'Eye of the Beholder', players: '1–4', controls: 'Stick/WASD move · D-pad/Q E turn · ✕/F use · □/Space strike · L2 R2/1-6 hands · △/I party', tags: ['3d', 'first-person', 'fantasy', 'retro', 'exploration', 'boss fights'] } };\nconst file = path.join(root, 'exit-interview.json'); fs.writeFileSync(file, JSON.stringify(o, null, 2)); JSON.parse(fs.readFileSync(file, 'utf8'));\nfor (const [k, v] of Object.entries(o.sourceInformation)) if (!String(v).trim()) throw new Error('empty ' + k);\nconsole.log('wrote exit-interview.json');\nEOF\nnode tools/exit.mjs && node tools/build.mjs && echo '{\"scripts\":{}}' >/dev/null; grep -rn \"TODO\\|FIXME\\|placeholder\\|XXX\" src/ | head","timeout":60000}}}
