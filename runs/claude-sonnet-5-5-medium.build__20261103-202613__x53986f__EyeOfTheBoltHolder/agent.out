('raceFinish', { t: r.t }); } };\nB.score = () => { const r = B.S.race; return r ? Math.round(r.cp * 1000 + r.crowns * 300 - r.t * 2) : 0; };\n// dev / tests\nB.cheat = (k, on) => { B.CHEATS[k] = on == null ? !B.CHEATS[k] : on; };\nB.warp = (floor, x, y, dir) => { const S = B.S, p = S.party; S.floor = floor; p.cx = x; p.cy = y; p.dir = dir == null ? p.dir : dir; p.tween = null; p.queued = null; S.proj.length = 0; S.camp = null; B.floorEnter(floor); };\nB.give = (id, n) => { const r = B.ref(id, n ? { n } : null); if (!B.partyAdd(r)) B.dropAt(B.S.party.cx, B.S.party.cy, r, B.S.floor); return r; };\nEOF\ncat > tests/sim.test.mjs <<'EOF'\nimport fs from 'node:fs'; import vm from 'node:vm'; import { lint, loadB } from './lint.mjs';\nconst files = fs.readdirSync('src').filter(f => /^(0|1|2)\\d-/.test(f)).sort();\nlet pass = 0, fail = 0; const ok = (c, m) => { if (c) pass++; else { fail++; console.log('FAIL sim: ' + m); } };\nconst B = loadB(files);\nB.startGame(1); const S = B.S;\nok(S.floor === 'f1' && S.party.members.length === 4, 'new game');\nok(B.cmdMove('f') && S.party.cy === 11, 'step north');\nfor (let i = 0; i < 100; i++) B.update(1 / 100);\nok(S.party.tween === null, 'tween finished');\nok(!B.cmdMove('l') || true, 'move left'); for (let i = 0; i < 100; i++) B.update(1 / 100);\n// walk into a wall\nB.warp('f1', 3, 10, 0); B.cmdMove('f'); for (let i = 0; i < 100; i++) B.update(1 / 100); ok(S.party.cy === 10 && S.party.bump >= 0, 'closed door blocks');\nok(B.cmdUse(), 'use door'); ok(B.F().doors['3,9'].open, 'door opened');\nconsole.log(`${pass} passed, ${fail} failed`);\nEOF\nnode tests/sim.test.mjs"}}}
