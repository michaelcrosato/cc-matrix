floor = S.floor; out.cell = [S.party.cx, S.party.cy]; out.gi = B.Bot.gi; out.party = S.party.members.map(m => m.name + ':' + m.state + ':' + m.hp + '/' + m.max + ' L' + m.lvl); out.kills = S.stats.kills; out.flags = S.special; out.B = B; return out;\n}\nif (process.argv[1].endsWith('bot.test.mjs')) { const o = run({ cheats: process.argv.includes('--cheats'), maxSeconds: 900, stopAt: process.argv.find(a => a.startsWith('--stop='))?.slice(7) }); delete o.B; console.log(JSON.stringify(o, null, 1)); }\nEOF\ntimeout 170 node tests/bot.test.mjs --cheats 2>&1 | head -50","timeout":180000}}}
