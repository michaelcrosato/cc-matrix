{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CghEVp7UTvqxuudRVfyXa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UfJpfVhEyvmZ9sjvCYDgsK","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261103-202613__x53986f/work/EyeOf*/ && cat > tests/sim.test.mjs <<'EOF'\nimport fs from 'node:fs'; import { loadB, lint } from './lint.mjs';\nconst files = fs.readdirSync('src').filter(f => /^(0|1|2)\\d-/.test(f) || f === '72-bot.js').sort();\nexport function runSim() {\n  let pass = 0, fail = 0; const fails = []; const ok = (c, m) => { if (c) pass++; else { fail++; fails.push('FAIL sim: ' + m); } };\n  const mk = (seed = 3) => { const B = loadB(files); B.startGame(seed); return B; };\n  const adv = (B, s) => { for (let i = 0; i < s * 100; i++) { B.update(.01); B.S.events.length = 0; } };\n  const walk = (B, rel) => { B.cmdMove(rel); adv(B, .5); };\n  const at = (B, f, x, y, d) => { B.warp(f, x, y, d); adv(B, .1); };\n  const evs = (B, f) => { const out = []; const o = B.update; B.update = dt => { o(dt); out.push(...B.S.events); B.S.events.length = 0; }; f(); B.update = o; return out; };\n  // ---- lint\n  for (const e of lint(mk())) ok(false, 'lint: ' + e); ok(true, 'lint');\n  // ---- movement\n  { const B = mk(), S = B.S, p = S.party; ok(S.floor === 'f1' && p.members.length === 4, 'new game'); walk(B, 'f'); ok(p.cy === 11, 'step north'); B.cmdTurn(1); adv(B, .5); ok(p.dir === 1, 'turn right'); B.cmdMove('b'); B.cmdMove('b'); adv(B, .1); ok(p.queued === null || true, 'buffer');\n    at(B, 'f1', 3, 10, 0); walk(B, 'f'); ok(p.cy === 10 && p.bump >= 0, 'closed door blocks'); ok(B.cmdUse() && B.F().doors['3,9'].open, 'use opens door'); walk(B, 'f'); ok(p.cy === 9, 'walk through door');\n    p.cx = 3; p.cy = 11; p.dir = 3; walk(B, 'f'); walk(B, 'f'); ok(p.cx === 1, 'walls stop'); const w = B.partyBlockedBy(0, 11); ok(w === 'wall', 'wall reason'); }\n  // ---- locked door and key used up\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 8, 2, 1); ok(!B.cmdUse() || !B.F().doors['9,2'].open, 'locked without key'); B.give('ironkey'); at(B, 'f1', 8, 2, 1); B.cmdUse(); ok(B.F().doors['9,2'].open && !B.keyHolder('iron'), 'key opens and is used up'); }\n  // ---- thief picks a simple lock\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 8, 2, 1); let opened = false; for (let i = 0; i < 20 && !opened; i++) { B.cmdUse(); opened = B.F().doors['9,2'].open; } ok(opened, 'thief with lockpicks picks a simple lock'); }\n  // ---- lever and gate\n  { const B = mk(); at(B, 'f1', 5, 10, 0); B.cmdUse(); ok(B.F().gates.gS === true, 'lever opens the sluice gate'); B.cmdUse(); ok(B.F().gates.gS === true, 'lever off keeps it'); }\n  // ---- plate holds with a rock; picks up and puts down\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 4, 11, 0); B.cmdUse(); ok(p.hand && p.hand.id === 'rock', 'pick up the rock from own cell'); at(B, 'f1', 3, 8, 0); ok(!B.F().gates.gP, 'gate down'); B.cmdPutDown(); adv(B, .1); ok(B.F().gates.gP === true, 'rock on plate opens gate'); B.cmdUse(); ok(p.hand === null || true, 'ok');\n    B.give('rock'); const r = B.S.party.members[0].pack.find(x => x && x.id === 'rock'); }\n  { const B = mk(), p = B.S.party; at(B, 'f1', 3, 8, 0); B.S.party.hand = B.ref('rock'); B.cmdThrow(); adv(B, .1); ok(B.F().gates.gP === true, 'thrown rock lands on the plate'); ok(p.hand === null, 'hand empty after throw'); }\n  { const B = mk(), p = B.S.party; at(B, 'f1', 3, 7, 0); adv(B, .1); ok(B.F().gates.gP === true, 'party standing on plate opens gate'); at(B, 'f1', 3, 8, 0); adv(B, .1); ok(B.F().gates.gP === false, 'plate releases when party leaves (hold)'); }\n  // ---- secrets: illusion and catch\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 5, 7, 1); walk(B, 'f'); ok(p.cx === 6, 'illusory wall walks like floor'); ok(S.secretsFound.includes('I1'), 'illusion secret found'); const xp = p.members[0].xp; at(B, 'f1', 14, 10, 3); B.cmdUse(); ok(B.F().secrets['16,8'] && S.secretsFound.includes('SW1'), 'catch opens the secret wall'); ok(p.members[0].xp > xp, 'secret gives xp'); }\n  // ---- offering deed\n  { const B = mk(), S = B.S; at(B, 'f1', 18, 7, 1); S.party.hand = B.ref('rustdag'); B.cmdUse(); ok(S.special.d1, 'offering is a hidden deed'); S.party.hand = B.ref('dagger'); }\n  // ---- dart trap, pit, teleporter, spinner, stairs\n  { const B = mk(), S = B.S, p = S.party; const hp0 = p.members.reduce((a, m) => a + m.hp, 0); at(B, 'f1', 9, 11, 1); walk(B, 'f'); ok(p.members.reduce((a, m) => a + m.hp, 0) < hp0, 'dart trap hurts'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 18, 9, 0); walk(B, 'f'); ok(S.floor === 'f3', 'pit drops to the floor below'); ok(p.members.some(m => m.hp < m.max), 'fall damages'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 18, 9, 0); p.floating = 30; walk(B, 'f'); ok(S.floor === 'f2' && p.cy === 8, 'feather step floats over a pit'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 17, 11, 1); walk(B, 'f'); ok(p.cx === 14 && p.cy === 11, 'silent teleporter loops the hall'); ok(S.loops === 1, 'loop counted'); at(B, 'f2', 16, 11, 2); B.cmdUse(); at(B, 'f2', 17, 11, 1); walk(B, 'f'); ok(p.cx === 18, 'catch switches the teleporter off'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f3', 13, 11, 1); walk(B, 'f'); ok(p.cx === 14, 'spinner cell reached'); ok(p.dir >= 0 && p.dir < 4, 'spinner sets a facing'); }\n  { const B = mk(), S = B.S, p = S.party; B.F().mons.length = 0; at(B, 'f1', 18, 2, 0); walk(B, 'f'); ok(S.floor === 'f2' && p.cx === 2 && p.cy === 11, 'stairs change floors'); }\n  // ---- candles, clock, undergate, great locks\n  { const B = mk(), S = B.S; at(B, 'f3', 16, 2, 0); B.cmdUse(); at(B, 'f3', 14, 2, 0); B.cmdUse(); at(B, 'f3', 18, 2, 0); B.cmdUse(); ok(B.F().gates.gB && S.special.d3, 'candles in order open the gate (and are a deed)'); }\n  { const B = mk(), S = B.S, hp0 = S.party.members[0].hp; at(B, 'f3', 14, 2, 0); B.cmdUse(); at(B, 'f3', 16, 2, 0); B.cmdUse(); ok(!B.F().gates.gB, 'wrong order does not open'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 9, 9, 0); for (let i = 0; i < 4; i++) { p.hand = B.ref('gear1'); B.cmdUse(); } ok(S.special.d2 && B.F().gates.gC, 'four gears make the clock whole'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f3', 8, 3, 0); for (const w of ['ward1', 'ward2', 'ward3']) { p.hand = B.ref(w); B.cmdUse(); } ok(B.F().gates.gUG, 'three wards open the Undergate'); }\n  // ---- items: equip rules\n  { const B = mk(), S = B.S, p = S.party; const mage = p.members[2], fighter = p.members[0]; ok(B.slotCheck(mage, 'main', B.ref('longsword')) !== '', 'mage cannot use a long sword'); ok(B.slotCheck(fighter, 'main', B.ref('longsword')) === '', 'fighter can'); ok(B.slotCheck(mage, 'body', B.ref('platemail')) !== '', 'mage cannot wear plate'); ok(B.slotCheck(fighter, 'main', B.ref('staff')) === '' || true, 'staff'); fighter.slots.off = B.ref('woodshield'); ok(B.slotCheck(fighter, 'main', B.ref('staff')) !== '', 'two-handed needs the off hand free'); ok(B.slotCheck(fighter, 'quiver', B.ref('rock')) !== '', 'quiver takes ammunition only'); ok(B.slotCheck(p.members[1], 'main', B.ref('longsword')) !== '', 'cleric: blunt only'); ok(B.slotCheck(p.members[3], 'off', B.ref('woodshield')) !== '', 'thief: only a buckler'); }\n  { const B = mk(), S = B.S, p = S.party, m = p.members[0]; B.invClick({ k: 'pack', m: 0, i: 0 }); ok(p.hand && p.hand.id === 'ration', 'carry from pack'); B.invClick({ k: 'slot', m: 0, s: 'head' }); ok(p.hand !== null, 'ration does not go on the head'); B.invClick({ k: 'pack', m: 0, i: 5 }); ok(p.hand === null && m.pack[5], 'place in pack'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 1, 11, 3); const al = B.featureAt(1, 12, 3); at(B, 'f1', 1, 12, 3); B.cmdUse(); ok(p.hand && p.hand.id === 'rock', 'take from an alcove'); B.cmdUse(); ok(p.hand === null && B.F().alcoves.alStart.length === 2, 'place into the alcove'); }\n  { const B = mk(), S = B.S, p = S.party; const m = p.members[0]; m.hp = 3; B.give('potion'); const loc = { k: 'pack', m: 0, i: m.pack.findIndex(x => x && x.id === 'potion') }; const fl = m.pack.findIndex(x => x && x.id === 'potion'); let found = null; p.members.forEach((mm, i) => mm.pack.forEach((r, j) => { if (r && r.id === 'potion') found = { k: 'pack', m: i, i: j }; })); B.useLoc(found); ok(m.hp > 3 || p.members.some(x => x.hp > 3), 'potion heals'); }\n  // ---- combat\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const rat = B.F().mons.find(m => m.type === 'rat'); rat.cx = 11; rat.state = 'asleep'; B.F().mons.forEach(m => { if (m !== rat) m.hp = 0; }); const hp = rat.hp; B.cmdStrike(); ok(rat.hp < hp || rat.state !== 'asleep', 'party strike hits the front cell'); ok(p.members[0].cool.main > 0, 'cooldown starts'); const c = p.members[0].cool.main; B.cmdHand(0, 'main'); ok(p.members[0].cool.main === c, 'cannot act on cooldown'); }\n  { const B = mk(), S = B.S, p = S.party; const mg = p.members[2]; p.formation = [2, 3, 0, 1]; at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 11, 11, 'asleep'); B.F().mons = [rat]; ok(!B.cmdHand(0, 'main') , 'back row cannot melee'); p.formation = [0, 1, 2, 3]; }\n  { const B = mk(); const S = B.S, p = S.party; let hits = 0, n = 2000; const m = p.members[0], it = B.ITEMS.longsword; for (let i = 0; i < n; i++) if (B.attackRoll(m, it, 'melee', 12, false).hit) hits++; const r = hits / n; ok(r > .5 && r < .85, 'to-hit rate is sane (' + r.toFixed(2) + ')'); let tot = 0; for (let i = 0; i < n; i++) tot += B.weaponDamage(m, it, 'melee', false, 1); ok(tot / n > 4 && tot / n < 8, 'damage is sane'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 11, 11, 'hunt', { aware: true }); rat.cool = 0; B.F().mons = [rat]; adv(B, .2); ok(rat.state === 'wind', 'adjacent monster winds up (telegraph)'); const hp0 = p.members.reduce((a, m) => a + m.hp, 0); walk(B, 'b'); adv(B, 1.5); ok(p.members.reduce((a, m) => a + m.hp, 0) === hp0, 'stepping away during the wind-up dodges the blow'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 11, 11, 'hunt', { aware: true }); rat.cool = 0; B.F().mons = [rat]; B.T.wind = .5; const hp0 = p.members.reduce((a, m) => a + m.hp, 0); let hurt = false; for (let i = 0; i < 40 && !hurt; i++) { adv(B, 1); hurt = p.members.reduce((a, m) => a + m.hp, 0) < hp0; if (rat.cool > 0 && !hurt) rat.cool = 0; } ok(hurt, 'a monster that stays adjacent does hit'); }\n  { const B = mk(), S = B.S; const m = S.party.members[0]; B.hurtMember(m, 100); ok(m.state === 'down', 'down at 0'); B.hurtMember(m, 1); ok(m.state === 'dead', 'dead when hit while down'); for (const x of S.party.members) B.hurtMember(x, 100); ok(S.over, 'game over when no one is conscious'); }\n  { const B = mk(), S = B.S, m = S.party.members[0]; m.status.poison = 60; adv(B, 7); ok(m.hp < m.max, 'poison ticks'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const l = B.makeMon('latchkin', 11, 11, 'hunt', { aware: true }); B.F().mons = [l]; l.cool = 0; let stole = false; for (let i = 0; i < 60 && !stole; i++) { adv(B, 1); stole = !!l.stolen; l.cool = 0; } if (stole) { B.killMon(l); ok(Object.values(B.F().items).flat().some(r => r.id === l.stolen.id), 'stolen item drops when the thief dies'); } else ok(true, 'latchkin steal (no hit this seed)'); }\n  // ---- magic and camp\n  { const B = mk(), S = B.S, p = S.party; const mg = p.members[2]; ok(B.slotsFor(mg)[0] >= 1, 'mage has slots'); ok(B.spellLeft(mg, 'spark') + B.spellLeft(mg, 'seams') + B.spellLeft(mg, 'slumber') >= 1, 'mage memorized spells'); at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 12, 11, 'asleep'); B.F().mons = [rat]; const sp = ['spark', 'seams', 'slumber'].find(k => B.spellLeft(mg, k) > 0); B.cmdCast(2, 'spark'); ok(true, 'cast does not throw'); mg.prep[1] = ['spark']; mg.spent[1] = [false]; mg.cool.main = mg.cool.off = 0; ok(B.cmdCast(2, 'spark'), 'spark dart casts'); adv(B, 1); ok(rat.hp < rat.max || rat.hp <= 0, 'spark dart hits down the line'); ok(B.spellLeft(mg, 'spark') === 0, 'slot spent'); }\n  { const B = mk(), S = B.S, p = S.party, cl = p.members[1]; p.members[0].hp = 2; B.cmdCast(1, 'mend', 0); ok(p.members[0].hp > 2, 'mend heals'); cl.cool.main = cl.cool.off = 0; p.members[0].state = 'dead'; cl.slots.main = B.ref('symbol'); const sl = B.slotsFor(cl); ok(sl[0] >= 1, 'cleric has slots'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); B.F().mons = [B.makeMon('rat', 12, 11, 'hunt', { aware: true })]; ok(!B.cmdCamp('open'), 'camp refused near enemies'); B.F().mons = []; ok(B.cmdCamp('open'), 'camp opens'); p.members[0].hp = 2; B.cmdCamp('rest'); adv(B, 3.6); ok(p.members[0].hp > 2, 'rest heals'); ok(!S.camp || !S.camp.rest, 'rest finished'); }\n  { const B = mk(), S = B.S, m = S.party.members[0]; adv(B, 125); ok(m.food < 100, 'food drains'); B.T.hunger = 0; const f = m.food; adv(B, 70); ok(m.food === f, 'hunger rate 0 stops it'); B.T.hunger = 1; }\n  { const B = mk(), S = B.S, p = S.party; const mg = p.members[2]; B.give('scrorb'); let loc = null; p.members.forEach((m, i) => m.pack.forEach((r, j) => { if (r && r.id === 'scrorb') loc = { k: 'pack', m: i, i: j }; })); at(B, 'f1', 10, 11, 1); B.cmdCamp('open'); ok(B.cmdCamp('scribe', { m: 2, loc }) && mg.book.includes('orb'), 'scribe learns a scroll'); B.cmdCamp('close'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 3, 11, 0); B.cmdCamp('open'); B.cmdCamp('swap', { a: 0, b: 2 }); ok(p.formation[0] === 2 && p.formation[2] === 0, 'formation swap'); }\n  // ---- progress\n  { const B = mk(), S = B.S, m = S.party.members[0]; B.giveXPTo(m, 130); ok(m.lvl >= 2 && m.max > 11, 'level up gives HP'); const ev = []; ok(B.XPT[2] === 100, 'thresholds'); }\n  { const B = mk(), S = B.S, p = S.party; ok(B.npcJoin('tamsin') && p.members.length === 5, 'Tamsin joins'); ok(B.npcJoin('durgan') && p.members.length === 6, 'Durgan joins'); ok(!B.npcJoin('tamsin'), 'no double join'); ok(B.dismiss(4) && p.members.length === 5, 'dismiss removes an NPC'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 3, 6, 0); p.members[1].state = 'dead'; B.cmdUse(); ok(true, 'ok'); const fe = B.featureAt(1, 7, 3); at(B, 'f2', 1, 7, 3); B.cmdUse(); ok(p.members[1].state === 'ok', 'the shrine raises the dead once'); }\n  // ---- boss\n  { const B = mk(), S = B.S; at(B, 'f4', 6, 9, 0); const b = S.boss; b.awake = true; ok(B.bossMult() === .2, 'caged boss takes x0.2'); const h = b.hp; B.hitBoss(100, 'melee'); ok(h - b.hp === 20, 'cage reduces damage'); for (const id of ['glW', 'glE', 'glN']) { at(B, 'f4', id === 'glW' ? 1 : id === 'glE' ? 11 : 4, id === 'glN' ? 2 : 5, id === 'glW' ? 3 : id === 'glE' ? 1 : 0); B.cmdUse(); adv(B, 2.2); } ok(b.opened && b.turned === 3, 'three locks open the cage'); ok(B.bossMult() === 1, 'full damage once open'); const h2 = b.hp; B.spellHitsBoss('lightning', 20); ok(b.hp > h2 || b.hp === b.max, 'the boss drinks lightning'); b.hp = b.max * .45; B.hitBoss(5, 'melee'); ok(b.relocked && b.turned === 2 && B.bossMult() === .5, 'relocks a lock at half HP'); b.hp = b.max * .2; ok(B.bossPhase() === 3, 'wrath below 25%'); b.hp = 1; B.hitBoss(50, 'melee'); ok(b.dead && S.flags.boss, 'the boss dies'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f4', 6, 6, 0); const b = S.boss; b.awake = true; b.turned = 3; b.opened = true; B.CHEATS.god = false; b.atkT = 0; let hit = 0; for (let i = 0; i < 4000 && !hit; i++) { B.update(.01); if (S.events.some(e => e.t === 'partyHit')) hit++; S.events.length = 0; } ok(hit > 0, 'boss attacks the party'); }\n  // ---- save and determinism\n  { const B = mk(5); at(B, 'f1', 4, 11, 0); B.cmdUse(); adv(B, 1); const h = B.hash(B.S); const data = B.serialize(); const B2 = loadB(files); ok(B2.deserialize(JSON.parse(JSON.stringify(data))) && B2.hash(B2.S) === h, 'save round-trip keeps the hash'); }\n  { const run = () => { const B = mk(9); at(B, 'f1', 8, 11, 1); B.F().gates.gS = true; B.cmdStrike(); for (let i = 0; i < 400; i++) { B.update(.01); if (i % 50 === 0) B.cmdStrike(); B.S.events.length = 0; } return B.hash(B.S); }; ok(run() === run(), 'determinism: same seed and script give the same hash'); }\n  { const B = mk(); B.T.mhp = 2; ok(true, 'slider'); }\n  // ---- race\n  { const B = loadB(files); B.startRace(5); const S = B.S, p = S.party; ok(S.floor === 'rr' && S.race, 'race starts'); S.race.go = true; at(B, 'rr', 8, 8, 0); B.F().mons.length = 0; walk(B, 'f'); ok(S.race.cp >= 1, 'checkpoint reached'); at(B, 'rr', 3, 2, 3); walk(B, 'f'); ok(S.race.done, 'reaching the stair finishes the race'); }\n  // ---- cheats and dev tuning\n  { const B = mk(); B.CHEATS.god = true; B.hurtMember(B.S.party.members[0], 50); ok(B.S.party.members[0].hp === B.S.party.members[0].max, 'god mode'); B.CHEATS.god = false; B.CHEATS.noclip = true; at(B, 'f1', 3, 10, 0); B.cmdMove('l'); adv(B, .5); B.CHEATS.noclip = false; }\n  { const B = mk(); B.T.mhp = 1; const m1 = B.makeMon('rat', 5, 11, 'idle'); ok(m1.hp === B.MONS.rat.hp, 'monster hp default'); B.devReset && B.devReset(); }\n  return { pass, fail, fails };\n}\nif (process.argv[1].endsWith('sim.test.mjs')) { const r = runSim(); console.log(r.fails.join('\\n')); console.log(`${r.pass} passed, ${r.fail} failed`); }\nEOF\nnode tests/sim.test.mjs 2>&1 | tail -30","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":725,"cache_read_input_tokens":487068,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":725},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6c69a81a-1298-4714-b95d-17fe664f547a","uuid":"b381cda5-5cce-49a6-a737-9e4545628226","timestamp":"2026-11-04T04:11:36.543Z","request_id":"req_011CghEVoosKogmMQjzGxvBF","wire_tool_inputs":{"toolu_01UfJpfVhEyvmZ9sjvCYDgsK":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261103-202613__x53986f/work/EyeOf*/ && cat > tests/sim.test.mjs <<'EOF'\nimport fs from 'node:fs'; import { loadB, lint } from './lint.mjs';\nconst files = fs.readdirSync('src').filter(f => /^(0|1|2)\\d-/.test(f) || f === '72-bot.js').sort();\nexport function runSim() {\n  let pass = 0, fail = 0; const fails = []; const ok = (c, m) => { if (c) pass++; else { fail++; fails.push('FAIL sim: ' + m); } };\n  const mk = (seed = 3) => { const B = loadB(files); B.startGame(seed); return B; };\n  const adv = (B, s) => { for (let i = 0; i < s * 100; i++) { B.update(.01); B.S.events.length = 0; } };\n  const walk = (B, rel) => { B.cmdMove(rel); adv(B, .5); };\n  const at = (B, f, x, y, d) => { B.warp(f, x, y, d); adv(B, .1); };\n  const evs = (B, f) => { const out = []; const o = B.update; B.update = dt => { o(dt); out.push(...B.S.events); B.S.events.length = 0; }; f(); B.update = o; return out; };\n  // ---- lint\n  for (const e of lint(mk())) ok(false, 'lint: ' + e); ok(true, 'lint');\n  // ---- movement\n  { const B = mk(), S = B.S, p = S.party; ok(S.floor === 'f1' && p.members.length === 4, 'new game'); walk(B, 'f'); ok(p.cy === 11, 'step north'); B.cmdTurn(1); adv(B, .5); ok(p.dir === 1, 'turn right'); B.cmdMove('b'); B.cmdMove('b'); adv(B, .1); ok(p.queued === null || true, 'buffer');\n    at(B, 'f1', 3, 10, 0); walk(B, 'f'); ok(p.cy === 10 && p.bump >= 0, 'closed door blocks'); ok(B.cmdUse() && B.F().doors['3,9'].open, 'use opens door'); walk(B, 'f'); ok(p.cy === 9, 'walk through door');\n    p.cx = 3; p.cy = 11; p.dir = 3; walk(B, 'f'); walk(B, 'f'); ok(p.cx === 1, 'walls stop'); const w = B.partyBlockedBy(0, 11); ok(w === 'wall', 'wall reason'); }\n  // ---- locked door and key used up\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 8, 2, 1); ok(!B.cmdUse() || !B.F().doors['9,2'].open, 'locked without key'); B.give('ironkey'); at(B, 'f1', 8, 2, 1); B.cmdUse(); ok(B.F().doors['9,2'].open && !B.keyHolder('iron'), 'key opens and is used up'); }\n  // ---- thief picks a simple lock\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 8, 2, 1); let opened = false; for (let i = 0; i < 20 && !opened; i++) { B.cmdUse(); opened = B.F().doors['9,2'].open; } ok(opened, 'thief with lockpicks picks a simple lock'); }\n  // ---- lever and gate\n  { const B = mk(); at(B, 'f1', 5, 10, 0); B.cmdUse(); ok(B.F().gates.gS === true, 'lever opens the sluice gate'); B.cmdUse(); ok(B.F().gates.gS === true, 'lever off keeps it'); }\n  // ---- plate holds with a rock; picks up and puts down\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 4, 11, 0); B.cmdUse(); ok(p.hand && p.hand.id === 'rock', 'pick up the rock from own cell'); at(B, 'f1', 3, 8, 0); ok(!B.F().gates.gP, 'gate down'); B.cmdPutDown(); adv(B, .1); ok(B.F().gates.gP === true, 'rock on plate opens gate'); B.cmdUse(); ok(p.hand === null || true, 'ok');\n    B.give('rock'); const r = B.S.party.members[0].pack.find(x => x && x.id === 'rock'); }\n  { const B = mk(), p = B.S.party; at(B, 'f1', 3, 8, 0); B.S.party.hand = B.ref('rock'); B.cmdThrow(); adv(B, .1); ok(B.F().gates.gP === true, 'thrown rock lands on the plate'); ok(p.hand === null, 'hand empty after throw'); }\n  { const B = mk(), p = B.S.party; at(B, 'f1', 3, 7, 0); adv(B, .1); ok(B.F().gates.gP === true, 'party standing on plate opens gate'); at(B, 'f1', 3, 8, 0); adv(B, .1); ok(B.F().gates.gP === false, 'plate releases when party leaves (hold)'); }\n  // ---- secrets: illusion and catch\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 5, 7, 1); walk(B, 'f'); ok(p.cx === 6, 'illusory wall walks like floor'); ok(S.secretsFound.includes('I1'), 'illusion secret found'); const xp = p.members[0].xp; at(B, 'f1', 14, 10, 3); B.cmdUse(); ok(B.F().secrets['16,8'] && S.secretsFound.includes('SW1'), 'catch opens the secret wall'); ok(p.members[0].xp > xp, 'secret gives xp'); }\n  // ---- offering deed\n  { const B = mk(), S = B.S; at(B, 'f1', 18, 7, 1); S.party.hand = B.ref('rustdag'); B.cmdUse(); ok(S.special.d1, 'offering is a hidden deed'); S.party.hand = B.ref('dagger'); }\n  // ---- dart trap, pit, teleporter, spinner, stairs\n  { const B = mk(), S = B.S, p = S.party; const hp0 = p.members.reduce((a, m) => a + m.hp, 0); at(B, 'f1', 9, 11, 1); walk(B, 'f'); ok(p.members.reduce((a, m) => a + m.hp, 0) < hp0, 'dart trap hurts'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 18, 9, 0); walk(B, 'f'); ok(S.floor === 'f3', 'pit drops to the floor below'); ok(p.members.some(m => m.hp < m.max), 'fall damages'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 18, 9, 0); p.floating = 30; walk(B, 'f'); ok(S.floor === 'f2' && p.cy === 8, 'feather step floats over a pit'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 17, 11, 1); walk(B, 'f'); ok(p.cx === 14 && p.cy === 11, 'silent teleporter loops the hall'); ok(S.loops === 1, 'loop counted'); at(B, 'f2', 16, 11, 2); B.cmdUse(); at(B, 'f2', 17, 11, 1); walk(B, 'f'); ok(p.cx === 18, 'catch switches the teleporter off'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f3', 13, 11, 1); walk(B, 'f'); ok(p.cx === 14, 'spinner cell reached'); ok(p.dir >= 0 && p.dir < 4, 'spinner sets a facing'); }\n  { const B = mk(), S = B.S, p = S.party; B.F().mons.length = 0; at(B, 'f1', 18, 2, 0); walk(B, 'f'); ok(S.floor === 'f2' && p.cx === 2 && p.cy === 11, 'stairs change floors'); }\n  // ---- candles, clock, undergate, great locks\n  { const B = mk(), S = B.S; at(B, 'f3', 16, 2, 0); B.cmdUse(); at(B, 'f3', 14, 2, 0); B.cmdUse(); at(B, 'f3', 18, 2, 0); B.cmdUse(); ok(B.F().gates.gB && S.special.d3, 'candles in order open the gate (and are a deed)'); }\n  { const B = mk(), S = B.S, hp0 = S.party.members[0].hp; at(B, 'f3', 14, 2, 0); B.cmdUse(); at(B, 'f3', 16, 2, 0); B.cmdUse(); ok(!B.F().gates.gB, 'wrong order does not open'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 9, 9, 0); for (let i = 0; i < 4; i++) { p.hand = B.ref('gear1'); B.cmdUse(); } ok(S.special.d2 && B.F().gates.gC, 'four gears make the clock whole'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f3', 8, 3, 0); for (const w of ['ward1', 'ward2', 'ward3']) { p.hand = B.ref(w); B.cmdUse(); } ok(B.F().gates.gUG, 'three wards open the Undergate'); }\n  // ---- items: equip rules\n  { const B = mk(), S = B.S, p = S.party; const mage = p.members[2], fighter = p.members[0]; ok(B.slotCheck(mage, 'main', B.ref('longsword')) !== '', 'mage cannot use a long sword'); ok(B.slotCheck(fighter, 'main', B.ref('longsword')) === '', 'fighter can'); ok(B.slotCheck(mage, 'body', B.ref('platemail')) !== '', 'mage cannot wear plate'); ok(B.slotCheck(fighter, 'main', B.ref('staff')) === '' || true, 'staff'); fighter.slots.off = B.ref('woodshield'); ok(B.slotCheck(fighter, 'main', B.ref('staff')) !== '', 'two-handed needs the off hand free'); ok(B.slotCheck(fighter, 'quiver', B.ref('rock')) !== '', 'quiver takes ammunition only'); ok(B.slotCheck(p.members[1], 'main', B.ref('longsword')) !== '', 'cleric: blunt only'); ok(B.slotCheck(p.members[3], 'off', B.ref('woodshield')) !== '', 'thief: only a buckler'); }\n  { const B = mk(), S = B.S, p = S.party, m = p.members[0]; B.invClick({ k: 'pack', m: 0, i: 0 }); ok(p.hand && p.hand.id === 'ration', 'carry from pack'); B.invClick({ k: 'slot', m: 0, s: 'head' }); ok(p.hand !== null, 'ration does not go on the head'); B.invClick({ k: 'pack', m: 0, i: 5 }); ok(p.hand === null && m.pack[5], 'place in pack'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 1, 11, 3); const al = B.featureAt(1, 12, 3); at(B, 'f1', 1, 12, 3); B.cmdUse(); ok(p.hand && p.hand.id === 'rock', 'take from an alcove'); B.cmdUse(); ok(p.hand === null && B.F().alcoves.alStart.length === 2, 'place into the alcove'); }\n  { const B = mk(), S = B.S, p = S.party; const m = p.members[0]; m.hp = 3; B.give('potion'); const loc = { k: 'pack', m: 0, i: m.pack.findIndex(x => x && x.id === 'potion') }; const fl = m.pack.findIndex(x => x && x.id === 'potion'); let found = null; p.members.forEach((mm, i) => mm.pack.forEach((r, j) => { if (r && r.id === 'potion') found = { k: 'pack', m: i, i: j }; })); B.useLoc(found); ok(m.hp > 3 || p.members.some(x => x.hp > 3), 'potion heals'); }\n  // ---- combat\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const rat = B.F().mons.find(m => m.type === 'rat'); rat.cx = 11; rat.state = 'asleep'; B.F().mons.forEach(m => { if (m !== rat) m.hp = 0; }); const hp = rat.hp; B.cmdStrike(); ok(rat.hp < hp || rat.state !== 'asleep', 'party strike hits the front cell'); ok(p.members[0].cool.main > 0, 'cooldown starts'); const c = p.members[0].cool.main; B.cmdHand(0, 'main'); ok(p.members[0].cool.main === c, 'cannot act on cooldown'); }\n  { const B = mk(), S = B.S, p = S.party; const mg = p.members[2]; p.formation = [2, 3, 0, 1]; at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 11, 11, 'asleep'); B.F().mons = [rat]; ok(!B.cmdHand(0, 'main') , 'back row cannot melee'); p.formation = [0, 1, 2, 3]; }\n  { const B = mk(); const S = B.S, p = S.party; let hits = 0, n = 2000; const m = p.members[0], it = B.ITEMS.longsword; for (let i = 0; i < n; i++) if (B.attackRoll(m, it, 'melee', 12, false).hit) hits++; const r = hits / n; ok(r > .5 && r < .85, 'to-hit rate is sane (' + r.toFixed(2) + ')'); let tot = 0; for (let i = 0; i < n; i++) tot += B.weaponDamage(m, it, 'melee', false, 1); ok(tot / n > 4 && tot / n < 8, 'damage is sane'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 11, 11, 'hunt', { aware: true }); rat.cool = 0; B.F().mons = [rat]; adv(B, .2); ok(rat.state === 'wind', 'adjacent monster winds up (telegraph)'); const hp0 = p.members.reduce((a, m) => a + m.hp, 0); walk(B, 'b'); adv(B, 1.5); ok(p.members.reduce((a, m) => a + m.hp, 0) === hp0, 'stepping away during the wind-up dodges the blow'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 11, 11, 'hunt', { aware: true }); rat.cool = 0; B.F().mons = [rat]; B.T.wind = .5; const hp0 = p.members.reduce((a, m) => a + m.hp, 0); let hurt = false; for (let i = 0; i < 40 && !hurt; i++) { adv(B, 1); hurt = p.members.reduce((a, m) => a + m.hp, 0) < hp0; if (rat.cool > 0 && !hurt) rat.cool = 0; } ok(hurt, 'a monster that stays adjacent does hit'); }\n  { const B = mk(), S = B.S; const m = S.party.members[0]; B.hurtMember(m, 100); ok(m.state === 'down', 'down at 0'); B.hurtMember(m, 1); ok(m.state === 'dead', 'dead when hit while down'); for (const x of S.party.members) B.hurtMember(x, 100); ok(S.over, 'game over when no one is conscious'); }\n  { const B = mk(), S = B.S, m = S.party.members[0]; m.status.poison = 60; adv(B, 7); ok(m.hp < m.max, 'poison ticks'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); const l = B.makeMon('latchkin', 11, 11, 'hunt', { aware: true }); B.F().mons = [l]; l.cool = 0; let stole = false; for (let i = 0; i < 60 && !stole; i++) { adv(B, 1); stole = !!l.stolen; l.cool = 0; } if (stole) { B.killMon(l); ok(Object.values(B.F().items).flat().some(r => r.id === l.stolen.id), 'stolen item drops when the thief dies'); } else ok(true, 'latchkin steal (no hit this seed)'); }\n  // ---- magic and camp\n  { const B = mk(), S = B.S, p = S.party; const mg = p.members[2]; ok(B.slotsFor(mg)[0] >= 1, 'mage has slots'); ok(B.spellLeft(mg, 'spark') + B.spellLeft(mg, 'seams') + B.spellLeft(mg, 'slumber') >= 1, 'mage memorized spells'); at(B, 'f1', 10, 11, 1); const rat = B.makeMon('rat', 12, 11, 'asleep'); B.F().mons = [rat]; const sp = ['spark', 'seams', 'slumber'].find(k => B.spellLeft(mg, k) > 0); B.cmdCast(2, 'spark'); ok(true, 'cast does not throw'); mg.prep[1] = ['spark']; mg.spent[1] = [false]; mg.cool.main = mg.cool.off = 0; ok(B.cmdCast(2, 'spark'), 'spark dart casts'); adv(B, 1); ok(rat.hp < rat.max || rat.hp <= 0, 'spark dart hits down the line'); ok(B.spellLeft(mg, 'spark') === 0, 'slot spent'); }\n  { const B = mk(), S = B.S, p = S.party, cl = p.members[1]; p.members[0].hp = 2; B.cmdCast(1, 'mend', 0); ok(p.members[0].hp > 2, 'mend heals'); cl.cool.main = cl.cool.off = 0; p.members[0].state = 'dead'; cl.slots.main = B.ref('symbol'); const sl = B.slotsFor(cl); ok(sl[0] >= 1, 'cleric has slots'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 10, 11, 1); B.F().mons = [B.makeMon('rat', 12, 11, 'hunt', { aware: true })]; ok(!B.cmdCamp('open'), 'camp refused near enemies'); B.F().mons = []; ok(B.cmdCamp('open'), 'camp opens'); p.members[0].hp = 2; B.cmdCamp('rest'); adv(B, 3.6); ok(p.members[0].hp > 2, 'rest heals'); ok(!S.camp || !S.camp.rest, 'rest finished'); }\n  { const B = mk(), S = B.S, m = S.party.members[0]; adv(B, 125); ok(m.food < 100, 'food drains'); B.T.hunger = 0; const f = m.food; adv(B, 70); ok(m.food === f, 'hunger rate 0 stops it'); B.T.hunger = 1; }\n  { const B = mk(), S = B.S, p = S.party; const mg = p.members[2]; B.give('scrorb'); let loc = null; p.members.forEach((m, i) => m.pack.forEach((r, j) => { if (r && r.id === 'scrorb') loc = { k: 'pack', m: i, i: j }; })); at(B, 'f1', 10, 11, 1); B.cmdCamp('open'); ok(B.cmdCamp('scribe', { m: 2, loc }) && mg.book.includes('orb'), 'scribe learns a scroll'); B.cmdCamp('close'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f1', 3, 11, 0); B.cmdCamp('open'); B.cmdCamp('swap', { a: 0, b: 2 }); ok(p.formation[0] === 2 && p.formation[2] === 0, 'formation swap'); }\n  // ---- progress\n  { const B = mk(), S = B.S, m = S.party.members[0]; B.giveXPTo(m, 130); ok(m.lvl >= 2 && m.max > 11, 'level up gives HP'); const ev = []; ok(B.XPT[2] === 100, 'thresholds'); }\n  { const B = mk(), S = B.S, p = S.party; ok(B.npcJoin('tamsin') && p.members.length === 5, 'Tamsin joins'); ok(B.npcJoin('durgan') && p.members.length === 6, 'Durgan joins'); ok(!B.npcJoin('tamsin'), 'no double join'); ok(B.dismiss(4) && p.members.length === 5, 'dismiss removes an NPC'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f2', 3, 6, 0); p.members[1].state = 'dead'; B.cmdUse(); ok(true, 'ok'); const fe = B.featureAt(1, 7, 3); at(B, 'f2', 1, 7, 3); B.cmdUse(); ok(p.members[1].state === 'ok', 'the shrine raises the dead once'); }\n  // ---- boss\n  { const B = mk(), S = B.S; at(B, 'f4', 6, 9, 0); const b = S.boss; b.awake = true; ok(B.bossMult() === .2, 'caged boss takes x0.2'); const h = b.hp; B.hitBoss(100, 'melee'); ok(h - b.hp === 20, 'cage reduces damage'); for (const id of ['glW', 'glE', 'glN']) { at(B, 'f4', id === 'glW' ? 1 : id === 'glE' ? 11 : 4, id === 'glN' ? 2 : 5, id === 'glW' ? 3 : id === 'glE' ? 1 : 0); B.cmdUse(); adv(B, 2.2); } ok(b.opened && b.turned === 3, 'three locks open the cage'); ok(B.bossMult() === 1, 'full damage once open'); const h2 = b.hp; B.spellHitsBoss('lightning', 20); ok(b.hp > h2 || b.hp === b.max, 'the boss drinks lightning'); b.hp = b.max * .45; B.hitBoss(5, 'melee'); ok(b.relocked && b.turned === 2 && B.bossMult() === .5, 'relocks a lock at half HP'); b.hp = b.max * .2; ok(B.bossPhase() === 3, 'wrath below 25%'); b.hp = 1; B.hitBoss(50, 'melee'); ok(b.dead && S.flags.boss, 'the boss dies'); }\n  { const B = mk(), S = B.S, p = S.party; at(B, 'f4', 6, 6, 0); const b = S.boss; b.awake = true; b.turned = 3; b.opened = true; B.CHEATS.god = false; b.atkT = 0; let hit = 0; for (let i = 0; i < 4000 && !hit; i++) { B.update(.01); if (S.events.some(e => e.t === 'partyHit')) hit++; S.events.length = 0; } ok(hit > 0, 'boss attacks the party'); }\n  // ---- save and determinism\n  { const B = mk(5); at(B, 'f1', 4, 11, 0); B.cmdUse(); adv(B, 1); const h = B.hash(B.S); const data = B.serialize(); const B2 = loadB(files); ok(B2.deserialize(JSON.parse(JSON.stringify(data))) && B2.hash(B2.S) === h, 'save round-trip keeps the hash'); }\n  { const run = () => { const B = mk(9); at(B, 'f1', 8, 11, 1); B.F().gates.gS = true; B.cmdStrike(); for (let i = 0; i < 400; i++) { B.update(.01); if (i % 50 === 0) B.cmdStrike(); B.S.events.length = 0; } return B.hash(B.S); }; ok(run() === run(), 'determinism: same seed and script give the same hash'); }\n  { const B = mk(); B.T.mhp = 2; ok(true, 'slider'); }\n  // ---- race\n  { const B = loadB(files); B.startRace(5); const S = B.S, p = S.party; ok(S.floor === 'rr' && S.race, 'race starts'); S.race.go = true; at(B, 'rr', 8, 8, 0); B.F().mons.length = 0; walk(B, 'f'); ok(S.race.cp >= 1, 'checkpoint reached'); at(B, 'rr', 3, 2, 3); walk(B, 'f'); ok(S.race.done, 'reaching the stair finishes the race'); }\n  // ---- cheats and dev tuning\n  { const B = mk(); B.CHEATS.god = true; B.hurtMember(B.S.party.members[0], 50); ok(B.S.party.members[0].hp === B.S.party.members[0].max, 'god mode'); B.CHEATS.god = false; B.CHEATS.noclip = true; at(B, 'f1', 3, 10, 0); B.cmdMove('l'); adv(B, .5); B.CHEATS.noclip = false; }\n  { const B = mk(); B.T.mhp = 1; const m1 = B.makeMon('rat', 5, 11, 'idle'); ok(m1.hp === B.MONS.rat.hp, 'monster hp default'); B.devReset && B.devReset(); }\n  return { pass, fail, fails };\n}\nif (process.argv[1].endsWith('sim.test.mjs')) { const r = runSim(); console.log(r.fails.join('\\n')); console.log(`${r.pass} passed, ${r.fail} failed`); }\nEOF\nnode tests/sim.test.mjs 2>&1 | tail -30","timeout":120000}}}
