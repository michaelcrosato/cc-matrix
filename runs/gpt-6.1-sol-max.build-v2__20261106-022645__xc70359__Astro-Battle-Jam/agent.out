{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"sed -n '3670,3840p' vendor/engine/my-3d2dge.js\nsed -n '3048,3068p' vendor/engine/my-3d2dge.js\nsed -n '1025,1045p' vendor/engine/API-INDEX.md\nsed -n '1060,1095p' vendor/engine/API-INDEX.md\"","aggregated_output":"Input.prototype.sequence = function (steps, o = {}) {\n  const H = this._hist, n = steps.length; if (!H || !H.length || !n) return false;\n  const win = o.window === undefined ? .5 : o.window, last = H[H.length - 1], now = this.clock;\n  if (last.t !== now) return false;\n  const ok = (st, k) => { const h = H[k]; if (st.dirs && h._b !== st.b) return false; if (st.btn.length) return st.btn.every(a => h.pressed.includes(a)); return k === 0 || H[k - 1]._b !== h._b; };\n  const S = steps.map(_seqStep); let i = n - 1, k = H.length - 1; if (!ok(S[i], k)) return false;\n  if (S[i].dirs || !S[i - 1] || S[i - 1].btn.length) k--;   // (a button may land on the step its motion ends)\n  for (i--; i >= 0 && k >= 0; k--) { if (now - H[k].t > win) return false; if (ok(S[i], k)) i--; }\n  return i < 0;\n};\n/**\n * a fighter's move in numpad notation, mirrored by facing: input.motion('236', 'attack', { facing: hero.facing, window })\n * is a quarter circle forward and punch (down, down-forward, forward, attack: a fireball); '623' a dragon punch, '41236'\n * a half circle. facing: 1 (right, the default) or -1. button: an action, 'attack+kick', or none (the motion alone)\n */\nInput.prototype.motion = function (digits, button, o = {}) {\n  const fw = (o.facing || 1) < 0 ? 'left' : 'right', bk = fw === 'left' ? 'right' : 'left';\n  const D = { 1: 'down+' + bk, 2: 'down', 3: 'down+' + fw, 4: bk, 5: 'neutral', 6: fw, 7: 'up+' + bk, 8: 'up', 9: 'up+' + fw };\n  const steps = String(digits).split('').map(c => D[c]).filter(Boolean);\n  if (button) steps.push(button);\n  return this.sequence(steps, Object.assign({ window: .45 }, o));\n};\n\n/* =============================================================================\n * 10i. CAMERA WINDOW AND FRAMING  game.cam.window (a dead zone), cam.snapY (height on landing), cam.frame(targets)\n *    (several things kept in view): where the camera aims, from where it would aim (tx, ty: its top-left corner, in\n *    projected pixels). Game's _camStep asks it while one of them is set\n * ============================================================================= */\n// where the camera aims: framed between its targets (zooming to fit), its height held until a landing, kept still while\n// the focus stays in the window\nGame.prototype._camAim = function (tx, ty) {\n  const c = this.cam, W = this.screen.W, H = this.screen.H, fr = this._framed;\n  if (fr) {\n    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n    for (const t of fr.list) { if (!t) continue; const [px2, py2] = this.view.p(t.x || 0, t.y || 0, t.z || 0); x0 = Math.min(x0, px2); x1 = Math.max(x1, px2); y0 = Math.min(y0, py2 - 16); y1 = Math.max(y1, py2); }\n    if (x1 >= x0) {\n      tx = (x0 + x1 - W) / 2; ty = (y0 + y1 - H) / 2;\n      const Z = fr.zoom; if (Z) {   // out at once when they don't fit, back in once they would fit well\n        const k = Math.min((W - 2 * fr.margin) / Math.max(1, x1 - x0), (H - 2 * fr.margin) / Math.max(1, y1 - y0)), z = this._zoomBase;\n        const want = clamp(Math.floor(z * Math.min(k, 1.25) * 20) / 20, Z[0], Z[1]);\n        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\n      }\n    }\n  }\n  const f = this._follow;\n  if (c.snapY) { const t = f && f.target, lim = H * .3; if (c.snap || c._ly === undefined || !t || t.onGround !== false) c._ly = ty; else c._ly = clamp(c._ly, ty - lim, ty + lim); ty = c._ly; }\n  if (c.window) { const [ww, wh] = c.window; if (c.snap || c._wx === undefined) { c._wx = tx; c._wy = ty; } c._wx = clamp(c._wx, tx - ww / 2, tx + ww / 2); c._wy = clamp(c._wy, ty - (wh || 0) / 2, ty + (wh || 0) / 2); tx = c._wx; ty = c._wy; }\n  return [tx, ty];\n};\n\n/* =============================================================================\n * 10j. PLAYERS AND SPLIT SCREEN  two to four on one machine. game.players: game.input is player 1 (a game of one is\n *    unchanged), each other an input of its own, with game.input's API, its device and its bindings: a gamepad each, or\n *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\n *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n *    right half's start) on the keyboard, player 1 then playing on its left half; game.removePlayer(p). Each has player (its\n *    number), name ('P2') and color. A pause says who paused, a lost controller names its player, the Controls screen\n *    has a page each. game.splitScreen(n, { layout, follow }): two to four viewports, each its own camera (viewport.follow,\n *    viewport.focus), the scene drawn once in each (r.viewport says which: { i, x, y, w, h }) and scene.hud(r) once over\n *    the whole screen; GPU lighting off while split. A scene's start ends a split.\n * ============================================================================= */\nconst KEY_HALVES = {   // each half's moves, its buttons in order (the preset's other actions take them in turn) and its menu keys\n  left: { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], buttons: [['KeyF'], ['KeyG'], ['KeyH'], ['KeyR'], ['KeyT'], ['KeyY'], ['KeyV'], ['KeyB']], start: ['Digit1'], pause: ['Escape', 'Digit1'], confirm: ['KeyF'], cancel: ['KeyG'] },\n  right: { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], buttons: [['Period', 'Numpad1'], ['Slash', 'Numpad2'], ['Comma', 'Numpad3'], ['KeyL', 'Numpad4'], ['Semicolon', 'Numpad5'], ['Quote', 'Numpad6'], ['KeyK', 'Numpad7'], ['KeyM', 'Numpad8']],\n    start: ['Digit2', 'Enter', 'NumpadEnter'], pause: ['Digit2', 'Backspace'], confirm: ['Period', 'Enter', 'NumpadEnter'], cancel: ['Slash', 'Backspace'] }\n};\n/** a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons\n *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /).\n *  A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action\n *  a menu reads beside confirm would take confirm's F otherwise) */\nInput.halfKeys = (preset, side) => {\n  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, own = (P.halves && P.halves[side]) || {}, out = {};\n  let k = 0;\n  for (const a in P) if (Array.isArray(P[a])) out[a] = (own[a] || H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\n  return out;\n};\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player's input: the screen's sizes, no listeners of its own)\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nfunction _pClaim(game) {   // player 1 reads no pad another player holds; the keyboard's codes go to the players sharing it\n  const P = game.players, I = P[0];\n  I._claimed = new Set(P.slice(1).filter(q => typeof q.pad === 'number').map(q => q.pad));\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n  if (!I.keysTo.length) I.keysTo = null;\n}\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\nGame.prototype.allowJoin = function (o = {}) {\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\n  this._lobby = this._join.keys && this.screen.canvas ? new Input(_pStub(this), { join: ['Digit2'] }) : null;   // (listens for 2 while player 1 has the whole keyboard)\n  _pClaim(this); return this;\n};\n/** a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the\n *  left). Returns its input (null when four play already) */\nGame.prototype.addPlayer = function (o = {}) {\n  const P = this.players; if (P.length >= 4) return null;\n  const q = new Input(_pStub(this), Input.DEFAULT), n = P.length + 1;\n  Object.assign(q, { player: n, name: 'P' + n, color: E.PLAYER_COLORS[n - 1], pad: typeof o.pad === 'number' ? o.pad : null, half: o.keys ? 'right' : null, device: o.keys ? 'keyboard' : 'gamepad' });\n  for (const k of ['glyphs', 'deadzone', 'invertAimY', 'invertMoveX', 'invertMoveY', 'rumbleScale']) q[k] = this.input[k];   // (the player's settings: button symbols, dead zone, aim, the move stick, vibration)\n  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\n  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n  q.use(_pPreset(this, q));\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\n  P.push(q); _pClaim(this);\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n  this.note(q.name + ' JOINED', 1.5); this.audio.sfx('confirm');\n  return q;\n};\n/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\nGame.prototype.removePlayer = function (p) {\n  const P = this.players, i = typeof p === 'number' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = 'P' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\n  _pClaim(this);\n};\n/** split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide\n *  screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 } */\nGame.prototype.splitScreen = function (n, o = {}) {\n  if (!(n >= 2)) { this._split = null; return this; }\n  const prev = this._split, vps = Array.from({ length: Math.min(4, n) }, (_, i) => (prev && prev.vps[i]) || _vp(i));\n  this._split = { layout: o.layout || 'auto', gap: o.gap === undefined ? 1 : o.gap, vps };\n  if (o.follow) o.follow.forEach((t, i) => vps[i] && vps[i].follow(t, o));\n  _vpLayout(this); return this;\n};\n// a viewport: where it is on the screen, and its camera (as game.cam: a focus it eases to, the bounds of game.cam)\nfunction _vp(i) {\n  const v = { i, x: 0, y: 0, w: 0, h: 0, target: null, z: 16, cam: { tx: 0, ty: 0, tz: 0, x: undefined, y: 0, vx: 0, vy: 0, smooth: .12, snap: true, bounds: null } };\n  /** look at a world point */\n  v.focus = (x, y, z = 0) => { v.target = null; Object.assign(v.cam, { tx: x, ty: y, tz: z }); };\n  /** keep the camera on an object ({ x, y, z }); o.z: the height looked at (16) */\n  v.follow = (t, o = {}) => { v.target = t || null; if (o.z !== undefined) v.z = o.z; v.cam.snap = true; };\n  return v;\n}\nfunction _vpLayout(game) {\n  const S = game._split, n = S.vps.length, W = game.screen.W, H = game.screen.H, g = S.gap;\n  const mode = S.layout === 'auto' ? (n > 2 ? 'grid' : W >= H ? 'columns' : 'rows') : S.layout;\n  S.vps.forEach((v, i) => {\n    const [c, r, cols, rows] = mode === 'grid' ? [i % 2, Math.floor(i / 2), 2, 2] : mode === 'rows' ? [0, i, 1, n] : [i, 0, n, 1];\n    const x0 = Math.round(c * W / cols), x1 = Math.round((c + 1) * W / cols), y0 = Math.round(r * H / rows), y1 = Math.round((r + 1) * H / rows);\n    Object.assign(v, { x: x0 + (c ? g : 0), y: y0 + (r ? g : 0), w: x1 - x0 - (c ? g : 0), h: y1 - y0 - (r ? g : 0) });\n  });\n}\nfunction _vpCam(game, v, dt) {   // (game.cam's rules in the viewport's size: centred on its focus, inside the bounds, eased)\n  const c = v.cam, t = v.target; if (t) { c.tx = t.x; c.ty = t.y || 0; c.tz = (t.z || 0) + v.z; }\n  const [sx, sy] = game.view.p(c.tx, c.ty, c.tz), bf = c.bounds || game.cam.bounds, b = bf && bf(game.view);\n  let tx = sx - v.w / 2, ty = sy - v.h / 2;\n  if (b) { tx = b.x1 - b.x0 < v.w ? (b.x0 + b.x1 - v.w) / 2 : clamp(tx, b.x0, b.x1 - v.w); ty = b.y1 - b.y0 < v.h ? (b.y0 + b.y1 - v.h) / 2 : clamp(ty, b.y0, b.y1 - v.h); }\n  if (c.snap || c.x === undefined || !(c.smooth > 0)) { c.x = tx; c.y = ty; c.vx = c.vy = 0; c.snap = false; return; }\n  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\n}\n// each step: the other players' inputs, a pause by any of them, a lost controller, and joining\nHOOKS.input.push((game, dt) => {\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\n  for (const q of P.slice(1)) {\n    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\n  }\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n  if (I.pressed('pause')) game.pausedBy = 1;\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === 'gamepad' && was[1] === p.index)) continue;\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\n    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host's)\n    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\n    game.addPlayer({ pad: p.index });\n  }\n  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\'t. 60: every other refresh on a 120 Hz screen. Full: every refresh' },\n  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\'s refresh and a frame\\'s cost' },\n  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\n  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\'s rows. CRT: those, its colored stripes and its darker corners', apply: (g, v) => { g.screen.filter = v; } },\n  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\n  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\n  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\n  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n  bindings: { group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { g.input.bindings = v; } },\n  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { for (const q of g._players || [g.input]) q.deadzone = v; } },\n  invertY: { group: 'Controller', label: 'Invert aim up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertAimY = !!v; } },\n  invertMoveX: { group: 'Controller', label: 'Invert move left and right', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveX = !!v; } },\n  invertMoveY: { group: 'Controller', label: 'Invert move up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveY = !!v; } },\n  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { for (const q of g._players || [g.input]) q.glyphs = v; } },\n  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { for (const q of g._players || [g.input]) q.rumbleScale = v; } },\n  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\n- `suspicion.decay = .3`, `suspicion.rise = 1.5` †: per second\n- `suspicion.forget = 6` †: seconds an alert guard searches after losing the target\n- `suspicion.last = null` †: where it last saw or heard the target ({ x, y, z }), or null\n- `suspicion.level = 0` †: 0..1.2, how suspicious\n- `suspicion.since = 0` †: seconds since it last saw or heard anything\n- `suspicion.state = 'calm'` †: 'calm' | 'notice' | 'search' | 'alert'\n- `E.hears(lis, noise, map)`: how loud a noise ({ x, y, z, loud: its radius in world units, 80 }) is where listener stands: 1 at the noise, 0 at its radius and beyond, halved when a top of map stands between them (a wall muffles it)\n- `E.sees(obs, tgt, o = {})`: can observer see target? { seen, d (ground distance), angle (observer -> target), exposure: 0..1 }. The target must be within range and inside the cone fov wide (radians) about the observer's facing; exposure is the share of three points on it (its feet, its chest, its head) that the observer's eyes see past every top of o.map, times the target's own exposure (default 1) and .6 when it crouches (it also shows lower). o: { range: 120, fov: 1.6, facing, map, eye }\n\n## 18. Bullets\n\n- `new E.Bullets(game, o = {}) → shots`: new E.Bullets(game, { plane: 'ground' | 'side', max: 800, sparks: true }); game: its game\n- `shots.burst(base, vels)`: fire several at once from a pattern list of [vx, v2] (v2 = vy on the ground plane, vz in side view)\n- `shots.clear(team)`: remove every bullet, or only one team's\n- `shots.draw(r)`: queue them for drawing (glowing cores, or their sprites)\n- `shots.fire(b)`: fire one bullet. Fields: x, y, z, vx, vy, vz, r, dmg, life, team, color, core, sprite, pierce, grav, data\n- `shots.hit(targets, fn, team)`: test bullets of `team` against targets (objects with x, y, z and r, or w/h in side view). fn(bullet, target). Returns hits\n- `shots.update(dt, map)`: move them one step; with a map they stop at walls (a TileMap, or a PlatformMap in side views)\n- `shots.list = []`: the live bullets\n- `shots.max`: at most this many at once\n- `shots.plane`: 'ground' (they fly over x and y) or 'side' (x and z)\n- `grid.near(x, y, r, fn)`: call fn(o) for everything in the cells touching the circle (check the exact distance yourself)\n- `grid.query(x, y, r)`: what lies within about r of (x, y), as a list (near() calls a function instead)\n- `grid.cell`: new E.SpatialHash(cell = 32): buckets things by position, to find what is near cheaply. cell: the bucket size in world units; map: the buckets\n\n## 20. Audio\n\n- `E.note(n)`: note name -> frequency: E.note('A4') = 440, E.note('C#5'), E.note('Bb2'). Numbers pass through\n- `E.songs: title, adventure, dungeon, boss, victory`: ready-made chiptune loops (original compositions). game.audio.music('adventure')\n- `game.audio.applyVolume()`: apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it)\n- `game.audio.at(step, fn)` †: call fn(step) on the update step the music reaches step (counted from its start, on as it loops); the song's change cancels it. Returns { cancel() }\n- `game.audio.bus(name = 'sfx')`: a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument) to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio)\n- `game.audio.calibrate()` †: the audio offset's calibration: a click on each beat (100 bpm, the first of a bar higher) as the music; tap(time) on each one heard (an event's timeStamp, or nothing: this update step). After 8 taps, result is the offset to set (ms: settings.audioOffset) and done is true; taps go on refining it. stop() puts the music back\n- `game.audio.define(name, voice)`: add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 })\n- `game.audio.duck(on = true)`: quiet the music (to 35%) while on: under a game's own pause, map or dialog screen. The engine also ducks it while game.paused\n- `game.audio.instrument(name, fn)` †: an instrument of the game's own: fn(ctx, bus, time, freq, dur, vol) makes a note's sound (Web Audio, into bus, from time); its name is a wave a music track (wave: 'pluck') or a voice takes\n- `game.audio.layer(track, vol = 1, fade = .5)` †: a track's volume as the song plays, 0..1, faded over fade seconds: layers of one song (the chase's drums in when the guards see you, out when they lose you). track: its index in song.tracks, or its name\n- `game.audio.music(song, o = {})`: Loop a song (or play once with { loop: false }). song = { bpm: 120, steps: 4, tracks: [ { wave: 'square', vol: .2, notes: 'C5 - E5 - G5 - . . | ...' }, one token per step { wave: 'triangle', notes: 'C3 . C3 . G2 . G2 .' }, { wave: 'drums', notes: 'k . h . s . h . k k h . s . h .' } ] } tokens: C4 F#3 Bb2 = note, '-' holds the previous note, '.' = rest, '|' is ignored (bar lines). steps = steps per beat (4 = sixteenth notes). Each track loops on its own length within the song's (len: steps, else its longest track's); a track may have a name, and on: false starts it silent (a layer that audio.layer brings in). THE MUSIC CLOCK: a song starts at the game's time and where it is is game time (audio.pos, headless too: the same steps hear the same beats); the sound follows that clock. o: { loop, sync: true (it pauses with the game, on game.time; else it plays on through a pause, on game.real), fade: seconds (a crossfade from the song playing), restart: true (again from its start, though it is the one playing) }. E.songs has ready-made loops: title, adventure, dungeon, boss, victory.\n- `game.audio.mute(on = !this.muted)`: toggle (or set) mute; returns the new state\n- `game.audio.onBeat(fn)` †: call fn(beat, pos) on the update step of each beat of whatever music plays (a dancer's step, a light's pulse). Returns { cancel() }\n- `game.audio.pos` †: where the music is, on the game's clock (headless too): { t: seconds since it started, step (from 0, counting on as it loops), beat, bar (four beats), at (the step in its loop), loop (times round), bpm, layers (each track's volume), playing }\n- `game.audio.ready`: true once the browser lets the game make sound\n- `game.audio.setVolume(v)`: set the master volume, 0..1\n- `game.audio.sfx(what, o = {})`: Play a sound effect: a preset name ('jump', 'coin', 'hit', 'explode', ...), a voice object, or a list of voices. opts: { vol: 0..1, pitch: multiplier, vary: random pitch spread (default 0.03), step: a step of the music playing (it sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left) .. 1 (right), loop: true (it sounds on until stopped: an engine, rain; through the effects' bus, so it follows the volume and the mute) }. Returns its handle: { stop(fade .03), set({ pan, vol }), playing, pan }: a handle that does nothing when nothing plays (headless, before the first key, an unknown name)\n- `game.audio.sting(song, o = {})` †: play a short song once over the music (a goal's jingle): o.at 'now', 'beat' or 'bar' (on the music's next beat or bar), o.duck (the music's volume under it, .4)\n- `game.audio.stopMusic(fade)`: stop the music (it fades out over fade seconds, .06 by default)\n- `game.audio.tempo(bpm)` †: change the music's tempo as it plays (hurry up!): where it is stays, the steps after come at the new bpm\n- `game.audio.anchors = 0` †: how many times the sound was moved to meet the clock\n- `game.audio.ctx = null`: the Web Audio context, made at the first sound (null before, or where there is none)\n- `game.audio.drift = 0` †: what is heard against the game's clock at the last frame (seconds: the sound follows the clock, so it stays near 0)\n- `game.audio.ducked = false`: true while duck(true) holds the music down\n- `game.audio.failed = null`: why there is no sound (a message), or null\n- `game.audio.musicVolume = .5`, `game.audio.sfxVolume = 1`, `game.audio.voiceVolume = 1`: 0..1 for effects, music and the voice bus (bus('voice'))\n- `game.audio.muted = false`: true while mute() is on\n- `game.audio.offset = 0` †: seconds the music sounds early, for speakers and headphones that lag (settings.audioOffset)\n- `game.audio.presets`: the named sound effects, sfx(name) plays one and define(name, voice) adds one\n- `game.audio.song = null`: the music playing (null for none)\n","exit_code":0,"status":"completed"}}
