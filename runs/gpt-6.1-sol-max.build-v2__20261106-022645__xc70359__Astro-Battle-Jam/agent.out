{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"sed -n '7826,7855p' vendor/engine/my-3d2dge.js\nrg -n 'class Screen|headless|res' vendor/engine/my-3d2dge.js | head -12\nsed -n '207,255p' vendor/engine/API-INDEX.md\"","aggregated_output":"    }\n    g.connect(bus); if (!loop) src.stop(end + .05);\n    return lfo ? [src, lfo] : [src];\n  }\n  /**\n   * Play a sound effect: a preset name ('jump', 'coin', 'hit', 'explode', ...), a voice object, or a list of voices.\n   * opts: { vol: 0..1, pitch: multiplier, vary: random pitch spread (default 0.03), step: a step of the music playing (it\n   * sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left)\n   * .. 1 (right), loop: true (it sounds on until stopped: an engine, rain; through the effects' bus, so it follows the\n   * volume and the mute) }. Returns its handle: { stop(fade .03), set({ pan, vol }), playing, pan }: a handle that does\n   * nothing when nothing plays (headless, before the first key, an unknown name)\n   */\n  sfx(what, o = {}) {\n    const H = { playing: false, pan: clamp(o.pan || 0, -1, 1), stop() {}, set() { return H; } };\n    if (!this._init() || (this.muted && !o.loop)) return H;\n    const p = typeof what === 'string' ? this.presets[what] : what;\n    if (!p) { warn('sfx:' + what, 'unknown sound \"' + what + '\". Presets: ' + Object.keys(this.presets).join(', ') + ' (or audio.define(name, voice))'); return H; }\n    if (this.ctx.state !== 'running') return H;\n    const c = this.ctx, now = c.currentTime;\n    if (typeof what === 'string' && !o.loop) { if (now - (this._last[what] === undefined ? -1 : this._last[what]) < .035) return H; this._last[what] = now; }\n    const mul = (o.pitch || 1) * (1 + (o.vary === undefined ? .03 : o.vary) * (this._rnd() * 2 - 1));\n    const C = this.song, at = o.step !== undefined && C && C.anchor ? Math.max(now + .005, C.anchor.ctx + (this._timeOf(C, o.step) - C.anchor.clk) - this.offset) : now + .005;\n    const live = o.loop || o.pan !== undefined, out = live ? c.createGain() : null, pan = out && c.createStereoPanner ? c.createStereoPanner() : null, srcs = [];   // (a looped or panned one: its own gain and pan before the bus)\n    if (out) { if (pan) { pan.pan.value = H.pan; out.connect(pan); pan.connect(this._sfxBus); } else out.connect(this._sfxBus); }\n    try { for (const v of Array.isArray(p) ? p : [p]) srcs.push(...this._voice(o.vol === undefined ? v : Object.assign({}, v, { vol: (v.vol === undefined ? .3 : v.vol) * o.vol }), out || this._sfxBus, at, mul, !!o.loop)); }\n    catch (e) { warn('sfx-fail:' + what, 'could not play sound \"' + what + '\": ' + e.message); return H; }\n    H.playing = true;\n    H.stop = (fade = .03) => { if (!H.playing) return; H.playing = false; const t = c.currentTime; if (out) out.gain.setTargetAtTime(0, t, Math.max(.001, fade / 3)); for (const s of srcs) try { s.stop(t + (out ? fade + .05 : 0)); } catch (e) { /* stopped already */ } };\n    H.set = q => { const t = c.currentTime; if (q.pan !== undefined && pan) { H.pan = clamp(q.pan, -1, 1); pan.pan.setTargetAtTime(H.pan, t, .02); } if (q.vol !== undefined && out) out.gain.setTargetAtTime(Math.max(0, q.vol), t, .02); return H; };\n    return H;\n25: *      -> sorted queue (walls, props, actors, particles) -> lighting -> overlays -> present\n41: *    interface (title, pause, settings, help, results, map screens and a HUD with a minimap) from data: new E.Shell(game,\n51: *    metal), r.prop('torch', ...) set dressing, particles.explosion / smoke / fire,\n58: *    plays it back headless, exactly, and stops where it differs (game.stateHash = () => [...] sharpens that).\n59: * 11. TESTS. new E.Game({ headless: true }) (the default in Node) runs with no screen: game.advance(1) runs 120 fixed\n61: *    your game's handle for tests and tools; game.stop(), start() and dispose() stop, resume and end it.\n66: *    template game with a headless test.\n101: *  than Penner's: 1.9), and the rest of Penner's set (sine, quad, cubic, back, elastic and bounce, each in, out and\n133:/** the 4 x 4 ordered-dither threshold 0..1 at pixel (x, y): pixel on when value > bayer(x, y) */\n169:/** a new canvas of w x h pixels (scratch images and sprite sheets). With no document (Node: a headless game) a stand-in\n274: * the things in list that `from` can reach, nearest first, each as { target, d (ground distance), dz, angle (from -> it) }:\n329: * 1b. MORE EASINGS  the rest of Penner's set, beside the core's (E.ease): in a section of its own, so a kit whose game eases\n- `px.polyDither(g, pts, c, a, wx = 0, wy = 0)`: translucent polygon: a = 0..1 opacity (stepped alpha, or a dither pattern in 'dither' style). wx/wy = world pixel offset for the pattern\n- `px.rect(g, x, y, w, h, c)`: a filled rectangle, snapped to whole pixels\n- `px.reset(g)`: forget the color cache (after drawing on g with the canvas API directly)\n- `px.sprite(g, spr, x, y, flip = false)`: draw a sprite with its top-left corner at buffer pixel (x, y). flip mirrors it left-right; or o: { flip, rot (radians, turned about its center: E.rotSprite), steps, scale (nearest-neighbour) }\n- `E.sprite(rows, colors = {}, scale = 1)`: Pixel sprite written as strings. Each character is one pixel; colors maps a character to a hex color; '.' and ' ' are transparent. scale (whole number) enlarges each pixel. const COIN = E.sprite(['.yy.', 'yYYy', 'yYYy', '.yy.'], { y: '#f0b020', Y: '#fff0a0' }); Draw it with r.sprite(x, y, z, COIN) (depth sorted) or px.sprite(g, COIN, sx, sy).\n- `E.style: trans`: Translucency style. 'alpha' (default, PS1 / N64 / SNES color math): real transparency in 1/8 steps, plus blend modes. 'dither' (NES, Game Boy, Genesis look): ordered-dither patterns. Set E.style.trans = 'dither' for the older look.\n\n## 2b. Sprite frames, turns and swaps\n\n- `E.anim(frames, fps = 8, o = {})` †: frames to play: anim([spr1, spr2, spr3], fps = 8, { loop: true, pingpong: false }), or anim(sheet, 8, { frames: 4 }) for several frames side by side in one sprite's rows. Draw it with r.sprite(x, y, z, a, { t }) (t: its clock, seconds; the game's time by default); a.frame(t) is the sprite at time t, a.index(t) its number, a.duration one play (seconds)\n- `E.recolor(spr, map)` †: a copy of a sprite with its colors swapped (palette swaps: the second player, a hurt flash, a stronger enemy): recolor(spr, { '#3a8a4a': '#8a3a4a', h: '#e0b040' }), each key a color or one of the sprite's own characters\n- `E.rotSprite(spr, a, steps = 16)` †: the sprite turned by angle a (radians; the way the world's angles turn, so a ship drawn facing east turns to its facing): nearest-neighbour, whole pixels, about its center, in `steps` steps a turn (16; 32 for a smoother one) and cached, as games of the era pre-rotated theirs. r.sprite's and px.sprite's rot option use it\n\n## 3. Views (projections)\n\n- `E.VIEWS: iso, threequarter, topdown, brawler, side, overhead`: the ready-made views: iso (yaw 45, pitch 30), threequarter (pitch 55), topdown (80), brawler (25), side (0) and overhead (90, scale 1: world x/y = screen pixels); new E.Game({ view: 'iso' }) and game.setView('side') take their names\n- `E.VIEW_ORDER: iso, threequarter, topdown, brawler, side`: the order game.nextView() cycles through when a game doesn't set game.views ('overhead' is left out)\n- `new E.View(id, label, yaw, pitch, scale = 1, zBoost = 1) → view`: new E.View(id, label, yaw, pitch, scale, zBoost): an orthographic camera (degrees; scale = screen pixels per world unit; zBoost stretches heights)\n- `view.depth(x, y, z = 0)`: true camera depth: use it to sort parts inside one object\n- `view.order(x, y, z = 0)`: painter's order for whole objects standing on the ground\n- `view.p(x, y, z = 0)`: world -> projected screen pixels (not yet camera-relative)\n- `view.screenDirToGround(dx, dy)`: a direction the player pushed on screen (x right, y down) -> normalized ground direction\n- `view.set(yaw, pitch, scale = 1, zBoost = 1)`: change the angles and scale in place (game.setView and rotateView use their own copies); returns the view\n- `view.toGround(sx, sy)`: projected screen point -> ground point (z = 0). null in side view\n- `view.ax`, `view.ay`: screen x = ax * x + ay * y (the projection's first row)\n- `view.bx`, `view.by`, `view.bz`: screen y = bx * x + by * y + bz * z (the second row; bz < 0 lifts things up the screen)\n- `view.dx`, `view.dy`, `view.dz`: the direction toward the camera, for true depth (view.depth)\n- `view.fx`, `view.fy`: the ground direction that points at the camera (the front of a wall faces it)\n- `view.id`: its name ('iso', or yours)\n- `view.inv`: the inverse of the ground projection (screen -> ground at z 0), null in side views\n- `view.isSide`: a side view (pitch 1 or less: x right, z up, y is depth)\n- `view.isTop`: looking straight down (pitch 89 or more)\n- `view.label`: its name for people ('Isometric')\n- `view.pitch`, `view.yaw`: the same angles in radians\n- `view.pitchDeg`: the tilt, 0 side view to 90 straight down\n- `view.scale`: screen pixels per world unit\n- `view.yawDeg`: the turn about the up axis, degrees (0: north is up the screen; iso is 45)\n- `view.zBoost`: how much heights are stretched on screen (1 = true)\n- `E.charView(view)`: the view a rig in `view` is drawn from (the sprite-like angle above; the view itself outside pitch 40-89)\n\n## 4. Screen\n\n- `E.RES: nes, snes, gb, gbc, gba, genesis, md, pce, n64, ps1, wide`: classic console resolutions for new Game({ res: 'snes' }) (width x height in pixels)\n- `game.screen.clear` †: true when the game's bg is null (or 'transparent'): the buffer and the canvas are cleared instead of filled, so a picture under the canvas shows through the game's (a 3D world drawn by engine/my-3d2dge-3d.js)\n- `game.screen.clientToScreen(cx, cy)`: browser client coords -> projected screen pixels (same space as view.p)\n- `game.screen.resize()`: fit the buffer to the canvas again (on window resize; after changing sizing options, setOptions does it)\n- `game.screen.setOptions(o)`: change sizing at runtime, e.g. { minH: 400, maxW: 1080, maxH: 660 } to pull the camera back\n- `game.screen.setScale(v)`: how a fixed resolution fills the screen: 'sharp' | 'fill' | 'auto' (see scale)\n- `game.screen.H = 200`, `game.screen.W = 320`: the buffer's size in game pixels\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"cat > tests/engine.mjs <<'EOF'\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport crypto from 'node:crypto';\nimport assert from 'node:assert/strict';\nconst warnings = [], failures = [], evidence = []; let count = 0;\nfunction load() {\n  const ctx = { console: { log() {}, warn: s => warnings.push(s), error: s => warnings.push(s) }, TextEncoder, location: { hash: '', pathname: '/test' } };\n  vm.createContext(ctx);\n  const f = fs.readFileSync(new URL('../index.html', import.meta.url), 'utf8');\n  const scripts = [...f.matchAll(/<script>([\\\\s\\\\S]*?)<\\\\/script>/g)].map(m => m[1]);\n  for (let i = 0; i < scripts.length; i++) vm.runInContext(scripts[i], ctx, { filename: 'export-script-' + i });\n  return ctx.__game;\n}\nfunction test(name, fn) { count++; try { fn(); } catch (e) { failures.push({ name, error: e.stack }); } }\nconst C = load(), { game, app, A } = C;\nconst advance = (n = .1, draw = false) => game.advance(n, { draw });\nconst press = action => { game.input.tap(action); advance(.1); };\nadvance(.1, true);\ntest('Actual export embeds pristine Hub first, then full pinned engine and game', () => {\n  const html = fs.readFileSync(new URL('../index.html', import.meta.url), 'utf8');\n  const first = html.match(/<meta charset=\\\"utf-8\\\"><script>\\\\n([\\\\s\\\\S]*?)<\\\\/script>/)[1];\n  assert.equal(first, fs.readFileSync(new URL('../vendor/hub/session.js', import.meta.url), 'utf8'));\n  assert(html.includes('hub:session-players\\\" content=\\\"1-2\\\"')); assert.equal(C.game.view.id, 'overhead');\n  const engine = fs.readFileSync(new URL('../vendor/engine/my-3d2dge.js', import.meta.url));\n  evidence.push({ engineSHA256: crypto.createHash('sha256').update(engine).digest('hex'), hubSHA256: crypto.createHash('sha256').update(first).digest('hex') });\n});\ntest('Title geometry exists before any draw and confirm is debounced', () => {\n  assert(app.rows.length === 6); game.input.hold('confirm'); advance(.5); assert.equal(app.screen, 'lobby'); advance(.5); assert.equal(app.screen, 'lobby'); game.input.hold('confirm', false); advance(.05);\n});\ntest('Keyboard menu path goes from solo lobby through controls into normal play', () => { press('down'); press('confirm'); assert.equal(app.screen, 'controls'); press('confirm'); assert.equal(app.screen, 'play'); assert.equal(app.sim.s.assisted, false); });\ntest('Native fixed update drives an ordinary standard campaign to victory', () => {\n  let loops = 0, encounters = new Set();\n  while (app.screen === 'play' && loops++ < 40000) {\n    const s = app.sim.s; game.debug.command(0, A.pilot(s, 0));\n    const scene = s.encounter + ':' + (s.boss?.phase || 0);\n    const first = \"'!encounters.has(scene); encounters.add(scene); advance(1 / 30, first);\n  }\n  assert.equal(app.sim.s.phase, '\"'victory'); assert.equal(app.screen, 'results'); assert.equal(app.sim.s.assisted, false); assert.equal(app.sim.s.dev.invulnerable, false); assert.equal(encounters.size, 8); assert.equal(game.errors.length, 0, JSON.stringify(game.errors)); evidence.push({ nativeCampaignSeconds: app.sim.s.tick / 120, score: app.sim.s.score, encounters: [...encounters] });\n});\ntest('Results support immediate replay and reset run ownership', () => { app.timeScale = 0; app.diagnostics = true; press('confirm'); assert.equal(app.screen, 'play'); assert.equal(app.sim.s.encounter, 0); assert.equal(app.sim.s.assisted, false); assert.equal(app.timeScale, 1); assert.equal(app.diagnostics, false); assert.equal(app.sim.s.score, 0); assert.equal(app.sim.s.reserve, 2); });\ntest('Pause freezes combat but menus remain controllable', () => { press('pause'); assert.equal(app.screen, 'pause'); const tick = app.sim.s.tick; advance(.5); assert.equal(app.sim.s.tick, tick); press('down'); assert.equal(app.focus, 1); press('cancel'); assert.equal(app.screen, 'play'); });\ntest('Every developer screen and native boss phase draw without errors', () => {\n  for (const name of ['pause', 'dev', 'encounters', 'resources', 'time', 'seed', 'balance0', 'balance1', 'balance2', 'settings', 'sound', 'comfort', 'records', 'about']) { game.debug.show(name); advance(.1, true); assert(app.rows.length > 0); }\n  for (let n = 0; n < 7; n++) { app.sim.startEncounter(n); app.screen = 'play'; advance(.1, true); }\n  app.sim.startEncounter(6, 2); advance(.1, true); assert.equal(game.errors.length, 0, JSON.stringify(game.errors));\n});\ntest('Every required source and feedback answer has a paged credits destination', () => {\n  game.debug.show('about'); const pages = game.debug.aboutPages(); const report = app.report;\n  assert.equal(pages.length, 1 + Object.keys(report.sourceInformation).length + 4 + 6 + 4);\n  for (let i = 0; i < pages.length; i++) { app.aboutPage = i; advance(.01, true); assert(pages[i].body); }\n  assert.equal(report.sourceInformation.usage, 'added on import');\n});\ntest('Attract starts at ten seconds and loops through all five scenes without persistent writes', () => {\n  game.debug.title(); const records = JSON.stringify(app.records), seed = app.seed;\n  advance(9.9); assert.equal(app.screen, 'title'); advance(.15); assert.equal(app.screen, 'attract');\n  const scenes = new Set(); for (let i = 0; i < 700; i++) { advance(.1, i % 130 === 0); scenes.add(app.demoScene); }\n  assert.equal(scenes.size, 5); assert.equal(JSON.stringify(app.records), records); assert.equal(app.seed, seed); assert.equal(game.errors.length, 0);\n});\ntest('Attract keyboard wake is consumed, title state is clean and next run is ordinary', () => { press('confirm'); assert.equal(app.screen, 'title'); assert.equal(app.sim, null); advance(.15); assert.equal(app.screen, 'title'); game.debug.start(); assert.equal(app.sim.s.score, 0); assert.equal(app.sim.s.tick, 0); assert.equal(app.sim.s.assisted, false); });\ntest('Music defaults and resets to exactly 10%, independent of stored preference', () => { game.settings.set('music', .7); assert.equal(game.settings.music, .7); game.settings.reset('Sound'); assert.equal(game.settings.music, .1); });\ntest('Interview and catalogue have the exact required shape and allowed values', () => {\n  const r = JSON.parse(fs.readFileSync(new URL('../../exit-interview.json', import.meta.url), 'utf8'));\n  assert.deepEqual(Object.keys(r), ['sourceInformation', 'testingFeedback', 'engineFeedback', 'promptFeedback', 'aiHub']);\n  assert.equal(r.testingFeedback.length, 4); assert.equal(r.engineFeedback.length, 6); assert.equal(r.promptFeedback.length, 4); assert.equal(Object.keys(r.sourceInformation).length, 15);\n  assert.equal(r.aiHub.name, A.TITLE); assert.equal(r.aiHub.genre, 'Shooter'); assert.equal(r.aiHub.type, 'Game'); assert(r.aiHub.tags.length >= 3 && r.aiHub.tags.length <= 6); assert(r.aiHub.tags.every(t => t === t.toLowerCase()));\n});\ntest('Native headless draw/update contain no runtime errors or engine warnings', () => { assert.equal(game.errors.length, 0); assert.equal(warnings.length, 0, warnings.join('\\\\n')); });\nfs.writeFileSync(new URL('../evidence/engine-tests.json', import.meta.url), JSON.stringify({ count, failures, evidence }, null, 2));\nfor (const f of failures) console.error('FAIL ' + f.name + ': ' + f.error);\nconsole.log(JSON.stringify({ suite: 'engine', count, failed: failures.length })); process.exitCode = failures.length ? 1 : 0;\nEOF\nnode tools/test.mjs engine\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
