d eight-column formations and four presets', () => { assert(A.validateContent()); assert.equal(A.WAVES.length, 6); assert.equal(A.DIFFICULTIES.length, 4); });\ntest('Seed and identical input reproduce every serializable field', () => { const a = fresh(), b = fresh(); for (let i = 0; i < 2400; i++) { const c = { 0: { move: i % 400 < 200 ? 1 : -1, fire: true, repair: i % 180 === 0 } }; a.step(c); b.step(c); } assert.equal(JSON.stringify(a.s), JSON.stringify(b.s)); });\ntest('Last survivor uses its living column bounds, accelerates and descends', () => { const q = fresh(), slow = q.marchInterval(); q.s.enemies = [q.s.enemies.find(e => e.col === 7 && e.row === 0)]; assert(q.marchInterval() < slow / 3); q.s.formation.x = 458 - 8 - 7 * 38; q.s.formation.dir = 1; run(q, .2); assert(q.s.formation.reversals > 0); assert(q.s.formation.y > 58); });\ntest('A living attacker reaching breach ends the defense', () => { const q = fresh(); q.s.formation.y = 218; run(q, 1); assert.equal(q.s.reason, 'BREACH'); });\ntest('Swept segment detects thin cells even over a long distance', () => { assert.equal(A.segmentBox(20, 200, 20, 50, 20, 100, 1.5, 1.5) \"'!== null, true); });\ntest('\"'Friendly first hit erodes cover and cannot damage an enemy behind it', () => { const q = fresh(), s = q.s, b = s.bunkers[0]; const x = b.x + 8 * 3 + 1.5; s.enemies = [{ id: 999, col: 0, row: 0, type: 'o', hp: 1, hit: 0, attack: 0 }]; s.formation.x = x; s.formation.y = 170; s.shots = [{ id: 1000, x, y: 225, vx: 0, vy: -12000, team: 0, owner: 0, kind: 'missile', life: 100 }]; const before = JSON.stringify(b.rows); q.resolveShots(); assert.notEqual(JSON.stringify(b.rows), before); assert.equal(s.enemies.length, 1); assert.equal(s.shots.length, 0); });\ntest('Bombs crater from above; broad bombs remove more cells', () => { const a = fresh(), b = fresh(); a.bunkerHit(a.s.bunkers[0], 80, 203, false, false); b.bunkerHit(b.s.bunkers[0], 80, 203, false, true); const cells = q => q.s.bunkers[0].rows.reduce((n, r) => n + r.toString(2).replace(/0/g, '').length, 0); assert(cells(b) < cells(a)); });\ntest('Intact cover refuses repair without spending; a destroyed footprint can rebuild around both barrels', () => { const q = fresh({ players: [0, 1] }), [p, p2] = q.s.ships, b = q.s.bunkers[0]; p.x = 78; p2.x = 89; const old = p.charges; assert.equal(q.repair(p), false); assert.equal(p.charges, old); b.rows.fill(0); assert.equal(q.repair(p), true); assert.equal(p.charges, old - 1); assert(b.rows.some(n => n)); for (let row = 0; row < 8; row++) for (let col = 0; col < 16; col++) { const x = b.x + col * 3 + 1.5; if (Math.abs(p.x - x) < 2.3 || Math.abs(p2.x - x) < 2.3) assert.equal(b.rows[row] & (1 << col), 0); } });\ntest('Repair target tie breaks stably and exposes a usable preview', () => { const q = fresh(), p = q.s.ships[0]; p.x = 133; q.s.bunkers[0].rows.fill(0); assert.equal(q.repairTarget(p).bunker, 0); assert(q.repairTarget(p).usable); });\ntest('Every fourth kill drops salvage; catches cap at three; expiry is finite', () => { const q = fresh(), p = q.s.ships[0]; for (let i = 0; i < 4; i++) q.hitEnemy(q.s.enemies.find(e => e.row === 3), 0); assert.equal(q.s.stats.drops, 1); p.charges = 2; q.s.pickups = [{ id: 888, x: p.x, y: p.y, life: 100 }]; q.pickups(); assert.equal(p.charges, 3); q.s.pickups = [{ id: 889, x: p.x, y: p.y, life: 1 }]; q.pickups(); assert.equal(p.charges, 3); assert.equal(q.s.pickups.length, 0); });\ntest('Solo deployment reserve is consumed once per protected respawn and extra only once', () => { const q = fresh(), p = q.s.ships[0]; p.shield = 0; q.killShip(p); q.killShip(p); assert.equal(q.s.reserve, 1); run(q, 1.01); assert(p.active && p.shield > 0); assert.equal(q.s.reserve, 1); assert.equal(q.s.phase, 'active'); q.addScore(p, 1000); assert.equal(q.s.reserve, 2); q.addScore(p, 2000); assert.equal(q.s.reserve, 2); });\ntest('Simultaneous co-op deaths remain pending; score extra can restore an exhausted spectator', () => { const q = fresh({ players: [3, 7] }); q.s.reserve = 1; for (const p of q.s.ships) { p.shield = 0; q.killShip(p); } q.step(); assert.notEqual(q.s.phase, 'defeat'); assert.equal(q.s.ships.filter(p => p.wait).length, 1); q.addScore(q.s.ships[0], 1000); assert.equal(q.s.ships.filter(p => p.wait).length, 2); assert.equal(q.s.reserve, 0); });\ntest('Empty reserves with no ship or pending deployment cause depletion defeat', () => { const q = fresh(); q.s.reserve = 0; q.s.ships[0].shield = 0; q.killShip(q.s.ships[0]); q.step(); assert.equal(q.s.reason, 'DEPLOYMENTS DEPLETED'); });\ntest('Each cannon holds at most two missiles', () => { const q = fresh(); run(q, 2, () => ({ 0: { fire: true } })); assert(q.s.shots.filter(b => b.team === 0).length <= 2); });\ntest('Armoured enemy breaks shell first and then awards its row value', () => { const q = fresh(); q.startEncounter(2); const e = q.s.enemies.find(e => e.type === 'A'); q.hitEnemy(e, 0); assert(q.s.enemies.includes(e)); assert.equal(e.hp, 1); assert.equal(q.s.score, 0); q.hitEnemy(e, 0); assert(\"'!q.s.enemies.includes(e)); assert.equal(q.s.score, (4 - e.row) * 10); });\ntest('\"'Saucer is harmless and predictable; bonus family and salvage are awarded', () => { const q = fresh(); q.s.nextSaucer = 1; q.step(); assert(q.s.saucer); assert.equal(q.s.shots.length, 0); const u = q.s.saucer; q.s.shots = [{ id: q.id(), x: u.x, y: 45, vx: 0, vy: -1000, team: 0, owner: 0, kind: 'missile', life: 100 }]; q.resolveShots(); assert.equal(q.s.score, 100); assert.equal(q.s.stats.drops, 2); });\ntest('Flagship armour windows, both emitters, core phase and victory', () => { const q = fresh(); q.startEncounter(6); q.s.boss.cycle = 450; q.hitBoss('left', 0); assert.equal(q.s.boss.left, 7); q.s.boss.cycle = 0; for (let i = 0; i < 7; i++) q.hitBoss('left', 0); for (let i = 0; i < 7; i++) q.hitBoss('right', 0); assert.equal(q.s.boss.phase, 2); for (let i = 0; i < q.s.boss.maxCore; i++) q.hitBoss('core', 0); assert.equal(q.s.phase, 'victory'); });\ntest('Location pair preserves damage; relocation visibly restores a baseline and removes spent threats', () => { const q = fresh(); q.s.encounter = 0; q.s.bunkers[0].rows.fill(0); q.s.enemies = []; q.step(); run(q, 2.5); assert.equal(q.s.encounter, 1); assert(q.s.bunkers[0].rows.every(x => x === 0)); q.s.phase = 'active'; q.s.enemies = []; q.step(); run(q, 4); assert.equal(q.s.encounter, 2); assert(q.s.bunkers[0].rows.some(x => x)); assert.equal(q.s.shots.length, 0); });\ntest('Departing seat consumes no resources and cannot fire or respawn', () => { const q = fresh({ players: [0, 1] }); const reserve = q.s.reserve; q.leave(1); run(q, 1, () => ({ 1: { fire: true } })); assert.equal(q.s.reserve, reserve); assert.equal(q.s.shots.filter(b => b.owner === 1).length, 0); assert(q.s.ships[1].gone); });\nfor (const players of [[0], [0, 1]]) test('Ordinary standard campaign completes with ' + players.length + ' seat(s)', () => {\n  const q = new Sim({ seed: 2037, difficulty: 1, players });\n  let ticks = 0;\n  while (ticks++ < 120 * 1100 && \"'!['\"'victory', 'defeat'].includes(q.s.phase)) {\n    const before = JSON.stringify(q.s);\n    const commands = Object.fromEntries(players.map(id => [id, A.pilot(q.s, id)]));\n    if (ticks === 1) assert.equal(JSON.stringify(q.s), before);\n    q.step(commands);\n  }\n  const evidence = { seats: players.length, seconds: q.s.tick / 120, phase: q.s.phase, reason: q.s.reason, encounter: q.s.encounter, score: q.s.score, reserve: q.s.reserve, stats: q.s.stats, ships: q.s.ships, assisted: q.s.assisted, invulnerable: q.s.dev.invulnerable, seed: q.s.seed };\n  details.push(evidence);\n  assert.equal(q.s.phase, 'victory', JSON.stringify(evidence)); assert.equal(q.s.stats.cleared.length, 6); assert(q.s.stats.bossPhases.includes(1) && q.s.stats.bossPhases.includes(2)); assert.equal(q.s.assisted, false); assert.equal(q.s.dev.invulnerable, false); assert.equal(q.s.tuning.fireInterval, A.defaults(1).fireInterval); assert(q.s.stats.armor > 0);\n});\nfs.mkdirSync(new URL('../evidence/', import.meta.url), { recursive: true });\nfs.writeFileSync(new URL('../evidence/sim-tests.json', import.meta.url), JSON.stringify({ count, failures, campaigns: details }, null, 2));\nfor (const f of failures) console.error('FAIL ' + f.name + ': ' + f.error);\nconsole.log(JSON.stringify({ suite: 'simulation', count, failed: failures.length }));\nprocess.exitCode = failures.length ? 1 : 0;\nEOF\nnode tests/sim.mjs\"","aggregated_output":"{\"suite\":\"simulation\",\"count\":21,\"failed\":0}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"sed -n '2308,2370p' vendor/engine/my-3d2dge.js\nsed -n '3087,3175p' vendor/engine/my-3d2dge.js\nsed -n '2915,2965p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"sed -n '2308,2370p' vendor/engine/my-3d2dge.js\nsed -n '3087,3175p' vendor/engine/my-3d2dge.js\nsed -n '2915,2965p' vendor/engine/my-3d2dge.js\"","aggregated_output":"class Game {\n  /**\n   * new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu,\n   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\n   * (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\n   * - res: a fixed resolution ('ps1' or [w, h]), whole pixels\n   * - expand: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars\n   *   (expand: { maxW, maxH } stops it growing there)\n   * - bg: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture\n   *   under it (a 3D world, engine/my-3d2dge-3d.js)\n   * - headless: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default):\n   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n   * - draw: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\n   * - loop: false makes a game in a page that runs only by advance()\n   * - menu: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\n   * - fullscreen: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it\n   *   off), 'button' (only when asked) or false\n   * - corner, backGesture: corner: the menu and full-screen buttons (top right); backGesture: a\n   *   phone's back steps back in the game first (false: it leaves the page)\n   * - autoPause: a pausable scene pauses when the page is hidden or loses focus\n   * - live: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it,\n   *   the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\n   * - id: the name the player's settings are saved under (the page's path)\n   * - pace: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every\n   *   other one, evenly), unless the player picks Frame rate 60\n   * - camera: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\n   */\n  constructor(o = {}) {\n    o = Object.assign({}, o);\n    /** true for a game with no display (o.headless, or no DOM: Node) */\n    this.headless = !!o.headless || typeof document === 'undefined';\n    if (this.headless) o.canvas = null;\n    else {\n      if (typeof o.canvas === 'string') o.canvas = document.getElementById(o.canvas.replace(/^#/, '')) || document.querySelector(o.canvas);\n      if (!o.canvas) o.canvas = document.getElementById('screen') || document.querySelector('canvas') || Game._makeCanvas();\n    }\n    if (typeof o.input === 'string') o.input = Input[o.input.toUpperCase()] || (warn('input:' + o.input, 'unknown input preset \"' + o.input + '\" (use DEFAULT, PLATFORMER or SHMUP)'), Input.DEFAULT);\n    /** o: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg,\n     *  step, input, loop, headless) */\n    this.o = Object.assign({ view: 'iso', minH: 190, minW: 300, maxW: 560, maxH: 330, bg: '#07060d', step: 1 / 120, input: Input.DEFAULT, loop: !this.headless }, o);\n    // every listener the engine adds to the window, the document, the canvas and its buttons goes through this: dispose() removes them all\n    this._abort = typeof AbortController === 'function' ? new AbortController() : null;\n    const signal = this._abort ? this._abort.signal : undefined;\n    /** screen: the low-resolution screen (its W, H, scale and buffer) */\n    this.screen = new Screen(this.o.canvas, this.o, signal);\n    /** input: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...) */\n    this.input = new Input(this.screen, this.o.input, signal);\n    /** view: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView);\n     *  baseView: the chosen view without zoom and turn */\n    this.view = this.baseView = this._view(this.o.view) || E.VIEWS.iso;\n    /** zoom: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's\n     *  (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range; yaw: its turn in degrees on top of the\n     *  view (rotateView) */\n    this.zoom = 1; this.yaw = 0; this._zoomBase = 1; this._zoomTo = null; this._zoomAt = 0; this._wall = 0;   // camera zoom and turn on top of the chosen view (setZoom, rotateView)\n    /** views this game is designed for (view cycling and the checker use it). null = every view */\n    this.views = this.o.views || null;\n    /** time: game seconds since start (it stops during pause and hit-stop, and slows with timeScale); real: seconds\n     *  the game has stepped through, pauses and hit-stop included (blinking HUD, notes); hitstop: seconds of\n     *  hit-stop left (freeze: a scene's entry ends it); timeScale: game speed, 1 normal, .25 slow motion, 0 stopped (it outlives a scene change: a game's speed setting; restore a slow motion with a kept timer); reduceMotion: the player\n     *  asked for less motion (prefers-reduced-motion): shake and flashes are softened */\n    this.time = 0; this.real = 0; this.hitstop = 0; this.timeScale = 1; this._shakeAmt = 0; this.reduceMotion = !this.headless && !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);\n    /** camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen\n     *  rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the screen's centre to where the\nclass Settings {\n  /**\n   * game.settings: the player's choices, one property each (game.settings.volume), with the game's own (o.menu.settings)\n   * beside the standard ones (STANDARD_SETTINGS). Saved with E.store under 'settings:' + the game's id, with a version;\n   * on load every value is checked and a bad one falls back to its default. Where storage is blocked the game plays on\n   * with the defaults (saved: false)\n   */\n  constructor(game, own = []) {\n    const hide = (k, v) => Object.defineProperty(this, k, { value: v, writable: true });\n    hide('_g', game); hide('_specs', {}); hide('_saved', {}); hide('_key', 'settings:' + (game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game'));\n    hide('saved', true);\n    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\n    hide('onChange', null);\n    const raw = store.get(this._key, null);\n    hide('_raw', raw && typeof raw === 'object' && raw.values && typeof raw.values === 'object' ? raw.values : {});   // (a newer version's values are checked like the rest)\n    if (!(raw && raw.v >= 2) && this._raw.fullscreen === false) delete this._raw.fullscreen;\n    game.input._settings = this; game.input._onBindings = b => this.set('bindings', b);\n    for (const k in STANDARD_SETTINGS) if (!(game.o.touch === 'never' && STANDARD_SETTINGS[k].group === 'Touch')) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));   // (touch: 'never': no Touch group)\n    for (const sp of own) this.define(sp && !sp.label && Object.prototype.hasOwnProperty.call(STANDARD_SETTINGS, sp.key) ? Object.assign({ key: sp.key }, STANDARD_SETTINGS[sp.key], sp) : sp);   // (a standard key with no label: the game's fields over the standard ones; with a label it is the game's own)\n  }\n  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\n   *  label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and\n   *  applied; it shows on the settings screen. Returns its value */\n  define(sp) {\n    if (!sp || !sp.key || typeof sp.key !== 'string') { warn('setting', 'a setting needs a key: { key: \"hints\", label: \"Hints\", value: true }'); return undefined; }\n    if (sp.key in Settings.prototype || sp.key === 'saved' || sp.key === 'onChange' || sp.key[0] === '_') { warn('setting:' + sp.key, 'a setting cannot be called \"' + sp.key + '\" (a name the settings object uses)'); return undefined; }\n    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }, sp);\n    this._specs[s.key] = s;\n    const saved = settingValue(s, this._raw[s.key]);\n    if (saved !== undefined) this._saved[s.key] = saved;\n    this[s.key] = saved !== undefined ? saved : this.default(s.key);\n    this._apply(s.key);\n    return this[s.key];\n  }\n  /** a setting's default value */\n  default(key) { const s = this._specs[key]; if (!s) return undefined; const v = typeof s.value === 'function' ? s.value(this._g) : s.value; return v === undefined && s.type === 'toggle' ? false : v; }\n  /** the spec a setting was defined with (its label, type, range, options), or undefined */\n  spec(key) { return this._specs[key]; }\n  /** the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key */\n  keys(group) { return Object.keys(this._specs).filter(k => !group || this._specs[k].group === group); }\n  /** change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told.\n   *  Returns the value kept (the old one when v is not a valid value) */\n  set(key, v) {\n    const s = this._specs[key]; if (!s) { warn('setting:' + key, 'unknown setting \"' + key + '\". Settings: ' + this.keys().join(', ')); return undefined; }\n    const ok = settingValue(s, v); if (ok === undefined) return this[key];\n    this[key] = ok; this._saved[key] = ok; this._save(); this._apply(key);\n    if (this.onChange) try { this.onChange(key, ok); } catch (e) { this._g.fail('settings.onChange', e); }\n    return ok;\n  }\n  /** put a group's settings (or all of them) back to their defaults; a game's saves are not touched */\n  reset(group) {\n    for (const k of this.keys(group)) { if (k === 'fullscreen') continue; delete this._saved[k]; this[k] = this.default(k); this._apply(k); if (this.onChange) this.onChange(k, this[k]); }\n    this._save();\n  }\n  _apply(key) { const s = this._specs[key]; if (s && s.apply) try { s.apply(this._g, this[key]); } catch (e) { this._g.fail('setting \"' + key + '\"', e); } }\n  _save() {\n    if (this._g.headless) return;\n    this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: this._saved });   // false when the last save failed (storage blocked or full: the choices last for this visit)\n    if (!this.saved) warn('settings:save', 'the settings could not be saved (storage is blocked or full): they last for this visit');\n  }\n}\nclass FullScreen {\n  /** game.fullscreen: the whole page full screen (the game, its menus and buttons), where the browser can */\n  constructor(game) {\n    /** game: the game it serves; failed: why the last request was refused (a message), or null */\n    this._game = game; this.failed = null;\n  }\n  /** true where this page can go full screen (not an iPhone, which has Add to Home Screen instead; not a frame\n   *  without permission; not headless) */\n  get supported() { if (this._game.headless) return false; const d = document, el = d.documentElement; return !!((d.fullscreenEnabled || d.webkitFullscreenEnabled) && (el.requestFullscreen || el.webkitRequestFullscreen)); }\n  /** true while the page is full screen */\n  get on() { return !this._game.headless && !!(document.fullscreenElement || document.webkitFullscreenElement); }\n  /** true when the page was opened from a home screen as an app (no browser bars: nothing to go full screen from) */\n  get standalone() { const Q = this._mq || (this._mq = {}), m = q => !!(window.matchMedia && (Q[q] || (Q[q] = matchMedia(q))).matches); return !this._game.headless && (m('(display-mode: standalone)') || (m('(display-mode: fullscreen)') && !this.on) || navigator.standalone === true); }   // (full screen from here matches display-mode: fullscreen too)\n  /** go full screen. Browsers allow it only from a tap, click or key press: call it from one (a button, the menu, a\n   *  key's update step). Returns a promise of whether it worked (a refusal is kept in failed and noted on screen, unless\n   *  quiet) */\n  enter(quiet) {\n    if (this.on || !this.supported) return Promise.resolve(this.on);\n    const el = document.documentElement, f = el.requestFullscreen || el.webkitRequestFullscreen;\n    const no = e => { this.failed = (e && e.message) || 'refused'; if (!quiet) this._game.note('FULL SCREEN NOT ALLOWED HERE', 2); return false; };\n    try { const p = f.call(el, { navigationUI: 'hide' }); this.failed = null; return p && p.then ? p.then(() => true, no) : Promise.resolve(true); } catch (e) { return Promise.resolve(no(e)); }\n  }\n  /** leave full screen (Escape and the phone's back gesture do it too) */\n  exit() {\n    if (!this.on) return Promise.resolve(false);\n    const f = document.exitFullscreen || document.webkitExitFullscreen;\n    try { const p = f && f.call(document); return p && p.then ? p.then(() => true, () => false) : Promise.resolve(true); } catch (e) { return Promise.resolve(false); }\n  }\n    this._zoomFit(true);   // its camera: its zoom to start at, and whether the player's applies\n    if (s.pausable || name === 'main') this._fsAuto = this._autoFull();   // a game starting from a tap goes full screen again\n    for (const f of HOOKS.enter) f(this, old);\n    this._ownRun('enter', name, data);\n    if (s.enter) s.enter(data);\n  }\n  /** report an error in game code without stopping the game: logged once per place and message, kept in game.errors\n   *  and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err) */\n  fail(where, e) {\n    const msg = (e && e.message) || String(e), key = where + ':' + msg;\n    if (!this._errKeys.has(key)) {\n      this._errKeys.add(key); this.errors.push({ where, scene: this.sceneName, message: msg, stack: e && e.stack });\n      console.error('my-3D2dge: error in ' + where + (this.sceneName ? ' (scene \"' + this.sceneName + '\")' : '') + ': ' + ((e && e.stack) || msg));\n    }\n    E.showError('error in ' + where + '()' + (this.sceneName && this.sceneName !== 'main' ? ' of scene \"' + this.sceneName + '\"' : ''), e);\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nx=json.load(open('evidence/sim-tests.json'))\nfor c in x['campaigns']:print({k:c[k] for k in ['seats','seconds','phase','score','reserve','stats']})\nPY\nsed -n '1,100p' vendor/engine/docs/ASSETS.md\nrg -n 'music:|voice:|effects:|flashes:|shake:' vendor/engine/my-3d2dge.js | head -20\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nx=json.load(open('evidence/sim-tests.json'))\nfor c in x['campaigns']:print({k:c[k] for k in ['seats','seconds','phase','score','reserve','stats']})\nPY\nsed -n '1,100p' vendor/engine/docs/ASSETS.md\nrg -n 'music:|voice:|effects:|flashes:|shake:' vendor/engine/my-3d2dge.js | head -20\"","aggregated_output":"{'seats': 1, 'seconds': 256.2416666666667, 'phase': 'victory', 'score': 7080, 'reserve': 1, 'stats': {'kills': 172, 'shots': 593, 'repairs': 9, 'drops': 75, 'catches': 11, 'armor': 28, 'saucers': 4, 'deaths': 2, 'bossPhases': [1, 2], 'cleared': [1, 2, 3, 4, 5, 6]}}\n{'seats': 2, 'seconds': 224.79166666666666, 'phase': 'victory', 'score': 6680, 'reserve': 5, 'stats': {'kills': 172, 'shots': 1033, 'repairs': 20, 'drops': 61, 'catches': 24, 'armor': 28, 'saucers': 2, 'deaths': 0, 'bossPhases': [1, 2], 'cleared': [1, 2, 3, 4, 5, 6]}}\n# Objects and materials as data\n\nThe full engine draws still objects (barrels, tables, trees, wells) from a few lines of data, in every view and facing,\nwith the house shading and outline, and gives every surface (floors, wall faces, wall tops, platform tiles, the objects'\nown faces) a material from one open registry. An object costs one to a few hundred tokens of data (the core's median is\n125); you check it headless with one command. Read this card whole before you write one. (The agent edition keeps the\nregistries and ignores the calls: `E.addAssets` returns empty lists, the others null.)\n\n## Use one\n\n```js\n// in draw(r): feet on the point, depth sorted like an actor; its front toward facing\nr.shape('barrel', x, y, 0, { facing: Math.PI / 2 });\n// once, before the updates: bodies stop at it, a body coming down lands on it, one wholly below passes under\nmap.solid('table', 120, 80, 0, { facing: 0 });\n// a sprite of it, for an inventory or a HUD (r.sprite, px.sprite)\nconst icon = E.shapeSprite('chest', { view: 'iso' });\n```\n\n- **r.shape options:** facing (radians, where the front points: 0 east, π/2 south, as written), scale, mats ({ slot:\n  material }), flip (mirrors it x to -x, collision too), params (a generator's: { h: 30 }), bias, hides (default true),\n  light (adds its lights to game.lights), shadow (default true).\n- **map.solid** takes the same id and placement, so one object can feed both calls. Bodies span z to z + h (E.Body's h, 32).\n- **In 3D** the 3D engine draws the same entries, materials and boxes: `world.shape(id, x, y, z, o)` (its header).\n- **Steep views** (top-down) draw shapes from the characters' lower angle, as rigs are drawn. The light comes from the\n  viewer's upper left in every view.\n- **Glow and fire:** a material with glow: 1 ignores the light and stays bright in the dark; an entry's flames ([[x, y, z,\n  w, h]]) draw the engine's animated flame (r.shape only: a sprite has none). Anything else that moves stays a prop\n  (r.prop) or your own code.\n- **Dressing a generated level:** a scene is a few entries as [id, across, forward] from an anchor (a wall spot, forward\n  into the room); place it whole or not at all, each part on free floor, after the level's own random picks and from a\n  seeded stream of its own, so the level stays as its seed builds it (Emberdeep's `src/emberdeep/53-scenes.js`).\n\n## The core library\n\n**Shapes** (sized for a 26-unit hero; generators take params): barrel, crate, chest, table, chair, stool, bench, bed,\nbookcase, shelf, pot, jar, sack, cart, well, sign, lamppost, anvil; fence { len: 16 }, pine { h: 41, tiers: 4 },\ntree { h: 40, seed: 1 }, bush { r: 7 }, grass { h: 6, n: 6 }, rock { r: 7.5, seed: 2 }, crystal { h: 18, seed: 1 }.\n`r.shape('pine', x, y, 0, { params: { h: 30 } })`; `E.SHAPES.barrel.about` says what each is.\n\n**Materials:** woods oak walnut birch crate plank planks wood; stones stone cobble marble granite sandstone slate rock\nbrick flagstone ruin; metals iron steel gold copper bronze metal rusted; clay glazed porcelain; cloth linen burlap wool velvet leather;\nplants bark needles leaves shrub moss straw hedge grass; ground dirt sand snow mud; water ice crystal flame bone shingle;\nwalls timber plaster; tops speckle plain tiles slab; tiles block bonus ground pipe checker.\n\n## Materials on surfaces\n\n```js\nE.MATERIALS.mossy = { color: '#6a7a5a', pattern: 'stones', size: 6 };   // or the shorthand '#6a7a5a stones size=6'\nconst types = { 1: { h: 32, top: '#6a6280', side: '#4a4360', face: 'cobble', roof: 'slate' } };   // TileMap walls\nconst map = new E.TileMap({ rows, legend, types, floorMat: 'flagstone', floorMats: { water: 'water' } });   // floors\nconst level = new E.PlatformMap({ rows, legend, types: { 1: { kind: 'solid', style: 'block', mat: 'mossy' } } });\n```\n\nfloorMats is keyed by the floor tags of the legend ('~': { floor: 'water' }); either stands in for floorTex.\n\nA material is `{ color, pattern, ...the pattern's numbers, ramp, glow, over }`. Its five tones come from `E.tones(color)`\n(or its own `ramp` of five, dark to light); the light picks a band, the pattern moves it a step, so a material works on\nevery surface and in every palette and recolors with one hex. An unknown name warns with the list of names.\nOverlays, the last on top, each in its own color's tones: `over: [['moss', '#5f7a3a', { up: .6 }], ['cracks']]`; moss on\nwhat looks up, cracks (the material a step darker), dirt near the ground (h 6), rust; each takes amount and size.\n\n| Pattern | Numbers | What |\n| --- | --- | --- |\n| none | | the light alone |\n| planks | bw 3, len 14, dir | boards with joints; staves on round parts; dir: 'v' turns them |\n| crate | frame 2, bw 3 | a framed, braced side; planks on its lid |\n| bricks | bw 6, bh 3, mortar | running bond |\n| stones | size 5 | irregular stones (Voronoi), dark joints, a lit rim |\n| tiles | size 4 | square tiles, grout |\n| speck, noise | amount .08; scale 4 | specks; soft patches |\n| foliage | size 3.5 | leaf clumps lit on top |\n| bark | | fissures; rings on a cut end |\n| metal | rivet | a shine where lit; rivets |\n| cloth | fold .9 | weave and folds |\n| glaze | | a glossy shine |\n| thatch, shingles | course; bw | straw courses; roof tiles |\n\nYour own pattern: `E.PATTERNS.waves = (s, m) => Math.sin(s.u / (m.size || 3)) > .8 ? 1 : 0` (s.u, s.v: world units\nacross and up the surface; s.lid, s.curved, s.lit, s.W, s.H; return a step, -1 to +2). A material may also paint one kind\nof surface its own way, per pixel: `face(wx, z, tones, type, cx, cy, fi, nh, h)` or `roof(wx, wy, tones, type)` returning\na color or null, `floor(x, y, tag, view)` returning [r, g, b].\n\n## Write one\n\nUnits: 16 = 1 m = one tile; x east, y south, z up. The origin is the middle of the footprint on the ground; write it\nfacing south (+y). Use whole or half units: a pixel at game size is about 0.7 units.\n\n```js\nE.SHAPES.stool = { about: 'round three-legged stool', tags: 'furniture tavern', mats: { w: 'oak', l: 'walnut' },\n  parts: [['cyl','w',[0,0,8],5,1.5], ['ring',3,3,['box','l',[0,0,0],[1.5,1.5,8],{rot:[0,-8,0]}]]] };\n```\n\nAn entry: `about`, `tags`, `mats` (slot to material; a slot name that is not in mats is a material itself), and `parts`, or\n`make(params)` returning parts with `params` its defaults. Optional: `scale` (times the placement's), `foot: [x0, y0,\nx1, y1]` (the footprint for collision, and for sorting when it stands raised; the bounds by default), `lights: [[x, y,\nz, color, radius]]`, `flames: [[x, y, z, w, h]]`.\n\n| Part | Form | Notes |\n| --- | --- | --- |\n3054:  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n3055:  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n3059:  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n3060:  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n7833:   * sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left)\n7881:    if (!C) { warn('music:empty', 'music(song) needs song.tracks with notes'); return; }\n8026:      const kit = DRUMS[tok[0].toLowerCase()]; if (!kit) { warn('drum:' + tok, 'music: drum token \"' + tok + '\" is unknown (k s h o c t or .)'); return; }\n8031:    const f = noteFreq(tok); if (!f) { warn('note:' + tok, 'music: \"' + tok + '\" is not a note (use C4, F#3, Bb2, \".\" for rest, \"-\" to hold)'); return; }\n9094:  let text = '', st = { c: null, s: 0, shake: 0, wave: 0 }, last = 0, m;\n9116:     *  text's color; nameColor: the speaker's name's color; voice: the sound effect each letter blips ('text'; null\n9117:     *  for silence), or a function (letter, index, dialog) called once for each letter as it types (a babble voice:\n9120:    Object.assign(this, { speed: 50, lines: 3, place: 'bottom', color: '#ffffff', nameColor: '#ffd36a', voice: 'text', width: 0, bg: '#141a3a', border: '#e8e4ff', vars: null }, o);\n9143:   *         vars: the values {$name} reads, voice: this call's (a sound effect, null, or a function per letter) }\n13136:  ahead), voice: { wave: 'square', vol: .2, dur: .09 } (the call notes' sound), on: { judge(j, note), fail(rh),\n13217:     *  either side of a note; lead: seconds of notes shown ahead; voice: the calls' sound; on: { judge, fail, done } */\n13735:const STATUS = {   // the default effects: hurt and heal (a share of max HP a tick), skip (no turns), mute (no skills), spd (its speed)\n13744:     *  slot; effects: its status effects (turns left, 0 till cured); data: the game's own (a rig's look, skills) */\n13805:  state() { return copy({ name: this.name, level: this.level, exp: this.exp, hp: this.hp, mp: this.mp, stats: this.base, growth: this.growth, equip: this.equipped, effects: this.effects, data: this.da [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
