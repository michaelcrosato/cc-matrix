{"type":"item.completed","item":{"id":"item_13","type":"web_search","id":"exec-ab461e1f-99de-443a-be6c-0ca9bbeaec20","query":"https://ballyalley.com/cart_manuals/html_manuals/astro_battle.htm","action":{"type":"open_page","url":"https://ballyalley.com/cart_manuals/html_manuals/astro_battle.htm"},"results":[{"type":"text_result","domain":"ballyalley.com","ref_id":"turn0view0","snippet":"Total lines: 65","title":"ballyalley.com","url":"https://ballyalley.com/cart_manuals/html_manuals/astro_battle.htm"},{"type":"text_result","domain":"ballyalley.com","ref_id":"turn0view1","snippet":"Total lines: 0","url":"https://ballyalley.com/cart_manuals/pdf_manuals/Astro_Battle.pdf"},{"type":"text_result","domain":"ballyalley.com","ref_id":"turn0view2","snippet":"Total lines: 308","title":"Bally Alley - The Newsletter for Astrocade Users","url":"https://ballyalley.com/astrocade_videos/cartridge_videos/cartridge_videos.html"},{"type":"text_result","domain":"ballyalley.com","ref_id":"turn0view3","snippet":"Total lines: 0","url":"https://ballyalley.com/articles_and_news/Video_Games_October_1982.pdf"}]}}
