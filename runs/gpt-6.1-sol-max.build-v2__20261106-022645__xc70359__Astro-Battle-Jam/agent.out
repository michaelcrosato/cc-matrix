{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"sed -n '380,411p' vendor/hub/harness.html\nsed -n '1,85p' vendor/hub/harness.html\nsed -n '7757,7788p' vendor/engine/my-3d2dge.js\"","aggregated_output":" * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\n  _init() {\n    if (this.ctx || this.failed) return this.ctx;\n    try {\n      const AC = window.AudioContext || window.webkitAudioContext; if (!AC) throw new Error('Web Audio is not available');\n      const c = this.ctx = new AC();\n      this._master = c.createGain(); this._master.connect(c.destination);\n      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n      this._musBus = c.createGain(); this._musBus.connect(this._master);\n      this._voiceBus = c.createGain(); this._voiceBus.connect(this._master);   // (bus('voice'): a game's babble or speech)\n      this.applyVolume();\n      const nb = c.createBuffer(1, c.sampleRate, c.sampleRate), d = nb.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = this._rnd() * 2 - 1;\n      this._noise = nb;\n      const resume = () => { if (c.state !== 'running') c.resume().catch(() => {}); };\n      for (const ev of ['pointerdown', 'keydown', 'touchstart']) addEventListener(ev, resume, { capture: true, signal: this._signal });\n      resume();\n    } catch (e) { this.failed = e.message || String(e); warn('audio', 'sound is off: ' + this.failed); }\n    return this.ctx;\n  }\n  /** true once the browser lets the game make sound */\n  get ready() { return !!this.ctx && this.ctx.state === 'running'; }\n  /** apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it) */\n  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); this._voiceBus.gain.value = this.voiceVolume; }\n  /** a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument)\n   *  to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is\n   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n  bus(name = 'sfx') {\n    if (!['sfx', 'music', 'voice', 'master'].includes(name)) warn('bus:' + name, 'audio.bus(\"' + name + '\"): no such bus (sfx, music, voice, master): the sfx bus');\n    if (this._game.headless || !this._init()) return null;\n    return name === 'master' ? this._master : name === 'music' ? this._musBus : name === 'voice' ? this._voiceBus : this._sfxBus;\n  }\n  /** set the master volume, 0..1 */\n  setVolume(v) { this.volume = clamp(v, 0, 1); this.applyVolume(); }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/app.js');s=p.read_text()\ns=s.replace(\\\"app.screen = prev.screen; app.focus = prev.focus; app.idle = 0; clearInput(); layoutRows();\\\", \\\"app.screen = prev.screen; app.focus = prev.focus; app.idle = 0; game.allowJoin(app.screen === 'lobby' && app.seats === 2 && \"'!app.session ? { max: 2 } : false); clearInput(); layoutRows();\")\ns=s.replace('\"'function lobby(n) { app.seats = n;', 'function lobby(n) { if (n === 1) while (game.players.length > 1) game.removePlayer(game.players.at(-1)); app.seats = n;')\ns=s.replace(\\\"if (app.gate && \"'!game.players.some\", \"if (!app.session && app.screen === '\"'play' && game.players.some(i => i.padLost)) show('pause');\\\\n    if (app.gate && \"'!game.players.some\")\ns=s.replace(\"adjust: d => { const filter = (app.difficulty * 2 + (app.seats - 1) + d + 8) % 8; app.difficulty = Math.floor(filter / 2); app.seats = filter % 2 + 1; } }, btn('\"'BACK', back)]\\\", \\\"adjust: d => { const filter = (app.difficulty * 2 + (app.seats - 1) + d + 8) % 8; app.difficulty = Math.floor(filter / 2); app.seats = filter % 2 + 1; } }, { label: 'TABLE', value: app.recordAssisted ? 'ASSISTED' : 'NORMAL', adjust: () => { app.recordAssisted = \"'!app.recordAssisted; } }, btn('\"'BACK', back)]\\\")\ns=s.replace(\\\"app.screen === 'results' ? 185 : 207\\\", \\\"app.screen === 'results' ? 185 : 185\\\")\ns=s.replace(\\\"r.coop === (app.seats === 2));\\\", \\\"r.coop === (app.seats === 2) && \"'!!r.assisted === !!app.recordAssisted);\")\np.write_text(s)\nPY\nnode --check src/app.js'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/app.js');s=p.read_text()\ns=s.replace(\\\"app.screen = prev.screen; app.focus = prev.focus; app.idle = 0; clearInput(); layoutRows();\\\", \\\"app.screen = prev.screen; app.focus = prev.focus; app.idle = 0; game.allowJoin(app.screen === 'lobby' && app.seats === 2 && \"'!app.session ? { max: 2 } : false); clearInput(); layoutRows();\")\ns=s.replace('\"'function lobby(n) { app.seats = n;', 'function lobby(n) { if (n === 1) while (game.players.length > 1) game.removePlayer(game.players.at(-1)); app.seats = n;')\ns=s.replace(\\\"if (app.gate && \"'!game.players.some\", \"if (!app.session && app.screen === '\"'play' && game.players.some(i => i.padLost)) show('pause');\\\\n    if (app.gate && \"'!game.players.some\")\ns=s.replace(\"adjust: d => { const filter = (app.difficulty * 2 + (app.seats - 1) + d + 8) % 8; app.difficulty = Math.floor(filter / 2); app.seats = filter % 2 + 1; } }, btn('\"'BACK', back)]\\\", \\\"adjust: d => { const filter = (app.difficulty * 2 + (app.seats - 1) + d + 8) % 8; app.difficulty = Math.floor(filter / 2); app.seats = filter % 2 + 1; } }, { label: 'TABLE', value: app.recordAssisted ? 'ASSISTED' : 'NORMAL', adjust: () => { app.recordAssisted = \"'!app.recordAssisted; } }, btn('\"'BACK', back)]\\\")\ns=s.replace(\\\"app.screen === 'results' ? 185 : 207\\\", \\\"app.screen === 'results' ? 185 : 185\\\")\ns=s.replace(\\\"r.coop === (app.seats === 2));\\\", \\\"r.coop === (app.seats === 2) && \"'!!r.assisted === !!app.recordAssisted);\")\np.write_text(s)\nPY\nnode --check src/app.js'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"cat > tests/hub.py <<'EOF'\nimport functools\nimport http.server\nimport json\nimport sys\nimport threading\nimport traceback\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nEVIDENCE = ROOT / 'evidence'\nchecks = 0\nfailures = []\nreports = []\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\ndef check(name, condition, detail=''):\n    global checks\n    checks += 1\n    if not condition:\n        failures.append({'name': name, 'detail': str(detail)})\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT.parent))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\norigin = 'http://127.0.0.1:' + str(server.server_address[1])\nartifact = '/' + ROOT.name + '.html'\nharness = '/' + ROOT.name + '/vendor/hub/harness.html'\n\ntry:\n    served = urllib.request.urlopen(origin + artifact).read().decode()\n    check('Owned loopback origin serves the actual exported game', '<title>Astro Battle Jam' in served)\n    with sync_playwright() as p:\n        browser = p.chromium.launch()\n        for seats, scenario in [(1, 'standard'), (2, 'standard'), (2, 'host-leave'), (2, 'server')]:\n            page = browser.new_page(viewport={'width': 1600, 'height': 1000})\n            errors = []\n            warnings = []\n            page.on('pageerror', lambda e: errors.append(str(e)))\n            page.on('console', lambda m: warnings.append(m.text) if m.type in ['error', 'warning'] else None)\n            params = {'game': artifact, 'players': seats, 'latency': 150, 'jitter': 50, 'loss': 5, 'auto': 1, 'scenario': scenario, 'play': 6000}\n            page.goto(origin + harness + '?' + urllib.parse.urlencode(params))\n            page.wait_for_selector('body[data-complete=\\\"true\\\"]', timeout=60000)\n            report = page.evaluate('window.__hubCheck')\n            reports.append(report)\n            check('Official harness ' + str(seats) + '-seat ' + scenario, report['pass'], [c for c in report['checks'] if not c['pass']])\n            check('Hub ' + scenario + ' has no page errors', not errors, errors)\n            protocol = [m for m in warnings if '[AIHub]' in m or 'my-3D2dge:' in m]\n            check('Hub ' + scenario + ' has no protocol/rate/engine warnings', not protocol, protocol)\n            states = page.evaluate('Array.from(document.querySelectorAll(\\\"iframe\\\")).map(f=>f.contentWindow.__game?.game.debug.snapshot()).filter(Boolean)')\n            check('Hub ' + scenario + ' stops every remaining copy', all(s['session']['ended'] for s in states if s['session']), states)\n            if scenario == 'server':\n                server_state = next(s for s in states if s['session']['info'].get('server'))\n                check('Server host has no local cannon seat', all(ship['id'] \"'!= server_state['\"'session']['info']['me'] for ship in server_state['world']['ships']))\n            page.close()\n        browser.close()\nexcept Exception:\n    failures.append({'name': 'Hub suite execution', 'detail': traceback.format_exc()})\nfinally:\n    server.shutdown()\n    server.server_close()\n\n(EVIDENCE / 'hub-tests.json').write_text(json.dumps({'count': checks, 'failures': failures, 'reports': reports}, indent=2))\nfor f in failures:\n    print('FAIL ' + f['name'] + ': ' + f['detail'], file=sys.stderr)\nprint(json.dumps({'suite': 'hub', 'count': checks, 'failed': len(failures)}))\nsys.exit(1 if failures else 0)\nEOF\ncat > tests/session.mjs <<'EOF'\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nlet clock = 0;\nconst ctx = { console, TextEncoder, performance: { now: () => clock } }; vm.createContext(ctx);\nfor (const f of ['content', 'sim', 'session']) vm.runInContext(fs.readFileSync(new URL('../src/' + f + '.js', import.meta.url), 'utf8'), ctx, { filename: f });\nconst A = ctx.ABJ, failures = [], evidence = []; let count = 0;\nfunction test(name, fn) { count++; try { fn(); } catch (e) { failures.push({ name, error: e.stack }); } }\nfunction pair(server = false) {\n  clock = 0; const queue = [], finishes = [], players = [{ id: 4, name: '<b>A</b>' }, { id: 9, name: 'B' }];\n  const info = id => ({ isHost: id === (server ? 99 : 4), host: server ? 99 : 4, server: server && id === 99, me: id, players });\n  const sessions = {};\n  const make = id => {\n    const handlers = {};\n    const hub = { time: () => clock, rng: () => () => .4812, ready: () => {}, on: (k, fn) => { handlers[k] = fn; }, send: (data, options) => { queue.push({ data: JSON.parse(JSON.stringify(data)), from: id, options }); return true; }, finish: r => finishes.push(r) };\n    const session = new A.Session(hub, info(id), () => {}, () => {}); sessions[id] = session;\n    return { session, emit: (k, v) => handlers[k](v) };\n  };\n  const host = make(server ? 99 : 4), guest = make(9); host.emit('start'); guest.emit('start');\n  const pump = () => { for (const msg of queue.splice(0)) for (const [id, q] of Object.entries(sessions)) if (+id \"'!== msg.from && (msg.options.to === undefined || +id === msg.options.to)) q.receive(msg.data, msg.from); };\n  return { host, guest, pump, queue, finishes, tick(n = 120) { for (let i = 0; i < n; i++) { clock += 1000 / 120; guest.session.update(); pump(); host.session.update(); pump(); } } };\n}\ntest('\"'Complete reliable snapshot round trip preserves every world field', () => {\n  const q = new A.Sim({ players: [4, 9] }); for (let i = 0; i < 1500; i++) q.step({ 4: { fire: true }, 9: { fire: true, move: i % 500 < 250 ? 1 : -1 } });\n  const packed = A.pack(q.s), out = A.unpack(packed);\n  const expected = q.snapshot(); expected.events = expected.events.slice(-12);\n  for (const b of expected.shots) { b.x = +b.x.toFixed(3); b.y = +b.y.toFixed(3); }\n  for (const p of expected.pickups) { p.x = +p.x.toFixed(3); p.y = +p.y.toFixed(3); }\n  assert.equal(JSON.stringify(out), JSON.stringify(expected)); assert(JSON.stringify(packed).length < 16000);\n});\ntest('Host ticks follow the shared clock, guest never independently advances', () => {\n  const p = pair(); p.tick(); assert(p.host.session.state.tick >= 119); const t = p.guest.session.state.tick;\n  clock += 900; p.guest.session.update(); assert.equal(p.guest.session.state.tick, t); p.host.session.update(); assert(p.host.session.state.tick >= 227);\n});\ntest('Sender identity, packet sequence, bounds and finite values are validated', () => {\n  const p = pair(), h = p.host.session; const valid = { t: 'i', q: 2, r: 0, m: .5, f: true };\n  h.receive(valid, 9); assert.equal(h.inputs.get(9).move, .5);\n  h.receive({ ...valid, q: 1, m: -1 }, 9); h.receive({ ...valid, q: 3, m: Infinity }, 9); h.receive({ ...valid, q: 3, m: 2 }, 9); h.receive({ ...valid, q: 3, player: 9 }, 666);\n  assert.equal(h.inputs.get(9).move, .5); assert.equal(h.debug.rejected, 4);\n});\ntest('Remote repair edge is acknowledged once even in repeated heartbeats', () => {\n  const p = pair(), h = p.host.session, g = p.guest.session; h.sim.s.bunkers[2].rows.fill(0); h.sim.s.ships[1].x = 294; h.sim.s.ships[1].charges = 3;\n  g.localCommand({ move: 0, fire: false, repair: true }); p.tick(120);\n  assert.equal(h.sim.s.ships[1].repairs, 1); assert.equal(h.sim.s.ships[1].charges, 2); assert.equal(g.ack[9], 1);\n  assert.equal(JSON.stringify(g.state.bunkers), JSON.stringify(h.state.bunkers));\n  g.localCommand({ move: 0, fire: false, repair: false }); p.tick(20); g.localCommand({ move: 0, fire: false, repair: true }); p.tick(120); assert.equal(h.sim.s.ships[1].repairs, 2);\n});\ntest('Stale remote held input neutralizes and later heartbeat recovers', () => {\n  const p = pair(), h = p.host.session;\n  h.receive({ t: 'i', q: 1, r: 0, m: 1, f: true }, 9); assert.equal(h.commands()[9].move, 1);\n  clock += 700; assert.equal(h.commands()[9].move, 0); h.receive({ t: 'i', q: 2, r: 0, m: -1, f: false }, 9); assert.equal(h.commands()[9].move, -1);\n});\ntest('Authoritative death, reserve debit and protected respawn agree remotely', () => {\n  const p = pair(), h = p.host.session, g = p.guest.session;\n  const ship = h.sim.s.ships[1]; ship.shield = 0; h.sim.killShip(ship); p.tick(24);\n  assert.equal(g.state.ships[1].active, false); assert.equal(g.state.reserve, h.state.reserve); assert.equal(g.state.ships[1].deaths, 1);\n  p.tick(150); assert(g.state.ships[1].active); assert(g.state.ships[1].shield > 0); assert.equal(g.state.reserve, 3);\n});\ntest('Local overlay neutral commands do not stop host world or heartbeats', () => {\n  const p = pair(); p.host.session.localCommand(A.NEUTRAL); p.guest.session.localCommand(A.NEUTRAL); p.tick(240);\n  assert(p.host.session.state.tick >= 239); assert(p.host.session.debug.sent >= 18); assert(p.guest.session.debug.sent >= 18);\n});\ntest('Server-only host supports roster without a local ship and finishes a team tie', () => {\n  const p = pair(true); p.tick(120); assert(\"'!p.host.session.state.ships.some(s => s.id === 99));\n  p.host.emit('\"'time-up', { graceMs: 2000 }); assert.equal(p.finishes.length, 1); assert.equal(JSON.stringify(p.finishes[0].standings), '[[4,9]]'); assert.equal(p.finishes[0].won, false);\n  p.host.emit('time-up', {}); assert.equal(p.finishes.length, 1);\n});\ntest('A nonhost departure removes controls and ship without awarding resources', () => {\n  const p = pair(), h = p.host.session; const reserve = h.state.reserve; p.host.emit('leave', { id: 9 }); assert(h.state.ships[1].gone); assert.equal(h.state.reserve, reserve);\n  h.receive({ t: 'i', q: 5, r: 0, m: 1, f: true }, 9); assert(\"'!h.inputs.has(9));\n});\ntest('\"'Every end reason stops input, simulation and outgoing traffic immediately', () => {\n  for (const reason of ['finished', 'void', 'host-left', 'sat-out', 'session-ended']) {\n    const p = pair(), h = p.host.session; p.tick(30); p.host.emit('end', { reason }); const tick = h.state.tick, sent = h.debug.sent; clock += 5000; h.localCommand({ fire: true, move: 1 }); h.update(); assert.equal(h.state.tick, tick); assert.equal(h.debug.sent, sent); assert.equal(h.debug.terminal, reason);\n  }\n});\nfs.writeFileSync(new URL('../evidence/session-tests.json', import.meta.url), JSON.stringify({ count, failures, evidence }, null, 2));\nfor (const f of failures) console.error('FAIL ' + f.name + ': ' + f.error);\nconsole.log(JSON.stringify({ suite: 'session', count, failed: failures.length })); process.exitCode = failures.length ? 1 : 0;\nEOF\nnode tools/build.mjs\nnode tools/test.mjs session hub\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"cat > tests/hub.py <<'EOF'\nimport functools\nimport http.server\nimport json\nimport sys\nimport threading\nimport traceback\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nEVIDENCE = ROOT / 'evidence'\nchecks = 0\nfailures = []\nreports = []\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\ndef check(name, condition, detail=''):\n    global checks\n    checks += 1\n    if not condition:\n        failures.append({'name': name, 'detail': str(detail)})\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT.parent))\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\norigin = 'http://127.0.0.1:' + str(server.server_address[1])\nartifact = '/' + ROOT.name + '.html'\nharness = '/' + ROOT.name + '/vendor/hub/harness.html'\n\ntry:\n    served = urllib.request.urlopen(origin + artifact).read().decode()\n    check('Owned loopback origin serves the actual exported game', '<title>Astro Battle Jam' in served)\n    with sync_playwright() as p:\n        browser = p.chromium.launch()\n        for seats, scenario in [(1, 'standard'), (2, 'standard'), (2, 'host-leave'), (2, 'server')]:\n            page = browser.new_page(viewport={'width': 1600, 'height': 1000})\n            errors = []\n            warnings = []\n            page.on('pageerror', lambda e: errors.append(str(e)))\n            page.on('console', lambda m: warnings.append(m.text) if m.type in ['error', 'warning'] else None)\n            params = {'game': artifact, 'players': seats, 'latency': 150, 'jitter': 50, 'loss': 5, 'auto': 1, 'scenario': scenario, 'play': 6000}\n            page.goto(origin + harness + '?' + urllib.parse.urlencode(params))\n            page.wait_for_selector('body[data-complete=\\\"true\\\"]', timeout=60000)\n            report = page.evaluate('window.__hubCheck')\n            reports.append(report)\n            check('Official harness ' + str(seats) + '-seat ' + scenario, report['pass'], [c for c in report['checks'] if not c['pass']])\n            check('Hub ' + scenario + ' has no page errors', not errors, errors)\n            protocol = [m for m in warnings if '[AIHub]' in m or 'my-3D2dge:' in m]\n            check('Hub ' + scenario + ' has no protocol/rate/engine warnings', not protocol, protocol)\n            states = page.evaluate('Array.from(document.querySelectorAll(\\\"iframe\\\")).map(f=>f.contentWindow.__game?.game.debug.snapshot()).filter(Boolean)')\n            check('Hub ' + scenario + ' stops every remaining copy', all(s['session']['ended'] for s in states if s['session']), states)\n            if scenario == 'server':\n                server_state = next(s for s in states if s['session']['info'].get('server'))\n                check('Server host has no local cannon seat', all(ship['id'] \"'!= server_state['\"'session']['info']['me'] for ship in server_state['world']['ships']))\n            page.close()\n        browser.close()\nexcept Exception:\n    failures.append({'name': 'Hub suite execution', 'detail': traceback.format_exc()})\nfinally:\n    server.shutdown()\n    server.server_close()\n\n(EVIDENCE / 'hub-tests.json').write_text(json.dumps({'count': checks, 'failures': failures, 'reports': reports}, indent=2))\nfor f in failures:\n    print('FAIL ' + f['name'] + ': ' + f['detail'], file=sys.stderr)\nprint(json.dumps({'suite': 'hub', 'count': checks, 'failed': len(failures)}))\nsys.exit(1 if failures else 0)\nEOF\ncat > tests/session.mjs <<'EOF'\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nlet clock = 0;\nconst ctx = { console, TextEncoder, performance: { now: () => clock } }; vm.createContext(ctx);\nfor (const f of ['content', 'sim', 'session']) vm.runInContext(fs.readFileSync(new URL('../src/' + f + '.js', import.meta.url), 'utf8'), ctx, { filename: f });\nconst A = ctx.ABJ, failures = [], evidence = []; let count = 0;\nfunction test(name, fn) { count++; try { fn(); } catch (e) { failures.push({ name, error: e.stack }); } }\nfunction pair(server = false) {\n  clock = 0; const queue = [], finishes = [], players = [{ id: 4, name: '<b>A</b>' }, { id: 9, name: 'B' }];\n  const info = id => ({ isHost: id === (server ? 99 : 4), host: server ? 99 : 4, server: server && id === 99, me: id, players });\n  const sessions = {};\n  const make = id => {\n    const handlers = {};\n    const hub = { time: () => clock, rng: () => () => .4812, ready: () => {}, on: (k, fn) => { handlers[k] = fn; }, send: (data, options) => { queue.push({ data: JSON.parse(JSON.stringify(data)), from: id, options }); return true; }, finish: r => finishes.push(r) };\n    const session = new A.Session(hub, info(id), () => {}, () => {}); sessions[id] = session;\n    return { session, emit: (k, v) => handlers[k](v) };\n  };\n  const host = make(server ? 99 : 4), guest = make(9); host.emit('start'); guest.emit('start');\n  const pump = () => { for (const msg of queue.splice(0)) for (const [id, q] of Object.entries(sessions)) if (+id \"'!== msg.from && (msg.options.to === undefined || +id === msg.options.to)) q.receive(msg.data, msg.from); };\n  return { host, guest, pump, queue, finishes, tick(n = 120) { for (let i = 0; i < n; i++) { clock += 1000 / 120; guest.session.update(); pump(); host.session.update(); pump(); } } };\n}\ntest('\"'Complete reliable snapshot round trip preserves every world field', () => {\n  const q = new A.Sim({ players: [4, 9] }); for (let i = 0; i < 1500; i++) q.step({ 4: { fire: true }, 9: { fire: true, move: i % 500 < 250 ? 1 : -1 } });\n  const packed = A.pack(q.s), out = A.unpack(packed);\n  const expected = q.snapshot(); expected.events = expected.events.slice(-12);\n  for (const b of expected.shots) { b.x = +b.x.toFixed(3); b.y = +b.y.toFixed(3); }\n  for (const p of expected.pickups) { p.x = +p.x.toFixed(3); p.y = +p.y.toFixed(3); }\n  assert.equal(JSON.stringify(out), JSON.stringify(expected)); assert(JSON.stringify(packed).length < 16000);\n});\ntest('Host ticks follow the shared clock, guest never independently advances', () => {\n  const p = pair(); p.tick(); assert(p.host.session.state.tick >= 119); const t = p.guest.session.state.tick;\n  clock += 900; p.guest.session.update(); assert.equal(p.guest.session.state.tick, t); p.host.session.update(); assert(p.host.session.state.tick >= 227);\n});\ntest('Sender identity, packet sequence, bounds and finite values are validated', () => {\n  const p = pair(), h = p.host.session; const valid = { t: 'i', q: 2, r: 0, m: .5, f: true };\n  h.receive(valid, 9); assert.equal(h.inputs.get(9).move, .5);\n  h.receive({ ...valid, q: 1, m: -1 }, 9); h.receive({ ...valid, q: 3, m: Infinity }, 9); h.receive({ ...valid, q: 3, m: 2 }, 9); h.receive({ ...valid, q: 3, player: 9 }, 666);\n  assert.equal(h.inputs.get(9).move, .5); assert.equal(h.debug.rejected, 4);\n});\ntest('Remote repair edge is acknowledged once even in repeated heartbeats', () => {\n  const p = pair(), h = p.host.session, g = p.guest.session; h.sim.s.bunkers[2].rows.fill(0); h.sim.s.ships[1].x = 294; h.sim.s.ships[1].charges = 3;\n  g.localCommand({ move: 0, fire: false, repair: true }); p.tick(120);\n  assert.equal(h.sim.s.ships[1].repairs, 1); assert.equal(h.sim.s.ships[1].charges, 2); assert.equal(g.ack[9], 1);\n  assert.equal(JSON.stringify(g.state.bunkers), JSON.stringify(h.state.bunkers));\n  g.localCommand({ move: 0, fire: false, repair: false }); p.tick(20); g.localCommand({ move: 0, fire: false, repair: true }); p.tick(120); assert.equal(h.sim.s.ships[1].repairs, 2);\n});\ntest('Stale remote held input neutralizes and later heartbeat recovers', () => {\n  const p = pair(), h = p.host.session;\n  h.receive({ t: 'i', q: 1, r: 0, m: 1, f: true }, 9); assert.equal(h.commands()[9].move, 1);\n  clock += 700; assert.equal(h.commands()[9].move, 0); h.receive({ t: 'i', q: 2, r: 0, m: -1, f: false }, 9); assert.equal(h.commands()[9].move, -1);\n});\ntest('Authoritative death, reserve debit and protected respawn agree remotely', () => {\n  const p = pair(), h = p.host.session, g = p.guest.session;\n  const ship = h.sim.s.ships[1]; ship.shield = 0; h.sim.killShip(ship); p.tick(24);\n  assert.equal(g.state.ships[1].active, false); assert.equal(g.state.reserve, h.state.reserve); assert.equal(g.state.ships[1].deaths, 1);\n  p.tick(150); assert(g.state.ships[1].active); assert(g.state.ships[1].shield > 0); assert.equal(g.state.reserve, 3);\n});\ntest('Local overlay neutral commands do not stop host world or heartbeats', () => {\n  const p = pair(); p.host.session.localCommand(A.NEUTRAL); p.guest.session.localCommand(A.NEUTRAL); p.tick(240);\n  assert(p.host.session.state.tick >= 239); assert(p.host.session.debug.sent >= 18); assert(p.guest.session.debug.sent >= 18);\n});\ntest('Server-only host supports roster without a local ship and finishes a team tie', () => {\n  const p = pair(true); p.tick(120); assert(\"'!p.host.session.state.ships.some(s => s.id === 99));\n  p.host.emit('\"'time-up', { graceMs: 2000 }); assert.equal(p.finishes.length, 1); assert.equal(JSON.stringify(p.finishes[0].standings), '[[4,9]]'); assert.equal(p.finishes[0].won, false);\n  p.host.emit('time-up', {}); assert.equal(p.finishes.length, 1);\n});\ntest('A nonhost departure removes controls and ship without awarding resources', () => {\n  const p = pair(), h = p.host.session; const reserve = h.state.reserve; p.host.emit('leave', { id: 9 }); assert(h.state.ships[1].gone); assert.equal(h.state.reserve, reserve);\n  h.receive({ t: 'i', q: 5, r: 0, m: 1, f: true }, 9); assert(\"'!h.inputs.has(9));\n});\ntest('\"'Every end reason stops input, simulation and outgoing traffic immediately', () => {\n  for (const reason of ['finished', 'void', 'host-left', 'sat-out', 'session-ended']) {\n    const p = pair(), h = p.host.session; p.tick(30); p.host.emit('end', { reason }); const tick = h.state.tick, sent = h.debug.sent; clock += 5000; h.localCommand({ fire: true, move: 1 }); h.update(); assert.equal(h.state.tick, tick); assert.equal(h.debug.sent, sent); assert.equal(h.debug.terminal, reason);\n  }\n});\nfs.writeFileSync(new URL('../evidence/session-tests.json', import.meta.url), JSON.stringify({ count, failures, evidence }, null, 2));\nfor (const f of failures) console.error('FAIL ' + f.name + ': ' + f.error);\nconsole.log(JSON.stringify({ suite: 'session', count, failed: failures.length })); process.exitCode = failures.length ? 1 : 0;\nEOF\nnode tools/build.mjs\nnode tools/test.mjs session hub\"","aggregated_output":"Built Astro-Battle-Jam-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-max-20261106-022645.html (1396209 bytes)\n28 checks, 0 failures\n","exit_code":0,"status":"completed"}}
