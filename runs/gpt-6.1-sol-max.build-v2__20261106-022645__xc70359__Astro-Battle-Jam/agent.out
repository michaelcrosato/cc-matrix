nfo = await AIHub.connect({ mode: 'shared-world', seats: [2, 4] });\n679:  game.message = 'Get ready…';\n680:  AIHub.ready();\n681:  AIHub.on('start', () => { game.phase = 'playing'; unlockAudio(); });\n682:  AIHub.on('message', (data, from) => {\n688:  AIHub.on('leave', ({ id }) => {\n693:  AIHub.on('time-up', () => { if (hub.isHost) finish(); });\n694:  AIHub.on('end', ({ reason, standings }) => {\n697:    game.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n716:  AIHub.send({ t: 'pick', id, n });\n742:  if (s.over) { game.phase = 'over'; game.message = 'Round over'; }\n748:  AIHub.send({ ...snapshot(), over: 1 });\n759:  game.message = 'Round over';\n791:      if (now > soloEnds) { game.phase = 'over'; game.message = `Time! ${me.score} stars — press to play again`; }\n805:      AIHub.send({ t: 'claim', n: claimed }, { to: hub.host });\n811:    if (hub.isHost) AIHub.send(snapshot(), { reliable: false });\n812:    else AIHub.send({ t: 'me', at: Math.round(AIHub.time()), x: Math.round(me.x), y: Math.round(me.y) }, { to: hub.host, reliable: false });\n852:    ctx.fillText(game.message, W / 2, H / 2 - 70);\n878:connect();\n12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n72:const auto = params.get('auto') === '1';\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n192:    limitMs,\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n383:const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n527:    document.body.dataset.complete = 'true';\n544:if (auto) conformance();\n284:- `input.codeLabel(code)`: a code as a person reads it: 'W' (or the keyboard's own letter there), 'Space', '↑', 'Left click', and a gamepad button by its symbol on the controller in use ('A', '✕', 'B' [... omitted end of long line]\n298:- `input.padStyle()`: the controller family whose symbols label() shows: glyphs, or with glyphs 'auto' the one its name says\n328:- `input.glyphs = 'auto'`: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' | 'nintendo' | 'generic' (positions)\n364:- `E.font.title(g, s, x, y, o = {})`: Big logo text for title screens: scaled glyphs with a vertical color gradient, an outline and an extruded 3D edge. title(g, 'CASTLE OF NIGHT', x, y, { scale: 3, c [... omitted end of long line]\n575:- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its  [... omitted end of long line]\n578:- `settings.set(key, v)`: change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told. Returns the value kept (the old one when v is not a valid value [... omitted end of long line]\n1068:- `game.audio.applyVolume()`: apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it)\n1070:- `game.audio.bus(name = 'sfx')`: a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument) to connect to, so it follows the volume, the mute a [... omitted end of long line]\n1072:- `game.audio.define(name, voice)`: add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 })\n1091:- `game.audio.musicVolume = .5`, `game.audio.sfxVolume = 1`, `game.audio.voiceVolume = 1`: 0..1 for effects, music and the voice bus (bus('voice'))\n1094:- `game.audio.presets`: the named sound effects, sfx(name) plays one and define(name, voice) adds one\n1186:- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HT [... omitted end of long line]\n1204:- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (stri [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
