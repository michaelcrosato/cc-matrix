{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser_extra.py <<'EOF'\nfrom pathlib import Path\n\n\ndef more_flows(p, browser, page, check, snap, action, choose, evidence, url, observations):\n    choose(page, 'BACK')\n    choose(page, 'BACK')\n    choose(page, 'SETTINGS')\n    choose(page, 'SOUND')\n    choose(page, 'Music')\n    action(page, 'ArrowRight')\n    check('Audio slider responds to pointer and directional controls', snap(page)['settings']['music'] == .05)\n    choose(page, 'BACK')\n    choose(page, 'RESET PREFERENCES')\n    check('Preference reset restores the 10% music default', snap(page)['settings']['music'] == .1)\n    choose(page, 'BACK')\n    choose(page, 'RESUME DEFENSE')\n    before = snap(page)['world']['ships'][0]['x']\n    page.mouse.move(320, 750)\n    after = snap(page)['world']['ships'][0]['x']\n    check('Pointer aiming does not teleport the cannon', abs(after-before) < 20)\n    page.wait_for_function('__game.app.pointerTarget \"'!== null'\"')\n    page.keyboard.down('d')\n    page.wait_for_function('__game.app.pointerTarget === null')\n    page.keyboard.up('d')\n    check('Keyboard movement cancels a pointer target', snap(page)['pointerTarget'] is None)\n    action(page, 'Escape')\n    choose(page, 'DEVELOPER TOOLS')\n    choose(page, 'ENCOUNTERS & RESOURCES')\n    choose(page, 'FLAGSHIP / CORE PHASE')\n    check('Developer encounter selection reaches the exposed core', snap(page)['world']['boss']['phase'] == 2)\n    choose(page, 'BACK')\n    choose(page, 'BACK')\n    choose(page, 'RESUME DEFENSE')\n    page.wait_for_function('__game.app.sim.s.phase === \\\"active\\\"')\n    page.screenshot(path=str(evidence / 'flagship-core-1080.png'))\n    page.evaluate('__game.app.sim.end(false, \\\"DEPLOYMENTS DEPLETED\\\")')\n    page.wait_for_function('__game.app.screen === \\\"results\\\"')\n    page.screenshot(path=str(evidence / 'results-1080.png'))\n    choose(page, 'PLAY AGAIN')\n    check('Replay resets run ownership', page.evaluate('__game.app.screen === \\\"play\\\" && __game.app.sim.s.encounter===0 && \"'!__game.app.sim.s.assisted && !__game.app.sim.s.dev.invulnerable && __game.app.timeScale===1'\"'))\n    action(page, 'Escape')\n    choose(page, 'RETURN TO TITLE')\n    choose(page, 'ABOUT / CREDITS')\n    page.screenshot(path=str(evidence / 'credits-1080.png'))\n    n = page.evaluate('__game.game.debug.aboutPages().length')\n    for i in range(n):\n        choose(page, 'NEXT PAGE')\n    check('Every source and feedback page is reachable and wraps back', page.evaluate('__game.app.aboutPage===0'))\n    choose(page, 'BACK')\n    check('Back restores the title focus', snap(page)['focus'] == 5)\n    page.evaluate('__game.game.stop();__game.game.debug.title();__game.game.advance(9.9)')\n    check('Attract does not start before ten seconds', snap(page)['screen'] == 'title')\n    page.evaluate('__game.game.advance(.2)')\n    check('Attract starts at ten seconds in the exported artifact', snap(page)['screen'] == 'attract')\n    page.keyboard.down('Enter')\n    page.evaluate('__game.game.advance(.03)')\n    page.keyboard.up('Enter')\n    page.evaluate('__game.game.advance(.05)')\n    check('Keyboard wake is consumed without starting a game', snap(page)['screen'] == 'title')\n    page.evaluate('__game.game.advance(10.1)')\n    page.mouse.move(5, 6)\n    page.evaluate('__game.game.advance(.05)')\n    check('Pointer motion wakes attract into a clean title', snap(page)['screen'] == 'title')\n    page.evaluate('__game.game.advance(10.1)')\n    page.mouse.click(1150, 350)\n    page.evaluate('__game.game.advance(.1)')\n    check('A click wake cannot also activate a title item', snap(page)['screen'] == 'title', snap(page)['screen'])\n    page.evaluate('__game.game.start()')\n    signal = page.evaluate('''async () => {\n      const native=__game.game.audio,results={};\n      for (const muted of [false,true]) {\n        const ctx=new OfflineAudioContext(1,48000,48000),bus=ctx.createGain();bus.gain.value=muted?0:.7;bus.connect(ctx.destination);\n        const synth=Object.create(Object.getPrototypeOf(native));synth.ctx=ctx;synth._waves={};synth._rnd=()=>.25;\n        synth._noise=ctx.createBuffer(1,48000,48000);const noise=synth._noise.getChannelData(0);for(let i=0;i<noise.length;i++)noise[i]=Math.sin(i*1.77)*.7;\n        for(const [i,name] of ['jamshot','jamarmor','jamerosion','jamrepair','jamkill'].entries())synth._voice(native.presets[name],bus,.05+i*.16,1,false);\n        ABJ.synthTone(ctx,bus,.2,{freq:145,end:310,dur:.075,vol:.075,wave:'sawtooth'});\n        const buffer=await ctx.startRendering(),a=buffer.getChannelData(0);let sum=0,peak=0,finite=true;\n        for(const v of a){finite=finite&&Number.isFinite(v);sum+=v*v;peak=Math.max(peak,Math.abs(v));}\n        results[muted?'muted':'audible']={rms:Math.sqrt(sum/a.length),peak,finite};\n      }\n      results.ready=native.ready;results.music=__game.game.settings.music;\n      results.gains=[native.bus('master').gain.value,native.bus('sfx').gain.value,native.bus('music').gain.value,native.bus('voice').gain.value];\n      return results;\n    }''')\n    observations['audio'] = signal\n    check('Browser audio unlocks on a real gesture', signal['ready'])\n    check('Production synth produces finite nonzero bounded signal', signal['audible']['finite'] and .0001 < signal['audible']['rms'] < .4 and signal['audible']['peak'] < 1, signal)\n    check('Muted synthesized bus is silent', signal['muted']['rms'] == 0)\n    check('Every production audio bus gain is bounded', all(0 <= n <= 1 for n in signal['gains']))\n    page.wait_for_timeout(650)\n    check('Gibberish oscillator voices do not accumulate', page.evaluate('__game.audio.nodes.size') == 0)\n\n\ndef gamepads(browser, check, snap, action, choose, url):\n    context = browser.new_context(viewport={'width': 1920, 'height': 1080})\n    context.add_init_script(\\\"\\\"\\\"\n      window.makePad=i=>({index:i,id:'DualSense Standard',mapping:'standard',connected:true,timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))});\n      window.__pads=[makePad(0),makePad(1)];Object.defineProperty(navigator,'getGamepads',{value:()=>__pads});\n      window.padButton=(i,n,on)=>{__pads[i].buttons[n]={pressed:on,touched:on,value:on?1:0};__pads[i].timestamp++};\n    \\\"\\\"\\\")\n    page = context.new_page()\n    page.goto(url)\n    page.wait_for_function('window.__game?.app.screen===\\\"title\\\"')\n    page.mouse.click(20,20)\n    page.evaluate('padButton(0,0,true)')\n    page.wait_for_function('__game.app.screen===\\\"lobby\\\"')\n    page.wait_for_timeout(220)\n    check('Held gamepad confirm cannot skip the lobby', snap(page)['screen']=='lobby')\n    page.evaluate('padButton(0,0,false)')\n    check('Meaningful pad input selects PlayStation prompts', snap(page)['primary']=='gamepad' and snap(page)['settings']['glyphs']=='playstation')\n    choose(page,'BACK')\n    choose(page,'LOCAL CO-OP')\n    page.evaluate('padButton(1,9,true)')\n    page.wait_for_function('__game.game.players.length===2')\n    page.evaluate('padButton(1,9,false)')\n    choose(page,'CONTROLS & DEPLOY')\n    choose(page,'DEPLOY CANNONS')\n    page.evaluate('padButton(0,7,true);padButton(1,0,true)')\n    page.wait_for_function('__game.app.sim.s.shots.some(b=>b.owner===0)&&__game.app.sim.s.shots.some(b=>b.owner===1)')\n    check('Two standard pads operate simultaneous local cannons', len(snap(page)['world']['ships'])==2)\n    page.evaluate('padButton(0,7,false);padButton(1,0,false)')\n    page.evaluate('__pads[1]=null')\n    page.wait_for_function('__game.app.screen===\\\"pause\\\"')\n    check('Controller removal opens a usable standalone pause', snap(page)['screen']=='pause')\n    page.evaluate('__pads[1]=makePad(1)')\n    choose(page,'RESUME DEFENSE')\n    page.evaluate('padButton(1,0,true)')\n    page.wait_for_function('__game.app.sim.s.shots.some(b=>b.owner===1)')\n    page.evaluate('padButton(1,0,false)')\n    check('Returning pad reclaims its locked seat', page.evaluate('__game.game.players.length===2 && __game.app.sim.s.ships.length===2'))\n    action(page,'Escape')\n    choose(page,'SETTINGS')\n    choose(page,'COMFORT & CONTROLS')\n    choose(page,'Button glyphs')\n    check('Xbox glyph setting reaches native player labels', snap(page)['settings']['glyphs']=='xbox' and page.evaluate('__game.game.players[1].glyphs===\\\"xbox\\\"'))\n    choose(page,'BACK');choose(page,'BACK');choose(page,'RETURN TO TITLE')\n    page.evaluate('__game.game.stop();__game.game.advance(10.2)')\n    page.evaluate('__pads[0].buttons[7]={pressed:false,touched:true,value:.6};__game.game.advance(.04)')\n    check('Trigger motion wakes attract and consumes the action', snap(page)['screen']=='title')\n    page.evaluate('__pads[0].buttons[7]={pressed:false,touched:false,value:0};__game.game.advance(.1);__game.game.debug.title();__game.game.advance(.1)')\n    page.evaluate('__pads[0].axes[0]=.06;__game.game.advance(10.2)')\n    check('Stick drift does not prevent attract', snap(page)['screen']=='attract')\n    page.evaluate('__pads[0].axes[0]=.8;__game.game.advance(.04)')\n    check('Stick motion wakes attract without choosing a menu item', snap(page)['screen']=='title')\n    context.close()\n\n\ndef touch_profiles(p, browser, check, snap, choose, evidence, url):\n    for device in ['iPhone 13','iPad (gen 7)']:\n        context=browser.new_context(**p.devices[device])\n        page=context.new_page();page.goto(url)\n        page.wait_for_function('window.__game?.app.screen===\\\"title\\\"')\n        choose(page,'SOLO DEFENSE',True)\n        rows=page.evaluate('''()=>{const c=document.querySelector('canvas').getBoundingClientRect();return __game.game.debug.snapshot().rows.map(r=>r.box.h/__game.game.H*c.height)}''')\n        check(device+' has thumb-sized portrait menu targets', min(rows)>=40, rows)\n        choose(page,'CONTROLS & DEPLOY',True)\n        page.screenshot(path=str(evidence/('touch-controls-'+device.split()[0]+'.png')))\n        choose(page,'DEPLOY CANNONS',True)\n        page.wait_for_function('__game.app.sim.s.tick>300')\n        page.evaluate('''()=>{const c=document.querySelector('canvas'),b=c.getBoundingClientRect();window.touchEv=(kind,id,x,y)=>c.dispatchEvent(new PointerEvent(kind,{pointerId:id,pointerType:'touch',isPrimary:id===1,clientX:b.x+x*b.width,clientY:b.y+y*b.height,bubbles:true,cancelable:true}));touchEv('pointerdown',1,.45,.82);touchEv('pointermove',1,.62,.82);touchEv('pointerdown',2,.7,.8)}''')\n        page.wait_for_function('__game.app.sim.s.tutorial.moved && __game.app.sim.s.tutorial.fired')\n        check(device+' relative drag and second contact fire reach combat', snap(page)['touchContacts']==2)\n        page.evaluate(\\\"touchEv('pointercancel',1,.62,.82);touchEv('pointercancel',2,.7,.8)\\\")\n        check(device+' touch cancellation releases every contact', snap(page)['touchContacts']==0)\n        page.screenshot(path=str(evidence/('portrait-'+device.split()[0]+'.png')))\n        page.set_viewport_size({'width':844,'height':390});page.wait_for_timeout(100)\n        check(device+' rotation preserves combat bounds', page.evaluate('ABJ.FIELD.w===480 && ABJ.FIELD.h===270 && __game.app.contacts.size===0'))\n        check(device+' native renderer has no errors', page.evaluate('__game.game.errors.length===0'))\n        context.close()\n\n\ndef storage_and_browsers(p, chromium, check, snap, choose, url):\n    for mode in ['blocked','malformed']:\n        context=chromium.new_context()\n        if mode=='blocked':\n            context.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new Error('Storage blocked by test')}})\\\")\n        else:\n            context.add_init_script(\\\"try{localStorage.setItem('settings:astro-battle-jam-v1','{broken');localStorage.setItem('jam-records-v1','{broken')}catch{}\\\")\n        page=context.new_page();page.goto(url);page.wait_for_function('window.__game?.app.screen===\\\"title\\\"')\n        choose(page,'SOLO DEFENSE');choose(page,'CONTROLS & DEPLOY');choose(page,'DEPLOY CANNONS')\n        check(mode+' storage still permits ordinary play', snap(page)['screen']=='play' and snap(page)['settings']['music']==.1)\n        context.close()\n    for name in ['firefox','webkit']:\n        engine=getattr(p,name);browser=engine.launch()\n        context=browser.new_context(viewport={'width':1280,'height':720})\n        page=context.new_page();errs=[];page.on('pageerror',lambda e:errs.append(str(e)))\n        page.goto(url);page.wait_for_function('window.__game?.app.screen===\\\"title\\\"')\n        choose(page,'SOLO DEFENSE');choose(page,'CONTROLS & DEPLOY');choose(page,'DEPLOY CANNONS')\n        page.keyboard.down('Space');page.keyboard.down('a');page.wait_for_function('__game.app.sim.s.tutorial.fired && __game.app.sim.s.tutorial.moved');page.keyboard.up('Space');page.keyboard.up('a')\n        check(name+' export startup, input and layout smoke', not errs and page.evaluate('__game.game.errors.length===0'),errs)\n        browser.close()\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/browser.py');s=p.read_text().replace('from playwright.sync_api import sync_playwright','from playwright.sync_api import sync_playwright\\\\nfrom browser_extra import more_flows, gamepads, touch_profiles, storage_and_browsers')\ns=s.replace('def choose(page, label):', 'def choose(page, label, touch=False):').replace(\\\"page.mouse.click(point['x'], point['y'])\\\", \\\"(page.touchscreen.tap if touch else page.mouse.click)(point['x'], point['y'])\\\")\ns=s.replace(\\\"        observations['screen'] = snap(page)['screen']\\\", \\\"        more_flows(p, browser, page, check, snap, action, choose, EVIDENCE, URL, observations)\\\\n        observations['screen'] = snap(page)['screen']\\\")\ns=s.replace('        browser.close()', '        page.close()\\\\n        gamepads(browser, check, snap, action, choose, URL)\\\\n        touch_profiles(p, browser, check, snap, choose, EVIDENCE, URL)\\\\n        storage_and_browsers(p, browser, check, snap, choose, URL)\\\\n        browser.close()')\np.write_text(s)\nPY\nnode tools/test.mjs browser\"","aggregated_output":"FAIL Every source and feedback page is reachable and wraps back: \nFAIL A click wake cannot also activate a title item: lobby\nFAIL iPhone 13 relative drag and second contact fire reach combat: \nFAIL iPad (gen 7) relative drag and second contact fire reach combat:\n52 checks, 4 failures\n","exit_code":1,"status":"failed"}}
