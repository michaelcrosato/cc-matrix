{"type":"item.completed","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -lc \"sed -n '133,172p' src/app.js\nsed -n '184,211p' tests/browser_extra.py\nrg -n 'fail|exception|errors|error' evidence/browser-tests.json | head -8\"","aggregated_output":"    const r = app.report;\n    const pages = [{ title: 'THE CARTRIDGE', body: 'Astro Battle Jam\\nOriginal art, formations, repair rules and flagship.\\nBuilt with my-3D2dge v0.89.1 (MIT).\\nHub session client 1.4.0, Protocol v1.\\nStandalone: solo or local co-op.\\nAI Hub: online shared-world co-op for 1-2 seats.\\nNo external matchmaking. No asset or audio downloads.' }];\n    if (!r) return pages;\n    const labels = { date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art direction', animation: 'Animation', audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage' };\n    for (const [k, v] of Object.entries(r.sourceInformation)) pages.push({ title: 'SOURCE INFORMATION / ' + labels[k], body: v });\n    const qs = A.REPORT_QUESTIONS;\n    for (const [key, title] of [['testingFeedback', 'TESTING FEEDBACK'], ['engineFeedback', 'ENGINE FEEDBACK'], ['promptFeedback', 'PROMPT FEEDBACK']]) r[key].forEach((v, i) => pages.push({ title: title + ' / ' + (i + 1), body: qs[key][i] + '\\n\\n' + v }));\n    const scale = game.H > 400 ? 2 : 1;\n    const buttonY = game.H > 400 ? Math.round(game.H * .64) : 192;\n    const bodyY = game.H > 400 ? Math.round(game.H * .34) + 24 : 97;\n    const capacity = Math.max(5, Math.floor((buttonY - bodyY - 10) / E.font.lineHeight({ scale })));\n    const paged = [];\n    for (const page of pages) {\n      const lines = E.font.wrap(page.body, Math.min(390, game.W - 70), { scale });\n      for (let at = 0; at < lines.length; at += capacity) paged.push({ title: page.title + (lines.length > capacity ? ' / ' + (Math.floor(at / capacity) + 1) : ''), body: lines.slice(at, at + capacity).join('\\n') });\n    }\n    return paged;\n  }\n  function layoutRows() {\n    if (!isMenu()) { app.rows = []; layoutFieldUI(); return; }\n    if (app.screen === 'about') app.aboutPage = Math.max(0, Math.min(app.aboutPage, aboutPages().length - 1));\n    const spec = menuSpec(), W = game.W, H = game.H, title = app.screen === 'title', custom = ['controls', 'about', 'records', 'results', 'state'].includes(app.screen);\n    const width = title && H < 400 ? 220 : Math.min(420, W - 48), x = title && H < 400 ? W - width - 24 : Math.round((W - width) / 2);\n    let y = title ? (H > 400 ? Math.max(300, H * .4) : 77) : Math.max(65, Math.round(H / 2 - 73));\n    if (custom) y = H > 400 ? Math.round(H * .64) : app.screen === 'about' ? 192 : app.screen === 'controls' ? 203 : app.screen === 'results' ? 185 : 185;\n    if (app.screen === 'lobby') y += 32;\n    const h = H > 400 ? 56 : app.touch ? 32 : title ? 23 : custom ? 21 : 25;\n    app.rows = spec.rows.map((row, i) => ({ ...row, box: { x, y: y + i * (h + (H > 400 ? 8 : custom ? 2 : 3)), w: width, h } }));\n    app.focus = Math.max(0, Math.min(app.rows.length - 1, app.focus)); app.spec = spec;\n    layoutFieldUI();\n  }\n  function layoutFieldUI() {\n    const W = game.W, H = game.H;\n    const off = view.offset(); app.menuBox = { x: off.x + 425, y: off.y + 34, w: 37, h: 20 };\n    const p = state()?.ships?.find(q => q.id === (app.session?.info.me ?? 0));\n    app.repairBox = { x: W - 146, y: H > 400 ? off.y + 295 : H - 51, w: 120, h: H > 400 ? 52 : 28 };\n    if (p && app.touch) { const proxy = Object.create(A.Sim.prototype); proxy.s = state(); app.canTouchRepair = proxy.repairTarget(p).usable; } else app.canTouchRepair = false;\n  }\n\n  function rowValue(row) {\n        page.wait_for_function('__game.app.sim.s.tutorial.moved && __game.app.sim.s.tutorial.fired')\n        check(device+' relative drag and second contact fire reach combat', snap(page)['touchContacts']==2)\n        page.wait_for_function('__game.app.sim.s.ships[0].x >= 294')\n        page.evaluate(\"touchEv('pointermove',1,.45,.82)\")\n        page.wait_for_function('__game.app.canTouchRepair')\n        b=page.evaluate('__game.app.repairBox')\n        point=page.evaluate('(b)=>{const c=document.querySelector(\"canvas\").getBoundingClientRect();return {x:c.x+(b.x+b.w/2)/__game.game.W*c.width,y:c.y+(b.y+b.h/2)/__game.game.H*c.height}}',b)\n        page.touchscreen.tap(point['x'],point['y'])\n        page.wait_for_function('__game.app.sim.s.ships[0].repairs>0')\n        check(device+' contextual repair spends the held salvage charge', snap(page)['world']['ships'][0]['charges']==0)\n        page.evaluate(\"touchEv('pointercancel',1,.62,.82);touchEv('pointercancel',2,.7,.8)\")\n        check(device+' touch cancellation releases every contact', snap(page)['touchContacts']==0)\n        page.screenshot(path=str(evidence/('portrait-'+device.split()[0]+'.png')))\n        page.evaluate('__game.game.stop();__game.game.debug.title();__game.game.advance(10.2)')\n        page.touchscreen.tap(20,20);page.evaluate('__game.game.advance(.08)')\n        check(device+' touch wake is consumed on title', snap(page)['screen']=='title')\n        page.evaluate('__game.game.start()')\n        page.wait_for_function('__game.app.uiTime >= (__game.app.wakeGuard || 0)')\n        choose(page,'ABOUT / CREDITS',True)\n        page.evaluate('__game.app.aboutPage=__game.game.debug.aboutPages().length-1')\n        page.set_viewport_size({'width':844,'height':390});page.wait_for_timeout(100)\n        check(device+' rotation preserves combat bounds', page.evaluate('ABJ.FIELD.w===480 && ABJ.FIELD.h===270 && __game.app.contacts.size===0'))\n        rotation = page.evaluate('({errors:__game.game.errors,page:__game.app.aboutPage,count:__game.game.debug.aboutPages().length,H:__game.game.H,W:__game.game.W,screen:__game.app.screen,guard:__game.app.wakeGuard,ui:__game.app.uiTime})')\n        check(device+' credits reflow