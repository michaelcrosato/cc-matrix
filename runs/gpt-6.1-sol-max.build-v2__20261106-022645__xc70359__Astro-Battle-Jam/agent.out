{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/app.js');s=p.read_text()\ns=s.replace(\\\"if (app.screen === 'attract') { title(); return true; }\\\", \\\"if (app.screen === 'attract') { title(); app.wakeGuard = app.uiTime + .5; return true; }\\\")\ns=s.replace(\\\"if (wake()) { e.preventDefault(); return; }\\\", \\\"if (wake() || app.uiTime < (app.wakeGuard || 0)) { e.preventDefault(); clearInput(); return; }\\\")\ns=s.replace(\\\"if (wake()) { e.preventDefault(); clearInput(); return; }\\\", \\\"if (wake() || app.uiTime < (app.wakeGuard || 0)) { e.preventDefault(); clearInput(); return; }\\\")\ns=s.replace(\\\"game.input.touchEnabled = false; game.input.touchFilter = () => false;\\\", \\\"game.settings.define({ ...game.settings.spec('touch'), value: 'off' }); game.settings.set('touch', 'off');\\\\n    game.input.touchEnabled = false; game.input.touchFilter = () => false;\\\")\np.write_text(s)\np=Path('src/sim.js');s=p.read_text().replace(\\\"text: 'THE BIG RUDE. BREAK BOTH BLUE EMITTERS.'\\\", \\\"text: phase === 1 ? 'THE BIG RUDE. BREAK BOTH BLUE EMITTERS.' : 'CORE EXPOSED. WATCH THE LANES.'\\\")\np.write_text(s)\np=Path('src/view.js');s=p.read_text()\ns=s.replace(\\\"for (let x = 22; x < 458; x += 9) tr(g, x, A.FIELD.breach, 4, 1, '#8b6070');\\\", \\\"for (let x = 22; x < 458; x += 9) if (\"'!s.bunkers.some(b => x + 4 > b.x && x < b.x + 48)) tr(g, x, A.FIELD.breach, 4, 1, '\"'#8b6070');\\\")\ns=s.replace(\\\"s.boss ? 'BLUE EMITTERS OPEN BEFORE EACH VOLLEY.'\\\", \\\"s.boss ? (s.boss.phase === 1 ? 'BLUE EMITTERS OPEN BEFORE EACH VOLLEY.' : 'EXPOSED CORE. READ THE TELEGRAPHED LANES.')\\\")\np.write_text(s)\np=Path('src/assets.js');s=p.read_text()\ns=s.replace(\\\"    return E.sprite(rows,\\\", \\\"    const grid = Array.from({ length: rows.length + 2 }, () => Array(Math.max(...rows.map(r => r.length)) + 2).fill('.'));\\\\n    rows.forEach((row, y) => [...row