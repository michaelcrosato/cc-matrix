{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '551,840p' GUIDE.md\"","aggregated_output":"  }\n\n  async setup(ctx) {\n    const { scene, physics, palette } = ctx;\n    const parts = [];\n    for (const [x0, x1, top] of this.data.platforms) {\n      const w = x1 - x0;\n      const h = top + 4; // every platform reaches down out of view\n      physics.addStaticBox({ position: [(x0 + x1) / 2, top - h / 2, 0], halfExtents: [w / 2, h / 2, 2] });\n      const body = new Mesh(new BoxGeometry(w, h, 4), toonMaterial(palette.sand));\n      body.position.set((x0 + x1) / 2, top - h / 2, 0);\n      const grass = new Mesh(new BoxGeometry(w + 0.1, 0.3, 4.1), toonMaterial(palette.green));\n      grass.position.set((x0 + x1) / 2, top - 0.14, 0);\n      for (const m of [body, grass]) m.receiveShadow = m.castShadow = true;\n      parts.push(body, grass);\n    }\n    // The flag: no collider, a trigger ends the level.\n    const pole = new Mesh(new CylinderGeometry(0.06, 0.06, 3, 6), toonMaterial(palette.white));\n    pole.position.set(this.data.flag, 1.5, -1);\n    const cloth = new Mesh(new BoxGeometry(0.9, 0.6, 0.06), toonMaterial(palette.red));\n    cloth.position.set(this.data.flag + 0.45, 2.65, -1);\n    parts.push(pole, cloth);\n    scene.add(...mergeStaticMeshes(parts));\n    physics.trigger({ box: [0.5, 2, 2] }, [this.data.flag, 2, 0], { tag: 'character', once: true, onEnter: () => this.clear(ctx) });\n\n    // Scenery behind the lane: trees (a built-in model) and clouds.\n    const tree = await ctx.loadModel('assets/tree.glb');\n    for (const x of [2, 25, 41]) {\n      const t = tree.scene.clone(true);\n      t.position.set(x, 0, -1.4);\n      scene.add(t);\n    }\n    for (const [x, y] of [[0, 7], [14, 8], [30, 6.5], [44, 7.5]]) {\n      const cloud = new Mesh(new BoxGeometry(3, 0.8, 0.8), toonMaterial(palette.white));\n      cloud.position.set(x, y, -6);\n      scene.add(cloud);\n    }\n\n    // Slimes: a squashed sphere with eyes, patrolling; stomp them from above.\n    for (const [x, range] of this.data.slimes) {\n      const mesh = new Group();\n      const blob = new Mesh(new SphereGeometry(0.45, 12, 8), toonMaterial(palette.lime));\n      blob.scale.y = 0.7;\n      blob.position.y = 0.3;\n      blob.castShadow = true;\n      mesh.add(blob);\n      for (const ex of [-0.15, 0.15]) {\n        const eye = new Mesh(new BoxGeometry(0.1, 0.14, 0.05), toonMaterial(palette.ink));\n        eye.position.set(ex, 0.42, 0.4);\n        mesh.add(eye);\n      }\n      mesh.position.set(x, 0, 0);\n      setLookLayer(mesh, 'actors');\n      scene.add(mesh);\n      this.slimes.push({ mesh, x, range, phase: x, dead: false });\n    }\n\n    const hero = await ctx.loadModel(HERO_MODEL, { castShadow: false });\n    this.model = hero.scene;\n    setLookLayer(this.model, 'actors');\n    this.shadow = new ContactShadow(0.42);\n    scene.add(this.model, this.shadow);\n    this.hero = new PlatformerCharacter(physics, { position: START, lockDepth: ctx.camera.lockDepth });\n    this.hero.attachModel(this.model, compileClips(HERO_CLIPS, HERO_RIG, this.model), HERO_RIG);\n  }\n\n  clear(ctx) {\n    this.clearedAt = ctx.time;\n    this.hero.celebrate();\n    ctx.audio.play('fanfare');\n    ctx.particles.burst('sparkle', [this.data.flag, 3, -1], { count: 30 });\n  }\n\n  fixedUpdate(ctx, dt) {\n    this.input = readMoveInput(ctx, this.hero, this.input);\n    if (this.clearedAt !== null) this.input.move.set(0, 0, 0); // level clear: stand still and celebrate\n    this.hero.fixedUpdate(dt, this.input);\n    const f = this.hero.feetInto(this.feet);\n    for (const s of this.slimes) {\n      if (s.dead) continue;\n      s.phase += dt * 1.3;\n      s.mesh.position.x = s.x + Math.sin(s.phase) * s.range;\n      const dx = f.x - s.mesh.position.x;\n      if (Math.abs(dx) > 0.7 || f.y > 0.9 || f.y < -0.3) continue;\n      if (this.hero.vy < 0 && f.y > 0.3) {\n        // landed on it: stomp and bounce\n        s.dead = true;\n        s.mesh.visible = false;\n        this.stomps++;\n        ctx.audio.play('punch');\n        ctx.particles.burst('impact', s.mesh.position);\n        this.hero.jump('Jump');\n      } else if (this.hero.hurt(this.from.set(-dx, 0, 0))) {\n        // `from` points from the hero to what hit it (slime - hero): knocked back the other way\n        ctx.audio.play('hurt');\n      }\n    }\n    if (f.y < -8) {\n      this.falls++;\n      ctx.audio.play('hurt');\n      this.hero.teleport(START);\n    }\n  }\n\n  update(ctx, dt) {\n    this.startTime ??= ctx.time;\n    this.hero.updateVisual(this.model, dt, ctx.physics.alpha);\n    const feet = this.model.position;\n    const ground = ctx.physics.groundBelow(this.target.set(feet.x, feet.y + 0.1, feet.z), 20, this.hero.body);\n    this.shadow.visible = !!ground;\n    if (ground) this.shadow.place(feet.x, ground.y, feet.z, feet.y - ground.y);\n    if (this.clearedAt !== null && ctx.time - this.clearedAt > 2.5 && !this.leaving) {\n      this.leaving = true;\n      void ctx.engine.loadGame(new CliffRun((this.level + 1) % LEVELS.length));\n    }\n    const time = (this.clearedAt ?? ctx.time) - this.startTime;\n    ctx.hud.clear();\n    ctx.hud.text(6, 6, `LEVEL ${this.level + 1}`, { color: 'sand' });\n    ctx.hud.text(6, 16, `TIME ${time.toFixed(1)}  STOMPS ${this.stomps}`);\n    if (this.clearedAt !== null) ctx.hud.text(0, 0, 'LEVEL CLEAR!', { anchor: 'center', scale: 2, shadow: 'navy' });\n  }\n\n  cameraTarget() {\n    const p = this.model?.position ?? this.feet.set(...START);\n    return this.target.set(p.x, p.y + 1.2, p.z);\n  }\n\n  onCameraChange(ctx) {\n    this.hero.setLockDepth(ctx.camera.lockDepth);\n    this.model.visible = !ctx.camera.hidesTarget;\n  }\n\n  status() {\n    return `level ${this.level + 1}${this.clearedAt !== null ? ' clear' : ''}, stomps ${this.stomps}, falls ${this.falls}`;\n  }\n}\n\nawait Engine.start(new CliffRun(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'side', zoom: 1.2 }, background: PALETTE.sky }));\n```\n\n### Top-down at night: lights, pushable crates, music, custom particles\n\n```js top-down\n// Lantern Night: walk (WASD / arrows), push both crates onto the glowing pads (walk into a\n// crate to push it), then leave through the gate in the north wall.\nimport { compileClips, ContactShadow, Engine, HERO_CLIPS, HERO_MODEL, HERO_RIG, LOOK_PRESETS, mergeStaticMeshes, PALETTE, PlatformerCharacter, RAPIER, readMoveInput, setLookLayer, THREE, toonMaterial, withUrlOptions } from './pixel-engine.js';\n\nconst { BoxGeometry, Color, CylinderGeometry, Mesh, Vector3 } = THREE;\n\nconst SONG = {\n  bpm: 84,\n  tracks: { lead: { wave: 'triangle', decay: 0.3, volume: 0.12 }, bass: { wave: 'square', duty: 0.125, decay: 0.25, volume: 0.05 } },\n  patterns: { a: { lead: 'A4 . C5 . E5 . . . D5 . C5 . B4 . . .', bass: 'A2 . . . . . . . F2 . . . . . . .' } },\n  order: ['a'],\n};\nconst PADS = [[-3, -4], [3, -4]];\nconst CRATES = [[-3, 1], [3, 1]];\n\nclass LanternNight {\n  name = 'Lantern Night';\n  assets = [HERO_MODEL, 'assets/tree.glb'];\n  crates = [];\n  pads = [];\n  solved = false;\n  escaped = false;\n  nextFirefly = 0;\n  target = new Vector3();\n  at = new Vector3();\n\n  async setup(ctx) {\n    const { scene, physics, palette, engine } = ctx;\n    this.sparkle = ctx.random.fork('fireflies'); // drawn per frame (cosmetic): its own stream, so gameplay's never depends on the frame rate\n    // Night: dim the engine's sun and ambient light (reset for the next game on unload).\n    engine.sun.color.setHex(PALETTE.sky);\n    engine.sun.intensity = 1.2;\n    engine.ambient.color.setHex(PALETTE.navy);\n    engine.ambient.intensity = 1.4;\n    scene.background = new Color(PALETTE.ink);\n\n    const parts = [];\n    const wall = (x, z, w, d) => {\n      physics.addStaticBox({ position: [x, 0.6, z], halfExtents: [w / 2, 0.6, d / 2] });\n      const m = new Mesh(new BoxGeometry(w, 1.2, d), toonMaterial(palette.slate));\n      m.position.set(x, 0.6, z);\n      m.castShadow = m.receiveShadow = true;\n      parts.push(m);\n    };\n    const floor = new Mesh(new BoxGeometry(30, 1, 30), toonMaterial(palette.teal));\n    floor.position.y = -0.5;\n    floor.receiveShadow = true;\n    parts.push(floor);\n    physics.addStaticBox({ position: [0, -0.5, 0], halfExtents: [15, 0.5, 15] });\n    wall(-4.75, -8, 6.5, 1); // north wall, with a 3 m gap for the gate\n    wall(4.75, -8, 6.5, 1);\n    wall(0, 8, 17, 1);\n    wall(-8, 0, 1, 15);\n    wall(8, 0, 1, 15);\n    for (const [x, z] of [[-6.5, -6.5], [6.5, -6.5], [-6.5, 6.5], [6.5, 6.5]]) {\n      const post = new Mesh(new CylinderGeometry(0.12, 0.15, 1.6, 6), toonMaterial(palette.plum));\n      post.position.set(x, 0.8, z);\n      parts.push(post);\n      ctx.lights.request({ position: [x, 1.8, z], color: 0xffa040, intensity: 7, radius: 7, flicker: 'torch' });\n    }\n    scene.add(...mergeStaticMeshes(parts));\n\n    // The gate: a collider we remove when the puzzle is solved.\n    this.gate = new Mesh(new BoxGeometry(3, 1.6, 0.6), toonMaterial(palette.red));\n    this.gate.position.set(0, 0.8, -8);\n    scene.add(this.gate);\n    this.gateCollider = physics.addStaticBox({ position: [0, 0.8, -8], halfExtents: [1.5, 0.8, 0.3] });\n    physics.trigger({ box: [1.5, 1, 0.5] }, [0, 1, -9.2], { tag: 'character', once: true, onEnter: () => this.escape(ctx) });\n\n    // Pads and crates. A crate is a dynamic Rapier body the hero pushes (tag 'pushable').\n    for (const [x, z] of PADS) {\n      const mesh = new Mesh(new BoxGeometry(1.2, 0.06, 1.2), toonMaterial(palette.navy));\n      mesh.position.set(x, 0.03, z);\n      scene.add(mesh);\n      this.pads.push({ x, z, mesh, lit: false });\n    }\n    for (const [x, z] of CRATES) {\n      const mesh = new Mesh(new BoxGeometry(0.98, 0.98, 0.98), toonMaterial(palette.orange));\n      mesh.castShadow = mesh.receiveShadow = true;\n      setLookLayer(mesh, 'actors');\n      scene.add(mesh);\n      const body = physics.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, 0.5, z).setLinearDamping(4).enabledRotations(false, false, false));\n      physics.tag(physics.world.createCollider(RAPIER.ColliderDesc.cuboid(0.49, 0.49, 0.49).setFriction(0.1).setDensity(8), body), 'pushable');\n      physics.bind(body, mesh);\n      this.crates.push(body);\n    }\n\n    const tree = await ctx.loadModel('assets/tree.glb');\n    for (let i = 0; i < 14; i++) {\n      const a = (i / 14) * Math.PI * 2;\n      const t = tree.scene.clone(true);\n      t.position.set(Math.cos(a) * 11.5, 0, Math.sin(a) * 11.5);\n      scene.add(t);\n    }\n\n    const hero = await ctx.loadModel(HERO_MODEL, { castShadow: false });\n    this.model = hero.scene;\n    setLookLayer(this.model, 'actors');\n    this.shadow = new ContactShadow(0.42);\n    scene.add(this.model, this.shadow);\n    this.hero = new PlatformerCharacter(physics, { position: [0, 0, 5], lockDepth: ctx.camera.lockDepth });\n    this.hero.attachModel(this.model, compileClips(HERO_CLIPS, HERO_RIG, this.model), HERO_RIG);\n    ctx.lights.request({ follow: this.model, offset: [0, 1.5, 0], color: 0xffe0a0, intensity: 5, radius: 6, priority: 8 }); // the lantern\n\n    ctx.particles.register('firefly', { count: [1, 1], life: [1.5, 2.5], speed: [0.2, 0.5], gravity: -0.2, size: [1, 1], colors: ['lime', 'sand', 'lime'] });\n    ctx.audio.register('chime', { wave: 'triangle', freq: 880, decay: 0.4, volume: 0.3, arp: [0, 4, 7], arpRate: 0.06 });\n    ctx.audio.playMusic(SONG, 'night');\n  }\n\n  escape(ctx) {\n    this.escaped = true;\n    this.hero.celebrate();\n    ctx.audio.play('fanfare');\n  }\n\n  fixedUpdate(ctx, dt) {\n    this.input = readMoveInput(ctx, this.hero, this.input);\n    if (this.escaped) this.input.move.set(0, 0, 0); // the end: stand and celebrate\n    this.hero.fixedUpdate(dt, this.input);\n  }\n\n  update(ctx, dt) {\n    this.hero.updateVisual(this.model, dt, ctx.physics.alpha);\n    const feet = this.model.position;\n    this.shadow.place(feet.x, 0, feet.z, feet.y); // flat floor: the ground is y = 0\n    // A pad lights when a crate sits on it; both lit opens the gate.\n    for (const pad of this.pads) {\n      const on = this.crates.some((b) => Math.hypot(b.translation().x - pad.x, b.translation().z - pad.z) < 0.5);\n      if (on && !pad.lit) {\n        pad.lit = true;\n        pad.mesh.material = toonMaterial(ctx.palette.lime);\n        ctx.lights.request({ position: [pad.x, 0.6, pad.z], color: 0x9cf060, intensity: 5, radius: 4, flicker: 'pulse' });\n        ctx.audio.play('chime');\n      }\n    }\n    if (!this.solved && this.pads.every((p) => p.lit)) {\n      this.solved = true;\n      ctx.physics.remove(this.gateCollider);\n      this.gate.visible = false;\n      ctx.particles.burst('smoke', this.gate.position, { count: 24 });\n      ctx.audio.play('groundPound');\n    }\n    if (ctx.time > this.nextFirefly) {\n      this.nextFirefly = ctx.time + 0.3;\n      ctx.particles.burst('firefly', this.at.set(this.sparkle.range(-7, 7), this.sparkle.range(0.5, 2), this.sparkle.range(-7, 7)));\n    }\n    const lit = this.pads.filter((p) => p.lit).length;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '841,1115p' GUIDE.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '841,1115p' GUIDE.md\"","aggregated_output":"    ctx.hud.clear();\n    ctx.hud.text(6, 6, this.escaped ? 'YOU ESCAPED!' : this.solved ? 'THE GATE IS OPEN' : `PADS ${lit}/${this.pads.length}`, { color: 'sand' });\n  }\n\n  cameraTarget() {\n    const p = this.model?.position ?? this.target.set(0, 0, 5);\n    return this.target.set(p.x, p.y + 0.9, p.z);\n  }\n\n  status() {\n    return this.escaped ? 'escaped' : `pads ${this.pads.filter((p) => p.lit).length}/${this.pads.length}`;\n  }\n}\n\nawait Engine.start(new LanternNight(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'topdown', zoom: 1.1 }, look: LOOK_PRESETS.dream }));\n```\n\n### Looks: mixing art styles per layer\n\n```js looks\n// Look Lab: one scene, six looks. Keys 1-6 pick a look, T toggles chunky pixels on the custom\n// one. Walk around (WASD): characters & objects (the 'actors' layer) and the environment each\n// get their own look.\nimport { compileClips, Engine, HERO_CLIPS, HERO_MODEL, HERO_RIG, LOOK_PRESETS, mergeStaticMeshes, PlatformerCharacter, readMoveInput, setLookLayer, THREE, toonMaterial, withUrlOptions } from './pixel-engine.js';\n\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\n\n// A look of our own: pixel-art characters on a clean, cel-shaded world, a vignette on top.\nconst STORYBOOK_HEROES = {\n  scene: [{ id: 'vignette', params: { intensity: 0.35 } }],\n  actors: { pixel: { size: 1, outline: 0.85, crease: 0.2 }, filters: [{ id: 'nes' }] },\n  environment: { pixel: null, filters: [{ id: 'cel', params: { bands: 4, ink: 0.6 } }] },\n};\nconst LOOKS = [\n  ['default', LOOK_PRESETS.none],\n  ['storybook heroes', STORYBOOK_HEROES],\n  ['pixel heroes', LOOK_PRESETS.pixel_heroes],\n  ['noir', LOOK_PRESETS.noir],\n  ['sin city', LOOK_PRESETS.sin_city],\n  ['handheld', LOOK_PRESETS.handheld],\n];\n\nclass LookLab {\n  name = 'Look Lab';\n  assets = [HERO_MODEL, 'assets/coin.glb', 'assets/tree.glb'];\n  current = 1;\n  target = new Vector3();\n\n  async setup(ctx) {\n    const { scene, physics, palette } = ctx;\n    const parts = [];\n    for (const [x, z, w, h, d, c] of [[0, 0, 16, 1, 12, 'green'], [-4, -3, 2, 2, 2, 'slate'], [4, -3, 3, 1, 2, 'sand'], [0, -5, 6, 3, 1, 'plum']]) {\n      const y = c === 'green' ? -0.5 : h / 2;\n      physics.addStaticBox({ position: [x, y, z], halfExtents: [w / 2, h / 2, d / 2] });\n      const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(palette[c]));\n      m.position.set(x, y, z);\n      m.castShadow = m.receiveShadow = true;\n      parts.push(m);\n    }\n    scene.add(...mergeStaticMeshes(parts));\n    for (const [x, z] of [[-6, 3], [6, 2], [-2, -4]]) {\n      const tree = await ctx.loadModel('assets/tree.glb'); // environment: no layer tag\n      tree.scene.position.set(x, 0, z);\n      scene.add(tree.scene);\n    }\n    // Objects on the actors layer: coins and a crate.\n    const coin = await ctx.loadModel('assets/coin.glb');\n    this.coins = [[-1.5, 0.6, 1], [0, 0.6, 1], [1.5, 0.6, 1]].map(([x, y, z]) => {\n      const c = coin.scene.clone(true);\n      c.position.set(x, y, z);\n      setLookLayer(c, 'actors');\n      scene.add(c);\n      return c;\n    });\n    const crate = new Mesh(new BoxGeometry(1, 1, 1), toonMaterial(palette.orange));\n    crate.position.set(3, 0.5, 2);\n    crate.castShadow = true;\n    setLookLayer(crate, 'actors');\n    scene.add(crate);\n    physics.addStaticBox({ position: [3, 0.5, 2], halfExtents: [0.5, 0.5, 0.5] });\n\n    const hero = await ctx.loadModel(HERO_MODEL);\n    this.model = hero.scene;\n    setLookLayer(this.model, 'actors');\n    scene.add(this.model);\n    this.hero = new PlatformerCharacter(physics, { position: [0, 0, 3], lockDepth: ctx.camera.lockDepth });\n    this.hero.attachModel(this.model, compileClips(HERO_CLIPS, HERO_RIG, this.model), HERO_RIG);\n  }\n\n  fixedUpdate(ctx, dt) {\n    this.input = readMoveInput(ctx, this.hero, this.input);\n    this.hero.fixedUpdate(dt, this.input);\n  }\n\n  update(ctx, dt) {\n    this.hero.updateVisual(this.model, dt, ctx.physics.alpha);\n    for (const c of this.coins) c.rotation.y += dt * 2;\n    for (let i = 0; i < LOOKS.length; i++) {\n      if (ctx.input.wasPressed(`Digit${i + 1}`)) {\n        this.current = i;\n        ctx.engine.setLook(LOOKS[i][1]);\n      }\n    }\n    if (ctx.input.wasPressed('KeyT')) {\n      // Parameters and pixel sizes are uniforms: changing them never rebuilds the pipeline.\n      STORYBOOK_HEROES.actors.pixel.size = STORYBOOK_HEROES.actors.pixel.size === 1 ? 3 : 1;\n      if (this.current === 1) ctx.engine.setLook(STORYBOOK_HEROES);\n    }\n    ctx.hud.clear();\n    ctx.hud.text(6, 6, `LOOK ${this.current + 1}/${LOOKS.length}: ${LOOKS[this.current][0].toUpperCase()}`, { color: 'sand' });\n    ctx.hud.text(6, 6, '1-6 LOOKS  T CHUNKY', { anchor: 'bottom-left' });\n  }\n\n  cameraTarget() {\n    const p = this.model?.position ?? this.target.set(0, 0, 3);\n    return this.target.set(p.x, p.y + 0.9, p.z);\n  }\n\n  status() {\n    return `look ${LOOKS[this.current][0]}`;\n  }\n}\n\nawait Engine.start(new LookLab(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'iso', zoom: 1.3 }, look: STORYBOOK_HEROES }));\n```\n\n## 6. Rules\n\n1. **Import everything from `./pixel-engine.js`.** three.js is `THREE` (`three/webgpu`) and\n   `TSL`; Rapier is `RAPIER`. Never load three.js or Rapier from a CDN or npm as well: two\n   copies break `instanceof` checks and the renderer.\n2. **Never edit `pixel-engine.js`.** Upgrade by replacing it (section 10).\n3. **No WebGL-era three.js APIs.** The renderer is `WebGPURenderer`: `WebGLRenderer`,\n   `EffectComposer`, `ShaderMaterial`, `onBeforeCompile` and GLSL don't work. Custom shading is\n   TSL on node materials; post effects are looks.\n4. **Gameplay in `fixedUpdate`, presentation in `update`.** Move characters and apply forces at\n   the fixed 60 Hz step; animate, spin pickups and draw the HUD per frame. Use `ctx.time`\n   (it stops while paused) and the `dt` you are given, never `performance.now()`. Anything\n   random comes from `ctx.random` (`range`, `int`, `chance`, `pick`, `fork`), never\n   `Math.random`: the same seed (`?seed=`) and input then replay the same game\n   (`engine.recording()`, `engine.replay()`, section 8). Draw it in `setup`, `fixedUpdate` and\n   event handlers; randomness drawn per frame in `update` (cosmetic) comes from a fork made in\n   `setup`, so the frame rate never changes what gameplay draws. Read buttons from `ctx.input`\n   (mouse buttons are keys: `isDown('MouseLeft')`; a finger is `Touch`), and data from the page (a save in storage, a\n   text field) through `ctx.input.send(data)` → `ctx.input.commands` next frame, so they replay too.\n5. **Physics owns positions.** Don't set `mesh.position` on things with bodies: `physics.bind`\n   them, or let the character controller pose its model. Static blocks: one collider each,\n   the same size as the mesh.\n6. **Palette colours and toon materials** (`toonMaterial(palette.x)`), chunky shapes (≥ 0.25 m).\n   Other materials render, but break the look.\n7. **Lights come from `ctx.lights`**, never `new PointLight()`. Dim `ctx.engine.sun` and\n   `ctx.engine.ambient` for night scenes.\n8. **Tag characters and objects** with `setLookLayer(root, 'actors')`, so looks can treat\n   them apart from the environment.\n9. **Reuse vectors in per-frame code** (`hero.feetInto(v)`, a `target` vector for\n   `cameraTarget`): no garbage per frame.\n10. **Give `status()` a meaningful line** (score, lives, level, state): the check tool and\n   other agents read it.\n11. **Clean up what the engine doesn't own**: DOM you add, timers and listeners go in `dispose(ctx)`.\n\n## 7. Common mistakes\n\n| Symptom | Cause | Fix |\n| --- | --- | --- |\n| Blank page, console: CORS / \"Failed to load module script\" | opened with `file://` | serve the folder over HTTP |\n| Console: \"Multiple instances of Three.js being imported\" | three.js loaded twice | use `THREE` from the bundle, nothing else |\n| A red **GAME ERROR** box | an exception in a hook | the box and `engine.errors` have the message, the console the stack: fix the first one |\n| \"Failed to start: ...\" | `setup()` threw (often a bad model path or a typo'd name) | read the message; check the path or the name in API.md |\n| The hero falls through the world | no collider under the mesh | `physics.addStaticBox` for every solid block |\n| The hero is stuck at the start | spawned inside a block | `position` is the feet: put it on the top surface |\n| A trigger never fires | wrong tag, or it doesn't overlap the body | `tag: 'character'` only matches the hero; level geometry needs `includeStatic: true` |\n| A colour is black or a material missing | a colour name that isn't in the palette | the 16 names in section 4 |\n| A model 404s | path not relative to the page | `assets/x.glb` next to `index.html`; built-ins need no file |\n| HUD text shows gaps | characters the 5×7 font doesn't have | uppercase letters, digits, common punctuation |\n| A key does nothing in `fixedUpdate` | `wasPressed` there | `consumePress` in `fixedUpdate`, `wasPressed` in `update` |\n| The ⚙ sits over the HUD's top-right corner on a phone | the settings button (on a mouse it shows only while the pointer moves) | `settings: { button: 'top-left' }`, or `false` and `engine.settings.open()` from your own menu |\n| Side-scroller hero drifts off the lane | `lockDepth` not passed | `lockDepth: ctx.camera.lockDepth` |\n| The camera doesn't follow | `cameraTarget` returns nothing before `setup` ends | return a fallback vector (see the quick start) |\n| Slow, low fps | hundreds of separate meshes | `mergeStaticMeshes` the static level; share materials (`toonMaterial` caches) |\n| Everything is dark | a dimmed sun with no lights | `ctx.lights.request(...)` torches, or raise `ctx.engine.ambient.intensity` |\n| No sound | the browser waits for a key or tap | expected: sound starts on the first input |\n\n## 8. Debugging and checking\n\nThe engine is on `window.__PIXEL_ENGINE__` once it runs (also the value `Engine.start` returns).\nA tool waits on `window.__PIXEL_READY__` (it resolves with the engine, or rejects with why the start\nfailed); a game puts its own page handles in `ready(ctx)`, which runs then and after each `loadGame`.\n\n```js\nconst e = await window.__PIXEL_READY__;   // step() before this throws\ne.state();                // version, backend, fps, camera, look, game status, errors, gpuErrors, ...\ne.errors;                 // exceptions thrown by the game's hooks in the render loop (also on screen)\ne.step(60);               // manual time: exactly 60 frames (1 s), a hook's exception thrown to you; e.manual = false resumes\n                          // step() draws nothing, so a page screenshot still shows the old frame: read the new one with\n                          // await e.renderer.capture() (pixels, no HUD), or set e.manual = false and let a frame draw\ne.input.setKey('KeyD', true); e.step(30); e.input.setKey('KeyD', false);  // play by script\nconst rec = e.recording(); const end = e.fingerprint();            // this level's input as JSON, a hash of its state\nawait e.replay(rec, () => e.loadGame(new MyGame())); e.fingerprint() === end;  // replayed: the same game\n// Engine.headless(game, { assets }): the same game in Node (below)\nconst snap = await e.snapshot(); e.step(300); await e.restore(snap);   // a save-state (Game.snapshot / restore): back at once\nawait e.renderer.capture();   // { width, height, pixels }: the exact frame (without the HUD canvas)\ne.game;                   // your game object: e.game.hero.teleport([x, y, z]) to test a spot\ne.setLook(e.lookPresets.noir); e.setCamera({ preset: 'third' }, { syncUrl: false });\ne.audio.counts; e.particles.alive; e.physics.counts(); e.hud.canvas;\n```\n\nURL flags (with `withUrlOptions` in `Engine.start`): `?debug=1` (debug panel),\n`?look=noir`, `?filters=crt,scanlines`,\n`?camera=third`, `?zoom=1.5`, `?mode=raw` (no pixel pass), `?res=320`, `?touch=1`,\n`?quality=low`, `?fps=30`, `?seed=7` (`ctx.random`); they win over the player's saved settings\n(`e.settings.values`). Hotkeys, with `?debug=1`: P pixel/raw, R resolution, \\` debug panel, [ and ]\ncycle looks, M mute.\n\n**`check.mjs` plays a page in a real browser** and fails on anything wrong:\n\n```\nnode check.mjs                                  # index.html: start, run 90 frames, screenshot\nnode check.mjs --keys KeyD*60,Space*4,KeyD*40   # hold each key for that many frames, in order\nnode check.mjs examples/side-scroller.html --cameras --looks noir,handheld\nnode check.mjs \"index.html?look=handheld&zoom=1.5\"   # with URL flags\nnode check.mjs --sheets models.js               # sheets of your own models and textures (ASSETS.md)\n```\n\nIt plays on WebGPU in Chromium's headless shell, so it needs no display. It writes\n`check/<page>.png` (the frame with the HUD), the camera and look shots and\n`check/report.json` (errors, warnings, `state()`), and prints a summary: the backend, frames\nand your `status()`. Exit code 0: the game started, ran with no page, console, game or GPU\nerrors and drew a real picture; 1: it didn't; 2: the tool couldn't run (a browser without\nWebGPU, bad arguments, no page, no browser; `--help` lists the options). It needs Node 20.15+ (or 22.2+) and Playwright\n(`npm i -D playwright && npx playwright install chromium`; a global install works too), or\n`playwright-core` plus a Chromium in `CHROMIUM_PATH`. **Look at the PNGs**: a passing check only proves nothing crashed.\n\n**Play it in Node.** `Engine.headless(game, { assets })` runs a game as `Engine.start` does, minus\nthe GPU and DOM, on manual time, from the kit alone; `assets` reads the game's files.\n`node check.mjs --headless game.js` plays its `createGame()` (the starter's) for the `--keys`,\nreplays it in a fresh game and fails on an error or a replay that ends elsewhere. By hand:\n\n```js\n// test.mjs, beside game.js\nimport { readFile } from 'node:fs/promises';\nimport { Engine } from './pixel-engine.js';\nimport { createGame } from './game.js';\n\nconst assets = async (path) => new Uint8Array(await readFile(new URL(path, import.meta.url))).buffer;\nconst engine = await Engine.headless(createGame(), { assets });\nengine.step(60); // input.setKey to play; a hook's error throws\nconst end = engine.fingerprint();\nawait engine.replay(engine.recording(), () => engine.loadGame(createGame()));\nconsole.log(engine.state().status, engine.fingerprint() === end);\n```\n\nCode that touches `document` guards it, as the starter does.\n\n## 9. Before you hand back\n\n- [ ] `node check.mjs` exits 0 for every page, with `--keys` that actually play the game\n      (reach a goal, collect something, lose a life).\n- [ ] `node check.mjs --headless game.js` exits 0 with the same `--keys`.\n- [ ] You looked at the screenshots: the scene reads, the HUD is legible, nothing is black or\n      clipped, the hero is on the ground.\n- [ ] `status()` reports the game's state, and it changes as you play.\n- [ ] No WebGL-era APIs, no second three.js, no `new PointLight`, no unknown palette names.\n- [ ] The controls are written down (the header comment of `game.js`, or on screen).\n- [ ] On a phone (or `?touch=1`) the game is playable with the touch buttons, or you set\n      `touchButtons` for its own actions.\n\n## 10. Versions\n\n`ENGINE_VERSION` (also `Engine.version` and `state().version`) is the engine's version, and\nthe kit's `CHANGELOG.md` says what changed in each. To upgrade a game, replace\n`pixel-engine.js` (and `pixel-engine.d.ts`, `types/` if you use them), read the changelog\nentries since the old version, then run `node check.mjs` again. The newest release of the kit is\nat the URL in `manifest.json`'s `latest`, and every release (from 0.39.0, its changelog as the\nnotes) stays downloadable from `releases`. The kit's `README.md` says how to build\nit from the engine's repository (`source`) instead.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'cat ASSETS.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'cat ASSETS.md'","aggregated_output":"# Pixel Engine: models and textures\n\n> Pixel Engine **0.46.0**, build 2026-11-02 f75d4a6. Read `GUIDE.md` first. `LIBRARY.md` lists the built-in models and textures, `CREDITS.md` where they came from.\n\nFor an agent building a game on the kit; read `GUIDE.md` first. Objects and pixel-art textures\nare **plain data** you write, check and look at, then fix: a `ModelDef` of keyed primitives that\nthe engine turns into toon meshes, a `TextureDef` of layers it bakes into texels. No modelling\ntool and no image files. `LIBRARY.md` lists the built-in models and textures and the imported\npacks (`library.json` holds the same as data), `check.mjs --sheets` draws what you write, and `examples/market.html` is a scene built this way\n(section 6). Every name here comes from `./pixel-engine.js`; `API.md` has the signatures.\n\nContents: 1 The loop · 2 Models · 3 Textures · 4 Style rules · 5 In a game · 6 The example ·\n7 Credits\n\n## 1. The loop\n\n1. **Start from the library.** Search `LIBRARY.md` (by family, then each pack; id, size, params,\n   palette slots, tags, one row each, a model's variants like `rock-large-a` … `-f` sharing\n   one), filter `library.json`, or search in code:\n   `MODEL_LIBRARY.search('wooden chair')` ranks id words over tags over `about`, plurals and\n   parts of words included; `MODEL_LIBRARY.get('fence')` takes an id. Place library models as\n   they are, re-coloured or with other params, and `use` them inside your own: a stall with\n   crates is a few lines.\n2. **Write** your defs in a module of their own (`models.js`) that exports them; the game\n   imports it. Keep the engine start out of that module.\n3. **Check and look:** `node check.mjs --sheets models.js` draws a sheet of every def the module\n   exports (by name, in an array or object, or in a catalog: `check/sheets/<id>.png`; textures\n   `<id>.tex.png`) and prints its problems and warnings; it exits 1 on a problem. **Open the\n   PNGs.** `--sheets fence,cobbles` draws library ids: look at one before you place it.\n4. **Fix** the numbers the messages and the sheet point at, and run it again until there is no\n   problem and the game-scale previews read. Warnings name what won't read at 480×270: fix them\n   unless you mean it.\n5. **Look in the game:** `node check.mjs index.html --cameras`, then the PNGs: the real\n   renderer, with lights and looks.\n\nIn code, `checkModel(def, { catalog })` and `validateTexture(def)` return\n`{ problems, warnings }`, and `modelSheet(def, { catalog })` and `textureSheet(def)` return the\nsheet as RGBA pixels (`image`) with them.\n\n| sheet row | answers |\n| --- | --- |\n| turntable, 8 angles at one scale | Is the silhouette right from every side? |\n| front / side / top on a 0.1 m grid, with the size in metres | Are the parts where the numbers say? Do they touch? Is it the right size? |\n| game scale: an iso camera (yaw 45°, pitch 42°) at about 19 and 22 pixels a metre, one art pixel per pixel, ×4 | Does it read in a game? (The engine's iso camera at zoom 1 shows about 20.) |\n| palette, check | Which slots, which colours, which are unused; the problems and warnings, each naming the part and the fix |\n\nSheets are drawn in software (three shading bands, outlines) without point lights or looks: the\ngame is the truth.\n\n## 2. Models\n\n```js\nexport const crate = model({\n  id: 'crate',\n  about: 'Wooden crate with a frame and diagonal braces', // one line: find() searches it\n  tags: ['container', 'wood'],\n  palette: { wood: 'orange', band: 'red' }, // slots → the 16 palette names (GUIDE.md section 4)\n  parts: [\n    { box: [0.68, 0.68, 0.68], at: [0, 0.36, 0], c: 'wood' },\n    boxFrame({ size: [0.72, 0.72, 0.72], beam: 0.09, at: [0, 0.36, 0], c: 'band' }),\n    { mirror: [{ box: [0.8, 0.08, 0.04], at: [0, 0.36, 0.35], rot: [0, 0, 45], c: 'band' }], axis: 'z' },\n  ],\n});\n```\n\nMetres and degrees; +Y is up, +Z is the front, the floor is y = 0. Parts are keyed, never\npositional. **Every primitive fills its box `[w, h, d]`, centred on `at`**, turned by `rot` (XYZ,\nabout `at`), and round kinds stretch to it:\n\n- `box`; `cyl` (an n-sided prism, `seg` sides, default 6 to 10 by size; `top`: the top width ÷\n  the bottom width); `cone` (point up); `ball` (`half`: the upper dome); `lump` (a rock, `seed`);\n  `wedge` (a ramp, full height at the back, −Z); `torus` (a ring in XZ as thick as the box is tall).\n- Profile kinds use their own coordinates, placed at `at`: `lathe` ((radius, height) points\n  turned about Y), `slab` (an XY outline or SVG path, extruded `depth` along Z), `tube` (points\n  and a radius `r`, or a pair that tapers).\n- Every part takes `c` (its slot; default the first), `name`, `glow: true` (unlit: a flame's\n  heart, eyes), `tex` (a texture id, section 3), `seg` and `collide: false` (no box of its own\n  under `collider: 'parts'`: a doorway's mortar ring).\n\n**Composition:**\n\n- `{ group: [...], at, rot, scale, c }`: a frame whose `c` is its parts' default. `pivot: true`\n  with a `name` keeps it a movable Group (a door, a lid: `build.object.getObjectByName('lid')`).\n- `{ mirror: [...], axis: 'x' }`: the parts and their mirror image (`axis: 'z'` mirrors front to back).\n- `{ use: 'barrel', at, rot, scale, params, seed, palette: { theirs: 'ours' } }`: another model\n  by id. Its slots map onto yours through `palette`, else onto yours of the same name, else keep\n  their own colours.\n- `on: 'name'`: sit on the named part's top; `at` becomes an offset from there.\n- `params: { h: [default, min, max] }` with `parts: (p, rng) => [...]`: parametric (`p.h`) and\n  seeded (`rng.range(a, b)`). Helpers return parts: `around`, `rowOf`, `gridOf`, `scatterOf`,\n  `boxFrame`.\n- Model keys: `size` (declared bounds, checked), `anchors` (`{ grip: [x, y, z] }`), `light: { at,\n  c, intensity, radius, flicker }`, `collider` (`'box'`, `'cyl'`, `'hull'`, `'parts'` (a box per\n  part: doorways stay open) or `'none'`), `floats: true` (it hangs), `texel` (texels a metre for\n  `tex` parts, default 8).\n\n**Problems** (`check.mjs --sheets` exits 1; `buildModel` throws a `ModelError` on those it can't\nbuild): no `about` or `tags`; an undeclared slot or a colour that isn't a palette name; an unknown\n`use`, `on` or texture; a size that isn't positive; `seg` outside 3–64; NaN; an empty model; below\nthe floor (unless `floats`); over the declared `size`; params out of range; a part that both\nglows and takes a `tex`; a `texel` outside 2–64. **Warnings:** a part floating more than 1 cm from the\nrest; rods under 0.06 m; over the triangle budget (300 under 0.5 m across, 1,000 under 2 m, else\n3,000); over 8 materials; a part hidden inside another; coplanar faces of two colours; touching big\nmasses too close in lightness; one colour over 40% of the model in four or more parts; glow over\n15% of it. `checkModel` builds the defaults, every param at its min and at its max, and three\nseeds when the parts read `rng`.\n\n## 3. Textures\n\n```js\nexport const bricks = textureDef({\n  id: 'bricks',\n  about: 'Stone bricks in courses over dark mortar',\n  tags: ['stone', 'wall', 'surface'],\n  size: [16, 16], // texels; powers of two when it tiles\n  tile: true, // seamless: patterns wrap\n  palette: { mortar: 'night', stone: 'slate', stone2: 'mist' },\n  layers: [{ pattern: 'bricks', colors: ['mortar', 'stone', 'stone2'], w: 8, h: 4, seed: 2 }],\n});\n```\n\n**Layers** draw in order: `{ pixels: [...rows], legend: { k: 'slot' } }` (`.` or a space is clear;\n`at`, `mirror: 'x'` or `'y'`), `{ pattern, colors, seed, dither, ...params }` (over a ramp of\nslots, dark to light), `{ path: 'M … Z', fill, stroke }` (SVG in texel units) and `{ outline:\nslot }`. `frames: n` makes a strip of n frames, left to right.\n\n**Patterns:** `noise bricks tiles planks cobbles stripes checker scatter cracks gradient`.\nParameters: noise `scale`, `octaves`; bricks and tiles `w`, `h`, `mortar`, `offset`, `bevel`;\nplanks `w`, `gap`, `length`, `grain`; cobbles `cells`, `gap`; stripes `width`, `dir`; checker\n`cell`; scatter `count`, `size`, `shape`; cracks `count`, `length`; gradient `dir`. A problem\nnames the range of a bad one.\n\n**Density:** surfaces at 8 texels a metre (`DEFAULT_TEXEL`); denser ones shimmer as the camera\nzooms. A 16-texel tile covers 2 m, so draw a brick of 8 × 4 texels for 1 × 0.5 m. **Warnings:** a\nseam across the wrap, salt and pepper (over 15% single texels), a tiling size that isn't a power\nof two, unused slots.\n\n## 4. Style rules\n\n- **Scale:** the hero is 1.6 m (1.75 m with the cap); a door 2.2 m, a table 0.75 m, a chair seat 0.45 m.\n- **Silhouette first.** The iso camera sees the top and two sides: big masses must read; put\n  detail on the top and the front.\n- **Thickness:** 0.06 m at least; 0.12 m or more for parts that carry the silhouette.\n- **Colour separates parts:** touching parts take different colours or shades (planks and their\n  frame, stones and mortar), up to 8, one an accent; touching big masses differ in lightness.\n- **Glow is flat:** keep it for small hot spots. For fire `use: 'flame'`, and never turn it about\n  Y: its tongues face the camera. Below `h` 0.5 its 2–4 tongues read as a dark smudge: use\n  `tongues: 1` for small fires.\n- **Low poly:** 6 to 10 sides on round kinds, no bevels under 2 cm.\n- **Grounded:** the base on y = 0, nothing floating unless `floats`.\n- **Compose before you create:** `use` a library model before you write a new crate.\n\n## 5. In a game\n\n- `buildModel(idOrDef, { params, seed, palette, light, catalog, textures })` returns `object`\n  (one merged mesh per material; pivots are named Groups), `bounds`, `anchors`, `colliders`\n  (data: `addModelColliders(physics, build, at, yaw)`), `light` (in model space: place it with\n  the model, as the example does) and `report`. Builds whose parts don't read `rng` are cached and\n  share geometry: place as many as you like.\n- **Your own models:** a `ModelCatalog` of the library and yours, passed as `catalog` (or\n  `MODEL_LIBRARY.add(def)`); your own textures likewise in a `TextureCatalog`, passed as `textures`.\n- **Textures:** `toonMaterial(PALETTE.white, { map: textureMap('bricks') })` on any mesh (the\n  map is cached and shared: scale UVs, never the map); `new SpriteBatch(spriteSheet('coin-spin'),\n  { capacity: 64 })`; `hudSprite('gem-icon')` gives rows and colours for `ctx.hud.sprite`.\n- **Packs** (`packs/`, listed in `packs/index.json` and LIBRARY.md): kits by other artists,\n  imported into this format and palette. `const kit = await loadPack('packs/<id>.json',\n  { textures: TEXTURE_LIBRARY })`, then `buildModel('<id>/<name>', { catalog: kit })`; its\n  textures then work by id like the library's. `kit.search('tree')` searches the pack. To vary\n  one of its models, load the pack into your catalog (`loadPack(url, { into: MODEL_LIBRARY })`)\n  and add a def there that `use`s it with a `scale` or a `palette`: nothing is copied.\n\n## 6. The example\n\nMarket Corner, the kit's `examples/market.html`: library models (one re-coloured, three with\nparams, the lamp post's light made brighter), a cobbled floor from `textureMap`, and a stall of\nthe game's own in a module of its own. `node check.mjs examples/market.html` plays it;\n`node check.mjs --sheets examples/market-models.js` draws its stall.\n\n```js market-models\n// Market Corner's own models: plain data in a module of their own, so `node check.mjs --sheets\n// examples/market-models.js` can draw them.\nimport { model, MODEL_LIBRARY, ModelCatalog } from './pixel-engine.js';\n\nexport const fruitStall = model({\n  id: 'fruit-stall',\n  about: 'The market stall under a green awning, two baskets of fruit on its counter',\n  tags: ['town', 'market'],\n  palette: { wood: 'orange', cloth: 'green', cloth2: 'white', top: 'sand', basket: 'red', fruit: 'orange', fruit2: 'lime' },\n  parts: [\n    { use: 'market-stall' }, // its slots take ours of the same name: the awning turns green\n    ...[-0.45, 0.4].flatMap((x, i) => [\n      { name: `basket${i}`, cyl: [0.56, 0.14, 0.4], at: [x, 1.01, 0.05], top: 1.25, c: 'basket' },\n      ...[-0.17, 0, 0.17].map((dx, k) => ({ ball: [0.18, 0.18, 0.18], on: `basket${i}`, at: [dx, 0, 0], c: (i + k) % 2 ? 'fruit2' : 'fruit' })),\n    ]),\n  ],\n});\n\n// Where the game's ids resolve: the library and ours (buildModel's `catalog`).\nexport const MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), fruitStall]);\n```\n\n```js market\n// Market Corner: library models and the game's own fruit stall on a cobbled square at dusk.\n// Nothing to play: a scene to look at, and to build yours from (ASSETS.md).\nimport { addModelColliders, buildModel, DEFAULT_TEXEL, Engine, hudSprite, PALETTE, TEXTURE_LIBRARY, textureMap, THREE, toonMaterial, withUrlOptions } from './pixel-engine.js';\nimport { MODELS } from './market-models.js';\n\nconst { Color, Mesh, PlaneGeometry, Vector3 } = THREE;\n\n// [id, position, options]: buildModel's options (params, palette, seed, light) and a turn in degrees\nconst SCENE = [\n  ['fruit-stall', [0, 0, -1.4]], // ours (market-models.js)\n  ['market-stall', [-4, 0, 0.6], { turn: 90, palette: { cloth: 'blue' } }], // re-coloured\n  ['lamp-post', [1, 0, 1.6], { light: { intensity: 10 } }], // it carries a light: brighter\n  ['well', [3.8, 0, -2.2]],\n  ['fence', [-0.5, 0, -3.4], { params: { length: 7 } }],\n  ['barrel', [-1.8, 0, 1.2]],\n  ['crate', [-1.1, 0, 1.7], { turn: 20 }],\n  ['sack', [2.4, 0, 1], { params: { h: 0.6 } }],\n  ['oak', [-3.2, 0, -3.4], { params: { h: 3 }, seed: 2 }],\n];\n\nclass MarketCorner {\n  name = 'Market Corner';\n  placed = [];\n  lights = [];\n  target = new Vector3(-0.3, 1, -0.9);\n\n  setup(ctx) {\n    const { scene, physics, engine } = ctx;\n    engine.sun.intensity = 1.4; // dusk, so the lamp shows (the engine resets it for the next game)\n    engine.ambient.color.setHex(PALETTE.navy);\n    scene.background = new Color(PALETTE.night);\n\n    // The floor: a library surface on a plain mesh. A 32-texel tile at 8 texels a metre covers\n    // 4 m, so the UVs count tiles (the map is cached and shared: never scale it).\n    const tile = TEXTURE_LIBRARY.get('cobbles').size[0] / DEFAULT_TEXEL;\n    const ground = new PlaneGeometry(16, 16).rotateX(-Math.PI / 2);\n    ground.attributes.uv.array.forEach((v, i, uv) => (uv[i] = (v * 16) / tile));\n    const floor = new Mesh(ground, toonMaterial(PALETTE.white, { map: textureMap('cobbles') }));\n    floor.receiveShadow = true;\n    scene.add(floor);\n    physics.addStaticBox({ position: [0, -0.5, 0], halfExtents: [8, 0.5, 8] });\n\n    for (const [id, at, { turn = 0, ...options } = {}] of SCENE) {\n      const m = buildModel(id, { ...options, catalog: MODELS });\n      m.object.position.set(...at);\n      m.object.rotation.y = (turn * Math.PI) / 180;\n      m.object.updateMatrixWorld();\n      scene.add(m.object);\n      addModelColliders(physics, m, at, m.object.rotation.y);\n      // a model's light is in its own space: place it with the model\n      if (m.light) this.lights.push(ctx.lights.request({ ...m.light, position: m.object.localToWorld(new Vector3(...m.light.at)) }));\n      this.placed.push(m);\n    }\n    this.icon = hudSprite('gold-icon');\n  }\n\n  update(ctx) {\n    ctx.hud.clear();\n    ctx.hud.sprite(6, 6, this.icon.rows, this.icon.colors);\n    ctx.hud.text(26, 10, 'MARKET CORNER', { color: 'sand' });\n  }\n\n  cameraTarget() {\n    return this.target;\n  }\n\n  status() {\n    return `market: ${this.placed.length} models, ${this.lights.length} light`;\n  }\n}\n\nawait Engine.start(new MarketCorner(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'iso', zoom: 1.6 } }));\n```\n\n## 7. Credits\n\n`CREDITS.md` says where everything the kit carries came from: the library and the built-in\nmodels are the engine's own work, three.js and Rapier ship under their licences (their texts are\nin it), and each pack's author and licence with every id it holds. Ship it with your game. A def\nyou import or copy from someone else records it in `source: { url, licence, author }`; credit it\nas its licence asks.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'cat vendor/hub/README.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'cat vendor/hub/README.md'","aggregated_output":"# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card: what the game is, how to win, the\n   controls. The card is the hub's, from the game's tags, or the game's own\n   (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. By default the hub shows its own card over\nthe game. A game can make the card its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n| `hub:session-goal` | how to win, shown on the hub's card |\n| `hub:session-howto` | the controls, shown on the hub's card |\n| `hub:session-minutes` | optional: how many minutes a round takes |\n| `hub:webgpu` | optional: `required` when the game cannot run without WebGPU |\n\n### API\n\n| | |\n|---|---|\n| `AIHub.active` | `true` in a session, from the first line |\n| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n| `AIHub.ready()` | once, when the round can start |\n| `AIHub.answer('ready' \\| 'more')` | on the game's own card, before `start` |\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\nread them.\n\n| Event | Arguments |\n|---|---|\n| `card` | `{ left, paused, starting, ready, asking, asked }`, with the game's own card |\n| `start` | `{ in }`: milliseconds until play begins |\n| `message` | `data, from` |\n| `leave` | `{ id, reason }` |\n| `time-up` | `{ graceMs }` |\n| `end` | `{ reason, standings }` |\n\nEvents that arrive before a handler is attached are kept, and delivered in\norder when the first handler is attached. Fields and events a newer hub adds\nreach the game through the client unchanged.\n\n### Versions\n\nThis is protocol **1**, client **1.4.0**. Changes within version 1 only add:\ngames on older clients keep working. A change that would break a game becomes\nprotocol 2, with its own `hub:session` value.\n","exit_code":0,"status":"completed"}}
