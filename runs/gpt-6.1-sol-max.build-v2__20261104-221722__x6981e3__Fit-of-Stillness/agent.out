{"type":"item.started","item":{"id":"item_99","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/art/world.js');s=p.read_text().replace(\\\"place(ctx,'kevin',[4.3,.98,-3.7],{turn:-30});\\\", \\\"const bird=place(ctx,'kevin',[4.3,.98,-3.7],{turn:-30});\\\")\ns=s.replace(\\\"return {xs,sea,update(t)\\\", \\\"return {xs,sea,bird,update(t)\\\")\np.write_text(s)\np=Path('src/scenes/game.js');s=p.read_text().replace(\\\"if(this.rain){const r=this.lanes.find(l=>l.local)?.run;this.rain.intensity=\\\", \\\"if(this.rain){const r=this.lanes.find(l=>l.local)?.run;if(r&&this.world.bird){const b=this.world.bird;if(r.t>=10&&r.t<85){const k=Math.min(1,r.t-10);b.position.set(4.3*(1-k),.98+.92*k,-3.7+4.5*k);}else if(r.t>=85)b.position.set((r.t-85)*2,1.9+(r.t-85)*.4,.8-(r.t-85));if(r.t>=65&&r.t<66&&\"'!this.rumbled){this.rumbled=true;if(!app.settings.reduceFlashes)ctx.engine.shake.add(.4);}}this.rain.intensity=\")\np.write_text(s)\np=Path('\"'tests/headless/suite.mjs');s=p.read_text().replace(\\\" await check('all tunables reset\\\", \\\" await check('pause also restores plaza and Medley music',async()=>{await app.go('hub');app.pause();assert.equal(e.audio.playing,'');app.closeMenu();assert.equal(e.audio.playing,'plaza');app.mode='family';await app.go('medley');app.pause();app.closeMenu();assert.equal(e.audio.playing,'still');});\\\\n await check('all tunables reset\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
