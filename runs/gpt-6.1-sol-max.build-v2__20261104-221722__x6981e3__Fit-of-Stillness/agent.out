{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/art/clips.js');s=p.read_text().replace(\\\"gesture('Disembark',{LegR:[-30,0,0],LegL:[30,0,0],ArmL:[-25,0,0]},60)\\\", \\\"{...gaitClip(HERO_RIG,{name:'Disembark',frames:30,speed:1.2,stance:.55,hip:-.02,bob:.02,lift:.06,lean:3,arms:{swing:15,elbow:20}}),loop:false}\\\")\np.write_text(s)\np=Path('tests/headless/suite.mjs');s=p.read_text();needle=\\\" await check('activity recording deterministic replay'\\\"\ninsert=\\\"\\\"\\\" await check('menu attract, no attract in class, and pointer exit',async()=>{await app.go('title');app.settingsMenu();e.step(605);await settle(e);assert(app.attract);e.input.setPointer(.8,.5);e.step(2);await settle(e);assert(\"'!app.attract);await app.go('\"'activity',{id:'tree'});app.scene.phase='play';e.step(700);assert(\"'!app.attract);});\n await check('\"'live designer values affect physics and tools award unlocks',async()=>{const low=new Dot(rng(9)),high=new Dot(rng(9)),t=new Tunables();t.dotNoise=0;t.dotInstability=0;t.dotAuthority=1;for(let i=0;i<60;i++)low.step(1/60,1,0,t);t.dotAuthority=5;for(let i=0;i<60;i++)high.step(1/60,1,0,t);assert(high.x>low.x*2);app.guest=guest('Designer');app.devMenu(5,0);app.menu.rows[3].action();assert.equal(app.guest.drips,50);assert(app.guest.items.includes('Towel cape'));app.menu.rows[4].action();assert.equal(app.guest.items.length,7);assert.equal(app.guest.day,7);app.closeMenu();});\n await check('all tray boards and third cup resolve as data',()=>{for(const [seed,hard]of[[200,false],[201,false],[200,true]]){const r=new ActivityRun(BY_ID.tray,new Tunables(),{seed,hard});assert.equal(r.cups.length,hard?3:2);if(seed===201)assert(r.trayWalls.length>0);while(\"'!r.done)r.step(1/60,{x:0,y:0});assert(Number.isFinite(r.score));}});\n\"\"\"\ns=s.replace(needle,insert+needle);p.write_text(s)\np=Path('\"'tests/browser/suite.mjs');s=p.read_text();needle=\\\" await check('synth SFX, music and offline formant voices make sound'\\\"\ninsert=\\\"\\\"\\\" await check('controller joins a mat and starts Family Hour',async()=>{await page.evaluate(async()=>{const a=__GAME__;a.family=[{type:'keyboard',name:'Guest 1'}];await a.go('join');__padState(0,[0,0],[0]);__PIXEL_ENGINE__.step(1);__padState(0);__PIXEL_ENGINE__.step(1);});assert.equal(await page.evaluate(()=>__GAME__.family.length),2);await page.evaluate(()=>{__padState(0,[0,0],[0]);__PIXEL_ENGINE__.step(1);__padState(0);});await page.evaluate(async()=>{if(__GAME__.loading)await __GAME__.loading;__PIXEL_ENGINE__.step(1);});assert.equal(await page.evaluate(()=>__GAME__.scene.id),'medley');await page.evaluate(()=>{__pads=[null,null,null,null];});});\n\\\"\\\"\\\"\ns=s.replace(needle,insert+needle);p.write_text(s)\nPY\nnode tools/test.mjs --fast\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
