se'||\"'!p.over)return;const px=(p.x+1)*ctx.hud.width/2,py=(1-p.y)*ctx.hud.height/2;const n=app.ui.hit(px,py);if(n>=0&&n<m.rows.length || m.kind==='\"'name'&&n>=0){m.selection=n;if(ctx.input.wasPressed('MouseLeft')){ctx.audio.play('confirm');activate(n);}}}\n drawAttract(ctx){const h=ctx.hud,W=h.width;panel(h,W/2-155,5,310,27,{shadow:false,color:C.teal,edge:C.paper});text(h,W/2,10,TITLE+' / A LITTLE DEMONSTRATION',{align:'center',color:C.paper});text(h,W/2,21,'Press any button. Gently.',{align:'center',color:C.paper});}\n drawDebug(ctx){const h=ctx.hud,r=this.lanes.find(l=>l.local)?.run;panel(h,8,112,192,61,{shadow:false});text(h,13,118,this.status().slice(0,30),{color:C.teal});text(h,13,132,\"'`Dot ${r?.dot.x.toFixed(2)||0}, ${r?.dot.y.toFixed(2)||0}`);text(h,13,145,`Ring ${r?.ring.toFixed(2)||0} / ${this.app.device.kind}`);text(h,13,158,`FPS ${Math.round(ctx.engine.state().fps||0)}`);}\n openLocker(){\n  const app=this.app,g=app.guest||guest(),fields=[['\"'skin','Skin',['sand','orange','red','plum']],['hair','Hair',['ink','orange','mist','plum']],['top','Top',['white','sky','teal','plum','cyan']],['bottom','Bottom',['sky','teal','navy','white']],['headband','Headband',['red','sky','white','sand']]];\n  const rows=fields.map(([key,label,values])=>({label,value:g.look[key]||this.playerLook()[key],adjust:d=>{const v=g.look[key]||this.playerLook()[key];g.look[key]=values[(values.indexOf(v)+d+values.length)%values.length];app.save.write();this.changeAvatar(g.avatar);this.openLocker();},action:()=>{const r=app.menu.rows[app.menu.selection];r.adjust(1);}}));\n  if(g.items.includes('Towel cape'))rows.push({label:'Towel cape',value:\"'!!g.look.cape,action:()=>{g.look.cape=!g.look.cape;this.changeAvatar(g.avatar);app.save.write();this.openLocker();}});\n  rows.push({label:'\"'Back to the island',action:()=>app.go('hub')});app.setMenu('locker','The Locker Room',rows,{subtitle:\"'`${g.items.length} jar rewards / appearances only`,back:()=>app.go('\"'hub')});\n }\n status(){const r=this.lanes.find(l=>l.local)?.run;return \"'`${this.id}${this.id==='\"'activity'?' '+this.data.id:''} | \"'${this.phase} | t ${(r?.t||this.t).toFixed(1)} | score ${Math.round(r?.score||0)}`;}\n fingerprint(){return JSON.stringify([this.id,this.phase,Math.round(this.t*10000),this.lanes.filter(l=>!l.ghost).map(l=>l.run?.fingerprint()),this.hero?.body.translation(),this.app.guest?.drips]);}\n dispose(ctx){this.stopMirror?.();this.mirror?.dispose();if(this.originalGravity)ctx.physics.world.gravity=this.originalGravity;this.app.voice.stop();this.world?.sea?.dispose();this.jogWorld?.sea?.dispose();}\n}\nconst SFX_TYPES=new Set(['\"'in','out','rep','step','miss','bonk','thwap','catch','splash','gust','jump','fall']);\nfunction appHasOverlay(app){return \"'!!app.menu||!!app.dialogue;}\nEOF\ncat > src/main.js <<'\"'EOF'\nimport { Engine, withUrlOptions, PALETTE } from '../pixel-engine.js';\nimport { App } from './app.js';\nexport { App };\nexport function createGame(){const app=new App();return app.first();}\nif(typeof document\"'!=='\"'undefined'){\n let info=null;\n if(globalThis.AIHub?.active)info=await globalThis.AIHub.connect({mode:'ghost',seats:[1,4],card:true});\n let storage;try{storage=localStorage;}catch{}\n const app=new App({storage,info});globalThis.__GAME__=app;\n const key=e=>{app.externalPulse='keyboard';if(app.menu?.kind==='name'&&e.key.length===1&&/\"'^[a-zA-Z0-9 -]$/.test(e.key)){app.engine?.input.send({nameChar:e.key});}if(app.scene?.id==='\"'card'){if(e.code==='Enter')globalThis.AIHub.answer('ready');if(e.code==='KeyM')globalThis.AIHub.answer('more');}};\n const pointer=e=>{app.externalPulse=e.pointerType==='touch'?'touch':'mouse';};const motion=e=>{if(Math.abs(e.movementX)+Math.abs(e.movementY)>2)app.externalPulse=e.pointerType==='touch'?'touch':'mouse';};const wheel=()=>app.externalPulse='mouse';\n window.addEventListener('keydown',key);window.addEventListener('pointerdown',pointer);window.addEventListener('pointermove',motion);window.addEventListener('wheel',wheel);\n app.listeners.push(()=>{window.removeEventListener('keydown',key);window.removeEventListener('pointerdown',pointer);window.removeEventListener('pointermove',motion);window.removeEventListener('wheel',wheel);});\n try{const engine=await Engine.start(app.first(),withUrlOptions({container:document.getElementById('app'),aspect:'fill',touch:false,settings:{button:app.device.touchOnly?'top-right':false},quality:info?'medium':'high',seed:info?.seed||271828,background:PALETTE.sky,camera:app.first().camera()}));app.engine=engine;if(info)globalThis.AIHub.ready();globalThis.AIHub?.probe?.(()=>({scene:app.scene.id==='card'?'ready':app.scene.phase==='podium'?'over':app.scene.id==='title'?app.menu?'menu':'title':'play',menu:\"'!!app.menu,world:app.scene.t,input:app.lastInput}));}\n catch(e){app.bootError=e.message;if(info)globalThis.AIHub.fail(e.message);}\n}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport { readFileSync, writeFileSync, mkdirSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { TITLE } from '../src/data/title.js';\nimport { ABOUT } from '../src/data/about.js';\nconst base=TITLE.replaceAll(' ','-')+'-Wii-Fit-gpt-6.1-sol-max-20261104-221722';\nmkdirSync('.build',{recursive:true});\nexecFileSync('esbuild',['src/main.js','--bundle','--format=esm','--platform=browser','--target=esnext','--charset=utf8','--outfile=.build/bundle.js','--log-level=warning'],{stdio:'inherit'});\nconst safe=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script').replace(/<\"'!--/g,'\"'<\\\\\\\\\"'!--'\"');\nconst credits=JSON.stringify(readFileSync('CREDITS.md','utf8'));\nconst html=\"'`<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>${readFileSync('\"'vendor/hub/session.js','utf8')}</script>\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Most points across three classes. Stay in the circle.\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"Stick, WASD or mouse: lean. R2/Space: breathe. L1/R1 or F/J: step.\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"4\\\"><meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\\\"><link rel=\\\"icon\\\" href=\\\"data:,\\\"><title>\"'${TITLE}</title>\n<style>html,body{margin:0;height:100%;background:#8dc6d8;overflow:hidden}#app{position:fixed;inset:0}canvas{image-rendering:pixelated}</style></head><body><div id=\"app\"></div><script>globalThis.__ENGINE_CREDITS__=${safe(credits)};</script><script type=\"module\">${safe(readFileSync('\"'.build/bundle.js','utf8'))}</script></body></html>\"'`;\nwriteFileSync('\"'../'+base+'.html',html);writeFileSync('.build/game.html',html);writeFileSync('../exit-interview.json',JSON.stringify(ABOUT,null,2)+'\\\\n');JSON.parse(readFileSync('../exit-interview.json','utf8'));\nconsole.log('Built '+base+'.html');\nEOF\nnode tools/build.mjs\"","aggregated_output":"Built Fit-of-Stillness-Wii-Fit-gpt-6.1-sol-max-20261104-221722.html\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > tools/test.mjs <<'EOF'\nimport { runHeadless } from '../tests/headless/suite.mjs';\nlet passed=0,failed=0;\nexport async function check(name,fn){try{await fn();passed++;}catch(e){failed++;console.log('FAIL '+name+': '+(e.stack||e.message||e));}}\nawait runHeadless(check);\nif(\"'!process.argv.includes('\"'--fast')){const{runBrowser}=await import('../tests/browser/suite.mjs');await runBrowser(check);}\nconsole.log(\"'`${passed}/${passed+failed} passed`);if(failed)process.exitCode=1;\nEOF\ncat > tests/headless/suite.mjs <<'\"'EOF'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { createHash } from 'node:crypto';\nimport { Engine, checkModel, validateClip, analyzeClip, HERO_RIG, compileClips, parseSong, validateTexture, HERO_MODEL } from '../../pixel-engine.js';\nimport { App } from '../../src/app.js';\nimport { Dot, BalanceBot, rng } from '../../src/core/dot.js';\nimport { Tunables, REGISTRY, DEFAULTS } from '../../src/core/tunables.js';\nimport { ActivityRun, ActivityBot } from '../../src/core/activity.js';\nimport { ACTIVITIES, BY_ID } from '../../src/data/activities.js';\nimport { LINES, ALL_LINES } from '../../src/data/lines.js';\nimport { Save, guest, award, confess, nextDay, recordMorning, SAVE_KEY } from '../../src/core/save.js';\nimport { UNLOCKS, MEDLEY } from '../../src/data/week.js';\nimport { OWN_MODELS, MODELS } from '../../src/art/models.js';\nimport { OWN_CLIPS } from '../../src/art/clips.js';\nimport { tile } from '../../src/art/textures.js';\nimport { SONGS } from '../../src/audio/songs.js';\nimport { syllabify } from '../../src/audio/voice.js';\nconst pump=async(e,n=1)=>{for(let j=0;j<n;j++){e.step(1);await Promise.resolve();}};\nasync function settle(e){for(let j=0;j<10;j++){await Promise.resolve();if(e.game===e.game.app.scene)return;}await pump(e,2);}\nasync function key(e,k){e.input.setKey(k,true);await pump(e);e.input.setKey(k,false);await pump(e);await settle(e);}\nexport async function runHeadless(check){\n await check('engine byte identical',()=>{const wanted=readFileSync('vendor/pixel-engine.sha256','utf8').split(' ')[0];assert.equal(createHash('sha256').update(readFileSync('pixel-engine.js')).digest('hex'),wanted);});\n for(const skill of ['idle','average','good','expert'])await check('dot distribution '+skill,()=>{let total=0;for(let seed=1;seed<=40;seed++){const random=rng(seed),dot=new Dot(random),bot=new BalanceBot(skill,random);let inside=0;for(let k=0;k<35*60;k++){const u=bot.read(dot,1/60);dot.step(1/60,u.x,u.y,new Tunables());if(k>120&&Math.hypot(dot.x,dot.y)<=.3)inside++;}total+=inside/(33*60);}const mean=total/40;if(skill==='idle')assert(mean<.2,mean);if(skill==='average')assert(mean>.35&&mean<.65,mean);if(skill==='good')assert(mean>.80,mean);if(skill==='expert')assert(mean>.95,mean);});\n for(const m of OWN_MODELS)await check('model '+m.id,()=>assert.deepEqual(checkModel(m,{catalog:MODELS}).problems,[]));\n await check('tile texture',()=>assert.deepEqual(validateTexture(tile).problems,[]));\n for(const c of OWN_CLIPS)await check('clip validation '+c.name,()=>assert.deepEqual(validateClip(c,HERO_RIG),[]));\n for(const [id,s]of Object.entries(SONGS))await check('song '+id,()=>{parseSong(s);assert(Object.values(s.tracks).reduce((a,t)=>a+t.volume,0)*.1*.8>=.03);});\n await check('line bank',()=>{assert(ALL_LINES.length>=120);for(const a of ACTIVITIES)assert(LINES[a.id].length>=6);for(const s of ALL_LINES)assert(s.length<=156,s);});\n await check('voice deterministic syllables and rising question',()=>{const a=syllabify('Please stand.','Ounce');assert.deepEqual(a,syllabify('Please stand.','Ounce'));const q=syllabify('Please stand?','Ounce');assert(q.at(-1).f0>a.at(-1).f0);assert(syllabify('Please stand.','Ounce')[0].f0>syllabify('Please stand.','Coach')[0].f0);});\n for(const a of ACTIVITIES)await check('activity idle / sloppy / expert '+a.id,()=>{const results=[];for(const skill of ['idle','sloppy','expert']){const run=new ActivityRun(a,new Tunables(),{seed:200}),bot=new ActivityBot(skill,200);for(let k=0;k<10000&&\"'!run.done;k++)run.step(1/60,bot.read(run,1/60));assert(run.done);const result=run.result();assert(Number.isFinite(result.score));assert(result.score>=0);if(['\"'pose','long','step','jog','reps'].includes(a.kind))assert(result.score<=100.01,result.score);results.push(result);}assert.equal(results[0].stars,0);assert(results[2].stars>=2,JSON.stringify(results));assert(results[1].score<results[2].score,JSON.stringify(results));const g=guest();const r=award(g,a,results[2],new Tunables());assert.equal(g.drips,2+3*results[2].stars+Math.floor(results[2].seconds/30)+(r.bonus?5:0));});\n await check('save corrupt, storage blocked, reload',()=>{const memory=new Map(),storage={getItem:k=>memory.get(k),setItem:(k,v)=>memory.set(k,v)},s=new Save(storage);s.data.slots[1]=guest('June',2);s.data.slots[1].day=4;s.write();assert.equal(new Save(storage).data.slots[1].day,4);memory.set(SAVE_KEY,'{bad');assert.equal(new Save(storage).data.slots[1],null);const no=new Save({getItem(){throw Error('denied');},setItem(){throw Error('denied');}});no.write();assert.equal(no.data.version,1);});\n await check('wobble age and exact confession',()=>{const e=guest(),a=guest();for(let d=0;d<7;d++){e.morning=a.morning=false;recordMorning(e,.97,.5);recordMorning(a,.45,.5);}assert(e.ages.at(-1)<a.ages.at(-1));const before=[...a.ages];confess(a);assert.deepEqual(a.ages,before.map(x=>x-7));confess(a);assert.deepEqual(a.ages,before.map(x=>x-7));});\n let app,e;await check('headless engine boots real title',async()=>{app=new App();e=await Engine.headless(app.first(),{camera:app.first().camera(),seed:271828});e.step(2);assert.equal(app.state().scene,'title');assert.equal(e.audio.volume.music,.10);assert.equal(e.errors.length,0);});\n if(\"'!e)return;\n await check('\"'all authored clips analyzed on real rig',async()=>{const root=app.scene.actors[0].root,clips=compileClips(OWN_CLIPS,HERO_RIG,root);for(let i=0;i<OWN_CLIPS.length;i++){const p=analyzeClip(root,HERO_RIG,OWN_CLIPS[i],clips[i]).problems;assert.deepEqual(p,[],OWN_CLIPS[i].name+': '+JSON.stringify(p));}});\n await check('menus: new residency through real keys',async()=>{await key(e,'Enter');assert.equal(app.menu.kind,'main');await key(e,'Enter');assert.equal(app.menu.kind,'slots');await key(e,'Enter');assert.equal(app.menu.kind,'name');app.nameValue='Tester';app.menu.selection=29;await key(e,'Enter');await settle(e);assert.equal(app.menu.kind,'avatar');app.menu.selection=1;await key(e,'Enter');await settle(e);assert.equal(app.scene.id,'ferry');await key(e,'Enter');await settle(e);assert.equal(app.scene.id,'weighin');});\n await check('full week: mornings, all activities, goals, unlocks, ending and week two',async()=>{\n  if(\"'!app.guest){app.guest=guest('\"'Tester');app.mode='week';app.save.data.slots[0]=app.guest;}app.setDriver('expert');const visited=new Set();\n  for(let day=1;day<=7;day++){\n   app.guest.day=day;app.guest.morning=false;await app.go('weighin');await key(e,'Enter');e.step(905);assert.equal(app.scene.phase,'question','day '+day);await key(e,'Enter');assert.equal(app.guest.ages.length,day);await key(e,'Enter');await settle(e);if(app.dialogue){await key(e,'Enter');await key(e,'Enter');}\n   if(app.scene.id\"'!=='\"'hub')await app.go('hub');\n   for(const a of ACTIVITIES.filter(a=>a.day===day&&a.id\"'!=='\"'long')){\n    await app.go('activity',{id:a.id});app.scene.practice=false;await key(e,'Enter');e.step(181);for(let n=0;n<6500&&app.scene.phase\"'!=='\"'results';n++)e.step(1);assert.equal(app.scene.phase,'results',a.id);assert(app.lastResult.stars>=2,a.id);assert(app.guest.played[a.id]);visited.add(a.id);\n   }\n   if(day===6){await app.go('activity',{id:'tree',hard:true});app.scene.practice=false;await key(e,'Enter');e.step(1800);assert.equal(app.scene.phase,'results');}\n   if(day===7){await app.go('activity',{id:'long'});app.scene.practice=false;await key(e,'Enter');e.step(5900);assert.equal(app.scene.phase,'results');app.scene.resultAction(2);await settle(e);assert.equal(app.scene.id,'ending');const before=[...app.guest.ages];e.step(750);assert(app.guest.confessed);assert.deepEqual(app.guest.ages,before.map(x=>x-7));e.step(900);assert.equal(app.scene.phase,'credits');await key(e,'Enter');await settle(e);assert.equal(app.guest.week,2);assert.equal(app.guest.day,1);}\n   else {assert(app.guest.today.length>0);await app.go('report');await key(e,'Enter');await settle(e);assert.equal(app.guest.day,day+1);}\n  }\n  assert.equal(visited.size,16);assert(app.guest.drips>=175);assert.equal(app.guest.items.length,7);\n });\n await check('all presentation scenes run',async()=>{for(const id of ['hub','jar','records','locker','animation','join','report']){await app.go(id);e.step(5);assert.equal(e.errors.length,0,id);app.closeMenu();}});\n await check('pause freezes fixed game time, resumes exactly',async()=>{app.mode='dropin';await app.go('activity',{id:'tree'});app.scene.practice=false;await key(e,'Enter');e.step(250);const t=app.scene.lanes[1].run.t;await key(e,'Escape');assert.equal(e.timeScale,0);e.step(100);assert.equal(app.scene.lanes[1].run.t,t);await key(e,'Enter');assert(e.timeScale>0);e.step(60);assert(app.scene.lanes[1].run.t>t);});\n await check('all tunables reset and dev tool pages',()=>{for(const [tab,fields]of Object.entries(REGISTRY)){for(const [k,[d,min,max,step]]of Object.entries(fields))app.tunables[k]=max;app.tunables.reset(tab);for(const [k,[d]]of Object.entries(fields))assert.equal(app.tunables[k],d);}for(let i=0;i<7;i++){app.devMenu(i);e.step(1);assert.equal(app.menu.kind,'dev');}app.closeMenu();});\n await check('local four-lane medley and display-only ghosts',async()=>{app.mode='family';app.family=[{type:'bot',name:'One',skill:'expert'},{type:'bot',name:'Two',skill:'good'},{type:'bot',name:'Three',skill:'average'},{type:'bot',name:'Four',skill:'sloppy'}];await app.go('medley');e.step(11200);assert.equal(app.scene.phase,'podium');for(const score of app.scene.totals)assert(score>=0&&score<=3000,score);assert(new (await import('../../src/core/drivers.js')).GhostDriver().displayOnly);});\n await check('attract starts after 10 seconds, loops and exits on input',async()=>{await app.go('title');e.step(605);await settle(e);assert(app.attract);for(let i=0;i<10;i++){e.step(845);await settle(e);assert.equal(e.errors.length,0);}await key(e,'KeyX');assert(\"'!app.attract);assert.equal(app.scene.id,'\"'title');});\n await check('activity recording deterministic replay',async()=>{app.setDriver('expert');app.mode='dropin';await app.go('activity',{id:'tree',demo:true});app.scene.phase='play';e.step(300);const recording=e.recording(),end=app.scene.fingerprint();await e.replay(recording,async()=>{await app.go('activity',{id:'tree',demo:true});app.scene.phase='play';});assert.equal(app.scene.fingerprint(),end);});\n e.dispose?.();app.dispose();\n}\nEOF\ncat > tools/shot.mjs <<'EOF'\nimport {chromium}from'playwright';import{writeFileSync}from'node:fs';import{pathToFileURL}from'node:url';import{resolve}from'node:path';\nconst scene=process.argv[2]||'title',id=process.argv[3]||'tree';const browser=await chromium.launch({headless:true,args:['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader']});\ntry{const page=await browser.newPage({viewport:{width:1920,height:1080}});await page.goto(pathToFileURL(resolve('.build/game.html')).href);await page.waitForFunction(()=>window.__PIXEL_ENGINE__?.game);if(scene\"'!=='\"'title')await page.evaluate(async([scene,id])=>{const a=__GAME__;a.guest={name:'Alex',avatar:0,look:{},day:5,week:1,drips:72,stars:12,ages:[75,70,62,55,47],tests:[],played:{},records:{},today:[],items:[]};await a.go(scene,{id});if(scene==='activity'){a.setDriver('expert');a.scene.phase='play';}},[scene,id]);await page.waitForTimeout(600);const data=await page.evaluate(async()=>{const e=__PIXEL_ENGINE__;e.step(30);const f=await e.renderer.capture();const c=document.createElement('canvas');c.width=f.width;c.height=f.height;const g=c.getContext('2d');g.putImageData(new ImageData(new Uint8ClampedArray(f.pixels),f.width,f.height),0,0);g.imageSmoothingEnabled=false;if(e.hud.canvas?.width)g.drawImage(e.hud.canvas,0,0,f.width,f.height);return c.toDataURL();});const path=\"'`check/visual/${scene}-${id}.png`;writeFileSync(path,Buffer.from(data.split('\"',')[1],'base64'));console.log(path);console.log(await page.evaluate(()=>__GAME__.state()));}finally{await browser.close();}\nEOF\nnode tools/test.mjs --fast\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > tools/test.mjs <<'EOF'\nimport { runHeadless } from '../tests/headless/suite.mjs';\nlet passed=0,failed=0;\nexport async function check(name,fn){try{await fn();passed++;}catch(e){failed++;console.log('FAIL '+name+': '+(e.stack||e.message||e));}}\nawait runHeadless(check);\nif(\"'!process.argv.includes('\"'--fast')){const{runBrowser}=await import('../tests/browser/suite.mjs');await runBrowser(check);}\nconsole.log(\"'`${passed}/${passed+failed} passed`);if(failed)process.exitCode=1;\nEOF\ncat > tests/headless/suite.mjs <<'\"'EOF'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { createHash } from 'node:crypto';\nimport { Engine, checkModel, validateClip, analyzeClip, HERO_RIG, compileClips, parseSong, validateTexture, HERO_MODEL } from '../../pixel-engine.js';\nimport { App } from '../../src/app.js';\nimport { Dot, BalanceBot, rng } from '../../src/core/dot.js';\nimport { Tunables, REGISTRY, DEFAULTS } from '../../src/core/tunables.js';\nimport { ActivityRun, ActivityBot } from '../../src/core/activity.js';\nimport { ACTIVITIES, BY_ID } from '../../src/data/activities.js';\nimport { LINES, ALL_LINES } from '../../src/data/lines.js';\nimport { Save, guest, award, confess, nextDay, recordMorning, SAVE_KEY } from '../../src/core/save.js';\nimport { UNLOCKS, MEDLEY } from '../../src/data/week.js';\nimport { OWN_MODELS, MODELS } from '../../src/art/models.js';\nimport { OWN_CLIPS } from '../../src/art/clips.js';\nimport { tile } from '../../src/art/textures.js';\nimport { SONGS } from '../../src/audio/songs.js';\nimport { syllabify } from '../../src/audio/voice.js';\nconst pump=async(e,n=1)=>{for(let j=0;j<n;j++){e.step(1);await Promise.resolve();}};\nasync function settle(e){for(let j=0;j<10;j++){await Promise.resolve();if(e.game===e.game.app.scene)return;}await pump(e,2);}\nasync function key(e,k){e.input.setKey(k,true);await pump(e);e.input.setKey(k,false);await pump(e);await settle(e);}\nexport async function runHeadless(check){\n await check('engine byte identical',()=>{const wanted=readFileSync('vendor/pixel-engine.sha256','utf8').split(' ')[0];assert.equal(createHash('sha256').update(readFileSync('pixel-engine.js')).digest('hex'),wanted);});\n for(const skill of ['idle','average','good','expert'])await check('dot distribution '+skill,()=>{let total=0;for(let seed=1;seed<=40;seed++){const random=rng(seed),dot=new Dot(random),bot=new BalanceBot(skill,random);let inside=0;for(let k=0;k<35*60;k++){const u=bot.read(dot,1/60);dot.step(1/60,u.x,u.y,new Tunables());if(k>120&&Math.hypot(dot.x,dot.y)<=.3)inside++;}total+=inside/(33*60);}const mean=total/40;if(skill==='idle')assert(mean<.2,mean);if(skill==='average')assert(mean>.35&&mean<.65,mean);if(skill==='good')assert(mean>.80,mean);if(skill==='expert')assert(mean>.95,mean);});\n for(const m of OWN_MODELS)await check('model '+m.id,()=>assert.deepEqual(checkModel(m,{catalog:MODELS}).problems,[]));\n await check('tile texture',()=>assert.deepEqual(validateTexture(tile).problems,[]));\n for(const c of OWN_CLIPS)await check('clip validation '+c.name,()=>assert.deepEqual(validateClip(c,HERO_RIG),[]));\n for(const [id,s]of Object.entries(SONGS))await check('song '+id,()=>{parseSong(s);assert(Object.values(s.tracks).reduce((a,t)=>a+t.volume,0)*.1*.8>=.03);});\n await check('line bank',()=>{assert(ALL_LINES.length>=120);for(const a of ACTIVITIES)assert(LINES[a.id].length>=6);for(const s of ALL_LINES)assert(s.length<=156,s);});\n await check('voice deterministic syllables and rising question',()=>{const a=syllabify('Please stand.','Ounce');assert.deepEqual(a,syllabify('Please stand.','Ounce'));const q=syllabify('Please stand?','Ounce');assert(q.at(-1).f0>a.at(-1).f0);assert(syllabify('Please stand.','Ounce')[0].f0>syllabify('Please stand.','Coach')[0].f0);});\n for(const a of ACTIVITIES)await check('activity idle / sloppy / expert '+a.id,()=>{const results=[];for(const skill of ['idle','sloppy','expert']){const run=new ActivityRun(a,new Tunables(),{seed:200}),bot=new ActivityBot(skill,200);for(let k=0;k<10000&&\"'!run.done;k++)run.step(1/60,bot.read(run,1/60));assert(run.done);const result=run.result();assert(Number.isFinite(result.score));assert(result.score>=0);if(['\"'pose','long','step','jog','reps'].includes(a.kind))assert(result.score<=100.01,result.score);results.push(result);}assert.equal(results[0].stars,0);assert(results[2].stars>=2,JSON.stringify(results));assert(results[1].score<results[2].score,JSON.stringify(results));const g=guest();const r=award(g,a,results[2],new Tunables());assert.equal(g.drips,2+3*results[2].stars+Math.floor(results[2].seconds/30)+(r.bonus?5:0));});\n await check('save corrupt, storage blocked, reload',()=>{const memory=new Map(),storage={getItem:k=>memory.get(k),setItem:(k,v)=>memory.set(k,v)},s=new Save(storage);s.data.slots[1]=guest('June',2);s.data.slots[1].day=4;s.write();assert.equal(new Save(storage).data.slots[1].day,4);memory.set(SAVE_KEY,'{bad');assert.equal(new Save(storage).data.slots[1],null);const no=new Save({getItem(){throw Error('denied');},setItem(){throw Error('denied');}});no.write();assert.equal(no.data.version,1);});\n await check('wobble age and exact confession',()=>{const e=guest(),a=guest();for(let d=0;d<7;d++){e.morning=a.morning=false;recordMorning(e,.97,.5);recordMorning(a,.45,.5);}assert(e.ages.at(-1)<a.ages.at(-1));const before=[...a.ages];confess(a);assert.deepEqual(a.ages,before.map(x=>x-7));confess(a);assert.deepEqual(a.ages,before.map(x=>x-7));});\n let app,e;await check('headless engine boots real title',async()=>{app=new App();e=await Engine.headless(app.first(),{camera:app.first().camera(),seed:271828});e.step(2);assert.equal(app.state().scene,'title');assert.equal(e.audio.volume.music,.10);assert.equal(e.errors.length,0);});\n if(\"'!e)return;\n await check('\"'all authored clips analyzed on real rig',async()=>{const root=app.scene.actors[0].root,clips=compileClips(OWN_CLIPS,HERO_RIG,root);for(let i=0;i<OWN_CLIPS.length;i++){const p=analyzeClip(root,HERO_RIG,OWN_CLIPS[i],clips[i]).problems;assert.deepEqual(p,[],OWN_CLIPS[i].name+': '+JSON.stringify(p));}});\n await check('menus: new residency through real keys',async()=>{await key(e,'Enter');assert.equal(app.menu.kind,'main');await key(e,'Enter');assert.equal(app.menu.kind,'slots');await key(e,'Enter');assert.equal(app.menu.kind,'name');app.nameValue='Tester';app.menu.selection=29;await key(e,'Enter');await settle(e);assert.equal(app.menu.kind,'avatar');app.menu.selection=1;await key(e,'Enter');await settle(e);assert.equal(app.scene.id,'ferry');await key(e,'Enter');await settle(e);assert.equal(app.scene.id,'weighin');});\n await check('full week: mornings, all activities, goals, unlocks, ending and week two',async()=>{\n  if(\"'!app.guest){app.guest=guest('\"'Tester');app.mode='week';app.save.data.slots[0]=app.guest;}app.setDriver('expert');const visited=new Set();\n  for(let day=1;day<=7;day++){\n   app.guest.day=day;app.guest.morning=false;await app.go('weighin');await key(e,'Enter');e.step(905);assert.equal(app.scene.phase,'question','day '+day);await key(e,'Enter');assert.equal(app.guest.ages.length,day);await key(e,'Enter');await settle(e);if(app.dialogue){await key(e,'Enter');await key(e,'Enter');}\n   if(app.scene.id\"'!=='\"'hub')await app.go('hub');\n   for(const a of ACTIVITIES.filter(a=>a.day===day&&a.id\"'!=='\"'long')){\n    await app.go('activity',{id:a.id});app.scene.practice=false;await key(e,'Enter');e.step(181);for(let n=0;n<6500&&app.scene.phase\"'!=='\"'results';n++)e.step(1);assert.equal(app.scene.phase,'results',a.id);assert(app.lastResult.stars>=2,a.id);assert(app.guest.played[a.id]);visited.add(a.id);\n   }\n   if(day===6){await app.go('activity',{id:'tree',hard:true});app.scene.practice=false;await key(e,'Enter');e.step(1800);assert.equal(app.scene.phase,'results');}\n   if(day===7){await app.go('activity',{id:'long'});app.scene.practice=false;await key(e,'Enter');e.step(5900);assert.equal(app.scene.phase,'results');app.scene.resultAction(2);await settle(e);assert.equal(app.scene.id,'ending');const before=[...app.guest.ages];e.step(750);assert(app.guest.confessed);assert.deepEqual(app.guest.ages,before.map(x=>x-7));e.step(900);assert.equal(app.scene.phase,'credits');await key(e,'Enter');await settle(e);assert.equal(app.guest.week,2);assert.equal(app.guest.day,1);}\n   else {assert(app.guest.today.length>0);await app.go('report');await key(e,'Enter');await settle(e);assert.equal(app.guest.day,day+1);}\n  }\n  assert.equal(visited.size,16);assert(app.guest.drips>=175);assert.equal(app.guest.items.length,7);\n });\n await check('all presentation scenes run',async()=>{for(const id of ['hub','jar','records','locker','animation','join','report']){await app.go(id);e.step(5);assert.equal(e.errors.length,0,id);app.closeMenu();}});\n await check('pause freezes fixed game time, resumes exactly',async()=>{app.mode='dropin';await app.go('activity',{id:'tree'});app.scene.practice=false;await key(e,'Enter');e.step(250);const t=app.scene.lanes[1].run.t;await key(e,'Escape');assert.equal(e.timeScale,0);e.step(100);assert.equal(app.scene.lanes[1].run.t,t);await key(e,'Enter');assert(e.timeScale>0);e.step(60);assert(app.scene.lanes[1].run.t>t);});\n await check('all tunables reset and dev tool pages',()=>{for(const [tab,fields]of Object.entries(REGISTRY)){for(const [k,[d,min,max,step]]of Object.entries(fields))app.tunables[k]=max;app.tunables.reset(tab);for(const [k,[d]]of Object.entries(fields))assert.equal(app.tunables[k],d);}for(let i=0;i<7;i++){app.devMenu(i);e.step(1);assert.equal(app.menu.kind,'dev');}app.closeMenu();});\n await check('local four-lane medley and display-only ghosts',async()=>{app.mode='family';app.family=[{type:'bot',name:'One',skill:'expert'},{type:'bot',name:'Two',skill:'good'},{type:'bot',name:'Three',skill:'average'},{type:'bot',name:'Four',skill:'sloppy'}];await app.go('medley');e.step(11200);assert.equal(app.scene.phase,'podium');for(const score of app.scene.totals)assert(score>=0&&score<=3000,score);assert(new (await import('../../src/core/drivers.js')).GhostDriver().displayOnly);});\n await check('attract starts after 10 seconds, loops and exits on input',async()=>{await app.go('title');e.step(605);await settle(e);assert(app.attract);for(let i=0;i<10;i++){e.step(845);await settle(e);assert.equal(e.errors.length,0);}await key(e,'KeyX');assert(\"'!app.attract);assert.equal(app.scene.id,'\"'title');});\n await check('activity recording deterministic replay',async()=>{app.setDriver('expert');app.mode='dropin';await app.go('activity',{id:'tree',demo:true});app.scene.phase='play';e.step(300);const recording=e.recording(),end=app.scene.fingerprint();await e.replay(recording,async()=>{await app.go('activity',{id:'tree',demo:true});app.scene.phase='play';});assert.equal(app.scene.fingerprint(),end);});\n e.dispose?.();app.dispose();\n}\nEOF\ncat > tools/shot.mjs <<'EOF'\nimport {chromium}from'playwright';import{writeFileSync}from'node:fs';import{pathToFileURL}from'node:url';import{resolve}from'node:path';\nconst scene=process.argv[2]||'title',id=process.argv[3]||'tree';const browser=await chromium.launch({headless:true,args:['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader']});\ntry{const page=await browser.newPage({viewport:{width:1920,height:1080}});await page.goto(pathToFileURL(resolve('.build/game.html')).href);await page.waitForFunction(()=>window.__PIXEL_ENGINE__?.game);if(scene\"'!=='\"'title')await page.evaluate(async([scene,id])=>{const a=__GAME__;a.guest={name:'Alex',avatar:0,look:{},day:5,week:1,drips:72,stars:12,ages:[75,70,62,55,47],tests:[],played:{},records:{},today:[],items:[]};await a.go(scene,{id});if(scene==='activity'){a.setDriver('expert');a.scene.phase='play';}},[scene,id]);await page.waitForTimeout(600);const data=await page.evaluate(async()=>{const e=__PIXEL_ENGINE__;e.step(30);const f=await e.renderer.capture();const c=document.createElement('canvas');c.width=f.width;c.height=f.height;const g=c.getContext('2d');g.putImageData(new ImageData(new Uint8ClampedArray(f.pixels),f.width,f.height),0,0);g.imageSmoothingEnabled=false;if(e.hud.canvas?.width)g.drawImage(e.hud.canvas,0,0,f.width,f.height);return c.toDataURL();});const path=\"'`check/visual/${scene}-${id}.png`;writeFileSync(path,Buffer.from(data.split('\"',')[1],'base64'));console.log(path);console.log(await page.evaluate(()=>__GAME__.state()));}finally{await browser.close();}\nEOF\nnode tools/test.mjs --fast\"","aggregated_output":"FAIL activity idle / sloppy / expert header: AssertionError [ERR_ASSERTION]: Expected values to be strictly equal:\n\n1 !== 0\n\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261104-221722__x6981e3/work/Fit-of-Stillness-Wii-Fit-gpt-6.1-sol-max-20261104-221722/tests/headless/suite.mjs:30:536\n    at check (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261104-221722__x6981e3/work/Fit-of-Stillness-Wii-Fit-gpt-6.1-sol-max-20261104-221722/tools/test.mjs:3:48)\n    at runHeadless (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261104-221722__x6981e3/work/Fit-of-Stillness-Wii-Fit-gpt-6.1-sol-max-20261104-221722/tests/headless/suite.mjs:30:34)\n    at async file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261104-221722__x6981e3/work/Fit-of-Stillness-Wii-Fit-gpt-6.1-sol-max-20261104-221722/tools/test.mjs:4:1\nFAIL full week: mornings, all activities, goals, unlocks, ending and week two: AssertionError [ERR_ASSERTION]: tree\n\n'intro' !== 'results'\n\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261104-221722__x6981e3/work/Fit-of-Stillness-Wii-Fit-gpt-6.1-sol-max-20261104-221722/tests/headless/suite.mjs:43:167\n    at async check (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261104-2