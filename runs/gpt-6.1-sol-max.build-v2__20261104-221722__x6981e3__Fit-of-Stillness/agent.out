(x=>({box:[.16,1.5,.16],at:[x,.9,0],c:'brace'})),{box:[1.2,.15,.15],at:[0,1.5,0],c:'wood'},{box:[.16,.16,2],at:[0,1.55,.1],rot:[-25,0,0],c:'wood'},{ball:[.5,.2,.5],at:[0,1.98,1],c:'bowl',seg:8}\n]);\nexport const stepPlatform = def('step-platform','A low aerobic step with two white endcaps',{body:'teal',trim:'white'},[{box:[1.4,.22,.85],at:[0,.11,0],c:'body'},...[-.58,.58].map(x=>({box:[.18,.06,.85],at:[x,.25,0],c:'trim'}))]);\nexport const MODELS = new ModelCatalog([...MODEL_LIBRARY.all(),ounce,palm,pavilion,kettlebell,roller,dumbbell,mat,jar,hoop,coconut,flip,pineapple,kevin,hammock,locker,ferry,scooter,catapult,stepPlatform]);\nexport const OWN_MODELS = [ounce,palm,pavilion,kettlebell,roller,dumbbell,mat,jar,hoop,coconut,flip,pineapple,kevin,hammock,locker,ferry,scooter,catapult,stepPlatform];\nEOF\ncat > src/art/textures.js <<'EOF'\nimport { textureDef, TEXTURE_LIBRARY } from '../../pixel-engine.js';\nexport const tile = textureDef({id:'clinic-tile',size:[16,16],tile:true,palette:{grout:'mist',a:'white',b:'white'},layers:[{pattern:'tiles',colors:['grout','a','b'],w:16,h:16,mortar:1,seed:3}],about:'Spotless square clinic tiles with a fine grey grout',tags:['floor']});\nTEXTURE_LIBRARY.add(tile);\nEOF\ncat > src/art/clips.js <<'EOF'\nimport { HERO_RIG, HERO_CLIPS, placeFeet, gaitClip, mirror } from '../../pixel-engine.js';\nconst hold=(name,pose)=>({name,frames:60,loop:true,keys:[[0,pose],[60,pose]]});\nconst feet=(pose,R={z:0},L={z:0})=>placeFeet(pose,HERO_RIG,{R,L});\nexport const POSES = [\n hold('Tree',{Pelvis:{p:[.03,-.02,0]},ArmR:[-172,0,-6],ForearmR:[-14,0,0],ArmL:[-172,0,6],ForearmL:[-14,0,0],LegR:[-62,0,-58],ShinR:[150,0,0],FootR:[30,0,0]}),\n hold('Heron',{Pelvis:{p:[0,-.02,0]},Torso:[10,0,0],Head:[-14,0,0],ArmR:[-20,0,-80],ArmL:[-20,0,80],ForearmR:[-30,0,0],ForearmL:[-30,0,0],LegR:[-85,0,0],ShinR:[95,0,0],FootR:[35,0,0]}),\n hold('Warrior',feet({Pelvis:{p:[0,-.2,0]},Torso:[0,25,0],Head:[0,40,0],ArmR:[0,0,-90],ArmL:[0,0,90]},{z:.38},{z:-.38})),\n hold('C