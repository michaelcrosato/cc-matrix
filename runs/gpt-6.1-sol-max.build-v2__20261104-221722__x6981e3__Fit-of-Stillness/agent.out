{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport {validateClip,analyzeClip,HERO_RIG,loadModel,compileClips,checkModel,validateTexture,parseSong} from './pixel-engine.js';import{OWN_CLIPS}from'./src/art/clips.js';import{OWN_MODELS,MODELS}from'./src/art/models.js';import{tile}from'./src/art/textures.js';import{SONGS}from'./src/audio/songs.js';\nfor(const c of OWN_CLIPS){const p=validateClip(c,HERO_RIG);if(p.length)console.log(c.name,p);}\nfor(const m of OWN_MODELS){const p=checkModel(m,{catalog:MODELS});if(p.problems.length)console.log(m.id,p.problems);}\nconsole.log('texture',validateTexture(tile));for(const [id,s]of Object.entries(SONGS))try{parseSong(s);}catch(e){console.log(id,e.message)}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
