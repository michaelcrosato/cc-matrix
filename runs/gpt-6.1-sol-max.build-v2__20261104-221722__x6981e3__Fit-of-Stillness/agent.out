{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser/suite.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {chromium,firefox,webkit,devices}from'playwright';\nimport{createServer}from'node:http';\nimport{readFileSync,writeFileSync,copyFileSync,mkdirSync}from'node:fs';\nimport{pathToFileURL}from'node:url';\nimport{resolve,extname}from'node:path';\nconst flags=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader'];\nconst uri=pathToFileURL(resolve('.build/game.html')).href;\nconst stub=()=>{window.__pads=[null,null,null,null];window.__padState=(index,axes=[0,0],buttons=[])=>{__pads[index]={id:'DualSense stand-in '+index,index,connected:true,mapping:'standard',timestamp:performance.now(),axes:[...axes,0,0],buttons:Array.from({length:17},(_,i)=>({pressed:buttons.includes(i),value:buttons.includes(i)?1:0,touched:false}))};};navigator.getGamepads=()=>__pads;};\nasync function boot(browser,options={}){const p=await browser.newPage({viewport:{width:1920,height:1080},...options});const errors=[];p.on('pageerror',e=>errors.push(e.message));p.on('console',m=>{if(m.type()==='error')errors.push(m.text());});await p.addInitScript(stub);await p.goto(uri);await p.waitForFunction(()=>window.__PIXEL_ENGINE__?.game,{timeout:25000});await p.evaluate(()=>__PIXEL_ENGINE__.step(1));p.gameErrors=errors;return p;}\nasync function key(p,code){await p.evaluate(k=>{const e=__PIXEL_ENGINE__;e.input.setKey(k,true);e.step(1);e.input.setKey(k,false);e.step(1);},code);await p.evaluate(async()=>{if(__GAME__.loading)await __GAME__.loading;__PIXEL_ENGINE__.step(1);});}\nasync function capture(p,name){const data=await p.evaluate(async()=>{const e=__PIXEL_ENGINE__;e.step(1);const f=await e.renderer.capture();const c=document.createElement('canvas');c.width=f.width;c.height=f.height;const g=c.getContext('2d');g.putImageData(new ImageData(new Uint8ClampedArray(f.pixels),f.width,f.height),0,0);g.imageSmoothingEnabled=false;if(e.hud.canvas)g.drawImage(e.hud.canvas,0,0,f.width,f.height);return c.toDataURL();});writeFileSync('check/visual/'+name+'.png',Buffer.from(data.split(',')[1],'base64'));}\nexport async function runBrowser(check){\n const browser=await chromium.launch({headless:true,args:flags});let page;\n try{\n await check('browser file boot WebGPU / music 10 percent',async()=>{page=await boot(browser);assert.equal(await page.title(),'Fit of Stillness');const state=await page.evaluate(()=>({a:__GAME__.state(),e:__PIXEL_ENGINE__.state()}));assert.equal(state.a.scene,'title');assert.equal(state.a.music,.1);assert.equal(state.e.backend,'webgpu');assert.deepEqual(page.gameErrors,[]);});if(\"'!page)return;\n await check('\"'pad Cross, glyph choices, key and mouse switch',async()=>{await page.evaluate(()=>{__padState(0,[0,0],[0]);__PIXEL_ENGINE__.step(1);__padState(0);__PIXEL_ENGINE__.step(1);});assert.equal(await page.evaluate(()=>__GAME__.menu.kind),'main');assert.equal(await page.evaluate(()=>__GAME__.state().prompts.confirm),'Cross');await page.evaluate(()=>{__GAME__.settings.glyphs='Xbox';__PIXEL_ENGINE__.step(1);});assert.equal(await page.evaluate(()=>__GAME__.state().prompts.confirm),'A');await key(page,'ArrowDown');assert.equal(await page.evaluate(()=>__GAME__.state().prompts.device),'keyboard');await page.mouse.move(200,600);await page.evaluate(()=>__PIXEL_ENGINE__.step(1));assert.equal(await page.evaluate(()=>__GAME__.state().device),'mouse');});\n await check('native mouse hover focus and click activate',async()=>{await page.evaluate(()=>{__GAME__.mainMenu();__PIXEL_ENGINE__.step(1);});const r=await page.evaluate(()=>__GAME__.state().rects[1]);const dims=await page.evaluate(()=>({w:__PIXEL_ENGINE__.hud.width,h:__PIXEL_ENGINE__.hud.height}));await page.mouse.move((r.x+30)/dims.w*1920,(r.y+r.h/2)/dims.h*1080);await page.evaluate(()=>__PIXEL_ENGINE__.step(2));assert.equal(await page.evaluate(()=>__GAME__.menu.selection),1);await page.mouse.click((r.x+30)/dims.w*1920,(r.y+r.h/2)/dims.h*1080);await page.evaluate(()=>__PIXEL_ENGINE__.step(2));assert.equal(await page.evaluate(()=>__GAME__.menu.kind),'dropin');});\n await check('live local two pads plus keyboard are independent',async()=>{await page.evaluate(async()=>{const a=__GAME__;a.closeMenu();a.mode='family';a.family=[{type:'keyboard',name:'Keys'},{type:'pad',index:0,name:'Pad one'},{type:'pad',index:1,name:'Pad two'}];a.fillBots=false;await a.go('medley');__padState(0,[.8,0]);__padState(1,[-.8,0]);const e=__PIXEL_ENGINE__;e.input.setKey('KeyW',true);e.step(60);e.input.setKey('KeyW',false);});const s=await page.evaluate(()=>__GAME__.state());assert.equal(s.lanes.length,3);assert(s.lanes[1].dot.x>.2,JSON.stringify(s.lanes));assert(s.lanes[2].dot.x<-.2,JSON.stringify(s.lanes));assert(s.lanes[0].dot.y>.2,JSON.stringify(s.lanes));await page.evaluate(()=>{__pads=[null,null,null,null];});});\n await check('synth SFX, music and offline formant voices make sound',async()=>{await page.mouse.click(15,15);await page.evaluate(()=>{__GAME__.engine.audio.unlock();});await page.waitForTimeout(80);const result=await page.evaluate(async()=>{const a=__GAME__,audio=a.engine.audio,ctx=audio.context;const analyser=ctx.createAnalyser();analyser.fftSize=2048;(audio.buses.master||audio.buses.sfx).connect(analyser);audio.stopMusic();audio.play('bonk',{volume:1});await new Promise(r=>setTimeout(r,35));const buffer=new Float32Array(analyser.fftSize);analyser.getFloatTimeDomainData(buffer);const sfx=Math.sqrt(buffer.reduce((s,v)=>s+v*v,0)/buffer.length);a.soundTest='step';a.engine.audio.playMusic(null);a.scene.resumeMusic?.();let music=0;for(let i=0;i<10;i++){audio.update();await new Promise(r=>setTimeout(r,55));analyser.getFloatTimeDomainData(buffer);music=Math.max(music,Math.sqrt(buffer.reduce((s,v)=>s+v*v,0)/buffer.length));}const offline=new OfflineAudioContext(1,44100*2,44100);const syllables=a.voice.syllabify('Thank you. Please stand.','Ounce');a.voice.render(offline,offline.destination,syllables,0);const rendered=await offline.startRendering(),data=rendered.getChannelData(0),voice=Math.sqrt(data.reduce((s,v)=>s+v*v,0)/data.length);return{sfx,music,voice,ounce:syllables[0].f0,coach:a.voice.syllabify('Thank you.','Coach')[0].f0};});assert(result.sfx>.001,JSON.stringify(result));assert(result.music>.0001,JSON.stringify(result));assert(result.voice>.02,JSON.stringify(result));assert(result.ounce>result.coach);});\n for(const [w,h]of[[1920,1080],[1280,720],[640,360],[2560,1080],[1024,768]])await check(\"'`layout screens ${w}x${h}`,async()=>{await page.setViewportSize({width:w,height:h});await page.evaluate(async()=>{__GAME__.setDriver(null);await __GAME__.go('\"'title');});for(const kind of ['main','dropin','settings','pause','dev','about']){await page.evaluate(kind=>{const a=__GAME__;if(kind==='main')a.mainMenu();if(kind==='dropin')a.dropIn();if(kind==='settings')a.settingsMenu();if(kind==='pause'){a.closeMenu();a.pause();}if(kind==='dev')a.devMenu();if(kind==='about')a.aboutMenu();__PIXEL_ENGINE__.step(1);},kind);const s=await page.evaluate(()=>__GAME__.state());assert.deepEqual(s.overflow,[],kind+' '+JSON.stringify(s.overflow));}await page.evaluate(()=>__GAME__.closeMenu());if(w===1920)await capture(page,'menus-desktop');});\n await check('scene browser hooks, HUD and visual captures',async()=>{await page.setViewportSize({width:1920,height:1080});await page.evaluate(()=>{const a=__GAME__;a.guest={name:'Alex',avatar:0,look:{},day:5,week:1,drips:72,stars:12,ages:[75,70,62,55,47],tests:[],played:{},records:{},today:[],items:[]};});for(const [scene,id]of[['title','tree'],['hub','tree'],['activity','tree'],['activity','squat'],['activity','hoop'],['activity','step'],['activity','header'],['activity','slack'],['activity','tray'],['activity','jog'],['activity','pier'],['weighin','tree'],['report','tree'],['records','tree'],['jar','tree'],['locker','tree'],['ending','tree'],['join','tree']]){await page.evaluate(async([scene,id])=>{const a=__GAME__;await a.go(scene,{id});if(scene==='activity'){a.setDriver('expert');a.scene.phase='play';}__PIXEL_ENGINE__.step(30);},[scene,id]);await capture(page,\"'`screen-${scene}-${id}`);assert.deepEqual(await page.evaluate(()=>__PIXEL_ENGINE__.errors),[],scene+id);}});\n await check('\"'phone touch required message, settings gear and looping attract',async()=>{const phone=await boot(browser,{...devices['iPhone SE (3rd gen)']});try{const s=await phone.evaluate(()=>__GAME__.state());assert(s.touchOnly);assert.equal(await phone.evaluate(()=>__PIXEL_ENGINE__.touch),null);assert(await phone.locator('.settings-button').count()>0);await capture(phone,'phone-required');await phone.evaluate(()=>__PIXEL_ENGINE__.step(605));await phone.evaluate(async()=>{if(__GAME__.loading)await __GAME__.loading;__PIXEL_ENGINE__.step(2);});assert(await phone.evaluate(()=>__GAME__.attract));await phone.touchscreen.tap(90,200);await phone.evaluate(()=>__PIXEL_ENGINE__.step(2));await phone.evaluate(async()=>{if(__GAME__.loading)await __GAME__.loading;});assert.equal(await phone.evaluate(()=>__GAME__.attract),false);assert.equal(await phone.evaluate(()=>__GAME__.scene.id),'title');await phone.locator('.settings-button').tap();assert(await phone.evaluate(()=>__PIXEL_ENGINE__.settings.isOpen));}finally{await phone.close();}});\n await check('Chromium tablet / narrow foldable overflow',async()=>{for(const device of ['iPad Mini','Galaxy Z Fold 5']){const d=devices[device]||devices['Pixel 7'];const p=await boot(browser,{...d});try{assert.equal(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),true);await capture(p,'device-'+device.replaceAll(' ','-'));assert.deepEqual(p.gameErrors,[]);}finally{await p.close();}}});\n await check('no browser or engine errors after all scenes',async()=>{assert.deepEqual(page.gameErrors,[]);assert.deepEqual(await page.evaluate(()=>__PIXEL_ENGINE__.errors),[]);});\n await page.close();page=null;\n await runHub(browser,check);\n }finally{await page?.close();await browser.close();}\n for(const [name,type]of[['Firefox',firefox],['WebKit iPhone',webkit]])await check(name+' WebGPU failure is handled without page errors',async()=>{const b=await type.launch({headless:true});const p=await b.newPage(name.startsWith('WebKit')?devices['iPhone 17 Pro']:{});const errors=[];p.on('pageerror',e=>errors.push(e.message));try{await p.goto(uri);await p.waitForFunction(()=>document.body.textContent.includes('Failed to start:'),{timeout:20000});assert((await p.textContent('body')).includes('WebGPU unavailable'));assert.deepEqual(errors,[]);await p.screenshot({path:'check/visual/fallback-'+name.split(' ')[0]+'.png'});}finally{await b.close();}});\n}\nasync function runHub(browser,check){\n const root=resolve('.build/harness');mkdirSync(root,{recursive:true});copyFileSync('.build/game.html',root+'/game.html');for(const file of ['harness.html','bridge.js','round.js'])copyFileSync('vendor/hub/'+file,root+'/'+file);\n const server=createServer((req,res)=>{try{const path=new URL(req.url,'http://127.0.0.1').pathname;const file=resolve(root,'.'+path);if(\"'!file.startsWith(root+'\"'/')){res.writeHead(403);return res.end();}const bytes=readFileSync(file);res.setHeader('Content-Type',extname(file)==='.js'?'text/javascript':extname(file)==='.html'?'text/html':'application/octet-stream');res.end(bytes);}catch{res.writeHead(404);res.end();}});await new Promise(r=>server.listen(0,'127.0.0.1',r));const url=\"'`http://127.0.0.1:${server.address().port}/`;\n try{for(const query of ['\"'players=1','players=2','players=4&latency=150&jitter=50&loss=5','players=4&latency=150&jitter=50&loss=5&scenario=host-leave'])await check('Hub harness '+query,async()=>{const p=await browser.newPage({viewport:{width:1280,height:720}});try{const verify=await p.request.get(url+'game.html');assert((await verify.text()).includes('<title>Fit of Stillness</title>'));await p.goto(url+'harness.html?game=game.html&auto=1&'+query);await p.waitForFunction(()=>document.body.dataset.complete==='true',{timeout:120000});const report=await p.evaluate(()=>__hubCheck);writeFileSync('check/hub-'+query.replaceAll(/[\"'^a-z0-9]/g,'\"'-')+'.json',JSON.stringify(report,null,2));assert(report.pass,JSON.stringify(report.checks?.filter(c=>\"'!c.pass)||report));}finally{await p.close();}});}finally{await new Promise(r=>server.close(r));}\n}\nEOF\nnode tools/build.mjs && node tools/test.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
