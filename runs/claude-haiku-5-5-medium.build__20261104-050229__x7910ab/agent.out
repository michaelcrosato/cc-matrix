     this.fire('promoted', true);\")\nrep(\"          if (u.dead) {\\n            k.state = 'wounded'; k.woundedFor = 1;\",\n    \"          if (u.dead) {\\n            if (k.id === 'gray') this.fire('wounded', 'gray');\\n            k.state = 'wounded'; k.woundedFor = 1;\")\nrep(\"              else s.realms[realm].rulerWounded = true;\",\n    \"              else { s.realms[realm].rulerWounded = true; this.fire('ruler-hurt', true); }\")\nrep(\"      if (attackerWon) {\\n        const old = this.ownerOf(castle);\",\n    \"      if (attackerWon) {\\n        const old = this.ownerOf(castle);\\n        if (this.isHuman(m.by)) this.fire('capture', castle);\\n        if (this.isHuman(old)) this.fire('castle-lost', castle);\\n        if (H.get('castle', castle).capital && this.isHuman(old)) this.fire('castle-lost', castle);\")\nrep(\"          if (k.questFor <= 0) { k.state = 'ready'; this.moveKnight(k, k.questFrom); this.questReward(k); }\",\n    \"          if (k.questFor <= 0) { k.state = 'ready'; this.moveKnight(k, k.questFrom); this.questReward(k); this.fire('quest-return', true); }\")\nopen(p,'w').write(s); print('sim ok')\nEOF\nnode tools/build.mjs >/dev/null && node tests/run.mjs 2>&1 | grep -v \"^    at\" | head -6","description":"Add story triggers, queue and effects to the campaign sim; run suites"}},"wire_ingest_context":{"toolu_01RhNcuYBuuoonY7hYEDsU3H":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-050229__x7910ab/work/BrigantimeTheLegendOfForseasons-BrigandineTheLegendOfForsena-claude-haiku-5-5-medium-20261104-050229"}}}
