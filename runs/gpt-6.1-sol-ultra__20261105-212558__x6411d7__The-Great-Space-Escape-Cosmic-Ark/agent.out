{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='test.py';s=open(p).read().replace(\\\"r'(\\\\\\\\d+) simulation checks:'\\\", \\\"r'(\\\\\\\\d+) (?:simulation|browser) checks:'\\\")\nopen(p,'w').write(s)\np='simulation-tests.mjs';s=open(p).read();marker=\\\"console.log(\"'`${passed + failed} simulation checks:\"\npos=s.find(marker)\nprint(s[-350:])\nPY'","aggregated_output":"ng mutable game objects', game => {\n  game.start();\n  const snapshot = game.snapshot();\n  snapshot.players[0].x = 99;\n  assert.notEqual(game.state.players[0].x, 99);\n  assert.doesNotThrow(() => JSON.stringify(snapshot));\n});\n\nconsole.log(`${passed + failed} simulation checks: ${passed} passed, ${failed} failed`);\nprocess.exitCode = failed ? 1 : 0;\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='index.template.html';s=open(p).read().replace('</style>', '''@media(max-height:500px) and (orientation:landscape){body.touch #title{padding:28px 7vw 22px\"'!important}body.touch .brandline{top:12px;font-size:8px;letter-spacing:1.4px}body.touch .brandline .mark{width:22px;height:22px;font-size:16px}body.touch #title h1{font-size:clamp(34px,5.2vw,44px);margin:20px 0 9px;line-height:.89}body.touch #title .tagline{font-size:16px!important;margin-bottom:12px!important}body.touch .titleActions{gap:7px}body.touch .titleActions button{padding:8px 10px;font-size:12px}body.touch .titleActions .primary{font-size:15px}body.touch .titleFoot{bottom:11px;font-size:7px;letter-spacing:1px}body.touch .sceneTag{bottom:15vh}}'\"\\\\n</style>''')\nopen(p,'w').write(s)\np='simulation-tests.mjs';s=open(p).read();i=s.index('console.log(\"'`${passed + failed} simulation checks:'\"');s=s[:i]+'''run('disconnected pilots cannot fire, fly or take sentry damage', game => {\n  isolated(game);\n  const p=game.state.players[0];p.active=false;\n  tick(game,.3,{0:{fire:true,pulse:true,x:1,y:1}});\n  assert.equal(game.state.shots.length,0);\n  game.beginRescue();p.x=0;p.y=-2.4;\n  const x=p.x,y=p.y,hull=game.state.hull;\n  tick(game,.1,{0:{fire:true,pulse:true,x:1,y:1}});\n  assert.equal(p.x,x);assert.equal(p.y,y);assert.equal(p.beam,false);assert.equal(game.state.hull,hull);\n});\n\n'''+s[i:];open(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='index.template.html';s=open(p).read().replace('</style>', '''@media(max-height:500px) and (orientation:landscape){body.touch #title{padding:28px 7vw 22px\"'!important}body.touch .brandline{top:12px;font-size:8px;letter-spacing:1.4px}body.touch .brandline .mark{width:22px;height:22px;font-size:16px}body.touch #title h1{font-size:clamp(34px,5.2vw,44px);margin:20px 0 9px;line-height:.89}body.touch #title .tagline{font-size:16px!important;margin-bottom:12px!important}body.touch .titleActions{gap:7px}body.touch .titleActions button{padding:8px 10px;font-size:12px}body.touch .titleActions .primary{font-size:15px}body.touch .titleFoot{bottom:11px;font-size:7px;letter-spacing:1px}body.touch .sceneTag{bottom:15vh}}'\"\\\\n</style>''')\nopen(p,'w').write(s)\np='simulation-tests.mjs';s=open(p).read();i=s.index('console.log(\"'`${passed + failed} simulation checks:'\"');s=s[:i]+'''run('disconnected pilots cannot fire, fly or take sentry damage', game => {\n  isolated(game);\n  const p=game.state.players[0];p.active=false;\n  tick(game,.3,{0:{fire:true,pulse:true,x:1,y:1}});\n  assert.equal(game.state.shots.length,0);\n  game.beginRescue();p.x=0;p.y=-2.4;\n  const x=p.x,y=p.y,hull=game.state.hull;\n  tick(game,.1,{0:{fire:true,pulse:true,x:1,y:1}});\n  assert.equal(p.x,x);assert.equal(p.y,y);assert.equal(p.beam,false);assert.equal(game.state.hull,hull);\n});\n\n'''+s[i:];open(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"Built The-Great-Space-Escape-Cosmic-Ark-gpt-6.1-sol-ultra-20261105-212558.html\n","exit_code":0,"status":"completed"}}
