{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport const DEFAULTS={meteorSpeed:1,threatRate:1,defenseDuration:24,rescueTime:75,beamPower:1,pilotSpeed:1,invincible:false};\nexport async function initPhysics(){await RAPIER.init();return RAPIER.version();}\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nexport class Game {\n constructor(audio){this.audio=audio;this.config={...DEFAULTS};this.serial=1;this.rngState=58261;this.reset('title',1);}\n random(){this.rngState=(1664525*this.rngState+1013904223)>>>0;return this.rngState/4294967296;}\n reset(phase='defense',count=1,ids=null){if(this.physics)this.physics.free();this.physics=new RAPIER.World({x:0,y:0,z:0});this.queue=new RAPIER.EventQueue(true);this.handles=new Map();this.bodies=new Map();this.accum=0;this.spawnClock=0;this.shotClock={};this.damageClock=0;this.phaseClock=0;this.finished=false;this.state={phase,world:0,time:0,phaseTime:0,remaining:this.config.defenseDuration,attract:false,players:Array.from({length:count},(_,i)=>({id:ids?ids[i]:i,x:(i-(count-1)/2)*2,y:0,aimX:0,aimY:1,beam:false,active:true,color:['#8fffd1','#ffb061','#85b5ff','#ee9eff'][i],shield:0,cargo:[],rescues:0,pulse:0})),meteors:[],shots:[],critters:[],enemies:[],effects:[],hull:6,maxHull:6,charge:100,rescued:0,totalRescued:0,goal:4,score:0,combo:0,kills:0,finalDefense:false,announcement:'',announcementTime:0,ended:false};this.addArk();if(phase==='title')this.makeCritters();}\n addArk(){const b=this.physics.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0,0,0));const c=this.physics.createCollider(RAPIER.ColliderDesc.ball(1.8).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),b);this.handles.set(c.handle,{kind:'ark'});}\n body(entity,kind,r,vx,vy){const b=this.physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(entity.x,entity.y,0).setGravityScale(0).setLinvel(vx,vy,0).lockRotations().setEnabledTranslations(true,true,false).setCcdEnabled(true));const c=this.physics.createCollider(RAPIER.ColliderDesc.ball(r).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),b);this.bodies.set(entity.id,b);this.handles.set(c.handle,{kind,id:entity.id});entity.vx=vx;entity.vy=vy;}\n remove(entity,arr){const body=this.bodies.get(entity.id);if(body){for(let i=0;i<body.numColliders();i++)this.handles.delete(body.collider(i).handle);this.physics.removeRigidBody(body);this.bodies.delete(entity.id);}const n=arr.indexOf(entity);if(n>=0)arr.splice(n,1);}\n clearPhysics(){for(const m of [...this.state.meteors])this.remove(m,this.state.meteors);for(const m of [...this.state.shots])this.remove(m,this.state.shots);}\n effect(x,y,kind='boom',life=.55){this.state.effects.push({id:this.serial++,x,y,kind,life,maxLife:life});}\n announce(text){this.state.announcement=text;this.state.announcementTime=3.2;this.audio?.event('voice');}\n start(count=1,ids=null,attract=false){this.reset('defense',count,ids);this.state.attract=attract;this.announce('METEORS INBOUND · PROTECT THE ARK');}\n makeCritters(){this.state.critters=Array.from({length:4},(_,i)=>({id:this.serial++,x:[-11,-5,5,11][i],y:-6.5,type:this.state.world*2+(i%2),status:'ground',lift:0,owner:null,world:this.state.world}));this.state.enemies=[{id:this.serial++,x:-14,y:-2.6},{id:this.serial++,x:14,y:-4}];}\n beginRescue(){this.clearPhysics();this.state.phase='rescue';this.state.phaseTime=0;this.state.remaining=this.config.rescueTime;this.state.rescued=0;this.makeCritters();this.state.players.forEach((p,i)=>{p.x=(i-(this.state.players.length-1)/2)*2.8;p.y=4.6;p.cargo=[];p.beam=false;});this.announce('FIND THE PAIRS · BRING THEM HOME');this.audio?.event('warp');}\n warp(next){this.clearPhysics();this.state.phase='warp';this.state.phaseTime=0;this.state.nextPhase=next;this.state.remaining=4;this.state.players.forEach(p=>p.beam=false);this.audio?.event('warp');}\n advance(){const s=this.state;if(s.phase==='defense'){if(s.finalDefense)this.end(true);else this.warp('rescue');}else if(s.phase==='rescue'){s.score+=1000+s.hull*150;s.hull=Math.min(s.maxHull,s.hull+1);if(s.world===2){s.finalDefense=true;this.warp('finale');}else{s.world++;this.warp('defense');}}else if(s.phase==='warp'){if(s.nextPhase==='rescue')this.beginRescue();else{this.state.phase='defense';this.state.phaseTime=0;this.state.remaining=s.finalDefense?30:this.config.defenseDuration;this.spawnClock=0;this.state.critters=[];this.state.enemies=[];this.announce(s.finalDefense?'LAST LIGHT · ONE FINAL STORM':'METEORS INBOUND · PROTECT THE ARK');}}}\n end(won){if(this.finished)return;this.finished=true;this.clearPhysics();this.state.phase=won?'victory':'gameover';this.state.ended=true;this.state.players.forEach(p=>p.beam=false);this.audio?.event(won?'win':'lose');this.onFinish?.(this.state.score,won);}\n damage(n=1,x=0,y=0){if(this.config.invincible||this.state.attract||this.damageClock>0)return;this.state.hull=Math.max(0,this.state.hull-n);this.damageClock=.8;this.state.combo=0;this.effect(x,y,'hit',.8);this.audio?.event('hit');if(this.state.hull<=0)this.end(false);}\n spawnMeteor(side=null){const s=this.state;side??=Math.floor(this.random()*4);const tangent=(this.random()-.5)*5;let x,y;if(side===0){x=tangent;y=12;}if(side===1){x=19;y=tangent;}if(side===2){x=tangent;y=-12;}if(side===3){x=-19;y=tangent;}const speed=(2.7+s.world*.55+(s.finalDefense?1.1:0))*this.config.meteorSpeed;const d=Math.hypot(x,y);const m={id:this.serial++,x,y,r:.5+this.random()*.28,kind:this.random()<.2?'crystal':'rock'};s.meteors.push(m);this.body(m,'meteor',m.r,-x/d*speed,-y/d*speed);return m;}\n shoot(p){const s=this.state;const dx=p.aimX,dy=p.aimY;const m={id:this.serial++,x:dx*2.2,y:dy*2.2,angle:Math.atan2(dy,dx),owner:p.id,life:2};s.shots.push(m);this.body(m,'shot',.35,dx*29,dy*29);this.effect(dx*2,dy*2,'muzzle',.12);this.audio?.event('shot');}\n pulse(p){const s=this.state;if(s.charge<38)return;s.charge-=38;p.shield=.9;this.effect(0,0,'pulse',.75);this.audio?.event('dash');for(const m of [...s.meteors]){if(Math.hypot(m.x,m.y)<9){this.effect(m.x,m.y,'boom');this.remove(m,s.meteors);s.score+=75;s.kills++;}}}\n autopilot(){const s=this.state;const inputs={};for(const p of s.players){if(s.phase==='defense'){const m=[...s.meteors].sort((a,b)=>Math.hypot(a.x,a.y)-Math.hypot(b.x,b.y))[0];inputs[p.id]={x:0,y:0,aimX:m?m.x:0,aimY:m?m.y:1,fire:true,pulse:s.meteors.length>5};}else if(s.phase==='rescue'){let tx,ty;const c=s.critters.filter(c=>c.status==='ground'&&\"'!s.players.some(q=>q.id!==p.id&&q.target===c.id)).sort((a,b)=>Math.abs(a.x-p.x)-Math.abs(b.x-p.x))[0];if(p.cargo.length>=2||(!c&&p.cargo.length)){tx=(p.id%2)*1.2;ty=5.8;p.target=null;}else if(c){tx=c.x;ty=-3.6;p.target=c.id;}else{tx=0;ty=5.8;}inputs[p.id]={x:clamp((tx-p.x)*2,-1,1),y:clamp((ty-p.y)*2,-1,1),fire:Math.abs(tx-p.x)<1.4&&ty<0,pulse:false};}}\n return inputs;}\n update(dt,inputs={}){const s=this.state;if(['\"'title','victory','gameover'].includes(s.phase))return;dt=Math.min(dt,.05);s.time+=dt;s.phaseTime+=dt;this.damageClock=Math.max(0,this.damageClock-dt);s.announcementTime=Math.max(0,s.announcementTime-dt);s.charge=Math.min(100,s.charge+dt*8);for(const fx of s.effects)fx.life-=dt;s.effects=s.effects.filter(f=>f.life>0);if(s.attract)inputs=this.autopilot();if(s.phase==='warp'){s.remaining=4-s.phaseTime;if(s.phaseTime>=4)this.advance();return;}\n for(const p of s.players){const u=inputs[p.id]||{};p.shield=Math.max(0,p.shield-dt);p.pulse=Math.max(0,p.pulse-dt);if(s.phase==='defense'){let ax=u.aimX||u.x||0,ay=u.aimY||u.y||0;if(Math.hypot(ax,ay)>.2){if(Math.abs(ax)>Math.abs(ay)){p.aimX=Math.sign(ax);p.aimY=0;}else{p.aimX=0;p.aimY=Math.sign(ay);}}this.shotClock[p.id]=Math.max(0,(this.shotClock[p.id]||0)-dt);if(u.fire&&this.shotClock[p.id]<=0){this.shoot(p);this.shotClock[p.id]=.16;}if(u.pulse&&p.pulse<=0){this.pulse(p);p.pulse=.65;}}\n else{let speed=6.2*this.config.pilotSpeed;if(u.pulse&&p.pulse<=0&&s.charge>=22){s.charge-=22;p.shield=.8;p.pulse=1.2;this.audio?.event('dash');this.effect(p.x,p.y,'pulse');}if(p.shield>0)speed*=1.65;let dx=clamp(u.x||0,-1,1),dy=clamp(u.y||0,-1,1);const len=Math.max(1,Math.hypot(dx,dy));p.x=clamp(p.x+dx/len*speed*dt,-14.5,14.5);p.y=clamp(p.y+dy/len*speed*dt,-5.1,6.7);p.beam=\"'!!u.fire;p.aimX=dx;p.aimY=dy;\n if(p.beam&&p.cargo.length<2&&p.y<1){const c=s.critters.find(c=>c.status==='\"'ground'&&Math.abs(c.x-p.x)<1.65);if(c){c.lift+=dt*this.config.beamPower;if(c.lift>=1.15){c.status='aboard';c.owner=p.id;p.cargo.push(c.id);this.effect(c.x,c.y,'rescue');this.audio?.event('rescue');}}}\n if(Math.abs(p.x)<2.9&&p.y>4.7&&p.cargo.length){const n=p.cargo.length;for(const id of p.cargo){const c=s.critters.find(c=>c.id===id);if(c)c.status='delivered';}p.cargo=[];s.rescued+=n;s.totalRescued+=n;p.rescues+=n;s.score+=n*500;this.effect(p.x,p.y,'rescue',1);this.audio?.event('voice');this.announce(s.rescued===s.goal?'ALL ABOARD\"'!'\"':'SAFE & SOUND · '+s.rescued+' / '+s.goal);}\n }}\n if(s.phase==='rescue'){for(const c of s.critters)if(c.status==='ground'&&\"'!s.players.some(p=>p.beam&&p.y<1&&Math.abs(p.x-c.x)<1.65&&p.cargo.length<2))c.lift=Math.max(0,c.lift-dt*1.5);for(let i=0;i<s.enemies.length;i++){const e=s.enemies[i];e.x=Math.sin(s.phaseTime*.44+i*Math.PI)*13;e.y=-2.4+Math.sin(s.phaseTime*.8+i)*1.1;for(const p of s.players)if(Math.hypot(p.x-e.x,p.y-e.y)<1.25&&p.shield<=0){this.damage(1,p.x,p.y);p.shield=1.8;}}\n s.remaining-=dt;if(s.rescued>=s.goal){this.advance();return;}if(s.remaining<=0){this.damage(2);if(s.phase==='\"'gameover')return;s.remaining=this.config.rescueTime*.5;this.announce('SOLAR FLARE\"'! · FINISH THE RESCUE'\"');}return;}\n s.remaining-=dt;this.spawnClock-=dt;if(this.spawnClock<=0){this.spawnMeteor();this.spawnClock=(.95-s.world*.12-(s.finalDefense?.2:0))/this.config.threatRate;}\n this.accum+=dt;while(this.accum>=1/60){this.physics.timestep=1/60;this.physics.step(this.queue);this.accum-=1/60;const collisions=[];this.queue.drainCollisionEvents((h1,h2,started)=>{if(started)collisions.push([this.handles.get(h1),this.handles.get(h2)]);});for(const [a,b]of collisions){if(\"'!a||!b)continue;const meteor=a.kind==='\"'meteor'?a:b.kind==='meteor'?b:null;const other=meteor===a?b:a;if(\"'!meteor)continue;const m=s.meteors.find(m=>m.id===meteor.id);if(!m)continue;if(other.kind==='\"'shot'){const shot=s.shots.find(v=>v.id===other.id);if(\"'!shot)continue;this.effect(m.x,m.y,'\"'boom');this.remove(m,s.meteors);this.remove(shot,s.shots);s.combo++;s.kills++;s.score+=100+Math.min(s.combo,10)*10;this.audio?.event('boom');}else if(other.kind==='ark'){this.effect(m.x,m.y,'boom');this.remove(m,s.meteors);this.damage(1,m.x,m.y);}}}\n for(const m of [...s.meteors,...s.shots]){const b=this.bodies.get(m.id);if(b){const pos=b.translation();m.x=pos.x;m.y=pos.y;}}for(const shot of [...s.shots]){shot.life-=dt;if(shot.life<=0)this.remove(shot,s.shots);}for(const m of [...s.meteors])if(Math.hypot(m.x,m.y)>35)this.remove(m,s.meteors);if(s.remaining<=0&&s.phase==='defense')this.advance();}\n snapshot(){return JSON.parse(JSON.stringify(this.state));}\n dispose(){this.queue?.free();this.physics?.free();}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport const DEFAULTS={meteorSpeed:1,threatRate:1,defenseDuration:24,rescueTime:75,beamPower:1,pilotSpeed:1,invincible:false};\nexport async function initPhysics(){await RAPIER.init();return RAPIER.version();}\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nexport class Game {\n constructor(audio){this.audio=audio;this.config={...DEFAULTS};this.serial=1;this.rngState=58261;this.reset('title',1);}\n random(){this.rngState=(1664525*this.rngState+1013904223)>>>0;return this.rngState/4294967296;}\n reset(phase='defense',count=1,ids=null){if(this.physics)this.physics.free();this.physics=new RAPIER.World({x:0,y:0,z:0});this.queue=new RAPIER.EventQueue(true);this.handles=new Map();this.bodies=new Map();this.accum=0;this.spawnClock=0;this.shotClock={};this.damageClock=0;this.phaseClock=0;this.finished=false;this.state={phase,world:0,time:0,phaseTime:0,remaining:this.config.defenseDuration,attract:false,players:Array.from({length:count},(_,i)=>({id:ids?ids[i]:i,x:(i-(count-1)/2)*2,y:0,aimX:0,aimY:1,beam:false,active:true,color:['#8fffd1','#ffb061','#85b5ff','#ee9eff'][i],shield:0,cargo:[],rescues:0,pulse:0})),meteors:[],shots:[],critters:[],enemies:[],effects:[],hull:6,maxHull:6,charge:100,rescued:0,totalRescued:0,goal:4,score:0,combo:0,kills:0,finalDefense:false,announcement:'',announcementTime:0,ended:false};this.addArk();if(phase==='title')this.makeCritters();}\n addArk(){const b=this.physics.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0,0,0));const c=this.physics.createCollider(RAPIER.ColliderDesc.ball(1.8).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),b);this.handles.set(c.handle,{kind:'ark'});}\n body(entity,kind,r,vx,vy){const b=this.physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(entity.x,entity.y,0).setGravityScale(0).setLinvel(vx,vy,0).lockRotations().setEnabledTranslations(true,true,false).setCcdEnabled(true));const c=this.physics.createCollider(RAPIER.ColliderDesc.ball(r).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS),b);this.bodies.set(entity.id,b);this.handles.set(c.handle,{kind,id:entity.id});entity.vx=vx;entity.vy=vy;}\n remove(entity,arr){const body=this.bodies.get(entity.id);if(body){for(let i=0;i<body.numColliders();i++)this.handles.delete(body.collider(i).handle);this.physics.removeRigidBody(body);this.bodies.delete(entity.id);}const n=arr.indexOf(entity);if(n>=0)arr.splice(n,1);}\n clearPhysics(){for(const m of [...this.state.meteors])this.remove(m,this.state.meteors);for(const m of [...this.state.shots])this.remove(m,this.state.shots);}\n effect(x,y,kind='boom',life=.55){this.state.effects.push({id:this.serial++,x,y,kind,life,maxLife:life});}\n announce(text){this.state.announcement=text;this.state.announcementTime=3.2;this.audio?.event('voice');}\n start(count=1,ids=null,attract=false){this.reset('defense',count,ids);this.state.attract=attract;this.announce('METEORS INBOUND · PROTECT THE ARK');}\n makeCritters(){this.state.critters=Array.from({length:4},(_,i)=>({id:this.serial++,x:[-11,-5,5,11][i],y:-6.5,type:this.state.world*2+(i%2),status:'ground',lift:0,owner:null,world:this.state.world}));this.state.enemies=[{id:this.serial++,x:-14,y:-2.6},{id:this.serial++,x:14,y:-4}];}\n beginRescue(){this.clearPhysics();this.state.phase='rescue';this.state.phaseTime=0;this.state.remaining=this.config.rescueTime;this.state.rescued=0;this.makeCritters();this.state.players.forEach((p,i)=>{p.x=(i-(this.state.players.length-1)/2)*2.8;p.y=4.6;p.cargo=[];p.beam=false;});this.announce('FIND THE PAIRS · BRING THEM HOME');this.audio?.event('warp');}\n warp(next){this.clearPhysics();this.state.phase='warp';this.state.phaseTime=0;this.state.nextPhase=next;this.state.remaining=4;this.state.players.forEach(p=>p.beam=false);this.audio?.event('warp');}\n advance(){const s=this.state;if(s.phase==='defense'){if(s.finalDefense)this.end(true);else this.warp('rescue');}else if(s.phase==='rescue'){s.score+=1000+s.hull*150;s.hull=Math.min(s.maxHull,s.hull+1);if(s.world===2){s.finalDefense=true;this.warp('finale');}else{s.world++;this.warp('defense');}}else if(s.phase==='warp'){if(s.nextPhase==='rescue')this.beginRescue();else{this.state.phase='defense';this.state.phaseTime=0;this.state.remaining=s.finalDefense?30:this.config.defenseDuration;this.spawnClock=0;this.state.critters=[];this.state.enemies=[];this.announce(s.finalDefense?'LAST LIGHT · ONE FINAL STORM':'METEORS INBOUND · PROTECT THE ARK');}}}\n end(won){if(this.finished)return;this.finished=true;this.clearPhysics();this.state.phase=won?'victory':'gameover';this.state.ended=true;this.state.players.forEach(p=>p.beam=false);this.audio?.event(won?'win':'lose');this.onFinish?.(this.state.score,won);}\n damage(n=1,x=0,y=0){if(this.config.invincible||this.state.attract||this.damageClock>0)return;this.state.hull=Math.max(0,this.state.hull-n);this.damageClock=.8;this.state.combo=0;this.effect(x,y,'hit',.8);this.audio?.event('hit');if(this.state.hull<=0)this.end(false);}\n spawnMeteor(side=null){const s=this.state;side??=Math.floor(this.random()*4);const tangent=(this.random()-.5)*5;let x,y;if(side===0){x=tangent;y=12;}if(side===1){x=19;y=tangent;}if(side===2){x=tangent;y=-12;}if(side===3){x=-19;y=tangent;}const speed=(2.7+s.world*.55+(s.finalDefense?1.1:0))*this.config.meteorSpeed;const d=Math.hypot(x,y);const m={id:this.serial++,x,y,r:.5+this.random()*.28,kind:this.random()<.2?'crystal':'rock'};s.meteors.push(m);this.body(m,'meteor',m.r,-x/d*speed,-y/d*speed);return m;}\n shoot(p){const s=this.state;const dx=p.aimX,dy=p.aimY;const m={id:this.serial++,x:dx*2.2,y:dy*2.2,angle:Math.atan2(dy,dx),owner:p.id,life:2};s.shots.push(m);this.body(m,'shot',.35,dx*29,dy*29);this.effect(dx*2,dy*2,'muzzle',.12);this.audio?.event('shot');}\n pulse(p){const s=this.state;if(s.charge<38)return;s.charge-=38;p.shield=.9;this.effect(0,0,'pulse',.75);this.audio?.event('dash');for(const m of [...s.meteors]){if(Math.hypot(m.x,m.y)<9){this.effect(m.x,m.y,'boom');this.remove(m,s.meteors);s.score+=75;s.kills++;}}}\n autopilot(){const s=this.state;const inputs={};for(const p of s.players){if(s.phase==='defense'){const m=[...s.meteors].sort((a,b)=>Math.hypot(a.x,a.y)-Math.hypot(b.x,b.y))[0];inputs[p.id]={x:0,y:0,aimX:m?m.x:0,aimY:m?m.y:1,fire:true,pulse:s.meteors.length>5};}else if(s.phase==='rescue'){let tx,ty;const c=s.critters.filter(c=>c.status==='ground'&&\"'!s.players.some(q=>q.id!==p.id&&q.target===c.id)).sort((a,b)=>Math.abs(a.x-p.x)-Math.abs(b.x-p.x))[0];if(p.cargo.length>=2||(!c&&p.cargo.length)){tx=(p.id%2)*1.2;ty=5.8;p.target=null;}else if(c){tx=c.x;ty=-3.6;p.target=c.id;}else{tx=0;ty=5.8;}inputs[p.id]={x:clamp((tx-p.x)*2,-1,1),y:clamp((ty-p.y)*2,-1,1),fire:Math.abs(tx-p.x)<1.4&&ty<0,pulse:false};}}\n return inputs;}\n update(dt,inputs={}){const s=this.state;if(['\"'title','victory','gameover'].includes(s.phase))return;dt=Math.min(dt,.05);s.time+=dt;s.phaseTime+=dt;this.damageClock=Math.max(0,this.damageClock-dt);s.announcementTime=Math.max(0,s.announcementTime-dt);s.charge=Math.min(100,s.charge+dt*8);for(const fx of s.effects)fx.life-=dt;s.effects=s.effects.filter(f=>f.life>0);if(s.attract)inputs=this.autopilot();if(s.phase==='warp'){s.remaining=4-s.phaseTime;if(s.phaseTime>=4)this.advance();return;}\n for(const p of s.players){const u=inputs[p.id]||{};p.shield=Math.max(0,p.shield-dt);p.pulse=Math.max(0,p.pulse-dt);if(s.phase==='defense'){let ax=u.aimX||u.x||0,ay=u.aimY||u.y||0;if(Math.hypot(ax,ay)>.2){if(Math.abs(ax)>Math.abs(ay)){p.aimX=Math.sign(ax);p.aimY=0;}else{p.aimX=0;p.aimY=Math.sign(ay);}}this.shotClock[p.id]=Math.max(0,(this.shotClock[p.id]||0)-dt);if(u.fire&&this.shotClock[p.id]<=0){this.shoot(p);this.shotClock[p.id]=.16;}if(u.pulse&&p.pulse<=0){this.pulse(p);p.pulse=.65;}}\n else{let speed=6.2*this.config.pilotSpeed;if(u.pulse&&p.pulse<=0&&s.charge>=22){s.charge-=22;p.shield=.8;p.pulse=1.2;this.audio?.event('dash');this.effect(p.x,p.y,'pulse');}if(p.shield>0)speed*=1.65;let dx=clamp(u.x||0,-1,1),dy=clamp(u.y||0,-1,1);const len=Math.max(1,Math.hypot(dx,dy));p.x=clamp(p.x+dx/len*speed*dt,-14.5,14.5);p.y=clamp(p.y+dy/len*speed*dt,-5.1,6.7);p.beam=\"'!!u.fire;p.aimX=dx;p.aimY=dy;\n if(p.beam&&p.cargo.length<2&&p.y<1){const c=s.critters.find(c=>c.status==='\"'ground'&&Math.abs(c.x-p.x)<1.65);if(c){c.lift+=dt*this.config.beamPower;if(c.lift>=1.15){c.status='aboard';c.owner=p.id;p.cargo.push(c.id);this.effect(c.x,c.y,'rescue');this.audio?.event('rescue');}}}\n if(Math.abs(p.x)<2.9&&p.y>4.7&&p.cargo.length){const n=p.cargo.length;for(const id of p.cargo){const c=s.critters.find(c=>c.id===id);if(c)c.status='delivered';}p.cargo=[];s.rescued+=n;s.totalRescued+=n;p.rescues+=n;s.score+=n*500;this.effect(p.x,p.y,'rescue',1);this.audio?.event('voice');this.announce(s.rescued===s.goal?'ALL ABOARD\"'!'\"':'SAFE & SOUND · '+s.rescued+' / '+s.goal);}\n }}\n if(s.phase==='rescue'){for(const c of s.critters)if(c.status==='ground'&&\"'!s.players.some(p=>p.beam&&p.y<1&&Math.abs(p.x-c.x)<1.65&&p.cargo.length<2))c.lift=Math.max(0,c.lift-dt*1.5);for(let i=0;i<s.enemies.length;i++){const e=s.enemies[i];e.x=Math.sin(s.phaseTime*.44+i*Math.PI)*13;e.y=-2.4+Math.sin(s.phaseTime*.8+i)*1.1;for(const p of s.players)if(Math.hypot(p.x-e.x,p.y-e.y)<1.25&&p.shield<=0){this.damage(1,p.x,p.y);p.shield=1.8;}}\n s.remaining-=dt;if(s.rescued>=s.goal){this.advance();return;}if(s.remaining<=0){this.damage(2);if(s.phase==='\"'gameover')return;s.remaining=this.config.rescueTime*.5;this.announce('SOLAR FLARE\"'! · FINISH THE RESCUE'\"');}return;}\n s.remaining-=dt;this.spawnClock-=dt;if(this.spawnClock<=0){this.spawnMeteor();this.spawnClock=(.95-s.world*.12-(s.finalDefense?.2:0))/this.config.threatRate;}\n this.accum+=dt;while(this.accum>=1/60){this.physics.timestep=1/60;this.physics.step(this.queue);this.accum-=1/60;const collisions=[];this.queue.drainCollisionEvents((h1,h2,started)=>{if(started)collisions.push([this.handles.get(h1),this.handles.get(h2)]);});for(const [a,b]of collisions){if(\"'!a||!b)continue;const meteor=a.kind==='\"'meteor'?a:b.kind==='meteor'?b:null;const other=meteor===a?b:a;if(\"'!meteor)continue;const m=s.meteors.find(m=>m.id===meteor.id);if(!m)continue;if(other.kind==='\"'shot'){const shot=s.shots.find(v=>v.id===other.id);if(\"'!shot)continue;this.effect(m.x,m.y,'\"'boom');this.remove(m,s.meteors);this.remove(shot,s.shots);s.combo++;s.kills++;s.score+=100+Math.min(s.combo,10)*10;this.audio?.event('boom');}else if(other.kind==='ark'){this.effect(m.x,m.y,'boom');this.remove(m,s.meteors);this.damage(1,m.x,m.y);}}}\n for(const m of [...s.meteors,...s.shots]){const b=this.bodies.get(m.id);if(b){const pos=b.translation();m.x=pos.x;m.y=pos.y;}}for(const shot of [...s.shots]){shot.life-=dt;if(shot.life<=0)this.remove(shot,s.shots);}for(const m of [...s.meteors])if(Math.hypot(m.x,m.y)>35)this.remove(m,s.meteors);if(s.remaining<=0&&s.phase==='defense')this.advance();}\n snapshot(){return JSON.parse(JSON.stringify(this.state));}\n dispose(){this.queue?.free();this.physics?.free();}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > index.template.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\">\n<!--HUB_CLIENT-->\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#081a25\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:session-goal\" content=\"Save twelve strange creatures across three worlds, then survive the final meteor storm. Shared hull, shared victory.\"><meta name=\"hub:session-howto\" content=\"Left stick / WASD: aim or fly. R2 / Space: shoot or tractor beam. Cross / Shift: shield pulse or boost. Options / Esc: pause.\"><meta name=\"hub:session-minutes\" content=\"5\"><meta name=\"hub:webgpu\" content=\"required\">\n<title>The Great Space Escape</title>\n<style>\n:root{--ink:#081a25;--paper:#f5efd9;--mint:#9cf0cd;--orange:#ffa56d;--dim:#9cafaf;--panel:rgba(8,26,37,.94);font-family:Arial,Helvetica,sans-serif;color:var(--paper);background:var(--ink);font-synthesis:none;color-scheme:dark}*{box-sizing:border-box}body{margin:0;overflow:hidden}button,input{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible{outline:3px solid var(--orange);outline-offset:5px}button{color:var(--paper);border:1px solid #48626b;background:#18333e;border-radius:5px;padding:15px 22px;font-weight:750;font-size:19px;text-align:left;transition:background .12s,transform .12s}button:hover,button:focus{background:#2a4b54}button.primary{background:var(--mint);border-color:var(--mint);color:var(--ink)}button.primary:hover,button.primary:focus{background:#c6ffe6}button.small{font-size:15px;padding:10px 15px}.label{font-size:12px;letter-spacing:2.5px;font-weight:800;text-transform:uppercase;color:var(--mint)}canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none}#vignette{pointer-events:none;position:fixed;inset:0;background:radial-gradient(ellipse at center,transparent 40%,rgba(2,12,23,.43) 100%)}#ui{position:fixed;inset:0;pointer-events:none}#ui button,#ui input,#menu{pointer-events:auto}[hidden]{display:none!important}#title{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,26,37,.99),rgba(8,26,37,.85) 33%,rgba(8,26,37,.08) 66%);padding:5.6vh 5.2vw;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.brandline{position:absolute;top:5.5vh;left:5.2vw;display:flex;gap:14px;align-items:center;font-size:12px;font-weight:800;letter-spacing:2px;color:var(--mint)}.mark{width:29px;height:29px;border:2px solid var(--mint);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:20px}#title h1{font-size:clamp(52px,6.8vw,116px);font-weight:950;letter-spacing:-.065em;line-height:.89;margin:45px 0 24px;max-width:700px}#title h1 span{display:block;color:var(--orange)}#title .tagline{font-family:Georgia,serif;font-size:clamp(20px,2vw,30px);font-style:italic;margin:0 0 28px;color:#d7e6df}.titleActions{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:min(440px,44vw)}.titleActions .primary{grid-column:1/-1;display:flex;justify-content:space-between;font-size:21px}.titleActions .small{padding:12px;font-size:15px}.titleFoot{position:absolute;left:5.2vw;bottom:4.8vh;font-size:12px;color:#9cb3b6;letter-spacing:1.5px}.sceneTag{position:absolute;right:5vw;bottom:10vh;text-align:right}.sceneTag b{display:block;font-size:16px;margin:9px 0}.sceneTag p{font-size:13px;color:#bed7cf;margin:6px 0}.rule{width:70px;height:3px;background:var(--orange);margin-left:auto}#loading{position:absolute;inset:0;background:#081a25;display:grid;place-content:center;text-align:center;z-index:20}#loading h2{font-size:36px;letter-spacing:-1px;margin:20px}#loading p{color:var(--dim);font-size:16px}.loader{width:80px;height:80px;border:2px solid #35545d;border-top:4px solid var(--mint);border-radius:50%;margin:auto;animation:spin 1.2s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#hud{position:absolute;inset:0;padding:28px 36px}.topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.mission{background:#081a25d9;border-left:4px solid var(--mint);padding:14px 20px;min-width:270px}.mission h2{margin:7px 0 0;font-size:26px;letter-spacing:-.7px}.mission p{margin:6px 0 0;font-size:14px;color:#b9cdcc}.stats{display:flex;gap:24px;background:#081a25d9;padding:13px 20px;border-bottom:1px solid #587176;align-items:center}.stat .label{font-size:10px;letter-spacing:1.5px;color:#b3c5c4}.stat strong{display:block;margin-top:5px;font-size:27px;font-weight:850;font-variant-numeric:tabular-nums}.hulls{color:var(--orange);letter-spacing:3px;white-space:nowrap}.pauseBtn{font-size:22px;padding:14px 19px;background:#081a25d9}.bottomLeft{position:absolute;bottom:30px;left:36px;max-width:350px}.phaseHelp{background:#081a25e0;border:1px solid #36555e;padding:16px 20px;border-radius:4px}.phaseHelp h3{font-size:17px;margin:0 0 7px}.phaseHelp p{font-size:14px;line-height:1.5;color:#bdd3ce;margin:0}.controlsLine{font-size:13px;margin-top:13px;color:#bacfcd}.key{display:inline-block;min-width:25px;text-align:center;border:1px solid #6a8688;border-radius:3px;padding:3px 6px;color:var(--paper);font-weight:bold;margin-right:5px}.bottomRight{position:absolute;bottom:30px;right:36px;min-width:200px;background:#081a25dc;padding:15px 18px}.chargeTrack{height:5px;background:#304b50;margin:10px 0}.chargeFill{height:100%;background:var(--mint);width:100%}.cargo{font-size:14px;color:#bdd3ce;line-height:1.6}#announce{position:absolute;left:50%;top:23%;transform:translateX(-50%);text-align:center;font-size:17px;letter-spacing:2px;font-weight:850;background:#0b2530e8;padding:13px 22px;border-top:2px solid var(--orange);white-space:nowrap}#warp{position:absolute;inset:0;display:grid;place-content:cente