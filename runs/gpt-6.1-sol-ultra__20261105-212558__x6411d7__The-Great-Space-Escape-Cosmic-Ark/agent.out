{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"ls -1 && cat build.mjs && sed -n '1,90p' hub-tests.py && sed -n '1,60p' browser-tests.py\"","aggregated_output":"app.js\naudio.js\nbridge.js\nbuild.mjs\ncredits.json\ngame.bundle.js\ngame.html\ngame.js\nharness.html\nhub-session.js\nhub-test-results.json\nhub-tests.py\nindex.template.html\nnetwork.js\nnetwork.test.mjs\nnode_modules\norg.chromium.Chromium.HQfuaR\norg.chromium.Chromium.Hz7wcG\norg.chromium.Chromium.hSMYLy\npackage-lock.json\npackage.json\nproject.json\nround.js\nscene-check-headed.py\nscene-check.py\nscene-rescue-reference.png\nscene-rescue.png\nscene-test-bundle.js\nscene-test-entry.js\nscene-test.html\nscene-title-reference.png\nscene-title.png\nscene.js\nscript-extract-0.js\nscript-extract-1.js\nsimulation-tests.mjs\nui-visual-check.py\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {spawnSync} from 'node:child_process';\nconst {slug}=JSON.parse(readFileSync('project.json','utf8'));\nconst out=spawnSync('bun',['build','app.js','--target','browser','--minify','--outfile','game.bundle.js'],{encoding:'utf8'});\nif(out.status!==0){console.error(out.stderr);process.exit(1);}\nlet html=readFileSync('index.template.html','utf8');\nconst client=readFileSync('hub-session.js','utf8');\nhtml=html.replace('<!--HUB_CLIENT-->',()=>'<script>'+ client.replace(/<\\/script/gi,'<\\\\/script')+'</script>');\nhtml=html.replace('/*GAME_BUNDLE*/',()=>readFileSync('game.bundle.js','utf8').replace(/<\\/script/gi,'<\\\\/script'));\nwriteFileSync('../'+slug+'.html',html);\nwriteFileSync('game.html',html);\nconsole.log('Built '+slug+'.html');\n\"\"\"Actual AI Hub conformance checks; starts and closes only its own server/browser.\nRun with /home/micha/.local/share/pipx/venvs/playwright/bin/python hub-tests.py\n\"\"\"\nimport argparse\nimport json\nimport re\nimport subprocess\nimport sys\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent\nSCENARIOS = [\n    (\"two-player\", {\"players\": 2}),\n    (\"four-player-loss\", {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5}),\n    (\"host-leave\", {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5, \"scenario\": \"host-leave\"}),\n    (\"server-host\", {\"players\": 2, \"scenario\": \"server\"}),\n]\n\n\ndef run_hub_tests(only=None):\n    reports = []\n    failures = []\n    checks = 0\n    server = subprocess.Popen(\n        [sys.executable, \"-u\", \"-m\", \"http.server\", \"0\", \"--bind\", \"127.0.0.1\"],\n        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,\n    )\n    try:\n        line = server.stdout.readline()\n        match = re.search(r\"port (\\d+)\", line)\n        if not match:\n            raise RuntimeError(\"Own HTTP server did not report its ephemeral port\")\n        origin = f\"http://127.0.0.1:{match.group(1)}\"\n        with urllib.request.urlopen(origin + \"/game.html\") as response:\n            source = response.read().decode()\n        checks += 1\n        if \"<title>The Great Space Escape</title>\" not in source:\n            raise RuntimeError(\"Server is not this game's page\")\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True, args=[\n                \"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\",\n                \"--use-webgpu-adapter=swiftshader\", \"--disable-dev-shm-usage\",\n            ])\n            try:\n                context = browser.new_context(viewport={\"width\": 1920, \"height\": 1080})\n                page = context.new_page()\n                runtime_messages = []\n                page.on(\"pageerror\", lambda error: runtime_messages.append({\"type\": \"error\", \"text\": str(error)}))\n                page.on(\"console\", lambda msg: runtime_messages.append({\"type\": msg.type, \"text\": msg.text[:800]}) if msg.type in (\"error\", \"warning\") else None)\n                page.on(\"requestfailed\", lambda request: runtime_messages.append({\"type\": \"requestfailed\", \"url\": request.url, \"failure\": request.failure}))\n                for name, parameters in SCENARIOS:\n                    if only and name not in only:\n                        continue\n                    runtime_messages.clear()\n                    params = {\"game\": \"game.html\", \"auto\": 1, \"play\": 6000, \"seed\": 843627, **parameters}\n                    page.goto(origin + \"/harness.html?\" + urllib.parse.urlencode(params), wait_until=\"domcontentloaded\", timeout=60000)\n                    try:\n                        page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=150000)\n                        report = page.evaluate(\"window.__hubCheck\")\n                    except Exception as error:\n                        report = {\"pass\": False, \"checks\": [{\"name\": \"harness completed\", \"pass\": False, \"detail\": str(error)}]}\n                        report[\"frames\"] = []\n                        for frame in page.frames[1:]:\n                            try:\n                                report[\"frames\"].append(frame.evaluate(\"({url:location.href,ready:!!window.__gameReady,error:window.__gameError,loading:document.getElementById('loading')?.innerText,net:window.__game?.net?.diagnostics()})\"))\n                            except Exception as frame_error:\n                                report[\"frames\"].append({\"error\": str(frame_error)})\n                    report[\"runtimeMessages\"] = runtime_messages.copy()\n                    report[\"frameDiagnostics\"] = []\n                    for frame in page.frames[1:]:\n                        try:\n                            report[\"frameDiagnostics\"].append(frame.evaluate(\"({url:location.href,title:document.title,ready:!!window.__gameReady,error:window.__gameError,loading:document.getElementById('loading')?.innerText,net:window.__game?.net?.diagnostics()})\"))\n                        except Exception as frame_error:\n                            report[\"frameDiagnostics\"].append({\"error\": str(frame_error)})\n                    report[\"scenarioName\"] = name\n                    reports.append(report)\n                    for check in report.get(\"checks\", []):\n                        checks += 1\n                        if not check.get(\"pass\"):\n                            failures.append(f\"{name}: {check.get('name')}: {check.get('detail', '')}\")\n                context.close()\n            finally:\n                browser.close()\n    except Exception as error:\n        checks += 1\n        failures.append(f\"harness runner: {error}\")\nsed: can't read browser-tests.py: No such file or directory\n","exit_code":2,"status":"failed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='game.js';s=open(p).read().replace('for(const p of s.players){const u=inputs[p.id]||{};',\\\"for(const p of s.players){if(p.active===false){p.beam=false;continue;}const u=inputs[p.id]||{};\\\")\ns=s.replace(\\\"for(const p of s.players)if(Math.hypot(p.x-e.x,p.y-e.y)<1.25\\\", \\\"for(const p of s.players)if(p.active\"'!==false&&Math.hypot(p.x-e.x,p.y-e.y)<1.25\")\nopen(p,'\"'w').write(s)\np='app.js';s=open(p).read().replace(\\\"if(p)p.active=false;\\\", \\\"if(p){p.active=false;p.beam=false;for(const c of game.state.critters)if(p.cargo.includes(c.id)){c.status='ground';c.owner=null;c.lift=0;}p.cargo=[];}\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='game.js';s=open(p).read().replace('for(const p of s.players){const u=inputs[p.id]||{};',\\\"for(const p of s.players){if(p.active===false){p.beam=false;continue;}const u=inputs[p.id]||{};\\\")\ns=s.replace(\\\"for(const p of s.players)if(Math.hypot(p.x-e.x,p.y-e.y)<1.25\\\", \\\"for(const p of s.players)if(p.active\"'!==false&&Math.hypot(p.x-e.x,p.y-e.y)<1.25\")\nopen(p,'\"'w').write(s)\np='app.js';s=open(p).read().replace(\\\"if(p)p.active=false;\\\", \\\"if(p){p.active=false;p.beam=false;for(const c of game.state.critters)if(p.cargo.includes(c.id)){c.status='ground';c.owner=null;c.lift=0;}p.cargo=[];}\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"Built The-Great-Space-Escape-Cosmic-Ark-gpt-6.1-sol-ultra-20261105-212558.html\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '90,150p' hub-tests.py && sed -n '220,250p' audio.js && tail -n 25 network.test.mjs && rg -n 'active|delivered|beamLine|Dock|dock|dispose' scene.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '90,150p' hub-tests.py && sed -n '220,250p' audio.js && tail -n 25 network.test.mjs && rg -n 'active|delivered|beamLine|Dock|dock|dispose' scene.js\"","aggregated_output":"        failures.append(f\"harness runner: {error}\")\n    finally:\n        server.terminate()\n        try:\n            server.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            server.kill()\n            server.wait(timeout=5)\n        server.stdout.close()\n    result = {\"count\": checks, \"failures\": failures, \"reports\": reports}\n    (ROOT / \"hub-test-results.json\").write_text(json.dumps(result, indent=2))\n    return result\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--scenario\", action=\"append\", choices=[name for name, _ in SCENARIOS])\n    args = parser.parse_args()\n    result = run_hub_tests(args.scenario)\n    for failure in result[\"failures\"]:\n        print(\"FAIL hub: \" + failure)\n    print(f\"{result['count'] - len(result['failures'])}/{result['count']} AI Hub checks passed\")\n    sys.exit(bool(result[\"failures\"]))\n    event(name) {\n      if (!synth || synth.context.state !== 'running' || muted) return;\n      const now = synth.context.currentTime;\n      const delay = name === 'shot' ? 0.045 : name === 'beam' ? 0.14 : name === 'voice' ? 0.8 : name === 'boom' ? 0.07 : 0.02;\n      if (now < (cooldown[name] || 0)) return;\n      cooldown[name] = now + delay;\n      eventCount++;\n      synth.event(name);\n    },\n    update(state, dt) {\n      if (!synth || synth.context.state !== 'running') return;\n      const phase = state.phase || 'title';\n      const active = phase === 'defense' || phase === 'rescue';\n      const now = synth.context.currentTime;\n      if (nextStep < now - 0.5) nextStep = now + 0.03;\n      while (nextStep < now + 0.22) {\n        synth.musicStep(step++, nextStep, phase === 'defense' ? 1 : 0);\n        nextStep += active ? 0.225 : 0.27;\n      }\n      if (phase !== lastPhase) { lastPhase = phase; beamTimer = 0; }\n      if (phase === 'rescue' && state.players?.some(player => player.beam)) {\n        beamTimer -= Math.max(0, dt || 0);\n        if (beamTimer <= 0) { this.event('beam'); beamTimer = 0.35; }\n      }\n      synth.analyser.getFloatTimeDomainData(signal);\n      peak = signal.reduce((maximum, sample) => Math.max(maximum, Math.abs(sample)), 0);\n    },\n    diagnostics() {\n      return { unlocked: !!synth, state: synth?.context.state || 'locked', music: musicLevel, sfx: sfxLevel, muted, peak, eventCount, activeNodes: synth?.activeNodes.size || 0, defaultMusic: DEFAULT_MUSIC };\n    },\n    dispose() {\n    hub.emit('leave', { id: 1, reason: 'left' });\n    host.finish(1200, true); host.finish(1200, true); host.tick(1);\n    assert(calls.finishes.length === 1 && calls.finishes[0].standings.flat().join() === '0' && calls.finishes[0].won, 'finish once with remaining team');\n    host.dispose();\n\n    ({ hub, calls } = fake(true));\n    const timeout = await createNetwork();\n    hub.emit('time-up', { graceMs: 1000 });\n    assert(calls.finishes.length === 1 && !calls.finishes[0].won, 'default host time-up result');\n    timeout.dispose();\n    globalThis.AIHub = { connect: async () => null };\n    const local = await createNetwork();\n    assert(!local.active && local.isHost && local.me === 0, 'standalone runs host simulation without network');\n    local.dispose();\n  } catch (error) { failures.push(String(error.stack || error)); }\n  finally { globalThis.AIHub = previous; }\n  return { count, failures };\n}\n\nif (process.argv[1] && pathToFileURL(process.argv[1]).href === import.meta.url) {\n  const result = await runNetworkTests();\n  for (const failure of result.failures) console.error(`FAIL network: ${failure}`);\n  console.log(`${result.count - result.failures.length}/${result.count} network checks passed`);\n  process.exitCode = result.failures.length ? 1 : 0;\n}\n187:  const dock=new THREE.Group();dock.position.set(0,4.85,1.7);rescueGuide.add(dock);\n188:  const dockRing=ring(dock,0x9ae4bd,[0,.2,0],[2.8,.42,1]);\n189:  for(const side of [-1,1]){line(dock,[[side*2.9,.8,0],[side*2.9,-.4,0],[side*2.25,-.4,0]],0xa6e8c4,.82);line(dock,[[side*1.8,-.4,0],[side*1.5,-.08,0],[side*1.2,-.4,0]],0xa6e8c4,.82);}\n190:  tag(dock,'DOCK HERE',[0,-.58,.01],[1.5,.3,1]);\n199:    for(const item of list||[]){if(item.active===false||(item.status==='aboard'||item.status==='delivered'))continue;live.add(item.id);let obj=map.get(item.id);if(!obj){obj=factory(item);map.set(item. [... omitted end of long line]\n204:    rescueGuide.visible=phase==='rescue';dockRing.scale.y=.38+Math.sin(t*3)*.035;\n222:    for(const [id,a]of aimMeshes)if(!(state.players||[]).some(p=>p.id===id&&p.active!==false))a.visible=false;\n242:  return {render,resize,renderer,camera,scene,ready:{webgpu:Boolean(renderer.backend?.isWebGPUBackend),three:THREE.REVISION,animation:'AnimationMixer / AnimationClip',get frames(){return frames;}},dis [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"agent_message","text":"All four required AI Hub scenarios passed, including four-player packet loss, host departure, and a host with no player. Browser checks also confirm the bundled file runs from `file://`, with keyboard, simulated controller, touch controls, and generated audio working. I’m finishing visual review and the credits and testing records.\n"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > integrity-tests.mjs <<'EOF'\nimport {readFileSync} from 'node:fs';\nimport {createHash} from 'node:crypto';\nimport {spawnSync} from 'node:child_process';\nconst {slug}=JSON.parse(readFileSync('project.json','utf8'));\nlet count=0;const failures=[];const test=(value,name)=>{count++;if(\"'!value)failures.push(name);};\nconst html=readFileSync('\"'../'+slug+'.html','utf8'),local=readFileSync('game.html','utf8');\nconst scripts=[...html.matchAll(/<script(?:[\"'^>]*)>(['\"\\\\s\\\\S]*?)<\\\\/script>/g)].map(m=>m[1]);\ntest(html===local,'root and tested build match');\ntest(scripts.length===2,'exactly hub client and self-contained game scripts');\ntest(scripts[0]===readFileSync('hub-session.js','utf8'),'unmodified first-script AI Hub client');\ntest(scripts[1]===readFileSync('game.bundle.js','utf8').replace(/<\\\\/script/gi,'<\\\\\\\\/script'),'bundle content is preserved literally, including dollar signs');\ntest(\"'!scripts[1].includes('\"'/*GAME_BUNDLE*/'),'no unreplaced bundle markers');\ntest(\"'!/<script[''^>]+src=|<link[''^>]+href=/i.test(html),'\"'no external script or stylesheet dependencies');\ntest(html.includes('hub:session-mode\\\" content=\\\"shared-world'),'shared-world metadata present');\ntest(html.includes('hub:session-players\\\" content=\\\"1-4'),'1–4 session metadata present');\nfor(const file of ['app.js','game.js','scene.js','audio.js','network.js']){const p=spawnSync('node',['--check',file],{encoding:'utf8'});test(p.status===0,file+' syntax: '+p.stderr);}\nlet exit;try{exit=JSON.parse(readFileSync('../exit-interview.json','utf8'));}catch{}\ntest(\"'!!exit,'\"'exit-interview is valid JSON');\nif(exit){test(JSON.stringify(exit.sourceInformation)===JSON.stringify(JSON.parse(readFileSync('credits.json','utf8')).sourceInformation),'in-game and exit-interview source records match');test(exit.testingFeedback.length===4&&exit.engineFeedback.length===6&&exit.promptFeedback.length===4,'all feedback questions answered');test(exit.aiHub.name==='The Great Space Escape'&&exit.aiHub.tags.length>=3,'catalogue metadata complete');}\nfor(const failure of failures)console.error('FAIL integrity: '+failure);\nconsole.log(\"'`${count-failures.length}/${count} integrity checks passed`);process.exitCode=failures.length?1:0;\nEOF\ncat > test.py <<'\"'EOF'\n\\\"\\\"\\\"One command: python3 test.py. Prints only failures and one total count.\\\"\\\"\\\"\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent\nPLAYWRIGHT_PYTHON = Path('/home/micha/.local/share/pipx/venvs/playwright/bin/python')\nCOMMANDS = [\n    ['node', 'integrity-tests.mjs'],\n    ['node', 'simulation-tests.mjs'],\n    ['node', 'network.test.mjs'],\n    [str(PLAYWRIGHT_PYTHON), 'browser-tests.py'],\n    [str(PLAYWRIGHT_PYTHON), 'hub-tests.py'],\n]\ntotal = 0\nfailed_suites = 0\nfor command in COMMANDS:\n    result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)\n    output = result.stdout + result.stderr\n    ratios = re.findall(r'(\\\\d+)/(\\\\d+) .*checks passed', output)\n    simulation = re.findall(r'(\\\\d+) simulation checks:', output)\n    if ratios:\n        total += int(ratios[-1][1])\n    elif simulation:\n        total += int(simulation[-1])\n    if result.returncode:\n        failed_suites += 1\n        lines = [line for line in output.splitlines() if line.startswith('FAIL')]\n        print('\\\\n'.join(lines) if lines else 'FAIL ' + command[-1] + ': ' + output.strip())\nprint(f'{total} checks; {failed_suites} failing suites.')\nsys.exit(bool(failed_suites))\nEOF\npython3 - <<'PY'\nimport json\np='package.json';d=json.load(open(p));d['description']='An original cel-ink arcade rescue game inspired by Cosmic Ark (1982).';d.pop('main',None);d['scripts']={'build':'node build.mjs','test':'python3 test.py'};d['dependencies']={'@dimforge/rapier3d-compat':'0.19.3','three':'0.180.0'};open(p,'w').write(json.dumps(d,indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
