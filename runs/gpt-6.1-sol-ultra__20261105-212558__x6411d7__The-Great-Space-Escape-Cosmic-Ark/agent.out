{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"tail -n 40 browser-tests.py && head -n 25 simulation-tests.mjs && cat hub-test-results.json | head -n 12 && rg -n 'mark|type|CREATURE' scene.js\"","aggregated_output":"            require(state(page)[\"phase\"] == \"defense\", \"game could not launch after leaving attract\")\n        check(\"10-second idle attract, any-input exit and balance restoration\", attract_mode)\n\n        check(\"desktop runtime has no uncaught errors\", lambda: require(not errors, \"; \".join(errors)))\n\n    context.close()\n\n    if boot_ok:\n        phone_context = browser.new_context(**playwright.devices[\"iPhone 13\"])\n        phone = phone_context.new_page()\n        phone.on(\"pageerror\", lambda error: errors.append(f\"touch: {error}\"))\n        phone.goto(target.as_uri(), wait_until=\"load\")\n\n        def touch_play():\n            ready(phone)\n            require(phone.evaluate(\"__game.getUI().touchEnabled\"), \"touch profile did not select touch UI\")\n            phone.locator('#title [data-action=\"start\"]').tap()\n            phone.evaluate(\"__game.setPhase('rescue'); __game.game.state.enemies=[]\")\n            before = state(phone)[\"players\"][0]\n            session = phone_context.new_cdp_session(phone)\n            session.send(\"Input.dispatchTouchEvent\", {\"type\":\"touchStart\", \"touchPoints\":[{\"x\":70,\"y\":650,\"id\":1}]})\n            session.send(\"Input.dispatchTouchEvent\", {\"type\":\"touchMove\", \"touchPoints\":[{\"x\":125,\"y\":650,\"id\":1}]})\n            phone.wait_for_timeout(220)\n            after = state(phone)[\"players\"][0]\n            require(after[\"x\"] > before[\"x\"] + .3, \"invisible left stick did not move shuttle\")\n            require(after[\"beam\"], \"touch hold did not assist the tractor beam\")\n            session.send(\"Input.dispatchTouchEvent\", {\"type\":\"touchEnd\", \"touchPoints\":[]})\n            phone.wait_for_timeout(90)\n            require(not state(phone)[\"players\"][0][\"beam\"], \"tractor beam did not release with touch\")\n            require(phone.locator(\".bottomLeft\").is_hidden() and phone.locator(\".bottomRight\").is_hidden(), \"touch did not remove dense control panels\")\n            phone.locator('#hud [data-action=\"pause\"]').tap()\n            require(ui(phone)[\"menu\"] == \"pause\", \"touch menu button did not pause\")\n        check(\"phone touch stick, beam assist, sparse HUD and pause\", touch_play)\n        check(\"touch runtime has no uncaught errors\", lambda: require(not errors, \"; \".join(errors)))\n        phone_context.close()\n\n    browser.close()\n\nprint(f\"{passed + failed} browser checks: {passed} passed, {failed} failed\")\nsys.exit(1 if failed else 0)\nimport assert from 'node:assert/strict';\nimport { Game, DEFAULTS, initPhysics } from './game.js';\n\nlet passed = 0;\nlet failed = 0;\nconst originalWarn = console.warn;\nconsole.warn = (...args) => {\n  if (!String(args[0]).includes('deprecated parameters for the initialization function')) originalWarn(...args);\n};\nawait initPhysics();\nconsole.warn = originalWarn;\n\nfunction run(name, test) {\n  const game = new Game();\n  try { test(game); passed++; }\n  catch (error) { failed++; console.error(`FAIL ${name}: ${error.message}`); }\n  finally { game.dispose(); }\n}\nconst tick = (game, seconds, inputs = {}) => {\n  for (let i = 0; i < Math.ceil(seconds * 60); i++) game.update(1 / 60, inputs);\n};\nconst isolated = game => {\n  game.start();\n  game.spawnClock = 100000;\n  game.state.remaining = 100000;\n{\n  \"count\": 54,\n  \"failures\": [],\n  \"reports\": [\n    {\n      \"done\": true,\n      \"pass\": true,\n      \"game\": \"game.html\",\n      \"players\": 2,\n      \"scenario\": \"standard\",\n      \"checks\": [\n        {\n88:function creature(type=0){\n90:  const colors=[0xaceac1,0xffc077,0xc7abec,0x94e1eb];const col=colors[type%4];\n91:  if(type%3===0){\n99:  }else if(type%3===1){\n117:  if(type%3!==2){\n125:  if(type%3===1){tracks.push(new THREE.NumberKeyframeTrack('wing.rotation[z]',[0,.2,.4],[-.4,.3,-.4]),new THREE.NumberKeyframeTrack('wing2.rotation[z]',[0,.2,.4],[.4,-.3,.4]));}\n214:    sync('players',title?[]:state.players||[],item=>saucer(typeof item.color==='number'?item.color:parseInt((item.color||'#a5e8c7').replace('#',''),16)),(obj,item)=>{\n228:    sync('critters',state.critters,item=>creature(item.type||0),(obj,item)=>{let y=item.y;const lifting=(item.lift||0)>0&&item.status==='ground';if(lifting){const p=(state.players||[]).find(p=>p.beam& [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
