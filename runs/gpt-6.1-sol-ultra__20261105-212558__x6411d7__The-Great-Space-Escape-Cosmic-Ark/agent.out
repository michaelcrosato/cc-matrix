-weight:850}.endFacts{display:flex;gap:30px;color:var(--mint);font-size:17px}.pill{color:var(--orange);font-size:12px;letter-spacing:1px;border:1px solid #8c6853;padding:8px 12px;display:inline-block}#touchHint{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);font-size:11px;color:#b4d5cc;background:#081a25ad;padding:8px 12px;white-space:nowrap}#touchRing{position:absolute;border:2px solid #9cf0cd88;background:#9cf0cd12;border-radius:50%;width:100px;height:100px;pointer-events:none;display:none}.error{color:var(--orange)!important}body.touch #hud{padding:16px}body.touch .bottomLeft,body.touch .bottomRight{display:none}body.touch .mission{min-width:0;padding:10px}body.touch .mission h2{font-size:17px}body.touch .mission p{font-size:11px}body.touch .stats{padding:10px;gap:12px}body.touch .stat strong{font-size:20px}body.touch .hulls{letter-spacing:0}body.touch #announce{font-size:12px;top:25%;max-width:90vw;white-space:normal}body.touch #title{padding:20px 7vw}body.touch .titleFoot{bottom:20px;font-size:9px}body.touch .titleActions{width:43vw}body.touch #title h1{font-size:clamp(38px,8vw,80px);margin:30px 0 15px}body.touch .brandline{top:20px;font-size:9px}body.touch .tagline{font-size:18px!important;margin-bottom:18px!important}body.touch .sceneTag{right:5vw;bottom:15vh}body.touch .sceneTag p{display:none}body.touch .titleActions button{font-size:14px;padding:10px}body.touch .titleActions .primary{font-size:16px}body.touch .panel{padding:20px 24px}.touch .panel h2{font-size:30px}.touch .setting{font-size:15px;padding:10px 0}.touch .panel p{font-size:14px}@media(max-width:650px) and (orientation:portrait){#title{justify-content:flex-start;padding-top:15vh!important;background:linear-gradient(180deg,#081a25f5 0%,#081a25d0 35%,#081a2510 75%)}#title h1{font-size:16vw!important}.titleActions{width:86vw!important;max-width:380px}.sceneTag{display:none}.brandline{left:7vw}.stats{gap:10px}.stat strong{font-size:18px}.mission{min-width:0;max-width:190px}.mission h2{font-size:16px}.mission p{font-size:11px}.stat .label{font-size:8px}.howgrid,.aboutgrid{grid-template-columns:1fr}.setting{grid-template-columns:1fr 130px}.panel{max-height:92vh}.topbar{gap:8px}#hud{padding:15px}#announce{max-width:90vw;white-space:normal;font-size:13px}.bottomLeft{left:15px;bottom:20px;max-width:240px}.bottomRight{right:15px;bottom:20px;min-width:130px}.phaseHelp{padding:10px}.phaseHelp p{font-size:11px}.controlsLine{font-size:10px}.cargo{font-size:11px}}\n</style></head><body><canvas id=\"game\" aria-label=\"The Great Space Escape game world\"></canvas><div id=\"vignette\"></div><div id=\"ui\">\n<div id=\"loading\"><div class=\"loader\"></div><h2>Preparing the lifeboat.</h2><p id=\"loadingText\">WebGPU · hand-built worlds · twelve very odd passengers</p></div>\n<section id=\"title\" hidden><div class=\"brandline\"><span class=\"mark\">✳</span> NOVA CONSERVATION CORPS <span style=\"color:#7d969d\">/ FLIGHT 082</span></div><h1>THE GREAT<br>SPACE<span>ESCAPE.</span></h1><p class=\"tagline\">Small ship. Strange cargo. Last chance.</p><div class=\"titleActions\"><button class=\"primary\" data-action=\"start\">Launch rescue <span>↗</span></button><button class=\"small\" data-action=\"coop\">Two-pilot co-op</button><button class=\"small\" data-action=\"how\">Flight manual</button><button class=\"small\" data-action=\"settings\">Settings</button><button class=\"small\" data-action=\"about\">About / credits</button></div><div class=\"titleFoot\">INSPIRED BY COSMIC ARK, 1982 &nbsp; · &nbsp; A SMALL ACT OF COSMIC KINDNESS</div><div class=\"sceneTag\"><div class=\"rule\"></div><span class=\"label\">Destination 01 / 03</span><b>THE MOSS MOON</b><p>They have no idea the sun is going out.</p><p>Fortunately, you brought a tractor beam.</p></div></section>\n<section id=\"hud\" hidden><div class=\"topbar\"><div class=\"mission\"><span class=\"label\" id=\"worldLabel\"></span><h2 id=\"phaseTitle\"></h2><p id=\"missionLine\"></p></div><div class=\"stats\"><div class=\"stat\"><span class=\"label\">Ark hull</span><strong class=\"hulls\" id=\"hullValue\"></strong></div><div class=\"stat\"><span class=\"label\" id=\"timerLabel\">Next jump</span><strong id=\"timerValue\"></strong></div><div class=\"stat\"><span class=\"label\">Score</span><strong id=\"scoreValue\"></strong></div></div><button class=\"pauseBtn\" data-action=\"pause\" aria-label=\"Pause\">Ⅱ</button></div><div class=\"bottomLeft\"><div class=\"phaseHelp\"><h3 id=\"helpTitle\"></h3><p id=\"helpText\"></p></div><div class=\"controlsLine\" id=\"controlsLine\"></div></div><div class=\"bottomRight\"><span class=\"label\" id=\"chargeLabel\">Shield pulse · 100%</span><div class=\"chargeTrack\"><div class=\"chargeFill\" id=\"chargeFill\"></div></div><div class=\"cargo\" id=\"cargoValue\"></div></div></section>\n<div id=\"announce\" hidden></div><div id=\"warp\" hidden><span class=\"label\">EVERY LITTLE LIFE COUNTS</span><h2 id=\"warpTitle\"></h2><p id=\"warpText\"></p></div><div id=\"attract\" hidden><b>AUTOPILOT / DEMONSTRATION</b><p>Press any button to take command</p></div><div id=\"menu\" hidden></div><div id=\"touchHint\" hidden>Drag left to fly · hold right to rescue · double-tap to boost</div><div id=\"touchRing\"></div></div>\n<script type=\"module\">/*GAME_BUNDLE*/</script></body></html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
