nfirm')) this.hold += dt; else this.hold = 0;\n    if (this.hold > .7) { this.finish(); return; }\n    if (I.pressed('confirm') || I.clicked() || I.pressed('fire')) { if (!full) this.chars = 999; else { this.pi++; this.hold = 0; if (this.pi >= this.pages.length) this.finish(); } I.consumeAll(); }\n  },\n  finish() { I_(); if (kind === 'brief') { if (Run.mode === 'range') { Run.newSim(0, 'T-1', { mode: 'range', lives: 99 }); game.go('play'); } else { const sim = Run.sim && Run.mode !== 'arcade' ? null : Run.sim; const d = this.d; Run.newSim(d.stage || Run.stage); Run.stage = d.stage || Run.stage; const st = reg('stage', Run.stage); if (st.intro && !Run.hub) game.go('cutscene', { id: st.intro, scene: st.scenes[0], then: 'play' }); else game.go('play'); } } else { if (this.d.then === 'play') game.go('play'); else if (this.d.then === 'ending') game.go('ending'); else if (this.d.then === 'next') nextAfterResults(); else game.go('menu'); } },\n  draw(r) { r.overlay(g => { const W = r.W, H = r.H, pg = this.pages[Math.min(this.pi, this.pages.length - 1)], who = reg('speaker', pg[0]);\n    if (kind === 'cut') { const sc = reg('scene', this.sc), sim = backdropSim(); const a = this.t * .1; if (sc) { const fake = { scene: sc, rail: 0, phase: 'action', pose: () => ({}), players: sim.players, objs: [], enemies: [], proj: [], boss: null, coverBox: () => ({ x0: 0, x1: 0, y0: 0, y1: 0, z0: 0, z1: 0 }), t: this.t, timeMax: 1, timer: 1 }; drawWorld(g, fake, 0, W, H, this.t, { pose: { x: -100 + this.t * 8, y: Math.sin(a) * 30, z: 28, yaw: Math.sin(a * .7) * .3, pitch: .03, fov: 50 } }); }\n      px.rect(g, 0, 0, W, 18, '#000000'); px.rect(g, 0, H - 18, W, 18, '#000000'); }\n    else { drawBackdrop(g, W, H, game.time, .62); T(g, this.title, W / 2, 10, '#ffffff', { scale: 2, align: 'center' }); if (this.obj) { E.ui.box(g, W - 150, 36, 140, 74, { bg: ['#10244a', '#081428'], border: '#3aa0e8' }); T(g, 'OBJECTIVES', W - 80, 42, '#ffd36a', { scale: 1, align: 'center' }); this.obj.forEach((o,