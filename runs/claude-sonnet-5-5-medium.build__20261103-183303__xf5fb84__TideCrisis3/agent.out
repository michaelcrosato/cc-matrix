n  vm.runInContext(readFileSync(join(root, 'build/game.js'), 'utf8'), ctx, { filename: 'game.js' });\n  const E = ctx.My3D2dge, game = E.current; await new Promise(r => setTimeout(r, 60)); game.advance(.1);\n  return { ctx, E, game, dbg: game.debug, I: game.input };\n}\nexport class T {\n  constructor(name) { this.name = name; this.fails = []; this.n = 0; }\n  check(what, ok, detail = '') { this.n++; if (!ok) this.fails.push('FAIL ' + this.name + ' › ' + what + (detail ? ': ' + detail : '')); }\n  near(what, a, b, tol = .01) { this.check(what, Math.abs(a - b) <= tol, a + ' vs ' + b); }\n}\nexport const STEP = 1 / 120;\n// a scripted Sim in a given scene, already in ACTION with players ready\nexport function mkSim(dbg, scene = '1-1', o = {}) { const stage = scene[0] === 'T' ? 0 : +scene[0]; const sim = new dbg.Sim(Object.assign({ scene, stage, players: [{}], seed: 7 }, o)); sim.beginAction(); sim.actionT = 0; return sim; }\nexport function run(sim, secs, cmds = [{}], dt = STEP) { const n = Math.round(secs / dt); for (let i = 0; i < n; i++) sim.step(dt, cmds); }\nexport function aimAtPoint(dbg, sim, pid, pt) { const a = dbg.R3.aimOf(sim.pose(pid), pt); return a ? [a[0], a[1]] : null; }\nexport function expose(sim, e) { e.p = 1; e.st = 'aim'; e.aimT = 99; e.expLeft = 99; e.exposedAt = sim.t; e.foot = e.bz; e.x = e.bx; e.y = e.by; e.t = 99; }\nEOF\nnode tools/build.mjs > /dev/null; echo ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":286,"cache_read_input_tokens":489909,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":286},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4b3a6642-97a9-4fb1-9b03-5d84e1c23511","uuid":"c8f15041-f98d-4dfe-9c22-30fbb9890ffc","timestamp":"2026-11-04