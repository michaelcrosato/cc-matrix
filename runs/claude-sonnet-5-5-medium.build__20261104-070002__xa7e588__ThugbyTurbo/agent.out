on, tackleAttempt, doPass, receivers, foul, scoreTry, useSuper, addHype }; })();';\n  vm.runInContext(src, ctx, { filename: 'game' });\n  return { E: ctx.My3D2dge, TT: ctx.__TT, sim: ctx.__sim, ctx };\n}\nEOF\ncat > test/try1.mjs <<'EOF'\nimport { load } from './lib/load.mjs';\nconst { TT, sim } = load();\nTT.cfg.present = false;\nconst m = sim.newMatch({ home: 'hawks', away: 'mudlarks', venue: 'muddington', seed: 7, mode: 'exh', halfLength: 60, seats: [{ team: 0, kind: 'script', auto: true }], diff: { react: .25, noise: .2 } });\nlet steps = 0;\nconst seatI = [sim.emptyIntent()];\nconst t0 = Date.now();\nwhile (steps < 120 * 130 && !m.over) { sim.stepMatch(1 / 120, seatI); steps++; }\nconsole.log('steps', steps, 'time', Date.now() - t0, 'ms', 'phase', m.phase, 'score', m.score, 'half', m.half, 'clock', m.clock.toFixed(1));\nconsole.log(JSON.stringify(m.counts));\nEOF\nnode test/try1.mjs 2>&1 | head -30"}},"wire_ingest_context":{"toolu_01NZ6G95TySP88iTwfTyXFGi":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-070002__xa7e588/work/ThugbyTurbo-Rugby-claude-sonnet-5-5-medium-20261104-070002"}}}
