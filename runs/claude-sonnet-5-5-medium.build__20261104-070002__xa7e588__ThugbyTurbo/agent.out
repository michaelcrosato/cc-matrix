es in the viewport's size: centred on its focus, inside the bounds, eased)\n  const c = v.cam, t = v.target; if (t) { c.tx = t.x; c.ty = t.y || 0; c.tz = (t.z || 0) + v.z; }\n  const [sx, sy] = game.view.p(c.tx, c.ty, c.tz), bf = c.bounds || game.cam.bounds, b = bf && bf(game.view);\n  let tx = sx - v.w / 2, ty = sy - v.h / 2;\n  if (b) { tx = b.x1 - b.x0 < v.w ? (b.x0 + b.x1 - v.w) / 2 : clamp(tx, b.x0, b.x1 - v.w); ty = b.y1 - b.y0 < v.h ? (b.y0 + b.y1 - v.h) / 2 : clamp(ty, b.y0, b.y1 - v.h); }\n  if (c.snap || c.x === undefined || !(c.smooth > 0)) { c.x = tx; c.y = ty; c.vx = c.vy = 0; c.snap = false; return; }\n  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\n}\n// each step: the other players' inputs, a pause by any of them, a lost controller, and joining\nHOOKS.input.push((game, dt) => {\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\n  for (const q of P.slice(1)) {\n    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\n  }\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n  if (I.pressed('pause')) game.pausedBy = 1;\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === 'gamepad' && was[1] === p.index)) continue;\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\n    if (!on || prev || P.length >= J.max) continue;\n    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\n    game.addPlayer({ pad: p.index });\n  }\n});\nHOOKS.enter.push(game => {   // a scene's start: the others take its keys too (a half each where they share the keyboard); a split ends\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\n});\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\n// a split screen's frame: the scene drawn in each viewport (its own camera, lights and overlays, clipped to it), then\n// the dividers, the scene's hud(r) over the whole screen and the frame's own overlays (notes, pause, fades)\nHOOKS.frame = (game, shx, shy) => {","stderr":"\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-070002__xa7e588/work","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0135VEWwd1gNpoEu2HbFSNUP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
