4, 11, '#3a4a8a');\n    if (r.d) { const v = TUNE.base[r.d.key], k2 = (v - r.d.min) / (r.d.max - r.d.min); E.font.text(g, r.d.label, x0 + 6, y, sel ? '#fff' : '#c0c8e8', { font: 'tiny' }); px.rect(g, x0 + 100, y + 2, 44, 4, '#202030'); px.rect(g, x0 + 100, y + 2, Math.round(44 * k2), 4, v === r.d.value ? '#80c8ff' : '#ffb040'); E.font.text(g, (Math.round(v * 100) / 100) + r.d.unit, x0 + w - 6, y, '#ffe070', { font: 'tiny', align: 'right' }); }\n    else if (r.tog) { E.font.text(g, r.t, x0 + 6, y, sel ? '#fff' : '#c0c8e8', { font: 'tiny' }); E.font.text(g, S.dev[r.tog] ? 'ON' : 'OFF', x0 + w - 6, y, S.dev[r.tog] ? '#80ff80' : '#ff8080', { font: 'tiny', align: 'right' }); }\n    else E.font.text(g, r.t, x0 + 6, y, sel ? '#fff' : r.info ? '#a0e0a0' : '#c0c8e8', { font: 'tiny' }); });\n  if (DEV.msgT > 0) { DEV.msgT -= 1 / 60; E.font.text(g, DEV.msg, x0 + 6, H - 24, '#80ff80', { font: 'tiny' }); }\n  prompt(g, '{l1}{r1} TAB  {sq} RESET ROW  {ci} CLOSE', x0 + 4, H - 14, inp, { font: 'tiny' });\n}\nEOF\ncat > src/11-about.js <<'EOF'\n/* THUGBY TURBO — About & Credits text (Source Information, Testing Feedback, Engine Feedback, Prompt Feedback). */\nTT.about = [\n  ['SOURCE INFORMATION', ['Date: 2026-11-04 07:00:02', 'Source: rugby (over the top arcade style)', 'Plan: PLAN.md (Thugby Turbo, written by claude-opus-5-5 at max effort)', 'Genre and Perspective: arcade sports (rugby sevens) / TV broadcast camera, 40 degree pitch, switchable to 3/4 and top-down', 'Tech: my-3D2dge v0.85.2 (Canvas 2D + Web Audio), AI Hub Session client 1.4.0, plain JavaScript, no other libraries', 'Art Direction: the engine\\'s HD pixel-art skeleton rigs, procedural pitch and stadium, new rugby props and kits', 'Animation: engine E.Humanoid rigs with new E.MOVES (tackle, big hit, pass, kick, fend, spin, sidestep)', 'Audio: all music, effects and Animalese babble voices written in code with the engine\\'s chip synth', 'Online: AI Hub parallel mode (every player plays their own match, hub scoreboard