h = join(dev, '.build/game.bundle.js');\nexecFileSync('esbuild', ['game.js', '--bundle', '--format=esm', '--target=es2022', '--charset=utf8', '--legal-comments=none', `--outfile=${bundlePath}`, '--log-level=warning'], { cwd: dev, stdio: 'inherit' });\nconst bundle = readFileSync(bundlePath, 'utf8').replace(/<\\/script/gi, '<\\\\/script');\nconst session = readFileSync(join(dev, 'session.js'), 'utf8');\n\nconst metas = {\n  'hub:session': '1',\n  'hub:session-players': '1-4',\n  'hub:session-mode': 'shared-world',\n  'hub:session-minutes': '8',\n  'hub:session-goal': 'Fill the Knell, then slay its Warden together',\n  'hub:session-howto': 'Move: stick or WASD. Attack: Cross or click. Skills: face buttons or 1-4.',\n  'hub:webgpu': 'required',\n};\nconst metaHtml = Object.entries(metas).map(([k, v]) => `<meta name=\"${k}\" content=\"${v}\">`).join('\\n');\nconst title = /TITLE = '([^']+)'/.exec(readFileSync(join(dev, 'src/data/meta.js'), 'utf8'))[1];\nconst parts = [\n  '<!doctype html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n<script>',\n  session,\n  `</script>\\n${metaHtml}\\n<title>${title}</title>\\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\\n<link rel=\"icon\" href=\"data:,\">\\n<style>html,body{margin:0;height:100%;background:#0d0b14}#app{position:fixed;inset:0}</style>\\n</head>\\n<body>\\n<div id=\"app\"></div>\\n<script type=\"module\">\\n`,\n  bundle,\n  '\\n</script>\\n</body>\\n</html>\\n',\n];\nwriteFileSync(out, parts.join(''));\nconst dest = join(dev, 'index.html');\nif (!process.argv.includes('--quiet')) console.log(`built ${out} (${(parts.join('').length / 1048576).toFixed(2)} MB)`);\nEOF\ncat > tools/exit-interview.draft.json <<'EOF'\n{\n  \"sourceInformation\": {\"date\": \"2026-11-05 16:20:36\", \"source\": \"Diablo 3\", \"plan\": \"PLAN.md\", \"genre\": \"Co-op action RPG (hack-and-slash)\", \"perspective\": \"Fixed 3/4 isometric, orthographic\