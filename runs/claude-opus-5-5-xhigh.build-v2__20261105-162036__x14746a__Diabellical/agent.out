is: { r: [8, -18, 0] }, Torso: [26, -24, 0], ArmR: [-60, 0, -14], ForearmR: [-6, 0, 0], ArmL: [-30, 0, 20] }, 'outCubic'],\n    [14, READY],\n  ] },\n];\n\nexport const ALL_CLIPS = [...HERO_CLIPS, ...NEW_CLIPS];\nexport const UPPER_JOINTS = new Set(['Torso', 'Head', 'ArmR', 'ForearmR', 'HandR', 'ArmL', 'ForearmL', 'HandL']);\nEOF\ncat > .scratch/clipcheck.mjs <<'EOF'\nimport { validateClip, HERO_RIG, compileClips, buildModel } from '../pixel-engine.js';\nimport { NEW_CLIPS, ALL_CLIPS } from '../src/view/clips.js';\nimport { MODELS } from '../src/view/models/index.js';\nfor (const c of NEW_CLIPS) { const p=validateClip(c,HERO_RIG); if(p.length) console.log(c.name,p.slice(0,3)); }\nfor (const id of ['peatwalker','hero_bellwarden','bursar','ambrose','npc_pyx']) { const b=buildModel(id,{catalog:MODELS}); const clips=compileClips(ALL_CLIPS,HERO_RIG,b.object); console.log(id,clips.length,b.object.children.length); }\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/clipcheck.mjs 2>&1 | tail -n 14 | cut -c1-300","description":"Write new animation clips and validate them","timeout":120000}}}
