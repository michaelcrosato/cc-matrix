{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgki8RZ6HdNhjbAXSJ3W9","type":"message","role":"assistant","content":[{"type":"text","text":"Now audio: 60+ synthesised effects with the bell partials, ten songs built on the Clemency motif, and the Animalese voice system."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":30442,"cache_read_input_tokens":547809,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":30442},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"f85c4408-9492-4069-9d97-fb32bac6b628","timestamp":"2026-11-06T00:15:13.209Z","request_id":"req_011Cgki8R9HnUWuwWKGXXPRq"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgki8RZ6HdNhjbAXSJ3W9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016CQp4L2n4fCLMjCb48pjfG","name":"Bash","input":{"command":"cat > src/data/sfx.js <<'EOF'\n// Every sound in the game, as data. No audio files anywhere.\nconst bell = (base, { vol = 0.34, decay = 1.8, bright = 1, cracked = false, detune = 1.004 } = {}) => {\n  const partial = (ratio, v, d) => ({ wave: 'sine', freq: base * ratio, decay: decay * d, volume: vol * v });\n  const layers = [partial(0.5, 0.6, 1.3), partial(1.2 * detune, 0.42 * bright, 0.8), partial(1.5, 0.3 * bright, 0.7), partial(2, 0.3 * bright, 0.55), partial(2.67, 0.16 * bright, 0.4), partial(3 * detune, 0.12 * bright, 0.3)];\n  if (cracked) layers.push({ wave: 'sine', freq: base * 1.03, decay: decay * 0.9, volume: vol * 0.45 }, { wave: 'sine', freq: base * 1.47, decay: decay * 0.5, volume: vol * 0.3 }, { wave: 'noise', freq: 900, decay: 0.2, volume: vol * 0.3 });\n  layers.push({ wave: 'noise', freq: 4000, decay: 0.03, volume: vol * 0.3 });\n  return { wave: 'sine', freq: base, decay, volume: vol * 0.7, layers };\n};\nconst thud = (freq, vol = 0.5, decay = 0.2, noise = 0.3) => ({ wave: 'sine', freq, freqEnd: freq * 0.35, decay, volume: vol, layers: [{ wave: 'noise', freq: 1600, decay: decay * 0.5, volume: noise }] });\nconst swish = (from, to, dur, vol = 0.22) => ({ wave: 'noise', freq: from, freqEnd: to, decay: dur, volume: vol });\nconst clink = (freq, vol = 0.22, decay = 0.08) => ({ wave: 'square', duty: 0.25, freq, decay, volume: vol });\n\nexport const SFX_DEFS = {\n  // The bell is the game's signature.\n  bell_small: bell(880, { vol: 0.26, decay: 0.9 }),\n  bell_mid: bell(330, { vol: 0.3, decay: 1.4 }),\n  bell_big: bell(147, { vol: 0.42, decay: 2.2 }),\n  bell_loot: bell(659, { vol: 0.34, decay: 2.2, bright: 1.4 }),\n  bell_cracked: bell(98, { vol: 0.42, decay: 2.8, cracked: true }),\n  bell_true: bell(73.4, { vol: 0.48, decay: 3.6, bright: 0.8 }),\n  // Combat.\n  swing_heavy: swish(400, 2200, 0.13, 0.2),\n  chain: { wave: 'noise', freq: 5000, freqEnd: 1800, decay: 0.16, volume: 0.15, layers: [clink(1400, 0.08, 0.06), { ...clink(1760, 0.07, 0.05), delay: 0.05 }, { ...clink(1320, 0.06, 0.05), delay: 0.1 }] },\n  hit_flesh: thud(150, 0.4, 0.09, 0.28),\n  hit_bone: { wave: 'square', duty: 0.125, freq: 620, freqEnd: 240, decay: 0.07, volume: 0.22, layers: [{ wave: 'noise', freq: 5000, decay: 0.04, volume: 0.2 }] },\n  hit_stone: { wave: 'triangle', freq: 220, freqEnd: 90, decay: 0.1, volume: 0.4, layers: [{ wave: 'noise', freq: 2500, decay: 0.06, volume: 0.25 }] },\n  hit_metal: { wave: 'square', duty: 0.25, freq: 1100, freqEnd: 900, decay: 0.09, volume: 0.15, layers: [{ wave: 'sine', freq: 2300, decay: 0.12, volume: 0.1 }] },\n  hit_wood: { wave: 'triangle', freq: 300, freqEnd: 140, decay: 0.07, volume: 0.35, layers: [{ wave: 'noise', freq: 1200, decay: 0.04, volume: 0.2 }] },\n  crit: { wave: 'square', duty: 0.25, freq: 1500, freqEnd: 2400, decay: 0.09, volume: 0.13, layers: [{ wave: 'noise', freq: 7000, decay: 0.05, volume: 0.14 }] },\n  shatter: { wave: 'noise', freq: 3200, freqEnd: 700, decay: 0.2, volume: 0.32, layers: [{ wave: 'triangle', freq: 260, freqEnd: 90, decay: 0.12, volume: 0.3 }, { ...clink(980, 0.06, 0.05), delay: 0.04 }, { ...clink(760, 0.06, 0.05), delay: 0.09 }] },\n  blast: thud(120, 0.5, 0.3, 0.4),\n  stone_hit: thud(90, 0.5, 0.22, 0.4),\n  coffin_slam: { wave: 'triangle', freq: 110, freqEnd: 45, decay: 0.3, volume: 0.55, layers: [{ wave: 'noise', freq: 1000, decay: 0.18, volume: 0.35 }, { wave: 'square', duty: 0.5, freq: 70, decay: 0.08, volume: 0.12 }] },\n  whoosh: swish(300, 3000, 0.22, 0.2),\n  whip: swish(5000, 900, 0.1, 0.25),\n  dodge: { ...swish(900, 2400, 0.18, 0.2), layers: [{ wave: 'triangle', freq: 140, freqEnd: 90, decay: 0.08, volume: 0.22, delay: 0.18 }] },\n  charge: { wave: 'saw', freq: 90, freqEnd: 220, decay: 0.3, volume: 0.14, layers: [swish(500, 3000, 0.3, 0.2)] },\n  // Skills.\n  spark: { wave: 'square', duty: 0.125, freq: 1400, freqEnd: 420, decay: 0.1, volume: 0.13, layers: [{ wave: 'noise', freq: 6000, decay: 0.06, volume: 0.1 }] },\n  flare: { wave: 'noise', freq: 7000, freqEnd: 2200, decay: 0.32, volume: 0.28, layers: [{ wave: 'sine', freq: 520, freqEnd: 1700, decay: 0.3, volume: 0.14 }] },\n  lob: swish(600, 1400, 0.2, 0.14),\n  dig: { wave: 'noise', freq: 900, freqEnd: 300, decay: 0.2, volume: 0.3, layers: [{ wave: 'triangle', freq: 130, decay: 0.1, volume: 0.25 }] },\n  blink: { wave: 'sine', freq: 300, freqEnd: 1800, decay: 0.16, volume: 0.2, layers: [{ wave: 'noise', freq: 8000, decay: 0.08, volume: 0.1 }] },\n  snuff: { wave: 'noise', freq: 2500, freqEnd: 200, decay: 0.4, volume: 0.3, layers: [{ wave: 'sine', freq: 200, freqEnd: 60, decay: 0.3, volume: 0.3 }] },\n  beacon: { wave: 'saw', freq: 110, freqEnd: 440, decay: 0.6, volume: 0.12, layers: [{ wave: 'noise', freq: 1800, decay: 0.5, volume: 0.15 }, { wave: 'sine', freq: 440, decay: 0.8, volume: 0.12, delay: 0.3 }] },\n  comet: { wave: 'noise', freq: 1200, freqEnd: 5000, decay: 0.42, volume: 0.14 },\n  raise: { wave: 'triangle', freq: 90, freqEnd: 260, decay: 0.35, volume: 0.28, vibrato: { depth: 2, rate: 12 }, layers: [{ wave: 'noise', freq: 700, decay: 0.3, volume: 0.15 }] },\n  rise: { wave: 'noise', freq: 500, freqEnd: 1100, decay: 0.28, volume: 0.13 },\n  exhume: { wave: 'triangle', freq: 170, freqEnd: 50, decay: 0.3, volume: 0.45, layers: [{ wave: 'noise', freq: 1400, decay: 0.2, volume: 0.28 }] },\n  curse: { wave: 'saw', freq: 220, freqEnd: 110, decay: 0.5, volume: 0.1, vibrato: { depth: 1, rate: 7 }, layers: [{ wave: 'sine', freq: 233, freqEnd: 117, decay: 0.5, volume: 0.14 }] },\n  bone_hit: { wave: 'square', duty: 0.125, freq: 800, freqEnd: 300, decay: 0.08, volume: 0.17, layers: [{ wave: 'noise', freq: 4000, decay: 0.05, volume: 0.16 }] },\n  crossbow: { wave: 'square', duty: 0.25, freq: 520, freqEnd: 260, decay: 0.05, volume: 0.16, layers: [swish(4000, 1200, 0.1, 0.12)] },\n  hymn: { wave: 'sine', freq: 293.7, decay: 1, volume: 0.18, vibrato: { depth: 0.2, rate: 5 }, layers: [{ wave: 'sine', freq: 440, decay: 1, volume: 0.13 }, { wave: 'sine', freq: 587, decay: 1, volume: 0.08, delay: 0.1 }] },\n  fire_start: { wave: 'noise', freq: 1200, freqEnd: 3200, decay: 0.3, volume: 0.18 },\n  // Hazards and monsters.\n  telegraph: { wave: 'square', duty: 0.5, freq: 330, freqEnd: 247, decay: 0.15, volume: 0.09 },\n  telegraph_big: { wave: 'saw', freq: 196, decay: 0.7, volume: 0.12, vibrato: { depth: 0.6, rate: 9 }, layers: [{ wave: 'saw', freq: 207, decay: 0.7, volume: 0.08 }] },\n  wave: { wave: 'sine', freq: 180, freqEnd: 90, decay: 0.5, volume: 0.28, layers: [swish(400, 1200, 0.4, 0.12)] },\n  sour_note: { wave: 'triangle', freq: 466, freqEnd: 440, decay: 0.4, volume: 0.16, vibrato: { depth: 0.5, rate: 6 }, layers: [{ wave: 'triangle', freq: 494, decay: 0.4, volume: 0.1 }] },\n  coins: { wave: 'square', duty: 0.25, freq: 1800, decay: 0.05, volume: 0.1, layers: [{ ...clink(2300, 0.09, 0.05), delay: 0.04 }, { ...clink(1900, 0.09, 0.05), delay: 0.09 }, { ...clink(2500, 0.08, 0.05), delay: 0.13 }, { ...clink(2100, 0.08, 0.05), delay: 0.19 }] },\n  burst_wet: { wave: 'noise', freq: 700, freqEnd: 200, decay: 0.32, volume: 0.42, layers: [{ wave: 'sine', freq: 120, freqEnd: 40, decay: 0.25, volume: 0.4 }] },\n  swell: { wave: 'sine', freq: 80, freqEnd: 240, decay: 0.9, volume: 0.25, vibrato: { depth: 1, rate: 14 } },\n  stone_crack: { wave: 'noise', freq: 1800, freqEnd: 500, decay: 0.2, volume: 0.28, layers: [{ wave: 'square', duty: 0.125, freq: 120, decay: 0.1, volume: 0.1 }] },\n  roar: { wave: 'saw', freq: 90, freqEnd: 60, decay: 0.8, volume: 0.22, vibrato: { depth: 3, rate: 18 }, crush: 8, layers: [{ wave: 'noise', freq: 400, decay: 0.7, volume: 0.2 }] },\n  wing: swish(300, 900, 0.14, 0.15),\n  jackpot: { wave: 'square', duty: 0.25, freq: 660, decay: 0.5, volume: 0.13, arp: [0, 4, 7, 12, 16, 19], arpRate: 0.06, layers: [{ wave: 'sine', freq: 1320, decay: 0.5, volume: 0.1 }] },\n  plate_escape: { wave: 'square', duty: 0.25, freq: 900, freqEnd: 300, decay: 0.3, volume: 0.12, arp: [0, -3, -7], arpRate: 0.08 },\n  boss_death: { wave: 'saw', freq: 200, freqEnd: 30, decay: 1.5, volume: 0.2, crush: 6, layers: [{ wave: 'noise', freq: 600, freqEnd: 100, decay: 1.2, volume: 0.3 }, { wave: 'sine', freq: 100, freqEnd: 30, decay: 1.5, volume: 0.3 }] },\n  // Loot and pickups.\n  gold: { wave: 'square', duty: 0.25, freq: 1760, decay: 0.05, volume: 0.09, layers: [{ ...clink(2640, 0.08, 0.06), delay: 0.04 }] },\n  gold_drop: { ...clink(2100, 0.07, 0.04), layers: [{ ...clink(1700, 0.06, 0.04), delay: 0.05 }] },\n  tallow: { wave: 'sine', freq: 500, freqEnd: 800, decay: 0.18, volume: 0.2, layers: [{ wave: 'sine', freq: 750, freqEnd: 1100, decay: 0.2, volume: 0.1, delay: 0.05 }] },\n  tallow_drop: { wave: 'sine', freq: 300, freqEnd: 150, decay: 0.08, volume: 0.22 },\n  drop_item: { wave: 'triangle', freq: 500, freqEnd: 300, decay: 0.1, volume: 0.24 },\n  drop_rare: { wave: 'triangle', freq: 880, decay: 0.3, volume: 0.18, arp: [0, 7, 12], arpRate: 0.06 },\n  pickup: { wave: 'triangle', freq: 660, freqEnd: 880, decay: 0.08, volume: 0.2 },\n  potion: { wave: 'sine', freq: 300, freqEnd: 700, decay: 0.28, volume: 0.22, vibrato: { depth: 1, rate: 22 }, layers: [{ wave: 'sine', freq: 900, decay: 0.2, volume: 0.1, delay: 0.1 }] },\n  levelup: { wave: 'square', duty: 0.25, freq: 294, decay: 0.7, volume: 0.14, arp: [0, 7, 12, 15, 19, 24], arpRate: 0.09, layers: [bell(587, { vol: 0.2, decay: 1.3 })] },\n  quest: { wave: 'triangle', freq: 440, decay: 0.5, volume: 0.2, arp: [0, 5, 7, 12], arpRate: 0.1 },\n  shrine: { wave: 'sine', freq: 440, decay: 1, volume: 0.18, layers: [{ wave: 'sine', freq: 660, decay: 1, volume: 0.12, delay: 0.12 }, { wave: 'sine', freq: 880, decay: 1, volume: 0.1, delay: 0.24 }] },\n  chest: { wave: 'triangle', freq: 130, freqEnd: 200, decay: 0.2, volume: 0.3, layers: [{ ...clink(900, 0.07, 0.3), delay: 0.14, arp: [0, 4, 7], arpRate: 0.07 }] },\n  lever: { wave: 'square', duty: 0.5, freq: 200, freqEnd: 100, decay: 0.09, volume: 0.2, layers: [{ wave: 'noise', freq: 900, decay: 0.2, volume: 0.15, delay: 0.05 }] },\n  gate: { wave: 'sine', freq: 392, decay: 0.8, volume: 0.15, layers: [{ wave: 'sine', freq: 587, decay: 0.8, volume: 0.1, delay: 0.08 }] },\n  portcullis: { wave: 'noise', freq: 1000, freqEnd: 500, decay: 0.7, volume: 0.22, layers: [{ wave: 'square', duty: 0.125, freq: 60, decay: 0.7, volume: 0.1 }] },\n  spikes: { wave: 'noise', freq: 4000, freqEnd: 1500, decay: 0.09, volume: 0.25, layers: [{ wave: 'square', duty: 0.125, freq: 400, decay: 0.05, volume: 0.1 }] },\n  cart: { wave: 'noise', freq: 300, decay: 0.3, volume: 0.2 },\n  salvage: { wave: 'noise', freq: 3000, freqEnd: 900, decay: 0.2, volume: 0.25, layers: [{ wave: 'triangle', freq: 180, decay: 0.15, volume: 0.25 }] },\n  forge: { wave: 'square', duty: 0.25, freq: 1200, decay: 0.2, volume: 0.13, layers: [{ wave: 'sine', freq: 2400, decay: 0.35, volume: 0.1 }, { wave: 'noise', freq: 2500, decay: 0.08, volume: 0.2 }] },\n  socket: { wave: 'sine', freq: 1100, decay: 0.25, volume: 0.18, layers: [{ wave: 'sine', freq: 1650, decay: 0.25, volume: 0.1 }, { ...clink(2100, 0.06, 0.04) }] },\n  hurt_hero: { wave: 'square', duty: 0.25, freq: 240, freqEnd: 120, decay: 0.12, volume: 0.15, layers: [{ wave: 'noise', freq: 1000, decay: 0.08, volume: 0.15 }] },\n  hero_death: { wave: 'triangle', freq: 220, freqEnd: 55, decay: 1, volume: 0.28, layers: [bell(98, { vol: 0.24, decay: 2, cracked: true })] },\n  revive: { wave: 'sine', freq: 330, freqEnd: 660, decay: 0.4, volume: 0.2, layers: [bell(660, { vol: 0.14, decay: 0.8 })] },\n  // Interface.\n  ui_move: { wave: 'square', duty: 0.25, freq: 660, decay: 0.03, volume: 0.07 },\n  ui_confirm: { wave: 'square', duty: 0.25, freq: 660, decay: 0.09, volume: 0.1, arp: [0, 7], arpRate: 0.04 },\n  ui_back: { wave: 'square', duty: 0.25, freq: 494, freqEnd: 330, decay: 0.08, volume: 0.09 },\n  ui_error: { wave: 'square', duty: 0.5, freq: 150, decay: 0.14, volume: 0.1, layers: [{ wave: 'square', duty: 0.5, freq: 159, decay: 0.14, volume: 0.08 }] },\n  ui_tab: { wave: 'triangle', freq: 523, decay: 0.05, volume: 0.15 },\n  ui_equip: { wave: 'noise', freq: 1600, decay: 0.05, volume: 0.15, layers: [{ wave: 'triangle', freq: 300, freqEnd: 500, decay: 0.08, volume: 0.25 }] },\n  // Footfalls, by floor.\n  step_stone: { wave: 'noise', freq: 1400, decay: 0.03, volume: 0.05 },\n  step_mud: { wave: 'noise', freq: 500, freqEnd: 250, decay: 0.05, volume: 0.07 },\n  step_wood: { wave: 'triangle', freq: 170, decay: 0.03, volume: 0.1 },\n  // Ambience loops.\n  rain_loop: { wave: 'noise', freq: 7000, sustain: 2, decay: 0.01, attack: 0.01, volume: 0.06 },\n  fire_loop: { wave: 'noise', freq: 900, sustain: 1.5, decay: 0.01, attack: 0.01, volume: 0.06 },\n  wind_loop: { wave: 'noise', freq: 300, freqEnd: 700, sustain: 3, decay: 0.01, attack: 0.01, volume: 0.06 },\n  cart_loop: { wave: 'noise', freq: 180, sustain: 0.5, decay: 0.01, attack: 0.01, volume: 0.07 },\n};\n\nconst VOICES = {\n  peat: { f: 90, w: 'saw', noise: 0.15 }, bone: { f: 520, w: 'square', noise: 0.25, clack: true }, skull: { f: 620, w: 'triangle', noise: 0.05, vib: true }, big: { f: 70, w: 'saw', noise: 0.2 },\n  crawl: { f: 900, w: 'square', noise: 0.25 }, bloat: { f: 110, w: 'triangle', noise: 0.15, vib: true }, imp: { f: 480, w: 'saw', noise: 0.2 }, moan: { f: 170, w: 'triangle', noise: 0.08, vib: true }, beast: { f: 75, w: 'saw', noise: 0.3 }, plate: { f: 1200, w: 'square', noise: 0.08 },\n  bursar: { f: 80, w: 'saw', noise: 0.15 }, ambrose: { f: 180, w: 'triangle', noise: 0.06 }, malison: { f: 58, w: 'saw', noise: 0.2, vib: true },\n};\nfor (const [id, v] of Object.entries(VOICES)) {\n  const base = (freq, freqEnd, decay, volume) => ({ wave: v.w, duty: 0.25, freq, freqEnd, decay, volume, ...(v.vib ? { vibrato: { depth: 1, rate: 10 } } : {}), layers: [{ wave: 'noise', freq: freq * 8, decay: decay * 0.5, volume: v.noise }] });\n  SFX_DEFS[`mon_${id}_wake`] = base(v.f, v.f * 1.4, 0.2, 0.11);\n  SFX_DEFS[`mon_${id}_attack`] = base(v.f * 1.5, v.f, 0.13, 0.13);\n  SFX_DEFS[`mon_${id}_hurt`] = base(v.f * 1.3, v.f * 1.8, 0.08, 0.09);\n  SFX_DEFS[`mon_${id}_death`] = base(v.f * 1.2, v.f * 0.4, 0.3, 0.15);\n}\n\n// Skill-specific hero grunts.\nSFX_DEFS.grunt_low = { wave: 'saw', freq: 120, freqEnd: 90, decay: 0.09, volume: 0.1 };\nSFX_DEFS.grunt_mid = { wave: 'saw', freq: 190, freqEnd: 140, decay: 0.08, volume: 0.08 };\n\nexport const SFX_NAMES = Object.keys(SFX_DEFS);\nEOF\ncat > src/data/songs.js <<'EOF'\n// The score, as data. Every piece states or bends the Clemency motif (D minor):\n//   D4 A4 F4 E4 | D4 C4 D4 A3\n// Malison's version is the same notes, one semitone off, because the bell is cracked.\n\n/** 'D4:4 r:4 A4:2' expands to steps: a note, its holds, rests. */\nconst S = (spec) => spec.trim().split(/\\s+/).flatMap((tok) => {\n  const [n, l = '1'] = tok.split(':');\n  const len = Number(l);\n  if (n === 'r') return Array(len).fill('.');\n  return [n, ...Array(len - 1).fill('-')];\n}).join(' ');\nconst rep = (spec, n) => Array(n).fill(spec).join(' ');\n\nconst inst = {\n  bell: { wave: 'sine', attack: 0.002, decay: 2, volume: 0.22, layers: [{ wave: 'sine', freq: 0, decay: 1, volume: 0 }] },\n  organ: { wave: 'square', duty: 0.25, attack: 0.03, decay: 0.2, volume: 0.09 },\n  organ2: { wave: 'square', duty: 0.5, attack: 0.03, decay: 0.2, volume: 0.06 },\n  lead: { wave: 'square', duty: 0.25, attack: 0.005, decay: 0.2, volume: 0.1 },\n  lute: { wave: 'triangle', decay: 0.4, volume: 0.17 },\n  bass: { wave: 'triangle', decay: 0.25, volume: 0.22 },\n  deep: { wave: 'sine', decay: 0.7, volume: 0.28 },\n  stab: { wave: 'saw', decay: 0.14, volume: 0.1 },\n  wind: { wave: 'noise', attack: 0.3, decay: 0.8, volume: 0.03 },\n  snare: { wave: 'noise', decay: 0.09, volume: 0.1 },\n  hat: { wave: 'noise', decay: 0.03, volume: 0.05 },\n  kick: { wave: 'sine', decay: 0.1, volume: 0.3, freqEnd: 40 },\n};\nfor (const k of Object.keys(inst)) { if (inst[k].layers) delete inst[k].layers; if (inst[k].freqEnd) delete inst[k].freqEnd; }\nconst pick = (...ids) => Object.fromEntries(ids.map((i) => [i, inst[i]]));\n\nexport const SONGS = {\n  vespers: { bpm: 60, stepsPerBeat: 2, tracks: pick('bell', 'organ', 'organ2', 'deep'), order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { bell: S('D4:4 A4:4 F4:4 E4:4 D4:4 C4:4 D4:4 A3:4 r:32'), organ: S('r:32 D3:16 C3:8 A2:8'), organ2: S('r:32 A3:16 G3:8 E3:8'), deep: S('D2:16 r:16 D2:16 A1:16') },\n    b: { bell: S('r:16 D5:4 r:12 D4:4 A4:4 F4:4 E4:4 D4:8 r:8'), organ: S('D3:16 F3:16 G3:16 A3:16'), organ2: S('A3:16 C4:16 D4:16 E4:16'), deep: S('D2:16 F2:16 G2:16 A2:16') },\n    c: { bell: S('D5:4 A5:4 F5:4 E5:4 D5:4 C5:4 D5:4 A4:4 D4:16 r:16'), organ: S('D3:8 A3:8 F3:8 E3:8 D3:16 D3:16'), organ2: S('F3:8 C4:8 A3:8 G3:8 F3:16 A3:16'), deep: S('D2:32 D2:16 D2:16') },\n  } },\n  last_lamps: { bpm: 72, tracks: pick('lute', 'lead', 'bass', 'hat'), stepsPerBeat: 2, order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { lute: rep(S('D4 A4 F4 A4 D4 A4 F4 A4'), 2) + ' ' + rep(S('C4 G4 E4 G4 C4 G4 E4 G4'), 1) + ' ' + rep(S('A3 E4 C4 E4 A3 E4 C#4 E4'), 1) + ' ' + rep(S('D4 A4 F4 A4 Bb3 F4 D4 F4'), 2) + ' ' + rep(S('C4 G4 E4 G4 A3 E4 C#4 E4'), 2), lead: S('r:16 D5:4 A4:4 F4:4 E4:4 D4:8 C4:4 D4:4 A3:8 r:8'), bass: S('D3:8 D3:8 C3:8 A2:8 D3:8 Bb2:8 C3:8 A2:8'), hat: rep(S('r:3 C8'), 16) },\n    b: { lute: rep(S('Bb3 F4 D4 F4 Bb3 F4 D4 F4'), 2) + ' ' + rep(S('F3 C4 A3 C4 F3 C4 A3 C4'), 2) + ' ' + rep(S('G3 D4 Bb3 D4 G3 D4 Bb3 D4'), 2) + ' ' + rep(S('A3 E4 C#4 E4 A3 E4 C#4 E4'), 2), lead: S('F5:6 E5:2 D5:8 C5:6 A4:2 F4:8 G4:6 A4:2 Bb4:8 A4:12 r:4'), bass: S('Bb2:16 F2:16 G2:16 A2:16'), hat: rep(S('r:3 C8'), 16) },\n    c: { lute: rep(S('D4 F4 A4 D5 A4 F4 D4 F4'), 4) + ' ' + rep(S('A3 C#4 E4 A4 E4 C#4 A3 C#4'), 2) + ' ' + rep(S('D4 F4 A4 D5 A4 F4 D4 F4'), 2), lead: S('D5:8 A5:8 F5:8 E5:8 D5:8 C5:8 D5:16'), bass: S('D3:16 F3:16 A2:16 D3:16'), hat: rep(S('r:7 C8'), 8) },\n  } },\n  weeping_road: { bpm: 66, stepsPerBeat: 2, tracks: pick('deep', 'organ', 'lead', 'wind'), order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { deep: rep(S('D2:2 r:6'), 8), organ: S('r:32 A3:16 F3:16'), lead: S('r:16 D4:4 r:4 A4:4 r:4 F4:4 r:4 E4:4 r:4 r:16'), wind: S('C4:32 r:8 D4:24') },\n    b: { deep: rep(S('A1:2 r:6'), 4) + ' ' + rep(S('D2:2 r:6'), 4), organ: S('C4:16 A3:16 Bb3:16 A3:16'), lead: S('D4:4 r:4 C4:4 r:4 D4:4 r:4 A3:12 r:32'), wind: S('r:16 E4:32 r:16') },\n    c: { deep: rep(S('D2:1 r:1 D2:1 r:5'), 8), organ: S('D3:32 C3:16 A2:16'), lead: S('r:32 F4:4 E4:4 D4:4 C4:4 D4:16'), wind: S('D4:64') },\n  } },\n  under_gloam: { bpm: 58, stepsPerBeat: 2, tracks: pick('organ', 'organ2', 'bell', 'wind'), order: ['a', 'b', 'c', 'b'], patterns: {\n    a: { organ: S('D3:32 C3:32'), organ2: S('A3:32 G3:32'), bell: S('r:24 A5:8 r:24 D6:8'), wind: S('C3:64') },\n    b: { organ: S('Bb2:32 A2:32'), organ2: S('F3:32 E3:32'), bell: S('r:8 D5:8 r:8 A5:8 r:8 F5:8 r:8 E5:8'), wind: S('r:32 D3:32') },\n    c: { organ: S('D3:16 F3:16 E3:16 A2:16'), organ2: S('A3:16 C4:16 B3:16 E3:16'), bell: S('D6:16 r:16 C6:16 A5:16'), wind: S('C3:32 r:32') },\n  } },\n  cinders: { bpm: 96, tracks: pick('lead', 'bass', 'kick', 'snare', 'stab'), order: ['a', 'a', 'b', 'c'], patterns: {\n    a: { lead: rep(S('D4 r D4 F4 r D4 E4 r'), 8), bass: rep(S('D2 r D2 r D2 r D2 D2'), 6) + ' ' + rep(S('C2 r C2 r C2 r A1 A1'), 2), kick: rep(S('C4 r:3 r:2 C4 r'), 8), snare: rep(S('r:4 C6 r:3'), 8), stab: S('r:32 D4:2 r:6 D4:2 r:6 F4:2 r:6 E4:2 r:6') },\n    b: { lead: S('D5:4 A5:4 F5:4 E5:4 D5:4 C5:4 D5:4 A4:4 D5:2 D5:2 F5:4 E5:4 C5:4 D5:16'), bass: rep(S('Bb1 r Bb1 r F2 r F2 r'), 2) + ' ' + rep(S('G1 r G1 r D2 r D2 r'), 2) + ' ' + rep(S('A1 r A1 r E2 r E2 r'), 4), kick: rep(S('C4 r:3 C4 r:3'), 8), snare: rep(S('r:2 C6 r:3 C6 r'), 8), stab: rep(S('r:7 A3'), 8) },\n    c: { lead: rep(S('A4 r A4 C5 r A4 Bb4 r'), 4) + ' ' + rep(S('D5 r D5 F5 r D5 E5 r'), 4), bass: rep(S('A1 r A1 r A1 r A1 G1'), 4) + ' ' + rep(S('D2 r D2 r D2 r D2 C2'), 4), kick: rep(S('C4 r C4 r:5'), 8), snare: rep(S('r:4 C6 r:2 C6'), 8), stab: S('D4:1 r:15 D4:1 r:15 D4:1 r:15 A3:1 r:15') },\n  } },\n  ledger: { bpm: 126, tracks: pick('lead', 'bass', 'snare', 'stab', 'kick'), order: ['a', 'b', 'a', 'c'], patterns: {\n    // Mock-pompous: a little march, grandly announced, slightly off the point.\n    a: { lead: S('D5:3 D5:1 D5:2 A4:2 F5:3 E5:1 D5:4 C5:3 D5:1 E5:2 C5:2 A4:8 D5:3 D5:1 D5:2 A4:2 F5:3 E5:1 D5:4 C5:2 C5:2 E5:2 C5:2 D5:8 r:16'), bass: rep(S('D3:2 A2:2'), 8) + ' ' + rep(S('D3:2 A2:2'), 8), snare: rep(S('C7 r C7 C7 C7 r C7 r'), 8), stab: rep(S('r:2 F4:1 r:1 r:2 F4:1 r:1'), 8), kick: rep(S('C4 r:7'), 8) },\n    b: { lead: S('Bb4:4 D5:4 F5:4 D5:4 C5:4 E5:4 G5:4 E5:4 D5:4 F5:4 A5:4 F5:4 E5:4 C#5:4 A4:8'), bass: S('Bb2:4 F2:4 Bb2:4 F2:4 C3:4 G2:4 C3:4 G2:4 D3:4 A2:4 D3:4 A2:4 A2:4 E2:4 A2:8'), snare: rep(S('C7 r C7 C7 C7 r C7 r'), 8), stab: rep(S('r:7 D4'), 8), kick: rep(S('C4 r:3 C4 r:3'), 8) },\n    c: { lead: S('D5:2 D5:2 C5:2 C5:2 Bb4:2 Bb4:2 A4:4 G4:2 A4:2 Bb4:2 C5:2 D5:8 D5:2 D5:2 C5:2 C5:2 Bb4:2 Bb4:2 A4:4 G4:2 F4:2 E4:2 C#4:2 D4:8 r:16'), bass: rep(S('D3:2 A2:2'), 16), snare: rep(S('C7 C7 C7 r C7 r C7 r'), 8), stab: S('D4:2 r:30 D4:2 r:30'), kick: rep(S('C4 r:7'), 8) },\n  } },\n  the_climb: { bpm: 104, tracks: pick('lead', 'bass', 'kick', 'hat', 'organ'), order: ['a', 'b', 'c', 'b'], patterns: {\n    a: { lead: rep(S('D4 F4 A4 D5'), 4) + ' ' + rep(S('E4 G4 Bb4 E5'), 4) + ' ' + rep(S('F4 A4 C5 F5'), 4) + ' ' + rep(S('G4 Bb4 D5 G5'), 4), bass: rep(S('D2 r D2 D2'), 4) + ' ' + rep(S('E2 r E2 E2'), 4) + ' ' + rep(S('F2 r F2 F2'), 4) + ' ' + rep(S('G2 r G2 G2'), 4), kick: rep(S('C4 r:3'), 16), hat: rep(S('r C8'), 32), organ: S('D3:16 E3:16 F3:16 G3:16') },\n    b: { lead: S('A4:2 D5:2 A5:4 F5:2 E5:2 D5:4 C5:2 D5:2 A4:4 D5:2 F5:2 A5:4 Bb5:4 A5:4 G5:4 F5:4 E5:4 D5:4 C#5:4 A4:12 r:4'), bass: rep(S('D2 D3'), 8) + ' ' + rep(S('Bb1 Bb2'), 8) + ' ' + rep(S('G1 G2'), 8) + ' ' + rep(S('A1 A2'), 8), kick: rep(S('C4 r:3 C4 r C4 r'), 8), hat: rep(S('r C8'), 32), organ: S('D4:16 Bb3:16 G3:16 A3:16') },\n    c: { lead: rep(S('A4 C5 E5 A5'), 4) + ' ' + rep(S('Bb4 D5 F5 Bb5'), 4) + ' ' + rep(S('C5 E5 G5 C6'), 4) + ' ' + rep(S('D5 F5 A5 D6'), 4), bass: rep(S('A1 r A1 A1'), 4) + ' ' + rep(S('Bb1 r Bb1 Bb1'), 4) + ' ' + rep(S('C2 r C2 C2'), 4) + ' ' + rep(S('D2 r D2 D2'), 4), kick: rep(S('C4 r:3'), 16), hat: rep(S('C8 C8'), 32), organ: S('A3:16 Bb3:16 C4:16 D4:16') },\n  } },\n  // The motif, a semitone off: D#4 A#4 F#4 F4 | D#4 C#4 D#4 A#3.\n  eventide: { bpm: 138, tracks: pick('lead', 'bass', 'kick', 'snare', 'stab', 'organ'), order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { lead: S('D#4:4 A#4:4 F#4:4 F4:4 D#4:4 C#4:4 D#4:4 A#3:4 D#5:4 A#5:4 F#5:4 F5:4 D#5:4 C#5:4 D#5:8'), bass: rep(S('D#2 D#2 r D#2'), 8) + ' ' + rep(S('C#2 C#2 r C#2'), 4) + ' ' + rep(S('A#1 A#1 r A#1'), 4), kick: rep(S('C4 r C4 r'), 16), snare: rep(S('r:4 C6 r:3'), 8), stab: rep(S('D#4 r:3 r:2 D#4 r'), 8), organ: S('D#3:32 C#3:16 A#2:16') },\n    b: { lead: rep(S('F#5:2 F5:2 D#5:2 C#5:2'), 4) + ' ' + rep(S('A#4:2 B4:2 C#5:2 D#5:2'), 4), bass: rep(S('B1 B1 r B1'), 8) + ' ' + rep(S('A#1 A#1 r A#1'), 8), kick: rep(S('C4 r C4 C4'), 16), snare: rep(S('r:2 C6 r:3 C6 r'), 8), stab: S('B3:2 r:14 B3:2 r:14 A#3:2 r:14 A#3:2 r:14'), organ: S('B2:32 A#2:32') },\n    c: { lead: S('D#5:8 F#5:8 A#5:8 C#6:8 A#5:4 F#5:4 D#5:4 C#5:4 D#5:16'), bass: rep(S('D#2 r D#3 r'), 16), kick: rep(S('C4 C4 r C4'), 16), snare: rep(S('r:4 C6 r C6 r'), 8), stab: rep(S('D#4 r D#4 r:5'), 8), organ: S('D#3:64') },\n  } },\n  the_knell: { bpm: 118, tracks: pick('lead', 'bass', 'kick', 'hat', 'snare'), order: ['a', 'b', 'c', 'b'], patterns: {\n    a: { lead: S('D4:2 r:2 A4:2 r:2 F4:2 r:2 E4:2 r:2 D4:2 r:2 C4:2 r:2 D4:2 r:2 A3:2 r:2 r:32'), bass: rep(S('D2 r D2 r D2 D2 r D2'), 8), kick: rep(S('C4 r:3 C4 r:3'), 8), hat: rep(S('r C8'), 32), snare: rep(S('r:4 C6 r:3'), 8) },\n    b: { lead: rep(S('D5 r A4 r F5 r E5 r'), 4) + ' ' + rep(S('C5 r G4 r E5 r D5 r'), 2) + ' ' + rep(S('A4 r E4 r C#5 r A4 r'), 2), bass: rep(S('D2 r D2 r D2 D2 r D2'), 4) + ' ' + rep(S('C2 r C2 r C2 C2 r C2'), 2) + ' ' + rep(S('A1 r A1 r A1 A1 r A1'), 2), kick: rep(S('C4 r C4 r C4 r:3'), 8), hat: rep(S('C8 C8'), 32), snare: rep(S('r:4 C6 r C6 r'), 8) },\n    c: { lead: S('F5:4 E5:4 D5:4 C5:4 Bb4:4 C5:4 D5:8 G5:4 F5:4 E5:4 D5:4 C#5:4 D5:4 E5:8'), bass: rep(S('Bb1 r Bb1 r Bb1 Bb1 r Bb1'), 4) + ' ' + rep(S('G1 r G1 r A1 A1 r A1'), 4), kick: rep(S('C4 r:3 C4 r:3'), 8), hat: rep(S('r C8'), 32), snare: rep(S('r:4 C6 r:3'), 8) },\n  } },\n  // Resolved to major at last.\n  clemency: { bpm: 66, stepsPerBeat: 2, tracks: pick('bell', 'organ', 'organ2', 'lute', 'deep'), order: ['a', 'b', 'c'], patterns: {\n    a: { bell: S('D4:4 A4:4 F#4:4 E4:4 D4:4 C#4:4 D4:4 A3:4 r:32'), organ: S('D3:16 A3:16 D3:16 G3:16'), organ2: S('F#3:16 C#4:16 A3:16 B3:16'), lute: rep(S('D4 F#4 A4 F#4'), 16), deep: S('D2:32 G2:16 A2:16') },\n    b: { bell: S('D5:4 A5:4 F#5:4 E5:4 D5:4 C#5:4 D5:8 r:32'), organ: S('G3:16 D3:16 A3:16 D3:16'), organ2: S('B3:16 F#3:16 C#4:16 F#3:16'), lute: rep(S('G4 B4 D5 B4'), 8) + ' ' + rep(S('A4 C#5 E5 C#5'), 4) + ' ' + rep(S('D4 F#4 A4 F#4'), 4), deep: S('G2:16 D2:16 A2:16 D2:16') },\n    c: { bell: S('D5:8 D6:8 A5:8 F#5:8 E5:8 C#5:8 D5:16'), organ: S('D3:32 A2:16 D3:16'), organ2: S('A3:32 E3:16 F#3:16'), lute: rep(S('D4 A4 F#5 A4'), 16), deep: S('D2:64') },\n  } },\n};\n\n// Variants the game swaps to: Eventide with no drums for the last phase, the Knell with a rising layer.\nconst stripDrums = (s) => ({ ...s, tracks: Object.fromEntries(Object.entries(s.tracks).filter(([k]) => k !== 'kick' && k !== 'snare')), patterns: Object.fromEntries(Object.entries(s.patterns).map(([p, tr]) => [p, Object.fromEntries(Object.entries(tr).filter(([k]) => k !== 'kick' && k !== 'snare'))])) });\nSONGS.eventide_bare = stripDrums(SONGS.eventide);\nSONGS.the_knell_high = {\n  ...SONGS.the_knell,\n  tracks: { ...SONGS.the_knell.tracks, organ: inst.organ },\n  patterns: Object.fromEntries(Object.entries(SONGS.the_knell.patterns).map(([p, tr]) => [p, { ...tr, organ: S('D5:16 C5:16 Bb4:16 A4:16') }])),\n};\n\nexport const ZONE_SONGS = { yard: 'weeping_road', town: 'last_lamps', causeway: 'weeping_road', ossuary: 'under_gloam', cloister: 'cinders', belfry: 'the_climb', pantry: 'under_gloam', knell: 'the_knell', session: 'the_knell' };\nexport const SONG_IDS = Object.keys(SONGS);\nEOF\ncat > src/audio/voice.js <<'EOF'\n// Animalese-style babble: every subtitle becomes a string of syllables. No real speech anywhere.\n// The same line always sounds the same (the mapping is a hash of the letters).\nconst REGISTERS = {\n  low: { base: 95, f1: 400, f2: 900 },\n  mid: { base: 165, f1: 600, f2: 1300 },\n  high: { base: 300, f1: 850, f2: 2000 },\n  demon: { base: 62, f1: 300, f2: 700 },\n};\n\nfunction syllable(reg, i) {\n  const r = REGISTERS[reg];\n  const v = i % 5; // five vowels, four consonants\n  const c = (i * 7) % 4;\n  const vowel = [[1, 1], [1.2, 1.5], [0.8, 1.9], [1.4, 0.8], [0.7, 0.7]][v];\n  const glide = [1.08, 0.94, 1.03, 0.97, 1.12][(i * 3) % 5];\n  const consonant = [{ wave: 'noise', freq: 5200, decay: 0.022, volume: 0.1 }, { wave: 'noise', freq: 1800, decay: 0.03, volume: 0.12 }, { wave: 'square', duty: 0.125, freq: r.base * 3, decay: 0.018, volume: 0.05 }, { wave: 'noise', freq: 3200, decay: 0.012, volume: 0.07 }][c];\n  return {\n    wave: reg === 'demon' ? 'saw' : 'triangle', freq: r.base, freqEnd: r.base * glide, decay: 0.085, attack: 0.004, volume: 0.15,\n    crush: reg === 'demon' ? 9 : 0,\n    layers: [\n      consonant,\n      { wave: 'sine', freq: r.f1 * vowel[0], freqEnd: r.f1 * vowel[0] * glide, decay: 0.08, volume: 0.075 },\n      { wave: 'sine', freq: r.f2 * vowel[1], freqEnd: r.f2 * vowel[1] * glide, decay: 0.065, volume: 0.04 },\n    ],\n  };\n}\n\nexport const SYLLABLES = {};\nfor (const reg of Object.keys(REGISTERS)) {\n  for (let i = 0; i < 20; i++) SYLLABLES[`v_${reg}_${i}`] = syllable(reg, i);\n}\n\nexport const VOICE_STYLES = {\n  narrator: { reg: 'low', pitch: -3, rate: 7, vary: 1, volume: 0.8 },\n  crier: { reg: 'high', pitch: 3, rate: 15, vary: 3, volume: 0.7 },\n  brasse: { reg: 'low', pitch: 2, rate: 11, vary: 2, volume: 1 },\n  ogive: { reg: 'mid', pitch: 5, rate: 6.5, vary: 1, volume: 0.5 },\n  pennywhistle: { reg: 'high', pitch: -2, rate: 12, vary: 4, volume: 0.65 },\n  pyx: { reg: 'mid', pitch: -1, rate: 9, vary: 0.7, volume: 0.65 },\n  ambrose: { reg: 'mid', pitch: -4, rate: 8, vary: 1.5, volume: 0.7 },\n  bursar: { reg: 'demon', pitch: 6, rate: 10, vary: 3, volume: 0.95 },\n  malison: { reg: 'demon', pitch: -1, rate: 6, vary: 2, volume: 1, double: true, echo: true },\n  warden: { reg: 'demon', pitch: 3, rate: 8, vary: 2, volume: 0.9 },\n  bark_low: { reg: 'low', pitch: 3, rate: 13, vary: 2, volume: 0.5 },\n  bark_mid: { reg: 'mid', pitch: 1, rate: 13, vary: 2, volume: 0.5 },\n};\n\nconst hash = (s) => { let h = 7; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h; };\n\n/** A line as a list of syllable plays: { name, pitch, at } with `at` in seconds. Pure. */\nexport function babble(text, style) {\n  const st = VOICE_STYLES[style] ?? VOICE_STYLES.narrator;\n  const out = [];\n  const words = text.split(/(\\s+|[.,:;!?-]+)/).filter(Boolean);\n  let t = 0;\n  const step = 1 / st.rate;\n  const lineHash = hash(text);\n  const asks = /\\?\\s*$/.test(text);\n  let idx = 0, total = 0;\n  for (const w of words) if (/[a-z0-9]/i.test(w)) total += Math.max(1, Math.ceil(w.length / 2));\n  for (const w of words) {\n    if (/^\\s+$/.test(w)) { t += step * 0.35; continue; }\n    if (/^[.,:;!?-]+$/.test(w)) {\n      t += w.includes('.') || w.includes('!') || w.includes('?') ? step * 3 : step * 1.5;\n      continue;\n    }\n    const shout = /!/.test(text.slice(text.indexOf(w), text.indexOf(w) + w.length + 2));\n    for (let i = 0; i < w.length; i += 2) {\n      const pair = w.slice(i, i + 2).toLowerCase();\n      const h = hash(pair);\n      const n = h % 20;\n      let pitch = st.pitch + (((h >> 5) % 100) / 100 - 0.5) * st.vary * 2 + (((lineHash >> (idx % 16)) & 3) - 1.5) * 0.3;\n      if (shout) pitch += 2;\n      if (asks && idx > total - 4) pitch += (idx - (total - 4)) * 1.6;\n      out.push({ name: `v_${st.reg}_${n}`, pitch, at: t, volume: st.volume });\n      if (st.double) out.push({ name: `v_${st.reg}_${n}`, pitch: pitch - 12, at: t + 0.01, volume: st.volume * 0.8 });\n      if (st.echo) out.push({ name: `v_${st.reg}_${n}`, pitch: pitch - 5, at: t + 0.22, volume: st.volume * 0.3 });\n      t += step;\n      idx++;\n    }\n  }\n  out.sort((a, b) => a.at - b.at);\n  return { syllables: out, duration: t };\n}\n\nexport const speakerStyle = (who) => (VOICE_STYLES[who] ? who : 'narrator');\nEOF\ncat > src/audio/audio.js <<'EOF'\n// All sound goes through here: effects with pitch variants and panning, music, voices, ambience.\nimport { Rng, spatialize } from '../../pixel-engine.js';\nimport { SFX_DEFS } from '../data/sfx.js';\nimport { SONGS, ZONE_SONGS } from '../data/songs.js';\nimport { SPEAKERS } from '../data/dialog.js';\nimport { babble, SYLLABLES, VOICE_STYLES } from './voice.js';\n\nconst MUSIC_DEFAULT = 0.1;\nconst FLAG_KEY = 'diabellical:music-init';\n\nexport class AudioSys {\n  constructor(game, ctx) {\n    this.game = game;\n    this.ctx = ctx;\n    this.audio = ctx.audio;\n    this.rng = new Rng('audio');\n    this.lastPlay = new Map();\n    this.queue = [];\n    this.voiceClock = 0;\n    this.voicesVol = 1;\n    this.song = null;\n    this.bossSong = null;\n    this.loops = {};\n    this.speaking = 0;\n    for (const [k, d] of Object.entries(SFX_DEFS)) this.audio.register(k, d);\n    for (const [k, d] of Object.entries(SYLLABLES)) this.audio.register(k, d);\n    this.applyMusicDefault();\n  }\n\n  /** Music at 10% by default, whatever the engine's defaults, and after its Reset too. */\n  applyMusicDefault() {\n    const a = this.audio;\n    let first = true;\n    try { first = !(typeof localStorage !== 'undefined' && localStorage.getItem(FLAG_KEY)); } catch { first = true; }\n    if (first) {\n      a.setVolume('music', MUSIC_DEFAULT);\n      try { if (typeof localStorage !== 'undefined') localStorage.setItem(FLAG_KEY, '1'); } catch { /* storage may be refused */ }\n    }\n    const orig = a.resetVolumes.bind(a);\n    a.resetVolumes = () => { orig(); a.setVolume('music', MUSIC_DEFAULT); };\n  }\n\n  /** Effects: name, and optional x, z for space, pitch, volume. */\n  sfx(name, o = {}) {\n    let id = name;\n    if (name === 'mon_attack' || name === 'mon_wake' || name === 'mon_death') {\n      if (!o.v) return;\n      id = `mon_${o.v}_${name.slice(4)}`;\n    }\n    if (name === 'cast_grunt') { if (this.rng.next() > 0.3) return; id = o.cls === 'bellwarden' ? 'grunt_low' : 'grunt_mid'; }\n    if (!SFX_DEFS[id]) return;\n    const now = this.game.frameTime ?? 0;\n    const last = this.lastPlay.get(id) ?? -1;\n    const gap = id.startsWith('hit_') || id === 'gold' ? 0.045 : 0.03;\n    if (now - last < gap) return;\n    this.lastPlay.set(id, now);\n    let volume = o.volume ?? 1, pan = 0;\n    if (o.x !== undefined && this.game.view) {\n      const cam = this.game.view.cam;\n      const dx = o.x - cam.x, dz = o.z - cam.z;\n      const d = Math.hypot(dx, dz);\n      if (d > 34) return;\n      volume *= Math.min(1, 1.3 - d / 26);\n      pan = Math.max(-0.8, Math.min(0.8, ((dx - dz) * 0.71) / 14));\n    }\n    const pitch = (o.pitch ?? 0) + (o.n ?? 0) + (id.startsWith('bell_true') || id.startsWith('ui_') ? 0 : this.rng.range(-1.2, 1.2));\n    this.audio.play(id, { volume, pitch, pan });\n  }\n\n  // ---- Music --------------------------------------------------------------------------------\n  music(id) {\n    const song = id ? SONGS[id] : null;\n    if (id === this.song) return;\n    this.song = id;\n    this.audio.playMusic(song, id ?? 'none');\n  }\n  zoneChanged(zone) {\n    this.bossSong = null;\n    this.music(ZONE_SONGS[zone.id] ?? 'under_gloam');\n    this.ambience(zone);\n  }\n  bossMusic(id) { if (id) { this.bossSong = id; this.music(id); } }\n  endBoss(zone) { this.bossSong = null; if (zone) this.music(ZONE_SONGS[zone.id] ?? 'under_gloam'); }\n  setDrums(on) { if (this.song === 'eventide' && !on) this.music('eventide_bare'); }\n  knellRising(high) { if (this.song === 'the_knell' && high) this.music('the_knell_high'); }\n\n  ambience(zone) {\n    this.stopAmbience();\n    const b = zone.biome;\n    const want = { yard: ['rain_loop'], causeway: ['rain_loop', 'wind_loop'], cloister: ['fire_loop'], belfry: ['wind_loop'], ossuary: ['wind_loop'], town: ['fire_loop'], pantry: ['wind_loop'] }[b] ?? [];\n    for (const k of want) this.loops[k] = this.audio.loop(k, { volume: 0.55, muffle: k === 'wind_loop' ? 0.6 : 0.2 });\n  }\n  stopAmbience() { for (const v of Object.values(this.loops)) v.stop(); this.loops = {}; }\n  loopAt() { return null; }\n\n  // ---- Voices -------------------------------------------------------------------------------\n  /** Say a line. Later lines replace what is left of the last one. */\n  speak(who, text) {\n    const style = SPEAKERS[who]?.voice ?? (VOICE_STYLES[who] ? who : 'narrator');\n    const { syllables, duration } = babble(text, style);\n    this.queue = syllables.map((s) => ({ ...s }));\n    this.voiceClock = 0;\n    this.speaking = duration;\n    this.lastLine = { who, text, syllables: syllables.map((s) => s.name) };\n    return duration;\n  }\n\n  bark(seat) {\n    if ((this.barkT ?? 0) > (this.game.frameTime ?? 0)) return;\n    this.barkT = (this.game.frameTime ?? 0) + 2;\n    const h = this.game.world?.heroes?.find((o) => o.seat === seat);\n    const cls = h?.cls ?? 'bellwarden';\n    const barks = { bellwarden: ['bark_low', 'Not enough Clangor'], lamplighter: ['bark_mid', 'Not enough Wick'], sexton: ['bark_mid', 'Not enough Tithe'] }[cls] ?? ['bark_mid', 'No'];\n    const { syllables } = babble(barks[1], barks[0]);\n    for (const s of syllables) this.queue.push({ ...s, at: this.voiceClock + s.at });\n  }\n\n  update(realDt) {\n    if (this.queue.length) {\n      this.voiceClock += realDt;\n      while (this.queue.length && this.queue[0].at <= this.voiceClock) {\n        const s = this.queue.shift();\n        this.audio.play(s.name, { pitch: s.pitch, volume: s.volume * this.voicesVol });\n      }\n    }\n    if (this.speaking > 0) this.speaking -= realDt;\n  }\n\n  stopAll() {\n    this.queue.length = 0;\n    this.audio.playMusic(null);\n    this.audio.stopLoops();\n    this.loops = {};\n    this.song = null;\n  }\n}\n\nexport { spatialize };\nEOF\ncat > .scratch/audiocheck.mjs <<'EOF'\nimport { renderSound, parseSong } from '../pixel-engine.js';\nimport { SFX_DEFS } from '../src/data/sfx.js';\nimport { SYLLABLES } from '../src/audio/voice.js';\nimport { SONGS } from '../src/data/songs.js';\nlet bad=0;\nfor (const [k,d] of Object.entries({...SFX_DEFS,...SYLLABLES})) { const s=renderSound(d,22050,1); let p=0; for(let i=0;i<s.length;i++){const v=Math.abs(s[i]); if(v>p)p=v;} if(p<0.005||p>1.0001){bad++;console.log('LEVEL',k,p.toFixed(3));} }\nfor (const [k,s] of Object.entries(SONGS)) { try{ const r=parseSong(s); }catch(e){bad++;console.log('SONG',k,e.message.slice(0,200));} }\nconsole.log('sfx',Object.keys(SFX_DEFS).length,'songs',Object.keys(SONGS).length,'bad',bad);\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/audiocheck.mjs 2>&1 | tail -n 25 | cut -c1-260","description":"Write sound effects, songs, voice system and check them","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":30442,"cache_read_input_tokens":547809,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":30442},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"a33387ca-4b02-4299-b6df-0b87575adade","timestamp":"2026-11-06T00:17:59.202Z","request_id":"req_011Cgki8R9HnUWuwWKGXXPRq","wire_tool_inputs":{"toolu_016CQp4L2n4fCLMjCb48pjfG":{"command":"cat > src/data/sfx.js <<'EOF'\n// Every sound in the game, as data. No audio files anywhere.\nconst bell = (base, { vol = 0.34, decay = 1.8, bright = 1, cracked = false, detune = 1.004 } = {}) => {\n  const partial = (ratio, v, d) => ({ wave: 'sine', freq: base * ratio, decay: decay * d, volume: vol * v });\n  const layers = [partial(0.5, 0.6, 1.3), partial(1.2 * detune, 0.42 * bright, 0.8), partial(1.5, 0.3 * bright, 0.7), partial(2, 0.3 * bright, 0.55), partial(2.67, 0.16 * bright, 0.4), partial(3 * detune, 0.12 * bright, 0.3)];\n  if (cracked) layers.push({ wave: 'sine', freq: base * 1.03, decay: decay * 0.9, volume: vol * 0.45 }, { wave: 'sine', freq: base * 1.47, decay: decay * 0.5, volume: vol * 0.3 }, { wave: 'noise', freq: 900, decay: 0.2, volume: vol * 0.3 });\n  layers.push({ wave: 'noise', freq: 4000, decay: 0.03, volume: vol * 0.3 });\n  return { wave: 'sine', freq: base, decay, volume: vol * 0.7, layers };\n};\nconst thud = (freq, vol = 0.5, decay = 0.2, noise = 0.3) => ({ wave: 'sine', freq, freqEnd: freq * 0.35, decay, volume: vol, layers: [{ wave: 'noise', freq: 1600, decay: decay * 0.5, volume: noise }] });\nconst swish = (from, to, dur, vol = 0.22) => ({ wave: 'noise', freq: from, freqEnd: to, decay: dur, volume: vol });\nconst clink = (freq, vol = 0.22, decay = 0.08) => ({ wave: 'square', duty: 0.25, freq, decay, volume: vol });\n\nexport const SFX_DEFS = {\n  // The bell is the game's signature.\n  bell_small: bell(880, { vol: 0.26, decay: 0.9 }),\n  bell_mid: bell(330, { vol: 0.3, decay: 1.4 }),\n  bell_big: bell(147, { vol: 0.42, decay: 2.2 }),\n  bell_loot: bell(659, { vol: 0.34, decay: 2.2, bright: 1.4 }),\n  bell_cracked: bell(98, { vol: 0.42, decay: 2.8, cracked: true }),\n  bell_true: bell(73.4, { vol: 0.48, decay: 3.6, bright: 0.8 }),\n  // Combat.\n  swing_heavy: swish(400, 2200, 0.13, 0.2),\n  chain: { wave: 'noise', freq: 5000, freqEnd: 1800, decay: 0.16, volume: 0.15, layers: [clink(1400, 0.08, 0.06), { ...clink(1760, 0.07, 0.05), delay: 0.05 }, { ...clink(1320, 0.06, 0.05), delay: 0.1 }] },\n  hit_flesh: thud(150, 0.4, 0.09, 0.28),\n  hit_bone: { wave: 'square', duty: 0.125, freq: 620, freqEnd: 240, decay: 0.07, volume: 0.22, layers: [{ wave: 'noise', freq: 5000, decay: 0.04, volume: 0.2 }] },\n  hit_stone: { wave: 'triangle', freq: 220, freqEnd: 90, decay: 0.1, volume: 0.4, layers: [{ wave: 'noise', freq: 2500, decay: 0.06, volume: 0.25 }] },\n  hit_metal: { wave: 'square', duty: 0.25, freq: 1100, freqEnd: 900, decay: 0.09, volume: 0.15, layers: [{ wave: 'sine', freq: 2300, decay: 0.12, volume: 0.1 }] },\n  hit_wood: { wave: 'triangle', freq: 300, freqEnd: 140, decay: 0.07, volume: 0.35, layers: [{ wave: 'noise', freq: 1200, decay: 0.04, volume: 0.2 }] },\n  crit: { wave: 'square', duty: 0.25, freq: 1500, freqEnd: 2400, decay: 0.09, volume: 0.13, layers: [{ wave: 'noise', freq: 7000, decay: 0.05, volume: 0.14 }] },\n  shatter: { wave: 'noise', freq: 3200, freqEnd: 700, decay: 0.2, volume: 0.32, layers: [{ wave: 'triangle', freq: 260, freqEnd: 90, decay: 0.12, volume: 0.3 }, { ...clink(980, 0.06, 0.05), delay: 0.04 }, { ...clink(760, 0.06, 0.05), delay: 0.09 }] },\n  blast: thud(120, 0.5, 0.3, 0.4),\n  stone_hit: thud(90, 0.5, 0.22, 0.4),\n  coffin_slam: { wave: 'triangle', freq: 110, freqEnd: 45, decay: 0.3, volume: 0.55, layers: [{ wave: 'noise', freq: 1000, decay: 0.18, volume: 0.35 }, { wave: 'square', duty: 0.5, freq: 70, decay: 0.08, volume: 0.12 }] },\n  whoosh: swish(300, 3000, 0.22, 0.2),\n  whip: swish(5000, 900, 0.1, 0.25),\n  dodge: { ...swish(900, 2400, 0.18, 0.2), layers: [{ wave: 'triangle', freq: 140, freqEnd: 90, decay: 0.08, volume: 0.22, delay: 0.18 }] },\n  charge: { wave: 'saw', freq: 90, freqEnd: 220, decay: 0.3, volume: 0.14, layers: [swish(500, 3000, 0.3, 0.2)] },\n  // Skills.\n  spark: { wave: 'square', duty: 0.125, freq: 1400, freqEnd: 420, decay: 0.1, volume: 0.13, layers: [{ wave: 'noise', freq: 6000, decay: 0.06, volume: 0.1 }] },\n  flare: { wave: 'noise', freq: 7000, freqEnd: 2200, decay: 0.32, volume: 0.28, layers: [{ wave: 'sine', freq: 520, freqEnd: 1700, decay: 0.3, volume: 0.14 }] },\n  lob: swish(600, 1400, 0.2, 0.14),\n  dig: { wave: 'noise', freq: 900, freqEnd: 300, decay: 0.2, volume: 0.3, layers: [{ wave: 'triangle', freq: 130, decay: 0.1, volume: 0.25 }] },\n  blink: { wave: 'sine', freq: 300, freqEnd: 1800, decay: 0.16, volume: 0.2, layers: [{ wave: 'noise', freq: 8000, decay: 0.08, volume: 0.1 }] },\n  snuff: { wave: 'noise', freq: 2500, freqEnd: 200, decay: 0.4, volume: 0.3, layers: [{ wave: 'sine', freq: 200, freqEnd: 60, decay: 0.3, volume: 0.3 }] },\n  beacon: { wave: 'saw', freq: 110, freqEnd: 440, decay: 0.6, volume: 0.12, layers: [{ wave: 'noise', freq: 1800, decay: 0.5, volume: 0.15 }, { wave: 'sine', freq: 440, decay: 0.8, volume: 0.12, delay: 0.3 }] },\n  comet: { wave: 'noise', freq: 1200, freqEnd: 5000, decay: 0.42, volume: 0.14 },\n  raise: { wave: 'triangle', freq: 90, freqEnd: 260, decay: 0.35, volume: 0.28, vibrato: { depth: 2, rate: 12 }, layers: [{ wave: 'noise', freq: 700, decay: 0.3, volume: 0.15 }] },\n  rise: { wave: 'noise', freq: 500, freqEnd: 1100, decay: 0.28, volume: 0.13 },\n  exhume: { wave: 'triangle', freq: 170, freqEnd: 50, decay: 0.3, volume: 0.45, layers: [{ wave: 'noise', freq: 1400, decay: 0.2, volume: 0.28 }] },\n  curse: { wave: 'saw', freq: 220, freqEnd: 110, decay: 0.5, volume: 0.1, vibrato: { depth: 1, rate: 7 }, layers: [{ wave: 'sine', freq: 233, freqEnd: 117, decay: 0.5, volume: 0.14 }] },\n  bone_hit: { wave: 'square', duty: 0.125, freq: 800, freqEnd: 300, decay: 0.08, volume: 0.17, layers: [{ wave: 'noise', freq: 4000, decay: 0.05, volume: 0.16 }] },\n  crossbow: { wave: 'square', duty: 0.25, freq: 520, freqEnd: 260, decay: 0.05, volume: 0.16, layers: [swish(4000, 1200, 0.1, 0.12)] },\n  hymn: { wave: 'sine', freq: 293.7, decay: 1, volume: 0.18, vibrato: { depth: 0.2, rate: 5 }, layers: [{ wave: 'sine', freq: 440, decay: 1, volume: 0.13 }, { wave: 'sine', freq: 587, decay: 1, volume: 0.08, delay: 0.1 }] },\n  fire_start: { wave: 'noise', freq: 1200, freqEnd: 3200, decay: 0.3, volume: 0.18 },\n  // Hazards and monsters.\n  telegraph: { wave: 'square', duty: 0.5, freq: 330, freqEnd: 247, decay: 0.15, volume: 0.09 },\n  telegraph_big: { wave: 'saw', freq: 196, decay: 0.7, volume: 0.12, vibrato: { depth: 0.6, rate: 9 }, layers: [{ wave: 'saw', freq: 207, decay: 0.7, volume: 0.08 }] },\n  wave: { wave: 'sine', freq: 180, freqEnd: 90, decay: 0.5, volume: 0.28, layers: [swish(400, 1200, 0.4, 0.12)] },\n  sour_note: { wave: 'triangle', freq: 466, freqEnd: 440, decay: 0.4, volume: 0.16, vibrato: { depth: 0.5, rate: 6 }, layers: [{ wave: 'triangle', freq: 494, decay: 0.4, volume: 0.1 }] },\n  coins: { wave: 'square', duty: 0.25, freq: 1800, decay: 0.05, volume: 0.1, layers: [{ ...clink(2300, 0.09, 0.05), delay: 0.04 }, { ...clink(1900, 0.09, 0.05), delay: 0.09 }, { ...clink(2500, 0.08, 0.05), delay: 0.13 }, { ...clink(2100, 0.08, 0.05), delay: 0.19 }] },\n  burst_wet: { wave: 'noise', freq: 700, freqEnd: 200, decay: 0.32, volume: 0.42, layers: [{ wave: 'sine', freq: 120, freqEnd: 40, decay: 0.25, volume: 0.4 }] },\n  swell: { wave: 'sine', freq: 80, freqEnd: 240, decay: 0.9, volume: 0.25, vibrato: { depth: 1, rate: 14 } },\n  stone_crack: { wave: 'noise', freq: 1800, freqEnd: 500, decay: 0.2, volume: 0.28, layers: [{ wave: 'square', duty: 0.125, freq: 120, decay: 0.1, volume: 0.1 }] },\n  roar: { wave: 'saw', freq: 90, freqEnd: 60, decay: 0.8, volume: 0.22, vibrato: { depth: 3, rate: 18 }, crush: 8, layers: [{ wave: 'noise', freq: 400, decay: 0.7, volume: 0.2 }] },\n  wing: swish(300, 900, 0.14, 0.15),\n  jackpot: { wave: 'square', duty: 0.25, freq: 660, decay: 0.5, volume: 0.13, arp: [0, 4, 7, 12, 16, 19], arpRate: 0.06, layers: [{ wave: 'sine', freq: 1320, decay: 0.5, volume: 0.1 }] },\n  plate_escape: { wave: 'square', duty: 0.25, freq: 900, freqEnd: 300, decay: 0.3, volume: 0.12, arp: [0, -3, -7], arpRate: 0.08 },\n  boss_death: { wave: 'saw', freq: 200, freqEnd: 30, decay: 1.5, volume: 0.2, crush: 6, layers: [{ wave: 'noise', freq: 600, freqEnd: 100, decay: 1.2, volume: 0.3 }, { wave: 'sine', freq: 100, freqEnd: 30, decay: 1.5, volume: 0.3 }] },\n  // Loot and pickups.\n  gold: { wave: 'square', duty: 0.25, freq: 1760, decay: 0.05, volume: 0.09, layers: [{ ...clink(2640, 0.08, 0.06), delay: 0.04 }] },\n  gold_drop: { ...clink(2100, 0.07, 0.04), layers: [{ ...clink(1700, 0.06, 0.04), delay: 0.05 }] },\n  tallow: { wave: 'sine', freq: 500, freqEnd: 800, decay: 0.18, volume: 0.2, layers: [{ wave: 'sine', freq: 750, freqEnd: 1100, decay: 0.2, volume: 0.1, delay: 0.05 }] },\n  tallow_drop: { wave: 'sine', freq: 300, freqEnd: 150, decay: 0.08, volume: 0.22 },\n  drop_item: { wave: 'triangle', freq: 500, freqEnd: 300, decay: 0.1, volume: 0.24 },\n  drop_rare: { wave: 'triangle', freq: 880, decay: 0.3, volume: 0.18, arp: [0, 7, 12], arpRate: 0.06 },\n  pickup: { wave: 'triangle', freq: 660, freqEnd: 880, decay: 0.08, volume: 0.2 },\n  potion: { wave: 'sine', freq: 300, freqEnd: 700, decay: 0.28, volume: 0.22, vibrato: { depth: 1, rate: 22 }, layers: [{ wave: 'sine', freq: 900, decay: 0.2, volume: 0.1, delay: 0.1 }] },\n  levelup: { wave: 'square', duty: 0.25, freq: 294, decay: 0.7, volume: 0.14, arp: [0, 7, 12, 15, 19, 24], arpRate: 0.09, layers: [bell(587, { vol: 0.2, decay: 1.3 })] },\n  quest: { wave: 'triangle', freq: 440, decay: 0.5, volume: 0.2, arp: [0, 5, 7, 12], arpRate: 0.1 },\n  shrine: { wave: 'sine', freq: 440, decay: 1, volume: 0.18, layers: [{ wave: 'sine', freq: 660, decay: 1, volume: 0.12, delay: 0.12 }, { wave: 'sine', freq: 880, decay: 1, volume: 0.1, delay: 0.24 }] },\n  chest: { wave: 'triangle', freq: 130, freqEnd: 200, decay: 0.2, volume: 0.3, layers: [{ ...clink(900, 0.07, 0.3), delay: 0.14, arp: [0, 4, 7], arpRate: 0.07 }] },\n  lever: { wave: 'square', duty: 0.5, freq: 200, freqEnd: 100, decay: 0.09, volume: 0.2, layers: [{ wave: 'noise', freq: 900, decay: 0.2, volume: 0.15, delay: 0.05 }] },\n  gate: { wave: 'sine', freq: 392, decay: 0.8, volume: 0.15, layers: [{ wave: 'sine', freq: 587, decay: 0.8, volume: 0.1, delay: 0.08 }] },\n  portcullis: { wave: 'noise', freq: 1000, freqEnd: 500, decay: 0.7, volume: 0.22, layers: [{ wave: 'square', duty: 0.125, freq: 60, decay: 0.7, volume: 0.1 }] },\n  spikes: { wave: 'noise', freq: 4000, freqEnd: 1500, decay: 0.09, volume: 0.25, layers: [{ wave: 'square', duty: 0.125, freq: 400, decay: 0.05, volume: 0.1 }] },\n  cart: { wave: 'noise', freq: 300, decay: 0.3, volume: 0.2 },\n  salvage: { wave: 'noise', freq: 3000, freqEnd: 900, decay: 0.2, volume: 0.25, layers: [{ wave: 'triangle', freq: 180, decay: 0.15, volume: 0.25 }] },\n  forge: { wave: 'square', duty: 0.25, freq: 1200, decay: 0.2, volume: 0.13, layers: [{ wave: 'sine', freq: 2400, decay: 0.35, volume: 0.1 }, { wave: 'noise', freq: 2500, decay: 0.08, volume: 0.2 }] },\n  socket: { wave: 'sine', freq: 1100, decay: 0.25, volume: 0.18, layers: [{ wave: 'sine', freq: 1650, decay: 0.25, volume: 0.1 }, { ...clink(2100, 0.06, 0.04) }] },\n  hurt_hero: { wave: 'square', duty: 0.25, freq: 240, freqEnd: 120, decay: 0.12, volume: 0.15, layers: [{ wave: 'noise', freq: 1000, decay: 0.08, volume: 0.15 }] },\n  hero_death: { wave: 'triangle', freq: 220, freqEnd: 55, decay: 1, volume: 0.28, layers: [bell(98, { vol: 0.24, decay: 2, cracked: true })] },\n  revive: { wave: 'sine', freq: 330, freqEnd: 660, decay: 0.4, volume: 0.2, layers: [bell(660, { vol: 0.14, decay: 0.8 })] },\n  // Interface.\n  ui_move: { wave: 'square', duty: 0.25, freq: 660, decay: 0.03, volume: 0.07 },\n  ui_confirm: { wave: 'square', duty: 0.25, freq: 660, decay: 0.09, volume: 0.1, arp: [0, 7], arpRate: 0.04 },\n  ui_back: { wave: 'square', duty: 0.25, freq: 494, freqEnd: 330, decay: 0.08, volume: 0.09 },\n  ui_error: { wave: 'square', duty: 0.5, freq: 150, decay: 0.14, volume: 0.1, layers: [{ wave: 'square', duty: 0.5, freq: 159, decay: 0.14, volume: 0.08 }] },\n  ui_tab: { wave: 'triangle', freq: 523, decay: 0.05, volume: 0.15 },\n  ui_equip: { wave: 'noise', freq: 1600, decay: 0.05, volume: 0.15, layers: [{ wave: 'triangle', freq: 300, freqEnd: 500, decay: 0.08, volume: 0.25 }] },\n  // Footfalls, by floor.\n  step_stone: { wave: 'noise', freq: 1400, decay: 0.03, volume: 0.05 },\n  step_mud: { wave: 'noise', freq: 500, freqEnd: 250, decay: 0.05, volume: 0.07 },\n  step_wood: { wave: 'triangle', freq: 170, decay: 0.03, volume: 0.1 },\n  // Ambience loops.\n  rain_loop: { wave: 'noise', freq: 7000, sustain: 2, decay: 0.01, attack: 0.01, volume: 0.06 },\n  fire_loop: { wave: 'noise', freq: 900, sustain: 1.5, decay: 0.01, attack: 0.01, volume: 0.06 },\n  wind_loop: { wave: 'noise', freq: 300, freqEnd: 700, sustain: 3, decay: 0.01, attack: 0.01, volume: 0.06 },\n  cart_loop: { wave: 'noise', freq: 180, sustain: 0.5, decay: 0.01, attack: 0.01, volume: 0.07 },\n};\n\nconst VOICES = {\n  peat: { f: 90, w: 'saw', noise: 0.15 }, bone: { f: 520, w: 'square', noise: 0.25, clack: true }, skull: { f: 620, w: 'triangle', noise: 0.05, vib: true }, big: { f: 70, w: 'saw', noise: 0.2 },\n  crawl: { f: 900, w: 'square', noise: 0.25 }, bloat: { f: 110, w: 'triangle', noise: 0.15, vib: true }, imp: { f: 480, w: 'saw', noise: 0.2 }, moan: { f: 170, w: 'triangle', noise: 0.08, vib: true }, beast: { f: 75, w: 'saw', noise: 0.3 }, plate: { f: 1200, w: 'square', noise: 0.08 },\n  bursar: { f: 80, w: 'saw', noise: 0.15 }, ambrose: { f: 180, w: 'triangle', noise: 0.06 }, malison: { f: 58, w: 'saw', noise: 0.2, vib: true },\n};\nfor (const [id, v] of Object.entries(VOICES)) {\n  const base = (freq, freqEnd, decay, volume) => ({ wave: v.w, duty: 0.25, freq, freqEnd, decay, volume, ...(v.vib ? { vibrato: { depth: 1, rate: 10 } } : {}), layers: [{ wave: 'noise', freq: freq * 8, decay: decay * 0.5, volume: v.noise }] });\n  SFX_DEFS[`mon_${id}_wake`] = base(v.f, v.f * 1.4, 0.2, 0.11);\n  SFX_DEFS[`mon_${id}_attack`] = base(v.f * 1.5, v.f, 0.13, 0.13);\n  SFX_DEFS[`mon_${id}_hurt`] = base(v.f * 1.3, v.f * 1.8, 0.08, 0.09);\n  SFX_DEFS[`mon_${id}_death`] = base(v.f * 1.2, v.f * 0.4, 0.3, 0.15);\n}\n\n// Skill-specific hero grunts.\nSFX_DEFS.grunt_low = { wave: 'saw', freq: 120, freqEnd: 90, decay: 0.09, volume: 0.1 };\nSFX_DEFS.grunt_mid = { wave: 'saw', freq: 190, freqEnd: 140, decay: 0.08, volume: 0.08 };\n\nexport const SFX_NAMES = Object.keys(SFX_DEFS);\nEOF\ncat > src/data/songs.js <<'EOF'\n// The score, as data. Every piece states or bends the Clemency motif (D minor):\n//   D4 A4 F4 E4 | D4 C4 D4 A3\n// Malison's version is the same notes, one semitone off, because the bell is cracked.\n\n/** 'D4:4 r:4 A4:2' expands to steps: a note, its holds, rests. */\nconst S = (spec) => spec.trim().split(/\\s+/).flatMap((tok) => {\n  const [n, l = '1'] = tok.split(':');\n  const len = Number(l);\n  if (n === 'r') return Array(len).fill('.');\n  return [n, ...Array(len - 1).fill('-')];\n}).join(' ');\nconst rep = (spec, n) => Array(n).fill(spec).join(' ');\n\nconst inst = {\n  bell: { wave: 'sine', attack: 0.002, decay: 2, volume: 0.22, layers: [{ wave: 'sine', freq: 0, decay: 1, volume: 0 }] },\n  organ: { wave: 'square', duty: 0.25, attack: 0.03, decay: 0.2, volume: 0.09 },\n  organ2: { wave: 'square', duty: 0.5, attack: 0.03, decay: 0.2, volume: 0.06 },\n  lead: { wave: 'square', duty: 0.25, attack: 0.005, decay: 0.2, volume: 0.1 },\n  lute: { wave: 'triangle', decay: 0.4, volume: 0.17 },\n  bass: { wave: 'triangle', decay: 0.25, volume: 0.22 },\n  deep: { wave: 'sine', decay: 0.7, volume: 0.28 },\n  stab: { wave: 'saw', decay: 0.14, volume: 0.1 },\n  wind: { wave: 'noise', attack: 0.3, decay: 0.8, volume: 0.03 },\n  snare: { wave: 'noise', decay: 0.09, volume: 0.1 },\n  hat: { wave: 'noise', decay: 0.03, volume: 0.05 },\n  kick: { wave: 'sine', decay: 0.1, volume: 0.3, freqEnd: 40 },\n};\nfor (const k of Object.keys(inst)) { if (inst[k].layers) delete inst[k].layers; if (inst[k].freqEnd) delete inst[k].freqEnd; }\nconst pick = (...ids) => Object.fromEntries(ids.map((i) => [i, inst[i]]));\n\nexport const SONGS = {\n  vespers: { bpm: 60, stepsPerBeat: 2, tracks: pick('bell', 'organ', 'organ2', 'deep'), order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { bell: S('D4:4 A4:4 F4:4 E4:4 D4:4 C4:4 D4:4 A3:4 r:32'), organ: S('r:32 D3:16 C3:8 A2:8'), organ2: S('r:32 A3:16 G3:8 E3:8'), deep: S('D2:16 r:16 D2:16 A1:16') },\n    b: { bell: S('r:16 D5:4 r:12 D4:4 A4:4 F4:4 E4:4 D4:8 r:8'), organ: S('D3:16 F3:16 G3:16 A3:16'), organ2: S('A3:16 C4:16 D4:16 E4:16'), deep: S('D2:16 F2:16 G2:16 A2:16') },\n    c: { bell: S('D5:4 A5:4 F5:4 E5:4 D5:4 C5:4 D5:4 A4:4 D4:16 r:16'), organ: S('D3:8 A3:8 F3:8 E3:8 D3:16 D3:16'), organ2: S('F3:8 C4:8 A3:8 G3:8 F3:16 A3:16'), deep: S('D2:32 D2:16 D2:16') },\n  } },\n  last_lamps: { bpm: 72, tracks: pick('lute', 'lead', 'bass', 'hat'), stepsPerBeat: 2, order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { lute: rep(S('D4 A4 F4 A4 D4 A4 F4 A4'), 2) + ' ' + rep(S('C4 G4 E4 G4 C4 G4 E4 G4'), 1) + ' ' + rep(S('A3 E4 C4 E4 A3 E4 C#4 E4'), 1) + ' ' + rep(S('D4 A4 F4 A4 Bb3 F4 D4 F4'), 2) + ' ' + rep(S('C4 G4 E4 G4 A3 E4 C#4 E4'), 2), lead: S('r:16 D5:4 A4:4 F4:4 E4:4 D4:8 C4:4 D4:4 A3:8 r:8'), bass: S('D3:8 D3:8 C3:8 A2:8 D3:8 Bb2:8 C3:8 A2:8'), hat: rep(S('r:3 C8'), 16) },\n    b: { lute: rep(S('Bb3 F4 D4 F4 Bb3 F4 D4 F4'), 2) + ' ' + rep(S('F3 C4 A3 C4 F3 C4 A3 C4'), 2) + ' ' + rep(S('G3 D4 Bb3 D4 G3 D4 Bb3 D4'), 2) + ' ' + rep(S('A3 E4 C#4 E4 A3 E4 C#4 E4'), 2), lead: S('F5:6 E5:2 D5:8 C5:6 A4:2 F4:8 G4:6 A4:2 Bb4:8 A4:12 r:4'), bass: S('Bb2:16 F2:16 G2:16 A2:16'), hat: rep(S('r:3 C8'), 16) },\n    c: { lute: rep(S('D4 F4 A4 D5 A4 F4 D4 F4'), 4) + ' ' + rep(S('A3 C#4 E4 A4 E4 C#4 A3 C#4'), 2) + ' ' + rep(S('D4 F4 A4 D5 A4 F4 D4 F4'), 2), lead: S('D5:8 A5:8 F5:8 E5:8 D5:8 C5:8 D5:16'), bass: S('D3:16 F3:16 A2:16 D3:16'), hat: rep(S('r:7 C8'), 8) },\n  } },\n  weeping_road: { bpm: 66, stepsPerBeat: 2, tracks: pick('deep', 'organ', 'lead', 'wind'), order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { deep: rep(S('D2:2 r:6'), 8), organ: S('r:32 A3:16 F3:16'), lead: S('r:16 D4:4 r:4 A4:4 r:4 F4:4 r:4 E4:4 r:4 r:16'), wind: S('C4:32 r:8 D4:24') },\n    b: { deep: rep(S('A1:2 r:6'), 4) + ' ' + rep(S('D2:2 r:6'), 4), organ: S('C4:16 A3:16 Bb3:16 A3:16'), lead: S('D4:4 r:4 C4:4 r:4 D4:4 r:4 A3:12 r:32'), wind: S('r:16 E4:32 r:16') },\n    c: { deep: rep(S('D2:1 r:1 D2:1 r:5'), 8), organ: S('D3:32 C3:16 A2:16'), lead: S('r:32 F4:4 E4:4 D4:4 C4:4 D4:16'), wind: S('D4:64') },\n  } },\n  under_gloam: { bpm: 58, stepsPerBeat: 2, tracks: pick('organ', 'organ2', 'bell', 'wind'), order: ['a', 'b', 'c', 'b'], patterns: {\n    a: { organ: S('D3:32 C3:32'), organ2: S('A3:32 G3:32'), bell: S('r:24 A5:8 r:24 D6:8'), wind: S('C3:64') },\n    b: { organ: S('Bb2:32 A2:32'), organ2: S('F3:32 E3:32'), bell: S('r:8 D5:8 r:8 A5:8 r:8 F5:8 r:8 E5:8'), wind: S('r:32 D3:32') },\n    c: { organ: S('D3:16 F3:16 E3:16 A2:16'), organ2: S('A3:16 C4:16 B3:16 E3:16'), bell: S('D6:16 r:16 C6:16 A5:16'), wind: S('C3:32 r:32') },\n  } },\n  cinders: { bpm: 96, tracks: pick('lead', 'bass', 'kick', 'snare', 'stab'), order: ['a', 'a', 'b', 'c'], patterns: {\n    a: { lead: rep(S('D4 r D4 F4 r D4 E4 r'), 8), bass: rep(S('D2 r D2 r D2 r D2 D2'), 6) + ' ' + rep(S('C2 r C2 r C2 r A1 A1'), 2), kick: rep(S('C4 r:3 r:2 C4 r'), 8), snare: rep(S('r:4 C6 r:3'), 8), stab: S('r:32 D4:2 r:6 D4:2 r:6 F4:2 r:6 E4:2 r:6') },\n    b: { lead: S('D5:4 A5:4 F5:4 E5:4 D5:4 C5:4 D5:4 A4:4 D5:2 D5:2 F5:4 E5:4 C5:4 D5:16'), bass: rep(S('Bb1 r Bb1 r F2 r F2 r'), 2) + ' ' + rep(S('G1 r G1 r D2 r D2 r'), 2) + ' ' + rep(S('A1 r A1 r E2 r E2 r'), 4), kick: rep(S('C4 r:3 C4 r:3'), 8), snare: rep(S('r:2 C6 r:3 C6 r'), 8), stab: rep(S('r:7 A3'), 8) },\n    c: { lead: rep(S('A4 r A4 C5 r A4 Bb4 r'), 4) + ' ' + rep(S('D5 r D5 F5 r D5 E5 r'), 4), bass: rep(S('A1 r A1 r A1 r A1 G1'), 4) + ' ' + rep(S('D2 r D2 r D2 r D2 C2'), 4), kick: rep(S('C4 r C4 r:5'), 8), snare: rep(S('r:4 C6 r:2 C6'), 8), stab: S('D4:1 r:15 D4:1 r:15 D4:1 r:15 A3:1 r:15') },\n  } },\n  ledger: { bpm: 126, tracks: pick('lead', 'bass', 'snare', 'stab', 'kick'), order: ['a', 'b', 'a', 'c'], patterns: {\n    // Mock-pompous: a little march, grandly announced, slightly off the point.\n    a: { lead: S('D5:3 D5:1 D5:2 A4:2 F5:3 E5:1 D5:4 C5:3 D5:1 E5:2 C5:2 A4:8 D5:3 D5:1 D5:2 A4:2 F5:3 E5:1 D5:4 C5:2 C5:2 E5:2 C5:2 D5:8 r:16'), bass: rep(S('D3:2 A2:2'), 8) + ' ' + rep(S('D3:2 A2:2'), 8), snare: rep(S('C7 r C7 C7 C7 r C7 r'), 8), stab: rep(S('r:2 F4:1 r:1 r:2 F4:1 r:1'), 8), kick: rep(S('C4 r:7'), 8) },\n    b: { lead: S('Bb4:4 D5:4 F5:4 D5:4 C5:4 E5:4 G5:4 E5:4 D5:4 F5:4 A5:4 F5:4 E5:4 C#5:4 A4:8'), bass: S('Bb2:4 F2:4 Bb2:4 F2:4 C3:4 G2:4 C3:4 G2:4 D3:4 A2:4 D3:4 A2:4 A2:4 E2:4 A2:8'), snare: rep(S('C7 r C7 C7 C7 r C7 r'), 8), stab: rep(S('r:7 D4'), 8), kick: rep(S('C4 r:3 C4 r:3'), 8) },\n    c: { lead: S('D5:2 D5:2 C5:2 C5:2 Bb4:2 Bb4:2 A4:4 G4:2 A4:2 Bb4:2 C5:2 D5:8 D5:2 D5:2 C5:2 C5:2 Bb4:2 Bb4:2 A4:4 G4:2 F4:2 E4:2 C#4:2 D4:8 r:16'), bass: rep(S('D3:2 A2:2'), 16), snare: rep(S('C7 C7 C7 r C7 r C7 r'), 8), stab: S('D4:2 r:30 D4:2 r:30'), kick: rep(S('C4 r:7'), 8) },\n  } },\n  the_climb: { bpm: 104, tracks: pick('lead', 'bass', 'kick', 'hat', 'organ'), order: ['a', 'b', 'c', 'b'], patterns: {\n    a: { lead: rep(S('D4 F4 A4 D5'), 4) + ' ' + rep(S('E4 G4 Bb4 E5'), 4) + ' ' + rep(S('F4 A4 C5 F5'), 4) + ' ' + rep(S('G4 Bb4 D5 G5'), 4), bass: rep(S('D2 r D2 D2'), 4) + ' ' + rep(S('E2 r E2 E2'), 4) + ' ' + rep(S('F2 r F2 F2'), 4) + ' ' + rep(S('G2 r G2 G2'), 4), kick: rep(S('C4 r:3'), 16), hat: rep(S('r C8'), 32), organ: S('D3:16 E3:16 F3:16 G3:16') },\n    b: { lead: S('A4:2 D5:2 A5:4 F5:2 E5:2 D5:4 C5:2 D5:2 A4:4 D5:2 F5:2 A5:4 Bb5:4 A5:4 G5:4 F5:4 E5:4 D5:4 C#5:4 A4:12 r:4'), bass: rep(S('D2 D3'), 8) + ' ' + rep(S('Bb1 Bb2'), 8) + ' ' + rep(S('G1 G2'), 8) + ' ' + rep(S('A1 A2'), 8), kick: rep(S('C4 r:3 C4 r C4 r'), 8), hat: rep(S('r C8'), 32), organ: S('D4:16 Bb3:16 G3:16 A3:16') },\n    c: { lead: rep(S('A4 C5 E5 A5'), 4) + ' ' + rep(S('Bb4 D5 F5 Bb5'), 4) + ' ' + rep(S('C5 E5 G5 C6'), 4) + ' ' + rep(S('D5 F5 A5 D6'), 4), bass: rep(S('A1 r A1 A1'), 4) + ' ' + rep(S('Bb1 r Bb1 Bb1'), 4) + ' ' + rep(S('C2 r C2 C2'), 4) + ' ' + rep(S('D2 r D2 D2'), 4), kick: rep(S('C4 r:3'), 16), hat: rep(S('C8 C8'), 32), organ: S('A3:16 Bb3:16 C4:16 D4:16') },\n  } },\n  // The motif, a semitone off: D#4 A#4 F#4 F4 | D#4 C#4 D#4 A#3.\n  eventide: { bpm: 138, tracks: pick('lead', 'bass', 'kick', 'snare', 'stab', 'organ'), order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { lead: S('D#4:4 A#4:4 F#4:4 F4:4 D#4:4 C#4:4 D#4:4 A#3:4 D#5:4 A#5:4 F#5:4 F5:4 D#5:4 C#5:4 D#5:8'), bass: rep(S('D#2 D#2 r D#2'), 8) + ' ' + rep(S('C#2 C#2 r C#2'), 4) + ' ' + rep(S('A#1 A#1 r A#1'), 4), kick: rep(S('C4 r C4 r'), 16), snare: rep(S('r:4 C6 r:3'), 8), stab: rep(S('D#4 r:3 r:2 D#4 r'), 8), organ: S('D#3:32 C#3:16 A#2:16') },\n    b: { lead: rep(S('F#5:2 F5:2 D#5:2 C#5:2'), 4) + ' ' + rep(S('A#4:2 B4:2 C#5:2 D#5:2'), 4), bass: rep(S('B1 B1 r B1'), 8) + ' ' + rep(S('A#1 A#1 r A#1'), 8), kick: rep(S('C4 r C4 C4'), 16), snare: rep(S('r:2 C6 r:3 C6 r'), 8), stab: S('B3:2 r:14 B3:2 r:14 A#3:2 r:14 A#3:2 r:14'), organ: S('B2:32 A#2:32') },\n    c: { lead: S('D#5:8 F#5:8 A#5:8 C#6:8 A#5:4 F#5:4 D#5:4 C#5:4 D#5:16'), bass: rep(S('D#2 r D#3 r'), 16), kick: rep(S('C4 C4 r C4'), 16), snare: rep(S('r:4 C6 r C6 r'), 8), stab: rep(S('D#4 r D#4 r:5'), 8), organ: S('D#3:64') },\n  } },\n  the_knell: { bpm: 118, tracks: pick('lead', 'bass', 'kick', 'hat', 'snare'), order: ['a', 'b', 'c', 'b'], patterns: {\n    a: { lead: S('D4:2 r:2 A4:2 r:2 F4:2 r:2 E4:2 r:2 D4:2 r:2 C4:2 r:2 D4:2 r:2 A3:2 r:2 r:32'), bass: rep(S('D2 r D2 r D2 D2 r D2'), 8), kick: rep(S('C4 r:3 C4 r:3'), 8), hat: rep(S('r C8'), 32), snare: rep(S('r:4 C6 r:3'), 8) },\n    b: { lead: rep(S('D5 r A4 r F5 r E5 r'), 4) + ' ' + rep(S('C5 r G4 r E5 r D5 r'), 2) + ' ' + rep(S('A4 r E4 r C#5 r A4 r'), 2), bass: rep(S('D2 r D2 r D2 D2 r D2'), 4) + ' ' + rep(S('C2 r C2 r C2 C2 r C2'), 2) + ' ' + rep(S('A1 r A1 r A1 A1 r A1'), 2), kick: rep(S('C4 r C4 r C4 r:3'), 8), hat: rep(S('C8 C8'), 32), snare: rep(S('r:4 C6 r C6 r'), 8) },\n    c: { lead: S('F5:4 E5:4 D5:4 C5:4 Bb4:4 C5:4 D5:8 G5:4 F5:4 E5:4 D5:4 C#5:4 D5:4 E5:8'), bass: rep(S('Bb1 r Bb1 r Bb1 Bb1 r Bb1'), 4) + ' ' + rep(S('G1 r G1 r A1 A1 r A1'), 4), kick: rep(S('C4 r:3 C4 r:3'), 8), hat: rep(S('r C8'), 32), snare: rep(S('r:4 C6 r:3'), 8) },\n  } },\n  // Resolved to major at last.\n  clemency: { bpm: 66, stepsPerBeat: 2, tracks: pick('bell', 'organ', 'organ2', 'lute', 'deep'), order: ['a', 'b', 'c'], patterns: {\n    a: { bell: S('D4:4 A4:4 F#4:4 E4:4 D4:4 C#4:4 D4:4 A3:4 r:32'), organ: S('D3:16 A3:16 D3:16 G3:16'), organ2: S('F#3:16 C#4:16 A3:16 B3:16'), lute: rep(S('D4 F#4 A4 F#4'), 16), deep: S('D2:32 G2:16 A2:16') },\n    b: { bell: S('D5:4 A5:4 F#5:4 E5:4 D5:4 C#5:4 D5:8 r:32'), organ: S('G3:16 D3:16 A3:16 D3:16'), organ2: S('B3:16 F#3:16 C#4:16 F#3:16'), lute: rep(S('G4 B4 D5 B4'), 8) + ' ' + rep(S('A4 C#5 E5 C#5'), 4) + ' ' + rep(S('D4 F#4 A4 F#4'), 4), deep: S('G2:16 D2:16 A2:16 D2:16') },\n    c: { bell: S('D5:8 D6:8 A5:8 F#5:8 E5:8 C#5:8 D5:16'), organ: S('D3:32 A2:16 D3:16'), organ2: S('A3:32 E3:16 F#3:16'), lute: rep(S('D4 A4 F#5 A4'), 16), deep: S('D2:64') },\n  } },\n};\n\n// Variants the game swaps to: Eventide with no drums for the last phase, the Knell with a rising layer.\nconst stripDrums = (s) => ({ ...s, tracks: Object.fromEntries(Object.entries(s.tracks).filter(([k]) => k !== 'kick' && k !== 'snare')), patterns: Object.fromEntries(Object.entries(s.patterns).map(([p, tr]) => [p, Object.fromEntries(Object.entries(tr).filter(([k]) => k !== 'kick' && k !== 'snare'))])) });\nSONGS.eventide_bare = stripDrums(SONGS.eventide);\nSONGS.the_knell_high = {\n  ...SONGS.the_knell,\n  tracks: { ...SONGS.the_knell.tracks, organ: inst.organ },\n  patterns: Object.fromEntries(Object.entries(SONGS.the_knell.patterns).map(([p, tr]) => [p, { ...tr, organ: S('D5:16 C5:16 Bb4:16 A4:16') }])),\n};\n\nexport const ZONE_SONGS = { yard: 'weeping_road', town: 'last_lamps', causeway: 'weeping_road', ossuary: 'under_gloam', cloister: 'cinders', belfry: 'the_climb', pantry: 'under_gloam', knell: 'the_knell', session: 'the_knell' };\nexport const SONG_IDS = Object.keys(SONGS);\nEOF\ncat > src/audio/voice.js <<'EOF'\n// Animalese-style babble: every subtitle becomes a string of syllables. No real speech anywhere.\n// The same line always sounds the same (the mapping is a hash of the letters).\nconst REGISTERS = {\n  low: { base: 95, f1: 400, f2: 900 },\n  mid: { base: 165, f1: 600, f2: 1300 },\n  high: { base: 300, f1: 850, f2: 2000 },\n  demon: { base: 62, f1: 300, f2: 700 },\n};\n\nfunction syllable(reg, i) {\n  const r = REGISTERS[reg];\n  const v = i % 5; // five vowels, four consonants\n  const c = (i * 7) % 4;\n  const vowel = [[1, 1], [1.2, 1.5], [0.8, 1.9], [1.4, 0.8], [0.7, 0.7]][v];\n  const glide = [1.08, 0.94, 1.03, 0.97, 1.12][(i * 3) % 5];\n  const consonant = [{ wave: 'noise', freq: 5200, decay: 0.022, volume: 0.1 }, { wave: 'noise', freq: 1800, decay: 0.03, volume: 0.12 }, { wave: 'square', duty: 0.125, freq: r.base * 3, decay: 0.018, volume: 0.05 }, { wave: 'noise', freq: 3200, decay: 0.012, volume: 0.07 }][c];\n  return {\n    wave: reg === 'demon' ? 'saw' : 'triangle', freq: r.base, freqEnd: r.base * glide, decay: 0.085, attack: 0.004, volume: 0.15,\n    crush: reg === 'demon' ? 9 : 0,\n    layers: [\n      consonant,\n      { wave: 'sine', freq: r.f1 * vowel[0], freqEnd: r.f1 * vowel[0] * glide, decay: 0.08, volume: 0.075 },\n      { wave: 'sine', freq: r.f2 * vowel[1], freqEnd: r.f2 * vowel[1] * glide, decay: 0.065, volume: 0.04 },\n    ],\n  };\n}\n\nexport const SYLLABLES = {};\nfor (const reg of Object.keys(REGISTERS)) {\n  for (let i = 0; i < 20; i++) SYLLABLES[`v_${reg}_${i}`] = syllable(reg, i);\n}\n\nexport const VOICE_STYLES = {\n  narrator: { reg: 'low', pitch: -3, rate: 7, vary: 1, volume: 0.8 },\n  crier: { reg: 'high', pitch: 3, rate: 15, vary: 3, volume: 0.7 },\n  brasse: { reg: 'low', pitch: 2, rate: 11, vary: 2, volume: 1 },\n  ogive: { reg: 'mid', pitch: 5, rate: 6.5, vary: 1, volume: 0.5 },\n  pennywhistle: { reg: 'high', pitch: -2, rate: 12, vary: 4, volume: 0.65 },\n  pyx: { reg: 'mid', pitch: -1, rate: 9, vary: 0.7, volume: 0.65 },\n  ambrose: { reg: 'mid', pitch: -4, rate: 8, vary: 1.5, volume: 0.7 },\n  bursar: { reg: 'demon', pitch: 6, rate: 10, vary: 3, volume: 0.95 },\n  malison: { reg: 'demon', pitch: -1, rate: 6, vary: 2, volume: 1, double: true, echo: true },\n  warden: { reg: 'demon', pitch: 3, rate: 8, vary: 2, volume: 0.9 },\n  bark_low: { reg: 'low', pitch: 3, rate: 13, vary: 2, volume: 0.5 },\n  bark_mid: { reg: 'mid', pitch: 1, rate: 13, vary: 2, volume: 0.5 },\n};\n\nconst hash = (s) => { let h = 7; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h; };\n\n/** A line as a list of syllable plays: { name, pitch, at } with `at` in seconds. Pure. */\nexport function babble(text, style) {\n  const st = VOICE_STYLES[style] ?? VOICE_STYLES.narrator;\n  const out = [];\n  const words = text.split(/(\\s+|[.,:;!?-]+)/).filter(Boolean);\n  let t = 0;\n  const step = 1 / st.rate;\n  const lineHash = hash(text);\n  const asks = /\\?\\s*$/.test(text);\n  let idx = 0, total = 0;\n  for (const w of words) if (/[a-z0-9]/i.test(w)) total += Math.max(1, Math.ceil(w.length / 2));\n  for (const w of words) {\n    if (/^\\s+$/.test(w)) { t += step * 0.35; continue; }\n    if (/^[.,:;!?-]+$/.test(w)) {\n      t += w.includes('.') || w.includes('!') || w.includes('?') ? step * 3 : step * 1.5;\n      continue;\n    }\n    const shout = /!/.test(text.slice(text.indexOf(w), text.indexOf(w) + w.length + 2));\n    for (let i = 0; i < w.length; i += 2) {\n      const pair = w.slice(i, i + 2).toLowerCase();\n      const h = hash(pair);\n      const n = h % 20;\n      let pitch = st.pitch + (((h >> 5) % 100) / 100 - 0.5) * st.vary * 2 + (((lineHash >> (idx % 16)) & 3) - 1.5) * 0.3;\n      if (shout) pitch += 2;\n      if (asks && idx > total - 4) pitch += (idx - (total - 4)) * 1.6;\n      out.push({ name: `v_${st.reg}_${n}`, pitch, at: t, volume: st.volume });\n      if (st.double) out.push({ name: `v_${st.reg}_${n}`, pitch: pitch - 12, at: t + 0.01, volume: st.volume * 0.8 });\n      if (st.echo) out.push({ name: `v_${st.reg}_${n}`, pitch: pitch - 5, at: t + 0.22, volume: st.volume * 0.3 });\n      t += step;\n      idx++;\n    }\n  }\n  out.sort((a, b) => a.at - b.at);\n  return { syllables: out, duration: t };\n}\n\nexport const speakerStyle = (who) => (VOICE_STYLES[who] ? who : 'narrator');\nEOF\ncat > src/audio/audio.js <<'EOF'\n// All sound goes through here: effects with pitch variants and panning, music, voices, ambience.\nimport { Rng, spatialize } from '../../pixel-engine.js';\nimport { SFX_DEFS } from '../data/sfx.js';\nimport { SONGS, ZONE_SONGS } from '../data/songs.js';\nimport { SPEAKERS } from '../data/dialog.js';\nimport { babble, SYLLABLES, VOICE_STYLES } from './voice.js';\n\nconst MUSIC_DEFAULT = 0.1;\nconst FLAG_KEY = 'diabellical:music-init';\n\nexport class AudioSys {\n  constructor(game, ctx) {\n    this.game = game;\n    this.ctx = ctx;\n    this.audio = ctx.audio;\n    this.rng = new Rng('audio');\n    this.lastPlay = new Map();\n    this.queue = [];\n    this.voiceClock = 0;\n    this.voicesVol = 1;\n    this.song = null;\n    this.bossSong = null;\n    this.loops = {};\n    this.speaking = 0;\n    for (const [k, d] of Object.entries(SFX_DEFS)) this.audio.register(k, d);\n    for (const [k, d] of Object.entries(SYLLABLES)) this.audio.register(k, d);\n    this.applyMusicDefault();\n  }\n\n  /** Music at 10% by default, whatever the engine's defaults, and after its Reset too. */\n  applyMusicDefault() {\n    const a = this.audio;\n    let first = true;\n    try { first = !(typeof localStorage !== 'undefined' && localStorage.getItem(FLAG_KEY)); } catch { first = true; }\n    if (first) {\n      a.setVolume('music', MUSIC_DEFAULT);\n      try { if (typeof localStorage !== 'undefined') localStorage.setItem(FLAG_KEY, '1'); } catch { /* storage may be refused */ }\n    }\n    const orig = a.resetVolumes.bind(a);\n    a.resetVolumes = () => { orig(); a.setVolume('music', MUSIC_DEFAULT); };\n  }\n\n  /** Effects: name, and optional x, z for space, pitch, volume. */\n  sfx(name, o = {}) {\n    let id = name;\n    if (name === 'mon_attack' || name === 'mon_wake' || name === 'mon_death') {\n      if (!o.v) return;\n      id = `mon_${o.v}_${name.slice(4)}`;\n    }\n    if (name === 'cast_grunt') { if (this.rng.next() > 0.3) return; id = o.cls === 'bellwarden' ? 'grunt_low' : 'grunt_mid'; }\n    if (!SFX_DEFS[id]) return;\n    const now = this.game.frameTime ?? 0;\n    const last = this.lastPlay.get(id) ?? -1;\n    const gap = id.startsWith('hit_') || id === 'gold' ? 0.045 : 0.03;\n    if (now - last < gap) return;\n    this.lastPlay.set(id, now);\n    let volume = o.volume ?? 1, pan = 0;\n    if (o.x !== undefined && this.game.view) {\n      const cam = this.game.view.cam;\n      const dx = o.x - cam.x, dz = o.z - cam.z;\n      const d = Math.hypot(dx, dz);\n      if (d > 34) return;\n      volume *= Math.min(1, 1.3 - d / 26);\n      pan = Math.max(-0.8, Math.min(0.8, ((dx - dz) * 0.71) / 14));\n    }\n    const pitch = (o.pitch ?? 0) + (o.n ?? 0) + (id.startsWith('bell_true') || id.startsWith('ui_') ? 0 : this.rng.range(-1.2, 1.2));\n    this.audio.play(id, { volume, pitch, pan });\n  }\n\n  // ---- Music --------------------------------------------------------------------------------\n  music(id) {\n    const song = id ? SONGS[id] : null;\n    if (id === this.song) return;\n    this.song = id;\n    this.audio.playMusic(song, id ?? 'none');\n  }\n  zoneChanged(zone) {\n    this.bossSong = null;\n    this.music(ZONE_SONGS[zone.id] ?? 'under_gloam');\n    this.ambience(zone);\n  }\n  bossMusic(id) { if (id) { this.bossSong = id; this.music(id); } }\n  endBoss(zone) { this.bossSong = null; if (zone) this.music(ZONE_SONGS[zone.id] ?? 'under_gloam'); }\n  setDrums(on) { if (this.song === 'eventide' && !on) this.music('eventide_bare'); }\n  knellRising(high) { if (this.song === 'the_knell' && high) this.music('the_knell_high'); }\n\n  ambience(zone) {\n    this.stopAmbience();\n    const b = zone.biome;\n    const want = { yard: ['rain_loop'], causeway: ['rain_loop', 'wind_loop'], cloister: ['fire_loop'], belfry: ['wind_loop'], ossuary: ['wind_loop'], town: ['fire_loop'], pantry: ['wind_loop'] }[b] ?? [];\n    for (const k of want) this.loops[k] = this.audio.loop(k, { volume: 0.55, muffle: k === 'wind_loop' ? 0.6 : 0.2 });\n  }\n  stopAmbience() { for (const v of Object.values(this.loops)) v.stop(); this.loops = {}; }\n  loopAt() { return null; }\n\n  // ---- Voices -------------------------------------------------------------------------------\n  /** Say a line. Later lines replace what is left of the last one. */\n  speak(who, text) {\n    const style = SPEAKERS[who]?.voice ?? (VOICE_STYLES[who] ? who : 'narrator');\n    const { syllables, duration } = babble(text, style);\n    this.queue = syllables.map((s) => ({ ...s }));\n    this.voiceClock = 0;\n    this.speaking = duration;\n    this.lastLine = { who, text, syllables: syllables.map((s) => s.name) };\n    return duration;\n  }\n\n  bark(seat) {\n    if ((this.barkT ?? 0) > (this.game.frameTime ?? 0)) return;\n    this.barkT = (this.game.frameTime ?? 0) + 2;\n    const h = this.game.world?.heroes?.find((o) => o.seat === seat);\n    const cls = h?.cls ?? 'bellwarden';\n    const barks = { bellwarden: ['bark_low', 'Not enough Clangor'], lamplighter: ['bark_mid', 'Not enough Wick'], sexton: ['bark_mid', 'Not enough Tithe'] }[cls] ?? ['bark_mid', 'No'];\n    const { syllables } = babble(barks[1], barks[0]);\n    for (const s of syllables) this.queue.push({ ...s, at: this.voiceClock + s.at });\n  }\n\n  update(realDt) {\n    if (this.queue.length) {\n      this.voiceClock += realDt;\n      while (this.queue.length && this.queue[0].at <= this.voiceClock) {\n        const s = this.queue.shift();\n        this.audio.play(s.name, { pitch: s.pitch, volume: s.volume * this.voicesVol });\n      }\n    }\n    if (this.speaking > 0) this.speaking -= realDt;\n  }\n\n  stopAll() {\n    this.queue.length = 0;\n    this.audio.playMusic(null);\n    this.audio.stopLoops();\n    this.loops = {};\n    this.song = null;\n  }\n}\n\nexport { spatialize };\nEOF\ncat > .scratch/audiocheck.mjs <<'EOF'\nimport { renderSound, parseSong } from '../pixel-engine.js';\nimport { SFX_DEFS } from '../src/data/sfx.js';\nimport { SYLLABLES } from '../src/audio/voice.js';\nimport { SONGS } from '../src/data/songs.js';\nlet bad=0;\nfor (const [k,d] of Object.entries({...SFX_DEFS,...SYLLABLES})) { const s=renderSound(d,22050,1); let p=0; for(let i=0;i<s.length;i++){const v=Math.abs(s[i]); if(v>p)p=v;} if(p<0.005||p>1.0001){bad++;console.log('LEVEL',k,p.toFixed(3));} }\nfor (const [k,s] of Object.entries(SONGS)) { try{ const r=parseSong(s); }catch(e){bad++;console.log('SONG',k,e.message.slice(0,200));} }\nconsole.log('sfx',Object.keys(SFX_DEFS).length,'songs',Object.keys(SONGS).length,'bad',bad);\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/audiocheck.mjs 2>&1 | tail -n 25 | cut -c1-260","description":"Write sound effects, songs, voice system and check them","timeout":120000}}}
