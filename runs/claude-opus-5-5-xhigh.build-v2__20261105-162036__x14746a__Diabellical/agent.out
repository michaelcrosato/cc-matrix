{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkiPUA2vdWZcHRp5VWMa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EkTuAaDW1s536bVCmFcs1Q","name":"Bash","input":{"command":"python3 - <<'EOF'\np='src/data/songs.js'; s=open(p).read()\ns=s.replace(\"E4:2 C#4:2 D4:8 r:16'), bass: rep(S('D3:2 A2:2'), 16)\",\"E4:2 C#4:2 D4:8'), bass: rep(S('D3:2 A2:2'), 16)\")\nopen(p,'w').write(s)\nEOF\ncat > src/save/save.js <<'EOF'\n// Saves: localStorage, versioned JSON, every call in try/catch. Sessions never save.\nimport { SAVE_KEY } from '../data/meta.js';\nimport { newAccount } from '../sim/world.js';\n\nexport const HERO_SLOTS = 3;\n\nexport function emptySave() {\n  return { version: 1, heroes: [null, null, null], guests: {}, account: newAccount(), settings: defaultSettings() };\n}\n\nexport function defaultSettings() {\n  return { glyphs: 'ps', shake: 1, numbers: true, zoom: 1, voices: 1, seenAttract: false };\n}\n\nexport function readSave() {\n  try {\n    if (typeof localStorage === 'undefined') return null;\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const s = JSON.parse(raw);\n    if (s.version !== 1) return null;\n    const blank = emptySave();\n    s.account = { ...blank.account, ...s.account };\n    s.settings = { ...blank.settings, ...s.settings };\n    s.heroes = s.heroes ?? blank.heroes;\n    s.guests = s.guests ?? {};\n    return s;\n  } catch { return null; }\n}\n\nexport function writeSave(save) {\n  try {\n    if (typeof localStorage === 'undefined') return false;\n    localStorage.setItem(SAVE_KEY, JSON.stringify(save));\n    return true;\n  } catch { return false; }\n}\nEOF\ncat > src/ui/glyphs.js <<'EOF'\n// Prompts follow the last input: PlayStation by default, an Xbox option, keycaps and mouse buttons.\nexport const ACTIONS = {\n  // action: [pad button name, keyboard or mouse name]\n  confirm: ['cross', 'ENTER'], back: ['circle', 'ESC'], ctxA: ['square', 'X'], ctxB: ['triangle', 'V'], tabL: ['l1', 'Q'], tabR: ['r1', 'E'],\n  s0: ['cross', 'LMB'], s1: ['square', 'RMB'], s2: ['triangle', '1'], s3: ['circle', '2'], s4: ['r1', '3'], s5: ['r2', '4'],\n  dodge: ['l2', 'SPC'], potion: ['l1', 'Q'], interact: ['cross', 'E'], hero: ['create', 'I'], pause: ['options', 'ESC'], map: ['dup', 'M'], bell: ['ddown', 'T'], equip: ['dleft', 'F'], cycle: ['dright', 'TAB'], labels: ['r3', 'ALT'], move: ['lstick', 'WASD'], aim: ['rstick', 'MOUSE'], skills: ['create', 'K'], join: ['options', ''], more: ['triangle', 'M'],\n};\n\nconst circle = ['..XXXXXXX..', '.X.......X.', 'X.........X', 'X.........X', 'X.........X', 'X.........X', 'X.........X', 'X.........X', 'X.........X', '.X.......X.', '..XXXXXXX..'];\nconst withInner = (inner) => circle.map((r, y) => r.split('').map((c, x) => (inner[y]?.[x] && inner[y][x] !== '.' ? inner[y][x] : c)).join(''));\nconst blank = Array(11).fill('...........');\nconst rowsFrom = (art) => blank.map((_, y) => art[y] ?? '...........');\n\nconst GLYPH_ART = {\n  face_cross: withInner(rowsFrom(['...........', '...........', '...O...O...', '....O.O....', '.....O.....', '.....O.....', '....O.O....', '...O...O...', '...........'])),\n  face_circle: withInner(rowsFrom(['...........', '...........', '....OOO....', '...O...O...', '...O...O...', '...O...O...', '....OOO....', '...........'])),\n  face_square: withInner(rowsFrom(['...........', '...........', '...OOOOO...', '...O...O...', '...O...O...', '...O...O...', '...OOOOO...', '...........'])),\n  face_triangle: withInner(rowsFrom(['...........', '...........', '.....O.....', '....O.O....', '....O.O....', '...O...O...', '...OOOOO...', '...........'])),\n  face_a: withInner(rowsFrom(['...........', '...........', '....OOO....', '...O...O...', '...OOOOO...', '...O...O...', '...O...O...', '...........'])),\n  face_b: withInner(rowsFrom(['...........', '...........', '...OOOO....', '...O...O...', '...OOOO....', '...O...O...', '...OOOO....', '...........'])),\n  face_x: withInner(rowsFrom(['...........', '...........', '...O...O...', '....O.O....', '.....O.....', '....O.O....', '...O...O...', '...........'])),\n  face_y: withInner(rowsFrom(['...........', '...........', '...O...O...', '....O.O....', '.....O.....', '.....O.....', '.....O.....', '...........'])),\n  dup: ['....XXX....', '...XOOOX...', '...XOOOX...', '...XXOXX...', '.XXX.O.XXX.', 'X....O....X', '.XXX...XXX.', '...X...X...', '...X...X...', '...X...X...', '....XXX....'],\n  ddown: ['....XXX....', '...X...X...', '...X...X...', '...X...X...', '.XXX...XXX.', 'X....O....X', '.XXX.O.XXX.', '...XXOXX...', '...XOOOX...', '...XOOOX...', '....XXX....'],\n  dleft: ['....XXX....', '...X...X...', '...X...X...', '.XXX...XXX.', 'XOOO....  X', 'XOOOOOO...X', 'XOOO.....XX', '.XXX...XXX.', '...X...X...', '...X...X...', '....XXX....'],\n  dright: ['....XXX....', '...X...X...', '...X...X...', '.XXX...XXX.', 'X  ....OOOX', 'X...OOOOOOX', 'XX.....OOOX', '.XXX...XXX.', '...X...X...', '...X...X...', '....XXX....'],\n  lmb: ['...XXXXX...', '..XOOX..X..', '.XOOOX...X.', '.XOOOX...X.', '.XOOOX...X.', '.XXXXXXXXX.', '.X.......X.', '.X.......X.', '.X.......X.', '..X.....X..', '...XXXXX...'],\n  rmb: ['...XXXXX...', '..X..XOOX..', '.X...XOOOX.', '.X...XOOOX.', '.X...XOOOX.', '.XXXXXXXXX.', '.X.......X.', '.X.......X.', '.X.......X.', '..X.....X..', '...XXXXX...'],\n  lstick: ['...XXXXX...', '..X.....X..', '.X..OOO..X.', 'X..O...O..X', 'X..O...O..X', 'X..O...O..X', '.X..OOO..X.', '..X.....X..', '...XXXXX...', '...........', '.....L.....'],\n  rstick: ['...XXXXX...', '..X.....X..', '.X..OOO..X.', 'X..O...O..X', 'X..O...O..X', 'X..O...O..X', '.X..OOO..X.', '..X.....X..', '...XXXXX...', '...........', '.....R.....'],\n};\n\n// Colours of the face buttons in each scheme.\nconst PS = { cross: ['face_cross', 'sky'], circle: ['face_circle', 'red'], square: ['face_square', 'plum'], triangle: ['face_triangle', 'lime'] };\nconst XB = { cross: ['face_a', 'lime'], circle: ['face_b', 'red'], square: ['face_x', 'sky'], triangle: ['face_y', 'sand'] };\nconst SHOULDER_PS = { l1: 'L1', r1: 'R1', l2: 'L2', r2: 'R2', options: 'OPT', create: 'CRE', r3: 'R3', l3: 'L3' };\nconst SHOULDER_XB = { l1: 'LB', r1: 'RB', l2: 'LT', r2: 'RT', options: 'MEN', create: 'VIE', r3: 'RS', l3: 'LS' };\n\nexport function glyphWidth(ui, action) {\n  const name = glyphName(ui, action);\n  if (!name) return 0;\n  if (name.key) return name.key.length * 6 + 5;\n  if (name.tag) return name.tag.length * 6 + 3;\n  return 11;\n}\n\nexport function glyphName(ui, action) {\n  const a = ACTIONS[action];\n  if (!a) return null;\n  if (ui.game.input.lastDevice !== 'pad') {\n    if (a[1] === 'LMB') return { art: 'lmb', color: 'white' };\n    if (a[1] === 'RMB') return { art: 'rmb', color: 'white' };\n    return a[1] ? { key: a[1] } : null;\n  }\n  const b = a[0];\n  const scheme = ui.game.settings?.glyphs === 'xbox';\n  if (PS[b]) { const [art, color] = (scheme ? XB : PS)[b]; return { art, color }; }\n  const sh = (scheme ? SHOULDER_XB : SHOULDER_PS)[b];\n  if (sh) return { tag: sh };\n  return { art: b, color: 'white' };\n}\n\n/** Draw a prompt glyph; returns its width. */\nexport function drawGlyph(ui, action, x, y) {\n  const n = glyphName(ui, action);\n  if (!n) return 0;\n  const hud = ui.hud;\n  if (n.key) {\n    const w = n.key.length * 6 + 3;\n    hud.rect(x, y, w, 11, 'white');\n    hud.rect(x + 1, y + 1, w - 2, 9, 'night');\n    ui.text(x + 2, y + 2, n.key, { color: 'white', shadow: false, glyph: true });\n    return w + 2;\n  }\n  if (n.tag) {\n    const w = n.tag.length * 6 + 3;\n    hud.rect(x, y, w, 11, 'mist');\n    ui.text(x + 2, y + 2, n.tag, { color: 'ink', shadow: false, glyph: true });\n    return w + 2;\n  }\n  const art = GLYPH_ART[n.art];\n  hud.sprite(x, y, art, { X: n.color === 'white' ? 'mist' : n.color, O: n.color === 'white' ? 'white' : 'white', L: 'mist', R: 'mist' }, { shadow: false });\n  return 13;\n}\n\nexport const glyphSet = (ui) => (ui.game.input.lastDevice === 'pad' ? (ui.game.settings?.glyphs === 'xbox' ? 'xbox' : 'ps') : 'kbm');\nEOF\ncat > src/ui/ui.js <<'EOF'\n// A small immediate-mode layer on the engine's pixel HUD. Same screens for pad and mouse:\n// direction moves focus to the nearest rectangle that way, hover moves it when the pointer moves.\nimport { drawGlyph } from './glyphs.js';\n\nconst CHAR = 6, LINE = 10;\nexport const FONT_OK = /^[0-9A-Z'\"`‘’“”.,:;\\-+=/()[\\]{}%_!?<>#*@°·&|~^$ ]*$/;\n\nexport class UI {\n  constructor(game, ctx) {\n    this.game = game;\n    this.ctx = ctx;\n    this.hud = ctx.hud;\n    this.focus = null;\n    this.widgets = [];\n    this.drawnText = [];\n    this.frame = 0;\n    this.lastWidgets = [];\n    this.scope = 0;\n  }\n\n  get w() { return this.hud.width; }\n  get h() { return this.hud.height; }\n\n  begin() {\n    this.frame++;\n    this.hud.clear();\n    this.widgets = [];\n    this.drawnText = [];\n    this.tip = null;\n  }\n\n  /** Text, recorded so tests can read the screen. x, y are absolute art pixels from the top left. */\n  text(x, y, str, o = {}) {\n    const s = String(str);\n    const scale = o.scale ?? 1;\n    const w = this.measure(s, scale);\n    let px = x;\n    if (o.align === 'center') px = x - Math.floor(w / 2);\n    if (o.align === 'right') px = x - w;\n    px = Math.floor(px); const py = Math.floor(y);\n    this.hud.text(px, py, s, { color: o.color ?? 'white', scale, shadow: o.shadow ?? 'ink' });\n    if (!o.glyph) this.drawnText.push({ text: s.toUpperCase(), x: px, y: py, w, h: 7 * scale, scale, screen: this.screenTag ?? '' });\n    return w;\n  }\n\n  measure(s, scale = 1) { return Math.max(0, String(s).length * CHAR * scale - scale); }\n\n  wrap(s, maxW, scale = 1) {\n    const maxChars = Math.max(4, Math.floor((maxW + scale) / (CHAR * scale)));\n    const out = [];\n    for (const para of String(s).split('\\n')) {\n      let line = '';\n      for (const word of para.split(/\\s+/)) {\n        if (!word) continue;\n        let wd = word;\n        while (wd.length > maxChars) { if (line) { out.push(line); line = ''; } out.push(wd.slice(0, maxChars)); wd = wd.slice(maxChars); }\n        if (!line) line = wd;\n        else if (line.length + 1 + wd.length <= maxChars) line += ` ${wd}`;\n        else { out.push(line); line = wd; }\n      }\n      if (line) out.push(line);\n      if (!para.trim()) out.push('');\n    }\n    return out;\n  }\n\n  textBlock(x, y, s, maxW, o = {}) {\n    const lines = this.wrap(s, maxW, o.scale ?? 1);\n    const lh = o.lineH ?? LINE * (o.scale ?? 1);\n    lines.forEach((l, i) => this.text(x, y + i * lh, l, o));\n    return lines.length * lh;\n  }\n\n  rect(x, y, w, h, c) { this.hud.rect(Math.floor(x), Math.floor(y), Math.ceil(w), Math.ceil(h), c); }\n\n  panel(x, y, w, h, o = {}) {\n    this.rect(x, y, w, h, o.border ?? 'slate');\n    this.rect(x + 1, y + 1, w - 2, h - 2, o.fill ?? 'ink');\n  }\n\n  sprite(x, y, rows, colors, o = {}) { this.hud.sprite(Math.floor(x), Math.floor(y), rows, colors, { shadow: false, ...o }); }\n\n  glyph(action, x, y) { return drawGlyph(this, action, Math.floor(x), Math.floor(y)); }\n\n  /** A prompt: glyph then label. Returns the width. */\n  prompt(action, label, x, y, o = {}) {\n    const gw = this.glyph(action, x, y - 2);\n    const tw = this.text(x + gw + 1, y, label, { color: o.color ?? 'white' });\n    return gw + tw + 8;\n  }\n\n  /** Footer of prompts along the bottom of a screen. */\n  footer(list) {\n    let x = 14;\n    const y = this.h - 14;\n    for (const [action, label] of list) x += this.prompt(action, label, x, y);\n  }\n\n  // ---- Focusable widgets ------------------------------------------------------------------\n  /** Register a focusable rectangle. Returns { focused, activated, hovered }. */\n  widget(id, x, y, w, h, o = {}) {\n    const rec = { id, x, y, w, h, disabled: !!o.disabled };\n    this.widgets.push(rec);\n    const input = this.game.input.menu;\n    const focused = this.focus === id;\n    let activated = false, alt = false;\n    if (input.pointerMoved && inRect(input.px, input.py, x, y, w, h)) { if (this.focus !== id) this.game.audioSys?.sfx('ui_move'); this.focus = id; }\n    const hovered = inRect(input.px, input.py, x, y, w, h);\n    if (input.click && inRect(input.clickX, input.clickY, x, y, w, h)) { activated = true; this.focus = id; this.clickUsed = true; }\n    if (input.rightClick && inRect(input.clickX, input.clickY, x, y, w, h)) { alt = true; this.focus = id; }\n    if (focused && input.confirm) activated = true;\n    if (activated && o.disabled) { activated = false; this.game.audioSys?.sfx('ui_error'); }\n    return { focused: this.focus === id, activated, hovered, alt };\n  }\n\n  button(id, x, y, w, h, label, o = {}) {\n    const r = this.widget(id, x, y, w, h, o);\n    const f = r.focused;\n    this.rect(x, y, w, h, f ? (o.focusColor ?? 'sand') : 'slate');\n    this.rect(x + 1, y + 1, w - 2, h - 2, f ? 'plum' : o.fill ?? 'ink');\n    const c = o.disabled ? 'slate' : f ? 'white' : o.color ?? 'mist';\n    const sc = o.scale ?? 1;\n    const tx = o.left ? x + 5 : x + Math.floor(w / 2);\n    const ty = y + Math.floor((h - 7 * sc) / 2);\n    this.text(tx, ty, label, { color: c, scale: sc, align: o.left ? 'left' : 'center' });\n    if (r.activated) this.game.audioSys?.sfx('ui_confirm');\n    return r.activated;\n  }\n\n  /** Called after the screen has drawn: move focus for the next frame. */\n  end() {\n    const input = this.game.input.menu;\n    const list = this.widgets.filter((w) => !w.skip);\n    this.lastWidgets = list;\n    if (!list.length) { this.focus = null; return; }\n    if (!list.some((w) => w.id === this.focus)) {\n      this.focus = (this.preferFocus && list.some((w) => w.id === this.preferFocus)) ? this.preferFocus : list[0].id;\n    }\n    this.preferFocus = null;\n    const dir = input.up ? [0, -1] : input.down ? [0, 1] : input.left ? [-1, 0] : input.right ? [1, 0] : null;\n    if (!dir) return;\n    const cur = list.find((w) => w.id === this.focus);\n    const cx = cur.x + cur.w / 2, cy = cur.y + cur.h / 2;\n    let best = null, bs = Infinity;\n    for (const w of list) {\n      if (w === cur) continue;\n      const wx = w.x + w.w / 2, wy = w.y + w.h / 2;\n      const dx = wx - cx, dy = wy - cy;\n      const along = dx * dir[0] + dy * dir[1];\n      if (along <= 1) continue;\n      const across = Math.abs(dx * dir[1]) + Math.abs(dy * dir[0]);\n      const score = along + across * 2.2;\n      if (score < bs) { bs = score; best = w; }\n    }\n    if (best) { this.focus = best.id; this.game.audioSys?.sfx('ui_move'); }\n  }\n}\n\nconst inRect = (px, py, x, y, w, h) => px >= x && px < x + w && py >= y && py < y + h;\nEOF\ncat > src/input/router.js <<'EOF'\n// Everything the player touches. Pads are read per pad (the engine merges them), forwarded through\n// input.send so recordings stay valid. Keyboard and mouse feel native on the same screens.\nimport { BTN, emptyIntent } from '../sim/intents.js';\nimport { usableObjects } from '../sim/objects.js';\nimport { RULES } from '../data/tuning.js';\n\nconst B = { CROSS: 0, CIRCLE: 1, SQUARE: 2, TRIANGLE: 3, L1: 4, R1: 5, L2: 6, R2: 7, CREATE: 8, OPTIONS: 9, L3: 10, R3: 11, UP: 12, DOWN: 13, LEFT: 14, RIGHT: 15, HOME: 16 };\nexport const PAD = B;\nconst DEAD = 0.25;\nconst WALK_KEYS = { up: ['KeyW', 'ArrowUp'], down: ['KeyS', 'ArrowDown'], left: ['KeyA', 'ArrowLeft'], right: ['KeyD', 'ArrowRight'] };\nconst ALL_KEYS = ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space', 'Enter', 'Escape', 'KeyQ', 'KeyE', 'KeyX', 'KeyV', 'KeyT', 'KeyF', 'KeyI', 'KeyC', 'KeyK', 'KeyL', 'KeyM', 'Tab', 'AltLeft', 'AltRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4', 'KeyZ', 'ShiftLeft', 'MouseLeft', 'MouseRight', 'F1', 'Backspace', 'KeyP', 'KeyO', 'KeyY', 'KeyU'];\n// Screen right is (+0.71, -0.71) on the ground; screen up is (-0.71, -0.71).\nconst S = Math.SQRT1_2;\nexport const toWorld = (sx, sy) => [S * sx - S * sy, -S * sx - S * sy];\n\nexport class InputRouter {\n  constructor(game, ctx) {\n    this.game = game;\n    this.ctx = ctx;\n    this.input = ctx.input;\n    this.input.gamepadButtons = {};\n    this.input.gamepadDeadzone = 0.25;\n    for (const k of ['Tab', 'AltLeft', 'AltRight', 'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10']) this.input.preventKeys.add(k);\n    this.lastDevice = 'kbm';\n    this.pads = [];          // per pad state from the last delivered command\n    this.prevPads = [];\n    this.padEdges = [];      // per pad, buttons pressed since the last sim step\n    this.padPressedFrame = [];\n    this.seats = [{ kind: 'kbm', pad: null }]; // seat 0: keyboard/mouse and the first pad to press\n    this.menu = this.emptyMenu();\n    this.repeat = { dir: null, t: 0 };\n    this.pointerPx = -1; this.pointerPy = -1;\n    this.lastPoll = '';\n    this.idleFrames = 0;\n    this.heldFrames = new Map();\n    this.anyInput = false;\n    this.createHeld = [];\n    this.createUsed = [];\n    this.goalMouse = false;\n    this.seenPads = new Set();\n    this.mouseMovedAt = 0;\n    this.leftDown = false;\n  }\n\n  emptyMenu() { return { up: false, down: false, left: false, right: false, confirm: false, back: false, ctxA: false, ctxB: false, tabL: false, tabR: false, pause: false, px: -1, py: -1, pointerMoved: false, click: false, rightClick: false, clickX: -1, clickY: -1, wheel: 0, anyPress: false, skipHeld: false, source: null }; }\n\n  /** Page-side polling: forward pad state as a recorded command when it changes. */\n  pollPads() {\n    if (this.input.playing) return;\n    let raw = null;\n    try { raw = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads() : null; } catch { raw = null; }\n    if (!raw) return;\n    const state = [];\n    for (let i = 0; i < raw.length; i++) {\n      const p = raw[i];\n      if (!p || p.connected === false) { state[i] = null; continue; }\n      const buttons = [];\n      for (let b = 0; b < Math.min(17, p.buttons.length); b++) buttons.push(p.buttons[b].pressed || p.buttons[b].value > 0.4 ? 1 : 0);\n      state[i] = { b: buttons, a: [p.axes[0] ?? 0, p.axes[1] ?? 0, p.axes[2] ?? 0, p.axes[3] ?? 0].map((v) => Math.round(v * 100) / 100) };\n    }\n    const key = JSON.stringify(state);\n    if (key !== this.lastPoll) {\n      this.lastPoll = key;\n      this.input.send({ k: 'pads', pads: state });\n    }\n  }\n\n  /** Once per rendered frame, before the UI. */\n  beginFrame() {\n    const input = this.input;\n    this.pollPads();\n    this.prevPads = this.pads;\n    for (const c of input.commands) {\n      if (c?.k === 'pads') this.pads = c.pads;\n    }\n    const m = this.emptyMenu();\n    this.anyInput = false;\n    // Pads.\n    this.padPressedFrame = [];\n    for (let i = 0; i < this.pads.length; i++) {\n      const p = this.pads[i];\n      if (!p) continue;\n      if (!this.seenPads.has(i)) { this.seenPads.add(i); this.game.onPadSeen?.(i); }\n      const prev = this.prevPads[i];\n      const edges = [];\n      for (let b = 0; b < p.b.length; b++) if (p.b[b] && !(prev?.b?.[b])) edges.push(b);\n      this.padPressedFrame[i] = edges;\n      this.padEdges[i] = [...(this.padEdges[i] ?? []), ...edges];\n      if (edges.length) {\n        this.lastDevice = 'pad';\n        this.anyInput = true;\n        this.game.audioSys?.audio.unlock?.();\n      }\n      const stick = Math.hypot(p.a[0], p.a[1]);\n      const stick2 = Math.hypot(p.a[2], p.a[3]);\n      if (stick > DEAD || stick2 > DEAD || p.b.some((v) => v)) { this.lastDevice = 'pad'; this.anyInput = true; }\n    }\n    // Keyboard.\n    let kbPressed = false;\n    for (const k of ALL_KEYS) if (input.wasPressed(k)) { kbPressed = true; break; }\n    let keyDown = false;\n    for (const k of ALL_KEYS) if (input.isDown(k)) { keyDown = true; break; }\n    if (kbPressed || keyDown) { this.lastDevice = 'kbm'; this.anyInput = true; }\n    // Pointer, in art pixels.\n    const hud = this.ctx.hud;\n    const px = ((input.pointer.x + 1) / 2) * hud.width, py = ((1 - input.pointer.y) / 2) * hud.height;\n    const moved = input.pointer.over && (this.pointerPx < 0 || Math.hypot(px - this.pointerPx, py - this.pointerPy) * (this.game.pxScale ?? 4) > 2);\n    if (moved) { this.pointerPx = px; this.pointerPy = py; this.lastDevice = 'kbm'; this.anyInput = true; }\n    m.px = px; m.py = py; m.pointerMoved = moved;\n    for (const be of input.buttonEvents) {\n      if (be.down === false || be.type === 'up' || be.released) continue;\n      const bx = ((be.x + 1) / 2) * hud.width, by = ((1 - be.y) / 2) * hud.height;\n      if (be.button === 0 || be.button === undefined) m.click = true;\n      else if (be.button === 2) m.rightClick = true;\n      m.clickX = bx; m.clickY = by;\n      this.lastDevice = 'kbm';\n      this.anyInput = true;\n    }\n    if (input.wasPressed('MouseLeft') && !m.click) { m.click = true; m.clickX = px; m.clickY = py; this.anyInput = true; }\n    if (input.wasPressed('MouseRight') && !m.rightClick) { m.rightClick = true; m.clickX = px; m.clickY = py; this.anyInput = true; }\n    m.wheel = input.wheel;\n    if (m.wheel) { this.anyInput = true; }\n    // The game owns the wheel: it zooms only when the Settings range says so.\n    this.wheelNow = input.wheel;\n    input.wheel = 0;\n\n    // Menus: from the keyboard and from whichever pads are allowed.\n    const dirs = { up: false, down: false, left: false, right: false };\n    if (input.wasPressed('ArrowUp', 'KeyW')) dirs.up = true;\n    if (input.wasPressed('ArrowDown', 'KeyS')) dirs.down = true;\n    if (input.wasPressed('ArrowLeft', 'KeyA')) dirs.left = true;\n    if (input.wasPressed('ArrowRight', 'KeyD')) dirs.right = true;\n    if (input.wasPressed('Enter') || input.wasPressed('Space')) m.confirm = true;\n    if (input.wasPressed('Escape')) m.back = true;\n    if (input.wasPressed('KeyX')) m.ctxA = true;\n    if (input.wasPressed('KeyV')) m.ctxB = true;\n    if (input.wasPressed('KeyQ')) m.tabL = true;\n    if (input.wasPressed('KeyE')) m.tabR = true;\n    if (input.wasPressed('Escape')) m.pause = true;\n    if (kbPressed) m.anyPress = true;\n    if (m.click || m.rightClick) m.anyPress = true;\n\n    const menuPads = this.menuPads();\n    let heldDir = null;\n    for (const i of menuPads) {\n      const p = this.pads[i];\n      if (!p) continue;\n      const edges = this.padPressedFrame[i] ?? [];\n      if (edges.includes(B.UP)) dirs.up = true;\n      if (edges.includes(B.DOWN)) dirs.down = true;\n      if (edges.includes(B.LEFT)) dirs.left = true;\n      if (edges.includes(B.RIGHT)) dirs.right = true;\n      if (edges.includes(B.CROSS)) m.confirm = true;\n      if (edges.includes(B.CIRCLE)) m.back = true;\n      if (edges.includes(B.SQUARE)) m.ctxA = true;\n      if (edges.includes(B.TRIANGLE)) m.ctxB = true;\n      if (edges.includes(B.L1)) m.tabL = true;\n      if (edges.includes(B.R1)) m.tabR = true;\n      if (edges.includes(B.OPTIONS) && !p.b[B.CREATE]) m.pause = true;\n      if (edges.length) m.anyPress = true;\n      const ax = p.a[0], ay = p.a[1];\n      if (Math.abs(ay) > 0.6 && Math.abs(ay) >= Math.abs(ax)) heldDir = ay < 0 ? 'up' : 'down';\n      else if (Math.abs(ax) > 0.6) heldDir = ax < 0 ? 'left' : 'right';\n      if (p.b[B.UP]) heldDir = 'up';\n      if (p.b[B.DOWN]) heldDir = 'down';\n      if (p.b[B.LEFT]) heldDir = 'left';\n      if (p.b[B.RIGHT]) heldDir = 'right';\n      if (p.b[B.CROSS] || p.b[B.CIRCLE]) m.skipHeld = true;\n    }\n    if (input.isDown('Enter') || input.isDown('Space') || input.isDown('Escape')) m.skipHeld = true;\n    if (!heldDir) {\n      for (const [d, keys] of Object.entries(WALK_KEYS)) if (input.isDown(...keys)) heldDir = d;\n    }\n    // Stick and key repeat.\n    if (heldDir !== this.repeat.dir) {\n      this.repeat.dir = heldDir;\n      this.repeat.t = 0;\n      if (heldDir && !dirs[heldDir]) dirs[heldDir] = true;\n    } else if (heldDir) {\n      this.repeat.t += 1;\n      if (this.repeat.t > 18 && (this.repeat.t - 18) % 7 === 0) dirs[heldDir] = true;\n    }\n    Object.assign(m, dirs);\n    m.anyPress = m.anyPress || dirs.up || dirs.down || dirs.left || dirs.right;\n    this.menu = m;\n    this.idleFrames = this.anyInput ? 0 : this.idleFrames + 1;\n  }\n\n  menuPads() {\n    const out = [];\n    const owner = this.game.menuSeat ?? null;\n    for (let i = 0; i < this.pads.length; i++) {\n      if (!this.pads[i]) continue;\n      const seat = this.seatOfPad(i);\n      if (owner === null) { if (seat === 0 || seat === -1) out.push(i); }\n      else if (seat === owner || (seat === -1 && owner === 0)) out.push(i);\n    }\n    return out;\n  }\n\n  seatOfPad(i) { return this.seats.findIndex((s) => s.pad === i); }\n\n  /** Seat 0's pad is whichever pad spoke first. */\n  claimSeat0() {\n    if (this.seats[0].pad !== null) return;\n    for (let i = 0; i < this.pads.length; i++) {\n      if (this.pads[i] && (this.padPressedFrame[i] ?? []).length && this.seatOfPad(i) < 0) { this.seats[0].pad = i; return; }\n    }\n  }\n\n  freePadPressedOptions() {\n    for (let i = 0; i < this.pads.length; i++) {\n      if (!this.pads[i] || this.seatOfPad(i) >= 0) continue;\n      if ((this.padPressedFrame[i] ?? []).includes(B.OPTIONS)) return i;\n    }\n    return -1;\n  }\n\n  // ---- Intents ------------------------------------------------------------------------------\n  /** Build the intent for a seat. Called from fixedUpdate. */\n  intentFor(seat, world) {\n    const s = this.seats[seat];\n    const it = emptyIntent();\n    if (!s) return it;\n    const h = world.heroes.find((o) => o.seat === seat);\n    if (!h) return it;\n    if (seat === 0) this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\n\n  kbmIntent(it, h, world) {\n    const input = this.input;\n    const view = this.game.view;\n    let sx = 0, sy = 0;\n    if (input.isDown('KeyD', 'ArrowRight')) sx += 1;\n    if (input.isDown('KeyA', 'ArrowLeft')) sx -= 1;\n    if (input.isDown('KeyW', 'ArrowUp')) sy += 1;\n    if (input.isDown('KeyS', 'ArrowDown')) sy -= 1;\n    if (sx || sy) {\n      const l = Math.hypot(sx, sy);\n      const [mx, mz] = toWorld(sx / l, sy / l);\n      it.mx = mx; it.mz = mz;\n    }\n    // Aim at the pointer whenever it is the last thing used.\n    const usePointer = this.lastDevice === 'kbm' && input.pointer.over;\n    let hoverM = null, hoverO = null;\n    if (usePointer && view) {\n      const g = view.groundAt(input.pointer.x, input.pointer.y);\n      if (g) { it.ax = g[0]; it.az = g[1]; it.aimed = 2; }\n      hoverM = this.game.hudSys?.hover?.monster ?? null;\n      hoverO = this.game.hudSys?.hover?.object ?? null;\n      if (hoverM) it.tgt = hoverM.id;\n    }\n    // Keys.\n    const pressed = (k) => input.consumePress(k);\n    const shift = input.isDown('ShiftLeft', 'ShiftRight');\n    const hold = (code, bit) => { if (input.isDown(code)) it.held |= bit; if (pressed(code)) it.pressed |= bit; };\n    hold('Digit1', BTN.S2); hold('Digit2', BTN.S3); hold('Digit3', BTN.S4); hold('Digit4', BTN.S5);\n    hold('MouseRight', BTN.S1);\n    if (pressed('Space')) it.pressed |= BTN.DODGE;\n    if (pressed('KeyQ')) it.pressed |= BTN.POTION;\n    if (pressed('KeyE')) { it.pressed |= BTN.INTERACT; }\n    if (input.isDown('KeyE')) it.held |= BTN.INTERACT;\n    if (input.isDown('KeyT')) it.held |= BTN.BELL;\n    // Left mouse: on a monster attack it, on a thing use it, on the ground walk. Shift attacks in place.\n    if (input.isDown('MouseLeft')) {\n      if (shift) { it.held |= BTN.S0; }\n      else if (input.consumePress('MouseLeft') || this.leftDown) {\n        this.leftDown = true;\n        if (hoverM && !this.leftWalking) { it.goal = { k: 'attack', id: hoverM.id, slot: 0 }; }\n        else if (hoverO && !this.leftWalking) { it.goal = { k: 'use', id: hoverO.id }; this.leftWalking = false; }\n        else if (it.aimed === 2) {\n          if (!this.leftGoalT || this.leftGoalT < world.t) { it.goal = { k: 'walk', x: it.ax, z: it.az }; this.leftGoalT = world.t + 6; this.leftWalking = true; }\n        }\n      }\n    } else { this.leftDown = false; this.leftWalking = false; }\n  }\n\n  padIntent(it, h, world, i) {\n    const p = this.pads[i];\n    const edges = this.padEdges[i] ?? [];\n    this.padEdges[i] = [];\n    const ax = p.a[0], ay = p.a[1];\n    const mag = Math.hypot(ax, ay);\n    if (mag > DEAD) {\n      const f = Math.min(1, (mag - DEAD) / (1 - DEAD)) / mag;\n      const [mx, mz] = toWorld(ax * f, -ay * f);\n      it.mx = mx; it.mz = mz;\n    }\n    const rx = p.a[2], ry = p.a[3];\n    const rmag = Math.hypot(rx, ry);\n    if (rmag > 0.3) {\n      const [dx, dz] = toWorld(rx, -ry);\n      it.ax = dx; it.az = dz; it.aimed = 1;\n    } else if (this.lastDevice === 'pad') { it.aimed = 0; it.tgt = 0; }\n    const press = (b, bit) => { if (p.b[b]) it.held |= bit; if (edges.includes(b)) it.pressed |= bit; };\n    // Cross: interact if there is something to use and nothing to hit, else the first skill.\n    const near = usableObjects(world, h);\n    const hostile = world.monsters.some((m) => !m.dead && (m.x - h.x) ** 2 + (m.z - h.z) ** 2 < RULES.hostileNear ** 2);\n    const seatKey = i;\n    if (edges.includes(B.CROSS)) {\n      this.crossT = this.crossT ?? [];\n      this.crossT[seatKey] = 0;\n      if (near.length && !hostile) { it.pressed |= BTN.INTERACT; this.crossUse = this.crossUse ?? []; this.crossUse[seatKey] = true; }\n      else if (this.crossUse) this.crossUse[seatKey] = false;\n    }\n    if (p.b[B.CROSS]) {\n      this.crossT = this.crossT ?? [];\n      this.crossT[seatKey] = (this.crossT[seatKey] ?? 0) + 1 / 60;\n      if (this.crossT[seatKey] >= 0.4) {\n        it.held |= BTN.INTERACT;\n        if (near.length && !this.crossFired?.[seatKey]) { it.pressed |= BTN.INTERACT; this.crossFired = this.crossFired ?? []; this.crossFired[seatKey] = true; }\n      }\n      if (!this.crossUse?.[seatKey]) press(B.CROSS, BTN.S0);\n    } else if (this.crossFired) this.crossFired[seatKey] = false;\n    press(B.SQUARE, BTN.S1); press(B.TRIANGLE, BTN.S2); press(B.CIRCLE, BTN.S3); press(B.R1, BTN.S4); press(B.R2, BTN.S5);\n    if (edges.includes(B.L2)) it.pressed |= BTN.DODGE;\n    if (edges.includes(B.L1)) it.pressed |= BTN.POTION;\n    if (p.b[B.DOWN]) it.held |= BTN.BELL;\n  }\n\n  /** Non-sim button actions for a seat, from update. Returns list of action names. */\n  frameActions(seat) {\n    const input = this.input;\n    const out = [];\n    if (seat === 0) {\n      if (input.wasPressed('Escape')) out.push('pause');\n      if (input.wasPressed('KeyI', 'KeyC')) out.push('hero_gear');\n      if (input.wasPressed('KeyK')) out.push('hero_skills');\n      if (input.wasPressed('KeyL')) out.push('hero_quests');\n      if (input.wasPressed('KeyM', 'Tab')) out.push('map');\n      if (input.wasPressed('KeyF')) out.push('equip');\n      if (input.isDown('AltLeft', 'AltRight')) out.push('labels');\n    }\n    const s = this.seats[seat];\n    if (s?.pad !== null && s?.pad !== undefined && this.pads[s.pad]) {\n      const i = s.pad;\n      const p = this.pads[i];\n      const edges = this.padPressedFrame[i] ?? [];\n      const prev = this.prevPads[i];\n      if (edges.includes(B.OPTIONS) && !p.b[B.CREATE]) out.push('pause');\n      if (p.b[B.CREATE]) { if (edges.includes(B.OPTIONS)) { this.createUsed[i] = true; } }\n      if (prev?.b?.[B.CREATE] && !p.b[B.CREATE]) { if (!this.createUsed[i]) out.push('hero_gear'); this.createUsed[i] = false; }\n      if (edges.includes(B.UP)) out.push('map');\n      if (edges.includes(B.LEFT)) out.push('equip');\n      if (edges.includes(B.RIGHT)) out.push('cycle');\n      if (p.b[B.R3]) out.push('labels');\n    }\n    return out;\n  }\n}\nEOF\ngrep -n \"interface ButtonEvent\" -A8 API.md | cut -c1-200; timeout 100 node .scratch/audiocheck.mjs 2>&1 | tail -n 2 | cut -c1-200","description":"Write save, glyphs, UI widgets and input router","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3647,"cache_read_input_tokens":603089,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3647},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"0fcdc110-dbe7-4110-b622-05739de54c9b","timestamp":"2026-11-06T00:20:39.789Z","request_id":"req_011CgkiPTtQyABRwEoXqv1zQ","wire_tool_inputs":{"toolu_01EkTuAaDW1s536bVCmFcs1Q":{"command":"python3 - <<'EOF'\np='src/data/songs.js'; s=open(p).read()\ns=s.replace(\"E4:2 C#4:2 D4:8 r:16'), bass: rep(S('D3:2 A2:2'), 16)\",\"E4:2 C#4:2 D4:8'), bass: rep(S('D3:2 A2:2'), 16)\")\nopen(p,'w').write(s)\nEOF\ncat > src/save/save.js <<'EOF'\n// Saves: localStorage, versioned JSON, every call in try/catch. Sessions never save.\nimport { SAVE_KEY } from '../data/meta.js';\nimport { newAccount } from '../sim/world.js';\n\nexport const HERO_SLOTS = 3;\n\nexport function emptySave() {\n  return { version: 1, heroes: [null, null, null], guests: {}, account: newAccount(), settings: defaultSettings() };\n}\n\nexport function defaultSettings() {\n  return { glyphs: 'ps', shake: 1, numbers: true, zoom: 1, voices: 1, seenAttract: false };\n}\n\nexport function readSave() {\n  try {\n    if (typeof localStorage === 'undefined') return null;\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const s = JSON.parse(raw);\n    if (s.version !== 1) return null;\n    const blank = emptySave();\n    s.account = { ...blank.account, ...s.account };\n    s.settings = { ...blank.settings, ...s.settings };\n    s.heroes = s.heroes ?? blank.heroes;\n    s.guests = s.guests ?? {};\n    return s;\n  } catch { return null; }\n}\n\nexport function writeSave(save) {\n  try {\n    if (typeof localStorage === 'undefined') return false;\n    localStorage.setItem(SAVE_KEY, JSON.stringify(save));\n    return true;\n  } catch { return false; }\n}\nEOF\ncat > src/ui/glyphs.js <<'EOF'\n// Prompts follow the last input: PlayStation by default, an Xbox option, keycaps and mouse buttons.\nexport const ACTIONS = {\n  // action: [pad button name, keyboard or mouse name]\n  confirm: ['cross', 'ENTER'], back: ['circle', 'ESC'], ctxA: ['square', 'X'], ctxB: ['triangle', 'V'], tabL: ['l1', 'Q'], tabR: ['r1', 'E'],\n  s0: ['cross', 'LMB'], s1: ['square', 'RMB'], s2: ['triangle', '1'], s3: ['circle', '2'], s4: ['r1', '3'], s5: ['r2', '4'],\n  dodge: ['l2', 'SPC'], potion: ['l1', 'Q'], interact: ['cross', 'E'], hero: ['create', 'I'], pause: ['options', 'ESC'], map: ['dup', 'M'], bell: ['ddown', 'T'], equip: ['dleft', 'F'], cycle: ['dright', 'TAB'], labels: ['r3', 'ALT'], move: ['lstick', 'WASD'], aim: ['rstick', 'MOUSE'], skills: ['create', 'K'], join: ['options', ''], more: ['triangle', 'M'],\n};\n\nconst circle = ['..XXXXXXX..', '.X.......X.', 'X.........X', 'X.........X', 'X.........X', 'X.........X', 'X.........X', 'X.........X', 'X.........X', '.X.......X.', '..XXXXXXX..'];\nconst withInner = (inner) => circle.map((r, y) => r.split('').map((c, x) => (inner[y]?.[x] && inner[y][x] !== '.' ? inner[y][x] : c)).join(''));\nconst blank = Array(11).fill('...........');\nconst rowsFrom = (art) => blank.map((_, y) => art[y] ?? '...........');\n\nconst GLYPH_ART = {\n  face_cross: withInner(rowsFrom(['...........', '...........', '...O...O...', '....O.O....', '.....O.....', '.....O.....', '....O.O....', '...O...O...', '...........'])),\n  face_circle: withInner(rowsFrom(['...........', '...........', '....OOO....', '...O...O...', '...O...O...', '...O...O...', '....OOO....', '...........'])),\n  face_square: withInner(rowsFrom(['...........', '...........', '...OOOOO...', '...O...O...', '...O...O...', '...O...O...', '...OOOOO...', '...........'])),\n  face_triangle: withInner(rowsFrom(['...........', '...........', '.....O.....', '....O.O....', '....O.O....', '...O...O...', '...OOOOO...', '...........'])),\n  face_a: withInner(rowsFrom(['...........', '...........', '....OOO....', '...O...O...', '...OOOOO...', '...O...O...', '...O...O...', '...........'])),\n  face_b: withInner(rowsFrom(['...........', '...........', '...OOOO....', '...O...O...', '...OOOO....', '...O...O...', '...OOOO....', '...........'])),\n  face_x: withInner(rowsFrom(['...........', '...........', '...O...O...', '....O.O....', '.....O.....', '....O.O....', '...O...O...', '...........'])),\n  face_y: withInner(rowsFrom(['...........', '...........', '...O...O...', '....O.O....', '.....O.....', '.....O.....', '.....O.....', '...........'])),\n  dup: ['....XXX....', '...XOOOX...', '...XOOOX...', '...XXOXX...', '.XXX.O.XXX.', 'X....O....X', '.XXX...XXX.', '...X...X...', '...X...X...', '...X...X...', '....XXX....'],\n  ddown: ['....XXX....', '...X...X...', '...X...X...', '...X...X...', '.XXX...XXX.', 'X....O....X', '.XXX.O.XXX.', '...XXOXX...', '...XOOOX...', '...XOOOX...', '....XXX....'],\n  dleft: ['....XXX....', '...X...X...', '...X...X...', '.XXX...XXX.', 'XOOO....  X', 'XOOOOOO...X', 'XOOO.....XX', '.XXX...XXX.', '...X...X...', '...X...X...', '....XXX....'],\n  dright: ['....XXX....', '...X...X...', '...X...X...', '.XXX...XXX.', 'X  ....OOOX', 'X...OOOOOOX', 'XX.....OOOX', '.XXX...XXX.', '...X...X...', '...X...X...', '....XXX....'],\n  lmb: ['...XXXXX...', '..XOOX..X..', '.XOOOX...X.', '.XOOOX...X.', '.XOOOX...X.', '.XXXXXXXXX.', '.X.......X.', '.X.......X.', '.X.......X.', '..X.....X..', '...XXXXX...'],\n  rmb: ['...XXXXX...', '..X..XOOX..', '.X...XOOOX.', '.X...XOOOX.', '.X...XOOOX.', '.XXXXXXXXX.', '.X.......X.', '.X.......X.', '.X.......X.', '..X.....X..', '...XXXXX...'],\n  lstick: ['...XXXXX...', '..X.....X..', '.X..OOO..X.', 'X..O...O..X', 'X..O...O..X', 'X..O...O..X', '.X..OOO..X.', '..X.....X..', '...XXXXX...', '...........', '.....L.....'],\n  rstick: ['...XXXXX...', '..X.....X..', '.X..OOO..X.', 'X..O...O..X', 'X..O...O..X', 'X..O...O..X', '.X..OOO..X.', '..X.....X..', '...XXXXX...', '...........', '.....R.....'],\n};\n\n// Colours of the face buttons in each scheme.\nconst PS = { cross: ['face_cross', 'sky'], circle: ['face_circle', 'red'], square: ['face_square', 'plum'], triangle: ['face_triangle', 'lime'] };\nconst XB = { cross: ['face_a', 'lime'], circle: ['face_b', 'red'], square: ['face_x', 'sky'], triangle: ['face_y', 'sand'] };\nconst SHOULDER_PS = { l1: 'L1', r1: 'R1', l2: 'L2', r2: 'R2', options: 'OPT', create: 'CRE', r3: 'R3', l3: 'L3' };\nconst SHOULDER_XB = { l1: 'LB', r1: 'RB', l2: 'LT', r2: 'RT', options: 'MEN', create: 'VIE', r3: 'RS', l3: 'LS' };\n\nexport function glyphWidth(ui, action) {\n  const name = glyphName(ui, action);\n  if (!name) return 0;\n  if (name.key) return name.key.length * 6 + 5;\n  if (name.tag) return name.tag.length * 6 + 3;\n  return 11;\n}\n\nexport function glyphName(ui, action) {\n  const a = ACTIONS[action];\n  if (!a) return null;\n  if (ui.game.input.lastDevice !== 'pad') {\n    if (a[1] === 'LMB') return { art: 'lmb', color: 'white' };\n    if (a[1] === 'RMB') return { art: 'rmb', color: 'white' };\n    return a[1] ? { key: a[1] } : null;\n  }\n  const b = a[0];\n  const scheme = ui.game.settings?.glyphs === 'xbox';\n  if (PS[b]) { const [art, color] = (scheme ? XB : PS)[b]; return { art, color }; }\n  const sh = (scheme ? SHOULDER_XB : SHOULDER_PS)[b];\n  if (sh) return { tag: sh };\n  return { art: b, color: 'white' };\n}\n\n/** Draw a prompt glyph; returns its width. */\nexport function drawGlyph(ui, action, x, y) {\n  const n = glyphName(ui, action);\n  if (!n) return 0;\n  const hud = ui.hud;\n  if (n.key) {\n    const w = n.key.length * 6 + 3;\n    hud.rect(x, y, w, 11, 'white');\n    hud.rect(x + 1, y + 1, w - 2, 9, 'night');\n    ui.text(x + 2, y + 2, n.key, { color: 'white', shadow: false, glyph: true });\n    return w + 2;\n  }\n  if (n.tag) {\n    const w = n.tag.length * 6 + 3;\n    hud.rect(x, y, w, 11, 'mist');\n    ui.text(x + 2, y + 2, n.tag, { color: 'ink', shadow: false, glyph: true });\n    return w + 2;\n  }\n  const art = GLYPH_ART[n.art];\n  hud.sprite(x, y, art, { X: n.color === 'white' ? 'mist' : n.color, O: n.color === 'white' ? 'white' : 'white', L: 'mist', R: 'mist' }, { shadow: false });\n  return 13;\n}\n\nexport const glyphSet = (ui) => (ui.game.input.lastDevice === 'pad' ? (ui.game.settings?.glyphs === 'xbox' ? 'xbox' : 'ps') : 'kbm');\nEOF\ncat > src/ui/ui.js <<'EOF'\n// A small immediate-mode layer on the engine's pixel HUD. Same screens for pad and mouse:\n// direction moves focus to the nearest rectangle that way, hover moves it when the pointer moves.\nimport { drawGlyph } from './glyphs.js';\n\nconst CHAR = 6, LINE = 10;\nexport const FONT_OK = /^[0-9A-Z'\"`\\u2018\\u2019\\u201c\\u201d.,:;\\-+=/()[\\]{}%_!?<>#*@°·&|~^$ ]*$/;\n\nexport class UI {\n  constructor(game, ctx) {\n    this.game = game;\n    this.ctx = ctx;\n    this.hud = ctx.hud;\n    this.focus = null;\n    this.widgets = [];\n    this.drawnText = [];\n    this.frame = 0;\n    this.lastWidgets = [];\n    this.scope = 0;\n  }\n\n  get w() { return this.hud.width; }\n  get h() { return this.hud.height; }\n\n  begin() {\n    this.frame++;\n    this.hud.clear();\n    this.widgets = [];\n    this.drawnText = [];\n    this.tip = null;\n  }\n\n  /** Text, recorded so tests can read the screen. x, y are absolute art pixels from the top left. */\n  text(x, y, str, o = {}) {\n    const s = String(str);\n    const scale = o.scale ?? 1;\n    const w = this.measure(s, scale);\n    let px = x;\n    if (o.align === 'center') px = x - Math.floor(w / 2);\n    if (o.align === 'right') px = x - w;\n    px = Math.floor(px); const py = Math.floor(y);\n    this.hud.text(px, py, s, { color: o.color ?? 'white', scale, shadow: o.shadow ?? 'ink' });\n    if (!o.glyph) this.drawnText.push({ text: s.toUpperCase(), x: px, y: py, w, h: 7 * scale, scale, screen: this.screenTag ?? '' });\n    return w;\n  }\n\n  measure(s, scale = 1) { return Math.max(0, String(s).length * CHAR * scale - scale); }\n\n  wrap(s, maxW, scale = 1) {\n    const maxChars = Math.max(4, Math.floor((maxW + scale) / (CHAR * scale)));\n    const out = [];\n    for (const para of String(s).split('\\n')) {\n      let line = '';\n      for (const word of para.split(/\\s+/)) {\n        if (!word) continue;\n        let wd = word;\n        while (wd.length > maxChars) { if (line) { out.push(line); line = ''; } out.push(wd.slice(0, maxChars)); wd = wd.slice(maxChars); }\n        if (!line) line = wd;\n        else if (line.length + 1 + wd.length <= maxChars) line += ` ${wd}`;\n        else { out.push(line); line = wd; }\n      }\n      if (line) out.push(line);\n      if (!para.trim()) out.push('');\n    }\n    return out;\n  }\n\n  textBlock(x, y, s, maxW, o = {}) {\n    const lines = this.wrap(s, maxW, o.scale ?? 1);\n    const lh = o.lineH ?? LINE * (o.scale ?? 1);\n    lines.forEach((l, i) => this.text(x, y + i * lh, l, o));\n    return lines.length * lh;\n  }\n\n  rect(x, y, w, h, c) { this.hud.rect(Math.floor(x), Math.floor(y), Math.ceil(w), Math.ceil(h), c); }\n\n  panel(x, y, w, h, o = {}) {\n    this.rect(x, y, w, h, o.border ?? 'slate');\n    this.rect(x + 1, y + 1, w - 2, h - 2, o.fill ?? 'ink');\n  }\n\n  sprite(x, y, rows, colors, o = {}) { this.hud.sprite(Math.floor(x), Math.floor(y), rows, colors, { shadow: false, ...o }); }\n\n  glyph(action, x, y) { return drawGlyph(this, action, Math.floor(x), Math.floor(y)); }\n\n  /** A prompt: glyph then label. Returns the width. */\n  prompt(action, label, x, y, o = {}) {\n    const gw = this.glyph(action, x, y - 2);\n    const tw = this.text(x + gw + 1, y, label, { color: o.color ?? 'white' });\n    return gw + tw + 8;\n  }\n\n  /** Footer of prompts along the bottom of a screen. */\n  footer(list) {\n    let x = 14;\n    const y = this.h - 14;\n    for (const [action, label] of list) x += this.prompt(action, label, x, y);\n  }\n\n  // ---- Focusable widgets ------------------------------------------------------------------\n  /** Register a focusable rectangle. Returns { focused, activated, hovered }. */\n  widget(id, x, y, w, h, o = {}) {\n    const rec = { id, x, y, w, h, disabled: !!o.disabled };\n    this.widgets.push(rec);\n    const input = this.game.input.menu;\n    const focused = this.focus === id;\n    let activated = false, alt = false;\n    if (input.pointerMoved && inRect(input.px, input.py, x, y, w, h)) { if (this.focus !== id) this.game.audioSys?.sfx('ui_move'); this.focus = id; }\n    const hovered = inRect(input.px, input.py, x, y, w, h);\n    if (input.click && inRect(input.clickX, input.clickY, x, y, w, h)) { activated = true; this.focus = id; this.clickUsed = true; }\n    if (input.rightClick && inRect(input.clickX, input.clickY, x, y, w, h)) { alt = true; this.focus = id; }\n    if (focused && input.confirm) activated = true;\n    if (activated && o.disabled) { activated = false; this.game.audioSys?.sfx('ui_error'); }\n    return { focused: this.focus === id, activated, hovered, alt };\n  }\n\n  button(id, x, y, w, h, label, o = {}) {\n    const r = this.widget(id, x, y, w, h, o);\n    const f = r.focused;\n    this.rect(x, y, w, h, f ? (o.focusColor ?? 'sand') : 'slate');\n    this.rect(x + 1, y + 1, w - 2, h - 2, f ? 'plum' : o.fill ?? 'ink');\n    const c = o.disabled ? 'slate' : f ? 'white' : o.color ?? 'mist';\n    const sc = o.scale ?? 1;\n    const tx = o.left ? x + 5 : x + Math.floor(w / 2);\n    const ty = y + Math.floor((h - 7 * sc) / 2);\n    this.text(tx, ty, label, { color: c, scale: sc, align: o.left ? 'left' : 'center' });\n    if (r.activated) this.game.audioSys?.sfx('ui_confirm');\n    return r.activated;\n  }\n\n  /** Called after the screen has drawn: move focus for the next frame. */\n  end() {\n    const input = this.game.input.menu;\n    const list = this.widgets.filter((w) => !w.skip);\n    this.lastWidgets = list;\n    if (!list.length) { this.focus = null; return; }\n    if (!list.some((w) => w.id === this.focus)) {\n      this.focus = (this.preferFocus && list.some((w) => w.id === this.preferFocus)) ? this.preferFocus : list[0].id;\n    }\n    this.preferFocus = null;\n    const dir = input.up ? [0, -1] : input.down ? [0, 1] : input.left ? [-1, 0] : input.right ? [1, 0] : null;\n    if (!dir) return;\n    const cur = list.find((w) => w.id === this.focus);\n    const cx = cur.x + cur.w / 2, cy = cur.y + cur.h / 2;\n    let best = null, bs = Infinity;\n    for (const w of list) {\n      if (w === cur) continue;\n      const wx = w.x + w.w / 2, wy = w.y + w.h / 2;\n      const dx = wx - cx, dy = wy - cy;\n      const along = dx * dir[0] + dy * dir[1];\n      if (along <= 1) continue;\n      const across = Math.abs(dx * dir[1]) + Math.abs(dy * dir[0]);\n      const score = along + across * 2.2;\n      if (score < bs) { bs = score; best = w; }\n    }\n    if (best) { this.focus = best.id; this.game.audioSys?.sfx('ui_move'); }\n  }\n}\n\nconst inRect = (px, py, x, y, w, h) => px >= x && px < x + w && py >= y && py < y + h;\nEOF\ncat > src/input/router.js <<'EOF'\n// Everything the player touches. Pads are read per pad (the engine merges them), forwarded through\n// input.send so recordings stay valid. Keyboard and mouse feel native on the same screens.\nimport { BTN, emptyIntent } from '../sim/intents.js';\nimport { usableObjects } from '../sim/objects.js';\nimport { RULES } from '../data/tuning.js';\n\nconst B = { CROSS: 0, CIRCLE: 1, SQUARE: 2, TRIANGLE: 3, L1: 4, R1: 5, L2: 6, R2: 7, CREATE: 8, OPTIONS: 9, L3: 10, R3: 11, UP: 12, DOWN: 13, LEFT: 14, RIGHT: 15, HOME: 16 };\nexport const PAD = B;\nconst DEAD = 0.25;\nconst WALK_KEYS = { up: ['KeyW', 'ArrowUp'], down: ['KeyS', 'ArrowDown'], left: ['KeyA', 'ArrowLeft'], right: ['KeyD', 'ArrowRight'] };\nconst ALL_KEYS = ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space', 'Enter', 'Escape', 'KeyQ', 'KeyE', 'KeyX', 'KeyV', 'KeyT', 'KeyF', 'KeyI', 'KeyC', 'KeyK', 'KeyL', 'KeyM', 'Tab', 'AltLeft', 'AltRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4', 'KeyZ', 'ShiftLeft', 'MouseLeft', 'MouseRight', 'F1', 'Backspace', 'KeyP', 'KeyO', 'KeyY', 'KeyU'];\n// Screen right is (+0.71, -0.71) on the ground; screen up is (-0.71, -0.71).\nconst S = Math.SQRT1_2;\nexport const toWorld = (sx, sy) => [S * sx - S * sy, -S * sx - S * sy];\n\nexport class InputRouter {\n  constructor(game, ctx) {\n    this.game = game;\n    this.ctx = ctx;\n    this.input = ctx.input;\n    this.input.gamepadButtons = {};\n    this.input.gamepadDeadzone = 0.25;\n    for (const k of ['Tab', 'AltLeft', 'AltRight', 'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10']) this.input.preventKeys.add(k);\n    this.lastDevice = 'kbm';\n    this.pads = [];          // per pad state from the last delivered command\n    this.prevPads = [];\n    this.padEdges = [];      // per pad, buttons pressed since the last sim step\n    this.padPressedFrame = [];\n    this.seats = [{ kind: 'kbm', pad: null }]; // seat 0: keyboard/mouse and the first pad to press\n    this.menu = this.emptyMenu();\n    this.repeat = { dir: null, t: 0 };\n    this.pointerPx = -1; this.pointerPy = -1;\n    this.lastPoll = '';\n    this.idleFrames = 0;\n    this.heldFrames = new Map();\n    this.anyInput = false;\n    this.createHeld = [];\n    this.createUsed = [];\n    this.goalMouse = false;\n    this.seenPads = new Set();\n    this.mouseMovedAt = 0;\n    this.leftDown = false;\n  }\n\n  emptyMenu() { return { up: false, down: false, left: false, right: false, confirm: false, back: false, ctxA: false, ctxB: false, tabL: false, tabR: false, pause: false, px: -1, py: -1, pointerMoved: false, click: false, rightClick: false, clickX: -1, clickY: -1, wheel: 0, anyPress: false, skipHeld: false, source: null }; }\n\n  /** Page-side polling: forward pad state as a recorded command when it changes. */\n  pollPads() {\n    if (this.input.playing) return;\n    let raw = null;\n    try { raw = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads() : null; } catch { raw = null; }\n    if (!raw) return;\n    const state = [];\n    for (let i = 0; i < raw.length; i++) {\n      const p = raw[i];\n      if (!p || p.connected === false) { state[i] = null; continue; }\n      const buttons = [];\n      for (let b = 0; b < Math.min(17, p.buttons.length); b++) buttons.push(p.buttons[b].pressed || p.buttons[b].value > 0.4 ? 1 : 0);\n      state[i] = { b: buttons, a: [p.axes[0] ?? 0, p.axes[1] ?? 0, p.axes[2] ?? 0, p.axes[3] ?? 0].map((v) => Math.round(v * 100) / 100) };\n    }\n    const key = JSON.stringify(state);\n    if (key !== this.lastPoll) {\n      this.lastPoll = key;\n      this.input.send({ k: 'pads', pads: state });\n    }\n  }\n\n  /** Once per rendered frame, before the UI. */\n  beginFrame() {\n    const input = this.input;\n    this.pollPads();\n    this.prevPads = this.pads;\n    for (const c of input.commands) {\n      if (c?.k === 'pads') this.pads = c.pads;\n    }\n    const m = this.emptyMenu();\n    this.anyInput = false;\n    // Pads.\n    this.padPressedFrame = [];\n    for (let i = 0; i < this.pads.length; i++) {\n      const p = this.pads[i];\n      if (!p) continue;\n      if (!this.seenPads.has(i)) { this.seenPads.add(i); this.game.onPadSeen?.(i); }\n      const prev = this.prevPads[i];\n      const edges = [];\n      for (let b = 0; b < p.b.length; b++) if (p.b[b] && !(prev?.b?.[b])) edges.push(b);\n      this.padPressedFrame[i] = edges;\n      this.padEdges[i] = [...(this.padEdges[i] ?? []), ...edges];\n      if (edges.length) {\n        this.lastDevice = 'pad';\n        this.anyInput = true;\n        this.game.audioSys?.audio.unlock?.();\n      }\n      const stick = Math.hypot(p.a[0], p.a[1]);\n      const stick2 = Math.hypot(p.a[2], p.a[3]);\n      if (stick > DEAD || stick2 > DEAD || p.b.some((v) => v)) { this.lastDevice = 'pad'; this.anyInput = true; }\n    }\n    // Keyboard.\n    let kbPressed = false;\n    for (const k of ALL_KEYS) if (input.wasPressed(k)) { kbPressed = true; break; }\n    let keyDown = false;\n    for (const k of ALL_KEYS) if (input.isDown(k)) { keyDown = true; break; }\n    if (kbPressed || keyDown) { this.lastDevice = 'kbm'; this.anyInput = true; }\n    // Pointer, in art pixels.\n    const hud = this.ctx.hud;\n    const px = ((input.pointer.x + 1) / 2) * hud.width, py = ((1 - input.pointer.y) / 2) * hud.height;\n    const moved = input.pointer.over && (this.pointerPx < 0 || Math.hypot(px - this.pointerPx, py - this.pointerPy) * (this.game.pxScale ?? 4) > 2);\n    if (moved) { this.pointerPx = px; this.pointerPy = py; this.lastDevice = 'kbm'; this.anyInput = true; }\n    m.px = px; m.py = py; m.pointerMoved = moved;\n    for (const be of input.buttonEvents) {\n      if (be.down === false || be.type === 'up' || be.released) continue;\n      const bx = ((be.x + 1) / 2) * hud.width, by = ((1 - be.y) / 2) * hud.height;\n      if (be.button === 0 || be.button === undefined) m.click = true;\n      else if (be.button === 2) m.rightClick = true;\n      m.clickX = bx; m.clickY = by;\n      this.lastDevice = 'kbm';\n      this.anyInput = true;\n    }\n    if (input.wasPressed('MouseLeft') && !m.click) { m.click = true; m.clickX = px; m.clickY = py; this.anyInput = true; }\n    if (input.wasPressed('MouseRight') && !m.rightClick) { m.rightClick = true; m.clickX = px; m.clickY = py; this.anyInput = true; }\n    m.wheel = input.wheel;\n    if (m.wheel) { this.anyInput = true; }\n    // The game owns the wheel: it zooms only when the Settings range says so.\n    this.wheelNow = input.wheel;\n    input.wheel = 0;\n\n    // Menus: from the keyboard and from whichever pads are allowed.\n    const dirs = { up: false, down: false, left: false, right: false };\n    if (input.wasPressed('ArrowUp', 'KeyW')) dirs.up = true;\n    if (input.wasPressed('ArrowDown', 'KeyS')) dirs.down = true;\n    if (input.wasPressed('ArrowLeft', 'KeyA')) dirs.left = true;\n    if (input.wasPressed('ArrowRight', 'KeyD')) dirs.right = true;\n    if (input.wasPressed('Enter') || input.wasPressed('Space')) m.confirm = true;\n    if (input.wasPressed('Escape')) m.back = true;\n    if (input.wasPressed('KeyX')) m.ctxA = true;\n    if (input.wasPressed('KeyV')) m.ctxB = true;\n    if (input.wasPressed('KeyQ')) m.tabL = true;\n    if (input.wasPressed('KeyE')) m.tabR = true;\n    if (input.wasPressed('Escape')) m.pause = true;\n    if (kbPressed) m.anyPress = true;\n    if (m.click || m.rightClick) m.anyPress = true;\n\n    const menuPads = this.menuPads();\n    let heldDir = null;\n    for (const i of menuPads) {\n      const p = this.pads[i];\n      if (!p) continue;\n      const edges = this.padPressedFrame[i] ?? [];\n      if (edges.includes(B.UP)) dirs.up = true;\n      if (edges.includes(B.DOWN)) dirs.down = true;\n      if (edges.includes(B.LEFT)) dirs.left = true;\n      if (edges.includes(B.RIGHT)) dirs.right = true;\n      if (edges.includes(B.CROSS)) m.confirm = true;\n      if (edges.includes(B.CIRCLE)) m.back = true;\n      if (edges.includes(B.SQUARE)) m.ctxA = true;\n      if (edges.includes(B.TRIANGLE)) m.ctxB = true;\n      if (edges.includes(B.L1)) m.tabL = true;\n      if (edges.includes(B.R1)) m.tabR = true;\n      if (edges.includes(B.OPTIONS) && !p.b[B.CREATE]) m.pause = true;\n      if (edges.length) m.anyPress = true;\n      const ax = p.a[0], ay = p.a[1];\n      if (Math.abs(ay) > 0.6 && Math.abs(ay) >= Math.abs(ax)) heldDir = ay < 0 ? 'up' : 'down';\n      else if (Math.abs(ax) > 0.6) heldDir = ax < 0 ? 'left' : 'right';\n      if (p.b[B.UP]) heldDir = 'up';\n      if (p.b[B.DOWN]) heldDir = 'down';\n      if (p.b[B.LEFT]) heldDir = 'left';\n      if (p.b[B.RIGHT]) heldDir = 'right';\n      if (p.b[B.CROSS] || p.b[B.CIRCLE]) m.skipHeld = true;\n    }\n    if (input.isDown('Enter') || input.isDown('Space') || input.isDown('Escape')) m.skipHeld = true;\n    if (!heldDir) {\n      for (const [d, keys] of Object.entries(WALK_KEYS)) if (input.isDown(...keys)) heldDir = d;\n    }\n    // Stick and key repeat.\n    if (heldDir !== this.repeat.dir) {\n      this.repeat.dir = heldDir;\n      this.repeat.t = 0;\n      if (heldDir && !dirs[heldDir]) dirs[heldDir] = true;\n    } else if (heldDir) {\n      this.repeat.t += 1;\n      if (this.repeat.t > 18 && (this.repeat.t - 18) % 7 === 0) dirs[heldDir] = true;\n    }\n    Object.assign(m, dirs);\n    m.anyPress = m.anyPress || dirs.up || dirs.down || dirs.left || dirs.right;\n    this.menu = m;\n    this.idleFrames = this.anyInput ? 0 : this.idleFrames + 1;\n  }\n\n  menuPads() {\n    const out = [];\n    const owner = this.game.menuSeat ?? null;\n    for (let i = 0; i < this.pads.length; i++) {\n      if (!this.pads[i]) continue;\n      const seat = this.seatOfPad(i);\n      if (owner === null) { if (seat === 0 || seat === -1) out.push(i); }\n      else if (seat === owner || (seat === -1 && owner === 0)) out.push(i);\n    }\n    return out;\n  }\n\n  seatOfPad(i) { return this.seats.findIndex((s) => s.pad === i); }\n\n  /** Seat 0's pad is whichever pad spoke first. */\n  claimSeat0() {\n    if (this.seats[0].pad !== null) return;\n    for (let i = 0; i < this.pads.length; i++) {\n      if (this.pads[i] && (this.padPressedFrame[i] ?? []).length && this.seatOfPad(i) < 0) { this.seats[0].pad = i; return; }\n    }\n  }\n\n  freePadPressedOptions() {\n    for (let i = 0; i < this.pads.length; i++) {\n      if (!this.pads[i] || this.seatOfPad(i) >= 0) continue;\n      if ((this.padPressedFrame[i] ?? []).includes(B.OPTIONS)) return i;\n    }\n    return -1;\n  }\n\n  // ---- Intents ------------------------------------------------------------------------------\n  /** Build the intent for a seat. Called from fixedUpdate. */\n  intentFor(seat, world) {\n    const s = this.seats[seat];\n    const it = emptyIntent();\n    if (!s) return it;\n    const h = world.heroes.find((o) => o.seat === seat);\n    if (!h) return it;\n    if (seat === 0) this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\n\n  kbmIntent(it, h, world) {\n    const input = this.input;\n    const view = this.game.view;\n    let sx = 0, sy = 0;\n    if (input.isDown('KeyD', 'ArrowRight')) sx += 1;\n    if (input.isDown('KeyA', 'ArrowLeft')) sx -= 1;\n    if (input.isDown('KeyW', 'ArrowUp')) sy += 1;\n    if (input.isDown('KeyS', 'ArrowDown')) sy -= 1;\n    if (sx || sy) {\n      const l = Math.hypot(sx, sy);\n      const [mx, mz] = toWorld(sx / l, sy / l);\n      it.mx = mx; it.mz = mz;\n    }\n    // Aim at the pointer whenever it is the last thing used.\n    const usePointer = this.lastDevice === 'kbm' && input.pointer.over;\n    let hoverM = null, hoverO = null;\n    if (usePointer && view) {\n      const g = view.groundAt(input.pointer.x, input.pointer.y);\n      if (g) { it.ax = g[0]; it.az = g[1]; it.aimed = 2; }\n      hoverM = this.game.hudSys?.hover?.monster ?? null;\n      hoverO = this.game.hudSys?.hover?.object ?? null;\n      if (hoverM) it.tgt = hoverM.id;\n    }\n    // Keys.\n    const pressed = (k) => input.consumePress(k);\n    const shift = input.isDown('ShiftLeft', 'ShiftRight');\n    const hold = (code, bit) => { if (input.isDown(code)) it.held |= bit; if (pressed(code)) it.pressed |= bit; };\n    hold('Digit1', BTN.S2); hold('Digit2', BTN.S3); hold('Digit3', BTN.S4); hold('Digit4', BTN.S5);\n    hold('MouseRight', BTN.S1);\n    if (pressed('Space')) it.pressed |= BTN.DODGE;\n    if (pressed('KeyQ')) it.pressed |= BTN.POTION;\n    if (pressed('KeyE')) { it.pressed |= BTN.INTERACT; }\n    if (input.isDown('KeyE')) it.held |= BTN.INTERACT;\n    if (input.isDown('KeyT')) it.held |= BTN.BELL;\n    // Left mouse: on a monster attack it, on a thing use it, on the ground walk. Shift attacks in place.\n    if (input.isDown('MouseLeft')) {\n      if (shift) { it.held |= BTN.S0; }\n      else if (input.consumePress('MouseLeft') || this.leftDown) {\n        this.leftDown = true;\n        if (hoverM && !this.leftWalking) { it.goal = { k: 'attack', id: hoverM.id, slot: 0 }; }\n        else if (hoverO && !this.leftWalking) { it.goal = { k: 'use', id: hoverO.id }; this.leftWalking = false; }\n        else if (it.aimed === 2) {\n          if (!this.leftGoalT || this.leftGoalT < world.t) { it.goal = { k: 'walk', x: it.ax, z: it.az }; this.leftGoalT = world.t + 6; this.leftWalking = true; }\n        }\n      }\n    } else { this.leftDown = false; this.leftWalking = false; }\n  }\n\n  padIntent(it, h, world, i) {\n    const p = this.pads[i];\n    const edges = this.padEdges[i] ?? [];\n    this.padEdges[i] = [];\n    const ax = p.a[0], ay = p.a[1];\n    const mag = Math.hypot(ax, ay);\n    if (mag > DEAD) {\n      const f = Math.min(1, (mag - DEAD) / (1 - DEAD)) / mag;\n      const [mx, mz] = toWorld(ax * f, -ay * f);\n      it.mx = mx; it.mz = mz;\n    }\n    const rx = p.a[2], ry = p.a[3];\n    const rmag = Math.hypot(rx, ry);\n    if (rmag > 0.3) {\n      const [dx, dz] = toWorld(rx, -ry);\n      it.ax = dx; it.az = dz; it.aimed = 1;\n    } else if (this.lastDevice === 'pad') { it.aimed = 0; it.tgt = 0; }\n    const press = (b, bit) => { if (p.b[b]) it.held |= bit; if (edges.includes(b)) it.pressed |= bit; };\n    // Cross: interact if there is something to use and nothing to hit, else the first skill.\n    const near = usableObjects(world, h);\n    const hostile = world.monsters.some((m) => !m.dead && (m.x - h.x) ** 2 + (m.z - h.z) ** 2 < RULES.hostileNear ** 2);\n    const seatKey = i;\n    if (edges.includes(B.CROSS)) {\n      this.crossT = this.crossT ?? [];\n      this.crossT[seatKey] = 0;\n      if (near.length && !hostile) { it.pressed |= BTN.INTERACT; this.crossUse = this.crossUse ?? []; this.crossUse[seatKey] = true; }\n      else if (this.crossUse) this.crossUse[seatKey] = false;\n    }\n    if (p.b[B.CROSS]) {\n      this.crossT = this.crossT ?? [];\n      this.crossT[seatKey] = (this.crossT[seatKey] ?? 0) + 1 / 60;\n      if (this.crossT[seatKey] >= 0.4) {\n        it.held |= BTN.INTERACT;\n        if (near.length && !this.crossFired?.[seatKey]) { it.pressed |= BTN.INTERACT; this.crossFired = this.crossFired ?? []; this.crossFired[seatKey] = true; }\n      }\n      if (!this.crossUse?.[seatKey]) press(B.CROSS, BTN.S0);\n    } else if (this.crossFired) this.crossFired[seatKey] = false;\n    press(B.SQUARE, BTN.S1); press(B.TRIANGLE, BTN.S2); press(B.CIRCLE, BTN.S3); press(B.R1, BTN.S4); press(B.R2, BTN.S5);\n    if (edges.includes(B.L2)) it.pressed |= BTN.DODGE;\n    if (edges.includes(B.L1)) it.pressed |= BTN.POTION;\n    if (p.b[B.DOWN]) it.held |= BTN.BELL;\n  }\n\n  /** Non-sim button actions for a seat, from update. Returns list of action names. */\n  frameActions(seat) {\n    const input = this.input;\n    const out = [];\n    if (seat === 0) {\n      if (input.wasPressed('Escape')) out.push('pause');\n      if (input.wasPressed('KeyI', 'KeyC')) out.push('hero_gear');\n      if (input.wasPressed('KeyK')) out.push('hero_skills');\n      if (input.wasPressed('KeyL')) out.push('hero_quests');\n      if (input.wasPressed('KeyM', 'Tab')) out.push('map');\n      if (input.wasPressed('KeyF')) out.push('equip');\n      if (input.isDown('AltLeft', 'AltRight')) out.push('labels');\n    }\n    const s = this.seats[seat];\n    if (s?.pad !== null && s?.pad !== undefined && this.pads[s.pad]) {\n      const i = s.pad;\n      const p = this.pads[i];\n      const edges = this.padPressedFrame[i] ?? [];\n      const prev = this.prevPads[i];\n      if (edges.includes(B.OPTIONS) && !p.b[B.CREATE]) out.push('pause');\n      if (p.b[B.CREATE]) { if (edges.includes(B.OPTIONS)) { this.createUsed[i] = true; } }\n      if (prev?.b?.[B.CREATE] && !p.b[B.CREATE]) { if (!this.createUsed[i]) out.push('hero_gear'); this.createUsed[i] = false; }\n      if (edges.includes(B.UP)) out.push('map');\n      if (edges.includes(B.LEFT)) out.push('equip');\n      if (edges.includes(B.RIGHT)) out.push('cycle');\n      if (p.b[B.R3]) out.push('labels');\n    }\n    return out;\n  }\n}\nEOF\ngrep -n \"interface ButtonEvent\" -A8 API.md | cut -c1-200; timeout 100 node .scratch/audiocheck.mjs 2>&1 | tail -n 2 | cut -c1-200","description":"Write save, glyphs, UI widgets and input router","timeout":120000}}}
