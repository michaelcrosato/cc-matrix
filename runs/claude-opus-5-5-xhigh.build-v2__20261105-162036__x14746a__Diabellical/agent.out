{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgE7teBXGutZPU4xUdo","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14847,"cache_read_input_tokens":353393,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14847},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"3b1ffd44-e7e4-4be9-8a94-12e7afc671b9","timestamp":"2026-11-05T23:50:27.635Z","request_id":"req_011CgkgE7ZoHSC5NJVaYt1tD","thinking_duration_ms":36888,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgE7teBXGutZPU4xUdo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LPqtYqxrLvnfcQi83DYBAX","name":"Bash","input":{"command":"cat > src/data/lore.js <<'EOF'\n// Twelve lore books, read aloud and kept in the Codex. Pages are short: one job per screen.\nexport const LORE = {\n  third_night: { title: 'THE THIRD NIGHT', pages: ['THE GRAVES IN THE NEW YARD ARE EMPTY. THE GRAVES IN THE OLD YARD ARE EMPTY. I HAVE BEGUN DIGGING ONE FOR MYSELF, FOR THE COMPANY.'] },\n  parish_notice: { title: 'A PARISH NOTICE', pages: ['BY ORDER OF THE VESTRY: THE RECENTLY DECEASED ARE REMINDED THAT THEY REMAIN LIABLE FOR PEW RENT.', 'THE VESTRY REGRETS IT IS UNABLE TO HEAR COMPLAINTS AT THIS TIME. THE VESTRY IS EATING ITSELF.'] },\n  road_tolls: { title: 'ROAD TOLLS OF THE CAUSEWAY', pages: ['ONE PENNY FOR A CART. TWO FOR A CORPSE. THE DROWNED GO FREE, AS THEY ARE NOT, STRICTLY, ON THE ROAD.'] },\n  cellar_list: { title: \"THE CELLARER'S LIST\", pages: ['SIXTY BARRELS OF PICKLED HERRING. FORTY OF SMALL BEER. ONE MONK, WHO SAID HE WOULD ONLY BE A MOMENT.'] },\n  gloam_life: { title: 'THE LIFE OF SAINT GLOAM', pages: ['SAINT GLOAM WAS MARTYRED BY BEING TOLD, AT LENGTH, ABOUT HIS BROTHER. HIS BONES ARE SAID TO CURE BOREDOM.', 'THERE ARE ELEVEN HANDS IN THE OSSUARY ATTRIBUTED TO HIM. THE ORDER CONSIDERS THIS A MIRACLE.'] },\n  bearers_rule: { title: \"THE PALLBEARERS' RULE\", pages: ['CARRY LEVEL. CARRY QUIET. DO NOT STOP FOR THE DEAD MAN, HOWEVER HE ASKS.'] },\n  counting_note: { title: 'A NOTE IN THE MARGIN', pages: ['THE BURSAR IS OWED FOUR HUNDRED SOULS AND A SMALL GOAT. HE HAS NEVER ONCE ASKED ABOUT THE GOAT. THIS FRIGHTENS ME MORE.'] },\n  bishops_ledger: { title: \"THE BISHOP'S ACCOUNT\", pages: ['DEBTOR: AMBROSE, BISHOP OF VESPERMOOR. SECURED AGAINST: ONE GREAT BELL, CRACKED IN FULL AND FINAL SETTLEMENT.', 'THE HAND IS HIS. THE RECEIPT IS DATED FORTY DAYS AGO. THE INK IS STILL WET.'] },\n  novices_hymn: { title: \"A NOVICE'S COPYBOOK\", pages: ['SISTER SAYS WE MUST SING LOUDER, SO THE FIRE KNOWS WE ARE STILL HERE. SISTER SAYS THIS LIKE IT IS GOOD NEWS.'] },\n  foundation_stone: { title: 'THE FOUNDATION STONE', pages: ['THE FIRST BISHOPS NEEDED A BELL THAT WOULD HOLD THE DEAD DOWN. THEY WERE TOLD IT WOULD REQUIRE A SACRIFICE WILLING TO SING.', 'THEY FOUND A SACRIFICE. THEY WERE WRONG ABOUT THE WILLING.'] },\n  ringers_oath: { title: \"THE RINGERS' OATH\", pages: ['RING TRUE. RING ON THE HOUR. AND IF THE ROPE BEGINS TO PULL BACK, LET GO, AND TELL NO ONE WHAT YOU HEARD.'] },\n  last_entry: { title: 'THE LAST ENTRY', pages: ['IT IS LOUDER UP HERE. I CAN HEAR HER COUNTING. SHE HAS REACHED THE YEAR OF MY BIRTH.'] },\n};\nexport const LORE_IDS = Object.keys(LORE);\nexport const LORE_PLACES = {\n  'yard:0': 'third_night', 'town:0': 'parish_notice', 'causeway:0': 'road_tolls', 'pantry:0': 'cellar_list',\n  'ossuary:0': 'gloam_life', 'ossuary:1': 'bearers_rule', 'ossuary:2': 'counting_note', 'cloister:0': 'novices_hymn',\n  'belfry:0': 'foundation_stone', 'belfry:1': 'ringers_oath', 'belfry:2': 'last_entry',\n};\n// The twelfth, bishops_ledger, is taken from the Bursar's body.\n\nexport const HOW_TO_PLAY = [\n  { title: 'MOVING AND FIGHTING', lines: ['MOVE WITH THE LEFT STICK, WASD, OR A CLICK ON THE GROUND.', 'YOUR SKILLS ARE ON THE FACE BUTTONS, R1 AND R2, OR THE MOUSE AND 1 TO 4.', 'ROLL THROUGH ANY RED RING. YOU CANNOT BE HIT WHILE ROLLING.', 'YOUR POTION IS ALWAYS THERE. IT JUST TAKES 30 SECONDS TO FORGIVE YOU.', 'THE DEAD DROP TALLOW. WALK OVER IT TO MELT YOUR CANDLE BACK.'] },\n  { title: 'SKILLS AND TONES', lines: ['SIX SLOTS, EIGHT SKILLS, ANY SKILL IN ANY SLOT.', 'EVERY SKILL HAS THREE TONES THAT CHANGE HOW IT WORKS.', 'SWAPPING IS FREE AND INSTANT, SO TRY THINGS.', 'AT LEVEL 5 AND LEVEL 15 YOU SWEAR A VOW. YOU MAY UNSWEAR IT. NOBODY IS WATCHING.'] },\n  { title: 'LOOT', lines: ['WHITE IS COMMON. BLUE IS BLESSED. YELLOW IS RELIQUARY.', 'ORANGE IS LEGENDARY AND GREEN IS A SET. BOTH RING A BELL WHEN THEY FALL.', 'YOU WALK OVER ITEMS TO TAKE THEM. WHEN ONE IS BETTER, A PROMPT OFFERS TO EQUIP IT.', 'LOOT IS PERSONAL. NOBODY CAN TAKE WHAT FELL FOR YOU.'] },\n  { title: 'TOWN', lines: ['PENNYWHISTLE BUYS, SELLS AND SELLS MYSTERY CASKETS.', 'DAME BRASSE SALVAGES, CRAFTS AND REFORGES.', 'MOTHER OGIVE EXTRACTS LEGENDARY POWERS AND SETS GEMS.', 'THE COLLECTION BOX IS SHARED BY ALL YOUR HEROES.', 'THE KNELL FONT CHANGES THE DIFFICULTY AND OPENS KNELL RUNS.'] },\n  { title: 'KNELL RUNS', lines: ['AFTER THE STORY, THE KNELL FONT OPENS RANDOM DUNGEONS.', 'KILLS FILL THE KNELL METER. AT THE TOP A WARDEN CRASHES DOWN.', 'WARDENS PAY IN LEGENDARIES AND SOMETIMES A GRAND KEY.', 'A GRAND KEY OPENS A TIMED RUN AT A TIER YOU CHOOSE.', 'PAST LEVEL 30, XP BECOMES DEVOTION, SHARED BY ALL YOUR HEROES.'] },\n  { title: 'CO-OP', lines: ['A SECOND PAD PRESSES OPTIONS TO JOIN, ANY TIME. UP TO FOUR ON ONE SCREEN.', 'EACH PLAYER HAS THEIR OWN LOOT AND THEIR OWN HERO SCREEN.', 'HOLD INTERACT OVER A FALLEN FRIEND FOR TWO SECONDS TO BRING THEM BACK.', 'THROUGH AI HUB, UP TO FOUR PLAY ONE KNELL RUN TOGETHER ONLINE.'] },\n];\nEOF\ncat > src/data/dialog.js <<'EOF'\n// Who speaks, how they sound, and what they say. Lines fit two rows of about 60 characters.\nexport const NPC_LABELS = { crier: 'CRIER MAUDLIN', brasse: 'DAME BRASSE', ogive: 'MOTHER OGIVE', pennywhistle: 'PENNYWHISTLE', pyx: 'SISTER PYX', ambrose: 'BISHOP AMBROSE' };\nexport const SPEAKERS = {\n  narrator: { name: '', color: 'mist', voice: 'narrator' },\n  crier: { name: 'CRIER MAUDLIN', color: 'sand', voice: 'crier' },\n  brasse: { name: 'DAME BRASSE', color: 'orange', voice: 'brasse' },\n  ogive: { name: 'MOTHER OGIVE', color: 'lime', voice: 'ogive' },\n  pennywhistle: { name: 'PENNYWHISTLE', color: 'sky', voice: 'pennywhistle' },\n  pyx: { name: 'SISTER PYX', color: 'white', voice: 'pyx' },\n  ambrose: { name: 'BISHOP AMBROSE', color: 'mist', voice: 'ambrose' },\n  bursar: { name: 'THE BURSAR', color: 'red', voice: 'bursar' },\n  malison: { name: 'MALISON', color: 'red', voice: 'malison' },\n  cellarer: { name: 'THE CELLARER', color: 'teal', voice: 'brasse' },\n};\n\nexport const BARKS = {\n  crier: ['Hear ye, hear ye! The dead are up, the roads are closed, and the fish is off.', 'I lost the body at harvest and kept the job. No one told me to stop.', 'The parish asks that you wipe your feet. You have been in the ground.', 'Hear ye! The Vestry has resolved to do nothing, with vigour.'],\n  brasse: ['WHAT? SPEAK UP! I MELT BELLS FOR A LIVING!', 'THAT SWORD WAS A CHURCH BELL ON TUESDAY. HIT SOMETHING WITH IT AND IT STILL SAYS AMEN.', 'DO NOT TOUCH THAT. IT IS HOT. EVERYTHING IS HOT.'],\n  ogive: ['Bring me the holy bones, child. I will know them by the taste.', \"A saint's knuckle. Very old. A little salty. She died angry.\", 'Come closer. I do not bite the living. As a rule.'],\n  pennywhistle: ['Everything is half price, dear friend. The other half is your soul, but we can discuss terms.', 'No refunds. No returns. No survivors, so far.', 'Modest markups, considering the apocalypse.'],\n  pyx: ['I have killed four hundred things today and confessed to none of them.', 'You smell like a grave. It is an improvement on the last one.'],\n  ambrose: ['They have buried me three times, my child. One learns to keep a spade in the coffin.'],\n};\n\n// Fixed story talks. key: `${npc}:${quest}.${step}`. Each line is [speaker, text].\nexport const TALKS = {\n  'crier:wipe_feet.crier': [\n    ['crier', 'Hear ye, hear ye! The dead are up, the roads are closed, and the fish is off. Also you. You are dead. Welcome back.'],\n    ['crier', 'I lost the body at harvest and kept the job. No one told me to stop.'],\n    ['crier', 'You are one of the Late. Formally, the Tollborn. The parish asks that you wipe your feet.'],\n    ['crier', 'The Great Bell cracked and the Bishop sends no word. A bellfounder might know why. Dame Brasse is out on the Causeway.'],\n    ['crier', 'Take the road gate. Fetch her back, wagon and all. And if you find an overdue book in a cellar, it is mine.'],\n  ],\n  'brasse:weeping_causeway.find_brasse': [\n    ['brasse', 'WHAT? SPEAK UP! I MELT BELLS FOR A LIVING!'],\n    ['brasse', 'A CORPSE, IS IT? GOOD. YOU CAN PUSH. THAT WAGON IS EVERY BELL ON THE MOOR AND I AM NOT LEAVING IT.'],\n    ['brasse', 'STAY NEAR IT AND KEEP THE ROAD CLEAR. IT ROLLS WHEN NOTHING IS CHEWING ON IT.'],\n  ],\n  'brasse:weeping_causeway.brasse_home': [\n    ['brasse', 'HOME! MORE OR LESS! THE FORGE IS LIT. BRING ME WHAT YOU DO NOT WANT.'],\n    ['brasse', 'SALVAGE IT, CRAFT WITH IT, REFORGE WHAT YOU KEEP. THAT SWORD WAS A CHURCH BELL ON TUESDAY.'],\n    ['pyx', 'The Lychgates are waking. You may use them. I will walk with you. Someone ought to.'],\n    ['crier', 'Hear ye! Writs are posted on the board. Also, Mother Ogive of the Reliquary wishes to taste you.'],\n  ],\n  'ogive:saint_gloam.see_ogive': [\n    ['ogive', 'Bring me the holy bones, child. I will know them by the taste.'],\n    ['ogive', 'Three bones of Saint Gloam, under the Ossuary. Something in the deep cellars has been keeping accounts.'],\n    ['ogive', 'Bring them to me, and I shall teach you what a dead saint still has to give.'],\n  ],\n  'ogive:saint_gloam.ogive_home': [\n    ['ogive', 'Ah. Knuckle. Rib. A bit of jaw. Very old. A little salty.'],\n    ['ogive', 'A ledger too. Let me taste the ink. Oh, child. That is the Bishop. His own hand.'],\n    ['ogive', 'The Reliquary is yours. Give me a legendary and I will draw its power out, and you may keep three such.'],\n    ['ogive', 'And gems, for anything with a socket. The Crier will want to hear about that ledger.'],\n  ],\n  'crier:cinder_cloister.see_crier': [\n    ['crier', 'Hear ye. The Bishop signed WHAT? Well. That is out of my remit. He is at the Cinder Cloister.'],\n    ['crier', 'The abbey has been burning for a week. There are novices still singing in it, if you hurry. Be firm with him.'],\n  ],\n  'crier:cinder_cloister.crier_truth': [\n    ['crier', 'You have his account of it, then. I shall read it, as I must. Hear ye, hear ye.'],\n    ['crier', 'Saint Malison, who gave herself to the bell. She did not give. The first bishops walled her up alive beneath the tower, singing.'],\n    ['crier', 'She has heard that bell every dusk for a thousand years. Ambrose cracked it for her. Now she means to ring the last toll: Eventide.'],\n    ['crier', 'And everything ever buried gets up. There is one thing she fears. Old Clemency, rung true. By hand. By somebody already dead.'],\n    ['crier', 'The Belfry gate is open. I am told it is a long climb. I would not know. I lack the legs.'],\n  ],\n  'crier:overdue': [\n    ['crier', 'My book! Forty years overdue! The fine is a disgrace. You may keep the fine. I mean: here. Take this.'],\n  ],\n};\n\nexport const STORY_LINES = {\n  opening: [\n    ['narrator', 'For a thousand years Old Clemency tolled at dusk, and the dead of Vespermoor stayed down.'],\n    ['narrator', 'Forty days ago the Great Bell cracked. It still tolls. It now says something else.'],\n    ['narrator', 'You were buried on the thirty-ninth day. It did not take.'],\n  ],\n  ending: [\n    ['narrator', 'Old Clemency rang true, once, by the hand of the dead. Every grave on the moor heard it, and stayed down.'],\n    ['narrator', 'Malison came apart in the sound. A thousand years of singing went out of the stone, and dawn came up over Vespermoor.'],\n    ['crier', 'Hear ye, hear ye. The dead are down. The roads are open. The fish is still off.'],\n    ['narrator', 'And far below, under the foundation, under the saint, a much deeper bell answered.'],\n  ],\n  bursar_intro: [['bursar', 'YOUR SOUL IS OVERDUE!']],\n  bursar_lines: ['INTEREST COMPOUNDS, LITTLE CORPSE!', 'I HAVE YOU DOWN FOR ONE DEATH. I SEE IT WAS NOT COLLECTED.', 'YOUR SOUL IS OVERDUE!', 'A SMALL ADMINISTRATIVE FEE!', 'AUDIT!'],\n  ambrose_intro: [['ambrose', 'They have buried me three times, my child. One learns to keep a spade in the coffin.']],\n  ambrose_lines: ['ONE LEARNS TO KEEP A SPADE IN THE COFFIN.', 'I SIGNED IT FOR THE PARISH. EVERYTHING WAS FOR THE PARISH.', 'BLESS YOU, MY CHILD. HOLD STILL.', 'TWICE MORE. I HAVE PRACTISED.'],\n  malison_intro: [['malison', 'A THOUSAND YEARS I HAVE BEEN YOUR FOUNDATION STONE. NOW I SHALL BE YOUR CEILING.']],\n  malison_lines: ['THEY WALLED ME UP SINGING. DO YOU KNOW WHAT I LEARNED IN THE DARK? EVERY VERSE.', 'RUN, LITTLE RINGER. THE HOUR IS UNRUNG, AND IT IS YOURS.', 'LISTEN. THAT IS EVERY GRAVE YOU EVER WALKED ON, OPENING.'],\n  malison_kill: 'DOWN YOU GO. GIVE MY REGARDS TO THE WORMS.',\n  malison_cloister: ['I CAN HEAR YOU CLIMBING, LITTLE RINGER.', 'THAT BISHOP WAS THE FIRST HONEST MAN IN A THOUSAND YEARS. HE ASKED MY PRICE.', 'SING, NOVICES. SING LOUDER. I KNOW THE TUNE.'],\n  cellarer_intro: [['cellarer', 'I said I would only be a moment. WHAT YEAR IS IT?']],\n};\n\n// Sister Pyx's banter: 40 lines, by what just happened.\nexport const PYX_BANTER = {\n  join: ['Bless you. Duck.', 'I will walk with you. Someone ought to.', 'They sent me to pray for you. I brought a crossbow instead.'],\n  kill: ['I have killed four hundred things today and confessed to none of them.', 'That one was somebody. It is not now.', 'Four hundred and one.', 'Requiescat. Next.', 'Hold still. There. Sorry. Not sorry.', 'I shall add it to the list. The list is long.', 'One does not enjoy this. One merely does it very well.'],\n  elite: ['That one has opinions. Kill it first.', 'Something is wrong with that one. Beyond the obvious.', 'Mind the glowing one. They are always worse.', 'Pride goes before a fall. Help it along.'],\n  loot: ['You are going to wear that? On a dead man?', 'Take it. He has no further use for it. I checked.', 'Vanity. Though I like the colour.', 'Finders keepers. It is not in the catechism but it should be.'],\n  hurt: ['You are bleeding. I would mention it, but it seems to be your hobby.', 'Try the rolling. People speak highly of it.', 'You smell like a grave. It is an improvement on the last one.', 'Do try to stay up.'],\n  down: ['I am lying down for a moment. Do not take this as a precedent.', 'Oh, for pity is sake.', 'Carry on. I shall catch up. Probably.'],\n  up: ['Where was I? Ah. Killing.', 'Heaven sent me back. Heaven was very short about it.', 'I am back. Do not fuss.'],\n  town: ['I shall be in the chapel. There is no chapel. I shall stand where it was.', 'Do your shopping. I will watch the road. The road is watching back.', 'Pennywhistle overcharged a dead man. I admire the principle.'],\n  boss: ['That one is overdue for burial.', 'Big, is it not. Aim for the middle.', 'Bless you. Duck. I mean it this time.'],\n  idle: ['In the old days there were bells. In the new days there is me.', 'Sister Agnes died of a chill. It was considered a very good death.', 'Do you still dream? I would not bother.', 'I took a vow of silence once. I have regretted almost every word since.', 'The rain does not stop. Neither do we. I find I resent the comparison.', 'If you see a Bishop, I would like a word with him.'],\n};\n\nexport const SYSTEM_LINES = {\n  death: 'YOU HAVE DIED. AGAIN. IT IS BECOMING A HABIT.',\n  level: 'YOU FEEL MORE ALIVE. THIS IS NOT MEDICALLY POSSIBLE.',\n};\nEOF\ncat > src/data/quests.js <<'EOF'\n// The story, in five quests. The sim (src/sim/quests.js) runs them; text and order live here.\nexport const QUESTS = [\n  { id: 'wipe_feet', name: 'WIPE YOUR FEET', steps: [\n    { id: 'wake', text: 'PUT THE PEATWALKERS BACK DOWN' },\n    { id: 'east', text: 'FOLLOW THE WALL EAST' },\n    { id: 'coffin', text: 'THE GATE IS SHUT. OPEN THE UNQUIET COFFIN' },\n    { id: 'gate', text: 'GO THROUGH THE GATE TO TOLLHAVEN' },\n    { id: 'crier', text: 'SPEAK TO CRIER MAUDLIN' },\n  ] },\n  { id: 'weeping_causeway', name: 'THE WEEPING CAUSEWAY', steps: [\n    { id: 'to_causeway', text: 'TAKE THE ROAD GATE TO THE CAUSEWAY' },\n    { id: 'find_brasse', text: 'FIND DAME BRASSE AT THE FAR END OF THE CAUSEWAY' },\n    { id: 'escort', text: 'GET THE WAGON OF BELLS HOME. STAY NEAR IT' },\n    { id: 'brasse_home', text: 'SPEAK TO DAME BRASSE IN TOLLHAVEN' },\n  ] },\n  { id: 'saint_gloam', name: \"SAINT GLOAM'S BONES\", steps: [\n    { id: 'see_ogive', text: 'SPEAK TO MOTHER OGIVE' },\n    { id: 'bone1', text: 'FIND THE FIRST BONE IN THE OSSUARY' },\n    { id: 'bone2', text: 'FIND THE SECOND BONE, A FLOOR DOWN' },\n    { id: 'bone3', text: 'FIND THE THIRD BONE, A FLOOR DOWN AGAIN' },\n    { id: 'bursar', text: 'SOMETHING IS KEEPING ACCOUNTS. FIND THE COUNTING HOUSE' },\n    { id: 'ledger', text: \"TAKE THE LEDGER FROM THE BURSAR'S BODY\" },\n    { id: 'ogive_home', text: 'BRING THE BONES TO MOTHER OGIVE' },\n  ] },\n  { id: 'cinder_cloister', name: 'THE CINDER CLOISTER', steps: [\n    { id: 'see_crier', text: 'TELL THE CRIER ABOUT THE LEDGER' },\n    { id: 'to_cloister', text: 'TRAVEL TO THE CINDER CLOISTER' },\n    { id: 'novices', text: 'FIND THE LAST NOVICES AND DEFEND THEM' },\n    { id: 'bishop', text: 'CONFRONT BISHOP AMBROSE IN THE CHAPTER HOUSE' },\n    { id: 'crier_truth', text: 'HEAR WHAT THE CRIER HAS TO READ' },\n  ] },\n  { id: 'ring_it', name: 'RING IT OR DIE TRYING', steps: [\n    { id: 'to_belfry', text: 'TRAVEL TO THE CRACKED BELFRY' },\n    { id: 'climb', text: 'CLIMB TO THE BELL CHAMBER' },\n    { id: 'malison', text: 'FACE MALISON BENEATH THE BELL' },\n    { id: 'ring', text: 'RING OLD CLEMENCY. HOLD ON THE ROPES' },\n  ] },\n];\nexport const stepOf = (q, s) => QUESTS[q]?.steps[s] ?? null;\n\nexport const WRIT_TEMPLATES = [\n  { k: 'kill', zone: 'causeway', n: 40, text: 'CLEAR 40 THINGS OFF THE CAUSEWAY' },\n  { k: 'kill', zone: 'ossuary', n: 60, text: 'CLEAR 60 THINGS OUT OF THE OSSUARY' },\n  { k: 'kill', zone: 'cloister', n: 50, text: 'PUT DOWN 50 THINGS IN THE CLOISTER' },\n  { k: 'kill', zone: 'yard', n: 15, text: 'TIDY 15 THINGS IN ST. CLEMENT\\'S YARD' },\n  { k: 'boss', boss: 'bursar', zone: 'ossuary', text: 'DISSOLVE THE BURSAR AGAIN' },\n  { k: 'boss', boss: 'cellarer', zone: 'pantry', text: 'EVICT THE CELLARER' },\n  { k: 'coffin', zone: 'causeway', text: 'OPEN AN UNQUIET COFFIN ON THE CAUSEWAY' },\n  { k: 'coffin', zone: 'ossuary', text: 'OPEN AN UNQUIET COFFIN IN THE OSSUARY' },\n  { k: 'coffin', zone: 'cloister', text: 'OPEN AN UNQUIET COFFIN IN THE CLOISTER' },\n];\n\nexport const KNELL_MODS = {\n  crowded: { name: 'CROWDED', desc: '+40% MONSTERS', icon: 'summon-icon' },\n  swift: { name: 'SWIFT', desc: '+20% MONSTER SPEED', icon: 'dash-icon' },\n  haunted: { name: 'HAUNTED', desc: 'EXTRA ELITES', icon: 'curse-icon' },\n  golden: { name: 'GOLDEN', desc: '+100% GOLD', icon: 'gold-icon' },\n  dark: { name: 'DARK', desc: 'ONLY YOUR OWN LIGHT', icon: 'lock' },\n  volatile: { name: 'VOLATILE', desc: 'THE DEAD EXPLODE', icon: 'fireball-icon' },\n};\nexport const KNELL_MOD_IDS = Object.keys(KNELL_MODS);\nEOF\necho ok","description":"Write lore, dialog and quest data"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14847,"cache_read_input_tokens":353393,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14847},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"9fdcc9c8-52bd-486c-a88f-94776be9a861","timestamp":"2026-11-05T23:51:53.421Z","request_id":"req_011CgkgE7ZoHSC5NJVaYt1tD","wire_tool_inputs":{"toolu_01LPqtYqxrLvnfcQi83DYBAX":{"command":"cat > src/data/lore.js <<'EOF'\n// Twelve lore books, read aloud and kept in the Codex. Pages are short: one job per screen.\nexport const LORE = {\n  third_night: { title: 'THE THIRD NIGHT', pages: ['THE GRAVES IN THE NEW YARD ARE EMPTY. THE GRAVES IN THE OLD YARD ARE EMPTY. I HAVE BEGUN DIGGING ONE FOR MYSELF, FOR THE COMPANY.'] },\n  parish_notice: { title: 'A PARISH NOTICE', pages: ['BY ORDER OF THE VESTRY: THE RECENTLY DECEASED ARE REMINDED THAT THEY REMAIN LIABLE FOR PEW RENT.', 'THE VESTRY REGRETS IT IS UNABLE TO HEAR COMPLAINTS AT THIS TIME. THE VESTRY IS EATING ITSELF.'] },\n  road_tolls: { title: 'ROAD TOLLS OF THE CAUSEWAY', pages: ['ONE PENNY FOR A CART. TWO FOR A CORPSE. THE DROWNED GO FREE, AS THEY ARE NOT, STRICTLY, ON THE ROAD.'] },\n  cellar_list: { title: \"THE CELLARER'S LIST\", pages: ['SIXTY BARRELS OF PICKLED HERRING. FORTY OF SMALL BEER. ONE MONK, WHO SAID HE WOULD ONLY BE A MOMENT.'] },\n  gloam_life: { title: 'THE LIFE OF SAINT GLOAM', pages: ['SAINT GLOAM WAS MARTYRED BY BEING TOLD, AT LENGTH, ABOUT HIS BROTHER. HIS BONES ARE SAID TO CURE BOREDOM.', 'THERE ARE ELEVEN HANDS IN THE OSSUARY ATTRIBUTED TO HIM. THE ORDER CONSIDERS THIS A MIRACLE.'] },\n  bearers_rule: { title: \"THE PALLBEARERS' RULE\", pages: ['CARRY LEVEL. CARRY QUIET. DO NOT STOP FOR THE DEAD MAN, HOWEVER HE ASKS.'] },\n  counting_note: { title: 'A NOTE IN THE MARGIN', pages: ['THE BURSAR IS OWED FOUR HUNDRED SOULS AND A SMALL GOAT. HE HAS NEVER ONCE ASKED ABOUT THE GOAT. THIS FRIGHTENS ME MORE.'] },\n  bishops_ledger: { title: \"THE BISHOP'S ACCOUNT\", pages: ['DEBTOR: AMBROSE, BISHOP OF VESPERMOOR. SECURED AGAINST: ONE GREAT BELL, CRACKED IN FULL AND FINAL SETTLEMENT.', 'THE HAND IS HIS. THE RECEIPT IS DATED FORTY DAYS AGO. THE INK IS STILL WET.'] },\n  novices_hymn: { title: \"A NOVICE'S COPYBOOK\", pages: ['SISTER SAYS WE MUST SING LOUDER, SO THE FIRE KNOWS WE ARE STILL HERE. SISTER SAYS THIS LIKE IT IS GOOD NEWS.'] },\n  foundation_stone: { title: 'THE FOUNDATION STONE', pages: ['THE FIRST BISHOPS NEEDED A BELL THAT WOULD HOLD THE DEAD DOWN. THEY WERE TOLD IT WOULD REQUIRE A SACRIFICE WILLING TO SING.', 'THEY FOUND A SACRIFICE. THEY WERE WRONG ABOUT THE WILLING.'] },\n  ringers_oath: { title: \"THE RINGERS' OATH\", pages: ['RING TRUE. RING ON THE HOUR. AND IF THE ROPE BEGINS TO PULL BACK, LET GO, AND TELL NO ONE WHAT YOU HEARD.'] },\n  last_entry: { title: 'THE LAST ENTRY', pages: ['IT IS LOUDER UP HERE. I CAN HEAR HER COUNTING. SHE HAS REACHED THE YEAR OF MY BIRTH.'] },\n};\nexport const LORE_IDS = Object.keys(LORE);\nexport const LORE_PLACES = {\n  'yard:0': 'third_night', 'town:0': 'parish_notice', 'causeway:0': 'road_tolls', 'pantry:0': 'cellar_list',\n  'ossuary:0': 'gloam_life', 'ossuary:1': 'bearers_rule', 'ossuary:2': 'counting_note', 'cloister:0': 'novices_hymn',\n  'belfry:0': 'foundation_stone', 'belfry:1': 'ringers_oath', 'belfry:2': 'last_entry',\n};\n// The twelfth, bishops_ledger, is taken from the Bursar's body.\n\nexport const HOW_TO_PLAY = [\n  { title: 'MOVING AND FIGHTING', lines: ['MOVE WITH THE LEFT STICK, WASD, OR A CLICK ON THE GROUND.', 'YOUR SKILLS ARE ON THE FACE BUTTONS, R1 AND R2, OR THE MOUSE AND 1 TO 4.', 'ROLL THROUGH ANY RED RING. YOU CANNOT BE HIT WHILE ROLLING.', 'YOUR POTION IS ALWAYS THERE. IT JUST TAKES 30 SECONDS TO FORGIVE YOU.', 'THE DEAD DROP TALLOW. WALK OVER IT TO MELT YOUR CANDLE BACK.'] },\n  { title: 'SKILLS AND TONES', lines: ['SIX SLOTS, EIGHT SKILLS, ANY SKILL IN ANY SLOT.', 'EVERY SKILL HAS THREE TONES THAT CHANGE HOW IT WORKS.', 'SWAPPING IS FREE AND INSTANT, SO TRY THINGS.', 'AT LEVEL 5 AND LEVEL 15 YOU SWEAR A VOW. YOU MAY UNSWEAR IT. NOBODY IS WATCHING.'] },\n  { title: 'LOOT', lines: ['WHITE IS COMMON. BLUE IS BLESSED. YELLOW IS RELIQUARY.', 'ORANGE IS LEGENDARY AND GREEN IS A SET. BOTH RING A BELL WHEN THEY FALL.', 'YOU WALK OVER ITEMS TO TAKE THEM. WHEN ONE IS BETTER, A PROMPT OFFERS TO EQUIP IT.', 'LOOT IS PERSONAL. NOBODY CAN TAKE WHAT FELL FOR YOU.'] },\n  { title: 'TOWN', lines: ['PENNYWHISTLE BUYS, SELLS AND SELLS MYSTERY CASKETS.', 'DAME BRASSE SALVAGES, CRAFTS AND REFORGES.', 'MOTHER OGIVE EXTRACTS LEGENDARY POWERS AND SETS GEMS.', 'THE COLLECTION BOX IS SHARED BY ALL YOUR HEROES.', 'THE KNELL FONT CHANGES THE DIFFICULTY AND OPENS KNELL RUNS.'] },\n  { title: 'KNELL RUNS', lines: ['AFTER THE STORY, THE KNELL FONT OPENS RANDOM DUNGEONS.', 'KILLS FILL THE KNELL METER. AT THE TOP A WARDEN CRASHES DOWN.', 'WARDENS PAY IN LEGENDARIES AND SOMETIMES A GRAND KEY.', 'A GRAND KEY OPENS A TIMED RUN AT A TIER YOU CHOOSE.', 'PAST LEVEL 30, XP BECOMES DEVOTION, SHARED BY ALL YOUR HEROES.'] },\n  { title: 'CO-OP', lines: ['A SECOND PAD PRESSES OPTIONS TO JOIN, ANY TIME. UP TO FOUR ON ONE SCREEN.', 'EACH PLAYER HAS THEIR OWN LOOT AND THEIR OWN HERO SCREEN.', 'HOLD INTERACT OVER A FALLEN FRIEND FOR TWO SECONDS TO BRING THEM BACK.', 'THROUGH AI HUB, UP TO FOUR PLAY ONE KNELL RUN TOGETHER ONLINE.'] },\n];\nEOF\ncat > src/data/dialog.js <<'EOF'\n// Who speaks, how they sound, and what they say. Lines fit two rows of about 60 characters.\nexport const NPC_LABELS = { crier: 'CRIER MAUDLIN', brasse: 'DAME BRASSE', ogive: 'MOTHER OGIVE', pennywhistle: 'PENNYWHISTLE', pyx: 'SISTER PYX', ambrose: 'BISHOP AMBROSE' };\nexport const SPEAKERS = {\n  narrator: { name: '', color: 'mist', voice: 'narrator' },\n  crier: { name: 'CRIER MAUDLIN', color: 'sand', voice: 'crier' },\n  brasse: { name: 'DAME BRASSE', color: 'orange', voice: 'brasse' },\n  ogive: { name: 'MOTHER OGIVE', color: 'lime', voice: 'ogive' },\n  pennywhistle: { name: 'PENNYWHISTLE', color: 'sky', voice: 'pennywhistle' },\n  pyx: { name: 'SISTER PYX', color: 'white', voice: 'pyx' },\n  ambrose: { name: 'BISHOP AMBROSE', color: 'mist', voice: 'ambrose' },\n  bursar: { name: 'THE BURSAR', color: 'red', voice: 'bursar' },\n  malison: { name: 'MALISON', color: 'red', voice: 'malison' },\n  cellarer: { name: 'THE CELLARER', color: 'teal', voice: 'brasse' },\n};\n\nexport const BARKS = {\n  crier: ['Hear ye, hear ye! The dead are up, the roads are closed, and the fish is off.', 'I lost the body at harvest and kept the job. No one told me to stop.', 'The parish asks that you wipe your feet. You have been in the ground.', 'Hear ye! The Vestry has resolved to do nothing, with vigour.'],\n  brasse: ['WHAT? SPEAK UP! I MELT BELLS FOR A LIVING!', 'THAT SWORD WAS A CHURCH BELL ON TUESDAY. HIT SOMETHING WITH IT AND IT STILL SAYS AMEN.', 'DO NOT TOUCH THAT. IT IS HOT. EVERYTHING IS HOT.'],\n  ogive: ['Bring me the holy bones, child. I will know them by the taste.', \"A saint's knuckle. Very old. A little salty. She died angry.\", 'Come closer. I do not bite the living. As a rule.'],\n  pennywhistle: ['Everything is half price, dear friend. The other half is your soul, but we can discuss terms.', 'No refunds. No returns. No survivors, so far.', 'Modest markups, considering the apocalypse.'],\n  pyx: ['I have killed four hundred things today and confessed to none of them.', 'You smell like a grave. It is an improvement on the last one.'],\n  ambrose: ['They have buried me three times, my child. One learns to keep a spade in the coffin.'],\n};\n\n// Fixed story talks. key: `${npc}:${quest}.${step}`. Each line is [speaker, text].\nexport const TALKS = {\n  'crier:wipe_feet.crier': [\n    ['crier', 'Hear ye, hear ye! The dead are up, the roads are closed, and the fish is off. Also you. You are dead. Welcome back.'],\n    ['crier', 'I lost the body at harvest and kept the job. No one told me to stop.'],\n    ['crier', 'You are one of the Late. Formally, the Tollborn. The parish asks that you wipe your feet.'],\n    ['crier', 'The Great Bell cracked and the Bishop sends no word. A bellfounder might know why. Dame Brasse is out on the Causeway.'],\n    ['crier', 'Take the road gate. Fetch her back, wagon and all. And if you find an overdue book in a cellar, it is mine.'],\n  ],\n  'brasse:weeping_causeway.find_brasse': [\n    ['brasse', 'WHAT? SPEAK UP! I MELT BELLS FOR A LIVING!'],\n    ['brasse', 'A CORPSE, IS IT? GOOD. YOU CAN PUSH. THAT WAGON IS EVERY BELL ON THE MOOR AND I AM NOT LEAVING IT.'],\n    ['brasse', 'STAY NEAR IT AND KEEP THE ROAD CLEAR. IT ROLLS WHEN NOTHING IS CHEWING ON IT.'],\n  ],\n  'brasse:weeping_causeway.brasse_home': [\n    ['brasse', 'HOME! MORE OR LESS! THE FORGE IS LIT. BRING ME WHAT YOU DO NOT WANT.'],\n    ['brasse', 'SALVAGE IT, CRAFT WITH IT, REFORGE WHAT YOU KEEP. THAT SWORD WAS A CHURCH BELL ON TUESDAY.'],\n    ['pyx', 'The Lychgates are waking. You may use them. I will walk with you. Someone ought to.'],\n    ['crier', 'Hear ye! Writs are posted on the board. Also, Mother Ogive of the Reliquary wishes to taste you.'],\n  ],\n  'ogive:saint_gloam.see_ogive': [\n    ['ogive', 'Bring me the holy bones, child. I will know them by the taste.'],\n    ['ogive', 'Three bones of Saint Gloam, under the Ossuary. Something in the deep cellars has been keeping accounts.'],\n    ['ogive', 'Bring them to me, and I shall teach you what a dead saint still has to give.'],\n  ],\n  'ogive:saint_gloam.ogive_home': [\n    ['ogive', 'Ah. Knuckle. Rib. A bit of jaw. Very old. A little salty.'],\n    ['ogive', 'A ledger too. Let me taste the ink. Oh, child. That is the Bishop. His own hand.'],\n    ['ogive', 'The Reliquary is yours. Give me a legendary and I will draw its power out, and you may keep three such.'],\n    ['ogive', 'And gems, for anything with a socket. The Crier will want to hear about that ledger.'],\n  ],\n  'crier:cinder_cloister.see_crier': [\n    ['crier', 'Hear ye. The Bishop signed WHAT? Well. That is out of my remit. He is at the Cinder Cloister.'],\n    ['crier', 'The abbey has been burning for a week. There are novices still singing in it, if you hurry. Be firm with him.'],\n  ],\n  'crier:cinder_cloister.crier_truth': [\n    ['crier', 'You have his account of it, then. I shall read it, as I must. Hear ye, hear ye.'],\n    ['crier', 'Saint Malison, who gave herself to the bell. She did not give. The first bishops walled her up alive beneath the tower, singing.'],\n    ['crier', 'She has heard that bell every dusk for a thousand years. Ambrose cracked it for her. Now she means to ring the last toll: Eventide.'],\n    ['crier', 'And everything ever buried gets up. There is one thing she fears. Old Clemency, rung true. By hand. By somebody already dead.'],\n    ['crier', 'The Belfry gate is open. I am told it is a long climb. I would not know. I lack the legs.'],\n  ],\n  'crier:overdue': [\n    ['crier', 'My book! Forty years overdue! The fine is a disgrace. You may keep the fine. I mean: here. Take this.'],\n  ],\n};\n\nexport const STORY_LINES = {\n  opening: [\n    ['narrator', 'For a thousand years Old Clemency tolled at dusk, and the dead of Vespermoor stayed down.'],\n    ['narrator', 'Forty days ago the Great Bell cracked. It still tolls. It now says something else.'],\n    ['narrator', 'You were buried on the thirty-ninth day. It did not take.'],\n  ],\n  ending: [\n    ['narrator', 'Old Clemency rang true, once, by the hand of the dead. Every grave on the moor heard it, and stayed down.'],\n    ['narrator', 'Malison came apart in the sound. A thousand years of singing went out of the stone, and dawn came up over Vespermoor.'],\n    ['crier', 'Hear ye, hear ye. The dead are down. The roads are open. The fish is still off.'],\n    ['narrator', 'And far below, under the foundation, under the saint, a much deeper bell answered.'],\n  ],\n  bursar_intro: [['bursar', 'YOUR SOUL IS OVERDUE!']],\n  bursar_lines: ['INTEREST COMPOUNDS, LITTLE CORPSE!', 'I HAVE YOU DOWN FOR ONE DEATH. I SEE IT WAS NOT COLLECTED.', 'YOUR SOUL IS OVERDUE!', 'A SMALL ADMINISTRATIVE FEE!', 'AUDIT!'],\n  ambrose_intro: [['ambrose', 'They have buried me three times, my child. One learns to keep a spade in the coffin.']],\n  ambrose_lines: ['ONE LEARNS TO KEEP A SPADE IN THE COFFIN.', 'I SIGNED IT FOR THE PARISH. EVERYTHING WAS FOR THE PARISH.', 'BLESS YOU, MY CHILD. HOLD STILL.', 'TWICE MORE. I HAVE PRACTISED.'],\n  malison_intro: [['malison', 'A THOUSAND YEARS I HAVE BEEN YOUR FOUNDATION STONE. NOW I SHALL BE YOUR CEILING.']],\n  malison_lines: ['THEY WALLED ME UP SINGING. DO YOU KNOW WHAT I LEARNED IN THE DARK? EVERY VERSE.', 'RUN, LITTLE RINGER. THE HOUR IS UNRUNG, AND IT IS YOURS.', 'LISTEN. THAT IS EVERY GRAVE YOU EVER WALKED ON, OPENING.'],\n  malison_kill: 'DOWN YOU GO. GIVE MY REGARDS TO THE WORMS.',\n  malison_cloister: ['I CAN HEAR YOU CLIMBING, LITTLE RINGER.', 'THAT BISHOP WAS THE FIRST HONEST MAN IN A THOUSAND YEARS. HE ASKED MY PRICE.', 'SING, NOVICES. SING LOUDER. I KNOW THE TUNE.'],\n  cellarer_intro: [['cellarer', 'I said I would only be a moment. WHAT YEAR IS IT?']],\n};\n\n// Sister Pyx's banter: 40 lines, by what just happened.\nexport const PYX_BANTER = {\n  join: ['Bless you. Duck.', 'I will walk with you. Someone ought to.', 'They sent me to pray for you. I brought a crossbow instead.'],\n  kill: ['I have killed four hundred things today and confessed to none of them.', 'That one was somebody. It is not now.', 'Four hundred and one.', 'Requiescat. Next.', 'Hold still. There. Sorry. Not sorry.', 'I shall add it to the list. The list is long.', 'One does not enjoy this. One merely does it very well.'],\n  elite: ['That one has opinions. Kill it first.', 'Something is wrong with that one. Beyond the obvious.', 'Mind the glowing one. They are always worse.', 'Pride goes before a fall. Help it along.'],\n  loot: ['You are going to wear that? On a dead man?', 'Take it. He has no further use for it. I checked.', 'Vanity. Though I like the colour.', 'Finders keepers. It is not in the catechism but it should be.'],\n  hurt: ['You are bleeding. I would mention it, but it seems to be your hobby.', 'Try the rolling. People speak highly of it.', 'You smell like a grave. It is an improvement on the last one.', 'Do try to stay up.'],\n  down: ['I am lying down for a moment. Do not take this as a precedent.', 'Oh, for pity is sake.', 'Carry on. I shall catch up. Probably.'],\n  up: ['Where was I? Ah. Killing.', 'Heaven sent me back. Heaven was very short about it.', 'I am back. Do not fuss.'],\n  town: ['I shall be in the chapel. There is no chapel. I shall stand where it was.', 'Do your shopping. I will watch the road. The road is watching back.', 'Pennywhistle overcharged a dead man. I admire the principle.'],\n  boss: ['That one is overdue for burial.', 'Big, is it not. Aim for the middle.', 'Bless you. Duck. I mean it this time.'],\n  idle: ['In the old days there were bells. In the new days there is me.', 'Sister Agnes died of a chill. It was considered a very good death.', 'Do you still dream? I would not bother.', 'I took a vow of silence once. I have regretted almost every word since.', 'The rain does not stop. Neither do we. I find I resent the comparison.', 'If you see a Bishop, I would like a word with him.'],\n};\n\nexport const SYSTEM_LINES = {\n  death: 'YOU HAVE DIED. AGAIN. IT IS BECOMING A HABIT.',\n  level: 'YOU FEEL MORE ALIVE. THIS IS NOT MEDICALLY POSSIBLE.',\n};\nEOF\ncat > src/data/quests.js <<'EOF'\n// The story, in five quests. The sim (src/sim/quests.js) runs them; text and order live here.\nexport const QUESTS = [\n  { id: 'wipe_feet', name: 'WIPE YOUR FEET', steps: [\n    { id: 'wake', text: 'PUT THE PEATWALKERS BACK DOWN' },\n    { id: 'east', text: 'FOLLOW THE WALL EAST' },\n    { id: 'coffin', text: 'THE GATE IS SHUT. OPEN THE UNQUIET COFFIN' },\n    { id: 'gate', text: 'GO THROUGH THE GATE TO TOLLHAVEN' },\n    { id: 'crier', text: 'SPEAK TO CRIER MAUDLIN' },\n  ] },\n  { id: 'weeping_causeway', name: 'THE WEEPING CAUSEWAY', steps: [\n    { id: 'to_causeway', text: 'TAKE THE ROAD GATE TO THE CAUSEWAY' },\n    { id: 'find_brasse', text: 'FIND DAME BRASSE AT THE FAR END OF THE CAUSEWAY' },\n    { id: 'escort', text: 'GET THE WAGON OF BELLS HOME. STAY NEAR IT' },\n    { id: 'brasse_home', text: 'SPEAK TO DAME BRASSE IN TOLLHAVEN' },\n  ] },\n  { id: 'saint_gloam', name: \"SAINT GLOAM'S BONES\", steps: [\n    { id: 'see_ogive', text: 'SPEAK TO MOTHER OGIVE' },\n    { id: 'bone1', text: 'FIND THE FIRST BONE IN THE OSSUARY' },\n    { id: 'bone2', text: 'FIND THE SECOND BONE, A FLOOR DOWN' },\n    { id: 'bone3', text: 'FIND THE THIRD BONE, A FLOOR DOWN AGAIN' },\n    { id: 'bursar', text: 'SOMETHING IS KEEPING ACCOUNTS. FIND THE COUNTING HOUSE' },\n    { id: 'ledger', text: \"TAKE THE LEDGER FROM THE BURSAR'S BODY\" },\n    { id: 'ogive_home', text: 'BRING THE BONES TO MOTHER OGIVE' },\n  ] },\n  { id: 'cinder_cloister', name: 'THE CINDER CLOISTER', steps: [\n    { id: 'see_crier', text: 'TELL THE CRIER ABOUT THE LEDGER' },\n    { id: 'to_cloister', text: 'TRAVEL TO THE CINDER CLOISTER' },\n    { id: 'novices', text: 'FIND THE LAST NOVICES AND DEFEND THEM' },\n    { id: 'bishop', text: 'CONFRONT BISHOP AMBROSE IN THE CHAPTER HOUSE' },\n    { id: 'crier_truth', text: 'HEAR WHAT THE CRIER HAS TO READ' },\n  ] },\n  { id: 'ring_it', name: 'RING IT OR DIE TRYING', steps: [\n    { id: 'to_belfry', text: 'TRAVEL TO THE CRACKED BELFRY' },\n    { id: 'climb', text: 'CLIMB TO THE BELL CHAMBER' },\n    { id: 'malison', text: 'FACE MALISON BENEATH THE BELL' },\n    { id: 'ring', text: 'RING OLD CLEMENCY. HOLD ON THE ROPES' },\n  ] },\n];\nexport const stepOf = (q, s) => QUESTS[q]?.steps[s] ?? null;\n\nexport const WRIT_TEMPLATES = [\n  { k: 'kill', zone: 'causeway', n: 40, text: 'CLEAR 40 THINGS OFF THE CAUSEWAY' },\n  { k: 'kill', zone: 'ossuary', n: 60, text: 'CLEAR 60 THINGS OUT OF THE OSSUARY' },\n  { k: 'kill', zone: 'cloister', n: 50, text: 'PUT DOWN 50 THINGS IN THE CLOISTER' },\n  { k: 'kill', zone: 'yard', n: 15, text: 'TIDY 15 THINGS IN ST. CLEMENT\\'S YARD' },\n  { k: 'boss', boss: 'bursar', zone: 'ossuary', text: 'DISSOLVE THE BURSAR AGAIN' },\n  { k: 'boss', boss: 'cellarer', zone: 'pantry', text: 'EVICT THE CELLARER' },\n  { k: 'coffin', zone: 'causeway', text: 'OPEN AN UNQUIET COFFIN ON THE CAUSEWAY' },\n  { k: 'coffin', zone: 'ossuary', text: 'OPEN AN UNQUIET COFFIN IN THE OSSUARY' },\n  { k: 'coffin', zone: 'cloister', text: 'OPEN AN UNQUIET COFFIN IN THE CLOISTER' },\n];\n\nexport const KNELL_MODS = {\n  crowded: { name: 'CROWDED', desc: '+40% MONSTERS', icon: 'summon-icon' },\n  swift: { name: 'SWIFT', desc: '+20% MONSTER SPEED', icon: 'dash-icon' },\n  haunted: { name: 'HAUNTED', desc: 'EXTRA ELITES', icon: 'curse-icon' },\n  golden: { name: 'GOLDEN', desc: '+100% GOLD', icon: 'gold-icon' },\n  dark: { name: 'DARK', desc: 'ONLY YOUR OWN LIGHT', icon: 'lock' },\n  volatile: { name: 'VOLATILE', desc: 'THE DEAD EXPLODE', icon: 'fireball-icon' },\n};\nexport const KNELL_MOD_IDS = Object.keys(KNELL_MODS);\nEOF\necho ok","description":"Write lore, dialog and quest data"}}}
