.2, [0, 0.4, 0], 'fire', { glow: true }), { cyl: [0.7, 0.05, 0.7], at: [0, 0.98, 0], c: 'hat', seg: 8 }, box(0.26, 0.2, 0.26, [0, 1.1, 0], 'hat')] }),\n];\nEOF\npython3 - <<'EOF'\np='src/view/models/monsters.js'; s=open(p).read()\ns=s.replace(\"{ scatterOf: 0 } && box(0.16, 0.05, 0.16, [0.2, 0.7, 0.1], 'coin'),\",\"box(0.16, 0.05, 0.16, [0.2, 0.7, 0.1], 'coin'),\")\nopen(p,'w').write(s)\nEOF\ncat > src/view/models/npcs.js <<'EOF'\n// The cast, the bosses, and Old Clemency.\nimport { model } from '../../../pixel-engine.js';\nimport { box, eyes, hang, humanoid, limbs } from './rig.js';\n\nconst tags = ['character', 'npc'];\nexport const NPC_MODELS = [\n  model({ id: 'npc_crier', about: 'Crier Maudlin: a severed head in a lantern on a post', tags, palette: { post: 'plum', frame: 'slate', skin: 'sand', glow: 'orange', dark: 'ink', eye: 'white', board: 'orange', bell: 'sand' },\n    parts: [\n      box(0.2, 1.7, 0.2, [0, 0.85, 0], 'post'), box(0.6, 0.12, 0.6, [0, 0.06, 0], 'frame'), box(0.5, 0.3, 0.06, [0, 1.0, 0.13], 'board'),\n      box(0.76, 0.06, 0.76, [0, 1.72, 0], 'frame'), { mirror: [box(0.05, 0.62, 0.05, [0.34, 2.03, 0.34], 'frame'), box(0.05, 0.62, 0.05, [-0.34, 2.03, 0.34], 'frame')], axis: 'z' },\n      { group: [box(0.42, 0.46, 0.42, [0, 2.03, 0], 'skin'), box(0.46, 0.1, 0.46, [0, 2.26, 0], 'dark'), eyes(2.08, 0.22, 'eye', 0.1, 0.07), box(0.18, 0.1, 0.04, [0, 1.9, 0.22], 'dark')], name: 'CrierHead', pivot: true, at: [0, 0, 0] },\n      { cone: [0.96, 0.3, 0.96], at: [0, 2.48, 0], c: 'dark', seg: 4 }, box(0.1, 0.3, 0.1, [0, 2.76, 0], 'bell'),\n      box(0.56, 0.5, 0.05, [0, 2.03, -0.38], 'glow', { glow: true }),\n    ] }),\n  model({ id: 'npc_brasse', about: 'Dame Brasse: wide, in a scorched apron, with a great hammer', tags, palette: { apron: 'sand', dress: 'red', skin: 'orange', hair: 'mist', boot: 'night', iron: 'slate' },\n    parts: humanoid({\n      hips: [box(0.5, 0.26, 0.36, [0, 0, 0], 'dress'), box(0.58, 0.32, 0.4, [0, -0.16, 0], 'dress'), box(0.34, 0.44, 0.05, [0, -0.1, 0.21], 'apron')],\n      chest: [box(0.62, 0.48, 0.38, [0, 0.21, 0], 'dress'), box(0.36, 0.42, 0.05, [0, 0.2, 0.2], 'apron')],\n      head: [box(0.28, 0.28, 0.28, [0, 0.13, 0], 'skin'), box(0.34, 0.14, 0.34, [0, 0.3, -0.02], 'hair'), box(0.16, 0.16, 0.16, [0, 0.42, -0.08], 'hair'), box(0.2, 0.05, 0.04, [0, 0.07, 0.145], 'boot')],\n      ...limbs({ arm: 'skin', hand: 'iron', leg: 'boot', armW: 0.18, legW: 0.2 }),\n      handR: [hang(0.14, 0.11, 0.14, 'iron'), box(0.07, 0.07, 0.8, [0, -0.08, 0.3], 'apron'), box(0.3, 0.24, 0.24, [0, -0.08, 0.72], 'iron')],\n    }) }),\n  model({ id: 'npc_ogive', about: 'Mother Ogive: small and veiled, blind, keeper of the Reliquary', tags, palette: { veil: 'white', robe: 'teal', skin: 'mist', dark: 'night', gem: 'lime' },\n    parts: humanoid({\n      hips: [box(0.34, 0.22, 0.24, [0, 0, 0], 'robe'), box(0.44, 0.5, 0.3, [0, -0.25, 0], 'robe')],\n      chest: [box(0.4, 0.42, 0.24, [0, 0.19, 0.02], 'robe'), box(0.08, 0.08, 0.05, [0, 0.3, 0.15], 'gem', { glow: true })],\n      head: [box(0.24, 0.26, 0.24, [0, 0.12, 0.02], 'skin'), box(0.34, 0.46, 0.34, [0, 0.14, -0.02], 'veil'), box(0.2, 0.1, 0.05, [0, 0.14, 0.15], 'dark')],\n      ...limbs({ arm: 'robe', hand: 'skin', leg: 'robe', boot: 'dark' }),\n    }) }),\n  model({ id: 'npc_pennywhistle', about: 'Pennywhistle: a merchant in a plague-doctor beak with a big pack', tags, palette: { coat: 'ink', beak: 'sand', hat: 'night', pack: 'orange', strap: 'plum', eye: 'sky', boot: 'night', skin: 'mist' },\n    parts: humanoid({\n      hips: [box(0.38, 0.22, 0.26, [0, 0, 0], 'coat'), box(0.44, 0.38, 0.3, [0, -0.2, 0], 'coat')],\n      chest: [box(0.46, 0.46, 0.28, [0, 0.21, 0], 'coat'), box(0.7, 0.86, 0.44, [0, 0.38, -0.36], 'pack'), box(0.74, 0.08, 0.48, [0, 0.54, -0.36], 'strap'), box(0.74, 0.08, 0.48, [0, 0.22, -0.36], 'strap'), box(0.4, 0.3, 0.3, [0, 0.96, -0.36], 'strap')],\n      head: [box(0.28, 0.28, 0.28, [0, 0.14, 0], 'beak'), { cone: [0.16, 0.14, 0.42], at: [0, 0.08, 0.3], c: 'beak', rot: [90, 0, 0], seg: 4 }, { cyl: [0.56, 0.05, 0.56], at: [0, 0.29, 0], c: 'hat', seg: 8 }, { cyl: [0.3, 0.18, 0.3], at: [0, 0.38, 0], c: 'hat', seg: 8 }, eyes(0.17, 0.145, 'eye', 0.07, 0.07)],\n      ...limbs({ arm: 'coat', hand: 'skin', leg: 'hat' }),\n    }) }),\n  model({ id: 'npc_novice', about: 'A novice in a singed grey habit, singing', tags, palette: { robe: 'mist', veil: 'night', skin: 'sand', boot: 'slate' },\n    parts: humanoid({\n      hips: [box(0.3, 0.2, 0.22, [0, 0, 0], 'robe'), box(0.38, 0.42, 0.26, [0, -0.2, 0], 'robe')],\n      chest: [box(0.36, 0.42, 0.22, [0, 0.19, 0], 'robe')],\n      head: [box(0.24, 0.26, 0.24, [0, 0.12, 0], 'skin'), box(0.3, 0.32, 0.28, [0, 0.16, -0.03], 'veil')],\n      ...limbs({ arm: 'robe', hand: 'skin', leg: 'robe', boot: 'boot', armW: 0.11, legW: 0.13 }),\n    }) }),\n  model({ id: 'ambrose', about: 'Bishop Ambrose: pale and kindly in a tall mitre, with a spade', tags: ['character', 'boss'], palette: { robe: 'white', trim: 'sand', skin: 'mist', mitre: 'red', dark: 'ink', eye: 'sky', boot: 'slate' },\n    parts: humanoid({\n      hips: [box(0.38, 0.22, 0.26, [0, 0, 0], 'robe'), box(0.46, 0.46, 0.3, [0, -0.2, 0], 'robe'), box(0.12, 0.56, 0.05, [0, -0.15, 0.17], 'trim')],\n      chest: [box(0.46, 0.46, 0.28, [0, 0.21, 0], 'robe'), box(0.12, 0.44, 0.05, [0, 0.21, 0.145], 'trim'), box(0.34, 0.06, 0.05, [0, 0.32, 0.15], 'trim')],\n      head: [box(0.26, 0.28, 0.26, [0, 0.13, 0], 'skin'), { cone: [0.34, 0.52, 0.2], at: [0, 0.5, 0], c: 'mitre', seg: 4 }, box(0.36, 0.08, 0.28, [0, 0.29, 0], 'trim'), eyes(0.15, 0.135, 'eye', 0.06, 0.05)],\n      ...limbs({ arm: 'robe', hand: 'skin', leg: 'dark', boot: 'boot' }),\n      handR: [hang(0.11, 0.1, 0.11, 'skin'), box(0.06, 0.06, 1.1, [0, -0.08, 0.3], 'dark'), box(0.24, 0.05, 0.3, [0, -0.08, 0.95], 'boot')],\n    }) }),\n  model({ id: 'bursar', about: 'The Bursar: a bloated demon accountant in a stolen cope, with ledger and abacus', tags: ['character', 'boss'], palette: { skin: 'red', cope: 'plum', trim: 'sand', ledger: 'orange', dark: 'ink', eye: 'lime', bead: 'white', horn: 'mist' },\n    parts: humanoid({\n      hips: [box(0.56, 0.32, 0.44, [0, 0, 0], 'skin'), { ball: [0.78, 0.64, 0.66], at: [0, 0.12, 0.1], c: 'skin', seg: 9 }],\n      chest: [{ ball: [0.84, 0.66, 0.66], at: [0, 0.22, 0.05], c: 'cope', seg: 9 }, box(0.3, 0.55, 0.06, [0, 0.2, 0.36], 'trim'), box(0.72, 0.1, 0.5, [0, 0.46, 0], 'trim')],\n      head: [box(0.34, 0.3, 0.32, [0, 0.11, 0.05], 'skin'), { mirror: [{ cone: [0.08, 0.26, 0.08], at: [0.14, 0.36, 0], c: 'horn', seg: 5 }], axis: 'x' }, eyes(0.17, 0.22, 'eye', 0.08, 0.07), box(0.2, 0.06, 0.04, [0, 0.06, 0.22], 'dark'), box(0.22, 0.05, 0.05, [0, 0.14, 0.24], 'bead')],\n      ...limbs({ arm: 'cope', hand: 'skin', leg: 'dark', boot: 'dark', armW: 0.18, legW: 0.19 }),\n      handL: [hang(0.14, 0.11, 0.14, 'skin'), box(0.42, 0.56, 0.12, [0, -0.3, 0.1], 'ledger'), box(0.05, 0.56, 0.14, [0, -0.3, 0.1], 'trim')],\n      handR: [hang(0.14, 0.11, 0.14, 'skin'), box(0.5, 0.36, 0.06, [0, -0.28, 0.1], 'dark'), box(0.4, 0.05, 0.08, [0, -0.2, 0.1], 'bead'), box(0.4, 0.05, 0.08, [0, -0.3, 0.1], 'bead'), box(0.4, 0.05, 0.08, [0, -0.38, 0.1], 'bead')],\n    }) }),\n  model({ id: 'cellarer', about: 'The Cellarer: a drowned monk, huge with water, wearing a barrel', tags: ['character', 'boss'], palette: { skin: 'teal', robe: 'night', wood: 'orange', hoop: 'slate', eye: 'white', dark: 'ink' },\n    parts: humanoid({\n      hips: [box(0.46, 0.24, 0.34, [0, 0, 0], 'robe')],\n      chest: [{ cyl: [0.74, 0.7, 0.74], at: [0, 0.18, 0], c: 'wood', seg: 8 }, { cyl: [0.78, 0.06, 0.78], at: [0, 0.38, 0], c: 'hoop', seg: 8 }, { cyl: [0.78, 0.06, 0.78], at: [0, -0.02, 0], c: 'hoop', seg: 8 }],\n      head: [box(0.3, 0.3, 0.3, [0, 0.14, 0.02], 'skin'), box(0.34, 0.08, 0.34, [0, 0.3, 0], 'robe'), eyes(0.16, 0.18), box(0.14, 0.07, 0.04, [0, 0.06, 0.18], 'dark')],\n      ...limbs({ arm: 'skin', hand: 'dark', leg: 'robe', boot: 'dark', armW: 0.17, legW: 0.19 }),\n    }) }),\n  model({ id: 'hollow_sexton', about: 'The Hollow Sexton: a Knell Warden, a huge empty gravedigger', tags: ['character', 'boss'], palette: { frock: 'night', bone: 'mist', dark: 'ink', eye: 'lime', hat: 'plum', steel: 'slate' },\n    parts: humanoid({\n      hips: [box(0.42, 0.24, 0.3, [0, 0, 0], 'frock'), box(0.5, 0.46, 0.32, [0, -0.22, 0], 'frock')],\n      chest: [box(0.56, 0.5, 0.32, [0, 0.21, 0], 'frock'), box(0.24, 0.3, 0.05, [0, 0.25, 0.17], 'dark'), box(0.1, 0.1, 0.05, [0, 0.27, 0.2], 'eye', { glow: true })],\n      head: [box(0.26, 0.28, 0.28, [0, 0.14, 0], 'bone'), { cyl: [0.46, 0.05, 0.46], at: [0, 0.31, 0], c: 'hat', seg: 8 }, { cyl: [0.3, 0.5, 0.3], at: [0, 0.58, 0], c: 'hat', seg: 8 }, eyes(0.16, 0.15)],\n      ...limbs({ arm: 'frock', hand: 'bone', leg: 'dark', boot: 'dark', armW: 0.17, legW: 0.19 }),\n      handR: [hang(0.13, 0.1, 0.13, 'bone'), box(0.07, 0.07, 1.3, [0, -0.08, 0.4], 'hat'), box(0.34, 0.06, 0.46, [0, -0.08, 1.15], 'steel')],\n    }) }),\n  model({ id: 'grand_chorister', about: 'The Grand Chorister: a Knell Warden, a vast skull that conducts a choir', tags: ['character', 'boss'], floats: true, palette: { bone: 'white', dark: 'ink', eye: 'cyan', rag: 'navy', trim: 'sand' },\n    parts: [box(1.2, 1, 1.24, [0, 1.3, 0], 'bone'), box(0.78, 0.26, 0.74, [0, 0.66, 0.1], 'bone'), box(0.54, 0.24, 0.1, [0, 0.92, 0.62], 'dark'), eyes(1.4, 0.63, 'eye', 0.28, 0.24), { cone: [1.3, 0.5, 1.3], at: [0, 2.04, 0], c: 'rag', seg: 6 }, { cyl: [1.34, 0.1, 1.34], at: [0, 1.84, 0], c: 'trim', seg: 6 }] }),\n  model({ id: 'clapperjaw_prime', about: 'Clapperjaw Prime: the largest of its kind, a Knell Warden', tags: ['character', 'boss'], floats: true, palette: { hide: 'night', plate: 'plum', jaw: 'sand', eye: 'cyan', tongue: 'orange' },\n    parts: [\n      box(1.5, 0.9, 2.3, [0, 1.25, 0], 'hide'), box(1.64, 0.32, 1.7, [0, 1.8, -0.1], 'plate'),\n      { group: [box(1.2, 0.66, 0.96, [0, 0, 0.4], 'hide'), box(1.3, 0.34, 1.1, [0, -0.46, 0.5], 'jaw'), box(1.3, 0.24, 1.1, [0, 0.38, 0.5], 'jaw'), { lathe: [[0.05, 0], [0.12, 0.08], [0.06, 0.42]], at: [0, -0.4, 0.8], c: 'tongue' }, eyes(0.16, 0.9, 'eye', 0.38, 0.14)], name: 'HeadBone', pivot: true, at: [0, 1.5, 1.15] },\n      { mirror: [{ cone: [0.28, 0.6, 0.28], at: [0.6, 2.2, -0.1], c: 'jaw', seg: 5 }, { cone: [0.2, 0.4, 0.2], at: [0.3, 2.14, -0.6], c: 'jaw', seg: 5 }], axis: 'x' },\n    ] }),\n  model({ id: 'malison', about: 'Malison, the Unrung Saint: a huge entombed saint wrapped in bell ropes, stone cracks glowing', tags: ['character', 'boss'], floats: true, palette: { stone: 'mist', dark: 'slate', rope: 'sand', crack: 'cyan', veil: 'navy', eye: 'white', halo: 'orange' },\n    parts: [\n      { lathe: [[1.5, 0], [1.3, 1.0], [1.15, 2.2], [1.05, 3.1], [0.7, 3.5], [0.25, 3.7]], at: [0, 0, 0], c: 'stone' },\n      { group: [box(0.9, 1, 0.9, [0, 0.4, 0.05], 'stone'), box(1.1, 0.9, 1.1, [0, 0.7, -0.08], 'veil'), box(0.66, 0.5, 0.05, [0, 0.42, 0.51], 'dark'), eyes(0.5, 0.54, 'eye', 0.16, 0.16), box(0.34, 0.2, 0.05, [0, 0.14, 0.53], 'crack', { glow: true }), { torus: [1.9, 0.08, 1.9], at: [0, 1.25, -0.1], c: 'halo', glow: true, seg: 12 }], name: 'HeadBone', pivot: true, at: [0, 3.6, 0.05] },\n      // Ropes wrap her. Cracks run through her.\n      { cyl: [2.7, 0.14, 2.7], at: [0, 0.6, 0], c: 'rope', seg: 10 }, { cyl: [2.4, 0.14, 2.4], at: [0, 1.5, 0], c: 'rope', seg: 10, rot: [8, 0, 4] }, { cyl: [2.2, 0.14, 2.2], at: [0, 2.3, 0], c: 'rope', seg: 10, rot: [-6, 0, -6] }, { cyl: [1.7, 0.14, 1.7], at: [0, 3.2, 0], c: 'rope', seg: 10 },\n      box(0.14, 1.8, 0.05, [0.5, 1.5, 1.2], 'crack', { glow: true, rot: [0, 0, 10] }), box(0.14, 1.2, 0.05, [-0.4, 2.3, 1.0], 'crack', { glow: true, rot: [0, 0, -14] }), box(0.8, 0.12, 0.05, [0, 1.1, 1.32], 'crack', { glow: true }),\n    ] }),\n];\n\nexport const CLEMENCY = model({\n  id: 'old_clemency', about: 'Old Clemency, the Great Bell of Vespermoor: cracked, enormous', tags: ['prop', 'bell'], floats: true, palette: { bronze: 'orange', dark: 'plum', crack: 'cyan', beam: 'ink', iron: 'slate' },\n  parts: [\n    { lathe: [[0.3, 5], [1.0, 4.8], [1.5, 4.2], [1.7, 3], [1.9, 1.8], [2.6, 0.3], [2.75, 0], [2.3, 0.05], [0, 0.05]], at: [0, 0, 0], c: 'bronze', seg: 12 },\n    { cyl: [5.6, 0.2, 5.6], at: [0, 0.4, 0], c: 'dark', seg: 12 },\n    { cyl: [3.6, 0.14, 3.6], at: [0, 2.8, 0], c: 'dark', seg: 12 },\n    box(0.2, 3.6, 0.1, [0.5, 2.3, 2.1], 'crack', { glow: true, rot: [0, 0, 12] }), box(0.8, 0.14, 0.1, [0.1, 1.4, 2.3], 'crack', { glow: true }),\n    box(0.8, 0.5, 0.8, [0, 5.1, 0], 'iron'), box(7, 0.5, 0.5, [0, 5.5, 0], 'beam'),\n  ],\n});\nEOF\ncat > src/view/models/props.js <<'EOF'\n// Props the library lacks, composed from library parts where it can.\nimport { model } from '../../../pixel-engine.js';\nimport { box } from './rig.js';\n\nexport const PROP_MODELS = [\n  model({ id: 'gibbet', about: 'A gibbet: a post with an arm and a rusted hanging cage', tags: ['prop', 'gothic'], palette: { wood: 'plum', iron: 'slate', rope: 'sand', dark: 'ink' },\n    parts: [box(0.26, 3.2, 0.26, [0, 1.6, 0], 'wood'), box(1.4, 0.2, 0.2, [0.6, 3.1, 0], 'wood'), box(0.18, 0.9, 0.12, [0.26, 2.7, 0], 'wood', { rot: [0, 0, 40] }), box(0.08, 0.5, 0.08, [1.15, 2.8, 0], 'rope'),\n      { mirror: [box(0.05, 1, 0.05, [1.45, 2.05, 0.3], 'iron'), box(0.05, 1, 0.05, [0.85, 2.05, 0.3], 'iron')], axis: 'z' }, box(0.66, 0.05, 0.66, [1.15, 2.55, 0], 'iron'), box(0.66, 0.05, 0.66, [1.15, 1.55, 0], 'iron'), box(0.5, 0.2, 0.5, [0, 0.1, 0], 'dark')] }),\n  model({ id: 'lychgate', about: 'A roofed graveyard gate, a place the dead may wait', tags: ['prop', 'architecture'], palette: { wood: 'plum', roof: 'night', trim: 'sand', glow: 'lime', stone: 'slate' },\n    parts: [\n      { mirror: [box(0.26, 2.3, 0.26, [1.1, 1.15, 0.5], 'wood')], axis: 'x' }, { mirror: [box(0.26, 2.3, 0.26, [1.1, 1.15, -0.5], 'wood')], axis: 'x' },\n      box(2.6, 0.2, 1.4, [0, 2.36, 0], 'wood'), { wedge: [3.2, 0.8, 1.1], at: [0, 2.86, 0.55], c: 'roof', rot: [0, 180, 0] }, { wedge: [3.2, 0.8, 1.1], at: [0, 2.86, -0.55], c: 'roof' },\n      box(0.16, 0.5, 0.05, [0, 2.0, 0.1], 'trim'), box(0.36, 0.12, 0.05, [0, 2.08, 0.1], 'trim'),\n      box(0.24, 0.26, 0.24, [0, 1.75, 0], 'glow', { glow: true }),\n      { mirror: [box(0.5, 0.3, 0.5, [1.1, 0.15, 0.5], 'stone')], axis: 'x' }, { mirror: [box(0.5, 0.3, 0.5, [1.1, 0.15, -0.5], 'stone')], axis: 'x' },\n    ] }),\n  model({ id: 'knell_font', about: 'The Knell Font: a black water basin that hums when the bell is near', tags: ['prop', 'gothic'], palette: { stone: 'night', water: 'cyan', trim: 'orange', glow: 'sky' },\n    parts: [{ cyl: [1.8, 0.28, 1.8], at: [0, 0.14, 0], c: 'stone', seg: 8 }, { cyl: [0.7, 0.7, 0.7], at: [0, 0.62, 0], c: 'stone', seg: 8 }, { lathe: [[0.3, 0.9], [0.95, 1.1], [1.05, 1.34], [0.85, 1.32], [0.3, 1.14], [0, 1.14]], at: [0, 0, 0], c: 'stone' }, { cyl: [1.7, 0.05, 1.7], at: [0, 1.28, 0], c: 'water', glow: true, seg: 10 }, { torus: [1.3, 0.08, 1.3], at: [0, 2.2, 0], c: 'trim', glow: true, seg: 10 }, box(0.08, 0.6, 0.08, [0, 1.85, 0], 'glow', { glow: true })] }),\n  model({ id: 'votive_rack', about: 'A rack of votive candles, one use, a blessing', tags: ['prop', 'church'], palette: { iron: 'slate', wax: 'white', flame: 'orange', dark: 'ink' },\n    parts: [box(1.2, 0.08, 0.5, [0, 0.9, 0], 'iron'), box(1.2, 0.08, 0.5, [0, 0.5, 0.12], 'iron'), { mirror: [box(0.08, 1.1, 0.08, [0.56, 0.55, 0], 'iron')], axis: 'x' },\n      ...[-0.42, -0.14, 0.14, 0.42].flatMap((x) => [box(0.09, 0.18, 0.09, [x, 1.03, 0], 'wax'), box(0.05, 0.1, 0.05, [x, 1.17, 0], 'flame', { glow: true })]),\n      ...[-0.3, 0, 0.3].flatMap((x) => [box(0.09, 0.14, 0.09, [x, 0.61, 0.12], 'wax'), box(0.05, 0.1, 0.05, [x, 0.73, 0.12], 'flame', { glow: true })]),\n      box(0.3, 0.4, 0.06, [0, 1.3, -0.2], 'dark')] }),\n  model({ id: 'votive_rack_spent', about: 'A rack of votive candles, all burned out', tags: ['prop', 'church'], palette: { iron: 'slate', wax: 'mist', dark: 'ink' },\n    parts: [box(1.2, 0.08, 0.5, [0, 0.9, 0], 'iron'), box(1.2, 0.08, 0.5, [0, 0.5, 0.12], 'iron'), { mirror: [box(0.08, 1.1, 0.08, [0.56, 0.55, 0], 'iron')], axis: 'x' }, ...[-0.42, -0.14, 0.14, 0.42].map((x) => box(0.09, 0.07, 0.09, [x, 0.97, 0], 'wax')), box(0.3, 0.4, 0.06, [0, 1.3, -0.2], 'dark')] }),\n  model({ id: 'ledger', about: 'The Ledger: a thick account book chained shut, on a stand', tags: ['prop', 'book'], palette: { cover: 'red', page: 'white', chain: 'sand', wood: 'plum' },\n    parts: [box(0.14, 0.7, 0.14, [0, 0.35, 0], 'wood'), box(0.6, 0.05, 0.46, [0, 0.72, 0], 'wood'), box(0.66, 0.14, 0.5, [0, 0.82, 0], 'cover'), box(0.6, 0.08, 0.44, [0, 0.86, 0.02], 'page'), box(0.06, 0.16, 0.54, [0.12, 0.84, 0], 'chain')] }),\n  model({ id: 'abacus', about: 'A big abacus on a stand', tags: ['prop'], palette: { wood: 'plum', bead: 'sand', rod: 'slate' },\n    parts: [box(1, 0.08, 0.12, [0, 1.2, 0], 'wood'), box(1, 0.08, 0.12, [0, 0.5, 0], 'wood'), { mirror: [box(0.08, 1.2, 0.12, [0.5, 0.6, 0], 'wood')], axis: 'x' }, ...[0.65, 0.85, 1.05].flatMap((y) => [box(0.92, 0.03, 0.04, [0, y, 0], 'rod'), box(0.1, 0.1, 0.1, [-0.2, y, 0], 'bead'), box(0.1, 0.1, 0.1, [0.1, y, 0], 'bead'), box(0.1, 0.1, 0.1, [0.25, y, 0], 'bead')])] }),\n  model({ id: 'coin_pile', about: 'A heap of tithed coin in an open coffer', tags: ['prop', 'treasure'], palette: { coin: 'sand', dark: 'orange', wood: 'plum' },\n    parts: [box(1.1, 0.34, 0.8, [0, 0.17, 0], 'wood'), { lump: [1, 0.5, 0.74], at: [0, 0.46, 0], c: 'dark', seed: 3 }, { lump: [0.7, 0.3, 0.5], at: [0, 0.68, 0], c: 'coin', seed: 5 }] }),\n  model({ id: 'bell_rope', about: 'A great bell rope hanging from the dark, with a sally', tags: ['prop', 'bell'], floats: true, palette: { rope: 'sand', sally: 'red', dark: 'orange', knot: 'plum' },\n    parts: [box(0.14, 8, 0.14, [0, 5, 0], 'rope'), box(0.26, 1, 0.26, [0, 1.8, 0], 'sally'), box(0.24, 0.3, 0.24, [0, 1.05, 0], 'knot'), box(0.16, 0.8, 0.16, [0, 0.55, 0], 'dark')] }),\n  model({ id: 'pallbearer_coffin', about: 'A plain coffin with brass bands, dropped from above', tags: ['prop', 'gothic'], palette: { wood: 'plum', band: 'sand', dark: 'ink' },\n    parts: [box(0.86, 0.5, 2, [0, 0.25, 0], 'wood'), box(0.9, 0.06, 0.2, [0, 0.3, 0.4], 'band'), box(0.9, 0.06, 0.2, [0, 0.3, -0.4], 'band'), box(0.76, 0.05, 1.86, [0, 0.52, 0], 'dark'), box(0.1, 0.08, 0.5, [0, 0.58, 0.15], 'band'), box(0.34, 0.08, 0.1, [0, 0.58, 0.28], 'band')] }),\n  model({ id: 'unquiet_coffin', about: 'An Unquiet Coffin, upright and chained, rattling', tags: ['prop', 'gothic'], palette: { wood: 'night', band: 'sand', chain: 'slate', glow: 'red', dark: 'ink' },\n    parts: [box(1, 2, 0.5, [0, 1.1, 0], 'wood'), box(1.04, 0.1, 0.54, [0, 0.6, 0], 'chain'), box(1.04, 0.1, 0.54, [0, 1.5, 0], 'chain'), box(0.1, 1.9, 0.52, [0, 1.1, 0], 'chain'), box(0.2, 0.3, 0.05, [0, 1.65, 0.26], 'glow', { glow: true }), box(0.9, 0.2, 0.6, [0, 0.1, 0], 'dark')] }),\n  model({ id: 'wagon_of_bells', about: 'A wagon piled with church bells, every bell on the moor', tags: ['prop', 'vehicle'], palette: { wood: 'plum', wheel: 'night', bronze: 'orange', iron: 'slate', bronze2: 'sand' },\n    parts: [box(1.8, 0.2, 3.2, [0, 0.7, 0], 'wood'), box(1.9, 0.5, 0.12, [0, 1, 1.55], 'wood'), box(1.9, 0.5, 0.12, [0, 1, -1.55], 'wood'), { mirror: [box(0.1, 0.5, 3.2, [0.9, 1, 0], 'wood')], axis: 'x' },\n      ...[[-1, 1], [1, 1], [-1, -1], [1, -1]].map(([x, z]) => ({ cyl: [0.8, 0.16, 0.8], at: [x, 0.4, z], c: 'wheel', seg: 10, rot: [0, 0, 90] })),\n      { lathe: [[0.06, 1], [0.22, 0.9], [0.3, 0.6], [0.5, 0.05], [0, 0.05]], at: [0, 0.76, 0.7], c: 'bronze' }, { lathe: [[0.05, 0.7], [0.18, 0.6], [0.22, 0.4], [0.38, 0.04], [0, 0.04]], at: [-0.35, 0.76, -0.5], c: 'bronze2' }, { lathe: [[0.05, 0.6], [0.14, 0.5], [0.2, 0.3], [0.32, 0.04], [0, 0.04]], at: [0.4, 0.76, -0.8], c: 'bronze' }, box(0.1, 0.1, 1.4, [0, 0.4, 2.2], 'wood')] }),\n  model({ id: 'writ_board', about: 'The parish board with writs nailed to it', tags: ['prop', 'town'], palette: { wood: 'plum', paper: 'white', paper2: 'sand', seal: 'red' },\n    parts: [{ use: 'notice-board' }, box(0.4, 0.5, 0.04, [-0.3, 1.45, 0.14], 'paper'), box(0.4, 0.5, 0.04, [0.3, 1.5, 0.14], 'paper2'), box(0.08, 0.08, 0.04, [0.3, 1.32, 0.17], 'seal')] }),\n  model({ id: 'collection_box', about: 'The Collection Box: a big iron-bound poor box, shared by all', tags: ['prop', 'town'], palette: { wood: 'plum', iron: 'slate', slot: 'ink', gold: 'sand' },\n    parts: [box(1.3, 1, 0.9, [0, 0.5, 0], 'wood'), box(1.36, 0.1, 0.96, [0, 0.2, 0], 'iron'), box(1.36, 0.1, 0.96, [0, 0.8, 0], 'iron'), box(0.1, 1.04, 0.94, [0, 0.5, 0], 'iron'), box(0.5, 0.06, 0.1, [0, 1.02, 0.1], 'slot'), box(0.2, 0.24, 0.05, [0, 0.55, 0.46], 'gold')] }),\n  model({ id: 'portal_way', about: 'The way back: a hanging bell of light', tags: ['prop', 'magic'], floats: true, palette: { glow: 'cyan', core: 'white' },\n    parts: [{ torus: [1.6, 0.14, 1.6], at: [0, 1.3, 0], c: 'glow', glow: true, seg: 12, rot: [90, 0, 0] }, box(0.14, 1.5, 0.14, [0, 1.3, 0], 'core', { glow: true }), box(1, 0.1, 0.1, [0, 1.3, 0], 'core', { glow: true })] }),\n  model({ id: 'class_font', about: 'A small font of class-coloured fire, for changing your trade', tags: ['prop', 'magic'], palette: { stone: 'night', fire: 'orange' },\n    parts: [{ cyl: [0.9, 0.3, 0.9], at: [0, 0.15, 0], c: 'stone', seg: 8 }, { cone: [0.4, 0.8, 0.4], at: [0, 0.7, 0], c: 'fire', glow: true, seg: 5 }] }),\n  model({ id: 'relic_altar', about: 'An altar bearing a holy bone', tags: ['prop', 'church'], palette: { stone: 'mist', bone: 'white', cloth: 'red', glow: 'sand' },\n    parts: [{ use: 'altar' }, box(0.5, 0.1, 0.12, [0, 1.2, 0], 'bone', { rot: [0, 30, 0] }), box(0.14, 0.14, 0.14, [0.24, 1.22, 0.1], 'bone'), box(0.14, 0.14, 0.14, [-0.24, 1.22, -0.1], 'bone'), box(0.1, 0.1, 0.1, [0, 1.5, 0], 'glow', { glow: true })] }),\n];\nEOF\ncat > src/view/models/index.js <<'EOF'\n// Where the game's model ids resolve: the library and ours.\nimport { MODEL_LIBRARY, ModelCatalog } from '../../../pixel-engine.js';\nimport { GEAR_MODELS, bellwardenBody, censer, handBell, handLantern, lamplighterBody, pyxBody, sextonBody } from './heroes.js';\nimport { MONSTER_MODELS } from './monsters.js';\nimport { CLEMENCY, NPC_MODELS } from './npcs.js';\nimport { PROP_MODELS } from './props.js';\n\nexport const OWN_MODELS = [bellwardenBody, lamplighterBody, sextonBody, pyxBody, handBell, handLantern, censer, ...GEAR_MODELS, ...MONSTER_MODELS, ...NPC_MODELS, CLEMENCY, ...PROP_MODELS];\nexport const MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), ...OWN_MODELS]);\nexport const OWN = OWN_MODELS;\nEOF\ncat > .scratch/modelcheck.mjs <<'EOF'\nimport { checkModel } from '../pixel-engine.js';\nimport { MODELS, OWN_MODELS } from '../src/view/models/index.js';\nlet bad=0, warn=0;\nfor (const d of OWN_MODELS) { const r=checkModel(d,{catalog:MODELS}); if(r.problems.length){bad++;console.log('PROBLEM',d.id,r.problems.slice(0,4).join(' | ').slice(0,400));} if(process.argv[2]&&r.warnings.length){warn++;console.log('warn',d.id,r.warnings.slice(0,3).join(' | ').slice(0,300));} }\nconsole.log('models',OWN_MODELS.length,'bad',bad);\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/modelcheck.mjs 2>&1 | tail -n 30 | cut -c1-500","description":"Write all model definitions and check them","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7331,"cache_read_input_tokens":472517,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7331},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"1b278482-6f82-42e3-b5b9-7072d9b42b0d","timestamp":"2026-11-06T00:06:21.701Z","request_id":"req_011CgkhBrTmXhFAvXeMaz8Nz","wire_tool_inputs":{"toolu_018wdQrjPwPWbfESDUG7vovY":{"command":"cat > src/view/models/rig.js <<'EOF'\n// The body template: nested pivots named after the hero rig's joints, so every humanoid animates\n// with the hero's clips. Keep the pivots; change the shapes between them.\nexport const j = (name, at, kids = []) => ({ group: kids, name, pivot: true, at });\nexport const hang = (w, h, d, c, extra = {}) => ({ box: [w, h, d], at: [0, -h / 2, 0], c, ...extra });\nexport const box = (w, h, d, at, c, extra = {}) => ({ box: [w, h, d], at, c, ...extra });\n\nexport const humanoid = ({ hips = [], chest = [], head = [], upperArm = [], foreArm = [], handR = [], handL = [], thigh = [], shin = [], foot = [], armLExtra = [], armRExtra = [] }) => [\n  j('Pelvis', [0, 0.62, 0], [...hips,\n    j('Torso', [0, 0.05, 0], [...chest,\n      j('Head', [0, 0.5, 0], head),\n      j('ArmR', [-0.27, 0.42, 0], [...upperArm, ...armRExtra, j('ForearmR', [0, -0.25, 0], [...foreArm, j('HandR', [0, -0.16, 0], handR)])]),\n      j('ArmL', [0.27, 0.42, 0], [...upperArm, ...armLExtra, j('ForearmL', [0, -0.25, 0], [...foreArm, j('HandL', [0, -0.16, 0], handL)])]),\n    ]),\n    j('LegR', [-0.14, 0, 0], [...thigh, j('ShinR', [0, -0.3, 0], [...shin, j('FootR', [0, -0.22, 0], foot)])]),\n    j('LegL', [0.14, 0, 0], [...thigh, j('ShinL', [0, -0.3, 0], [...shin, j('FootL', [0, -0.22, 0], foot)])]),\n  ]),\n];\n\n// Ordinary limbs, in slots named by the body.\nexport const limbs = ({ arm = 'cloth', hand = 'skin', leg = 'cloth', boot = 'boot', armW = 0.14, legW = 0.17 }) => ({\n  upperArm: [hang(armW, 0.26, armW, arm)],\n  foreArm: [hang(armW - 0.01, 0.17, armW - 0.01, arm)],\n  handR: [hang(0.12, 0.11, 0.12, hand)],\n  handL: [hang(0.12, 0.11, 0.12, hand)],\n  thigh: [hang(legW, 0.31, legW, leg)],\n  shin: [hang(legW - 0.02, 0.23, legW - 0.02, leg)],\n  foot: [box(0.17, 0.11, 0.3, [0, -0.045, 0.05], boot)],\n});\nexport const eyes = (y, z, c = 'eye', dx = 0.07, size = 0.06) => ({ mirror: [{ box: [size, size, 0.04], at: [dx, y, z], c, glow: true }], axis: 'x' });\nEOF\ncat > src/view/models/heroes.js <<'EOF'\n// The three trades, Sister Pyx, and the gear that changes their silhouettes.\nimport { model } from '../../../pixel-engine.js';\nimport { box, eyes, hang, humanoid, limbs } from './rig.js';\n\nconst base = { tags: ['character', 'hero'] };\n\nexport const bellwardenBody = model({\n  id: 'hero_bellwarden', about: 'The Bellwarden: square shoulders, cowl, bronze trim', ...base,\n  palette: { robe: 'plum', trim: 'orange', skin: 'sand', boot: 'night', dark: 'ink', metal: 'slate' },\n  parts: humanoid({\n    hips: [box(0.4, 0.22, 0.28, [0, 0, 0], 'robe'), box(0.44, 0.07, 0.31, [0, 0.1, 0], 'trim')],\n    chest: [box(0.52, 0.46, 0.32, [0, 0.21, 0], 'robe'), box(0.2, 0.42, 0.04, [0, 0.21, 0.165], 'trim'), box(0.58, 0.1, 0.34, [0, 0.42, 0], 'metal')],\n    head: [box(0.28, 0.3, 0.28, [0, 0.14, 0], 'skin'), box(0.34, 0.34, 0.32, [0, 0.17, -0.03], 'robe'), box(0.22, 0.14, 0.04, [0, 0.14, 0.14], 'dark'), eyes(0.15, 0.165, 'trim', 0.06, 0.05)],\n    ...limbs({ arm: 'robe', hand: 'metal', leg: 'dark', armW: 0.16, legW: 0.18 }),\n    armRExtra: [box(0.26, 0.14, 0.26, [-0.02, 0.02, 0], 'metal')],\n    armLExtra: [box(0.26, 0.14, 0.26, [0.02, 0.02, 0], 'metal')],\n  }),\n});\n\nexport const lamplighterBody = model({\n  id: 'hero_lamplighter', about: 'The Lamplighter: wide-brim hat, long coat, a lamp pole on the back', ...base,\n  palette: { coat: 'navy', trim: 'sand', skin: 'mist', boot: 'night', hat: 'ink', metal: 'slate', flame: 'orange' },\n  parts: humanoid({\n    hips: [box(0.36, 0.22, 0.26, [0, 0, 0], 'coat'), box(0.42, 0.42, 0.28, [0, -0.2, -0.02], 'coat'), box(0.06, 0.5, 0.04, [0, -0.15, 0.135], 'trim')],\n    chest: [box(0.44, 0.46, 0.28, [0, 0.21, 0], 'coat'), box(0.06, 0.44, 0.04, [0, 0.21, 0.145], 'trim'),\n      box(0.05, 1.5, 0.05, [0.12, 0.6, -0.2], 'metal'), box(0.28, 0.05, 0.05, [0.12, 1.3, -0.2], 'metal'), box(0.18, 0.2, 0.18, [0.26, 1.18, -0.2], 'metal'), box(0.1, 0.13, 0.1, [0.26, 1.17, -0.2], 'flame', { glow: true })],\n    head: [box(0.26, 0.28, 0.26, [0, 0.14, 0], 'skin'), { cyl: [0.74, 0.05, 0.74], at: [0, 0.28, 0], c: 'hat', seg: 8 }, { cyl: [0.32, 0.2, 0.32], at: [0, 0.38, 0], c: 'hat', seg: 8 }, box(0.2, 0.05, 0.05, [0, 0.14, 0.13], 'hat')],\n    ...limbs({ arm: 'coat', hand: 'skin', leg: 'hat' }),\n  }),\n});\n\nexport const sextonBody = model({\n  id: 'hero_sexton', about: 'The Sexton: stovepipe hat, black frock, grey face', ...base,\n  palette: { frock: 'ink', accent: 'lime', skin: 'mist', boot: 'night', hat: 'night', shirt: 'slate' },\n  parts: humanoid({\n    hips: [box(0.36, 0.22, 0.26, [0, 0, 0], 'frock'), box(0.4, 0.34, 0.27, [0, -0.17, -0.01], 'frock')],\n    chest: [box(0.46, 0.46, 0.28, [0, 0.21, 0], 'frock'), box(0.14, 0.34, 0.04, [0, 0.25, 0.145], 'shirt'), box(0.05, 0.12, 0.05, [0, 0.34, 0.175], 'accent', { glow: true })],\n    head: [box(0.26, 0.3, 0.26, [0, 0.15, 0], 'skin'), { cyl: [0.42, 0.05, 0.42], at: [0, 0.31, 0], c: 'hat', seg: 8 }, { cyl: [0.28, 0.44, 0.28], at: [0, 0.54, 0], c: 'hat', seg: 8 }, { cyl: [0.29, 0.05, 0.29], at: [0, 0.36, 0], c: 'accent', seg: 8 }, eyes(0.17, 0.135, 'accent', 0.06, 0.05)],\n    ...limbs({ arm: 'frock', hand: 'skin', leg: 'hat' }),\n  }),\n});\n\nexport const pyxBody = model({\n  id: 'npc_pyx', about: 'Sister Pyx: armoured nun with a wimple and a crossbow', ...base,\n  palette: { plate: 'mist', wimple: 'white', veil: 'ink', skin: 'sand', boot: 'slate', cross: 'red' },\n  parts: humanoid({\n    hips: [box(0.38, 0.22, 0.26, [0, 0, 0], 'plate'), box(0.42, 0.32, 0.28, [0, -0.17, -0.01], 'veil')],\n    chest: [box(0.46, 0.46, 0.28, [0, 0.21, 0], 'plate'), box(0.05, 0.28, 0.04, [0, 0.24, 0.145], 'cross'), box(0.2, 0.05, 0.04, [0, 0.3, 0.145], 'cross')],\n    head: [box(0.24, 0.26, 0.24, [0, 0.13, 0], 'skin'), box(0.32, 0.36, 0.32, [0, 0.16, -0.04], 'veil'), box(0.26, 0.1, 0.05, [0, 0.27, 0.11], 'wimple'), box(0.26, 0.08, 0.05, [0, 0.0, 0.11], 'wimple')],\n    ...limbs({ arm: 'plate', hand: 'plate', leg: 'veil' }),\n  }),\n});\n\nconst TIER_COLOR = ['slate', 'sky', 'sand'];\n\n/** Helms and shoulders by class and tier: 0 plain, 1 blessed, 2 reliquary and up. */\nfunction helm(cls, tier) {\n  const c = TIER_COLOR[tier];\n  const parts = {\n    bellwarden: [box(0.36, 0.1, 0.34, [0, 0.31, -0.02], 'tier'), box(0.08, 0.12, 0.34, [0, 0.4, -0.02], 'tier'), ...(tier > 1 ? [{ cone: [0.2, 0.26, 0.2], at: [0, 0.56, -0.02], c: 'tier', seg: 6 }] : []), ...(tier > 0 ? [box(0.05, 0.2, 0.05, [0.2, 0.32, 0], 'tier'), box(0.05, 0.2, 0.05, [-0.2, 0.32, 0], 'tier')] : [])],\n    lamplighter: [{ cyl: [0.36, 0.05, 0.36], at: [0, 0.46, 0], c: 'tier', seg: 8 }, ...(tier > 0 ? [box(0.28, 0.05, 0.05, [0, 0.33, 0.33], 'tier')] : []), ...(tier > 1 ? [box(0.1, 0.1, 0.1, [0, 0.54, 0], 'gem', { glow: true })] : [])],\n    sexton: [{ cyl: [0.3, 0.05, 0.3], at: [0, 0.72, 0], c: 'tier', seg: 8 }, ...(tier > 0 ? [box(0.08, 0.12, 0.05, [0.17, 0.4, 0], 'tier')] : []), ...(tier > 1 ? [box(0.1, 0.1, 0.1, [0, 0.82, 0], 'gem', { glow: true })] : [])],\n  }[cls];\n  return model({ id: `helm_${cls}_${tier}`, about: `Headgear for the ${cls}, tier ${tier}`, tags: ['gear'], palette: { tier: c, gem: tier > 1 ? 'orange' : 'sky' }, floats: true, parts });\n}\nfunction shoulder(cls, tier) {\n  const c = TIER_COLOR[tier];\n  const w = 0.2 + tier * 0.05;\n  const parts = [box(w, 0.1 + tier * 0.02, w + 0.02, [0, 0.03, 0], 'tier'), ...(tier > 0 ? [{ cone: [0.1, 0.16 + tier * 0.04, 0.1], at: [0, 0.14 + tier * 0.03, 0], c: 'tier', seg: 5 }] : []), ...(cls === 'bellwarden' && tier > 1 ? [box(w + 0.04, 0.05, w + 0.06, [0, -0.04, 0], 'gem')] : [])];\n  return model({ id: `shoulder_${cls}_${tier}`, about: `A shoulder piece for the ${cls}, tier ${tier}`, tags: ['gear'], palette: { tier: c, gem: 'orange' }, floats: true, parts });\n}\n\nexport const GEAR_MODELS = [];\nfor (const cls of ['bellwarden', 'lamplighter', 'sexton']) for (const t of [0, 1, 2]) GEAR_MODELS.push(helm(cls, t), shoulder(cls, t));\n\n// Off-hands and the signature weapon the library lacks.\nexport const handBell = model({\n  id: 'hand-bell-weapon', about: 'A consecrated hand-bell the size of an anvil, on a short chain handle', tags: ['weapon', 'bell'], palette: { bronze: 'orange', dark: 'plum', chain: 'slate', clap: 'sand' },\n  parts: [\n    { box: [0.08, 0.34, 0.08], at: [0, 0.17, 0], c: 'chain' },\n    { lathe: [[0.05, 0.62], [0.13, 0.6], [0.18, 0.5], [0.22, 0.38], [0.32, 0.3], [0, 0.3]], at: [0, 0, 0], c: 'bronze' },\n    { box: [0.5, 0.05, 0.08], at: [0, 0.32, 0], c: 'dark' },\n    { ball: [0.1, 0.1, 0.1], at: [0, 0.24, 0], c: 'clap' },\n  ],\n});\nexport const handLantern = model({\n  id: 'hand-lantern', about: 'A square hand lantern with a glowing core', tags: ['weapon', 'light'], palette: { frame: 'slate', fire: 'orange', cap: 'night' },\n  parts: [\n    box(0.26, 0.05, 0.26, [0, 0.03, 0], 'frame'), box(0.14, 0.2, 0.14, [0, 0.16, 0], 'fire', { glow: true }),\n    { mirror: [box(0.04, 0.26, 0.04, [0.11, 0.17, 0.11], 'frame'), box(0.04, 0.26, 0.04, [-0.11, 0.17, 0.11], 'frame')], axis: 'z' },\n    { cone: [0.3, 0.12, 0.3], at: [0, 0.36, 0], c: 'cap', seg: 4 }, box(0.05, 0.12, 0.05, [0, 0.47, 0], 'frame'),\n  ],\n});\nexport const censer = model({\n  id: 'censer', about: 'A swinging censer on a chain, trailing smoke', tags: ['weapon', 'church'], palette: { brass: 'sand', chain: 'slate', fire: 'lime' },\n  parts: [\n    { lathe: [[0.06, 0], [0.17, 0.05], [0.18, 0.14], [0.12, 0.22], [0.03, 0.27]], at: [0, 0, 0], c: 'brass' },\n    box(0.1, 0.04, 0.1, [0, 0.18, 0], 'fire', { glow: true }),\n    box(0.05, 0.3, 0.05, [0, 0.42, 0], 'chain'),\n  ],\n});\nEOF\ncat > src/view/models/monsters.js <<'EOF'\n// Everything that wants you back in the ground.\nimport { model } from '../../../pixel-engine.js';\nimport { box, eyes, hang, humanoid, limbs } from './rig.js';\n\nconst tags = ['character', 'monster'];\nconst bone = { upperArm: [hang(0.08, 0.26, 0.08, 'bone')], foreArm: [hang(0.07, 0.17, 0.07, 'bone')], handR: [hang(0.1, 0.08, 0.1, 'bone')], handL: [hang(0.1, 0.08, 0.1, 'bone')], thigh: [hang(0.09, 0.31, 0.09, 'bone')], shin: [hang(0.08, 0.23, 0.08, 'bone')], foot: [box(0.12, 0.08, 0.24, [0, -0.06, 0.04], 'bone')] };\n\nexport const MONSTER_MODELS = [\n  model({ id: 'peatwalker', about: 'Peatwalker: a slumped bog corpse, dripping mud', tags, palette: { mud: 'slate', dark: 'night', skin: 'teal', eye: 'lime', rot: 'plum' },\n    parts: humanoid({\n      hips: [box(0.36, 0.22, 0.26, [0, 0, 0], 'mud')],\n      chest: [box(0.46, 0.44, 0.3, [0, 0.2, 0.02], 'mud'), box(0.22, 0.16, 0.05, [0.08, 0.28, 0.17], 'rot'), box(0.14, 0.2, 0.05, [-0.14, 0.12, 0.17], 'dark')],\n      head: [box(0.27, 0.27, 0.27, [0, 0.13, 0.03], 'skin'), box(0.3, 0.1, 0.3, [0, 0.29, 0.02], 'dark'), eyes(0.15, 0.175), box(0.16, 0.05, 0.04, [0, 0.05, 0.175], 'dark')],\n      ...limbs({ arm: 'skin', hand: 'dark', leg: 'dark', boot: 'mud', armW: 0.14, legW: 0.17 }),\n    }) }),\n  model({ id: 'gibbet_drop', about: 'Gibbet Drop: a thin hanged man who fell, rope still on', tags, palette: { skin: 'mist', rag: 'plum', rope: 'sand', eye: 'red', dark: 'night' },\n    parts: humanoid({\n      hips: [box(0.3, 0.2, 0.22, [0, 0, 0], 'rag')],\n      chest: [box(0.36, 0.44, 0.22, [0, 0.2, 0], 'rag'), box(0.3, 0.1, 0.24, [0, 0.38, 0], 'skin')],\n      head: [box(0.24, 0.27, 0.24, [0, 0.14, 0.05], 'skin'), box(0.26, 0.06, 0.26, [0, -0.0, 0.03], 'rope'), box(0.06, 0.4, 0.06, [0, 0.2, -0.16], 'rope'), eyes(0.16, 0.175, 'eye')],\n      ...limbs({ arm: 'skin', hand: 'dark', leg: 'dark', boot: 'skin', armW: 0.09, legW: 0.11 }),\n    }) }),\n  model({ id: 'rattlebones', about: 'Rattlebones: a fast skeleton with a rusted sword', tags, palette: { bone: 'mist', dark: 'night', eye: 'lime', rust: 'orange', steel: 'slate' },\n    parts: humanoid({\n      hips: [box(0.26, 0.1, 0.16, [0, 0.02, 0], 'bone')],\n      chest: [box(0.08, 0.32, 0.08, [0, 0.16, 0], 'bone'), box(0.34, 0.08, 0.2, [0, 0.36, 0], 'bone'), box(0.3, 0.07, 0.18, [0, 0.24, 0], 'bone'), box(0.26, 0.06, 0.16, [0, 0.14, 0], 'bone')],\n      head: [box(0.24, 0.24, 0.26, [0, 0.14, 0.02], 'bone'), box(0.16, 0.06, 0.14, [0, 0.02, 0.05], 'bone'), eyes(0.15, 0.155)],\n      ...bone,\n      handR: [hang(0.1, 0.08, 0.1, 'bone'), box(0.07, 0.07, 0.8, [0, -0.08, 0.4], 'steel'), box(0.2, 0.05, 0.05, [0, -0.08, 0.08], 'rust')],\n    }) }),\n  model({ id: 'choir_skull', about: 'Choir Skull: a floating singing skull with an open jaw', tags, floats: true, palette: { bone: 'mist', dark: 'ink', eye: 'sky', rag: 'plum' },\n    parts: [\n      box(0.5, 0.42, 0.52, [0, 0.5, 0], 'bone'), box(0.32, 0.12, 0.3, [0, 0.2, 0.05], 'bone'), box(0.22, 0.12, 0.06, [0, 0.3, 0.26], 'dark'),\n      eyes(0.54, 0.27, 'eye', 0.12, 0.11),\n      { cone: [0.5, 0.16, 0.5], at: [0, 0.78, 0], c: 'rag', seg: 6 },\n    ] }),\n  model({ id: 'pallid_bearer', about: 'Pallid Bearer: a huge grey pallbearer who swings his coffin', tags, palette: { skin: 'mist', robe: 'slate', dark: 'ink', eye: 'white', wood: 'plum', band: 'sand' },\n    parts: humanoid({\n      hips: [box(0.46, 0.24, 0.32, [0, 0, 0], 'robe'), box(0.52, 0.34, 0.34, [0, -0.17, 0], 'robe')],\n      chest: [box(0.62, 0.5, 0.38, [0, 0.22, 0], 'robe'), box(0.7, 0.16, 0.42, [0, 0.42, 0], 'dark')],\n      head: [box(0.26, 0.26, 0.26, [0, 0.12, 0.04], 'skin'), box(0.3, 0.14, 0.3, [0, 0.26, 0.03], 'dark'), eyes(0.13, 0.175, 'eye')],\n      ...limbs({ arm: 'skin', hand: 'dark', leg: 'dark', boot: 'dark', armW: 0.18, legW: 0.2 }),\n      handR: [hang(0.14, 0.11, 0.14, 'dark'), box(0.42, 0.26, 1.2, [0.27, -0.1, 0.25], 'wood'), box(0.46, 0.06, 0.2, [0.27, -0.1, 0.3], 'band')],\n    }) }),\n  model({ id: 'tomb_crawler', about: 'Tomb Crawler: a pale segmented thing, low to the ground', tags, floats: true, palette: { shell: 'plum', pale: 'mist', eye: 'red' },\n    parts: [box(0.34, 0.16, 0.5, [0, 0.27, 0], 'shell'), box(0.26, 0.14, 0.2, [0, 0.25, 0.3], 'pale'), box(0.2, 0.1, 0.2, [0, 0.3, -0.28], 'shell'), eyes(0.28, 0.41, 'eye', 0.07, 0.05)] }),\n  model({ id: 'bloat_deacon', about: 'Bloat Deacon: a swollen clergyman, a walking sack of grave gas', tags, palette: { skin: 'lime', robe: 'teal', collar: 'white', eye: 'red', dark: 'night' },\n    parts: [\n      { group: [{ ball: [1, 1, 1], at: [0, 0.65, 0], c: 'robe', seg: 8 }, { ball: [0.5, 0.42, 0.5], at: [0, 1.2, 0.1], c: 'skin', seg: 8 }, box(0.4, 0.07, 0.4, [0, 1.03, 0.08], 'collar'), eyes(1.26, 0.33, 'eye', 0.1, 0.07), box(0.16, 0.05, 0.04, [0, 1.1, 0.35], 'dark'), { ball: [0.3, 0.3, 0.3], at: [0.28, 0.72, 0.36], c: 'skin', seg: 6 }, { ball: [0.22, 0.22, 0.22], at: [-0.32, 0.5, 0.34], c: 'skin', seg: 6 }], name: 'Blob', pivot: true, at: [0, 0, 0] },\n    ] }),\n  model({ id: 'cinderling', about: 'Cinderling: a small burning imp of the Unrung', tags, palette: { skin: 'ink', ember: 'orange', eye: 'sand', hot: 'red' },\n    parts: humanoid({\n      hips: [box(0.3, 0.2, 0.22, [0, 0, 0], 'skin')],\n      chest: [box(0.4, 0.42, 0.26, [0, 0.2, 0], 'skin'), box(0.2, 0.2, 0.04, [0, 0.2, 0.135], 'ember', { glow: true }), { mirror: [{ cone: [0.1, 0.18, 0.1], at: [0.2, 0.46, 0], c: 'hot' }], axis: 'x' }],\n      head: [box(0.34, 0.3, 0.32, [0, 0.14, 0.02], 'skin'), eyes(0.16, 0.185, 'eye', 0.09, 0.08), { mirror: [{ cone: [0.08, 0.18, 0.08], at: [0.13, 0.36, 0], c: 'hot' }], axis: 'x' }, { cone: [0.2, 0.2, 0.2], at: [0, 0.4, -0.05], c: 'ember', glow: true, seg: 5 }],\n      ...limbs({ arm: 'skin', hand: 'ember', leg: 'skin', boot: 'hot', armW: 0.12, legW: 0.14 }),\n    }) }),\n  model({ id: 'tithe_collector', about: 'Tithe Collector: a thin demon clerk with a ledger and a hook', tags, palette: { coat: 'plum', skin: 'red', ledger: 'sand', hook: 'slate', eye: 'lime', dark: 'ink' },\n    parts: humanoid({\n      hips: [box(0.34, 0.2, 0.24, [0, 0, 0], 'coat'), box(0.38, 0.34, 0.26, [0, -0.17, 0], 'coat')],\n      chest: [box(0.42, 0.46, 0.26, [0, 0.21, 0], 'coat'), box(0.1, 0.34, 0.04, [0, 0.24, 0.135], 'dark')],\n      head: [box(0.24, 0.3, 0.2