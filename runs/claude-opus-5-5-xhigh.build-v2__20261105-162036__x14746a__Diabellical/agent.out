4 C4:4 r:4 D4:4 r:4 A3:12 r:32')\",\"lead: S('D4:4 r:4 C4:4 r:4 D4:4 r:4 A3:12 r:28')\")\ns=s.replace(\"E5:2 C5:2 D5:8 r:16'), bass: rep(S('D3:2 A2:2'), 8) + ' ' + rep(S('D3:2 A2:2'), 8)\",\"E5:2 C5:2 D5:8'), bass: rep(S('D3:2 A2:2'), 8) + ' ' + rep(S('D3:2 A2:2'), 8)\")\ns=s.replace(\"C#5:4 A4:12 r:4'), bass: rep(S('D2 D3'), 8)\",\"C#5:4 A4:4'), bass: rep(S('D2 D3'), 8)\")\nopen(p,'w').write(s)\nEOF\ntimeout 100 node .scratch/audiocheck.mjs 2>&1 | tail -n 5 | cut -c1-260; grep -n \"^### class Settings\" -A18 API.md | cut -c1-240; sed -n 358,372p API.md | cut -c1-200; grep -n \"GAMEPAD_BUTTONS\\|^### interface GamepadLike\" -A5 API.md | head -14 | cut -c1-200;grep -n \"cursor\" API.md | head -3 | cut -c1-160; grep -n \"get canvas\\|canvas:\" API.md | head -8 | cut -c1-200","description":"Fix song lengths and read settings and input details","timeout":120000}}}
