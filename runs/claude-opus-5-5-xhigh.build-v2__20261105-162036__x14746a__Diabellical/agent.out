{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkfm5xp4BdCCx9yZH5Ng","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ae48Rm4nahDFh8nC2QH3e4","name":"Bash","input":{"command":"mkdir -p src/data/rooms\ncat > src/data/rooms/shared.js <<'EOF'\n// ASCII room templates shared by the indoor biomes. Legend:\n// # wall   . floor   ~ water or pit (blocked, no wall)   P pillar (blocked)   D door socket\n// S trash spawn   E elite spawn   C chest   B breakable   T trap   L light   A shrine\n// X entrance or exit   N named prop (from the template's `named` list, row by row)\nexport const SHARED = [\n  { id: 'nave', rows: [\n    '#########D#########',\n    '#L...............L#',\n    '#..B...........B..#',\n    '#.......S.........#',\n    '#...P.........P...#',\n    'D.........E.......D',\n    '#...P.........P...#',\n    '#.........S.......#',\n    '#..B...........C..#',\n    '#L...............L#',\n    '#########D#########',\n  ] },\n  { id: 'crossing', rows: [\n    '#####D#####',\n    '#L...B...L#',\n    '#.........#',\n    '#...S.....#',\n    '#.........#',\n    '#####.#####',\n    '  ##.....##  '.trim().padEnd(11, ' ').slice(0, 11).replace(/ /g, '#'),\n    '#.........#',\n    'D....E....D',\n    '#.........#',\n    '#.T.....B.#',\n    '#L.......L#',\n    '#####D#####',\n  ] },\n  { id: 'gallery', rows: [\n    '###################D###',\n    '#L.......L.......L....#',\n    '#.P..P..P..P..P..P....#',\n    '#.....................#',\n    'D...S.....B.....S.....D',\n    '#.....................#',\n    '#.P..P..P..P..P..P....#',\n    '#L.......L.......L..C.#',\n    '###D###################',\n  ] },\n  { id: 'cells', rows: [\n    '#########D#########',\n    '#L..#...B#..T#...L#',\n    '#...#....#...#....#',\n    '#...#S...#...#.S..#',\n    '##.###.####.###.###',\n    '#.................#',\n    'D.........E.......D',\n    '#.................#',\n    '##.###.####.###.###',\n    '#...#....#...#....#',\n    '#.B.#..S.#...#..C.#',\n    '#L..#....#.B.#...L#',\n    '#########D#########',\n  ] },\n  { id: 'rotunda', rows: [\n    '   ####D####   ',\n    '  ##L.....L##  ',\n    ' ##.........## ',\n    '##...........##',\n    '#....S...S....#',\n    '#.....PPP.....#',\n    'D....BPAPB....D',\n    '#.....PPP.....#',\n    '#....S...E....#',\n    '##...........##',\n    ' ##.........## ',\n    '  ##L.....L##  ',\n    '   ####D####   ',\n  ] },\n  { id: 'long_hall', rows: [\n    '##########################',\n    '#L.......L........L.....L#',\n    '#.....B.......B......C...#',\n    'D....S.........S.........D',\n    '#.......T..........T.....#',\n    '#.....B......E.......B...#',\n    '#L.......L........L.....L#',\n    '##########D###############',\n  ] },\n  { id: 'pit_room', rows: [\n    '#########D#########',\n    '#L...............L#',\n    '#...~~~~~~~~~~~...#',\n    '#..~~~~~~~~~~~~~..#',\n    '#..~~~~.....~~~~..#',\n    'D..~~~.......~~~..D',\n    '#......S.E.S......#',\n    '#..~~~.......~~~..#',\n    '#..~~~~.....~~~~..#',\n    '#..~~~~~~~~~~~~~..#',\n    '#...~~~~~.~~~~~...#',\n    '#L.......B.......L#',\n    '#########D#########',\n  ] },\n  { id: 'vault', rows: [\n    '####D########',\n    '#L.........L#',\n    '#.B.......B.#',\n    '#...S...S...#',\n    '#.....T.....#',\n    'D...........D',\n    '#.....E.....#',\n    '#.B.......C.#',\n    '#L.........L#',\n    '#########D###',\n  ] },\n  { id: 'cloister_walk', rows: [\n    '##########D##########',\n    '#L.................L#',\n    '#.PP.PP.PP.PP.PP.PP.#',\n    '#.P~~~~~~~~~~~~~~~P.#',\n    'D.P~~~~~~~~~~~~~~~P.D',\n    '#..~~.....S.....~~..#',\n    '#.P~~....E.A....~~P.#',\n    '#..~~.....S.....~~..#',\n    '#.P~~~~~~~~~~~~~~~P.#',\n    '#.PP.PP.PP.PP.PP.PP.#',\n    '#L.................L#',\n    '##########D##########',\n  ] },\n  { id: 'dead_end', rows: [\n    '#####D#####',\n    '#L.......L#',\n    '#.B.....B.#',\n    '#...S.S...#',\n    '#.........#',\n    '#.B..C..B.#',\n    '#L.......L#',\n    '###########',\n  ] },\n];\n\nexport const LEVER_ROOM = { id: 'lever_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#..B...B..#',\n  '#...S.....#',\n  'D....N....D',\n  '#.....S...#',\n  '#..B...C..#',\n  '#L.......L#',\n  '#####D#####',\n], named: ['lever'] };\n\nexport const START_ROOM = { id: 'start_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#.........#',\n  'D...X.N...D',\n  '#.........#',\n  '#L.......L#',\n  '###########',\n], named: ['lychgate'] };\n\nexport const STAIR_ROOM = { id: 'stair_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#..B...B..#',\n  '#...S.....#',\n  'D....X....D',\n  '#.....E...#',\n  '#..B...B..#',\n  '#L.......L#',\n  '###########',\n] };\n\nexport const RELIC_ROOM = { id: 'relic_room', rows: [\n  '#####D#####',\n  '#L...P...L#',\n  '#...S.S...#',\n  '#.P.....P.#',\n  'D....N....D',\n  '#.P.....P.#',\n  '#...E.S...#',\n  '#L.......L#',\n  '###########',\n], named: ['relic'] };\n\nexport const SHRINE_ROOM = { id: 'shrine_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#..B...B..#',\n  'D....A....D',\n  '#...S.S...#',\n  '#L...N...L#',\n  '#####D#####',\n], named: ['book'] };\nEOF\ncat > src/data/rooms/causeway.js <<'EOF'\n// The Weeping Causeway: long outdoor stretches. '~' is the drowned moor (blocked, no wall).\nconst c = (id, rows, named) => ({ id, rows, named });\nexport const CAUSEWAY = [\n  c('road_start', [\n    '~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~......~~~~~~~~~~~',\n    '~~~......B.....~~~~~~~~',\n    '~~..........L.....~~~~~',\n    '~...............B....~~',\n    '~..X...N.............~D',\n    '~....................~~',\n    '~~.......L.......~~~~~~',\n    '~~~~~~~~......~~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['lychgate']),\n  c('road_a', [\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~......~~~~~....~~~~~',\n    '~~~...B..S.......B.....~~~',\n    '~~.......L.....S..........',\n    'D.....................B..D',\n    '~~.....S....B.......L.....',\n    '~~~~........~~~~.......~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~',\n  ].map((r) => r)),\n  c('road_b', [\n    '~~~~~~~~~~~D~~~~~~~~~~',\n    '~~~~~~~~~.....~~~~~~~~',\n    '~~~~~...S.......~~~~~~',\n    '~~.......B...L.....~~~',\n    'D..................S.D',\n    '~~...L...............~',\n    '~~~~.....S.......B.~~~',\n    '~~~~~~~...........~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~',\n  ]),\n  c('road_c', [\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~.......~~~~~~~......',\n    '~~.....S......~~~...S...',\n    '~.......B...............',\n    'D.....L.........B.......',\n    '~..........~~......L...D',\n    '~~...S....~~~~...S......',\n    '~~~~.....~~~~~~~.......~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n  ]),\n  c('road_d', [\n    '~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~......~~~~~~......~',\n    '~~...S.....B......S..~',\n    '~..........~~.........',\n    'D....L....~~~~...L...D',\n    '~.........~~..........',\n    '~~.....B........B....~',\n    '~~~~........E.......~~',\n    '~~~~~~~~~~~D~~~~~~~~~~',\n  ]),\n  c('road_lych', [\n    '~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~.........~~~~~~~',\n    '~~~.....B...L....~~~~~',\n    '~~.....S............~~',\n    'D..........N.........D',\n    '~~.........A........~~',\n    '~~~.....S.....B..~~~~~',\n    '~~~~~~........~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['lychgate']),\n  c('road_gibbets', [\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~.......N.....~~~~~~',\n    '~~~.....S........N...~~~',\n    '~~..N.......L.........~~',\n    'D.....................~D',\n    '~~.........B.....N.....~',\n    '~~~..N.....S.........~~~',\n    '~~~~~~...........~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['gibbet', 'gibbet', 'gibbet', 'gibbet', 'gibbet']),\n  c('road_e', [\n    '~~~~~~~~~~~~~~~~~~~~~',\n    '~~~......~~~......~~~',\n    '~~..S..B.....S....~~~',\n    '~...............L...~',\n    'D....L.......E......D',\n    '~..........B.........',\n    '~~...S............~~~',\n    '~~~~.....~~~~~....~~~',\n    '~~~~~~~~~~~~~~~~~~~~~',\n  ]),\n  c('side_pantry', [\n    '~~~~~~~~~D~~~~~~~',\n    '~~~~........~~~~~',\n    '~~....S.......~~~',\n    '~...............~',\n    '~...B......B....~',\n    '~......N........~',\n    '~~...L.....L...~~',\n    '~~~~~~~~~~~~~~~~~',\n  ], ['pantry_door']),\n  c('side_ruin', [\n    '~~~~~~~~D~~~~~~~',\n    '~~~~.......~~~~~',\n    '~~...S...B...~~~',\n    '~.............~~',\n    '~..B..A....S..~~',\n    '~~.....N......~~',\n    '~~~~...L....~~~~',\n    '~~~~~~~~~~~~~~~~',\n  ], ['book']),\n  c('camp', [\n    '~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~.........~~~~~~~',\n    '~~~......N........~~~~',\n    '~~..L..........L....~~',\n    'D.......N...N........~',\n    '~~..........L.......~~',\n    '~~~.................~~',\n    '~~~~~~........~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['gibbet', 'npc_brasse', 'wagon']),\n];\nEOF\ncat > src/data/rooms/special.js <<'EOF'\n// Authored places and boss rooms.\nexport const YARD = {\n  id: 'yard',\n  rows: [\n    '##############################################################',\n    '#L.........B...#####.................#####....................#',\n    '#..............#####......B..........#####..........L.........#',\n    '#...B......B...#####..............S..#####..........~~~.......#',\n    '#..............#####...L.........B...#####.......L..~~~.......#',\n    '#......N...............................................N......#',\n    '#...........................A.........................#########',\n    '#..............................................................'.slice(0, 62),\n    '#..X...........#####..............S..#####...............N....#',\n    '#..............#####...B.......L.....#####..........B.........#',\n    '#...B..........#####.................#####....L...............#',\n    '#L.........B...#####.........B.......#####..........~~~.......#',\n    '##############################################################',\n  ],\n  named: ['grave_book', 'coffin_quest', 'yard_gate'],\n};\n\nexport const TOWN = {\n  id: 'town',\n  rows: [\n    '##############################################################',\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#~~~~~~#..L............N.................N.........L...#~~~~~~~#'.slice(0, 62),\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#...............L.................L.............#~~~~~~#'.slice(0, 62),\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#.......................................................N....#',\n    '#...............N...........................N................#',\n    '#.......................#####.####...........................#'.slice(0, 62),\n    '#...L...................#.........#.....................L....#',\n    '#.......................#.........#..........................#',\n    '#.........N.............#....P....#.............N............#',\n    '#.......................#.........#..........................#',\n    '#.......................###.....###..........................#',\n    '#...L................................................L.......#',\n    '#...............N...........................N................#',\n    '#............................N...............................#',\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#..L............................X...........L...#~~~~~~~#'.slice(0, 62),\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '##############################################################',\n  ],\n  named: ['book', 'npc_crier', 'road_gate', 'npc_pennywhistle', 'knell_font', 'npc_brasse', 'npc_ogive', 'lychgate', 'writ_board', 'stash', 'return_spot'],\n};\n\nexport const COUNTING_HOUSE = { id: 'counting_house', boss: 'bursar', rows: [\n  '##########D###########',\n  '#L.......B....B.....L#',\n  '#.N................N.#',\n  '#....................#',\n  '#....P..........P....#',\n  '#....................#',\n  '#.........B..........#',\n  '#.B..................#',\n  '#.........X........B.#',\n  '#....................#',\n  '#....P..........P....#',\n  '#....................#',\n  '#.N................N.#',\n  '#L.......B....B.....L#',\n  '######################',\n], named: ['coin_pile', 'coin_pile', 'coin_pile', 'coin_pile'] };\n\nexport const CHAPTER_HOUSE = { id: 'chapter_house', boss: 'ambrose', rows: [\n  '##########D###########',\n  '#L..................L#',\n  '#...P............P...#',\n  '#....................#',\n  '#.......B....B.......#',\n  '#....................#',\n  '#.........X..........#',\n  '#....................#',\n  '#.......B....B.......#',\n  '#....................#',\n  '#...P............P...#',\n  '#L..................L#',\n  '######################',\n] };\n\nexport const NOVICE_ROOM = { id: 'novice_room', rows: [\n  '#########D#########',\n  '#L...............L#',\n  '#..P...........P..#',\n  '#.................#',\n  'D......N.N.N......D',\n  '#.................#',\n  '#..N...........N..#',\n  '#.................#',\n  '#..P...........P..#',\n  '#L...............L#',\n  '#########D#########',\n], named: ['novice', 'novice', 'novice', 'font_spot', 'font_spot'] };\n\nexport const PANTRY_BOSS = { id: 'pantry_boss', boss: 'cellarer', rows: [\n  '#####D######',\n  '#L..B..B..L#',\n  '#..........#',\n  '#.~~....~~.#',\n  '#.~~.X..~~.#',\n  '#..........#',\n  '#.B......B.#',\n  '#L........L#',\n  '############',\n] };\n\n// The top of the tower. Round, with six pillars, an arena for the last fight.\nexport const BELFRY_ARENA = {\n  id: 'belfry_arena', boss: 'malison',\n  rows: [\n    '~~~~~~~~~~~~~#######~~~~~~~~~~~~~',\n    '~~~~~~~~~#####.....#####~~~~~~~~~',\n    '~~~~~~~###.............###~~~~~~~',\n    '~~~~~###.................###~~~~~',\n    '~~~~##.....................##~~~~',\n    '~~~##.......................##~~~',\n    '~~##.........................##~~',\n    '~~#...........P.....P.........#~~',\n    '~##...........................##~',\n    '~#.............................#~',\n    '##.............................##',\n    '#.................................#'.slice(0, 33),\n    '#.........P.............P.......#',\n    '#...............................#',\n    '#...............................#',\n    '#...............................#',\n    '#...............................#',\n    '#...............................#',\n    '#.........P.............P.......#',\n    '#...............................#',\n    '##.............................##',\n    '~#.............................#~',\n    '~##...........................##~',\n    '~~#...........P.....P.........#~~',\n    '~~##.........................##~~',\n    '~~~##.......................##~~~',\n    '~~~~##.....................##~~~~',\n    '~~~~~###.................###~~~~~',\n    '~~~~~~~###.............###~~~~~~~',\n    '~~~~~~~~~#####..X..#####~~~~~~~~~',\n    '~~~~~~~~~~~~~#######~~~~~~~~~~~~~',\n  ],\n};\n\nexport const WARDEN_ARENA_NOTE = 'A Warden raises a ring of bone around where it lands.';\nEOF\ncat > src/data/zones.js <<'EOF'\n// Zones as data: what a place is, what lives there, how it is stitched together.\nimport { CAUSEWAY } from './rooms/causeway.js';\nimport { LEVER_ROOM, RELIC_ROOM, SHARED, SHRINE_ROOM, STAIR_ROOM, START_ROOM } from './rooms/shared.js';\nimport { BELFRY_ARENA, CHAPTER_HOUSE, COUNTING_HOUSE, NOVICE_ROOM, PANTRY_BOSS, TOWN, YARD } from './rooms/special.js';\n\nexport const PROP_HP = { urn: 1, barrel: 1, crate: 1, clay: 1, keg: 1, coffin: 2, tombstone: 2, basket: 1, bones: 1, amphora: 1 };\n\nexport const ZONES = {\n  yard: {\n    id: 'yard', name: \"ST. CLEMENT'S YARD\", kind: 'authored', tpl: YARD, biome: 'yard', levelFloor: 1, song: 'weeping_road', floors: 1, bellOk: false,\n    monsters: [['peatwalker', 1]], breakables: ['urn', 'tombstone', 'barrel'], gate: false,\n  },\n  town: {\n    id: 'town', name: 'TOLLHAVEN', kind: 'authored', tpl: TOWN, biome: 'town', levelFloor: 1, song: 'last_lamps', floors: 1, safe: true, bellOk: false,\n    monsters: [], breakables: ['barrel', 'crate', 'urn'], gate: true,\n  },\n  causeway: {\n    id: 'causeway', name: 'THE WEEPING CAUSEWAY', kind: 'gen', biome: 'causeway', levelFloor: 1, song: 'weeping_road', floors: 1,\n    monsters: [['peatwalker', 5], ['gibbet_drop', 2], ['bloat_deacon', 1]], breakables: ['barrel', 'crate', 'tombstone'],\n    gen: { axis: 'x', rooms: 8, start: 'road_start', end: 'camp', fill: ['road_a', 'road_b', 'road_c', 'road_d', 'road_e'], required: ['road_lych', 'road_gibbets'], side: ['side_pantry', 'side_ruin'] },\n    templates: CAUSEWAY,\n  },\n  ossuary: {\n    id: 'ossuary', name: 'THE OSSUARY OF SAINT GLOAM', kind: 'gen', biome: 'ossuary', levelFloor: 6, song: 'under_gloam', floors: 3,\n    monsters: [['peatwalker', 2], ['rattlebones', 5], ['choir_skull', 2], ['pallid_bearer', 1], ['tomb_crawler', 2], ['bloat_deacon', 1], ['crawler_nest', 0.6]], breakables: ['urn', 'coffin', 'clay', 'bones'],\n    gen: { rooms: [8, 10, 11], start: 'start_room', end: 'stair_room', fill: ['nave', 'crossing', 'gallery', 'cells', 'rotunda', 'long_hall', 'pit_room', 'vault', 'dead_end'], required: ['relic_room', 'shrine_room', 'lever_room'], bossAt: { 2: 'counting_house' } },\n    templates: [...SHARED, START_ROOM, STAIR_ROOM, RELIC_ROOM, SHRINE_ROOM, LEVER_ROOM, COUNTING_HOUSE],\n  },\n  cloister: {\n    id: 'cloister', name: 'THE CINDER CLOISTER', kind: 'gen', biome: 'cloister', levelFloor: 11, song: 'cinders', floors: 1,\n    monsters: [['cinderling', 4], ['tithe_collector', 2], ['penitent', 3], ['clapperjaw', 1], ['ash_gargoyle', 2], ['shade_acolyte', 2], ['unrung_font', 0.5]], breakables: ['urn', 'coffin', 'amphora', 'barrel'],\n    gen: { rooms: 11, start: 'start_room', end: 'chapter_house', fill: ['nave', 'crossing', 'gallery', 'rotunda', 'long_hall', 'pit_room', 'vault', 'cloister_walk'], required: ['novice_room', 'shrine_room'] },\n    templates: [...SHARED, START_ROOM, SHRINE_ROOM, NOVICE_ROOM, CHAPTER_HOUSE],\n  },\n  belfry: {\n    id: 'belfry', name: 'THE CRACKED BELFRY', kind: 'gen', biome: 'belfry', levelFloor: 15, song: 'the_climb', floors: 4,\n    monsters: [['rattlebones', 3], ['cinderling', 3], ['penitent', 3], ['clapperjaw', 1], ['ash_gargoyle', 2]], breakables: ['urn', 'coffin', 'clay'],\n    gen: { rooms: [5, 5, 6], start: 'start_room', end: 'stair_room', fill: ['nave', 'gallery', 'rotunda', 'pit_room', 'vault', 'long_hall', 'crossing', 'cloister_walk'], required: ['shrine_room'], arenaFloor: 3 },\n    templates: [...SHARED, START_ROOM, STAIR_ROOM, SHRINE_ROOM],\n    arena: BELFRY_ARENA,\n  },\n  pantry: {\n    id: 'pantry', name: 'THE DROWNED PANTRY', kind: 'gen', biome: 'pantry', levelFloor: 3, song: 'under_gloam', floors: 1,\n    monsters: [['peatwalker', 4], ['bloat_deacon', 1]], breakables: ['barrel', 'keg', 'crate'],\n    gen: { rooms: 4, start: 'start_room', end: 'pantry_boss', fill: ['vault', 'crossing', 'dead_end', 'cells', 'nave'], required: [] },\n    templates: [...SHARED, START_ROOM, PANTRY_BOSS],\n  },\n  knell: {\n    id: 'knell', name: 'A KNELL RUN', kind: 'gen', biome: 'mixed', levelFloor: 1, song: 'the_knell', floors: 2, bellOk: false,\n    monsters: [['peatwalker', 2], ['rattlebones', 3], ['choir_skull', 1], ['tomb_crawler', 2], ['cinderling', 3], ['penitent', 2], ['pallid_bearer', 1], ['clapperjaw', 0.6], ['ash_gargoyle', 1.5], ['tithe_collector', 1], ['bloat_deacon', 1]], breakables: ['urn', 'coffin', 'barrel', 'crate'],\n    gen: { rooms: [14, 15], start: 'start_room', end: 'stair_room', fill: ['nave', 'crossing', 'gallery', 'cells', 'rotunda', 'long_hall', 'pit_room', 'vault', 'cloister_walk', 'dead_end'], required: [] },\n    templates: [...SHARED, START_ROOM, STAIR_ROOM],\n  },\n  session: {\n    id: 'session', name: 'THE KNELL', kind: 'gen', biome: 'mixed', levelFloor: 12, song: 'the_knell', floors: 1, bellOk: false,\n    monsters: [['peatwalker', 2], ['rattlebones', 3], ['choir_skull', 1], ['tomb_crawler', 2], ['cinderling', 3], ['penitent', 2], ['pallid_bearer', 1], ['clapperjaw', 0.6], ['ash_gargoyle', 1.5], ['bloat_deacon', 1]], breakables: ['urn', 'coffin', 'barrel', 'crate'],\n    gen: { rooms: 18, start: 'start_room', end: 'dead_end', fill: ['nave', 'crossing', 'gallery', 'cells', 'rotunda', 'long_hall', 'pit_room', 'vault', 'cloister_walk'], required: [] },\n    templates: [...SHARED, START_ROOM],\n  },\n};\nfor (const z of Object.values(ZONES)) z.levelFloor = z.levelFloor ?? 1;\n\nexport const BIOMES = {\n  yard: { sun: 'sky', sunI: 0.5, ambient: 'navy', ambI: 0.85, bg: 'ink', fog: 'navy', floor: 'mud', wall: 'ashlar', wallH: 2.2, rain: 1, wind: 0.3, torch: 0x9fc4ff, decor: ['tombstone', 'dead-tree', 'bones', 'rubble', 'tombstone', 'stump'], wallDress: ['wall-chains'] },\n  town: { sun: 'orange', sunI: 0.7, ambient: 'plum', ambI: 1.0, bg: 'ink', fog: 'plum', floor: 'cobbles', wall: 'brick-wall', wallH: 2.6, torch: 0xffb060, decor: ['barrel', 'crate', 'sack', 'bench', 'planter', 'hitching-post', 'clothesline'], wallDress: ['banner', 'wall-lantern'] },\n  causeway: { sun: 'sky', sunI: 0.55, ambient: 'navy', ambI: 0.9, bg: 'ink', fog: 'teal', floor: 'mud', wall: 'dry-stone', wallH: 1.2, rain: 1, wind: 0.5, torch: 0xffc080, water: 1, decor: ['dead-tree', 'willow', 'reeds', 'cart', 'tall-grass', 'rock', 'fallen-tree', 'reeds'], wallDress: [] },\n  ossuary: { sun: 'mist', sunI: 0.3, ambient: 'navy', ambI: 0.9, bg: 'ink', fog: 'night', floor: 'flagstones', wall: 'ashlar', wallH: 3, torch: 0xa8e070, pit: 1, decor: ['bones', 'rubble', 'skull-pile', 'cobweb', 'candles', 'sarcophagus', 'cage', 'spikes'], wallDress: ['wall-torch', 'banner', 'wall-chains', 'column'] },\n  cloister: { sun: 'orange', sunI: 0.45, ambient: 'plum', ambI: 0.8, bg: 'ink', fog: 'red', floor: 'slate-tiles', wall: 'sandstone', wallH: 3, torch: 0xff8030, pit: 2, embers: 1, decor: ['rubble', 'ruined-wall', 'brazier', 'flame', 'column', 'bones', 'statue'], wallDress: ['wall-torch', 'banner'] },\n  belfry: { sun: 'sky', sunI: 0.5, ambient: 'navy', ambI: 0.8, bg: 'night', fog: 'navy', floor: 'basalt', wall: 'basalt', wallH: 3, torch: 0x60e0f0, pit: 3, wind: 0.8, decor: ['rubble', 'rune-stone', 'obelisk', 'bones', 'standard'], wallDress: ['wall-chains', 'wall-torch'] },\n  pantry: { sun: 'sky', sunI: 0.3, ambient: 'teal', ambI: 0.8, bg: 'ink', fog: 'teal', floor: 'shallow-water', wall: 'ashlar', wallH: 2.6, torch: 0xffc080, water: 1, decor: ['barrel', 'keg', 'crate-stack', 'sack', 'wall-shelf', 'bucket'], wallDress: ['wall-torch', 'wall-shelf'] },\n  mixed: { sun: 'plum', sunI: 0.45, ambient: 'navy', ambI: 0.9, bg: 'ink', fog: 'plum', floor: 'rune-floor', wall: 'basalt', wallH: 3, torch: 0xd070ff, pit: 3, decor: ['rubble', 'bones', 'skull-pile', 'rune-stone', 'candles', 'obelisk'], wallDress: ['wall-chains', 'wall-torch'] },\n};\n\n// Where each template's floor textures come from, by floor number, for a little variety.\nexport const BIOME_FLOORS = { ossuary: ['flagstones', 'flagstones', 'floor-tiles'], cloister: ['slate-tiles', 'cinders', 'lava-crust'], belfry: ['basalt', 'rune-floor', 'basalt', 'rune-floor'], mixed: ['rune-floor', 'basalt'] };\n\nexport const zoneName = (id, floor) => {\n  const z = ZONES[id];\n  return z.floors > 1 && !(id === 'belfry' && floor === 3) ? `${z.name} ${floor + 1}` : z.name;\n};\nEOF\ncat > src/sim/zonegen.js <<'EOF'\n// Stitches ASCII room templates into a map from a seed. The same code runs on every client.\nimport { NavGrid } from '../../pixel-engine.js';\nimport { ZONES } from '../data/zones.js';\n\nconst OUT = { n: [0, -1], s: [0, 1], w: [-1, 0], e: [1, 0] };\nconst OPP = { n: 's', s: 'n', w: 'e', e: 'w' };\n\nfunction normalize(t) {\n  const w = Math.max(...t.rows.map((r) => r.length));\n  return t.rows.map((r) => r.padEnd(w, ' '));\n}\n\nfunction doorsOf(rows) {\n  const out = [];\n  const h = rows.length, w = rows[0].length;\n  for (let y = 0; y < h; y++) {\n    for (let x = 0; x < w; x++) {\n      if (rows[y][x] !== 'D') continue;\n      let dir = null;\n      if (y === 0 || rows[y - 1][x] === ' ' || rows[y - 1][x] === '~' && y === 0) dir = 'n';\n      else if (y === h - 1) dir = 's';\n      else if (x === 0) dir = 'w';\n      else if (x === w - 1) dir = 'e';\n      else if (rows[y - 1][x] === ' ') dir = 'n';\n      else if (rows[y + 1][x] === ' ') dir = 's';\n      else if (rows[y][x - 1] === ' ') dir = 'w';\n      else if (rows[y][x + 1] === ' ') dir = 'e';\n      if (dir) out.push({ x, y, dir });\n    }\n  }\n  return out;\n}\n\nconst solid = (ch) => ch === '#' || ch === 'D' || ch === '~' || ch === ' ';\nconst key = (x, y) => (x + 4096) * 8192 + (y + 4096);\n\nclass Canvas {\n  constructor() { this.cells = new Map(); this.rooms = []; this.sockets = []; this.links = []; }\n  get(x, y) { return this.cells.get(key(x, y)); }\n  fits(rows, ox, oy) {\n    for (let y = 0; y < rows.length; y++) {\n      for (let x = 0; x < rows[0].length; x++) {\n        const ch = rows[y][x];\n        if (ch === ' ') continue;\n        const cur = this.get(ox + x, oy + y);\n        if (cur === undefined) continue;\n        if (!(solid(ch) && solid(cur))) return false;\n      }\n    }\n    return true;\n  }\n  stamp(tpl, rows, ox, oy) {\n    const index = this.rooms.length;\n    const room = { index, id: tpl.id, x: ox, y: oy, w: rows[0].length, h: rows.length, tpl };\n    this.rooms.push(room);\n    for (let y = 0; y < rows.length; y++) {\n      for (let x = 0; x < rows[0].length; x++) {\n        const ch = rows[y][x];\n        if (ch === ' ') continue;\n        const cur = this.get(ox + x, oy + y);\n        if (cur === undefined || cur === '~' || (cur === '#' && ch === '#')) {\n          if (ch === 'D') this.cells.set(key(ox + x, oy + y), 'D');\n          else if (cur !== '#' || ch !== '~') this.cells.set(key(ox + x, oy + y), ch);\n        }\n      }\n    }\n    for (const d of doorsOf(rows)) {\n      const wx = ox + d.x, wy = oy + d.y;\n      this.sockets.push({ x: wx, y: wy, dir: d.dir, room: index });\n    }\n    return room;\n  }\n}\n\nfunction tryAttach(rng, canvas, tpl, rows, socket) {\n  const doors = doorsOf(rows).filter((d) => d.dir === OPP[socket.dir]);\n  rng.shuffle(doors);\n  for (const d of doors) {\n    const ox = socket.x - d.x, oy = socket.y - d.y;\n    if (!canvas.fits(rows, ox, oy)) continue;\n    const room = canvas.stamp(tpl, rows, ox, oy);\n    canvas.links.push({ x: socket.x, y: socket.y, a: socket.room, b: room.index, dir: socket.dir });\n    canvas.cells.set(key(socket.x, socket.y), '.');\n    // Both sides of the door are now used.\n    canvas.sockets = canvas.sockets.filter((s) => !(s.x === socket.x && s.y === socket.y));\n    return room;\n  }\n  return null;\n}\n\n/** Lay out one floor. Retries with the same stream until the layout is whole; deterministic. */\nexport function layoutFloor(rng, zone, floor) {\n  const g = zone.gen;\n  const rooms = Array.isArray(g.rooms) ? g.rooms[floor] ?? g.rooms[g.rooms.length - 1] : g.rooms;\n  const byId = Object.fromEntries(zone.templates.map((t) => [t.id, t]));\n  const endId = g.bossAt?.[floor] ?? g.end;\n  for (let attempt = 0; attempt < 60; attempt++) {\n    const canvas = new Canvas();\n    const startTpl = byId[g.start];\n    const start = canvas.stamp(startTpl, normalize(startTpl), 0, 0);\n    const required = [...g.required];\n    const fill = () => { const t = byId[rng.pick(g.fill)]; return t; };\n    let ok = true;\n    const sequence = [];\n    const middle = Math.max(0, rooms - 2 - required.length);\n    for (let i = 0; i < middle; i++) sequence.push(fill());\n    for (const r of required) sequence.splice(rng.int(0, sequence.length), 0, byId[r]);\n    for (const tpl of sequence) {\n      const rows = normalize(tpl);\n      const socks = orderSockets(rng, canvas, g, start);\n      let placed = null;\n      for (const s of socks) { placed = tryAttach(rng, canvas, tpl, rows, s); if (placed) break; }\n      if (!placed) { const alt = byId[rng.pick(g.fill)]; const altRows = normalize(alt); for (const s of socks) { placed = tryAttach(rng, canvas, alt, altRows, s); if (placed) break; } }\n      if (!placed) { ok = false; break; }\n    }\n    if (!ok) continue;\n    if (g.side) {\n      for (const id of g.side) {\n        const tpl = byId[id];\n        const rows = normalize(tpl);\n        const socks = canvas.sockets.filter((s) => s.dir === 'n' || s.dir === 's');\n        rng.shuffle(socks);\n        for (const s of socks) if (tryAttach(rng, canvas, tpl, rows, s)) break;\n      }\n    }\n    // The end room goes on the socket farthest from the start, walking room links.\n    const endTpl = byId[endId];\n    const endRows = normalize(endTpl);\n    const socks = farthestSockets(canvas, g);\n    let endRoom = null;\n    for (const s of socks) { endRoom = tryAttach(rng, canvas, endTpl, endRows, s); if (endRoom) break; }\n    if (!endRoom) continue;\n    return finish(canvas, zone, start, endRoom);\n  }\n  throw new Error(`zonegen: no layout for ${zone.id} floor ${floor}`);\n}\n\nfunction orderSockets(rng, canvas, g, start) {\n  const socks = [...canvas.sockets];\n  rng.shuffle(socks);\n  if (g.axis === 'x') {\n    // Walk east: the +X sockets of the latest rooms first.\n    socks.sort((a, b) => (b.dir === 'e' ? b.x + 1000 : b.x * 0.1) - (a.dir === 'e' ? a.x + 1000 : a.x * 0.1));\n  } else {\n    socks.sort((a, b) => b.room - a.room + rng.range(-3, 3));\n  }\n  return socks;\n}\n\nfunction farthestSockets(canvas, g) {\n  const depth = new Map([[0, 0]]);\n  for (const l of canvas.links) depth.set(l.b, (depth.get(l.a) ?? 0) + 1);\n  const socks = [...canvas.sockets];\n  if (g.axis === 'x') socks.sort((a, b) => (b.dir === 'e' ? b.x + 1000 : b.x * 0.1) - (a.dir === 'e' ? a.x + 1000 : a.x * 0.1));\n  else socks.sort((a, b) => (depth.get(b.room) ?? 0) - (depth.get(a.room) ?? 0));\n  return socks;\n}\n\nfunction finish(canvas, zone, startRoom, endRoom) {\n  // Bounds, with a margin of void.\n  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;\n  for (const k of canvas.cells.keys()) {\n    const x = Math.floor(k / 8192) - 4096, y = (k % 8192) - 4096;\n    if (x < minX) minX = x; if (x > maxX) maxX = x;\n    if (y < minY) minY = y; if (y > maxY) maxY = y;\n  }\n  const pad = 2;\n  const W = maxX - minX + 1 + pad * 2, H = maxY - minY + 1 + pad * 2;\n  const rows = [];\n  for (let y = 0; y < H; y++) {\n    let r = '';\n    for (let x = 0; x < W; x++) {\n      const ch = canvas.get(x + minX - pad, y + minY - pad);\n      r += ch === undefined ? ' ' : ch === 'D' ? (zone.gen.axis === 'x' ? '~' : '#') : ch;\n    }\n    rows.push(r);\n  }\n  const rooms = canvas.rooms.map((rm) => ({ ...rm, x: rm.x - minX + pad, y: rm.y - minY + pad, cx: rm.x - minX + pad + rm.w / 2, cz: rm.y - minY + pad + rm.h / 2, tplId: rm.id }));\n  const links = canvas.links.map((l) => ({ ...l, x: l.x - minX + pad, y: l.y - minY + pad }));\n  return { rows, w: W, h: H, rooms, links, start: rooms[startRoom.index], end: rooms[endRoom.index] };\n}\n\nexport function layoutAuthored(tpl) {\n  const rows = normalize(tpl);\n  return { rows, w: rows[0].length, h: rows.length, rooms: [{ index: 0, id: tpl.id, tplId: tpl.id, x: 0, y: 0, w: rows[0].length, h: rows.length, cx: rows[0].length / 2, cz: rows.length / 2, tpl }], links: [], start: null, end: null };\n}\n\n/**\n * Read the markers out of a laid-out map. Returns the grid, nav and lists of what goes where.\n * Pure data: every client gets the same result from the same seed.\n */\nexport function scanLayout(layout, zone, rng) {\n  const out = { lights: [], spawns: [], breakables: [], traps: [], shrines: [], chests: [], named: [], entrances: [], pillars: [] };\n  const rows = layout.rows.map((r) => r.split(''));\n  const bp = zone.breakables ?? ['urn'];\n  const roomOf = (x, y) => layout.rooms.find((rm) => x >= rm.x && x < rm.x + rm.w && y >= rm.y && y < rm.y + rm.h) ?? null;\n  const namedIdx = new Map();\n  for (let y = 0; y < rows.length; y++) {\n    for (let x = 0; x < rows[0].length; x++) {\n      const ch = rows[y][x];\n      const room = roomOf(x, y);\n      const at = { x: x + 0.5, z: y + 0.5, room: room?.index ?? -1 };\n      switch (ch) {\n        case 'L': out.lights.push(at); rows[y][x] = '.'; break;\n        case 'S': out.spawns.push({ ...at, kind: 'S' }); rows[y][x] = '.'; break;\n        case 'E': out.spawns.push({ ...at, kind: 'E' }); rows[y][x] = '.'; break;\n        case 'B': out.breakables.push({ ...at, type: rng.pick(bp) }); rows[y][x] = '.'; break;\n        case 'T': out.traps.push(at); rows[y][x] = '.'; break;\n        case 'A': out.shrines.push(at); rows[y][x] = '.'; break;\n        case 'C': out.chests.push(at); rows[y][x] = '.'; break;\n        case 'X': out.entrances.push(at); rows[y][x] = '.'; break;\n        case 'P': out.pillars.push(at); break;\n        case 'N': {\n          const n = namedIdx.get(room?.index) ?? 0;\n          namedIdx.set(room?.index, n + 1);\n          const name = room?.tpl?.named?.[n] ?? 'nothing';\n          out.named.push({ ...at, name });\n          rows[y][x] = '.';\n          break;\n        }\n        default: break;\n      }\n    }\n  }\n  const finalRows = rows.map((r) => r.join(''));\n  const nav = NavGrid.fromRows(finalRows, { blocked: '#~P ', cell: 1, origin: [0, 0, 0] });\n  return { ...out, finalRows, nav };\n}\n\nexport { OUT, ZONES };\nEOF\necho ok","description":"Write room templates, zones data and generator"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24167,"cache_read_input_tokens":300499,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24167},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"55f3b7c7-f8c3-4004-8fcc-2acd9332a356","timestamp":"2026-11-05T23:47:00.338Z","request_id":"req_011Cgkfm5fxESNt4i34MmWzx","wire_tool_inputs":{"toolu_01Ae48Rm4nahDFh8nC2QH3e4":{"command":"mkdir -p src/data/rooms\ncat > src/data/rooms/shared.js <<'EOF'\n// ASCII room templates shared by the indoor biomes. Legend:\n// # wall   . floor   ~ water or pit (blocked, no wall)   P pillar (blocked)   D door socket\n// S trash spawn   E elite spawn   C chest   B breakable   T trap   L light   A shrine\n// X entrance or exit   N named prop (from the template's `named` list, row by row)\nexport const SHARED = [\n  { id: 'nave', rows: [\n    '#########D#########',\n    '#L...............L#',\n    '#..B...........B..#',\n    '#.......S.........#',\n    '#...P.........P...#',\n    'D.........E.......D',\n    '#...P.........P...#',\n    '#.........S.......#',\n    '#..B...........C..#',\n    '#L...............L#',\n    '#########D#########',\n  ] },\n  { id: 'crossing', rows: [\n    '#####D#####',\n    '#L...B...L#',\n    '#.........#',\n    '#...S.....#',\n    '#.........#',\n    '#####.#####',\n    '  ##.....##  '.trim().padEnd(11, ' ').slice(0, 11).replace(/ /g, '#'),\n    '#.........#',\n    'D....E....D',\n    '#.........#',\n    '#.T.....B.#',\n    '#L.......L#',\n    '#####D#####',\n  ] },\n  { id: 'gallery', rows: [\n    '###################D###',\n    '#L.......L.......L....#',\n    '#.P..P..P..P..P..P....#',\n    '#.....................#',\n    'D...S.....B.....S.....D',\n    '#.....................#',\n    '#.P..P..P..P..P..P....#',\n    '#L.......L.......L..C.#',\n    '###D###################',\n  ] },\n  { id: 'cells', rows: [\n    '#########D#########',\n    '#L..#...B#..T#...L#',\n    '#...#....#...#....#',\n    '#...#S...#...#.S..#',\n    '##.###.####.###.###',\n    '#.................#',\n    'D.........E.......D',\n    '#.................#',\n    '##.###.####.###.###',\n    '#...#....#...#....#',\n    '#.B.#..S.#...#..C.#',\n    '#L..#....#.B.#...L#',\n    '#########D#########',\n  ] },\n  { id: 'rotunda', rows: [\n    '   ####D####   ',\n    '  ##L.....L##  ',\n    ' ##.........## ',\n    '##...........##',\n    '#....S...S....#',\n    '#.....PPP.....#',\n    'D....BPAPB....D',\n    '#.....PPP.....#',\n    '#....S...E....#',\n    '##...........##',\n    ' ##.........## ',\n    '  ##L.....L##  ',\n    '   ####D####   ',\n  ] },\n  { id: 'long_hall', rows: [\n    '##########################',\n    '#L.......L........L.....L#',\n    '#.....B.......B......C...#',\n    'D....S.........S.........D',\n    '#.......T..........T.....#',\n    '#.....B......E.......B...#',\n    '#L.......L........L.....L#',\n    '##########D###############',\n  ] },\n  { id: 'pit_room', rows: [\n    '#########D#########',\n    '#L...............L#',\n    '#...~~~~~~~~~~~...#',\n    '#..~~~~~~~~~~~~~..#',\n    '#..~~~~.....~~~~..#',\n    'D..~~~.......~~~..D',\n    '#......S.E.S......#',\n    '#..~~~.......~~~..#',\n    '#..~~~~.....~~~~..#',\n    '#..~~~~~~~~~~~~~..#',\n    '#...~~~~~.~~~~~...#',\n    '#L.......B.......L#',\n    '#########D#########',\n  ] },\n  { id: 'vault', rows: [\n    '####D########',\n    '#L.........L#',\n    '#.B.......B.#',\n    '#...S...S...#',\n    '#.....T.....#',\n    'D...........D',\n    '#.....E.....#',\n    '#.B.......C.#',\n    '#L.........L#',\n    '#########D###',\n  ] },\n  { id: 'cloister_walk', rows: [\n    '##########D##########',\n    '#L.................L#',\n    '#.PP.PP.PP.PP.PP.PP.#',\n    '#.P~~~~~~~~~~~~~~~P.#',\n    'D.P~~~~~~~~~~~~~~~P.D',\n    '#..~~.....S.....~~..#',\n    '#.P~~....E.A....~~P.#',\n    '#..~~.....S.....~~..#',\n    '#.P~~~~~~~~~~~~~~~P.#',\n    '#.PP.PP.PP.PP.PP.PP.#',\n    '#L.................L#',\n    '##########D##########',\n  ] },\n  { id: 'dead_end', rows: [\n    '#####D#####',\n    '#L.......L#',\n    '#.B.....B.#',\n    '#...S.S...#',\n    '#.........#',\n    '#.B..C..B.#',\n    '#L.......L#',\n    '###########',\n  ] },\n];\n\nexport const LEVER_ROOM = { id: 'lever_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#..B...B..#',\n  '#...S.....#',\n  'D....N....D',\n  '#.....S...#',\n  '#..B...C..#',\n  '#L.......L#',\n  '#####D#####',\n], named: ['lever'] };\n\nexport const START_ROOM = { id: 'start_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#.........#',\n  'D...X.N...D',\n  '#.........#',\n  '#L.......L#',\n  '###########',\n], named: ['lychgate'] };\n\nexport const STAIR_ROOM = { id: 'stair_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#..B...B..#',\n  '#...S.....#',\n  'D....X....D',\n  '#.....E...#',\n  '#..B...B..#',\n  '#L.......L#',\n  '###########',\n] };\n\nexport const RELIC_ROOM = { id: 'relic_room', rows: [\n  '#####D#####',\n  '#L...P...L#',\n  '#...S.S...#',\n  '#.P.....P.#',\n  'D....N....D',\n  '#.P.....P.#',\n  '#...E.S...#',\n  '#L.......L#',\n  '###########',\n], named: ['relic'] };\n\nexport const SHRINE_ROOM = { id: 'shrine_room', rows: [\n  '#####D#####',\n  '#L.......L#',\n  '#..B...B..#',\n  'D....A....D',\n  '#...S.S...#',\n  '#L...N...L#',\n  '#####D#####',\n], named: ['book'] };\nEOF\ncat > src/data/rooms/causeway.js <<'EOF'\n// The Weeping Causeway: long outdoor stretches. '~' is the drowned moor (blocked, no wall).\nconst c = (id, rows, named) => ({ id, rows, named });\nexport const CAUSEWAY = [\n  c('road_start', [\n    '~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~......~~~~~~~~~~~',\n    '~~~......B.....~~~~~~~~',\n    '~~..........L.....~~~~~',\n    '~...............B....~~',\n    '~..X...N.............~D',\n    '~....................~~',\n    '~~.......L.......~~~~~~',\n    '~~~~~~~~......~~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['lychgate']),\n  c('road_a', [\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~......~~~~~....~~~~~',\n    '~~~...B..S.......B.....~~~',\n    '~~.......L.....S..........',\n    'D.....................B..D',\n    '~~.....S....B.......L.....',\n    '~~~~........~~~~.......~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~',\n  ].map((r) => r)),\n  c('road_b', [\n    '~~~~~~~~~~~D~~~~~~~~~~',\n    '~~~~~~~~~.....~~~~~~~~',\n    '~~~~~...S.......~~~~~~',\n    '~~.......B...L.....~~~',\n    'D..................S.D',\n    '~~...L...............~',\n    '~~~~.....S.......B.~~~',\n    '~~~~~~~...........~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~',\n  ]),\n  c('road_c', [\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~.......~~~~~~~......',\n    '~~.....S......~~~...S...',\n    '~.......B...............',\n    'D.....L.........B.......',\n    '~..........~~......L...D',\n    '~~...S....~~~~...S......',\n    '~~~~.....~~~~~~~.......~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n  ]),\n  c('road_d', [\n    '~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~......~~~~~~......~',\n    '~~...S.....B......S..~',\n    '~..........~~.........',\n    'D....L....~~~~...L...D',\n    '~.........~~..........',\n    '~~.....B........B....~',\n    '~~~~........E.......~~',\n    '~~~~~~~~~~~D~~~~~~~~~~',\n  ]),\n  c('road_lych', [\n    '~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~.........~~~~~~~',\n    '~~~.....B...L....~~~~~',\n    '~~.....S............~~',\n    'D..........N.........D',\n    '~~.........A........~~',\n    '~~~.....S.....B..~~~~~',\n    '~~~~~~........~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['lychgate']),\n  c('road_gibbets', [\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~.......N.....~~~~~~',\n    '~~~.....S........N...~~~',\n    '~~..N.......L.........~~',\n    'D.....................~D',\n    '~~.........B.....N.....~',\n    '~~~..N.....S.........~~~',\n    '~~~~~~...........~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['gibbet', 'gibbet', 'gibbet', 'gibbet', 'gibbet']),\n  c('road_e', [\n    '~~~~~~~~~~~~~~~~~~~~~',\n    '~~~......~~~......~~~',\n    '~~..S..B.....S....~~~',\n    '~...............L...~',\n    'D....L.......E......D',\n    '~..........B.........',\n    '~~...S............~~~',\n    '~~~~.....~~~~~....~~~',\n    '~~~~~~~~~~~~~~~~~~~~~',\n  ]),\n  c('side_pantry', [\n    '~~~~~~~~~D~~~~~~~',\n    '~~~~........~~~~~',\n    '~~....S.......~~~',\n    '~...............~',\n    '~...B......B....~',\n    '~......N........~',\n    '~~...L.....L...~~',\n    '~~~~~~~~~~~~~~~~~',\n  ], ['pantry_door']),\n  c('side_ruin', [\n    '~~~~~~~~D~~~~~~~',\n    '~~~~.......~~~~~',\n    '~~...S...B...~~~',\n    '~.............~~',\n    '~..B..A....S..~~',\n    '~~.....N......~~',\n    '~~~~...L....~~~~',\n    '~~~~~~~~~~~~~~~~',\n  ], ['book']),\n  c('camp', [\n    '~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~.........~~~~~~~',\n    '~~~......N........~~~~',\n    '~~..L..........L....~~',\n    'D.......N...N........~',\n    '~~..........L.......~~',\n    '~~~.................~~',\n    '~~~~~~........~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~',\n  ], ['gibbet', 'npc_brasse', 'wagon']),\n];\nEOF\ncat > src/data/rooms/special.js <<'EOF'\n// Authored places and boss rooms.\nexport const YARD = {\n  id: 'yard',\n  rows: [\n    '##############################################################',\n    '#L.........B...#####.................#####....................#',\n    '#..............#####......B..........#####..........L.........#',\n    '#...B......B...#####..............S..#####..........~~~.......#',\n    '#..............#####...L.........B...#####.......L..~~~.......#',\n    '#......N...............................................N......#',\n    '#...........................A.........................#########',\n    '#..............................................................'.slice(0, 62),\n    '#..X...........#####..............S..#####...............N....#',\n    '#..............#####...B.......L.....#####..........B.........#',\n    '#...B..........#####.................#####....L...............#',\n    '#L.........B...#####.........B.......#####..........~~~.......#',\n    '##############################################################',\n  ],\n  named: ['grave_book', 'coffin_quest', 'yard_gate'],\n};\n\nexport const TOWN = {\n  id: 'town',\n  rows: [\n    '##############################################################',\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#~~~~~~#..L............N.................N.........L...#~~~~~~~#'.slice(0, 62),\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#...............L.................L.............#~~~~~~#'.slice(0, 62),\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#.......................................................N....#',\n    '#...............N...........................N................#',\n    '#.......................#####.####...........................#'.slice(0, 62),\n    '#...L...................#.........#.....................L....#',\n    '#.......................#.........#..........................#',\n    '#.........N.............#....P....#.............N............#',\n    '#.......................#.........#..........................#',\n    '#.......................###.....###..........................#',\n    '#...L................................................L.......#',\n    '#...............N...........................N................#',\n    '#............................N...............................#',\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#......####.............................####...#~~~~~~~#',\n    '#~~~~~~#..L............................X...........L...#~~~~~~~#'.slice(0, 62),\n    '#~~~~~~#..............................................#~~~~~~~#',\n    '##############################################################',\n  ],\n  named: ['book', 'npc_crier', 'road_gate', 'npc_pennywhistle', 'knell_font', 'npc_brasse', 'npc_ogive', 'lychgate', 'writ_board', 'stash', 'return_spot'],\n};\n\nexport const COUNTING_HOUSE = { id: 'counting_house', boss: 'bursar', rows: [\n  '##########D###########',\n  '#L.......B....B.....L#',\n  '#.N................N.#',\n  '#....................#',\n  '#....P..........P....#',\n  '#....................#',\n  '#.........B..........#',\n  '#.B..................#',\n  '#.........X........B.#',\n  '#....................#',\n  '#....P..........P....#',\n  '#....................#',\n  '#.N................N.#',\n  '#L.......B....B.....L#',\n  '######################',\n], named: ['coin_pile', 'coin_pile', 'coin_pile', 'coin_pile'] };\n\nexport const CHAPTER_HOUSE = { id: 'chapter_house', boss: 'ambrose', rows: [\n  '##########D###########',\n  '#L..................L#',\n  '#...P............P...#',\n  '#....................#',\n  '#.......B....B.......#',\n  '#....................#',\n  '#.........X..........#',\n  '#....................#',\n  '#.......B....B.......#',\n  '#....................#',\n  '#...P............P...#',\n  '#L..................L#',\n  '######################',\n] };\n\nexport const NOVICE_ROOM = { id: 'novice_room', rows: [\n  '#########D#########',\n  '#L...............L#',\n  '#..P...........P..#',\n  '#.................#',\n  'D......N.N.N......D',\n  '#.................#',\n  '#..N...........N..#',\n  '#.................#',\n  '#..P...........P..#',\n  '#L...............L#',\n  '#########D#########',\n], named: ['novice', 'novice', 'novice', 'font_spot', 'font_spot'] };\n\nexport const PANTRY_BOSS = { id: 'pantry_boss', boss: 'cellarer', rows: [\n  '#####D######',\n  '#L..B..B..L#',\n  '#..........#',\n  '#.~~....~~.#',\n  '#.~~.X..~~.#',\n  '#..........#',\n  '#.B......B.#',\n  '#L........L#',\n  '############',\n] };\n\n// The top of the tower. Round, with six pillars, an arena for the last fight.\nexport const BELFRY_ARENA = {\n  id: 'belfry_arena', boss: 'malison',\n  rows: [\n    '~~~~~~~~~~~~~#######~~~~~~~~~~~~~',\n    '~~~~~~~~~#####.....#####~~~~~~~~~',\n    '~~~~~~~###.............###~~~~~~~',\n    '~~~~~###.................###~~~~~',\n    '~~~~##.....................##~~~~',\n    '~~~##.......................##~~~',\n    '~~##.........................##~~',\n    '~~#...........P.....P.........#~~',\n    '~##...........................##~',\n    '~#.............................#~',\n    '##.............................##',\n    '#.................................#'.slice(0, 33),\n    '#.........P.............P.......#',\n    '#...............................#',\n    '#...............................#',\n    '#...............................#',\n    '#...............................#',\n    '#...............................#',\n    '#.........P.............P.......#',\n    '#...............................#',\n    '##.............................##',\n    '~#.............................#~',\n    '~##...........................##~',\n    '~~#...........P.....P.........#~~',\n    '~~##.........................##~~',\n    '~~~##.......................##~~~',\n    '~~~~##.....................##~~~~',\n    '~~~~~###.................###~~~~~',\n    '~~~~~~~###.............###~~~~~~~',\n    '~~~~~~~~~#####..X..#####~~~~~~~~~',\n    '~~~~~~~~~~~~~#######~~~~~~~~~~~~~',\n  ],\n};\n\nexport const WARDEN_ARENA_NOTE = 'A Warden raises a ring of bone around where it lands.';\nEOF\ncat > src/data/zones.js <<'EOF'\n// Zones as data: what a place is, what lives there, how it is stitched together.\nimport { CAUSEWAY } from './rooms/causeway.js';\nimport { LEVER_ROOM, RELIC_ROOM, SHARED, SHRINE_ROOM, STAIR_ROOM, START_ROOM } from './rooms/shared.js';\nimport { BELFRY_ARENA, CHAPTER_HOUSE, COUNTING_HOUSE, NOVICE_ROOM, PANTRY_BOSS, TOWN, YARD } from './rooms/special.js';\n\nexport const PROP_HP = { urn: 1, barrel: 1, crate: 1, clay: 1, keg: 1, coffin: 2, tombstone: 2, basket: 1, bones: 1, amphora: 1 };\n\nexport const ZONES = {\n  yard: {\n    id: 'yard', name: \"ST. CLEMENT'S YARD\", kind: 'authored', tpl: YARD, biome: 'yard', levelFloor: 1, song: 'weeping_road', floors: 1, bellOk: false,\n    monsters: [['peatwalker', 1]], breakables: ['urn', 'tombstone', 'barrel'], gate: false,\n  },\n  town: {\n    id: 'town', name: 'TOLLHAVEN', kind: 'authored', tpl: TOWN, biome: 'town', levelFloor: 1, song: 'last_lamps', floors: 1, safe: true, bellOk: false,\n    monsters: [], breakables: ['barrel', 'crate', 'urn'], gate: true,\n  },\n  causeway: {\n    id: 'causeway', name: 'THE WEEPING CAUSEWAY', kind: 'gen', biome: 'causeway', levelFloor: 1, song: 'weeping_road', floors: 1,\n    monsters: [['peatwalker', 5], ['gibbet_drop', 2], ['bloat_deacon', 1]], breakables: ['barrel', 'crate', 'tombstone'],\n    gen: { axis: 'x', rooms: 8, start: 'road_start', end: 'camp', fill: ['road_a', 'road_b', 'road_c', 'road_d', 'road_e'], required: ['road_lych', 'road_gibbets'], side: ['side_pantry', 'side_ruin'] },\n    templates: CAUSEWAY,\n  },\n  ossuary: {\n    id: 'ossuary', name: 'THE OSSUARY OF SAINT GLOAM', kind: 'gen', biome: 'ossuary', levelFloor: 6, song: 'under_gloam', floors: 3,\n    monsters: [['peatwalker', 2], ['rattlebones', 5], ['choir_skull', 2], ['pallid_bearer', 1], ['tomb_crawler', 2], ['bloat_deacon', 1], ['crawler_nest', 0.6]], breakables: ['urn', 'coffin', 'clay', 'bones'],\n    gen: { rooms: [8, 10, 11], start: 'start_room', end: 'stair_room', fill: ['nave', 'crossing', 'gallery', 'cells', 'rotunda', 'long_hall', 'pit_room', 'vault', 'dead_end'], required: ['relic_room', 'shrine_room', 'lever_room'], bossAt: { 2: 'counting_house' } },\n    templates: [...SHARED, START_ROOM, STAIR_ROOM, RELIC_ROOM, SHRINE_ROOM, LEVER_ROOM, COUNTING_HOUSE],\n  },\n  cloister: {\n    id: 'cloister', name: 'THE CINDER CLOISTER', kind: 'gen', biome: 'cloister', levelFloor: 11, song: 'cinders', floors: 1,\n    monsters: [['cinderling', 4], ['tithe_collector', 2], ['penitent', 3], ['clapperjaw', 1], ['ash_gargoyle', 2], ['shade_acolyte', 2], ['unrung_font', 0.5]], breakables: ['urn', 'coffin', 'amphora', 'barrel'],\n    gen: { rooms: 11, start: 'start_room', end: 'chapter_house', fill: ['nave', 'crossing', 'gallery', 'rotunda', 'long_hall', 'pit_room', 'vault', 'cloister_walk'], required: ['novice_room', 'shrine_room'] },\n    templates: [...SHARED, START_ROOM, SHRINE_ROOM, NOVICE_ROOM, CHAPTER_HOUSE],\n  },\n  belfry: {\n    id: 'belfry', name: 'THE CRACKED BELFRY', kind: 'gen', biome: 'belfry', levelFloor: 15, song: 'the_climb', floors: 4,\n    monsters: [['rattlebones', 3], ['cinderling', 3], ['penitent', 3], ['clapperjaw', 1], ['ash_gargoyle', 2]], breakables: ['urn', 'coffin', 'clay'],\n    gen: { rooms: [5, 5, 6], start: 'start_room', end: 'stair_room', fill: ['nave', 'gallery', 'rotunda', 'pit_room', 'vault', 'long_hall', 'crossing', 'cloister_walk'], required: ['shrine_room'], arenaFloor: 3 },\n    templates: [...SHARED, START_ROOM, STAIR_ROOM, SHRINE_ROOM],\n    arena: BELFRY_ARENA,\n  },\n  pantry: {\n    id: 'pantry', name: 'THE DROWNED PANTRY', kind: 'gen', biome: 'pantry', levelFloor: 3, song: 'under_gloam', floors: 1,\n    monsters: [['peatwalker', 4], ['bloat_deacon', 1]], breakables: ['barrel', 'keg', 'crate'],\n    gen: { rooms: 4, start: 'start_room', end: 'pantry_boss', fill: ['vault', 'crossing', 'dead_end', 'cells', 'nave'], required: [] },\n    templates: [...SHARED, START_ROOM, PANTRY_BOSS],\n  },\n  knell: {\n    id: 'knell', name: 'A KNELL RUN', kind: 'gen', biome: 'mixed', levelFloor: 1, song: 'the_knell', floors: 2, bellOk: false,\n    monsters: [['peatwalker', 2], ['rattlebones', 3], ['choir_skull', 1], ['tomb_crawler', 2], ['cinderling', 3], ['penitent', 2], ['pallid_bearer', 1], ['clapperjaw', 0.6], ['ash_gargoyle', 1.5], ['tithe_collector', 1], ['bloat_deacon', 1]], breakables: ['urn', 'coffin', 'barrel', 'crate'],\n    gen: { rooms: [14, 15], start: 'start_room', end: 'stair_room', fill: ['nave', 'crossing', 'gallery', 'cells', 'rotunda', 'long_hall', 'pit_room', 'vault', 'cloister_walk', 'dead_end'], required: [] },\n    templates: [...SHARED, START_ROOM, STAIR_ROOM],\n  },\n  session: {\n    id: 'session', name: 'THE KNELL', kind: 'gen', biome: 'mixed', levelFloor: 12, song: 'the_knell', floors: 1, bellOk: false,\n    monsters: [['peatwalker', 2], ['rattlebones', 3], ['choir_skull', 1], ['tomb_crawler', 2], ['cinderling', 3], ['penitent', 2], ['pallid_bearer', 1], ['clapperjaw', 0.6], ['ash_gargoyle', 1.5], ['bloat_deacon', 1]], breakables: ['urn', 'coffin', 'barrel', 'crate'],\n    gen: { rooms: 18, start: 'start_room', end: 'dead_end', fill: ['nave', 'crossing', 'gallery', 'cells', 'rotunda', 'long_hall', 'pit_room', 'vault', 'cloister_walk'], required: [] },\n    templates: [...SHARED, START_ROOM],\n  },\n};\nfor (const z of Object.values(ZONES)) z.levelFloor = z.levelFloor ?? 1;\n\nexport const BIOMES = {\n  yard: { sun: 'sky', sunI: 0.5, ambient: 'navy', ambI: 0.85, bg: 'ink', fog: 'navy', floor: 'mud', wall: 'ashlar', wallH: 2.2, rain: 1, wind: 0.3, torch: 0x9fc4ff, decor: ['tombstone', 'dead-tree', 'bones', 'rubble', 'tombstone', 'stump'], wallDress: ['wall-chains'] },\n  town: { sun: 'orange', sunI: 0.7, ambient: 'plum', ambI: 1.0, bg: 'ink', fog: 'plum', floor: 'cobbles', wall: 'brick-wall', wallH: 2.6, torch: 0xffb060, decor: ['barrel', 'crate', 'sack', 'bench', 'planter', 'hitching-post', 'clothesline'], wallDress: ['banner', 'wall-lantern'] },\n  causeway: { sun: 'sky', sunI: 0.55, ambient: 'navy', ambI: 0.9, bg: 'ink', fog: 'teal', floor: 'mud', wall: 'dry-stone', wallH: 1.2, rain: 1, wind: 0.5, torch: 0xffc080, water: 1, decor: ['dead-tree', 'willow', 'reeds', 'cart', 'tall-grass', 'rock', 'fallen-tree', 'reeds'], wallDress: [] },\n  ossuary: { sun: 'mist', sunI: 0.3, ambient: 'navy', ambI: 0.9, bg: 'ink', fog: 'night', floor: 'flagstones', wall: 'ashlar', wallH: 3, torch: 0xa8e070, pit: 1, decor: ['bones', 'rubble', 'skull-pile', 'cobweb', 'candles', 'sarcophagus', 'cage', 'spikes'], wallDress: ['wall-torch', 'banner', 'wall-chains', 'column'] },\n  cloister: { sun: 'orange', sunI: 0.45, ambient: 'plum', ambI: 0.8, bg: 'ink', fog: 'red', floor: 'slate-tiles', wall: 'sandstone', wallH: 3, torch: 0xff8030, pit: 2, embers: 1, decor: ['rubble', 'ruined-wall', 'brazier', 'flame', 'column', 'bones', 'statue'], wallDress: ['wall-torch', 'banner'] },\n  belfry: { sun: 'sky', sunI: 0.5, ambient: 'navy', ambI: 0.8, bg: 'night', fog: 'navy', floor: 'basalt', wall: 'basalt', wallH: 3, torch: 0x60e0f0, pit: 3, wind: 0.8, decor: ['rubble', 'rune-stone', 'obelisk', 'bones', 'standard'], wallDress: ['wall-chains', 'wall-torch'] },\n  pantry: { sun: 'sky', sunI: 0.3, ambient: 'teal', ambI: 0.8, bg: 'ink', fog: 'teal', floor: 'shallow-water', wall: 'ashlar', wallH: 2.6, torch: 0xffc080, water: 1, decor: ['barrel', 'keg', 'crate-stack', 'sack', 'wall-shelf', 'bucket'], wallDress: ['wall-torch', 'wall-shelf'] },\n  mixed: { sun: 'plum', sunI: 0.45, ambient: 'navy', ambI: 0.9, bg: 'ink', fog: 'plum', floor: 'rune-floor', wall: 'basalt', wallH: 3, torch: 0xd070ff, pit: 3, decor: ['rubble', 'bones', 'skull-pile', 'rune-stone', 'candles', 'obelisk'], wallDress: ['wall-chains', 'wall-torch'] },\n};\n\n// Where each template's floor textures come from, by floor number, for a little variety.\nexport const BIOME_FLOORS = { ossuary: ['flagstones', 'flagstones', 'floor-tiles'], cloister: ['slate-tiles', 'cinders', 'lava-crust'], belfry: ['basalt', 'rune-floor', 'basalt', 'rune-floor'], mixed: ['rune-floor', 'basalt'] };\n\nexport const zoneName = (id, floor) => {\n  const z = ZONES[id];\n  return z.floors > 1 && !(id === 'belfry' && floor === 3) ? `${z.name} ${floor + 1}` : z.name;\n};\nEOF\ncat > src/sim/zonegen.js <<'EOF'\n// Stitches ASCII room templates into a map from a seed. The same code runs on every client.\nimport { NavGrid } from '../../pixel-engine.js';\nimport { ZONES } from '../data/zones.js';\n\nconst OUT = { n: [0, -1], s: [0, 1], w: [-1, 0], e: [1, 0] };\nconst OPP = { n: 's', s: 'n', w: 'e', e: 'w' };\n\nfunction normalize(t) {\n  const w = Math.max(...t.rows.map((r) => r.length));\n  return t.rows.map((r) => r.padEnd(w, ' '));\n}\n\nfunction doorsOf(rows) {\n  const out = [];\n  const h = rows.length, w = rows[0].length;\n  for (let y = 0; y < h; y++) {\n    for (let x = 0; x < w; x++) {\n      if (rows[y][x] !== 'D') continue;\n      let dir = null;\n      if (y === 0 || rows[y - 1][x] === ' ' || rows[y - 1][x] === '~' && y === 0) dir = 'n';\n      else if (y === h - 1) dir = 's';\n      else if (x === 0) dir = 'w';\n      else if (x === w - 1) dir = 'e';\n      else if (rows[y - 1][x] === ' ') dir = 'n';\n      else if (rows[y + 1][x] === ' ') dir = 's';\n      else if (rows[y][x - 1] === ' ') dir = 'w';\n      else if (rows[y][x + 1] === ' ') dir = 'e';\n      if (dir) out.push({ x, y, dir });\n    }\n  }\n  return out;\n}\n\nconst solid = (ch) => ch === '#' || ch === 'D' || ch === '~' || ch === ' ';\nconst key = (x, y) => (x + 4096) * 8192 + (y + 4096);\n\nclass Canvas {\n  constructor() { this.cells = new Map(); this.rooms = []; this.sockets = []; this.links = []; }\n  get(x, y) { return this.cells.get(key(x, y)); }\n  fits(rows, ox, oy) {\n    for (let y = 0; y < rows.length; y++) {\n      for (let x = 0; x < rows[0].length; x++) {\n        const ch = rows[y][x];\n        if (ch === ' ') continue;\n        const cur = this.get(ox + x, oy + y);\n        if (cur === undefined) continue;\n        if (!(solid(ch) && solid(cur))) return false;\n      }\n    }\n    return true;\n  }\n  stamp(tpl, rows, ox, oy) {\n    const index = this.rooms.length;\n    const room = { index, id: tpl.id, x: ox, y: oy, w: rows[0].length, h: rows.length, tpl };\n    this.rooms.push(room);\n    for (let y = 0; y < rows.length; y++) {\n      for (let x = 0; x < rows[0].length; x++) {\n        const ch = rows[y][x];\n        if (ch === ' ') continue;\n        const cur = this.get(ox + x, oy + y);\n        if (cur === undefined || cur === '~' || (cur === '#' && ch === '#')) {\n          if (ch === 'D') this.cells.set(key(ox + x, oy + y), 'D');\n          else if (cur !== '#' || ch !== '~') this.cells.set(key(ox + x, oy + y), ch);\n        }\n      }\n    }\n    for (const d of doorsOf(rows)) {\n      const wx = ox + d.x, wy = oy + d.y;\n      this.sockets.push({ x: wx, y: wy, dir: d.dir, room: index });\n    }\n    return room;\n  }\n}\n\nfunction tryAttach(rng, canvas, tpl, rows, socket) {\n  const doors = doorsOf(rows).filter((d) => d.dir === OPP[socket.dir]);\n  rng.shuffle(doors);\n  for (const d of doors) {\n    const ox = socket.x - d.x, oy = socket.y - d.y;\n    if (!canvas.fits(rows, ox, oy)) continue;\n    const room = canvas.stamp(tpl, rows, ox, oy);\n    canvas.links.push({ x: socket.x, y: socket.y, a: socket.room, b: room.index, dir: socket.dir });\n    canvas.cells.set(key(socket.x, socket.y), '.');\n    // Both sides of the door are now used.\n    canvas.sockets = canvas.sockets.filter((s) => !(s.x === socket.x && s.y === socket.y));\n    return room;\n  }\n  return null;\n}\n\n/** Lay out one floor. Retries with the same stream until the layout is whole; deterministic. */\nexport function layoutFloor(rng, zone, floor) {\n  const g = zone.gen;\n  const rooms = Array.isArray(g.rooms) ? g.rooms[floor] ?? g.rooms[g.rooms.length - 1] : g.rooms;\n  const byId = Object.fromEntries(zone.templates.map((t) => [t.id, t]));\n  const endId = g.bossAt?.[floor] ?? g.end;\n  for (let attempt = 0; attempt < 60; attempt++) {\n    const canvas = new Canvas();\n    const startTpl = byId[g.start];\n    const start = canvas.stamp(startTpl, normalize(startTpl), 0, 0);\n    const required = [...g.required];\n    const fill = () => { const t = byId[rng.pick(g.fill)]; return t; };\n    let ok = true;\n    const sequence = [];\n    const middle = Math.max(0, rooms - 2 - required.length);\n    for (let i = 0; i < middle; i++) sequence.push(fill());\n    for (const r of required) sequence.splice(rng.int(0, sequence.length), 0, byId[r]);\n    for (const tpl of sequence) {\n      const rows = normalize(tpl);\n      const socks = orderSockets(rng, canvas, g, start);\n      let placed = null;\n      for (const s of socks) { placed = tryAttach(rng, canvas, tpl, rows, s); if (placed) break; }\n      if (!placed) { const alt = byId[rng.pick(g.fill)]; const altRows = normalize(alt); for (const s of socks) { placed = tryAttach(rng, canvas, alt, altRows, s); if (placed) break; } }\n      if (!placed) { ok = false; break; }\n    }\n    if (!ok) continue;\n    if (g.side) {\n      for (const id of g.side) {\n        const tpl = byId[id];\n        const rows = normalize(tpl);\n        const socks = canvas.sockets.filter((s) => s.dir === 'n' || s.dir === 's');\n        rng.shuffle(socks);\n        for (const s of socks) if (tryAttach(rng, canvas, tpl, rows, s)) break;\n      }\n    }\n    // The end room goes on the socket farthest from the start, walking room links.\n    const endTpl = byId[endId];\n    const endRows = normalize(endTpl);\n    const socks = farthestSockets(canvas, g);\n    let endRoom = null;\n    for (const s of socks) { endRoom = tryAttach(rng, canvas, endTpl, endRows, s); if (endRoom) break; }\n    if (!endRoom) continue;\n    return finish(canvas, zone, start, endRoom);\n  }\n  throw new Error(`zonegen: no layout for ${zone.id} floor ${floor}`);\n}\n\nfunction orderSockets(rng, canvas, g, start) {\n  const socks = [...canvas.sockets];\n  rng.shuffle(socks);\n  if (g.axis === 'x') {\n    // Walk east: the +X sockets of the latest rooms first.\n    socks.sort((a, b) => (b.dir === 'e' ? b.x + 1000 : b.x * 0.1) - (a.dir === 'e' ? a.x + 1000 : a.x * 0.1));\n  } else {\n    socks.sort((a, b) => b.room - a.room + rng.range(-3, 3));\n  }\n  return socks;\n}\n\nfunction farthestSockets(canvas, g) {\n  const depth = new Map([[0, 0]]);\n  for (const l of canvas.links) depth.set(l.b, (depth.get(l.a) ?? 0) + 1);\n  const socks = [...canvas.sockets];\n  if (g.axis === 'x') socks.sort((a, b) => (b.dir === 'e' ? b.x + 1000 : b.x * 0.1) - (a.dir === 'e' ? a.x + 1000 : a.x * 0.1));\n  else socks.sort((a, b) => (depth.get(b.room) ?? 0) - (depth.get(a.room) ?? 0));\n  return socks;\n}\n\nfunction finish(canvas, zone, startRoom, endRoom) {\n  // Bounds, with a margin of void.\n  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;\n  for (const k of canvas.cells.keys()) {\n    const x = Math.floor(k / 8192) - 4096, y = (k % 8192) - 4096;\n    if (x < minX) minX = x; if (x > maxX) maxX = x;\n    if (y < minY) minY = y; if (y > maxY) maxY = y;\n  }\n  const pad = 2;\n  const W = maxX - minX + 1 + pad * 2, H = maxY - minY + 1 + pad * 2;\n  const rows = [];\n  for (let y = 0; y < H; y++) {\n    let r = '';\n    for (let x = 0; x < W; x++) {\n      const ch = canvas.get(x + minX - pad, y + minY - pad);\n      r += ch === undefined ? ' ' : ch === 'D' ? (zone.gen.axis === 'x' ? '~' : '#') : ch;\n    }\n    rows.push(r);\n  }\n  const rooms = canvas.rooms.map((rm) => ({ ...rm, x: rm.x - minX + pad, y: rm.y - minY + pad, cx: rm.x - minX + pad + rm.w / 2, cz: rm.y - minY + pad + rm.h / 2, tplId: rm.id }));\n  const links = canvas.links.map((l) => ({ ...l, x: l.x - minX + pad, y: l.y - minY + pad }));\n  return { rows, w: W, h: H, rooms, links, start: rooms[startRoom.index], end: rooms[endRoom.index] };\n}\n\nexport function layoutAuthored(tpl) {\n  const rows = normalize(tpl);\n  return { rows, w: rows[0].length, h: rows.length, rooms: [{ index: 0, id: tpl.id, tplId: tpl.id, x: 0, y: 0, w: rows[0].length, h: rows.length, cx: rows[0].length / 2, cz: rows.length / 2, tpl }], links: [], start: null, end: null };\n}\n\n/**\n * Read the markers out of a laid-out map. Returns the grid, nav and lists of what goes where.\n * Pure data: every client gets the same result from the same seed.\n */\nexport function scanLayout(layout, zone, rng) {\n  const out = { lights: [], spawns: [], breakables: [], traps: [], shrines: [], chests: [], named: [], entrances: [], pillars: [] };\n  const rows = layout.rows.map((r) => r.split(''));\n  const bp = zone.breakables ?? ['urn'];\n  const roomOf = (x, y) => layout.rooms.find((rm) => x >= rm.x && x < rm.x + rm.w && y >= rm.y && y < rm.y + rm.h) ?? null;\n  const namedIdx = new Map();\n  for (let y = 0; y < rows.length; y++) {\n    for (let x = 0; x < rows[0].length; x++) {\n      const ch = rows[y][x];\n      const room = roomOf(x, y);\n      const at = { x: x + 0.5, z: y + 0.5, room: room?.index ?? -1 };\n      switch (ch) {\n        case 'L': out.lights.push(at); rows[y][x] = '.'; break;\n        case 'S': out.spawns.push({ ...at, kind: 'S' }); rows[y][x] = '.'; break;\n        case 'E': out.spawns.push({ ...at, kind: 'E' }); rows[y][x] = '.'; break;\n        case 'B': out.breakables.push({ ...at, type: rng.pick(bp) }); rows[y][x] = '.'; break;\n        case 'T': out.traps.push(at); rows[y][x] = '.'; break;\n        case 'A': out.shrines.push(at); rows[y][x] = '.'; break;\n        case 'C': out.chests.push(at); rows[y][x] = '.'; break;\n        case 'X': out.entrances.push(at); rows[y][x] = '.'; break;\n        case 'P': out.pillars.push(at); break;\n        case 'N': {\n          const n = namedIdx.get(room?.index) ?? 0;\n          namedIdx.set(room?.index, n + 1);\n          const name = room?.tpl?.named?.[n] ?? 'nothing';\n          out.named.push({ ...at, name });\n          rows[y][x] = '.';\n          break;\n        }\n        default: break;\n      }\n    }\n  }\n  const finalRows = rows.map((r) => r.join(''));\n  const nav = NavGrid.fromRows(finalRows, { blocked: '#~P ', cell: 1, origin: [0, 0, 0] });\n  return { ...out, finalRows, nav };\n}\n\nexport { OUT, ZONES };\nEOF\necho ok","description":"Write room templates, zones data and generator"}}}
