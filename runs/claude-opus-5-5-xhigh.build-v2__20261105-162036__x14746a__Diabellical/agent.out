{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkj3ScpvfLoRNTnV6TST","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23187,"cache_read_input_tokens":650372,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23187},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"c0496163-869e-4ba5-b161-833ba9538753","timestamp":"2026-11-06T00:26:47.436Z","request_id":"req_011Cgkj3SMBzMjd4hzVz5h6q","thinking_duration_ms":929,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkj3ScpvfLoRNTnV6TST","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QZ5KW3kPra7bpq6B595q6z","name":"Bash","input":{"command":"cat > src/ui/menus/world.js <<'EOF'\n// Screens that sit over the world: the map, dialogue, death, the Knell Font, writs, cutscenes.\nimport { CLASSES } from '../../data/classes.js';\nimport { BARKS, NPC_LABELS, SPEAKERS, STORY_LINES, SYSTEM_LINES, TALKS } from '../../data/dialog.js';\nimport { LORE } from '../../data/lore.js';\nimport { KNELL_MOD_IDS, KNELL_MODS } from '../../data/quests.js';\nimport { DIFFICULTIES, RULES } from '../../data/tuning.js';\nimport { ZONES, zoneName } from '../../data/zones.js';\nimport { THREE, Timeline } from '../../../pixel-engine.js';\nimport { usableGate, zoneOpen } from '../../sim/commands.js';\nimport { rollMods } from '../../sim/knell.js';\nimport { currentQuest, currentStep, objectiveOf } from '../../sim/quests.js';\nimport { fmtNum } from '../../view/view.js';\nimport { icon } from '../icons.js';\nimport { frame, Screen } from './base.js';\nimport { BrasseScreen, OgiveScreen, PennywhistleScreen, StashScreen } from './vendors.js';\n\nexport class MapScreen extends Screen {\n  constructor(game) { super(game, { tag: 'map' }); }\n  draw(ui) {\n    const g = this.game;\n    const w = g.world;\n    const z = w.zone;\n    frame(ui, zoneName(z.id, z.floor).slice(0, 26));\n    const h = this.hero;\n    // Explored cells, whole floor.\n    const mx = 12, my = 30, mw = Math.min(ui.w - 170, 300), mh = ui.h - 58;\n    ui.rect(mx - 1, my - 1, mw + 2, mh + 2, 'slate');\n    ui.rect(mx, my, mw, mh, 'night');\n    const s = Math.max(1, Math.floor(Math.min(mw / z.w, mh / z.h)));\n    const ox = mx + Math.floor((mw - z.w * s) / 2), oy = my + Math.floor((mh - z.h * s) / 2);\n    for (let row = 0; row < z.h; row++) {\n      let run = -1, col = null;\n      for (let c = 0; c <= z.w; c++) {\n        let k = null;\n        if (c < z.w && z.seen[row * z.w + c]) {\n          const ch = z.rows[row][c];\n          k = ch === '#' || ch === 'P' ? 'mist' : ch === '~' || ch === ' ' ? null : 'slate';\n        }\n        if (k !== col) { if (col) ui.hud.rect(ox + run * s, oy + row * s, (c - run) * s, s, col); run = c; col = k; }\n      }\n    }\n    const mark = (x, zz, c, size = 3) => ui.hud.rect(Math.floor(ox + x * s - size / 2), Math.floor(oy + zz * s - size / 2), size, size, c);\n    for (const o of w.objects) {\n      if (o.hidden || !z.seen[Math.floor(o.z) * z.w + Math.floor(o.x)]) continue;\n      if (o.kind === 'lychgate') mark(o.x, o.z, 'lime');\n      else if (o.kind === 'exit') mark(o.x, o.z, 'sky');\n      else if (o.kind === 'npc') mark(o.x, o.z, 'sand');\n      else if (o.kind === 'shrine' && o.state === 0) mark(o.x, o.z, 'orange');\n    }\n    for (const a of w.heroes) if (!a.gone) mark(a.x, a.z, a === h ? 'white' : 'mist', 4);\n    const q = w.camp ? objectiveOf(w) : null;\n    if (q?.zone === z.id && (q.floor === undefined || q.floor === z.floor)) {\n      const o = q.key ? w.objects.find((b) => b.key === q.key && !b.hidden) : null;\n      const r = q.boss ? z.rooms.find((b) => b.tpl?.boss === q.boss) : null;\n      const qx = o?.x ?? r?.cx ?? q.x, qz = o?.z ?? r?.cz ?? q.z;\n      if (qx !== undefined && g.frame % 40 < 28) mark(qx, qz, 'red', 5);\n    }\n    // Travel.\n    const lx = mx + mw + 8, lw = ui.w - lx - 12;\n    const canTravel = w.camp && (z.def.safe || (h && usableGate(w, h)));\n    const quest = w.camp ? currentStep(w) : null;\n    let y = my;\n    if (quest) { ui.textBlock(lx, y, quest.text, lw, { color: 'sand', lineH: 9 }); y += ui.wrap(quest.text, lw).length * 9 + 6; }\n    if (canTravel) {\n      ui.text(lx, y, 'TRAVEL', { color: 'mist' }); y += 11;\n      const dest = [];\n      if (z.id !== 'town') dest.push({ label: 'TOLLHAVEN', cmd: { c: 'travel', zone: 'town' } });\n      for (const zid of ['causeway', 'ossuary', 'cloister', 'belfry']) {\n        if (zoneOpen(w, zid) && !(z.id === zid && z.floor === 0)) dest.push({ label: ZONES[zid].name.replace('THE ', ''), cmd: { c: 'travel', zone: zid } });\n      }\n      for (const [key, gate] of Object.entries(w.camp.gates)) {\n        if (gate.zone === 'town' || (gate.zone === z.id && gate.floor === z.floor) || gate.floor === 0) continue;\n        dest.push({ label: `${ZONES[gate.zone].name.replace('THE ', '').slice(0, 12)} ${gate.floor + 1}`, cmd: { c: 'travel', key } });\n      }\n      dest.slice(0, 9).forEach((d, i) => {\n        if (ui.button(`map:${i}`, lx, y, lw, 13, d.label.slice(0, Math.floor((lw - 8) / 6)), { left: true })) { g.cmd(d.cmd); g.closeScreen(); }\n        y += 14;\n      });\n    } else ui.textBlock(lx, y, 'STAND AT A LYCHGATE TO TRAVEL.', lw, { color: 'slate', lineH: 9 });\n    ui.footer([['back', 'CLOSE']]);\n  }\n}\n\n// ---- Dialogue ---------------------------------------------------------------------------------\nconst SERVICES = {\n  pennywhistle: [['TRADE', (g) => g.openScreen(new PennywhistleScreen(g))]],\n  brasse: [['FORGE', (g) => g.openScreen(new BrasseScreen(g))]],\n  ogive: [['RELIQUARY', (g) => g.openScreen(new OgiveScreen(g))]],\n};\n\nexport function dialogueFor(w, npc, rng) {\n  const st = w.camp ? `${npc}:${currentQuest(w)?.id}.${currentStep(w)?.id}` : '';\n  if (TALKS[st]) return TALKS[st];\n  if (npc === 'crier' && w.camp?.flags.overdue_found && !w.camp.flags.overdue_done) return TALKS['crier:overdue'];\n  const barks = BARKS[npc] ?? ['...'];\n  return [[npc, barks[Math.floor(rng.next() * barks.length)]]];\n}\n\nexport class DialogueScreen extends Screen {\n  constructor(game, npc, id) {\n    super(game, { tag: 'dialogue', freeze: false, holdSim: true });\n    this.npc = npc;\n    this.objId = id;\n    this.lines = dialogueFor(game.world, npc, game.uiRng);\n    this.i = 0;\n    this.holdT = 0;\n    this.spokenI = -1;\n  }\n  get services() {\n    const w = this.game.world;\n    if (this.npc === 'brasse' && !w.camp?.flags.forge) return [];\n    if (this.npc === 'ogive' && !w.camp?.flags.reliquary) return [];\n    if (this.npc === 'pennywhistle' && !w.camp?.flags.crier_met) return [];\n    return SERVICES[this.npc] ?? [];\n  }\n  onOpen() {\n    const o = this.game.world.objects.find((q) => q.id === this.objId);\n    if (o) this.game.view.camOverride = { x: o.x, z: o.z, zoom: 1.45 };\n  }\n  onClose() { this.game.view.camOverride = null; }\n  finish() {\n    if (this.done) return;\n    this.done = true;\n    this.game.cmd({ c: 'talk_done', npc: this.npc });\n  }\n  back() { this.finish(); this.game.closeScreen(); }\n  draw(ui) {\n    const W = ui.w, H = ui.h;\n    const barH = 22;\n    ui.rect(0, 0, W, barH, 'ink');\n    ui.rect(0, H - 62, W, 62, 'ink');\n    ui.rect(0, H - 63, W, 1, 'slate');\n    const input = this.game.input.menu;\n    const line = this.lines[this.i];\n    if (line) {\n      const [who, text] = line;\n      if (this.spokenI !== this.i) { this.spokenI = this.i; this.game.audioSys?.speak(who, text); }\n      const sp = SPEAKERS[who] ?? { name: '', color: 'mist' };\n      if (sp.name) ui.text(20, H - 58, sp.name, { color: sp.color });\n      ui.textBlock(20, H - 47, text, W - 40, { color: 'white', lineH: 9 });\n      if (input.skipHeld) this.holdT += 1 / 60; else this.holdT = 0;\n      if (this.holdT > 0.5) { this.i = this.lines.length; }\n      if (input.confirm || input.click || input.back) {\n        this.i++;\n        this.game.audioSys?.sfx('ui_move');\n      }\n      ui.prompt('confirm', 'NEXT', W - 70, H - 14);\n      return;\n    }\n    // Lines done: choices, or leave.\n    const opts = this.services;\n    this.finish();\n    if (!opts.length) { this.game.closeScreen(); return; }\n    ui.text(20, H - 58, NPC_LABELS[this.npc], { color: SPEAKERS[this.npc]?.color ?? 'sand' });\n    let x = 20;\n    const y = H - 44;\n    for (const [label, act] of opts) {\n      if (ui.button(`talk:${label}`, x, y, 80, 18, label)) { this.game.closeScreen(); act(this.game); return; }\n      x += 84;\n    }\n    if (ui.button('talk:leave', x, y, 80, 18, 'LEAVE')) this.game.closeScreen();\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n  }\n}\n\nexport class LoreScreen extends Screen {\n  constructor(game, id) {\n    super(game, { tag: 'lore', freeze: false, holdSim: true });\n    this.id = id;\n    this.page = 0;\n  }\n  draw(ui) {\n    const l = LORE[this.id];\n    const W = ui.w, H = ui.h;\n    ui.panel(30, 26, W - 60, H - 60, { border: 'sand' });\n    ui.text(W / 2, 34, l.title, { color: 'sand', align: 'center', scale: 2 });\n    const text = l.pages[this.page];\n    if (this.spoken !== this.page) { this.spoken = this.page; this.game.audioSys?.speak('narrator', text); }\n    ui.textBlock(42, 58, text, W - 84, { color: 'white' });\n    ui.text(W / 2, H - 46, `${this.page + 1}/${l.pages.length}`, { color: 'slate', align: 'center' });\n    const input = this.game.input.menu;\n    if (input.confirm || input.click) {\n      if (this.page + 1 < l.pages.length) this.page++;\n      else this.game.closeScreen();\n    }\n    ui.footer([['confirm', 'TURN THE PAGE'], ['back', 'CLOSE']]);\n  }\n}\n\n// ---- Death ------------------------------------------------------------------------------------\nexport class DeathScreen extends Screen {\n  constructor(game, seat) { super(game, { tag: 'death', freeze: false }); this.seat = seat; }\n  draw(ui) {\n    const g = this.game;\n    const h = g.world.heroes.find((o) => o.seat === this.seat);\n    if (!h || !h.dead) { g.closeScreen(); return; }\n    const W = ui.w, H = ui.h;\n    ui.rect(0, H / 2 - 56, W, 112, 'ink');\n    ui.text(W / 2, H / 2 - 48, SYSTEM_LINES.death, { color: 'red', align: 'center' });\n    const wait = Math.max(0, (h.deathWait ?? 5) - h.deadT);\n    const bw = 170, x = W / 2 - bw / 2;\n    if (ui.button('rise:here', x, H / 2 - 30, bw, 18, wait > 0 ? `RISE HERE ${Math.ceil(wait)}` : 'RISE HERE', { disabled: wait > 0 })) g.cmd({ c: 'rise', how: 'here' });\n    if (!g.isSession) {\n      const hasGate = g.world.camp?.lastGate;\n      if (ui.button('rise:gate', x, H / 2 - 10, bw, 18, 'THE LAST LYCHGATE', { disabled: !hasGate })) g.cmd({ c: 'rise', how: 'gate' });\n      if (ui.button('rise:town', x, H / 2 + 10, bw, 18, 'TOLLHAVEN')) g.cmd({ c: 'rise', how: 'town' });\n    }\n    if (g.humanCount() > 1) ui.text(W / 2, H / 2 + 34, 'AN ALLY MAY HOLD INTERACT OVER YOU', { color: 'mist', align: 'center' });\n  }\n  back() {}\n}\n\n// ---- Knell Font ------------------------------------------------------------------------------\nexport class KnellScreen extends Screen {\n  constructor(game) {\n    super(game, { tag: 'knell' });\n    this.tab = 0;\n    this.tier = 1;\n    const w = game.world;\n    this.mods = rollMods(game.uiRng, game.uiRng.next() < 0.5 ? 1 : 2);\n  }\n  draw(ui) {\n    const g = this.game;\n    const w = g.world;\n    const h = this.hero;\n    frame(ui, 'THE KNELL FONT');\n    const unlocked = w.account.unlocks.knell;\n    // Difficulty.\n    let y = 32;\n    ui.text(14, y, 'THE PARISH RECOMMENDS AGAINST IT', { color: 'mist' });\n    y += 12;\n    const diffs = DIFFICULTIES.filter((d) => !d.penance || w.account.unlocks.penance);\n    const cw = Math.floor((ui.w - 28 - (diffs.length - 1) * 2) / Math.max(4, Math.min(8, diffs.length)));\n    diffs.forEach((d, i) => {\n      const x = 14 + (i % 4) * (cw + 2);\n      const label = d.name.replace('PENANCE ', 'P.');\n      const on = w.difficulty === DIFFICULTIES.indexOf(d);\n      if (ui.button(`diff:${i}`, x, y + Math.floor(i / 8) * 15, cw, 14, label, { color: on ? 'sand' : 'mist', focusColor: on ? 'white' : 'sand' })) g.cmd({ c: 'difficulty', index: DIFFICULTIES.indexOf(d) });\n    });\n    y += 22;\n    const cur = w.diffDef;\n    ui.text(14, y, `MONSTER LIFE X${cur.hp}   DAMAGE X${cur.dmg}   REWARD X${cur.reward}`, { color: 'white' });\n    y += 14;\n    if (!unlocked) {\n      ui.textBlock(14, y, 'THE FONT IS STILL. RING THE GREAT BELL FIRST, AND THE KNELL WILL ANSWER.', ui.w - 28, { color: 'slate' });\n      ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n      return;\n    }\n    // Modifiers as big cards.\n    const mw = Math.floor((ui.w - 28 - 6) / 2);\n    this.mods.forEach((m, i) => {\n      const def = KNELL_MODS[m];\n      const x = 14 + i * (mw + 6);\n      ui.panel(x, y, mw, 34, { border: 'plum' });\n      const ic = icon(def.icon);\n      ui.sprite(x + 4, y + 11, ic.rows, ic.colors);\n      ui.text(x + 20, y + 6, def.name, { color: 'sand' });\n      ui.text(x + 20, y + 18, def.desc.slice(0, Math.floor((mw - 26) / 6)), { color: 'white' });\n    });\n    y += 40;\n    if (ui.button('knell:go', 14, y, mw, 22, 'BEGIN A KNELL RUN', { color: 'white' })) {\n      g.closeScreen();\n      g.cmd({ c: 'knell_start', mods: this.mods });\n      return;\n    }\n    const keys = h.grandKeys ?? 0;\n    if (ui.button('knell:grand', 14 + mw + 6, y, mw - 40, 22, `GRAND KNELL (${keys} KEYS)`, { disabled: keys <= 0 })) {\n      g.closeScreen();\n      g.cmd({ c: 'knell_start', mods: this.mods, grand: true, tier: this.tier });\n      return;\n    }\n    if (ui.button('knell:tier', ui.w - 14 - 38, y, 38, 22, `T${this.tier}`, { color: 'sand' })) this.tier = this.tier >= 20 ? 1 : this.tier + 1;\n    y += 28;\n    const best = w.account.bests[h.cls];\n    ui.text(14, y, best ? `YOUR BEST AS ${CLASSES[h.cls].name}: TIER ${best.tier} IN ${Math.floor(best.time / 60)}:${String(best.time % 60).padStart(2, '0')}` : `NO GRAND KNELL YET AS ${CLASSES[h.cls].name}`, { color: 'mist' });\n    y += 10;\n    if (best !== undefined || keys) ui.text(14, y, `TIER ${this.tier}: LIFE X${(1.17 ** this.tier).toFixed(1)} DAMAGE X${(1.08 ** this.tier).toFixed(1)}. TEN MINUTES.`, { color: 'slate' });\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n  }\n}\n\nexport class ResultsScreen extends Screen {\n  constructor(game, r) { super(game, { tag: 'results', freeze: false }); this.r = r; }\n  draw(ui) {\n    const r = this.r;\n    const W = ui.w, H = ui.h;\n    ui.panel(W / 2 - 150, 36, 300, H - 90, { border: 'sand' });\n    ui.text(W / 2, 44, r.grand ? (r.beat ? 'THE GRAND KNELL, ANSWERED' : 'THE GRAND KNELL, TOO LATE') : 'THE KNELL IS SILENCED', { color: 'sand', align: 'center' });\n    const t = Math.round(r.time);\n    ui.text(W / 2, 60, `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`, { color: 'white', scale: 3, align: 'center' });\n    let y = 92;\n    if (r.grand) { ui.text(W / 2, y, `TIER ${r.tier}${r.best ? '  A NEW BEST' : ''}`, { color: r.best ? 'lime' : 'white', scale: 2, align: 'center' }); y += 22; }\n    ui.text(W / 2, y, `+${fmtNum(r.xp)} XP   +${r.shards} BELL SHARDS`, { color: 'white', align: 'center' });\n    y += 12;\n    if (r.keys) ui.text(W / 2, y, 'A GRAND KEY FELL', { color: 'orange', align: 'center' });\n    if (ui.button('results:ok', W / 2 - 50, H - 78, 100, 18, 'VERY WELL')) this.game.closeScreen();\n  }\n}\n\nexport class WritsScreen extends Screen {\n  constructor(game) { super(game, { tag: 'writs' }); }\n  draw(ui) {\n    const g = this.game;\n    const w = g.world;\n    frame(ui, 'THE WRIT BOARD');\n    const camp = w.camp;\n    if (!camp.writs.length || camp.writCache) {\n      ui.textBlock(14, 36, camp.writCache ? 'ALL THREE PAID. THE VESTRY HAS MORE, IF YOU HAVE THE STOMACH.' : 'THREE JOBS, ON MAPS YOU KNOW. FINISH ALL THREE FOR A CACHE.', ui.w - 28, { color: 'white' });\n      if (ui.button('writs:new', 14, 70, 170, 20, 'TAKE NEW WRITS')) { g.cmd({ c: 'writs' }); }\n    } else {\n      camp.writs.forEach((wr, i) => {\n        const y = 36 + i * 30;\n        ui.panel(14, y, ui.w - 28, 26, { border: wr.done ? 'lime' : 'slate' });\n        ui.text(20, y + 4, wr.text.slice(0, Math.floor((ui.w - 40) / 6)), { color: wr.done ? 'lime' : 'white' });\n        ui.text(20, y + 14, wr.done ? 'DONE' : wr.k === 'kill' ? `${wr.have}/${wr.n}` : 'NOT YET', { color: 'mist' });\n      });\n      ui.text(14, 130, `WRITS DONE ${camp.writsDone}  CACHES ${camp.writCaches}`, { color: 'sand' });\n    }\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n  }\n}\n\n// ---- Cutscenes --------------------------------------------------------------------------------\n/** Lines over the world or over black, on a Timeline. Hold to skip. */\nexport class Cutscene extends Screen {\n  constructor(game, o) {\n    super(game, { tag: 'cutscene', freeze: false, holdSim: true });\n    this.o = o;\n    let at = 0.6;\n    const lines = [];\n    for (const [who, text] of o.lines) {\n      const dur = Math.max(2.8, text.length * 0.075);\n      lines.push({ at, until: at + dur, text, who });\n      at += dur + 0.5;\n    }\n    this.tl = new Timeline({ lines, duration: at + (o.extra ?? 0.5), bars: 0.5, cues: o.cues ?? [], onEnd: () => { this.ended = true; } });\n    this.tl.play();\n    this.holdT = 0;\n    this.curLine = null;\n  }\n  onOpen() {\n    if (this.o.music) this.game.audioSys?.music(this.o.music);\n    if (this.o.toll) this.game.audioSys?.sfx(this.o.toll);\n    if (this.o.cam) this.game.view.camOverride = this.o.cam;\n  }\n  onClose() {\n    this.game.view.camOverride = null;\n    this.o.onEnd?.(this.game);\n  }\n  back() {}\n  draw(ui, dt) {\n    const g = this.game;\n    this.tl.update(g.lastRealDt);\n    const W = ui.w, H = ui.h;\n    if (this.o.black) ui.rect(0, 0, W, H, 'ink');\n    const bars = Math.round(this.tl.bars() * 24);\n    if (bars > 0 && !this.o.black) { ui.rect(0, 0, W, bars, 'ink'); ui.rect(0, H - bars, W, bars, 'ink'); }\n    const l = this.tl.line();\n    if (l && l !== this.curLine) { this.curLine = l; g.audioSys?.speak(l.who, l.text); }\n    if (l) {\n      const sp = SPEAKERS[l.who] ?? { name: '', color: 'mist' };\n      const lines = ui.wrap(l.text, W - 80);\n      let y = this.o.black ? H / 2 - lines.length * 6 : H - 22 - lines.length * 9;\n      if (sp.name) { ui.text(W / 2, y - 10, sp.name, { color: sp.color, align: 'center' }); }\n      for (const t of lines) { ui.text(W / 2, y, t, { color: 'white', align: 'center' }); y += 10; }\n    }\n    if (this.o.title) ui.text(W / 2, 40, this.o.title, { color: 'sand', align: 'center', scale: 2 });\n    const input = g.input.menu;\n    if (input.skipHeld) { this.holdT += g.lastRealDt; } else this.holdT = 0;\n    if (this.holdT > 0.6 || g.skipCutscenes) this.tl.skip();\n    ui.prompt('confirm', this.holdT > 0 ? 'HOLDING' : 'HOLD TO SKIP', W - 100, H - 14);\n    if (this.ended) g.closeScreen();\n  }\n}\n\nexport const STORY = {\n  opening: (o = {}) => ({ lines: STORY_LINES.opening, black: true, toll: 'bell_cracked', music: 'vespers', ...o }),\n  bursar_intro: { lines: STORY_LINES.bursar_intro },\n  ambrose_intro: { lines: STORY_LINES.ambrose_intro },\n  malison_intro: { lines: STORY_LINES.malison_intro },\n  cellarer_intro: { lines: STORY_LINES.cellarer_intro },\n};\n\nexport { THREE, RULES, StashScreen };\nEOF\ncat > src/ui/menus/pause.js <<'EOF'\n// Pause, Party, Settings and About.\nimport { CLASSES, PLAYABLE } from '../../data/classes.js';\nimport { TITLE } from '../../data/meta.js';\nimport { HOW_TO_PLAY } from '../../data/lore.js';\nimport { LOOK_PRESETS } from '../../../pixel-engine.js';\nimport { INTERVIEW, KIT_CREDITS } from '../../data/about.generated.js';\nimport { SEAT_COLORS } from '../../view/actors.js';\nimport { DevScreen } from './dev.js';\nimport { frame, Screen } from './base.js';\nimport { HeroScreen } from './hero.js';\nimport { MapScreen } from './world.js';\n\nexport class PauseScreen extends Screen {\n  constructor(game) { super(game, { tag: 'pause', freeze: !game.isSession }); }\n  draw(ui) {\n    const g = this.game;\n    const W = ui.w, H = ui.h;\n    const items = g.isSession\n      ? [['RESUME', () => g.closeScreen()], ['SETTINGS', () => g.openScreen(new SettingsScreen(g))], ['HOW TO PLAY', () => g.openScreen(new HowToScreen(g))]]\n      : [\n        ['RESUME', () => g.closeScreen()],\n        ['HERO', () => g.openScreen(new HeroScreen(g, 0))],\n        ['MAP', () => g.openScreen(new MapScreen(g))],\n        ['PARTY', () => g.openScreen(new PartyScreen(g))],\n        ['HOW TO PLAY', () => g.openScreen(new HowToScreen(g))],\n        ['SETTINGS', () => g.openScreen(new SettingsScreen(g))],\n        ['DEV MODE', () => g.openScreen(new DevScreen(g))],\n        ['ABOUT', () => g.openScreen(new AboutScreen(g))],\n        ['SAVE AND QUIT', () => g.saveAndQuit()],\n      ];\n    const bw = 150, bh = 16, gap = 2;\n    const total = items.length * (bh + gap);\n    const x = Math.floor(W / 2 - bw / 2), y0 = Math.floor(H / 2 - total / 2) + 6;\n    ui.panel(x - 8, y0 - 22, bw + 16, total + 28, { border: 'plum' });\n    ui.text(W / 2, y0 - 16, 'A PAUSE IN THE TOLLING', { color: 'sand', align: 'center' });\n    items.forEach(([label, act], i) => {\n      if (ui.button(`pause:${label}`, x, y0 + i * (bh + gap), bw, bh, label)) act();\n    });\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'RESUME']]);\n  }\n}\n\nexport class HowToScreen extends Screen {\n  constructor(game) { super(game, { tag: 'howto' }); this.page = 0; }\n  draw(ui) {\n    frame(ui, '');\n    const p = HOW_TO_PLAY[this.page];\n    ui.text(14, 14, p.title, { color: 'sand', scale: 2 });\n    let y = 36;\n    for (const line of p.lines) y += ui.textBlock(14, y, line, ui.w - 28, { color: 'white' }) + 3;\n    ui.text(ui.w - 14, ui.h - 26, `${this.page + 1}/${HOW_TO_PLAY.length}`, { color: 'slate', align: 'right' });\n    const input = this.game.input.menu;\n    if (input.confirm || input.tabR || input.right || input.down || input.wheel > 0 || input.click) this.page = (this.page + 1) % HOW_TO_PLAY.length;\n    if (input.tabL || input.left || input.up || input.wheel < 0) this.page = (this.page - 1 + HOW_TO_PLAY.length) % HOW_TO_PLAY.length;\n    ui.footer([['confirm', 'NEXT'], ['back', 'BACK']]);\n  }\n}\n\nexport class PartyScreen extends Screen {\n  constructor(game) { super(game, { tag: 'party' }); }\n  draw(ui) {\n    const g = this.game;\n    frame(ui, 'THE PARTY');\n    const w = g.world;\n    const humans = w.heroes.filter((h) => !h.gone && !h.companion);\n    humans.forEach((h, i) => {\n      const y = 36 + i * 24;\n      ui.panel(14, y, ui.w - 28, 22, { border: SEAT_COLORS[h.seat] });\n      ui.text(20, y + 3, `P${h.seat + 1}  ${h.name}  LV ${h.level} ${CLASSES[h.cls].name}`, { color: SEAT_COLORS[h.seat] });\n      const dev = g.input.seats[h.seat];\n      ui.text(20, y + 12, dev?.pad !== null && dev?.pad !== undefined ? `PAD ${dev.pad + 1}` : 'KEYBOARD AND MOUSE', { color: 'mist' });\n      if (h.seat > 0 && ui.button(`party:leave${h.seat}`, ui.w - 84, y + 3, 64, 16, 'LEAVE')) g.leaveSeat(h.seat);\n    });\n    const free = g.freePads();\n    let y = 36 + humans.length * 24 + 6;\n    if (humans.length < 4) {\n      if (free.length) {\n        ui.text(14, y, 'A FREE CONTROLLER MAY JOIN AS:', { color: 'white' });\n        y += 12;\n        PLAYABLE.forEach((cls, i) => {\n          if (ui.button(`party:join${cls}`, 14 + i * 110, y, 106, 18, CLASSES[cls].name)) g.joinSeat(free[0], cls);\n        });\n        y += 24;\n      } else {\n        ui.textBlock(14, y, 'CONNECT ANOTHER CONTROLLER AND PRESS OPTIONS TO JOIN. IT WORKS AT ANY TIME.', ui.w - 28, { color: 'mist' });\n        y += 24;\n      }\n    }\n    if (g.input.menu.pause && humans.length > 1) g.leaveLastSeat();\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\n\nconst LOOKS = [['NATIVE', null], ['SPOOKY', 'spooky'], ['16-BIT', 'sixteen_bit'], ['PS1 HORROR', 'ps1_horror'], ['OLD PHOTO', 'old_photo'], ['NOIR', 'noir']];\n\nexport class SettingsScreen extends Screen {\n  constructor(game) { super(game, { tag: 'settings' }); this.page = 0; }\n  rows() {\n    const g = this.game;\n    const a = g.ctx.audio;\n    const s = g.settings;\n    const pct = (v) => `${Math.round(v * 100)}%`;\n    const vol = (ch) => ({ get: () => pct(a.volume[ch]), step: (d) => a.setVolume(ch, Math.max(0, Math.min(1, Math.round((a.volume[ch] + d * 0.05) * 100) / 100))) });\n    const es = g.ctx.engine.settings;\n    return [\n      ['MASTER VOLUME', vol('master')],\n      ['MUSIC VOLUME', vol('music')],\n      ['SOUND VOLUME', vol('sfx')],\n      ['VOICES VOLUME', { get: () => pct(s.voices), step: (d) => { s.voices = Math.max(0, Math.min(1, Math.round((s.voices + d * 0.05) * 100) / 100)); g.audioSys.voicesVol = s.voices; } }],\n      ['BUTTON GLYPHS', { get: () => (s.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'), step: () => { s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'; } }],\n      ['SCREEN SHAKE', { get: () => pct(s.shake), step: (d) => { s.shake = Math.max(0, Math.min(2, Math.round((s.shake + d * 0.25) * 100) / 100)); } }],\n      ['DAMAGE NUMBERS', { get: () => (s.numbers ? 'ON' : 'OFF'), step: () => { s.numbers = !s.numbers; } }],\n      ['ZOOM', { get: () => pct(s.zoom), step: (d) => { s.zoom = Math.max(0.6, Math.min(1.4, Math.round((s.zoom + d * 0.1) * 100) / 100)); } }],\n      ['LOOK', { get: () => LOOKS[s.lookIndex ?? 0][0], step: (d) => { s.lookIndex = ((s.lookIndex ?? 0) + d + LOOKS.length) % LOOKS.length; g.applyLook(); } }],\n      ['PIXEL SIZE', { get: () => ((es.values.pixelSize ?? 'fine') === 'fine' ? 'FINE' : 'CHUNKY'), step: () => es.set({ pixelSize: (es.values.pixelSize ?? 'fine') === 'fine' ? 'chunky' : 'fine' }) }],\n      ['QUALITY', { get: () => (es.values.quality ?? 'high').toUpperCase(), step: (d) => { const q = ['low', 'medium', 'high']; const i = q.indexOf(es.values.quality ?? 'high'); es.set({ quality: q[(i + d + 3) % 3] }); } }],\n      ['FULLSCREEN', { get: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF'), step: () => g.toggleFullscreen() }],\n    ];\n  }\n  back() { this.game.saveSettings(); this.game.closeScreen(); }\n  draw(ui) {\n    const g = this.game;\n    frame(ui, 'SETTINGS');\n    const input = g.input.menu;\n    const rows = this.rows();\n    const perPage = Math.floor((ui.h - 62) / 15);\n    const pages = Math.ceil(rows.length / perPage);\n    if (input.tabR) this.page = (this.page + 1) % pages;\n    if (input.tabL) this.page = (this.page - 1 + pages) % pages;\n    this.page = Math.min(this.page, pages - 1);\n    rows.slice(this.page * perPage, this.page * perPage + perPage).forEach(([label, r], i) => {\n      const y = 32 + i * 15;\n      const w = ui.widget(`set:${label}`, 14, y, ui.w - 28, 14);\n      ui.rect(14, y, ui.w - 28, 14, w.focused ? 'plum' : 'night');\n      ui.text(20, y + 3, label, { color: w.focused ? 'white' : 'mist' });\n      ui.text(ui.w - 20, y + 3, `< ${r.get()} >`, { color: 'sand', align: 'right' });\n      if (w.focused) {\n        if (input.left) { r.step(-1); g.audioSys?.sfx('ui_tab'); }\n        if (input.right) { r.step(1); g.audioSys?.sfx('ui_tab'); }\n      }\n      if (w.activated) { r.step(1); g.audioSys?.sfx('ui_tab'); }\n      if (w.alt) { r.step(-1); g.audioSys?.sfx('ui_tab'); }\n    });\n    const fy = 32 + Math.min(perPage, rows.length) * 15 + 2;\n    if (ui.button('set:reset', 14, fy, 150, 14, 'RESET TO DEFAULTS')) g.resetSettings();\n    if (pages > 1) ui.text(ui.w - 14, fy + 3, `PAGE ${this.page + 1}/${pages}`, { color: 'slate', align: 'right' });\n    ui.footer([['confirm', 'CHANGE'], ['back', 'BACK']]);\n  }\n}\n\n// ---- About ------------------------------------------------------------------------------------\nconst QUESTIONS = {\n  testing: ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'],\n  engine: ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why? (none if nothing)', 'If you could change one thing about the engine, what would it be?'],\n  prompt: ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'],\n};\nexport const ABOUT_QUESTIONS = QUESTIONS;\n\nexport function aboutLines() {\n  const si = INTERVIEW.sourceInformation;\n  const info = [['DATE', si.date], ['SOURCE', si.source], ['PLAN', si.plan], ['GENRE AND PERSPECTIVE', `${si.genre}; ${si.perspective}`], ['TECH', si.tech], ['ART DIRECTION', si.artDirection], ['ANIMATION', si.animation], ['AUDIO', si.audio], ['ONLINE', si.online], ['TESTING', si.testing], ['RESEARCH', si.research], ['ENVIRONMENT', si.environment], ['MODEL', si.model], ['USAGE', si.usage]];\n  const qa = (list, answers) => list.flatMap((q, i) => [{ q }, { a: answers[i] ?? 'unknown' }]);\n  return {\n    'SOURCE INFORMATION': info.flatMap(([k, v]) => [{ q: k }, { a: v }]),\n    'TESTING FEEDBACK': qa(QUESTIONS.testing, INTERVIEW.testingFeedback),\n    'ENGINE FEEDBACK': qa(QUESTIONS.engine, INTERVIEW.engineFeedback),\n    'PROMPT FEEDBACK': qa(QUESTIONS.prompt, INTERVIEW.promptFeedback),\n    CREDITS: [{ q: TITLE }, { a: 'Made in code: every model, clip, song, sound and voice in this game is data in its source. Built on the Pixel Engine kit. Credits for the kit follow.' }, { q: 'THE KIT' }, { a: KIT_CREDITS.replace(/[`*#_>|]/g, ' ').replace(/\\s+\\n/g, '\\n') }],\n  };\n}\n\nexport class AboutScreen extends Screen {\n  constructor(game) {\n    super(game, { tag: 'about' });\n    this.page = 0;\n    this.scroll = 0;\n    this.sections = aboutLines();\n    this.names = Object.keys(this.sections);\n    this.cacheW = 0;\n  }\n  layout(ui) {\n    if (this.cacheW === ui.w && this.laid) return;\n    this.cacheW = ui.w;\n    this.laid = {};\n    const clean = (s) => String(s).toUpperCase().replace(/[–—]/g, '-').replace(/×/g, 'X').replace(/→/g, '>').replace(/[^0-9A-Z'\"`‘’“”.,:;\\-+=/()[\\]{}%_!?<>#*@°·&|~^$ \\n]/g, ' ');\n    for (const n of this.names) {\n      const out = [];\n      for (const row of this.sections[n]) {\n        if (row.q) { out.push({ t: clean(row.q), c: 'sand' }); }\n        else { for (const l of ui.wrap(clean(row.a), ui.w - 32)) out.push({ t: l, c: 'white' }); out.push({ t: '', c: 'white' }); }\n      }\n      this.laid[n] = out;\n    }\n  }\n  /** Every line of the current section, for tests and the attentive. */\n  allText(ui) { this.layout(ui); return this.laid; }\n  draw(ui) {\n    const g = this.game;\n    const input = g.input.menu;\n    frame(ui, '');\n    this.layout(ui);\n    if (input.tabR) { this.page = (this.page + 1) % this.names.length; this.scroll = 0; }\n    if (input.tabL) { this.page = (this.page - 1 + this.names.length) % this.names.length; this.scroll = 0; }\n    const name = this.names[this.page];\n    const lines = this.laid[name];\n    ui.text(14, 12, name, { color: 'sand', scale: 2 });\n    ui.text(ui.w - 14, 14, `${this.page + 1}/${this.names.length}`, { color: 'slate', align: 'right' });\n    const rows = Math.floor((ui.h - 58) / 9);\n    const maxScroll = Math.max(0, lines.length - rows);\n    if (input.down) this.scroll = Math.min(maxScroll, this.scroll + 3);\n    if (input.up) this.scroll = Math.max(0, this.scroll - 3);\n    if (input.wheel > 0) this.scroll = Math.min(maxScroll, this.scroll + input.wheel * 4);\n    if (input.wheel < 0) this.scroll = Math.max(0, this.scroll + input.wheel * 4);\n    if (input.confirm) this.scroll = this.scroll >= maxScroll ? 0 : Math.min(maxScroll, this.scroll + rows);\n    lines.slice(this.scroll, this.scroll + rows).forEach((l, i) => { if (l.t) ui.text(16, 32 + i * 9, l.t, { color: l.c }); });\n    if (maxScroll > 0) {\n      const barH = ui.h - 58;\n      ui.rect(ui.w - 11, 32, 2, barH, 'night');\n      ui.rect(ui.w - 11, 32 + (this.scroll / (maxScroll || 1)) * (barH - 8), 2, 8, 'sand');\n    }\n    ui.footer([['tabL', 'PAGE'], ['tabR', 'PAGE'], ['confirm', 'SCROLL'], ['back', 'BACK']]);\n  }\n}\n\nexport { LOOKS };\nEOF\ncat > src/ui/menus/dev.js <<'EOF'\n// Dev mode: tools and live sliders, pad-navigable like everything else. All changes are live.\nimport { CLASSES } from '../../data/classes.js';\nimport { LEGENDARIES, RARITY_ORDER, SETS, SLOT_NAMES, SLOTS } from '../../data/items.js';\nimport { AFFLICTION_IDS, AFFLICTIONS, BOSS_IDS, MONSTERS } from '../../data/monsters.js';\nimport { QUESTS } from '../../data/quests.js';\nimport { DIFFICULTIES, TUNING, defaultTuning } from '../../data/tuning.js';\nimport { ZONES, zoneName } from '../../data/zones.js';\nimport { frame, Screen, tabs } from './base.js';\n\nconst TABS = ['CHEATS', 'GIVE', 'SPAWN', 'TRAVEL', 'WORLD', 'PARTY', 'SHOW', 'SLIDERS'];\n\nexport class DevScreen extends Screen {\n  constructor(game) {\n    super(game, { tag: 'dev' });\n    this.tab = 0;\n    this.slot = 0; this.rarity = 2; this.leg = 0; this.mon = 0; this.boss = 0; this.affs = []; this.scroll = 0; this.zone = 0; this.floor = 0; this.q = 0; this.qs = 0; this.page = 0;\n  }\n  draw(ui) {\n    frame(ui, '');\n    const before = this.tab;\n    this.tab = tabs(ui, 'dev', TABS, this.tab);\n    if (before !== this.tab) { this.page = 0; }\n    ui.text(ui.w - 14, 14, 'DEV', { color: 'red', align: 'right' });\n    this[`t${this.tab}`](ui);\n    ui.footer([['tabL', 'TAB'], ['tabR', 'TAB'], ['confirm', 'USE'], ['back', 'BACK']]);\n  }\n  grid(ui, items, o = {}) {\n    const cols = o.cols ?? 3;\n    const cw = Math.floor((ui.w - 28 - (cols - 1) * 2) / cols);\n    const y0 = o.y ?? 30;\n    items.forEach(([label, act, opt], i) => {\n      const x = 14 + (i % cols) * (cw + 2), y = y0 + Math.floor(i / cols) * 15;\n      if (ui.button(`dev:${this.tab}:${label}`, x, y, cw, 14, label.slice(0, Math.floor((cw - 6) / 6)), { color: opt?.on ? 'lime' : 'mist', ...opt })) act();\n    });\n    return y0 + Math.ceil(items.length / cols) * 15;\n  }\n  cycler(ui, id, x, y, w, label, step) {\n    const r = ui.widget(`devc:${id}`, x, y, w, 14);\n    ui.rect(x, y, w, 14, r.focused ? 'plum' : 'night');\n    ui.text(x + 4, y + 3, `< ${label.slice(0, Math.floor((w - 28) / 6))} >`, { color: 'sand' });\n    const input = this.game.input.menu;\n    if (r.focused && input.left) step(-1);\n    if (r.focused && input.right) step(1);\n    if (r.activated) step(1);\n    if (r.alt) step(-1);\n  }\n  // Cheats.\n  t0(ui) {\n    const g = this.game, c = g.world.cheats;\n    const cheat = (k, label) => [`${label}${c[k] ? ': ON' : ''}`, () => g.cmd({ c: 'dev_cheat', k, v: !c[k] }), { on: c[k] }];\n    this.grid(ui, [cheat('god', 'GOD MODE'), cheat('oneHit', 'ONE-HIT KILLS'), cheat('noCd', 'NO COOLDOWNS'), cheat('infRes', 'INFINITE RESOURCE'), cheat('noClip', 'NO COLLISION'), cheat('invisible', 'INVISIBLE')], { cols: 2 });\n  }\n  // Give.\n  t1(ui) {\n    const g = this.game, h = this.hero;\n    let y = this.grid(ui, [['LEVEL UP', () => g.cmd({ c: 'dev_level', n: 1 })], ['LEVEL TO 30', () => g.cmd({ c: 'dev_level_max' })], ['GOLD', () => g.cmd({ c: 'dev_gold', n: 10000 })], ['MATERIALS', () => g.cmd({ c: 'dev_mats' })], ['ALL GEMS', () => g.cmd({ c: 'dev_gems' })], ['REVIVE ALL', () => g.cmd({ c: 'dev_revive' })]]);\n    y += 4;\n    const third = Math.floor((ui.w - 28) / 3);\n    this.cycler(ui, 'slot', 14, y, third - 2, SLOT_NAMES[SLOTS[this.slot]], (d) => { this.slot = (this.slot + d + SLOTS.length) % SLOTS.length; });\n    this.cycler(ui, 'rar', 14 + third, y, third - 2, RARITY_ORDER[this.rarity], (d) => { this.rarity = (this.rarity + d + RARITY_ORDER.length) % RARITY_ORDER.length; });\n    if (ui.button('dev:giveitem', 14 + third * 2, y, third, 14, 'GIVE ITEM')) g.cmd({ c: 'dev_item', slot: SLOTS[this.slot], rarity: RARITY_ORDER[this.rarity] });\n    y += 16;\n    const legs = Object.keys(LEGENDARIES);\n    this.cycler(ui, 'leg', 14, y, third * 2 - 2, LEGENDARIES[legs[this.leg]].name, (d) => { this.leg = (this.leg + d + legs.length) % legs.length; });\n    if (ui.button('dev:giveleg', 14 + third * 2, y, third, 14, 'GIVE LEGENDARY')) g.cmd({ c: 'dev_legendary', id: legs[this.leg] });\n    y += 16;\n    const sets = Object.keys(SETS);\n    this.setI = this.setI ?? 0;\n    this.cycler(ui, 'set', 14, y, third * 2 - 2, SETS[sets[this.setI]].name, (d) => { this.setI = (this.setI + d + sets.length) % sets.length; });\n    if (ui.button('dev:giveset', 14 + third * 2, y, third, 14, 'GIVE ALL 4')) for (const slot of ['head', 'chest', 'hands', 'feet']) g.cmd({ c: 'dev_set', set: sets[this.setI], slot });\n    void h;\n  }\n  // Spawn.\n  t2(ui) {\n    const g = this.game;\n    const mons = Object.keys(MONSTERS).filter((k) => !BOSS_IDS.includes(k) && !['pallbearer', 'coffin_bearer', 'lamp_post', 'iron_bell', 'decoy'].includes(k));\n    const half = Math.floor((ui.w - 28) / 2);\n    let y = 30;\n    this.cycler(ui, 'mon', 14, y, half - 2, MONSTERS[mons[this.mon]].name, (d) => { this.mon = (this.mon + d + mons.length) % mons.length; });\n    if (ui.button('dev:spawn1', 14 + half, y, half / 2 - 1, 14, 'SPAWN 1')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], n: 1 });\n    if (ui.button('dev:spawn10', 14 + half + half / 2, y, half / 2, 14, 'SPAWN 40')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], n: 40 });\n    y += 16;\n    this.grid(ui, AFFLICTION_IDS.map((a) => [AFFLICTIONS[a].name, () => { const i = this.affs.indexOf(a); if (i >= 0) this.affs.splice(i, 1); else this.affs.push(a); }, { on: this.affs.includes(a) }]), { y, cols: 4 });\n    y += 32;\n    if (ui.button('dev:champ', 14, y, half - 2, 14, 'ELITE: CHAMPION PACK')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], elite: 'champion', aff: this.affs });\n    if (ui.button('dev:rare', 14 + half, y, half, 14, 'ELITE: RARE PACK')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], elite: 'rare', aff: this.affs });\n    y += 16;\n    this.cycler(ui, 'boss', 14, y, half - 2, MONSTERS[BOSS_IDS[this.boss]].name, (d) => { this.boss = (this.boss + d + BOSS_IDS.length) % BOSS_IDS.length; });\n    if (ui.button('dev:boss', 14 + half, y, half, 14, 'SPAWN BOSS')) g.cmd({ c: 'dev_boss', type: BOSS_IDS[this.boss] });\n    y += 16;\n    this.grid(ui, [['COLLECTION PLATE', () => g.cmd({ c: 'dev_plate' })], ['UNQUIET COFFIN', () => g.cmd({ c: 'dev_coffin' })], ['KILL ALL', () => g.cmd({ c: 'dev_kill_all' })]], { y });\n  }\n  // Travel.\n  t3(ui) {\n    const g = this.game;\n    const zones = ['yard', 'town', 'causeway', 'pantry', 'ossuary', 'cloister', 'belfry'];\n    const half = Math.floor((ui.w - 28) / 2);\n    let y = 30;\n    const z = ZONES[zones[this.zone]];\n    this.floor = Math.min(this.floor, z.floors - 1);\n    this.cycler(ui, 'zone', 14, y, half - 2, zoneName(zones[this.zone], this.floor), (d) => { this.zone = (this.zone + d + zones.length) % zones.length; this.floor = 0; });\n    this.cycler(ui, 'floor', 14 + half, y, half / 2 - 2, `FLOOR ${this.floor + 1}`, (d) => { this.floor = (this.floor + d + z.floors) % z.floors; });\n    if (ui.button('dev:go', 14 + half + half / 2, y, half / 2, 14, 'GO')) { g.closeAll(); g.cmd({ c: 'dev_goto', zone: zones[this.zone], floor: this.floor }); return; }\n    y += 18;\n    const q = QUESTS[this.q] ?? QUESTS[0];\n    this.qs = Math.min(this.qs, q.steps.length - 1);\n    this.cycler(ui, 'quest', 14, y, half - 2, q.name, (d) => { this.q = (this.q + d + QUESTS.length) % QUESTS.length; this.qs = 0; });\n    this.cycler(ui, 'qstep', 14 + half, y, half / 2 - 2, q.steps[this.qs].id, (d) => { this.qs = (this.qs + d + q.steps.length) % q.steps.length; });\n    if (ui.button('dev:setq', 14 + half + half / 2, y, half / 2, 14, 'SET')) g.cmd({ c: 'dev_quest', i: this.q, s: this.qs });\n    y += 18;\n    this.grid(ui, [\n      ['BURSAR ARENA', () => { g.closeAll(); g.cmd({ c: 'dev_quest', i: 2, s: 4 }); g.cmd({ c: 'dev_goto', zone: 'ossuary', floor: 2 }); }],\n      ['BISHOP ARENA', () => { g.closeAll(); g.cmd({ c: 'dev_quest', i: 3, s: 3 }); g.cmd({ c: 'dev_goto', zone: 'cloister', floor: 0 }); }],\n      ['MALISON ARENA', () => { g.closeAll(); g.cmd({ c: 'dev_quest', i: 4, s: 2 }); g.cmd({ c: 'dev_goto', zone: 'belfry', floor: 3 }); }],\n      ['START KNELL RUN', () => { g.closeAll(); g.cmd({ c: 'dev_knell_start' }); }],\n      ['FILL THE KNELL', () => g.cmd({ c: 'dev_knell_fill' })],\n    ], { y });\n  }\n  // World.\n  t4(ui) {\n    const g = this.game, w = g.world;\n    const half = Math.floor((ui.w - 28) / 2);\n    let y = 30;\n    const scales = [0.25, 0.5, 1, 2];\n    this.timeI = this.timeI ?? 2;\n    this.cycler(ui, 'time', 14, y, half - 2, `TIME SCALE ${scales[this.timeI]}`, (d) => { this.timeI = (this.timeI + d + scales.length) % scales.length; g.devTimeScale = scales[this.timeI]; });\n    this.cycler(ui, 'diff', 14 + half, y, half, DIFFICULTIES[w.difficulty].name, (d) => { const n = (w.difficulty + d + DIFFICULTIES.length) % DIFFICULTIES.length; w.account.unlocks.penance = true; g.cmd({ c: 'difficulty', index: n }); });\n    y += 18;\n    this.grid(ui, [['REROLL MAP SEED', () => { g.closeAll(); g.rerollMap(); }], ['REVEAL MAP', () => g.cmd({ c: 'dev_reveal' })], ['NEXT BOSS PHASE', () => g.cmd({ c: 'dev_next_phase' })]], { y });\n  }\n  // Party.\n  t5(ui) {\n    const g = this.game;\n    const humans = g.world.heroes.filter((h) => !h.gone && !h.companion);\n    this.grid(ui, [\n      ['ADD BOT SEAT', () => g.addBotSeat()], ['REMOVE BOT SEAT', () => g.removeBotSeat()],\n      [`BOT PLAYS THIS HERO: ${g.botSeats.has(0) ? 'ON' : 'OFF'}`, () => g.toggleBot(0), { on: g.botSeats.has(0) }],\n      ['PLAY THE ATTRACT TOUR', () => { g.closeAll(); g.startAttract(true); }],\n    ], { cols: 2 });\n    ui.text(14, 70, `SEATS ${humans.length}`, { color: 'mist' });\n    void CLASSES;\n  }\n  // Overlays.\n  t6(ui) {\n    const g = this.game;\n    const o = g.overlays;\n    const t = (k, label) => [`${label}${o[k] ? ': ON' : ''}`, () => { o[k] = !o[k]; g.overlaysOn = Object.values(o).some(Boolean); }, { on: o[k] }];\n    this.grid(ui, [t('nav', 'NAV GRID'), t('hit', 'HIT CIRCLES'), t('ai', 'AI STATE'), t('spawn', 'SPAWN MARKERS'), t('flow', 'FLOW FIELD'), t('state', 'FPS AND STATE')], { cols: 2 });\n  }\n  // Sliders.\n  t7(ui) {\n    const g = this.game, w = g.world;\n    const input = g.input.menu;\n    const per = Math.floor((ui.h - 62) / 12);\n    const pages = Math.ceil(TUNING.length / per);\n    const page = Math.min(this.page, pages - 1);\n    TUNING.slice(page * per, page * per + per).forEach((t, i) => {\n      const y = 30 + i * 12;\n      const r = ui.widget(`slider:${t.id}`, 14, y, ui.w - 28, 11);\n      ui.rect(14, y, ui.w - 28, 11, r.focused ? 'plum' : 'night');\n      ui.text(18, y + 2, t.label, { color: r.focused ? 'white' : 'mist' });\n      const bx = 152, bw = ui.w - bx - 84;\n      ui.rect(bx, y + 3, bw, 5, 'ink');\n      const f = (w.tuning[t.id] - t.min) / (t.max - t.min);\n      ui.rect(bx, y + 3, bw * f, 5, w.tuning[t.id] === t.def ? 'slate' : 'sand');\n      ui.rect(bx + bw * ((t.def - t.min) / (t.max - t.min)), y + 2, 1, 7, 'white');\n      ui.text(ui.w - 20, y + 2, `${round(w.tuning[t.id])} (${t.def})`, { color: 'sand', align: 'right' });\n      const set = (v) => g.cmd({ c: 'dev_scale', k: t.id, v: Math.max(t.min, Math.min(t.max, round(v))) });\n      if (r.focused && input.left) set(w.tuning[t.id] - t.step);\n      if (r.focused && input.right) set(w.tuning[t.id] + t.step);\n      if (r.activated && input.click) {\n        const nf = Math.max(0, Math.min(1, (input.clickX - bx) / bw));\n        set(t.min + nf * (t.max - t.min));\n      }\n    });\n    const fy = 30 + Math.min(per, TUNING.length) * 12 + 2;\n    if (ui.button('slider:reset', 14, fy, 150, 13, 'RESET TO DEFAULTS')) { const d = defaultTuning(); for (const k of Object.keys(d)) g.cmd({ c: 'dev_scale', k, v: d[k] }); }\n    if (pages > 1) {\n      if (ui.button('slider:page', 170, fy, 80, 13, `PAGE ${page + 1}/${pages}`)) this.page = (page + 1) % pages;\n    }\n  }\n}\n\nconst round = (v) => Math.round(v * 100) / 100;\nEOF\necho ok","description":"Write world screens, pause, settings, about, dev mode"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23187,"cache_read_input_tokens":650372,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23187},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"5c9714d8-864d-4bd8-8b08-5b9607bd60af","timestamp":"2026-11-06T00:29:20.927Z","request_id":"req_011Cgkj3SMBzMjd4hzVz5h6q","wire_tool_inputs":{"toolu_01QZ5KW3kPra7bpq6B595q6z":{"command":"cat > src/ui/menus/world.js <<'EOF'\n// Screens that sit over the world: the map, dialogue, death, the Knell Font, writs, cutscenes.\nimport { CLASSES } from '../../data/classes.js';\nimport { BARKS, NPC_LABELS, SPEAKERS, STORY_LINES, SYSTEM_LINES, TALKS } from '../../data/dialog.js';\nimport { LORE } from '../../data/lore.js';\nimport { KNELL_MOD_IDS, KNELL_MODS } from '../../data/quests.js';\nimport { DIFFICULTIES, RULES } from '../../data/tuning.js';\nimport { ZONES, zoneName } from '../../data/zones.js';\nimport { THREE, Timeline } from '../../../pixel-engine.js';\nimport { usableGate, zoneOpen } from '../../sim/commands.js';\nimport { rollMods } from '../../sim/knell.js';\nimport { currentQuest, currentStep, objectiveOf } from '../../sim/quests.js';\nimport { fmtNum } from '../../view/view.js';\nimport { icon } from '../icons.js';\nimport { frame, Screen } from './base.js';\nimport { BrasseScreen, OgiveScreen, PennywhistleScreen, StashScreen } from './vendors.js';\n\nexport class MapScreen extends Screen {\n  constructor(game) { super(game, { tag: 'map' }); }\n  draw(ui) {\n    const g = this.game;\n    const w = g.world;\n    const z = w.zone;\n    frame(ui, zoneName(z.id, z.floor).slice(0, 26));\n    const h = this.hero;\n    // Explored cells, whole floor.\n    const mx = 12, my = 30, mw = Math.min(ui.w - 170, 300), mh = ui.h - 58;\n    ui.rect(mx - 1, my - 1, mw + 2, mh + 2, 'slate');\n    ui.rect(mx, my, mw, mh, 'night');\n    const s = Math.max(1, Math.floor(Math.min(mw / z.w, mh / z.h)));\n    const ox = mx + Math.floor((mw - z.w * s) / 2), oy = my + Math.floor((mh - z.h * s) / 2);\n    for (let row = 0; row < z.h; row++) {\n      let run = -1, col = null;\n      for (let c = 0; c <= z.w; c++) {\n        let k = null;\n        if (c < z.w && z.seen[row * z.w + c]) {\n          const ch = z.rows[row][c];\n          k = ch === '#' || ch === 'P' ? 'mist' : ch === '~' || ch === ' ' ? null : 'slate';\n        }\n        if (k !== col) { if (col) ui.hud.rect(ox + run * s, oy + row * s, (c - run) * s, s, col); run = c; col = k; }\n      }\n    }\n    const mark = (x, zz, c, size = 3) => ui.hud.rect(Math.floor(ox + x * s - size / 2), Math.floor(oy + zz * s - size / 2), size, size, c);\n    for (const o of w.objects) {\n      if (o.hidden || !z.seen[Math.floor(o.z) * z.w + Math.floor(o.x)]) continue;\n      if (o.kind === 'lychgate') mark(o.x, o.z, 'lime');\n      else if (o.kind === 'exit') mark(o.x, o.z, 'sky');\n      else if (o.kind === 'npc') mark(o.x, o.z, 'sand');\n      else if (o.kind === 'shrine' && o.state === 0) mark(o.x, o.z, 'orange');\n    }\n    for (const a of w.heroes) if (!a.gone) mark(a.x, a.z, a === h ? 'white' : 'mist', 4);\n    const q = w.camp ? objectiveOf(w) : null;\n    if (q?.zone === z.id && (q.floor === undefined || q.floor === z.floor)) {\n      const o = q.key ? w.objects.find((b) => b.key === q.key && !b.hidden) : null;\n      const r = q.boss ? z.rooms.find((b) => b.tpl?.boss === q.boss) : null;\n      const qx = o?.x ?? r?.cx ?? q.x, qz = o?.z ?? r?.cz ?? q.z;\n      if (qx !== undefined && g.frame % 40 < 28) mark(qx, qz, 'red', 5);\n    }\n    // Travel.\n    const lx = mx + mw + 8, lw = ui.w - lx - 12;\n    const canTravel = w.camp && (z.def.safe || (h && usableGate(w, h)));\n    const quest = w.camp ? currentStep(w) : null;\n    let y = my;\n    if (quest) { ui.textBlock(lx, y, quest.text, lw, { color: 'sand', lineH: 9 }); y += ui.wrap(quest.text, lw).length * 9 + 6; }\n    if (canTravel) {\n      ui.text(lx, y, 'TRAVEL', { color: 'mist' }); y += 11;\n      const dest = [];\n      if (z.id !== 'town') dest.push({ label: 'TOLLHAVEN', cmd: { c: 'travel', zone: 'town' } });\n      for (const zid of ['causeway', 'ossuary', 'cloister', 'belfry']) {\n        if (zoneOpen(w, zid) && !(z.id === zid && z.floor === 0)) dest.push({ label: ZONES[zid].name.replace('THE ', ''), cmd: { c: 'travel', zone: zid } });\n      }\n      for (const [key, gate] of Object.entries(w.camp.gates)) {\n        if (gate.zone === 'town' || (gate.zone === z.id && gate.floor === z.floor) || gate.floor === 0) continue;\n        dest.push({ label: `${ZONES[gate.zone].name.replace('THE ', '').slice(0, 12)} ${gate.floor + 1}`, cmd: { c: 'travel', key } });\n      }\n      dest.slice(0, 9).forEach((d, i) => {\n        if (ui.button(`map:${i}`, lx, y, lw, 13, d.label.slice(0, Math.floor((lw - 8) / 6)), { left: true })) { g.cmd(d.cmd); g.closeScreen(); }\n        y += 14;\n      });\n    } else ui.textBlock(lx, y, 'STAND AT A LYCHGATE TO TRAVEL.', lw, { color: 'slate', lineH: 9 });\n    ui.footer([['back', 'CLOSE']]);\n  }\n}\n\n// ---- Dialogue ---------------------------------------------------------------------------------\nconst SERVICES = {\n  pennywhistle: [['TRADE', (g) => g.openScreen(new PennywhistleScreen(g))]],\n  brasse: [['FORGE', (g) => g.openScreen(new BrasseScreen(g))]],\n  ogive: [['RELIQUARY', (g) => g.openScreen(new OgiveScreen(g))]],\n};\n\nexport function dialogueFor(w, npc, rng) {\n  const st = w.camp ? `${npc}:${currentQuest(w)?.id}.${currentStep(w)?.id}` : '';\n  if (TALKS[st]) return TALKS[st];\n  if (npc === 'crier' && w.camp?.flags.overdue_found && !w.camp.flags.overdue_done) return TALKS['crier:overdue'];\n  const barks = BARKS[npc] ?? ['...'];\n  return [[npc, barks[Math.floor(rng.next() * barks.length)]]];\n}\n\nexport class DialogueScreen extends Screen {\n  constructor(game, npc, id) {\n    super(game, { tag: 'dialogue', freeze: false, holdSim: true });\n    this.npc = npc;\n    this.objId = id;\n    this.lines = dialogueFor(game.world, npc, game.uiRng);\n    this.i = 0;\n    this.holdT = 0;\n    this.spokenI = -1;\n  }\n  get services() {\n    const w = this.game.world;\n    if (this.npc === 'brasse' && !w.camp?.flags.forge) return [];\n    if (this.npc === 'ogive' && !w.camp?.flags.reliquary) return [];\n    if (this.npc === 'pennywhistle' && !w.camp?.flags.crier_met) return [];\n    return SERVICES[this.npc] ?? [];\n  }\n  onOpen() {\n    const o = this.game.world.objects.find((q) => q.id === this.objId);\n    if (o) this.game.view.camOverride = { x: o.x, z: o.z, zoom: 1.45 };\n  }\n  onClose() { this.game.view.camOverride = null; }\n  finish() {\n    if (this.done) return;\n    this.done = true;\n    this.game.cmd({ c: 'talk_done', npc: this.npc });\n  }\n  back() { this.finish(); this.game.closeScreen(); }\n  draw(ui) {\n    const W = ui.w, H = ui.h;\n    const barH = 22;\n    ui.rect(0, 0, W, barH, 'ink');\n    ui.rect(0, H - 62, W, 62, 'ink');\n    ui.rect(0, H - 63, W, 1, 'slate');\n    const input = this.game.input.menu;\n    const line = this.lines[this.i];\n    if (line) {\n      const [who, text] = line;\n      if (this.spokenI !== this.i) { this.spokenI = this.i; this.game.audioSys?.speak(who, text); }\n      const sp = SPEAKERS[who] ?? { name: '', color: 'mist' };\n      if (sp.name) ui.text(20, H - 58, sp.name, { color: sp.color });\n      ui.textBlock(20, H - 47, text, W - 40, { color: 'white', lineH: 9 });\n      if (input.skipHeld) this.holdT += 1 / 60; else this.holdT = 0;\n      if (this.holdT > 0.5) { this.i = this.lines.length; }\n      if (input.confirm || input.click || input.back) {\n        this.i++;\n        this.game.audioSys?.sfx('ui_move');\n      }\n      ui.prompt('confirm', 'NEXT', W - 70, H - 14);\n      return;\n    }\n    // Lines done: choices, or leave.\n    const opts = this.services;\n    this.finish();\n    if (!opts.length) { this.game.closeScreen(); return; }\n    ui.text(20, H - 58, NPC_LABELS[this.npc], { color: SPEAKERS[this.npc]?.color ?? 'sand' });\n    let x = 20;\n    const y = H - 44;\n    for (const [label, act] of opts) {\n      if (ui.button(`talk:${label}`, x, y, 80, 18, label)) { this.game.closeScreen(); act(this.game); return; }\n      x += 84;\n    }\n    if (ui.button('talk:leave', x, y, 80, 18, 'LEAVE')) this.game.closeScreen();\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n  }\n}\n\nexport class LoreScreen extends Screen {\n  constructor(game, id) {\n    super(game, { tag: 'lore', freeze: false, holdSim: true });\n    this.id = id;\n    this.page = 0;\n  }\n  draw(ui) {\n    const l = LORE[this.id];\n    const W = ui.w, H = ui.h;\n    ui.panel(30, 26, W - 60, H - 60, { border: 'sand' });\n    ui.text(W / 2, 34, l.title, { color: 'sand', align: 'center', scale: 2 });\n    const text = l.pages[this.page];\n    if (this.spoken !== this.page) { this.spoken = this.page; this.game.audioSys?.speak('narrator', text); }\n    ui.textBlock(42, 58, text, W - 84, { color: 'white' });\n    ui.text(W / 2, H - 46, `${this.page + 1}/${l.pages.length}`, { color: 'slate', align: 'center' });\n    const input = this.game.input.menu;\n    if (input.confirm || input.click) {\n      if (this.page + 1 < l.pages.length) this.page++;\n      else this.game.closeScreen();\n    }\n    ui.footer([['confirm', 'TURN THE PAGE'], ['back', 'CLOSE']]);\n  }\n}\n\n// ---- Death ------------------------------------------------------------------------------------\nexport class DeathScreen extends Screen {\n  constructor(game, seat) { super(game, { tag: 'death', freeze: false }); this.seat = seat; }\n  draw(ui) {\n    const g = this.game;\n    const h = g.world.heroes.find((o) => o.seat === this.seat);\n    if (!h || !h.dead) { g.closeScreen(); return; }\n    const W = ui.w, H = ui.h;\n    ui.rect(0, H / 2 - 56, W, 112, 'ink');\n    ui.text(W / 2, H / 2 - 48, SYSTEM_LINES.death, { color: 'red', align: 'center' });\n    const wait = Math.max(0, (h.deathWait ?? 5) - h.deadT);\n    const bw = 170, x = W / 2 - bw / 2;\n    if (ui.button('rise:here', x, H / 2 - 30, bw, 18, wait > 0 ? `RISE HERE ${Math.ceil(wait)}` : 'RISE HERE', { disabled: wait > 0 })) g.cmd({ c: 'rise', how: 'here' });\n    if (!g.isSession) {\n      const hasGate = g.world.camp?.lastGate;\n      if (ui.button('rise:gate', x, H / 2 - 10, bw, 18, 'THE LAST LYCHGATE', { disabled: !hasGate })) g.cmd({ c: 'rise', how: 'gate' });\n      if (ui.button('rise:town', x, H / 2 + 10, bw, 18, 'TOLLHAVEN')) g.cmd({ c: 'rise', how: 'town' });\n    }\n    if (g.humanCount() > 1) ui.text(W / 2, H / 2 + 34, 'AN ALLY MAY HOLD INTERACT OVER YOU', { color: 'mist', align: 'center' });\n  }\n  back() {}\n}\n\n// ---- Knell Font ------------------------------------------------------------------------------\nexport class KnellScreen extends Screen {\n  constructor(game) {\n    super(game, { tag: 'knell' });\n    this.tab = 0;\n    this.tier = 1;\n    const w = game.world;\n    this.mods = rollMods(game.uiRng, game.uiRng.next() < 0.5 ? 1 : 2);\n  }\n  draw(ui) {\n    const g = this.game;\n    const w = g.world;\n    const h = this.hero;\n    frame(ui, 'THE KNELL FONT');\n    const unlocked = w.account.unlocks.knell;\n    // Difficulty.\n    let y = 32;\n    ui.text(14, y, 'THE PARISH RECOMMENDS AGAINST IT', { color: 'mist' });\n    y += 12;\n    const diffs = DIFFICULTIES.filter((d) => !d.penance || w.account.unlocks.penance);\n    const cw = Math.floor((ui.w - 28 - (diffs.length - 1) * 2) / Math.max(4, Math.min(8, diffs.length)));\n    diffs.forEach((d, i) => {\n      const x = 14 + (i % 4) * (cw + 2);\n      const label = d.name.replace('PENANCE ', 'P.');\n      const on = w.difficulty === DIFFICULTIES.indexOf(d);\n      if (ui.button(`diff:${i}`, x, y + Math.floor(i / 8) * 15, cw, 14, label, { color: on ? 'sand' : 'mist', focusColor: on ? 'white' : 'sand' })) g.cmd({ c: 'difficulty', index: DIFFICULTIES.indexOf(d) });\n    });\n    y += 22;\n    const cur = w.diffDef;\n    ui.text(14, y, `MONSTER LIFE X${cur.hp}   DAMAGE X${cur.dmg}   REWARD X${cur.reward}`, { color: 'white' });\n    y += 14;\n    if (!unlocked) {\n      ui.textBlock(14, y, 'THE FONT IS STILL. RING THE GREAT BELL FIRST, AND THE KNELL WILL ANSWER.', ui.w - 28, { color: 'slate' });\n      ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n      return;\n    }\n    // Modifiers as big cards.\n    const mw = Math.floor((ui.w - 28 - 6) / 2);\n    this.mods.forEach((m, i) => {\n      const def = KNELL_MODS[m];\n      const x = 14 + i * (mw + 6);\n      ui.panel(x, y, mw, 34, { border: 'plum' });\n      const ic = icon(def.icon);\n      ui.sprite(x + 4, y + 11, ic.rows, ic.colors);\n      ui.text(x + 20, y + 6, def.name, { color: 'sand' });\n      ui.text(x + 20, y + 18, def.desc.slice(0, Math.floor((mw - 26) / 6)), { color: 'white' });\n    });\n    y += 40;\n    if (ui.button('knell:go', 14, y, mw, 22, 'BEGIN A KNELL RUN', { color: 'white' })) {\n      g.closeScreen();\n      g.cmd({ c: 'knell_start', mods: this.mods });\n      return;\n    }\n    const keys = h.grandKeys ?? 0;\n    if (ui.button('knell:grand', 14 + mw + 6, y, mw - 40, 22, `GRAND KNELL (${keys} KEYS)`, { disabled: keys <= 0 })) {\n      g.closeScreen();\n      g.cmd({ c: 'knell_start', mods: this.mods, grand: true, tier: this.tier });\n      return;\n    }\n    if (ui.button('knell:tier', ui.w - 14 - 38, y, 38, 22, `T${this.tier}`, { color: 'sand' })) this.tier = this.tier >= 20 ? 1 : this.tier + 1;\n    y += 28;\n    const best = w.account.bests[h.cls];\n    ui.text(14, y, best ? `YOUR BEST AS ${CLASSES[h.cls].name}: TIER ${best.tier} IN ${Math.floor(best.time / 60)}:${String(best.time % 60).padStart(2, '0')}` : `NO GRAND KNELL YET AS ${CLASSES[h.cls].name}`, { color: 'mist' });\n    y += 10;\n    if (best !== undefined || keys) ui.text(14, y, `TIER ${this.tier}: LIFE X${(1.17 ** this.tier).toFixed(1)} DAMAGE X${(1.08 ** this.tier).toFixed(1)}. TEN MINUTES.`, { color: 'slate' });\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n  }\n}\n\nexport class ResultsScreen extends Screen {\n  constructor(game, r) { super(game, { tag: 'results', freeze: false }); this.r = r; }\n  draw(ui) {\n    const r = this.r;\n    const W = ui.w, H = ui.h;\n    ui.panel(W / 2 - 150, 36, 300, H - 90, { border: 'sand' });\n    ui.text(W / 2, 44, r.grand ? (r.beat ? 'THE GRAND KNELL, ANSWERED' : 'THE GRAND KNELL, TOO LATE') : 'THE KNELL IS SILENCED', { color: 'sand', align: 'center' });\n    const t = Math.round(r.time);\n    ui.text(W / 2, 60, `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`, { color: 'white', scale: 3, align: 'center' });\n    let y = 92;\n    if (r.grand) { ui.text(W / 2, y, `TIER ${r.tier}${r.best ? '  A NEW BEST' : ''}`, { color: r.best ? 'lime' : 'white', scale: 2, align: 'center' }); y += 22; }\n    ui.text(W / 2, y, `+${fmtNum(r.xp)} XP   +${r.shards} BELL SHARDS`, { color: 'white', align: 'center' });\n    y += 12;\n    if (r.keys) ui.text(W / 2, y, 'A GRAND KEY FELL', { color: 'orange', align: 'center' });\n    if (ui.button('results:ok', W / 2 - 50, H - 78, 100, 18, 'VERY WELL')) this.game.closeScreen();\n  }\n}\n\nexport class WritsScreen extends Screen {\n  constructor(game) { super(game, { tag: 'writs' }); }\n  draw(ui) {\n    const g = this.game;\n    const w = g.world;\n    frame(ui, 'THE WRIT BOARD');\n    const camp = w.camp;\n    if (!camp.writs.length || camp.writCache) {\n      ui.textBlock(14, 36, camp.writCache ? 'ALL THREE PAID. THE VESTRY HAS MORE, IF YOU HAVE THE STOMACH.' : 'THREE JOBS, ON MAPS YOU KNOW. FINISH ALL THREE FOR A CACHE.', ui.w - 28, { color: 'white' });\n      if (ui.button('writs:new', 14, 70, 170, 20, 'TAKE NEW WRITS')) { g.cmd({ c: 'writs' }); }\n    } else {\n      camp.writs.forEach((wr, i) => {\n        const y = 36 + i * 30;\n        ui.panel(14, y, ui.w - 28, 26, { border: wr.done ? 'lime' : 'slate' });\n        ui.text(20, y + 4, wr.text.slice(0, Math.floor((ui.w - 40) / 6)), { color: wr.done ? 'lime' : 'white' });\n        ui.text(20, y + 14, wr.done ? 'DONE' : wr.k === 'kill' ? `${wr.have}/${wr.n}` : 'NOT YET', { color: 'mist' });\n      });\n      ui.text(14, 130, `WRITS DONE ${camp.writsDone}  CACHES ${camp.writCaches}`, { color: 'sand' });\n    }\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'LEAVE']]);\n  }\n}\n\n// ---- Cutscenes --------------------------------------------------------------------------------\n/** Lines over the world or over black, on a Timeline. Hold to skip. */\nexport class Cutscene extends Screen {\n  constructor(game, o) {\n    super(game, { tag: 'cutscene', freeze: false, holdSim: true });\n    this.o = o;\n    let at = 0.6;\n    const lines = [];\n    for (const [who, text] of o.lines) {\n      const dur = Math.max(2.8, text.length * 0.075);\n      lines.push({ at, until: at + dur, text, who });\n      at += dur + 0.5;\n    }\n    this.tl = new Timeline({ lines, duration: at + (o.extra ?? 0.5), bars: 0.5, cues: o.cues ?? [], onEnd: () => { this.ended = true; } });\n    this.tl.play();\n    this.holdT = 0;\n    this.curLine = null;\n  }\n  onOpen() {\n    if (this.o.music) this.game.audioSys?.music(this.o.music);\n    if (this.o.toll) this.game.audioSys?.sfx(this.o.toll);\n    if (this.o.cam) this.game.view.camOverride = this.o.cam;\n  }\n  onClose() {\n    this.game.view.camOverride = null;\n    this.o.onEnd?.(this.game);\n  }\n  back() {}\n  draw(ui, dt) {\n    const g = this.game;\n    this.tl.update(g.lastRealDt);\n    const W = ui.w, H = ui.h;\n    if (this.o.black) ui.rect(0, 0, W, H, 'ink');\n    const bars = Math.round(this.tl.bars() * 24);\n    if (bars > 0 && !this.o.black) { ui.rect(0, 0, W, bars, 'ink'); ui.rect(0, H - bars, W, bars, 'ink'); }\n    const l = this.tl.line();\n    if (l && l !== this.curLine) { this.curLine = l; g.audioSys?.speak(l.who, l.text); }\n    if (l) {\n      const sp = SPEAKERS[l.who] ?? { name: '', color: 'mist' };\n      const lines = ui.wrap(l.text, W - 80);\n      let y = this.o.black ? H / 2 - lines.length * 6 : H - 22 - lines.length * 9;\n      if (sp.name) { ui.text(W / 2, y - 10, sp.name, { color: sp.color, align: 'center' }); }\n      for (const t of lines) { ui.text(W / 2, y, t, { color: 'white', align: 'center' }); y += 10; }\n    }\n    if (this.o.title) ui.text(W / 2, 40, this.o.title, { color: 'sand', align: 'center', scale: 2 });\n    const input = g.input.menu;\n    if (input.skipHeld) { this.holdT += g.lastRealDt; } else this.holdT = 0;\n    if (this.holdT > 0.6 || g.skipCutscenes) this.tl.skip();\n    ui.prompt('confirm', this.holdT > 0 ? 'HOLDING' : 'HOLD TO SKIP', W - 100, H - 14);\n    if (this.ended) g.closeScreen();\n  }\n}\n\nexport const STORY = {\n  opening: (o = {}) => ({ lines: STORY_LINES.opening, black: true, toll: 'bell_cracked', music: 'vespers', ...o }),\n  bursar_intro: { lines: STORY_LINES.bursar_intro },\n  ambrose_intro: { lines: STORY_LINES.ambrose_intro },\n  malison_intro: { lines: STORY_LINES.malison_intro },\n  cellarer_intro: { lines: STORY_LINES.cellarer_intro },\n};\n\nexport { THREE, RULES, StashScreen };\nEOF\ncat > src/ui/menus/pause.js <<'EOF'\n// Pause, Party, Settings and About.\nimport { CLASSES, PLAYABLE } from '../../data/classes.js';\nimport { TITLE } from '../../data/meta.js';\nimport { HOW_TO_PLAY } from '../../data/lore.js';\nimport { LOOK_PRESETS } from '../../../pixel-engine.js';\nimport { INTERVIEW, KIT_CREDITS } from '../../data/about.generated.js';\nimport { SEAT_COLORS } from '../../view/actors.js';\nimport { DevScreen } from './dev.js';\nimport { frame, Screen } from './base.js';\nimport { HeroScreen } from './hero.js';\nimport { MapScreen } from './world.js';\n\nexport class PauseScreen extends Screen {\n  constructor(game) { super(game, { tag: 'pause', freeze: !game.isSession }); }\n  draw(ui) {\n    const g = this.game;\n    const W = ui.w, H = ui.h;\n    const items = g.isSession\n      ? [['RESUME', () => g.closeScreen()], ['SETTINGS', () => g.openScreen(new SettingsScreen(g))], ['HOW TO PLAY', () => g.openScreen(new HowToScreen(g))]]\n      : [\n        ['RESUME', () => g.closeScreen()],\n        ['HERO', () => g.openScreen(new HeroScreen(g, 0))],\n        ['MAP', () => g.openScreen(new MapScreen(g))],\n        ['PARTY', () => g.openScreen(new PartyScreen(g))],\n        ['HOW TO PLAY', () => g.openScreen(new HowToScreen(g))],\n        ['SETTINGS', () => g.openScreen(new SettingsScreen(g))],\n        ['DEV MODE', () => g.openScreen(new DevScreen(g))],\n        ['ABOUT', () => g.openScreen(new AboutScreen(g))],\n        ['SAVE AND QUIT', () => g.saveAndQuit()],\n      ];\n    const bw = 150, bh = 16, gap = 2;\n    const total = items.length * (bh + gap);\n    const x = Math.floor(W / 2 - bw / 2), y0 = Math.floor(H / 2 - total / 2) + 6;\n    ui.panel(x - 8, y0 - 22, bw + 16, total + 28, { border: 'plum' });\n    ui.text(W / 2, y0 - 16, 'A PAUSE IN THE TOLLING', { color: 'sand', align: 'center' });\n    items.forEach(([label, act], i) => {\n      if (ui.button(`pause:${label}`, x, y0 + i * (bh + gap), bw, bh, label)) act();\n    });\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'RESUME']]);\n  }\n}\n\nexport class HowToScreen extends Screen {\n  constructor(game) { super(game, { tag: 'howto' }); this.page = 0; }\n  draw(ui) {\n    frame(ui, '');\n    const p = HOW_TO_PLAY[this.page];\n    ui.text(14, 14, p.title, { color: 'sand', scale: 2 });\n    let y = 36;\n    for (const line of p.lines) y += ui.textBlock(14, y, line, ui.w - 28, { color: 'white' }) + 3;\n    ui.text(ui.w - 14, ui.h - 26, `${this.page + 1}/${HOW_TO_PLAY.length}`, { color: 'slate', align: 'right' });\n    const input = this.game.input.menu;\n    if (input.confirm || input.tabR || input.right || input.down || input.wheel > 0 || input.click) this.page = (this.page + 1) % HOW_TO_PLAY.length;\n    if (input.tabL || input.left || input.up || input.wheel < 0) this.page = (this.page - 1 + HOW_TO_PLAY.length) % HOW_TO_PLAY.length;\n    ui.footer([['confirm', 'NEXT'], ['back', 'BACK']]);\n  }\n}\n\nexport class PartyScreen extends Screen {\n  constructor(game) { super(game, { tag: 'party' }); }\n  draw(ui) {\n    const g = this.game;\n    frame(ui, 'THE PARTY');\n    const w = g.world;\n    const humans = w.heroes.filter((h) => !h.gone && !h.companion);\n    humans.forEach((h, i) => {\n      const y = 36 + i * 24;\n      ui.panel(14, y, ui.w - 28, 22, { border: SEAT_COLORS[h.seat] });\n      ui.text(20, y + 3, `P${h.seat + 1}  ${h.name}  LV ${h.level} ${CLASSES[h.cls].name}`, { color: SEAT_COLORS[h.seat] });\n      const dev = g.input.seats[h.seat];\n      ui.text(20, y + 12, dev?.pad !== null && dev?.pad !== undefined ? `PAD ${dev.pad + 1}` : 'KEYBOARD AND MOUSE', { color: 'mist' });\n      if (h.seat > 0 && ui.button(`party:leave${h.seat}`, ui.w - 84, y + 3, 64, 16, 'LEAVE')) g.leaveSeat(h.seat);\n    });\n    const free = g.freePads();\n    let y = 36 + humans.length * 24 + 6;\n    if (humans.length < 4) {\n      if (free.length) {\n        ui.text(14, y, 'A FREE CONTROLLER MAY JOIN AS:', { color: 'white' });\n        y += 12;\n        PLAYABLE.forEach((cls, i) => {\n          if (ui.button(`party:join${cls}`, 14 + i * 110, y, 106, 18, CLASSES[cls].name)) g.joinSeat(free[0], cls);\n        });\n        y += 24;\n      } else {\n        ui.textBlock(14, y, 'CONNECT ANOTHER CONTROLLER AND PRESS OPTIONS TO JOIN. IT WORKS AT ANY TIME.', ui.w - 28, { color: 'mist' });\n        y += 24;\n      }\n    }\n    if (g.input.menu.pause && humans.length > 1) g.leaveLastSeat();\n    ui.footer([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\n\nconst LOOKS = [['NATIVE', null], ['SPOOKY', 'spooky'], ['16-BIT', 'sixteen_bit'], ['PS1 HORROR', 'ps1_horror'], ['OLD PHOTO', 'old_photo'], ['NOIR', 'noir']];\n\nexport class SettingsScreen extends Screen {\n  constructor(game) { super(game, { tag: 'settings' }); this.page = 0; }\n  rows() {\n    const g = this.game;\n    const a = g.ctx.audio;\n    const s = g.settings;\n    const pct = (v) => `${Math.round(v * 100)}%`;\n    const vol = (ch) => ({ get: () => pct(a.volume[ch]), step: (d) => a.setVolume(ch, Math.max(0, Math.min(1, Math.round((a.volume[ch] + d * 0.05) * 100) / 100))) });\n    const es = g.ctx.engine.settings;\n    return [\n      ['MASTER VOLUME', vol('master')],\n      ['MUSIC VOLUME', vol('music')],\n      ['SOUND VOLUME', vol('sfx')],\n      ['VOICES VOLUME', { get: () => pct(s.voices), step: (d) => { s.voices = Math.max(0, Math.min(1, Math.round((s.voices + d * 0.05) * 100) / 100)); g.audioSys.voicesVol = s.voices; } }],\n      ['BUTTON GLYPHS', { get: () => (s.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'), step: () => { s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'; } }],\n      ['SCREEN SHAKE', { get: () => pct(s.shake), step: (d) => { s.shake = Math.max(0, Math.min(2, Math.round((s.shake + d * 0.25) * 100) / 100)); } }],\n      ['DAMAGE NUMBERS', { get: () => (s.numbers ? 'ON' : 'OFF'), step: () => { s.numbers = !s.numbers; } }],\n      ['ZOOM', { get: () => pct(s.zoom), step: (d) => { s.zoom = Math.max(0.6, Math.min(1.4, Math.round((s.zoom + d * 0.1) * 100) / 100)); } }],\n      ['LOOK', { get: () => LOOKS[s.lookIndex ?? 0][0], step: (d) => { s.lookIndex = ((s.lookIndex ?? 0) + d + LOOKS.length) % LOOKS.length; g.applyLook(); } }],\n      ['PIXEL SIZE', { get: () => ((es.values.pixelSize ?? 'fine') === 'fine' ? 'FINE' : 'CHUNKY'), step: () => es.set({ pixelSize: (es.values.pixelSize ?? 'fine') === 'fine' ? 'chunky' : 'fine' }) }],\n      ['QUALITY', { get: () => (es.values.quality ?? 'high').toUpperCase(), step: (d) => { const q = ['low', 'medium', 'high']; const i = q.indexOf(es.values.quality ?? 'high'); es.set({ quality: q[(i + d + 3) % 3] }); } }],\n      ['FULLSCREEN', { get: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF'), step: () => g.toggleFullscreen() }],\n    ];\n  }\n  back() { this.game.saveSettings(); this.game.closeScreen(); }\n  draw(ui) {\n    const g = this.game;\n    frame(ui, 'SETTINGS');\n    const input = g.input.menu;\n    const rows = this.rows();\n    const perPage = Math.floor((ui.h - 62) / 15);\n    const pages = Math.ceil(rows.length / perPage);\n    if (input.tabR) this.page = (this.page + 1) % pages;\n    if (input.tabL) this.page = (this.page - 1 + pages) % pages;\n    this.page = Math.min(this.page, pages - 1);\n    rows.slice(this.page * perPage, this.page * perPage + perPage).forEach(([label, r], i) => {\n      const y = 32 + i * 15;\n      const w = ui.widget(`set:${label}`, 14, y, ui.w - 28, 14);\n      ui.rect(14, y, ui.w - 28, 14, w.focused ? 'plum' : 'night');\n      ui.text(20, y + 3, label, { color: w.focused ? 'white' : 'mist' });\n      ui.text(ui.w - 20, y + 3, `< ${r.get()} >`, { color: 'sand', align: 'right' });\n      if (w.focused) {\n        if (input.left) { r.step(-1); g.audioSys?.sfx('ui_tab'); }\n        if (input.right) { r.step(1); g.audioSys?.sfx('ui_tab'); }\n      }\n      if (w.activated) { r.step(1); g.audioSys?.sfx('ui_tab'); }\n      if (w.alt) { r.step(-1); g.audioSys?.sfx('ui_tab'); }\n    });\n    const fy = 32 + Math.min(perPage, rows.length) * 15 + 2;\n    if (ui.button('set:reset', 14, fy, 150, 14, 'RESET TO DEFAULTS')) g.resetSettings();\n    if (pages > 1) ui.text(ui.w - 14, fy + 3, `PAGE ${this.page + 1}/${pages}`, { color: 'slate', align: 'right' });\n    ui.footer([['confirm', 'CHANGE'], ['back', 'BACK']]);\n  }\n}\n\n// ---- About ------------------------------------------------------------------------------------\nconst QUESTIONS = {\n  testing: ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'],\n  engine: ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why? (none if nothing)', 'If you could change one thing about the engine, what would it be?'],\n  prompt: ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'],\n};\nexport const ABOUT_QUESTIONS = QUESTIONS;\n\nexport function aboutLines() {\n  const si = INTERVIEW.sourceInformation;\n  const info = [['DATE', si.date], ['SOURCE', si.source], ['PLAN', si.plan], ['GENRE AND PERSPECTIVE', `${si.genre}; ${si.perspective}`], ['TECH', si.tech], ['ART DIRECTION', si.artDirection], ['ANIMATION', si.animation], ['AUDIO', si.audio], ['ONLINE', si.online], ['TESTING', si.testing], ['RESEARCH', si.research], ['ENVIRONMENT', si.environment], ['MODEL', si.model], ['USAGE', si.usage]];\n  const qa = (list, answers) => list.flatMap((q, i) => [{ q }, { a: answers[i] ?? 'unknown' }]);\n  return {\n    'SOURCE INFORMATION': info.flatMap(([k, v]) => [{ q: k }, { a: v }]),\n    'TESTING FEEDBACK': qa(QUESTIONS.testing, INTERVIEW.testingFeedback),\n    'ENGINE FEEDBACK': qa(QUESTIONS.engine, INTERVIEW.engineFeedback),\n    'PROMPT FEEDBACK': qa(QUESTIONS.prompt, INTERVIEW.promptFeedback),\n    CREDITS: [{ q: TITLE }, { a: 'Made in code: every model, clip, song, sound and voice in this game is data in its source. Built on the Pixel Engine kit. Credits for the kit follow.' }, { q: 'THE KIT' }, { a: KIT_CREDITS.replace(/[`*#_>|]/g, ' ').replace(/\\s+\\n/g, '\\n') }],\n  };\n}\n\nexport class AboutScreen extends Screen {\n  constructor(game) {\n    super(game, { tag: 'about' });\n    this.page = 0;\n    this.scroll = 0;\n    this.sections = aboutLines();\n    this.names = Object.keys(this.sections);\n    this.cacheW = 0;\n  }\n  layout(ui) {\n    if (this.cacheW === ui.w && this.laid) return;\n    this.cacheW = ui.w;\n    this.laid = {};\n    const clean = (s) => String(s).toUpperCase().replace(/[\\u2013\\u2014]/g, '-').replace(/\\u00d7/g, 'X').replace(/\\u2192/g, '>').replace(/[^0-9A-Z'\"`\\u2018\\u2019\\u201c\\u201d.,:;\\-+=/()[\\]{}%_!?<>#*@°·&|~^$ \\n]/g, ' ');\n    for (const n of this.names) {\n      const out = [];\n      for (const row of this.sections[n]) {\n        if (row.q) { out.push({ t: clean(row.q), c: 'sand' }); }\n        else { for (const l of ui.wrap(clean(row.a), ui.w - 32)) out.push({ t: l, c: 'white' }); out.push({ t: '', c: 'white' }); }\n      }\n      this.laid[n] = out;\n    }\n  }\n  /** Every line of the current section, for tests and the attentive. */\n  allText(ui) { this.layout(ui); return this.laid; }\n  draw(ui) {\n    const g = this.game;\n    const input = g.input.menu;\n    frame(ui, '');\n    this.layout(ui);\n    if (input.tabR) { this.page = (this.page + 1) % this.names.length; this.scroll = 0; }\n    if (input.tabL) { this.page = (this.page - 1 + this.names.length) % this.names.length; this.scroll = 0; }\n    const name = this.names[this.page];\n    const lines = this.laid[name];\n    ui.text(14, 12, name, { color: 'sand', scale: 2 });\n    ui.text(ui.w - 14, 14, `${this.page + 1}/${this.names.length}`, { color: 'slate', align: 'right' });\n    const rows = Math.floor((ui.h - 58) / 9);\n    const maxScroll = Math.max(0, lines.length - rows);\n    if (input.down) this.scroll = Math.min(maxScroll, this.scroll + 3);\n    if (input.up) this.scroll = Math.max(0, this.scroll - 3);\n    if (input.wheel > 0) this.scroll = Math.min(maxScroll, this.scroll + input.wheel * 4);\n    if (input.wheel < 0) this.scroll = Math.max(0, this.scroll + input.wheel * 4);\n    if (input.confirm) this.scroll = this.scroll >= maxScroll ? 0 : Math.min(maxScroll, this.scroll + rows);\n    lines.slice(this.scroll, this.scroll + rows).forEach((l, i) => { if (l.t) ui.text(16, 32 + i * 9, l.t, { color: l.c }); });\n    if (maxScroll > 0) {\n      const barH = ui.h - 58;\n      ui.rect(ui.w - 11, 32, 2, barH, 'night');\n      ui.rect(ui.w - 11, 32 + (this.scroll / (maxScroll || 1)) * (barH - 8), 2, 8, 'sand');\n    }\n    ui.footer([['tabL', 'PAGE'], ['tabR', 'PAGE'], ['confirm', 'SCROLL'], ['back', 'BACK']]);\n  }\n}\n\nexport { LOOKS };\nEOF\ncat > src/ui/menus/dev.js <<'EOF'\n// Dev mode: tools and live sliders, pad-navigable like everything else. All changes are live.\nimport { CLASSES } from '../../data/classes.js';\nimport { LEGENDARIES, RARITY_ORDER, SETS, SLOT_NAMES, SLOTS } from '../../data/items.js';\nimport { AFFLICTION_IDS, AFFLICTIONS, BOSS_IDS, MONSTERS } from '../../data/monsters.js';\nimport { QUESTS } from '../../data/quests.js';\nimport { DIFFICULTIES, TUNING, defaultTuning } from '../../data/tuning.js';\nimport { ZONES, zoneName } from '../../data/zones.js';\nimport { frame, Screen, tabs } from './base.js';\n\nconst TABS = ['CHEATS', 'GIVE', 'SPAWN', 'TRAVEL', 'WORLD', 'PARTY', 'SHOW', 'SLIDERS'];\n\nexport class DevScreen extends Screen {\n  constructor(game) {\n    super(game, { tag: 'dev' });\n    this.tab = 0;\n    this.slot = 0; this.rarity = 2; this.leg = 0; this.mon = 0; this.boss = 0; this.affs = []; this.scroll = 0; this.zone = 0; this.floor = 0; this.q = 0; this.qs = 0; this.page = 0;\n  }\n  draw(ui) {\n    frame(ui, '');\n    const before = this.tab;\n    this.tab = tabs(ui, 'dev', TABS, this.tab);\n    if (before !== this.tab) { this.page = 0; }\n    ui.text(ui.w - 14, 14, 'DEV', { color: 'red', align: 'right' });\n    this[`t${this.tab}`](ui);\n    ui.footer([['tabL', 'TAB'], ['tabR', 'TAB'], ['confirm', 'USE'], ['back', 'BACK']]);\n  }\n  grid(ui, items, o = {}) {\n    const cols = o.cols ?? 3;\n    const cw = Math.floor((ui.w - 28 - (cols - 1) * 2) / cols);\n    const y0 = o.y ?? 30;\n    items.forEach(([label, act, opt], i) => {\n      const x = 14 + (i % cols) * (cw + 2), y = y0 + Math.floor(i / cols) * 15;\n      if (ui.button(`dev:${this.tab}:${label}`, x, y, cw, 14, label.slice(0, Math.floor((cw - 6) / 6)), { color: opt?.on ? 'lime' : 'mist', ...opt })) act();\n    });\n    return y0 + Math.ceil(items.length / cols) * 15;\n  }\n  cycler(ui, id, x, y, w, label, step) {\n    const r = ui.widget(`devc:${id}`, x, y, w, 14);\n    ui.rect(x, y, w, 14, r.focused ? 'plum' : 'night');\n    ui.text(x + 4, y + 3, `< ${label.slice(0, Math.floor((w - 28) / 6))} >`, { color: 'sand' });\n    const input = this.game.input.menu;\n    if (r.focused && input.left) step(-1);\n    if (r.focused && input.right) step(1);\n    if (r.activated) step(1);\n    if (r.alt) step(-1);\n  }\n  // Cheats.\n  t0(ui) {\n    const g = this.game, c = g.world.cheats;\n    const cheat = (k, label) => [`${label}${c[k] ? ': ON' : ''}`, () => g.cmd({ c: 'dev_cheat', k, v: !c[k] }), { on: c[k] }];\n    this.grid(ui, [cheat('god', 'GOD MODE'), cheat('oneHit', 'ONE-HIT KILLS'), cheat('noCd', 'NO COOLDOWNS'), cheat('infRes', 'INFINITE RESOURCE'), cheat('noClip', 'NO COLLISION'), cheat('invisible', 'INVISIBLE')], { cols: 2 });\n  }\n  // Give.\n  t1(ui) {\n    const g = this.game, h = this.hero;\n    let y = this.grid(ui, [['LEVEL UP', () => g.cmd({ c: 'dev_level', n: 1 })], ['LEVEL TO 30', () => g.cmd({ c: 'dev_level_max' })], ['GOLD', () => g.cmd({ c: 'dev_gold', n: 10000 })], ['MATERIALS', () => g.cmd({ c: 'dev_mats' })], ['ALL GEMS', () => g.cmd({ c: 'dev_gems' })], ['REVIVE ALL', () => g.cmd({ c: 'dev_revive' })]]);\n    y += 4;\n    const third = Math.floor((ui.w - 28) / 3);\n    this.cycler(ui, 'slot', 14, y, third - 2, SLOT_NAMES[SLOTS[this.slot]], (d) => { this.slot = (this.slot + d + SLOTS.length) % SLOTS.length; });\n    this.cycler(ui, 'rar', 14 + third, y, third - 2, RARITY_ORDER[this.rarity], (d) => { this.rarity = (this.rarity + d + RARITY_ORDER.length) % RARITY_ORDER.length; });\n    if (ui.button('dev:giveitem', 14 + third * 2, y, third, 14, 'GIVE ITEM')) g.cmd({ c: 'dev_item', slot: SLOTS[this.slot], rarity: RARITY_ORDER[this.rarity] });\n    y += 16;\n    const legs = Object.keys(LEGENDARIES);\n    this.cycler(ui, 'leg', 14, y, third * 2 - 2, LEGENDARIES[legs[this.leg]].name, (d) => { this.leg = (this.leg + d + legs.length) % legs.length; });\n    if (ui.button('dev:giveleg', 14 + third * 2, y, third, 14, 'GIVE LEGENDARY')) g.cmd({ c: 'dev_legendary', id: legs[this.leg] });\n    y += 16;\n    const sets = Object.keys(SETS);\n    this.setI = this.setI ?? 0;\n    this.cycler(ui, 'set', 14, y, third * 2 - 2, SETS[sets[this.setI]].name, (d) => { this.setI = (this.setI + d + sets.length) % sets.length; });\n    if (ui.button('dev:giveset', 14 + third * 2, y, third, 14, 'GIVE ALL 4')) for (const slot of ['head', 'chest', 'hands', 'feet']) g.cmd({ c: 'dev_set', set: sets[this.setI], slot });\n    void h;\n  }\n  // Spawn.\n  t2(ui) {\n    const g = this.game;\n    const mons = Object.keys(MONSTERS).filter((k) => !BOSS_IDS.includes(k) && !['pallbearer', 'coffin_bearer', 'lamp_post', 'iron_bell', 'decoy'].includes(k));\n    const half = Math.floor((ui.w - 28) / 2);\n    let y = 30;\n    this.cycler(ui, 'mon', 14, y, half - 2, MONSTERS[mons[this.mon]].name, (d) => { this.mon = (this.mon + d + mons.length) % mons.length; });\n    if (ui.button('dev:spawn1', 14 + half, y, half / 2 - 1, 14, 'SPAWN 1')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], n: 1 });\n    if (ui.button('dev:spawn10', 14 + half + half / 2, y, half / 2, 14, 'SPAWN 40')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], n: 40 });\n    y += 16;\n    this.grid(ui, AFFLICTION_IDS.map((a) => [AFFLICTIONS[a].name, () => { const i = this.affs.indexOf(a); if (i >= 0) this.affs.splice(i, 1); else this.affs.push(a); }, { on: this.affs.includes(a) }]), { y, cols: 4 });\n    y += 32;\n    if (ui.button('dev:champ', 14, y, half - 2, 14, 'ELITE: CHAMPION PACK')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], elite: 'champion', aff: this.affs });\n    if (ui.button('dev:rare', 14 + half, y, half, 14, 'ELITE: RARE PACK')) g.cmd({ c: 'dev_spawn', type: mons[this.mon], elite: 'rare', aff: this.affs });\n    y += 16;\n    this.cycler(ui, 'boss', 14, y, half - 2, MONSTERS[BOSS_IDS[this.boss]].name, (d) => { this.boss = (this.boss + d + BOSS_IDS.length) % BOSS_IDS.length; });\n    if (ui.button('dev:boss', 14 + half, y, half, 14, 'SPAWN BOSS')) g.cmd({ c: 'dev_boss', type: BOSS_IDS[this.boss] });\n    y += 16;\n    this.grid(ui, [['COLLECTION PLATE', () => g.cmd({ c: 'dev_plate' })], ['UNQUIET COFFIN', () => g.cmd({ c: 'dev_coffin' })], ['KILL ALL', () => g.cmd({ c: 'dev_kill_all' })]], { y });\n  }\n  // Travel.\n  t3(ui) {\n    const g = this.game;\n    const zones = ['yard', 'town', 'causeway', 'pantry', 'ossuary', 'cloister', 'belfry'];\n    const half = Math.floor((ui.w - 28) / 2);\n    let y = 30;\n    const z = ZONES[zones[this.zone]];\n    this.floor = Math.min(this.floor, z.floors - 1);\n    this.cycler(ui, 'zone', 14, y, half - 2, zoneName(zones[this.zone], this.floor), (d) => { this.zone = (this.zone + d + zones.length) % zones.length; this.floor = 0; });\n    this.cycler(ui, 'floor', 14 + half, y, half / 2 - 2, `FLOOR ${this.floor + 1}`, (d) => { this.floor = (this.floor + d + z.floors) % z.floors; });\n    if (ui.button('dev:go', 14 + half + half / 2, y, half / 2, 14, 'GO')) { g.closeAll(); g.cmd({ c: 'dev_goto', zone: zones[this.zone], floor: this.floor }); return; }\n    y += 18;\n    const q = QUESTS[this.q] ?? QUESTS[0];\n    this.qs = Math.min(this.qs, q.steps.length - 1);\n    this.cycler(ui, 'quest', 14, y, half - 2, q.name, (d) => { this.q = (this.q + d + QUESTS.length) % QUESTS.length; this.qs = 0; });\n    this.cycler(ui, 'qstep', 14 + half, y, half / 2 - 2, q.steps[this.qs].id, (d) => { this.qs = (this.qs + d + q.steps.length) % q.steps.length; });\n    if (ui.button('dev:setq', 14 + half + half / 2, y, half / 2, 14, 'SET')) g.cmd({ c: 'dev_quest', i: this.q, s: this.qs });\n    y += 18;\n    this.grid(ui, [\n      ['BURSAR ARENA', () => { g.closeAll(); g.cmd({ c: 'dev_quest', i: 2, s: 4 }); g.cmd({ c: 'dev_goto', zone: 'ossuary', floor: 2 }); }],\n      ['BISHOP ARENA', () => { g.closeAll(); g.cmd({ c: 'dev_quest', i: 3, s: 3 }); g.cmd({ c: 'dev_goto', zone: 'cloister', floor: 0 }); }],\n      ['MALISON ARENA', () => { g.closeAll(); g.cmd({ c: 'dev_quest', i: 4, s: 2 }); g.cmd({ c: 'dev_goto', zone: 'belfry', floor: 3 }); }],\n      ['START KNELL RUN', () => { g.closeAll(); g.cmd({ c: 'dev_knell_start' }); }],\n      ['FILL THE KNELL', () => g.cmd({ c: 'dev_knell_fill' })],\n    ], { y });\n  }\n  // World.\n  t4(ui) {\n    const g = this.game, w = g.world;\n    const half = Math.floor((ui.w - 28) / 2);\n    let y = 30;\n    const scales = [0.25, 0.5, 1, 2];\n    this.timeI = this.timeI ?? 2;\n    this.cycler(ui, 'time', 14, y, half - 2, `TIME SCALE ${scales[this.timeI]}`, (d) => { this.timeI = (this.timeI + d + scales.length) % scales.length; g.devTimeScale = scales[this.timeI]; });\n    this.cycler(ui, 'diff', 14 + half, y, half, DIFFICULTIES[w.difficulty].name, (d) => { const n = (w.difficulty + d + DIFFICULTIES.length) % DIFFICULTIES.length; w.account.unlocks.penance = true; g.cmd({ c: 'difficulty', index: n }); });\n    y += 18;\n    this.grid(ui, [['REROLL MAP SEED', () => { g.closeAll(); g.rerollMap(); }], ['REVEAL MAP', () => g.cmd({ c: 'dev_reveal' })], ['NEXT BOSS PHASE', () => g.cmd({ c: 'dev_next_phase' })]], { y });\n  }\n  // Party.\n  t5(ui) {\n    const g = this.game;\n    const humans = g.world.heroes.filter((h) => !h.gone && !h.companion);\n    this.grid(ui, [\n      ['ADD BOT SEAT', () => g.addBotSeat()], ['REMOVE BOT SEAT', () => g.removeBotSeat()],\n      [`BOT PLAYS THIS HERO: ${g.botSeats.has(0) ? 'ON' : 'OFF'}`, () => g.toggleBot(0), { on: g.botSeats.has(0) }],\n      ['PLAY THE ATTRACT TOUR', () => { g.closeAll(); g.startAttract(true); }],\n    ], { cols: 2 });\n    ui.text(14, 70, `SEATS ${humans.length}`, { color: 'mist' });\n    void CLASSES;\n  }\n  // Overlays.\n  t6(ui) {\n    const g = this.game;\n    const o = g.overlays;\n    const t = (k, label) => [`${label}${o[k] ? ': ON' : ''}`, () => { o[k] = !o[k]; g.overlaysOn = Object.values(o).some(Boolean); }, { on: o[k] }];\n    this.grid(ui, [t('nav', 'NAV GRID'), t('hit', 'HIT CIRCLES'), t('ai', 'AI STATE'), t('spawn', 'SPAWN MARKERS'), t('flow', 'FLOW FIELD'), t('state', 'FPS AND STATE')], { cols: 2 });\n  }\n  // Sliders.\n  t7(ui) {\n    const g = this.game, w = g.world;\n    const input = g.input.menu;\n    const per = Math.floor((ui.h - 62) / 12);\n    const pages = Math.ceil(TUNING.length / per);\n    const page = Math.min(this.page, pages - 1);\n    TUNING.slice(page * per, page * per + per).forEach((t, i) => {\n      const y = 30 + i * 12;\n      const r = ui.widget(`slider:${t.id}`, 14, y, ui.w - 28, 11);\n      ui.rect(14, y, ui.w - 28, 11, r.focused ? 'plum' : 'night');\n      ui.text(18, y + 2, t.label, { color: r.focused ? 'white' : 'mist' });\n      const bx = 152, bw = ui.w - bx - 84;\n      ui.rect(bx, y + 3, bw, 5, 'ink');\n      const f = (w.tuning[t.id] - t.min) / (t.max - t.min);\n      ui.rect(bx, y + 3, bw * f, 5, w.tuning[t.id] === t.def ? 'slate' : 'sand');\n      ui.rect(bx + bw * ((t.def - t.min) / (t.max - t.min)), y + 2, 1, 7, 'white');\n      ui.text(ui.w - 20, y + 2, `${round(w.tuning[t.id])} (${t.def})`, { color: 'sand', align: 'right' });\n      const set = (v) => g.cmd({ c: 'dev_scale', k: t.id, v: Math.max(t.min, Math.min(t.max, round(v))) });\n      if (r.focused && input.left) set(w.tuning[t.id] - t.step);\n      if (r.focused && input.right) set(w.tuning[t.id] + t.step);\n      if (r.activated && input.click) {\n        const nf = Math.max(0, Math.min(1, (input.clickX - bx) / bw));\n        set(t.min + nf * (t.max - t.min));\n      }\n    });\n    const fy = 30 + Math.min(per, TUNING.length) * 12 + 2;\n    if (ui.button('slider:reset', 14, fy, 150, 13, 'RESET TO DEFAULTS')) { const d = defaultTuning(); for (const k of Object.keys(d)) g.cmd({ c: 'dev_scale', k, v: d[k] }); }\n    if (pages > 1) {\n      if (ui.button('slider:page', 170, fy, 80, 13, `PAGE ${page + 1}/${pages}`)) this.page = (page + 1) % pages;\n    }\n  }\n}\n\nconst round = (v) => Math.round(v * 100) / 100;\nEOF\necho ok","description":"Write world screens, pause, settings, about, dev mode"}}}
