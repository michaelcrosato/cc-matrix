{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgPEVmDEoSB22bTp2Fs","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13682,"cache_read_input_tokens":368240,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13682},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"db636fb4-2991-4ac6-bf15-f68dddcc711f","timestamp":"2026-11-05T23:52:27.102Z","request_id":"req_011CgkgPEFtAY5dmeYHmT59V","thinking_duration_ms":32365,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgPEVmDEoSB22bTp2Fs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0134JXbVbiHjRo5tf3cQjKnF","name":"Bash","input":{"command":"sed -i \"s/Oh, for pity is sake\\./Oh, for pity's sake./\" src/data/dialog.js\nsed -i \"s/'Oh, for pity's sake.'/\\\"Oh, for pity's sake.\\\"/\" src/data/dialog.js\ncat > src/sim/bosses.js <<'EOF'\n// Scripted bosses. Every big attack telegraphs and can be rolled through.\nimport { STORY_LINES } from '../data/dialog.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { DT, dist, ev, say, setCellOpen, slide, toast, walkable } from './core.js';\nimport { hurtHero } from './hero.js';\nimport { dropGold, dropItem, goldAt, makeRolledItem, spawnDrop } from './loot.js';\nimport { facingOf, monsterSpeed, nearestHero, openSpot, spawnMonster, killMonster } from './monsters.js';\nimport { spawnEnemyArea, spawnWave, telegraphLine, telegraphRing } from './hazards.js';\nimport { addObject, setObjectState } from './objects.js';\nimport { onBossKilled } from './quests.js';\n\nexport function startBoss(w, type, x, z, o = {}) {\n  const def = MONSTERS[type];\n  const m = spawnMonster(w, type, x, z, { state: 'chase', knellPts: 0, ...o });\n  m.bossState = { phase: 1, t: 0, audit: 4, sweep: 8, adds: 12, lash: 2.5, wave: 5, taunt: 8, swing: 0, round: 1, ...(o.state0 ?? {}) };\n  w.boss = m;\n  ev(w, { t: 'boss', id: m.id, name: def.title, song: def.song ?? '', phases: PHASES[def.boss] ?? [], k: type, intro: o.noIntro ? 0 : 1 });\n  bossScripts[def.boss]?.init?.(w, m, m.bossState);\n  return m;\n}\n\nexport const PHASES = { malison: [0.6, 0.25], bursar: [0.3], ambrose: [], warden_sexton: [0.5], warden_chorister: [0.5], warden_jaw: [0.5], cellarer: [] };\n\nfunction chase(w, m, t, mul = 1, stopAt = 0.5) {\n  const dx = t.x - m.x, dz = t.z - m.z, l = Math.hypot(dx, dz) || 1;\n  m.facing = facingOf(dx, dz);\n  if (l <= m.r + stopAt) return false;\n  const speed = monsterSpeed(m) * mul * DT;\n  let ux = dx / l, uz = dz / l;\n  if (!w.zone.nav.lineOfSight(m.x, m.z, t.x, t.z)) {\n    const out = [0, 0];\n    if (w.zone.navs[t.navIndex ?? 0]?.flowDirection(m.x, m.z, out)) { ux = out[0]; uz = out[1]; }\n  }\n  slide(w, m, ux * speed, uz * speed, Math.min(m.r, 0.8));\n  m.moving = true;\n  return true;\n}\n\nfunction taunt(w, m, b, lines, who, every = 22) {\n  b.taunt -= DT;\n  if (b.taunt <= 0) { b.taunt = every; say(w, who, w.rng.pick(lines)); }\n}\n\nfunction melee(w, m, b, t, r = 3, windup = 0.7, mul = 1) {\n  b.swing -= DT;\n  if (b.swing <= 0 && dist(m.x, m.z, t.x, t.z) < m.r + r) {\n    b.swing = windup + 1.2;\n    ev(w, { t: 'mcast', id: m.id, clip: m.def.clipAttack ?? 'Slam', sp: 0.6 / windup });\n    const fx = Math.sin(m.facing), fz = Math.cos(m.facing);\n    telegraphRing(w, m.x + fx * m.r, m.z + fz * m.r, r, windup, m.dmg * mul, { src: m, vfx: 'dust_ring', sfx: 'stone_hit', shake: 0.3 });\n    return true;\n  }\n  return false;\n}\n\nconst bossScripts = {\n  // THE BURSAR -----------------------------------------------------------------------------\n  bursar: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      taunt(w, m, b, STORY_LINES.bursar_lines, 'bursar');\n      if (b.wait > 0) { b.wait -= DT; return; }\n      chase(w, m, t, 1, 1.5);\n      melee(w, m, b, t, 3.2, 0.8, 1.1);\n      b.audit -= DT;\n      if (b.audit <= 0) {\n        b.audit = 9;\n        ev(w, { t: 'mcast', id: m.id, clip: 'CastBig', sp: 0.7 });\n        say(w, 'bursar', 'AUDIT!');\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          telegraphRing(w, h.x, h.z, 2.5, 2, m.dmg * 1.6, { src: m, vfx: 'ledger_slam', sfx: 'coffin_slam', shake: 0.4, knock: 1 });\n        }\n      }\n      b.sweep -= DT;\n      if (b.sweep <= 0) {\n        b.sweep = 14;\n        const l = Math.hypot(t.x - m.x, t.z - m.z) || 1;\n        const dx = (t.x - m.x) / l, dz = (t.z - m.z) / l;\n        ev(w, { t: 'mcast', id: m.id, clip: 'Slash3', sp: 0.7 });\n        telegraphLine(w, m.x, m.z, dx, dz, 10, 5, 1, m.dmg * 0.9, {\n          src: m, vfx: 'sweep', sfx: 'coins', shake: 0.3,\n          onHit: (h) => {\n            const take = Math.floor(h.gold * 0.1);\n            if (take <= 0) return;\n            h.gold -= take;\n            const piles = Math.min(12, take);\n            for (let i = 0; i < piles; i++) {\n              const p = openSpot(w, h.x, h.z, 4);\n              spawnDrop(w, { kind: 'coin', amount: Math.max(1, Math.round(take / piles)), x: p.x, z: p.z, owner: h.seat });\n            }\n            say(w, 'bursar', 'COLLECTIONS!');\n          },\n        });\n      }\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 18;\n        say(w, 'bursar', 'A SMALL ADJUSTMENT!');\n        ev(w, { t: 'mcast', id: m.id, clip: 'RaiseHands', sp: 0.8 });\n        for (let i = 0; i < 4; i++) { const p = openSpot(w, m.x, m.z, 5); spawnMonster(w, 'rattlebones', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true, name: 'CLERK' }); }\n      }\n      if (!b.foreclosed && m.hp < m.maxHp * 0.3) {\n        b.foreclosed = true;\n        b.closing = 0;\n        b.ring = 0;\n        b.closed = [];\n        say(w, 'bursar', 'FORECLOSURE!');\n        ev(w, { t: 'mcast', id: m.id, clip: 'Shout', sp: 0.7 });\n      }\n      if (b.foreclosed) {\n        b.closing -= DT;\n        if (b.closing <= 0 && b.ring < 5) { b.closing = 4; closeRing(w, m, b); }\n      }\n    },\n    died(w, m, b) { reopenAll(w, b); },\n  },\n\n  // BISHOP AMBROSE -------------------------------------------------------------------------\n  ambrose: {\n    step(w, m, b) {\n      if (b.buried > 0) {\n        b.buried -= DT;\n        if (b.buried <= 0) {\n          const t = nearestHero(w, m);\n          let px = m.x, pz = m.z;\n          for (let i = 0; i < 16 && t; i++) { const p = openSpot(w, b.cx, b.cz, 8); if (dist(p.x, p.z, t.x, t.z) > 4) { px = p.x; pz = p.z; break; } }\n          m.x = px; m.z = pz;\n          m.hidden = false; m.invuln = false;\n          ev(w, { t: 'unhide', id: m.id, x: px, z: pz });\n          ev(w, { t: 'fx', k: 'grave_burst', s: 'coffin_slam', sh: 0.5, wv: 1, x: px, z: pz, r: 3 });\n          ev(w, { t: 'mcast', id: m.id, clip: 'GetUp', sp: 1 });\n          say(w, 'ambrose', b.round === 2 ? 'ONE LEARNS TO KEEP A SPADE IN THE COFFIN.' : 'TWICE MORE. I HAVE PRACTISED.');\n        }\n        return;\n      }\n      const t = nearestHero(w, m);\n      if (!t) return;\n      taunt(w, m, b, STORY_LINES.ambrose_lines, 'ambrose', 18);\n      chase(w, m, t, 1, 3);\n      melee(w, m, b, t, 2.4, 0.6, 0.9);\n      b.lash -= DT;\n      if (b.lash <= 0) {\n        b.lash = 4 - b.round * 0.5;\n        ev(w, { t: 'mcast', id: m.id, clip: 'CastWeapon', sp: 1 });\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          const l = Math.hypot(h.x - m.x, h.z - m.z) || 1;\n          telegraphLine(w, m.x, m.z, (h.x - m.x) / l, (h.z - m.z) / l, Math.min(14, l + 3), 1.1, 0.8, m.dmg * 0.8, { src: m, vfx: 'chain_line', sfx: 'chain', root: 1 });\n        }\n      }\n      b.wave -= DT;\n      if (b.wave <= 0) {\n        b.wave = 7;\n        ev(w, { t: 'mcast', id: m.id, clip: 'CastBig', sp: 1 });\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          telegraphRing(w, h.x, h.z, 2.4, 1, m.dmg * 0.5, { src: m, vfx: 'poison_burst', sfx: 'burst_wet', pool: { kind: 'poison_pool', r: 2.4, life: 5, tick: 0.5, dps: m.dmg * 0.25 } });\n        }\n      }\n      if (b.round >= 2) {\n        b.adds -= DT;\n        if (b.adds <= 0) {\n          b.adds = 13;\n          say(w, 'ambrose', 'COME, PENITENTS. COME AND BE FORGIVEN.');\n          for (let i = 0; i < 2 + w.heroes.length; i++) { const p = openSpot(w, m.x, m.z, 6); spawnMonster(w, 'penitent', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true }); }\n        }\n      }\n      if (b.round >= 3) {\n        b.ring = (b.ring ?? 3) - DT;\n        if (b.ring <= 0) {\n          b.ring = 6;\n          ev(w, { t: 'mcast', id: m.id, clip: 'Shout', sp: 1 });\n          spawnWave(w, m.x, m.z, { speed: 6, maxR: 16, thick: 0.8, dmg: m.dmg * 1.1, el: 'flame', gapA: w.rng.range(-3.14, 3.14), gapW: 0.9 });\n        }\n      }\n    },\n    damaged(w, m, b) {\n      if (m.hp > 0 || b.round >= 3) return;\n      b.round++;\n      m.hp = m.maxHp;\n      m.dmg *= 1.25;\n      m.invuln = true;\n      m.hidden = true;\n      m.status = {};\n      b.buried = 2.2;\n      b.cx = m.x; b.cz = m.z;\n      ev(w, { t: 'hide', id: m.id, x: m.x, z: m.z, coffin: 1 });\n      ev(w, { t: 'obj_fall', k: 'coffin', x: m.x, z: m.z });\n      ev(w, { t: 'fx', k: 'dust_ring', s: 'coffin_slam', sh: 0.6, wv: 1, x: m.x, z: m.z, r: 3 });\n      ev(w, { t: 'boss_round', id: m.id, round: b.round });\n    },\n  },\n\n  // MALISON --------------------------------------------------------------------------------\n  malison: {\n    init(w, m, b) {\n      b.cx = m.x; b.cz = m.z;\n      b.pillars = (w.zone.pillars ?? []).map((p) => ({ x: p.x, z: p.z, hp: 2, col: Math.floor(p.x), row: Math.floor(p.z) }));\n      b.toll = 15; b.crumble = 6; b.lash = 3; b.wave = 6; b.adds = 16; b.pits = [];\n    },\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      const pct = m.hp / m.maxHp;\n      if (b.phase === 1 && pct <= 0.6) enterPhase2(w, m, b);\n      if (b.phase === 2 && pct <= 0.25) enterPhase3(w, m, b);\n      b.ropeSway = (b.ropeSway ?? 0) + DT;\n      m.facing = facingOf(t.x - m.x, t.z - m.z);\n      if (b.stagger > 0) { b.stagger -= DT; return; }\n      taunt(w, m, b, STORY_LINES.malison_lines, 'malison', 24);\n      if (b.phase < 3) {\n        // Hold the middle, near enough, and work.\n        chase(w, m, { x: b.cx, z: b.cz, navIndex: 0 }, 0.5, 1);\n        b.lash -= DT;\n        if (b.lash <= 0) {\n          b.lash = b.phase === 1 ? 3.2 : 2.6;\n          ev(w, { t: 'mcast', id: m.id, clip: 'lash', sp: 1 });\n          for (const h of w.heroes) {\n            if (h.dead || h.gone) continue;\n            const base = Math.atan2(h.z - m.z, h.x - m.x);\n            for (const off of [-0.45, 0, 0.45]) {\n              const a = base + off;\n              telegraphLine(w, m.x, m.z, Math.cos(a), Math.sin(a), 18, 1.3, 1, m.dmg * 0.9, { src: m, vfx: 'rope_lash', sfx: 'whip', shake: 0.15, knock: 1.5 });\n            }\n          }\n        }\n        b.wave -= DT;\n        if (b.wave <= 0) {\n          b.wave = b.phase === 1 ? 7 : 9;\n          ev(w, { t: 'mcast', id: m.id, clip: 'scream', sp: 1 });\n          ev(w, { t: 'sfx', k: 'bell_cracked', x: m.x, z: m.z });\n          spawnWave(w, m.x, m.z, { speed: 6.5, maxR: 20, thick: 0.8, dmg: m.dmg * 1.2, el: 'sound', gapA: w.rng.range(-3.14, 3.14), gapW: 1.1 });\n        }\n        b.adds -= DT;\n        if (b.adds <= 0) {\n          b.adds = 16;\n          for (let i = 0; i < 3; i++) { const p = openSpot(w, m.x, m.z, 10); spawnMonster(w, 'rattlebones', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true }); }\n          const q = openSpot(w, m.x, m.z, 10);\n          spawnMonster(w, 'penitent', q.x, q.z, { state: 'chase', from: 'ground', noXp: true, summoned: true });\n        }\n      }\n      if (b.phase === 2) {\n        b.crumble -= DT;\n        if (b.crumble <= 0) {\n          b.crumble = 6;\n          crumbleCell(w, m, b, t);\n        }\n        b.toll -= DT;\n        if (b.toll <= 2.5 && !b.tollWarned) {\n          b.tollWarned = true;\n          ev(w, { t: 'toll_warn', d: 2.5 });\n          toast(w, 'THE BELL TOLLS. GET BEHIND A PILLAR', 'red', { big: 1 });\n        }\n        if (b.toll <= 0) {\n          b.toll = 15;\n          b.tollWarned = false;\n          bellToll(w, m, b);\n        }\n      }\n      if (b.phase === 3) {\n        chase(w, m, t, 1.1, 0.6);\n        // Her touch is terrible.\n        b.touch = (b.touch ?? 0) - DT;\n        if (b.touch <= 0) {\n          for (const h of w.heroes) {\n            if (h.dead || h.gone) continue;\n            if (dist(m.x, m.z, h.x, h.z) < m.r + 1.2) {\n              b.touch = 1.2;\n              hurtHero(w, h, m.dmg * 2.2, { src: m, knockFrom: m, knock: 3 });\n              ev(w, { t: 'fx', k: 'dust_ring', s: 'stone_hit', sh: 0.4, x: h.x, z: h.z, r: 2 });\n              break;\n            }\n          }\n        }\n        b.lash -= DT;\n        if (b.lash <= 0) {\n          b.lash = 4;\n          for (const h of w.heroes) {\n            if (h.dead || h.gone) continue;\n            const l = Math.hypot(h.x - m.x, h.z - m.z) || 1;\n            telegraphLine(w, m.x, m.z, (h.x - m.x) / l, (h.z - m.z) / l, 16, 1.4, 1, m.dmg * 0.8, { src: m, vfx: 'rope_lash', sfx: 'whip', shake: 0.15 });\n          }\n        }\n      }\n    },\n    damaged(w, m, b) {\n      // In the last phase only the bell can finish her.\n      if (b.phase === 3 && (b.rings ?? 0) < 3 && m.hp < m.maxHp * 0.02) m.hp = m.maxHp * 0.02;\n    },\n    died(w, m, b) { reopenAll(w, b); },\n  },\n\n  // THE CELLARER ---------------------------------------------------------------------------\n  cellarer: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      chase(w, m, t, 1, 1);\n      melee(w, m, b, t, 2.6, 0.7, 1);\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 12;\n        say(w, 'cellarer', 'THE HERRING HAS TURNED!');\n        for (let i = 0; i < 4; i++) { const p = openSpot(w, m.x, m.z, 5); spawnMonster(w, 'peatwalker', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true }); }\n      }\n      b.audit -= DT;\n      if (b.audit <= 0) {\n        b.audit = 7;\n        ev(w, { t: 'mcast', id: m.id, clip: 'Slam', sp: 0.8 });\n        telegraphRing(w, t.x, t.z, 2.4, 1, m.dmg, { src: m, vfx: 'poison_burst', sfx: 'burst_wet', pool: { kind: 'poison_pool', r: 2.4, life: 5, tick: 0.5, dps: m.dmg * 0.25 } });\n      }\n    },\n    died(w, m) {\n      addObject(w, 'book', m.x + 1, m.z, { lore: null, key: 'overdue_book', label: 'THE OVERDUE BOOK', announce: true });\n    },\n  },\n\n  // KNELL WARDENS ---------------------------------------------------------------------------\n  warden_sexton: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      if (b.phase === 1 && m.hp < m.maxHp * 0.5) { b.phase = 2; say2(w, m, 'THE PLOT THICKENS.'); }\n      chase(w, m, t, 1, 1);\n      melee(w, m, b, t, 2.8, 0.7, 1.1);\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 10;\n        ev(w, { t: 'mcast', id: m.id, clip: 'RaiseHands', sp: 1 });\n        ev(w, { t: 'sfx', k: 'raise', x: m.x, z: m.z });\n        for (let i = 0; i < 5; i++) { const p = openSpot(w, m.x, m.z, 7); spawnMonster(w, 'rattlebones', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true, knellPts: 0 }); }\n      }\n      if (b.phase === 2) {\n        b.audit -= DT;\n        if (b.audit <= 0) {\n          b.audit = 5;\n          for (let i = 0; i < 5; i++) { const p = openSpot(w, t.x, t.z, 6); telegraphRing(w, p.x, p.z, 1.8, 1, m.dmg, { src: m, vfx: 'dust_ring', sfx: 'coffin_slam', shake: 0.15 }); ev(w, { t: 'obj_fall', k: 'coffin', x: p.x, z: p.z, delay: 0.7 }); }\n        }\n      }\n    },\n  },\n  warden_chorister: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      if (b.phase === 1 && m.hp < m.maxHp * 0.5) { b.phase = 2; say2(w, m, 'AND AGAIN, FROM THE TOP.'); }\n      chase(w, m, t, 0.9, 5);\n      b.wave -= DT;\n      if (b.wave <= 0) {\n        b.wave = b.phase === 2 ? 3.5 : 5;\n        ev(w, { t: 'sfx', k: 'sour_note', x: m.x, z: m.z });\n        spawnWave(w, m.x, m.z, { speed: 6, maxR: 16, thick: 0.8, dmg: m.dmg, el: 'sound', gapA: w.rng.range(-3.14, 3.14), gapW: 1.1 });\n      }\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 11;\n        for (let i = 0; i < 4; i++) { const p = openSpot(w, m.x, m.z, 6); spawnMonster(w, 'choir_skull', p.x, p.z, { state: 'chase', noXp: true, summoned: true, knellPts: 0 }); }\n      }\n      b.lash -= DT;\n      if (b.lash <= 0) {\n        b.lash = 3;\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          telegraphRing(w, h.x, h.z, 2, 1, m.dmg * 0.8, { src: m, vfx: 'ring_bronze', sfx: 'bell_small' });\n        }\n      }\n    },\n  },\n  warden_jaw: {\n    init(w, m, b) { b.charge = 3; b.state = 'walk'; },\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      if (b.phase === 1 && m.hp < m.maxHp * 0.5) { b.phase = 2; ev(w, { t: 'sfx', k: 'roar', x: m.x, z: m.z }); }\n      if (b.state === 'roar') {\n        b.t -= DT;\n        if (b.t <= 0) { b.state = 'charge'; b.left = 14; }\n        return;\n      }\n      if (b.state === 'charge') {\n        const step = (b.phase === 2 ? 13 : 10) * DT;\n        const x0 = m.x, z0 = m.z;\n        slide(w, m, b.dx * step, b.dz * step, 0.8);\n        b.left -= step;\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          if (dist(h.x, h.z, m.x, m.z) < m.r + 0.5 && (h.jawT ?? 0) <= w.time) { h.jawT = w.time + 1; hurtHero(w, h, m.dmg * 1.4, { src: m, knockFrom: m, knock: 3 }); }\n        }\n        if (Math.hypot(m.x - x0, m.z - z0) < step * 0.5) {\n          ev(w, { t: 'fx', k: 'dust_ring', s: 'stone_hit', sh: 0.5, wv: 1, x: m.x, z: m.z, r: 3 });\n          m.status.stun = 2.5; b.state = 'walk';\n        } else if (b.left <= 0) b.state = 'walk';\n        return;\n      }\n      chase(w, m, t, 1, 1);\n      melee(w, m, b, t, 2.8, 0.7, 1);\n      b.charge -= DT;\n      if (b.charge <= 0 && dist(m.x, m.z, t.x, t.z) > 4) {\n        b.charge = b.phase === 2 ? 4 : 6;\n        b.state = 'roar'; b.t = 1;\n        const l = Math.hypot(t.x - m.x, t.z - m.z) || 1;\n        b.dx = (t.x - m.x) / l; b.dz = (t.z - m.z) / l;\n        m.facing = facingOf(b.dx, b.dz);\n        ev(w, { t: 'sfx', k: 'roar', x: m.x, z: m.z });\n        ev(w, { t: 'mcast', id: m.id, clip: 'roar', sp: 1 });\n        telegraphLine(w, m.x, m.z, b.dx, b.dz, 14, 3, 1, 0, { silent: true });\n      }\n      b.audit -= DT;\n      if (b.audit <= 0 && b.phase === 2) {\n        b.audit = 8;\n        telegraphRing(w, t.x, t.z, 2.2, 0.8, m.dmg * 0.4, { src: m, vfx: 'bone_rise', sfx: 'bone_hit', entomb: 3 });\n      }\n    },\n  },\n};\n\nconst say2 = (w, m, text) => ev(w, { t: 'sub', who: 'warden', name: m.def.name, text });\n\nfunction closeRing(w, m, b) {\n  // The room's walls of coffins, one ring tighter each time. Never closer than 5 m from the middle.\n  const room = w.zone.rooms.find((r) => r.tpl?.boss === 'bursar');\n  if (!room) return;\n  const k = b.ring + 1;\n  const cells = [];\n  const x0 = room.x + k, x1 = room.x + room.w - 1 - k, y0 = room.y + k, y1 = room.y + room.h - 1 - k;\n  if (x1 - x0 < 10 || y1 - y0 < 8) { b.ring = 99; return; }\n  for (let x = x0; x <= x1; x++) { cells.push([x, y0], [x, y1]); }\n  for (let y = y0; y <= y1; y++) { cells.push([x0, y], [x1, y]); }\n  const closed = [];\n  for (const [cx, cz] of cells) {\n    if (!w.zone.nav.isOpen(cx, cz)) continue;\n    setCellOpen(w, cx, cz, false);\n    closed.push([cx, cz]);\n  }\n  b.closed.push(...closed);\n  b.ring++;\n  ev(w, { t: 'obst', id: w.nextId++, k: 'coffin_wall', x: m.x, z: m.z, cells: closed, life: 999 });\n  ev(w, { t: 'sfx', k: 'coffin_slam', x: m.x, z: m.z });\n  // Anyone caught in the closing wall steps inward.\n  const cx = room.x + room.w / 2, cz = room.y + room.h / 2;\n  for (const h of w.heroes) {\n    if (walkable(w, h.x, h.z)) continue;\n    const l = Math.hypot(cx - h.x, cz - h.z) || 1;\n    for (let d = 1; d < 8; d += 0.5) {\n      const px = h.x + ((cx - h.x) / l) * d, pz = h.z + ((cz - h.z) / l) * d;\n      if (walkable(w, px, pz)) { h.x = px; h.z = pz; break; }\n    }\n  }\n  for (const o of w.monsters) if (!walkable(w, o.x, o.z)) { o.x = cx; o.z = cz; }\n}\n\nfunction reopenAll(w, b) {\n  for (const [cx, cz] of b.closed ?? []) setCellOpen(w, cx, cz, true);\n  for (const [cx, cz] of b.pits ?? []) setCellOpen(w, cx, cz, true);\n  if (b.closed?.length || b.pits?.length) ev(w, { t: 'obst_clear' });\n  b.closed = []; b.pits = [];\n}\n\nfunction enterPhase2(w, m, b) {\n  b.phase = 2;\n  b.toll = 8; b.crumble = 3;\n  ev(w, { t: 'boss_phase', id: m.id, phase: 2 });\n  say(w, 'malison', 'THE CRACKED HOUR. COUNT WITH ME.');\n  ev(w, { t: 'fx', k: 'dust_ring', s: 'bell_cracked', sh: 0.6, wv: 1, x: m.x, z: m.z, r: 6 });\n}\n\nfunction enterPhase3(w, m, b) {\n  b.phase = 3;\n  b.rings = 0;\n  ev(w, { t: 'boss_phase', id: m.id, phase: 3 });\n  say(w, 'malison', 'EVENTIDE. THE LAST TOLL IS MINE. ALL OF IT.');\n  ev(w, { t: 'dark', on: 1 });\n  reopenPits(w, b);\n  // Three ropes at the rim.\n  const r = 11;\n  [Math.PI / 2, (Math.PI * 7) / 6, (Math.PI * 11) / 6].forEach((a, i) => {\n    let x = b.cx + Math.cos(a) * r, z = b.cz + Math.sin(a) * r;\n    for (let d = r; d > 2 && !walkable(w, x, z); d -= 0.5) { x = b.cx + Math.cos(a) * d; z = b.cz + Math.sin(a) * d; }\n    addObject(w, 'rope', x, z, { key: 'rope', hold: 2, announce: true, r: 1.2, ropeIndex: i, id: 1500000 + i });\n  });\n  toast(w, 'HOLD A BELL ROPE TO RING OLD CLEMENCY', 'sand', { big: 1 });\n  w.questSignal?.('ring');\n}\n\nfunction reopenPits(w, b) {\n  for (const [cx, cz] of b.pits ?? []) setCellOpen(w, cx, cz, true);\n  b.pits = [];\n  ev(w, { t: 'obst_clear' });\n}\n\nexport function ringRope(w, h, rope) {\n  const m = w.boss;\n  if (!m || m.def.boss !== 'malison') return;\n  const b = m.bossState;\n  b.rings = (b.rings ?? 0) + 1;\n  b.stagger = 2.5;\n  m.hp = Math.max(m.maxHp * 0.03, m.hp - m.maxHp * 0.12);\n  ev(w, { t: 'ring_bell', n: b.rings, x: m.x, z: m.z });\n  ev(w, { t: 'fx', k: 'ring_bronze', s: 'bell_true', sh: 1, wv: 1, x: m.x, z: m.z, r: 8 });\n  ev(w, { t: 'mcast', id: m.id, clip: 'stagger', sp: 1 });\n  ev(w, { t: 'hit', id: m.id, a: Math.round(m.maxHp * 0.12), c: 1, el: 'sound', s: h.seat, x: m.x, z: m.z, big: 1 });\n  if (b.rings >= 3) {\n    say(w, 'malison', 'NOT THE BELL. NOT TRUE. NOT TRUE...');\n    killMonster(w, m, h, { big: true });\n  }\n}\n\nfunction crumbleCell(w, m, b, t) {\n  const cx = Math.floor(t.x + w.rng.range(-3, 3)), cz = Math.floor(t.z + w.rng.range(-3, 3));\n  const cells = [];\n  for (let i = -1; i <= 1; i++) for (let j = -1; j <= 1; j++) {\n    const col = cx + i, row = cz + j;\n    if (!w.zone.nav.isOpen(col, row)) continue;\n    if (Math.hypot(col + 0.5 - b.cx, row + 0.5 - b.cz) < 3) continue;\n    cells.push([col, row]);\n  }\n  if (!cells.length) return;\n  telegraphRing(w, cx + 0.5, cz + 0.5, 2.1, 1.4, m.dmg * 0.6, {\n    src: m, vfx: 'floor_crumble', sfx: 'stone_hit', shake: 0.3,\n    then: (w2) => {\n      const closed = [];\n      for (const [col, row] of cells) {\n        if (w2.heroes.some((h) => Math.floor(h.x) === col && Math.floor(h.z) === row)) continue;\n        setCellOpen(w2, col, row, false);\n        closed.push([col, row]);\n      }\n      b.pits.push(...closed);\n      ev(w2, { t: 'obst', id: w2.nextId++, k: 'pit', x: cx, z: cz, cells: closed, life: 999 });\n      // Monsters standing there go with the floor.\n      for (const o of w2.monsters) if (!o.def.boss && !walkable(w2, o.x, o.z)) killMonster(w2, o, null, { silent: true });\n    },\n  });\n}\n\nfunction bellToll(w, m, b) {\n  const bx = b.cx, bz = b.cz;\n  ev(w, { t: 'fx', k: 'ring_bronze', s: 'bell_cracked', sh: 1, wv: 1, x: bx, z: bz, r: 22 });\n  ev(w, { t: 'toll', x: bx, z: bz });\n  for (const h of w.heroes) {\n    if (h.dead || h.gone) continue;\n    const safe = !w.zone.nav.lineOfSight(bx, bz, h.x, h.z);\n    if (safe) {\n      // The pillar that sheltered you takes the blow.\n      let best = null, bd = 9;\n      for (const p of b.pillars) {\n        if (p.hp <= 0) continue;\n        const d = dist(p.x, p.z, h.x, h.z);\n        if (d < bd) { bd = d; best = p; }\n      }\n      if (best) {\n        best.hp--;\n        ev(w, { t: 'pillar', x: best.x, z: best.z, hp: best.hp });\n        if (best.hp <= 0) setCellOpen(w, best.col, best.row, true);\n      }\n      continue;\n    }\n    if (h.state === 'dodge' || h.invuln > 0 || h.state === 'leap') { ev(w, { t: 'dodged', id: h.id }); continue; }\n    hurtHero(w, h, h.stats.maxHp * 0.6 / Math.max(0.2, 1 - (h.stats.armorTotal / (h.stats.armorTotal + 50 * m.level))) * (w.tuning.monsterDamage), { src: m, el: 'sound' });\n  }\n}\n\nexport function stepBoss(w, m) {\n  const script = bossScripts[m.def.boss];\n  if (!script) return;\n  script.step(w, m, m.bossState);\n}\n\nexport function bossDamaged(w, m, o) { bossScripts[m.def.boss]?.damaged?.(w, m, m.bossState, o); }\n\nexport function bossDied(w, m) {\n  bossScripts[m.def.boss]?.died?.(w, m, m.bossState);\n  if (w.boss === m) w.boss = null;\n  ev(w, { t: 'boss_dead', id: m.id, k: m.type, x: m.x, z: m.z });\n  // Everything the boss raised goes with it.\n  for (const o of w.monsters) if (o !== m && o.summoned && !o.dead) killMonster(w, o, null, { silent: true });\n  const L = m.level;\n  for (const h of w.heroes) {\n    if (h.gone || h.companion) continue;\n    for (let i = 0; i < 10; i++) dropGold(w, h, goldAt(L) * 3 * w.diffDef.reward * w.tuning.goldRate, m.x, m.z, 3);\n    dropItem(w, h, makeRolledItem(w.lootRng, h, 'reliquary', L + 1), m.x, m.z, 2);\n  }\n  onBossKilled(w, m);\n}\nEOF\ncat > src/sim/quests.js <<'EOF'\n// The campaign's state machine: quest steps, scripted beats, writs, Sister Pyx.\nimport { CLASSES } from '../data/classes.js';\nimport { PYX_BANTER, STORY_LINES } from '../data/dialog.js';\nimport { gemId } from '../data/items.js';\nimport { QUESTS, WRIT_TEMPLATES } from '../data/quests.js';\nimport { DT, dist, ev, say, toast } from './core.js';\nimport { startBoss, ringRope } from './bosses.js';\nimport { addHero, newHeroData, recalcHero, levelUp } from './hero.js';\nimport { dropItem, dropLegendary, dropTallow, makeItem, makeRolledItem, spawnDrop } from './loot.js';\nimport { makeStatues, monsterLevel, openSpot, removeMonster, spawnElitePack, spawnMonster, spawnPack } from './monsters.js';\nimport { addObject, objectByKey, setObjectState } from './objects.js';\nimport { travel } from './travel.js';\nimport { knellKill, onKnellBossDead, stepKnell, knellZoneEntered } from './knell.js';\nimport { roundLevelUp, roundBossDead } from './round.js';\n\nexport function newCampaign() {\n  return {\n    q: { i: 0, s: 0 }, flags: {}, gates: {}, visited: {}, lore: {}, bestiary: {}, portal: null, lastGate: null, zone: 'yard', floor: 0, writs: [], writsDone: 0, writCaches: 0,\n    shrines: 0, coffins: 0, chests: 0, levers: 0, broken: 0, bells: 0, bones: 0, credits: false, plateFirst: false, runsDone: 0,\n  };\n}\n\nexport const currentQuest = (w) => QUESTS[w.camp?.q.i] ?? null;\nexport const currentStep = (w) => currentQuest(w)?.steps[w.camp.q.s] ?? null;\nexport const stepIs = (w, id) => currentStep(w)?.id === id;\n\nfunction advance(w) {\n  const q = currentQuest(w);\n  if (!q) return;\n  w.camp.q.s++;\n  if (w.camp.q.s >= q.steps.length) {\n    ev(w, { t: 'quest_done', name: q.name });\n    w.camp.q.i++;\n    w.camp.q.s = 0;\n    ev(w, { t: 'sfx', k: 'quest' });\n  }\n  enterStep(w);\n}\n\nfunction enterStep(w) {\n  const st = currentStep(w);\n  if (!st) return;\n  ev(w, { t: 'quest', name: currentQuest(w).name, text: st.text, id: st.id });\n  ev(w, { t: 'autosave' });\n  const f = w.camp.flags;\n  switch (st.id) {\n    case 'east': break;\n    case 'coffin': break;\n    case 'to_causeway': f.open_causeway = 1; break;\n    case 'see_ogive': updateNpcs(w); break;\n    case 'bone1': f.open_ossuary = 1; break;\n    case 'bursar': if (f.bursar_dead) advance(w); break;\n    case 'to_cloister': f.open_cloister = 1; break;\n    case 'bishop': if (f.ambrose_dead) advance(w); break;\n    case 'to_belfry': f.open_belfry = 1; break;\n    default: break;\n  }\n  w.camp.seenQuest = true;\n}\n\nexport function questInit(w) { enterStep(w); }\n\n// ---- Objective, for the map marker and the bot ------------------------------------------------\nexport function objectiveOf(w) {\n  const st = currentStep(w);\n  if (!st) return null;\n  const f = w.camp.flags;\n  const town = (key) => ({ zone: 'town', floor: 0, key });\n  const here = w.zone?.id, floor = w.zone?.floor;\n  switch (st.id) {\n    case 'wake': case 'east': return { zone: 'yard', floor: 0, x: 45, z: 7 };\n    case 'coffin': return { zone: 'yard', floor: 0, key: 'coffin_quest' };\n    case 'gate': return { zone: 'yard', floor: 0, key: 'yard_gate' };\n    case 'crier': return town('npc_crier');\n    case 'to_causeway': return { zone: 'causeway', floor: 0 };\n    case 'find_brasse': return { zone: 'causeway', floor: 0, key: 'npc_brasse' };\n    case 'escort': return { zone: 'causeway', floor: 0, key: 'wagon', escort: true };\n    case 'brasse_home': return town('npc_brasse');\n    case 'see_ogive': case 'ogive_home': return town('npc_ogive');\n    case 'bone1': return { zone: 'ossuary', floor: 0, key: 'relic' };\n    case 'bone2': return { zone: 'ossuary', floor: 1, key: 'relic' };\n    case 'bone3': return { zone: 'ossuary', floor: 2, key: 'relic' };\n    case 'bursar': return { zone: 'ossuary', floor: 2, boss: 'bursar' };\n    case 'ledger': return { zone: 'ossuary', floor: 2, key: 'ledger' };\n    case 'see_crier': case 'crier_truth': return town('npc_crier');\n    case 'to_cloister': return { zone: 'cloister', floor: 0 };\n    case 'novices': return { zone: 'cloister', floor: 0, key: 'novice', defend: !!w.novices };\n    case 'bishop': return { zone: 'cloister', floor: 0, boss: 'ambrose' };\n    case 'to_belfry': return { zone: 'belfry', floor: 0 };\n    case 'climb': return { zone: 'belfry', floor: 3 };\n    case 'malison': return { zone: 'belfry', floor: 3, fight: true };\n    case 'ring': return { zone: 'belfry', floor: 3, key: 'rope' };\n    default: return { zone: here, floor };\n  }\n}\n\n// ---- Zones ------------------------------------------------------------------------------------\nexport function updateNpcs(w) {\n  const c = w.camp;\n  if (!c) return;\n  const qi = c.q.i;\n  for (const o of w.objects) {\n    if (o.kind !== 'npc') {\n      if (o.key === 'writ_board') { o.hidden = !c.flags.forge; ev(w, { t: 'obj', id: o.id, state: o.state, hidden: o.hidden }); }\n      if (o.key === 'knell_font') { o.hidden = false; }\n      continue;\n    }\n    let hide = false;\n    if (w.zone.id === 'town') {\n      if (o.npc === 'brasse') hide = !c.flags.brasse_met || !c.flags.brasse_home;\n      if (o.npc === 'ogive') hide = qi < 2;\n    } else if (o.npc === 'brasse' && (c.flags.brasse_met)) hide = true;\n    if (o.hidden !== hide) { o.hidden = hide; ev(w, { t: 'obj', id: o.id, state: o.state, hidden: hide }); }\n  }\n}\n\nexport function onZoneEntered(w) {\n  const z = w.zone;\n  if (w.round) return;\n  if (w.run) { knellZoneEntered(w); return; }\n  const c = w.camp;\n  if (!c) return;\n  updateNpcs(w);\n  ensurePyx(w);\n  const st = currentStep(w)?.id;\n  // A portal stays open in town while you are there.\n  if (z.id === 'town' && c.portal) addObject(w, 'portal', z.entryX + 2, z.entryZ - 1, { id: 1400000, announce: true, r: 1.2 });\n  // Hide relics already taken; ledger on revisits.\n  for (const o of w.objects) {\n    if (o.kind === 'relic' && c.flags[`bone_${z.floor}`]) { o.hidden = true; }\n    if (o.kind === 'book' && o.lore && c.lore[o.lore]) o.state = 1;\n  }\n  if (z.id === 'yard') {\n    if (st === 'wake') scriptWake(w);\n    if (c.flags.yard_coffin) { const co = objectByKey(w, 'coffin_quest'); if (co) co.state = 2; const g = objectByKey(w, 'yard_gate'); if (g) g.locked = false; }\n    if (!c.flags.yard_book_seen) ev(w, { t: 'sfx', k: 'rain_start' });\n  }\n  if (z.id === 'causeway') {\n    if (st === 'to_causeway') advance(w);\n    if (st === 'escort') { const wg = objectByKey(w, 'wagon'); if (wg) startEscort(w, wg); }\n    else if (c.flags.wagon_home) { const wg = objectByKey(w, 'wagon'); if (wg) setObjectState(w, wg, 2, { hidden: true }); }\n  }\n  if (z.id === 'town') {\n    if (st === 'gate') advance(w);\n  }\n  if (z.id === 'cloister' && st === 'to_cloister') advance(w);\n  if (z.id === 'belfry') {\n    if (st === 'to_belfry') advance(w);\n    if (z.floor === 3) {\n      if (currentStep(w)?.id === 'climb') advance(w);\n      const center = { x: z.w / 2, z: z.h / 2 };\n      if (!c.flags.malison_dead) {\n        startBoss(w, 'malison', center.x, center.z, {});\n        ev(w, { t: 'cut', id: 'malison_intro' });\n      }\n    }\n  }\n  placeWritCoffin(w);\n  if (z.plateRoll) w.plateAt = w.time + w.rng.range(20, 60);\n}\n\nfunction scriptWake(w) {\n  const z = w.zone;\n  // Your coffin bursts and they are already here.\n  for (const [dx, dz] of [[5, -2], [6, 2], [8, 0]]) {\n    spawnMonster(w, 'peatwalker', z.entryX + dx, z.entryZ + dz, { state: 'chase', questTag: 'wake', from: 'ground', noXp: false });\n  }\n}\n\n// ---- Events from the sim ----------------------------------------------------------------------\nexport function onMonsterKilled(w, m, src) {\n  knellKill(w, m);\n  const c = w.camp;\n  if (!c) return;\n  const f = c.flags;\n  if (m.questTag === 'wake') {\n    if (!f.first_tallow) { f.first_tallow = 1; dropTallow(w, m.x, m.z); }\n    if (!w.monsters.some((o) => o.questTag === 'wake' && !o.dead)) {\n      if (stepIs(w, 'wake')) {\n        for (const h of w.heroes) {\n          if (h.companion || h.gone) continue;\n          const it = makeItem(w.lootRng, { slot: 'main', rarity: 'blessed', ilvl: 2, cls: h.cls });\n          dropItem(w, h, it, m.x, m.z, 0.8);\n        }\n        advance(w);\n      }\n    }\n  }\n  if (src && !src.companion && !m.summoned) {\n    for (const wr of c.writs) {\n      if (wr.done) continue;\n      if (wr.k === 'kill' && wr.zone === w.zone.id) { wr.have = (wr.have ?? 0) + 1; if (wr.have >= wr.n) finishWrit(w, wr); }\n    }\n  }\n  if (src && !src.companion && w.rng.chance(0.03)) pyx(w, 'kill');\n}\n\nexport function onHeroDied(w, h) {\n  if (h.companion) { pyx(w, 'down', true); return; }\n  if (w.boss?.def.boss === 'malison') say(w, 'malison', STORY_LINES.malison_kill);\n}\nexport function onRoundLevelUp(w, h) { roundLevelUp(w, h); }\n\nexport function onItemPicked(w, h, item) {\n  if ((item.rarity === 'legendary' || item.rarity === 'set') && w.camp) w.camp.legendaries = (w.camp.legendaries ?? 0) + 1;\n  if (item.rarity === 'legendary' || item.rarity === 'set') pyx(w, 'loot');\n}\n\nexport function onTalkStart(w, h, o) {\n  if (!w.camp) return;\n}\n\n/** The dialogue finished (from the UI, or a bot). */\nexport function onTalkDone(w, h, npc) {\n  const c = w.camp;\n  if (!c) return;\n  const st = currentStep(w)?.id;\n  const f = c.flags;\n  if (npc === 'crier') {\n    if (st === 'crier') { f.crier_met = 1; f.overdue_open = 1; advance(w); return; }\n    if (st === 'see_crier') { advance(w); return; }\n    if (st === 'crier_truth') { advance(w); return; }\n    if (f.overdue_found && !f.overdue_done) {\n      f.overdue_done = 1;\n      for (const a of w.heroes) if (!a.companion && !a.gone) { a.gold += 250 + 20 * a.level; dropItem(w, a, makeRolledItem(w.lootRng, a, 'reliquary', monsterLevel(w)), a.x, a.z, 1.5); }\n      toast(w, 'THE OVERDUE BOOK IS RETURNED', 'sand', { big: 1 });\n      ev(w, { t: 'quest_done', name: 'AN OVERDUE BOOK' });\n    }\n    return;\n  }\n  if (npc === 'brasse') {\n    if (st === 'find_brasse') {\n      f.brasse_met = 1;\n      advance(w);\n      const wg = objectByKey(w, 'wagon');\n      if (wg) startEscort(w, wg);\n      updateNpcs(w);\n      return;\n    }\n    if (st === 'brasse_home') { f.forge = 1; updateNpcs(w); pyx(w, 'town'); advance(w); return; }\n    return;\n  }\n  if (npc === 'ogive') {\n    if (st === 'see_ogive') { advance(w); return; }\n    if (st === 'ogive_home') {\n      f.reliquary = 1;\n      for (const a of w.heroes) {\n        if (a.companion || a.gone) continue;\n        a.gems[gemId('ember', 0)] = (a.gems[gemId('ember', 0)] ?? 0) + 1;\n        a.gems[gemId('salt', 0)] = (a.gems[gemId('salt', 0)] ?? 0) + 1;\n        a.gems[gemId('amber', 0)] = (a.gems[gemId('amber', 0)] ?? 0) + 1;\n        const it = makeItem(w.lootRng, { slot: 'chest', rarity: 'reliquary', ilvl: monsterLevel(w), cls: a.cls, forceSocket: true });\n        dropItem(w, a, it, a.x, a.z, 1.5);\n      }\n      advance(w);\n      return;\n    }\n  }\n}\n\nexport function onObjectUsed(w, h, o) {\n  const c = w.camp;\n  if (!c) return;\n  const f = c.flags;\n  if (o.key === 'yard_gate') {\n    if (!o.locked) travel(w, 'town', 0, 'start');\n    return;\n  }\n  if (o.kind === 'relic') {\n    f[`bone_${w.zone.floor}`] = 1;\n    c.bones++;\n    ev(w, { t: 'fx', k: 'shrine', s: 'bell_small', x: o.x, z: o.z, r: 2 });\n    toast(w, `A BONE OF SAINT GLOAM. ${c.bones} OF 3.`, 'sand', { big: 1 });\n    if (c.bones >= 3 && (stepIs(w, 'bone1') || stepIs(w, 'bone2') || stepIs(w, 'bone3'))) { c.q.s = QUESTS[c.q.i].steps.findIndex((s) => s.id === 'bursar'); enterStep(w); }\n    else if (stepIs(w, 'bone1') || stepIs(w, 'bone2')) advance(w);\n    return;\n  }\n  if (o.key === 'ledger') {\n    c.lore.bishops_ledger = 1;\n    ev(w, { t: 'lore', id: 'bishops_ledger', seat: h.seat });\n    if (stepIs(w, 'ledger')) advance(w);\n    return;\n  }\n  if (o.key === 'overdue_book') {\n    f.overdue_found = 1;\n    setObjectState(w, o, 2, { hidden: true });\n    toast(w, 'THE OVERDUE BOOK. FORTY YEARS LATE.', 'sand', { big: 1 });\n    return;\n  }\n  if (o.kind === 'rope') { ringRope(w, h, o); return; }\n}\n\nexport function onCoffinDone(w, o) {\n  const c = w.camp;\n  if (!c) return;\n  if (o.key === 'coffin_quest') {\n    c.flags.yard_coffin = 1;\n    const g = objectByKey(w, 'yard_gate');\n    if (g) { setObjectState(w, g, 0, { locked: false }); }\n    ev(w, { t: 'fx', k: 'dust_ring', s: 'portcullis', x: g?.x ?? o.x, z: g?.z ?? o.z, r: 2 });\n    if (stepIs(w, 'coffin')) advance(w);\n  }\n  for (const wr of c.writs) if (!wr.done && wr.k === 'coffin' && wr.zone === w.zone.id) finishWrit(w, wr);\n}\n\nexport function onBossKilled(w, m) {\n  const c = w.camp;\n  onKnellBossDead(w, m);\n  roundBossDead(w, m);\n  if (!c) return;\n  const f = c.flags;\n  const first = !f[`${m.type}_dead`];\n  f[`${m.type}_dead`] = 1;\n  for (const wr of c.writs) if (!wr.done && wr.k === 'boss' && wr.boss === m.type) finishWrit(w, wr);\n  if (w.run) return;\n  if (m.type === 'bursar') {\n    if (first) {\n      for (const a of w.heroes) {\n        if (a.companion || a.gone) continue;\n        dropItem(w, a, makeItem(w.lootRng, { rarity: 'legendary', ilvl: m.level + 1, cls: a.cls, legendary: firstLegendary(w, a) }), m.x, m.z, 2);\n        spawnDrop(w, { kind: 'gem', gem: gemId('ember', 0), x: m.x + 1, z: m.z, owner: a.seat });\n      }\n      addObject(w, 'ledger', m.x, m.z + 1.5, { key: 'ledger', label: 'THE LEDGER', announce: true, id: 1300000 });\n    }\n    if (stepIs(w, 'bursar')) advance(w);\n  }\n  if (m.type === 'ambrose') {\n    say(w, 'ambrose', 'THREE TIMES. AND EVERY TIME, THE DARK WAS SINGING.');\n    if (stepIs(w, 'bishop')) advance(w);\n    if (first) for (const a of w.heroes) if (!a.companion && !a.gone) { dropItem(w, a, makeRolledItem(w.lootRng, a, 'reliquary', m.level + 1), m.x, m.z, 2); if (w.lootRng.chance(0.5)) dropLegendary(w, a, m.level + 1, m.x, m.z); }\n  }\n  if (m.type === 'malison') {\n    if (first) {\n      for (const a of w.heroes) {\n        if (a.companion || a.gone) continue;\n        dropItem(w, a, makeRolledItem(w.lootRng, a, 'legendary', m.level + 1), m.x, m.z, 2);\n        dropItem(w, a, makeRolledItem(w.lootRng, a, 'set', m.level + 1), m.x, m.z, 2);\n      }\n    }\n    ev(w, { t: 'cut', id: 'ending', first: first ? 1 : 0 });\n    c.credits = true;\n    w.account.unlocks.penance = true;\n    w.account.unlocks.knell = true;\n    if (stepIs(w, 'ring') || stepIs(w, 'malison')) { c.q.i = QUESTS.length; c.q.s = 0; ev(w, { t: 'quest_done', name: 'RING IT OR DIE TRYING' }); }\n    ev(w, { t: 'autosave' });\n  }\n  if (m.type === 'cellarer') { c.flags.pantry_done = 1; }\n}\n\nfunction firstLegendary(w, h) {\n  const ids = { bellwarden: 'widows_clapper', lamplighter: 'last_wick', sexton: 'second_best_crook' };\n  return ids[h.cls] ?? 'clemency_shard';\n}\n\n// ---- Frame ------------------------------------------------------------------------------------\nexport function stepQuests(w) {\n  stepKnell(w);\n  const c = w.camp;\n  if (!c || w.round) return;\n  if (w.t % 15 === 0) stepCheap(w);\n  stepEscortWagon(w);\n  stepNovices(w);\n}\n\nfunction stepCheap(w) {\n  const c = w.camp;\n  const z = w.zone;\n  const st = currentStep(w)?.id;\n  const heroes = w.heroes.filter((h) => !h.gone && !h.dead && !h.companion);\n  if (!heroes.length) return;\n  // Bosses wake when you walk into their rooms.\n  for (const r of z.rooms) {\n    if (!r.tpl?.boss || z.bossStarted === r.index || r.tpl.boss === 'malison') continue;\n    if (heroes.some((h) => h.x > r.x + 1 && h.x < r.x + r.w - 1 && h.z > r.y + 1 && h.z < r.y + r.h - 1)) {\n      z.bossStarted = r.index;\n      const room = r;\n      const x = room.x + room.w / 2, zz = room.y + room.h / 2;\n      startBoss(w, r.tpl.boss, x, zz, {});\n      ev(w, { t: 'cut', id: `${r.tpl.boss}_intro` });\n    }\n  }\n  if (st === 'east') {\n    if (!c.flags.deacon && heroes.some((h) => h.x > 21)) {\n      c.flags.deacon = 1;\n      spawnMonster(w, 'bloat_deacon', 32, 6.5, { state: 'chase', questTag: 'deacon' });\n      spawnPack(w, { x: 30, z: 3, kind: 'S' });\n    }\n    if (heroes.some((h) => h.x > 45)) advance(w);\n  }\n  if (z.id === 'causeway') {\n    if (!c.flags.first_pack && z.rooms[2] && heroes.some((h) => dist(h.x, h.z, z.rooms[2].cx, z.rooms[2].cz) < 22)) {\n      c.flags.first_pack = 1;\n      spawnElitePack(w, { x: z.rooms[2].cx, z: z.rooms[2].cz }, z.def.monsters, { kind: 'champion', type: 'peatwalker', aff: ['tolling'] });\n      pyx(w, 'elite');\n    }\n    if (!c.plateFirst && z.rooms[3] && heroes.some((h) => dist(h.x, h.z, z.rooms[3].cx, z.rooms[3].cz) < 16)) {\n      c.plateFirst = true;\n      spawnPlate(w, z.rooms[3].cx, z.rooms[3].cz);\n    }\n  }\n  if (w.plateAt && w.time > w.plateAt) { w.plateAt = 0; const h = heroes[0]; const p = openSpot(w, h.x + 8, h.z + 4, 4); spawnPlate(w, p.x, p.z); }\n  if (st === 'novices' && !w.novices && z.id === 'cloister') {\n    const nv = w.objects.find((o) => o.kind === 'novice');\n    if (nv && heroes.some((h) => dist(h.x, h.z, nv.x, nv.z) < 8)) startNovices(w);\n  }\n  if (st === 'climb' || st === 'novices' || st === 'bishop') {\n    w.tauntT = (w.tauntT ?? 25) - 0.25;\n    if (w.tauntT <= 0) { w.tauntT = 45; say(w, 'malison', w.rng.pick(STORY_LINES.malison_cloister)); }\n  }\n  // Pyx talks when she has something to say.\n  w.pyxIdle = (w.pyxIdle ?? 40) - 0.25;\n  if (w.pyxIdle <= 0) { w.pyxIdle = 55; pyx(w, z.def.safe ? 'town' : 'idle'); }\n  if (w.boss && !w.pyxBoss) { w.pyxBoss = true; pyx(w, 'boss'); }\n  if (!w.boss) w.pyxBoss = false;\n  // Spawn packs near heroes.\n  stepSpawns(w, heroes);\n}\n\nexport function stepSpawns(w, heroes = null) {\n  const z = w.zone;\n  const list = heroes ?? w.heroes.filter((h) => !h.gone && !h.dead);\n  for (const s of z.spawnList) {\n    if (s.done) continue;\n    if (list.some((h) => dist(h.x, h.z, s.x, s.z) < 30)) {\n      s.done = true;\n      if (w.monsters.length < 260) spawnPack(w, s);\n    }\n  }\n}\n\nexport function spawnPlate(w, x, z) {\n  const m = spawnMonster(w, 'collection_plate', x, z, { state: 'chase', knellPts: 8 });\n  ev(w, { t: 'plate', id: m.id, x, z });\n  toast(w, 'THE COLLECTION PLATE! CATCH IT BEFORE IT ESCAPES', 'sand', { big: 1 });\n  pyx(w, 'elite');\n  return m;\n}\n\n// The wagon of bells.\nfunction startEscort(w, wg) {\n  const z = w.zone;\n  const path = z.nav.path([wg.x, 0, wg.z], [z.entryX + 3, 0, z.entryZ]) ?? [[wg.x, 0, wg.z]];\n  w.escort = { wg, path, i: 1, t: 8, total: 0, done: false, joined: !!w.camp.flags.pyx };\n  ev(w, { t: 'fx', k: '', s: 'cart', x: wg.x, z: wg.z });\n}\n\nfunction stepEscortWagon(w) {\n  const e = w.escort;\n  if (!e || e.done || w.zone.id !== 'causeway') return;\n  const wg = e.wg;\n  const near = w.heroes.some((h) => !h.dead && !h.gone && dist(h.x, h.z, wg.x, wg.z) < 10);\n  const blocked = w.monsters.some((m) => !m.dead && dist(m.x, m.z, wg.x, wg.z) < 2.5);\n  e.moving = near && !blocked;\n  if (e.moving) {\n    const p = e.path[e.i];\n    if (p) {\n      const dx = p[0] - wg.x, dz = p[2] - wg.z, l = Math.hypot(dx, dz);\n      const step = 3 * DT;\n      if (l <= step) { wg.x = p[0]; wg.z = p[2]; e.i++; }\n      else { wg.x += (dx / l) * step; wg.z += (dz / l) * step; }\n      wg.dx = dx; wg.dz = dz;\n      e.total += step;\n    }\n  }\n  if (w.t % 12 === 0) ev(w, { t: 'objmove', id: wg.id, x: wg.x, z: wg.z, d: Math.atan2(wg.dx ?? 0, wg.dz ?? 1), m: e.moving ? 1 : 0 });\n  e.t -= DT;\n  if (e.t <= 0 && near) {\n    e.t = 9;\n    const pack = 5 + w.heroes.filter((h) => !h.gone && !h.companion).length * 2;\n    for (let i = 0; i < pack * w.tuning.monsterDensity; i++) {\n      const a = w.rng.range(0, Math.PI * 2);\n      const p = openSpot(w, wg.x + Math.cos(a) * 9, wg.z + Math.sin(a) * 9, 3);\n      const type = w.rng.chance(0.25) ? 'gibbet_drop' : 'peatwalker';\n      spawnMonster(w, type, p.x, p.z, { state: 'chase', from: type === 'gibbet_drop' ? 'drop' : 'ground' });\n    }\n  }\n  if (!e.joined && e.i > e.path.length * 0.4) { e.joined = true; w.camp.flags.pyx = 1; ensurePyx(w, wg); pyx(w, 'join', true); }\n  if (e.i >= e.path.length) {\n    e.done = true;\n    w.camp.flags.wagon_home = 1;\n    w.camp.flags.brasse_home = 1;\n    w.camp.flags.pyx = 1;\n    ensurePyx(w, wg);\n    toast(w, 'THE WAGON IS THROUGH', 'sand', { big: 1 });\n    ev(w, { t: 'fx', k: '', s: 'bell_mid', x: wg.x, z: wg.z });\n    if (stepIs(w, 'escort')) advance(w);\n    setObjectState(w, wg, 2, { hidden: true });\n    w.escort = null;\n  }\n}\n\n// The novices.\nfunction startNovices(w) {\n  const spots = w.objects.filter((o) => o.key === 'font_spot');\n  w.novices = { hp: 100, t: 40, wave: 1, fonts: [], fail: 0 };\n  ev(w, { t: 'event', k: 'novices', text: 'DEFEND THE NOVICES', t0: 40 });\n  say(w, 'pyx', 'They are still singing. Keep them singing.');\n  for (const s of spots) w.novices.fonts.push(spawnMonster(w, 'unrung_font', s.x, s.z, { state: 'chase', knellPts: 0 }));\n}\n\nfunction stepNovices(w) {\n  const n = w.novices;\n  if (!n || w.zone.id !== 'cloister') return;\n  const list = w.objects.filter((o) => o.kind === 'novice');\n  if (n.fail > 0) {\n    n.fail -= DT;\n    if (n.fail <= 0) { w.novices = null; for (const o of list) { o.hidden = false; ev(w, { t: 'obj', id: o.id, state: 0, hidden: false }); } }\n    return;\n  }\n  n.t -= DT;\n  n.wave -= DT;\n  let threats = 0;\n  for (const m of w.monsters) {\n    if (m.dead) continue;\n    for (const o of list) if (dist(m.x, m.z, o.x, o.z) < 2.2) threats++;\n  }\n  n.hp -= threats * 0.6 * DT;\n  if (n.wave <= 0) {\n    n.wave = 7;\n    const nv = list[0];\n    const count = (6 + w.heroes.length * 2) * w.tuning.monsterDensity;\n    for (let i = 0; i < count; i++) {\n      const a = w.rng.range(0, Math.PI * 2);\n      const p = openSpot(w, nv.x + Math.cos(a) * 9, nv.z + Math.sin(a) * 6, 2);\n      const m = spawnMonster(w, w.rng.chance(0.75) ? 'cinderling' : 'penitent', p.x, p.z, { state: 'chase', from: 'ground' });\n      m.tgtNovice = true;\n    }\n  }\n  ev(w, { t: 'event_tick', hp: Math.round(n.hp), left: Math.ceil(n.t) });\n  if (n.hp <= 0) {\n    ev(w, { t: 'event', k: 'novices_fail', text: 'THE SINGING HAS STOPPED' });\n    for (const o of list) { o.hidden = true; ev(w, { t: 'obj', id: o.id, state: 0, hidden: true }); }\n    for (const f of n.fonts) if (!f.dead) removeMonster(w, f);\n    say(w, 'pyx', 'No. Not like that. Listen: another voice, further in. Hurry.');\n    n.fail = 8;\n    return;\n  }\n  if (n.t <= 0) {\n    ev(w, { t: 'event', k: 'novices_done', text: 'THE NOVICES GET AWAY' });\n    w.novices = null;\n    for (const f of n.fonts) if (!f.dead) removeMonster(w, f);\n    for (const o of list) { o.hidden = true; ev(w, { t: 'obj', id: o.id, state: 0, hidden: true }); }\n    addObject(w, 'chest', list[0].x, list[0].z, { rich: true, announce: true, gem: gemId('salt', 0) });\n    say(w, 'pyx', 'Go on, then. Run. Sing something cheerful. No, not that one.');\n    if (stepIs(w, 'novices')) advance(w);\n  }\n}\n\n// Sister Pyx.\nexport function ensurePyx(w, near = null) {\n  const c = w.camp;\n  if (!c?.flags.pyx || w.noPyx) return;\n  const humans = w.heroes.filter((h) => !h.gone && !h.companion);\n  const have = w.heroes.find((h) => h.companion && !h.gone);\n  if (humans.length > 1) {\n    if (have) { have.gone = true; ev(w, { t: 'hero_gone', id: have.id }); w.heroes.splice(w.heroes.indexOf(have), 1); say(w, 'pyx', 'You have company. I shall go and glare at something else.'); }\n    return;\n  }\n  if (have) return;\n  const lead = humans[0];\n  if (!lead) return;\n  const data = newHeroData('pyx', 'SISTER PYX', 'pyx');\n  data.level = lead.level;\n  data.skills = CLASSES.pyx.preset.map(([id]) => ({ id, tone: null })).concat([null, null, null]);\n  const p = addHero(w, data, 8, { companion: true, navIndex: 5, x: (near?.x ?? lead.x) + 1, z: (near?.z ?? lead.z) + 1 });\n  p.isBot = true;\n  recalcHero(w, p);\n  p.hp = p.stats.maxHp;\n  return p;\n}\n\nexport function pyx(w, key, force = false) {\n  if (!w.camp?.flags.pyx || w.heroes.filter((h) => !h.companion && !h.gone).length > 1) return;\n  if (!force && (w.pyxNext ?? 0) > w.time) return;\n  w.pyxNext = w.time + 18;\n  w.camp.pyxLines = (w.camp.pyxLines ?? 0) + 1;\n  say(w, 'pyx', w.rng.pick(PYX_BANTER[key] ?? PYX_BANTER.idle));\n}\n\n// ---- Writs ------------------------------------------------------------------------------------\nexport function rollWrits(w) {\n  const c = w.camp;\n  const pool = WRIT_TEMPLATES.filter((t) => t.zone === 'yard' || c.visited[`${t.zone}:0`]);\n  const list = [...pool];\n  w.rng.shuffle(list);\n  c.writs = list.slice(0, 3).map((t) => ({ ...t, have: 0, done: false }));\n  c.writCache = false;\n  ev(w, { t: 'toast', text: 'NEW WRITS POSTED', color: 'sand' });\n}\n\nfunction placeWritCoffin(w) {\n  const c = w.camp;\n  const wr = c.writs.find((x) => !x.done && x.k === 'coffin' && x.zone === w.zone.id);\n  if (!wr) return;\n  const room = w.zone.rooms[Math.min(1, w.zone.rooms.length - 1)];\n  addObject(w, 'coffin', room.cx, room.cz, { key: 'writ_coffin', time: 30, count: 6, announce: true, id: 1200000 });\n}\n\nfunction finishWrit(w, wr) {\n  wr.done = true;\n  const c = w.camp;\n  c.writsDone++;\n  ev(w, { t: 'toast', text: `WRIT DONE: ${wr.text}`, color: 'lime' });\n  ev(w, { t: 'sfx', k: 'quest' });\n  if (c.writs.every((x) => x.done) && !c.writCache) {\n    c.writCache = true;\n    c.writCaches++;\n    for (const a of w.heroes) {\n      if (a.companion || a.gone) continue;\n      a.gold += 300 + 40 * a.level;\n      a.mats.dust += 6; a.mats.scrap += 12; a.mats.shards += 1;\n      dropItem(w, a, makeRolledItem(w.lootRng, a, 'reliquary', monsterLevel(w)), a.x, a.z, 1.5);\n    }\n    toast(w, 'THE VESTRY PAYS, FOR ONCE. A WRIT CACHE.', 'sand', { big: 1 });\n    ev(w, { t: 'autosave' });\n  }\n}\n\nexport { makeStatues, levelUp };\nEOF\ncat > src/sim/knell.js <<'EOF'\n// Knell Runs and the Grand Knell: a random dungeon, a meter, a Warden, and something to take home.\nimport { KNELL_MOD_IDS } from '../data/quests.js';\nimport { WARDENS } from '../data/monsters.js';\nimport { DIFFICULTIES } from '../data/tuning.js';\nimport { gemId } from '../data/items.js';\nimport { dist, ev, say, toast } from './core.js';\nimport { startBoss } from './bosses.js';\nimport { dropItem, goldAt, makeRolledItem, spawnDrop, dropGold } from './loot.js';\nimport { killMonster, partyCount, openSpot } from './monsters.js';\nimport { addObject } from './objects.js';\nimport { travel } from './travel.js';\nimport { gainXp } from './hero.js';\nimport { stepSpawns, spawnPlate } from './quests.js';\nimport { spawnPack } from './monsters.js';\nimport { telegraphRing } from './hazards.js';\n\nexport function rollMods(rng, n) {\n  const ids = [...KNELL_MOD_IDS];\n  rng.shuffle(ids);\n  return ids.slice(0, n);\n}\n\n/** Start a run. o: { grand: false, tier: 1, mods: [...] }, the UI shows the mods first. */\nexport function startRun(w, o = {}) {\n  const rng = w.rng;\n  const mods = o.mods ?? rollMods(rng, rng.int(1, 2));\n  const grand = !!o.grand;\n  const tier = o.tier ?? 1;\n  const party = partyCount(w);\n  w.run = {\n    seedKey: `run${w.t}`, mods, grand, tier, meter: 0, total: Math.round(450 * (1 + 0.25 * (party - 1)) * (grand ? 0.8 : 1)), state: 'fill',\n    hpMul: grand ? 1.17 ** tier : 1, dmgMul: grand ? 1.08 ** tier : 1, goldMul: mods.includes('golden') ? 2 : 1, densityMul: mods.includes('crowded') ? 1.4 : 1, speedMul: mods.includes('swift') ? 1.2 : 1,\n    startT: w.time, timer: grand ? 600 : 0, startKills: 0, floor: 0, warden: null, wardenT: 0, deaths: 0, table: null,\n  };\n  ev(w, { t: 'run_start', mods, grand: grand ? 1 : 0, tier, total: w.run.total });\n  travel(w, 'knell', 0, 'start');\n}\n\nexport function knellZoneEntered(w) {\n  const r = w.run;\n  ev(w, { t: 'run_floor', floor: w.zone.floor });\n  if (w.camp && !w.camp.plateRun && w.rng.chance(1 / 3)) { w.plateAt = w.time + w.rng.range(20, 60); w.camp.plateRun = true; }\n}\n\nexport function knellKill(w, m) {\n  const r = w.run;\n  if (!r || r.state !== 'fill') return;\n  const pts = m.knellPts ?? 1;\n  if (!pts) return;\n  r.meter = Math.min(r.total, r.meter + pts);\n  ev(w, { t: 'knell', v: r.meter, of: r.total });\n  if (r.meter >= r.total) knellTolls(w);\n}\n\nfunction knellTolls(w) {\n  const r = w.run;\n  r.state = 'warden';\n  ev(w, { t: 'knell_tolls' });\n  toast(w, 'THE KNELL TOLLS', 'white', { big: 1 });\n  for (const m of w.monsters) if (!m.dead && !m.def.boss) killMonster(w, m, null, { silent: true, big: true });\n  const lead = w.heroes.find((h) => !h.dead && !h.gone && !h.companion) ?? w.heroes[0];\n  const type = r.forceWarden ?? w.rng.pick(WARDENS);\n  r.wardenAt = w.time + 2;\n  r.wardenType = type;\n  r.wardenX = lead.x; r.wardenZ = lead.z;\n}\n\nexport function stepKnell(w) {\n  const r = w.run;\n  if (!r) return;\n  if (r.grand && r.state !== 'done') r.timer -= 1 / 60;\n  if (r.state === 'warden' && r.wardenAt && w.time >= r.wardenAt) {\n    r.wardenAt = 0;\n    const lead = w.heroes.find((h) => !h.dead && !h.gone && !h.companion) ?? w.heroes[0];\n    const p = openSpot(w, lead.x + 3, lead.z + 3, 2);\n    const m = startBoss(w, r.wardenType, p.x, p.z, { noIntro: true, level: Math.max(lead.level, w.zone.def.levelFloor) });\n    r.warden = m;\n    r.wardenStart = w.time;\n    ev(w, { t: 'fx', k: 'dust_ring', s: 'coffin_slam', sh: 0.8, wv: 1, x: p.x, z: p.z, r: 8 });\n    ev(w, { t: 'warden', k: r.wardenType, x: p.x, z: p.z });\n    telegraphRing(w, p.x, p.z, 3, 0.6, 0, {});\n  }\n  if (w.t % 15 === 0) {\n    stepSpawns(w);\n    if (w.plateAt && w.time > w.plateAt) { w.plateAt = 0; const h = w.heroes[0]; const p = openSpot(w, h.x + 8, h.z + 4, 4); spawnPlate(w, p.x, p.z); }\n    // No more monsters and meter unfilled on the last floor: raise some more.\n    if (r.state === 'fill' && w.zone.floor === w.zone.def.floors - 1 && w.monsters.length < 6 && w.zone.spawnList.every((s) => s.done)) {\n      const h = w.heroes.find((o) => !o.dead && !o.gone) ?? w.heroes[0];\n      for (let i = 0; i < 3; i++) { const p = openSpot(w, h.x, h.z, 9); spawnPack(w, { x: p.x, z: p.z, kind: i === 0 && w.rng.chance(0.3) ? 'E' : 'S' }); }\n    }\n  }\n}\n\nexport function onKnellBossDead(w, m) {\n  const r = w.run;\n  if (!r || m !== r.warden) return;\n  r.state = 'done';\n  const time = w.time - r.startT;\n  const beat = !r.grand || r.timer > 0;\n  const L = m.level;\n  const results = { time, grand: r.grand ? 1 : 0, tier: r.tier, beat: beat ? 1 : 0, keys: 0, xp: 0, shards: 0, best: 0 };\n  for (const h of w.heroes) {\n    if (h.gone || h.companion) continue;\n    dropItem(w, h, makeRolledItem(w.lootRng, h, 'legendary', L + 1), m.x, m.z, 2);\n    if (r.grand && beat) {\n      dropItem(w, h, makeRolledItem(w.lootRng, h, w.lootRng.chance(0.5) ? 'set' : 'legendary', L + 1), m.x, m.z, 2);\n      spawnDrop(w, { kind: 'gem', gem: gemId(w.lootRng.pick(['ember', 'salt', 'amber']), 1), x: m.x, z: m.z, owner: h.seat });\n    }\n    h.mats.shards += r.grand ? 3 : 1;\n    results.shards = r.grand ? 3 : 1;\n    const xp = (L * 120 + 500) * (r.grand ? 2 + r.tier * 0.25 : 1) * w.diffDef.reward;\n    gainXp(w, h, xp);\n    results.xp = Math.round(xp);\n    if (!r.grand && w.lootRng.chance(1 / 4)) { spawnDrop(w, { kind: 'key', x: m.x - 1, z: m.z, owner: h.seat }); results.keys = 1; }\n    if (r.grand) {\n      const bests = w.account.bests;\n      const cur = bests[h.cls];\n      const better = beat && (!cur || r.tier > cur.tier || (r.tier === cur.tier && time < cur.time));\n      if (better) { bests[h.cls] = { tier: r.tier, time: Math.round(time) }; results.best = 1; }\n    }\n  }\n  if (w.camp) w.camp.runsDone = (w.camp.runsDone ?? 0) + 1;\n  ev(w, { t: 'run_done', results });\n  addObject(w, 'exit', m.x + 2, m.z, { to: 'town', floor: 0, entry: 'start', label: 'THE WAY HOME', announce: true, key: 'run_home', id: 1100000 });\n}\n\nexport function endRun(w) { w.run = null; }\nexport { DIFFICULTIES, dist, say, goldAt, dropGold };\nEOF\ncat > src/sim/round.js <<'EOF'\n// The AI Hub session round: one shared Knell Run, fill the meter, slay the Warden. Host only.\nimport { CLASSES } from '../data/classes.js';\nimport { SKILLS } from '../data/skills.js';\nimport { VOWS } from '../data/classes.js';\nimport { RULES } from '../data/tuning.js';\nimport { DT, ev, toast } from './core.js';\nimport { addHero, gearLook, newHeroData, recalcHero } from './hero.js';\nimport { makeItem } from './loot.js';\nimport { addObject } from './objects.js';\nimport { loadZone } from './travel.js';\nimport { startRun } from './knell.js';\n\nexport const SEAT_CLASSES = ['bellwarden', 'lamplighter', 'sexton', 'bellwarden'];\nexport const ROUND_LEVEL = 12;\n\nexport function roundHeroData(cls, seat, name, rng) {\n  const d = newHeroData(cls, name, `round${seat}`);\n  d.level = ROUND_LEVEL;\n  d.skills = CLASSES[cls].preset.map(([id]) => ({ id, tone: null }));\n  const gear = {};\n  for (const slot of ['main', 'head', 'chest', 'hands', 'legs', 'feet', 'shoulders', 'amulet', 'ring']) {\n    gear[slot] = makeItem(rng, { slot, rarity: 'blessed', ilvl: ROUND_LEVEL, cls });\n  }\n  d.gear = gear;\n  return d;\n}\n\nexport function setupRound(w, players) {\n  w.round = { playT: 0, started: false, finished: false, time: 0, picks: new Map(), players };\n  w.noPyx = true;\n  w.run = {\n    seedKey: 'session', mods: ['crowded'], grand: false, tier: 1, meter: 0, total: Math.round(330 * (1 + 0.25 * (players.length - 1))), state: 'fill',\n    hpMul: 1, dmgMul: 1, goldMul: 1, densityMul: 1, speedMul: 1, startT: 0, timer: 0, floor: 0, warden: null, table: null,\n  };\n  const rng = w.root.fork('round');\n  for (const p of players) {\n    const cls = SEAT_CLASSES[p.id % 4];\n    const d = roundHeroData(cls, p.id, p.name, rng.fork(`hero${p.id}`));\n    const h = addHero(w, d, p.id, { navIndex: p.id });\n    h.color = p.color;\n    h.res = h.stats.maxResTotal * 0.5;\n  }\n  loadZone(w, 'session', 0, 'start');\n  placeClassFonts(w);\n}\n\nfunction placeClassFonts(w) {\n  const z = w.zone;\n  const offs = [[-3, -1.5, 'bellwarden'], [0, -2, 'lamplighter'], [3, -1.5, 'sexton']];\n  offs.forEach(([dx, dz, cls], i) => {\n    let x = z.entryX + dx, y = z.entryZ + dz;\n    if (!z.nav.walkable(x, y)) { x = z.entryX + dx * 0.5; y = z.entryZ + 1; }\n    addObject(w, 'class_font', x, y, { id: 1600000 + i, cls, noUse: true, label: CLASSES[cls].name, announce: false });\n  });\n  w.swapClass = (w2, h, cls) => {\n    const d = roundHeroData(cls, h.seat, h.name, w2.root.fork(`swap${h.seat}:${cls}`));\n    h.cls = cls;\n    h.gear = d.gear; h.skills = d.skills; h.vows = [null, null]; h.cds = {}; h.charges = {};\n    recalcHero(w2, h);\n    h.hp = h.stats.maxHp; h.res = h.stats.maxResTotal * 0.5;\n    ev(w2, { t: 'hero_class', id: h.id, cls });\n    ev(w2, { t: 'gear', id: h.id, g: gearLook(h) });\n    toast(w2, `${h.name} IS NOW A ${CLASSES[cls].name}`, CLASSES[cls].color);\n    for (const a of w2.allies) if (a.owner === h.id) a.life = 0.01;\n  };\n}\n\n/** A level-up in a session pops a small \"pick 1 of 3\". The host rolls the three and the seat answers. */\nexport function roundLevelUp(w, h) {\n  const opts = [];\n  const rng = w.lootRng;\n  const toned = h.skills.filter((s) => s && !s.tone);\n  if (toned.length) {\n    const s = rng.pick(toned);\n    const ids = Object.keys(SKILLS[s.id].tones);\n    const t = rng.pick(ids);\n    opts.push({ k: 'tone', skill: s.id, tone: t, name: `${SKILLS[s.id].name}: ${SKILLS[s.id].tones[t].name}`, desc: SKILLS[s.id].tones[t].desc });\n  }\n  const vows = VOWS[h.cls].filter((v) => !h.vows.includes(v.id));\n  if (vows.length && h.vows.includes(null)) {\n    const v = rng.pick(vows);\n    opts.push({ k: 'vow', vow: v.id, name: `VOW: ${v.name}`, desc: v.desc });\n  }\n  const stats = [{ k: 'stat', stat: 'power', amt: 15, name: '+15 POWER', desc: 'HIT HARDER' }, { k: 'stat', stat: 'vit', amt: 15, name: '+15 VITALITY', desc: 'STAY UP LONGER' }, { k: 'stat', stat: 'atkspd', amt: 0.08, name: '+8% ATTACK SPEED', desc: 'SWING FASTER' }];\n  rng.shuffle(stats);\n  while (opts.length < 3) opts.push(stats.pop());\n  h.pick = { t: 10, opts };\n  ev(w, { t: 'pick3', seat: h.seat, opts, level: h.level });\n}\n\nexport function applyRoundPick(w, h, i) {\n  if (!h.pick) return;\n  const o = h.pick.opts[i] ?? h.pick.opts[0];\n  h.pick = null;\n  ev(w, { t: 'pick3x', seat: h.seat, name: o.name });\n  if (o.k === 'tone') { const s = h.skills.find((x) => x?.id === o.skill); if (s) s.tone = o.tone; h.skillCache.clear(); }\n  else if (o.k === 'vow') { const idx = h.vows.indexOf(null); if (idx >= 0) h.vows[idx] = o.vow; recalcHero(w, h); }\n  else if (o.k === 'stat') {\n    const ring = h.gear.ring;\n    if (ring) ring.affixes.push({ k: o.stat, v: o.amt });\n    recalcHero(w, h);\n  }\n}\n\nexport function stepRound(w) {\n  const r = w.round;\n  if (!r) return;\n  r.playT += DT;\n  for (const h of w.heroes) {\n    if (!h.pick) continue;\n    h.pick.t -= DT;\n    if (h.pick.t <= 0) applyRoundPick(w, h, 0);\n  }\n}\n\nexport function roundBossDead(w, m) {\n  if (!w.round) return;\n  w.round.finished = true;\n  w.round.won = true;\n  ev(w, { t: 'round_won' });\n}\n\nexport const roundScore = (h) => (h.dmgDone ?? 0) / 100 + 50 * (h.revives ?? 0) + 20 * (h.eliteKills ?? 0) - 30 * (h.roundDeaths ?? 0);\n\nexport function roundResults(w, won) {\n  const heroes = w.heroes.filter((h) => !h.gone);\n  const scored = heroes.map((h) => ({ id: h.seat, score: Math.round(roundScore(h)), h }));\n  scored.sort((a, b) => b.score - a.score);\n  const standings = [];\n  for (const s of scored) {\n    const last = standings[standings.length - 1];\n    if (last && last.score === s.score) last.ids.push(s.id);\n    else standings.push({ score: s.score, ids: [s.id] });\n  }\n  const scores = Object.fromEntries(scored.map((s) => [s.id, s.score]));\n  const stats = Object.fromEntries(scored.map((s) => [s.id, { Damage: Math.round(s.h.dmgDone ?? 0), Kills: s.h.kills ?? 0, Revives: s.h.revives ?? 0, Gold: s.h.goldEarned ?? 0, Deaths: s.h.roundDeaths ?? 0 }]));\n  const top = (f) => scored.reduce((a, b) => (f(b.h) > f(a.h) ? b : a), scored[0]);\n  const awards = scored.length ? [\n    { id: top((h) => h.dmgDone ?? 0).id, title: 'Bell-Ringer', detail: 'Most damage' },\n    { id: top((h) => h.kills ?? 0).id, title: 'Undertaker', detail: 'Most kills' },\n    { id: top((h) => h.revives ?? 0).id, title: 'Good Samaritan', detail: 'Most revives' },\n    { id: top((h) => h.goldEarned ?? 0).id, title: 'Collector', detail: 'Most gold' },\n    { id: top((h) => h.roundDeaths ?? 0).id, title: 'Regular Customer', detail: 'Most deaths' },\n  ] : [];\n  return { standings: standings.map((s) => s.ids), scores, won, stats, awards };\n}\n\nexport { RULES, startRun };\nEOF\ncat > src/sim/commands.js <<'EOF'\n// Everything a menu can do to the world. Works the same from a pad, a mouse, the network or a bot.\nimport { CLASSES, VOWS } from '../data/classes.js';\nimport { AFFIXES, gemId, GEM_KINDS, LEGENDARIES, parseGem, RARITIES, SET_BY_CLASS, SETS, SLOTS, SOCKETABLE } from '../data/items.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { RULES, DIFFICULTIES } from '../data/tuning.js';\nimport { SKILLS } from '../data/skills.js';\nimport { dist, ev, toast } from './core.js';\nimport { toneUnlocked } from './effects.js';\nimport { reequip, recalcHero, slotOpen, skillUnlocked, riseAt, levelUp, gainXp, addHero, newHeroData, reviveHero } from './hero.js';\nimport { buyPrice, makeItem, makeRolledItem, rollAffixes, sellPrice, itemValue, dropItem } from './loot.js';\nimport { onTalkDone, rollWrits, ensurePyx, spawnPlate } from './quests.js';\nimport { goToGate, riseAtGate, travel } from './travel.js';\nimport { endRun, startRun } from './knell.js';\nimport { applyRoundPick } from './round.js';\nimport { killMonster, spawnElitePack, spawnMonster, monsterLevel, openSpot } from './monsters.js';\nimport { startBoss } from './bosses.js';\nimport { addObject } from './objects.js';\nimport { WARDENS } from '../data/monsters.js';\n\nexport const SALVAGE = { common: { scrap: 1 }, blessed: { scrap: 3 }, reliquary: { dust: 1 }, legendary: { shards: 1 }, set: { shards: 1 } };\nexport const CRAFT_COST = {\n  blessed: { gold: (L) => 40 + L * 12, scrap: 4 },\n  reliquary: { gold: (L) => 120 + L * 30, dust: 3, scrap: 4 },\n  legendary: { gold: (L) => 500 + L * 80, shards: 4, dust: 4 },\n};\nexport const REFORGE_COST = { gold: (L) => 60 + L * 15, dust: 1 };\nexport const CASKET_COST = { shards: 1, gold: (L) => 200 + L * 20 };\nexport const SOCKET_COST = (L) => 25 + L * 5;\n\nconst invFind = (h, uid) => h.inv.findIndex((it) => it && it.uid === uid);\n\nfunction shopRoll(w, h) {\n  const rng = w.lootRng;\n  const L = Math.max(1, h.level);\n  const stock = [];\n  for (let i = 0; i < 6; i++) {\n    const rarity = i < 2 ? 'common' : i < 4 ? 'blessed' : 'reliquary';\n    stock.push(makeRolledItem(rng, h, rarity, L));\n  }\n  h.shop = stock;\n  h.shopLevel = L;\n}\n\nexport function shopStock(w, h) {\n  if (!h.shop || h.shopLevel !== h.level) shopRoll(w, h);\n  return h.shop;\n}\n\n/** Apply one command. Returns true on success. */\nexport function applyCommand(w, seat, cmd) {\n  const h = w.heroes.find((o) => o.seat === seat);\n  if (!h && cmd.c !== 'join') return false;\n  const C = COMMANDS[cmd.c];\n  if (!C) return false;\n  return C(w, h, cmd) !== false;\n}\n\nconst COMMANDS = {\n  equip(w, h, { uid }) {\n    const i = uid ? invFind(h, uid) : -1;\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = h.gear[it.slot] ?? null;\n    h.gear[it.slot] = it;\n    if (h.newest === uid) h.newest = null;\n    reequip(w, h);\n    ev(w, { t: 'equip', seat: h.seat, name: it.name, rarity: it.rarity, slot: it.slot });\n    h.equips = (h.equips ?? 0) + 1;\n    return true;\n  },\n  equip_newest(w, h) { if (!h.newest) return false; return COMMANDS.equip(w, h, { uid: h.newest }); },\n  unequip(w, h, { slot }) {\n    const it = h.gear[slot];\n    const free = h.inv.indexOf(null);\n    if (!it || free < 0) return false;\n    h.inv[free] = it;\n    h.gear[slot] = null;\n    reequip(w, h);\n    return true;\n  },\n  drop(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = null;\n    if (h.newest === uid) h.newest = null;\n    dropItem(w, h, it, h.x + h.dirX * 1.5, h.z + h.dirZ * 1.5, 0.4).t = -1;\n    return true;\n  },\n  salvage(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = null;\n    for (const [k, v] of Object.entries(SALVAGE[it.rarity])) h.mats[k] += v;\n    for (const g of it.gems ?? []) if (g) h.gems[g] = (h.gems[g] ?? 0) + 1;\n    if (h.newest === uid) h.newest = null;\n    h.salvaged = (h.salvaged ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'salvage' });\n    return true;\n  },\n  salvage_all(w, h, { rarity }) {\n    let n = 0;\n    for (const it of [...h.inv]) if (it && it.rarity === rarity && it.uid !== h.newest) { COMMANDS.salvage(w, h, { uid: it.uid }); n++; }\n    return n > 0;\n  },\n  sell(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = null;\n    h.gold += sellPrice(it);\n    if (h.newest === uid) h.newest = null;\n    h.sold = (h.sold ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'gold' });\n    return true;\n  },\n  buy(w, h, { index }) {\n    const stock = shopStock(w, h);\n    const it = stock[index];\n    if (!it) return false;\n    const price = buyPrice(it);\n    const free = h.inv.indexOf(null);\n    if (h.gold < price || free < 0) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.gold -= price;\n    h.inv[free] = it;\n    stock[index] = null;\n    h.bought = (h.bought ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'gold' });\n    return true;\n  },\n  casket(w, h, { slot }) {\n    const L = h.level;\n    const free = h.inv.indexOf(null);\n    if (h.mats.shards < CASKET_COST.shards || h.gold < CASKET_COST.gold(L) || free < 0) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.mats.shards -= CASKET_COST.shards;\n    h.gold -= CASKET_COST.gold(L);\n    const rng = w.lootRng;\n    const r = rng.next();\n    const rarity = r < 0.05 ? 'legendary' : r < 0.45 ? 'reliquary' : 'blessed';\n    const it = rarity === 'legendary' ? makeRolledItem(rng, h, 'legendary', L) : makeItem(rng, { slot, rarity, ilvl: L, cls: h.cls });\n    h.inv[free] = it;\n    ev(w, { t: 'casket', seat: h.seat, name: it.name, rarity: it.rarity });\n    h.caskets = (h.caskets ?? 0) + 1;\n    return true;\n  },\n  craft(w, h, { slot, rarity }) {\n    const cost = CRAFT_COST[rarity];\n    const L = h.level;\n    const free = h.inv.indexOf(null);\n    if (!cost || free < 0) return false;\n    if (h.gold < cost.gold(L) || h.mats.scrap < (cost.scrap ?? 0) || h.mats.dust < (cost.dust ?? 0) || h.mats.shards < (cost.shards ?? 0)) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.gold -= cost.gold(L);\n    h.mats.scrap -= cost.scrap ?? 0; h.mats.dust -= cost.dust ?? 0; h.mats.shards -= cost.shards ?? 0;\n    const rng = w.lootRng;\n    h.inv[free] = rarity === 'legendary' ? makeRolledItem(rng, h, 'legendary', L) : makeItem(rng, { slot, rarity, ilvl: L, cls: h.cls });\n    h.crafted = (h.crafted ?? 0) + 1;\n    ev(w, { t: 'crafted', seat: h.seat, name: h.inv[free].name, rarity: h.inv[free].rarity });\n    return true;\n  },\n  reforge(w, h, { uid, slot, index }) {\n    const it = uid ? h.inv.find((x) => x?.uid === uid) ?? h.gear[slot] : h.gear[slot];\n    if (!it || !it.affixes?.[index]) return false;\n    const L = h.level;\n    if (h.gold < REFORGE_COST.gold(L) || h.mats.dust < REFORGE_COST.dust) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.gold -= REFORGE_COST.gold(L);\n    h.mats.dust -= REFORGE_COST.dust;\n    const keep = it.affixes.map((a) => a.k);\n    const [fresh] = rollAffixes(w.lootRng, it.slot, 1, it.ilvl, keep);\n    if (fresh) it.affixes[index] = fresh;\n    h.reforged = (h.reforged ?? 0) + 1;\n    recalcHero(w, h);\n    ev(w, { t: 'sfx', k: 'forge' });\n    return true;\n  },\n  extract(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    if (!it.power) return false;\n    h.inv[i] = null;\n    w.account.powers = w.account.powers ?? {};\n    w.account.powers[it.power] = 1;\n    h.extracted = (h.extracted ?? 0) + 1;\n    ev(w, { t: 'extract', seat: h.seat, name: LEGENDARIES[it.power].name });\n    return true;\n  },\n  reliquary(w, h, { group, power }) {\n    if (!['weapon', 'armor', 'jewel'].includes(group)) return false;\n    if (power && (!w.account.powers?.[power] || LEGENDARIES[power].group !== group)) return false;\n    h.reliquary[group] = power ?? null;\n    reequip(w, h);\n    return true;\n  },\n  socket(w, h, { uid, slot, gem, index = 0 }) {\n    const it = uid ? h.inv.find((x) => x?.uid === uid) : h.gear[slot];\n    if (!it || !it.gems || it.gems.length === 0 || !h.gems[gem]) return false;\n    const cost = SOCKET_COST(it.ilvl);\n    if (h.gold < cost) return false;\n    h.gold -= cost;\n    const old = it.gems[index];\n    if (old) h.gems[old] = (h.gems[old] ?? 0) + 1;\n    it.gems[index] = gem;\n    h.gems[gem]--;\n    h.socketed = (h.socketed ?? 0) + 1;\n    recalcHero(w, h);\n    ev(w, { t: 'sfx', k: 'socket' });\n    return true;\n  },\n  unsocket(w, h, { uid, slot, index = 0 }) {\n    const it = uid ? h.inv.find((x) => x?.uid === uid) : h.gear[slot];\n    if (!it?.gems?.[index]) return false;\n    h.gems[it.gems[index]] = (h.gems[it.gems[index]] ?? 0) + 1;\n    it.gems[index] = null;\n    recalcHero(w, h);\n    return true;\n  },\n  merge(w, h, { gem }) {\n    const { kind, tier } = parseGem(gem);\n    if (tier >= 2 || (h.gems[gem] ?? 0) < 3) return false;\n    h.gems[gem] -= 3;\n    const next = gemId(kind, tier + 1);\n    h.gems[next] = (h.gems[next] ?? 0) + 1;\n    h.merged = (h.merged ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'socket' });\n    return true;\n  },\n  stash_put(w, h, { uid, tab }) {\n    const i = invFind(h, uid);\n    const t = w.account.stash[tab];\n    if (i < 0 || !t) return false;\n    const free = t.indexOf(null);\n    if (free < 0) return false;\n    t[free] = h.inv[i];\n    h.inv[i] = null;\n    h.stashed = (h.stashed ?? 0) + 1;\n    return true;\n  },\n  stash_take(w, h, { tab, index }) {\n    const t = w.account.stash[tab];\n    const free = h.inv.indexOf(null);\n    if (!t?.[index] || free < 0) return false;\n    h.inv[free] = t[index];\n    t[index] = null;\n    return true;\n  },\n  skill(w, h, { slot, id }) {\n    if (!slotOpen(h, slot)) return false;\n    if (id && !skillUnlocked(h, id)) return false;\n    if (id) {\n      const other = h.skills.findIndex((s) => s?.id === id);\n      if (other >= 0 && other !== slot) { h.skills[other] = h.skills[slot] ?? null; }\n    }\n    h.skills[slot] = id ? { id, tone: h.toneMemory?.[id] ?? null } : null;\n    h.slotChanged = (h.slotChanged ?? 0) + 1;\n    h.skillCache.clear();\n    if (w.camp) w.camp.skillsSet = (w.camp.skillsSet ?? 0) + 1;\n    return true;\n  },\n  tone(w, h, { id, tone }) {\n    const s = h.skills.find((x) => x?.id === id);\n    if (tone && !toneUnlocked(h, id, tone)) return false;\n    h.toneMemory = h.toneMemory ?? {};\n    h.toneMemory[id] = tone ?? null;\n    if (s) s.tone = tone ?? null;\n    h.skillCache.clear();\n    delete h.charges[id];\n    h.tonesSet = (h.tonesSet ?? 0) + 1;\n    return true;\n  },\n  vow(w, h, { index, id }) {\n    if (h.level < RULES.vowLevels[index]) return false;\n    if (id && !VOWS[h.cls].some((v) => v.id === id)) return false;\n    if (id && h.vows.includes(id)) h.vows[h.vows.indexOf(id)] = null;\n    h.vows[index] = id ?? null;\n    recalcHero(w, h);\n    h.vowsSet = (h.vowsSet ?? 0) + 1;\n    return true;\n  },\n  devotion(w, h, { track, stat }) {\n    const d = w.account.devotion;\n    if (d.points <= 0) return false;\n    d.points--;\n    d.spent[track] = d.spent[track] ?? [0, 0, 0, 0];\n    d.spent[track][stat]++;\n    for (const o of w.heroes) recalcHero(w, o);\n    return true;\n  },\n  devotion_reset(w) {\n    const d = w.account.devotion;\n    for (const k of Object.keys(d.spent)) { for (const n of d.spent[k]) d.points += n; d.spent[k] = [0, 0, 0, 0]; }\n    for (const o of w.heroes) recalcHero(w, o);\n    return true;\n  },\n  talk_done(w, h, { npc }) { onTalkDone(w, h, npc); return true; },\n  travel(w, h, { key, zone, floor }) {\n    const safe = w.zone.def.safe || usableGate(w, h);\n    if (!safe) return false;\n    if (key) return goToGate(w, key);\n    if (!zoneOpen(w, zone)) return false;\n    travel(w, zone, floor ?? 0, 'start');\n    return true;\n  },\n  rise(w, h, { how }) {\n    if (!h.dead) return false;\n    if (how === 'here') {\n      if (h.deadT < (h.deathWait ?? 5)) return false;\n      riseAt(w, h, 'here');\n      return true;\n    }\n    riseAtGate(w, h, how);\n    return true;\n  },\n  difficulty(w, h, { index }) {\n    const d = DIFFICULTIES[index];\n    if (!d) return false;\n    if (d.penance && !w.account.unlocks.penance) return false;\n    w.difficulty = index;\n    w.diffDef = d;\n    ev(w, { t: 'toast', text: `DIFFICULTY: ${d.name}`, color: 'sand' });\n    if (w.camp) w.camp.difficulty = index;\n    return true;\n  },\n  writs(w) { rollWrits(w); return true; },\n  knell_start(w, h, { mods, grand, tier }) {\n    if (!w.account.unlocks.knell) return false;\n    if (grand) {\n      if ((h.grandKeys ?? 0) <= 0) return false;\n      h.grandKeys--;\n    }\n    startRun(w, { mods, grand, tier });\n    return true;\n  },\n  run_home(w) { endRun(w); travel(w, 'town', 0, 'start'); return true; },\n  cycle_use(w, h) { h.useSel = (h.useSel ?? 0) + 1; return true; },\n  pick3(w, h, { i }) { applyRoundPick(w, h, i); return true; },\n  ...devCommands(),\n};\n\nexport const usableGate = (w, h) => w.objects.some((o) => o.kind === 'lychgate' && dist(o.x, o.z, h.x, h.z) < RULES.interactRange + 1);\nexport function zoneOpen(w, zone) {\n  const f = w.camp?.flags ?? {};\n  return { causeway: f.open_causeway, ossuary: f.open_ossuary, cloister: f.open_cloister, belfry: f.open_belfry, pantry: f.overdue_open && w.camp.visited['pantry:0'], town: true, yard: true }[zone] ?? false;\n}\n\n// ---- Dev mode ---------------------------------------------------------------------------------\nfunction devCommands() {\n  return {\n    dev_level(w, h, { n }) { for (let i = 0; i < (n ?? 1) && h.level < RULES.levelCap; i++) levelUp(w, h, true); h.xp = 0; return true; },\n    dev_level_max(w, h) { while (h.level < RULES.levelCap) levelUp(w, h, true); h.xp = 0; return true; },\n    dev_gold(w, h, { n }) { h.gold += n ?? 10000; return true; },\n    dev_mats(w, h) { h.mats.scrap += 50; h.mats.dust += 30; h.mats.shards += 20; h.grandKeys = (h.grandKeys ?? 0) + 3; return true; },\n    dev_item(w, h, { slot, rarity }) {\n      const free = h.inv.indexOf(null);\n      if (free < 0) return false;\n      h.inv[free] = rarity === 'legendary' || rarity === 'set' ? makeRolledItem(w.lootRng, h, rarity, h.level, slot) : makeItem(w.lootRng, { slot, rarity, ilvl: h.level, cls: h.cls });\n      return true;\n    },\n    dev_legendary(w, h, { id }) {\n      const free = h.inv.indexOf(null);\n      if (free < 0) return false;\n      h.inv[free] = makeItem(w.lootRng, { rarity: 'legendary', ilvl: h.level, cls: h.cls, legendary: id });\n      return true;\n    },\n    dev_set(w, h, { set, slot }) {\n      const free = h.inv.indexOf(null);\n      if (free < 0) return false;\n      const s = set ?? SET_BY_CLASS[h.cls];\n      h.inv[free] = makeItem(w.lootRng, { slot: slot ?? 'head', rarity: 'set', ilvl: h.level, cls: h.cls, set: s });\n      return true;\n    },\n    dev_gems(w, h) { for (const k of Object.keys(GEM_KINDS)) for (let t = 0; t < 3; t++) { const id = gemId(k, t); h.gems[id] = (h.gems[id] ?? 0) + 3; } return true; },\n    dev_spawn(w, h, { type, n, elite, aff }) {\n      const def = MONSTERS[type];\n      if (!def) return false;\n      if (elite) {\n        spawnElitePack(w, { x: h.x + h.dirX * 5, z: h.z + h.dirZ * 5 }, null, { kind: elite, type, aff: aff?.length ? aff : ['tolling'] });\n        return true;\n      }\n      for (let i = 0; i < (n ?? 1); i++) { const p = openSpot(w, h.x + h.dirX * 5, h.z + h.dirZ * 5, 2); spawnMonster(w, type, p.x, p.z, { state: 'chase' }); }\n      return true;\n    },\n    dev_boss(w, h, { type }) { const p = openSpot(w, h.x + h.dirX * 6, h.z + h.dirZ * 6, 1); startBoss(w, type, p.x, p.z, { noIntro: true }); return true; },\n    dev_plate(w, h) { const p = openSpot(w, h.x + h.dirX * 5, h.z + h.dirZ * 5, 1); spawnPlate(w, p.x, p.z); return true; },\n    dev_coffin(w, h) { addObject(w, 'coffin', h.x + h.dirX * 2.5, h.z + h.dirZ * 2.5, { time: 45, count: 7, announce: true }); return true; },\n    dev_kill_all(w, h) { for (const m of w.monsters) if (!m.dead) killMonster(w, m, h, {}); return true; },\n    dev_goto(w, h, { zone, floor }) { travel(w, zone, floor ?? 0, 'start'); return true; },\n    dev_quest(w, h, { i, s }) {\n      w.camp.q.i = i; w.camp.q.s = s ?? 0;\n      w.camp.flags.open_causeway = i >= 1 ? 1 : w.camp.flags.open_causeway;\n      w.camp.flags.open_ossuary = i >= 2 ? 1 : w.camp.flags.open_ossuary;\n      w.camp.flags.open_cloister = i >= 3 ? 1 : w.camp.flags.open_cloister;\n      w.camp.flags.open_belfry = i >= 4 ? 1 : w.camp.flags.open_belfry;\n      if (i >= 2) { w.camp.flags.forge = 1; w.camp.flags.brasse_met = 1; w.camp.flags.brasse_home = 1; w.camp.flags.pyx = 1; }\n      if (i >= 3) { w.camp.flags.reliquary = 1; }\n      ev(w, { t: 'quest', name: 'DEV', text: `QUEST ${i}.${s ?? 0}`, id: 'dev' });\n      return true;\n    },\n    dev_knell_fill(w) { if (w.run?.state === 'fill') { w.run.meter = w.run.total - 1; ev(w, { t: 'knell', v: w.run.meter, of: w.run.total }); return true; } return false; },\n    dev_knell_start(w, h) { w.account.unlocks.knell = true; w.account.unlocks.penance = true; startRun(w, {}); return true; },\n    dev_next_phase(w) {\n      const m = w.boss;\n      if (!m) return false;\n      const b = m.bossState;\n      if (m.def.boss === 'malison') { m.hp = b.phase === 1 ? m.maxHp * 0.59 : m.maxHp * 0.24; return true; }\n      m.hp = Math.max(1, m.hp - m.maxHp * 0.5);\n      return true;\n    },\n    dev_reveal(w) { w.zone.seen.fill(1); return true; },\n    dev_reroll(w, h, { seed }) { w.rerollSeed = seed; return true; },\n    dev_scale(w, h, { k, v }) { w.tuning[k] = v; for (const o of w.heroes) recalcHero(w, o); return true; },\n    dev_cheat(w, h, { k, v }) { w.cheats[k] = v; return true; },\n    dev_revive(w, h) { for (const o of w.heroes) if (o.dead) reviveHero(w, o, 1); return true; },\n  };\n}\n\nexport { AFFIXES, SETS, SLOTS, SOCKETABLE, SKILLS, CLASSES, RARITIES, itemValue, gainXp, addHero, newHeroData, ensurePyx, monsterLevel, toast, WARDENS, buyPrice, sellPrice };\nEOF\ncat > src/sim/world.js <<'EOF'\n// The world: one object for a whole session, one step function. Solo is a party of one.\nimport { Rng } from '../../pixel-engine.js';\nimport { defaultTuning, DIFFICULTIES, RULES } from '../data/tuning.js';\nimport { DT, dist, ev } from './core.js';\nimport { spawnArea, stepObstacles, stepSched, endShot, spawnShot, gainRes, healHero, resolveSkill, applyHit, runOps, addBuff } from './effects.js';\nimport { stepEnemyArea } from './hazards.js';\nimport { addHero, heroToData, hurtHero, stepHero, stepRevives } from './hero.js';\nimport { EMPTY_INTENT } from './intents.js';\nimport { stepDrops } from './loot.js';\nimport { damageMonster, stepAllies, stepMonsters, monsterLevel } from './monsters.js';\nimport { stepObjects } from './objects.js';\nimport { newCampaign, questInit, stepQuests } from './quests.js';\nimport { stepRound } from './round.js';\nimport { loadZone, riseAtGate } from './travel.js';\nimport { computeHit } from './effects.js';\n\nexport function newAccount() {\n  return {\n    stash: Array.from({ length: RULES.stashTabs }, () => Array(RULES.stashSize).fill(null)),\n    devotion: { level: 0, xp: 0, points: 0, spent: { core: [0, 0, 0, 0], offence: [0, 0, 0, 0], defence: [0, 0, 0, 0], utility: [0, 0, 0, 0] } },\n    unlocks: { knell: false, penance: false }, bests: {}, powers: {},\n  };\n}\n\nexport function createWorld(o = {}) {\n  const seed = o.seed ?? 1;\n  const w = {\n    seed, root: new Rng(seed), t: 0, time: 0, nextId: 1, tuning: { ...defaultTuning(), ...(o.tuning ?? {}) }, difficulty: o.difficulty ?? 0, diffDef: DIFFICULTIES[o.difficulty ?? 0],\n    heroes: [], monsters: [], allies: [], shots: [], areas: [], drops: [], objects: [], props: [], graves: [], obstacles: [], sched: [], events: [], hash: new Map(), zone: null, boss: null, coffin: null,\n    cheats: { god: false, oneHit: false, noCd: false, infRes: false, noClip: false, invisible: false }, account: o.account ?? newAccount(), camp: o.camp === undefined ? newCampaign() : o.camp, run: null, round: null, pendingZone: null, graveLife: RULES.graveLife,\n    mode: o.mode ?? 'campaign',\n  };\n  w.rng = w.root.fork('sim');\n  w.lootRng = w.root.fork('loot');\n  w.resolveSkillOp = (h, id, tone) => resolveSkill(h, id, tone).fx[0];\n  return w;\n}\n\nexport function stepWorld(w, intents = []) {\n  w.t++;\n  w.time = w.t * DT;\n  stepRound(w);\n  stepHeroAreas(w);\n  for (const h of w.heroes) stepHero(w, h, intents[h.seat] ?? EMPTY_INTENT);\n  stepRevives(w, intents);\n  stepMonsters(w);\n  stepAllies(w);\n  stepShots(w);\n  stepAreas(w);\n  stepObstacles(w);\n  stepSched(w);\n  stepDrops(w);\n  stepObjects(w);\n  stepGraves(w);\n  stepQuests(w);\n  markSeen(w);\n  if (w.pendingRise) { const pr = w.pendingRise; w.pendingRise = null; const h = w.heroes.find((o) => o.seat === pr.seat); if (h) riseAtGate(w, h, pr.how); }\n  if (w.pendingZone) {\n    const p = w.pendingZone;\n    w.pendingZone = null;\n    loadZone(w, p.zone, p.floor, p.entry);\n  }\n}\n\nfunction stepGraves(w) {\n  for (let i = w.graves.length - 1; i >= 0; i--) {\n    const g = w.graves[i];\n    g.t -= DT;\n    if (g.t <= 0) { ev(w, { t: 'gravex', id: g.id }); w.graves.splice(i, 1); }\n  }\n}\n\nfunction stepHeroAreas(w) {\n  for (const h of w.heroes) { h.areaDr = 0; h.areaDmg = 0; h.areaRegen = 0; h.areaStun = false; }\n  for (const m of w.monsters) { m.slowFromArea = 0; m.vuln = 0; }\n  for (const a of w.areas) {\n    if (a.team === 1) continue;\n    if (!(a.allyDr || a.allyDmg || a.allyRegen || a.allyStunImmune || a.enemySlow || a.enemyVuln)) continue;\n    for (const h of w.heroes) {\n      if (h.dead || h.gone || dist(h.x, h.z, a.x, a.z) > a.r) continue;\n      h.areaDr = Math.max(h.areaDr, a.allyDr); h.areaDmg = Math.max(h.areaDmg, a.allyDmg); h.areaRegen = Math.max(h.areaRegen, a.allyRegen);\n      if (a.allyStunImmune) h.areaStun = true;\n    }\n    if (a.enemySlow || a.enemyVuln) {\n      for (const m of w.monsters) {\n        if (m.dead || dist(m.x, m.z, a.x, a.z) > a.r + m.r) continue;\n        m.slowFromArea = Math.max(m.slowFromArea, a.enemySlow); m.vuln = Math.max(m.vuln, a.enemyVuln);\n      }\n    }\n  }\n}\n\nfunction stepShots(w) {\n  for (let i = w.shots.length - 1; i >= 0; i--) {\n    const s = w.shots[i];\n    s.life -= DT;\n    if (s.tgt) {\n      const t = w.monsters.find((m) => m.id === s.tgt && !m.dead);\n      if (t) {\n        const dx = t.x - s.x, dz = t.z - s.z, l = Math.hypot(dx, dz) || 1;\n        s.vx += ((dx / l) * s.speed - s.vx) * 0.12;\n        s.vz += ((dz / l) * s.speed - s.vz) * 0.12;\n      }\n    }\n    s.x += s.vx * DT;\n    s.z += s.vz * DT;\n    if (s.life <= 0 || !w.zone.nav.walkable(s.x, s.z) && !isPit(w, s.x, s.z)) { endShot(w, i, s, false); continue; }\n    if (s.team === 1) {\n      if (w.areas.some((a) => a.stopsShots && dist(a.x, a.z, s.x, s.z) <= a.r)) { endShot(w, i, s, false); continue; }\n      let hit = false;\n      for (const h of w.heroes) {\n        if (h.dead || h.gone || dist(h.x, h.z, s.x, s.z) > h.r + s.r) continue;\n        if (h.state === 'dodge' || h.invuln > 0) continue;\n        hurtHero(w, h, s.dmg, { src: null, el: s.el });\n        hit = true;\n        break;\n      }\n      if (hit) { endShot(w, i, s, true); continue; }\n      continue;\n    }\n    const h = w.heroes.find((o) => o.id === s.owner);\n    if (!h) { endShot(w, i, s, false); continue; }\n    let done = false;\n    for (const m of w.monsters) {\n      if (m.dead || m.hidden || (s.hit && s.hit.has(m.id))) continue;\n      const rr = s.r + m.r;\n      if ((m.x - s.x) ** 2 + (m.z - s.z) ** 2 > rr * rr) continue;\n      const c = { x: s.x - s.vx * 0.02, z: s.z - s.vz * 0.02, dx: s.vx / s.speed, dz: s.vz / s.speed, sk: s.sk ?? null, mult: s.mult, kills: 0 };\n      applyHit(w, h, m, s.op, c);\n      if (s.op?.forkOnKill && c.kills > 0) {\n        const n = s.op.forkOnKill;\n        const base = Math.atan2(s.vz, s.vx);\n        for (let k = 0; k < n; k++) {\n          const a = base + (k === 0 ? -0.5 : 0.5);\n          const fork = spawnShot(w, { owner: h.id, team: 0, kind: s.kind, x: s.x, z: s.z, dx: Math.cos(a), dz: Math.sin(a), speed: s.speed, range: 10, op: { ...s.op, forkOnKill: 0 }, sk: s.sk });\n          fork.hit = new Set([m.id]);\n        }\n      }\n      if (s.pierce > 0) { s.pierce--; (s.hit ??= new Set()).add(m.id); }\n      else { done = true; }\n      break;\n    }\n    if (done) { endShot(w, i, s, true); continue; }\n    if (w.props.length) {\n      for (const p of w.props) {\n        if (p.broken || (p.x - s.x) ** 2 + (p.z - s.z) ** 2 > 0.5) continue;\n        import_breakProp(w, p, s.x, s.z, h);\n        endShot(w, i, s, true);\n        done = true;\n        break;\n      }\n    }\n  }\n}\n\nimport { breakProp as import_breakProp } from './objects.js';\n\nconst isPit = (w, x, z) => {\n  const row = w.zone.rows[Math.floor(z)];\n  const ch = row?.[Math.floor(x)];\n  return ch === '~';\n};\n\nfunction stepAreas(w) {\n  for (let i = w.areas.length - 1; i >= 0; i--) {\n    const a = w.areas[i];\n    if (a.team === 1) { stepEnemyArea(w, a, i); continue; }\n    a.t += DT;\n    if (a.follow) { const h = w.heroes.find((o) => o.id === a.follow); if (h && !h.dead) { a.x = h.x; a.z = h.z; ev2follow(w, a); } }\n    if (a.followTarget) {\n      const m = w.monsters.find((o) => o.id === a.followTarget && !o.dead);\n      if (m) { a.x = m.x; a.z = m.z; ev2follow(w, a); }\n    }\n    if (a.t >= a.nextTick) {\n      a.nextTick += a.tick;\n      const h = a.h;\n      if (a.dmg && h && !h.gone) {\n        for (const m of w.monsters) {\n          if (m.dead || m.hidden || dist(m.x, m.z, a.x, a.z) > a.r + m.r) continue;\n          const [d, crit] = computeHit(w, h, m, a.dmg, a.el, null);\n          damageMonster(w, m, d, { src: h, crit, el: a.el, dot: true });\n        }\n      }\n      if (a.drag) for (const m of w.monsters) {\n        if (m.dead || m.def.static || m.def.huge || dist(m.x, m.z, a.x, a.z) > a.r + 1) continue;\n        const dx = a.x - m.x, dz = a.z - m.z, l = Math.hypot(dx, dz) || 1;\n        m.kx += (dx / l) * a.drag; m.kz += (dz / l) * a.drag;\n      }\n      if (a.allyHeal) for (const o of w.heroes) if (!o.dead && !o.gone && dist(o.x, o.z, a.x, a.z) <= a.r) healHero(w, o, a.allyHeal * a.tick);\n    }\n    if (a.t >= a.life) {\n      w.areas.splice(i, 1);\n      ev(w, { t: 'areax', id: a.id });\n      if (a.endBlast && a.h && !a.h.gone) runOps(w, a.h, [{ op: 'ring', radius: a.endBlast.radius, dmg: a.endBlast.dmg, el: a.endBlast.el, vfx: 'fire_burst', sfx: 'blast', shake: 0.4, wave: true }], { x: a.x, z: a.z, dx: 0, dz: 1, sk: null });\n    }\n  }\n}\n\nfunction ev2follow(w, a) { if (w.t % 6 === 0) ev(w, { t: 'areamove', id: a.id, x: a.x, z: a.z }); }\n\nfunction markSeen(w) {\n  if (w.t % 20 !== 0) return;\n  const z = w.zone;\n  for (const h of w.heroes) {\n    if (h.gone) continue;\n    const cx = Math.floor(h.x), cz = Math.floor(h.z), R = 12;\n    for (let j = Math.max(0, cz - R); j <= Math.min(z.h - 1, cz + R); j++) {\n      for (let i = Math.max(0, cx - R); i <= Math.min(z.w - 1, cx + R); i++) {\n        if ((i - cx) ** 2 + (j - cz) ** 2 <= R * R) z.seen[j * z.w + i] = 1;\n      }\n    }\n  }\n}\n\n/** The save-relevant state of a hero and campaign. */\nexport function worldHash(w) {\n  let s = `${w.t}|${w.zone?.id}|${w.zone?.floor}|${w.nextId}|${w.rng.state}|${w.lootRng.state}`;\n  for (const h of w.heroes) s += `|${h.x.toFixed(3)},${h.z.toFixed(3)},${h.hp.toFixed(2)},${h.level},${Math.round(h.xp)},${h.gold}`;\n  s += `|m${w.monsters.length}`;\n  for (const m of w.monsters) s += `,${m.x.toFixed(2)},${m.z.toFixed(2)},${Math.round(m.hp)}`;\n  let hash = 5381;\n  for (let i = 0; i < s.length; i++) hash = ((hash * 33) ^ s.charCodeAt(i)) >>> 0;\n  return hash.toString(16);\n}\n\nexport function beginCampaign(w, heroDatas, o = {}) {\n  heroDatas.forEach((d, seat) => addHero(w, d, seat, { navIndex: seat }));\n  const start = o.zone ?? 'yard';\n  loadZone(w, start, o.floor ?? 0, 'start');\n  if (!o.noQuestInit) questInit(w);\n}\n\nexport { heroToData, addHero, loadZone, monsterLevel, spawnArea, gainRes, addBuff };\nEOF\ncat > .scratch/simtest.mjs <<'EOF'\nimport { createWorld, stepWorld, beginCampaign } from '../src/sim/world.js';\nimport { newHeroData } from '../src/sim/hero.js';\nconst w = createWorld({seed: 7});\nbeginCampaign(w,[newHeroData('bellwarden','TEST')]);\nfor (let i=0;i<600;i++){ stepWorld(w,[{mx:1,mz:0,ax:0,az:0,aimed:0,tgt:0,held:1,pressed:0,goal:null}]); w.events.length=0; }\nconsole.log(w.zone.id,w.t,w.heroes[0].x,w.heroes[0].level,w.monsters.length, w.heroes[0].hp);\nprocess.exit(0);\nEOF\ntimeout 60 node .scratch/simtest.mjs 2>&1 | tail -n 12 | cut -c1-400","description":"Write bosses, quests, knell, round, commands, world and smoke test","timeout":90000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13682,"cache_read_input_tokens":368240,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13682},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"2cac9eb6-511f-48ee-b816-6dbb21be8a7e","timestamp":"2026-11-05T23:57:59.774Z","request_id":"req_011CgkgPEFtAY5dmeYHmT59V","wire_tool_inputs":{"toolu_0134JXbVbiHjRo5tf3cQjKnF":{"command":"sed -i \"s/Oh, for pity is sake\\./Oh, for pity's sake./\" src/data/dialog.js\nsed -i \"s/'Oh, for pity's sake.'/\\\"Oh, for pity's sake.\\\"/\" src/data/dialog.js\ncat > src/sim/bosses.js <<'EOF'\n// Scripted bosses. Every big attack telegraphs and can be rolled through.\nimport { STORY_LINES } from '../data/dialog.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { DT, dist, ev, say, setCellOpen, slide, toast, walkable } from './core.js';\nimport { hurtHero } from './hero.js';\nimport { dropGold, dropItem, goldAt, makeRolledItem, spawnDrop } from './loot.js';\nimport { facingOf, monsterSpeed, nearestHero, openSpot, spawnMonster, killMonster } from './monsters.js';\nimport { spawnEnemyArea, spawnWave, telegraphLine, telegraphRing } from './hazards.js';\nimport { addObject, setObjectState } from './objects.js';\nimport { onBossKilled } from './quests.js';\n\nexport function startBoss(w, type, x, z, o = {}) {\n  const def = MONSTERS[type];\n  const m = spawnMonster(w, type, x, z, { state: 'chase', knellPts: 0, ...o });\n  m.bossState = { phase: 1, t: 0, audit: 4, sweep: 8, adds: 12, lash: 2.5, wave: 5, taunt: 8, swing: 0, round: 1, ...(o.state0 ?? {}) };\n  w.boss = m;\n  ev(w, { t: 'boss', id: m.id, name: def.title, song: def.song ?? '', phases: PHASES[def.boss] ?? [], k: type, intro: o.noIntro ? 0 : 1 });\n  bossScripts[def.boss]?.init?.(w, m, m.bossState);\n  return m;\n}\n\nexport const PHASES = { malison: [0.6, 0.25], bursar: [0.3], ambrose: [], warden_sexton: [0.5], warden_chorister: [0.5], warden_jaw: [0.5], cellarer: [] };\n\nfunction chase(w, m, t, mul = 1, stopAt = 0.5) {\n  const dx = t.x - m.x, dz = t.z - m.z, l = Math.hypot(dx, dz) || 1;\n  m.facing = facingOf(dx, dz);\n  if (l <= m.r + stopAt) return false;\n  const speed = monsterSpeed(m) * mul * DT;\n  let ux = dx / l, uz = dz / l;\n  if (!w.zone.nav.lineOfSight(m.x, m.z, t.x, t.z)) {\n    const out = [0, 0];\n    if (w.zone.navs[t.navIndex ?? 0]?.flowDirection(m.x, m.z, out)) { ux = out[0]; uz = out[1]; }\n  }\n  slide(w, m, ux * speed, uz * speed, Math.min(m.r, 0.8));\n  m.moving = true;\n  return true;\n}\n\nfunction taunt(w, m, b, lines, who, every = 22) {\n  b.taunt -= DT;\n  if (b.taunt <= 0) { b.taunt = every; say(w, who, w.rng.pick(lines)); }\n}\n\nfunction melee(w, m, b, t, r = 3, windup = 0.7, mul = 1) {\n  b.swing -= DT;\n  if (b.swing <= 0 && dist(m.x, m.z, t.x, t.z) < m.r + r) {\n    b.swing = windup + 1.2;\n    ev(w, { t: 'mcast', id: m.id, clip: m.def.clipAttack ?? 'Slam', sp: 0.6 / windup });\n    const fx = Math.sin(m.facing), fz = Math.cos(m.facing);\n    telegraphRing(w, m.x + fx * m.r, m.z + fz * m.r, r, windup, m.dmg * mul, { src: m, vfx: 'dust_ring', sfx: 'stone_hit', shake: 0.3 });\n    return true;\n  }\n  return false;\n}\n\nconst bossScripts = {\n  // THE BURSAR -----------------------------------------------------------------------------\n  bursar: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      taunt(w, m, b, STORY_LINES.bursar_lines, 'bursar');\n      if (b.wait > 0) { b.wait -= DT; return; }\n      chase(w, m, t, 1, 1.5);\n      melee(w, m, b, t, 3.2, 0.8, 1.1);\n      b.audit -= DT;\n      if (b.audit <= 0) {\n        b.audit = 9;\n        ev(w, { t: 'mcast', id: m.id, clip: 'CastBig', sp: 0.7 });\n        say(w, 'bursar', 'AUDIT!');\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          telegraphRing(w, h.x, h.z, 2.5, 2, m.dmg * 1.6, { src: m, vfx: 'ledger_slam', sfx: 'coffin_slam', shake: 0.4, knock: 1 });\n        }\n      }\n      b.sweep -= DT;\n      if (b.sweep <= 0) {\n        b.sweep = 14;\n        const l = Math.hypot(t.x - m.x, t.z - m.z) || 1;\n        const dx = (t.x - m.x) / l, dz = (t.z - m.z) / l;\n        ev(w, { t: 'mcast', id: m.id, clip: 'Slash3', sp: 0.7 });\n        telegraphLine(w, m.x, m.z, dx, dz, 10, 5, 1, m.dmg * 0.9, {\n          src: m, vfx: 'sweep', sfx: 'coins', shake: 0.3,\n          onHit: (h) => {\n            const take = Math.floor(h.gold * 0.1);\n            if (take <= 0) return;\n            h.gold -= take;\n            const piles = Math.min(12, take);\n            for (let i = 0; i < piles; i++) {\n              const p = openSpot(w, h.x, h.z, 4);\n              spawnDrop(w, { kind: 'coin', amount: Math.max(1, Math.round(take / piles)), x: p.x, z: p.z, owner: h.seat });\n            }\n            say(w, 'bursar', 'COLLECTIONS!');\n          },\n        });\n      }\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 18;\n        say(w, 'bursar', 'A SMALL ADJUSTMENT!');\n        ev(w, { t: 'mcast', id: m.id, clip: 'RaiseHands', sp: 0.8 });\n        for (let i = 0; i < 4; i++) { const p = openSpot(w, m.x, m.z, 5); spawnMonster(w, 'rattlebones', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true, name: 'CLERK' }); }\n      }\n      if (!b.foreclosed && m.hp < m.maxHp * 0.3) {\n        b.foreclosed = true;\n        b.closing = 0;\n        b.ring = 0;\n        b.closed = [];\n        say(w, 'bursar', 'FORECLOSURE!');\n        ev(w, { t: 'mcast', id: m.id, clip: 'Shout', sp: 0.7 });\n      }\n      if (b.foreclosed) {\n        b.closing -= DT;\n        if (b.closing <= 0 && b.ring < 5) { b.closing = 4; closeRing(w, m, b); }\n      }\n    },\n    died(w, m, b) { reopenAll(w, b); },\n  },\n\n  // BISHOP AMBROSE -------------------------------------------------------------------------\n  ambrose: {\n    step(w, m, b) {\n      if (b.buried > 0) {\n        b.buried -= DT;\n        if (b.buried <= 0) {\n          const t = nearestHero(w, m);\n          let px = m.x, pz = m.z;\n          for (let i = 0; i < 16 && t; i++) { const p = openSpot(w, b.cx, b.cz, 8); if (dist(p.x, p.z, t.x, t.z) > 4) { px = p.x; pz = p.z; break; } }\n          m.x = px; m.z = pz;\n          m.hidden = false; m.invuln = false;\n          ev(w, { t: 'unhide', id: m.id, x: px, z: pz });\n          ev(w, { t: 'fx', k: 'grave_burst', s: 'coffin_slam', sh: 0.5, wv: 1, x: px, z: pz, r: 3 });\n          ev(w, { t: 'mcast', id: m.id, clip: 'GetUp', sp: 1 });\n          say(w, 'ambrose', b.round === 2 ? 'ONE LEARNS TO KEEP A SPADE IN THE COFFIN.' : 'TWICE MORE. I HAVE PRACTISED.');\n        }\n        return;\n      }\n      const t = nearestHero(w, m);\n      if (!t) return;\n      taunt(w, m, b, STORY_LINES.ambrose_lines, 'ambrose', 18);\n      chase(w, m, t, 1, 3);\n      melee(w, m, b, t, 2.4, 0.6, 0.9);\n      b.lash -= DT;\n      if (b.lash <= 0) {\n        b.lash = 4 - b.round * 0.5;\n        ev(w, { t: 'mcast', id: m.id, clip: 'CastWeapon', sp: 1 });\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          const l = Math.hypot(h.x - m.x, h.z - m.z) || 1;\n          telegraphLine(w, m.x, m.z, (h.x - m.x) / l, (h.z - m.z) / l, Math.min(14, l + 3), 1.1, 0.8, m.dmg * 0.8, { src: m, vfx: 'chain_line', sfx: 'chain', root: 1 });\n        }\n      }\n      b.wave -= DT;\n      if (b.wave <= 0) {\n        b.wave = 7;\n        ev(w, { t: 'mcast', id: m.id, clip: 'CastBig', sp: 1 });\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          telegraphRing(w, h.x, h.z, 2.4, 1, m.dmg * 0.5, { src: m, vfx: 'poison_burst', sfx: 'burst_wet', pool: { kind: 'poison_pool', r: 2.4, life: 5, tick: 0.5, dps: m.dmg * 0.25 } });\n        }\n      }\n      if (b.round >= 2) {\n        b.adds -= DT;\n        if (b.adds <= 0) {\n          b.adds = 13;\n          say(w, 'ambrose', 'COME, PENITENTS. COME AND BE FORGIVEN.');\n          for (let i = 0; i < 2 + w.heroes.length; i++) { const p = openSpot(w, m.x, m.z, 6); spawnMonster(w, 'penitent', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true }); }\n        }\n      }\n      if (b.round >= 3) {\n        b.ring = (b.ring ?? 3) - DT;\n        if (b.ring <= 0) {\n          b.ring = 6;\n          ev(w, { t: 'mcast', id: m.id, clip: 'Shout', sp: 1 });\n          spawnWave(w, m.x, m.z, { speed: 6, maxR: 16, thick: 0.8, dmg: m.dmg * 1.1, el: 'flame', gapA: w.rng.range(-3.14, 3.14), gapW: 0.9 });\n        }\n      }\n    },\n    damaged(w, m, b) {\n      if (m.hp > 0 || b.round >= 3) return;\n      b.round++;\n      m.hp = m.maxHp;\n      m.dmg *= 1.25;\n      m.invuln = true;\n      m.hidden = true;\n      m.status = {};\n      b.buried = 2.2;\n      b.cx = m.x; b.cz = m.z;\n      ev(w, { t: 'hide', id: m.id, x: m.x, z: m.z, coffin: 1 });\n      ev(w, { t: 'obj_fall', k: 'coffin', x: m.x, z: m.z });\n      ev(w, { t: 'fx', k: 'dust_ring', s: 'coffin_slam', sh: 0.6, wv: 1, x: m.x, z: m.z, r: 3 });\n      ev(w, { t: 'boss_round', id: m.id, round: b.round });\n    },\n  },\n\n  // MALISON --------------------------------------------------------------------------------\n  malison: {\n    init(w, m, b) {\n      b.cx = m.x; b.cz = m.z;\n      b.pillars = (w.zone.pillars ?? []).map((p) => ({ x: p.x, z: p.z, hp: 2, col: Math.floor(p.x), row: Math.floor(p.z) }));\n      b.toll = 15; b.crumble = 6; b.lash = 3; b.wave = 6; b.adds = 16; b.pits = [];\n    },\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      const pct = m.hp / m.maxHp;\n      if (b.phase === 1 && pct <= 0.6) enterPhase2(w, m, b);\n      if (b.phase === 2 && pct <= 0.25) enterPhase3(w, m, b);\n      b.ropeSway = (b.ropeSway ?? 0) + DT;\n      m.facing = facingOf(t.x - m.x, t.z - m.z);\n      if (b.stagger > 0) { b.stagger -= DT; return; }\n      taunt(w, m, b, STORY_LINES.malison_lines, 'malison', 24);\n      if (b.phase < 3) {\n        // Hold the middle, near enough, and work.\n        chase(w, m, { x: b.cx, z: b.cz, navIndex: 0 }, 0.5, 1);\n        b.lash -= DT;\n        if (b.lash <= 0) {\n          b.lash = b.phase === 1 ? 3.2 : 2.6;\n          ev(w, { t: 'mcast', id: m.id, clip: 'lash', sp: 1 });\n          for (const h of w.heroes) {\n            if (h.dead || h.gone) continue;\n            const base = Math.atan2(h.z - m.z, h.x - m.x);\n            for (const off of [-0.45, 0, 0.45]) {\n              const a = base + off;\n              telegraphLine(w, m.x, m.z, Math.cos(a), Math.sin(a), 18, 1.3, 1, m.dmg * 0.9, { src: m, vfx: 'rope_lash', sfx: 'whip', shake: 0.15, knock: 1.5 });\n            }\n          }\n        }\n        b.wave -= DT;\n        if (b.wave <= 0) {\n          b.wave = b.phase === 1 ? 7 : 9;\n          ev(w, { t: 'mcast', id: m.id, clip: 'scream', sp: 1 });\n          ev(w, { t: 'sfx', k: 'bell_cracked', x: m.x, z: m.z });\n          spawnWave(w, m.x, m.z, { speed: 6.5, maxR: 20, thick: 0.8, dmg: m.dmg * 1.2, el: 'sound', gapA: w.rng.range(-3.14, 3.14), gapW: 1.1 });\n        }\n        b.adds -= DT;\n        if (b.adds <= 0) {\n          b.adds = 16;\n          for (let i = 0; i < 3; i++) { const p = openSpot(w, m.x, m.z, 10); spawnMonster(w, 'rattlebones', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true }); }\n          const q = openSpot(w, m.x, m.z, 10);\n          spawnMonster(w, 'penitent', q.x, q.z, { state: 'chase', from: 'ground', noXp: true, summoned: true });\n        }\n      }\n      if (b.phase === 2) {\n        b.crumble -= DT;\n        if (b.crumble <= 0) {\n          b.crumble = 6;\n          crumbleCell(w, m, b, t);\n        }\n        b.toll -= DT;\n        if (b.toll <= 2.5 && !b.tollWarned) {\n          b.tollWarned = true;\n          ev(w, { t: 'toll_warn', d: 2.5 });\n          toast(w, 'THE BELL TOLLS. GET BEHIND A PILLAR', 'red', { big: 1 });\n        }\n        if (b.toll <= 0) {\n          b.toll = 15;\n          b.tollWarned = false;\n          bellToll(w, m, b);\n        }\n      }\n      if (b.phase === 3) {\n        chase(w, m, t, 1.1, 0.6);\n        // Her touch is terrible.\n        b.touch = (b.touch ?? 0) - DT;\n        if (b.touch <= 0) {\n          for (const h of w.heroes) {\n            if (h.dead || h.gone) continue;\n            if (dist(m.x, m.z, h.x, h.z) < m.r + 1.2) {\n              b.touch = 1.2;\n              hurtHero(w, h, m.dmg * 2.2, { src: m, knockFrom: m, knock: 3 });\n              ev(w, { t: 'fx', k: 'dust_ring', s: 'stone_hit', sh: 0.4, x: h.x, z: h.z, r: 2 });\n              break;\n            }\n          }\n        }\n        b.lash -= DT;\n        if (b.lash <= 0) {\n          b.lash = 4;\n          for (const h of w.heroes) {\n            if (h.dead || h.gone) continue;\n            const l = Math.hypot(h.x - m.x, h.z - m.z) || 1;\n            telegraphLine(w, m.x, m.z, (h.x - m.x) / l, (h.z - m.z) / l, 16, 1.4, 1, m.dmg * 0.8, { src: m, vfx: 'rope_lash', sfx: 'whip', shake: 0.15 });\n          }\n        }\n      }\n    },\n    damaged(w, m, b) {\n      // In the last phase only the bell can finish her.\n      if (b.phase === 3 && (b.rings ?? 0) < 3 && m.hp < m.maxHp * 0.02) m.hp = m.maxHp * 0.02;\n    },\n    died(w, m, b) { reopenAll(w, b); },\n  },\n\n  // THE CELLARER ---------------------------------------------------------------------------\n  cellarer: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      chase(w, m, t, 1, 1);\n      melee(w, m, b, t, 2.6, 0.7, 1);\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 12;\n        say(w, 'cellarer', 'THE HERRING HAS TURNED!');\n        for (let i = 0; i < 4; i++) { const p = openSpot(w, m.x, m.z, 5); spawnMonster(w, 'peatwalker', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true }); }\n      }\n      b.audit -= DT;\n      if (b.audit <= 0) {\n        b.audit = 7;\n        ev(w, { t: 'mcast', id: m.id, clip: 'Slam', sp: 0.8 });\n        telegraphRing(w, t.x, t.z, 2.4, 1, m.dmg, { src: m, vfx: 'poison_burst', sfx: 'burst_wet', pool: { kind: 'poison_pool', r: 2.4, life: 5, tick: 0.5, dps: m.dmg * 0.25 } });\n      }\n    },\n    died(w, m) {\n      addObject(w, 'book', m.x + 1, m.z, { lore: null, key: 'overdue_book', label: 'THE OVERDUE BOOK', announce: true });\n    },\n  },\n\n  // KNELL WARDENS ---------------------------------------------------------------------------\n  warden_sexton: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      if (b.phase === 1 && m.hp < m.maxHp * 0.5) { b.phase = 2; say2(w, m, 'THE PLOT THICKENS.'); }\n      chase(w, m, t, 1, 1);\n      melee(w, m, b, t, 2.8, 0.7, 1.1);\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 10;\n        ev(w, { t: 'mcast', id: m.id, clip: 'RaiseHands', sp: 1 });\n        ev(w, { t: 'sfx', k: 'raise', x: m.x, z: m.z });\n        for (let i = 0; i < 5; i++) { const p = openSpot(w, m.x, m.z, 7); spawnMonster(w, 'rattlebones', p.x, p.z, { state: 'chase', from: 'ground', noXp: true, summoned: true, knellPts: 0 }); }\n      }\n      if (b.phase === 2) {\n        b.audit -= DT;\n        if (b.audit <= 0) {\n          b.audit = 5;\n          for (let i = 0; i < 5; i++) { const p = openSpot(w, t.x, t.z, 6); telegraphRing(w, p.x, p.z, 1.8, 1, m.dmg, { src: m, vfx: 'dust_ring', sfx: 'coffin_slam', shake: 0.15 }); ev(w, { t: 'obj_fall', k: 'coffin', x: p.x, z: p.z, delay: 0.7 }); }\n        }\n      }\n    },\n  },\n  warden_chorister: {\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      if (b.phase === 1 && m.hp < m.maxHp * 0.5) { b.phase = 2; say2(w, m, 'AND AGAIN, FROM THE TOP.'); }\n      chase(w, m, t, 0.9, 5);\n      b.wave -= DT;\n      if (b.wave <= 0) {\n        b.wave = b.phase === 2 ? 3.5 : 5;\n        ev(w, { t: 'sfx', k: 'sour_note', x: m.x, z: m.z });\n        spawnWave(w, m.x, m.z, { speed: 6, maxR: 16, thick: 0.8, dmg: m.dmg, el: 'sound', gapA: w.rng.range(-3.14, 3.14), gapW: 1.1 });\n      }\n      b.adds -= DT;\n      if (b.adds <= 0) {\n        b.adds = 11;\n        for (let i = 0; i < 4; i++) { const p = openSpot(w, m.x, m.z, 6); spawnMonster(w, 'choir_skull', p.x, p.z, { state: 'chase', noXp: true, summoned: true, knellPts: 0 }); }\n      }\n      b.lash -= DT;\n      if (b.lash <= 0) {\n        b.lash = 3;\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          telegraphRing(w, h.x, h.z, 2, 1, m.dmg * 0.8, { src: m, vfx: 'ring_bronze', sfx: 'bell_small' });\n        }\n      }\n    },\n  },\n  warden_jaw: {\n    init(w, m, b) { b.charge = 3; b.state = 'walk'; },\n    step(w, m, b) {\n      const t = nearestHero(w, m);\n      if (!t) return;\n      if (b.phase === 1 && m.hp < m.maxHp * 0.5) { b.phase = 2; ev(w, { t: 'sfx', k: 'roar', x: m.x, z: m.z }); }\n      if (b.state === 'roar') {\n        b.t -= DT;\n        if (b.t <= 0) { b.state = 'charge'; b.left = 14; }\n        return;\n      }\n      if (b.state === 'charge') {\n        const step = (b.phase === 2 ? 13 : 10) * DT;\n        const x0 = m.x, z0 = m.z;\n        slide(w, m, b.dx * step, b.dz * step, 0.8);\n        b.left -= step;\n        for (const h of w.heroes) {\n          if (h.dead || h.gone) continue;\n          if (dist(h.x, h.z, m.x, m.z) < m.r + 0.5 && (h.jawT ?? 0) <= w.time) { h.jawT = w.time + 1; hurtHero(w, h, m.dmg * 1.4, { src: m, knockFrom: m, knock: 3 }); }\n        }\n        if (Math.hypot(m.x - x0, m.z - z0) < step * 0.5) {\n          ev(w, { t: 'fx', k: 'dust_ring', s: 'stone_hit', sh: 0.5, wv: 1, x: m.x, z: m.z, r: 3 });\n          m.status.stun = 2.5; b.state = 'walk';\n        } else if (b.left <= 0) b.state = 'walk';\n        return;\n      }\n      chase(w, m, t, 1, 1);\n      melee(w, m, b, t, 2.8, 0.7, 1);\n      b.charge -= DT;\n      if (b.charge <= 0 && dist(m.x, m.z, t.x, t.z) > 4) {\n        b.charge = b.phase === 2 ? 4 : 6;\n        b.state = 'roar'; b.t = 1;\n        const l = Math.hypot(t.x - m.x, t.z - m.z) || 1;\n        b.dx = (t.x - m.x) / l; b.dz = (t.z - m.z) / l;\n        m.facing = facingOf(b.dx, b.dz);\n        ev(w, { t: 'sfx', k: 'roar', x: m.x, z: m.z });\n        ev(w, { t: 'mcast', id: m.id, clip: 'roar', sp: 1 });\n        telegraphLine(w, m.x, m.z, b.dx, b.dz, 14, 3, 1, 0, { silent: true });\n      }\n      b.audit -= DT;\n      if (b.audit <= 0 && b.phase === 2) {\n        b.audit = 8;\n        telegraphRing(w, t.x, t.z, 2.2, 0.8, m.dmg * 0.4, { src: m, vfx: 'bone_rise', sfx: 'bone_hit', entomb: 3 });\n      }\n    },\n  },\n};\n\nconst say2 = (w, m, text) => ev(w, { t: 'sub', who: 'warden', name: m.def.name, text });\n\nfunction closeRing(w, m, b) {\n  // The room's walls of coffins, one ring tighter each time. Never closer than 5 m from the middle.\n  const room = w.zone.rooms.find((r) => r.tpl?.boss === 'bursar');\n  if (!room) return;\n  const k = b.ring + 1;\n  const cells = [];\n  const x0 = room.x + k, x1 = room.x + room.w - 1 - k, y0 = room.y + k, y1 = room.y + room.h - 1 - k;\n  if (x1 - x0 < 10 || y1 - y0 < 8) { b.ring = 99; return; }\n  for (let x = x0; x <= x1; x++) { cells.push([x, y0], [x, y1]); }\n  for (let y = y0; y <= y1; y++) { cells.push([x0, y], [x1, y]); }\n  const closed = [];\n  for (const [cx, cz] of cells) {\n    if (!w.zone.nav.isOpen(cx, cz)) continue;\n    setCellOpen(w, cx, cz, false);\n    closed.push([cx, cz]);\n  }\n  b.closed.push(...closed);\n  b.ring++;\n  ev(w, { t: 'obst', id: w.nextId++, k: 'coffin_wall', x: m.x, z: m.z, cells: closed, life: 999 });\n  ev(w, { t: 'sfx', k: 'coffin_slam', x: m.x, z: m.z });\n  // Anyone caught in the closing wall steps inward.\n  const cx = room.x + room.w / 2, cz = room.y + room.h / 2;\n  for (const h of w.heroes) {\n    if (walkable(w, h.x, h.z)) continue;\n    const l = Math.hypot(cx - h.x, cz - h.z) || 1;\n    for (let d = 1; d < 8; d += 0.5) {\n      const px = h.x + ((cx - h.x) / l) * d, pz = h.z + ((cz - h.z) / l) * d;\n      if (walkable(w, px, pz)) { h.x = px; h.z = pz; break; }\n    }\n  }\n  for (const o of w.monsters) if (!walkable(w, o.x, o.z)) { o.x = cx; o.z = cz; }\n}\n\nfunction reopenAll(w, b) {\n  for (const [cx, cz] of b.closed ?? []) setCellOpen(w, cx, cz, true);\n  for (const [cx, cz] of b.pits ?? []) setCellOpen(w, cx, cz, true);\n  if (b.closed?.length || b.pits?.length) ev(w, { t: 'obst_clear' });\n  b.closed = []; b.pits = [];\n}\n\nfunction enterPhase2(w, m, b) {\n  b.phase = 2;\n  b.toll = 8; b.crumble = 3;\n  ev(w, { t: 'boss_phase', id: m.id, phase: 2 });\n  say(w, 'malison', 'THE CRACKED HOUR. COUNT WITH ME.');\n  ev(w, { t: 'fx', k: 'dust_ring', s: 'bell_cracked', sh: 0.6, wv: 1, x: m.x, z: m.z, r: 6 });\n}\n\nfunction enterPhase3(w, m, b) {\n  b.phase = 3;\n  b.rings = 0;\n  ev(w, { t: 'boss_phase', id: m.id, phase: 3 });\n  say(w, 'malison', 'EVENTIDE. THE LAST TOLL IS MINE. ALL OF IT.');\n  ev(w, { t: 'dark', on: 1 });\n  reopenPits(w, b);\n  // Three ropes at the rim.\n  const r = 11;\n  [Math.PI / 2, (Math.PI * 7) / 6, (Math.PI * 11) / 6].forEach((a, i) => {\n    let x = b.cx + Math.cos(a) * r, z = b.cz + Math.sin(a) * r;\n    for (let d = r; d > 2 && !walkable(w, x, z); d -= 0.5) { x = b.cx + Math.cos(a) * d; z = b.cz + Math.sin(a) * d; }\n    addObject(w, 'rope', x, z, { key: 'rope', hold: 2, announce: true, r: 1.2, ropeIndex: i, id: 1500000 + i });\n  });\n  toast(w, 'HOLD A BELL ROPE TO RING OLD CLEMENCY', 'sand', { big: 1 });\n  w.questSignal?.('ring');\n}\n\nfunction reopenPits(w, b) {\n  for (const [cx, cz] of b.pits ?? []) setCellOpen(w, cx, cz, true);\n  b.pits = [];\n  ev(w, { t: 'obst_clear' });\n}\n\nexport function ringRope(w, h, rope) {\n  const m = w.boss;\n  if (!m || m.def.boss !== 'malison') return;\n  const b = m.bossState;\n  b.rings = (b.rings ?? 0) + 1;\n  b.stagger = 2.5;\n  m.hp = Math.max(m.maxHp * 0.03, m.hp - m.maxHp * 0.12);\n  ev(w, { t: 'ring_bell', n: b.rings, x: m.x, z: m.z });\n  ev(w, { t: 'fx', k: 'ring_bronze', s: 'bell_true', sh: 1, wv: 1, x: m.x, z: m.z, r: 8 });\n  ev(w, { t: 'mcast', id: m.id, clip: 'stagger', sp: 1 });\n  ev(w, { t: 'hit', id: m.id, a: Math.round(m.maxHp * 0.12), c: 1, el: 'sound', s: h.seat, x: m.x, z: m.z, big: 1 });\n  if (b.rings >= 3) {\n    say(w, 'malison', 'NOT THE BELL. NOT TRUE. NOT TRUE...');\n    killMonster(w, m, h, { big: true });\n  }\n}\n\nfunction crumbleCell(w, m, b, t) {\n  const cx = Math.floor(t.x + w.rng.range(-3, 3)), cz = Math.floor(t.z + w.rng.range(-3, 3));\n  const cells = [];\n  for (let i = -1; i <= 1; i++) for (let j = -1; j <= 1; j++) {\n    const col = cx + i, row = cz + j;\n    if (!w.zone.nav.isOpen(col, row)) continue;\n    if (Math.hypot(col + 0.5 - b.cx, row + 0.5 - b.cz) < 3) continue;\n    cells.push([col, row]);\n  }\n  if (!cells.length) return;\n  telegraphRing(w, cx + 0.5, cz + 0.5, 2.1, 1.4, m.dmg * 0.6, {\n    src: m, vfx: 'floor_crumble', sfx: 'stone_hit', shake: 0.3,\n    then: (w2) => {\n      const closed = [];\n      for (const [col, row] of cells) {\n        if (w2.heroes.some((h) => Math.floor(h.x) === col && Math.floor(h.z) === row)) continue;\n        setCellOpen(w2, col, row, false);\n        closed.push([col, row]);\n      }\n      b.pits.push(...closed);\n      ev(w2, { t: 'obst', id: w2.nextId++, k: 'pit', x: cx, z: cz, cells: closed, life: 999 });\n      // Monsters standing there go with the floor.\n      for (const o of w2.monsters) if (!o.def.boss && !walkable(w2, o.x, o.z)) killMonster(w2, o, null, { silent: true });\n    },\n  });\n}\n\nfunction bellToll(w, m, b) {\n  const bx = b.cx, bz = b.cz;\n  ev(w, { t: 'fx', k: 'ring_bronze', s: 'bell_cracked', sh: 1, wv: 1, x: bx, z: bz, r: 22 });\n  ev(w, { t: 'toll', x: bx, z: bz });\n  for (const h of w.heroes) {\n    if (h.dead || h.gone) continue;\n    const safe = !w.zone.nav.lineOfSight(bx, bz, h.x, h.z);\n    if (safe) {\n      // The pillar that sheltered you takes the blow.\n      let best = null, bd = 9;\n      for (const p of b.pillars) {\n        if (p.hp <= 0) continue;\n        const d = dist(p.x, p.z, h.x, h.z);\n        if (d < bd) { bd = d; best = p; }\n      }\n      if (best) {\n        best.hp--;\n        ev(w, { t: 'pillar', x: best.x, z: best.z, hp: best.hp });\n        if (best.hp <= 0) setCellOpen(w, best.col, best.row, true);\n      }\n      continue;\n    }\n    if (h.state === 'dodge' || h.invuln > 0 || h.state === 'leap') { ev(w, { t: 'dodged', id: h.id }); continue; }\n    hurtHero(w, h, h.stats.maxHp * 0.6 / Math.max(0.2, 1 - (h.stats.armorTotal / (h.stats.armorTotal + 50 * m.level))) * (w.tuning.monsterDamage), { src: m, el: 'sound' });\n  }\n}\n\nexport function stepBoss(w, m) {\n  const script = bossScripts[m.def.boss];\n  if (!script) return;\n  script.step(w, m, m.bossState);\n}\n\nexport function bossDamaged(w, m, o) { bossScripts[m.def.boss]?.damaged?.(w, m, m.bossState, o); }\n\nexport function bossDied(w, m) {\n  bossScripts[m.def.boss]?.died?.(w, m, m.bossState);\n  if (w.boss === m) w.boss = null;\n  ev(w, { t: 'boss_dead', id: m.id, k: m.type, x: m.x, z: m.z });\n  // Everything the boss raised goes with it.\n  for (const o of w.monsters) if (o !== m && o.summoned && !o.dead) killMonster(w, o, null, { silent: true });\n  const L = m.level;\n  for (const h of w.heroes) {\n    if (h.gone || h.companion) continue;\n    for (let i = 0; i < 10; i++) dropGold(w, h, goldAt(L) * 3 * w.diffDef.reward * w.tuning.goldRate, m.x, m.z, 3);\n    dropItem(w, h, makeRolledItem(w.lootRng, h, 'reliquary', L + 1), m.x, m.z, 2);\n  }\n  onBossKilled(w, m);\n}\nEOF\ncat > src/sim/quests.js <<'EOF'\n// The campaign's state machine: quest steps, scripted beats, writs, Sister Pyx.\nimport { CLASSES } from '../data/classes.js';\nimport { PYX_BANTER, STORY_LINES } from '../data/dialog.js';\nimport { gemId } from '../data/items.js';\nimport { QUESTS, WRIT_TEMPLATES } from '../data/quests.js';\nimport { DT, dist, ev, say, toast } from './core.js';\nimport { startBoss, ringRope } from './bosses.js';\nimport { addHero, newHeroData, recalcHero, levelUp } from './hero.js';\nimport { dropItem, dropLegendary, dropTallow, makeItem, makeRolledItem, spawnDrop } from './loot.js';\nimport { makeStatues, monsterLevel, openSpot, removeMonster, spawnElitePack, spawnMonster, spawnPack } from './monsters.js';\nimport { addObject, objectByKey, setObjectState } from './objects.js';\nimport { travel } from './travel.js';\nimport { knellKill, onKnellBossDead, stepKnell, knellZoneEntered } from './knell.js';\nimport { roundLevelUp, roundBossDead } from './round.js';\n\nexport function newCampaign() {\n  return {\n    q: { i: 0, s: 0 }, flags: {}, gates: {}, visited: {}, lore: {}, bestiary: {}, portal: null, lastGate: null, zone: 'yard', floor: 0, writs: [], writsDone: 0, writCaches: 0,\n    shrines: 0, coffins: 0, chests: 0, levers: 0, broken: 0, bells: 0, bones: 0, credits: false, plateFirst: false, runsDone: 0,\n  };\n}\n\nexport const currentQuest = (w) => QUESTS[w.camp?.q.i] ?? null;\nexport const currentStep = (w) => currentQuest(w)?.steps[w.camp.q.s] ?? null;\nexport const stepIs = (w, id) => currentStep(w)?.id === id;\n\nfunction advance(w) {\n  const q = currentQuest(w);\n  if (!q) return;\n  w.camp.q.s++;\n  if (w.camp.q.s >= q.steps.length) {\n    ev(w, { t: 'quest_done', name: q.name });\n    w.camp.q.i++;\n    w.camp.q.s = 0;\n    ev(w, { t: 'sfx', k: 'quest' });\n  }\n  enterStep(w);\n}\n\nfunction enterStep(w) {\n  const st = currentStep(w);\n  if (!st) return;\n  ev(w, { t: 'quest', name: currentQuest(w).name, text: st.text, id: st.id });\n  ev(w, { t: 'autosave' });\n  const f = w.camp.flags;\n  switch (st.id) {\n    case 'east': break;\n    case 'coffin': break;\n    case 'to_causeway': f.open_causeway = 1; break;\n    case 'see_ogive': updateNpcs(w); break;\n    case 'bone1': f.open_ossuary = 1; break;\n    case 'bursar': if (f.bursar_dead) advance(w); break;\n    case 'to_cloister': f.open_cloister = 1; break;\n    case 'bishop': if (f.ambrose_dead) advance(w); break;\n    case 'to_belfry': f.open_belfry = 1; break;\n    default: break;\n  }\n  w.camp.seenQuest = true;\n}\n\nexport function questInit(w) { enterStep(w); }\n\n// ---- Objective, for the map marker and the bot ------------------------------------------------\nexport function objectiveOf(w) {\n  const st = currentStep(w);\n  if (!st) return null;\n  const f = w.camp.flags;\n  const town = (key) => ({ zone: 'town', floor: 0, key });\n  const here = w.zone?.id, floor = w.zone?.floor;\n  switch (st.id) {\n    case 'wake': case 'east': return { zone: 'yard', floor: 0, x: 45, z: 7 };\n    case 'coffin': return { zone: 'yard', floor: 0, key: 'coffin_quest' };\n    case 'gate': return { zone: 'yard', floor: 0, key: 'yard_gate' };\n    case 'crier': return town('npc_crier');\n    case 'to_causeway': return { zone: 'causeway', floor: 0 };\n    case 'find_brasse': return { zone: 'causeway', floor: 0, key: 'npc_brasse' };\n    case 'escort': return { zone: 'causeway', floor: 0, key: 'wagon', escort: true };\n    case 'brasse_home': return town('npc_brasse');\n    case 'see_ogive': case 'ogive_home': return town('npc_ogive');\n    case 'bone1': return { zone: 'ossuary', floor: 0, key: 'relic' };\n    case 'bone2': return { zone: 'ossuary', floor: 1, key: 'relic' };\n    case 'bone3': return { zone: 'ossuary', floor: 2, key: 'relic' };\n    case 'bursar': return { zone: 'ossuary', floor: 2, boss: 'bursar' };\n    case 'ledger': return { zone: 'ossuary', floor: 2, key: 'ledger' };\n    case 'see_crier': case 'crier_truth': return town('npc_crier');\n    case 'to_cloister': return { zone: 'cloister', floor: 0 };\n    case 'novices': return { zone: 'cloister', floor: 0, key: 'novice', defend: !!w.novices };\n    case 'bishop': return { zone: 'cloister', floor: 0, boss: 'ambrose' };\n    case 'to_belfry': return { zone: 'belfry', floor: 0 };\n    case 'climb': return { zone: 'belfry', floor: 3 };\n    case 'malison': return { zone: 'belfry', floor: 3, fight: true };\n    case 'ring': return { zone: 'belfry', floor: 3, key: 'rope' };\n    default: return { zone: here, floor };\n  }\n}\n\n// ---- Zones ------------------------------------------------------------------------------------\nexport function updateNpcs(w) {\n  const c = w.camp;\n  if (!c) return;\n  const qi = c.q.i;\n  for (const o of w.objects) {\n    if (o.kind !== 'npc') {\n      if (o.key === 'writ_board') { o.hidden = !c.flags.forge; ev(w, { t: 'obj', id: o.id, state: o.state, hidden: o.hidden }); }\n      if (o.key === 'knell_font') { o.hidden = false; }\n      continue;\n    }\n    let hide = false;\n    if (w.zone.id === 'town') {\n      if (o.npc === 'brasse') hide = !c.flags.brasse_met || !c.flags.brasse_home;\n      if (o.npc === 'ogive') hide = qi < 2;\n    } else if (o.npc === 'brasse' && (c.flags.brasse_met)) hide = true;\n    if (o.hidden !== hide) { o.hidden = hide; ev(w, { t: 'obj', id: o.id, state: o.state, hidden: hide }); }\n  }\n}\n\nexport function onZoneEntered(w) {\n  const z = w.zone;\n  if (w.round) return;\n  if (w.run) { knellZoneEntered(w); return; }\n  const c = w.camp;\n  if (!c) return;\n  updateNpcs(w);\n  ensurePyx(w);\n  const st = currentStep(w)?.id;\n  // A portal stays open in town while you are there.\n  if (z.id === 'town' && c.portal) addObject(w, 'portal', z.entryX + 2, z.entryZ - 1, { id: 1400000, announce: true, r: 1.2 });\n  // Hide relics already taken; ledger on revisits.\n  for (const o of w.objects) {\n    if (o.kind === 'relic' && c.flags[`bone_${z.floor}`]) { o.hidden = true; }\n    if (o.kind === 'book' && o.lore && c.lore[o.lore]) o.state = 1;\n  }\n  if (z.id === 'yard') {\n    if (st === 'wake') scriptWake(w);\n    if (c.flags.yard_coffin) { const co = objectByKey(w, 'coffin_quest'); if (co) co.state = 2; const g = objectByKey(w, 'yard_gate'); if (g) g.locked = false; }\n    if (!c.flags.yard_book_seen) ev(w, { t: 'sfx', k: 'rain_start' });\n  }\n  if (z.id === 'causeway') {\n    if (st === 'to_causeway') advance(w);\n    if (st === 'escort') { const wg = objectByKey(w, 'wagon'); if (wg) startEscort(w, wg); }\n    else if (c.flags.wagon_home) { const wg = objectByKey(w, 'wagon'); if (wg) setObjectState(w, wg, 2, { hidden: true }); }\n  }\n  if (z.id === 'town') {\n    if (st === 'gate') advance(w);\n  }\n  if (z.id === 'cloister' && st === 'to_cloister') advance(w);\n  if (z.id === 'belfry') {\n    if (st === 'to_belfry') advance(w);\n    if (z.floor === 3) {\n      if (currentStep(w)?.id === 'climb') advance(w);\n      const center = { x: z.w / 2, z: z.h / 2 };\n      if (!c.flags.malison_dead) {\n        startBoss(w, 'malison', center.x, center.z, {});\n        ev(w, { t: 'cut', id: 'malison_intro' });\n      }\n    }\n  }\n  placeWritCoffin(w);\n  if (z.plateRoll) w.plateAt = w.time + w.rng.range(20, 60);\n}\n\nfunction scriptWake(w) {\n  const z = w.zone;\n  // Your coffin bursts and they are already here.\n  for (const [dx, dz] of [[5, -2], [6, 2], [8, 0]]) {\n    spawnMonster(w, 'peatwalker', z.entryX + dx, z.entryZ + dz, { state: 'chase', questTag: 'wake', from: 'ground', noXp: false });\n  }\n}\n\n// ---- Events from the sim ----------------------------------------------------------------------\nexport function onMonsterKilled(w, m, src) {\n  knellKill(w, m);\n  const c = w.camp;\n  if (!c) return;\n  const f = c.flags;\n  if (m.questTag === 'wake') {\n    if (!f.first_tallow) { f.first_tallow = 1; dropTallow(w, m.x, m.z); }\n    if (!w.monsters.some((o) => o.questTag === 'wake' && !o.dead)) {\n      if (stepIs(w, 'wake')) {\n        for (const h of w.heroes) {\n          if (h.companion || h.gone) continue;\n          const it = makeItem(w.lootRng, { slot: 'main', rarity: 'blessed', ilvl: 2, cls: h.cls });\n          dropItem(w, h, it, m.x, m.z, 0.8);\n        }\n        advance(w);\n      }\n    }\n  }\n  if (src && !src.companion && !m.summoned) {\n    for (const wr of c.writs) {\n      if (wr.done) continue;\n      if (wr.k === 'kill' && wr.zone === w.zone.id) { wr.have = (wr.have ?? 0) + 1; if (wr.have >= wr.n) finishWrit(w, wr); }\n    }\n  }\n  if (src && !src.companion && w.rng.chance(0.03)) pyx(w, 'kill');\n}\n\nexport function onHeroDied(w, h) {\n  if (h.companion) { pyx(w, 'down', true); return; }\n  if (w.boss?.def.boss === 'malison') say(w, 'malison', STORY_LINES.malison_kill);\n}\nexport function onRoundLevelUp(w, h) { roundLevelUp(w, h); }\n\nexport function onItemPicked(w, h, item) {\n  if ((item.rarity === 'legendary' || item.rarity === 'set') && w.camp) w.camp.legendaries = (w.camp.legendaries ?? 0) + 1;\n  if (item.rarity === 'legendary' || item.rarity === 'set') pyx(w, 'loot');\n}\n\nexport function onTalkStart(w, h, o) {\n  if (!w.camp) return;\n}\n\n/** The dialogue finished (from the UI, or a bot). */\nexport function onTalkDone(w, h, npc) {\n  const c = w.camp;\n  if (!c) return;\n  const st = currentStep(w)?.id;\n  const f = c.flags;\n  if (npc === 'crier') {\n    if (st === 'crier') { f.crier_met = 1; f.overdue_open = 1; advance(w); return; }\n    if (st === 'see_crier') { advance(w); return; }\n    if (st === 'crier_truth') { advance(w); return; }\n    if (f.overdue_found && !f.overdue_done) {\n      f.overdue_done = 1;\n      for (const a of w.heroes) if (!a.companion && !a.gone) { a.gold += 250 + 20 * a.level; dropItem(w, a, makeRolledItem(w.lootRng, a, 'reliquary', monsterLevel(w)), a.x, a.z, 1.5); }\n      toast(w, 'THE OVERDUE BOOK IS RETURNED', 'sand', { big: 1 });\n      ev(w, { t: 'quest_done', name: 'AN OVERDUE BOOK' });\n    }\n    return;\n  }\n  if (npc === 'brasse') {\n    if (st === 'find_brasse') {\n      f.brasse_met = 1;\n      advance(w);\n      const wg = objectByKey(w, 'wagon');\n      if (wg) startEscort(w, wg);\n      updateNpcs(w);\n      return;\n    }\n    if (st === 'brasse_home') { f.forge = 1; updateNpcs(w); pyx(w, 'town'); advance(w); return; }\n    return;\n  }\n  if (npc === 'ogive') {\n    if (st === 'see_ogive') { advance(w); return; }\n    if (st === 'ogive_home') {\n      f.reliquary = 1;\n      for (const a of w.heroes) {\n        if (a.companion || a.gone) continue;\n        a.gems[gemId('ember', 0)] = (a.gems[gemId('ember', 0)] ?? 0) + 1;\n        a.gems[gemId('salt', 0)] = (a.gems[gemId('salt', 0)] ?? 0) + 1;\n        a.gems[gemId('amber', 0)] = (a.gems[gemId('amber', 0)] ?? 0) + 1;\n        const it = makeItem(w.lootRng, { slot: 'chest', rarity: 'reliquary', ilvl: monsterLevel(w), cls: a.cls, forceSocket: true });\n        dropItem(w, a, it, a.x, a.z, 1.5);\n      }\n      advance(w);\n      return;\n    }\n  }\n}\n\nexport function onObjectUsed(w, h, o) {\n  const c = w.camp;\n  if (!c) return;\n  const f = c.flags;\n  if (o.key === 'yard_gate') {\n    if (!o.locked) travel(w, 'town', 0, 'start');\n    return;\n  }\n  if (o.kind === 'relic') {\n    f[`bone_${w.zone.floor}`] = 1;\n    c.bones++;\n    ev(w, { t: 'fx', k: 'shrine', s: 'bell_small', x: o.x, z: o.z, r: 2 });\n    toast(w, `A BONE OF SAINT GLOAM. ${c.bones} OF 3.`, 'sand', { big: 1 });\n    if (c.bones >= 3 && (stepIs(w, 'bone1') || stepIs(w, 'bone2') || stepIs(w, 'bone3'))) { c.q.s = QUESTS[c.q.i].steps.findIndex((s) => s.id === 'bursar'); enterStep(w); }\n    else if (stepIs(w, 'bone1') || stepIs(w, 'bone2')) advance(w);\n    return;\n  }\n  if (o.key === 'ledger') {\n    c.lore.bishops_ledger = 1;\n    ev(w, { t: 'lore', id: 'bishops_ledger', seat: h.seat });\n    if (stepIs(w, 'ledger')) advance(w);\n    return;\n  }\n  if (o.key === 'overdue_book') {\n    f.overdue_found = 1;\n    setObjectState(w, o, 2, { hidden: true });\n    toast(w, 'THE OVERDUE BOOK. FORTY YEARS LATE.', 'sand', { big: 1 });\n    return;\n  }\n  if (o.kind === 'rope') { ringRope(w, h, o); return; }\n}\n\nexport function onCoffinDone(w, o) {\n  const c = w.camp;\n  if (!c) return;\n  if (o.key === 'coffin_quest') {\n    c.flags.yard_coffin = 1;\n    const g = objectByKey(w, 'yard_gate');\n    if (g) { setObjectState(w, g, 0, { locked: false }); }\n    ev(w, { t: 'fx', k: 'dust_ring', s: 'portcullis', x: g?.x ?? o.x, z: g?.z ?? o.z, r: 2 });\n    if (stepIs(w, 'coffin')) advance(w);\n  }\n  for (const wr of c.writs) if (!wr.done && wr.k === 'coffin' && wr.zone === w.zone.id) finishWrit(w, wr);\n}\n\nexport function onBossKilled(w, m) {\n  const c = w.camp;\n  onKnellBossDead(w, m);\n  roundBossDead(w, m);\n  if (!c) return;\n  const f = c.flags;\n  const first = !f[`${m.type}_dead`];\n  f[`${m.type}_dead`] = 1;\n  for (const wr of c.writs) if (!wr.done && wr.k === 'boss' && wr.boss === m.type) finishWrit(w, wr);\n  if (w.run) return;\n  if (m.type === 'bursar') {\n    if (first) {\n      for (const a of w.heroes) {\n        if (a.companion || a.gone) continue;\n        dropItem(w, a, makeItem(w.lootRng, { rarity: 'legendary', ilvl: m.level + 1, cls: a.cls, legendary: firstLegendary(w, a) }), m.x, m.z, 2);\n        spawnDrop(w, { kind: 'gem', gem: gemId('ember', 0), x: m.x + 1, z: m.z, owner: a.seat });\n      }\n      addObject(w, 'ledger', m.x, m.z + 1.5, { key: 'ledger', label: 'THE LEDGER', announce: true, id: 1300000 });\n    }\n    if (stepIs(w, 'bursar')) advance(w);\n  }\n  if (m.type === 'ambrose') {\n    say(w, 'ambrose', 'THREE TIMES. AND EVERY TIME, THE DARK WAS SINGING.');\n    if (stepIs(w, 'bishop')) advance(w);\n    if (first) for (const a of w.heroes) if (!a.companion && !a.gone) { dropItem(w, a, makeRolledItem(w.lootRng, a, 'reliquary', m.level + 1), m.x, m.z, 2); if (w.lootRng.chance(0.5)) dropLegendary(w, a, m.level + 1, m.x, m.z); }\n  }\n  if (m.type === 'malison') {\n    if (first) {\n      for (const a of w.heroes) {\n        if (a.companion || a.gone) continue;\n        dropItem(w, a, makeRolledItem(w.lootRng, a, 'legendary', m.level + 1), m.x, m.z, 2);\n        dropItem(w, a, makeRolledItem(w.lootRng, a, 'set', m.level + 1), m.x, m.z, 2);\n      }\n    }\n    ev(w, { t: 'cut', id: 'ending', first: first ? 1 : 0 });\n    c.credits = true;\n    w.account.unlocks.penance = true;\n    w.account.unlocks.knell = true;\n    if (stepIs(w, 'ring') || stepIs(w, 'malison')) { c.q.i = QUESTS.length; c.q.s = 0; ev(w, { t: 'quest_done', name: 'RING IT OR DIE TRYING' }); }\n    ev(w, { t: 'autosave' });\n  }\n  if (m.type === 'cellarer') { c.flags.pantry_done = 1; }\n}\n\nfunction firstLegendary(w, h) {\n  const ids = { bellwarden: 'widows_clapper', lamplighter: 'last_wick', sexton: 'second_best_crook' };\n  return ids[h.cls] ?? 'clemency_shard';\n}\n\n// ---- Frame ------------------------------------------------------------------------------------\nexport function stepQuests(w) {\n  stepKnell(w);\n  const c = w.camp;\n  if (!c || w.round) return;\n  if (w.t % 15 === 0) stepCheap(w);\n  stepEscortWagon(w);\n  stepNovices(w);\n}\n\nfunction stepCheap(w) {\n  const c = w.camp;\n  const z = w.zone;\n  const st = currentStep(w)?.id;\n  const heroes = w.heroes.filter((h) => !h.gone && !h.dead && !h.companion);\n  if (!heroes.length) return;\n  // Bosses wake when you walk into their rooms.\n  for (const r of z.rooms) {\n    if (!r.tpl?.boss || z.bossStarted === r.index || r.tpl.boss === 'malison') continue;\n    if (heroes.some((h) => h.x > r.x + 1 && h.x < r.x + r.w - 1 && h.z > r.y + 1 && h.z < r.y + r.h - 1)) {\n      z.bossStarted = r.index;\n      const room = r;\n      const x = room.x + room.w / 2, zz = room.y + room.h / 2;\n      startBoss(w, r.tpl.boss, x, zz, {});\n      ev(w, { t: 'cut', id: `${r.tpl.boss}_intro` });\n    }\n  }\n  if (st === 'east') {\n    if (!c.flags.deacon && heroes.some((h) => h.x > 21)) {\n      c.flags.deacon = 1;\n      spawnMonster(w, 'bloat_deacon', 32, 6.5, { state: 'chase', questTag: 'deacon' });\n      spawnPack(w, { x: 30, z: 3, kind: 'S' });\n    }\n    if (heroes.some((h) => h.x > 45)) advance(w);\n  }\n  if (z.id === 'causeway') {\n    if (!c.flags.first_pack && z.rooms[2] && heroes.some((h) => dist(h.x, h.z, z.rooms[2].cx, z.rooms[2].cz) < 22)) {\n      c.flags.first_pack = 1;\n      spawnElitePack(w, { x: z.rooms[2].cx, z: z.rooms[2].cz }, z.def.monsters, { kind: 'champion', type: 'peatwalker', aff: ['tolling'] });\n      pyx(w, 'elite');\n    }\n    if (!c.plateFirst && z.rooms[3] && heroes.some((h) => dist(h.x, h.z, z.rooms[3].cx, z.rooms[3].cz) < 16)) {\n      c.plateFirst = true;\n      spawnPlate(w, z.rooms[3].cx, z.rooms[3].cz);\n    }\n  }\n  if (w.plateAt && w.time > w.plateAt) { w.plateAt = 0; const h = heroes[0]; const p = openSpot(w, h.x + 8, h.z + 4, 4); spawnPlate(w, p.x, p.z); }\n  if (st === 'novices' && !w.novices && z.id === 'cloister') {\n    const nv = w.objects.find((o) => o.kind === 'novice');\n    if (nv && heroes.some((h) => dist(h.x, h.z, nv.x, nv.z) < 8)) startNovices(w);\n  }\n  if (st === 'climb' || st === 'novices' || st === 'bishop') {\n    w.tauntT = (w.tauntT ?? 25) - 0.25;\n    if (w.tauntT <= 0) { w.tauntT = 45; say(w, 'malison', w.rng.pick(STORY_LINES.malison_cloister)); }\n  }\n  // Pyx talks when she has something to say.\n  w.pyxIdle = (w.pyxIdle ?? 40) - 0.25;\n  if (w.pyxIdle <= 0) { w.pyxIdle = 55; pyx(w, z.def.safe ? 'town' : 'idle'); }\n  if (w.boss && !w.pyxBoss) { w.pyxBoss = true; pyx(w, 'boss'); }\n  if (!w.boss) w.pyxBoss = false;\n  // Spawn packs near heroes.\n  stepSpawns(w, heroes);\n}\n\nexport function stepSpawns(w, heroes = null) {\n  const z = w.zone;\n  const list = heroes ?? w.heroes.filter((h) => !h.gone && !h.dead);\n  for (const s of z.spawnList) {\n    if (s.done) continue;\n    if (list.some((h) => dist(h.x, h.z, s.x, s.z) < 30)) {\n      s.done = true;\n      if (w.monsters.length < 260) spawnPack(w, s);\n    }\n  }\n}\n\nexport function spawnPlate(w, x, z) {\n  const m = spawnMonster(w, 'collection_plate', x, z, { state: 'chase', knellPts: 8 });\n  ev(w, { t: 'plate', id: m.id, x, z });\n  toast(w, 'THE COLLECTION PLATE! CATCH IT BEFORE IT ESCAPES', 'sand', { big: 1 });\n  pyx(w, 'elite');\n  return m;\n}\n\n// The wagon of bells.\nfunction startEscort(w, wg) {\n  const z = w.zone;\n  const path = z.nav.path([wg.x, 0, wg.z], [z.entryX + 3, 0, z.entryZ]) ?? [[wg.x, 0, wg.z]];\n  w.escort = { wg, path, i: 1, t: 8, total: 0, done: false, joined: !!w.camp.flags.pyx };\n  ev(w, { t: 'fx', k: '', s: 'cart', x: wg.x, z: wg.z });\n}\n\nfunction stepEscortWagon(w) {\n  const e = w.escort;\n  if (!e || e.done || w.zone.id !== 'causeway') return;\n  const wg = e.wg;\n  const near = w.heroes.some((h) => !h.dead && !h.gone && dist(h.x, h.z, wg.x, wg.z) < 10);\n  const blocked = w.monsters.some((m) => !m.dead && dist(m.x, m.z, wg.x, wg.z) < 2.5);\n  e.moving = near && !blocked;\n  if (e.moving) {\n    const p = e.path[e.i];\n    if (p) {\n      const dx = p[0] - wg.x, dz = p[2] - wg.z, l = Math.hypot(dx, dz);\n      const step = 3 * DT;\n      if (l <= step) { wg.x = p[0]; wg.z = p[2]; e.i++; }\n      else { wg.x += (dx / l) * step; wg.z += (dz / l) * step; }\n      wg.dx = dx; wg.dz = dz;\n      e.total += step;\n    }\n  }\n  if (w.t % 12 === 0) ev(w, { t: 'objmove', id: wg.id, x: wg.x, z: wg.z, d: Math.atan2(wg.dx ?? 0, wg.dz ?? 1), m: e.moving ? 1 : 0 });\n  e.t -= DT;\n  if (e.t <= 0 && near) {\n    e.t = 9;\n    const pack = 5 + w.heroes.filter((h) => !h.gone && !h.companion).length * 2;\n    for (let i = 0; i < pack * w.tuning.monsterDensity; i++) {\n      const a = w.rng.range(0, Math.PI * 2);\n      const p = openSpot(w, wg.x + Math.cos(a) * 9, wg.z + Math.sin(a) * 9, 3);\n      const type = w.rng.chance(0.25) ? 'gibbet_drop' : 'peatwalker';\n      spawnMonster(w, type, p.x, p.z, { state: 'chase', from: type === 'gibbet_drop' ? 'drop' : 'ground' });\n    }\n  }\n  if (!e.joined && e.i > e.path.length * 0.4) { e.joined = true; w.camp.flags.pyx = 1; ensurePyx(w, wg); pyx(w, 'join', true); }\n  if (e.i >= e.path.length) {\n    e.done = true;\n    w.camp.flags.wagon_home = 1;\n    w.camp.flags.brasse_home = 1;\n    w.camp.flags.pyx = 1;\n    ensurePyx(w, wg);\n    toast(w, 'THE WAGON IS THROUGH', 'sand', { big: 1 });\n    ev(w, { t: 'fx', k: '', s: 'bell_mid', x: wg.x, z: wg.z });\n    if (stepIs(w, 'escort')) advance(w);\n    setObjectState(w, wg, 2, { hidden: true });\n    w.escort = null;\n  }\n}\n\n// The novices.\nfunction startNovices(w) {\n  const spots = w.objects.filter((o) => o.key === 'font_spot');\n  w.novices = { hp: 100, t: 40, wave: 1, fonts: [], fail: 0 };\n  ev(w, { t: 'event', k: 'novices', text: 'DEFEND THE NOVICES', t0: 40 });\n  say(w, 'pyx', 'They are still singing. Keep them singing.');\n  for (const s of spots) w.novices.fonts.push(spawnMonster(w, 'unrung_font', s.x, s.z, { state: 'chase', knellPts: 0 }));\n}\n\nfunction stepNovices(w) {\n  const n = w.novices;\n  if (!n || w.zone.id !== 'cloister') return;\n  const list = w.objects.filter((o) => o.kind === 'novice');\n  if (n.fail > 0) {\n    n.fail -= DT;\n    if (n.fail <= 0) { w.novices = null; for (const o of list) { o.hidden = false; ev(w, { t: 'obj', id: o.id, state: 0, hidden: false }); } }\n    return;\n  }\n  n.t -= DT;\n  n.wave -= DT;\n  let threats = 0;\n  for (const m of w.monsters) {\n    if (m.dead) continue;\n    for (const o of list) if (dist(m.x, m.z, o.x, o.z) < 2.2) threats++;\n  }\n  n.hp -= threats * 0.6 * DT;\n  if (n.wave <= 0) {\n    n.wave = 7;\n    const nv = list[0];\n    const count = (6 + w.heroes.length * 2) * w.tuning.monsterDensity;\n    for (let i = 0; i < count; i++) {\n      const a = w.rng.range(0, Math.PI * 2);\n      const p = openSpot(w, nv.x + Math.cos(a) * 9, nv.z + Math.sin(a) * 6, 2);\n      const m = spawnMonster(w, w.rng.chance(0.75) ? 'cinderling' : 'penitent', p.x, p.z, { state: 'chase', from: 'ground' });\n      m.tgtNovice = true;\n    }\n  }\n  ev(w, { t: 'event_tick', hp: Math.round(n.hp), left: Math.ceil(n.t) });\n  if (n.hp <= 0) {\n    ev(w, { t: 'event', k: 'novices_fail', text: 'THE SINGING HAS STOPPED' });\n    for (const o of list) { o.hidden = true; ev(w, { t: 'obj', id: o.id, state: 0, hidden: true }); }\n    for (const f of n.fonts) if (!f.dead) removeMonster(w, f);\n    say(w, 'pyx', 'No. Not like that. Listen: another voice, further in. Hurry.');\n    n.fail = 8;\n    return;\n  }\n  if (n.t <= 0) {\n    ev(w, { t: 'event', k: 'novices_done', text: 'THE NOVICES GET AWAY' });\n    w.novices = null;\n    for (const f of n.fonts) if (!f.dead) removeMonster(w, f);\n    for (const o of list) { o.hidden = true; ev(w, { t: 'obj', id: o.id, state: 0, hidden: true }); }\n    addObject(w, 'chest', list[0].x, list[0].z, { rich: true, announce: true, gem: gemId('salt', 0) });\n    say(w, 'pyx', 'Go on, then. Run. Sing something cheerful. No, not that one.');\n    if (stepIs(w, 'novices')) advance(w);\n  }\n}\n\n// Sister Pyx.\nexport function ensurePyx(w, near = null) {\n  const c = w.camp;\n  if (!c?.flags.pyx || w.noPyx) return;\n  const humans = w.heroes.filter((h) => !h.gone && !h.companion);\n  const have = w.heroes.find((h) => h.companion && !h.gone);\n  if (humans.length > 1) {\n    if (have) { have.gone = true; ev(w, { t: 'hero_gone', id: have.id }); w.heroes.splice(w.heroes.indexOf(have), 1); say(w, 'pyx', 'You have company. I shall go and glare at something else.'); }\n    return;\n  }\n  if (have) return;\n  const lead = humans[0];\n  if (!lead) return;\n  const data = newHeroData('pyx', 'SISTER PYX', 'pyx');\n  data.level = lead.level;\n  data.skills = CLASSES.pyx.preset.map(([id]) => ({ id, tone: null })).concat([null, null, null]);\n  const p = addHero(w, data, 8, { companion: true, navIndex: 5, x: (near?.x ?? lead.x) + 1, z: (near?.z ?? lead.z) + 1 });\n  p.isBot = true;\n  recalcHero(w, p);\n  p.hp = p.stats.maxHp;\n  return p;\n}\n\nexport function pyx(w, key, force = false) {\n  if (!w.camp?.flags.pyx || w.heroes.filter((h) => !h.companion && !h.gone).length > 1) return;\n  if (!force && (w.pyxNext ?? 0) > w.time) return;\n  w.pyxNext = w.time + 18;\n  w.camp.pyxLines = (w.camp.pyxLines ?? 0) + 1;\n  say(w, 'pyx', w.rng.pick(PYX_BANTER[key] ?? PYX_BANTER.idle));\n}\n\n// ---- Writs ------------------------------------------------------------------------------------\nexport function rollWrits(w) {\n  const c = w.camp;\n  const pool = WRIT_TEMPLATES.filter((t) => t.zone === 'yard' || c.visited[`${t.zone}:0`]);\n  const list = [...pool];\n  w.rng.shuffle(list);\n  c.writs = list.slice(0, 3).map((t) => ({ ...t, have: 0, done: false }));\n  c.writCache = false;\n  ev(w, { t: 'toast', text: 'NEW WRITS POSTED', color: 'sand' });\n}\n\nfunction placeWritCoffin(w) {\n  const c = w.camp;\n  const wr = c.writs.find((x) => !x.done && x.k === 'coffin' && x.zone === w.zone.id);\n  if (!wr) return;\n  const room = w.zone.rooms[Math.min(1, w.zone.rooms.length - 1)];\n  addObject(w, 'coffin', room.cx, room.cz, { key: 'writ_coffin', time: 30, count: 6, announce: true, id: 1200000 });\n}\n\nfunction finishWrit(w, wr) {\n  wr.done = true;\n  const c = w.camp;\n  c.writsDone++;\n  ev(w, { t: 'toast', text: `WRIT DONE: ${wr.text}`, color: 'lime' });\n  ev(w, { t: 'sfx', k: 'quest' });\n  if (c.writs.every((x) => x.done) && !c.writCache) {\n    c.writCache = true;\n    c.writCaches++;\n    for (const a of w.heroes) {\n      if (a.companion || a.gone) continue;\n      a.gold += 300 + 40 * a.level;\n      a.mats.dust += 6; a.mats.scrap += 12; a.mats.shards += 1;\n      dropItem(w, a, makeRolledItem(w.lootRng, a, 'reliquary', monsterLevel(w)), a.x, a.z, 1.5);\n    }\n    toast(w, 'THE VESTRY PAYS, FOR ONCE. A WRIT CACHE.', 'sand', { big: 1 });\n    ev(w, { t: 'autosave' });\n  }\n}\n\nexport { makeStatues, levelUp };\nEOF\ncat > src/sim/knell.js <<'EOF'\n// Knell Runs and the Grand Knell: a random dungeon, a meter, a Warden, and something to take home.\nimport { KNELL_MOD_IDS } from '../data/quests.js';\nimport { WARDENS } from '../data/monsters.js';\nimport { DIFFICULTIES } from '../data/tuning.js';\nimport { gemId } from '../data/items.js';\nimport { dist, ev, say, toast } from './core.js';\nimport { startBoss } from './bosses.js';\nimport { dropItem, goldAt, makeRolledItem, spawnDrop, dropGold } from './loot.js';\nimport { killMonster, partyCount, openSpot } from './monsters.js';\nimport { addObject } from './objects.js';\nimport { travel } from './travel.js';\nimport { gainXp } from './hero.js';\nimport { stepSpawns, spawnPlate } from './quests.js';\nimport { spawnPack } from './monsters.js';\nimport { telegraphRing } from './hazards.js';\n\nexport function rollMods(rng, n) {\n  const ids = [...KNELL_MOD_IDS];\n  rng.shuffle(ids);\n  return ids.slice(0, n);\n}\n\n/** Start a run. o: { grand: false, tier: 1, mods: [...] }, the UI shows the mods first. */\nexport function startRun(w, o = {}) {\n  const rng = w.rng;\n  const mods = o.mods ?? rollMods(rng, rng.int(1, 2));\n  const grand = !!o.grand;\n  const tier = o.tier ?? 1;\n  const party = partyCount(w);\n  w.run = {\n    seedKey: `run${w.t}`, mods, grand, tier, meter: 0, total: Math.round(450 * (1 + 0.25 * (party - 1)) * (grand ? 0.8 : 1)), state: 'fill',\n    hpMul: grand ? 1.17 ** tier : 1, dmgMul: grand ? 1.08 ** tier : 1, goldMul: mods.includes('golden') ? 2 : 1, densityMul: mods.includes('crowded') ? 1.4 : 1, speedMul: mods.includes('swift') ? 1.2 : 1,\n    startT: w.time, timer: grand ? 600 : 0, startKills: 0, floor: 0, warden: null, wardenT: 0, deaths: 0, table: null,\n  };\n  ev(w, { t: 'run_start', mods, grand: grand ? 1 : 0, tier, total: w.run.total });\n  travel(w, 'knell', 0, 'start');\n}\n\nexport function knellZoneEntered(w) {\n  const r = w.run;\n  ev(w, { t: 'run_floor', floor: w.zone.floor });\n  if (w.camp && !w.camp.plateRun && w.rng.chance(1 / 3)) { w.plateAt = w.time + w.rng.range(20, 60); w.camp.plateRun = true; }\n}\n\nexport function knellKill(w, m) {\n  const r = w.run;\n  if (!r || r.state !== 'fill') return;\n  const pts = m.knellPts ?? 1;\n  if (!pts) return;\n  r.meter = Math.min(r.total, r.meter + pts);\n  ev(w, { t: 'knell', v: r.meter, of: r.total });\n  if (r.meter >= r.total) knellTolls(w);\n}\n\nfunction knellTolls(w) {\n  const r = w.run;\n  r.state = 'warden';\n  ev(w, { t: 'knell_tolls' });\n  toast(w, 'THE KNELL TOLLS', 'white', { big: 1 });\n  for (const m of w.monsters) if (!m.dead && !m.def.boss) killMonster(w, m, null, { silent: true, big: true });\n  const lead = w.heroes.find((h) => !h.dead && !h.gone && !h.companion) ?? w.heroes[0];\n  const type = r.forceWarden ?? w.rng.pick(WARDENS);\n  r.wardenAt = w.time + 2;\n  r.wardenType = type;\n  r.wardenX = lead.x; r.wardenZ = lead.z;\n}\n\nexport function stepKnell(w) {\n  const r = w.run;\n  if (!r) return;\n  if (r.grand && r.state !== 'done') r.timer -= 1 / 60;\n  if (r.state === 'warden' && r.wardenAt && w.time >= r.wardenAt) {\n    r.wardenAt = 0;\n    const lead = w.heroes.find((h) => !h.dead && !h.gone && !h.companion) ?? w.heroes[0];\n    const p = openSpot(w, lead.x + 3, lead.z + 3, 2);\n    const m = startBoss(w, r.wardenType, p.x, p.z, { noIntro: true, level: Math.max(lead.level, w.zone.def.levelFloor) });\n    r.warden = m;\n    r.wardenStart = w.time;\n    ev(w, { t: 'fx', k: 'dust_ring', s: 'coffin_slam', sh: 0.8, wv: 1, x: p.x, z: p.z, r: 8 });\n    ev(w, { t: 'warden', k: r.wardenType, x: p.x, z: p.z });\n    telegraphRing(w, p.x, p.z, 3, 0.6, 0, {});\n  }\n  if (w.t % 15 === 0) {\n    stepSpawns(w);\n    if (w.plateAt && w.time > w.plateAt) { w.plateAt = 0; const h = w.heroes[0]; const p = openSpot(w, h.x + 8, h.z + 4, 4); spawnPlate(w, p.x, p.z); }\n    // No more monsters and meter unfilled on the last floor: raise some more.\n    if (r.state === 'fill' && w.zone.floor === w.zone.def.floors - 1 && w.monsters.length < 6 && w.zone.spawnList.every((s) => s.done)) {\n      const h = w.heroes.find((o) => !o.dead && !o.gone) ?? w.heroes[0];\n      for (let i = 0; i < 3; i++) { const p = openSpot(w, h.x, h.z, 9); spawnPack(w, { x: p.x, z: p.z, kind: i === 0 && w.rng.chance(0.3) ? 'E' : 'S' }); }\n    }\n  }\n}\n\nexport function onKnellBossDead(w, m) {\n  const r = w.run;\n  if (!r || m !== r.warden) return;\n  r.state = 'done';\n  const time = w.time - r.startT;\n  const beat = !r.grand || r.timer > 0;\n  const L = m.level;\n  const results = { time, grand: r.grand ? 1 : 0, tier: r.tier, beat: beat ? 1 : 0, keys: 0, xp: 0, shards: 0, best: 0 };\n  for (const h of w.heroes) {\n    if (h.gone || h.companion) continue;\n    dropItem(w, h, makeRolledItem(w.lootRng, h, 'legendary', L + 1), m.x, m.z, 2);\n    if (r.grand && beat) {\n      dropItem(w, h, makeRolledItem(w.lootRng, h, w.lootRng.chance(0.5) ? 'set' : 'legendary', L + 1), m.x, m.z, 2);\n      spawnDrop(w, { kind: 'gem', gem: gemId(w.lootRng.pick(['ember', 'salt', 'amber']), 1), x: m.x, z: m.z, owner: h.seat });\n    }\n    h.mats.shards += r.grand ? 3 : 1;\n    results.shards = r.grand ? 3 : 1;\n    const xp = (L * 120 + 500) * (r.grand ? 2 + r.tier * 0.25 : 1) * w.diffDef.reward;\n    gainXp(w, h, xp);\n    results.xp = Math.round(xp);\n    if (!r.grand && w.lootRng.chance(1 / 4)) { spawnDrop(w, { kind: 'key', x: m.x - 1, z: m.z, owner: h.seat }); results.keys = 1; }\n    if (r.grand) {\n      const bests = w.account.bests;\n      const cur = bests[h.cls];\n      const better = beat && (!cur || r.tier > cur.tier || (r.tier === cur.tier && time < cur.time));\n      if (better) { bests[h.cls] = { tier: r.tier, time: Math.round(time) }; results.best = 1; }\n    }\n  }\n  if (w.camp) w.camp.runsDone = (w.camp.runsDone ?? 0) + 1;\n  ev(w, { t: 'run_done', results });\n  addObject(w, 'exit', m.x + 2, m.z, { to: 'town', floor: 0, entry: 'start', label: 'THE WAY HOME', announce: true, key: 'run_home', id: 1100000 });\n}\n\nexport function endRun(w) { w.run = null; }\nexport { DIFFICULTIES, dist, say, goldAt, dropGold };\nEOF\ncat > src/sim/round.js <<'EOF'\n// The AI Hub session round: one shared Knell Run, fill the meter, slay the Warden. Host only.\nimport { CLASSES } from '../data/classes.js';\nimport { SKILLS } from '../data/skills.js';\nimport { VOWS } from '../data/classes.js';\nimport { RULES } from '../data/tuning.js';\nimport { DT, ev, toast } from './core.js';\nimport { addHero, gearLook, newHeroData, recalcHero } from './hero.js';\nimport { makeItem } from './loot.js';\nimport { addObject } from './objects.js';\nimport { loadZone } from './travel.js';\nimport { startRun } from './knell.js';\n\nexport const SEAT_CLASSES = ['bellwarden', 'lamplighter', 'sexton', 'bellwarden'];\nexport const ROUND_LEVEL = 12;\n\nexport function roundHeroData(cls, seat, name, rng) {\n  const d = newHeroData(cls, name, `round${seat}`);\n  d.level = ROUND_LEVEL;\n  d.skills = CLASSES[cls].preset.map(([id]) => ({ id, tone: null }));\n  const gear = {};\n  for (const slot of ['main', 'head', 'chest', 'hands', 'legs', 'feet', 'shoulders', 'amulet', 'ring']) {\n    gear[slot] = makeItem(rng, { slot, rarity: 'blessed', ilvl: ROUND_LEVEL, cls });\n  }\n  d.gear = gear;\n  return d;\n}\n\nexport function setupRound(w, players) {\n  w.round = { playT: 0, started: false, finished: false, time: 0, picks: new Map(), players };\n  w.noPyx = true;\n  w.run = {\n    seedKey: 'session', mods: ['crowded'], grand: false, tier: 1, meter: 0, total: Math.round(330 * (1 + 0.25 * (players.length - 1))), state: 'fill',\n    hpMul: 1, dmgMul: 1, goldMul: 1, densityMul: 1, speedMul: 1, startT: 0, timer: 0, floor: 0, warden: null, table: null,\n  };\n  const rng = w.root.fork('round');\n  for (const p of players) {\n    const cls = SEAT_CLASSES[p.id % 4];\n    const d = roundHeroData(cls, p.id, p.name, rng.fork(`hero${p.id}`));\n    const h = addHero(w, d, p.id, { navIndex: p.id });\n    h.color = p.color;\n    h.res = h.stats.maxResTotal * 0.5;\n  }\n  loadZone(w, 'session', 0, 'start');\n  placeClassFonts(w);\n}\n\nfunction placeClassFonts(w) {\n  const z = w.zone;\n  const offs = [[-3, -1.5, 'bellwarden'], [0, -2, 'lamplighter'], [3, -1.5, 'sexton']];\n  offs.forEach(([dx, dz, cls], i) => {\n    let x = z.entryX + dx, y = z.entryZ + dz;\n    if (!z.nav.walkable(x, y)) { x = z.entryX + dx * 0.5; y = z.entryZ + 1; }\n    addObject(w, 'class_font', x, y, { id: 1600000 + i, cls, noUse: true, label: CLASSES[cls].name, announce: false });\n  });\n  w.swapClass = (w2, h, cls) => {\n    const d = roundHeroData(cls, h.seat, h.name, w2.root.fork(`swap${h.seat}:${cls}`));\n    h.cls = cls;\n    h.gear = d.gear; h.skills = d.skills; h.vows = [null, null]; h.cds = {}; h.charges = {};\n    recalcHero(w2, h);\n    h.hp = h.stats.maxHp; h.res = h.stats.maxResTotal * 0.5;\n    ev(w2, { t: 'hero_class', id: h.id, cls });\n    ev(w2, { t: 'gear', id: h.id, g: gearLook(h) });\n    toast(w2, `${h.name} IS NOW A ${CLASSES[cls].name}`, CLASSES[cls].color);\n    for (const a of w2.allies) if (a.owner === h.id) a.life = 0.01;\n  };\n}\n\n/** A level-up in a session pops a small \"pick 1 of 3\". The host rolls the three and the seat answers. */\nexport function roundLevelUp(w, h) {\n  const opts = [];\n  const rng = w.lootRng;\n  const toned = h.skills.filter((s) => s && !s.tone);\n  if (toned.length) {\n    const s = rng.pick(toned);\n    const ids = Object.keys(SKILLS[s.id].tones);\n    const t = rng.pick(ids);\n    opts.push({ k: 'tone', skill: s.id, tone: t, name: `${SKILLS[s.id].name}: ${SKILLS[s.id].tones[t].name}`, desc: SKILLS[s.id].tones[t].desc });\n  }\n  const vows = VOWS[h.cls].filter((v) => !h.vows.includes(v.id));\n  if (vows.length && h.vows.includes(null)) {\n    const v = rng.pick(vows);\n    opts.push({ k: 'vow', vow: v.id, name: `VOW: ${v.name}`, desc: v.desc });\n  }\n  const stats = [{ k: 'stat', stat: 'power', amt: 15, name: '+15 POWER', desc: 'HIT HARDER' }, { k: 'stat', stat: 'vit', amt: 15, name: '+15 VITALITY', desc: 'STAY UP LONGER' }, { k: 'stat', stat: 'atkspd', amt: 0.08, name: '+8% ATTACK SPEED', desc: 'SWING FASTER' }];\n  rng.shuffle(stats);\n  while (opts.length < 3) opts.push(stats.pop());\n  h.pick = { t: 10, opts };\n  ev(w, { t: 'pick3', seat: h.seat, opts, level: h.level });\n}\n\nexport function applyRoundPick(w, h, i) {\n  if (!h.pick) return;\n  const o = h.pick.opts[i] ?? h.pick.opts[0];\n  h.pick = null;\n  ev(w, { t: 'pick3x', seat: h.seat, name: o.name });\n  if (o.k === 'tone') { const s = h.skills.find((x) => x?.id === o.skill); if (s) s.tone = o.tone; h.skillCache.clear(); }\n  else if (o.k === 'vow') { const idx = h.vows.indexOf(null); if (idx >= 0) h.vows[idx] = o.vow; recalcHero(w, h); }\n  else if (o.k === 'stat') {\n    const ring = h.gear.ring;\n    if (ring) ring.affixes.push({ k: o.stat, v: o.amt });\n    recalcHero(w, h);\n  }\n}\n\nexport function stepRound(w) {\n  const r = w.round;\n  if (!r) return;\n  r.playT += DT;\n  for (const h of w.heroes) {\n    if (!h.pick) continue;\n    h.pick.t -= DT;\n    if (h.pick.t <= 0) applyRoundPick(w, h, 0);\n  }\n}\n\nexport function roundBossDead(w, m) {\n  if (!w.round) return;\n  w.round.finished = true;\n  w.round.won = true;\n  ev(w, { t: 'round_won' });\n}\n\nexport const roundScore = (h) => (h.dmgDone ?? 0) / 100 + 50 * (h.revives ?? 0) + 20 * (h.eliteKills ?? 0) - 30 * (h.roundDeaths ?? 0);\n\nexport function roundResults(w, won) {\n  const heroes = w.heroes.filter((h) => !h.gone);\n  const scored = heroes.map((h) => ({ id: h.seat, score: Math.round(roundScore(h)), h }));\n  scored.sort((a, b) => b.score - a.score);\n  const standings = [];\n  for (const s of scored) {\n    const last = standings[standings.length - 1];\n    if (last && last.score === s.score) last.ids.push(s.id);\n    else standings.push({ score: s.score, ids: [s.id] });\n  }\n  const scores = Object.fromEntries(scored.map((s) => [s.id, s.score]));\n  const stats = Object.fromEntries(scored.map((s) => [s.id, { Damage: Math.round(s.h.dmgDone ?? 0), Kills: s.h.kills ?? 0, Revives: s.h.revives ?? 0, Gold: s.h.goldEarned ?? 0, Deaths: s.h.roundDeaths ?? 0 }]));\n  const top = (f) => scored.reduce((a, b) => (f(b.h) > f(a.h) ? b : a), scored[0]);\n  const awards = scored.length ? [\n    { id: top((h) => h.dmgDone ?? 0).id, title: 'Bell-Ringer', detail: 'Most damage' },\n    { id: top((h) => h.kills ?? 0).id, title: 'Undertaker', detail: 'Most kills' },\n    { id: top((h) => h.revives ?? 0).id, title: 'Good Samaritan', detail: 'Most revives' },\n    { id: top((h) => h.goldEarned ?? 0).id, title: 'Collector', detail: 'Most gold' },\n    { id: top((h) => h.roundDeaths ?? 0).id, title: 'Regular Customer', detail: 'Most deaths' },\n  ] : [];\n  return { standings: standings.map((s) => s.ids), scores, won, stats, awards };\n}\n\nexport { RULES, startRun };\nEOF\ncat > src/sim/commands.js <<'EOF'\n// Everything a menu can do to the world. Works the same from a pad, a mouse, the network or a bot.\nimport { CLASSES, VOWS } from '../data/classes.js';\nimport { AFFIXES, gemId, GEM_KINDS, LEGENDARIES, parseGem, RARITIES, SET_BY_CLASS, SETS, SLOTS, SOCKETABLE } from '../data/items.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { RULES, DIFFICULTIES } from '../data/tuning.js';\nimport { SKILLS } from '../data/skills.js';\nimport { dist, ev, toast } from './core.js';\nimport { toneUnlocked } from './effects.js';\nimport { reequip, recalcHero, slotOpen, skillUnlocked, riseAt, levelUp, gainXp, addHero, newHeroData, reviveHero } from './hero.js';\nimport { buyPrice, makeItem, makeRolledItem, rollAffixes, sellPrice, itemValue, dropItem } from './loot.js';\nimport { onTalkDone, rollWrits, ensurePyx, spawnPlate } from './quests.js';\nimport { goToGate, riseAtGate, travel } from './travel.js';\nimport { endRun, startRun } from './knell.js';\nimport { applyRoundPick } from './round.js';\nimport { killMonster, spawnElitePack, spawnMonster, monsterLevel, openSpot } from './monsters.js';\nimport { startBoss } from './bosses.js';\nimport { addObject } from './objects.js';\nimport { WARDENS } from '../data/monsters.js';\n\nexport const SALVAGE = { common: { scrap: 1 }, blessed: { scrap: 3 }, reliquary: { dust: 1 }, legendary: { shards: 1 }, set: { shards: 1 } };\nexport const CRAFT_COST = {\n  blessed: { gold: (L) => 40 + L * 12, scrap: 4 },\n  reliquary: { gold: (L) => 120 + L * 30, dust: 3, scrap: 4 },\n  legendary: { gold: (L) => 500 + L * 80, shards: 4, dust: 4 },\n};\nexport const REFORGE_COST = { gold: (L) => 60 + L * 15, dust: 1 };\nexport const CASKET_COST = { shards: 1, gold: (L) => 200 + L * 20 };\nexport const SOCKET_COST = (L) => 25 + L * 5;\n\nconst invFind = (h, uid) => h.inv.findIndex((it) => it && it.uid === uid);\n\nfunction shopRoll(w, h) {\n  const rng = w.lootRng;\n  const L = Math.max(1, h.level);\n  const stock = [];\n  for (let i = 0; i < 6; i++) {\n    const rarity = i < 2 ? 'common' : i < 4 ? 'blessed' : 'reliquary';\n    stock.push(makeRolledItem(rng, h, rarity, L));\n  }\n  h.shop = stock;\n  h.shopLevel = L;\n}\n\nexport function shopStock(w, h) {\n  if (!h.shop || h.shopLevel !== h.level) shopRoll(w, h);\n  return h.shop;\n}\n\n/** Apply one command. Returns true on success. */\nexport function applyCommand(w, seat, cmd) {\n  const h = w.heroes.find((o) => o.seat === seat);\n  if (!h && cmd.c !== 'join') return false;\n  const C = COMMANDS[cmd.c];\n  if (!C) return false;\n  return C(w, h, cmd) !== false;\n}\n\nconst COMMANDS = {\n  equip(w, h, { uid }) {\n    const i = uid ? invFind(h, uid) : -1;\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = h.gear[it.slot] ?? null;\n    h.gear[it.slot] = it;\n    if (h.newest === uid) h.newest = null;\n    reequip(w, h);\n    ev(w, { t: 'equip', seat: h.seat, name: it.name, rarity: it.rarity, slot: it.slot });\n    h.equips = (h.equips ?? 0) + 1;\n    return true;\n  },\n  equip_newest(w, h) { if (!h.newest) return false; return COMMANDS.equip(w, h, { uid: h.newest }); },\n  unequip(w, h, { slot }) {\n    const it = h.gear[slot];\n    const free = h.inv.indexOf(null);\n    if (!it || free < 0) return false;\n    h.inv[free] = it;\n    h.gear[slot] = null;\n    reequip(w, h);\n    return true;\n  },\n  drop(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = null;\n    if (h.newest === uid) h.newest = null;\n    dropItem(w, h, it, h.x + h.dirX * 1.5, h.z + h.dirZ * 1.5, 0.4).t = -1;\n    return true;\n  },\n  salvage(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = null;\n    for (const [k, v] of Object.entries(SALVAGE[it.rarity])) h.mats[k] += v;\n    for (const g of it.gems ?? []) if (g) h.gems[g] = (h.gems[g] ?? 0) + 1;\n    if (h.newest === uid) h.newest = null;\n    h.salvaged = (h.salvaged ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'salvage' });\n    return true;\n  },\n  salvage_all(w, h, { rarity }) {\n    let n = 0;\n    for (const it of [...h.inv]) if (it && it.rarity === rarity && it.uid !== h.newest) { COMMANDS.salvage(w, h, { uid: it.uid }); n++; }\n    return n > 0;\n  },\n  sell(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    h.inv[i] = null;\n    h.gold += sellPrice(it);\n    if (h.newest === uid) h.newest = null;\n    h.sold = (h.sold ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'gold' });\n    return true;\n  },\n  buy(w, h, { index }) {\n    const stock = shopStock(w, h);\n    const it = stock[index];\n    if (!it) return false;\n    const price = buyPrice(it);\n    const free = h.inv.indexOf(null);\n    if (h.gold < price || free < 0) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.gold -= price;\n    h.inv[free] = it;\n    stock[index] = null;\n    h.bought = (h.bought ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'gold' });\n    return true;\n  },\n  casket(w, h, { slot }) {\n    const L = h.level;\n    const free = h.inv.indexOf(null);\n    if (h.mats.shards < CASKET_COST.shards || h.gold < CASKET_COST.gold(L) || free < 0) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.mats.shards -= CASKET_COST.shards;\n    h.gold -= CASKET_COST.gold(L);\n    const rng = w.lootRng;\n    const r = rng.next();\n    const rarity = r < 0.05 ? 'legendary' : r < 0.45 ? 'reliquary' : 'blessed';\n    const it = rarity === 'legendary' ? makeRolledItem(rng, h, 'legendary', L) : makeItem(rng, { slot, rarity, ilvl: L, cls: h.cls });\n    h.inv[free] = it;\n    ev(w, { t: 'casket', seat: h.seat, name: it.name, rarity: it.rarity });\n    h.caskets = (h.caskets ?? 0) + 1;\n    return true;\n  },\n  craft(w, h, { slot, rarity }) {\n    const cost = CRAFT_COST[rarity];\n    const L = h.level;\n    const free = h.inv.indexOf(null);\n    if (!cost || free < 0) return false;\n    if (h.gold < cost.gold(L) || h.mats.scrap < (cost.scrap ?? 0) || h.mats.dust < (cost.dust ?? 0) || h.mats.shards < (cost.shards ?? 0)) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.gold -= cost.gold(L);\n    h.mats.scrap -= cost.scrap ?? 0; h.mats.dust -= cost.dust ?? 0; h.mats.shards -= cost.shards ?? 0;\n    const rng = w.lootRng;\n    h.inv[free] = rarity === 'legendary' ? makeRolledItem(rng, h, 'legendary', L) : makeItem(rng, { slot, rarity, ilvl: L, cls: h.cls });\n    h.crafted = (h.crafted ?? 0) + 1;\n    ev(w, { t: 'crafted', seat: h.seat, name: h.inv[free].name, rarity: h.inv[free].rarity });\n    return true;\n  },\n  reforge(w, h, { uid, slot, index }) {\n    const it = uid ? h.inv.find((x) => x?.uid === uid) ?? h.gear[slot] : h.gear[slot];\n    if (!it || !it.affixes?.[index]) return false;\n    const L = h.level;\n    if (h.gold < REFORGE_COST.gold(L) || h.mats.dust < REFORGE_COST.dust) { ev(w, { t: 'cant', seat: h.seat }); return false; }\n    h.gold -= REFORGE_COST.gold(L);\n    h.mats.dust -= REFORGE_COST.dust;\n    const keep = it.affixes.map((a) => a.k);\n    const [fresh] = rollAffixes(w.lootRng, it.slot, 1, it.ilvl, keep);\n    if (fresh) it.affixes[index] = fresh;\n    h.reforged = (h.reforged ?? 0) + 1;\n    recalcHero(w, h);\n    ev(w, { t: 'sfx', k: 'forge' });\n    return true;\n  },\n  extract(w, h, { uid }) {\n    const i = invFind(h, uid);\n    if (i < 0) return false;\n    const it = h.inv[i];\n    if (!it.power) return false;\n    h.inv[i] = null;\n    w.account.powers = w.account.powers ?? {};\n    w.account.powers[it.power] = 1;\n    h.extracted = (h.extracted ?? 0) + 1;\n    ev(w, { t: 'extract', seat: h.seat, name: LEGENDARIES[it.power].name });\n    return true;\n  },\n  reliquary(w, h, { group, power }) {\n    if (!['weapon', 'armor', 'jewel'].includes(group)) return false;\n    if (power && (!w.account.powers?.[power] || LEGENDARIES[power].group !== group)) return false;\n    h.reliquary[group] = power ?? null;\n    reequip(w, h);\n    return true;\n  },\n  socket(w, h, { uid, slot, gem, index = 0 }) {\n    const it = uid ? h.inv.find((x) => x?.uid === uid) : h.gear[slot];\n    if (!it || !it.gems || it.gems.length === 0 || !h.gems[gem]) return false;\n    const cost = SOCKET_COST(it.ilvl);\n    if (h.gold < cost) return false;\n    h.gold -= cost;\n    const old = it.gems[index];\n    if (old) h.gems[old] = (h.gems[old] ?? 0) + 1;\n    it.gems[index] = gem;\n    h.gems[gem]--;\n    h.socketed = (h.socketed ?? 0) + 1;\n    recalcHero(w, h);\n    ev(w, { t: 'sfx', k: 'socket' });\n    return true;\n  },\n  unsocket(w, h, { uid, slot, index = 0 }) {\n    const it = uid ? h.inv.find((x) => x?.uid === uid) : h.gear[slot];\n    if (!it?.gems?.[index]) return false;\n    h.gems[it.gems[index]] = (h.gems[it.gems[index]] ?? 0) + 1;\n    it.gems[index] = null;\n    recalcHero(w, h);\n    return true;\n  },\n  merge(w, h, { gem }) {\n    const { kind, tier } = parseGem(gem);\n    if (tier >= 2 || (h.gems[gem] ?? 0) < 3) return false;\n    h.gems[gem] -= 3;\n    const next = gemId(kind, tier + 1);\n    h.gems[next] = (h.gems[next] ?? 0) + 1;\n    h.merged = (h.merged ?? 0) + 1;\n    ev(w, { t: 'sfx', k: 'socket' });\n    return true;\n  },\n  stash_put(w, h, { uid, tab }) {\n    const i = invFind(h, uid);\n    const t = w.account.stash[tab];\n    if (i < 0 || !t) return false;\n    const free = t.indexOf(null);\n    if (free < 0) return false;\n    t[free] = h.inv[i];\n    h.inv[i] = null;\n    h.stashed = (h.stashed ?? 0) + 1;\n    return true;\n  },\n  stash_take(w, h, { tab, index }) {\n    const t = w.account.stash[tab];\n    const free = h.inv.indexOf(null);\n    if (!t?.[index] || free < 0) return false;\n    h.inv[free] = t[index];\n    t[index] = null;\n    return true;\n  },\n  skill(w, h, { slot, id }) {\n    if (!slotOpen(h, slot)) return false;\n    if (id && !skillUnlocked(h, id)) return false;\n    if (id) {\n      const other = h.skills.findIndex((s) => s?.id === id);\n      if (other >= 0 && other !== slot) { h.skills[other] = h.skills[slot] ?? null; }\n    }\n    h.skills[slot] = id ? { id, tone: h.toneMemory?.[id] ?? null } : null;\n    h.slotChanged = (h.slotChanged ?? 0) + 1;\n    h.skillCache.clear();\n    if (w.camp) w.camp.skillsSet = (w.camp.skillsSet ?? 0) + 1;\n    return true;\n  },\n  tone(w, h, { id, tone }) {\n    const s = h.skills.find((x) => x?.id === id);\n    if (tone && !toneUnlocked(h, id, tone)) return false;\n    h.toneMemory = h.toneMemory ?? {};\n    h.toneMemory[id] = tone ?? null;\n    if (s) s.tone = tone ?? null;\n    h.skillCache.clear();\n    delete h.charges[id];\n    h.tonesSet = (h.tonesSet ?? 0) + 1;\n    return true;\n  },\n  vow(w, h, { index, id }) {\n    if (h.level < RULES.vowLevels[index]) return false;\n    if (id && !VOWS[h.cls].some((v) => v.id === id)) return false;\n    if (id && h.vows.includes(id)) h.vows[h.vows.indexOf(id)] = null;\n    h.vows[index] = id ?? null;\n    recalcHero(w, h);\n    h.vowsSet = (h.vowsSet ?? 0) + 1;\n    return true;\n  },\n  devotion(w, h, { track, stat }) {\n    const d = w.account.devotion;\n    if (d.points <= 0) return false;\n    d.points--;\n    d.spent[track] = d.spent[track] ?? [0, 0, 0, 0];\n    d.spent[track][stat]++;\n    for (const o of w.heroes) recalcHero(w, o);\n    return true;\n  },\n  devotion_reset(w) {\n    const d = w.account.devotion;\n    for (const k of Object.keys(d.spent)) { for (const n of d.spent[k]) d.points += n; d.spent[k] = [0, 0, 0, 0]; }\n    for (const o of w.heroes) recalcHero(w, o);\n    return true;\n  },\n  talk_done(w, h, { npc }) { onTalkDone(w, h, npc); return true; },\n  travel(w, h, { key, zone, floor }) {\n    const safe = w.zone.def.safe || usableGate(w, h);\n    if (!safe) return false;\n    if (key) return goToGate(w, key);\n    if (!zoneOpen(w, zone)) return false;\n    travel(w, zone, floor ?? 0, 'start');\n    return true;\n  },\n  rise(w, h, { how }) {\n    if (!h.dead) return false;\n    if (how === 'here') {\n      if (h.deadT < (h.deathWait ?? 5)) return false;\n      riseAt(w, h, 'here');\n      return true;\n    }\n    riseAtGate(w, h, how);\n    return true;\n  },\n  difficulty(w, h, { index }) {\n    const d = DIFFICULTIES[index];\n    if (!d) return false;\n    if (d.penance && !w.account.unlocks.penance) return false;\n    w.difficulty = index;\n    w.diffDef = d;\n    ev(w, { t: 'toast', text: `DIFFICULTY: ${d.name}`, color: 'sand' });\n    if (w.camp) w.camp.difficulty = index;\n    return true;\n  },\n  writs(w) { rollWrits(w); return true; },\n  knell_start(w, h, { mods, grand, tier }) {\n    if (!w.account.unlocks.knell) return false;\n    if (grand) {\n      if ((h.grandKeys ?? 0) <= 0) return false;\n      h.grandKeys--;\n    }\n    startRun(w, { mods, grand, tier });\n    return true;\n  },\n  run_home(w) { endRun(w); travel(w, 'town', 0, 'start'); return true; },\n  cycle_use(w, h) { h.useSel = (h.useSel ?? 0) + 1; return true; },\n  pick3(w, h, { i }) { applyRoundPick(w, h, i); return true; },\n  ...devCommands(),\n};\n\nexport const usableGate = (w, h) => w.objects.some((o) => o.kind === 'lychgate' && dist(o.x, o.z, h.x, h.z) < RULES.interactRange + 1);\nexport function zoneOpen(w, zone) {\n  const f = w.camp?.flags ?? {};\n  return { causeway: f.open_causeway, ossuary: f.open_ossuary, cloister: f.open_cloister, belfry: f.open_belfry, pantry: f.overdue_open && w.camp.visited['pantry:0'], town: true, yard: true }[zone] ?? false;\n}\n\n// ---- Dev mode ---------------------------------------------------------------------------------\nfunction devCommands() {\n  return {\n    dev_level(w, h, { n }) { for (let i = 0; i < (n ?? 1) && h.level < RULES.levelCap; i++) levelUp(w, h, true); h.xp = 0; return true; },\n    dev_level_max(w, h) { while (h.level < RULES.levelCap) levelUp(w, h, true); h.xp = 0; return true; },\n    dev_gold(w, h, { n }) { h.gold += n ?? 10000; return true; },\n    dev_mats(w, h) { h.mats.scrap += 50; h.mats.dust += 30; h.mats.shards += 20; h.grandKeys = (h.grandKeys ?? 0) + 3; return true; },\n    dev_item(w, h, { slot, rarity }) {\n      const free = h.inv.indexOf(null);\n      if (free < 0) return false;\n      h.inv[free] = rarity === 'legendary' || rarity === 'set' ? makeRolledItem(w.lootRng, h, rarity, h.level, slot) : makeItem(w.lootRng, { slot, rarity, ilvl: h.level, cls: h.cls });\n      return true;\n    },\n    dev_legendary(w, h, { id }) {\n      const free = h.inv.indexOf(null);\n      if (free < 0) return false;\n      h.inv[free] = makeItem(w.lootRng, { rarity: 'legendary', ilvl: h.level, cls: h.cls, legendary: id });\n      return true;\n    },\n    dev_set(w, h, { set, slot }) {\n      const free = h.inv.indexOf(null);\n      if (free < 0) return false;\n      const s = set ?? SET_BY_CLASS[h.cls];\n      h.inv[free] = makeItem(w.lootRng, { slot: slot ?? 'head', rarity: 'set', ilvl: h.level, cls: h.cls, set: s });\n      return true;\n    },\n    dev_gems(w, h) { for (const k of Object.keys(GEM_KINDS)) for (let t = 0; t < 3; t++) { const id = gemId(k, t); h.gems[id] = (h.gems[id] ?? 0) + 3; } return true; },\n    dev_spawn(w, h, { type, n, elite, aff }) {\n      const def = MONSTERS[type];\n      if (!def) return false;\n      if (elite) {\n        spawnElitePack(w, { x: h.x + h.dirX * 5, z: h.z + h.dirZ * 5 }, null, { kind: elite, type, aff: aff?.length ? aff : ['tolling'] });\n        return true;\n      }\n      for (let i = 0; i < (n ?? 1); i++) { const p = openSpot(w, h.x + h.dirX * 5, h.z + h.dirZ * 5, 2); spawnMonster(w, type, p.x, p.z, { state: 'chase' }); }\n      return true;\n    },\n    dev_boss(w, h, { type }) { const p = openSpot(w, h.x + h.dirX * 6, h.z + h.dirZ * 6, 1); startBoss(w, type, p.x, p.z, { noIntro: true }); return true; },\n    dev_plate(w, h) { const p = openSpot(w, h.x + h.dirX * 5, h.z + h.dirZ * 5, 1); spawnPlate(w, p.x, p.z); return true; },\n    dev_coffin(w, h) { addObject(w, 'coffin', h.x + h.dirX * 2.5, h.z + h.dirZ * 2.5, { time: 45, count: 7, announce: true }); return true; },\n    dev_kill_all(w, h) { for (const m of w.monsters) if (!m.dead) killMonster(w, m, h, {}); return true; },\n    dev_goto(w, h, { zone, floor }) { travel(w, zone, floor ?? 0, 'start'); return true; },\n    dev_quest(w, h, { i, s }) {\n      w.camp.q.i = i; w.camp.q.s = s ?? 0;\n      w.camp.flags.open_causeway = i >= 1 ? 1 : w.camp.flags.open_causeway;\n      w.camp.flags.open_ossuary = i >= 2 ? 1 : w.camp.flags.open_ossuary;\n      w.camp.flags.open_cloister = i >= 3 ? 1 : w.camp.flags.open_cloister;\n      w.camp.flags.open_belfry = i >= 4 ? 1 : w.camp.flags.open_belfry;\n      if (i >= 2) { w.camp.flags.forge = 1; w.camp.flags.brasse_met = 1; w.camp.flags.brasse_home = 1; w.camp.flags.pyx = 1; }\n      if (i >= 3) { w.camp.flags.reliquary = 1; }\n      ev(w, { t: 'quest', name: 'DEV', text: `QUEST ${i}.${s ?? 0}`, id: 'dev' });\n      return true;\n    },\n    dev_knell_fill(w) { if (w.run?.state === 'fill') { w.run.meter = w.run.total - 1; ev(w, { t: 'knell', v: w.run.meter, of: w.run.total }); return true; } return false; },\n    dev_knell_start(w, h) { w.account.unlocks.knell = true; w.account.unlocks.penance = true; startRun(w, {}); return true; },\n    dev_next_phase(w) {\n      const m = w.boss;\n      if (!m) return false;\n      const b = m.bossState;\n      if (m.def.boss === 'malison') { m.hp = b.phase === 1 ? m.maxHp * 0.59 : m.maxHp * 0.24; return true; }\n      m.hp = Math.max(1, m.hp - m.maxHp * 0.5);\n      return true;\n    },\n    dev_reveal(w) { w.zone.seen.fill(1); return true; },\n    dev_reroll(w, h, { seed }) { w.rerollSeed = seed; return true; },\n    dev_scale(w, h, { k, v }) { w.tuning[k] = v; for (const o of w.heroes) recalcHero(w, o); return true; },\n    dev_cheat(w, h, { k, v }) { w.cheats[k] = v; return true; },\n    dev_revive(w, h) { for (const o of w.heroes) if (o.dead) reviveHero(w, o, 1); return true; },\n  };\n}\n\nexport { AFFIXES, SETS, SLOTS, SOCKETABLE, SKILLS, CLASSES, RARITIES, itemValue, gainXp, addHero, newHeroData, ensurePyx, monsterLevel, toast, WARDENS, buyPrice, sellPrice };\nEOF\ncat > src/sim/world.js <<'EOF'\n// The world: one object for a whole session, one step function. Solo is a party of one.\nimport { Rng } from '../../pixel-engine.js';\nimport { defaultTuning, DIFFICULTIES, RULES } from '../data/tuning.js';\nimport { DT, dist, ev } from './core.js';\nimport { spawnArea, stepObstacles, stepSched, endShot, spawnShot, gainRes, healHero, resolveSkill, applyHit, runOps, addBuff } from './effects.js';\nimport { stepEnemyArea } from './hazards.js';\nimport { addHero, heroToData, hurtHero, stepHero, stepRevives } from './hero.js';\nimport { EMPTY_INTENT } from './intents.js';\nimport { stepDrops } from './loot.js';\nimport { damageMonster, stepAllies, stepMonsters, monsterLevel } from './monsters.js';\nimport { stepObjects } from './objects.js';\nimport { newCampaign, questInit, stepQuests } from './quests.js';\nimport { stepRound } from './round.js';\nimport { loadZone, riseAtGate } from './travel.js';\nimport { computeHit } from './effects.js';\n\nexport function newAccount() {\n  return {\n    stash: Array.from({ length: RULES.stashTabs }, () => Array(RULES.stashSize).fill(null)),\n    devotion: { level: 0, xp: 0, points: 0, spent: { core: [0, 0, 0, 0], offence: [0, 0, 0, 0], defence: [0, 0, 0, 0], utility: [0, 0, 0, 0] } },\n    unlocks: { knell: false, penance: false }, bests: {}, powers: {},\n  };\n}\n\nexport function createWorld(o = {}) {\n  const seed = o.seed ?? 1;\n  const w = {\n    seed, root: new Rng(seed), t: 0, time: 0, nextId: 1, tuning: { ...defaultTuning(), ...(o.tuning ?? {}) }, difficulty: o.difficulty ?? 0, diffDef: DIFFICULTIES[o.difficulty ?? 0],\n    heroes: [], monsters: [], allies: [], shots: [], areas: [], drops: [], objects: [], props: [], graves: [], obstacles: [], sched: [], events: [], hash: new Map(), zone: null, boss: null, coffin: null,\n    cheats: { god: false, oneHit: false, noCd: false, infRes: false, noClip: false, invisible: false }, account: o.account ?? newAccount(), camp: o.camp === undefined ? newCampaign() : o.camp, run: null, round: null, pendingZone: null, graveLife: RULES.graveLife,\n    mode: o.mode ?? 'campaign',\n  };\n  w.rng = w.root.fork('sim');\n  w.lootRng = w.root.fork('loot');\n  w.resolveSkillOp = (h, id, tone) => resolveSkill(h, id, tone).fx[0];\n  return w;\n}\n\nexport function stepWorld(w, intents = []) {\n  w.t++;\n  w.time = w.t * DT;\n  stepRound(w);\n  stepHeroAreas(w);\n  for (const h of w.heroes) stepHero(w, h, intents[h.seat] ?? EMPTY_INTENT);\n  stepRevives(w, intents);\n  stepMonsters(w);\n  stepAllies(w);\n  stepShots(w);\n  stepAreas(w);\n  stepObstacles(w);\n  stepSched(w);\n  stepDrops(w);\n  stepObjects(w);\n  stepGraves(w);\n  stepQuests(w);\n  markSeen(w);\n  if (w.pendingRise) { const pr = w.pendingRise; w.pendingRise = null; const h = w.heroes.find((o) => o.seat === pr.seat); if (h) riseAtGate(w, h, pr.how); }\n  if (w.pendingZone) {\n    const p = w.pendingZone;\n    w.pendingZone = null;\n    loadZone(w, p.zone, p.floor, p.entry);\n  }\n}\n\nfunction stepGraves(w) {\n  for (let i = w.graves.length - 1; i >= 0; i--) {\n    const g = w.graves[i];\n    g.t -= DT;\n    if (g.t <= 0) { ev(w, { t: 'gravex', id: g.id }); w.graves.splice(i, 1); }\n  }\n}\n\nfunction stepHeroAreas(w) {\n  for (const h of w.heroes) { h.areaDr = 0; h.areaDmg = 0; h.areaRegen = 0; h.areaStun = false; }\n  for (const m of w.monsters) { m.slowFromArea = 0; m.vuln = 0; }\n  for (const a of w.areas) {\n    if (a.team === 1) continue;\n    if (!(a.allyDr || a.allyDmg || a.allyRegen || a.allyStunImmune || a.enemySlow || a.enemyVuln)) continue;\n    for (const h of w.heroes) {\n      if (h.dead || h.gone || dist(h.x, h.z, a.x, a.z) > a.r) continue;\n      h.areaDr = Math.max(h.areaDr, a.allyDr); h.areaDmg = Math.max(h.areaDmg, a.allyDmg); h.areaRegen = Math.max(h.areaRegen, a.allyRegen);\n      if (a.allyStunImmune) h.areaStun = true;\n    }\n    if (a.enemySlow || a.enemyVuln) {\n      for (const m of w.monsters) {\n        if (m.dead || dist(m.x, m.z, a.x, a.z) > a.r + m.r) continue;\n        m.slowFromArea = Math.max(m.slowFromArea, a.enemySlow); m.vuln = Math.max(m.vuln, a.enemyVuln);\n      }\n    }\n  }\n}\n\nfunction stepShots(w) {\n  for (let i = w.shots.length - 1; i >= 0; i--) {\n    const s = w.shots[i];\n    s.life -= DT;\n    if (s.tgt) {\n      const t = w.monsters.find((m) => m.id === s.tgt && !m.dead);\n      if (t) {\n        const dx = t.x - s.x, dz = t.z - s.z, l = Math.hypot(dx, dz) || 1;\n        s.vx += ((dx / l) * s.speed - s.vx) * 0.12;\n        s.vz += ((dz / l) * s.speed - s.vz) * 0.12;\n      }\n    }\n    s.x += s.vx * DT;\n    s.z += s.vz * DT;\n    if (s.life <= 0 || !w.zone.nav.walkable(s.x, s.z) && !isPit(w, s.x, s.z)) { endShot(w, i, s, false); continue; }\n    if (s.team === 1) {\n      if (w.areas.some((a) => a.stopsShots && dist(a.x, a.z, s.x, s.z) <= a.r)) { endShot(w, i, s, false); continue; }\n      let hit = false;\n      for (const h of w.heroes) {\n        if (h.dead || h.gone || dist(h.x, h.z, s.x, s.z) > h.r + s.r) continue;\n        if (h.state === 'dodge' || h.invuln > 0) continue;\n        hurtHero(w, h, s.dmg, { src: null, el: s.el });\n        hit = true;\n        break;\n      }\n      if (hit) { endShot(w, i, s, true); continue; }\n      continue;\n    }\n    const h = w.heroes.find((o) => o.id === s.owner);\n    if (!h) { endShot(w, i, s, false); continue; }\n    let done = false;\n    for (const m of w.monsters) {\n      if (m.dead || m.hidden || (s.hit && s.hit.has(m.id))) continue;\n      const rr = s.r + m.r;\n      if ((m.x - s.x) ** 2 + (m.z - s.z) ** 2 > rr * rr) continue;\n      const c = { x: s.x - s.vx * 0.02, z: s.z - s.vz * 0.02, dx: s.vx / s.speed, dz: s.vz / s.speed, sk: s.sk ?? null, mult: s.mult, kills: 0 };\n      applyHit(w, h, m, s.op, c);\n      if (s.op?.forkOnKill && c.kills > 0) {\n        const n = s.op.forkOnKill;\n        const base = Math.atan2(s.vz, s.vx);\n        for (let k = 0; k < n; k++) {\n          const a = base + (k === 0 ? -0.5 : 0.5);\n          const fork = spawnShot(w, { owner: h.id, team: 0, kind: s.kind, x: s.x, z: s.z, dx: Math.cos(a), dz: Math.sin(a), speed: s.speed, range: 10, op: { ...s.op, forkOnKill: 0 }, sk: s.sk });\n          fork.hit = new Set([m.id]);\n        }\n      }\n      if (s.pierce > 0) { s.pierce--; (s.hit ??= new Set()).add(m.id); }\n      else { done = true; }\n      break;\n    }\n    if (done) { endShot(w, i, s, true); continue; }\n    if (w.props.length) {\n      for (const p of w.props) {\n        if (p.broken || (p.x - s.x) ** 2 + (p.z - s.z) ** 2 > 0.5) continue;\n        import_breakProp(w, p, s.x, s.z, h);\n        endShot(w, i, s, true);\n        done = true;\n        break;\n      }\n    }\n  }\n}\n\nimport { breakProp as import_breakProp } from './objects.js';\n\nconst isPit = (w, x, z) => {\n  const row = w.zone.rows[Math.floor(z)];\n  const ch = row?.[Math.floor(x)];\n  return ch === '~';\n};\n\nfunction stepAreas(w) {\n  for (let i = w.areas.length - 1; i >= 0; i--) {\n    const a = w.areas[i];\n    if (a.team === 1) { stepEnemyArea(w, a, i); continue; }\n    a.t += DT;\n    if (a.follow) { const h = w.heroes.find((o) => o.id === a.follow); if (h && !h.dead) { a.x = h.x; a.z = h.z; ev2follow(w, a); } }\n    if (a.followTarget) {\n      const m = w.monsters.find((o) => o.id === a.followTarget && !o.dead);\n      if (m) { a.x = m.x; a.z = m.z; ev2follow(w, a); }\n    }\n    if (a.t >= a.nextTick) {\n      a.nextTick += a.tick;\n      const h = a.h;\n      if (a.dmg && h && !h.gone) {\n        for (const m of w.monsters) {\n          if (m.dead || m.hidden || dist(m.x, m.z, a.x, a.z) > a.r + m.r) continue;\n          const [d, crit] = computeHit(w, h, m, a.dmg, a.el, null);\n          damageMonster(w, m, d, { src: h, crit, el: a.el, dot: true });\n        }\n      }\n      if (a.drag) for (const m of w.monsters) {\n        if (m.dead || m.def.static || m.def.huge || dist(m.x, m.z, a.x, a.z) > a.r + 1) continue;\n        const dx = a.x - m.x, dz = a.z - m.z, l = Math.hypot(dx, dz) || 1;\n        m.kx += (dx / l) * a.drag; m.kz += (dz / l) * a.drag;\n      }\n      if (a.allyHeal) for (const o of w.heroes) if (!o.dead && !o.gone && dist(o.x, o.z, a.x, a.z) <= a.r) healHero(w, o, a.allyHeal * a.tick);\n    }\n    if (a.t >= a.life) {\n      w.areas.splice(i, 1);\n      ev(w, { t: 'areax', id: a.id });\n      if (a.endBlast && a.h && !a.h.gone) runOps(w, a.h, [{ op: 'ring', radius: a.endBlast.radius, dmg: a.endBlast.dmg, el: a.endBlast.el, vfx: 'fire_burst', sfx: 'blast', shake: 0.4, wave: true }], { x: a.x, z: a.z, dx: 0, dz: 1, sk: null });\n    }\n  }\n}\n\nfunction ev2follow(w, a) { if (w.t % 6 === 0) ev(w, { t: 'areamove', id: a.id, x: a.x, z: a.z }); }\n\nfunction markSeen(w) {\n  if (w.t % 20 !== 0) return;\n  const z = w.zone;\n  for (const h of w.heroes) {\n    if (h.gone) continue;\n    const cx = Math.floor(h.x), cz = Math.floor(h.z), R = 12;\n    for (let j = Math.max(0, cz - R); j <= Math.min(z.h - 1, cz + R); j++) {\n      for (let i = Math.max(0, cx - R); i <= Math.min(z.w - 1, cx + R); i++) {\n        if ((i - cx) ** 2 + (j - cz) ** 2 <= R * R) z.seen[j * z.w + i] = 1;\n      }\n    }\n  }\n}\n\n/** The save-relevant state of a hero and campaign. */\nexport function worldHash(w) {\n  let s = `${w.t}|${w.zone?.id}|${w.zone?.floor}|${w.nextId}|${w.rng.state}|${w.lootRng.state}`;\n  for (const h of w.heroes) s += `|${h.x.toFixed(3)},${h.z.toFixed(3)},${h.hp.toFixed(2)},${h.level},${Math.round(h.xp)},${h.gold}`;\n  s += `|m${w.monsters.length}`;\n  for (const m of w.monsters) s += `,${m.x.toFixed(2)},${m.z.toFixed(2)},${Math.round(m.hp)}`;\n  let hash = 5381;\n  for (let i = 0; i < s.length; i++) hash = ((hash * 33) ^ s.charCodeAt(i)) >>> 0;\n  return hash.toString(16);\n}\n\nexport function beginCampaign(w, heroDatas, o = {}) {\n  heroDatas.forEach((d, seat) => addHero(w, d, seat, { navIndex: seat }));\n  const start = o.zone ?? 'yard';\n  loadZone(w, start, o.floor ?? 0, 'start');\n  if (!o.noQuestInit) questInit(w);\n}\n\nexport { heroToData, addHero, loadZone, monsterLevel, spawnArea, gainRes, addBuff };\nEOF\ncat > .scratch/simtest.mjs <<'EOF'\nimport { createWorld, stepWorld, beginCampaign } from '../src/sim/world.js';\nimport { newHeroData } from '../src/sim/hero.js';\nconst w = createWorld({seed: 7});\nbeginCampaign(w,[newHeroData('bellwarden','TEST')]);\nfor (let i=0;i<600;i++){ stepWorld(w,[{mx:1,mz:0,ax:0,az:0,aimed:0,tgt:0,held:1,pressed:0,goal:null}]); w.events.length=0; }\nconsole.log(w.zone.id,w.t,w.heroes[0].x,w.heroes[0].level,w.monsters.length, w.heroes[0].hp);\nprocess.exit(0);\nEOF\ntimeout 60 node .scratch/simtest.mjs 2>&1 | tail -n 12 | cut -c1-400","description":"Write bosses, quests, knell, round, commands, world and smoke test","timeout":90000}}}
