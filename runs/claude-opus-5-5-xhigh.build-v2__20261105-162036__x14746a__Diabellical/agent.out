n      box(0.24, 0.26, 0.24, [0, 1.75, 0], 'glow', { glow: true }),\n      { mirror: [box(0.5, 0.3, 0.5, [1.1, 0.15, 0.5], 'stone')], axis: 'x' }, { mirror: [box(0.5, 0.3, 0.5, [1.1, 0.15, -0.5], 'stone')], axis: 'x' },\n    ] }),\n  model({ id: 'knell_font', about: 'The Knell Font: a black water basin that hums when the bell is near', tags: ['prop', 'gothic'], palette: { stone: 'night', water: 'cyan', trim: 'orange', glow: 'sky' },\n    parts: [{ cyl: [1.8, 0.28, 1.8], at: [0, 0.14, 0], c: 'stone', seg: 8 }, { cyl: [0.7, 0.7, 0.7], at: [0, 0.62, 0], c: 'stone', seg: 8 }, { lathe: [[0.3, 0.9], [0.95, 1.1], [1.05, 1.34], [0.85, 1.32], [0.3, 1.14], [0, 1.14]], at: [0, 0, 0], c: 'stone' }, { cyl: [1.7, 0.05, 1.7], at: [0, 1.28, 0], c: 'water', glow: true, seg: 10 }, { torus: [1.3, 0.08, 1.3], at: [0, 2.2, 0], c: 'trim', glow: true, seg: 10 }, box(0.08, 0.6, 0.08, [0, 1.85, 0], 'glow', { glow: true })] }),\n  model({ id: 'votive_rack', about: 'A rack of votive candles, one use, a blessing', tags: ['prop', 'church'], palette: { iron: 'slate', wax: 'white', flame: 'orange', dark: 'ink' },\n    parts: [box(1.2, 0.08, 0.5, [0, 0.9, 0], 'iron'), box(1.2, 0.08, 0.5, [0, 0.5, 0.12], 'iron'), { mirror: [box(0.08, 1.1, 0.08, [0.56, 0.55, 0], 'iron')], axis: 'x' },\n      ...[-0.42, -0.14, 0.14, 0.42].flatMap((x) => [box(0.09, 0.18, 0.09, [x, 1.03, 0], 'wax'), box(0.05, 0.1, 0.05, [x, 1.17, 0], 'flame', { glow: true })]),\n      ...[-0.3, 0, 0.3].flatMap((x) => [box(0.09, 0.14, 0.09, [x, 0.61, 0.12], 'wax'), box(0.05, 0.1, 0.05, [x, 0.73, 0.12], 'flame', { glow: true })]),\n      box(0.3, 0.4, 0.06, [0, 1.3, -0.2], 'dark')] }),\n  model({ id: 'votive_rack_spent', about: 'A rack of votive candles, all burned out', tags: ['prop', 'church'], palette: { iron: 'slate', wax: 'mist', dark: 'ink' },\n    parts: [box(1.2, 0.08, 0.5, [0, 0.9, 0], 'iron'), box(1.2, 0.08, 0.5, [0, 0.5, 0.12], 'iron'), { mirror: [box(0.08, 1.1, 0.08, [0.56, 0.55, 0], 'iron')], axis: 'x' }, ...[-0.42, -0.14, 0