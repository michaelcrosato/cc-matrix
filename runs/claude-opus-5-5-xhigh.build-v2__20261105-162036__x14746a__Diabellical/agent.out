{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkhdXL47cfoUFa7rcPXQ","type":"message","role":"assistant","content":[{"type":"text","text":"Now the view layer: the effects kit, zone builder and actors."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9393,"cache_read_input_tokens":517754,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9393},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"37058816-5543-4d33-8574-58e6c7338d34","timestamp":"2026-11-06T00:08:59.105Z","request_id":"req_011CgkhdX2wEZ7v9tRCHRFL6"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkhdXL47cfoUFa7rcPXQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UeJJzDWGZeJH1v6CJ2QWAn","name":"Bash","input":{"command":"sed -i \"s/wall: 'brick-wall', wallH: 2.6/wall: 'bricks', wallH: 2.6/; s/decor: \\['barrel', 'crate', 'sack', 'bench', 'planter', 'hitching-post', 'clothesline'\\]/decor: ['barrel', 'crate', 'sack', 'park-bench', 'planter', 'hitching-post', 'bucket']/\" src/data/zones.js\ncat > src/view/fxkit.js <<'EOF'\n// Flat, unlit shapes on the ground: rings, sectors, bolts, pillars. All cheap and all palette.\nimport { glowMaterial, PALETTE, THREE } from '../../pixel-engine.js';\n\nconst { BoxGeometry, CircleGeometry, Group, Mesh, RingGeometry, BufferGeometry, BufferAttribute } = THREE;\n\nconst flat = (g) => { g.rotateX(-Math.PI / 2); return g; };\nconst GEO = {\n  ring: flat(new RingGeometry(0.88, 1, 40)),\n  thin: flat(new RingGeometry(0.95, 1, 48)),\n  disc: flat(new CircleGeometry(1, 32)),\n  box: new BoxGeometry(1, 1, 1),\n  quad: flat(new THREE.PlaneGeometry(1, 1)),\n};\nconst glow = (c) => glowMaterial(typeof c === 'number' ? c : PALETTE[c] ?? PALETTE.white);\nexport const mat = glow;\n\nconst ease = (t) => 1 - (1 - t) ** 3;\n\nexport class FxKit {\n  constructor(scene) {\n    this.group = new Group();\n    this.group.name = 'fx';\n    scene.add(this.group);\n    this.live = [];\n  }\n\n  _add(mesh, o) {\n    this.group.add(mesh);\n    const e = { mesh, t: 0, dur: 0.3, ...o };\n    this.live.push(e);\n    return e;\n  }\n\n  ring(x, z, r, color, dur = 0.35, o = {}) {\n    const m = new Mesh(GEO[o.thin ? 'thin' : 'ring'], glow(color));\n    m.position.set(x, o.y ?? 0.08, z);\n    m.scale.setScalar(0.1);\n    return this._add(m, { dur, grow: r, kind: 'ring' });\n  }\n\n  disc(x, z, r, color, dur = 0.3, o = {}) {\n    const m = new Mesh(GEO.disc, glow(color));\n    m.position.set(x, o.y ?? 0.06, z);\n    m.scale.setScalar(o.grow ? 0.1 : r);\n    return this._add(m, { dur, grow: o.grow ? r : 0, shrink: o.shrink ? r : 0, kind: 'disc' });\n  }\n\n  /** A pie slice, facing (dx, dz). */\n  sector(x, z, dx, dz, r, angleDeg, color, dur = 0.14, o = {}) {\n    const a = (Math.min(angleDeg || 120, 359) * Math.PI) / 180;\n    const inner = o.inner ?? 0.55;\n    const g = new RingGeometry(inner, 1, 16, 1, -a / 2, a);\n    g.rotateX(-Math.PI / 2);\n    g.rotateY(-Math.atan2(dz, dx));\n    const m = new Mesh(g, glow(color));\n    m.position.set(x, o.y ?? 0.5, z);\n    m.scale.setScalar(r * 0.6);\n    return this._add(m, { dur, grow: r, own: true, kind: 'sector' });\n  }\n\n  bolt(x1, z1, x2, z2, color, dur = 0.1, o = {}) {\n    const m = new Mesh(GEO.box, glow(color));\n    const dx = x2 - x1, dz = z2 - z1, L = Math.hypot(dx, dz) || 0.01;\n    m.position.set((x1 + x2) / 2, o.y ?? 0.9, (z1 + z2) / 2);\n    m.rotation.y = Math.atan2(dx, dz);\n    m.scale.set(o.w ?? 0.1, o.w ?? 0.1, L);\n    return this._add(m, { dur, kind: 'bolt', thin: o.w ?? 0.1 });\n  }\n\n  pillar(x, z, color, h, dur = 0.4, o = {}) {\n    const m = new Mesh(GEO.box, glow(color));\n    const w = o.w ?? 0.4;\n    m.position.set(x, h / 2, z);\n    m.scale.set(w, h, w);\n    return this._add(m, { dur, kind: 'pillar', w, h });\n  }\n\n  update(dt) {\n    for (let i = this.live.length - 1; i >= 0; i--) {\n      const e = this.live[i];\n      e.t += dt;\n      const f = Math.min(1, e.t / e.dur);\n      const m = e.mesh;\n      if (e.kind === 'ring') m.scale.setScalar(Math.max(0.05, ease(f) * e.grow));\n      else if (e.kind === 'sector') m.scale.setScalar(e.grow * (0.6 + 0.4 * ease(f)));\n      else if (e.kind === 'disc' && e.grow) m.scale.setScalar(Math.max(0.05, ease(f) * e.grow));\n      else if (e.kind === 'disc' && e.shrink) m.scale.setScalar(Math.max(0.01, (1 - f) * e.shrink));\n      else if (e.kind === 'bolt') { const th = e.thin * (1 - f * 0.8); m.scale.x = th; m.scale.y = th; }\n      else if (e.kind === 'pillar') { const w = e.w * (1 - f); m.scale.x = Math.max(0.01, w); m.scale.z = Math.max(0.01, w); }\n      if (f >= 1) {\n        this.group.remove(m);\n        if (e.own) m.geometry.dispose();\n        this.live.splice(i, 1);\n      }\n    }\n  }\n\n  clear() {\n    for (const e of this.live) { this.group.remove(e.mesh); if (e.own) e.mesh.geometry.dispose(); }\n    this.live.length = 0;\n  }\n}\n\n/** A ring with a gap whose radius changes each frame (a stored, updated strip). */\nexport class WaveRing {\n  constructor(color, gapA, gapW, segs = 48) {\n    this.segs = segs;\n    this.gapA = gapA; this.gapW = gapW;\n    const n = (segs + 1) * 2;\n    const g = new BufferGeometry();\n    this.pos = new Float32Array(n * 3);\n    g.setAttribute('position', new BufferAttribute(this.pos, 3));\n    g.setAttribute('normal', new BufferAttribute(new Float32Array(n * 3).fill(0).map((_, i) => (i % 3 === 1 ? 1 : 0)), 3));\n    const idx = [];\n    for (let i = 0; i < segs; i++) { const a = i * 2; idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2); }\n    g.setIndex(idx);\n    this.mesh = new Mesh(g, glow(color));\n    this.mesh.frustumCulled = false;\n  }\n  set(x, z, r, thick) {\n    const full = Math.PI * 2 - this.gapW;\n    const start = this.gapA + this.gapW / 2;\n    for (let i = 0; i <= this.segs; i++) {\n      const a = start + (i / this.segs) * full;\n      const c = Math.cos(a), s = Math.sin(a);\n      this.pos.set([x + c * (r + thick), 0.1, z + s * (r + thick), x + c * Math.max(0, r - thick), 0.1, z + s * Math.max(0, r - thick)], i * 6);\n    }\n    this.mesh.geometry.attributes.position.needsUpdate = true;\n  }\n  dispose() { this.mesh.geometry.dispose(); }\n}\n\nexport const GROUND_GEO = GEO;\nEOF\ncat > src/view/zonebuild.js <<'EOF'\n// Builds the look of a zone from its grid. Same seed, same dressing, on every client.\nimport { addModelColliders, buildModel, DEFAULT_TEXEL, disposeObject, glowMaterial, groundFog, mergeStaticMeshes, PALETTE, Precipitation, Rng, setLookLayer, TEXTURE_LIBRARY, textureMap, THREE, toonMaterial, WaterSurface, WAVES_CALM } from '../../pixel-engine.js';\nimport { BIOME_FLOORS, BIOMES } from '../data/zones.js';\nimport { MODELS } from './models/index.js';\n\nconst { BoxGeometry, Color, Group, Mesh, PlaneGeometry } = THREE;\n\nconst isFloor = (c) => c !== undefined && c !== '#' && c !== '~' && c !== ' ' && c !== 'P';\nconst tileOf = (id) => (TEXTURE_LIBRARY.get(id).size[0] ?? 16) / DEFAULT_TEXEL;\n\nfunction worldUv(geo, ox, oy, oz, tile) {\n  const pos = geo.attributes.position, nor = geo.attributes.normal, uv = geo.attributes.uv;\n  for (let i = 0; i < pos.count; i++) {\n    const x = pos.getX(i) + ox, y = pos.getY(i) + oy, z = pos.getZ(i) + oz;\n    const ny = Math.abs(nor.getY(i));\n    if (ny > 0.5) uv.setXY(i, x / tile, z / tile);\n    else uv.setXY(i, (x + z) / tile, y / tile);\n  }\n  uv.needsUpdate = true;\n}\n\nfunction texturedBox(w, h, d, x, y, z, material, tile, cast = false, receive = true) {\n  const g = new BoxGeometry(w, h, d);\n  worldUv(g, x, y, z, tile);\n  const m = new Mesh(g, material);\n  m.position.set(x, y, z);\n  m.castShadow = cast;\n  m.receiveShadow = receive;\n  m.updateMatrixWorld();\n  return m;\n}\n\nexport function applyBiomeLight(engine, scene, biome, dark = false) {\n  const b = BIOMES[biome] ?? BIOMES.ossuary;\n  engine.sun.color.setHex(PALETTE[b.sun]);\n  engine.sun.intensity = dark ? 0.04 : b.sunI;\n  engine.ambient.color.setHex(PALETTE[b.ambient]);\n  engine.ambient.intensity = dark ? 0.12 : b.ambI;\n  scene.background = new Color(PALETTE[b.bg]);\n}\n\nexport class ZoneView {\n  constructor(view, zone) {\n    this.view = view;\n    this.zone = zone;\n    this.root = new Group();\n    this.root.name = 'zone';\n    this.colliders = [];\n    this.lights = [];\n    this.fade = [];\n    this.tick = 0;\n    const ctx = view.ctx;\n    this.ctx = ctx;\n    ctx.scene.add(this.root);\n    const biome = BIOMES[zone.biome] ?? BIOMES.ossuary;\n    this.biome = biome;\n    applyBiomeLight(ctx.engine, ctx.scene, zone.biome);\n    this.rng = new Rng(`decor:${zone.seedKey}`);\n    this.buildGround(biome);\n    this.buildWalls(biome);\n    this.dressLights(biome);\n    this.dressFloor(biome);\n    this.buildPhysics();\n    this.buildAtmosphere(biome);\n  }\n\n  buildGround(biome) {\n    const z = this.zone;\n    const texId = BIOME_FLOORS[z.biome]?.[z.floor % (BIOME_FLOORS[z.biome]?.length || 1)] ?? biome.floor;\n    const tile = tileOf(texId);\n    const mat = toonMaterial(PALETTE.mist, { map: textureMap(texId) });\n    const parts = [];\n    for (let row = 0; row < z.h; row++) {\n      const s = z.rows[row];\n      let x = 0;\n      while (x < z.w) {\n        if (!isFloor(s[x]) && s[x] !== 'P') { x++; continue; }\n        let e = x;\n        while (e < z.w && (isFloor(s[e]) || s[e] === 'P')) e++;\n        const len = e - x;\n        parts.push(texturedBox(len, 1, 1, x + len / 2, -0.5, row + 0.5, mat, tile));\n        x = e;\n      }\n    }\n    for (const m of mergeStaticMeshes(parts)) { m.receiveShadow = true; this.root.add(m); }\n    // What is under the world.\n    if (biome.water) {\n      this.water = new WaterSurface({ size: [z.w + 60, z.h + 60], at: [z.w / 2, -0.18, z.h / 2], waves: WAVES_CALM, segments: [Math.min(160, z.w), Math.min(120, z.h)], deep: PALETTE.navy, shallow: PALETTE.teal, foam: PALETTE.slate });\n      this.root.add(this.water);\n    } else if (biome.pit) {\n      const id = biome.pit === 3 ? 'rift-energy' : biome.pit === 2 ? 'lava-crust' : 'stone';\n      const g = new PlaneGeometry(z.w + 80, z.h + 80).rotateX(-Math.PI / 2);\n      const t = tileOf(id);\n      const uv = g.attributes.uv;\n      for (let i = 0; i < uv.count; i++) uv.setXY(i, (uv.getX(i) * (z.w + 80)) / t, (uv.getY(i) * (z.h + 80)) / t);\n      const m = new Mesh(g, biome.pit === 1 ? toonMaterial(PALETTE.ink) : toonMaterial(biome.pit === 3 ? PALETTE.white : PALETTE.mist, { map: textureMap(id) }));\n      m.position.set(z.w / 2, -3, z.h / 2);\n      this.root.add(m);\n    }\n  }\n\n  buildWalls(biome) {\n    const z = this.zone;\n    const tile = tileOf(biome.wall);\n    const mat = toonMaterial(PALETTE.mist, { map: textureMap(biome.wall) });\n    const cap = toonMaterial(PALETTE.ink);\n    const parts = [];\n    const at = (x, y) => z.rows[y]?.[x];\n    this.backWalls = [];\n    for (let y = 0; y < z.h; y++) {\n      for (let x = 0; x < z.w; x++) {\n        const c = at(x, y);\n        if (c === 'P') { this.pillar(x, y, biome, parts, mat, tile, cap); continue; }\n        if (c !== '#') continue;\n        const px = isFloor(at(x + 1, y)), pz = isFloor(at(x, y + 1)), pd = isFloor(at(x + 1, y + 1));\n        const nx = isFloor(at(x - 1, y)), nz = isFloor(at(x, y - 1)), nd = isFloor(at(x - 1, y - 1));\n        const dA = isFloor(at(x + 1, y - 1)), dB = isFloor(at(x - 1, y + 1));\n        if (!(px || pz || pd || nx || nz || nd || dA || dB)) continue;\n        const tall = (px || pz || pd) && !(nx || nz);\n        const H = tall ? biome.wallH : 0.6;\n        parts.push(texturedBox(1, H, 1, x + 0.5, H / 2, y + 0.5, mat, tile, true));\n        const capB = new Mesh(new BoxGeometry(1, 0.12, 1), cap);\n        capB.position.set(x + 0.5, H + 0.06, y + 0.5);\n        capB.castShadow = true;\n        capB.updateMatrixWorld();\n        parts.push(capB);\n        if (tall && (px || pz)) this.backWalls.push({ x, y, px, pz });\n      }\n    }\n    for (const m of mergeStaticMeshes(parts)) this.root.add(m);\n    // Dress the walls.\n    const dress = biome.wallDress ?? [];\n    if (dress.length) {\n      for (const w of this.backWalls) {\n        if (this.rng.next() > 0.16) continue;\n        const id = this.rng.pick(dress);\n        const face = w.pz ? [w.x + 0.5, w.y + 1.04, 0] : [w.x + 1.04, w.y + 0.5, Math.PI / 2];\n        this.place(id, face[0], face[1], { rotY: face[2], y: id === 'column' ? 0 : id === 'wall-torch' || id === 'wall-lantern' ? 1.6 : 0.8, light: false });\n      }\n    }\n  }\n\n  pillar(x, y, biome, parts, mat, tile, cap) {\n    if (this.zone.id === 'town') return;\n    const H = 2.4;\n    parts.push(texturedBox(0.8, H, 0.8, x + 0.5, H / 2, y + 0.5, mat, tile, true));\n    parts.push(texturedBox(1, 0.2, 1, x + 0.5, 0.1, y + 0.5, mat, tile, true));\n    const capB = new Mesh(new BoxGeometry(1, 0.2, 1), cap);\n    capB.position.set(x + 0.5, H + 0.1, y + 0.5);\n    capB.castShadow = true;\n    capB.updateMatrixWorld();\n    parts.push(capB);\n  }\n\n  place(id, x, z, o = {}) {\n    const b = buildModel(id, { catalog: MODELS, params: o.params, seed: o.seed, palette: o.palette });\n    const obj = b.object;\n    obj.position.set(x, o.y ?? 0, z);\n    obj.rotation.y = o.rotY ?? 0;\n    if (o.scale) obj.scale.setScalar(o.scale);\n    obj.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } });\n    this.root.add(obj);\n    if (b.light && o.light !== false) {\n      const p = new THREE.Vector3(...b.light.at).applyMatrix4(obj.updateMatrixWorld() ?? obj.matrixWorld);\n      this.lights.push(this.ctx.lights.request({ ...b.light, position: [p.x, p.y, p.z] }));\n    }\n    return obj;\n  }\n\n  dressLights(biome) {\n    const z = this.zone;\n    const nearWall = (x, y) => this.backWalls.find((w) => Math.abs(w.x - x) + Math.abs(w.y - y) <= 2);\n    for (const l of z.lights) {\n      const cx = Math.floor(l.x), cy = Math.floor(l.z);\n      const w = nearWall(cx, cy);\n      let lx = l.x, lz = l.z;\n      if (w) {\n        const face = w.pz ? [w.x + 0.5, w.y + 1.04, 0] : [w.x + 1.04, w.y + 0.5, Math.PI / 2];\n        this.place('wall-torch', face[0], face[1], { rotY: face[2], y: 1.5, light: false });\n        lx = face[0]; lz = face[1];\n      } else {\n        this.place(z.id === 'town' ? 'lamp-post' : 'standing-torch', l.x, l.z, { light: false });\n      }\n      this.lights.push(this.ctx.lights.request({ position: [lx + 0.3, 1.9, lz + 0.3], color: biome.torch, intensity: 7, radius: 9, flicker: 'torch', priority: 1 }));\n    }\n  }\n\n  dressFloor(biome) {\n    const z = this.zone;\n    const low = [], tall = [];\n    const TALL = new Set(['dead-tree', 'willow', 'statue', 'obelisk', 'column', 'ruined-wall', 'standard', 'cart', 'sarcophagus', 'cage', 'fallen-tree', 'rune-stone']);\n    for (const id of biome.decor ?? []) (TALL.has(id) ? tall : low).push(id);\n    const at = (x, y) => z.rows[y]?.[x];\n    for (let y = 1; y < z.h - 1; y++) {\n      for (let x = 1; x < z.w - 1; x++) {\n        const c = at(x, y);\n        if (c !== '.') {\n          // Outdoors, trees grow out of the moor on the far side of the road.\n          if (c === '~' && biome.water && tall.length && (isFloor(at(x + 1, y)) || isFloor(at(x, y + 1))) && this.rng.next() < 0.14) {\n            const id = this.rng.pick(tall.filter((t) => t !== 'cart'));\n            if (id) this.place(id, x + 0.5, y + 0.5, { seed: this.rng.int(1, 9), rotY: this.rng.range(0, 6), y: -0.2 });\n          }\n          continue;\n        }\n        const r = this.rng.next();\n        if (r > 0.045) continue;\n        const backWall = at(x - 1, y) === '#' || at(x, y - 1) === '#';\n        if (backWall && tall.length && r < 0.03) {\n          const id = this.rng.pick(tall);\n          this.place(id, x + 0.5, y + 0.5, { rotY: at(x, y - 1) === '#' ? 0 : Math.PI / 2, seed: this.rng.int(1, 9), params: id === 'dead-tree' ? undefined : undefined });\n        } else if (low.length) {\n          const id = this.rng.pick(low);\n          this.place(id, x + this.rng.range(0.2, 0.8), y + this.rng.range(0.2, 0.8), { rotY: this.rng.range(0, 6.28), seed: this.rng.int(1, 9) });\n        }\n      }\n    }\n  }\n\n  buildPhysics() {\n    const z = this.zone;\n    const ph = this.ctx.physics;\n    this.colliders.push(ph.addStaticBox({ position: [z.w / 2, -0.5, z.h / 2], halfExtents: [z.w / 2 + 20, 0.5, z.h / 2 + 20] }));\n    for (let y = 0; y < z.h; y++) {\n      let x = 0;\n      const s = z.rows[y];\n      while (x < z.w) {\n        if (s[x] !== '#') { x++; continue; }\n        let e = x;\n        while (e < z.w && s[e] === '#') e++;\n        const len = e - x;\n        this.colliders.push(ph.addStaticBox({ position: [x + len / 2, 1.5, y + 0.5], halfExtents: [len / 2, 1.5, 0.5] }));\n        x = e;\n      }\n    }\n  }\n\n  buildAtmosphere(biome) {\n    const ctx = this.ctx;\n    const scene = ctx.scene;\n    this.mist = groundFog({ color: PALETTE[biome.fog], top: 1.2, amount: 0.35 });\n    scene.fogNode = this.mist.node;\n    if (biome.rain) {\n      this.rain = new Precipitation({ kind: 'rain', count: 2600 });\n      this.rain.wind.set(1.5, -1);\n      this.root.add(this.rain);\n    }\n    this.ambientT = 0;\n  }\n\n  update(dt, time, focus) {\n    if (this.water) this.water.update(time);\n    if (this.rain) this.rain.update(dt, focus);\n    this.tick += dt;\n    if (this.biome.embers && this.tick > 0.25) {\n      this.tick = 0;\n      const r = this.view.fxRng;\n      this.ctx.particles.burst('ember_drift', [focus.x + r.range(-9, 9), r.range(0.2, 1), focus.z + r.range(-9, 9)]);\n    }\n    if (this.biome.wind && this.tick > 0.4) {\n      this.tick = 0;\n      const r = this.view.fxRng;\n      if (this.zone.biome === 'belfry') this.ctx.particles.burst('crackle', [focus.x + r.range(-10, 10), r.range(0.1, 2), focus.z + r.range(-10, 10)]);\n    }\n  }\n\n  dispose() {\n    const ctx = this.ctx;\n    for (const l of this.lights) l.release();\n    for (const c of this.colliders) ctx.physics.remove(c);\n    if (ctx.scene.fogNode === this.mist?.node) ctx.scene.fogNode = null;\n    this.water?.dispose();\n    this.rain?.dispose();\n    ctx.scene.remove(this.root);\n    disposeObject(this.root);\n  }\n}\n\nexport { setLookLayer, addModelColliders, glowMaterial };\nEOF\ncat > src/view/actors.js <<'EOF'\n// Actors: every body on screen. Humanoids run the hero's clips; the rest move procedurally.\nimport { buildModel, compileClips, ContactShadow, glowMaterial, HERO_RAGDOLL, HERO_RIG, LegStepper, PALETTE, Ragdoll, setLookLayer, SpringChain, Squash, THREE, toonMaterial, Trail, twoBoneIK } from '../../pixel-engine.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { ALL_CLIPS, UPPER_JOINTS } from './clips.js';\nimport { MODELS } from './models/index.js';\n\nconst { AnimationClip, AnimationMixer, BoxGeometry, CylinderGeometry, Group, LoopOnce, LoopRepeat, Mesh, Vector3 } = THREE;\n\nconst clipCache = new Map();\nexport function clipsFor(bodyId, object) {\n  let c = clipCache.get(bodyId);\n  if (!c) {\n    const list = compileClips(ALL_CLIPS, HERO_RIG, object);\n    const map = {};\n    for (const clip of list) map[clip.name] = clip;\n    c = map;\n    clipCache.set(bodyId, c);\n  }\n  return c;\n}\nconst upperCache = new Map();\nfunction upperClip(clip) {\n  let u = upperCache.get(clip);\n  if (!u) {\n    u = new AnimationClip(`${clip.name}_upper`, clip.duration, clip.tracks.filter((t) => UPPER_JOINTS.has(t.name.split('.')[0])));\n    upperCache.set(clip, u);\n  }\n  return u;\n}\n\nconst LEG_GEO = new BoxGeometry(1, 1, 1);\nconst FLASH = () => glowMaterial(PALETTE.white);\nconst UP = [0, 1, 0];\nconst groundY = () => 0;\n\nexport const CLASS_BODY = { bellwarden: 'hero_bellwarden', lamplighter: 'hero_lamplighter', sexton: 'hero_sexton', pyx: 'npc_pyx' };\nexport const SEAT_COLORS = ['red', 'sky', 'lime', 'sand'];\n\n/** Where weapons sit in a hand. */\nconst WEAPON_POSE = {\n  default: { at: [0, -0.1, 0.06], rot: [90, 0, 0], scale: 1 },\n  'hand-bell-weapon': { at: [0, -0.1, 0.06], rot: [90, 0, 0], scale: 1.1 },\n  staff: { at: [0, -0.1, -0.5], rot: [90, 0, 0], scale: 1 },\n  scythe: { at: [0, -0.1, -0.2], rot: [90, 0, 0], scale: 1 },\n  shovel: { at: [0, -0.1, -0.2], rot: [90, 0, 0], scale: 1 },\n  crossbow: { at: [0, -0.1, 0.1], rot: [0, 0, 0], scale: 1 },\n};\nconst OFF_POSE = {\n  default: { at: [0.05, -0.18, 0.05], rot: [0, 90, 0], scale: 0.9 },\n  'hand-lantern': { at: [0, -0.48, 0.05], rot: [0, 0, 0], scale: 1 },\n  censer: { at: [0, -0.62, 0.05], rot: [0, 0, 0], scale: 1 },\n};\n\nexport class Actor {\n  constructor(view, o) {\n    this.view = view;\n    this.id = o.id;\n    this.type = o.type;\n    this.def = o.def ?? MONSTERS[o.type] ?? {};\n    this.bodyId = o.body ?? this.def.body;\n    this.scale = (o.scale ?? 1) * (this.def.huge ? (o.type === 'bursar' ? 2.5 : 1) : this.def.big && this.def.humanoid && o.type !== 'coffin_bearer' ? 1.5 : 1);\n    if (this.def.small && this.def.humanoid) this.scale *= 0.6;\n    if (o.type === 'malison') this.scale = 1;\n    this.isHero = !!o.isHero;\n    this.ally = !!o.ally;\n    this.humanoid = !!(this.isHero || this.def.humanoid || o.humanoid);\n    this.time = 0;\n    this.flashT = 0;\n    this.hidden = false;\n    this.action = null; this.oneShot = null; this.base = null;\n    const palette = o.tint ? { [Object.keys(MODELS.get(this.bodyId).palette ?? {})[0]]: o.tint } : undefined;\n    const b = buildModel(this.bodyId, { catalog: MODELS, palette });\n    this.root = new Group();\n    this.body = b.object;\n    this.root.add(this.body);\n    this.root.scale.setScalar(this.scale);\n    this.meshes = [];\n    this.body.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; this.meshes.push(m); m.userData.orig = m.material; } });\n    setLookLayer(this.root, 'actors');\n    this.shadow = new ContactShadow(Math.max(0.4, (this.def.r ?? 0.42) * this.scale * (this.def.huge ? 0.8 : 1)));\n    view.actorRoot.add(this.root, this.shadow);\n    this.root.position.set(o.x, 0, o.z);\n    if (this.humanoid) {\n      this.mixer = new AnimationMixer(this.body);\n      this.clips = clipsFor(this.bodyId, this.body);\n      this.setBase(this.def.clipIdle ?? 'Idle');\n    }\n    this.squash = new Squash();\n    if (this.def.legs) this.makeLegs(this.def.legs);\n    if (o.from === 'ground') { this.riseT = 0.5; this.root.position.y = -1.6; view.dustAt(o.x, o.z); }\n    if (o.from === 'drop') { this.dropT = 0.4; this.root.position.y = 5; }\n    if (this.type === 'malison') this.makeRopes();\n    this.wingL = this.body.getObjectByName('WingL'); this.wingR = this.body.getObjectByName('WingR');\n    this.headBone = this.body.getObjectByName('HeadBone');\n    this.statueT = this.type === 'ash_gargoyle' ? 1 : 0;\n    this.seed = o.id * 0.37;\n  }\n\n  setBase(name, timeScale = 1) {\n    if (this.baseName === name) { if (this.base) this.base.timeScale = timeScale; return; }\n    const clip = this.clips[name];\n    if (!clip) return;\n    const a = this.mixer.clipAction(clip);\n    a.reset();\n    a.setLoop(LoopRepeat);\n    a.timeScale = timeScale;\n    a.enabled = true;\n    a.play();\n    if (this.base) this.base.crossFadeTo(a, 0.12, false);\n    this.base = a;\n    this.baseName = name;\n  }\n\n  /** Play a clip once over the base. upper: only the upper body, so the legs keep running. */\n  play(name, speed = 1, upper = false, hold = false) {\n    if (!this.mixer) return;\n    let clip = this.clips[name];\n    if (!clip) return;\n    if (upper) clip = upperClip(clip);\n    const a = this.mixer.clipAction(clip);\n    a.reset();\n    a.setLoop(LoopOnce, 1);\n    a.clampWhenFinished = true;\n    a.timeScale = speed;\n    a.enabled = true;\n    a.setEffectiveWeight(1);\n    if (this.oneShot && this.oneShot !== a) this.oneShot.fadeOut(0.06);\n    a.fadeIn(0.05);\n    a.play();\n    this.oneShot = a;\n    this.oneShotT = (clip.duration / Math.max(0.05, speed)) - 0.06;\n    this.oneHold = hold;\n  }\n\n  loopClip(name, dur, speed = 1) {\n    if (!this.mixer) return;\n    const clip = this.clips[name];\n    if (!clip) return;\n    const a = this.mixer.clipAction(clip);\n    a.reset();\n    a.setLoop(LoopRepeat);\n    a.timeScale = speed;\n    a.setEffectiveWeight(1);\n    if (this.oneShot && this.oneShot !== a) this.oneShot.fadeOut(0.06);\n    a.fadeIn(0.05);\n    a.play();\n    this.oneShot = a;\n    this.oneShotT = dur;\n    this.oneHold = false;\n  }\n\n  makeLegs(n) {\n    const r = this.def.r * this.scale;\n    const legs = [];\n    const rows = n / 2;\n    for (let i = 0; i < n; i++) {\n      const side = i % 2 === 0 ? -1 : 1;\n      const row = Math.floor(i / 2);\n      const z = rows === 1 ? 0 : (row / (rows - 1) - 0.5) * r * 2.4;\n      legs.push({ rest: [side * r * 1.5, z], partners: [i % 2 === 0 ? i + 1 : i - 1] });\n    }\n    this.stepper = new LegStepper({ legs, threshold: r * 0.7, stepTime: 0.14, lift: r * 0.5, lead: 0.15 });\n    this.legs = [];\n    const mat = toonMaterial(PALETTE[this.def.legColor ?? 'ink']);\n    const th = Math.max(0.07, r * 0.2);\n    for (let i = 0; i < n; i++) {\n      const a = new Mesh(LEG_GEO, mat), b = new Mesh(LEG_GEO, mat);\n      a.castShadow = b.castShadow = true;\n      setLookLayer(a, 'actors'); setLookLayer(b, 'actors');\n      this.view.actorRoot.add(a, b);\n      this.legs.push({ a, b, th });\n    }\n    this.hipH = (this.def.hipH ?? (this.def.legs === 6 ? 0.27 : this.def.big || this.def.huge ? 0.95 : 0.42)) * (this.def.huge ? 1.35 : 1);\n    this.legLen = this.hipH * 0.85 + r * 0.6;\n  }\n\n  updateLegs(dt, m, speed) {\n    const p = [this.root.position.x, 0, this.root.position.z];\n    const yaw = this.root.rotation.y;\n    const vel = [Math.sin(yaw) * speed, 0, Math.cos(yaw) * speed];\n    this.stepper.update(dt, p, yaw, vel, groundY);\n    const c = Math.cos(yaw), s = Math.sin(yaw);\n    this.legs.forEach((leg, i) => {\n      const foot = this.stepper.feet[i].at;\n      const rest = this.stepper.o.legs[i].rest;\n      const hip = [p[0] + rest[0] * 0.45 * c + rest[1] * 0.5 * s, this.hipH, p[2] - rest[0] * 0.45 * s + rest[1] * 0.5 * c];\n      const pole = [hip[0] + (hip[0] - p[0]) * 2, hip[1] + 1, hip[2] + (hip[2] - p[2]) * 2];\n      const knee = twoBoneIK(hip, foot, this.legLen * 0.55, this.legLen * 0.6, pole);\n      segment(leg.a, hip, knee, leg.th);\n      segment(leg.b, knee, foot, leg.th * 0.8);\n    });\n  }\n\n  makeRopes() {\n    this.ropes = [];\n    const mat = toonMaterial(PALETTE.sand);\n    for (let i = 0; i < 4; i++) {\n      const chain = new SpringChain({ segments: 7, length: 0.75, rest: [0, -0.55, 0.85], stiffness: 5, keep: 0.93, gravity: 3 });\n      const segs = [];\n      for (let k = 0; k < 7; k++) {\n        const m = new Mesh(LEG_GEO, mat);\n        m.castShadow = true;\n        setLookLayer(m, 'actors');\n        this.view.actorRoot.add(m);\n        segs.push(m);\n      }\n      this.ropes.push({ chain, segs, side: i % 2 === 0 ? -1 : 1, up: i < 2 ? 2.8 : 1.6 });\n    }\n  }\n\n  updateRopes(dt) {\n    const yaw = this.root.rotation.y;\n    const c = Math.cos(yaw), s = Math.sin(yaw);\n    const right = [c, 0, -s], up = UP, fwd = [s, 0, c];\n    const p = this.root.position;\n    for (const r of this.ropes) {\n      const root = [p.x + right[0] * r.side * 1.2, p.y + r.up, p.z + right[2] * r.side * 1.2];\n      const sway = this.lash > 0 ? 3 : 0.3;\n      const rb = [[right[0] * r.side, 0, right[2] * r.side], up, [fwd[0] + Math.sin(this.time * 2 + r.side) * sway * 0.2, 0, fwd[2]]];\n      r.chain.update(dt, root, rb);\n      for (let k = 0; k < r.segs.length; k++) segment(r.segs[k], r.chain.points[k], r.chain.points[k + 1], 0.22);\n    }\n  }\n\n  // ---- Hero gear ---------------------------------------------------------------------------\n  setGear(g, cls) {\n    const hand = this.body.getObjectByName('HandR');\n    const offHand = this.body.getObjectByName('HandL');\n    const head = this.body.getObjectByName('Head');\n    const armR = this.body.getObjectByName('ArmR');\n    const armL = this.body.getObjectByName('ArmL');\n    const swap = (parent, key, id, pose) => {\n      if (this.gearAt?.[key] === id) return;\n      this.gearAt = this.gearAt ?? {};\n      if (this.gearObj?.[key]) parent.remove(this.gearObj[key]);\n      this.gearObj = this.gearObj ?? {};\n      this.gearObj[key] = null;\n      this.gearAt[key] = id;\n      if (!id) return;\n      const o = buildModel(id, { catalog: MODELS }).object;\n      o.traverse((m) => { if (m.isMesh) { m.castShadow = true; this.meshes.push(m); m.userData.orig = m.material; } });\n      if (pose) {\n        o.position.set(...pose.at);\n        o.rotation.set((pose.rot[0] * Math.PI) / 180, (pose.rot[1] * Math.PI) / 180, (pose.rot[2] * Math.PI) / 180);\n        o.scale.setScalar(pose.scale ?? 1);\n      }\n      setLookLayer(o, 'actors');\n      parent.add(o);\n      this.gearObj[key] = o;\n    };\n    if (hand) swap(hand, 'main', g.main || null, WEAPON_POSE[g.main] ?? WEAPON_POSE.default);\n    if (offHand) swap(offHand, 'off', g.off || null, OFF_POSE[g.off] ?? OFF_POSE.default);\n    if (!CLASS_BODY[cls] || cls === 'pyx') return;\n    const tierOf = (r) => (r === 'legendary' || r === 'set' || r === 'reliquary' ? 2 : r === 'blessed' ? 1 : 0);\n    if (head) swap(head, 'helm', g.head ? `helm_${cls}_${tierOf(g.head)}` : null);\n    if (armR) swap(armR, 'shR', g.shoulders ? `shoulder_${cls}_${tierOf(g.shoulders)}` : null, { at: [-0.02, 0.06, 0], rot: [0, 0, 0] });\n    if (armL) swap(armL, 'shL', g.shoulders ? `shoulder_${cls}_${tierOf(g.shoulders)}` : null, { at: [0.02, 0.06, 0], rot: [0, 0, 0] });\n  }\n\n  setTrail(colorHead, colorTail) {\n    this.trail = new Trail({ width: 0.26, life: 0.16, points: 16 });\n    this.trail.head.setHex(colorHead);\n    this.trail.tail.setHex(colorTail);\n    this.view.actorRoot.add(this.trail);\n    this.tipTmp = new Vector3();\n  }\n\n  flash(frames = 2) {\n    this.flashT = frames;\n    const glow = FLASH();\n    for (const m of this.meshes) m.material = glow;\n  }\n\n  sync(x, z, facing, moving, speed, dt) {\n    this.time += dt;\n    const p = this.root.position;\n    p.x = x; p.z = z;\n    this.root.rotation.y = facing;\n    if (this.flashT > 0) {\n      this.flashT--;\n      if (this.flashT <= 0) for (const m of this.meshes) m.material = m.userData.orig;\n    }\n    if (this.riseT > 0) { this.riseT -= dt; p.y = -Math.max(0, this.riseT / 0.5) * 1.6; }\n    else if (this.dropT > 0) {\n      this.dropT -= dt;\n      p.y = Math.max(0, this.dropT / 0.4) ** 2 * 5;\n      if (this.dropT <= 0) { p.y = 0; this.squash.kick(-5); this.view.dustAt(x, z); }\n    }\n    if (this.def.hover) p.y = this.def.hover * 0.5 + Math.sin(this.time * 2 + this.seed) * 0.12 + (this.type === 'ash_gargoyle' ? 0.2 : 0);\n    if (this.mixer) {\n      if (moving && speed > 0.1) {\n        const name = this.def.clipMove ?? (speed > 3 ? 'Run' : 'Walk');\n        const auth = name === 'Run' ? 5.5 : name === 'Walk' ? 2 : name === 'Shamble' ? 1.4 : 2;\n        this.setBase(name, Math.max(0.5, speed / auth));\n      } else this.setBase(this.def.clipIdle ?? 'Idle', 1);\n      if (this.oneShot) {\n        this.oneShotT -= dt;\n        if (this.oneShotT <= 0 && !this.oneHold) { this.oneShot.fadeOut(0.08); this.oneShot = null; }\n      }\n      this.mixer.update(dt);\n    }\n    this.squash.update(dt);\n    const [sh, sv] = this.squash.scale();\n    this.body.scale.set(sh, sv, sh);\n    if (this.stepper) this.updateLegs(dt, null, moving ? speed : 0);\n    if (this.wingL) {\n      const a = moving ? Math.sin(this.time * 12) * 0.7 : -0.1;\n      this.wingL.rotation.z = a; this.wingR.rotation.z = -a;\n    }\n    if (this.ropes) this.updateRopes(dt);\n    if (this.lash > 0) this.lash -= dt;\n    if (this.headTilt > 0) { this.headTilt -= dt; if (this.headBone) this.headBone.rotation.x = -Math.sin(this.headTilt * 8) * 0.35; }\n    this.shadow.place(x, 0, z, Math.max(0, p.y));\n    this.shadow.visible = this.root.visible;\n    if (this.trail) {\n      const hand = this.gearObj?.main ?? this.body.getObjectByName('HandR');\n      if (this.oneShot && hand) {\n        hand.getWorldPosition(this.tipTmp);\n        this.trail.push(this.tipTmp, this.time);\n      }\n      this.trail.update(this.time, this.view.ctx.camera.camera);\n    }\n  }\n\n  setHidden(on) {\n    this.hidden = on;\n    this.root.visible = !on;\n    this.shadow.visible = !on;\n  }\n\n  /** Leave the scene entirely. */\n  remove() {\n    const r = this.view.actorRoot;\n    r.remove(this.root, this.shadow);\n    if (this.legs) for (const l of this.legs) r.remove(l.a, l.b);\n    if (this.ropes) for (const q of this.ropes) for (const s of q.segs) r.remove(s);\n    if (this.trail) { r.remove(this.trail); this.trail.dispose(); }\n    if (this.light) this.light.release();\n    if (this.mixer) this.mixer.stopAllAction();\n    if (this.dissolved) for (const m of this.dissolved) m.dispose();\n  }\n\n  /** A per-body dissolve, only for those who are going. */\n  startDissolve() {\n    this.dissolved = [];\n    for (const m of this.meshes) {\n      const orig = m.userData.orig;\n      if (!orig?.color || orig.isMeshBasicNodeMaterial) { m.visible = false; continue; }\n      const clone = toonMaterial(orig.color.getHex(), { dissolve: true }).clone();\n      clone.dissolve = 0;\n      m.material = clone;\n      m.userData.orig = clone;\n      this.dissolved.push(clone);\n    }\n  }\n  setDissolve(v) { if (this.dissolved) for (const m of this.dissolved) m.dissolve = v; }\n}\n\nconst tmpA = new Vector3();\nfunction segment(mesh, a, b, th) {\n  const dx = b[0] - a[0], dy = b[1] - a[1], dz = b[2] - a[2];\n  const L = Math.hypot(dx, dy, dz) || 0.01;\n  mesh.position.set((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2);\n  tmpA.set(b[0], b[1], b[2]);\n  mesh.lookAt(tmpA);\n  mesh.scale.set(th, th, L);\n}\n\nexport function makeRagdoll(view, actor, vel) {\n  const doll = new Ragdoll(view.ctx.physics, actor.body, HERO_RAGDOLL);\n  doll.enable({ velocity: vel });\n  return doll;\n}\n\nexport { CylinderGeometry };\nEOF\necho ok","description":"Write effects kit, zone builder and actors"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9393,"cache_read_input_tokens":517754,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9393},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"44fdb48d-5f23-4088-93af-5258564f375e","timestamp":"2026-11-06T00:10:56.441Z","request_id":"req_011CgkhdX2wEZ7v9tRCHRFL6","wire_tool_inputs":{"toolu_01UeJJzDWGZeJH1v6CJ2QWAn":{"command":"sed -i \"s/wall: 'brick-wall', wallH: 2.6/wall: 'bricks', wallH: 2.6/; s/decor: \\['barrel', 'crate', 'sack', 'bench', 'planter', 'hitching-post', 'clothesline'\\]/decor: ['barrel', 'crate', 'sack', 'park-bench', 'planter', 'hitching-post', 'bucket']/\" src/data/zones.js\ncat > src/view/fxkit.js <<'EOF'\n// Flat, unlit shapes on the ground: rings, sectors, bolts, pillars. All cheap and all palette.\nimport { glowMaterial, PALETTE, THREE } from '../../pixel-engine.js';\n\nconst { BoxGeometry, CircleGeometry, Group, Mesh, RingGeometry, BufferGeometry, BufferAttribute } = THREE;\n\nconst flat = (g) => { g.rotateX(-Math.PI / 2); return g; };\nconst GEO = {\n  ring: flat(new RingGeometry(0.88, 1, 40)),\n  thin: flat(new RingGeometry(0.95, 1, 48)),\n  disc: flat(new CircleGeometry(1, 32)),\n  box: new BoxGeometry(1, 1, 1),\n  quad: flat(new THREE.PlaneGeometry(1, 1)),\n};\nconst glow = (c) => glowMaterial(typeof c === 'number' ? c : PALETTE[c] ?? PALETTE.white);\nexport const mat = glow;\n\nconst ease = (t) => 1 - (1 - t) ** 3;\n\nexport class FxKit {\n  constructor(scene) {\n    this.group = new Group();\n    this.group.name = 'fx';\n    scene.add(this.group);\n    this.live = [];\n  }\n\n  _add(mesh, o) {\n    this.group.add(mesh);\n    const e = { mesh, t: 0, dur: 0.3, ...o };\n    this.live.push(e);\n    return e;\n  }\n\n  ring(x, z, r, color, dur = 0.35, o = {}) {\n    const m = new Mesh(GEO[o.thin ? 'thin' : 'ring'], glow(color));\n    m.position.set(x, o.y ?? 0.08, z);\n    m.scale.setScalar(0.1);\n    return this._add(m, { dur, grow: r, kind: 'ring' });\n  }\n\n  disc(x, z, r, color, dur = 0.3, o = {}) {\n    const m = new Mesh(GEO.disc, glow(color));\n    m.position.set(x, o.y ?? 0.06, z);\n    m.scale.setScalar(o.grow ? 0.1 : r);\n    return this._add(m, { dur, grow: o.grow ? r : 0, shrink: o.shrink ? r : 0, kind: 'disc' });\n  }\n\n  /** A pie slice, facing (dx, dz). */\n  sector(x, z, dx, dz, r, angleDeg, color, dur = 0.14, o = {}) {\n    const a = (Math.min(angleDeg || 120, 359) * Math.PI) / 180;\n    const inner = o.inner ?? 0.55;\n    const g = new RingGeometry(inner, 1, 16, 1, -a / 2, a);\n    g.rotateX(-Math.PI / 2);\n    g.rotateY(-Math.atan2(dz, dx));\n    const m = new Mesh(g, glow(color));\n    m.position.set(x, o.y ?? 0.5, z);\n    m.scale.setScalar(r * 0.6);\n    return this._add(m, { dur, grow: r, own: true, kind: 'sector' });\n  }\n\n  bolt(x1, z1, x2, z2, color, dur = 0.1, o = {}) {\n    const m = new Mesh(GEO.box, glow(color));\n    const dx = x2 - x1, dz = z2 - z1, L = Math.hypot(dx, dz) || 0.01;\n    m.position.set((x1 + x2) / 2, o.y ?? 0.9, (z1 + z2) / 2);\n    m.rotation.y = Math.atan2(dx, dz);\n    m.scale.set(o.w ?? 0.1, o.w ?? 0.1, L);\n    return this._add(m, { dur, kind: 'bolt', thin: o.w ?? 0.1 });\n  }\n\n  pillar(x, z, color, h, dur = 0.4, o = {}) {\n    const m = new Mesh(GEO.box, glow(color));\n    const w = o.w ?? 0.4;\n    m.position.set(x, h / 2, z);\n    m.scale.set(w, h, w);\n    return this._add(m, { dur, kind: 'pillar', w, h });\n  }\n\n  update(dt) {\n    for (let i = this.live.length - 1; i >= 0; i--) {\n      const e = this.live[i];\n      e.t += dt;\n      const f = Math.min(1, e.t / e.dur);\n      const m = e.mesh;\n      if (e.kind === 'ring') m.scale.setScalar(Math.max(0.05, ease(f) * e.grow));\n      else if (e.kind === 'sector') m.scale.setScalar(e.grow * (0.6 + 0.4 * ease(f)));\n      else if (e.kind === 'disc' && e.grow) m.scale.setScalar(Math.max(0.05, ease(f) * e.grow));\n      else if (e.kind === 'disc' && e.shrink) m.scale.setScalar(Math.max(0.01, (1 - f) * e.shrink));\n      else if (e.kind === 'bolt') { const th = e.thin * (1 - f * 0.8); m.scale.x = th; m.scale.y = th; }\n      else if (e.kind === 'pillar') { const w = e.w * (1 - f); m.scale.x = Math.max(0.01, w); m.scale.z = Math.max(0.01, w); }\n      if (f >= 1) {\n        this.group.remove(m);\n        if (e.own) m.geometry.dispose();\n        this.live.splice(i, 1);\n      }\n    }\n  }\n\n  clear() {\n    for (const e of this.live) { this.group.remove(e.mesh); if (e.own) e.mesh.geometry.dispose(); }\n    this.live.length = 0;\n  }\n}\n\n/** A ring with a gap whose radius changes each frame (a stored, updated strip). */\nexport class WaveRing {\n  constructor(color, gapA, gapW, segs = 48) {\n    this.segs = segs;\n    this.gapA = gapA; this.gapW = gapW;\n    const n = (segs + 1) * 2;\n    const g = new BufferGeometry();\n    this.pos = new Float32Array(n * 3);\n    g.setAttribute('position', new BufferAttribute(this.pos, 3));\n    g.setAttribute('normal', new BufferAttribute(new Float32Array(n * 3).fill(0).map((_, i) => (i % 3 === 1 ? 1 : 0)), 3));\n    const idx = [];\n    for (let i = 0; i < segs; i++) { const a = i * 2; idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2); }\n    g.setIndex(idx);\n    this.mesh = new Mesh(g, glow(color));\n    this.mesh.frustumCulled = false;\n  }\n  set(x, z, r, thick) {\n    const full = Math.PI * 2 - this.gapW;\n    const start = this.gapA + this.gapW / 2;\n    for (let i = 0; i <= this.segs; i++) {\n      const a = start + (i / this.segs) * full;\n      const c = Math.cos(a), s = Math.sin(a);\n      this.pos.set([x + c * (r + thick), 0.1, z + s * (r + thick), x + c * Math.max(0, r - thick), 0.1, z + s * Math.max(0, r - thick)], i * 6);\n    }\n    this.mesh.geometry.attributes.position.needsUpdate = true;\n  }\n  dispose() { this.mesh.geometry.dispose(); }\n}\n\nexport const GROUND_GEO = GEO;\nEOF\ncat > src/view/zonebuild.js <<'EOF'\n// Builds the look of a zone from its grid. Same seed, same dressing, on every client.\nimport { addModelColliders, buildModel, DEFAULT_TEXEL, disposeObject, glowMaterial, groundFog, mergeStaticMeshes, PALETTE, Precipitation, Rng, setLookLayer, TEXTURE_LIBRARY, textureMap, THREE, toonMaterial, WaterSurface, WAVES_CALM } from '../../pixel-engine.js';\nimport { BIOME_FLOORS, BIOMES } from '../data/zones.js';\nimport { MODELS } from './models/index.js';\n\nconst { BoxGeometry, Color, Group, Mesh, PlaneGeometry } = THREE;\n\nconst isFloor = (c) => c !== undefined && c !== '#' && c !== '~' && c !== ' ' && c !== 'P';\nconst tileOf = (id) => (TEXTURE_LIBRARY.get(id).size[0] ?? 16) / DEFAULT_TEXEL;\n\nfunction worldUv(geo, ox, oy, oz, tile) {\n  const pos = geo.attributes.position, nor = geo.attributes.normal, uv = geo.attributes.uv;\n  for (let i = 0; i < pos.count; i++) {\n    const x = pos.getX(i) + ox, y = pos.getY(i) + oy, z = pos.getZ(i) + oz;\n    const ny = Math.abs(nor.getY(i));\n    if (ny > 0.5) uv.setXY(i, x / tile, z / tile);\n    else uv.setXY(i, (x + z) / tile, y / tile);\n  }\n  uv.needsUpdate = true;\n}\n\nfunction texturedBox(w, h, d, x, y, z, material, tile, cast = false, receive = true) {\n  const g = new BoxGeometry(w, h, d);\n  worldUv(g, x, y, z, tile);\n  const m = new Mesh(g, material);\n  m.position.set(x, y, z);\n  m.castShadow = cast;\n  m.receiveShadow = receive;\n  m.updateMatrixWorld();\n  return m;\n}\n\nexport function applyBiomeLight(engine, scene, biome, dark = false) {\n  const b = BIOMES[biome] ?? BIOMES.ossuary;\n  engine.sun.color.setHex(PALETTE[b.sun]);\n  engine.sun.intensity = dark ? 0.04 : b.sunI;\n  engine.ambient.color.setHex(PALETTE[b.ambient]);\n  engine.ambient.intensity = dark ? 0.12 : b.ambI;\n  scene.background = new Color(PALETTE[b.bg]);\n}\n\nexport class ZoneView {\n  constructor(view, zone) {\n    this.view = view;\n    this.zone = zone;\n    this.root = new Group();\n    this.root.name = 'zone';\n    this.colliders = [];\n    this.lights = [];\n    this.fade = [];\n    this.tick = 0;\n    const ctx = view.ctx;\n    this.ctx = ctx;\n    ctx.scene.add(this.root);\n    const biome = BIOMES[zone.biome] ?? BIOMES.ossuary;\n    this.biome = biome;\n    applyBiomeLight(ctx.engine, ctx.scene, zone.biome);\n    this.rng = new Rng(`decor:${zone.seedKey}`);\n    this.buildGround(biome);\n    this.buildWalls(biome);\n    this.dressLights(biome);\n    this.dressFloor(biome);\n    this.buildPhysics();\n    this.buildAtmosphere(biome);\n  }\n\n  buildGround(biome) {\n    const z = this.zone;\n    const texId = BIOME_FLOORS[z.biome]?.[z.floor % (BIOME_FLOORS[z.biome]?.length || 1)] ?? biome.floor;\n    const tile = tileOf(texId);\n    const mat = toonMaterial(PALETTE.mist, { map: textureMap(texId) });\n    const parts = [];\n    for (let row = 0; row < z.h; row++) {\n      const s = z.rows[row];\n      let x = 0;\n      while (x < z.w) {\n        if (!isFloor(s[x]) && s[x] !== 'P') { x++; continue; }\n        let e = x;\n        while (e < z.w && (isFloor(s[e]) || s[e] === 'P')) e++;\n        const len = e - x;\n        parts.push(texturedBox(len, 1, 1, x + len / 2, -0.5, row + 0.5, mat, tile));\n        x = e;\n      }\n    }\n    for (const m of mergeStaticMeshes(parts)) { m.receiveShadow = true; this.root.add(m); }\n    // What is under the world.\n    if (biome.water) {\n      this.water = new WaterSurface({ size: [z.w + 60, z.h + 60], at: [z.w / 2, -0.18, z.h / 2], waves: WAVES_CALM, segments: [Math.min(160, z.w), Math.min(120, z.h)], deep: PALETTE.navy, shallow: PALETTE.teal, foam: PALETTE.slate });\n      this.root.add(this.water);\n    } else if (biome.pit) {\n      const id = biome.pit === 3 ? 'rift-energy' : biome.pit === 2 ? 'lava-crust' : 'stone';\n      const g = new PlaneGeometry(z.w + 80, z.h + 80).rotateX(-Math.PI / 2);\n      const t = tileOf(id);\n      const uv = g.attributes.uv;\n      for (let i = 0; i < uv.count; i++) uv.setXY(i, (uv.getX(i) * (z.w + 80)) / t, (uv.getY(i) * (z.h + 80)) / t);\n      const m = new Mesh(g, biome.pit === 1 ? toonMaterial(PALETTE.ink) : toonMaterial(biome.pit === 3 ? PALETTE.white : PALETTE.mist, { map: textureMap(id) }));\n      m.position.set(z.w / 2, -3, z.h / 2);\n      this.root.add(m);\n    }\n  }\n\n  buildWalls(biome) {\n    const z = this.zone;\n    const tile = tileOf(biome.wall);\n    const mat = toonMaterial(PALETTE.mist, { map: textureMap(biome.wall) });\n    const cap = toonMaterial(PALETTE.ink);\n    const parts = [];\n    const at = (x, y) => z.rows[y]?.[x];\n    this.backWalls = [];\n    for (let y = 0; y < z.h; y++) {\n      for (let x = 0; x < z.w; x++) {\n        const c = at(x, y);\n        if (c === 'P') { this.pillar(x, y, biome, parts, mat, tile, cap); continue; }\n        if (c !== '#') continue;\n        const px = isFloor(at(x + 1, y)), pz = isFloor(at(x, y + 1)), pd = isFloor(at(x + 1, y + 1));\n        const nx = isFloor(at(x - 1, y)), nz = isFloor(at(x, y - 1)), nd = isFloor(at(x - 1, y - 1));\n        const dA = isFloor(at(x + 1, y - 1)), dB = isFloor(at(x - 1, y + 1));\n        if (!(px || pz || pd || nx || nz || nd || dA || dB)) continue;\n        const tall = (px || pz || pd) && !(nx || nz);\n        const H = tall ? biome.wallH : 0.6;\n        parts.push(texturedBox(1, H, 1, x + 0.5, H / 2, y + 0.5, mat, tile, true));\n        const capB = new Mesh(new BoxGeometry(1, 0.12, 1), cap);\n        capB.position.set(x + 0.5, H + 0.06, y + 0.5);\n        capB.castShadow = true;\n        capB.updateMatrixWorld();\n        parts.push(capB);\n        if (tall && (px || pz)) this.backWalls.push({ x, y, px, pz });\n      }\n    }\n    for (const m of mergeStaticMeshes(parts)) this.root.add(m);\n    // Dress the walls.\n    const dress = biome.wallDress ?? [];\n    if (dress.length) {\n      for (const w of this.backWalls) {\n        if (this.rng.next() > 0.16) continue;\n        const id = this.rng.pick(dress);\n        const face = w.pz ? [w.x + 0.5, w.y + 1.04, 0] : [w.x + 1.04, w.y + 0.5, Math.PI / 2];\n        this.place(id, face[0], face[1], { rotY: face[2], y: id === 'column' ? 0 : id === 'wall-torch' || id === 'wall-lantern' ? 1.6 : 0.8, light: false });\n      }\n    }\n  }\n\n  pillar(x, y, biome, parts, mat, tile, cap) {\n    if (this.zone.id === 'town') return;\n    const H = 2.4;\n    parts.push(texturedBox(0.8, H, 0.8, x + 0.5, H / 2, y + 0.5, mat, tile, true));\n    parts.push(texturedBox(1, 0.2, 1, x + 0.5, 0.1, y + 0.5, mat, tile, true));\n    const capB = new Mesh(new BoxGeometry(1, 0.2, 1), cap);\n    capB.position.set(x + 0.5, H + 0.1, y + 0.5);\n    capB.castShadow = true;\n    capB.updateMatrixWorld();\n    parts.push(capB);\n  }\n\n  place(id, x, z, o = {}) {\n    const b = buildModel(id, { catalog: MODELS, params: o.params, seed: o.seed, palette: o.palette });\n    const obj = b.object;\n    obj.position.set(x, o.y ?? 0, z);\n    obj.rotation.y = o.rotY ?? 0;\n    if (o.scale) obj.scale.setScalar(o.scale);\n    obj.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } });\n    this.root.add(obj);\n    if (b.light && o.light !== false) {\n      const p = new THREE.Vector3(...b.light.at).applyMatrix4(obj.updateMatrixWorld() ?? obj.matrixWorld);\n      this.lights.push(this.ctx.lights.request({ ...b.light, position: [p.x, p.y, p.z] }));\n    }\n    return obj;\n  }\n\n  dressLights(biome) {\n    const z = this.zone;\n    const nearWall = (x, y) => this.backWalls.find((w) => Math.abs(w.x - x) + Math.abs(w.y - y) <= 2);\n    for (const l of z.lights) {\n      const cx = Math.floor(l.x), cy = Math.floor(l.z);\n      const w = nearWall(cx, cy);\n      let lx = l.x, lz = l.z;\n      if (w) {\n        const face = w.pz ? [w.x + 0.5, w.y + 1.04, 0] : [w.x + 1.04, w.y + 0.5, Math.PI / 2];\n        this.place('wall-torch', face[0], face[1], { rotY: face[2], y: 1.5, light: false });\n        lx = face[0]; lz = face[1];\n      } else {\n        this.place(z.id === 'town' ? 'lamp-post' : 'standing-torch', l.x, l.z, { light: false });\n      }\n      this.lights.push(this.ctx.lights.request({ position: [lx + 0.3, 1.9, lz + 0.3], color: biome.torch, intensity: 7, radius: 9, flicker: 'torch', priority: 1 }));\n    }\n  }\n\n  dressFloor(biome) {\n    const z = this.zone;\n    const low = [], tall = [];\n    const TALL = new Set(['dead-tree', 'willow', 'statue', 'obelisk', 'column', 'ruined-wall', 'standard', 'cart', 'sarcophagus', 'cage', 'fallen-tree', 'rune-stone']);\n    for (const id of biome.decor ?? []) (TALL.has(id) ? tall : low).push(id);\n    const at = (x, y) => z.rows[y]?.[x];\n    for (let y = 1; y < z.h - 1; y++) {\n      for (let x = 1; x < z.w - 1; x++) {\n        const c = at(x, y);\n        if (c !== '.') {\n          // Outdoors, trees grow out of the moor on the far side of the road.\n          if (c === '~' && biome.water && tall.length && (isFloor(at(x + 1, y)) || isFloor(at(x, y + 1))) && this.rng.next() < 0.14) {\n            const id = this.rng.pick(tall.filter((t) => t !== 'cart'));\n            if (id) this.place(id, x + 0.5, y + 0.5, { seed: this.rng.int(1, 9), rotY: this.rng.range(0, 6), y: -0.2 });\n          }\n          continue;\n        }\n        const r = this.rng.next();\n        if (r > 0.045) continue;\n        const backWall = at(x - 1, y) === '#' || at(x, y - 1) === '#';\n        if (backWall && tall.length && r < 0.03) {\n          const id = this.rng.pick(tall);\n          this.place(id, x + 0.5, y + 0.5, { rotY: at(x, y - 1) === '#' ? 0 : Math.PI / 2, seed: this.rng.int(1, 9), params: id === 'dead-tree' ? undefined : undefined });\n        } else if (low.length) {\n          const id = this.rng.pick(low);\n          this.place(id, x + this.rng.range(0.2, 0.8), y + this.rng.range(0.2, 0.8), { rotY: this.rng.range(0, 6.28), seed: this.rng.int(1, 9) });\n        }\n      }\n    }\n  }\n\n  buildPhysics() {\n    const z = this.zone;\n    const ph = this.ctx.physics;\n    this.colliders.push(ph.addStaticBox({ position: [z.w / 2, -0.5, z.h / 2], halfExtents: [z.w / 2 + 20, 0.5, z.h / 2 + 20] }));\n    for (let y = 0; y < z.h; y++) {\n      let x = 0;\n      const s = z.rows[y];\n      while (x < z.w) {\n        if (s[x] !== '#') { x++; continue; }\n        let e = x;\n        while (e < z.w && s[e] === '#') e++;\n        const len = e - x;\n        this.colliders.push(ph.addStaticBox({ position: [x + len / 2, 1.5, y + 0.5], halfExtents: [len / 2, 1.5, 0.5] }));\n        x = e;\n      }\n    }\n  }\n\n  buildAtmosphere(biome) {\n    const ctx = this.ctx;\n    const scene = ctx.scene;\n    this.mist = groundFog({ color: PALETTE[biome.fog], top: 1.2, amount: 0.35 });\n    scene.fogNode = this.mist.node;\n    if (biome.rain) {\n      this.rain = new Precipitation({ kind: 'rain', count: 2600 });\n      this.rain.wind.set(1.5, -1);\n      this.root.add(this.rain);\n    }\n    this.ambientT = 0;\n  }\n\n  update(dt, time, focus) {\n    if (this.water) this.water.update(time);\n    if (this.rain) this.rain.update(dt, focus);\n    this.tick += dt;\n    if (this.biome.embers && this.tick > 0.25) {\n      this.tick = 0;\n      const r = this.view.fxRng;\n      this.ctx.particles.burst('ember_drift', [focus.x + r.range(-9, 9), r.range(0.2, 1), focus.z + r.range(-9, 9)]);\n    }\n    if (this.biome.wind && this.tick > 0.4) {\n      this.tick = 0;\n      const r = this.view.fxRng;\n      if (this.zone.biome === 'belfry') this.ctx.particles.burst('crackle', [focus.x + r.range(-10, 10), r.range(0.1, 2), focus.z + r.range(-10, 10)]);\n    }\n  }\n\n  dispose() {\n    const ctx = this.ctx;\n    for (const l of this.lights) l.release();\n    for (const c of this.colliders) ctx.physics.remove(c);\n    if (ctx.scene.fogNode === this.mist?.node) ctx.scene.fogNode = null;\n    this.water?.dispose();\n    this.rain?.dispose();\n    ctx.scene.remove(this.root);\n    disposeObject(this.root);\n  }\n}\n\nexport { setLookLayer, addModelColliders, glowMaterial };\nEOF\ncat > src/view/actors.js <<'EOF'\n// Actors: every body on screen. Humanoids run the hero's clips; the rest move procedurally.\nimport { buildModel, compileClips, ContactShadow, glowMaterial, HERO_RAGDOLL, HERO_RIG, LegStepper, PALETTE, Ragdoll, setLookLayer, SpringChain, Squash, THREE, toonMaterial, Trail, twoBoneIK } from '../../pixel-engine.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { ALL_CLIPS, UPPER_JOINTS } from './clips.js';\nimport { MODELS } from './models/index.js';\n\nconst { AnimationClip, AnimationMixer, BoxGeometry, CylinderGeometry, Group, LoopOnce, LoopRepeat, Mesh, Vector3 } = THREE;\n\nconst clipCache = new Map();\nexport function clipsFor(bodyId, object) {\n  let c = clipCache.get(bodyId);\n  if (!c) {\n    const list = compileClips(ALL_CLIPS, HERO_RIG, object);\n    const map = {};\n    for (const clip of list) map[clip.name] = clip;\n    c = map;\n    clipCache.set(bodyId, c);\n  }\n  return c;\n}\nconst upperCache = new Map();\nfunction upperClip(clip) {\n  let u = upperCache.get(clip);\n  if (!u) {\n    u = new AnimationClip(`${clip.name}_upper`, clip.duration, clip.tracks.filter((t) => UPPER_JOINTS.has(t.name.split('.')[0])));\n    upperCache.set(clip, u);\n  }\n  return u;\n}\n\nconst LEG_GEO = new BoxGeometry(1, 1, 1);\nconst FLASH = () => glowMaterial(PALETTE.white);\nconst UP = [0, 1, 0];\nconst groundY = () => 0;\n\nexport const CLASS_BODY = { bellwarden: 'hero_bellwarden', lamplighter: 'hero_lamplighter', sexton: 'hero_sexton', pyx: 'npc_pyx' };\nexport const SEAT_COLORS = ['red', 'sky', 'lime', 'sand'];\n\n/** Where weapons sit in a hand. */\nconst WEAPON_POSE = {\n  default: { at: [0, -0.1, 0.06], rot: [90, 0, 0], scale: 1 },\n  'hand-bell-weapon': { at: [0, -0.1, 0.06], rot: [90, 0, 0], scale: 1.1 },\n  staff: { at: [0, -0.1, -0.5], rot: [90, 0, 0], scale: 1 },\n  scythe: { at: [0, -0.1, -0.2], rot: [90, 0, 0], scale: 1 },\n  shovel: { at: [0, -0.1, -0.2], rot: [90, 0, 0], scale: 1 },\n  crossbow: { at: [0, -0.1, 0.1], rot: [0, 0, 0], scale: 1 },\n};\nconst OFF_POSE = {\n  default: { at: [0.05, -0.18, 0.05], rot: [0, 90, 0], scale: 0.9 },\n  'hand-lantern': { at: [0, -0.48, 0.05], rot: [0, 0, 0], scale: 1 },\n  censer: { at: [0, -0.62, 0.05], rot: [0, 0, 0], scale: 1 },\n};\n\nexport class Actor {\n  constructor(view, o) {\n    this.view = view;\n    this.id = o.id;\n    this.type = o.type;\n    this.def = o.def ?? MONSTERS[o.type] ?? {};\n    this.bodyId = o.body ?? this.def.body;\n    this.scale = (o.scale ?? 1) * (this.def.huge ? (o.type === 'bursar' ? 2.5 : 1) : this.def.big && this.def.humanoid && o.type !== 'coffin_bearer' ? 1.5 : 1);\n    if (this.def.small && this.def.humanoid) this.scale *= 0.6;\n    if (o.type === 'malison') this.scale = 1;\n    this.isHero = !!o.isHero;\n    this.ally = !!o.ally;\n    this.humanoid = !!(this.isHero || this.def.humanoid || o.humanoid);\n    this.time = 0;\n    this.flashT = 0;\n    this.hidden = false;\n    this.action = null; this.oneShot = null; this.base = null;\n    const palette = o.tint ? { [Object.keys(MODELS.get(this.bodyId).palette ?? {})[0]]: o.tint } : undefined;\n    const b = buildModel(this.bodyId, { catalog: MODELS, palette });\n    this.root = new Group();\n    this.body = b.object;\n    this.root.add(this.body);\n    this.root.scale.setScalar(this.scale);\n    this.meshes = [];\n    this.body.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; this.meshes.push(m); m.userData.orig = m.material; } });\n    setLookLayer(this.root, 'actors');\n    this.shadow = new ContactShadow(Math.max(0.4, (this.def.r ?? 0.42) * this.scale * (this.def.huge ? 0.8 : 1)));\n    view.actorRoot.add(this.root, this.shadow);\n    this.root.position.set(o.x, 0, o.z);\n    if (this.humanoid) {\n      this.mixer = new AnimationMixer(this.body);\n      this.clips = clipsFor(this.bodyId, this.body);\n      this.setBase(this.def.clipIdle ?? 'Idle');\n    }\n    this.squash = new Squash();\n    if (this.def.legs) this.makeLegs(this.def.legs);\n    if (o.from === 'ground') { this.riseT = 0.5; this.root.position.y = -1.6; view.dustAt(o.x, o.z); }\n    if (o.from === 'drop') { this.dropT = 0.4; this.root.position.y = 5; }\n    if (this.type === 'malison') this.makeRopes();\n    this.wingL = this.body.getObjectByName('WingL'); this.wingR = this.body.getObjectByName('WingR');\n    this.headBone = this.body.getObjectByName('HeadBone');\n    this.statueT = this.type === 'ash_gargoyle' ? 1 : 0;\n    this.seed = o.id * 0.37;\n  }\n\n  setBase(name, timeScale = 1) {\n    if (this.baseName === name) { if (this.base) this.base.timeScale = timeScale; return; }\n    const clip = this.clips[name];\n    if (!clip) return;\n    const a = this.mixer.clipAction(clip);\n    a.reset();\n    a.setLoop(LoopRepeat);\n    a.timeScale = timeScale;\n    a.enabled = true;\n    a.play();\n    if (this.base) this.base.crossFadeTo(a, 0.12, false);\n    this.base = a;\n    this.baseName = name;\n  }\n\n  /** Play a clip once over the base. upper: only the upper body, so the legs keep running. */\n  play(name, speed = 1, upper = false, hold = false) {\n    if (!this.mixer) return;\n    let clip = this.clips[name];\n    if (!clip) return;\n    if (upper) clip = upperClip(clip);\n    const a = this.mixer.clipAction(clip);\n    a.reset();\n    a.setLoop(LoopOnce, 1);\n    a.clampWhenFinished = true;\n    a.timeScale = speed;\n    a.enabled = true;\n    a.setEffectiveWeight(1);\n    if (this.oneShot && this.oneShot !== a) this.oneShot.fadeOut(0.06);\n    a.fadeIn(0.05);\n    a.play();\n    this.oneShot = a;\n    this.oneShotT = (clip.duration / Math.max(0.05, speed)) - 0.06;\n    this.oneHold = hold;\n  }\n\n  loopClip(name, dur, speed = 1) {\n    if (!this.mixer) return;\n    const clip = this.clips[name];\n    if (!clip) return;\n    const a = this.mixer.clipAction(clip);\n    a.reset();\n    a.setLoop(LoopRepeat);\n    a.timeScale = speed;\n    a.setEffectiveWeight(1);\n    if (this.oneShot && this.oneShot !== a) this.oneShot.fadeOut(0.06);\n    a.fadeIn(0.05);\n    a.play();\n    this.oneShot = a;\n    this.oneShotT = dur;\n    this.oneHold = false;\n  }\n\n  makeLegs(n) {\n    const r = this.def.r * this.scale;\n    const legs = [];\n    const rows = n / 2;\n    for (let i = 0; i < n; i++) {\n      const side = i % 2 === 0 ? -1 : 1;\n      const row = Math.floor(i / 2);\n      const z = rows === 1 ? 0 : (row / (rows - 1) - 0.5) * r * 2.4;\n      legs.push({ rest: [side * r * 1.5, z], partners: [i % 2 === 0 ? i + 1 : i - 1] });\n    }\n    this.stepper = new LegStepper({ legs, threshold: r * 0.7, stepTime: 0.14, lift: r * 0.5, lead: 0.15 });\n    this.legs = [];\n    const mat = toonMaterial(PALETTE[this.def.legColor ?? 'ink']);\n    const th = Math.max(0.07, r * 0.2);\n    for (let i = 0; i < n; i++) {\n      const a = new Mesh(LEG_GEO, mat), b = new Mesh(LEG_GEO, mat);\n      a.castShadow = b.castShadow = true;\n      setLookLayer(a, 'actors'); setLookLayer(b, 'actors');\n      this.view.actorRoot.add(a, b);\n      this.legs.push({ a, b, th });\n    }\n    this.hipH = (this.def.hipH ?? (this.def.legs === 6 ? 0.27 : this.def.big || this.def.huge ? 0.95 : 0.42)) * (this.def.huge ? 1.35 : 1);\n    this.legLen = this.hipH * 0.85 + r * 0.6;\n  }\n\n  updateLegs(dt, m, speed) {\n    const p = [this.root.position.x, 0, this.root.position.z];\n    const yaw = this.root.rotation.y;\n    const vel = [Math.sin(yaw) * speed, 0, Math.cos(yaw) * speed];\n    this.stepper.update(dt, p, yaw, vel, groundY);\n    const c = Math.cos(yaw), s = Math.sin(yaw);\n    this.legs.forEach((leg, i) => {\n      const foot = this.stepper.feet[i].at;\n      const rest = this.stepper.o.legs[i].rest;\n      const hip = [p[0] + rest[0] * 0.45 * c + rest[1] * 0.5 * s, this.hipH, p[2] - rest[0] * 0.45 * s + rest[1] * 0.5 * c];\n      const pole = [hip[0] + (hip[0] - p[0]) * 2, hip[1] + 1, hip[2] + (hip[2] - p[2]) * 2];\n      const knee = twoBoneIK(hip, foot, this.legLen * 0.55, this.legLen * 0.6, pole);\n      segment(leg.a, hip, knee, leg.th);\n      segment(leg.b, knee, foot, leg.th * 0.8);\n    });\n  }\n\n  makeRopes() {\n    this.ropes = [];\n    const mat = toonMaterial(PALETTE.sand);\n    for (let i = 0; i < 4; i++) {\n      const chain = new SpringChain({ segments: 7, length: 0.75, rest: [0, -0.55, 0.85], stiffness: 5, keep: 0.93, gravity: 3 });\n      const segs = [];\n      for (let k = 0; k < 7; k++) {\n        const m = new Mesh(LEG_GEO, mat);\n        m.castShadow = true;\n        setLookLayer(m, 'actors');\n        this.view.actorRoot.add(m);\n        segs.push(m);\n      }\n      this.ropes.push({ chain, segs, side: i % 2 === 0 ? -1 : 1, up: i < 2 ? 2.8 : 1.6 });\n    }\n  }\n\n  updateRopes(dt) {\n    const yaw = this.root.rotation.y;\n    const c = Math.cos(yaw), s = Math.sin(yaw);\n    const right = [c, 0, -s], up = UP, fwd = [s, 0, c];\n    const p = this.root.position;\n    for (const r of this.ropes) {\n      const root = [p.x + right[0] * r.side * 1.2, p.y + r.up, p.z + right[2] * r.side * 1.2];\n      const sway = this.lash > 0 ? 3 : 0.3;\n      const rb = [[right[0] * r.side, 0, right[2] * r.side], up, [fwd[0] + Math.sin(this.time * 2 + r.side) * sway * 0.2, 0, fwd[2]]];\n      r.chain.update(dt, root, rb);\n      for (let k = 0; k < r.segs.length; k++) segment(r.segs[k], r.chain.points[k], r.chain.points[k + 1], 0.22);\n    }\n  }\n\n  // ---- Hero gear ---------------------------------------------------------------------------\n  setGear(g, cls) {\n    const hand = this.body.getObjectByName('HandR');\n    const offHand = this.body.getObjectByName('HandL');\n    const head = this.body.getObjectByName('Head');\n    const armR = this.body.getObjectByName('ArmR');\n    const armL = this.body.getObjectByName('ArmL');\n    const swap = (parent, key, id, pose) => {\n      if (this.gearAt?.[key] === id) return;\n      this.gearAt = this.gearAt ?? {};\n      if (this.gearObj?.[key]) parent.remove(this.gearObj[key]);\n      this.gearObj = this.gearObj ?? {};\n      this.gearObj[key] = null;\n      this.gearAt[key] = id;\n      if (!id) return;\n      const o = buildModel(id, { catalog: MODELS }).object;\n      o.traverse((m) => { if (m.isMesh) { m.castShadow = true; this.meshes.push(m); m.userData.orig = m.material; } });\n      if (pose) {\n        o.position.set(...pose.at);\n        o.rotation.set((pose.rot[0] * Math.PI) / 180, (pose.rot[1] * Math.PI) / 180, (pose.rot[2] * Math.PI) / 180);\n        o.scale.setScalar(pose.scale ?? 1);\n      }\n      setLookLayer(o, 'actors');\n      parent.add(o);\n      this.gearObj[key] = o;\n    };\n    if (hand) swap(hand, 'main', g.main || null, WEAPON_POSE[g.main] ?? WEAPON_POSE.default);\n    if (offHand) swap(offHand, 'off', g.off || null, OFF_POSE[g.off] ?? OFF_POSE.default);\n    if (!CLASS_BODY[cls] || cls === 'pyx') return;\n    const tierOf = (r) => (r === 'legendary' || r === 'set' || r === 'reliquary' ? 2 : r === 'blessed' ? 1 : 0);\n    if (head) swap(head, 'helm', g.head ? `helm_${cls}_${tierOf(g.head)}` : null);\n    if (armR) swap(armR, 'shR', g.shoulders ? `shoulder_${cls}_${tierOf(g.shoulders)}` : null, { at: [-0.02, 0.06, 0], rot: [0, 0, 0] });\n    if (armL) swap(armL, 'shL', g.shoulders ? `shoulder_${cls}_${tierOf(g.shoulders)}` : null, { at: [0.02, 0.06, 0], rot: [0, 0, 0] });\n  }\n\n  setTrail(colorHead, colorTail) {\n    this.trail = new Trail({ width: 0.26, life: 0.16, points: 16 });\n    this.trail.head.setHex(colorHead);\n    this.trail.tail.setHex(colorTail);\n    this.view.actorRoot.add(this.trail);\n    this.tipTmp = new Vector3();\n  }\n\n  flash(frames = 2) {\n    this.flashT = frames;\n    const glow = FLASH();\n    for (const m of this.meshes) m.material = glow;\n  }\n\n  sync(x, z, facing, moving, speed, dt) {\n    this.time += dt;\n    const p = this.root.position;\n    p.x = x; p.z = z;\n    this.root.rotation.y = facing;\n    if (this.flashT > 0) {\n      this.flashT--;\n      if (this.flashT <= 0) for (const m of this.meshes) m.material = m.userData.orig;\n    }\n    if (this.riseT > 0) { this.riseT -= dt; p.y = -Math.max(0, this.riseT / 0.5) * 1.6; }\n    else if (this.dropT > 0) {\n      this.dropT -= dt;\n      p.y = Math.max(0, this.dropT / 0.4) ** 2 * 5;\n      if (this.dropT <= 0) { p.y = 0; this.squash.kick(-5); this.view.dustAt(x, z); }\n    }\n    if (this.def.hover) p.y = this.def.hover * 0.5 + Math.sin(this.time * 2 + this.seed) * 0.12 + (this.type === 'ash_gargoyle' ? 0.2 : 0);\n    if (this.mixer) {\n      if (moving && speed > 0.1) {\n        const name = this.def.clipMove ?? (speed > 3 ? 'Run' : 'Walk');\n        const auth = name === 'Run' ? 5.5 : name === 'Walk' ? 2 : name === 'Shamble' ? 1.4 : 2;\n        this.setBase(name, Math.max(0.5, speed / auth));\n      } else this.setBase(this.def.clipIdle ?? 'Idle', 1);\n      if (this.oneShot) {\n        this.oneShotT -= dt;\n        if (this.oneShotT <= 0 && !this.oneHold) { this.oneShot.fadeOut(0.08); this.oneShot = null; }\n      }\n      this.mixer.update(dt);\n    }\n    this.squash.update(dt);\n    const [sh, sv] = this.squash.scale();\n    this.body.scale.set(sh, sv, sh);\n    if (this.stepper) this.updateLegs(dt, null, moving ? speed : 0);\n    if (this.wingL) {\n      const a = moving ? Math.sin(this.time * 12) * 0.7 : -0.1;\n      this.wingL.rotation.z = a; this.wingR.rotation.z = -a;\n    }\n    if (this.ropes) this.updateRopes(dt);\n    if (this.lash > 0) this.lash -= dt;\n    if (this.headTilt > 0) { this.headTilt -= dt; if (this.headBone) this.headBone.rotation.x = -Math.sin(this.headTilt * 8) * 0.35; }\n    this.shadow.place(x, 0, z, Math.max(0, p.y));\n    this.shadow.visible = this.root.visible;\n    if (this.trail) {\n      const hand = this.gearObj?.main ?? this.body.getObjectByName('HandR');\n      if (this.oneShot && hand) {\n        hand.getWorldPosition(this.tipTmp);\n        this.trail.push(this.tipTmp, this.time);\n      }\n      this.trail.update(this.time, this.view.ctx.camera.camera);\n    }\n  }\n\n  setHidden(on) {\n    this.hidden = on;\n    this.root.visible = !on;\n    this.shadow.visible = !on;\n  }\n\n  /** Leave the scene entirely. */\n  remove() {\n    const r = this.view.actorRoot;\n    r.remove(this.root, this.shadow);\n    if (this.legs) for (const l of this.legs) r.remove(l.a, l.b);\n    if (this.ropes) for (const q of this.ropes) for (const s of q.segs) r.remove(s);\n    if (this.trail) { r.remove(this.trail); this.trail.dispose(); }\n    if (this.light) this.light.release();\n    if (this.mixer) this.mixer.stopAllAction();\n    if (this.dissolved) for (const m of this.dissolved) m.dispose();\n  }\n\n  /** A per-body dissolve, only for those who are going. */\n  startDissolve() {\n    this.dissolved = [];\n    for (const m of this.meshes) {\n      const orig = m.userData.orig;\n      if (!orig?.color || orig.isMeshBasicNodeMaterial) { m.visible = false; continue; }\n      const clone = toonMaterial(orig.color.getHex(), { dissolve: true }).clone();\n      clone.dissolve = 0;\n      m.material = clone;\n      m.userData.orig = clone;\n      this.dissolved.push(clone);\n    }\n  }\n  setDissolve(v) { if (this.dissolved) for (const m of this.dissolved) m.dissolve = v; }\n}\n\nconst tmpA = new Vector3();\nfunction segment(mesh, a, b, th) {\n  const dx = b[0] - a[0], dy = b[1] - a[1], dz = b[2] - a[2];\n  const L = Math.hypot(dx, dy, dz) || 0.01;\n  mesh.position.set((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2);\n  tmpA.set(b[0], b[1], b[2]);\n  mesh.lookAt(tmpA);\n  mesh.scale.set(th, th, L);\n}\n\nexport function makeRagdoll(view, actor, vel) {\n  const doll = new Ragdoll(view.ctx.physics, actor.body, HERO_RAGDOLL);\n  doll.enable({ velocity: vel });\n  return doll;\n}\n\nexport { CylinderGeometry };\nEOF\necho ok","description":"Write effects kit, zone builder and actors"}}}
