{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjhshVhXf6dFYEjk6JQ","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4358,"cache_read_input_tokens":747147,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4358},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"5c78f324-8b35-4f11-a83e-ab40e7cdebc0","timestamp":"2026-11-06T00:36:53.453Z","request_id":"req_011CgkjhsRdjrftdor4NGiGT","thinking_duration_ms":85617,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjhshVhXf6dFYEjk6JQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BzzYPQFe8R42d6J2ZjzWPN","name":"Bash","input":{"command":"cat > src/net/codec.js <<'EOF'\n// The wire: flat integer arrays for the moving things. Positions are times ten.\nexport const STATE_CODE = { idle: 0, run: 1, cast: 2, dodge: 3, dead: 4, channel: 5, stunned: 6, dash: 7, leap: 8 };\nexport const CODE_STATE = Object.fromEntries(Object.entries(STATE_CODE).map(([k, v]) => [v, k]));\nconst r10 = (v) => Math.round(v * 10);\n\nconst nearestFirst = (w, list) => {\n  const heroes = w.heroes.filter((h) => !h.gone);\n  const score = (m) => { let best = Infinity; for (const h of heroes) { const d = (m.x - h.x) ** 2 + (m.z - h.z) ** 2; if (d < best) best = d; } return best; };\n  return list.map((m) => [score(m), m]).sort((a, b) => a[0] - b[0]).map((p) => p[1]);\n};\n\n/** A snapshot under 1,100 bytes: the 24 nearest every time, a rotating slice of the rest. */\nexport function encodeSnapshot(w, cursor) {\n  const h = [];\n  for (const o of w.heroes) {\n    if (o.gone) continue;\n    h.push(o.id, r10(o.x), r10(o.z), r10(o.facing), STATE_CODE[o.state] ?? 0, Math.round(o.hp), Math.round(o.res), (o.dead ? 1 : 0) | (o.moving ? 2 : 0) | (o.channel > 0 ? 4 : 0));\n  }\n  const live = w.monsters.filter((m) => !m.dead && !m.hidden);\n  const ordered = nearestFirst(w, live);\n  const near = ordered.slice(0, 24);\n  const rest = ordered.slice(24).filter((m) => (m.x - w.heroes[0]?.x) ** 2 + (m.z - w.heroes[0]?.z) ** 2 < 1600);\n  const slice = [];\n  for (let i = 0; i < Math.min(8, rest.length); i++) slice.push(rest[(cursor.i + i) % rest.length]);\n  cursor.i = rest.length ? (cursor.i + 8) % rest.length : 0;\n  const m = [];\n  for (const o of [...near, ...slice]) m.push(o.id, r10(o.x), r10(o.z), r10(o.facing), Math.round(o.hp));\n  const a = [];\n  for (const o of w.allies) { if (o.def.static) continue; a.push(o.id, r10(o.x), r10(o.z), r10(o.facing), o.moving ? 1 : 0); }\n  const msg = { k: 's', n: w.t, h, m, a };\n  // Trim from the far end until it fits one packet.\n  let json = JSON.stringify(msg);\n  while (json.length > 1090 && msg.m.length) { msg.m.length -= 5; json = JSON.stringify(msg); }\n  while (json.length > 1090 && msg.a.length) { msg.a.length -= 5; json = JSON.stringify(msg); }\n  return msg;\n}\n\n/** Events that are not plain data, or that nobody across the wire needs, stay home. */\nconst LOCAL_ONLY = new Set(['autosave', 'bestiary', 'hero', 'talk', 'open', 'lore', 'cut', 'zone']);\nexport function wireEvents(list, maxBytes = 12000) {\n  const out = [];\n  let size = 12;\n  while (list.length) {\n    const e = list[0];\n    if (LOCAL_ONLY.has(e.t)) { list.shift(); continue; }\n    const j = JSON.stringify(e).length + 1;\n    if (size + j > maxBytes) break;\n    size += j;\n    out.push(e);\n    list.shift();\n  }\n  return out;\n}\nEOF\ncat > src/net/host.js <<'EOF'\n// The host's copy runs the only true sim. It takes intent from seats, sends the world back.\nimport { applyCommand } from '../sim/commands.js';\nimport { heroToData } from '../sim/hero.js';\nimport { emptyIntent } from '../sim/intents.js';\nimport { encodeSnapshot, wireEvents } from './codec.js';\n\nconst SNAP_EVERY = 6;   // 10 Hz at 60 steps a second\nconst EVENT_EVERY = 12; // 5 Hz\n\nexport class NetHost {\n  constructor(transport, world, localSeat) {\n    this.t = transport;\n    this.w = world;\n    this.seat = localSeat;\n    this.remote = new Map();\n    this.press = new Map();\n    this.goals = new Map();\n    this.queue = [];\n    this.cursor = { i: 0 };\n    this.tick = 0;\n    this.sentHd = new Map();\n    this.hdTurn = 0;\n    this.stats = { maxS: 0, maxE: 0, sent: 0 };\n  }\n\n  onMessage(data, from) {\n    switch (data.k) {\n      case 'i': {\n        const cur = this.remote.get(from);\n        if (cur && data.q <= cur.q) return;\n        this.remote.set(from, data);\n        break;\n      }\n      case 'p': this.press.set(from, (this.press.get(from) ?? 0) | data.b); if (data.g) this.goals.set(from, data.g); break;\n      case 'c': applyCommand(this.w, from, data.c); this.markDirty(from); break;\n      default: break;\n    }\n  }\n\n  markDirty(seat) { this.sentHd.set(seat, ''); }\n\n  /** Intents for every seat, with the local player's merged in. */\n  intents(localIntent) {\n    const out = [];\n    for (const h of this.w.heroes) {\n      if (h.gone) continue;\n      if (h.seat === this.seat) { out[h.seat] = localIntent ?? emptyIntent(); continue; }\n      const it = emptyIntent();\n      const r = this.remote.get(h.seat);\n      if (r) { it.mx = r.x / 100; it.mz = r.z / 100; it.ax = r.a / 10; it.az = r.b / 10; it.aimed = r.m; it.tgt = r.t; it.held = r.h; }\n      it.pressed = this.press.get(h.seat) ?? 0;\n      this.press.set(h.seat, 0);\n      const g = this.goals.get(h.seat);\n      if (g) { it.goal = g; this.goals.delete(h.seat); }\n      out[h.seat] = it;\n    }\n    return out;\n  }\n\n  addEvents(list) { for (const e of list) this.queue.push(e); }\n\n  send(data, o) {\n    const ok = this.t.send(data, o);\n    if (ok) this.stats.sent++;\n    return ok;\n  }\n\n  /** Once per sim step, even while nothing happens. */\n  step() {\n    this.tick++;\n    if (this.tick % SNAP_EVERY === 0) {\n      const s = encodeSnapshot(this.w, this.cursor);\n      this.stats.maxS = Math.max(this.stats.maxS, JSON.stringify(s).length);\n      this.send(s, { reliable: false });\n    }\n    if (this.tick % EVENT_EVERY === 0 && this.queue.length) {\n      const keep = this.queue;\n      const list = wireEvents(keep);\n      if (list.length) {\n        const msg = { k: 'e', e: list };\n        this.stats.maxE = Math.max(this.stats.maxE, JSON.stringify(msg).length);\n        if (!this.send(msg, { reliable: true })) keep.unshift(...list);\n      }\n    }\n    if (this.tick % 60 === 0) this.sendHeroData();\n  }\n\n  /** Every hero's own pack, to that hero's copy, when it has changed. One a second. */\n  sendHeroData() {\n    const list = this.w.heroes.filter((h) => !h.gone && h.seat !== this.seat);\n    if (!list.length) return;\n    this.hdTurn = (this.hdTurn + 1) % list.length;\n    const h = list[this.hdTurn];\n    const d = heroToData(h);\n    for (const it of d.inv) if (it) { delete it.flavor; delete it.powerText; }\n    const json = JSON.stringify(d);\n    if (this.sentHd.get(h.seat) === json) return;\n    if (json.length > 15000) return;\n    if (this.send({ k: 'd', d }, { reliable: true, to: h.seat })) this.sentHd.set(h.seat, json);\n  }\n}\nEOF\ncat > src/net/client.js <<'EOF'\n// A client's copy: the same map from the same seed, a mirror of the world, intent going up.\nimport { MONSTERS } from '../data/monsters.js';\nimport { LEGENDARIES } from '../data/items.js';\nimport { slide } from '../sim/core.js';\nimport { recalcHero } from '../sim/hero.js';\nimport { CODE_STATE } from './codec.js';\n\nexport class NetClient {\n  constructor(transport, world, seat) {\n    this.t = transport;\n    this.w = world;\n    this.seat = seat;\n    this.q = 0;\n    this.targets = new Map();\n    this.pending = [];\n    this.pressQueue = 0;\n    this.goal = null;\n    this.reliableQueue = [];\n    this.lastN = -1;\n    this.acc = 0;\n    this.stats = { s: 0, e: 0 };\n    this.mono = new Map();\n  }\n\n  get me() { return this.w.heroes.find((h) => h.seat === this.seat); }\n\n  onMessage(data) {\n    switch (data.k) {\n      case 's': this.applySnapshot(data); break;\n      case 'e':\n        this.stats.e++;\n        for (const ev of data.e) { this.applyEvent(ev); this.pending.push(ev); }\n        break;\n      case 'd': this.applyHeroData(data.d); break;\n      default: break;\n    }\n  }\n\n  applySnapshot(s) {\n    if (s.n <= this.lastN) return;\n    this.lastN = s.n;\n    this.stats.s++;\n    this.w.t = s.n;\n    this.w.time = s.n / 60;\n    const w = this.w;\n    for (let i = 0; i < s.h.length; i += 8) {\n      const h = w.heroes.find((o) => o.id === s.h[i]);\n      if (!h) continue;\n      const isMe = h.seat === this.seat;\n      const tx = s.h[i + 1] / 10, tz = s.h[i + 2] / 10;\n      this.targets.set(h.id, { x: tx, z: tz, f: s.h[i + 3] / 10, e: h });\n      if (!isMe) { h.facing = s.h[i + 3] / 10; h.moving = !!(s.h[i + 7] & 2); h.state = CODE_STATE[s.h[i + 4]] ?? 'idle'; }\n      h.hp = s.h[i + 5];\n      h.res = s.h[i + 6];\n      h.dead = !!(s.h[i + 7] & 1);\n      if (h.dead) h.state = 'dead';\n      h.channel = s.h[i + 7] & 4 ? h.channel + 0.1 : 0;\n      h.deadT = h.dead ? (h.deadT ?? 0) + 0.1 : 0;\n    }\n    for (let i = 0; i < s.m.length; i += 5) {\n      const m = w.monsters.find((o) => o.id === s.m[i]);\n      if (!m) continue;\n      const tx = s.m[i + 1] / 10, tz = s.m[i + 2] / 10;\n      this.targets.set(m.id, { x: tx, z: tz, f: s.m[i + 3] / 10, e: m });\n      m.hp = s.m[i + 4];\n    }\n    for (let i = 0; i < s.a.length; i += 5) {\n      const a = w.allies.find((o) => o.id === s.a[i]);\n      if (!a) continue;\n      this.targets.set(a.id, { x: s.a[i + 1] / 10, z: s.a[i + 2] / 10, f: s.a[i + 3] / 10, e: a });\n      a.moving = !!s.a[i + 4];\n    }\n  }\n\n  /** Keep the mirror's lists true. The view reads them; effects come from the same events. */\n  applyEvent(e) {\n    const w = this.w;\n    switch (e.t) {\n      case 'spawn': {\n        const def = MONSTERS[e.k];\n        const base = { id: e.id, type: e.k, def, x: e.x, z: e.z, r: (def?.r ?? 0.4) * (e.s ?? 1), facing: e.f, hp: e.hp, maxHp: e.hp, status: {}, name: e.n, elite: e.e || null, aff: e.aff ?? [], scale: e.s ?? 1, level: 12, moving: false, state: 'chase', knellPts: 0 };\n        if (e.ally) w.allies.push({ ...base, ally: true, owner: e.owner, def });\n        else w.monsters.push(base);\n        break;\n      }\n      case 'death': case 'remove':\n        for (const list of [w.monsters, w.allies]) {\n          const i = list.findIndex((m) => m.id === e.id);\n          if (i >= 0) { list[i].dead = true; list.splice(i, 1); }\n        }\n        this.targets.delete(e.id);\n        if (w.boss?.id === e.id) w.boss = null;\n        break;\n      case 'hit': { const m = w.monsters.find((o) => o.id === e.id); if (m && e.a) m.hp -= e.a; break; }\n      case 'hide': { const m = w.monsters.find((o) => o.id === e.id); if (m) m.hidden = true; break; }\n      case 'unhide': { const m = w.monsters.find((o) => o.id === e.id); if (m) { m.hidden = false; m.x = e.x; m.z = e.z; } break; }\n      case 'boss': { const m = w.monsters.find((o) => o.id === e.id); if (m) { w.boss = m; m.bossState = { round: 1, phase: 1 }; m.def = MONSTERS[e.k]; } break; }\n      case 'boss_round': { const m = w.monsters.find((o) => o.id === e.id); if (m?.bossState) m.bossState.round = e.round; break; }\n      case 'boss_dead': w.boss = null; break;\n      case 'knell': if (w.run) { w.run.meter = e.v; w.run.total = e.of; } break;\n      case 'knell_tolls': if (w.run) w.run.state = 'warden'; break;\n      case 'run_done': if (w.run) w.run.state = 'done'; break;\n      case 'level': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.level = e.level; recalcHero(w, h); } break; }\n      case 'gear': { const h = w.heroes.find((o) => o.id === e.id); if (h) h.gearLook = e.g; break; }\n      case 'hero_class': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.cls = e.cls; recalcHero(w, h); } break; }\n      case 'down': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.dead = true; h.state = 'dead'; h.deadT = 0; h.deathWait = 8; } break; }\n      case 'up': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.dead = false; h.state = 'idle'; h.x = e.x; h.z = e.z; this.targets.delete(h.id); } break; }\n      case 'pick3': { const h = w.heroes.find((o) => o.seat === e.seat); if (h) h.pick = { t: 10, opts: e.opts }; break; }\n      case 'pick3x': { const h = w.heroes.find((o) => o.seat === e.seat); if (h) h.pick = null; break; }\n      case 'obj': {\n        const o = w.objects.find((q) => q.id === e.id);\n        if (o) { o.state = e.state; if (e.hidden !== undefined) o.hidden = e.hidden; if (e.locked !== undefined) o.locked = e.locked; }\n        break;\n      }\n      case 'objadd': if (!w.objects.some((q) => q.id === e.o.id)) w.objects.push({ ...e.o, r: 1 }); break;\n      case 'objmove': { const o = w.objects.find((q) => q.id === e.id); if (o) { o.x = e.x; o.z = e.z; } break; }\n      case 'prop': { const p = w.props.find((q) => q.id === e.id); if (p) p.broken = true; break; }\n      case 'drop': w.drops.push({ id: e.id, kind: e.kind, x: e.x, z: e.z, owner: e.owner, t: 1 }); break;\n      case 'dropx': { const i = w.drops.findIndex((d) => d.id === e.id); if (i >= 0) w.drops.splice(i, 1); break; }\n      default: break;\n    }\n  }\n\n  applyHeroData(d) {\n    const h = this.me;\n    if (!h) return;\n    Object.assign(h, d);\n    for (const it of h.inv) if (it?.power && !it.powerText) it.powerText = LEGENDARIES[it.power].power;\n    recalcHero(this.w, h);\n  }\n\n  /** Per sim step: predict our own hero, smooth everyone else, send intent. */\n  step(intent, dt) {\n    const me = this.me;\n    if (me && !me.dead) this.predict(me, intent, dt);\n    const lerp = Math.min(1, dt * 9);\n    for (const [id, t] of this.targets) {\n      const e = t.e;\n      if (e.dead && e !== me) { this.targets.delete(id); continue; }\n      if (e === me) {\n        const err = Math.hypot(t.x - e.x, t.z - e.z);\n        if (err > 3) { e.x = t.x; e.z = t.z; }\n        else if (err > 1) { e.x += (t.x - e.x) * 0.2; e.z += (t.z - e.z) * 0.2; }\n        else if (err > 0.2 && !intent?.mx && !intent?.mz) { e.x += (t.x - e.x) * 0.1; e.z += (t.z - e.z) * 0.1; }\n        continue;\n      }\n      const dx = t.x - e.x, dz = t.z - e.z;\n      e.x += dx * lerp; e.z += dz * lerp;\n      if (e.seat === undefined) { e.moving = Math.hypot(dx, dz) > 0.08; e.facing = t.f; }\n    }\n    this.acc += dt;\n    if (this.acc >= 0.1) {\n      this.acc -= 0.1;\n      this.q++;\n      const it = intent ?? {};\n      this.t.send({ k: 'i', q: this.q, x: Math.round((it.mx ?? 0) * 100), z: Math.round((it.mz ?? 0) * 100), a: Math.round((it.ax ?? 0) * 10), b: Math.round((it.az ?? 0) * 10), m: it.aimed ?? 0, t: it.tgt ?? 0, h: it.held ?? 0 }, { reliable: false });\n    }\n    if (intent?.pressed || intent?.goal) { this.pressQueue |= intent.pressed ?? 0; if (intent.goal) this.goal = intent.goal; }\n    if ((this.pressQueue || this.goal) && this.t.send({ k: 'p', b: this.pressQueue, g: this.goal ?? undefined }, { reliable: true })) { this.pressQueue = 0; this.goal = null; }\n    while (this.reliableQueue.length) {\n      if (!this.t.send(this.reliableQueue[0], { reliable: true })) break;\n      this.reliableQueue.shift();\n    }\n  }\n\n  predict(h, it, dt) {\n    if (!it) { h.moving = false; return; }\n    const mag = Math.hypot(it.mx, it.mz);\n    h.moving = mag > 0.02 && !h.dead;\n    if (!h.moving) { h.state = 'idle'; return; }\n    const speed = (h.stats?.moveSpeed ?? 5) * Math.min(1, mag) * dt;\n    slide(this.w, h, (it.mx / mag) * speed, (it.mz / mag) * speed);\n    h.dirX = it.mx / mag; h.dirZ = it.mz / mag;\n    h.facing = Math.atan2(h.dirX, h.dirZ);\n    h.state = 'run';\n  }\n\n  sendCommand(c) { this.reliableQueue.push({ k: 'c', c }); }\n\n  drain() {\n    const p = this.pending;\n    this.pending = [];\n    return p;\n  }\n}\nEOF\ncat > src/net/hubflow.js <<'EOF'\n// A session of AI Hub: straight into the round, no title or menus. The host's sim is the only truth.\nimport { Engine } from '../../pixel-engine.js';\nimport { TITLE } from '../data/meta.js';\nimport { GOAL_TEXT } from './card.js';\nimport { DiabellicalGame, VIGNETTE_LOOK } from '../modes/game.js';\nimport { botAfter } from '../sim/bot.js';\nimport { emptyIntent } from '../sim/intents.js';\nimport { roundResults, setupRound } from '../sim/round.js';\nimport { createWorld, stepWorld } from '../sim/world.js';\nimport { CardScreen } from './card.js';\nimport { NetClient } from './client.js';\nimport { NetHost } from './host.js';\n\nconst hubTransport = {\n  send(data, o) {\n    try { return AIHub.send(data, o) !== false; } catch { return false; }\n  },\n};\n\n/** Everything hub-side for one copy: what game.net points at. */\nexport class HubNet {\n  constructor(game, info) {\n    this.game = game;\n    this.info = info;\n    this.seat = info.server ? null : info.me;\n    this.isHost = !!info.isHost;\n    this.started = false;\n    this.ended = false;\n    this.finished = false;\n    this.card = { left: null, paused: false, starting: false, ready: [], asking: 0, asked: false };\n    this.unsub = [];\n  }\n\n  setup(ctx) {\n    const g = this.game;\n    const info = this.info;\n    const w = createWorld({ seed: info.seed >>> 0, camp: null, mode: 'session' });\n    this.world = w;\n    g.world = w;\n    setupRound(w, info.players);\n    w.events.length = 0;\n    if (this.isHost) this.host = new NetHost(hubTransport, w, this.seat);\n    else this.client = new NetClient(hubTransport, w, this.seat);\n    g.isSession = true;\n    g.isClient = !this.isHost;\n    g.mode = 'play';\n    g.net = this;\n    if (!info.server) {\n      g.view.setWorld(w);\n      g.audioSys.music('vespers');\n      g.openScreen(new CardScreen(g, this));\n      ctx.engine.setLook(VIGNETTE_LOOK(0.3));\n      // Enter must answer the card even if frames are slow: a plain listener, not the frame loop.\n      this.onKey = (e) => {\n        if (this.started) return;\n        if (e.code === 'Enter') AIHub.answer('ready');\n        else if (e.code === 'KeyM') AIHub.answer('more');\n      };\n      window.addEventListener('keydown', this.onKey);\n    }\n    this.unsub.push(AIHub.on('card', (c) => { this.card = c; }));\n    this.unsub.push(AIHub.on('start', () => { this.started = true; }));\n    this.unsub.push(AIHub.on('message', (data, from) => {\n      if (this.ended) return;\n      if (this.host) this.host.onMessage(data, from);\n      else this.client?.onMessage(data, from);\n    }));\n    this.unsub.push(AIHub.on('leave', (e) => this.onLeave(e)));\n    this.unsub.push(AIHub.on('time-up', () => this.onTimeUp()));\n    this.unsub.push(AIHub.on('end', () => this.onEnd()));\n  }\n\n  onLeave({ id }) {\n    const w = this.world;\n    const h = w.heroes.find((o) => o.seat === id);\n    if (!h) return;\n    h.gone = true;\n    w.heroes.splice(w.heroes.indexOf(h), 1);\n    this.game.view?.ev_hero_gone?.({ id: h.id });\n    for (const a of w.allies) if (a.owner === h.id) a.life = 0.01;\n    if (!this.info.server) this.game.hudSys?.toast(`${h.name} LEFT`, 'mist');\n  }\n\n  onTimeUp() { if (this.isHost) this.finish(false); }\n\n  finish(won) {\n    if (this.finished) return;\n    this.finished = true;\n    const r = roundResults(this.world, won);\n    try { AIHub.finish(r); } catch { /* the hub may already be gone */ }\n  }\n\n  onEnd() {\n    this.ended = true;\n    const g = this.game;\n    g.audioSys?.stopAll();\n    g.closeAll?.();\n    if (this.onKey) window.removeEventListener('keydown', this.onKey);\n    if (this.timer) clearInterval(this.timer);\n    g.ctx?.input?.release?.();\n  }\n\n  /** Play has begun when the hub's clock passes zero. */\n  get playing() { return !this.ended && this.started && AIHub.time() >= 0; }\n  timeLeft() {\n    if (!this.started) return null;\n    return Math.max(0, (this.info.limitMs - AIHub.time()) / 1000);\n  }\n\n  localIntent() {\n    const g = this.game;\n    const h = g.localHero();\n    if (!h || this.ended) return emptyIntent();\n    if (g.menuBlocks()) return emptyIntent();\n    return g.input.intentForHero(h, this.world);\n  }\n\n  fixedUpdate(dt) {\n    if (!this.playing) return;\n    const g = this.game;\n    const w = this.world;\n    if (this.host) {\n      const intents = this.host.intents(this.seat === null ? null : this.localIntent());\n      stepWorld(w, intents);\n      if (w.events.length) {\n        this.host.addEvents(w.events);\n        if (!this.info.server) for (const e of w.events) g.pendingEvents.push(e);\n        w.events.length = 0;\n      }\n      this.host.step();\n      if (w.round.finished) this.finish(true);\n    } else if (this.client) {\n      this.client.step(this.localIntent(), dt);\n      for (const e of this.client.drain()) g.pendingEvents.push(e);\n    }\n  }\n\n  update() {\n    // Traffic flows even before play begins, so a slow copy still says something.\n    if (!this.started && !this.ended) {\n      this.idleT = (this.idleT ?? 0) + 1;\n    }\n  }\n\n  drawOverlay(ui) {\n    if (this.ended) return;\n    if (this.started && AIHub.time() < 0) {\n      const n = Math.ceil(-AIHub.time() / 1000);\n      ui.text(ui.w / 2, ui.h / 2 - 30, n, { color: 'white', scale: 4, align: 'center' });\n    }\n    if (this.game.frame % 1 === 0 && this.started && AIHub.time() >= 0 && AIHub.time() < 2500) ui.text(ui.w / 2, ui.h / 2 - 30, 'FILL THE KNELL', { color: 'sand', scale: 2, align: 'center' });\n  }\n\n  sendCommand(c) { this.client?.sendCommand(c); }\n}\n\nexport async function runHubSession(engineOptions) {\n  let info = null;\n  try {\n    info = await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true });\n  } catch { info = null; }\n  if (!info) {\n    await Engine.start(new DiabellicalGame({}), engineOptions(false));\n    return;\n  }\n  const game = new DiabellicalGame({\n    hub: info,\n    server: !!info.server,\n    noAttract: true,\n    onSetup: (g, ctx) => {\n      const net = new HubNet(g, info);\n      net.setup(ctx);\n    },\n  });\n  try {\n    if (info.server) {\n      const engine = await Engine.headless(game, {});\n      if (typeof window !== 'undefined') window.__GAME__ = game;\n      let last = performance.now();\n      game.net.timer = setInterval(() => {\n        const now = performance.now();\n        const n = Math.min(30, Math.round((now - last) * 0.06));\n        if (n > 0) { last = now; engine.step(n); }\n      }, 33);\n    } else {\n      await Engine.start(game, engineOptions(false));\n    }\n  } catch (e) {\n    AIHub.fail(`${TITLE} needs WebGPU: ${String(e?.message ?? e)}`);\n    return;\n  }\n  AIHub.ready();\n}\n\nexport { botAfter, GOAL_TEXT };\nEOF\ncat > src/net/card.js <<'EOF'\n// The game's own card: heroes in a torchlit room, who is here, how to win, how to play, the time left.\nimport { CLASSES } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { SEAT_CLASSES } from '../sim/round.js';\nimport { Screen } from '../ui/menus/base.js';\n\nexport const GOAL_TEXT = 'FILL THE KNELL, THEN SLAY ITS WARDEN TOGETHER';\nconst HEX = (h) => parseInt(String(h).replace('#', ''), 16);\n\nexport class CardScreen extends Screen {\n  constructor(game, net) {\n    super(game, { tag: 'card', freeze: false, holdSim: false });\n    this.net = net;\n  }\n  back() {}\n  draw(ui) {\n    const net = this.net;\n    if (net.started) { this.game.closeScreen(); return; }\n    const W = ui.w, H = ui.h;\n    const info = net.info;\n    const card = net.card;\n    ui.rect(0, 0, W, 34, 'ink');\n    ui.text(W / 2, 6, TITLE, { color: 'sand', scale: 3, align: 'center' });\n    ui.rect(0, H - 100, W, 100, 'ink');\n    ui.rect(0, H - 101, W, 1, 'slate');\n    // Who is here.\n    let x = 14;\n    info.players.forEach((p) => {\n      const ready = card.ready?.includes(p.id);\n      const cls = CLASSES[SEAT_CLASSES[p.id % 4]].name;\n      ui.rect(x, H - 96, 96, 22, HEX(p.color));\n      ui.rect(x + 1, H - 95, 94, 20, 'ink');\n      ui.text(x + 4, H - 93, String(p.name).slice(0, 12), { color: HEX(p.color) });\n      ui.text(x + 4, H - 84, cls.slice(0, 11), { color: 'mist' });\n      if (ready) ui.text(x + 90, H - 84, 'OK', { color: 'lime', align: 'right' });\n      x += 100;\n    });\n    ui.text(14, H - 70, GOAL_TEXT, { color: 'white' });\n    // This player's controls, in the current glyphs.\n    let cx = 14;\n    const cy = H - 58;\n    for (const [a, label] of [['move', 'MOVE'], ['s0', 'ATTACK'], ['s1', 'SKILLS'], ['dodge', 'ROLL'], ['potion', 'DRINK']]) cx += ui.prompt(a, label, cx, cy);\n    const left = card.left === null || card.left === undefined ? (card.paused ? 'THE COUNTDOWN WAITS' : 'STARTING') : `${Math.ceil(card.left / 1000)} SECONDS`;\n    ui.text(W - 14, H - 70, left, { color: 'sand', align: 'right' });\n    const iReady = card.ready?.includes(info.me);\n    if (ui.button('card:ready', 14, H - 42, 110, 20, iReady ? 'READY' : 'READY?', { color: iReady ? 'lime' : 'white' })) AIHub.answer('ready');\n    if (ui.button('card:more', 130, H - 42, 110, 20, card.asked ? 'ASKED' : 'MORE TIME', { color: card.asked ? 'sand' : 'mist' })) AIHub.answer('more');\n    if (card.asking > 0) ui.text(250, H - 35, `${card.asking} WANT MORE TIME`, { color: 'mist' });\n    ui.prompt('confirm', 'READY', 14, H - 16);\n    ui.prompt('more', 'MORE TIME', 90, H - 16);\n    const m = this.game.input.menu;\n    if (m.ctxB) AIHub.answer('more');\n    // Pads: Cross answers Ready through the widget. A press with no focus still counts.\n    if (m.confirm && ui.focus !== 'card:ready' && ui.focus !== 'card:more') AIHub.answer('ready');\n  }\n}\nEOF\npython3 - <<'EOF'\np='src/input/router.js'; s=open(p).read()\ns=s.replace(\"\"\"  intentFor(seat, world) {\n    const s = this.seats[seat];\n    const it = emptyIntent();\n    if (!s) return it;\n    const h = world.heroes.find((o) => o.seat === seat);\n    if (!h) return it;\n    if (seat === 0) this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\"\"\",\"\"\"  intentFor(seat, world) {\n    const s = this.seats[seat];\n    const it = emptyIntent();\n    if (!s) return it;\n    const h = world.heroes.find((o) => o.seat === seat);\n    if (!h) return it;\n    if (seat === 0) this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\n\n  /** A session: this copy's one player, whatever seat the hub gave them. */\n  intentForHero(h, world) {\n    const it = emptyIntent();\n    const s = this.seats[0];\n    this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\"\"\")\nopen(p,'w').write(s)\np='src/modes/game.js'; s=open(p).read()\ns=s.replace(\"\"\"    this.seed = opts.seed ?? 1;\n    this.settings = defaultSettings();\"\"\",\"\"\"    this.seed = opts.seed ?? 1;\n    this.isSession = !!opts.hub;\n    this.settings = defaultSettings();\"\"\")\ns=s.replace(\"\"\"    for (const seat of seats) {\n      if (this.botSeats.has(seat) && seat !== 0) continue;\n      const acts = this.input.frameActions(seat);\n      for (const a of acts) this.seatAction(seat, a);\n      if (this.topScreen()) return;\n    }\"\"\",\"\"\"    for (const seat of seats) {\n      if (this.botSeats.has(seat) && seat !== 0) continue;\n      const me = w.heroes.find((h) => h.seat === seat);\n      if (me?.pick && this.handlePick(me)) continue;\n      const acts = this.input.frameActions(this.isSession ? 0 : seat);\n      for (const a of acts) this.seatAction(seat, a);\n      if (this.topScreen()) return;\n    }\"\"\")\ns=s.replace(\"\"\"  seatAction(seat, a) {\"\"\",\"\"\"  /** Level-ups in a session: pick 1 of 3, on d-pad left, up, right; Z, X, C; or a click. */\n  handlePick(h) {\n    const input = this.input.input;\n    const m = this.input.menu;\n    let i = -1;\n    if (input.wasPressed('KeyZ') || m.left) i = 0;\n    if (input.wasPressed('KeyX') || m.up) i = 1;\n    if (input.wasPressed('KeyC') || m.right) i = 2;\n    if (m.click) {\n      const x0 = Math.floor(this.ctx.hud.width / 2 - 150);\n      for (let k = 0; k < 3; k++) if (m.clickX >= x0 + k * 102 && m.clickX < x0 + k * 102 + 96 && m.clickY >= 54 && m.clickY < 94) i = k;\n    }\n    if (i >= 0) { this.cmd({ c: 'pick3', i }, h.seat); h.pick = this.isClient ? null : h.pick; this.audioSys.sfx('ui_confirm'); return true; }\n    return true;\n  }\n\n  seatAction(seat, a) {\"\"\")\ns=s.replace(\"\"\"  update(ctx, dt) {\n    const real = this.realDt(ctx, dt);\"\"\",\"\"\"  update(ctx, dt) {\n    if (this.opts.server) { return; }\n    const real = this.realDt(ctx, dt);\"\"\")\ns=s.replace(\"\"\"  localSeats() {\n    if (this.net?.seat !== undefined) return this.net.seat === null ? [] : [this.net.seat];\"\"\",\"\"\"  localSeats() {\n    if (this.net) return this.net.seat === null ? [] : [this.net.seat];\"\"\")\ns=s.replace(\"\"\"  seatLabel\"\"\",\"\"\"  seatLabel\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"seatLabel\\|isLocalLoot\" src/ui/hud.js src/view/view.js | head; cat >> src/modes/game.js <<'EOF'\nEOF\npython3 - <<'EOF'\np='src/modes/game.js'; s=open(p).read()\ns=s.replace(\"\"\"  humanCount() {\"\"\",\"\"\"  seatLabel(h) { return this.isSession ? String(h.name).slice(0, 10) : `P${h.seat + 1}`; }\n  humanCount() {\"\"\")\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs --quiet 2>&1 | tail -n 8 | cut -c1-300; cat > tools/hubcheck.mjs <<'EOF'\n#!/usr/bin/env node\n// Serves the harness beside a copy of the deliverable on 127.0.0.1, port 0, and reports its checks.\nimport { createServer } from 'node:http';\nimport { copyFileSync, mkdirSync, readFileSync, existsSync } from 'node:fs';\nimport { extname, join, normalize } from 'node:path';\nimport { DEV, HTML, launch } from './browser.mjs';\n\nconst site = join(DEV, '.build/hubsite');\nmkdirSync(site, { recursive: true });\nfor (const f of ['harness.html', 'bridge.js', 'round.js']) copyFileSync(join(DEV, 'tools/hub', f), join(site, f));\ncopyFileSync(HTML, join(site, 'game.html'));\nconst types = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.json': 'application/json' };\nexport function serve() {\n  return new Promise((res) => {\n    const srv = createServer((req, r) => {\n      const p = normalize(decodeURIComponent(req.url.split('?')[0])).replace(/^\\/+/, '');\n      const file = join(site, p);\n      if (!file.startsWith(site) || !existsSync(file)) { r.writeHead(404); r.end(); return; }\n      r.writeHead(200, { 'content-type': types[extname(file)] ?? 'application/octet-stream' });\n      r.end(readFileSync(file));\n    });\n    srv.listen(0, '127.0.0.1', () => res({ srv, port: srv.address().port }));\n  });\n}\n\nexport async function runVariant(browser, port, query, limitMs = 280000) {\n  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n  const page = await ctx.newPage();\n  await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${query}`);\n  const title = await page.title();\n  try {\n    await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: limitMs });\n  } catch { /* report below */ }\n  const rep = await page.evaluate(() => window.__hubCheck ? { pass: window.__hubCheck.pass, done: window.__hubCheck.done, checks: window.__hubCheck.checks, log: window.__hubCheck.log?.slice?.(-12) } : null);\n  await ctx.close();\n  return { title, rep };\n}\n\nif (process.argv[1]?.endsWith('hubcheck.mjs')) {\n  const variants = process.argv[2] ? [process.argv[2]] : ['players=2&auto=1'];\n  const { srv, port } = await serve();\n  const browser = await launch();\n  for (const v of variants) {\n    const { rep } = await runVariant(browser, port, v);\n    console.log(v, rep?.pass ? 'PASS' : 'FAIL');\n    for (const c of rep?.checks ?? []) if (!c.pass) console.log('  x', c.name, String(c.detail).slice(0, 300));\n    if (!rep?.pass) console.log((rep?.log ?? []).join('\\n').slice(0, 1500));\n  }\n  await browser.close();\n  srv.close();\n}\nEOF\ntimeout 290 node tools/hubcheck.mjs \"players=2&auto=1\" 2>&1 | tail -n 25 | cut -c1-500","description":"Write netcode, hub flow and card, run first harness variant","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4358,"cache_read_input_tokens":747147,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4358},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"b9c9b08c-6029-4154-af94-2370839a4d82","timestamp":"2026-11-06T00:38:36.300Z","request_id":"req_011CgkjhsRdjrftdor4NGiGT","wire_tool_inputs":{"toolu_01BzzYPQFe8R42d6J2ZjzWPN":{"command":"cat > src/net/codec.js <<'EOF'\n// The wire: flat integer arrays for the moving things. Positions are times ten.\nexport const STATE_CODE = { idle: 0, run: 1, cast: 2, dodge: 3, dead: 4, channel: 5, stunned: 6, dash: 7, leap: 8 };\nexport const CODE_STATE = Object.fromEntries(Object.entries(STATE_CODE).map(([k, v]) => [v, k]));\nconst r10 = (v) => Math.round(v * 10);\n\nconst nearestFirst = (w, list) => {\n  const heroes = w.heroes.filter((h) => !h.gone);\n  const score = (m) => { let best = Infinity; for (const h of heroes) { const d = (m.x - h.x) ** 2 + (m.z - h.z) ** 2; if (d < best) best = d; } return best; };\n  return list.map((m) => [score(m), m]).sort((a, b) => a[0] - b[0]).map((p) => p[1]);\n};\n\n/** A snapshot under 1,100 bytes: the 24 nearest every time, a rotating slice of the rest. */\nexport function encodeSnapshot(w, cursor) {\n  const h = [];\n  for (const o of w.heroes) {\n    if (o.gone) continue;\n    h.push(o.id, r10(o.x), r10(o.z), r10(o.facing), STATE_CODE[o.state] ?? 0, Math.round(o.hp), Math.round(o.res), (o.dead ? 1 : 0) | (o.moving ? 2 : 0) | (o.channel > 0 ? 4 : 0));\n  }\n  const live = w.monsters.filter((m) => !m.dead && !m.hidden);\n  const ordered = nearestFirst(w, live);\n  const near = ordered.slice(0, 24);\n  const rest = ordered.slice(24).filter((m) => (m.x - w.heroes[0]?.x) ** 2 + (m.z - w.heroes[0]?.z) ** 2 < 1600);\n  const slice = [];\n  for (let i = 0; i < Math.min(8, rest.length); i++) slice.push(rest[(cursor.i + i) % rest.length]);\n  cursor.i = rest.length ? (cursor.i + 8) % rest.length : 0;\n  const m = [];\n  for (const o of [...near, ...slice]) m.push(o.id, r10(o.x), r10(o.z), r10(o.facing), Math.round(o.hp));\n  const a = [];\n  for (const o of w.allies) { if (o.def.static) continue; a.push(o.id, r10(o.x), r10(o.z), r10(o.facing), o.moving ? 1 : 0); }\n  const msg = { k: 's', n: w.t, h, m, a };\n  // Trim from the far end until it fits one packet.\n  let json = JSON.stringify(msg);\n  while (json.length > 1090 && msg.m.length) { msg.m.length -= 5; json = JSON.stringify(msg); }\n  while (json.length > 1090 && msg.a.length) { msg.a.length -= 5; json = JSON.stringify(msg); }\n  return msg;\n}\n\n/** Events that are not plain data, or that nobody across the wire needs, stay home. */\nconst LOCAL_ONLY = new Set(['autosave', 'bestiary', 'hero', 'talk', 'open', 'lore', 'cut', 'zone']);\nexport function wireEvents(list, maxBytes = 12000) {\n  const out = [];\n  let size = 12;\n  while (list.length) {\n    const e = list[0];\n    if (LOCAL_ONLY.has(e.t)) { list.shift(); continue; }\n    const j = JSON.stringify(e).length + 1;\n    if (size + j > maxBytes) break;\n    size += j;\n    out.push(e);\n    list.shift();\n  }\n  return out;\n}\nEOF\ncat > src/net/host.js <<'EOF'\n// The host's copy runs the only true sim. It takes intent from seats, sends the world back.\nimport { applyCommand } from '../sim/commands.js';\nimport { heroToData } from '../sim/hero.js';\nimport { emptyIntent } from '../sim/intents.js';\nimport { encodeSnapshot, wireEvents } from './codec.js';\n\nconst SNAP_EVERY = 6;   // 10 Hz at 60 steps a second\nconst EVENT_EVERY = 12; // 5 Hz\n\nexport class NetHost {\n  constructor(transport, world, localSeat) {\n    this.t = transport;\n    this.w = world;\n    this.seat = localSeat;\n    this.remote = new Map();\n    this.press = new Map();\n    this.goals = new Map();\n    this.queue = [];\n    this.cursor = { i: 0 };\n    this.tick = 0;\n    this.sentHd = new Map();\n    this.hdTurn = 0;\n    this.stats = { maxS: 0, maxE: 0, sent: 0 };\n  }\n\n  onMessage(data, from) {\n    switch (data.k) {\n      case 'i': {\n        const cur = this.remote.get(from);\n        if (cur && data.q <= cur.q) return;\n        this.remote.set(from, data);\n        break;\n      }\n      case 'p': this.press.set(from, (this.press.get(from) ?? 0) | data.b); if (data.g) this.goals.set(from, data.g); break;\n      case 'c': applyCommand(this.w, from, data.c); this.markDirty(from); break;\n      default: break;\n    }\n  }\n\n  markDirty(seat) { this.sentHd.set(seat, ''); }\n\n  /** Intents for every seat, with the local player's merged in. */\n  intents(localIntent) {\n    const out = [];\n    for (const h of this.w.heroes) {\n      if (h.gone) continue;\n      if (h.seat === this.seat) { out[h.seat] = localIntent ?? emptyIntent(); continue; }\n      const it = emptyIntent();\n      const r = this.remote.get(h.seat);\n      if (r) { it.mx = r.x / 100; it.mz = r.z / 100; it.ax = r.a / 10; it.az = r.b / 10; it.aimed = r.m; it.tgt = r.t; it.held = r.h; }\n      it.pressed = this.press.get(h.seat) ?? 0;\n      this.press.set(h.seat, 0);\n      const g = this.goals.get(h.seat);\n      if (g) { it.goal = g; this.goals.delete(h.seat); }\n      out[h.seat] = it;\n    }\n    return out;\n  }\n\n  addEvents(list) { for (const e of list) this.queue.push(e); }\n\n  send(data, o) {\n    const ok = this.t.send(data, o);\n    if (ok) this.stats.sent++;\n    return ok;\n  }\n\n  /** Once per sim step, even while nothing happens. */\n  step() {\n    this.tick++;\n    if (this.tick % SNAP_EVERY === 0) {\n      const s = encodeSnapshot(this.w, this.cursor);\n      this.stats.maxS = Math.max(this.stats.maxS, JSON.stringify(s).length);\n      this.send(s, { reliable: false });\n    }\n    if (this.tick % EVENT_EVERY === 0 && this.queue.length) {\n      const keep = this.queue;\n      const list = wireEvents(keep);\n      if (list.length) {\n        const msg = { k: 'e', e: list };\n        this.stats.maxE = Math.max(this.stats.maxE, JSON.stringify(msg).length);\n        if (!this.send(msg, { reliable: true })) keep.unshift(...list);\n      }\n    }\n    if (this.tick % 60 === 0) this.sendHeroData();\n  }\n\n  /** Every hero's own pack, to that hero's copy, when it has changed. One a second. */\n  sendHeroData() {\n    const list = this.w.heroes.filter((h) => !h.gone && h.seat !== this.seat);\n    if (!list.length) return;\n    this.hdTurn = (this.hdTurn + 1) % list.length;\n    const h = list[this.hdTurn];\n    const d = heroToData(h);\n    for (const it of d.inv) if (it) { delete it.flavor; delete it.powerText; }\n    const json = JSON.stringify(d);\n    if (this.sentHd.get(h.seat) === json) return;\n    if (json.length > 15000) return;\n    if (this.send({ k: 'd', d }, { reliable: true, to: h.seat })) this.sentHd.set(h.seat, json);\n  }\n}\nEOF\ncat > src/net/client.js <<'EOF'\n// A client's copy: the same map from the same seed, a mirror of the world, intent going up.\nimport { MONSTERS } from '../data/monsters.js';\nimport { LEGENDARIES } from '../data/items.js';\nimport { slide } from '../sim/core.js';\nimport { recalcHero } from '../sim/hero.js';\nimport { CODE_STATE } from './codec.js';\n\nexport class NetClient {\n  constructor(transport, world, seat) {\n    this.t = transport;\n    this.w = world;\n    this.seat = seat;\n    this.q = 0;\n    this.targets = new Map();\n    this.pending = [];\n    this.pressQueue = 0;\n    this.goal = null;\n    this.reliableQueue = [];\n    this.lastN = -1;\n    this.acc = 0;\n    this.stats = { s: 0, e: 0 };\n    this.mono = new Map();\n  }\n\n  get me() { return this.w.heroes.find((h) => h.seat === this.seat); }\n\n  onMessage(data) {\n    switch (data.k) {\n      case 's': this.applySnapshot(data); break;\n      case 'e':\n        this.stats.e++;\n        for (const ev of data.e) { this.applyEvent(ev); this.pending.push(ev); }\n        break;\n      case 'd': this.applyHeroData(data.d); break;\n      default: break;\n    }\n  }\n\n  applySnapshot(s) {\n    if (s.n <= this.lastN) return;\n    this.lastN = s.n;\n    this.stats.s++;\n    this.w.t = s.n;\n    this.w.time = s.n / 60;\n    const w = this.w;\n    for (let i = 0; i < s.h.length; i += 8) {\n      const h = w.heroes.find((o) => o.id === s.h[i]);\n      if (!h) continue;\n      const isMe = h.seat === this.seat;\n      const tx = s.h[i + 1] / 10, tz = s.h[i + 2] / 10;\n      this.targets.set(h.id, { x: tx, z: tz, f: s.h[i + 3] / 10, e: h });\n      if (!isMe) { h.facing = s.h[i + 3] / 10; h.moving = !!(s.h[i + 7] & 2); h.state = CODE_STATE[s.h[i + 4]] ?? 'idle'; }\n      h.hp = s.h[i + 5];\n      h.res = s.h[i + 6];\n      h.dead = !!(s.h[i + 7] & 1);\n      if (h.dead) h.state = 'dead';\n      h.channel = s.h[i + 7] & 4 ? h.channel + 0.1 : 0;\n      h.deadT = h.dead ? (h.deadT ?? 0) + 0.1 : 0;\n    }\n    for (let i = 0; i < s.m.length; i += 5) {\n      const m = w.monsters.find((o) => o.id === s.m[i]);\n      if (!m) continue;\n      const tx = s.m[i + 1] / 10, tz = s.m[i + 2] / 10;\n      this.targets.set(m.id, { x: tx, z: tz, f: s.m[i + 3] / 10, e: m });\n      m.hp = s.m[i + 4];\n    }\n    for (let i = 0; i < s.a.length; i += 5) {\n      const a = w.allies.find((o) => o.id === s.a[i]);\n      if (!a) continue;\n      this.targets.set(a.id, { x: s.a[i + 1] / 10, z: s.a[i + 2] / 10, f: s.a[i + 3] / 10, e: a });\n      a.moving = !!s.a[i + 4];\n    }\n  }\n\n  /** Keep the mirror's lists true. The view reads them; effects come from the same events. */\n  applyEvent(e) {\n    const w = this.w;\n    switch (e.t) {\n      case 'spawn': {\n        const def = MONSTERS[e.k];\n        const base = { id: e.id, type: e.k, def, x: e.x, z: e.z, r: (def?.r ?? 0.4) * (e.s ?? 1), facing: e.f, hp: e.hp, maxHp: e.hp, status: {}, name: e.n, elite: e.e || null, aff: e.aff ?? [], scale: e.s ?? 1, level: 12, moving: false, state: 'chase', knellPts: 0 };\n        if (e.ally) w.allies.push({ ...base, ally: true, owner: e.owner, def });\n        else w.monsters.push(base);\n        break;\n      }\n      case 'death': case 'remove':\n        for (const list of [w.monsters, w.allies]) {\n          const i = list.findIndex((m) => m.id === e.id);\n          if (i >= 0) { list[i].dead = true; list.splice(i, 1); }\n        }\n        this.targets.delete(e.id);\n        if (w.boss?.id === e.id) w.boss = null;\n        break;\n      case 'hit': { const m = w.monsters.find((o) => o.id === e.id); if (m && e.a) m.hp -= e.a; break; }\n      case 'hide': { const m = w.monsters.find((o) => o.id === e.id); if (m) m.hidden = true; break; }\n      case 'unhide': { const m = w.monsters.find((o) => o.id === e.id); if (m) { m.hidden = false; m.x = e.x; m.z = e.z; } break; }\n      case 'boss': { const m = w.monsters.find((o) => o.id === e.id); if (m) { w.boss = m; m.bossState = { round: 1, phase: 1 }; m.def = MONSTERS[e.k]; } break; }\n      case 'boss_round': { const m = w.monsters.find((o) => o.id === e.id); if (m?.bossState) m.bossState.round = e.round; break; }\n      case 'boss_dead': w.boss = null; break;\n      case 'knell': if (w.run) { w.run.meter = e.v; w.run.total = e.of; } break;\n      case 'knell_tolls': if (w.run) w.run.state = 'warden'; break;\n      case 'run_done': if (w.run) w.run.state = 'done'; break;\n      case 'level': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.level = e.level; recalcHero(w, h); } break; }\n      case 'gear': { const h = w.heroes.find((o) => o.id === e.id); if (h) h.gearLook = e.g; break; }\n      case 'hero_class': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.cls = e.cls; recalcHero(w, h); } break; }\n      case 'down': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.dead = true; h.state = 'dead'; h.deadT = 0; h.deathWait = 8; } break; }\n      case 'up': { const h = w.heroes.find((o) => o.id === e.id); if (h) { h.dead = false; h.state = 'idle'; h.x = e.x; h.z = e.z; this.targets.delete(h.id); } break; }\n      case 'pick3': { const h = w.heroes.find((o) => o.seat === e.seat); if (h) h.pick = { t: 10, opts: e.opts }; break; }\n      case 'pick3x': { const h = w.heroes.find((o) => o.seat === e.seat); if (h) h.pick = null; break; }\n      case 'obj': {\n        const o = w.objects.find((q) => q.id === e.id);\n        if (o) { o.state = e.state; if (e.hidden !== undefined) o.hidden = e.hidden; if (e.locked !== undefined) o.locked = e.locked; }\n        break;\n      }\n      case 'objadd': if (!w.objects.some((q) => q.id === e.o.id)) w.objects.push({ ...e.o, r: 1 }); break;\n      case 'objmove': { const o = w.objects.find((q) => q.id === e.id); if (o) { o.x = e.x; o.z = e.z; } break; }\n      case 'prop': { const p = w.props.find((q) => q.id === e.id); if (p) p.broken = true; break; }\n      case 'drop': w.drops.push({ id: e.id, kind: e.kind, x: e.x, z: e.z, owner: e.owner, t: 1 }); break;\n      case 'dropx': { const i = w.drops.findIndex((d) => d.id === e.id); if (i >= 0) w.drops.splice(i, 1); break; }\n      default: break;\n    }\n  }\n\n  applyHeroData(d) {\n    const h = this.me;\n    if (!h) return;\n    Object.assign(h, d);\n    for (const it of h.inv) if (it?.power && !it.powerText) it.powerText = LEGENDARIES[it.power].power;\n    recalcHero(this.w, h);\n  }\n\n  /** Per sim step: predict our own hero, smooth everyone else, send intent. */\n  step(intent, dt) {\n    const me = this.me;\n    if (me && !me.dead) this.predict(me, intent, dt);\n    const lerp = Math.min(1, dt * 9);\n    for (const [id, t] of this.targets) {\n      const e = t.e;\n      if (e.dead && e !== me) { this.targets.delete(id); continue; }\n      if (e === me) {\n        const err = Math.hypot(t.x - e.x, t.z - e.z);\n        if (err > 3) { e.x = t.x; e.z = t.z; }\n        else if (err > 1) { e.x += (t.x - e.x) * 0.2; e.z += (t.z - e.z) * 0.2; }\n        else if (err > 0.2 && !intent?.mx && !intent?.mz) { e.x += (t.x - e.x) * 0.1; e.z += (t.z - e.z) * 0.1; }\n        continue;\n      }\n      const dx = t.x - e.x, dz = t.z - e.z;\n      e.x += dx * lerp; e.z += dz * lerp;\n      if (e.seat === undefined) { e.moving = Math.hypot(dx, dz) > 0.08; e.facing = t.f; }\n    }\n    this.acc += dt;\n    if (this.acc >= 0.1) {\n      this.acc -= 0.1;\n      this.q++;\n      const it = intent ?? {};\n      this.t.send({ k: 'i', q: this.q, x: Math.round((it.mx ?? 0) * 100), z: Math.round((it.mz ?? 0) * 100), a: Math.round((it.ax ?? 0) * 10), b: Math.round((it.az ?? 0) * 10), m: it.aimed ?? 0, t: it.tgt ?? 0, h: it.held ?? 0 }, { reliable: false });\n    }\n    if (intent?.pressed || intent?.goal) { this.pressQueue |= intent.pressed ?? 0; if (intent.goal) this.goal = intent.goal; }\n    if ((this.pressQueue || this.goal) && this.t.send({ k: 'p', b: this.pressQueue, g: this.goal ?? undefined }, { reliable: true })) { this.pressQueue = 0; this.goal = null; }\n    while (this.reliableQueue.length) {\n      if (!this.t.send(this.reliableQueue[0], { reliable: true })) break;\n      this.reliableQueue.shift();\n    }\n  }\n\n  predict(h, it, dt) {\n    if (!it) { h.moving = false; return; }\n    const mag = Math.hypot(it.mx, it.mz);\n    h.moving = mag > 0.02 && !h.dead;\n    if (!h.moving) { h.state = 'idle'; return; }\n    const speed = (h.stats?.moveSpeed ?? 5) * Math.min(1, mag) * dt;\n    slide(this.w, h, (it.mx / mag) * speed, (it.mz / mag) * speed);\n    h.dirX = it.mx / mag; h.dirZ = it.mz / mag;\n    h.facing = Math.atan2(h.dirX, h.dirZ);\n    h.state = 'run';\n  }\n\n  sendCommand(c) { this.reliableQueue.push({ k: 'c', c }); }\n\n  drain() {\n    const p = this.pending;\n    this.pending = [];\n    return p;\n  }\n}\nEOF\ncat > src/net/hubflow.js <<'EOF'\n// A session of AI Hub: straight into the round, no title or menus. The host's sim is the only truth.\nimport { Engine } from '../../pixel-engine.js';\nimport { TITLE } from '../data/meta.js';\nimport { GOAL_TEXT } from './card.js';\nimport { DiabellicalGame, VIGNETTE_LOOK } from '../modes/game.js';\nimport { botAfter } from '../sim/bot.js';\nimport { emptyIntent } from '../sim/intents.js';\nimport { roundResults, setupRound } from '../sim/round.js';\nimport { createWorld, stepWorld } from '../sim/world.js';\nimport { CardScreen } from './card.js';\nimport { NetClient } from './client.js';\nimport { NetHost } from './host.js';\n\nconst hubTransport = {\n  send(data, o) {\n    try { return AIHub.send(data, o) !== false; } catch { return false; }\n  },\n};\n\n/** Everything hub-side for one copy: what game.net points at. */\nexport class HubNet {\n  constructor(game, info) {\n    this.game = game;\n    this.info = info;\n    this.seat = info.server ? null : info.me;\n    this.isHost = !!info.isHost;\n    this.started = false;\n    this.ended = false;\n    this.finished = false;\n    this.card = { left: null, paused: false, starting: false, ready: [], asking: 0, asked: false };\n    this.unsub = [];\n  }\n\n  setup(ctx) {\n    const g = this.game;\n    const info = this.info;\n    const w = createWorld({ seed: info.seed >>> 0, camp: null, mode: 'session' });\n    this.world = w;\n    g.world = w;\n    setupRound(w, info.players);\n    w.events.length = 0;\n    if (this.isHost) this.host = new NetHost(hubTransport, w, this.seat);\n    else this.client = new NetClient(hubTransport, w, this.seat);\n    g.isSession = true;\n    g.isClient = !this.isHost;\n    g.mode = 'play';\n    g.net = this;\n    if (!info.server) {\n      g.view.setWorld(w);\n      g.audioSys.music('vespers');\n      g.openScreen(new CardScreen(g, this));\n      ctx.engine.setLook(VIGNETTE_LOOK(0.3));\n      // Enter must answer the card even if frames are slow: a plain listener, not the frame loop.\n      this.onKey = (e) => {\n        if (this.started) return;\n        if (e.code === 'Enter') AIHub.answer('ready');\n        else if (e.code === 'KeyM') AIHub.answer('more');\n      };\n      window.addEventListener('keydown', this.onKey);\n    }\n    this.unsub.push(AIHub.on('card', (c) => { this.card = c; }));\n    this.unsub.push(AIHub.on('start', () => { this.started = true; }));\n    this.unsub.push(AIHub.on('message', (data, from) => {\n      if (this.ended) return;\n      if (this.host) this.host.onMessage(data, from);\n      else this.client?.onMessage(data, from);\n    }));\n    this.unsub.push(AIHub.on('leave', (e) => this.onLeave(e)));\n    this.unsub.push(AIHub.on('time-up', () => this.onTimeUp()));\n    this.unsub.push(AIHub.on('end', () => this.onEnd()));\n  }\n\n  onLeave({ id }) {\n    const w = this.world;\n    const h = w.heroes.find((o) => o.seat === id);\n    if (!h) return;\n    h.gone = true;\n    w.heroes.splice(w.heroes.indexOf(h), 1);\n    this.game.view?.ev_hero_gone?.({ id: h.id });\n    for (const a of w.allies) if (a.owner === h.id) a.life = 0.01;\n    if (!this.info.server) this.game.hudSys?.toast(`${h.name} LEFT`, 'mist');\n  }\n\n  onTimeUp() { if (this.isHost) this.finish(false); }\n\n  finish(won) {\n    if (this.finished) return;\n    this.finished = true;\n    const r = roundResults(this.world, won);\n    try { AIHub.finish(r); } catch { /* the hub may already be gone */ }\n  }\n\n  onEnd() {\n    this.ended = true;\n    const g = this.game;\n    g.audioSys?.stopAll();\n    g.closeAll?.();\n    if (this.onKey) window.removeEventListener('keydown', this.onKey);\n    if (this.timer) clearInterval(this.timer);\n    g.ctx?.input?.release?.();\n  }\n\n  /** Play has begun when the hub's clock passes zero. */\n  get playing() { return !this.ended && this.started && AIHub.time() >= 0; }\n  timeLeft() {\n    if (!this.started) return null;\n    return Math.max(0, (this.info.limitMs - AIHub.time()) / 1000);\n  }\n\n  localIntent() {\n    const g = this.game;\n    const h = g.localHero();\n    if (!h || this.ended) return emptyIntent();\n    if (g.menuBlocks()) return emptyIntent();\n    return g.input.intentForHero(h, this.world);\n  }\n\n  fixedUpdate(dt) {\n    if (!this.playing) return;\n    const g = this.game;\n    const w = this.world;\n    if (this.host) {\n      const intents = this.host.intents(this.seat === null ? null : this.localIntent());\n      stepWorld(w, intents);\n      if (w.events.length) {\n        this.host.addEvents(w.events);\n        if (!this.info.server) for (const e of w.events) g.pendingEvents.push(e);\n        w.events.length = 0;\n      }\n      this.host.step();\n      if (w.round.finished) this.finish(true);\n    } else if (this.client) {\n      this.client.step(this.localIntent(), dt);\n      for (const e of this.client.drain()) g.pendingEvents.push(e);\n    }\n  }\n\n  update() {\n    // Traffic flows even before play begins, so a slow copy still says something.\n    if (!this.started && !this.ended) {\n      this.idleT = (this.idleT ?? 0) + 1;\n    }\n  }\n\n  drawOverlay(ui) {\n    if (this.ended) return;\n    if (this.started && AIHub.time() < 0) {\n      const n = Math.ceil(-AIHub.time() / 1000);\n      ui.text(ui.w / 2, ui.h / 2 - 30, n, { color: 'white', scale: 4, align: 'center' });\n    }\n    if (this.game.frame % 1 === 0 && this.started && AIHub.time() >= 0 && AIHub.time() < 2500) ui.text(ui.w / 2, ui.h / 2 - 30, 'FILL THE KNELL', { color: 'sand', scale: 2, align: 'center' });\n  }\n\n  sendCommand(c) { this.client?.sendCommand(c); }\n}\n\nexport async function runHubSession(engineOptions) {\n  let info = null;\n  try {\n    info = await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true });\n  } catch { info = null; }\n  if (!info) {\n    await Engine.start(new DiabellicalGame({}), engineOptions(false));\n    return;\n  }\n  const game = new DiabellicalGame({\n    hub: info,\n    server: !!info.server,\n    noAttract: true,\n    onSetup: (g, ctx) => {\n      const net = new HubNet(g, info);\n      net.setup(ctx);\n    },\n  });\n  try {\n    if (info.server) {\n      const engine = await Engine.headless(game, {});\n      if (typeof window !== 'undefined') window.__GAME__ = game;\n      let last = performance.now();\n      game.net.timer = setInterval(() => {\n        const now = performance.now();\n        const n = Math.min(30, Math.round((now - last) * 0.06));\n        if (n > 0) { last = now; engine.step(n); }\n      }, 33);\n    } else {\n      await Engine.start(game, engineOptions(false));\n    }\n  } catch (e) {\n    AIHub.fail(`${TITLE} needs WebGPU: ${String(e?.message ?? e)}`);\n    return;\n  }\n  AIHub.ready();\n}\n\nexport { botAfter, GOAL_TEXT };\nEOF\ncat > src/net/card.js <<'EOF'\n// The game's own card: heroes in a torchlit room, who is here, how to win, how to play, the time left.\nimport { CLASSES } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { SEAT_CLASSES } from '../sim/round.js';\nimport { Screen } from '../ui/menus/base.js';\n\nexport const GOAL_TEXT = 'FILL THE KNELL, THEN SLAY ITS WARDEN TOGETHER';\nconst HEX = (h) => parseInt(String(h).replace('#', ''), 16);\n\nexport class CardScreen extends Screen {\n  constructor(game, net) {\n    super(game, { tag: 'card', freeze: false, holdSim: false });\n    this.net = net;\n  }\n  back() {}\n  draw(ui) {\n    const net = this.net;\n    if (net.started) { this.game.closeScreen(); return; }\n    const W = ui.w, H = ui.h;\n    const info = net.info;\n    const card = net.card;\n    ui.rect(0, 0, W, 34, 'ink');\n    ui.text(W / 2, 6, TITLE, { color: 'sand', scale: 3, align: 'center' });\n    ui.rect(0, H - 100, W, 100, 'ink');\n    ui.rect(0, H - 101, W, 1, 'slate');\n    // Who is here.\n    let x = 14;\n    info.players.forEach((p) => {\n      const ready = card.ready?.includes(p.id);\n      const cls = CLASSES[SEAT_CLASSES[p.id % 4]].name;\n      ui.rect(x, H - 96, 96, 22, HEX(p.color));\n      ui.rect(x + 1, H - 95, 94, 20, 'ink');\n      ui.text(x + 4, H - 93, String(p.name).slice(0, 12), { color: HEX(p.color) });\n      ui.text(x + 4, H - 84, cls.slice(0, 11), { color: 'mist' });\n      if (ready) ui.text(x + 90, H - 84, 'OK', { color: 'lime', align: 'right' });\n      x += 100;\n    });\n    ui.text(14, H - 70, GOAL_TEXT, { color: 'white' });\n    // This player's controls, in the current glyphs.\n    let cx = 14;\n    const cy = H - 58;\n    for (const [a, label] of [['move', 'MOVE'], ['s0', 'ATTACK'], ['s1', 'SKILLS'], ['dodge', 'ROLL'], ['potion', 'DRINK']]) cx += ui.prompt(a, label, cx, cy);\n    const left = card.left === null || card.left === undefined ? (card.paused ? 'THE COUNTDOWN WAITS' : 'STARTING') : `${Math.ceil(card.left / 1000)} SECONDS`;\n    ui.text(W - 14, H - 70, left, { color: 'sand', align: 'right' });\n    const iReady = card.ready?.includes(info.me);\n    if (ui.button('card:ready', 14, H - 42, 110, 20, iReady ? 'READY' : 'READY?', { color: iReady ? 'lime' : 'white' })) AIHub.answer('ready');\n    if (ui.button('card:more', 130, H - 42, 110, 20, card.asked ? 'ASKED' : 'MORE TIME', { color: card.asked ? 'sand' : 'mist' })) AIHub.answer('more');\n    if (card.asking > 0) ui.text(250, H - 35, `${card.asking} WANT MORE TIME`, { color: 'mist' });\n    ui.prompt('confirm', 'READY', 14, H - 16);\n    ui.prompt('more', 'MORE TIME', 90, H - 16);\n    const m = this.game.input.menu;\n    if (m.ctxB) AIHub.answer('more');\n    // Pads: Cross answers Ready through the widget. A press with no focus still counts.\n    if (m.confirm && ui.focus !== 'card:ready' && ui.focus !== 'card:more') AIHub.answer('ready');\n  }\n}\nEOF\npython3 - <<'EOF'\np='src/input/router.js'; s=open(p).read()\ns=s.replace(\"\"\"  intentFor(seat, world) {\n    const s = this.seats[seat];\n    const it = emptyIntent();\n    if (!s) return it;\n    const h = world.heroes.find((o) => o.seat === seat);\n    if (!h) return it;\n    if (seat === 0) this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\"\"\",\"\"\"  intentFor(seat, world) {\n    const s = this.seats[seat];\n    const it = emptyIntent();\n    if (!s) return it;\n    const h = world.heroes.find((o) => o.seat === seat);\n    if (!h) return it;\n    if (seat === 0) this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\n\n  /** A session: this copy's one player, whatever seat the hub gave them. */\n  intentForHero(h, world) {\n    const it = emptyIntent();\n    const s = this.seats[0];\n    this.kbmIntent(it, h, world);\n    if (s.pad !== null && this.pads[s.pad]) this.padIntent(it, h, world, s.pad);\n    return it;\n  }\"\"\")\nopen(p,'w').write(s)\np='src/modes/game.js'; s=open(p).read()\ns=s.replace(\"\"\"    this.seed = opts.seed ?? 1;\n    this.settings = defaultSettings();\"\"\",\"\"\"    this.seed = opts.seed ?? 1;\n    this.isSession = !!opts.hub;\n    this.settings = defaultSettings();\"\"\")\ns=s.replace(\"\"\"    for (const seat of seats) {\n      if (this.botSeats.has(seat) && seat !== 0) continue;\n      const acts = this.input.frameActions(seat);\n      for (const a of acts) this.seatAction(seat, a);\n      if (this.topScreen()) return;\n    }\"\"\",\"\"\"    for (const seat of seats) {\n      if (this.botSeats.has(seat) && seat !== 0) continue;\n      const me = w.heroes.find((h) => h.seat === seat);\n      if (me?.pick && this.handlePick(me)) continue;\n      const acts = this.input.frameActions(this.isSession ? 0 : seat);\n      for (const a of acts) this.seatAction(seat, a);\n      if (this.topScreen()) return;\n    }\"\"\")\ns=s.replace(\"\"\"  seatAction(seat, a) {\"\"\",\"\"\"  /** Level-ups in a session: pick 1 of 3, on d-pad left, up, right; Z, X, C; or a click. */\n  handlePick(h) {\n    const input = this.input.input;\n    const m = this.input.menu;\n    let i = -1;\n    if (input.wasPressed('KeyZ') || m.left) i = 0;\n    if (input.wasPressed('KeyX') || m.up) i = 1;\n    if (input.wasPressed('KeyC') || m.right) i = 2;\n    if (m.click) {\n      const x0 = Math.floor(this.ctx.hud.width / 2 - 150);\n      for (let k = 0; k < 3; k++) if (m.clickX >= x0 + k * 102 && m.clickX < x0 + k * 102 + 96 && m.clickY >= 54 && m.clickY < 94) i = k;\n    }\n    if (i >= 0) { this.cmd({ c: 'pick3', i }, h.seat); h.pick = this.isClient ? null : h.pick; this.audioSys.sfx('ui_confirm'); return true; }\n    return true;\n  }\n\n  seatAction(seat, a) {\"\"\")\ns=s.replace(\"\"\"  update(ctx, dt) {\n    const real = this.realDt(ctx, dt);\"\"\",\"\"\"  update(ctx, dt) {\n    if (this.opts.server) { return; }\n    const real = this.realDt(ctx, dt);\"\"\")\ns=s.replace(\"\"\"  localSeats() {\n    if (this.net?.seat !== undefined) return this.net.seat === null ? [] : [this.net.seat];\"\"\",\"\"\"  localSeats() {\n    if (this.net) return this.net.seat === null ? [] : [this.net.seat];\"\"\")\ns=s.replace(\"\"\"  seatLabel\"\"\",\"\"\"  seatLabel\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"seatLabel\\|isLocalLoot\" src/ui/hud.js src/view/view.js | head; cat >> src/modes/game.js <<'EOF'\nEOF\npython3 - <<'EOF'\np='src/modes/game.js'; s=open(p).read()\ns=s.replace(\"\"\"  humanCount() {\"\"\",\"\"\"  seatLabel(h) { return this.isSession ? String(h.name).slice(0, 10) : `P${h.seat + 1}`; }\n  humanCount() {\"\"\")\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs --quiet 2>&1 | tail -n 8 | cut -c1-300; cat > tools/hubcheck.mjs <<'EOF'\n#!/usr/bin/env node\n// Serves the harness beside a copy of the deliverable on 127.0.0.1, port 0, and reports its checks.\nimport { createServer } from 'node:http';\nimport { copyFileSync, mkdirSync, readFileSync, existsSync } from 'node:fs';\nimport { extname, join, normalize } from 'node:path';\nimport { DEV, HTML, launch } from './browser.mjs';\n\nconst site = join(DEV, '.build/hubsite');\nmkdirSync(site, { recursive: true });\nfor (const f of ['harness.html', 'bridge.js', 'round.js']) copyFileSync(join(DEV, 'tools/hub', f), join(site, f));\ncopyFileSync(HTML, join(site, 'game.html'));\nconst types = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.json': 'application/json' };\nexport function serve() {\n  return new Promise((res) => {\n    const srv = createServer((req, r) => {\n      const p = normalize(decodeURIComponent(req.url.split('?')[0])).replace(/^\\/+/, '');\n      const file = join(site, p);\n      if (!file.startsWith(site) || !existsSync(file)) { r.writeHead(404); r.end(); return; }\n      r.writeHead(200, { 'content-type': types[extname(file)] ?? 'application/octet-stream' });\n      r.end(readFileSync(file));\n    });\n    srv.listen(0, '127.0.0.1', () => res({ srv, port: srv.address().port }));\n  });\n}\n\nexport async function runVariant(browser, port, query, limitMs = 280000) {\n  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n  const page = await ctx.newPage();\n  await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${query}`);\n  const title = await page.title();\n  try {\n    await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: limitMs });\n  } catch { /* report below */ }\n  const rep = await page.evaluate(() => window.__hubCheck ? { pass: window.__hubCheck.pass, done: window.__hubCheck.done, checks: window.__hubCheck.checks, log: window.__hubCheck.log?.slice?.(-12) } : null);\n  await ctx.close();\n  return { title, rep };\n}\n\nif (process.argv[1]?.endsWith('hubcheck.mjs')) {\n  const variants = process.argv[2] ? [process.argv[2]] : ['players=2&auto=1'];\n  const { srv, port } = await serve();\n  const browser = await launch();\n  for (const v of variants) {\n    const { rep } = await runVariant(browser, port, v);\n    console.log(v, rep?.pass ? 'PASS' : 'FAIL');\n    for (const c of rep?.checks ?? []) if (!c.pass) console.log('  x', c.name, String(c.detail).slice(0, 300));\n    if (!rep?.pass) console.log((rep?.log ?? []).join('\\n').slice(0, 1500));\n  }\n  await browser.close();\n  srv.close();\n}\nEOF\ntimeout 290 node tools/hubcheck.mjs \"players=2&auto=1\" 2>&1 | tail -n 25 | cut -c1-500","description":"Write netcode, hub flow and card, run first harness variant","timeout":300000}}}
