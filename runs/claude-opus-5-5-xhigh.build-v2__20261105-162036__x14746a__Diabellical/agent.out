ort { MONSTER_MODELS } from './monsters.js';\nimport { CLEMENCY, NPC_MODELS } from './npcs.js';\nimport { PROP_MODELS } from './props.js';\n\nexport const OWN_MODELS = [bellwardenBody, lamplighterBody, sextonBody, pyxBody, handBell, handLantern, censer, ...GEAR_MODELS, ...MONSTER_MODELS, ...NPC_MODELS, CLEMENCY, ...PROP_MODELS];\nexport const MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), ...OWN_MODELS]);\nexport const OWN = OWN_MODELS;\nEOF\ncat > .scratch/modelcheck.mjs <<'EOF'\nimport { checkModel } from '../pixel-engine.js';\nimport { MODELS, OWN_MODELS } from '../src/view/models/index.js';\nlet bad=0, warn=0;\nfor (const d of OWN_MODELS) { const r=checkModel(d,{catalog:MODELS}); if(r.problems.length){bad++;console.log('PROBLEM',d.id,r.problems.slice(0,4).join(' | ').slice(0,400));} if(process.argv[2]&&r.warnings.length){warn++;console.log('warn',d.id,r.warnings.slice(0,3).join(' | ').slice(0,300));} }\nconsole.log('models',OWN_MODELS.length,'bad',bad);\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/modelcheck.mjs 2>&1 | tail -n 30 | cut -c1-500","description":"Write all model definitions and check them","timeout":120000}}}
