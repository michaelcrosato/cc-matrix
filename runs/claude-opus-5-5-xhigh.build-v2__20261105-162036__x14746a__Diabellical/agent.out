{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjEuinJaN4aucPv1WFj","type":"message","role":"assistant","content":[{"type":"text","text":"I've written the sim, art, audio and most screens. Next I'm connecting them: the title and menu shell, the main game object and attract mode, so I can finally see it run."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22191,"cache_read_input_tokens":673559,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22191},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"ece46f52-f98a-4c61-9b10-c8e506f814aa","timestamp":"2026-11-06T00:29:23.294Z","request_id":"req_011CgkjEuLU5fiR4KqHuxdb1"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjEuinJaN4aucPv1WFj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YRrsdj2j4HBm8kdFUy8MGA","name":"Bash","input":{"command":"cat > src/view/sets.js <<'EOF'\n// The shell's dioramas: the Belfry against a stormy sky, and three heroes on plinths.\nimport { buildModel, disposeObject, glowMaterial, groundFog, mergeStaticMeshes, PALETTE, Precipitation, Rng, setLookLayer, textureMap, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { PLAYABLE } from '../data/classes.js';\nimport { applyBiomeLight } from './zonebuild.js';\nimport { Actor, CLASS_BODY } from './actors.js';\nimport { MODELS } from './models/index.js';\n\nconst { BoxGeometry, Color, CylinderGeometry, Group, Mesh, PlaneGeometry, Vector3 } = THREE;\n\nexport class ShellSet {\n  constructor(view) {\n    this.view = view;\n    const ctx = view.ctx;\n    this.ctx = ctx;\n    this.root = new Group();\n    ctx.scene.add(this.root);\n    ctx.scene.background = new Color(PALETTE.ink);\n    applyBiomeLight(ctx.engine, ctx.scene, 'belfry');\n    ctx.engine.sun.intensity = 0.8;\n    ctx.engine.ambient.intensity = 1.1;\n    this.lights = [];\n    this.heroes = [];\n    this.t = 0;\n    this.rng = new Rng('shell');\n    this.buildMoor();\n    this.buildTower();\n    this.buildPlinths();\n    this.rain = new Precipitation({ kind: 'rain', count: 2000 });\n    this.rain.wind.set(2, -1);\n    this.root.add(this.rain);\n    this.mist = groundFog({ color: PALETTE.navy, top: 1.5, amount: 0.3 });\n    ctx.scene.fogNode = this.mist.node;\n    this.target = new Vector3(0, 6, 0);\n    this.mode = 'title';\n    this.selected = 0;\n    view.cam.set(0, 1, 0);\n    this.play('Idle');\n  }\n\n  buildMoor() {\n    const g = new PlaneGeometry(160, 160).rotateX(-Math.PI / 2);\n    const uv = g.attributes.uv;\n    for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) * 20, uv.getY(i) * 20);\n    const m = new Mesh(g, toonMaterial(PALETTE.slate, { map: textureMap('mud') }));\n    m.receiveShadow = true;\n    this.root.add(m);\n    const props = ['tombstone', 'dead-tree', 'tombstone', 'bones', 'rock', 'tombstone', 'stump'];\n    for (let i = 0; i < 46; i++) {\n      const id = this.rng.pick(props);\n      const a = this.rng.range(0, Math.PI * 2), r = this.rng.range(10, 34);\n      const o = buildModel(id, { catalog: MODELS, seed: i + 1 }).object;\n      o.position.set(Math.cos(a) * r, 0, Math.sin(a) * r);\n      o.rotation.y = this.rng.range(0, 6);\n      o.traverse((q) => { if (q.isMesh) { q.castShadow = true; q.receiveShadow = true; } });\n      this.root.add(o);\n    }\n  }\n\n  buildTower() {\n    const stone = toonMaterial(PALETTE.mist, { map: textureMap('ashlar') });\n    const dark = toonMaterial(PALETTE.ink);\n    const parts = [];\n    const block = (w, h, d, x, y, z, mat = stone) => {\n      const b = new BoxGeometry(w, h, d);\n      const uv = b.attributes.uv;\n      for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) * w * 0.5, uv.getY(i) * h * 0.5);\n      const m = new Mesh(b, mat);\n      m.position.set(x, y, z);\n      m.castShadow = true;\n      m.receiveShadow = true;\n      m.updateMatrixWorld();\n      parts.push(m);\n    };\n    block(14, 34, 14, 0, 17, 0);\n    block(16, 2, 16, 0, 2, 0);\n    block(15.5, 1, 15.5, 0, 14, 0);\n    block(15.5, 1, 15.5, 0, 26, 0);\n    block(10, 8, 10, 0, 38, 0);\n    block(5.5, 12, 0.6, 7.2, 22, 0, dark);\n    block(0.6, 12, 5.5, 0, 22, 7.2, dark);\n    block(4, 8, 0.6, 7.2, 8, 0, dark);\n    block(0.6, 8, 4, 0, 8, 7.2, dark);\n    for (const sx of [-1, 1]) for (const sz of [-1, 1]) block(1.6, 40, 1.6, sx * 6.8, 20, sz * 6.8);\n    const spire = new Mesh(new CylinderGeometry(0.2, 7.5, 16, 4), toonMaterial(PALETTE.night));\n    spire.position.set(0, 50, 0);\n    spire.rotation.y = Math.PI / 4;\n    spire.updateMatrixWorld();\n    parts.push(spire);\n    for (const m of mergeStaticMeshes(parts)) this.root.add(m);\n    const bell = buildModel('old_clemency', { catalog: MODELS }).object;\n    bell.position.set(7.4, 19, 7.4);\n    bell.scale.setScalar(0.85);\n    bell.traverse((q) => { if (q.isMesh) q.castShadow = true; });\n    this.root.add(bell);\n    this.bell = bell;\n    this.lights.push(this.ctx.lights.request({ position: [10, 24, 10], color: 0x60e0f0, intensity: 22, radius: 22, priority: 2 }));\n    this.lights.push(this.ctx.lights.request({ position: [10, 3, 10], color: 0xff9040, intensity: 18, radius: 18, flicker: 'torch', priority: 2 }));\n  }\n\n  buildPlinths() {\n    // Three heroes in a torchlit room, far enough from the tower to have the screen to themselves.\n    const base = new Vector3(40, 0, 40);\n    this.plinthBase = base;\n    const stone = toonMaterial(PALETTE.mist, { map: textureMap('flagstones') });\n    const floor = new Mesh(new BoxGeometry(18, 0.6, 12), stone);\n    floor.position.set(base.x, 0.02, base.z);\n    floor.receiveShadow = true;\n    this.root.add(floor);\n    const back = new Mesh(new BoxGeometry(18, 7, 0.8), toonMaterial(PALETTE.slate, { map: textureMap('ashlar') }));\n    back.position.set(base.x - 3, 3.5, base.z - 4.5);\n    back.rotation.y = -Math.PI / 4 * 0;\n    this.root.add(back);\n    const positions = [[-3.2, 0.6], [0, 0], [3.2, -0.6]];\n    PLAYABLE.forEach((cls, i) => {\n      const [dx, dz] = positions[i];\n      const x = base.x + dx, z = base.z + dz;\n      const pl = new Mesh(new CylinderGeometry(0.85, 1, 0.5, 8), toonMaterial(PALETTE.plum));\n      pl.position.set(x, 0.55, z);\n      pl.castShadow = true;\n      pl.receiveShadow = true;\n      this.root.add(pl);\n      const a = new Actor(this.view, { id: `hero${i}`, type: cls, body: CLASS_BODY[cls], def: { r: 0.45 }, x, z, isHero: true });\n      a.root.position.y = 0.8;\n      a.setGear({ main: { bellwarden: 'hand-bell-weapon', lamplighter: 'staff', sexton: 'shovel' }[cls], off: cls === 'lamplighter' ? 'hand-lantern' : '', head: 'blessed', shoulders: 'blessed' }, cls);\n      this.heroes.push({ a, cls, x, z });\n      this.lights.push(this.ctx.lights.request({ position: [x + 0.5, 2.8, z + 1.2], color: 0xffb060, intensity: 9, radius: 7, flicker: 'torch', priority: 2 }));\n      const t = buildModel('standing-torch', { catalog: MODELS }).object;\n      t.position.set(x + 1.6, 0.3, z - 1.2);\n      this.root.add(t);\n    });\n  }\n\n  setMode(mode, selected = 0) {\n    this.mode = mode;\n    if (this.selected !== selected || mode === 'select') {\n      this.selected = selected;\n      this.play('Triumph');\n    }\n  }\n\n  play() {\n    this.heroes.forEach((h, i) => { if (i === this.selected) h.a.play('Triumph', 1); });\n  }\n\n  update(dt, realDt) {\n    this.t += realDt;\n    const view = this.view;\n    if (this.mode === 'title') {\n      // A slow pan up the Belfry.\n      const a = this.t * 0.04;\n      view.cam.set(4 + Math.sin(a) * 3, 1, 4 + Math.cos(a) * 3);\n      this.camY = 12 + Math.sin(this.t * 0.05) * 4;\n      view.camOverride = { x: view.cam.x, z: view.cam.z, zoom: 0.62 };\n    } else {\n      const h = this.heroes[this.selected] ?? this.heroes[1];\n      view.camOverride = { x: h.x * 0.5 + this.plinthBase.x * 0.5, z: h.z * 0.5 + this.plinthBase.z * 0.5, zoom: 1.5 };\n    }\n    for (const h of this.heroes) { h.a.sync(h.x, h.z, Math.PI / 4, false, 0, dt); h.a.root.position.y = 0.8; h.a.shadow.visible = false; }\n    this.rain.update(dt, view.cam);\n    if (this.bell) this.bell.rotation.z = Math.sin(this.t * 0.6) * 0.05;\n    if (Math.floor(this.t * 8) % 3 === 0) view.ctx.particles.burst('ember_drift', [view.cam.x + this.rng.range(-12, 12), this.rng.range(0.5, 10), view.cam.z + this.rng.range(-12, 12)]);\n    view.updateCamera(realDt);\n  }\n\n  dispose() {\n    for (const l of this.lights) l.release();\n    for (const h of this.heroes) h.a.remove();\n    this.rain.dispose();\n    if (this.ctx.scene.fogNode === this.mist.node) this.ctx.scene.fogNode = null;\n    this.ctx.scene.remove(this.root);\n    disposeObject(this.root);\n    this.view.camOverride = null;\n  }\n}\n\nexport { glowMaterial, setLookLayer };\nEOF\ncat > src/ui/menus/shell.js <<'EOF'\n// Title, main menu, hero select, new hero, and the touch-only notice.\nimport { CLASSES, HERO_NAMES, PLAYABLE } from '../../data/classes.js';\nimport { TITLE } from '../../data/meta.js';\nimport { SKILLS } from '../../data/skills.js';\nimport { DIFFICULTIES } from '../../data/tuning.js';\nimport { icon } from '../icons.js';\nimport { Screen } from './base.js';\nimport { AboutScreen, SettingsScreen } from './pause.js';\n\nfunction bigTitle(ui, y = 30) {\n  const W = ui.w;\n  const scale = W < 300 ? 2 : W < 440 ? 4 : 5;\n  ui.text(W / 2 + 1, y + 1, TITLE, { color: 'plum', scale, align: 'center', shadow: false });\n  ui.text(W / 2, y, TITLE, { color: 'sand', scale, align: 'center', shadow: 'ink' });\n  return y + 7 * scale + 8;\n}\n\nexport class TitleScreen extends Screen {\n  constructor(game) { super(game, { tag: 'title', freeze: false }); }\n  draw(ui) {\n    const g = this.game;\n    const y = bigTitle(ui);\n    ui.text(ui.w / 2, y, 'THE BELL IS CRACKED. THE DEAD ARE UP. SO ARE YOU.', { color: 'mist', align: 'center' });\n    if (g.frame % 60 < 42) ui.text(ui.w / 2, ui.h - 40, 'PRESS ANY BUTTON', { color: 'white', align: 'center', scale: 1 });\n    if (g.ctx.audio.unlocked === false && g.input.lastDevice === 'pad') ui.text(ui.w / 2, ui.h - 26, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'slate', align: 'center' });\n    const m = g.input.menu;\n    if (m.anyPress || m.confirm || m.click) { g.audioSys?.sfx('bell_small'); g.openMainMenu(); }\n  }\n  back() {}\n}\n\nexport class MainMenu extends Screen {\n  constructor(game) { super(game, { tag: 'menu', freeze: false }); }\n  draw(ui) {\n    const g = this.game;\n    bigTitle(ui, 18);\n    const hasHero = g.save.heroes.some(Boolean);\n    const knell = g.save.account.unlocks.knell;\n    const items = [\n      ['CONTINUE', () => g.openScreen(new HeroSelect(g)), !hasHero],\n      ['NEW HERO', () => g.openScreen(new NewHero(g)), false],\n      ['KNELL RUNS', () => g.openScreen(new HeroSelect(g, { knell: true })), !knell || !hasHero],\n      ['SETTINGS', () => g.openScreen(new SettingsScreen(g)), false],\n      ['ABOUT', () => g.openScreen(new AboutScreen(g)), false],\n    ];\n    const bw = 140, bh = 18;\n    const x = Math.floor(ui.w / 2 - bw / 2);\n    const y0 = Math.floor(ui.h * 0.42);\n    items.forEach(([label, act, disabled], i) => {\n      if (ui.button(`menu:${label}`, x, y0 + i * (bh + 3), bw, bh, label, { disabled })) act();\n    });\n    if (!hasHero) ui.preferFocus = 'menu:NEW HERO';\n    if (!knell) ui.text(x + bw + 6, y0 + 2 * (bh + 3) + 5, 'AFTER THE CREDITS', { color: 'slate' });\n    ui.footer([['confirm', 'CHOOSE']]);\n  }\n  back() { this.game.closeScreen(); }\n}\n\nconst namePick = (g) => HERO_NAMES[Math.floor(g.uiRng.next() * HERO_NAMES.length)];\n\nexport class NewHero extends Screen {\n  constructor(game) {\n    super(game, { tag: 'newhero', freeze: false });\n    this.cls = 1;\n    this.name = namePick(game);\n    this.diff = 0;\n    this.step = 'class';\n  }\n  onOpen() { this.game.shellSet?.setMode('select', this.cls); }\n  onClose() { this.game.shellSet?.setMode('title', 0); }\n  back() {\n    if (this.step === 'start') { this.step = 'class'; return; }\n    this.game.closeScreen();\n  }\n  draw(ui) {\n    const g = this.game;\n    const W = ui.w, H = ui.h;\n    if (this.step === 'class') {\n      const cls = CLASSES[PLAYABLE[this.cls]];\n      ui.rect(0, H - 94, W, 94, 'ink');\n      ui.rect(0, H - 95, W, 1, 'slate');\n      ui.text(14, 12, 'A NEW HERO', { color: 'sand', scale: 2 });\n      // Class buttons.\n      PLAYABLE.forEach((id, i) => {\n        const bw = 100;\n        const r = ui.button(`class:${id}`, 14 + i * (bw + 3), H - 90, bw, 16, CLASSES[id].name, { color: i === this.cls ? 'sand' : 'mist' });\n        if (ui.focus === `class:${id}` && this.cls !== i) { this.cls = i; g.shellSet?.setMode('select', i); }\n        if (r) { this.step = 'start'; ui.preferFocus = 'start:begin'; }\n      });\n      ui.textBlock(14, H - 70, cls.blurb, W - 150, { color: 'white', lineH: 9 });\n      ui.textBlock(14, H - 50, cls.style, W - 150, { color: 'mist', lineH: 9 });\n      // Signature skills.\n      cls.signature.forEach((sid, i) => {\n        const sk = SKILLS[sid];\n        const ic = icon(sk.icon);\n        ui.sprite(W - 130, H - 88 + i * 16, ic.rows, ic.colors);\n        ui.text(W - 114, H - 86 + i * 16, sk.name, { color: 'sand' });\n      });\n      ui.text(W - 130, H - 38, `RESOURCE: ${cls.res}`, { color: 'mist' });\n      ui.footer([['confirm', 'THIS ONE'], ['back', 'BACK']]);\n      return;\n    }\n    // Name, difficulty, start point.\n    ui.rect(0, H - 124, W, 124, 'ink');\n    ui.rect(0, H - 125, W, 1, 'slate');\n    ui.text(14, 12, CLASSES[PLAYABLE[this.cls]].name, { color: 'sand', scale: 2 });\n    const y = H - 118;\n    ui.text(14, y + 3, 'NAME', { color: 'mist' });\n    ui.text(50, y + 3, this.name, { color: 'white' });\n    if (ui.button('new:shuffle', 150, y, 74, 13, 'ANOTHER')) { this.name = namePick(g); }\n    ui.text(14, y + 19, 'DIFFICULTY', { color: 'mist' });\n    const diffs = DIFFICULTIES.filter((d) => !d.penance || g.save.account.unlocks.penance);\n    const label = DIFFICULTIES[this.diff].name;\n    const dr = ui.widget('new:diff', 80, y + 16, 110, 13);\n    ui.rect(80, y + 16, 110, 13, dr.focused ? 'plum' : 'night');\n    ui.text(135, y + 19, `< ${label} >`, { color: 'sand', align: 'center' });\n    const m = g.input.menu;\n    if ((dr.focused && m.right) || dr.activated) this.diff = (this.diff + 1) % diffs.length;\n    if (dr.focused && m.left) this.diff = (this.diff - 1 + diffs.length) % diffs.length;\n    const slot = g.save.heroes.findIndex((h) => !h);\n    if (slot < 0) ui.text(200, y + 19, 'ALL THREE SLOTS FULL', { color: 'red' });\n    const bw = Math.floor((W - 28 - 4) / 2);\n    const by = y + 34;\n    if (ui.button('start:begin', 14, by, bw, 30, 'THE BEGINNING', { disabled: slot < 0, color: 'white' })) { g.startNewHero(PLAYABLE[this.cls], this.name, this.diff, 'beginning'); return; }\n    if (ui.button('start:last', 14 + bw + 4, by, bw, 30, 'THE LAST BELL', { disabled: slot < 0, color: 'orange' })) { g.startNewHero(PLAYABLE[this.cls], this.name, this.diff, 'lastbell'); return; }\n    ui.textBlock(14, by + 33, 'THE STORY, FROM YOUR OWN GRAVE.', bw, { color: 'mist', lineH: 9 });\n    ui.textBlock(14 + bw + 4, by + 33, 'LEVEL 30, EVERY SKILL, LEGENDARIES, KEYS. THE WHOLE ENDGAME AT ONCE.', bw, { color: 'mist', lineH: 9 });\n    ui.footer([['confirm', 'BEGIN'], ['back', 'BACK']]);\n  }\n}\n\nexport class HeroSelect extends Screen {\n  constructor(game, o = {}) { super(game, { tag: 'heroselect', freeze: false }); this.knell = !!o.knell; this.hold = 0; }\n  onClose() { this.game.shellSet?.setMode('title', 0); }\n  onOpen() { const first = this.game.save.heroes.findIndex(Boolean); const s = this.game.save.heroes[first]; this.game.shellSet?.setMode('select', PLAYABLE.indexOf(s?.data?.cls ?? 'lamplighter')); }\n  draw(ui) {\n    const g = this.game;\n    const W = ui.w, H = ui.h;\n    ui.rect(0, H - 96, W, 96, 'ink');\n    ui.rect(0, H - 97, W, 1, 'slate');\n    ui.text(14, 12, this.knell ? 'WHO RUNS THE KNELL?' : 'WHO GETS UP?', { color: 'sand', scale: 2 });\n    const bw = Math.floor((W - 28 - 8) / 3);\n    g.save.heroes.forEach((s, i) => {\n      const x = 14 + i * (bw + 4), y = H - 90;\n      const r = ui.widget(`hero:${i}`, x, y, bw, 58, { disabled: !s });\n      ui.rect(x, y, bw, 58, r.focused ? 'sand' : s ? 'slate' : 'night');\n      ui.rect(x + 1, y + 1, bw - 2, 56, r.focused ? 'plum' : 'ink');\n      if (s) {\n        const d = s.data;\n        ui.text(x + 5, y + 4, d.name, { color: 'white' });\n        ui.text(x + 5, y + 14, `LV ${d.level} ${CLASSES[d.cls].name}`.slice(0, Math.floor((bw - 8) / 6)), { color: CLASSES[d.cls].color });\n        ui.text(x + 5, y + 24, DIFFICULTIES[s.camp?.difficulty ?? 0].name, { color: 'mist' });\n        ui.text(x + 5, y + 34, s.camp?.credits ? 'THE BELL RANG TRUE' : (s.camp?.zone ?? 'yard').toUpperCase().slice(0, Math.floor((bw - 8) / 6)), { color: 'slate' });\n        if (r.focused) {\n          g.shellSet?.setMode('select', PLAYABLE.indexOf(d.cls));\n          const m = g.input.menu;\n          if (m.ctxA) this.delTarget = i;\n          const held = m.ctxA || (g.input.input.isDown('KeyX') || g.input.pads.some((p) => p?.b?.[2]));\n          if (held && this.delTarget === i) {\n            this.hold += g.lastRealDt;\n            ui.rect(x + 1, y + 54, (bw - 2) * Math.min(1, this.hold / 1.5), 3, 'red');\n            if (this.hold >= 1.5) { g.deleteHero(i); this.hold = 0; this.delTarget = null; }\n          } else if (!held) { this.hold = 0; this.delTarget = null; }\n        }\n        if (r.activated) { g.continueHero(i, { knell: this.knell }); return; }\n      } else ui.text(x + bw / 2, y + 24, 'AN EMPTY GRAVE', { color: 'slate', align: 'center' });\n    });\n    ui.footer([['confirm', 'THIS ONE'], ['ctxA', 'HOLD TO BURY'], ['back', 'BACK']]);\n  }\n}\n\nexport class TouchNotice extends Screen {\n  constructor(game) { super(game, { tag: 'touch', freeze: false }); }\n  draw(ui) {\n    const W = ui.w;\n    const y = bigTitle(ui, 20);\n    const lines = ui.wrap('CONTROLLER OR KEYBOARD REQUIRED', W - 16);\n    ui.rect(0, y + 2, W, lines.length * 10 + 8, 'ink');\n    lines.forEach((l, i) => ui.text(W / 2, y + 6 + i * 10, l, { color: 'white', align: 'center' }));\n    ui.text(W / 2, ui.h - 16, 'DEMO', { color: 'sand', align: 'center' });\n  }\n  back() {}\n}\nEOF\ncat > src/modes/game.js <<'EOF'\n// The Game object: one for the whole session. Zones swap inside it, so recordings cover everything.\nimport { Rng, THREE, LOOK_PRESETS, MODEL_LIBRARY } from '../../pixel-engine.js';\nimport { AudioSys } from '../audio/audio.js';\nimport { CLASSES, PLAYABLE } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { QUESTS } from '../data/quests.js';\nimport { InputRouter } from '../input/router.js';\nimport { defaultSettings, emptySave, HERO_SLOTS, readSave, writeSave } from '../save/save.js';\nimport { botAfter, botIntent, botManage, newBotMemory } from '../sim/bot.js';\nimport { applyCommand } from '../sim/commands.js';\nimport { addHero, heroToData, newHeroData, recalcHero, gearLook } from '../sim/hero.js';\nimport { emptyIntent } from '../sim/intents.js';\nimport { makeItem, makeRolledItem } from '../sim/loot.js';\nimport { newCampaign, questInit, ensurePyx } from '../sim/quests.js';\nimport { loadZone } from '../sim/travel.js';\nimport { beginCampaign, createWorld, stepWorld, worldHash } from '../sim/world.js';\nimport { AttractTour } from './attract.js';\nimport { DevOverlays } from '../ui/devoverlays.js';\nimport { HudSys } from '../ui/hud.js';\nimport { DeathScreen, Cutscene, DialogueScreen, KnellScreen, LoreScreen, MapScreen, ResultsScreen, STORY, WritsScreen } from '../ui/menus/world.js';\nimport { HeroScreen } from '../ui/menus/hero.js';\nimport { PauseScreen, LOOKS } from '../ui/menus/pause.js';\nimport { MainMenu, TitleScreen, TouchNotice } from '../ui/menus/shell.js';\nimport { StashScreen } from '../ui/menus/vendors.js';\nimport { UI } from '../ui/ui.js';\nimport { ShellSet } from '../view/sets.js';\nimport { View } from '../view/view.js';\nimport { STORY_LINES } from '../data/dialog.js';\nimport { gemId } from '../data/items.js';\nimport { SET_BY_CLASS } from '../data/items.js';\nimport { SKILLS } from '../data/skills.js';\n\nconst { Vector3 } = THREE;\nexport const VIGNETTE_LOOK = (v) => ({ scene: [{ id: 'vignette', params: { intensity: v } }] });\n\nexport class DiabellicalGame {\n  name = TITLE;\n\n  constructor(opts = {}) {\n    this.opts = opts;\n    this.frame = 0;\n    this.frameTime = 0;\n    this.lastRealDt = 1 / 60;\n    this.world = null;\n    this.screens = [];\n    this.mode = 'boot';\n    this.botSeats = new Set();\n    this.botMem = new Map();\n    this.pendingEvents = [];\n    this.isSession = false;\n    this.isClient = false;\n    this.seed = opts.seed ?? 1;\n    this.settings = defaultSettings();\n    this.save = emptySave();\n    this.overlays = { nav: false, hit: false, ai: false, spawn: false, flow: false, state: false };\n    this.overlaysOn = false;\n    this.devTimeScale = 1;\n    this.camTarget = new Vector3();\n    this.uiRng = new Rng(`ui:${opts.seed ?? 1}`);\n    this.labelsHeld = false;\n    this.touchOnly = !!opts.touchOnly;\n    this.currentSlot = -1;\n    this.autosaveT = 0;\n    this.pxScale = 4;\n    this.attract = null;\n  }\n\n  async setup(ctx) {\n    this.ctx = ctx;\n    this.audioSys = new AudioSys(this, ctx);\n    this.input = new InputRouter(this, ctx);\n    this.view = new View(this, ctx);\n    this.ui = new UI(this, ctx);\n    this.hudSys = new HudSys(this, ctx);\n    this.devOverlays = new DevOverlays(this);\n    if (this.opts.onSetup) await this.opts.onSetup(this, ctx);\n    if (!this.opts.hub) {\n      this.loadSaveData();\n      this.enterShell();\n    }\n  }\n\n  ready() {\n    if (typeof window !== 'undefined') window.__GAME__ = this;\n    this.computeScale();\n  }\n\n  computeScale() {\n    try {\n      const v = this.ctx.engine.renderer.viewport;\n      this.pxScale = (v?.width ?? 960) / this.ctx.hud.width;\n    } catch { this.pxScale = 4; }\n  }\n\n  loadSaveData() {\n    const s = readSave();\n    if (s) this.save = s;\n    this.settings = { ...this.settings, ...this.save.settings };\n    this.save.settings = this.settings;\n    this.audioSys.voicesVol = this.settings.voices ?? 1;\n  }\n\n  saveSettings() { writeSave(this.save); }\n\n  resetSettings() {\n    this.save.settings = defaultSettings();\n    this.settings = this.save.settings;\n    this.ctx.audio.resetVolumes();\n    this.ctx.engine.settings.reset();\n    this.audioSys.voicesVol = 1;\n    this.applyLook();\n    this.saveSettings();\n  }\n\n  applyLook() {\n    const i = this.settings.lookIndex ?? 0;\n    const id = LOOKS[i][1];\n    if (id) this.ctx.engine.setLook(LOOK_PRESETS[id]);\n    else this.ctx.engine.setLook(VIGNETTE_LOOK(0.3));\n  }\n\n  applyVignette(v) {\n    if ((this.settings.lookIndex ?? 0) !== 0) return;\n    this.ctx.engine.setLook(VIGNETTE_LOOK(v));\n  }\n\n  toggleFullscreen() {\n    if (typeof document === 'undefined') return;\n    try {\n      if (document.fullscreenElement) { const p = document.exitFullscreen(); if (p?.catch) p.catch(() => {}); }\n      else { const p = document.documentElement.requestFullscreen?.(); if (p?.catch) p.catch(() => {}); }\n    } catch { /* browsers may refuse */ }\n  }\n\n  // ---- Shell -------------------------------------------------------------------------------\n  enterShell() {\n    this.mode = 'shell';\n    this.closeAll();\n    this.teardownWorld();\n    if (!this.shellSet) this.shellSet = new ShellSet(this.view);\n    this.shellSet.setMode('title', 0);\n    this.audioSys.music('vespers');\n    this.ctx.engine.timeScale = 1;\n    if (this.touchOnly) { this.openScreen(new TouchNotice(this)); this.startAttract(false); return; }\n    this.openScreen(new TitleScreen(this));\n    this.idleSeen = 0;\n  }\n\n  openMainMenu() {\n    this.closeScreen();\n    this.openScreen(new MainMenu(this));\n  }\n\n  // ---- Screens -----------------------------------------------------------------------------\n  openScreen(s) {\n    if (this.screens.length) this.screens[this.screens.length - 1].savedFocus = this.ui?.focus;\n    this.screens.push(s);\n    s.onOpen?.();\n    this.ui.focus = null;\n    this.input.input.clearQueued();\n  }\n\n  closeScreen() {\n    const s = this.screens.pop();\n    if (s) { s.onClose?.(); this.audioSys?.sfx('ui_back'); }\n    const top = this.screens[this.screens.length - 1];\n    if (top?.savedFocus) this.ui.focus = top.savedFocus;\n    this.input.input.clearQueued();\n    if (!this.screens.length) this.menuSeat = null;\n  }\n\n  closeAll() {\n    while (this.screens.length) { const s = this.screens.pop(); s.onClose?.(); }\n    this.menuSeat = null;\n  }\n\n  topScreen() { return this.screens[this.screens.length - 1] ?? null; }\n  menuHero() {\n    const seat = this.menuSeat ?? this.localSeats()[0] ?? 0;\n    return this.world?.heroes.find((h) => h.seat === seat) ?? this.world?.heroes[0] ?? null;\n  }\n\n  // ---- Heroes and seats --------------------------------------------------------------------\n  localSeats() {\n    if (this.net?.seat !== undefined) return this.net.seat === null ? [] : [this.net.seat];\n    return this.input.seats.map((_, i) => i).filter((i) => this.world?.heroes.some((h) => h.seat === i && !h.gone));\n  }\n  isLocalSeat(seat) { return this.localSeats().includes(seat); }\n  isLocalLoot(owner) { return owner < 0 || this.isLocalSeat(owner) || this.botSeats.has(owner) || this.attract; }\n  isCameraSeat(seat) { return this.localSeats().includes(seat) || !!this.attract; }\n  humanCount() { return this.world ? this.world.heroes.filter((h) => !h.gone && !h.companion).length : 1; }\n  localHero() { const s = this.localSeats()[0] ?? 0; return this.world?.heroes.find((h) => h.seat === s) ?? null; }\n  freePads() { const out = []; for (let i = 0; i < this.input.pads.length; i++) if (this.input.pads[i] && this.input.seatOfPad(i) < 0) out.push(i); return out; }\n\n  onPadSeen(i) {\n    if (this.mode === 'play' && this.input.seats[0].pad !== null && this.input.seatOfPad(i) < 0) this.hudSys.toast('A NEW CONTROLLER. PRESS OPTIONS ON IT TO JOIN.', 'sky', { life: 5 });\n    else if (this.mode === 'play' && i > 0) this.hudSys.toast('A NEW CONTROLLER. PRESS OPTIONS ON IT TO JOIN.', 'sky', { life: 5 });\n  }\n\n  joinSeat(pad, cls) {\n    const w = this.world;\n    const seat = this.input.seats.length;\n    if (seat > 3 || !w) return null;\n    const d = this.save.guests[cls] ?? newHeroData(cls, `GUEST ${seat + 1}`, `guest:${cls}`);\n    const lead = w.heroes.find((h) => h.seat === 0);\n    d.level = Math.max(d.level, lead?.level ?? 1);\n    d.skills = CLASSES[cls].preset.map(([id]) => (d.level >= SKILLS[id].level ? { id, tone: null } : null));\n    this.input.seats.push({ kind: 'pad', pad });\n    const h = addHero(w, d, seat, { navIndex: seat, guest: true, x: (lead?.x ?? 0) + 1, z: (lead?.z ?? 0) + 1 });\n    if (!w.zone.nav.walkable(h.x, h.z)) { h.x = lead.x; h.z = lead.z; }\n    ensurePyx(w);\n    this.hudSys.toast(`P${seat + 1} JOINS AS ${CLASSES[cls].name}`, 'sky', { big: true });\n    this.audioSys.sfx('bell_mid');\n    return h;\n  }\n\n  leaveSeat(seat) {\n    const w = this.world;\n    const h = w.heroes.find((o) => o.seat === seat);\n    if (!h) return;\n    this.save.guests[h.cls] = heroToData(h);\n    h.gone = true;\n    w.heroes.splice(w.heroes.indexOf(h), 1);\n    this.view.ev_hero_gone({ id: h.id });\n    this.input.seats.splice(seat, 1);\n    for (const o of w.heroes) if (!o.companion && o.seat > seat) o.seat--;\n    ensurePyx(w);\n    this.hudSys.toast(`P${seat + 1} LEAVES`, 'mist');\n    this.botSeats.delete(seat);\n  }\n  leaveLastSeat() { const n = this.input.seats.length - 1; if (n > 0) this.leaveSeat(n); }\n\n  addBotSeat() {\n    const w = this.world;\n    const seat = this.input.seats.length;\n    if (seat > 3) return;\n    const cls = PLAYABLE[seat % 3];\n    const lead = w.heroes.find((h) => h.seat === 0);\n    const d = newHeroData(cls, `BOT ${seat + 1}`, `bot${seat}`);\n    d.level = lead.level;\n    this.input.seats.push({ kind: 'bot', pad: null });\n    const h = addHero(w, d, seat, { navIndex: seat, x: lead.x + 1, z: lead.z + 1 });\n    if (!w.zone.nav.walkable(h.x, h.z)) { h.x = lead.x; h.z = lead.z; }\n    this.botSeats.add(seat);\n    botManage(w, h, this.memOf(h));\n  }\n  removeBotSeat() { for (let s = this.input.seats.length - 1; s > 0; s--) if (this.botSeats.has(s)) { this.leaveSeat(s); return; } }\n  toggleBot(seat) { if (this.botSeats.has(seat)) this.botSeats.delete(seat); else this.botSeats.add(seat); }\n  memOf(h) { let m = this.botMem.get(h.id); if (!m) { m = newBotMemory(); this.botMem.set(h.id, m); } return m; }\n\n  // ---- Starting play -----------------------------------------------------------------------\n  startNewHero(cls, name, difficulty, start) {\n    const slot = this.save.heroes.findIndex((h) => !h);\n    if (slot < 0) return;\n    const seed = this.newSeed();\n    const data = newHeroData(cls, name, `hero${slot}:${seed}`);\n    const camp = newCampaign();\n    camp.seed = seed;\n    camp.difficulty = difficulty;\n    this.save.heroes[slot] = { data, camp };\n    this.currentSlot = slot;\n    if (start === 'lastbell') this.prepareLastBell(this.save.heroes[slot], seed);\n    writeSave(this.save);\n    this.launchPlay(this.save.heroes[slot], { start });\n  }\n\n  newSeed() {\n    if (typeof crypto !== 'undefined' && crypto.getRandomValues && !this.opts.fixedSeed) { const a = new Uint32Array(1); crypto.getRandomValues(a); return a[0] % 1000000; }\n    return this.opts.fixedSeed ?? 12345;\n  }\n\n  /** A level 30 hero with the whole endgame in reach. */\n  prepareLastBell(slot, seed) {\n    const d = slot.data;\n    const rng = new Rng(`lastbell:${seed}`);\n    d.level = 30;\n    const cls = CLASSES[d.cls];\n    d.skills = cls.skills.slice(2, 8).map((id) => ({ id, tone: Object.keys(SKILLS[id].tones)[0] }));\n    d.skills[0] = { id: cls.skills[0], tone: Object.keys(SKILLS[cls.skills[0]].tones)[0] };\n    d.vows = [null, null];\n    const stub = { cls: d.cls };\n    const set = SET_BY_CLASS[d.cls];\n    for (const slotId of ['main', 'off', 'head', 'shoulders', 'chest', 'hands', 'legs', 'feet', 'amulet', 'ring']) {\n      d.gear[slotId] = makeItem(rng, { slot: slotId, rarity: 'reliquary', ilvl: 30, cls: d.cls, forceSocket: slotId === 'main' || slotId === 'chest' });\n    }\n    d.gear.head = makeItem(rng, { slot: 'head', rarity: 'set', ilvl: 30, cls: d.cls, set });\n    d.gear.chest = makeItem(rng, { slot: 'chest', rarity: 'set', ilvl: 30, cls: d.cls, set, forceSocket: true });\n    d.inv[0] = makeRolledItem(rng, stub, 'legendary', 30);\n    d.inv[1] = makeRolledItem(rng, stub, 'legendary', 30);\n    d.inv[2] = makeRolledItem(rng, stub, 'legendary', 30);\n    d.gear.main = makeItem(rng, { rarity: 'legendary', ilvl: 30, cls: d.cls, legendary: { bellwarden: 'widows_clapper', lamplighter: 'last_wick', sexton: 'second_best_crook' }[d.cls], forceSocket: true });\n    d.mats = { scrap: 40, dust: 20, shards: 12 };\n    d.gold = 60000;\n    d.grandKeys = 1;\n    d.gems = { [gemId('ember', 1)]: 3, [gemId('salt', 1)]: 3, [gemId('amber', 1)]: 3, [gemId('ember', 0)]: 3 };\n    const c = slot.camp;\n    c.q = { i: QUESTS.length, s: 0 };\n    c.credits = true;\n    c.zone = 'town';\n    c.floor = 0;\n    Object.assign(c.flags, { open_causeway: 1, open_ossuary: 1, open_cloister: 1, open_belfry: 1, forge: 1, reliquary: 1, brasse_met: 1, brasse_home: 1, crier_met: 1, pyx: 1, overdue_open: 1, wagon_home: 1, malison_dead: 1, yard_coffin: 1, bursar_dead: 1, ambrose_dead: 1 });\n    c.plateFirst = true;\n    const a = this.save.account;\n    a.unlocks.knell = true;\n    a.unlocks.penance = true;\n    a.devotion.points += 5;\n    a.devotion.level = Math.max(a.devotion.level, 5);\n  }\n\n  continueHero(i, o = {}) {\n    const slot = this.save.heroes[i];\n    if (!slot) return;\n    this.currentSlot = i;\n    this.launchPlay(slot, { start: o.knell ? 'knell' : 'continue' });\n  }\n\n  deleteHero(i) {\n    this.save.heroes[i] = null;\n    writeSave(this.save);\n    this.audioSys.sfx('coffin_slam');\n  }\n\n  launchPlay(slot, o = {}) {\n    this.closeAll();\n    this.leaveShell();\n    this.input.seats = [{ kind: 'kbm', pad: this.input.seats[0]?.pad ?? null }];\n    const camp = slot.camp;\n    const seed = camp.seed ?? this.newSeed();\n    camp.seed = seed;\n    this.seed = seed;\n    const w = createWorld({ seed, difficulty: camp.difficulty ?? 0, account: this.save.account, camp });\n    w.mode = 'campaign';\n    this.world = w;\n    this.mode = 'play';\n    this.view.setWorld(w);\n    const fresh = o.start === 'beginning';\n    addHero(w, slot.data, 0, { navIndex: 0 });\n    let zone = camp.zone ?? 'yard', floor = camp.floor ?? 0;\n    if (o.start === 'knell') { zone = 'town'; floor = 0; }\n    if (w.camp.credits && zone === 'belfry') { zone = 'town'; floor = 0; }\n    loadZone(w, zone, floor, 'start');\n    this.flushEvents();\n    this.applyLook();\n    if (fresh) {\n      questInit(w);\n      this.flushEvents();\n      this.openScreen(new Cutscene(this, { ...STORY.opening() }));\n    } else if (o.start === 'lastbell') {\n      this.hudSys.toast('THE LAST BELL: THE WHOLE ENDGAME IS OPEN. SPEND YOUR DEVOTION.', 'sand', { life: 6 });\n      this.hudSys.toast('THE KNELL FONT IS IN THE SQUARE.', 'sand', { life: 6 });\n    } else if (w.camp.q.i < QUESTS.length) this.hudSys.toast(`QUEST: ${QUESTS[w.camp.q.i].steps[w.camp.q.s].text}`, 'sand', { life: 5 });\n  }\n\n  leaveShell() {\n    if (this.shellSet) { this.shellSet.dispose(); this.shellSet = null; }\n    if (this.attract) { this.attract.stop(); this.attract = null; }\n  }\n\n  teardownWorld() {\n    this.view.setWorld(null);\n    this.world = null;\n    this.botSeats.clear();\n    this.botMem.clear();\n    this.pendingEvents.length = 0;\n  }\n\n  persist() {\n    if (this.currentSlot < 0 || !this.world || this.isSession || this.attract) return;\n    const h = this.world.heroes.find((o) => o.seat === 0);\n    if (!h) return;\n    const slot = this.save.heroes[this.currentSlot];\n    if (!slot) return;\n    slot.data = heroToData(h);\n    slot.camp = this.world.camp;\n    for (const o of this.world.heroes) if (o.guest) this.save.guests[o.cls] = heroToData(o);\n    writeSave(this.save);\n  }\n\n  saveAndQuit() {\n    this.persist();\n    this.ctx.engine.timeScale = 1;\n    this.closeAll();\n    this.enterShell();\n  }\n\n  rerollMap() {\n    const w = this.world;\n    const seed = this.newSeed();\n    w.camp.seed = seed;\n    w.seed = seed;\n    w.root = new Rng(seed);\n    loadZone(w, w.zone.id, w.zone.floor, 'start');\n  }\n\n  cmd(c, seat = null) {\n    const s = seat ?? this.menuSeat ?? this.localSeats()[0] ?? 0;\n    if (this.isClient) { this.net.sendCommand(c); return true; }\n    return applyCommand(this.world, s, c);\n  }\n\n  // ---- Attract ------------------------------------------------------------------------------\n  startAttract(fromDev = false) {\n    if (this.attract) return;\n    if (this.shellSet) { this.shellSet.dispose(); this.shellSet = null; }\n    const returnTo = this.mode;\n    this.attractReturn = returnTo;\n    this.attractFromDev = fromDev;\n    if (fromDev) { this.savedWorld = this.world; this.persist(); this.view.setWorld(null); }\n    this.mode = 'attract';\n    this.attract = new AttractTour(this);\n    this.attract.start();\n  }\n\n  stopAttract() {\n    const fromDev = this.attractFromDev;\n    if (this.attract) { this.attract.stop(); this.attract = null; }\n    this.world = null;\n    this.view.setWorld(null);\n    this.botSeats.clear();\n    this.botMem.clear();\n    this.pendingEvents.length = 0;\n    this.ctx.engine.timeScale = 1;\n    if (fromDev && this.savedWorld) {\n      this.world = this.savedWorld;\n      this.savedWorld = null;\n      this.mode = 'play';\n      this.view.setWorld(this.world);\n      return;\n    }\n    this.mode = 'shell';\n    this.shellSet = new ShellSet(this.view);\n    this.shellSet.setMode('title', 0);\n    this.audioSys.music('vespers');\n    this.input.idleFrames = 0;\n    this.applyLook();\n  }\n\n  // ---- Hooks --------------------------------------------------------------------------------\n  fixedUpdate(ctx, dt) {\n    if (this.opts.hub && this.net) { this.net.fixedUpdate(dt); return; }\n    const w = this.world;\n    if (!w) return;\n    if (this.mode === 'attract') { this.attract?.fixed(); return; }\n    if (this.mode !== 'play') return;\n    const top = this.topScreen();\n    if (top?.holdSim) return;\n    this.stepPlay(w);\n  }\n\n  stepPlay(w) {\n    const intents = [];\n    for (let seat = 0; seat < this.input.seats.length; seat++) {\n      const h = w.heroes.find((o) => o.seat === seat);\n      if (!h) continue;\n      if (this.botSeats.has(seat)) {\n        const mem = this.memOf(h);\n        intents[seat] = botIntent(w, h, mem);\n        if (w.t % 300 === 0) botManage(w, h, mem);\n        botAfter(w, h, mem);\n        for (const e of w.events) if (e.t === 'talk' && e.seat === seat) applyCommand(w, seat, { c: 'talk_done', npc: e.npc });\n      } else {\n        intents[seat] = this.menuBlocks(seat) ? emptyIntent() : this.input.intentFor(seat, w);\n      }\n    }\n    for (const h of w.heroes) {\n      if (!h.companion) continue;\n      intents[h.seat] = botIntent(w, h, this.memOf(h));\n      botAfter(w, h, this.memOf(h));\n    }\n    stepWorld(w, intents);\n    this.drainEvents(w);\n  }\n\n  menuBlocks() { return this.screens.length > 0 && !(this.topScreen()?.tag === 'death'); }\n\n  drainEvents(w) {\n    if (w.events.length) { for (const e of w.events) this.pendingEvents.push(e); w.events.length = 0; }\n  }\n\n  flushEvents() { if (this.world) this.drainEvents(this.world); this.dispatchEvents(); }\n\n  dispatchEvents() {\n    if (!this.pendingEvents.length) return;\n    const list = this.pendingEvents;\n    this.pendingEvents = [];\n    this.view.consume(list);\n    this.hudSys.consume(list);\n    for (const e of list) this.flowEvent(e);\n  }\n\n  flowEvent(e) {\n    const w = this.world;\n    switch (e.t) {\n      case 'talk':\n        if (this.isLocalSeat(e.seat) && !this.botSeats.has(e.seat)) { this.menuSeat = e.seat; this.openScreen(new DialogueScreen(this, e.npc, e.id)); }\n        break;\n      case 'open': {\n        if (!this.isLocalSeat(e.seat) || this.botSeats.has(e.seat)) break;\n        this.menuSeat = e.seat;\n        if (e.ui === 'map') this.openScreen(new MapScreen(this));\n        else if (e.ui === 'knell') this.openScreen(new KnellScreen(this));\n        else if (e.ui === 'writs') this.openScreen(new WritsScreen(this));\n        else if (e.ui === 'stash') this.openScreen(new StashScreen(this));\n        break;\n      }\n      case 'lore':\n        if (this.isLocalSeat(e.seat) && !this.botSeats.has(e.seat)) this.openScreen(new LoreScreen(this, e.id));\n        break;\n      case 'down':\n        if (this.isLocalSeat(e.seat) && !e.companion && !this.botSeats.has(e.seat)) { this.menuSeat = e.seat; if (!this.isSession) this.openScreen(new DeathScreen(this, e.seat)); }\n        break;\n      case 'cut': this.onCut(e); break;\n      case 'autosave': this.persist(); break;\n      case 'run_done': if (!this.botSeats.has(0) && !this.attract) this.openScreen(new ResultsScreen(this, e.results)); break;\n      case 'zone': this.persist(); if (w?.run && e.zone === 'town') w.run = null; if (e.zone === 'town' && w?.run) w.run = null; break;\n      default: break;\n    }\n  }\n\n  onCut(e) {\n    if (this.isSession || this.attract) return;\n    if (e.id === 'ending') { this.playEnding(!!e.first); return; }\n    const s = STORY[e.id];\n    if (!s) return;\n    const boss = this.world.boss;\n    this.openScreen(new Cutscene(this, { ...s, cam: boss ? { x: boss.x, z: boss.z, zoom: 1.1 } : null }));\n  }\n\n  playEnding(first) {\n    const w = this.world;\n    const ctx = this.ctx;\n    this.openScreen(new Cutscene(this, {\n      lines: STORY_LINES.ending,\n      music: 'clemency',\n      extra: 2,\n      onEnd: () => {\n        ctx.engine.screen.flash('white', { duration: 0.6 });\n        this.persist();\n        if (first) {\n          import('../ui/menus/pause.js').then(() => {});\n          this.hudSys.toast('PENANCE AND KNELL RUNS ARE OPEN AT THE FONT', 'sand', { big: true, life: 6 });\n        }\n        this.cmd({ c: 'dev_goto', zone: 'town', floor: 0 });\n      },\n    }));\n    ctx.engine.sun.color.setHex(0xffd090);\n    ctx.engine.sun.intensity = 1.4;\n    ctx.engine.ambient.intensity = 1.4;\n  }\n\n  update(ctx, dt) {\n    const real = this.realDt(ctx, dt);\n    this.lastRealDt = real;\n    this.frame++;\n    this.frameTime += real;\n    this.input.beginFrame();\n    this.handleCommands(ctx);\n    if (this.world) this.drainEvents(this.world);\n    this.dispatchEvents();\n    this.audioSys.update(real);\n    if (this.net) this.net.update(real);\n    // Time: full-screen menus freeze the world (solo and couch). Dev time scale otherwise.\n    const top = this.topScreen();\n    if (!this.isSession && this.mode === 'play') {\n      const frozen = !!top?.freeze;\n      if (frozen) ctx.engine.timeScale = 0;\n      else if (!(this.view.slowT > 0)) ctx.engine.timeScale = this.devTimeScale;\n    }\n    this.view.update(dt, real);\n    if (this.shellSet) this.shellSet.update(dt, real);\n    this.hudSys.update(real);\n    if (this.mode === 'play') this.playFrame();\n    else if (this.mode === 'shell') this.shellFrame();\n    else if (this.mode === 'attract') this.attract?.frame();\n    this.drawUI(real);\n    if (this.mode === 'play') {\n      this.autosaveT += real;\n      if (this.autosaveT > 60) { this.autosaveT = 0; this.persist(); }\n    }\n  }\n\n  realDt(ctx, dt) {\n    if (dt > 0) return dt;\n    return 1 / 60;\n  }\n\n  handleCommands() {}\n\n  playFrame() {\n    const w = this.world;\n    if (!w) return;\n    const m = this.input.menu;\n    const top = this.topScreen();\n    this.input.claimSeat0();\n    // Couch: a free pad pressing Options joins with the next class along.\n    if (!this.isSession) {\n      const join = this.input.freePadPressedOptions();\n      if (join >= 0 && this.input.seats[0].pad !== null) {\n        const seat = this.input.seats.length;\n        if (seat < 4) this.joinSeat(join, PLAYABLE[seat % 3]);\n      }\n    }\n    this.labelsHeld = false;\n    const seats = this.localSeats();\n    if (top) {\n      if (m.back && top.back) top.back();\n      else if (m.pause && top.tag !== 'dialogue' && top.tag !== 'cutscene' && top.tag !== 'death') this.closeAll();\n      return;\n    }\n    for (const seat of seats) {\n      if (this.botSeats.has(seat) && seat !== 0) continue;\n      const acts = this.input.frameActions(seat);\n      for (const a of acts) this.seatAction(seat, a);\n      if (this.topScreen()) return;\n    }\n  }\n\n  seatAction(seat, a) {\n    const open = (s) => { this.menuSeat = seat; this.openScreen(s); };\n    switch (a) {\n      case 'pause': open(new PauseScreen(this)); break;\n      case 'hero_gear': if (!this.world.heroes.find((h) => h.seat === seat)?.dead) open(new HeroScreen(this, 0)); break;\n      case 'hero_skills': open(new HeroScreen(this, 1)); break;\n      case 'hero_quests': { const s = new HeroScreen(this, 4); open(s); break; }\n      case 'map': open(new MapScreen(this)); break;\n      case 'equip': this.cmd({ c: 'equip_newest' }, seat); break;\n      case 'cycle': this.cmd({ c: 'cycle_use' }, seat); break;\n      case 'labels': this.labelsHeld = true; break;\n      default: break;\n    }\n  }\n\n  shellFrame() {\n    const m = this.input.menu;\n    const top = this.topScreen();\n    if (top && m.back) top.back();\n    if (top && this.input.idleFrames > 600 && (top.tag === 'title' || top.tag === 'menu') && !this.opts.noAttract) {\n      this.startAttract(false);\n    }\n  }\n\n  drawUI(real) {\n    const ui = this.ui;\n    ui.begin();\n    if (this.mode === 'play' || this.mode === 'attract' || this.isSession) {\n      const top = this.topScreen();\n      const showHud = !top || !(top.tag === 'cutscene' || top.tag === 'dialogue');\n      if (showHud && this.world?.zone) this.hudSys.draw(ui, real);\n    }\n    if (this.mode === 'attract') this.attract?.drawOverlay(ui);\n    if (this.net?.drawOverlay) this.net.drawOverlay(ui);\n    const top = this.topScreen();\n    if (top) {\n      ui.screenTag = top.tag;\n      top.t += real;\n      top.draw(ui, real);\n    }\n    ui.end();\n    this.updateCursor();\n  }\n\n  updateCursor() {\n    if (typeof document === 'undefined') return;\n    const want = this.input.lastDevice === 'pad' ? 'none' : (this.cursorCss ??= gauntletCursor());\n    if (this.lastCursor !== want) { this.lastCursor = want; document.body.style.cursor = want; const c = this.ctx.engine.gpu?.renderer?.domElement; if (c) c.style.cursor = want; }\n  }\n\n  drawDevOverlays(ui) { this.devOverlays.draw(ui); }\n\n  cameraTarget() { return this.view?.cam ?? this.camTarget; }\n  status() {\n    const w = this.world;\n    if (!w) return `${this.mode} ${this.topScreen()?.tag ?? ''}`;\n    const h = w.heroes[0];\n    return `${this.mode} ${w.zone?.id}:${w.zone?.floor} L${h?.level} party ${w.heroes.length} kills ${h?.kills ?? 0} monsters ${w.monsters.length}`;\n  }\n  fingerprint() { return this.world ? worldHash(this.world) : `${this.mode}:${this.frame % 1}`; }\n  dispose() { this.audioSys?.stopAll(); }\n}\n\nfunction gauntletCursor() {\n  if (typeof document === 'undefined') return 'default';\n  try {\n    const rows = ['XX........', 'XOX.......', 'XOOX......', 'XOOOX.....', 'XOOOOX....', 'XOOOOOX...', 'XOOOOOOX..', 'XOOOOXXXX.', 'XOOXOOX...', 'XOX.XOOX..', 'XX..XOOX..', '.....XX...'];\n    const c = document.createElement('canvas');\n    c.width = 30; c.height = 36;\n    const g = c.getContext('2d');\n    rows.forEach((r, y) => r.split('').forEach((ch, x) => {\n      if (ch === '.') return;\n      g.fillStyle = ch === 'X' ? '#1a1c2c' : '#ffcd75';\n      g.fillRect(x * 3, y * 3, 3, 3);\n    }));\n    return `url(${c.toDataURL()}) 0 0, default`;\n  } catch { return 'default'; }\n}\n\nexport { MODEL_LIBRARY, gearLook, recalcHero, HERO_SLOTS, beginCampaign };\nEOF\ncat > src/ui/devoverlays.js <<'EOF'\n// Dev mode's overlays, drawn in art pixels over the world.\nimport { NavGrid } from '../../pixel-engine.js';\n\nexport class DevOverlays {\n  constructor(game) { this.game = game; }\n  draw(ui) {\n    const g = this.game, w = g.world;\n    const o = g.overlays;\n    if (!w?.zone) return;\n    const view = g.view;\n    const h = g.localHero();\n    if (o.nav && h) {\n      const z = w.zone;\n      const cx = Math.floor(h.x), cz = Math.floor(h.z);\n      for (let j = cz - 12; j <= cz + 12; j++) for (let i = cx - 12; i <= cx + 12; i++) {\n        if (z.nav.isOpen(i, j)) continue;\n        const [sx, sy] = view.project(i + 0.5, 0, j + 0.5);\n        ui.rect(sx - 1, sy - 1, 2, 2, 'red');\n      }\n    }\n    if (o.flow && h) {\n      const out = [0, 0];\n      const nav = w.zone.navs[h.navIndex ?? 0];\n      const cx = Math.floor(h.x), cz = Math.floor(h.z);\n      for (let j = cz - 10; j <= cz + 10; j += 2) for (let i = cx - 10; i <= cx + 10; i += 2) {\n        if (!nav.walkable(i + 0.5, j + 0.5) || !nav.flowDirection(i + 0.5, j + 0.5, out)) continue;\n        const [a, b] = view.project(i + 0.5, 0, j + 0.5);\n        const [c, d] = view.project(i + 0.5 + out[0] * 0.6, 0, j + 0.5 + out[1] * 0.6);\n        ui.rect(a, b, 1, 1, 'cyan');\n        ui.rect(c, d, 1, 1, 'white');\n      }\n    }\n    if (o.hit) {\n      for (const m of [...w.monsters, ...w.heroes]) {\n        if (m.dead || m.gone) continue;\n        for (let a = 0; a < 10; a++) {\n          const ang = (a / 10) * Math.PI * 2;\n          const [sx, sy] = view.project(m.x + Math.cos(ang) * m.r, 0.1, m.z + Math.sin(ang) * m.r);\n          ui.rect(sx, sy, 1, 1, m.kind === 'hero' ? 'lime' : 'orange');\n        }\n      }\n    }\n    if (o.ai) for (const m of w.monsters) {\n      if (m.dead) continue;\n      const [sx, sy] = view.project(m.x, 2, m.z);\n      ui.text(sx, sy, m.state, { color: 'cyan', align: 'center' });\n    }\n    if (o.spawn) for (const s of w.zone.spawnList) {\n      const [sx, sy] = view.project(s.x, 0.2, s.z);\n      ui.rect(sx - 1, sy - 1, 3, 3, s.done ? 'slate' : s.kind === 'E' ? 'orange' : 'lime');\n    }\n    if (o.state) {\n      const st = g.ctx.engine.state();\n      ui.text(12, ui.h - 62, `FPS ${st.fps?.toFixed?.(0) ?? st.fps} ${g.status()}`.slice(0, 66), { color: 'cyan' });\n      ui.text(12, ui.h - 52, `T ${w.t} MON ${w.monsters.length} ALLY ${w.allies.length} DROPS ${w.drops.length}`, { color: 'cyan' });\n    }\n  }\n}\nexport { NavGrid };\nEOF\ncat > src/modes/attract.js <<'EOF'\n// Attract mode: a looping, cheating, AI-played tour of the whole demo. It never touches saves.\nimport { CLASSES, PLAYABLE } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { botIntent, newBotMemory } from '../sim/bot.js';\nimport { spawnElitePack } from '../sim/monsters.js';\nimport { startBoss } from '../sim/bosses.js';\nimport { addHero, newHeroData } from '../sim/hero.js';\nimport { makeItem } from '../sim/loot.js';\nimport { spawnPlate, newCampaign } from '../sim/quests.js';\nimport { startRun } from '../sim/knell.js';\nimport { loadZone } from '../sim/travel.js';\nimport { createWorld, newAccount, stepWorld } from '../sim/world.js';\nimport { runOps } from '../sim/effects.js';\nimport { dropItem, makeRolledItem } from '../sim/loot.js';\nimport { SKILLS } from '../data/skills.js';\nimport { BARKS, SPEAKERS } from '../data/dialog.js';\n\nconst STOPS = [\n  { id: 'town', dur: 18 },\n  { id: 'causeway', dur: 20 },\n  { id: 'ossuary', dur: 24 },\n  { id: 'cloister', dur: 18 },\n  { id: 'knell', dur: 18 },\n  { id: 'malison', dur: 24 },\n];\n\nfunction cheatHero(d, cls) {\n  d.level = 25;\n  const skills = CLASSES[cls].skills.slice(2, 8);\n  d.skills = skills.map((id) => ({ id, tone: Object.keys(SKILLS[id].tones)[1] }));\n  d.skills[0] = { id: CLASSES[cls].skills[0], tone: null };\n  return d;\n}\n\nexport class AttractTour {\n  constructor(game) {\n    this.game = game;\n    this.i = -1;\n    this.t = 0;\n    this.loops = 0;\n    this.mems = new Map();\n    this.visited = new Set();\n    this.seed = 777;\n  }\n\n  start() { this.next(); }\n\n  makeWorld(seats) {\n    const g = this.game;\n    const account = newAccount();\n    account.unlocks.knell = true;\n    account.unlocks.penance = true;\n    const camp = newCampaign();\n    camp.q.i = 5;\n    camp.credits = true;\n    camp.flags.forge = 1; camp.flags.reliquary = 1; camp.flags.brasse_met = 1; camp.flags.brasse_home = 1; camp.flags.malison_dead = 1; camp.plateFirst = true;\n    const w = createWorld({ seed: this.seed + this.i + this.loops * 10, account, camp, mode: 'attract' });\n    w.noPyx = true;\n    w.attractHp = 0.35;\n    for (const [seat, cls] of seats.entries()) {\n      const d = cheatHero(newHeroData(cls, CLASSES[cls].name, `attract${seat}`), cls);\n      d.gear.main = makeItem(w.lootRng, { slot: 'main', rarity: 'legendary', ilvl: 25, cls, legendary: { bellwarden: 'widows_clapper', lamplighter: 'last_wick', sexton: 'second_best_crook' }[cls] });\n      for (const slot of ['head', 'shoulders', 'chest']) d.gear[slot] = makeItem(w.lootRng, { slot, rarity: 'reliquary', ilvl: 25, cls });\n      const h = addHero(w, d, seat, { navIndex: seat });\n      h.god = true;\n      h.attract = true;\n      h.isBot = true;\n    }\n    g.world = w;\n    g.input.seats = seats.map(() => ({ kind: 'bot', pad: null }));\n    return w;\n  }\n\n  next() {\n    const g = this.game;\n    this.i = (this.i + 1) % STOPS.length;\n    if (this.i === 0 && this.t > 0) this.loops++;\n    this.t = 0;\n    this.mems.clear();\n    const stop = STOPS[this.i];\n    this.visited.add(stop.id);\n    g.view.setWorld(null);\n    const go = (w) => { g.view.setWorld(w); this.flush(w); };\n    switch (stop.id) {\n      case 'town': {\n        const w = this.makeWorld(['lamplighter']);\n        loadZone(w, 'town', 0, 'start');\n        w.heroes[0].hidden = true;\n        go(w);\n        this.pan = w.objects.filter((o) => o.kind === 'npc').map((o) => ({ x: o.x, z: o.z, npc: o.npc }));\n        this.panI = 0;\n        this.panT = 0;\n        g.view.camOverride = this.pan.length ? { x: this.pan[0].x, z: this.pan[0].z, zoom: 1.2 } : null;\n        break;\n      }\n      case 'causeway': {\n        const w = this.makeWorld(['bellwarden']);\n        loadZone(w, 'causeway', 0, 'start');\n        go(w);\n        break;\n      }\n      case 'ossuary': {\n        const w = this.makeWorld(['sexton']);\n        loadZone(w, 'ossuary', 0, 'start');\n        go(w);\n        const h = w.heroes[0];\n        spawnElitePack(w, { x: h.x + 6, z: h.z }, w.zone.def.monsters, { kind: 'champion', type: 'rattlebones', aff: ['tolling'] });\n        this.bossSoon = true;\n        break;\n      }\n      case 'cloister': {\n        const w = this.makeWorld(['lamplighter']);\n        loadZone(w, 'cloister', 0, 'start');\n        go(w);\n        break;\n      }\n      case 'knell': {\n        const w = this.makeWorld(['bellwarden', 'lamplighter', 'sexton']);\n        loadZone(w, 'knell', 0, 'start');\n        startRun(w, { mods: ['crowded'] });\n        w.pendingZone = null;\n        loadZone(w, 'knell', 0, 'start');\n        w.run.total = 80;\n        go(w);\n        break;\n      }\n      case 'malison': {\n        const w = this.makeWorld(['bellwarden', 'sexton']);\n        loadZone(w, 'belfry', 3, 'start');\n        const z = w.zone;\n        const m = startBoss(w, 'malison', z.w / 2, z.h / 2, { noIntro: true });\n        m.hp = m.maxHp * 0.58;\n        go(w);\n        this.flush(w);\n        break;\n      }\n      default: break;\n    }\n    g.ctx.engine.screen.reveal('iris', {}).catch?.(() => {});\n    g.applyLook();\n  }\n\n  flush(w) {\n    const g = this.game;\n    g.drainEvents(w);\n    g.dispatchEvents();\n  }\n\n  fixed() {\n    const g = this.game;\n    const w = g.world;\n    if (!w) return;\n    const intents = [];\n    for (const h of w.heroes) {\n      let mem = this.mems.get(h.id);\n      if (!mem) { mem = newBotMemory(); this.mems.set(h.id, mem); }\n      h.res = h.stats.maxResTotal;\n      h.hp = h.stats.maxHp;\n      h.dead = false;\n      const stop = STOPS[this.i];\n      if (stop.id === 'town') { intents[h.seat] = { mx: 0, mz: 0, ax: 0, az: 0, aimed: 0, tgt: 0, held: 0, pressed: 0, goal: null }; continue; }\n      intents[h.seat] = botIntent(w, h, mem);\n    }\n    stepWorld(w, intents);\n    this.stepStop(w);\n    g.drainEvents(w);\n  }\n\n  stepStop(w) {\n    const stop = STOPS[this.i];\n    this.t += 1 / 60;\n    if (stop.id === 'causeway' && !this.dropped && this.t > 7) {\n      this.dropped = true;\n      const h = w.heroes[0];\n      dropItem(w, h, makeRolledItem(w.lootRng, h, 'legendary', 25), h.x + 3, h.z, 1);\n      spawnPlate(w, h.x + 7, h.z + 3);\n    }\n    if (stop.id === 'ossuary' && this.bossSoon && this.t > 10) {\n      this.bossSoon = false;\n      const h = w.heroes[0];\n      const p = { x: h.x + 5, z: h.z + 2 };\n      startBoss(w, 'bursar', w.zone.nav.walkable(p.x, p.z) ? p.x : h.x, w.zone.nav.walkable(p.x, p.z) ? p.z : h.z, { noIntro: true });\n      if (w.boss) w.boss.hp = w.boss.maxHp * 0.5;\n    }\n    if (stop.id === 'cloister' && !this.comets && this.t > 3) {\n      this.comets = true;\n      const h = w.heroes[0];\n      runOps(w, h, SKILLS.beacon.fx, { x: h.x, z: h.z, dx: 0, dz: 1, px: h.x, pz: h.z, sk: SKILLS.beacon });\n      runOps(w, h, SKILLS.long_nights_end.fx, { x: h.x, z: h.z, dx: 0, dz: 1, px: h.x, pz: h.z, sk: SKILLS.long_nights_end });\n    }\n    if (stop.id === 'knell' && w.run) {\n      if (this.t > 9 && w.run.state === 'fill') { w.run.meter = w.run.total - 1; }\n    }\n    if (stop.id === 'malison' && w.boss) {\n      const m = w.boss;\n      if (this.t > 11 && m.bossState.phase < 3 && m.hp > m.maxHp * 0.24) m.hp = m.maxHp * 0.24;\n      if (this.t > 16 && m.bossState.phase === 3 && !this.rang) {\n        this.rang = true;\n        const rope = w.objects.find((o) => o.kind === 'rope' && o.state === 0);\n        if (rope) { const h = w.heroes[0]; h.x = rope.x + 0.8; h.z = rope.z; }\n      }\n    }\n    if (this.t >= stop.dur) {\n      this.dropped = false; this.comets = false; this.bossSoon = false; this.rang = false;\n      this.next();\n    }\n  }\n\n  frame() {\n    const g = this.game;\n    const stop = STOPS[this.i];\n    if (stop?.id === 'town' && this.pan?.length) {\n      this.panT += g.lastRealDt;\n      const cur = this.pan[this.panI % this.pan.length];\n      const nxt = this.pan[(this.panI + 1) % this.pan.length];\n      const f = Math.min(1, this.panT / 5);\n      const s = f * f * (3 - 2 * f);\n      g.view.camOverride = { x: cur.x + (nxt.x - cur.x) * s, z: cur.z + (nxt.z - cur.z) * s, zoom: 1.2 };\n      if (!this.panSaid) {\n        this.panSaid = true;\n        const lines = BARKS[cur.npc] ?? [];\n        if (lines.length) g.hudSys.say(cur.npc, lines[0]);\n      }\n      if (this.panT >= 5) { this.panT = 0; this.panI++; this.panSaid = false; }\n    } else if (g.view.camOverride) g.view.camOverride = null;\n    if (g.input.anyInput && !g.touchOnly) {\n      if (g.input.idleFrames === 0) g.stopAttract();\n    }\n  }\n\n  drawOverlay(ui) {\n    const W = ui.w;\n    ui.text(W / 2, 14, 'DEMO', { color: 'sand', align: 'center', scale: 2 });\n    if (this.game.frame % 60 < 42) ui.text(W / 2, 34, this.game.touchOnly ? 'CONTROLLER OR KEYBOARD REQUIRED'.slice(0, Math.floor((W - 10) / 6)) : 'PRESS ANY BUTTON', { color: 'white', align: 'center' });\n    if (this.t < 2.5) ui.text(W / 2, ui.h / 2 - 40, TITLE, { color: 'sand', align: 'center', scale: W < 300 ? 2 : 3 });\n  }\n\n  stop() {\n    const g = this.game;\n    g.view.camOverride = null;\n    g.input.seats = [{ kind: 'kbm', pad: null }];\n  }\n}\n\nexport { PLAYABLE, SPEAKERS };\nEOF\ncat > game.js <<'EOF'\n// Diabellical: a gothic co-op action RPG. Entry point.\n// Controls: stick or WASD or click to move; Cross or click to attack; face buttons, R1, R2 or right\n// click and 1-4 for skills; L2 or Space to roll; L1 or Q to drink; E or Cross to use things.\nimport { Engine, LOOK_PRESETS, withUrlOptions } from './pixel-engine.js';\nimport { TITLE } from './src/data/meta.js';\nimport { DiabellicalGame, VIGNETTE_LOOK } from './src/modes/game.js';\n\nexport const createGame = (opts = {}) => new DiabellicalGame({ fixedSeed: 12345, noAutoStart: true, ...opts });\n\nconst isTouchOnly = () => typeof matchMedia !== 'undefined' && !matchMedia('(any-pointer: fine)').matches && (navigator.maxTouchPoints ?? 0) > 0;\n\nexport const ENGINE_OPTIONS = (touchOnly) => withUrlOptions({\n  container: document.getElementById('app'),\n  camera: { preset: 'iso', viewHeight: 11.5, pitch: 42, yaw: 45, minZoom: 0.5, maxZoom: 1.6 },\n  aspect: 'fill', quality: 'high', touch: false,\n  look: VIGNETTE_LOOK(0.3),\n  settings: { button: touchOnly ? 'top-right' : false },\n});\n\nfunction fatal(message) {\n  const app = document.getElementById('app');\n  const el = document.createElement('div');\n  el.style.cssText = 'position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#1a1c2c;color:#ffcd75;font:20px monospace;text-align:center;padding:24px';\n  const h = document.createElement('h1');\n  h.textContent = TITLE;\n  const p = document.createElement('p');\n  p.textContent = message;\n  el.append(h, p);\n  (app ?? document.body).appendChild(el);\n}\n\nasync function boot() {\n  const hub = typeof AIHub !== 'undefined' && AIHub.active;\n  if (hub) {\n    const { runHubSession } = await import('./src/net/hubflow.js');\n    await runHubSession(ENGINE_OPTIONS);\n    return;\n  }\n  const touchOnly = isTouchOnly();\n  try {\n    await Engine.start(new DiabellicalGame({ touchOnly }), ENGINE_OPTIONS(touchOnly));\n  } catch (e) {\n    fatal('This game needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox on Windows');\n    if (typeof window !== 'undefined') window.__BOOT_ERROR__ = String(e?.message ?? e);\n  }\n}\n\nif (typeof document !== 'undefined') await boot();\n\nexport { LOOK_PRESETS };\nEOF\nmkdir -p src/net; cat > src/net/hubflow.js <<'EOF'\nexport async function runHubSession() { /* filled in M6 */ }\nEOF\nsed -i 's/ \\/\\* filled in M6 \\*\\/ / /' src/net/hubflow.js\nnode tools/build.mjs --quiet 2>&1 | tail -n 12 | cut -c1-300; timeout 100 node check.mjs --headless game.js --out .scratch/check --keys Enter*2,Space*30 2>&1 | tail -n 6 | cut -c1-500","description":"Write shell, game core and attract, build, headless check","timeout":180000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22191,"cache_read_input_tokens":673559,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22191},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"74a13398-df38-49ac-bc09-f0d3ed7fa96a","uuid":"7ea5e514-80e4-4e35-a76c-419ae39170f0","timestamp":"2026-11-06T00:32:45.077Z","request_id":"req_011CgkjEuLU5fiR4KqHuxdb1","wire_tool_inputs":{"toolu_01YRrsdj2j4HBm8kdFUy8MGA":{"command":"cat > src/view/sets.js <<'EOF'\n// The shell's dioramas: the Belfry against a stormy sky, and three heroes on plinths.\nimport { buildModel, disposeObject, glowMaterial, groundFog, mergeStaticMeshes, PALETTE, Precipitation, Rng, setLookLayer, textureMap, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { PLAYABLE } from '../data/classes.js';\nimport { applyBiomeLight } from './zonebuild.js';\nimport { Actor, CLASS_BODY } from './actors.js';\nimport { MODELS } from './models/index.js';\n\nconst { BoxGeometry, Color, CylinderGeometry, Group, Mesh, PlaneGeometry, Vector3 } = THREE;\n\nexport class ShellSet {\n  constructor(view) {\n    this.view = view;\n    const ctx = view.ctx;\n    this.ctx = ctx;\n    this.root = new Group();\n    ctx.scene.add(this.root);\n    ctx.scene.background = new Color(PALETTE.ink);\n    applyBiomeLight(ctx.engine, ctx.scene, 'belfry');\n    ctx.engine.sun.intensity = 0.8;\n    ctx.engine.ambient.intensity = 1.1;\n    this.lights = [];\n    this.heroes = [];\n    this.t = 0;\n    this.rng = new Rng('shell');\n    this.buildMoor();\n    this.buildTower();\n    this.buildPlinths();\n    this.rain = new Precipitation({ kind: 'rain', count: 2000 });\n    this.rain.wind.set(2, -1);\n    this.root.add(this.rain);\n    this.mist = groundFog({ color: PALETTE.navy, top: 1.5, amount: 0.3 });\n    ctx.scene.fogNode = this.mist.node;\n    this.target = new Vector3(0, 6, 0);\n    this.mode = 'title';\n    this.selected = 0;\n    view.cam.set(0, 1, 0);\n    this.play('Idle');\n  }\n\n  buildMoor() {\n    const g = new PlaneGeometry(160, 160).rotateX(-Math.PI / 2);\n    const uv = g.attributes.uv;\n    for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) * 20, uv.getY(i) * 20);\n    const m = new Mesh(g, toonMaterial(PALETTE.slate, { map: textureMap('mud') }));\n    m.receiveShadow = true;\n    this.root.add(m);\n    const props = ['tombstone', 'dead-tree', 'tombstone', 'bones', 'rock', 'tombstone', 'stump'];\n    for (let i = 0; i < 46; i++) {\n      const id = this.rng.pick(props);\n      const a = this.rng.range(0, Math.PI * 2), r = this.rng.range(10, 34);\n      const o = buildModel(id, { catalog: MODELS, seed: i + 1 }).object;\n      o.position.set(Math.cos(a) * r, 0, Math.sin(a) * r);\n      o.rotation.y = this.rng.range(0, 6);\n      o.traverse((q) => { if (q.isMesh) { q.castShadow = true; q.receiveShadow = true; } });\n      this.root.add(o);\n    }\n  }\n\n  buildTower() {\n    const stone = toonMaterial(PALETTE.mist, { map: textureMap('ashlar') });\n    const dark = toonMaterial(PALETTE.ink);\n    const parts = [];\n    const block = (w, h, d, x, y, z, mat = stone) => {\n      const b = new BoxGeometry(w, h, d);\n      const uv = b.attributes.uv;\n      for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) * w * 0.5, uv.getY(i) * h * 0.5);\n      const m = new Mesh(b, mat);\n      m.position.set(x, y, z);\n      m.castShadow = true;\n      m.receiveShadow = true;\n      m.updateMatrixWorld();\n      parts.push(m);\n    };\n    block(14, 34, 14, 0, 17, 0);\n    block(16, 2, 16, 0, 2, 0);\n    block(15.5, 1, 15.5, 0, 14, 0);\n    block(15.5, 1, 15.5, 0, 26, 0);\n    block(10, 8, 10, 0, 38, 0);\n    block(5.5, 12, 0.6, 7.2, 22, 0, dark);\n    block(0.6, 12, 5.5, 0, 22, 7.2, dark);\n    block(4, 8, 0.6, 7.2, 8, 0, dark);\n    block(0.6, 8, 4, 0, 8, 7.2, dark);\n    for (const sx of [-1, 1]) for (const sz of [-1, 1]) block(1.6, 40, 1.6, sx * 6.8, 20, sz * 6.8);\n    const spire = new Mesh(new CylinderGeometry(0.2, 7.5, 16, 4), toonMaterial(PALETTE.night));\n    spire.position.set(0, 50, 0);\n    spire.rotation.y = Math.PI / 4;\n    spire.updateMatrixWorld();\n    parts.push(spire);\n    for (const m of mergeStaticMeshes(parts)) this.root.add(m);\n    const bell = buildModel('old_clemency', { catalog: MODELS }).object;\n    bell.position.set(7.4, 19, 7.4);\n    bell.scale.setScalar(0.85);\n    bell.traverse((q) => { if (q.isMesh) q.castShadow = true; });\n    this.root.add(bell);\n    this.bell = bell;\n    this.lights.push(this.ctx.lights.request({ position: [10, 24, 10], color: 0x60e0f0, intensity: 22, radius: 22, priority: 2 }));\n    this.lights.push(this.ctx.lights.request({ position: [10, 3, 10], color: 0xff9040, intensity: 18, radius: 18, flicker: 'torch', priority: 2 }));\n  }\n\n  buildPlinths() {\n    // Three heroes in a torchlit room, far enough from the tower to have the screen to themselves.\n    const base = new Vector3(40, 0, 40);\n    this.plinthBase = base;\n    const stone = toonMaterial(PALETTE.mist, { map: textureMap('flagstones') });\n    const floor = new Mesh(new BoxGeometry(18, 0.6, 12), stone);\n    floor.position.set(base.x, 0.02, base.z);\n    floor.receiveShadow = true;\n    this.root.add(floor);\n    const back = new Mesh(new BoxGeometry(18, 7, 0.8), toonMaterial(PALETTE.slate, { map: textureMap('ashlar') }));\n    back.position.set(base.x - 3, 3.5, base.z - 4.5);\n    back.rotation.y = -Math.PI / 4 * 0;\n    this.root.add(back);\n    const positions = [[-3.2, 0.6], [0, 0], [3.2, -0.6]];\n    PLAYABLE.forEach((cls, i) => {\n      const [dx, dz] = positions[i];\n      const x = base.x + dx, z = base.z + dz;\n      const pl = new Mesh(new CylinderGeometry(0.85, 1, 0.5, 8), toonMaterial(PALETTE.plum));\n      pl.position.set(x, 0.55, z);\n      pl.castShadow = true;\n      pl.receiveShadow = true;\n      this.root.add(pl);\n      const a = new Actor(this.view, { id: `hero${i}`, type: cls, body: CLASS_BODY[cls], def: { r: 0.45 }, x, z, isHero: true });\n      a.root.position.y = 0.8;\n      a.setGear({ main: { bellwarden: 'hand-bell-weapon', lamplighter: 'staff', sexton: 'shovel' }[cls], off: cls === 'lamplighter' ? 'hand-lantern' : '', head: 'blessed', shoulders: 'blessed' }, cls);\n      this.heroes.push({ a, cls, x, z });\n      this.lights.push(this.ctx.lights.request({ position: [x + 0.5, 2.8, z + 1.2], color: 0xffb060, intensity: 9, radius: 7, flicker: 'torch', priority: 2 }));\n      const t = buildModel('standing-torch', { catalog: MODELS }).object;\n      t.position.set(x + 1.6, 0.3, z - 1.2);\n      this.root.add(t);\n    });\n  }\n\n  setMode(mode, selected = 0) {\n    this.mode = mode;\n    if (this.selected !== selected || mode === 'select') {\n      this.selected = selected;\n      this.play('Triumph');\n    }\n  }\n\n  play() {\n    this.heroes.forEach((h, i) => { if (i === this.selected) h.a.play('Triumph', 1); });\n  }\n\n  update(dt, realDt) {\n    this.t += realDt;\n    const view = this.view;\n    if (this.mode === 'title') {\n      // A slow pan up the Belfry.\n      const a = this.t * 0.04;\n      view.cam.set(4 + Math.sin(a) * 3, 1, 4 + Math.cos(a) * 3);\n      this.camY = 12 + Math.sin(this.t * 0.05) * 4;\n      view.camOverride = { x: view.cam.x, z: view.cam.z, zoom: 0.62 };\n    } else {\n      const h = this.heroes[this.selected] ?? this.heroes[1];\n      view.camOverride = { x: h.x * 0.5 + this.plinthBase.x * 0.5, z: h.z * 0.5 + this.plinthBase.z * 0.5, zoom: 1.5 };\n    }\n    for (const h of this.heroes) { h.a.sync(h.x, h.z, Math.PI / 4, false, 0, dt); h.a.root.position.y = 0.8; h.a.shadow.visible = false; }\n    this.rain.update(dt, view.cam);\n    if (this.bell) this.bell.rotation.z = Math.sin(this.t * 0.6) * 0.05;\n    if (Math.floor(this.t * 8) % 3 === 0) view.ctx.particles.burst('ember_drift', [view.cam.x + this.rng.range(-12, 12), this.rng.range(0.5, 10), view.cam.z + this.rng.range(-12, 12)]);\n    view.updateCamera(realDt);\n  }\n\n  dispose() {\n    for (const l of this.lights) l.release();\n    for (const h of this.heroes) h.a.remove();\n    this.rain.dispose();\n    if (this.ctx.scene.fogNode === this.mist.node) this.ctx.scene.fogNode = null;\n    this.ctx.scene.remove(this.root);\n    disposeObject(this.root);\n    this.view.camOverride = null;\n  }\n}\n\nexport { glowMaterial, setLookLayer };\nEOF\ncat > src/ui/menus/shell.js <<'EOF'\n// Title, main menu, hero select, new hero, and the touch-only notice.\nimport { CLASSES, HERO_NAMES, PLAYABLE } from '../../data/classes.js';\nimport { TITLE } from '../../data/meta.js';\nimport { SKILLS } from '../../data/skills.js';\nimport { DIFFICULTIES } from '../../data/tuning.js';\nimport { icon } from '../icons.js';\nimport { Screen } from './base.js';\nimport { AboutScreen, SettingsScreen } from './pause.js';\n\nfunction bigTitle(ui, y = 30) {\n  const W = ui.w;\n  const scale = W < 300 ? 2 : W < 440 ? 4 : 5;\n  ui.text(W / 2 + 1, y + 1, TITLE, { color: 'plum', scale, align: 'center', shadow: false });\n  ui.text(W / 2, y, TITLE, { color: 'sand', scale, align: 'center', shadow: 'ink' });\n  return y + 7 * scale + 8;\n}\n\nexport class TitleScreen extends Screen {\n  constructor(game) { super(game, { tag: 'title', freeze: false }); }\n  draw(ui) {\n    const g = this.game;\n    const y = bigTitle(ui);\n    ui.text(ui.w / 2, y, 'THE BELL IS CRACKED. THE DEAD ARE UP. SO ARE YOU.', { color: 'mist', align: 'center' });\n    if (g.frame % 60 < 42) ui.text(ui.w / 2, ui.h - 40, 'PRESS ANY BUTTON', { color: 'white', align: 'center', scale: 1 });\n    if (g.ctx.audio.unlocked === false && g.input.lastDevice === 'pad') ui.text(ui.w / 2, ui.h - 26, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'slate', align: 'center' });\n    const m = g.input.menu;\n    if (m.anyPress || m.confirm || m.click) { g.audioSys?.sfx('bell_small'); g.openMainMenu(); }\n  }\n  back() {}\n}\n\nexport class MainMenu extends Screen {\n  constructor(game) { super(game, { tag: 'menu', freeze: false }); }\n  draw(ui) {\n    const g = this.game;\n    bigTitle(ui, 18);\n    const hasHero = g.save.heroes.some(Boolean);\n    const knell = g.save.account.unlocks.knell;\n    const items = [\n      ['CONTINUE', () => g.openScreen(new HeroSelect(g)), !hasHero],\n      ['NEW HERO', () => g.openScreen(new NewHero(g)), false],\n      ['KNELL RUNS', () => g.openScreen(new HeroSelect(g, { knell: true })), !knell || !hasHero],\n      ['SETTINGS', () => g.openScreen(new SettingsScreen(g)), false],\n      ['ABOUT', () => g.openScreen(new AboutScreen(g)), false],\n    ];\n    const bw = 140, bh = 18;\n    const x = Math.floor(ui.w / 2 - bw / 2);\n    const y0 = Math.floor(ui.h * 0.42);\n    items.forEach(([label, act, disabled], i) => {\n      if (ui.button(`menu:${label}`, x, y0 + i * (bh + 3), bw, bh, label, { disabled })) act();\n    });\n    if (!hasHero) ui.preferFocus = 'menu:NEW HERO';\n    if (!knell) ui.text(x + bw + 6, y0 + 2 * (bh + 3) + 5, 'AFTER THE CREDITS', { color: 'slate' });\n    ui.footer([['confirm', 'CHOOSE']]);\n  }\n  back() { this.game.closeScreen(); }\n}\n\nconst namePick = (g) => HERO_NAMES[Math.floor(g.uiRng.next() * HERO_NAMES.length)];\n\nexport class NewHero extends Screen {\n  constructor(game) {\n    super(game, { tag: 'newhero', freeze: false });\n    this.cls = 1;\n    this.name = namePick(game);\n    this.diff = 0;\n    this.step = 'class';\n  }\n  onOpen() { this.game.shellSet?.setMode('select', this.cls); }\n  onClose() { this.game.shellSet?.setMode('title', 0); }\n  back() {\n    if (this.step === 'start') { this.step = 'class'; return; }\n    this.game.closeScreen();\n  }\n  draw(ui) {\n    const g = this.game;\n    const W = ui.w, H = ui.h;\n    if (this.step === 'class') {\n      const cls = CLASSES[PLAYABLE[this.cls]];\n      ui.rect(0, H - 94, W, 94, 'ink');\n      ui.rect(0, H - 95, W, 1, 'slate');\n      ui.text(14, 12, 'A NEW HERO', { color: 'sand', scale: 2 });\n      // Class buttons.\n      PLAYABLE.forEach((id, i) => {\n        const bw = 100;\n        const r = ui.button(`class:${id}`, 14 + i * (bw + 3), H - 90, bw, 16, CLASSES[id].name, { color: i === this.cls ? 'sand' : 'mist' });\n        if (ui.focus === `class:${id}` && this.cls !== i) { this.cls = i; g.shellSet?.setMode('select', i); }\n        if (r) { this.step = 'start'; ui.preferFocus = 'start:begin'; }\n      });\n      ui.textBlock(14, H - 70, cls.blurb, W - 150, { color: 'white', lineH: 9 });\n      ui.textBlock(14, H - 50, cls.style, W - 150, { color: 'mist', lineH: 9 });\n      // Signature skills.\n      cls.signature.forEach((sid, i) => {\n        const sk = SKILLS[sid];\n        const ic = icon(sk.icon);\n        ui.sprite(W - 130, H - 88 + i * 16, ic.rows, ic.colors);\n        ui.text(W - 114, H - 86 + i * 16, sk.name, { color: 'sand' });\n      });\n      ui.text(W - 130, H - 38, `RESOURCE: ${cls.res}`, { color: 'mist' });\n      ui.footer([['confirm', 'THIS ONE'], ['back', 'BACK']]);\n      return;\n    }\n    // Name, difficulty, start point.\n    ui.rect(0, H - 124, W, 124, 'ink');\n    ui.rect(0, H - 125, W, 1, 'slate');\n    ui.text(14, 12, CLASSES[PLAYABLE[this.cls]].name, { color: 'sand', scale: 2 });\n    const y = H - 118;\n    ui.text(14, y + 3, 'NAME', { color: 'mist' });\n    ui.text(50, y + 3, this.name, { color: 'white' });\n    if (ui.button('new:shuffle', 150, y, 74, 13, 'ANOTHER')) { this.name = namePick(g); }\n    ui.text(14, y + 19, 'DIFFICULTY', { color: 'mist' });\n    const diffs = DIFFICULTIES.filter((d) => !d.penance || g.save.account.unlocks.penance);\n    const label = DIFFICULTIES[this.diff].name;\n    const dr = ui.widget('new:diff', 80, y + 16, 110, 13);\n    ui.rect(80, y + 16, 110, 13, dr.focused ? 'plum' : 'night');\n    ui.text(135, y + 19, `< ${label} >`, { color: 'sand', align: 'center' });\n    const m = g.input.menu;\n    if ((dr.focused && m.right) || dr.activated) this.diff = (this.diff + 1) % diffs.length;\n    if (dr.focused && m.left) this.diff = (this.diff - 1 + diffs.length) % diffs.length;\n    const slot = g.save.heroes.findIndex((h) => !h);\n    if (slot < 0) ui.text(200, y + 19, 'ALL THREE SLOTS FULL', { color: 'red' });\n    const bw = Math.floor((W - 28 - 4) / 2);\n    const by = y + 34;\n    if (ui.button('start:begin', 14, by, bw, 30, 'THE BEGINNING', { disabled: slot < 0, color: 'white' })) { g.startNewHero(PLAYABLE[this.cls], this.name, this.diff, 'beginning'); return; }\n    if (ui.button('start:last', 14 + bw + 4, by, bw, 30, 'THE LAST BELL', { disabled: slot < 0, color: 'orange' })) { g.startNewHero(PLAYABLE[this.cls], this.name, this.diff, 'lastbell'); return; }\n    ui.textBlock(14, by + 33, 'THE STORY, FROM YOUR OWN GRAVE.', bw, { color: 'mist', lineH: 9 });\n    ui.textBlock(14 + bw + 4, by + 33, 'LEVEL 30, EVERY SKILL, LEGENDARIES, KEYS. THE WHOLE ENDGAME AT ONCE.', bw, { color: 'mist', lineH: 9 });\n    ui.footer([['confirm', 'BEGIN'], ['back', 'BACK']]);\n  }\n}\n\nexport class HeroSelect extends Screen {\n  constructor(game, o = {}) { super(game, { tag: 'heroselect', freeze: false }); this.knell = !!o.knell; this.hold = 0; }\n  onClose() { this.game.shellSet?.setMode('title', 0); }\n  onOpen() { const first = this.game.save.heroes.findIndex(Boolean); const s = this.game.save.heroes[first]; this.game.shellSet?.setMode('select', PLAYABLE.indexOf(s?.data?.cls ?? 'lamplighter')); }\n  draw(ui) {\n    const g = this.game;\n    const W = ui.w, H = ui.h;\n    ui.rect(0, H - 96, W, 96, 'ink');\n    ui.rect(0, H - 97, W, 1, 'slate');\n    ui.text(14, 12, this.knell ? 'WHO RUNS THE KNELL?' : 'WHO GETS UP?', { color: 'sand', scale: 2 });\n    const bw = Math.floor((W - 28 - 8) / 3);\n    g.save.heroes.forEach((s, i) => {\n      const x = 14 + i * (bw + 4), y = H - 90;\n      const r = ui.widget(`hero:${i}`, x, y, bw, 58, { disabled: !s });\n      ui.rect(x, y, bw, 58, r.focused ? 'sand' : s ? 'slate' : 'night');\n      ui.rect(x + 1, y + 1, bw - 2, 56, r.focused ? 'plum' : 'ink');\n      if (s) {\n        const d = s.data;\n        ui.text(x + 5, y + 4, d.name, { color: 'white' });\n        ui.text(x + 5, y + 14, `LV ${d.level} ${CLASSES[d.cls].name}`.slice(0, Math.floor((bw - 8) / 6)), { color: CLASSES[d.cls].color });\n        ui.text(x + 5, y + 24, DIFFICULTIES[s.camp?.difficulty ?? 0].name, { color: 'mist' });\n        ui.text(x + 5, y + 34, s.camp?.credits ? 'THE BELL RANG TRUE' : (s.camp?.zone ?? 'yard').toUpperCase().slice(0, Math.floor((bw - 8) / 6)), { color: 'slate' });\n        if (r.focused) {\n          g.shellSet?.setMode('select', PLAYABLE.indexOf(d.cls));\n          const m = g.input.menu;\n          if (m.ctxA) this.delTarget = i;\n          const held = m.ctxA || (g.input.input.isDown('KeyX') || g.input.pads.some((p) => p?.b?.[2]));\n          if (held && this.delTarget === i) {\n            this.hold += g.lastRealDt;\n            ui.rect(x + 1, y + 54, (bw - 2) * Math.min(1, this.hold / 1.5), 3, 'red');\n            if (this.hold >= 1.5) { g.deleteHero(i); this.hold = 0; this.delTarget = null; }\n          } else if (!held) { this.hold = 0; this.delTarget = null; }\n        }\n        if (r.activated) { g.continueHero(i, { knell: this.knell }); return; }\n      } else ui.text(x + bw / 2, y + 24, 'AN EMPTY GRAVE', { color: 'slate', align: 'center' });\n    });\n    ui.footer([['confirm', 'THIS ONE'], ['ctxA', 'HOLD TO BURY'], ['back', 'BACK']]);\n  }\n}\n\nexport class TouchNotice extends Screen {\n  constructor(game) { super(game, { tag: 'touch', freeze: false }); }\n  draw(ui) {\n    const W = ui.w;\n    const y = bigTitle(ui, 20);\n    const lines = ui.wrap('CONTROLLER OR KEYBOARD REQUIRED', W - 16);\n    ui.rect(0, y + 2, W, lines.length * 10 + 8, 'ink');\n    lines.forEach((l, i) => ui.text(W / 2, y + 6 + i * 10, l, { color: 'white', align: 'center' }));\n    ui.text(W / 2, ui.h - 16, 'DEMO', { color: 'sand', align: 'center' });\n  }\n  back() {}\n}\nEOF\ncat > src/modes/game.js <<'EOF'\n// The Game object: one for the whole session. Zones swap inside it, so recordings cover everything.\nimport { Rng, THREE, LOOK_PRESETS, MODEL_LIBRARY } from '../../pixel-engine.js';\nimport { AudioSys } from '../audio/audio.js';\nimport { CLASSES, PLAYABLE } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { QUESTS } from '../data/quests.js';\nimport { InputRouter } from '../input/router.js';\nimport { defaultSettings, emptySave, HERO_SLOTS, readSave, writeSave } from '../save/save.js';\nimport { botAfter, botIntent, botManage, newBotMemory } from '../sim/bot.js';\nimport { applyCommand } from '../sim/commands.js';\nimport { addHero, heroToData, newHeroData, recalcHero, gearLook } from '../sim/hero.js';\nimport { emptyIntent } from '../sim/intents.js';\nimport { makeItem, makeRolledItem } from '../sim/loot.js';\nimport { newCampaign, questInit, ensurePyx } from '../sim/quests.js';\nimport { loadZone } from '../sim/travel.js';\nimport { beginCampaign, createWorld, stepWorld, worldHash } from '../sim/world.js';\nimport { AttractTour } from './attract.js';\nimport { DevOverlays } from '../ui/devoverlays.js';\nimport { HudSys } from '../ui/hud.js';\nimport { DeathScreen, Cutscene, DialogueScreen, KnellScreen, LoreScreen, MapScreen, ResultsScreen, STORY, WritsScreen } from '../ui/menus/world.js';\nimport { HeroScreen } from '../ui/menus/hero.js';\nimport { PauseScreen, LOOKS } from '../ui/menus/pause.js';\nimport { MainMenu, TitleScreen, TouchNotice } from '../ui/menus/shell.js';\nimport { StashScreen } from '../ui/menus/vendors.js';\nimport { UI } from '../ui/ui.js';\nimport { ShellSet } from '../view/sets.js';\nimport { View } from '../view/view.js';\nimport { STORY_LINES } from '../data/dialog.js';\nimport { gemId } from '../data/items.js';\nimport { SET_BY_CLASS } from '../data/items.js';\nimport { SKILLS } from '../data/skills.js';\n\nconst { Vector3 } = THREE;\nexport const VIGNETTE_LOOK = (v) => ({ scene: [{ id: 'vignette', params: { intensity: v } }] });\n\nexport class DiabellicalGame {\n  name = TITLE;\n\n  constructor(opts = {}) {\n    this.opts = opts;\n    this.frame = 0;\n    this.frameTime = 0;\n    this.lastRealDt = 1 / 60;\n    this.world = null;\n    this.screens = [];\n    this.mode = 'boot';\n    this.botSeats = new Set();\n    this.botMem = new Map();\n    this.pendingEvents = [];\n    this.isSession = false;\n    this.isClient = false;\n    this.seed = opts.seed ?? 1;\n    this.settings = defaultSettings();\n    this.save = emptySave();\n    this.overlays = { nav: false, hit: false, ai: false, spawn: false, flow: false, state: false };\n    this.overlaysOn = false;\n    this.devTimeScale = 1;\n    this.camTarget = new Vector3();\n    this.uiRng = new Rng(`ui:${opts.seed ?? 1}`);\n    this.labelsHeld = false;\n    this.touchOnly = !!opts.touchOnly;\n    this.currentSlot = -1;\n    this.autosaveT = 0;\n    this.pxScale = 4;\n    this.attract = null;\n  }\n\n  async setup(ctx) {\n    this.ctx = ctx;\n    this.audioSys = new AudioSys(this, ctx);\n    this.input = new InputRouter(this, ctx);\n    this.view = new View(this, ctx);\n    this.ui = new UI(this, ctx);\n    this.hudSys = new HudSys(this, ctx);\n    this.devOverlays = new DevOverlays(this);\n    if (this.opts.onSetup) await this.opts.onSetup(this, ctx);\n    if (!this.opts.hub) {\n      this.loadSaveData();\n      this.enterShell();\n    }\n  }\n\n  ready() {\n    if (typeof window !== 'undefined') window.__GAME__ = this;\n    this.computeScale();\n  }\n\n  computeScale() {\n    try {\n      const v = this.ctx.engine.renderer.viewport;\n      this.pxScale = (v?.width ?? 960) / this.ctx.hud.width;\n    } catch { this.pxScale = 4; }\n  }\n\n  loadSaveData() {\n    const s = readSave();\n    if (s) this.save = s;\n    this.settings = { ...this.settings, ...this.save.settings };\n    this.save.settings = this.settings;\n    this.audioSys.voicesVol = this.settings.voices ?? 1;\n  }\n\n  saveSettings() { writeSave(this.save); }\n\n  resetSettings() {\n    this.save.settings = defaultSettings();\n    this.settings = this.save.settings;\n    this.ctx.audio.resetVolumes();\n    this.ctx.engine.settings.reset();\n    this.audioSys.voicesVol = 1;\n    this.applyLook();\n    this.saveSettings();\n  }\n\n  applyLook() {\n    const i = this.settings.lookIndex ?? 0;\n    const id = LOOKS[i][1];\n    if (id) this.ctx.engine.setLook(LOOK_PRESETS[id]);\n    else this.ctx.engine.setLook(VIGNETTE_LOOK(0.3));\n  }\n\n  applyVignette(v) {\n    if ((this.settings.lookIndex ?? 0) !== 0) return;\n    this.ctx.engine.setLook(VIGNETTE_LOOK(v));\n  }\n\n  toggleFullscreen() {\n    if (typeof document === 'undefined') return;\n    try {\n      if (document.fullscreenElement) { const p = document.exitFullscreen(); if (p?.catch) p.catch(() => {}); }\n      else { const p = document.documentElement.requestFullscreen?.(); if (p?.catch) p.catch(() => {}); }\n    } catch { /* browsers may refuse */ }\n  }\n\n  // ---- Shell -------------------------------------------------------------------------------\n  enterShell() {\n    this.mode = 'shell';\n    this.closeAll();\n    this.teardownWorld();\n    if (!this.shellSet) this.shellSet = new ShellSet(this.view);\n    this.shellSet.setMode('title', 0);\n    this.audioSys.music('vespers');\n    this.ctx.engine.timeScale = 1;\n    if (this.touchOnly) { this.openScreen(new TouchNotice(this)); this.startAttract(false); return; }\n    this.openScreen(new TitleScreen(this));\n    this.idleSeen = 0;\n  }\n\n  openMainMenu() {\n    this.closeScreen();\n    this.openScreen(new MainMenu(this));\n  }\n\n  // ---- Screens -----------------------------------------------------------------------------\n  openScreen(s) {\n    if (this.screens.length) this.screens[this.screens.length - 1].savedFocus = this.ui?.focus;\n    this.screens.push(s);\n    s.onOpen?.();\n    this.ui.focus = null;\n    this.input.input.clearQueued();\n  }\n\n  closeScreen() {\n    const s = this.screens.pop();\n    if (s) { s.onClose?.(); this.audioSys?.sfx('ui_back'); }\n    const top = this.screens[this.screens.length - 1];\n    if (top?.savedFocus) this.ui.focus = top.savedFocus;\n    this.input.input.clearQueued();\n    if (!this.screens.length) this.menuSeat = null;\n  }\n\n  closeAll() {\n    while (this.screens.length) { const s = this.screens.pop(); s.onClose?.(); }\n    this.menuSeat = null;\n  }\n\n  topScreen() { return this.screens[this.screens.length - 1] ?? null; }\n  menuHero() {\n    const seat = this.menuSeat ?? this.localSeats()[0] ?? 0;\n    return this.world?.heroes.find((h) => h.seat === seat) ?? this.world?.heroes[0] ?? null;\n  }\n\n  // ---- Heroes and seats --------------------------------------------------------------------\n  localSeats() {\n    if (this.net?.seat !== undefined) return this.net.seat === null ? [] : [this.net.seat];\n    return this.input.seats.map((_, i) => i).filter((i) => this.world?.heroes.some((h) => h.seat === i && !h.gone));\n  }\n  isLocalSeat(seat) { return this.localSeats().includes(seat); }\n  isLocalLoot(owner) { return owner < 0 || this.isLocalSeat(owner) || this.botSeats.has(owner) || this.attract; }\n  isCameraSeat(seat) { return this.localSeats().includes(seat) || !!this.attract; }\n  humanCount() { return this.world ? this.world.heroes.filter((h) => !h.gone && !h.companion).length : 1; }\n  localHero() { const s = this.localSeats()[0] ?? 0; return this.world?.heroes.find((h) => h.seat === s) ?? null; }\n  freePads() { const out = []; for (let i = 0; i < this.input.pads.length; i++) if (this.input.pads[i] && this.input.seatOfPad(i) < 0) out.push(i); return out; }\n\n  onPadSeen(i) {\n    if (this.mode === 'play' && this.input.seats[0].pad !== null && this.input.seatOfPad(i) < 0) this.hudSys.toast('A NEW CONTROLLER. PRESS OPTIONS ON IT TO JOIN.', 'sky', { life: 5 });\n    else if (this.mode === 'play' && i > 0) this.hudSys.toast('A NEW CONTROLLER. PRESS OPTIONS ON IT TO JOIN.', 'sky', { life: 5 });\n  }\n\n  joinSeat(pad, cls) {\n    const w = this.world;\n    const seat = this.input.seats.length;\n    if (seat > 3 || !w) return null;\n    const d = this.save.guests[cls] ?? newHeroData(cls, `GUEST ${seat + 1}`, `guest:${cls}`);\n    const lead = w.heroes.find((h) => h.seat === 0);\n    d.level = Math.max(d.level, lead?.level ?? 1);\n    d.skills = CLASSES[cls].preset.map(([id]) => (d.level >= SKILLS[id].level ? { id, tone: null } : null));\n    this.input.seats.push({ kind: 'pad', pad });\n    const h = addHero(w, d, seat, { navIndex: seat, guest: true, x: (lead?.x ?? 0) + 1, z: (lead?.z ?? 0) + 1 });\n    if (!w.zone.nav.walkable(h.x, h.z)) { h.x = lead.x; h.z = lead.z; }\n    ensurePyx(w);\n    this.hudSys.toast(`P${seat + 1} JOINS AS ${CLASSES[cls].name}`, 'sky', { big: true });\n    this.audioSys.sfx('bell_mid');\n    return h;\n  }\n\n  leaveSeat(seat) {\n    const w = this.world;\n    const h = w.heroes.find((o) => o.seat === seat);\n    if (!h) return;\n    this.save.guests[h.cls] = heroToData(h);\n    h.gone = true;\n    w.heroes.splice(w.heroes.indexOf(h), 1);\n    this.view.ev_hero_gone({ id: h.id });\n    this.input.seats.splice(seat, 1);\n    for (const o of w.heroes) if (!o.companion && o.seat > seat) o.seat--;\n    ensurePyx(w);\n    this.hudSys.toast(`P${seat + 1} LEAVES`, 'mist');\n    this.botSeats.delete(seat);\n  }\n  leaveLastSeat() { const n = this.input.seats.length - 1; if (n > 0) this.leaveSeat(n); }\n\n  addBotSeat() {\n    const w = this.world;\n    const seat = this.input.seats.length;\n    if (seat > 3) return;\n    const cls = PLAYABLE[seat % 3];\n    const lead = w.heroes.find((h) => h.seat === 0);\n    const d = newHeroData(cls, `BOT ${seat + 1}`, `bot${seat}`);\n    d.level = lead.level;\n    this.input.seats.push({ kind: 'bot', pad: null });\n    const h = addHero(w, d, seat, { navIndex: seat, x: lead.x + 1, z: lead.z + 1 });\n    if (!w.zone.nav.walkable(h.x, h.z)) { h.x = lead.x; h.z = lead.z; }\n    this.botSeats.add(seat);\n    botManage(w, h, this.memOf(h));\n  }\n  removeBotSeat() { for (let s = this.input.seats.length - 1; s > 0; s--) if (this.botSeats.has(s)) { this.leaveSeat(s); return; } }\n  toggleBot(seat) { if (this.botSeats.has(seat)) this.botSeats.delete(seat); else this.botSeats.add(seat); }\n  memOf(h) { let m = this.botMem.get(h.id); if (!m) { m = newBotMemory(); this.botMem.set(h.id, m); } return m; }\n\n  // ---- Starting play -----------------------------------------------------------------------\n  startNewHero(cls, name, difficulty, start) {\n    const slot = this.save.heroes.findIndex((h) => !h);\n    if (slot < 0) return;\n    const seed = this.newSeed();\n    const data = newHeroData(cls, name, `hero${slot}:${seed}`);\n    const camp = newCampaign();\n    camp.seed = seed;\n    camp.difficulty = difficulty;\n    this.save.heroes[slot] = { data, camp };\n    this.currentSlot = slot;\n    if (start === 'lastbell') this.prepareLastBell(this.save.heroes[slot], seed);\n    writeSave(this.save);\n    this.launchPlay(this.save.heroes[slot], { start });\n  }\n\n  newSeed() {\n    if (typeof crypto !== 'undefined' && crypto.getRandomValues && !this.opts.fixedSeed) { const a = new Uint32Array(1); crypto.getRandomValues(a); return a[0] % 1000000; }\n    return this.opts.fixedSeed ?? 12345;\n  }\n\n  /** A level 30 hero with the whole endgame in reach. */\n  prepareLastBell(slot, seed) {\n    const d = slot.data;\n    const rng = new Rng(`lastbell:${seed}`);\n    d.level = 30;\n    const cls = CLASSES[d.cls];\n    d.skills = cls.skills.slice(2, 8).map((id) => ({ id, tone: Object.keys(SKILLS[id].tones)[0] }));\n    d.skills[0] = { id: cls.skills[0], tone: Object.keys(SKILLS[cls.skills[0]].tones)[0] };\n    d.vows = [null, null];\n    const stub = { cls: d.cls };\n    const set = SET_BY_CLASS[d.cls];\n    for (const slotId of ['main', 'off', 'head', 'shoulders', 'chest', 'hands', 'legs', 'feet', 'amulet', 'ring']) {\n      d.gear[slotId] = makeItem(rng, { slot: slotId, rarity: 'reliquary', ilvl: 30, cls: d.cls, forceSocket: slotId === 'main' || slotId === 'chest' });\n    }\n    d.gear.head = makeItem(rng, { slot: 'head', rarity: 'set', ilvl: 30, cls: d.cls, set });\n    d.gear.chest = makeItem(rng, { slot: 'chest', rarity: 'set', ilvl: 30, cls: d.cls, set, forceSocket: true });\n    d.inv[0] = makeRolledItem(rng, stub, 'legendary', 30);\n    d.inv[1] = makeRolledItem(rng, stub, 'legendary', 30);\n    d.inv[2] = makeRolledItem(rng, stub, 'legendary', 30);\n    d.gear.main = makeItem(rng, { rarity: 'legendary', ilvl: 30, cls: d.cls, legendary: { bellwarden: 'widows_clapper', lamplighter: 'last_wick', sexton: 'second_best_crook' }[d.cls], forceSocket: true });\n    d.mats = { scrap: 40, dust: 20, shards: 12 };\n    d.gold = 60000;\n    d.grandKeys = 1;\n    d.gems = { [gemId('ember', 1)]: 3, [gemId('salt', 1)]: 3, [gemId('amber', 1)]: 3, [gemId('ember', 0)]: 3 };\n    const c = slot.camp;\n    c.q = { i: QUESTS.length, s: 0 };\n    c.credits = true;\n    c.zone = 'town';\n    c.floor = 0;\n    Object.assign(c.flags, { open_causeway: 1, open_ossuary: 1, open_cloister: 1, open_belfry: 1, forge: 1, reliquary: 1, brasse_met: 1, brasse_home: 1, crier_met: 1, pyx: 1, overdue_open: 1, wagon_home: 1, malison_dead: 1, yard_coffin: 1, bursar_dead: 1, ambrose_dead: 1 });\n    c.plateFirst = true;\n    const a = this.save.account;\n    a.unlocks.knell = true;\n    a.unlocks.penance = true;\n    a.devotion.points += 5;\n    a.devotion.level = Math.max(a.devotion.level, 5);\n  }\n\n  continueHero(i, o = {}) {\n    const slot = this.save.heroes[i];\n    if (!slot) return;\n    this.currentSlot = i;\n    this.launchPlay(slot, { start: o.knell ? 'knell' : 'continue' });\n  }\n\n  deleteHero(i) {\n    this.save.heroes[i] = null;\n    writeSave(this.save);\n    this.audioSys.sfx('coffin_slam');\n  }\n\n  launchPlay(slot, o = {}) {\n    this.closeAll();\n    this.leaveShell();\n    this.input.seats = [{ kind: 'kbm', pad: this.input.seats[0]?.pad ?? null }];\n    const camp = slot.camp;\n    const seed = camp.seed ?? this.newSeed();\n    camp.seed = seed;\n    this.seed = seed;\n    const w = createWorld({ seed, difficulty: camp.difficulty ?? 0, account: this.save.account, camp });\n    w.mode = 'campaign';\n    this.world = w;\n    this.mode = 'play';\n    this.view.setWorld(w);\n    const fresh = o.start === 'beginning';\n    addHero(w, slot.data, 0, { navIndex: 0 });\n    let zone = camp.zone ?? 'yard', floor = camp.floor ?? 0;\n    if (o.start === 'knell') { zone = 'town'; floor = 0; }\n    if (w.camp.credits && zone === 'belfry') { zone = 'town'; floor = 0; }\n    loadZone(w, zone, floor, 'start');\n    this.flushEvents();\n    this.applyLook();\n    if (fresh) {\n      questInit(w);\n      this.flushEvents();\n      this.openScreen(new Cutscene(this, { ...STORY.opening() }));\n    } else if (o.start === 'lastbell') {\n      this.hudSys.toast('THE LAST BELL: THE WHOLE ENDGAME IS OPEN. SPEND YOUR DEVOTION.', 'sand', { life: 6 });\n      this.hudSys.toast('THE KNELL FONT IS IN THE SQUARE.', 'sand', { life: 6 });\n    } else if (w.camp.q.i < QUESTS.length) this.hudSys.toast(`QUEST: ${QUESTS[w.camp.q.i].steps[w.camp.q.s].text}`, 'sand', { life: 5 });\n  }\n\n  leaveShell() {\n    if (this.shellSet) { this.shellSet.dispose(); this.shellSet = null; }\n    if (this.attract) { this.attract.stop(); this.attract = null; }\n  }\n\n  teardownWorld() {\n    this.view.setWorld(null);\n    this.world = null;\n    this.botSeats.clear();\n    this.botMem.clear();\n    this.pendingEvents.length = 0;\n  }\n\n  persist() {\n    if (this.currentSlot < 0 || !this.world || this.isSession || this.attract) return;\n    const h = this.world.heroes.find((o) => o.seat === 0);\n    if (!h) return;\n    const slot = this.save.heroes[this.currentSlot];\n    if (!slot) return;\n    slot.data = heroToData(h);\n    slot.camp = this.world.camp;\n    for (const o of this.world.heroes) if (o.guest) this.save.guests[o.cls] = heroToData(o);\n    writeSave(this.save);\n  }\n\n  saveAndQuit() {\n    this.persist();\n    this.ctx.engine.timeScale = 1;\n    this.closeAll();\n    this.enterShell();\n  }\n\n  rerollMap() {\n    const w = this.world;\n    const seed = this.newSeed();\n    w.camp.seed = seed;\n    w.seed = seed;\n    w.root = new Rng(seed);\n    loadZone(w, w.zone.id, w.zone.floor, 'start');\n  }\n\n  cmd(c, seat = null) {\n    const s = seat ?? this.menuSeat ?? this.localSeats()[0] ?? 0;\n    if (this.isClient) { this.net.sendCommand(c); return true; }\n    return applyCommand(this.world, s, c);\n  }\n\n  // ---- Attract ------------------------------------------------------------------------------\n  startAttract(fromDev = false) {\n    if (this.attract) return;\n    if (this.shellSet) { this.shellSet.dispose(); this.shellSet = null; }\n    const returnTo = this.mode;\n    this.attractReturn = returnTo;\n    this.attractFromDev = fromDev;\n    if (fromDev) { this.savedWorld = this.world; this.persist(); this.view.setWorld(null); }\n    this.mode = 'attract';\n    this.attract = new AttractTour(this);\n    this.attract.start();\n  }\n\n  stopAttract() {\n    const fromDev = this.attractFromDev;\n    if (this.attract) { this.attract.stop(); this.attract = null; }\n    this.world = null;\n    this.view.setWorld(null);\n    this.botSeats.clear();\n    this.botMem.clear();\n    this.pendingEvents.length = 0;\n    this.ctx.engine.timeScale = 1;\n    if (fromDev && this.savedWorld) {\n      this.world = this.savedWorld;\n      this.savedWorld = null;\n      this.mode = 'play';\n      this.view.setWorld(this.world);\n      return;\n    }\n    this.mode = 'shell';\n    this.shellSet = new ShellSet(this.view);\n    this.shellSet.setMode('title', 0);\n    this.audioSys.music('vespers');\n    this.input.idleFrames = 0;\n    this.applyLook();\n  }\n\n  // ---- Hooks --------------------------------------------------------------------------------\n  fixedUpdate(ctx, dt) {\n    if (this.opts.hub && this.net) { this.net.fixedUpdate(dt); return; }\n    const w = this.world;\n    if (!w) return;\n    if (this.mode === 'attract') { this.attract?.fixed(); return; }\n    if (this.mode !== 'play') return;\n    const top = this.topScreen();\n    if (top?.holdSim) return;\n    this.stepPlay(w);\n  }\n\n  stepPlay(w) {\n    const intents = [];\n    for (let seat = 0; seat < this.input.seats.length; seat++) {\n      const h = w.heroes.find((o) => o.seat === seat);\n      if (!h) continue;\n      if (this.botSeats.has(seat)) {\n        const mem = this.memOf(h);\n        intents[seat] = botIntent(w, h, mem);\n        if (w.t % 300 === 0) botManage(w, h, mem);\n        botAfter(w, h, mem);\n        for (const e of w.events) if (e.t === 'talk' && e.seat === seat) applyCommand(w, seat, { c: 'talk_done', npc: e.npc });\n      } else {\n        intents[seat] = this.menuBlocks(seat) ? emptyIntent() : this.input.intentFor(seat, w);\n      }\n    }\n    for (const h of w.heroes) {\n      if (!h.companion) continue;\n      intents[h.seat] = botIntent(w, h, this.memOf(h));\n      botAfter(w, h, this.memOf(h));\n    }\n    stepWorld(w, intents);\n    this.drainEvents(w);\n  }\n\n  menuBlocks() { return this.screens.length > 0 && !(this.topScreen()?.tag === 'death'); }\n\n  drainEvents(w) {\n    if (w.events.length) { for (const e of w.events) this.pendingEvents.push(e); w.events.length = 0; }\n  }\n\n  flushEvents() { if (this.world) this.drainEvents(this.world); this.dispatchEvents(); }\n\n  dispatchEvents() {\n    if (!this.pendingEvents.length) return;\n    const list = this.pendingEvents;\n    this.pendingEvents = [];\n    this.view.consume(list);\n    this.hudSys.consume(list);\n    for (const e of list) this.flowEvent(e);\n  }\n\n  flowEvent(e) {\n    const w = this.world;\n    switch (e.t) {\n      case 'talk':\n        if (this.isLocalSeat(e.seat) && !this.botSeats.has(e.seat)) { this.menuSeat = e.seat; this.openScreen(new DialogueScreen(this, e.npc, e.id)); }\n        break;\n      case 'open': {\n        if (!this.isLocalSeat(e.seat) || this.botSeats.has(e.seat)) break;\n        this.menuSeat = e.seat;\n        if (e.ui === 'map') this.openScreen(new MapScreen(this));\n        else if (e.ui === 'knell') this.openScreen(new KnellScreen(this));\n        else if (e.ui === 'writs') this.openScreen(new WritsScreen(this));\n        else if (e.ui === 'stash') this.openScreen(new StashScreen(this));\n        break;\n      }\n      case 'lore':\n        if (this.isLocalSeat(e.seat) && !this.botSeats.has(e.seat)) this.openScreen(new LoreScreen(this, e.id));\n        break;\n      case 'down':\n        if (this.isLocalSeat(e.seat) && !e.companion && !this.botSeats.has(e.seat)) { this.menuSeat = e.seat; if (!this.isSession) this.openScreen(new DeathScreen(this, e.seat)); }\n        break;\n      case 'cut': this.onCut(e); break;\n      case 'autosave': this.persist(); break;\n      case 'run_done': if (!this.botSeats.has(0) && !this.attract) this.openScreen(new ResultsScreen(this, e.results)); break;\n      case 'zone': this.persist(); if (w?.run && e.zone === 'town') w.run = null; if (e.zone === 'town' && w?.run) w.run = null; break;\n      default: break;\n    }\n  }\n\n  onCut(e) {\n    if (this.isSession || this.attract) return;\n    if (e.id === 'ending') { this.playEnding(!!e.first); return; }\n    const s = STORY[e.id];\n    if (!s) return;\n    const boss = this.world.boss;\n    this.openScreen(new Cutscene(this, { ...s, cam: boss ? { x: boss.x, z: boss.z, zoom: 1.1 } : null }));\n  }\n\n  playEnding(first) {\n    const w = this.world;\n    const ctx = this.ctx;\n    this.openScreen(new Cutscene(this, {\n      lines: STORY_LINES.ending,\n      music: 'clemency',\n      extra: 2,\n      onEnd: () => {\n        ctx.engine.screen.flash('white', { duration: 0.6 });\n        this.persist();\n        if (first) {\n          import('../ui/menus/pause.js').then(() => {});\n          this.hudSys.toast('PENANCE AND KNELL RUNS ARE OPEN AT THE FONT', 'sand', { big: true, life: 6 });\n        }\n        this.cmd({ c: 'dev_goto', zone: 'town', floor: 0 });\n      },\n    }));\n    ctx.engine.sun.color.setHex(0xffd090);\n    ctx.engine.sun.intensity = 1.4;\n    ctx.engine.ambient.intensity = 1.4;\n  }\n\n  update(ctx, dt) {\n    const real = this.realDt(ctx, dt);\n    this.lastRealDt = real;\n    this.frame++;\n    this.frameTime += real;\n    this.input.beginFrame();\n    this.handleCommands(ctx);\n    if (this.world) this.drainEvents(this.world);\n    this.dispatchEvents();\n    this.audioSys.update(real);\n    if (this.net) this.net.update(real);\n    // Time: full-screen menus freeze the world (solo and couch). Dev time scale otherwise.\n    const top = this.topScreen();\n    if (!this.isSession && this.mode === 'play') {\n      const frozen = !!top?.freeze;\n      if (frozen) ctx.engine.timeScale = 0;\n      else if (!(this.view.slowT > 0)) ctx.engine.timeScale = this.devTimeScale;\n    }\n    this.view.update(dt, real);\n    if (this.shellSet) this.shellSet.update(dt, real);\n    this.hudSys.update(real);\n    if (this.mode === 'play') this.playFrame();\n    else if (this.mode === 'shell') this.shellFrame();\n    else if (this.mode === 'attract') this.attract?.frame();\n    this.drawUI(real);\n    if (this.mode === 'play') {\n      this.autosaveT += real;\n      if (this.autosaveT > 60) { this.autosaveT = 0; this.persist(); }\n    }\n  }\n\n  realDt(ctx, dt) {\n    if (dt > 0) return dt;\n    return 1 / 60;\n  }\n\n  handleCommands() {}\n\n  playFrame() {\n    const w = this.world;\n    if (!w) return;\n    const m = this.input.menu;\n    const top = this.topScreen();\n    this.input.claimSeat0();\n    // Couch: a free pad pressing Options joins with the next class along.\n    if (!this.isSession) {\n      const join = this.input.freePadPressedOptions();\n      if (join >= 0 && this.input.seats[0].pad !== null) {\n        const seat = this.input.seats.length;\n        if (seat < 4) this.joinSeat(join, PLAYABLE[seat % 3]);\n      }\n    }\n    this.labelsHeld = false;\n    const seats = this.localSeats();\n    if (top) {\n      if (m.back && top.back) top.back();\n      else if (m.pause && top.tag !== 'dialogue' && top.tag !== 'cutscene' && top.tag !== 'death') this.closeAll();\n      return;\n    }\n    for (const seat of seats) {\n      if (this.botSeats.has(seat) && seat !== 0) continue;\n      const acts = this.input.frameActions(seat);\n      for (const a of acts) this.seatAction(seat, a);\n      if (this.topScreen()) return;\n    }\n  }\n\n  seatAction(seat, a) {\n    const open = (s) => { this.menuSeat = seat; this.openScreen(s); };\n    switch (a) {\n      case 'pause': open(new PauseScreen(this)); break;\n      case 'hero_gear': if (!this.world.heroes.find((h) => h.seat === seat)?.dead) open(new HeroScreen(this, 0)); break;\n      case 'hero_skills': open(new HeroScreen(this, 1)); break;\n      case 'hero_quests': { const s = new HeroScreen(this, 4); open(s); break; }\n      case 'map': open(new MapScreen(this)); break;\n      case 'equip': this.cmd({ c: 'equip_newest' }, seat); break;\n      case 'cycle': this.cmd({ c: 'cycle_use' }, seat); break;\n      case 'labels': this.labelsHeld = true; break;\n      default: break;\n    }\n  }\n\n  shellFrame() {\n    const m = this.input.menu;\n    const top = this.topScreen();\n    if (top && m.back) top.back();\n    if (top && this.input.idleFrames > 600 && (top.tag === 'title' || top.tag === 'menu') && !this.opts.noAttract) {\n      this.startAttract(false);\n    }\n  }\n\n  drawUI(real) {\n    const ui = this.ui;\n    ui.begin();\n    if (this.mode === 'play' || this.mode === 'attract' || this.isSession) {\n      const top = this.topScreen();\n      const showHud = !top || !(top.tag === 'cutscene' || top.tag === 'dialogue');\n      if (showHud && this.world?.zone) this.hudSys.draw(ui, real);\n    }\n    if (this.mode === 'attract') this.attract?.drawOverlay(ui);\n    if (this.net?.drawOverlay) this.net.drawOverlay(ui);\n    const top = this.topScreen();\n    if (top) {\n      ui.screenTag = top.tag;\n      top.t += real;\n      top.draw(ui, real);\n    }\n    ui.end();\n    this.updateCursor();\n  }\n\n  updateCursor() {\n    if (typeof document === 'undefined') return;\n    const want = this.input.lastDevice === 'pad' ? 'none' : (this.cursorCss ??= gauntletCursor());\n    if (this.lastCursor !== want) { this.lastCursor = want; document.body.style.cursor = want; const c = this.ctx.engine.gpu?.renderer?.domElement; if (c) c.style.cursor = want; }\n  }\n\n  drawDevOverlays(ui) { this.devOverlays.draw(ui); }\n\n  cameraTarget() { return this.view?.cam ?? this.camTarget; }\n  status() {\n    const w = this.world;\n    if (!w) return `${this.mode} ${this.topScreen()?.tag ?? ''}`;\n    const h = w.heroes[0];\n    return `${this.mode} ${w.zone?.id}:${w.zone?.floor} L${h?.level} party ${w.heroes.length} kills ${h?.kills ?? 0} monsters ${w.monsters.length}`;\n  }\n  fingerprint() { return this.world ? worldHash(this.world) : `${this.mode}:${this.frame % 1}`; }\n  dispose() { this.audioSys?.stopAll(); }\n}\n\nfunction gauntletCursor() {\n  if (typeof document === 'undefined') return 'default';\n  try {\n    const rows = ['XX........', 'XOX.......', 'XOOX......', 'XOOOX.....', 'XOOOOX....', 'XOOOOOX...', 'XOOOOOOX..', 'XOOOOXXXX.', 'XOOXOOX...', 'XOX.XOOX..', 'XX..XOOX..', '.....XX...'];\n    const c = document.createElement('canvas');\n    c.width = 30; c.height = 36;\n    const g = c.getContext('2d');\n    rows.forEach((r, y) => r.split('').forEach((ch, x) => {\n      if (ch === '.') return;\n      g.fillStyle = ch === 'X' ? '#1a1c2c' : '#ffcd75';\n      g.fillRect(x * 3, y * 3, 3, 3);\n    }));\n    return `url(${c.toDataURL()}) 0 0, default`;\n  } catch { return 'default'; }\n}\n\nexport { MODEL_LIBRARY, gearLook, recalcHero, HERO_SLOTS, beginCampaign };\nEOF\ncat > src/ui/devoverlays.js <<'EOF'\n// Dev mode's overlays, drawn in art pixels over the world.\nimport { NavGrid } from '../../pixel-engine.js';\n\nexport class DevOverlays {\n  constructor(game) { this.game = game; }\n  draw(ui) {\n    const g = this.game, w = g.world;\n    const o = g.overlays;\n    if (!w?.zone) return;\n    const view = g.view;\n    const h = g.localHero();\n    if (o.nav && h) {\n      const z = w.zone;\n      const cx = Math.floor(h.x), cz = Math.floor(h.z);\n      for (let j = cz - 12; j <= cz + 12; j++) for (let i = cx - 12; i <= cx + 12; i++) {\n        if (z.nav.isOpen(i, j)) continue;\n        const [sx, sy] = view.project(i + 0.5, 0, j + 0.5);\n        ui.rect(sx - 1, sy - 1, 2, 2, 'red');\n      }\n    }\n    if (o.flow && h) {\n      const out = [0, 0];\n      const nav = w.zone.navs[h.navIndex ?? 0];\n      const cx = Math.floor(h.x), cz = Math.floor(h.z);\n      for (let j = cz - 10; j <= cz + 10; j += 2) for (let i = cx - 10; i <= cx + 10; i += 2) {\n        if (!nav.walkable(i + 0.5, j + 0.5) || !nav.flowDirection(i + 0.5, j + 0.5, out)) continue;\n        const [a, b] = view.project(i + 0.5, 0, j + 0.5);\n        const [c, d] = view.project(i + 0.5 + out[0] * 0.6, 0, j + 0.5 + out[1] * 0.6);\n        ui.rect(a, b, 1, 1, 'cyan');\n        ui.rect(c, d, 1, 1, 'white');\n      }\n    }\n    if (o.hit) {\n      for (const m of [...w.monsters, ...w.heroes]) {\n        if (m.dead || m.gone) continue;\n        for (let a = 0; a < 10; a++) {\n          const ang = (a / 10) * Math.PI * 2;\n          const [sx, sy] = view.project(m.x + Math.cos(ang) * m.r, 0.1, m.z + Math.sin(ang) * m.r);\n          ui.rect(sx, sy, 1, 1, m.kind === 'hero' ? 'lime' : 'orange');\n        }\n      }\n    }\n    if (o.ai) for (const m of w.monsters) {\n      if (m.dead) continue;\n      const [sx, sy] = view.project(m.x, 2, m.z);\n      ui.text(sx, sy, m.state, { color: 'cyan', align: 'center' });\n    }\n    if (o.spawn) for (const s of w.zone.spawnList) {\n      const [sx, sy] = view.project(s.x, 0.2, s.z);\n      ui.rect(sx - 1, sy - 1, 3, 3, s.done ? 'slate' : s.kind === 'E' ? 'orange' : 'lime');\n    }\n    if (o.state) {\n      const st = g.ctx.engine.state();\n      ui.text(12, ui.h - 62, `FPS ${st.fps?.toFixed?.(0) ?? st.fps} ${g.status()}`.slice(0, 66), { color: 'cyan' });\n      ui.text(12, ui.h - 52, `T ${w.t} MON ${w.monsters.length} ALLY ${w.allies.length} DROPS ${w.drops.length}`, { color: 'cyan' });\n    }\n  }\n}\nexport { NavGrid };\nEOF\ncat > src/modes/attract.js <<'EOF'\n// Attract mode: a looping, cheating, AI-played tour of the whole demo. It never touches saves.\nimport { CLASSES, PLAYABLE } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { botIntent, newBotMemory } from '../sim/bot.js';\nimport { spawnElitePack } from '../sim/monsters.js';\nimport { startBoss } from '../sim/bosses.js';\nimport { addHero, newHeroData } from '../sim/hero.js';\nimport { makeItem } from '../sim/loot.js';\nimport { spawnPlate, newCampaign } from '../sim/quests.js';\nimport { startRun } from '../sim/knell.js';\nimport { loadZone } from '../sim/travel.js';\nimport { createWorld, newAccount, stepWorld } from '../sim/world.js';\nimport { runOps } from '../sim/effects.js';\nimport { dropItem, makeRolledItem } from '../sim/loot.js';\nimport { SKILLS } from '../data/skills.js';\nimport { BARKS, SPEAKERS } from '../data/dialog.js';\n\nconst STOPS = [\n  { id: 'town', dur: 18 },\n  { id: 'causeway', dur: 20 },\n  { id: 'ossuary', dur: 24 },\n  { id: 'cloister', dur: 18 },\n  { id: 'knell', dur: 18 },\n  { id: 'malison', dur: 24 },\n];\n\nfunction cheatHero(d, cls) {\n  d.level = 25;\n  const skills = CLASSES[cls].skills.slice(2, 8);\n  d.skills = skills.map((id) => ({ id, tone: Object.keys(SKILLS[id].tones)[1] }));\n  d.skills[0] = { id: CLASSES[cls].skills[0], tone: null };\n  return d;\n}\n\nexport class AttractTour {\n  constructor(game) {\n    this.game = game;\n    this.i = -1;\n    this.t = 0;\n    this.loops = 0;\n    this.mems = new Map();\n    this.visited = new Set();\n    this.seed = 777;\n  }\n\n  start() { this.next(); }\n\n  makeWorld(seats) {\n    const g = this.game;\n    const account = newAccount();\n    account.unlocks.knell = true;\n    account.unlocks.penance = true;\n    const camp = newCampaign();\n    camp.q.i = 5;\n    camp.credits = true;\n    camp.flags.forge = 1; camp.flags.reliquary = 1; camp.flags.brasse_met = 1; camp.flags.brasse_home = 1; camp.flags.malison_dead = 1; camp.plateFirst = true;\n    const w = createWorld({ seed: this.seed + this.i + this.loops * 10, account, camp, mode: 'attract' });\n    w.noPyx = true;\n    w.attractHp = 0.35;\n    for (const [seat, cls] of seats.entries()) {\n      const d = cheatHero(newHeroData(cls, CLASSES[cls].name, `attract${seat}`), cls);\n      d.gear.main = makeItem(w.lootRng, { slot: 'main', rarity: 'legendary', ilvl: 25, cls, legendary: { bellwarden: 'widows_clapper', lamplighter: 'last_wick', sexton: 'second_best_crook' }[cls] });\n      for (const slot of ['head', 'shoulders', 'chest']) d.gear[slot] = makeItem(w.lootRng, { slot, rarity: 'reliquary', ilvl: 25, cls });\n      const h = addHero(w, d, seat, { navIndex: seat });\n      h.god = true;\n      h.attract = true;\n      h.isBot = true;\n    }\n    g.world = w;\n    g.input.seats = seats.map(() => ({ kind: 'bot', pad: null }));\n    return w;\n  }\n\n  next() {\n    const g = this.game;\n    this.i = (this.i + 1) % STOPS.length;\n    if (this.i === 0 && this.t > 0) this.loops++;\n    this.t = 0;\n    this.mems.clear();\n    const stop = STOPS[this.i];\n    this.visited.add(stop.id);\n    g.view.setWorld(null);\n    const go = (w) => { g.view.setWorld(w); this.flush(w); };\n    switch (stop.id) {\n      case 'town': {\n        const w = this.makeWorld(['lamplighter']);\n        loadZone(w, 'town', 0, 'start');\n        w.heroes[0].hidden = true;\n        go(w);\n        this.pan = w.objects.filter((o) => o.kind === 'npc').map((o) => ({ x: o.x, z: o.z, npc: o.npc }));\n        this.panI = 0;\n        this.panT = 0;\n        g.view.camOverride = this.pan.length ? { x: this.pan[0].x, z: this.pan[0].z, zoom: 1.2 } : null;\n        break;\n      }\n      case 'causeway': {\n        const w = this.makeWorld(['bellwarden']);\n        loadZone(w, 'causeway', 0, 'start');\n        go(w);\n        break;\n      }\n      case 'ossuary': {\n        const w = this.makeWorld(['sexton']);\n        loadZone(w, 'ossuary', 0, 'start');\n        go(w);\n        const h = w.heroes[0];\n        spawnElitePack(w, { x: h.x + 6, z: h.z }, w.zone.def.monsters, { kind: 'champion', type: 'rattlebones', aff: ['tolling'] });\n        this.bossSoon = true;\n        break;\n      }\n      case 'cloister': {\n        const w = this.makeWorld(['lamplighter']);\n        loadZone(w, 'cloister', 0, 'start');\n        go(w);\n        break;\n      }\n      case 'knell': {\n        const w = this.makeWorld(['bellwarden', 'lamplighter', 'sexton']);\n        loadZone(w, 'knell', 0, 'start');\n        startRun(w, { mods: ['crowded'] });\n        w.pendingZone = null;\n        loadZone(w, 'knell', 0, 'start');\n        w.run.total = 80;\n        go(w);\n        break;\n      }\n      case 'malison': {\n        const w = this.makeWorld(['bellwarden', 'sexton']);\n        loadZone(w, 'belfry', 3, 'start');\n        const z = w.zone;\n        const m = startBoss(w, 'malison', z.w / 2, z.h / 2, { noIntro: true });\n        m.hp = m.maxHp * 0.58;\n        go(w);\n        this.flush(w);\n        break;\n      }\n      default: break;\n    }\n    g.ctx.engine.screen.reveal('iris', {}).catch?.(() => {});\n    g.applyLook();\n  }\n\n  flush(w) {\n    const g = this.game;\n    g.drainEvents(w);\n    g.dispatchEvents();\n  }\n\n  fixed() {\n    const g = this.game;\n    const w = g.world;\n    if (!w) return;\n    const intents = [];\n    for (const h of w.heroes) {\n      let mem = this.mems.get(h.id);\n      if (!mem) { mem = newBotMemory(); this.mems.set(h.id, mem); }\n      h.res = h.stats.maxResTotal;\n      h.hp = h.stats.maxHp;\n      h.dead = false;\n      const stop = STOPS[this.i];\n      if (stop.id === 'town') { intents[h.seat] = { mx: 0, mz: 0, ax: 0, az: 0, aimed: 0, tgt: 0, held: 0, pressed: 0, goal: null }; continue; }\n      intents[h.seat] = botIntent(w, h, mem);\n    }\n    stepWorld(w, intents);\n    this.stepStop(w);\n    g.drainEvents(w);\n  }\n\n  stepStop(w) {\n    const stop = STOPS[this.i];\n    this.t += 1 / 60;\n    if (stop.id === 'causeway' && !this.dropped && this.t > 7) {\n      this.dropped = true;\n      const h = w.heroes[0];\n      dropItem(w, h, makeRolledItem(w.lootRng, h, 'legendary', 25), h.x + 3, h.z, 1);\n      spawnPlate(w, h.x + 7, h.z + 3);\n    }\n    if (stop.id === 'ossuary' && this.bossSoon && this.t > 10) {\n      this.bossSoon = false;\n      const h = w.heroes[0];\n      const p = { x: h.x + 5, z: h.z + 2 };\n      startBoss(w, 'bursar', w.zone.nav.walkable(p.x, p.z) ? p.x : h.x, w.zone.nav.walkable(p.x, p.z) ? p.z : h.z, { noIntro: true });\n      if (w.boss) w.boss.hp = w.boss.maxHp * 0.5;\n    }\n    if (stop.id === 'cloister' && !this.comets && this.t > 3) {\n      this.comets = true;\n      const h = w.heroes[0];\n      runOps(w, h, SKILLS.beacon.fx, { x: h.x, z: h.z, dx: 0, dz: 1, px: h.x, pz: h.z, sk: SKILLS.beacon });\n      runOps(w, h, SKILLS.long_nights_end.fx, { x: h.x, z: h.z, dx: 0, dz: 1, px: h.x, pz: h.z, sk: SKILLS.long_nights_end });\n    }\n    if (stop.id === 'knell' && w.run) {\n      if (this.t > 9 && w.run.state === 'fill') { w.run.meter = w.run.total - 1; }\n    }\n    if (stop.id === 'malison' && w.boss) {\n      const m = w.boss;\n      if (this.t > 11 && m.bossState.phase < 3 && m.hp > m.maxHp * 0.24) m.hp = m.maxHp * 0.24;\n      if (this.t > 16 && m.bossState.phase === 3 && !this.rang) {\n        this.rang = true;\n        const rope = w.objects.find((o) => o.kind === 'rope' && o.state === 0);\n        if (rope) { const h = w.heroes[0]; h.x = rope.x + 0.8; h.z = rope.z; }\n      }\n    }\n    if (this.t >= stop.dur) {\n      this.dropped = false; this.comets = false; this.bossSoon = false; this.rang = false;\n      this.next();\n    }\n  }\n\n  frame() {\n    const g = this.game;\n    const stop = STOPS[this.i];\n    if (stop?.id === 'town' && this.pan?.length) {\n      this.panT += g.lastRealDt;\n      const cur = this.pan[this.panI % this.pan.length];\n      const nxt = this.pan[(this.panI + 1) % this.pan.length];\n      const f = Math.min(1, this.panT / 5);\n      const s = f * f * (3 - 2 * f);\n      g.view.camOverride = { x: cur.x + (nxt.x - cur.x) * s, z: cur.z + (nxt.z - cur.z) * s, zoom: 1.2 };\n      if (!this.panSaid) {\n        this.panSaid = true;\n        const lines = BARKS[cur.npc] ?? [];\n        if (lines.length) g.hudSys.say(cur.npc, lines[0]);\n      }\n      if (this.panT >= 5) { this.panT = 0; this.panI++; this.panSaid = false; }\n    } else if (g.view.camOverride) g.view.camOverride = null;\n    if (g.input.anyInput && !g.touchOnly) {\n      if (g.input.idleFrames === 0) g.stopAttract();\n    }\n  }\n\n  drawOverlay(ui) {\n    const W = ui.w;\n    ui.text(W / 2, 14, 'DEMO', { color: 'sand', align: 'center', scale: 2 });\n    if (this.game.frame % 60 < 42) ui.text(W / 2, 34, this.game.touchOnly ? 'CONTROLLER OR KEYBOARD REQUIRED'.slice(0, Math.floor((W - 10) / 6)) : 'PRESS ANY BUTTON', { color: 'white', align: 'center' });\n    if (this.t < 2.5) ui.text(W / 2, ui.h / 2 - 40, TITLE, { color: 'sand', align: 'center', scale: W < 300 ? 2 : 3 });\n  }\n\n  stop() {\n    const g = this.game;\n    g.view.camOverride = null;\n    g.input.seats = [{ kind: 'kbm', pad: null }];\n  }\n}\n\nexport { PLAYABLE, SPEAKERS };\nEOF\ncat > game.js <<'EOF'\n// Diabellical: a gothic co-op action RPG. Entry point.\n// Controls: stick or WASD or click to move; Cross or click to attack; face buttons, R1, R2 or right\n// click and 1-4 for skills; L2 or Space to roll; L1 or Q to drink; E or Cross to use things.\nimport { Engine, LOOK_PRESETS, withUrlOptions } from './pixel-engine.js';\nimport { TITLE } from './src/data/meta.js';\nimport { DiabellicalGame, VIGNETTE_LOOK } from './src/modes/game.js';\n\nexport const createGame = (opts = {}) => new DiabellicalGame({ fixedSeed: 12345, noAutoStart: true, ...opts });\n\nconst isTouchOnly = () => typeof matchMedia !== 'undefined' && !matchMedia('(any-pointer: fine)').matches && (navigator.maxTouchPoints ?? 0) > 0;\n\nexport const ENGINE_OPTIONS = (touchOnly) => withUrlOptions({\n  container: document.getElementById('app'),\n  camera: { preset: 'iso', viewHeight: 11.5, pitch: 42, yaw: 45, minZoom: 0.5, maxZoom: 1.6 },\n  aspect: 'fill', quality: 'high', touch: false,\n  look: VIGNETTE_LOOK(0.3),\n  settings: { button: touchOnly ? 'top-right' : false },\n});\n\nfunction fatal(message) {\n  const app = document.getElementById('app');\n  const el = document.createElement('div');\n  el.style.cssText = 'position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#1a1c2c;color:#ffcd75;font:20px monospace;text-align:center;padding:24px';\n  const h = document.createElement('h1');\n  h.textContent = TITLE;\n  const p = document.createElement('p');\n  p.textContent = message;\n  el.append(h, p);\n  (app ?? document.body).appendChild(el);\n}\n\nasync function boot() {\n  const hub = typeof AIHub !== 'undefined' && AIHub.active;\n  if (hub) {\n    const { runHubSession } = await import('./src/net/hubflow.js');\n    await runHubSession(ENGINE_OPTIONS);\n    return;\n  }\n  const touchOnly = isTouchOnly();\n  try {\n    await Engine.start(new DiabellicalGame({ touchOnly }), ENGINE_OPTIONS(touchOnly));\n  } catch (e) {\n    fatal('This game needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox on Windows');\n    if (typeof window !== 'undefined') window.__BOOT_ERROR__ = String(e?.message ?? e);\n  }\n}\n\nif (typeof document !== 'undefined') await boot();\n\nexport { LOOK_PRESETS };\nEOF\nmkdir -p src/net; cat > src/net/hubflow.js <<'EOF'\nexport async function runHubSession() { /* filled in M6 */ }\nEOF\nsed -i 's/ \\/\\* filled in M6 \\*\\/ / /' src/net/hubflow.js\nnode tools/build.mjs --quiet 2>&1 | tail -n 12 | cut -c1-300; timeout 100 node check.mjs --headless game.js --out .scratch/check --keys Enter*2,Space*30 2>&1 | tail -n 6 | cut -c1-500","description":"Write shell, game core and attract, build, headless check","timeout":180000}}}
