 warn('go:' + name, 'game.go(\"' + name + '\"): no such scene. Scenes: ' + Object.keys(this.scenes).join(', ')); return; }\n    let fade = o.fade === undefined ? this.fadeTime : o.fade, kind = null;\n    if (typeof fade === 'string') {\n      kind = fade; fade = o.seconds === undefined ? .4 : +o.seconds || 0;\n      if (kind !== 'black' && kind !== 'white' && !FADES[kind]) warn('fade:' + kind, 'game.go: no transition \"' + kind + '\" here (black, white, wipe, iris, mosaic, swirl, dissolve; a kit may leave them out: the full engine has them): a fade through black');\n    }\n    if (fade > 0 && this.scene) this._fade = { t: 0, dur: fade, name, data, out: true, kind, at: o.at };\n    else { this._fade = null; this._next = { name, data }; }\n  }\n  _fadeStep(dt) {\n    const f = this._fade; f.t += dt;\n    if (f.out && f.t >= f.dur) { f.out = false; f.t = 0; this._enter(f.name, f.data); }\n3087:class Settings {\n9415:class Shell {\n","exit_code":0,"status":"completed"}}
