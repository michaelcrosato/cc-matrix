pressed:true,touched:true,value:1});await page.waitForFunction(()=>__diabellum.panel?.kind==='inventory');await page.evaluate(()=>__pads[0].buttons[14]={pressed:false,touched:false,value:0});check('D-pad opens inventory without moving',true);await page.keyboard.press('Escape');\n    82\t    await page.evaluate(()=>__pads[1].buttons[9]={pressed:true,touched:true,value:1});await page.waitForFunction(()=>__diabellum.world.heroes.filter(h=>!h.follower).length===2);await page.evaluate(()=>__pads[1].buttons[9]={pressed:false,touched:false,value:0});check('second controller joins couch co-op',await page.evaluate(()=>__diabellum.game.players.length===2));await page.evaluate(()=>__diabellum.closePanel());\n    83\t    await page.keyboard.press('Escape');await page.getByRole('button',{name:'Dev Mode',exact:true}).click();await page.waitForFunction(()=>__diabellum.panel?.kind==='dev');check('pause menu reaches Dev Mode',true);\n    84\t    await page.evaluate(()=>{const p=__diabellum.panel;p.tab=3;p.focus=0;});await page.waitForTimeout(150);const slider=await page.evaluate(()=>__diabellum.panel.buttons.find(b=>b.slider));const tune=await page.evaluate(()=>__diabellum.TUNE.damage);await clickBuffer(page,slider.x+slider.w*.75,slider.y+slider.h/2);await page.waitForFunction(n=>__diabellum.TUNE.damage!==n,tune);check('live balance slider changes value',true);\n    85\t    let allSliders=true;for(let group=0;group<4;group++){await page.evaluate(n=>{const p=__diabellum.panel;p.group=n;p.page=0;},group);await page.waitForTimeout(90);const keys=await page.evaluate(()=>__diabellum.panel.buttons.filter(b=>b.slider).map(b=>b.slider[1]));for(const key of keys){await page.evaluate(k=>{const a=__diabellum,s=a.TUNING.find(s=>s[1]===k);a.TUNE[k]=s[4]+s[6];},key);allSliders&&=await page.evaluate(k=>__diabellum.TUNE[k]!==undefined,key);}}\n    86\t    check('all four balance groups are live',allSliders);const reset=await page.evaluate(()=>__diabellum.panel.buttons.find(b=>b.label==='Reset all'));await clickBuffer(page,reset.x+10,reset.y+7);await page.waitForFunction(()=>Object.keys(__diabellum.DEFAULTS).every(k=>__diabellum.TUNE[k]===__diabellum.DEFAULTS[k]));check('Reset restores all defaults',true);await page.keyboard.press('Escape');\n    87\t    await page.keyboard.press('Escape');const zoom=await page.locator('.esh').evaluateAll(es=>es.map(e=>Number(e.style.zoom)||1));check('standard menus scale for a 1080p TV',zoom.some(z=>z===2));await page.keyboard.press('Escape');\n    88\t    // Render real Web Audio offline. No listener or physical audio device is assumed.\n    89\t    const sound=await page.evaluate(async()=>{const a=__diabellum,out={};const rms=b=>{const d=b.getChannelData(0);return Math.sqrt(d.reduce((n,v)=>n+v*v,0)/d.length);};for(const kind of ['bell','choir','organ','strings','drum','lute','voice']){const c=new OfflineAudioContext(1,24000,24000);a.synthVoice(c,c.destination,kind,220,0,.7,.2);out[kind]=rms(await c.startRendering());}for(const cutoff of [18000,650]){const c=new OfflineAudioContext(1,24000,24000),f=c.createBiquadFilter();f.type='lowpass';f.frequency.value=cutoff;f.connect(c.destination);a.synthVoice(c,f,'bell',2600,0,.7,.2);out[cutoff]=rms(await c.startRendering());}return out;});\n    90\t    check('all seven procedural instrument voices produce audio',Object.values(sound).every(v=>v>0)&&['bell','choir','organ','strings','drum','lute','voice'].every(k=>sound[k]>.0001),JSON.stringify(sound));check('Hush removes high frequencies',sound[650]<sound[18000]*.15,JSON.stringify(sound));check('gibberish speaker profiles differ',await page.evaluate(()=>new Set(Object.values(__diabellum.VOICES).map(v=>v.pitch)).size>=10));\n754:class Input {\n1166:  tick(dt) {\n2934:    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n3832:  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n596:  screenDirToGround(dx, dy) {\n7358:      const m = ctl.move(), g = v ? v.screenDirToGround(m[0], m[1]) : m, has = a => !!ctl.map[a];\n","exit_code":0,"status":"completed"}}
