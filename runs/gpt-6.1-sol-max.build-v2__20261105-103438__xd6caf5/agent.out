=>u.id===e.id)\\\", \\\"[...W.foes,...W.heroes,...W.allies].find(u=>u.id===e.id)\\\");p.write_text(s)\np=Path('game/src/80-front.js');s=p.read_text().replace(\\\"frontButtons=[];const x=game.W/2,y=game.H-50;\\\", \\\"frontButtons=[];for(const action of ['left','right','up','down'])game.input.suppress(action);if(game.input.lastDevice\"'!=='\"'mouse')frontFocus=1;const x=game.W/2,y=game.H-50;\\\");p.write_text(s)\nPY\nnode tools/test.mjs data\"","aggregated_output":"2526 checks: 2526 passed, 0 failed.\n","exit_code":0,"status":"completed"}}
