{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game/src/20-combat.js');s=p.read_text().replace(\\\"w.hazards.push({id:w.uid++,shape:'pool'\\\", \\\"addHazard(w,{id:w.uid++,shape:'pool'\\\");p.write_text(s)\np=Path('game/src/30-ai-step.js');s=p.read_text().replace(\\\"w.hazards.push(a);return a;\\\", \\\"addHazard(w,a);return a;\\\");s=s.replace(\\\"  f.update(dt,w.map);\\\\n}\\\", \\\"  f.update(dt,w.map);f.x=clamp(f.x,24,w.width-24);f.y=clamp(f.y,24,w.height-24);\\\\n}\\\");s=s.replace(\\\"  for(const c of w.corpses)\\\", \\\"  if(\"'!w.authority){stepShots(w,dt);for(const a of w.hazards){a.t+=dt;if(a.shape==='\"'pool')a.life-=dt;}w.hazards=w.hazards.filter(a=>a.shape==='pool'?a.life>0:a.t<(a.expand?a.life:a.delay+.15));}\\\\n  for(const c of w.corpses)\\\");p.write_text(s)\np=Path('game/src/75-network.js');s=p.read_text().replace(\\\"  else if(e.kind==='kill'){\\\", \\\"  else if(e.kind==='hazard'){W.hazards.push({...e.p,src:[...W.foes,...W.heroes].find(u=>u.id===e.p.src)});}\\\\n  else if(e.kind==='kill'){\\\");p.write_text(s)\np=Path('game/src/60-render.js');s=p.read_text().replace(\\\"if(w.dialogue&&\"'!PANEL_STATE)\", \"if(w.dialogue&&!PANEL_STATE&&!talk?.open)\");p.write_text(s)\np=Path('\"'game/src/90-start.js');s=p.read_text().replace(\\\"  drawWorld(r);if(PANEL_STATE)\\\", \\\"  drawWorld(r);if(talk.open&&\"'!PANEL_STATE&&!attract)talk.draw(r);if(PANEL_STATE)\");p.write_text(s)\nPY\nnode tools/test.mjs play'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
