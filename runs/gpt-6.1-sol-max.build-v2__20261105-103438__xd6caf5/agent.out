{"type":"item.started","item":{"id":"item_168","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game/src/60-render.js');s=p.read_text().replace(\\\"p.hp/p.maxHp,'#9b4e50');if(\"'!p.alive)\", \"p.hp/p.maxHp,'\"'#9b4e50');E.ui.bar(g,xx+5,y+13,bw-13,2,p.resource/p.resourceMax,DB.hero[p.kind].color);if(\"'!p.alive)\");p.write_text(s)\np=Path('\"'game/src/70-ui.js');s=p.read_text().replace(\\\"text(g,bt.label,bt.x+bt.w-8\\\", \\\"text(g,bt.label.replace('Left click','LMB').replace('Right click','RMB'),bt.x+bt.w-8\\\");p.write_text(s)\nPY\nnode tools/build.mjs --quiet\npython3 - <<'PY'\nfrom pathlib import Path\nimport json,re\ncfg=json.loads(Path('build-config.json').read_text());html=Path('../'+cfg['base']+'.html').read_text();data=json.loads(Path('../exit-interview.json').read_text())\nassert data['aiHub']['name']==cfg['title']\nassert data['sourceInformation']['usage']=='added on import'\nassert set(data)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'}\nassert (len(data['testingFeedback']),len(data['engineFeedback']),len(data['promptFeedback']))==(4,6,4)\nfirst=re.search(r'<script>\\\\s*([\\\\s\\\\S]*?)</script>',html).group(1).strip();assert first==Path('hub/session.js').read_text().strip()\nassert len(re.findall(r'<script>',html))==3\nassert not re.search(r'<script[\"'^>]+src='\"',html)\nassert 'Permission is hereby granted' in html\nprint('Final bundle and exit interview verified.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
