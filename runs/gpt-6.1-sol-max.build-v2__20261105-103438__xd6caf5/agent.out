of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n      this.focus(t.x + dir[0] * f.lead, (t.y || 0) + dir[1] * f.lead, (t.z || 0) + f.z);\n    }\n    this.particles.update(dt);\n    if (this.cam.free) this._freeCam(dt);\n    this._camStep(dt);\n  }\n  // a screen-pixel move [dx, dy] as the ground's (world x, y) at the zoom the player sees (during a zoom's preview, the goal)\n  _screenToGround(dx, dy) {\n    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n    return v.inv ? [(v.inv[0] * dx + v.inv[1] * dy) * k, (v.inv[2] * dx + v.inv[3] * dy) * k] : [dx / (v.ax || 1) * k, 0];\n  }\n  // cam.free: the keys and a stick, the screen's edges, a drag, a zoom toward its point; the focus kept to bounds\n  _freeCam(dt) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game/src/90-start.js');s=p.read_text().replace(\\\"for(let i=0;i<6;i++)out.slots[i]=game.settings.holdAttack?I.down('s'+i):I.pressed('s'+i);\\\", \\\"for(let i=0;i<6;i++){out.slots[i]=(game.settings.holdAttack&&I.down('s'+i))||I.buffered('s'+i,.2);if(out.slots[i])I.consume('s'+i);}\\\");s=s.replace(\\\"  for(const I of g.players)if(I.preset\"'!==(inMenu?MENU:PLAY))I.use(inMenu?MENU:PLAY);\", \"\"\"  for(const I of g.players)if(I.preset!==(inMenu?MENU:PLAY))I.use(inMenu?MENU:PLAY);\n+  if(!net&&!attract&&!PANEL_STATE&&g.sceneName==='\"'play'&&\"'!g.paused&&!g.shell?.screen){\n+    for(const h of W?.heroes||[]){if(h.remote||h.follower)continue;const I=g.players[W.heroes.filter(u=>!u.follower).indexOf(h)]||g.input;\n+      for(const [action,panel] of [['\"'inventory','inventory'],['skills','skills'],['journal','journal'],['map','map']])if(I.pressed(action)){openPanel(panel,h.id);break;}\n+      if(PANEL_STATE)break;\n+    }\n+  }\\\"\\\"\\\".replace('\\\\n+','\\\\n'));p.write_text(s)\nPY\nnode tools/test.mjs browser\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
