    if(a.extra.chain&&a.src){let from=a,used=new Set();for(let i=0;i<a.extra.chain;i++){const u=closest(w.foes,from,80,f=>f.alive&&\"'!used.has(f.id));if(!u)break;used.add(u.id);fx(w,'\"'chain',{x:from.x,y:from.y,z:18,to:{x:u.x,y:u.y,z:18},color:a.color,life:.3});dealDamage(w,u,{src:a.src,amount:a.damage*.5,...a.extra});from=u;}}\\\\n      if(a.team==='hero')for(const p\\\");s=s.replace(\\\"w.allies.splice(w.allies.indexOf(a),1);\\\", \\\"event(w,'allyEnd',{id:a.id});w.allies.splice(w.allies.indexOf(a),1);\\\");p.write_text(s)\np=Path('game/src/90-start.js');s=p.read_text().replace(\\\"'blessing','hazard'].includes\\\", \\\"'blessing','hazard','allySpawn','allyEnd'].includes\\\");s=s.replace(\\\"game.cam.bounds=v=>W.map.bounds(v);\\\", \\\"talk.close();game.cam.bounds=v=>W.map.bounds(v);\\\");s=s.replace(\\\"if(\"'!attract)say('\"'A fine Relic.\\\", \\\"if(\"'!attract&&!W.flags.includes('\"'bookBurned'))say('A fine Relic.\\\");s=s.replace(\\\"if(W.zoneTime>20&&Math.floor\\\", \\\"if(\"'!W.flags.includes('\"'bookBurned')&&W.zoneTime>20&&Math.floor\\\");p.write_text(s)\np=Path('game/src/75-network.js');s=p.read_text().replace(\\\"Math.round(W.reckoning*100),W.kills]\\\", \\\"Math.round(W.reckoning*100),W.kills,W.allies.map(a=>[a.id,Math.round(a.x*10),Math.round(a.y*10),Math.round(a.facing*100),Math.round(a.life*10)])]\\\");s=s.replace(\\\"    for(const p of data[3])\\\", \\\"    const allyIds=new Set((data[6]||[]).map(p=>p[0]));W.allies=W.allies.filter(a=>allyIds.has(a.id));for(const p of data[6]||[]){const a=W.allies.find(a=>a.id===p[0]);if(a){a.x=p[1]/10;a.y=p[2]/10;a.facing=p[3]/100;a.life=p[4]/10;}}\\\\n    for(const p of data[3])\\\");s=s.replace(\\\"  else if(e.kind==='hazard')\\\", \\\"  else if(e.kind==='allySpawn'){if(\"'!W.allies.some(a=>a.id===e.p.id))W.allies.push({...e.p,alive:true});}'\"\\\\n  else if(e.kind==='allyEnd'){W.allies=W.allies.filter(a=>a.id\"'!==e.id);}'\"\\\\n  else if(e.kind==='hazard')\\\");s=s.replace(\\\"[...W.foes,...W.heroes].find(u=>u.id===e.id)\\\", \\\"[...W.foes,...W.heroes,...W.allies].find(u=>u.id===e.id)\\\");p.write_text(s)\np=Path('game/src/80-front.js');s=p.read_text().replace(\\\"frontButtons=[];const x=game.W/2,y=game.H-50;\\\", \\\"frontButtons=[];for(const action of ['left','right','up','down'])game.input.suppress(action);if(game.input.lastDevice\"'!=='\"'mouse')frontFocus=1;const x=game.W/2,y=game.H-50;\\\");p.write_text(s)\nPY\nnode tools/test.mjs data\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
