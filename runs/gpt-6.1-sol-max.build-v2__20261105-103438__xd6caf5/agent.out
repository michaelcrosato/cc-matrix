{"type":"item.started","item":{"id":"item_158","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport urllib.request,pathlib,concurrent.futures\nurls=[('my-3D2dge','https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/main/LICENSE'),('AI Hub','https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/LICENSE')]\ndef get(pair):\n name,url=pair\n try:return name,urllib.request.urlopen(url,timeout=20).read().decode()\n except Exception:return name,None\nout=[]\nfor name,data in concurrent.futures.ThreadPoolExecutor(2).map(get,urls):\n if data:out.append(name+'\\\\n'+data.strip())\n print(name+': '+(data.splitlines()[0] if data else 'license file unavailable'))\nif out:pathlib.Path('LICENSES.txt').write_text('\\\\n\\\\n'.join(out)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
