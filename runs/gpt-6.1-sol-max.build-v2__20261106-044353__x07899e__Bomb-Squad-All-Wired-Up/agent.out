{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"node tools/build.mjs --quiet && node - <<'JS'\nconst fs=require('fs'),vm=require('vm');for(const f of ['vendor/my-3d2dge.js','src/content.js','src/sim.js','src/art.js','src/audio.js','src/net.js','src/editor.js','src/app.js'])vm.runInThisContext(fs.readFileSync(f,'utf8'),{filename:f});\nlet bad=0;for(const c of Wired.CASES)for(let seed=0;seed<20;seed++)for(let party=1;party<=4;party++){const s=Wired.makeCase(c.id,seed,Array.from({length:party},(_,i)=>i));const errors=Wired.validateCase(s);if(errors.length){bad++;if(bad<4)console.log(c.id,seed,party,errors)}}\nconsole.log('Content invalid:',bad);const app=Wired.createApp({headless:true,draw:true,loop:false});app.g.advance(.2);console.log(JSON.stringify({scene:app.g.sceneName,errors:app.g.errors,music:app.g.settings.music}));app.start('training','proof');app.g.advance(.2);console.log(JSON.stringify({scene:app.g.sceneName,state:app.state().id,errors:app.g.errors}));app.dispose();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
