f(e.text&&['board','fire','fault','recover','wrong','test','penalty','stable','proposal','veto'].includes(e.type))app.notice(e.text);}\n        if(current.proposal&&!['vote','confirmCode'].includes(app.menuPage)&&ui.screen!=='vote')app.votePage();if(!current.proposal&&ui.screen==='vote'&&!current.outcome)app.openEvidence();\n        if(app.boardId&&!ui.screen&&game.real-(app.hintAt||0)>current.tuning.hintDelay){app.hintAt=game.real;app.notice(new W.Simulation(current).instruction(app.currentBoard()),'NELL',1);}\n        app.sound.update(current);if(current.outcome&&app.lastOutcome!==current.outcome){app.results();}\n        if(current.time>18&&app.voiceTime===0){app.voiceTime=1;app.notice(W.CASES.find(c=>c.id===current.caseId)?.taunt||'VEX: Such careful hands.','VEX',0);}\n      }\n      const target=app.target();app.art.precision=current?.tuning.precision||.55;if(target)app.art.point(target.x,target.y,target.z+12,game.input.down('precision'));app.refreshHUD();\n    };\n    app.draw=r=>{const s=app.state();if((game.sceneName==='field'||game.sceneName==='attract')&&s){const b=app.currentBoard();if(app.editorPreview){app.art.board(r,app.editorPreview,null,app.tool);return;}if(['evidence','dial','reference','vote'].includes(app.menuPage)||!b){const n=ui.root?Math.max(0,[...ui.root.querySelectorAll('.esh-btns button')].indexOf(document.activeElement)):0;app.art.evidence(r,s,n,app.menuPage==='reference',app.menuPage==='dial'?app.digits:null);}else {const target=app.target();if(target)target.legal=app.legal(target,b);app.art.board(r,b,target,app.tool,app.observing);};}\n      else app.art.world(r,s?.theme||W.CASES.find(c=>c.id===app.briefCase)?.theme||'quay',s?.outcome,game.sceneName==='title');\n      if(s&&app.menuPage==='board')r.overlay(g=>{const rig=app.radio.startsWith('VEX')?app.art.vex:app.art.nell;rig.drawPortrait(g,10,r.H-35,26,{zoom:2,bg:'#173238',frame:true,weapon:false});});\n      if(app.editorPreview&&app.menuPage==='editor'){app.art.evidence(r,{evidence:[Array(20).fill(-1)],boards:[app.editorPreview]},0,false,null);}\n    };\n    const scenes={title:{view:'threequarter',pausable:false,enter(){if(app.menuPage!=='title'&&net.mode!=='hub'){app.title();return;}game.setView('threequarter');game.focus(160,140,25);},update(dt){app.art.update(dt);app.refreshHUD();app.lastInputReal??=game.real;if(ui.screen==='title'&&net.mode==='solo'){const phase=app.cabinet.attract(dt);if(phase==='demo')app.startAttract();}else app.cabinet.wake();},draw:r=>app.draw(r)},brief:{view:'threequarter',enter(){game.focus(160,140,25);},update:dt=>app.art.update(dt),draw:r=>app.draw(r)},field:{view:'topdown',pausable:true,camera:{zoom:false},enter(){game.view.set(0,72,1.28,1);game.focus(140,65,0);game.cam.offset=[0,8];},update:dt=>app.update(dt),draw:r=>app.draw(r)},attract:{view:'topdown',pausable:false,enter(){game.view.set(0,72,1.28,1);game.focus(140,65,0);game.cam.offset=[0,8];},update:dt=>app.update(dt),draw:r=>app.draw(r)},result:{view:'threequarter',enter(){game.focus(160,140,25);game.cam.offset=[0,0];},update:dt=>{app.art.update(dt,app.state()?.outcome);net.update(dt,game.headless?game.real*1000:performance.now());},draw:r=>app.draw(r)},ending:{view:'threequarter',enter(){game.focus(160,140,25);},update:dt=>app.art.update(dt,{won:true}),draw:r=>app.draw(r)}};\n    game.hook('input',()=>{const I=game.input;if(app.attract){const moved=I.mouse.t!==app.attractMouse;app.attractMouse=I.mouse.t;if(I.anyPressed()||I.clicked()||moved&&I.mouse.t>0)app.wake();}if(!app.attract&&game.sceneName==='title'&&I.mouse.t!==app.lastIdleMouse){app.lastIdleMouse=I.mouse.t;app.cabinet.wake();}if(app.hold&&(game.paused||ui.screen||I.padLost))app.releaseHold(true);if(app.wakeUntil&&game.real<app.wakeUntil){I.clear();I.consumeAll();}});\n    if(!options.headless){for(const type of ['pointerdown','keydown','touchstart'])addEventListener(type,()=>{if(app.attract){app.wake();return;}app.sound.activate();},{capture:true,signal:game._abort.signal});addEventListener('blur',()=>app.releaseHold(true),{signal:game._abort.signal});addEventListener('visibilitychange',()=>{if(document.hidden)app.releaseHold(true);},{signal:game._abort.signal});}\n    game.debug={snapshot:()=>({title:W.TITLE,scene:game.sceneName,page:app.menuPage,tool:app.tool,focus:app.target()?.id,board:app.boardId,attract:app.attract,net:{mode:net.mode,authority:net.authority,me:net.me,status:net.status,syncing:net.syncing,ended:net.ended,bytesMax:net.bytesMax},state:app.sim()?.publicState()||net.state,settings:{music:settings.music,voice:settings.voice,glyphs:settings.glyphs},errors:game.errors})};\n    app.dispose=()=>{net.cleanup();app.sound.stop();game.dispose();};\n    game.start({scene:'title',scenes});app.title();\n    if(!options.headless)net.connectHub().then(active=>{if(active){ui.hide();app.setLayout('evidence');game.live=true;game.o.autoPause=false;game.go('field',null,{fade:0});}else app.title();}).catch(e=>{app.notice('Hub connection failed: '+e.message);});\n    globalThis.__game=game;globalThis.__wired=app;return app;\n  };\n","exit_code":0,"status":"completed"}}
