{"type":"item.completed","item":{"id":"item_142","type":"command_execution","command":"/bin/bash -lc \"sed -n '985,1062p' src/app.js && sed -n '285,299p' tests/browser.py && tail -22 tools/build.mjs\"","aggregated_output":"      const show = () =>\n        ui.show('ending', {\n          kicker: 'THREE CALLS · ONE VERY LONG NIGHT',\n          title: i === 2 ? 'All wired up. All clear.' : 'A city exhales.',\n          text: beats[i],\n          actions: [\n            [\n              i < 2 ? 'Continue' : 'Acknowledgments',\n              () => {\n                if (i < 2) {\n                  i++;\n                  show();\n                } else app.about(0);\n              },\n            ],\n            ['Case files', () => app.cases()],\n          ],\n          back: () => app.cases(),\n        });\n      show();\n    };\n    app.about = (page = 0) => {\n      app.releaseHold(true);\n      const report = W.REPORT,\n        groups = report\n          ? [\n              [\n                'Source Information',\n                Object.entries(report.sourceInformation)\n                  .map(([k, v]) => `${k}: ${v}`)\n                  .join('\\n'),\n              ],\n              [\n                'Testing Feedback',\n                report.testingFeedback.map((v, i) => `${i + 1}. ${v}`).join('\\n\\n'),\n              ],\n              [\n                'Engine Feedback',\n                report.engineFeedback\n                  .slice(0, 3)\n                  .map((v, i) => `${i + 1}. ${v}`)\n                  .join('\\n\\n'),\n              ],\n              [\n                'Engine Feedback · continued',\n                report.engineFeedback\n                  .slice(3)\n                  .map((v, i) => `${i + 4}. ${v}`)\n                  .join('\\n\\n'),\n              ],\n              [\n                'Prompt Feedback',\n                report.promptFeedback.map((v, i) => `${i + 1}. ${v}`).join('\\n\\n'),\n              ],\n              [\n                'Acknowledgments',\n                'Original game: Bomb Squad (1982), Mattel Electronics. Design/program: Gene Smith and Shatao Lin; graphics: Kai Tran; sound: Russ Lieblich; voices: Phil Proctor and Peter Bergman. Source research: Blue Sky Rangers manual and creator-maintained history.\\n\\nOriginal game here: Brasswater, Nell, Vex, campaign, art, voices, score, puzzles and cooperative rules. my-3D2dge 0.89.1 by Michael Crosato (MIT); PeerJS 1.5.5 (MIT); AI Hub protocol 1/client 1.4.0. Full dependency notices are embedded in this HTML and preserved in vendor/. No original game assets or recorded audio are shipped.',\n              ],\n            ]\n          : [\n              [\n                'Build information',\n                'Source: Bomb Squad (1982). Plan: PLAN.md. Usage: added on import.',\n              ],\n            ];\n      page = (page + groups.length) % groups.length;\n      app.setLayout('about');\n      ui.show('about', {\n        kicker: `ABOUT & CREDITS · ${page + 1}/${groups.length}`,\n        title: groups[page][0],\n        text: groups[page][1],\n        actions: [\n          ['Next page', () => app.about(page + 1)],\n          ['Previous page', () => app.about(page - 1)],\n          [\n            'Back',\n            () => {\n              ui.hide();\n        }''')\n        assert result['music']==.1 and result['musicDefault']==.1\n        assert result['finite'] and result['peak']>.001 and result['rms']>.0001\n        page.evaluate('__game.settings.set(\"sound\",false)')\n        assert page.evaluate('__game.audio._master.gain.value')==0\n        page.evaluate('__game.settings.set(\"sound\",true)')\n        page.evaluate('__wired.sound.say(\"urgent instruction\", \"nell\", 3)')\n        assert not page.evaluate('__wired.sound.say(\"unimportant taunt\", \"vex\", 0)')\n        return result\n    finally:ctx.close()\n\n\ndef attract(browser):\n    ctx,page=new_page(browser)\n    try:\n  read('vendor/PEERJS-LICENSE') +\n  '\\nAI Hub client 1.4.0 is included verbatim from michaelcrosato/ai-hub; upstream license unknown.\\n-->\\n</body></html>\\n';\nconst dest = path.join(root, '..', run.slug + '.html');\nfs.writeFileSync(dest, html);\nfs.writeFileSync(\n  path.join(root, 'evidence/build.json'),\n  JSON.stringify(\n    {\n      artifact: path.basename(dest),\n      bytes: Buffer.byteLength(html),\n      sha256: crypto.createHash('sha256').update(html).digest('hex'),\n      hubSha256: crypto.createHash('sha256').update(hub).digest('hex'),\n      engine: '0.89.1',\n      engineRevision: '8ecc2f62353761187bdfe226f327b7ea5d2eb691',\n      hub: '1.4.0',\n      hubRevision: '35a1047f2067b2af3de3943f0fe452f39105d869',\n    },\n    null,\n    2,\n  ) + '\\n',\n);\nif (!process.argv.includes('--quiet')) process.stdout.write(path.basename(dest) + '\\n');\n","exit_code":0,"status":"completed"}}
