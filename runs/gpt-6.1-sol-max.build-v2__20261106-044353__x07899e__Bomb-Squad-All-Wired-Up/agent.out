serving)\\\", \\\"else {const target=app.target();if(target)target.legal=app.legal(target,b);app.art.board(r,b,target,app.tool,app.observing);}\\\")\n# A stable native portrait beside the captions.\ns=s.replace(\\\"if(app.editorPreview&&app.menuPage==='editor')\\\", \\\"if(s&&app.menuPage==='board')r.overlay(g=>{const rig=app.radio.startsWith('VEX')?app.art.vex:app.art.nell;rig.drawPortrait(g,10,r.H-35,26,{zoom:2,bg:'#173238',frame:true,weapon:false});});\\\\n      if(app.editorPreview&&app.menuPage==='editor')\\\")\nanchor=\\\"    app.target=()=>\\\"\ninsert=\\\"\\\"\\\"    app.legal=(t,b)=>{const p=b.components.find(c=>c.id===t.target),current=b.order[b.job],tool=W.TOOLS[app.tool];if(t.kind==='test')return \"'!!b.held;if(tool==='\"'foam')return b.fire;if(b.fire)return false;if(tool==='solder')return \"'!!p&&(b.fault?.component===p.id&&b.fault.terminal===(t.terminal||0)||p.phase==='\"'placed'&&p.leads[t.terminal||0]\"'!==2);if(b.fault)return false;if(tool==='\"'cut')return \"'!!p&&p.id===current&&p.phase==='\"'attached'&&p.leads[t.terminal||0]\"'!==1;if(tool==='\"'grip'){if(t.kind==='spare')return true;return \"'!!p&&p.id===current&&(p.phase==='\"'attached'&&p.leads.every(v=>v===1)||p.phase==='empty'&&\"'!!b.held||p.phase==='\"'wrong'||p.phase==='placed');}return false;};\n\\\"\\\"\\\"\ns=s.replace(anchor,insert+anchor)\nopen(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
