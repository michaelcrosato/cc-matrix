{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os,subprocess\nfrom pathlib import Path\nroot=Path.cwd().resolve();parents={};argsmap={};own=[]\nfor item in Path('/proc').iterdir():\n    if not item.name.isdigit(): continue\n    try:\n        pid=int(item.name);args=(item/'cmdline').read_bytes().split(b'\\\\0');stat=(item/'stat').read_text();ppid=int(stat[stat.rfind(')')+2:].split()[1]);parents[pid]=ppid;argsmap[pid]=args\n        if b'test.py' in args and Path(os.readlink(item/'cwd')).resolve()==root: own.append(pid)\n    except (OSError,ValueError): pass\nfor _ in range(8):\n    own.extend(pid for pid,parent in parents.items() if parent in own and pid not in own)\nif own:\n    r=subprocess.run(['ps','-p',','.join(map(str,own)),'-o','pid,ppid,etime,pcpu,rss,stat,comm'],capture_output=True,text=True);print(r.stdout)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
