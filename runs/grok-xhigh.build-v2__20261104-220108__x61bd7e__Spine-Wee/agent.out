 how far it rises over the higher end (24), or time: the seconds it\"},{\"line_number\":777,\"content\":\"    /** deadzone: how far a gamepad stick moves before it counts (0..0.8); padIndex, padId: the gamepad in use (null\"},{\"line_number\":786,\"content\":\"     *  lives on; stickRadius: how far (CSS pixels) a finger drags for full tilt; stickDeadzone: the part of that radius a\"},{\"line_number\":1099,\"content\":\"  /** how far the touch stick's finger moved since the last step, in screen pixels [dx, dy] (the HUD's space), or null while\"},{\"line_number\":1115,\"content\":\"  /** [dx, dy] how far a drag moved this step: one finger on open ground (not a box), or a mouse's middle or right button;\"},{\"line_number\":3988,\"content\":\" * 10l. MORE INPUT  input.value(a) (how far an action is pressed: a trigger's travel, a stick's push), game.hook (a\"},{\"line_number\":3992,\"content\":\"/** how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's\"},{\"line_number\":3994,\"content\":\"Input.prototype.value = function (a) {\"},{\"line_number\":4086,\"content\":\"     *  ground direction it moved, a unit vector; hurtW: 0..1, how far into the hurt flinch */\"},{\"line_number\":4088,\"content\":\"    /** atkZ: the height of the weapon hand during an attack; reach: how far it reaches forward; spin: the body's\"},{\"line_number\":4181,\"content\":\"    /** downW: how far down it is, 0..1 (state down, pose 'down' or 'die'): it falls faster and faster and gets up steadily */\"},{\"line_number\":4235,\"content\":\"    /** lunge: how far the body leans into an attack now, world units; hop: how high an attack's hop lifts it now */\"},{\"line_number\":6192,\"content\":\"   *  (how far (x, y) is from the side of its cell it leaves by) }, or null where the field doesn't reach (or at the target).\"},{\"line_number\":7246,\"content\":\"  /** the beat playing now and how far through it (0..1): [name, u] */\"},{\"line_number\":7300,\"content\":\" *    fell (how far it fell, on the step it lands), hurt (that fall was over hurtAt), inHazard (it landed in deep water\"},{\"line_number\":10024,\"content\":\"     *  failed: why it couldn't start, or null; bands: how many light bands (fewer is more retro); wrap: how far\"},{\"line_number\":10025,\"content\":\"     *  light wraps round wall corners, 0..1; ambient: the unlit color, [r, g, b] 0..1; spill: how far light spills\"},{\"line_number\":11068,\"content\":\"  // how far a wide room scrolls to keep the hero in the middle\"},{\"line_number\":11808,\"content\":\"   *  input, null], rounds: 2 (wins needed), time: 99, x0: 0, x1: 520, span: 250 (how far apart they may be), camera:\"},{\"line_number\":13410,\"content\":\"  /** how far past the camera the player's car stands when drawn at the screen's bottom, for a camera h over the road;\"},{\"line_number\":14484,\"content\":\"  // how far a is from b's edge (a building's footprint, a unit's circle)\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-afc5b2d0-d607-44d8-8f1f-5eeafb71fcc3-42","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"3960→      if (mode === 'save' && s.slot !== 'auto') acts.push({ label: 'Save here', primary: true, fn: () => {\\n        const go = () => { this._last = s.slot; this.save(s.slot); page(); saved(); };\\n        if (s.empty) { sh.back(); go(); } else ask('Save over ' + name(s.slot) + '?', about(s) + ' is lost.', 'Save over it', () => { sh.back(); go(); });\\n      } });\\n      if (mode === 'load' && !s.empty) acts.push({ label: 'Load', primary: true, disabled: s.damaged || s.newer, fn: () => { const r = this.load(s.slot); sh.hide(); if (r) { sh.toast('Loaded', name(s.slot)); if (done) done(r); } } });\\n      if (!s.empty) acts.push({ label: 'Copy to…', fn: () => sh.show('saves-copy', { kicker: 'Copy', title: 'Copy ' + name(s.slot) + ' to', actions: this.list().filter(t => t.slot !== 'auto' && t.slot !== s.slot).map(t => ({ label: name(t.slot) + ' — ' + about(t), fn: () => {\\n        const go = () => { this.copy(s.slot, t.slot); sh.back(); sh.back(); page(); };\\n        if (t.empty) go(); else ask('Copy over ' + name(t.slot) + '?', about(t) + ' is lost.', 'Copy over it', go);\\n      } })).concat([['Back', () => sh.back()]]) }) });\\n      if (!s.empty) acts.push({ label: 'Erase', fn: () => ask('Erase ' + name(s.slot) + '?', about(s) + ' is lost.', 'Erase it', () => { this.erase(s.slot); sh.back(); page(); }) });\\n3970→      acts.push(['Back', () => sh.back()]);\\n      sh.show('saves-slot', { kicker: mode === 'save' ? 'Save' : 'Load', title: name(s.slot), text: about(s), actions: acts });\\n    };\\n    if (this.game.pause('menu')) sh._ownPause = true;\\n    page(); return true;\\n  }\\n}\\n/** game.saves: the save slots (section 10k), made when first read */\\nObject.defineProperty(Game.prototype, 'saves', { configurable: true, get() { return this._saves || (this._saves = new Saves(this, this.o.menu && this.o.menu.saves)); } });\\nE.Saves = Saves;\\n3980→HOOKS.step.push((game, dt) => { const s = game._saves, sc = game.scene; if (s && sc && (sc.pausable || game.sceneName === 'main')) s.played += dt; });   // time played: the game's scenes, not its titles\\nHOOKS.pause = (sh, acts) => {   // the pause menu's Save and Load, with menu: { saves }\\n  const g = sh._game; if (!(g.o.menu && g.o.menu.saves)) return;\\n  if (g.saves.canSave) acts.push(['Save', () => g.saves.show('save')]);\\n  acts.push(['Load', () => g.saves.show('load')]);\\n};\\n\\n/* =============================================================================\\n * 10l. MORE INPUT  input.value(a) (how far an action is pressed: a trigger's travel, a stick's push), game.hook (a\\n *    game's own function on the engine's clock), and the notice a game made with touch: 'never' shows on a phone. In a\\n3990→ *    section of its own: a kit whose game calls none of them leaves it out\\n * ============================================================================= */\\n/** how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's\\n *  direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1 */\\nInput.prototype.value = function (a) {\\n  const m = this.map[a]; if (!m) { this._check(a); return 0; } if (this._suppressed.has(a)) return 0;\\n  const PV = this.padValues || [], mv = this.padMove || [0, 0], st = this.stickOn ? this.stick : [0, 0], push = { up: [1, -1], down: [1, 1], left: [0, -1], right: [0, 1] };\\n  let v = 0;\\n  for (const c of m) {\\n    const k = /^Pad(\\\\d+)$/.exec(c), ax = /^Pad(R?)Axis(Up|Down|Left|Right)$/.exec(c), pv = k ? PV[+k[1]] || 0 : 0;\\n4000→    if (k) v = Math.max(v, pv);\\n    if (ax) { const [i, s] = push[ax[2].toLowerCase()], q = ax[1] ? this.padAim || [0, 0] : mv; v = Math.max(v, clamp(q[i] * s, 0, 1)); }\\n    else if (this.held.has(c)) v = Math.max(v, k && pv > 0 ? pv : 1);\\n  }\\n  if (push[a]) { const [i, s] = push[a]; v = Math.max(v, clamp(st[i] * s, 0, 1)); }\\n  return v;\\n};\\n/** a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input\\n *  is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an\\n *  attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it */\\n4010→Game.prototype.hook = function (kind, fn) {\\n  const L = (this._own || (this._own = { input: [], step: [], enter: [] }))[kind];\\n  if (!L) throw new Error('game.hook(\\\"' + kind + '\\\"): the hooks are input, step and enter');\\n  L.push(fn); return () => { const i = L.indexOf(fn); if (i >= 0) L.splice(i, 1); };\\n};\\n/** touch: 'never' on a device with touch alone: \\\"Controller or keyboard required\\\", with Settings, until a controller\\n *  is connected or a key pressed */\\nGame.prototype._needSync = function () {\\n  const fine = window.matchMedia && matchMedia('(any-pointer: fine)').matches, coarse = window.matchMedia && matchMedia('(pointer: coarse)').matches;\\n  const need = coarse && !fine && !this._keyed && this.input.padIndex === null, el = this._needEl;\\n4020→  if (!need) { if (el) el.style.display = 'none'; return; }\\n  if (!el) {\\n    const d = this._needEl = document.createElement('div'); d.setAttribute('data-sys', 'need'); d.setAttribute('role', 'alert');\\n    d.style.cssText = 'position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;background:rgba(5,3,12,.88);color:#f4f0ff;font:600 17px/1.45 system-ui,sans-serif';\\n    d.innerHTML = '<div><div style=\\\"font-size:21px;margin-bottom:8px\\\">Controller or keyboard required</div><div style=\\\"opacity:.8;margin-bottom:18px\\\">This game plays with a controller or a keyboard. Connect one, then press any button.</div><button type=\\\"button\\\" style=\\\"font:inherit;padding:10px 22px;border-radius:10px;border:2px solid #b8a8ff;background:#2a2050;color:#fff;min-width:44px;min-height:44px\\\">Settings</button></div>';\\n    d.querySelector('button').onclick = () => this.menu('settings');\\n    (this.screen.canvas.parentElement || document.body).appendChild(d);\\n  }\\n  this._needEl.style.display = this.shell && this.shell.screen ? 'none' : 'flex';   // (Settings open over it: hidden while it is)\\n};\\n4030→/* =============================================================================\\n * 11. HUMANOID RIG\\n *    Local frame: f = forward, r = right, z = up. The rig poses itself every step\\n *    from movement, attacks and state, then projects through any view.\\n *    Attack specs (angles relative to facing, + = toward the right hand):\\n *      { a0, a1, z0, z1, reach, blade, spin }   e.g. horizontal slash a0: 1.7 -> a1: -1.9\\n *    Drive with rig.update(dt, { x, y, z, vx, vy, facing, dash, hurt, attack:{ spec, phase, u } })\\n *    where phase is 'wind' | 'active' | 'recover' and u is 0..1 progress in that phase.\\n * ============================================================================= */\\nconst HUMAN_COLORS = {\",\"content_concise\":\"3960→      if (mode === 'save' && s.slot !== 'auto') acts.push({ label: 'Save here', primary: true, fn: () => {\\n        const go = () => { this._last = s.slot; this.save(s.slot); page(); saved(); };\\n        if (s.empty) { sh.back(); go(); } else ask('Save over ' + name(s.slot) + '?', about(s) + ' is lost.', 'Save over it', () => { sh.back(); go(); });\\n      } });\\n      if (mode === 'load' && !s.empty) acts.push({ label: 'Load', primary: true, disabled: s.damaged || s.newer, fn: () => { const r = this.load(s.slot); sh.hide(); if (r) { sh.toast('Loaded', name(s.slot)); if (done) done(r); } } });\\n      if (!s.empty) acts.push({ label: 'Copy to…', fn: () => sh.show('saves-copy', { kicker: 'Copy', title: 'Copy ' + name(s.slot) + ' to', actions: this.list().filter(t => t.slot !== 'auto' && t.slot !== s.slot).map(t => ({ label: name(t.slot) + ' — ' + about(t), fn: () => {\\n        const go = () => { this.copy(s.slot, t.slot); sh.back(); sh.back(); page(); };\\n        if (t.empty) go(); else ask('Copy over ' + name(t.slot) + '?', about(t) + ' is lost.', 'Copy over it', go);\\n      } })).concat([['Back', () => sh.back()]]) }) });\\n      if (!s.empty) acts.push({ label: 'Erase', fn: () => ask('Erase ' + name(s.slot) + '?', about(s) + ' is lost.', 'Erase it', () => { this.erase(s.slot); sh.back(); page(); }) });\\n3970→      acts.push(['Back', () => sh.back()]);\\n      sh.show('saves-slot', { kicker: mode === 'save' ? 'Save' : 'Load', title: name(s.slot), text: about(s), actions: acts });\\n    };\\n    if (this.game.pause('menu')) sh._ownPause = true;\\n    page(); return true;\\n  }\\n}\\n/** game.saves: the save slots (section 10k), made when first read */\\nObject.defineProperty(Game.prototype, 'saves', { configurable: true, get() { return this._saves || (this._saves = new Saves(this, this.o.menu && this.o.menu.saves)); } });\\nE.Saves = Saves;\\n3980→HOOKS.step.push((game, dt) => { const s = game._saves, sc = game.scene; if (s && sc && (sc.pausable || game.sceneName === 'main')) s.played += dt; });   // time played: the game's scenes, not its titles\\nHOOKS.pause = (sh, acts) => {   // the pause menu's Save and Load, with menu: { saves }\\n  const g = sh._game; if (!(g.o.menu && g.o.menu.saves)) return;\\n  if (g.saves.canSave) acts.push(['Save', () => g.saves.show('save')]);\\n  acts.push(['Load', () => g.saves.show('load')]);\\n};\\n\\n/* =============================================================================\\n * 10l. MORE INPUT  input.value(a) (how far an action is pressed: a trigger's travel, a stick's push), game.hook (a\\n *    game's own function on the engine's clock), and the notice a game made with touch: 'never' shows on a phone. In a\\n3990→ *    section of its own: a kit whose game calls none of them leaves it out\\n * ============================================================================= */\\n/** how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's\\n *  direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1 */\\nInput.prototype.value = function (a) {\\n  const m = this.map[a]; if (!m) { this._check(a); return 0; } if (this._suppressed.has(a)) return 0;\\n  const PV = this.padValues || [], mv = this.padMove || [0, 0], st = this.stickOn ? this.stick : [0, 0], push = { up: [1, -1], down: [1, 1], left: [0, -1], right: [0, 1] };\\n  let v = 0;\\n  for (const c of m) {\\n    const k = /^Pad(\\\\d+)$/.exec(c), ax = /^Pad(R?)Axis(Up|Down|Left|Right)$/.exec(c), pv = k ? PV[+k[1]] || 0 : 0;\\n4000→    if (k) v = Math.max(v, pv);\\n    if (ax) { const [i, s] = push[ax[2].toLowerCase()], q = ax[1] ? this.padAim || [0, 0] : mv; v = Math.max(v, clamp(q[i] * s, 0, 1))