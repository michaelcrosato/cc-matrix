amed = root.parent && root.parent !== root;\\n  } catch (e) {\\n    framed = true;\\n  }\\n  var search = String(root.location && root.location.search);\\n20→  var flagged = /[?&]aihub=/.test(search);\\n  var seedArg = /[?&]aihub-seed=(\\\\d+)/.exec(search);\\n\\n  var hub = {\\n    version: VERSION,\\n    protocol: 1,\\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\\n    active: !!(flagged && framed),\\n    me: null,\\n    host: null,\\n30→    isHost: false,\\n    players: [],\\n    mode: null,\\n    seed: 0,\\n    limitMs: 0,\\n    round: 0,\\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\\n    splash: false,\\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\\n    seeded: false,\\n40→  };\",\"content_concise\":\"1→/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\\n(function (root) {\\n  'use strict';\\n  if (root.AIHub) return;\\n\\n  var VERSION = '1.4.0';\\n  var HELLO_EVERY_MS = 500;\\n  var HELLO_TIMEOUT_MS = 10000;\\n  var PROGRESS_EVERY_MS = 1000;\\n10→  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\\n\\n  var framed = false;\\n  try {\\n    framed = root.parent && root.parent !== root;\\n  } catch (e) {\\n    framed = true;\\n  }\\n  var search = String(root.location && root.location.search);\\n20→  var flagged = /[?&]aihub=/.test(search);\\n  var seedArg = /[?&]aihub-seed=(\\\\d+)/.exec(search);\\n\\n  var hub = {\\n    version: VERSION,\\n    protocol: 1,\\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\\n    active: !!(flagged && framed),\\n    me: null,\\n    host: null,\\n30→    isHost: false,\\n    players: [],\\n    mode: null,\\n    seed: 0,\\n    limitMs: 0,\\n    round: 0,\\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\\n    splash: false,\\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\\n    seeded: false,\\n40→  };\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/vendor/session.js\",\"offset\":null,\"limit\":40,\"raw_output\":\"/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\\n(function (root) {\\n  'use strict';\\n  if (root.AIHub) return;\\n\\n  var VERSION = '1.4.0';\\n  var HELLO_EVERY_MS = 500;\\n  var HELLO_TIMEOUT_MS = 10000;\\n  var PROGRESS_EVERY_MS = 1000;\\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\\n\\n  var framed = false;\\n  try {\\n    framed = root.parent && root.parent !== root;\\n  } catch (e) {\\n    framed = true;\\n  }\\n  var search = String(root.location && root.location.search);\\n  var flagged = /[?&]aihub=/.test(search);\\n  var seedArg = /[?&]aihub-seed=(\\\\d+)/.exec(search);\\n\\n  var hub = {\\n    version: VERSION,\\n    protocol: 1,\\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\\n    active: !!(flagged && framed),\\n    me: null,\\n    host: null,\\n    isHost: false,\\n    players: [],\\n    mode: null,\\n    seed: 0,\\n    limitMs: 0,\\n    round: 0,\\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\\n    splash: false,\\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\\n    seeded: false,\\n  };\\n\",\"total_lines\":488}}","is_error":false}]},"parent_tool_us