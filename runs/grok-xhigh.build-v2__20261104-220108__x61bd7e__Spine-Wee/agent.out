1,121,58,32,39,118,111,105,99,101,39,44,32,108,97,98,101,108,58,32,39,86,111,105,99,101,39,44,32,116,121,112,101,58,32,39,115,108,105,100,101,114,39,44,32,118,97,108,117,101,58,32,48,46,56,44,32,109,105,110,58,32,48,44,32,109,97,120,58,32,49,44,32,115,116,101,112,58,32,48,46,48,53,44,32,97,112,112,108,121,58,32,102,117,110,99,116,105,111,110,32,40,103,44,32,118,41,32,123,32,103,46,97,117,100,105,111,46,118,111,105,99,101,86,111,108,117,109,101,32,61,32,118,59,32,103,46,97,117,100,105,111,46,97,112,112,108,121,86,111,108,117,109,101,40,41,59,32,125,32,125,44,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":94,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs\",\"matches\":[{\"line_number\":326,\"content\":\"add('rules', 'dev sliders', () => {\"},{\"line_number\":335,\"content\":\"    const beforeI = G.dev.i;\"},{\"line_number\":341,\"content\":\"    const moved = (beforeI - G.dev.i + n) % n;\"},{\"line_number\":342,\"content\":\"    assert(moved === 1, code + ' rows ' + beforeI + ' -> ' + G.dev.i);\"},{\"line_number\":344,\"content\":\"  rowStep('ArrowUp');\"},{\"line_number\":345,\"content\":\"  rowStep('Pad12');\"},{\"line_number\":354,\"content\":\"  assert(G.dev.i === 0, 'slider not home ' + G.dev.i);\"},{\"line_number\":358,\"content\":\"  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\"},{\"line_number\":389,\"content\":\"  const sliderTo = function (key) {\"},{\"line_number\":391,\"content\":\"    assert(want >= 0, 'no slider ' + key);\"},{\"line_number\":392,\"content\":\"    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\"},{\"line_number\":394,\"content\":\"    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\"},{\"line_number\":433,\"content\":\"  sliderTo('trayFric');\"},{\"line_number\":436,\"content\":\"  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\"},{\"line_number\":449,\"content\":\"  sliderTo('ropeS');\"},{\"line_number\":452,\"content\":\"  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\"},{\"line_number\":508,\"content\":\"  /* Two players: P1 is the left half, so down is KeyS. A fresh press each time, or repeat() waits. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/hub/harness.html\",\"matches\":[{\"line_number\":179,\"content\":\"  grid.style.gridTemplateRows = `repeat(${Math.ceil(copies / (copies > 1 ? 2 : 1))}, 1fr)`;\"},{\"line_number\":457,\"content\":\"    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/hub/game.html\",\"matches\":[{\"line_number\":1339,\"content\":\"      if (this._codes[e.code] || (share && share.length)) { e.preventDefault(); if (!e.repeat) { if (this._codes[e.code]) this.press(e.code); if (share) for (const q of share) q.press(e.code); } }\"},{\"line_number\":1340,\"content\":\"      else if (this._zoomOn && ZOOM_KEYS[e.code] && !e.ctrlKey && !e.metaKey && !e.altKey) { e.preventDefault(); if (!e.repeat) this._zoomAcc *= ZOOM_KEYS[e.code]; }   // - and =, where no action uses them\"},{\"line_number\":1564,\"content\":\"  /** pressed, then repeats while held (after `delay` s, every `rate` s): menu cursors, puzzle pieces */\"},{\"line_number\":1565,\"content\":\"  repeat(a, delay = .3, rate = .08) {\"},{\"line_number\":1806,\"content\":\"const FIXED_CODES = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight']);\"},{\"line_number\":1819,\"content\":\"  Enter: 'Enter', NumpadEnter: 'Enter', Escape: 'Esc', Backspace: 'Backspace', Tab: 'Tab', CapsLock: 'Caps', ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→',\"},{\"line_number\":1826,\"content\":\"  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\"},{\"line_number\":1832,\"content\":\"  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\"},{\"line_number\":1840,\"content\":\"  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\"},{\"line_number\":1846,\"content\":\"  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\"},{\"line_number\":2711,\"content\":\"        mask(xG); if (dith) { xG.fillStyle = xG.createPattern(this._checker, 'repeat'); xG._c = null; xG.translate((this.ix + this.iy) & 1, 0); xG.fillRect(x0 - 2, y0, w + 2, h); }\"},{\"line_number\":3520,\"content\":\"      const r = this.r; g.save(); if (E.style.trans === 'dither') g.fillStyle = g.createPattern(r._checker, 'repeat'); else { g.fillStyle = '#05030c'; g.globalAlpha = .55; } g.fillRect(0, 0, r.bw, r.bh); g.restore(); g._c = null;\"},{\"line_number\":3525,\"content\":\"    if (fx) { const a = (1 - fx.t / fx.dur) * (fx.k === undefined ? 1 : fx.k); if (a <= 0) this._flash = null; else this.r.overlay(g => { const r = this.r; g.save(); if (E.style.trans === 'dither') { const pat = r._fadePattern(a * .85), c = mkCanvas(4, 4), cg = c.getContext('2d'); cg.drawImage(pat, 0, 0); cg.globalCompositeOperation = 'source-in'; cg.fillStyle = fx.color; cg.fillRect(0, 0, 4, 4); g.fillStyle = g.createPattern(c, 'repeat'); } else { g.fillStyle = fx.color; g.globalAlpha = qa(a * .75); g.globalCompositeOperation = 'lighter'; } g.fillRect(0, 0, r.bw, r.bh); g.restore(); g._c = null; }); }\"},{\"line_number\":3528,\"content\":\"    else if (fl > 0) this.r.overlay(g => { const r = this.r, c = F.kind === 'white' ? '#ffffff' : '#000000'; g.save(); if (E.style.trans === 'dither') g.fillStyle = g.createPattern(r._fadePattern(fl, c), 'repeat'); else { g.fillStyle = c; g.globalAlpha = Math.round(fl * 16) / 16; } g.fillRect(0, 0, r.bw, r.bh); g.restore(); g._c = null; });\"},{\"line_number\":3558,\"content\":\"/** the standard settings by key: { group, label, type: 'toggle' | 'slider' | 'select', value (the default, or a\"},{\"line_number\":3563,\"content\":\"  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\"},{\"line_number\":3569,\"content\":\"  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\"},{\"line_number\":3570,\"content\":\"  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\"},{\"line_number\":3571,\"content\":\"  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\"},{\"line_number\":3573,\"content\":\"  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\"},{\"line_number\":3575,\"content\":\"  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\"},{\"line_number\":3576,\"content\":\"  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\"},{\"line_number\":3578,\"content\":\"  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { for (const q of g._players || [g.input]) q.deadzone = v; } },\"},{\"line_number\":3583,\"content\":\"  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { for (const q of g._players || [g.input]) q.rumbleScale = v; } },\"},{\"line_number\":3586,\"content\":\"  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\"},{\"line_number\":3587,\"content\":\"  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\"},{\"line_number\":3593,\"content\":\"  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\"},{\"line_number\":3623,\"content\":\"  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\"},{\"line_number\":3629,\"content\":\"    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }, sp);\"},{\"line_number\":3643,\"content\":\"  /** change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told.\"},{\"line_number\":3900,\"content\":\"    this._left = o.repeat === undefined ? 0 : o.repeat < 0 ? Infinity : o.repeat;\"},{\"line_number\":3923,\"content\":\" * delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }).\"},{\"line_number\":4041,\"content\":\"    g.save(); g.fillStyle = g.createPattern(r._fadePattern(.5), 'repeat'); g.fillRect(F.out ? x : x - e, 0, e, H); g.restore();\"},{\"line_number\":4065,\"content\":\"    g.save(); g.fillStyle = g.createPattern(pat, 'repeat'); g.fillRect(0, 0, r.bw, r.bh); g.restore();\"},{\"line_number\":4249,\"content\":\"  right: { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], buttons: [['Period', 'Numpad1'], ['Slash', 'Numpad2'], ['Comma', 'Numpad3'], ['KeyL', 'Numpad4'], ['Semicolon', 'Numpad5'], ['Quote', 'Numpad6'], ['KeyK', 'Numpad7'], ['KeyM', 'Numpad8']],\"},{\"line_number\":6460,\"content\":\"    // (wrapped into the face: a wall face or a tile past the first repeats the crate)\"},{\"line_number\":9371,\"content\":\" *  square: it repeats every size; a face pattern's whole face), px: 2 (pixels a unit), lid: false (true: as on a face\"},{\"line_number\":9723,\"content\":\"      if (inp.repeat('up') || inp.repeat('left')) { this.choice = (this.choice + this.choices.length - 1) % this.choices.length; this.game.audio.sfx('select'); }\"},{\"line_number\":9724,\"content\":\"      if (inp.repeat('down') || inp.repeat('right')) { this.choice = (this.choice + 1) % this.choices.length; this.game.audio.sfx('select'); }\"},{\"line_number\":9816,\"content\":\"  /** move the cursor (up, down; held keys repeat; the mouse over an entry) and pick (confirm, or a click or tap on an\"},{\"line_number\":9823,\"content\":\"    if (any(I => I.repeat('up'))) { this.i = (this.i + n - 1) % n; this._skip(-1); }\"},{\"line_number\":9824,\"content\":\"    if (any(I => I.repeat('down'))) { this.i = (this.i + 1) % n; this._skip(1); }\"},{\"line_number\":9867,\"content\":\" *    (up / down / left / right turn a slider or a choice, confirm presses, cancel goes back, pause or Start closes the\"},{\"line_number\":9916,\"content\":\".esh-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:10px;margin:16px 0 8px}.esh-stats b{display:block;font:600 24px var(--title)}\"},{\"line_number\":9939,\"content\":\"   * - settings: settings.items: th