enes.about.pages = aboutPages();\\n      scenes.about.i = 0;\\n      G.phase = 'menu';\\n    },\\n    update() {\\n      G.phase = 'menu';\\n      const I = G.game.input;\\n      const pages = scenes.about.pages;\\n      if (I.pressed('confirm') || I.pressed('right')) {\\n1100→        if (scenes.about.i < pages.length - 1) scenes.about.i++;\\n        else go('title');\\n      } else if (I.pressed('cancel') || I.pressed('left')) {\\n        if (scenes.about.i > 0) scenes.about.i--;\\n        else go('title');\\n      }\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n      const p = scenes.about.pages[scenes.about.i];\\n1110→      hudName(r, p.h, '');\\n      r.overlay(function (g) {\\n        const words = String(p.t).split(' ');\\n        let line = '', y = 70;\\n        words.forEach(function (w) {\\n          const next = line ? line + ' ' + w : w;\\n          if (next.length > 32) { G.text(g, line, 12, y, '#20404c', 1); y += 14; line = w; }\\n          else line = next;\\n        });\\n        if (line) G.text(g, line, 12, y, '#20404c', 1);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js\",\"offset\":920,\"limit\":200,\"raw_output\":\"            G.text(g, title + '  ' + q.name + '  ' + (q.score || 0), 16, 78 + i * 16, '#20404c', 1);\\n          });\\n        });\\n      }\\n    }\\n  });\\n\\n  G.hubSendAcc = 0;\\n  G.hubProgAcc = 0;\\n  G.morningEvents = null;\\n  G.morningScores = [0, 0, 0];\\n\\n  function hubApi() { return (typeof AIHub !== 'undefined') ? AIHub : null; }\\n\\n  G.hubTimeUp = function () {\\n    if (G.hubReported) return;\\n    G.hubReported = true;\\n    const api = hubApi();\\n    if (!api || !api.result) return;\\n    const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n    try {\\n      api.result({\\n        score: total,\\n        stats: { Steadiness: Math.round((G.morningScores[0] || 0) / 10) + '%' },\\n        awards: [{ title: 'Most Still', detail: 'A quiet morning.' }]\\n      });\\n    } catch (e) { /* the hub already closed */ }\\n  };\\n  G.hubEnd = function () {\\n    G.hubOver = true;\\n    try { if (G.game) { G.game.audio.stopMusic(); G.game.audio.mute(true); G.game.input.clear(); } } catch (e) { /* quiet */ }\\n  };\\n\\n  /* A hub ghost is a translucent rig posed from the lean and the extra wobble it sent. */\\n  function drawGhostRigs(r) {\\n    if (!r || !r.actor || !G.ghosts || !G.makeRig) return;\\n    const ev = scenes.round.ei;\\n    G.ghosts.forEach(function (gh, i) {\\n      if (!gh || gh.a !== ev) return;\\n      const l = gh.l || [0, 0];\\n      const w = gh.w || [0, 0];\\n      const wob = [(l[1] || 0) + (w[1] || 0), (l[0] || 0) + (w[0] || 0)];\\n      try {\\n        if (!gh.rig) gh.rig = G.makeRig(G.playerOpts(null, 1.7));\\n        const rig = gh.rig;\\n        G.poseRig(rig, 'idle', (G.game && G.game.time) || 0, wob);\\n        rig.wob = wob.slice();\\n        G.stepRig(rig, 1 / 60, 0, 0);\\n        r.actor(-8 + i * 4.5, 8, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); }, { alpha: 0.5, outline: false });\\n      } catch (e) { /* the name still shows */ }\\n    });\\n  }\\n\\n  scenes.round = base({\\n    enter() {\\n      G.hubOver = false;\\n      G.hubReported = false;\\n      G.ghosts = [];\\n      G.morningScores = [0, 0, 0];\\n      G.hubSendAcc = 0;\\n      G.hubProgAcc = 1;\\n      G.session = null;\\n      scenes.round.dealt = false;\\n      scenes.round.ei = -1;\\n      try { G.playSong('studio'); } catch (e) { /* quiet */ }\\n    },\\n    update(dt) {\\n      if (G.hubOver) { G.phase = 'auto'; return; }\\n      const api = hubApi();\\n      const live = !!(api && G.inSession && api.time);\\n      const tms = live ? api.time() : (scenes.round.local = (scenes.round.local || 0) + dt * 1000);\\n      if (live && tms === -Infinity) {\\n        G.phase = 'menu';\\n        const I = G.game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) { try { api.answer('ready'); } catch (e) { /* early */ } }\\n        if (I.pressed('more')) { try { api.answer('more'); } catch (e) { /* early */ } }\\n        return;\\n      }\\n      if (tms < 0) { G.phase = 'auto'; G.left = Math.max(0, -tms / 1000); return; }\\n      if (!scenes.round.dealt) {\\n        let rng = E.rng(7);\\n        try { if (live && api.rng) rng = api.rng('deal'); } catch (e) { rng = E.rng(7); }\\n        G.morningEvents = G.deal(rng);\\n        scenes.round.dealt = true;\\n      }\\n      const span = 50;\\n      const ev = Math.min(2, Math.floor(tms / 1000 / span));\\n      const local = (tms / 1000) - ev * span;\\n      if (ev !== scenes.round.ei) {\\n        scenes.round.ei = ev;\\n        const id = G.morningEvents[ev];\\n        try {\\n          G.session = new G.Session({ id: id, tier: 1, limit: 40, skipToPlay: true, trial: true, seed: 20 + ev });\\n          if (!G.attracting) G.driver = null;\\n        } catch (e) { G.session = null; }\\n      }\\n      const s = G.session;\\n      if (s && local < 45 && s.phase !== 'results') {\\n        try { s.update(Math.min(dt, 0.05)); } catch (e) { /* keep the clock */ }\\n        if (s.phase === 'results') G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n        else G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n      }\\n      G.phase = 'play';\\n      G.left = Math.max(0, span - local);\\n      if (live) {\\n        G.hubSendAcc += dt;\\n        G.hubProgAcc += dt;\\n        if (G.hubSendAcc >= 0.1) {\\n          G.hubSendAcc = 0;\\n          const b = s && s.seats && s.seats[0] && s.seats[0].bal;\\n          try {\\n            api.send({ t: 'g', a: ev, l: [b ? b.px : 0, b ? b.py : 0], p: s ? s.phase : 'play', w: [0, 0], s: G.morningScores[ev] || 0 }, { reliable: false });\\n          } catch (e) { /* rate */ }\\n        }\\n        if (G.hubProgAcc >= 1) {\\n          G.hubProgAcc = 0;\\n          const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n          try { api.progress({ score: total, label: total + ' pts' }); } catch (e) { /* rate */ }\\n        }\\n      }\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n      const api = hubApi();\\n      const waiting = api && G.inSession && api.time && api.time() === -Infinity;\\n      if (waiting) {\\n        hudName(r, 'Spine Wee', 'Morning Class');\\n        r.overlay(function (g) {\\n          G.text(g, 'Lean. Stay steady. Most points wins.', 12, 70, '#20404c', 1);\\n          const ps = (G.hubInfo && G.hubInfo.players) || [];\\n          ps.forEach(function (p, i) { G.text(g, (p.name || ('Seat ' + (i + 1))), 12, 90 + i * 14, p.color || '#14a8c8', 1); });\\n          G.text(g, 'Ready', r.W / 2 - 40, r.H - 36, '#14a8c8', 2);\\n        });\\n        return;\\n      }\\n      if (G.session) { try { G.drawActivity(r, G.session); } catch (e) { /* room */ } }\\n      drawGhostRigs(r);\\n      r.overlay(function (g) {\\n        const names = (G.morningEvents || []).join('  ');\\n        G.text(g, names, 8, r.H - 24, '#5f7f8a', 1);\\n        G.ghosts.forEach(function (gh, i) {\\n          if (!gh || gh.a !== scenes.round.ei) return;\\n          G.text(g, gh.name || 'ghost', 20 + i * 40, 60, gh.color || '#ffffff', 1);\\n        });\\n      });\\n    }\\n  });\\n\\n  function aboutPages() {\\n    const A = G.ABOUT;\\n    const pages = [];\\n    if (A && A.sourceInformation) {\\n      const order = ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\\n      order.forEach(function (k) { pages.push({ h: 'Source', t: k + ': ' + A.sourceInformation[k] }); });\\n    } else pages.push({ h: 'Source', t: 'Source information is bound when the page is built.' });\\n    const blocks = [\\n      ['Testing Feedback', A && A.testingFeedback],\\n      ['Engine Feedback', A && A.engineFeedback],\\n      ['Prompt Feedback', A && A.promptFeedback]\\n    ];\\n    blocks.forEach(function (b) {\\n      const arr = b[1] || ['unknown'];\\n      arr.forEach(function (line) { pages.push({ h: b[0], t: String(line) }); });\\n    });\\n    pages.push({ h: 'Credits', t: 'my-3D2dge. Mesh2Motion and Quaternius, CC0. CMU Graphics Lab Motion Capture Database.' });\\n    pages.push({ h: 'Credits', t: 'No extra asset-store packs. Voices are synthesized. Music is synthesized.' });\\n    return pages;\\n  }\\n\\n  scenes.about = base({\\n    enter() {\\n      scenes.about.pages = aboutPages();\\n      scenes.about.i = 0;\\n      G.phase = 'menu';\\n    },\\n    update() {\\n      G.phase = 'menu';\\n      const I = G.game.input;\\n      const pages = scenes.about.pages;\\n      if (I.pressed('confirm') || I.pressed('right')) {\\n        if (scenes.about.i < pages.length - 1) scenes.about.i++;\\n        else go('title');\\n      } else if (I.pressed('cancel') || I.pressed('left')) {\\n        if (scenes.about.i > 0) scenes.about.i--;\\n        else go('title');\\n      }\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n      const p = scenes.about.pages[scenes.about.i];\\n      hudName(r, p.h, '');\\n      r.overlay(function (g) {\\n        const words = String(p.t).split(' ');\\n        let line = '', y = 70;\\n        words.forEach(function (w) {\\n          const next = line ? line + ' ' + w : w;\\n          if (next.length > 32) { G.text(g, line, 12, y, '#20404c', 1); y += 14; line = w; }\\n          else line = next;\\n        });\\n        if (line) G.text(g, line, 12, y, '#20404c', 1);\\n\",\"total_lines\":1193}}","is_error":false},{"type":"tool_result","tool_use_id":"call-32c0b0ee-1df0-4c46-a5f8-a5a706ece1da-9","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/* Boot: the game, the shell, the lean, saves, and the hub session. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function approach(cur, target, rate, dt) {\\n    const d = target - cur, m = rate * dt;\\n10→    if (Math.abs(d) <= m) return target;\\n    return cur + (d < 0 ? -m : m);\\n  }\\n\\n  function hashScene() {\\n    let hash = '';\\n    try { hash = (typeof location !== 'undefined' && location && location.hash) || ''; } catch (e) { hash = ''; }\\n    return hash;\\n  }\\n\\n20→  function topIdle(game) {\\n    const n = game.sceneName;\\n    if (G.attracting || G.inSession) return false;\\n    if (n === 'title' || n === 'slots' || n === 'about') return true;\\n    if (n === 'class' && !G.session) return true;\\n    return false;\\n  }\\n\\n  function freshLean() {\\n    return { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\\n30→  }\\n\\n  /* One player's lean. The first player keeps the mouse, the dev-panel key filter, and the shared breath latch. */\\n  function readOne(game, I, lean, dt, primary) {\\n    const panel = primary && !!(G.dev && G.dev.panel);\\n    const held = I.held;\\n    if (primary && (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown'))) {\\n      G._keyAt = I.clock;\\n    }\\n40→    const pad = I.padMove || [0, 0];\\n    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = primary ? I.pointer() : null;\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = primary && !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n50→      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n60→      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n70→        if (I.down('right')) kx += 1;\\n        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n80→        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (primary) {\\n      if (mode === 'toggle' && I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    } else if (mode === 'toggle' && I.pressed('breath')) lean._latch = !lean._latch;\\n90→    let target = 0;\\n    if (mode === 'toggle') target = (primary ? G._breathLatch : lean._latch) ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n100→    lean.jump = !!I.pressed('jump');\\n    lean.catchL = !!I.pressed('catchL');\\n    lean.catchR = !!I.pressed('catchR');\\n    lean.paceL = !!I.down('paceL');\\n    lean.paceR = !!I.down('paceR');\\n\\n    if (primary) {\\n      const cv = game.screen && game.screen.canvas;\\n      if (cv && cv.style) {\\n        const hide = lean.source === 'mouse' && (game.sceneName === 'play' || game.sceneName === 'duel' || game.sceneName === 'attract');\\n110→        cv.style.cursor = hide ? 'none' : '';\\n      }\\n    }\\n  }\\n\\n  function readLean(game, dt) {\\n    const players = (game.players && game.players.length) ? game.players : [game.input];\\n    if (!G.leans || G.leans[0] !== G.lean) G.leans = [G.lean];\\n    while (G.leans.length < players.length) G.leans.push(freshLean());\\n    if (G.leans.length > players.length) G.leans.length = players.length;\\n120→    readOne(game, players[0], G.lean, dt, true);\\n    for (let i = 1; i < players.length; i++) readOne(game, players[i], G.leans[i], dt, false);\\n  }\\n\\n  function installShellCss() {\\n    if (typeof document === 'undefined') return;\\n    if (!document.getElementById('spine-shell-css')) {\\n      const st = document.createElement('style');\\n      st.id = 'spine-shell-css';\\n      st.textContent = '@media (min-height:700px){.esh-mod{zoom:1.5}}@media (min-height:1000px){.esh-mod{zoom:2}}.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}';\\n130→      document.head.appendChild(st);\\n    }\\n    if (!G._hoverFocus) {\\n      G._hoverFocus = true;\\n      document.addEventListener('pointerover', function (e) {\\n        const b = e.target && e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\\n        if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true });\\n      });\\n    }\\n  }\\n140→\\n  function saveWrite() {\\n    if (G.attracting || G.inSession) return;\\n    const p = JSON.parse(JSON.stringify(G.profile));\\n    return { data: p, place: 'Day ' + p.day + '  ' + p.name, level: p.day };\\n  }\\n  function saveRead(save) {\\n    const d = (save && save.data) || {};\\n    const next = G.freshProfile(d.slot || 0);\\n    Object.assign(next, d);\\n150→    if (!next.look) next.look = { hair: 0, skin: 1, top: 0, bottom: 0 };\\n    if (!next.flags) next.flags = { arrival: false, tareDay: false, games: false };\\n    if (!next.unlocks) next.unlocks = [];\\n    if (!next.played) next.played = {};\\n    if (!next.bestPct) next.bestPct = {};\\n    if (!next.spineDays) next.spineDays = [next.spine || 71];\\n    G.profile = next;\\n  }\\n\\n  function wireHub(game) {\\n160→    if (!G.inSession || typeof AIHub === 'undefined' || !AIHub.on || !AIHub.connect) return;\\n    AIHub.on('message', function (d, from) {\\n      if (!d || d.t !== 'g') return;\\n      const gh = { t: 'g', a: d.a, l: d.l, p: d.p, w: d.w, s: d.s, from: from, name: String(from || 'ghost'), color: '#8fd3f4' };\\n      const i = G.ghosts.findIndex(function (q) { return q.from === from; });\\n      if (i >= 0) G.ghosts[i] = gh;\\n      else G.ghosts.push(gh);\\n      if (G.ghosts.length > 8) G.ghosts.shift();\\n    });\\n    AIHub.on('leave', function (info) {\\n170→      const id = info && info.id;\\n      G.ghosts = G.ghosts.filter(function (q) { return q.from !== id; });\\n    });\\n    AIHub.on('time-up', function () { G.hubTimeUp(); });\\n    AIHub.on('end', function () { G.hubEnd(); });\\n    AIHub.on('card', function (c) { G.hubCard = c || {}; });\\n    const pending = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\\n    if (pending && pending.then) {\\n      pending.then(function (info) {\\n        if (!info) {\\n180→          if (game.sceneName === 'round') game.go('title');\\n          return;\\n        }\\n        G.hubInfo = info;\\n        const ready = function () { try { AIHub.ready(); } catch (e) { /* not welcomed yet */ } };\\n        if (game.booted && game.booted.then) game.booted.then(ready);\\n        else ready();\\n      });\\n    }\\n  }\\n190→\\n  G.boot = function (opts) {\\n    opts = opts || {};\\n    if (G.game) {\\n      try { G.game.dispose(); } catch (e) { /* already gone */ }\\n      try { E.store.clear(); } catch (e) { /* no store */ }\\n      G.game = null;\\n    }\\n    G.inSession = typeof AIHub !== 'undefined' && !!AIHub.active;\\n    G.profile = G.freshProfile(0);\\n200→    G.driver = null;\\n    G.attracting = false;\\n    G.session = null;\\n    G.talk = null;\\n    G.idleSteps = 0;\\n    G.queue = null;\\n    G.chainAfter = null;\\n    G.hubOver = false;\\n    G.hubReported = false;\\n    G.hubInfo = null;\\n210→    G.hubCard = null;\\n    G.ghosts = [];\\n    G.seen = {};\\n    G.podium = null;\\n    G.phase = 'menu';\\n    G.left = 0;\\n    G.subtitle = '';\\n    G._keyAt = 0;\\n    G._breathLatch = false;\\n    G._attractMouse = -99;\\n220→    G.lean = { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\",\"content_concise\":\"1→/* Boot: the game, the shell, the lean, saves, and the hub session. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function approach(cur, target, rate, dt) {\\n    const d = target - cur, m = rate * dt;\\n10→    if (Math.abs(d) <= m) return target;\\n    return cur + (d < 0 ? -m : m);\\n  }\\n\\n  function hashScene() {\\n    let hash = '';\\n    try { hash = (typeof location !== 'undefined' && location && location.hash) || ''; } catch (e) { hash = ''; }\\n    return hash;\\n  }\\n\\n20→  function topIdle(game) {\\n    const n = game.sceneName;\\n    if (G.attracting || G.inSession) return false;\\n    if (n === 'title' || n === 'slots' || n === 'about') return true;\\n    if (n === 'class' && !G.session) return true;\\n    return false;\\n  }\\n\\n  function freshLean() {\\n    return { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\\n30→  }\\n\\n  /* One player's lean. The first player keeps the mouse, the dev-panel key filter, and the shared breath latch. */\\n  function readOne(game, I, lean, dt, primary) {\\n    const panel = primary && !!(G.dev && G.dev.panel);\\n    const held = I.held;\\n    if (primary && (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown'))) {\\n      G._keyAt = I.clock;\\n    }\\n40→    const pad = I.padMove || [0, 0];\\n    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = primary ? I.pointer() : null;\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = primary && !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n50→      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n60→      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n70→        if (I.down('right')) kx += 1;\\n        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n80→        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (primary) {\\n      if (mode === 'toggle' && I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    } else if (mode === 'toggle' && I.pressed('breath')) lean._latch = !lean._latch;\\n90→    let target = 0;\\n    if (mode === 'toggle') target = (primary ? G._breathLatch : lean._latch) ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n100→    lean.jump = !!I.pressed('jump');\\n    lean.catchL = !!I.pressed('catchL');\\n    lean.catchR = !!I.pressed('catchR');\\n    lean.paceL = !!I.down('paceL');\\n    lean.paceR = !!I.down('paceR');\\n\\n    if (primary) {\\n      const cv = game.screen && game.screen.canvas;\\n      if (cv && cv.style) {\\n        const hide = lean.source === 'mouse' && (game.sceneName === 'play' || game.sceneName === 'duel' || game.sceneName === 'attract');\\n110→        cv.style.cursor = hide ? 'none' : '';\\n      }\\n    }\\n  }\\n\\n  function readLean(game, dt) {\\n    const players = (game.players && game.players.length) ? game.players : [game.input];\\n    if (!G.leans || G.leans[0] !== G.lean) G.leans = [G.lean];\\n    while (G.leans.length < players.length) G.leans.push(freshLean());\\n    if (G.leans.length > players.length) G.leans.length = players.length;\\n120→    readOne(game, players[0], G.lean, dt, true);\\n    for (let i = 1; i < players.length; i++) readOne(game, players[i], G.leans[i], dt, false);\\n  }\\n\\n  function installShellCss() {\\n    if (typeof document === 'undefined') return;\\n    if (!document.getElementById('spine-shell-css')) {\\n      const st = document.createElement('style');\\n      st.id = 'spine-shell-css';\\n      st.textContent = '@media (min-height:700px){.esh-mod{zoom:1.5}}@media (min-height:1000px){.esh-mod{zoom:2}}.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}';\\n130→      document.head.appendChild(st);\\n    }\\n    if (!G._hoverFocus) {\\n      G._hoverFocus = true;\\n      document.addEventListener('pointerover', function (e) {\\n        const b = e.target && e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\\n        if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true });\\n      });\\n    }\\n  }\\n140→\\n  function saveWrite() {\\n    if (G.attracting || G.inSession) return;\\n    const p = JSON.parse(JSON.stringify(G.profile));\\n    return { data: p, place: 'Day ' + p.day + '  ' + p.name, level: p.day };\\n  }\\n  function saveRead(save) {\\n    const d = (save && save.data) || {};\\n    const next = G.freshProfile(d.slot || 0);\\n    Object.assign(next, d);\\n150→    if (!next.look) next.look = { hair: 0, skin: 1, top: 0, bottom: 0 };\\n    if (!next.flags) next.flags = { arrival: false, tareDay: false, games: false };\\n    if (!next.unlocks) next.unlocks = [];\\n    if (!next.played) next.played = {};\\n    if (!next.bestPct) next.bestPct = {};\\n    if (!next.spineDays) next.spineDays = [next.spine || 71];\\n    G.profile = next;\\n  }\\n\\n  function wireHub(game) {\\n160→    if (!G.inSession || typeof AIHub === 'undefined' || !AIHub.on || !AIHub.connect) return;\\n    AIHub.on('message', function (d, from) {\\n      if (!d || d.t !== 'g') return;\\n      const gh = { t: 'g', a: d.a, l: d.l, p: d.p, w: d.w, s: d.s, from: from, name: String(from || 'ghost'), color: '#8fd3f4' };\\n      const i = G.ghosts.findIndex(function (q) { return q.from === from; });\\n      if (i >= 0) G.ghosts[i] = gh;\\n      else G.ghosts.push(gh);\\n      if (G.ghosts.length > 8) G.ghosts.shift();\\n    });\\n    AIHub.on('leave', function (info) {\\n170→      const id = info && info.id;\\n      G.ghosts = G.ghosts.filter(function (q) { return q.from !== id; });\\n    });\\n    AIHub.on('time-up', function () { G.hubTimeUp(); });\\n    AIHub.on('end', function () { G.hubEnd(); });\\n    AIHub.on('card', function (c) { G.hubCard = c || {}; });\\n    const pending = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\\n    if (pending && pending.then) {\\n      pending.then(function (info) {\\n        if (!info) {\\n180→          if (game.sceneName === 'round') game.go('title');\\n          return;\\n        }\\n        G.hubInfo = info;\\n        const ready = function () { try { AIHub.ready(); } catch (e) { /* not welcomed yet */ } };\\n        if (game.booted && game.booted.then) game.booted.then(ready);\\n        else ready();\\n      });\\n    }\\n  }\\n190→\\n  G.boot = function (opts) {\\n    opts = opts || {};\\n    if (G.game) {\\n      try { G.game.dispose(); } catch (e) { /* already gone */ }\\n      try { E.store.clear(); } catch (e) { /* no store */ }\\n      G.game = null;\\n    }\\n    G.inSession = typeof AIHub !== 'undefined' && !!AIHub.active;\\n    G.profile = G.freshProfile(0);\\n200→    G.driver = null;\\n    G.attracting = false;\\n    G.session = null;\\n    G.talk = null;\\n    G.idleSteps = 0;\\n    G.queue = null;\\n    G.chainAfter = null;\\n    G.hubOver = false;\\n    G.hubReported = false;\\n    G.hubInfo = null;\\n210→    G.hubCard = null;\\n    G.ghosts = [];\\n    G.seen = {};\\n    G.podium = null;\\n    G.phase = 'menu';\\n    G.left = 0;\\n    G.subtitle = '';\\n    G._keyAt = 0;\\n    G._breathLatch = false;\\n    G._attractMouse = -99;\\n220→    G.lean = { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/boot.js\",\"offset\":1,\"limit\":220,\"raw_output\":\"/* Boot: the game, the shell, the lean, saves, and the hub session. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function approach(cur, target, rate, dt) {\\n    const d = target - cur, m = rate * dt;\\n    if (Math.abs(d) <= m) return target;\\n    return cur + (d < 0 ? -m : m);\\n  }\\n\\n  function hashScene() {\\n    let hash = '';\\n    try { hash = (typeof location !== 'undefined' && location && location.hash) || ''; } catch (e) { hash = ''; }\\n    return hash;\\n  }\\n\\n  function topIdle(game) {\\n    const n = game.sceneName;\\n    if (G.attracting || G.inSession) return false;\\n    if (n === 'title' || n === 'slots' || n === 'about') return true;\\n    if (n === 'class' && !G.session) return true;\\n    return false;\\n  }\\n\\n  function freshLean() {\\n    return { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\\n  }\\n\\n  /* One player's lean. The first player keeps the mouse, the dev-panel key filter, and the shared breath latch. */\\n  function readOne(game, I, lean, dt, primary) {\\n    const panel = primary && !!(G.dev && G.dev.panel);\\n    const held = I.held;\\n    if (primary && (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown'))) {\\n      G._keyAt = I.clock;\\n    }\\n    const pad = I.padMove || [0, 0];\\n    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = primary ? I.pointer() : null;\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = primary && !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n        if (I.down('right')) kx += 1;\\n        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (primary) {\\n      if (mode === 'toggle' && I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    } else if (mode === 'toggle' && I.pressed('breath')) lean._latch = !lean._latch;\\n    let target = 0;\\n    if (mode === 'toggle') target = (primary ? G._breathLatch : lean._latch) ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n    lean.jump = !!I.pressed('jump');\\n    lean.catchL = !!I.pressed('catchL');\\n    lean.catchR = !!I.pressed('catchR');\\n    lean.paceL = !!I.down('paceL');\\n    lean.paceR = !!I.down('paceR');\\n\\n    if (primary) {\\n      const cv = game.screen && game.screen.canvas;\\n      if (cv && cv.style) {\\n        const hide = lean.source === 'mouse' && (game.sceneName === 'play' || game.sceneName === 'duel' || game.sceneName === 'attract');\\n        cv.style.cursor = hide ? 'none' : '';\\n      }\\n    }\\n  }\\n\\n  function readLean(game, dt) {\\n    const players = (game.players && game.players.length) ? game.players : [game.input];\\n    if (!G.leans || G.leans[0] !== G.lean) G.leans = [G.lean];\\n    while (G.leans.length < players.length) G.leans.push(freshLean());\\n    if (G.leans.length > players.length) G.leans.length = players.length;\\n    readOne(game, players[0], G.lean, dt, true);\\n    for (let i = 1; i < players.length; i++) readOne(game, players[i], G.leans[i], dt, false);\\n  }\\n\\n  function installShellCss() {\\n    if (typeof document === 'undefined') return;\\n    if (!document.getElementById('spine-shell-css')) {\\n      const st = document.createElement('style');\\n      st.id = 'spine-shell-css';\\n      st.textContent = '@media (min-height:700px){.esh-mod{zoom:1.5}}@media (min-height:1000px){.esh-mod{zoom:2}}.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}';\\n      document.head.appendChild(st);\\n    }\\n    if (!G._hoverFocus) {\\n      G._hoverFocus = true;\\n      document.addEventListener('pointerover', function (e) {\\n        const b = e.target && e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\\n        if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true });\\n      });\\n    }\\n  }\\n\\n  function saveWrite() {\\n    if (G.attracting || G.inSession) return;\\n    const p = JSON.parse(JSON.stringify(G.profile));\\n    return { data: p, place: 'Day ' + p.day + '  ' + p.name, level: p.day };\\n  }\\n  function saveRead(save) {\\n    const d = (save && save.data) || {};\\n    const next = G.freshProfile(d.slot || 0);\\n    Object.assign(next, d);\\n    if (!next.look) next.look = { hair: 0, skin: 1, top: 0, bottom: 0 };\\n    if (!next.flags) next.flags = { arrival: false, tareDay: false, games: false };\\n    if (!next.unlocks) next.unlocks = [];\\n    if (!next.played) next.played = {};\\n    if (!next.bestPct) next.bestPct = {};\\n    if (!next.spineDays) next.spineDays = [next.spine || 71];\\n    G.profile = next;\\n  }\\n\\n  function wireHub(game) {\\n    if (!G.inSession || typeof AIHub === 'undefined' || !AIHub.on || !AIHub.connect) return;\\n    AIHub.on('message', function (d, from) {\\n      if (!d || d.t !== 'g') return;\\n      const gh = { t: 'g', a: d.a, l: d.l, p: d.p, w: d.w, s: d.s, from: from, name: String(from || 'ghost'), color: '#8fd3f4' };\\n      const i = G.ghosts.findIndex(function (q) { return q.from === from; });\\n      if (i >= 0) G.ghosts[i] = gh;\\n      else G.ghosts.push(gh);\\n      if (G.ghosts.length > 8) G.ghosts.shift();\\n    });\\n    AIHub.on('leave', function (info) {\\n      const id = info && info.id;\\n      G.ghosts = G.ghosts.filter(function (q) { return q.from !== id; });\\n    });\\n    AIHub.on('time-up', function () { G.hubTimeUp(); });\\n    AIHub.on('end', function () { G.hubEnd(); });\\n    AIHub.on('card', function (c) { G.hubCard = c || {}; });\\n    const pending = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\\n    if (pending && pending.then) {\\n      pending.then(function (info) {\\n        if (!info) {\\n          if (game.sceneName === 'round') game.go('title');\\n          return;\\n        }\\n        G.hubInfo = info;\\n        const ready = function () { try { AIHub.ready(); } catch (e) { /* not welcomed yet */ } };\\n        if (game.booted && game.booted.then) game.booted.then(ready);\\n        else ready();\\n      });\\n    }\\n  }\\n\\n  G.boot = function (opts) {\\n    opts = opts || {};\\n    if (G.game) {\\n      try { G.game.dispose(); } catch (e) { /* already gone */ }\\n      try { E.store.clear(); } catch (e) { /* no store */ }\\n      G.game = null;\\n    }\\n    G.inSession = typeof AIHub !== 'undefined' && !!AIHub.active;\\n    G.profile = G.freshProfile(0);\\n    G.driver = null;\\n    G.attracting = false;\\n    G.session = null;\\n    G.talk = null;\\n    G.idleSteps = 0;\\n    G.queue = null;\\n    G.chainAfter = null;\\n    G.hubOver = false;\\n    G.hubReported = false;\\n    G.hubInfo = null;\\n    G.hubCard = null;\\n    G.ghosts = [];\\n    G.seen = {};\\n    G.podium = null;\\n    G.phase = 'menu';\\n    G.left = 0;\\n    G.subtitle = '';\\n    G._keyAt = 0;\\n    G._breathLatch = false;\\n    G._attractMouse = -99;\\n    G.lean = { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\\n\",\"total_lines\":340}}","is_error":false},{"type":"tool_result","tool_use_id":"call-32c0b0ee-1df0-4c46-a5f8-a5a706ece1da-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"140→        const t = trail[i];\\n        E.px.disc(g, cx + t.x * rad, cy - t.y * rad, 1, 'rgba(44,198,230,' + (i / trail.length) + ')');\\n      }\\n      const px = cx + bal.px * rad, py = cy - bal.py * rad;\\n      E.px.disc(g, px, py, 3, '#ff7a59');\\n      E.px.disc(g, px, py, 1.4, '#ffffff');\\n      if (o.trace && G.dev && G.dev.panel) text(g, bal.px.toFixed(2) + ',' + bal.py.toFixed(2), cx - 20, cy + rad + 2, '#20404c', 1);\\n    });\\n  };\\n  G.drawStars = function (g, x, y, n) {\\n150→    for (let i = 0; i < 3; i++) text(g, i < n ? '★' : '·', x + i * 12, y, i < n ? '#14a8c8' : '#5f7f8a', 2);\\n  };\\n  G.DEV_DEFAULTS = {\\n    k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, reach: .33, nudge: 2.2,\\n    star1: .35, star2: .65, star3: .90, repTol: .08, rhythm: 1, fatigue: 1.5,\\n    hoopLo: 7, hoopHi: 11, jogLo: 2.6, jogHi: 3.4, jogSpeed: 1,\\n    skiSpeed: 220, skiTurn: 1.6, trayG: 420, trayFric: 3, ropeS: 16, gust: 9,\\n    timeScale: 1, minutesMul: 1\\n  };\\n  const DEV_HELP = {\\n160→    k: 'spring', c: 'damping', s: 'instability', A: 'noise', nf: 'noise rate', ring: 'ring scale', push: 'push', stumble: 'stumble at',\\n    reach: 'mouse reach', nudge: 'nudge rate', star1: '1 star', star2: '2 stars', star3: '3 stars', repTol: 'rep tolerance',\\n    rhythm: 'window scale', fatigue: 'fatigue', hoopLo: 'hoop low', hoopHi: 'hoop high', jogLo: 'jog low', jogHi: 'jog high',\\n    jogSpeed: 'jog speed', skiSpeed: 'ski speed', skiTurn: 'ski turn', trayG: 'tray gravity', trayFric: 'tray friction',\\n    ropeS: 'rope instability', gust: 'gust', timeScale: 'time scale', minutesMul: 'minutes'\\n  };\\n  function copyDev(src) { const o = {}; for (const k in src) o[k] = src[k]; return o; }\\n  G.dev = {\\n    on: false, panel: false, v: copyDev(G.DEV_DEFAULTS), i: 0, keys: Object.keys(G.DEV_DEFAULTS),\\n    tool: 0, pose: 'stork', poseI: 0, poseT: 0, poseMode: false, printed: '', frame: false, bot: null, trace: false, noStumble: false,\\n170→    open() {\\n      this.panel = true; this.on = true;\\n      if (G.game) { G.game.live = true; if (G.game.paused) G.game.resume(); }\\n    },\\n    close() { this.panel = false; this.on = false; if (G.game && !G.inSession) G.game.live = false; },\\n    adjust(key, delta) {\\n      if (!(key in this.v)) return;\\n      const d = G.DEV_DEFAULTS[key];\\n      const step = Math.abs(d) > 20 ? Math.abs(d) * 0.05 : Math.abs(d) > 2 ? 0.1 : d > 0.2 ? 0.05 : 0.01;\\n      this.v[key] = Math.round((this.v[key] + delta * (step || 0.05)) * 1000) / 1000;\\n180→      if (key === 'timeScale' && G.game) G.game.timeScale = this.v.timeScale;\\n    },\\n    reset() {\\n      this.v = copyDev(G.DEV_DEFAULTS);\\n      if (G.game) G.game.timeScale = 1;\\n    },\\n    jump(o) {\\n      o = o || {};\\n      if (!G.game) return;\\n      if (o.day) { G.profile.day = o.day; G.profile.sessions = 0; }\\n190→      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\\n      else if (o.scene) G.game.go(o.scene, o.data || {}, { fade: 0 });\\n    },\\n    jumpMode: false, jumpRow: 0, jumpDay: 1, jumpSceneI: 0, jumpActI: 0, jumpTier: 1,\\n    jumpScenes: ['bungalow', 'island', 'title', 'plate', 'bed', 'ending'],\\n    jumpActs: ['', 'stork', 'candle', 'squat', 'step', 'hoop', 'sun', 'push', 'lunge', 'jog', 'slalom', 'tray', 'laundry']\\n  };\\n  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot', 'Jump'];\\n  G.dev.tools = TOOLS;\\n  G.dev.clipNames = function () {\\n200→    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n210→    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 100;\\n220→    const key = String(name).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'pose';\\n    const row = key + \\\": { clip: '\\\" + name + \\\"', a: \\\" + t.toFixed(2) + \\\", b: \\\" + Math.max(b, t).toFixed(2) + \\\", tgt: 1.57 },\\\";\\n    this.printed = row;\\n    try { console.log(row); } catch (e) { /* the row is also on the panel */ }\\n    return row;\\n  };\\n  function eat(input, action) { try { input.suppress(action); } catch (e) { /* already used */ } }\\n  G.dev.update = function (input, dt) {\\n    if (!this.panel) return;\\n    const keys = this.keys;\\n230→    if (input.pressed('cancel')) {\\n      eat(input, 'cancel');\\n      if (this.poseMode) { this.poseMode = false; return; }\\n      if (this.jumpMode) { this.jumpMode = false; return; }\\n      this.close();\\n      return;\\n    }\\n    if (this.poseMode) {\\n      const names = this.clipNames();\\n      const n = names.length || 1;\\n240→      if (input.pressed('up')) { this.poseI = (this.poseI + n - 1) % n; this.poseT = 0; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.poseI = (this.poseI + 1) % n; this.poseT = 0; eat(input, 'down'); }\\n      const dur = (this.currentClip() && this.currentClip().dur) || 2;\\n      if (input.pressed('left') || input.repeat('left')) { this.poseT = Math.max(0, this.poseT - 0.05); eat(input, 'left'); }\\n      if (input.pressed('right') || input.repeat('right')) { this.poseT = Math.min(dur, this.poseT + 0.05); eat(input, 'right'); }\\n      if (input.pressed('confirm')) { this.printPose(); eat(input, 'confirm'); }\\n      void dt;\\n      return;\\n    }\\n    if (this.jumpMode) {\\n250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (input.repeat && (input.pressed('up') && (input.held.has('ArrowUp') || input.lastDevice === 'gamepad'))) this.i = (this.i + keys.length - 1) % keys.length;\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n280→    const k = keys[this.i];\\n    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n290→    else if (i === 1 && G.finishNow) G.finishNow(1);\\n    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n300→    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n310→    try {\\n      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n320→    if (!this.panel || !r) return;\\n    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n330→        const on = start + n === self.i;\\n        const y = 18 + n * 12;\\n        if (on) E.px.rect(g, 4, y - 1, w - 8, 11, '#bfeee0');\\n        const def = G.DEV_DEFAULTS[k];\\n        text(g, (DEV_HELP[k] || k) + ' ' + self.v[k], 8, y, '#20404c', 1);\\n        if (self.v[k] !== def) text(g, 'd' + def, w - 36, y, '#5f7f8a', 1);\\n      }\\n      if (self.poseMode) {\\n        const names = self.clipNames();\\n        const clip = self.currentClip();\\n340→        text(g, (names[self.poseI] || '') + '  ' + (self.poseT || 0).toFixed(2), 8, r.H - 52, '#20404c', 1);\\n        if (self.printed) text(g, self.printed.slice(0, 42), 8, r.H - 40, '#5f7f8a', 1);\\n        text(g, clip ? 'up clip   side scrub   confirm prints' : '', 8, r.H - 28, '#5f7f8a', 1);\\n      } else if (self.jumpMode) {\\n        const rows = [\\n          'Day ' + self.jumpDay,\\n          'Scene ' + self.jumpScenes[self.jumpSceneI],\\n          'Activity ' + (self.jumpActs[self.jumpActI] || '(scene)'),\\n          'Tier ' + self.jumpTier\\n        ];\\n350→        rows.forEach(function (line, n) {\\n          text(g, (n === self.jumpRow ? '> ' : '  ') + line, 8, r.H - 78 + n * 11, n === self.jumpRow ? '#14a8c8' : '#20404c', 1);\\n        });\\n      } else text(g, 'reset: retry', 8, r.H - 28, '#5f7f8a', 1);\\n      text(g, TOOLS[self.tool] || '', 8, r.H - 16, '#14a8c8', 1);\\n    });\\n  };\\n  G.starsOf = function (pct, gates) {\\n    gates = gates || [.35, .65, .90];\\n    const g0 = G.dev && G.dev.on ? G.dev.v.star1 : gates[0];\\n360→    const g1 = G.dev && G.dev.on ? G.dev.v.star2 : gates[1];\\n    const g2 = G.dev && G.dev.on ? G.dev.v.star3 : gates[2];\\n    const use = G.dev && G.dev.on ? [g0, g1, g2] : gates;\\n    let n = 0;\\n    if (pct >= use[0]) n = 1;\\n    if (pct >= use[1]) n = 2;\\n    if (pct >= use[2]) n = 3;\\n    return n;\\n  };\\n})();\\n\",\"content_concise\":\"140→        const t = trail[i];\\n        E.px.disc(g, cx + t.x * rad, cy - t.y * rad, 1, 'rgba(44,198,230,' + (i / trail.length) + ')');\\n      }\\n      const px = cx + bal.px * rad, py = cy - bal.py * rad;\\n      E.px.disc(g, px, py, 3, '#ff7a59');\\n      E.px.disc(g, px, py, 1.4, '#ffffff');\\n      if (o.trace && G.dev && G.dev.panel) text(g, bal.px.toFixed(2) + ',' + bal.py.toFixed(2), cx - 20, cy + rad + 2, '#20404c', 1);\\n    });\\n  };\\n  G.drawStars = function (g, x, y, n) {\\n150→    for (let i = 0; i < 3; i++) text(g, i < n ? '★' : '·', x + i * 12, y, i < n ? '#14a8c8' : '#5f7f8a', 2);\\n  };\\n  G.DEV_DEFAULTS = {\\n    k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, reach: .33, nudge: 2.2,\\n    star1: .35, star2: .65, star3: .90, repTol: .08, rhythm: 1, fatigue: 1.5,\\n    hoopLo: 7, hoopHi: 11, jogLo: 2.6, jogHi: 3.4, jogSpeed: 1,\\n    skiSpeed: 220, skiTurn: 1.6, trayG: 420, trayFric: 3, ropeS: 16, gust: 9,\\n    timeScale: 1, minutesMul: 1\\n  };\\n  const DEV_HELP = {\\n160→    k: 'spring', c: 'damping', s: 'instability', A: 'noise', nf: 'noise rate', ring: 'ring scale', push: 'push', stumble: 'stumble at',\\n    reach: 'mouse reach', nudge: 'nudge rate', star1: '1 star', star2: '2 stars', star3: '3 stars', repTol: 'rep tolerance',\\n    rhythm: 'window scale', fatigue: 'fatigue', hoopLo: 'hoop low', hoopHi: 'hoop high', jogLo: 'jog low', jogHi: 'jog high',\\n    jogSpeed: 'jog speed', skiSpeed: 'ski speed', skiTurn: 'ski turn', trayG: 'tray gravity', trayFric: 'tray friction',\\n    ropeS: 'rope instability', gust: 'gust', timeScale: 'time scale', minutesMul: 'minutes'\\n  };\\n  function copyDev(src) { const o = {}; for (const k in src) o[k] = src[k]; return o; }\\n  G.dev = {\\n    on: false, panel: false, v: copyDev(G.DEV_DEFAULTS), i: 0, keys: Object.keys(G.DEV_DEFAULTS),\\n    tool: 0, pose: 'stork', poseI: 0, poseT: 0, poseMode: false, printed: '', frame: false, bot: null, trace: false, noStumble: false,\\n170→    open() {\\n      this.panel = true; this.on = true;\\n      if (G.game) { G.game.live = true; if (G.game.paused) G.game.resume(); }\\n    },\\n    close() { this.panel = false; this.on = false; if (G.game && !G.inSession) G.game.live = false; },\\n    adjust(key, delta) {\\n      if (!(key in this.v)) return;\\n      const d = G.DEV_DEFAULTS[key];\\n      const step = Math.abs(d) > 20 ? Math.abs(d) * 0.05 : Math.abs(d) > 2 ? 0.1 : d > 0.2 ? 0.05 : 0.01;\\n      this.v[key] = Math.round((this.v[key] + delta * (step || 0.05)) * 1000) / 1000;\\n180→      if (key === 'timeScale' && G.game) G.game.timeScale = this.v.timeScale;\\n    },\\n    reset() {\\n      this.v = copyDev(G.DEV_DEFAULTS);\\n      if (G.game) G.game.timeScale = 1;\\n    },\\n    jump(o) {\\n      o = o || {};\\n      if (!G.game) return;\\n      if (o.day) { G.profile.day = o.day; G.profile.sessions = 0; }\\n190→      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\\n      else if (o.scene) G.game.go(o.scene, o.data || {}, { fade: 0 });\\n    },\\n    jumpMode: false, jumpRow: 0, jumpDay: 1, jumpSceneI: 0, jumpActI: 0, jumpTier: 1,\\n    jumpScenes: ['bungalow', 'island', 'title', 'plate', 'bed', 'ending'],\\n    jumpActs: ['', 'stork', 'candle', 'squat', 'step', 'hoop', 'sun', 'push', 'lunge', 'jog', 'slalom', 'tray', 'laundry']\\n  };\\n  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot', 'Jump'];\\n  G.dev.tools = TOOLS;\\n  G.dev.clipNames = function () {\\n200→    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n210→    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 100;\\n220→    const key = String(name).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'pose';\\n    const row = key + \\\": { clip: '\\\" + name + \\\"', a: \\\" + t.toFixed(2) + \\\", b: \\\" + Math.max(b, t).toFixed(2) + \\\", tgt: 1.57 },\\\";\\n    this.printed = row;\\n    try { console.log(row); } catch (e) { /* the row is also on the panel */ }\\n    return row;\\n  };\\n  function eat(input, action) { try { input.suppress(action); } catch (e) { /* already used */ } }\\n  G.dev.update = function (input, dt) {\\n    if (!this.panel) return;\\n    const keys = this.keys;\\n230→    if (input.pressed('cancel')) {\\n      eat(input, 'cancel');\\n      if (this.poseMode) { this.poseMode = false; return; }\\n      if (this.jumpMode) { this.jumpMode = false; return; }\\n      this.close();\\n      return;\\n    }\\n    if (this.poseMode) {\\n      const names = this.clipNames();\\n      const n = names.length || 1;\\n240→      if (input.pressed('up')) { this.poseI = (this.poseI + n - 1) % n; this.poseT = 0; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.poseI = (this.poseI + 1) % n; this.poseT = 0; eat(input, 'down'); }\\n      const dur = (this.currentClip() && this.currentClip().dur) || 2;\\n      if (input.pressed('left') || input.repeat('left')) { this.poseT = Math.max(0, this.poseT - 0.05); eat(input, 'left'); }\\n      if (input.pressed('right') || input.repeat('right')) { this.poseT = Math.min(dur, this.poseT + 0.05); eat(input, 'right'); }\\n      if (input.pressed('confirm')) { this.printPose(); eat(input, 'confirm'); }\\n      void dt;\\n      return;\\n    }\\n    if (this.jumpMode) {\\n250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (input.repeat && (input.pressed('up') && (input.held.has('ArrowUp') || input.lastDevice === 'gamepad'))) this.i = (this.i + keys.length - 1) % keys.length;\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n280→    const k = keys[this.i];\\n    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n290→    else if (i === 1 && G.finishNow) G.finishNow(1);\\n    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n300→    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n310→    try {\\n      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n320→    if (!this.panel || !r) return;\\n    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n330→        const on = start + n === self.i;\\n        const y = 18 + n * 12;\\n        if (on) E.px.rect(g, 4, y - 1, w - 8, 11, '#bfeee0');\\n        const def = G.DEV_DEFAULTS[k];\\n        text(g, (DEV_HELP[k] || k) + ' ' + self.v[k], 8, y, '#20404c', 1);\\n        if (self.v[k] !== def) text(g, 'd' 