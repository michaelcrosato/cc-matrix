6,95,99,108,111,115,101,100,40,41,59,32,116,104,105,115,46,95,114,101,110,100,101,114,40,41,59,32,114,101,116,117,114,110,32,116,104,105,115,59,32,125,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":15,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js\",\"matches\":[{\"line_number\":2531,\"content\":\"   *  The player resumes (Escape, Start, Resume); resume() does it from code */\"},{\"line_number\":2535,\"content\":\"  resume() { this.paused = false; this.pauseReason = null; this._goOn = false; }\"},{\"line_number\":2602,\"content\":\"    if (this.paused) this.resume(); else this.menu();\"},{\"line_number\":3033,\"content\":\" *      and waits for the player (game.pause(reason), game.resume(), game.pauseReason).\"},{\"line_number\":3054,\"content\":\"  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\"},{\"line_number\":7742,\"content\":\"     *  is none); volume: master volume 0..1; sfxVolume, musicVolume, voiceVolume: 0..1 for effects, music and the voice\"},{\"line_number\":7744,\"content\":\"    this._game = game; this._signal = signal; this.ctx = null; this.volume = .7; this.sfxVolume = 1; this.musicVolume = .5; this.voiceVolume = 1; this.muted = false;\"},{\"line_number\":7753,\"content\":\"    // sound draws its own random numbers (noise, pitch variation): whether sound is on, muted or not yet unlocked by a tap\"},{\"line_number\":7769,\"content\":\"      const resume = () => { if (c.state !== 'running') c.resume().catch(() => {}); };\"},{\"line_number\":7771,\"content\":\"      resume();\"},{\"line_number\":7777,\"content\":\"  /** apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it) */\"},{\"line_number\":7778,\"content\":\"  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); this._voiceBus.gain.value = this.voiceVolume; }\"},{\"line_number\":7792,\"content\":\"  _background(sleep) { const c = this.ctx; if (!c) return; try { if (sleep && c.state === 'running') { this._slept = true; c.suspend().catch(() => {}); } else if (!sleep && this._slept) { this._slept = false; c.resume().catch(() => {}); } } catch (e) { /* closed */ } }\"},{\"line_number\":9489,\"content\":\"    this._stack.pop(); this._capEnd(); if (top.name === 'pause') this._game.resume();\"},{\"line_number\":9493,\"content\":\"  hide() { const p = this._stack.some(t => t.name === 'pause'); this._stack.length = 0; this._capEnd(); if (p) this._game.resume(); this._closed(); this._render(); return this; }\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"fb9c826c-b1d9-4a2d-abdd-f0bfaa2276dc"}
