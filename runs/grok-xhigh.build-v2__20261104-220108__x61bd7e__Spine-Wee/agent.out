95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":25,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs\",\"matches\":[{\"line_number\":397,\"content\":\"  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\"},{\"line_number\":412,\"content\":\"  sliderTo('trayFric');\"},{\"line_number\":413,\"content\":\"  const fr0 = G.dev.v.trayFric;\"},{\"line_number\":415,\"content\":\"  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\"},{\"line_number\":428,\"content\":\"  sliderTo('ropeS');\"},{\"line_number\":429,\"content\":\"  const rs0 = G.dev.v.ropeS;\"},{\"line_number\":431,\"content\":\"  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\"},{\"line_number\":440,\"content\":\"add('rules', 'local class', () => {\"},{\"line_number\":555,\"content\":\"    assert(sent.length > 0, 'no ghosts');\"},{\"line_number\":590,\"content\":\"add('rules', 'hub ghosts', async () => {\"},{\"line_number\":622,\"content\":\"    assert(faded.length >= 1, 'ghost alpha calls ' + seen.length);\"},{\"line_number\":623,\"content\":\"    const mine = G.ghosts.filter(function (q) { return q.from === 'seat-2'; })[0];\"},{\"line_number\":624,\"content\":\"    const other = G.ghosts.filter(function (q) { return q.from === 'seat-3'; })[0];\"},{\"line_number\":625,\"content\":\"    assert(mine && mine.rig, 'matching ghost was not drawn');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/hub/round.js\",\"matches\":[{\"line_number\":29,\"content\":\"export const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\"},{\"line_number\":32,\"content\":\"export const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\"},{\"line_number\":34,\"content\":\"/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\"},{\"line_number\":35,\"content\":\"const MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\"},{\"line_number\":44,\"content\":\"export const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\"},{\"line_number\":49,\"content\":\" * parallel or ghost. A game still tagged race was built for an unseeded start\"},{\"line_number\":52,\"content\":\"export const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\"},{\"line_number\":68,\"content\":\" * Parallel and ghost order: finishers by time, then the rest by score,\"},{\"line_number\":169,\"content\":\" * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\"},{\"line_number\":416,\"content\":\"        if (!selfReported()) return issue(seat, `result is for parallel and ghost; this round is ${mode}`);\"},{\"line_number\":510,\"content\":\"    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"db02330d-93b3-4827-9833-35857732c47b"}
