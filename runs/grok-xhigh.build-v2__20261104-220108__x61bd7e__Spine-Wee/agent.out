{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-46d58a32-782a-4944-b1e0-3422c887e87a-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"680→    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\\n690→       The laundry set's average bot cannot stay up for a whole line; the band table says so, and that table stays. */\\n    let fell = false;\\n    if (ahead && ahead.dist < 0.18 && fam.air <= 0) fell = true;\\n    if (fell) { fam.falls++; fam.x = fam.post; fam.cleared = -1; }\\n    const posts = [0, 18, 36, 55];\\n    for (let i = 0; i < posts.length; i++) if (fam.x >= posts[i]) fam.post = posts[i];\\n    if (!fell) fam.x += spd * dt;\\n    if (fam.x >= fam.len) {\\n      fam.done = true;\\n      const par = 58, worst = 95;\\n700→      const time = fam.t;\\n      let pct = time <= par ? 1 : clamp((worst - time) / (worst - par), 0, 1);\\n      pct = clamp(pct - 0.06 * fam.falls, 0, 1);\\n      sess.pct = pct;\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function scoreNow(sess) {\\n    const act = sess.act, fam = sess.fam;\\n710→    if (!fam) return;\\n    if (act.family === 'hold') {\\n      sess.seats.forEach(function (q, i) {\\n        if (!q.bal) return;\\n        const p = clamp(q.bal.steadiness - 0.05 * q.bal.falls, 0, 1);\\n        if (i === 0) sess.pct = p;\\n        if (sess.classMode) q.pct = p;\\n      });\\n    }\\n    if (act.family === 'slalom' && !fam.done) sess.pct = 0;\\n720→    if (act.family === 'laundry' && !fam.done) sess.pct = 0;\\n    if (act.family === 'jog') {\\n      const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n      sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n    }\\n  }\\n\\n  function Session(opts) {\\n    opts = opts || {};\\n    this.act = G.ACTS[opts.id] || G.ACTS.stork;\\n730→    this.tier = opts.tier || 1;\\n    this.trial = !!opts.trial;\\n    this.cheat = !!opts.cheat;\\n    this.classMode = !!opts.classMode;\\n    this.seed = (opts.seed || 1) >>> 0;\\n    this.rng = E.rng(this.seed);\\n    this.phase = opts.skipToPlay ? 'count' : 'card';\\n    this.t = 0;\\n    this.playTime = 0;\\n    this.limit = opts.limit || this.act.dur[this.tier - 1] || 45;\\n740→    if (this.phase === 'count') this.t = 0;\\n    this.countT = opts.skipToPlay ? 0.4 : 3;\\n    this.demoT = 3;\\n    this.pct = 0;\\n    this.stars = 0;\\n    this.ended = false;\\n    this.awarded = false;\\n    this.seats = opts.seats || [{ name: (G.profile && G.profile.name) || 'You', color: '#ff7a59', local: true, human: true, skill: opts.driver || null }];\\n    if (opts.driver) this.seats[0].skill = opts.driver;\\n    this.driver = opts.driver || null;\\n750→    this.autoNext = !!opts.autoNext;\\n    this.fam = null;\\n    this.line = (G.LINES.tare[this.seed % G.LINES.tare.length]) || '';\\n    G.subtitle = '';\\n  }\\n\\n  Session.prototype.update = function (dt) {\\n    if (G.driver && G.driver !== 'human') {\\n      this.driver = G.driver;\\n      if (this.seats[0] && this.seats[0].local) this.seats[0].skill = G.driver;\\n760→    }\\n    if (this.phase === 'card') {\\n      G.phase = 'menu'; G.left = 0;\\n      return;\\n    }\\n    if (this.phase === 'demo') {\\n      this.demoT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\\n      if (this.demoT <= 0) { this.phase = 'count'; this.countT = 3; }\\n      return;\\n770→    }\\n    if (this.phase === 'count') {\\n      this.countT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.countT);\\n      if (this.countT <= 0) { this.phase = 'play'; this.playTime = 0; this.ended = false; beginFamily(this); }\\n      return;\\n    }\\n    if (this.phase === 'play') {\\n      G.phase = 'play';\\n      this.playTime += dt;\\n780→      stepFamily(this, dt);\\n      G.left = Math.max(0, this.limit - this.playTime);\\n      const timed = this.act.family !== 'rep' && this.act.family !== 'slalom' && this.act.family !== 'laundry' && this.act.family !== 'tray' && this.act.family !== 'step';\\n      if (this.ended || this.playTime >= this.limit || (timed && this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'step' && this.fam && this.fam.rh && this.fam.rh.done) this.finish();\\n      if (this.act.family === 'rep' && this.ended) this.finish();\\n      if (this.act.family === 'slalom' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'laundry' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'tray' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'candle' && this.fam && this.fam.dead) this.finish();\\n790→      return;\\n    }\\n    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\\n  };\\n\\n  Session.prototype.finish = function () {\\n    if (this.phase === 'results') return;\\n    scoreNow(this);\\n    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\\n    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\\n800→    this.pct = clamp(this.pct || 0, 0, 1);\\n    this.stars = G.starsOf(this.pct, this.act.stars);\\n    this.phase = 'results';\\n    G.phase = 'menu'; G.left = 0;\\n    if (this.classMode) {\\n      this.seats.forEach(function (q) {\\n        const sk = skillName(q);\\n        let p = typeof q.pct === 'number' ? q.pct : this.pct;\\n        if (q.scoring === false) p = 0;\\n        else if (!q.local && !sk && !(q.human && q.moved)) p = 0;\\n810→        else if (q.human && !q.local) p = q.moved ? p : 0;\\n        q.pct = p;\\n        q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\\n      }, this);\\n    } else {\\n      this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\\n    }\\n    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\\n    try {\\n      const n = this.stars;\\n820→      G.sting(n >= 3 ? 'star3' : n === 2 ? 'star2' : n === 1 ? 'star1' : null);\\n    } catch (e) { /* quiet */ }\\n  };\\n\\n  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\\n  Session.prototype.again = function () {\\n    const id = this.act.id, tier = this.tier, trial = this.trial, driver = this.driver, limit = this.limit, seats = this.seats, classMode = this.classMode, seed = (this.seed + 1) >>> 0;\\n    const next = new Session({ id: id, tier: tier, trial: trial, driver: driver, limit: limit, seats: seats, classMode: classMode, seed: seed, skipToPlay: false, cheat: this.cheat });\\n    G.session = next;\\n  };\\n830→\\n  G.Session = Session;\\n  G.skillName = skillName;\\n\\n  G.drawActivity = function (r, sess) {\\n    if (!r || !sess) return;\\n    const fam = sess.fam;\\n    G.paintRoom(r, sess.act && sess.act.id === 'slalom' ? 'dusk' : 'day');\\n    if (sess.phase === 'play' || sess.phase === 'results' || sess.phase === 'demo' || sess.phase === 'count') {\\n      try {\\n840→        if (!sess._rig && G.makeRig) {\\n          const look = G.lookColors ? G.lookColors(G.profile) : null;\\n          sess._rig = G.makeRig(G.playerOpts(look, 2.1));\\n        }\\n        if (sess._rig && (sess.phase === 'play' || sess.phase === 'demo')) {\\n          const pose = sess.act.family === 'sun' ? G.SUN_POSES[(fam && fam.poseI) || 0] : sess.act.pose;\\n          if (sess.phase === 'demo') G.poseRig(sess._rig, pose || 'idle', sess.demoT, [0, 0]);\\n          else if (fam && sess.seats[0].bal) {\\n            const b = sess.seats[0].bal;\\n            sess._rig.wob = [b.py, b.px];\\n850→            if (sess.act.family === 'lunge' || sess.act.id === 'lunge') sess._rig.body = G.sideLunge(b.px);\\n            else if (sess.act.id === 'hoop') sess._rig.body = G.hula(fam.ang || 0);\\n            else G.poseRig(sess._rig, pose || 'idle', fam.t, [b.py, b.px]);\\n          }\\n          G.stepRig(sess._rig, DT, 0, 0);\\n          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\\n        }\\n      } catch (e) { /* a painted room still reads */ }\\n    }\\n    r.overlay(function (g) {\",\"content_concise\":\"680→    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\\n690→       The laundry set's average bot cannot stay up for a whole line; the band table says so, and that table stays. */\\n    let fell = false;\\n    if (ahead && ahead.dist < 0.18 && fam.air <= 0) fell = true;\\n    if (fell) { fam.falls++; fam.x = fam.post; fam.cleared = -1; }\\n    const posts = [0, 18, 36, 55];\\n    for (let i = 0; i < posts.length; i++) if (fam.x >= posts[i]) fam.post = posts[i];\\n    if (!fell) fam.x += spd * dt;\\n    if (fam.x >= fam.len) {\\n      fam.done = true;\\n      const par = 58, worst = 95;\\n700→      const time = fam.t;\\n      let pct = time <= par ? 1 : clamp((worst - time) / (worst - par), 0, 1);\\n      pct = clamp(pct - 0.06 * fam.falls, 0, 1);\\n      sess.pct = pct;\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function scoreNow(sess) {\\n    const act = sess.act, fam = sess.fam;\\n710→    if (!fam) return;\\n    if (act.family === 'hold') {\\n      sess.seats.forEach(function (q, i) {\\n        if (!q.bal) return;\\n        const p = clamp(q.bal.steadiness - 0.05 * q.bal.falls, 0, 1);\\n        if (i === 0) sess.pct = p;\\n        if (sess.classMode) q.pct = p;\\n      });\\n    }\\n    if (act.family === 'slalom' && !fam.done) sess.pct = 0;\\n720→    if (act.family === 'laundry' && !fam.done) sess.pct = 0;\\n    if (act.family === 'jog') {\\n      const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n      sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n    }\\n  }\\n\\n  function Session(opts) {\\n    opts = opts || {};\\n    this.act = G.ACTS[opts.id] || G.ACTS.stork;\\n730→    this.tier = opts.tier || 1;\\n    this.trial = !!opts.trial;\\n    this.cheat = !!opts.cheat;\\n    this.classMode = !!opts.classMode;\\n    this.seed = (opts.seed || 1) >>> 0;\\n    this.rng = E.rng(this.seed);\\n    this.phase = opts.skipToPlay ? 'count' : 'card';\\n    this.t = 0;\\n    this.playTime = 0;\\n    this.limit = opts.limit || this.act.dur[this.tier - 1] || 45;\\n740→    if (this.phase === 'count') this.t = 0;\\n    this.countT = opts.skipToPlay ? 0.4 : 3;\\n    this.demoT = 3;\\n    this.pct = 0;\\n    this.stars = 0;\\n    this.ended = false;\\n    this.awarded = false;\\n    this.seats = opts.seats || [{ name: (G.profile && G.profile.name) || 'You', color: '#ff7a59', local: true, human: true, skill: opts.driver || null }];\\n    if (opts.driver) this.seats[0].skill = opts.driver;\\n    this.driver = opts.driver || null;\\n750→    this.autoNext = !!opts.autoNext;\\n    this.fam = null;\\n    this.line = (G.LINES.tare[this.seed % G.LINES.tare.length]) || '';\\n    G.subtitle = '';\\n  }\\n\\n  Session.prototype.update = function (dt) {\\n    if (G.driver && G.driver !== 'human') {\\n      this.driver = G.driver;\\n      if (this.seats[0] && this.seats[0].local) this.seats[0].skill = G.driver;\\n760→    }\\n    if (this.phase === 'card') {\\n      G.phase = 'menu'; G.left = 0;\\n      return;\\n    }\\n    if (this.phase === 'demo') {\\n      this.demoT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\\n      if (this.demoT <= 0) { this.phase = 'count'; this.countT = 3; }\\n      return;\\n770→    }\\n    if (this.phase === 'count') {\\n      this.countT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.countT);\\n      if (this.countT <= 0) { this.phase = 'play'; this.playTime = 0; this.ended = false; beginFamily(this); }\\n      return;\\n    }\\n    if (this.phase === 'play') {\\n      G.phase = 'play';\\n      this.playTime += dt;\\n780→      stepFamily(this, dt);\\n      G.left = Math.max(0, this.limit - this.playTime);\\n      const timed = this.act.family !== 'rep' && this.act.family !== 'slalom' && this.act.family !== 'laundry' && this.act.family !== 'tray' && this.act.family !== 'step';\\n      if (this.ended || this.playTime >= this.limit || (timed && this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'step' && this.fam && this.fam.rh && this.fam.rh.done) this.finish();\\n      if (this.act.family === 'rep' && this.ended) this.finish();\\n      if (this.act.family === 'slalom' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'laundry' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'tray' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'candle' && this.fam && this.fam.dead) this.finish();\\n790→      return;\\n    }\\n    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\\n  };\\n\\n  Session.prototype.finish = function () {\\n    if (this.phase === 'results') return;\\n    scoreNow(this);\\n    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\\n    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\\n800→    this.pct = clamp(this.pct || 0, 0, 1);\\n    this.stars = G.starsOf(this.pct, this.act.stars);\\n    this.phase = 'results';\\n    G.phase = 'menu'; G.left = 0;\\n    if (this.classMode) {\\n      this.seats.forEach(function (q) {\\n        const sk = skillName(q);\\n        let p = typeof q.pct === 'number' ? q.pct : this.pct;\\n        if (q.scoring === false) p = 0;\\n        else if (!q.local && !sk && !(q.human && q.moved)) p = 0;\\n810→        else if (q.human && !q.local) p = q.moved ? p : 0;\\n        q.pct = p;\\n        q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\\n      }, this);\\n    } else {\\n      this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\\n    }\\n    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\\n    try {\\n      const n = this.stars;\\n820→      G.sting(n >= 3 ? 'star3' : n === 2 ? 'star2' : n === 1 ? 'star1' : null);\\n    } catch (e) { /* quiet */ }\\n  };\\n\\n  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\\n  Session.prototype.again = function () {\\n    const id = this.act.id, tier = this.tier, trial = this.trial, driver = this.driver, limit = this.limit, seats = this.seats, classMode = this.classMode, seed = (this.seed + 1) >>> 0;\\n    const next = new Session({ id: id, tier: tier, trial: trial, driver: driver, limit: limit, seats: seats, classMode: classMode, seed: seed, skipToPlay: false, cheat: this.cheat });\\n    G.session = next;\\n  };\\n830→\\n  G.Session = Session;\\n  G.skillName = skillName;\\n\\n  G.drawActivity = function (r, sess) {\\n    if (!r || !sess) return;\\n    const fam = sess.fam;\\n    G.paintRoom(r, sess.act && sess.act.id === 'slalom' ? 'dusk' : 'day');\\n    if (sess.phase === 'play' || sess.phase === 'results' || sess.phase === 'demo' || sess.phase === 'count') {\\n      try {\\n840→        if (!sess._rig && G.makeRig) {\\n          const look = G.lookColors ? G.lookColors(G.profile) : null;\\n          sess._rig = G.makeRig(G.playerOpts(look, 2.1));\\n        }\\n        if (sess._rig && (sess.phase === 'play' || sess.phase === 'demo')) {\\n          const pose = sess.act.family === 'sun' ? G.SUN_POSES[(fam && fam.poseI) || 0] : sess.act.pose;\\n          if (sess.phase === 'demo') G.poseRig(sess._rig, pose || 'idle', sess.demoT, [0, 0]);\\n          else if (fam && sess.seats[0].bal) {\\n            const b = sess.seats[0].bal;\\n            sess._rig.wob = [b.py, b.px];\\n850→            if (sess.act.family === 'lunge' || sess.act.id === 'lunge') sess._rig.body = G.sideLunge(b.px);\\n            else if (sess.act.id === 'hoop') sess._rig.body = G.hula(fam.ang || 0);\\n            else G.poseRig(sess._rig, pose || 'idle', fam.t, [b.py, b.px]);\\n          }\\n          G.stepRig(sess._rig, DT, 0, 0);\\n          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\\n        }\\n      } catch (e) { /* a painted room still reads */ }\\n    }\\n    r.overlay(function (g) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"offset\":680,\"limit\":180,\"raw_output\":\"    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\\n       The laundry set's average bot cannot stay up for a whole line; the band table says so, and that table stays. */\\n    let fell = false;\\n    if (ahead && ahead.dist < 0.18 && fam.air <= 0) fell = true;\\n    if (fell) { fam.falls++; fam.x = fam.post; fam.cleared = -1; }\\n    const posts = [0, 18, 36, 55];\\n    for (let i = 0; i < posts.length; i++) if (fam.x >= posts[i]) fam.post = posts[i];\\n    if (!fell) fam.x += spd * dt;\\n    if (fam.x >= fam.len) {\\n      fam.done = true;\\n      const par = 58, worst = 95;\\n      const time = fam.t;\\n      let pct = time <= par ? 1 : clamp((worst - time) / (worst - par), 0, 1);\\n      pct = clamp(pct - 0.06 * fam.falls, 0, 1);\\n      sess.pct = pct;\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function scoreNow(sess) {\\n    const act = sess.act, fam = sess.fam;\\n    if (!fam) return;\\n    if (act.family === 'hold') {\\n      sess.seats.forEach(function (q, i) {\\n        if (!q.bal) return;\\n        const p = clamp(q.bal.steadiness - 0.05 * q.bal.falls, 0, 1);\\n        if (i === 0) sess.pct = p;\\n        if (sess.classMode) q.pct = p;\\n      });\\n    }\\n    if (act.family === 'slalom' && !fam.done) sess.pct = 0;\\n    if (act.family === 'laundry' && !fam.done) sess.pct = 0;\\n    if (act.family === 'jog') {\\n      const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n      sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n    }\\n  }\\n\\n  function Session(opts) {\\n    opts = opts || {};\\n    this.act = G.ACTS[opts.id] || G.ACTS.stork;\\n    this.tier = opts.tier || 1;\\n    this.trial = !!opts.trial;\\n    this.cheat = !!opts.cheat;\\n    this.classMode = !!opts.classMode;\\n    this.seed = (opts.seed || 1) >>> 0;\\n    this.rng = E.rng(this.seed);\\n    this.phase = opts.skipToPlay ? 'count' : 'card';\\n    this.t = 0;\\n    this.playTime = 0;\\n    this.limit = opts.limit || this.act.dur[this.tier - 1] || 45;\\n    if (this.phase === 'count') this.t = 0;\\n    this.countT = opts.skipToPlay ? 0.4 : 3;\\n    this.demoT = 3;\\n    this.pct = 0;\\n    this.stars = 0;\\n    this.ended = false;\\n    this.awarded = false;\\n    this.seats = opts.seats || [{ name: (G.profile && G.profile.name) || 'You', color: '#ff7a59', local: true, human: true, skill: opts.driver || null }];\\n    if (opts.driver) this.seats[0].skill = opts.driver;\\n    this.driver = opts.driver || null;\\n    this.autoNext = !!opts.autoNext;\\n    this.fam = null;\\n    this.line = (G.LINES.tare[this.seed % G.LINES.tare.length]) || '';\\n    G.subtitle = '';\\n  }\\n\\n  Session.prototype.update = function (dt) {\\n    if (G.driver && G.driver !== 'human') {\\n      this.driver = G.driver;\\n      if (this.seats[0] && this.seats[0].local) this.seats[0].skill = G.driver;\\n    }\\n    if (this.phase === 'card') {\\n      G.phase = 'menu'; G.left = 0;\\n      return;\\n    }\\n    if (this.phase === 'demo') {\\n      this.demoT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\\n      if (this.demoT <= 0) { this.phase = 'count'; this.countT = 3; }\\n      return;\\n    }\\n    if (this.phase === 'count') {\\n      this.countT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.countT);\\n      if (this.countT <= 0) { this.phase = 'play'; this.playTime = 0; this.ended = false; beginFamily(this); }\\n      return;\\n    }\\n    if (this.phase === 'play') {\\n      G.phase = 'play';\\n      this.playTime += dt;\\n      stepFamily(this, dt);\\n      G.left = Math.max(0, this.limit - this.playTime);\\n      const timed = this.act.family !== 'rep' && this.act.family !== 'slalom' && this.act.family !== 'laundry' && this.act.family !== 'tray' && this.act.family !== 'step';\\n      if (this.ended || this.playTime >= this.limit || (timed && this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'step' && this.fam && this.fam.rh && this.fam.rh.done) this.finish();\\n      if (this.act.family === 'rep' && this.ended) this.finish();\\n      if (this.act.family === 'slalom' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'laundry' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'tray' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'candle' && this.fam && this.fam.dead) this.finish();\\n      return;\\n    }\\n    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\\n  };\\n\\n  Session.prototype.finish = function () {\\n    if (this.phase === 'results') return;\\n    scoreNow(this);\\n    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\\n    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\\n    this.pct = clamp(this.pct || 0, 0, 1);\\n    this.stars = G.starsOf(this.pct, this.act.stars);\\n    this.phase = 'results';\\n    G.phase = 'menu'; G.left = 0;\\n    if (this.classMode) {\\n      this.seats.forEach(function (q) {\\n        const sk = skillName(q);\\n        let p = typeof q.pct === 'number' ? q.pct : this.pct;\\n        if (q.scoring === false) p = 0;\\n        else if (!q.local && !sk && !(q.human && q.moved)) p = 0;\\n        else if (q.human && !q.local) p = q.moved ? p : 0;\\n        q.pct = p;\\n        q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\\n      }, this);\\n    } else {\\n      this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\\n    }\\n    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\\n    try {\\n      const n = this.stars;\\n      G.sting(n >= 3 ? 'star3' : n === 2 ? 'star2' : n === 1 ? 'star1' : null);\\n    } catch (e) { /* quiet */ }\\n  };\\n\\n  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\\n  Session.prototype.again = function () {\\n    const id = this.act.id, tier = this.tier, trial = this.trial, driver = this.driver, limit = this.limit, seats = this.seats, classMode = this.classMode, seed = (this.seed + 1) >>> 0;\\n    const next = new Session({ id: id, tier: tier, trial: trial, driver: driver, limit: limit, seats: seats, classMode: classMode, seed: seed, skipToPlay: false, cheat: this.cheat });\\n    G.session = next;\\n  };\\n\\n  G.Session = Session;\\n  G.skillName = skillName;\\n\\n  G.drawActivity = function (r, sess) {\\n    if (!r || !sess) return;\\n    const fam = sess.fam;\\n    G.paintRoom(r, sess.act && sess.act.id === 'slalom' ? 'dusk' : 'day');\\n    if (sess.phase === 'play' || sess.phase === 'results' || sess.phase === 'demo' || sess.phase === 'count') {\\n      try {\\n        if (!sess._rig && G.makeRig) {\\n          const look = G.lookColors ? G.lookColors(G.profile) : null;\\n          sess._rig = G.makeRig(G.playerOpts(look, 2.1));\\n        }\\n        if (sess._rig && (sess.phase === 'play' || sess.phase === 'demo')) {\\n          const pose = sess.act.family === 'sun' ? G.SUN_POSES[(fam && fam.poseI) || 0] : sess.act.pose;\\n          if (sess.phase === 'demo') G.poseRig(sess._rig, pose || 'idle', sess.demoT, [0, 0]);\\n          else if (fam && sess.seats[0].bal) {\\n            const b = sess.seats[0].bal;\\n            sess._rig.wob = [b.py, b.px];\\n            if (sess.act.family === 'lunge' || sess.act.id === 'lunge') sess._rig.body = G.sideLunge(b.px);\\n            else if (sess.act.id === 'hoop') sess._rig.body = G.hula(fam.ang || 0);\\n            else G.poseRig(sess._rig, pose || 'idle', fam.t, [b.py, b.px]);\\n          }\\n          G.stepRig(sess._rig, DT, 0, 0);\\n          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\\n        }\\n      } catch (e) { /* a painted room still reads */ }\\n    }\\n    r.overlay(function (g) {\\n\",\"total_lines\":905}}","is_error":false},{"type":"tool_result","tool_use_id":"call-46d58a32-782a-4944-b1e0-3422c887e87a-12","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n    const want = G.dev.keys.indexOf(key);\\n370→    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n  tapCode('ArrowRight');\\n380→  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n  const botAt = G.dev.tools.indexOf('Bot: good');\\n390→  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n  const offAt = G.dev.tools.indexOf('Bot: off');\\n400→  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n410→  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n  assert(olives.length > 0, 'no olives');\\n420→  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n  const rs0 = G.dev.v.ropeS;\\n430→  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\n440→add('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n450→  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n460→      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n470→    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n480→});\\n\\nadd('rules', 'class seats', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(game.players.length >= 2, 'players ' + game.players.length);\\n  /* Two players: P1 is the left half, so down is KeyS. A fresh press each time, or repeat() waits. */\\n  game.input.press('KeyS');\\n  game.advance(1 / 120);\\n490→  game.input.release('KeyS');\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills && G.scenes.class._pills.i === 1, 'pill ' + (G.scenes.class._pills && G.scenes.class._pills.i));\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 200 && (!G.session || G.session.phase !== 'play')) game.advance(1 / 120);\\n  assert(G.session && G.session.act.id === 'candle', 'activity ' + (G.session && G.session.act.id));\\n  assert(G.session && G.session.phase === 'play', 'phase ' + (G.session && G.session.phase));\\n  const seats = G.session.seats;\\n500→  assert(seats.length >= 2 && seats[0].human && seats[1].human, 'seats ' + seats.map(function (q) { return q.name + ':' + q.human; }).join(','));\\n  assert(!seats[0].skill && !seats[1].skill, 'skills ' + seats[0].skill + ' ' + seats[1].skill);\\n  game.players[1].press('ArrowRight');\\n  game.advance(1.2);\\n  assert(Math.abs(seats[1].bal.px) > Math.abs(seats[0].bal.px) + 0.05, 'px ' + seats[0].bal.px + ' ' + seats[1].bal.px);\\n  guard = 0;\\n  while (guard++ < 8000 && G.session && G.session.phase !== 'results') game.advance(0.25);\\n  assert(G.session && G.session.phase === 'results', 'no results');\\n  assert(seats[0].score !== seats[1].score, 'scores ' + seats[0].score + ' ' + seats[1].score + ' pct ' + seats[0].pct + ' ' + seats[1].pct);\\n  assert(seats[0].score >= 0 && seats[0].score <= 1000 && seats[1].score >= 0 && seats[1].score <= 1000, 'range');\\n510→  game.players[1].release('ArrowRight');\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n  const sent = [];\\n  const progress = [];\\n  let result = null;\\n520→  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n530→    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot();\\n540→    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n550→    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n    game.advance(8);\\n    const live = G.session;\\n    assert(live && live.seats[0] && !live.seats[0].skill, 'hub skill ' + (live && live.seats[0] && live.seats[0].skill));\\n560→    assert(G.driver == null, 'hub driver ' + G.driver);\\n    const humanPct = live.pct;\\n    const lean = { ux: G.lean.ux, uy: G.lean.uy, breath: G.lean.breath };\\n    const ref = new G.Session({ id: live.act.id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: live.seed });\\n    const nStep = Math.max(1, Math.round((live.playTime + 0.45) * 120));\\n    for (let i = 0; i < nStep; i++) ref.update(1 / 120);\\n    G.lean.ux = lean.ux; G.lean.uy = lean.uy; G.lean.breath = lean.breath;\\n    assert(Math.abs(humanPct - ref.pct) > 0.02, 'still posted the good bot ' + humanPct + ' vs ' + ref.pct + ' on ' + live.act.id);\\n    const before = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    game.input.press('KeyD');\\n570→    game.advance(0.5);\\n    const after = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    assert(Math.abs(after - before) > 0.02, 'held lean px ' + before + ' -> ' + after + ' on ' + live.act.id);\\n    game.input.release('KeyD');\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n580→    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\n590→add('rules', 'hub ghosts', async () => {\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() { return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] }); },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return 0; },\\n    answer() {},\\n    send() {},\\n    progress() {},\\n600→    result() {},\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot({ draw: true });\\n    await new Promise(function (r) { setImmediate(r); });\\n    game.advance(0.5);\\n    assert(scenesEi(game) === 0, 'event ' + scenesEi(game));\\n    (handlers.message || []).forEach(function (fn) {\\n610→      fn({ t: 'g', a: 0, l: [0.42, -0.25], w: [0.1, 0.05], s: 10 }, 'seat-2');\\n      fn({ t: 'g', a: 1, l: [0.9, 0.9], w: [0.2, 0.2], s: 1 }, 'seat-3');\\n    });\\n    const seen = [];\\n    const orig = game.r.actor;\\n    game.r.actor = function (x, y, z, fn, o) {\\n      seen.push(o || {});\\n      return orig.apply(this, arguments);\\n    };\\n    game.advance(1 / 120);\\n620→    game.r.actor = orig;\\n    const faded = seen.filter(function (o) { return o && o.alpha === 0.5; });\\n    assert(faded.length >= 1, 'ghost alpha calls ' + seen.length);\\n    const mine = G.ghosts.filter(function (q) { return q.from === 'seat-2'; })[0];\\n    const other = G.ghosts.filter(function (q) { return q.from === 'seat-3'; })[0];\\n    assert(mine && mine.rig, 'matching ghost was not drawn');\\n    assert(Math.abs(mine.rig.wob[1] - 0.52) < 1e-6 && Math.abs(mine.rig.wob[0] - -0.2) < 1e-6, 'wob ' + mine.rig.wob);\\n    assert(other && !other.rig, 'wrong event drew a rig');\\n    assert(!game.errors.length, 'draw errors');\\n  } finally {\\n630→    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nfunction scenesEi() { return G.scenes && G.scenes.round ? G.scenes.round.ei : null; }\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n640→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n650→  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n660→      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n670→\\nfunction buildHtml() {\\n  const r = spawnSync(process.execPath, ['build.mjs'], { cwd: dev, encoding: 'utf8' });\\n  if (r.status) throw new Error(r.stdout + '\\\\n' + r.stderr);\\n  return HTML;\\n}\\n\\nfunction startServer(dir) {\\n  return new Promise(function (resolve, reject) {\\n    const child = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\\n680→    let buf = '';\\n    let settled = false;\\n    const take = function (chunk) {\\n      buf += chunk.toString();\\n      const m = buf.match(/port (\\\\d+)/i);\\n      if (m && !settled) { settled = true; resolve({ child: child, port: +m[1] }); }\\n    };\\n    child.stdout.on('data', take);\\n    child.stderr.on('data', take);\\n    child.on('exit', function (code) {\",\"content_concise\":\"330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n    const want = G.dev.keys.indexOf(key);\\n370→    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n  tapCode('ArrowRight');\\n380→  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n  const botAt = G.dev.tools.indexOf('Bot: good');\\n390→  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n  const offAt = G.dev.tools.indexOf('Bot: off');\\n400→  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n410→  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n  assert(olives.length > 0, 'no olives');\\n420→  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n  const rs0 = G.dev.v.ropeS;\\n430→  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\n440→add('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n450→  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n460→      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n470→    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n480→});\\n\\nadd('rules', 'class seats', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(game.players.length >= 2, 'players ' + game.players.length);\\n  /* Two players: P1 is the left half, so down is KeyS. A fresh press each time, or repeat() waits. */\\n  game.input.press('KeyS');\\n  game.advance(1 / 120);\\n490→  game.input.release('KeyS');\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills && G.scenes.class._pills.i === 1, 'pill ' + (G.scenes.class._pills && G.scenes.class._pills.i));\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 200 && (!G.session || G.session.phase !== 'play')) game.advance(1 / 120);\\n  assert(G.session && G.session.act.id === 'candle', 'activity ' + (G.session && G.session.act.id));\\n  assert(G.session && G.session.phase === 'play', 'phase ' + (G.session && G.session.phase));\\n  const seats = G.session.seats;\\n500→  assert(seats.length >= 2 && seats[0].human && seats[1].human, 'seats ' + seats.map(function (q) { return q.name + ':' + q.human; }).join(','));\\n  assert(!seats[0].skill && !seats[1].skill, 'skills ' + seats[0].skill + ' ' + seats[1].skill);\\n  game.players[1].press('ArrowRight');\\n  game.advance(1.2);\\n  assert(Math.abs(seats[1].bal.px) > Math.abs(seats[0].bal.px) + 0.05, 'px ' + seats[0].bal.px + ' ' + seats[1].bal.px);\\n  guard = 0;\\n  while (guard++ < 8000 && G.session && G.session.phase !== 'results') game.advance(0.25);\\n  assert(G.session && G.session.phase === 'results', 'no results');\\n  assert(seats[0].score !== seats[1].score, 'scores ' + seats[0].score + ' ' + seats[1].score + ' pct ' + seats[0].pct + ' ' + seats[1].pct);\\n  assert(seats[0].score >= 0 && seats[0].score <= 1000 && seats[1].score >= 0 && seats[1].score <= 1000, 'range');\\n510→  game.players[1].release('ArrowRight');\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n  const sent = [];\\n  const progress = [];\\n  let result = null;\\n520→  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n530→    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot();\\n540→    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n550→    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n    game.advance(8);\\n    const live = G.session;\\n    assert(live && live.seats[0] && !live.seats[0].skill, 'hub skill ' + (live && live.seats[0] && live.seats[0].skill));\\n560→    assert(G.driver == null, 'hub driver ' + G.driver);\\n    const humanPct = live.pct;\\n    const lean = { ux: G.lean.ux, uy: G.lean.uy, breath: G.lean.breath };\\n    const ref = new G.Session({ id: live.act.id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: live.seed });\\n    const nStep = Math.max(1, Math.round((live.playTime + 0.45) * 120));\\n    for (let i = 0; i < nStep; i++) ref.update(1 / 120);\\n    G.lean.ux = lean.ux; G.lean.uy = lean.uy; G.lean.breath = lean.breath;\\n    assert(Math.abs(humanPct - ref.pct) > 0.02, 'still posted the good bot ' + humanPct + ' vs ' + ref.pct + ' on ' + live.act.id);\\n    const before = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    game.input.press('KeyD');\\n570→    game.advance(0.5);\\n    const after = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    assert(Math.abs(after - before) > 0.02, 'held lean px ' + before + ' -> ' + after + ' on ' + live.act.id);\\n    game.input.release('KeyD');\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n580→    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\n590→add('rules', 'hub ghosts', async () => {\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() { return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] }); },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return 0; },\\n    answer() {},\\n    send() {},\\n    progress() {},\\n600→    result() {},\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot({ draw: true });\\n    await new Promise(function (r) { setImmediate(r); });\\n    game.advance(0.5);\\n    assert(scenesEi(game) === 0, 'event ' + scenesEi(game));\\n    (handlers.message || []).forEach(function (fn) {\\n610→      fn({ t: 'g', a: 0, l: [0.42, -0.25], w: [0.1, 0.05], s: 10 }, 'seat-2');\\n      fn({ t: 'g', a: 1, l: [0.9, 0.9], w: [0.2, 0.2], s: 1 }, 'seat-3');\\n    });\\n    const seen = [];\\n    const orig = game.r.actor;\\n    game.r.actor = function (x, y, z, fn, o) {\\n      seen.push(o || {});\\n      return orig.apply(this, arguments);\\n    };\\n    game.advance(1 / 120);\\n620→    game.r.actor = orig;\\n    const faded = seen.filter(function (o) { return o && o.alpha === 0.5; });\\n    assert(faded.length >= 1, 'ghost alpha calls ' + seen.length);\\n    const mine = G.ghosts.filter(function (q) { return q.from === 'seat-2'; })[0];\\n    const other = G.ghosts.filter(function (q) { return q.from === 'seat-3'; })[0];\\n    assert(mine && mine.rig, 'matching ghost was not drawn');\\n    assert(Math.abs(mine.rig.wob[1] - 0.52) < 1e-6 && Math.abs(mine.rig.wob[0] - -0.2) < 1e-6, 'wob ' + mine.rig.wob);\\n    assert(other && !other.rig, 'wrong event drew a rig');\\n    assert(!game.errors.length, 'draw errors');\\n  } finally {\\n630→    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nfunction scenesEi() { return G.scenes && G.scenes.round ? G.scenes.round.ei : null; }\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n640→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n650→  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n660→      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n670→\\nfunction buildHtml() {\\n  const r = spawnSync(process.execPath, ['build.mjs'], { cwd: dev, encoding: 'utf8' });\\n  if (r.status) throw new Error(r.stdout + '\\\\n' + r.stderr);\\n  return HTML;\\n}\\n\\nfunction startServer(dir) {\\n  return new Promise(function (resolve, reject) {\\n    const child = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\\n680→    let buf = '';\\n    let settled = false;\\n    const take = function (chunk) {\\n      buf += chunk.toString();\\n      const m = buf.match(/port (\\\\d+)/i);\\n      if (m && !settled) { settled = true; resolve({ child: child, port: +m[1] }); }\\n    };\\n    child.stdout.on('data', take);\\n    child.stderr.on('data', take);\\n    child.on('exit', function (code) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs\",\"offset\":330,\"limit\":360,\"raw_output\":\"  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n    const want = G.dev.keys.indexOf(key);\\n    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n  const botAt = G.dev.tools.indexOf('Bot: good');\\n  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n  const offAt = G.dev.tools.indexOf('Bot: off');\\n  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n  assert(olives.length > 0, 'no olives');\\n  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n  const rs0 = G.dev.v.ropeS;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n});\\n\\nadd('rules', 'class seats', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(game.players.length >= 2, 'players ' + game.players.length);\\n  /* Two players: P1 is the left half, so down is KeyS. A fresh press each time, or repeat() waits. */\\n  game.input.press('KeyS');\\n  game.advance(1 / 120);\\n  game.input.release('KeyS');\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills && G.scenes.class._pills.i === 1, 'pill ' + (G.scenes.class._pills && G.scenes.class._pills.i));\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 200 && (!G.session || G.session.phase !== 'play')) game.advance(1 / 120);\\n  assert(G.session && G.session.act.id === 'candle', 'activity ' + (G.session && G.session.act.id));\\n  assert(G.session && G.session.phase === 'play', 'phase ' + (G.session && G.session.phase));\\n  const seats = G.session.seats;\\n  assert(seats.length >= 2 && seats[0].human && seats[1].human, 'seats ' + seats.map(function (q) { return q.name + ':' + q.human; }).join(','));\\n  assert(!seats[0].skill && !seats[1].skill, 'skills ' + seats[0].skill + ' ' + seats[1].skill);\\n  game.players[1].press('ArrowRight');\\n  game.advance(1.2);\\n  assert(Math.abs(seats[1].bal.px) > Math.abs(seats[0].bal.px) + 0.05, 'px ' + seats[0].bal.px + ' ' + seats[1].bal.px);\\n  guard = 0;\\n  while (guard++ < 8000 && G.session && G.session.phase !== 'results') game.advance(0.25);\\n  assert(G.session && G.session.phase === 'results', 'no results');\\n  assert(seats[0].score !== seats[1].score, 'scores ' + seats[0].score + ' ' + seats[1].score + ' pct ' + seats[0].pct + ' ' + seats[1].pct);\\n  assert(seats[0].score >= 0 && seats[0].score <= 1000 && seats[1].score >= 0 && seats[1].score <= 1000, 'range');\\n  game.players[1].release('ArrowRight');\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n  const sent = [];\\n  const progress = [];\\n  let result = null;\\n  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot();\\n    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n    game.advance(8);\\n    const live = G.session;\\n    assert(live && live.seats[0] && !live.seats[0].skill, 'hub skill ' + (live && live.seats[0] && live.seats[0].skill));\\n    assert(G.driver == null, 'hub driver ' + G.driver);\\n    const humanPct = live.pct;\\n    const lean = { ux: G.lean.ux, uy: G.lean.uy, breath: G.lean.breath };\\n    const ref = new G.Session({ id: live.act.id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: live.seed });\\n    const nStep = Math.max(1, Math.round((live.playTime + 0.45) * 120));\\n    for (let i = 0; i < nStep; i++) ref.update(1 / 120);\\n    G.lean.ux = lean.ux; G.lean.uy = lean.uy; G.lean.breath = lean.breath;\\n    assert(Math.abs(humanPct - ref.pct) > 0.02, 'still posted the good bot ' + humanPct + ' vs ' + ref.pct + ' on ' + live.act.id);\\n    const before = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    game.input.press('KeyD');\\n    game.advance(0.5);\\n    const after = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    assert(Math.abs(after - before) > 0.02, 'held lean px ' + before + ' -> ' + after + ' on ' + live.act.id);\\n    game.input.release('KeyD');\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nadd('rules', 'hub ghosts', async () => {\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() { return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] }); },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return 0; },\\n    answer() {},\\n    send() {},\\n    progress() {},\\n    result() {},\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot({ draw: true });\\n    await new Promise(function (r) { setImmediate(r); });\\n    game.advance(0.5);\\n    assert(scenesEi(game) === 0, 'event ' + scenesEi(game));\\n    (handlers.message || []).forEach(function (fn) {\\n      fn({ t: 'g', a: 0, l: [0.42, -0.25], w: [0.1, 0.05], s: 10 }, 'seat-2');\\n      fn({ t: 'g', a: 1, l: [0.9, 0.9], w: [0.2, 0.2], s: 1 }, 'seat-3');\\n    });\\n    const seen = [];\\n    const orig = game.r.actor;\\n    game.r.actor = function (x, y, z, fn, o) {\\n      seen.push(o || {});\\n      return orig.apply(this, arguments);\\n    };\\n    game.advance(1 / 120);\\n    game.r.actor = orig;\\n    const faded = seen.filter(function (o) { return o && o.alpha === 0.5; });\\n    assert(faded.length >= 1, 'ghost alpha calls ' + seen.length);\\n    const mine = G.ghosts.filter(function (q) { return q.from === 'seat-2'; })[0];\\n    const other = G.ghosts.filter(function (q) { return q.from === 'seat-3'; })[0];\\n    assert(mine && mine.rig, 'matching ghost was not drawn');\\n    assert(Math.abs(mine.rig.wob[1] - 0.52) < 1e-6 && Math.abs(mine.rig.wob[0] - -0.2) < 1e-6, 'wob ' + mine.rig.wob);\\n    assert(other && !other.rig, 'wrong event drew a rig');\\n    assert(!game.errors.length, 'draw errors');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nfunction scenesEi() { return G.scenes && G.scenes.round ? G.scenes.round.ei : null; }\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n\\nfunction buildHtml() {\\n  const r = spawnSync(process.execPath, ['build.mjs'], { cwd: dev, encoding: 'utf8' });\\n  if (r.status) throw new Error(r.stdout + '\\\\n' + r.stderr);\\n  return HTML;\\n}\\n\\nfunction startServer(dir) {\\n  return new Promise(function (resolve, reject) {\\n    const child = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\\n    let buf = '';\\n    let settled = false;\\n    const take = function (chunk) {\\n      buf += chunk.toString();\\n      const m = buf.match(/port (\\\\d+)/i);\\n      if (m && !settled) { settled = true; resolve({ child: child, port: +m[1] }); }\\n    };\\n    child.stdout.on('data', take);\\n    child.stderr.on('data', take);\\n    child.on('exit', function (code) {\\n\",\"total_lines\":969}}","is_error":false},{"type":"tool_result","tool_use_id":"call-46d58a32-782a-4944-b1e0-3422c887e87a-13","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"180→          if (game.sceneName === 'round') game.go('title');\\n          return;\\n        }\\n        G.hubInfo = info;\\n        const ready = function () { try { AIHub.ready(); } catch (e) { /* not welcomed yet */ } };\\n        if (game.booted && game.booted.then) game.booted.then(ready);\\n        else ready();\\n      });\\n    }\\n  }\\n190→\\n  G.boot = function (opts) {\\n    opts = opts || {};\\n    if (G.game) {\\n      try { G.game.dispose(); } catch (e) { /* already gone */ }\\n      try { E.store.clear(); } catch (e) { /* no store */ }\\n      G.game = null;\\n    }\\n    G.i