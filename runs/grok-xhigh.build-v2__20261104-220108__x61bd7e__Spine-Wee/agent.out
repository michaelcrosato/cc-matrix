\\n  /** put a group's settings (or all of them) back to their defaults; a game's saves are not touched */\\n  reset(group) {\\n    for (const k of this.keys(group)) { if (k === 'fullscreen') continue; delete this._saved[k]; this[k] = this.default(k); this._apply(k); if (this.onChange) this.onChange(k, this[k]); }\\n    this._save();\\n3140→  }\\n  _apply(key) { const s = this._specs[key]; if (s && s.apply) try { s.apply(this._g, this[key]); } catch (e) { this._g.fail('setting \\\"' + key + '\\\"', e); } }\\n  _save() {\\n    if (this._g.headless) return;\\n    this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: this._saved });   // false when the last save failed (storage blocked or full: the choices last for this visit)\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js\",\"offset\":3045,\"limit\":100,\"raw_output\":\"const STANDARD_SETTINGS = {\\n  fullscreen: { group: 'Display', label: 'Full screen', type: 'fullscreen', value: null },   // the player's choice: true, false (turned it off), null (never chose)\\n  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\\n  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\\\'t. 60: every other refresh on a 120 Hz screen. Full: every refresh' },\\n  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\\\'s refresh and a frame\\\\'s cost' },\\n  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\\n  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\\\'s rows. CRT: those, its colored stripes and its darker corners', apply: (g, v) => { g.screen.filter = v; } },\\n  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\\n  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\\n  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\\n  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\\n  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\\n  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\\n  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\\n  bindings: { group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { g.input.bindings = v; } },\\n  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { for (const q of g._players || [g.input]) q.deadzone = v; } },\\n  invertY: { group: 'Controller', label: 'Invert aim up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertAimY = !!v; } },\\n  invertMoveX: { group: 'Controller', label: 'Invert move left and right', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveX = !!v; } },\\n  invertMoveY: { group: 'Controller', label: 'Invert move up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveY = !!v; } },\\n  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { for (const q of g._players || [g.input]) q.glyphs = v; } },\\n  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { for (const q of g._players || [g.input]) q.rumbleScale = v; } },\\n  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\\n  hand: { group: 'Touch', label: 'Buttons on', type: 'select', value: 'right', options: [['right', 'Right'], ['left', 'Left']], apply: g => g.input._touchSync() },\\n  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\\n  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\\n};\\n/** a value for a setting, checked: the value kept, or undefined when it can't be one */\\nfunction settingValue(sp, v) {\\n  if (sp.type === 'toggle') return typeof v === 'boolean' ? v : undefined;\\n  if (sp.type === 'fullscreen') return v === true || v === false || v === null ? v : undefined;\\n  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\\n  if (sp.type === 'select') return (sp.options || []).some(o => (Array.isArray(o) ? o[0] : o) === v) ? v : undefined;\\n  if (sp.type === 'bindings') {\\n    if (!v || typeof v !== 'object' || Array.isArray(v)) return undefined;\\n    const out = {};\\n    for (const a in v) { const b = v[a]; if (!b || typeof b !== 'object') continue; const o = {}; for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) o[k] = b[k].filter(c => typeof c === 'string' && BINDABLE.test(c) && padCode(c) === (k === 'pad')).slice(0, 4); out[a] = o; }\\n    return out;\\n  }\\n  return v === undefined || typeof v === 'function' ? undefined : v;   // a type of the game's own: any JSON value\\n}\\nclass Settings {\\n  /**\\n   * game.settings: the player's choices, one property each (game.settings.volume), with the game's own (o.menu.settings)\\n   * beside the standard ones (STANDARD_SETTINGS). Saved with E.store under 'settings:' + the game's id, with a version;\\n   * on load every value is checked and a bad one falls back to its default. Where storage is blocked the game plays on\\n   * with the defaults (saved: false)\\n   */\\n  constructor(game, own = []) {\\n    const hide = (k, v) => Object.defineProperty(this, k, { value: v, writable: true });\\n    hide('_g', game); hide('_specs', {}); hide('_saved', {}); hide('_key', 'settings:' + (game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game'));\\n    hide('saved', true);\\n    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\\n    hide('onChange', null);\\n    const raw = store.get(this._key, null);\\n    hide('_raw', raw && typeof raw === 'object' && raw.values && typeof raw.values === 'object' ? raw.values : {});   // (a newer version's values are checked like the rest)\\n    if (!(raw && raw.v >= 2) && this._raw.fullscreen === false) delete this._raw.fullscreen;\\n    game.input._settings = this; game.input._onBindings = b => this.set('bindings', b);\\n    for (const k in STANDARD_SETTINGS) if (!(game.o.touch === 'never' && STANDARD_SETTINGS[k].group === 'Touch')) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));   // (touch: 'never': no Touch group)\\n    for (const sp of own) this.define(sp && !sp.label && Object.prototype.hasOwnProperty.call(STANDARD_SETTINGS, sp.key) ? Object.assign({ key: sp.key }, STANDARD_SETTINGS[sp.key], sp) : sp);   // (a standard key with no label: the game's fields over the standard ones; with a label it is the game's own)\\n  }\\n  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\\n   *  label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and\\n   *  applied; it shows on the settings screen. Returns its value */\\n  define(sp) {\\n    if (!sp || !sp.key || typeof sp.key !== 'string') { warn('setting', 'a setting needs a key: { key: \\\"hints\\\", label: \\\"Hints\\\", value: true }'); return undefined; }\\n    if (sp.key in Settings.prototype || sp.key === 'saved' || sp.key === 'onChange' || sp.key[0] === '_') { warn('setting:' + sp.key, 'a setting cannot be called \\\"' + sp.key + '\\\" (a name the settings object uses)'); return undefined; }\\n    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }, sp);\\n    this._specs[s.key] = s;\\n    const saved = settingValue(s, this._raw[s.key]);\\n    if (saved !== undefined) this._saved[s.key] = saved;\\n    this[s.key] = saved !== undefined ? saved : this.default(s.key);\\n    this._apply(s.key);\\n    return this[s.key];\\n  }\\n  /** a setting's default value */\\n  default(key) { const s = this._specs[key]; if (!s) return undefined; const v = typeof s.value === 'function' ? s.value(this._g) : s.value; return v === undefined && s.type === 'toggle' ? false : v; }\\n  /** the spec a setting was defined with (its label, type, range, options), or undefined */\\n  spec(key) { return this._specs[key]; }\\n  /** the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key */\\n  keys(group) { return Object.keys(this._specs).filter(k => !group || this._specs[k].group === group); }\\n  /** change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told.\\n   *  Returns the value kept (the old one when v is not a valid value) */\\n  set(key, v) {\\n    const s = this._specs[key]; if (!s) { warn('setting:' + key, 'unknown setting \\\"' + key + '\\\". Settings: ' + this.keys().join(', ')); return undefined; }\\n    const ok = settingValue(s, v); if (ok === undefined) return this[key];\\n    this[key] = ok; this._saved[key] = ok; this._save(); this._apply(key);\\n    if (this.onChange) try { this.onChange(key, ok); } catch (e) { this._g.fail('settings.onChange', e); }\\n    return ok;\\n  }\\n  /** put a group's settings (or all of them) back to their defaults; a game's saves are not touched */\\n  reset(group) {\\n    for (const k of this.keys(group)) { if (k === 'fullscreen') continue; delete this._saved[k]; this[k] = this.default(k); this._apply(k); if (this.onChange) this.onChange(k, this[k]); }\\n    this._save();\\n  }\\n  _apply(key) { const s = this._specs[key]; if (s && s.apply) try { s.apply(this._g, this[key]); } catch (e) { this._g.fail('setting \\\"' + key + '\\\"', e); } }\\n  _save() {\\n    if (this._g.headless) return;\\n    this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: this._saved });   // false when the last save failed (storage blocked or full: the choices last for this visit)\\n\",\"total_lines\":14974}}","is_error":false},{"type":"tool_result","tool_use_id":"call-14782522-3034-471f-856d-0a20d222e985-15","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"3870→ *      game.saves.save(0); game.saves.load(0); game.saves.copy(0, 1); game.saves.erase(1); game.saves.autosave();\\n *      game.saves.list()   // the slots, autosave first: [{ slot: 'auto' | 0 | 1 | 2, empty, place, level, time, at, damaged, newer }]\\n *    new E.Game({ menu: { saves: true } }) puts Save (while saves.canSave: a JRPG sets it at a save point) and Load in\\n *    the pause menu, each opening the standard screen (the slots with their place, level and time; save, load, copy and\\n *    erase, asking before a save is lost); game.saves.show('save' | 'load') opens it from a game's own menu or title.\\n *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\\n * ============================================================================= */\\nconst SAVE_FORMAT = 1;   // the record's own shape: { v, version, data, place, level, time, at }\\nclass Saves {\\n  /** game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read }) */\\n3880→  constructor(game, o) {\\n    o = o && typeof o === 'object' ? o : {};\\n    /** game: its game; slots: how many slots besides the autosave (3); version: the game's version of its data (1),\\n     *  saved with each save; migrate(data, from): an older version's data brought up to this one (or null: kept as it\\n     *  is); write(): what a save holds ({ data, place, level }); read(save): what a load does with { data, place,\\n     *  level, time, slot } */\\n    this.game = game; this.slots = o.slots || 3; this.version = o.version || 1; this.migrate = o.migrate || null; this.write = o.write || null; this.read = o.read || null;\\n    /** canSave: the pause menu offers Save (a JRPG turns it off away from save points); played: seconds played in the\\n     *  game's scenes (paused time and titles left out), saved with each save and set by a load; blocked: storage\\n     *  refused a save (they last for the visit) */\\n3890→    this.canSave = true; this.played = 0; this.blocked = false;\\n    this._mem = {};   // each slot's record as text, this visit's (what storage refused stays here)\\n  }\\n  _key(slot) { return 'save:' + (this.game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game') + ':' + slot; }\\n  _ok(slot) { return slot === 'auto' || (Number.isInteger(slot) && slot >= 0 && slot < this.slots); }\\n  _raw(slot) {\\n    if (slot in this._mem) return this._mem[slot];\\n    if (this.game.headless) return null;\\n    try { return localStorage.getItem('my3d2dge:' + this._key(slot)); } catch (e) { return null; }\\n  }\\n3900→  _put(slot, text) {\\n    this._mem[slot] = text; if (this.game.headless) return true;\\n    try { if (text === null) localStorage.removeItem('my3d2dge:' + this._key(slot)); else localStorage.setItem('my3d2dge:' + this._key(slot), text); return true; }\\n    catch (e) { if (!this.blocked) warn('saves:blocked', 'game.saves: storage is blocked or full: the saves last for this visit'); this.blocked = true; return false; }\\n  }\\n  /** a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer:\\n   *  true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version } */\\n  get(slot) {\\n    if (!this._ok(slot)) return null;\\n    const t = this._raw(slot); if (t === null || t === undefined) return null;\\n3910→    let s; try { s = JSON.parse(t); } catch (e) { s = null; }\\n    if (!s || typeof s !== 'object' || s.v !== SAVE_FORMAT || !('data' in s)) return { slot, damaged: true };\\n    const out = { slot, data: s.data, place: typeof s.place === 'string' ? s.place : '', level: s.level === undefined ? null : s.level, time: +s.time || 0, at: +s.at || 0, version: +s.version || 1 };\\n    if (out.version > this.version) out.newer = true;\\n    return out;\\n  }\\n  /** every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows) */\\n  list() { return ['auto'].concat(Array.from({ length: this.slots }, (_, i) => i)).map(slot => Object.assign({ slot, empty: false }, this.get(slot) || { empty: true })); }\\n  /** save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\\n   *  (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save */\\n3920→  save(slot, o) {\\n    if (!this._ok(slot)) { warn('saves:slot:' + slot, 'game.saves: no slot ' + slot + ' (0 to ' + (this.slots - 1) + ', or \\\"auto\\\")'); return false; }\\n    if (!o && this.write) try { o = this.write(slot); } catch (e) { this.game.fail('saves.write', e); return false; }\\n    if (!o || !('data' in o)) { warn('saves:write', 'game.saves: nothing to save: give save(slot, { data, place, level }) or set saves.write'); return false; }\\n    let text; try { text = JSON.stringify({ v: SAVE_FORMAT, version: this.version, data: o.data, place: o.place || '', level: o.level === undefined ? null : o.level, time: Math.round(this.played * 10) / 10, at: Date.now() }); }\\n    catch (e) { this.game.fail('saves.save', e); return false; }\\n    this._put(slot, text); return true;\\n  }\\n  /** save to the autosave (what write() gives) */\\n  autosave(o) { return this.save('auto', o); }\\n3930→  /** load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save\\n   *  ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version */\\n  load(slot) {\\n    const s = this.get(slot); if (!s || s.damaged || s.newer) return null;\\n    if (s.version < this.version && this.migrate) try { s.data = this.migrate(s.data, s.version); } catch (e) { this.game.fail('saves.migrate', e); return null; }\\n    this.played = s.time;\\n    if (this.read) try { this.read(s); } catch (e) { this.game.fail('saves.read', e); return null; }\\n    return s;\\n  }\\n  /** copy a slot's save onto another (over what is there); false when the first is empty */\\n3940→  copy(from, to) { if (!this._ok(from) || !this._ok(to)) return false; const t = this._raw(from); if (t === null || t === undefined) return false; this._put(to, t); return true; }\\n  /** erase a slot */\\n  erase(slot) { if (this._ok(slot)) this._put(slot, null); }\\n  /** is there any save to load (a title's Continue)? */\\n  get any() { return this.list().some(s => !s.empty && !s.damaged && !s.newer); }\\n  /** the most recent save that loads, or null (a title's Continue loads it) */\\n  latest() { return this.list().filter(s => !s.empty && !s.damaged && !s.newer).sort((a, b) => b.at - a.at)[0] || null; }\\n  /** open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or\\n   *  a save. False without a menu (a headless game, menu: false) */\\n  show(mode = 'load', done) {\\n3950→    const sh = this.game.shell; if (!sh || !sh._menu()) return false;\\n    const T = s => { const m = Math.floor(s.time / 60); return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0'); };\\n    const name = slot => slot === 'auto' ? 'Autosave' : 'Slot ' + (slot + 1);\\n    const about = s => s.empty ? 'Empty' : s.damaged ? 'Damaged: it cannot be read' : s.newer ? 'From a newer version of the game' : [s.place, s.level !== null ? 'Level ' + s.level : '', T(s), s.at ? new Date(s.at).toLocaleDateString() : ''].filter(Boolean).join(' · ');\\n    const page = () => sh.show('saves', { kicker: mode === 'save' ? 'Save' : 'Load', title: mode === 'save' ? 'Save your game' : 'Load a game', text: this.blocked ? 'Saving is blocked here: these saves last for this visit.' : '',\\n      actions: this.list().filter(s => mode === 'load' || s.slot !== 'auto').map(s => ({ label: name(s.slot) + ' — ' + about(s), fn: () => slot(s) })).concat([['Back', () => sh.back()]]) });\\n    const ask = (title, text, label, fn) => sh.show('confirm', { kicker: 'Save', title, text, actions: [{ label: 'Keep it', fn: () => sh.back() }, { label, fn: () => { sh.back(); fn(); } }] });\\n    const saved = () => { sh.toast('Saved', name(this._last)); if (done) done(this.get(this._last)); };\\n    const slot = s => {\\n      const acts = [];\",\"content_concise\":\"3870→ *      game.saves.save(0); game.saves.load(0); game.saves.copy(0, 1); game.saves.erase(1); game.saves.autosave();\\n *      game.saves.list()   // the slots, autosave first: [{ slot: 'auto' | 0 | 1 | 2, empty, place, level, time, at, damaged, newer }]\\n *    new E.Game({ menu: { saves: true } }) puts Save (while saves.canSave: a JRPG sets it at a save point) and Load in\\n *    the pause menu, each opening the standard screen (the slots with their place, level and time; save, load, copy and\\n *    erase, asking before a save is lost); game.saves.show('save' | 'load') opens it from a game's own menu or title.\\n *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\\n * ============================================================================= */\\nconst SAVE_FORMAT = 1;   // the record's own shape: { v, version, data, place, level, time, at }\\nclass Saves {\\n  /** game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read }) */\\n3880→  constructor(game, o) {\\n    o = o && typeof o === 'object' ? o : {};\\n    /** game: its game; slots: how many slots besides the autosave (3); version: the game's version of its data (1),\\n     *  saved with each save; migrate(data, from): an older version's data brought up to this one (or null: kept as it\\n     *  is); write(): what a save holds ({ data, place, level }); read(save): what a load does with { data, place,\\n     *  level, time, slot } */\\n    this.game = game; this.slots = o.slots || 3; this.version = o.version || 1; this.migrate = o.migrate || null; this.write = o.write || null; this.read = o.read || null;\\n    /** canSave: the pause menu offers Save (a JRPG turns it off away from save points); played: seconds played in the\\n     *  game's scenes (paused time and titles left out), saved with each save and set by a load; blocked: storage\\n     *  refused a save (they last for the visit) */\\n3890→    this.canSave = true; this.played = 0; this.blocked = false;\\n    this._mem = {};   // each slot's record as text, this visit's (what storage refused stays here)\\n  }\\n  _key(slot) { return 'save:' + (this.game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game') + ':' + slot; }\\n  _ok(slot) { return slot === 'auto' || (Number.isInteger(slot) && slot >= 0 && slot < this.slots); }\\n  _raw(slot) {\\n    if (slot in this._mem) return this._mem[slot];\\n    if (this.game.headless) return null;\\n    try { return localStorage.getItem('my3d2dge:' + this._key(slot)); } catch (e) { return null; }\\n  }\\n3900→  _put(slot, text) {\\n    this._mem[slot] = text; if (this.game.headless) return true;\\n    try { if (text === null) localStorage.removeItem('my3d2dge:' + this._key(slot)); else localStorage.setItem('my3d2dge:' + this._key(slot), text); return true; }\\n    catch (e) { if (!this.blocked) warn('saves:blocked', 'game.saves: storage is blocked or full: the saves last for this visit'); this.blocked = true; return false; }\\n  }\\n  /** a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer:\\n   *  true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version } */\\n  get(slot) {\\n    if (!this._ok(slot)) return null;\\n    const t = this._raw(slot); if (t === null || t === undefined) return null;\\n3910→    let s; try { s = JSON.parse(t); } catch (e) { s = null; }\\n    if (!s || typeof s !== 'object' || s.v !== SAVE_FORMAT || !('data' in s)) return { slot, damaged: true };\\n    const out = { slot, data: s.data, place: typeof s.place === 'string' ? s.place : '', level: s.level === undefined ? null : s.level, time: +s.time || 0, at: +s.at || 0, version: +s.version || 1 };\\n    if (out.version > this.version) out.newer = true;\\n    return out;\\n  }\\n  /** every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows) */\\n  list() { return ['auto'].concat(Array.from({ length: this.slots }, (_, i) => i)).map(slot => Object.assign({ slot, empty: false }, this.get(slot) || { empty: true })); }\\n  /** save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\\n   *  (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save */\\n3920→  save(slot, o) {\\n    if (!this._ok(slot)) { warn('saves:slot:' + slot, 'game.saves: no slot ' + slot + ' (0 to ' + (this.slots - 1) + ', or \\\"auto\\\")'); return false; }\\n    if (!o && this.write) try { o = this.write(slot); } catch (e) { this.game.fail('saves.write', e); return false; }\\n    if (!o || !('data' in o)) { warn('saves:write', 'game.saves: nothing to save: give save(slot, { data, place, level }) or set saves.write'); return false; }\\n    let text; try { text = JSON.stringify({ v: SAVE_FORMAT, version: this.version, data: o.data, place: o.place || '', level: o.level === undefined ? null : o.level, time: Math.round(this.played * 10) / 10, at: Date.now() }); }\\n    catch (e) { this.game.fail('saves.save', e); return false; }\\n    this._put(slot, text); return true;\\n  }\\n  /** save to the autosave (what write() gives) */\\n  autosave(o) { return this.save('auto', o); }\\n3930→  /** load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save\\n   *  ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version */\\n  load(slot) {\\n    const s = this.get(slot); if (!s || s.damaged || s.newer) return null;\\n    if (s.version < this.version && this.migrate) try { s.data = this.migrate(s.data, s.version); } catch (e) { this.game.fail('saves.migrate', e); return null; }\\n    this.played = s.time;\\n    if (this.read) try { this.read(s); } catch (e) { this.game.fail('saves.read', e); return null; }\\n    return s;\\n  }\\n  /** copy a slot's save onto another (over what is there); false when the first is empty */\\n3940→  copy(from, to) { if (!this._ok(from) || !this._ok(to)) return false; const t = this._raw(from); if (t === null || t === undefined) return false; this._put(to, t); return true; }\\n  /** erase a slot */\\n  erase(slot) { if (this._ok(slot)) this._put(slot, null); }\\n  /** is there any save to load (a title's Continue)? */\\n  get any() { return this.list().some(s => !s.empty && !s.damaged && !s.newer); }\\n  /** the most recent save that loads, or null (a title's Continue loads it) */\\n  latest() { return this.list().filter(s => !s.empty && !s.damaged && !s.newer).sort((a, b) => b.at - a.at)[0] || null; }\\n  /** open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or\\n   *  a save. False without a menu (a headless game, menu: false) */\\n  show(mode = 'load', done) {\\n3950→    const sh = this.game.shell; if (!sh || !sh._menu()) return false;\\n    const T = s => { const m = Math.floor(s.time / 60); return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0'); };\\n    const name = slot => slot === 'auto' ? 'Autosave' : 'Slot ' + (slot + 1);\\n    const about = s => s.empty ? 'Empty' : s.damaged ? 'Damaged: it cannot be read' : s.newer ? 'From a newer version of the game' : [s.place, s.level !== null ? 'Level ' + s.level : '', T(s), s.at ? new Date(s.at).toLocaleDateString() : ''].filter(Boolean).join(' · ');\\n    const page = () => sh.show('saves', { kicker: mode === 'save' ? 'Save' : 'Load', title: mode === 'save' ? 'Save your game' : 'Load a game', text: this.blocked ? 'Saving is blocked here: these saves last for this visit.' : '',\\n      actions: this.list().filter(s => mode === 'load' || s.slot !== 'auto').map(s => ({ label: name(s.slot) + ' — ' + about(s), fn: () => slot(s) })).concat([['Back', () => sh.back()]]) });\\n    const ask = (title, text, label, fn) => sh.show('confirm', { kicker: 'Save', title, text, actions: [{ label: 'Keep it', fn: () => sh.back() }, { label, fn: () => { sh.back(); fn(); } }] });\\n    const saved = () => { sh.toast('Saved', name(this._last)); if (done) done(this.get(this._last)); };\\n    const slot = s => {\\n      const acts = [];\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js\",\"offset\":3870,\"limit\":90,\"raw_output\":\" *      game.saves.save(0); game.saves.load(0); game.saves.copy(0, 1); game.saves.erase(1); game.saves.autosave();\\n *      game.saves.list()   // the slots, autosave first: [{ slot: 'auto' | 0 | 1 | 2, empty, place, level, time, at, damaged, newer }]\\n *    new E.Game({ menu: { saves: true } }) puts Save (while saves.canSave: a JRPG sets it at a save point) and Load in\\n *    the pause menu, each opening the standard screen (the slots with their place, level and time; save, load, copy and\\n *    erase, asking before a save is lost); game.saves.show('save' | 'load') opens it from a game's own menu or title.\\n *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\\n * ============================================================================= */\\nconst SAVE_FORMAT = 1;   // the record's own shape: {