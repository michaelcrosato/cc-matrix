k/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"matches\":[{\"line_number\":46,\"content\":\"    if (kind === 'rep') {\"},{\"line_number\":48,\"content\":\"      const bead = fam.bead, vel = fam.beadVel;\"},{\"line_number\":50,\"content\":\"      const target = clamp(bead + lead * sign, -0.05, 1.15);\"},{\"line_number\":76,\"content\":\"    } else if (kind === 'tray') {\"},{\"line_number\":79,\"content\":\"    } else if (kind === 'laundry') {\"},{\"line_number\":106,\"content\":\"  function beadOf(t, tier) {\"},{\"line_number\":141,\"content\":\"      fam.err = 0; fam.samples = 0; fam.form = 0;\"},{\"line_number\":142,\"content\":\"      fam.bead = 0; fam.prevBead = 0; fam.beadVel = 0; fam.side = 1;\"},{\"line_number\":300,\"content\":\"  function stepRep(sess, dt) {\"},{\"line_number\":302,\"content\":\"    const prev = fam.bead;\"},{\"line_number\":303,\"content\":\"    fam.bead = beadOf(fam.t, sess.tier);\"},{\"line_number\":304,\"content\":\"    fam.beadVel = (fam.bead - prev) / dt;\"},{\"line_number\":315,\"content\":\"    fam.err += Math.abs(depth - fam.bead);\"},{\"line_number\":316,\"content\":\"    fam.form += fam.axis === 'x' ? Math.abs(bal.py) : Math.abs(bal.px);\"},{\"line_number\":330,\"content\":\"    const form = fam.form / Math.max(1, bal.frames);\"},{\"line_number\":331,\"content\":\"    const pen = clamp(form * 0.45, 0, 0.3);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"97dc7f17-54f4-4f5e-bc84-5ab67d8ba3bf"}
