int += dt; else fam.sprint = 0;\\n    if (fam.sprint > 2 && fam.stitch <= 0) fam.stitch = 3;\\n    if (fam.stitch > 0) fam.stitch -= dt;\\n    const speed = (G.dev && G.dev.on ? G.dev.v.jogSpeed : 1) * (zoned ? 8 : 3);\\n    fam.z += speed * dt;\\n    fam.x += (seat.ux || 0) * 1.6 * dt;\\n    const cups = [12, 28, 44, 58];\\n    for (let i = 0; i < cups.length; i++) {\\n      if (fam.gotCup && fam.gotCup[i]) continue;\\n      if (fam.z >= cups[i] && fam.z - speed * dt < cups[i]) {\\n        const cx = (i % 2 ? 0.8 : -0.8);\\n        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\\n      }\\n    }\\n    fam.nextCup = null;\\n    for (let i = 0; i < cups.length; i++) if (!(fam.gotCup && fam.gotCup[i]) && fam.z < cups[i]) { fam.nextCup = { x: (i % 2 ? 0.8 : -0.8), z: cups[i] }; break; }\\n    const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n  }\\n\\n  function stepSlalom(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (fam.done) return;\\n    if (fam.tumble > 0) { fam.tumble -= dt; return; }\\n    const base = G.dev && G.dev.on ? G.dev.v.skiSpeed : 220;\\n    const turn = G.dev && G.dev.on ? G.dev.v.skiTurn : 1.6;\\n    let spd = base;\\n    if (seat.uy > 0.3) spd *= 1.35;\\n    if (seat.uy < -0.3) spd *= 0.6;\\n    fam.z += spd * dt;\\n    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\\n    const gates = G.GATES;\\n    for (let i = 0; i < gates.length; i++) {\\n      const g = gates[i];\\n      if (fam.missed[i]) continue;\\n      if (fam.z >= g.z && fam.z - spd * dt < g.z) {\\n        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\\n        if (fam.missed[i]) fam.pen += 3;\\n      }\\n    }\\n    for (let i = 0; i < G.OBSTACLES.length; i++) {\\n      const o = G.OBSTACLES[i];\\n      if (fam.hitO && fam.hitO[i]) continue;\\n      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\\n        fam.hitO = fam.hitO || {}; fam.hitO[i] = true; fam.tumble = 1.2; fam.pen += 1.2;\\n      }\\n    }\\n    let next = null;\\n    for (let i = 0; i < gates.length; i++) if (gates[i].z > fam.z - 20) { next = gates[i]; break; }\\n    fam.nextGate = next;\\n    if (fam.z >= fam.finish) {\\n      fam.done = true;\\n      const par = 58, worst = 90;\\n      const time = fam.t + fam.pen;\\n      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function stepTray(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (!seat.bal) {\\n      seat.bal = new G.Balance({ k: 14, c: 8, s: 1, A: 0.5, nf: 0.8, R: 0.4, push: null }, sess.seed, {});\\n    }\\n    const sk = skillName(seat);\\n    if (sk) {\\n      const aim = sk === 'poor' ? 0.25 : sk === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    }\\n    seat.bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const Gv = G.dev && G.dev.on ? G.dev.v.trayG : 420;\\n    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\\n    if (fam.world) {\\n      if (G.dev && G.dev.on && fam.world.bodies) {\\n        const mu = 0.04 * fr;\\n        fam.world.bodies.forEach(function (b) { if (b && b._olive) b.friction = mu; });\\n      }\\n      if (fam.gecko) fam.gecko.moveTo(78, 100 + Math.sin(fam.t * 0.55) * 36, 0, 22, 0);\\n      fam.world.gravity = [seat.bal.px * Gv, -seat.bal.py * Gv];\\n      fam.world.wake();\\n      fam.world.step(dt);\\n      const spec = G.TRAYS[fam.trayI];\\n      const need = spec ? spec.olives.length : 0;\\n      const gotHere = fam.got - fam.trayGot0;\\n      if (gotHere >= need) {\\n        fam.trayI++;\\n        if (fam.trayI >= G.TRAYS.length) { fam.world = null; sess.ended = true; }\\n        else loadTray(sess);\\n      }\\n    } else if (fam.trayI >= G.TRAYS.length) sess.ended = true;\\n    const share = sess.limit > 0 ? clamp((sess.limit - fam.t) / sess.limit, 0, 1) : 0;\\n    const base = fam.total ? fam.got / fam.total : 0;\\n    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\\n    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\\n  }\\n\\n  function stepLaundry(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    const skill = skillName(seat);\\n    if (skill) seat.effort = EFFORT[skill] || 0.5;\\n    arm(bal, skill);\\n    const effort = clamp(seat.local && !skill ? leanFor(seat).effort : seat.effort, 0, 1);\\n    const spd = effort * 2.2;\\n    if (!fam.rope) fam.rope = Object.assign({}, bal.set);\\n    /* Faster walking sways the rope. The set on the balance is a copy, so the band table stays put.\\n       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\\n    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\\n    bal.set = Object.assign({}, fam.rope, { s: baseS + effort * 4 });\\n    fam.air -= dt;\\n    const pins = [8, 19, 30, 41, 50];\\n    let ahead = null;\\n    for (let i = 0; i < pins.length; i++) {\\n      const d = pins[i] - fam.x;\\n      if (d > 0.04) { ahead = { dist: d, x: pins[i] }; break; }\\n    }\\n    fam.pinAhead = ahead;\\n    /* One jump per pin, long enough to land past it. Air freezes the plate, not the walker. */\\n    if (seat.jump && fam.air <= 0 && ahead && fam.cleared !== ahead.x && ahead.dist < 0.95) {\\n      fam.air = Math.min(0.85, ahead.dist / Math.max(0.45, spd) + 0.12);\\n      fam.cleared = ahead.x;\\n    }\\n    bal.holdP = fam.air > 0;\\n\",\"total_lines\":905}}","is_error":false},{"type":"tool_result","tool_use_id":"call-ee481268-37ee-41a1-b6d5-e060f11575c8-77","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"180→      if (key === 'timeScale' && G.game) G.game.timeScale = this.v.timeScale;\\n    },\\n    reset() {\\n      this.v = copyDev(G.DEV_DEFAULTS);\\n      if (G.game) G.game.timeScale = 1;\\n    },\\n    jump(o) {\\n      o = o || {};\\n      if (!G.game) return;\\n      if (o.day) { G.profile.day = o.day; G.profile.sessions = 0; }\\n190→      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\\n      else if (o.scene) G.game.go(o.scene, o.data || {}, { fade: 0 });\\n    },\\n    jumpMode: false, jumpRow: 0, jumpDay: 1, jumpSceneI: 0, jumpActI: 0, jumpTier: 1,\\n    jumpScenes: ['bungalow', 'island', 'title', 'plate', 'bed', 'ending'],\\n    jumpActs: ['', 'stork', 'candle', 'squat', 'step', 'hoop', 'sun', 'push', 'lunge', 'jog', 'slalom', 'tray', 'laundry']\\n  };\\n  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot', 'Jump'];\\n  G.dev.tools = TOOLS;\\n  G.dev.clipNames = function () {\\n200→    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n210→    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 100;\\n220→    const key = String(name).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'pose';\\n    const row = key + \\\": { clip: '\\\" + name + \\\"', a: \\\" + t.toFixed(2) + \\\", b: \\\" + Math.max(b, t).toFixed(2) + \\\", tgt: 1.57 },\\\";\\n    this.printed = row;\\n    try { console.log(row); } catch (e) { /* the row is also on the panel */ }\\n    return row;\\n  };\\n  function eat(input, action) { try { input.suppress(action); } catch (e) { /* already used */ } }\\n  G.dev.update = function (input, dt) {\\n    if (!this.panel) return;\\n    const keys = this.keys;\\n230→    if (input.pressed('cancel')) {\\n      eat(input, 'cancel');\\n      if (this.poseMode) { this.poseMode = false; return; }\\n      if (this.jumpMode) { this.jumpMode = false; return; }\\n      this.close();\\n      return;\\n    }\\n    if (this.poseMode) {\\n      const names = this.clipNames();\\n      const n = names.length || 1;\\n240→      if (input.pressed('up')) { this.poseI = (this.poseI + n - 1) % n; this.poseT = 0; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.poseI = (this.poseI + 1) % n; this.poseT = 0; eat(input, 'down'); }\\n      const dur = (this.currentClip() && this.currentClip().dur) || 2;\\n      if (input.pressed('left') || input.repeat('left')) { this.poseT = Math.max(0, this.poseT - 0.05); eat(input, 'left'); }\\n      if (input.pressed('right') || input.repeat('right')) { this.poseT = Math.min(dur, this.poseT + 0.05); eat(input, 'right'); }\\n      if (input.pressed('confirm')) { this.printPose(); eat(input, 'confirm'); }\\n      void dt;\\n      return;\\n    }\\n    if (this.jumpMode) {\\n250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (input.repeat && (input.pressed('up') && (input.held.has('ArrowUp') || input.lastDevice === 'gamepad'))) this.i = (this.i + keys.length - 1) % keys.length;\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n280→    const k = keys[this.i];\\n    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n290→    else if (i === 1 && G.finishNow) G.finishNow(1);\\n    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n300→    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\",\"content_concise\":\"180→      if (key === 'timeScale' && G.game) G.game.timeScale = this.v.timeScale;\\n    },\\n    reset() {\\n      this.v = copyDev(G.DEV_DEFAULTS);\\n      if (G.game) G.game.timeScale = 1;\\n    },\\n    jump(o) {\\n      o = o || {};\\n      if (!G.game) return;\\n      if (o.day) { G.profile.day = o.day; G.profile.sessions = 0; }\\n190→      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\\n      else if (o.scene) G.game.go(o.scene, o.data || {}, { fade: 0 });\\n    },\\n    jumpMode: false, jumpRow: 0, jumpDay: 1, jumpSceneI: 0, jumpActI: 0, jumpTier: 1,\\n    jumpScenes: ['bungalow', 'island', 'title', 'plate', 'bed', 'ending'],\\n    jumpActs: ['', 'stork', 'candle', 'squat', 'step',