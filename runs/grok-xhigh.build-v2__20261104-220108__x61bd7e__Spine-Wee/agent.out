cale; }\"},{\"line_number\":210,\"content\":\"  G.dev.draw = function (r) {\"},{\"line_number\":223,\"content\":\"        const def = G.DEV_DEFAULTS[k];\"},{\"line_number\":228,\"content\":\"      text(g, TOOLS[self.tool] || '', 8, r.H - 16, '#14a8c8', 1);\"},{\"line_number\":233,\"content\":\"    const g0 = G.dev && G.dev.on ? G.dev.v.star1 : gates[0];\"},{\"line_number\":234,\"content\":\"    const g1 = G.dev && G.dev.on ? G.dev.v.star2 : gates[1];\"},{\"line_number\":235,\"content\":\"    const g2 = G.dev && G.dev.on ? G.dev.v.star3 : gates[2];\"},{\"line_number\":236,\"content\":\"    const use = G.dev && G.dev.on ? [g0, g1, g2] : gates;\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-23238cd2-d2a6-4f8d-a85d-210a080eeee5-54","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/* Boot: the game, the shell, the lean, saves, and the hub session. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function approach(cur, target, rate, dt) {\\n    const d = target - cur, m = rate * dt;\\n10→    if (Math.abs(d) <= m) return target;\\n    return cur + (d < 0 ? -m : m);\\n  }\\n\\n  function hashScene() {\\n    let hash = '';\\n    try { hash = (typeof location !== 'undefined' && location && location.hash) || ''; } catch (e) { hash = ''; }\\n    return hash;\\n  }\\n\\n20→  function topIdle(game) {\\n    const n = game.sceneName;\\n    if (G.attracting || G.inSession) return false;\\n    if (n === 'title' || n === 'slots' || n === 'about') return true;\\n    if (n === 'class' && !G.session) return true;\\n    return false;\\n  }\\n\\n  function readLean(game, dt) {\\n    const I = game.input;\\n30→    const lean = G.lean;\\n    const panel = !!(G.dev && G.dev.panel);\\n    let key = false;\\n    const held = I.held;\\n    if (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown')) {\\n      G._keyAt = I.clock;\\n      key = true;\\n    }\\n    const pad = I.padMove || [0, 0];\\n40→    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = I.pointer();\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n      const len = Math.hypot(ux, uy) || 1;\\n50→      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n60→    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n        if (I.down('right')) kx += 1;\\n70→        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n80→        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n      void key;\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (mode === 'toggle') {\\n      if (I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    }\\n90→    let target = 0;\\n    if (mode === 'toggle') target = G._breathLatch ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n100→    lean.jump = !!I.pressed('jump');\",\"content_concise\":\"1→/* Boot: the game, the shell, the lean, saves, and the hub session. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function approach(cur, target, rate, dt) {\\n    const d = target - cur, m = rate * dt;\\n10→    if (Math.abs(d) <= m) return target;\\n    return cur + (d < 0 ? -m : m);\\n  }\\n\\n  function hashScene() {\\n    let hash = '';\\n    try { hash = (typeof location !== 'undefined' && location && location.hash) || ''; } catch (e) { hash = ''; }\\n    return hash;\\n  }\\n\\n20→  function topIdle(game) {\\n    const n = game.sceneName;\\n    if (G.attracting || G.inSession) return false;\\n    if (n === 'title' || n === 'slots' || n === 'about') return true;\\n    if (n === 'class' && !G.session) return true;\\n    return false;\\n  }\\n\\n  function readLean(game, dt) {\\n    const I = game.input;\\n30→    const lean = G.lean;\\n    const panel = !!(G.dev && G.dev.panel);\\n    let key = false;\\n    const held = I.held;\\n    if (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown')) {\\n      G._keyAt = I.clock;\\n      key = true;\\n    }\\n    const pad = I.padMove || [0, 0];\\n40→    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = I.pointer();\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n      const len = Math.hypot(ux, uy) || 1;\\n50→      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n60→    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n        if (I.down('right')) kx += 1;\\n70→        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n80→        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n      void key;\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (mode === 'toggle') {\\n      if (I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    }\\n90→    let target = 0;\\n    if (mode === 'toggle') target = G._breathLatch ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n100→    lean.jump = !!I.pressed('jump');\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/boot.js\",\"offset\":1,\"limit\":100,\"raw_output\":\"/* Boot: the game, the shell, the lean, saves, and the hub session. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function approach(cur, target, rate, dt) {\\n    const d = target - cur, m = rate * dt;\\n    if (Math.abs(d) <= m) return target;\\n    return cur + (d < 0 ? -m : m);\\n  }\\n\\n  function hashScene() {\\n    let hash = '';\\n    try { hash = (typeof location !== 'undefined' && location && location.hash) || ''; } catch (e) { hash = ''; }\\n    return hash;\\n  }\\n\\n  function topIdle(game) {\\n    const n = game.sceneName;\\n    if (G.attracting || G.inSession) return false;\\n    if (n === 'title' || n === 'slots' || n === 'about') return true;\\n    if (n === 'class' && !G.session) return true;\\n    return false;\\n  }\\n\\n  function readLean(game, dt) {\\n    const I = game.input;\\n    const lean = G.lean;\\n    const panel = !!(G.dev && G.dev.panel);\\n    let key = false;\\n    const held = I.held;\\n    if (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown')) {\\n      G._keyAt = I.clock;\\n      key = true;\\n    }\\n    const pad = I.padMove || [0, 0];\\n    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = I.pointer();\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n        if (I.down('right')) kx += 1;\\n        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n      void key;\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (mode === 'toggle') {\\n      if (I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    }\\n    let target = 0;\\n    if (mode === 'toggle') target = G._breathLatch ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n    lean.jump = !!I.pressed('jump');\\n\",\"total_lines\":325}}","is_error":false},{"type":"tool_result","tool_use_id":"call-23238cd2-d2a6-4f8d-a85d-210a080eeee5-55","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>AI Hub Session Harness</title>\\n<meta name=\\\"description\\\" content=\\\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\\\">\\n<style>\\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\\n10→  * { box-sizing: border-box; }\\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\\n  body { display: grid; grid-template-rows: auto 1fr; }\\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\\n  input[type=number] { width: 70px; }\\n  input.game { width: 300px; }\\n  button { cursor: pointer; }\\n20→  button:hover { border-color: var(--dim); }\\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\\n  .cell__state { margin-left: auto; color: var(--dim); }\\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\\n  .cell.is-out { opacity: .35; }\\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\\n30→  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\\n  #checks li { list-style: none; }\\n  #checks ul { margin: 0; padding: 0; }\\n  .ok::before { content: '✓ '; color: var(--ok); }\\n  .bad::before { content: '✗ '; color: var(--bad); }\\n  .wait::before { content: '… '; color: var(--warn); }\\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\\n  #round { white-space: pre-wrap; font-size: 13px; }\\n  .hint { color: var(--dim); }\\n40→</style>\\n</head>\\n<body>\\n<header>\\n  <h1>AI Hub session harness</h1>\\n  <label>Game <input class=\\\"game\\\" id=\\\"game\\\" placeholder=\\\"mygame.html or /games/mygame/index.html\\\"></label>\\n  <label>Players <select id=\\\"players\\\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\\n  <label>Latency <input type=\\\"number\\\" id=\\\"latency\\\" min=\\\"0\\\" value=\\\"60\\\"> ms</label>\\n  <label>Jitter <input type=\\\"number\\\" id=\\\"jitter\\\" min=\\\"0\\\" value=\\\"20\\\"> ms</label>\\n  <label>Loss <input type=\\\"number\\\" id=\\\"loss\\\" min=\\\"0\\\" max=\\\"50\\\" value=\\\"0\\\"> %</label>\\n50→  <button id=\\\"restart\\\" type=\\\"button\\\">New round</button>\\n  <button id=\\\"release\\\" type=\\\"button\\\" title=\\\"End the splash now: the round starts once every game has loaded\\\">Start now</button>\\n  <button id=\\\"timeup\\\" type=\\\"button\\\">Time up</button>\\n  <label>Remove <select id=\\\"who\\\"></select></label>\\n  <button id=\\\"remove\\\" type=\\\"button\\\">Remove player</button>\\n  <button id=\\\"hide\\\" type=\\\"button\\\" aria-pressed=\\\"false\\\">Hide host tab</button>\\n</header>\\n<main>\\n  <div id=\\\"grid\\\"><p class=\\\"hint\\\" style=\\\"padding:16px\\\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\\n  <aside>\\n60→    <section><h2>Round</h2><div id=\\\"round\\\" class=\\\"hint\\\">No round yet.</div></section>\\n    <section id=\\\"checks\\\"><h2>Conformance</h2><ul id=\\\"checklist\\\"><li class=\\\"hint\\\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\\n    <pre id=\\\"log\\\" aria-live=\\\"off\\\"></pre>\\n  </aside>\\n</main>\\n<script type=\\\"module\\\">\\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\\n\\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\\n70→const params = new URLSearchParams(location.search);\\nconst $ = (id) => document.getElementById(id);\\nconst auto = params.get('auto') === '1';\\nconst scenario = params.get('scenario') || 'standard';\\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\\nconst serverMode = scenario === 'server';\\nconst playMs = Number(params.get('play')) || 6000;\\nconst SPLASH_MS = 10_000;\\n\\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\\n80→  if (params.has(key)) $(id).value = params.get(key);\",\"content_concise\":\"1→<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>AI Hub Session Harness</title>\\n<meta name=\\\"description\\\" content=\\\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\\\">\\n<style>\\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\\n10→  * { box-sizing: border-box; }\\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\\n  body { display: grid; grid-template-rows: auto 1fr; }\\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\\n  input[type=number] { width: 70px; }\\n  input.game { width: 300px; }\\n  button { cursor: pointer; }\\n20→  button:hover { border-color: var(--dim); }\\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\\n  .cell__state { margin-left: auto; color: var(--dim); }\\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\\n  .cell.is-out { opacity: .35; }\\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\\n30→  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\\n  #checks li { list-style: none; }\\n  #checks ul { margin: 0; padding: 0; }\\n  .ok::before { content: '✓ '; color: var(--ok); }\\n  .bad::before { content: '✗ '; color: var(--bad); }\\n  .wait::before { content: '… '; color: var(--warn); }\\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\\n  #round { white-space: pre-wrap; font-size: 13px; }\\n  .hint { color: var(--dim); }\\n40→</style>\\n</head>\\n<body>\\n<header>\\n  <h1>AI Hub session harness</h1>\\n  <label>Game <input class=\\\"game\\\" id=\\\"game\\\" placeholder=\\\"mygame.html or /games/mygame/index.html\\\"></label>\\n  <label>Players <select id=\\\"players\\\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\\n  <label>Latency <input type=\\\"number\\\" id=\\\"latency\\\" min=\\\"0\\\" value=\\\"60\\\"> ms</label>\\n  <label>Jitter <input type=\\\"number\\\" id=\\\"jitter\\\" min=\\\"0\\\" value=\\\"20\\\"> ms</label>\