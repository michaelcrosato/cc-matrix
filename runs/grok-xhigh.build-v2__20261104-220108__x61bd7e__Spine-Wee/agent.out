ut.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n290→    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n300→    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n    try {\\n310→      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n    if (!this.panel || !r) return;\\n320→    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n        const on = start + n === self.i;\",\"content_concise\":\"250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n    const k = keys[this.i];\\n280→    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n290→    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n300→    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n    try {\\n310→      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n    if (!this.panel || !r) return;\\n320→    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n        const on = start + n === self.i;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/ui.js\",\"offset\":250,\"limit\":80,\"raw_output\":\"      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n    const k = keys[this.i];\\n    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n    try {\\n      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n    if (!this.panel || !r) return;\\n    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n        const on = start + n === self.i;\\n\",\"total_lines\":368}}","is_error":false},{"type":"tool_result","tool_use_id":"call-7fb28584-f4ca-430b-9a9d-64780b19d02e-4","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"280→  game2.saves._put(0, '{not json');\\n  const damaged = game2.saves.get(0);\\n  assert(damaged && damaged.damaged, 'not damaged');\\n  assert(game2.saves.load(0) === null, 'damaged load');\\n  const before = game2.errors.length;\\n  game2.go('slots', {}, { fade: 0 });\\n  game2.advance(1 / 120);\\n  game2.input.tap('confirm');\\n  game2.advance(1 / 120);\\n  assert(game2.errors.length === before, game2.errors.join(' | '));\\n290→});\\n\\nadd('rules', 'determinism', () => {\\n  const a = G.hashRun(1);\\n  const b = G.hashRun(1);\\n  const c = G.hashRun(2);\\n  assert(a === b, 'same seed drifted ' + a + ' ' + b);\\n  assert(a !== c, 'different seeds matched');\\n});\\n\\n300→add('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(game.time < 10, 'time ' + game.time);\\n  let guard = 0;\\n310→  while (game.time < 10 && guard++ < 40) game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.attract, 'not attract at ' + game.time + ' idle ' + G.idleSteps);\\n  assert(game.time >= 9.999, 'early ' + game.time);\\n  game.advance(0.4);\\n  assert(G.profile.minutes === minutes, 'attract awarded minutes');\\n  assert(G.profile.unlocks.join() === unlocks.join(), 'attract unlocked');\\n  assert(JSON.stringify(game.saves._mem) === memBefore, 'attract wrote a save');\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n320→  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const rowStep = function (code) {\\n    const beforeI = G.dev.i;\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n340→    const n = G.dev.keys.length;\\n    const moved = (beforeI - G.dev.i + n) % n;\\n    assert(moved === 1, code + ' rows ' + beforeI + ' -> ' + G.dev.i);\\n  };\\n  rowStep('ArrowUp');\\n  rowStep('Pad12');\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n350→  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.i === 0, 'slider not home ' + G.dev.i);\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n360→  game.advance(1 / 120);\\n  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n370→  game.advance(1 / 120);\\n  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n380→  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n390→    const want = G.dev.keys.indexOf(key);\\n    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n400→  tapCode('ArrowRight');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n410→  const botAt = G.dev.tools.indexOf('Bot: good');\\n  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n420→  const offAt = G.dev.tools.indexOf('Bot: off');\\n  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\",\"content_concise\":\"280→  game2.saves._put(0, '{not json');\\n  const damaged = game2.saves.get(0);\\n  assert(damaged && damaged.damaged, 'not damaged');\\n  assert(game2.saves.load(0) === null, 'damaged load');\\n  const before = game2.errors.length;\\n  game2.go('slots', {}, { fade: 0 });\\n  game2.advance(1 / 120);\\n  game2.input.tap('confirm');\\n  game2.advance(1 / 120);\\n  assert(game2.errors.length === before, game2.errors.join(' | '));\\n290→});\\n\\nadd('rules', 'determinism', () => {\\n  const a = G.hashRun(1);\\n  const b = G.hashRun(1);\\n  const c = G.hashRun(2);\\n  assert(a === b, 'same seed drifted ' + a + ' ' + b);\\n  assert(a !== c, 'different seeds matched');\\n});\\n\\n300→add('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(game.time < 10, 'time ' + game.time);\\n  let guard = 0;\\n310→  while (game.time < 10 && guard++ < 40) game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.attract, 'not attract at ' + game.time + ' idle ' + G.idleSteps);\\n  assert(game.time >= 9.999, 'early ' + game.time);\\n  game.advance(0.4);\\n  assert(G.profile.minutes === minutes, 'attract awarded minutes');\\n  assert(G.profile.unlocks.join() === unlocks.join(), 'attract unlocked');\\n  assert(JSON.stringify(game.saves._mem) === memBefore, 'attract wrote a save');\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n320→  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const rowStep = function (code) {\\n    const beforeI = G.dev.i;\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n340→    const n = G.dev.keys.length;\\n    const moved = (beforeI - G.dev.i + n) % n;\\n    assert(moved === 1, code + ' rows ' + beforeI + ' -> ' + G.dev.i);\\n  };\\n  rowStep('ArrowUp');\\n  rowStep('Pad12');\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n350→  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.i === 0, 'slider not home ' + G.dev.i);\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n360→  game.advance(1 / 120);\\n  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n370→  game.advance(1 / 120);\\n  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n380→  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n390→    const want = G.dev.keys.indexOf(key);\\n    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n400→  tapCode('ArrowRight');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n410→  const botAt = G.dev.tools.indexOf('Bot: good');\\n  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n420→  const offAt = G.dev.tools.indexOf('Bot: off');\\n  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs\",\"offset\":280,\"limit\":150,\"raw_output\":\"  game2.saves._put(0, '{not json');\\n  const damaged = game2.saves.get(0);\\n  assert(damaged && damaged.damaged, 'not damaged');\\n  assert(game2.saves.load(0) === null, 'damaged load');\\n  const before = game2.errors.length;\\n  game2.go('slots', {}, { fade: 0 });\\n  game2.advance(1 / 120);\\n  game2.input.tap('confirm');\\n  game2.advance(1 / 120);\\n  assert(game2.errors.length === before, game2.errors.join(' | '));\\n});\\n\\nadd('rules', 'determinism', () => {\\n  const a = G.hashRun(1);\\n  const b = G.hashRun(1);\\n  const c = G.hashRun(2);\\n  assert(a === b, 'same seed drifted ' + a + ' ' + b);\\n  assert(a !== c, 'different seeds matched');\\n});\\n\\nadd('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(game.time < 10, 'time ' + game.time);\\n  let guard = 0;\\n  while (game.time < 10 && guard++ < 40) game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.attract, 'not attract at ' + game.time + ' idle ' + G.idleSteps);\\n  assert(game.time >= 9.999, 'early ' + game.time);\\n  game.advance(0.4);\\n  assert(G.profile.minutes === minutes, 'attract awarded minutes');\\n  assert(G.profile.unlocks.join() === unlocks.join(), 'attract unlocked');\\n  assert(JSON.stringify(game.saves._mem) === memBefore, 'attract wrote a save');