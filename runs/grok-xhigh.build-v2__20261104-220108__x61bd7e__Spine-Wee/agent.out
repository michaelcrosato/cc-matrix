{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-0af2fa0c-4fe1-4e33-b32e-559b29abc563-72","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"28→  function freshLean() {\\n    return { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\\n30→  }\\n\\n  /* One player's lean. The first player keeps the mouse, the dev-panel key filter, and the shared breath latch. */\\n  function readOne(game, I, lean, dt, primary) {\\n    const panel = primary && !!(G.dev && G.dev.panel);\\n    const held = I.held;\\n    if (primary && (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown'))) {\\n      G._keyAt = I.clock;\\n    }\\n40→    const pad = I.padMove || [0, 0];\\n    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = primary ? I.pointer() : null;\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = primary && !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n50→      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n60→      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n70→        if (I.down('right')) kx += 1;\\n        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n80→        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (primary) {\\n      if (mode === 'toggle' && I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    } else if (mode === 'toggle' && I.pressed('breath')) lean._latch = !lean._latch;\\n90→    let target = 0;\\n    if (mode === 'toggle') target = (primary ? G._breathLatch : lean._latch) ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n100→    lean.jump = !!I.pressed('jump');\\n    lean.catchL = !!I.pressed('catchL');\\n    lean.catchR = !!I.pressed('catchR');\\n    lean.paceL = !!I.down('paceL');\\n    lean.paceR = !!I.down('paceR');\\n\\n    if (primary) {\\n      const cv = game.screen && game.screen.canvas;\\n      if (cv && cv.style) {\\n        const hide = lean.source === 'mouse' && (game.sceneName === 'play' || game.sceneName === 'duel' || game.sceneName === 'attract');\\n110→        cv.style.cursor = hide ? 'none' : '';\\n      }\\n    }\\n  }\\n\\n  function readLean(game, dt) {\\n    const players = (game.players && game.players.length) ? game.players : [game.input];\\n    if (!G.leans || G.leans[0] !== G.lean) G.leans = [G.lean];\\n    while (G.leans.length < players.length) G.leans.push(freshLean());\\n    if (G.leans.length > players.length) G.leans.length = players.length;\\n120→    readOne(game, players[0], G.lean, dt, true);\\n    for (let i = 1; i < players.length; i++) readOne(game, players[i], G.leans[i], dt, false);\\n  }\\n\\n  function installShellCss() {\\n    if (typeof document === 'undefined') return;\\n    if (!document.getElementById('spine-shell-css')) {\\n      const st = document.createElement('style');\\n      st.id = 'spine-shell-css';\\n      st.textContent = '@media (min-height:700px){.esh-mod{zoom:1.5}}@media (min-height:1000px){.esh-mod{zoom:2}}.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}';\\n130→      document.head.appendChild(st);\\n    }\\n    if (!G._hoverFocus) {\\n      G._hoverFocus = true;\\n      document.addEventListener('pointerover', function (e) {\\n        const b = e.target && e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\\n        if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true });\\n      });\\n    }\\n  }\\n140→\\n  function saveWrite() {\\n    if (G.attracting || G.inSession) return;\\n    const p = JSON.parse(JSON.stringify(G.profile));\\n    return { data: p, place: 'Day ' + p.day + '  ' + p.name, level: p.day };\\n  }\\n  function saveRead(save) {\\n    const d = (save && save.data) || {};\",\"content_concise\":\"28→  function freshLean() {\\n    return { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\\n30→  }\\n\\n  /* One player's lean. The first player keeps the mouse, the dev-panel key filter, and the shared breath latch. */\\n  function readOne(game, I, lean, dt, primary) {\\n    const panel = primary && !!(G.dev && G.dev.panel);\\n    const held = I.held;\\n    if (primary && (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown'))) {\\n      G._keyAt = I.clock;\\n    }\\n40→    const pad = I.padMove || [0, 0];\\n    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = primary ? I.pointer() : null;\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = primary && !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n50→      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n60→      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n70→        if (I.down('right')) kx += 1;\\n        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n80→        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (primary) {\\n      if (mode === 'toggle' && I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    } else if (mode === 'toggle' && I.pressed('breath')) lean._latch = !lean._latch;\\n90→    let target = 0;\\n    if (mode === 'toggle') target = (primary ? G._breathLatch : lean._latch) ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n100→    lean.jump = !!I.pressed('jump');\\n    lean.catchL = !!I.pressed('catchL');\\n    lean.catchR = !!I.pressed('catchR');\\n    lean.paceL = !!I.down('paceL');\\n    lean.paceR = !!I.down('paceR');\\n\\n    if (primary) {\\n      const cv = game.screen && game.screen.canvas;\\n      if (cv && cv.style) {\\n        const hide = lean.source === 'mouse' && (game.sceneName === 'play' || game.sceneName === 'duel' || game.sceneName === 'attract');\\n110→        cv.style.cursor = hide ? 'none' : '';\\n      }\\n    }\\n  }\\n\\n  function readLean(game, dt) {\\n    const players = (game.players && game.players.length) ? game.players : [game.input];\\n    if (!G.leans || G.leans[0] !== G.lean) G.leans = [G.lean];\\n    while (G.leans.length < players.length) G.leans.push(freshLean());\\n    if (G.leans.length > players.length) G.leans.length = players.length;\\n120→    readOne(game, players[0], G.lean, dt, true);\\n    for (let i = 1; i < players.length; i++) readOne(game, players[i], G.leans[i], dt, false);\\n  }\\n\\n  function installShellCss() {\\n    if (typeof document === 'undefined') return;\\n    if (!document.getElementById('spine-shell-css')) {\\n      const st = document.createElement('style');\\n      st.id = 'spine-shell-css';\\n      st.textContent = '@media (min-height:700px){.esh-mod{zoom:1.5}}@media (min-height:1000px){.esh-mod{zoom:2}}.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}';\\n130→      document.head.appendChild(st);\\n    }\\n    if (!G._hoverFocus) {\\n      G._hoverFocus = true;\\n      document.addEventListener('pointerover', function (e) {\\n        const b = e.target && e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\\n        if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true });\\n      });\\n    }\\n  }\\n140→\\n  function saveWrite() {\\n    if (G.attracting || G.inSession) return;\\n    const p = JSON.parse(JSON.stringify(G.profile));\\n    return { data: p, place: 'Day ' + p.day + '  ' + p.name, level: p.day };\\n  }\\n  function saveRead(save) {\\n    const d = (save && save.data) || {};\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/boot.js\",\"offset\":28,\"limit\":120,\"raw_output\":\"  function freshLean() {\\n    return { ux: 0, uy: 0, breath: 0, effort: 0, source: 'keys', jump: false, catchL: false, catchR: false, paceL: false, paceR: false };\\n  }\\n\\n  /* One player's lean. The first player keeps the mouse, the dev-panel key filter, and the shared breath latch. */\\n  function readOne(game, I, lean, dt, primary) {\\n    const panel = primary && !!(G.dev && G.dev.panel);\\n    const held = I.held;\\n    if (primary && (held.has('KeyA') || held.has('KeyD') || held.has('KeyW') || held.has('KeyS') ||\\n        held.has('ArrowLeft') || held.has('ArrowRight') || held.has('ArrowUp') || held.has('ArrowDown'))) {\\n      G._keyAt = I.clock;\\n    }\\n    const pad = I.padMove || [0, 0];\\n    const padMag = Math.hypot(pad[0], pad[1]);\\n    const p = primary ? I.pointer() : null;\\n    const W = (game.screen && game.screen.W) || 320;\\n    const H = (game.screen && game.screen.H) || 240;\\n    const overPanel = panel && p && p[0] < W / 3;\\n    const mouseOn = primary && !!(I.mouse && I.mouse.active && p && I.mouse.t >= (G._keyAt || 0) && !overPanel);\\n\\n    if (padMag > 0.12) {\\n      let ux = pad[0], uy = -pad[1];\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'pad';\\n    } else if (mouseOn) {\\n      const reach = (G.dev && G.dev.v && G.dev.v.reach) || 0.33;\\n      const denom = Math.max(1, H * reach);\\n      let ux = (p[0] - W / 2) / denom;\\n      let uy = -(p[1] - H / 2) / denom;\\n      const len = Math.hypot(ux, uy) || 1;\\n      if (len > 1) { ux /= len; uy /= len; }\\n      lean.ux = ux; lean.uy = uy; lean.source = 'mouse';\\n    } else {\\n      let kx = 0, ky = 0;\\n      if (panel) {\\n        if (held.has('KeyA')) kx -= 1;\\n        if (held.has('KeyD')) kx += 1;\\n        if (held.has('KeyW')) ky += 1;\\n        if (held.has('KeyS')) ky -= 1;\\n      } else {\\n        if (I.down('left')) kx -= 1;\\n        if (I.down('right')) kx += 1;\\n        if (I.down('up')) ky += 1;\\n        if (I.down('down')) ky -= 1;\\n      }\\n      const nudge = (G.dev && G.dev.v && G.dev.v.nudge) || 2.2;\\n      if (kx || ky) {\\n        const len = Math.hypot(kx, ky) || 1;\\n        lean.ux = approach(lean.ux, kx / len, nudge, dt);\\n        lean.uy = approach(lean.uy, ky / len, nudge, dt);\\n      } else if (lean.source !== 'mouse') {\\n        lean.ux = approach(lean.ux, 0, 0.5, dt);\\n        lean.uy = approach(lean.uy, 0, 0.5, dt);\\n      }\\n      lean.source = 'keys';\\n    }\\n\\n    const mode = (game.settings && game.settings.breathMode) || 'hold';\\n    if (primary) {\\n      if (mode === 'toggle' && I.pressed('breath')) G._breathLatch = !G._breathLatch;\\n    } else if (mode === 'toggle' && I.pressed('breath')) lean._latch = !lean._latch;\\n    let target = 0;\\n    if (mode === 'toggle') target = (primary ? G._breathLatch : lean._latch) ? 1 : 0;\\n    else target = I.down('breath') ? 1 : 0;\\n    const dir = target >= lean.breath ? 1 : -1;\\n    if (lean.breath !== target) lean.breath = clamp(lean.breath + dir * 0.25 * dt, 0, 1);\\n    const pv = I.padValues || [];\\n    const trig = Math.max(pv[6] || 0, pv[7] || 0);\\n    if (mode !== 'toggle' && trig > 0.02) lean.breath = trig;\\n\\n    lean.effort = Math.max(lean.breath, I.value('paceR') || 0);\\n    lean.jump = !!I.pressed('jump');\\n    lean.catchL = !!I.pressed('catchL');\\n    lean.catchR = !!I.pressed('catchR');\\n    lean.paceL = !!I.down('paceL');\\n    lean.paceR = !!I.down('paceR');\\n\\n    if (primary) {\\n      const cv = game.screen && game.screen.canvas;\\n      if (cv && cv.style) {\\n        const hide = lean.source === 'mouse' && (game.sceneName === 'play' || game.sceneName === 'duel' || game.sceneName === 'attract');\\n        cv.style.cursor = hide ? 'none' : '';\\n      }\\n    }\\n  }\\n\\n  function readLean(game, dt) {\\n    const players = (game.players && game.players.length) ? game.players : [game.input];\\n    if (!G.leans || G.leans[0] !== G.lean) G.leans = [G.lean];\\n    while (G.leans.length < players.length) G.leans.push(freshLean());\\n    if (G.leans.length > players.length) G.leans.length = players.length;\\n    readOne(game, players[0], G.lean, dt, true);\\n    for (let i = 1; i < players.length; i++) readOne(game, players[i], G.leans[i], dt, false);\\n  }\\n\\n  function installShellCss() {\\n    if (typeof document === 'undefined') return;\\n    if (!document.getElementById('spine-shell-css')) {\\n      const st = document.createElement('style');\\n      st.id = 'spine-shell-css';\\n      st.textContent = '@media (min-height:700px){.esh-mod{zoom:1.5}}@media (min-height:1000px){.esh-mod{zoom:2}}.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}';\\n      document.head.appendChild(st);\\n    }\\n    if (!G._hoverFocus) {\\n      G._hoverFocus = true;\\n      document.addEventListener('pointerover', function (e) {\\n        const b = e.target && e.target.closest && e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');\\n        if (b && e.pointerType === 'mouse') b.focus({ preventScroll: true });\\n      });\\n    }\\n  }\\n\\n  function saveWrite() {\\n    if (G.attracting || G.inSession) return;\\n    const p = JSON.parse(JSON.stringify(G.profile));\\n    return { data: p, place: 'Day ' + p.day + '  ' + p.name, level: p.day };\\n  }\\n  function saveRead(save) {\\n    const d = (save && save.data) || {};\\n\",\"total_lines\":340}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0af2fa0c-4fe1-4e33-b32e-559b29abc563-73","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"320→  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n    const want = G.dev.keys.indexOf(key);\\n370→    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n  tapCode('ArrowRight');\\n380→  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n  const botAt = G.dev.tools.indexOf('Bot: good');\\n390→  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n  const offAt = G.dev.tools.indexOf('Bot: off');\\n400→  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n410→  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n  assert(olives.length > 0, 'no olives');\\n420→  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n  const rs0 = G.dev.v.ropeS;\\n430→  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\n440→add('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n450→  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n460→      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n470→    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n480→});\\n\\nadd('rules', 'class seats', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(game.players.length >= 2, 'players ' + game.players.length);\\n  /* Two players: P1 is the left half, so down is KeyS. A fresh press each time, or repeat() waits. */\\n  game.input.press('KeyS');\\n  game.advance(1 / 120);\\n490→  game.input.release('KeyS');\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills && G.scenes.class._pills.i === 1, 'pill ' + (G.scenes.class._pills && G.scenes.class._pills.i));\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 200 && (!G.session || G.session.phase !== 'play')) game.advance(1 / 120);\\n  assert(G.session && G.session.act.id === 'candle', 'activity ' + (G.session && G.session.act.id));\\n  assert(G.session && G.session.phase === 'play', 'phase ' + (G.session && G.session.phase));\\n  const seats = G.session.seats;\\n500→  assert(seats.length >= 2 && seats[0].human && seats[1].human, 'seats ' + seats.map(function (q) { return q.name + ':' + q.human; }).join(','));\\n  assert(!seats[0].skill && !seats[1].skill, 'skills ' + seats[0].skill + ' ' + seats[1].skill);\\n  game.players[1].press('ArrowRight');\\n  game.advance(1.2);\\n  assert(Math.abs(seats[1].bal.px) > Math.abs(seats[0].bal.px) + 0.05, 'px ' + seats[0].bal.px + ' ' + seats[1].bal.px);\\n  guard = 0;\\n  while (guard++ < 8000 && G.session && G.session.phase !== 'results') game.advance(0.25);\\n  assert(G.session && G.session.phase === 'results', 'no results');\\n  assert(seats[0].score !== seats[1].score, 'scores ' + seats[0].score + ' ' + seats[1].score + ' pct ' + seats[0].pct + ' ' + seats[1].pct);\\n  assert(seats[0].score >= 0 && seats[0].score <= 1000 && seats[1].score >= 0 && seats[1].score <= 1000, 'range');\\n510→  game.players[1].release('ArrowRight');\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n  const sent = [];\\n  const progress = [];\\n  let result = null;\\n520→  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n530→    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot();\\n540→    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n550→    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n    game.advance(8);\\n    const live = G.session;\\n    assert(live && live.seats[0] && !live.seats[0].skill, 'hub skill ' + (live && live.seats[0] && live.seats[0].skill));\\n560→    assert(G.driver == null, 'hub driver ' + G.driver);\\n    const humanPct = live.pct;\\n    const lean = { ux: G.lean.ux, uy: G.lean.uy, breath: G.lean.breath };\\n    const ref = new G.Session({ id: live.act.id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: live.seed });\\n    const nStep = Math.max(1, Math.round((live.playTime + 0.45) * 120));\\n    for (let i = 0; i < nStep; i++) ref.update(1 / 120);\\n    G.lean.ux = lean.ux; G.lean.uy = lean.uy; G.lean.breath = lean.breath;\\n    assert(Math.abs(humanPct - ref.pct) > 0.02, 'still posted the good bot ' + humanPct + ' vs ' + ref.pct + ' on ' + live.act.id);\\n    const before = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    game.input.press('KeyD');\\n570→    game.advance(0.5);\\n    const after = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    assert(Math.abs(after - before) > 0.02, 'held lean px ' + before + ' -> ' + after + ' on ' + live.act.id);\\n    game.input.release('KeyD');\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n580→    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\n590→add('rules', 'hub ghosts', async () => {\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() { return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] }); },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return 0; },\\n    answer() {},\\n    send() {},\\n    progress() {},\\n600→    result() {},\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot({ draw: true });\\n    await new Promise(function (r) { setImmediate(r); });\\n    game.advance(0.5);\\n    assert(scenesEi(game) === 0, 'event ' + scenesEi(game));\\n    (handlers.message || []).forEach(function (fn) {\\n610→      fn({ t: 'g', a: 0, l: [0.42, -0.25], w: [0.1, 0.05], s: 10 }, 'seat-2');\\n      fn({ t: 'g', a: 1, l: [0.9, 0.9], w: [0.2, 0.2], s: 1 }, 'seat-3');\\n    });\\n    const seen = [];\\n    const orig = game.r.actor;\\n    game.r.actor = function (x, y, z, fn, o) {\\n      seen.push(o || {});\\n      return orig.apply(this, arguments);\\n    };\\n    game.advance(1 / 120);\\n620→    game.r.actor = orig;\\n    const faded = seen.filter(function (o) { return o && o.alpha === 0.5; });\\n    assert(faded.length >= 1, 'ghost alpha calls ' + seen.length);\\n    const mine = G.ghosts.filter(function (q) { return q.from === 'seat-2'; })[0];\\n    const other = G.ghosts.filter(function (q) { return q.from === 'seat-3'; })[0];\\n    assert(mine && mine.rig, 'matching ghost was not drawn');\\n    assert(Math.abs(mine.rig.wob[1] - 0.52) < 1e-6 && Math.abs(mine.rig.wob[0] - -0.2) < 1e-6, 'wob ' + mine.rig.wob);\\n    assert(other && !other.rig, 'wrong event drew a rig');\\n    assert(!game.errors.length, 'draw errors');\\n  } finally {\\n630→    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nfunction scenesEi() { return G.scenes && G.scenes.round ? G.scenes.round.ei : null; }\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n640→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\",\"content_concise\":\"320→  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n    const want = G.dev.keys.indexOf(key);\\n370→    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n  tapCode('ArrowRight');\\n380→  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n  const botAt = G.dev.tools.indexOf('Bot: good');\\n390→  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n  const offAt = G.dev.tools.indexOf('Bot: off');\\n400→  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n410→  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n  assert(olives.length > 0, 'no olives');\\n420→  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n  const rs0 = G.dev.v.ropeS;\\n430→  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\n440→add('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n450→  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n460→      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n470→    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n480→});\\n\\nadd('rules', 'class seats', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(game.players.length >= 2, 'players ' + game.players.length);\\n  /* Two players: P1 is the left half, so down is KeyS. A fresh press each time, or repeat() waits. */\\n  game.input.press('KeyS');\\n  game.advance(1 / 120);\\n490→  game.input.release('KeyS');\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills && G.scenes.class._pills.i === 1, 'pill ' + (G.scenes.class._pills && G.scenes.class._pills.i));\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 200 && (!G.session || G.session.phase !== 'play')) game.advance(1 / 120);\\n  assert(G.session && G.session.act.id === 'candle', 'activity ' + (G.session && G.session.act.id));\\n  assert(G.session && G.session.phase === 'play', 'phase ' + (G.session && G.session.phase));\\n  const seats = G.session.seats;\\n500→  assert(seats.length >= 2 && seats[0].human && seats[1].human, 'seats ' + seats.map(function (q) { return q.name + ':' + q.human; }).join(','));\\n  assert(!seats[0].skill && !seats[1].skill, 'skills ' + seats[0].skill + ' ' + seats[1].skill);\\n  game.players[1].press('ArrowRight');\\n  game.advance(1.2);\\n  assert(Math.abs(seats[1].bal.px) > Math.abs(seats[0].bal.px) + 0.05, 'px ' + seats[0].bal.px + ' ' + seats[1].bal.px);\\n  guard = 0;\\n  while (guard++ < 8000 && G.session && G.session.phase !== 'results') game.advance(0.25);\\n  assert(G.session && G.session.phase === 'results', 'no results');\\n  assert(seats[0].score !== seats[1].score, 'scores ' + seats[0].score + ' ' + seats[1].score + ' pct ' + seats[0].pct + ' ' + seats[1].pct);\\n  assert(seats[0].score >= 0 && seats[0].score <= 1000 && seats[1].score >= 0 && seats[1].score <= 1000, 'range');\\n510→  game.players[1].release('ArrowRight');\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n  const sent = [];\\n  const progress = [];\\n  let result = null;\\n520→  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n530→    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot();\\n540→    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n550→    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n    game.advance(8);\\n    const live = G.session;\\n    assert(live && live.seats[0] && !live.seats[0].skill, 'hub skill ' + (live && live.seats[0] && live.seats[0].skill));\\n560→    assert(G.driver == null, 'hub driver ' + G.driver);\\n    const humanPct = live.pct;\\n    const lean = { ux: G.lean.ux, uy: G.lean.uy, breath: G.lean.breath };\\n    const ref = new G.Session({ id: live.act.id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: live.seed });\\n    const nStep = Math.max(1, Math.round((live.playTime + 0.45) * 120));\\n    for (let i = 0; i < nStep; i++) ref.update(1 / 120);\\n    G.lean.ux = lean.ux; G.lean.uy = lean.uy; G.lean.breath = lean.breath;\\n    assert(Math.abs(humanPct - ref.pct) > 0.02, 'still posted the good bot ' + humanPct + ' vs ' + ref.pct + ' on ' + live.act.id);\\n    const before = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    game.input.press('KeyD');\\n570→    game.advance(0.5);\\n    const after = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    assert(Math.abs(after - before) > 0.02, 'held lean px ' + before + ' -> ' + after + ' on ' + live.act.id);\\n    game.input.release('KeyD');\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n580→    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\n590→add('rules', 'hub ghosts', async () => {\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() { return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] }); },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return 0; },\\n    answer() {},\\n    send() {},\\n    progress() {},\\n600→    result() {},\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot({ draw: true });\\n    await new Promise(function (r) { setImmediate(r); });\\n    game.advance(0.5);\\n    assert(scenesEi(game) === 0, 'event ' + scenesEi(game));\\n    (handlers.message || []).forEach(function (fn) {\\n610→      fn({ t: 'g', a: 0, l: [0.42, -0.25], w: [0.1, 0.05], s: 10 }, 'seat-2');\\n      fn({ t: 'g', a: 1, l: [0.9, 0.9], w: [0.2, 0.2], s: 1 }, 'seat-3');\\n    });\\n    const seen = [];\\n    const orig = game.r.actor;\\n    game.r.actor = function (x, y, z, fn, o) {\\n      seen.push(o || {});\\n      return orig.apply(this, arguments);\\n    };\\n    game.advance(1 / 120);\\n620→    game.r.actor = orig;\\n    const faded = seen.filter(function (o) { return o && o.alpha === 0.5; });\\n    assert(faded.length >= 1, 'ghost alpha calls ' + seen.length);\\n    const mine = G.ghosts.filter(function (q) { return q.from === 'seat-2'; })[0];\\n    const other = G.ghosts.filter(function (q) { return q.from === 'seat-3'; })[0];\\n    assert(mine && mine.rig, 'matching ghost was not drawn');\\n    assert(Math.abs(mine.rig.wob[1] - 0.52) < 1e-6 && Math.abs(mine.rig.wob[0] - -0.2) < 1e-6, 'wob ' + mine.rig.wob);\\n    assert(other && !other.rig, 'wrong event drew a rig');\\n    assert(!game.errors.length, 'draw errors');\\n  } finally {\\n630→    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nfunction scenesEi() { return G.scenes && G.scenes.round ? G.scenes.round.ei : null; }\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n640→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs\",\"offset\":320,\"limit\":330,\"raw_output\":\"  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n    const want = G.dev.keys.indexOf(key);\\n    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n  const botAt = G.dev.tools.indexOf('Bot: good');\\n  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n  const offAt = G.dev.tools.indexOf('Bot: off');\\n  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n  assert(olives.length > 0, 'no olives');\\n  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n  const rs0 = G.dev.v.ropeS;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n});\\n\\nadd('rules', 'class seats', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(game.players.length >= 2, 'players ' + game.players.length);\\n  /* Two players: P1 is the left half, so down is KeyS. A fresh press each time, or repeat() waits. */\\n  game.input.press('KeyS');\\n  game.advance(1 / 120);\\n  game.input.release('KeyS');\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills && G.scenes.class._pills.i === 1, 'pill ' + (G.scenes.class._pills && G.scenes.class._pills.i));\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 200 && (!G.session || G.session.phase !== 'play')) game.advance(1 / 120);\\n  assert(G.session && G.session.act.id === 'candle', 'activity ' + (G.session && G.session.act.id));\\n  assert(G.session && G.session.phase === 'play', 'phase ' + (G.session && G.session.phase));\\n  const seats = G.session.seats;\\n  assert(seats.length >= 2 && seats[0].human && seats[1].human, 'seats ' + seats.map(function (q) { return q.name + ':' + q.human; }).join(','));\\n  assert(!seats[0].skill && !seats[1].skill, 'skills ' + seats[0].skill + ' ' + seats[1].skill);\\n  game.players[1].press('ArrowRight');\\n  game.advance(1.2);\\n  assert(Math.abs(seats[1].bal.px) > Math.abs(seats[0].bal.px) + 0.05, 'px ' + seats[0].bal.px + ' ' + seats[1].bal.px);\\n  guard = 0;\\n  while (guard++ < 8000 && G.session && G.session.phase !== 'results') game.advance(0.25);\\n  assert(G.session && G.session.phase === 'results', 'no results');\\n  assert(seats[0].score !== seats[1].score, 'scores ' + seats[0].score + ' ' + seats[1].score + ' pct ' + seats[0].pct + ' ' + seats[1].pct);\\n  assert(seats[0].score >= 0 && seats[0].score <= 1000 && seats[1].score >= 0 && seats[1].score <= 1000, 'range');\\n  game.players[1].release('ArrowRight');\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n  const sent = [];\\n  const progress = [];\\n  let result = null;\\n  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot();\\n    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n    game.advance(8);\\n    const live = G.session;\\n    assert(live && live.seats[0] && !live.seats[0].skill, 'hub skill ' + (live && live.seats[0] && live.seats[0].skill));\\n    assert(G.driver == null, 'hub driver ' + G.driver);\\n    const humanPct = live.pct;\\n    const lean = { ux: G.lean.ux, uy: G.lean.uy, breath: G.lean.breath };\\n    const ref = new G.Session({ id: live.act.id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: live.seed });\\n    const nStep = Math.max(1, Math.round((live.playTime + 0.45) * 120));\\n    for (let i = 0; i < nStep; i++) ref.update(1 / 120);\\n    G.lean.ux = lean.ux; G.lean.uy = lean.uy; G.lean.breath = lean.breath;\\n    assert(Math.abs(humanPct - ref.pct) > 0.02, 'still posted the good bot ' + humanPct + ' vs ' + ref.pct + ' on ' + live.act.id);\\n    const before = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    game.input.press('KeyD');\\n    game.advance(0.5);\\n    const after = live.seats[0].bal ? live.seats[0].bal.px : 0;\\n    assert(Math.abs(after - before) > 0.02, 'held lean px ' + before + ' -> ' + after + ' on ' + live.act.id);\\n    game.input.release('KeyD');\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nadd('rules', 'hub ghosts', async () => {\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() { return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] }); },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return 0; },\\n    answer() {},\\n    send() {},\\n    progress() {},\\n    result() {},\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot({ draw: true });\\n    await new Promise(function (r) { setImmediate(r); });\\n    game.advance(0.5);\\n    assert(scenesEi(game) === 0, 'event ' + scenesEi(game));\\n    (handlers.message || []).forEach(function (fn) {\\n      fn({ t: 'g', a: 0, l: [0.42, -0.25], w: [0.1, 0.05], s: 10 }, 'seat-2');\\n      fn({ t: 'g', a: 1, l: [0.9, 0.9], w: [0.2, 0.2], s: 1 }, 'seat-3');\\n    });\\n    const seen = [];\\n    const orig = game.r.actor;\\n    game.r.actor = function (x, y, z, fn, o) {\\n      seen.push(o || {});\\n      return orig.apply(this, arguments);\\n    };\\n    game.advance(1 / 120);\\n    game.r.actor = orig;\\n    const faded = seen.filter(function (o) { return o && o.alpha === 0.5; });\\n    assert(faded.length >= 1, 'ghost alpha calls ' + seen.length);\\n    const mine = G.ghosts.filter(function (q) { return q.from === 'seat-2'; })[0];\\n    const other = G.ghosts.filter(function (q) { return q.from === 'seat-3'; })[0];\\n    assert(mine && mine.rig, 'matching ghost was not drawn');\\n    assert(Math.abs(mine.rig.wob[1] - 0.52) < 1e-6 && Math.abs(mine.rig.wob[0] - -0.2) < 1e-6, 'wob ' + mine.rig.wob);\\n    assert(other && !other.rig, 'wrong event drew a rig');\\n    assert(!game.errors.length, 'draw errors');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nfunction scenesEi() { return G.scenes && G.scenes.round ? G.scenes.round.ei : null; }\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n\",\"total_lines\":969}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0af2fa0c-4fe1-4e33-b32e-559b29abc563-74","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"820→      if (g.headless && g.players.length < 2) { try { g.addPlayer({ keys: 'right' }); } catch (e) { /* one mat */ } }\\n      try { g.allowJoin({ max: 4 }); } catch (e) { /* already open */ }\\n      const acts = ['stork', 'candle', 'squat', 'step', 'hoop'];\\n      const items = acts.map(function (id) { return { label: G.ACTS[id].name, id: id }; });\\n      items.push({ label: 'Surprise me', id: 'surprise' });\\n      scenes.class._pills = new G.Pills(items, { i: 0 });\\n      scenes.class._podium = null;\\n      if (d.id) scenes.class.begin(d.id);\\n    },\\n    begin(id) {\\n830→      const seats = [];\\n      const players = G.game.players || [G.game.input];\\n      const n = Math.max(players.length, 2);\\n      for (let i = 0; i < n && i < 4; i++) {\\n        const local = i < players.length;\\n        seats.push({\\n          name: local ? ('P' + (i + 1)) : 'Regular',\\n          color: (E.PLAYER_COLORS && E.PLAYER_COLORS[i]) || '#4a8aff',\\n          local: local,\\n          human: !!local,\\n840→          skill: local ? null : 'average',\\n          scoring: !!local,\\n          botFill: !local,\\n          pi: local ? i : -1\\n        });\\n      }\\n      scenes.class._seats = seats;\\n      G.session = new G.Session({\\n        id: id, tier: 1, limit: 35, skipToPlay: true, classMode: true, trial: true,\\n        seats: seats, seed: 8\\n850→      });\\n      scenes.class._podium = null;\\n      G.phase = 'auto';\\n    },\\n    exit() {\\n      const g = G.game;\\n      if (!g) return;\\n      try { g.allowJoin(false); } catch (e) { /* quiet */ }\\n      while (g.players.length > 1) { try { g.removePlayer(g.players[g.players.length - 1]); } catch (e) { break; } }\\n    },\\n860→    update(dt) {\\n      const s = G.session;\\n      if (!s) {\\n        G.phase = 'menu';\\n        if (scenes.class._podium) {\\n          if (G.game.input.pressed('confirm') || G.game.input.pressed('cancel')) go('title');\\n          return;\\n        }\\n        const it = scenes.class._pills.update(G.game.input);\\n        if (!it) return;\\n870→        if (it.id === 'surprise') {\\n          G.queue = ['candle', 'hoop'];\\n          G.chainAfter = function () { scenes.class._podium = true; G.session = null; };\\n          scenes.class.begin('stork');\\n        } else scenes.class.begin(it.id);\\n        return;\\n      }\\n      s.update(dt);\\n      if (s.phase === 'results') {\\n        G.phase = 'menu';\\n880→        if (!scenes.class._shown) {\\n          scenes.class._shown = true;\\n          scenes.class._scores = s.seats.map(function (q) { return q.score || 0; });\\n        }\\n        if (G.game.input.pressed('confirm')) {\\n          scenes.class._shown = false;\\n          if (G.queue && G.queue.length) { const id = G.queue.shift(); scenes.class.begin(id); }\\n          else {\\n            const seats = s.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n            G.podium = seats.map(function (q, i) {\\n890→              return { title: G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)], name: q.name, score: q.score || 0 };\\n            });\\n            G.session = null;\\n            scenes.class._podium = true;\\n          }\\n        }\\n      } else G.phase = s.phase === 'play' ? 'play' : 'auto';\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n900→      if (!G.session) {\\n        if (scenes.class._podium && G.podium) {\\n          hudName(r, 'Podium', 'Tare reads the polite titles.');\\n          r.overlay(function (g) {\\n            G.podium.forEach(function (q, i) {\\n              G.text(g, q.title + '  ' + q.name + '  ' + q.score, 16, 78 + i * 16, '#20404c', 1);\\n            });\\n          });\\n          return;\\n        }\\n910→        hudName(r, 'Local Class', 'Mats for whoever came.');\\n        scenes.class._pills.draw(r);\\n        return;\\n      }\\n      try { G.drawActivity(r, G.session); } catch (e) { /* room */ }\\n      if (G.session.phase === 'results') {\\n        r.overlay(function (g) {\\n          const seats = G.session.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n          seats.forEach(function (q, i) {\\n            const title = G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)];\\n920→            G.text(g, title + '  ' + q.name + '  ' + (q.score || 0), 16, 78 + i * 16, '#20404c', 1);\\n          });\\n        });\\n      }\\n    }\\n  });\\n\\n  G.hubSendAcc = 0;\\n  G.hubProgAcc = 0;\\n  G.morningEvents = null;\\n930→  G.morningScores = [0, 0, 0];\\n\\n  function hubApi() { return (typeof AIHub !== 'undefined') ? AIHub : null; }\\n\\n  G.hubTimeUp = function () {\\n    if (G.hubReported) return;\\n    G.hubReported = true;\\n    const api = hubApi();\\n    if (!api || !api.result) return;\\n    const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n940→    try {\\n      api.result({\\n        score: total,\\n        stats: { Steadiness: Math.round((G.morningScores[0] || 0) / 10) + '%' },\\n        awards: [{ title: 'Most Still', detail: 'A quiet morning.' }]\\n      });\\n    } catch (e) { /* the hub already closed */ }\\n  };\\n  G.hubEnd = function () {\\n    G.hubOver = true;\\n950→    try { if (G.game) { G.game.audio.stopMusic(); G.game.audio.mute(true); G.game.input.clear(); } } catch (e) { /* quiet */ }\\n  };\\n\\n  /* A hub ghost is a translucent rig posed from the lean and the extra wobble it sent. */\\n  function drawGhostRigs(r) {\\n    if (!r || !r.actor || !G.ghosts || !G.makeRig) return;\\n    const ev = scenes.round.ei;\\n    G.ghosts.forEach(function (gh, i) {\\n      if (!gh || gh.a !== ev) return;\\n      const l = gh.l || [0, 0];\\n960→      const w = gh.w || [0, 0];\\n      const wob = [(l[1] || 0) + (w[1] || 0), (l[0] || 0) + (w[0] || 0)];\\n      try {\\n        if (!gh.rig) gh.rig = G.makeRig(G.playerOpts(null, 1.7));\\n        const rig = gh.rig;\\n        G.poseRig(rig, 'idle', (G.game && G.game.time) || 0, wob);\\n        rig.wob = wob.slice();\\n        G.stepRig(rig, 1 / 60, 0, 0);\\n        r.actor(-8 + i * 4.5, 8, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); }, { alpha: 0.5, outline: false });\\n      } catch (e) { /* the name still shows */ }\\n970→    });\\n  }\\n\\n  scenes.round = base({\\n    enter() {\\n      G.hubOver = false;\\n      G.hubReported = false;\\n      G.ghosts = [];\\n      G.morningScores = [0, 0, 0];\\n      G.hubSendAcc = 0;\\n980→      G.hubProgAcc = 1;\\n      G.session = null;\\n      scenes.round.dealt = false;\\n      scenes.round.ei = -1;\\n      try { G.playSong('studio'); } catch (e) { /* quiet */ }\\n    },\\n    update(dt) {\\n      if (G.hubOver) { G.phase = 'auto'; return; }\\n      const api = hubApi();\\n      const live = !!(api && G.inSession && api.time);\\n990→      const tms = live ? api.time() : (scenes.round.local = (scenes.round.local || 0) + dt * 1000);\\n      if (live && tms === -Infinity) {\\n        G.phase = 'menu';\\n        const I = G.game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) { try { api.answer('ready'); } catch (e) { /* early */ } }\\n        if (I.pressed('more')) { try { api.answer('more'); } catch (e) { /* early */ } }\\n        return;\\n      }\\n      if (tms < 0) { G.phase = 'auto'; G.left = Math.max(0, -tms / 1000); return; }\\n      if (!scenes.round.dealt) {\\n1000→        let rng = E.rng(7);\\n        try { if (live && api.rng) rng = api.rng('deal'); } catch (e) { rng = E.rng(7); }\\n        G.morningEvents = G.deal(rng);\\n        scenes.round.dealt = true;\\n      }\\n      const span = 50;\\n      const ev = Math.min(2, Math.floor(tms / 1000 / span));\\n      const local = (tms / 1000) - ev * span;\\n      if (ev !== scenes.round.ei) {\\n        scenes.round.ei = ev;\\n1010→        const id = G.morningEvents[ev];\\n        try {\\n          G.session = new G.Session({ id: id, tier: 1, limit: 40, skipToPlay: true, trial: true, seed: 20 + ev });\\n          if (!G.attracting) G.driver = null;\\n        } catch (e) { G.session = null; }\\n      }\\n      const s = G.session;\\n      if (s && local < 45 && s.phase !== 'results') {\\n        try { s.update(Math.min(dt, 0.05)); } catch (e) { /* keep the clock */ }\\n        if (s.phase === 'results') G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n1020→        else G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n      }\\n      G.phase = 'play';\\n      G.left = Math.max(0, span - local);\\n      if (live) {\\n        G.hubSendAcc += dt;\\n        G.hubProgAcc += dt;\\n        if (G.hubSendAcc >= 0.1) {\\n          G.hubSendAcc = 0;\\n          const b = s && s.seats && s.seats[0] && s.seats[0].bal;\\n1030→          try {\\n            api.send({ t: 'g', a: ev, l: [b ? b.px : 0, b ? b.py : 0], p: s ? s.phase : 'play', w: [0, 0], s: G.morningScores[ev] || 0 }, { reliable: false });\\n          } catch (e) { /* rate */ }\\n        }\\n        if (G.hubProgAcc >= 1) {\\n          G.hubProgAcc = 0;\\n          const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n          try { api.progress({ score: total, label: total + ' pts' }); } catch (e) { /* rate */ }\\n        }\\n      }\\n1040→    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n      const api = hubApi();\\n      const waiting = api && G.inSession && api.time && api.time() === -Infinity;\\n      if (waiting) {\\n        hudName(r, 'Spine Wee', 'Morning Class');\\n        r.overlay(function (g) {\\n          G.text(g, 'Lean. Stay steady. Most points wins.', 12, 70, '#20404c', 1);\\n          const ps = (G.hubInfo && G.hubInfo.players) || [];\\n1050→          ps.forEach(function (p, i) { G.text(g, (p.name || ('Seat ' + (i + 1))), 12, 90 + i * 14, p.color || '#14a8c8', 1); });\\n          G.text(g, 'Ready', r.W / 2 - 40, r.H - 36, '#14a8c8', 2);\\n        });\\n        return;\\n      }\\n      if (G.session) { try { G.drawActivity(r, G.session); } catch (e) { /* room */ } }\\n      drawGhostRigs(r);\\n      r.overlay(function (g) {\\n        const names = (G.morningEvents || []).join('  ');\\n        G.text(g, names, 8, r.H - 24, '#5f7f8a', 1);\\n1060→        G.ghosts.forEach(function (gh, i) {\\n          if (!gh || gh.a !== scenes.round.ei) return;\\n          G.text(g, gh.name || 'ghost', 20 + i * 40, 60, gh.color || '#ffffff', 1);\\n        });\\n      });\\n    }\\n  });\\n\\n  function aboutPages() {\\n    const A = G.ABOUT;\\n1070→    const pages = [];\\n    if (A && A.sourceInformation) {\\n      const order = ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\\n      order.forEach(function (k) { pages.push({ h: 'Source', t: k + ': ' + A.sourceInformation[k] }); });\\n    } else pages.push({ h: 'Source', t: 'Source information is bound when the page is built.' });\\n    const blocks = [\\n      ['Testing Feedback', A && A.testingFeedback],\\n      ['Engine Feedback', A && A.engineFeedback],\\n      ['Prompt Feedback', A && A.promptFeedback]\\n    ];\",\"content_concise\":\"820→      if (g.headless && g.players.length < 2) { try { g.addPlayer({ keys: 'right' }); } catch (e) { /* one mat */ } }\\n      try { g.allowJoin({ max: 4 }); } catch (e) { /* already open */ }\\n      const acts = ['stork', 'candle', 'squat', 'step', 'hoop'];\\n      const items = acts.map(function (id) { return { label: G.ACTS[id].name, id: id }; });\\n      items.push({ label: 'Surprise me', id: 'surprise' });\\n      scenes.class._pills = new G.Pills(items, { i: 0 });\\n      scenes.class._podium = null;\\n      if (d.id) scenes.class.begin(d.id);\\n    },\\n    begin(id) {\\n830→      const seats = [];\\n      const players = G.game.players || [G.game.input];\\n      const n = Math.max(players.length, 2);\\n      for (let i = 0; i < n && i < 4; i++) {\\n        const local = i < players.length;\\n        seats.push({\\n          name: local ? ('P' + (i + 1)) : 'Regular',\\n          color: (E.PLAYER_COLORS && E.PLAYER_COLORS[i]) || '#4a8aff',\\n          local: local,\\n          human: !!local,\\n840→          skill: local ? null : 'average',\\n          scoring: !!local,\\n          botFill: !local,\\n          pi: local ? i : -1\\n        });\\n      }\\n      scenes.class._seats = seats;\\n      G.session = new G.Session({\\n        id: id, tier: 1, limit: 35, skipToPlay: true, classMode: true, trial: true,\\n        seats: seats, seed: 8\\n850→      });\\n      scenes.class._podium = null;\\n      G.phase = 'auto';\\n    },\\n    exit() {\\n      const g = G.game;\\n      if (!g) return;\\n      try { g.allowJoin(false); } catch (e) { /* quiet */ }\\n      while (g.players.length > 1) { try { g.removePlayer(g.players[g.players.length - 1]); } catch (e) { break; } }\\n    },\\n860→    update(dt) {\\n      const s = G.session;\\n      if (!s) {\\n        G.phase = 'menu';\\n        if (scenes.class._podium) {\\n          if (G.game.input.pressed('confirm') || G.game.input.pressed('cancel')) go('title');\\n          return;\\n        }\\n        const it = scenes.class._pills.update(G.game.input);\\n        if (!it) return;\\n870→        if (it.id === 'surprise') {\\n          G.queue = ['candle', 'hoop'];\\n          G.chainAfter = function () { scenes.class._podium = true; G.session = null; };\\n          scenes.class.begin('stork');\\n        } else scenes.class.begin(it.id);\\n        return;\\n      }\\n      s.update(dt);\\n      if (s.phase === 'results') {\\n        G.phase = 'menu';\\n880→        if (!scenes.class._shown) {\\n          scenes.class._shown = true;\\n          scenes.class._scores = s.seats.map(function (q) { return q.score || 0; });\\n        }\\n        if (G.game.input.pressed('confirm')) {\\n          scenes.class._shown = false;\\n          if (G.queue && G.queue.length) { const id = G.queue.shift(); scenes.class.begin(id); }\\n          else {\\n            const seats = s.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n            G.podium = seats.map(function (q, i) {\\n890→              return { title: G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)], name: q.name, score: q.score || 0 };\\n            });\\n            G.session = null;\\n            scenes.class._podium = true;\\n          }\\n        }\\n      } else G.phase = s.phase === 'play' ? 'play' : 'auto';\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n900→      if (!G.session) {\\n        if (scenes.class._podium && G.podium) {\\n          hudName(r, 'Podium', 'Tare reads the polite titles.');\\n          r.overlay(function (g) {\\n            G.podium.forEach(function (q, i) {\\n              G.text(g, q.title + '  ' + q.name + '  ' + q.score, 16, 78 + i * 16, '#20404c', 1);\\n            });\\n          });\\n          return;\\n        }\\n910→        hudName(r, 'Local Class', 'Mats for whoever came.');\\n        scenes.class._pills.draw(r);\\n        return;\\n      }\\n      try { G.drawActivity(r, G.session); } catch (e) { /* room */ }\\n      if (G.session.phase === 'results') {\\n        r.overlay(function (g) {\\n          const seats = G.session.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n          seats.forEach(function (q, i) {\\n            const title = G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)];\\n920→            G.text(g, title + '  ' + q.name + '  ' + (q.score || 0), 16, 78 + i * 16, '#20404c', 1);\\n          });\\n        });\\n      }\\n    }\\n  });\\n\\n  G.hubSendAcc = 0;\\n  G.hubProgAcc = 0;\\n  G.morningEvents = null;\\n930→  G.morningScores = [0, 0, 0];\\n\\n  function hubApi() { return (typeof AIHub !== 'undefined') ? AIHub : null; }\\n\\n  G.hubTimeUp = function () {\\n    if (G.hubReported) return;\\n    G.hubReported = true;\\n    const api = hubApi();\\n    if (!api || !api.result) return;\\n    const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n940→    try {\\n      api.result({\\n        score: total,\\n        stats: { Steadiness: Math.round((G.morningScores[0] || 0) / 10) + '%' },\\n        awards: [{ title: 'Most Still', detail: 'A quiet morning.' }]\\n      });\\n    } catch (e) { /* the hub already closed */ }\\n  };\\n  G.hubEnd = function () {\\n    G.hubOver = true;\\n950→    try { if (G.game) { G.game.audio.stopMusic(); G.game.audio.mute(true); G.game.input.clear(); } } catch (e) { /* quiet */ }\\n  };\\n\\n  /* A hub ghost is a translucent rig posed from the lean and the extra wobble it sent. */\\n  function drawGhostRigs(r) {\\n    if (!r || !r.actor || !G.ghosts || !G.makeRig) return;\\n    const ev = scenes.round.ei;\\n    G.ghosts.forEach(function (gh, i) {\\n      if (!gh || gh.a !== ev) return;\\n      const l = gh.l || [0, 0];\\n960→      const w = gh.w || [0, 0];\\n      const wob = [(l[1] || 0) + (w[1] || 0), (l[0] || 0) + (w[0] || 0)];\\n      try {\\n        if (!gh.rig) gh.rig = G.makeRig(G.playerOpts(null, 1.7));\\n        const rig = gh.rig;\\n        G.poseRig(rig, 'idle', (G.game && G.game.time) || 0, wob);\\n        rig.wob = wob.slice();\\n        G.stepRig(rig, 1 / 60, 0, 0);\\n        r.actor(-8 + i * 4.5, 8, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); }, { alpha: 0.5, outline: false });\\n      } catch (e) { /* the name still shows */ }\\n970→    });\\n  }\\n\\n  scenes.round = base({\\n    enter() {\\n      G.hubOver = false;\\n      G.hubReported = false;\\n      G.ghosts = [];\\n      G.morningScores = [0, 0, 0];\\n      G.hubSendAcc = 0;\\n980→      G.hubProgAcc = 1;\\n      G.session = null;\\n      scenes.round.dealt = false;\\n      scenes.round.ei = -1;\\n      try { G.playSong('studio'); } catch (e) { /* quiet */ }\\n    },\\n    update(dt) {\\n      if (G.hubOver) { G.phase = 'auto'; return; }\\n      const api = hubApi();\\n      const live = !!(api && G.inSession && api.time);\\n990→      const tms = live ? api.time() : (scenes.round.local = (scenes.round.local || 0) + dt * 1000);\\n      if (live && tms === -Infinity) {\\n        G.phase = 'menu';\\n        const I = G.game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) { try { api.answer('ready'); } catch (e) { /* early */ } }\\n        if (I.pressed('more')) { try { api.answer('more'); } catch (e) { /* early */ } }\\n        return;\\n      }\\n      if (tms < 0) { G.phase = 'auto'; G.left = Math.max(0, -tms / 1000); return; }\\n      if (!scenes.round.dealt) {\\n1000→        let rng = E.rng(7);\\n        try { if (live && api.rng) rng = api.rng('deal'); } catch (e) { rng = E.rng(7); }\\n        G.morningEvents = G.deal(rng);\\n        scenes.round.dealt = true;\\n      }\\n      const span = 50;\\n      const ev = Math.min(2, Math.floor(tms / 1000 / span));\\n      const local = (tms / 1000) - ev * span;\\n      if (ev !== scenes.round.ei) {\\n        scenes.round.ei = ev;\\n1010→        const id = G.morningEvents[ev];\\n        try {\\n          G.session = new G.Session({ id: id, tier: 1, limit: 40, skipToPlay: true, trial: true, seed: 20 + ev });\\n          if (!G.attracting) G.driver = null;\\n        } catch (e) { G.session = null; }\\n      }\\n      const s = G.session;\\n      if (s && local < 45 && s.phase !== 'results') {\\n        try { s.update(Math.min(dt, 0.05)); } catch (e) { /* keep the clock */ }\\n        if (s.phase === 'results') G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n1020→        else G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n      }\\n      G.phase = 'play';\\n      G.left = Math.max(0, span - local);\\n      if (live) {\\n        G.hubSendAcc += dt;\\n        G.hubProgAcc += dt;\\n        if (G.hubSendAcc >= 0.1) {\\n          G.hubSendAcc = 0;\\n          const b = s && s.seats && s.seats[0] && s.seats[0].bal;\\n1030→          try {\\n            api.send({ t: 'g', a: ev, l: [b ? b.px : 0, b ? b.py : 0], p: s ? s.phase : 'play', w: [0, 0], s: G.morningScores[ev] || 0 }, { reliable: false });\\n          } catch (e) { /* rate */ }\\n        }\\n        if (G.hubProgAcc >= 1) {\\n          G.hubProgAcc = 0;\\n          const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n          try { api.progress({ score: total, label: total + ' pts' }); } catch (e) { /* rate */ }\\n        }\\n      }\\n1040→    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n      const api = hubApi();\\n      const waiting = api && G.inSession && api.time && api.time() === -Infinity;\\n      if (waiting) {\\n        hudName(r, 'Spine Wee', 'Morning Class');\\n        r.overlay(function (g) {\\n          G.text(g, 'Lean. Stay steady. Most points wins.', 12, 70, '#20404c', 1);\\n          const ps = (G.hubInfo && G.hubInfo.players) || [];\\n1050→          ps.forEach(function (p, i) { G.text(g, (p.name || ('Seat ' + (i + 1))), 12, 90 + i * 14, p.color || '#14a8c8', 1); });\\n          G.text(g, 'Ready', r.W / 2 - 40, r.H - 36, '#14a8c8', 2);\\n        });\\n        return;\\n      }\\n      if (G.session) { try { G.drawActivity(r, G.session); } catch (e) { /* room */ } }\\n      drawGhostRigs(r);\\n      r.overlay(function (g) {\\n        const names = (G.morningEvents || []).join('  ');\\n        G.text(g, names, 8, r.H - 24, '#5f7f8a', 1);\\n1060→        G.ghosts.forEach(function (gh, i) {\\n          if (!gh || gh.a !== scenes.round.ei) return;\\n          G.text(g, gh.name || 'ghost', 20 + i * 40, 60, gh.color || '#ffffff', 1);\\n        });\\n      });\\n    }\\n  });\\n\\n  function aboutPages() {\\n    const A = G.ABOUT;\\n1070→    const pages = [];\\n    if (A && A.sourceInformation) {\\n      const order = ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\\n      order.forEach(function (k) { pages.push({ h: 'Source', t: k + ': ' + A.sourceInformation[k] }); });\\n    } else pages.push({ h: 'Source', t: 'Source information is bound when the page is built.' });\\n    const blocks = [\\n      ['Testing Feedback', A && A.testingFeedback],\\n      ['Engine Feedback', A && A.engineFeedback],\\n      ['Prompt Feedback', A && A.promptFeedback]\\n    ];\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js\",\"offset\":820,\"limit\":260,\"raw_output\":\"      if (g.headless && g.players.length < 2) { try { g.addPlayer({ keys: 'right' }); } catch (e) { /* one mat */ } }\\n      try { g.allowJoin({ max: 4 }); } catch (e) { /* already open */ }\\n      const acts = ['stork', 'candle', 'squat', 'step', 'hoop'];\\n      const items = acts.map(function (id) { return { label: G.ACTS[id].name, id: id }; });\\n      items.push({ label: 'Surprise me', id: 'surprise' });\\n      scenes.class._pills = new G.Pills(items, { i: 0 });\\n      scenes.class._podium = null;\\n      if (d.id) scenes.class.begin(d.id);\\n    },\\n    begin(id) {\\n      const seats = [];\\n      const players = G.game.players || [G.game.input];\\n      const n = Math.max(players.length, 2);\\n      for (let i = 0; i < n && i < 4; i++) {\\n        const local = i < players.length;\\n        seats.push({\\n          name: local ? ('P' + (i + 1)) : 'Regular',\\n          color: (E.PLAYER_COLORS && E.PLAYER_COLORS[i]) || '#4a8aff',\\n          local: local,\\n          human: !!local,\\n          skill: local ? null : 'average',\\n          scoring: !!local,\\n          botFill: !local,\\n          pi: local ? i : -1\\n        });\\n      }\\n      scenes.class._seats = seats;\\n      G.session = new G.Session({\\n        id: id, tier: 1, limit: 35, skipToPlay: true, classMode: true, trial: true,\\n        seats: seats, seed: 8\\n      });\\n      scenes.class._podium = null;\\n      G.phase = 'auto';\\n    },\\n    exit() {\\n      const g = G.game;\\n      if (!g) return;\\n      try { g.allowJoin(false); } catch (e) { /* quiet */ }\\n      while (g.players.length > 1) { try { g.removePlayer(g.players[g.players.length - 1]); } catch (e) { break; } }\\n    },\\n    update(dt) {\\n      const s = G.session;\\n      if (!s) {\\n        G.phase = 'menu';\\n        if (scenes.class._podium) {\\n          if (G.game.input.pressed('confirm') || G.game.input.pressed('cancel')) go('title');\\n          return;\\n        }\\n        const it = scenes.class._pills.update(G.game.input);\\n        if (!it) return;\\n        if (it.id === 'surprise') {\\n          G.queue = ['candle', 'hoop'];\\n          G.chainAfter = function () { scenes.class._podium = true; G.session = null; };\\n          scenes.class.begin('stork');\\n        } else scenes.class.begin(it.id);\\n        return;\\n      }\\n      s.update(dt);\\n      if (s.phase === 'results') {\\n        G.phase = 'menu';\\n        if (!scenes.class._shown) {\\n          scenes.class._shown = true;\\n          scenes.class._scores = s.seats.map(function (q) { return q.score || 0; });\\n        }\\n        if (G.game.input.pressed('confirm')) {\\n          scenes.class._shown = false;\\n          if (G.queue && G.queue.length) { const id = G.queue.shift(); scenes.class.begin(id); }\\n          else {\\n            const seats = s.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n            G.podium = seats.map(function (q, i) {\\n              return { title: G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)], name: q.name, score: q.score || 0 };\\n            });\\n            G.session = null;\\n            scenes.class._podium = true;\\n          }\\n        }\\n      } else G.phase = s.phase === 'play' ? 'play' : 'auto';\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n      if (!G.session) {\\n        if (scenes.class._podium && G.podium) {\\n          hudName(r, 'Podium', 'Tare reads the polite titles.');\\n          r.overlay(function (g) {\\n            G.podium.forEach(function (q, i) {\\n              G.text(g, q.title + '  ' + q.name + '  ' + q.score, 16, 78 + i * 16, '#20404c', 1);\\n            });\\n          });\\n          return;\\n        }\\n        hudName(r, 'Local Class', 'Mats for whoever came.');\\n        scenes.class._pills.draw(r);\\n        return;\\n      }\\n      try { G.drawActivity(r, G.session); } catch (e) { /* room */ }\\n      if (G.session.phase === 'results') {\\n        r.overlay(function (g) {\\n          const seats = G.session.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n          seats.forEach(function (q, i) {\\n            const title = G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)];\\n            G.text(g, title + '  ' + q.name + '  ' + (q.score || 0), 16, 78 + i * 16, '#20404c', 1);\\n          });\\n        });\\n      }\\n    }\\n  });\\n\\n  G.hubSendAcc = 0;\\n  G.hubProgAcc = 0;\\n  G.morningEvents = null;\\n  G.morningScores = [0, 0, 0];\\n\\n  function hubApi() { return (typeof AIHub !== 'undefined') ? AIHub : null; }\\n\\n  G.hubTimeUp = function () {\\n    if (G.hubReported) return;\\n    G.hubReported = true;\\n    const api = hubApi();\\n    if (!api || !api.result) return;\\n    const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n    try {\\n      api.result({\\n        score: total,\\n        stats: { Steadiness: Math.round((G.morningScores[0] || 0) / 10) + '%' },\\n        awards: [{ title: 'Most Still', detail: 'A quiet morning.' }]\\n      });\\n    } catch (e) { /* the hub already closed */ }\\n  };\\n  G.hubEnd = function () {\\n    G.hubOver = true;\\n    try { if (G.game) { G.game.audio.stopMusic(); G.game.audio.mute(true); G.game.input.clear(); } } catch (e) { /* quiet */ }\\n  };\\n\\n  /* A hub ghost is a translucent rig posed from the lean and the extra wobble it sent. */\\n  function drawGhostRigs(r) {\\n    if (!r || !r.actor || !G.ghosts || !G.makeRig) return;\\n    const ev = scenes.round.ei;\\n    G.ghosts.forEach(function (gh, i) {\\n      if (!gh || gh.a !== ev) return;\\n      const l = gh.l || [0, 0];\\n      const w = gh.w || [0, 0];\\n      const wob = [(l[1] || 0) + (w[1] || 0), (l[0] || 0) + (w[0] || 0)];\\n      try {\\n        if (!gh.rig) gh.rig = G.makeRig(G.playerOpts(null, 1.7));\\n        const rig = gh.rig;\\n        G.poseRig(rig, 'idle', (G.game && G.game.time) || 0, wob);\\n        rig.wob = wob.slice();\\n        G.stepRig(rig, 1 / 60, 0, 0);\\n        r.actor(-8 + i * 4.5, 8, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); }, { alpha: 0.5, outline: false });\\n      } catch (e) { /* the name 