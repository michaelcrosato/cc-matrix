5,114,109,32,116,104,101,32,98,117,105,108,116,32,112,97,103,101,32,105,110,108,105,110,101,115,32,105,116,115,32,115,99,114,105,112,116,115,44,32,105,110,106,101,99,116,115,32,116,104,101,32,115,97,109,101,32,65,98,111,117,116,32,116,101,120,116,32,97,115,32,116,104,101,32,74,83,79,78,44,32,108,105,115,116,115,32,116,104,101,32,104,117,98,32,109,101,116,97,32,116,97,103,115,44,32,107,101,101,112,115,32,115,101,115,115,105,111,110,46,106,115,32,102,105,114,115,116,32,97,110,100,32,117,110,109,111,100,105,102,105,101,100,44,32,97,110,100,32,99,111,110,116,97,105,110,115,32,110,111,32,84,79,68,79,47,112,108,97,99,101,104,111,108,100,101,114,47,115,116,117,98,32,97,110,100,32,110,111,32,97,117,100,105,111,45,102,105,108,101,32,108,111,97,100,115,46,32,67,97,112,116,117,114,101,32,96,123,83,67,82,65,84,67,72,125,47,104,97,110,100,111,102,102,45,115,116,97,116,105,99,46,108,111,103,96,46,10,51,54,58,45,32,91,120,93,32,65,100,100,32,116,105,116,108,101,44,32,109,101,109,98,101,114,44,32,97,114,114,105,118,97,108,44,32,105,115,108,97,110,100,32,100,97,121,32,108,111,111,112,44,32,98,111,100,121,32,99,104,101,99,107,44,32,115,97,118,101,115,44,32,83,112,105,110,101,32,65,103,101,44,32,71,101,114,97,108,100,44,32,97,110,100,32,97,32,100,101,118,32,112,97,110,101,108,32,119,105,116,104,32,108,105,118,101,32,76,101,97,110,32,115,108,105,100,101,114,115,46,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":8,\"file_matches\":[{\"path\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261104-220108__x61bd7e%2Fwork/01a1aa15-0d43-7de2-87b2-754e4acb611c/goal/plan.md\",\"matches\":[{\"line_number\":6,\"content\":\"## Acceptance criteria\"},{\"line_number\":9,\"content\":\"3. The same screens are built for a TV pad first and also feel native on keyboard and mouse: lean is stick, key-nudge, or pointer; prompts follow the last used device; glyphs default to PlayStation and a setting switches to Xbox; hover moves focus and click activates in both the game pills and the HTML menus. Touch-only devices get no touch controls, the text “Controller or keyboard required”, and a Settings button, and attract still runs. After 10 seconds without input on the title or top-level menus, a looping AI/replay demo plays the activities and does not write saves or unlocks; any input returns to the title and swallows that press; it does not start at 9.9 seconds. Dev mode opens from the pause menu in every scene, keeps the game running, exposes the important Lean, scoring, cardio, game, and time variables as live sliders with a reset to defaults, and can jump scene, activity, tier, and day. All music, effects, and voices are synthesized in code (no audio files); voices are Ani [... truncated (1031 chars total)]\"},{\"line_number\":11,\"content\":\"5. `node tests/run.mjs` with `rules`, `browser`, `hub`, and `all` is the only test command, prints failures plus one count line, and `all` finishes with 0 failed. Those tests drive the shipped game from its real start (not a reimplementation or a mocked Lean): section 3’s bot bands land within ±10 on 12 seeds; every activity and tier meets the star gates (tier 1 passive under 1★, average at least 1★, good at least 2★; tier 2 passive under 1★, good at least 1★, expert at least 2★); a scripted playthrough and a passive run reach the ending with the day-3 plateau and unlocks; saves round-trip and a damaged save does not crash; the same seed and input hash the same twice; attract, dev sliders/reset/jumps, class, and a fake hub (one report on time-up, end stops input) behave as above; data references resolve and game sources contain no TODO, placeholder, or stub. The browser group loads the built file from `file://` with no page errors, a gamepad stub, keyboard and mouse, the touch notice,  [... truncated (1031 chars total)]\"},{\"line_number\":13,\"content\":\"## Verification plan\"},{\"line_number\":14,\"content\":\"1. gating: From the dev subfolder, run `node tests/run.mjs all` once after browsers are free. Capture stdout and stderr to `{SCRATCH}/tests-all.log`. Pass only if the log’s final line is a count with 0 failed and no failure block. Read the test sources and confirm they load the shipped scripts, advance the real game, and assert every outcome named in criterion 5 (bands, both playthroughs, saves, determinism, attract at 10s not 9.9s, dev, class, fake hub, data lint, file:// browser checks, engine check, and the five hub harness URLs including `__hubCheck.pass`). A runner that only prints a count, or tests that never call the shipped game, does not pass.\"},{\"line_number\":15,\"content\":\"2. gating: With no other browser left open, launch the built HTML from `file://` in headless Chromium twice, sequentially. Each run must wait on game state (not the wall clock) until the title scene is up, then show zero page errors, a drawing surface that is not the default 300×150 and is substantially painted (a successful blank or tiny readback fails), the chosen title visible, and a real key or pad-stub press that moves menu focus or leaves the title in the expected way. Capture `{SCRATCH}/launch-1.log`, `{SCRATCH}/launch-2.log`, and `{SCRATCH}/title-1920x1080.png`. Both runs must agree. If Playwright cannot start or cannot read pixels at all, save that error as `{SCRATCH}/launch-env.log` and instead evaluate the same built scripts with a `window` global and no Node `module`/`require`, asserting they throw nothing and install the game; a readback that works and is blank is a game failure, not this fallback.\"},{\"line_number\":16,\"content\":\"3. gating: Static hand-in, no browser. Confirm the HTML, matching dev subfolder, `PROGRESS.md`, and `exit-interview.json` names and JSON shape in criterion 1; confirm the built page inlines its scripts, injects the same About text as the JSON, lists the hub meta tags, keeps session.js first and unmodified, and contains no TODO/placeholder/stub and no audio-file loads. Capture `{SCRATCH}/handoff-static.log`.\"},{\"line_number\":36,\"content\":\"- [x] Add title, member, arrival, island day loop, body check, saves, Spine Age, Gerald, and a dev panel with live Lean sliders.\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"2f157636-8da8-42d7-8372-76a596e05808"}
{"type":"assistant","message":{"id":"msg_773","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"text","text":"The stray double-step line looks gone. I'll read the panel handler and the test that claims one press moves one row."},{"type":"tool_use","id":"call-b83abaec-1514-4edc-8265-80010957824c-3","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/ui.js","offset":250,"limit":50}},{"type":"tool_use","id":"call-b83abaec-1514-4edc-8265-80010957824c-4","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs","offset":300,"limit":180}},{"type":"tool_use","id":"call-b83abaec-1514-4edc-8265-80010957824c-5","name":"grep","input":{"pattern":"input\\.repeat[^('\\\"a-zA-Z]","glob":"**/game/ui.js"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":6175,"output_tokens":376,"cache_read_input_tokens":28544,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"915ccd26-c67f-40e1-9994-e37071589b8e"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-b83abaec-1514-4edc-8265-80010957824c-3","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n    const k = keys[this.i];\\n280→    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n290→    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\",\"content_concise\":\"250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n    const k = keys[this.i];\\n280→    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n290→    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/ui.js\",\"offset\":250,\"limit\":50,\"raw_output\":\"      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n    const k = keys[this.i];\\n    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n\",\"total_lines\":368}}","is_error":false},{"type":"tool_result","tool_use_id":"call-b83abaec-1514-4edc-8265-80010957824c-4","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"300→add('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(game.time < 10, 'time ' + game.time);\\n  let guard = 0;\\n310→  while (game.time < 10 && guard++ < 40) game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.attract, 'not attract at ' + game.time + ' idle ' + G.idleSteps);\\n  assert(game.time >= 9.999, 'early ' + game.time);\\n  game.advance(0.4);\\n  assert(G.profile.minutes === minutes, 'attract awarded minutes');\\n  assert(G.profile.unlocks.join() === unlocks.join(), 'attract unlocked');\\n  assert(JSON.stringify(game.saves._mem) === memBefore, 'attract wrote a save');\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n320→  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const rowStep = function (code) {\\n    const beforeI = G.dev.i;\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n340→    const n = G.dev.keys.length;\\n    const moved = (beforeI - G.dev.i + n) % n;\\n    assert(moved === 1, code + ' rows ' + beforeI + ' -> ' + G.dev.i);\\n  };\\n  rowStep('ArrowUp');\\n  rowStep('Pad12');\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n350→  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.i === 0, 'slider not home ' + G.dev.i);\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n360→  game.advance(1 / 120);\\n  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n370→  game.advance(1 / 120);\\n  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n380→  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n390→    const want = G.dev.keys.indexOf(key);\\n    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n400→  tapCode('ArrowRight');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n410→  const botAt = G.dev.tools.indexOf('Bot: good');\\n  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n420→  const offAt = G.dev.tools.indexOf('Bot: off');\\n  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n430→  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n440→  assert(olives.length > 0, 'no olives');\\n  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n450→  const rs0 = G.dev.v.ropeS;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n460→\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n470→  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\",\"content_concise\":\"300→add('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(g