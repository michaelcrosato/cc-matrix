n    if (this.game.headless) return null;\\n    try { return localStorage.getItem('my3d2dge:' + this._key(slot)); } catch (e) { return null; }\\n  }\\n  _put(slot, text) {\\n    this._mem[slot] = text; if (this.game.headless) return true;\\n    try { if (text === null) localStorage.removeItem('my3d2dge:' + this._key(slot)); else localStorage.setItem('my3d2dge:' + this._key(slot), text); return true; }\\n    catch (e) { if (!this.blocked) warn('saves:blocked', 'game.saves: storage is blocked or full: the saves last for this visit'); this.blocked = true; return false; }\\n  }\\n  /** a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer:\\n   *  true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version } */\\n  get(slot) {\\n    if (!this._ok(slot)) return null;\\n    const t = this._raw(slot); if (t === null || t === undefined) return null;\\n    let s; try { s = JSON.parse(t); } catch (e) { s = null; }\\n    if (!s || typeof s !== 'object' || s.v !== SAVE_FORMAT || !('data' in s)) return { slot, damaged: true };\\n    const out = { slot, data: s.data, place: typeof s.place === 'string' ? s.place : '', level: s.level === undefined ? null : s.level, time: +s.time || 0, at: +s.at || 0, version: +s.version || 1 };\\n    if (out.version > this.version) out.newer = true;\\n    return out;\\n  }\\n  /** every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows) */\\n  list() { return ['auto'].concat(Array.from({ length: this.slots }, (_, i) => i)).map(slot => Object.assign({ slot, empty: false }, this.get(slot) || { empty: true })); }\\n  /** save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\\n   *  (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save */\\n  save(slot, o) {\\n    if (!this._ok(slot)) { warn('saves:slot:' + slot, 'game.saves: no slot ' + slot + ' (0 to ' + (this.slots - 1) + ', or \\\"auto\\\")'); return false; }\\n    if (!o && this.write) try { o = this.write(slot); } catch (e) { this.game.fail('saves.write', e); return false; }\\n    if (!o || !('data' in o)) { warn('saves:write', 'game.saves: nothing to save: give save(slot, { data, place, level }) or set saves.write'); return false; }\\n    let text; try { text = JSON.stringify({ v: SAVE_FORMAT, version: this.version, data: o.data, place: o.place || '', level: o.level === undefined ? null : o.level, time: Math.round(this.played * 10) / 10, at: Date.now() }); }\\n    catch (e) { this.game.fail('saves.save', e); return false; }\\n    this._put(slot, text); return true;\\n  }\\n  /** save to the autosave (what write() gives) */\\n  autosave(o) { return this.save('auto', o); }\\n  /** load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save\\n   *  ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version */\\n  load(slot) {\\n    const s = this.get(slot); if (!s || s.damaged || s.newer) return null;\\n    if (s.version < this.version && this.migrate) try { s.data = this.migrate(s.data, s.version); } catch (e) { this.game.fail('saves.migrate', e); return null; }\\n    this.played = s.time;\\n    if (this.read) try { this.read(s); } catch (e) { this.game.fail('saves.read', e); return null; }\\n    return s;\\n  }\\n  /** copy a slot's save onto another (over what is there); false when the first is empty */\\n  copy(from, to) { if (!this._ok(from) || !this._ok(to)) return false; const t = this._raw(from); if (t === null || t === undefined) return false; this._put(to, t); return true; }\\n  /** erase a slot */\\n  erase(slot) { if (this._ok(slot)) this._put(slot, null); }\\n  /** is there any save to load (a title's Continue)? */\\n  get any() { return this.list().some(s => !s.empty && !s.damaged && !s.newer); }\\n  /** the most recent save that loads, or null (a title's Continue loads it) */\\n  latest() { return this.list().filter(s => !s.empty && !s.damaged && !s.newer).sort((a, b) => b.at - a.at)[0] || null; }\\n  /** open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or\\n   *  a save. False without a menu (a headless game, menu: false) */\\n  show(mode = 'load', done) {\\n    const sh = this.game.shell; if (!sh || !sh._menu()) return false;\\n    const T = s => { const m = Math.floor(s.time / 60); return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0'); };\\n    const name = slot => slot === 'auto' ? 'Autosave' : 'Slot ' + (slot + 1);\\n    const about = s => s.empty ? 'Empty' : s.damaged ? 'Damaged: it cannot be read' : s.newer ? 'From a newer version of the game' : [s.place, s.level !== null ? 'Level ' + s.level : '', T(s), s.at ? new Date(s.at).toLocaleDateString() : ''].filter(Boolean).join(' · ');\\n    const page = () => sh.show('saves', { kicker: mode === 'save' ? 'Save' : 'Load', title: mode === 'save' ? 'Save your game' : 'Load a game', text: this.blocked ? 'Saving is blocked here: these saves last for this visit.' : '',\\n      actions: this.list().filter(s => mode === 'load' || s.slot !== 'auto').map(s => ({ label: name(s.slot) + ' — ' + about(s), fn: () => slot(s) })).concat([['Back', () => sh.back()]]) });\\n    const ask = (title, text, label, fn) => sh.show('confirm', { kicker: 'Save', title, text, actions: [{ label: 'Keep it', fn: () => sh.back() }, { label, fn: () => { sh.back(); fn(); } }] });\\n    const saved = () => { sh.toast('Saved', name(this._last)); if (done) done(this.get(this._last)); };\\n    const slot = s => {\\n      const acts = [];\\n      if (mode === 'save' && s.slot !== 'auto') acts.push({ label: 'Save here', primary: true, fn: () => {\\n        const go = () => { this._last = s.slot; this.save(s.slot); page(); saved(); };\\n        if (s.empty) { sh.