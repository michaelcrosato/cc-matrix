aim(this); return this; }\\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\\n  this._lobby = this._join.keys && this.screen.canvas ? new Input(_pStub(this), { join: ['Digit2'] }) : null;   // (listens for 2 while player 1 has the whole keyboard)\\n3760→  _pClaim(this); return this;\\n};\\n/** a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the\\n *  left). Returns its input (null when four play already) */\\nGame.prototype.addPlayer = function (o = {}) {\\n  const P = this.players; if (P.length >= 4) return null;\\n  const q = new Input(_pStub(this), Input.DEFAULT), n = P.length + 1;\\n  Object.assign(q, { player: n, name: 'P' + n, color: E.PLAYER_COLORS[n - 1], pad: typeof o.pad === 'number' ? o.pad : null, half: o.keys ? 'right' : null, device: o.keys ? 'keyboard' : 'gamepad' });\\n  for (const k of ['glyphs', 'deadzone', 'invertAimY', 'invertMoveX', 'invertMoveY', 'rumbleScale']) q[k] = this.input[k];   // (the player's settings: button symbols, dead zone, aim, the move stick, vibration)\\n  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\\n3770→  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\\n  q.use(_pPreset(this, q));\\n  if (!this.settings.spec('playerBindings')) this.settings.define({ key: 'playerBindings', group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { for (const p of g.players.slice(1)) p.bindings = (v || {})[p.player] || {}; } });\\n  q.bindings = (this.settings.playerBindings || {})[n] || {};\\n  q._onBindings = b => this.settings.set('playerBindings', Object.assign({}, this.settings.playerBindings, { [n]: b }));\\n  P.push(q); _pClaim(this);\\n  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\\n  this.note(q.name + ' JOINED', 1.5); this.audio.sfx('confirm');\\n  return q;\\n};\\n3780→/** a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it */\\nGame.prototype.removePlayer = function (p) {\\n  const P = this.players, i = typeof p === 'number' ? p - 1 : P.indexOf(p); if (i < 1 || i >= P.length) return;\\n  P.splice(i, 1); P.forEach((q, k) => { q.player = k + 1; q.name = 'P' + (k + 1); q.color = E.PLAYER_COLORS[k]; });\\n  const I = P[0]; if (I.half && !P.some(q => q !== I && q.half)) { I.half = null; I.use(I._full || I.preset); I._full = null; }\\n  _pClaim(this);\\n};\\n/** split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide\\n *  screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 } */\\nGame.prototype.splitScreen = function (n, o = {}) {\\n3790→  if (!(n >= 2)) { this._split = null; return this; }\\n  const prev = this._split, vps = Array.from({ length: Math.min(4, n) }, (_, i) => (prev && prev.vps[i]) || _vp(i));\\n  this._split = { layout: o.layout || 'auto', gap: o.gap === undefined ? 1 : o.gap, vps };\\n  if (o.follow) o.follow.forEach((t, i) => vps[i] && vps[i].follow(t, o));\\n  _vpLayout(this); return this;\\n};\\n// a viewport: where it is on the screen, and its camera (as game.cam: a focus it eases to, the bounds of game.cam)\\nfunction _vp(i) {\\n  const v = { i, x: 0, y: 0, w: 0, h: 0, target: null, z: 16, cam: { tx: 0, ty: 0, tz: 0, x: undefined, y: 0, vx: 0, vy: 0, smooth: .12, snap: true, bounds: null } };\\n  /** look at a world point */\\n3800→  v.focus = (x, y, z = 0) => { v.target = null; Object.assign(v.cam, { tx: x, ty: y, tz: z }); };\\n  /** keep the camera on an object ({ x, y, z }); o.z: the height looked at (16) */\\n  v.follow = (t, o = {}) => { v.target = t || null; if (o.z !== undefined) v.z = o.z; v.cam.snap = true; };\\n  return v;\\n}\\nfunction _vpLayout(game) {\\n  const S = game._split, n = S.vps.length, W = game.screen.W, H = game.screen.H, g = S.gap;\\n  const mode = S.layout === 'auto' ? (n > 2 ? 'grid' : W >= H ? 'columns' : 'rows') : S.layout;\\n  S.vps.forEach((v, i) => {\\n    const [c, r, cols, rows] = mode === 'grid' ? [i % 2, Math.floor(i / 2), 2, 2] : mode === 'rows' ? [0, i, 1, n] : [i, 0, n, 1];\\n3810→    const x0 = Math.round(c * W / cols), x1 = Math.round((c + 1) * W / cols), y0 = Math.round(r * H / rows), y1 = Math.round((r + 1) * H / rows);\\n    Object.assign(v, { x: x0 + (c ? g : 0), y: y0 + (r ? g : 0), w: x1 - x0 - (c ? g : 0), h: y1 - y0 - (r ? g : 0) });\\n  });\\n}\\nfunction _vpCam(game, v, dt) {   // (game.cam's rules in the viewport's size: centred on its focus, inside the bounds, eased)\\n  const c = v.cam, t = v.target; if (t) { c.tx = t.x; c.ty = t.y || 0; c.tz = (t.z || 0) + v.z; }\\n  const [sx, sy] = game.view.p(c.tx, c.ty, c.tz), bf = c.bounds || game.cam.bounds, b = bf && bf(game.view);\\n  let tx = sx - v.w / 2, ty = sy - v.h / 2;\\n  if (b) { tx = b.x1 - b.x0 < v.w ? (b.x0 + b.x1 - v.w) / 2 : clamp(tx, b.x0, b.x1 - v.w); ty = b.y1 - b.y0 < v.h ? (b.y0 + b.y1 - v.h) / 2 : clamp(ty, b.y0, b.y1 - v.h); }\\n  if (c.snap || c.x === undefined || !(c.smooth > 0)) { c.x = tx; c.y = ty; c.vx = c.vy = 0; c.snap = false; return; }\\n3820→  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\\n}\\n// each step: the other players' inputs, a pause by any of them, a lost controller, and joining\\nHOOKS.input.push((game, dt) => {\\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\\n  for (const q of P.slice(1)) {\\n    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\\n    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\\n  }\\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\\n3830→  if (I.pressed('pause')) game.pausedBy = 1;\\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === 'gamepad' && was[1] === p.index)) continue;\\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\\n    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host's)\\n    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\\n    game.addPlayer({ pad: p.index });\\n3840→  }\\n});\\nHOOKS.enter.push(game => {   // a scene's start: the others take its keys too (a half each where they share the keyboard); a split ends\\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\\n});\\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\\n