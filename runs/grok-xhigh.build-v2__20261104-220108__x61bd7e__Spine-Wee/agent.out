"content\":\"    const c = 'Act:' + a, d = this.lastDevice; if (on) { this._holds.add(c); this.press(c); } else { this._holds.delete(c); this.release(c); }\"},{\"line_number\":1039,\"content\":\"    this.lastDevice = d;   // (no device either; and a tap of a held action leaves it held)\"},{\"line_number\":1067,\"content\":\"  consumeAll() { for (const a in this.map) this._used[a] = true; this._now.clear(); this._fresh.clear(); this._freshCodes.clear(); this._clickAt = this._click = null; }\"},{\"line_number\":1074,\"content\":\"    this.held.clear(); this._holds.clear(); this.consumeAll(); this._nowUp.clear(); this._freshUp.clear(); this._pt = {}; this._rk = {}; this._down = null;\"},{\"line_number\":1097,\"content\":\"   *  it; a HUD button of your own can: if (hit(input.clicked())) ... */\"},{\"line_number\":1098,\"content\":\"  clicked() { return this._clickAt; }\"},{\"line_number\":1106,\"content\":\"  pointer() { return this._fedAt || (this.mouse.active ? this.screenPoint(this.mouse.cx, this.mouse.cy) : null); }\"},{\"line_number\":1175,\"content\":\"      if (!p && this.padIndex !== null) { this.padLost = this.lastDevice === 'gamepad'; this.stopRumble(); }   // unplugged while in use\"},{\"line_number\":1190,\"content\":\"      if (this.padAim || Math.hypot(...this.padMove) > 0) { this.aimSource = 'pad'; this.lastDevice = 'gamepad'; }\"},{\"line_number\":1247,\"content\":\"    this.screen.canvas.setPointerCapture(e.pointerId); this.aimSource = 'move'; this.lastDevice = 'touch';\"},{\"line_number\":1782,\"content\":\"  /** what was drawn under a screen point (the HUD's pixels: input.clicked(), input.pointer()) in the last frame, front to\"},{\"line_number\":2663,\"content\":\"    if (this.input.lastDevice === 'gamepad' && o.rumble !== false) this.input.rumble(.2 + .2 * Math.min(2, p), .06 + .03 * p);\"},{\"line_number\":2982,\"content\":\"    const p = I.pointer(), e = F.edge === undefined ? 10 : F.edge;\"},{\"line_number\":2983,\"content\":\"    if (e > 0 && p