"body\\\":[0,86,0], \\\"chest\\\":[0,-6,0], \\\"head\\\":[0,3,0],\\n   \\\"shL\\\":[0,0], \\\"shR\\\":[0,0], \\\"armL\\\":[90,41,15,111,-20], \\\"armR\\\":[90,41,15,111,20],\\n   \\\"legL\\\":[5,0,-100,13,-2], \\\"legR\\\":[5,0,-100,13,2], \\\"footL\\\":[-14,0,48], \\\"footR\\\":[-14,0,48]},\\n  {\\\"t\\\":0.6,\\n   \\\"hips\\\":[-4,0,35], \\\"body\\\":[0,93,0], \\\"chest\\\":[0,-1,0], \\\"head\\\":[0,-7,0],\\n   \\\"shL\\\":[0,0], \\\"shR\\\":[0,0], \\\"armL\\\":[72,55,42,133,-11], \\\"armR\\\":[72,55,42,133,11],\\n   \\\"legL\\\":[11,0,-99,13,-2], \\\"legR\\\":[11,0,-99,13,2], \\\"footL\\\":[-21,0,48], \\\"footR\\\":[-21,0,48]},\\n  {\\\"t\\\":0.767,\\n\",\"total_lines\":2338}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"fe20c6e8-d925-455d-8746-01dcb1e59b64"}
