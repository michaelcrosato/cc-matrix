if (scenes.play._hold <= 0) {\"},{\"line_number\":614,\"content\":\"            scenes.play._hold = 0.4;\"},{\"line_number\":615,\"content\":\"            doneSession();\"},{\"line_number\":620,\"content\":\"        const it = scenes.play._done.update(G.game.input);\"},{\"line_number\":622,\"content\":\"        if (it.id === 'again') { s.again(); scenes.play._pills.i = 0; }\"},{\"line_number\":623,\"content\":\"        else doneSession();\"},{\"line_number\":632,\"content\":\"      if (s && s.phase === 'card') scenes.play._pills.draw(r);\"},{\"line_number\":633,\"content\":\"      if (s && s.phase === 'results' && !s.autoNext && !G.attracting) scenes.play._done.draw(r);\"},{\"line_number\":638,\"content\":\"  scenes.evening = base({\"},{\"line_number\":641,\"content\":\"      scenes.evening._pills = new G.Pills([{ label: 'Good night', id: 'bed' }], { i: 0 });\"},{\"line_number\":647,\"content\":\"      const it = scenes.evening._pills.update(G.game.input);\"},{\"line_number\":653,\"content\":\"      scenes.evening._pills.draw(r);\"},{\"line_number\":657,\"content\":\"  scenes.bed = base({\"},{\"line_number\":659,\"content\":\"      scenes.bed.t = 0;\"},{\"line_number\":665,\"content\":\"      scenes.bed.t += dt;\"},{\"line_number\":667,\"content\":\"      G.left = Math.max(0, 2 - scenes.bed.t);\"},{\"line_number\":668,\"content\":\"      if (scenes.bed.t < 2) return;\"},{\"line_number\":687,\"content\":\"  scenes.games = base({\"},{\"line_number\":700,\"content\":\"  scenes.duel = base({\"},{\"line_number\":703,\"content\":\"      scenes.duel.gert = 1;\"},{\"line_number\":704,\"content\":\"      scenes.duel.done = false;\"},{\"line_number\":714,\"content\":\"      if (s.playTime > 75 && flame > 0.5) scenes.duel.gert = Math.max(0.3, scenes.duel.gert - dt * 0.35);\"},{\"line_number\":717,\"content\":\"      if (s.phase === 'results' && !scenes.duel.done) {\"},{\"line_number\":718,\"content\":\"        scenes.duel.done = true;\"},{\"line_number\":719,\"content\":\"        const win = flame >= scenes.duel.gert;\"},{\"line_number\":731,\"content\":\"        G.text(g, 'Gertrude ' + Math.round(scenes.duel.gert * 100), r.W - 90, 6, '#5f7f8a', 1);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"82e275b5-3db8-42a0-a3df-e6fb1b6c97ea"}
