2368,\"content\":\"    this.time = 0; this.real = 0; this.hitstop = 0; this.timeScale = 1; this._shakeAmt = 0; this.reduceMotion = !this.headless && !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);\"},{\"line_number\":2387,\"content\":\"    this.particles = new Particles(this); this.lights = new Lighting(this); this.r = this.headless && !o.draw ? null : new Renderer(this);   // (draw: true, headless: a stand-in renderer)\"},{\"line_number\":2409,\"content\":\"    if (this.headless) this.audio.failed = 'a headless game has no sound';\"},{\"line_number\":2433,\"content\":\"    if (!this.headless) this._standard(signal);\"},{\"line_number\":2447,\"content\":\"  enableGPU(o = {}) { if (this.headless) return null; this.gpu = new GPULighting(this, o); return this.gpu; }\"},{\"line_number\":2585,\"content\":\"    if (this.headless) return false; if (fs.on) return true;\"},{\"line_number\":2791,\"content\":\"    const live = !this.headless && this.o.loop !== false && hooks.boot !== false && typeof document !== 'undefined';\"},{\"line_number\":2839,\"content\":\"   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\"},{\"line_number\":2846,\"content\":\"    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\"},{\"line_number\":3014,\"content\":\"    if (!this.headless && !BOOT.played && !this._booting && (this._drawn = (this._drawn || 0) + 1) >= 2) BOOT._finish();   // play has begun (two frames drawn under the boot screen: the caches are warm; a headless game's has none)\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"582036d5-aadb-4a49-92d2-75da152489c1"}
