56,\"content\":\"    skiSpeed: 220, skiTurn: 1.6, trayG: 420, trayFric: 3, ropeS: 16, gust: 9,\"},{\"line_number\":163,\"content\":\"    jogSpeed: 'jog speed', skiSpeed: 'ski speed', skiTurn: 'ski turn', trayG: 'tray gravity', trayFric: 'tray friction',\"},{\"line_number\":164,\"content\":\"    ropeS: 'rope instability', gust: 'gust', timeScale: 'time scale', minutesMul: 'minutes'\"},{\"line_number\":169,\"content\":\"    tool: 0, pose: 'stork', poseI: 0, poseT: 0, poseMode: false, printed: '', frame: false, bot: null, trace: false, noStumble: false,\"},{\"line_number\":190,\"content\":\"      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\"},{\"line_number\":197,\"content\":\"  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot', 'Jump'];\"},{\"line_number\":198,\"content\":\"  G.dev.tools = TOOLS;\"},{\"line_number\":284,\"content\":\"    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\"},{\"line_number\":287,\"content\":\"  G.dev.toolAct = function (i) {\"},{\"line_number\":295,\"content\":\"    else if (i === 6) this.bot = 'good';\"},{\"line_number\":296,\"content\":\"    else if (i === 7) this.bot = null;\"},{\"line_number\":302,\"content\":\"    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\"},{\"line_number\":354,\"content\":\"      text(g, TOOLS[self.tool] || '', 8, r.H - 16, '#14a8c8', 1);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/rigs.js\",\"matches\":[{\"line_number\":79,\"content\":\"    look = look || { hair: 'short', skin: '#f6d3bd', top: '#ff7a59', bottom: '#355f86' };\"},{\"line_number\":80,\"content\":\"    return { size: size || 2.1, build: 'chibi', seed: 3, hair: look.hair || 'short', colors: { cloth: look.top || '#ff7a59', pants: look.bottom || '#355f86', skin: look.skin || '#f6d3bd', hair: '#6a4030' } };\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/data/lines.js\",\"matches\":[{\"line_number\":88,\"content\":\"    'Most Still is a compliment. Best Wobble is also a compliment. I wrote both.',\"},{\"line_number\":95,\"content\":\"    'I can see the others as ghosts. They are fine. They are trying.',\"},{\"line_number\":136,\"content\":\"    'The bead goes down. You go down. We meet at the bottom, ideally.',\"},{\"line_number\":140,\"content\":\"    'Hold the bottom. The bottom is a place, not a feeling.',\"},{\"line_number\":251,\"content\":\"    'One and me are both acceptable. I wrote them myself.',\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/data/content.js\",\"matches\":[{\"line_number\":80,\"content\":\"    bottom: ['#355f86', '#5f7f8a', '#c9865a', '#3d4a3e']\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/balance.js\",\"matches\":[{\"line_number\":62,\"content\":\"        this.bnx = noise(br, .35); this.bny = noise(br, .35 * 1.17); this.bot = b;\"},{\"line_number\":65,\"content\":\"    /* One fixed step. ux, uy are the player's lean (ignored while a skill bot owns the body, and while stumbling).\"},{\"line_number\":86,\"content\":\"        if (this.skill && this.bot) {\"},{\"line_number\":87,\"content\":\"          const lag = Math.max(0, this.hist.length - 1 - Math.round(this.bot.tau / dt));\"},{\"line_number\":89,\"content\":\"          const tx = cx - this.bot.gain * (seen.x - cx) - this.bot.damp * seen.vx + this.bot.noise * this.bnx(this.t);\"},{\"line_number\":90,\"content\":\"          const ty = cy - this.bot.gain * (seen.y - cy) - this.bot.damp * seen.vy + this.bot.noise * this.bny(this.t);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/boot.js\",\"matches\":[{\"line_number\":150,\"content\":\"    if (!next.look) next.look = { hair: 0, skin: 1, top: 0, bottom: 0 };\"},{\"line_number\":163,\"content\":\"      const gh = { t: 'g', a: d.a, l: d.l, p: d.p, w: d.w, s: d.s, from: from, name: String(from || 'ghost'), color: '#8fd3f4' };\"},{\"line_number\":164,\"content\":\"      const i = G.ghosts.findIndex(function (q) { return q.from === from; });\"},{\"line_number\":165,\"content\":\"      if (i >= 0) G.ghosts[i] = gh;\"},{\"line_number\":166,\"content\":\"      else G.ghosts.push(gh);\"},{\"line_number\":167,\"content\":\"      if (G.ghosts.length > 8) G.ghosts.shift();\"},{\"line_number\":171,\"content\":\"      G.ghosts = G.ghosts.filter(function (q) { return q.from !== id; });\"},{\"line_number\":176,\"content\":\"    const pending = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\"},{\"line_number\":200,\"content\":\"    G.driver = null;\"},{\"line_number\":211,\"content\":\"    G.ghosts = [];\"},{\"line_number\":223,\"content\":\"    if (G.dev) { G.dev.panel = false; G.dev.on = false; G.dev.tool = 0; G.dev.bot = null; }\"},{\"line_number\":245,\"content\":\"            G.driver = null;\"},{\"line_number\":293,\"content\":\"        G.driver = null;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js\",\"matches\":[{\"line_number\":28,\"content\":\"  G.driver = null;\"},{\"line_number\":36,\"content\":\"  G.ghosts = [];\"},{\"line_number\":46,\"content\":\"      look: { hair: 0, skin: 1, top: 0, bottom: 0 },\"},{\"line_number\":76,\"content\":\"      bottom: L.bottom[k.bottom] || L.bottom[0]\"},{\"line_number\":159,\"content\":\"  G.setDriver = function (name) { G.driver = name || null; };\"},{\"line_number\":183,\"content\":\"      speed: 1e6, lines: 3, place: 'bottom', color: '#20404c', nameColor: '#14a8c8',\"},{\"line_number\":309,\"content\":\"        { label: 'Bottom', id: 'bottom', n: L.bottom.length },\"},{\"line_number\":509,\"content\":\"      id: it.id, tier: tier, trial: false, driver: G.driver, seed: (G.profile.day * 100 + G.profile.sessions * 7 + tier) >>> 0\"},{\"line_number\":566,\"content\":\"    if (G.queue && G.queue.length) { const id = G.queue.shift(); go('play', { id: id, tier: G.profile.day >= 4 ? 2 : 1, limit: 20, skipToPlay: true, autoNext: true, driver: G.driver || 'good', trial: !!G.attracting }); return; }\"},{\"line_number\":578,\"content\":\"      if (d.driver) G.driver = d.driver;\"},{\"line_number\":584,\"content\":\"        driver: d.driver || G.driver,\"},{\"line_number\":600,\"content\":\"      if (G.driver && s.phase !== 'results') s.driver = G.driver;\"},{\"line_number\":692,\"content\":\"      G.driver = G.driver || 'good';\"},{\"line_number\":694,\"content\":\"      go('play', { id: id, tier: 1, limit: 20, skipToPlay: true, autoNext: true, driver: G.driver, trial: false, seed: 11 });\"},{\"line_number\":702,\"content\":\"      G.driver = G.driver || 'good';\"},{\"line_number\":705,\"content\":\"      G.session = new G.Session({ id: 'candle', tier: 2, limit: 90, skipToPlay: true, driver: G.driver, seed: 19, trial: false });\"},{\"line_number\":711,\"content\":\"      s.driver = G.driver;\"},{\"line_number\":768,\"content\":\"    G.driver = 'expert';\"},{\"line_number\":776,\"content\":\"      G.driver = 'expert';\"},{\"line_number\":781,\"content\":\"        G.session = new G.Session({ id: id, tier: id === 'stork' ? 2 : 1, limit: 12, skipToPlay: true, trial: true, cheat: true, driver: 'expert', autoNext: true, seed: 3 + G.attractI });\"},{\"line_number\":817,\"content\":\"      G.driver = null;\"},{\"line_number\":842,\"content\":\"          botFill: !local,\"},{\"line_number\":953,\"content\":\"  /* A hub ghost is a translucent rig posed from the lean and the extra wobble it sent. */\"},{\"line_number\":955,\"content\":\"    if (!r || !r.actor || !G.ghosts || !G.makeRig) return;\"},{\"line_number\":957,\"content\":\"    G.ghosts.forEach(function (gh, i) {\"},{\"line_number\":968,\"content\":\"        r.actor(-8 + i * 4.5, 8, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); }, { alpha: 0.5, outline: false });\"},{\"line_number\":977,\"content\":\"      G.ghosts = [];\"},{\"line_number\":1013,\"content\":\"          if (!G.attracting) G.driver = null;\"},{\"line_number\":1029,\"content\":\"          const b = s && s.seats && s.seats[0] && s.seats[0].bal;\"},{\"line_number\":1060,\"content\":\"        G.ghosts.forEach(function (gh, i) {\"},{\"line_number\":1062,\"content\":\"          G.text(g, gh.name || 'ghost', 20 + i * 40, 60, gh.color || '#ffffff', 1);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"matches\":[{\"line_number\":12,\"content\":\"  function skillName(seat) {\"},{\"line_number\":13,\"content\":\"    if (G.dev && G.dev.on && G.dev.bot && seat && seat.local && G.BOTS[G.dev.bot]) return G.dev.bot;\"},{\"line_number\":14,\"content\":\"    const d = G.driver && G.driver !== 'human' ? G.driver : (seat && seat.skill);\"},{\"line_number\":35,\"content\":\"    if (!skill) { bal.skill = null; bal.bot = null; return; }\"},{\"line_number\":36,\"content\":\"    if (bal.skill === skill && bal.bot) return;\"},{\"line_number\":43,\"content\":\"    bal.bot = b;\"},{\"line_number\":46,\"content\":\"  /* A seat's hands. A named skill drives the activity bots. A hold skill is applied on the balance itself. */\"},{\"line_number\":48,\"content\":\"    const skill = skillName(seat);\"},{\"line_number\":49,\"content\":\"    const human = !skill && !(G.driver === 'passive' || (seat && seat.skill === 'passive'));\"},{\"line_number\":88,\"content\":\"      seat.botPh = (seat.botPh || 0) + w * dt * (fam.otherWay ? -1 : 1);\"},{\"line_number\":89,\"content\":\"      seat.ux = Math.cos(seat.botPh); seat.uy = Math.sin(seat.botPh);\"},{\"line_number\":155,\"content\":\"    const act = sess.act, tier = sess.tier, seat = sess.seats[0];\"},{\"line_number\":157,\"content\":\"    const skill = skillName(seat);\"},{\"line_number\":162,\"content\":\"        const sk = skillName(q);\"},{\"line_number\":252,\"content\":\"    const seat = sess.seats[0];\"},{\"line_number\":255,\"content\":\"    if (act.family === 'hold') stepHold(sess, dt);\"},{\"line_number\":258,\"content\":\"    else if (act.family === 'rep') stepRep(sess, dt);\"},{\"line_number\":259,\"content\":\"    else if (act.family === 'step') stepStep(sess, dt);\"},{\"line_number\":260,\"content\":\"    else if (act.family === 'hoop') stepHoop(sess, dt);\"},{\"line_number\":272,\"content\":\"  function stepHold(sess, dt) {\"},{\"line_number\":282,\"content\":\"    const list = many ? sess.seats : [sess.seats[0]];\"},{\"line_number\":286,\"content\":\"      arm(bal, skillName(seat));\"},{\"line_number\":298,\"content\":\"    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\"},{\"line_number\":300,\"content\":\"    arm(bal, skillName(seat));\"},{\"line_number\":301,\"content\":\"    if (skillName(seat)) seat.breath = fam.guide;\"},{\"line_number\":303,\"content\":\"    const breath = seat.local && !skillName(seat) ? leanFor(seat).breath : seat.breath;\"},{\"line_number\":314,\"content\":\"    arm(bal, skillName(seat));\"},{\"line_number\":350,\"content\":\"    const list = many ? sess.seats : [sess.seats[0]];\"},{\"line_number\":359,\"content\":\"  function stepRepOne(sess, seat, store, dt, primary) {\"},{\"line_number\":395,\"content\":\"  function stepRep(sess, dt) {\"},{\"line_number\":402,\"content\":\"    const list = many ? sess.seats : [sess.seats[0]];\"},{\"line_number\":406,\"content\":\"      stepRepOne(sess, seat, store, dt, i === 0);\"},{\"line_number\":444,\"content\":\"    const skill = skillName(seat);\"},{\"line_number\":451,\"content\":\"        if (n.j || n.call || n._bot) continue;\"},{\"line_number\":453,\"content\":\"        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\"},{\"line_number\":463,\"content\":\"  function stepStep(sess, dt) {\"},{\"line_number\":464,\"content\":\"    const fam = sess.fam, rh = fam.rh, seat = sess.seats[0];\"},{\"line_number\":466,\"content\":\"    const skill = skillName(seat);\"},{\"line_number\":473,\"content\":\"        if (n.j || n.call || n._bot) continue;\"},{\"line_number\":475,\"content\":\"        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\"},{\"line_number\":493,\"content\":\"  function stepHoopOne(sess, seat, box, rng, dt, primary) {\"},{\"line_number\":535,\"content\":\"  function stepHoop(sess, dt) {\"},{\"line_number\":537,\"content\":\"    const list = many ? sess.seats : [sess.seats[0]];\"},{\"line_number\":542,\"content\":\"      stepHoopOne(sess, seat, box, rng, dt, i === 0);\"},{\"line_number\":547,\"content\":\"    const fam = sess.fam, seat = sess.seats[0];\"},{\"line_number\":579,\"content\":\"    const fam = sess.fam, seat = sess.seats[0];\"},{\"line_number\":618,\"content\":\"    const fam = sess.fam, seat = sess.seats[0];\"},{\"line_number\":622,\"content\":\"    const sk = skillName(seat);\"},{\"line_number\":629,\"content\":\"    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\"},{\"line_number\":655,\"content\":\"    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\"},{\"line_number\":656,\"content\":\"    const skill = skillName(seat);\"},{\"line_number\":663,\"content\":\"       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\"},{\"line_number\":664,\"content\":\"    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\"},{\"line_number\":690,\"con