hidden = true; el.style.display = 'none'; } BOOT.el = null; return this.start(h); }\"},{\"line_number\":3311,\"content\":\"    if (live) { BOOT._open(this, o); BOOT._checks(this); }\"},{\"line_number\":3314,\"content\":\"    const fail = (label, e) => { this._booting = false; this.bootError = e; this.fail('boot step \\\"' + label + '\\\"', e); BOOT.fail('boot step \\\"' + label + '\\\"', e); res(this); };\"},{\"line_number\":3319,\"content\":\"        if (live) BOOT._step(i, n, label);\"},{\"line_number\":3321,\"content\":\"        const ok = () => { if (live) BOOT._line('  ' + (i + '. ').padEnd(4), label + ' · ' + Math.round(now() - s0) + ' ms'); };\"},{\"line_number\":3326,\"content\":\"      if (live) BOOT._step(n + 1, n + 1, 'Warming up');\"},{\"line_number\":3529,\"content\":\"    this.r._finish();\"},{\"line_number\":3530,\"content\":\"    if (!this.headless && !BOOT.played && !this._booting && (this._drawn = (this._drawn || 0) + 1) >= 2) BOOT._finish();   // play has begun (two frames drawn under the boot screen: the caches are warm; a headless game's has none)\"},{\"line_number\":3729,\"content\":\" * 10c. BOOT  the start of every game, like a console's BIOS: the system checked, the renderer started, the game's own\"},{\"line_number\":3743,\"content\":\"const BOOT_MESSAGES = ['Reticulating splines', 'Snapping every pixel to the grid', 'Teaching skeletons to walk', 'Counting to 120, every second',\"},{\"line_number\":3746,\"content\":\"const BOOT_CSS = `#e3-boot{position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:space-between;gap:14px;background:#05040a;color:#a9a1c8;\"},{\"line_number\":3748,\"content\":\"#e3-boot.out{opacity:0;pointer-events:none}#e3-boot b{color:#f4f0ff;font-size:16px;letter-spacing:.08em}#e3-boot .ok{color:#8fd49a}#e3-boot .no{color:#e8a06a}\"},{\"line_number\":3749,\"content\":\"#e3-boot pre{margin:0;font:inherit;white-space:pre-wrap;word-break:break-word}#e3-boot .e3-bar{display:block;height:4px;max-width:440px;background:#ffffff14;margin:6px 0 4px;overflow:hidden}\"},{\"line_number\":3750,\"content\":\"#e3-boot .e3-bar i{display:block;height:100%;background:var(--e3-accent,#d9b77c);transition:width .2s}#e3-boot .e3-quip{color:var(--e3-accent,#d9b77c);font-style:italic}\"},{\"line_number\":3751,\"content\":\"#e3-boot[data-failed]{justify-content:flex-start;color:#e8dcd6}#e3-boot[data-failed] b{color:#ff8a7a}#e3-boot .e3-err{color:#ffd6d0;border-left:3px solid #ff5a5a;padding-left:10px;margin:8px 0}\"},{\"line_number\":3752,\"content\":\"#e3-boot button{font:600 13px system-ui,sans-serif;min-height:44px;padding:8px 16px;margin:10px 8px 0 0;border-radius:6px;border:1px solid #ffffff40;background:#ffffff14;color:#fff;cursor:pointer}\"},{\"line_number\":3753,\"content\":\"@media (prefers-reduced-motion:reduce){#e3-boot,#e3-boot .e3-bar i{transition:none}}`;\"},{\"line_number\":3757,\"content\":\"E.bootSplash = (title = '') => '<div id=\\\"e3-boot\\\" role=\\\"status\\\" style=\\\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\\\">'\"},{\"line_number\":3803,\"content\":\"Object.assign(BOOT, {\"},{\"line_number\":3807,\"content\":\"    if (!document.getElementById('e3-boot-css')) { const st = document.createElement('style'); st.id = 'e3-boot-css'; st.textContent = BOOT_CSS; document.head.appendChild(st); }\"},{\"line_number\":3808,\"content\":\"    let el = document.getElementById('e3-boot');\"},{\"line_number\":3809,\"content\":\"    if (!el) { el = document.createElement('div'); el.id = 'e3-boot'; el.setAttribute('role', 'status'); document.body.appendChild(el); }\"},{\"line_number\":3815,\"content\":\"    const msgs = o && o.messages === false ? [] : (o && o.messages) || BOOT_MESSAGES, pick = rng((Date.now() >>> 0) || 1), q = el.querySelector('.e3-quip');   // (its own random numbers: never the game's)\"},{\"line_num