eration = 'source-over'; sG.globalAlpha = 1; sG.clearRect(0, 0, this.bw, this.bh); sG.drawImage(cv, 0, 0); sG.globalCompositeOperation = 'destination-in'; sG.drawImage(this._eCv, 0, 0); sG.globalCompositeOperation = 'source-over'; }\\n          this._emis.sort((a, b) => a.k - b.k); for (const it of this._emis) it.fn(g);\\n2240→          if (this._emOn) g.drawImage(this._sCv, 0, 0);   // walls and bodies in front of a glow keep their lit pixels\\n        }\\n      }\\n      if (game._zoomTo && !vp) this._zoomPreview(game._zoomTo / game.zoom);\\n      for (const f of HOOKS.draw) f(game, this, g);\\n      for (const f of this._overlays) f(g);\\n      if (vp) { g.restore(); g._c = null; this._vp = null; return; }\\n      game.screen._present();\\n    }\\n  }\\n2250→}\\n\\n/* =============================================================================\\n * 9b. SPANS  r.queueSpan: a long piece of geometry queued a cell at a time, so each piece sorts at its own place. In a\\n *    section of its own: a kit whose game queues none leaves it out\\n * ============================================================================= */\\n/** queue a long piece of geometry (a wall, a fence, a roof's edge, drawn whole by fn(g)) a cell at a time from a to b\\n *  ([x, y] world units) at height z, h tall: each cell-long piece sorts at its own middle, clipped to its part, with\\n *  its box (as the engine's own walls are). o: queue's options, depth (its thickness across, 0), step (16 units) */\\nRenderer.prototype.queueSpan = function (a, b, z, h, fn, o = {}) {\",\"content_concise\":\"2190→      if (w > 0 && h > 0) {\\n        this._xrPrev = [x0, y0, x1, y1];\\n        const xG = this._xG, dst = gpu ? this._vG : g, mask = G => { G.save(); G.beginPath(); G.rect(x0, y0, w, h); G.clip(); G.globalCompositeOperation = 'destination-in'; G.drawImage(this._oCv, x0, y0, w, h, x0, y0, w, h); };\\n        // the hidden part: a translucent tint in the smooth style (E.style.trans 'alpha', the defau