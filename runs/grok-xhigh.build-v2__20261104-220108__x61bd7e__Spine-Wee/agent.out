0c) has run and it has started: await it in a\\n     *  test whose boot steps return promises */\\n2430→    this.booted = Promise.resolve(this);\\n    /** the error a boot step failed with (the game did not start), or null */\\n    this.bootError = null;\\n    if (!this.headless) this._standard(signal);\\n    E.current = this;   // handy for tools and tests: My3D2dge.current is the latest game\\n  }\\n  static _makeCanvas() {\\n    const c = document.createElement('canvas'); c.id = 'screen';\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js\",\"offset\":2388,\"limit\":50,\"raw_output\":\"    /** fps: frames drawn per second over the last half second of real time; hz: the display's refresh rate, measured;\\n     *  drawEvery: 1, or 2 while a fast display (a 120 Hz phone) refreshes quicker than the game can draw (a frame's cost,\\n     *  or refreshes missed: its GPU behind): every other refresh is drawn, evenly, instead of random ones missed (the\\n     *  updates still run every refresh). The player's Frame rate setting (game.settings.frameRate: 'auto', '60', 'full')\\n     *  can fix it at 2 or 1; gpu: the WebGPU lighting after enableGPU(), or null */\\n    this.fps = 60; this.hz = 60; this.drawEvery = 1; this._viewListeners = []; this.gpu = null;\\n    /** paused: true while paused (a pausable scene toggles it on 'pause'; steps still run, scenes don't update);\\n     *  pauseOverlay: false hides the engine's PAUSED overlay (a game drawing its own pause screen); errors: the\\n     *  errors caught in update and draw, each { where, scene, message, stack }, once per kind; live: true (o.live): a pause\\n     *  opens the menus over a world that keeps stepping (an online or shared world can't stop for one player): paused\\n     *  is true and the scene's update goes on, the menu holding the player's own input back */\\n    this.paused = false; this.pauseOverlay = true; this._timers = []; this.errors = []; this._errKeys = new Set(); this.live = !!o.live; this._goOn = false;\\n    /** the E.Shell over this game (an HTML interface: screens and HUD), or null */\\n    this.shell = null;\\n    /** seconds for the dithered fade between scenes (0 = instant cuts) */\\n    this.fadeTime = .22; this._fade = null;\\n    /** scenes: the scenes given to start(), by name; scene: the scene running; sceneName: its name ('main' for a\\n     *  game started with one scene) */\\n    this.scenes = null; this.scene = null; this.sceneName = null; this._next = null; this._hooks = null;\\n    /** chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song) */\\n    this.audio = new ChipAudio(this, signal);\\n    if (this.headless) this.audio.failed = 'a headless game has no sound';\\n    /** a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }.\\n     *  tools/check.mjs prints snapshot() and tools/replay.mjs logs it at the end */\\n    this.debug = null;\\n    /** per-frame timings (ms) and counts, for profiling overlays. frameMs: the real time since the last frame;\\n     *  updateMs, renderMs: milliseconds the last frame spent updating and drawing; steps: the updates it ran; items:\\n     *  what it queued for drawing; actors: actors drawn; culled: actors skipped off screen */\\n    this.stats = { updateMs: 0, renderMs: 0, frameMs: 16.7, steps: 0, items: 0, actors: 0, culled: 0 };\\n    /** the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth\\n     *  at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count */\\n    this.alpha = .5; this._acc = this.o.step / 2;\\n    if ((this.input._never = this.o.touch === 'never')) this.input.touchEnabled = false;   // (a game that never shows touch controls)\\n    /** the player's choices (game.settings.volume, game.settings.set('volume', .5), your own from menu.settings), saved\\n     *  and applied (section 10b) */\\n    this.settings = new Settings(this, (this.o.menu && this.o.menu.settings) || []);\\n    /** full screen: game.fullscreen.toggle(), .on, .supported */\\n    this.fullscreen = new FullScreen(this);\\n    /** why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null */\\n    this.pauseReason = null;\\n    /** a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a\\n     *  test whose boot steps return promises */\\n    this.booted = Promise.resolve(this);\\n    /** the error a boot step failed with (the game did not start), or null */\\n    this.bootError = null;\\n    if (!this.headless) this._standard(signal);\\n    E.current = this;   // handy for tools and tests: My3D2dge.current is the latest game\\n  }\\n  static _makeCanvas() {\\n    const c = document.createElement('canvas'); c.id = 'screen';\\n\",\"total_lines\":14974}}","is_error":false},{"type":"tool_result","tool_use_id":"call-43698304-91b6-480e-b51e-b6da26d2d656-32","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"120→        this.vx += ax * dt; this.vy += ay * dt; this.px += this.vx * dt; this.py += this.vy * dt;\\n        if (!this.cheat && Math.hypot(this.px, this.py) >= L.stumbleAt) {\\n          this.stumble = 1; this.falls++;\\n          this.vx = 0; this.vy = 0;\\n          const h = Math.hypot(this.px, this.py) || 1; this.px /= h; this.py /= h;\\n        }\\n      }\\n      const dx = this.px - cx, dy = this.py - cy;\\n      if (this.stumble <= 0 && Math.hypot(dx, dy) < L.R) this.inside++;\\n      this.frames++;\\n130→      this.t += dt;\\n      this.trail.push({ x: this.px, y: this.py });\\n      if (this.trail.length > 120) this.trail.shift();\\n      return this;\\n    }\\n    get steadiness() { return this.frames ? this.inside / this.frames : 0; }\\n    get p() { return { x: this.px, y: this.py }; }\\n    get v() { return { x: this.vx, y: this.vy }; }\\n  }\\n  G.Balance = Balance;\\n140→  /* 45 s, the section 3 seeds. skill 'passive' holds still. raw constants, so a live slider cannot move the table. */\\n  G.bandTrial = function (name, skill, seed) {\\n    const set = G.SETS[name];\\n    const b = new Balance(set, seed >>> 0, { skill: !skill || skill === 'passive' ? null : skill, raw: true });\\n    const n = Math.round(45 / DT);\\n    for (let i = 0; i < n; i++) b.step(DT, 0, 0);\\n    return { pct: b.inside / n * 100, falls: b.falls };\\n  };\\n  /* Same seed and the same scripted lean, twice: a hash of the shipped step, not a second copy of it. */\\n  G.hashRun = function (seed) {\\n150→    const R = E.rng(seed >>> 0);\\n    const b = new Balance(G.SETS.stork1, (seed * 13 + 7) >>> 0, { raw: true });\\n    let h = 2166136261;\\n    for (let i = 0; i < 2400; i++) {\\n      const u = (R() * 2 - 1) * .8, v = (R() * 2 - 1) * .8;\\n      b.step(DT, u, v);\\n      h = Math.imul(h ^ ((Math.round(b.px * 500) + 8000) & 65535), 16777619);\\n      h = Math.imul(h ^ ((Math.round(b.py * 500) + 8000) & 65535), 16777619);\\n    }\\n    return h >>> 0;\\n160→  };\\n  G.gentleSet = function (set, on) {\\n    if (!on) return set;\\n    return Object.assign({}, set, { R: set.R * 1.25, s: set.s * .7, A: set.A * .7 });\\n  };\\n})();\\n\",\"content_concise\":\"120→        this.vx += ax * dt; this.vy += ay * dt; this.px += this.vx * dt; this.py += this.vy * dt;\\n        if (!this.cheat && Math.hypot(this.px, this.py) >= L.stumbleAt) {\\n          this.stumble = 1; this.falls++;\\n          this.vx = 0; this.vy = 0;\\n          const h = Math.hypot(this.px, this.py) || 1; this.px /= h; this.py /= h;\\n        }\\n      }\\n      const dx = this.px - cx, dy = this.py - cy;\\n      if (this.stumble <= 0 && Math.hypot(dx, dy) < L.R) this.inside++;\\n      this.frames++;\\n130→      this.t += dt;\\n      this.trail.push({ x: this.px, y: this.py });\\n      if (this.trail.length > 120) this.trail.shift();\\n      return this;\\n    }\\n    get steadiness() { return this.frames ? this.inside / this.frames : 0; }\\n    get p() { return { x: this.px, y: this.py }; }\\n    get v() { return { x: this.vx, y: this.vy }; }\\n  }\\n  G.Balance = Balance;\\n140→  /* 45 s, the section 3 seeds. skill 'passive' holds still. raw constants, so a live slider cannot move the table. */\\n  G.bandTrial = function (name, skill, seed) {\\n    const set = G.SETS[name];\\n    const b = new Balance(set, seed >>> 0, { skill: !skill || skill === 'passive' ? null : skill, raw: true });\\n    const n = Math.round(45 / DT);\\n    for (let i = 0; i < n; i++) b.step(DT, 0, 0);\\n    return { pct: b.inside / n * 100, falls: b.falls };\\n  };\\n  /* Same seed and the same scripted lean, twice: a hash of the shipped step, not a second copy of it. */\\n  G.hashRun = function (seed) {\\n150→    const R = E.rng(seed >>> 0);\\n    const b = new Balance(G.SETS.stork1, (seed * 13 + 7) >>> 0, { raw: true });\\n    let h = 2166136261;\\n    for (let i = 0; i < 2400; i++) {\\n      const u = (R() * 2 - 1) * .8, v = (R() * 2 - 1) * .8;\\n      b.step(DT, u, v);\\n      h = Math.imul(h ^ ((Math.round(b.px * 500) + 8000) & 65535), 16777619);\\n      h = Math.imul(h ^ ((Math.round(b.py * 500) + 8000) & 65535), 16777619);\\n    }\\n    return h >>> 0;\\n160→  };\\n  G.gentleSet = function (set, on) {\\n    if (!on) return set;\\n    return Object.assign({}, set, { R: set.R * 1.25, s: set.s * .7, A: set.A * .7 });\\n  };\\n})();\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/balance.js\",\"offset\":120,\"limit\":80,\"raw_output\":\"        this.vx += ax * dt; this.vy += ay * dt; this.px += this.vx * dt; this.py += this.vy * dt;\\n        if (!this.cheat && Math.hypot(this.px, this.py) >= L.stumbleAt) {\\n          this.stumble = 1; this.falls++;\\n          this.vx = 0; this.vy = 0;\\n          const h = Math.hypot(this.px, this.py) || 1; this.px /= h; this.py /= h;\\n        }\\n      }\\n      const dx = this.px - cx, dy = this.py - cy;\\n      if (this.stumble <= 0 && Math.hypot(dx, dy) < L.R) this.inside++;\\n      this.frames++;\\n      this.t += dt;\\n      this.trail.push({ x: this.px, y: this.py });\\n      if (this.trail.length > 120) this.trail.shift();\\n      return this;\\n    }\\n    get steadiness() { return this.frames ? this.inside / this.frames : 0; }\\n    get p() { return { x: this.px, y: this.py }; }\\n    get v() { return { x: this.vx, y: this.vy }; }\\n  }\\n  G.Balance = Balance;\\n  /* 45 s, the section 3 seeds. skill 'passive' holds still. raw constants, so a live slider cannot move the table. */\\n  G.bandTrial = function (name, skill, seed) {\\n    const set = G.SETS[name];\\n    const b = new Balance(set, seed >>> 0, { skill: !skill || skill === 'passive' ? null : skill, raw: true });\\n    const n = Math.round(45 / DT);\\n    for (let i = 0; i < n; i++) b.step(DT, 0, 0);\\n    return { pct: b.inside / n * 100, falls: b.falls };\\n  };\\n  /* Same seed and the same scripted lean, twice: a hash of the shipped step, not a second copy of it. */\\n  G.hashRun = function (seed) {\\n    const R = E.rng(seed >>> 0);\\n    const b = new Balance(G.SETS.stork1, (seed * 13 + 7) >>> 0, { raw: true });\\n    let h = 2166136261;\\n    for (let i = 0; i < 2400; i++) {\\n      const u = (R() * 2 - 1) * .8, v = (R() * 2 - 1) * .8;\\n      b.step(DT, u, v);\\n      h = Math.imul(h ^ ((Math.round(b.px * 500) + 8000) & 65535), 16777619);\\n      h = Math.imul(h ^ ((Math.round(b.py * 500) + 8000) & 65535), 16777619);\\n    }\\n    return h >>> 0;\\n  };\\n  G.gentleSet = function (set, on) {\\n    if (!on) return set;\\n    return Object.assign({}, set, { R: set.R * 1.25, s: set.s * .7, A: set.A * .7 });\\n  };\\n})();\\n\",\"total_lines\":165}}","is_error":false},{"type":"tool_result","tool_use_id":"call-43698304-91b6-480e-b51e-b6da26d2d656-33","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"930→  scenes.round = base({\\n    enter() {\\n      G.hubOver = false;\\n      G.hubReported = false;\\n      G.ghosts = [];\\n      G.morningScores = [0, 0, 0];\\n      G.hubSendAcc = 0;\\n      G.hubProgAcc = 1;\\n      G.session = null;\\n      scenes.round.dealt = false;\\n940→      scenes.round.ei = -1;\\n      try { G.playSong('studio'); } catch (e) { /* quiet */ }\\n    },\\n    update(dt) {\\n      if (G.hubOver) { G.phase = 'auto'; return; }\\n      const api = hubApi();\\n      const live = !!(api && G.inSession && api.time);\\n      const tms = live ? api.time() : (scenes.round.local = (scenes.round.local || 0) + dt * 1000);\\n      if (live && tms === -Infinity) {\\n        G.phase = 'menu';\\n950→        const I = G.game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) { try { api.answer('ready'); } catch (e) { /* early */ } }\\n        if (I.pressed('more')) { try { api.answer('more'); } catch (e) { /* early */ } }\\n        return;\\n      }\\n      if (tms < 0) { G.phase = 'auto'; G.left = Math.max(0, -tms / 1000); return; }\\n      if (!scenes.round.dealt) {\\n        let rng = E.rng(7);\\n        try { if (live && api.rng) rng = api.rng('deal'); } catch (e) { rng = E.rng(7); }\\n        G.morningEvents = G.deal(rng);\\n960→        scenes.round.dealt = true;\\n      }\\n      const span = 50;\\n      const ev = Math.min(2, Math.floor(tms / 1000 / span));\\n      const local = (tms / 1000) - ev * span;\\n      if (ev !== scenes.round.ei) {\\n        scenes.round.ei = ev;\\n        const id = G.morningEvents[ev];\\n        try {\\n          G.session = new G.Session({ id: id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: 20 + ev });\\n970→          G.driver = 'good';\\n        } catch (e) { G.session = null; }\\n      }\\n      const s = G.session;\\n      if (s && local < 45 && s.phase !== 'results') {\\n        try { s.update(Math.min(dt, 0.05)); } catch (e) { /* keep the clock */ }\\n        if (s.phase === 'results') G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n        else G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n      }\\n      G.phase = 'play';\\n980→      G.left = Math.max(0, span - local);\\n      if (live) {\\n        G.hubSendAcc += dt;\\n        G.hubProgAcc += dt;\\n        if (G.hubSendAcc >= 0.1) {\\n          G.hubSendAcc = 0;\\n          const b = s && s.seats && s.seats[0] && s.seats[0].bal;\\n          try {\\n            api.send({ t: 'g', a: ev, l: [b ? b.px : 0, b ? b.py : 0], p: s ? s.phase : 'play', w: [0, 0], s: G.morningScores[ev] || 0 }, { reliable: false });\\n          } catch (e) { /* rate */ }\\n990→        }\\n        if (G.hubProgAcc >= 1) {\\n          G.hubProgAcc = 0;\\n          const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n          try { api.progress({ score: total, label: total + ' pts' }); } catch (e) { /* rate */ }\\n        }\\n      }\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n1000→      const api = hubApi();\\n      const waiting = api && G.inSession && api.time && api.time() === -Infinity;\\n      if (waiting) {\\n        hudName(r, 'Spine Wee', 'Morning Class');\\n        r.overlay(function (g) {\\n          G.text(g, 'Lean. Stay steady. Most points wins.', 12, 70, '#20404c', 1);\\n          const ps = (G.hubInfo && G.hubInfo.players) || [];\\n          ps.forEach(function (p, i) { G.text(g, (p.name || ('Seat ' + (i + 1))), 12, 90 + i * 14, p.color || '#14a8c8', 1); });\\n          G.text(g, 'Ready', r.W / 2 - 40, r.H - 36, '#14a8c8', 2);\\n        });\\n1010→        return;\\n      }\\n      if (G.session) { try { G.drawActivity(r, G.session); } catch (e) { /* room */ } }\\n      r.overlay(function (g) {\\n        const names = (G.morningEvents || []).join('  ');\\n        G.text(g, names, 8, r.H - 24, '#5f7f8a', 1);\\n        G.ghosts.forEach(function (gh, i) {\\n          if (!gh || gh.a !== scenes.round.ei) return;\\n          G.text(g, gh.name || 'ghost', 20 + i * 40, 60, gh.color || '#ffffff', 1);\\n        });\\n1020→      });\\n    }\\n  });\\n\\n  function aboutPages() {\\n    const A = G.ABOUT;\\n    const pages = [];\\n    if (A && A.sourceInformation) {\\n      const order = ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\\n      order.forEach(function (k) { pages.push({ h: 'Source', t: k + ': ' + A.sourceInformation[k] }); });\\n1030→    } else pages.push({ h: 'Source', t: 'Source information is bound when the page is built.' });\\n    const blocks = [\\n      ['Testing Feedback', A && A.testingFeedback],\\n      ['Engine Feedback', A && A.engineFeedback],\\n      ['Prompt Feedback', A && A.promptFeedback]\\n    ];\\n    blocks.forEach(function (b) {\\n      const arr = b[1] || ['unknown'];\\n      arr.forEach(function (line, i) { pages.push({ h: b[0], t: (i + 1) + '. ' + line }); });\\n    });\\n1040→    pages.push({ h: 'Credits', t: 'my-3D2dge. Mesh2Motion and Quaternius, CC0. CMU Graphics Lab Motion Capture Database.' });\\n    pages.push({ h: 'Credits', t: 'No extra asset-store packs. Voices are synthesized. Music is synthesized.' });\\n    return pages;\\n  }\\n\\n  scenes.about = base({\\n    enter() {\\n      scenes.about.pages = aboutPages();\\n      scenes.about.i = 0;\\n      G.phase = 'menu';\",\"content_concise\":\"930→  scenes.round = base({\\n    enter() {\\n      G.hubOver = false;\\n      G.hubReported = false;\\n      G.ghosts = [];\\n      G.morningScores = [0, 0, 0];\\n      G.hubSendAcc = 0;\\n      G.hubProgAcc = 1;\\n      G.session = null;\\n      scenes.round.dealt = false;\\n940→      scenes.round.ei = -1;\\n      try { G.playSong('studio'); } catch (e) { /* quiet */ }\\n    },\\n    update(dt) {\\n      if (G.hubOver) { G.phase = 'auto'; return; }\\n      const api = hubApi();\\n      const live = !!(api && G.inSession && api.time);\\n      const tms = live ? api.time() : (scenes.round.local = (scenes.round.local || 0) + dt * 1000);\\n      if (live && tms === -Infinity) {\\n        G.phase = 'menu';\\n950→        const I = G.game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) { try { api.answer('ready'); } catch (e) { /* early */ } }\\n        if (I.pressed('more')) { try { api.answer('more'); } catch (e) { /* early */ } }\\n        return;\\n      }\\n      if (tms < 0) { G.phase = 'auto'; G.left = Math.max(0, -tms / 1000); return; }\\n      if (!scenes.round.dealt) {\\n        let rng = E.rng(7);\\n        try { if (live && api.rng) rng = api.rng('deal'); } catch (e) { rng = E.rng(7); }\\n        G.morningEvents = G.deal(rng);\\n960→        scenes.round.dealt = true;\\n      }\\n      const span = 50;\\n      const ev = Math.min(2, Math.floor(tms / 1000 / span));\\n      const local = (tms / 1000) - ev * span;\\n      if (ev !== scenes.round.ei) {\\n        scenes.round.ei = ev;\\n        const id = G.morningEvents[ev];\\n        try {\\n          G.session = new G.Session({ id: id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: 20 + ev });\\n970→          G.driver = 'good';\\n        } catch (e) { G.session = null; }\\n      }\\n      const s = G.session;\\n      if (s && local < 45 && s.phase !== 'results') {\\n        try { s.update(Math.min(dt, 0.05)); } catch (e) { /* keep the clock */ }\\n        if (s.phase === 'results') G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n        else G.morningScores[ev] = Math.round((s.pct || 0) * 1000);\\n      }\\n      G.phase = 'play';\\n980→      G.left = Math.max(0, span - local);\\n      if (live) {\\n        G.hubSendAcc += dt;\\n        G.hubProgAcc += dt;\\n        if (G.hubSendAcc >= 0.1) {\\n          G.hubSendAcc = 0;\\n          const b = s && s.seats && s.seats[0] && s.seats[0].bal;\\n          try {\\n            api.send({ t: 'g', a: ev, l: [b ? b.px : 0, b ? b.py : 0], p: s ? s.phase : 'play', w: [0, 0], s: G.morningScores[ev] || 0 }, { reliable: false });\\n          } catch (e) { /* rate */ }\\n990→        }\\n        if (G.hubProgAcc >= 1) {\\n          G.hubProgAcc = 0;\\n          const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n          try { api.progress({ score: total, label: total + ' pts' }); } catch (e) { /* rate */ }\\n        }\\n      }\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n1000→      const api = hubApi();\\n      const waiting = api && G.inSession && api.time && api.time() === -Infinity;\\n      if (waiting) {\\n        hudName(r, 'Spine Wee', 'Morning Class');\\n        r.overlay(function (g) {\\n          G.text(g, 'Lean. Stay steady. Most points wins.', 12, 70, '#20404c', 1);\\n          const ps = (G.hubInfo && G.hubInfo.players) || [];\\n          ps.forEach(function (p, i) { G.text(g, (p.name || ('Seat ' + (i + 1))), 12, 90 + i * 14, p.color || '#14a8c8', 1); });\\n          G.text(g, 'Ready', r.W / 2 - 40, r.H - 36, '#14a8c8', 2);\\n        });\\n1010→        return;\\n      }\\n      if (G.session) { try { G.drawActivity(r, G.session); } catch (e) { /* room */ } }\\n      r.overlay(function (g) {\\n        const names = (G.morningEvents || []).join('  ');\\n        G.text(g, names, 8, r.H - 24, '#5f7f8a', 1);\\n        G.ghosts.forEach(function (gh, i) {\\n          if (!gh || gh.a !== scenes.round.ei) return;\\n          G.text(g, gh.name || 'ghost', 20 + i * 40, 60, gh.color || '#ffffff', 1);\\n        });\\n1020→      });\\n    }\\n  });\\n\\n  function aboutPages() {\\n    const A = G.ABOUT;\\n    const pages = [];\\n    if (A && A.sourceInformation) {\\n      const order = ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage'];\\n      order.forEach(