.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\"},{\"line_number\":197,\"content\":\"  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot', 'Jump'];\"},{\"line_number\":198,\"content\":\"  G.dev.tools = TOOLS;\"},{\"line_number\":302,\"content\":\"    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\"},{\"line_number\":354,\"content\":\"      text(g, TOOLS[self.tool] || '', 8, r.H - 16, '#14a8c8', 1);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/boot.js\",\"matches\":[{\"line_number\":163,\"content\":\"      const gh = { t: 'g', a: d.a, l: d.l, p: d.p, w: d.w, s: d.s, from: from, name: String(from || 'ghost'), color: '#8fd3f4' };\"},{\"line_number\":164,\"content\":\"      const i = G.ghosts.findIndex(function (q) { return q.from === from; });\"},{\"line_number\":165,\"content\":\"      if (i >= 0) G.ghosts[i] = gh;\"},{\"line_number\":166,\"content\":\"      else G.ghosts.push(gh);\"},{\"line_number\":167,\"content\":\"      if (G.ghosts.length > 8) G.ghosts.shift();\"},{\"line_number\":171,\"content\":\"      G.ghosts = G.ghosts.filter(function (q) { return q.from !== id; });\"},{\"line_number\":176,\"content\":\"    const pending = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\"},{\"line_number\":200,\"content\":\"    G.driver = null;\"},{\"line_number\":211,\"content\":\"    G.ghosts = [];\"},{\"line_number\":223,\"content\":\"    if (G.dev) { G.dev.panel = false; G.dev.on = false; G.dev.tool = 0; G.dev.bot = null; }\"},{\"line_number\":245,\"content\":\"            G.driver = null;\"},{\"line_number\":293,\"content\":\"        G.driver = null;\"}]},{\"path\"