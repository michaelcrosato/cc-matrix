eadOf(t, tier) {\"},{\"line_number\":117,\"content\":\"  function guideOf(t) {\"},{\"line_number\":123,\"content\":\"  function beginFamily(sess) {\"},{\"line_number\":130,\"content\":\"      sess.seats.forEach(function (q, i) {\"},{\"line_number\":144,\"content\":\"      sess.seats.forEach(function (q, i) {\"},{\"line_number\":159,\"content\":\"    if (act.family === 'tray') { fam.trayI = 0; fam.got = 0; fam.total = 0; fam.world = null; fam.cleared = 0; G.TRAYS.forEach(function (t) { fam.total += t.olives.length; }); }\"},{\"line_number\":166,\"content\":\"  function startStep(sess) {\"},{\"line_number\":177,\"content\":\"    try { G.game.audio.onBeat(function () { try { G.game.audio.sfx('tick'); } catch (err) { /* quiet */ } }); } catch (e) { /* no bus yet */ }\"},{\"line_number\":184,\"content\":\"  function loadTray(sess) {\"},{\"line_number\":193,\"content\":\"    spec.bumps.forEach(function (b) { world.circle(b.x, b.y, b.r, { type: 'static', bounce: 0.4, friction: 0.2 }); });\"},{\"line_number\":197,\"content\":\"    spec.olives.forEach(function (o) {\"},{\"line_number\":201,\"content\":\"    world.on.enter = function (sensorBody, other) {\"},{\"line_number\":214,\"content\":\"  function stepFamily(sess, dt) {\"},{\"line_number\":220,\"content\":\"    sess.seats.forEach(function (q, i) { if (i > 0) drive(q, fam, dt); });\"},{\"line_number\":238,\"content\":\"  function stepHold(sess, dt) {\"},{\"line_number\":256,\"content\":\"  function stepSun(sess, dt) {\"},{\"line_number\":269,\"content\":\"  function stepCandle(sess, dt) {\"},{\"line_number\":294,\"content\":\"    if (fam.untouched > 20 && !fam.said) { fam.said = true; G.subtitle = G.LINES.tare.filter(function (s) { return s.indexOf('controller') >= 0; })[0] || ''; }\"},{\"line_number\":300,\"content\":\"  function stepRep(sess, dt) {\"},{\"line_number\":326,\"content\":\"        const mean = fam.scores.reduce(function (a, b) { return a + b; }, 0) / fam.scores.length;\"},{\"line_number\":332,\"content\":\"    const mean = fam.scores.length ? fam.scores.reduce(function (a, b) { return a + b; }, 0) / fam.scores.length : 0;\"},{\"line_number\":337,\"content\":\"  function stepStep(sess, dt) {\"},{\"line_number\":359,\"content\":\"  function stepHoop(sess, dt) {\"},{\"line_number\":395,\"content\":\"  function stepJog(sess, dt) {\"},{\"line_number\":427,\"content\":\"  function stepSlalom(sess, dt) {\"},{\"line_number\":466,\"content\":\"  function stepTray(sess, dt) {\"},{\"line_number\":497,\"content\":\"  function stepLaundry(sess, dt) {\"},{\"line_number\":542,\"content\":\"  function scoreNow(sess) {\"},{\"line_number\":554,\"content\":\"  function Session(opts) {\"},{\"line_number\":581,\"content\":\"  Session.prototype.update = function (dt) {\"},{\"line_number\":587,\"content\":\"      G.phase = 'menu'; G.left = 0;\"},{\"line_number\":592,\"content\":\"      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\"},{\"line_number\":598,\"content\":\"      G.phase = 'auto'; G.left = Math.max(0, this.countT);\"},{\"line_number\":603,\"content\":\"      G.phase = 'play';\"},{\"line_number\":606,\"content\":\"      G.left = Math.max(0, this.limit - this.playTime);\"},{\"line_number\":617,\"content\":\"    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\"},{\"line_number\":620,\"content\":\"  Session.prototype.finish = function () {\"},{\"line_number\":628,\"content\":\"    G.phase = 'menu'; G.left = 0;\"},{\"line_number\":629,\"content\":\"    this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\"},{\"line_number\":631,\"content\":\"      this.seats.forEach(function (q) {\"},{\"line_number\":646,\"content\":\"  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\"},{\"line_number\":647,\"content\":\"  Session.prototype.again = function () {\"},{\"line_number\":650,\"content\":\"    G.session = next;\"},{\"line_number\":653,\"content\":\"  G.Session = Session;\"},{\"line_number\":654,\"content\":\"  G.skillName = skillName;\"},{\"line_number\":656,\"content\":\"  G.drawActivity = function (r, sess) {\"},{\"line_number\":677,\"content\":\"          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\"},{\"line_number\":681,\"content\":\"    r.overlay(function (g) {\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"6f176bc3-f1a6-469f-b6aa-08de20a08ac4"}
