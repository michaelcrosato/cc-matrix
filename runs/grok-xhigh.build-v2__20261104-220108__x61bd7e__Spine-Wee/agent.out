1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n    const n = G.dev.keys.length;\\n    const moved = (beforeI - G.dev.i + n) % n;\\n    assert(moved === 1, code + ' rows ' + beforeI + ' -> ' + G.dev.i);\\n  };\\n  rowStep('ArrowUp');\\n  rowStep('Pad12');\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.i === 0, 'slider not home ' + G.dev.i);\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  const tapCode = function (code) {\\n    game.input.press(code);\\n    game.advance(1 / 120);\\n    game.input.release(code);\\n    game.advance(1 / 120);\\n  };\\n  const mores = function (n) { for (let i = 0; i < n; i++) tapCode('KeyM'); };\\n  const sliderTo = function (key) {\\n    const want = G.dev.keys.indexOf(key);\\n    assert(want >= 0, 'no slider ' + key);\\n    const n = (want - G.dev.i + G.dev.keys.length) % G.dev.keys.length;\\n    for (let i = 0; i < n; i++) tapCode('ArrowDown');\\n    assert(G.dev.keys[G.dev.i] === key, 'slider ' + G.dev.keys[G.dev.i]);\\n  };\\n  mores(G.dev.tools.length - 1);\\n  assert(G.dev.tools[G.dev.tool] === 'Jump', 'tool ' + G.dev.tools[G.dev.tool]);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'keyboard did not open jump');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  tapCode('Enter');\\n  let s = snap(game);\\n  assert(s.scene === 'play' && s.activity === 'stork' && s.tier === 2 && s.day === 3, s.scene + ' ' + s.activity + ' t' + s.tier + ' d' + s.day);\\n  const botAt = G.dev.tools.indexOf('Bot: good');\\n  mores((botAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  assert(G.dev.tools[G.dev.tool] === 'Bot: good', 'bot tool ' + G.dev.tools[G.dev.tool]);\\n  game.input.press('Pad0');\\n  game.advance(1 / 120);\\n  game.input.release('Pad0');\\n  game.advance(0.6);\\n  assert(G.dev.bot === 'good', 'bot flag ' + G.dev.bot);\\n  assert(G.session && G.skillName(G.session.seats[0]) === 'good', 'bot not read');\\n  assert(G.session.seats[0].bal && G.session.seats[0].bal.skill === 'good', 'balance stayed human');\\n  const offAt = G.dev.tools.indexOf('Bot: off');\\n  mores((offAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.bot == null, 'bot stayed ' + G.dev.bot);\\n  const jumpAt = G.dev.tools.indexOf('Jump');\\n  mores((jumpAt - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  assert(G.dev.jumpMode, 'second jump closed');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  for (let i = 0; i < 10; i++) tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'tray', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('trayFric');\\n  const fr0 = G.dev.v.trayFric;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.trayFric > fr0, 'tray slider ' + G.dev.v.trayFric);\\n  game.advance(0.6);\\n  const olives = G.session && G.session.fam && G.session.fam.world && G.session.fam.world.bodies\\n    ? G.session.fam.world.bodies.filter(function (b) { return b && b._olive; }) : [];\\n  assert(olives.length > 0, 'no olives');\\n  assert(olives[0].friction > 0.12, 'tray friction ' + olives[0].friction);\\n  mores((G.dev.tools.indexOf('Jump') - G.dev.tool + G.dev.tools.length) % G.dev.tools.length);\\n  tapCode('Enter');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowDown');\\n  tapCode('ArrowRight');\\n  assert(G.dev.jumpActs[G.dev.jumpActI] === 'laundry', 'act ' + G.dev.jumpActs[G.dev.jumpActI]);\\n  tapCode('Enter');\\n  sliderTo('ropeS');\\n  const rs0 = G.dev.v.ropeS;\\n  tapCode('ArrowRight');\\n  assert(G.dev.v.ropeS > rs0, 'rope slider ' + G.dev.v.ropeS);\\n  game.advance(0.6);\\n  const rope = G.session && G.session.seats[0].bal;\\n  assert(rope && rope.set.s > G.session.fam.rope.s, 'rope s ' + (rope && rope.set.s) + ' base ' + (G.session.fam && G.session.fam.rope && G.session.fam.rope.s));\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\",\"total_lines\":990}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0ca8f8ec-4cbe-4f7b-a8d7-9952ae7d8b67-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"200→    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n210→    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 100;\\n220→    const key = String(name).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'pose';\\n    const row = key + \\\": { clip: '\\\" + name + \\\"', a: \\\" + t.toFixed(2) + \\\", b: \\\" + Math.max(b, t).toFixed(2) + \\\", tgt: 1.57 },\\\";\\n    this.printed = row;\\n    try { console.log(row); } catch (e) { /* the row is also on the panel */ }\\n    return row;\\n  };\\n  function eat(input, action) { try { input.suppress(action); } catch (e) { /* already used */ } }\\n  G.dev.update = function (input, dt) {\\n    if (!this.panel) return;\\n    const keys = this.keys;\\n230→    if (input.pressed('cancel')) {\\n      eat(input, 'cancel');\\n      if (this.poseMode) { this.poseMode = false; return; }\\n      if (this.jumpMode) { this.jumpMode = false; return; }\\n      this.close();\\n      return;\\n    }\\n    if (this.poseMode) {\\n      const names = this.clipNames();\\n      const n = names.length || 1;\\n240→      if (input.pressed('up')) { this.poseI = (this.poseI + n - 1) % n; this.poseT = 0; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.poseI = (this.poseI + 1) % n; this.poseT = 0; eat(input, 'down'); }\\n      const dur = (this.currentClip() && this.currentClip().dur) || 2;\\n      if (input.pressed('left') || input.repeat('left')) { this.poseT = Math.max(0, this.poseT - 0.05); eat(input, 'left'); }\\n      if (input.pressed('right') || input.repeat('right')) { this.poseT = Math.min(dur, this.poseT + 0.05); eat(input, 'right'); }\\n      if (input.pressed('confirm')) { this.printPose(); eat(input, 'confirm'); }\\n      void dt;\\n      return;\\n    }\\n    if (this.jumpMode) {\\n250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n    const k = keys[this.i];\\n280→    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n290→    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n300→    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n    try {\\n310→      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n    if (!this.panel || !r) return;\\n320→    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n        const on = start + n === self.i;\\n330→        const y = 18 + n * 12;\\n        if (on) E.px.rect(g, 4, y - 1, w - 8, 11, '#bfeee0');\\n        const def = G.DEV_DEFAULTS[k];\\n        text(g, (DEV_HELP[k] || k) + ' ' + self.v[k], 8, y, '#20404c', 1);\\n        if (self.v[k] !== def) text(g, 'd' + def, w - 36, y, '#5f7f8a', 1);\\n      }\\n      if (self.poseMode) {\\n        const names = self.clipNames();\\n        const clip = self.currentClip();\\n        text(g, (names[self.poseI] || '') + '  ' + (self.poseT || 0).toFixed(2), 8, r.H - 52, '#20404c', 1);\\n340→        if (self.printed) text(g, self.printed.slice(0, 42), 8, r.H - 40, '#5f7f8a', 1);\\n        text(g, clip ? 'up clip   side scrub   confirm prints' : '', 8, r.H - 28, '#5f7f8a', 1);\\n      } else if (self.jumpMode) {\\n        const rows = [\\n          'Day ' + self.jumpDay,\\n          'Scene ' + self.jumpScenes[self.jumpSceneI],\\n          'Activity ' + (self.jumpActs[self.jumpActI] || '(scene)'),\\n          'Tier ' + self.jumpTier\\n        ];\\n        rows.forEach(function (line, n) {\\n350→          text(g, (n === self.jumpRow ? '> ' : '  ') + line, 8, r.H - 78 + n * 11, n === self.jumpRow ? '#14a8c8' : '#20404c', 1);\\n        });\\n      } else text(g, 'reset: retry', 8, r.H - 28, '#5f7f8a', 1);\\n      text(g, TOOLS[self.tool] || '', 8, r.H - 16, '#14a8c8', 1);\\n    });\\n  };\\n  G.starsOf = function (pct, gates) {\\n    gates = gates || [.35, .65, .90];\\n    const g0 = G.dev && G.dev.on ? G.dev.v.star1 : gates[0];\\n    const g1 = G.dev && G.dev.on ? G.dev.v.star2 : gates[1];\",\"content_concise\":\"200→    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n210→    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 100;\\n220→    const key = String(name).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'pose';\\n    const row = key + \\\": { clip: '\\\" + name + \\\"', a: \\\" + t.toFixed(2) + \\\", b: \\\" + Math.max(b, t).toFixed(2) + \\\", tgt: 1.57 },\\\";\\n    this.printed = row;\\n    try { console.log(row); } catch (e) { /* the row is also on the panel */ }\\n    return row;\\n  };\\n  function eat(input, action) { try { input.suppress(action); } catch (e) { /* already used */ } }\\n  G.dev.update = function (input, dt) {\\n    if (!this.panel) return;\\n    const keys = this.keys;\\n230→    if (input.pressed('cancel')) {\\n      eat(input, 'cancel');\\n      if (this.poseMode) { this.poseMode = false; return; }\\n      if (this.jumpMode) { this.jumpMode = false; return; }\\n      this.close();\\n      return;\\n    }\\n    if (this.poseMode) {\\n      const names = this.clipNames();\\n      const n = names.length || 1;\\n240→      if (input.pressed('up')) { this.poseI = (this.poseI + n - 1) % n; this.poseT = 0; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.poseI = (this.poseI + 1) % n; this.poseT = 0; eat(input, 'down'); }\\n      const dur = (this.currentClip() && this.currentClip().dur) || 2;\\n      if (input.pressed('left') || input.repeat('left')) { this.poseT = Math.max(0, this.poseT - 0.05); eat(input, 'left'); }\\n      if (input.pressed('right') || input.repeat('right')) { this.poseT = Math.min(dur, this.poseT + 0.05); eat(input, 'right'); }\\n      if (input.pressed('confirm')) { this.printPose(); eat(input, 'confirm'); }\\n      void dt;\\n      return;\\n    }\\n    if (this.jumpMode) {\\n250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n    const k = keys[this.i];\\n280→    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n290→    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n300→    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n    try {\\n310→      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n    if (!this.panel || !r) return;\\n320→    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n        const on = start + n === self.i;\\n330→        const y = 18 + n * 12;\\n        if (on) E.px.rect(g, 4, y - 1, w - 8, 11, '#bfeee0');\\n        const def = G.DEV_DEFAULTS[k];\\n        text(g, (DEV_HELP[k] || k) + ' ' + self.v[k], 8, y, '#20404c', 1);\\n        if (self.v[k] !== def) text(g, 'd' + def, w - 36, y, '#5f7f8a', 1);\\n      }\\n      if (self.poseMode) {\\n        const names = self.clipNames();\\n        const clip = self.currentClip();\\n        text(g, (names[self.poseI] || '') + '  ' + (self.poseT || 0).toFixed(2), 8, r.H - 52, '#20404c', 1);\\n340→        if (self.printed) text(g, self.printed.slice(0, 42), 8, r.H - 40, '#5f7f8a', 1);\\n        text(g, clip ? 'up clip   side scrub   confirm prints' : '', 8, r.H - 28, '#5f7f8a', 1);\\n      } else if (self.jumpMode) {\\n        const rows = [\\n          'Day ' + self.jumpDay,\\n          'Scene ' + self.jumpScenes[self.jumpSceneI],\