{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-cb6f1b5f-a073-4e4e-8585-bc267af99fe3-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/* Every activity. One session walks the card, the demo, the count, the play, and the stamp. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const DT = 1 / 120;\\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n  const LEAD = { poor: -0.4, average: 0.05, good: 0.14, expert: 0.2 };\\n  const STEP_OFF = { poor: 0.1, average: 0.03, good: 0.015, expert: 0.008 };\\n10→  const EFFORT = { poor: 0.28, average: 0.5, good: 0.62, expert: 0.72 };\\n\\n  function skillName(seat) {\\n    if (G.dev && G.dev.on && G.dev.bot && seat && seat.local && G.BOTS[G.dev.bot]) return G.dev.bot;\\n    const d = G.driver && G.driver !== 'human' ? G.driver : (seat && seat.skill);\\n    if (!d || d === 'passive' || d === 'human') return null;\\n    return G.BOTS[d] ? d : null;\\n  }\\n\\n  /* The lean that belongs to this seat. Seat 0 is G.lean, so a solo session is unchanged. */\\n20→  function leanFor(seat) {\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (G.leans && G.leans[i]) return G.leans[i];\\n    return G.lean;\\n  }\\n\\n  function seatInput(seat) {\\n    const ps = G.game && G.game.players;\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (ps && ps[i]) return ps[i];\\n30→    return G.game ? G.game.input : null;\\n  }\\n\\n  function arm(bal, skill) {\\n    if (!bal) return;\\n    if (!skill) { bal.skill = null; bal.bot = null; return; }\\n    if (bal.skill === skill && bal.bot) return;\\n    bal.skill = skill;\\n    const br = E.rng((bal.seed ^ 0x9e3779b9) >>> 0);\\n    const b = G.BOTS[skill];\\n40→    bal.bnx = function (t) { return (Math.sin(t * .35 + 1.1) + .6 * Math.sin(t * .35 * 1.73 + 2.2)) / 1.6; };\\n    bal.bny = function (t) { return (Math.sin(t * .41 + 0.4) + .6 * Math.sin(t * .41 * 1.17 + 1.7)) / 1.6; };\\n    void br;\\n    bal.bot = b;\\n  }\\n\\n  /* A seat's hands. A named skill drives the activity bots. A hold skill is applied on the balance itself. */\\n  function drive(seat, fam, dt) {\\n    const skill = skillName(seat);\\n    const human = !skill && !(G.driver === 'passive' || (seat && seat.skill === 'passive'));\\n50→    if (human && seat && seat.local) {\\n      const L = leanFor(seat);\\n      seat.ux = L.ux; seat.uy = L.uy;\\n      seat.breath = L.breath; seat.effort = L.effort;\\n      seat.jump = L.jump; seat.catchL = L.catchL; seat.catchR = L.catchR;\\n      seat.paceL = L.paceL; seat.paceR = L.paceR;\\n      if (Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05) seat.moved = true;\\n      return;\\n    }\\n    seat.ux = 0; seat.uy = 0; seat.breath = 0; seat.effort = 0;\\n60→    seat.jump = false; seat.catchL = false; seat.catchR = false; seat.paceL = false; seat.paceR = false;\\n    if (!skill) return;\\n    const kind = fam && fam.kind;\\n    if (kind === 'rep') {\\n      const lead = LEAD[skill];\\n      const bead = fam.bead, vel = fam.beadVel || 0;\\n      const sign = vel > 0.002 ? 1 : vel < -0.002 ? -1 : 0;\\n      /* Expert servos onto the bead. A fixed lead sits well on tier 1 and misses tier 2's fast rise. */\\n      let target = bead + lead * sign;\\n      const bal = seat.bal;\\n70→      if (skill === 'expert' && bal) {\\n        const depth = fam.axis === 'x' ? (fam.side > 0 ? bal.px : -bal.px) : -bal.py;\\n        const rate = fam.axis === 'x' ? (fam.side > 0 ? bal.vx : -bal.vx) : -bal.vy;\\n        const P = 2.6, D = 0.35;\\n        target = bead + P * (bead - depth) + D * (vel - rate);\\n      }\\n      target = clamp(target, -0.2, 1.25);\\n      if (fam.axis === 'x') {\\n        seat.ux = fam.side * target;\\n        seat.uy = skill === 'expert' && bal ? clamp(-bal.py * 1.6, -0.6, 0.6) : 0;\\n80→      } else {\\n        seat.uy = -target;\\n        seat.ux = skill === 'expert' && bal ? clamp(-bal.px * 1.6, -0.6, 0.6) : 0;\\n      }\\n    } else if (kind === 'sun') {\\n      seat.breath = fam.guide;\\n    } else if (kind === 'hoop') {\\n      const w = skill === 'poor' ? 4.2 : 9;\\n      seat.botPh = (seat.botPh || 0) + w * dt * (fam.otherWay ? -1 : 1);\\n      seat.ux = Math.cos(seat.botPh); seat.uy = Math.sin(seat.botPh);\\n90→      if (fam.toss && Math.abs(fam.toss.eta) < 0.12) {\\n        if (fam.toss.side < 0) seat.catchL = true; else seat.catchR = true;\\n      }\\n    } else if (kind === 'jog') {\\n      const hz = skill === 'poor' ? 1.4 : 3.0;\\n      fam.footT = (fam.footT || 0) + dt;\\n      if (fam.footT >= 1 / hz) { fam.footT = 0; fam.foot = !fam.foot; fam.stepEdge = fam.foot ? 'L' : 'R'; }\\n      seat.paceL = fam.stepEdge === 'L'; seat.paceR = fam.stepEdge === 'R';\\n      const cup = fam.nextCup;\\n      seat.ux = cup ? clamp((cup.x - fam.x) / 1.2, -1, 1) : 0;\\n100→      seat.uy = 0.2;\\n    } else if (kind === 'slalom') {\\n      const gate = fam.nextGate;\\n      const err = gate ? gate.x - fam.x : 0;\\n      const steer = skill === 'poor' ? 0.25 : skill === 'average' ? 0.85 : 1;\\n      seat.ux = clamp(err / 36, -1, 1) * steer;\\n      seat.uy = 0;\\n    } else if (kind === 'tray') {\\n      const aim = skill === 'poor' ? 0.25 : skill === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n110→    } else if (kind === 'laundry') {\\n      seat.effort = EFFORT[skill] || 0.5;\\n      const pin = fam.pinAhead;\\n      seat.jump = !!(pin && pin.dist < 1.2 && pin.dist > 0.08);\\n    }\\n  }\\n\\n  function setOf(act, tier, gentle) {\\n    const name = act.set ? act.set[tier - 1] : null;\\n    let s = name && G.SETS[name] ? G.SETS[name] : { k: 14, c: 7, s: 4, A: 1.2, nf: 1, R: .3, push: null };\\n120→    if (gentle) s = G.gentleSet(s, true);\\n    return s;\\n  }\\n\\n  function repSet(axis) {\\n    const o = { k: 16, c: 8, s: 0, A: 0.35, nf: 0.7, R: 0.55, push: null, kx: 16, ky: 16, cx: 8, cy: 8 };\\n    if (axis === 'x') { o.sx = 0; o.sy = 8; }\\n    else { o.sx = 8; o.sy = 0; }\\n    return o;\\n  }\\n130→\\n  function holdCenter(t) {\\n    const i = Math.floor(t / 12);\\n    const a = i * 2.4;\\n    return { x: Math.cos(a) * 0.06, y: Math.sin(a * 1.3) * 0.05 };\\n  }\\n\\n  function beadOf(t, tier) {\\n    if (tier >= 2) {\\n      const u = t % 5;\\n140→      if (u < 3) return u / 3;\\n      if (u < 4) return 1;\\n      return 1 - (u - 4);\\n    }\\n    const u = t % 4;\\n    return u < 2 ? u / 2 : 1 - (u - 2) / 2;\\n  }\\n\\n  function guideOf(t) {\\n    const u = (t % 8) / 4;\\n150→    return u < 1 ? u : 2 - u;\\n  }\\n\\n  /* ---- families ---- */\\n  function beginFamily(sess) {\\n    const act = sess.act, tier = sess.tier, seat = sess.seats[0];\\n    const gentle = !!(G.game && G.game.settings && G.game.settings.gentle);\\n    const skill = skillName(seat);\\n    const fam = { kind: act.family, t: 0, fx: 0, fy: 0 };\\n    if (act.family === 'hold' || act.family === 'sun' || act.family === 'candle' || act.family === 'laundry') {\\n160→      const set = act.family === 'rep' ? repSet('y') : setOf(act, tier, gentle);\\n      sess.seats.forEach(function (q, i) {\\n        const sk = skillName(q);\\n        q.bal = new G.Balance(set, (sess.seed + i * 17) >>> 0, { skill: (act.family === 'laundry' ? sk : (act.family === 'hold' || act.family === 'sun' || act.family === 'candle') ? sk : null), cheat: !!sess.cheat });\\n      });\\n    }\\n    if (act.family === 'rep') {\\n      fam.axis = act.axis || 'y';\\n      fam.reps = act.reps[tier - 1];\\n      fam.planned = fam.reps;\\n170→      fam.doneReps = 0;\\n      fam.scores = [];\\n      fam.err = 0; fam.samples = 0; fam.form = 0;\\n      fam.bead = 0; fam.prevBead = 0; fam.beadVel = 0; fam.side = 1;\\n      fam.cycle = tier >= 2 ? 5 : 4;\\n      sess.seats.forEach(function (q, i) {\\n        q.bal = new G.Balance(repSet(fam.axis), (sess.seed + i * 19) >>> 0, { cheat: !!sess.cheat });\\n      });\\n      sess.limit = fam.planned * fam.cycle + 1.5;\\n    }\\n180→    if (act.family === 'sun') { fam.poseI = 0; fam.guide = 0; fam.match = 0; fam.matchN = 0; }\",\"content_concise\":\"1→/* Every activity. One session walks the card, the demo, the count, the play, and the stamp. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const DT = 1 / 120;\\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n  const LEAD = { poor: -0.4, average: 0.05, good: 0.14, expert: 0.2 };\\n  const STEP_OFF = { poor: 0.1, average: 0.03, good: 0.015, expert: 0.008 };\\n10→  const EFFORT = { poor: 0.28, average: 0.5, good: 0.62, expert: 0.72 };\\n\\n  function skillName(seat) {\\n    if (G.dev && G.dev.on && G.dev.bot && seat && seat.local && G.BOTS[G.dev.bot]) return G.dev.bot;\\n    const d = G.driver && G.driver !== 'human' ? G.driver : (seat && seat.skill);\\n    if (!d || d === 'passive' || d === 'human') return null;\\n    return G.BOTS[d] ? d : null;\\n  }\\n\\n  /* The lean that belongs to this seat. Seat 0 is G.lean, so a solo session is unchanged. */\\n20→  function leanFor(seat) {\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (G.leans && G.leans[i]) return G.leans[i];\\n    return G.lean;\\n  }\\n\\n  function seatInput(seat) {\\n    const ps = G.game && G.game.players;\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (ps && ps[i]) return ps[i];\\n30→    return G.game ? G.game.input : null;\\n  }\\n\\n  function arm(bal, skill) {\\n    if (!bal) return;\\n    if (!skill) { bal.skill = null; bal.bot = null; return; }\\n    if (bal.skill === skill && bal.bot) return;\\n    bal.skill = skill;\\n    const br = E.rng((bal.seed ^ 0x9e3779b9) >>> 0);\\n    const b = G.BOTS[skill];\\n40→    bal.bnx = function (t) { return (Math.sin(t * .35 + 1.1) + .6 * Math.sin(t * .35 * 1.73 + 2.2)) / 1.6; };\\n    bal.bny = function (t) { return (Math.sin(t * .41 + 0.4) + .6 * Math.sin(t * .41 * 1.17 + 1.7)) / 1.6; };\\n    void br;\\n    bal.bot = b;\\n  }\\n\\n  /* A seat's hands. A named skill drives the activity bots. A hold skill is applied on the balance itself. */\\n  function drive(seat, fam, dt) {\\n    const skill = skillName(seat);\\n    const human = !skill && !(G.driver === 'passive' || (seat && seat.skill === 'passive'));\\n50→    if (human && seat && seat.local) {\\n      const L = leanFor(seat);\\n      seat.ux = L.ux; seat.uy = L.uy;\\n      seat.breath = L.breath; seat.effort = L.effort;\\n      seat.jump = L.jump; seat.catchL = L.catchL; seat.catchR = L.catchR;\\n      seat.paceL = L.paceL; seat.paceR = L.paceR;\\n      if (Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05) seat.moved = true;\\n      return;\\n    }\\n    seat.ux = 0; seat.uy = 0; seat.breath = 0; seat.effort = 0;\\n60→    seat.jump = false; seat.catchL = false; seat.catchR = false; seat.paceL = false; seat.paceR = false;\\n    if (!skill) return;\\n    const kind = fam && fam.kind;\\n    if (kind === 'rep') {\\n      const lead = LEAD[skill];\\n      const bead = fam.bead, vel = fam.beadVel || 0;\\n      const sign = vel > 0.002 ? 1 : vel < -0.002 ? -1 : 0;\\n      /* Expert servos onto the bead. A fixed lead sits well on tier 1 and misses tier 2's fast rise. */\\n      let target = bead + lead * sign;\\n      const bal = seat.bal;\\n70→      if (skill === 'expert' && bal) {\\n        const depth = fam.axis === 'x' ? (fam.side > 0 ? bal.px : -bal.px) : -bal.py;\\n        const rate = fam.axis === 'x' ? (fam.side > 0 ? bal.vx : -bal.vx) : -bal.vy;\\n        const P = 2.6, D = 0.35;\\n        target = bead + P * (bead - depth) + D * (vel - rate);\\n      }\\n      target = clamp(target, -0.2, 1.25);\\n      if (fam.axis === 'x') {\\n        seat.ux = fam.side * target;\\n        seat.uy = skill === 'expert' && bal ? clamp(-bal.py * 1.6, -0.6, 0.6) : 0;\\n80→      } else {\\n        seat.uy = -target;\\n        seat.ux = skill === 'expert' && bal ? clamp(-bal.px * 1.6, -0.6, 0.6) : 0;\\n      }\\n    } else if (kind === 'sun') {\\n      seat.breath = fam.guide;\\n    } else if (kind === 'hoop') {\\n      const w = skill === 'poor' ? 4.2 : 9;\\n      seat.botPh = (seat.botPh || 0) + w * dt * (fam.otherWay ? -1 : 1);\\n      seat.ux = Math.cos(seat.botPh); seat.uy = Math.sin(seat.botPh);\\n90→      if (fam.toss && Math.abs(fam.toss.eta) < 0.12) {\\n        if (fam.toss.side < 0) seat.catchL = true; else seat.catchR = true;\\n      }\\n    } else if (kind === 'jog') {\\n      const hz = skill === 'poor' ? 1.4 : 3.0;\\n      fam.footT = (fam.footT || 0) + dt;\\n      if (fam.footT >= 1 / hz) { fam.footT = 0; fam.foot = !fam.foot; fam.stepEdge = fam.foot ? 'L' : 'R'; }\\n      seat.paceL = fam.stepEdge === 'L'; seat.paceR = fam.stepEdge === 'R';\\n      const cup = fam.nextCup;\\n      seat.ux = cup ? clamp((cup.x - fam.x) / 1.2, -1, 1) : 0;\\n100→      seat.uy = 0.2;\\n    } else if (kind === 'slalom') {\\n      const gate = fam.nextGate;\\n      const err = gate ? gate.x - fam.x : 0;\\n      const steer = skill === 'poor' ? 0.25 : skill === 'average' ? 0.85 : 1;\\n      seat.ux = clamp(err / 36, -1, 1) * steer;\\n      seat.uy = 0;\\n    } else if (kind === 'tray') {\\n      const aim = skill === 'poor' ? 0.25 : skill === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n110→    } else if (kind === 'laundry') {\\n      seat.effort = EFFORT[skill] || 0.5;\\n      const pin = fam.pinAhead;\\n      seat.jump = !!(pin && pin.dist < 1.2 && pin.dist > 0.08);\\n    }\\n  }\\n\\n  function setOf(act, tier, gentle) {\\n    const name = act.set ? act.set[tier - 1] : null;\\n    let s = name && G.SETS[name] ? G.SETS[name] : { k: 14, c: 7, s: 4, A: 1.2, nf: 1, R: .3, push: null };\\n120→    if (gentle) s = G.gentleSet(s, true);\\n    return s;\\n  }\\n\\n  function repSet(axis) {\\n    const o = { k: 16, c: 8, s: 0, A: 0.35, nf: 0.7, R: 0.55, push: null, kx: 16, ky: 16, cx: 8, cy: 8 };\\n    if (axis === 'x') { o.sx = 0; o.sy = 8; }\\n    else { o.sx = 8; o.sy = 0; }\\n    return o;\\n  }\\n130→\\n  function holdCenter(t) {\\n    const i = Math.floor(t / 12);\\n    const a = i * 2.4;\\n    return { x: Math.cos(a) * 0.06, y: Math.sin(a * 1.3) * 0.05 };\\n  }\\n\\n  function beadOf(t, tier) {\\n    if (tier >= 2) {\\n      const u = t % 5;\\n140→      if (u < 3) return u / 3;\\n      if (u < 4) return 1;\\n      return 1 - (u - 4);\\n    }\\n    const u = t % 4;\\n    return u < 2 ? u / 2 : 1 - (u - 2) / 2;\\n  }\\n\\n  function guideOf(t) {\\n    const u = (t % 8) / 4;\\n150→    return u < 1 ? u : 2 - u;\\n  }\\n\\n  /* ---- families ---- */\\n  function beginFamily(sess) {\\n    const act = sess.act, tier = sess.tier, seat = sess.seats[0];\\n    const gentle = !!(G.game && G.game.settings && G.game.settings.gentle);\\n    const skill = skillName(seat);\\n    const fam = { kind: act.family, t: 0, fx: 0, fy: 0 };\\n    if (act.family === 'hold' || act.family === 'sun' || act.family === 'candle' || act.family === 'laundry') {\\n160→      const set = act.family === 'rep' ? repSet('y') : setOf(act, tier, gentle);\\n      sess.seats.forEach(function (q, i) {\\n        const sk = skillName(q);\\n        q.bal = new G.Balance(set, (sess.seed + i * 17) >>> 0, { skill: (act.family === 'laundry' ? sk : (act.family === 'hold' || act.family === 'sun' || act.family === 'candle') ? sk : null), cheat: !!sess.cheat });\\n      });\\n    }\\n    if (act.family === 'rep') {\\n      fam.axis = act.axis || 'y';\\n      fam.reps = act.reps[tier - 1];\\n      fam.planned = fam.reps;\\n170→      fam.doneReps = 0;\\n      fam.scores = [];\\n      fam.err = 0; fam.samples = 0; fam.form = 0;\\n      fam.bead = 0; fam.prevBead = 0; fam.beadVel = 0; fam.side = 1;\\n      fam.cycle = tier >= 2 ? 5 : 4;\\n      sess.seats.forEach(function (q, i) {\\n        q.bal = new G.Balance(repSet(fam.axis), (sess.seed + i * 19) >>> 0, { cheat: !!sess.cheat });\\n      });\\n      sess.limit = fam.planned * fam.cycle + 1.5;\\n    }\\n180→    if (act.family === 'sun') { fam.poseI = 0; fam.guide = 0; fam.match = 0; fam.matchN = 0; }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"offset\":1,\"limit\":180,\"raw_output\":\"/* Every activity. One session walks the card, the demo, the count, the play, and the stamp. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const DT = 1 / 120;\\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n  const LEAD = { poor: -0.4, average: 0.05, good: 0.14, expert: 0.2 };\\n  const STEP_OFF = { poor: 0.1, average: 0.03, good: 0.015, expert: 0.008 };\\n  const EFFORT = { poor: 0.28, average: 0.5, good: 0.62, expert: 0.72 };\\n\\n  function skillName(seat) {\\n    if (G.dev && G.dev.on && G.dev.bot && seat && seat.local && G.BOTS[G.dev.bot]) return G.dev.bot;\\n    const d = G.driver && G.driver !== 'human' ? G.driver : (seat && seat.skill);\\n    if (!d || d === 'passive' || d === 'human') return null;\\n    return G.BOTS[d] ? d : null;\\n  }\\n\\n  /* The lean that belongs to this seat. Seat 0 is G.lean, so a solo session is unchanged. */\\n  function leanFor(seat) {\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (G.leans && G.leans[i]) return G.leans[i];\\n    return G.lean;\\n  }\\n\\n  function seatInput(seat) {\\n    const ps = G.game && G.game.players;\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (ps && ps[i]) return ps[i];\\n    return G.game ? G.game.input : null;\\n  }\\n\\n  function arm(bal, skill) {\\n    if (!bal) return;\\n    if (!skill) { bal.skill = null; bal.bot = null; return; }\\n    if (bal.skill === skill && bal.bot) return;\\n    bal.skill = skill;\\n    const br = E.rng((bal.seed ^ 0x9e3779b9) >>> 0);\\n    const b = G.BOTS[skill];\\n    bal.bnx = function (t) { return (Math.sin(t * .35 + 1.1) + .6 * Math.sin(t * .35 * 1.73 + 2.2)) / 1.6; };\\n    bal.bny = function (t) { return (Math.sin(t * .41 + 0.4) + .6 * Math.sin(t * .41 * 1.17 + 1.7)) / 1.6; };\\n    void br;\\n    bal.bot = b;\\n  }\\n\\n  /* A seat's hands. A named skill drives the activity bots. A hold skill is applied on the balance itself. */\\n  function drive(seat, fam, dt) {\\n    const skill = skillName(seat);\\n    const human = !skill && !(G.driver === 'passive' || (seat && seat.skill === 'passive'));\\n    if (human && seat && seat.local) {\\n      const L = leanFor(seat);\\n      seat.ux = L.ux; seat.uy = L.uy;\\n      seat.breath = L.breath; seat.effort = L.effort;\\n      seat.jump = L.jump; seat.catchL = L.catchL; seat.catchR = L.catchR;\\n      seat.paceL = L.paceL; seat.paceR = L.paceR;\\n      if (Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05) seat.moved = true;\\n      return;\\n    }\\n    seat.ux = 0; seat.uy = 0; seat.breath = 0; seat.effort = 0;\\n    seat.jump = false; seat.catchL = false; seat.catchR = false; seat.paceL = false; seat.paceR = false;\\n    if (!skill) return;\\n    const kind = fam && fam.kind;\\n    if (kind === 'rep') {\\n      const lead = LEAD[skill];\\n      const bead = fam.bead, vel = fam.beadVel || 0;\\n      const sign = vel > 0.002 ? 1 : vel < -0.002 ? -1 : 0;\\n      /* Expert servos onto the bead. A fixed lead sits well on tier 1 and misses tier 2's fast rise. */\\n      let target = bead + lead * sign;\\n      const bal = seat.bal;\\n      if (skill === 'expert' && bal) {\\n        const depth = fam.axis === 'x' ? (fam.side > 0 ? bal.px : -bal.px) : -bal.py;\\n        const rate = fam.axis === 'x' ? (fam.side > 0 ? bal.vx : -bal.vx) : -bal.vy;\\n        const P = 2.6, D = 0.35;\\n        target = bead + P * (bead - depth) + D * (vel - rate);\\n      }\\n      target = clamp(target, -0.2, 1.25);\\n      if (fam.axis === 'x') {\\n        seat.ux = fam.side * target;\\n        seat.uy = skill === 'expert' && bal ? clamp(-bal.py * 1.6, -0.6, 0.6) : 0;\\n      } else {\\n        seat.uy = -target;\\n        seat.ux = skill === 'expert' && bal ? clamp(-bal.px * 1.6, -0.6, 0.6) : 0;\\n      }\\n    } else if (kind === 'sun') {\\n      seat.breath = fam.guide;\\n    } else if (kind === 'hoop') {\\n      const w = skill === 'poor' ? 4.2 : 9;\\n      seat.botPh = (seat.botPh || 0) + w * dt * (fam.otherWay ? -1 : 1);\\n      seat.ux = Math.cos(seat.botPh); seat.uy = Math.sin(seat.botPh);\\n      if (fam.toss && Math.abs(fam.toss.eta) < 0.12) {\\n        if (fam.toss.side < 0) seat.catchL = true; else seat.catchR = true;\\n      }\\n    } else if (kind === 'jog') {\\n      const hz = skill === 'poor' ? 1.4 : 3.0;\\n      fam.footT = (fam.footT || 0) + dt;\\n      if (fam.footT >= 1 / hz) { fam.footT = 0; fam.foot = !fam.foot; fam.stepEdge = fam.foot ? 'L' : 'R'; }\\n      seat.paceL = fam.stepEdge === 'L'; seat.paceR = fam.stepEdge === 'R';\\n      const cup = fam.nextCup;\\n      seat.ux = cup ? clamp((cup.x - fam.x) / 1.2, -1, 1) : 0;\\n      seat.uy = 0.2;\\n    } else if (kind === 'slalom') {\\n      const gate = fam.nextGate;\\n      const err = gate ? gate.x - fam.x : 0;\\n      const steer = skill === 'poor' ? 0.25 : skill === 'average' ? 0.85 : 1;\\n      seat.ux = clamp(err / 36, -1, 1) * steer;\\n      seat.uy = 0;\\n    } else if (kind === 'tray') {\\n      const aim = skill === 'poor' ? 0.25 : skill === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    } else if (kind === 'laundry') {\\n      seat.effort = EFFORT[skill] || 0.5;\\n      const pin = fam.pinAhead;\\n      seat.jump = !!(pin && pin.dist < 1.2 && pin.dist > 0.08);\\n    }\\n  }\\n\\n  function setOf(act, tier, gentle) {\\n    const name = act.set ? act.set[tier - 1] : null;\\n    let s = name && G.SETS[name] ? G.SETS[name] : { k: 14, c: 7, s: 4, A: 1.2, nf: 1, R: .3, push: null };\\n    if (gentle) s = G.gentleSet(s, true);\\n    return s;\\n  }\\n\\n  function repSet(axis) {\\n    const o = { k: 16, c: 8, s: 0, A: 0.35, nf: 0.7, R: 0.55, push: null, kx: 16, ky: 16, cx: 8, cy: 8 };\\n    if (axis === 'x') { o.sx = 0; o.sy = 8; }\\n    else { o.sx = 8; o.sy = 0; }\\n    return o;\\n  }\\n\\n  function holdCenter(t) {\\n    const i = Math.floor(t / 12);\\n    const a = i * 2.4;\\n    return { x: Math.cos(a) * 0.06, y: Math.sin(a * 1.3) * 0.05 };\\n  }\\n\\n  function beadOf(t, tier) {\\n    if (tier >= 2) {\\n      const u = t % 5;\\n      if (u < 3) return u / 3;\\n      if (u < 4) return 1;\\n      return 1 - (u - 4);\\n    }\\n    const u = t % 4;\\n    return u < 2 ? u / 2 : 1 - (u - 2) / 2;\\n  }\\n\\n  function guideOf(t) {\\n    const u = (t % 8) / 4;\\n    return u < 1 ? u : 2 - u;\\n  }\\n\\n  /* ---- families ---- */\\n  function beginFamily(sess) {\\n    const act = sess.act, tier = sess.tier, seat = sess.seats[0];\\n    const gentle = !!(G.game && G.game.settings && G.game.settings.gentle);\\n    const skill = skillName(seat);\\n    const fam = { kind: act.family, t: 0, fx: 0, fy: 0 };\\n    if (act.family === 'hold' || act.family === 'sun' || act.family === 'candle' || act.family === 'laundry') {\\n      const set = act.family === 'rep' ? repSet('y') : setOf(act, tier, gentle);\\n      sess.seats.forEach(function (q, i) {\\n        const sk = skillName(q);\\n        q.bal = new G.Balance(set, (sess.seed + i * 17) >>> 0, { skill: (act.family === 'laundry' ? sk : (act.family === 'hold' || act.family === 'sun' || act.family === 'candle') ? sk : null), cheat: !!sess.cheat });\\n      });\\n    }\\n    if (act.family === 'rep') {\\n      fam.axis = act.axis || 'y';\\n      fam.reps = act.reps[tier - 1];\\n      fam.planned = fam.reps;\\n      fam.doneReps = 0;\\n      fam.scores = [];\\n      fam.err = 0; fam.samples = 0; fam.form = 0;\\n      fam.bead = 0; fam.prevBead = 0; fam.beadVel = 0; fam.side = 1;\\n      fam.cycle = tier >= 2 ? 5 : 4;\\n      sess.seats.forEach(function (q, i) {\\n        q.bal = new G.Balance(repSet(fam.axis), (sess.seed + i * 19) >>> 0, { cheat: !!sess.cheat });\\n      });\\n      sess.limit = fam.planned * fam.cycle + 1.5;\\n    }\\n    if (act.family === 'sun') { fam.poseI = 0; fam.guide = 0; fam.match = 0; fam.matchN = 0; }\\n\",\"total_lines\":905}}","is_error":false},{"type":"tool_result","tool_use_id":"call-cb6f1b5f-a073-4e4e-8585-bc267af99fe3-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"230→    if (spec.gecko) fam.gecko = world.circle(78, gy, 7, { type: 'kinematic', bounce: 0.05, friction: 0.05 });\\n    spec.olives.forEach(function (o) {\\n      const b = world.circle(o.x, o.y, 6, { friction: 0.12, damping: 1.6, bounce: 0.05, density: 0.02, bullet: true });\\n      b._olive = true;\\n    });\\n    world.on.enter = function (sensorBody, other) {\\n      if (!other || !other._olive || other._caught) return;\\n      if (!sensorBody || !sensorBody._glass) return;\\n      other._caught = true;\\n      fam.got++;\\n240→      try { other.off = true; } catch (e) { /* it has arrived */ }\\n      try { G.game.audio.sfx('plop'); } catch (e) { /* quiet */ }\\n    };\\n    fam.world = world;\\n    fam.trayOlives = spec.olives.length;\\n    fam.trayGot0 = fam.got;\\n  }\\n\\n  function stepFamily(sess, dt) {\\n    const fam = sess.fam, act = sess.act;\\n250→    if (!fam) return;\\n    fam.t += dt;\\n    const seat = sess.seats[0];\\n    drive(seat, fam, dt);\\n    sess.seats.forEach(function (q, i) { if (i > 0) drive(q, fam, dt); });\\n    if (act.family === 'hold') stepHold(sess, dt);\\n    else if (act.family === 'sun') stepSun(sess, dt);\\n    else if (act.family === 'candle') stepCandle(sess, dt);\\n    else if (act.family === 'rep') stepRep(sess, dt);\\n    else if (act.family === 'step') stepStep(sess, dt);\\n260→    else if (act.family === 'hoop') stepHoop(sess, dt);\\n    else if (act.family === 'jog') stepJog(sess, dt);\\n    else if (act.family === 'slalom') stepSlalom(sess, dt);\\n    else if (act.family === 'tray') stepTray(sess, dt);\\n    else if (act.family === 'laundry') stepLaundry(sess, dt);\\n    const bal = seat.bal;\\n    if (bal) {\\n      sess.leanX = bal.px; sess.leanY = bal.py;\\n      if (seat.local) { G.lean.ux = seat.ux; G.lean.uy = seat.uy; }\\n    }\\n270→  }\\n\\n  function stepHold(sess, dt) {\\n    const fam = sess.fam;\\n    const c = holdCenter(fam.t);\\n    fam.c = c;\\n    let fx = 0;\\n    const gull = Math.floor(fam.t / 12);\\n    const gph = fam.t % 12;\\n    if (gull > 0 && gph < 0.28) fx = (gull % 2 ? 1 : -1) * 0.7;\\n280→    fam.fx = fx;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i], bal = seat && seat.bal;\\n      if (!bal) continue;\\n      arm(bal, skillName(seat));\\n      bal.step(dt, seat.ux, seat.uy, fx, 0, c);\\n      const pct = clamp(bal.steadiness - 0.05 * bal.falls, 0, 1);\\n      if (i === 0) {\\n290→        sess.pct = pct;\\n        if (sess.tier >= 2 && bal.px) fam.eyes = true;\\n      }\\n      if (many) seat.pct = pct;\\n    }\\n  }\\n\\n  function stepSun(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    fam.guide = guideOf(fam.t);\\n300→    arm(bal, skillName(seat));\\n    if (skillName(seat)) seat.breath = fam.guide;\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const breath = seat.local && !skillName(seat) ? leanFor(seat).breath : seat.breath;\\n    fam.matchN++;\\n    if (Math.abs(breath - fam.guide) <= 0.25) fam.match++;\\n    fam.poseI = Math.min(G.SUN_POSES.length - 1, Math.floor(fam.t / 16));\\n    sess.pct = clamp(0.6 * bal.steadiness + 0.4 * (fam.match / fam.matchN), 0, 1);\\n    if (fam.t >= 80) sess.ended = true;\\n  }\\n310→\\n  function stepCandleOne(sess, seat, box, rng, dt, primary) {\\n    const bal = seat.bal;\\n    if (!bal) return;\\n    arm(bal, skillName(seat));\\n    let fx = 0, fy = 0;\\n    box.thought -= dt;\\n    if (box.thought <= 0) {\\n      box.thought = 4.5 + (rng() * 2);\\n      const ang = rng() * Math.PI * 2;\\n320→      box.tx = Math.cos(ang) * 0.85;\\n      box.ty = Math.sin(ang) * 0.85;\\n      box.tleft = 1.1;\\n      if (sess.tier >= 2 && rng() > 0.5) { box.tx *= 1.3; box.ty *= 1.3; }\\n    }\\n    if (box.tleft > 0) { box.tleft -= dt; fx = box.tx; fy = box.ty; }\\n    bal.step(dt, seat.ux, seat.uy, fx, fy, { x: 0, y: 0 });\\n    const sp = Math.hypot(bal.vx, bal.vy);\\n    const inside = bal.stumble <= 0 && Math.hypot(bal.px, bal.py) < (bal.set.R || 0.2);\\n    if (sp > 0.55) box.flame -= 0.4 * dt;\\n330→    else if (inside) box.flame += 0.12 * dt;\\n    else box.flame -= 0.055 * dt;\\n    box.flame = clamp(box.flame, 0, 1);\\n    if (box.flame <= 0 && !box.relit) { box.relit = true; box.flame = 0.15; }\\n    else if (box.flame <= 0 && box.relit) box.dead = true;\\n    box.flameSum += box.flame;\\n    const moved = Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05;\\n    if (!moved) box.untouched += dt; else box.untouched = 0;\\n    if (primary && box.untouched > 20 && !box.said) { box.said = true; G.subtitle = G.LINES.tare.filter(function (s) { return s.indexOf('controller') >= 0; })[0] || ''; }\\n    const mean = box.flameSum / Math.max(1, bal.frames);\\n340→    const pct = clamp(0.6 * bal.steadiness + 0.4 * mean, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      if (box.dead) sess.ended = true;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepCandle(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n350→    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._candle || (seat._candle = { flame: 1, flameSum: 0, relit: false, dead: false, untouched: 0, thought: 0, tleft: 0, tx: 0, ty: 0, said: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 101) >>> 0)));\\n      stepCandleOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepRepOne(sess, seat, store, dt, primary) {\\n360→    const fam = sess.fam, bal = seat.bal;\\n    if (!bal) return;\\n    drive(seat, fam, dt);\\n    if (store.doneReps === Math.floor(fam.planned * 0.6) && !store.fatigued) {\\n      store.fatigued = true;\\n      const mul = G.dev && G.dev.on ? G.dev.v.fatigue / 1.5 : 1;\\n      bal.set = Object.assign({}, bal.set, { A: bal.set.A * 1.5 * mul, k: bal.set.k * 0.8, kx: 16 * 0.8, ky: 16 * 0.8 });\\n    }\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const depth = fam.axis === 'x' ? clamp(fam.side > 0 ? bal.px : -bal.px, 0, 1) : clamp(-bal.py, 0, 1);\\n370→    const tol = G.dev && G.dev.on ? G.dev.v.repTol : 0.08;\\n    store.err += Math.abs(depth - fam.bead);\\n    store.form += fam.axis === 'x' ? Math.abs(bal.py) : Math.abs(bal.px);\\n    store.samples++;\\n    const cyc = Math.floor(fam.t / fam.cycle);\\n    if (cyc > store.doneReps) {\\n      const meanErr = store.err / Math.max(1, store.samples);\\n      let sc = meanErr <= tol ? 1 : meanErr >= 0.35 ? 0 : (0.35 - meanErr) / (0.35 - tol);\\n      store.scores.push(sc);\\n      store.err = 0; store.samples = 0;\\n380→      store.doneReps = cyc;\\n      if (primary && store.doneReps === fam.planned && !fam.extra) {\\n        const mean = store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length;\\n        if (mean > 0.8) { fam.extra = true; fam.planned += 2; sess.limit += fam.cycle * 2; }\\n      }\\n    }\\n    const form = store.form / Math.max(1, bal.frames);\\n    const pen = clamp(form * 0.45, 0, 0.3);\\n    const mean = store.scores.length ? store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length : 0;\\n    const pct = clamp(mean * (1 - pen), 0, 1);\\n390→    if (primary) sess.pct = pct;\\n    if (sess.classMode) seat.pct = pct;\\n    if (primary && store.doneReps >= fam.planned && store.scores.length >= fam.planned) sess.ended = true;\\n  }\\n\\n  function stepRep(sess, dt) {\\n    const fam = sess.fam;\\n    const prev = fam.bead;\\n    fam.bead = beadOf(fam.t, sess.tier);\\n    fam.beadVel = (fam.bead - prev) / dt;\\n400→    fam.side = (Math.floor(fam.t / fam.cycle) % 2 === 0) ? 1 : -1;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const store = i === 0 ? fam : (seat._rep || (seat._rep = { err: 0, samples: 0, form: 0, scores: [], doneReps: 0, fatigued: false }));\\n      stepRepOne(sess, seat, store, dt, i === 0);\\n    }\\n  }\\n\\n410→  function chartOf(sess) {\\n    const tier = sess.tier;\\n    const chart = G.CHARTS[tier >= 2 ? 't2' : 't1'];\\n    const song = tier >= 2 ? G.SONGS.stepB : G.SONGS.stepA;\\n    const lanes = sess.classMode ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\\n    const scale = G.dev && G.dev.on ? G.dev.v.rhythm : 1;\\n    const rh = new E.Rhythm(G.game, {\\n      song: song, chart: chart, lanes: lanes, life: 4,\\n      windows: { perfect: 45 * scale, great: 90 * scale, good: 135 * scale }\\n    });\\n420→    return rh;\\n  }\\n\\n  function chartMiss(rh) {\\n    if (!rh || !rh.started || rh.done) return;\\n    const A = rh.game.audio, s = A.pos.step, spb = rh._spb();\\n    for (let i = 0; i < rh.notes.length; i++) {\\n      const n = rh.notes[i];\\n      if (n.step > s + 8 * rh.song.steps) break;\\n      if (n.call) continue;\\n430→      if (!n.j && (s - n.step) * spb * 1000 > rh.windows.good) rh._judge(n, 'miss', 0);\\n      if (rh.done) return;\\n    }\\n    const p = A.pos;\\n    if (!p.playing && p.t > 0) rh.done = true;\\n  }\\n\\n  function stepSeatChart(sess, seat) {\\n    if (!seat._rh) {\\n      seat._rh = chartOf(sess);\\n440→      seat._rh.started = true;\\n    }\\n    const rh = seat._rh;\\n    const I = seatInput(seat);\\n    const skill = skillName(seat);\\n    if (skill) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n450→        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    } else if (I) {\\n      rh.lanes.forEach(function (a, i) { if (I.pressed(a)) rh.hit(i); });\\n    }\\n    chartMiss(rh);\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n460→    return judged ? rh.accuracy : 0;\\n  }\\n\\n  function stepStep(sess, dt) {\\n    const fam = sess.fam, rh = fam.rh, seat = sess.seats[0];\\n    if (!rh) return;\\n    const skill = skillName(seat);\\n    if (skill && !sess.classMode) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n470→      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    }\\n    rh.update();\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\",\"content_concise\":\"230→    if (spec.gecko) fam.gecko = world.circle(78, gy, 7, { type: 'kinematic', bounce: 0.05, friction: 0.05 });\\n    spec.olives.forEach(function (o) {\\n      const b = world.circle(o.x, o.y, 6, { friction: 0.12, damping: 1.6, bounce: 0.05, density: 0.02, bullet: true });\\n      b._olive = true;\\n    });\\n    world.on.enter = function (sensorBody, other) {\\n      if (!other || !other._olive || other._caught) return;\\n      if (!sensorBody || !sensorBody._glass) return;\\n      other._caught = true;\\n      fam.got++;\\n240→      try { other.off = true; } catch (e) { /* it has arrived */ }\\n      try { G.game.audio.sfx('plop'); } catch (e) { /* quiet */ }\\n    };\\n    fam.world = world;\\n    fam.trayOlives = spec.olives.length;\\n    fam.trayGot0 = fam.got;\\n  }\\n\\n  function stepFamily(sess, dt) {\\n    const fam = sess.fam, act = sess.act;\\n250→    if (!fam) return;\\n    fam.t += dt;\\n    const seat = sess.seats[0];\\n    drive(seat, fam, dt);\\n    sess.seats.forEach(function (q, i) { if (i > 0) drive(q, fam, dt); });\\n    if (act.family === 'hold') stepHold(sess, dt);\\n    else if (act.family === 'sun') stepSun(sess, dt);\\n    else if (act.family === 'candle') stepCandle(sess, dt);\\n    else if (act.family === 'rep') stepRep(sess, dt);\\n    else if (act.family === 'step') stepStep(sess, dt);\\n260→    else if (act.family === 'hoop') stepHoop(sess, dt);\\n    else if (act.family === 'jog') stepJog(sess, dt);\\n    else if (act.family === 'slalom') stepSlalom(sess, dt);\\n    else if (act.family === 'tray') stepTray(sess, dt);\\n    else if (act.family === 'laundry') stepLaundry(sess, dt);\\n    const bal = seat.bal;\\n    if (bal) {\\n      sess.leanX = bal.px; sess.leanY = bal.py;\\n      if (seat.local) { G.lean.ux = seat.ux; G.lean.uy = seat.uy; }\\n    }\\n270→  }\\n\\n  function stepHold(sess, dt) {\\n    const fam = sess.fam;\\n    const c = holdCenter(fam.t);\\n    fam.c = c;\\n    let fx = 0;\\n    const gull = Math.floor(fam.t / 12);\\n    const gph = fam.t % 12;\\n    if (gull > 0 && gph < 0.28) fx = (gull % 2 ? 1 : -1) * 0.7;\\n280→    fam.fx = fx;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i], bal = seat && seat.bal;\\n      if (!bal) continue;\\n      arm(bal, skillName(seat));\\n      bal.step(dt, seat.ux, seat.uy, fx, 0, c);\\n      const pct = clamp(bal.steadiness - 0.05 * bal.falls, 0, 1);\\n      if (i === 0) {\\n290→        sess.pct = pct;\\n        if (sess.tier >= 2 && bal.px) fam.eyes = true;\\n      }\\n      if (many) seat.pct = pct;\\n    }\\n  }\\n\\n  function stepSun(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    fam.guide = guideOf(fam.t);\\n300→    arm(bal, skillName(seat));\\n    if (skillName(seat)) seat.breath = fam.guide;\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const breath = seat.local && !skillName(seat) ? leanFor(seat).breath : seat.breath;\\n    fam.matchN++;\\n    if (Math.abs(breath - fam.guide) <= 0.25) fam.match++;\\n    fam.poseI = Math.min(G.SUN_POSES.length - 1, Math.floor(fam.t / 16));\\n    sess.pct = clamp(0.6 * bal.steadiness + 0.4 * (fam.match / fam.matchN), 0, 1);\\n    if (fam.t >= 80) sess.ended = true;\\n  }\\n310→\\n  function stepCandleOne(sess, seat, box, rng, dt, primary) {\\n    const bal = seat.bal;\\n    if (!bal) return;\\n    arm(bal, skillName(seat));\\n    let fx = 0, fy = 0;\\n    box.thought -= dt;\\n    if (box.thought <= 0) {\\n      box.thought = 4.5 + (rng() * 2);\\n      const ang = rng() * Math.PI * 2;\\n320→      box.tx = Math.cos(ang) * 0.85;\\n      box.ty = Math.sin(ang) * 0.85;\\n      box.tleft = 1.1;\\n      if (sess.tier >= 2 && rng() > 0.5) { box.tx *= 1.3; box.ty *= 1.3; }\\n    }\\n    if (box.tleft > 0) { box.tleft -= dt; fx = box.tx; fy = box.ty; }\\n    bal.step(dt, seat.ux, seat.uy, fx, fy, { x: 0, y: 0 });\\n    const sp = Math.hypot(bal.vx, bal.vy);\\n    const inside = bal.stumble <= 0 && Math.hypot(bal.px, bal.py) < (bal.set.R || 0.2);\\n    if (sp > 0.55) box.flame -= 0.4 * dt;\\n330→    else if (inside) box.flame += 0.12 * dt;\\n    else box.flame -= 0.055 * dt;\\n    box.flame = clamp(box.flame, 0, 1);\\n    if (box.flame <= 0 && !box.relit) { box.relit = true; box.flame = 0.15; }\\n    else if (box.flame <= 0 && box.relit) box.dead = true;\\n    box.flameSum += box.flame;\\n    const moved = Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05;\\n    if (!moved) box.untouched += dt; else box.untouched = 0;\\n    if (primary && box.untouched > 20 && !box.said) { box.said = true; G.subtitle = G.LINES.tare.filter(function (s) { return s.indexOf('controller') >= 0; })[0] || ''; }\\n    const mean = box.flameSum / Math.max(1, bal.frames);\\n340→    const pct = clamp(0.6 * bal.steadiness + 0.4 * mean, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      if (box.dead) sess.ended = true;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepCandle(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n350→    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._candle || (seat._candle = { flame: 1, flameSum: 0, relit: false, dead: false, untouched: 0, thought: 0, tleft: 0, tx: 0, ty: 0, said: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 101) >>> 0)));\\n      stepCandleOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepRepOne(sess, seat, store, dt, primary) {\\n360→    const fam = sess.fam, bal = seat.bal;\\n    if (!bal) return;\\n    drive(seat, fam, dt);\\n    if (store.doneReps === Math.floor(fam.planned * 0.6) && !store.fatigued) {\\n      store.fatigued = true;\\n      const mul = G.dev && G.dev.on ? G.dev.v.fatigue / 1.5 : 1;\\n      bal.set = Object.assign({}, bal.set, { A: bal.set.A * 1.5 * mul, k: bal.set.k * 0.8, kx: 16 * 0.8, ky: 16 * 0.8 });\\n    }\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const depth = fam.axis === 'x' ? clamp(fam.side > 0 ? bal.px : -bal.px, 0, 1) : clamp(-bal.py, 0, 1);\\n370→    const tol = G.dev && G.dev.on ? G.dev.v.repTol : 0.08;\\n    store.err += Math.abs(depth - fam.bead);\\n    store.form += fam.axis === 'x' ? Math.abs(bal.py) : Math.abs(bal.px);\\n    store.samples++;\\n    const cyc = Math.floor(fam.t / fam.cycle);\\n    if (cyc > store.doneReps) {\\n      const meanErr = store.err / Math.max(1, store.samples);\\n      let sc = meanErr <= tol ? 1 : meanErr >= 0.35 ? 0 : (0.35 - meanErr) / (0.35 - tol);\\n      store.scores.push(sc);\\n      store.err = 0; store.samples = 0;\\n380→      store.doneReps = cyc;\\n      if (primary && store.doneReps === fam.planned && !fam.extra) {\\n        const mean = store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length;\\n        if (mean > 0.8) { fam.extra = true; fam.planned += 2; sess.limit += fam.cycle * 2; }\\n      }\\n    }\\n    const form = store.form / Math.max(1, bal.frames);\\n    const pen = clamp(form * 0.45, 0, 0.3);\\n    const mean = store.scores.length ? store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length : 0;\\n    const pct = clamp(mean * (1 - pen), 0, 1);\\n390→    if (primary) sess.pct = pct;\\n    if (sess.classMode) seat.pct = pct;\\n    if (primary && store.doneReps >= fam.planned && store.scores.length >= fam.planned) sess.ended = true;\\n  }\\n\\n  function stepRep(sess, dt) {\\n    const fam = sess.fam;\\n    const prev = fam.bead;\\n    fam.bead = beadOf(fam.t, sess.tier);\\n    fam.beadVel = (fam.bead - prev) / dt;\\n400→    fam.side = (Math.floor(fam.t / fam.cycle) % 2 === 0) ? 1 : -1;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const store = i === 0 ? fam : (seat._rep || (seat._rep = { err: 0, samples: 0, form: 0, scores: [], doneReps: 0, fatigued: false }));\\n      stepRepOne(sess, seat, store, dt, i === 0);\\n    }\\n  }\\n\\n410→  function chartOf(sess) {\\n    const tier = sess.tier;\\n    const chart = G.CHARTS[tier >= 2 ? 't2' : 't1'];\\n    const song = tier >= 2 ? G.SONGS.stepB : G.SONGS.stepA;\\n    const lanes = sess.classMode ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\\n    const scale = G.dev && G.dev.on ? G.dev.v.rhythm : 1;\\n    const rh = new E.Rhythm(G.game, {\\n      song: song, chart: chart, lanes: lanes, life: 4,\\n      windows: { perfect: 45 * scale, great: 90 * scale, good: 135 * scale }\\n    });\\n420→    return rh;\\n  }\\n\\n  function chartMiss(rh) {\\n    if (!rh || !rh.started || rh.done) return;\\n    const A = rh.game.audio, s = A.pos.step, spb = rh._spb();\\n    for (let i = 0; i < rh.notes.length; i++) {\\n      const n = rh.notes[i];\\n      if (n.step > s + 8 * rh.song.steps) break;\\n      if (n.call) continue;\\n430→      if (!n.j && (s - n.step) * spb * 1000 > rh.windows.good) rh._judge(n, 'miss', 0);\\n      if (rh.done) return;\\n    }\\n    const p = A.pos;\\n    if (!p.playing && p.t > 0) rh.done = true;\\n  }\\n\\n  function stepSeatChart(sess, seat) {\\n    if (!seat._rh) {\\n      seat._rh = chartOf(sess);\\n440→      seat._rh.started = true;\\n    }\\n    const rh = seat._rh;\\n    const I = seatInput(seat);\\n    const skill = skillName(seat);\\n    if (skill) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n450→        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    } else if (I) {\\n      rh.lanes.forEach(function (a, i) { if (I.pressed(a)) rh.hit(i); });\\n    }\\n    chartMiss(rh);\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n460→    return judged ? rh.accuracy : 0;\\n  }\\n\\n  function stepStep(sess, dt) {\\n    const fam = sess.fam, rh = fam.rh, seat = sess.seats[0];\\n    if (!rh) return;\\n    const skill = skillName(seat);\\n    if (skill && !sess.classMode) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n470→      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    }\\n    rh.update();\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"offset\":230,\"limit\":250,\"raw_output\":\"    if (spec.gecko) fam.gecko = world.circle(78, gy, 7, { type: 'kinematic', bounce: 0.05, friction: 0.05 });\\n    spec.olives.forEach(function (o) {\\n      const b = world.circle(o.x, o.y, 6, { friction: 0.12, damping: 1.6, bounce: 0.05, density: 0.02, bullet: true });\\n      b._olive = true;\\n    });\\n    world.on.enter = function (sensorBody, other) {\\n      if (!other || !other._olive || other._caught) return;\\n      if (!sensorBody || !sensorBody._glass) return;\\n      other._caught = true;\\n      fam.got++;\\n      try { other.off = true; } catch (e) { /* it has arrived */ }\\n      try { G.game.audio.sfx('plop'); } catch (e) { /* quiet */ }\\n    };\\n    fam.world = world;\\n    fam.trayOlives = spec.olives.length;\\n    fam.trayGot0 = fam.got;\\n  }\\n\\n  function stepFamily(sess, dt) {\\n    const fam = sess.fam, act = sess.act;\\n    if (!fam) return;\\n    fam.t += dt;\\n    const seat = sess.seats[0];\\n    drive(seat, fam, dt);\\n    sess.seats.forEach(function (q, i) { if (i > 0) drive(q, fam, dt); });\\n    if (act.family === 'hold') stepHold(sess, dt);\\n    else if (act.family === 'sun') stepSun(sess, dt);\\n    else if (act.family === 'candle') stepCandle(sess, dt);\\n    else if (act.family === 'rep') stepRep(sess, dt);\\n    else if (act.family === 'step') stepStep(sess, dt);\\n    else if (act.family === 'hoop') stepHoop(sess, dt);\\n    else if (act.family === 'jog') stepJog(sess, dt);\\n    else if (act.family === 'slalom') stepSlalom(sess, dt);\\n    else if (act.family === 'tray') stepTray(sess, dt);\\n    else if (act.family === 'laundry') stepLaundry(sess, dt);\\n    const bal = seat.bal;\\n    if (bal) {\\n      sess.leanX = bal.px; sess.leanY = bal.py;\\n      if (seat.local) { G.lean.ux = seat.ux; G.lean.uy = seat.uy; }\\n    }\\n  }\\n\\n  function stepHold(sess, dt) {\\n    const fam = sess.fam;\\n    const c = holdCenter(fam.t);\\n    fam.c = c;\\n    let fx = 0;\\n    const gull = Math.floor(fam.t / 12);\\n    const gph = fam.t % 12;\\n    if (gull > 0 && gph < 0.28) fx = (gull % 2 ? 1 : -1) * 0.7;\\n    fam.fx = fx;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i], bal = seat && seat.bal;\\n      if (!bal) continue;\\n      arm(bal, skillName(seat));\\n      bal.step(dt, seat.ux, seat.uy, fx, 0, c);\\n      const pct = clamp(bal.steadiness - 0.05 * bal.falls, 0, 1);\\n      if (i === 0) {\\n        sess.pct = pct;\\n        if (sess.tier >= 2 && bal.px) fam.eyes = true;\\n      }\\n      if (many) seat.pct = pct;\\n    }\\n  }\\n\\n  function stepSun(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    fam.guide = guideOf(fam.t);\\n    arm(bal, skillName(seat));\\n    if (skillName(seat)) seat.breath = fam.guide;\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const breath = seat.local && !skillName(seat) ? leanFor(seat).breath : seat.breath;\\n    fam.matchN++;\\n    if (Math.abs(breath - fam.guide) <= 0.25) fam.match++;\\n    fam.poseI = Math.min(G.SUN_POSES.length - 1, Math.floor(fam.t / 16));\\n    sess.pct = clamp(0.6 * bal.steadiness + 0.4 * (fam.match / fam.matchN), 0, 1);\\n    if (fam.t >= 80) sess.ended = true;\\n  }\\n\\n  function stepCandleOne(sess, seat, box, rng, dt, primary) {\\n    const bal = seat.bal;\\n    if (!bal) return;\\n    arm(bal, skillName(seat));\\n    let fx = 0, fy = 0;\\n    box.thought -= dt;\\n    if (box.thought <= 0) {\\n      box.thought = 4.5 + (rng() * 2);\\n      const ang = rng() * Math.PI * 2;\\n      box.tx = Math.cos(ang) * 0.85;\\n      box.ty = Math.sin(ang) * 0.85;\\n      box.tleft = 1.1;\\n      if (sess.tier >= 2 && rng() > 0.5) { box.tx *= 1.3; box.ty *= 1.3; }\\n    }\\n    if (box.tleft > 0) { box.tleft -= dt; fx = box.tx; fy = box.ty; }\\n    bal.step(dt, seat.ux, seat.uy, fx, fy, { x: 0, y: 0 });\\n    const sp = Math.hypot(bal.vx, bal.vy);\\n    const inside = bal.stumble <= 0 && Math.hypot(bal.px, bal.py) < (bal.set.R || 0.2);\\n    if (sp > 0.55) box.flame -= 0.4 * dt;\\n    else if (inside) box.flame += 0.12 * dt;\\n    else box.flame -= 0.055 * dt;\\n    box.flame = clamp(box.flame, 0, 1);\\n    if (box.flame <= 0 && !box.relit) { box.relit = true; box.flame = 0.15; }\\n    else if (box.flame <= 0 && box.relit) box.dead = true;\\n    box.flameSum += box.flame;\\n    const moved = Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05;\\n    if (!moved) box.untouched += dt; else box.untouched = 0;\\n    if (primary && box.untouched > 20 && !box.said) { box.said = true; G.subtitle = G.LINES.tare.filter(function (s) { return s.indexOf('controller') >= 0; })[0] || ''; }\\n    const mean = box.flameSum / Math.max(1, bal.frames);\\n    const pct = clamp(0.6 * bal.steadiness + 0.4 * mean, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      if (box.dead) sess.ended = true;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepCandle(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._candle || (seat._candle = { flame: 1, flameSum: 0, relit: false, dead: false, untouched: 0, thought: 0, tleft: 0, tx: 0, ty: 0, said: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 101) >>> 0)));\\n      stepCandleOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepRepOne(sess, seat, store, dt, primary) {\\n    const fam = sess.fam, bal = seat.bal;\\n    if (!bal) return;\\n    drive(seat, fam, dt);\\n    if (store.doneReps === Math.floor(fam.planned * 0.6) && !store.fatigued) {\\n      store.fatigued = true;\\n      const mul = G.dev && G.dev.on ? G.dev.v.fatigue / 1.5 : 1;\\n      bal.set = Object.assign({}, bal.set, { A: bal.set.A * 1.5 * mul, k: bal.set.k * 0.8, kx: 16 * 0.8, ky: 16 * 0.8 });\\n    }\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const depth = fam.axis === 'x' ? clamp(fam.side > 0 ? bal.px : -bal.px, 0, 1) : clamp(-bal.py, 0, 1);\\n    const tol = G.dev && G.dev.on ? G.dev.v.repTol : 0.08;\\n    store.err += Math.abs(depth - fam.bead);\\n    store.form += fam.axis === 'x' ? Math.abs(bal.py) : Math.abs(bal.px);\\n    store.samples++;\\n    const cyc = Math.floor(fam.t / fam.cycle);\\n    if (cyc > store.doneReps) {\\n      const meanErr = store.err / Math.max(1, store.samples);\\n      let sc = meanErr <= tol ? 1 : meanErr >= 0.35 ? 0 : (0.35 - meanErr) / (0.35 - tol);\\n      store.scores.push(sc);\\n      store.err = 0; store.samples = 0;\\n      store.doneReps = cyc;\\n      if (primary && store.doneReps === fam.planned && !fam.extra) {\\n        const mean = store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length;\\n        if (mean > 0.8) { fam.extra = true; fam.planned += 2; sess.limit += fam.cycle * 2; }\\n      }\\n    }\\n    const form = store.form / Math.max(1, bal.frames);\\n    const pen = clamp(form * 0.45, 0, 0.3);\\n    const mean = store.scores.length ? store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length : 0;\\n    const pct = clamp(mean * (1 - pen), 0, 1);\\n    if (primary) sess.pct = pct;\\n    if (sess.classMode) seat.pct = pct;\\n    if (primary && store.doneReps >= fam.planned && store.scores.length >= fam.planned) sess.ended = true;\\n  }\\n\\n  function stepRep(sess, dt) {\\n    const fam = sess.fam;\\n    const prev = fam.bead;\\n    fam.bead = beadOf(fam.t, sess.tier);\\n    fam.beadVel = (fam.bead - prev) / dt;\\n    fam.side = (Math.floor(fam.t / fam.cycle) % 2 === 0) ? 1 : -1;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const store = i === 0 ? fam : (seat._rep || (seat._rep = { err: 0, samples: 0, form: 0, scores: [], doneReps: 0, fatigued: false }));\\n      stepRepOne(sess, seat, store, dt, i === 0);\\n    }\\n  }\\n\\n  function chartOf(sess) {\\n    const tier = sess.tier;\\n    const chart = G.CHARTS[tier >= 2 ? 't2' : 't1'];\\n    const song = tier >= 2 ? G.SONGS.stepB : G.SONGS.stepA;\\n    const lanes = sess.classMode ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\\n    const scale = G.dev && G.dev.on ? G.dev.v.rhythm : 1;\\n    const rh = new E.Rhythm(G.game, {\\n      song: song, chart: chart, lanes: lanes, life: 4,\\n      windows: { perfect: 45 * scale, great: 90 * scale, good: 135 * scale }\\n    });\\n    return rh;\\n  }\\n\\n  function chartMiss(rh) {\\n    if (!rh || !rh.started || rh.done) return;\\n    const A = rh.game.audio, s = A.pos.step, spb = rh._spb();\\n    for (let i = 0; i < rh.notes.length; i++) {\\n      const n = rh.notes[i];\\n      if (n.step > s + 8 * rh.song.steps) break;\\n      if (n.call) continue;\\n      if (!n.j && (s - n.step) * spb * 1000 > rh.windows.good) rh._judge(n, 'miss', 0);\\n      if (rh.done) return;\\n    }\\n    const p = A.pos;\\n    if (!p.playing && p.t > 0) rh.done = true;\\n  }\\n\\n  function stepSeatChart(sess, seat) {\\n    if (!seat._rh) {\\n      seat._rh = chartOf(sess);\\n      seat._rh.started = true;\\n    }\\n    const rh = seat._rh;\\n    const I = seatInput(seat);\\n    const skill = skillName(seat);\\n    if (skill) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    } else if (I) {\\n      rh.lanes.forEach(function (a, i) { if (I.pressed(a)) rh.hit(i); });\\n    }\\n    chartMiss(rh);\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n    return judged ? rh.accuracy : 0;\\n  }\\n\\n  function stepStep(sess, dt) {\\n    const fam = sess.fam, rh = fam.rh, seat = sess.seats[0];\\n    if (!rh) return;\\n    const skill = skillName(seat);\\n    if (skill && !sess.classMode) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    }\\n    rh.update();\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n\",\"total_lines\":905}}","is_error":false},{"type":"tool_result","tool_use_id":"call-cb6f1b5f-a073-4e4e-8585-bc267af99fe3-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"480→    sess.pct = judged ? rh.accuracy : 0;\\n    if (sess.classMode) {\\n      seat.pct = sess.pct;\\n      for (let i = 1; i < sess.seats.length; i++) {\\n        const q = sess.seats[i];\\n        if (q.scoring === false) { q.pct = 0; continue; }\\n        q.pct = stepSeatChart(sess, q);\\n      }\\n    }\\n    if (rh.done) sess.ended = true;\\n490→    void dt;\\n  }\\n\\n  function stepHoopOne(sess, seat, box, rng, dt, primary) {\\n    const clock = sess.fam.t;\\n    const ux = seat.ux || 0, uy = seat.uy || 0;\\n    const mag = Math.hypot(ux, uy);\\n    let omega = 0;\\n    if (mag > 0.55) {\\n      const ang = Math.atan2(uy, ux);\\n500→      let d = ang - (box.ang || 0);\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      if (box.haveAng) omega = d / dt;\\n      box.ang = ang; box.haveAng = true;\\n    } else box.haveAng = false;\\n    box.omega = omega;\\n    const lo = G.dev && G.dev.on ? G.dev.v.hoopLo : 7;\\n    const hi = G.dev && G.dev.on ? G.dev.v.hoopHi : 11;\\n    const dir = box.otherWay ? -1 : 1;\\n510→    const inBand = Math.abs(omega) >= lo && Math.abs(omega) <= hi && omega * dir > 0;\\n    if (inBand) { box.band += dt; box.out = 0; box.score += dt * (1 + box.hoops * 0.15); }\\n    else if (mag > 0.2) { box.out += dt; if (box.out > 1.5 && box.hoops > 1) { box.hoops--; box.drops++; box.out = 0; } }\\n    if (!box.otherWay && clock >= sess.limit * 0.5) box.otherWay = true;\\n    box.tossT -= dt;\\n    if (box.tossT <= 0) {\\n      box.tossT = 8;\\n      box.toss = { side: rng() < 0.5 ? -1 : 1, eta: 1.1 };\\n    }\\n    if (box.toss) {\\n520→      box.toss.eta -= dt;\\n      const hit = box.toss.side < 0 ? seat.catchL : seat.catchR;\\n      if (hit && Math.abs(box.toss.eta) <= 0.25) { box.caught++; box.hoops = Math.min(6, box.hoops + 1); box.toss = null; }\\n      else if (box.toss.eta < -0.25) box.toss = null;\\n    }\\n    const best = sess.limit * 1.4;\\n    const pct = clamp(box.score / best, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      sess.fam.omega = box.omega;\\n530→      sess.fam.otherWay = box.otherWay;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepHoop(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n540→      const box = i === 0 ? sess.fam : (seat._hoop || (seat._hoop = { omega: 0, ang: 0, band: 0, out: 0, hoops: 1, caught: 0, drops: 0, score: 0, otherWay: false, toss: null, tossT: 2, haveAng: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 131) >>> 0)));\\n      stepHoopOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepJog(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    const edgeL = seat.paceL && !fam.prevL;\\n    const edgeR = seat.paceR && !fam.prevR;\\n550→    fam.prevL = seat.paceL; fam.prevR = seat.paceR;\\n    if (edgeL || edgeR) { fam.steps++; fam.hist.push(fam.t); }\\n    while (fam.hist.length && fam.t - fam.hist[0] > 1) fam.hist.shift();\\n    fam.cad = fam.hist.length;\\n    const lo = G.dev && G.dev.on ? G.dev.v.jogLo : 2.6;\\n    const hi = G.dev && G.dev.on ? G.dev.v.jogHi : 3.4;\\n    const zoned = fam.cad >= lo && fam.cad <= hi && fam.stitch <= 0;\\n    if (zoned) fam.zone += dt;\\n    if (fam.cad > 4.2) fam.sprint += dt; else fam.sprint = 0;\\n    if (fam.sprint > 2 && fam.stitch <= 0) fam.stitch = 3;\\n560→    if (fam.stitch > 0) fam.stitch -= dt;\\n    const speed = (G.dev && G.dev.on ? G.dev.v.jogSpeed : 1) * (zoned ? 8 : 3);\\n    fam.z += speed * dt;\\n    fam.x += (seat.ux || 0) * 1.6 * dt;\\n    const cups = [12, 28, 44, 58];\\n    for (let i = 0; i < cups.length; i++) {\\n      if (fam.gotCup && fam.gotCup[i]) continue;\\n      if (fam.z >= cups[i] && fam.z - speed * dt < cups[i]) {\\n        const cx = (i % 2 ? 0.8 : -0.8);\\n        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\\n570→      }\\n    }\\n    fam.nextCup = null;\\n    for (let i = 0; i < cups.length; i++) if (!(fam.gotCup && fam.gotCup[i]) && fam.z < cups[i]) { fam.nextCup = { x: (i % 2 ? 0.8 : -0.8), z: cups[i] }; break; }\\n    const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n  }\\n\\n  function stepSlalom(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n580→    if (fam.done) return;\\n    if (fam.tumble > 0) { fam.tumble -= dt; return; }\\n    const base = G.dev && G.dev.on ? G.dev.v.skiSpeed : 220;\\n    const turn = G.dev && G.dev.on ? G.dev.v.skiTurn : 1.6;\\n    let spd = base;\\n    if (seat.uy > 0.3) spd *= 1.35;\\n    if (seat.uy < -0.3) spd *= 0.6;\\n    fam.z += spd * dt;\\n    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\\n    const gates = G.GATES;\\n590→    for (let i = 0; i < gates.length; i++) {\\n      const g = gates[i];\\n      if (fam.missed[i]) continue;\\n      if (fam.z >= g.z && fam.z - spd * dt < g.z) {\\n        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\\n        if (fam.missed[i]) fam.pen += 3;\\n      }\\n    }\\n    for (let i = 0; i < G.OBSTACLES.length; i++) {\\n      const o = G.OBSTACLES[i];\\n600→      if (fam.hitO && fam.hitO[i]) continue;\\n      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\\n        fam.hitO = fam.hitO || {}; fam.hitO[i] = true; fam.tumble = 1.2; fam.pen += 1.2;\\n      }\\n    }\\n    let next = null;\\n    for (let i = 0; i < gates.length; i++) if (gates[i].z > fam.z - 20) { next = gates[i]; break; }\\n    fam.nextGate = next;\\n    if (fam.z >= fam.finish) {\\n      fam.done = true;\\n610→      const par = 58, worst = 90;\\n      const time = fam.t + fam.pen;\\n      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function stepTray(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (!seat.bal) {\\n620→      seat.bal = new G.Balance({ k: 14, c: 8, s: 1, A: 0.5, nf: 0.8, R: 0.4, push: null }, sess.seed, {});\\n    }\\n    const sk = skillName(seat);\\n    if (sk) {\\n      const aim = sk === 'poor' ? 0.25 : sk === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    }\\n    seat.bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const Gv = G.dev && G.dev.on ? G.dev.v.trayG : 420;\\n    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\\n630→    if (fam.world) {\\n      if (G.dev && G.dev.on && fam.world.bodies) {\\n        const mu = 0.04 * fr;\\n        fam.world.bodies.forEach(function (b) { if (b && b._olive) b.friction = mu; });\\n      }\\n      if (fam.gecko) fam.gecko.moveTo(78, 100 + Math.sin(fam.t * 0.55) * 36, 0, 22, 0);\\n      fam.world.gravity = [seat.bal.px * Gv, -seat.bal.py * Gv];\\n      fam.world.wake();\\n      fam.world.step(dt);\\n      const spec = G.TRAYS[fam.trayI];\\n640→      const need = spec ? spec.olives.length : 0;\\n      const gotHere = fam.got - fam.trayGot0;\\n      if (gotHere >= need) {\\n        fam.trayI++;\\n        if (fam.trayI >= G.TRAYS.length) { fam.world = null; sess.ended = true; }\\n        else loadTray(sess);\\n      }\\n    } else if (fam.trayI >= G.TRAYS.length) sess.ended = true;\\n    const share = sess.limit > 0 ? clamp((sess.limit - fam.t) / sess.limit, 0, 1) : 0;\\n    const base = fam.total ? fam.got / fam.total : 0;\\n650→    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\\n    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\\n  }\\n\\n  function stepLaundry(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    const skill = skillName(seat);\\n    if (skill) seat.effort = EFFORT[skill] || 0.5;\\n    arm(bal, skill);\\n    const effort = clamp(seat.local && !skill ? leanFor(seat).effort : seat.effort, 0, 1);\\n660→    const spd = effort * 2.2;\\n    if (!fam.rope) fam.rope = Object.assign({}, bal.set);\\n    /* Faster walking sways the rope. The set on the balance is a copy, so the band table stays put.\\n       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\\n    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\\n    bal.set = Object.assign({}, fam.rope, { s: baseS + effort * 4 });\\n    fam.air -= dt;\\n    const pins = [8, 19, 30, 41, 50];\\n    let ahead = null;\\n    for (let i = 0; i < pins.length; i++) {\\n670→      const d = pins[i] - fam.x;\\n      if (d > 0.04) { ahead = { dist: d, x: pins[i] }; break; }\\n    }\\n    fam.pinAhead = ahead;\\n    /* One jump per pin, long enough to land past it. Air freezes the plate, not the walker. */\\n    if (seat.jump && fam.air <= 0 && ahead && fam.cleared !== ahead.x && ahead.dist < 0.95) {\\n      fam.air = Math.min(0.85, ahead.dist / Math.max(0.45, spd) + 0.12);\\n      fam.cleared = ahead.x;\\n    }\\n    bal.holdP = fam.air > 0;\\n680→    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\\n690→       The laundry set's average bot cannot stay up for a whole line; the band table says so, and that table stays. */\\n    let fell = false;\\n    if (ahead && ahead.dist < 0.18 && fam.air <= 0) fell = true;\\n    if (fell) { fam.falls++; fam.x = fam.post; fam.cleared = -1; }\\n    const posts = [0, 18, 36, 55];\\n    for (let i = 0; i < posts.length; i++) if (fam.x >= posts[i]) fam.post = posts[i];\\n    if (!fell) fam.x += spd * dt;\\n    if (fam.x >= fam.len) {\\n      fam.done = true;\\n      const par = 58, worst = 95;\\n700→      const time = fam.t;\\n      let pct = time <= par ? 1 : clamp((worst - time) / (worst - par), 0, 1);\\n      pct = clamp(pct - 0.06 * fam.falls, 0, 1);\\n      sess.pct = pct;\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function scoreNow(sess) {\\n    const act = sess.act, fam = sess.fam;\\n710→    if (!fam) return;\\n    if (act.family === 'hold') {\\n      sess.seats.forEach(function (q, i) {\\n        if (!q.bal) return;\\n        const p = clamp(q.bal.steadiness - 0.05 * q.bal.falls, 0, 1);\\n        if (i === 0) sess.pct = p;\\n        if (sess.classMode) q.pct = p;\\n      });\\n    }\\n    if (act.family === 'slalom' && !fam.done) sess.pct = 0;\\n720→    if (act.family === 'laundry' && !fam.done) sess.pct = 0;\\n    if (act.family === 'jog') {\\n      const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n      sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n    }\\n  }\\n\\n  function Session(opts) {\\n    opts = opts || {};\\n    this.act = G.ACTS[opts.id] || G.ACTS.stork;\\n730→    this.tier = opts.tier || 1;\\n    this.trial = !!opts.trial;\\n    this.cheat = !!opts.cheat;\\n    this.classMode = !!opts.classMode;\\n    this.seed = (opts.seed || 1) >>> 0;\\n    this.rng = E.rng(this.seed);\\n    this.phase = opts.skipToPlay ? 'count' : 'card';\\n    this.t = 0;\\n    this.playTime = 0;\\n    this.limit = opts.limit || this.act.dur[this.tier - 1] || 45;\\n740→    if (this.phase === 'count') this.t = 0;\\n    this.countT = opts.skipToPlay ? 0.4 : 3;\\n    this.demoT = 3;\\n    this.pct = 0;\\n    this.stars = 0;\\n    this.ended = false;\\n    this.awarded = false;\\n    this.seats = opts.seats || [{ name: (G.profile && G.profile.name) || 'You', color: '#ff7a59', local: true, human: true, skill: opts.driver || null }];\\n    if (opts.driver) this.seats[0].skill = opts.driver;\\n    this.driver = opts.driver || null;\\n750→    this.autoNext = !!opts.autoNext;\\n    this.fam = null;\\n    this.line = (G.LINES.tare[this.seed % G.LINES.tare.length]) || '';\\n    G.subtitle = '';\\n  }\\n\\n  Session.prototype.update = function (dt) {\\n    if (G.driver && G.driver !== 'human') {\\n      this.driver = G.driver;\\n      if (this.seats[0] && this.seats[0].local) this.seats[0].skill = G.driver;\\n760→    }\\n    if (this.phase === 'card') {\\n      G.phase = 'menu'; G.left = 0;\\n      return;\\n    }\\n    if (this.phase === 'demo') {\\n      this.demoT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\\n      if (this.demoT <= 0) { this.phase = 'count'; this.countT = 3; }\\n      return;\\n770→    }\\n    if (this.phase === 'count') {\\n      this.countT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.countT);\\n      if (this.countT <= 0) { this.phase = 'play'; this.playTime = 0; this.ended = false; beginFamily(this); }\\n      return;\\n    }\\n    if (this.phase === 'play') {\\n      G.phase = 'play';\\n      this.playTime += dt;\\n780→      stepFamily(this, dt);\\n      G.left = Math.max(0, this.limit - this.playTime);\\n      const timed = this.act.family !== 'rep' && this.act.family !== 'slalom' && this.act.family !== 'laundry' && this.act.family !== 'tray' && this.act.family !== 'step';\\n      if (this.ended || this.playTime >= this.limit || (timed && this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'step' && this.fam && this.fam.rh && this.fam.rh.done) this.finish();\\n      if (this.act.family === 'rep' && this.ended) this.finish();\\n      if (this.act.family === 'slalom' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'laundry' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'tray' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'candle' && this.fam && this.fam.dead) this.finish();\\n790→      return;\\n    }\\n    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\\n  };\\n\\n  Session.prototype.finish = function () {\\n    if (this.phase === 'results') return;\\n    scoreNow(this);\\n    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\\n    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\\n800→    this.pct = clamp(this.pct || 0, 0, 1);\\n    this.stars = G.starsOf(this.pct, this.act.stars);\\n    this.phase = 'results';\\n    G.phase = 'menu'; G.left = 0;\\n    if (this.classMode) {\\n      this.seats.forEach(function (q) {\\n        const sk = skillName(q);\\n        let p = typeof q.pct === 'number' ? q.pct : this.pct;\\n        if (q.scoring === false) p = 0;\\n        else if (!q.local && !sk && !(q.human && q.moved)) p = 0;\\n810→        else if (q.human && !q.local) p = q.moved ? p : 0;\\n        q.pct = p;\\n        q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\\n      }, this);\\n    } else {\\n      this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\\n    }\\n    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\\n    try {\\n      const n = this.stars;\\n820→      G.sting(n >= 3 ? 'star3' : n === 2 ? 'star2' : n === 1 ? 'star1' : null);\\n    } catch (e) { /* quiet */ }\\n  };\\n\\n  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\\n  Session.prototype.again = function () {\\n    const id = this.act.id, tier = this.tier, trial = this.trial, driver = this.driver, limit = this.limit, seats = this.seats, classMode = this.classMode, seed = (this.seed + 1) >>> 0;\\n    const next = new Session({ id: id, tier: tier, trial: trial, driver: driver, limit: limit, seats: seats, classMode: classMode, seed: seed, skipToPlay: false, cheat: this.cheat });\\n    G.session = next;\\n  };\\n830→\\n  G.Session = Session;\\n  G.skillName = skillName;\\n\\n  G.drawActivity = function (r, sess) {\\n    if (!r || !sess) return;\\n    const fam = sess.fam;\\n    G.paintRoom(r, sess.act && sess.act.id === 'slalom' ? 'dusk' : 'day');\\n    if (sess.phase === 'play' || sess.phase === 'results' || sess.phase === 'demo' || sess.phase === 'count') {\\n      try {\\n840→        if (!sess._rig && G.makeRig) {\\n          const look = G.lookColors ? G.lookColors(G.profile) : null;\\n          sess._rig = G.makeRig(G.playerOpts(look, 2.1));\\n        }\\n        if (sess._rig && (sess.phase === 'play' || sess.phase === 'demo')) {\\n          const pose = sess.act.family === 'sun' ? G.SUN_POSES[(fam && fam.poseI) || 0] : sess.act.pose;\\n          if (sess.phase === 'demo') G.poseRig(sess._rig, pose || 'idle', sess.demoT, [0, 0]);\\n          else if (fam && sess.seats[0].bal) {\\n            const b = sess.seats[0].bal;\\n            sess._rig.wob = [b.py, b.px];\\n850→            if (sess.act.family === 'lunge' || sess.act.id === 'lunge') sess._rig.body = G.sideLunge(b.px);\\n            else if (sess.act.id === 'hoop') sess._rig.body = G.hula(fam.ang || 0);\\n            else G.poseRig(sess._rig, pose || 'idle', fam.t, [b.py, b.px]);\\n          }\\n          G.stepRig(sess._rig, DT, 0, 0);\\n          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\\n        }\\n      } catch (e) { /* a painted room still reads */ }\\n    }\\n    r.overlay(function (g) {\\n860→      const W = r.W, H = r.H;\\n      if (sess.phase === 'card') {\\n        G.text(g, sess.act.name, W / 2, 28, '#20404c', 2, 'center');\\n        G.text(g, sess.act.blurb, 16, 52, '#20404c', 1, 'left');\\n        const gates = sess.act.stars;\\n        G.text(g, 'Stars  ' + gates[0] + '   ' + gates[1] + '   ' + gates[2], 16, 78, '#5f7f8a', 1);\\n        const best = G.bestText ? G.bestText(sess.act.id, sess.tier) : '';\\n        if (best) G.text(g, best, 16, 94, '#14a8c8', 1);\\n        G.text(g, 'Tier ' + sess.tier, W - 70, 28, '#14a8c8', 1);\\n      } else if (sess.phase === 'demo') {\\n870→        G.text(g, sess.line, 16, 36, '#20404c', 1);\\n        G.text(g, 'Watch', W / 2, H / 2 - 20, '#14a8c8', 2, 'center');\\n      } else if (sess.phase === 'count') {\\n        const n = Math.max(1, Math.ceil(sess.countT));\\n        E.font.title(g, String(n), W / 2, H / 2 - 20, { scale: 4, align: 'center', colors: ['#ffffff', '#8fd3f4', '#14a8c8'] });\\n        G.text(g, 'Breathe in', W / 2, H / 2 + 18, '#20404c', 1, 'center');\\n      } else if (sess.phase === 'results') {\\n        G.text(g, sess.act.name, W / 2, 24, '#20404c', 2, 'center');\\n        G.drawStars(g, W / 2 - 18, 48, sess.stars);\\n        G.text(g, Math.round(sess.pct * 100) + '%', W / 2, 70, '#20404c', 2, 'center');\",\"content_concise\":\"480→    sess.pct = judged ? rh.accuracy : 0;\\n    if (sess.classMode) {\\n      seat.pct = sess.pct;\\n      for (let i = 1; i < sess.seats.length; i++) {\\n        const q = sess.seats[i];\\n        if (q.scoring === false) { q.pct = 0; continue; }\\n        q.pct = stepSeatChart(sess, q);\\n      }\\n    }\\n    if (rh.done) sess.ended = true;\\n490→    void dt;\\n  }\\n\\n  function stepHoopOne(sess, seat, box, rng, dt, primary) {\\n    const clock = sess.fam.t;\\n    const ux = seat.ux || 0, uy = seat.uy || 0;\\n    const mag = Math.hypot(ux, uy);\\n    let omega = 0;\\n    if (mag > 0.55) {\\n      const ang = Math.atan2(uy, ux);\\n500→      let d = ang - (box.ang || 0);\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      if (box.haveAng) omega = d / dt;\\n      box.ang = ang; box.haveAng = true;\\n    } else box.haveAng = false;\\n    box.omega = omega;\\n    const lo = G.dev && G.dev.on ? G.dev.v.hoopLo : 7;\\n    const hi = G.dev && G.dev.on ? G.dev.v.hoopHi : 11;\\n    const dir = box.otherWay ? -1 : 1;\\n510→    const inBand = Math.abs(omega) >= lo && Math.abs(omega) <= hi && omega * dir > 0;\\n    if (inBand) { box.band += dt; box.out = 0; box.score += dt * (1 + box.hoops * 0.15); }\\n    else if (mag > 0.2) { box.out += dt; if (box.out > 1.5 && box.hoops > 1) { box.hoops--; box.drops++; box.out = 0; } }\\n    if (!box.otherWay && clock >= sess.limit * 0.5) box.otherWay = true;\\n    box.tossT -= dt;\\n    if (box.tossT <= 0) {\\n      box.tossT = 8;\\n      box.toss = { side: rng() < 0.5 ? -1 : 1, eta: 1.1 };\\n    }\\n    if (box.toss) {\\n520→      box.toss.eta -= dt;\\n      const hit = box.toss.side < 0 ? seat.catchL : seat.catchR;\\n      if (hit && Math.abs(box.toss.eta) <= 0.25) { box.caught++; box.hoops = Math.min(6, box.hoops + 1); box.toss = null; }\\n      else if (box.toss.eta < -0.25) box.toss = null;\\n    }\\n    const best = sess.limit * 1.4;\\n    const pct = clamp(box.score / best, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      sess.fam.omega = box.omega;\\n530→      sess.fam.otherWay = box.otherWay;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepHoop(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n540→      const box = i === 0 ? sess.fam : (seat._hoop || (seat._hoop = { omega: 0, ang: 0, band: 0, out: 0, hoops: 1, caught: 0, drops: 0, score: 0, otherWay: false, toss: null, tossT: 2, haveAng: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 131) >>> 0)));\\n      stepHoopOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepJog(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    const edgeL = seat.paceL && !fam.prevL;\\n    const edgeR = seat.paceR && !fam.prevR;\\n550→    fam.prevL = seat.paceL; fam.prevR = seat.paceR;\\n    if (edgeL || edgeR) { fam.steps++; fam.hist.push(fam.t); }\\n    while (fam.hist.length && fam.t - fam.hist[0] > 1) fam.hist.shift();\\n    fam.cad = fam.hist.length;\\n    const lo = G.dev && G.dev.on ? G.dev.v.jogLo : 2.6;\\n    const hi = G.dev && G.dev.on ? G.dev.v.jogHi : 3.4;\\n    const zoned = fam.cad >= lo && fam.cad <= hi && fam.stitch <= 0;\\n    if (zoned) fam.zone += dt;\\n    if (fam.cad > 4.2) fam.sprint += dt; else fam.sprint = 0;\\n    if (fam.sprint > 2 && fam.stitch <= 0) fam.stitch = 3;\\n560→    if (fam.stitch > 0) fam.stitch -= dt;\\n    const speed = (G.dev && G.dev.on ? G.dev.v.jogSpeed : 1) * (zoned ? 8 : 3);\\n    fam.z += speed * dt;\\n    fam.x += (seat.ux || 0) * 1.6 * dt;\\n    const cups = [12, 28, 44, 58];\\n    for (let i = 0; i < cups.length; i++) {\\n      if (fam.gotCup && fam.gotCup[i]) continue;\\n      if (fam.z >= cups[i] && fam.z - speed * dt < cups[i]) {\\n        const cx = (i % 2 ? 0.8 : -0.8);\\n        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\\n570→      }\\n    }\\n    fam.nextCup = null;\\n    for (let i = 0; i < cups.length; i++) if (!(fam.gotCup && fam.gotCup[i]) && fam.z < cups[i]) { fam.nextCup = { x: (i % 2 ? 0.8 : -0.8), z: cups[i] }; break; }\\n    const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n  }\\n\\n  function stepSlalom(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n580→    if (fam.done) return;\\n    if (fam.tumble > 0) { fam.tumble -= dt; return; }\\n    const base = G.dev && G.dev.on ? G.dev.v.skiSpeed : 220;\\n    const turn = G.dev && G.dev.on ? G.dev.v.skiTurn : 1.6;\\n    let spd = base;\\n    if (seat.uy > 0.3) spd *= 1.35;\\n    if (seat.uy < -0.3) spd *= 0.6;\\n    fam.z += spd * dt;\\n    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\\n    const gates = G.GATES;\\n590→    for (let i = 0; i < gates.length; i++) {\\n      const g = gates[i];\\n      if (fam.missed[i]) continue;\\n      if (fam.z >= g.z && fam.z - spd * dt < g.z) {\\n        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\\n        if (fam.missed[i]) fam.pen += 3;\\n      }\\n    }\\n    for (let i = 0; i < G.OBSTACLES.length; i++) {\\n      const o = G.OBSTACLES[i];\\n600→      if (fam.hitO && fam.hitO[i]) continue;\\n      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\\n        fam.hitO = fam.hitO || {}; fam.hitO[i] = true; fam.tumble = 1.2; fam.pen += 1.2;\\n      }\\n    }\\n    let next = null;\\n    for (let i = 0; i < gates.length; i++) if (gates[i].z > fam.z - 20) { next = gates[i]; break; }\\n    fam.nextGate = next;\\n    if (fam.z >= fam.finish) {\\n      fam.done = true;\\n610→      const par = 58, worst = 90;\\n      const time = fam.t + fam.pen;\\n      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function stepTray(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (!seat.bal) {\\n620→      seat.bal = new G.Balance({ k: 14, c: 8, s: 1, A: 0.5, nf: 0.8, R: 0.4, push: null }, sess.seed, {});\\n    }\\n    const sk = skillName(seat);\\n    if (sk) {\\n      const aim = sk === 'poor' ? 0.25 : sk === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    }\\n    seat.bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const Gv = G.dev && G.dev.on ? G.dev.v.trayG : 420;\\n    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\\n630→    if (fam.world) {\\n      if (G.dev && G.dev.on && fam.world.bodies) {\\n        const mu = 0.04 * fr;\\n        fam.world.bodies.forEach(function (b) { if (b && b._olive) b.friction = mu; });\\n      }\\n      if (fam.gecko) fam.gecko.moveTo(78, 100 + Math.sin(fam.t * 0.55) * 36, 0, 22, 0);\\n      fam.world.gravity = [seat.bal.px * Gv, -seat.bal.py * Gv];\\n      fam.world.wake();\\n      fam.world.step(dt);\\n      const spec = G.TRAYS[fam.trayI];\\n640→      const need = spec ? spec.olives.length : 0;\\n      const gotHere = fam.got - fam.trayGot0;\\n      if (gotHere >= need) {\\n        fam.trayI++;\\n        if (fam.trayI >= G.TRAYS.length) { fam.world = null; sess.ended = true; }\\n        else loadTray(sess);\\n      }\\n    } else if (fam.trayI >= G.TRAYS.length) sess.ended = true;\\n    const share = sess.limit > 0 ? clamp((sess.limit - fam.t) / sess.limit, 0, 1) : 0;\\n    const base = fam.total ? fam.got / fam.total : 0;\\n650→    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\\n    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\\n  }\\n\\n  function stepLaundry(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    const skill = skillName(seat);\\n    if (skill) seat.effort = EFFORT[skill] || 0.5;\\n    arm(bal, skill);\\n    const effort = clamp(seat.local && !skill ? leanFor(seat).effort : seat.effort, 0, 1);\\n660→    const spd = effort * 2.2;\\n    if (!fam.rope) fam.rope = Object.assign({}, bal.set);\\n    /* Faster walking sways the rope. The set on the balance is a copy, so the band table stays put.\\n       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\\n    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\\n    bal.set = Object.assign({}, fam.rope, { s: baseS + effort * 4 });\\n    fam.air -= dt;\\n    const pins = [8, 19, 30, 41, 50];\\n    let ahead = null;\\n    for (let i = 0; i < pins.length; i++) {\\n670→      const d = pins[i] - fam.x;\\n      if (d > 0.04) { ahead = { dist: d, x: pins[i] }; break; }\\n    }\\n    fam.pinAhead = ahead;\\n    /* One jump per pin, long enough to land past it. Air freezes the plate, not the walker. */\\n    if (seat.jump && fam.air <= 0 && ahead && fam.cleared !== ahead.x && ahead.dist < 0.95) {\\n      fam.air = Math.min(0.85, ahead.dist / Math.max(0.45, spd) + 0.12);\\n      fam.cleared = ahead.x;\\n    }\\n    bal.holdP = fam.air > 0;\\n680→    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\\n690→       The laundry set's average bot cannot stay up for a whole line; the band table says so, and that table stays. */\\n    let fell = false;\\n    if (ahead && ahead.dist < 0.18 && fam.air <= 0) fell = true;\\n    if (fell) { fam.falls++; fam.x = fam.post; fam.cleared = -1; }\\n    const posts = [0, 18, 36, 55];\\n    for (let i = 0; i < posts.length; i++) if (fam.x >= posts[i]) fam.post = posts[i];\\n    if (!fell) fam.x += spd * dt;\\n    if (fam.x >= fam.len) {\\n      fam.done = true;\\n      const par = 58, worst = 95;\\n700→      const time = fam.t;\\n      let pct = time <= par ? 1 : clamp((worst - time) / (worst - par), 0, 1);\\n      pct = clamp(pct - 0.06 * fam.falls, 0, 1);\\n      sess.pct = pct;\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function scoreNow(sess) {\\n    const act = sess.act, fam = sess.fam;\\n710→    if (!fam) return;\\n    if (act.family === 'hold') {\\n      sess.seats.forEach(function (q, i) {\\n        if (!q.bal) return;\\n        const p = clamp(q.bal.steadiness - 0.05 * q.bal.falls, 0, 1);\\n        if (i === 0) sess.pct = p;\\n        if (sess.classMode) q.pct = p;\\n      });\\n    }\\n    if (act.family === 'slalom' && !fam.done) sess.pct = 0;\\n720→    if (act.family === 'laundry' && !fam.done) sess.pct = 0;\\n    if (act.family === 'jog') {\\n      const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n      sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n    }\\n  }\\n\\n  function Session(opts) {\\n    opts = opts || {};\\n    this.act = G.ACTS[opts.id] || G.ACTS.stork;\\n730→    this.tier = opts.tier || 1;\\n    this.trial = !!opts.trial;\\n    this.cheat = !!opts.cheat;\\n    this.classMode = !!opts.classMode;\\n    this.seed = (opts.seed || 1) >>> 0;\\n    this.rng = E.rng(this.seed);\\n    this.phase = opts.skipToPlay ? 'count' : 'card';\\n    this.t = 0;\\n    this.playTime = 0;\\n    this.limit = opts.limit || this.act.dur[this.tier - 1] || 45;\\n740→    if (this.phase === 'count') this.t = 0;\\n    this.countT = opts.skipToPlay ? 0.4 : 3;\\n    this.demoT = 3;\\n    this.pct = 0;\\n    this.stars = 0;\\n    this.ended = false;\\n    this.awarded = false;\\n    this.seats = opts.seats || [{ name: (G.profile && G.profile.name) || 'You', color: '#ff7a59', local: true, human: true, skill: opts.driver || null }];\\n    if (opts.driver) this.seats[0].skill = opts.driver;\\n    this.driver = opts.driver || null;\\n750→    this.autoNext = !!opts.autoNext;\\n    this.fam = null;\\n    this.line = (G.LINES.tare[this.seed % G.LINES.tare.length]) || '';\\n    G.subtitle = '';\\n  }\\n\\n  Session.prototype.update = function (dt) {\\n    if (G.driver && G.driver !== 'human') {\\n      this.driver = G.driver;\\n      if (this.seats[0] && this.seats[0].local) this.seats[0].skill = G.driver;\\n760→    }\\n    if (this.phase === 'card') {\\n      G.phase = 'menu'; G.left = 0;\\n      return;\\n    }\\n    if (this.phase === 'demo') {\\n      this.demoT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\\n      if (this.demoT <= 0) { this.phase = 'count'; this.countT = 3; }\\n      return;\\n770→    }\\n    if (this.phase === 'count') {\\n      this.countT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.countT);\\n      if (this.countT <= 0) { this.phase = 'play'; this.playTime = 0; this.ended = false; beginFamily(this); }\\n      return;\\n    }\\n    if (this.phase === 'play') {\\n      G.phase = 'play';\\n      this.playTime += dt;\\n780→      stepFamily(this, dt);\\n      G.left = Math.max(0, this.limit - this.playTime);\\n      const timed = this.act.family !== 'rep' && this.act.family !== 'slalom' && this.act.family !== 'laundry' && this.act.family !== 'tray' && this.act.family !== 'step';\\n      if (this.ended || this.playTime >= this.limit || (timed && this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'step' && this.fam && this.fam.rh && this.fam.rh.done) this.finish();\\n      if (this.act.family === 'rep' && this.ended) this.finish();\\n      if (this.act.family === 'slalom' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'laundry' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'tray' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'candle' && this.fam && this.fam.dead) this.finish();\\n790→      return;\\n    }\\n    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\\n  };\\n\\n  Session.prototype.finish = function () {\\n    if (this.phase === 'results') return;\\n    scoreNow(this);\\n    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\\n    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\\n800→    this.pct = clamp(this.pct || 0, 0, 1);\\n    this.stars = G.starsOf(this.pct, this.act.stars);\\n    this.phase = 'results';\\n    G.phase = 'menu'; G.left = 0;\\n    if (this.classMode) {\\n      this.seats.forEach(function (q) {\\n        const sk = skillName(q);\\n        let p = typeof q.pct === 'number' ? q.pct : this.pct;\\n        if (q.scoring === false) p = 0;\\n        else if (!q.local && !sk && !(q.human && q.moved)) p = 0;\\n810→        else if (q.human && !q.local) p = q.moved ? p : 0;\\n        q.pct = p;\\n        q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\\n      }, this);\\n    } else {\\n      this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\\n    }\\n    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\\n    try {\\n      const n = this.stars;\\n820→      G.sting(n >= 3 ? 'star3' : n === 2 ? 'star2' : n === 1 ? 'star1' : null);\\n    } catch (e) { /* quiet */ }\\n  };\\n\\n  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\\n  Session.prototype.again = function () {\\n    const id = this.act.id, tier = this.tier, trial = this.trial, driver = this.driver, limit = this.limit, seats = this.seats, classMode = this.classMode, seed = (this.seed + 1) >>> 0;\\n    const next = new Session({ id: id, tier: tier, trial: trial, driver: driver, limit: limit, seats: seats, classMode: classMode, seed: seed, skipToPlay: false, cheat: this.cheat });\\n    G.session = next;\\n  };\\n830→\\n  G.Session = Session;\\n  G.skillName = skillName;\\n\\n  G.drawActivity = function (r, sess) {\\n    if (!r || !sess) return;\\n    const fam = sess.fam;\\n    G.paintRoom(r, sess.act && sess.act.id === 'slalom' ? 'dusk' : 'day');\\n    if (sess.phase === 'play' || sess.phase === 'results' || sess.phase === 'demo' || sess.phase === 'count') {\\n      try {\\n840→        if (!sess._rig && G.makeRig) {\\n          const look = G.lookColors ? G.lookColors(G.profile) : null;\\n          sess._rig = G.makeRig(G.playerOpts(look, 2.1));\\n        }\\n        if (sess._rig && (sess.phase === 'play' || sess.phase === 'demo')) {\\n          const pose = sess.act.family === 'sun' ? G.SUN_POSES[(fam && fam.poseI) || 0] : sess.act.pose;\\n          if (sess.phase === 'demo') G.poseRig(sess._rig, pose || 'idle', sess.demoT, [0, 0]);\\n          else if (fam && sess.seats[0].bal) {\\n            const b = sess.seats[0].bal;\\n            sess._rig.wob = [b.py, b.px];\\n850→            if (sess.act.family === 'lunge' || sess.act.id === 'lunge') sess._rig.body = G.sideLunge(b.px);\\n            else if (sess.act.id === 'hoop') sess._rig.body = G.hula(fam.ang || 0);\\n            else G.poseRig(sess._rig, pose || 'idle', fam.t, [b.py, b.px]);\\n          }\\n          G.stepRig(sess._rig, DT, 0, 0);\\n          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\\n        }\\n      } catch (e) { /* a painted room still reads */ }\\n    }\\n    r.overlay(function (g) {\\n860→      const W = r.W, H = r.H;\\n      if (sess.phase === 'card') {\\n        G.text(g, sess.act.name, W / 2, 28, '#20404c', 2, 'center');\\n        G.text(g, sess.act.blurb, 16, 52, '#20404c', 1, 'left');\\n        const gates = sess.act.stars;\\n        G.text(g, 'Stars  ' + gates[0] + '   ' + gates[1] + '   ' + gates[2], 16, 78, '#5f7f8a', 1);\\n        const best = G.bestText ? G.bestText(sess.act.id, sess.tier) : '';\\n        if (best) G.text(g, best, 16, 94, '#14a8c8', 1);\\n        G.text(g, 'Tier ' + sess.tier, W - 70, 28, '#14a8c8', 1);\\n      } else if (sess.phase === 'demo') {\\n870→        G.text(g, sess.line, 16, 36, '#20404c', 1);\\n        G.text(g, 'Watch', W / 2, H / 2 - 20, '#14a8c8', 2, 'center');\\n      } else if (sess.phase === 'count') {\\n        const n = Math.max(1, Math.ceil(sess.countT));\\n        E.font.title(g, String(n), W / 2, H / 2 - 20, { scale: 4, align: 'center', colors: ['#ffffff', '#8fd3f4', '#14a8c8'] });\\n        G.text(g, 'Breathe in', W / 2, H / 2 + 18, '#20404c', 1, 'center');\\n      } else if (sess.phase === 'results') {\\n        G.text(g, sess.act.name, W / 2, 24, '#20404c', 2, 'center');\\n        G.drawStars(g, W / 2 - 18, 48, sess.stars);\\n        G.text(g, Math.round(sess.pct * 100) + '%', W / 2, 70, '#20404c', 2, 'center');\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"offset\":480,\"limit\":400,\"raw_output\":\"    sess.pct = judged ? rh.accuracy : 0;\\n    if (sess.classMode) {\\n      seat.pct = sess.pct;\\n      for (let i = 1; i < sess.seats.length; i++) {\\n        const q = sess.seats[i];\\n        if (q.scoring === false) { q.pct = 0; continue; }\\n        q.pct = stepSeatChart(sess, q);\\n      }\\n    }\\n    if (rh.done) sess.ended = true;\\n    void dt;\\n  }\\n\\n  function stepHoopOne(sess, seat, box, rng, dt, primary) {\\n    const clock = sess.fam.t;\\n    const ux = seat.ux || 0, uy = seat.uy || 0;\\n    const mag = Math.hypot(ux, uy);\\n    let omega = 0;\\n    if (mag > 0.55) {\\n      const ang = Math.atan2(uy, ux);\\n      let d = ang - (box.ang || 0);\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      if (box.haveAng) omega = d / dt;\\n      box.ang = ang; box.haveAng = true;\\n    } else box.haveAng = false;\\n    box.omega = omega;\\n    const lo = G.dev && G.dev.on ? G.dev.v.hoopLo : 7;\\n    const hi = G.dev && G.dev.on ? G.dev.v.hoopHi : 11;\\n    const dir = box.otherWay ? -1 : 1;\\n    const inBand = Math.abs(omega) >= lo && Math.abs(omega) <= hi && omega * dir > 0;\\n    if (inBand) { box.band += dt; box.out = 0; box.score += dt * (1 + box.hoops * 0.15); }\\n    else if (mag > 0.2) { box.out += dt; if (box.out > 1.5 && box.hoops > 1) { box.hoops--; box.drops++; box.out = 0; } }\\n    if (!box.otherWay && clock >= sess.limit * 0.5) box.otherWay = true;\\n    box.tossT -= dt;\\n    if (box.tossT <= 0) {\\n      box.tossT = 8;\\n      box.toss = { side: rng() < 0.5 ? -1 : 1, eta: 1.1 };\\n    }\\n    if (box.toss) {\\n      box.toss.eta -= dt;\\n      const hit = box.toss.side < 0 ? seat.catchL : seat.catchR;\\n      if (hit && Math.abs(box.toss.eta) <= 0.25) { box.caught++; box.hoops = Math.min(6, box.hoops + 1); box.toss = null; }\\n      else if (box.toss.eta < -0.25) box.toss = null;\\n    }\\n    const best = sess.limit * 1.4;\\n    const pct = clamp(box.score / best, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      sess.fam.omega = box.omega;\\n      sess.fam.otherWay = box.otherWay;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepHoop(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._hoop || (seat._hoop = { omega: 0, ang: 0, band: 0, out: 0, hoops: 1, caught: 0, drops: 0, score: 0, otherWay: false, toss: null, tossT: 2, haveAng: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 131) >>> 0)));\\n      stepHoopOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepJog(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    const edgeL = seat.paceL && !fam.prevL;\\n    const edgeR = seat.paceR && !fam.prevR;\\n    fam.prevL = seat.paceL; fam.prevR = seat.paceR;\\n    if (edgeL || edgeR) { fam.steps++; fam.hist.push(fam.t); }\\n    while (fam.hist.length && fam.t - fam.hist[0] > 1) fam.hist.shift();\\n    fam.cad = fam.hist.length;\\n    const lo = G.dev && G.dev.on ? G.dev.v.jogLo : 2.6;\\n    const hi = G.dev && G.dev.on ? G.dev.v.jogHi : 3.4;\\n    const zoned = fam.cad >= lo && fam.cad <= hi && fam.stitch <= 0;\\n    if (zoned) fam.zone += dt;\\n    if (fam.cad > 4.2) fam.sprint += dt; else fam.sprint = 0;\\n    if (fam.sprint > 2 && fam.stitch <= 0) fam.stitch = 3;\\n    if (fam.stitch > 0) fam.stitch -= dt;\\n    const speed = (G.dev && G.dev.on ? G.dev.v.jogSpeed : 1) * (zoned ? 8 : 3);\\n    fam.z += speed * dt;\\n    fam.x += (seat.ux || 0) * 1.6 * dt;\\n    const cups = [12, 28, 44, 58];\\n    for (let i = 0; i < cups.length; i++) {\\n      if (fam.gotCup && fam.gotCup[i]) continue;\\n      if (fam.z >= cups[i] && fam.z - speed * dt < cups[i]) {\\n        const cx = (i % 2 ? 0.8 : -0.8);\\n        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\\n      }\\n    }\\n    fam.nextCup = null;\\n    for (let i = 0; i < cups.length; i++) if (!(fam.gotCup && fam.gotCup[i]) && fam.z < cups[i]) { fam.nextCup = { x: (i % 2 ? 0.8 : -0.8), z: cups[i] }; break; }\\n    const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n  }\\n\\n  function stepSlalom(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (fam.done) return;\\n    if (fam.tumble > 0) { fam.tumble -= dt; return; }\\n    const base = G.dev && G.dev.on ? G.dev.v.skiSpeed : 220;\\n    const turn = G.dev && G.dev.on ? G.dev.v.skiTurn : 1.6;\\n    let spd = base;\\n    if (seat.uy > 0.3) spd *= 1.35;\\n    if (seat.uy < -0.3) spd *= 0.6;\\n    fam.z += spd * dt;\\n    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\\n    const gates = G.GATES;\\n    for (let i = 0; i < gates.length; i++) {\\n      const g = gates[i];\\n      if (fam.missed[i]) continue;\\n      if (fam.z >= g.z && fam.z - spd * dt < g.z) {\\n        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\\n        if (fam.missed[i]) fam.pen += 3;\\n      }\\n    }\\n    for (let i = 0; i < G.OBSTACLES.length; i++) {\\n      const o = G.OBSTACLES[i];\\n      if (fam.hitO && fam.hitO[i]) continue;\\n      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\\n        fam.hitO = fam.hitO || {}; fam.hitO[i] = true; fam.tumble = 1.2; fam.pen += 1.2;\\n      }\\n    }\\n    let next = null;\\n    for (let i = 0; i < gates.length; i++) if (gates[i].z > fam.z - 20) { next = gates[i]; break; }\\n    fam.nextGate = next;\\n    if (fam.z >= fam.finish) {\\n      fam.done = true;\\n      const par = 58, worst = 90;\\n      const time = fam.t + fam.pen;\\n      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function stepTray(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (!seat.bal) {\\n      seat.bal = new G.Balance({ k: 14, c: 8, s: 1, A: 0.5, nf: 0.8, R: 0.4, push: null }, sess.seed, {});\\n    }\\n    const sk = skillName(seat);\\n    if (sk) {\\n      const aim = sk === 'poor' ? 0.25 : sk === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    }\\n    seat.bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const Gv = G.dev && G.dev.on ? G.dev.v.trayG : 420;\\n    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\\n    if (fam.world) {\\n      if (G.dev && G.dev.on && fam.world.bodies) {\\n        const mu = 0.04 * fr;\\n        fam.world.bodies.forEach(function (b) { if (b && b._olive) b.friction = mu; });\\n      }\\n      if (fam.gecko) fam.gecko.moveTo(78, 100 + Math.sin(fam.t * 0.55) * 36, 0, 22, 0);\\n      fam.world.gravity = [seat.bal.px * Gv, -seat.bal.py * Gv];\\n      fam.world.wake();\\n      fam.world.step(dt);\\n      const spec = G.TRAYS[fam.trayI];\\n      const need = spec ? spec.olives.length : 0;\\n      const gotHere = fam.got - fam.trayGot0;\\n      if (gotHere >= need) {\\n        fam.trayI++;\\n        if (fam.trayI >= G.TRAYS.length) { fam.world = null; sess.ended = true; }\\n        else loadTray(sess);\\n      }\\n    } else if (fam.trayI >= G.TRAYS.length) sess.ended = true;\\n    const share = sess.limit > 0 ? clamp((sess.limit - fam.t) / sess.limit, 0, 1) : 0;\\n    const base = fam.total ? fam.got / fam.total : 0;\\n    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\\n    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\\n  }\\n\\n  function stepLaundry(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    const skill = skillName(seat);\\n    if (skill) seat.effort = EFFORT[skill] || 0.5;\\n    arm(bal, skill);\\n    const effort = clamp(seat.local && !skill ? leanFor(seat).effort : seat.effort, 0, 1);\\n    const spd = effort * 2.2;\\n    if (!fam.rope) fam.rope = Object.assign({}, bal.set);\\n    /* Faster walking sways the rope. The set on the balance is a copy, so the band table stays put.\\n       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\\n    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\\n    bal.set = Object.assign({}, fam.rope, { s: baseS + effort * 4 });\\n    fam.air -= dt;\\n    const pins = [8, 19, 30, 41, 50];\\n    let ahead = null;\\n    for (let i = 0; i < pins.length; i++) {\\n      const d = pins[i] - fam.x;\\n      if (d > 0.04) { ahead = { dist: d, x: pins[i] }; break; }\\n    }\\n    fam.pinAhead = ahead;\\n    /* One jump per pin, long enough to land past it. Air freezes the plate, not the walker. */\\n    if (seat.jump && fam.air <= 0 && ahead && fam.cleared !== ahead.x && ahead.dist < 0.95) {\\n      fam.air = Math.min(0.85, ahead.dist / Math.max(0.45, spd) + 0.12);\\n      fam.cleared = ahead.x;\\n    }\\n    bal.holdP = fam.air > 0;\\n    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\\n       The laundry set's average bot cannot stay up for a whole line; the band table says so, and that table stays. */\\n    let fell = false;\\n    if (ahead && ahead.dist < 0.18 && fam.air <= 0) fell = true;\\n    if (fell) { fam.falls++; fam.x = fam.post; fam.cleared = -1; }\\n    const posts = [0, 18, 36, 55];\\n    for (let i = 0; i < posts.length; i++) if (fam.x >= posts[i]) fam.post = posts[i];\\n    if (!fell) fam.x += spd * dt;\\n    if (fam.x >= fam.len) {\\n      fam.done = true;\\n      const par = 58, worst = 95;\\n      const time = fam.t;\\n      let pct = time <= par ? 1 : clamp((worst - time) / (worst - par), 0, 1);\\n      pct = clamp(pct - 0.06 * fam.falls, 0, 1);\\n      sess.pct = pct;\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function scoreNow(sess) {\\n    const act = sess.act, fam = sess.fam;\\n    if (!fam) return;\\n    if (act.family === 'hold') {\\n      sess.seats.forEach(function (q, i) {\\n        if (!q.bal) return;\\n        const p = clamp(q.bal.steadiness - 0.05 * q.bal.falls, 0, 1);\\n        if (i === 0) sess.pct = p;\\n        if (sess.classMode) q.pct = p;\\n      });\\n    }\\n    if (act.family === 'slalom' && !fam.done) sess.pct = 0;\\n    if (act.family === 'laundry' && !fam.done) sess.pct = 0;\\n    if (act.family === 'jog') {\\n      const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n      sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n    }\\n  }\\n\\n  function Session(opts) {\\n    opts = opts || {};\\n    this.act = G.ACTS[opts.id] || G.ACTS.stork;\\n    this.tier = opts.tier || 1;\\n    this.trial = !!opts.trial;\\n    this.cheat = !!opts.cheat;\\n    this.classMode = !!opts.classMode;\\n    this.seed = (opts.seed || 1) >>> 0;\\n    this.rng = E.rng(this.seed);\\n    this.phase = opts.skipToPlay ? 'count' : 'card';\\n    this.t = 0;\\n    this.playTime = 0;\\n    this.limit = opts.limit || this.act.dur[this.tier - 1] || 45;\\n    if (this.phase === 'count') this.t = 0;\\n    this.countT = opts.skipToPlay ? 0.4 : 3;\\n    this.demoT = 3;\\n    this.pct = 0;\\n    this.stars = 0;\\n    this.ended = false;\\n    this.awarded = false;\\n    this.seats = opts.seats || [{ name: (G.profile && G.profile.name) || 'You', color: '#ff7a59', local: true, human: true, skill: opts.driver || null }];\\n    if (opts.driver) this.seats[0].skill = opts.driver;\\n    this.driver = opts.driver || null;\\n    this.autoNext = !!opts.autoNext;\\n    this.fam = null;\\n    this.line = (G.LINES.tare[this.seed % G.LINES.tare.length]) || '';\\n    G.subtitle = '';\\n  }\\n\\n  Session.prototype.update = function (dt) {\\n    if (G.driver && G.driver !== 'human') {\\n      this.driver = G.driver;\\n      if (this.seats[0] && this.seats[0].local) this.seats[0].skill = G.driver;\\n    }\\n    if (this.phase === 'card') {\\n      G.phase = 'menu'; G.left = 0;\\n      return;\\n    }\\n    if (this.phase === 'demo') {\\n      this.demoT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\\n      if (this.demoT <= 0) { this.phase = 'count'; this.countT = 3; }\\n      return;\\n    }\\n    if (this.phase === 'count') {\\n      this.countT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.countT);\\n      if (this.countT <= 0) { this.phase = 'play'; this.playTime = 0; this.ended = false; beginFamily(this); }\\n      return;\\n    }\\n    if (this.phase === 'play') {\\n      G.phase = 'play';\\n      this.playTime += dt;\\n      stepFamily(this, dt);\\n      G.left = Math.max(0, this.limit - this.playTime);\\n      const timed = this.act.family !== 'rep' && this.act.family !== 'slalom' && this.act.family !== 'laundry' && this.act.family !== 'tray' && this.act.family !== 'step';\\n      if (this.ended || this.playTime >= this.limit || (timed && this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'step' && this.fam && this.fam.rh && this.fam.rh.done) this.finish();\\n      if (this.act.family === 'rep' && this.ended) this.finish();\\n      if (this.act.family === 'slalom' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'laundry' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'tray' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'candle' && this.fam && this.fam.dead) this.finish();\\n      return;\\n    }\\n    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\\n  };\\n\\n  Session.prototype.finish = function () {\\n    if (this.phase === 'results') return;\\n    scoreNow(this);\\n    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\\n    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\\n    this.pct = clamp(this.pct || 0, 0, 1);\\n    this.stars = G.starsOf(this.pct, this.act.stars);\\n    this.phase = 'results';\\n    G.phase = 'menu'; G.left = 0;\\n    if (this.classMode) {\\n      this.seats.forEach(function (q) {\\n        const sk = skillName(q);\\n        let p = typeof q.pct === 'number' ? q.pct : this.pct;\\n        if (q.scoring === false) p = 0;\\n        else if (!q.local && !sk && !(q.human && q.moved)) p = 0;\\n        else if (q.human && !q.local) p = q.moved ? p : 0;\\n        q.pct = p;\\n        q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\\n      }, this);\\n    } else {\\n      this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\\n    }\\n    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\\n    try {\\n      const n = this.stars;\\n      G.sting(n >= 3 ? 'star3' : n === 2 ? 'star2' : n === 1 ? 'star1' : null);\\n    } catch (e) { /* quiet */ }\\n  };\\n\\n  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\\n  Session.prototype.again = function () {\\n    const id = this.act.id, tier = this.tier, trial = this.trial, driver = this.driver, limit = this.limit, seats = this.seats, classMode = this.classMode, seed = (this.seed + 1) >>> 0;\\n    const next = new Session({ id: id, tier: tier, trial: trial, driver: driver, limit: limit, seats: seats, classMode: classMode, seed: seed, skipToPlay: false, cheat: this.cheat });\\n    G.session = next;\\n  };\\n\\n  G.Session = Session;\\n  G.skillName = skillName;\\n\\n  G.drawActivity = function (r, sess) {\\n    if (!r || !sess) return;\\n    const fam = sess.fam;\\n    G.paintRoom(r, sess.act && sess.act.id === 'slalom' ? 'dusk' : 'day');\\n    if (sess.phase === 'play' || sess.phase === 'results' || sess.phase === 'demo' || sess.phase === 'count') {\\n      try {\\n        if (!sess._rig && G.makeRig) {\\n          const look = G.lookColors ? G.lookColors(G.profile) : null;\\n          sess._rig = G.makeRig(G.playerOpts(look, 2.1));\\n        }\\n        if (sess._rig && (sess.phase === 'play' || sess.phase === 'demo')) {\\n          const pose = sess.act.family === 'sun' ? G.SUN_POSES[(fam && fam.poseI) || 0] : sess.act.pose;\\n          if (sess.phase === 'demo') G.poseRig(sess._rig, pose || 'idle', sess.demoT, [0, 0]);\\n          else if (fam && sess.seats[0].bal) {\\n            const b = sess.seats[0].bal;\\n            sess._rig.wob = [b.py, b.px];\\n            if (sess.act.family === 'lunge' || sess.act.id === 'lunge') sess._rig.body = G.sideLunge(b.px);\\n            else if (sess.act.id === 'hoop') sess._rig.body = G.hula(fam.ang || 0);\\n            else G.poseRig(sess._rig, pose || 'idle', fam.t, [b.py, b.px]);\\n          }\\n          G.stepRig(sess._rig, DT, 0, 0);\\n          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\\n        }\\n      } catch (e) { /* a painted room still reads */ }\\n    }\\n    r.overlay(function (g) {\\n      const W = r.W, H = r.H;\\n      if (sess.phase === 'card') {\\n        G.text(g, sess.act.name, W / 2, 28, '#20404c', 2, 'center');\\n        G.text(g, sess.act.blurb, 16, 52, '#20404c', 1, 'left');\\n        const gates = sess.act.stars;\\n        G.text(g, 'Stars  ' + gates[0] + '   ' + gates[1] + '   ' + gates[2], 16, 78, '#5f7f8a', 1);\\n        const best = G.bestText ? G.bestText(sess.act.id, sess.tier) : '';\\n        if (best) G.text(g, best, 16, 94, '#14a8c8', 1);\\n        G.text(g, 'Tier ' + sess.tier, W - 70, 28, '#14a8c8', 1);\\n      } else if (sess.phase === 'demo') {\\n        G.text(g, sess.line, 16, 36, '#20404c', 1);\\n        G.text(g, 'Watch', W / 2, H / 2 - 20, '#14a8c8', 2, 'center');\\n      } else if (sess.phase === 'count') {\\n        const n = Math.max(1, Math.ceil(sess.countT));\\n        E.font.title(g, String(n), W / 2, H / 2 - 20, { scale: 4, align: 'center', colors: ['#ffffff', '#8fd3f4', '#14a8c8'] });\\n        G.text(g, 'Breathe in', W / 2, H / 2 + 18, '#20404c', 1, 'center');\\n      } else if (sess.phase === 'results') {\\n        G.text(g, sess.act.name, W / 2, 24, '#20404c', 2, 'center');\\n        G.drawStars(g, W / 2 - 18, 48, sess.stars);\\n        G.text(g, Math.round(sess.pct * 100) + '%', W / 2, 70, '#20404c', 2, 'center');\\n\",\"total_lines\":905}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"6f3df372-35ae-499f-9666-27450a01af3a"}
{"type":"assistant","message":{"id":"msg_699","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I need to verify that the four prior gaps are genuinely fixed.I need to continue reading finish(), class scoring, world.js morning classes and ghosts, ui.js dev panel, and the tests.\n\nThe code review reveals the first gap persists. `stepStep` in play.js still uses `sess.seats[0]` exclusively, so `finish()` ignores skillName and applies one percentage to every scoring seat. Step Class is also a local class activity affected by this bug.\n\nThe local class scoring gap requires per-player intent and per-seat balances. finish() currently copies one percentage onto every seat. stepFamily drives all seats. stepHold, stepCandle, stepRep,","signature":""},{"type":"text","text":"The prior gaps sit in"},{"type":"thinking","thinking":" and stepHoop iterate","signature":""},{"type":"text","text":" Local Class scoring, Morning Class"},{"type":"thinking","thinking":" all seats when classMode","signature":""},{"type":"text","text":" driver,"},{"type":"thinking","thinking":" is active. stepStep","signature":""},{"type":"text","text":" ghost drawing, and the"},{"type":"thinking","thinking":" only adds extra charts","signature":""},{"type":"text","text":" dev panel. I'll"},{"type":"thinking","thinking":" for seats after index","signature":""},{"type":"text","text":" read those paths and"},{"type":"thinking","thinking":" zero.","signature":""},{"type":"text","text":" the tests that claim they pass."},{"type":"thinking","thinking":"\n\nfinish() now uses per-seat percentages. It checks q.pct first, then falls back to this.pct. This fixes the prior bug where one percentage was copied onto every seat.","signature":""},{"type":"tool_use","id":"call-a9e1b91f-99b7-47af-acde-2ee7ead8fa58-5","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js","offset":1,"limit":180}},{"type":"tool_use","id":"call-a9e1b91f-99b7-47af-acde-2ee7ead8fa58-6","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js","offset":240,"limit":450}},{"type":"tool_use","id":"call-a9e1b91f-99b7-47af-acde-2ee7ead8fa58-7","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/ui.js","offset":140,"limit":250}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8610,"output_tokens":697,"cache_read_input_tokens":30848,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"539dffe6-f8b9-42ef-a10b-c501a8932ca0"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-a9e1b91f-99b7-47af-acde-2ee7ead8fa58-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/* Every activity. One session walks the card, the demo, the count, the play, and the stamp. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const DT = 1 / 120;\\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n  const LEAD = { poor: -0.4, average: 0.05, good: 0.14, expert: 0.2 };\\n  const STEP_OFF = { poor: 0.1, average: 0.03, good: 0.015, expert: 0.008 };\\n10→  const EFFORT = { poor: 0.28, average: 0.5, good: 0.62, expert: 0.72 };\\n\\n  function skillName(seat) {\\n    if (G.dev && G.dev.on && G.dev.bot && seat && seat.local && G.BOTS[G.dev.bot]) return G.dev.bot;\\n    const d = G.driver && G.driver !== 'human' ? G.driver : (seat && seat.skill);\\n    if (!d || d === 'passive' || d === 'human') return null;\\n    return G.BOTS[d] ? d : null;\\n  }\\n\\n  /* The lean that belongs to this seat. Seat 0 is G.lean, so a solo session is unchanged. */\\n20→  function leanFor(seat) {\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (G.leans && G.leans[i]) return G.leans[i];\\n    return G.lean;\\n  }\\n\\n  function seatInput(seat) {\\n    const ps = G.game && G.game.players;\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (ps && ps[i]) return ps[i];\\n30→    return G.game ? G.game.input : null;\\n  }\\n\\n  function arm(bal, skill) {\\n    if (!bal) return;\\n    if (!skill) { bal.skill = null; bal.bot = null; return; }\\n    if (bal.skill === skill && bal.bot) return;\\n    bal.skill = skill;\\n    const br = E.rng((bal.seed ^ 0x9e3779b9) >>> 0);\\n    const b = G.BOTS[skill];\\n40→    bal.bnx = function (t) { return (Math.sin(t * .35 + 1.1) + .6 * Math.sin(t * .35 * 1.73 + 2.2)) / 1.6; };\\n    bal.bny = function (t) { return (Math.sin(t * .41 + 0.4) + .6 * Math.sin(t * .41 * 1.17 + 1.7)) / 1.6; };\\n    void br;\\n    bal.bot = b;\\n  }\\n\\n  /* A seat's hands. A named skill drives the activity bots. A hold skill is applied on the balance itself. */\\n  function drive(seat, fam, dt) {\\n    const skill = skillName(seat);\\n    const human = !skill && !(G.driver === 'passive' || (seat && seat.skill === 'passive'));\\n50→    if (human && seat && seat.local) {\\n      const L = leanFor(seat);\\n      seat.ux = L.ux; seat.uy = L.uy;\\n      seat.breath = L.breath; seat.effort = L.effort;\\n      seat.jump = L.jump; seat.catchL = L.catchL; seat.catchR = L.catchR;\\n      seat.paceL = L.paceL; seat.paceR = L.paceR;\\n      if (Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05) seat.moved = true;\\n      return;\\n    }\\n    seat.ux = 0; seat.uy = 0; seat.breath = 0; seat.effort = 0;\\n60→    seat.jump = false; seat.catchL = false; seat.catchR = false; seat.paceL = false; seat.paceR = false;\\n    if (!skill) return;\\n    const kind = fam && fam.kind;\\n    if (kind === 'rep') {\\n      const lead = LEAD[skill];\\n      const bead = fam.bead, vel = fam.beadVel || 0;\\n      const sign = vel > 0.002 ? 1 : vel < -0.002 ? -1 : 0;\\n      /* Expert servos onto the bead. A fixed lead sits well on tier 1 and misses tier 2's fast rise. */\\n      let target = bead + lead * sign;\\n      const bal = seat.bal;\\n70→      if (skill === 'expert' && bal) {\\n        const depth = fam.axis === 'x' ? (fam.side > 0 ? bal.px : -bal.px) : -bal.py;\\n        const rate = fam.axis === 'x' ? (fam.side > 0 ? bal.vx : -bal.vx) : -bal.vy;\\n        const P = 2.6, D = 0.35;\\n        target = bead + P * (bead - depth) + D * (vel - rate);\\n      }\\n      target = clamp(target, -0.2, 1.25);\\n      if (fam.axis === 'x') {\\n        seat.ux = fam.side * target;\\n        seat.uy = skill === 'expert' && bal ? clamp(-bal.py * 1.6, -0.6, 0.6) : 0;\\n80→      } else {\\n        seat.uy = -target;\\n        seat.ux = skill === 'expert' && bal ? clamp(-bal.px * 1.6, -0.6, 0.6) : 0;\\n      }\\n    } else if (kind === 'sun') {\\n      seat.breath = fam.guide;\\n    } else if (kind === 'hoop') {\\n      const w = skill === 'poor' ? 4.2 : 9;\\n      seat.botPh = (seat.botPh || 0) + w * dt * (fam.otherWay ? -1 : 1);\\n      seat.ux = Math.cos(seat.botPh); seat.uy = Math.sin(seat.botPh);\\n90→      if (fam.toss && Math.abs(fam.toss.eta) < 0.12) {\\n        if (fam.toss.side < 0) seat.catchL = true; else seat.catchR = true;\\n      }\\n    } else if (kind === 'jog') {\\n      const hz = skill === 'poor' ? 1.4 : 3.0;\\n      fam.footT = (fam.footT || 0) + dt;\\n      if (fam.footT >= 1 / hz) { fam.footT = 0; fam.foot = !fam.foot; fam.stepEdge = fam.foot ? 'L' : 'R'; }\\n      seat.paceL = fam.stepEdge === 'L'; seat.paceR = fam.stepEdge === 'R';\\n      const cup = fam.nextCup;\\n      seat.ux = cup ? clamp((cup.x - fam.x) / 1.2, -1, 1) : 0;\\n100→      seat.uy = 0.2;\\n    } else if (kind === 'slalom') {\\n      const gate = fam.nextGate;\\n      const err = gate ? gate.x - fam.x : 0;\\n      const steer = skill === 'poor' ? 0.25 : skill === 'average' ? 0.85 : 1;\\n      seat.ux = clamp(err / 36, -1, 1) * steer;\\n      seat.uy = 0;\\n    } else if (kind === 'tray') {\\n      const aim = skill === 'poor' ? 0.25 : skill === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n110→    } else if (kind === 'laundry') {\\n      seat.effort = EFFORT[skill] || 0.5;\\n      const pin = fam.pinAhead;\\n      seat.jump = !!(pin && pin.dist < 1.2 && pin.dist > 0.08);\\n    }\\n  }\\n\\n  function setOf(act, tier, gentle) {\\n    const name = act.set ? act.set[tier - 1] : null;\\n    let s = name && G.SETS[name] ? G.SETS[name] : { k: 14, c: 7, s: 4, A: 1.2, nf: 1, R: .3, push: null };\\n120→    if (gentle) s = G.gentleSet(s, true);\\n    return s;\\n  }\\n\\n  function repSet(axis) {\\n    const o = { k: 16, c: 8, s: 0, A: 0.35, nf: 0.7, R: 0.55, push: null, kx: 16, ky: 16, cx: 8, cy: 8 };\\n    if (axis === 'x') { o.sx = 0; o.sy = 8; }\\n    else { o.sx = 8; o.sy = 0; }\\n    return o;\\n  }\\n130→\\n  function holdCenter(t) {\\n    const i = Math.floor(t / 12);\\n    const a = i * 2.4;\\n    return { x: Math.cos(a) * 0.06, y: Math.sin(a * 1.3) * 0.05 };\\n  }\\n\\n  function beadOf(t, tier) {\\n    if (tier >= 2) {\\n      const u = t % 5;\\n140→      if (u < 3) return u / 3;\\n      if (u < 4) return 1;\\n      return 1 - (u - 4);\\n    }\\n    const u = t % 4;\\n    return u < 2 ? u / 2 : 1 - (u - 2) / 2;\\n  }\\n\\n  function guideOf(t) {\\n    const u = (t % 8) / 4;\\n150→    return u < 1 ? u : 2 - u;\\n  }\\n\\n  /* ---- families ---- */\\n  function beginFamily(sess) {\\n    const act = sess.act, tier = sess.tier, seat = sess.seats[0];\\n    const gentle = !!(G.game && G.game.settings && G.game.settings.gentle);\\n    const skill = skillName(seat);\\n    const fam = { kind: act.family, t: 0, fx: 0, fy: 0 };\\n    if (act.family === 'hold' || act.family === 'sun' || act.family === 'candle' || act.family === 'laundry') {\\n160→      const set = act.family === 'rep' ? repSet('y') : setOf(act, tier, gentle);\\n      sess.seats.forEach(function (q, i) {\\n        const sk = skillName(q);\\n        q.bal = new G.Balance(set, (sess.seed + i * 17) >>> 0, { skill: (act.family === 'laundry' ? sk : (act.family === 'hold' || act.family === 'sun' || act.family === 'candle') ? sk : null), cheat: !!sess.cheat });\\n      });\\n    }\\n    if (act.family === 'rep') {\\n      fam.axis = act.axis || 'y';\\n      fam.reps = act.reps[tier - 1];\\n      fam.planned = fam.reps;\\n170→      fam.doneReps = 0;\\n      fam.scores = [];\\n      fam.err = 0; fam.samples = 0; fam.form = 0;\\n      fam.bead = 0; fam.prevBead = 0; fam.beadVel = 0; fam.side = 1;\\n      fam.cycle = tier >= 2 ? 5 : 4;\\n      sess.seats.forEach(function (q, i) {\\n        q.bal = new G.Balance(repSet(fam.axis), (sess.seed + i * 19) >>> 0, { cheat: !!sess.cheat });\\n      });\\n      sess.limit = fam.planned * fam.cycle + 1.5;\\n    }\\n180→    if (act.family === 'sun') { fam.poseI = 0; fam.guide = 0; fam.match = 0; fam.matchN = 0; }\",\"content_concise\":\"1→/* Every activity. One session walks the card, the demo, the count, the play, and the stamp. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const DT = 1 / 120;\\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n  const LEAD = { poor: -0.4, average: 0.05, good: 0.14, expert: 0.2 };\\n  const STEP_OFF = { poor: 0.1, average: 0.03, good: 0.015, expert: 0.008 };\\n10→  const EFFORT = { poor: 0.28, average: 0.5, good: 0.62, expert: 0.72 };\\n\\n  function skillName(seat) {\\n    if (G.dev && G.dev.on && G.dev.bot && seat && seat.local && G.BOTS[G.dev.bot]) return G.dev.bot;\\n    const d = G.driver && G.driver !== 'human' ? G.driver : (seat && seat.skill);\\n    if (!d || d === 'passive' || d === 'human') return null;\\n    return G.BOTS[d] ? d : null;\\n  }\\n\\n  /* The lean that belongs to this seat. Seat 0 is G.lean, so a solo session is unchanged. */\\n20→  function leanFor(seat) {\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (G.leans && G.leans[i]) return G.leans[i];\\n    return G.lean;\\n  }\\n\\n  function seatInput(seat) {\\n    const ps = G.game && G.game.players;\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (ps && ps[i]) return ps[i];\\n30→    return G.game ? G.game.input : null;\\n  }\\n\\n  function arm(bal, skill) {\\n    if (!bal) return;\\n    if (!skill) { bal.skill = null; bal.bot = null; return; }\\n    if (bal.skill === skill && bal.bot) return;\\n    bal.skill = skill;\\n    const br = E.rng((bal.seed ^ 0x9e3779b9) >>> 0);\\n    const b = G.BOTS[skill];\\n40→    bal.bnx = function (t) { return (Math.sin(t * .35 + 1.1) + .6 * Math.sin(t * .35 * 1.73 + 2.2)) / 1.6; };\\n    bal.bny = function (t) { return (Math.sin(t * .41 + 0.4) + .6 * Math.sin(t * .41 * 1.17 + 1.7)) / 1.6; };\\n    void br;\\n    bal.bot = b;\\n  }\\n\\n  /* A seat's hands. A named skill drives the activity bots. A hold skill is applied on the balance itself. */\\n  function drive(seat, fam, dt) {\\n    const skill = skillName(seat);\\n    const human = !skill && !(G.driver === 'passive' || (seat && seat.skill === 'passive'));\\n50→    if (human && seat && seat.local) {\\n      const L = leanFor(seat);\\n      seat.ux = L.ux; seat.uy = L.uy;\\n      seat.breath = L.breath; seat.effort = L.effort;\\n      seat.jump = L.jump; seat.catchL = L.catchL; seat.catchR = L.catchR;\\n      seat.paceL = L.paceL; seat.paceR = L.paceR;\\n      if (Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05) seat.moved = true;\\n      return;\\n    }\\n    seat.ux = 0; seat.uy = 0; seat.breath = 0; seat.effort = 0;\\n60→    seat.jump = false; seat.catchL = false; seat.catchR = false; seat.paceL = false; seat.paceR = false;\\n    if (!skill) return;\\n    const kind = fam && fam.kind;\\n    if (kind === 'rep') {\\n      const lead = LEAD[skill];\\n      const bead = fam.bead, vel = fam.beadVel || 0;\\n      const sign = vel > 0.002 ? 1 : vel < -0.002 ? -1 : 0;\\n      /* Expert servos onto the bead. A fixed lead sits well on tier 1 and misses tier 2's fast rise. */\\n      let target = bead + lead * sign;\\n      const bal = seat.bal;\\n70→      if (skill === 'expert' && bal) {\\n        const depth = fam.axis === 'x' ? (fam.side > 0 ? bal.px : -bal.px) : -bal.py;\\n        const rate = fam.axis === 'x' ? (fam.side > 0 ? bal.vx : -bal.vx) : -bal.vy;\\n        const P = 2.6, D = 0.35;\\n        target = bead + P * (bead - depth) + D * (vel - rate);\\n      }\\n      target = clamp(target, -0.2, 1.25);\\n      if (fam.axis === 'x') {\\n        seat.ux = fam.side * target;\\n        seat.uy = skill === 'expert' && bal ? clamp(-bal.py * 1.6, -0.6, 0.6) : 0;\\n80→      } else {\\n        seat.uy = -target;\\n        seat.ux = skill === 'expert' && bal ? clamp(-bal.px * 1.6, -0.6, 0.6) : 0;\\n      }\\n    } else if (kind === 'sun') {\\n      seat.breath = fam.guide;\\n    } else if (kind === 'hoop') {\\n      const w = skill === 'poor' ? 4.2 : 9;\\n      seat.botPh = (seat.botPh || 0) + w * dt * (fam.otherWay ? -1 : 1);\\n      seat.ux = Math.cos(seat.botPh); seat.uy = Math.sin(seat.botPh);\\n90→      if (fam.toss && Math.abs(fam.toss.eta) < 0.12) {\\n        if (fam.toss.side < 0) seat.catchL = true; else seat.catchR = true;\\n      }\\n    } else if (kind === 'jog') {\\n      const hz = skill === 'poor' ? 1.4 : 3.0;\\n      fam.footT = (fam.footT || 0) + dt;\\n      if (fam.footT >= 1 / hz) { fam.footT = 0; fam.foot = !fam.foot; fam.stepEdge = fam.foot ? 'L' : 'R'; }\\n      seat.paceL = fam.stepEdge === 'L'; seat.paceR = fam.stepEdge === 'R';\\n      const cup = fam.nextCup;\\n      seat.ux = cup ? clamp((cup.x - fam.x) / 1.2, -1, 1) : 0;\\n100→      seat.uy = 0.2;\\n    } else if (kind === 'slalom') {\\n      const gate = fam.nextGate;\\n      const err = gate ? gate.x - fam.x : 0;\\n      const steer = skill === 'poor' ? 0.25 : skill === 'average' ? 0.85 : 1;\\n      seat.ux = clamp(err / 36, -1, 1) * steer;\\n      seat.uy = 0;\\n    } else if (kind === 'tray') {\\n      const aim = skill === 'poor' ? 0.25 : skill === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n110→    } else if (kind === 'laundry') {\\n      seat.effort = EFFORT[skill] || 0.5;\\n      const pin = fam.pinAhead;\\n      seat.jump = !!(pin && pin.dist < 1.2 && pin.dist > 0.08);\\n    }\\n  }\\n\\n  function setOf(act, tier, gentle) {\\n    const name = act.set ? act.set[tier - 1] : null;\\n    let s = name && G.SETS[name] ? G.SETS[name] : { k: 14, c: 7, s: 4, A: 1.2, nf: 1, R: .3, push: null };\\n120→    if (gentle) s = G.gentleSet(s, true);\\n    return s;\\n  }\\n\\n  function repSet(axis) {\\n    const o = { k: 16, c: 8, s: 0, A: 0.35, nf: 0.7, R: 0.55, push: null, kx: 16, ky: 16, cx: 8, cy: 8 };\\n    if (axis === 'x') { o.sx = 0; o.sy = 8; }\\n    else { o.sx = 8; o.sy = 0; }\\n    return o;\\n  }\\n130→\\n  function holdCenter(t) {\\n    const i = Math.floor(t / 12);\\n    const a = i * 2.4;\\n    return { x: Math.cos(a) * 0.06, y: Math.sin(a * 1.3) * 0.05 };\\n  }\\n\\n  function beadOf(t, tier) {\\n    if (tier >= 2) {\\n      const u = t % 5;\\n140→      if (u < 3) return u / 3;\\n      if (u < 4) return 1;\\n      return 1 - (u - 4);\\n    }\\n    const u = t % 4;\\n    return u < 2 ? u / 2 : 1 - (u - 2) / 2;\\n  }\\n\\n  function guideOf(t) {\\n    const u = (t % 8) / 4;\\n150→    return u < 1 ? u : 2 - u;\\n  }\\n\\n  /* ---- families ---- */\\n  function beginFamily(sess) {\\n    const act = sess.act, tier = sess.tier, seat = sess.seats[0];\\n    const gentle = !!(G.game && G.game.settings && G.game.settings.gentle);\\n    const skill = skillName(seat);\\n    const fam = { kind: act.family, t: 0, fx: 0, fy: 0 };\\n    if (act.family === 'hold' || act.family === 'sun' || act.family === 'candle' || act.family === 'laundry') {\\n160→      const set = act.family === 'rep' ? repSet('y') : setOf(act, tier, gentle);\\n      sess.seats.forEach(function (q, i) {\\n        const sk = skillName(q);\\n        q.bal = new G.Balance(set, (sess.seed + i * 17) >>> 0, { skill: (act.family === 'laundry' ? sk : (act.family === 'hold' || act.family === 'sun' || act.family === 'candle') ? sk : null), cheat: !!sess.cheat });\\n      });\\n    }\\n    if (act.family === 'rep') {\\n      fam.axis = act.axis || 'y';\\n      fam.reps = act.reps[tier - 1];\\n      fam.planned = fam.reps;\\n170→      fam.doneReps = 0;\\n      fam.scores = [];\\n      fam.err = 0; fam.samples = 0; fam.form = 0;\\n      fam.bead = 0; fam.prevBead = 0; fam.beadVel = 0; fam.side = 1;\\n      fam.cycle = tier >= 2 ? 5 : 4;\\n      sess.seats.forEach(function (q, i) {\\n        q.bal = new G.Balance(repSet(fam.axis), (sess.seed + i * 19) >>> 0, { cheat: !!sess.cheat });\\n      });\\n      sess.limit = fam.planned * fam.cycle + 1.5;\\n    }\\n180→    if (act.family === 'sun') { fam.poseI = 0; fam.guide = 0; fam.match = 0; fam.matchN = 0; }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"offset\":1,\"limit\":180,\"raw_output\":\"/* Every activity. One session walks the card, the demo, the count, the play, and the stamp. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const DT = 1 / 120;\\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n  const LEAD = { poor: -0.4, average: 0.05, good: 0.14, expert: 0.2 };\\n  const STEP_OFF = { poor: 0.1, average: 0.03, good: 0.015, expert: 0.008 };\\n  const EFFORT = { poor: 0.28, average: 0.5, good: 0.62, expert: 0.72 };\\n\\n  function skillName(seat) {\\n    if (G.dev && G.dev.on && G.dev.bot && seat && seat.local && G.BOTS[G.dev.bot]) return G.dev.bot;\\n    const d = G.driver && G.driver !== 'human' ? G.driver : (seat && seat.skill);\\n    if (!d || d === 'passive' || d === 'human') return null;\\n    return G.BOTS[d] ? d : null;\\n  }\\n\\n  /* The lean that belongs to this seat. Seat 0 is G.lean, so a solo session is unchanged. */\\n  function leanFor(seat) {\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (G.leans && G.leans[i]) return G.leans[i];\\n    return G.lean;\\n  }\\n\\n  function seatInput(seat) {\\n    const ps = G.game && G.game.players;\\n    const i = seat && typeof seat.pi === 'number' && seat.pi >= 0 ? seat.pi : 0;\\n    if (ps && ps[i]) return ps[i];\\n    return G.game ? G.game.input : null;\\n  }\\n\\n  function arm(bal, skill) {\\n    if (!bal) return;\\n    if (!skill) { bal.skill = null; bal.bot = null; return; }\\n    if (bal.skill === skill && bal.bot) return;\\n    bal.skill = skill;\\n    const br = E.rng((bal.seed ^ 0x9e3779b9) >>> 0);\\n    const b = G.BOTS[skill];\\n    bal.bnx = function (t) { return (Math.sin(t * .35 + 1.1) + .6 * Math.sin(t * .35 * 1.73 + 2.2)) / 1.6; };\\n    bal.bny = function (t) { return (Math.sin(t * .41 + 0.4) + .6 * Math.sin(t * .41 * 1.17 + 1.7)) / 1.6; };\\n    void br;\\n    bal.bot = b;\\n  }\\n\\n  /* A seat's hands. A named skill drives the activity bots. A hold skill is applied on the balance itself. */\\n  function drive(seat, fam, dt) {\\n    const skill = skillName(seat);\\n    const human = !skill && !(G.driver === 'passive' || (seat && seat.skill === 'passive'));\\n    if (human && seat && seat.local) {\\n      const L = leanFor(seat);\\n      seat.ux = L.ux; seat.uy = L.uy;\\n      seat.breath = L.breath; seat.effort = L.effort;\\n      seat.jump = L.jump; seat.catchL = L.catchL; seat.catchR = L.catchR;\\n      seat.paceL = L.paceL; seat.paceR = L.paceR;\\n      if (Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05) seat.moved = true;\\n      return;\\n    }\\n    seat.ux = 0; seat.uy = 0; seat.breath = 0; seat.effort = 0;\\n    seat.jump = false; seat.catchL = false; seat.catchR = false; seat.paceL = false; seat.paceR = false;\\n    if (!skill) return;\\n    const kind = fam && fam.kind;\\n    if (kind === 'rep') {\\n      const lead = LEAD[skill];\\n      const bead = fam.bead, vel = fam.beadVel || 0;\\n      const sign = vel > 0.002 ? 1 : vel < -0.002 ? -1 : 0;\\n      /* Expert servos onto the bead. A fixed lead sits well on tier 1 and misses tier 2's fast rise. */\\n      let target = bead + lead * sign;\\n      const bal = seat.bal;\\n      if (skill === 'expert' && bal) {\\n        const depth = fam.axis === 'x' ? (fam.side > 0 ? bal.px : -bal.px) : -bal.py;\\n        const rate = fam.axis === 'x' ? (fam.side > 0 ? bal.vx : -bal.vx) : -bal.vy;\\n        const P = 2.6, D = 0.35;\\n        target = bead + P * (bead - depth) + D * (vel - rate);\\n      }\\n      target = clamp(target, -0.2, 1.25);\\n      if (fam.axis === 'x') {\\n        seat.ux = fam.side * target;\\n        seat.uy = skill === 'expert' && bal ? clamp(-bal.py * 1.6, -0.6, 0.6) : 0;\\n      } else {\\n        seat.uy = -target;\\n        seat.ux = skill === 'expert' && bal ? clamp(-bal.px * 1.6, -0.6, 0.6) : 0;\\n      }\\n    } else if (kind === 'sun') {\\n      seat.breath = fam.guide;\\n    } else if (kind === 'hoop') {\\n      const w = skill === 'poor' ? 4.2 : 9;\\n      seat.botPh = (seat.botPh || 0) + w * dt * (fam.otherWay ? -1 : 1);\\n      seat.ux = Math.cos(seat.botPh); seat.uy = Math.sin(seat.botPh);\\n      if (fam.toss && Math.abs(fam.toss.eta) < 0.12) {\\n        if (fam.toss.side < 0) seat.catchL = true; else seat.catchR = true;\\n      }\\n    } else if (kind === 'jog') {\\n      const hz = skill === 'poor' ? 1.4 : 3.0;\\n      fam.footT = (fam.footT || 0) + dt;\\n      if (fam.footT >= 1 / hz) { fam.footT = 0; fam.foot = !fam.foot; fam.stepEdge = fam.foot ? 'L' : 'R'; }\\n      seat.paceL = fam.stepEdge === 'L'; seat.paceR = fam.stepEdge === 'R';\\n      const cup = fam.nextCup;\\n      seat.ux = cup ? clamp((cup.x - fam.x) / 1.2, -1, 1) : 0;\\n      seat.uy = 0.2;\\n    } else if (kind === 'slalom') {\\n      const gate = fam.nextGate;\\n      const err = gate ? gate.x - fam.x : 0;\\n      const steer = skill === 'poor' ? 0.25 : skill === 'average' ? 0.85 : 1;\\n      seat.ux = clamp(err / 36, -1, 1) * steer;\\n      seat.uy = 0;\\n    } else if (kind === 'tray') {\\n      const aim = skill === 'poor' ? 0.25 : skill === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    } else if (kind === 'laundry') {\\n      seat.effort = EFFORT[skill] || 0.5;\\n      const pin = fam.pinAhead;\\n      seat.jump = !!(pin && pin.dist < 1.2 && pin.dist > 0.08);\\n    }\\n  }\\n\\n  function setOf(act, tier, gentle) {\\n    const name = act.set ? act.set[tier - 1] : null;\\n    let s = name && G.SETS[name] ? G.SETS[name] : { k: 14, c: 7, s: 4, A: 1.2, nf: 1, R: .3, push: null };\\n    if (gentle) s = G.gentleSet(s, true);\\n    return s;\\n  }\\n\\n  function repSet(axis) {\\n    const o = { k: 16, c: 8, s: 0, A: 0.35, nf: 0.7, R: 0.55, push: null, kx: 16, ky: 16, cx: 8, cy: 8 };\\n    if (axis === 'x') { o.sx = 0; o.sy = 8; }\\n    else { o.sx = 8; o.sy = 0; }\\n    return o;\\n  }\\n\\n  function holdCenter(t) {\\n    const i = Math.floor(t / 12);\\n    const a = i * 2.4;\\n    return { x: Math.cos(a) * 0.06, y: Math.sin(a * 1.3) * 0.05 };\\n  }\\n\\n  function beadOf(t, tier) {\\n    if (tier >= 2) {\\n      const u = t % 5;\\n      if (u < 3) return u / 3;\\n      if (u < 4) return 1;\\n      return 1 - (u - 4);\\n    }\\n    const u = t % 4;\\n    return u < 2 ? u / 2 : 1 - (u - 2) / 2;\\n  }\\n\\n  function guideOf(t) {\\n    const u = (t % 8) / 4;\\n    return u < 1 ? u : 2 - u;\\n  }\\n\\n  /* ---- families ---- */\\n  function beginFamily(sess) {\\n    const act = sess.act, tier = sess.tier, seat = sess.seats[0];\\n    const gentle = !!(G.game && G.game.settings && G.game.settings.gentle);\\n    const skill = skillName(seat);\\n    const fam = { kind: act.family, t: 0, fx: 0, fy: 0 };\\n    if (act.family === 'hold' || act.family === 'sun' || act.family === 'candle' || act.family === 'laundry') {\\n      const set = act.family === 'rep' ? repSet('y') : setOf(act, tier, gentle);\\n      sess.seats.forEach(function (q, i) {\\n        const sk = skillName(q);\\n        q.bal = new G.Balance(set, (sess.seed + i * 17) >>> 0, { skill: (act.family === 'laundry' ? sk : (act.family === 'hold' || act.family === 'sun' || act.family === 'candle') ? sk : null), cheat: !!sess.cheat });\\n      });\\n    }\\n    if (act.family === 'rep') {\\n      fam.axis = act.axis || 'y';\\n      fam.reps = act.reps[tier - 1];\\n      fam.planned = fam.reps;\\n      fam.doneReps = 0;\\n      fam.scores = [];\\n      fam.err = 0; fam.samples = 0; fam.form = 0;\\n      fam.bead = 0; fam.prevBead = 0; fam.beadVel = 0; fam.side = 1;\\n      fam.cycle = tier >= 2 ? 5 : 4;\\n      sess.seats.forEach(function (q, i) {\\n        q.bal = new G.Balance(repSet(fam.axis), (sess.seed + i * 19) >>> 0, { cheat: !!sess.cheat });\\n      });\\n      sess.limit = fam.planned * fam.cycle + 1.5;\\n    }\\n    if (act.family === 'sun') { fam.poseI = 0; fam.guide = 0; fam.match = 0; fam.matchN = 0; }\\n\",\"total_lines\":905}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a9e1b91f-99b7-47af-acde-2ee7ead8fa58-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"240→      try { other.off = true; } catch (e) { /* it has arrived */ }\\n      try { G.game.audio.sfx('plop'); } catch (e) { /* quiet */ }\\n    };\\n    fam.world = world;\\n    fam.trayOlives = spec.olives.length;\\n    fam.trayGot0 = fam.got;\\n  }\\n\\n  function stepFamily(sess, dt) {\\n    const fam = sess.fam, act = sess.act;\\n250→    if (!fam) return;\\n    fam.t += dt;\\n    const seat = sess.seats[0];\\n    drive(seat, fam, dt);\\n    sess.seats.forEach(function (q, i) { if (i > 0) drive(q, fam, dt); });\\n    if (act.family === 'hold') stepHold(sess, dt);\\n    else if (act.family === 'sun') stepSun(sess, dt);\\n    else if (act.family === 'candle') stepCandle(sess, dt);\\n    else if (act.family === 'rep') stepRep(sess, dt);\\n    else if (act.family === 'step') stepStep(sess, dt);\\n260→    else if (act.family === 'hoop') stepHoop(sess, dt);\\n    else if (act.family === 'jog') stepJog(sess, dt);\\n    else if (act.family === 'slalom') stepSlalom(sess, dt);\\n    else if (act.family === 'tray') stepTray(sess, dt);\\n    else if (act.family === 'laundry') stepLaundry(sess, dt);\\n    const bal = seat.bal;\\n    if (bal) {\\n      sess.leanX = bal.px; sess.leanY = bal.py;\\n      if (seat.local) { G.lean.ux = seat.ux; G.lean.uy = seat.uy; }\\n    }\\n270→  }\\n\\n  function stepHold(sess, dt) {\\n    const fam = sess.fam;\\n    const c = holdCenter(fam.t);\\n    fam.c = c;\\n    let fx = 0;\\n    const gull = Math.floor(fam.t / 12);\\n    const gph = fam.t % 12;\\n    if (gull > 0 && gph < 0.28) fx = (gull % 2 ? 1 : -1) * 0.7;\\n280→    fam.fx = fx;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i], bal = seat && seat.bal;\\n      if (!bal) continue;\\n      arm(bal, skillName(seat));\\n      bal.step(dt, seat.ux, seat.uy, fx, 0, c);\\n      const pct = clamp(bal.steadiness - 0.05 * bal.falls, 0, 1);\\n      if (i === 0) {\\n290→        sess.pct = pct;\\n        if (sess.tier >= 2 && bal.px) fam.eyes = true;\\n      }\\n      if (many) seat.pct = pct;\\n    }\\n  }\\n\\n  function stepSun(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    fam.guide = guideOf(fam.t);\\n300→    arm(bal, skillName(seat));\\n    if (skillName(seat)) seat.breath = fam.guide;\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const breath = seat.local && !skillName(seat) ? leanFor(seat).breath : seat.breath;\\n    fam.matchN++;\\n    if (Math.abs(breath - fam.guide) <= 0.25) fam.match++;\\n    fam.poseI = Math.min(G.SUN_POSES.length - 1, Math.floor(fam.t / 16));\\n    sess.pct = clamp(0.6 * bal.steadiness + 0.4 * (fam.match / fam.matchN), 0, 1);\\n    if (fam.t >= 80) sess.ended = true;\\n  }\\n310→\\n  function stepCandleOne(sess, seat, box, rng, dt, primary) {\\n    const bal = seat.bal;\\n    if (!bal) return;\\n    arm(bal, skillName(seat));\\n    let fx = 0, fy = 0;\\n    box.thought -= dt;\\n    if (box.thought <= 0) {\\n      box.thought = 4.5 + (rng() * 2);\\n      const ang = rng() * Math.PI * 2;\\n320→      box.tx = Math.cos(ang) * 0.85;\\n      box.ty = Math.sin(ang) * 0.85;\\n      box.tleft = 1.1;\\n      if (sess.tier >= 2 && rng() > 0.5) { box.tx *= 1.3; box.ty *= 1.3; }\\n    }\\n    if (box.tleft > 0) { box.tleft -= dt; fx = box.tx; fy = box.ty; }\\n    bal.step(dt, seat.ux, seat.uy, fx, fy, { x: 0, y: 0 });\\n    const sp = Math.hypot(bal.vx, bal.vy);\\n    const inside = bal.stumble <= 0 && Math.hypot(bal.px, bal.py) < (bal.set.R || 0.2);\\n    if (sp > 0.55) box.flame -= 0.4 * dt;\\n330→    else if (inside) box.flame += 0.12 * dt;\\n    else box.flame -= 0.055 * dt;\\n    box.flame = clamp(box.flame, 0, 1);\\n    if (box.flame <= 0 && !box.relit) { box.relit = true; box.flame = 0.15; }\\n    else if (box.flame <= 0 && box.relit) box.dead = true;\\n    box.flameSum += box.flame;\\n    const moved = Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05;\\n    if (!moved) box.untouched += dt; else box.untouched = 0;\\n    if (primary && box.untouched > 20 && !box.said) { box.said = true; G.subtitle = G.LINES.tare.filter(function (s) { return s.indexOf('controller') >= 0; })[0] || ''; }\\n    const mean = box.flameSum / Math.max(1, bal.frames);\\n340→    const pct = clamp(0.6 * bal.steadiness + 0.4 * mean, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      if (box.dead) sess.ended = true;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepCandle(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n350→    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._candle || (seat._candle = { flame: 1, flameSum: 0, relit: false, dead: false, untouched: 0, thought: 0, tleft: 0, tx: 0, ty: 0, said: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 101) >>> 0)));\\n      stepCandleOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepRepOne(sess, seat, store, dt, primary) {\\n360→    const fam = sess.fam, bal = seat.bal;\\n    if (!bal) return;\\n    drive(seat, fam, dt);\\n    if (store.doneReps === Math.floor(fam.planned * 0.6) && !store.fatigued) {\\n      store.fatigued = true;\\n      const mul = G.dev && G.dev.on ? G.dev.v.fatigue / 1.5 : 1;\\n      bal.set = Object.assign({}, bal.set, { A: bal.set.A * 1.5 * mul, k: bal.set.k * 0.8, kx: 16 * 0.8, ky: 16 * 0.8 });\\n    }\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const depth = fam.axis === 'x' ? clamp(fam.side > 0 ? bal.px : -bal.px, 0, 1) : clamp(-bal.py, 0, 1);\\n370→    const tol = G.dev && G.dev.on ? G.dev.v.repTol : 0.08;\\n    store.err += Math.abs(depth - fam.bead);\\n    store.form += fam.axis === 'x' ? Math.abs(bal.py) : Math.abs(bal.px);\\n    store.samples++;\\n    const cyc = Math.floor(fam.t / fam.cycle);\\n    if (cyc > store.doneReps) {\\n      const meanErr = store.err / Math.max(1, store.samples);\\n      let sc = meanErr <= tol ? 1 : meanErr >= 0.35 ? 0 : (0.35 - meanErr) / (0.35 - tol);\\n      store.scores.push(sc);\\n      store.err = 0; store.samples = 0;\\n380→      store.doneReps = cyc;\\n      if (primary && store.doneReps === fam.planned && !fam.extra) {\\n        const mean = store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length;\\n        if (mean > 0.8) { fam.extra = true; fam.planned += 2; sess.limit += fam.cycle * 2; }\\n      }\\n    }\\n    const form = store.form / Math.max(1, bal.frames);\\n    const pen = clamp(form * 0.45, 0, 0.3);\\n    const mean = store.scores.length ? store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length : 0;\\n    const pct = clamp(mean * (1 - pen), 0, 1);\\n390→    if (primary) sess.pct = pct;\\n    if (sess.classMode) seat.pct = pct;\\n    if (primary && store.doneReps >= fam.planned && store.scores.length >= fam.planned) sess.ended = true;\\n  }\\n\\n  function stepRep(sess, dt) {\\n    const fam = sess.fam;\\n    const prev = fam.bead;\\n    fam.bead = beadOf(fam.t, sess.tier);\\n    fam.beadVel = (fam.bead - prev) / dt;\\n400→    fam.side = (Math.floor(fam.t / fam.cycle) % 2 === 0) ? 1 : -1;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const store = i === 0 ? fam : (seat._rep || (seat._rep = { err: 0, samples: 0, form: 0, scores: [], doneReps: 0, fatigued: false }));\\n      stepRepOne(sess, seat, store, dt, i === 0);\\n    }\\n  }\\n\\n410→  function chartOf(sess) {\\n    const tier = sess.tier;\\n    const chart = G.CHARTS[tier >= 2 ? 't2' : 't1'];\\n    const song = tier >= 2 ? G.SONGS.stepB : G.SONGS.stepA;\\n    const lanes = sess.classMode ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\\n    const scale = G.dev && G.dev.on ? G.dev.v.rhythm : 1;\\n    const rh = new E.Rhythm(G.game, {\\n      song: song, chart: chart, lanes: lanes, life: 4,\\n      windows: { perfect: 45 * scale, great: 90 * scale, good: 135 * scale }\\n    });\\n420→    return rh;\\n  }\\n\\n  function chartMiss(rh) {\\n    if (!rh || !rh.started || rh.done) return;\\n    const A = rh.game.audio, s = A.pos.step, spb = rh._spb();\\n    for (let i = 0; i < rh.notes.length; i++) {\\n      const n = rh.notes[i];\\n      if (n.step > s + 8 * rh.song.steps) break;\\n      if (n.call) continue;\\n430→      if (!n.j && (s - n.step) * spb * 1000 > rh.windows.good) rh._judge(n, 'miss', 0);\\n      if (rh.done) return;\\n    }\\n    const p = A.pos;\\n    if (!p.playing && p.t > 0) rh.done = true;\\n  }\\n\\n  function stepSeatChart(sess, seat) {\\n    if (!seat._rh) {\\n      seat._rh = chartOf(sess);\\n440→      seat._rh.started = true;\\n    }\\n    const rh = seat._rh;\\n    const I = seatInput(seat);\\n    const skill = skillName(seat);\\n    if (skill) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n450→        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    } else if (I) {\\n      rh.lanes.forEach(function (a, i) { if (I.pressed(a)) rh.hit(i); });\\n    }\\n    chartMiss(rh);\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n460→    return judged ? rh.accuracy : 0;\\n  }\\n\\n  function stepStep(sess, dt) {\\n    const fam = sess.fam, rh = fam.rh, seat = sess.seats[0];\\n    if (!rh) return;\\n    const skill = skillName(seat);\\n    if (skill && !sess.classMode) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n470→      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    }\\n    rh.update();\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n480→    sess.pct = judged ? rh.accuracy : 0;\\n    if (sess.classMode) {\\n      seat.pct = sess.pct;\\n      for (let i = 1; i < sess.seats.length; i++) {\\n        const q = sess.seats[i];\\n        if (q.scoring === false) { q.pct = 0; continue; }\\n        q.pct = stepSeatChart(sess, q);\\n      }\\n    }\\n    if (rh.done) sess.ended = true;\\n490→    void dt;\\n  }\\n\\n  function stepHoopOne(sess, seat, box, rng, dt, primary) {\\n    const clock = sess.fam.t;\\n    const ux = seat.ux || 0, uy = seat.uy || 0;\\n    const mag = Math.hypot(ux, uy);\\n    let omega = 0;\\n    if (mag > 0.55) {\\n      const ang = Math.atan2(uy, ux);\\n500→      let d = ang - (box.ang || 0);\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      if (box.haveAng) omega = d / dt;\\n      box.ang = ang; box.haveAng = true;\\n    } else box.haveAng = false;\\n    box.omega = omega;\\n    const lo = G.dev && G.dev.on ? G.dev.v.hoopLo : 7;\\n    const hi = G.dev && G.dev.on ? G.dev.v.hoopHi : 11;\\n    const dir = box.otherWay ? -1 : 1;\\n510→    const inBand = Math.abs(omega) >= lo && Math.abs(omega) <= hi && omega * dir > 0;\\n    if (inBand) { box.band += dt; box.out = 0; box.score += dt * (1 + box.hoops * 0.15); }\\n    else if (mag > 0.2) { box.out += dt; if (box.out > 1.5 && box.hoops > 1) { box.hoops--; box.drops++; box.out = 0; } }\\n    if (!box.otherWay && clock >= sess.limit * 0.5) box.otherWay = true;\\n    box.tossT -= dt;\\n    if (box.tossT <= 0) {\\n      box.tossT = 8;\\n      box.toss = { side: rng() < 0.5 ? -1 : 1, eta: 1.1 };\\n    }\\n    if (box.toss) {\\n520→      box.toss.eta -= dt;\\n      const hit = box.toss.side < 0 ? seat.catchL : seat.catchR;\\n      if (hit && Math.abs(box.toss.eta) <= 0.25) { box.caught++; box.hoops = Math.min(6, box.hoops + 1); box.toss = null; }\\n      else if (box.toss.eta < -0.25) box.toss = null;\\n    }\\n    const best = sess.limit * 1.4;\\n    const pct = clamp(box.score / best, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      sess.fam.omega = box.omega;\\n530→      sess.fam.otherWay = box.otherWay;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepHoop(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n540→      const box = i === 0 ? sess.fam : (seat._hoop || (seat._hoop = { omega: 0, ang: 0, band: 0, out: 0, hoops: 1, caught: 0, drops: 0, score: 0, otherWay: false, toss: null, tossT: 2, haveAng: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 131) >>> 0)));\\n      stepHoopOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepJog(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    const edgeL = seat.paceL && !fam.prevL;\\n    const edgeR = seat.paceR && !fam.prevR;\\n550→    fam.prevL = seat.paceL; fam.prevR = seat.paceR;\\n    if (edgeL || edgeR) { fam.steps++; fam.hist.push(fam.t); }\\n    while (fam.hist.length && fam.t - fam.hist[0] > 1) fam.hist.shift();\\n    fam.cad = fam.hist.length;\\n    const lo = G.dev && G.dev.on ? G.dev.v.jogLo : 2.6;\\n    const hi = G.dev && G.dev.on ? G.dev.v.jogHi : 3.4;\\n    const zoned = fam.cad >= lo && fam.cad <= hi && fam.stitch <= 0;\\n    if (zoned) fam.zone += dt;\\n    if (fam.cad > 4.2) fam.sprint += dt; else fam.sprint = 0;\\n    if (fam.sprint > 2 && fam.stitch <= 0) fam.stitch = 3;\\n560→    if (fam.stitch > 0) fam.stitch -= dt;\\n    const speed = (G.dev && G.dev.on ? G.dev.v.jogSpeed : 1) * (zoned ? 8 : 3);\\n    fam.z += speed * dt;\\n    fam.x += (seat.ux || 0) * 1.6 * dt;\\n    const cups = [12, 28, 44, 58];\\n    for (let i = 0; i < cups.length; i++) {\\n      if (fam.gotCup && fam.gotCup[i]) continue;\\n      if (fam.z >= cups[i] && fam.z - speed * dt < cups[i]) {\\n        const cx = (i % 2 ? 0.8 : -0.8);\\n        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\\n570→      }\\n    }\\n    fam.nextCup = null;\\n    for (let i = 0; i < cups.length; i++) if (!(fam.gotCup && fam.gotCup[i]) && fam.z < cups[i]) { fam.nextCup = { x: (i % 2 ? 0.8 : -0.8), z: cups[i] }; break; }\\n    const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n  }\\n\\n  function stepSlalom(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n580→    if (fam.done) return;\\n    if (fam.tumble > 0) { fam.tumble -= dt; return; }\\n    const base = G.dev && G.dev.on ? G.dev.v.skiSpeed : 220;\\n    const turn = G.dev && G.dev.on ? G.dev.v.skiTurn : 1.6;\\n    let spd = base;\\n    if (seat.uy > 0.3) spd *= 1.35;\\n    if (seat.uy < -0.3) spd *= 0.6;\\n    fam.z += spd * dt;\\n    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\\n    const gates = G.GATES;\\n590→    for (let i = 0; i < gates.length; i++) {\\n      const g = gates[i];\\n      if (fam.missed[i]) continue;\\n      if (fam.z >= g.z && fam.z - spd * dt < g.z) {\\n        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\\n        if (fam.missed[i]) fam.pen += 3;\\n      }\\n    }\\n    for (let i = 0; i < G.OBSTACLES.length; i++) {\\n      const o = G.OBSTACLES[i];\\n600→      if (fam.hitO && fam.hitO[i]) continue;\\n      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\\n        fam.hitO = fam.hitO || {}; fam.hitO[i] = true; fam.tumble = 1.2; fam.pen += 1.2;\\n      }\\n    }\\n    let next = null;\\n    for (let i = 0; i < gates.length; i++) if (gates[i].z > fam.z - 20) { next = gates[i]; break; }\\n    fam.nextGate = next;\\n    if (fam.z >= fam.finish) {\\n      fam.done = true;\\n610→      const par = 58, worst = 90;\\n      const time = fam.t + fam.pen;\\n      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function stepTray(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (!seat.bal) {\\n620→      seat.bal = new G.Balance({ k: 14, c: 8, s: 1, A: 0.5, nf: 0.8, R: 0.4, push: null }, sess.seed, {});\\n    }\\n    const sk = skillName(seat);\\n    if (sk) {\\n      const aim = sk === 'poor' ? 0.25 : sk === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    }\\n    seat.bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const Gv = G.dev && G.dev.on ? G.dev.v.trayG : 420;\\n    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\\n630→    if (fam.world) {\\n      if (G.dev && G.dev.on && fam.world.bodies) {\\n        const mu = 0.04 * fr;\\n        fam.world.bodies.forEach(function (b) { if (b && b._olive) b.friction = mu; });\\n      }\\n      if (fam.gecko) fam.gecko.moveTo(78, 100 + Math.sin(fam.t * 0.55) * 36, 0, 22, 0);\\n      fam.world.gravity = [seat.bal.px * Gv, -seat.bal.py * Gv];\\n      fam.world.wake();\\n      fam.world.step(dt);\\n      const spec = G.TRAYS[fam.trayI];\\n640→      const need = spec ? spec.olives.length : 0;\\n      const gotHere = fam.got - fam.trayGot0;\\n      if (gotHere >= need) {\\n        fam.trayI++;\\n        if (fam.trayI >= G.TRAYS.length) { fam.world = null; sess.ended = true; }\\n        else loadTray(sess);\\n      }\\n    } else if (fam.trayI >= G.TRAYS.length) sess.ended = true;\\n    const share = sess.limit > 0 ? clamp((sess.limit - fam.t) / sess.limit, 0, 1) : 0;\\n    const base = fam.total ? fam.got / fam.total : 0;\\n650→    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\\n    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\\n  }\\n\\n  function stepLaundry(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    const skill = skillName(seat);\\n    if (skill) seat.effort = EFFORT[skill] || 0.5;\\n    arm(bal, skill);\\n    const effort = clamp(seat.local && !skill ? leanFor(seat).effort : seat.effort, 0, 1);\\n660→    const spd = effort * 2.2;\\n    if (!fam.rope) fam.rope = Object.assign({}, bal.set);\\n    /* Faster walking sways the rope. The set on the balance is a copy, so the band table stays put.\\n       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\\n    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\\n    bal.set = Object.assign({}, fam.rope, { s: baseS + effort * 4 });\\n    fam.air -= dt;\\n    const pins = [8, 19, 30, 41, 50];\\n    let ahead = null;\\n    for (let i = 0; i < pins.length; i++) {\\n670→      const d = pins[i] - fam.x;\\n      if (d > 0.04) { ahead = { dist: d, x: pins[i] }; break; }\\n    }\\n    fam.pinAhead = ahead;\\n    /* One jump per pin, long enough to land past it. Air freezes the plate, not the walker. */\\n    if (seat.jump && fam.air <= 0 && ahead && fam.cleared !== ahead.x && ahead.dist < 0.95) {\\n      fam.air = Math.min(0.85, ahead.dist / Math.max(0.45, spd) + 0.12);\\n      fam.cleared = ahead.x;\\n    }\\n    bal.holdP = fam.air > 0;\\n680→    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\",\"content_concise\":\"240→      try { other.off = true; } catch (e) { /* it has arrived */ }\\n      try { G.game.audio.sfx('plop'); } catch (e) { /* quiet */ }\\n    };\\n    fam.world = world;\\n    fam.trayOlives = spec.olives.length;\\n    fam.trayGot0 = fam.got;\\n  }\\n\\n  function stepFamily(sess, dt) {\\n    const fam = sess.fam, act = sess.act;\\n250→    if (!fam) return;\\n    fam.t += dt;\\n    const seat = sess.seats[0];\\n    drive(seat, fam, dt);\\n    sess.seats.forEach(function (q, i) { if (i > 0) drive(q, fam, dt); });\\n    if (act.family === 'hold') stepHold(sess, dt);\\n    else if (act.family === 'sun') stepSun(sess, dt);\\n    else if (act.family === 'candle') stepCandle(sess, dt);\\n    else if (act.family === 'rep') stepRep(sess, dt);\\n    else if (act.family === 'step') stepStep(sess, dt);\\n260→    else if (act.family === 'hoop') stepHoop(sess, dt);\\n    else if (act.family === 'jog') stepJog(sess, dt);\\n    else if (act.family === 'slalom') stepSlalom(sess, dt);\\n    else if (act.family === 'tray') stepTray(sess, dt);\\n    else if (act.family === 'laundry') stepLaundry(sess, dt);\\n    const bal = seat.bal;\\n    if (bal) {\\n      sess.leanX = bal.px; sess.leanY = bal.py;\\n      if (seat.local) { G.lean.ux = seat.ux; G.lean.uy = seat.uy; }\\n    }\\n270→  }\\n\\n  function stepHold(sess, dt) {\\n    const fam = sess.fam;\\n    const c = holdCenter(fam.t);\\n    fam.c = c;\\n    let fx = 0;\\n    const gull = Math.floor(fam.t / 12);\\n    const gph = fam.t % 12;\\n    if (gull > 0 && gph < 0.28) fx = (gull % 2 ? 1 : -1) * 0.7;\\n280→    fam.fx = fx;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i], bal = seat && seat.bal;\\n      if (!bal) continue;\\n      arm(bal, skillName(seat));\\n      bal.step(dt, seat.ux, seat.uy, fx, 0, c);\\n      const pct = clamp(bal.steadiness - 0.05 * bal.falls, 0, 1);\\n      if (i === 0) {\\n290→        sess.pct = pct;\\n        if (sess.tier >= 2 && bal.px) fam.eyes = true;\\n      }\\n      if (many) seat.pct = pct;\\n    }\\n  }\\n\\n  function stepSun(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    fam.guide = guideOf(fam.t);\\n300→    arm(bal, skillName(seat));\\n    if (skillName(seat)) seat.breath = fam.guide;\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const breath = seat.local && !skillName(seat) ? leanFor(seat).breath : seat.breath;\\n    fam.matchN++;\\n    if (Math.abs(breath - fam.guide) <= 0.25) fam.match++;\\n    fam.poseI = Math.min(G.SUN_POSES.length - 1, Math.floor(fam.t / 16));\\n    sess.pct = clamp(0.6 * bal.steadiness + 0.4 * (fam.match / fam.matchN), 0, 1);\\n    if (fam.t >= 80) sess.ended = true;\\n  }\\n310→\\n  function stepCandleOne(sess, seat, box, rng, dt, primary) {\\n    const bal = seat.bal;\\n    if (!bal) return;\\n    arm(bal, skillName(seat));\\n    let fx = 0, fy = 0;\\n    box.thought -= dt;\\n    if (box.thought <= 0) {\\n      box.thought = 4.5 + (rng() * 2);\\n      const ang = rng() * Math.PI * 2;\\n320→      box.tx = Math.cos(ang) * 0.85;\\n      box.ty = Math.sin(ang) * 0.85;\\n      box.tleft = 1.1;\\n      if (sess.tier >= 2 && rng() > 0.5) { box.tx *= 1.3; box.ty *= 1.3; }\\n    }\\n    if (box.tleft > 0) { box.tleft -= dt; fx = box.tx; fy = box.ty; }\\n    bal.step(dt, seat.ux, seat.uy, fx, fy, { x: 0, y: 0 });\\n    const sp = Math.hypot(bal.vx, bal.vy);\\n    const inside = bal.stumble <= 0 && Math.hypot(bal.px, bal.py) < (bal.set.R || 0.2);\\n    if (sp > 0.55) box.flame -= 0.4 * dt;\\n330→    else if (inside) box.flame += 0.12 * dt;\\n    else box.flame -= 0.055 * dt;\\n    box.flame = clamp(box.flame, 0, 1);\\n    if (box.flame <= 0 && !box.relit) { box.relit = true; box.flame = 0.15; }\\n    else if (box.flame <= 0 && box.relit) box.dead = true;\\n    box.flameSum += box.flame;\\n    const moved = Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05;\\n    if (!moved) box.untouched += dt; else box.untouched = 0;\\n    if (primary && box.untouched > 20 && !box.said) { box.said = true; G.subtitle = G.LINES.tare.filter(function (s) { return s.indexOf('controller') >= 0; })[0] || ''; }\\n    const mean = box.flameSum / Math.max(1, bal.frames);\\n340→    const pct = clamp(0.6 * bal.steadiness + 0.4 * mean, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      if (box.dead) sess.ended = true;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepCandle(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n350→    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._candle || (seat._candle = { flame: 1, flameSum: 0, relit: false, dead: false, untouched: 0, thought: 0, tleft: 0, tx: 0, ty: 0, said: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 101) >>> 0)));\\n      stepCandleOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepRepOne(sess, seat, store, dt, primary) {\\n360→    const fam = sess.fam, bal = seat.bal;\\n    if (!bal) return;\\n    drive(seat, fam, dt);\\n    if (store.doneReps === Math.floor(fam.planned * 0.6) && !store.fatigued) {\\n      store.fatigued = true;\\n      const mul = G.dev && G.dev.on ? G.dev.v.fatigue / 1.5 : 1;\\n      bal.set = Object.assign({}, bal.set, { A: bal.set.A * 1.5 * mul, k: bal.set.k * 0.8, kx: 16 * 0.8, ky: 16 * 0.8 });\\n    }\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const depth = fam.axis === 'x' ? clamp(fam.side > 0 ? bal.px : -bal.px, 0, 1) : clamp(-bal.py, 0, 1);\\n370→    const tol = G.dev && G.dev.on ? G.dev.v.repTol : 0.08;\\n    store.err += Math.abs(depth - fam.bead);\\n    store.form += fam.axis === 'x' ? Math.abs(bal.py) : Math.abs(bal.px);\\n    store.samples++;\\n    const cyc = Math.floor(fam.t / fam.cycle);\\n    if (cyc > store.doneReps) {\\n      const meanErr = store.err / Math.max(1, store.samples);\\n      let sc = meanErr <= tol ? 1 : meanErr >= 0.35 ? 0 : (0.35 - meanErr) / (0.35 - tol);\\n      store.scores.push(sc);\\n      store.err = 0; store.samples = 0;\\n380→      store.doneReps = cyc;\\n      if (primary && store.doneReps === fam.planned && !fam.extra) {\\n        const mean = store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length;\\n        if (mean > 0.8) { fam.extra = true; fam.planned += 2; sess.limit += fam.cycle * 2; }\\n      }\\n    }\\n    const form = store.form / Math.max(1, bal.frames);\\n    const pen = clamp(form * 0.45, 0, 0.3);\\n    const mean = store.scores.length ? store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length : 0;\\n    const pct = clamp(mean * (1 - pen), 0, 1);\\n390→    if (primary) sess.pct = pct;\\n    if (sess.classMode) seat.pct = pct;\\n    if (primary && store.doneReps >= fam.planned && store.scores.length >= fam.planned) sess.ended = true;\\n  }\\n\\n  function stepRep(sess, dt) {\\n    const fam = sess.fam;\\n    const prev = fam.bead;\\n    fam.bead = beadOf(fam.t, sess.tier);\\n    fam.beadVel = (fam.bead - prev) / dt;\\n400→    fam.side = (Math.floor(fam.t / fam.cycle) % 2 === 0) ? 1 : -1;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const store = i === 0 ? fam : (seat._rep || (seat._rep = { err: 0, samples: 0, form: 0, scores: [], doneReps: 0, fatigued: false }));\\n      stepRepOne(sess, seat, store, dt, i === 0);\\n    }\\n  }\\n\\n410→  function chartOf(sess) {\\n    const tier = sess.tier;\\n    const chart = G.CHARTS[tier >= 2 ? 't2' : 't1'];\\n    const song = tier >= 2 ? G.SONGS.stepB : G.SONGS.stepA;\\n    const lanes = sess.classMode ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\\n    const scale = G.dev && G.dev.on ? G.dev.v.rhythm : 1;\\n    const rh = new E.Rhythm(G.game, {\\n      song: song, chart: chart, lanes: lanes, life: 4,\\n      windows: { perfect: 45 * scale, great: 90 * scale, good: 135 * scale }\\n    });\\n420→    return rh;\\n  }\\n\\n  function chartMiss(rh) {\\n    if (!rh || !rh.started || rh.done) return;\\n    const A = rh.game.audio, s = A.pos.step, spb = rh._spb();\\n    for (let i = 0; i < rh.notes.length; i++) {\\n      const n = rh.notes[i];\\n      if (n.step > s + 8 * rh.song.steps) break;\\n      if (n.call) continue;\\n430→      if (!n.j && (s - n.step) * spb * 1000 > rh.windows.good) rh._judge(n, 'miss', 0);\\n      if (rh.done) return;\\n    }\\n    const p = A.pos;\\n    if (!p.playing && p.t > 0) rh.done = true;\\n  }\\n\\n  function stepSeatChart(sess, seat) {\\n    if (!seat._rh) {\\n      seat._rh = chartOf(sess);\\n440→      seat._rh.started = true;\\n    }\\n    const rh = seat._rh;\\n    const I = seatInput(seat);\\n    const skill = skillName(seat);\\n    if (skill) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n450→        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    } else if (I) {\\n      rh.lanes.forEach(function (a, i) { if (I.pressed(a)) rh.hit(i); });\\n    }\\n    chartMiss(rh);\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n460→    return judged ? rh.accuracy : 0;\\n  }\\n\\n  function stepStep(sess, dt) {\\n    const fam = sess.fam, rh = fam.rh, seat = sess.seats[0];\\n    if (!rh) return;\\n    const skill = skillName(seat);\\n    if (skill && !sess.classMode) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n470→      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    }\\n    rh.update();\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n480→    sess.pct = judged ? rh.accuracy : 0;\\n    if (sess.classMode) {\\n      seat.pct = sess.pct;\\n      for (let i = 1; i < sess.seats.length; i++) {\\n        const q = sess.seats[i];\\n        if (q.scoring === false) { q.pct = 0; continue; }\\n        q.pct = stepSeatChart(sess, q);\\n      }\\n    }\\n    if (rh.done) sess.ended = true;\\n490→    void dt;\\n  }\\n\\n  function stepHoopOne(sess, seat, box, rng, dt, primary) {\\n    const clock = sess.fam.t;\\n    const ux = seat.ux || 0, uy = seat.uy || 0;\\n    const mag = Math.hypot(ux, uy);\\n    let omega = 0;\\n    if (mag > 0.55) {\\n      const ang = Math.atan2(uy, ux);\\n500→      let d = ang - (box.ang || 0);\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      if (box.haveAng) omega = d / dt;\\n      box.ang = ang; box.haveAng = true;\\n    } else box.haveAng = false;\\n    box.omega = omega;\\n    const lo = G.dev && G.dev.on ? G.dev.v.hoopLo : 7;\\n    const hi = G.dev && G.dev.on ? G.dev.v.hoopHi : 11;\\n    const dir = box.otherWay ? -1 : 1;\\n510→    const inBand = Math.abs(omega) >= lo && Math.abs(omega) <= hi && omega * dir > 0;\\n    if (inBand) { box.band += dt; box.out = 0; box.score += dt * (1 + box.hoops * 0.15); }\\n    else if (mag > 0.2) { box.out += dt; if (box.out > 1.5 && box.hoops > 1) { box.hoops--; box.drops++; box.out = 0; } }\\n    if (!box.otherWay && clock >= sess.limit * 0.5) box.otherWay = true;\\n    box.tossT -= dt;\\n    if (box.tossT <= 0) {\\n      box.tossT = 8;\\n      box.toss = { side: rng() < 0.5 ? -1 : 1, eta: 1.1 };\\n    }\\n    if (box.toss) {\\n520→      box.toss.eta -= dt;\\n      const hit = box.toss.side < 0 ? seat.catchL : seat.catchR;\\n      if (hit && Math.abs(box.toss.eta) <= 0.25) { box.caught++; box.hoops = Math.min(6, box.hoops + 1); box.toss = null; }\\n      else if (box.toss.eta < -0.25) box.toss = null;\\n    }\\n    const best = sess.limit * 1.4;\\n    const pct = clamp(box.score / best, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      sess.fam.omega = box.omega;\\n530→      sess.fam.otherWay = box.otherWay;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepHoop(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n540→      const box = i === 0 ? sess.fam : (seat._hoop || (seat._hoop = { omega: 0, ang: 0, band: 0, out: 0, hoops: 1, caught: 0, drops: 0, score: 0, otherWay: false, toss: null, tossT: 2, haveAng: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 131) >>> 0)));\\n      stepHoopOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepJog(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    const edgeL = seat.paceL && !fam.prevL;\\n    const edgeR = seat.paceR && !fam.prevR;\\n550→    fam.prevL = seat.paceL; fam.prevR = seat.paceR;\\n    if (edgeL || edgeR) { fam.steps++; fam.hist.push(fam.t); }\\n    while (fam.hist.length && fam.t - fam.hist[0] > 1) fam.hist.shift();\\n    fam.cad = fam.hist.length;\\n    const lo = G.dev && G.dev.on ? G.dev.v.jogLo : 2.6;\\n    const hi = G.dev && G.dev.on ? G.dev.v.jogHi : 3.4;\\n    const zoned = fam.cad >= lo && fam.cad <= hi && fam.stitch <= 0;\\n    if (zoned) fam.zone += dt;\\n    if (fam.cad > 4.2) fam.sprint += dt; else fam.sprint = 0;\\n    if (fam.sprint > 2 && fam.stitch <= 0) fam.stitch = 3;\\n560→    if (fam.stitch > 0) fam.stitch -= dt;\\n    const speed = (G.dev && G.dev.on ? G.dev.v.jogSpeed : 1) * (zoned ? 8 : 3);\\n    fam.z += speed * dt;\\n    fam.x += (seat.ux || 0) * 1.6 * dt;\\n    const cups = [12, 28, 44, 58];\\n    for (let i = 0; i < cups.length; i++) {\\n      if (fam.gotCup && fam.gotCup[i]) continue;\\n      if (fam.z >= cups[i] && fam.z - speed * dt < cups[i]) {\\n        const cx = (i % 2 ? 0.8 : -0.8);\\n        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\\n570→      }\\n    }\\n    fam.nextCup = null;\\n    for (let i = 0; i < cups.length; i++) if (!(fam.gotCup && fam.gotCup[i]) && fam.z < cups[i]) { fam.nextCup = { x: (i % 2 ? 0.8 : -0.8), z: cups[i] }; break; }\\n    const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n  }\\n\\n  function stepSlalom(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n580→    if (fam.done) return;\\n    if (fam.tumble > 0) { fam.tumble -= dt; return; }\\n    const base = G.dev && G.dev.on ? G.dev.v.skiSpeed : 220;\\n    const turn = G.dev && G.dev.on ? G.dev.v.skiTurn : 1.6;\\n    let spd = base;\\n    if (seat.uy > 0.3) spd *= 1.35;\\n    if (seat.uy < -0.3) spd *= 0.6;\\n    fam.z += spd * dt;\\n    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\\n    const gates = G.GATES;\\n590→    for (let i = 0; i < gates.length; i++) {\\n      const g = gates[i];\\n      if (fam.missed[i]) continue;\\n      if (fam.z >= g.z && fam.z - spd * dt < g.z) {\\n        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\\n        if (fam.missed[i]) fam.pen += 3;\\n      }\\n    }\\n    for (let i = 0; i < G.OBSTACLES.length; i++) {\\n      const o = G.OBSTACLES[i];\\n600→      if (fam.hitO && fam.hitO[i]) continue;\\n      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\\n        fam.hitO = fam.hitO || {}; fam.hitO[i] = true; fam.tumble = 1.2; fam.pen += 1.2;\\n      }\\n    }\\n    let next = null;\\n    for (let i = 0; i < gates.length; i++) if (gates[i].z > fam.z - 20) { next = gates[i]; break; }\\n    fam.nextGate = next;\\n    if (fam.z >= fam.finish) {\\n      fam.done = true;\\n610→      const par = 58, worst = 90;\\n      const time = fam.t + fam.pen;\\n      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function stepTray(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (!seat.bal) {\\n620→      seat.bal = new G.Balance({ k: 14, c: 8, s: 1, A: 0.5, nf: 0.8, R: 0.4, push: null }, sess.seed, {});\\n    }\\n    const sk = skillName(seat);\\n    if (sk) {\\n      const aim = sk === 'poor' ? 0.25 : sk === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    }\\n    seat.bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const Gv = G.dev && G.dev.on ? G.dev.v.trayG : 420;\\n    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\\n630→    if (fam.world) {\\n      if (G.dev && G.dev.on && fam.world.bodies) {\\n        const mu = 0.04 * fr;\\n        fam.world.bodies.forEach(function (b) { if (b && b._olive) b.friction = mu; });\\n      }\\n      if (fam.gecko) fam.gecko.moveTo(78, 100 + Math.sin(fam.t * 0.55) * 36, 0, 22, 0);\\n      fam.world.gravity = [seat.bal.px * Gv, -seat.bal.py * Gv];\\n      fam.world.wake();\\n      fam.world.step(dt);\\n      const spec = G.TRAYS[fam.trayI];\\n640→      const need = spec ? spec.olives.length : 0;\\n      const gotHere = fam.got - fam.trayGot0;\\n      if (gotHere >= need) {\\n        fam.trayI++;\\n        if (fam.trayI >= G.TRAYS.length) { fam.world = null; sess.ended = true; }\\n        else loadTray(sess);\\n      }\\n    } else if (fam.trayI >= G.TRAYS.length) sess.ended = true;\\n    const share = sess.limit > 0 ? clamp((sess.limit - fam.t) / sess.limit, 0, 1) : 0;\\n    const base = fam.total ? fam.got / fam.total : 0;\\n650→    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\\n    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\\n  }\\n\\n  function stepLaundry(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    const skill = skillName(seat);\\n    if (skill) seat.effort = EFFORT[skill] || 0.5;\\n    arm(bal, skill);\\n    const effort = clamp(seat.local && !skill ? leanFor(seat).effort : seat.effort, 0, 1);\\n660→    const spd = effort * 2.2;\\n    if (!fam.rope) fam.rope = Object.assign({}, bal.set);\\n    /* Faster walking sways the rope. The set on the balance is a copy, so the band table stays put.\\n       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\\n    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\\n    bal.set = Object.assign({}, fam.rope, { s: baseS + effort * 4 });\\n    fam.air -= dt;\\n    const pins = [8, 19, 30, 41, 50];\\n    let ahead = null;\\n    for (let i = 0; i < pins.length; i++) {\\n670→      const d = pins[i] - fam.x;\\n      if (d > 0.04) { ahead = { dist: d, x: pins[i] }; break; }\\n    }\\n    fam.pinAhead = ahead;\\n    /* One jump per pin, long enough to land past it. Air freezes the plate, not the walker. */\\n    if (seat.jump && fam.air <= 0 && ahead && fam.cleared !== ahead.x && ahead.dist < 0.95) {\\n      fam.air = Math.min(0.85, ahead.dist / Math.max(0.45, spd) + 0.12);\\n      fam.cleared = ahead.x;\\n    }\\n    bal.holdP = fam.air > 0;\\n680→    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"offset\":240,\"limit\":450,\"raw_output\":\"      try { other.off = true; } catch (e) { /* it has arrived */ }\\n      try { G.game.audio.sfx('plop'); } catch (e) { /* quiet */ }\\n    };\\n    fam.world = world;\\n    fam.trayOlives = spec.olives.length;\\n    fam.trayGot0 = fam.got;\\n  }\\n\\n  function stepFamily(sess, dt) {\\n    const fam = sess.fam, act = sess.act;\\n    if (!fam) return;\\n    fam.t += dt;\\n    const seat = sess.seats[0];\\n    drive(seat, fam, dt);\\n    sess.seats.forEach(function (q, i) { if (i > 0) drive(q, fam, dt); });\\n    if (act.family === 'hold') stepHold(sess, dt);\\n    else if (act.family === 'sun') stepSun(sess, dt);\\n    else if (act.family === 'candle') stepCandle(sess, dt);\\n    else if (act.family === 'rep') stepRep(sess, dt);\\n    else if (act.family === 'step') stepStep(sess, dt);\\n    else if (act.family === 'hoop') stepHoop(sess, dt);\\n    else if (act.family === 'jog') stepJog(sess, dt);\\n    else if (act.family === 'slalom') stepSlalom(sess, dt);\\n    else if (act.family === 'tray') stepTray(sess, dt);\\n    else if (act.family === 'laundry') stepLaundry(sess, dt);\\n    const bal = seat.bal;\\n    if (bal) {\\n      sess.leanX = bal.px; sess.leanY = bal.py;\\n      if (seat.local) { G.lean.ux = seat.ux; G.lean.uy = seat.uy; }\\n    }\\n  }\\n\\n  function stepHold(sess, dt) {\\n    const fam = sess.fam;\\n    const c = holdCenter(fam.t);\\n    fam.c = c;\\n    let fx = 0;\\n    const gull = Math.floor(fam.t / 12);\\n    const gph = fam.t % 12;\\n    if (gull > 0 && gph < 0.28) fx = (gull % 2 ? 1 : -1) * 0.7;\\n    fam.fx = fx;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i], bal = seat && seat.bal;\\n      if (!bal) continue;\\n      arm(bal, skillName(seat));\\n      bal.step(dt, seat.ux, seat.uy, fx, 0, c);\\n      const pct = clamp(bal.steadiness - 0.05 * bal.falls, 0, 1);\\n      if (i === 0) {\\n        sess.pct = pct;\\n        if (sess.tier >= 2 && bal.px) fam.eyes = true;\\n      }\\n      if (many) seat.pct = pct;\\n    }\\n  }\\n\\n  function stepSun(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    fam.guide = guideOf(fam.t);\\n    arm(bal, skillName(seat));\\n    if (skillName(seat)) seat.breath = fam.guide;\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const breath = seat.local && !skillName(seat) ? leanFor(seat).breath : seat.breath;\\n    fam.matchN++;\\n    if (Math.abs(breath - fam.guide) <= 0.25) fam.match++;\\n    fam.poseI = Math.min(G.SUN_POSES.length - 1, Math.floor(fam.t / 16));\\n    sess.pct = clamp(0.6 * bal.steadiness + 0.4 * (fam.match / fam.matchN), 0, 1);\\n    if (fam.t >= 80) sess.ended = true;\\n  }\\n\\n  function stepCandleOne(sess, seat, box, rng, dt, primary) {\\n    const bal = seat.bal;\\n    if (!bal) return;\\n    arm(bal, skillName(seat));\\n    let fx = 0, fy = 0;\\n    box.thought -= dt;\\n    if (box.thought <= 0) {\\n      box.thought = 4.5 + (rng() * 2);\\n      const ang = rng() * Math.PI * 2;\\n      box.tx = Math.cos(ang) * 0.85;\\n      box.ty = Math.sin(ang) * 0.85;\\n      box.tleft = 1.1;\\n      if (sess.tier >= 2 && rng() > 0.5) { box.tx *= 1.3; box.ty *= 1.3; }\\n    }\\n    if (box.tleft > 0) { box.tleft -= dt; fx = box.tx; fy = box.ty; }\\n    bal.step(dt, seat.ux, seat.uy, fx, fy, { x: 0, y: 0 });\\n    const sp = Math.hypot(bal.vx, bal.vy);\\n    const inside = bal.stumble <= 0 && Math.hypot(bal.px, bal.py) < (bal.set.R || 0.2);\\n    if (sp > 0.55) box.flame -= 0.4 * dt;\\n    else if (inside) box.flame += 0.12 * dt;\\n    else box.flame -= 0.055 * dt;\\n    box.flame = clamp(box.flame, 0, 1);\\n    if (box.flame <= 0 && !box.relit) { box.relit = true; box.flame = 0.15; }\\n    else if (box.flame <= 0 && box.relit) box.dead = true;\\n    box.flameSum += box.flame;\\n    const moved = Math.hypot(seat.ux, seat.uy) > 0.05 || seat.breath > 0.05;\\n    if (!moved) box.untouched += dt; else box.untouched = 0;\\n    if (primary && box.untouched > 20 && !box.said) { box.said = true; G.subtitle = G.LINES.tare.filter(function (s) { return s.indexOf('controller') >= 0; })[0] || ''; }\\n    const mean = box.flameSum / Math.max(1, bal.frames);\\n    const pct = clamp(0.6 * bal.steadiness + 0.4 * mean, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      if (box.dead) sess.ended = true;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepCandle(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._candle || (seat._candle = { flame: 1, flameSum: 0, relit: false, dead: false, untouched: 0, thought: 0, tleft: 0, tx: 0, ty: 0, said: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 101) >>> 0)));\\n      stepCandleOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepRepOne(sess, seat, store, dt, primary) {\\n    const fam = sess.fam, bal = seat.bal;\\n    if (!bal) return;\\n    drive(seat, fam, dt);\\n    if (store.doneReps === Math.floor(fam.planned * 0.6) && !store.fatigued) {\\n      store.fatigued = true;\\n      const mul = G.dev && G.dev.on ? G.dev.v.fatigue / 1.5 : 1;\\n      bal.set = Object.assign({}, bal.set, { A: bal.set.A * 1.5 * mul, k: bal.set.k * 0.8, kx: 16 * 0.8, ky: 16 * 0.8 });\\n    }\\n    bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const depth = fam.axis === 'x' ? clamp(fam.side > 0 ? bal.px : -bal.px, 0, 1) : clamp(-bal.py, 0, 1);\\n    const tol = G.dev && G.dev.on ? G.dev.v.repTol : 0.08;\\n    store.err += Math.abs(depth - fam.bead);\\n    store.form += fam.axis === 'x' ? Math.abs(bal.py) : Math.abs(bal.px);\\n    store.samples++;\\n    const cyc = Math.floor(fam.t / fam.cycle);\\n    if (cyc > store.doneReps) {\\n      const meanErr = store.err / Math.max(1, store.samples);\\n      let sc = meanErr <= tol ? 1 : meanErr >= 0.35 ? 0 : (0.35 - meanErr) / (0.35 - tol);\\n      store.scores.push(sc);\\n      store.err = 0; store.samples = 0;\\n      store.doneReps = cyc;\\n      if (primary && store.doneReps === fam.planned && !fam.extra) {\\n        const mean = store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length;\\n        if (mean > 0.8) { fam.extra = true; fam.planned += 2; sess.limit += fam.cycle * 2; }\\n      }\\n    }\\n    const form = store.form / Math.max(1, bal.frames);\\n    const pen = clamp(form * 0.45, 0, 0.3);\\n    const mean = store.scores.length ? store.scores.reduce(function (a, b) { return a + b; }, 0) / store.scores.length : 0;\\n    const pct = clamp(mean * (1 - pen), 0, 1);\\n    if (primary) sess.pct = pct;\\n    if (sess.classMode) seat.pct = pct;\\n    if (primary && store.doneReps >= fam.planned && store.scores.length >= fam.planned) sess.ended = true;\\n  }\\n\\n  function stepRep(sess, dt) {\\n    const fam = sess.fam;\\n    const prev = fam.bead;\\n    fam.bead = beadOf(fam.t, sess.tier);\\n    fam.beadVel = (fam.bead - prev) / dt;\\n    fam.side = (Math.floor(fam.t / fam.cycle) % 2 === 0) ? 1 : -1;\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const store = i === 0 ? fam : (seat._rep || (seat._rep = { err: 0, samples: 0, form: 0, scores: [], doneReps: 0, fatigued: false }));\\n      stepRepOne(sess, seat, store, dt, i === 0);\\n    }\\n  }\\n\\n  function chartOf(sess) {\\n    const tier = sess.tier;\\n    const chart = G.CHARTS[tier >= 2 ? 't2' : 't1'];\\n    const song = tier >= 2 ? G.SONGS.stepB : G.SONGS.stepA;\\n    const lanes = sess.classMode ? ['left', 'down', 'up', 'right'] : ['stepL', 'stepD', 'stepU', 'stepR'];\\n    const scale = G.dev && G.dev.on ? G.dev.v.rhythm : 1;\\n    const rh = new E.Rhythm(G.game, {\\n      song: song, chart: chart, lanes: lanes, life: 4,\\n      windows: { perfect: 45 * scale, great: 90 * scale, good: 135 * scale }\\n    });\\n    return rh;\\n  }\\n\\n  function chartMiss(rh) {\\n    if (!rh || !rh.started || rh.done) return;\\n    const A = rh.game.audio, s = A.pos.step, spb = rh._spb();\\n    for (let i = 0; i < rh.notes.length; i++) {\\n      const n = rh.notes[i];\\n      if (n.step > s + 8 * rh.song.steps) break;\\n      if (n.call) continue;\\n      if (!n.j && (s - n.step) * spb * 1000 > rh.windows.good) rh._judge(n, 'miss', 0);\\n      if (rh.done) return;\\n    }\\n    const p = A.pos;\\n    if (!p.playing && p.t > 0) rh.done = true;\\n  }\\n\\n  function stepSeatChart(sess, seat) {\\n    if (!seat._rh) {\\n      seat._rh = chartOf(sess);\\n      seat._rh.started = true;\\n    }\\n    const rh = seat._rh;\\n    const I = seatInput(seat);\\n    const skill = skillName(seat);\\n    if (skill) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    } else if (I) {\\n      rh.lanes.forEach(function (a, i) { if (I.pressed(a)) rh.hit(i); });\\n    }\\n    chartMiss(rh);\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n    return judged ? rh.accuracy : 0;\\n  }\\n\\n  function stepStep(sess, dt) {\\n    const fam = sess.fam, rh = fam.rh, seat = sess.seats[0];\\n    if (!rh) return;\\n    const skill = skillName(seat);\\n    if (skill && !sess.classMode) {\\n      const off = STEP_OFF[skill] || 0.02;\\n      const pos = G.game.audio.pos;\\n      const spb = 60 / (pos.bpm || 100) / 4;\\n      for (let i = 0; i < rh.notes.length; i++) {\\n        const n = rh.notes[i];\\n        if (n.j || n.call || n._bot) continue;\\n        const ahead = (n.step - pos.step) * spb;\\n        if (ahead <= off) { n._bot = true; rh.hit(n.lane); }\\n      }\\n    }\\n    rh.update();\\n    const judged = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss;\\n    sess.pct = judged ? rh.accuracy : 0;\\n    if (sess.classMode) {\\n      seat.pct = sess.pct;\\n      for (let i = 1; i < sess.seats.length; i++) {\\n        const q = sess.seats[i];\\n        if (q.scoring === false) { q.pct = 0; continue; }\\n        q.pct = stepSeatChart(sess, q);\\n      }\\n    }\\n    if (rh.done) sess.ended = true;\\n    void dt;\\n  }\\n\\n  function stepHoopOne(sess, seat, box, rng, dt, primary) {\\n    const clock = sess.fam.t;\\n    const ux = seat.ux || 0, uy = seat.uy || 0;\\n    const mag = Math.hypot(ux, uy);\\n    let omega = 0;\\n    if (mag > 0.55) {\\n      const ang = Math.atan2(uy, ux);\\n      let d = ang - (box.ang || 0);\\n      while (d > Math.PI) d -= Math.PI * 2;\\n      while (d < -Math.PI) d += Math.PI * 2;\\n      if (box.haveAng) omega = d / dt;\\n      box.ang = ang; box.haveAng = true;\\n    } else box.haveAng = false;\\n    box.omega = omega;\\n    const lo = G.dev && G.dev.on ? G.dev.v.hoopLo : 7;\\n    const hi = G.dev && G.dev.on ? G.dev.v.hoopHi : 11;\\n    const dir = box.otherWay ? -1 : 1;\\n    const inBand = Math.abs(omega) >= lo && Math.abs(omega) <= hi && omega * dir > 0;\\n    if (inBand) { box.band += dt; box.out = 0; box.score += dt * (1 + box.hoops * 0.15); }\\n    else if (mag > 0.2) { box.out += dt; if (box.out > 1.5 && box.hoops > 1) { box.hoops--; box.drops++; box.out = 0; } }\\n    if (!box.otherWay && clock >= sess.limit * 0.5) box.otherWay = true;\\n    box.tossT -= dt;\\n    if (box.tossT <= 0) {\\n      box.tossT = 8;\\n      box.toss = { side: rng() < 0.5 ? -1 : 1, eta: 1.1 };\\n    }\\n    if (box.toss) {\\n      box.toss.eta -= dt;\\n      const hit = box.toss.side < 0 ? seat.catchL : seat.catchR;\\n      if (hit && Math.abs(box.toss.eta) <= 0.25) { box.caught++; box.hoops = Math.min(6, box.hoops + 1); box.toss = null; }\\n      else if (box.toss.eta < -0.25) box.toss = null;\\n    }\\n    const best = sess.limit * 1.4;\\n    const pct = clamp(box.score / best, 0, 1);\\n    if (primary) {\\n      sess.pct = pct;\\n      sess.fam.omega = box.omega;\\n      sess.fam.otherWay = box.otherWay;\\n    }\\n    if (sess.classMode) seat.pct = pct;\\n  }\\n\\n  function stepHoop(sess, dt) {\\n    const many = !!(sess.classMode && sess.seats.length > 1);\\n    const list = many ? sess.seats : [sess.seats[0]];\\n    for (let i = 0; i < list.length; i++) {\\n      const seat = list[i];\\n      const box = i === 0 ? sess.fam : (seat._hoop || (seat._hoop = { omega: 0, ang: 0, band: 0, out: 0, hoops: 1, caught: 0, drops: 0, score: 0, otherWay: false, toss: null, tossT: 2, haveAng: false }));\\n      const rng = i === 0 ? sess.rng : (seat._rng || (seat._rng = E.rng((sess.seed + i * 131) >>> 0)));\\n      stepHoopOne(sess, seat, box, rng, dt, i === 0);\\n    }\\n  }\\n\\n  function stepJog(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    const edgeL = seat.paceL && !fam.prevL;\\n    const edgeR = seat.paceR && !fam.prevR;\\n    fam.prevL = seat.paceL; fam.prevR = seat.paceR;\\n    if (edgeL || edgeR) { fam.steps++; fam.hist.push(fam.t); }\\n    while (fam.hist.length && fam.t - fam.hist[0] > 1) fam.hist.shift();\\n    fam.cad = fam.hist.length;\\n    const lo = G.dev && G.dev.on ? G.dev.v.jogLo : 2.6;\\n    const hi = G.dev && G.dev.on ? G.dev.v.jogHi : 3.4;\\n    const zoned = fam.cad >= lo && fam.cad <= hi && fam.stitch <= 0;\\n    if (zoned) fam.zone += dt;\\n    if (fam.cad > 4.2) fam.sprint += dt; else fam.sprint = 0;\\n    if (fam.sprint > 2 && fam.stitch <= 0) fam.stitch = 3;\\n    if (fam.stitch > 0) fam.stitch -= dt;\\n    const speed = (G.dev && G.dev.on ? G.dev.v.jogSpeed : 1) * (zoned ? 8 : 3);\\n    fam.z += speed * dt;\\n    fam.x += (seat.ux || 0) * 1.6 * dt;\\n    const cups = [12, 28, 44, 58];\\n    for (let i = 0; i < cups.length; i++) {\\n      if (fam.gotCup && fam.gotCup[i]) continue;\\n      if (fam.z >= cups[i] && fam.z - speed * dt < cups[i]) {\\n        const cx = (i % 2 ? 0.8 : -0.8);\\n        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\\n      }\\n    }\\n    fam.nextCup = null;\\n    for (let i = 0; i < cups.length; i++) if (!(fam.gotCup && fam.gotCup[i]) && fam.z < cups[i]) { fam.nextCup = { x: (i % 2 ? 0.8 : -0.8), z: cups[i] }; break; }\\n    const share = fam.t > 0 ? fam.zone / fam.t : 0;\\n    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\\n  }\\n\\n  function stepSlalom(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (fam.done) return;\\n    if (fam.tumble > 0) { fam.tumble -= dt; return; }\\n    const base = G.dev && G.dev.on ? G.dev.v.skiSpeed : 220;\\n    const turn = G.dev && G.dev.on ? G.dev.v.skiTurn : 1.6;\\n    let spd = base;\\n    if (seat.uy > 0.3) spd *= 1.35;\\n    if (seat.uy < -0.3) spd *= 0.6;\\n    fam.z += spd * dt;\\n    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\\n    const gates = G.GATES;\\n    for (let i = 0; i < gates.length; i++) {\\n      const g = gates[i];\\n      if (fam.missed[i]) continue;\\n      if (fam.z >= g.z && fam.z - spd * dt < g.z) {\\n        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\\n        if (fam.missed[i]) fam.pen += 3;\\n      }\\n    }\\n    for (let i = 0; i < G.OBSTACLES.length; i++) {\\n      const o = G.OBSTACLES[i];\\n      if (fam.hitO && fam.hitO[i]) continue;\\n      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\\n        fam.hitO = fam.hitO || {}; fam.hitO[i] = true; fam.tumble = 1.2; fam.pen += 1.2;\\n      }\\n    }\\n    let next = null;\\n    for (let i = 0; i < gates.length; i++) if (gates[i].z > fam.z - 20) { next = gates[i]; break; }\\n    fam.nextGate = next;\\n    if (fam.z >= fam.finish) {\\n      fam.done = true;\\n      const par = 58, worst = 90;\\n      const time = fam.t + fam.pen;\\n      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\\n      sess.ended = true;\\n    }\\n  }\\n\\n  function stepTray(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0];\\n    if (!seat.bal) {\\n      seat.bal = new G.Balance({ k: 14, c: 8, s: 1, A: 0.5, nf: 0.8, R: 0.4, push: null }, sess.seed, {});\\n    }\\n    const sk = skillName(seat);\\n    if (sk) {\\n      const aim = sk === 'poor' ? 0.25 : sk === 'average' ? 0.7 : 0.95;\\n      seat.ux = aim; seat.uy = 0.02;\\n    }\\n    seat.bal.step(dt, seat.ux, seat.uy, 0, 0, { x: 0, y: 0 });\\n    const Gv = G.dev && G.dev.on ? G.dev.v.trayG : 420;\\n    const fr = G.dev && G.dev.on ? G.dev.v.trayFric : 3;\\n    if (fam.world) {\\n      if (G.dev && G.dev.on && fam.world.bodies) {\\n        const mu = 0.04 * fr;\\n        fam.world.bodies.forEach(function (b) { if (b && b._olive) b.friction = mu; });\\n      }\\n      if (fam.gecko) fam.gecko.moveTo(78, 100 + Math.sin(fam.t * 0.55) * 36, 0, 22, 0);\\n      fam.world.gravity = [seat.bal.px * Gv, -seat.bal.py * Gv];\\n      fam.world.wake();\\n      fam.world.step(dt);\\n      const spec = G.TRAYS[fam.trayI];\\n      const need = spec ? spec.olives.length : 0;\\n      const gotHere = fam.got - fam.trayGot0;\\n      if (gotHere >= need) {\\n        fam.trayI++;\\n        if (fam.trayI >= G.TRAYS.length) { fam.world = null; sess.ended = true; }\\n        else loadTray(sess);\\n      }\\n    } else if (fam.trayI >= G.TRAYS.length) sess.ended = true;\\n    const share = sess.limit > 0 ? clamp((sess.limit - fam.t) / sess.limit, 0, 1) : 0;\\n    const base = fam.total ? fam.got / fam.total : 0;\\n    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\\n    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\\n  }\\n\\n  function stepLaundry(sess, dt) {\\n    const fam = sess.fam, seat = sess.seats[0], bal = seat.bal;\\n    const skill = skillName(seat);\\n    if (skill) seat.effort = EFFORT[skill] || 0.5;\\n    arm(bal, skill);\\n    const effort = clamp(seat.local && !skill ? leanFor(seat).effort : seat.effort, 0, 1);\\n    const spd = effort * 2.2;\\n    if (!fam.rope) fam.rope = Object.assign({}, bal.set);\\n    /* Faster walking sways the rope. The set on the balance is a copy, so the band table stays put.\\n       ropeS is the dev slider for that instability. At its default it matches the laundry set. */\\n    const baseS = G.dev && G.dev.on ? G.dev.v.ropeS : fam.rope.s;\\n    bal.set = Object.assign({}, fam.rope, { s: baseS + effort * 4 });\\n    fam.air -= dt;\\n    const pins = [8, 19, 30, 41, 50];\\n    let ahead = null;\\n    for (let i = 0; i < pins.length; i++) {\\n      const d = pins[i] - fam.x;\\n      if (d > 0.04) { ahead = { dist: d, x: pins[i] }; break; }\\n    }\\n    fam.pinAhead = ahead;\\n    /* One jump per pin, long enough to land past it. Air freezes the plate, not the walker. */\\n    if (seat.jump && fam.air <= 0 && ahead && fam.cleared !== ahead.x && ahead.dist < 0.95) {\\n      fam.air = Math.min(0.85, ahead.dist / Math.max(0.45, spd) + 0.12);\\n      fam.cleared = ahead.x;\\n    }\\n    bal.holdP = fam.air > 0;\\n    fam.gust -= dt;\\n    fam.gustT -= dt;\\n    let fx = 0;\\n    if (fam.gustT <= 0) { fam.gustT = 4.5; fam.gust = 0.35; fam.gustSign = sess.rng() < 0.5 ? -1 : 1; }\\n    if (fam.gust > 0 && fam.air <= 0) {\\n      const g = G.dev && G.dev.on ? G.dev.v.gust : 9;\\n      fx = fam.gustSign * Math.min(g, 2.4);\\n    }\\n    bal.step(dt, seat.ux, seat.uy, fx, 0, { x: 0, y: 0 });\\n    /* A plate stumble is the rope moving under you. Only missing a pin walks you back to the post.\\n\",\"total_lines\":905}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a9e1b91f-99b7-47af-acde-2ee7ead8fa58-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"140→        const t = trail[i];\\n        E.px.disc(g, cx + t.x * rad, cy - t.y * rad, 1, 'rgba(44,198,230,' + (i / trail.length) + ')');\\n      }\\n      const px = cx + bal.px * rad, py = cy - bal.py * rad;\\n      E.px.disc(g, px, py, 3, '#ff7a59');\\n      E.px.disc(g, px, py, 1.4, '#ffffff');\\n      if (o.trace && G.dev && G.dev.panel) text(g, bal.px.toFixed(2) + ',' + bal.py.toFixed(2), cx - 20, cy + rad + 2, '#20404c', 1);\\n    });\\n  };\\n  G.drawStars = function (g, x, y, n) {\\n150→    for (let i = 0; i < 3; i++) text(g, i < n ? '★' : '·', x + i * 12, y, i < n ? '#14a8c8' : '#5f7f8a', 2);\\n  };\\n  G.DEV_DEFAULTS = {\\n    k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, reach: .33, nudge: 2.2,\\n    star1: .35, star2: .65, star3: .90, repTol: .08, rhythm: 1, fatigue: 1.5,\\n    hoopLo: 7, hoopHi: 11, jogLo: 2.6, jogHi: 3.4, jogSpeed: 1,\\n    skiSpeed: 220, skiTurn: 1.6, trayG: 420, trayFric: 3, ropeS: 16, gust: 9,\\n    timeScale: 1, minutesMul: 1\\n  };\\n  const DEV_HELP = {\\n160→    k: 'spring', c: 'damping', s: 'instability', A: 'noise', nf: 'noise rate', ring: 'ring scale', push: 'push', stumble: 'stumble at',\\n    reach: 'mouse reach', nudge: 'nudge rate', star1: '1 star', star2: '2 stars', star3: '3 stars', repTol: 'rep tolerance',\\n    rhythm: 'window scale', fatigue: 'fatigue', hoopLo: 'hoop low', hoopHi: 'hoop high', jogLo: 'jog low', jogHi: 'jog high',\\n    jogSpeed: 'jog speed', skiSpeed: 'ski speed', skiTurn: 'ski turn', trayG: 'tray gravity', trayFric: 'tray friction',\\n    ropeS: 'rope instability', gust: 'gust', timeScale: 'time scale', minutesMul: 'minutes'\\n  };\\n  function copyDev(src) { const o = {}; for (const k in src) o[k] = src[k]; return o; }\\n  G.dev = {\\n    on: false, panel: false, v: copyDev(G.DEV_DEFAULTS), i: 0, keys: Object.keys(G.DEV_DEFAULTS),\\n    tool: 0, pose: 'stork', poseI: 0, poseT: 0, poseMode: false, printed: '', frame: false, bot: null, trace: false, noStumble: false,\\n170→    open() {\\n      this.panel = true; this.on = true;\\n      if (G.game) { G.game.live = true; if (G.game.paused) G.game.resume(); }\\n    },\\n    close() { this.panel = false; this.on = false; if (G.game && !G.inSession) G.game.live = false; },\\n    adjust(key, delta) {\\n      if (!(key in this.v)) return;\\n      const d = G.DEV_DEFAULTS[key];\\n      const step = Math.abs(d) > 20 ? Math.abs(d) * 0.05 : Math.abs(d) > 2 ? 0.1 : d > 0.2 ? 0.05 : 0.01;\\n      this.v[key] = Math.round((this.v[key] + delta * (step || 0.05)) * 1000) / 1000;\\n180→      if (key === 'timeScale' && G.game) G.game.timeScale = this.v.timeScale;\\n    },\\n    reset() {\\n      this.v = copyDev(G.DEV_DEFAULTS);\\n      if (G.game) G.game.timeScale = 1;\\n    },\\n    jump(o) {\\n      o = o || {};\\n      if (!G.game) return;\\n      if (o.day) { G.profile.day = o.day; G.profile.sessions = 0; }\\n190→      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\\n      else if (o.scene) G.game.go(o.scene, o.data || {}, { fade: 0 });\\n    },\\n    jumpMode: false, jumpRow: 0, jumpDay: 1, jumpSceneI: 0, jumpActI: 0, jumpTier: 1,\\n    jumpScenes: ['bungalow', 'island', 'title', 'plate', 'bed', 'ending'],\\n    jumpActs: ['', 'stork', 'candle', 'squat', 'step', 'hoop', 'sun', 'push', 'lunge', 'jog', 'slalom', 'tray', 'laundry']\\n  };\\n  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot', 'Jump'];\\n  G.dev.tools = TOOLS;\\n  G.dev.clipNames = function () {\\n200→    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n210→    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 100;\\n220→    const key = String(name).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'pose';\\n    const row = key + \\\": { clip: '\\\" + name + \\\"', a: \\\" + t.toFixed(2) + \\\", b: \\\" + Math.max(b, t).toFixed(2) + \\\", tgt: 1.57 },\\\";\\n    this.printed = row;\\n    try { console.log(row); } catch (e) { /* the row is also on the panel */ }\\n    return row;\\n  };\\n  function eat(input, action) { try { input.suppress(action); } catch (e) { /* already used */ } }\\n  G.dev.update = function (input, dt) {\\n    if (!this.panel) return;\\n    const keys = this.keys;\\n230→    if (input.pressed('cancel')) {\\n      eat(input, 'cancel');\\n      if (this.poseMode) { this.poseMode = false; return; }\\n      if (this.jumpMode) { this.jumpMode = false; return; }\\n      this.close();\\n      return;\\n    }\\n    if (this.poseMode) {\\n      const names = this.clipNames();\\n      const n = names.length || 1;\\n240→      if (input.pressed('up')) { this.poseI = (this.poseI + n - 1) % n; this.poseT = 0; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.poseI = (this.poseI + 1) % n; this.poseT = 0; eat(input, 'down'); }\\n      const dur = (this.currentClip() && this.currentClip().dur) || 2;\\n      if (input.pressed('left') || input.repeat('left')) { this.poseT = Math.max(0, this.poseT - 0.05); eat(input, 'left'); }\\n      if (input.pressed('right') || input.repeat('right')) { this.poseT = Math.min(dur, this.poseT + 0.05); eat(input, 'right'); }\\n      if (input.pressed('confirm')) { this.printPose(); eat(input, 'confirm'); }\\n      void dt;\\n      return;\\n    }\\n    if (this.jumpMode) {\\n250→      const row = this.jumpRow;\\n      if (input.pressed('up')) { this.jumpRow = (row + 3) % 4; eat(input, 'up'); }\\n      if (input.pressed('down')) { this.jumpRow = (row + 1) % 4; eat(input, 'down'); }\\n      const dir = (input.pressed('right') || input.repeat('right')) ? 1 : (input.pressed('left') || input.repeat('left')) ? -1 : 0;\\n      if (dir) {\\n        eat(input, dir > 0 ? 'right' : 'left');\\n        if (this.jumpRow === 0) this.jumpDay = Math.max(1, Math.min(5, this.jumpDay + dir));\\n        else if (this.jumpRow === 1) this.jumpSceneI = (this.jumpSceneI + dir + this.jumpScenes.length) % this.jumpScenes.length;\\n        else if (this.jumpRow === 2) this.jumpActI = (this.jumpActI + dir + this.jumpActs.length) % this.jumpActs.length;\\n        else this.jumpTier = this.jumpTier === 1 ? 2 : 1;\\n260→      }\\n      if (input.pressed('confirm')) {\\n        eat(input, 'confirm');\\n        const act = this.jumpActs[this.jumpActI];\\n        const o = { day: this.jumpDay, tier: this.jumpTier };\\n        if (act) o.activity = act;\\n        else o.scene = this.jumpScenes[this.jumpSceneI];\\n        this.jumpMode = false;\\n        this.jump(o);\\n      }\\n270→      void dt;\\n      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (input.repeat && (input.pressed('up') && (input.held.has('ArrowUp') || input.lastDevice === 'gamepad'))) this.i = (this.i + keys.length - 1) % keys.length;\\n    if (up && input.pressed('up')) { this.i = (this.i + keys.length - 1) % keys.length; eat(input, 'up'); }\\n    if (down && input.pressed('down')) { this.i = (this.i + 1) % keys.length; eat(input, 'down'); }\\n280→    const k = keys[this.i];\\n    if ((left && (input.pressed('left') || input.repeat('left'))) ) { this.adjust(k, -1); eat(input, 'left'); }\\n    if ((right && (input.pressed('right') || input.repeat('right')))) { this.adjust(k, 1); eat(input, 'right'); }\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm')) { eat(input, 'confirm'); this.toolAct(this.tool); }\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n290→    else if (i === 1 && G.finishNow) G.finishNow(1);\\n    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n300→    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n    else if (TOOLS[i] === 'Jump') { this.jumpMode = !this.jumpMode; if (this.jumpMode) this.jumpRow = 0; }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n310→    try {\\n      rig.mocap = lib.sample(clip, this.poseT || 0);\\n      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n320→    if (!this.panel || !r) return;\\n    if (this.poseMode) this.drawPose(r);\\n    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n330→        const on = start + n === self.i;\\n        const y = 18 + n * 12;\\n        if (on) E.px.rect(g, 4, y - 1, w - 8, 11, '#bfeee0');\\n        const def = G.DEV_DEFAULTS[k];\\n        text(g, (DEV_HELP[k] || k) + ' ' + self.v[k], 8, y, '#20404c', 1);\\n        if (self.v[k] !== def) text(g, 'd' + def, w - 36, y, '#5f7f8a', 1);\\n      }\\n      if (self.poseMode) {\\n        const names = self.clipNames();\\n        const clip = self.currentClip();\\n340→        text(g, (names[self.poseI] || '') + '  ' + (self.poseT || 0).toFixed(2), 8, r.H - 52, '#20404c', 1);\\n        if (self.printed) text(g, self.printed.slice(0, 42), 8, r.H - 40, '#5f7f8a', 1);\\n        text(g, clip ? 'up clip   side scrub   confirm prints' : '', 8, r.H - 28, '#5f7f8a', 1);\\n      } else if (self.jumpMode) {\\n        const rows = [\\n          'Day ' + self.jumpDay,\\n          'Scene ' + self.jumpScenes[self.jumpSceneI],\\n          'Activity ' + (self.jumpActs[self.jumpActI] || '(scene)'),\\n          'Tier ' + self.jumpTier\\n        ];\\n350→        rows.forEach(function (line, n) {\\n          text(g, (n === self.jumpRow ? '> ' : '  ') + line, 8, r.H - 78 + n * 11, n === self.jumpRow ? '#14a8c8' : '#20404c', 1);\\n        });\\n      } else text(g, 'reset: retry', 8, r.H - 28, '#5f7f8a', 1);\\n      text(g, TOOLS[self.tool] || '', 8, r.H - 16, '#14a8c8', 1);\\n    });\\n  };\\n  G.starsOf = function (pct, gates) {\\n    gates = gates || [.35, .65, .90];\\n    const g0 = G.dev && G.dev.on ? G.dev.v.star1 : gates[0];\\n360→    const g1 = G.dev && G.dev.on ? G.dev.v.star2 : gates[1];\\n    const g2 = G.dev && G.dev.on ? G.dev.v.star3 : gates[2];\\n    const use = G.dev && G.dev.on ? [g0, g1, g2] : gates;\\n    let n = 0;\\n    if (pct >= use[0]) n = 1;\\n    if (pct >= use[1]) n = 2;\\n    if (pct >= use[2]) n = 3;\\n    return n;\\n  };\\n})();\\n\",\"content_concise\":\"140→        const t = trail[i];\\n        E.px.disc(g, cx + t.x * rad, cy - t.y * rad, 1, 'rgba(44,198,230,' + (i / trail.length) + ')');\\n      }\\n      const px = cx + bal.px * rad, py = cy - bal.py * rad;\\n      E.px.disc(g, px, py, 3, '#ff7a59');\\n      E.px.disc(g, px, py, 1.4, '#ffffff');\\n      if (o.trace && G.dev && G.dev.panel) text(g, bal.px.toFixed(2) + ',' + bal.py.toFixed(2), cx - 20, cy + rad + 2, '#20404c', 1);\\n    });\\n  };\\n  G.drawStars = function (g, x, y, n) {\\n150→    for (let i = 0; i < 3; i++) text(g, i < n ? '★' : '·', x + i * 12, y, i < n ? '#14a8c8' : '#5f7f8a', 2);\\n  };\\n  G.DEV_DEFAULTS = {\\n    k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, reach: .33, nudge: 2.2,\\n    star1: .35, star2: .65, star3: .90, repTol: .08, rhythm: 1, fatigue: 1.5,\\n    hoopLo: 7, hoopHi: 11, jogLo: 2.6, jogHi: 3.4, jogSpeed: 1,\\n    skiSpeed: 220, skiTurn: 1.6, trayG: 420, trayFric: 3, ropeS: 16, gust: 9,\\n    timeScale: 1, minutesMul: 1\\n  };\\n  const DEV_HELP = {\\n160→    k: 'spring', c: 'damping', s: 'instability', A: 'noise', nf: 'noise rate', ring: 'ring scale', push: 'push', stumble: 'stumble at',\\n    reach: 'mouse reach', nudge: 'nudge rate', star1: '1 star', star2: '2 stars', star3: '3 stars', repTol: 'rep tolerance',\\n    rhythm: 'window scale', fatigue: 'fatigue', hoopLo: 'hoop low', hoopHi: 'hoop high', jogLo: 'jog low', jogHi: 'jog high',\\n    jogSpeed: 'jog speed', skiSpeed: 'ski speed', skiTurn: 'ski turn', trayG: 'tray gravity', trayFric: 'tray friction',\\n    ropeS: 'rope instability', gust: 'gust', timeScale: 'time scale', minutesMul: 'minutes'\\n  };\\n  function copyDev(src) { const o = {}; for (const k in src) o[k] = src[k]; return o; }\\n  G.dev = {\\n    on: false, panel: false, v: copyDev(G.DEV_DEFAULTS), i: 0, keys: Object.keys(G.DEV_DEFAULTS),\\n    tool: 0, pose: 'stork', poseI: 0, poseT: 0, poseMode: false, printed: '', frame: false, bot: null, trace: false, noStumble: false,\\n170→    open() {\\n      this.panel = true; this.on = true;\\n      if (G.game) { G.game.live = true; if (G.game.paused) G.game.resume(); }\\n    },\\n    close() { this.panel = false; this.on = false; if (G.game && !G.inSession) G.game.live = false; },\\n    adjust(key, delta) {\\n      if (!(key in this.v)) return;\\n      const d = G.DEV_DEFAULTS[key];\\n      const step = Math.abs(d) > 20 ? Math.abs(d) * 0.05 : Math.abs(d) > 2 ? 0.1 : d > 0.2 ? 0.05 : 0.01;\\n      this.v[key] = Math.round((this.v[key] + delta * (step || 0.05)) * 1000) / 1000;\\n180→      if (key === 'timeScale' && G.game) G.game.timeScale = this.v.timeScale;\\n    },\\n    reset() {\\n      this.v = copyDev(G.DEV_DEFAULTS);\\n      if (G.game) G.game.timeScale = 1;\\n    },\\n    jump(o) {\\n      o = o || {};\\n      if (!G.game) return;\\n      if (o.day) { G.profile.day = o.day; G.profile.sessions = 0; }\\n190→      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null, skipToPlay: true }, { fade: 0 });\\n      else if (o.scene) G.game.go(o.scene, o.data || {}, { fade: 0 });\\n    },\\n    jumpMode: false, jumpRow: 0, jumpDay: 1, jumpSceneI: 0, jumpActI: 0, jumpTier: 1,\\n    jumpScenes: ['bungalow', 'island', 'title', 'plate', 'bed', 'ending'],\\n    jumpActs: ['', 'stork', 'candle', 'squat', 'step', 'hoop', 'sun', 'push', 'lunge', 'jog', 'slalom', 'tray', 'laundry']\\n  };\\n  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot', 'Jump'];\\n  G.dev.tools = TOOLS;\\n  G.dev.clipNames = function () {\\n200→    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n210→    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 10