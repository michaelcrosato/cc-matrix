oNext = !!opts.autoNext;\\n    this.fam = null;\\n    this.line = (G.LINES.tare[this.seed % G.LINES.tare.length]) || '';\\n    G.subtitle = '';\\n  }\\n\\n  Session.prototype.update = function (dt) {\\n    if (G.driver && G.driver !== 'human') {\\n      this.driver = G.driver;\\n      if (this.seats[0] && this.seats[0].local) this.seats[0].skill = G.driver;\\n    }\\n    if (this.phase === 'card') {\\n      G.phase = 'menu'; G.left = 0;\\n      return;\\n    }\\n    if (this.phase === 'demo') {\\n      this.demoT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.demoT);\\n      if (this.demoT <= 0) { this.phase = 'count'; this.countT = 3; }\\n      return;\\n    }\\n    if (this.phase === 'count') {\\n      this.countT -= dt;\\n      G.phase = 'auto'; G.left = Math.max(0, this.countT);\\n      if (this.countT <= 0) { this.phase = 'play'; this.playTime = 0; this.ended = false; beginFamily(this); }\\n      return;\\n    }\\n    if (this.phase === 'play') {\\n      G.phase = 'play';\\n      this.playTime += dt;\\n      stepFamily(this, dt);\\n      G.left = Math.max(0, this.limit - this.playTime);\\n      const timed = this.act.family !== 'rep' && this.act.family !== 'slalom' && this.act.family !== 'laundry' && this.act.family !== 'tray' && this.act.family !== 'step';\\n      if (this.ended || this.playTime >= this.limit || (timed && this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'step' && this.fam && this.fam.rh && this.fam.rh.done) this.finish();\\n      if (this.act.family === 'rep' && this.ended) this.finish();\\n      if (this.act.family === 'slalom' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'laundry' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'tray' && (this.ended || this.playTime >= this.limit)) this.finish();\\n      if (this.act.family === 'candle' && this.fam && this.fam.dead) this.finish();\\n      return;\\n    }\\n    if (this.phase === 'results') { G.phase = 'menu'; G.left = 0; }\\n  };\\n\\n  Session.prototype.finish = function () {\\n    if (this.phase === 'results') return;\\n    scoreNow(this);\\n    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\\n    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\\n    this.pct = clamp(this.pct || 0, 0, 1);\\n    this.stars = G.starsOf(this.pct, this.act.stars);\\n    this.phase = 'results';\\n    G.phase = 'menu'; G.left = 0;\\n    this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\\n    if (this.classMode) {\\n      this.seats.forEach(function (q) {\\n        const sk = skillName(q);\\n        let p = this.pct;\\n        if (!q.local && q.botFill) p = this.pct;\\n        if (q.human && !q.local) p = q.moved ? this.pct : 0;\\n        q.pct = p; q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\\n      }, this);\\n    }\\n    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\\n    try {\\n      const n = this.stars;\\n      G.sting(n >= 3 ? 'star3' : n === 2 ? 'star2' : n === 1 ? 'star1' : null);\\n    } catch (e) { /* quiet */ }\\n  };\\n\\n  Session.prototype.begin = function () { if (this.phase === 'card') { this.phase = 'demo'; this.demoT = 3; } };\\n  Session.prototype.again = function () {\\n    const id = this.act.id, tier = this.tier, trial = this.trial, driver = this.driver, limit = this.limit, seats = this.seats, classMode = this.classMode, seed = (this.seed + 1) >>> 0;\\n    const next = new Session({ id: id, tier: tier, trial: trial, driver: driver, limit: limit, seats: seats, classMode: classMode, seed: seed, skipToPlay: false, cheat: this.cheat });\\n    G.session = next;\\n  };\\n\\n  G.Session = Session;\\n  G.skillName = skillName;\\n\\n  G.drawActivity = function (r, sess) {\\n    if (!r || !sess) return;\\n    const fam = sess.fam;\\n    G.paintRoom(r, sess.act && sess.act.id === 'slalom' ? 'dusk' : 'day');\\n    if (sess.phase === 'play' || sess.phase === 'results' || sess.phase === 'demo' || sess.phase === 'count') {\\n      try {\\n        if (!sess._rig && G.makeRig) {\\n          const look = G.lookColors ? G.lookColors(G.profile) : null;\\n          sess._rig = G.makeRig(G.playerOpts(look, 2.1));\\n        }\\n        if (sess._rig && (sess.phase === 'play' || sess.phase === 'demo')) {\\n          const pose = sess.act.family === 'sun' ? G.SUN_POSES[(fam && fam.poseI) || 0] : sess.act.pose;\\n          if (sess.phase === 'demo') G.poseRig(sess._rig, pose || 'idle', sess.demoT, [0, 0]);\\n          else if (fam && sess.seats[0].bal) {\\n            const b = sess.seats[0].bal;\\n            sess._rig.wob = [b.py, b.px];\\n            if (sess.act.family === 'lunge' || sess.act.id === 'lunge') sess._rig.body = G.sideLunge(b.px);\\n            else if (sess.act.id === 'hoop') sess._rig.body = G.hula(fam.ang || 0);\\n            else G.poseRig(sess._rig, pose || 'idle', fam.t, [b.py, b.px]);\\n          }\\n          G.stepRig(sess._rig, DT, 0, 0);\\n          r.actor(0, 8, 0, function (g, ox, oy) { sess._rig.draw(g, ox, oy, r.view); G.drawJoints(g, sess._rig, ox, oy); });\\n        }\\n      } catch (e) { /* a painted room still reads */ }\\n    }\\n    r.overlay(function (g) {\\n      const W = r.W, H = r.H;\\n      if (sess.phase === 'card') {\\n        G.text(g, sess.act.name, W / 2, 28, '#20404c', 2, 'center');\\n        G.text(g, sess.act.blurb, 16, 52, '#20404c', 1, 'left');\\n        const gates = sess.act.stars;\\n        G.text(g, 'Stars  ' + gates[0] + '   ' + gates[1] + '   ' + gates[2], 16, 78, '#5f7f8a', 1);\\n        const best = G.bestText ? G.bestText(sess.act.id, sess.tier) : '';\\n        if (best) G.text(g, best, 16, 94, '#14a8c8', 1);\\n        G.text(g, 'Tier ' + sess.tier, W - 70, 28, '#14a8c8', 1);\\n      } else if (sess.phase === 'demo') {\\n        G.text(g, sess.line, 16, 36, '#20404c', 1);\\n        G.text(g, 'Watch', W / 2, H / 2 - 20, '#14a8c8', 2, 'center');\\n      } else if (sess.phase === 'count') {\\n        const n = Math.max(1, Math.ceil(sess.countT));\\n        E.font.title(g, String(n), W / 2, H / 2 - 20, { scale: 4, align: 'center', colors: ['#ffffff', '#8fd3f4', '#14a8c8'] });\\n        G.text(g, 'Breathe in', W / 2, H / 2 + 18, '#20404c', 1, 'center');\\n      } else if (sess.phase === 'results') {\\n        G.text(g, sess.act.name, W / 2, 24, '#20404c', 2, 'center');\\n        G.drawStars(g, W / 2 - 18, 48, sess.stars);\\n        G.text(g, Math.round(sess.pct * 100) + '%', W / 2, 70, '#20404c', 2, 'center');\\n        const remark = (G.LINES.stars[sess.stars] || G.LINES.stars[0])[0];\\n        G.text(g, remark, 12, 96, '#20404c', 1);\\n      } else if (fam) {\\n        G.text(g, sess.act.name, 8, 6, '#20404c', 1);\\n        G.text(g, Math.ceil(Math.max(0, sess.limit - sess.playTime)) + 's', W - 36, 6, '#5f7f8a', 1);\\n        if (sess.act.family === 'hoop') {\\n          const label = Math.abs(fam.omega) < 7 ? 'Too slow' : Math.abs(fam.omega) > 11 ? 'Too eager' : 'Just right';\\n          G.text(g, label, W / 2, 24, '#14a8c8', 1, 'center');\\n          if (fam.otherWay) G.text(g, 'Other way!', W / 2, 40, '#e0553a', 1, 'center');\\n        }\\n        if (sess.act.family === 'jog') G.text(g, 'Cadence ' + fam.cad.toFixed(1), 8, 20, '#20404c', 1);\\n        if (sess.act.family === 'candle') G.text(g, 'Flame ' + Math.round(fam.flame * 100), 8, 20, '#e0553a', 1);\\n        if (sess.act.family === 'slalom') G.text(g, 'Time ' + (fam.t + fam.pen).toFixed(1), 8, 20, '#20404c', 1);\\n        if (G.subtitle) G.text(g, G.subtitle, 8, H - 52, '#20404c', 1);\\n      }\\n    });\\n    if (sess.phase === 'play' && sess.seats[0].bal) {\\n      const hide = sess.act.id === 'stork' && sess.tier >= 2;\\n      G.drawPlate(r, sess.seats[0].bal, { hide: hide, c: fam && fam.c, trace: G.dev && G.dev.trace });\\n    }\\n    if (sess.phase === 'play' && fam && fam.rh && fam.rh.draw) {\\n      try { fam.rh.draw(r, { arrows: true, y: r.H - 78, len: 90 }); } catch (e) { /* highway can sit this one out */ }\\n    }\\n    if (sess.phase === 'play') G.prompt(null, r, 'lean', '');\\n  };\\n})();\\n\",\"total_lines\":753}}","is_error":false},{"type":"tool_result","tool_use_id":"call-077b6a45-2813-4495-b66c-2946ca903fc5-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"140→        const t = trail[i];\\n        E.px.disc(g, cx + t.x * rad, cy - t.y * rad, 1, 'rgba(44,198,230,' + (i / trail.length) + ')');\\n      }\\n      const px = cx + bal.px * rad, py = cy - bal.py * rad;\\n      E.px.disc(g, px, py, 3, '#ff7a59');\\n      E.px.disc(g, px, py, 1.4, '#ffffff');\\n      if (o.trace && G.dev && G.dev.panel) text(g, bal.px.toFixed(2) + ',' + bal.py.toFixed(2), cx - 20, cy + rad + 2, '#20404c', 1);\\n    });\\n  };\\n  G.drawStars = function (g, x, y, n) {\\n150→    for (let i = 0; i < 3; i++) text(g, i < n ? '★' : '·', x + i * 12, y, i < n ? '#14a8c8' : '#5f7f8a', 2);\\n  };\\n  G.DEV_DEFAULTS = {\\n    k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, reach: .33, nudge: 2.2,\\n    star1: .35, star2: .65, star3: .90, repTol: .08, rhythm: 1, fatigue: 1.5,\\n    hoopLo: 7, hoopHi: 11, jogLo: 2.6, jogHi: 3.4, jogSpeed: 1,\\n    skiSpeed: 220, skiTurn: 1.6, trayG: 420, trayFric: 3, ropeS: 16, gust: 9,\\n    timeScale: 1, minutesMul: 1\\n  };\\n  const DEV_HELP = {\\n160→    k: 'spring', c: 'damping', s: 'instability', A: 'noise', nf: 'noise rate', ring: 'ring scale', push: 'push', stumble: 'stumble at',\\n    reach: 'mouse reach', nudge: 'nudge rate', star1: '1 star', star2: '2 stars', star3: '3 stars', repTol: 'rep tolerance',\\n    rhythm: 'window scale', fatigue: 'fatigue', hoopLo: 'hoop low', hoopHi: 'hoop high', jogLo: 'jog low', jogHi: 'jog high',\\n    jogSpeed: 'jog speed', skiSpeed: 'ski speed', skiTurn: 'ski turn', trayG: 'tray gravity', trayFric: 'tray friction',\\n    ropeS: 'rope instability', gust: 'gust', timeScale: 'time scale', minutesMul: 'minutes'\\n  };\\n  function copyDev(src) { const o = {}; for (const k in src) o[k] = src[k]; return o; }\\n  G.dev = {\\n    on: false, panel: false, v: copyDev(G.DEV_DEFAULTS), i: 0, keys: Object.keys(G.DEV_DEFAULTS),\\n    tool: 0, pose: 'stork', poseI: 0, poseT: 0, poseMode: false, printed: '', frame: false, bot: null, trace: false, noStumble: false,\\n170→    open() {\\n      this.panel = true; this.on = true;\\n      if (G.game) { G.game.live = true; if (G.game.paused) G.game.resume(); }\\n    },\\n    close() { this.panel = false; this.on = false; if (G.game && !G.inSession) G.game.live = false; },\\n    adjust(key, delta) {\\n      if (!(key in this.v)) return;\\n      const d = G.DEV_DEFAULTS[key];\\n      const step = Math.abs(d) > 20 ? Math.abs(d) * 0.05 : Math.abs(d) > 2 ? 0.1 : d > 0.2 ? 0.05 : 0.01;\\n      this.v[key] = Math.round((this.v[key] + delta * (step || 0.05)) * 1000) / 1000;\\n180→      if (key === 'timeScale' && G.game) G.game.timeScale = this.v.timeScale;\\n    },\\n    reset() {\\n      this.v = copyDev(G.DEV_DEFAULTS);\\n      if (G.game) G.game.timeScale = 1;\\n    },\\n    jump(o) {\\n      o = o || {};\\n      if (!G.game) return;\\n      if (o.day) { G.profile.day = o.day; G.profile.sessions = 0; }\\n190→      if (o.activity) G.game.go('play', { id: o.activity, tier: o.tier || 1, trial: true, driver: o.driver || null }, { fade: 0 });\\n      else if (o.scene) G.game.go(o.scene, o.data || {}, { fade: 0 });\\n    }\\n  };\\n  const TOOLS = ['Finish 3 stars', 'Finish 1 star', 'Unlock all', '+10 minutes', 'Spine Age 40', 'Reset member', 'Bot: good', 'Bot: off', 'Trace', 'Frame step', 'Force attract', 'Pose viewer', 'Log snapshot'];\\n  G.dev.clipNames = function () {\\n    const lib = G.lib && G.lib();\\n    if (lib && lib.names && lib.names.length) return lib.names;\\n    return Object.keys(G.POSES || {});\\n  };\\n200→  G.dev.currentClip = function () {\\n    const names = this.clipNames();\\n    if (!names.length) return null;\\n    if (this.poseI < 0 || this.poseI >= names.length) this.poseI = 0;\\n    const lib = G.lib && G.lib();\\n    const clip = lib && lib.clip(names[this.poseI]);\\n    return clip || { name: names[this.poseI], dur: 2 };\\n  };\\n  G.dev.printPose = function () {\\n    const names = this.clipNames();\\n210→    const clip = this.currentClip();\\n    if (!clip || !names.length) return '';\\n    const name = names[this.poseI] || clip.name || 'pose';\\n    const t = Math.round((this.poseT || 0) * 100) / 100;\\n    const dur = clip.dur || t;\\n    const b = Math.round(Math.min(dur, t + 0.8) * 100) / 100;\\n    const key = String(name).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'pose';\\n    const row = key + \\\": { clip: '\\\" + name + \\\"', a: \\\" + t.toFixed(2) + \\\", b: \\\" + Math.max(b, t).toFixed(2) + \\\", tgt: 1.57 },\\\";\\n    this.printed = row;\\n    try { console.log(row); } catch (e) { /* the row is also on the panel */ }\\n220→    return row;\\n  };\\n  G.dev.update = function (input, dt) {\\n    if (!this.panel) return;\\n    const keys = this.keys;\\n    if (input.pressed('cancel')) {\\n      if (this.poseMode) { this.poseMode = false; return; }\\n      this.close();\\n      return;\\n    }\\n230→    if (this.poseMode) {\\n      const names = this.clipNames();\\n      const n = names.length || 1;\\n      if (input.pressed('up')) { this.poseI = (this.poseI + n - 1) % n; this.poseT = 0; }\\n      if (input.pressed('down')) { this.poseI = (this.poseI + 1) % n; this.poseT = 0; }\\n      const dur = (this.currentClip() && this.currentClip().dur) || 2;\\n      if (input.pressed('left') || input.repeat('left')) this.poseT = Math.max(0, this.poseT - 0.05);\\n      if (input.pressed('right') || input.repeat('right')) this.poseT = Math.min(dur, this.poseT + 0.05);\\n      if (input.pressed('confirm')) this.printPose();\\n      void dt;\\n240→      return;\\n    }\\n    const up = input.held.has('ArrowUp') || input.held.has('Pad12');\\n    const down = input.held.has('ArrowDown') || input.held.has('Pad13');\\n    const left = input.held.has('ArrowLeft') || input.held.has('Pad14');\\n    const right = input.held.has('ArrowRight') || input.held.has('Pad15');\\n    if (input.repeat && (input.pressed('up') && (input.held.has('ArrowUp') || input.lastDevice === 'gamepad'))) this.i = (this.i + keys.length - 1) % keys.length;\\n    if (up && input.pressed('up')) this.i = (this.i + keys.length - 1) % keys.length;\\n    if (down && input.pressed('down')) this.i = (this.i + 1) % keys.length;\\n    const k = keys[this.i];\\n250→    if ((left && (input.pressed('left') || input.repeat('left'))) ) this.adjust(k, -1);\\n    if ((right && (input.pressed('right') || input.repeat('right')))) this.adjust(k, 1);\\n    if (input.pressed('retry')) this.reset();\\n    if (input.pressed('confirm') && input.lastDevice !== 'keyboard') this.toolAct(this.tool);\\n    void dt;\\n  };\\n  G.dev.toolAct = function (i) {\\n    const p = G.profile;\\n    if (i === 0 && G.finishNow) G.finishNow(3);\\n    else if (i === 1 && G.finishNow) G.finishNow(1);\\n260→    else if (i === 2 && G.grantAll) G.grantAll();\\n    else if (i === 3 && p) { p.minutes += 10; if (G.refreshUnlocks) G.refreshUnlocks(); }\\n    else if (i === 4 && p) { p.spine = 40; p.forceAge = 40; }\\n    else if (i === 5 && G.freshProfile) { G.profile = G.freshProfile(); }\\n    else if (i === 6) this.bot = 'good';\\n    else if (i === 7) this.bot = null;\\n    else if (i === 8) this.trace = !this.trace;\\n    else if (i === 9) { this.frame = !this.frame; if (G.game) G.game.timeScale = this.frame ? 0 : this.v.timeScale; }\\n    else if (i === 10 && G.startAttract) G.startAttract();\\n    else if (i === 11) { this.poseMode = !this.poseMode; if (this.poseMode) { this.poseT = 0; this.printed = ''; } }\\n270→    else if (i === 12 && G.game && G.game.debug) { try { console.log(JSON.stringify(G.game.debug.snapshot())); } catch (e) { /* keep playing */ } }\\n  };\\n  G.dev.drawPose = function (r) {\\n    const lib = G.lib && G.lib();\\n    const clip = this.currentClip();\\n    if (!lib || !clip || !G.makeRig || !r.actor) return;\\n    if (!this._rig) this._rig = G.makeRig(G.playerOpts(null, 2.1));\\n    const rig = this._rig;\\n    try {\\n      rig.mocap = lib.sample(clip, this.poseT || 0);\\n280→      rig.wob = [0, 0];\\n      rig.body = null;\\n      rig._tgt = 1.57;\\n      G.stepRig(rig, 1 / 60, 0, 0);\\n      r.actor(8, 6, 0, function (g, ox, oy) { rig.draw(g, ox, oy, r.view); });\\n    } catch (e) { /* the name and the row still show */ }\\n  };\\n  G.dev.draw = function (r) {\\n    if (!this.panel || !r) return;\\n    if (this.poseMode) this.drawPose(r);\\n290→    const self = this;\\n    r.overlay(function (g) {\\n      const w = Math.round(r.W * .33);\\n      E.px.rect(g, 0, 0, w, r.H, 'rgba(247,251,251,.92)');\\n      text(g, 'DEV', 8, 6, '#14a8c8', 1);\\n      const start = Math.max(0, self.i - 8);\\n      for (let n = 0; n < 12 && start + n < self.keys.length; n++) {\\n        const k = self.keys[start + n];\\n        const on = start + n === self.i;\\n        const y = 18 + n * 12;\\n300→        if (on) E.px.rect(g, 4, y - 1, w - 8, 11, '#bfeee0');\\n        const def = G.DEV_DEFAULTS[k];\\n        text(g, (DEV_HELP[k] || k) + ' ' + self.v[k], 8, y, '#20404c', 1);\\n        if (self.v[k] !== def) text(g, 'd' + def, w - 36, y, '#5f7f8a', 1);\\n      }\\n      if (self.poseMode) {\\n        const names = self.clipNames();\\n        const clip = self.currentClip();\\n        text(g, (names[self.poseI] || '') + '  ' + (self.poseT || 0).toFixed(2), 8, r.H - 52, '#20404c', 1);\\n        if (self.printed) text(g, self.printed.slice(0, 42), 8, r.H - 40, '#5f7f8a', 1);\\n310→        text(g, clip ? 'up clip   side scrub   confirm prints' : '', 8, r.H - 28, '#5f7f8a', 1);\\n      } else text(g, 'reset: retry', 8, r.H - 28, '#5f7f8a', 1);\\n      text(g, TOOLS[self.tool] || '', 8, r.H - 16, '#14a8c8', 1);\\n    });\\n  };\\n  G.starsOf = function (pct, gates) {\\n    gates = gates || [.35, .65, .90];\\n    const g0 = G.dev && G.dev.on ? G.dev.v.star1 : gates[0];\\n    const g1 = G.dev && G.dev.on ? G.dev.v.star2 : gates[1];\\n    const g2 = G.dev && G.dev.on ? G.dev.v.star3 : gates[2];\\n320→    const use = G.dev && G.dev.on ? [g0, g1, g2] : gates;\\n    let n = 0;\\n    if (pct >= use[0]) n = 1;\\n    if (pct >= use[1]) n = 2;\\n    if (pct >= use[2]) n = 3;\\n    return n;\\n  };\\n})();\\n\",\"content_concise\":\"140→        const t = trail[i];\\n        E.px.disc(g, cx + t.x * rad, cy - t.y * rad, 1, 'rgba(44,198,230,' + (i / trail.length) + ')');\\n      }\\n      const px = cx + bal.px * rad, py = cy - bal.py * rad;\\n      E.px.disc(g, px, py, 3, '#ff7a59');\\n      E.px.disc(g, px, py, 1.4, '#ffffff');\\n      if (o.trace && G.dev && G.dev.panel) text(g, bal.px.toFixed(2) + ',' + bal.py.toFixed(2), cx - 20, cy + rad + 2, '#20404c', 1);\\n    });\\n  };\\n  G.drawStars = function (g, x, y, n) {\\n150→    for (let i = 0; i < 3; i++) text(g, i < n ? '★' : '·', x + i * 12, y, i < n ? '#14a8c8' : '#5f7f8a', 2);\\n  };\\n  G.DEV_DEFAULTS = {\\n    k: 1, c: 1, s: 1, A: 1, nf: 1, ring: 1, push: 1, stumble: 1, reach: .33, nudge: 2.2,\\n    star1: .35, star2: .65, star3: .90, repTol: .08, rhythm: 1, fatigue: 1.5,\\n    hoopLo: 7, hoopHi: 11, jogLo: 2.6, jogHi: 3.4, jogSpeed: 1,\\n    skiSpeed: 220, skiTurn: 1.6, trayG: 420, trayFric: 3, ropeS: 16, gust: 9,\\n    timeScale: 1, minutesMul: 1\\n  };\\n  const DEV_HELP = {\\n160→    k: 'spring', c: 'damping', s: 'instability', A: 'noise', nf: 'noise rate', ring: 'ring scale', push: 'push', stumble: 'stumble at',\\n    reach: 'mouse reach', nudge: 'nudge rate', star1: '1 star', star2: '2 stars', star3: '3 stars', repTol: 'rep tolerance',\\n    rhythm: 'window scale', fatigue: 'fatigue', hoopLo: 'hoop low', hoopHi: 'hoop high', jogLo: 'jog low', jogHi: 'jog high',\\n    jogSp