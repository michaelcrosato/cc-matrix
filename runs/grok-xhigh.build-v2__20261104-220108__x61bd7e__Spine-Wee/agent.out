{"type":"assistant","message":{"id":"msg_563","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The test log shows only 17 passed tests and zero failures. That count seems suspiciously low for a suite with hundreds of assertions.\n\nThe 17 passed tests likely represent test functions rather than individual assertions. PLAN.md expects 213 passed tests, so the test file needs closer inspection. Launch-2 lacks the \"heard\" audio check found in launch-1, yet both show identical titles, canvas size, music level, glyphs, and navigation behavior. The 32160-pixel diff is being evaluated against the 2,073,600 total pixels of a 1920x1080 canvas to determine if it reflects meaningful visual changes.\n\nThe 32160-pixel difference equals roughly 1.5% of the canvas area. That is far below the threshold for a substantially painted surface, which should cover most of the screen. The diff likely reflects only minor noise rather than meaningful visual changes.","signature":""},{"type":"tool_use","id":"call-34adb1e6-775c-405b-84db-aaadc06437ae-16","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs","offset":1,"limit":550}},{"type":"tool_use","id":"call-34adb1e6-775c-405b-84db-aaadc06437ae-17","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/tmp/grok-goal-0c0bba67d95a/implementer/title-1920x1080.png"}},{"type":"tool_use","id":"call-34adb1e6-775c-405b-84db-aaadc06437ae-18","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/tmp/grok-goal-0c0bba67d95a/implementer/gates.txt","limit":100}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4100,"output_tokens":734,"cache_read_input_tokens":48384,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"24bb2fa1-499d-4ef5-8ab7-7bd32c8fbe2c"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-34adb1e6-775c-405b-84db-aaadc06437ae-16","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/* One command: node tests/run.mjs [rules|browser|hub|all]\\n * Prints failures and a count line. Drives the shipped scripts. */\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\nimport vm from 'node:vm';\\nimport { fileURLToPath } from 'node:url';\\n\\nconst here = path.dirname(fileURLToPath(import.meta.url));\\n10→const dev = path.resolve(here, '..');\\nconst work = path.resolve(dev, '..');\\nconst SCRATCH = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/tmp/grok-goal-0c0bba67d95a/implementer';\\nconst TITLE = 'Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108';\\nconst HTML = path.join(work, TITLE + '.html');\\n\\nconst FILES = [\\n  'vendor/session.js',\\n  'engine/my-3d2dge.js',\\n  'vendor/readable.js',\\n20→  'vendor/mocap.js',\\n  'vendor/fitclips.js',\\n  'game/data/lines.js',\\n  'game/data/content.js',\\n  'game/balance.js',\\n  'game/audio.js',\\n  'game/rigs.js',\\n  'game/ui.js',\\n  'game/play.js',\\n  'game/world.js',\\n30→  'game/boot.js'\\n];\\n\\nconst vmErrors = [];\\nconst ctx = {\\n  console: {\\n    log() {}, info() {}, warn() {}, debug() {},\\n    error(...a) { vmErrors.push(a.map(String).join(' ')); }\\n  },\\n  addEventListener() {}, removeEventListener() {},\\n40→  setTimeout, clearTimeout, setInterval, clearInterval,\\n  location: { hash: '', search: '', pathname: '/index.html', href: 'file:///index.html' },\\n  navigator: { userAgent: 'node', maxTouchPoints: 0, getGamepads() { return []; } },\\n  performance: { now: () => Date.now() },\\n  requestAnimationFrame() { return 0; },\\n  cancelAnimationFrame() {},\\n  devicePixelRatio: 1,\\n  HTMLElement: function HTMLElement() {},\\n  Element: function Element() {}\\n};\\n50→ctx.window = ctx;\\nctx.globalThis = ctx;\\nctx.self = ctx;\\nctx.parent = ctx;\\nctx.top = ctx;\\nvm.createContext(ctx);\\nfor (const f of FILES) vm.runInContext(fs.readFileSync(path.join(dev, f), 'utf8'), ctx, { filename: f });\\nconst G = ctx.G;\\nconst E = ctx.My3D2dge;\\nconst realAIHub = ctx.AIHub;\\n60→\\nfunction boot(opts) {\\n  vmErrors.length = 0;\\n  return G.boot(Object.assign({ headless: true }, opts || {}));\\n}\\nfunction snap(game) {\\n  return game.debug.snapshot();\\n}\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg);\\n70→}\\n\\nfunction pumpStory(game, driver) {\\n  G.setDriver(driver);\\n  const trace = [];\\n  let age3 = null;\\n  let same = 0;\\n  let lastKey = '';\\n  const t0 = Date.now();\\n  for (let i = 0; i < 200000; i++) {\\n80→    if (Date.now() - t0 > 240000) throw new Error('playthrough timed out\\\\n' + trace.slice(-20).join('\\\\n'));\\n    if (game.errors && game.errors.length) throw new Error(game.errors.join(' | ') + '\\\\n' + trace.slice(-12).join('\\\\n'));\\n    const s = snap(game);\\n    const talkI = (G.talk && G.talk.open) ? G.talk.i : -1;\\n    const key = [s.scene, s.day, s.session, s.phase, s.activity, talkI, Math.round((s.left || 0) * 10)].join('|');\\n    const mark = s.scene + ' d' + s.day + ' ' + s.phase + ' ' + (s.activity || '') + (talkI >= 0 ? ' p' + talkI : '');\\n    if (trace[trace.length - 1] !== mark) trace.push(mark);\\n    if (s.day === 3 && s.plateau) {\\n      if (age3 == null) age3 = s.spineAge;\\n      else if (s.spineAge !== age3) throw new Error('day 3 Spine Age moved from ' + age3 + ' to ' + s.spineAge);\\n90→    }\\n    if (s.freePlay && s.scene === 'ending') {\\n      game.advance(1 / 120);\\n      break;\\n    }\\n    if (s.scene === 'free') break;\\n    if (key === lastKey) same++;\\n    else { same = 0; lastKey = key; }\\n    if (same > 40) throw new Error('stuck ' + key + '\\\\n' + trace.slice(-24).join('\\\\n'));\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n100→      G.setDriver(driver);\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n  }\\n  const end = snap(game);\\n  return { end, age3, trace, profile: G.profile };\\n110→}\\n\\nfunction runActivity(id, tier, skill) {\\n  const game = boot();\\n  G.setDriver(skill);\\n  game.go('play', { id: id, tier: tier, trial: true, driver: skill, skipToPlay: true, seed: 4 }, { fade: 0 });\\n  let eyes = false;\\n  for (let i = 0; i < 40000; i++) {\\n    const s = snap(game);\\n    if (G.session && G.session.fam && G.session.fam.eyes) eyes = true;\\n120→    if (s.scene === 'play' && s.phase === 'menu' && s.activity === id && i > 2) {\\n      return { pct: s.pct, stars: s.stars, eyes: eyes, errors: game.errors.slice() };\\n    }\\n    if (game.errors.length) return { pct: s.pct, stars: s.stars, eyes: eyes, errors: game.errors.slice() };\\n    G.setDriver(skill);\\n    const dt = Math.max(1 / 120, Math.min(0.5, s.left > 0 ? s.left : 0.25));\\n    game.advance(dt);\\n  }\\n  return { pct: 0, stars: 0, eyes: eyes, errors: ['timed out ' + id + ' t' + tier + ' ' + skill] };\\n}\\n130→\\nconst tests = [];\\nfunction add(group, name, fn) { tests.push({ group, name, fn }); }\\n\\nadd('rules', 'boot smoke', () => {\\n  const game = boot();\\n  const s = snap(game);\\n  assert(s.scene === 'title', 'scene ' + s.scene);\\n  assert(s.title === 'Spine Wee', s.title);\\n  assert(game.settings.music === 0.1, 'music ' + game.settings.music);\\n140→  assert(game.settings.glyphs === 'playstation', 'glyphs ' + game.settings.glyphs);\\n  assert(!game.errors.length, game.errors.join(' | '));\\n  game.advance(0.2);\\n  assert(snap(game).scene === 'title', 'left title');\\n});\\n\\nadd('rules', 'section 3 bands', () => {\\n  const names = ['body', 'sun', 'stork1', 'stork2', 'candle', 'laundry'];\\n  const skills = ['passive', 'poor', 'average', 'good'];\\n  const acc = {};\\n150→  for (const name of names) for (const skill of skills) acc[name + ' ' + skill] = [];\\n  for (let s = 1; s <= 12; s++) {\\n    for (const name of names) {\\n      const seed = (s * 997 + name.charCodeAt(0) * 13) >>> 0;\\n      for (const skill of skills) {\\n        const r = G.bandTrial(name, skill, seed);\\n        acc[name + ' ' + skill].push(r.pct);\\n      }\\n    }\\n  }\\n160→  const bad = [];\\n  for (const key in acc) {\\n    const name = key.split(' ')[0];\\n    const skill = key.split(' ')[1];\\n    const mean = acc[key].reduce(function (a, b) { return a + b; }, 0) / acc[key].length;\\n    const expect = G.SETS[name].band[skill];\\n    if (Math.abs(mean - expect) > 10) bad.push(key + ' mean ' + mean.toFixed(1) + ' vs ' + expect);\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n170→\\nadd('rules', 'device lean', () => {\\n  const padGame = boot();\\n  const stopPad = padGame.hook('input', function () {\\n    const p = padGame.input.padMove;\\n    p[0] = 0.8;\\n    p[1] = -0.2;\\n  });\\n  padGame.advance(1 / 120);\\n  assert(G.lean.source === 'pad', 'pad source ' + G.lean.source);\\n180→  assert(G.lean.ux > 0.5, 'pad ux ' + G.lean.ux);\\n  stopPad();\\n\\n  const keyGame = boot();\\n  keyGame.input.hold('left', true);\\n  keyGame.advance(0.45);\\n  assert(G.lean.source === 'keys', 'key source ' + G.lean.source);\\n  assert(G.lean.ux < -0.4, 'key ux ' + G.lean.ux);\\n  keyGame.input.hold('left', false);\\n\\n190→  const mouseGame = boot();\\n  const W = mouseGame.screen.W, H = mouseGame.screen.H;\\n  const stopMouse = mouseGame.hook('input', function () {\\n    mouseGame.input.feed('move', W * 0.82, H * 0.5);\\n  });\\n  mouseGame.advance(1 / 120);\\n  assert(G.lean.source === 'mouse', 'mouse source ' + G.lean.source + ' ux ' + G.lean.ux);\\n  assert(G.lean.ux > 0.25, 'mouse ux ' + G.lean.ux);\\n  stopMouse();\\n});\\n200→\\nadd('rules', 'good playthrough', () => {\\n  const game = boot();\\n  const out = pumpStory(game, 'good');\\n  fs.writeFileSync(path.join(SCRATCH, 'play-good.json'), JSON.stringify({\\n    scene: out.end.scene, day: out.end.day, minutes: out.profile.minutes, age: out.end.spineAge,\\n    age3: out.age3, unlocks: out.profile.unlocks, played: out.profile.played, duel: out.profile.duelWon,\\n    free: out.profile.freePlay, trace: out.trace\\n  }, null, 2));\\n  assert(out.end.scene === 'free', 'ended in ' + out.end.scene + '\\\\n' + out.trace.slice(-12).join('\\\\n'));\\n210→  assert(out.profile.freePlay, 'free play flag');\\n  assert(out.age3 != null, 'never held day 3');\\n  assert(out.end.spineAge < 71, 'spine age ' + out.end.spineAge);\\n  const ids = Object.keys(G.ACTS);\\n  const played = ids.filter(function (id) { return out.profile.played[id]; });\\n  assert(played.length === ids.length, 'played ' + played.join(','));\\n  assert(out.profile.unlocks.indexOf('friend') >= 0, 'minutes ' + out.profile.minutes + ' unlocks ' + out.profile.unlocks.join(','));\\n});\\n\\nadd('rules', 'passive playthrough', () => {\\n220→  const game = boot();\\n  const out = pumpStory(game, 'passive');\\n  fs.writeFileSync(path.join(SCRATCH, 'play-passive.json'), JSON.stringify({\\n    scene: out.end.scene, minutes: out.profile.minutes, age3: out.age3, duel: out.profile.duelWon, trace: out.trace\\n  }, null, 2));\\n  assert(out.end.scene === 'free', 'ended in ' + out.end.scene + '\\\\n' + out.trace.slice(-12).join('\\\\n'));\\n  assert(out.age3 != null, 'never held day 3');\\n  assert(out.profile.ending, 'no ending flag');\\n});\\n\\n230→add('rules', 'star gates', () => {\\n  const bad = [];\\n  const rows = [];\\n  const ids = Object.keys(G.ACTS);\\n  for (const id of ids) {\\n    const gates = G.ACTS[id].stars;\\n    const cells = [\\n      [1, 'passive', 0],\\n      [1, 'average', 1],\\n      [1, 'good', 2],\\n240→      [2, 'passive', 0],\\n      [2, 'good', 1],\\n      [2, 'expert', 2]\\n    ];\\n    for (const cell of cells) {\\n      const tier = cell[0], skill = cell[1], need = cell[2];\\n      const r = runActivity(id, tier, skill);\\n      rows.push(id + ' t' + tier + ' ' + skill + ' ' + (r.pct || 0).toFixed(3) + ' ★' + r.stars);\\n      if (r.errors && r.errors.length) bad.push(id + ' t' + tier + ' ' + skill + ' ERR ' + r.errors.join(';'));\\n      else if (need === 0) { if (r.stars !== 0) bad.push(id + ' t' + tier + ' ' + skill + ' stars ' + r.stars + ' pct ' + r.pct); }\\n250→      else if (r.stars < need) bad.push(id + ' t' + tier + ' ' + skill + ' ★' + r.stars + ' need ' + need + ' pct ' + (r.pct || 0).toFixed(3));\\n      if (id === 'stork' && tier === 2 && skill === 'good' && !r.eyes) bad.push('stork tier 2 did not hide the plate');\\n    }\\n  }\\n  fs.writeFileSync(path.join(SCRATCH, 'gates.txt'), rows.join('\\\\n'));\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n\\nadd('rules', 'saves', () => {\\n  const game = boot();\\n260→  for (let i = 0; i < 3; i++) {\\n    G.profile = G.freshProfile(i);\\n    G.profile.name = 'Card ' + i;\\n    G.profile.day = i + 1;\\n    assert(game.saves.save(i) === true, 'save ' + i);\\n  }\\n  assert(game.saves.list().length === 4, 'list ' + game.saves.list().length);\\n  const mem = {};\\n  for (const k in game.saves._mem) mem[k] = game.saves._mem[k];\\n  const game2 = boot();\\n270→  for (const k in mem) {\\n    const slot = k === 'auto' ? 'auto' : +k;\\n    game2.saves._put(slot, mem[k]);\\n  }\\n  for (let i = 0; i < 3; i++) {\\n    const loaded = game2.saves.load(i);\\n    assert(loaded, 'load ' + i);\\n    assert(G.profile.name === 'Card ' + i, 'name ' + G.profile.name);\\n    assert(G.profile.day === i + 1, 'day ' + G.profile.day);\\n  }\\n280→  game2.saves._put(0, '{not json');\\n  const damaged = game2.saves.get(0);\\n  assert(damaged && damaged.damaged, 'not damaged');\\n  assert(game2.saves.load(0) === null, 'damaged load');\\n  const before = game2.errors.length;\\n  game2.go('slots', {}, { fade: 0 });\\n  game2.advance(1 / 120);\\n  game2.input.tap('confirm');\\n  game2.advance(1 / 120);\\n  assert(game2.errors.length === before, game2.errors.join(' | '));\\n290→});\\n\\nadd('rules', 'determinism', () => {\\n  const a = G.hashRun(1);\\n  const b = G.hashRun(1);\\n  const c = G.hashRun(2);\\n  assert(a === b, 'same seed drifted ' + a + ' ' + b);\\n  assert(a !== c, 'different seeds matched');\\n});\\n\\n300→add('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(game.time < 10, 'time ' + game.time);\\n  let guard = 0;\\n310→  while (game.time < 10 && guard++ < 40) game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.attract, 'not attract at ' + game.time + ' idle ' + G.idleSteps);\\n  assert(game.time >= 9.999, 'early ' + game.time);\\n  game.advance(0.4);\\n  assert(G.profile.minutes === minutes, 'attract awarded minutes');\\n  assert(G.profile.unlocks.join() === unlocks.join(), 'attract unlocked');\\n  assert(JSON.stringify(game.saves._mem) === memBefore, 'attract wrote a save');\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n320→  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  G.dev.jump({ day: 3, scene: 'bungalow' });\\n  game.advance(1 / 120);\\n  let s = snap(game);\\n  assert(s.scene === 'bungalow' && s.day === 3, s.scene + ' day ' + s.day);\\n  G.dev.jump({ activity: 'stork', tier: 2, driver: 'good' });\\n  game.advance(0.5);\\n  s = snap(game);\\n  assert(s.activity === 'stork' && s.tier === 2, s.activity + ' t' + s.tier);\\n  G.dev.close();\\n370→  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n380→  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n390→  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n400→    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n410→  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n420→  const sent = [];\\n  const progress = [];\\n  let result = null;\\n  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n430→      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n440→  };\\n  try {\\n    const game = boot();\\n    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n450→    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n460→    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n470→    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n480→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n490→  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n500→      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n510→\\nfunction buildHtml() {\\n  const r = spawnSync(process.execPath, ['build.mjs'], { cwd: dev, encoding: 'utf8' });\\n  if (r.status) throw new Error(r.stdout + '\\\\n' + r.stderr);\\n  return HTML;\\n}\\n\\nfunction startServer(dir) {\\n  return new Promise(function (resolve, reject) {\\n    const child = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\\n520→    let buf = '';\\n    let settled = false;\\n    const take = function (chunk) {\\n      buf += chunk.toString();\\n      const m = buf.match(/port (\\\\d+)/i);\\n      if (m && !settled) { settled = true; resolve({ child: child, port: +m[1] }); }\\n    };\\n    child.stdout.on('data', take);\\n    child.stderr.on('data', take);\\n    child.on('exit', function (code) {\\n530→      if (!settled) reject(new Error('http server exited ' + code + ' ' + buf));\\n    });\\n  });\\n}\\n\\nasync function launchOnce(n, html) {\\n  const { chromium } = await import('playwright');\\n  const errors = [];\\n  const net = [];\\n  const browser = await chromium.launch({\\n540→    executablePath: process.env.CHROMIUM_PATH || undefined,\\n    args: ['--autoplay-policy=no-user-gesture-required']\\n  });\\n  const log = { n: n };\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });\\n    await page.addInitScript(function () {\\n      const pad = {\\n        id: 'DualSense', index: 0, connected: true, mapping: 'standard',\\n        axes: [0, 0, 0, 0],\\n550→        buttons: Array.from({ length: 17 }, function () { return { pressed: false, value: 0 }; }),\",\"content_concise\":\"1→/* One command: node tests/run.mjs [rules|browser|hub|all]\\n * Prints failures and a count line. Drives the shipped scripts. */\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\nimport vm from 'node:vm';\\nimport { fileURLToPath } from 'node:url';\\n\\nconst here = path.dirname(fileURLToPath(import.meta.url));\\n10→const dev = path.resolve(here, '..');\\nconst work = path.resolve(dev, '..');\\nconst SCRATCH = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/tmp/grok-goal-0c0bba67d95a/implementer';\\nconst TITLE = 'Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108';\\nconst HTML = path.join(work, TITLE + '.html');\\n\\nconst FILES = [\\n  'vendor/session.js',\\n  'engine/my-3d2dge.js',\\n  'vendor/readable.js',\\n20→  'vendor/mocap.js',\\n  'vendor/fitclips.js',\\n  'game/data/lines.js',\\n  'game/data/content.js',\\n  'game/balance.js',\\n  'game/audio.js',\\n  'game/rigs.js',\\n  'game/ui.js',\\n  'game/play.js',\\n  'game/world.js',\\n30→  'game/boot.js'\\n];\\n\\nconst vmErrors = [];\\nconst ctx = {\\n  console: {\\n    log() {}, info() {}, warn() {}, debug() {},\\n    error(...a) { vmErrors.push(a.map(String).join(' ')); }\\n  },\\n  addEventListener() {}, removeEventListener() {},\\n40→  setTimeout, clearTimeout, setInterval, clearInterval,\\n  location: { hash: '', search: '', pathname: '/index.html', href: 'file:///index.html' },\\n  navigator: { userAgent: 'node', maxTouchPoints: 0, getGamepads() { return []; } },\\n  performance: { now: () => Date.now() },\\n  requestAnimationFrame() { return 0; },\\n  cancelAnimationFrame() {},\\n  devicePixelRatio: 1,\\n  HTMLElement: function HTMLElement() {},\\n  Element: function Element() {}\\n};\\n50→ctx.window = ctx;\\nctx.globalThis = ctx;\\nctx.self = ctx;\\nctx.parent = ctx;\\nctx.top = ctx;\\nvm.createContext(ctx);\\nfor (const f of FILES) vm.runInContext(fs.readFileSync(path.join(dev, f), 'utf8'), ctx, { filename: f });\\nconst G = ctx.G;\\nconst E = ctx.My3D2dge;\\nconst realAIHub = ctx.AIHub;\\n60→\\nfunction boot(opts) {\\n  vmErrors.length = 0;\\n  return G.boot(Object.assign({ headless: true }, opts || {}));\\n}\\nfunction snap(game) {\\n  return game.debug.snapshot();\\n}\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg);\\n70→}\\n\\nfunction pumpStory(game, driver) {\\n  G.setDriver(driver);\\n  const trace = [];\\n  let age3 = null;\\n  let same = 0;\\n  let lastKey = '';\\n  const t0 = Date.now();\\n  for (let i = 0; i < 200000; i++) {\\n80→    if (Date.now() - t0 > 240000) throw new Error('playthrough timed out\\\\n' + trace.slice(-20).join('\\\\n'));\\n    if (game.errors && game.errors.length) throw new Error(game.errors.join(' | ') + '\\\\n' + trace.slice(-12).join('\\\\n'));\\n    const s = snap(game);\\n    const talkI = (G.talk && G.talk.open) ? G.talk.i : -1;\\n    const key = [s.scene, s.day, s.session, s.phase, s.activity, talkI, Math.round((s.left || 0) * 10)].join('|');\\n    const mark = s.scene + ' d' + s.day + ' ' + s.phase + ' ' + (s.activity || '') + (talkI >= 0 ? ' p' + talkI : '');\\n    if (trace[trace.length - 1] !== mark) trace.push(mark);\\n    if (s.day === 3 && s.plateau) {\\n      if (age3 == null) age3 = s.spineAge;\\n      else if (s.spineAge !== age3) throw new Error('day 3 Spine Age moved from ' + age3 + ' to ' + s.spineAge);\\n90→    }\\n    if (s.freePlay && s.scene === 'ending') {\\n      game.advance(1 / 120);\\n      break;\\n    }\\n    if (s.scene === 'free') break;\\n    if (key === lastKey) same++;\\n    else { same = 0; lastKey = key; }\\n    if (same > 40) throw new Error('stuck ' + key + '\\\\n' + trace.slice(-24).join('\\\\n'));\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n100→      G.setDriver(driver);\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n  }\\n  const end = snap(game);\\n  return { end, age3, trace, profile: G.profile };\\n110→}\\n\\nfunction runActivity(id, tier, skill) {\\n  const game = boot();\\n  G.setDriver(skill);\\n  game.go('play', { id: id, tier: tier, trial: true, driver: skill, skipToPlay: true, seed: 4 }, { fade: 0 });\\n  let eyes = false;\\n  for (let i = 0; i < 40000; i++) {\\n    const s = snap(game);\\n    if (G.session && G.session.fam && G.session.fam.eyes) eyes = true;\\n120→    if (s.scene === 'play' && s.phase === 'menu' && s.activity === id && i > 2) {\\n      return { pct: s.pct, stars: s.stars, eyes: eyes, errors: game.errors.slice() };\\n    }\\n    if (game.errors.length) return { pct: s.pct, stars: s.stars, eyes: eyes, errors: game.errors.slice() };\\n    G.setDriver(skill);\\n    const dt = Math.max(1 / 120, Math.min(0.5, s.left > 0 ? s.left : 0.25));\\n    game.advance(dt);\\n  }\\n  return { pct: 0, stars: 0, eyes: eyes, errors: ['timed out ' + id + ' t' + tier + ' ' + skill] };\\n}\\n130→\\nconst tests = [];\\nfunction add(group, name, fn) { tests.push({ group, name, fn }); }\\n\\nadd('rules', 'boot smoke', () => {\\n  const game = boot();\\n  const s = snap(game);\\n  assert(s.scene === 'title', 'scene ' + s.scene);\\n  assert(s.title === 'Spine Wee', s.title);\\n  assert(game.settings.music === 0.1, 'music ' + game.settings.music);\\n140→  assert(game.settings.glyphs === 'playstation', 'glyphs ' + game.settings.glyphs);\\n  assert(!game.errors.length, game.errors.join(' | '));\\n  game.advance(0.2);\\n  assert(snap(game).scene === 'title', 'left title');\\n});\\n\\nadd('rules', 'section 3 bands', () => {\\n  const names = ['body', 'sun', 'stork1', 'stork2', 'candle', 'laundry'];\\n  const skills = ['passive', 'poor', 'average', 'good'];\\n  const acc = {};\\n150→  for (const name of names) for (const skill of skills) acc[name + ' ' + skill] = [];\\n  for (let s = 1; s <= 12; s++) {\\n    for (const name of names) {\\n      const seed = (s * 997 + name.charCodeAt(0) * 13) >>> 0;\\n      for (const skill of skills) {\\n        const r = G.bandTrial(name, skill, seed);\\n        acc[name + ' ' + skill].push(r.pct);\\n      }\\n    }\\n  }\\n160→  const bad = [];\\n  for (const key in acc) {\\n    const name = key.split(' ')[0];\\n    const skill = key.split(' ')[1];\\n    const mean = acc[key].reduce(function (a, b) { return a + b; }, 0) / acc[key].length;\\n    const expect = G.SETS[name].band[skill];\\n    if (Math.abs(mean - expect) > 10) bad.push(key + ' mean ' + mean.toFixed(1) + ' vs ' + expect);\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n170→\\nadd('rules', 'device lean', () => {\\n  const padGame = boot();\\n  const stopPad = padGame.hook('input', function () {\\n    const p = padGame.input.padMove;\\n    p[0] = 0.8;\\n    p[1] = -0.2;\\n  });\\n  padGame.advance(1 / 120);\\n  assert(G.lean.source === 'pad', 'pad source ' + G.lean.source);\\n180→  assert(G.lean.ux > 0.5, 'pad ux ' + G.lean.ux);\\n  stopPad();\\n\\n  const keyGame = boot();\\n  keyGame.input.hold('left', true);\\n  keyGame.advance(0.45);\\n  assert(G.lean.source === 'keys', 'key source ' + G.lean.source);\\n  assert(G.lean.ux < -0.4, 'key ux ' + G.lean.ux);\\n  keyGame.input.hold('left', false);\\n\\n190→  const mouseGame = boot();\\n  const W = mouseGame.screen.W, H = mouseGame.screen.H;\\n  const stopMouse = mouseGame.hook('input', function () {\\n    mouseGame.input.feed('move', W * 0.82, H * 0.5);\\n  });\\n  mouseGame.advance(1 / 120);\\n  assert(G.lean.source === 'mouse', 'mouse source ' + G.lean.source + ' ux ' + G.lean.ux);\\n  assert(G.lean.ux > 0.25, 'mouse ux ' + G.lean.ux);\\n  stopMouse();\\n});\\n200→\\nadd('rules', 'good playthrough', () => {\\n  const game = boot();\\n  const out = pumpStory(game, 'good');\\n  fs.writeFileSync(path.join(SCRATCH, 'play-good.json'), JSON.stringify({\\n    scene: out.end.scene, day: out.end.day, minutes: out.profile.minutes, age: out.end.spineAge,\\n    age3: out.age3, unlocks: out.profile.unlocks, played: out.profile.played, duel: out.profile.duelWon,\\n    free: out.profile.freePlay, trace: out.trace\\n  }, null, 2));\\n  assert(out.end.scene === 'free', 'ended in ' + out.end.scene + '\\\\n' + out.trace.slice(-12).join('\\\\n'));\\n210→  assert(out.profile.freePlay, 'free play flag');\\n  assert(out.age3 != null, 'never held day 3');\\n  assert(out.end.spineAge < 71, 'spine age ' + out.end.spineAge);\\n  const ids = Object.keys(G.ACTS);\\n  const played = ids.filter(function (id) { return out.profile.played[id]; });\\n  assert(played.length === ids.length, 'played ' + played.join(','));\\n  assert(out.profile.unlocks.indexOf('friend') >= 0, 'minutes ' + out.profile.minutes + ' unlocks ' + out.profile.unlocks.join(','));\\n});\\n\\nadd('rules', 'passive playthrough', () => {\\n220→  const game = boot();\\n  const out = pumpStory(game, 'passive');\\n  fs.writeFileSync(path.join(SCRATCH, 'play-passive.json'), JSON.stringify({\\n    scene: out.end.scene, minutes: out.profile.minutes, age3: out.age3, duel: out.profile.duelWon, trace: out.trace\\n  }, null, 2));\\n  assert(out.end.scene === 'free', 'ended in ' + out.end.scene + '\\\\n' + out.trace.slice(-12).join('\\\\n'));\\n  assert(out.age3 != null, 'never held day 3');\\n  assert(out.profile.ending, 'no ending flag');\\n});\\n\\n230→add('rules', 'star gates', () => {\\n  const bad = [];\\n  const rows = [];\\n  const ids = Object.keys(G.ACTS);\\n  for (const id of ids) {\\n    const gates = G.ACTS[id].stars;\\n    const cells = [\\n      [1, 'passive', 0],\\n      [1, 'average', 1],\\n      [1, 'good', 2],\\n240→      [2, 'passive', 0],\\n      [2, 'good', 1],\\n      [2, 'expert', 2]\\n    ];\\n    for (const cell of cells) {\\n      const tier = cell[0], skill = cell[1], need = cell[2];\\n      const r = runActivity(id, tier, skill);\\n      rows.push(id + ' t' + tier + ' ' + skill + ' ' + (r.pct || 0).toFixed(3) + ' ★' + r.stars);\\n      if (r.errors && r.errors.length) bad.push(id + ' t' + tier + ' ' + skill + ' ERR ' + r.errors.join(';'));\\n      else if (need === 0) { if (r.stars !== 0) bad.push(id + ' t' + tier + ' ' + skill + ' stars ' + r.stars + ' pct ' + r.pct); }\\n250→      else if (r.stars < need) bad.push(id + ' t' + tier + ' ' + skill + ' ★' + r.stars + ' need ' + need + ' pct ' + (r.pct || 0).toFixed(3));\\n      if (id === 'stork' && tier === 2 && skill === 'good' && !r.eyes) bad.push('stork tier 2 did not hide the plate');\\n    }\\n  }\\n  fs.writeFileSync(path.join(SCRATCH, 'gates.txt'), rows.join('\\\\n'));\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n\\nadd('rules', 'saves', () => {\\n  const game = boot();\\n260→  for (let i = 0; i < 3; i++) {\\n    G.profile = G.freshProfile(i);\\n    G.profile.name = 'Card ' + i;\\n    G.profile.day = i + 1;\\n    assert(game.saves.save(i) === true, 'save ' + i);\\n  }\\n  assert(game.saves.list().length === 4, 'list ' + game.saves.list().length);\\n  const mem = {};\\n  for (const k in game.saves._mem) mem[k] = game.saves._mem[k];\\n  const game2 = boot();\\n270→  for (const k in mem) {\\n    const slot = k === 'auto' ? 'auto' : +k;\\n    game2.saves._put(slot, mem[k]);\\n  }\\n  for (let i = 0; i < 3; i++) {\\n    const loaded = game2.saves.load(i);\\n    assert(loaded, 'load ' + i);\\n    assert(G.profile.name === 'Card ' + i, 'name ' + G.profile.name);\\n    assert(G.profile.day === i + 1, 'day ' + G.profile.day);\\n  }\\n280→  game2.saves._put(0, '{not json');\\n  const damaged = game2.saves.get(0);\\n  assert(damaged && damaged.damaged, 'not damaged');\\n  assert(game2.saves.load(0) === null, 'damaged load');\\n  const before = game2.errors.length;\\n  game2.go('slots', {}, { fade: 0 });\\n  game2.advance(1 / 120);\\n  game2.input.tap('confirm');\\n  game2.advance(1 / 120);\\n  assert(game2.errors.length === before, game2.errors.join(' | '));\\n290→});\\n\\nadd('rules', 'determinism', () => {\\n  const a = G.hashRun(1);\\n  const b = G.hashRun(1);\\n  const c = G.hashRun(2);\\n  assert(a === b, 'same seed drifted ' + a + ' ' + b);\\n  assert(a !== c, 'different seeds matched');\\n});\\n\\n300→add('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(game.time < 10, 'time ' + game.time);\\n  let guard = 0;\\n310→  while (game.time < 10 && guard++ < 40) game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.attract, 'not attract at ' + game.time + ' idle ' + G.idleSteps);\\n  assert(game.time >= 9.999, 'early ' + game.time);\\n  game.advance(0.4);\\n  assert(G.profile.minutes === minutes, 'attract awarded minutes');\\n  assert(G.profile.unlocks.join() === unlocks.join(), 'attract unlocked');\\n  assert(JSON.stringify(game.saves._mem) === memBefore, 'attract wrote a save');\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n320→  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  G.dev.jump({ day: 3, scene: 'bungalow' });\\n  game.advance(1 / 120);\\n  let s = snap(game);\\n  assert(s.scene === 'bungalow' && s.day === 3, s.scene + ' day ' + s.day);\\n  G.dev.jump({ activity: 'stork', tier: 2, driver: 'good' });\\n  game.advance(0.5);\\n  s = snap(game);\\n  assert(s.activity === 'stork' && s.tier === 2, s.activity + ' t' + s.tier);\\n  G.dev.close();\\n370→  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n380→  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n390→  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n400→    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n410→  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n420→  const sent = [];\\n  const progress = [];\\n  let result = null;\\n  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n430→      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n440→  };\\n  try {\\n    const game = boot();\\n    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n450→    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n460→    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n470→    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n480→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n490→  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n500→      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n510→\\nfunction buildHtml() {\\n  const r = spawnSync(process.execPath, ['build.mjs'], { cwd: dev, encoding: 'utf8' });\\n  if (r.status) throw new Error(r.stdout + '\\\\n' + r.stderr);\\n  return HTML;\\n}\\n\\nfunction startServer(dir) {\\n  return new Promise(function (resolve, reject) {\\n    const child = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\\n520→    let buf = '';\\n    let settled = false;\\n    const take = function (chunk) {\\n      buf += chunk.toString();\\n      const m = buf.match(/port (\\\\d+)/i);\\n      if (m && !settled) { settled = true; resolve({ child: child, port: +m[1] }); }\\n    };\\n    child.stdout.on('data', take);\\n    child.stderr.on('data', take);\\n    child.on('exit', function (code) {\\n530→      if (!settled) reject(new Error('http server exited ' + code + ' ' + buf));\\n    });\\n  });\\n}\\n\\nasync function launchOnce(n, html) {\\n  const { chromium } = await import('playwright');\\n  const errors = [];\\n  const net = [];\\n  const browser = await chromium.launch({\\n540→    executablePath: process.env.CHROMIUM_PATH || undefined,\\n    args: ['--autoplay-policy=no-user-gesture-required']\\n  });\\n  const log = { n: n };\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });\\n    await page.addInitScript(function () {\\n      const pad = {\\n        id: 'DualSense', index: 0, connected: true, mapping: 'standard',\\n        axes: [0, 0, 0, 0],\\n550→        buttons: Array.from({ length: 17 }, function () { return { pressed: false, value: 0 }; }),\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs\",\"offset\":1,\"limit\":550,\"raw_output\":\"/* One command: node tests/run.mjs [rules|browser|hub|all]\\n * Prints failures and a count line. Drives the shipped scripts. */\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\nimport vm from 'node:vm';\\nimport { fileURLToPath } from 'node:url';\\n\\nconst here = path.dirname(fileURLToPath(import.meta.url));\\nconst dev = path.resolve(here, '..');\\nconst work = path.resolve(dev, '..');\\nconst SCRATCH = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/tmp/grok-goal-0c0bba67d95a/implementer';\\nconst TITLE = 'Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108';\\nconst HTML = path.join(work, TITLE + '.html');\\n\\nconst FILES = [\\n  'vendor/session.js',\\n  'engine/my-3d2dge.js',\\n  'vendor/readable.js',\\n  'vendor/mocap.js',\\n  'vendor/fitclips.js',\\n  'game/data/lines.js',\\n  'game/data/content.js',\\n  'game/balance.js',\\n  'game/audio.js',\\n  'game/rigs.js',\\n  'game/ui.js',\\n  'game/play.js',\\n  'game/world.js',\\n  'game/boot.js'\\n];\\n\\nconst vmErrors = [];\\nconst ctx = {\\n  console: {\\n    log() {}, info() {}, warn() {}, debug() {},\\n    error(...a) { vmErrors.push(a.map(String).join(' ')); }\\n  },\\n  addEventListener() {}, removeEventListener() {},\\n  setTimeout, clearTimeout, setInterval, clearInterval,\\n  location: { hash: '', search: '', pathname: '/index.html', href: 'file:///index.html' },\\n  navigator: { userAgent: 'node', maxTouchPoints: 0, getGamepads() { return []; } },\\n  performance: { now: () => Date.now() },\\n  requestAnimationFrame() { return 0; },\\n  cancelAnimationFrame() {},\\n  devicePixelRatio: 1,\\n  HTMLElement: function HTMLElement() {},\\n  Element: function Element() {}\\n};\\nctx.window = ctx;\\nctx.globalThis = ctx;\\nctx.self = ctx;\\nctx.parent = ctx;\\nctx.top = ctx;\\nvm.createContext(ctx);\\nfor (const f of FILES) vm.runInContext(fs.readFileSync(path.join(dev, f), 'utf8'), ctx, { filename: f });\\nconst G = ctx.G;\\nconst E = ctx.My3D2dge;\\nconst realAIHub = ctx.AIHub;\\n\\nfunction boot(opts) {\\n  vmErrors.length = 0;\\n  return G.boot(Object.assign({ headless: true }, opts || {}));\\n}\\nfunction snap(game) {\\n  return game.debug.snapshot();\\n}\\nfunction assert(cond, msg) {\\n  if (!cond) throw new Error(msg);\\n}\\n\\nfunction pumpStory(game, driver) {\\n  G.setDriver(driver);\\n  const trace = [];\\n  let age3 = null;\\n  let same = 0;\\n  let lastKey = '';\\n  const t0 = Date.now();\\n  for (let i = 0; i < 200000; i++) {\\n    if (Date.now() - t0 > 240000) throw new Error('playthrough timed out\\\\n' + trace.slice(-20).join('\\\\n'));\\n    if (game.errors && game.errors.length) throw new Error(game.errors.join(' | ') + '\\\\n' + trace.slice(-12).join('\\\\n'));\\n    const s = snap(game);\\n    const talkI = (G.talk && G.talk.open) ? G.talk.i : -1;\\n    const key = [s.scene, s.day, s.session, s.phase, s.activity, talkI, Math.round((s.left || 0) * 10)].join('|');\\n    const mark = s.scene + ' d' + s.day + ' ' + s.phase + ' ' + (s.activity || '') + (talkI >= 0 ? ' p' + talkI : '');\\n    if (trace[trace.length - 1] !== mark) trace.push(mark);\\n    if (s.day === 3 && s.plateau) {\\n      if (age3 == null) age3 = s.spineAge;\\n      else if (s.spineAge !== age3) throw new Error('day 3 Spine Age moved from ' + age3 + ' to ' + s.spineAge);\\n    }\\n    if (s.freePlay && s.scene === 'ending') {\\n      game.advance(1 / 120);\\n      break;\\n    }\\n    if (s.scene === 'free') break;\\n    if (key === lastKey) same++;\\n    else { same = 0; lastKey = key; }\\n    if (same > 40) throw new Error('stuck ' + key + '\\\\n' + trace.slice(-24).join('\\\\n'));\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      G.setDriver(driver);\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n  }\\n  const end = snap(game);\\n  return { end, age3, trace, profile: G.profile };\\n}\\n\\nfunction runActivity(id, tier, skill) {\\n  const game = boot();\\n  G.setDriver(skill);\\n  game.go('play', { id: id, tier: tier, trial: true, driver: skill, skipToPlay: true, seed: 4 }, { fade: 0 });\\n  let eyes = false;\\n  for (let i = 0; i < 40000; i++) {\\n    const s = snap(game);\\n    if (G.session && G.session.fam && G.session.fam.eyes) eyes = true;\\n    if (s.scene === 'play' && s.phase === 'menu' && s.activity === id && i > 2) {\\n      return { pct: s.pct, stars: s.stars, eyes: eyes, errors: game.errors.slice() };\\n    }\\n    if (game.errors.length) return { pct: s.pct, stars: s.stars, eyes: eyes, errors: game.errors.slice() };\\n    G.setDriver(skill);\\n    const dt = Math.max(1 / 120, Math.min(0.5, s.left > 0 ? s.left : 0.25));\\n    game.advance(dt);\\n  }\\n  return { pct: 0, stars: 0, eyes: eyes, errors: ['timed out ' + id + ' t' + tier + ' ' + skill] };\\n}\\n\\nconst tests = [];\\nfunction add(group, name, fn) { tests.push({ group, name, fn }); }\\n\\nadd('rules', 'boot smoke', () => {\\n  const game = boot();\\n  const s = snap(game);\\n  assert(s.scene === 'title', 'scene ' + s.scene);\\n  assert(s.title === 'Spine Wee', s.title);\\n  assert(game.settings.music === 0.1, 'music ' + game.settings.music);\\n  assert(game.settings.glyphs === 'playstation', 'glyphs ' + game.settings.glyphs);\\n  assert(!game.errors.length, game.errors.join(' | '));\\n  game.advance(0.2);\\n  assert(snap(game).scene === 'title', 'left title');\\n});\\n\\nadd('rules', 'section 3 bands', () => {\\n  const names = ['body', 'sun', 'stork1', 'stork2', 'candle', 'laundry'];\\n  const skills = ['passive', 'poor', 'average', 'good'];\\n  const acc = {};\\n  for (const name of names) for (const skill of skills) acc[name + ' ' + skill] = [];\\n  for (let s = 1; s <= 12; s++) {\\n    for (const name of names) {\\n      const seed = (s * 997 + name.charCodeAt(0) * 13) >>> 0;\\n      for (const skill of skills) {\\n        const r = G.bandTrial(name, skill, seed);\\n        acc[name + ' ' + skill].push(r.pct);\\n      }\\n    }\\n  }\\n  const bad = [];\\n  for (const key in acc) {\\n    const name = key.split(' ')[0];\\n    const skill = key.split(' ')[1];\\n    const mean = acc[key].reduce(function (a, b) { return a + b; }, 0) / acc[key].length;\\n    const expect = G.SETS[name].band[skill];\\n    if (Math.abs(mean - expect) > 10) bad.push(key + ' mean ' + mean.toFixed(1) + ' vs ' + expect);\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n\\nadd('rules', 'device lean', () => {\\n  const padGame = boot();\\n  const stopPad = padGame.hook('input', function () {\\n    const p = padGame.input.padMove;\\n    p[0] = 0.8;\\n    p[1] = -0.2;\\n  });\\n  padGame.advance(1 / 120);\\n  assert(G.lean.source === 'pad', 'pad source ' + G.lean.source);\\n  assert(G.lean.ux > 0.5, 'pad ux ' + G.lean.ux);\\n  stopPad();\\n\\n  const keyGame = boot();\\n  keyGame.input.hold('left', true);\\n  keyGame.advance(0.45);\\n  assert(G.lean.source === 'keys', 'key source ' + G.lean.source);\\n  assert(G.lean.ux < -0.4, 'key ux ' + G.lean.ux);\\n  keyGame.input.hold('left', false);\\n\\n  const mouseGame = boot();\\n  const W = mouseGame.screen.W, H = mouseGame.screen.H;\\n  const stopMouse = mouseGame.hook('input', function () {\\n    mouseGame.input.feed('move', W * 0.82, H * 0.5);\\n  });\\n  mouseGame.advance(1 / 120);\\n  assert(G.lean.source === 'mouse', 'mouse source ' + G.lean.source + ' ux ' + G.lean.ux);\\n  assert(G.lean.ux > 0.25, 'mouse ux ' + G.lean.ux);\\n  stopMouse();\\n});\\n\\nadd('rules', 'good playthrough', () => {\\n  const game = boot();\\n  const out = pumpStory(game, 'good');\\n  fs.writeFileSync(path.join(SCRATCH, 'play-good.json'), JSON.stringify({\\n    scene: out.end.scene, day: out.end.day, minutes: out.profile.minutes, age: out.end.spineAge,\\n    age3: out.age3, unlocks: out.profile.unlocks, played: out.profile.played, duel: out.profile.duelWon,\\n    free: out.profile.freePlay, trace: out.trace\\n  }, null, 2));\\n  assert(out.end.scene === 'free', 'ended in ' + out.end.scene + '\\\\n' + out.trace.slice(-12).join('\\\\n'));\\n  assert(out.profile.freePlay, 'free play flag');\\n  assert(out.age3 != null, 'never held day 3');\\n  assert(out.end.spineAge < 71, 'spine age ' + out.end.spineAge);\\n  const ids = Object.keys(G.ACTS);\\n  const played = ids.filter(function (id) { return out.profile.played[id]; });\\n  assert(played.length === ids.length, 'played ' + played.join(','));\\n  assert(out.profile.unlocks.indexOf('friend') >= 0, 'minutes ' + out.profile.minutes + ' unlocks ' + out.profile.unlocks.join(','));\\n});\\n\\nadd('rules', 'passive playthrough', () => {\\n  const game = boot();\\n  const out = pumpStory(game, 'passive');\\n  fs.writeFileSync(path.join(SCRATCH, 'play-passive.json'), JSON.stringify({\\n    scene: out.end.scene, minutes: out.profile.minutes, age3: out.age3, duel: out.profile.duelWon, trace: out.trace\\n  }, null, 2));\\n  assert(out.end.scene === 'free', 'ended in ' + out.end.scene + '\\\\n' + out.trace.slice(-12).join('\\\\n'));\\n  assert(out.age3 != null, 'never held day 3');\\n  assert(out.profile.ending, 'no ending flag');\\n});\\n\\nadd('rules', 'star gates', () => {\\n  const bad = [];\\n  const rows = [];\\n  const ids = Object.keys(G.ACTS);\\n  for (const id of ids) {\\n    const gates = G.ACTS[id].stars;\\n    const cells = [\\n      [1, 'passive', 0],\\n      [1, 'average', 1],\\n      [1, 'good', 2],\\n      [2, 'passive', 0],\\n      [2, 'good', 1],\\n      [2, 'expert', 2]\\n    ];\\n    for (const cell of cells) {\\n      const tier = cell[0], skill = cell[1], need = cell[2];\\n      const r = runActivity(id, tier, skill);\\n      rows.push(id + ' t' + tier + ' ' + skill + ' ' + (r.pct || 0).toFixed(3) + ' ★' + r.stars);\\n      if (r.errors && r.errors.length) bad.push(id + ' t' + tier + ' ' + skill + ' ERR ' + r.errors.join(';'));\\n      else if (need === 0) { if (r.stars !== 0) bad.push(id + ' t' + tier + ' ' + skill + ' stars ' + r.stars + ' pct ' + r.pct); }\\n      else if (r.stars < need) bad.push(id + ' t' + tier + ' ' + skill + ' ★' + r.stars + ' need ' + need + ' pct ' + (r.pct || 0).toFixed(3));\\n      if (id === 'stork' && tier === 2 && skill === 'good' && !r.eyes) bad.push('stork tier 2 did not hide the plate');\\n    }\\n  }\\n  fs.writeFileSync(path.join(SCRATCH, 'gates.txt'), rows.join('\\\\n'));\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n\\nadd('rules', 'saves', () => {\\n  const game = boot();\\n  for (let i = 0; i < 3; i++) {\\n    G.profile = G.freshProfile(i);\\n    G.profile.name = 'Card ' + i;\\n    G.profile.day = i + 1;\\n    assert(game.saves.save(i) === true, 'save ' + i);\\n  }\\n  assert(game.saves.list().length === 4, 'list ' + game.saves.list().length);\\n  const mem = {};\\n  for (const k in game.saves._mem) mem[k] = game.saves._mem[k];\\n  const game2 = boot();\\n  for (const k in mem) {\\n    const slot = k === 'auto' ? 'auto' : +k;\\n    game2.saves._put(slot, mem[k]);\\n  }\\n  for (let i = 0; i < 3; i++) {\\n    const loaded = game2.saves.load(i);\\n    assert(loaded, 'load ' + i);\\n    assert(G.profile.name === 'Card ' + i, 'name ' + G.profile.name);\\n    assert(G.profile.day === i + 1, 'day ' + G.profile.day);\\n  }\\n  game2.saves._put(0, '{not json');\\n  const damaged = game2.saves.get(0);\\n  assert(damaged && damaged.damaged, 'not damaged');\\n  assert(game2.saves.load(0) === null, 'damaged load');\\n  const before = game2.errors.length;\\n  game2.go('slots', {}, { fade: 0 });\\n  game2.advance(1 / 120);\\n  game2.input.tap('confirm');\\n  game2.advance(1 / 120);\\n  assert(game2.errors.length === before, game2.errors.join(' | '));\\n});\\n\\nadd('rules', 'determinism', () => {\\n  const a = G.hashRun(1);\\n  const b = G.hashRun(1);\\n  const c = G.hashRun(2);\\n  assert(a === b, 'same seed drifted ' + a + ' ' + b);\\n  assert(a !== c, 'different seeds matched');\\n});\\n\\nadd('rules', 'attract at 10s', () => {\\n  const game = boot();\\n  const memBefore = JSON.stringify(game.saves._mem);\\n  const minutes = G.profile.minutes;\\n  const unlocks = G.profile.unlocks.slice();\\n  game.advance(9.9);\\n  let s = snap(game);\\n  assert(!s.attract, 'attract at ' + game.time);\\n  assert(game.time < 10, 'time ' + game.time);\\n  let guard = 0;\\n  while (game.time < 10 && guard++ < 40) game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.attract, 'not attract at ' + game.time + ' idle ' + G.idleSteps);\\n  assert(game.time >= 9.999, 'early ' + game.time);\\n  game.advance(0.4);\\n  assert(G.profile.minutes === minutes, 'attract awarded minutes');\\n  assert(G.profile.unlocks.join() === unlocks.join(), 'attract unlocked');\\n  assert(JSON.stringify(game.saves._mem) === memBefore, 'attract wrote a save');\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  s = snap(game);\\n  assert(s.scene === 'title', 'returned to ' + s.scene);\\n  assert(!s.attract, 'still attracting');\\n});\\n\\nadd('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  G.dev.jump({ day: 3, scene: 'bungalow' });\\n  game.advance(1 / 120);\\n  let s = snap(game);\\n  assert(s.scene === 'bungalow' && s.day === 3, s.scene + ' day ' + s.day);\\n  G.dev.jump({ activity: 'stork', tier: 2, driver: 'good' });\\n  game.advance(0.5);\\n  s = snap(game);\\n  assert(s.activity === 'stork' && s.tier === 2, s.activity + ' t' + s.tier);\\n  G.dev.close();\\n  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n  const sent = [];\\n  const progress = [];\\n  let result = null;\\n  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n  };\\n  try {\\n    const game = boot();\\n    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n\\nfunction buildHtml() {\\n  const r = spawnSync(process.execPath, ['build.mjs'], { cwd: dev, encoding: 'utf8' });\\n  if (r.status) throw new Error(r.stdout + '\\\\n' + r.stderr);\\n  return HTML;\\n}\\n\\nfunction startServer(dir) {\\n  return new Promise(function (resolve, reject) {\\n    const child = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\\n    let buf = '';\\n    let settled = false;\\n    const take = function (chunk) {\\n      buf += chunk.toString();\\n      const m = buf.match(/port (\\\\d+)/i);\\n      if (m && !settled) { settled = true; resolve({ child: child, port: +m[1] }); }\\n    };\\n    child.stdout.on('data', take);\\n    child.stderr.on('data', take);\\n    child.on('exit', function (code) {\\n      if (!settled) reject(new Error('http server exited ' + code + ' ' + buf));\\n    });\\n  });\\n}\\n\\nasync function launchOnce(n, html) {\\n  const { chromium } = await import('playwright');\\n  const errors = [];\\n  const net = [];\\n  const browser = await chromium.launch({\\n    executablePath: process.env.CHROMIUM_PATH || undefined,\\n    args: ['--autoplay-policy=no-user-gesture-required']\\n  });\\n  const log = { n: n };\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });\\n    await page.addInitScript(function () {\\n      const pad = {\\n        id: 'DualSense', index: 0, connected: true, mapping: 'standard',\\n        axes: [0, 0, 0, 0],\\n        buttons: Array.from({ length: 17 }, function () { return { pressed: false, value: 0 }; }),\\n\",\"total_lines\":809}}","is_error":false},{"type":"tool_result","tool_use_id":"call-34adb1e6-775c-405b-84db-aaadc06437ae-17","content":"{\"type\":\"ReadFile\",\"ImageContent\":{\"data\":\"\",\"mime_type\":\"image/png\"}}","is_error":false},{"type":"tool_result","tool_use_id":"call-34adb1e6-775c-405b-84db-aaadc06437ae-18","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→stork t1 passive 0.037 ★0\\nstork t1 average 0.685 ★2\\nstork t1 good 0.934 ★3\\nstork t2 passive 0.000 ★0\\nstork t2 good 0.566 ★1\\nstork t2 expert 0.758 ★2\\nsun t1 passive 0.403 ★0\\nsun t1 average 1.000 ★3\\nsun t1 good 1.000 ★3\\n10→sun t2 passive 0.403 ★0\\nsun t2 good 1.000 ★3\\nsun t2 expert 1.000 ★3\\ncandle t1 passive 0.290 ★0\\ncan