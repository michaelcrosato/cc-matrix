0261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js\",\"matches\":[{\"line_number\":17,\"content\":\"  G.CLASS_INPUT = {\"},{\"line_number\":812,\"content\":\"    input: G.CLASS_INPUT,\"},{\"line_number\":819,\"content\":\"      if (g.headless && g.players.length < 2) { try { g.addPlayer({ keys: 'right' }); } catch (e) { /* one mat */ } }\"},{\"line_number\":857,\"content\":\"      while (g.players.length > 1) { try { g.removePlayer(g.players[g.players.length - 1]); } catch (e) { break; } }\"},{\"line_number\":1090,\"content\":\"        const words = String(p.t).split(' ');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"matches\":[{\"line_number\":193,\"content\":\"    const parts = String(chart.order).trim().split(/\\\\s+/).length;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/boot.js\",\"matches\":[{\"line_number\":308,\"content\":\"      const parts = hash.slice(5).split('/');\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-184eefcc-2cab-4d44-a041-eba2d59485d2-44","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"427→## 12. Attract Mode\\n\\nAfter **10 s with no input** on the title or any top-level menu (`game.hook('input', ...)`: `anyPressed`, stick, pointer movement). **Any input** returns to the title and swallows the press (`input.consumeAll()`).\\n430→\\nFiction: nobody's here, so Tare shows the empty room around. A \\\"DEMO\\\" chip, the logo in a corner, \\\"Press any button\\\" (by device), and subtitled lines: \\\"Nobody's here. I'll just show the room what we do.\\\" On exit: \\\"Oh! You're back. I wasn't doing anything.\\\"\\n\\n**Playlist, about 15 s each, looping:** Island walk → Body Check → Stork Stand → Sun Flow → Quiet Candle → Squat Rail → Push-Up → Side Lunge → Step Class → Hoop Hips → Coastal Jog → Slalom → Tray Service → Laundry Line → four-mat Class → results with Gerald's coins → Grand Stillness. Each runs the real activity scene with the expert bot filling `intent`, with cheats allowed (no stumbles). It never touches saves or unlocks. Use a Regular's rig as the star.\\n\\n---\\n\\n## 13. Dev Mode\\n\\nReachable from the pause menu (`menu.items`), in every scene, on every device. It closes the pause and docks a canvas panel on the left third **while the game keeps running**, so balance changes are felt live. D-pad up/down moves, left/right adjusts (held accelerates, L1/R1 coarse), ✕ activates, ○ closes. Arrows on keyboard (WASD keeps leaning). Mouse: drag sliders; the pointer over the panel does not lean.\\n440→\\n**Live sliders** (all in one `DEV` object with defaults; \\\"Reset to defaults\\\" restores it; each shows default vs current):\\n- Lean: `k c s A nf`, ring scale, push strength, stumble threshold, mouse reach, nudge rate\\n- Scoring: star thresholds, rep tolerance, rhythm window scale, fatigue amount\\n- Cardio: hoop band, jog cadence band, jog speed\\n- Games: slalom speed and turn, tray gravity and friction, rope instability, gust strength\\n- World: time scale (0, .25, .5, 1, 2), minutes multiplier\\n\\n**Tools:** jump to any scene/activity/tier/day; finish now with N stars; unlock all; +10 minutes; set Spine Age; reset this member; no stumbles; bot plays (poor/average/good/expert); show Plate trace and numbers; frame step; force attract; **Pose Viewer** (pick any clip, scrub, print a pose row for `game/data/poses.js`); log `game.debug.snapshot()` to the console. Hidden in a hub session.\\n\\n450→---\\n\\n## 14. Multiplayer\\n\\n**Class (local, on its own, 2 to 4).** From the title: join with Start on a free pad or 2 on the keyboard (`game.allowJoin({ max: 4, onJoin })`; `game.players[i]` has the same input API; keyboard players get `E.Input.halfKeys`). ✔ Half a keyboard runs out of keys with the full `INPUT` (the step and pace actions get none), so the Class scene sets its own `input`: the moves and menu actions plus `breath`, `catchL`, `catchR` only (left half F G H, right half `. / ,`), and its Step Class reads `lanes: ['left', 'down', 'up', 'right']`. Everyone gets a mat, a colour (`E.PLAYER_COLORS`) and a pre-made rig, on one fixed screen at size 1.5 with a small Plate under each. Activities: Stork Stand, Quiet Candle, Squat Rail, Step Class (two lanes), Hoop Hips, 35 s each, or \\\"Surprise me\\\" (3 rounds). So every class-capable activity takes a list of **contestants** from the start, not one player. Scores are 0 to 1000 (`round(pct × 1000)`). Results: podium with polite titles (Most Still, Best Wobble, Participated). Tare reads them. Empty mats hold Regulars driven by bots, for life, not for score.\\n\\n**AI Hub session (`ghost` mode, 1 to 4).** Follow the protocol README (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); it is short, read it. Outside a session the game is unaffected and `connect()` answers `null`. ✔ This exact shape passed the harness at 1, 2, 3 and 4 players, on the bad network, and with the host leaving.\\n\\n**The round: \\\"Morning Class\\\".** Everyone plays the same 3 events on their own copy, in lockstep, seeing others as translucent seat-coloured ghosts on neighbouring mats (or in the world for Slalom and Jog). About 150 s: each event is 5 s intro + 40 s play + 5 s scores. Deal with `AIHub.rng('deal')`: one from Stork/Candle/Squat/Push-Up, one from Step/Hoop, one from Slalom/Jog.\\n\\n460→```js\\nconst inSession = !!(window.AIHub && AIHub.active);\\nconst game = new E.Game({ canvas: 'screen', id: 'GAMEID', res: 'ps1', expand: true, touch: 'never', input: INPUT,\\n  autoPause: !inSession, live: inSession, fullscreen: inSession ? false : 'button',\\n  menu: { quit: inSession ? false : 'title', items: inSession ? [] : [/* Restart, Dev Mode */], settings: [/* section 11 */] } });\\ngame.start({ scenes, scene: inSession ? 'round' : 'title', boot: {/* steps */} });\\nif (inSession) (async () => {\\n  const info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\\n  if (!info) return game.go('title');\\n  AIHub.on('card', c => { card = c; });\\n470→  AIHub.on('start', () => {});\\n  AIHub.on('message', (d, from) => { /* ghost state */ });\\n  AIHub.on('leave', ({ id }) => { /* remove that ghost */ });\\n  AIHub.on('time-up', () => report());                  // result() at once if not reported\\n  AIHub.on('end', () => { over = true; game.audio.stopMusic(); game.audio.mute(true); game.input.clear(); });\\n  await game.booted; AIHub.ready();                     // no key press\\n})();\\n```\\n\\n- **Card (yours, `card: true`):** the studio with the players lined up on mats, Tare hopping, the title, each player's name and colour with a ready tick, how to win, this player's controls, seconds left. While `AIHub.time() === -Infinity`: `confirm` or `start` → `AIHub.answer('ready')`, `more` (△) → `AIHub.answer('more')`, clicks on Ready/More too. No menus or choices on the card. Show \\\"More time\\\" state from the `card` event (`asked`, `paused`).\\n480→- **Clock:** all event timing comes from `AIHub.time()`, not `game.time`. A frame over 50 ms gives up its time, so a slow machine's game clock lags and would desync. Countdown while negative. Play at ≥ 0. If `info.limitMs` is shorter than the round, shrink the events.\\n- **Randomness:** every activity takes its disturbances from `AIHub.rng('e' + eventIndex)` (and a seeded `E.rng` offline). `Math.random` is only for cosmetics like particles and blinks, because copies draw it at different rates.\\n- **Ghost data:** `AIHub.send({ t: 'g', a: eventIndex, l: [x, y], p: phase, w: [wx, wy], s: score }, { reliable: false })` about 10 times a second. Draw only if `a` matches your current event. `r.actor(..., { alpha: .5 })`, name tag in seat colour. Names come from `info.players`, drawn with `E.font` only (never HTML). Limit: 20 messages/s.\\n- **Reporting:** `AIHub.progress({ score: total, label: total + ' pts' })` about once a second; at the end `AIHub.result({ score: total, stats: { Steadiness: '84%' }, awards: [{ title: 'Most Still', detail: '...' }] })` once.\\n- **In a session:** no title, attract, dev, quit, restart or saved progress. Options opens the settings over the running round (`live`). No chat, emotes or custom names. No other network. Engine already ignores Options while Create is held ✔.\\n\\n**Head tags (`build.mjs` writes them), in this order ✔:**\\n\\n```html\\n<meta charset=\\\"utf-8\\\">\\n490→<script>/* vendor/session.js, unmodified, first script in head */</script>\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover\\\">\\n<title>THE TITLE — a tagline</title>\\n<meta name=\\\"description\\\" content=\\\"one or two sentences\\\">\\n<meta name=\\\"theme-color\\\" content=\\\"#2cc6e6\\\">\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\"><meta name=\\\"hub:players\\\" content=\\\"1–4\\\"><meta name=\\\"hub:source\\\" content=\\\"Wii Fit\\\">\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"3\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Stay steadiest over 3 exercises; most points wins\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Lean: left stick, WASD or mouse. Breathe: R2, Space or click\\\">\\n500→```\\n\\n---\\n\\n## 15. Tech and setup\\n\\n**Stack:** the my-3D2dge full engine (2D views), its `mode7`, `road`, `physics`, `rhythm` modules (all inside `my-3d2dge.js`), `Mocap` and a cut clip set, the hub client. No World3D, no other libraries. **Start from no single kit:** this game mixes genres, so use the full engine with your own page, and read `engine/kits/road.js`, `kart.js`, `rhythm.js`, `pinball.js` (physics) and `sports.js` (joining players) when you build those parts.\",\"content_concise\":\"427→## 12. Attract Mode\\n\\nAfter **10 s with no input** on the title or any top-level menu (`game.hook('input', ...)`: `anyPressed`, stick, pointer movement). **Any input** returns to the title and swallows the press (`input.consumeAll()`).\\n430→\\nFiction: nobody's here, so Tare shows the empty room around. A \\\"DEMO\\\" chip, the logo in a corner, \\\"Press any button\\\" (by device), and subtitled lines: \\\"Nobody's here. I'll just show the room what we do.\\\" On exit: \\\"Oh! You're back. I wasn't doing anything.\\\"\\n\\n**Playlist, about 15 s each, looping:** Island walk → Body Check → Stork Stand → Sun Flow → Quiet Candle → Squat Rail → Push-Up → Side Lunge → Step Class → Hoop Hips → Coastal Jog → Slalom → Tray Service → Laundry Line → four-mat Class → results with Gerald's coins → Grand Stillness. Each runs the real activity scene with the expert bot filling `intent`, with cheats allowed (no stumbles). It never touches saves or unlocks. Use a Regular's rig as the star.\\n\\n---\\n\\n## 13. Dev Mode\\n\\nReachable from the pause menu (`menu.items`), in every scene, on every device. It closes the pause and docks a canvas panel on the left third **while the game keeps running**, so balance changes are felt live. D-pad up/down moves, left/right adjusts (held accelerates, L1/R1 coarse), ✕ activates, ○ closes. Arrows on keyboard (WASD keeps leaning). Mouse: drag sliders; the pointer over the panel does not lean.\\n440→\\n**Live sliders** (all in one `DEV` object with defaults; \\\"Reset to defaults\\\" restores it; each shows default vs current):\\n- Lean: `k c s A nf`, ring scale, push strength, stumble threshold, mouse reach, nudge rate\\n- Scoring: star thresholds, rep tolerance, rhythm window scale, fatigue amount\\n- Cardio: hoop band, jog cadence band, jog speed\\n- Games: slalom speed and turn, tray gravity and friction, rope instability, gust strength\\n- World: time scale (0, .25, .5, 1, 2), minutes multiplier\\n\\n**Tools:** jump to any scene/activity/tier/day; finish now with N stars; unlock all; +10 minutes; set Spine Age; reset this member; no stumbles; bot plays (poor/average/good/expert); show Plate trace and numbers; frame step; force attract; **Pose Viewer** (pick any clip, scrub, print a pose row for `game/data/poses.js`); log `game.debug.snapshot()` to the console. Hidden in a hub session.\\n\\n450→---\\n\\n## 14. Multiplayer\\n\\n**Class (local, on its own, 2 to 4).** From the title: join with Start on a free pad or 2 on the keyboard (`game.allowJoin({ max: 4, onJoin })`; `game.players[i]` has the same input API; keyboard players get `E.Input.halfKeys`). ✔ Half a keyboard runs out of keys with the full `INPUT` (the step and pace actions get none), so the Class scene sets its own `input`: the moves and menu actions plus `breath`, `catchL`, `catchR` only (left half F G H, right half `. / ,`), and its Step Class reads `lanes: ['left', 'down', 'up', 'right']`. Everyone gets a mat, a colour (`E.PLAYER_COLORS`) and a pre-made rig, on one fixed screen at size 1.5 with a small Plate under each. Activities: Stork Stand, Quiet Candle, Squat Rail, Step Class (two lanes), Hoop Hips, 35 s each, or \\\"Surprise me\\\" (3 rounds). So every class-capable activity takes a list of **contestants** from the start, not one player. Scores are 0 to 1000 (`round(pct × 1000)`). Results: podium with polite titles (Most Still, Best Wobble, Participated). Tare reads them. Empty mats hold Regulars driven by bots, for life, not for score.\\n\\n**AI Hub session (`ghost` mode, 1 to 4).** Follow the protocol README (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); it is short, read it. Outside a session the game is unaffected and `connect()` answers `null`. ✔ This exact shape passed the harness at 1, 2, 3 and 4 players, on the bad network, and with the host leaving.\\n\\n**The round: \\\"Morning Class\\\".** Everyone plays the same 3 events on their own copy, in lockstep, seeing others as translucent seat-coloured ghosts on neighbouring mats (or in the world for Slalom and Jog). About 150 s: each event is 5 s intro + 40 s play + 5 s scores. Deal with `AIHub.rng('deal')`: one from Stork/Candle/Squat/Push-Up, one from Step/Hoop, one from Slalom/Jog.\\n\\n460→```js\\nconst inSession = !!(window.AIHub && AIHub.active);\\nconst game = new E.Game({ canvas: 'screen', id: 'GAMEID', res: 'ps1', expand: true, touch: 'never', input: INPUT,\\n  autoPause: !inSession, live: inSession, fullscreen: inSession ? false : 'button',\\n  menu: { quit: inSession ? false : 'title', items: inSession ? [] : [/* Restart, Dev Mode */], settings: [/* section 11 */] } });\\ngame.start({ scenes, scene: inSession ? 'round' : 'title', boot: {/* steps */} });\\nif (inSession) (async () => {\\n  const info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\\n  if (!info) return game.go('title');\\n  AIHub.on('card', c => { card = c; });\\n470→  AIHub.on('start', () => {});\\n  AIHub.on('message', (d, from) => { /* ghost state */ });\\n  AIHub.on('leave', ({ id }) => { /* remove that ghost */ });\\n  AIHub.on('time-up', () => report());                  // result() at once if not reported\\n  AIHub.on('end', () => { over = true; game.audio.stopMusic(); game.audio.mute(true); game.input.clear(); });\\n  await game.booted; AIHub.ready();                     // no key press\\n})();\\n```\\n\\n- **Card (yours, `card: true`):** the studio with the players lined up on mats, Tare hopping, the title, each player's name and colour with a ready tick, how to win, this player's controls, seconds left. While `AIHub.time() === -Infinity`: `confirm` or `start` → `AIHub.answer('ready')`, `more` (△) → `AIHub.answer('more')`, clicks on Ready/More too. No menus or choices on the card. Show \\\"More time\\\" state from the `card` event (`asked`, `paused`).\\n480→- **Clock:** all event timing comes from `AIHub.time()`, not `game.time`. A frame over 50 ms gives up its time, so a slow machine's game clock lags and would desync. Countdown while negative. Play at ≥ 0. If `info.limitMs` is shorter than the round, shrink the events.\\n- **Randomness:** every activity takes its disturbances from `AIHub.rng('e' + eventIndex)` (and a seeded `E.rng` offline). `Math.random` is only for cosmetics like particles and blinks, because copies draw it at different rates.\\n- **Ghost data:** `AIHub.send({ t: 'g', a: eventIndex, l: [x, y], p: phase, w: [wx, wy], s: score }, { reliable: false })` about 10 times a second. Draw only if `a` matches your current event. `r.actor(..., { alpha: .5 })`, name tag in seat colour. Names come from `info.players`, drawn with `E.font` only (never HTML). Limit: 20 messages/s.\\n- **Reporting:** `AIHub.progress({ score: total, label: total + ' pts' })` about once a second; at the end `AIHub.result({ score: total, stats: { Steadiness: '84%' }, awards: [{ title: 'Most Still', detail: '...' }] })` once.\\n- **In a session:** no title, attract, dev, quit, restart or saved progress. Options opens the settings over the running round (`live`). No chat, emotes or custom names. No other network. Engine already ignores Options while Create is held ✔.\\n\\n**Head tags (`build.mjs` writes them), in this order ✔:**\\n\\n```html\\n<meta charset=\\\"utf-8\\\">\\n490→<script>/* vendor/session.js, unmodified, first script in head */</script>\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover\\\">\\n<title>THE TITLE — a tagline</title>\\n<meta name=\\\"description\\\" content=\\\"one or two sentences\\\">\\n<meta name=\\\"theme-color\\\" content=\\\"#2cc6e6\\\">\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\"><meta name=\\\"hub:players\\\" content=\\\"1–4\\\"><meta name=\\\"hub:source\\\" content=\\\"Wii Fit\\\">\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"3\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Stay steadiest over 3 exercises; most points wins\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Lean: left stick, WASD or mouse. Breathe: R2, Space or click\\\">\\n500→```\\n\\n---\\n\\n## 15. Tech and setup\\n\\n**Stack:** the my-3D2dge full engine (2D views), its `mode7`, `road`, `physics`, `rhythm` modules (all inside `my-3d2dge.js`), `Mocap` and a cut clip set, the hub client. No World3D, no other libraries. **Start from no single kit:** this game mixes genres, so use the full engine with your own page, and read `engine/kits/road.js`, `kart.js`, `rhythm.js`, `pinball.js` (physics) and `sports.js` (joining players) when you build those parts.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/PLAN.md\",\"offset\":427,\"limit\":80,\"raw_output\":\"## 12. Attract Mode\\n\\nAfter **10 s with no input** on the title or any top-level menu (`game.hook('input', ...)`: `anyPressed`, stick, pointer movement). **Any input** returns to the title and swallows the press (`input.consumeAll()`).\\n\\nFiction: nobody's here, so Tare shows the empty room around. A \\\"DEMO\\\" chip, the logo in a corner, \\\"Press any button\\\" (by device), and subtitled lines: \\\"Nobody's here. I'll just show the room what we do.\\\" On exit: \\\"Oh! You're back. I wasn't doing anything.\\\"\\n\\n**Playlist, about 15 s each, looping:** Island walk → Body Check → Stork Stand → Sun Flow → Quiet Candle → Squat Rail → Push-Up → Side Lunge → Step Class → Hoop Hips → Coastal Jog → Slalom → Tray Service → Laundry Line → four-mat Class → results with Gerald's coins → Grand Stillness. Each runs the real activity scene with the expert bot filling `intent`, with cheats allowed (no stumbles). It never touches saves or unlocks. Use a Regular's rig as the star.\\n\\n---\\n\\n## 13. Dev Mode\\n\\nReachable from the pause menu (`menu.items`), in every scene, on every device. It closes the pause and docks a canvas panel on the left third **while the game keeps running**, so balance changes are felt live. D-pad up/down moves, left/right adjusts (held accelerates, L1/R1 coarse), ✕ activates, ○ closes. Arrows on keyboard (WASD keeps leaning). Mouse: drag sliders; the pointer over the panel does not lean.\\n\\n**Live sliders** (all in one `DEV` object with defaults; \\\"Reset to defaults\\\" restores it; each shows default vs current):\\n- Lean: `k c s A nf`, ring scale, push strength, stumble threshold, mouse reach, nudge rate\\n- Scoring: star thresholds, rep tolerance, rhythm window scale, fatigue amount\\n- Cardio: hoop band, jog cadence band, jog speed\\n- Games: slalom speed and turn, tray gravity and friction, rope instability, gust strength\\n- World: time scale (0, .25, .5, 1, 2), minutes multiplier\\n\\n**Tools:** jump to any scene/activity/tier/day; finish now with N stars; unlock all; +10 minutes; set Spine Age; reset this member; no stumbles; bot plays (poor/average/good/expert); show Plate trace and numbers; frame step; force attract; **Pose Viewer** (pick any clip, scrub, print a pose row for `game/data/poses.js`); log `game.debug.snapshot()` to the console. Hidden in a hub session.\\n\\n---\\n\\n## 14. Multiplayer\\n\\n**Class (local, on its own, 2 to 4).** From the title: join with Start on a free pad or 2 on the keyboard (`game.allowJoin({ max: 4, onJoin })`; `game.players[i]` has the same input API; keyboard players get `E.Input.halfKeys`). ✔ Half a keyboard runs out of keys with the full `INPUT` (the step and pace actions get none), so the Class scene sets its own `input`: the moves and menu actions plus `breath`, `catchL`, `catchR` only (left half F G H, right half `. / ,`), and its Step Class reads `lanes: ['left', 'down', 'up', 'right']`. Everyone gets a mat, a colour (`E.PLAYER_COLORS`) and a pre-made rig, on one fixed screen at size 1.5 with a small Plate under each. Activities: Stork Stand, Quiet Candle, Squat Rail, Step Class (two lanes), Hoop Hips, 35 s each, or \\\"Surprise me\\\" (3 rounds). So every class-capable activity takes a list of **contestants** from the start, not one player. Scores are 0 to 1000 (`round(pct × 1000)`). Results: podium with polite titles (Most Still, Best Wobble, Participated). Tare reads them. Empty mats hold Regulars driven by bots, for life, not for score.\\n\\n**AI Hub session (`ghost` mode, 1 to 4).** Follow the protocol README (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); it is short, read it. Outside a session the game is unaffected and `connect()` answers `null`. ✔ This exact shape passed the harness at 1, 2, 3 and 4 players, on the bad network, and with the host leaving.\\n\\n**The round: \\\"Morning Class\\\".** Everyone plays the same 3 events on their own copy, in lockstep, seeing others as translucent seat-coloured ghosts on neighbouring mats (or in the world for Slalom and Jog). About 150 s: each event is 5 s intro + 40 s play + 5 s scores. Deal with `AIHub.rng('deal')`: one from Stork/Candle/Squat/Push-Up, one from Step/Hoop, one from Slalom/Jog.\\n\\n```js\\nconst inSession = !!(window.AIHub && AIHub.active);\\nconst game = new E.Game({ canvas: 'screen', id: 'GAMEID', res: 'ps1', expand: true, touch: 'never', input: INPUT,\\n  autoPause: !inSession, live: inSession, fullscreen: inSession ? false : 'button',\\n  menu: { quit: inSession ? false : 'title', items: inSession ? [] : [/* Restart, Dev Mode */], settings: [/* section 11 */] } });\\ngame.start({ scenes, scene: inSession ? 'round' : 'title', boot: {/* steps */} });\\nif (inSession) (async () => {\\n  const info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\\n  if (!info) return game.go('title');\\n  AIHub.on('card', c => { card = c; });\\n  AIHub.on('start', () => {});\\n  AIHub.on('message', (d, from) => { /* ghost state */ });\\n  AIHub.on('leave', ({ id }) => { /* remove that ghost */ });\\n  AIHub.on('time-up', () => report());                  // result() at once if not reported\\n  AIHub.on('end', () => { over = true; game.audio.stopMusic(); game.audio.mute(true); game.input.clear(); });\\n  await game.booted; AIHub.ready();                     // no key press\\n})();\\n```\\n\\n- **Card (yours, `card: true`):** the studio with the players lined up on mats, Tare hopping, the title, each player's name and colour with a ready tick, how to win, this player's controls, seconds left. While `AIHub.time() === -Infinity`: `confirm` or `start` → `AIHub.answer('ready')`, `more` (△) → `AIHub.answer('more')`, clicks on Ready/More too. No menus or choices on the card. Show \\\"More time\\\" state from the `card` event (`asked`, `paused`).\\n- **Clock:** all event timing comes from `AIHub.time()`, not `game.time`. A frame over 50 ms gives up its time, so a slow machine's game clock lags and would desync. Countdown while negative. Play at ≥ 0. If `info.limitMs` is shorter than the round, shrink the events.\\n- **Randomness:** every activity takes its disturbances from `AIHub.rng('e' + eventIndex)` (and a seeded `E.rng` offline). `Math.random` is only for cosmetics like particles and blinks, because copies draw it at different rates.\\n- **Ghost data:** `AIHub.send({ t: 'g', a: eventIndex, l: [x, y], p: phase, w: [wx, wy], s: score }, { reliable: false })` about 10 times a second. Draw only if `a` matches your current event. `r.actor(..., { alpha: .5 })`, name tag in seat colour. Names come from `info.players`, drawn with `E.font` only (never HTML). Limit: 20 messages/s.\\n- **Reporting:** `AIHub.progress({ score: total, label: total + ' pts' })` about once a second; at the end `AIHub.result({ score: total, stats: { Steadiness: '84%' }, awards: [{ title: 'Most Still', detail: '...' }] })` once.\\n- **In a session:** no title, attract, dev, quit, restart or saved progress. Options opens the settings over the running round (`live`). No chat, emotes or custom names. No other network. Engine already ignores Options while Create is held ✔.\\n\\n**Head tags (`build.mjs` writes them), in this order ✔:**\\n\\n```html\\n<meta charset=\\\"utf-8\\\">\\n<script>/* vendor/session.js, unmodified, first script in head */</script>\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover\\\">\\n<title>THE TITLE — a tagline</title>\\n<meta name=\\\"description\\\" content=\\\"one or two sentences\\\">\\n<meta name=\\\"theme-color\\\" content=\\\"#2cc6e6\\\">\\n<meta name=\\\"hub:type\\\" content=\\\"Game\\\"><meta name=\\\"hub:players\\\" content=\\\"1–4\\\"><meta name=\\\"hub:source\\\" content=\\\"Wii Fit\\\">\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\">\\n<meta name=\\\"hub:session-minutes\\\" content=\\\"3\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"Stay steadiest over 3 exercises; most points wins\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"Lean: left stick, WASD or mouse. Breathe: R2, Space or click\\\">\\n```\\n\\n---\\n\\n## 15. Tech and setup\\n\\n**Stack:** the my-3D2dge full engine (2D views), its `mode7`, `road`, `physics`, `rhythm` modules (all inside `my-3d2dge.js`), `Mocap` and a cut clip set, the hub client. No World3D, no other libraries. **Start from no single kit:** this game mixes genres, so use the full engine with your own page, and read `engine/kits/road.js`, `kart.js`, `rhythm.js`, `pinball.js` (physics) and `sports.js` (joining players) when you build those parts.\\n\",\"total_lines\":655}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"81609e99-e981-4495-a4f4-e9a23a072f70"}
{"type":"assistant","message":{"id":"msg_574","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Checking whether per-player input is wired in CLASS_INPUT and the class play update.","signature":"uhWONFzRFmLmNBVepzBOb3ApY6OBSiE9BuFje/yTSZkRGvd3F8QfvDiGHwZB311o2JwHkfXXqa83y3zQXlJuwwa+iLR1/jFL5Q6CEWs/X8kqPQRGj75zp7Quj9NicKZPQxLgChMnWqXBFZsNsLoNJhzkKqaVfzzMA3Ics49k35LMddbhZ/HGtZ2W6o6o+URHre7XvxFRKurk1vU2rw"},{"type":"tool_use","id":"call-0b3f99bd-dfe7-41d3-8013-48f8aea81ac7-45","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js","offset":1,"limit":50}},{"type":"tool_use","id":"call-0b3f99bd-dfe7-41d3-8013-48f8aea81ac7-46","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js","offset":810,"limit":200}},{"type":"tool_use","id":"call-0b3f99bd-dfe7-41d3-8013-48f8aea81ac7-47","name":"grep","input":{"pattern":"function readLean|padMove|players","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/boot.js"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4158,"output_tokens":292,"cache_read_input_tokens":114432,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"e93275fe-e13a-48f6-8959-f83ea9763b3a"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-0b3f99bd-dfe7-41d3-8013-48f8aea81ac7-45","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/* Story, profile, saves, class, hub round, attract, and about. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const D = E.Input.DEFAULT;\\n  G.INPUT = {\\n    up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\\n    confirm: D.confirm, cancel: D.cancel,\\n10→    breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'],\\n    jump: ['Space', 'Pad0'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'],\\n    paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'],\\n    stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'],\\n    stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown']\\n  };\\n  /* Class keeps the menu actions, then breath, catchL, catchR so half a keyboard lands on F G H and . / , */\\n  G.CLASS_INPUT = {\\n    up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\\n    confirm: D.confirm, cancel: D.cancel,\\n20→    breath: ['KeyF', 'Pad6', 'Pad7'], catchL: ['KeyG', 'Pad4'], catchR: ['KeyH', 'Pad5']\\n  };\\n\\n  G.seen = {};\\n  G.phase = 'menu';\\n  G.left = 0;\\n  G.subtitle = '';\\n  G.driver = null;\\n  G.attracting = false;\\n  G.inSession = false;\\n30→  G.idleSteps = 0;\\n  G.queue = null;\\n  G.chainAfter = null;\\n  G.hubOver = false;\\n  G.hubReported = false;\\n  G.ghosts = [];\\n  G.ABOUT = /*ABOUT*/null;\\n\\n  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\\n\\n40→  G.freshProfile = function (slot) {\\n    return {\\n      slot: slot || 0,\\n      name: G.NICKS[0],\\n      nickIndex: 0,\\n      look: { hair: 0, skin: 1, top: 0, bottom: 0 },\\n      instructor: 'Birch',\\n      day: 1,\\n      sessions: 0,\\n      played: {},\\n50→      bestPct: {},\",\"content_concise\":\"1→/* Story, profile, saves, class, hub round, attract, and about. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const D = E.Input.DEFAULT;\\n  G.INPUT = {\\n    up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\\n    confirm: D.confirm, cancel: D.cancel,\\n10→    breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'],\\n    jump: ['Space', 'Pad0'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'],\\n    paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'],\\n    stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'],\\n    stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown']\\n  };\\n  /* Class keeps the menu actions, then breath, catchL, catchR so half a keyboard lands on F G H and . / , */\\n  G.CLASS_INPUT = {\\n    up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\\n    confirm: D.confirm, cancel: D.cancel,\\n20→    breath: ['KeyF', 'Pad6', 'Pad7'], catchL: ['KeyG', 'Pad4'], catchR: ['KeyH', 'Pad5']\\n  };\\n\\n  G.seen = {};\\n  G.phase = 'menu';\\n  G.left = 0;\\n  G.subtitle = '';\\n  G.driver = null;\\n  G.attracting = false;\\n  G.inSession = false;\\n30→  G.idleSteps = 0;\\n  G.queue = null;\\n  G.chainAfter = null;\\n  G.hubOver = false;\\n  G.hubReported = false;\\n  G.ghosts = [];\\n  G.ABOUT = /*ABOUT*/null;\\n\\n  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\\n\\n40→  G.freshProfile = function (slot) {\\n    return {\\n      slot: slot || 0,\\n      name: G.NICKS[0],\\n      nickIndex: 0,\\n      look: { hair: 0, skin: 1, top: 0, bottom: 0 },\\n      instructor: 'Birch',\\n      day: 1,\\n      sessions: 0,\\n      played: {},\\n50→      bestPct: {},\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js\",\"offset\":1,\"limit\":50,\"raw_output\":\"/* Story, profile, saves, class, hub round, attract, and about. */\\nvar G = G || {};\\n(function () {\\n  'use strict';\\n  const E = My3D2dge;\\n  const D = E.Input.DEFAULT;\\n  G.INPUT = {\\n    up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\\n    confirm: D.confirm, cancel: D.cancel,\\n    breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'],\\n    jump: ['Space', 'Pad0'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'],\\n    paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'],\\n    stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'],\\n    stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown']\\n  };\\n  /* Class keeps the menu actions, then breath, catchL, catchR so half a keyboard lands on F G H and . / , */\\n  G.CLASS_INPUT = {\\n    up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\\n    confirm: D.confirm, cancel: D.cancel,\\n    breath: ['KeyF', 'Pad6', 'Pad7'], catchL: ['KeyG', 'Pad4'], catchR: ['KeyH', 'Pad5']\\n  };\\n\\n  G.seen = {};\\n  G.phase = 'menu';\\n  G.left = 0;\\n  G.subtitle = '';\\n  G.driver = null;\\n  G.attracting = false;\\n  G.inSession = false;\\n  G.idleSteps = 0;\\n  G.queue = null;\\n  G.chainAfter = null;\\n  G.hubOver = false;\\n  G.hubReported = false;\\n  G.ghosts = [];\\n  G.ABOUT = /*ABOUT*/null;\\n\\n  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\\n\\n  G.freshProfile = function (slot) {\\n    return {\\n      slot: slot || 0,\\n      name: G.NICKS[0],\\n      nickIndex: 0,\\n      look: { hair: 0, skin: 1, top: 0, bottom: 0 },\\n      instructor: 'Birch',\\n      day: 1,\\n      sessions: 0,\\n      played: {},\\n      bestPct: {},\\n\",\"total_lines\":1171}}","is_error":false},{"type":"tool_result","tool_use_id":"call-0b3f99bd-dfe7-41d3-8013-48f8aea81ac7-46","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"810→\\n  scenes.class = base({\\n    input: G.CLASS_INPUT,\\n    enter(d) {\\n      d = d || {};\\n      G.phase = 'menu';\\n      G.driver = null;\\n      G.podium = null;\\n      const g = G.game;\\n      if (g.headless && g.players.length < 2) { try { g.addPlayer({ keys: 'right' }); } catch (e) { /* one mat */ } }\\n820→      try { g.allowJoin({ max: 4 }); } catch (e) { /* already open */ }\\n      const acts = ['stork', 'candle', 'squat', 'step', 'hoop'];\\n      const items = acts.map(function (id) { return { label: G.ACTS[id].name, id: id }; });\\n      items.push({ label: 'Surprise me', id: 'surprise' });\\n      scenes.class._pills = new G.Pills(items, { i: 0 });\\n      scenes.class._podium = null;\\n      if (d.id) scenes.class.begin(d.id);\\n    },\\n    begin(id) {\\n      const seats = [];\\n830→      const players = G.game.players || [G.game.input];\\n      const n = Math.max(players.length, 2);\\n      for (let i = 0; i < n && i < 4; i++) {\\n        const local = i < players.length;\\n        const headlessBot = !!(G.game.headless && local);\\n        seats.push({\\n          name: local ? ('P' + (i + 1)) : 'Regular',\\n          color: (E.PLAYER_COLORS && E.PLAYER_COLORS[i]) || '#4a8aff',\\n          local: local,\\n          human: local && !headlessBot,\\n840→          skill: local ? (headlessBot ? 'good' : null) : 'average',\\n          scoring: !!local,\\n          botFill: !local || headlessBot\\n        });\\n      }\\n      scenes.class._seats = seats;\\n      G.session = new G.Session({\\n        id: id, tier: 1, limit: 35, skipToPlay: true, classMode: true, trial: true,\\n        seats: seats, seed: 8\\n      });\\n850→      scenes.class._podium = null;\\n      G.phase = 'auto';\\n    },\\n    exit() {\\n      const g = G.game;\\n      if (!g) return;\\n      try { g.allowJoin(false); } catch (e) { /* quiet */ }\\n      while (g.players.length > 1) { try { g.removePlayer(g.players[g.players.length - 1]); } catch (e) { break; } }\\n    },\\n    update(dt) {\\n860→      const s = G.session;\\n      if (!s) {\\n        G.phase = 'menu';\\n        if (scenes.class._podium) {\\n          if (G.game.input.pressed('confirm') || G.game.input.pressed('cancel')) go('title');\\n          return;\\n        }\\n        const it = scenes.class._pills.update(G.game.input);\\n        if (!it) return;\\n        if (it.id === 'surprise') {\\n870→          G.queue = ['candle', 'hoop'];\\n          G.chainAfter = function () { scenes.class._podium = true; G.session = null; };\\n          scenes.class.begin('stork');\\n        } else scenes.class.begin(it.id);\\n        return;\\n      }\\n      s.update(dt);\\n      if (s.phase === 'results') {\\n        G.phase = 'menu';\\n        if (!scenes.class._shown) {\\n880→          scenes.class._shown = true;\\n          scenes.class._scores = s.seats.map(function (q) { return q.score || 0; });\\n        }\\n        if (G.game.input.pressed('confirm')) {\\n          scenes.class._shown = false;\\n          if (G.queue && G.queue.length) { const id = G.queue.shift(); scenes.class.begin(id); }\\n          else {\\n            const seats = s.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n            G.podium = seats.map(function (q, i) {\\n              return { title: G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)], name: q.name, score: q.score || 0 };\\n890→            });\\n            G.session = null;\\n            scenes.class._podium = true;\\n          }\\n        }\\n      } else G.phase = s.phase === 'play' ? 'play' : 'auto';\\n    },\\n    draw(r) {\\n      G.paintRoom(r, 'day');\\n      if (!G.session) {\\n900→        if (scenes.class._podium && G.podium) {\\n          hudName(r, 'Podium', 'Tare reads the polite titles.');\\n          r.overlay(function (g) {\\n            G.podium.forEach(function (q, i) {\\n              G.text(g, q.title + '  ' + q.name + '  ' + q.score, 16, 78 + i * 16, '#20404c', 1);\\n            });\\n          });\\n          return;\\n        }\\n        hudName(r, 'Local Class', 'Mats for whoever came.');\\n910→        scenes.class._pills.draw(r);\\n        return;\\n      }\\n      try { G.drawActivity(r, G.session); } catch (e) { /* room */ }\\n      if (G.session.phase === 'results') {\\n        r.overlay(function (g) {\\n          const seats = G.session.seats.slice().sort(function (a, b) { return (b.score || 0) - (a.score || 0); });\\n          seats.forEach(function (q, i) {\\n            const title = G.LINES.podium[Math.min(i, G.LINES.podium.length - 1)];\\n            G.text(g, title + '  ' + q.name + '  ' + (q.score || 0), 16, 78 + i * 16, '#20404c', 1);\\n920→          });\\n        });\\n      }\\n    }\\n  });\\n\\n  G.hubSendAcc = 0;\\n  G.hubProgAcc = 0;\\n  G.morningEvents = null;\\n  G.morningScores = [0, 0, 0];\\n930→\\n  function hubApi() { return (typeof AIHub !== 'undefined') ? AIHub : null; }\\n\\n  G.hubTimeUp = function () {\\n    if (G.hubReported) return;\\n    G.hubReported = true;\\n    const api = hubApi();\\n    if (!api || !api.result) return;\\n    const total = Math.round(G.morningScores.reduce(function (a, b) { return a + b; }, 0));\\n    try {\\n940→      api.result({\\n        score: total,\\n        stats: { Steadiness: Math.round((G.morningScores[0] || 0) / 10) + '%' },\\n        awards: [{ title: 'Most Still', detail: 'A quiet morning.' }]\\n      });\\n    } catch (e) { /* the hub already closed */ }\\n  };\\n  G.hubEnd = function () {\\n    G.hubOver = true;\\n    try { if (G.game) { G.game.audio.stopMusic(); G.game.audio.mute(true); G.game.input.clear(); } } catch (e) { /* quiet */ }\\n950→  };\\n\\n  scenes.round = base({\\n    enter() {\\n      G.hubOver = false;\\n      G.hubReported = false;\\n      G.ghosts = [];\\n      G.morningScores = [0, 0, 0];\\n      G.hubSendAcc = 0;\\n      G.hubProgAcc = 1;\\n960→      G.session = null;\\n      scenes.round.dealt = false;\\n      scenes.round.ei = -1;\\n      try { G.playSong('studio'); } catch (e) { /* quiet */ }\\n    },\\n    update(dt) {\\n      if (G.hubOver) { G.phase = 'auto'; return; }\\n      const api = hubApi();\\n      const live = !!(api && G.inSession && api.time);\\n      const tms = live ? api.time() : (scenes.round.local = (scenes.round.local || 0) + dt * 1000);\\n970→      if (live && tms === -Infinity) {\\n        G.phase = 'menu';\\n        const I = G.game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) { try { api.answer('ready'); } catch (e) { /* early */ } }\\n        if (I.pressed('more')) { try { api.answer('more'); } catch (e) { /* early */ } }\\n        return;\\n      }\\n      if (tms < 0) { G.phase = 'auto'; G.left = Math.max(0, -tms / 1000); return; }\\n      if (!scenes.round.dealt) {\\n        let rng = E.rng(7);\\n980→        try { if (live && api.rng) rng = api.rng('deal'); } catch (e) { rng = E.rng(7); }\\n        G.morningEvents = G.deal(rng);\\n        scenes.round.dealt = true;\\n      }\\n      const span = 50;\\n      const ev = Math.min(2, Math.floor(tms / 1000 / span));\\n      const local = (tms / 1000) - ev * span;\\n      if (ev !== scenes.round.ei) {\\n        scenes.round.ei = ev;\\n        const id = G.morningEvents[ev];\\n990→        try {\\n          G.session = new G.Session({ id: id, tier: 1, limit: 40, skipToPlay: true, trial: true, driver: 'good', seed: 20 + ev });\\n          G.driver = 