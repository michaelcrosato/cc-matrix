=== Math.floor(fam.planned * 0.6) && !store.fatigued) {\"},{\"line_number\":374,\"content\":\"    const cyc = Math.floor(fam.t / fam.cycle);\"},{\"line_number\":381,\"content\":\"      if (primary && store.doneReps === fam.planned && !fam.extra) {\"},{\"line_number\":383,\"content\":\"        if (mean > 0.8) { fam.extra = true; fam.planned += 2; sess.limit += fam.cycle * 2; }\"},{\"line_number\":392,\"content\":\"    if (primary && store.doneReps >= fam.planned && store.scores.length >= fam.planned) sess.ended = true;\"},{\"line_number\":400,\"content\":\"    fam.side = (Math.floor(fam.t / fam.cycle) % 2 === 0) ? 1 : -1;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"4b064ffa-db7c-4cb6-888b-b214e28e02ca"}
