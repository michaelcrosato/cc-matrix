/** world position of a hand ('R' holds the weapon): spawn bullets, sparks or thrown things here */\"},{\"line_number\":7571,\"content\":\" *    plane 'ground' (top-down: bullets fly over x/y) or 'side' (side-scrollers: x/z).\"},{\"line_number\":7578,\"content\":\"   *  bullets; max: at most this many at once; plane: 'ground' (they fly over x and y) or 'side' (x and z); sparks: a\"},{\"line_number\":7581,\"content\":\"  /** fire one bullet. Fields: x, y, z, vx, vy, vz, r, dmg, life, team, color, core, sprite, pierce, grav, data */\"},{\"line_number\":7602,\"content\":\"  /** test bullets of `team` against targets (objects with x, y, z and r, or w/h in side view). fn(bullet, target). Returns hits */\"},{\"line_number\":7619,\"content\":\"  /** remove every bullet, or only one team's */\"},{\"line_number\":7635,\"content\":\"/** velocity helpers for bullet patterns. Angles in radians (0 = east / right). Each returns [vx, v2] or a list of them */\"},{\"line_number\":7643,\"content\":\"  /** n bullets fanned across `arc` radians around `angle` */\"},{\"line_number\":7645,\"content\":\"  /** n bullets in a full circle, rotated by offset */\"},{\"line_number\":7650,\"content\":\" * 19. SPATIAL HASH  find nearby things fast (crowds, bullets vs many enemies)\"},{\"line_number\":8946,\"content\":\"  // a raised solid counts only from what reaches it (a crate on a shelf is not a wall to a bullet under the shelf): passes until none adds\"},{\"line_number\":12771,\"content\":\"- Bodies: world.circle(x, y, r, o), world.box(x, y, w, h, o), world.poly(x, y, points, o) (convex, points round x, y)\"},{\"line_number\":12777,\"content\":\"  no push), bullet (a fast circle: swept, so it stops at what it would pass through), kick (a bumper's or slingshot's:\"},{\"line_number\":12797,\"content\":\"const L = world.flipper(40, 170, { side: 'left' }), ball = world.circle(64, 150, 5, { bullet: true, bounce: .4 });\"},{\"line_number\":12801,\"content\":\"const shot = world.circle(80, 100, 4, { bullet: true, vx: 9000 }); for (let i = 0; i < 30; i++) world.step(1 / 120);\"},{\"line_number\":12804,\"content\":\"Rules: step it from the game's fixed step only (the same steps give the same world); a fast ball is a bullet; keep\"},{\"line_number\":12830,\"content\":\"    Object.assign(this, { type: 'dynamic', shape: 'circle', x: 0, y: 0, angle: 0, vx: 0, vy: 0, spin: 0, r: 0, bounce: .3, friction: .4, damping: 0, layer: 1, mask: 0xffff, sensor: false, bullet: false, off: false, kick: 0, gravity: 1, maxSpeed: 0, data: null }, d);\"},{\"line_number\":12987,\"content\":\"    for (let i = 0; i < B.length; i++) { const b = B[i]; if (b.bullet && !b.local && b.type === 'dynamic' && !b.sleeping && !b.held && !b.off) F[i] = this._toi(b, h); }\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/play.js\",\"matches\":[{\"line_number\":184,\"content\":\"  function loadTray(sess) {\"},{\"line_number\":193,\"content\":\"    spec.bumps.forEach(function (b) { world.circle(b.x, b.y, b.r, { type: 'static', bounce: 0.4, friction: 0.2 }); });\"},{\"line_number\":195,\"content\":\"    const sensor = world.circle(glass.x, glass.y, Math.max(glass.r, 22), { type: 'static', sensor: true });\"},{\"line_number\":198,\"content\":\"      const b = world.circle(o.x, o.y, 6, { friction: 0.15, damping: 1.6, bounce: 0.05, density: 0.02 });\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge-agent.js\",\"matches\":[{\"line_number\":215,\"content\":\"  color, life: 3, dmg, pierce, sprite }); burst(base, velocities); update(dt, map) (bullets die on walls);\"},{\"line_number\":227,\"content\":\"  rig.draw(g, ox, oy, r.view) inside r.actor; rig.hand(), rig.tip() -> world points to spawn bullets; rig.kick(v) squash\"},{\"line_number\":351,\"content\":\"   with gravity 800, dash 200-260, player bullets 250-320, enemy bullets 70-120, enemies 25-45.\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/src/assets/sets/kenney-tiny-battle.js\",\"matches\":[{\"line_number\":205,\"content\":\"'tile-0191': {about:'gold bullet cartridge, ammo icon',tags:'ui icon ammo battle',rows:['................','................','................','................','...000000000....','...0000000000...','...00bfbb4500...','...00bbbb4400...','...00bbbb4400...','...00bfbb4500...','...0000000000...','...000000000....','................','................','................','................'],colors:{0:'#3f2631',4:'#c0cbdc',5:'#8b9bb4',b:'#ffcd65',f:'#c56e33'},src:'kenney-tiny-battle',orig:'Tiles/tile_0191.png',fit:0},\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/kits/animlab.js\",\"matches\":[{\"line_number\":282,\"content\":\"  const shots = new E.Bullets(game, { plane: 'ground' });            // spells, thrown knives and bullets\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/modules/physics.js\",\"matches\":[{\"line_number\":11,\"content\":\"- Bodies: world.circle(x, y, r, o), world.box(x, y, w, h, o), world.poly(x, y, points, o) (convex, points round x, y)\"},{\"line_number\":17,\"content\":\"  no push), bullet (a fast circle: swept, so it stops at what it would pass through), kick (a bumper's or slingshot's:\"},{\"line_number\":37,\"content\":\"const L = world.flipper(40, 170, { side: 'left' }), ball = world.circle(64, 150, 5, { bullet: true, bounce: .4 });\"},{\"line_number\":41,\"content\":\"const shot = world.circle(80, 100, 4, { bullet: true, vx: 9000 }); for (let i = 0; i < 30; i++) world.step(1 / 120);\"},{\"line_number\":44,\"content\":\"Rules: step it from the game's fixed step only (the same steps give the same world); a fast ball is a bullet; keep\"},{\"line_number\":70,\"content\":\"    Object.assign(this, { type: 'dynamic', shape: 'circle', x: 0, y: 0, angle: 0, vx: 0, vy: 0, spin: 0, r: 0, bounce: .3, friction: .4, damping: 0, layer: 1, mask: 0xffff, sensor: false, bullet: false, off: false, kick: 0, gravity: 1, maxSpeed: 0, data: null }, d);\"},{\"line_number\":227,\"content\":\"    for (let i = 0; i < B.length; i++) { const b = B[i]; if (b.bullet && !b.local && b.type === 'dynamic' && !b.sleeping && !b.held && !b.off) F[i] = this._toi(b, h); }\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/kits/pinball.js\",\"matches\":[{\"line_number\":171,\"content\":\" * mouth; the ball a swept bullet, so it never passes through. E.Arcade keeps the score, the balls and the table. bot()\"},{\"line_number\":211,\"content\":\"    for (const x of [70, 98, 126, 154]) world.circle(x, 62, 3, { type: 'static', bounce: .4 });\"},{\"line_number\":212,\"content\":\"    lanes = [84, 112, 140].map(x => ({ s: world.circle(x, 68, 5, { type: 'static', sensor: true }), on: false }));\"},{\"line_number\":216,\"content\":\"    F.laneTop = world.circle(170, 34, 10, { type: 'static', sensor: true });\"},{\"line_number\":220,\"content\":\"    F.rampIn = world.circle(176, 296, 6, { type: 'static', sensor: true, layer: 3 }); F.rampOut = world.circle(40, 304, 7, { type: 'static', sensor: true, layer: 3 });\"},{\"line_number\":229,\"content\":\"    const b = world.circle(223, 488, BR, { bullet: true, bounce: .35, friction: .25, maxSpeed: 1600 }); b.z = 0; b.onRamp = false; balls.push(b);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/kits/shooter.js\",\"matches\":[{\"line_number\":163,\"content\":\" * ground 0-3, air shadows 4, clouds 5-6, aircraft 8-12, air blasts 14, ship bullets 20; foe bullets over every panel.\"},{\"line_number\":410,\"content\":\"      // telegraphs: a glow swells and a ring closes in on each charging gun (in its bullets' color); the wing guns light their lines of fire\"},{\"line_number\":457,\"content\":\"  // bullets by team: a shape per kind, each with an additive halo\"},{\"line_number\":460,\"content\":\"  function bullets(g, r, team) {\"},{\"line_number\":619,\"content\":\"    if (ship.respawn <= 0) shots.hit([ship], hitShip, 'foe');   // the shield soaks up bullets\"},{\"line_number\":646,\"content\":\"    if (f.art?.[4] && f.fire > 0 && f.fire < TELL && t > INTRO) r.queue(f.x, f.y, z + .4, g => {   // the fire tell: like the boss guns, a glow swells and a ring closes in (bullet color)\"},{\"line_number\":683,\"content\":\"    r.queue(0, scroll, 20, g => bullets(g, r, 'ship'));\"},{\"line_number\":684,\"content\":\"    r.overlay(hud); talk.draw(r); r.overlay(g => bullets(g, r, 'foe'));   // never hidden by a panel\"},{\"line_number\":888,\"content\":\"    // least danger over the next half second (the rock, foe bullets and foes where they will be), drawn to a third of the\"},{\"line_number\":947,\"content\":\"        bullets(g, r, 'ship');\"},{\"line_number\":950,\"content\":\"      r.overlay(g => hudH(g, r)); talk.draw(r); r.overlay(g => bullets(g, r, 'foe'));\"},{\"line_number\":995,\"content\":\"    camera: { zoom: false },   // the playfield is the whole screen: zooming in would hide bullets and push the ship off the bottom\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"30b41287-b0ef-4985-93ce-9589fe4ba47b"}
