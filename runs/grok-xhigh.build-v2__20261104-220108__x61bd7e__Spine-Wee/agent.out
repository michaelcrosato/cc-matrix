:1fr minmax(92px,auto) minmax(92px,auto);gap:6px 10px;align-items:center;margin-top:8px}.esh-bind small{color:var(--muted);font-size:10px;letter-spacing:.14em;text-transform:uppercase;text-align:center}\"},{\"line_number\":9423,\"content\":\"   * - settings: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max,\"},{\"line_number\":9730,\"content\":\"    const acts = (name === 'pause' ? [['Resume', () => this.hide()]] : []).concat(v(s.actions) || [], name === 'pause' && this._std && v(this._game.o.menu && this._game.o.menu.items) || []).filter(Boolean);\"},{\"line_number\":10868,\"content\":\"  items: { key: { name: 'KEY' } }, room: 'yard', at: [20, 150] });\"},{\"line_number\":10954,\"content\":\"    /** game: the game; rooms: the rooms by id; items: the items by id; rules: the rules (data); on: its events */\"},{\"line_number\":11199,\"content\":\"  (the track's half: the drivers' lanes), items: ['boost', 'shot', 'hazard'] }); race.grid(n) -> the start places\"},{\"line_number\":11304,\"content\":\"    this.o = Object.assign({ laps: 3, checkpoints: 8, countdown: 3, width: 40, items: ['boost', 'shot', 'hazard'] }, o);\"},{\"line_number\":12604,\"content\":\"     *  items: the billboards gathered for the next draw */\"},{\"line_number\":13685,\"content\":\"- const rpg = new E.RPG({ items, monsters, status, curve }). items: { id: { name, kind: 'use' | 'weapon' | 'armor' |\"},{\"line_number\":13714,\"content\":\"const E = My3D2dge, rpg = new E.RPG({ items: { potion: { name: 'Potion', kind: 'use', heal: 30, price: 10 }, sword: { name: 'Sword', kind: 'weapon', stats: { atk: 5 }, price: 60 } },\"},{\"line_number\":13882,\"content\":\"      r = { exp: 0, gold: 0, items: [] };\"},{\"line_number\":13895,\"content\":\"    /** rpg: its rules; items: the ids it sells; rate: what it pays for an item, a share of its price (.5) */\"},{\"line_number\":13934,\"content\":\"    /** items: the items by id; monsters: the monsters by id; status: the status effects by name (the defaults and yours) */\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-8eed11f3-7e97-4df8-a407-a3644ffa47e2-39","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,48,49,48,56,95,95,120,54,49,98,100,55,101,47,119,111,114,107,34,62,10,70,111,117,110,100,32,52,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,48,49,48,56,95,95,120,54,49,98,100,55,101,47,119,111,114,107,47,83,112,105,110,101,32,87,101,101,45,87,105,105,32,70,105,116,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,48,49,48,56,47,101,110,103,105,110,101,47,109,121,45,51,100,50,100,103,101,46,106,115,10,51,50,56,49,58,32,32,99,111,110,115,116,32,114,111,119,115,32,61,32,91,91,39,69,110,103,105,110,101,39,44,32,100,46,101,110,103,105,110,101,93,44,32,91,39,71,97,109,101,39,44,32,100,46,103,97,109,101,93,44,32,91,39,84,105,109,101,39,44,32,100,46,116,105,109,101,93,44,32,91,39,80,97,103,101,39,44,32,100,46,112,97,103,101,93,44,32,91,39,66,114,111,119,115,101,114,39,44,32,100,46,98,114,111,119,115,101,114,93,44,32,91,39,68,101,118,105,99,101,39,44,32,100,46,100,101,118,105,99,101,93,44,32,91,39,83,99,114,101,101,110,39,44,32,100,46,115,99,114,101,101,110,93,44,10,49,48,57,53,53,58,32,32,32,32,116,104,105,115,46,103,97,109,101,32,61,32,103,97,109,101,59,32,116,104,105,115,46,114,111,111,109,115,32,61,32,111,46,114,111,111,109,115,32,124,124,32,123,125,59,32,116,104,105,115,46,105,116,101,109,115,32,61,32,111,46,105,116,101,109,115,32,124,124,32,123,125,59,32,116,104,105,115,46,114,117,108,101,115,32,61,32,111,46,114,117,108,101,115,32,124,124,32,91,93,59,32,116,104,105,115,46,111,110,32,61,32,111,46,111,110,32,124,124,32,123,125,59,10,49,49,51,54,50,58,32,32,32,32,102,111,114,32,40,99,111,110,115,116,32,98,32,111,102,32,116,104,105,115,46,98,111,120,101,115,41,32,123,32,98,46,116,32,45,61,32,100,116,59,32,105,102,32,40,98,46,116,32,62,32,48,41,32,99,111,110,116,105,110,117,101,59,32,102,111,114,32,40,99,111,110,115,116,32,82,32,111,102,32,116,104,105,115,46,114,97,99,101,114,115,41,32,105,102,32,40,33,82,46,105,116,101,109,32,38,38,32,77,97,116,104,46,104,121,112,111,116,40,82,46,99,97,114,46,120,32,45,32,98,46,120,44,32,82,46,99,97,114,46,121,32,45,32,98,46,121,41,32,60,32,82,46,99,97,114,46,114,32,43,32,56,41,32,123,32,99,111,110,115,116,32,73,32,61,32,116,104,105,115,46,111,46,105,116,101,109,115,59,32,82,46,105,116,101,109,32,61,32,73,91,77,97,116,104,46,102,108,111,111,114,40,77,97,116,104,46,114,97,110,100,111,109,40,41,32,42,32,73,46,108,101,110,103,116,104,41,93,59,32,98,46,116,32,61,32,50,59,32,98,114,101,97,107,59,32,125,32,125,10,49,51,57,51,53,58,32,32,32,32,116,104,105,115,46,105,116,101,109,115,32,61,32,111,46,105,116,101,109,115,32,124,124,32,123,125,59,32,116,104,105,115,46,109,111,110,115,116,101,114,115,32,61,32,111,46,109,111,110,115,116,101,114,115,32,124,124,32,123,125,59,32,116,104,105,115,46,115,116,97,116,117,115,32,61,32,79,98,106,101,99,116,46,97,115,115,105,103,110,40,123,125,44,32,83,84,65,84,85,83,44,32,111,46,115,116,97,116,117,115,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":4,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js\",\"matches\":[{\"line_number\":3281,\"content\":\"  const rows = [['Engine', d.engine], ['Game', d.game], ['Time', d.time], ['Page', d.page], ['Browser', d.browser], ['Device', d.device], ['Screen', d.screen],\"},{\"line_number\":10955,\"content\":\"    this.game = game; this.rooms = o.rooms || {}; this.items = o.items || {}; this.rules = o.rules || []; this.on = o.on || {};\"},{\"line_number\":11362,\"content\":\"    for (const b of this.boxes) { b.t -= dt; if (b.t > 0) continue; for (const R of this.racers) if (!R.item && Math.hypot(R.car.x - b.x, R.car.y - b.y) < R.car.r + 8) { const I = this.o.items; R.item = I[Math.floor(Math.random() * I.length)]; b.t = 2; break; } }\"},{\"line_number\":13935,\"content\":\"    this.items = o.items || {}; this.monsters = o.monsters || {}; this.status = Object.assign({}, STATUS, o.status);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"1fdb37d4-6717-48be-9efc-1ad8d777d1fb"}
{"type":"assistant","message":{"id":"msg_23","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The pause menu items are Shell HTML buttons.\n\nHeadless mode prevents clicking pause menu buttons because shell.root is null. The test will instead call the underlying function directly, since it is stored on G.dev.open.\n\nThe pause menu item function is `() => G.dev.toggle()`. The test will call this directly in headless mode. A canvas-based pause menu was considered but rejected as too complex.\n\nThe test will open the pause menu and call the Dev Mode callback from `game.o.menu.items`. The item is a `[label, fn]` pair. This matches the browser button behavior.","signature":""},{"type":"tool_use","id":"call-3616a6ac-27d1-48ff-9cde-d07642651ea2-40","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/tools/check.mjs","limit":80}},{"type":"tool_use","id":"call-3616a6ac-27d1-48ff-9cde-d07642651ea2-41","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js","offset":9680,"limit":80}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":6170,"output_tokens":687,"cache_read_input_tokens":134144,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"448e5d6c-3187-4f8c-948d-65f778ff9cd2"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-3616a6ac-27d1-48ff-9cde-d07642651ea2-40","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→// my-3D2dge game checker: loads a game in a headless browser, presses start, plays it for a\\n// moment, switches through the game's camera views, and reports errors, warnings, frame rate,\\n// how much of the window the picture covers (covers: 1 = no black bars), how much is actually on screen, and screenshots.\\n//\\n// Setup (once):   npm install          (installs Playwright)\\n//                 npx playwright install chromium\\n// Usage:          node tools/check.mjs path/to/game.html[#scene] [--seconds 4] [--out check-output] [--size 390x844@3]\\n//                 (--size: the window in CSS pixels and its pixel density; @2 and up is a phone or tablet, with touch)\\n// Exit code is 1 if the page threw any error or never drew anything, so agents and CI can rely on it.\\n10→// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\\n// the hero, the objective, what an agent needs to see the game is where it should be).\\nimport { chromium } from 'playwright';\\nimport { mkdirSync, writeFileSync } from 'node:fs';\\nimport { resolve, join } from 'node:path';\\nimport { pathToFileURL } from 'node:url';\\n\\nconst args = process.argv.slice(2);\\nconst file = args.find(a => !a.startsWith('--') && !/^\\\\d+(\\\\.\\\\d+)?$/.test(a));\\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\\n20→if (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\\\d+)x(\\\\d+)(?:@(\\\\d+(?:\\\\.\\\\d+)?))?$/) || [0, 1280, 720];\\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\\nmkdirSync(out, { recursive: true });\\n\\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\\nconst page = await browser.newPage(size);\\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\\n30→page.on('console', m => {\\n  const t = m.text();\\n  if (m.type() === 'error') errors.push(t);\\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\\n});\\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\\n\\n// a #hash after the file name is kept, so deep links like game.html#platformer work\\nconst [filePath, hash] = file.split('#');\\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\\n40→await page.waitForTimeout(1200);\\nconst hasEngine = await page.evaluate(() => !!(window.My3D2dge && My3D2dge.current));\\nconst report = { file, engine: hasEngine ? await page.evaluate(() => My3D2dge.version) : null, build: hasEngine ? await page.evaluate(() => My3D2dge.build || null) : null, scenes: [], views: [], errors, warnings, engineWarnings, external: [] };\\n\\n// how much of the frame is not background: share of pixels that differ from the most common color\\n// how much of the frame is not background, plus a quick look lint: palette depth, flat areas, dither checkerboards, contrast\\nconst coverage = () => page.evaluate(() => {\\n  const g = My3D2dge.current, c = g.screen.buf, ctx = c.getContext('2d'), W = g.screen.W, H = g.screen.H, N = W * H;\\n  const d = ctx.getImageData(0, 0, W, H).data, counts = new Map(), luma = new Uint8Array(N), key = new Int32Array(N);\\n  for (let i = 0, p = 0; i < d.length; i += 4, p++) { const k = (d[i] >> 3) << 10 | (d[i + 1] >> 3) << 5 | (d[i + 2] >> 3); key[p] = k; counts.set(k, (counts.get(k) || 0) + 1); luma[p] = (d[i] * 3 + d[i + 1] * 6 + d[i + 2]) / 10; }\\n50→  let top = 0, colors = 0; for (const v of counts.values()) { top = Math.max(top, v); if (v >= N * .001) colors++; }\\n  let checker = 0, wins = 0;\\n  for (let y = 0; y < H - 1; y += 2) for (let x = 0; x < W - 1; x += 2) { const a = key[y * W + x], b = key[y * W + x + 1], c2 = key[(y + 1) * W + x], e = key[(y + 1) * W + x + 1]; wins++; if (a !== b && a === e && b === c2) checker++; }\\n  const sorted = Array.from(luma).sort((p, q) => p - q), spread = sorted[Math.floor(N * .95)] - sorted[Math.floor(N * .05)];\\n  return { filled: +(1 - top / N).toFixed(3), colors, flat: +(top / N).toFixed(3), checker: +(checker / Math.max(1, wins)).toFixed(3), spread };\\n});\\nconst snap = async (tag) => {\\n  const s = await page.evaluate(() => { const g = My3D2dge.current; return { scene: g.sceneName, fps: g.fps, updateMs: +g.stats.updateMs.toFixed(2), renderMs: +g.stats.renderMs.toFixed(2), items: g.stats.items, actors: g.stats.actors, resolution: g.screen.W + 'x' + g.screen.H, covers: +(Math.min(1, g.screen.W * g.screen.S / g.screen.canvas.width) * Math.min(1, g.screen.H * g.screen.S / g.screen.canvas.height)).toFixed(3), errorBox: !!document.querySelector('#my3d2dge-error, #e3-boot[data-failed]') }; });\\n  const cov = await coverage(), shot = join(out, tag + '.png');\\n  await page.screenshot({ path: shot });\\n60→  return { ...s, ...cov, screenshot: shot };\\n};\\n\\nif (hasEngine) {\\n  report.scenes.push({ at: 'load', ...(await snap('0-load')) });\\n  // press start / confirm twice to get past title screens and menus\\n  for (let i = 0; i < 2; i++) { await page.keyboard.press('Enter'); await page.waitForTimeout(450); }\\n  report.scenes.push({ at: 'after start', ...(await snap('1-started')) });\\n  // play: move in every direction, jump, attack, dash, fire, using both key layouts\\n  await page.mouse.move(820, 330);\\n70→  const hold = async (keys, ms) => { for (const k of keys) await page.keyboard.down(k); await page.waitForTimeout(ms); for (const k of keys) await page.keyboard.up(k); };\\n  await hold(['KeyD', 'ArrowRight'], 500);\\n  await page.keyboard.press('Space'); await page.keyboard.press('KeyZ');\\n  await hold(['KeyD', 'ArrowRight'], 400);\\n  for (const k of ['KeyJ', 'KeyX', 'KeyJ']) { await page.keyboard.press(k); await page.waitForTimeout(160); }\\n  await hold(['KeyW', 'ArrowUp'], 250); await hold(['KeyA', 'ArrowLeft'], 300); await hold(['KeyS', 'ArrowDown'], 250);\\n  report.scenes.push({ at: 'after play', ...(await snap('2-played')) });\\n  const views = await page.evaluate(() => (My3D2dge.current.views || My3D2dge.VIEW_ORDER).slice());\\n  for (const id of views) {\\n    await page.evaluate(v => My3D2dge.current.setView(v), id);\\n80→    await page.waitForTimeout(seconds * 1000 / views.length);\",\"content_concise\":\"1→// my-3D2dge game checker: loads a game in a headless browser, presses start, plays it for a\\n// moment, switches through the game's camera views, and reports errors, warnings, frame rate,\\n// how much of the window the picture covers (covers: 1 = no black bars), how much is actually on screen, and screenshots.\\n//\\n// Setup (once):   npm install          (installs Playwright)\\n//                 npx playwright install chromium\\n// Usage:          node tools/check.mjs path/to/game.html[#scene] [--seconds 4] [--out check-output] [--size 390x844@3]\\n//                 (--size: the window in CSS pixels and its pixel density; @2 and up is a phone or tablet, with touch)\\n// Exit code is 1 if the page threw any error or never drew anything, so agents and CI can rely on it.\\n10→// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\\n// the hero, the objective, what an agent needs to see the game is where it should be).\\nimport { chromium } from 'playwright';\\nimport { mkdirSync, writeFileSync } from 'node:fs';\\nimport { resolve, join } from 'node:path';\\nimport { pathToFileURL } from 'node:url';\\n\\nconst args = process.argv.slice(2);\\nconst file = args.find(a => !a.startsWith('--') && !/^\\\\d+(\\\\.\\\\d+)?$/.test(a));\\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\\n20→if (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\\\d+)x(\\\\d+)(?:@(\\\\d+(?:\\\\.\\\\d+)?))?$/) || [0, 1280, 720];\\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\\nmkdirSync(out, { recursive: true });\\n\\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\\nconst page = await browser.newPage(size);\\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\\n30→page.on('console', m => {\\n  const t = m.text();\\n  if (m.type() === 'error') errors.push(t);\\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\\n});\\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\\n\\n// a #hash after the file name is kept, so deep links like game.html#platformer work\\nconst [filePath, hash] = file.split('#');\\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\\n40→await page.waitForTimeout(1200);\\nconst hasEngine = await page.evaluate(() => !!(window.My3D2dge && My3D2dge.current));\\nconst report = { file, engine: hasEngine ? await page.evaluate(() => My3D2dge.version) : null, build: hasEngine ? await page.evaluate(() => My3D2dge.build || null) : null, scenes: [], views: [], errors, warnings, engineWarnings, external: [] };\\n\\n// how much of the frame is not background: share of pixels that differ from the most common color\\n// how much of the frame is not background, plus a quick look lint: palette depth, flat areas, dither checkerboards, contrast\\nconst coverage = () => page.evaluate(() => {\\n  const g = My3D2dge.current, c = g.screen.buf, ctx = c.getContext('2d'), W = g.screen.W, H = g.screen.H, N = W * H;\\n  const d = ctx.getImageData(0, 0, W, H).data, counts = new Map(), luma = new Uint8Array(N), key = new Int32Array(N);\\n  for (let i = 0, p = 0; i < d.length; i += 4, p++) { const k = (d[i] >> 3) << 10 | (d[i + 1] >> 3) << 5 | (d[i + 2] >> 3); key[p] = k; counts.set(k, (counts.get(k) || 0) + 1); luma[p] = (d[i] * 3 + d[i + 1] * 6 + d[i + 2]) / 10; }\\n50→  let top = 0, colors = 0; for (const v of counts.values()) { top = Math.max(top, v); if (v >= N * .001) colors++; }\\n  let checker = 0, wins = 0;\\n  for (let y = 0; y < H - 1; y += 2) for (let x = 0; x < W - 1; x += 2) { const a = key[y * W + x], b = key[y * W + x + 1], c2 = key[(y + 1) * W + x], e = key[(y + 1) * W + x + 1]; wins++; if (a !== b && a === e && b === c2) checker++; }\\n  const sorted = Array.from(luma).sort((p, q) => p - q), spread = sorted[Math.floor(N * .95)] - sorted[Math.floor(N * .05)];\\n  return { filled: +(1 - top / N).toFixed(3), colors, flat: +(top / N).toFixed(3), checker: +(checker / Math.max(1, wins)).toFixed(3), spread };\\n});\\nconst snap = async (tag) => {\\n  const s = await page.evaluate(() => { const g = My3D2dge.current; return { scene: g.sceneName, fps: g.fps, updateMs: +g.stats.updateMs.toFixed(2), renderMs: +g.stats.renderMs.toFixed(2), items: g.stats.items, actors: g.stats.actors, resolution: g.screen.W + 'x' + g.screen.H, covers: +(Math.min(1, g.screen.W * g.screen.S / g.screen.canvas.width) * Math.min(1, g.screen.H * g.screen.S / g.screen.canvas.height)).toFixed(3), errorBox: !!document.querySelector('#my3d2dge-error, #e3-boot[data-failed]') }; });\\n  const cov = await coverage(), shot = join(out, tag + '.png');\\n  await page.screenshot({ path: shot });\\n60→  return { ...s, ...cov, screenshot: shot };\\n};\\n\\nif (hasEngine) {\\n  report.scenes.push({ at: 'load', ...(await snap('0-load')) });\\n  // press start / confirm twice to get past title screens and menus\\n  for (let i = 0; i < 2; i++) { await page.keyboard.press('Enter'); await page.waitForTimeout(450); }\\n  report.scenes.push({ at: 'after start', ...(await snap('1-started')) });\\n  // play: move in every direction, jump, attack, dash, fire, using both key layouts\\n  await page.mouse.move(820, 330);\\n70→  const hold = async (keys, ms) => { for (const k of keys) await page.keyboard.down(k); await page.waitForTimeout(ms); for (const k of keys) await page.keyboard.up(k); };\\n  await hold(['KeyD', 'ArrowRight'], 500);\\n  await page.keyboard.press('Space'); await page.keyboard.press('KeyZ');\\n  await hold(['KeyD', 'ArrowRight'], 400);\\n  for (const k of ['KeyJ', 'KeyX', 'KeyJ']) { await page.keyboard.press(k); await page.waitForTimeout(160); }\\n  await hold(['KeyW', 'ArrowUp'], 250); await hold(['KeyA', 'ArrowLeft'], 300); await hold(['KeyS', 'ArrowDown'], 250);\\n  report.scenes.push({ at: 'after play', ...(await snap('2-played')) });\\n  const views = await page.evaluate(() => (My3D2dge.current.views || My3D2dge.VIEW_ORDER).slice());\\n  for (const id of views) {\\n    await page.evaluate(v => My3D2dge.current.setView(v), id);\\n80→    await page.waitForTimeout(seconds * 1000 / views.length);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/tools/check.mjs\",\"offset\":null,\"limit\":80,\"raw_output\":\"// my-3D2dge game checker: loads a game in a headless browser, presses start, plays it for a\\n// moment, switches through the game's camera views, and reports errors, warnings, frame rate,\\n// how much of the window the picture covers (covers: 1 = no black bars), how much is actually on screen, and screenshots.\\n//\\n// Setup (once):   npm install          (installs Playwright)\\n//                 npx playwright install chromium\\n// Usage:          node tools/check.mjs path/to/game.html[#scene] [--seconds 4] [--out check-output] [--size 390x844@3]\\n//                 (--size: the window in CSS pixels and its pixel density; @2 and up is a phone or tablet, with touch)\\n// Exit code is 1 if the page threw any error or never drew anything, so agents and CI can rely on it.\\n// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\\n// the hero, the objective, what an agent needs to see the game is where it should be).\\nimport { chromium } from 'playwright';\\nimport { mkdirSync, writeFileSync } from 'node:fs';\\nimport { resolve, join } from 'node:path';\\nimport { pathToFileURL } from 'node:url';\\n\\nconst args = process.argv.slice(2);\\nconst file = args.find(a => !a.startsWith('--') && !/^\\\\d+(\\\\.\\\\d+)?$/.test(a));\\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\\nif (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\\\d+)x(\\\\d+)(?:@(\\\\d+(?:\\\\.\\\\d+)?))?$/) || [0, 1280, 720];\\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\\nmkdirSync(out, { recursive: true });\\n\\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\\nconst page = await browser.newPage(size);\\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\\npage.on('console', m => {\\n  const t = m.text();\\n  if (m.type() === 'error') errors.push(t);\\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\\n});\\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\\n\\n// a #hash after the file name is kept, so deep links like game.html#platformer work\\nconst [filePath, hash] = file.split('#');\\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\\nawait page.waitForTimeout(1200);\\nconst hasEngine = await page.evaluate(() => !!(window.My3D2dge && My3D2dge.current));\\nconst report = { file, engine: hasEngine ? await page.evaluate(() => My3D2dge.version) : null, build: hasEngine ? await page.evaluate(() => My3D2dge.build || null) : null, scenes: [], views: [], errors, warnings, engineWarnings, external: [] };\\n\\n// how much of the frame is not background: share of pixels that differ from the most common color\\n// how much of the frame is not background, plus a quick look lint: palette depth, flat areas, dither checkerboards, contrast\\nconst coverage = () => page.evaluate(() => {\\n  const g = My3D2dge.current, c = g.screen.buf, ctx = c.getContext('2d'), W = g.screen.W, H = g.screen.H, N = W * H;\\n  const d = ctx.getImageData(0, 0, W, H).data, counts = new Map(), luma = new Uint8Array(N), key = new Int32Array(N);\\n  for (let i = 0, p = 0; i < d.length; i += 4, p++) { const k = (d[i] >> 3) << 10 | (d[i + 1] >> 3) << 5 | (d[i + 2] >> 3); key[p] = k; counts.set(k, (counts.get(k) || 0) + 1); luma[p] = (d[i] * 3 + d[i + 1] * 6 + d[i + 2]) / 10; }\\n  let top = 0, colors = 0; for (const v of counts.values()) { top = Math.max(top, v); if (v >= N * .001) colors++; }\\n  let checker = 0, wins = 0;\\n  for (let y = 0; y < H - 1; y += 2) for (let x = 0; x < W - 1; x += 2) { const a = key[y * W + x], b = key[y * W + x + 1], c2 = key[(y + 1) * W + x], e = key[(y + 1) * W + x + 1]; wins++; if (a !== b && a === e && b === c2) checker++; }\\n  const sorted = Array.from(luma).sort((p, q) => p - q), spread = sorted[Math.floor(N * .95)] - sorted[Math.floor(N * .05)];\\n  return { filled: +(1 - top / N).toFixed(3), colors, flat: +(top / N).toFixed(3), checker: +(checker / Math.max(1, wins)).toFixed(3), spread };\\n});\\nconst snap = async (tag) => {\\n  const s = await page.evaluate(() => { const g = My3D2dge.current; return { scene: g.sceneName, fps: g.fps, updateMs: +g.stats.updateMs.toFixed(2), renderMs: +g.stats.renderMs.toFixed(2), items: g.stats.items, actors: g.stats.actors, resolution: g.screen.W + 'x' + g.screen.H, covers: +(Math.min(1, g.screen.W * g.screen.S / g.screen.canvas.width) * Math.min(1, g.screen.H * g.screen.S / g.screen.canvas.height)).toFixed(3), errorBox: !!document.querySelector('#my3d2dge-error, #e3-boot[data-failed]') }; });\\n  const cov = await coverage(), shot = join(out, tag + '.png');\\n  await page.screenshot({ path: shot });\\n  return { ...s, ...cov, screenshot: shot };\\n};\\n\\nif (hasEngine) {\\n  report.scenes.push({ at: 'load', ...(await snap('0-load')) });\\n  // press start / confirm twice to get past title screens and menus\\n  for (let i = 0; i < 2; i++) { await page.keyboard.press('Enter'); await page.waitForTimeout(450); }\\n  report.scenes.push({ at: 'after start', ...(await snap('1-started')) });\\n  // play: move in every direction, jump, attack, dash, fire, using both key layouts\\n  await page.mouse.move(820, 330);\\n  const hold = async (keys, ms) => { for (const k of keys) await page.keyboard.down(k); await page.waitForTimeout(ms); for (const k of keys) await page.keyboard.up(k); };\\n  await hold(['KeyD', 'ArrowRight'], 500);\\n  await page.keyboard.press('Space'); await page.keyboard.press('KeyZ');\\n  await hold(['KeyD', 'ArrowRight'], 400);\\n  for (const k of ['KeyJ', 'KeyX', 'KeyJ']) { await page.keyboard.press(k); await page.waitForTimeout(160); }\\n  await hold(['KeyW', 'ArrowUp'], 250); await hold(['KeyA', 'ArrowLeft'], 300); await hold(['KeyS', 'ArrowDown'], 250);\\n  report.scenes.push({ at: 'after play', ...(await snap('2-played')) });\\n  const views = await page.evaluate(() => (My3D2dge.current.views || My3D2dge.VIEW_ORDER).slice());\\n  for (const id of views) {\\n    await page.evaluate(v => My3D2dge.current.setView(v), id);\\n    await page.waitForTimeout(seconds * 1000 / views.length);\\n\",\"total_lines\":116}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3616a6ac-27d1-48ff-9cde-d07642651ea2-41","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"9680→    const I = this._ctlI(), r = I.rebind(c.a, c.device, code), names = I.names || {}, nm = a => typeof names[a] === 'string' ? names[a] : actionName(a);\\n    if (r === 'reserved') { this._status = I.codeLabel(code) + ' is kept for the menus. Choose another, or press Escape.'; this._render(); return; }\\n    if (r) { this._status = I.codeLabel(code) + ' is already ' + nm(r) + '. Rebind ' + nm(r) + ' first, or choose another.'; this._render(); return; }\\n    this._capEnd(nm(c.a) + ': ' + I.codeLabel(code) + '. Saved.');\\n  }\\n  /** stop listening for a new binding (msg: what the status line says) */\\n  _capEnd(msg) { if (!this._cap) { if (msg !== undefined) this._status = msg; return; } this._cap = null; this._status = msg || ''; this._ctlI().clear(); this._render(); }\\n  /** a button: [label, fn] or { label, fn, act, primary, disabled } */\\n  _btn(a, i, pri = true) {\\n    const b = Array.isArray(a) ? { label: a[0], fn: a[1] } : a, e = this._el('button', b.primary || (b.primary === undefined && i === 0 && pri) ? 'pri' : '', b.label);\\n9690→    e.disabled = !!b.disabled;\\n    if (b.down) {   // (a press, timed: the event's own time, not the click's after the finger lifts)\\n      e.onpointerdown = ev => { ev.preventDefault(); b.down(ev.timeStamp); };\\n      e.onkeydown = ev => { if ((ev.key === ' ' || ev.key === 'Enter') && !ev.repeat) { ev.preventDefault(); b.down(ev.timeStamp); } };\\n    } else e.onclick = () => { if (b.fn) b.fn(); else if (b.act) { this._game.input.tap(b.act); this._held.add(b.act); } };\\n    return e;\\n  }\\n  /** the audio offset's calibration screen: clicks on the beat, a Tap button (or Space) on each one heard; after eight\\n   *  the offset found, kept with Keep it */\\n  _calibrate(key) {\\n9700→    const K = this._game.audio.calibrate(), close = () => { K.stop(); this.back(); };\\n    this.show('calibrate', { kicker: 'Sound', title: 'Audio offset', back: close,\\n      text: () => K.done ? 'Your sound comes ' + K.result + ' ms after the beat. Keep it, or tap on to measure again.' : 'Tap on each click you hear, in time with it, not before (' + K.taps + ' of 8). The higher click starts each bar.',\\n      actions: () => [{ label: 'Tap', primary: true, down: t => { K.tap(t); this.show('calibrate', {}); } }, { label: 'Keep it', disabled: !K.done, fn: () => { this._game.settings.set(key, K.result); close(); } }, ['Cancel', close]] });\\n  }\\n  /** build the open screen */\\n  _render() {\\n    if (!this.root) return;\\n    const scr = this._els.scr, top = this._stack[this._stack.length - 1];\\n    if (!top) { scr.replaceChildren(); return; }\\n9710→    for (const k of ['hb', 'obj', 'vit', 'place', 'tip', 'pr', 'keys', 'mini']) { this._els[k].hidden = true; this._last[k] = null; }   // the HUD hides under a screen (a paused game calls no hud())\\n    const { name, s } = top, v = x => typeof x === 'function' ? x() : x, title = name === 'title';\\n    const sh = this._el('div', 'esh-sh' + (title ? ' esh-ttl' : '')), box = this._el('div', title ? '' : 'esh-pan esh-mod' + (name === 'map' ? ' esh-wide' : ''));\\n    sh.appendChild(box); sh.setAttribute('role', 'dialog'); sh.setAttribute('aria-label', v(s.title || s.name) || name);\\n    const add = (...c) => box.append(...c.filter(Boolean));\\n    add(s.emblem && this._el('div', 'esh-emb', s.emblem), s.kicker && this._el('div', 'esh-k', v(s.kicker)));\\n    if (title) add(this._el('h1', '', v(s.name || s.title)), s.subtitle && this._el('div', 'esh-sub', v(s.subtitle)));\\n    else add(this._el('h2', '', v(s.title) || { pause: this._game._players && this._game._players.length > 1 && this._game.pausedBy ? 'Paused by P' + this._game.pausedBy : 'Paused', settings: 'Settings', controls: 'Controls', help: 'Help', map: 'Map' }[name] || ''));   // (several players: who paused)\\n    add(v(s.text) && this._el('p', title ? '' : 'esh-m', v(s.text)));\\n    for (const key of v(s.rows) || []) add(key[0] === '#' ? this._el('div', 'esh-k esh-sec', key.slice(1)) : this._row(key));   // (setting rows on a screen of the game's own: '#' a heading)\\n9720→    if (name === 'settings') this._settingsRows(add);\\n    if (name === 'controls') this._controls(add);\\n    if (s.keys) { const g = this._el('div', 'esh-grid'); for (const [k, w] of v(s.keys)) g.append(this._el('kbd', '', k), this._el('span', '', w)); add(g); }\\n    for (const [h, t] of v(s.sections) || []) add(this._el('div', 'esh-k esh-sec', h), this._el('p', 'esh-m', t));\\n    if (s.stats) { const g = this._el('div', 'esh-stats'); for (const [val, lab] of v(s.stats)) { const c = this._el('div'); c.append(this._el('b', '', val), this._el('small', '', lab)); g.appendChild(c); } add(g); }\\n    if (s.medals) { const g = this._el('div'); for (const [lab, got] of v(s.medals)) g.appendChild(this._el('span', 'esh-med' + (got ? '' : ' off'), (got ? '✓ ' : '') + lab)); add(g); }\\n    if (name === 'map' && s.map) {\\n      const cv = this._el('canvas', 'esh-map'); cv.width = 720; cv.height = Math.round(720 * s.map.h / s.map.w); this._map(cv, s, true); add(cv);\\n      if (s.onPick) cv.onclick = e => { const b = cv.getBoundingClientRect(), t = cv._xf, x = ((e.clientX - b.left) * cv.width / b.width - t.ox) / t.k, y = ((e.clientY - b.top) * cv.height / b.height - t.oy) / t.k; s.onPick(x, y); this._map(cv, s, true); };\\n    }\\n9730→    const acts = (name === 'pause' ? [['Resume', () => this.hide()]] : []).concat(v(s.actions) || [], name === 'pause' && this._std && v(this._game.o.menu && this._game.o.menu.items) || []).filter(Boolean);\\n    if (name === 'pause') this._pauseActs(acts);\\n    if (name === 'settings' && this._std) acts.push(['Controls', () => this.show('controls')], ['Restore defaults', () => { for (const g of SHELL_GROUPS.concat('Game')) this._game.settings.reset(g); this.show('settings'); }]);\\n    if (name === 'controls') acts.push(['Restore defaults', () => { this._ctlI().resetBindings(); this._game.settings.reset('Controller'); this._game.settings.reset('Touch'); this._status = 'Every control is back to its default.'; this.show('controls'); }]);\\n    if (!acts.length && !title || name === 'settings' || name === 'controls') acts.push(['Back', () => this.back()]);\\n    const btns = this._el('div', 'esh-btns'), lists = name === 'settings' || name === 'controls'; acts.forEach((a, i) => btns.appendChild(this._btn(a, i, !lists))); add(btns);\\n    if (s.meta) { const g = this._el('div', 'esh-tags'); for (const t of v(s.meta)) g.appendChild(this._el('span', '', t)); add(g); }\\n    add(s.footer && this._el('div', 'esh-m', v(s.footer)));\\n    const keep = top.focus !== undefined ? top.focus : this._shown === top ? this._focusAt() : -1; this._shown = top;   // (redrawn in place: the focus stays where it was)\\n    // the way out, always in sight: close at the top right (where the menu button was), back at the top left over another\\n9740→    // screen, and a sideways swipe goes back (a phone's edge swipe would leave the page)\\n    const nav = [];\\n    if (!title) nav.push(this._navBtn('x', 'Close', 'M6 6l12 12M18 6L6 18', () => this._close()));\\n    if (this._stack.length > 1) nav.push(this._navBtn('bk', 'Back', 