5,115,46,110,97,109,101,67,111,108,111,114,44,32,123,32,111,117,116,108,105,110,101,58,32,102,97,108,115,101,44,32,115,104,97,100,111,119,58,32,39,35,48,53,48,52,48,97,39,32,125,41,59,32,125,10,57,50,51,53,58,32,32,32,32,32,32,99,111,110,115,116,32,109,107,32,61,32,116,104,105,115,46,95,102,120,32,38,38,32,116,104,105,115,46,95,102,120,91,116,104,105,115,46,105,93,44,32,111,32,61,32,123,32,111,117,116,108,105,110,101,58,32,102,97,108,115,101,44,32,115,104,97,100,111,119,58,32,39,35,48,53,48,52,48,97,39,32,125,59,10,57,50,53,54,58,32,32,32,32,32,32,32,32,116,104,105,115,46,99,104,111,105,99,101,115,46,102,111,114,69,97,99,104,40,40,99,44,32,107,41,32,61,62,32,123,32,69,46,102,111,110,116,46,116,101,120,116,40,103,44,32,99,44,32,99,120,32,43,32,49,51,44,32,99,121,32,43,32,52,32,43,32,107,32,42,32,100,46,108,104,44,32,107,32,61,61,61,32,116,104,105,115,46,99,104,111,105,99,101,32,63,32,116,104,105,115,46,110,97,109,101,67,111,108,111,114,32,58,32,116,104,105,115,46,99,111,108,111,114,44,32,123,32,111,117,116,108,105,110,101,58,32,102,97,108,115,101,44,32,115,104,97,100,111,119,58,32,39,35,48,53,48,52,48,97,39,32,125,41,59,32,105,102,32,40,107,32,61,61,61,32,116,104,105,115,46,99,104,111,105,99,101,32,38,38,32,98,108,105,110,107,41,32,69,46,102,111,110,116,46,116,101,120,116,40,103,44,32,39,226,150,184,39,44,32,99,120,32,43,32,53,44,32,99,121,32,43,32,52,32,43,32,107,32,42,32,100,46,108,104,44,32,116,104,105,115,46,110,97,109,101,67,111,108,111,114,44,32,102,97,108,115,101,41,59,32,125,41,59,10,57,51,50,48,58,32,32,32,32,32,32,99,111,110,115,116,32,123,32,108,97,98,101,108,115,44,32,119,44,32,104,44,32,120,44,32,121,44,32,116,111,112,58,32,121,121,44,32,114,111,119,72,44,32,107,58,32,75,44,32,102,105,114,115,116,44,32,118,105,115,32,125,32,61,32,116,104,105,115,46,95,108,97,121,111,117,116,40,41,44,32,84,32,61,32,123,32,111,117,116,108,105,110,101,58,32,102,97,108,115,101,44,32,115,104,97,100,111,119,58,32,39,35,48,53,48,52,48,97,39,44,32,115,99,97,108,101,58,32,75,32,125,59,10,57,51,50,50,58,32,32,32,32,32,32,105,102,32,40,116,104,105,115,46,116,105,116,108,101,41,32,69,46,102,111,110,116,46,116,101,120,116,40,103,44,32,116,104,105,115,46,116,105,116,108,101,44,32,120,32,43,32,119,32,47,32,50,44,32,121,32,43,32,53,32,42,32,75,44,32,116,104,105,115,46,112,105,99,107,44,32,123,32,97,108,105,103,110,58,32,39,99,101,110,116,101,114,39,44,32,111,117,116,108,105,110,101,58,32,102,97,108,115,101,44,32,115,104,97,100,111,119,58,32,39,35,48,53,48,52,48,97,39,44,32,115,99,97,108,101,58,32,75,32,125,41,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":5,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js\",\"matches\":[{\"line_number\":9233,\"content\":\"      if (this.name) { const nw = E.font.width(this.name) + 12, nx = d.x + (this.portrait ? d.tx - 6 : 4); ui.box(g, nx, d.y - 12, nw, 14, { bg: this.bg, border: this.border }); E.font.text(g, this.name, nx + 6, d.y - 9, this.nameColor, { outline: false, shadow: '#05040a' }); }\"},{\"line_number\":9235,\"content\":\"      const mk = this._fx && this._fx[this.i], o = { outline: false, shadow: '#05040a' };\"},{\"line_number\":9256,\"content\":\"        this.choices.forEach((c, k) => { E.font.text(g, c, cx + 13, cy + 4 + k * d.lh, k === this.choice ? this.nameColor : this.color, { outline: false, shadow: '#05040a' }); if (k === this.choice && blink) E.font.text(g, '▸', cx + 5, cy + 4 + k * d.lh, this.nameColor, false); });\"},{\"line_number\":9320,\"content\":\"      const { labels, w, h, x, y, top: yy, rowH, k: K, first, vis } = this._layout(), T = { outline: false, shadow: '#05040a', scale: K };\"},{\"line_number\":9322,\"content\":\"      if (this.title) E.font.text(g, this.title, x + w / 2, y + 5 * K, this.pick, { align: 'center', outline: false, shadow: '#05040a', scale: K });\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-507b9f29-c3af-4942-ba3a-9b5e088fda6d-17","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"457→## 10. Game\\n\\n- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\\n460→- `new E.Game({ res })`: a fixed resolution ('ps1' or [w, h]), whole pixels\\n- `new E.Game({ expand })`: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars (expand: { maxW, maxH } stops it growing there)\\n- `new E.Game({ bg })`: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture under it (a 3D world, engine/my-3d2dge-3d.js)\\n- `new E.Game({ headless })`: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default): scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\\n- `new E.Game({ draw })`: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\\n- `new E.Game({ loop })`: false makes a game in a page that runs only by advance()\\n- `new E.Game({ menu })`: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\\n- `new E.Game({ fullscreen })`: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it off), 'button' (only when asked) or false\\n- `new E.Game({ corner, backGesture })`: corner: the menu and full-screen buttons (top right); backGesture: a phone's back steps back in the game first (false: it leaves the page)\\n- `new E.Game({ autoPause })`: a pausable scene pauses when the page is hidden or loses focus\\n470→- `new E.Game({ live })`: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it, the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\\n- `new E.Game({ id })`: the name the player's settings are saved under (the page's path)\\n- `new E.Game({ pace })`: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every other one, evenly), unless the player picks Frame rate 60\\n- `new E.Game({ camera })`: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\\n- `game.H`: the screen's height in game pixels (W is its width)\\n- `game.W`: internal buffer size in pixels (HUD layout)\\n- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\\n- `game.advance(seconds = this.o.step, o = {})`: run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test that catches what a player would see break). Returns the updates run\\n- `game.after(seconds, fn, o = {})`: run fn once after `seconds` of game time. Cleared on scene change, unless { keep: true } (a site's clock, a watcher of the whole game: it outlives scenes, as a kept tween does). Returns { cancel() }\\n- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\\n480→- `game.back()`: a step back, as a phone's back gesture asks for (the engine calls it for one; a back button of the game's own can): the open menu screen goes back one; else the scene's own back() takes it (it returns true when it did); else a scene in play pauses into the menu, and a paused one goes on. Returns false where there is nowhere to go (a title)\\n- `game.cornerArea()` †: where the corner's buttons (menu and full screen, top right; the touch START) cover the screen, in screen pixels { x0, y0, x1, y1 } (r.W and r.H's space), or null while none show: keep a HUD clear of it\\n- `game.dispose()`: end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window, the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and tools that make many games call it; the canvas stays\\n- `game.enableGPU(o = {})` †: turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... }\\n- `game.every(seconds, fn, o = {})`: run fn every `seconds` of game time. Cleared on scene change, unless { keep: true }. Returns { cancel() }\\n- `game.fail(where, e)`: report an error in game code without stopping the game: logged once per place and message, kept in game.errors and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err)\\n- `game.flash(color = '#ffffff', seconds = .12, strength = 1)`: flash the whole screen with a color for `seconds` (dithered fade out): hits, explosions, lightning. Shorter when reduceMotion, dimmer by the player's settings.flashes\\n- `game.focus(x, y, z = 0)`: camera follows this world point. Side-scrollers: game.focus(x, 0, z)\\n- `game.follow(target, o = {})`: keep the camera on an object automatically (instead of calling focus every update). opts: { z: extra height to look at (default 16), lead: look ahead in the facing / moving direction }. follow(null) stops.\\n- `game.freeze(s)`: hit-stop: the game stands still for s seconds (.04-.08 for a hit); input still ticks\\n490→- `game.go(name, data, o = {})`: switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\\n- `game.hitFx(x, y, z, o = {})`: everything a good hit needs in one call: hit-stop, shake, an impact star, sparks along the hit direction, a sound, a damage number and a rumble on a gamepad. hitFx(x, y, z, { power: 1, angle, damage, color, sound: 'hit', rumble: true })\\n- `game.hook(kind, fn)` †: a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it\\n- `game.menu(name, o)`: open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play. o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when a menu opened\\n- `game.mouseGround()`: the mouse's point on the ground: [x, y] in world units (an array, not { x, y }), or null with no mouse over the canvas\\n- `game.nextView(dir = 1)`: cycle through game.views (or every view): bind it to a key for players who like to switch\\n- `game.note(text, seconds = 1.2)`, `game.shownNote`: a short notice at the top of the screen (zoom level, saved, ...): game.note('ZOOM 1.5x', 1). game.shownNote is the one showing, { text, end } (end in game.real seconds), or null: a game that draws it its own way takes it and sets shownNote to null\\n- `game.onView(f)` †: call f(view) whenever the view changes (re-bake caches, move HUD)\\n- `game.pause(reason = 'player')`: pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused. The player resumes (Escape, Start, Resume); resume() does it from code\\n- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\\n500→- `game.removePlayer(p)` †: a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it\\n- `game.resetCamera()` †: undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1 without), no turn. The player's zoom stays (settings.zoom)\\n- `game.resume()`: take the game out of pause (and close the pause screen)\\n- `game.rotateView(deg)` †: turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn\\n- `game.saves()` †: game.saves: the save slots (section 10k), made when first read\\n- `game.script(fn, o)` †: run a coroutine on game time, in the update step: game.script(function* (game) { yield .5; yield E.until(() => door.open); yield game.tween(cam, { y: 0 }, 1); yield E.all([a, b]); ... }, { keep }). Each yield waits: a number (seconds), nothing (one step), a condition (a function, or E.until(fn)), a tween or script (until it is done), a generator (run as a script of its own, and waited for), E.all([...]) or E.any([...]) (each of these). It runs at once to its first yield. Cutscenes, boss patterns, wave timelines, tutorials, attract modes. Returns the Script\\n- `game.setView(v)`: switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn\\n- `game.setZoom(z)` †: camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\\n- `game.shake(a)`: shake the screen by a (pixels, decaying; at most 10 in all); none when reduceMotion, scaled by the player's settings.shake\\n- `game.shaking` †: how hard the screen shakes now (0 still, up to 10): shake() adds to it and it dies away. A camera of the game's own (a 3D world's) shakes by it\\n510→- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 }\\n- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera } (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only by advance().\\n- `game.start({ view, views, input, res, expand, touch })`: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'), expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\\n- `game.start({ back })`: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a sub-menu closed)\\n- `game.start({ camera })`: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\\n- `game.start({ boot })`: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\\n- `game.stop()`: stop the loop; the game keeps its state, and start() resumes it\\n- `game.tween(target, to, seconds, o)` †: ease target's numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }). ease: a name in E.ease ('outQuad' by default) or a function of u 0..1. It starts from the values the target has once its delay is over. Returns the Tween: tween.done, tween.cancel()\\n- `game.upright`: true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom applies then: it zooms a tall picture in to fill it\\n- `game.viewports` †: a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or [] on one screen\\n520→- `game.zoomBy(k)` †: the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does nothing where the scene doesn't let the player zoom. Returns the zoom\\n- `game.zoomRange()` †: the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of the game gives one per screen shape or level), or null where they can't (camera.zoom false or none)\\n- `game.alpha = .5`: the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count\\n- `game.audio`: chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song)\\n- `game.baseView` †: the chosen view without zoom and turn\\n- `game.bootError = null`: the error a boot step failed with (the game did not start), or null\\n- `game.booted`: a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a test whose boot steps return promises\\n- `game.cam`: camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the screen's centre to where the focus sits (above a phone's touch buttons: [0, -40]); x, y: the camera's position in projected pixels (its top-left corner); vx, vy: how fast it is moving there; tx, ty, tz: the world point it is following (focus sets it); snap: true makes it jump there at the next step instead of gliding (a new level, a teleport); window: [w, h] screen pixels, a dead zone round the focus it moves in before the camera follows (Super Mario World's; [48, 0] for sideways only); snapY: true follows a followed body's height only when it lands (onGround) or nears the screen's edge (side-scrollers); frame(targets, { margin: 24, zoom: [min, max] or false }) keeps every one of them (anything with x, y, z) in view, centered between them and zoomed out (no further than min) when they spread apart, until frame(null); free: a free camera (strategy, sims, board games): true or { keys: true, edge: 10, drag: true, speed: 300, bounds: [x0, y0, x1, y1] }: the keys or a pad's stick pan it (input.move(), speed screen pixels a second), the mouse at the screen's edge (within edge pixels), a drag (input.pan(): a finger on open ground, a mouse's middle or right button) one to one; a zoom (wheel, pinch) zooms toward the pointer or the pinch; its focus keeps to bounds (world x, y); focus() still moves it; in every view and turn; null (as it starts): off\\n- `game.debug = null`: a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }. tools/check.mjs prints snapshot() and tools/replay.mjs logs it at the end\\n- `game.disposed = true`: true after dispose()\\n530→- `game.drawEvery = 1`: 1, or 2 while a fast display (a 120 Hz phone) refreshes quicker than the game can draw (a frame's cost, or refreshes missed: its GPU behind): every other refresh is drawn, evenly, instead of random ones missed (the updates still run every refresh). The player's Frame rate setting (game.settings.frameRate: 'auto', '60', 'full') can fix it at 2 or 1\\n- `game.errors = []`: the errors caught in update and draw, each { where, scene, message, stack }, once per kind\\n- `game.fadeTime = .22`: seconds for the dithered fade between scenes (0 = instant cuts)\\n- `game.fps = 60`: frames drawn per second over the last half second of real time\\n- `game.fullscreen`: full screen: game.fullscreen.toggle(), .on, .supported\\n- `game.gpu = null` †: the WebGPU lighting after enableGPU(), or null\\n- `game.headless`: true for a game with no display (o.headless, or no DOM: Node)\\n- `game.hitstop = 0`: seconds of hit-stop left (freeze: a scene's entry ends it)\\n- `game.hz = 60`: the display's refresh rate, measured\\n- `game.input`: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...)\\n540→- `game.lights` †: canvas lighting (lights.enabled, lights.add in draw)\\n- `game.live` †: true (o.live): a pause opens the menus over a world that keeps stepping (an online or shared world can't stop for one player): paused is true and the scene's update goes on, the menu holding the player's own input back\\n- `game.o`: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg, step, input, loop, headless)\\n- `game.particles`: dust, sparks, debris and text in the world\\n- `game.pauseOverlay = true`: false hides the engine's PAUSED overlay (a game drawing its own pause screen)\\n- `game.pauseReason = null`: why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null\\n- `game.paused = false`: true while paused (a pausable scene toggles it on 'pause'; steps still run, scenes don't update)\\n- `game.r`: the renderer handed to draw(r) (null when headless)\\n- `game.real = 0`: seconds the game has stepped through, pauses and hit-stop included (blinking HUD, notes)\\n- `game.reduceMotion`: the player asked for less motion (prefers-reduced-motion): shake and flashes are softened\\n550→- `game.scene = null`: the scene running\\n- `game.sceneName = null`: its name ('main' for a game started with one scene)\\n- `game.scenes = null`: the scenes given to start(), by name\\n- `game.screen`: the low-resolution screen (its W, H, scale and buffer)\\n- `game.settings`: the player's choices (game.settings.volume, game.settings.set('volume', .5), your own from menu.settings), saved and applied (section 10b)\\n- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\\n- `game.stats`: per-frame timings (ms) and counts, for profiling overlays\\n- `game.stats.updateMs`, `game.stats.renderMs`: milliseconds the last frame spent updating and drawing\\n- `game.stats.frameMs`: the real time since the last frame\\n- `game.stats.steps`: the updates it ran\\n560→- `game.stats.items`: what it queued for drawing\\n- `game.stats.actors`: actors drawn\\n- `game.stats.culled`: actors skipped off screen\\n- `game.time = 0`: game seconds since start (it stops during pause and hit-stop, and slows with timeScale)\\n- `game.timeScale = 1`: game speed, 1 normal, .25 slow motion, 0 stopped (it outlives a scene change: a game's speed setting; restore a slow motion with a kept timer)\\n- `game.view`: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView)\\n- `game.views`: views this game is designed for (view cycling and the checker use it). null = every view\\n- `game.yaw = 0` †: its turn in degrees on top of the view (rotateView)\\n- `game.zoom = 1` †: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range\\n- `E.PLAYER_COLORS: #4a8aff, #ff4a4a, #4ad860, #ffd040` †: the players' colors: player 1 blue, 2 red, 3 green, 4 yellow (game.players)\\n570→- `E.showError(title, e)`: show an error in the red box at the top of the page (the engine does it for errors in update and draw); a click hides it. Before play has started it shows on the boot screen instead, as a report a player can screenshot\\n\\n## 10b. Standard features\\n\\n- `settings.default(key)`: a setting's default value\\n- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and applied; it shows on the settings screen. Returns its value\\n- `settings.keys(group)`: the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key\\n- `settings.reset(group)`: put a group's settings (or all of them) back to their defaults; a game's saves are not touched\\n- `settings.set(key, v)`: change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told. Returns the value kept (the old one when v is not a valid value)\\n- `settings.spec(key)`: the spec a setting was defined with (its label, type, range, options), or undefined\\n580→- `settings.saved`: false when the last save failed (storage blocked or full: the choices last for this visit)\\n- `fullscreen.enter(quiet)`: go full screen. Browsers allow it only from a tap, click or key press: call it from one (a button, the menu, a key's update step). Returns a promise of whether it worked (a refusal is kept in failed and noted on screen, unless quiet)\\n- `fullscreen.exit()`: leave full screen (Escape and the phone's back gesture do it too)\\n- `fullscreen.on`: true while the page is full screen\\n- `fullscreen.standalone`: true when the page was opened from a home screen as an app (no browser bars: nothing to go full screen from)\\n- `fullscreen.supported`: true where this page can go full screen (not an iPhone, which has Add to Home Screen instead; not a frame without permission; not headless)\\n- `fullscreen.toggle()`: full screen on or off, as the player asked (the corner's button, the menu): their choice is kept in settings.fullscreen, so a game starting on a phone goes full screen by itself only while they haven't turned it off\\n- `fullscreen.failed = null`: game: the game it serves; failed: why the last request was refused (a message), or null\\n\\n## 10c. Boot\\n590→\\n- `E.bootSplash(title = '')`: the boot screen's markup, for the very start of a page's <body>: it shows from the first paint, its bar moving while the page's scripts load (a pure CSS animation), and says so if the game's script never runs. The engine takes it over\\n- `E.diagnose(game = E.current)`: the report a bug needs, at any time (and on the boot screen when a game can't start): { engine, game, time, page, browser, device, screen, canvas, gpu, sound, storage, input, scene, errors, text (all of it, one line each, for a screenshot or a bug report), short (one line) }. game: the game to report on (E.current)\\n\\n## 10d. Tweens and scripts\\n\\n- `new E.Script(game, fn, o = {}) → script` †: a script, made by game.script: done (it returned, or was cancelled), value (what it returned), cancel(); another script can yield it\\n- `script.cancel()` †: stop it, and the scripts it is waiting on (its finally blocks run)\\n- `script.done = false` †: it returned, or was cancelled\\n- `script.keep` †: it outlives the scene\\n600→- `script.value` †: what it returned\\n- `new E.Tween(game, target, to, seconds, o = {}) → tween` †: a tween, made by game.tween: done (it ended, or was cancelled), cancel(); a script can yield it\\n- `tween.cancel()` †: stop it where it is (no onDone)\\n- `tween.done = false` †: it ended, or was cancelled\\n- `tween.keep` †: it outlives the scene\\n- `tween.target` †: what it moves\\n- `tween.to` †: the values it moves them to\\n- `E.all(list)` †: a script's wait for every one of its waits (seconds, conditions, tweens, scripts): yield E.all([a, b])\\n- `E.any(list)` †: a script's wait for the first of its waits to be over: yield E.any([boss.script, 30])\\n- `E.until(fn)` †: a script's wait until fn() is true: yield E.until(() => door.open)\\n610→\\n## 10e. Paths\\n\\n- `new E.Path(points, o = {}) → path` †: new E.Path(points, { closed: false, smooth: null }): points [x, y, z] (z optional) or { x, y, z } (a side view's height is z); closed runs back to the first; smooth: 'catmull' curves through every point (Catmull-Rom); at(d), nearest(x, y, z), draw(r) below\\n- `path.at(d)` †: the point d along it: { x, y, z, angle (its heading on the ground, radians: 0 east), d } (closed: d wraps round; open: held at the ends)\\n- `path.draw(r, color = '#ffe070')` †: draw it over the scene to see it (debugging): a line, and a dot at each of its points\\n- `path.nearest(x, y, z)` †: the distance along it of its point nearest (x, y) on the ground (and z, when given): a racer's progress round a track, a rail's grab point\\n- `path.closed` †: it runs back to the first\\n- `path.length` †: world units from end to end (round, when closed)\\n- `path.points` †: the points it was made from, [x, y, z] each\\n620→\\n## 10g. Weather\\n\\n- `E.WEATHER: rain, snow, ash, leaves, sand` †: the kinds of weather: n drops at amount 1, fall speed (world units a second), colors, streak (seconds of motion a drop's line shows), sway, rest (seconds it lies where it lands), splash, wind (how hard the wind pushes it), size, big (the share a pixel bigger). Add your own: E.WEATHER.embers = { ... }\\n\\n## 10k. Save slots\\n\\n- `new E.Saves(game, o) → saves` †: game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read })\\n- `saves.any` †: is there any save to load (a title's Continue)?\\n- `saves.autosave(o)` †: save to the autosave (what write() gives)\\n630→- `saves.copy(from, to)` †: copy a slot's save onto another (over what is there); false when the first is empty\\n- `saves.erase(slot)` †: erase a slot\\n- `saves.get(slot)` †: a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer: true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version }\\n- `saves.latest()` †: the most recent save that loads, or null (a title's Continue loads it)\\n- `saves.list()` †: every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows)\\n- `saves.load(slot)` †: load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version\\n- `saves.save(slot, o)` †: save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save\\n- `saves.show(mode = 'load', done)` †: open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or a save. False without a menu (a headless game, menu: false)\\n- `saves.blocked = false` †: storage refused a save (they last for the visit)\\n- `saves.canSave = true` †: the pause menu offers Save (a JRPG turns it off away from save points)\\n640→- `saves.game` †: its game\\n- `saves.migrate` †: an older version's data brought up to this one (or null: kept as it is)\\n- `saves.played = 0` †: seconds played in the game's scenes (paused time and titles left out), saved with each save and set by a load\\n- `saves.read` †: what a load does with { data, place, level, time, slot }\\n- `saves.slots` †: how many slots besides the autosave (3)\\n- `saves.version` †: the game's version of its data (1), saved with each save\\n- `saves.write` †: what a save holds ({ data, place, level })\\n\\n## 11. Humanoid rig\\n\\n650→- `new E.Attack(spec = {}, over) → slash`: new E.Attack(spec) or new E.Attack('slash', { reach: 9 }): a name from E.MOVES plus overrides\\n- `slash.active`: true while the strike can connect\\n- `slash.busy`: true from the wind-up to the end of the recovery\\n- `slash.cancel()`: stop the swing at once (hurt, dodged into)\\n- `slash.hits(targets, test, fn)`: during 'active', call fn(target) once per swing for each target where test(target) is true. Returns how many were hit\\n- `slash.start(canCancel = false)`: begin a swing if idle (or when canCancel and already recovering). Returns true if it started\\n- `slash.state`: what Humanoid.update wants as `attack` (null when idle)\\n- `slash.u`: 0..1 progress through the current phase\\n- `slash.update(dt)`: advance the swing by dt seconds; returns the phase that began during it ('active' = play the swing sound), or null\\n- `slash.hit`: the targets this swing has hit (each is hit once)\\n660→- `slash.phase = null`: 'wind' | 'active' | 'recover', or null when idle\\n- `slash.spec`: the move: seconds of wind, active and recover, and its shape for the rig (a0, a1, z0, z1, reach, hitAt)\\n- `slash.t = 0`: seconds into the phase\\n- `new E.Combo(specs, o = {}) → combo`: new E.Combo(items, { window: .3 }): items are move names, specs or Attacks\\n- `combo.active`: true while the current hit can connect\\n- `combo.busy`: true while a hit of the chain is swinging\\n- `combo.cancel()`: stop the chain; the next press starts it over\\n- `combo.current`: the Attack of the current hit\\n- `combo.hits(targets, test, fn)`: the current hit's hits(targets, test, fn): fn(target) once per swing where test(target) is true\\n- `combo.press()`: start or continue the chain. Returns true if a hit started\\n670→- `combo.state`: what Humanoid.update wants as `attack` (null when idle)\\n- `combo.update(dt)`: advance the current hit; returns the phase that began, as Attack.update\\n- `combo.idle = 99`: seconds since the last hit ended\\n- `combo.moves`: the Attacks\\n- `combo.step = -1`: the index of the current hit (-1 before the first)\\n- `combo.window`: seconds after a hit ends that a press still chains\\n- `new E.Humanoid(o = {}) → rig`: new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a character rig posed from math every step (API.md, \\\"Characters\\\", lists the options); update(dt, state) each step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style, color }; E.Humanoid.hat adds one); weapon: 'sword' | 'gun' | 'staff' (E.Humanoid.weapon adds one); hood: true (drawn in colors.hair); draw: { under(g, Q, rig), over(g, Q, rig) } the game's own drawing before and after the body (Q: the joints on screen, [x, y, depth]: outfits, accessories); seed: its own random stream (blinks, its clock)\",\"content_concise\":\"457→## 10. Game\\n\\n- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\\n460→- `new E.Game({ res })`: a fixed resolution ('ps1' or [w, h]), whole pixels\\n- `new E.Game({ expand })`: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars (expand: { maxW, maxH } stops it growing there)\\n- `new E.Game({ bg })`: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture under it (a 3D world, engine/my-3d2dge-3d.js)\\n- `new E.Game({ headless })`: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default): scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\\n- `new E.Game({ draw })`: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\\n- `new E.Game({ loop })`: false makes a game in a page that runs only by advance()\\n- `new E.Game({ menu })`: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\\n- `new E.Game({ fullscreen })`: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it off), 'button' (only when asked) or false\\n- `new E.Game({ corner, backGesture })`: corner: the menu and full-screen buttons (top right); backGesture: a phone's back steps back in the game first (false: it leaves the page)\\n- `new E.Game({ autoPause })`: a pausable scene pauses when the page is hidden or loses focus\\n470→- `new E.Game({ live })`: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it, the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\\n- `new E.Game({ id })`: the name the player's settings are saved under (the page's path)\\n- `new E.Game({ pace })`: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every other one, evenly), unless the player picks Frame rate 60\\n- `new E.Game({ camera })`: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\\n- `game.H`: the screen's height in game pixels (W is its width)\\n- `game.W`: internal buffer size in pixels (HUD layout)\\n- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\\n- `game.advance(seconds = this.o.step, o = {})`: run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test that catches what a player would see break). Returns the updates run\\n- `game.after(seconds, fn, o = {})`: run fn once after `seconds` of game time. Cleared on scene change, unless { keep: true } (a site's clock, a watcher of the whole game: it outlives scenes, as a kept tween does). Returns { cancel() }\\n- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\\n480→- `game.back()`: a step back, as a phone's back gesture asks for (the engine calls it for one; a back button of the game's own can): the open menu screen goes back one; else the scene's own back() takes it (it returns true when it did); else a scene in play pauses into the menu, and a paused one goes on. Returns false where there is nowhere to go (a title)\\n- `game.cornerArea()` †: where the corner's buttons (menu and full screen, top right; the touch START) cover the screen, in screen pixels { x0, y0, x1, y1 } (r.W and r.H's space), or null while none show: keep a HUD clear of it\\n- `game.dispose()`: end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window, the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and tools that make many games call it; the canvas stays\\n- `game.enableGPU(o = {})` †: turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... }\\n- `game.every(seconds, fn, o = {})`: run fn every `seconds` of game time. Cleared on scene change, unless { keep: true }. Returns { cancel() }\\n- `game.fail(where, e)`: report an error in game code without stopping the game: logged once per place and message, kept in game.errors and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err)\\n- `game.flash(color = '#ffffff', seconds = .12, strength = 1)`: flash the whole screen with a color for `seconds` (dithered fade out): hits, explosions, lightning. Shorter when reduceMotion, dimmer by the player's settings.flashes\\n- `game.focus(x, y, z = 0)`: camera follows this world point. Side-scrollers: game.focus(x, 0, z)\\n- `game.follow(target, o = {})`: keep the camera on an object automatically (instead of calling focus every update). opts: { z: extra height to look at (default 16), lead: look ahead in the facing / moving direction }. follow(null) stops.\\n- `game.freeze(s)`: hit-stop: the game stands still for s seconds (.04-.08 for a hit); input still ticks\\n490→- `game.go(name, data, o = {})`: switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\\n- `game.hitFx(x, y, z, o = {})`: everything a good hit needs in one call: hit-stop, shake, an impact star, sparks along the hit direction, a sound, a damage number and a rumble on a gamepad. hitFx(x, y, z, { power: 1, angle, damage, color, sound: 'hit', rumble: true })\\n- `game.hook(kind, fn)` †: a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it\\n- `game.menu(name, o)`: open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play. o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when a menu opened\\n- `game.mouseGround()`: the mouse's point on the ground: [x, y] in world units (an array, not { x, y }), or null with no mouse over the canvas\\n- `game.nextView(dir = 1)`: cycle through game.views (or every view): bind it to a key for players who like to switch\\n- `game.note(text, seconds = 1.2)`, `game.shownNote`: a short notice at the top of the screen (zoom level, saved, ...): game.note('ZOOM 1.5x', 1). game.shownNote is the one showing, { text, end } (end in game.real seconds), or null: a game that draws it its own way takes it and sets shownNote to null\\n- `game.onView(f)` †: call f(view) whenever the view changes (re-bake caches, move HUD)\\n- `game.pause(reason = 'player')`: pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused. The player resumes (Escape, Start, Resume); resume() does it from code\\n- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\\n500→- `game.removePlayer(p)` †: a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it\\n- `game.resetCamera()` †: undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1 without), no turn. The player's zoom stays (settings.zoom)\\n- `game.resume()`: take the game out of pause (and close the pause screen)\\n- `game.rotateView(deg)` †: turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn\\n- `game.saves()` †: game.saves: the save slots (section 10k), made when first read\\n- `game.script(fn, o)` †: run a coroutine on game time, in the update step: game.script(function* (game) { yield .5; yield E.until(() => door.open); yield game.tween(cam, { y: 0 }, 1); yield E.all([a, b]); ... }, { keep }). Each yield waits: a number (seconds), nothing (one step), a condition (a function, or E.until(fn)), a tween or script (until it is done), a generator (run as a script of its own, and waited for), E.all([...]) or E.any([...]) (each of these). It runs at once to its first yield. Cutscenes, boss patterns, wave timelines, tutorials, attract modes. Returns the Script\\n- `game.setView(v)`: switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn\\n- `game.setZoom(z)` †: camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\\n- `game.shake(a)`: shake the screen by a (pixels, decaying; at most 10 in all); none when reduceMotion, scaled by the player's settings.shake\\n- `game.shaking` †: how hard the screen shakes now (0 still, up to 10): shake() adds to it and it dies away. A camera of the game's own (a 3D world's) shakes by it\\n510→- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 }\\n- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera } (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only by advance().\\n- `game.start({ view, views, input, res, expand, touch })`: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'), expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\\n- `game.start({ back })`: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a sub-menu closed)\\n- `game.start({ camera })`: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\\n- `game.start({ boot })`: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\\n- `game.stop()`: stop the loop; the game keeps its state, and start() resumes it\\n- `game.tween(target, to, seconds, o)` †: ease target's numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }). ease: a name in E.ease ('outQuad' by default) or a function of u 0..1. It starts from the values the target has once its delay is over. Returns the Tween: tween.done, tween.cancel()\\n- `game.upright`: true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom applies then: it zooms a tall picture in to fill it\\n- `game.viewports` †: a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or [] on one screen\\n520→- `game.zoomBy(k)` †: the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does nothing where the scene doesn't let the player zoom. Returns the zoom\\n- `game.zoomRange()` †: the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of the game gives one per screen shape or level), or null where they can't (camera.zoom false or none)\\n- `game.alpha = .5`: the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count\\n- `game.audio`: chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song)\\n- `game.baseView` †: the chosen view without zoom and turn\\n- `game.bootError = null`: the error a boot step failed with (the game did not start), or null\\n- `game.booted`: a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a test whose boot steps return promises\\n- `game.cam`: camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the screen's centre to where the focus sits (above a phone's touch buttons: [0, -40]); x, y: the camera's position in projected pixels (its top-left corner); vx, vy: how fast it is moving there; tx, ty, tz: the world point it is following (focus sets it); snap: true makes it jump there at the next step instead of gliding (a new level, a teleport); window: [w, h] screen pixels, a dead zone round the focus it moves in before the camera follows (Super Mario World's; [48, 0] for sideways only); snapY: true follows a followed body's height only when it lands (onGround) or nears the screen's edge (side-scrollers); frame(targets, { margin: 24, zoom: [min, max] or false }) keeps every one of them (anything with x, y, z) in view, centered between them and zoomed out (no further than min) when they spread apart, until frame(null); free: a free camera (strategy, sims, board games): true or { keys: true, edge: 10, drag: true, speed: 300, bounds: [x0, y0, x1, y1] }: the keys or a pad's stick pan it (input.move(), speed screen pixels a second), the mouse at the screen's edge (within edge pixels), a drag (input.pan(): a finger on open ground, a mouse's middle or right button) one to one; a zoom (wheel, pinch) zooms toward the pointer or the pinch; its focus keeps to bounds (world x, y); focus() still moves it; in every view and turn; null (as it starts): off\\n- `game.debug = null`: a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }. tools/check.mjs prints snapshot() and tools/replay.mjs logs it at the end\\n- `game.disposed = true`: true after dispose()\\n530→- `game.drawEvery = 1`: 1, or 2 while a fast display (a 120 Hz phone) refreshes quicker than the game can draw (a frame's cost, or refreshes missed: its GPU behind): every other refresh is drawn, evenly, instead of random ones missed (the updates still run every refresh). The player's Frame rate setting (game.settings.frameRate: 'auto', '60', 'full') can fix it at 2 or 1\\n- `game.errors = []`: the errors caught in update and draw, each { where, scene, message, stack }, once per kind\\n- `game.fadeTime = .22`: seconds for the dithered fade between scenes (0 = instant cuts)\\n- `game.fps = 60`: frames drawn per second over the last half second of real time\\n- `game.fullscreen`: full screen: game.fullscreen.toggle(), .on, .supported\\n- `game.gpu = null` †: the WebGPU lighting after enableGPU(), or null\\n- `game.headless`: true for a game with no display (o.headless, or no DOM: Node)\\n- `game.hitstop = 0`: seconds of hit-stop left (freeze: a scene's entry ends it)\\n- `game.hz = 60`: the display's refresh rate, measured\\n- `game.input`: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...)\\n540→- `game.lights` †: canvas lighting (lights.enabled, lights.add in draw)\\n- `game.live` †: true (o.live): a pause opens the menus over a world that keeps stepping (an online or shared world can't stop for one player): paused is true and the scene's update goes on, the menu holding the player's own input back\\n- `game.o`: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg, step, input, loop, headless)\\n- `game.particles`: dust, sparks, debris and text in the world\\n- `game.pauseOverlay = true`: false hides the engine's PAUSED overlay (a game drawing its own pause screen)\\n- `game.pauseReason = null`: why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null\\n- `game.paused = false`: true while paused (a pausable scene toggles it on 'pause'; steps still run, scenes don't update)\\n- `game.r`: the renderer handed to draw(r) (null when headless)\\n- `game.real = 0`: seconds the game has stepped through, pauses and hit-stop included (blinking HUD, notes)\\n- `game.reduceMotion`: the player asked for less motion (prefers-reduced-motion): shake and flashes are softened\\n550→- `game.scene = null`: the scene running\\n- `game.sceneName = null`: its name ('main' for a game started with one scene)\\n- `game.scenes = null`: the scenes given to start(), by name\\n- `game.screen`: the low-resolution screen (its W, H, scale and buffer)\\n- `game.settings`: the player's choices (game.settings.volume, game.settings.set('volume', .5), your own from menu.settings), saved and applied (section 10b)\\n- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\\n- `game.stats`: per-frame timings (ms) and counts, for profiling overlays\\n- `game.stats.updateMs`, `game.stats.renderMs`: milliseconds the last frame spent updating and drawing\\n- `game.stats.frameMs`: the real time since the last frame\\n- `game.stats.steps`: the updates it ran\\n560→- `game.stats.items`: what it queued for drawing\\n- `game.stats.actors`: actors drawn\\n- `game.stats.culled`: actors skipped off screen\\n- `game.time = 0`: game seconds since start (it stops during pause and hit-stop, and slows with timeScale)\\n- `game.timeScale = 1`: game speed, 1 normal, .25 slow motion, 0 stopped (it outlives a scene change: a game's speed setting; restore a slow motion with a kept timer)\\n- `game.view`: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView)\\n- `game.views`: views this game is designed for (view cycling and the checker use it). null = every view\\n- `game.yaw = 0` †: its turn in degrees on top of the view (rotateView)\\n- `game.zoom = 1` †: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range\\n- `E.PLAYER_COLORS: #4a8aff, #ff4a4a, #4ad860, #ffd040` †: the players' colors: player 1 blue, 2 red, 3 green, 4 yellow (game.players)\\n570→- `E.showError(title, e)`: show an error in the red box at the top of the page (the engine does it for errors in update and draw); a click hides it. Before play has started it shows on the boot screen instead, as a report a player can screenshot\\n\\n## 10b. Standard features\\n\\n- `settings.default(key)`: a setting's default value\\n- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and applied; it shows on the settings screen. Returns its value\\n- `settings.keys(group)`: the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key\\n- `settings.reset(group)`: put a group's settings (or all of them) back to their defaults; a game's saves are not touched\\n- `settings.set(key, v)`: change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told. Returns the value kept (the old one when v is not a valid value)\\n- `settings.spec(key)`: the spec a setting was defined with (its label, type, range, options), or undefined\\n580→- `settings.saved`: false when the last save failed (storage blocked or full: the choices last for this visit)\\n- `fullscreen.enter(quiet)`: go full screen. Browsers allow it only from a tap, click or key press: call it from one (a button, the menu, a key's update step). Returns a promise of whether it worked (a refusal is kept in failed and noted on screen, unless quiet)\\n- `fullscreen.exit()`: leave full screen (Escape and the phone's back gesture do it too)\\n- `fullscreen.on`: true while the page is full screen\\n- `fullscreen.standalone`: true when the page was opened from a home screen as an app (no browser bars: nothing to go full screen from)\\n- `fullscreen.supported`: true where this page can go full screen (not an iPhone, which has Add to Home Screen instead; not a frame without permission; not headless)\\n- `fullscreen.toggle()`: full screen on or off, as the player asked (the corner's button, the menu): their choice is kept in settings.fullscreen, so a game starting on a phone goes full screen by itself only while they haven't turned it off\\n- `fullscreen.failed = null`: game: the game it serves; failed: why the last request was refused (a message), or null\\n\\n## 10c. Boot\\n590→\\n- `E.bootSplash(title = '')`: the boot screen's markup, for the very start of a page's <body>: it shows from the first paint, its bar moving while the page's scripts load (a pure CSS animation), and says so if the game's script never runs. The engine takes it over\\n- `E.diagnose(game = E.current)`: the report a bug needs, at any time (and on the boot screen when a game can't start): { engine, game, time, page, browser, device, screen, canvas, gpu, sound, storage, input, scene, errors, text (all of it, one line each, for a screenshot or a bug report), short (one line) }. game: the game to report on (E.current)\\n\\n## 10d. Tweens and scripts\\n\\n- `new E.Script(game, fn, o = {}) → script` †: a script, made by game.script: done (it returned, or was cancelled), value (what it returned), cancel(); another script can yield it\\n- `script.cancel()` †: stop it, and the scripts it is waiting on (its finally blocks run)\\n- `script.done = false` †: it returned, or was cancelled\\n- `script.keep` †: it outlives the scene\\n600→- `script.value` †: what it returned\\n- `new E.Tween(game, target, to, seconds, o = {}) → tween` †: a tween, made by game.tween: done (it ended, or was cancelled), cancel(); a script can yield it\\n- `tween.cancel()` †: stop it where it is (no onDone)\\n- `tween.done = false` †: it ended, or was cancelled\\n- `tween.keep` †: it outlives the scene\\n- `tween.target` †: what it moves\\n- `tween.to` †: the values it moves them to\\n- `E.all(list)` †: a script's wait for every one of its waits (seconds, conditions, tweens, scripts): yield E.all([a, b])\\n- `E.any(list)` †: a script's wait for the first of its waits to be over: yield E.any([boss.script, 30])\\n- `E.until(fn)` †: a script's wait until fn() is true: yield E.until(() => door.open)\\n610→\\n## 10e. Paths\\n\\n- `new E.Path(points, o = {}) → path` †: new E.Path(points, { closed: false, smooth: null }): points [x, y, z] (z optional) or { x, y, z } (a side view's height is z); closed runs back to the first; smooth: 'catmull' curves through every point (Catmull-Rom); at(d), nearest(x, y, z), draw(r) below\\n- `path.at(d)` †: the point d along it: { x, y, z, angle (its heading on the ground, radians: 0 east), d } (closed: d wraps round; open: held at the ends)\\n- `path.draw(r, color = '#ffe070')` †: draw it over the scene to see it (debugging): a line, and a dot at each of its points\\n- `path.nearest(x, y, z)` †: the distance along it of its point nearest (x, y) on the ground (and z, when given): a racer's progress round a track, a rail's grab point\\n- `path.closed` †: it runs back to the first\\n- `path.length` †: world units from end to end (round, when closed)\\n- `path.points` †: the points it was made from, [x, y, z] each\\n620→\\n## 10g. Weather\\n\\n- `E.WEATHER: rain, snow, ash, leaves, sand` †: the kinds of weather: n drops at amount 1, fall speed (world units a second), colors, streak (seconds of motion a drop's line shows), sway, rest (seconds it lies where it lands), splash, wind (how hard the wind pushes it), size, big (the share a pixel bigger). Add your own: E.WEATHER.embers = { ... }\\n\\n## 10k. Save slots\\n\\n- `new E.Saves(game, o) → saves` †: game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read })\\n- `saves.any` †: is there any save to load (a title's Continue)?\\n- `saves.autosave(o)` †: save to the autosave (what write() gives)\\n630→- `saves.copy(from, to)` †: copy a slot's save onto another (over what is there); false when the first is empty\\n- `saves.erase(slot)` †: erase a slot\\n- `saves.get(slot)` †: a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer: true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version }\\n- `saves.latest()` †: the most recent save that loads, or null (a title's Continue loads it)\\n- `saves.list()` †: every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows)\\n- `saves.load(slot)` †: load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version\\n- `saves.save(slot, o)` †: save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save\\n- `saves.show(mode = 'load', done)` †: open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or a save. False without a menu (a headless game, menu: false)\\n- `saves.blocked = false` †: storage refused a save (they last for the visit)\\n- `saves.canSave = true` †: the pause menu offers Save (a JRPG turns it off away from save points)\\n640→- `saves.game` †: its game\\n- `saves.migrate` †: an older version's data brought up to this one (or null: kept as it is)\\n- `saves.played = 0` †: seconds played in the game's scenes (paused time and titles left out), saved with each save and set by a load\\n- `saves.read` †: what a load does with { data, place, level, time, slot }\\n- `saves.slots` †: how many slots besides the autosave (3)\\n- `saves.version` †: the game's version of its data (1), saved with each save\\n- `saves.write` †: what a save holds ({ data, place, level })\\n\\n## 11. Humanoid rig\\n\\n650→- `new E.Attack(spec = {}, over) → slash`: new E.Attack(spec) or new E.Attack('slash', { reach: 9 }): a name from E.MOVES plus overrides\\n- `slash.active`: true while the strike can connect\\n- `slash.busy`: true from the wind-up to the end of the recovery\\n- `slash.cancel()`: stop the swing at once (hurt, dodged into)\\n- `slash.hits(targets, test, fn)`: during 'active', call fn(target) once per swing for each target where test(target) is true. Returns how many were hit\\n- `slash.start(canCancel = false)`: begin a swing if idle (or when canCancel and already recovering). Returns true if it started\\n- `slash.state`: what Humanoid.update wants as `attack` (null when idle)\\n- `slash.u`: 0..1 progress through the current phase\\n- `slash.update(dt)`: advance the swing by dt seconds; returns the phase that began during it ('active' = play the swing sound), or null\\n- `slash.hit`: the targets this swing has hit (each is hit once)\\n660→- `slash.phase = null`: 'wind' | 'active' | 'recover', or null when idle\\n- `slash.spec`: the move: seconds of wind, active and recover, and its shape for the rig (a0, a1, z0, z1, reach, hitAt)\\n- `slash.t = 0`: seconds into the phase\\n- `new E.Combo(specs, o = {}) → combo`: new E.Combo(items, { window: .3 }): items are move names, specs or Attacks\\n- `combo.active`: true while the current hit can connect\\n- `combo.busy`: true while a hit of the chain is swinging\\n- `combo.cancel()`: stop the chain; the next press starts it over\\n- `combo.current`: the Attack of the current hit\\n- `combo.hits(targets, test, fn)`: the current hit's hits(targets, test, fn): fn(target) once per swing where test(target) is true\\n- `combo.press()`: start or continue the chain. Returns true if a hit started\\n670→- `combo.state`: what Humanoid.update wants as `attack` (null when idle)\\n- `combo.update(dt)`: advance the current hit; returns the phase that began, as Attack.update\\n- `combo.idle = 99`: seconds since the last hit ended\\n- `combo.moves`: the Attacks\\n- `combo.step = -1`: the index of the current hit (-1 before the first)\\n- `combo.window`: seconds after a hit ends that a press still chains\\n- `new E.Humanoid(o = {}) → rig`: new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a character rig posed from math every step (API.md, \\\"Characters\\\", lists the options); update(dt, state) each step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style, color }; E.Humanoid.hat adds one); weapon: 'sword' | 'gun' | 'staff' (E.Humanoid.weapon adds one); hood: true (drawn in colors.hair); draw: { under(g, Q, rig), over(g, Q, rig) } the game's own drawing before and after the body (Q: the joints on screen, [x, y, depth]: outfits, accessories); seed: its own random stream (blinks, its clock)\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/API-INDEX.md\",\"offset\":457,\"limit\":220,\"raw_output\":\"## 10. Game\\n\\n- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\\n- `new E.Game({ res })`: a fixed resolution ('ps1' or [w, h]), whole pixels\\n- `new E.Game({ expand })`: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars (expand: { maxW, maxH } stops it growing there)\\n- `new E.Game({ bg })`: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture under it (a 3D world, engine/my-3d2dge-3d.js)\\n- `new E.Game({ headless })`: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default): scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\\n- `new E.Game({ draw })`: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\\n- `new E.Game({ loop })`: false makes a game in a page that runs only by advance()\\n- `new E.Game({ menu })`: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\\n- `new E.Game({ fullscreen })`: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it off), 'button' (only when asked) or false\\n- `new E.Game({ corner, backGesture })`: corner: the menu and full-screen buttons (top right); backGesture: a phone's back steps back in the game first (false: it leaves the page)\\n- `new E.Game({ autoPause })`: a pausable scene pauses when the page is hidden or loses focus\\n- `new E.Game({ live })`: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it, the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\\n- `new E.Game({ id })`: the name the player's settings are saved under (the page's path)\\n- `new E.Game({ pace })`: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every other one, evenly), unless the player picks Frame rate 60\\n- `new E.Game({ camera })`: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\\n- `game.H`: the screen's height in game pixels (W is its width)\\n- `game.W`: internal buffer size in pixels (HUD layout)\\n- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\\n- `game.advance(seconds = this.o.step, o = {})`: run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test that catches what a player would see break). Returns the updates run\\n- `game.after(seconds, fn, o = {})`: run fn once after `seconds` of game time. Cleared on scene change, unless { keep: true } (a site's clock, a watcher of the whole game: it outlives scenes, as a kept tween does). Returns { cancel() }\\n- `game.allowJoin(o = {})` †: let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's)\\n- `game.back()`: a step back, as a phone's back gesture asks for (the engine calls it for one; a back button of the game's own can): the open menu screen goes back one; else the scene's own back() takes it (it returns true when it did); else a scene in play pauses into the menu, and a paused one goes on. Returns false where there is nowhere to go (a title)\\n- `game.cornerArea()` †: where the corner's buttons (menu and full screen, top right; the touch START) cover the screen, in screen pixels { x0, y0, x1, y1 } (r.W and r.H's space), or null while none show: keep a HUD clear of it\\n- `game.dispose()`: end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window, the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and tools that make many games call it; the canvas stays\\n- `game.enableGPU(o = {})` †: turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... }\\n- `game.every(seconds, fn, o = {})`: run fn every `seconds` of game time. Cleared on scene change, unless { keep: true }. Returns { cancel() }\\n- `game.fail(where, e)`: report an error in game code without stopping the game: logged once per place and message, kept in game.errors and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err)\\n- `game.flash(color = '#ffffff', seconds = .12, strength = 1)`: flash the whole screen with a color for `seconds` (dithered fade out): hits, explosions, lightning. Shorter when reduceMotion, dimmer by the player's settings.flashes\\n- `game.focus(x, y, z = 0)`: camera follows this world point. Side-scrollers: game.focus(x, 0, z)\\n- `game.follow(target, o = {})`: keep the camera on an object automatically (instead of calling focus every update). opts: { z: extra height to look at (default 16), lead: look ahead in the facing / moving direction }. follow(null) stops.\\n- `game.freeze(s)`: hit-stop: the game stands still for s seconds (.04-.08 for a hit); input still ticks\\n- `game.go(name, data, o = {})`: switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\\n- `game.hitFx(x, y, z, o = {})`: everything a good hit needs in one call: hit-stop, shake, an impact star, sparks along the hit direction, a sound, a damage number and a rumble on a gamepad. hitFx(x, y, z, { power: 1, angle, damage, color, sound: 'hit', rumble: true })\\n- `game.hook(kind, fn)` †: a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it\\n- `game.menu(name, o)`: open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play. o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when a menu opened\\n- `game.mouseGround()`: the mouse's point on the ground: [x, y] in world units (an array, not { x, y }), or null with no mouse over the canvas\\n- `game.nextView(dir = 1)`: cycle through game.views (or every view): bind it to a key for players who like to switch\\n- `game.note(text, seconds = 1.2)`, `game.shownNote`: a short notice at the top of the screen (zoom level, saved, ...): game.note('ZOOM 1.5x', 1). game.shownNote is the one showing, { text, end } (end in game.real seconds), or null: a game that draws it its own way takes it and sets shownNote to null\\n- `game.onView(f)` †: call f(view) whenever the view changes (re-bake caches, move HUD)\\n- `game.pause(reason = 'player')`: pause the game, saying why ('player' | 'focus' | 'controller' | 'menu': pauseReason); returns true if it paused. The player resumes (Escape, Start, Resume); resume() does it from code\\n- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\\n- `game.removePlayer(p)` †: a player leaves (its input, or its number, 2 to 4); player 1 has the whole keyboard back when no one shares it\\n- `game.resetCamera()` †: undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1 without), no turn. The player's zoom stays (settings.zoom)\\n- `game.resume()`: take the game out of pause (and close the pause screen)\\n- `game.rotateView(deg)` †: turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn\\n- `game.saves()` †: game.saves: the save slots (section 10k), made when first read\\n- `game.script(fn, o)` †: run a coroutine on game time, in the update step: game.script(function* (game) { yield .5; yield E.until(() => door.open); yield game.tween(cam, { y: 0 }, 1); yield E.all([a, b]); ... }, { keep }). Each yield waits: a number (seconds), nothing (one step), a condition (a function, or E.until(fn)), a tween or script (until it is done), a generator (run as a script of its own, and waited for), E.all([...]) or E.any([...]) (each of these). It runs at once to its first yield. Cutscenes, boss patterns, wave timelines, tutorials, attract modes. Returns the Script\\n- `game.setView(v)`: switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn\\n- `game.setZoom(z)` †: camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\\n- `game.shake(a)`: shake the screen by a (pixels, decaying; at most 10 in all); none when reduceMotion, scaled by the player's settings.shake\\n- `game.shaking` †: how hard the screen shakes now (0 still, up to 10): shake() adds to it and it dies away. A camera of the game's own (a 3D world's) shakes by it\\n- `game.splitScreen(n, o = {})` †: split the screen into n viewports (2 to 4; 0 or 1: one screen again), o: { layout: 'auto' (side by side on a wide screen, stacked on a tall one; a grid for 3 or 4) | 'columns' | 'rows' | 'grid', follow: [targets], z: 16, gap: 1 }\\n- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera } (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only by advance().\\n- `game.start({ view, views, input, res, expand, touch })`: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'), expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\\n- `game.start({ back })`: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a sub-menu closed)\\n- `game.start({ camera })`: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\\n- `game.start({ boot })`: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\\n- `game.stop()`: stop the loop; the game keeps its state, and start() resumes it\\n- `game.tween(target, to, seconds, o)` †: ease target's numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }). ease: a name in E.ease ('outQuad' by default) or a function of u 0..1. It starts from the values the target has once its delay is over. Returns the Tween: tween.done, tween.cancel()\\n- `game.upright`: true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom applies then: it zooms a tall picture in to fill it\\n- `game.viewports` †: a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or [] on one screen\\n- `game.zoomBy(k)` †: the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does nothing where the scene doesn't let the player zoom. Returns the zoom\\n- `game.zoomRange()` †: the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of the game gives one per screen shape or level), or null where they can't (camera.zoom false or none)\\n- `game.alpha = .5`: the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count\\n- `game.audio`: chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song)\\n- `game.baseView` †: the chosen view without zoom and turn\\n- `game.bootError = null`: the error a boot step failed with (the game did not start), or null\\n- `game.booted`: a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a test whose boot steps return promises\\n- `game.cam`: camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the screen's centre to where the focus sits (above a phone's touch buttons: [0, -40]); x, y: the camera's position in projected pixels (its top-left corner); vx, vy: how fast it is moving there; tx, ty, tz: the world point it is following (focus sets it); snap: true makes it jump there at the next step instead of gliding (a new level, a teleport); window: [w, h] screen pixels, a dead zone round the focus it moves in before the camera follows (Super Mario World's; [48, 0] for sideways only); snapY: true follows a followed body's height only when it lands (onGround) or nears the screen's edge (side-scrollers); frame(targets, { margin: 24, zoom: [min, max] or false }) keeps every one of them (anything with x, y, z) in view, centered between them and zoomed out (no further than min) when they spread apart, until frame(null); free: a free camera (strategy, sims, board games): true or { keys: true, edge: 10, drag: true, speed: 300, bounds: [x0, y0, x1, y1] }: the keys or a pad's stick pan it (input.move(), speed screen pixels a second), the mouse at the screen's edge (within edge pixels), a drag (input.pan(): a finger on open ground, a mouse's middle or right button) one to one; a zoom (wheel, pinch) zooms toward the pointer or the pinch; its focus keeps to bounds (world x, y); focus() still moves it; in every view and turn; null (as it starts): off\\n- `game.debug = null`: a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }. tools/check.mjs prints snapshot() and tools/replay.mjs logs it at the end\\n- `game.disposed = true`: true after dispose()\\n- `game.drawEvery = 1`: 1, or 2 while a fast display (a 120 Hz phone) refreshes quicker than the game can draw (a frame's cost, or refreshes missed: its GPU behind): every other refresh is drawn, evenly, instead of random ones missed (the updates still run every refresh). The player's Frame rate setting (game.settings.frameRate: 'auto', '60', 'full') can fix it at 2 or 1\\n- `game.errors = []`: the errors caught in update and draw, each { where, scene, message, stack }, once per kind\\n- `game.fadeTime = .22`: seconds for the dithered fade between scenes (0 = instant cuts)\\n- `game.fps = 60`: frames drawn per second over the last half second of real time\\n- `game.fullscreen`: full screen: game.fullscreen.toggle(), .on, .supported\\n- `game.gpu = null` †: the WebGPU lighting after enableGPU(), or null\\n- `game.headless`: true for a game with no display (o.headless, or no DOM: Node)\\n- `game.hitstop = 0`: seconds of hit-stop left (freeze: a scene's entry ends it)\\n- `game.hz = 60`: the display's refresh rate, measured\\n- `game.input`: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...)\\n- `game.lights` †: canvas lighting (lights.enabled, lights.add in draw)\\n- `game.live` †: true (o.live): a pause opens the menus over a world that keeps stepping (an online or shared world can't stop for one player): paused is true and the scene's update goes on, the menu holding the player's own input back\\n- `game.o`: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg, step, input, loop, headless)\\n- `game.particles`: dust, sparks, debris and text in the world\\n- `game.pauseOverlay = true`: false hides the engine's PAUSED overlay (a game drawing its own pause screen)\\n- `game.pauseReason = null`: why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null\\n- `game.paused = false`: true while paused (a pausable scene toggles it on 'pause'; steps still run, scenes don't update)\\n- `game.r`: the renderer handed to draw(r) (null when headless)\\n- `game.real = 0`: seconds the game has stepped through, pauses and hit-stop included (blinking HUD, notes)\\n- `game.reduceMotion`: the player asked for less motion (prefers-reduced-motion): shake and flashes are softened\\n- `game.scene = null`: the scene running\\n- `game.sceneName = null`: its name ('main' for a game started with one scene)\\n- `game.scenes = null`: the scenes given to start(), by name\\n- `game.screen`: the low-resolution screen (its W, H, scale and buffer)\\n- `game.settings`: the player's choices (game.settings.volume, game.settings.set('volume', .5), your own from menu.settings), saved and applied (section 10b)\\n- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\\n- `game.stats`: per-frame timings (ms) and counts, for profiling overlays\\n- `game.stats.updateMs`, `game.stats.renderMs`: milliseconds the last frame spent updating and drawing\\n- `game.stats.frameMs`: the real time since the last frame\\n- `game.stats.steps`: the updates it ran\\n- `game.stats.items`: what it queued for drawing\\n- `game.stats.actors`: actors drawn\\n- `game.stats.culled`: actors skipped off screen\\n- `game.time = 0`: game seconds since start (it stops during pause and hit-stop, and slows with timeScale)\\n- `game.timeScale = 1`: game speed, 1 normal, .25 slow motion, 0 stopped (it outlives a scene change: a game's speed setting; restore a slow motion with a kept timer)\\n- `game.view`: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView)\\n- `game.views`: views this game is designed for (view cycling and the checker use it). null = every view\\n- `game.yaw = 0` †: its turn in degrees on top of the view (rotateView)\\n- `game.zoom = 1` †: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range\\n- `E.PLAYER_COLORS: #4a8aff, #ff4a4a, #4ad860, #ffd040` †: the players' colors: player 1 blue, 2 red, 3 green, 4 yellow (game.players)\\n- `E.showError(title, e)`: show an error in the red box at the top of the page (the engine does it for errors in update and draw); a click hides it. Before play has started it shows on the boot screen instead, as a report a player can screenshot\\n\\n## 10b. Standard features\\n\\n- `settings.default(key)`: a setting's default value\\n- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and applied; it shows on the settings screen. Returns its value\\n- `settings.keys(group)`: the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key\\n- `settings.reset(group)`: put a group's settings (or all of them) back to their defaults; a game's saves are not touched\\n- `settings.set(key, v)`: change a setting: checked (a slider kept in range, a choice among its options), saved, applied, onChange told. Returns the value kept (the old one when v is not a valid value)\\n- `settings.spec(key)`: the spec a setting was defined with (its label, type, range, options), or undefined\\n- `settings.saved`: false when the last save failed (storage blocked or full: the choices last for this visit)\\n- `fullscreen.enter(quiet)`: go full screen. Browsers allow it only from a tap, click or key press: call it from one (a button, the menu, a key's update step). Returns a promise of whether it worked (a refusal is kept in failed and noted on screen, unless quiet)\\n- `fullscreen.exit()`: leave full screen (Escape and the phone's back gesture do it too)\\n- `fullscreen.on`: true while the page is full screen\\n- `fullscreen.standalone`: true when the page was opened from a home screen as an app (no browser bars: nothing to go full screen from)\\n- `fullscreen.supported`: true where this page can go full screen (not an iPhone, which has Add to Home Screen instead; not a frame without permission; not headless)\\n- `fullscreen.toggle()`: full screen on or off, as the player asked (the corner's button, the menu): their choice is kept in settings.fullscreen, so a game starting on a phone goes full screen by itself only while they haven't turned it off\\n- `fullscreen.failed = null`: game: the game it serves; failed: why the last request was refused (a message), or null\\n\\n## 10c. Boot\\n\\n- `E.bootSplash(title = '')`: the boot screen's markup, for the very start of a page's <body>: it shows from the first paint, its bar moving while the page's scripts load (a pure CSS animation), and says so if the game's script never runs. The engine takes it over\\n- `E.diagnose(game = E.current)`: the report a bug needs, at any time (and on the boot screen when a game can't start): { engine, game, time, page, browser, device, screen, canvas, gpu, sound, storage, input, scene, errors, text (all of it, one line each, for a screenshot or a bug report), short (one line) }. game: the game to report on (E.current)\\n\\n## 10d. Tweens and scripts\\n\\n- `new E.Script(game, fn, o = {}) → script` †: a script, made by game.script: done (it returned, or was cancelled), value (what it returned), cancel(); another script can yield it\\n- `script.cancel()` †: stop it, and the scripts it is waiting on (its finally blocks run)\\n- `script.done = false` †: it returned, or was cancelled\\n- `script.keep` †: it outlives the scene\\n- `script.value` †: what it returned\\n- `new E.Tween(game, target, to, seconds, o = {}) → tween` †: a tween, made by game.tween: done (it ended, or was cancelled), cancel(); a script can yield it\\n- `tween.cancel()` †: stop it where it is (no onDone)\\n- `tween.done = false` †: it ended, or was cancelled\\n- `tween.keep` †: it outlives the scene\\n- `tween.target` †: what it moves\\n- `tween.to` †: the values it moves them to\\n- `E.all(list)` †: a script's wait for every one of its waits (seconds, conditions, tweens, scripts): yield E.all([a, b])\\n- `E.any(list)` †: a script's wait for the first of its waits to be over: yield E.any([boss.script, 30])\\n- `E.until(fn)` †: a script's wait until fn() is true: yield E.until(() => door.open)\\n\\n## 10e. Paths\\n\\n- `new E.Path(points, o = {}) → path` †: new E.Path(points, { closed: false, smooth: null }): points [x, y, z] (z optional) or { x, y, z } (a side view's height is z); closed runs back to the first; smooth: 'catmull' curves through every point (Catmull-Rom); at(d), nearest(x, y, z), draw(r) below\\n- `path.at(d)` †: the point d along it: { x, y, z, angle (its heading on the ground, radians: 0 east), d } (closed: d wraps round; open: held at the ends)\\n- `path.draw(r, color = '#ffe070')` †: draw it over the scene to see it (debugging): a line, and a dot at each of its points\\n- `path.nearest(x, y, z)` †: the distance along it of its point nearest (x, y) on the ground (and z, when given): a racer's progress round a track, a rail's grab point\\n- `path.closed` †: it runs back to the first\\n- `path.length` †: world units from end to end (round, when closed)\\n- `path.points` †: the points it was made from, [x, y, z] each\\n\\n## 10g. Weather\\n\\n- `E.WEATHER: rain, snow, ash, leaves, sand` †: the kinds of weather: n drops at amount 1, fall speed (world units a second), colors, streak (seconds of motion a drop's line shows), sway, rest (seconds it lies where it lands), splash, wind (how hard the wind pushes it), size, big (the share a pixel bigger). Add your own: E.WEATHER.embers = { ... }\\n\\n## 10k. Save slots\\n\\n- `new E.Saves(game, o) → saves` †: game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read })\\n- `saves.any` †: is there any save to load (a title's Continue)?\\n- `saves.autosave(o)` †: save to the autosave (what write() gives)\\n- `saves.copy(from, to)` †: copy a slot's save onto another (over what is there); false when the first is empty\\n- `saves.erase(slot)` †: erase a slot\\n- `saves.get(slot)` †: a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer: true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version }\\n- `saves.latest()` †: the most recent save that loads, or null (a title's Continue loads it)\\n- `saves.list()` †: every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows)\\n- `saves.load(slot)` †: load a slot: its data brought up to this version (migrate), played set from it, read(save) called. Returns the save ({ data, place, level, time, slot }), or null when the slot is empty, damaged or from a newer version\\n- `saves.save(slot, o)` †: save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept (in storage, or for the visit when storage is blocked: blocked tells), false when there was nothing to save\\n- `saves.show(mode = 'load', done)` †: open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or a save. False without a menu (a headless game, menu: false)\\n- `saves.blocked = false` †: storage refused a save (they last for the visit)\\n- `saves.canSave = true` †: the pause menu offers Save (a JRPG turns it off away from save points)\\n- `saves.game` †: its game\\n- `saves.migrate` †: an older version's data brought up to this one (or null: kept as it is)\\n- `saves.played = 0` †: seconds played in the game's scenes (paused time and titles left out), saved with each save and set by a load\\n- `saves.read` †: what a load does with { data, place, level, time, slot }\\n- `saves.slots` †: how many slots besides the autosave (3)\\n- `saves.version` †: the game's version of its data (1), saved with each save\\n- `saves.write` †: what a save holds ({ data, place, level })\\n\\n## 11. Humanoid rig\\n\\n- `new E.Attack(spec = {}, over) → slash`: new E.Attack(spec) or new E.Attack('slash', { reach: 9 }): a name from E.MOVES plus overrides\\n- `slash.active`: true while the strike can connect\\n- `slash.busy`: true from the wind-up to the end of the recovery\\n- `slash.cancel()`: stop the swing at once (hurt, dodged into)\\n- `slash.hits(targets, test, fn)`: during 'active', call fn(target) once per swing for each target where test(target) is true. Returns how many were hit\\n- `slash.start(canCancel = false)`: begin a swing if idle (or when canCancel and already recovering). Returns true if it started\\n- `slash.state`: what Humanoid.update wants as `attack` (null when idle)\\n- `slash.u`: 0..1 progress through the current phase\\n- `slash.update(dt)`: advance the swing by dt seconds; returns the phase that began during it ('active' = play the swing sound), or null\\n- `slash.hit`: the targets this swing has hit (each is hit once)\\n- `slash.phase = null`: 'wind' | 'active' | 'recover', or null when idle\\n- `slash.spec`: the move: seconds of wind, active and recover, and its shape for the rig (a0, a1, z0, z1, reach, hitAt)\\n- `slash.t = 0`: seconds into the phase\\n- `new E.Combo(specs, o = {}) → combo`: new E.Combo(items, { window: .3 }): items are move names, specs or Attacks\\n- `combo.active`: true while the current hit can connect\\n- `combo.busy`: true while a hit of the chain is swinging\\n- `combo.cancel()`: stop the chain; the next press starts it over\\n- `combo.current`: the Attack of the current hit\\n- `combo.hits(targets, test, fn)`: the current hit's hits(targets, test, fn): fn(target) once per swing where test(target) is true\\n- `combo.press()`: start or continue the chain. Returns true if a hit started\\n- `combo.state`: what Humanoid.update wants as `attack` (null when idle)\\n- `combo.update(dt)`: advance the current hit; returns the phase that began, as Attack.update\\n- `combo.idle = 99`: seconds since the last hit ended\\n- `combo.moves`: the Attacks\\n- `combo.step = -1`: the index of the current hit (-1 before the first)\\n- `combo.window`: seconds after a hit ends that a press still chains\\n- `new E.Humanoid(o = {}) → rig`: new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a character rig posed from math every step (API.md, \\\"Characters\\\", lists the options); update(dt, state) each step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style, color }; E.Humanoid.hat adds one); weapon: 'sword' | 'gun' | 'staff' (E.Humanoid.weapon adds one); hood: true (drawn in colors.hair); draw: { under(g, Q, rig), over(g, Q, rig) } the game's own drawing before and after the body (Q: the joints on screen, [x, y, depth]: outfits, accessories); seed: its own random stream (blinks, its clock)\\n\",\"total_lines\":1767}}","is_error":false},{"type":"tool_result","tool_use_id":"call-507b9f29-c3af-4942-ba3a-9b5e088fda6d-18","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1064→## 20. Audio\\n\\n- `E.note(n)`: note name -> frequency: E.note('A4') = 440, E.note('C#5'), E.note('Bb2'). Numbers pass through\\n- `E.songs: title, adventure, dungeon, boss, victory`: ready-made chiptune loops (original compositions). game.audio.music('adventure')\\n- `game.audio.applyVolume()`: apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it)\\n- `game.audio.at(step, fn)` †: call fn(step) on the update step the music reaches step (counted from its start, on as it loops); the song's change cancels it. Returns { cancel() }\\n1070→- `game.audio.bus(name = 'sfx')`: a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument) to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio)\\n- `game.audio.calibrate()` †: the audio offset's calibration: a click on each beat (100 bpm, the first of a bar higher) as the music; tap(time) on each one heard (an event's timeStamp, or nothing: this update step). After 8 taps, result is the offset to set (ms: settings.audioOffset) and done is true; taps go on refining it. stop() puts the music back\\n- `game.audio.define(name, voice)`: add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 })\\n- `game.audio.duck(on = true)`: quiet the music (to 35%) while on: under a game's own pause, map or dialog screen. The engine also ducks it while game.paused\\n- `game.audio.instrument(name, fn)` †: an instrument of the game's own: fn(ctx, bus, time, freq, dur, vol) makes a note's sound (Web Audio, into bus, from time); its name is a wave a music track (wave: 'pluck') or a voice takes\\n- `game.audio.layer(track, vol = 1, fade = .5)` †: a track's volume as the song plays, 0..1, faded over fade seconds: layers of one song (the chase's drums in when the guards see you, out when they lose you). track: its index in song.tracks, or its name\\n- `game.audio.music(song, o = {})`: Loop a song (or play once with { loop: false }). song = { bpm: 120, steps: 4, tracks: [ { wave: 'square', vol: .2, notes: 'C5 - E5 - G5 - . . | ...' }, one token per step { wave: 'triangle', notes: 'C3 . C3 . G2 . G2 .' }, { wave: 'drums', notes: 'k . h . s . h . k k h . s . h .' } ] } tokens: C4 F#3 Bb2 = note, '-' holds the previous note, '.' = rest, '|' is ignored (bar lines). steps = steps per beat (4 = sixteenth notes). Each track loops on its own length within the song's (len: steps, else its longest track's); a track may have a name, and on: false starts it silent (a layer that audio.layer brings in). THE MUSIC CLOCK: a song starts at the game's time and where it is is game time (audio.pos, headless too: the same steps hear the same beats); the sound follows that clock. o: { loop, sync: true (it pauses with the game, on game.time; else it plays on through a pause, on game.real), fade: seconds (a crossfade from the song playing), restart: true (again from its start, though it is the one playing) }. E.songs has ready-made loops: title, adventure, dungeon, boss, victory.\\n- `game.audio.mute(on = !this.muted)`: toggle (or set) mute; returns the new state\\n- `game.audio.onBeat(fn)` †: call fn(beat, pos) on the update step of each beat of whatever music plays (a dancer's step, a light's pulse). Returns { cancel() }\\n- `game.audio.pos` †: where the music is, on the game's clock (headless too): { t: seconds since it started, step (from 0, counting on as it loops), beat, bar (four beats), at (the step in its loop), loop (times round), bpm, layers (each track's volume), playing }\\n1080→- `game.audio.ready`: true once the browser lets the game make sound\\n- `game.audio.setVolume(v)`: set the master volume, 0..1\\n- `game.audio.sfx(what, o = {})`: Play a sound effect: a preset name ('jump', 'coin', 'hit', 'explode', ...), a voice object, or a list of voices. opts: { vol: 0..1, pitch: multiplier, vary: random pitch spread (default 0.03), step: a step of the music playing (it sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left) .. 1 (right), loop: true (it sounds on until stopped: an engine, rain; through the effects' bus, so it follows the volume and the mute) }. Returns its handle: { stop(fade .03), set({ pan, vol }), playing, pan }: a handle that does nothing when nothing plays (headless, before the first key, an unknown name)\\n- `game.audio.sting(song, o = {})` †: play a short song once over the music (a goal's jingle): o.at 'now', 'beat' or 'bar' (on the music's next beat or bar), o.duck (the music's volume under it, .4)\\n- `game.audio.stopMusic(fade)`: stop the music (it fades out over fade seconds, .06 by default)\\n- `game.audio.tempo(bpm)` †: change the music's tempo as it plays (hurry up!): where it is stays, the steps after come at the new bpm\\n- `game.audio.anchors = 0` †: how many times the sound was moved to meet the clock\\n- `game.audio.ctx = null`: the Web Audio context, made at the first sound (null before, or where there is none)\\n- `game.audio.drift = 0` †: what is heard against the game's clock at the last frame (seconds: the sound follows the clock, so it stays near 0)\\n- `game.audio.ducked = false`: true while duck(true) holds the music down\\n1090→- `game.audio.failed = null`: why there is no sound (a message), or null\\n- `game.audio.musicVolume = .5`, `game.audio.sfxVolume = 1`, `game.audio.voiceVolume = 1`: 0..1 for effects, music and the voice bus (bus('voice'))\\n- `game.audio.muted = false`: true while mute() is on\\n- `game.audio.offset = 0` †: seconds the music sounds early, for speakers and headphones that lag (settings.audioOffset)\\n- `game.audio.presets`: the named sound effects, sfx(name) plays one and define(name, voice) adds one\\n- `game.audio.song = null`: the music playing (null for none)\\n- `game.audio.volume = .7`: master volume 0..1\\n\\n## 21b. Backdrops\\n\\n1100→- `new E.Backdrop(o = {}) → backdrop`: new E.Backdrop('castle-night') (a preset: E.Backdrop.presets) or new E.Backdrop({ sky: [colors top to bottom], sun, moon, stars, layers: [{ kind: 'mountains' | 'hills' | 'forest' | 'city' | 'castle' | 'clouds' | 'sea' | 'fog' | 'stalactites', color, y, height, parallax, seed }] }): a parallax sky and scenery drawn behind a level. sun, moon: { x, y (0..1 of the screen), r, color }\\n- `E.Backdrop.presets` †: the preset names, all ten: day, dusk, night, castle-night, city-night, desert, forest, ocean, cave, space\\n- `backdrop.draw(r)` †: draw the backdrop first in draw(r), before the level; it scrolls with the camera by each layer's parallax\\n- `backdrop.layers` †: its scenery layers, back to front, with their defaults filled in\\n- `backdrop.sky` †: the sky's gradient colors, top to bottom\\n\\n## 21c. Props\\n\\n- `E.PROPS: torch, candle, candelabra, chandelier, brazier, window, banner, pillar, statue, crate, barrel, chest, pot, sign, fence, lamp, door, tree, pine, bush, flowers, grass, rock, crystal, bones, skull, vines, cobweb, lantern, streetlamp, awning, hydrant, trashcan, firedrum, sandbags, cactus, palm, mushroom` †: the names of the built-in props for r.prop(name, x, y, z, opts) and E.prop(name, opts)\\n- `E.prop(name, o = {})`: build (and cache) a prop: { frames: [sprite], glow: [sprite] | null, w, h }\\n1110→\\n## 21e. Shapes\\n\\n- `E.SHAPES: barrel, crate, chest, table, chair, stool, bench, bed, bookcase, shelf, pot, jar, sack, cart, ... (25)`: the shapes by id: { about, tags, mats: { slot: material }, parts | make(params), params, foot, lights, flames } (the core library's, the sets' as 'SET:id' from E.addAssets, and your own: E.SHAPES.stool = {...})\\n- `E.addAssets(set)`: register a store set (src/assets/sets/*.js: { set, format: 1, credit, sources, materials, shapes, sprites }): its entries are named 'SET:id' (so one set never changes another's, or the core's) and find their own set's materials and shapes first. An id that is already there warns and keeps the first. Returns { shapes: [ids], materials: [ids], sprites: { id: sprite } } (sprites are E.sprite data; a color may be 'material:tone', tone deep | sh | base | lt | hi)\\n- `E.materialTile(id, o = {})`: a material's pattern as a tile of pixels, for a 3D renderer's texture: E.materialTile(id, { size: 32 (world units square: it repeats every size; a face pattern's whole face), px: 2 (pixels a unit), lid: false (true: as on a face looking up), curved (as on a turned face), band: 2 (the light: 0 dark .. 4 bright) }) -> { w, h, rgba (Uint8ClampedArray, top row first, v up the tile) }; null for an unknown material\\n- `E.shapeBox(id, x, y, z = 0, o = {})`: where a placed shape stands, as both engines collide with it: E.shapeBox(id | entry, x, y, z, { facing, scale, flip, params }) -> { x, y (its footprint's middle), z, top, hx, hy (half its footprint, along its own x and y), c, s (the turn's cosine and sine) }; null for an unknown shape. map.solid makes one solid; world.shape gives it a collider\\n- `E.shapeInfo(id, o = {})`: what a shape draws, for tools and tests: E.shapeInfo(id, { view: 'iso', facing, scale, mats, params }) -> { w, h, ox, oy, tris, prims (its primitives), parts (each primitive's pixels on screen: 0 is never seen there), colors (distinct), pixels, bounds [x0, y0, z0, x1, y1, z1], rgba }; null for an unknown shape\\n- `E.shapeMesh(id, o = {})`: a shape's triangles, for a 3D renderer (the 3D engine's world.shape): E.shapeMesh(id | entry, { params, mats, seg }) -> { groups: [{ mat, key, lid, curved, face, pos, nrm, uv }], bounds [x0, y0, z0, x1, y1, z1] } in the entry's own units and frame (z up, its front +y, its own scale applied: place it with the placement's facing, scale and flip). The same parts as r.shape draws; null for an unknown shape\\n- `E.shapeMesh({ seg })`: seg(r): the segments round a radius r (default 8 to 24)\\n1120→- `E.shapeMesh() → groups`: each one's mat (the material ready to draw: E.material's), key (its id), lid (true: the faces looking up or down, which some patterns draw their own way), curved (turned or round faces: planks run up them), face (a pattern drawn once per face, the crate's sides and bark's ends: uv runs 0 to 1 across each face), pos, nrm, uv (Float32Arrays: three numbers a corner, three corners a triangle; uv two a corner, world units across the surface)\\n- `E.shapeSprite(id, o = {})`: a shape as a sprite (E.sprite's kind: r.sprite, px.sprite, inventories, HUDs, portraits): E.shapeSprite(id, { view: 'iso', facing, size (its scale, 1), mats, params, outline: true | a color | false }). The view is a name or a View, as given (r.shape draws steep views from the characters' angle: E.charView(view) gives that); a bag icon is the item's shape seen at an angle. r.sprite stands it on its feet (foot: [x, y] in the sprite) unless an anchor is given\\n\\n## 21. Ui\\n\\n- `new E.Dialog(game, o = {}) → talk`: new E.Dialog(game, { speed, lines, place, color, nameColor, voice, width, bg, border, vars }): a dialog box that types its text; say() opens it, update(dt) and draw(r) run it\\n- `talk.choiceAt(i)` †: where choice i is on the screen while the choices show: [x, y] (its middle, for a test's tap), else null\\n- `talk.close()`: close it now (and forget pending presses, so the same press doesn't also attack)\\n- `talk.draw(r)`: draw it (anywhere in draw: it goes to the overlay)\\n- `talk.pageLen`: the letters on the page shown\\n1130→- `talk.say(text, o = {})`: open with one string or a list of strings (each starts a new page). opts: { name, onDone, choices, onChoice, portrait: rig (a live close-up of that Humanoid beside the text) or a function (g, x, y, size), portraitSize: 40, portraitOpts: { zoom, turn, bg }, auto: seconds a page shows before it turns by itself, modal: false (play goes on while it shows: radio chatter), place: 'top' | 'middle' | 'bottom', y, alpha, vars: the values {$name} reads, voice: this call's (a sound effect, null, or a function per letter) } choices: ['YES', 'NO'], shown on the last page (picked by the keys, or a tap or click on one); onChoice(i) gets the one picked. update(dt) returns true while a modal box is open: return from your update then, and play waits\\n- `talk.typing`: true while the page is still typing\\n- `talk.update(dt)`: type and turn pages (confirm finishes the line, then turns the page); returns true while open and modal, so gameplay can wait: if (talk.update(dt)) return;\\n- `talk.auto`: seconds each page stays after typing\\n- `talk.bg = '#141a3a'`, `talk.border = '#e8e4ff'`: the box's colors\\n- `talk.choice = 0`: the choice under the cursor\\n- `talk.choices`: the answers offered on the last page, or null\\n- `talk.color = '#ffffff'`: the text's color\\n- `talk.game`: its game\\n- `talk.i = 0`: the page shown\\n1140→- `talk.lines = 3`: text lines per page\\n- `talk.modal`: false lets play go on (radio chatter)\\n- `talk.name`: the speaker's name shown on the box\\n- `talk.nameColor = '#ffd36a'`: the speaker's name's color\\n- `talk.onChoice`: called with the index picked\\n- `talk.onDone`: called when the last page closes\\n- `talk.open = false`: true while it shows\\n- `talk.pages = []`: the text wrapped into pages of lines\\n- `talk.place = 'bottom'`: 'bottom' | 'top' | 'middle'\\n- `talk.portrait`: the portrait beside the text (a Humanoid, or a function (g, x, y, size)), or null; pSize: its size in pixels; pOpts: its options ({ zoom, turn, bg })\\n1150→- `talk.shown = 0`: letters typed so far on it\\n- `talk.speed = 50`: letters typed per second\\n- `talk.vars = null`: the values {$name} in the text reads (say's vars first)\\n- `talk.voice = 'text'`: the sound effect each letter blips ('text'; null for silence), or a function (letter, index, dialog) called once for each letter as it types (a babble voice: Animalese; dialog.name is the speaker)\\n- `talk.width = 0`: the box's width in pixels (320 at most by default, the screen's less 12 at most)\\n- `new E.Menu(game, items, o = {}) → menu`: Menu with a cursor (title screens, pause menus, shops, battle commands). const menu = new E.Menu(game, ['START', 'OPTIONS', { label: 'CONTINUE', disabled: !save }], { onPick(i, item) {...}, onCancel() {...} }); update: menu.update(dt) draw: menu.draw(r) opts: { x: 'center' | px, y: 'center' | px, title, box: true, color, pick: '#ffd36a', columns: 1 }\\n- `menu.draw(r)`: draw it to the overlay\\n- `menu.rowAt(i)` †: entry i's box on the screen, [x, y, w, h] in screen pixels: where a click or tap picks it (a test's feed('down') and feed('up') there); null while it is scrolled out of view\\n- `menu.selected`: the entry under the cursor\\n- `menu.update()`: move the cursor (up, down; held keys repeat; the mouse over an entry) and pick (confirm, or a click or tap on an entry) or cancel; returns true when it picked or cancelled\\n1160→- `menu.active = true`: false stops it reading input\\n- `menu.bg = '#141a3a'`, `menu.border = '#e8e4ff'`: the window's colors\\n- `menu.box = true`: draw a window round it\\n- `menu.color = '#ffffff'`: the entries' color\\n- `menu.dim = '#6a6488'`: disabled entries' color\\n- `menu.game`: its game\\n- `menu.i = 0`: the one under the cursor\\n- `menu.input = null` †: the one input it reads (default: every player's, so any player moves and picks; the mouse and taps are player 1's)\\n- `menu.items`: the entries (strings, or { label, disabled })\\n- `menu.onCancel = null`: called on cancel\\n1170→- `menu.onMove = null`: called (i, item) when the cursor moves\\n- `menu.onPick = null`: called (i, item) on confirm\\n- `menu.pick = '#ffd36a'`: the color of the one under the cursor\\n- `menu.rows = 0` †: at most that many entries shown, the list scrolling under its cursor (0: all)\\n- `menu.scale = 1` †: its text and rows that many times (2, 3: across a room on a TV)\\n- `menu.sound = true`: false silences it\\n- `menu.title = null`: a heading, or null\\n- `menu.x = 'center'`, `menu.y = 'center'`: where it sits, 'center' or pixels\\n- `E.ui`: pixel-drawn interface pieces for r.overlay\\n- `E.ui.bar(g, x, y, w, h, frac, color = '#e0463c', o = {})`: a bar (a meter: health, magic, stamina, a boss's): ui.bar(g, x, y, w, h, 0..1, '#e0463c')\\n1180→- `E.ui.box(g, x, y, w, h, o = {})`: window frame: ui.box(g, x, y, w, h, { bg, border, shadow, gradient }) bg: one color (drawn as a soft top-to-bottom gradient, like Final Fantasy windows) or [top, bottom] colors. gradient: false for a flat fill.\\n- `E.ui.counter(g, x, y, label, value, color = '#ffffff', o = {})`: label + value, e.g. ui.counter(g, 4, 4, 'RUPEES', 12)\\n- `E.ui.hearts(g, x, y, hp, max, o = {})`: row of hearts: hp and max in hearts (halves allowed, e.g. 2.5 of 3)\\n\\n## 21d. Shell\\n\\n- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\\n- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30 at 1,875)\\n- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\\n- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\\n1190→- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\\n- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\\n- `shell.back()` †: what cancel does: the screen's own back(), or close it (back to the screen under it; closing the pause screen resumes)\\n- `shell.dispose()` †: take its elements away and let go of the game (game.dispose() does it)\\n- `shell.hide()` †: close every screen (and resume, when the menu paused the game)\\n- `shell.hud(st = {})` †: the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\\n- `shell.hud({ objective })` †: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\\n- `shell.hud({ status, place, tip })` †: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\\n- `shell.hud({ bars, counts })` †: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label, value]]\\n- `shell.hud({ prompt })` †: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\\n1200→- `shell.hud({ keys, buttons })` †: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right: pause and map where there is no Escape key)\\n- `shell.hud({ minimap })` †: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y) (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\\n- `shell.screen` †: the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays\\n- `shell.settings` †: the player's settings: game.settings (the standard ones and the game's own, by key)\\n- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (strings or functions), actions: [[label, fn] or { label, fn, act, primary, disabled }], back (fn for cancel), rows: ['glyphs', 'invertY', '#A heading'] (settings' rows, changed as on the settings screen) }. From another screen it stacks (back() returns); shown again, it updates (the new spec over the old). 'settings' takes its items\\n- `shell.show('title')` †: { name, subtitle, meta: [...], footer }\\n- `shell.show('help')` †: { keys: [[key, what]], sections: [[heading, text]] }\\n- `shell.show('results')` †: { emblem, stats: [[value, label]], medals: [[label, earned]] }\\n- `shell.show('map')` †: { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) }\\n- `shell.toast(title, text = '', seconds = 4)` †: a message that slides in at the top for a few seconds\\n1210→- `shell.tutorial(title, text = '', seconds = 15)` †: a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away\\n- `shell.root = null` †: game: the game it is over; o: its options; root: its DOM element (null in a headless game)\\n\\n## 22. Gpu lighting (webgpu)\\n\\n- `game.gpu.active(view)` †: true when it lights frames in this view (ready, enabled and a ground view)\\n- `game.gpu.snapshot()` †: offscreen mode only: read the last frame back as a PNG data URL\\n- `game.gpu.status()` †: 'loading' | 'on' | 'off' | 'unavailable'\\n- `game.gpu.adapterInfo` †: the GPU's description from the browser (vendor, architecture), or null\\n- `game.gpu.ambient` †: the unlit color, [r, g, b] 0..1\\n1220→- `game.gpu.bands = 6` †: how many light bands (fewer is more retro)\\n- `game.gpu.enabled = true` †: false switches it off for now (and the canvas lighting with it, unless game.lights.enabled)\\n- `game.gpu.failed = null` †: why it couldn't start, or null\\n- `game.gpu.fallback = true` †: false keeps a frame it can't draw unlit (by default the canvas lighting stands in, game.lights.on)\\n- `game.gpu.glow = .22` †: the strength of px.glow surfaces\\n- `game.gpu.map = null` †: the TileMap it measures walls on\\n- `game.gpu.offscreen = false` †: render into a texture instead of the page (automated tests; read it with snapshot())\\n- `game.gpu.onStatus = null` †: called (gpu) when its status changes\\n- `game.gpu.ready = false` †: true once the GPU is set up\\n- `game.gpu.shadows = true` †: casters block light\\n1230→- `game.gpu.skipped` †: never queue more than two frames: a slow GPU drops frames instead of building up lag\\n- `game.gpu.spill = 1.1` †: how far light spills past its radius\\n- `game.gpu.wrap = .45` †: how far light wraps round wall corners, 0..1\\n\\n## 23. Sessions\\n\\n- `E.session` †: records a play session on any device and replays it exactly (this section's header says how)\\n- `E.session.frame` †: the frames run since the page loaded\\n- `E.session.record(on)` †: turn recording on or off for the next page loads (each load is a session of its own)\\n- `E.session.recording` †: true while this page load is recorded\\n1240→- `E.session.replaying` †: true while it is a replay\\n- `E.session.wanted()` †: true when recording is on for page loads (record(true))\\n\\n## Module arcade: the coin-op's frame: scores, high-score tables and initials, lives, credits, turns, cards, the attract mode (engine/modules/arcade.js)\",\"content_concise\":\"1064→## 20. Audio\\n\\n- `E.note(n)`: note name -> frequency: E.note('A4') = 440, E.note('C#5'), E.note('Bb2'). Numbers pass through\\n- `E.songs: title, adventure, dungeon, boss, victory`: ready-made chiptune loops (original compositions). game.audio.music('adventure')\\n- `game.audio.applyVolume()`: apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it)\\n- `game.audio.at(step, fn)` †: call fn(step) on the update step the music reaches step (counted from its start, on as it loops); the song's change cancels it. Returns { cancel() }\\n1070→- `game.audio.bus(name = 'sfx')`: a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument) to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio)\\n- `game.audio.calibrate()` †: the audio offset's calibration: a click on each beat (100 bpm, the first of a bar higher) as the music; tap(time) on each one heard (an event's timeStamp, or nothing: this update step). After 8 taps, result is the offset to set (ms: settings.audioOffset) and done is true; taps go on refining it. stop() puts the music back\\n- `game.audio.define(name, voice)`: add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 })\\n- `game.audio.duck(on = true)`: quiet the music (to 35%) while on: under a game's own pause, map or dialog screen. The engine also ducks it while game.paused\\n- `game.audio.instrument(name, fn)` †: an instrument of the game's own: fn(ctx, bus, time, freq, dur, vol) makes a note's sound (Web Audio, into bus, from time); its name is a wave a music track (wave: 'pluck') or a voice takes\\n- `game.audio.layer(track, vol = 1, fade = .5)` †: a track's volume as the song plays, 0..1, faded over fade seconds: layers of one song (the chase's drums in when the guards see you, out when they lose you). track: its index in song.tracks, or its name\\n- `game.audio.music(song, o = {})`: Loop a song (or play once with { loop: false }). song = { bpm: 120, steps: 4, tracks: [ { wave: 'square', vol: .2, notes: 'C5 - E5 - G5 - . . | ...' }, one token per step { wave: 'triangle', notes: 'C3 . C3 . G2 . G2 .' }, { wave: 'drums', notes: 'k . h . s . h . k k h . s . h .' } ] } tokens: C4 F#3 Bb2 = note, '-' holds the previous note, '.' = rest, '|' is ignored (bar lines). steps = steps per beat (4 = sixteenth notes). Each track loops on its own length within the song's (len: steps, else its longest track's); a track may have a name, and on: false starts it silent (a layer that audio.layer brings in). THE MUSIC CLOCK: a song starts at the game's time and where it is is game time (audio.pos, headless too: the same steps hear the same beats); the sound follows that clock. o: { loop, sync: true (it pauses with the game, on game.time; else it plays on through a pause, on game.real), fade: seconds (a crossfade from the song playing), restart: true (again from its start, though it is the one playing) }. E.songs has ready-made loops: title, adventure, dungeon, boss, victory.\\n- `game.audio.mute(on = !this.muted)`: toggle (or set) mute; returns the new state\\n- `game.audio.onBeat(fn)` †: call fn(beat, pos) on the update step of each beat of whatever music plays (a dancer's step, a light's pulse). Returns { cancel() }\\n- `game.audio.pos` †: where the music is, on the game's clock (headless too): { t: seconds since it started, step (from 0, counting on as it loops), beat, bar (four beats), at (the step in its loop), loop (times round), bpm, layers (each track's volume), playing }\\n1080→- `game.audio.ready`: true once the browser lets the game make sound\\n- `game.audio.setVolume(v)`: set the master volume, 0..1\\n- `game.audio.sfx(what, o = {})`: Play a sound effect: a preset name ('jump', 'coin', 'hit', 'explode', ...), a voice object, or a list of voices. opts: { vol: 0..1, pitch: multiplier, vary: random pitch spread (default 0.03), step: a step of the music playing (it sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left) .. 1 (right), loop: true (it sounds on until stopped: an engine, rain; through the effects' bus, so it follows the volume and the mute) }. Returns its handle: { stop(fade .03), set({ pan, vol }), playing, pan }: a handle that does nothing when nothing plays (headless, before the first key, an unknown name)\\n- `game.audio.sting(song, o = {})` †: play a short song once over the music (a goal's jingle): o.at 'now', 'beat' or 'bar' (on the music's next beat or bar), o.duck (the music's volume under it, .4)\\n- `game.audio.stopMusic(fade)`: stop the music (it fades out over fade seconds, .06 by default)\\n- `game.audio.tempo(bpm)` †: change the music's tempo as it plays (hurry up!): where it is stays, the steps after come at the new bpm\\n- `game.audio.anchors = 0` †: how many times the sound was moved to meet the clock\\n- `game.audio.ctx = null`: the Web Audio context, made at the first sound (null before, or where there is none)\\n- `game.audio.drift = 0` †: what is heard against the game's clock at the last frame (seconds: the sound follows the clock, so it stays near 0)\\n- `game.audio.ducked = false`: true while duck(true) holds the music down\\n1090→- `game.audio.failed = null`: why there is no sound (a message), or null\\n- `game.audio.musicVolume = .5`, `game.audio.sfxVolume = 1`, `game.audio.voiceVolume = 1`: 0..1 for effects, music and the voice bus (bus('voice'))\\n- `game.audio.muted = false`: true while mute() is on\\n- `game.audio.offset = 0` †: seconds the music sounds early, for speakers and headphones that lag (settings.audioOffset)\\n- `game.audio.presets`: the named sound effects, sfx(name) plays one and define(name, voice) adds one\\n- `game.audio.song = null`: the music playing (null for none)\\n- `game.audio.volume = .7`: master volume 0..1\\n\\n## 21b. Backdrops\\n\\n1100→- `new E.Backdrop(o = {}) → backdrop`: new E.Backdrop('castle-night') (a preset: E.Backdrop.presets) or new E.Backdrop({ sky: [colors top to bottom], sun, moon, stars, layers: [{ kind: 'mountains' | 'hills' | 'forest' | 'city' | 'castle' | 'clouds' | 'sea' | 'fog' | 'stalactites', color, y, height, parallax, seed }] }): a parallax sky and scenery drawn behind a level. sun, moon: { x, y (0..1 of the screen), r, color }\\n- `E.Backdrop.presets` †: the preset names, all ten: day, dusk, night, castle-night, city-night, desert, forest, ocean, cave, space\\n- `backdrop.draw(r)` †: draw the backdrop first in draw(r), before the level; it scrolls with the camera by each layer's parallax\\n- `backdrop.layers` †: its scenery layers, back to front, with their defaults filled in\\n- `backdrop.sky` †: the sky's gradient colors, top to bottom\\n\\n## 21c. Props\\n\\n- `E.PROPS: torch, candle, candelabra, chandelier, brazier, window, banner, pillar, statue, crate, barrel, chest, pot, sign, fence, lamp, door, tree, pine, bush, flowers, grass, rock, crystal, bones, skull, vines, cobweb, lantern, streetlamp, awning, hydrant, trashcan, firedrum, sandbags, cactus, palm, mushroom` †: the names of the built-in props for r.prop(name, x, y, z, opts) and E.prop(name, opts)\\n- `E.prop(name, o = {})`: build (and cache) a prop: { frames: [sprite], glow: [sprite] | null, w, h }\\n1110→\\n## 21e. Shapes\\n\\n- `E.SHAPES: barrel, crate, chest, table, chair, stool, bench, bed, bookcase, shelf, pot, jar, sack, cart, ... (25)`: the shapes by id: { about, tags, mats: { slot: material }, parts | make(params), params, foot, lights, flames } (the core library's, the sets' as 'SET:id' from E.addAssets, and your own: E.SHAPES.stool = {...})\\n- `E.addAssets(set)`: register a store set (src/assets/sets/*.js: { set, format: 1, credit, sources, materials, shapes, sprites }): its entries are named 'SET:id' (so one set never changes another's, or the core's) and find their own set's materials and shapes first. An id that is already there warns and keeps the first. Returns { shapes: [ids], materials: [ids], sprites: { id: sprite } } (sprites are E.sprite data; a color may be 'material:tone', tone deep | sh | base | lt | hi)\\n- `E.materialTile(id, o = {})`: a material's pattern as a tile of pixels, for a 3D renderer's texture: E.materialTile(id, { size: 32 (world units square: it repeats every size; a face pattern's whole face), px: 2 (pixels a unit), lid: false (true: as on a face looking up), curved (as on a turned face), band: 2 (the light: 0 dark .. 4 bright) }) -> { w, h, rgba (Uint8ClampedArray, top row first, v up the tile) }; null for an unknown material\\n- `E.shapeBox(id, x, y, z = 0, o = {})`: where a placed shape stands, as both engines collide with it: E.shapeBox(id | entry, x, y, z, { facing, scale, flip, params }) -> { x, y (its footprint's middle), z, top, hx, hy (half its footprint, along its own x and y), c, s (the turn's cosine and sine) }; null for an unknown shape. map.solid makes one solid; world.shape gives it a collider\\n- `E.shapeInfo(id, o = {})`: what a shape draws, for tools and tests: E.shapeInfo(id, { view: 'iso', facing, scale, mats, params }) -> { w, h, ox, oy, tris, prims (its primitives), parts (each primitive's pixels on screen: 0 is never seen there), colors (distinct), pixels, bounds [x0, y0, z0, x1, y1, z1], rgba }; null for an unknown shape\\n- `E.shapeMesh(id, o = {})`: a shape's triangles, for a 3D renderer (the 3D engine's world.shape): E.shapeMesh(id | entry, { params, mats, seg }) -> { groups: [{ mat, key, lid, curved, face, pos, nrm, uv }], bounds [x0, y0, z0, x1, y1, z1] } in the entry's own units and frame (z up, its front +y, its own scale applied: place it with the placement's facing, scale and flip). The same parts as r.shape draws; null for an unknown shape\\n- `E.shapeMesh({ seg })`: seg(r): the segments round a radius r (default 8 to 24)\\n1120→- `E.shapeMesh() → groups`: each one's mat (the material ready to draw: E.material's), key (its id), lid (true: the faces looking up or down, which some patterns draw their own way), curved (turned or round faces: planks run up them), face (a pattern drawn once per face, the crate's sides and bark's ends: uv runs 0 to 1 across each face), pos, nrm, uv (Float32Arrays: three numbers a corner, three corners a triangle; uv two a corner, world units across the surface)\\n- `E.shapeSprite(id, o = {})`: a shape as a sprite (E.sprite's kind: r.sprite, px.sprite, inventories, HUDs, portraits): E.shapeSprite(id, { view: 'iso', facing, size (its scale, 1), mats, params, outline: true | a color | false }). The view is a name or a View, as given (r.shape draws steep views from the characters' angle: E.charView(view) gives that); a bag icon is the item's shape seen at an angle. r.sprite stands it on its feet (foot: [x, y] in the sprite) unless an anchor is given\\n\\n## 21. Ui\\n\\n- `new E.Dialog(game, o = {}) → talk`: new E.Dialog(game, { speed, lines, place, color, nameColor, voice, width, bg, border, vars }): a dialog box that types its text; say() opens it, update(dt) and draw(r) run it\\n- `talk.choiceAt(i)` †: where choice i is on the screen while the choices show: [x, y] (its middle, for a test's tap), else null\\n- `talk.close()`: close it now (and forget pending presses, so the same press doesn't also attack)\\n- `talk.draw(r)`: draw it (anywhere in draw: it goes to the overlay)\\n- `talk.pageLen`: the letters on the page shown\\n1130→- `talk.say(text, o = {})`: open with one string or a list of strings (each starts a new page). opts: { name, onDone, choices, onChoice, portrait: rig (a live close-up of that Humanoid beside the text) or a function (g, x, y, size), portraitSize: 40, portraitOpts: { zoom, turn, bg }, auto: seconds a page shows before it turns by itself, modal: false (play goes on while it shows: radio chatter), place: 'top' | 'middle' | 'bottom', y, alpha, vars: the values {$name} reads, voice: this call's (a sound effect, null, or a function per letter) } choices: ['YES', 'NO'], shown on the last page (picked by the keys, or a tap or click on one); onChoice(i) gets the one picked. update(dt) returns true while a modal box is open: return from your update then, and play waits\\n- `talk.typing`: true while the page is still typing\\n- `talk.update(dt)`: type and turn pages (confirm finishes the line, then turns the page); returns true while open and modal, so gameplay can wait: if (talk.update(dt)) return;\\n- `talk.auto`: seconds each page stays after typing\\n- `talk.bg = '#141a3a'`, `talk.border = '#e8e4ff'`: the box's colors\\n- `talk.choice = 0`: the choice under the cursor\\n- `talk.choices`: the answers offered on the last page, or null\\n- `talk.color = '#ffffff'`: the text's color\\n- `talk.game`: its game\\n- `talk.i = 0`: the page shown\\n1140→- `talk.lines = 3`: text lines per page\\n- `talk.modal`: false lets play go on (radio chatter)\\n- `talk.name`: the speaker's name shown on the box\\n- `talk.nameColor = '#ffd36a'`: the speaker's name's color\\n- `talk.onChoice`: called with the index picked\\n- `talk.onDone`: called when the last page closes\\n- `talk.open = false`: true while it shows\\n- `talk.pages = []`: the text wrapped into pages of lines\\n- `talk.place = 'bottom'`: 'bottom' | 'top' | 'middle'\\n- `talk.portrait`: the portrait beside the text (a Humanoid, or a function (g, x, y, size)), or null; pSize: its size in pixels; pOpts: its options ({ zoom, turn, bg })\\n1150→- `talk.shown = 0`: letters typed so far on it\\n- `talk.speed = 50`: letters typed per second\\n- `talk.vars = null`: the values {$name} in the text reads (say's vars first)\\n- `talk.voice = 'text'`: the sound effect each letter blips ('text'; null for silence), or a function (letter, index, dialog) called once for each letter as it types (a babble voice: Animalese; dialog.name is the speaker)\\n- `talk.width = 0`: the box's width in pixels (320 at most by default, the screen's less 12 at most)\\n- `new E.Menu(game, items, o = {}) → menu`: Menu with a cursor (title screens, pause menus, shops, battle commands). const menu = new E.Menu(game, ['START', 'OPTIONS', { label: 'CONTINUE', disabled: !save }], { onPick(i, item) {...}, onCancel() {...} }); update: menu.update(dt) draw: menu.draw(r) opts: { x: 'center' | px, y: 'center' | px, title, box: true, color, pick: '#ffd36a', columns: 1 }\\n- `menu.draw(r)`: draw it to the overlay\\n- `menu.rowAt(i)` †: entry i's box on the screen, [x, y, w, h] in screen pixels: where a click or tap picks it (a test's feed('down') and feed('up') there); null while it is scrolled out of view\\n- `menu.selected`: the entry under the cursor\\n- `menu.update()`: move the cursor (up, down; held keys repeat; the mouse over an entry) and pick (confirm, or a click or tap on an entry) or cancel; returns true when it picked or cancelled\\n1160→- `menu.active = true`: false stops it reading input\\n- `menu.bg = '#141a3a'`, `menu.border = '#e8e4ff'`: the window's colors\\n- `menu.box = true`: draw a window round it\\n- `menu.color = '#ffffff'`: the entries' color\\n- `menu.dim = '#6a6488'`: disabled entries' color\\n- `menu.game`: its game\\n- `menu.i = 0`: the one under the cursor\\n- `menu.input = null` †: the one input it reads (default: every player's, so any player moves and picks; the mouse and taps are player 1's)\\n- `menu.items`: the entries (strings, or { label, disabled })\\n- `menu.onCancel = null`: called on cancel\\n1170→- `menu.onMove = null`: called (i, item) when the cursor moves\\n- `menu.onPick = null`: called (i, item) on confirm\\n- `menu.pick = '#ffd36a'`: the color of the one under the cursor\\n- `menu.rows = 0` †: at most that many entries shown, the list scrolling under its cursor (0: all)\\n- `menu.scale = 1` †: its text and rows that many times (2, 3: across a room on a TV)\\n- `menu.sound = true`: false silences it\\n- `menu.title = null`: a heading, or null\\n- `menu.x = 'center'`, `menu.y = 'center'`: where it sits, 'center' or pixels\\n- `E.ui`: pixel-drawn interface pieces for r.overlay\\n- `E.ui.bar(g, x, y, w, h, frac, color = '#e0463c', o = {})`: a bar (a meter: health, magic, stamina, a boss's): ui.bar(g, x, y, w, h, 0..1, '#e0463c')\\n1180→- `E.ui.box(g, x, y, w, h, o = {})`: window frame: ui.box(g, x, y, w, h, { bg, border, shadow, gradient }) bg: one color (drawn as a soft top-to-bottom gradient, like Final Fantasy windows) or [top, bottom] colors. gradient: false for a flat fill.\\n- `E.ui.counter(g, x, y, label, value, color = '#ffffff', o = {})`: label + value, e.g. ui.counter(g, 4, 4, 'RUPEES', 12)\\n- `E.ui.hearts(g, x, y, hp, max, o = {})`: row of hearts: hp and max in hearts (halves allowed, e.g. 2.5 of 3)\\n\\n## 21d. Shell\\n\\n- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\\n- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30 at 1,875)\\n- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\\n- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\\n1190→- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\\n- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\\n- `shell.back()` †: what cancel does: the screen's own back(), or close it (back to the screen under it; closing the pause screen resumes)\\n- `shell.dispose()` †: take its elements away and let go of the game (game.dispose() does it)\\n- `shell.hide()` †: close every screen (and resume, when the menu paused the game)\\n- `shell.hud(st = {})` †: the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\\n- `shell.hud({ objective })` †: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\\n- `shell.hud({ status, place, tip })` †: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\\n- `shell.hud({ bars, counts })` †: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label, value]]\\n- `shell.hud({ prompt })` †: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\\n1200→- `shell.hud({ keys, buttons })` †: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right: pause and map where there is no Escape key)\\n- `shell.hud({ minimap })` †: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y) (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\\n- `shell.screen` †: the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays\\n- `shell.settings` †: the player's settings: game.settings (the standard ones and the game's own, by key)\\n- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (strings or functions), actions: [[label, fn] or { label, fn, act, primary, disabled }], back (fn for cancel), rows: ['glyphs', 'invertY', '#A heading'] (settings' rows, changed as on the settings screen) }. From another screen it stacks (back() returns); shown again, it updates (the new spec over the old). 'settings' takes its items\\n- `shell.show('title')` †: { name, subtitle, meta: [...], footer }\\n- `shell.show('help')` †: { keys: [[key, what]], sections: [[heading, text]] }\\n- `shell.show('results')` †: { emblem, stats: [[value, label]], medals: [[label, earned]] }\\n- `shell.show('map')` †: { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) }\\n- `shell.toast(title, text = '', seconds = 4)` †: a message that slides in at the top for a few seconds\\n1210→- `shell.tutorial(title, text = '', seconds = 15)` †: a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away\\n- `shell.root = null` †: game: the game it is over; o: its options; root: its DOM element (null in a headless game)\\n\\n## 22. Gpu lighting (webgpu)\\n\\n- `game.gpu.active(view)` †: true when it lights frames in this view (ready, enabled and a ground view)\\n- `game.gpu.snapshot()` †: offscreen mode only: read the last frame back as a PNG data URL\\n- `game.gpu.status()` †: 'loading' | 'on' | 'off' | 'unavailable'\\n- `game.gpu.adapterInfo` †: the GPU's description from the browser (vendor, architecture), or null\\n- `game.gpu.ambient` †: the unlit color, [r, g, b] 0..1\\n1220→- `game.gpu.bands = 6` †: how many light bands (fewer is more retro)\\n- `game.gpu.enabled = true` †: false switches it off for now (and the canvas lighting with it, unless game.lights.enabled)\\n- `game.gpu.failed = null` †: why it couldn't start, or null\\n- `game.gpu.fallback = true` †: false keeps a frame it can't draw unlit (by default the canvas lighting stands in, game.lights.on)\\n- `game.gpu.glow = .22` †: the strength of px.glow surfaces\\n- `game.gpu.map = null` †: the TileMap it measures walls on\\n- `game.gpu.offscreen = false` †: render into a texture instead of the page (automated tests; read it with snapshot())\\n- `game.gpu.onStatus = null` †: called (gpu) when its status changes\\n- `game.gpu.ready = false` †: true once the GPU is set up\\n- `game.gpu.shadows = true` †: casters block light\\n1230→- `game.gpu.skipped` †: never queue more than two frames: a slow GPU drops frames instead of building up lag\\n- `game.gpu.spill = 1.1` †: how far light spills past its radius\\n- `game.gpu.wrap = .45` †: how far light wraps round wall corners, 0..1\\n\\n## 23. Sessions\\n\\n- `E.session` †: records a play session on any device and replays it exactly (this section's header says how)\\n- `E.session.frame` †: the frames run since the page loaded\\n- `E.session.record(on)` †: turn recording on or off for the next page loads (each load is a session of its own)\\n- `E.session.recording` †: true while this page load is recorded\\n1240→- `E.session.replaying` †: true while it is a replay\\n- `E.session.wanted()` †: true when recording is on for page loads (record(true))\\n\\n## Module arcade: the coin-op's frame: scores, high-score tables and initials, lives, credits, turns, cards, the attract mode (engine/modules/arcade.js)\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/API-INDEX.md\",\"offset\":1064,\"limit\":180,\"raw_output\":\"## 20. Audio\\n\\n- `E.note(n)`: note name -> frequency: E.note('A4') = 440, E.note('C#5'), E.note('Bb2'). Numbers pass through\\n- `E.songs: title, adventure, dungeon, boss, victory`: ready-made chiptune loops (original compositions). game.audio.music('adventure')\\n- `game.audio.applyVolume()`: apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it)\\n- `game.audio.at(step, fn)` †: call fn(step) on the update step the music reaches step (counted from its start, on as it loops); the song's change cancels it. Returns { cancel() }\\n- `game.audio.bus(name = 'sfx')`: a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument) to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio)\\n- `game.audio.calibrate()` †: the audio offset's calibration: a click on each beat (100 bpm, the first of a bar higher) as the music; tap(time) on each one heard (an event's timeStamp, or nothing: this update step). After 8 taps, result is the offset to set (ms: settings.audioOffset) and done is true; taps go on refining it. stop() puts the music back\\n- `game.audio.define(name, voice)`: add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 })\\n- `game.audio.duck(on = true)`: quiet the music (to 35%) while on: under a game's own pause, map or dialog screen. The engine also ducks it while game.paused\\n- `game.audio.instrument(name, fn)` †: an instrument of the game's own: fn(ctx, bus, time, freq, dur, vol) makes a note's sound (Web Audio, into bus, from time); its name is a wave a music track (wave: 'pluck') or a voice takes\\n- `game.audio.layer(track, vol = 1, fade = .5)` †: a track's volume as the song plays, 0..1, faded over fade seconds: layers of one song (the chase's drums in when the guards see you, out when they lose you). track: its index in song.tracks, or its name\\n- `game.audio.music(song, o = {})`: Loop a song (or play once with { loop: false }). song = { bpm: 120, steps: 4, tracks: [ { wave: 'square', vol: .2, notes: 'C5 - E5 - G5 - . . | ...' }, one token per step { wave: 'triangle', notes: 'C3 . C3 . G2 . G2 .' }, { wave: 'drums', notes: 'k . h . s . h . k k h . s . h .' } ] } tokens: C4 F#3 Bb2 = note, '-' holds the previous note, '.' = rest, '|' is ignored (bar lines). steps = steps per beat (4 = sixteenth notes). Each track loops on its own length within the song's (len: steps, else its longest track's); a track may have a name, and on: false starts it silent (a layer that audio.layer brings in). THE MUSIC CLOCK: a song starts at the game's time and where it is is game time (audio.pos, headless too: the same steps hear the same beats); the sound follows that clock. o: { loop, sync: true (it pauses with the game, on game.time; else it plays on through a pause, on game.real), fade: seconds (a crossfade from the song playing), restart: true (again from its start, though it is the one playing) }. E.songs has ready-made loops: title, adventure, dungeon, boss, victory.\\n- `game.audio.mute(on = !this.muted)`: toggle (or set) mute; returns the new state\\n- `game.audio.onBeat(fn)` †: call fn(beat, pos) on the update step of each beat of whatever music plays (a dancer's step, a light's pulse). Returns { cancel() }\\n- `game.audio.pos` †: where the music is, on the game's clock (headless too): { t: seconds since it started, step (from 0, counting on as it loops), beat, bar (four beats), at (the step in its loop), loop (times round), bpm, layers (each track's volume), playing }\\n- `game.audio.ready`: true once the browser lets the game make sound\\n- `game.audio.setVolume(v)`: set the master volume, 0..1\\n- `game.audio.sfx(what, o = {})`: Play a sound effect: a preset name ('jump', 'coin', 'hit', 'explode', ...), a voice object, or a list of voices. opts: { vol: 0..1, pitch: multiplier, vary: random pitch spread (default 0.03), step: a step of the music playing (it sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left) .. 1 (right), loop: true (it sounds on until stopped: an engine, rain; through the effects' bus, so it follows the volume and the mute) }. Returns its handle: { stop(fade .03), set({ pan, vol }), playing, pan }: a handle that does nothing when nothing plays (headless, before the first key, an unknown name)\\n- `game.audio.sting(song, o = {})` †: play a short song once over the music (a goal's jingle): o.at 'now', 'beat' or 'bar' (on the music's next beat or bar), o.duck (the music's volume under it, .4)\\n- `game.audio.stopMusic(fade)`: stop the music (it fades out over fade seconds, .06 by default)\\n- `game.audio.tempo(bpm)` †: change the music's tempo as it plays (hurry up!): where it is stays, the steps after come at the new bpm\\n- `game.audio.anchors = 0` †: how many times the sound was moved to meet the clock\\n- `game.audio.ctx = null`: the Web Audio context, made at the first sound (null before, or where there is none)\\n- `game.audio.drift = 0` †: what is heard against the game's clock at the last frame (seconds: the sound follows the clock, so it stays near 0)\\n- `game.audio.ducked = false`: true while duck(true) holds the music down\\n- `game.audio.failed = null`: why there is no sound (a message), or null\\n- `game.audio.musicVolume = .5`, `game.audio.sfxVolume = 1`, `game.audio.voiceVolume = 1`: 0..1 for effects, music and the voice bus (bus('voice'))\\n- `game.audio.muted = false`: true while mute() is on\\n- `game.audio.offset = 0` †: seconds the music sounds early, for speakers and headphones that lag (settings.audioOffset)\\n- `game.audio.presets`: the named sound effects, sfx(name) plays one and define(name, voice) adds one\\n- `game.audio.song = null`: the music playing (null for none)\\n- `game.audio.volume = .7`: master volume 0..1\\n\\n## 21b. Backdrops\\n\\n- `new E.Backdrop(o = {}) → backdrop`: new E.Backdrop('castle-night') (a preset: E.Backdrop.presets) or new E.Backdrop({ sky: [colors top to bottom], sun, moon, stars, layers: [{ kind: 'mountains' | 'hills' | 'forest' | 'city' | 'castle' | 'clouds' | 'sea' | 'fog' | 'stalactites', color, y, height, parallax, seed }] }): a parallax sky and scenery drawn behind a level. sun, moon: { x, y (0..1 of the screen), r, color }\\n- `E.Backdrop.presets` †: the preset names, all ten: day, dusk, night, castle-night, city-night, desert, forest, ocean, cave, space\\n- `backdrop.draw(r)` †: draw the backdrop first in draw(r), before the level; it scrolls with the camera by each layer's parallax\\n- `backdrop.layers` †: its scenery layers, back to front, with their defaults filled in\\n- `backdrop.sky` †: the sky's gradient colors, top to bottom\\n\\n## 21c. Props\\n\\n- `E.PROPS: torch, candle, candelabra, chandelier, brazier, window, banner, pillar, statue, crate, barrel, chest, pot, sign, fence, lamp, door, tree, pine, bush, flowers, grass, rock, crystal, bones, skull, vines, cobweb, lantern, streetlamp, awning, hydrant, trashcan, firedrum, sandbags, cactus, palm, mushroom` †: the names of the built-in props for r.prop(name, x, y, z, opts) and E.prop(name, opts)\\n- `E.prop(name, o = {})`: build (and cache) a prop: { frames: [sprite], glow: [sprite] | null, w, h }\\n\\n## 21e. Shapes\\n\\n- `E.SHAPES: barrel, crate, chest, table, chair, stool, bench, bed, bookcase, shelf, pot, jar, sack, cart, ... (25)`: the shapes by id: { about, tags, mats: { slot: material }, parts | make(params), params, foot, lights, flames } (the core library's, the sets' as 'SET:id' from E.addAssets, and your own: E.SHAPES.stool = {...})\\n- `E.addAssets(set)`: register a store set (src/assets/sets/*.js: { set, format: 1, credit, sources, materials, shapes, sprites }): its entries are named 'SET:id' (so one set never changes another's, or the core's) and find their own set's materials and shapes first. An id that is already there warns and keeps the first. Returns { shapes: [ids], materials: [ids], sprites: { id: sprite } } (sprites are E.sprite data; a color may be 'material:tone', tone deep | sh | base | lt | hi)\\n- `E.materialTile(id, o = {})`: a material's pattern as a tile of pixels, for a 3D renderer's texture: E.materialTile(id, { size: 32 (world units square: it repeats every size; a face pattern's whole face), px: 2 (pixels a unit), lid: false (true: as on a face looking up), curved (as on a turned face), band: 2 (the light: 0 dark .. 4 bright) }) -> { w, h, rgba (Uint8ClampedArray, top row first, v up the tile) }; null for an unknown material\\n- `E.shapeBox(id, x, y, z = 0, o = {})`: where a placed shape stands, as both engines collide with it: E.shapeBox(id | entry, x, y, z, { facing, scale, flip, params }) -> { x, y (its footprint's middle), z, top, hx, hy (half its footprint, along its own x and y), c, s (the turn's cosine and sine) }; null for an unknown shape. map.solid makes one solid; world.shape gives it a collider\\n- `E.shapeInfo(id, o = {})`: what a shape draws, for tools and tests: E.shapeInfo(id, { view: 'iso', facing, scale, mats, params }) -> { w, h, ox, oy, tris, prims (its primitives), parts (each primitive's pixels on screen: 0 is never seen there), colors (distinct), pixels, bounds [x0, y0, z0, x1, y1, z1], rgba }; null for an unknown shape\\n- `E.shapeMesh(id, o = {})`: a shape's triangles, for a 3D renderer (the 3D engine's world.shape): E.shapeMesh(id | entry, { params, mats, seg }) -> { groups: [{ mat, key, lid, curved, face, pos, nrm, uv }], bounds [x0, y0, z0, x1, y1, z1] } in the entry's own units and frame (z up, its front +y, its own scale applied: place it with the placement's facing, scale and flip). The same parts as r.shape draws; null for an unknown shape\\n- `E.shapeMesh({ seg })`: seg(r): the segments round a radius r (default 8 to 24)\\n- `E.shapeMesh() → groups`: each one's mat (the material ready to draw: E.material's), key (its id), lid (true: the faces looking up or down, which some patterns draw their own way), curved (turned or round faces: planks run up them), face (a pattern drawn once per face, the crate's sides and bark's ends: uv runs 0 to 1 across each face), pos, nrm, uv (Float32Arrays: three numbers a corner, three corners a triangle; uv two a corner, world units across the surface)\\n- `E.shapeSprite(id, o = {})`: a shape as a sprite (E.sprite's kind: r.sprite, px.sprite, inventories, HUDs, portraits): E.shapeSprite(id, { view: 'iso', facing, size (its scale, 1), mats, params, outline: true | a color | false }). The view is a name or a View, as given (r.shape draws steep views from the characters' angle: E.charView(view) gives that); a bag icon is the item's shape seen at an angle. r.sprite stands it on its feet (foot: [x, y] in the sprite) unless an anchor is given\\n\\n## 21. Ui\\n\\n- `new E.Dialog(game, o = {}) → talk`: new E.Dialog(game, { speed, lines, place, color, nameColor, voice, width, bg, border, vars }): a dialog box that types its text; say() opens it, update(dt) and draw(r) run it\\n- `talk.choiceAt(i)` †: where choice i is on the screen while the choices show: [x, y] (its middle, for a test's tap), else null\\n- `talk.close()`: close it now (and forget pending presses, so the same press doesn't also attack)\\n- `talk.draw(r)`: draw it (anywhere in draw: it goes to the overlay)\\n- `talk.pageLen`: the letters on the page shown\\n- `talk.say(text, o = {})`: open with one string or a list of strings (each starts a new page). opts: { name, onDone, choices, onChoice, portrait: rig (a live close-up of that Humanoid beside the text) or a function (g, x, y, size), portraitSize: 40, portraitOpts: { zoom, turn, bg }, auto: seconds a page shows before it turns by itself, modal: false (play goes on while it shows: radio chatter), place: 'top' | 'middle' | 'bottom', y, alpha, vars: the values {$name} reads, voice: this call's (a sound effect, null, or a function per letter) } choices: ['YES', 'NO'], shown on the last page (picked by the keys, or a tap or click on one); onChoice(i) gets the one picked. update(dt) returns true while a modal box is open: return from your update then, and play waits\\n- `talk.typing`: true while the page is still typing\\n- `talk.update(dt)`: type and turn pages (confirm finishes the line, then turns the page); returns true while open and modal, so gameplay can wait: if (talk.update(dt)) return;\\n- `talk.auto`: seconds each page stays after typing\\n- `talk.bg = '#141a3a'`, `talk.border = '#e8e4ff'`: the box's colors\\n- `talk.choice = 0`: the choice under the cursor\\n- `talk.choices`: the answers offered on the last page, or null\\n- `talk.color = '#ffffff'`: the text's color\\n- `talk.game`: its game\\n- `talk.i = 0`: the page shown\\n- `talk.lines = 3`: text lines per page\\n- `talk.modal`: false lets play go on (radio chatter)\\n- `talk.name`: the speaker's name shown on the box\\n- `talk.nameColor = '#ffd36a'`: the speaker's name's color\\n- `talk.onChoice`: called with the index picked\\n- `talk.onDone`: called when the last page closes\\n- `talk.open = false`: true while it shows\\n- `talk.pages = []`: the text wrapped into pages of lines\\n- `talk.place = 'bottom'`: 'bottom' | 'top' | 'middle'\\n- `talk.portrait`: the portrait beside the text (a Humanoid, or a function (g, x, y, size)), or null; pSize: its size in pixels; pOpts: its options ({ zoom, turn, bg })\\n- `talk.shown = 0`: letters typed so far on it\\n- `talk.speed = 50`: letters typed per second\\n- `talk.vars = null`: the values {$name} in the text reads (say's vars first)\\n- `talk.voice = 'text'`: the sound effect each letter blips ('text'; null for silence), or a function (letter, index, dialog) called once for each letter as it types (a babble voice: Animalese; dialog.name is the speaker)\\n- `talk.width = 0`: the box's width in pixels (320 at most by default, the screen's less 12 at most)\\n- `new E.Menu(game, items, o = {}) → menu`: Menu with a cursor (title screens, pause menus, shops, battle commands). const menu = new E.Menu(game, ['START', 'OPTIONS', { label: 'CONTINUE', disabled: !save }], { onPick(i, item) {...}, onCancel() {...} }); update: menu.update(dt) draw: menu.draw(r) opts: { x: 'center' | px, y: 'center' | px, title, box: true, color, pick: '#ffd36a', columns: 1 }\\n- `menu.draw(r)`: draw it to the overlay\\n- `menu.rowAt(i)` †: entry i's box on the screen, [x, y, w, h] in screen pixels: where a click or tap picks it (a test's feed('down') and feed('up') there); null while it is scrolled out of view\\n- `menu.selected`: the entry under the cursor\\n- `menu.update()`: move the cursor (up, down; held keys repeat; the mouse over an entry) and pick (confirm, or a click or tap on an entry) or cancel; returns true when it picked or cancelled\\n- `menu.active = true`: false stops it reading input\\n- `menu.bg = '#141a3a'`, `menu.border = '#e8e4ff'`: the window's colors\\n- `menu.box = true`: draw a window round it\\n- `menu.color = '#ffffff'`: the entries' color\\n- `menu.dim = '#6a6488'`: disabled entries' color\\n- `menu.game`: its game\\n- `menu.i = 0`: the one under the cursor\\n- `menu.input = null` †: the one input it reads (default: every player's, so any player moves and picks; the mouse and taps are player 1's)\\n- `menu.items`: the entries (strings, or { label, disabled })\\n- `menu.onCancel = null`: called on cancel\\n- `menu.onMove = null`: called (i, item) when the cursor moves\\n- `menu.onPick = null`: called (i, item) on confirm\\n- `menu.pick = '#ffd36a'`: the color of the one under the cursor\\n- `menu.rows = 0` †: at most that many entries shown, the list scrolling under its cursor (0: all)\\n- `menu.scale = 1` †: its text and rows that many times (2, 3: across a room on a TV)\\n- `menu.sound = true`: false silences it\\n- `menu.title = null`: a heading, or null\\n- `menu.x = 'center'`, `menu.y = 'center'`: where it sits, 'center' or pixels\\n- `E.ui`: pixel-drawn interface pieces for r.overlay\\n- `E.ui.bar(g, x, y, w, h, frac, color = '#e0463c', o = {})`: a bar (a meter: health, magic, stamina, a boss's): ui.bar(g, x, y, w, h, 0..1, '#e0463c')\\n- `E.ui.box(g, x, y, w, h, o = {})`: window frame: ui.box(g, x, y, w, h, { bg, border, shadow, gradient }) bg: one color (drawn as a soft top-to-bottom gradient, like Final Fantasy windows) or [top, bottom] colors. gradient: false for a flat fill.\\n- `E.ui.counter(g, x, y, label, value, color = '#ffffff', o = {})`: label + value, e.g. ui.counter(g, 4, 4, 'RUPEES', 12)\\n- `E.ui.hearts(g, x, y, hp, max, o = {})`: row of hearts: hp and max in hearts (halves allowed, e.g. 2.5 of 3)\\n\\n## 21d. Shell\\n\\n- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\\n- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30 at 1,875)\\n- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\\n- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\\n- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\\n- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\\n- `shell.back()` †: what cancel does: the screen's own back(), or close it (back to the screen under it; closing the pause screen resumes)\\n- `shell.dispose()` †: take its elements away and let go of the game (game.dispose() does it)\\n- `shell.hide()` †: close every screen (and resume, when the menu paused the game)\\n- `shell.hud(st = {})` †: the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\\n- `shell.hud({ objective })` †: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\\n- `shell.hud({ status, place, tip })` †: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\\n- `shell.hud({ bars, counts })` †: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label, value]]\\n- `shell.hud({ prompt })` †: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\\n- `shell.hud({ keys, buttons })` †: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right: pause and map where there is no Escape key)\\n- `shell.hud({ minimap })` †: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y) (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\\n- `shell.screen` †: the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays\\n- `shell.settings` †: the player's settings: game.settings (the standard ones and the game's own, by key)\\n- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (strings or functions), actions: [[label, fn] or { label, fn, act, primary, disabled }], back (fn for cancel), rows: ['glyphs', 'invertY', '#A heading'] (settings' rows, changed as on the settings screen) }. From another screen it stacks (back() returns); shown again, it updates (the new spec over the old). 'settings' takes its items\\n- `shell.show('title')` †: { name, subtitle, meta: [...], footer }\\n- `shell.show('help')` †: { keys: [[key, what]], sections: [[heading, text]] }\\n- `shell.show('results')` †: { emblem, stats: [[value, label]], medals: [[label, earned]] }\\n- `shell.show('map')` †: { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) }\\n- `shell.toast(title, text = '', seconds = 4)` †: a message that slides in at the top for a few seconds\\n- `shell.tutorial(title, text = '', seconds = 15)` †: a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away\\n- `shell.root = null` †: game: the game it is over; o: its options; root: its DOM element (null in a headless game)\\n\\n## 22. Gpu lighting (webgpu)\\n\\n- `game.gpu.active(view)` †: true when it lights frames in this view (ready, enabled and a ground view)\\n- `game.gpu.snapshot()` †: offscreen mode only: read the last frame back as a PNG data URL\\n- `game.gpu.status()` †: 'loading' | 'on' | 'off' | 'unavailable'\\n- `game.gpu.adapterInfo` †: the GPU's description from the browser (vendor, architecture), or null\\n- `game.gpu.ambient` †: the unlit color, [r, g, b] 0..1\\n- `game.gpu.bands = 6` †: how many light bands (fewer is more retro)\\n- `game.gpu.enabled = true` †: false switches it off for now (and the canvas lighting with it, unless game.lights.enabled)\\n- `game.gpu.failed = null` †: why it couldn't start, or null\\n- `game.gpu.fallback = true` †: false keeps a frame it can't draw unlit (by default the canvas lighting stands in, game.lights.on)\\n- `game.gpu.glow = .22` †: the strength of px.glow surfaces\\n- `game.gpu.map = null` †: the TileMap it measures walls on\\n- `game.gpu.offscreen = false` †: render into a texture instead of the page (automated tests; read it with snapshot())\\n- `game.gpu.onStatus = null` †: called (gpu) when its status changes\\n- `game.gpu.ready = false` †: true once the GPU is set up\\n- `game.gpu.shadows = true` †: casters block light\\n- `game.gpu.skipped` †: never queue more than two frames: a slow GPU drops frames instead of building up lag\\n- `game.gpu.spill = 1.1` †: how far light spills past its radius\\n- `game.gpu.wrap = .45` †: how far light wraps round wall corners, 0..1\\n\\n## 23. Sessions\\n\\n- `E.session` †: records a play session on any device and replays it exactly (this section's header says how)\\n- `E.session.frame` †: the frames run since the page loaded\\n- `E.session.record(on)` †: turn recording on or off for the next page loads (each load is a session of its own)\\n- `E.session.recording` †: true while this page load is recorded\\n- `E.session.replaying` †: true while it is a replay\\n- `E.session.wanted()` †: true when recording is on for page loads (record(true))\\n\\n## Module arcade: the coin-op's frame: scores, high-score tables and initials, lives, credits, turns, cards, the attract mode (engine/modules/arcade.js)\\n\",\"total_lines\":1767}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"b5d221fd-2a22-44c5-a10b-bd11cca460b3"}
{"type":"assistant","message":{"id":"msg_12","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"This is a large project requiring a complete game implementation.\n\nI'm examining the specific APIs needed: Rhythm, Mode7, Road, Physics, Humanoid, Mocap, renderer queues, TileMap, and check.mjs expectations. I'll also review sports.js for scene patterns. The architecture starts with a balance.js Lean model class.\n\nI need to match the table values before building the rest. I'll write a simulator and tune the push model first. The bot model uses delayed position and velocity feedback plus smoothed noise. I'll use a history buffer for the delayed state and apply the specified noise weights.\n\nThe smoothNoise will reuse the same three-sine noise at a lower frequency, scaled by the bot's noise parameter. A standalone Node script will tune the balance model without the engine. Passive mode means no bot input. Falls trigger when hypotenuse exceeds one, forcing a one-second stumble that ignores input and eases position home; some of that time may count as inside the ring. The table's 20% figure is steadiness, with five falls noted separately.\n\nStumble physics will ease position home with exponential decay and halve velocity. Falls increment a counter and trigger a score penalty. I'll test several push model interpretations to find one matching within ±10. The test uses 12 seeds, so I need to clarify whether the bands are averages across seeds or per-seed results.\n\nI'll verify that the mean across 12 seeds lands within ±10 points of the target table value. I'm also modeling the push mechanic as a periodic velocity impulse applied at random angles.\n\nI'm also considering whether pushes last for a duration rather than being instantaneous. The noise RNG is seeded six times at startup, with the bot maintaining its own independent noise stream. Reproducibility depends on the exact order of RNG consumption, but the test only requires the final band values. I'll run my own simulation using the given formulas and adjust the push model until the output matches the target table.\n\nThe push model is the main remaining ambiguity. I will write the simulator now and iterate quickly.\n\nKeyboard scoring at 2.2/s should match stick performance. The bot model serves as the player model for tests, while keyboard and mouse are separate claims. Acceptance criteria focus on bot bands landing within ±10 on 12 seeds. I also need to verify that keyboard nudging can achieve similar scores.\n\nActivity star gates are the next challenge. Each activity has its own scoring rules, so bots must hit specific thresholds. I'll implement the plan's formulas faithfully and tune any \"start\" parameters to make gates pass.\n\nStar tiers are defined by passive, average, and good thresholds. Default star gates sit at 1★ .35, 2★ .65, and 3★ .90. Sun Flow and Step use the same thresholds but score about .4 when doing nothing. Stork uses the default gates yet subtracts 0.05 per fall from steadiness. Tier 1 Stork math confirms passive scores zero stars, average scores two, and good scores three.\n\nTier 1 star gates only require average at least 1★ and good at least 2★; poor is not tested. For Stork, average must stay under 6.6 falls to clear the 1★ floor, while good must stay under roughly 3.8 falls to clear 2★.\n\nThe expert tier lacks a table column, but better tracking should push steadiness higher. Bots must actually play each activity rather than just stand still: Sun Flow requires breathing with the guide, Reps requires bead tracking, Step requires note hits, Hoop requires circling, Jog requires cadence and steering, Slalom requires gate steering, Tray requires olive rolling, and Laundry requires walking and jumping.\n\nThe bot registry returns intent, and activities read that intent to score. Each activity must translate bot quality into its own scoring logic so passive stays under 1★, average clears 1★, and good clears 2★.\n\nEach activity will run as a real simulation for 45–90 seconds at 120 Hz, yielding 5,400 to 10,800 steps. Scoring will be based on how well the bot intent tracks the required target during that full duration.\n\nThe full test suite requires roughly 800,000 steps across all activities, tiers, and skills. Browser tests will stay focused because they are slower. The scoring simulator can remain lightweight since the real game will use its own engine modules for visuals. Tests must drive the shipped game directly from its real start; they cannot use a mocked or copied Lean model.\n\nHeadless game.advance can drive activities directly. A 60-second activity takes about 7,200 updates. Running all activities in one test should take roughly 10 to 30 seconds. The full five-day playthrough spans roughly 108,000 steps plus menus. Node execution may still be slow because humanoid updates and rig solving are expensive even without drawing.\n\nI considered using timeScale to fast-forward the playthrough test, but advance() runs fixed 1/120-second steps and may not tolerate large dt multipliers. The test must use real input taps and bots and reach the ending naturally.\n\nadvance(60) always executes exactly 7,200 steps regardless of timeScale. A higher multiplier would increase wall-clock speed but not reduce the step count, so fast-forwarding the playthrough test is not viable.\n\nA full playthrough spans roughly 144,000 steps. Headless humanoid rig solving may add a few seconds of overhead, but that is acceptable. I will profile the cost later. I also need to review the rhythm module API, the road and mode7 modules, and the renderer draw API so the activities can use the real engine modules.\n\nI will read the first 100 lines of sports.js, the rhythm module header, check.mjs, and the mocap.js API to understand the codebase structure. Then I will write the balance tuner. I also need to patch the Dialog class at three specific lines for name, text, and choices, not the Menu class. The game ID should be either 'spinewee' or 'spine-wee'.\n\nI am reviewing how settings.music applies and checking the index.html boot splash. I will write files in batches to keep the structure complete but concise. The game state object will track the player slot, nickname, look, instructor, day, phase, sessionsToday, spine history, and best scores.\n\nThe game state object will also hold played flags, total minutes, unlocks, a current suggestion, and debug flags. Tests will use deep links and debug helpers like jump and snapshot to script the full playthrough from title through five days of activities.\n\nThe full playthrough ends with Day 5 gentle games, a duel, the ending, credits, and free play. Tests will drive menus with real input taps such as confirm and down, so the UI must stay deterministic. An attract mode will trigger after ten seconds of idle time on the title or top menu; any input during attract consumes all events and returns to the title without writing saves. Headless input.tap counts toward this detection.\n\nThe idle timer threshold is exactly ten seconds, so advancing nine point nine seconds keeps the game on the title screen. The attract mode triggers at ten seconds and above.\n\nDev mode will be reachable from the pause menu in headless tests via input taps or game.menu(). The dev panel runs on a canvas while the game continues, and tests will drive it through G.dev.set, G.dev.reset, and G.dev.jump.\n\nThe dev panel will expose a single slider array with adjust, reset, and jump functions. Tests can drive the real slider logic through these API calls. Opening the pause menu and using input to change sliders is another option, but it is more fragile.\n\nTests will open dev mode through the pause menu and drive the panel via its real methods. Save slots use game.saves with three slots, and corrupted saves must not crash. Determinism is enforced by seeding the RNG and hashing inputs so identical runs produce identical results. The class activity uses four players, scores, and a podium. A fake AIHub object will be injected into window for testing; it must report time-up once per run and block input at the end. The game checks AIHub.active at startup.","signature":""},{"type":"tool_use","id":"call-1b15abfd-d6e0-4e15-8dc5-94e14d78f79f-19","name":"grep","input":{"pattern":"__hubCheck|pass|checks","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/hub/harness.html","head_limit":40}},{"type":"tool_use","id":"call-1b15abfd-d6e0-4e15-8dc5-94e14d78f79f-20","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/my-3d2dge.js","offset":9200,"limit":80}},{"type":"tool_use","id":"call-1b15abfd-d6e0-4e15-8dc5-94e14d78f79f-21","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/engine/API-INDEX.md","offset":1512,"limit":160}},{"type":"tool_use","id":"call-1b15abfd-d6e0-4e15-8dc5-94e14d78f79f-22","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/vendor/mocap.js","limit":80}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":17238,"output_tokens":4358,"cache_read_input_tokens":66304,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"ba29458f-6912-45ae-917d-e6c02af0640c"}
