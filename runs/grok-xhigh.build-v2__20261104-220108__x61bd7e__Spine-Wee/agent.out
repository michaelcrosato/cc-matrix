\"  location: { hash: '', search: '', pathname: '/index.html', href: 'file:///index.html' },\"},{\"line_number\":56,\"content\":\"for (const f of FILES) vm.runInContext(fs.readFileSync(path.join(dev, f), 'utf8'), ctx, { filename: f });\"},{\"line_number\":134,\"content\":\"add('rules', 'boot smoke', () => {\"},{\"line_number\":146,\"content\":\"add('rules', 'section 3 bands', () => {\"},{\"line_number\":171,\"content\":\"add('rules', 'device lean', () => {\"},{\"line_number\":201,\"content\":\"add('rules', 'good playthrough', () => {\"},{\"line_number\":219,\"content\":\"add('rules', 'passive playthrough', () => {\"},{\"line_number\":230,\"content\":\"add('rules', 'star gates', () => {\"},{\"line_number\":258,\"content\":\"add('rules', 'saves', () => {\"},{\"line_number\":292,\"content\":\"add('rules', 'determinism', () => {\"},{\"line_number\":300,\"content\":\"add('rules', 'attract at 10s', () => {\"},{\"line_number\":326,\"content\":\"add('rules', 'dev sliders', () => {\"},{\"line_number\":374,\"content\":\"add('rules', 'local class', () => {\"},{\"line_number\":416,\"content\":\"add('rules', 'fake hub', async () => {\"},{\"line_number\":430,\"content\":\"      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\"},{\"line_number\":476,\"content\":\"add('rules', 'data lint', () => {\"},{\"line_number\":493,\"content\":\"add('rules', 'draw scenes', () => {\"},{\"line_number\":803,\"content\":\"    fails.push({ name: t.group + ' ' + t.name, err: e && e.stack ? e.stack : String(e) });\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"01f4d331-9a91-4523-8ea1-4d03661f0b99"}
{"type":"assistant","message":{"id":"msg_597","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A solid plan is in place. The implementation will be carefully checked to ensure single-player physics remain identical.\n\nA `leanOf` function will handle per-player lean input. Player 1 keeps the same behavior. Other players use pad, mouse, and key controls. Panel arrow blocking is restricted to player 1.\n\nMouse input is restricted to player 1 only. Player 2 will use arrow keys for lean. Each Input object handles its own pad movement.\n\n`blankLean` returns a default lean object with zero values and default flags. `applyLean` writes into that object instead of global state. `readLean` initializes a per-player array of lean states.\n\nThe global `G.lean` object will be shared with the first player's lean entry in the new array. This preserves existing code that mutates the global object directly and avoids breaking tests or `drive()`.\n\nThe `readLean` function now iterates over all players. It applies panel, mouse, and cursor controls only to the first player. For the remaining players it passes `panel: false`, `mouse: false`, and `cursor: false`. Each player's lean state is written into its corresponding entry in the `G.leans` array. Breathing and effort will also be handled per player. Seat indices map directly to player indices when the seat is local.\n\nA `seatLean` helper will return the per-player lean state for a given seat. It falls back to the global `G.lean` if the seat is missing or not local. `drive()` will use this helper for human players at local seats. The seat index will be stored on each seat object so it remains stable even when lean objects are replaced.\n\nA `leanFor` helper will look up a seat's lean state using its stored `pi` index. Single-player seats lack this index, so they fall back to the global lean object.\n\nA problem was spotted: `skillName` returns the global `G.driver` for every seat when that driver is not `'human'`. This would break class behavior if `G.driver` is set globally.\n\nSetting a global `G.driver` is the intended mechanism for the dev bot override. This will make every class seat a bot when activated, which is acceptable for the dev tool. Headless class seats must remain human.\n\nClass seats are now defined with `human: !!local` and `skill: local ? null : 'average'`. Local seats become human players. Empty mats remain non-scoring fill with skill average and no driver. Attract mode uses its own driver, so class seats stay unaffected.\n\nThe existing one-player class test keeps only the human player and a non-scoring Regular seat. Surprise me runs stork, candle, and hoop. A still human on stork drifts from balance noise and finishes with a low percentage. The test does not verify that the human score is non-zero. The Regular seat scores zero. Podium logic remains intact.","signature":""},{"type":"tool_use","id":"call-650ea1a1-dcf8-473d-97d0-89d71cfcdf96-15","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/tests/run.mjs","offset":326,"limit":200}},{"type":"tool_use","id":"call-650ea1a1-dcf8-473d-97d0-89d71cfcdf96-16","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game/world.js","offset":1,"limit":40}},{"type":"tool_use","id":"call-650ea1a1-dcf8-473d-97d0-89d71cfcdf96-17","name":"grep","input":{"pattern":"makeRig|stepRig|poseRig|function actor|globalAlpha|px\\.blend","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/Spine Wee-Wii Fit-grok-4.7-xhigh-20261104-220108/game","glob":"*.js","head_limit":30}},{"type":"tool_use","id":"call-650ea1a1-dcf8-473d-97d0-89d71cfcdf96-18","name":"grep","input":{"pattern":"testingFeedback|6 issues|game-breaking","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-220108__x61bd7e/work/exit-interview.json"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":6787,"output_tokens":2056,"cache_read_input_tokens":71552,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"4ff44135-f891-4355-a697-0831301ec841"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-650ea1a1-dcf8-473d-97d0-89d71cfcdf96-15","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"326→add('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  G.dev.jump({ day: 3, scene: 'bungalow' });\\n  game.advance(1 / 120);\\n  let s = snap(game);\\n  assert(s.scene === 'bungalow' && s.day === 3, s.scene + ' day ' + s.day);\\n  G.dev.jump({ activity: 'stork', tier: 2, driver: 'good' });\\n  game.advance(0.5);\\n  s = snap(game);\\n  assert(s.activity === 'stork' && s.tier === 2, s.activity + ' t' + s.tier);\\n  G.dev.close();\\n370→  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n380→  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n390→  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n400→    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n410→  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n420→  const sent = [];\\n  const progress = [];\\n  let result = null;\\n  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n430→      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n440→  };\\n  try {\\n    const game = boot();\\n    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n450→    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n460→    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n470→    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n480→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n490→  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n500→      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n510→\\nfunction buildHtml() {\\n  const r = spawnSync(process.execPath, ['build.mjs'], { cwd: dev, encoding: 'utf8' });\\n  if (r.status) throw new Error(r.stdout + '\\\\n' + r.stderr);\\n  return HTML;\\n}\\n\\nfunction startServer(dir) {\\n  return new Promise(function (resolve, reject) {\\n    const child = spawn('python3', ['-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\\n520→    let buf = '';\\n    let settled = false;\\n    const take = function (chunk) {\\n      buf += chunk.toString();\\n      const m = buf.match(/port (\\\\d+)/i);\\n      if (m && !settled) { settled = true; resolve({ child: child, port: +m[1] }); }\",\"content_concise\":\"326→add('rules', 'dev sliders', () => {\\n  const game = boot();\\n  const items = game.o.menu.items;\\n  const devItem = items.filter(function (it) { return it[0] === 'Dev Mode'; })[0];\\n330→  assert(devItem, 'no dev item');\\n  devItem[1]();\\n  assert(G.dev.panel && G.dev.on, 'panel closed');\\n  assert(game.live === true, 'game not live');\\n  const before = G.dev.v.k;\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k !== before, 'slider stayed ' + G.dev.v.k);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n340→  G.dev.toolAct(11);\\n  assert(G.dev.poseMode, 'pose viewer closed');\\n  assert(G.dev.clipNames().length > 5, 'clips ' + G.dev.clipNames().length);\\n  game.input.press('ArrowDown');\\n  game.advance(1 / 120);\\n  assert(G.dev.poseI === 1, 'clip index ' + G.dev.poseI);\\n  game.input.release('ArrowDown');\\n  game.advance(1 / 120);\\n  game.input.press('ArrowRight');\\n  game.advance(1 / 120);\\n350→  assert(G.dev.poseT > 0, 'did not scrub ' + G.dev.poseT);\\n  game.input.release('ArrowRight');\\n  game.advance(1 / 120);\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  assert(G.dev.printed && G.dev.printed.indexOf(\\\"clip: '\\\") >= 0, 'pose row ' + G.dev.printed);\\n  G.dev.poseMode = false;\\n  game.input.press('KeyR');\\n  game.advance(1 / 120);\\n  assert(G.dev.v.k === 1, 'reset k ' + G.dev.v.k);\\n360→  assert(game.timeScale === 1, 'timeScale ' + game.timeScale);\\n  G.dev.jump({ day: 3, scene: 'bungalow' });\\n  game.advance(1 / 120);\\n  let s = snap(game);\\n  assert(s.scene === 'bungalow' && s.day === 3, s.scene + ' day ' + s.day);\\n  G.dev.jump({ activity: 'stork', tier: 2, driver: 'good' });\\n  game.advance(0.5);\\n  s = snap(game);\\n  assert(s.activity === 'stork' && s.tier === 2, s.activity + ' t' + s.tier);\\n  G.dev.close();\\n370→  assert(!G.dev.on && !G.dev.panel, 'panel left on');\\n  assert(game.timeScale === 1, 'timeScale left ' + game.timeScale);\\n});\\n\\nadd('rules', 'local class', () => {\\n  const game = boot();\\n  game.go('class', {}, { fade: 0 });\\n  game.advance(1 / 120);\\n  assert(G.scenes.class._pills, 'class did not open ' + JSON.stringify(game.errors));\\n  const labels = (G.scenes.class._pills.items || []).map(function (it) { return it.label; });\\n380→  for (const name of ['Stork Stand', 'Quiet Candle', 'Squat Rail', 'Step Class', 'Hoop Hips', 'Surprise me']) {\\n    assert(labels.indexOf(name) >= 0, 'missing ' + name + ' in ' + labels.join(','));\\n  }\\n  while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\\n  for (let i = 0; i < 5; i++) {\\n    game.input.press('ArrowDown');\\n    game.advance(1 / 120);\\n  }\\n  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n390→  let guard = 0;\\n  while (guard++ < 30000 && !G.podium) {\\n    const s = snap(game);\\n    if (s.phase === 'play' || s.phase === 'auto') {\\n      const dt = Math.max(1 / 120, Math.min(1, s.left > 0 ? s.left : 1 / 120));\\n      game.advance(dt);\\n    } else {\\n      game.input.tap('confirm');\\n      game.advance(1 / 120);\\n    }\\n400→    if (game.errors.length) throw new Error(game.errors.join(' | '));\\n  }\\n  assert(G.podium && G.podium.length >= 2, 'no podium');\\n  G.podium.forEach(function (q) {\\n    assert(q.score >= 0 && q.score <= 1000, 'score ' + q.score);\\n  });\\n  const regular = G.podium.filter(function (q) { return q.name === 'Regular'; })[0];\\n  assert(regular && regular.score === 0, 'empty mat scored ' + JSON.stringify(G.podium));\\n  game.input.release('Act:confirm');\\n  game.advance(1 / 120);\\n410→  game.input.tap('confirm');\\n  game.advance(1 / 120);\\n  game.advance(1 / 120);\\n  assert(snap(game).scene === 'title', 'left class to ' + snap(game).scene + ' err=' + JSON.stringify(game.errors));\\n});\\n\\nadd('rules', 'fake hub', async () => {\\n  const quiet = realAIHub.connect();\\n  const alone = await quiet;\\n  assert(alone === null, 'inactive connect ' + alone);\\n420→  const sent = [];\\n  const progress = [];\\n  let result = null;\\n  let resultN = 0;\\n  let answered = null;\\n  let now = -Infinity;\\n  const handlers = {};\\n  ctx.AIHub = {\\n    active: true,\\n    connect() {\\n430→      return Promise.resolve({ players: [{ name: 'Red Fox', color: '#ff4a4a' }] });\\n    },\\n    ready() { ctx.AIHub._ready = true; },\\n    time() { return now; },\\n    answer(k) { answered = k; },\\n    send(m) { sent.push(m); },\\n    progress(p) { progress.push(p); },\\n    result(r) { resultN++; result = r; },\\n    rng() { return E.rng(3); },\\n    on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); }\\n440→  };\\n  try {\\n    const game = boot();\\n    await new Promise(function (r) { setImmediate(r); });\\n    assert(G.inSession, 'not in session');\\n    assert(ctx.AIHub._ready, 'ready was not called');\\n    assert(snap(game).scene === 'round', snap(game).scene);\\n    assert(game.o.menu.items.length === 0, 'dev menu in session');\\n    game.input.tap('confirm');\\n    game.advance(1 / 120);\\n450→    assert(answered === 'ready', 'answer ' + answered);\\n    now = 0;\\n    game.advance(2);\\n    assert(G.morningEvents && G.morningEvents.length === 3, 'deal ' + G.morningEvents);\\n    const pools = [['stork', 'candle', 'squat', 'push'], ['step', 'hoop'], ['slalom', 'jog']];\\n    G.morningEvents.forEach(function (id, i) {\\n      assert(pools[i].indexOf(id) >= 0, 'event ' + id);\\n    });\\n    assert(sent.length > 0, 'no ghosts');\\n    assert(progress.length > 0, 'no progress');\\n460→    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1 && result && typeof result.score === 'number', 'result ' + resultN);\\n    (handlers['time-up'] || []).forEach(function (fn) { fn(); });\\n    assert(resultN === 1, 'result twice');\\n    game.input.press('KeyA');\\n    (handlers['end'] || []).forEach(function (fn) { fn(); });\\n    assert(G.hubOver, 'not over');\\n    assert(game.input.held.size === 0, 'input still held');\\n    const n = sent.length;\\n    game.advance(1);\\n470→    assert(sent.length === n, 'sent after end');\\n  } finally {\\n    ctx.AIHub = realAIHub;\\n  }\\n});\\n\\nadd('rules', 'data lint', () => {\\n  assert(G.LINES.count() >= 150, 'lines ' + G.LINES.count());\\n  const clips = ctx.MOCAP.FITCLIPS.clips;\\n  for (const k in G.POSES) {\\n480→    const name = G.POSES[k].clip;\\n    assert(clips[name], 'pose ' + k + ' missing clip ' + name);\\n  }\\n  const bad = [];\\n  const re = /\\\\bTODO\\\\b|placeholder|\\\\bstub\\\\b/i;\\n  for (const f of fs.readdirSync(path.join(dev, 'game'), { recursive: true })) {\\n    if (!String(f).endsWith('.js')) continue;\\n    const text = fs.readFileSync(path.join(dev, 'game', f), 'utf8');\\n    if (re.test(text)) bad.push(String(f));\\n  }\\n490→  assert(!bad.length, 'lint ' + bad.join(','));\\n});\\n\\nadd('rules', 'draw scenes', () => {\\n  const names = Object.keys(G.scenes);\\n  const bad = [];\\n  for (const name of names) {\\n    const game = boot({ draw: true });\\n    try {\\n      if (name === 'play') game.go('play', { id: 'stork', tier: 1, trial: true, skipToPlay: true, driver: 'good' }, { fade: 0 });\\n500→      else if (name === 'attract') G.startAttract();\\n      else game.go(name, {}, { fade: 0 });\\n      game.advance(0.15);\\n      if (game.errors.length) bad.push(name + ': ' + game.errors.join(';'));\\n    } catch (e) {\\n      bad.push(name + ': ' + e.message);\\n    }\\n  }\\n  assert(!bad.length, bad.join('\\\\n'));\\n});\\n510→\\nfuncti