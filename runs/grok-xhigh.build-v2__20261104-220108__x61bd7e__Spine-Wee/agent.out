ily === 'laundry') { fam.x = 0; fam.falls = 0; fam.post = 0; fam.len = 55; fam.done = false; fam.gustT = 2.2; fam.gust = 0; fam.air = 0; }\"},{\"line_number\":224,\"content\":\"    else if (act.family === 'rep') stepRep(sess, dt);\"},{\"line_number\":229,\"content\":\"    else if (act.family === 'tray') stepTray(sess, dt);\"},{\"line_number\":230,\"content\":\"    else if (act.family === 'laundry') stepLaundry(sess, dt);\"},{\"line_number\":300,\"content\":\"  function stepRep(sess, dt) {\"},{\"line_number\":412,\"content\":\"    fam.x += (seat.ux || 0) * 1.6 * dt;\"},{\"line_number\":418,\"content\":\"        if (Math.abs(fam.x - cx) < 0.45) { fam.cups++; fam.gotCup = fam.gotCup || {}; fam.gotCup[i] = true; }\"},{\"line_number\":437,\"content\":\"    fam.x += (seat.ux || 0) * 78 * turn / 1.6 * dt;\"},{\"line_number\":443,\"content\":\"        fam.missed[i] = Math.abs(fam.x - g.x) > fam.half;\"},{\"line_number\":450,\"content\":\"      if (Math.abs(fam.z - o.z) < 80 && Math.abs(fam.x - o.x) < 16) {\"},{\"line_number\":466,\"content\":\"  function stepTray(sess, dt) {\"},{\"line_number\":497,\"content\":\"  function stepLaundry(sess, dt) {\"},{\"line_number\":502,\"content\":\"    fam.air -= dt;\"},{\"line_number\":503,\"content\":\"    if (seat.jump && fam.air <= 0) fam.air = 0.55;\"},{\"line_number\":504,\"content\":\"    bal.holdP = fam.air > 0;\"},{\"line_number\":509,\"content\":\"    if (fam.gust > 0 && fam.air <= 0) {\"},{\"line_number\":515,\"content\":\"    if (bal.falls > fallsBefore) { fam.falls++; fam.x = fam.post; }\"},{\"line_number\":519,\"content\":\"      const d = pins[i] - fam.x;\"},{\"line_number\":523,\"content\":\"    if (ahead && ahead.dist < 0.25 && fam.air <= 0 && !fam.pinHit) {\"},{\"line_number\":524,\"content\":\"      fam.falls++; fam.x = fam.post; fam.pinHit = pins.indexOf(ahead.x);\"},{\"line_number\":528,\"content\":\"    for (let i = 0; i < posts.length; i++) if (fam.x >= posts[i]) fam.post = posts[i];\"},{\"line_number\":530,\"conten