e / best, 0, 1);\"},{\"line_number\":441,\"content\":\"    sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\"},{\"line_number\":478,\"content\":\"      sess.pct = clamp((worst - time) / (worst - par), 0, 1);\"},{\"line_number\":511,\"content\":\"    sess.pct = sess.ended || fam.t > 1 ? clamp(base * (0.8 + 0.2 * (sess.ended ? share : share)), 0, 1) : base;\"},{\"line_number\":512,\"content\":\"    if (sess.ended) sess.pct = clamp(base * (0.8 + 0.2 * share), 0, 1);\"},{\"line_number\":559,\"content\":\"      let pct = time <= par ? 1 : clamp((worst - time) / (worst - par), 0, 1);\"},{\"line_number\":560,\"content\":\"      pct = clamp(pct - 0.06 * fam.falls, 0, 1);\"},{\"line_number\":561,\"content\":\"      sess.pct = pct;\"},{\"line_number\":569,\"content\":\"    if (act.family === 'hold' && sess.seats[0].bal) sess.pct = clamp(sess.seats[0].bal.steadiness - 0.05 * sess.seats[0].bal.falls, 0, 1);\"},{\"line_number\":570,\"content\":\"    if (act.family === 'slalom' && !fam.done) sess.pct = 0;\"},{\"line_number\":571,\"content\":\"    if (act.family === 'laundry' && !fam.done) sess.pct = 0;\"},{\"line_number\":574,\"content\":\"      sess.pct = clamp(0.7 * share + 0.3 * (fam.cups / fam.cupN), 0, 1);\"},{\"line_number\":594,\"content\":\"    this.pct = 0;\"},{\"line_number\":595,\"content\":\"    this.stars = 0;\"},{\"line_number\":649,\"content\":\"    if (this.act.family === 'slalom' && this.fam && !this.fam.done) this.pct = 0;\"},{\"line_number\":650,\"content\":\"    if (this.act.family === 'laundry' && this.fam && !this.fam.done) this.pct = 0;\"},{\"line_number\":651,\"content\":\"    this.pct = clamp(this.pct || 0, 0, 1);\"},{\"line_number\":652,\"content\":\"    this.stars = G.starsOf(this.pct, this.act.stars);\"},{\"line_number\":655,\"content\":\"    this.seats.forEach(function (q) { q.pct = this.pct; q.score = clamp(Math.round(this.pct * 1000), 0, 1000); }, this);\"},{\"line_number\":659,\"content\":\"        let p = this.pct;\"},{\"line_number\":660,\"content\":\"        if (!q.local && q.botFill) p = this.pct;\"},{\"line_number\":661,\"content\":\"        if (q.human && !q.local) p = q.moved ? this.pct : 0;\"},{\"line_number\":662,\"content\":\"        q.pct = p; q.score = q.scoring === false ? 0 : clamp(Math.round(p * 1000), 0, 1000);\"},{\"line_number\":665,\"content\":\"    if (!this.trial && !G.attracting && !G.inSession) G.award(this.act.id, this.tier, this.stars, this.pct);\"},{\"line_number\":667,\"content\":\"      const n = this.stars;\"},{\"line_number\":712,\"content\":\"        const gates = sess.act.stars;\"},{\"line_number\":726,\"content\":\"        G.drawStars(g, W / 2 - 18, 48, sess.stars);\"},{\"line_number\":728,\"content\":\"        const remark = (G.LINES.stars[sess.stars] || G.LINES.stars[0])[0];\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"1fabf52b-fde7-49ad-a959-3d2d70a54152"}
