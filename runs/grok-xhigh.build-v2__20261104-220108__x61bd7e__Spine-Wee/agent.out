\"content\":\"  /** add one particle { x, y, z, vx, vy, vz, life, max (seconds), g (gravity, > 0 pulls down), drag, bounce (0..1),\"},{\"line_number\":4955,\"content\":\"  constructor(specs, o = {}) { this.moves = specs.map(sp => sp instanceof Attack ? sp : new Attack(sp)); this.window = o.window === undefined ? .3 : o.window; this.step = -1; this.idle = 99; }   // items: specs, Attacks or move names\"},{\"line_number\":4957,\"content\":\"  get current() { return this.moves[Math.max(0, this.step)]; }\"},{\"line_number\":4959,\"content\":\"  get busy() { return this.step >= 0 && this.current.busy; }\"},{\"line_number\":4966,\"content\":\"    const cur = this.step >= 0 ? this.current : null;\"},{\"line_number\":4968,\"content\":\"    const next = (cur && (cur.busy || this.idle <= this.window) && this.step + 1 < this.moves.length) ? this.step + 1 : 0;\"},{\"line_number\":4970,\"content\":\"    this.step = next; this.idle = 0; return this.moves[next].start();\"},{\"line_number\":4973,\"content\":\"  update(dt) { if (this.step < 0) return null; const r = this.current.update(dt); if (!this.current.busy) this.idle += dt; return r; }\"},{\"line_number\":4975,\"content\":\"  hits(targets, test, fn) { return this.step >= 0 ? this.current.hits(targets, test, fn) : 0; }\"},{\"line_number\":4977,\"content\":\"  cancel() { if (this.step >= 0) this.current.cancel(); this.step = -1; this.idle = 99; }\"},{\"line_number\":6123,\"content\":\"    this.step = o.step === undefined ? HEIGHTS.step : o.step; this.climb = o.climb || 0; this.drop = o.drop || 0;\"},{\"line_number\":6130,\"content\":\"    for (let m = 1; m < k; m++) if (!(this._hts[i + (dy * W + dx) * m] < Math.min(a, b) - this.step)) return false;\"},{\"line_number\":6140,\"content\":\"  _cost(i, j, k) { return k > 1 ? k : this.jump ? 1 + Math.max(0, Math.ceil((this._tops[j] - this._tops[i] - this.step) / this.map.T)) : 1; }\"},{\"line_number\":6142,\"content\":\"  _link(i, j) { const dz = this._tops[j] - this._tops[i]; return dz >= 0 ? dz <= Math.max(this.step, this.climb) : -dz <= Math.max(this.step, this.drop); }   // (NaN: false)\"},{\"line_number\":6157,\"content\":\"        if (Math.abs(lx) <= sol.hx && Math.abs(ly) <= sol.hy && sol.z <= top[i] + this.step) { top[i] = Math.max(top[i], sol.top); if (this.jump) this._hts[i] = Math.max(this._hts[i], sol.top); }\"},{\"line_number\":6207,\"content\":\"    return { x: (bj % W + .5) * T, y: (((bj / W) | 0) + .5) * T, z: this._tops[bj], kind: bk > 1 ? 'jump' : dz > this.step ? 'climb' : dz < -this.step ? 'drop' : 'walk', edge };\"},{\"line_number\":6469,\"content\":\"  /** standing still exactly on a surface: detect it without needing gravity */\"},{\"line_number\":6720,\"content\":\" * Units: world units per second. One tile = 16. A 285 jump with gravity 800 clears about 3 tiles.\"},{\"line_number\":6726,\"content\":\"     *  on the ground and in the air; jump: the jump's starting speed; gravity: while rising; fallGravity: while\"},{\"line_number\":6737,\"content\":\"      run: 95, accel: 900, decel: 1100, airAccel: 650, jump: 285, gravity: 800, fallGravity: 1150, maxFall: 330,\"},{\"line_number\":6801,\"content\":\"      if (!(this.dashing > 0 && !this.onGround)) this.vz = Math.max(-this.maxFall, this.vz - (this.vz > 0 ? this.gravity : this.fallGravity) * dt);\"},{\"line_number\":6829,\"content\":\" *    down while still and jump charges a dash, let go of down to go). Tiles: 'water' (it swims: less gravity, drag, a\"},{\"line_number\":6869,\"content\":\"      S.w += (-this.gravity / S.L * Math.sin(S.a) + c.ix * (this.pump || 4) * Math.cos(S.a) * 32 / S.L) * dt; S.w *= 1 - .2 * dt; S.a = clamp(S.a + S.w * dt, -2.4, 2.4);\"},{\"line_number\":6969,\"content\":\"        let vx = this.vx - s / Math.sqrt(1 + s * s) * this.gravity * (this.rolling ? .9 : .5) * dt;\"},{\"line_number\":7062,\"content\":\"   *  above that and walks into one in that span); gravity: pulls z down (world units per second squared); friction: slows vx and vy per\"},{\"line_number\":7066,\"content\":\"  constructor(o = {}) { Object.assign(this, { x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, r: 5, h: 32, gravity: 700, friction: 0, bounce: 0, step: 2, onGround: true, groundZ: 0, hitWall: false, landed: false }, o); }\"},{\"line_number\":7071,\"content\":\"  /** move it one step: speed, friction, walls (map.collide: lower walls are walked onto), gravity and the ground\"},{\"line_number\":7086,\"content\":\"    const ground = map && map.groundAt ? map.groundAt(this.x, this.y, this.r, this.z, this.step) : 0;\"},{\"line_number\":7090,\"content\":\"      this.vz -= this.gravity * dt; this.z += this.vz * dt;\"},{\"line_number\":7393,\"content\":\"    const before = this.onGround, g0 = this.gravity;\"},{\"line_number\":7394,\"content\":\"    if (this.gliding) {   // no gravity: it sinks at glideSink, or rises at an updraft's lift\"},{\"line_number\":7395,\"content\":\"      const L = typeof this.lift === 'function' ? this.lift(this) : this.lift; this.gravity = 0;\"},{\"line_number\":7398,\"content\":\"    super.update(dt, map); this.gravity = g0;\"},{\"line_number\":7428,\"content\":\"          const g = this.gravity, dz = land.z - this.z, vz = Math.max(this.jumpSpeed, Math.sqrt(Math.max(0, 2 * g * dz)) + 30), t = (vz + Math.sqrt(Math.max(0, vz * vz - 2 * g * dz))) / g, d = Math.hypot(land.x - this.x, land.y - this.y);\"},{\"line_number\":10980,\"content\":\"    const swap = () => { this.room = id; const p = at || R.start || [R.w / 2, R.h * .8]; [this.hero.x, this.hero.y] = R.walk ? R.walk.nearest(p[0], p[1]) : p; this.hero.path = null; this._then = null; this._scroll = null; if (this.on.enter) this.on.enter(this, id); if (R.enter) R.enter(this); };\"},{\"line_number\":11505,\"content\":\"    this.body = new E.Platformer({ x: o.x || 0, w: 8 * sz, h: 30 * sz, run: this.o.walk, accel: 2400, decel: 3200, airAccel: 0, gravity: 1000, fallGravity: 1000, maxFall: 700, coyote: 0, buffer: 0, cut: 1 });\"},{\"line_number\":12768,\"content\":\"- const world = new E.Physics({ gravity: [0, 400] (left out: [0, 0]), substeps: 4, iterations: 8, sleep: true, on: { hit(a, b, info),\"},{\"line_number\":12769,\"content\":\"  enter(sensor, body), exit(sensor, body), catch(kicker, body) } }). world.step(dt) in each fixed step (it splits dt in\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa15-0d43-7de2-87b2-754e4acb611c","uuid":"41440777-c4bd-4646-940f-75797bbf33e8"}
