 (let tab = 0; tab < 6; tab++) { D.tab = tab; const items = D.items(); tabs++;\n    for (const it of items) if (it.path) { const before = TC.tget(it.path); D.adjust(it, 1); const after = TC.tget(it.path); t.check('dev ' + it.label + ' changes ' + it.path, before !== after || (it.kind === 'slider' && before === it.max), before + ' -> ' + after); }\n  }\n  D.tab = 0; const reset = D.items().find(i => i.kind === 'reset'); D.i = D.items().indexOf(reset); game.input.tap('confirm'); step(1 / 60); game.input.tap('confirm'); step(1 / 60);\n  t.check('RESET ALL restores TUNE exactly', JSON.stringify(TC.tune()) === JSON.stringify(TC.TUNE));\n  D.tab = 5; const acts = D.items(), sim = TC.play.s.sim;\n  const run = label => { const it = acts.find(a => a.label.startsWith(label)); it.run(); step(.05); };\n  run('Kill all'); t.check('Kill all', sim.enemies.every(e => e.dead));\n  run('All weapons'); t.check('All weapons and full ammo', sim.players[0].ammo.gl === 6);\n  const l = sim.players[0].lives; run('+1 life'); t.check('+1 life', sim.players[0].lives === l + 1);\n  run('Next scene'); t.check('Next scene', sim.sceneId === '1-2', sim.sceneId);\n  run('Trigger a threat'); t.check('Trigger a threat on me', sim.threats.some(x => !x.done));\n  run('Add a P2 bot'); t.check('Add a P2 bot', sim.players.length === 2); run('Add a P2 bot'); t.check('and remove it', sim.players.length === 1);\n  run('Bot plays'); t.check('Bot plays', !!TC.play.s.bots[0]);\n  D.jumpI = D.jumps().findIndex(j => j.label.includes('2-B')); D.tab = 5; D.items().find(a => a.list === 'jump').run(); step(.1); t.check('Jump to any scene', sim.sceneId === '2-B', sim.sceneId);\n  D.close(); t.check('no errors', !game.errors.length, game.errors.map(e => e.message).join('|'));\n};\nEOF\ncat > tests/attract.test.mjs <<'EOF'\nexport default async t => {\n  const { TC, step, game } = t.load(); step(1.2); const scene = () => game.debug.snapshot().scene;\n  step(9); t.check('9 s idle: still the title', scene() === 'title', scene());\n  step(1.6); t.check('10 s idle: the attract demo', scene() === 'attract', scene());\n  const s0 = TC.Attract.session; t.check('the demo plays with cheats and the bot', s0 && s0.sim.cheats.god && !!s0.bots[0]);\n  step(6); t.check('the demo progresses', s0.sim.phase === 'action' || s0.sim.phase === 'clear' || s0.sim.phase === 'travel');\n  game.input.tap('confirm'); step(.8); t.check('any input goes back to the title', scene() === 'title', scene());\n  t.check('the input is consumed (not also a menu pick)', scene() !== 'menu');\n  // the cycle over the playlist: demo -> scores -> demo -> title ...\n  step(11); const i0 = TC.Attract.i; step(70); t.check('the playlist moves on', TC.Attract.i > i0, TC.Attract.i);\n  t.check('every highlight resolves', Object.values(TC.REG.highlight).every(h => TC.REG.stage[h.stage].scenes.includes(h.scene)));\n  t.check('no errors', !game.errors.length, game.errors.map(e => e.message).join('|'));\n};\nEOF\ncat > tests/coop.test.mjs <<'EOF'\nimport { run } from './lib.mjs';\nexport default async t => {\n  const { TC, step, game } = t.load(); step(1.2);\n  game.go('play', { mode: 'arcade', stages: [1, 2, 3], difficulty: 'normal', noBrief: true, skipCuts: true, seed: 2 }); step(.8);\n  const s = TC.play.s, p2in = game.addPlayer ? game.addPlayer({ pad: 1 }) : null; s.addPlayer(p2in, 'rook');\n  const sim = s.sim; t.check('P2 joins', sim.players.length === 2); t.check('two viewports', s.viewports({ W: 427, H: 240 }).length === 2);\n  for (let k = 0; k < 120 * 20 && sim.phase !== 'action'; k++) sim.step(1 / 120, []);\n  const c1 = sim.cameraFor(0), c2 = sim.cameraFor(1); t.check('independent cameras', Math.hypot(c1.x - c2.x, c1.y - c2.y) > 20);\n  sim.step(1 / 120, [{ cover: true }, {}]); run(sim, .3, () => [{ cover: true }, {}]); t.check('independent cover', sim.players[0].c === 1 && sim.players[1].c === 0);\n  const l2 = sim.players[1].lives; TC.requestThreat(sim, { src: 'x', target: 1, dur: .2, kind: 'shot', at: [200, 0, 24], always: true }); run(sim, .3, () => [{ cover: true }, {}]);\n  t.check('separate hits', sim.players[1].lives === l2 - 1 && sim.players[0].lives === TC.DIFF.normal.lives);\n  sim.players[1].lives = 1; sim.players[1].iframes = 0; sim.hurt(sim.players[1], {}); t.check('P2 out: CONTINUE? while P1 plays', sim.players[1].out && sim.phase === 'action');\n  const q = TC.makeEnemy(sim, 'quartermaster', null, { route: [[200, -40, 0], [200, 40, 0]] }); TC.killEnemy(sim, q, { p: sim.players[0] });\n  t.check('the pickup goes to the killer', sim.players[0].ammo.mg > 0 && sim.players[1].ammo.mg === 0);\n  t.check('no errors', !game.errors.length, game.errors.map(e => e.message).join('|'));\n};\nEOF\necho ok","description":"Write ui, dev, attract and coop suites"}}}
