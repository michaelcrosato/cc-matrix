3e8', { align: 'center', font: 'tiny' });\"\nb=\"      T(g, it.label, x, yy + (on ? 1 : 3), it.disabled ? '#5a6078' : on ? '#ffffff' : '#b8c8e8', { align: 'center', scale: on ? 2 : 1, outline: '#000' });\"\nassert s.count(a)==1; s=s.replace(a,b)\na=\"    });\\n  }\\n}\\nTC.ListMenu = ListMenu;\"\nb=\"    });\\n    const cur = this.items[this.i]; if (cur && cur.desc && o.desc !== false) { const dy = o.descY || (r.H - 26); E.ui.box(g, r.W / 2 - Math.min(r.W - 40, 300) / 2, dy - 3, Math.min(r.W - 40, 300), 13, { bg: ['#10244a', '#081428'], border: '#2a5aa0', alpha: .85 }); T(g, cur.desc, r.W / 2, dy, '#cfe0ff', { align: 'center' }); }\\n  }\\n}\\nTC.ListMenu = ListMenu;\"\nassert s.count(a)==1; s=s.replace(a,b); open(p,'w').write(s)\np='src/90-main.js'; s=open(p).read()\na=\"this.list.draw(g, r, r.W / 2, 64, { rowH: 20 }); hintLine\"\nb=\"this.list.draw(g, r, r.W / 2, 62, { rowH: 18 }); hintLine\"\nassert s.count(a)==1; s=s.replace(a,b)\na=\"if (Attract.phase === 'demo') { this.s.draw(r); r.overlay(g => { E.px.rect(g, 0, r.H - 22, r.W, 22, '#000000'); T(g, 'DEMO PLAY', 8, r.H - 15, UI.gold, { scale: 1 }); logo(g, { W: 140, H: 0 }, r.H - 20, this.t, 1); if (((this.t * 1.6) | 0) % 2 === 0) T(g, TC.touchOnly(game) ? 'TAP FOR THE TITLE' : 'PRESS START', r.W - 8, r.H - 15, '#ffffff', { align: 'right' }); }); return; }\"\nb=\"if (Attract.phase === 'demo') { this.s.draw(r); r.overlay(g => { E.ui.box(g, r.W / 2 - 64, r.H - 36, 128, 30, { bg: ['#10244a', '#081428'], border: UI.gold, alpha: .85 }); T(g, 'DEMO PLAY', r.W / 2, r.H - 32, UI.gold, { align: 'center' }); if (((this.t * 1.6) | 0) % 2 === 0) T(g, TC.touchOnly(game) ? 'TAP FOR THE TITLE' : 'PRESS START', r.W / 2, r.H - 20, '#ffffff', { align: 'center', scale: 1 }); }); return; }\"\nassert s.count(a)==1; s=s.replace(a,b); open(p,'w').write(s)\nEOF\nnode tools/build.mjs | tail -1","description":"Add font glyphs; fix menu descriptions and attract banner"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"sto