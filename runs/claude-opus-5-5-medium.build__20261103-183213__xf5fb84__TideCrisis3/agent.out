.market.p(0, 0, 24)], speed: 140 },\"),\n(\"g1: [300, -60, 14, ['up'], { z: 48, ledge: true }], g2: [300, 70, 14, ['up'], { z: 48, ledge: true }]\",\"g1: [274, -60, 12, ['up'], { z: 48, ledge: true }], g2: [274, 70, 12, ['up'], { z: 48, ledge: true }]\"),\n(\"g3: [300, 0, 14, ['up'], { z: 48, ledge: true }]\",\"g3: [274, 0, 12, ['up'], { z: 48, ledge: true }]\"),\n(\"arrive: { path: [S1.market.p(0, 0, 24), S1.market.p(250, 0, 24), S1.market.p(420, 0, 24), S1.yard.p(-130, 0, 24), S1.yard.p(0, 0, 24)], speed: 140 },\",\n \"arrive: { path: [S1.market.p(0, 0, 24), S1.market.p(250, 0, 24), S1.market.p(420, 0, 24), S1.yard.p(-130, 0, 24), S1.yard.p(0, 0, 24)], speed: 150 },\"),\n(\"arrive: { path: [S1.yard.p(0, 0, 24), S1.yard.p(300, -100, 24), [CN.x - 160, CN.y - 40, 8], [CN.x - 40, CN.y, 8]], speed: 150 },\",\n \"arrive: { path: [S1.yard.p(0, 0, 24), S1.yard.p(150, 0, 24), S1.yard.p(300, 20, 24), S1.yard.p(360, -30, 20), [CN.x - 160, CN.y - 40, 8], [CN.x - 40, CN.y, 8]], speed: 150 },\"),\n(\"b1: [520, -30, 14, ['up'], { z: 34 }], b2: [520, 40, 14, ['up'], { z: 34 }], b3: [1120, -40, 14, ['up'], { z: 34 }], b4: [1120, 30, 14, ['up'], { z: 34 }], m1: [780, 60, 14, ['up'], { z: 10 }]\",\n \"b1: [512, -30, 14, ['up'], { z: 58 }], b2: [512, 40, 14, ['up'], { z: 58 }], b3: [1112, -40, 14, ['up'], { z: 58 }], b4: [1112, 30, 14, ['up'], { z: 58 }], m1: [780, 60, 14, ['up'], { z: 17 }]\"),\n(\"['deckhand', 'c5', { entry: 'door', from: S1.pier.p(478, 20, 0) }]\",\"['deckhand', 'c5', { entry: 'door', from: S1.pier.p(478, -140, 0) }]\"),\n(\"['deckhand', 'c4', { entry: 'jump', from: S1.pier.p(250, 96, 30) }]\",\"['deckhand', 'c4', { entry: 'jump', from: S1.pier.p(250, 96, 22) }]\"),\n(\"  arrive: null,\\n  carrier: { path: [S1.mouth.p(-20, 0, 0)\",\"  arrive: { path: [CN.p(2400, 0, 32), CN.p(2600, 0, 32), S1.mouth.p(-140, 0, 32), S1.mouth.p(0, -10, 32)], speed: 120, vehicle: true },\\n  carrier: { path: [S1.mouth.p(-20, 0, 0)\"),\n]\nfor a,b in R:\n    assert s.count(a)==1, a[:70]