, pitch: -.05, fov: 55 };\n    const t0 = performance.now();\n    R.begin(cam, r.W, r.H, env, t);\n    for (const b of batches) R.drawBatch(b);\n    R.sky({ stops: ['#0b1026', '#1b2a52', '#3a3060'], stars: true, moon: { az: .3, el: .5, color: '#fff3d0' }, clouds: { color: '#2a3060', cover: .35, k: .6 }, sil: [{ color: '#141a34', lit: '#ffd070', h: az => .03 + .05 * Math.abs(Math.sin(az * 9)) * (Math.cos(az) > 0 ? 1 : 0) }] });\n    R.billboard({ x: 130, y: -10, z: 0, chest: 16, h: 32, draw: (g2, ox, oy, view) => rig.draw(g2, ox, oy, view), light: [.9, .9, 1.1] });\n    R.splat([180, -60, 30], 3, [255, 200, 120], 'add');\n    R.line([10, 0, 20], [300, -40, 30], [255, 230, 150]);\n    R.present(g, 0, 0);\n    E.font.text(g, (performance.now() - t0).toFixed(1) + 'ms tris ' + R.stats.tris, 4, 4, '#fff');\n  }); } });\nwindow.__R = R;\n})();\n</script></body></html>\nEOF\nnode tools/build.mjs --js && cat > ~/.cache/xf5fb84/scratch/shot.mjs <<'EOF'\nimport { chromium } from 'playwright';\nconst [url, out, w = 1280, h = 720, wait = 1500] = process.argv.slice(2);\nconst b = await chromium.launch(); const p = await b.newPage({ viewport: { width: +w, height: +h } });\nconst errs = []; p.on('pageerror', e => errs.push(e.message)); p.on('console', m => { if (m.type() === 'error') errs.push(m.text()); });\nawait p.goto(url); await p.waitForTimeout(+wait); await p.screenshot({ path: out });\nif (errs.length) console.log('ERRORS', errs.slice(0, 5).join('\\n')); await b.close();\nEOF\ncp ~/.cache/xf5fb84/scratch/shot.mjs tools/shot.mjs; TMPDIR=$PWD/.tmp node tools/shot.mjs file://$PWD/tools/spike.html $PWD/.tmp/spike.png 1280 720 2000","description":"Build game.js and screenshot the renderer spike"}}}
