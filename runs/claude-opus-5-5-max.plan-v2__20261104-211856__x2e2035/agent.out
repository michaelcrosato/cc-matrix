"'\"'errs'\"'\"',errs[:5]); print('\"'\"'warn'\"'\"',sorted(set(warn))[:5])     print('\"'\"'\\n'\"'\"'.join(r['\"'\"'log'\"'\"'][-12:]) if r else '\"'\"''\"'\"')     pg.screenshot(path='\"'\"'tests/harness.png'\"'\"')     b.close() finally:   srv.terminate(); srv.wait() EOF timeout 400 python3 tests/run_harness.py probe.html \"players=4&latency=150&jitter=50&loss=5&auto=1&play=8000\" \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-angle=swiftshader\" 2>&1 | cut -c1-260 | tail -45' && pwd -P >| /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/tmp/claude-7762-cwd\n3659612 3659606     216 timeout 400 python3 tests/run_harness.py probe.html players=4&latency=150&jitter=50&loss=5&auto=1&play=8000 --enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-angle=swiftshader\n3659615 3659612     216 python3 tests/run_harness.py probe.html players=4&latency=150&jitter=50&loss=5&auto=1&play=8000 --enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-angle=swiftshader","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QZDSVsMv2D4tUuVXffgFdp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
