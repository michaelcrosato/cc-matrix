td::f32::consts::{PI, TAU};\n    let k = def.scale;\n    let leg = def.leg_length * k;\n    let arm = def.arm_length * k;\n    let hr = def.head_radius * k;\n    let walk = (st.speed / 5.0).min(1.0) * (1.0 - st.air) * (1.0 - st.climb);\n    let cyc = st.phase * TAU;\n    let bob = (cyc * 2.0).cos().abs() * def.bob * k * walk;\n    let mv = crate::moves::frame(table, st.act_kind, st.act, st.act_hit, st.act_side);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QUwWwPd43QJe7E9Br2tmZU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
