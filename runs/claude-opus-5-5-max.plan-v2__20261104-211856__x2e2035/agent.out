n----\n154:pub struct PuppetDef {\n155-    pub scale: f32,\n156-    pub head_radius: f32,\n157-    pub torso_length: f32,\n158-    pub torso_radius: f32,\n159-    pub hip_width: f32,\n160-    pub shoulder_width: f32,\n161-    pub leg_length: f32,\n162-    pub arm_length: f32,\n163-    pub limb_radius: f32,\n164-    pub skin: String,\n165-    pub shirt: String,\n166-    pub pants: String,\n167-    pub shoes: String,\n168-    pub eyes: String,\n169-    pub look: Look,\n170-    /// Metres travelled per full walk cycle (two steps).\n171-    pub stride: f32,\n172-    pub step_height: f32,\n173-    pub arm_swing: f32,\n174-    pub bob: f32,\n175-    pub lean: f32,\n176-    pub squash: f32,\n177-    /// Stepped animation: 0 = smooth, 12 = \"on twos\" at 24 fps, etc.\n178-    pub anim_fps: f32,\n179-    /// Tilt the eyes toward the camera so they stay visible from above (0..1).\n180-    pub eyes_to_camera: f32,\n181-    /// Lean the whole body toward the camera (0..1): a 2D \"cheat\" for high camera angles.\n182-    pub face_camera: f32,\n183-    /// Skeleton: biped, or a creature with planted feet (spider, lizard, beetle) or a blob.\n184-    pub body: BodyPlan,\n185-    /// Leg pairs of creatures (0 = the body plan's usual number).\n186-    pub legs: i32,\n187-    /// Creature body length (m).\n188-    pub body_length: f32,\n189-    /// Tail length (m, 0 = none); swings with secondary motion.\n190-    pub tail_length: f32,\n191-    /// Antenna length (m, 0 = none).\n192-    pub antenna_length: f32,\n193-    /// Seconds a creature foot takes for one step.\n194-    pub step_time: f32,\n195-    /// Floppiness of tails, antennae and abdomens (0 = stiff, 2 = very floppy).\n196-    pub wobble: f32,\n197-    /// Second colour (shells, stripes, tail tips).\n198-    pub accent: String,\n199-    /// Held weapon and off hand.\n200-    pub weapon: WeaponLook,\n201-    /// Worn armour.\n202-    pub gear: GearLook,\n203-    /// Horns, spikes, wings... (any body plan).\n204-    pub parts: Vec<crate::parts::Attach>,\n205-    /// A motion clip (`SET/Clip`, see the `clips` tool) the character plays while it stands\n206-    /// still with nothing to do, in place of the procedural idle (bipeds). Empty = none.\n207-    pub idle_clip: String,\n208-    /// A walk loop (`STYLE100/Old_Walk`...) the character walks with in place of the\n209-    /// procedural walk while it heads forward on the ground, played as fast as it moves\n210-    /// (bipeds). Empty = none.\n211-    pub walk_clip: String,\n212-    /// A run loop for speeds the walk loop would have to hurry through (a monster giving\n213-    /// chase): it plays instead of the walk above the pace between the two (bipeds). Empty =\n214-    /// none.\n215-    pub run_clip: String,\n216-    /// A captured fall the character dies with, in place of the procedural topple (bipeds;\n217-    /// the hero has falls of its own). Empty = none.\n218-    pub death_clip: String,\n219-    /// Captured attacks by skill (`claw = \"QUATERNIUS/Zombie_Scratch\"`), played in place of the\n220-    /// skill's move and timed so the clip's strike lands on the hit: the moment a hand reaches\n221-    /// furthest ahead of the hips (a foot, for a clip tagged `kick`), or `@seconds` written\n222-    /// after the name (bipeds). A list plays one per swing of a combo (`slash = [\"A\", \"B\",\n223-    /// \"C\"]`: jab, cross, kick).\n224-    pub attack_clips: std::collections::BTreeMap<String, PerSwing>,","is_error":false}]},"parent_tool_use_id":null,"session_id":"19933fd7-aa65-437e-a4da-e4509b9efb8a","uuid":"980f33e8-a62d-49ad-866a-492905015b79","timestamp":"2026-11-05T04:24:56.270Z","tool_use_result":{"stdout":"49:pub struct AnimParams {\n80:pub struct Key {\n127:pub struct Clip {\n156:pub struct ClipSet {\n182:    pub fn parse(text: &str) -> Result<Self, String> {\n226:    pub fn text(&self) -> String {\n257:    pub fn text(&self) -> String {\n287:    pub fn to_text(&self) -> String {\n323:    pub fn key_at(&self, t: f32) -> Key {\n