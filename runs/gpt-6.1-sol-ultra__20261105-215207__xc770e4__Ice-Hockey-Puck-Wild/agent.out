h('touch-shoot')}}else enqueue(0,'check');touchAim=null;show('touchHint',false)}touches.delete(e.pointerId)}else if(e.button===0)pointer.shoot=false;}\n\"'$('\"'arena').addEventListener('pointerup',touchEnd);\"'$('\"'arena').addEventListener('pointercancel',touchEnd);\nfunction playerAim(team){const p=game.players[game.control[team]];if(pointer.active&&lastInput==='mouse'){const pos=view.aimAt(pointer.x,pointer.y);return{x:pos.x-p.x,z:pos.z-p.z}}if(touchAim){const dx=touchAim.x-touchAim.sx,dz=touchAim.y-touchAim.sy;if(Math.hypot(dx,dz)>16)return{x:dx,z:dz}}return{x:(team===0?24:-24)-p.x,z:-p.z}}\nfunction assistAim(aim,team){if(\"'!settings.assist||!aim)return aim;const p=game.players[game.control[team]],dir=team===0?1:-1,d=Math.hypot(aim.x,aim.z)||1;const goal={x:dir*24-p.x,z:-p.z},g=Math.hypot(goal.x,goal.z)||1;const dot=(aim.x*goal.x+aim.z*goal.z)/(d*g);if(dot>.96)return{x:aim.x*.65+goal.x/g*d*.35,z:aim.z*.65+goal.z/g*d*.35};return aim}\nfunction readInput(team,localIndex=team){let x=0,z=0,boost=false,shoot=false,aim=null;if(localIndex===0){x=+keys.has('\"'KeyD')-+keys.has('KeyA');z=+keys.has('KeyS')-+keys.has('KeyW');boost=keys.has('ShiftLeft')||keys.has('ShiftRight');shoot=keys.has('Space')||pointer.shoot;aim=playerAim(team);if(touchMove){x=(touchMove.x-touchMove.sx)/45;z=(touchMove.y-touchMove.sy)/45;boost=Math.hypot(x,z)>.9;shoot=\"'!!touchAim}if(lastInput==='\"'touch'&&\"'!touchAim)aim=playerAim(team)}else{x=+keys.has('\"'ArrowRight')-+keys.has('ArrowLeft');z=+keys.has('ArrowDown')-+keys.has('ArrowUp');boost=keys.has('KeyO');shoot=keys.has('KeyJ');}\n const pads=[...navigator.getGamepads?.()||[]].filter(Boolean),pad=pads[localIndex];if(pad){const ax=pad.axes||[];if(Math.hypot(ax[0]||0,ax[1]||0)>.16){x=ax[0];z=ax[1]}if(Math.hypot(ax[2]||0,ax[3]||0)>.24)aim={x:ax[2],z:ax[3]};boost=boost||pad.buttons[5]?.pressed;shoot=shoot||pad.buttons[2]?.pressed||pad.buttons[7]?.pressed;}\n if(\"'!aim){const p=game.players[game.control[team]];aim={x:Math.cos(p.angle),z:Math.sin(p.angle)}}return{x,z,boost,shoot,aim:assistAim(aim,team)};}\nfunction pollPads(){const pads=[...navigator.getGamepads?.()||[]];pads.forEach((pad,i)=>{if(!pad)return;const prev=padPrev.get(pad.index)||[];const now=pad.buttons.map(b=>!!b.pressed);const changed=now.some((v,j)=>v&&!prev[j])||(pad.axes||[]).some(a=>Math.abs(a)>.24);if(changed){if(interact('\"'gamepad')){padPrev.set(pad.index,now);return}}const edge=j=>now[j]&&\"'!prev[j];if(panelName||screen==='\"'title'){let dx=0,dy=0;if(edge(12))dy=-1;if(edge(13))dy=1;if(edge(14))dx=-1;if(edge(15))dx=1;const n=performance.now();if(n-menuAxisAt>210){if(Math.abs(pad.axes[1]||0)>.55)dy=Math.sign(pad.axes[1]);if(Math.abs(pad.axes[0]||0)>.55)dx=Math.sign(pad.axes[0]);if(dx||dy)menuAxisAt=n;}if(dx||dy)menuNav(dx,dy);if(edge(0))menuNav(0,0,true);if(edge(1)||edge(9)){if(panelName==='pause')resume();else if(panelName)closePanel();}}else{if(edge(9))pause();if(edge(0))enqueue(i,'pass');if(edge(1))enqueue(i,'check');if(edge(4))enqueue(i,'switch')}padPrev.set(pad.index,now);});}\nfunction dispatchActions(team,index,input){for(const a of pending[index].splice(0)){if(a==='touch-shoot')game.action(team,'shoot',input.aim);else game.action(team,a,input.aim)}}\nnetwork.onEvent=(type,data)=>{if(type==='hub-ready'){hubWaiting=true;screen='game';show('titleScreen',false);show('hud');toast('AI Hub connected. Waiting for the face-off.');updateNetStatus()}if(type==='start'){hubStarted=true;hubWaiting=true;game.start('online');game.remote=true;screen='game';panelName='';show('modal',false);show('titleScreen',false);show('hud')}if(type==='peer-connected'){start('online');toast(\"'`Opponent connected. You skate for the ${network.localTeam===0?'\"'Foxes':'Freeze'}.\"'`);updateNetStatus()}if(type==='\"'input'&&network.isHost){remoteInput=data.input||{};remoteSeen=performance.now();if(Array.isArray(remoteInput.actions))remoteInput.actions.forEach(a=>game.action(data.from%2,a,remoteInput.aim));}if(type==='state'&&\"'!network.isHost){game.applySnapshot(data);if(screen!=='\"'game'){screen='game';show('titleScreen',false);show('hud')}if(data.sfx)for(const type of data.sfx)audio.sfx(type);}\n if(type==='time-up'){if(network.isHost){game.finish();network.finish(game.scores,game.stats)}}if(type==='end'){hubEnded=true;hubWaiting=false;paused=true;audio.setMusic(0);audio.setSfx(0);if(game.phase\"'!=='\"'result')game.finish();openPanel('result','game');updateNetStatus()}if(type==='peer-left'){updateNetStatus();if(network.hubActive){if(network.isHost){game.finish();network.finish(game.scores)}}else{paused=true;openPanel('pause','game');toast('Your rival left the rink. Return to title to reconnect.')}}if(type==='error')toast(data.message);};\nfunction hints(){let mode=lastInput==='gamepad'?settings.glyphs:lastInput==='touch'?'touch':'keys';if(oldHint===mode)return;oldHint=mode;const map=mode==='ps'?[['×','PASS'],['□','HOLD / SHOOT'],['○','CHECK'],['R1','BOOST']]:mode==='xbox'?[['A','PASS'],['X','HOLD / SHOOT'],['B','CHECK'],['RB','BOOST']]:[['E','PASS'],['SPACE','HOLD / SHOOT'],['F','CHECK'],['SHIFT','BOOST']];\"'$('\"'controlHints').innerHTML=map.map(([k,t])=>\"'`<span><b class=\"glyph\">${k}</b>${t}</span>`).join('\"'')}\nfunction updateHUD(){for(let t=0;t<2;t++){\"'$('\"'score'+t).textContent=game.scores[t];\"'$('\"'heat'+t).style.width=game.heat[t]*100+'%'}const sec=Math.ceil(game.time);\"'$('\"'clock').textContent=game.mode==='practice'?'SKILLS':\"'`${Math.floor(sec/60)}:${String(sec%60).padStart(2,'\"'0')}\"'`;$('\"'period').textContent=game.period===4?'SUDDEN DEATH':\"'`PERIOD ${game.period} / 3`;const team=network.connected?network.localTeam||0:0,p=game.players[game.control[team]];$('\"'playerName').textContent=\"'`${String(p.id+1).padStart(2,'\"'0')} / \"'${team===0?'\"'FOXES':'FREEZE'}\"'`;$('\"'stamina').style.width=(p.stamina*100)+'%';\"'$('\"'puckStatus').textContent=game.owner===p.id?(p.charge>.1?\"'`SHOT CHARGING ${Math.round(p.charge*100)}%`:game.heat[team]>=.99?'\"'WILD SHOT READY':'YOU HAVE THE PUCK'):'FIND A LITTLE SPACE';hints();const banner=hubWaiting?'WAITING FOR THE FACE-OFF':game.phase==='faceoff'?\"'`FACE-OFF IN ${Math.max(1,Math.ceil(game.phaseTime))}`:game.bannerTime>0?game.banner:'\"'';\"'$('\"'banner').textContent=banner;show('banner',\"'!!banner&&!panelName&&screen==='\"'game');if(game.mode==='practice'){const drills=[['GET YOUR LEGS','Skate around the rink. Use WASD or the left stick.'],['MAKE A FRIEND','Pass to your partner: E / ×. Control follows the puck.'],['LOAD IT UP','Hold Space / □ to charge past halfway, then release.'],['A FRIENDLY NUDGE','Get close to the cyan rival. F / ○ checks.'],['LIGHT THE LAMP','Shoot past the keeper into the right-hand net.']];const d=drills[game.drill?.step||0];if(d)\"'$('\"'drill').innerHTML=\"'`<small>SKILLS CLUB • ${(game.drill?.step||0)+1} / 5</small><strong>${d[0]}</strong><p>${d[1]}</p>`;}}\nlet eventCursor=0;\nfunction loop(now){requestAnimationFrame(loop);if(!game||!view)return;const dt=Math.min(.06,(now-previous)/1000);previous=now;pollPads();if(screen==='\"'title'&&\"'!panelName&&now-idle>10000&&!network.hubActive){attract=true;start('\"'attract')}\n if(network.hubActive&&hubStarted&&hubWaiting&&globalThis.AIHub.time()>=0)hubWaiting=false;\n if(screen==='game'&&\"'!hubEnded){if(!network.connected||network.isHost){if(!paused&&!hubWaiting){const localTeam=network.connected?network.localTeam:0;const ins=[{},{}];if(localTeam!==null){const main=readInput(localTeam,0);ins[localTeam]=main;dispatchActions(localTeam,0,main)}if(network.connected){const other=network.localTeam===null?null:1-network.localTeam;if(other!==null)ins[other]=now-remoteSeen<500?remoteInput:{};else{ins[0]=now-remoteSeen<500?remoteInputs[0]||{}:{};ins[1]=now-remoteSeen<500?remoteInputs[1]||{}:{}}}else if(game.mode==='\"'local'){ins[1]=readInput(1,1);dispatchActions(1,1,ins[1])}game.update(dt*timeScale,ins);}if(network.connected){const s=game.snapshot();s.paused=paused;network.sendState(s)}}else if(\"'!paused){const team=network.localTeam||0,inp=readInput(team,0);inp.actions=pending[0].splice(0).map(a=>a==='\"'touch-shoot'?'shoot':a);network.sendInput(inp);game.effects.forEach(e=>e.age+=dt);}\n  if(game.phase==='result'&&\"'!resultShown&&!attract){resultShown=true;if(network.hubActive){if(network.isHost)network.finish(game.scores,[{shots:game.stats.shots[0],checks:game.stats.checks[0]},{shots:game.stats.shots[1],checks:game.stats.checks[1]}])}else openPanel('\"'result','game');}\n  if(attract&&game.phase==='result'){game.phaseTime=(game.phaseTime||0)-dt;if(game.phaseTime< -2)game.start('attract');}\n  updateHUD();\n }\n // Menus keep the tiny rink alive, with no hidden match running.\n if(screen==='title'){game.players.forEach((p,i)=>{p.x=[-9,-3,8,14,-22,22][i];p.z=[-2,5,1,-6,0,0][i];p.angle=i<2?0:Math.PI;p.controlled=false;p.vx=.7;p.vz=0;});game.puck={x:-7.8,z:-2};}\n view.render(game.snapshot(),dt);audio.update(dt,{phase:paused?'paused':game.phase,mode:game.mode,players:game.players,paused:paused||screen==='title'||hubWaiting||hubEnded});if(game.phase\"'!==lastPhase){lastPhase=game.phase;if(game.phase==='\"'goal'&&\"'!network.isHost)audio.sfx('\"'goal')}\n}\nconst remoteInputs=[{},{}];const baseNetworkEvent=network.onEvent;network.onEvent=(t,d)=>{if(t==='input'&&network.info?.server){remoteInputs[d.from%2]=d.input||{};}baseNetworkEvent(t,d)};\nasync function boot(){try{[game,view]=await Promise.all([HockeyGame.create(audio),createView(\"'$('\"'arena'))]);window.addEventListener('resize',()=>view.resize());await network.init();if(network.hubActive)network.ready();else goTitle();show('loading',false);previous=performance.now();requestAnimationFrame(loop);globalThis.__game={game,view,audio,network,start,action,get screen(){return screen},get panel(){return panelName},get paused(){return paused},get input(){return lastInput},step:(n=1,inputs=[{},{}])=>{for(let i=0;i<n;i++)game.step(1/60)},setIdle:seconds=>{idle=performance.now()-seconds*1000},interview:INTERVIEW,audioAudit:()=>HockeyAudio.audit()};globalThis.__gameReady=true;}catch(e){console.error(e);\"'$('\"'loadNote').innerHTML=\"'`The rink could not open: ${escapeHTML(e.message)}<br><button class=\"panelButton\" onclick=\"location.reload()\">Try the ice again</button>`;}}\nboot();\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/game.js <<'EOF'\nimport { createView } from './visuals.js';\nimport { HockeyAudio } from './audio.js';\nimport { HockeyNetwork } from './network.js';\nimport { HockeyGame, DEFAULTS } from './physics.js';\nimport { INTERVIEW } from './metadata.js';\n\nconst \"'$=id=>document.getElementById(id),show=(id,on=true)=>$(id).classList.toggle('\"'hidden',\"'!on);\nconst audio=new HockeyAudio(),network=new HockeyNetwork();\nlet game,view,screen='\"'title',panelName='',panelOrigin='title',paused=false,lastInput='keyboard',idle=performance.now(),attract=false,previous=performance.now(),modalBack='title',timeScale=1,lastPhase='',toastTimer=0,remoteInput={},remoteSeen=0,hubStarted=false,hubEnded=false,hubWaiting=false,resultShown=false;\nlet settings={music:.1,sfx:.65,glyphs:'ps',assist:true};try{settings={...settings,...JSON.parse(localStorage.getItem('puck-wild-settings')||'{}')}}catch{}\naudio.setMusic(settings.music);audio.setSfx(settings.sfx);\nconst keys=new Set(),pointer={x:0,y:0,active:false,shoot:false},touches=new Map();let touchMove=null,touchAim=null;const pending=[[],[]],padPrev=new Map();let menuAxisAt=0,focusIndex=0,oldHint='';\nconst escapeHTML=v=>String(v).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nfunction saveSettings(){try{localStorage.setItem('puck-wild-settings',JSON.stringify(settings))}catch{}}\nfunction toast(text){\"'$('\"'toast').textContent=text;show('toast');clearTimeout(toastTimer);toastTimer=setTimeout(()=>show('toast',false),3800)}\nfunction interact(type='keyboard'){lastInput=type;document.body.classList.toggle('touchMode',type==='touch');idle=performance.now();audio.unlock();if(attract){attract=false;goTitle();return true}return false}\nfunction focusables(){return [...document.querySelectorAll((panelName?'#panel':'#titleScreen')+' button, '+(panelName?'#panel':'#titleScreen')+' input[type=range], #panel textarea, #panel input[type=text]')].filter(el=>el.offsetParent\"'!==null&&!el.disabled)}\nfunction setFocus(index){const els=focusables();if(!els.length)return;focusIndex=(index+els.length)%els.length;els.forEach(el=>el.classList.remove('\"'focused'));const el=els[focusIndex];if(el.tagName==='BUTTON')el.classList.add('focused');el.focus({preventScroll:true});if(panelName)el.scrollIntoView({block:'nearest'});}\nfunction menuNav(dx,dy,activate=false){const els=focusables();if(\"'!els.length)return;if(dy)setFocus(focusIndex+dy);const el=els[focusIndex];if(dx&&el?.type==='\"'range'){el.value=Math.max(+el.min,Math.min(+el.max,+el.value+dx*(+el.step||1)));el.dispatchEvent(new Event('input',{bubbles:true}))}else if(dx)setFocus(focusIndex+dx);if(activate)els[focusIndex]?.click()}\nfunction goTitle(){if(network.hubActive)return;show('modal',false);panelName='';paused=false;screen='title';show('titleScreen');show('hud',false);show('banner',false);show('attract',false);show('drill',false);game.phase='menu';game.mode='menu';game.faceoff();game.players.forEach(p=>p.controlled=false);idle=performance.now();resultShown=false;clearControls();}\nfunction clearControls(){keys.clear();pointer.shoot=false;touchMove=null;touchAim=null;touches.clear();pending[0]=[];pending[1]=[];for(const id of ['touchStick','touchHint'])show(id,false);}\nfunction start(mode){if(\"'!network.hubActive&&mode!=='\"'online'&&network.mode\"'!=='\"'none')network.disconnect();game.remote=mode==='online';game.start(mode);paused=false;panelName='';screen='game';resultShown=false;lastPhase=game.phase;show('titleScreen',false);show('hud');show('modal',false);show('attract',mode==='attract');show('drill',mode==='practice');clearControls();if(mode==='local')toast('Foxes: WASD + Space / E / F. Freeze: arrows + J / K / L. Two controllers also work.');}\nfunction openPanel(name,back){if(back)modalBack=back;else modalBack=panelName||((screen==='title')?'title':'pause');panelName=name;paused=screen==='game';show('modal');\"'$('\"'panel').classList.toggle('wide',['controls','online','about'].includes(name));renderPanel(name);setFocus(0);}\nfunction closePanel(){const back=modalBack;if(back==='title'){show('modal',false);panelName='';paused=false;idle=performance.now()}else if(back==='game'){resume()}else openPanel(back,back==='pause'?'game':'title');}\nfunction resume(){show('modal',false);panelName='';paused=false;clearControls();}\nfunction pause(){if(attract){interact(lastInput);return}if(network.hubActive&&hubEnded)return;if(screen==='game'){if(panelName)resume();else openPanel('pause','game')}}\nconst btn=(a,t,primary=false)=>\"'`<button ${primary?'\"'class=\\\"primary\\\"':''} data-action=\\\"\"'${a}\">${t}</button>`;\nconst header=(label,title,back=true)=>`${back?'\"'<button class=\\\"back\\\" data-action=\\\"back\\\">← Back</button>':''}<div class=\\\"sectionLabel\\\">\"'${label}</div><h2>${title}</h2>`;\nconst slider=(key,label,val,min,max,step,dev=false)=>`<div class=\"row\"><label for=\"${dev?'\"'dev-':''}\"'${key}\">${label}</label><input id=\"${dev?'\"'dev-':''}\"'${key}\" type=\"range\" data-${dev?'\"'dev':'setting'}=\\\"\"'${key}\" value=\"${val}\" min=\"${min}\" max=\"${max}\" step=\"${step}\"><output>${key==='\"'music'||key==='sfx'?Math.round(val*100)+'%':Number(val).toFixed(step<1?2:0)}</output></div>\"'`;\nfunction renderPanel(name){const p=$('\"'panel');if(name==='pause')p.innerHTML=header('TIME OUT','CATCH YOUR BREATH',false)+\"'`<div class=\"menuStack\">${btn('\"'resume','BACK TO THE ICE',true)}\"'${btn('\"'controls','How to play')}\"'${btn('\"'settings','Settings')}\"'${btn('\"'dev','Developer rink')}\"'${btn('\"'about','About & credits')}\"'${btn('\"'quit','Return to title')}</div>\"'`;\n if(name==='\"'settings')p.innerHTML=header('MAKE YOURSELF AT HOME','RINK SETTINGS')+slider('music','Rink organ',settings.music,0,1,.01)+slider('sfx','Effects & voices',settings.sfx,0,1,.01)+\"'`<div class=\"row\"><label>Controller prompts</label><button class=\"toggle\" data-action=\"glyphs\">${settings.glyphs==='\"'ps'?'PlayStation ○ × □ △':'Xbox A B X Y'}</button></div><div class=\\\"row\\\"><label>Shot aim assist</label><button class=\\\"toggle\\\" data-action=\\\"assist\\\">\"'${settings.assist?'\"'ON':'OFF'}</button></div><button class=\\\"panelButton\\\" data-action=\\\"controls\\\">Controls & rink rules →</button><p class=\\\"note\\\">Music starts at 10%. Settings stay on this browser. The rink uses WebGPU where available, with WebGL compatibility.</p>\"'`;\n if(name==='\"'controls')p.innerHTML=header('LACE UP. KEEP IT SIMPLE.','HOW TO GET PUCK WILD')+\"'`<div class=\"cards\"><div class=\"controlCard\"><strong>SKATE & AIM</strong><p>Left stick / WASD to skate. Right stick or mouse aims. R1 / Shift boosts; ease off to recover your legs.</p></div><div class=\"controlCard\"><strong>PASS & FINISH</strong><p>× / E passes to your partner and switches control. Hold □ / Space or left mouse to charge. Release to shoot. Three passes light your WILD shot.</p></div><div class=\"controlCard\"><strong>CHECK & SWITCH</strong><p>○ / F checks nearby rivals and knocks the puck loose. L1 / Q switches skater. Goalies defend automatically. Find an angle around them.</p></div><div class=\"controlCard\"><strong>THE NIGHT GAME</strong><p>Three 45-second periods. Most goals wins. A tie goes to sudden death. No offside. No icing. Bank passes off the boards. Be a menace.</p></div></div><h3>EVERYONE GETS ICE TIME</h3><p><b>Couch:</b> Player 2 uses arrows, J to charge, K to pass, L to check, U to switch, O to boost. Or use two standard controllers.</p><p><b>Touch:</b> Drag anywhere on the left to skate. Drag on the right to aim; release to shoot or check. Tap the right to pass. Full stick boosts. A shot without aim goes toward the net.</p><p class=\"note\">Options / Esc pauses. Menus: D-pad / arrows to focus, × / Enter to select, ○ / Esc to go back. Mouse hover also moves focus.</p>`;\n if(name==='\"'dev')p.innerHTML=header('LIVE TUNING • PAUSED','DEVELOPER RINK')+\"'`<div class=\"sectionLabel\">${view.backend} • Three.js r180 • Rapier 0.19.3</div>`+slider('\"'speed','Skating speed',game.config.speed,4,18,.5,true)+slider('shot','Shot speed',game.config.shot,15,60,1,true)+slider('ai','AI strength',game.config.ai,0,1.4,.05,true)+slider('friction','Skater drag',game.config.friction,.5,7,.1,true)+slider('period','Seconds / period',game.config.period,10,180,5,true)+slider('check','Check reach',game.config.check,2,9,.2,true)+slider('timeScale','Simulation speed',timeScale,.25,2,.25,true)+\"'`<div class=\"cards\"><button class=\"panelButton\" data-action=\"dev-puck\">Give me the puck</button><button class=\"panelButton\" data-action=\"dev-refill\">Refill both teams</button><button class=\"panelButton\" data-action=\"dev-goal0\">Foxes goal +1</button><button class=\"panelButton\" data-action=\"dev-goal1\">Freeze goal +1</button><button class=\"panelButton\" data-action=\"dev-period\">Next period</button><button class=\"panelButton\" data-action=\"dev-faceoff\">Reset face-off</button><button class=\"panelButton\" data-action=\"dev-end\">Finish match</button><button class=\"panelButton\" data-action=\"dev-reset\">Reset defaults</button></div><p class=\"note\">Changes apply live. Period length applies to the next period. Developer tools affect the host simulation. Resume from the pause menu.</p>`;\n if(name==='\"'online')p.innerHTML=header('BRING A WORTHY RIVAL','FRIENDLY FIRE ON ICE')+\"'`<div class=\"networkStatus\" id=\"connectionStatus\">${escapeHTML(network.status)}</div><div class=\"tabs\"><button data-action=\"online-tab-direct\" class=\"active\">Direct link · two devices</button><button data-action=\"online-tab-room\">Local browser room</button></div><div id=\"onlineBody\"></div><p class=\"note\">AI Hub manages friends and rooms when launched inside a Hub session. A standalone direct link uses WebRTC and invite / answer codes. Restrictive networks may prevent a direct connection.</p>`;\n if(name==='\"'online')renderOnline('direct');\n if(name==='about')p.innerHTML=header('MADE OF ICE & JAVASCRIPT','THE SMALL PRINT')+\"'`<div class=\"tabs\">${['\"'Source Information','Testing Feedback','Engine Feedback','Prompt Feedback'].map((t,i)=>\"'`<button data-action=\"about-${i}\" class=\"${i===0?'\"'active':''}\\\">\"'${t}</button>`).join('\"'')}</div><div id=\\\"aboutBody\\\"></div>\"'`;\n if(name==='\"'about')renderAbout(0);\n if(name==='result'){const practice=game.mode==='practice';p.innerHTML=header(practice?'SKILLS CLUB GRADUATE':'FINAL • NORTH END RINK',practice?'YOU’RE READY FOR THE NIGHT GAME':game.winner===0?'FOXES TAKE THE CUP\"'!'\"':'FREEZE TAKE THE CUP\"'!'\"',false)+\"'`<div class=\"resultScore\">${practice?'\"'★ ★ ★':\"'`${game.scores[0]} : ${game.scores[1]}`}</div><p>${practice?'\"'You can skate, combine, charge, check, and finish. Go make a little trouble.':game.winner===0?'Sharp skates. Shaky manners. A very shiny cup.':'The ice was cold. The Freeze were colder. There’s always the rematch.'}</p>\"'${practice?'\"'':\"'`<table class=\"statsTable\"><tr><td></td><td>FOXES</td><td>FREEZE</td></tr>${[['\"'Shots','shots'],['Passes','passes'],['Checks','checks'],['Saves','saves']].map(([t,k])=>\"'`<tr><td>${t}</td><td>${game.stats[k][0]}</td><td>${game.stats[k][1]}</td></tr>`).join('\"'')}</table>\"'`}<div class=\"menuStack\">${network.hubActive?btn('\"'hub-done','ROUND COMPLETE',true):btn('rematch',practice?'PLAY THE NIGHT GAME':'ONE MORE GAME',true)+btn('quit','Return to title')}</div>\"'`;}\n}\nfunction renderAbout(tab){const body=$('\"'aboutBody');[...\"'$('\"'panel').querySelectorAll('[data-action\"'^=\"about-\"]'\"')].forEach((b,i)=>b.classList.toggle('active',i===tab));if(tab===0){body.innerHTML='<dl>'+Object.entries(INTERVIEW.sourceInformation).map(([k,v])=>\"'`<dt>${escapeHTML(k.replace(/([A-Z])/g,'\"' \"'$1'\"'))}</dt><dd>\"'${escapeHTML(v)}</dd>`).join('\"'')+'</dl><p class=\\\"note\\\">An original arcade hockey tribute. Ice Hockey (1981) belongs to its respective rights holders. All game artwork, music, effects, and voices are procedural.</p>';}else{const keys=['','testingFeedback','engineFeedback','promptFeedback'];const qs=[[],['How many issues did testing catch?','How many were critical or game breaking?','Most helpful test?','Least helpful test?'],['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing built yourself?','Hardest part of the engine?','Engine changes and why?','One engine improvement?'],['What did you like most about this prompt?','What was confusing?','What was hardest?','What would you change?']];body.innerHTML=INTERVIEW[keys[tab]].map((v,i)=>\"'`<div class=\"feedbackItem\"><strong>${qs[tab][i]}</strong><p>${escapeHTML(v)}</p></div>`).join('\"'')}}\nfunction renderOnline(tab){\"'$('\"'onlineBody').innerHTML=tab==='room'?\"'`<p>Open this same game in another tab of the same browser. One player hosts; the other enters the code.</p><div class=\"cards\"><button class=\"panelButton\" data-action=\"host-room\">Host a browser room</button><button class=\"panelButton\" data-action=\"join-room\">Join this room</button></div><input class=\"codeInput\" id=\"roomCode\" type=\"text\" maxlength=\"6\" aria-label=\"Six character room code\" placeholder=\"ROOM CODE\"><p id=\"roomHint\" class=\"note\">Rooms work between tabs on the same origin.</p>`:`<p>Host makes an invite. Your friend pastes it and makes an answer. Host pastes that answer. Then: drop the puck.</p><div class=\"cards\"><button class=\"panelButton\" data-action=\"create-offer\">1. Make an invite</button><button class=\"panelButton\" data-action=\"accept-offer\">2. Accept an invite</button></div><textarea id=\"signalInput\" class=\"codeInput signal\" aria-label=\"Paste invite or answer\" placeholder=\"Paste your friend’s invite or answer here\"></textarea><button class=\"panelButton\" data-action=\"accept-answer\">3. Host: accept the answer</button><textarea id=\"signalOutput\" class=\"codeInput signal\" readonly aria-label=\"Your code to share\" placeholder=\"Your shareable code appears here\"></textarea><button class=\"panelButton\" data-action=\"copy-signal\">Copy my code</button>`;[...$('\"'panel').querySelectorAll('[data-action\"'^=\"online-tab\"]'\"')].forEach(b=>b.classList.toggle('active',b.dataset.action.endsWith(tab)));}\nasync function action(a){audio.sfx('ui');if(['solo','practice','local'].includes(a)){start(a);return}if(a==='resume'){resume();return}if(a==='back'){closePanel();return}if(a==='quit'){if(network.hubActive){toast('AI Hub is running this round. The match will finish with the round.');return}network.disconnect();goTitle();return}if(['settings','controls','about','dev','online'].includes(a)){openPanel(a);return}if(a==='glyphs'){settings.glyphs=settings.glyphs==='ps'?'xbox':'ps';saveSettings();renderPanel('settings');return}if(a==='assist'){settings.assist=\"'!settings.assist;saveSettings();renderPanel('\"'settings');return}if(a.startsWith('about-')){renderAbout(+a.split('-')[1]);return}if(a.startsWith('online-tab-')){renderOnline(a.split('-')[2]);return}if(a==='rematch'){start(game.mode==='practice'?'solo':game.mode);return}if(a==='hub-done'){return}\n if(a.startsWith('dev-')){if(network.connected&&\"'!network.isHost){toast('\"'Live tuning belongs to the host.');return}const tool=a.slice(4);if(tool==='reset'){game.config={...DEFAULTS};timeScale=1;renderPanel('dev')}if(tool==='puck'){game.givePuck(game.control[network.localTeam||0]);toast('Puck delivered.')}if(tool==='refill'){game.players.forEach(p=>{p.stamina=1;p.stun=0});game.heat=[1,1];toast('Fresh legs. Wild shots armed.')}if(tool==='goal0'||tool==='goal1'){game.scores[tool==='goal0'?0:1]++;toast('Score updated.')}if(tool==='period'){game.advancePeriod();toast('Next period queued.')}if(tool==='faceoff'){game.faceoff();game.phase='faceoff';game.phaseTime=2;toast('Face-off reset.')}if(tool==='end'){game.finish