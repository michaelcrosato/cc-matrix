{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,90p' Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/test-core.py\nsed -n '1,80p' Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/test-network.py\nrg -n 'harness|auto|server|host' Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/hub/harness.html | tail -20\"","aggregated_output":"\"\"\"Core game tests. Run with the installed Playwright Python interpreter.\"\"\"\nfrom pathlib import Path\nfrom functools import partial\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom threading import Thread\nfrom playwright.sync_api import sync_playwright\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_args): pass\n\ndef check_core():\n    root = Path(__file__).resolve().parent\n    server = ThreadingHTTPServer((\"127.0.0.1\", 0), partial(QuietHandler, directory=str(root)))\n    thread = Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    failures = []\n    count = 0\n    try:\n        with sync_playwright() as pw:\n            browser = pw.chromium.launch(headless=True)\n            page = browser.new_page(ignore_https_errors=True)\n            errors = []\n            page.on(\"pageerror\", lambda error: errors.append(str(error)))\n            page.goto(f\"http://127.0.0.1:{server.server_port}/core-harness.html\")\n            if page.title() != \"Puck Wild core verification\":\n                raise AssertionError(\"wrong verification page\")\n            page.wait_for_function(\"!!window.core\", timeout=60000)\n            result = page.evaluate(SUITE)\n            count, failures = result[\"count\"], result[\"failures\"]\n            if errors: failures.extend(\"browser: \" + e for e in errors)\n            browser.close()\n    except Exception as exc:\n        failures.append(\"core harness: \" + str(exc))\n    finally:\n        server.shutdown()\n        server.server_close()\n        thread.join(timeout=3)\n    return count, failures\n\nSUITE = r\"\"\"async () => {\n const {HockeyGame,DEFAULTS}=window.core;\n const failures=[];let count=0;\n const assert=(condition,message)=>{if(!condition)throw new Error(message)};\n const step=(g,n=1,inputs=[{},{}])=>{for(let i=0;i<n;i++)g.update(1/60,inputs)};\n const place=(p,x,z,angle=0)=>{p.x=x;p.z=z;p.angle=angle;p.vx=0;p.vz=0;p.body.setTranslation({x,y:.9,z},true);p.body.setLinvel({x:0,y:0,z:0},true)};\n const quiet=(g)=>{g.config.ai=0;for(const p of g.players)p.aiTimer=1000;g.remote=true;};\n const create=async(mode='solo')=>{const g=await HockeyGame.create();g.start(mode);quiet(g);step(g,140);return g;};\n const test=async(name,fn)=>{count++;let g;try{g=await create();await fn(g);}catch(e){failures.push(name+': '+e.message)}finally{g?.world.free()}};\n await test('Rapier runtime and faceoff',g=>{assert(g.world.bodies.len()===7,'expected six skaters/goalies and puck');assert(g.phase==='play','faceoff did not enter live play');assert(g.period===1&&g.time<DEFAULTS.period,'period clock not running');});\n await test('movement inertia and turning',g=>{const p=g.players[0];place(p,-10,-8);g.setPuck(15,9);step(g,40,[{x:1,z:0},{}]);assert(p.x>-7,'skater did not accelerate');assert(p.vx>8,'top speed not reached');const vx=p.vx;step(g,1);assert(p.vx>0&&p.vx<vx,'release should retain momentum and slow');step(g,80);assert(Math.abs(p.vx)<.5,'skater should coast to a stop');});\n await test('boost drains and replenishes stamina',g=>{const p=g.players[0];place(p,-15,-8);g.setPuck(15,9);step(g,30,[{x:1,boost:true},{}]);assert(p.stamina<.85,'boost failed to drain stamina');assert(p.vx>10,'boost speed was not greater');const stamina=p.stamina;step(g,30);assert(p.stamina>stamina,'stamina failed to recover');});\n await test('switch changes the controlled teammate',g=>{assert(g.control[0]===0,'bad initial control');g.action(0,'switch');assert(g.control[0]===1,'switch did not select teammate');g.action(0,'switch');assert(g.control[0]===0,'second switch did not return');});\n await test('passing and teammate reception',g=>{place(g.players[0],-12,-7);place(g.players[1],-5,-7);g.control[0]=0;g.givePuck(0);g.action(0,'pass');assert(g.owner===null,'pass did not release puck');assert(g.control[0]===1,'pass did not switch control');assert(g.stats.passes[0]===1&&g.heat[0]>.3,'pass stats/heat not recorded');step(g,30);assert(g.owner===1,'teammate did not receive pass');});\n await test('charged shot releases on button lift',g=>{place(g.players[0],-10,-8);g.control[0]=0;g.givePuck(0);step(g,40,[{shoot:true,aim:{x:1,z:0}},{}]);assert(g.players[0].charge>.6,'holding shot did not charge');step(g,1,[{aim:{x:1,z:0}},{}]);assert(g.owner===null&&g.stats.shots[0]===1,'button release did not shoot');assert(g.puckBody.linvel().x>30,'charged shot too slow');});\n await test('wild-shot heat is consumed',g=>{place(g.players[0],-10,-8);g.control[0]=0;g.givePuck(0);g.heat[0]=1;g.players[0].charge=1;g.action(0,'shoot',{x:1,z:0});assert(g.heat[0]===0&&g.shotPower===2,'wild shot not activated');assert(g.puckBody.linvel().x>45,'wild shot lacks power');});\n await test('checking stuns and knocks puck free',g=>{place(g.players[0],-10,-7);place(g.players[2],-8,-7,Math.PI);g.control[0]=0;g.givePuck(2);g.action(0,'check');assert(g.players[2].stun>.5,'rival not stunned');assert(g.owner===null,'check did not release rival puck');assert(g.stats.checks[0]===1,'check not recorded');assert(g.players[2].body.linvel().x>8,'check did not apply impulse');});\n await test('puck rebounds from boards',g=>{g.owner=null;g.pickupLock=2;g.setPuck(0,12,0,20);step(g,15);assert(g.puckBody.linvel().z<0,'puck did not bounce off boards');assert(g.puck.z<14.2,'puck escaped boards');});\n await test('mouth goal and non-goal outside posts',g=>{g.owner=null;g.pickupLock=1;g.setPuck(24.6,5,0,0);step(g,1);assert(g.scores[0]===0,'outside-post shot incorrectly scored');g.setPuck(24.6,1.4,0,0);step(g,1);assert(g.scores[0]===1&&g.phase==='goal','legal puck did not score');step(g,190);assert(g.phase==='play'&&Math.abs(g.puck.x)<1,'goal did not reset faceoff');});\n await test('goalie saves incoming puck',g=>{g.owner=null;g.pickupLock=0;place(g.players[5],22.5,0,Math.PI);g.setPuck(20.8,0,22,0);step(g,5);assert(g.stats.saves[1]>0,'goalie did not save close shot');assert(g.scores[0]===0,'saved shot incorrectly scored');assert(g.puckBody.linvel().x<0,'goalie did not clear rebound');});\n await test('three periods reach a final result',g=>{g.config.period=.08;g.time=.08;g.scores=[2,1];step(g,600);assert(g.phase==='result','full match did not finish');assert(g.period===3&&g.winner===0,'wrong final period/winner');assert(g.events.some(e=>e.type==='finish'),'no match result event');});\n await test('tie enters sudden death and winning goal finishes',g=>{g.config.period=.08;g.time=.08;g.scores=[1,1];step(g,570);assert(g.period===4&&g.phase==='overtime','tied game did not enter overtime');g.goal(1);step(g,190);assert(g.phase==='result'&&g.winner===1,'sudden death goal did not finish match');});\n await test('skills club complete playthrough',async g=>{g.start('practice');quiet(g);step(g,140);assert(g.owner===0,'practice should start with a puck');place(g.players[0],-17,-8);g.givePuck(0);step(g,145,[{x:1},{}]);assert(g.drill.step===1,'skating drill did not complete');place(g.players[0],-12,-7);place(g.players[1],-5,-7);g.control[0]=0;g.givePuck(0);g.action(0,'pass');assert(g.drill.step===2,'passing drill did not complete');step(g,30);assert(g.owner===1,'practice pass did not catch');step(g,35,[{shoot:true,aim:{x:1,z:0}},{}]);step(g,1,[{aim:{x:1,z:0}},{}]);assert(g.drill.step===3,'charged-shot drill did not complete');const id=g.control[0];place(g.players[id],-10,-8);place(g.players[2],-8,-8);g.players[id].cd=0;g.action(0,'check');assert(g.drill.step===4,'check drill did not complete');g.owner=null;g.pickupLock=1;g.setPuck(24.6,1,0,0);step(g,1);assert(g.drill.done&&g.phase==='result'&&g.winner===0,'final skills goal did not complete session');});\n return {count,failures};\n}\"\"\"\n\nif __name__ == \"__main__\":\n    total, failures = check_core()\n    for failure in failures: print(\"FAIL \" + failure)\n    print(f\"{total - len(failures)}/{total} core checks passed\")\n    raise SystemExit(bool(failures))\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom threading import Thread\nfrom functools import partial\nimport json\nfrom playwright.sync_api import sync_playwright\n\ndef check_network():\n    failures=[]; count=0\n    root=Path(__file__).resolve().parent\n    class QuietHandler(SimpleHTTPRequestHandler):\n        def log_message(self,*args): pass\n    server=ThreadingHTTPServer((\"127.0.0.1\",0),partial(QuietHandler,directory=str(root)))\n    Thread(target=server.serve_forever,daemon=True).start()\n    try:\n        with sync_playwright() as p:\n            browser=p.chromium.launch(headless=True)\n            context=browser.new_context()\n            first=context.new_page(); second=context.new_page()\n            url=f\"http://127.0.0.1:{server.server_port}/network-test.html\"\n            for page in [first,second]:\n                page.goto(url);page.wait_for_function(\"window.ready\")\n                assert page.title()==\"Puck Wild Network Test\"\n            def check(name, condition):\n                nonlocal count\n                count+=1\n                if not condition: failures.append(name)\n            check(\"default music-independent offline network state\",first.evaluate(\"net.status==='Offline' && net.isHost && !net.connected\"))\n            code=first.evaluate(\"net.hostRoom()\")\n            second.evaluate(\"code=>net.joinRoom(code)\",code)\n            first.wait_for_function(\"net.connected\");second.wait_for_function(\"net.connected\")\n            check(\"broadcast connects both peers\", first.evaluate(\"net.connected&&net.isHost&&net.localTeam===0\") and second.evaluate(\"net.connected&&!net.isHost&&net.localTeam===1\"))\n            first.evaluate(\"net.sendState({score:[2,1],x:4})\")\n            second.wait_for_function(\"events.some(e=>e.type==='state')\")\n            check(\"broadcast host state arrives\", second.evaluate(\"events.find(e=>e.type==='state').data.score[0]===2\"))\n            second.evaluate(\"net.sendInput({x:1,shot:true})\")\n            first.wait_for_function(\"events.some(e=>e.type==='input')\")\n            check(\"broadcast guest input arrives\", first.evaluate(\"events.find(e=>e.type==='input').data.input.shot===true\"))\n            check(\"snapshot messages rate limited\", first.evaluate(\"net.lastState=-Infinity;net.sendState({x:5});net.sendState({x:6})===false\"))\n            first.evaluate(\"net._receive({game:'puck-wild',kind:'input',seq:80,payload:{x:80}});net._receive({game:'puck-wild',kind:'input',seq:79,payload:{x:79}})\")\n            check(\"out-of-order packets are discarded\",first.evaluate(\"events.some(e=>e.type==='input'&&e.data.input.x===80)&&!events.some(e=>e.type==='input'&&e.data.input.x===79)\"))\n            second.evaluate(\"net.disconnect()\")\n            first.wait_for_function(\"!net.connected\")\n            check(\"broadcast peer disconnect notification\",first.evaluate(\"events.some(e=>e.type==='peer-left')\"))\n            for page in [first,second]:page.evaluate(\"events=[];net.disconnect()\")\n            offer=first.evaluate(\"net.createOffer()\")\n            answer=second.evaluate(\"code=>net.acceptOffer(code)\",offer)\n            first.evaluate(\"code=>net.acceptAnswer(code)\",answer)\n            first.wait_for_function(\"net.connected\",timeout=20000);second.wait_for_function(\"net.connected\",timeout=20000)\n            check(\"WebRTC manual invite and answer connect\", first.evaluate(\"net.connected\") and second.evaluate(\"net.connected\"))\n            first.evaluate(\"net.sendState({score:[3,4]})\")\n            second.evaluate(\"net.sendInput({x:-1,boost:true})\")\n            first.wait_for_function(\"events.some(e=>e.type==='input')\");second.wait_for_function(\"events.some(e=>e.type==='state')\")\n            check(\"WebRTC authoritative traffic in both directions\",first.evaluate(\"events.find(e=>e.type==='input').data.input.boost\") and second.evaluate(\"events.find(e=>e.type==='state').data.score[1]===4\"))\n            check(\"invalid manual signal rejected\",second.evaluate(\"async()=>{try{await net.acceptOffer('garbage');return false}catch(e){return /complete/.test(e.message)}}\"))\n            for page in [first,second]: page.evaluate(\"net.disconnect()\")\n            first.add_init_script(\"\"\"\n              const handlers={};\n              window.hubCalls=[];\n              window.hubHandlers=handlers;\n              window.AIHub={active:true,\n                on(name,fn){handlers[name]=fn;return ()=>delete handlers[name]},\n                async connect(options){hubCalls.push(['connect',options]);return {me:99,host:99,isHost:true,server:true,players:[{id:0,name:'One'},{id:1,name:'Two'}]}},\n                ready(){hubCalls.push(['ready'])},\n                send(data,options){hubCalls.push(['send',data,options]);return true},\n                finish(data){hubCalls.push(['finish',data])}\n              };\n            \"\"\")\n            first.reload();first.wait_for_function(\"window.ready\")\n            first.evaluate(\"net.init()\")\n            check(\"hub shared-world server host has no player\",first.evaluate(\"net.hubActive&&net.connected&&net.isHost&&net.localTeam===null&&hubCalls[0][1].mode==='shared-world'\"))\n            first.evaluate(\"net.ready();net.ready();net.finish([5,2]);net.finish([1,0])\")\n            check(\"hub ready and finish are once-only\",first.evaluate(\"hubCalls.filter(c=>c[0]==='ready').length===1&&hubCalls.filter(c=>c[0]==='finish').length===1\"))\n            check(\"hub standings include both players\",first.evaluate(\"JSON.stringify(hubCalls.find(c=>c[0]==='finish')[1].standings)==='[[0],[1]]'\"))\n            first.evaluate(\"hubHandlers.message({game:'puck-wild',kind:'input',payload:{x:1}},1)\")\n            check(\"hub authoritative host receives guest inputs\",first.evaluate(\"events.some(e=>e.type==='input'&&e.data.from===1&&e.data.input.x===1)\"))\n            first.evaluate(\"hubHandlers.end({reason:'finished'})\")\n            check(\"hub end stops all outgoing traffic\",first.evaluate(\"net.ended&&!net.connected&&!net.sendState({x:2})\"))\n            browser.close()\n    except Exception as error:failures.append(str(error))\n371:  (current.cells.find((c) => c.server) ?? current.cells[0])?.bridge.visibility(current.hidden);\n372:  log(`host tab ${current.hidden ? 'hidden' : 'shown'}`);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n427:    // Every copy: the players, and in a server round the server's copy.\n428:    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n436:      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n445:      const players = state.cells.filter((c) => !c.server);\n461:        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n468:    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n486:        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n499:    if (serverMode) {\n500:      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n501:      const serverCell = state.cells.find((c) => c.server);\n502:      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n503:        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n506:      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n523:    check('harness ran', false, String(error?.stack || error));\n544:if (auto) conformance();\n","exit_code":0,"status":"completed"}}
