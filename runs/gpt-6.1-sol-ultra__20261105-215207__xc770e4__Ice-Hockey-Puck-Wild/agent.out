useButton{width:36px;height:36px;right:12px;top:15px}#netBadge{display:none}.panel{padding:24px;width:92vw}.panel h2{font-size:34px}.split,.cards{grid-template-columns:1fr;gap:10px}.panel p{font-size:15px}.row label{font-size:15px}#banner{white-space:normal;text-align:center;min-width:260px;padding:15px 20px}#drill{top:96px;left:15px;width:250px}.titleFoot{font-size:10px}.eyebrow{letter-spacing:2px}}@media(max-height:520px){.titleContent h1{font-size:65px;margin:10px 0}.titleContent .tagline{display:none}.titleContent .menuStack{gap:4px}.titleContent .menuStack button{padding:6px 13px;font-size:13px}.titleContent .menuStack button.primary{font-size:17px}.titleFoot{margin:10px 0}.titleContent{margin-top:26px}.eyebrow{font-size:10px}.controls{font-size:11px;padding:9px}#drill{top:88px}#drill p{font-size:12px}.panel{max-height:92vh}.panel h2{font-size:30px}}\n</style>\n<script type=\\\"importmap\\\">{\\\"imports\\\":{\\\"three\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\\\",\\\"three/webgpu\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\\\",\\\"three/tsl\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js\\\"}}</script>\n</head><body>\n<div id=\\\"arena\\\"></div><div id=\\\"vignette\\\"></div><div id=\\\"grain\\\"></div>\n<div id=\\\"loading\\\"><span class=\\\"eyebrow\\\">THE FROZEN FOURTH LINE PRESENTS</span><strong>FRESHENING THE ICE</strong><div class=\\\"loader\\\"></div><div id=\\\"loadNote\\\">Lacing up skates. Tuning the rink organ.</div></div>\n<div id=\\\"titleScreen\\\"><div class=\\\"cornerBrand\\\">PUCK WILD • EST. 1981</div><main class=\\\"titleContent\\\"><div class=\\\"eyebrow\\\">A LITTLE ICE. A LOT OF TROUBLE.</div><h1><span class=\\\"smallTitle\\\">Ice Hockey</span><span>Puck</span><span class=\\\"wild\\\">Wild.</span></h1><div class=\\\"tagline\\\">GOOD ICE. BAD MANNERS.</div><nav class=\\\"menuStack\\\"><button class=\\\"primary\\\" data-action=\\\"solo\\\">PLAY THE NIGHT GAME <small>1 PLAYER →</small></button><button data-action=\\\"practice\\\">Skills club <small>LEARN THE ROPES</small></button><button data-action=\\\"local\\\">Couch face-off <small>2 PLAYERS</small></button><button data-action=\\\"online\\\">Play with a friend <small>ONLINE / HUB</small></button><button data-action=\\\"settings\\\">Settings & controls <small>⌘</small></button><button data-action=\\\"about\\\">About this game <small>’81</small></button></nav><div class=\\\"titleFoot\\\">2 ON 2 + KEEPERS &nbsp; / &nbsp; THREE QUICK PERIODS</div></main><div class=\\\"edition\\\">ARCADE HOCKEY. FRESHLY ZAMBONIED.<b>THE NIGHT GAME</b>FOXES vs. FREEZE &nbsp; • &nbsp; NORTH END RINK</div></div>\n<div id=\\\"hud\\\" class=\\\"hidden\\\"><div class=\\\"scoreboard\\\"><div class=\\\"teamBlock fox\\\"><span class=\\\"teamName\\\">FOXES</span><b class=\\\"score\\\" id=\\\"score0\\\">0</b><div class=\\\"teamHeat\\\"><i id=\\\"heat0\\\"></i></div></div><div class=\\\"clock\\\"><strong id=\\\"clock\\\">0:45</strong><span id=\\\"period\\\">PERIOD 1 / 3</span></div><div class=\\\"teamBlock freeze\\\"><b class=\\\"score\\\" id=\\\"score1\\\">0</b><span class=\\\"teamName\\\">FREEZE</span><div class=\\\"teamHeat\\\"><i id=\\\"heat1\\\"></i></div></div><div class=\\\"attack\\\"><span>ATTACK →</span><span>← ATTACK</span></div></div><div id=\\\"netBadge\\\"></div><button id=\\\"pauseButton\\\" aria-label=\\\"Pause\\\">Ⅱ</button><div class=\\\"lowerHud\\\"><div class=\\\"statusPlate\\\"><strong id=\\\"playerName\\\">01 / FOXES</strong><small id=\\\"puckStatus\\\">FIND THE PUCK</small><div class=\\\"stamina\\\"><i id=\\\"stamina\\\"></i></div></div><div class=\\\"controls\\\" id=\\\"controlHints\\\"></div></div><div id=\\\"drill\\\" class=\\\"hidden\\\"></div></div>\n<div id=\\\"banner\\\" class=\\\"hidden\\\"></div><div id=\\\"attract\\\" class=\\\"hidden\\\"><div class=\\\"sticker\\\">AFTER HOURS • LIVE DEMO</div><small>PRESS ANYTHING TO TAKE THE ICE</small></div><div id=\\\"modal\\\" class=\\\"overlay hidden\\\"><div id=\\\"panel\\\" class=\\\"panel\\\"></div></div><div id=\\\"toast\\\" class=\\\"hidden\\\"></div><div id=\\\"touchStick\\\" class=\\\"hidden\\\"><i></i></div><div id=\\\"touchHint\\\" class=\\\"hidden\\\"></div>\n<script type=\\\"module\\\">\n// GAME_CODE\n</script>\n</body></html>\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/network.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/network.js\"","aggregated_output":"// AI Hub transport and independent direct-link multiplayer. No game simulation lives here.\nexport class HockeyNetwork {\n  constructor() {\n    this.onEvent = () => {};\n    this.hubActive = !!globalThis.AIHub?.active;\n    this.info = null;\n    this.isHost = true;\n    this.connected = false;\n    this.mode = 'none';\n    this.roomCode = '';\n    this.lastState = -Infinity;\n    this.lastInput = -Infinity;\n    this.ended = false;\n    this._generation = 0;\n    this._ready = false;\n    this._finished = false;\n    this._unsub = [];\n    this._heartbeat = null;\n    this._outSeq = 0;\n    this._inSeq = new Map();\n    globalThis.addEventListener?.('pagehide', () => this.disconnect());\n  }\n\n  get localTeam() {\n    if (this.hubActive) return this.info?.server ? null : Number(this.info?.me ?? 0) % 2;\n    return this.isHost ? 0 : 1;\n  }\n\n  get status() {\n    if (this.ended) return 'Round ended';\n    if (this.hubActive) return this.connected ? 'AI Hub session' : 'Connecting to AI Hub';\n    if (this.connected) return this.mode === 'rtc' ? 'Direct link connected' : `Room ${this.roomCode} connected`;\n    return this.mode === 'none' ? 'Offline' : 'Waiting for opponent';\n  }\n\n  _emit(type, data = {}) {\n    try { this.onEvent(type, data); } catch (error) { console.error('Network event handler:', error); }\n  }\n\n  async init() {\n    if (!this.hubActive) return null;\n    const hub = globalThis.AIHub;\n    this._unsub.push(hub.on('message', (data, from) => {\n      if (this.ended || !data || data.game !== 'puck-wild' || !this._fresh(data, from)) return;\n      if (data.kind === 'input' && this.isHost && from !== this.info?.host) this._emit('input', { from, input: data.payload });\n      else if (data.kind === 'state' && !this.isHost && from === this.info?.host) this._emit('state', data.payload);\n    }));\n    this._unsub.push(hub.on('start', data => this._emit('start', data)));\n    this._unsub.push(hub.on('time-up', data => this._emit('time-up', data)));\n    this._unsub.push(hub.on('leave', data => this._emit('peer-left', data)));\n    this._unsub.push(hub.on('end', data => {\n      this.ended = true;\n      this.connected = false;\n      this._emit('end', data);\n    }));\n    this.info = await hub.connect({ mode: 'shared-world', seats: [2, 2] });\n    if (!this.info) {\n      this.hubActive = false;\n      this._unsub.forEach(fn => fn());\n      this._unsub = [];\n      return null;\n    }\n    this.isHost = !!this.info.isHost;\n    this.connected = true;\n    this.mode = 'hub';\n    this._emit('hub-ready', this.info);\n    return this.info;\n  }\n\n  ready() {\n    if (this.hubActive && !this._ready) {\n      this._ready = true;\n      globalThis.AIHub.ready();\n    }\n  }\n\n  finish(teamScores, stats = {}) {\n    if (!this.hubActive || !this.isHost || this._finished || this.ended) return;\n    this._finished = true;\n    const players = this.info.players;\n    const scores = Object.fromEntries(players.map(p => [p.id, Number(teamScores[p.id % 2]) || 0]));\n    const values = [...new Set(Object.values(scores))].sort((a, b) => b - a);\n    const standings = values.map(value => players.filter(p => scores[p.id] === value).map(p => p.id));\n    const perPlayerStats = Object.fromEntries(players.map(p => [p.id, stats[p.id % 2] || {}]));\n    globalThis.AIHub.finish({ standings, scores, stats: perPlayerStats });\n  }\n\n  sendState(state) {\n    if (!this.connected || !this.isHost || this.ended) return false;\n    const now = performance.now();\n    if (now - this.lastState < 55) return false;\n    this.lastState = now;\n    return this._send({ game: 'puck-wild', kind: 'state', seq: this._outSeq++, payload: state });\n  }\n\n  sendInput(input) {\n    if (!this.connected || this.isHost || this.ended) return false;\n    const now = performance.now();\n    if (now - this.lastInput < 55) return false;\n    this.lastInput = now;\n    return this._send({ game: 'puck-wild', kind: 'input', seq: this._outSeq++, payload: input });\n  }\n\n  _send(data) {\n    try {\n      if (this.hubActive) return globalThis.AIHub.send(data, this.isHost ? { reliable: false } : { to: this.info.host, reliable: false });\n      if (this.mode === 'broadcast' && this.channel) {\n        this.channel.postMessage({ ...data, sender: this._id });\n        return true;\n      }\n      if (this.mode === 'rtc' && this.dataChannel?.readyState === 'open') {\n        if (this.dataChannel.bufferedAmount > 64000) return false;\n        this.dataChannel.send(JSON.stringify(data));\n        return true;\n      }\n    } catch (error) { this._emit('error', { message: error.message }); }\n    return false;\n  }\n\n  _fresh(data, from = 'peer') {\n    if (!Number.isFinite(data.seq)) return true;\n    const key = from + ':' + data.kind;\n    if (data.seq <= (this._inSeq.get(key) ?? -1)) return false;\n    this._inSeq.set(key, data.seq);\n    return true;\n  }\n\n  _receive(data) {\n    if (!data || data.game !== 'puck-wild' || this.ended || !this._fresh(data)) return;\n    if (data.kind === 'input' && this.isHost) this._emit('input', { from: 1, input: data.payload });\n    if (data.kind === 'state' && !this.isHost) this._emit('state', data.payload);\n  }\n\n  _randomCode() {\n    const bytes = new Uint8Array(6);\n    crypto.getRandomValues(bytes);\n    return [...bytes].map(x => 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[x % 32]).join('');\n  }\n\n  hostRoom() {\n    if (this.hubActive) throw new Error('AI Hub manages this connection.');\n    this.disconnect();\n    this.mode = 'broadcast';\n    this.isHost = true;\n    this.roomCode = this._randomCode();\n    this._openRoom(this.roomCode);\n    return this.roomCode;\n  }\n\n  joinRoom(code) {\n    if (this.hubActive) throw new Error('AI Hub manages this connection