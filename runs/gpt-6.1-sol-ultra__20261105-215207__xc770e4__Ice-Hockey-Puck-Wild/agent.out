olid var(--cyan);padding:16px 20px}#drill small{letter-spacing:2px;color:var(--cyan);font-weight:700;font-size:11px}#drill strong{display:block;font:800 25px 'Barlow Condensed',sans-serif;margin-top:7px}#drill p{font-size:14px;line-height:1.5;color:#c6d4de;margin:7px 0 0}.overlay{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;background:#071325bd;backdrop-filter:blur(8px)}.panel{width:min(660px,90vw);max-height:88vh;background:#101f32;border:2px solid #6f8b9b55;box-shadow:12px 13px 0 #06101f80;padding:33px 38px;overflow:auto;scrollbar-color:#587182 #101f32}.panel.wide{width:min(980px,92vw)}.panel h2{font:900 46px/.95 'Barlow Condensed',Impact,sans-serif;font-style:italic;letter-spacing:1px;margin:7px 0 21px}.panel h3{font:800 25px 'Barlow Condensed',sans-serif;color:var(--gold);letter-spacing:1px;margin:22px 0 12px}.panel p{font-size:17px;line-height:1.6;color:#c2d1dc}.panel .menuStack{max-width:none}.panel .panelButton{display:block;width:100%;margin-top:10px}.back{float:right;border:none;background:transparent;color:var(--muted);font-size:17px;padding:0 3px 10px;cursor:pointer}.sectionLabel{font-size:12px;color:var(--cyan);font-weight:800;letter-spacing:3px;text-transform:uppercase}.row{display:flex;gap:15px;margin:15px 0;align-items:center;justify-content:space-between}.row label{font-size:18px;font-weight:600}.row input[type=range]{width:44%;accent-color:var(--gold);height:28px}.row output{width:50px;text-align:right;color:var(--gold);font-weight:700}.toggle{background:#284257;border:1px solid #8b9ba4;color:var(--paper);padding:9px 16px;font-weight:700}.note{font-size:13px\"'!important;color:var(--muted)!important}.networkStatus{border-left:3px solid var(--cyan);background:#1a3345;padding:12px 16px;font-size:16px;margin:18px 0}.codeInput{width:100%;border:2px solid #587385;background:#0a1729;color:var(--paper);padding:13px;font-size:18px;margin:8px 0}.signal{font:13px monospace;resize:vertical;height:95px}.split{display:grid;grid-template-columns:1fr 1fr;gap:24px}.cards{display:grid;grid-template-columns:1fr 1fr;gap:14px}.controlCard{padding:18px;background:#1a3044;border-top:3px solid var(--gold)}.controlCard strong{display:block;color:var(--gold);font-size:20px;margin-bottom:9px}.controlCard p{font-size:15px;margin:0}.tabs{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:20px}.tabs button{border:1px solid #567081;background:#193044;color:var(--paper);padding:9px 12px;font-weight:700;font-size:14px}.tabs button.active{background:var(--gold);color:var(--ink)}dl{margin:0}dt{color:var(--cyan);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-top:15px}dd{margin:5px 0 0;color:#d1dbe2;font-size:15px;line-height:1.45}.feedbackItem{margin-bottom:18px}.feedbackItem strong{display:block;color:var(--cyan);font-size:15px;margin-bottom:6px}.feedbackItem p{font-size:15px;line-height:1.5;margin:0}.resultScore{font:900 100px/1 '\"'Barlow Condensed',Impact,sans-serif;color:var(--gold);letter-spacing:15px;margin:12px 0}.statsTable{width:100%;border-collapse:collapse;margin:20px 0;color:#cbd6df;font-size:17px}.statsTable td{padding:10px;border-bottom:1px solid #ffffff20;text-align:center}.statsTable td:first-child{text-align:left}#toast{position:absolute;bottom:95px;left:50%;transform:translateX(-50%);background:var(--paper);border:3px solid var(--ink);color:var(--ink);padding:12px 22px;font-size:17px;font-weight:700;z-index:45;max-width:80vw;text-align:center}#touchHint{position:absolute;pointer-events:none;padding:9px 15px;border:2px solid var(--paper);border-radius:100px;background:#101d32b0;color:var(--gold);font-size:14px;font-weight:800;transform:translate(-50%,-50%)}#touchStick{position:absolute;width:95px;height:95px;border:2px solid #ffffff60;background:#101d3230;border-radius:50%;pointer-events:none;transform:translate(-50%,-50%)}#touchStick i{display:block;position:absolute;width:30px;height:30px;border-radius:50%;background:#ffc25190;left:30px;top:30