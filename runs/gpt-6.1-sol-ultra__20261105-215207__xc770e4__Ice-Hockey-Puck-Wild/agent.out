b=>b.classList.remove('focused'));el.classList.add('focused');const n=focusables().indexOf(el);if(n>=0)focusIndex=n;}});\ndocument.addEventListener('input',e=>{if(e.target.dataset.setting){const k=e.target.dataset.setting;settings[k]=+e.target.value;audio[k==='music'?'setMusic':'setSfx'](settings[k]);e.target.nextElementSibling.textContent=Math.round(settings[k]*100)+'%';saveSettings()}if(e.target.dataset.dev){const k=e.target.dataset.dev;if(k==='timeScale')timeScale=+e.target.value;else game.config[k]=+e.target.value;e.target.nextElementSibling.textContent=(+e.target.value).toFixed(+e.target.step<1?2:0)}});\n\"'$('\"'pauseButton').onclick=()=>{interact(lastInput);pause()};\nfunction enqueue(team,type){pending[team].push(type)}\nwindow.addEventListener('keydown',e=>{const typing=/\"'^(INPUT|TEXTAREA)$/.test(e.target.tagName)&&e.target.type!=='\"'range';if(typing&&e.code\"'!=='\"'Escape')return;const exited=interact('keyboard');if(exited){e.preventDefault();return}if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code))e.preventDefault();if(e.repeat)return;if(e.code==='Escape'){e.preventDefault();if(panelName){if(panelName==='pause')resume();else closePanel()}else pause();return}if(panelName||screen==='title'){if(e.code==='Enter'||e.code==='Space'){e.preventDefault();menuNav(0,0,true)}else if(['ArrowDown','KeyS'].includes(e.code))menuNav(0,1);else if(['ArrowUp','KeyW'].includes(e.code))menuNav(0,-1);else if(e.code==='ArrowLeft')menuNav(-1,0);else if(e.code==='ArrowRight')menuNav(1,0);return}keys.add(e.code);const map={KeyE:[0,'pass'],KeyF:[0,'check'],KeyQ:[0,'switch'],Tab:[0,'switch'],KeyK:[1,'pass'],KeyL:[1,'check'],KeyU:[1,'switch']};if(map[e.code])enqueue(...map[e.code]);});\nwindow.addEventListener('keyup',e=>{keys.delete(e.code)});window.addEventListener('blur',()=>{clearControls();if(screen==='game'&&\"'!network.connected&&!attract&&!panelName)pause()});\n$('\"'arena').addEventListener('contextmenu',e=>e.preventDefault());\n\"'$('\"'a