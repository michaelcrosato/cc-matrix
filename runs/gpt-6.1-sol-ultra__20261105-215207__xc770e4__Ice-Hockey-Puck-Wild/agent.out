{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,100p' Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/test-hub.py\nrg -n '\"'^def |audit|check'\"\\\\(' Ice-Hockey-Puck-Wild-Ice-Hockey-1981-gpt-6.1-sol-ultra-20261105-215207/test-ui.py\"","aggregated_output":"\"\"\"Official AI Hub conformance in standard, server and host-leave rounds.\"\"\"\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom threading import Thread\nfrom functools import partial\nfrom urllib.parse import urlencode\nimport json\nfrom playwright.sync_api import sync_playwright\n\ndef check_hub():\n    dev=Path(__file__).resolve().parent;root=dev.parent\n    class QuietHandler(SimpleHTTPRequestHandler):\n        def log_message(self,*args):pass\n    server=ThreadingHTTPServer(('127.0.0.1',0),partial(QuietHandler,directory=str(root)))\n    thread=Thread(target=server.serve_forever,daemon=True);thread.start()\n    failures=[];count=0;reports=[]\n    try:\n        with sync_playwright() as pw:\n            browser=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n            context=browser.new_context(ignore_https_errors=True,viewport={'width':1280,'height':720})\n            for scenario in ['standard','server','host-leave']:\n                page=context.new_page()\n                params={'game':'../../'+dev.name+'.html','players':2,'auto':1,'scenario':scenario,'play':3000,'limit':30,'latency':150,'jitter':50,'loss':5}\n                url=f'http://127.0.0.1:{server.server_port}/{dev.name}/hub/harness.html?'+urlencode(params)\n                page.goto(url)\n                if page.title()!='AI Hub — session harness':\n                    actual=page.title()\n                    if 'harness' not in actual.lower():raise AssertionError('Wrong harness page: '+actual)\n                page.wait_for_function('document.body.dataset.complete===\"true\"',timeout=100000)\n                report=page.evaluate('window.__hubCheck');reports.append(report)\n                for check in report['checks']:\n                    count+=1\n                    if not check['pass']:failures.append(scenario+': '+check['name']+' — '+check['detail'])\n                page.close()\n            browser.close()\n    except Exception as error:failures.append('Hub harness: '+str(error).splitlines()[0])\n    finally:server.shutdown();server.server_close();thread.join(timeout=3)\n    (dev/'hub-test-results.json').write_text(json.dumps(reports,indent=2))\n    return count,failures\n\nif __name__=='__main__':\n    count,failures=check_hub()\n    for failure in failures:print('FAIL:',failure)\n    print(f'{count} official Hub checks; {len(failures)} failures')\n    raise SystemExit(bool(failures))\n17:def check_ui():\n26:    def check(name,fn):\n43:            check('single HTML boots with actual WebGPU',lambda:(boot(),page.evaluate(\"__game.view.backend==='WebGPU' && !document.getElementById('loading').offsetParent\"))[1])\n44:            check('music defaults to ten percent',lambda:page.evaluate(\"Math.abs(__game.audio.musicVolume-.1)<.001 || (!localStorage.getItem('puck-wild-settings') && document.getElementById('titleScre [... omitted end of long line]\n47:            check('title starts a complete solo match',lambda:page.evaluate(\"__game.game.mode==='solo' && __game.screen==='game' && !__game.paused && __game.game.period===1\"))\n50:            check('WASD moves a skater',lambda:page.evaluate('__game.game.players[0].x>window.startX+.6'))\n54:            check('keyboard hold and release charges and shoots',lambda:page.evaluate('__game.game.stats.shots[0]===window.beforeShot+1'))\n56:            check('Escape pauses simulation',lambda:page.evaluate(\"__game.paused&&__game.panel==='pause'\"))\n58:            check('developer sliders apply live',lambda:page.evaluate('__game.game.config.speed===15&&__game.game.config.shot===51&&__game.game.config.ai===.25'))\n60:            check('developer reset restores defaults',lambda:page.evaluate('__game.game.config.speed===9.5&&__game.game.config.shot===33&&__game.game.config.ai===.78'))\n62:            check('developer tools deliver puck heat and score',lambda:page.evaluate('__game.game.owner===__game.game.control[0]&&__game.game.heat[0]===1&&__game.game.scores[0]===1'))\n64:            check('about contains complete Source Information',lambda:page.locator('#aboutBody').inner_text().find('added on import')>=0 and page.locator('#aboutBody dt').count()==15)\n67:                check(f'about feedback tab {tab} contains every answer',lambda expected=expected:page.locator('#aboutBody .feedbackItem').count()==expected and 'undefined' not in page.locator('#aboutB [... omitted end of long line]\n69:            check('settings persist values and glyph preference',lambda:page.evaluate(\"JSON.parse(localStorage.getItem('puck-wild-settings')).music===.23&&JSON.parse(localStorage.getItem('puck-wild-se [... omitted end of long line]\n71:            check('settings survive reload',lambda:page.locator('#music').input_value()=='0.23' and 'Xbox' in page.locator('[data-action=glyphs]').inner_text() and page.locator('[data-action=assist]') [... omitted end of long line]\n73:            check('ten second idle starts AI attract match',lambda:page.evaluate(\"__game.screen==='game'&&__game.game.mode==='attract'&&document.getElementById('attract').offsetParent!==null\"))\n75:            check('any key exits attract without starting a match',lambda:page.evaluate(\"__game.screen==='title'&&__game.game.mode==='menu'\"))\n81:            check('standard gamepad D-pad navigates menus',lambda:page.locator('[data-action=practice]').evaluate(\"e=>e.classList.contains('focused')\"))\n83:            check('standard gamepad Cross starts selected mode',lambda:page.evaluate(\"__game.game.mode==='practice'&&__game.input==='gamepad'\"))\n86:   