 + line)\n\nbad = 0\nfor name, m in maps.items():\n    g, w, h = m['g'], m['w'], m['h']\n    if show:\n        print(f'\\n{name} {w}x{h}')\n        print('    ' + ''.join(str(i // 10) if i % 10 == 0 else ' ' for i in range(w)))\n        for y, row in enumerate(g):\n            print(f'{y:3d} ' + ''.join(row))\n    start = next(((x, y) for y in range(h) for x in range(w) if g[y][x] == 'a'), None)\n    if start is None:\n        start = next(((x, y) for y in range(h) for x in range(w) if g[y][x] not in SOLID and g[y][x] not in SHUT), None)\n    seen = {start}\n    q = deque([start])\n    while q:\n        x, y = q.popleft()\n        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in seen and g[ny][nx] not in SOLID:\n                seen.add((nx, ny))\n                q.append((nx, ny))\n    unreachable = []\n    open_cells = 0\n    for y in range(h):\n        for x in range(w):\n            c = g[y][x]\n            if c in SOLID:\n                continue\n            open_cells += 1\n            if (x, y) not in seen:\n                unreachable.append((x, y, c))\n    summary = f'{name}: {w}x{h}, {open_cells} open cells, reached {len(seen)}'\n    if unreachable:\n        bad += 1\n        print(summary, 'UNREACHABLE', unreachable[:30])\n    else:\n        print(summary, 'ok')\nprint('maps with problems:', bad)\nsys.exit(1 if bad else 0)\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01MAAKAE4BebqDCKLseceGzS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
