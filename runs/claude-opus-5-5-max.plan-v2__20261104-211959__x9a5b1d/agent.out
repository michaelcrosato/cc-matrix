or: 'center', scale: 2 });\n */\nexport declare class Hud {\n})}rect(e,t,n,r,i,a=`top-left`){this.items.push({kind:`rect`,x:e,y:t,w:n,h:r,color:i,anchor:a})}sprite(e,t,n,r,i={}){this.items.push({kind:`sprite`,x:e,y:t,rows:n,colors:r,o:i})}clear(){this.items=[]}measure(e,t=1){return{width:Math.max(0,e.length*6-1)*t,height:7*t}}sync(e,t){if(this.size=e,!this.container||!this.canvas&&this.items.length===0)return;let n=this.canvas??=this.createCanvas(this.container),r=`${e.width}x${e.height}|${t.cssWidth},${t.cssHeight},${t.offsetX},${t.offsetY}|${this.visible}`;if(r!==this.layoutKey){this.layoutKey=r,(n.width!==e.width||n.height!==e.height)&&(n.width=e.width,n.height=e.height,this.drawn=``);let i=n.style;i.width=`${t.cssWidth}px`,i.height=`${t.cssHeight}\nfont? 1253448 A:[14,17,17,17,31,17,17],B:[30,17,17,30,17,17,30],C:[14,17,16,16,16,17,14],D:[28,18,17,17,17,18,28],E:[31,16,16,30,16,16,31],F:[31,16,16,30,16,16,16],G:[14,17,16,23,17,17,15],H:[17,17,17,31,17,17,17],I:[14,4,4,4,4,4,14],J:[7,2,2,2,2,18,12],K:[17,18,20,24,20,18,17],L:[16,16,16,16,16,16,31],M:[17,27,2","is_error":false}]},"parent_tool_use_id":null,"session_id":"4a882869-9e92-4155-a3b0-121d8fdc660c","uuid":"22cea457-7c47-4f76-af23-0023bbf7ce19","timestamp":"2026-11-05T04:38:07.834Z","tool_use_result":{"stdout":"export declare const GLYPH_W = 6;\nexport declare const GLYPH_H = 8;\n/** Call `plot(x, y)` for every lit pixel of `text` at (x, y), top-left origin. */\nexport declare function drawText(text: string, x: number, y: number, plot: (x: number, y: number) => void, scale?: number): number;\nexport declare function textWidth(text: string, scale?: number): number;\nimport type { Framing, Resolution } from '../framing';\nimport { type PaletteColor } from '../palette';\n/** Where an element is attached on screen; it is also aligned that way (right-anchored text grows left). */\nexport type HudAnchor = 'top-left' | 'top' | 'top-right' | 'left' | 'center' | 'right' | 'bottom-left' | 'bottom' | 'bottom-right';\n