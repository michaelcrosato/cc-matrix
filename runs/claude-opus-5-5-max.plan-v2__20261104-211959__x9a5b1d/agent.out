{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018YuwR4eW5mGkk3dhogMBU8","type":"tool_result","content":"1\t/**\n2\t * Standard-mapping gamepad buttons → the key codes they press (see character/controls.ts\n3\t * KEYMAP). Change `input.gamepadButtons` to remap. Indices follow the W3C \"standard\" layout:\n4\t * 0 A · 1 B · 2 X · 3 Y · 4 LB · 5 RB · 6 LT · 7 RT · 8 Back · 9 Start · 12–15 d-pad.\n5\t */\n6\texport declare const GAMEPAD_BUTTONS: Readonly<Record<number, string>>;\n7\t/** The parts of the Gamepad API that Input reads (tests can pass plain objects). */\n8\texport interface GamepadLike {\n9\t    readonly connected?: boolean;\n10\t    readonly mapping?: string;\n11\t    readonly axes: readonly number[];\n12\t    readonly buttons: readonly {\n13\t        readonly pressed: boolean;\n14\t        readonly value?: number;\n15\t    }[];\n16\t}\n17\t/**\n18\t * Radial deadzone with rescaling: inside `deadzone` reads 0, the rim reads 1, and the\n19\t * direction is kept (no square-gate snapping to the axes).\n20\t */\n21\texport declare function applyDeadzone(x: number, y: number, deadzone?: number): {\n22\t    x: number;\n23\t    y: number;\n24\t};\n25\t/** How long a queued press stays consumable, in seconds of game time. */\n26\texport declare const PRESS_WINDOW = 0.15;\n27\t/**\n28\t * What the game could read from input in one frame (a recorded frame, see src/engine/replay.ts).\n29\t * Optional fields are left out when empty or zero; `held` and `pointer` also when unchanged\n30\t * from the frame before.\n31\t */\n32\texport interface InputFrame {\n33\t    /** Real seconds this frame lasted (game time follows from it). */\n34\t    dt: number;\n35\t    /** Keys held, keyboard and gamepad buttons together, sorted. */\n36\t    held?: string[];\n37\t    /** Keys pressed since the frame before (a tap can be pressed and not held). */\n38\t    pressed?: string[];\n39\t    /** The touch joystick and the gamepad's left stick (after its deadzone). */\n40\t    analog?: [number, number];\n41\t    pad?: [number, number];\n42\t    /** Pointer movement (CSS pixels) and wheel ticks this frame. */\n43\t    delta?: [number, number];\n44\t    wheel?: number;\n45\t    /** Pointer position (normalised device coordinates), over the canvas (1/0), buttons (`mouseButtons`: what `held` says). */\n46\t    pointer?: [number, number, number, number];\n47\t    /** Whether a gamepad is connected (`gamepadConnected`), when that changes. */\n48\t    gamepad?: boolean;\n49\t    /** Whether the pointer is a touch (`pointer.touch`), when that changes. */\n50\t    touch?: boolean;\n51\t    /** Pointer buttons pressed (1) and let go (0) this frame, in order, each where the pointer was (`buttonEvents`). */\n52\t    clicks?: [string, 0 | 1, number, number][];\n53\t    /** Data from outside the canvas delivered this frame (`send()`): a DOM widget's value, a save read from storage. */\n54\t    commands?: unknown[];\n55\t    /**\n56\t     * Ran in the same task as the frame before (frames of one `step(n)` call): no promise\n57\t     * callbacks ran between them. A replay waits for them before every other frame.\n58\t     */\n59\t    sync?: true;\n60\t}\n61\t/** What input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer. */\n62\texport interface InputState {\n63\t    readonly held: readonly string[];\n64\t    /** Queued presses: [key, seconds of game time since it was pressed]. */\n65\t    readonly queued: readonly (readonly [string, number])[];\n66\t    readonly pointer: readonly [number, number, number, number];\n67\t    readonly gamepad: boolean;\n68\t    /** Data sent (`send`) and not yet delivered: the next frame that runs delivers it. */\n69\t    readonly outbox: readonly unknown[];\n70\t}\n71\t/** What the frame before held, for `snapshot()` to leave out what did not change. */\n72\texport interface SnapshotMemory {\n73\t    held: string;\n74\t    pointer: string;\n75\t    gamepad?: boolean;\n76\t    touch?: boolean;\n77\t}\n78\t/**\n79\t * Mouse buttons as key codes (`isDown('MouseLeft')`, `consumePress('MouseRight')`), each with\n80\t * its `PointerEvent.buttons` bit, by `PointerEvent.button` (0 left, 1 middle, 2 right).\n81\t */\n82\texport declare const MOUSE_BUTTONS: readonly (readonly [code: string, bit: number])[];\n83\t/** A finger on the canvas, as a key: held while one is down (not a mouse button, so a tap is not a click). */\n84\texport declare const TOUCH_KEY = \"Touch\";\n85\t/** A pointer button pressed or let go (`Input.buttonEvents`): its key, and where the pointer was (normalised device coordinates). */\n86\texport interface ButtonEvent {\n87\t    readonly code: string;\n88\t    readonly down: boolean;\n89\t    readonly x: number;\n90\t    readonly y: number;\n91\t}\n92\t/**\n93\t * Keyboard + pointer + gamepad input.\n94\t * - Keys: held state, per-frame presses (`wasPressed`) and queued presses for fixed-step\n95\t *   code (`consumePress`). Queued presses expire after `pressWindow` s of game time.\n96\t * - Gamepads (standard mapping): the left stick feeds `moveAxis()` (radial deadzone), the\n97\t *   right stick feeds the pointer delta (camera look), buttons press key codes\n98\t *   (`gamepadButtons`). Polled once per frame by the engine (`beginFrame`).\n99\t * - Pointer: accumulated movement per frame (while a button is held or the pointer is\n100\t *   locked), wheel delta per frame, optional pointer lock (first-person). Mouse buttons on\n101\t *   the canvas are keys too (`MOUSE_BUTTONS`: `MouseLeft`, `MouseRight`, `MouseMiddle`), and a\n102\t *   finger is `Touch` (`TOUCH_KEY`), held and pressed like any other, so a click shorter than\n103\t *   a frame is not lost.\n104\t * - Commands (`send`): data from outside the canvas, delivered to the game at the next frame\n105\t *   and recorded with it.\n106\t * - `dispose()` removes every listener it added.\n107\t */\n108\texport declare class Input {\n109\t    private readonly target;\n110\t    private readonly held;\n111\t    private readonly pressed;\n112\t    /** Queued presses → the game time they happened at. */\n113\t    private readonly queued;\n114\t    /** Keys held through gamepad buttons (merged into isDown). */\n115\t    private readonly padHeld;\n116\t    private readonly listeners;\n117\t    /** Pointer movement this frame, in CSS pixels (drag or pointer lock). */\n118\t    readonly mouseDelta: {\n119\t        x: number;\n120\t        y: number;\n121\t    };\n122\t    /**\n123\t     * Where the pointer last was over the canvas, in normalised device coordinates (−1..1, y up:\n124\t     * `camera.rayAt(pointer.x, pointer.y, …)` turns it into a ray), and whether it is over it now.\n125\t     * Under pointer lock it is the screen's centre (the crosshair).\n126\t     */\n127\t    readonly pointer: {\n128\t        x: number;\n129\t        y: number;\n130\t        over: boolean;\n131\t        touch: boolean;\n132\t    };\n133\t    /** Wheel ticks this frame (+1 = scroll down / zoom out). */\n134\t    wheel: number;\n135\t    /** This frame's button presses and releases, in order (`buttonEvents`). */\n136\t    private _buttonEvents;\n137\t    /** Commands sent since the last frame began, and this frame's (`send`, `commands`). */\n138\t    private outbox;\n139\t    private _commands;\n140\t    private lockTarget;\n141\t    /** When true, clicking the canvas requests pointer lock (first-person / free camera). */\n142\t    wantsPointerLock: boolean;\n143\t    /** Touch joystick, -1..1 per axis; overrides keys when active. */\n144\t    readonly analog: {\n145\t        x: number;\n146\t        y: number;\n147\t    };\n148\t    /** Gamepad left stick after the deadzone, -1..1 (y = forward). */\n149\t    readonly padAxis: {\n150\t        x: number;\n151\t        y: number;\n152\t    };\n153\t    /** True while any gamepad is connected. */\n154\t    gamepadConnected: boolean;\n155\t    /**\n156\t     * Extra key codes whose browser default is blocked (arrows and Space always are): a game's\n157\t     * own F1 / F2 / Tab panels, so the browser's help page or focus change doesn't fire.\n158\t     */\n159\t    readonly preventKeys: Set<string>;\n160\t    /** Gamepad button index → key code (defaults: GAMEPAD_BUTTONS). */\n161\t    gamepadButtons: Record<number, string>;\n162\t    /** Stick deadzone (radial, 0..1). */\n163\t    gamepadDeadzone: number;\n164\t    /** Right stick look speed: pointer pixels per second at full tilt. */\n165\t    gamepadLookSpeed: number;\n166\t    /** Game time (s) of the current frame; set by the engine through `beginFrame`. */\n167\t    now: number;\n168\t    /**\n169\t     * True while a replay drives input (`engine.replay()`): keyboard, pointer and wheel events,\n170\t     * `setKey` / `setPointer` / `setButtons` / `addPointer` (touch buttons, scripts) and `send`\n171\t     * are ignored, and `playBefore` / `playAfter` set everything.\n172\t     */\n173\t    get playing(): boolean;\n174\t    set playing(on: boolean);\n175\t    private _playing;\n176\t    private playedPad;\n177\t    /** Queued presses older than this many seconds of game time are dropped. */\n178\t    pressWindow: number;\n179\t    /** `target`: where keys are heard (the page's window); null listens to nothing (`Engine.headless`: input comes from `setKey`, `send`, a replay). */\n180\t    constructor(target?: Window | null);\n181\t    /**\n182\t     * Listen for pointer input on the game canvas. Only pointers that went down on the\n183\t     * canvas drive the camera (so a touch joystick doesn't orbit it). Two canvas touches\n184\t     * pinch to zoom (emitted as wheel ticks).\n185\t     */\n186\t    attachPointer(el: HTMLElement): void;\n187\t    /** Remove every listener this Input added (window and canvas). */\n188\t    dispose(): void;\n189\t    /** Let go of everything held (keys, gamepad buttons, sticks, pointer buttons); queued presses stay. */\n190\t    release(): void;\n191\t    /** Forget held keys, presses, sticks and pointer movement (e.g. when a level loads). */\n192\t    reset(): void;\n193\t    /**\n194\t     * Engine: begin a frame at game time `now` (seconds). Polls gamepads and drops expired\n195\t     * queued presses. `pads` defaults to `navigator.getGamepads()`; tests can pass fakes.\n196\t     */\n197\t    beginFrame(now: number, dt: number, pads?: readonly (GamepadLike | null)[]): void;\n198\t    get pointerLocked(): boolean;\n199\t    isDown(...codes: string[]): boolean;\n200\t    /** `isDown` for a list of codes, without building a rest-argument array (fixed-step code). */\n201\t    anyDown(codes: readonly string[]): boolean;\n202\t    /** True once per physical key press (valid for the current render frame). */\n203\t    wasPressed(...codes: string[]): boolean;\n204\t    /**\n205\t     * True once per physical key press, kept until consumed or until it is older than\n206\t     * `pressWindow` (150 ms of game time). Use from fixed-step code (which may run zero or\n207\t     * several times per frame) so no press is dropped, while a stale press (made during a\n208\t     * pause, a loading screen or a long hitch) never fires late.\n209\t     */\n210\t    consumePress(...codes: string[]): boolean;\n211\t    /** `consumePress` for a list of codes, without building a rest-argument array. */\n212\t    consumeAny(codes: readonly string[]): boolean;\n213\t    /** Held keys, queued presses and the pointer as data (`engine.snapshot()`), between frames. */\n214\t    state(): InputState;\n215\t    /** Back to `state()` at game time `now` (a restore): held keys are those the snapshot held, live ones let go. */\n216\t    setState(s: InputState, now: number): void;\n217\t    /** Presses waiting to be consumed (tooling / tests). */\n218\t    get queuedPresses(): string[];\n219\t    /** Drop queued presses (e.g. when a menu or mode swallows input). */\n220\t    clearQueued(...codes: string[]): void;\n221\t    /**\n222\t     * -1..1 on each axis (x = right, y = forward): the touch joystick or a gamepad's left\n223\t     * stick (whichever is tilted further), else WASD / arrow keys / d-pad.\n224\t     */\n225\t    moveAxis(): {\n226\t        x: number;\n227\t        y: number;\n228\t    };\n229\t    /** Call at the end of each rendered frame. */\n230\t    endFrame(): void;\n231\t    /** Test hook: simulate a key being held (true) or released (false). */\n232\t    setKey(code: string, down: boolean): void;\n233\t    /** Test hook: put the pointer at (x, y) in normalised device coordinates, pressed or not. */\n234\t    setPointer(x: number, y: number, down?: boolean): void;\n235\t    /** Test hook: hold mouse buttons (`PointerEvent.buttons` bits: 1 left, 2 right, 4 middle) as the canvas would. */\n236\t    setButtons(bits: number): void;\n237\t    /** Buttons held, as `PointerEvent.buttons` bits (1 left, 2 right, 4 middle; a finger is left): the same keys as `isDown('MouseLeft')`. */\n238\t    get mouseButtons(): number;\n239\t    /** A pointer button (a key code) goes down (pressed, unless held already) or up, where the pointer is. */\n240\t    private button;\n241\t    /**\n242\t     * This frame's pointer button presses and releases, in order, each with where the pointer\n243\t     * was: a drag shorter than a frame (a script's) still starts where it started and ends where\n244\t     * it ended. Recorded with the frame. UI that acts on clicks reads these; play reads `isDown`.\n245\t     */\n246\t    get buttonEvents(): readonly ButtonEvent[];\n247\t    /**\n248\t     * Hand the game data from outside the canvas: a DOM widget's value, a file the player picked,\n249\t     * a save read from storage, anything a game would otherwise take straight from the page. It\n250\t     * arrives in `commands` at the next frame the game runs, and the recording keeps it there, so\n251\t     * a replay delivers the same data at the same frame (and ignores what is sent live). It goes\n252\t     * through JSON first: live play reads exactly what a replay will.\n253\t     */\n254\t    send(command: unknown): void;\n255\t    /**\n256\t     * This frame's commands (`send`), oldest first; empty on most frames. They last one rendered\n257\t     * frame: read them in `update` (`fixedUpdate` runs zero or more times a frame).\n258\t     */\n259\t    get commands(): readonly unknown[];\n260\t    /** Engine: a live frame begins to run: what was sent since the last one becomes its `commands`. */\n261\t    deliver(): void;\n262\t    /** Test hook: inject pointer movement / wheel for the next frame. */\n263\t    addPointer(dx: number, dy: number, wheel?: number): void;\n264\t    /**\n265\t     * This frame's input as data (after `beginFrame`), for a recording. `last` is the frame\n266\t     * before: unchanged held keys, pointer and gamepad connection are left out.\n267\t     */\n268\t    snapshot(dt: number, last?: SnapshotMemory): InputFrame;\n269\t    /**\n270\t     * Replay, before the engine's `beginFrame`: the frame's held keys and presses (presses queue\n271\t     * at the time they would have arrived, the frame before's game time).\n272\t     */\n273\t    playBefore(f: InputFrame): void;\n274\t    /** Replay, after `beginFrame` (which polled no gamepads): sticks, pointer, wheel, gamepad connection. */\n275\t    playAfter(f: InputFrame): void;\n276\t    private press;\n277\t    private pollGamepads;\n278\t}\n279\t"}]},"parent_tool_use_id":null,"session_id":"4a882869-9e92-4155-a3b0-121d8fdc660c","uuid":"0513f9aa-9e44-42a6-847b-633257e97eb2","timestamp":"2026-11-05T04:21:15.146Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211959__x9a5b1d/work/_research/engine/x/pixel-engine/types/engine/input.d.ts","content":"/**\n * Standard-mapping gamepad buttons → the key codes they press (see character/controls.ts\n * KEYMAP). Change `input.gamepadButtons` to remap. Indices follow the W3C \"standard\" layout:\n * 0 A · 1 B · 2 X · 3 Y · 4 LB · 5 RB · 6 LT · 7 RT · 8 Back · 9 Start · 12–15 d-pad.\n */\nexport declare const GAMEPAD_BUTTONS: Readonly<Record<number, string>>;\n/** The parts of the Gamepad API that Input reads (tests can pass plain objects). */\nexport interface GamepadLike {\n    readonly connected?: boolean;\n    readonly mapping?: string;\n    readonly axes: readonly number[];\n    readonly buttons: readonly {\n        readonly pressed: boolean;\n        readonly value?: number;\n    }[];\n}\n/**\n * Radial deadzone with rescaling: inside `deadzone` reads 0, the rim reads 1, and the\n * direction is kept (no square-gate snapping to the axes).\n */\nexport declare function applyDeadzone(x: number, y: number, deadzone?: number): {\n    x: number;\n    y: number;\n};\n/** How long a queued press stays consumable, in seconds of game time. */\nexport declare const PRESS_WINDOW = 0.15;\n/**\n * What the game could read from input in one frame (a recorded frame, see src/engine/replay.ts).\n * Optional fields are left out when empty or zero; `held` and `pointer` also when unchanged\n * from the frame before.\n */\nexport interface InputFrame {\n    /** Real seconds this frame lasted (game time follows from it). */\n    dt: number;\n    /** Keys held, keyboard and gamepad buttons together, sorted. */\n    held?: string[];\n    /** Keys pressed since the frame before (a tap can be pressed and not held). */\n    pressed?: string[];\n    /** The touch joystick and the gamepad's left stick (after its deadzone). */\n    analog?: [number, number];\n    pad?: [number, number];\n    /** Pointer movement (CSS pixels) and wheel ticks this frame. */\n    delta?: [number, number];\n    wheel?: number;\n    /** Pointer position (normalised device coordinates), over the canvas (1/0), buttons (`mouseButtons`: what `held` says). */\n    pointer?: [number, number, number, number];\n    /** Whether a gamepad is connected (`gamepadConnected`), when that changes. */\n    gamepad?: boolean;\n    /** Whether the pointer is a touch (`pointer.touch`), when that changes. */\n    touch?: boolean;\n    /** Pointer buttons pressed (1) and let go (0) this frame, in order, each where the pointer was (`buttonEvents`). */\n    clicks?: [string, 0 | 1, number, number][];\n    /** Data from outside the canvas delivered this frame (`send()`): a DOM widget's value, a save read from storage. */\n    commands?: unknown[];\n    /**\n     * Ran in the same task as the frame before (frames of one `step(n)` call): no promise\n     * callbacks ran between them. A replay waits for them before every other frame.\n     */\n    sync?: true;\n}\n/** What input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer. */\nexport interface InputState {\n    readonly held: readonly string[];\n    /** Queued presses: [key, seconds of game time since it was pressed]. */\n    readonly queued: readonly (readonly [string, number])[];\n    readonly pointer: readonly [number, number, number, number];\n    readonly gamepad: boolean;\n    /** Data sent (`send`) and not yet delivered: the next frame that runs delivers it. */\n    readonly outbox: readonly unknown[];\n}\n/** What the frame before held, for `snapshot()` to leave out what did not change. */\nexport interface SnapshotMemory {\n    held: string;\n    pointer: string;\n    gamepad?: boolean;\n    touch?: boolean;\n}\n/**\n * Mouse buttons as key codes (`isDown('MouseLeft')`, `consumePress('MouseRight')`), each with\n * its `PointerEvent.buttons` bit, by `PointerEvent.button` (0 left, 1 middle, 2 right).\n */\nexport declare const MOUSE_BUTTONS: readonly (readonly [code: string, bit: number])[];\n/** A finger on the canvas, as a key: held while one is down (not a mouse button, so a tap is not a click). */\nexport declare const TOUCH_KEY = \"Touch\";\n/** A pointer button pressed or let go (`Input.buttonEvents`): its key, and where the pointer was (normalised device coordinates). */\nexport interface ButtonEvent {\n    readonly code: string;\n    readonly down: boolean;\n    readonly x: number;\n    readonly y: number;\n}\n/**\n * Keyboard + pointer + gamepad input.\n * - Keys: held state, per-frame presses (`wasPressed`) and queued presses for fixed-step\n *   code (`consumePress`). Queued presses expire after `pressWindow` s of game time.\n * - Gamepads (standard mapping): the left stick feeds `moveAxis()` (radial deadzone), the\n *   right stick feeds the pointer delta (camera look), buttons press key codes\n *   (`gamepadButtons`). Polled once per frame by the engine (`beginFrame`).\n * - Pointer: accumulated movement per frame (while a button is held or the pointer is\n *   locked), wheel delta per frame, optional pointer lock (first-person). Mouse buttons on\n *   the canvas are keys too (`MOUSE_BUTTONS`: `MouseLeft`, `MouseRight`, `MouseMiddle`), and a\n *   finger is `Touch` (`TOUCH_KEY`), held and pressed like any other, so a click shorter than\n *   a frame is not lost.\n * - Commands (`send`): data from outside the canvas, delivered to the game at the next frame\n *   and recorded with it.\n * - `dispose()` removes every listener it added.\n */\nexport declare class Input {\n    private readonly target;\n    private readonly held;\n    private readonly pressed;\n    /** Queued presses → the game time they happened at. */\n    private readonly queued;\n    /** Keys held through gamepad buttons (merged into isDown). */\n    private readonly padHeld;\n    private readonly listeners;\n    /** Pointer movement this frame, in CSS pixels (drag or pointer lock). */\n    readonly mouseDelta: {\n        x: number;\n        y: number;\n    };\n    /**\n     * Where the pointer last was over the canvas, in normalised device coordinates (−1..1, y up:\n     * `camera.rayAt(pointer.x, pointer.y, …)` turns it into a ray), and whether it is over it now.\n     * Under pointer lock it is the screen's centre (the crosshair).\n     */\n    readonly pointer: {\n        x: number;\n        y: number;\n        over: boolean;\n        touch: boolean;\n    };\n    /** Wheel ticks this frame (+1 = scroll down / zoom out). */\n    wheel: number;\n    /** This frame's button presses and releases, in order (`buttonEvents`). */\n    private _buttonEvents;\n    /** Commands sent since the last frame began, and this frame's (`send`, `commands`). */\n    private outbox;\n    private _commands;\n    private lockTarget;\n    /** When true, clicking the canvas requests pointer lock (first-person / free camera). */\n    wantsPointerLock: boolean;\n    /** Touch joystick, -1..1 per axis; overrides keys when active. */\n    readonly analog: {\n        x: number;\n        y: number;\n    };\n    /** Gamepad left stick after the deadzone, -1..1 (y = forward). */\n    readonly padAxis: {\n        x: number;\n        y: number;\n    };\n    /** True while any gamepad is connected. */\n    gamepadConnected: boolean;\n    /**\n     * Extra key codes whose browser default is blocked (arrows and Space always are): a game's\n     * own F1 / F2 / Tab panels, so the browser's help page or focus change doesn't fire.\n     */\n    readonly preventKeys: Set<string>;\n    /** Gamepad button index → key code (defaults: GAMEPAD_BUTTONS). */\n    gamepadButtons: Record<number, string>;\n    /** Stick deadzone (radial, 0..1). */\n    gamepadDeadzone: number;\n    /** Right stick look speed: pointer pixels per second at full tilt. */\n    gamepadLookSpeed: number;\n    /** Game time (s) of the current frame; set by the engine through `beginFrame`. */\n    now: number;\n    /**\n     * True while a replay drives input (`engine.replay()`): keyboard, pointer and wheel events,\n     * `setKey` / `setPointer` / `setButtons` / `addPointer` (touch buttons, scripts) and `send`\n     * are ignored, and `playBefore` / `playAfter` set everything.\n     */\n    get playing(): boolean;\n    set playing(on: boolean);\n    private _playing;\n    private playedPad;\n    /** Queued presses older than this many seconds of game time are dropped. */\n    pressWindow: number;\n    /** `target`: where keys are heard (the page's window); null listens to nothing (`Engine.headless`: input comes from `setKey`, `send`, a replay). */\n    constructor(target?: Window | null);\n    /**\n     * Listen for pointer input on the game canvas. Only pointers that went down on the\n     * canvas drive the camera (so a touch joystick doesn't orbit it). Two canvas touches\n     * pinch to zoom (emitted as wheel ticks).\n     */\n    attachPointer(el: HTMLElement): void;\n    /** Remove every listener this Input added (window and canvas). */\n    dispose(): void;\n    /** Let go of everything held (keys, gamepad buttons, sticks, pointer buttons); queued presses stay. */\n    release(): void;\n    /** Forget held keys, presses, sticks and pointer movement (e.g. when a level loads). */\n    reset(): void;\n    /**\n     * Engine: begin a frame at game time `now` (seconds). Polls gamepads and drops expired\n     * queued presses. `pads` defaults to `navigator.getGamepads()`; tests can pass fakes.\n     */\n    beginFrame(now: number, dt: number, pads?: readonly (GamepadLike | null)[]): void;\n    get pointerLocked(): boolean;\n    isDown(...codes: string[]): boolean;\n    /** `isDown` for a list of codes, without building a rest-argument array (fixed-step code). */\n    anyDown(codes: readonly string[]): boolean;\n    /** True once per physical key press (valid for the current render frame). */\n    wasPressed(...codes: string[]): boolean;\n    /**\n     * True once per physical key press, kept until consumed or until it is older than\n     * `pressWindow` (150 ms of game time). Use from fixed-step code (which may run zero or\n     * several times per frame) so no press is dropped, while a stale press (made during a\n     * pause, a loading screen or a long hitch) never fires late.\n     */\n    consumePress(...codes: string[]): boolean;\n    /** `consumePress` for a list of codes, without building a rest-argument array. */\n    consumeAny(codes: readonly string[]): boolean;\n    /** Held keys, queued presses and the pointer as data (`engine.snapshot()`), between frames. */\n    state(): InputState;\n    /** Back to `state()` at game time `now` (a restore): held keys are those the snapshot held, live ones let go. */\n    setState(s: InputState, now: number): void;\n    /** Presses waiting to be consumed (tooling / tests). */\n    get queuedPresses(): string[];\n    /** Drop queued presses (e.g. when a menu or mode swallows input). */\n    clearQueued(...codes: string[]): void;\n    /**\n     * -1..1 on each axis (x = right, y = forward): the touch joystick or a gamepad's left\n     * stick (whichever is tilted further), else WASD / arrow keys / d-pad.\n     */\n    moveAxis(): {\n        x: number;\n        y: number;\n    };\n    /** Call at the end of each rendered frame. */\n    endFrame(): void;\n    /** Test hook: simulate a key being held (true) or released (false). */\n    setKey(code: string, down: boolean): void;\n    /** Test hook: put the pointer at (x, y) in normalised device coordinates, pressed or not. */\n    setPointer(x: number, y: number, down?: boolean): void;\n    /** Test hook: hold mouse buttons (`PointerEvent.buttons` bits: 1 left, 2 right, 4 middle) as the canvas would. */\n    setButtons(bits: number): void;\n    /** Buttons held, as `PointerEvent.buttons` bits (1 left, 2 right, 4 middle; a finger is left): the same keys as `isDown('MouseLeft')`. */\n    get mouseButtons(): number;\n    /** A pointer button (a key code) goes down (pressed, unless held already) or up, where the pointer is. */\n    private button;\n    /**\n     * This frame's pointer button presses and releases, in order, each with where the pointer\n     * was: a drag shorter than a frame (a script's) still starts where it started and ends where\n     * it ended. Recorded with the frame. UI that acts on clicks reads these; play reads `isDown`.\n     */\n    get buttonEvents(): readonly ButtonEvent[];\n    /**\n     * Hand the game data from outside the canvas: a DOM widget's value, a file the player picked,\n     * a save read from storage, anything a game would otherwise take straight from the page. It\n     * arrives in `commands` at the next frame the game runs, and the recording keeps it there, so\n     * a replay delivers the same data at the same frame (and ignores what is sent live). It goes\n     * through JSON first: live play reads exactly what a replay will.\n     */\n    send(command: unknown): void;\n    /**\n     * This frame's commands (`send`), oldest first; empty on most frames. They last one rendered\n     * frame: read them in `update` (`fixedUpdate` runs zero or more times a frame).\n     */\n    get commands(): readonly unknown[];\n    /** Engine: a live frame begins to run: what was sent since the last one becomes its `commands`. */\n    deliver(): void;\n    /** Test hook: inject pointer movement / wheel for the next frame. */\n    addPointer(dx: number, dy: number, wheel?: number): void;\n    /**\n     * This frame's input as data (after `beginFrame`), for a recording. `last` is the frame\n     * before: unchanged held keys, pointer and gamepad connection are left out.\n     */\n    snapshot(dt: number, last?: SnapshotMemory): InputFrame;\n    /**\n     * Replay, before the engine's `beginFrame`: the frame's held keys and presses (presses queue\n     * at the time they would have arrived, the frame before's game time).\n     */\n    playBefore(f: InputFrame): void;\n    /** Replay, after `beginFrame` (which polled no gamepads): sticks, pointer, wheel, gamepad connection. */\n    playAfter(f: InputFrame): void;\n    private press;\n    private pollGamepads;\n}\n","numLines":279,"startLine":1,"totalLines":279}},"tool_result_meta":[{"id":"toolu_018YuwR4eW5mGkk3dhogMBU8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj96RC7uKk3atMDTByWf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019xMLnKLvBW9atcFHJTD8it","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211959__x9a5b1d/work/_research/engine/x/pixel-engine/types/engine/camera.d.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":45740,"cache_read_input_tokens":73333,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":45740},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4a882869-9e92-4155-a3b0-121d8fdc660c","uuid":"b4ce35e3-2a69-4d23-ae6e-44c2ecbdaf53","timestamp":"2026-11-05T04:21:16.517Z","request_id":"req_011Cgj96QwEYsnJz9t2VhQaN","wire_tool_inputs":{"toolu_019xMLnKLvBW9atcFHJTD8it":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211959__x9a5b1d/work/_research/engine/x/pixel-engine/types/engine/camera.d.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019xMLnKLvBW9atcFHJTD8it","type":"tool_result","content":"1\timport { type Camera, OrthographicCamera, PerspectiveCamera, Vector3 } from 'three/webgpu';\n2\timport { type Resolution } from './framing';\n3\timport type { Input } from './input';\n4\t/**\n5\t * Camera presets. A game picks ONE at startup (EngineOptions.camera / `?camera=`). For\n6\t * reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\n7\t * is an authoring tool: fly around, press Enter to fix the view, and paste the printed\n8\t * `fixed` config into your game.\n9\t */\n10\texport type CameraPreset = 'iso' | 'topdown' | 'side' | 'third' | 'first' | 'free' | 'fixed';\n11\texport declare const CAMERA_PRESETS: readonly CameraPreset[];\n12\texport interface CameraConfig {\n13\t    preset?: CameraPreset;\n14\t    /** Zoom factor, 1 = preset default, >1 = closer. Ignored by `first`. */\n15\t    zoom?: number;\n16\t    minZoom?: number;\n17\t    maxZoom?: number;\n18\t    /** Ortho presets: visible world height at zoom 1. */\n19\t    viewHeight?: number;\n20\t    /** iso: degrees below horizon / around Y. */\n21\t    pitch?: number;\n22\t    yaw?: number;\n23\t    /** Perspective presets: vertical field of view in degrees. */\n24\t    fov?: number;\n25\t    /** third: orbit distance at zoom 1. */\n26\t    distance?: number;\n27\t    /** fixed: camera position and look-at target. */\n28\t    position?: [number, number, number];\n29\t    target?: [number, number, number];\n30\t    /** fixed/free: projection. */\n31\t    projection?: 'perspective' | 'ortho';\n32\t    /** Follow smoothing; higher is snappier. */\n33\t    stiffness?: number;\n34\t}\n35\t/** What rigs may ask of the world (e.g. third-person wall avoidance). */\n36\texport interface CameraWorld {\n37\t    /** Distance from `from` along `dir` to the first obstacle, or null. */\n38\t    raycast?(from: Vector3, dir: Vector3, maxDistance: number): number | null;\n39\t}\n40\texport interface CameraUpdate {\n41\t    /** Point to follow (character center/chest). */\n42\t    target: Vector3;\n43\t    /** First-person eye point. */\n44\t    eye: Vector3;\n45\t    dt: number;\n46\t    resolution: Resolution;\n47\t    input: Input;\n48\t    world: CameraWorld;\n49\t    /**\n50\t     * Screen shake: added to the camera's position after the rig placed it (the engine's\n51\t     * `CameraShake`). Ortho rigs move it by whole art pixels.\n52\t     */\n53\t    shake?: Vector3;\n54\t}\n55\t/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\n56\texport interface CameraRigState {\n57\t    readonly preset: CameraPreset;\n58\t    readonly focus: readonly number[];\n59\t    readonly zoom: number;\n60\t    readonly aspect: number;\n61\t    readonly position: readonly number[];\n62\t    readonly quaternion: readonly number[];\n63\t    readonly shaken: readonly number[];\n64\t    /** What a preset keeps of its own (an orbit's yaw, pitch and distance). */\n65\t    readonly own: Readonly<Record<string, number>>;\n66\t}\n67\t/** Base rig: owns the three.js camera, zoom and the ground-plane movement basis. */\n68\texport declare abstract class CameraRig {\n69\t    abstract readonly preset: CameraPreset;\n70\t    abstract readonly camera: OrthographicCamera | PerspectiveCamera;\n71\t    /** World point the rig is centred on (used for shadow framing). */\n72\t    readonly focus: Vector3;\n73\t    zoom: number;\n74\t    readonly minZoom: number;\n75\t    readonly maxZoom: number;\n76\t    /** Whether zoom applies (all presets except first person). */\n77\t    readonly zoomable: boolean;\n78\t    /** First person hides the player model. */\n79\t    readonly hidesTarget: boolean;\n80\t    /** Side-scroller: characters should stay on their depth lane. */\n81\t    readonly lockDepth: boolean;\n82\t    /** False while the free camera is flying (input drives the camera, not the player). */\n83\t    controlsCharacter: boolean;\n84\t    /** Pixel-snap the camera (ortho only). */\n85\t    snap: boolean;\n86\t    /** Viewport aspect (width / height), following the art resolution (see `setAspect`). */\n87\t    aspect: number;\n88\t    protected readonly stiffness: number;\n89\t    constructor(config: CameraConfig);\n90\t    /**\n91\t     * The ray through screen point (x, y) in normalised device coordinates (−1..1, y up, as\n92\t     * `input.pointer` gives them): where it starts (on the near plane) and its unit direction.\n93\t     * For picking things with the mouse, or aiming at it. An orthographic rig stands far back from\n94\t     * what it frames (over a hundred metres for iso), so its rays start far from the scene: cast\n95\t     * them long (hundreds of metres).\n96\t     */\n97\t    rayAt(x: number, y: number, origin: Vector3, dir: Vector3): void;\n98\t    setZoom(zoom: number): void;\n99\t    /**\n100\t     * Match the art resolution's aspect (adaptive framing changes it with the screen).\n101\t     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n102\t     */\n103\t    setAspect(aspect: number): void;\n104\t    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n105\t    protected abstract applyZoom(): void;\n106\t    /** Place the camera without smoothing. */\n107\t    teleport(target: Vector3): void;\n108\t    /** Screen-relative movement basis on the ground plane. */\n109\t    groundBasis(): {\n110\t        right: Vector3;\n111\t        forward: Vector3;\n112\t    };\n113\t    update(u: CameraUpdate): void;\n114\t    protected abstract step(u: CameraUpdate): void;\n115\t    /** The shake offset actually applied this frame (zero when still). */\n116\t    private readonly shaken;\n117\t    /** The offset a shake moves the placed camera by (into `out`). */\n118\t    protected shakeOffset(offset: Vector3, out: Vector3): void;\n119\t    /** Serializable description (debug UI, `state()`). */\n120\t    describe(): Record<string, unknown>;\n121\t    /** The rig as data, exact (`engine.snapshot()`). */\n122\t    state(): CameraRigState;\n123\t    /** Put the rig back where `state()` found it (the same preset). */\n124\t    setState(s: CameraRigState): void;\n125\t    /** What a preset keeps beyond the base (`state()`). */\n126\t    protected ownState(): Record<string, number>;\n127\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n128\t    protected follow(target: Vector3, dt: number): void;\n129\t}\n130\t/** Orthographic presets: classic 3/4 isometric, straight top-down, straight side-on. */\n131\texport declare class OrthoRig extends CameraRig {\n132\t    readonly camera: OrthographicCamera;\n133\t    readonly preset: 'iso' | 'topdown' | 'side';\n134\t    readonly lockDepth: boolean;\n135\t    readonly baseViewHeight: number;\n136\t    private readonly offset;\n137\t    private readonly right;\n138\t    private readonly up;\n139\t    private readonly forward;\n140\t    private readonly tmp;\n141\t    /** World units per art pixel at the last update. */\n142\t    private pixel;\n143\t    protected ownState(): Record<string, number>;\n144\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n145\t    constructor(preset: 'iso' | 'topdown' | 'side', config?: CameraConfig);\n146\t    get viewHeight(): number;\n147\t    protected applyZoom(): void;\n148\t    protected step(u: CameraUpdate): void;\n149\t    /** Shake by whole art pixels across the view (depth doesn't move an ortho picture). */\n150\t    protected shakeOffset(offset: Vector3, out: Vector3): void;\n151\t}\n152\t/** Over-the-shoulder orbit camera: mouse-drag or Q/E to orbit, wheel to zoom, avoids walls. */\n153\texport declare class ThirdPersonRig extends CameraRig {\n154\t    readonly preset: \"third\";\n155\t    readonly camera: PerspectiveCamera;\n156\t    yaw: number;\n157\t    pitch: number;\n158\t    private readonly baseDistance;\n159\t    private currentDistance;\n160\t    protected ownState(): Record<string, number>;\n161\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n162\t    constructor(config?: CameraConfig);\n163\t    protected applyZoom(): void;\n164\t    protected step(u: CameraUpdate): void;\n165\t    describe(): {\n166\t        yaw: number;\n167\t        pitch: number;\n168\t    };\n169\t}\n170\t/** Eyes of the character: mouse look (click to lock the pointer) or Q/E to turn. No zoom. */\n171\texport declare class FirstPersonRig extends CameraRig {\n172\t    readonly preset: \"first\";\n173\t    readonly camera: PerspectiveCamera;\n174\t    readonly zoomable = false;\n175\t    readonly hidesTarget = true;\n176\t    yaw: number;\n177\t    pitch: number;\n178\t    protected ownState(): Record<string, number>;\n179\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n180\t    constructor(config?: CameraConfig);\n181\t    protected applyZoom(): void;\n182\t    protected step(u: CameraUpdate): void;\n183\t    groundBasis(): {\n184\t        right: Vector3;\n185\t        forward: Vector3;\n186\t    };\n187\t    describe(): {\n188\t        yaw: number;\n189\t        pitch: number;\n190\t    };\n191\t}\n192\t/**\n193\t * Authoring camera. While flying: WASD move, Q/E down/up, drag (or click to lock) to look,\n194\t * Shift = fast, wheel = field of view. Press Enter to fix it: the view freezes, the player\n195\t * gets control, and `fixedConfig()` returns the config to hard-code (preset 'fixed').\n196\t * Enter again unfixes.\n197\t */\n198\texport declare class FreeRig extends CameraRig {\n199\t    readonly preset: 'free' | 'fixed';\n200\t    readonly camera: PerspectiveCamera | OrthographicCamera;\n201\t    fixed: boolean;\n202\t    yaw: number;\n203\t    pitch: number;\n204\t    protected ownState(): Record<string, number>;\n205\t    protected setOwnState(own: Readonly<Record<string, number>>): void;\n206\t    private readonly baseFov;\n207\t    private readonly baseViewHeight;\n208\t    private readonly projection;\n209\t    onFix: ((config: CameraConfig) => void) | null;\n210\t    constructor(preset: 'free' | 'fixed', config?: CameraConfig);\n211\t    protected applyZoom(): void;\n212\t    /** Freeze (or unfreeze) the view. */\n213\t    setFixed(fixed: boolean): void;\n214\t    fixedConfig(): CameraConfig;\n215\t    protected step(u: CameraUpdate): void;\n216\t    describe(): {\n217\t        fixed: boolean;\n218\t        config: CameraConfig;\n219\t    };\n220\t}\n221\texport declare function createCameraRig(config?: CameraConfig): CameraRig;\n222\texport declare function isPerspective(camera: Camera): camera is PerspectiveCamera;\n223\t"}]},"parent_tool_use_id":null,"session_id":"4a882869-9e92-4155-a3b0-121d8fdc660c","uuid":"b78db897-b3f3-474b-98ff-2e0d095518a6","timestamp":"2026-11-05T04:21:16.541Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211959__x9a5b1d/work/_research/engine/x/pixel-engine/types/engine/camera.d.ts","content":"import { type Camera, OrthographicCamera, PerspectiveCamera, Vector3 } from 'three/webgpu';\nimport { type Resolution } from './framing';\nimport type { Input } from './input';\n/**\n * Camera presets. A game picks ONE at startup (EngineOptions.camera / `?camera=`). For\n * reviewing, `engine.setCamera()` swaps presets live without touching the world. `free`\n * is an authoring tool: fly around, press Enter to fix the view, and paste the printed\n * `fixed` config into your game.\n */\nexport type CameraPreset = 'iso' | 'topdown' | 'side' | 'third' | 'first' | 'free' | 'fixed';\nexport declare const CAMERA_PRESETS: readonly CameraPreset[];\nexport interface CameraConfig {\n    preset?: CameraPreset;\n    /** Zoom factor, 1 = preset default, >1 = closer. Ignored by `first`. */\n    zoom?: number;\n    minZoom?: number;\n    maxZoom?: number;\n    /** Ortho presets: visible world height at zoom 1. */\n    viewHeight?: number;\n    /** iso: degrees below horizon / around Y. */\n    pitch?: number;\n    yaw?: number;\n    /** Perspective presets: vertical field of view in degrees. */\n    fov?: number;\n    /** third: orbit distance at zoom 1. */\n    distance?: number;\n    /** fixed: camera position and look-at target. */\n    position?: [number, number, number];\n    target?: [number, number, number];\n    /** fixed/free: projection. */\n    projection?: 'perspective' | 'ortho';\n    /** Follow smoothing; higher is snappier. */\n    stiffness?: number;\n}\n/** What rigs may ask of the world (e.g. third-person wall avoidance). */\nexport interface CameraWorld {\n    /** Distance from `from` along `dir` to the first obstacle, or null. */\n    raycast?(from: Vector3, dir: Vector3, maxDistance: number): number | null;\n}\nexport interface CameraUpdate {\n    /** Point to follow (character center/chest). */\n    target: Vector3;\n    /** First-person eye point. */\n    eye: Vector3;\n    dt: number;\n    resolution: Resolution;\n    input: Input;\n    world: CameraWorld;\n    /**\n     * Screen shake: added to the camera's position after the rig placed it (the engine's\n     * `CameraShake`). Ortho rigs move it by whole art pixels.\n     */\n    shake?: Vector3;\n}\n/** Where a rig is and looks, as data (`engine.snapshot()`): the frame after a restore sees the camera the frame after the snapshot did. */\nexport interface CameraRigState {\n    readonly preset: CameraPreset;\n    readonly focus: readonly number[];\n    readonly zoom: number;\n    readonly aspect: number;\n    readonly position: readonly number[];\n    readonly quaternion: readonly number[];\n    readonly shaken: readonly number[];\n    /** What a preset keeps of its own (an orbit's yaw, pitch and distance). */\n    readonly own: Readonly<Record<string, number>>;\n}\n/** Base rig: owns the three.js camera, zoom and the ground-plane movement basis. */\nexport declare abstract class CameraRig {\n    abstract readonly preset: CameraPreset;\n    abstract readonly camera: OrthographicCamera | PerspectiveCamera;\n    /** World point the rig is centred on (used for shadow framing). */\n    readonly focus: Vector3;\n    zoom: number;\n    readonly minZoom: number;\n    readonly maxZoom: number;\n    /** Whether zoom applies (all presets except first person). */\n    readonly zoomable: boolean;\n    /** First person hides the player model. */\n    readonly hidesTarget: boolean;\n    /** Side-scroller: characters should stay on their depth lane. */\n    readonly lockDepth: boolean;\n    /** False while the free camera is flying (input drives the camera, not the player). */\n    controlsCharacter: boolean;\n    /** Pixel-snap the camera (ortho only). */\n    snap: boolean;\n    /** Viewport aspect (width / height), following the art resolution (see `setAspect`). */\n    aspect: number;\n    protected readonly stiffness: number;\n    constructor(config: CameraConfig);\n    /**\n     * The ray through screen point (x, y) in normalised device coordinates (−1..1, y up, as\n     * `input.pointer` gives them): where it starts (on the near plane) and its unit direction.\n     * For picking things with the mouse, or aiming at it. An orthographic rig stands far back from\n     * what it frames (over a hundred metres for iso), so its rays start far from the scene: cast\n     * them long (hundreds of metres).\n     */\n    rayAt(x: number, y: number, origin: Vector3, dir: Vector3): void;\n    setZoom(zoom: number): void;\n    /**\n     * Match the art resolution's aspect (adaptive framing changes it with the screen).\n     * `update()` calls this from `CameraUpdate.resolution`; the engine also calls it on swap.\n     */\n    setAspect(aspect: number): void;\n    /** Called once after construction and whenever zoom (or the aspect of an ortho camera) changes. */\n    protected abstract applyZoom(): void;\n    /** Place the camera without smoothing. */\n    teleport(target: Vector3): void;\n    /** Screen-relative movement basis on the ground plane. */\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    update(u: CameraUpdate): void;\n    protected abstract step(u: CameraUpdate): void;\n    /** The shake offset actually applied this frame (zero when still). */\n    private readonly shaken;\n    /** The offset a shake moves the placed camera by (into `out`). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n    /** Serializable description (debug UI, `state()`). */\n    describe(): Record<string, unknown>;\n    /** The rig as data, exact (`engine.snapshot()`). */\n    state(): CameraRigState;\n    /** Put the rig back where `state()` found it (the same preset). */\n    setState(s: CameraRigState): void;\n    /** What a preset keeps beyond the base (`state()`). */\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    protected follow(target: Vector3, dt: number): void;\n}\n/** Orthographic presets: classic 3/4 isometric, straight top-down, straight side-on. */\nexport declare class OrthoRig extends CameraRig {\n    readonly camera: OrthographicCamera;\n    readonly preset: 'iso' | 'topdown' | 'side';\n    readonly lockDepth: boolean;\n    readonly baseViewHeight: number;\n    private readonly offset;\n    private readonly right;\n    private readonly up;\n    private readonly forward;\n    private readonly tmp;\n    /** World units per art pixel at the last update. */\n    private pixel;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(preset: 'iso' | 'topdown' | 'side', config?: CameraConfig);\n    get viewHeight(): number;\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    /** Shake by whole art pixels across the view (depth doesn't move an ortho picture). */\n    protected shakeOffset(offset: Vector3, out: Vector3): void;\n}\n/** Over-the-shoulder orbit camera: mouse-drag or Q/E to orbit, wheel to zoom, avoids walls. */\nexport declare class ThirdPersonRig extends CameraRig {\n    readonly preset: \"third\";\n    readonly camera: PerspectiveCamera;\n    yaw: number;\n    pitch: number;\n    private readonly baseDistance;\n    private currentDistance;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/** Eyes of the character: mouse look (click to lock the pointer) or Q/E to turn. No zoom. */\nexport declare class FirstPersonRig extends CameraRig {\n    readonly preset: \"first\";\n    readonly camera: PerspectiveCamera;\n    readonly zoomable = false;\n    readonly hidesTarget = true;\n    yaw: number;\n    pitch: number;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    constructor(config?: CameraConfig);\n    protected applyZoom(): void;\n    protected step(u: CameraUpdate): void;\n    groundBasis(): {\n        right: Vector3;\n        forward: Vector3;\n    };\n    describe(): {\n        yaw: number;\n        pitch: number;\n    };\n}\n/**\n * Authoring camera. While flying: WASD move, Q/E down/up, drag (or click to lock) to look,\n * Shift = fast, wheel = field of view. Press Enter to fix it: the view freezes, the player\n * gets control, and `fixedConfig()` returns the config to hard-code (preset 'fixed').\n * Enter again unfixes.\n */\nexport declare class FreeRig extends CameraRig {\n    readonly preset: 'free' | 'fixed';\n    readonly camera: PerspectiveCamera | OrthographicCamera;\n    fixed: boolean;\n    yaw: number;\n    pitch: number;\n    protected ownState(): Record<string, number>;\n    protected setOwnState(own: Readonly<Record<string, number>>): void;\n    private readonly baseFov;\n    private readonly baseViewHeight;\n    private readonly projection;\n    onFix: ((config: CameraConfig) => void) | null;\n    constructor(preset: 'free' | 'fixed', config?: CameraConfig);\n    protected applyZoom(): void;\n    /** Freeze (or unfreeze) the view. */\n    setFixed(fixed: boolean): void;\n    fixedConfig(): CameraConfig;\n    protected step(u: CameraUpdate): void;\n    describe(): {\n        fixed: boolean;\n        config: CameraConfig;\n    };\n}\nexport declare function createCameraRig(config?: CameraConfig): CameraRig;\nexport declare function isPerspective(camera: Camera): camera is PerspectiveCamera;\n","numLines":223,"startLine":1,"totalLines":223}},"tool_result_meta":[{"id":"toolu_019xMLnKLvBW9atcFHJTD8it","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj96RC7uKk3atMDTByWf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Mp3FLNoA8EB4PkJi6QB7RX","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211959__x9a5b1d/work/_research/engine/x/pixel-engine/types/engine/animation/types.d.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":45740,"cache_read_input_tokens":73333,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":45740},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4a882869-9e92-4155-a3b0-121d8fdc660c","uuid":"9c418f90-46ef-45b8-a322-72889fcc99e8","timestamp":"2026-11-05T04:21:17.843Z","request_id":"req_011Cgj96QwEYsnJz9t2VhQaN","wire_tool_inputs":{"toolu_01Mp3FLNoA8EB4PkJi6QB7RX":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211959__x9a5b1d/work/_research/engine/x/pixel-engine/types/engine/animation/types.d.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mp3FLNoA8EB4PkJi6QB7RX","type":"tool_result","content":"1\t/**\n2\t * Animation authoring format — designed to be written and edited by AI agents (and\n3\t * humans) as plain data. See docs/ANIMATION.md for the workflow.\n4\t *\n5\t * - Time is in FRAMES at 30 fps (Mario 64's rate). `frames: 24` = 0.8 s.\n6\t * - Rotations are Euler XYZ in DEGREES, relative to the joint's rest orientation.\n7\t *   Values interpolate per axis, so a full flip is simply `[360, 0, 0]`.\n8\t * - A key's pose is a FULL pose: any joint not listed is at rest (0,0,0). Build poses by\n9\t *   spreading shared poses: `{ ...CROUCH, Head: [10, 0, 0] }`.\n10\t * - Root motion lives in the Pelvis: `p` is an OFFSET from its rest position (metres),\n11\t *   `s` is scale (squash & stretch). Only Pelvis and Head may scale.\n12\t */\n13\texport type Euler = [number, number, number];\n14\texport type Vec3 = [number, number, number];\n15\texport interface JointPose {\n16\t    /** Rotation, degrees XYZ. */\n17\t    r?: Euler;\n18\t    /** Position offset from rest, metres (Pelvis only in practice). */\n19\t    p?: Vec3;\n20\t    /** Scale: uniform number or per-axis. 1 = rest. */\n21\t    s?: number | Vec3;\n22\t}\n23\t/** Joint name → rotation (degrees) or full joint pose. Missing joints are at rest. */\n24\texport type Pose = Readonly<Record<string, Euler | JointPose>>;\n25\texport type Ease = 'linear'\n26\t/** accelerate */\n27\t | 'in'\n28\t/** decelerate */\n29\t | 'out'\n30\t/** smooth start and stop (default) */\n31\t | 'inOut'\n32\t/** hold this pose until the next key, then snap */\n33\t | 'hold'\n34\t/** pull back before moving (anticipation) */\n35\t | 'inBack'\n36\t/** overshoot and settle (follow-through) */\n37\t | 'outBack';\n38\t/** `[frame, pose, easeToNextKey?]` */\n39\texport type Key = readonly [number, Pose, Ease?];\n40\t/** Additive sine wave on one channel — breathing, bobbing, idle sway. */\n41\texport interface Layer {\n42\t    joint: string;\n43\t    /** rx/ry/rz in degrees, px/py/pz in metres, s = uniform scale delta. */\n44\t    channel: 'rx' | 'ry' | 'rz' | 'px' | 'py' | 'pz' | 's';\n45\t    amplitude: number;\n46\t    /** Frames per cycle. For looping clips it must divide `frames`. */\n47\t    period: number;\n48\t    /** 0..1 fraction of a cycle. */\n49\t    phase?: number;\n50\t}\n51\t/** Where the feet should be (foot IK goals; see ik.ts). A missing side is left as keyed. */\n52\texport interface FeetGoals {\n53\t    R?: FootGoalDef;\n54\t    L?: FootGoalDef;\n55\t}\n56\t/** Same shape as ik.ts `FootGoal` (kept here so types.ts has no imports). */\n57\texport interface FootGoalDef {\n58\t    z: number;\n59\t    x?: number;\n60\t    y?: number;\n61\t    pitch?: number;\n62\t    pivot?: 'heel' | 'ball' | 'ankle';\n63\t    follow?: number;\n64\t    relax?: number;\n65\t}\n66\t/** `[frame, goals, easeToNextKey?]` */\n67\texport type FeetKey = readonly [number, FeetGoals, Ease?];\n68\texport interface ClipDef {\n69\t    name: string;\n70\t    /** Length in frames at 30 fps. */\n71\t    frames: number;\n72\t    loop?: boolean;\n73\t    keys: readonly Key[];\n74\t    layers?: readonly Layer[];\n75\t    /**\n76\t     * Feet track: foot goals interpolated between its own keys and solved with IK every\n77\t     * frame, overriding the keyed leg rotations. Use it whenever feet touch the floor\n78\t     * through a transition (kneel → stand, sit → lie) so they roll instead of sinking.\n79\t     */\n80\t    feet?: readonly FeetKey[];\n81\t    /**\n82\t     * Ground speed (m/s) the clip is authored for at playback rate 1. Locomotion clips set\n83\t     * this; metrics then measure foot sliding against it and the runtime can scale playback.\n84\t     */\n85\t    speed?: number;\n86\t    /**\n87\t     * Gait cycles (gaitClip): the share of the cycle each foot is planted. The right heel\n88\t     * strikes at phase 0, the left at 0.5, so the right foot is mid-stance at `stance / 2`.\n89\t     */\n90\t    stance?: number;\n91\t    /** Gaits: how far ahead of the hips (m) the middle of the stance is (feet touch down `reach` + half a stance's ground ahead). */\n92\t    reach?: number;\n93\t    /** Grounded clip: soles should rest on y = 0 (metrics flag floating / penetration). */\n94\t    grounded?: boolean;\n95\t    /** Intentionally snappy (flips, punches, launches): skip the angular-speed warning. */\n96\t    fast?: boolean;\n97\t    notes?: string;\n98\t}\n99\texport interface JointLimit {\n100\t    x?: [number, number];\n101\t    y?: [number, number];\n102\t    z?: [number, number];\n103\t}\n104\t/** One leg's joints, hip → knee → ankle, bending about X (knee forward). */\n105\texport interface LegJoints {\n106\t    upper: string;\n107\t    lower: string;\n108\t    foot: string;\n109\t    /** Hip joint position in the root (pelvis) joint's space. */\n110\t    hip: Vec3;\n111\t}\n112\t/** Leg geometry for foot-placement IK (`placeFeet`, `gaitClip`). Lengths in metres. */\n113\texport interface LegRig {\n114\t    R: LegJoints;\n115\t    L: LegJoints;\n116\t    /** Root (pelvis) joint height above the ground at rest. */\n117\t    rootHeight: number;\n118\t    /** Hip → knee. */\n119\t    upper: number;\n120\t    /** Knee → ankle. */\n121\t    lower: number;\n122\t    /** Ankle height above the sole when the foot is flat. */\n123\t    ankle: number;\n124\t    /** Heel contact point, metres behind the ankle. */\n125\t    heel: number;\n126\t    /** Toe tip contact point, metres ahead of the ankle. */\n127\t    ball: number;\n128\t    /** Top of the shoe above the ankle (m), for swing clearance when the foot tips over. */\n129\t    top?: number;\n130\t}\n131\t/** Everything the tools need to know about a rig beyond its hierarchy. */\n132\texport interface RigSpec {\n133\t    /** Joint names in hierarchy order (root first). */\n134\t    joints: readonly string[];\n135\t    root: string;\n136\t    /** Left/right counterparts for mirroring. */\n137\t    mirror: Readonly<Record<string, string>>;\n138\t    /** Mesh names that touch the ground (soles). */\n139\t    soles: readonly string[];\n140\t    /** Points to trace in contact sheets (joint or mesh names). */\n141\t    trace: readonly string[];\n142\t    /** Human-plausible rotation ranges, degrees. */\n143\t    limits: Readonly<Record<string, JointLimit>>;\n144\t    /** Frame rate of the authoring format. */\n145\t    fps: number;\n146\t    /** Leg geometry, enabling foot IK and the gait generator. */\n147\t    legs?: LegRig;\n148\t    /**\n149\t     * Joints the runtime procedural layers turn (PoseLayers): the torso and head look where\n150\t     * the character is going; `cap` is an optional springy joint (not animated by clips).\n151\t     */\n152\t    spine?: {\n153\t        torso?: string;\n154\t        head?: string;\n155\t        cap?: string;\n156\t    };\n157\t}\n158\t"}]},"parent_tool_use_id":null,"session_id":"4a882869-9e92-4155-a3b0-121d8fdc660c","uuid":"6aafeb1d-1929-4417-80c3-ecee38ed482b","timestamp":"2026-11-05T04:21:17.851Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211959__x9a5b1d/work/_research/engine/x/pixel-engine/types/engine/animation/types.d.ts","content":"/**\n * Animation authoring format — designed to be written and edited by AI agents (and\n * humans) as plain data. See docs/ANIMATION.md for the workflow.\n *\n * - Time is in FRAMES at 30 fps (Mario 64's rate). `frames: 24` = 0.8 s.\n * - Rotations are Euler XYZ in DEGREES, relative to the joint's rest orientation.\n *   Values interpolate per axis, so a full flip is simply `[360, 0, 0]`.\n * - A key's pose is a FULL pose: any joint not listed is at rest (0,0,0). Build poses by\n *   spreading shared poses: `{ ...CROUCH, Head: [10, 0, 0] }`.\n * - Root motion lives in the Pelvis: `p` is an OFFSET from its rest position (metres),\n *   `s` is scale (squash & stretch). Only Pelvis and Head may scale.\n */\nexport type Euler = [number, number, number];\nexport type Vec3 = [number, number, number];\nexport interface JointPose {\n    /** Rotation, degrees XYZ. */\n    r?: Euler;\n    /** Position offset from rest, metres (Pelvis only in practice). */\n    p?: Vec3;\n    /** Scale: uniform number or per-axis. 1 = rest. */\n    s?: number | Vec3;\n}\n/** Joint name → rotation (degrees) or full joint pose. Missing joints are at rest. */\nexport type Pose = Readonly<Record<string, Euler | JointPose>>;\nexport type Ease = 'linear'\n/** accelerate */\n | 'in'\n/** decelerate */\n | 'out'\n/** smooth start and stop (default) */\n | 'inOut'\n/** hold this pose until the next key, then snap */\n | 'hold'\n/** pull back before moving (anticipation) */\n | 'inBack'\n/** overshoot and settle (follow-through) */\n | 'outBack';\n/** `[frame, pose, easeToNextKey?]` */\nexport type Key = readonly [number, Pose, Ease?];\n/** Additive sine wave on one channel — breathing, bobbing, idle sway. */\nexport interface Layer {\n    joint: string;\n    /** rx/ry/rz in degrees, px/py/pz in metres, s = uniform scale delta. */\n    channel: 'rx' | 'ry' | 'rz' | 'px' | 'py' | 'pz' | 's';\n    amplitude: number;\n    /** Frames per cycle. For looping clips it must divide `frames`. */\n    period: number;\n    /** 0..1 fraction of a cycle. */\n    phase?: number;\n}\n/** Where the feet should be (foot IK goals; see ik.ts). A missing side is left as keyed. */\nexport interface FeetGoals {\n    R?: FootGoalDef;\n    L?: FootGoalDef;\n}\n/** Same shape as ik.ts `FootGoal` (kept here so types.ts has no imports). */\nexport interface FootGoalDef {\n    z: number;\n    x?: number;\n    y?: number;\n    pitch?: number;\n    pivot?: 'heel' | 'ball' | 'ankle';\n    follow?: number;\n    relax?: number;\n}\n/** `[frame, goals, easeToNextKey?]` */\nexport type FeetKey = readonly [number, FeetGoals, Ease?];\nexport interface ClipDef {\n    name: string;\n    /** Length in frames at 30 fps. */\n    frames: number;\n    loop?: boolean;\n    keys: readonly Key[];\n    layers?: readonly Layer[];\n    /**\n     * Feet track: foot goals interpolated between its own keys and solved with IK every\n     * frame, overriding the keyed leg rotations. Use it whenever feet touch the floor\n     * through a transition (kneel → stand, sit → lie) so they roll instead of sinking.\n     */\n    feet?: readonly FeetKey[];\n    /**\n     * Ground speed (m/s) the clip is authored for at playback rate 1. Locomotion clips set\n     * this; metrics then measure foot sliding against it and the runtime can scale playback.\n     */\n    speed?: number;\n    /**\n     * Gait cycles (gaitClip): the share of the cycle each foot is planted. The right heel\n     * strikes at phase 0, the left at 0.5, so the right foot is mid-stance at `stance / 2`.\n     */\n    stance?: number;\n    /** Gaits: how far ahead of the hips (m) the middle of the stance is (feet touch down `reach` + half a stance's ground ahead). */\n    reach?: number;\n    /** Grounded clip: soles should rest on y = 0 (metrics flag floating / penetration). */\n    grounded?: boolean;\n    /** Intentionally snappy (flips, punches, launches): skip the angular-speed warning. */\n    fast?: boolean;\n    notes?: string;\n}\nexport interface JointLimit {\n    x?: [number, number];\n    y?: [number, number];\n    z?: [number, number];\n}\n/** One leg's joints, hip → knee → ankle, bending about X (knee forward). */\nexport interface LegJoints {\n    upper: string;\n    lower: string;\n    foot: string;\n    /** Hip joint position in the root (pelvis) joint's space. */\n    hip: Vec3;\n}\n/** Leg geometry for foot-placement IK (`placeFeet`, `gaitClip`). Lengths in metres. */\nexport interface LegRig {\n    R: LegJoints;\n    L: LegJoints;\n    /** Root (pelvis) joint height above the ground at rest. */\n    rootHeight: number;\n    /** Hip → knee. */\n    upper: number;\n    /** Knee → ankle. */\n    lower: number;\n    /** Ankle height above the sole when the foot is flat. */\n    ankle: number;\n    /** Heel contact point, metres behind the ankle. */\n    heel: number;\n    /** Toe tip contact point, metres ahead of the ankle. */\n    ball: number;\n    /** Top of the shoe above the ankle (m), for swing clearance when the foot tips over. */\n    top?: number;\n}\n/** Everything the tools need to know about a rig beyond its hierarchy. */\nexport interface RigSpec {\n    /** Joint names in hierarchy order (root first). */\n    joints: readonly string[];\n    root: string;\n    /** Left/right counterparts for mirroring. */\n    mirror: Readonly<Record<string, string>>;\n    /** Mesh names that touch the ground (soles). */\n    soles: readonly string[];\n    /** Points to trace in contact sheets (joint or mesh names). */\n    trace: readonly string[];\n    /** Human-plausible rotation ranges, degrees. */\n    limits: Readonly<Record<string, JointLimit>>;\n    /** Frame rate of the authoring format. */\n    fps: number;\n    /** Leg geometry, enabling foot IK and the gait generator. */\n    legs?: LegRig;\n    /**\n     * Joints the runtime procedural layers turn (PoseLayers): the torso and head look where\n     * the character is going; `cap` is an optional springy joint (not animated by clips).\n     */\n    spine?: {\n        torso?: string;\n        head?: string;\n        cap?: string;\n    };\n}\n","numLines":158,"startLine":1,"totalLines":158}},"tool_result_meta":[{"id":"toolu_01Mp3FLNoA8EB4PkJi6QB7RX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
