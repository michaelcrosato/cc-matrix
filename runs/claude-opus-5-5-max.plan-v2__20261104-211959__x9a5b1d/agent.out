rmR: [-88, 0, 0], ArmL: [-80, 0, -30], ForearmL: [-30, 0, 0], Torso: [4, 18, 0], Head: [0, -14, 0] }]] };\nconst UPPER = /^(Torso|Head|Arm|Forearm|Hand|Cap)/;\nconst mask = (clip, re, name) => new AnimationClip(name, clip.duration, clip.tracks.filter((t) => re.test(t.name.split('.')[0])));\n\nclass Scene2 {\n  name = 'POC2';\n  target = new Vector3();\n  yaw = Math.PI; pitch = 0.0;\n  async setup(ctx) {\n    const { scene, physics, engine } = ctx;\n    const MOODS = {\n      dusk: { hour: 18.6, sun: 1.0, amb: 1.1, fog: 0x4a3a5a, fogTop: 1.2, fogAmt: 0.55, near: 12, far: 70, bg: PALETTE.plum, rain: 0 },\n      rain: { hour: 21.5, sun: 0.5, amb: 1.0, fog: PALETTE.night, fogTop: 2.0, fogAmt: 0.7, near: 8, far: 46, bg: PALETTE.ink, rain: 1 },\n      abbey: { hour: 2, sun: 0.25, amb: 0.8, fog: PALETTE.ink, fogTop: 0.8, fogAmt: 0.5, near: 10, far: 40, bg: PALETTE.ink, rain: 0 },\n    };\n    const M = MOODS[mood]; this.M = M;\n    applySky(engine, skyAt(M.hour));\n    engine.sun.intensity = M.sun; engine.ambient.intensity = M.amb;\n    scene.background = new Color(M.bg);\n    this.mist = groundFog({ color: M.fog, top: M.fogTop, amount: M.fogAmt, near: M.near, far: M.far });\n    scene.fogNode = this.mist.node;\n\n    const tile = TEXTURE_LIBRARY.get('cobbles').size[0] / DEFAULT_TEXEL;\n    const ground = new PlaneGeometry(40, 60).rotateX(-Math.PI / 2);\n    ground.attributes.uv.array.forEach((v, i, uv) => (uv[i] = (v * (i % 2 ? 60 : 40)) / tile));\n    const floor = new Mesh(ground, toonMaterial(PALETTE.white, { map: textureMap('cobbles') }));\n    floor.position.z = -15;\n    floor.receiveShadow = true; scene.add(floor);\n    physics.addStaticBox({ position: [0, -0.5, -15], halfExtents: [20, 0.5, 30] });\n\n    const place = (id, at, o = {}) => {\n      const { turn = 0, ...opt } = o;\n      const m = buildModel(id, { ...opt, catalog: MODELS });\n      m.object.position.set(...at); m.object.rotation.y = turn * Math.PI / 180; m.object.updateMatrixWorld();\n      scene.add(m.object); addModelColliders(physics, m, at, m.object.rotation.y);\n      if (m.light) ctx.lights.request({ ...m.light, position: m.object.localToWorld(new Vector3(...m.light.at)) });\n      return m;\n    };\n    if (mood === 'abbey') {\n      for (let i = 0; i < 5; i++) { place('column', [-5, 0, -4 - i * 6], { params: { height: 5 } }); place('column', [5, 0, -4 - i * 6], { params: { height: 5 } }); }\n      place('altar', [0, 0, -30]);\n      for (const z of [-7, -16, -25]) { place('candles', [-3, 0, z], { light: { intensity: 8, radius: 7, color: 0xffb060, flicker: 'torch' } }); place('brazier', [3.2, 0, z - 2], { light: { intensity: 10, radius: 8 } }); }\n      place('banner', [-5.6, 2, -12], { turn: 90 });\n    } else {\n      place('timber-wall', [-8, 0, -14], { params: { length: 4 } });\n      place('timber-wall', [-8, 0, -22], { params: { length: 4 } });\n      place('roof', [-8, 3, -15.5], { params: { width: 5, depth: 4 }, palette: { tile: 'slate', tile2: 'night' } });\n      place('stone-wall', [7, 0, -18], { params: { length: 6, height: 3 } });\n      place('lamp-post', [-3, 0, -9], { light: { intensity: 16, radius: 10 } });\n      place('lamp-post', [3.5, 0, -20], { light: { intensity: 16, radius: 10 } });\n      place('barrel', [2.6, 0, -6.5]); place('crate', [-2.6, 0, -6]); place('crate-stack', [5.5, 0, -10], { turn: 30 });\n      place('dead-tree', [10, 0, -9]); place('well', [-7, 0, -6]); place('market-stall', [-7, 0, -30], { palette: { cloth: 'teal' } });\n      place('rope-coil', [1, 0, -3]);\n    }\n    if (mood !== 'abbey') {\n      this.water = new WaterSurface({ size: [120, 40], at: [28, -0.8, -15], waves: mood === 'rain' ? WAVES_CHOPPY : WAVES_CALM, deep: PALETTE.navy, shallow: PALETTE.teal, foam: PALETTE.mist });\n      scene.add(this.water);\n    }\n    if (M.rain) { this.rain = new Precipitation({ kind: 'rain', count: 3000, color: PALETTE.mist }); this.rain.wind.set(3, 1); scene.add(this.rain); }\n\n    this.ag = buildModel('agent', { catalog: MODELS, palette: { coat: 'sand', apron: 'white', hat: 'orange', pants: 'navy' } }).object;\n    setLookLayer(this.ag, 'actors'); scene.add(this.ag);\n    this.body = new CharacterController(physics, { position: [0, 0, 0] }); physics.tag(this.body.collider, 'noCamera');\n    const rest = restPoseOf(this.ag, HERO_RIG);\n    const by = (n) => compileClip([...HERO_CLIPS, SHAMBLE, AIM].find((c) => c.name === n), HERO_RIG, rest);\n    this.mix = new AnimationMixer(this.ag);\n    // Lower body walks while the upper body aims: masked clips on one mixer.\n    this.mix.clipAction(mask(by('Walk'), /^(Pelvis|Leg|Shin|Foot)/, 'WalkLegs')).play();\n    this.mix.clipAction(mask(by('Aim'), UPPER, 'AimUpper')).play();\n    this.agShadow = new ContactShadow(0.42); scene.add(this.agShadow);\n\n    this.foes = [];\n    const spots = [[-1.3, -8], [1.8, -10], [-3, -13], [0.2, -16], [3.2, -14], [-0.8, -22], [2.2, -26]];\n    let n = 0;\n    for (const [x, z] of spots) {\n      const pal = [{}, { coat: 'navy', apron: 'mist', hat: 'night' }, { coat: 'plum', apron: 'sand', hat: 'red' }][n % 3];\n      const v = buildModel('villager', { catalog: MODELS, palette: pal }).object;\n      setLookLayer(v, 'actors'); scene.add(v); v.position.set(x, 0, z);\n      const m = new AnimationMixer(v); const a = m.clipAction(compileClip(SHAMBLE, HERO_RIG, restPoseOf(v, HERO_RIG))); a.play(); a.time = n * 0.17;\n      const s = new ContactShadow(0.42); scene.add(s); s.place(x, 0, z, 0);\n      this.foes.push({ v, m, s, head: v.getObjectByName('Head') }); n++;\n    }\n    // one puppet goes limp, thrown by a shot\n    const doll = this.foes[1];\n    this.doll = new Ragdoll(physics, doll.v, HERO_RAGDOLL);\n    this.dollAt = 20;\n    this.decals = new Decals(scene);\n    this.decals.add('splat', [1.0, 0.02, -7], [0, 1, 0], { size: 1.2 });\n\n    const rig = ctx.camera, game = this; const dir = new Vector3(), pos = new Vector3(), look = new Vector3(), side = new Vector3(), tmp = new Vector3();\n    rig.zoomable = false;\n    const CAM = camMode === 'aim' ? { dist: 2.5, up: 0.05, side: 0.85, fov: 44 } : { dist: 3.6, up: 0.25, side: 0.6, fov: 54 };\n    rig.camera.fov = CAM.fov; rig.camera.updateProjectionMatrix();\n    rig.step = (u) => {\n      const yaw = game.yaw, p = game.pitch;\n      dir.set(Math.sin(yaw) * Math.cos(p), Math.sin(p), Math.cos(yaw) * Math.cos(p));\n      side.set(-Math.cos(yaw), 0, Math.sin(yaw));\n      pos.copy(u.target).addScaledVector(dir, -CAM.dist).addScaledVector(side, CAM.side); pos.y += CAM.up;\n      tmp.copy(pos).sub(u.target); const len = tmp.length(); tmp.normalize();\n      const hit = u.world.raycast ? u.world.raycast(u.target, tmp, len) : null;\n      if (hit != null) pos.copy(u.target).addScaledVector(tmp, Math.max(0.4, hit - 0.2));\n      rig.focus.copy(u.target); rig.camera.position.copy(pos);\n      look.copy(pos).addScaledVector(dir, 12); rig.camera.lookAt(look);\n    };\n    ctx.lights.request({ follow: this.ag, offset: [0.3, 1.8, 0.5], color: 0xffe0a0, intensity: 2.5, radius: 6, priority: 8 });\n    this.beam = new Mesh(new BoxGeometry(0.02, 0.02, 1), glowMaterial(0xff3030)); this.beam.castShadow = false; scene.add(this.beam);\n    this.t = 0;\n  }\n  fixedUpdate(ctx, dt) { this.water?.step?.(dt); }\n  update(ctx, dt) {\n    this.t += dt;\n    this.mix.update(dt); for (const f of this.foes) if (f !== this.foes[1] || !this.doll.active) f.m.update(dt);\n    if (this.t > 0.3 && !this.dollFired) { this.dollFired = true; this.doll.enable({ velocity: [0.4, 2.2, -3.5] }); }\n    if (this.doll.active) this.doll.sync();\n    this.ag.position.copy(this.body.feet); this.ag.rotation.y = this.yaw;\n    this.agShadow.place(this.ag.position.x, 0, this.ag.position.z, 0);\n    this.water?.update?.(ctx.time); this.rain?.update?.(dt, ctx.camera.focus); this.decals.update(dt);\n    const o = new Vector3(), d = new Vector3(); ctx.camera.rayAt(0, 0, o, d);\n    const h = ctx.physics.castRay(o, d, 80); let dist = h ? h.distance : 80, head = null;\n    for (const f of this.foes) { const w = f.head.getWorldPosition(new Vector3()).add(new Vector3(0, 0.14, 0)); const t = w.clone().sub(o).dot(d); if (t > 0 && t < dist && o.clone().addScaledVector(d, t).distanceTo(w) < 0.26) { dist = t; head = f; } }\n    this.aimHead = !!head;\n    const hit = o.clone().addScaledVector(d, dist);\n    const hand = this.ag.getObjectByName('HandR').getWorldPosition(new Vector3());\n    this.beam.position.copy(hand).lerp(hit, 0.5); this.beam.lookAt(hit); this.beam.scale.z = hand.distanceTo(hit);\n    const hud = ctx.hud; hud.clear();\n    const v = hit.clone().project(ctx.camera.camera), W = hud.width, H = hud.height;\n    const px = Math.round((v.x + 1) / 2 * W), py = Math.round((1 - v.y) / 2 * H);\n    hud.rect(px - 1, py - 1, 3, 3, head ? 'lime' : 'red'); hud.rect(px, py, 1, 1, 'white');\n    const heart = hudSprite('herb-icon'); hud.sprite(6, 28, heart.rows, heart.colors);\n    hud.text(6, 6, 'MAX'); hud.rect(6, 15, 80, 5, 'plum'); hud.rect(6, 15, 58, 5, 'lime');\n    hud.text(6, 6, '12/15', { anchor: 'bottom-right', scale: 2 });\n    hud.text(0, 24, 'YOU ARE NOT COVERED FOR THAT.', { anchor: 'bottom', scale: 1 });\n  }\n  cameraTarget() { return this.target.set(0, 1.45, 0); }\n  status() { return `mood ${mood} cam ${camMode} aimHead:${this.aimHead} dollSpeed:${this.doll?.active ? this.doll.speed().toFixed(2) : '-'}`; }\n}\nexport const createGame = () => new Scene2();\nif (typeof document !== 'undefined') {\n  await Engine.start(createGame(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'third', fov: 50 }, settings: { button: false }, look: { scene: [{ id: 'vignette', params: { intensity: 0.5, softness: 0.55 } }], actors: { pixel: { size: 1, outline: 0.65, crease: 0.12 }, filters: [] }, environment: { pixel: { size: 1, outline: 0.4, crease: 0.08 }, filters: [] } } }));\n}\nEOF\ncat > $W/_research/poc/index2.html <<'EOF'\n<!doctype html><html><head><meta charset=\"utf-8\"><title>poc2</title></head><body><div id=\"app\"></div><script type=\"module\" src=\"./game2.js\"></script></body></html>\nEOF\nPORT=$(cat $W/_research/poc/port.txt); cd $W/_research/scripts && for m in \"dusk&cam=aim\" \"rain&cam=explore\" \"abbey&cam=aim\"; do n=$(echo $m | tr -c 'a-z' '_'); timeout 120 python3 shot.py \"http://127.0.0.1:$PORT/index2.html?mood=$m\" $W/_research/poc/m_$n.png; done; ls $W/_research/poc/*.png","description":"Render three mood recipes with water, rain, ragdoll and masked animation","timeout":400000}}}
