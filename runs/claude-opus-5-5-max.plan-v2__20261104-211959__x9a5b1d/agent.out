 sys, json, time\nfrom playwright.sync_api import sync_playwright\nport, query = sys.argv[1], sys.argv[2]\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader'])\n    pg = b.new_page(viewport={'width':1600,'height':900})\n    errs=[]\n    pg.on('pageerror', lambda e: errs.append(str(e)[:300]))\n    t=time.time()\n    pg.goto(f'http://127.0.0.1:{port}/hub/harness.html?game=hubgame.html&auto=1&{query}')\n    pg.wait_for_function(\"document.body.dataset.complete==='true'\", timeout=150000)\n    r = pg.evaluate(\"window.__hubCheck\")\n    print(query, 'PASS' if r['pass'] else 'FAIL', round(time.time()-t,1),'s')\n    for c in r['checks']:\n        if not c['pass']: print('  X', c['name'], c['detail'][:300])\n    print('  checks', len(r['checks']))\n    if not r['pass'] or '-v' in sys.argv:\n        print('\\n'.join(r['log'][-25:]))\n    for e in errs[:5]: print('  err', e)\n    b.close()\nEOF\nPORT=$(cat $W/_research/poc/port.txt); timeout 170 python3 $W/_research/scripts/hubcheck.py $PORT \"players=2\"; timeout 170 python3 $W/_research/scripts/hubcheck.py $PORT \"players=4&latency=150&jitter=50&loss=5\"","description":"Run a minimal engine-based shared-world game through the hub harness","timeout":360000}}}
