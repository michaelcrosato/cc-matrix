\n          ]),\n        ]),\n      ]),\n      J('LegR', [-0.14, 0, 0], [\n        { box: [0.17, 0.32, 0.18], at: [0, -0.15, 0], c: 'pants' },\n        J('ShinR', [0, -0.3, 0], [\n          { box: [0.15, 0.24, 0.16], at: [0, -0.11, 0], c: 'pants' },\n          J('FootR', [0, -0.22, 0], [{ box: [0.16, 0.1, 0.32], at: [0, -0.05, 0.05], c: 'boot' }]),\n        ]),\n      ]),\n      J('LegL', [0.14, 0, 0], [\n        { box: [0.17, 0.32, 0.18], at: [0, -0.15, 0], c: 'pants' },\n        J('ShinL', [0, -0.3, 0], [\n          { box: [0.15, 0.24, 0.16], at: [0, -0.11, 0], c: 'pants' },\n          J('FootL', [0, -0.22, 0], [{ box: [0.16, 0.1, 0.32], at: [0, -0.05, 0.05], c: 'boot' }]),\n        ]),\n      ]),\n    ]),\n  ];\n}\nexport const villager = model({ id: 'villager', about: 'Oilskin-clad islander puppet on the hero rig', tags: ['character'],\n  palette: { coat: 'teal', apron: 'sand', pants: 'night', skin: 'mist', eyes: 'orange', hat: 'navy', boot: 'ink' }, parts: villagerParts() });\nexport const agent = model({ id: 'agent', about: 'Lead character puppet on the hero rig', tags: ['character'],\n  palette: { coat: 'plum', apron: 'white', pants: 'ink', skin: 'sand', eyes: 'ink', hat: 'red', boot: 'night' }, parts: villagerParts() });\n\nexport const MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), villager, agent]);\n\nconst SHAMBLE = gaitClip(HERO_RIG, { name: 'Shamble', frames: 40, speed: 1.1, stance: 0.62, hip: -0.05, bob: 0.02, lift: 0.04, lean: 16, sway: 7, head: 8, arms: { swing: 8, elbow: 30 } });\nconst AIMPOSE = { name: 'Aim', frames: 30, loop: true, keys: [[0, { ArmR: [-90, 0, 0], ArmL: [-85, 0, -25], ForearmL: [-30, 0, 0], Torso: [5, 25, 0], Head: [0, -20, 0] }]], grounded: true };\n\nclass Poc {\n  name = 'POC';\n  target = new Vector3();\n  aimYaw = Math.PI; aimPitch = 0.02;\n  aiming = true;\n  shots = 0;\n  hits = [];\n  async setup(ctx) {\n    const { scene, physics, engine } = ctx;\n    applySky(engine, skyAt(21.2));\n    engine.sun.intensity = 0.45;\n    engine.ambient.intensity = 0.9;\n    scene.background = new Color(PALETTE.ink);\n    const mist = groundFog({ color: PALETTE.night, top: 2.0, amount: 0.75, near: 6, far: 44 });\n    scene.fogNode = mist.node; this.mist = mist;\n\n    const tile = TEXTURE_LIBRARY.get('cobbles').size[0] / DEFAULT_TEXEL;\n    const ground = new PlaneGeometry(80, 80).rotateX(-Math.PI / 2);\n    ground.attributes.uv.array.forEach((v, i, uv) => (uv[i] = (v * 80) / tile));\n    const floor = new Mesh(ground, toonMaterial(PALETTE.white, { map: textureMap('cobbles') }));\n    floor.receiveShadow = true; scene.add(floor);\n    physics.addStaticBox({ position: [0, -0.5, 0], halfExtents: [40, 0.5, 40] });\n\n    const place = (id, at, o = {}) => {\n      const { turn = 0, ...opt } = o;\n      const m = buildModel(id, { ...opt, catalog: MODELS });\n      m.object.position.set(...at); m.object.rotation.y = turn * Math.PI / 180; m.object.updateMatrixWorld();\n      scene.add(m.object); addModelColliders(physics, m, at, m.object.rotation.y);\n      if (m.light) ctx.lights.request({ ...m.light, position: m.object.localToWorld(new Vector3(...m.light.at)) });\n      return m;\n    };\n    place('timber-wall', [-5, 0, -14], { params: { length: 4 } });\n    place('roof', [-5, 3, -15.6], { params: { width: 5, depth: 4 } , palette: { tile: 'slate', tile2: 'night' }});\n    place('stone-wall', [6, 0, -16], { params: { length: 6, height: 3 } });\n    place('lamp-post', [-2.2, 0, -9], { light: { intensity: 14, radius: 9 } });\n    place('lamp-post', [3.5, 0, -18], { light: { intensity: 14, radius: 9 } });\n    place('barrel', [1.4, 0, -6.5]); place('crate', [-1.2, 0, -5]); place('crate-stack', [4, 0, -9], { turn: 30 });\n    place('dead-tree', [8, 0, -8]); place('well', [-6, 0, -7]);\n\n    this.ag = buildModel('agent', { catalog: MODELS }).object;\n    setLookLayer(this.ag, 'actors'); scene.add(this.ag);\n    this.ag.position.set(0, 0, 0); this.ag.rotation.y = this.aimYaw;\n    this.body = new CharacterController(physics, { position: [0, 0, 0] });\n    const clips = compileClips([...HERO_CLIPS, SHAMBLE, AIMPOSE], HERO_RIG, this.ag);\n    this.mix = new AnimationMixer(this.ag);\n    this.mix.clipAction(clips.find(c => c.name === 'Aim')).play();\n\n    this.foes = [];\n    const spots = [[-1.3, -9], [1.6, -11], [-3, -13], [0.2, -16], [3.2, -14], [-0.8, -22], [2.2, -26]];\n    for (const [x, z] of spots) {\n      const v = buildModel('villager', { catalog: MODELS, palette: {} }).object;\n      setLookLayer(v, 'actors'); scene.add(v); v.position.set(x, 0, z); v.rotation.y = 0;\n      const c = compileClips([...HERO_CLIPS, SHAMBLE], HERO_RIG, v);\n      const m = new AnimationMixer(v); const a = m.clipAction(c.find(c => c.name === 'Shamble')); a.play(); a.time = Math.abs(x) * 0.4;\n      const s = new ContactShadow(0.42); scene.add(s); s.place(x, 0, z, 0);\n      this.foes.push({ v, m, s, head: v.getObjectByName('Head') });\n    }\n\n    // Shoulder camera: replace the third-person rig's step on this instance.\n    const rig = ctx.camera, game = this; const dir = new Vector3(), pos = new Vector3(), look = new Vector3(), side = new Vector3();\n    this.shoulder = { dist: 2.0, height: 1.55, side: 0.55 };\n    rig.step = (u) => {\n      const s = game.shoulder, yaw = game.aimYaw, p = game.aimPitch;\n      dir.set(Math.sin(yaw) * Math.cos(p), Math.sin(p), Math.cos(yaw) * Math.cos(p));   // aim direction\n      side.set(-Math.cos(yaw), 0, Math.sin(yaw));                                        // camera right when looking along dir\n      pos.copy(u.target).setY(u.target.y + 0).addScaledVector(dir, -s.dist).addScaledVector(side, s.side);\n      const hit = u.world.raycast ? u.world.raycast(u.target, pos.clone().sub(u.target).normalize(), pos.distanceTo(u.target)) : null;\n      if (hit != null) pos.copy(u.target).add(pos.clone().sub(u.target).normalize().multiplyScalar(Math.max(0.35, hit - 0.15)));\n      rig.focus.copy(u.target);\n      rig.camera.position.copy(pos);\n      look.copy(pos).addScaledVector(dir, 12);\n      rig.camera.lookAt(look);\n    };\n    ctx.lights.request({ follow: this.ag, offset: [0.2, 1.5, 0.4], color: 0xffe0a0, intensity: 5, radius: 7, priority: 8 });\n    this.beam = new Mesh(new BoxGeometry(0.018, 0.018, 1), glowMaterial ? glowMaterial(0xff2020) : toonMaterial(PALETTE.red));\n    this.beam.castShadow = false; scene.add(this.beam);\n    this.ready1 = true;\n  }\n  update(ctx, dt) {\n    this.mix.update(dt);\n    for (const f of this.foes) f.m.update(dt);\n    const md = ctx.input.mouseDelta;\n    this.aimYaw -= md.x * 0.0022; this.aimPitch = Math.max(-0.7, Math.min(0.7, this.aimPitch - md.y * 0.002));\n    this.ag.rotation.y = this.aimYaw;\n    // the gun hand and its ray along the camera's aim\n    const cam = ctx.camera.camera; const o = new Vector3(), d = new Vector3();\n    ctx.camera.rayAt(0, 0, o, d);\n    const h = ctx.physics.castRay(o, d, 80);\n    const end = h ? o.clone().addScaledVector(d, h.distance) : o.clone().addScaledVector(d, 80);\n    let dist = o.distanceTo(end), head = null;\n    for (const f of this.foes) { const w = f.head.getWorldPosition(new Vector3()).add(new Vector3(0, 0.14, 0));\n      const t = w.clone().sub(o).dot(d); if (t > 0 && t < dist && o.clone().addScaledVector(d, t).distanceTo(w) < 0.24) { dist = t; head = f; } }\n    this.aimHead = !!head;\n    const hand = this.ag.getObjectByName('HandR').getWorldPosition(new Vector3());\n    const hit = o.clone().addScaledVector(d, dist);\n    this.beam.position.copy(hand).lerp(hit, 0.5); this.beam.lookAt(hit); this.beam.scale.z = hand.distanceTo(hit);\n    const hud = ctx.hud; hud.clear();\n    const v = hit.clone().project(cam), W = hud.width, H = hud.height;\n    const px = Math.round((v.x + 1) / 2 * W), py = Math.round((1 - v.y) / 2 * H);\n    hud.rect(px - 1, py - 1, 3, 3, 'red'); hud.rect(px, py, 1, 1, 'white');\n    hud.text(6, 6, 'HEALTH'); hud.rect(6, 15, 80, 5, 'plum'); hud.rect(6, 15, 58, 5, 'lime');\n    hud.text(6, 6, '12 / 15', { anchor: 'bottom-right', scale: 2 });\n    hud.text(0, 24, 'WHAT ARE YOU SELLING, STRANGER', { anchor: 'bottom' });\n    hud.text(6, 6, 'R2 FIRE   L2 AIM   X KICK', { anchor: 'bottom-left' });\n  }\n  cameraTarget() { return this.target.set(0, 1.45, 0); }\n  status() { return `head:${this.aimHead} yaw:${this.aimYaw.toFixed(2)} pitch:${this.aimPitch.toFixed(2)}`; }\n}\nexport const createGame = () => new Poc();\nif (typeof document !== 'undefined') {\n  const q = new URLSearchParams(location.search);\n  await Engine.start(createGame(), withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'third', fov: 50 }, settings: { button: false }, look: { scene: [{ id: 'vignette', params: { intensity: 0.55, softness: 0.5 } }], actors: { pixel: { size: 1, outline: 0.6, crease: 0.1 }, filters: [] }, environment: { pixel: { size: 1, outline: 0.45, crease: 0.08 }, filters: [] } } }));\n}\nEOF\ncat > $W/_research/poc/index.html <<'EOF'\n<!doctype html><html><head><meta charset=\"utf-8\"><title>poc</title></head><body><div id=\"app\"></div><script type=\"module\" src=\"./game.js\"></script></body></html>\nEOF\ncat > $W/_research/scripts/shot.py <<'EOF'\nimport sys, time\nfrom playwright.sync_api import sync_playwright\nurl, out = sys.argv[1], sys.argv[2]\njs_before = sys.argv[3] if len(sys.argv) > 3 else None\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--use-angle=swiftshader'])\n    pg = b.new_page(viewport={'width':1920,'height':1080})\n    msgs=[]\n    pg.on('console', lambda m: msgs.append(m.type+': '+m.text[:300]))\n    pg.on('pageerror', lambda e: msgs.append('PAGEERR: '+str(e)[:500]))\n    t=time.time()\n    pg.goto(url)\n    res = pg.evaluate(\"\"\"async () => { const e = await Promise.race([window.__PIXEL_READY__, new Promise((_, r)=>setTimeout(()=>r(new Error('no ready after 90s')),90000))]); return e.state().backend + ' ' + e.state().status; }\"\"\")\n    print('ready', round(time.time()-t,1), res)\n    if js_before:\n        print('eval', pg.evaluate(js_before))\n    pg.wait_for_timeout(2500)\n    print('status', pg.evaluate(\"window.__PIXEL_ENGINE__.state().status + ' fps ' + window.__PIXEL_ENGINE__.state().fps + ' errors ' + JSON.stringify(window.__PIXEL_ENGINE__.errors)\"))\n    pg.screenshot(path=out)\n    for m in msgs[:30]: print(m)\n    b.close()\nEOF\ncd $W/_research/poc && (python3 -m http.server 0 --bind 127.0.0.1 > server.log 2>&1 & echo $! > server.pid); sleep 1; cat server.log | head -2; PORT=$(grep -o 'port [0-9]*' server.log | head -1 | cut -d' ' -f2); echo PORT=$PORT; curl -s -o /dev/null -w '%{http_code}\\n' http://127.0.0.1:$PORT/index.html; cd $W/_research/scripts && timeout 170 python3 shot.py \"http://127.0.0.1:$PORT/index.html\" $W/_research/poc/shot1.png","description":"Build proof-of-concept scene, serve it locally, capture a screenshot","timeout":200000}}}
