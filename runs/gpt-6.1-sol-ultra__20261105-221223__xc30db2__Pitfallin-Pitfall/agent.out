vides measurable sound verification without a listener.\n  signal=await page.evaluate('''async()=>{const b=await window.__pitfallin.offlineAudio();const d=b.getChannelData(0);let sum=0,peak=0,finite=true;for(const x of d){sum+=x*x;peak=Math.max(peak,Math.abs(x));finite&&=Number.isFinite(x);}return {rms:Math.sqrt(sum/d.length),peak,finite};}''')\n  check(signal['finite'] and signal['rms']>.001 and signal['peak']<1,'Synthesized sound finite, audible and unclipped',signal)\n  # Lifecycle and real ten-second attract trigger; all input exits replay.\n  await page.evaluate('window.__pitfallin.action(\\\"title\\\")')\n  await page.wait_for_timeout(10300)\n  check(await page.evaluate('window.__pitfallin.state.mode')=='attract','Ten-second attract trigger')\n  await page.keyboard.press('x');await page.wait_for_timeout(100)\n  check(await page.evaluate('window.__pitfallin.state.mode')=='title','Input exits attract without starting')\n  await page.click('[data-action=\\\"about\\\"]')\n  for tab,count in [('sourceInformation',17),('testingFeedback',4),('engineFeedback',6),('promptFeedback',4)]:\n   await page.click('[data-credit=\\\"'+tab+'\\\"]')\n   n=await page.locator('.credit-line' if tab=='sourceInformation' else '.feedback-item').count()\n   check(n==count,'About / '+tab,n)\n  check(not errors,'No browser JavaScript errors',errors)\n  await page.close()\n  # Touch only page: same title/UI; invisible stick and context action.\n  context=await browser.new_context(viewport={'width':844,'height':390},is_mobile=True,has_touch=True,device_scale_factor=1)\n  mobile=await context.new_page();await mobile.goto((ROOT/'index.html').as_uri())\n  await mobile.wait_for_function('window.__gameReady||window.__bootError',timeout=120000)\n  await mobile.tap('[data-action=\\\"start\\\"]');await mobile.wait_for_timeout(300)\n  check(await mobile.evaluate('window.__pitfallin.state.inputMethod')=='touch','Touch input identity')\n  check(await mobile.locator('#controls').is_hidden(),'Touch mini