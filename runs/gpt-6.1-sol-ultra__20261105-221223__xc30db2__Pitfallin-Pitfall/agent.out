{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' art.js && sed -n '1,160p' online.js\"","aggregated_output":"// Procedural ink-and-colour jungle; all geometry and animation authored in code.\nexport function createArt(THREE, scene, config = {}) {\n  const P = {\n    ink: 0x162e29, leaf: 0x3d8050, lime: 0x9fbd59, fern: 0x75a852,\n    dark: 0x254f3d, pale: 0xb5cba0, mist: 0xd4d9b2, soil: 0xb67f4b,\n    clay: 0x8e5f3d, earth: 0x654b37, stone: 0x73816a, gold: 0xf0bc4c,\n    cream: 0xffedbf, water: 0x4e9e83, blue: 0x5eada1, red: 0xd05e40,\n  };\n  let seed = 73421;\n  const rand = () => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed / 4294967296; };\n  const range = (a, b) => a + (b - a) * rand();\n  const materials = new Map();\n  const mat = (c, options = {}) => {\n    const key = `${c}:${JSON.stringify(options)}`;\n    if (!materials.has(key)) materials.set(key, new THREE.MeshStandardMaterial({ color: c, roughness: 1, metalness: 0, flatShading: true, ...options }));\n    return materials.get(key);\n  };\n  const ink = new THREE.MeshBasicMaterial({ color: P.ink, side: THREE.BackSide });\n  const world = new THREE.Group(); world.name = 'InkJungle'; scene.add(world);\n  const v = (x, y, z) => new THREE.Vector3(x, y, z);\n  const solid = (geom, color, parent = world, outline = true, extra = {}) => {\n    const m = new THREE.Mesh(geom, mat(color, extra));\n    m.castShadow = true; m.receiveShadow = true;\n    if (outline) {\n      const hull = new THREE.Mesh(geom, ink); hull.scale.setScalar(1.035); hull.castShadow = false; hull.receiveShadow = false; m.add(hull);\n    }\n    parent.add(m); return m;\n  };\n  const box = (x, y, z, w, h, d, c, parent = world, outline = true) => { const o = solid(new THREE.BoxGeometry(w, h, d), c, parent, outline); o.position.set(x, y, z); return o; };\n  const sphere = (x, y, z, r, c, parent = world, sx = 1, sy = 1, sz = 1, detail = 1, outline = true) => { const o = solid(new THREE.IcosahedronGeometry(r, detail), c, parent, outline); o.position.set(x, y, z); o.scale.set(sx, sy, sz); return o; };\n  const cyl = (x, y, z, top, bottom, h, c, parent = world, sides = 7, outline = true) => { const o = solid(new THREE.CylinderGeometry(top, bottom, h, sides), c, parent, outline); o.position.set(x, y, z); return o; };\n  const line = (a, b, r, color, parent = world) => {\n    const d = b.clone().sub(a); const o = solid(new THREE.CylinderGeometry(r, r, d.length(), 5), color, parent, false); o.position.copy(a).add(b).multiplyScalar(.5); o.quaternion.setFromUnitVectors(v(0, 1, 0), d.normalize()); return o;\n  };\n  const torus = (x, y, z, radius, tube, c, parent = world, outline = false) => { const o = solid(new THREE.TorusGeometry(radius, tube, 5, 16), c, parent, outline); o.position.set(x, y, z); return o; };\n  const leafGeometry = new THREE.ShapeGeometry(new THREE.Shape().moveTo(0, 0).quadraticCurveTo(.55, .36, 0, 1.5).quadraticCurveTo(-.55, .36, 0, 0));\n  function leaf(x, y, z, size, angle, color, parent = world) {\n    const g = new THREE.Group(); g.position.set(x, y, z); g.rotation.z = angle; g.scale.setScalar(size); parent.add(g);\n    const edge = solid(leafGeometry, P.ink, g, false, { side: THREE.DoubleSide }); edge.scale.set(1.09, 1.04, 1); edge.position.z = -.012;\n    solid(leafGeometry, color, g, false, { side: THREE.DoubleSide });\n    line(v(0, 0, .015), v(0, 1.26, .015), .013, P.dark, g); return g;\n  }\n  function fern(x, y, z, size = 1, color = P.fern) {\n    const g = new THREE.Group(); g.position.set(x, y, z); g.scale.setScalar(size); world.add(g);\n    for (let i = -2; i <= 2; i++) {\n      const ang = i * .36; const stem = new THREE.Group(); stem.rotation.z = ang; g.add(stem);\n      line(v(0, 0, 0), v(0, 1.0 - Math.abs(i) * .11, 0), .025, P.dark, stem);\n      for (let j = 0; j < 4; j++) {\n        const yy = .18 + j * .17; const ll = (.33 - j * .055) * (1 - Math.abs(i) * .09);\n        leaf(0, yy, 0, ll, -1.07, color, stem); leaf(0, yy, .004, ll, 1.07, color, stem);\n      }\n    }\n    return g;\n  }\n  const surface = config.surface || config.ground || [[-10, 30], [41, 69], [80, 116], [130, 166], [179, 210], [224, 290]];\n  const caves = config.caves || [[80, 112], [180, 208]];\n  const ladderXs = config.ladders || [84, 108, 184, 204];\n  const inLand = x => surface.some(([a, b]) => x > a + .5 && x < b - .5);\n  const caveAt = x => caves.some(([a, b]) => x >= a && x <= b);\n  const underSky = new THREE.Group(); world.add(underSky);\n  // Broad, opaque silhouettes make the forest feel like a stack of hand-cut prints.\n  box(140, 12, -44, 400, 60, .2, P.mist, underSky, false);\n  for (let layer = 0; layer < 3; layer++) {\n    const shape = new THREE.Shape(); shape.moveTo(-60, -12);\n    for (let x = -60; x <= 350; x += 5) shape.lineTo(x, 4.5 + layer * .8 + Math.sin(x * .055 + layer * 2) * 2.4 + range(-1, 1));\n    shape.lineTo(350, -12); shape.closePath();\n    const hill = solid(new THREE.ShapeGeometry(shape), [0x9caf88, 0x839e78, 0x688d6b][layer], underSky, false, { side: THREE.DoubleSide }); hill.position.z = -38 + layer * 6;\n  }\n  const sun = solid(new THREE.CircleGeometry(4.2, 64), 0xf3d497, underSky, false, { side: THREE.DoubleSide, emissive: 0xf3d497, emissiveIntensity: .25 }); sun.position.set(18, 10, -32);\n  for (let x = -12; x < 310; x += range(5, 10)) {\n    const h = range(9, 15), z = range(-22, -14), width = range(.28, .7);\n    cyl(x, h / 2 - 2, z, width * .65, width, h, 0x54765a, world, 5, false);\n    for (let j = 0; j < 4; j++) sphere(x + range(-3, 3), h - 2 + range(-1, 2), z, range(2.4, 4), 0x66876a, world, 1.9, .8, .7, 0, false);\n  }\n  // Distant ruined observatories are a visual promise of the expedition's destination.\n  function temple(x, z, scale = 1) {\n    const g = new THREE.Group(); g.position.set(x, .05, z); g.scale.setScalar(scale); world.add(g);\n    for (let i = 0; i < 5; i++) box(0, .34 + i * .66, 0, 7 - i * 1.05, .65, 3.3 - i * .3, i % 2 ? 0x60755c : 0x6d8065, g);\n    box(0, 4.1, .15, 2.3, 1.75, 2, 0x7b896b, g); box(0, 3.82, 1.19, .9, 1.22, .08, P.dark, g, false);\n    cyl(0, 5.2, 0, 0, 1.4, .7, P.dark, g, 4);\n    for (let i = 0; i < 3; i++) leaf(range(-2, 2), range(.5, 3), 1.9, .8, range(-1, 1), P.dark, g);\n  }\n  temple(98, -10, 1.55); temple(269, -9, 2.1); temple(151, -18, 1.25);\n  // Traversable ledges, warm exposed strata and cutaway underground rooms.\n  for (const [a, b] of surface) {\n    const n = Math.ceil((b - a) / 3.5);\n    for (let i = 0; i < n; i++) {\n      const left = a + (b - a) * i / n, right = a + (b - a) * (i + 1) / n, x = (left + right) / 2, w = right - left + .025;\n      const cave = caveAt(x);\n      box(x, cave ? -1.04 : -3.8, -.55, w, cave ? 1.75 : 7.3, 4.3, i % 3 ? P.soil : 0xae7747, world, true);\n      if (!cave) {\n        box(x, -4.7 + range(-.15, .15), 1.65, w, .24, .035, P.clay, world, false);\n        box(x, -2.05 + range(-.1, .1), 1.65, w, .09, .04, 0xd39c64, world, false);\n        for (let k = 0; k < 3; k++) {\n          const rock = sphere(x + range(-w * .35, w * .35), range(-6.7, -1.2), 1.65, range(.08, .21), 0x906139, world, 1.8, .6, .1, 0, false); rock.rotation.z = range(-.4, .4);\n        }\n      }\n      box(x, -.35, -.5, w, .43, 4.5, 0x665238, world, false);\n    }\n    // Grass cap is interrupted at ladder mouths.\n    let cuts = [a, ...ladderXs.filter(x => x > a && x < b).flatMap(x => [x - .55, x + .55]), b];\n    for (let i = 0; i < cuts.length - 1; i += 2) {\n      const l = cuts[i], r = cuts[i + 1];\n      box((l + r) / 2, -.08, -.5, r - l, .22, 4.7, P.lime);\n      box((l + r) / 2, -.17, 1.88, r - l, .13, .08, P.dark, world, false);\n    }\n    for (let x = a + .3; x < b; x += range(.6, 1.3)) {\n      if (ladderXs.some(l => Math.abs(l - x) < .7)) continue;\n      const g = new THREE.Group(); g.position.set(x, .02, 1.42); world.add(g);\n      for (let j = 0; j < 3; j++) {\n        const blade = solid(new THREE.ConeGeometry(range(.035, .085), range(.13, .37), 3), j % 2 ? P.dark : P.lime, g, false); blade.position.set(j * .10, .07, 0); blade.rotation.z = range(-.7, .7);\n      }\n    }\n  }\n  for (const [a, b] of caves) {\n    box((a + b) / 2, -3.7, -1.9, b - a, 4.1, .3, 0x263b35, world, false);\n    box((a + b) / 2, -6.25, -.4, b - a + .4, .8, 4.4, P.earth);\n    box((a + b) / 2, -5.85, -.4, b - a, .12, 4.5, 0x99825a);\n    for (let x = a + 1; x < b; x += 2.8) {\n      cyl(x, -1.95, -1.35, .28, 0, range(.7, 1.6), 0x786444, world, 5);\n      sphere(x + .7, -5.65, 1, .3, 0x797356, world, 1.8, .7, .75, 0);\n      for (let j = 0; j < 2; j++) {\n        const xx = x + j * .3, h = .24 + j * .10;\n        cyl(xx, -5.8 + h / 2, -.25, .04, .07, h, 0x87b78f, world, 5, false);\n        const cap = sphere(xx, -5.8 + h, -.25, .18, j ? 0x9cceb0 : 0x76b8a3, world, 1, .5, 1, 0); cap.material = mat(j ? 0x9cceb0 : 0x76b8a3, { emissive: 0x5a9c8a, emissiveIntensity: .45 });\n      }\n    }\n    for (let i = 0; i < 4; i++) box(a + 2 + i * (b - a - 4) / 3, -4.15, -1.5, .45, 2.8, .5, 0x435d4c);\n  }\n  for (const raw of ladderXs) {\n    const x = typeof raw === 'object' ? raw.x : raw;\n    for (const side of [-1, 1]) cyl(x + side * .42, -2.83, .8, .055, .055, 6.3, 0xb9a375, world, 6);\n    for (let y = -5.55; y <= .22; y += .35) line(v(x - .45, y, .81), v(x + .45, y, .81), .045, 0xd3bc80);\n    box(x, -.06, -.1, 1.0, .04, 1.8, P.ink, world, false);\n    box(x - .75, .08, .2, .18, .15, 1.8, P.soil); box(x + .75, .08, .2, .18, .15, 1.8, P.soil);\n  }\n  const waters = [];\n  for (const [a, b, tar] of [[30, 41, false], [69, 80, false], [116, 130, true], [166, 179, false], [210, 224, false]]) {\n    box((a + b) / 2, -.62, -.2, b - a, .35, 4.35, tar ? 0x393e2d : 0x3d7967);\n    const pool = box((a + b) / 2, -.415, -.2, b - a - .08, .065, 4.3, tar ? 0x667448 : P.water, world, false); waters.push(pool);\n    for (let x = a + .3; x < b; x += range(.7, 1.2)) {\n      box(x, -.35, range(-1.9, 1.9), range(.25, .8), .013, .027, tar ? 0xa4a067 : 0x9ec6a1, world, false);\n      if (rand() < .4) { const ripple = torus(x, -.35, range(-1.8, 1.8), range(.13, .28), .018, tar ? 0xa4a067 : 0x98c9a5); ripple.rotation.x = Math.PI / 2; waters.push(ripple); }\n    }\n    // Knotted roots grasp the edges of every watering hole.\n    for (const edge of [a, b]) for (let j = 0; j < 3; j++) {\n      const z = -.8 + j * 1.0; line(v(edge, -.1, z), v(edge + (edge === a ? .35 : -.35), -1.1 - rand(), z + .15), .09, P.earth);\n    }\n  }\n  // Canopy trees have crooked trunks, roots, and large, graphic fronds.\n  const fronds = [];\n  function tree(x, z, h, back = false) {\n    const g = new THREE.Group(); g.position.set(x, 0, z); world.add(g);\n    const c = back ? 0x426c49 : 0x65583a;\n    const lean = range(-1.1, 1.1);\n    line(v(0, 0, 0), v(lean * .35, h * .47, 0), back ? .34 : .42, c, g);\n    line(v(lean * .35, h * .47, 0), v(lean, h, 0), back ? .24 : .30, c, g);\n    for (let k = -1; k <= 1; k++) line(v(0, .32, 0), v(k * .8, -.03, .4), .14, c, g);\n    for (let i = 0; i < 6; i++) {\n      const s = sphere(lean + range(-2.0, 2.0), h + range(-.1, 1.0), range(-.4, .4), range(1.3, 2), back ? P.dark : P.leaf, g, 1.5, .65, .9, 0, !back);\nconst SEAT_COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nconst utfEncode = value => btoa(unescape(encodeURIComponent(JSON.stringify(value))));\nconst utfDecode = value => JSON.parse(decodeURIComponent(escape(atob(String(value).trim()))));\nconst uniqueId = () => globalThis.crypto?.randomUUID?.() || `${Date.now()}-${performance.now()}`;\n\n/** Independent, noncolliding explorers. The hub owns all transport in a hub round. */\nexport class ExpeditionNetwork {\n  constructor(callbacks = {}) {\n    this.callbacks = callbacks;\n    this.hubActive = false;\n    this.started = false;\n    this.ended = false;\n    this.players = [];\n    this.me = null;\n    this.host = null;\n    this.mode = 'solo';\n    this.sent = 0;\n    this.received = 0;\n    this._sendClock = 0;\n    this._progressClock = 1;\n    this._reported = false;\n    this._peers = new Map();\n    this._roster = new Map();\n    this._off = [];\n    this._lastScore = 0;\n    this._lastStats = {};\n  }\n  get active() { return this.hubActive || this.mode !== 'solo'; }\n  _call(name, ...args) { this.callbacks[name]?.(...args); }\n  _status(text) { this.status = text; this._call('onStatus', text); }\n  async init() {\n    const hub = globalThis.AIHub;\n    if (!hub?.active) return null;\n    this.hubActive = true;\n    this.mode = 'hub';\n    this._off.push(hub.on('start', data => {\n      this.started = true;\n      this.ended = false;\n      this._reported = false;\n      this._call('onStart', { ...this.info, ...data, hub: true });\n    }));\n    this._off.push(hub.on('message', (data, from) => {\n      if (this.ended || data?.kind !== 'ghost') return;\n      const player = this.players.find(p => p.id === from);\n      this.received++;\n      this._call('onGhost', { ...this._cleanGhost(data), name: player?.name || `Explorer ${from + 1}`, color: player?.color || SEAT_COLORS[from % 4] }, from);\n    }));\n    this._off.push(hub.on('leave', data => {\n      this.players = this.players.filter(p => p.id !== data.id);\n      this._call('onLeave', data.id);\n    }));\n    this._off.push(hub.on('time-up', data => {\n      if (this.ended) return;\n      this._call('onTimeUp', data);\n      if (!this._reported) this.result(this._lastScore, this._lastStats);\n    }));\n    this._off.push(hub.on('end', data => {\n      this.ended = true;\n      this.started = false;\n      this._call('onEnd', data);\n    }));\n    const info = await hub.connect({ mode: 'ghost', seats: [1, 4] });\n    if (!info) {\n      this.hubActive = false;\n      this.mode = 'solo';\n      this._off.splice(0).forEach(off => off());\n      return null;\n    }\n    this.info = info;\n    this.me = info.me;\n    this.host = info.host;\n    this.players = info.players;\n    this._status('AI Hub expedition connected');\n    return info;\n  }\n  ready() { if (this.hubActive && !this.ended) globalThis.AIHub.ready(); }\n  _cleanGhost(data) {\n    const num = (v, fallback = 0) => Number.isFinite(Number(v)) ? Number(v) : fallback;\n    return {\n      x: Math.max(-20, Math.min(310, num(data.x))),\n      y: Math.max(-20, Math.min(20, num(data.y))),\n      vx: num(data.vx), vy: num(data.vy), facing: data.facing < 0 ? -1 : 1,\n      grounded: !!data.grounded, climbing: !!data.climbing, swinging: !!data.swinging,\n      score: Math.max(0, num(data.score)), relics: Math.max(0, Math.min(6, num(data.relics))),\n      finished: !!data.finished,\n    };\n  }\n  tick(state, dt) {\n    this._lastScore = Number(state.score) || 0;\n    this._lastStats = { Relics: state.collected?.size ?? state.relics ?? 0 };\n    if (!this.active || !this.started || this.ended) return;\n    if (this.hubActive && globalThis.AIHub.time() < 0) return;\n    this._sendClock += dt;\n    this._progressClock += dt;\n    if (this._sendClock >= 0.1) {\n      this._sendClock %= 0.1;\n      const p = state.player || state;\n      const packet = { kind: 'ghost', ...this._cleanGhost({ ...p, score: this._lastScore, relics: this._lastStats.Relics, finished: this._reported }) };\n      this._send(packet);\n    }\n    if (this._progressClock >= 1) {\n      this._progressClock %= 1;\n      if (this.hubActive) globalThis.AIHub.progress({ score: this._lastScore, label: `${this._lastStats.Relics}/6 relics` });\n    }\n  }\n  result(score, stats = {}) {\n    if (this.ended || this._reported) return;\n    this._reported = true;\n    this._lastScore = Number(score) || 0;\n    if (this.hubActive) globalThis.AIHub.result({ score: this._lastScore, stats });\n    else if (this.active) this._send({ kind: 'result', score: this._lastScore, stats });\n  }\n  _send(data) {\n    if (this.ended) return;\n    if (this.hubActive) {\n      if (globalThis.AIHub.send(data, { reliable: false })) this.sent++;\n      return;\n    }\n    const envelope = { v: 1, from: this.me, data };\n    if (this._channel) this._channel.postMessage(envelope);\n    else {\n      const text = JSON.stringify(envelope);\n      for (const peer of this._peers.values()) if (peer.channel?.readyState === 'open') peer.channel.send(text);\n    }\n    this.sent++;\n  }\n  _receive(envelope, sourcePeer = null) {\n    if (this.hubActive || !envelope || envelope.v !== 1 || envelope.from === this.me) return;\n    const { from, data } = envelope;\n    if (!data || typeof data.kind !== 'string') return;\n    this.received++;\n    if (this.mode === 'rtc' && this.me === this.host && sourcePeer) {\n      const text = JSON.stringify(envelope);\n      for (const peer of this._peers.values()) if (peer !== sourcePeer && peer.channel?.readyState === 'open') peer.channel.send(text);\n    }\n    if (data.kind === 'hello') {\n      if (this.mode !== 'local') return;\n      this._roster.set(from, { id: from, joined: Number(data.joined) || Date.now(), seen: Date.now() });\n      this._refreshLocalRoster();\n      if (!data.reply) this._send({ kind: 'hello', joined: this._joined, reply: true });\n    } else if (data.kind === 'roster' && this.mode === 'rtc') {\n      this.players = Array.isArray(data.players) ? data.players.slice(0, 4) : [];\n      this._status(`${this.players.length}/4 explorers connected`);\n    } else if (data.kind === 'ghost' && !this.ended) {\n      const p = this.players.find(p => p.id === from);\n      this._call('onGhost', { ...this._cleanGhost(data), name: p?.name || 'Explorer', color: p?.color || SEAT_COLORS[1] }, from);\n    } else if (data.kind === 'start') {\n      if (from !== this.host) return;\n      this._beginStandalone(data.startAt);\n    } else if (data.kind === 'leave') {\n      this._roster.delete(from);\n      this.players = this.players.filter(p => p.id !== from);\n      if (this.mode === 'local') this._refreshLocalRoster();\n      this._call('onLeave', from);\n      this._status(`${this.players.length}/4 explorers connected`);\n    } else if (data.kind === 'result') {\n      this._call('onGhost', { finished: true, score: Number(data.score) || 0, result: true }, from);\n    }\n  }\n  _guardStandalone() {\n","exit_code":0,"status":"completed"}}
