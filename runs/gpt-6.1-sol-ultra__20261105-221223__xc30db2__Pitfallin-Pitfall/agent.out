{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"rg -n 'Check|setTimeout|limit|scenario' vendor/harness.html | tail -50\"","aggregated_output":"67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n192:    limitMs,\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n383:const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n408:    renderChecks(checks);\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n532:function renderChecks(checks) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='app.js';s=open(p).read();s=s.replace(\\\"ghosts.set(from,{...data,seen:performance.now()});\\\", \\\"ghosts.set(from,{...ghosts.get(from),...data,seen:performance.now()});\\\")\ns=s.replace(\\\"if(game.mode==='title'&&\"'!panelStack.length&&now-lastInput>=10000)\",\"if(game.mode==='\"'title'&&now-lastInput>=10000)\\\")\ns=s.replace(\\\"{game.start(true);\"'$('\"'#title').classList.add('hidden');\\\", \\\"{panelStack=[];\"'$('\"'#panel-container').innerHTML='';game.start(true);\"'$('\"'#title').classList.add('hidden');\\\")\nopen(p,'w').write(s)\nPY\ncat > test.py <<'PY'\n\\\"\\\"\\\"One command: npm test. Prints failures and a single aggregate count.\\\"\\\"\\\"\nimport asyncio,json,os,re,subprocess,sys\nfrom pathlib import Path\nfrom playwright.async_api import async_playwright\nROOT=Path(__file__).resolve().parent\nos.environ['TMPDIR']=str(ROOT)\nchecks=0\nfailures=[]\ndef check(ok,label,detail=''):\n global checks\n checks+=1\n if not ok: failures.append(label+(': '+str(detail) if detail else ''))\ndef run_node(name):\n global checks\n result=subprocess.run(['node',name],cwd=ROOT,capture_output=True,text=True)\n m=re.search(r'(\\\\d+) .*checks passed, (\\\\d+) failed',result.stdout)\n if m: checks+=int(m.group(1))+int(m.group(2))\n if result.returncode: failures.append(name+': '+result.stdout.strip()+' '+result.stderr.strip())\nasync def browser_tests():\n async with async_playwright() as p:\n  browser=await p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n  page=await browser.new_page(viewport={'width':1440,'height':900})\n  errors=[]\n  page.on('pageerror',lambda e:errors.append(str(e)))\n  await page.goto((ROOT/'index.html').as_uri())\n  await page.wait_for_function('window.__gameReady||window.__bootError',timeout=120000)\n  check(await page.title()=='Pitfallin’ — A little danger. A lot of jungle.','Game identity')\n  check(await page.evaluate('\"'!!window.__gameReady&&!window.__bootError'\"'),'Self-contained file boot')\n  s=await page.evaluate('window.__pitfallin.state')\n  check(s['renderer']=='WebGPU','WebGPU backend')\n  check(s['audio']['musicVolume']==.1,'Music default is ten percent')\n  check(set(s['animations'])=={'idle','run','jump','climb','swing'},'Native animation clips')\n  # Keyboard starts the same menus that the controller uses.\n  await page.keyboard.press('Enter')\n  await page.wait_for_timeout(400)\n  check(await page.evaluate('window.__pitfallin.state.mode')=='playing','Keyboard title selection')\n  before=await page.evaluate('window.__pitfallin.state.player.x')\n  await page.keyboard.down('d');await page.wait_for_timeout(450);await page.keyboard.up('d')\n  after=await page.evaluate('window.__pitfallin.state.player.x')\n  check(after>before+1,'Native keyboard movement',(before,after))\n  await page.keyboard.press('Space');await page.wait_for_timeout(150)\n  check(await page.evaluate('window.__pitfallin.state.stats.jumps')>=1,'Keyboard jump')\n  await page.keyboard.press('Escape');await page.wait_for_timeout(100)\n  check(await page.evaluate('window.__pitfallin.state.panel')=='pause','Pause menu')\n  frozen=await page.evaluate('window.__pitfallin.state.remaining');await page.wait_for_timeout(180)\n  check(await page.evaluate('window.__pitfallin.state.remaining')==frozen,'Solo pause freezes clock')\n  await page.click('[data-action=\\\"dev\\\"]')\n  await page.locator('#tune-speed').fill('9.5');await page.locator('#tune-speed').dispatch_event('input')\n  await page.click('#dev-invincible')\n  check(await page.evaluate('window.__pitfallin.state.tuning.speed===9.5&&window.__pitfallin.state.dev.invincible'),'Live developer tuning')\n  await page.click('[data-action=\\\"dev-reset\\\"]')\n  check(await page.evaluate('window.__pitfallin.state.tuning.speed===7.2&&\"'!window.__pitfallin.state.dev.invincible'\"'),'Developer reset defaults')\n  await page.click('[data-action=\\\"dev-resume\\\"]')\n  await page.keyboard.press('m');await page.wait_for_timeout(100)\n  check(await page.evaluate('window.__pitfallin.state.panel')=='map','Field map keyboard shortcut')\n  check(await page.locator('.relic-row').count()==6,'Map lists six meaningful relics')\n  await page.keyboard.press('Escape')\n  # Controller shim, standard mapping; Options+Create must be ignored.\n  await page.evaluate('''() => { window.testPad={id:'DualSense test',connected:true,index:0,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))};navigator.getGamepads=()=>[window.testPad];}''')\n  async def pad(i):\n   await page.evaluate('(i)=>{testPad.buttons[i]={pressed:true,value:1};}',i);await page.wait_for_timeout(100)\n   await page.evaluate('(i)=>{testPad.buttons[i]={pressed:false,value:0};}',i);await page.wait_for_timeout(90)\n  await pad(9)\n  check(await page.evaluate('window.__pitfallin.state.panel')=='pause','Controller Options pauses')\n  await pad(0)\n  check(await page.evaluate('window.__pitfallin.state.mode')=='playing','Controller Cross selects Resume')\n  await page.evaluate('testPad.buttons[8]={pressed:true,value:1}')\n  await pad(9)\n  check(await page.evaluate('\"'!window.__pitfallin.state.panel'\"'),'Create + Options belongs to hub')\n  await page.evaluate('testPad.buttons[8]={pressed:false,value:0}')\n  await pad(0)\n  check(await page.evaluate('window.__pitfallin.state.inputMethod')=='gamepad','Prompts follow controller')\n  check('glyph' in await page.locator('#controls').inner_html(),'PlayStation glyph prompts')\n  await page.evaluate('window.__pitfallin.action(\\\"settings\\\")')\n  await page.locator('#glyphs').select_option('xbox')\n  check('>A<' in await page.locator('#controls').inner_html(),'Xbox glyph option')\n  await page.evaluate('navigator.getGamepads=()=>[];window.__pitfallin.closePanel()')\n  # Offline signal provides measurable sound verification without a listener.\n  signal=await page.evaluate('''async()=>{const b=await window.__pitfallin.offlineAudio();const d=b.getChannelData(0);let sum=0,peak=0,finite=true;for(const x of d){sum+=x*x;peak=Math.max(peak,Math.abs(x));finite&&=Number.isFinite(x);}return {rms:Math.sqrt(sum/d.length),peak,finite};}''')\n  check(signal['finite'] and signal['rms']>.001 and signal['peak']<1,'Synthesized sound finite, audible and unclipped',signal)\n  # Lifecycle and real ten-second attract trigger; all input exits replay.\n  await page.evaluate('window.__pitfallin.action(\\\"title\\\")')\n  await page.wait_for_timeout(10300)\n  check(await page.evaluate('window.__pitfallin.state.mode')=='attract','Ten-second attract trigger')\n  await page.keyboard.press('x');await page.wait_for_timeout(100)\n  check(await page.evaluate('window.__pitfallin.state.mode')=='title','Input exits attract without starting')\n  await page.click('[data-action=\\\"about\\\"]')\n  for tab,count in [('sourceInformation',17),('testingFeedback',4),('engineFeedback',6),('promptFeedback',4)]:\n   await page.click('[data-credit=\\\"'+tab+'\\\"]')\n   n=await page.locator('.credit-line' if tab=='sourceInformation' else '.feedback-item').count()\n   check(n==count,'About / '+tab,n)\n  check(not errors,'No browser JavaScript errors',errors)\n  await page.close()\n  # Touch only page: same title/UI; invisible stick and context action.\n  context=await browser.new_context(viewport={'width':844,'height':390},is_mobile=True,has_touch=True,device_scale_factor=1)\n  mobile=await context.new_page();await mobile.goto((ROOT/'index.html').as_uri())\n  await mobile.wait_for_function('window.__gameReady||window.__bootError',timeout=120000)\n  await mobile.tap('[data-action=\\\"start\\\"]');await mobile.wait_for_timeout(300)\n  check(await mobile.evaluate('window.__pitfallin.state.inputMethod')=='touch','Touch input identity')\n  check(await mobile.locator('#controls').is_hidden(),'Touch minimizes persistent UI')\n  await mobile.touchscreen.tap(700,230);await mobile.wait_for_timeout(100)\n  check(await mobile.evaluate('window.__pitfallin.state.stats.jumps')>=1,'Touch right tap jumps')\n  await mobile.evaluate('window.__pitfallin.teleport(84,.03)');await mobile.wait_for_timeout(100)\n  check(await mobile.locator('#touch-action').is_visible(),'Context-sensitive touch action')\n  await mobile.tap('#touch-action');await mobile.wait_for_timeout(900)\n  check(await mobile.evaluate('window.__pitfallin.state.player.y')< -1,'Touch action begins ladder descent')\n  await context.close();await browser.close()\nasync def main():\n for file in ['simulation-tests.mjs','network-tests.mjs']:\n  if (ROOT/file).exists(): run_node(file)\n try: await browser_tests()\n except Exception as e: failures.append('Browser suite exception: '+str(e))\n if (ROOT/'hub-tests.py').exists():\n  r=subprocess.run([sys.executable,'hub-tests.py'],cwd=ROOT,capture_output=True,text=True)\n  m=re.search(r'(\\\\d+) .*checks passed, (\\\\d+) failed',r.stdout)\n  if m:\n   global checks\n   checks+=int(m.group(1))+int(m.group(2))\n  if r.returncode: failures.append('Hub suite: '+r.stdout.strip()+' '+r.stderr.strip())\n try: json.loads((ROOT.parent/'exit-interview.json').read_text());check(True,'Exit interview parses')\n except FileNotFoundError: pass\n except Exception as e: check(False,'Exit interview parses',e)\n for failure in failures: print('FAIL:',failure)\n print(f'{checks-len(failures)} checks passed, {len(failures)} failed')\n return 1 if failures else 0\nsys.exit(asyncio.run(main()))\nPY\nnode --check app.js\nnode build.mjs\n/home/micha/.local/share/pipx/venvs/playwright/bin/python test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
