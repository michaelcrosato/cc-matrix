loat:left;margin-right:20px}.guide-card h3{margin:2px 0 8px}.guide-card p{font-size:14px}.pause-grid{grid-template-columns:1fr}.pause-summary{display:none}.setting{padding:13px 0}.setting label{font-size:16px}.setting small{font-size:11px}.setting-control{min-width:45%;gap:8px}.setting select{font-size:14px;padding:8px}.network-grid{grid-template-columns:1fr}.credits-tabs{gap:4px}.credits-tabs button{padding:10px 7px;font-size:11px}.credit-line{grid-template-columns:90px 1fr;font-size:13px;gap:12px}.feedback-item p{font-size:14px}.map-route{gap:4px}.map-stop{padding:15px 3px}.map-stop h3{font-size:13px}.map-stop p{font-size:9px}.map-stop .map-symbol{font-size:25px}.relic-row{padding:10px;gap:10px}.relic-row strong{font-size:13px}.relic-row small{font-size:10px}.result-stats{gap:10px}.result-stat{padding:15px 5px}.result-stat strong{font-size:36px}.result-stat small{font-size:10px}.hud-brand{gap:10px}.hud-area strong{font-size:14px}.compass{display:none}.relic-count>span{display:none}#toast{min-width:0;width:85%;padding:17px}.toast-title{font-size:24px!important}#context{font-size:15px;bottom:70px}#controls{gap:10px;font-size:11px}.route-mini{display:none}.hud-right{gap:10px}}\n@media(max-height:600px){#title .title-inner{transform:none}h1{font-size:75px;margin:12px 0 20px}.title-serial{margin-bottom:10px}.tagline{font-size:20px;margin-bottom:15px}.title-copy{display:none}.menu-stack{gap:1px}.menu-button{padding:9px 15px;font-size:17px}.menu-button.primary{padding:12px 18px}.title-bottom{bottom:15px}.panel{padding:20px 30px;max-height:94vh}.panel-head{margin-bottom:12px}.panel-head .eyebrow{font-size:10px}h2{font-size:34px}.panel-footer{margin-top:10px;padding-top:10px}.guide-icon{height:30px;font-size:28px}.guide-card{padding:15px}.guide-card h3{font-size:20px}.guide-card p{font-size:13px}#hud-top{height:75px;padding-top:10px}#objective,#score{top:82px}.setting{padding:10px 0}.credits-tabs{margin-bottom:12px;padding-bottom:10px}.map-route{margin:5px 0 15px}.map-stop{padding:12px 4px}.map-stop .map-symbol{font-size:24px;margin-bottom:7px}.result-stats{margin:20px 0}.title-bottom .edition{display:none}}\n</style></head><body>\n<div id=\"loading\"><div class=\"loading-inner\"><div class=\"loading-mark\"></div><div class=\"eyebrow\">An expedition is taking shape</div><p id=\"loading-text\">Growing the jungle…</p></div></div>\n<div id=\"vignette\"></div><main id=\"ui\">\n<section id=\"title\"><div class=\"title-inner\"><div class=\"title-serial eyebrow\">An ink & adventure expedition · No. 01</div><h1>Pitfallin<span class=\"apostrophe\">’</span></h1><p class=\"tagline\">A little danger.<br>A lot of jungle.</p><p class=\"title-copy\">Six lost sun relics. One intrepid explorer.<br>Try to keep your hat on.</p><nav class=\"menu-stack\"><button class=\"menu-button primary\" data-action=\"start\">Into the jungle <span style=\"float:right\">↗</span></button><button class=\"menu-button\" data-action=\"online\">Ghost expedition <small>Race friends · 1–4 explorers</small></button><button class=\"menu-button\" data-action=\"guide\">Field guide</button><button class=\"menu-button\" data-action=\"settings\">Settings</button><button class=\"menu-button\" data-action=\"about\">About this expedition</button></nav></div><div class=\"scene-caption\"><span>The Fernway · Morning</span><p>Fortune favours the muddy.</p></div><div class=\"title-bottom\"><span id=\"title-prompt\">A / D to wander · Space to leap · E to catch a vine</span><div class=\"edition\">HAND-INKED<br>JUNGLE<br>ADVENTURE</div><span>Inspired by 1982<br>Made for the next leap.</span></div></section>\n<section id=\"hud\" class=\"hidden\"><div id=\"hud-top\"><div class=\"hud-brand\"><div class=\"compass\">✧</div><div class=\"hud-area\"><div class=\"eyebrow\" id=\"zone-number\">Chapter 01 / 06</div><strong id=\"zone-name\">The Fernway</strong></div></div><div class=\"relic-count\"><span style=\"margin-right:10px\">SUN RELICS</span><div id=\"relic-dots\" style=\"display:flex;gap:inherit\"></div></div><div class=\"hud-right\"><span class=\"hearts\" id=\"hearts\">♥♥♥</span><span id=\"timer\" class=\"timer\">08:00</span><button class=\"icon-btn\" data-action=\"pause\" aria-label=\"Pause expedition\">Ⅱ</button></div></div><div id=\"objective\"><div class=\"objective-label\">YOUR EXPEDITION</div><div id=\"objective-text\">Find six sun relics. Reach the far camp.</div></div><div id=\"score\"><div class=\"eyebrow\" style=\"font-size:10px\">FORTUNE</div><div class=\"score-number\" id=\"score-value\">0</div></div><div id=\"ghost-list\"></div><div id=\"context\" class=\"hidden\"></div><div id=\"controls\"></div><button id=\"touch-action\" class=\"hidden\">Catch vine</button><div id=\"touch-stick\" class=\"hidden\"></div></section>\n<div id=\"toast\" class=\"hidden\"><div class=\"toast-title\"></div><div class=\"toast-sub\"></div></div><div id=\"attract-banner\" class=\"hidden\"><strong>The jungle never stands still.</strong><p>Demonstration · Any input to return</p></div><div id=\"countdown\" class=\"hidden\"><span>3</span></div><div id=\"panel-container\"></div><div id=\"flash\"></div>\n</main>\n<!--APP-->\n</body></html>\nHTML\ncat > build.mjs <<'\"'JS'\nimport {build} from 'esbuild';\nimport {readFile,writeFile} from 'node:fs/promises';\nconst result=await build({entryPoints:['app.js'],bundle:true,format:'iife',target:'es2022',minify:true,write:false,legalComments:'none'});\nconst [shell,session]=await Promise.all([readFile('shell.html','utf8'),readFile('vendor/session.js','utf8')]);\nconst html=shell.replace('<\"'!--SESSION-->'\"','<script>'+session.replace(/<\\\\/script/gi,'<\\\\\\\\/script')+'</script>').replace('<\"'!--APP-->'\"','<script>'+result.outputFiles[0].text.replace(/<\\\\/script/gi,'<\\\\\\\\/script')+'</script>');\nconst filename='Pitfallin-Pitfall-gpt-6.1-sol-ultra-20261105-221223.html';\nawait writeFile('../'+filename,html);await writeFile('index.html',html);\nconsole.log('Built '+filename+' ('+(html.length/1024/1024).toFixed(2)+' MB, self-contained).');\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > shell.html <<'HTML'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<!--SESSION-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<meta name=\"theme-color\" content=\"#122e28\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Find six sun relics, then reach the far camp. More treasure and time left earn more points.\">\n<meta name=\"hub:session-howto\" content=\"Move: left stick / A D. Jump or release: Cross / Space. Catch vine: Square / E. Climb: stick up down / W S. Pause: Options / Esc.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n<title>Pitfallin’ — A little danger. A lot of jungle.</title>\n<style>\n:root{--ink:#102e28;--paper:#fff4d7;--gold:#f2c451;--red:#e77750;--muted:#b0c7ad;--line:rgba(255,244,215,.24);color-scheme:dark;font-family:'\"'Trebuchet MS',Arial,sans-serif}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);color:var(--paper)}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.45;cursor:wait}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:5px}button{border:0}canvas{display:block;position:absolute;inset:0;width:100%;height:100%;touch-action:none}#vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 55% 45%,transparent 35%,#071f2144 100%)}#ui{position:absolute;inset:0;pointer-events:none}#ui button,#ui input,#ui select,#ui textarea,.scroll{pointer-events:auto}.hidden{display:none\"'!important}.eyebrow{text-transform:uppercase;letter-spacing:.24em;font-size:13px;font-weight:800;color:var(--gold)}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:Georgia,'\"'Times New Roman',serif;font-weight:normal}h2{font-size:clamp(34px,4vw,58px);letter-spacing:-.045em}h3{font-size:27px}p{line-height:1.55}#loading{position:absolute;inset:0;z-index:30;background:#122e28;display:grid;place-items:center}.loading-inner{text-align:center}.loading-mark{width:66px;height:66px;border:2px solid #fff4d744;border-top:3px solid var(--gold);transform:rotate(45deg);margin:0 auto 32px;animation:spin 2s linear infinite}@keyframes spin{to{transform:rotate(405deg)}}#loading p{margin-top:15px;color:var(--muted)}#title{position:absolute;inset:0;background:linear-gradient(90deg,#0d2a26f5 0%,#0d2a26dc 26%,#0d2a2655 52%,transparent 72%);display:flex;align-items:center;padding:5vh 6vw}#title .title-inner{width:48%;max-width:720px;transform:translateY(-2vh)}.title-serial{display:flex;align-items:center;gap:15px;margin-bottom:3vh}.title-serial:before{content:'';display:block;width:42px;height:2px;background:var(--gold)}h1{font-size:clamp(72px,9.5vw,168px);line-height:.88;letter-spacing:-.085em;color:var(--gold);text-shadow:3px 4px 0 #071e20;transform:rotate(-3deg);transform-origin:left center;margin:2.5vh 0 4vh}h1 .apostrophe{font-size:.8em}.tagline{font-family:Georgia,serif;font-style:italic;font-size:clamp(20px,2.1vw,34px);max-width:410px}.title-copy{color:#c4d3b9;font-size:16px;max-width:380px;margin:16px 0 27px}.menu-stack{display:flex;flex-direction:column;align-items:flex-start;gap:6px}.menu-button{background:transparent;border-radius:2px;padding:12px 18px;color:var(--paper);min-width:285px;text-align:left;font-size:20px;font-weight:bold;transition:background .15s,transform .15s}.menu-button:hover,.menu-button.focused{background:var(--paper);color:var(--ink);transform:translateX(7px)}.menu-button.primary{background:var(--gold);color:var(--ink);padding:17px 22px;margin-bottom:7px;box-shadow:5px 5px 0 #061a1a}.menu-button.primary:hover,.menu-button.primary.focused{background:#ffe594;transform:translateX(7px)}.menu-button small{font-size:12px;font-weight:normal;display:block;opacity:.7;margin-top:4px}.title-bottom{position:absolute;bottom:4vh;left:6vw;right:5vw;display:flex;justify-content:space-between;align-items:center;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#b9c9af}.edition{border:1px solid #fff4d74d;border-radius:50%;width:100px;height:100px;display:grid;place-items:center;text-align:center;transform:rotate(10deg);line-height:1.6;color:var(--gold)}.scene-caption{position:absolute;right:6vw;bottom:18vh;border-left:2px solid var(--gold);padding:10px 18px;background:#102e2855;backdrop-filter:blur(5px)}.scene-caption span{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:#dce6cb}.scene-caption p{font-family:Georgia,serif;font-size:25px;margin-top:7px}#hud{position:absolute;inset:0;pointer-events:none}#hud-top{height:100px;padding:24px 4vw;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#0b2529e8,transparent)}.hud-brand{display:flex;align-items:center;gap:16px}.compass{height:42px;width:42px;border:1px solid #f2c451aa;border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:28px}.hud-area .eyebrow{font-size:10px}.hud-area strong{display:block;font-size:19px;margin-top:4px}.relic-count{display:flex;gap:8px;align-items:center;font-size:15px}.relic-dot{width:19px;height:25px;border:2px solid var(--gold);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);background:#142f2877}.relic-dot.found{background:var(--gold)}.hud-right{display:flex;align-items:center;gap:25px}.hearts{letter-spacing:.2em;color:#ed8b6b;font-size:26px}.timer{font-variant-numeric:tabular-nums;font-size:24px;letter-spacing:.07em}.timer.low{color:#ff947b;animation:pulse 1s alternate infinite}@keyframes pulse{to{opacity:.5}}.icon-btn{background:#102e2877;color:var(--paper);border:1px solid #fff4d750;border-radius:50%;width:46px;height:46px;font-size:20px;display:grid;place-items:center;pointer-events:auto}#objective{position:absolute;top:112px;left:4vw;font-size:14px;color:#e4e9cd;text-shadow:1px 2px 2px #102e28}.objective-label{font-size:10px;letter-spacing:.19em;color:var(--gold);margin-bottom:6px}#score{position:absolute;top:112px;right:4vw;text-align:right}.score-number{font-size:22px;font-variant-numeric:tabular-nums}#context{position:absolute;bottom:100px;left:50%;transform:translateX(-50%);padding:12px 22px;border:1px solid #f2c45177;border-radius:3px;background:#102e28df;font-size:18px;white-space:nowrap}kbd,.glyph{display:inline-grid;min-width:28px;height:28px;padding:0 7px;place-items:center;border:1px solid currentColor;border-radius:5px;margin-right:8px;font-size:15px;font-family:inherit;font-weight:bold;vertical-align:middle}.glyph{border-radius:50%;padding:0;min-width:29px;height:29px}#controls{position:absolute;bottom:28px;left:4vw;right:4vw;display:flex;gap:25px;font-size:13px;align-items:center;color:var(--paper);text-shadow:0 1px 4px #102e28}.controls-spacer{flex:1}.route-mini{width:180px;height:4px;background:#fff4d744;position:relative}.route-mini i{position:absolute;height:10px;width:10px;background:var(--gold);border:2px solid var(--ink);top:-3px;transform:rotate(45deg)}#toast{position:absolute;top:24%;left:50%;transform:translateX(-50%);text-align:center;padding:18px 34px;border-top:2px solid var(--gold);background:linear-gradient(90deg,transparent,#102e28ec 18%,#102e28ec 82%,transparent);min-width:440px;pointer-events:none;transition:opacity .3s}#toast .toast-title{font-family:Georgia,serif;font-size:30px}#toast .toast-sub{font-size:12px;margin-top:7px;color:var(--gold);text-transform:uppercase;letter-spacing:.18em}.panel-shade{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:5vh 6vw;background:#061f22c9;backdrop-filter:blur(12px)}.panel{width:min(980px,91vw);max-height:90vh;border-top:3px solid var(--gold);padding:35px 42px;background:linear-gradient(135deg,#18382f,#102c29);box-shadow:12px 16px 0 #041c1b77;display:flex;flex-direction:column;pointer-events:auto}.panel.wide{width:min(1200px,92vw)}.panel-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}.panel-head .eyebrow{margin-bottom:9px}.back-button{background:transparent;color:var(--paper);font-size:16px;border-bottom:1px solid #fff4d755;padding:10px 0}.scroll{overflow:auto;scrollbar-color:var(--gold) #16372e;scrollbar-width:thin;padding:0 8px 6px 0}.panel-footer{border-top:1px solid var(--line);padding-top:15px;margin-top:20px;font-size:13px;color:var(--muted);display:flex;justify-content:space-between}.button-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}.btn{background:var(--paper);color:var(--ink);padding:14px 23px;border-radius:2px;font-size:17px;font-weight:bold}.btn.gold{background:var(--gold)}.btn.outline{background:transparent;color:var(--paper);border:1px solid #fff4d755}.btn:hover,.btn.focused{background:#ffe39a;color:var(--ink);box-shadow:0 0 0 3px #f2c45155}.pause-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px}.pause-summary{border-left:1px solid var(--line);padding:10px 0 0 30px}.large-number{font-family:Georgia,serif;font-size:70px;color:var(--gold);line-height:1.1}.pause-summary p{font-size:17px;color:var(--muted);margin:13px 0}.setting{padding:18px 0;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px}.setting label{font-size:19px}.setting small{display:block;color:var(--muted);font-size:13px;margin-top:5px}.setting-control{display:flex;align-items:center;gap:18px;min-width:42%}.setting input[type=range]{width:100%;accent-color:var(--gold);height:26px}.setting output{min-width:45px;color:var(--gold);font-variant-numeric:tabular-nums}.setting select{background:#0d2726;color:var(--paper);padding:10px 15px;border:1px solid #fff4d755;font-size:17px;max-width:100%}.toggle{background:#0c2824;color:var(--gold);border:1px solid #f2c45188;padding:10px 20px;font-size:16px;min-width:85px}.toggle[aria-pressed=true]{background:var(--gold);color:var(--ink)}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.guide-card{padding:22px;border:1px solid var(--line);background:#fff4d705}.guide-icon{font-size:42px;color:var(--gold);height:60px}.guide-card h3{margin:12px 0;font-size:26px}.guide-card p{font-size:16px;color:#c2d4bb}.guide-card strong{color:var(--paper)}.guide-note{margin-top:22px;color:var(--gold);font-family:Georgia,serif;font-size:22px;font-style:italic}.map-route{position:relative;display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin:15px 0 25px}.map-stop{position:relative;text-align:center;padding:25px 5px 15px;border:1px solid #fff4d729;background:#102b25}.map-stop.active{border-color:var(--gold);background:#f2c45112}.map-stop .map-symbol{font-size:36px;color:var(--gold);margin-bottom:12px}.map-stop h3{font-size:20px;margin-bottom:8px}.map-stop p{font-size:11px;color:var(--muted)}.map-relics{display:grid;grid-template-columns:1fr 1fr;gap:12px}.relic-row{display:flex;align-items:center;gap:18px;background:#08251f88;padding:16px}.relic-row .mark{font-size:25px;color:var(--gold)}.relic-row strong{font-size:17px}.relic-row small{display:block;color:var(--muted);margin-top:5px;font-size:12px}.credits-tabs{display:flex;gap:8px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:24px}.credits-tabs button{font-size:15px;padding:12px 16px;background:transparent;color:var(--muted);border:1px solid #fff4d733}.credits-tabs button.selected{color:var(--ink);background:var(--gold)}.credit-line{display:grid;grid-template-columns:145px 1fr;gap:20px;padding:10px 0;border-bottom:1px solid #fff4d714;font-size:16px;line-height:1.5}.credit-line dt{color:var(--gold);font-weight:bold}.credit-line dd{margin:0;color:#dae1c8}.feedback-item{margin-bottom:23px}.feedback-item h3{font-family:inherit;font-weight:bold;font-size:17px;color:var(--gold);margin-bottom:8px}.feedback-item p{font-size:16px;color:#d1ddc3}.network-status{color:var(--gold);font-size:17px;margin:8px 0 22px}.network-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.network-grid section{border:1px solid var(--line);padding:22px}.network-grid h3{font-size:27px;margin-bottom:12px}.network-grid p{color:var(--muted);font-size:14px}.code-input{display:block;resize:vertical;min-height:80px;width:100%;background:#09251f;color:var(--paper);border:1px solid #fff4d755;margin-top:15px;padding:13px;font-size:14px}.room-input{background:#0d2823;border:1px solid var(--line);color:var(--paper);width:100%;padding:13px;margin-top:16px;font-size:18px}.network-grid .btn{font-size:14px;padding:12px 16px}.player-list{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0}.player-chip{padding:9px 16px;border:1px solid var(--line);font-size:15px}.result-stats{display:grid;grid-template-columns:repeat(3,1fr);margin:30px 0;gap:25px}.result-stat{text-align:center;padding:20px;border:1px solid var(--line)}.result-stat strong{display:block;font:50px Georgia,serif;color:var(--gold)}.result-stat small{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-top:12px}.result-quote{font-size:24px;font-family:Georgia,serif;font-style:italic;color:var(--gold)}#attract-banner{position:absolute;bottom:5vh;left:50%;transform:translateX(-50%);background:#0a2926dd;border-top:2px solid var(--gold);text-align:center;padding:16px 42px;white-space:nowrap;pointer-events:none}#attract-banner strong{font-family:Georgia,serif;font-size:26px;color:var(--gold)}#attract-banner p{font-size:13px;margin-top:5px;letter-spacing:.12em;text-transform:uppercase}#countdown{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none}#countdown span{font:160px Georgia,serif;color:var(--gold);text-shadow:5px 6px 0 var(--ink)}#ghost-list{position:absolute;right:4vw;top:165px;display:flex;flex-direction:column;gap:6px;text-align:right}.ghost-tag{font-size:13px;padding:6px 10px;background:#102e28bb;border-right:3px solid var(--gold)}#touch-action{position:absolute;right:5vw;bottom:8vh;border:2px solid #fff4d799;background:#18382fcc;color:var(--paper);border-radius:50%;width:86px;height:86px;font-size:13px;pointer-events:auto;white-space:normal}#touch-stick{position:absolute;width:80px;height:80px;border:1px solid #fff4d733;border-radius:50%;pointer-events:none;background:#fff4d708;transform:translate(-50%,-50%)}#touch-stick:after{content:'';position:absolute;width:22px;height:22px;background:#fff4d766;border-radius:50%;left:28px;top:28px}body.touch #controls{display:none}body.touch #objective{font-size:12px;top:88px}body.touch #hud-top{height:78px;padding-top:14px}body.touch #score{top:92px}body.touch .relic-count{gap:5px}body.touch .relic-dot{width:13px;height:18px}body.touch .hud-right{gap:12px}body.touch .hearts{font-size:20px}body.touch .timer{font-size:20px}#flash{position:absolute;inset:0;background:#ed705333;pointer-events:none;opacity:0}.danger{color:#f2a16c}\n@media(min-width:1800px){.eyebrow{font-size:17px}.title-copy{font-size:21px;max-width:490px}.menu-button{font-size:25px;min-width:360px}.title-bottom{font-size:15px}.panel{padding:45px 55px}.setting label{font-size:23px}.guide-card p{font-size:20px}#hud-top{height:125px}.hud-area strong{font-size:25px}#objective,#score{top:135px}.hud-area .eyebrow{font-size:13px}.relic-dot{width:24px;height:31px}.timer{font-size:30px}#controls{font-size:17px}.credit-line,.feedback-item p{font-size:20px}}\n@media(max-width:800px){#title{padding:4vh 7vw}.title-inner{width:70%\"'!important}h1{font-size:84px}.title-serial{margin-bottom:20px}.title-copy{display:none}.tagline{font-size:22px;margin-bottom:22px}.menu-button{font-size:18px;min-width:240px;padding:10px 14px}.scene-caption,.edition{display:none}.title-bottom{font-size:9px}.panel{padding:22px 24px;max-height:94vh}.panel-head{margin-bottom:15px}.panel-head .eyebrow{font-size:10px}h2{font-size:35px}.guide-grid{grid-template-columns:1fr}.guide-card{padding:15px}.guide-icon{float:left;margin-right:20px}.guide-card h3{margin:2px 0 8px}.guide-card p{font-size:14px}.pause-grid{grid-template-columns:1fr}.pause-summary{display:none}.setting{padding:13px 0}.setting label{font-size:16px}.setting small{font-size:11px}.setting-control{min-width:45%;gap:8px}.setting select{font-size:14px;padding:8px}.network-grid{grid-template-columns:1fr}.credits-tabs{gap:4px}.credits-tabs button{padding:10px 7px;font-size:11px}.credit-line{grid-template-columns:90px 1fr;font-size:13px;gap:12px}.feedback-item p{font-size:14px}.map-route{gap:4px}.map-stop{padding:15px 3px}.map-stop h3{font-size:13px}.map-stop p{font-size:9px}.map-stop .map-symbol{font-size:25px}.relic-row{padding:10px;gap:10px}.relic-row strong{font-size:13px}.relic-row small{font-size:10px}.result-stats{gap:10px}.result-stat{padding:15px 5px}.result-stat strong{font-size:36px}.result-stat small{font-size:10px}.hud-brand{gap:10px}.hud-area strong{font-size:14px}.compass{display:none}.relic-count>span{display:none}#toast{min-width:0;width:85%;padding:17px}.toast-title{font-size:24px!important}#context{font-size:15px;bottom:70px}#controls{gap:10px;font-size:11px}.route-mini{display:none}.hud-right{gap:10px}}\n@media(max-height:600px){#title .title-inner{transform:none}h1{font-size:75px;margin:12px 0 20px}.title-serial{margin-bottom:10px}.tagline{font-size:20px;margin-bottom:15px}.title-copy{display:none}.menu-stack{gap:1px}.menu-button{padding:9px 15px;font-size:17px}.menu-button.primary{padding:12px 18px}.title-bottom{bottom:15px}.panel{padding:20px 30px;max-height:94vh}.panel-head{margin-bottom:12px}.panel-head .eyebrow{font-size:10px}h2{font-size:34px}.panel-footer{margin-top:10px;padding-top:10px}.guide-icon{height:30px;font-size:28px}.guide-card{padding:15px}.guide-card h3{font-size:20px}.guide-card p{font-size:13px}#hud-top{height:75px;padding-top:10px}#objective,#score{top:82px}.setting{padding:10px 0}.credits-tabs{margin-bottom:12px;padding-bottom:10px}.map-route{margin:5px 0 15px}.map-stop{padding:12px 4px}.map-stop .map-symbol{font-size:24px;margin-bottom:7px}.result-stats{margin:20px 0}.title-bottom .edition{display:none}}\n</style></head><body>\n<div id=\"loading\"><div class=\"loading-inner\"><div class=\"loading-mark\"></div><div class=\"eyebrow\">An expedition is taking shape</div><p id=\"loading-text\">Growing the jungle…</p></div></div>\n<div id=\"vignette\"></div><main id=\"ui\">\n<section id=\"title\"><div class=\"title-inner\"><div class=\"title-serial eyebrow\">An ink & adventure expedition · No. 01</div><h1>Pitfallin<span class=\"apostrophe\">’</span></h1><p class=\"tagline\">A little danger.<br>A lot of jungle.</p><p class=\"title-copy\">Six lost sun relics. One intrepid explorer.<br>Try to keep your hat on.</p><nav class=\"menu-stack\"><button class=\"menu-button primary\" data-action=\"start\">Into the jungle <span style=\"float:right\">↗</span></button><button class=\"menu-button\" data-action=\"online\">Ghost expedition <small>Race friends · 1–4 explorers</small></button><button class=\"menu-button\" data-action=\"guide\">Field guide</button><button class=\"menu-button\" data-action=\"settings\">Settings</button><button class=\"menu-button\" data-action=\"about\">About this expedition</button></nav></div><div class=\"scene-caption\"><span>The Fernway · Morning</span><p>Fortune favours the muddy.</p></div><div class=\"title-bottom\"><span id=\"title-prompt\">A / D to wander · Space to leap · E to catch a vine</span><div class=\"edition\">HAND-INKED<br>JUNGLE<br>ADVENTURE</div><span>Inspired by 1982<br>Made for the next leap.</span></div></section>\n<section id=\"hud\" class=\"hidden\"><div id=\"hud-top\"><div class=\"hud-brand\"><div class=\"compass\">✧</div><div class=\"hud-area\"><div class=\"eyebrow\" id=\"zone-number\">Chapter 01 / 06</div><strong id=\"zone-name\">The Fernway</strong></div></div><div class=\"relic-count\"><span style=\"margin-right:10px\">SUN RELICS</span><div id=\"relic-dots\" style=\"display:flex;gap:inherit\"></div></div><div class=\"hud-right\"><span class=\"hearts\" id=\"hearts\">♥♥♥</span><span id=\"timer\" class=\"timer\">08:00</span><button class=\"icon-btn\" data-action=\"pause\" aria-label=\"Pause expedition\">Ⅱ</button></div></div><div id=\"objective\"><div class=\"objective-label\">YOUR EXPEDITION</div><div id=\"objective-text\">Find six sun relics. Reach the far camp.</div></div><div id=\"score\"><div class=\"eyebrow\" style=\"font-size:10px\">FORTUNE</div><div class=\"score-number\" id=\"score-value\">0</div></div><div id=\"ghost-list\"></div><div id=\"context\" class=\"hidden\"></div><div id=\"controls\"></div><button id=\"touch-action\" class=\"hidden\">Catch vine</button><div id=\"touch-stick\" class=\"hidden\"></div></section>\n<div id=\"toast\" class=\"hidden\"><div class=\"toast-title\"></div><div class=\"toast-sub\"></div></div><div id=\"attract-banner\" class=\"hidden\"><strong>The jungle never stands still.</strong><p>Demonstration · Any input to return</p></div><div id=\"countdown\" class=\"hidden\"><span>3</span></div><div id=\"panel-container\"></div><div id=\"flash\"></div>\n</main>\n<!--APP-->\n</body></html>\nHTML\ncat > build.mjs <<'\"'JS'\nimport {build} from 'esbuild';\nimport {readFile,writeFile} from 'node:fs/promises';\nconst result=await build({entryPoints:['app.js'],bundle:true,format:'iife',target:'es2022',minify:true,write:false,legalComments:'none'});\nconst [shell,session]=await Promise.all([readFile('shell.html','utf8'),readFile('vendor/session.js','utf8')]);\nconst html=shell.replace('<\"'!--SESSION-->'\"','<script>'+session.replace(/<\\\\/script/gi,'<\\\\\\\\/script')+'</script>').replace('<\"'!--APP-->'\"','<script>'+result.outputFiles[0].text.replace(/<\\\\/script/gi,'<\\\\\\\\/script')+'</script>');\nconst filename='Pitfallin-Pitfall-gpt-6.1-sol-ultra-20261105-221223.html';\nawait writeFile('../'+filename,html);await writeFile('index.html',html);\nconsole.log('Built '+filename+' ('+(html.length/1024/1024).toFixed(2)+' MB, self-contained).');\nJS\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The core mechanics are implemented. Simulation checks passed for movement, ladder travel, vine catches and releases, hazard damage, checkpoints, treasure collection, completion, and the attract loop. I’m now connecting the presentation and menus, then I’ll test the game in a browser and through the AI Hub harness.\n"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > report.json <<'JSON'\n{\n \\\"sourceInformation\\\":{\\\"date\\\":\\\"2026-11-05 22:12:23\\\",\\\"source\\\":\\\"Pitfall\"'! (1982)\",\"plan\":\"none\",\"genre\":\"Action-adventure platformer\",\"perspective\":\"2.5D side-scrolling orthographic camera\",\"tech\":\"Three.js 0.180.0; WebGPURenderer (WebGPU primary, WebGL2 compatibility); Rapier 0.19.3; Gamepad API; Web Audio; WebRTC; AI Hub Session Protocol v1\",\"artDirection\":\"Procedural cel-shaded jungle, flat-shaded color planes, black ink silhouettes and warm expedition typography\",\"animation\":\"Three.js AnimationMixer and AnimationClips for explorer locomotion, climbing, jumping and swinging; procedural wildlife and foliage\",\"audio\":\"Original code-generated marimba music, percussion, ambience, effects and Animalese-style gibberish; music defaults to 10%\",\"online\":\"1–4 player ghost races through AI Hub; standalone nearby-tab rooms and manually paired WebRTC invitations\",\"testing\":\"Headless Chromium with software WebGPU, scripted simulation and browser input, simulated gamepad/touch, audio signal tests, AI Hub network harness; physical devices and listening unknown\",\"research\":\"none; native source knowledge; supplied AI Hub integration files retrieved\",\"environment\":\"Codex CLI (headless); Linux\",\"model\":\"OpenAI, gpt-6.1-sol, reasoning effort ultra\",\"usage\":\"added on import\"},\n \"testingFeedback\":[\"Testing is in progress; final counts will be recorded before release.\",\"unknown\",\"Scripted physics checks covering vine catches, ladder travel, hazards and a complete six-relic route.\",\"unknown\"],\n \"engineFeedback\":[\"Three.js makes procedural scenes and native clip animation straightforward; Rapier provides reliable character collisions.\",\"unknown\",\"The platforming state machine, vine attachment, level data, controller menus and multiplayer lifecycle.\",\"Coordinating kinematic physics, vine motion and layered side-on composition.\",\"none\",\"A compact, first-party character-controller and gamepad-menu starter would reduce setup.\"],\n \"promptFeedback\":[\"The source, visual style, controller-first UX and explicit finished-demo requirements give a clear creative target.\",\"No major ambiguity; standalone multiplayer needed a practical pairing design without a supplied signaling service.\",\"Delivering traversal, rich procedural art, accessible input and two multiplayer transports in one offline HTML.\",\"Specify whether standalone internet play should include hosted signaling or manual peer pairing.\"],\n \"aiHub\":{\"name\":\"Pitfallin’\",\"tagline\":\"A little danger. A lot of jungle.\",\"description\":\"Swing through an ink-drawn jungle, hop crocodile jaws and explore beneath the roots. Find six lost sun relics before sunset, solo or alongside your friends’ racing ghosts.\",\"type\":\"Game\",\"genre\":\"Platformer\",\"source\":\"Pitfall! (1982)\",\"series\":\"\",\"players\":\"1–4\",\"controls\":\"A/D or left stick move; Space/Cross jump or release; E/Square catch vine; W/S or stick up/down climb; M/Triangle map; Esc/Options pause. Touch: left drag moves, right tap jumps, contextual action assists.\",\"tags\":[\"side-scrolling\",\"3d\",\"adventure\",\"retro\",\"ghost-race\",\"jungle\"]}\n}\nJSON\ncat > app.js <<'\"'JS'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {Game,LEVEL,DEFAULTS} from './game.js';\nimport {createArt} from './art.js';\nimport {JungleAudio,createOfflineSample} from './audio.js';\nimport {ExpeditionNetwork} from './online.js';\nimport report from './report.json';\nconst \"'$=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];\nconst audio=new JungleAudio();let game,renderer,scene,camera,art,light,loaded=false,elapsed=0,lastInput=performance.now(),inputMethod='\"'keyboard',panelStack=[],panelOrigin='title',toastUntil=0,startDeadline=0,hubPending=null,ended=false,cameraX=20,cameraY=2.6,shake=0,menuFocus=0,frameCount=0;\nconst keys=new Set(),taps={jump:false,grab:false,drop:false};const touch={id:null,x:0,y:0,dx:0,dy:0};let oldButtons=[],navCooldown=0,gamepadX=0,gamepadY=0;\nlet settings={music:.1,sfx:.65,glyphs:'ps',shake:true,autoGrab:false};try{Object.assign(settings,JSON.parse(localStorage.getItem('pitfallin-settings')||'{}'));}catch{}\naudio.setMusic(settings.music);audio.setSfx(settings.sfx);\nconst ghosts=new Map();\nconst network=new ExpeditionNetwork({onStart(info){if(\"'!loaded){hubPending=info;return;}startRace(info);},onEnd(data){ended=true;game.mode='\"'ended';panelStack=[];\"'$('\"'#panel-container').innerHTML='';audio.stop();\"'$('\"'#context').classList.add('hidden');toast('Expedition complete','The hub is preparing the results',100000);},onTimeUp(){if(game&&\"'!game.finished){game.complete(false,'\"'The expedition clock has run out.');handleEvents();}network.result(game?.score||0,game?.stats||{});},onGhost(data,from){if(ended)return;ghosts.set(from,{...data,seen:performance.now()});art?.makeGhost(from,data.color||'#7be0c9');},onLeave(id){ghosts.delete(id);art?.removeGhost(id);updateNetworkStatus();},onStatus(text){const s=\"'$('\"'#network-status');if(s)s.textContent=text;updateNetworkStatus();}});\nconst networkReady=network.init();\nconst prompts={keyboard:{jump:'<kbd>Space</kbd>',grab:'<kbd>E</kbd>',climb:'<kbd>W S</kbd>',map:'<kbd>M</kbd>',pause:'<kbd>Esc</kbd>',move:'<kbd>A D</kbd>'},ps:{jump:'<span class=\\\"glyph\\\">×</span>',grab:'<span class=\\\"glyph\\\">□</span>',climb:'<span class=\\\"glyph\\\">↕</span>',map:'<span class=\\\"glyph\\\">△</span>',pause:'<span class=\\\"glyph\\\">☰</span>',move:'<span class=\\\"glyph\\\">L</span>'},xbox:{jump:'<span class=\\\"glyph\\\">A</span>',grab:'<span class=\\\"glyph\\\">X</span>',climb:'<span class=\\\"glyph\\\">↕</span>',map:'<span class=\\\"glyph\\\">Y</span>',pause:'<span class=\\\"glyph\\\">☰</span>',move:'<span class=\\\"glyph\\\">L</span>'}};\nfunction promptFor(action){return (inputMethod==='gamepad'?prompts[settings.glyphs]:prompts.keyboard)[action]||'';}\nfunction saveSettings(){try{localStorage.setItem('pitfallin-settings',JSON.stringify(settings));}catch{}}\nfunction setInput(type){if(inputMethod===type)return;inputMethod=type;document.body.classList.toggle('touch',type==='touch');updatePrompts();}\nfunction anyInput(type){lastInput=performance.now();setInput(type);if(game?.mode==='attract'){showTitle();return true;}return false;}\nfunction updatePrompts(){if(\"'!loaded)return;$('\"'#title-prompt').textContent=inputMethod==='gamepad'?(settings.glyphs==='ps'?'× Enter · Left stick Choose · ○ Back':'A Enter · Left stick Choose · B Back'):inputMethod==='touch'?'Tap a trail. Follow your curiosity.':'A / D to wander · Space to leap · E to catch a vine';\"'$('\"'#controls').innerHTML=\"'`<span>${promptFor('\"'move')}Move</span><span>\"'${promptFor('\"'jump')}Jump / release</span><span>\"'${promptFor('\"'grab')}Catch vine</span><span>\"'${promptFor('\"'climb')}Climb</span><span class=\\\"controls-spacer\\\"></span><span>\"'${promptFor('\"'map')}Field map</span><div class=\\\"route-mini\\\"><i id=\\\"route-marker\\\"></i></div>\"'`;}\nfunction focusables(){const root=panelStack.length?$('\"'#panel-container'):game?.mode==='title'?\"'$('\"'#title'):null;return root?[...root.querySelectorAll('button,input,select,textarea')].filter(e=>e.offsetParent\"'!==null&&!e.disabled):[];}\nfunction focusElement(el){if(!el)return;$$('\"'.focused').forEach(e=>e.classList.remove('focused'));el.classList.add('focused');el.focus({preventScroll:true});el.scrollIntoView({block:'nearest'});menuFocus=Math.max(0,focusables().indexOf(el));}\nfunction focusFirst(){menuFocus=0;const els=focusables();focusElement(els.find(e=>\"'!e.classList.contains('\"'back-button'))||els[0]);}\nfunction navigateMenu(dir){const els=focusables();if(\"'!els.length)return;let idx=els.indexOf(document.activeElement);idx=(idx+dir+els.length)%els.length;focusElement(els[idx]);audio.effect('\"'menu');}\nfunction adjustControl(dir){const el=document.activeElement;if(el?.type==='range'){const step=Number(el.step)||1;el.value=String(Math.max(Number(el.min),Math.min(Number(el.max),Number(el.value)+step*dir)));el.dispatchEvent(new Event('input',{bubbles:true}));return true;}if(el?.tagName==='SELECT'){el.selectedIndex=(el.selectedIndex+dir+el.options.length)%el.options.length;el.dispatchEvent(new Event('change',{bubbles:true}));return true;}return false;}\nfunction toast(title,subtitle='',seconds=3.6){\"'$('\"'#toast .toast-title').textContent=title;\"'$('\"'#toast .toast-sub').textContent=subtitle;\"'$('\"'#toast').classList.remove('hidden');toastUntil=performance.now()+seconds*1000;}\nfunction startSolo(){if(network.hubActive)return;network.leave();ghosts.clear();for(const id of art.ghosts.keys())art.removeGhost(id);begin();}\nfunction begin(){game.start();ended=false;panelStack=[];\"'$('\"'#panel-container').innerHTML='';\"'$('\"'#title').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');\"'$('\"'#attract-banner').classList.add('hidden');\"'$('\"'#toast').classList.add('hidden');cameraX=7;cameraY=2.5;keys.clear();Object.keys(taps).forEach(k=>taps[k]=false);audio.unlock();audio.speak('hello');toast('A good day to get lost.','Six sun relics · Eight minutes · One hat',4);updatePrompts();}\nfunction startRace(info){begin();startDeadline=info.hub?0:info.startAt||Date.now()+Number(info.in||3000);game.mode='waiting';\"'$('\"'#countdown').classList.remove('hidden');}\nfunction showTitle(){if(network.hubActive)return;game.reset();game.mode='title';panelStack=[];\"'$('\"'#panel-container').innerHTML='';\"'$('\"'#title').classList.remove('hidden');\"'$('\"'#hud').classList.add('hidden');\"'$('\"'#attract-banner').classList.add('hidden');\"'$('\"'#countdown').classList.add('hidden');\"'$('\"'#toast').classList.add('hidden');lastInput=performance.now();cameraX=20;cameraY=2.6;keys.clear();focusFirst();}\nfunction panelTemplate(eyebrow,title,content,wide=false,footer='Your hat can wait. Take your time.'){return \"'`<section class=\"panel-shade\"><div class=\"panel ${wide?'\"'wide':''}\\\"><header class=\\\"panel-head\\\"><div><div class=\\\"eyebrow\\\">\"'${eyebrow}</div><h2>${title}</h2></div><button class=\"back-button\" data-action=\"back\">← Back</button></header><div class=\"scroll\">${content}</div><footer class=\"panel-footer\"><span>${footer}</span><span>${inputMethod==='\"'gamepad'?(settings.glyphs==='ps'?'○ Back · × Select':'B Back · A Select'):'Esc Back · Enter Select'}</span></footer></div></section>\"'`;}\nfunction openPanel(name){if(!loaded||ended)return;if(!panelStack.length){panelOrigin=game.mode;if(game.mode==='\"'playing')game.mode='paused';}panelStack.push(name);renderPanel(name);audio.effect('menu');}\nfunction closePanel(){if(\"'!panelStack.length)return;if(network.hubActive&&panelStack[0]==='\"'results')return;panelStack.pop();if(panelStack.length)renderPanel(panelStack.at(-1));else{\"'$('\"'#panel-container').innerHTML='';if(game.mode==='paused')game.mode=panelOrigin==='playing'?'playing':panelOrigin;}keys.clear();taps.jump=taps.grab=false;audio.effect('menu');}\nfunction pause(){if(ended||game.mode==='waiting')return;if(panelStack.length){closePanel();return;}if(game.mode==='playing')openPanel('pause');}\nfunction settingSlider(id,label,value,min,max,step,description='',suffix=''){return \"'`<div class=\"setting\"><label for=\"${id}\">${label}${description?`<small>${description}</small>`:'\"''}</label><div class=\\\"setting-control\\\"><input type=\\\"range\\\" id=\\\"\"'${id}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\"><output for=\"${id}\">${value}${suffix}</output></div></div>`;}\nfunction toggle(id,label,on,description='\"''){return \"'`<div class=\"setting\"><label>${label}${description?`<small>${description}</small>`:'\"''}</label><button id=\\\"\"'${id}\" class=\"toggle\" aria-pressed=\"${!!on}\">${on?'\"'On':'Off'}</button></div>\"'`;}\nfunction renderPanel(name){let html='\"'';\n if(name==='pause'){html=panelTemplate('Catch your breath','Between leaps.',\"'`<div class=\"pause-grid\"><nav class=\"menu-stack\"><button class=\"menu-button primary\" data-action=\"resume\">Back to the jungle →</button><button class=\"menu-button\" data-action=\"map\">Field map</button><button class=\"menu-button\" data-action=\"guide\">Field guide</button><button class=\"menu-button\" data-action=\"settings\">Settings</button>${!network.hubActive?'\"'<button class=\\\"menu-button\\\" data-action=\\\"dev\\\">Developer camp</button><button class=\\\"menu-button\\\" data-action=\\\"restart\\\">Restart expedition</button><button class=\\\"menu-button\\\" data-action=\\\"title\\\">Return to title</button>':''}</nav><aside class=\\\"pause-summary\\\"><div class=\\\"eyebrow\\\">Relics in the satchel</div><div class=\\\"large-number\\\">\"'${game.collected.size}<span style=\"font-size:28px;color:var(--muted)\"> / 6</span></div><p>${LEVEL.checkpoints[game.checkpoint].name}<br>${formatTime(game.remaining)} until sunset.</p><div class=\"eyebrow\" style=\"margin-top:28px\">Fortune</div><div style=\"font:36px Georgia,serif;margin-top:10px\">${game.score.toLocaleString()}</div></aside></div>`,false,network.hubActive?'\"'The session clock continues while paused.':'The jungle will be here when you return.');}\n if(name==='settings'){html=panelTemplate('Make yourself at home','Expedition settings.',settingSlider('music','Music',Math.round(settings.music*100),0,100,1,'Original jungle soundtrack','%')+settingSlider('sfx','Sound & voices',Math.round(settings.sfx*100),0,100,1,'Wildlife, footsteps and explorer chatter','%')+\"'`<div class=\"setting\"><label for=\"glyphs\">Controller symbols<small>Prompts follow the last input you use.</small></label><select id=\"glyphs\"><option value=\"ps\" ${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · × ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div>\"'`+toggle('\"'shake','Camera shake',settings.shake)+toggle('autoGrab','Vine catch assist',settings.autoGrab,'Catch nearby vines automatically in the air. Always enabled for touch.')+\"'`<div class=\"button-row\"><button class=\"btn outline\" data-action=\"fullscreen\">Toggle fullscreen</button><button class=\"btn outline\" data-action=\"reset-settings\">Restore settings</button></div>`);}\n if(name==='\"'guide'){html=panelTemplate('A well-thumbed field guide','Look before you leap.',\"'`<div class=\"guide-grid\"><article class=\"guide-card\"><div class=\"guide-icon\">↗</div><h3>Keep moving.</h3><p><strong>${promptFor('\"'move')}Move · \"'${promptFor('\"'jump')}Jump.</strong><br>Leap rolling logs and snakes. Walk over a camp flag to save your place and recover a heart. A tumble costs five seconds and some fortune.</p></article><article class=\\\"guide-card\\\"><div class=\\\"guide-icon\\\">〰</div><h3>Trust the vine.</h3><p><strong>\"'${promptFor('\"'grab')}Catch · \"'${promptFor('\"'jump')}Release.</strong><br>Jump near the hanging end, catch it, then release as it swings towards the far bank. Crocodile backs are safe while their jaws are closed.</p></article><article class=\\\"guide-card\\\"><div class=\\\"guide-icon\\\">◇</div><h3>Follow the roots.</h3><p><strong>\"'${promptFor('\"'climb')}Climb · \"'${promptFor('\"'map')}Map.</strong><br>Stand at a ladder and press down to explore below. Two relics hide in the caves. Collect all six, then reach the camp at the far right before sunset.</p></article></div><p class=\\\"guide-note\\\">“If the ground looks suspicious, it probably is.”</p><div class=\\\"setting\\\"><label>On a touchscreen<small>Drag the left half to move or climb. Tap the right half to jump. Vines catch automatically; a contextual button helps near vines and ladders.</small></label></div><div class=\\\"button-row\\\"><button class=\\\"btn gold\\\" data-action=\\\"back\\\">Hat on. Let's go.</button></div>\"'`,true);}\n if(name==='\"'map'){const symbols=['♧','≈','♜','〰','◇','☀'];html=panelTemplate('A pocket-sized world','The sun relic trail.',\"'`<div class=\"map-route\">${LEVEL.zones.map((z,i)=>`<div class=\"map-stop ${Math.min(5,Math.floor(game.player.x/48))===i?'\"'active':''}\\\"><div class=\\\"map-symbol\\\">\"'${symbols[i]}</div><h3>${z}</h3><p>${i===2||i===4?'\"'A secret below':'Follow the sunlight'}</p></div>\"'`).join('\"'')}</div><div class=\\\"map-relics\\\">\"'${LEVEL.relics.map((r,i)=>`<div class=\"relic-row\"><div class=\"mark\">${game.collected.has(r.id)?'\"'◆':'◇'}</div><div><strong>\"'${r.name}</strong><small>${game.collected.has(r.id)?'\"'Safely in your satchel':r.y<0?'Below ground · Follow a ladder':\"'`Above ground · ${LEVEL.zones[i]}`}</small></div></div>`).join('\"'')}</div><p style=\\\"color:var(--muted);font-size:15px;margin-top:20px\\\">Flags are checkpoints. The far camp opens after all six relics are found. You can travel back to earlier regions.</p>\"'`,true);}\n if(name==='\"'dev'){html=panelTemplate('Developer camp · live tuning','A little jungle science.',settingSlider('tune-speed','Running speed',game.tuning.speed,3,14,.1,'World units per second')+settingSlider('tune-jump','Jump strength',game.tuning.jump,6,17,.1)+settingSlider('tune-gravity','Gravity',game.tuning.gravity,10,40,.5)+settingSlider('tune-vineSpeed','Vine pace',game.tuning.vineSpeed,.25,1.7,.01)+settingSlider('tune-hazardSpeed','Wildlife & log pace',game.tuning.hazardSpeed,.2,2,.05)+toggle('dev-invincible','Invincible',game.dev.invincible)+toggle('dev-noclip','Fly through the jungle',game.dev.noclip,'Move with both axes. Collisions and gravity are bypassed.')+toggle('dev-freezeTime','Hold the sunset',game.dev.freezeTime)+\"'`<div class=\"setting\"><label for=\"warp\">Jump to a region</label><select id=\"warp\"><option value=\"\">Choose a camp…</option>${LEVEL.checkpoints.map((c,i)=>`<option value=\"${i}\">${i+1}. ${c.name}</option>`).join('\"'')}</select></div><div class=\\\"button-row\\\"><button class=\\\"btn gold\\\" data-action=\\\"dev-resume\\\">Apply & return</button><button class=\\\"btn outline\\\" data-action=\\\"dev-reset\\\">Reset defaults</button><button class=\\\"btn outline\\\" data-action=\\\"dev-refill\\\">Refill hearts & clock</button></div>\"'`);}\n if(name==='\"'about'){html=panelTemplate('Made of triangles & tall tales','About this expedition.',\"'`<nav class=\"credits-tabs\"><button data-credit=\"sourceInformation\" class=\"selected\">Source Information</button><button data-credit=\"testingFeedback\">Testing Feedback</button><button data-credit=\"engineFeedback\">Engine Feedback</button><button data-credit=\"promptFeedback\">Prompt Feedback</button></nav><div id=\"credits-content\"></div>`,true,'\"'Original game, code, geometry, animation and synthesized audio. Inspired by Pitfall\"'! (1982).'\"');}\n if(name==='online'){html=panelTemplate('Better with muddy company','Ghost expedition.',\"'`<p>Race the same jungle. See your friends as golden trail ghosts. Your relics and hazards belong to your expedition.</p><div id=\"network-status\" class=\"network-status\">Choose a way to meet.</div><div id=\"players\" class=\"player-list\"></div><div class=\"network-grid\"><section><h3>Nearby tabs</h3><p>For devices sharing this browser origin. Open another copy of the game and enter the same room word.</p><input id=\"room-name\" class=\"room-input\" aria-label=\"Room word\" maxlength=\"32\" value=\"jungle\" placeholder=\"Room word\"><div class=\"button-row\"><button class=\"btn\" data-action=\"local-join\">Join room</button></div></section><section><h3>A friend, anywhere</h3><p>One explorer makes an invitation. Their friend pastes it and sends back the reply. Pair up to three friends; keep both pages open.</p><div class=\"button-row\"><button class=\"btn\" data-action=\"rtc-offer\">Make invitation</button><button class=\"btn outline\" data-action=\"rtc-accept\">Accept invitation</button><button class=\"btn outline\" data-action=\"rtc-answer\">Use reply</button></div><textarea class=\"code-input\" id=\"network-code\" aria-label=\"Invitation or reply code\" placeholder=\"Paste an invitation or reply here. New codes appear here too.\"></textarea><button class=\"back-button\" style=\"font-size:13px\" data-action=\"copy-code\">Copy code</button></section></div><div class=\"button-row\"><button class=\"btn gold\" data-action=\"race-start\" id=\"race-start\">Start ghost race →</button><button class=\"btn outline\" data-action=\"network-leave\">Leave group</button></div><p style=\"font-size:12px;color:var(--muted);margin-top:15px\">Direct invitations use WebRTC and need a reachable peer connection. Some networks block direct peers. Nearby tabs work offline. AI Hub handles invitations and transport when played in a Hub session.</p>`,true);}\n if(name==='\"'results'){html=panelTemplate(game.won?'An expedition well spent':'The jungle keeps its secrets',game.won?'What a tall tale.':'Until next sunrise.',\"'`<p class=\"result-quote\">${game.reason}</p><div class=\"result-stats\"><div class=\"result-stat\"><strong>${game.score.toLocaleString()}</strong><small>Fortune earned</small></div><div class=\"result-stat\"><strong>${game.collected.size} / 6</strong><small>Sun relics</small></div><div class=\"result-stat\"><strong>${formatTime(Math.max(0,game.remaining))}</strong><small>Sunlight spared</small></div></div><p>${game.won?'\"'The hat survived. The boots may never recover.':'Your next great expedition is only a leap away.'}</p><div class=\\\"button-row\\\">\"'${network.hubActive?'\"'<p>Waiting for the other expeditions. The hub will show the standings.</p>':'<button class=\\\"btn gold\\\" data-action=\\\"restart\\\">One more expedition →</button><button class=\\\"btn outline\\\" data-action=\\\"title\\\">Back to base camp</button>'}</div>\"'`,false,`${game.stats.jumps} leaps · ${game.stats.swings} vine catches · ${game.deaths} tumbles`);}\n $('\"'#panel-container').innerHTML=html;if(name==='about')renderCredits('sourceInformation');if(name==='online')updateNetworkStatus();if(name==='results')\"'$('\"'.back-button')?.classList.add('hidden');focusFirst();}\nconst questionSets={testingFeedback:['How many issues did testing catch?','How many were critical or game breaking?','What was the most helpful test?','What was the least helpful test?'],engineFeedback:['What did you like most about the engine?','Did you get stuck or guess wrong?','What did you have to build yourself?','What was hardest about the engine?','What did you change in the engine, and why?','What one engine feature would you change?'],promptFeedback:['What did you like most about the prompt?','What was confusing?','What was hardest?','What would you change in the prompt?']};\nfunction renderCredits(tab){const el=\"'$('\"'#credits-content');if(\"'!el)return;$$('\"'[data-credit]').forEach(b=>b.classList.toggle('selected',b.dataset.credit===tab));el.innerHTML='';if(tab==='sourceInformation'){const dl=document.createElement('dl');dl.style.margin='0';for(const [key,value] of Object.entries(report.sourceInformation)){const row=document.createElement('div');row.className='credit-line';const dt=document.createElement('dt');dt.textContent=key.replace(/([A-Z])/g,' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase());const dd=document.createElement('\"'dd');dd.textContent=value;row.append(dt,dd);dl.append(row);}el.append(dl);}else report[tab].forEach((answer,i)=>{const article=document.createElement('article');article.className='feedback-item';const h=document.createElement('h3');h.textContent=questionSets[tab][i];const p=document.createElement('p');p.textContent=answer;article.append(h,p);el.append(article);});}\nfunction updateNetworkStatus(){const el=\"'$('\"'#players');if(el){el.innerHTML='';for(const p of network.players){const chip=document.createElement('div');chip.className='player-chip';chip.style.borderColor=p.color||'#f2c451';chip.textContent=(p.name||'Explorer')+(p.id===network.me?' · You':'');el.append(chip);}}const b=\"'$('\"'#race-start');if(b)b.disabled=network.players.length<2||network.me\"'!==network.host;}\nfunction formatTime(sec){sec=Math.max(0,Math.ceil(sec));return String(Math.floor(sec/60)).padStart(2,'\"'0')+':'+String(sec%60).padStart(2,'0');}\nasync function action(name){if(\"'!loaded||ended)return;audio.unlock();switch(name){case'\"'start':startSolo();break;case'pause':pause();break;case'back':closePanel();break;case'resume':case'dev-resume':while(panelStack.length)closePanel();break;case'title':network.leave();showTitle();break;case'restart':begin();break;case'guide':case'map':case'settings':case'about':case'dev':case'online':openPanel(name);break;case'fullscreen':try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}catch{toast('Fullscreen is unavailable.','You can still follow the trail.');}break;case'reset-settings':settings={music:.1,sfx:.65,glyphs:'ps',shake:true,autoGrab:false};audio.setMusic(.1);audio.setSfx(.65);saveSettings();renderPanel('settings');updatePrompts();break;case'dev-reset':Object.assign(game.tuning,DEFAULTS);Object.assign(game.dev,{invincible:false,noclip:false,freezeTime:false});renderPanel('dev');break;case'dev-refill':game.health=3;game.remaining=game.tuning.timeLimit;toast('Ready for more science.');break;case'local-join':network.joinLocal(\"'$('\"'#room-name').value.trim()||'jungle');updateNetworkStatus();break;case'network-leave':network.leave();ghosts.clear();for(const id of art.ghosts.keys())art.removeGhost(id);updateNetworkStatus();break;case'race-start':network.startRace();break;case'rtc-offer':case'rtc-accept':case'rtc-answer':{const button=\"'$(`[data-action=\"${name}\"]`);button.disabled=true;try{const el=$('\"'#network-code');if(name==='rtc-offer')el.value=await network.createOffer();if(name==='rtc-accept')el.value=await network.acceptOffer(el.value.trim());if(name==='rtc-answer')await network.acceptAnswer(el.value.trim());el.select();}catch(e){\"'$('\"'#network-status').textContent=e.message||String(e);}finally{button.disabled=false;}break;}case'copy-code':{const el=\"'$('\"'#network-code');try{await navigator.clipboard.writeText(el.value);toast('Code copied.','Send it through your usual messenger.');}catch{el.select();document.execCommand('copy');}break;}}}\ndocument.addEventListener('click',event=>{const b=event.target.closest('[data-action]');if(b)action(b.dataset.action);const tab=event.target.closest('[data-credit]');if(tab)renderCredits(tab.dataset.credit);if(event.target.closest('.toggle')){const el=event.target.closest('.toggle');if(el.id.startsWith('dev-')){const key=el.id.slice(4);game.dev[key]=\"'!game.dev[key];el.setAttribute('\"'aria-pressed',game.dev[key]);el.textContent=game.dev[key]?'On':'Off';}else if(el.id==='shake'||el.id==='autoGrab'){settings[el.id]=\"'!settings[el.id];el.setAttribute('\"'aria-pressed',settings[el.id]);el.textContent=settings[el.id]?'On':'Off';saveSettings();}}});\ndocument.addEventListener('input',e=>{const el=e.target;if(el.type\"'!=='\"'range')return;const val=Number(el.value),out=el.parentElement.querySelector('output');if(out)out.textContent=val+(el.id==='music'||el.id==='sfx'?'%':'');if(el.id==='music'){settings.music=val/100;audio.setMusic(settings.music);saveSettings();}else if(el.id==='sfx'){settings.sfx=val/100;audio.setSfx(settings.sfx);saveSettings();}else if(el.id.startsWith('tune-'))game.tuning[el.id.slice(5)]=val;});\ndocument.addEventListener('change',e=>{if(e.target.id==='glyphs'){settings.glyphs=e.target.value;saveSettings();updatePrompts();}if(e.target.id==='warp'&&e.target.value\"'!=='\"''){game.checkpoint=Number(e.target.value);game.respawn();toast('Camp reached.',LEVEL.checkpoints[game.checkpoint].name);}});\ndocument.addEventListener('pointerover',e=>{if(e.pointerType==='touch')return;const el=e.target.closest('button');if(el&&focusables().includes(el)){anyInput('keyboard');focusElement(el);}});\ndocument.addEventListener('keydown',e=>{if(anyInput('keyboard')){e.preventDefault();return;}audio.unlock();if(ended)return;if(['INPUT','TEXTAREA','SELECT'].includes(e.target.tagName)&&e.key\"'!=='\"'Escape'){if(e.target.type==='range'&&e.key==='Enter')return;if(e.key\"'!=='\"'ArrowUp'&&e.key\"'!=='\"'ArrowDown')return;}if([' ','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key))e.preventDefault();const menu=panelStack.length||game?.mode==='title';if(e.key==='Escape'){e.preventDefault();if(panelStack.length)closePanel();else pause();return;}if(menu){if(e.key==='ArrowDown'||e.key==='s'||e.key==='S'){navigateMenu(1);return;}if(e.key==='ArrowUp'||e.key==='w'||e.key==='W'){navigateMenu(-1);return;}if(e.key==='ArrowLeft')adjustControl(-1);if(e.key==='ArrowRight')adjustControl(1);if((e.key==='Enter'||e.key===' ')&&\"'!e.repeat){const f=focusables();const el=f.includes(document.activeElement)?document.activeElement:f[0];el?.click();e.preventDefault();}return;}if(e.repeat)return;keys.add(e.code);if(e.code==='\"'Space')taps.jump=true;if(e.code==='KeyE')taps.grab=true;if(e.code==='KeyQ')taps.drop=true;if(e.code==='KeyM'||e.code==='Tab'){e.preventDefault();openPanel('map');}});\ndocument.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();touch.dx=touch.dy=0;if(game?.mode==='playing'&&\"'!network.hubActive&&!network.started)pause();});document.addEventListener('\"'contextmenu',e=>e.preventDefault());\ndocument.addEventListener('pointerdown',e=>{const type=e.pointerType==='touch'?'touch':'keyboard';if(anyInput(type)){e.preventDefault();return;}audio.unlock();if(e.target.closest('button,input,select,textarea,.panel'))return;if(game?.mode\"'!=='\"'playing')return;if(type==='touch'){if(e.clientX<innerWidth*.5&&touch.id===null){touch.id=e.pointerId;touch.x=e.clientX;touch.y=e.clientY;touch.dx=touch.dy=0;\"'$('\"'#touch-stick').style.left=e.clientX+'px';\"'$('\"'#touch-stick').style.top=e.clientY+'px';\"'$('\"'#touch-stick').classList.remove('hidden');}else taps.jump=true;}else if(e.button===0)taps.jump=true;else if(e.button===2)taps.grab=true;});\ndocument.addEventListener('pointermove',e=>{if(e.pointerId===touch.id){touch.dx=Math.max(-1,Math.min(1,(e.clientX-touch.x)/48));touch.dy=Math.max(-1,Math.min(1,(e.clientY-touch.y)/48));}else if(e.pointerType\"'!=='\"'touch'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>0)){if(game?.mode==='attract')anyInput('keyboard');else lastInput=performance.now();}});\nfunction endTouch(e){if(e.pointerId===touch.id){touch.id=null;touch.dx=touch.dy=0;\"'$('\"'#touch-stick').classList.add('hidden');}}document.addEventListener('pointerup',endTouch);document.addEventListener('pointercancel',endTouch);\n\"'$('\"'#touch-action').addEventListener('pointerdown',e=>{e.stopPropagation();anyInput('touch');const ctx=game.context();if(ctx?.action==='jump')taps.jump=true;else if(ctx?.action==='grab')taps.grab=true;else if(ctx?.action==='climb'){touch.dy=game.player.y<-3?-1:1;touch.autoClimb=true;}});\"'$('\"'#touch-action').addEventListener('pointerup',()=>{if(touch.autoClimb){setTimeout(()=>{touch.dy=0;touch.autoClimb=false;},1800);}});\nfunction pollGamepad(dt){navCooldown=Math.max(0,navCooldown-dt);const pad=[...(navigator.getGamepads?.()||[])].find(p=>p?.connected);gamepadX=gamepadY=0;if(\"'!pad){oldButtons=[];return;}const b=pad.buttons.map(v=>v.pressed||v.value>.5);const pressed=i=>b[i]&&!oldButtons[i];const ax=pad.axes[0]||0,ay=pad.axes[1]||0;const active=Math.abs(ax)>.2||Math.abs(ay)>.2||b.some((v,i)=>v&&!oldButtons[i]);if(active){if(anyInput('\"'gamepad')){oldButtons=b;return;}audio.unlock();}if(ended){oldButtons=b;return;}gamepadX=Math.abs(ax)>.18?ax:0;gamepadY=Math.abs(ay)>.18?ay:0;const menu=panelStack.length||game?.mode==='title';if(menu){if(navCooldown===0){if(ay>.55||b[13]){navigateMenu(1);navCooldown=.23;}else if(ay<-.55||b[12]){navigateMenu(-1);navCooldown=.23;}else if(ax>.55||b[15]){adjustControl(1);navCooldown=.13;}else if(ax<-.55||b[14]){adjustControl(-1);navCooldown=.13;}}if(pressed(0)){const f=focusables();(f.includes(document.activeElement)?document.activeElement:f[0])?.click();}if(pressed(1))closePanel();}else{if(pressed(0))taps.jump=true;if(pressed(2))taps.grab=true;if(pressed(1))taps.drop=true;if(pressed(3))openPanel('map');}if(pressed(9)&&\"'!b[8])pause();oldButtons=b;}\nfunction readInput(){return {x:gamepadX||touch.dx||(keys.has('\"'KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0),y:gamepadY||touch.dy||(keys.has('KeyS')||keys.has('ArrowDown')?1:0)-(keys.has('KeyW')||keys.has('ArrowUp')?1:0),...taps,autoGrab:settings.autoGrab||inputMethod==='touch'};}\nfunction handleEvents(){for(const e of game.drainEvents()){if(['jump','land','grab','release','coin','relic','hurt','checkpoint'].includes(e.type))audio.effect(e.type);if(e.type==='start')continue;if(e.type==='relic'){toast(e.name,\"'`${game.collected.size} of 6 sun relics in the satchel`,3.5);audio.speak('\"'happy');}if(e.type==='checkpoint')toast(e.name,'Camp reached · Heart restored',2.2);if(e.type==='hurt'){toast(e.text,'Back to the last flag · −5 seconds',2.5);shake=.35;\"'$('\"'#flash').style.opacity='1';audio.speak('hurt');}if(e.type==='rescue')toast('A friendly rescue.','Hearts restored · Keep that hat on.',3);if(e.type==='notice')toast(e.text,'The field map knows the way',3.6);if(e.type==='finish'){audio.effect(e.won?'win':'death');network.result(game.score,{relics:game.collected.size,jumps:game.stats.jumps,swings:game.stats.swings,tumbles:game.deaths});panelStack=['results'];renderPanel('results');}}}\nfunction updateHUD(){const p=game.player;const zone=Math.min(5,Math.max(0,Math.floor(p.x/48)));\"'$('\"'#zone-number').textContent=\"'`Chapter ${String(zone+1).padStart(2,'\"'0')} / 06\"'${p.y<-2?'\"' · Below the roots':''}\"'`;$('\"'#zone-name').textContent=LEVEL.zones[zone];\"'$('\"'#timer').textContent=formatTime(game.remaining);\"'$('\"'#timer').classList.toggle('low',game.remaining<60);\"'$('\"'#hearts').textContent='♥'.repeat(game.health)+'♡'.repeat(3-game.health);\"'$('\"'#score-value').textContent=game.score.toLocaleString();\"'$$('\"'.relic-dot').forEach((el,i)=>el.classList.toggle('found',game.collected.has(i)));\"'$('\"'#objective-text').textContent=game.collected.size===6?'All six found. Reach the far camp →':\"'`${6-game.collected.size} sun relic${game.collected.size===5?'\"'':'s'} to find. \"'${p.y<-2?'\"'Watch for scorpions.':'Keep your hat on.'}\"'`;const ctx=game.context();const context=$('\"'#context');if(ctx&&\"'!panelStack.length&&game.mode==='\"'playing'&&inputMethod\"'!=='\"'touch'){context.innerHTML=promptFor(ctx.action==='climb'?'climb':ctx.action)+ctx.text;context.classList.remove('hidden');}else context.classList.add('hidden');const touchAction=\"'$('\"'#touch-action');touchAction.classList.toggle('hidden',inputMethod\"'!=='\"'touch'||\"'!ctx||!!panelStack.length);if(ctx)touchAction.textContent=ctx.text;const marker=$('\"'#route-marker');if(marker)marker.style.left=Math.min(100,p.x/280*100)+'%';}\nfunction updateGhosts(dt){let labelHTML='';for(const [id,data] of ghosts){const model=art.ghosts.get(id);if(\"'!model)continue;const visible=performance.now()-data.seen<5000&&Math.abs(data.x-game.player.x)<35;model.visible=visible;if(visible){if(model.userData.setPose)model.userData.setPose({...data,grounded:!data.swinging&&!data.climbing,vx:data.vx||3},dt);else{model.position.set(data.x,data.y,0);model.userData.pose=data;}}if(performance.now()-data.seen<5000){const tag=document.createElement('\"'div');tag.className='ghost-tag';tag.style.borderColor=data.color||'#f2c451';tag.textContent=\"'`${data.name||'\"'Explorer'} · \"'${data.relics??0}/6 · ${Math.floor(data.score||0)}`;labelHTML+=tag.outerHTML;}}$('\"'#ghost-list').innerHTML=labelHTML;}\nfunction resize(){if(\"'!renderer||!camera)return;renderer.setSize(innerWidth,innerHeight);const aspect=innerWidth/innerHeight;const width=aspect<1?24:34;camera.left=-width/2;camera.right=width/2;camera.top=width/aspect/2;camera.bottom=-width/aspect/2;camera.updateProjectionMatrix();}window.addEventListener('\"'resize',resize);\nasync function boot(){try{await RAPIER.init();game=new Game(RAPIER);\"'$('\"'#loading-text').textContent='Inking the canopy…';scene=new THREE.Scene();scene.background=new THREE.Color('#88b5a2');scene.fog=new THREE.Fog('#88b5a2',42,100);camera=new THREE.OrthographicCamera(-17,17,10,-10,.1,150);renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.18;renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;await renderer.init();renderer.domElement.id='game-canvas';renderer.domElement.setAttribute('aria-label','Pitfallin’ jungle expedition');document.body.prepend(renderer.domElement);const hemi=new THREE.HemisphereLight(0xf7e8bc,0x294c43,2.6);scene.add(hemi);light=new THREE.DirectionalLight(0xffedb3,3);light.position.set(10,16,14);light.castShadow=true;light.shadow.mapSize.set(2048,2048);light.shadow.camera.left=-22;light.shadow.camera.right=22;light.shadow.camera.top=16;light.shadow.camera.bottom=-14;light.shadow.bias=-.0006;scene.add(light,light.target);const fill=new THREE.DirectionalLight(0x9ae3d8,1.4);fill.position.set(-10,8,-8);scene.add(fill);art=createArt(THREE,scene,LEVEL);\"'$('\"'#relic-dots').innerHTML=LEVEL.relics.map(()=>'<i class=\\\"relic-dot\\\"></i>').join('');resize();loaded=true;await networkReady;updatePrompts();\"'$('\"'#loading').classList.add('hidden');if(network.hubActive){\"'$('\"'#title').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');game.mode='waiting';\"'$('\"'#countdown').classList.remove('hidden');\"'$('\"'#countdown span').textContent='';network.ready();if(hubPending)startRace(hubPending);}else{showTitle();}window.__gameReady=true;let previous=performance.now(),accumulator=0;renderer.setAnimationLoop(now=>{const dt=Math.min(.06,(now-previous)/1000)||.016;previous=now;elapsed+=dt;frameCount++;pollGamepad(dt);if(game.mode==='title'&&\"'!panelStack.length&&now-lastInput>=10000){game.start(true);$('\"'#title').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');\"'$('\"'#attract-banner').classList.remove('hidden');\"'$('\"'#toast').classList.add('hidden');}if(game.mode==='waiting'){const left=network.hubActive?-globalThis.AIHub.time()/1000:(startDeadline-Date.now())/1000;\"'$('\"'#countdown span').textContent=Number.isFinite(left)&&left>0?Math.ceil(left):'';if(left<=0){game.mode='playing';\"'$('\"'#countdown').classList.add('hidden');}}const input=readInput();if(game.mode==='paused'&&network.hubActive)game.remaining=Math.max(0,game.remaining-dt);accumulator+=dt;let first=true;while(accumulator>=1/60){game.update(1/60,first?input:{...input,jump:false,grab:false,drop:false});accumulator-=1/60;first=false;}if(\"'!first)Object.keys(taps).forEach(k=>taps[k]=false);handleEvents();const title=game.mode==='\"'title';let renderState=game;if(title){renderState={...game,time:elapsed,player:{...game.player,x:25,y:.025,vx:0,grounded:true},vines:LEVEL.vines.map(v=>({...v,angle:Math.sin(elapsed*.72+v.phase)*.99}))};}art.update(renderState,dt);updateGhosts(dt);const targetX=title?20:game.player.x+4.5;const targetY=title?2.8:game.player.y<-1?game.player.y+2.4:2.7;cameraX+=(targetX-cameraX)*(1-Math.exp(-dt*4));cameraY+=(targetY-cameraY)*(1-Math.exp(-dt*4));shake=Math.max(0,shake-dt);const s=settings.shake?shake*.17:0;camera.position.set(cameraX+Math.sin(elapsed*93)*s,cameraY+5+Math.cos(elapsed*80)*s,25);camera.lookAt(cameraX,cameraY,0);light.position.set(cameraX+8,17,12);light.target.position.set(cameraX,0,0);if(game.mode\"'!=='\"'title')updateHUD();if(now>toastUntil)\"'$('\"'#toast').classList.add('hidden');\"'$('\"'#flash').style.opacity=String(Math.max(0,Number(\"'$('\"'#flash').style.opacity||0)-dt*3));audio.update({mode:panelStack.at(-1)||game.mode,time:game.time,player:game.player},dt);if(game.mode==='playing'||game.mode==='paused'||game.mode==='results')network.tick(game,dt);renderer.render(scene,camera);});\n window.__pitfallin={version:'1.0.0',get state(){return {...game.snapshot(),inputMethod,panel:panelStack.at(-1)||null,renderer:renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2',frames:frameCount,network:network.inspect(),audio:audio.inspect(),animations:art.player.userData.actions?Object.keys(art.player.userData.actions):'native mixer'};},start:()=>startSolo(),pause,action,openPanel,closePanel,teleport:(x,y)=>game.teleport(x,y),step:(n,input={})=>{for(let i=0;i<n;i++)game.update(1/60,input);handleEvents();return game.snapshot();},setTuning:(v)=>Object.assign(game.tuning,v),setDev:v=>Object.assign(game.dev,v),getGame:()=>game,getNetwork:()=>network,offlineAudio:createOfflineSample,report,forceAttract:()=>{showTitle();lastInput=performance.now()-10001;},capture:()=>renderer.domElement.toDataURL(),renderInfo:()=>({calls:renderer.info.render.calls,triangles:renderer.info.render.triangles,geometries:renderer.info.memory.geometries})};\n }catch(error){console.error(error);\"'$('\"'#loading-text').textContent='The expedition could not start: '+error.message;\"'$('\"'.loading-mark').style.animation='none';globalThis.AIHub?.fail?.(error.message);window.__bootError=String(error);}}\nboot();\nJS\nnode --check app.js\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > report.json <<'JSON'\n{\n \\\"sourceInformation\\\":{\\\"date\\\":\\\"2026-11-05 22:12:23\\\",\\\"source\\\":\\\"Pitfall\"'! (1982)\",\"plan\":\"none\",\"genre\":\"Action-adventure platformer\",\"perspective\":\"2.5D side-scrolling orthographic camera\",\"tech\":\"Three.js 0.180.0; WebGPURenderer (WebGPU primary, WebGL2 compatibility); Rapier 0.19.3; Gamepad API; Web Audio; WebRTC; AI Hub Session Protocol v1\",\"artDirection\":\"Procedural cel-shaded jungle, flat-shaded color planes, black ink silhouettes and warm expedition typography\",\"animation\":\"Three.js AnimationMixer and AnimationClips for explorer locomotion, climbing, jumping and swinging; procedural wildlife and foliage\",\"audio\":\"Original code-generated marimba music, percussion, ambience, effects and Animalese-style gibberish; music defaults to 10%\",\"online\":\"1–4 player ghost races through AI Hub; standalone nearby-tab rooms and manually paired WebRTC invitations\",\"testing\":\"Headless Chromium with software WebGPU, scripted simulation and browser input, simulated gamepad/touch, audio signal tests, AI Hub network harness; physical devices and listening unknown\",\"research\":\"none; native source knowledge; supplied AI Hub integration files retrieved\",\"environment\":\"Codex CLI (headless); Linux\",\"model\":\"OpenAI, gpt-6.1-sol, reasoning effort ultra\",\"usage\":\"added on import\"},\n \"testingFeedback\":[\"Testing is in progress; final counts will be recorded before release.\",\"unknown\",\"Scripted physics checks covering vine catches, ladder travel, hazards and a complete six-relic route.\",\"unknown\"],\n \"engineFeedback\":[\"Three.js makes procedural scenes and native clip animation straightforward; Rapier provides reliable character collisions.\",\"unknown\",\"The platforming state machine, vine attachment, level data, controller menus and multiplayer lifecycle.\",\"Coordinating kinematic physics, vine motion and layered side-on composition.\",\"none\",\"A compact, first-party character-controller and gamepad-menu starter would reduce setup.\"],\n \"promptFeedback\":[\"The source, visual style, controller-first UX and explicit finished-demo requirements give a clear creative target.\",\"No major ambiguity; standalone multiplayer needed a practical pairing design without a supplied signaling service.\",\"Delivering traversal, rich procedural art, accessible input and two multiplayer transports in one offline HTML.\",\"Specify whether standalone internet play should include hosted signaling or manual peer pairing.\"],\n \"aiHub\":{\"name\":\"Pitfallin’\",\"tagline\":\"A little danger. A lot of jungle.\",\"description\":\"Swing through an ink-drawn jungle, hop crocodile jaws and explore beneath the roots. Find six lost sun relics before sunset, solo or alongside your friends’ racing ghosts.\",\"type\":\"Game\",\"genre\":\"Platformer\",\"source\":\"Pitfall! (1982)\",\"series\":\"\",\"players\":\"1–4\",\"controls\":\"A/D or left stick move; Space/Cross jump or release; E/Square catch vine; W/S or stick up/down climb; M/Triangle map; Esc/Options pause. Touch: left drag moves, right tap jumps, contextual action assists.\",\"tags\":[\"side-scrolling\",\"3d\",\"adventure\",\"retro\",\"ghost-race\",\"jungle\"]}\n}\nJSON\ncat > app.js <<'\"'JS'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {Game,LEVEL,DEFAULTS} from './game.js';\nimport {createArt} from './art.js';\nimport {JungleAudio,createOfflineSample} from './audio.js';\nimport {ExpeditionNetwork} from './online.js';\nimport report from './report.json';\nconst \"'$=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];\nconst audio=new JungleAudio();let game,renderer,scene,camera,art,light,loaded=false,elapsed=0,lastInput=performance.now(),inputMethod='\"'keyboard',panelStack=[],panelOrigin='title',toastUntil=0,startDeadline=0,hubPending=null,ended=false,cameraX=20,cameraY=2.6,shake=0,menuFocus=0,frameCount=0;\nconst keys=new Set(),taps={jump:false,grab:false,drop:false};const touch={id:null,x:0,y:0,dx:0,dy:0};let oldButtons=[],navCooldown=0,gamepadX=0,gamepadY=0;\nlet settings={music:.1,sfx:.65,glyphs:'ps',shake:true,autoGrab:false};try{Object.assign(settings,JSON.parse(localStorage.getItem('pitfallin-settings')||'{}'));}catch{}\naudio.setMusic(settings.music);audio.setSfx(settings.sfx);\nconst ghosts=new Map();\nconst network=new ExpeditionNetwork({onStart(info){if(\"'!loaded){hubPending=info;return;}startRace(info);},onEnd(data){ended=true;game.mode='\"'ended';panelStack=[];\"'$('\"'#panel-container').innerHTML='';audio.stop();\"'$('\"'#context').classList.add('hidden');toast('Expedition complete','The hub is preparing the results',100000);},onTimeUp(){if(game&&\"'!game.finished){game.complete(false,'\"'The expedition clock has run out.');handleEvents();}network.result(game?.score||0,game?.stats||{});},onGhost(data,from){if(ended)return;ghosts.set(from,{...data,seen:performance.now()});art?.makeGhost(from,data.color||'#7be0c9');},onLeave(id){ghosts.delete(id);art?.removeGhost(id);updateNetworkStatus();},onStatus(text){const s=\"'$('\"'#network-status');if(s)s.textContent=text;updateNetworkStatus();}});\nconst networkReady=network.init();\nconst prompts={keyboard:{jump:'<kbd>Space</kbd>',grab:'<kbd>E</kbd>',climb:'<kbd>W S</kbd>',map:'<kbd>M</kbd>',pause:'<kbd>Esc</kbd>',move:'<kbd>A D</kbd>'},ps:{jump:'<span class=\\\"glyph\\\">×</span>',grab:'<span class=\\\"glyph\\\">□</span>',climb:'<span class=\\\"glyph\\\">↕</span>',map:'<span class=\\\"glyph\\\">△</span>',pause:'<span class=\\\"glyph\\\">☰</span>',move:'<span class=\\\"glyph\\\">L</span>'},xbox:{jump:'<span class=\\\"glyph\\\">A</span>',grab:'<span class=\\\"glyph\\\">X</span>',climb:'<span class=\\\"glyph\\\">↕</span>',map:'<span class=\\\"glyph\\\">Y</span>',pause:'<span class=\\\"glyph\\\">☰</span>',move:'<span class=\\\"glyph\\\">L</span>'}};\nfunction promptFor(action){return (inputMethod==='gamepad'?prompts[settings.glyphs]:prompts.keyboard)[action]||'';}\nfunction saveSettings(){try{localStorage.setItem('pitfallin-settings',JSON.stringify(settings));}catch{}}\nfunction setInput(type){if(inputMethod===type)return;inputMethod=type;document.body.classList.toggle('touch',type==='touch');updatePrompts();}\nfunction anyInput(type){lastInput=performance.now();setInput(type);if(game?.mode==='attract'){showTitle();return true;}return false;}\nfunction updatePrompts(){if(\"'!loaded)return;$('\"'#title-prompt').textContent=inputMethod==='gamepad'?(settings.glyphs==='ps'?'× Enter · Left stick Choose · ○ Back':'A Enter · Left stick Choose · B Back'):inputMethod==='touch'?'Tap a trail. Follow your curiosity.':'A / D to wander · Space to leap · E to catch a vine';\"'$('\"'#controls').innerHTML=\"'`<span>${promptFor('\"'move')}Move</span><span>\"'${promptFor('\"'jump')}Jump / release</span><span>\"'${promptFor('\"'grab')}Catch vine</span><span>\"'${promptFor('\"'climb')}Climb</span><span class=\\\"controls-spacer\\\"></span><span>\"'${promptFor('\"'map')}Field map</span><div class=\\\"route-mini\\\"><i id=\\\"route-marker\\\"></i></div>\"'`;}\nfunction focusables(){const root=panelStack.length?$('\"'#panel-container'):game?.mode==='title'?\"'$('\"'#title'):null;return root?[...root.querySelectorAll('button,input,select,textarea')].filter(e=>e.offsetParent\"'!==null&&!e.disabled):[];}\nfunction focusElement(el){if(!el)return;$$('\"'.focused').forEach(e=>e.classList.remove('focused'));el.classList.add('focused');el.focus({preventScroll:true});el.scrollIntoView({block:'nearest'});menuFocus=Math.max(0,focusables().indexOf(el));}\nfunction focusFirst(){menuFocus=0;const els=focusables();focusElement(els.find(e=>\"'!e.classList.contains('\"'back-button'))||els[0]);}\nfunction navigateMenu(dir){const els=focusables();if(\"'!els.length)return;let idx=els.indexOf(document.activeElement);idx=(idx+dir+els.length)%els.length;focusElement(els[idx]);audio.effect('\"'menu');}\nfunction adjustControl(dir){const el=document.activeElement;if(el?.type==='range'){const step=Number(el.step)||1;el.value=String(Math.max(Number(el.min),Math.min(Number(el.max),Number(el.value)+step*dir)));el.dispatchEvent(new Event('input',{bubbles:true}));return true;}if(el?.tagName==='SELECT'){el.selectedIndex=(el.selectedIndex+dir+el.options.length)%el.options.length;el.dispatchEvent(new Event('change',{bubbles:true}));return true;}return false;}\nfunction toast(title,subtitle='',seconds=3.6){\"'$('\"'#toast .toast-title').textContent=title;\"'$('\"'#toast .toast-sub').textContent=subtitle;\"'$('\"'#toast').classList.remove('hidden');toastUntil=performance.now()+seconds*1000;}\nfunction startSolo(){if(network.hubActive)return;network.leave();ghosts.clear();for(const id of art.ghosts.keys())art.removeGhost(id);begin();}\nfunction begin(){game.start();ended=false;panelStack=[];\"'$('\"'#panel-container').innerHTML='';\"'$('\"'#title').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');\"'$('\"'#attract-banner').classList.add('hidden');\"'$('\"'#toast').classList.add('hidden');cameraX=7;cameraY=2.5;keys.clear();Object.keys(taps).forEach(k=>taps[k]=false);audio.unlock();audio.speak('hello');toast('A good day to get lost.','Six sun relics · Eight minutes · One hat',4);updatePrompts();}\nfunction startRace(info){begin();startDeadline=info.hub?0:info.startAt||Date.now()+Number(info.in||3000);game.mode='waiting';\"'$('\"'#countdown').classList.remove('hidden');}\nfunction showTitle(){if(network.hubActive)return;game.reset();game.mode='title';panelStack=[];\"'$('\"'#panel-container').innerHTML='';\"'$('\"'#title').classList.remove('hidden');\"'$('\"'#hud').classList.add('hidden');\"'$('\"'#attract-banner').classList.add('hidden');\"'$('\"'#countdown').classList.add('hidden');\"'$('\"'#toast').classList.add('hidden');lastInput=performance.now();cameraX=20;cameraY=2.6;keys.clear();focusFirst();}\nfunction panelTemplate(eyebrow,title,content,wide=false,footer='Your hat can wait. Take your time.'){return \"'`<section class=\"panel-shade\"><div class=\"panel ${wide?'\"'wide':''}\\\"><header class=\\\"panel-head\\\"><div><div class=\\\"eyebrow\\\">\"'${eyebrow}</div><h2>${title}</h2></div><button class=\"back-button\" data-action=\"back\">← Back</button></header><div class=\"scroll\">${content}</div><footer class=\"panel-footer\"><span>${footer}</span><span>${inputMethod==='\"'gamepad'?(settings.glyphs==='ps'?'○ Back · × Select':'B Back · A Select'):'Esc Back · Enter Select'}</span></footer></div></section>\"'`;}\nfunction openPanel(name){if(!loaded||ended)return;if(!panelStack.length){panelOrigin=game.mode;if(game.mode==='\"'playing')game.mode='paused';}panelStack.push(name);renderPanel(name);audio.effect('menu');}\nfunction closePanel(){if(\"'!panelStack.length)return;if(network.hubActive&&panelStack[0]==='\"'results')return;panelStack.pop();if(panelStack.length)renderPanel(panelStack.at(-1));else{\"'$('\"'#panel-container').innerHTML='';if(game.mode==='paused')game.mode=panelOrigin==='playing'?'playing':panelOrigin;}keys.clear();taps.jump=taps.grab=false;audio.effect('menu');}\nfunction pause(){if(ended||game.mode==='waiting')return;if(panelStack.length){closePanel();return;}if(game.mode==='playing')openPanel('pause');}\nfunction settingSlider(id,label,value,min,max,step,description='',suffix=''){return \"'`<div class=\"setting\"><label for=\"${id}\">${label}${description?`<small>${description}</small>`:'\"''}</label><div class=\\\"setting-control\\\"><input type=\\\"range\\\" id=\\\"\"'${id}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\"><output for=\"${id}\">${value}${suffix}</output></div></div>`;}\nfunction toggle(id,label,on,description='\"''){return \"'`<div class=\"setting\"><label>${label}${description?`<small>${description}</small>`:'\"''}</label><button id=\\\"\"'${id}\" class=\"toggle\" aria-pressed=\"${!!on}\">${on?'\"'On':'Off'}</button></div>\"'`;}\nfunction renderPanel(name){let html='\"'';\n if(name==='pause'){html=panelTemplate('Catch your breath','Between leaps.',\"'`<div class=\"pause-grid\"><nav class=\"menu-stack\"><button class=\"menu-button primary\" data-action=\"resume\">Back to the jungle →</button><button class=\"menu-button\" data-action=\"map\">Field map</button><button class=\"menu-button\" data-action=\"guide\">Field guide</button><button class=\"menu-button\" data-action=\"settings\">Settings</button>${!network.hubActive?'\"'<button class=\\\"menu-button\\\" data-action=\\\"dev\\\">Developer camp</button><button class=\\\"menu-button\\\" data-action=\\\"restart\\\">Restart expedition</button><button class=\\\"menu-button\\\" data-action=\\\"title\\\">Return to title</button>':''}</nav><aside class=\\\"pause-summary\\\"><div class=\\\"eyebrow\\\">Relics in the satchel</div><div class=\\\"large-number\\\">\"'${game.collected.size}<span style=\"font-size:28px;color:var(--muted)\"> / 6</span></div><p>${LEVEL.checkpoints[game.checkpoint].name}<br>${formatTime(game.remaining)} until sunset.</p><div class=\"eyebrow\" style=\"margin-top:28px\">Fortune</div><div style=\"font:36px Georgia,serif;margin-top:10px\">${game.score.toLocaleString()}</div></aside></div>`,false,network.hubActive?'\"'The session clock continues while paused.':'The jungle will be here when you return.');}\n if(name==='settings'){html=panelTemplate('Make yourself at home','Expedition settings.',settingSlider('music','Music',Math.round(settings.music*100),0,100,1,'Original jungle soundtrack','%')+settingSlider('sfx','Sound & voices',Math.round(settings.sfx*100),0,100,1,'Wildlife, footsteps and explorer chatter','%')+\"'`<div class=\"setting\"><label for=\"glyphs\">Controller symbols<small>Prompts follow the last input you use.</small></label><select id=\"glyphs\"><option value=\"ps\" ${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · × ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div>\"'`+toggle('\"'shake','Camera shake',settings.shake)+toggle('autoGrab','Vine catch assist',settings.autoGrab,'Catch nearby vines automatically in the air. Always enabled for touch.')+\"'`<div class=\"button-row\"><button class=\"btn outline\" data-action=\"fullscreen\">Toggle fullscreen</button><button class=\"btn outline\" data-action=\"reset-settings\">Restore settings</button></div>`);}\n if(name==='\"'guide'){html=panelTemplate('A well-thumbed field guide','Look before you leap.',\"'`<div class=\"guide-grid\"><article class=\"guide-card\"><div class=\"guide-icon\">↗</div><h3>Keep moving.</h3><p><strong>${promptFor('\"'move')}Move · \"'${promptFor('\"'jump')}Jump.</strong><br>Leap rolling logs and snakes. Walk over a camp flag to save your place and recover a heart. A tumble costs five seconds and some fortune.</p></article><article class=\\\"guide-card\\\"><div class=\\\"guide-icon\\\">〰</div><h3>Trust the vine.</h3><p><strong>\"'${promptFor('\"'grab')}Catch · \"'${promptFor('\"'jump')}Release.</strong><br>Jump near the hanging end, catch it, then release as it swings towards the far bank. Crocodile backs are safe while their jaws are closed.</p></article><article class=\\\"guide-card\\\"><div class=\\\"guide-icon\\\">◇</div><h3>Follow the roots.</h3><p><strong>\"'${promptFor('\"'climb')}Climb · \"'${promptFor('\"'map')}Map.</strong><br>Stand at a ladder and press down to explore below. Two relics hide in the caves. Collect all six, then reach the camp at the far right before sunset.</p></article></div><p class=\\\"guide-note\\\">“If the ground looks suspicious, it probably is.”</p><div class=\\\"setting\\\"><label>On a touchscreen<small>Drag the left half to move or climb. Tap the right half to jump. Vines catch automatically; a contextual button helps near vines and ladders.</small></label></div><div class=\\\"button-row\\\"><button class=\\\"btn gold\\\" data-action=\\\"back\\\">Hat on. Let's go.</button></div>\"'`,true);}\n if(name==='\"'map'){const symbols=['♧','≈','♜','〰','◇','☀'];html=panelTemplate('A pocket-sized world','The sun relic trail.',\"'`<div class=\"map-route\">${LEVEL.zones.map((z,i)=>`<div class=\"map-stop ${Math.min(5,Math.floor(game.player.x/48))===i?'\"'active':''}\\\"><div class=\\\"map-symbol\\\">\"'${symbols[i]}</div><h3>${z}</h3><p>${i===2||i===4?'\"'A secret below':'Follow the sunlight'}</p></div>\"'`).join('\"'')}</div><div class=\\\"map-relics\\\">\"'${LEVEL.relics.map((r,i)=>`<div class=\"relic-row\"><div class=\"mark\">${game.collected.has(r.id)?'\"'◆':'◇'}</div><div><strong>\"'${r.name}</strong><small>${game.collected.has(r.id)?'\"'Safely in your satchel':r.y<0?'Below ground · Follow a ladder':\"'`Above ground · ${LEVEL.zones[i]}`}</small></div></div>`).join('\"'')}</div><p style=\\\"color:var(--muted);font-size:15px;margin-top:20px\\\">Flags are checkpoints. The far camp opens after all six relics are found. You can travel back to earlier regions.</p>\"'`,true);}\n if(name==='\"'dev'){html=panelTemplate('Developer camp · live tuning','A little jungle science.',settingSlider('tune-speed','Running speed',game.tuning.speed,3,14,.1,'World units per second')+settingSlider('tune-jump','Jump strength',game.tuning.jump,6,17,.1)+settingSlider('tune-gravity','Gravity',game.tuning.gravity,10,40,.5)+settingSlider('tune-vineSpeed','Vine pace',game.tuning.vineSpeed,.25,1.7,.01)+settingSlider('tune-hazardSpeed','Wildlife & log pace',game.tuning.hazardSpeed,.2,2,.05)+toggle('dev-invincible','Invincible',game.dev.invincible)+toggle('dev-noclip','Fly through the jungle',game.dev.noclip,'Move with both axes. Collisions and gravity are bypassed.')+toggle('dev-freezeTime','Hold the sunset',game.dev.freezeTime)+\"'`<div class=\"setting\"><label for=\"warp\">Jump to a region</label><select id=\"warp\"><option value=\"\">Choose a camp…</option>${LEVEL.checkpoints.map((c,i)=>`<option value=\"${i}\">${i+1}. ${c.name}</option>`).join('\"'')}</select></div><div class=\\\"button-row\\\"><button class=\\\"btn gold\\\" data-action=\\\"dev-resume\\\">Apply & return</button><button class=\\\"btn outline\\\" data-action=\\\"dev-reset\\\">Reset defaults</button><button class=\\\"btn outline\\\" data-action=\\\"dev-refill\\\">Refill hearts & clock</button></div>\"'`);}\n if(name==='\"'about'){html=panelTemplate('Made of triangles & tall tales','About this expedition.',\"'`<nav class=\"credits-tabs\"><button data-credit=\"sourceInformation\" class=\"selected\">Source Information</button><button data-credit=\"testingFeedback\">Testing Feedback</button><button data-credit=\"engineFeedback\">Engine Feedback</button><button data-credit=\"promptFeedback\">Prompt Feedback</button></nav><div id=\"credits-content\"></div>`,true,'\"'Original game, code, geometry, animation and synthesized audio. Inspired by Pitfall\"'! (1982).'\"');}\n if(name==='online'){html=panelTemplate('Better with muddy company','Ghost expedition.',\"'`<p>Race the same jungle. See your friends as golden trail ghosts. Your relics and hazards belong to your expedition.</p><div id=\"network-status\" class=\"network-status\">Choose a way to meet.</div><div id=\"players\" class=\"player-list\"></div><div class=\"network-grid\"><section><h3>Nearby tabs</h3><p>For devices sharing this browser origin. Open another copy of the game and enter the same room word.</p><input id=\"room-name\" class=\"room-input\" aria-label=\"Room word\" maxlength=\"32\" value=\"jungle\" placeholder=\"Room word\"><div class=\"button-row\"><button class=\"btn\" data-action=\"local-join\">Join room</button></div></section><section><h3>A friend, anywhere</h3><p>One explorer makes an invitation. Their friend pastes it and sends back the reply. Pair up to three friends; keep both pages open.</p><div class=\"button-row\"><button class=\"btn\" data-action=\"rtc-offer\">Make invitation</button><button class=\"btn outline\" data-action=\"rtc-accept\">Accept invitation</button><button class=\"btn outline\" data-action=\"rtc-answer\">Use reply</button></div><textarea class=\"code-input\" id=\"network-code\" aria-label=\"Invitation or reply code\" placeholder=\"Paste an invitation or reply here. New codes appear here too.\"></textarea><button class=\"back-button\" style=\"font-size:13px\" data-action=\"copy-code\">Copy code</button></section></div><div class=\"button-row\"><button class=\"btn gold\" data-action=\"race-start\" id=\"race-start\">Start ghost race →</button><button class=\"btn outline\" data-action=\"network-leave\">Leave group</button></div><p style=\"font-size:12px;color:var(--muted);margin-top:15px\">Direct invitations use WebRTC and need a reachable peer connection. Some networks block direct peers. Nearby tabs work offline. AI Hub handles invitations and transport when played in a Hub session.</p>`,true);}\n if(name==='\"'results'){html=panelTemplate(game.won?'An expedition well spent':'The jungle keeps its secrets',game.won?'What a tall tale.':'Until next sunrise.',\"'`<p class=\"result-quote\">${game.reason}</p><div class=\"result-stats\"><div class=\"result-stat\"><strong>${game.score.toLocaleString()}</strong><small>Fortune earned</small></div><div class=\"result-stat\"><strong>${game.collected.size} / 6</strong><small>Sun relics</small></div><div class=\"result-stat\"><strong>${formatTime(Math.max(0,game.remaining))}</strong><small>Sunlight spared</small></div></div><p>${game.won?'\"'The hat survived. The boots may never recover.':'Your next great expedition is only a leap away.'}</p><div class=\\\"button-row\\\">\"'${network.hubActive?'\"'<p>Waiting for the other expeditions. The hub will show the standings.</p>':'<button class=\\\"btn gold\\\" data-action=\\\"restart\\\">One more expedition →</button><button class=\\\"btn outline\\\" data-action=\\\"title\\\">Back to base camp</button>'}</div>\"'`,false,`${game.stats.jumps} leaps · ${game.stats.swings} vine catches · ${game.deaths} tumbles`);}\n $('\"'#panel-container').innerHTML=html;if(name==='about')renderCredits('sourceInformation');if(name==='online')updateNetworkStatus();if(name==='results')\"'$('\"'.back-button')?.classList.add('hidden');focusFirst();}\nconst questionSets={testingFeedback:['How many issues did testing catch?','How many were critical or game breaking?','What was the most helpful test?','What was the least helpful test?'],engineFeedback:['What did you like most about the engine?','Did you get stuck or guess wrong?','What did you have to build yourself?','What was hardest about the engine?','What did you change in the engine, and why?','What one engine feature would you change?'],promptFeedback:['What did you like most about the prompt?','What was confusing?','What was hardest?','What would you change in the prompt?']};\nfunction renderCredits(tab){const el=\"'$('\"'#credits-content');if(\"'!el)return;$$('\"'[data-credit]').forEach(b=>b.classList.toggle('selected',b.dataset.credit===tab));el.innerHTML='';if(tab==='sourceInformation'){const dl=document.createElement('dl');dl.style.margin='0';for(const [key,value] of Object.entries(report.sourceInformation)){const row=document.createElement('div');row.className='credit-line';const dt=document.createElement('dt');dt.textContent=key.replace(/([A-Z])/g,' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase());const dd=document.createElement('\"'dd');dd.textContent=value;row.append(dt,dd);dl.append(row);}el.append(dl);}else report[tab].forEach((answer,i)=>{const article=document.createElement('article');article.className='feedback-item';const h=document.createElement('h3');h.textContent=questionSets[tab][i];const p=document.createElement('p');p.textContent=answer;article.append(h,p);el.append(article);});}\nfunction updateNetworkStatus(){const el=\"'$('\"'#players');if(el){el.innerHTML='';for(const p of network.players){const chip=document.createElement('div');chip.className='player-chip';chip.style.borderColor=p.color||'#f2c451';chip.textContent=(p.name||'Explorer')+(p.id===network.me?' · You':'');el.append(chip);}}const b=\"'$('\"'#race-start');if(b)b.disabled=network.players.length<2||network.me\"'!==network.host;}\nfunction formatTime(sec){sec=Math.max(0,Math.ceil(sec));return String(Math.floor(sec/60)).padStart(2,'\"'0')+':'+String(sec%60).padStart(2,'0');}\nasync function action(name){if(\"'!loaded||ended)return;audio.unlock();switch(name){case'\"'start':startSolo();break;case'pause':pause();break;case'back':closePanel();break;case'resume':case'dev-resume':while(panelStack.length)closePanel();break;case'title':network.leave();showTitle();break;case'restart':begin();break;case'guide':case'map':case'settings':case'about':case'dev':case'online':openPanel(name);break;case'fullscreen':try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}catch{toast('Fullscreen is unavailable.','You can still follow the trail.');}break;case'reset-settings':settings={music:.1,sfx:.65,glyphs:'ps',shake:true,autoGrab:false};audio.setMusic(.1);audio.setSfx(.65);saveSettings();renderPanel('settings');updatePrompts();break;case'dev-reset':Object.assign(game.tuning,DEFAULTS);Object.assign(game.dev,{invincible:false,noclip:false,freezeTime:false});renderPanel('dev');break;case'dev-refill':game.health=3;game.remaining=game.tuning.timeLimit;toast('Ready for more science.');break;case'local-join':network.joinLocal(\"'$('\"'#room-name').value.trim()||'jungle');updateNetworkStatus();break;case'network-leave':network.leave();ghosts.clear();for(const id of art.ghosts.keys())art.removeGhost(id);updateNetworkStatus();break;case'race-start':network.startRace();break;case'rtc-offer':case'rtc-accept':case'rtc-answer':{const button=\"'$(`[data-action=\"${name}\"]`);button.disabled=true;try{const el=$('\"'#network-code');if(name==='rtc-offer')el.value=await network.createOffer();if(name==='rtc-accept')el.value=await network.acceptOffer(el.value.trim());if(name==='rtc-answer')await network.acceptAnswer(el.value.trim());e