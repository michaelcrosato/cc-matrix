{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='test.py';s=open(p).read().replace('os.environ[\\\"TMPDIR\\\"] = str(ROOT)','os.environ[\\\"TMPDIR\\\"] = \\\".\\\"').replace('headless=True,','headless=False,')\ns=s.replace('    await page.close()','''    await page.evaluate(\\\"() => {const g=window.__pitfallin.getGame();g.start();g.complete(false,'A results navigation check.');window.__pitfallin.step(0);}\\\")\n    await page.keyboard.press(\\\"Escape\\\")\n    check(await page.evaluate(\\\"window.__pitfallin.state.mode === 'title'\\\"), \\\"Results Back returns to a usable title\\\")\n    await page.evaluate(\\\"window.__pitfallin.getNetwork().callbacks.onEnd({reason:'finished'})\\\")\n    await page.keyboard.press(\\\"Enter\\\")\n    check(await page.evaluate(\\\"window.__pitfallin.state.audio.stopped && window.__pitfallin.state.mode === 'ended'\\\"), \\\"Hub end ignores input and keeps audio stopped\\\")\n    await page.close()''',1)\ns=s.replace('    await context.close()', '''    await mobile.wait_for_function(\\\"window.__pitfallin.state.player.y < -5.6 && \"'!window.__pitfallin.state.player.climbing\",timeout=30000)\n    check(await mobile.evaluate(\"window.__pitfallin.state.player.y < -5.6\"), \"Touch ladder assist completes descent\")\n    await mobile.set_viewport_size({\"width\":390,\"height\":844})\n    await mobile.evaluate(\"window.__pitfallin.action('\"'title')\\\")\n    check(await mobile.evaluate(\\\"document.documentElement.scrollWidth === innerWidth\\\"), \\\"Portrait phone layout fits viewport\\\")\n    await context.close()''',1)\nopen(p,'w').write(s)\np='hub-tests.py';s=open(p).read().replace('\\\"game\\\": \\\"../index.html\\\",','\\\"game\\\": \\\"../index.html?renderer=webgl\\\",');open(p,'w').write(s)\nimport json\np='package.json';d=json.load(open(p));d['scripts']['test']='xvfb-run -a /home/micha/.local/share/pipx/venvs/playwright/bin/python test.py';open(p,'w').write(json.dumps(d,indent=2)+'\\\\n')\np='report.json';d=json.load(open(p));d['sourceInformation']['testing']='Input-only full expedition at default settings; headless simulation, emulated standard controller and multitouch, native WebGPU in virtual X display, compatibility renderer for multi-page WebRTC and AI Hub harness; audio signal metrics. Physical devices and listening unknown.'\nd['testingFeedback']=['Seven issues found through scripted checks, visual checks and integration review; all corrected: ghost positioning, small-screen title overlap, software graphics loss/stalls, results Back navigation, input after Hub end, touch ladder timing, and exposed sky below caves.','Two could stop usable play: a lost or stalled graphics device and an empty results screen after Back. No unresolved game-breaking issues.','The input-only default-settings playthrough collected all six relics, rode all three vines, explored both caves and reached the exit without teleports or cheats.','The first headless WebGPU screenshot was blank and could not judge the art; native WebGPU under virtual X and compatibility captures supplied useful visual evidence.']\nd['engineFeedback'][1]='The supplied software WebGPU adapter flag lost or stalled devices, even with two boxes. A Vulkan SwiftShader configuration rendered correctly; automatic WebGL2 recovery covers device loss and stalls.'\nopen(p,'w').write(json.dumps(d,indent=2,ensure_ascii=False)+'\\\\n')\nopen('../exit-interview.json','w').write(json.dumps(d,indent=2,ensure_ascii=False)+'\\\\n')\nPY\nruff format test.py hub-tests.py\nbiome format --write report.json package.json\nnode build.mjs\nnpm run --silent test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
