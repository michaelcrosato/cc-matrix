 not proc.name.isdigit():continue\n try:\n  if (proc/'cwd').resolve()\"'!=Path.cwd():continue\n  args=(proc/'\"'cmdline').read_bytes().split(b'\\\\0')\n  if b'http.server' in args or any(x.endswith(b'/test.py') or x in [b'test.py',b'hub-tests.py',b'rtc-tests.py'] for x in args):owned.append(proc.name)\n except (FileNotFoundError,PermissionError):pass\nassert not owned,owned\nprint('Test browsers and servers closed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
