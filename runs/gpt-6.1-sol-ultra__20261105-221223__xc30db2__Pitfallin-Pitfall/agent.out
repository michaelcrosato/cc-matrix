{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'JS'\nexport const DEFAULTS=Object.freeze({speed:7.2,jump:10.8,gravity:25,vineSpeed:.72,hazardSpeed:1,timeLimit:480});\nexport const LEVEL={\n ground:[[-10,30],[41,69],[80,116],[130,166],[179,210],[224,290]],\n caves:[[78,114],[178,210]], ladders:[84,108,184,204],\n vines:[{x:35.5,y:9.5,length:8.2,phase:-1.1},{x:123,y:10,length:8.6,phase:.4},{x:172.5,y:9.8,length:8.3,phase:-.8}],\n crocs:[71.4,74.7,78,212.2,215.5,218.8,222.1].map((x,i)=>({x,y:0,phase:i*.48})),\n logs:[14,53,142,240].map(x=>({x,y:0})), snakes:[90,158,255].map(x=>({x,y:0})), scorpions:[94,103,190,200].map(x=>({x,y:-5.8})),\n checkpoints:[{x:3,name:'Base camp'},{x:45,name:'The crooked creek'},{x:82,name:'Roots & ruins'},{x:133,name:'The black lagoon'},{x:181,name:'The hollow earth'},{x:228,name:'The last leap'}],\n relics:[{id:0,x:23,y:.55,name:'The Grinning Sun'},{id:1,x:60,y:.55,name:'The Rain Dancer'},{id:2,x:99,y:-5.25,name:'The Root Keeper'},{id:3,x:150,y:.55,name:'The Moon Monkey'},{id:4,x:195,y:-5.25,name:'The Sleeping Star'},{id:5,x:267,y:.55,name:'The Golden Goodbye'}],\n zones:['Fernway','Crocodile creek','Roots & ruins','Tarwood','Hollow earth','Sunset run'],length:280\n};\nexport class Game{\n constructor(R){this.R=R;this.tuning={...DEFAULTS};this.dev={invincible:false,noclip:false,freezeTime:false};this.events=[];this.world=new R.World({x:0,y:-25,z:0});this.world.timestep=1/60;this.solids=[];\n  const box=(x,y,hx,hy)=>{const b=this.world.createRigidBody(R.RigidBodyDesc.fixed().setTranslation(x,y,0));const c=this.world.createCollider(R.ColliderDesc.cuboid(hx,hy,1.5),b);this.solids.push(c);};\n  for(const [a,b] of LEVEL.ground)box((a+b)/2,-.28,(b-a)/2,.28);\n  for(const [a,b] of LEVEL.caves)box((a+b)/2,-6.1,(b-a)/2,.3);\n  for(const c of LEVEL.crocs)box(c.x,-.03,.92,.18);\n  this.body=this.world.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(3,.86,0));\n  this.collider=this.world.createCollider(R.ColliderDesc.capsule(.5,.3).setFriction(0),this.body);\n  this.controller=this.world.createCharacterController(.025);this.controller.enableSnapToGround(.18);this.controller.setMaxSlopeClimbAngle(Math.PI/4);this.controller.setMinSlopeSlideAngle(Math.PI/3);this.reset();\n }\n reset(){this.mode='title';this.time=0;this.remaining=this.tuning.timeLimit;this.collected=new Set();this.coins=new Set();this.score=0;this.health=3;this.checkpoint=0;this.deaths=0;this.finished=false;this.reason='';this.visited=new Set([0]);this.player={x:3,y:.03,vx:0,vy:0,facing:1,grounded:true,climbing:false,swinging:false,invuln:0};this.vineIndex=-1;this.grabCooldown=0;this.jumpBuffer=0;this.coyote=.1;this.particles=[];this.hazards={logs:[],crocs:[],snakes:[],scorpions:[]};this.vines=[];this.events=[];this.attractTime=0;this.stats={jumps:0,swings:0,falls:0,treasures:0};this.teleport(3,.03);this.updateHazards();}\n start(attract=false){this.reset();this.mode=attract?'attract':'playing';this.attractTime=0;this.emit('start');}\n emit(type,data={}){this.events.push({type,...data});}\n drainEvents(){return this.events.splice(0);}\n teleport(x,y){const p=this.player;p.x=x;p.y=y;p.vx=0;p.vy=0;p.swinging=false;p.climbing=false;p.grounded=false;this.vineIndex=-1;this.collider.setEnabled(true);this.body.setTranslation({x,y:y+.825,z:0},true);this.body.setNextKinematicTranslation({x,y:y+.825,z:0});}\n updateHazards(){const t=this.time*this.tuning.hazardSpeed;this.vines=LEVEL.vines.map(v=>({...v,angle:Math.sin(this.time*this.tuning.vineSpeed+v.phase)*.99}));this.hazards.logs=LEVEL.logs.map((h,i)=>({...h,x:h.x+((7-(t*1.7+i*2)%14)),rotation:t*3}));this.hazards.crocs=LEVEL.crocs.map(h=>({...h,open:((t+h.phase)%5.8)>4.05}));this.hazards.snakes=LEVEL.snakes.map((h,i)=>({...h,x:h.x+Math.sin(t*1.4+i)*.5}));this.hazards.scorpions=LEVEL.scorpions.map((h,i)=>({...h,x:h.x+Math.sin(t*1.05+i)*2.4}));}\n update(dt,input={}){\n  if(this.mode\"'!=='\"'playing'&&this.mode\"'!=='\"'attract')return;\n  dt=Math.min(dt,1/20);const p=this.player;this.time+=dt;if(\"'!this.dev.freezeTime&&this.mode!=='\"'attract')this.remaining-=dt;this.updateHazards();p.invuln=Math.max(0,p.invuln-dt);this.grabCooldown=Math.max(0,this.grabCooldown-dt);\n  if(this.mode==='attract'){this.attract(dt);this.updateParticles(dt);return;}\n  if(this.remaining<=0){this.complete(false,'The sun has set. Another expedition awaits.');return;}\n  this.world.timestep=dt;this.world.step();\n  const move=Math.max(-1,Math.min(1,input.x||0)), vertical=input.y||0;if(Math.abs(move)>.1)p.facing=Math.sign(move);\n  if(input.jump)this.jumpBuffer=.16;else this.jumpBuffer=Math.max(0,this.jumpBuffer-dt);\n  this.coyote=p.grounded?.12:Math.max(0,this.coyote-dt);\n  if(this.dev.noclip){p.x+=move*this.tuning.speed*dt;p.y+=-vertical*this.tuning.speed*dt;this.teleport(p.x,p.y);p.grounded=false;}\n  else if(p.swinging){\n   const v=this.vines[this.vineIndex];p.x=v.x+Math.sin(v.angle)*v.length;p.y=v.y-Math.cos(v.angle)*v.length-.9;p.vx=Math.cos(v.angle)*v.length*Math.cos(this.time*this.tuning.vineSpeed+v.phase)*.99*this.tuning.vineSpeed;p.vy=Math.sin(v.angle)*v.length*Math.cos(this.time*this.tuning.vineSpeed+v.phase)*.99*this.tuning.vineSpeed;\n   if(input.jump||input.drop||input.grab){p.swinging=false;this.collider.setEnabled(true);p.vx+=move*2;p.vy=Math.max(p.vy,4.8);this.grabCooldown=.65;this.jumpBuffer=0;this.emit('release');}\n   this.body.setTranslation({x:p.x,y:p.y+.825,z:0},true);this.body.setNextKinematicTranslation({x:p.x,y:p.y+.825,z:0});\n  }else if(p.climbing){\n   p.y-=vertical*3.8*dt;p.x+=move*dt*.7;p.vx=0;p.vy=0;p.grounded=false;\n   if(input.jump){p.climbing=false;p.vy=this.tuning.jump*.8;p.vx=move*this.tuning.speed;this.collider.setEnabled(true);this.jumpBuffer=0;this.emit('jump');}\n   if(p.y>=.03){p.y=.03;p.climbing=false;p.grounded=true;this.collider.setEnabled(true);}\n   if(p.y<=-5.77){p.y=-5.77;p.climbing=false;p.grounded=true;this.collider.setEnabled(true);}\n   this.body.setTranslation({x:p.x,y:p.y+.825,z:0},true);this.body.setNextKinematicTranslation({x:p.x,y:p.y+.825,z:0});\n  }else{\n   const ladder=LEVEL.ladders.find(x=>Math.abs(x-p.x)<1.05);\n   if(ladder\"'!==undefined&&Math.abs(vertical)>.35&&((p.y>-.5&&vertical>0)||(p.y<-4.7&&vertical<0))){p.climbing=true;p.x=ladder;p.y=p.y>-.5?-.08:-5.65;this.collider.setEnabled(false);this.emit('\"'climb');}\n   else{\n    const accel=p.grounded?40:20;p.vx+=(move*this.tuning.speed-p.vx)*Math.min(1,accel*dt);if(\"'!move&&p.grounded)p.vx*=Math.max(0,1-14*dt);\n    if(this.jumpBuffer>0&&this.coyote>0){p.vy=this.tuning.jump;p.grounded=false;this.jumpBuffer=0;this.coyote=0;this.stats.jumps++;this.emit('\"'jump');}\n    p.vy=Math.max(-25,p.vy-this.tuning.gravity*dt);\n    this.controller.computeColliderMovement(this.collider,{x:p.vx*dt,y:p.vy*dt,z:0});const delta=this.controller.computedMovement();const wasGrounded=p.grounded;p.x+=delta.x;p.y+=delta.y;p.grounded=this.controller.computedGrounded();if(p.grounded&&p.vy<0){p.vy=0;if(\"'!wasGrounded)this.emit('\"'land');}\n    const tr={x:p.x,y:p.y+.825,z:0};this.body.setTranslation(tr,true);this.body.setNextKinematicTranslation(tr);\n   }\n   if((input.grab||input.autoGrab)&&this.grabCooldown<=0&&\"'!p.grounded&&!p.climbing){let best=-1,dist=2.7;this.vines.forEach((v,i)=>{const d=Math.hypot(v.x+Math.sin(v.angle)*v.length-p.x,v.y-Math.cos(v.angle)*v.length-(p.y+1.3));if(d<dist){dist=d;best=i;}});if(best>=0){this.vineIndex=best;p.swinging=true;p.grounded=false;this.collider.setEnabled(false);this.stats.swings++;this.emit('\"'grab');}}\n  }\n  p.x=Math.max(-2,Math.min(285,p.x));\n  this.checkWorld();this.updateParticles(dt);\n }\n checkWorld(){const p=this.player;\n  for(let i=0;i<LEVEL.checkpoints.length;i++){const c=LEVEL.checkpoints[i];if(p.x>=c.x&&i>this.checkpoint&&p.y>-.6){this.checkpoint=i;this.health=Math.min(3,this.health+1);this.visited.add(i);this.emit('checkpoint',{name:c.name});}}\n  for(const r of LEVEL.relics){if(\"'!this.collected.has(r.id)&&Math.hypot(p.x-r.x,p.y+.7-r.y)<1.5){this.collected.add(r.id);this.score+=1000+Math.floor(this.remaining);this.stats.treasures++;this.burst(r.x,r.y,0xffcf55,25);this.emit('\"'relic',{name:r.name,id:r.id});}}\n  const goldSpots=[10,26,46,63,87,105,136,153,161,185,202,231,249,271];goldSpots.forEach((x,i)=>{const y=i===5||i===10?-5.3:.6;if(\"'!this.coins.has(i)&&Math.hypot(p.x-x,p.y+.5-y)<1){this.coins.add(i);this.score+=75;this.burst(x,y,0xfadc76,8);this.emit('\"'coin');}});\n  if(\"'!this.dev.invincible&&p.invuln<=0){\n   let cause='\"'';for(const h of this.hazards.logs)if(Math.abs(p.x-h.x)<.95&&p.y<.8&&p.y>-.8)cause='A rolling log\"'!'\"';\n   for(const h of [...this.hazards.snakes,...this.hazards.scorpions])if(Math.abs(p.x-h.x)<.8&&p.y-h.y<.75&&p.y-h.y>-.65)cause='Mind the wildlife\"'!'\"';\n   for(const h of this.hazards.crocs)if(h.open&&Math.abs(p.x-h.x)<1.2&&p.y<.8&&p.y>-.7)cause='Those are not stepping stones\"'!'\"';\n   const overMire=p.x>116&&p.x<130;if(overMire&&p.y<-.65)cause='Tar takes its time. You should not.';\n   if(p.y<-9)cause='A little too much pit.';\n   if(cause)this.hurt(cause);\n  }else if(p.y<-9)this.respawn();\n  if(p.x>=278&&p.y>-.5){if(this.collected.size===6)this.complete(true,'Six treasures. One very good story.');else if(\"'!this.exitNotice||this.time-this.exitNotice>7){this.exitNotice=this.time;this.emit('\"'notice',{text:\"'`${6-this.collected.size} sun relic${this.collected.size===5?'\"'':'s'} still out there. Check your field map.\"'`});}}\n }\n hurt(cause){this.health--;this.score=Math.max(0,this.score-150);this.remaining=Math.max(1,this.remaining-5);this.deaths++;this.stats.falls++;this.burst(this.player.x,this.player.y+.8,0xff745b,16);this.emit('\"'hurt',{text:cause});if(this.health<=0){this.health=3;this.score=Math.max(0,this.score-200);this.emit('rescue');}this.respawn();}\n respawn(){const c=LEVEL.checkpoints[this.checkpoint];this.teleport(c.x+1,.05);this.player.invuln=2.6;this.grabCooldown=.5;}\n burst(x,y,color,count){for(let i=0;i<count;i++){const a=i/count*Math.PI*2;this.particles.push({x,y,z:.4,color,life:1.1,size:.08+(i%3)*.03,vx:Math.cos(a)*(1+i%4),vy:Math.sin(a)*3+2});}}\n updateParticles(dt){for(const f of this.particles){f.life-=dt;f.x+=f.vx*dt;f.y+=f.vy*dt;f.vy-=6*dt;}this.particles=this.particles.filter(f=>f.life>0);}\n complete(won,reason){if(this.finished)return;this.finished=true;this.mode='results';this.reason=reason;this.won=won;if(won)this.score+=Math.floor(this.remaining*10)+this.health*250;this.emit('finish',{won});}\n attract(dt){\n  this.attractTime+=dt;const t=this.attractTime;const route=[{x:17,y:.05,d:5},{x:36,y:2.5,d:5},{x:74,y:1.5,d:5},{x:84,y:.03,d:3},{x:99,y:-5.7,d:6},{x:123,y:2.8,d:5},{x:153,y:.05,d:4},{x:173,y:2.7,d:4},{x:195,y:-5.7,d:6},{x:217,y:1.5,d:5},{x:267,y:.03,d:5},{x:279,y:.03,d:4}];let rem=t,index=0;while(rem>route[index].d){rem-=route[index].d;index++;if(index>=route.length){this.start(true);return;}}const a=index?route[index-1]:{x:3,y:.03};const b=route[index];const q=Math.min(1,rem/b.d);const e=q*q*(3-2*q);this.player.x=a.x+(b.x-a.x)*e;this.player.y=a.y+(b.y-a.y)*e+(b.y>1?Math.sin(q*Math.PI)*1.5:0);this.player.vx=4;this.player.grounded=this.player.y>-.1&&this.player.y<.2;this.player.facing=1;this.player.climbing=b.y< -1&&q<.3;this.player.swinging=b.y>2&&q>.2&&q<.8;for(const r of LEVEL.relics)if(Math.abs(this.player.x-r.x)<2)this.collected.add(r.id);\n }\n context(){const p=this.player;if(p.swinging)return {text:'Release the vine',action:'jump'};if(p.climbing||LEVEL.ladders.some(x=>Math.abs(x-p.x)<1.5))return {text:p.y<-3?'Climb to daylight':'Explore below',action:'climb'};if(this.vines.some(v=>Math.hypot(v.x+Math.sin(v.angle)*v.length-p.x,v.y-Math.cos(v.angle)*v.length-(p.y+1))<4))return {text:'Catch the vine',action:'grab'};return null;}\n snapshot(){return {mode:this.mode,time:this.time,remaining:this.remaining,player:{...this.player},score:this.score,health:this.health,collected:[...this.collected],checkpoint:this.checkpoint,finished:this.finished,won:this.won,stats:{...this.stats},tuning:{...this.tuning},dev:{...this.dev},physics:{bodies:this.world.bodies.len(),colliders:this.world.colliders.len(),engine:'Rapier 0.19.3'}};}\n}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'JS'\nexport const DEFAULTS=Object.freeze({speed:7.2,jump:10.8,gravity:25,vineSpeed:.72,hazardSpeed:1,timeLimit:480});\nexport const LEVEL={\n ground:[[-10,30],[41,69],[80,116],[130,166],[179,210],[224,290]],\n caves:[[78,114],[178,210]], ladders:[84,108,184,204],\n vines:[{x:35.5,y:9.5,length:8.2,phase:-1.1},{x:123,y:10,length:8.6,phase:.4},{x:172.5,y:9.8,length:8.3,phase:-.8}],\n crocs:[71.4,74.7,78,212.2,215.5,218.8,222.1].map((x,i)=>({x,y:0,phase:i*.48})),\n logs:[14,53,142,240].map(x=>({x,y:0})), snakes:[90,158,255].map(x=>({x,y:0})), scorpions:[94,103,190,200].map(x=>({x,y:-5.8})),\n checkpoints:[{x:3,name:'Base camp'},{x:45,name:'The crooked creek'},{x:82,name:'Roots & ruins'},{x:133,name:'The black lagoon'},{x:181,name:'The hollow earth'},{x:228,name:'The last leap'}],\n relics:[{id:0,x:23,y:.55,name:'The Grinning Sun'},{id:1,x:60,y:.55,name:'The Rain Dancer'},{id:2,x:99,y:-5.25,name:'The Root Keeper'},{id:3,x:150,y:.55,name:'The Moon Monkey'},{id:4,x:195,y:-5.25,name:'The Sleeping Star'},{id:5,x:267,y:.55,name:'The Golden Goodbye'}],\n zones:['Fernway','Crocodile creek','Roots & ruins','Tarwood','Hollow earth','Sunset run'],length:280\n};\nexport class Game{\n constructor(R){this.R=R;this.tuning={...DEFAULTS};this.dev={invincible:false,noclip:false,freezeTime:false};this.events=[];this.world=new R.World({x:0,y:-25,z:0});this.world.timestep=1/60;this.solids=[];\n  const box=(x,y,hx,hy)=>{const b=this.world.createRigidBody(R.RigidBodyDesc.fixed().setTranslation(x,y,0));const c=this.world.createCollider(R.ColliderDesc.cuboid(hx,hy,1.5),b);this.solids.push(c);};\n  for(const [a,b] of LEVEL.ground)box((a+b)/2,-.28,(b-a)/2,.28);\n  for(const [a,b] of LEVEL.caves)box((a+b)/2,-6.1,(b-a)/2,.3);\n  for(const c of LEVEL.crocs)box(c.x,-.03,.92,.18);\n  this.body=this.world.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(3,.86,0));\n  this.collider=this.world.createCollider(R.ColliderDesc.capsule(.5,.3).setFriction(0),this.body);\n  this.controller=this.world.createCharacterController(.025);this.controller.enableSnapToGround(.18);this.controller.setMaxSlopeClimbAngle(Math.PI/4);this.controller.setMinSlopeSlideAngle(Math.PI/3);this.reset();\n }\n reset(){this.mode='title';this.time=0;this.remaining=this.tuning.timeLimit;this.collected=new Set();this.coins=new Set();this.score=0;this.health=3;this.checkpoint=0;this.deaths=0;this.finished=false;this.reason='';this.visited=new Set([0]);this.player={x:3,y:.03,vx:0,vy:0,facing:1,grounded:true,climbing:false,swinging:false,invuln:0};this.vineIndex=-1;this.grabCooldown=0;this.jumpBuffer=0;this.coyote=.1;this.particles=[];this.hazards={logs:[],crocs:[],snakes:[],scorpions:[]};this.vines=[];this.events=[];this.attractTime=0;this.stats={jumps:0,swings:0,falls:0,treasures:0};this.teleport(3,.03);this.updateHazards();}\n start(attract=false){this.reset();this.mode=attract?'attract':'playing';this.attractTime=0;this.emit('start');}\n emit(type,data={}){this.events.push({type,...data});}\n drainEvents(){return this.events.splice(0);}\n teleport(x,y){const p=this.player;p.x=x;p.y=y;p.vx=0;p.vy=0;p.swinging=false;p.climbing=false;p.grounded=false;this.vineIndex=-1;this.collider.setEnabled(true);this.body.setTranslation({x,y:y+.825,z:0},true);this.body.setNextKinematicTranslation({x,y:y+.825,z:0});}\n updateHazards(){const t=this.time*this.tuning.hazardSpeed;this.vines=LEVEL.vines.map(v=>({...v,angle:Math.sin(this.time*this.tuning.vineSpeed+v.phase)*.99}));this.hazards.logs=LEVEL.logs.map((h,i)=>({...h,x:h.x+((7-(t*1.7+i*2)%14)),rotation:t*3}));this.hazards.crocs=LEVEL.crocs.map(h=>({...h,open:((t+h.phase)%5.8)>4.05}));this.hazards.snakes=LEVEL.snakes.map((h,i)=>({...h,x:h.x+Math.sin(t*1.4+i)*.5}));this.hazards.scorpions=LEVEL.scorpions.map((h,i)=>({...h,x:h.x+Math.sin(t*1.05+i)*2.4}));}\n update(dt,input={}){\n  if(this.mode\"'!=='\"'playing'&&this.mode\"'!=='\"'attract')return;\n  dt=Math.min(dt,1/20);const p=this.player;this.time+=dt;if(\"'!this.dev.freezeTime&&this.mode!=='\"'attract')this.remaining-=dt;this.updateHazards();p.invuln=Math.max(0,p.invuln-dt);this.grabCooldown=Math.max(0,this.grabCooldown-dt);\n  if(this.mode==='attract'){this.attract(dt);this.updateParticles(dt);return;}\n  if(this.remaining<=0){this.complete(false,'The sun has set. Another expedition awaits.');return;}\n  this.world.timestep=dt;this.world.step();\n  const move=Math.max(-1,Math.min(1,input.x||0)), vertical=input.y||0;if(Math.abs(move)>.1)p.facing=Math.sign(move);\n  if(input.jump)this.jumpBuffer=.16;else this.jumpBuffer=Math.max(0,this.jumpBuffer-dt);\n  this.coyote=p.grounded?.12:Math.max(0,this.coyote-dt);\n  if(this.dev.noclip){p.x+=move*this.tuning.speed*dt;p.y+=-vertical*this.tuning.speed*dt;this.teleport(p.x,p.y);p.grounded=false;}\n  else if(p.swinging){\n   const v=this.vines[this.vineIndex];p.x=v.x+Math.sin(v.angle)*v.length;p.y=v.y-Math.cos(v.angle)*v.length-.9;p.vx=Math.cos(v.angle)*v.length*Math.cos(this.time*this.tuning.vineSpeed+v.phase)*.99*this.tuning.vineSpeed;p.vy=Math.sin(v.angle)*v.length*Math.cos(this.time*this.tuning.vineSpeed+v.phase)*.99*this.tuning.vineSpeed;\n   if(input.jump||input.drop||input.grab){p.swinging=false;this.collider.setEnabled(true);p.vx+=move*2;p.vy=Math.max(p.vy,4.8);this.grabCooldown=.65;this.jumpBuffer=0;this.emit('release');}\n   this.body.setTranslation({x:p.x,y:p.y+.825,z:0},true);this.body.setNextKinematicTranslation({x:p.x,y:p.y+.825,z:0});\n  }else if(p.climbing){\n   p.y-=vertical*3.8*dt;p.x+=move*dt*.7;p.vx=0;p.vy=0;p.grounded=false;\n   if(input.jump){p.climbing=false;p.vy=this.tuning.jump*.8;p.vx=move*this.tuning.speed;this.collider.setEnabled(true);this.jumpBuffer=0;this.emit('jump');}\n   if(p.y>=.03){p.y=.03;p.climbing=false;p.grounded=true;this.collider.setEnabled(true);}\n   if(p.y<=-5.77){p.y=-5.77;p.climbing=false;p.grounded=true;this.collider.setEnabled(true);}\n   this.body.setTranslation({x:p.x,y:p.y+.825,z:0},true);this.body.setNextKinematicTranslation({x:p.x,y:p.y+.825,z:0});\n  }else{\n   const ladder=LEVEL.ladders.find(x=>Math.abs(x-p.x)<1.05);\n   if(ladder\"'!==undefined&&Math.abs(vertical)>.35&&((p.y>-.5&&vertical>0)||(p.y<-4.7&&vertical<0))){p.climbing=true;p.x=ladder;p.y=p.y>-.5?-.08:-5.65;this.collider.setEnabled(false);this.emit('\"'climb');}\n   else{\n    const accel=p.grounded?40:20;p.vx+=(move*this.tuning.speed-p.vx)*Math.min(1,accel*dt);if(\"'!move&&p.grounded)p.vx*=Math.max(0,1-14*dt);\n    if(this.jumpBuffer>0&&this.coyote>0){p.vy=this.tuning.jump;p.grounded=false;this.jumpBuffer=0;this.coyote=0;this.stats.jumps++;this.emit('\"'jump');}\n    p.vy=Math.max(-25,p.vy-this.tuning.gravity*dt);\n    this.controller.computeColliderMovement(this.collider,{x:p.vx*dt,y:p.vy*dt,z:0});const delta=this.controller.computedMovement();const wasGrounded=p.grounded;p.x+=delta.x;p.y+=delta.y;p.grounded=this.controller.computedGrounded();if(p.grounded&&p.vy<0){p.vy=0;if(\"'!wasGrounded)this.emit('\"'land');}\n    const tr={x:p.x,y:p.y+.825,z:0};this.body.setTranslation(tr,true);this.body.setNextKinematicTranslation(tr);\n   }\n   if((input.grab||input.autoGrab)&&this.grabCooldown<=0&&\"'!p.grounded&&!p.climbing){let best=-1,dist=2.7;this.vines.forEach((v,i)=>{const d=Math.hypot(v.x+Math.sin(v.angle)*v.length-p.x,v.y-Math.cos(v.angle)*v.length-(p.y+1.3));if(d<dist){dist=d;best=i;}});if(best>=0){this.vineIndex=best;p.swinging=true;p.grounded=false;this.collider.setEnabled(false);this.stats.swings++;this.emit('\"'grab');}}\n  }\n  p.x=Math.max(-2,Math.min(285,p.x));\n  this.checkWorld();this.updateParticles(dt);\n }\n checkWorld(){const p=this.player;\n  for(let i=0;i<LEVEL.checkpoints.length;i++){const c=LEVEL.checkpoints[i];if(p.x>=c.x&&i>this.checkpoint&&p.y>-.6){this.checkpoint=i;this.health=Math.min(3,this.health+1);this.visited.add(i);this.emit('checkpoint',{name:c.name});}}\n  for(const r of LEVEL.relics){if(\"'!this.collected.has(r.id)&&Math.hypot(p.x-r.x,p.y+.7-r.y)<1.5){this.collected.add(r.id);this.score+=1000+Math.floor(this.remaining);this.stats.treasures++;this.burst(r.x,r.y,0xffcf55,25);this.emit('\"'relic',{name:r.name,id:r.id});}}\n  const goldSpots=[10,26,46,63,87,105,136,153,161,185,202,231,249,271];goldSpots.forEach((x,i)=>{const y=i===5||i===10?-5.3:.6;if(\"'!this.coins.has(i)&&Math.hypot(p.x-x,p.y+.5-y)<1){this.coins.add(i);this.score+=75;this.burst(x,y,0xfadc76,8);this.emit('\"'coin');}});\n  if(\"'!this.dev.invincible&&p.invuln<=0){\n   let cause='\"'';for(const h of this.hazards.logs)if(Math.abs(p.x-h.x)<.95&&p.y<.8&&p.y>-.8)cause='A rolling log\"'!'\"';\n   for(const h of [...this.hazards.snakes,...this.hazards.scorpions])if(Math.abs(p.x-h.x)<.8&&p.y-h.y<.75&&p.y-h.y>-.65)cause='Mind the wildlife\"'!'\"';\n   for(const h of this.hazards.crocs)if(h.open&&Math.abs(p.x-h.x)<1.2&&p.y<.8&&p.y>-.7)cause='Those are not stepping stones\"'!'\"';\n   const overMire=p.x>116&&p.x<130;if(overMire&&p.y<-.65)cause='Tar takes its time. You should not.';\n   if(p.y<-9)cause='A little too much pit.';\n   if(cause)this.hurt(cause);\n  }else if(p.y<-9)this.respawn();\n  if(p.x>=278&&p.y>-.5){if(this.collected.size===6)this.complete(true,'Six treasures. One very good story.');else if(\"'!this.exitNotice||this.time-this.exitNotice>7){this.exitNotice=this.time;this.emit('\"'notice',{text:\"'`${6-this.collected.size} sun relic${this.collected.size===5?'\"'':'s'} still out there. Check your field map.\"'`});}}\n }\n hurt(cause){this.health--;this.score=Math.max(0,this.score-150);this.remaining=Math.max(1,this.remaining-5);this.deaths++;this.stats.falls++;this.burst(this.player.x,this.player.y+.8,0xff745b,16);this.emit('\"'hurt',{text:cause});if(this.health<=0){this.health=3;this.score=Math.max(0,this.score-200);this.emit('rescue');}this.respawn();}\n respawn(){const c=LEVEL.checkpoints[this.checkpoint];this.teleport(c.x+1,.05);this.player.invuln=2.6;this.grabCooldown=.5;}\n burst(x,y,color,count){for(let i=0;i<count;i++){const a=i/count*Math.PI*2;this.particles.push({x,y,z:.4,color,life:1.1,size:.08+(i%3)*.03,vx:Math.cos(a)*(1+i%4),vy:Math.sin(a)*3+2});}}\n updateParticles(dt){for(const f of this.particles){f.life-=dt;f.x+=f.vx*dt;f.y+=f.vy*dt;f.vy-=6*dt;}this.particles=this.particles.filter(f=>f.life>0);}\n complete(won,reason){if(this.finished)return;this.finished=true;this.mode='results';this.reason=reason;this.won=won;if(won)this.score+=Math.floor(this.remaining*10)+this.health*250;this.emit('finish',{won});}\n attract(dt){\n  this.attractTime+=dt;const t=this.attractTime;const route=[{x:17,y:.05,d:5},{x:36,y:2.5,d:5},{x:74,y:1.5,d:5},{x:84,y:.03,d:3},{x:99,y:-5.7,d:6},{x:123,y:2.8,d:5},{x:153,y:.05,d:4},{x:173,y:2.7,d:4},{x:195,y:-5.7,d:6},{x:217,y:1.5,d:5},{x:267,y:.03,d:5},{x:279,y:.03,d:4}];let rem=t,index=0;while(rem>route[index].d){rem-=route[index].d;index++;if(index>=route.length){this.start(true);return;}}const a=index?route[index-1]:{x:3,y:.03};const b=route[index];const q=Math.min(1,rem/b.d);const e=q*q*(3-2*q);this.player.x=a.x+(b.x-a.x)*e;this.player.y=a.y+(b.y-a.y)*e+(b.y>1?Math.sin(q*Math.PI)*1.5:0);this.player.vx=4;this.player.grounded=this.player.y>-.1&&this.player.y<.2;this.player.facing=1;this.player.climbing=b.y< -1&&q<.3;this.player.swinging=b.y>2&&q>.2&&q<.8;for(const r of LEVEL.relics)if(Math.abs(this.player.x-r.x)<2)this.collected.add(r.id);\n }\n context(){const p=this.player;if(p.swinging)return {text:'Release the vine',action:'jump'};if(p.climbing||LEVEL.ladders.some(x=>Math.abs(x-p.x)<1.5))return {text:p.y<-3?'Climb to daylight':'Explore below',action:'climb'};if(this.vines.some(v=>Math.hypot(v.x+Math.sin(v.angle)*v.length-p.x,v.y-Math.cos(v.angle)*v.length-(p.y+1))<4))return {text:'Catch the vine',action:'grab'};return null;}\n snapshot(){return {mode:this.mode,time:this.time,remaining:this.remaining,player:{...this.player},score:this.score,health:this.health,collected:[...this.collected],checkpoint:this.checkpoint,finished:this.finished,won:this.won,stats:{...this.stats},tuning:{...this.tuning},dev:{...this.dev},physics:{bodies:this.world.bodies.len(),colliders:this.world.colliders.len(),engine:'Rapier 0.19.3'}};}\n}\nJS\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > shell.html <<'HTML'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<!--SESSION-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<meta name=\"theme-color\" content=\"#122e28\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Find six sun relics, then reach the far camp. More treasure and time left earn more points.\">\n<meta name=\"hub:session-howto\" content=\"Move: left stick / A D. Jump or release: Cross / Space. Catch vine: Square / E. Climb: stick up down / W S. Pause: Options / Esc.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n<title>Pitfallin’ — A little danger. A lot of jungle.</title>\n<style>\n:root{--ink:#102e28;--paper:#fff4d7;--gold:#f2c451;--red:#e77750;--muted:#b0c7ad;--line:rgba(255,244,215,.24);color-scheme:dark;font-family:'\"'Trebuchet MS',Arial,sans-serif}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);color:var(--paper)}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.45;cursor:wait}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:5px}button{border:0}canvas{display:block;position:absolute;inset:0;width:100%;height:100%;touch-action:none}#vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 55% 45%,transparent 35%,#071f2144 100%)}#ui{position:absolute;inset:0;pointer-events:none}#ui button,#ui input,#ui select,#ui textarea,.scroll{pointer-events:auto}.hidden{display:none\"'!important}.eyebrow{text-transform:uppercase;letter-spacing:.24em;font-size:13px;font-weight:800;color:var(--gold)}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:Georgia,'\"'Times New Roman',serif;font-weight:normal}h2{font-size:clamp(34px,4vw,58px);letter-spacing:-.045em}h3{font-size:27px}p{line-height:1.55}#loading{position:absolute;inset:0;z-index:30;background:#122e28;display:grid;place-items:center}.loading-inner{text-align:center}.loading-mark{width:66px;height:66px;border:2px solid #fff4d744;border-top:3px solid var(--gold);transform:rotate(45deg);margin:0 auto 32px;animation:spin 2s linear infinite}@keyframes spin{to{transform:rotate(405deg)}}#loading p{margin-top:15px;color:var(--muted)}#title{position:absolute;inset:0;background:linear-gradient(90deg,#0d2a26f5 0%,#0d2a26dc 26%,#0d2a2655 52%,transparent 72%);display:flex;align-items:center;padding:5vh 6vw}#title .title-inner{width:48%;max-width:720px;transform:translateY(-2vh)}.title-serial{display:flex;align-items:center;gap:15px;margin-bottom:3vh}.title-serial:before{content:'';display:block;width:42px;height:2px;background:var(--gold)}h1{font-size:clamp(72px,9.5vw,168px);line-height:.88;letter-spacing:-.085em;color:var(--gold);text-shadow:3px 4px 0 #071e20;transform:rotate(-3deg);transform-origin:left center;margin:2.5vh 0 4vh}h1 .apostrophe{font-size:.8em}.tagline{font-family:Georgia,serif;font-style:italic;font-size:clamp(20px,2.1vw,34px);max-width:410px}.title-copy{color:#c4d3b9;font-size:16px;max-width:380px;margin:16px 0 27px}.menu-stack{display:flex;flex-direction:column;align-items:flex-start;gap:6px}.menu-button{background:transparent;border-radius:2px;padding:12px 18px;color:var(--paper);min-width:285px;text-align:left;font-size:20px;font-weight:bold;transition:background .15s,transform .15s}.menu-button:hover,.menu-button.focused{background:var(--paper);color:var(--ink);transform:translateX(7px)}.menu-button.primary{background:var(--gold);color:var(--ink);padding:17px 22px;margin-bottom:7px;box-shadow:5px 5px 0 #061a1a}.menu-button.primary:hover,.menu-button.primary.focused{background:#ffe594;transform:translateX(7px)}.menu-button small{font-size:12px;font-weight:normal;display:block;opacity:.7;margin-top:4px}.title-bottom{position:absolute;bottom:4vh;left:6vw;right:5vw;display:flex;justify-content:space-between;align-items:center;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#b9c9af}.edition{border:1px solid #fff4d74d;border-radius:50%;width:100px;height:100px;display:grid;place-items:center;text-align:center;transform:rotate(10deg);line-height:1.6;color:var(--gold)}.scene-caption{position:absolute;right:6vw;bottom:18vh;border-left:2px solid var(--gold);padding:10px 18px;background:#102e2855;backdrop-filter:blur(5px)}.scene-caption span{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:#dce6cb}.scene-caption p{font-family:Georgia,serif;font-size:25px;margin-top:7px}#hud{position:absolute;inset:0;pointer-events:none}#hud-top{height:100px;padding:24px 4vw;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#0b2529e8,transparent)}.hud-brand{display:flex;align-items:center;gap:16px}.compass{height:42px;width:42px;border:1px solid #f2c451aa;border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:28px}.hud-area .eyebrow{font-size:10px}.hud-area strong{display:block;font-size:19px;margin-top:4px}.relic-count{display:flex;gap:8px;align-items:center;font-size:15px}.relic-dot{width:19px;height:25px;border:2px solid var(--gold);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);background:#142f2877}.relic-dot.found{background:var(--gold)}.hud-right{display:flex;align-items:center;gap:25px}.hearts{letter-spacing:.2em;color:#ed8b6b;font-size:26px}.timer{font-variant-numeric:tabular-nums;font-size:24px;letter-spacing:.07em}.timer.low{color:#ff947b;animation:pulse 1s alternate infinite}@keyframes pulse{to{opacity:.5}}.icon-btn{background:#102e2877;color:var(--paper);border:1px solid #fff4d750;border-radius:50%;width:46px;height:46px;font-size:20px;display:grid;place-items:center;pointer-events:auto}#objective{position:absolute;top:112px;left:4vw;font-size:14px;color:#e4e9cd;text-shadow:1px 2px 2px #102e28}.objective-label{font-size:10px;letter-spacing:.19em;color:var(--gold);margin-bottom:6px}#score{position:absolute;top:112px;right:4vw;text-align:right}.score-number{font-size:22px;font-variant-numeric:tabular-nums}#context{position:absolute;bottom:100px;left:50%;transform:translateX(-50%);padding:12px 22px;border:1px solid #f2c45177;border-radius:3px;background:#102e28df;font-size:18px;white-space:nowrap}kbd,.glyph{display:inline-grid;min-width:28px;height:28px;padding:0 7px;place-items:center;border:1px solid currentColor;border-radius:5px;margin-right:8px;font-size:15px;font-family:inherit;font-weight:bold;vertical-align:middle}.glyph{border-radius:50%;padding:0;min-width:29px;height:29px}#controls{position:absolute;bottom:28px;left:4vw;right:4vw;display:flex;gap:25px;font-size:13px;align-items:center;color:var(--paper);text-shadow:0 1px 4px #102e28}.controls-spacer{flex:1}.route-mini{width:180px;height:4px;background:#fff4d744;position:relative}.route-mini i{position:absolute;height:10px;width:10px;background:var(--gold);border:2px solid var(--ink);top:-3px;transform:rotate(45deg)}#toast{position:absolute;top:24%;left:50%;transform:translateX(-50%);text-align:center;padding:18px 34px;border-top:2px solid var(--gold);background:linear-gradient(90deg,transparent,#102e28ec 18%,#102e28ec 82%,transparent);min-width:440px;pointer-events:none;transition:opacity .3s}#toast .toast-title{font-family:Georgia,serif;font-size:30px}#toast .toast-sub{font-size:12px;margin-top:7px;color:var(--gold);text-transform:uppercase;letter-spacing:.18em}.panel-shade{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:5vh 6vw;background:#061f22c9;backdrop-filter:blur(12px)}.panel{width:min(980px,91vw);max-height:90vh;border-top:3px solid var(--gold);padding:35px 42px;background:linear-gradient(135deg,#18382f,#102c29);box-shadow:12px 16px 0 #041c1b77;display:flex;flex-direction:column;pointer-events:auto}.panel.wide{width:min(1200px,92vw)}.panel-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}.panel-head .eyebrow{margin-bottom:9px}.back-button{background:transparent;color:var(--paper);font-size:16px;border-bottom:1px solid #fff4d755;padding:10px 0}.scroll{overflow:auto;scrollbar-color:var(--gold) #16372e;scrollbar-width:thin;padding:0 8px 6px 0}.panel-footer{border-top:1px solid var(--line);padding-top:15px;margin-top:20px;font-size:13px;color:var(--muted);display:flex;justify-content:space-between}.button-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}.btn{background:var(--paper);color:var(--ink);padding:14px 23px;border-radius:2px;font-size:17px;font-weight:bold}.btn.gold{background:var(--gold)}.btn.outline{background:transparent;color:var(--paper);border:1px solid #fff4d755}.btn:hover,.btn.focused{background:#ffe39a;color:var(--ink);box-shadow:0 0 0 3px #f2c45155}.pause-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px}.pause-summary{border-left:1px solid var(--line);padding:10px 0 0 30px}.large-number{font-family:Georgia,serif;font-size:70px;color:var(--gold);line-height:1.1}.pause-summary p{font-size:17px;color:var(--muted);margin:13px 0}.setting{padding:18px 0;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px}.setting label{font-size:19px}.setting small{display:block;color:var(--muted);font-size:13px;margin-top:5px}.setting-control{display:flex;align-items:center;gap:18px;min-width:42%}.setting input[type=range]{width:100%;accent-color:var(--gold);height:26px}.setting output{min-width:45px;color:var(--gold);font-variant-numeric:tabular-nums}.setting select{background:#0d2726;color:var(--paper);padding:10px 15px;border:1px solid #fff4d755;font-size:17px;max-width:100%}.toggle{background:#0c2824;color:var(--gold);border:1px solid #f2c45188;padding:10px 20px;font-size:16px;min-width:85px}.toggle[aria-pressed=true]{background:var(--gold);color:var(--ink)}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.guide-card{padding:22px;border:1px solid var(--line);background:#fff4d705}.guide-icon{font-size:42px;color:var(--gold);height:60px}.guide-card h3{margin:12px 0;font-size:26px}.guide-card p{font-size:16px;color:#c2d4bb}.guide-card strong{color:var(--paper)}.guide-note{margin-top:22px;color:var(--gold);font-family:Georgia,serif;font-size:22px;font-style:italic}.map-route{position:relative;display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin:15px 0 25px}.map-stop{position:relative;text-align:center;padding:25px 5px 15px;border:1px solid #fff4d729;background:#102b25}.map-stop.active{border-color:var(--gold);background:#f2c45112}.map-stop .map-symbol{font-size:36px;color:var(--gold);margin-bottom:12px}.map-stop h3{font-size:20px;margin-bottom:8px}.map-stop p{font-size:11px;color:var(--muted)}.map-relics{display:grid;grid-template-columns:1fr 1fr;gap:12px}.relic-row{display:flex;align-items:center;gap:18px;background:#08251f88;padding:16px}.relic-row .mark{font-size:25px;color:var(--gold)}.relic-row strong{font-size:17px}.relic-row small{display:block;color:var(--muted);margin-top:5px;font-size:12px}.credits-tabs{display:flex;gap:8px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:24px}.credits-tabs button{font-size:15px;padding:12px 16px;background:transparent;color:var(--muted);border:1px solid #fff4d733}.credits-tabs button.selected{color:var(--ink);background:var(--gold)}.credit-line{display:grid;grid-template-columns:145px 1fr;gap:20px;padding:10px 0;border-bottom:1px solid #fff4d714;font-size:16px;line-height:1.5}.credit-line dt{color:var(--gold);font-weight:bold}.credit-line dd{margin:0;color:#dae1c8}.feedback-item{margin-bottom:23px}.feedback-item h3{font-family:inherit;font-weight:bold;font-size:17px;color:var(--gold);margin-bottom:8px}.feedback-item p{font-size:16px;color:#d1ddc3}.network-status{color:var(--gold);font-size:17px;margin:8px 0 22px}.network-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.network-grid section{border:1px solid var(--line);padding:22px}.network-grid h3{font-size:27px;margin-bottom:12px}.network-grid p{color:var(--muted);font-size:14px}.code-input{display:block;resize:vertical;min-height:80px;width:100%;background:#09251f;color:var(--paper);border:1px solid #fff4d755;margin-top:15px;padding:13px;font-size:14px}.room-input{background:#0d2823;border:1px solid var(--line);color:var(--paper);width:100%;padding:13px;margin-top:16px;font-size:18px}.network-grid .btn{font-size:14px;padding:12px 16px}.player-list{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0}.player-chip{padding:9px 16px;border:1px solid var(--line);font-size:15px}.result-stats{display:grid;grid-template-columns:repeat(3,1fr);margin:30px 0;gap:25px}.result-stat{text-align:center;padding:20px;border:1px solid var(--line)}.result-stat strong{display:block;font:50px Georgia,serif;color:var(--gold)}.result-stat small{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-top:12px}.result-quote{font-size:24px;font-family:Georgia,serif;font-style:italic;color:var(--gold)}#attract-banner{position:absolute;bottom:5vh;left:50%;transform:translateX(-50%);background:#0a2926dd;border-top:2px solid var(--gold);text-align:center;padding:16px 42px;white-space:nowrap;pointer-events:none}#attract-banner strong{font-family:Georgia,serif;font-size:26px;color:var(--gold)}#attract-banner p{font-size:13px;margin-top:5px;letter-spacing:.12em;text-transform:uppercase}#countdown{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none}#countdown span{font:160px Georgia,serif;color:var(--gold);text-shadow:5px 6px 0 var(--ink)}#ghost-list{position:absolute;right:4vw;top:165px;display:flex;flex-direction:column;gap:6px;text-align:right}.ghost-tag{font-size:13px;padding:6px 10px;background:#102e28bb;border-right:3