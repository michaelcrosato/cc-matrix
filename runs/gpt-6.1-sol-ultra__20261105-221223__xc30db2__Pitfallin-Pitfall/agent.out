{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '1065,1098p' node_modules/three/src/renderers/common/Renderer.js && rg -n 'startRace|createOffer|acceptOffer|stun|RTCPeer' online.js && sed -n '1,80p' simulation-tests.mjs\"","aggregated_output":"\t\treturn this._colorBufferType;\n\n\t}\n\n\t/**\n\t * Default implementation of the device lost callback.\n\t *\n\t * @private\n\t * @param {Object} info - Information about the context lost.\n\t */\n\t_onDeviceLost( info ) {\n\n\t\tlet errorMessage = `THREE.WebGPURenderer: ${info.api} Device Lost:\\n\\nMessage: ${info.message}`;\n\n\t\tif ( info.reason ) {\n\n\t\t\terrorMessage += `\\nReason: ${info.reason}`;\n\n\t\t}\n\n\t\tconsole.error( errorMessage );\n\n\t\tthis._isDeviceLost = true;\n\n\t}\n\n\t/**\n\t * Renders the given render bundle.\n\t *\n\t * @private\n\t * @param {Object} bundle - Render bundle data.\n\t * @param {Scene} sceneRef - The scene the render bundle belongs to.\n\t * @param {LightsNode} lightsNode - The lights node.\n\t */\n199:  startRace() {\n216:    await peer.pc.setLocalDescription(await (type === 'offer' ? peer.pc.createOffer() : peer.pc.createAnswer()));\n226:    const pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });\n256:  async createOffer() {\n258:    if (!globalThis.RTCPeerConnection) throw new Error('WebRTC is unavailable. Use nearby tabs or AI Hub.');\n275:  async acceptOffer(code) {\nimport assert from 'node:assert/strict';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport { Game, LEVEL, DEFAULTS } from './game.js';\n\n// Rapier's compat WASM loader emits an upstream deprecation notice for its own\n// generated bootstrap. Test output deliberately includes failures and totals only.\nconst originalWarn = console.warn;\nconsole.warn = (...args) => {\n  if (!String(args[0]).includes('deprecated parameters for the initialization')) originalWarn(...args);\n};\nawait RAPIER.init();\nconsole.warn = originalWarn;\n\nlet passed = 0;\nlet failed = 0;\nconst dt = 1 / 60;\nfunction frames(game, count, input = {}) {\n  for (let i = 0; i < count; i++) game.update(dt, typeof input === 'function' ? input(i, game) : input);\n}\nfunction seconds(game, duration, input = {}) { frames(game, Math.round(duration / dt), input); }\nfunction fresh() { const game = new Game(RAPIER); game.start(); return game; }\nfunction hasEvent(game, type) { return game.drainEvents().some(event => event.type === type); }\nfunction test(name, fn) {\n  let game;\n  try {\n    game = fresh();\n    fn(game);\n    passed++;\n  } catch (error) {\n    failed++;\n    console.error(`FAIL ${name}: ${error.message}`);\n  } finally { game?.world.free(); }\n}\n\n// These assertions treat Game as a simulation boundary. Level coordinates arrange\n// encounters; movement, collisions, pickups and finish conditions run through update.\ntest('Rapier world and a stable grounded explorer', game => {\n  seconds(game, .3);\n  const state = game.snapshot();\n  assert.ok(state.physics.bodies > 10 && state.physics.colliders > 10);\n  assert.equal(state.physics.engine, 'Rapier 0.19.3');\n  assert.ok(state.player.grounded);\n  assert.ok(Math.abs(state.player.y) < .1, `ground y ${state.player.y}`);\n  assert.ok(Number.isFinite(state.player.x));\n});\n\ntest('directional acceleration, braking and ground collision', game => {\n  seconds(game, .2);\n  const start = game.player.x;\n  seconds(game, .65, { x: 1 });\n  assert.ok(game.player.x > start + 3, 'right movement should cover useful distance');\n  assert.ok(game.player.grounded && Math.abs(game.player.y) < .1);\n  seconds(game, .3, {});\n  assert.ok(Math.abs(game.player.vx) < .05, 'release should brake');\n  const turnaround = game.player.x;\n  seconds(game, .3, { x: -1 });\n  assert.ok(game.player.x < turnaround - 1);\n  assert.equal(game.player.facing, -1);\n});\n\ntest('jump leaves ground, reaches apex and lands once', game => {\n  seconds(game, .2);\n  game.drainEvents();\n  game.update(dt, { jump: true });\n  seconds(game, .3);\n  assert.ok(game.player.y > 1.4, `jump height ${game.player.y}`);\n  assert.ok(!game.player.grounded);\n  seconds(game, 1);\n  assert.ok(game.player.grounded && Math.abs(game.player.y) < .1);\n  assert.equal(game.stats.jumps, 1);\n  const events = game.drainEvents();\n  assert.equal(events.filter(event => event.type === 'jump').length, 1);\n  assert.equal(events.filter(event => event.type === 'land').length, 1);\n});\n\ntest('rolling log damage, checkpoint rescue and temporary invulnerability', game => {\n  game.tuning.hazardSpeed = 0;\n  game.updateHazards();\n  const log = game.hazards.logs[0];\n  game.score = 500;\n","exit_code":0,"status":"completed"}}
