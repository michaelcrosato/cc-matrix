group('glyph', () => {\"\"\"),1)\nopen('tests/run.mjs','w').write(s)\nedit('tests/coop.mjs',[\n (\"  // a request: the client crafts a brick\",\n  \"\"\"  // the client points at a spot on the ground: the host turns that Builder to face it\n  C.game.mouseGround = () => [rb.x + 50, rb.y + 50];\n  C.I.lastDevice = 'mouse';\n  tick(0.5);\n  C.I.lastDevice = 'keyboard'; C.game.mouseGround = () => null;\n  const want = Math.atan2(50, 50);\n  check('coop', 'a remote player aims with the pointer the client sent', Math.abs(Math.atan2(Math.sin(rb.facing - want), Math.cos(rb.facing - want))) < 0.15, 'facing ' + rb.facing.toFixed(2) + ' want ' + want.toFixed(2));\n\n  // a request: the client crafts a brick\"\"\"),\n])\nprint('ok')\nPYEOF\ntimeout 900 node tests/run.mjs 2>&1 | tail -6","description":"Add tests for Animalese, remote mouse aim and the new layouts; run the suite"}},"wire_ingest_context":{"toolu_01H4wpMzdtppj9ejJPjvRZTF":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonCrateBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326"}}}
