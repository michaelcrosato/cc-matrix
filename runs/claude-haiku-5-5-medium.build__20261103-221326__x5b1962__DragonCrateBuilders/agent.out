I.pressed('confirm') || I.pressed('cancel'))) game.go('title');\n    },\n    draw(r) {\n      const B = DQ.bee, hub = AIHub_active();\n      if (DQ.session && DQ.session.play) DQ.drawPlay(r);\n      if (DQ.modal && DQ.modal.draw) DQ.modal.draw(r);\n      DQ.talkDraw(r);\n      r.overlay(g => {\n        if (hub && B.phase === 'play') {\n          E.ui.box(g, 6, r.H - 52, 200, 20, { bg: '#14122a', border: '#ffe27a', alpha: 0.8 });\n          const left = Math.max(0, Math.ceil(DQ.BEE_SECONDS - (B ? B.t : 0)));\n          E.font.text(g, 'SHARED TOWN  ' + Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0') + '  YOUR SCORE ' + (B ? B.score : 0), 12, r.H - 46, '#ffe27a', { shadow: '#000' });\n        } else if (!hub) {\n          E.ui.box(g, 6, r.H - 52, 180, 20, { bg: '#14122a', border: '#ffe27a', alpha: 0.8 });\n          const left = Math.max(0, Math.ceil(DQ.BEE_SECONDS - (B ? B.t : 0)));\n          E.font.text(g, 'QUILTING BEE  ' + Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0') + '  SCORE ' + (B ? B.score : 0), 12, r.H - 46, '#ffe27a', { shadow: '#000' });\n        }\n        if (B && B.phase === 'wait') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 40, 300, 60, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, B.hubText || 'QUILTING BEE', r.W / 2, r.H / 2 - 30, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, B.hubSub || 'Press ' + DQ.glyph('confirm') + ' to start', r.W / 2, r.H / 2 - 4, '#e8e4ff', { align: 'center', shadow: '#000' });\n        }\n        if (B && B.phase === 'done') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 50, 300, 90, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, 'ROUND OVER', r.W / 2, r.H / 2 - 40, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, 'Your score ' + B.score + '. Thank you for stitching with us.', r.W / 2, r.H / 2 - 12, '#ffffff', { align: 'center', shadow: '#000' });\n        }\n      });\n    },\n  };\nEOF\ncat > /tmp/dqb-patch/bee2.js <<'EOF'\n// the round: a solo timed Bee, or a shared town over AI Hub (mode shared-world)\nDQ.beeStart = () => {\n  const B = DQ.bee, N = DQ.net, hub = AIHub_active();\n  DQ.session = DQ.newSession({ stream: 'round', mode: 'bee' });\n  wirePlay(DQ.session);\n  DQ.session.queue = [];\n  const p = DQ.session.play;\n  B.phase = 'play'; B.t = 0; B.lastSec = -1;\n  if (hub && N.on) {\n    p.builder.id = N.me;\n    if (N.host) N.hostStart(p, N.info);\n    else if (N.pendingWorld) { N.applyWorld(p, N.pendingWorld); N.pendingWorld = null; }\n  }\n};\nDQ.beeConnect = () => {\n  const hub = globalThis.AIHub;\n  if (!hub) return;\n  hub.connect({ mode: 'shared-world', seats: [1, 4] }).then(info => {\n    if (!info) return;\n    const N = DQ.net;\n    Object.assign(N, { on: true, info, me: info.me, host: !!info.isHost, server: !!info.server, client: !info.isHost });\n    DQ.bee.hub = info;\n    DQ.bee.hubText = 'QUILTING BEE';\n    DQ.bee.hubSub = 'Waiting for the round to start';\n    hub.on('message', (d, from) => N.onMessage(d, from));\n    hub.on('start', () => { DQ.bee.go = true; });\n    hub.on('time-up', () => { DQ.bee.timeUp = true; });\n    hub.on('leave', ({ id }) => { if (DQ.session && DQ.session.play) DQ.session.play.remotes.delete(id); delete N.inbox[id]; });\n    hub.on('end', () => { DQ.bee.phase = 'done'; });\n    hub.ready();\n  });\n};\nEOF\npython3 - <<'PYEOF'\np='src/35-scenes.js'; s=open(p).read()\na=s.index('  const bee = {'); b=s.index('  return { title, intro, play, attract, dev, about, end, bee };')\ns=s[:a]+open('/tmp/dqb-patch/bee.js').read()+s[b:]\na=s.index('DQ.beeConnect = () => {'); b=s.index('DQ.beeProgress = ')\ns=s[:a]+open('/tmp/dqb-patch/bee2.js').read()+s[b:]\nold=\"  p.say = (lines, o) => S.queue.push({ lines, o: o || {} });\"\nassert s.count(old)==1\ns=s.replace(old,\"  p.say = (lines, o) => {\\n    S.queue.push({ lines, o: o || {} });\\n    if (DQ.net && DQ.net.host && DQ.net.on) DQ.net.outSay.push({ lines, name: (o && o.name) || null });\\n  };\")\ns=s.replace(\"  p.onCraft = () => { DQ.modal = DQ.openCraft(p, game, () => { DQ.modal = null; }); };\",\"  p.onCraft = () => { DQ.modal = DQ.openCraft(p, game, () => { DQ.modal = null; }); };\")\nopen(p,'w').write(s)\np='src/30-ui.js'; s=open(p).read()\nold=\"      if (p.craft(item.rec)) m.items = m.items; else p.popup(\"\nold2=\"      if (!p.craft(item.rec)) p.popup(\"\nassert s.count(old2)==1\ns=s.replace(old2,\"      if (DQ.net && DQ.net.client) { DQ.net.cr.push(item.rec.id); return; }   // a client asks the host\\n      if (!p.craft(item.rec)) p.popup(\")\nold3=\"    onPick(i, item) { if (item.id) { p.hotbar[p.sel] = item.id;\"\nassert s.count(old3)==1\ns=s.replace(old3,\"    onPick(i, item) { if (item.id) { if (DQ.net && DQ.net.client) DQ.net.hot.push([p.sel, item.id]); else p.hotbar[p.sel] = item.id;\")\nopen(p,'w').write(s)\np='src/40-draw.js'; s=open(p).read()\nold=\"  things.push(p.builder);\"\nassert s.count(old)==1\ns=s.replace(old,\"  for (const b of p.remotes.values()) things.push(b);\\n  if (!p.serverOnly) things.push(p.builder);\")\nopen(p,'w').write(s)\np='tools/build.mjs'; s=open(p).read()\ns=s.replace('<meta name=\"hub:session-mode\" content=\"parallel\">','<meta name=\"hub:session-mode\" content=\"shared-world\">')\ns=s.replace(\"Stitch the most of the realm back together in three minutes: break, craft, build and fight. The most points wins.\",\"Build one town together for three minutes: break, craft, build and fight. Each builder scores for what they make and mend.\")\nopen(p,'w').write(s)\nprint('ok')\nPYEOF\ngrep -n \"outSay\\|outPop\" src/*.js | head -3; for f in src/*.js; do node --check $f || echo FAIL $f; done; node tools/build.mjs >/dev/null && timeout 300 node tests/run.mjs | tail -3","description":"Replace the Bee with the shared round, route client requests, draw remote players, and retest"}},"wire_ingest_context":{"toolu_01UJUZEXpQbMx4hu25J79SHM":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonCrateBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326"}}}
