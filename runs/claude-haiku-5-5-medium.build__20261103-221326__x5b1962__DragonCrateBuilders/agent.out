he client sent', Math.abs(Math.atan2(Math.sin(rb.facing - want), Math.cos(rb.facing - want))) < 0.15, 'facing ' + rb.facing.toFixed(2) + ' want ' + want.toFixed(2));\n\nEOF\npython3 - <<'PYEOF'\np='tests/run.mjs'; s=open(p).read()\nanchor=\"  DQ.god = false;\\n  check('systems', 'no errors in the new systems'\"\nassert s.count(anchor)==1\ns=s.replace(anchor, open('/tmp/dqb-patch/t_systems.txt').read()+anchor)\ng=\"group('glyph', () => {\"\nassert s.count(g)==1\ns=s.replace(g, open('/tmp/dqb-patch/t_voice.txt').read()+g)\nopen(p,'w').write(s)\np='tests/coop.mjs'; s=open(p).read()\na=\"  // a request: the client crafts a brick\"\nassert s.count(a)==1\ns=s.replace(a, open('/tmp/dqb-patch/t_coop.txt').read()+a)\nopen(p,'w').write(s)\nprint('ok')\nPYEOF\ntimeout 900 node tests/run.mjs 2>&1 | tail -6","description":"Insert the new test blocks from files and run the suite"}},"wire_ingest_context":{"toolu_01Bf6Xvoq56M63M15szzf7U1":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonCrateBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326"}}}
