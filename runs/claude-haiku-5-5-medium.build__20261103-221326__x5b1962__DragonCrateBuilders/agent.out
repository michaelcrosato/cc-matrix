 play scene by the page, start the round, let the clock run\nawait page.evaluate(() => My3D2dge.current.go('bee', { fade: 0 })); await page.waitForTimeout(600);\nres.beeOpened = (await dq()).scene;\nawait page.keyboard.press('Enter'); await page.waitForTimeout(3000);\nres.beeAfterStart = await dq();\nawait page.screenshot({ path: out + '-bee.png' });\nres.errors = errs;\nconsole.log(JSON.stringify(res, null, 1));\nawait browser.close();\nEOF\ntimeout 300 node _verify.mjs \"$(cd .. && pwd)/../DragonCrateBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326.html\" /tmp/dqb-smoke/final 2>&1 | tail -80; rm -f _verify.mjs","description":"Run a browser verification of attract, Dev Tools, Xbox glyphs and the Bee on the final HTML"}}}
