{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghKsnJHbWusbjXj9wzXp","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7418,"cache_read_input_tokens":197798,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7418},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"82f305e6-f719-4e49-881f-e498d001a34b","uuid":"0bd4fb35-ef2f-4ab2-a1ba-924ed84670d4","timestamp":"2026-11-04T05:21:28.108Z","request_id":"req_011CghKsn1R3bhWQuBYmr4x2","thinking_duration_ms":16477,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghKsnJHbWusbjXj9wzXp","type":"message","role":"assistant","content":[{"type":"text","text":"The UI module is written. Next are the scenes: title (with attract after 10 seconds idle), the play scene wired to the HUD, dialog and menus, Dev Tools, the About screen, the chapter-clear screen, and the Quilting Bee round with its AI Hub hooks."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7418,"cache_read_input_tokens":197798,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7418},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"82f305e6-f719-4e49-881f-e498d001a34b","uuid":"88164e15-83ae-45a0-8b9f-e9028db7a39b","timestamp":"2026-11-04T05:21:28.557Z","request_id":"req_011CghKsn1R3bhWQuBYmr4x2"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghKsnJHbWusbjXj9wzXp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01635qVk2ZSwutJjE4JqsMtW","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326/src/35-scenes.js","content":"// The scenes: title, the intro, play, attract (the AI plays), the Quilting Bee round (a timed score, playable solo or in an\n// AI Hub session), Dev Tools, About & Credits, and the chapter's end. Plus the dialog pump and the touch-only notice.\n(() => {\nconst E = My3D2dge, DQ = globalThis.DQ;\nlet game = null;\n\n// ---- sound: presets for the effects, and the audio wrapper the systems call ----------------------------------------------\nDQ.audio = {\n  sfx(name, vol = 1) { if (game) game.audio.sfx(name, { vol }); },\n  music(key) { if (game && DQ.SONGS[key]) game.audio.music(DQ.SONGS[key]); },\n};\nDQ.defineSounds = g => {\n  g.audio.define('rrip', { wave: 'noise', dur: 0.2, vol: 0.32, vary: 0.2 });\n  g.audio.define('rip', { wave: 'noise', dur: 0.05, vol: 0.12 });\n  g.audio.define('stitch', { wave: 'square', freq: 880, to: 1320, dur: 0.08, vol: 0.2 });\n  g.audio.define('craft', { wave: 'triangle', freq: 523, to: 784, arp: [0, 4, 7], step: 0.06, dur: 0.2, vol: 0.2 });\n  g.audio.define('hurt', { wave: 'saw', freq: 240, to: 90, dur: 0.25, vol: 0.3 });\n  g.audio.define('defeat', { wave: 'square', freq: 660, to: 220, dur: 0.3, vol: 0.2 });\n  for (const k of Object.keys(DQ.VOICES)) g.audio.define('voice_' + k, DQ.VOICES[k]);\n};\n// which voice a speaker has: the names they're called by in the dialog box\nDQ.voiceFor = name => {\n  if (!name) return 'voice_builder';\n  if (/GRANNY/.test(name)) return 'voice_granny';\n  const n = DQ.NPCS.find(p => p.name.toUpperCase() === name);\n  return 'voice_' + (n ? n.voice : 'mid');\n};\n\n// ---- the dialog: one talk box, a queue of speeches, pumped each step ---------------------------------------------------\nDQ.talkStep = dt => {\n  const S = DQ.session; if (!S || !S.talk) return false;\n  if (!S.talk.open && S.queue.length) {\n    const q = S.queue.shift();\n    S.talk.voice = DQ.voiceFor(q.o.name);\n    S.talk.say(q.lines, { name: q.o.name, portrait: q.o.portrait, onDone: () => {} });\n  }\n  if (S.talk.open) { S.talk.update(dt); return true; }\n  return false;\n};\nDQ.talkDraw = r => { const S = DQ.session; if (S && S.talk && S.talk.open) S.talk.draw(r); };\n\n// ---- a session: the Play, the talk box, the queued speeches, and the flags of the chapter ---------------------------------\nDQ.newSession = (opts = {}) => {\n  const play = new DQ.Play({ stream: opts.stream || 'main', bee: opts.bee });\n  play.game = game; DQ.game = game;\n  const talk = new E.Dialog(game, { speed: 46, voice: 'voice_builder', bg: '#14122a', border: '#d9b77c', nameColor: '#ffe27a' });\n  return { play, talk, queue: [], mode: opts.mode || 'story' };\n};\nDQ.sayIn = (lines, o) => { const S = DQ.session; if (S) S.queue.push({ lines, o: o || {} }); };\n\n// the play's own speeches go to the session's queue\nconst wirePlay = S => {\n  const p = S.play;\n  p.say = (lines, o) => S.queue.push({ lines, o: o || {} });\n  p.onCraft = () => { DQ.modal = DQ.openCraft(p, game, () => { DQ.modal = null; }); };\n  p.onSatchel = () => { DQ.modal = DQ.openSatchel(p, game, () => { DQ.modal = null; }); };\n};\n\n// ---- the Quilting Bee: a timed round, scored, reported to AI Hub when there is one ---------------------------------------\nDQ.beeScore = p => Math.round(p.stats.broken + p.stats.kills * 5 + p.cheer * 2 + p.stats.rooms * 10 + p.townLevel * 20 + p.stats.crafted * 2);\nDQ.BEE_SECONDS = 180;\n\n// the Attract autopilot: wanders, mines the block ahead, swings at what comes close, places a block now and then\nDQ.autopilot = (p, I, dt) => {\n  const b = p.builder;\n  p.ai = p.ai || { turn: 0, jump: 0, place: 0 };\n  p.ai.turn -= dt;\n  if (p.ai.turn <= 0) { p.ai.turn = 2 + Math.random() * 2; b.facing += (Math.random() - 0.5) * 2.4; }\n  const near = p.monsters.find(m => !m.dead && Math.hypot(m.x - b.x, m.y - b.y) < 22);\n  if (near) b.facing = Math.atan2(near.y - b.y, near.x - b.x);\n  p.ai.place -= dt;\n  if (p.ai.place <= 0 && p.hotbar[p.sel] && p.count(p.hotbar[p.sel]) > 0) { p.ai.place = 3 + Math.random() * 3; p.placeHeld(); }\n  const pressed = {};\n  const bind = a => ({ move: () => [Math.cos(b.facing), Math.sin(b.facing)], pressed: name => !!pressed[name] && pressed[name] === a, down: () => false, lastDevice: 'keyboard', label: () => '' });\n  return bind;\n};\n\n// ---- the scenes ---------------------------------------------------------------------------------------------------------\nDQ.scenes = () => {\n  const title = {\n    enter() { DQ.idle = 0; DQ.titleMenu = null; DQ.titleItems = null; DQ.buildTitle(); },\n    update(dt) {\n      const I = game.input;\n      if (DQ.talkStep(dt)) return;\n      if (I.anyPressed && I.anyPressed()) DQ.idle = 0; else DQ.idle += dt;\n      if (DQ.idle > 10 && !DQ.touchOnly) { game.go('attract'); return; }\n      if (DQ.titleMenu) DQ.titleMenu.update(dt);\n    },\n    draw(r) {\n      r.sky(['#2a1d5a', '#6c4a9e']);\n      const m = Math.round(r.H / 2);\n      r.overlay(g => {\n        E.font.title(g, DQ.TITLE.toUpperCase(), r.W / 2, m - 74, { scale: 3, align: 'center', colors: ['#ffe27a', '#ffb3d9'], depth: 2, depthColor: '#2a1d5a' });\n        E.font.text(g, 'Stitch the realm back together', r.W / 2, m - 36, '#e8e4ff', { align: 'center', shadow: '#000' });\n      });\n      if (DQ.touchOnly) {\n        r.text('CONTROLLER OR KEYBOARD REQUIRED', r.W / 2, m + 36, '#ffe27a', { align: 'center', shadow: '#000' });\n        r.text('Open the settings below, or plug in a controller.', r.W / 2, m + 50, '#e8e4ff', { align: 'center', shadow: '#000' });\n      }\n      if (DQ.titleMenu) DQ.titleMenu.draw(r);\n      r.text('v' + DQ.VERSION + '  ·  ' + (globalThis.AIHub && AIHub.active ? 'AI Hub session' : 'Solo'), 6, r.H - 10, '#9c96c4', { shadow: '#000', font: 'tiny' });\n      DQ.talkDraw(r);\n    },\n  };\n\n  const intro = {\n    enter() { DQ.newGameIntro = true; },\n    update(dt) { if (DQ.talkStep(dt)) return; if (!DQ.session || !DQ.session.queue.length) game.go('play', { fresh: false }); },\n    draw(r) { r.sky(['#1a1438', '#3a2870']); DQ.talkDraw(r); },\n  };\n\n  const play = {\n    pausable: true,\n    enter(data) {\n      game.lights.enabled = true;\n      if (!DQ.session || (data && data.fresh)) {\n        DQ.session = DQ.newSession();\n        wirePlay(DQ.session);\n        DQ.session.queue.push({ lines: ['Oh! You\\'re awake, my dear Builder. The Knack went out of the world with Frayvern, and the patchwork came unpicked.', 'Break a block, mend a patch. Each one you make is a little of the world coming back.', 'Go on, then. I\\'ll be right here, stitching.'], o: { name: 'GRANNY GOSSAMER' } });\n      }\n      DQ.session.play.game = game;\n      DQ.game = game;\n      DQ.modal = null;\n    },\n    update(dt) {\n      const I = game.input, S = DQ.session, p = S.play;\n      if (DQ.talkStep(dt)) return;\n      if (DQ.modal) { DQ.modal.update(dt); return; }\n      if (I.pressed('satchel')) { DQ.modal = DQ.openSatchel(p, game, () => { DQ.modal = null; }); return; }\n      p.update(dt, I);\n      // the camera follows the Builder; the turn keys swing it a quarter round\n      const b = p.builder;\n      game.focus(b.x, b.y, b.z + 8);\n      if (I.pressed('turnL')) game.rotateView(-90);\n      if (I.pressed('turnR')) game.rotateView(90);\n      if (I.pressed('view') && game.nextView) game.nextView();\n      // the light: a dusk over the meadow, and a bright day\n      game.lights.enabled = true;\n      game.lights.ambient = p.isNight ? 0.42 : p.hour < 8 || p.hour > 17 ? 0.7 : 0.95;\n      if (p.chapterClear && !S.cleared) { S.cleared = true; game.go('end'); }\n      if (p.say && p.hasTalk) { /* none */ }\n    },\n    draw(r) { DQ.drawPlay(r); if (DQ.modal && DQ.modal.draw) DQ.modal.draw(r); DQ.talkDraw(r); },\n    exit() { if (DQ.session) DQ.session.talk && DQ.session.talk.close && DQ.session.talk.close(); },\n  };\n\n  const attract = {\n    enter() {\n      const S = DQ.newSession({ stream: 'attract' });\n      S.play.attract = true; DQ.attractSession = S; DQ.session = S;\n      S.play.onCraft = () => {}; S.play.onSatchel = () => {};\n      // the cheat: the attract demo can't be beaten, and it keeps its Builder on its feet\n      game.lights.enabled = true;\n      DQ.attractT = 0;\n    },\n    update(dt) {\n      const I = game.input, S = DQ.session, p = S.play;\n      if (I.anyPressed && I.anyPressed()) { game.go('title'); return; }\n      DQ.attractT += dt;\n      if (p.dead) p.respawn();\n      p.builder.hp = p.builder.maxHp; p.builder.belly = 100;\n      // the AI: walk, mine and swing, place a block, sleep at night when near a bed (the Builder is cheated)\n      const b = p.builder, ai = p.ai || (p.ai = { turn: 0, place: 0 });\n      ai.turn -= dt;\n      if (ai.turn <= 0) { ai.turn = 1.5 + Math.random() * 2; b.facing += (Math.random() - 0.5) * 2.6; }\n      const near = p.monsters.find(m => !m.dead && Math.hypot(m.x - b.x, m.y - b.y) < 22 * 16 / 16 * 1.2);\n      if (near) b.facing = Math.atan2(near.y - b.y, near.x - b.x);\n      const fake = {\n        move: () => [Math.cos(b.facing) * 0.9, Math.sin(b.facing) * 0.9],\n        pressed: name => name === 'attack' ? (DQ.attractT % 0.9 < dt) : name === 'jump' ? (Math.random() < 0.01) : name === 'place' ? (DQ.attractT % 4 < dt) : false,\n        down: () => false, lastDevice: 'keyboard', label: () => '', anyPressed: () => false, repeat: () => false,\n      };\n      p.update(dt, fake);\n      game.focus(b.x, b.y, b.z + 8);\n      game.lights.ambient = p.isNight ? 0.42 : 0.9;\n    },\n    draw(r) {\n      DQ.drawPlay(r, true);\n      r.overlay(g => {\n        E.font.title(g, DQ.TITLE.toUpperCase(), r.W / 2, 22, { scale: 2, align: 'center', colors: ['#ffe27a', '#ffb3d9'] });\n        E.font.text(g, 'DEMO · PRESS ANY BUTTON TO PLAY', r.W / 2, r.H - 20, '#ffe27a', { align: 'center', shadow: '#000' });\n      });\n    },\n    exit() { DQ.attractSession = null; },\n  };\n\n  const dev = {\n    update(dt) {\n      const I = game.input, S = DQ.session; if (!S) { game.go('title'); return; }\n      DQ.devUpdate(I, S.play);\n      if (I.pressed('cancel')) game.go('play', { fresh: false });\n    },\n    draw(r) { DQ.drawPlay(r); DQ.devDraw(r, DQ.session && DQ.session.play); },\n  };\n\n  const about = {\n    enter(data) { DQ.aboutFrom = data && data.from ? data.from : 'title'; DQ.aboutPage = 0; },\n    update(dt) {\n      const I = game.input;\n      if (I.pressed('confirm') || I.pressed('cancel')) { if (DQ.aboutFrom === 'play') game.go('play', { fresh: false }); else game.go('title'); }\n      if (I.pressed('right') || I.pressed('down')) DQ.aboutPage = Math.min(DQ.REPORT_PAGES.length - 1, DQ.aboutPage + 1);\n      if (I.pressed('left') || I.pressed('up')) DQ.aboutPage = Math.max(0, DQ.aboutPage - 1);\n    },\n    draw(r) {\n      r.sky(['#14122a', '#2a1d5a']);\n      DQ.drawAbout(r);\n    },\n  };\n\n  const end = {\n    enter() { DQ.endT = 0; },\n    update(dt) {\n      DQ.endT += dt;\n      const I = game.input;\n      if (DQ.endT > 1 && (I.pressed('confirm') || I.pressed('cancel'))) game.go('play', { fresh: false });\n    },\n    draw(r) {\n      r.sky(['#2a2a1a', '#6a5a2a']);\n      const p = DQ.session && DQ.session.play;\n      r.overlay(g => {\n        E.font.title(g, 'CHAPTER ONE DONE', r.W / 2, r.H / 2 - 60, { scale: 2, align: 'center', colors: ['#ffe27a', '#ffb3d9'] });\n        E.font.text(g, 'Gnarlgrim is unpicked. The realm is stitching itself back together.', r.W / 2, r.H / 2 - 26, '#ffffff', { align: 'center', shadow: '#000' });\n        if (p) E.font.text(g, 'Blocks mended ' + p.stats.broken + '   Monsters ' + p.stats.kills + '   Cheer ' + Math.floor(p.cheer) + '   Town level ' + p.townLevel, r.W / 2, r.H / 2 - 4, '#e8e4ff', { align: 'center', shadow: '#000' });\n        E.font.text(g, 'Free play goes on. Press ' + DQ.glyph('attack') + ' to keep building.', r.W / 2, r.H / 2 + 22, '#c8c2e6', { align: 'center', shadow: '#000' });\n      });\n    },\n  };\n\n  const bee = {\n    enter() {\n      DQ.bee = { t: 0, phase: 'wait', score: 0, reported: false, hub: null, timeUp: false };\n      DQ.session = DQ.newSession({ stream: 'bee', mode: 'bee' });\n      wirePlay(DQ.session);\n      DQ.session.queue = [];\n      DQ.beeConnect();\n    },\n    update(dt) {\n      const I = game.input, B = DQ.bee;\n      if (!B) return;\n      if (B.phase === 'wait') { if (B.ready && B.go) { B.phase = 'play'; B.t = 0; } else if (!AIHub_active() && I.pressed('confirm')) { B.phase = 'play'; B.t = 0; } return; }\n      if (B.phase === 'play') {\n        const p = DQ.session.play;\n        B.t += dt;\n        p.update(dt, I);\n        game.focus(p.builder.x, p.builder.y, p.builder.z + 8);\n        B.score = DQ.beeScore(p);\n        if (Math.floor(B.t) !== B.lastSec) { B.lastSec = Math.floor(B.t); DQ.beeProgress(B.score); }\n        if (B.t >= DQ.BEE_SECONDS || B.timeUp) { B.phase = 'done'; DQ.beeFinish(); }\n      }\n      if (B.phase === 'done' && (I.pressed('confirm') || I.pressed('cancel')) && (B.t > DQ.BEE_SECONDS + 1 || B.timeUp)) { game.go('title'); }\n    },\n    draw(r) {\n      const B = DQ.bee;\n      if (DQ.session && DQ.session.play) DQ.drawPlay(r);\n      r.overlay(g => {\n        E.ui.box(g, 6, r.H - 52, 180, 20, { bg: '#14122a', border: '#ffe27a', alpha: 0.8 });\n        const left = Math.max(0, Math.ceil(DQ.BEE_SECONDS - (B ? B.t : 0)));\n        E.font.text(g, 'QUILTING BEE  ' + Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0') + '  SCORE ' + (B ? B.score : 0), 12, r.H - 46, '#ffe27a', { shadow: '#000' });\n        if (B && B.phase === 'wait') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 40, 300, 60, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, B.hubText || 'QUILTING BEE', r.W / 2, r.H / 2 - 30, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, B.hubSub || 'Press ' + DQ.glyph('confirm') + ' to start', r.W / 2, r.H / 2 - 4, '#e8e4ff', { align: 'center', shadow: '#000' });\n        }\n        if (B && B.phase === 'done') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 50, 300, 90, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, 'ROUND OVER', r.W / 2, r.H / 2 - 40, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, 'Score ' + B.score + '. Thank you for stitching with us.', r.W / 2, r.H / 2 - 12, '#ffffff', { align: 'center', shadow: '#000' });\n        }\n      });\n    },\n  };\n  return { title, intro, play, attract, dev, about, end, bee };\n};\nconst AIHub_active = () => !!(globalThis.AIHub && AIHub.active);\n\n// the title's menu, built from the saves and the mode\nDQ.buildTitle = () => {\n  const hub = AIHub_active();\n  const items = [\n    { label: 'NEW GAME', disabled: DQ.touchOnly },\n    { label: 'CONTINUE', disabled: DQ.touchOnly || !(game.saves && game.saves.any) },\n    { label: 'QUILTING BEE', disabled: DQ.touchOnly },\n    { label: 'ABOUT & CREDITS' },\n    { label: 'OPTIONS' },\n  ];\n  DQ.titleItems = items;\n  DQ.titleMenu = new E.Menu(game, items, {\n    x: 'center', y: 'center', box: true, title: 'DRAGON QUILT BUILDERS',\n    onPick(i) {\n      if (items[i].disabled) return;\n      if (i === 0) { DQ.session = null; game.go('intro'); }\n      if (i === 1) { const s = game.saves.latest && game.saves.latest(); if (s) { DQ.loadFromSave(s); game.go('play', { fresh: false }); } }\n      if (i === 2) game.go('bee');\n      if (i === 3) game.go('about', { from: 'title' });\n      if (i === 4) game.menu('settings');\n    },\n  });\n};\nDQ.loadFromSave = s => {\n  const p = DQ.Play.restore(s.data);\n  DQ.session = { play: p, talk: null, queue: [], mode: 'story' };\n  DQ.session.talk = new E.Dialog(game, { speed: 46, voice: 'voice_builder', bg: '#14122a', border: '#d9b77c', nameColor: '#ffe27a' });\n  wirePlay(DQ.session);\n  DQ.session.play.game = game;\n};\n// the Quilting Bee's hub round: parallel, each copy plays its own. The hub's card shows; the round starts with 'start'.\nDQ.beeConnect = () => {\n  const hub = globalThis.AIHub;\n  if (!hub) return;\n  hub.connect({ mode: 'parallel', seats: [1, 4] }).then(info => {\n    if (!info) return;\n    DQ.bee.hub = info;\n    DQ.bee.hubText = 'QUILTING BEE';\n    DQ.bee.hubSub = 'Waiting for the round to start';\n    hub.on('start', () => { DQ.bee.ready = true; DQ.bee.go = true; });\n    hub.on('time-up', () => { DQ.bee.timeUp = true; });\n    hub.on('end', () => { DQ.bee.phase = 'done'; });\n    hub.ready();\n  });\n};\nDQ.beeProgress = score => { if (globalThis.AIHub && AIHub.active) AIHub.progress({ score, label: 'Score ' + score }); };\nDQ.beeFinish = () => {\n  const B = DQ.bee; if (!B || B.reported) return; B.reported = true;\n  if (globalThis.AIHub && AIHub.active) AIHub.result({ score: B.score, stats: { blocks: DQ.session.play.stats.broken, monsters: DQ.session.play.stats.kills } });\n};\n\nDQ.setGame = g => { game = g; DQ.game = g; };\nDQ.getGame = () => game;\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7418,"cache_read_input_tokens":197798,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7418},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"82f305e6-f719-4e49-881f-e498d001a34b","uuid":"5a898794-f743-4a59-b841-09e29452ff0a","timestamp":"2026-11-04T05:21:57.084Z","request_id":"req_011CghKsn1R3bhWQuBYmr4x2","wire_tool_inputs":{"toolu_01635qVk2ZSwutJjE4JqsMtW":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326/src/35-scenes.js","content":"// The scenes: title, the intro, play, attract (the AI plays), the Quilting Bee round (a timed score, playable solo or in an\n// AI Hub session), Dev Tools, About & Credits, and the chapter's end. Plus the dialog pump and the touch-only notice.\n(() => {\nconst E = My3D2dge, DQ = globalThis.DQ;\nlet game = null;\n\n// ---- sound: presets for the effects, and the audio wrapper the systems call ----------------------------------------------\nDQ.audio = {\n  sfx(name, vol = 1) { if (game) game.audio.sfx(name, { vol }); },\n  music(key) { if (game && DQ.SONGS[key]) game.audio.music(DQ.SONGS[key]); },\n};\nDQ.defineSounds = g => {\n  g.audio.define('rrip', { wave: 'noise', dur: 0.2, vol: 0.32, vary: 0.2 });\n  g.audio.define('rip', { wave: 'noise', dur: 0.05, vol: 0.12 });\n  g.audio.define('stitch', { wave: 'square', freq: 880, to: 1320, dur: 0.08, vol: 0.2 });\n  g.audio.define('craft', { wave: 'triangle', freq: 523, to: 784, arp: [0, 4, 7], step: 0.06, dur: 0.2, vol: 0.2 });\n  g.audio.define('hurt', { wave: 'saw', freq: 240, to: 90, dur: 0.25, vol: 0.3 });\n  g.audio.define('defeat', { wave: 'square', freq: 660, to: 220, dur: 0.3, vol: 0.2 });\n  for (const k of Object.keys(DQ.VOICES)) g.audio.define('voice_' + k, DQ.VOICES[k]);\n};\n// which voice a speaker has: the names they're called by in the dialog box\nDQ.voiceFor = name => {\n  if (!name) return 'voice_builder';\n  if (/GRANNY/.test(name)) return 'voice_granny';\n  const n = DQ.NPCS.find(p => p.name.toUpperCase() === name);\n  return 'voice_' + (n ? n.voice : 'mid');\n};\n\n// ---- the dialog: one talk box, a queue of speeches, pumped each step ---------------------------------------------------\nDQ.talkStep = dt => {\n  const S = DQ.session; if (!S || !S.talk) return false;\n  if (!S.talk.open && S.queue.length) {\n    const q = S.queue.shift();\n    S.talk.voice = DQ.voiceFor(q.o.name);\n    S.talk.say(q.lines, { name: q.o.name, portrait: q.o.portrait, onDone: () => {} });\n  }\n  if (S.talk.open) { S.talk.update(dt); return true; }\n  return false;\n};\nDQ.talkDraw = r => { const S = DQ.session; if (S && S.talk && S.talk.open) S.talk.draw(r); };\n\n// ---- a session: the Play, the talk box, the queued speeches, and the flags of the chapter ---------------------------------\nDQ.newSession = (opts = {}) => {\n  const play = new DQ.Play({ stream: opts.stream || 'main', bee: opts.bee });\n  play.game = game; DQ.game = game;\n  const talk = new E.Dialog(game, { speed: 46, voice: 'voice_builder', bg: '#14122a', border: '#d9b77c', nameColor: '#ffe27a' });\n  return { play, talk, queue: [], mode: opts.mode || 'story' };\n};\nDQ.sayIn = (lines, o) => { const S = DQ.session; if (S) S.queue.push({ lines, o: o || {} }); };\n\n// the play's own speeches go to the session's queue\nconst wirePlay = S => {\n  const p = S.play;\n  p.say = (lines, o) => S.queue.push({ lines, o: o || {} });\n  p.onCraft = () => { DQ.modal = DQ.openCraft(p, game, () => { DQ.modal = null; }); };\n  p.onSatchel = () => { DQ.modal = DQ.openSatchel(p, game, () => { DQ.modal = null; }); };\n};\n\n// ---- the Quilting Bee: a timed round, scored, reported to AI Hub when there is one ---------------------------------------\nDQ.beeScore = p => Math.round(p.stats.broken + p.stats.kills * 5 + p.cheer * 2 + p.stats.rooms * 10 + p.townLevel * 20 + p.stats.crafted * 2);\nDQ.BEE_SECONDS = 180;\n\n// the Attract autopilot: wanders, mines the block ahead, swings at what comes close, places a block now and then\nDQ.autopilot = (p, I, dt) => {\n  const b = p.builder;\n  p.ai = p.ai || { turn: 0, jump: 0, place: 0 };\n  p.ai.turn -= dt;\n  if (p.ai.turn <= 0) { p.ai.turn = 2 + Math.random() * 2; b.facing += (Math.random() - 0.5) * 2.4; }\n  const near = p.monsters.find(m => !m.dead && Math.hypot(m.x - b.x, m.y - b.y) < 22);\n  if (near) b.facing = Math.atan2(near.y - b.y, near.x - b.x);\n  p.ai.place -= dt;\n  if (p.ai.place <= 0 && p.hotbar[p.sel] && p.count(p.hotbar[p.sel]) > 0) { p.ai.place = 3 + Math.random() * 3; p.placeHeld(); }\n  const pressed = {};\n  const bind = a => ({ move: () => [Math.cos(b.facing), Math.sin(b.facing)], pressed: name => !!pressed[name] && pressed[name] === a, down: () => false, lastDevice: 'keyboard', label: () => '' });\n  return bind;\n};\n\n// ---- the scenes ---------------------------------------------------------------------------------------------------------\nDQ.scenes = () => {\n  const title = {\n    enter() { DQ.idle = 0; DQ.titleMenu = null; DQ.titleItems = null; DQ.buildTitle(); },\n    update(dt) {\n      const I = game.input;\n      if (DQ.talkStep(dt)) return;\n      if (I.anyPressed && I.anyPressed()) DQ.idle = 0; else DQ.idle += dt;\n      if (DQ.idle > 10 && !DQ.touchOnly) { game.go('attract'); return; }\n      if (DQ.titleMenu) DQ.titleMenu.update(dt);\n    },\n    draw(r) {\n      r.sky(['#2a1d5a', '#6c4a9e']);\n      const m = Math.round(r.H / 2);\n      r.overlay(g => {\n        E.font.title(g, DQ.TITLE.toUpperCase(), r.W / 2, m - 74, { scale: 3, align: 'center', colors: ['#ffe27a', '#ffb3d9'], depth: 2, depthColor: '#2a1d5a' });\n        E.font.text(g, 'Stitch the realm back together', r.W / 2, m - 36, '#e8e4ff', { align: 'center', shadow: '#000' });\n      });\n      if (DQ.touchOnly) {\n        r.text('CONTROLLER OR KEYBOARD REQUIRED', r.W / 2, m + 36, '#ffe27a', { align: 'center', shadow: '#000' });\n        r.text('Open the settings below, or plug in a controller.', r.W / 2, m + 50, '#e8e4ff', { align: 'center', shadow: '#000' });\n      }\n      if (DQ.titleMenu) DQ.titleMenu.draw(r);\n      r.text('v' + DQ.VERSION + '  ·  ' + (globalThis.AIHub && AIHub.active ? 'AI Hub session' : 'Solo'), 6, r.H - 10, '#9c96c4', { shadow: '#000', font: 'tiny' });\n      DQ.talkDraw(r);\n    },\n  };\n\n  const intro = {\n    enter() { DQ.newGameIntro = true; },\n    update(dt) { if (DQ.talkStep(dt)) return; if (!DQ.session || !DQ.session.queue.length) game.go('play', { fresh: false }); },\n    draw(r) { r.sky(['#1a1438', '#3a2870']); DQ.talkDraw(r); },\n  };\n\n  const play = {\n    pausable: true,\n    enter(data) {\n      game.lights.enabled = true;\n      if (!DQ.session || (data && data.fresh)) {\n        DQ.session = DQ.newSession();\n        wirePlay(DQ.session);\n        DQ.session.queue.push({ lines: ['Oh! You\\'re awake, my dear Builder. The Knack went out of the world with Frayvern, and the patchwork came unpicked.', 'Break a block, mend a patch. Each one you make is a little of the world coming back.', 'Go on, then. I\\'ll be right here, stitching.'], o: { name: 'GRANNY GOSSAMER' } });\n      }\n      DQ.session.play.game = game;\n      DQ.game = game;\n      DQ.modal = null;\n    },\n    update(dt) {\n      const I = game.input, S = DQ.session, p = S.play;\n      if (DQ.talkStep(dt)) return;\n      if (DQ.modal) { DQ.modal.update(dt); return; }\n      if (I.pressed('satchel')) { DQ.modal = DQ.openSatchel(p, game, () => { DQ.modal = null; }); return; }\n      p.update(dt, I);\n      // the camera follows the Builder; the turn keys swing it a quarter round\n      const b = p.builder;\n      game.focus(b.x, b.y, b.z + 8);\n      if (I.pressed('turnL')) game.rotateView(-90);\n      if (I.pressed('turnR')) game.rotateView(90);\n      if (I.pressed('view') && game.nextView) game.nextView();\n      // the light: a dusk over the meadow, and a bright day\n      game.lights.enabled = true;\n      game.lights.ambient = p.isNight ? 0.42 : p.hour < 8 || p.hour > 17 ? 0.7 : 0.95;\n      if (p.chapterClear && !S.cleared) { S.cleared = true; game.go('end'); }\n      if (p.say && p.hasTalk) { /* none */ }\n    },\n    draw(r) { DQ.drawPlay(r); if (DQ.modal && DQ.modal.draw) DQ.modal.draw(r); DQ.talkDraw(r); },\n    exit() { if (DQ.session) DQ.session.talk && DQ.session.talk.close && DQ.session.talk.close(); },\n  };\n\n  const attract = {\n    enter() {\n      const S = DQ.newSession({ stream: 'attract' });\n      S.play.attract = true; DQ.attractSession = S; DQ.session = S;\n      S.play.onCraft = () => {}; S.play.onSatchel = () => {};\n      // the cheat: the attract demo can't be beaten, and it keeps its Builder on its feet\n      game.lights.enabled = true;\n      DQ.attractT = 0;\n    },\n    update(dt) {\n      const I = game.input, S = DQ.session, p = S.play;\n      if (I.anyPressed && I.anyPressed()) { game.go('title'); return; }\n      DQ.attractT += dt;\n      if (p.dead) p.respawn();\n      p.builder.hp = p.builder.maxHp; p.builder.belly = 100;\n      // the AI: walk, mine and swing, place a block, sleep at night when near a bed (the Builder is cheated)\n      const b = p.builder, ai = p.ai || (p.ai = { turn: 0, place: 0 });\n      ai.turn -= dt;\n      if (ai.turn <= 0) { ai.turn = 1.5 + Math.random() * 2; b.facing += (Math.random() - 0.5) * 2.6; }\n      const near = p.monsters.find(m => !m.dead && Math.hypot(m.x - b.x, m.y - b.y) < 22 * 16 / 16 * 1.2);\n      if (near) b.facing = Math.atan2(near.y - b.y, near.x - b.x);\n      const fake = {\n        move: () => [Math.cos(b.facing) * 0.9, Math.sin(b.facing) * 0.9],\n        pressed: name => name === 'attack' ? (DQ.attractT % 0.9 < dt) : name === 'jump' ? (Math.random() < 0.01) : name === 'place' ? (DQ.attractT % 4 < dt) : false,\n        down: () => false, lastDevice: 'keyboard', label: () => '', anyPressed: () => false, repeat: () => false,\n      };\n      p.update(dt, fake);\n      game.focus(b.x, b.y, b.z + 8);\n      game.lights.ambient = p.isNight ? 0.42 : 0.9;\n    },\n    draw(r) {\n      DQ.drawPlay(r, true);\n      r.overlay(g => {\n        E.font.title(g, DQ.TITLE.toUpperCase(), r.W / 2, 22, { scale: 2, align: 'center', colors: ['#ffe27a', '#ffb3d9'] });\n        E.font.text(g, 'DEMO · PRESS ANY BUTTON TO PLAY', r.W / 2, r.H - 20, '#ffe27a', { align: 'center', shadow: '#000' });\n      });\n    },\n    exit() { DQ.attractSession = null; },\n  };\n\n  const dev = {\n    update(dt) {\n      const I = game.input, S = DQ.session; if (!S) { game.go('title'); return; }\n      DQ.devUpdate(I, S.play);\n      if (I.pressed('cancel')) game.go('play', { fresh: false });\n    },\n    draw(r) { DQ.drawPlay(r); DQ.devDraw(r, DQ.session && DQ.session.play); },\n  };\n\n  const about = {\n    enter(data) { DQ.aboutFrom = data && data.from ? data.from : 'title'; DQ.aboutPage = 0; },\n    update(dt) {\n      const I = game.input;\n      if (I.pressed('confirm') || I.pressed('cancel')) { if (DQ.aboutFrom === 'play') game.go('play', { fresh: false }); else game.go('title'); }\n      if (I.pressed('right') || I.pressed('down')) DQ.aboutPage = Math.min(DQ.REPORT_PAGES.length - 1, DQ.aboutPage + 1);\n      if (I.pressed('left') || I.pressed('up')) DQ.aboutPage = Math.max(0, DQ.aboutPage - 1);\n    },\n    draw(r) {\n      r.sky(['#14122a', '#2a1d5a']);\n      DQ.drawAbout(r);\n    },\n  };\n\n  const end = {\n    enter() { DQ.endT = 0; },\n    update(dt) {\n      DQ.endT += dt;\n      const I = game.input;\n      if (DQ.endT > 1 && (I.pressed('confirm') || I.pressed('cancel'))) game.go('play', { fresh: false });\n    },\n    draw(r) {\n      r.sky(['#2a2a1a', '#6a5a2a']);\n      const p = DQ.session && DQ.session.play;\n      r.overlay(g => {\n        E.font.title(g, 'CHAPTER ONE DONE', r.W / 2, r.H / 2 - 60, { scale: 2, align: 'center', colors: ['#ffe27a', '#ffb3d9'] });\n        E.font.text(g, 'Gnarlgrim is unpicked. The realm is stitching itself back together.', r.W / 2, r.H / 2 - 26, '#ffffff', { align: 'center', shadow: '#000' });\n        if (p) E.font.text(g, 'Blocks mended ' + p.stats.broken + '   Monsters ' + p.stats.kills + '   Cheer ' + Math.floor(p.cheer) + '   Town level ' + p.townLevel, r.W / 2, r.H / 2 - 4, '#e8e4ff', { align: 'center', shadow: '#000' });\n        E.font.text(g, 'Free play goes on. Press ' + DQ.glyph('attack') + ' to keep building.', r.W / 2, r.H / 2 + 22, '#c8c2e6', { align: 'center', shadow: '#000' });\n      });\n    },\n  };\n\n  const bee = {\n    enter() {\n      DQ.bee = { t: 0, phase: 'wait', score: 0, reported: false, hub: null, timeUp: false };\n      DQ.session = DQ.newSession({ stream: 'bee', mode: 'bee' });\n      wirePlay(DQ.session);\n      DQ.session.queue = [];\n      DQ.beeConnect();\n    },\n    update(dt) {\n      const I = game.input, B = DQ.bee;\n      if (!B) return;\n      if (B.phase === 'wait') { if (B.ready && B.go) { B.phase = 'play'; B.t = 0; } else if (!AIHub_active() && I.pressed('confirm')) { B.phase = 'play'; B.t = 0; } return; }\n      if (B.phase === 'play') {\n        const p = DQ.session.play;\n        B.t += dt;\n        p.update(dt, I);\n        game.focus(p.builder.x, p.builder.y, p.builder.z + 8);\n        B.score = DQ.beeScore(p);\n        if (Math.floor(B.t) !== B.lastSec) { B.lastSec = Math.floor(B.t); DQ.beeProgress(B.score); }\n        if (B.t >= DQ.BEE_SECONDS || B.timeUp) { B.phase = 'done'; DQ.beeFinish(); }\n      }\n      if (B.phase === 'done' && (I.pressed('confirm') || I.pressed('cancel')) && (B.t > DQ.BEE_SECONDS + 1 || B.timeUp)) { game.go('title'); }\n    },\n    draw(r) {\n      const B = DQ.bee;\n      if (DQ.session && DQ.session.play) DQ.drawPlay(r);\n      r.overlay(g => {\n        E.ui.box(g, 6, r.H - 52, 180, 20, { bg: '#14122a', border: '#ffe27a', alpha: 0.8 });\n        const left = Math.max(0, Math.ceil(DQ.BEE_SECONDS - (B ? B.t : 0)));\n        E.font.text(g, 'QUILTING BEE  ' + Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0') + '  SCORE ' + (B ? B.score : 0), 12, r.H - 46, '#ffe27a', { shadow: '#000' });\n        if (B && B.phase === 'wait') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 40, 300, 60, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, B.hubText || 'QUILTING BEE', r.W / 2, r.H / 2 - 30, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, B.hubSub || 'Press ' + DQ.glyph('confirm') + ' to start', r.W / 2, r.H / 2 - 4, '#e8e4ff', { align: 'center', shadow: '#000' });\n        }\n        if (B && B.phase === 'done') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 50, 300, 90, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, 'ROUND OVER', r.W / 2, r.H / 2 - 40, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, 'Score ' + B.score + '. Thank you for stitching with us.', r.W / 2, r.H / 2 - 12, '#ffffff', { align: 'center', shadow: '#000' });\n        }\n      });\n    },\n  };\n  return { title, intro, play, attract, dev, about, end, bee };\n};\nconst AIHub_active = () => !!(globalThis.AIHub && AIHub.active);\n\n// the title's menu, built from the saves and the mode\nDQ.buildTitle = () => {\n  const hub = AIHub_active();\n  const items = [\n    { label: 'NEW GAME', disabled: DQ.touchOnly },\n    { label: 'CONTINUE', disabled: DQ.touchOnly || !(game.saves && game.saves.any) },\n    { label: 'QUILTING BEE', disabled: DQ.touchOnly },\n    { label: 'ABOUT & CREDITS' },\n    { label: 'OPTIONS' },\n  ];\n  DQ.titleItems = items;\n  DQ.titleMenu = new E.Menu(game, items, {\n    x: 'center', y: 'center', box: true, title: 'DRAGON QUILT BUILDERS',\n    onPick(i) {\n      if (items[i].disabled) return;\n      if (i === 0) { DQ.session = null; game.go('intro'); }\n      if (i === 1) { const s = game.saves.latest && game.saves.latest(); if (s) { DQ.loadFromSave(s); game.go('play', { fresh: false }); } }\n      if (i === 2) game.go('bee');\n      if (i === 3) game.go('about', { from: 'title' });\n      if (i === 4) game.menu('settings');\n    },\n  });\n};\nDQ.loadFromSave = s => {\n  const p = DQ.Play.restore(s.data);\n  DQ.session = { play: p, talk: null, queue: [], mode: 'story' };\n  DQ.session.talk = new E.Dialog(game, { speed: 46, voice: 'voice_builder', bg: '#14122a', border: '#d9b77c', nameColor: '#ffe27a' });\n  wirePlay(DQ.session);\n  DQ.session.play.game = game;\n};\n// the Quilting Bee's hub round: parallel, each copy plays its own. The hub's card shows; the round starts with 'start'.\nDQ.beeConnect = () => {\n  const hub = globalThis.AIHub;\n  if (!hub) return;\n  hub.connect({ mode: 'parallel', seats: [1, 4] }).then(info => {\n    if (!info) return;\n    DQ.bee.hub = info;\n    DQ.bee.hubText = 'QUILTING BEE';\n    DQ.bee.hubSub = 'Waiting for the round to start';\n    hub.on('start', () => { DQ.bee.ready = true; DQ.bee.go = true; });\n    hub.on('time-up', () => { DQ.bee.timeUp = true; });\n    hub.on('end', () => { DQ.bee.phase = 'done'; });\n    hub.ready();\n  });\n};\nDQ.beeProgress = score => { if (globalThis.AIHub && AIHub.active) AIHub.progress({ score, label: 'Score ' + score }); };\nDQ.beeFinish = () => {\n  const B = DQ.bee; if (!B || B.reported) return; B.reported = true;\n  if (globalThis.AIHub && AIHub.active) AIHub.result({ score: B.score, stats: { blocks: DQ.session.play.stats.broken, monsters: DQ.session.play.stats.kills } });\n};\n\nDQ.setGame = g => { game = g; DQ.game = g; };\nDQ.getGame = () => game;\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01635qVk2ZSwutJjE4JqsMtW","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326/src/35-scenes.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"82f305e6-f719-4e49-881f-e498d001a34b","uuid":"a3724848-5b79-4fd1-b244-3e77a92b1e51","timestamp":"2026-11-04T05:21:57.099Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326/src/35-scenes.js","content":"// The scenes: title, the intro, play, attract (the AI plays), the Quilting Bee round (a timed score, playable solo or in an\n// AI Hub session), Dev Tools, About & Credits, and the chapter's end. Plus the dialog pump and the touch-only notice.\n(() => {\nconst E = My3D2dge, DQ = globalThis.DQ;\nlet game = null;\n\n// ---- sound: presets for the effects, and the audio wrapper the systems call ----------------------------------------------\nDQ.audio = {\n  sfx(name, vol = 1) { if (game) game.audio.sfx(name, { vol }); },\n  music(key) { if (game && DQ.SONGS[key]) game.audio.music(DQ.SONGS[key]); },\n};\nDQ.defineSounds = g => {\n  g.audio.define('rrip', { wave: 'noise', dur: 0.2, vol: 0.32, vary: 0.2 });\n  g.audio.define('rip', { wave: 'noise', dur: 0.05, vol: 0.12 });\n  g.audio.define('stitch', { wave: 'square', freq: 880, to: 1320, dur: 0.08, vol: 0.2 });\n  g.audio.define('craft', { wave: 'triangle', freq: 523, to: 784, arp: [0, 4, 7], step: 0.06, dur: 0.2, vol: 0.2 });\n  g.audio.define('hurt', { wave: 'saw', freq: 240, to: 90, dur: 0.25, vol: 0.3 });\n  g.audio.define('defeat', { wave: 'square', freq: 660, to: 220, dur: 0.3, vol: 0.2 });\n  for (const k of Object.keys(DQ.VOICES)) g.audio.define('voice_' + k, DQ.VOICES[k]);\n};\n// which voice a speaker has: the names they're called by in the dialog box\nDQ.voiceFor = name => {\n  if (!name) return 'voice_builder';\n  if (/GRANNY/.test(name)) return 'voice_granny';\n  const n = DQ.NPCS.find(p => p.name.toUpperCase() === name);\n  return 'voice_' + (n ? n.voice : 'mid');\n};\n\n// ---- the dialog: one talk box, a queue of speeches, pumped each step ---------------------------------------------------\nDQ.talkStep = dt => {\n  const S = DQ.session; if (!S || !S.talk) return false;\n  if (!S.talk.open && S.queue.length) {\n    const q = S.queue.shift();\n    S.talk.voice = DQ.voiceFor(q.o.name);\n    S.talk.say(q.lines, { name: q.o.name, portrait: q.o.portrait, onDone: () => {} });\n  }\n  if (S.talk.open) { S.talk.update(dt); return true; }\n  return false;\n};\nDQ.talkDraw = r => { const S = DQ.session; if (S && S.talk && S.talk.open) S.talk.draw(r); };\n\n// ---- a session: the Play, the talk box, the queued speeches, and the flags of the chapter ---------------------------------\nDQ.newSession = (opts = {}) => {\n  const play = new DQ.Play({ stream: opts.stream || 'main', bee: opts.bee });\n  play.game = game; DQ.game = game;\n  const talk = new E.Dialog(game, { speed: 46, voice: 'voice_builder', bg: '#14122a', border: '#d9b77c', nameColor: '#ffe27a' });\n  return { play, talk, queue: [], mode: opts.mode || 'story' };\n};\nDQ.sayIn = (lines, o) => { const S = DQ.session; if (S) S.queue.push({ lines, o: o || {} }); };\n\n// the play's own speeches go to the session's queue\nconst wirePlay = S => {\n  const p = S.play;\n  p.say = (lines, o) => S.queue.push({ lines, o: o || {} });\n  p.onCraft = () => { DQ.modal = DQ.openCraft(p, game, () => { DQ.modal = null; }); };\n  p.onSatchel = () => { DQ.modal = DQ.openSatchel(p, game, () => { DQ.modal = null; }); };\n};\n\n// ---- the Quilting Bee: a timed round, scored, reported to AI Hub when there is one ---------------------------------------\nDQ.beeScore = p => Math.round(p.stats.broken + p.stats.kills * 5 + p.cheer * 2 + p.stats.rooms * 10 + p.townLevel * 20 + p.stats.crafted * 2);\nDQ.BEE_SECONDS = 180;\n\n// the Attract autopilot: wanders, mines the block ahead, swings at what comes close, places a block now and then\nDQ.autopilot = (p, I, dt) => {\n  const b = p.builder;\n  p.ai = p.ai || { turn: 0, jump: 0, place: 0 };\n  p.ai.turn -= dt;\n  if (p.ai.turn <= 0) { p.ai.turn = 2 + Math.random() * 2; b.facing += (Math.random() - 0.5) * 2.4; }\n  const near = p.monsters.find(m => !m.dead && Math.hypot(m.x - b.x, m.y - b.y) < 22);\n  if (near) b.facing = Math.atan2(near.y - b.y, near.x - b.x);\n  p.ai.place -= dt;\n  if (p.ai.place <= 0 && p.hotbar[p.sel] && p.count(p.hotbar[p.sel]) > 0) { p.ai.place = 3 + Math.random() * 3; p.placeHeld(); }\n  const pressed = {};\n  const bind = a => ({ move: () => [Math.cos(b.facing), Math.sin(b.facing)], pressed: name => !!pressed[name] && pressed[name] === a, down: () => false, lastDevice: 'keyboard', label: () => '' });\n  return bind;\n};\n\n// ---- the scenes ---------------------------------------------------------------------------------------------------------\nDQ.scenes = () => {\n  const title = {\n    enter() { DQ.idle = 0; DQ.titleMenu = null; DQ.titleItems = null; DQ.buildTitle(); },\n    update(dt) {\n      const I = game.input;\n      if (DQ.talkStep(dt)) return;\n      if (I.anyPressed && I.anyPressed()) DQ.idle = 0; else DQ.idle += dt;\n      if (DQ.idle > 10 && !DQ.touchOnly) { game.go('attract'); return; }\n      if (DQ.titleMenu) DQ.titleMenu.update(dt);\n    },\n    draw(r) {\n      r.sky(['#2a1d5a', '#6c4a9e']);\n      const m = Math.round(r.H / 2);\n      r.overlay(g => {\n        E.font.title(g, DQ.TITLE.toUpperCase(), r.W / 2, m - 74, { scale: 3, align: 'center', colors: ['#ffe27a', '#ffb3d9'], depth: 2, depthColor: '#2a1d5a' });\n        E.font.text(g, 'Stitch the realm back together', r.W / 2, m - 36, '#e8e4ff', { align: 'center', shadow: '#000' });\n      });\n      if (DQ.touchOnly) {\n        r.text('CONTROLLER OR KEYBOARD REQUIRED', r.W / 2, m + 36, '#ffe27a', { align: 'center', shadow: '#000' });\n        r.text('Open the settings below, or plug in a controller.', r.W / 2, m + 50, '#e8e4ff', { align: 'center', shadow: '#000' });\n      }\n      if (DQ.titleMenu) DQ.titleMenu.draw(r);\n      r.text('v' + DQ.VERSION + '  ·  ' + (globalThis.AIHub && AIHub.active ? 'AI Hub session' : 'Solo'), 6, r.H - 10, '#9c96c4', { shadow: '#000', font: 'tiny' });\n      DQ.talkDraw(r);\n    },\n  };\n\n  const intro = {\n    enter() { DQ.newGameIntro = true; },\n    update(dt) { if (DQ.talkStep(dt)) return; if (!DQ.session || !DQ.session.queue.length) game.go('play', { fresh: false }); },\n    draw(r) { r.sky(['#1a1438', '#3a2870']); DQ.talkDraw(r); },\n  };\n\n  const play = {\n    pausable: true,\n    enter(data) {\n      game.lights.enabled = true;\n      if (!DQ.session || (data && data.fresh)) {\n        DQ.session = DQ.newSession();\n        wirePlay(DQ.session);\n        DQ.session.queue.push({ lines: ['Oh! You\\'re awake, my dear Builder. The Knack went out of the world with Frayvern, and the patchwork came unpicked.', 'Break a block, mend a patch. Each one you make is a little of the world coming back.', 'Go on, then. I\\'ll be right here, stitching.'], o: { name: 'GRANNY GOSSAMER' } });\n      }\n      DQ.session.play.game = game;\n      DQ.game = game;\n      DQ.modal = null;\n    },\n    update(dt) {\n      const I = game.input, S = DQ.session, p = S.play;\n      if (DQ.talkStep(dt)) return;\n      if (DQ.modal) { DQ.modal.update(dt); return; }\n      if (I.pressed('satchel')) { DQ.modal = DQ.openSatchel(p, game, () => { DQ.modal = null; }); return; }\n      p.update(dt, I);\n      // the camera follows the Builder; the turn keys swing it a quarter round\n      const b = p.builder;\n      game.focus(b.x, b.y, b.z + 8);\n      if (I.pressed('turnL')) game.rotateView(-90);\n      if (I.pressed('turnR')) game.rotateView(90);\n      if (I.pressed('view') && game.nextView) game.nextView();\n      // the light: a dusk over the meadow, and a bright day\n      game.lights.enabled = true;\n      game.lights.ambient = p.isNight ? 0.42 : p.hour < 8 || p.hour > 17 ? 0.7 : 0.95;\n      if (p.chapterClear && !S.cleared) { S.cleared = true; game.go('end'); }\n      if (p.say && p.hasTalk) { /* none */ }\n    },\n    draw(r) { DQ.drawPlay(r); if (DQ.modal && DQ.modal.draw) DQ.modal.draw(r); DQ.talkDraw(r); },\n    exit() { if (DQ.session) DQ.session.talk && DQ.session.talk.close && DQ.session.talk.close(); },\n  };\n\n  const attract = {\n    enter() {\n      const S = DQ.newSession({ stream: 'attract' });\n      S.play.attract = true; DQ.attractSession = S; DQ.session = S;\n      S.play.onCraft = () => {}; S.play.onSatchel = () => {};\n      // the cheat: the attract demo can't be beaten, and it keeps its Builder on its feet\n      game.lights.enabled = true;\n      DQ.attractT = 0;\n    },\n    update(dt) {\n      const I = game.input, S = DQ.session, p = S.play;\n      if (I.anyPressed && I.anyPressed()) { game.go('title'); return; }\n      DQ.attractT += dt;\n      if (p.dead) p.respawn();\n      p.builder.hp = p.builder.maxHp; p.builder.belly = 100;\n      // the AI: walk, mine and swing, place a block, sleep at night when near a bed (the Builder is cheated)\n      const b = p.builder, ai = p.ai || (p.ai = { turn: 0, place: 0 });\n      ai.turn -= dt;\n      if (ai.turn <= 0) { ai.turn = 1.5 + Math.random() * 2; b.facing += (Math.random() - 0.5) * 2.6; }\n      const near = p.monsters.find(m => !m.dead && Math.hypot(m.x - b.x, m.y - b.y) < 22 * 16 / 16 * 1.2);\n      if (near) b.facing = Math.atan2(near.y - b.y, near.x - b.x);\n      const fake = {\n        move: () => [Math.cos(b.facing) * 0.9, Math.sin(b.facing) * 0.9],\n        pressed: name => name === 'attack' ? (DQ.attractT % 0.9 < dt) : name === 'jump' ? (Math.random() < 0.01) : name === 'place' ? (DQ.attractT % 4 < dt) : false,\n        down: () => false, lastDevice: 'keyboard', label: () => '', anyPressed: () => false, repeat: () => false,\n      };\n      p.update(dt, fake);\n      game.focus(b.x, b.y, b.z + 8);\n      game.lights.ambient = p.isNight ? 0.42 : 0.9;\n    },\n    draw(r) {\n      DQ.drawPlay(r, true);\n      r.overlay(g => {\n        E.font.title(g, DQ.TITLE.toUpperCase(), r.W / 2, 22, { scale: 2, align: 'center', colors: ['#ffe27a', '#ffb3d9'] });\n        E.font.text(g, 'DEMO · PRESS ANY BUTTON TO PLAY', r.W / 2, r.H - 20, '#ffe27a', { align: 'center', shadow: '#000' });\n      });\n    },\n    exit() { DQ.attractSession = null; },\n  };\n\n  const dev = {\n    update(dt) {\n      const I = game.input, S = DQ.session; if (!S) { game.go('title'); return; }\n      DQ.devUpdate(I, S.play);\n      if (I.pressed('cancel')) game.go('play', { fresh: false });\n    },\n    draw(r) { DQ.drawPlay(r); DQ.devDraw(r, DQ.session && DQ.session.play); },\n  };\n\n  const about = {\n    enter(data) { DQ.aboutFrom = data && data.from ? data.from : 'title'; DQ.aboutPage = 0; },\n    update(dt) {\n      const I = game.input;\n      if (I.pressed('confirm') || I.pressed('cancel')) { if (DQ.aboutFrom === 'play') game.go('play', { fresh: false }); else game.go('title'); }\n      if (I.pressed('right') || I.pressed('down')) DQ.aboutPage = Math.min(DQ.REPORT_PAGES.length - 1, DQ.aboutPage + 1);\n      if (I.pressed('left') || I.pressed('up')) DQ.aboutPage = Math.max(0, DQ.aboutPage - 1);\n    },\n    draw(r) {\n      r.sky(['#14122a', '#2a1d5a']);\n      DQ.drawAbout(r);\n    },\n  };\n\n  const end = {\n    enter() { DQ.endT = 0; },\n    update(dt) {\n      DQ.endT += dt;\n      const I = game.input;\n      if (DQ.endT > 1 && (I.pressed('confirm') || I.pressed('cancel'))) game.go('play', { fresh: false });\n    },\n    draw(r) {\n      r.sky(['#2a2a1a', '#6a5a2a']);\n      const p = DQ.session && DQ.session.play;\n      r.overlay(g => {\n        E.font.title(g, 'CHAPTER ONE DONE', r.W / 2, r.H / 2 - 60, { scale: 2, align: 'center', colors: ['#ffe27a', '#ffb3d9'] });\n        E.font.text(g, 'Gnarlgrim is unpicked. The realm is stitching itself back together.', r.W / 2, r.H / 2 - 26, '#ffffff', { align: 'center', shadow: '#000' });\n        if (p) E.font.text(g, 'Blocks mended ' + p.stats.broken + '   Monsters ' + p.stats.kills + '   Cheer ' + Math.floor(p.cheer) + '   Town level ' + p.townLevel, r.W / 2, r.H / 2 - 4, '#e8e4ff', { align: 'center', shadow: '#000' });\n        E.font.text(g, 'Free play goes on. Press ' + DQ.glyph('attack') + ' to keep building.', r.W / 2, r.H / 2 + 22, '#c8c2e6', { align: 'center', shadow: '#000' });\n      });\n    },\n  };\n\n  const bee = {\n    enter() {\n      DQ.bee = { t: 0, phase: 'wait', score: 0, reported: false, hub: null, timeUp: false };\n      DQ.session = DQ.newSession({ stream: 'bee', mode: 'bee' });\n      wirePlay(DQ.session);\n      DQ.session.queue = [];\n      DQ.beeConnect();\n    },\n    update(dt) {\n      const I = game.input, B = DQ.bee;\n      if (!B) return;\n      if (B.phase === 'wait') { if (B.ready && B.go) { B.phase = 'play'; B.t = 0; } else if (!AIHub_active() && I.pressed('confirm')) { B.phase = 'play'; B.t = 0; } return; }\n      if (B.phase === 'play') {\n        const p = DQ.session.play;\n        B.t += dt;\n        p.update(dt, I);\n        game.focus(p.builder.x, p.builder.y, p.builder.z + 8);\n        B.score = DQ.beeScore(p);\n        if (Math.floor(B.t) !== B.lastSec) { B.lastSec = Math.floor(B.t); DQ.beeProgress(B.score); }\n        if (B.t >= DQ.BEE_SECONDS || B.timeUp) { B.phase = 'done'; DQ.beeFinish(); }\n      }\n      if (B.phase === 'done' && (I.pressed('confirm') || I.pressed('cancel')) && (B.t > DQ.BEE_SECONDS + 1 || B.timeUp)) { game.go('title'); }\n    },\n    draw(r) {\n      const B = DQ.bee;\n      if (DQ.session && DQ.session.play) DQ.drawPlay(r);\n      r.overlay(g => {\n        E.ui.box(g, 6, r.H - 52, 180, 20, { bg: '#14122a', border: '#ffe27a', alpha: 0.8 });\n        const left = Math.max(0, Math.ceil(DQ.BEE_SECONDS - (B ? B.t : 0)));\n        E.font.text(g, 'QUILTING BEE  ' + Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0') + '  SCORE ' + (B ? B.score : 0), 12, r.H - 46, '#ffe27a', { shadow: '#000' });\n        if (B && B.phase === 'wait') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 40, 300, 60, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, B.hubText || 'QUILTING BEE', r.W / 2, r.H / 2 - 30, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, B.hubSub || 'Press ' + DQ.glyph('confirm') + ' to start', r.W / 2, r.H / 2 - 4, '#e8e4ff', { align: 'center', shadow: '#000' });\n        }\n        if (B && B.phase === 'done') {\n          E.ui.box(g, r.W / 2 - 150, r.H / 2 - 50, 300, 90, { bg: '#14122a', border: '#ffe27a', alpha: 0.95 });\n          E.font.text(g, 'ROUND OVER', r.W / 2, r.H / 2 - 40, '#ffe27a', { align: 'center', shadow: '#000', scale: 2 });\n          E.font.text(g, 'Score ' + B.score + '. Thank you for stitching with us.', r.W / 2, r.H / 2 - 12, '#ffffff', { align: 'center', shadow: '#000' });\n        }\n      });\n    },\n  };\n  return { title, intro, play, attract, dev, about, end, bee };\n};\nconst AIHub_active = () => !!(globalThis.AIHub && AIHub.active);\n\n// the title's menu, built from the saves and the mode\nDQ.buildTitle = () => {\n  const hub = AIHub_active();\n  const items = [\n    { label: 'NEW GAME', disabled: DQ.touchOnly },\n    { label: 'CONTINUE', disabled: DQ.touchOnly || !(game.saves && game.saves.any) },\n    { label: 'QUILTING BEE', disabled: DQ.touchOnly },\n    { label: 'ABOUT & CREDITS' },\n    { label: 'OPTIONS' },\n  ];\n  DQ.titleItems = items;\n  DQ.titleMenu = new E.Menu(game, items, {\n    x: 'center', y: 'center', box: true, title: 'DRAGON QUILT BUILDERS',\n    onPick(i) {\n      if (items[i].disabled) return;\n      if (i === 0) { DQ.session = null; game.go('intro'); }\n      if (i === 1) { const s = game.saves.latest && game.saves.latest(); if (s) { DQ.loadFromSave(s); game.go('play', { fresh: false }); } }\n      if (i === 2) game.go('bee');\n      if (i === 3) game.go('about', { from: 'title' });\n      if (i === 4) game.menu('settings');\n    },\n  });\n};\nDQ.loadFromSave = s => {\n  const p = DQ.Play.restore(s.data);\n  DQ.session = { play: p, talk: null, queue: [], mode: 'story' };\n  DQ.session.talk = new E.Dialog(game, { speed: 46, voice: 'voice_builder', bg: '#14122a', border: '#d9b77c', nameColor: '#ffe27a' });\n  wirePlay(DQ.session);\n  DQ.session.play.game = game;\n};\n// the Quilting Bee's hub round: parallel, each copy plays its own. The hub's card shows; the round starts with 'start'.\nDQ.beeConnect = () => {\n  const hub = globalThis.AIHub;\n  if (!hub) return;\n  hub.connect({ mode: 'parallel', seats: [1, 4] }).then(info => {\n    if (!info) return;\n    DQ.bee.hub = info;\n    DQ.bee.hubText = 'QUILTING BEE';\n    DQ.bee.hubSub = 'Waiting for the round to start';\n    hub.on('start', () => { DQ.bee.ready = true; DQ.bee.go = true; });\n    hub.on('time-up', () => { DQ.bee.timeUp = true; });\n    hub.on('end', () => { DQ.bee.phase = 'done'; });\n    hub.ready();\n  });\n};\nDQ.beeProgress = score => { if (globalThis.AIHub && AIHub.active) AIHub.progress({ score, label: 'Score ' + score }); };\nDQ.beeFinish = () => {\n  const B = DQ.bee; if (!B || B.reported) return; B.reported = true;\n  if (globalThis.AIHub && AIHub.active) AIHub.result({ score: B.score, stats: { blocks: DQ.session.play.stats.broken, monsters: DQ.session.play.stats.kills } });\n};\n\nDQ.setGame = g => { game = g; DQ.game = g; };\nDQ.getGame = () => game;\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01635qVk2ZSwutJjE4JqsMtW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
