p < hp0, 'hp ' + m.hp + ' from ' + hp0);\n  place(30, 40, 0);\n  const pz = p.world.top(30, 40), qz = p.world.top(33, 40);\n  p.world.set(30, 40, pz, DQ.B.PORTAL); p.world.set(33, 40, qz, DQ.B.PORTAL);\n  p.refreshSpecials();\n  game.debug.teleport(30.5 * T, 40.5 * T, 0);\n  p.builder.z = (pz + 1) * T;\n  game.advance(0.3);\n  check('systems', 'stepping onto a portal carries the Builder to the other one', Math.abs(p.builder.x - 33.5 * T) < 8, 'x ' + (p.builder.x / T).toFixed(2));\n  DQ.god = false;\n  check('systems', 'no errors in the new systems', game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n});\n\ngroup('glyph', () => {\"\"\")\nopen('tests/run.mjs','w').write(s)\nprint('ok')\nPYEOF\nnode --check src/40-draw.js && node tools/build.mjs >/dev/null && timeout 600 node tests/run.mjs | tail -6","description":"Add region generation and tests for patterns, ballistas and portals"}},"wire_ingest_context":{"toolu_015aDdH2C3zVrrKotsn4G3Up":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-221326__x5b1962/work/DragonCrateBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326"}}}
