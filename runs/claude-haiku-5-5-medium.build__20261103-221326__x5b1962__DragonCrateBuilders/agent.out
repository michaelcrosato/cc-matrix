r.close();\nEOF\ntimeout 200 node _wav.mjs \"$(cd .. && cd .. && pwd)/DragonCrateBuilders-DragonQuestBuilders-claude-haiku-5-5-medium-20261103-221326.html\" \"$(cd .. && pwd)/animalese-sample.wav\"; rm -f _wav.mjs; ls -la ../animalese-sample.wav","description":"Render a short Animalese voice sample to a WAV file for listening"}}}
