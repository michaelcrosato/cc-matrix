{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '140,340p' vendor/engine/dist/handoff/kits/artillery.js\"","aggregated_output":"    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 20  ARTILLERY  (Worms, Scorched Earth). @modules physics terrain grid\n * BLAST ISLAND: two teams of three grubs on an island of earth, rock and sand that every blast carves. The teams take\n * turns (E.Turns, the grid module's), each sending its next grub; in its thirty seconds a grub walks, jumps, aims and\n * fires. Three weapons: a ROCKET the wind blows, a GRENADE that bounces (a physics body on the terrain's collider) and\n * blows on its fuse, a CLUSTER bomb that bursts into five (two a team). A blast throws grubs; a long fall hurts; the sea\n * drowns; from turn 16 the sea rises (sudden death). One player against the CPU, two players on one screen in turn, or\n * two CPUs. The CPU tries its shots in simulation (each weapon at every angle and power, with the wind and the fuse as\n * they are), takes the one that hurts its foes most and its own least, and fires it with a hand a little unsteady.\n * Keys: left and right (A, D) walk, up and down (W, S) aim, hold Space to charge and let go to fire, Enter jumps, Q or E\n * (or 1, 2, 3) picks the weapon. MOUSE: drag back from anywhere and let go to fire (the pull is the power); a click\n * walks there. TOUCH: the same: a drag back fires, a tap walks; the JUMP and WEAPON buttons. HOW IT WORKS: E.Terrain is\n * the island (carve, ground, walk, ray); E.Physics bounces the grenades on land.collider(); E.Turns alternates the\n * teams. bot() lets two CPUs play a match to its end, twice (tools/kits-test.mjs). Deep links: #artillery (the choice\n * of players), #artillery/cpu (two CPUs at once).\n * ===================================================================================== */\nconst ARTILLERY = (() => {\n  const WW = 800, WH = 320, SKY = 560, DT = 1 / 120, px = E.px, clamp = (v, a, b) => v < a ? a : v > b ? b : v;\n  E.VIEWS.artillery = E.VIEWS.artillery || new E.View('artillery', 'Island', 0, 0, 1, 1);   // a side view of whole pixels: the terrain stays crisp\n  const SOIL = { color: '#7a4a2a', top: '#52a83a', edge: '#3a2210', depth: 3 }, ROCK = { color: '#6a6878', top: '#9a98a8', edge: '#34323e', depth: 2 }, SAND = { color: '#c8a868', top: '#e8d098', edge: '#8a6a3a', depth: 2 };\n  const TEAMS = [\n    { name: 'RED GRUBS', short: 'RED', color: '#ff5a4a', dark: '#8a1a1a', grubs: ['SPUD', 'NIBBS', 'BOFF'] },\n    { name: 'BLUE GRUBS', short: 'BLUE', color: '#4ab4ff', dark: '#1a4a8a', grubs: ['WIGGLE', 'DOT', 'MUNCH'] }];\n  // speed: at full power, pixels a second; r and dmg: the blast's reach and its damage at the middle\n  const WEAPONS = [\n    { id: 'rocket', name: 'ROCKET', speed: 520, wind: true, r: 28, dmg: 45 },\n    { id: 'grenade', name: 'GRENADE', speed: 400, fuse: 3, r: 30, dmg: 45 },\n    { id: 'cluster', name: 'CLUSTER', speed: 440, r: 16, dmg: 20, ammo: 2, bits: 5 }];\n  const BIT = { id: 'bit', r: 14, dmg: 16 }, G_SHOT = 300, G_GRUB = 420, HP = 80, TURN_T = 30, SUDDEN = 16, PULL = 70;\n  const PHYS = { gravity: [0, -G_SHOT], substeps: 2, iterations: 4, sleep: false }, GREN = { bounce: .45, friction: .5, damping: .1 }, FUSE_N = Math.round(3 / DT);\n  const SONG = { bpm: 112, steps: 4, tracks: [\n    { wave: 'square', vol: .08, notes: 'G4 . B4 . D5 - B4 . C5 . A4 . F#4 . D4 . | G4 . B4 . D5 . G5 - F#5 . E5 . D5 . C5 . | B4 . G4 . A4 . F#4 . G4 - - . . . D4 .' },\n    { wave: 'triangle', vol: .28, notes: 'G2 . D3 . G2 . D3 . D2 . A2 . D2 . A2 . | G2 . D3 . G2 . D3 . C2 . G2 . D2 . A2 . | G2 . D3 . D2 . A2 . G2 . . . G2 . . .' },\n    { wave: 'drums', vol: .09, notes: 'k . h . s . h . k k h . s . h h' }] };\n  const KEYS = Object.assign({}, E.Input.DEFAULT, { walkL: ['ArrowLeft', 'KeyA', 'Pad14'], walkR: ['ArrowRight', 'KeyD', 'Pad15'], aimUp: ['ArrowUp', 'KeyW', 'Pad12'], aimDown: ['ArrowDown', 'KeyS', 'Pad13'],\n    fire: ['Space', 'Pad0', 'Pad7'], jump: ['Enter', 'NumpadEnter', 'KeyJ', 'Pad2'], weapon: ['KeyQ', 'KeyE', 'Pad3', 'Pad5'], w1: ['Digit1'], w2: ['Digit2'], w3: ['Digit3'] });\n\n  /* ---- 1. THE ISLAND: hills of earth over rock, beaches of sand, a few caves; the grubs spread along it, the teams mixed ---- */\n  let land, back, profile, grubs = [], teams, turns, water = 34;\n  function island(seed) {\n    const rnd = E.rng(seed), p = [0, 1, 2, 3].map(() => rnd() * Math.PI * 2), mid = 118 + rnd() * 40;\n    const top = x => { const e = clamp(Math.min(x - 24, WW - 24 - x) / 130, 0, 1), s = e * e * (3 - 2 * e); return 6 + (mid + 44 * Math.sin(x / 110 + p[0]) + 24 * Math.sin(x / 47 + p[1]) + 8 * Math.sin(x / 17 + p[2])) * s; };\n    const H = []; for (let x = 0; x < WW; x++) H[x] = top(x + .5);\n    land = new E.Terrain({ w: WW, h: WH, materials: [SOIL, ROCK, SAND], chunk: 64 });\n    back = E.mkCanvas(WW, WH); const bg = E.ctx2d(back), img = bg.createImageData(WW, WH), D = img.data;   // (the earth behind: what a cave or a deep crater shows)\n    for (let x = 0; x < WW; x++) for (let y = 0; y < H[x] - 7; y++) { const o = ((WH - 1 - y) * WW + x) * 4, n = (E.hash2(x >> 1, y >> 1) - .5) * 10, rock = y < H[x] - 30; D[o] = (rock ? 40 : 52) + n; D[o + 1] = (rock ? 36 : 32) + n; D[o + 2] = (rock ? 44 : 26) + n; D[o + 3] = 255; }\n    bg.putImageData(img, 0, 0); profile = null;\n    land.fill((x, y) => { const h = H[Math.floor(x)]; return y >= h ? 0 : h < water + 18 ? 3 : y < h - 28 - 12 * Math.sin(x / 31 + p[3]) ? 2 : 1; });\n    for (let i = 0; i < 4; i++) { const x = 150 + rnd() * (WW - 300), h = H[Math.floor(x)]; if (h > water + 70) land.carve(x, water + 26 + rnd() * (h - water - 64), 11 + rnd() * 9); }   // (caves inside the hills)\n    // six places along the land, the teams in turn, each nudged a little\n    grubs = [];\n    for (let i = 0; i < 6; i++) {\n      let x = 100 + (i + .5) * (WW - 200) / 6 + (rnd() - .5) * 40; for (let k = 0; k < 40 && !((land.ground(x, WH) || 0) > water + 10); k++) x += x < WW / 2 ? 6 : -6;\n      grubs.push(grub(i % 2, TEAMS[i % 2].grubs[i >> 1], x));\n    }\n  }\n  const grub = (team, name, x) => ({ team, name, x, y: land.ground(x, WH) || water + 20, vx: 0, vy: 0, ground: true, hp: HP, shown: HP, face: x < WW / 2 ? 1 : -1, aim: .5, dead: false, drowned: false, sunk: 0, fly: false, jump: false, hurt: 0, walkT: 0, goto: null, still: 0 });\n\n  /* ---- 2. THE RULES: a turn each, the shots and their blasts, damage, falls and the sea, the end ---- */\n  let look = { x: 0, y: 0, t: 0 }, mode = 'menu', modeT = 0, play = 'cpu', cur = null, phase = 'aim', phT = 0, turnT = 0, turnNo = 0, wind = 0, shots = [], power = 0, charging = false, cpu = null, stats, banner = null, winner = -1, pull = null, menuI = 0, matchSeed = 1;\n  function begin(how, seed) {\n    play = how; matchSeed = seed || 1 + Math.floor(Math.random() * 1e6); water = 34; island(matchSeed); shots = []; winner = -1; turnNo = 0; mode = 'play'; modeT = 0;\n    teams = TEAMS.map((T, i) => ({ i, speed: 100, next: 0, human: how === 'two' || (how === 'cpu' && i === 0), ammo: WEAPONS.map(w => w.ammo === undefined ? Infinity : w.ammo), weapon: 0 }));\n    turns = new E.Turns(teams, { mode: 'speed' });   // (two actors of one speed: they alternate)\n    stats = { shots: 0, used: {}, kills: 0, drowned: 0, falls: 0, carved: 0, damage: 0 };\n    game.input.consumeAll(); A.music(how === 'demo' ? null : SONG); startTurn();\n  }\n  // the next team's next grub still standing\n  function nextGrub() {\n    for (let k = 0; k < 2; k++) { const t = turns.next(), mine = grubs.filter(g => g.team === t.i); for (let j = 0; j < mine.length; j++) { const g = mine[(t.next + j) % mine.length]; if (!g.dead) { t.next = (mine.indexOf(g) + 1) % mine.length; return g; } } }\n    return null;\n  }\n  function startTurn() {\n    turnNo++; cur = nextGrub(); look.t = 0; phase = 'aim'; phT = 0; turnT = TURN_T; power = 0; charging = false; pull = null;\n    wind = Math.round((Math.random() * 2 - 1) * 10) / 10;\n    if (turnNo > SUDDEN) { water += 8; banner = { s: 'THE SEA RISES', sub: 'SUDDEN DEATH', t: 1.6, team: -1 }; }\n    else banner = { s: cur.name, sub: TEAMS[cur.team].name + (play === 'two' ? '  PLAYER ' + (cur.team + 1) : teams[cur.team].human ? '  YOU' : '  CPU'), t: 1.4, team: cur.team };\n    cpu = teams[cur.team].human ? null : { phase: 'think', t: 0, i: 0, cands: null, best: null };\n    A.sfx('select');\n  }\n  const weapon = () => WEAPONS[teams[cur.team].weapon];\n  function pickWeapon(i) { const t = teams[cur.team]; for (let k = 0; k < 3; k++, i = (i + 1) % 3) if (t.ammo[i] > 0) { if (t.weapon !== i) A.sfx('blip'); t.weapon = i; return; } }\n  // the shot's start: from the grub's middle, a little out along the aim (ang: radians, 0 right, up positive)\n  const muzzle = (g, ang, pw, W) => { const sp = Math.max(.15, pw) * W.speed; return [g.x + Math.cos(ang) * 8, g.y + 6 + Math.sin(ang) * 8, Math.cos(ang) * sp, Math.sin(ang) * sp]; };\n  function fire(g, ang, pw) {\n    const t = teams[g.team], W = weapon(), [x, y, vx, vy] = muzzle(g, ang, pw, W);\n    if (W.id === 'grenade') { const w = new E.Physics(PHYS); w.add(land.collider()); const b = w.circle(x, y, 2.5, GREN); b.vx = vx; b.vy = vy; shots.push({ w: W, body: b, world: w, n: 0, x, y }); }\n    else shots.push({ w: W, x, y, vx, vy, t: 0, owner: g });\n    t.ammo[t.weapon]--; if (t.ammo[t.weapon] <= 0) pickWeapon(0);\n    stats.shots++; stats.used[W.id] = (stats.used[W.id] || 0) + 1; phase = 'fly'; phT = 0; charging = false; power = 0; pull = null; cur.goto = null;\n    A.sfx(W.id === 'rocket' ? 'shoot' : 'swing'); P.smoke(x, 0, y, 3, { size: 3 });\n  }\n  // one step of a rocket's, a cluster's or a bomblet's flight: gravity, the wind (a rocket's), the ground and the grubs in\n  // its way; 'hit' (at its x, y), 'sea', 'gone', or null (still flying). The CPU's simulation runs this same step\n  function fly(s, dt, owner) {\n    s.vy -= G_SHOT * dt; if (s.w.wind) s.vx += wind * 90 * dt; s.t += dt;\n    const nx = s.x + s.vx * dt, ny = s.y + s.vy * dt, hit = land.ray(s.x, s.y, nx, ny);\n    if (hit) { s.x = hit[0]; s.y = hit[1]; return 'hit'; }\n    s.x = nx; s.y = ny;\n    for (const g of grubs) if (!g.dead && (g !== owner || s.t > .25) && Math.hypot(g.x - s.x, g.y + 5 - s.y) < 6) return 'hit';\n    return s.y < water ? 'sea' : s.x < -60 || s.x > WW + 60 || s.t > 12 ? 'gone' : null;\n  }\n  // a cluster's five, thrown up in a fan from where it burst\n  const bits = (x, y) => [0, 1, 2, 3, 4].map(k => ({ w: BIT, x, y: y + 3, vx: (k - 2) * 55, vy: 160 + (2 - Math.abs(k - 2)) * 25, t: 0, owner: null }));\n  function stepShots(dt) {\n    if (!dt) return;   // (a hit-stop: nothing moves, and a fuse waits)\n    for (const s of shots.slice()) {\n      if (s.body) {   // a grenade: its own physics world, the island its collider\n        s.world.step(dt); s.x = s.body.x; s.y = s.body.y;\n        if (s.y < water) { shots.splice(shots.indexOf(s), 1); splash(s.x); }\n        else if (++s.n >= FUSE_N) { shots.splice(shots.indexOf(s), 1); blast(s.x, s.y, s.w.r, s.w.dmg); }\n        continue;\n      }\n      const e = fly(s, dt, s.owner);\n      if (!e) { if (s.w.wind && Math.floor(s.t * 30) !== Math.floor((s.t - dt) * 30)) P.smoke(s.x, 0, s.y, 1, { size: 2 }); continue; }\n      shots.splice(shots.indexOf(s), 1);\n      if (e === 'hit') { blast(s.x, s.y, s.w.r, s.w.dmg); if (s.w.bits) shots.push(...bits(s.x, s.y)); }\n      else if (e === 'sea') splash(s.x);\n    }\n  }\n  function splash(x) { for (let i = 0; i < 10; i++) P.add({ kind: 'bit', x: x + (i - 5) * .8, y: 0, z: water + 1, vx: (i - 5) * 14, vz: 80 + (i % 3) * 30, g: 300, max: .7, color: '#cfe8ff', size: 1 }); A.sfx('land', { vol: .4 }); }\n  // a blast: a crater in the island, damage by distance, grubs thrown away from it\n  function blast(x, y, r, dmg) {\n    const took = land.carve(x, y, r, { particles: P, debris: 14 }); for (const k in took) stats.carved += took[k]; profile = null;\n    for (const g of grubs) {\n      if (g.dead) continue; const dx = g.x - x, dy = g.y + 5 - y, d = Math.hypot(dx, dy); if (d >= r + 6) continue;\n      const k = 1 - d / (r + 6), n = d || 1; hurt(g, Math.round(dmg * k)); g.vx = dx / n * 260 * k; g.vy = Math.max(70, dy / n * 260 * k + 120 * k); g.ground = false; g.fly = true; g.goto = null;\n    }\n    P.explosion(x, 0, y, r / 22, { debris: false, shake: r / 8 });\n  }\n  function hurt(g, d) { if (d <= 0) return; g.hp = Math.max(0, g.hp - d); g.hurt = .5; stats.damage += d; P.text(g.x, 0, g.y + 18, '-' + d, TEAMS[g.team].color, { bounce: true }); A.sfx('hurt', { vol: .5 }); }\n  function drown(g) { g.dead = g.drowned = true; g.hp = 0; g.sunk = .001; stats.drowned++; splash(g.x); A.sfx('die', { vol: .5 }); }\n  function stepGrubs(dt) {\n    for (const g of grubs) {\n      if (g.dead && (g.drowned || !g.grave)) { if (g.sunk) g.sunk += dt; continue; }\n      const was = g.x, landed = land.walk(g, dt, { gravity: G_GRUB, climb: 4, h: 9 });\n      if (landed) { if (g.fly || g.jump) { g.vx = 0; g.fly = g.jump = false; } if (landed > 230 && !g.dead) { stats.falls++; hurt(g, Math.round((landed - 230) / 4)); A.sfx('land'); } }\n      if (!g.dead && g.y < water - 2) drown(g);\n      g.still = g.vx && Math.abs(g.x - was) < 1e-3 ? g.still + dt : 0;\n      g.shown += (g.hp - g.shown) * Math.min(1, dt * 5); g.hurt = Math.max(0, g.hurt - dt);\n    }\n  }\n  // the end of a turn: everyone at rest; the beaten blow up one by one (what they throw settles first); a team left wins\n  function settle() {\n    if (phT < .7 || !grubs.every(g => g.dead || g.ground)) return;\n    const dying = grubs.find(g => !g.dead && g.hp <= 0);\n    if (dying) { dying.dead = dying.grave = true; stats.kills++; blast(dying.x, dying.y + 4, 12, 8); phT = .2; return; }\n    const alive = [0, 1].map(i => grubs.some(g => g.team === i && !g.dead));\n    if (!alive[0] || !alive[1] || turnNo >= 60) { over(alive[0] && !alive[1] ? 0 : alive[1] && !alive[0] ? 1 : -1); return; }\n    startTurn();\n  }\n  function over(w) { winner = w; mode = 'over'; modeT = 0; menuI = 0; cur = null; A.music(null); A.sfx(w >= 0 ? 'oneup' : 'cancel'); }\n\n  /* ---- 3. A TURN: the player's hands (keys, a mouse's pull, a finger's), or the CPU's: it tries every shot in simulation,\n   * a few each step, then turns, aims and charges to the one it chose ---- */\n  function turn(dt, I) {\n    const g = cur; phT += dt; if (banner && (banner.t -= dt) <= 0) banner = null;\n    if (phase === 'settle') { settle(); return; }\n    if (!g || g.dead) { phase = 'settle'; phT = 0; return; }   // (it walked into the sea)\n    if (phase === 'aim') { turnT -= dt; if (turnT <= 0) { phase = 'settle'; phT = 0; charging = false; power = 0; pull = null; A.sfx('cancel'); return; } if (turnT < 5 && Math.ceil(turnT) !== Math.ceil(turnT + dt)) A.sfx('blip', { pitch: 1.5 }); }\n    const c = cpu ? cpuHands(dt) : hands(I);\n    if (phase === 'fly' && !shots.length) { phase = 'settle'; phT = 0; }\n    if (g.ground && !g.fly && !g.jump) { g.vx = c.walk * 32; if (c.walk) { g.face = c.walk; g.walkT += dt; } else g.walkT = 0; }\n    if (c.jump && g.ground) { g.vy = 150; g.vx = g.face * 70; g.ground = false; g.jump = true; g.goto = null; A.sfx('jump'); }\n    if (phase !== 'aim') return;   // (after a shot: the grub may only walk away, a grenade's retreat)\n    if (c.aim) g.aim = clamp(g.aim + c.aim * 1.4 * dt, -AIM, AIM);\n    if (c.pick >= 0) pickWeapon(c.pick); else if (c.weapon) pickWeapon((teams[g.team].weapon + 1) % 3);\n    if (c.shot) { fire(g, c.shot[0], c.shot[1]); return; }\n    if (c.charge) { if (!charging) A.sfx('charge', { vol: .3 }); charging = true; power = Math.min(1, power + dt / 1.4); }\n    if (charging && (!c.charge || power >= 1)) fire(g, aimAngle(g), power);\n  }\n  const aimAngle = g => g.face > 0 ? g.aim : Math.PI - g.aim;\n  // a world point under a screen point (the view is whole pixels: x across, y up)\n  const toWorld = p => [p[0] + game.screen.ix, -(p[1] + game.screen.iy)];\n  function hands(I) {\n    const g = cur, c = { walk: (I.down('walkR') ? 1 : 0) - (I.down('walkL') ? 1 : 0), aim: (I.down('aimUp') ? 1 : 0) - (I.down('aimDown') ? 1 : 0), jump: I.pressed('jump'), weapon: I.pressed('weapon'), pick: ['w1', 'w2', 'w3'].findIndex(a => I.pressed(a)), charge: I.down('fire'), shot: null };\n    // a pull: a mouse's left drag (input.box) or a finger anywhere (the touch stick in drag mode, input.drag()); the shot\n    // goes the other way, its power the pull's length\n    const B = I.box(), d = I.drag();\n    if (B) pull = { dx: B.from[0] - B.to[0], dy: B.from[1] - B.to[1], done: B.done };\n    else if (I.stickOn) { pull = pull && !pull.done ? pull : { dx: 0, dy: 0 }; if (d) { pull.dx -= d[0]; pull.dy -= d[1]; } }\n    else if (pull && !pull.done) pull.done = true;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"rg -n 'Shell|new E.Menu|Humanoid|rig.pose|E.MOVES|Menu.prototype' vendor/engine/dist/handoff/API-INDEX.md | head -65 && sed -n '1,110p' vendor/engine/dist/handoff/game/game.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"rg -n 'Shell|new E.Menu|Humanoid|rig.pose|E.MOVES|Menu.prototype' vendor/engine/dist/handoff/API-INDEX.md | head -65 && sed -n '1,110p' vendor/engine/dist/handoff/game/game.js\"","aggregated_output":"69:- 648 Humanoid rig; E.Attack: slash, E.Combo: combo, E.Humanoid: rig\n88:- 1184 21d. Shell; E.Shell: shell\n121:- `E.HEIGHTS: eye, chest, level, step`: the numbers of THE HEIGHT RULES, which collision, standing, sight, reach, navigation and drawing all read (API.md, \"Heights\", and the API index's head give the  [... omitted end of long line]\n555:- `game.shell = null` †: the E.Shell over this game (an HTML interface: screens and HUD), or null\n637:- `saves.show(mode = 'load', done)` †: open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or a save. False without a menu (a headless game,  [... omitted end of long line]\n648:## 11. Humanoid rig\n650:- `new E.Attack(spec = {}, over) → slash`: new E.Attack(spec) or new E.Attack('slash', { reach: 9 }): a name from E.MOVES plus overrides\n656:- `slash.state`: what Humanoid.update wants as `attack` (null when idle)\n670:- `combo.state`: what Humanoid.update wants as `attack` (null when idle)\n676:- `new E.Humanoid(o = {}) → rig`: new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a character rig posed from math every step (API.md, \"Charact [... omitted end of long line]\n677:- `E.Humanoid.hat(id, draw)` †: a hat of the game's own: draw(h) with h.at(forward, right, up) a point round the head on screen, h.r its radius there, h.c its color (o.hat.color), h.dk a darker one, h [... omitted end of long line]\n678:- `E.Humanoid.hats` †: the hats a Humanoid may wear, by id: the built-ins (cap, band, crown, helmet, pointed) and a game's own\n679:- `E.Humanoid.pose(id, fn)` †: a held pose of the game's own: fn(J, w, rig) moves the joints (the rig's frame: forward, right, up) toward the pose by w, 0..1, which eases in and out as state.pose name [... omitted end of long line]\n680:- `E.Humanoid.poses` †: the held poses of a game's own, by id (the built-in poses are the rig's own solve: state.pose names either)\n681:- `E.Humanoid.weapon(id, spec)` †: a weapon of the game's own (or a built-in replaced): { length: the tip's distance from the hand (a number, or rig => one; tip() and the swing's trail), rest: [forwar [... omitted end of long line]\n682:- `E.Humanoid.weapons` †: the weapons a Humanoid may hold, by id: the built-ins (sword, gun, staff) and a game's own\n693:- `rig.update(dt, s = {})`: s: { x, y, z, vx, vy, facing, dash, hurt, attack, air, point } air: true while jumping or falling (legs tuck), point: true to hold the weapon hand forward (aiming a gun) at [... omitted end of long line]\n711:- `rig.poseW`: held poses: 'cheer' (item get, victory), 'cast' (both hands forward), 'guard' (fists up), 'kneel', 'crouch', 'wave', 'hips' (hands on hips), and down: 0..1 (knocked flat). stance: 'guar [... omitted end of long line]\n719:- `E.MOVES: slash, backslash, overhead, rising, thrust, spin, plunge, twohand, jab, cross, hook, uppercut, haymaker, elbow, ... (24)`: a library of named attacks with timing and body motion (anticipat [... omitted end of long line]\n720:- `E.MOVES { a0, a1, z0, z1 }`: a0 / a1 angles (+ = the right side, or up in the screen plane), z0 / z1 heights\n721:- `E.MOVES { reach, r0, r1, hand, plane, blade }`: reach, or r0 / r1 (an extending thrust); hand: 'R' | 'L' | 'both', plane: 'side' (always vertical), blade: 0 (no trail)\n722:- `E.MOVES { wind, active, recover }`: the phases' seconds\n723:- `E.MOVES { kick, spin, lunge, hop, crouch, lean, twist, hold }`: the body's motion (kick: true swings the right foot)\n725:- `E.move(name, u = .5, phase = 'active')`: any move from E.MOVES at any moment, for previews and cutscenes: rig.update(dt, { ..., attack: E.move('roundhouse', .5) }) (u 0..1 through phase)\n897:- `new E.Platformer(o = {}) → hero`: a side-scroller character body with modern, forgiving controls (coyote time, jump buffering, variable jump height, optional double jump, wall jump, dash, ladders,  [... omitted end of long line]\n900:- `hero.rigState(extra)`: state for Humanoid.update: rig.update(dt, hero.rigState({ attack }))\n1130:- `talk.say(text, o = {})`: open with one string or a list of strings (each starts a new page). opts: { name, onDone, choices, onChoice, portrait: rig (a live close-up of that Humanoid beside the text [... omitted end of long line]\n1149:- `talk.portrait`: the portrait beside the text (a Humanoid, or a function (g, x, y, size)), or null; pSize: its size in pixels; pOpts: its options ({ zoom, turn, bg })\n1155:- `new E.Menu(game, items, o = {}) → menu`: Menu with a cursor (title screens, pause menus, shops, battle commands). const menu = new E.Menu(game, ['START', 'OPTIONS', { label: 'CONTINUE', disabled: ! [... omitted end of long line]\n1184:## 21d. Shell\n1186:- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HT [... omitted end of long line]\n1187:- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) f [... omitted end of long line]\n1188:- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n1189:- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard [... omitted end of long line]\n1190:- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\n1191:- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\n1387:- `new E.Fighter(game, o = {}) → fighter` †: new E.Fighter(game, { name, x, side: 1 (faces right), rig: Humanoid options (or a Humanoid), life: 1000, walk: 75, back: 60, jump: 390, jumpX: 90, moves, t [... omitted end of long line]\n1418:- `fighter.rig` †: its E.Humanoid (drawn and posed from its state every step)\n1628:- `world.shellMap()`: the explored map for E.Shell's minimap: game.shell.hud({ minimap: world.shellMap() }) (a cell a square, the save and boss rooms marked, the hero's cell)\n1645:- `rpg.card(g, x, y, m, o = {})`: a member's card: o.portrait (a Humanoid) beside its name, level, HP and MP bars, its stats and effects; → { w, h }\n1718:- `strategy.minimap(colors = {})` †: E.Shell's minimap spec: the map, the fog, the camera's view, the units seen as dots by side, a click moving the camera\n// The handoff package's template game: a rooftop thief in the isometric view. Climb onto the roof, take the gem, and\n// don't let the guard in the street watch you for long. It shows what a game is made of (scenes, a TileMap with roofs, a\n// Mover and a Humanoid, input, the camera, a HUD) and the height-aware API: E.Mover climbs any wall (climbAny: jump at\n// it, the stick climbs, jump leaps up, it pulls up at the top) and glides (glide: jump again in the air; a sail drawn\n// over it), both on its stamina, the guard is a plain Body, map.sight and E.inArc for\n// the guard's eyes (they see over the planter, not through the roof), shapes and materials (docs/ASSETS.md: barrels and\n// crates as data, solid with map.solid; the street's cobbles a material), and game.debug for tests and tools. The pause menu,\n// settings, rebinding and full screen come with every game: menu: { controls } names the actions on its Controls screen,\n// and input.label() puts the player's own key or button in a prompt. The night is canvas lighting (game.lights): an\n// ambient, and lights added every draw (a street lamp, the gem's glow), the same in every browser and every check. The\n// HUD is HTML (E.Shell: the objective with its distance, the guard's alert, your keys), over the pixels; the title and\n// end screens are pixel art.\n// Copy it and make it your game. Test it headless: node game/test.mjs. Check it in a browser: node tools/check.mjs game/index.html\n(() => {\nconst E = My3D2dge;\nconst game = new E.Game({ canvas: 'screen', res: 'snes', expand: true, view: 'iso', views: ['iso', 'threequarter'],   // expand: full screen at any shape (the HUD anchors to r.W, r.H)\n  menu: { controls: { jump: 'Jump and climb', attack: false, dash: false, skill: false } },   // (this game uses moves and jump only)\n  draw: true });   // (headless too: game/test.mjs draws every advance on a stand-in, so a draw error shows in game.errors)\nconst ui = new E.Shell(game);   // the HTML HUD (it keeps the standard pause menu); headless, it draws nothing\nconst ROOF = 32;\nconst map = new E.TileMap({\n  rows: ['############',\n         '#..........#',\n         '#.@........#',\n         '#....p.....#',\n         '#......RRR.#',\n         '#......RGR.#',\n         '#..s...RRR.#',\n         '#..........#',\n         '############'],\n  legend: { '#': 1, R: 2, G: { tile: 2, spawn: 'gem' }, p: 3, '@': 'hero', s: 'guard' },\n  types: { 1: { h: 48, top: '#5a5068', side: '#3e3650', cut: true },\n           2: { h: ROOF, top: '#9a4a3a', side: '#c8b89a', face: 'plaster', roof: 'tiles' },\n           3: { h: 10, top: '#3e7a3a', side: '#5a4a32', face: 'plank', roof: 'leaves' } },\n  floorMat: 'cobble'   // a material (E.MATERIALS, or '#hex pattern'): the floor, wall faces and tops, shapes' parts all take them\n});\n// set dressing: shapes (E.SHAPES: objects as data, right in every view), solid where they stand (map.solid: walk into one, land on it)\nconst DRESS = [['barrel', 152, 30, { facing: .5 }], ['barrel', 166, 26, { facing: 2 }], ['crate', 22, 120, { facing: .3 }], ['cart', 72, 26, { facing: 0 }]];\nfor (const [id, x, y, o] of DRESS) map.solid(id, x, y, 0, o);\nconst GEM = E.sprite(['.c.', 'cCc', '.c.'], { c: '#48c8f0', C: '#e8faff' }, 2);\nlet hero, heroRig, guard, guardRig, alert, got, won;\n\nfunction reset() {\n  const h = map.find('hero'), g = map.find('guard');\n  hero = new E.Mover({ x: h.x, y: h.y, r: 5, climbAny: true, climbMax: 24, glide: true, staminaMax: 100 }); hero.facing = 0;   // (the roof, 32 high, is climbed)\n  heroRig = heroRig || new E.Humanoid({ size: 1.2, build: 'heroic', weapon: null, hood: true, outfit: 'coat', colors: { cloth: '#3a4a6a', cape: '#2a3a52' } });\n  guard = new E.Body({ x: g.x, y: g.y, r: 5 }); guard.facing = 0; guard.dir = 1;\n  guardRig = guardRig || new E.Humanoid({ size: 1.2, build: 'heroic', weapon: 'sword', hat: 'helmet', colors: { cloth: '#8a3a32' } });\n  alert = 0; got = false; won = false;\n}\n\nconst title = {\n  update() { if (game.input.pressed('start')) { reset(); game.go('play'); } },\n  draw(r) {\n    r.sky(['#141030', '#3a2a60']);\n    const m = Math.round(r.H / 2);   // centred on any screen\n    r.overlay(g => E.font.title(g, 'ROOFTOP', r.W / 2, m - 52, { scale: 3, align: 'center' }));\n    r.text(('CLIMB WITH ' + game.input.label('jump') + '  TAKE THE GEM  STAY UNSEEN').toUpperCase(), r.W / 2, m + 8, '#e8e0ff', { align: 'center' });\n    r.text(('PRESS ' + game.input.label('start')).toUpperCase(), r.W / 2, m + 38, '#ffffff', { align: 'center', shadow: '#000' });\n  }\n};\n\nconst play = {\n  pausable: true,\n  enter() { game.follow(hero, { z: 16 }); game.cam.bounds = v => map.bounds(v); game.lights.enabled = true; game.lights.ambient = .5; },\n  exit() { game.lights.enabled = false; ui.hud({}); },\n  update(dt) {\n    const I = game.input, was = !!(hero.wall || hero.action);\n    hero.update(dt, map, I);   // walks, jumps, climbs: the stick and the jump button, through the view\n    if (!was && (hero.wall || hero.action)) game.audio.sfx('jump');\n    // the guard walks the street and watches ahead: its eyes see over the planter, not through the roof\n    guard.vx = guard.dir * 30; guard.update(dt, map);\n    if (guard.x > 112 || guard.hitWall) guard.dir = -1; else if (guard.x < 40) guard.dir = 1;\n    guard.facing = guard.dir > 0 ? 0 : Math.PI;\n    const sees = map.sight(guard, hero) && E.inArc(guard, guard.facing, hero, 110, .6);\n    alert = sees ? alert + dt : Math.max(0, alert - dt * .5);\n    const gem = map.find('gem');\n    if (!got && E.dist(hero, { x: gem.x, y: gem.y, z: ROOF }) < 12) { got = true; game.audio.sfx('coin'); game.flash('#c8f4ff', .15); }\n    if (got && hero.z < 2) { won = true; game.go('end'); }   // back down in the street with it\n    else if (alert > 1.2) { won = false; game.audio.sfx('hurt'); game.go('end'); }\n    // the rigs are posed every step from the bodies' motion; draw only draws them\n    heroRig.update(dt, hero.rigState());\n    guardRig.update(dt, { x: guard.x, y: guard.y, z: guard.z, vx: guard.vx, vy: 0, facing: guard.facing, stance: 'ready' });\n    // the HUD, from this step's state (E.Shell redraws only what changed; the keys hide on a touch screen)\n    ui.hud({ objective: got ? { title: 'Bring it down', text: 'Back to the street with it' } : { title: 'Take the gem', text: hero.wall ? 'Climb: up, and jump to leap' : 'It lies on the roof', at: { x: gem.x, y: gem.y, z: ROOF }, from: hero },\n      bars: [{ label: 'Seen', value: Math.min(alert, 1.2), max: 1.2, color: '#ff6040' }, { label: 'Stamina', value: hero.stamina, max: hero.staminaMax, color: hero.exhausted ? '#ff6040' : '#7ad06a' }],\n      keys: [[['up', 'left', 'down', 'right'].map(a => I.label(a)).join(''), 'Move'], [I.label('jump'), 'Jump, climb, glide']] });\n  },\n  draw(r) {\n    map.drawFloor(r); map.queueWalls(r);   // (the floor runs on past the map to the screen's edges: map.outside)\n    for (const [id, x, y, o] of DRESS) r.shape(id, x, y, 0, o);\n    r.prop('lamp', 88, 88, 0, { light: true });   // a street lamp: its glow and a pool of light\n    r.decal(() => r.groundArc(guard.x, guard.y, 6, 110, guard.facing - .6, guard.facing + .6, alert > 0 ? '#ff6040' : '#ffe080', .4));   // its sight cone\n    const gem = map.find('gem');\n    if (!got) { r.sprite(gem.x, gem.y, ROOF + 6 + Math.sin(game.time * 3) * 2, GEM, { glow: .8 }); game.lights.add(gem.x, gem.y, ROOF + 6, 44, .9, { color: '#80d8ff' }); }\n    if (hero.gliding) r.queue(hero.x, hero.y, hero.z + 40, g => {   // the sail, over the hands the rig holds up\n      const c = Math.cos(hero.facing), s = Math.sin(hero.facing), P = (f, w, z) => r.w(hero.x + c * f - s * w, hero.y + s * f + c * w, hero.z + z);\n      const q = [P(9, -17, 43), P(9, 17, 43), P(-7, 15, 37), P(-7, -15, 37)], h = P(0, 0, 30);\n      for (const t of [q[0], q[1]]) E.px.line(g, t[0], t[1], h[0], h[1], '#3a2a20');\n      E.px.poly(g, q, '#d8603a'); E.px.line(g, q[0][0], q[0][1], q[1][0], q[1][1], '#f4a070');\n    });\n    for (const [b, rig] of [[hero, heroRig], [guard, guardRig]]) {\n      r.shadow(b.x, b.y, 7, .35, undefined, b.groundZ || 0);\n      r.actor(b.x, b.y, b.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n    }\n  }\n};\n\nconst end = {\n  update() { if (game.input.pressed('start')) { reset(); game.go('play'); } },\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '1150,1228p' vendor/engine/dist/handoff/API-INDEX.md && sed -n '676,719p' vendor/engine/dist/handoff/API-INDEX.md && rg -n 'class Shell|class Menu|class Standard|class Audio|_pause|live\\\\b|tv:' vendor/engine/dist/handoff/my-3d2dge.js | head -45\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '1150,1228p' vendor/engine/dist/handoff/API-INDEX.md && sed -n '676,719p' vendor/engine/dist/handoff/API-INDEX.md && rg -n 'class Shell|class Menu|class Standard|class Audio|_pause|live\\\\b|tv:' vendor/engine/dist/handoff/my-3d2dge.js | head -45\"","aggregated_output":"- `talk.shown = 0`: letters typed so far on it\n- `talk.speed = 50`: letters typed per second\n- `talk.vars = null`: the values {$name} in the text reads (say's vars first)\n- `talk.voice = 'text'`: the sound effect each letter blips ('text'; null for silence), or a function (letter, index, dialog) called once for each letter as it types (a babble voice: Animalese; dialog.name is the speaker)\n- `talk.width = 0`: the box's width in pixels (320 at most by default, the screen's less 12 at most)\n- `new E.Menu(game, items, o = {}) → menu`: Menu with a cursor (title screens, pause menus, shops, battle commands). const menu = new E.Menu(game, ['START', 'OPTIONS', { label: 'CONTINUE', disabled: !save }], { onPick(i, item) {...}, onCancel() {...} }); update: menu.update(dt) draw: menu.draw(r) opts: { x: 'center' | px, y: 'center' | px, title, box: true, color, pick: '#ffd36a', columns: 1 }\n- `menu.draw(r)`: draw it to the overlay\n- `menu.rowAt(i)` †: entry i's box on the screen, [x, y, w, h] in screen pixels: where a click or tap picks it (a test's feed('down') and feed('up') there); null while it is scrolled out of view\n- `menu.selected`: the entry under the cursor\n- `menu.update()`: move the cursor (up, down; held keys repeat; the mouse over an entry) and pick (confirm, or a click or tap on an entry) or cancel; returns true when it picked or cancelled\n- `menu.active = true`: false stops it reading input\n- `menu.bg = '#141a3a'`, `menu.border = '#e8e4ff'`: the window's colors\n- `menu.box = true`: draw a window round it\n- `menu.color = '#ffffff'`: the entries' color\n- `menu.dim = '#6a6488'`: disabled entries' color\n- `menu.game`: its game\n- `menu.i = 0`: the one under the cursor\n- `menu.input = null` †: the one input it reads (default: every player's, so any player moves and picks; the mouse and taps are player 1's)\n- `menu.items`: the entries (strings, or { label, disabled })\n- `menu.onCancel = null`: called on cancel\n- `menu.onMove = null`: called (i, item) when the cursor moves\n- `menu.onPick = null`: called (i, item) on confirm\n- `menu.pick = '#ffd36a'`: the color of the one under the cursor\n- `menu.rows = 0` †: at most that many entries shown, the list scrolling under its cursor (0: all)\n- `menu.scale = 1` †: its text and rows that many times (2, 3: across a room on a TV)\n- `menu.sound = true`: false silences it\n- `menu.title = null`: a heading, or null\n- `menu.x = 'center'`, `menu.y = 'center'`: where it sits, 'center' or pixels\n- `E.ui`: pixel-drawn interface pieces for r.overlay\n- `E.ui.bar(g, x, y, w, h, frac, color = '#e0463c', o = {})`: a bar (a meter: health, magic, stamina, a boss's): ui.bar(g, x, y, w, h, 0..1, '#e0463c')\n- `E.ui.box(g, x, y, w, h, o = {})`: window frame: ui.box(g, x, y, w, h, { bg, border, shadow, gradient }) bg: one color (drawn as a soft top-to-bottom gradient, like Final Fantasy windows) or [top, bottom] colors. gradient: false for a flat fill.\n- `E.ui.counter(g, x, y, label, value, color = '#ffffff', o = {})`: label + value, e.g. ui.counter(g, 4, 4, 'RUPEES', 12)\n- `E.ui.hearts(g, x, y, hp, max, o = {})`: row of hearts: hp and max in hearts (halves allowed, e.g. 2.5 of 3)\n\n## 21d. Shell\n\n- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30 at 1,875)\n- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\n- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\n- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\n- `shell.back()` †: what cancel does: the screen's own back(), or close it (back to the screen under it; closing the pause screen resumes)\n- `shell.dispose()` †: take its elements away and let go of the game (game.dispose() does it)\n- `shell.hide()` †: close every screen (and resume, when the menu paused the game)\n- `shell.hud(st = {})` †: the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\n- `shell.hud({ objective })` †: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\n- `shell.hud({ status, place, tip })` †: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\n- `shell.hud({ bars, counts })` †: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label, value]]\n- `shell.hud({ prompt })` †: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\n- `shell.hud({ keys, buttons })` †: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right: pause and map where there is no Escape key)\n- `shell.hud({ minimap })` †: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y) (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\n- `shell.screen` †: the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays\n- `shell.settings` †: the player's settings: game.settings (the standard ones and the game's own, by key)\n- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (strings or functions), actions: [[label, fn] or { label, fn, act, primary, disabled }], back (fn for cancel), rows: ['glyphs', 'invertY', '#A heading'] (settings' rows, changed as on the settings screen) }. From another screen it stacks (back() returns); shown again, it updates (the new spec over the old). 'settings' takes its items\n- `shell.show('title')` †: { name, subtitle, meta: [...], footer }\n- `shell.show('help')` †: { keys: [[key, what]], sections: [[heading, text]] }\n- `shell.show('results')` †: { emblem, stats: [[value, label]], medals: [[label, earned]] }\n- `shell.show('map')` †: { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) }\n- `shell.toast(title, text = '', seconds = 4)` †: a message that slides in at the top for a few seconds\n- `shell.tutorial(title, text = '', seconds = 15)` †: a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away\n- `shell.root = null` †: game: the game it is over; o: its options; root: its DOM element (null in a headless game)\n\n## 22. Gpu lighting (webgpu)\n\n- `game.gpu.active(view)` †: true when it lights frames in this view (ready, enabled and a ground view)\n- `game.gpu.snapshot()` †: offscreen mode only: read the last frame back as a PNG data URL\n- `game.gpu.status()` †: 'loading' | 'on' | 'off' | 'unavailable'\n- `game.gpu.adapterInfo` †: the GPU's description from the browser (vendor, architecture), or null\n- `game.gpu.ambient` †: the unlit color, [r, g, b] 0..1\n- `game.gpu.bands = 6` †: how many light bands (fewer is more retro)\n- `game.gpu.enabled = true` †: false switches it off for now (and the canvas lighting with it, unless game.lights.enabled)\n- `game.gpu.failed = null` †: why it couldn't start, or null\n- `game.gpu.fallback = true` †: false keeps a frame it can't draw unlit (by default the canvas lighting stands in, game.lights.on)\n- `game.gpu.glow = .22` †: the strength of px.glow surfaces\n- `game.gpu.map = null` †: the TileMap it measures walls on\n- `game.gpu.offscreen = false` †: render into a texture instead of the page (automated tests; read it with snapshot())\n- `game.gpu.onStatus = null` †: called (gpu) when its status changes\n- `game.gpu.ready = false` †: true once the GPU is set up\n- `new E.Humanoid(o = {}) → rig`: new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style, color }; E.Humanoid.hat adds one); weapon: 'sword' | 'gun' | 'staff' (E.Humanoid.weapon adds one); hood: true (drawn in colors.hair); draw: { under(g, Q, rig), over(g, Q, rig) } the game's own drawing before and after the body (Q: the joints on screen, [x, y, depth]: outfits, accessories); seed: its own random stream (blinks, its clock)\n- `E.Humanoid.hat(id, draw)` †: a hat of the game's own: draw(h) with h.at(forward, right, up) a point round the head on screen, h.r its radius there, h.c its color (o.hat.color), h.dk a darker one, h.g, h.rig\n- `E.Humanoid.hats` †: the hats a Humanoid may wear, by id: the built-ins (cap, band, crown, helmet, pointed) and a game's own\n- `E.Humanoid.pose(id, fn)` †: a held pose of the game's own: fn(J, w, rig) moves the joints (the rig's frame: forward, right, up) toward the pose by w, 0..1, which eases in and out as state.pose names it or not (blended over the rig's solve)\n- `E.Humanoid.poses` †: the held poses of a game's own, by id (the built-in poses are the rig's own solve: state.pose names either)\n- `E.Humanoid.weapon(id, spec)` †: a weapon of the game's own (or a built-in replaced): { length: the tip's distance from the hand (a number, or rig => one; tip() and the swing's trail), rest: [forward, right, up] the way it points held at rest, blade: true (a swing smears along it), draw(w): its drawing in both styles (w.style, w.at(t), w.push(depth, fn), w.u: rig._weaponDraw) }\n- `E.Humanoid.weapons` †: the weapons a Humanoid may hold, by id: the built-ins (sword, gun, staff) and a game's own\n- `rig.debug(r)` †: skeleton overlay for debugging, draws straight into the buffer\n- `rig.draw(g, ox, oy, view)`: draw into g with (ox, oy) = projected position of the rig's root\n- `rig.drawPortrait(g, x, y, size = 40, o = {})` †: a close-up bust for dialog boxes and menus, drawn live from the rig (blinks, hair and hats included): rig.drawPortrait(g, x, y, 40, { zoom: 3, turn: .6, bg: '#1a2050', frame: true }) // inside r.overlay(g => ...) zoom: pixels per world unit (3 = face fills the frame), turn: 0 = facing you, .6 = three-quarter. The bust stays upright while the rig kneels or lies down (upright: false shows the real pose); cape: false hides the cape; tint: '#808080' greys it out (a KO'd party member).\n- `rig.drawSmear(r, colors = ['#ffffff', '#dff8ff', '#8fe0f2', '#4bb1d4'])` †: motion smear for the current swing, queued in front of the rig\n- `rig.hand(which = 'R')`: world position of a hand ('R' holds the weapon): spawn bullets, sparks or thrown things here\n- `rig.head()`: world position of the head (for speech bubbles, portraits, halos)\n- `rig.kick(v)`: a squash-and-stretch kick: + stretches (a jump), - squashes (a landing, a hit)\n- `rig.land(strength = 1)` †: a heavy landing: knees bend deep and spring back over a moment; strength 1 or more drops a hand to the ground (a three-point landing), .3-.6 is a soft one. Call it on the step the body lands\n- `rig.solvePose()`: set the joints J from the rig's state this step (update and setPose call it); a clip player may wrap it on one rig: const base = rig.solvePose; rig.solvePose = function () { base.call(this); ...move J... }\n- `rig.tip()`: world position of the weapon tip (sword tip, gun muzzle, staff orb)\n- `rig.update(dt, s = {})`: s: { x, y, z, vx, vy, facing, dash, hurt, attack, air, point } air: true while jumping or falling (legs tuck), point: true to hold the weapon hand forward (aiming a gun) attack: { spec, phase: 'wind' | 'active' | 'recover', u: 0..1 }. spec.kick = true swings the right foot instead of the hand also aim (radians up), crouch, sprint, climb, hang (hangZ: the top it hangs from, above the feet), flip: 0..1 (a roll), pose: 'cheer' | 'cast' | 'guard' | 'kneel' | 'crouch' | 'wave' | 'hips' | 'down' | 'die' | 'block' or one of E.Humanoid.pose's, tilt (radians: the whole body forward about the feet, a dive) and roll (sideways), stance: 'guard' | 'ready', down: 0..1, vz (with climb: the climbing speed), land: k (a heavy landing), expr: 'smile' | 'shout' | 'angry' | 'wince', run: 0..1 (run in place)\n- `rig.worldOffset(p)`: where a point in the rig's own frame ([forward, right, up]; a joint such as rig.J.head, or one offset from it) sits, in world units from the rig's feet: add rig.x, y, z for the world point, or project it to draw at a joint\n- `rig.C`: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with o.colors over them; change one and it shows at the next draw\n- `rig.J`: its joints this step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in the world)\n- `rig.atkZ = 10`: the height of the weapon hand during an attack\n- `rig.blink = 2`: seconds to the next blink\n- `rig.capeL = null`: the cape's left edge points (null until it has a cape and has moved)\n- `rig.capeR = []`: the cape's right edge points\n- `rig.dieT`: pose 'die': a stagger, the knees give, then the body topples\n- `rig.downW`: how far down it is, 0..1 (state down, pose 'down' or 'die'): it falls faster and faster and gets up steadily\n- `rig.expr` †: the face shown ('smile', 'shout', 'angry', 'wince'), or null\n- `rig.facing = 0`: the angle it faces, radians\n- `rig.hop`: how high an attack's hop lifts it now\n- `rig.hurtW = 0`: 0..1, how far into the hurt flinch\n- `rig.lastView` †: drawSmear projects the trail with the same view\n- `rig.lunge`: how far the body leans into an attack now, world units\n- `rig.o`: its options, with the build's proportions and the defaults filled in (size, build, weapon, outfit, ...; legUpper, torso, headR and the other lengths are at size 1)\n- `rig.phase = 0`: the walk cycle's phase, radians\n- `rig.poseW`: held poses: 'cheer' (item get, victory), 'cast' (both hands forward), 'guard' (fists up), 'kneel', 'crouch', 'wave', 'hips' (hands on hips), and down: 0..1 (knocked flat). stance: 'guard' (fists up while moving) | 'ready' (weapon held forward)\n- `rig.reach = 7`: how far it reaches forward\n- `rig.spin = 0`: the body's extra turn during a spinning move, radians\n- `rig.sq = 0`: squash and stretch, -0.45..0.45 (kick adds to it)\n- `rig.sqV = 0`: its speed\n- `rig.t`: seconds of its own clock (idle breathing, blinks)\n- `rig.trail = []` †: recent points of the blade (or fist) tip, for the swing's smear\n- `rig.x = 0`, `rig.y = 0`, `rig.z = 0`: where its feet are (from the last update)\n- `E.MOVES: slash, backslash, overhead, rising, thrust, spin, plunge, twohand, jab, cross, hook, uppercut, haymaker, elbow, ... (24)`: a library of named attacks with timing and body motion (anticipation, lunge, step, twist, hop). new E.Attack('overhead'), new E.Attack('thrust', { reach: 10 }), new E.Combo(['jab', 'cross', 'hook', 'uppercut']) rig.update(dt, { ..., attack: E.move('roundhouse', .5) }) // any move at any moment, for previews and cutscenes The same move works on every build and in every view: heights are relative to the shoulders (rel: true), reaches scale with arm length, and horizontal swings turn into screen-plane swings in side views. A move's spec fields:\n142:const CSS_NAMES = { black: '000', white: 'fff', red: 'f00', lime: '0f0', green: '008000', blue: '00f', yellow: 'ff0', cyan: '0ff', aqua: '0ff', magenta: 'f0f', fuchsia: 'f0f', gray: '808080', grey: '8 [... omitted end of long line]\n1573:  /** game.particles. game: its game; list: the live particles; max: at most this many at once (add() skips the rest);\n2017:   * - ghost: ghost.owner (any {x, y, z}, usually the actor itself) keeps its afterimages sorted behind the live body\n2119:   *  so a trail never covers the live body with a blob of tinted copies */\n2311:   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\n2328:   * - live: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it,\n2396:     *  errors caught in update and draw, each { where, scene, message, stack }, once per kind; live: true (o.live): a pause\n2399:    this.paused = false; this.pauseOverlay = true; this._timers = []; this.errors = []; this._errKeys = new Set(); this.live = !!o.live; this._goOn = false;\n2543:   * o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when\n2791:    const live = !this.headless && this.o.loop !== false && hooks.boot !== false && typeof document !== 'undefined';\n2795:    if (live) { BOOT._open(this, o); BOOT._checks(this); }\n2803:        if (live) BOOT._step(i, n, label);\n2805:        const ok = () => { if (live) BOOT._line('  ' + (i + '. ').padEnd(4), label + ' · ' + Math.round(now() - s0) + ' ms'); };\n2806:        if (r && typeof r.then === 'function') { r.then(() => { ok(); live ? requestAnimationFrame(next) : next(); }, e => fail(label, e)); return; }\n2807:        ok(); if (live) { requestAnimationFrame(next); return; }   // one step a frame: the screen shows each\n2809:      if (live && o.min && now() - t0 < o.min * 1000) { requestAnimationFrame(next); return; }\n2810:      if (live) BOOT._step(n + 1, n + 1, 'Warming up');\n2905:    this.scene = s; this.sceneName = name; this.paused = false; if (old) prune(this._timers, t => !t.keep); this.hitstop = 0;   // (timers made before the first scene live into it)\n2950:    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n3407: * delay, repeat (more plays; -1 forever), yoyo (every other play runs back), onDone(target), keep (outlive the scene) }).\n4371:   * a close-up bust for dialog boxes and menus, drawn live from the rig (blinks, hair and hats included):\n7577:  /** new E.Bullets(game, { plane: 'ground' | 'side', max: 800, sparks: true }). game: its game; list: the live\n7608:        if (!t || t.dead || t.alive === false || (b.pierce && b.hitSet && b.hitSet.has(t))) continue;\n7663:  /** clear, then add every live thing in list (skips o.dead); do it once a step */\n7848:    const live = o.loop || o.pan !== undefined, out = live ? c.createGain() : null, pan = out && c.createStereoPanner ? c.createStereoPanner() : null, srcs = [];   // (a looped or panned one: its own  [... omitted end of long line]\n7989:    if (this._stings.length) this._stings = this._stings.filter(S => { const live = this._clockNow(S) < S.end + .5; if (!live) try { S.bus.disconnect(); } catch (e) { /* gone */ } return live; });\n9140:   * opts: { name, onDone, choices, onChoice, portrait: rig (a live close-up of that Humanoid beside the text) or a function (g, x, y, size),\n9269:class Menu {\n9415:class Shell {\n9420:   *   interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by\n9439:    if (!this._sys && this._pauseSpec()) game.pauseOverlay = false;\n9467:  _pauseSpec() { const sc = this._o.screens; return sc && 'pause' in sc ? sc.pause || null : this._std ? {} : null; }\n9647:    const I = this._ctlI(), names = I.names || {}, st = this._el('div', 'esh-status', this._status || ''); st.setAttribute('role', 'status'); st.setAttribute('aria-live', 'polite');\n9731:    if (name === 'pause') this._pauseActs(acts);\n9751:  _pauseActs(acts) {\n9807:    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n10637:Rules: tables live in E.store ('arcade:' + id + ':' + mode; kept for the visit where storage is blocked); a demo is the game's own bot (or a recorded input log)\n13696:- const party = rpg.party([hero], { gold, inv }): members, alive, gold, inv (rpg.inventory() by default); use(id, m)\n13862:  get alive() { return this.members.filter(m => !m.dead); }\n13885:    const items = [].concat(r.items || []).filter(it => this.inv.add(it, 1)), alive = this.alive, share = alive.length ? Math.ceil((r.exp || 0) / alive.length) : 0;\n13887:    return { exp: r.exp || 0, gold: r.gold || 0, items, levels: alive.map(m => [m, m.gain(share)]).filter(x => x[1].length) };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '9415,9485p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '9685,9810p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '2930,2965p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '350,404p' vendor/engine/dist/handoff/kits/artillery.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '9415,9485p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '9685,9810p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '2930,2965p' vendor/engine/dist/handoff/my-3d2dge.js && sed -n '350,404p' vendor/engine/dist/handoff/kits/artillery.js\"","aggregated_output":"class Shell {\n  /**\n   * new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings',\n   * meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n   * - theme: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole\n   *   interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by\n   *   the window's width (14 px text at 875 px, up to 30 at 1,875)\n   * - screens: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n   * - settings: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max,\n   *   step, options, value } (kept in game.settings, beside the standard ones)\n   * - store, meters: store: where an older version saved them; meters: meters per world unit for distances\n   * - standard: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the\n   *   settings' groups)\n   */\n  constructor(game, o = {}) {\n    if (game.shell && game.shell._sys && !o.system) game.shell.dispose();   // the game's own shell takes over from the engine's\n    /** game: the game it is over; o: its options; root: its DOM element (null in a headless game) */\n    this._game = game; this._o = o; this.root = null; this._stack = []; this._keep = new Set(); this._held = new Set(); this._last = {};\n    this._sys = !!o.system; this._std = o.standard !== false && game.o.menu !== false;\n    const old = store.get(o.store || 'shell-settings', null) || {}, S = game.settings;   // (settings saved by an older version are kept)\n    for (const it of this._items()) if (!S.spec(it.key)) { if (S._raw[it.key] === undefined && old[it.key] !== undefined) S._raw[it.key] = old[it.key]; S.define(Object.assign({ group: 'Game' }, it)); }\n    for (const k of ['sound', 'volume', 'motion']) if (S._raw[k] === undefined && old[k] !== undefined && this._items().some(it => it.key === k)) S.set(k, old[k]);\n    if (o.settings && o.settings.onChange) S.onChange = k => o.settings.onChange(S, k);\n    game.shell = this;\n    if (!this._sys && this._pauseSpec()) game.pauseOverlay = false;\n    if (game.headless || typeof document === 'undefined') return;\n    // rebinding: the next key or mouse button goes to the action being bound (before the game's own listeners see it)\n    const signal = game._abort ? game._abort.signal : undefined;\n    addEventListener('keydown', e => { const c = this._cap; if (!c) return; e.preventDefault(); e.stopImmediatePropagation(); if (e.code === 'Escape') this._capEnd('Not changed.'); else if (c.device === 'keys' && !e.repeat) this._capBind(e.code); }, { capture: true, signal });\n    addEventListener('pointerdown', e => { const c = this._cap; if (!c || c.device !== 'keys' || e.pointerType !== 'mouse') return; e.preventDefault(); e.stopImmediatePropagation(); this._capBind('Mouse' + e.button); }, { capture: true, signal });\n    addEventListener('wheel', e => { const c = this._cap; if (!c || c.device !== 'keys' || !e.deltaY) return; e.preventDefault(); e.stopImmediatePropagation(); this._capBind(e.deltaY < 0 ? 'WheelUp' : 'WheelDown'); }, { capture: true, signal, passive: false });\n    if (!document.getElementById('esh-css')) { const st = document.createElement('style'); st.id = 'esh-css'; st.textContent = SHELL_CSS; document.head.appendChild(st); }\n    const r = this.root = this._el('div', 'esh' + (game._corner ? ' esh-c