{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,66p' vendor/hub/lib/hub/harness.html && tail -20 vendor/hub/lib/hub/harness.html && sed -n '398,411p' vendor/hub/lib/hub/harness.html && rg -n 'button|timeup|start|newRound' vendor/hub/lib/hub/harness.html | tail -20\"","aggregated_output":"  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n19:  button { cursor: pointer; }\n20:  button:hover { border-color: var(--dim); }\n50:  <button id=\"restart\" type=\"button\">New round</button>\n51:  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n52:  <button id=\"timeup\" type=\"button\">Time up</button>\n54:  <button id=\"remove\" type=\"button\">Remove player</button>\n55:  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n158:async function newRound() {\n231:        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` [... omitted end of long line]\n268:  log('splash over: the round starts once every game has loaded');\n278:    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\n360:$('restart').onclick = () => newRound();\n362:$('timeup').onclick = () => current?.coordinator.timeUp();\n414:    const state = await newRound();\n452:    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n453:    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n454:    if (!started || state.record) return;\n468:    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n469:    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n545:else if ($('game').value) newRound();\n","exit_code":0,"status":"completed"}}
