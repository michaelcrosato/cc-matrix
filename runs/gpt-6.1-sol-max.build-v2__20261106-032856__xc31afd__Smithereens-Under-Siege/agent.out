g, a zoom toward its point; the focus kept to bounds\n  _freeCam(dt) {\n    const c = this.cam, F = c.free === true ? {} : c.free, I = this.input, S = this.screen, z = this._zoomTo || this.zoom;\n    let dx = 0, dy = 0, moved = false;\n    if (F.keys !== false && !(this.shell && this.shell.screen) && !I.stickOn) { const m = I.move(), sp = (F.speed || 300) * dt; dx += m[0] * sp; dy += m[1] * sp; }   // (a finger pans by its drag, not as a stick)\n    const p = I.pointer(), e = F.edge === undefined ? 10 : F.edge;\n    if (e > 0 && p && I.lastDevice !== 'touch' && I.mouse.active && !I._fedAt) { const sp = (F.speed || 300) * dt; if (p[0] < e) dx -= sp; else if (p[0] > S.W - e) dx += sp; if (p[1] < e) dy -= sp; else if (p[1] > S.H - e) dy += sp; }\n    const pan = F.drag !== false && I.pan(); if (pan) { dx -= pan[0]; dy -= pan[1]; moved = true; }\n    if (dx || dy) { const [gx, gy] = this._screenToGround(dx, dy); c.tx += gx; c.ty += gy; moved = true; }\n    // a zoom keeps the world point under its pointer (or pinch) where it was: the focus moves toward it by (1 - 1/k) of the way\n    const was = c._freeZ || z; c._freeZ = z;\n    if (z !== was && F.zoomAt !== false) { const q = I.zoomPoint(); if (q) { const k = z / was, [gx, gy] = this._screenToGround((q[0] - S.W / 2) * (1 - 1 / k) * k, (q[1] - S.H / 2) * (1 - 1 / k) * k); c.tx += gx; c.ty += gy; moved = true; } }\n    const b = F.bounds; if (b) { c.tx = clamp(c.tx, b[0], b[2]); c.ty = clamp(c.ty, b[1], b[3]); }\n    if (moved) c.snap = true;\n  }\n  _frame() {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    const c = this.cam, s = this._shakeAmt;\n    const shx = s > .05 ? (Math.sin(this.real * 83) + Math.sin(this.real * 57.3)) * .5 * s : 0, shy = s > .05 ? (Math.sin(this.real * 71) + Math.sin(this.real * 49.7)) * .5 * s : 0;\n    const sc = this.scene;\n    if (this._split && HOOKS.frame) HOOKS.frame(this, shx, shy);   // a split screen: the scene drawn in each viewport (section 10j)\n    else { this.lights._clear(); this.r._begin(c.x + shx, c.y + shy); if (sc && sc.draw) sc.draw(this.r); }\n    if (this.shownNote && this.real < this.shownNote.end) { const n = this.shownNote; this.r.overlay(g => E.font.text(g, n.text, this.r.W / 2, 3, '#ffffff', { align: 'center', shadow: '#000', outline: false, font: 'tiny' })); }\n    if (this.settings.showFps) { const st = this.stats, t = this.fps + ' FPS  ' + this.hz + ' HZ' + (this.drawEvery > 1 ? ' (EVERY ' + this.drawEvery + ')' : '') + '  ' + (st.updateMs + st.renderMs).toFixed(1) + ' MS';   // Settings, Display\n      this.r.overlay(g => { const w = E.font.width(t, { font: 'tiny' }) + 6; g.fillStyle = '#000000b0'; g.fillRect(Math.round(this.r.W / 2 - w / 2), 0, w, 9); g._c = null; E.font.text(g, t, this.r.W / 2, 2, '#9cff9c', { align: 'center', outline: false, font: 'tiny' }); }); }\n    this._cornerSync();\n    if (this.paused && this.pauseOverlay && !(this.shell && this.shell._sys && this.shell.screen)) this.r.overlay(g => {\n      const r = this.r; g.save(); if (E.style.trans === 'dither') g.fillStyle = g.createPattern(r._checker, 'repeat'); else { g.fillStyle = '#05030c'; g.globalAlpha = .55; } g.fillRect(0, 0, r.bw, r.bh); g.restore(); g._c = null;\n      E.font.text(g, this._players && this._players.length > 1 && this.pausedBy ? 'P' + this.pausedBy + ' PAUSED' : 'PAUSED', r.W / 2, r.H / 2 - 8, '#ffffff', { align: 'center', scale: 2 });   // (several players: who)\n      E.font.text(g, 'PRESS ESC OR START', r.W / 2, r.H / 2 + 8, '#c9c0e0', { align: 'center' });\n    });\n    const fx = this._flash;\n    if (fx) { const a = (1 - fx.t / fx.dur) * (fx.k === undefined ? 1 : fx.k); if (a <= 0) this._flash = null; else this.r.overlay(g => { const r = this.r; g.save(); if (E.style.trans === 'dither') { const pat = r._fadePattern(a * .85), c = mkCanvas(4, 4), cg = c.getContext('2d'); cg.drawImage(pat, 0, 0); cg.globalCompositeOperation = 'source-in'; cg.fillStyle = fx.color; cg.fillRect(0, 0, 4, 4); g.fillStyle = g.createPattern(c, 'repeat'); } else { g.fillStyle = fx.color; g.globalAlpha = qa(a * .75); g.globalCompositeOperation = 'lighter'; } g.fillRect(0, 0, r.bw, r.bh); g.restore(); g._c = null; }); }\n    const fl = this._fadeLevel(), F = this._fade, T = fl > 0 && F.kind && !this.reduceMotion && !this.r.gpu && FADES[F.kind];\n    if (T) this.r.overlay(g => { T(g, fl, this.r, F); g._c = null; });\n    else if (fl > 0) this.r.overlay(g => { const r = this.r, c = F.kind === 'white' ? '#ffffff' : '#000000'; g.save(); if (E.style.trans === 'dither') g.fillStyle = g.createPattern(r._fadePattern(fl, c), 'repeat'); else { g.fillStyle = c; g.globalAlpha = Math.round(fl * 16) / 16; } g.fillRect(0, 0, r.bw, r.bh); g.restore(); g._c = null; });\n    this.r._finish();\n    if (!this.headless && !BOOT.played && !this._booting && (this._drawn = (this._drawn || 0) + 1) >= 2) BOOT._finish();   // play has begun (two frames drawn under the boot screen: the caches are warm; a headless game's has none)\n  }\n  /** is a world point near the visible area? margins in pixels (characters extend upward from their feet) */\n  visible(x, y, z = 0, mx = 60, up = 30, down = 90) { const [sx, sy] = this.w(x, y, z); return sx > -mx && sx < this.bw + mx && sy > -up && sy < this.bh + down; }\n  /**\n   * Queue a character. drawFn(g, ox, oy) must draw with (ox, oy) as the projected\n   * position of world point (x, y, z). The engine adds outline, rim light, hit flash,\n   * afterimages and x-ray silhouettes.\n   * opts: {outline=true, rim=true, flash=false, alpha=1, xray=false, ghost:{color, life, alpha, owner}, hides, bias, every, key,\n   *   emissive (it stays bright under lighting, as r.queue's)}\n   * - xray: true shows the actor's hidden part (a translucent tint with a 1-px outline, r.xrayColor and r.xrayOutline; a\n   *     checker in E.style.trans 'dither') wherever a wall, a prop or shape at least chest high, or anything queued with\n   *     hides is drawn in front of it (not one rising less than E.HEIGHTS.level, 8, above its feet: the roof it stands on,\n   *     a cut-down wall); xray: { color,\n   *     outline (false: none), actors } picks the colors, and with actors: true other bodies drawn in front hide it too\n   *     (a hero lost in a crowd keeps his shape)\n   * - hides: true: this actor counts as an x-ray occluder even when no x-ray actor asked for actors\n   * - ghost: ghost.owner (any {x, y, z}, usually the actor itself) keeps its afterimages sorted behind the live body\n   * - every, key: every: n, key (any object, the character's own): its finished image is drawn again for n - 1 frames\n   *     before drawFn runs again, at the place it is now (a background character animating at a lower rate, as classic\n   *     games' townsfolk do: a phone's frame keeps the time for the ones that matter); not while it flashes, with a\n   *     ghost, x-ray or GPU lighting\n   * - wrap: [w, h], as r.sprite's: a world that wraps round shows the actor across each edge it crosses\n   */\n  actor(x, y, z, drawFn, o = {}) {\n    if (o.wrap) { const [ww, wh] = Array.isArray(o.wrap) ? o.wrap : [o.wrap, 0], q = Object.assign({}, o, { wrap: null }); for (const i of [-1, 0, 1]) for (const j of wh ? [-1, 0, 1] : [0]) this.actor(x + i * ww, y + j * wh, z, drawFn, q); return; }\n    const st = this.game.stats;\n    if (!this.visible(x, y, z, o.margin || 60)) { st.culled++; return; }\n  draw(r) {\n    const k = this.chunk, v = r.game.view, s = v.scale, W = r.game.W, H = r.game.H; this.drawn = 0;\n    for (let cy = 0; cy * k < this.h; cy++) for (let cx = 0; cx * k < this.w; cx++) {\n      const wx = this.x + cx * k, wy = this.y + this.h - cy * k, [sx, sy] = r.w(wx, 0, wy);\n      if (sx > W || sy > H || sx + k * s < 0 || sy + k * s * v.zBoost < 0) continue;\n      const key = cx + ',' + cy; let cv = this._cv.get(key);\n      if (!cv || this._dirty.has(key)) { cv = this._paint(cx, cy, cv); this._cv.set(key, cv); this._dirty.delete(key); this.drawn++; }\n      r.decal(g => { const was = g.imageSmoothingEnabled; g.imageSmoothingEnabled = false; g.drawImage(cv, Math.round(sx), Math.round(sy), Math.round(k * s), Math.round(k * s * v.zBoost)); g.imageSmoothingEnabled = was; });\n    }\n  }\n  // one chunk's picture: each cell its material's color, varied a little; the lit top (air above), a dark rim elsewhere\n  _paint(cx, cy, cv) {\n    const k = this.chunk; cv = cv || E.mkCanvas(k, k); const g = E.ctx2d(cv), img = g.createImageData(k, k), D = img.data, W = this.w, C = this.cells;\n","exit_code":0,"status":"completed"}}
