{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'cat vendor/engine/dist/handoff/kits/artillery.js'","aggregated_output":"// The ARTILLERY kit's game (two teams of three on an island every blast carves: turns, aim and power, wind, a rocket, a bouncing grenade, a cluster bomb, falls and the sea, a CPU that tries its shots in simulation), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/34-artillery.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. artillery.html plays it; node kits/test.mjs artillery runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 20  ARTILLERY  (Worms, Scorched Earth). @modules physics terrain grid\n * BLAST ISLAND: two teams of three grubs on an island of earth, rock and sand that every blast carves. The teams take\n * turns (E.Turns, the grid module's), each sending its next grub; in its thirty seconds a grub walks, jumps, aims and\n * fires. Three weapons: a ROCKET the wind blows, a GRENADE that bounces (a physics body on the terrain's collider) and\n * blows on its fuse, a CLUSTER bomb that bursts into five (two a team). A blast throws grubs; a long fall hurts; the sea\n * drowns; from turn 16 the sea rises (sudden death). One player against the CPU, two players on one screen in turn, or\n * two CPUs. The CPU tries its shots in simulation (each weapon at every angle and power, with the wind and the fuse as\n * they are), takes the one that hurts its foes most and its own least, and fires it with a hand a little unsteady.\n * Keys: left and right (A, D) walk, up and down (W, S) aim, hold Space to charge and let go to fire, Enter jumps, Q or E\n * (or 1, 2, 3) picks the weapon. MOUSE: drag back from anywhere and let go to fire (the pull is the power); a click\n * walks there. TOUCH: the same: a drag back fires, a tap walks; the JUMP and WEAPON buttons. HOW IT WORKS: E.Terrain is\n * the island (carve, ground, walk, ray); E.Physics bounces the grenades on land.collider(); E.Turns alternates the\n * teams. bot() lets two CPUs play a match to its end, twice (tools/kits-test.mjs). Deep links: #artillery (the choice\n * of players), #artillery/cpu (two CPUs at once).\n * ===================================================================================== */\nconst ARTILLERY = (() => {\n  const WW = 800, WH = 320, SKY = 560, DT = 1 / 120, px = E.px, clamp = (v, a, b) => v < a ? a : v > b ? b : v;\n  E.VIEWS.artillery = E.VIEWS.artillery || new E.View('artillery', 'Island', 0, 0, 1, 1);   // a side view of whole pixels: the terrain stays crisp\n  const SOIL = { color: '#7a4a2a', top: '#52a83a', edge: '#3a2210', depth: 3 }, ROCK = { color: '#6a6878', top: '#9a98a8', edge: '#34323e', depth: 2 }, SAND = { color: '#c8a868', top: '#e8d098', edge: '#8a6a3a', depth: 2 };\n  const TEAMS = [\n    { name: 'RED GRUBS', short: 'RED', color: '#ff5a4a', dark: '#8a1a1a', grubs: ['SPUD', 'NIBBS', 'BOFF'] },\n    { name: 'BLUE GRUBS', short: 'BLUE', color: '#4ab4ff', dark: '#1a4a8a', grubs: ['WIGGLE', 'DOT', 'MUNCH'] }];\n  // speed: at full power, pixels a second; r and dmg: the blast's reach and its damage at the middle\n  const WEAPONS = [\n    { id: 'rocket', name: 'ROCKET', speed: 520, wind: true, r: 28, dmg: 45 },\n    { id: 'grenade', name: 'GRENADE', speed: 400, fuse: 3, r: 30, dmg: 45 },\n    { id: 'cluster', name: 'CLUSTER', speed: 440, r: 16, dmg: 20, ammo: 2, bits: 5 }];\n  const BIT = { id: 'bit', r: 14, dmg: 16 }, G_SHOT = 300, G_GRUB = 420, HP = 80, TURN_T = 30, SUDDEN = 16, PULL = 70;\n  const PHYS = { gravity: [0, -G_SHOT], substeps: 2, iterations: 4, sleep: false }, GREN = { bounce: .45, friction: .5, damping: .1 }, FUSE_N = Math.round(3 / DT);\n  const SONG = { bpm: 112, steps: 4, tracks: [\n    { wave: 'square', vol: .08, notes: 'G4 . B4 . D5 - B4 . C5 . A4 . F#4 . D4 . | G4 . B4 . D5 . G5 - F#5 . E5 . D5 . C5 . | B4 . G4 . A4 . F#4 . G4 - - . . . D4 .' },\n    { wave: 'triangle', vol: .28, notes: 'G2 . D3 . G2 . D3 . D2 . A2 . D2 . A2 . | G2 . D3 . G2 . D3 . C2 . G2 . D2 . A2 . | G2 . D3 . D2 . A2 . G2 . . . G2 . . .' },\n    { wave: 'drums', vol: .09, notes: 'k . h . s . h . k k h . s . h h' }] };\n  const KEYS = Object.assign({}, E.Input.DEFAULT, { walkL: ['ArrowLeft', 'KeyA', 'Pad14'], walkR: ['ArrowRight', 'KeyD', 'Pad15'], aimUp: ['ArrowUp', 'KeyW', 'Pad12'], aimDown: ['ArrowDown', 'KeyS', 'Pad13'],\n    fire: ['Space', 'Pad0', 'Pad7'], jump: ['Enter', 'NumpadEnter', 'KeyJ', 'Pad2'], weapon: ['KeyQ', 'KeyE', 'Pad3', 'Pad5'], w1: ['Digit1'], w2: ['Digit2'], w3: ['Digit3'] });\n\n  /* ---- 1. THE ISLAND: hills of earth over rock, beaches of sand, a few caves; the grubs spread along it, the teams mixed ---- */\n  let land, back, profile, grubs = [], teams, turns, water = 34;\n  function island(seed) {\n    const rnd = E.rng(seed), p = [0, 1, 2, 3].map(() => rnd() * Math.PI * 2), mid = 118 + rnd() * 40;\n    const top = x => { const e = clamp(Math.min(x - 24, WW - 24 - x) / 130, 0, 1), s = e * e * (3 - 2 * e); return 6 + (mid + 44 * Math.sin(x / 110 + p[0]) + 24 * Math.sin(x / 47 + p[1]) + 8 * Math.sin(x / 17 + p[2])) * s; };\n    const H = []; for (let x = 0; x < WW; x++) H[x] = top(x + .5);\n    land = new E.Terrain({ w: WW, h: WH, materials: [SOIL, ROCK, SAND], chunk: 64 });\n    back = E.mkCanvas(WW, WH); const bg = E.ctx2d(back), img = bg.createImageData(WW, WH), D = img.data;   // (the earth behind: what a cave or a deep crater shows)\n    for (let x = 0; x < WW; x++) for (let y = 0; y < H[x] - 7; y++) { const o = ((WH - 1 - y) * WW + x) * 4, n = (E.hash2(x >> 1, y >> 1) - .5) * 10, rock = y < H[x] - 30; D[o] = (rock ? 40 : 52) + n; D[o + 1] = (rock ? 36 : 32) + n; D[o + 2] = (rock ? 44 : 26) + n; D[o + 3] = 255; }\n    bg.putImageData(img, 0, 0); profile = null;\n    land.fill((x, y) => { const h = H[Math.floor(x)]; return y >= h ? 0 : h < water + 18 ? 3 : y < h - 28 - 12 * Math.sin(x / 31 + p[3]) ? 2 : 1; });\n    for (let i = 0; i < 4; i++) { const x = 150 + rnd() * (WW - 300), h = H[Math.floor(x)]; if (h > water + 70) land.carve(x, water + 26 + rnd() * (h - water - 64), 11 + rnd() * 9); }   // (caves inside the hills)\n    // six places along the land, the teams in turn, each nudged a little\n    grubs = [];\n    for (let i = 0; i < 6; i++) {\n      let x = 100 + (i + .5) * (WW - 200) / 6 + (rnd() - .5) * 40; for (let k = 0; k < 40 && !((land.ground(x, WH) || 0) > water + 10); k++) x += x < WW / 2 ? 6 : -6;\n      grubs.push(grub(i % 2, TEAMS[i % 2].grubs[i >> 1], x));\n    }\n  }\n  const grub = (team, name, x) => ({ team, name, x, y: land.ground(x, WH) || water + 20, vx: 0, vy: 0, ground: true, hp: HP, shown: HP, face: x < WW / 2 ? 1 : -1, aim: .5, dead: false, drowned: false, sunk: 0, fly: false, jump: false, hurt: 0, walkT: 0, goto: null, still: 0 });\n\n  /* ---- 2. THE RULES: a turn each, the shots and their blasts, damage, falls and the sea, the end ---- */\n  let look = { x: 0, y: 0, t: 0 }, mode = 'menu', modeT = 0, play = 'cpu', cur = null, phase = 'aim', phT = 0, turnT = 0, turnNo = 0, wind = 0, shots = [], power = 0, charging = false, cpu = null, stats, banner = null, winner = -1, pull = null, menuI = 0, matchSeed = 1;\n  function begin(how, seed) {\n    play = how; matchSeed = seed || 1 + Math.floor(Math.random() * 1e6); water = 34; island(matchSeed); shots = []; winner = -1; turnNo = 0; mode = 'play'; modeT = 0;\n    teams = TEAMS.map((T, i) => ({ i, speed: 100, next: 0, human: how === 'two' || (how === 'cpu' && i === 0), ammo: WEAPONS.map(w => w.ammo === undefined ? Infinity : w.ammo), weapon: 0 }));\n    turns = new E.Turns(teams, { mode: 'speed' });   // (two actors of one speed: they alternate)\n    stats = { shots: 0, used: {}, kills: 0, drowned: 0, falls: 0, carved: 0, damage: 0 };\n    game.input.consumeAll(); A.music(how === 'demo' ? null : SONG); startTurn();\n  }\n  // the next team's next grub still standing\n  function nextGrub() {\n    for (let k = 0; k < 2; k++) { const t = turns.next(), mine = grubs.filter(g => g.team === t.i); for (let j = 0; j < mine.length; j++) { const g = mine[(t.next + j) % mine.length]; if (!g.dead) { t.next = (mine.indexOf(g) + 1) % mine.length; return g; } } }\n    return null;\n  }\n  function startTurn() {\n    turnNo++; cur = nextGrub(); look.t = 0; phase = 'aim'; phT = 0; turnT = TURN_T; power = 0; charging = false; pull = null;\n    wind = Math.round((Math.random() * 2 - 1) * 10) / 10;\n    if (turnNo > SUDDEN) { water += 8; banner = { s: 'THE SEA RISES', sub: 'SUDDEN DEATH', t: 1.6, team: -1 }; }\n    else banner = { s: cur.name, sub: TEAMS[cur.team].name + (play === 'two' ? '  PLAYER ' + (cur.team + 1) : teams[cur.team].human ? '  YOU' : '  CPU'), t: 1.4, team: cur.team };\n    cpu = teams[cur.team].human ? null : { phase: 'think', t: 0, i: 0, cands: null, best: null };\n    A.sfx('select');\n  }\n  const weapon = () => WEAPONS[teams[cur.team].weapon];\n  function pickWeapon(i) { const t = teams[cur.team]; for (let k = 0; k < 3; k++, i = (i + 1) % 3) if (t.ammo[i] > 0) { if (t.weapon !== i) A.sfx('blip'); t.weapon = i; return; } }\n  // the shot's start: from the grub's middle, a little out along the aim (ang: radians, 0 right, up positive)\n  const muzzle = (g, ang, pw, W) => { const sp = Math.max(.15, pw) * W.speed; return [g.x + Math.cos(ang) * 8, g.y + 6 + Math.sin(ang) * 8, Math.cos(ang) * sp, Math.sin(ang) * sp]; };\n  function fire(g, ang, pw) {\n    const t = teams[g.team], W = weapon(), [x, y, vx, vy] = muzzle(g, ang, pw, W);\n    if (W.id === 'grenade') { const w = new E.Physics(PHYS); w.add(land.collider()); const b = w.circle(x, y, 2.5, GREN); b.vx = vx; b.vy = vy; shots.push({ w: W, body: b, world: w, n: 0, x, y }); }\n    else shots.push({ w: W, x, y, vx, vy, t: 0, owner: g });\n    t.ammo[t.weapon]--; if (t.ammo[t.weapon] <= 0) pickWeapon(0);\n    stats.shots++; stats.used[W.id] = (stats.used[W.id] || 0) + 1; phase = 'fly'; phT = 0; charging = false; power = 0; pull = null; cur.goto = null;\n    A.sfx(W.id === 'rocket' ? 'shoot' : 'swing'); P.smoke(x, 0, y, 3, { size: 3 });\n  }\n  // one step of a rocket's, a cluster's or a bomblet's flight: gravity, the wind (a rocket's), the ground and the grubs in\n  // its way; 'hit' (at its x, y), 'sea', 'gone', or null (still flying). The CPU's simulation runs this same step\n  function fly(s, dt, owner) {\n    s.vy -= G_SHOT * dt; if (s.w.wind) s.vx += wind * 90 * dt; s.t += dt;\n    const nx = s.x + s.vx * dt, ny = s.y + s.vy * dt, hit = land.ray(s.x, s.y, nx, ny);\n    if (hit) { s.x = hit[0]; s.y = hit[1]; return 'hit'; }\n    s.x = nx; s.y = ny;\n    for (const g of grubs) if (!g.dead && (g !== owner || s.t > .25) && Math.hypot(g.x - s.x, g.y + 5 - s.y) < 6) return 'hit';\n    return s.y < water ? 'sea' : s.x < -60 || s.x > WW + 60 || s.t > 12 ? 'gone' : null;\n  }\n  // a cluster's five, thrown up in a fan from where it burst\n  const bits = (x, y) => [0, 1, 2, 3, 4].map(k => ({ w: BIT, x, y: y + 3, vx: (k - 2) * 55, vy: 160 + (2 - Math.abs(k - 2)) * 25, t: 0, owner: null }));\n  function stepShots(dt) {\n    if (!dt) return;   // (a hit-stop: nothing moves, and a fuse waits)\n    for (const s of shots.slice()) {\n      if (s.body) {   // a grenade: its own physics world, the island its collider\n        s.world.step(dt); s.x = s.body.x; s.y = s.body.y;\n        if (s.y < water) { shots.splice(shots.indexOf(s), 1); splash(s.x); }\n        else if (++s.n >= FUSE_N) { shots.splice(shots.indexOf(s), 1); blast(s.x, s.y, s.w.r, s.w.dmg); }\n        continue;\n      }\n      const e = fly(s, dt, s.owner);\n      if (!e) { if (s.w.wind && Math.floor(s.t * 30) !== Math.floor((s.t - dt) * 30)) P.smoke(s.x, 0, s.y, 1, { size: 2 }); continue; }\n      shots.splice(shots.indexOf(s), 1);\n      if (e === 'hit') { blast(s.x, s.y, s.w.r, s.w.dmg); if (s.w.bits) shots.push(...bits(s.x, s.y)); }\n      else if (e === 'sea') splash(s.x);\n    }\n  }\n  function splash(x) { for (let i = 0; i < 10; i++) P.add({ kind: 'bit', x: x + (i - 5) * .8, y: 0, z: water + 1, vx: (i - 5) * 14, vz: 80 + (i % 3) * 30, g: 300, max: .7, color: '#cfe8ff', size: 1 }); A.sfx('land', { vol: .4 }); }\n  // a blast: a crater in the island, damage by distance, grubs thrown away from it\n  function blast(x, y, r, dmg) {\n    const took = land.carve(x, y, r, { particles: P, debris: 14 }); for (const k in took) stats.carved += took[k]; profile = null;\n    for (const g of grubs) {\n      if (g.dead) continue; const dx = g.x - x, dy = g.y + 5 - y, d = Math.hypot(dx, dy); if (d >= r + 6) continue;\n      const k = 1 - d / (r + 6), n = d || 1; hurt(g, Math.round(dmg * k)); g.vx = dx / n * 260 * k; g.vy = Math.max(70, dy / n * 260 * k + 120 * k); g.ground = false; g.fly = true; g.goto = null;\n    }\n    P.explosion(x, 0, y, r / 22, { debris: false, shake: r / 8 });\n  }\n  function hurt(g, d) { if (d <= 0) return; g.hp = Math.max(0, g.hp - d); g.hurt = .5; stats.damage += d; P.text(g.x, 0, g.y + 18, '-' + d, TEAMS[g.team].color, { bounce: true }); A.sfx('hurt', { vol: .5 }); }\n  function drown(g) { g.dead = g.drowned = true; g.hp = 0; g.sunk = .001; stats.drowned++; splash(g.x); A.sfx('die', { vol: .5 }); }\n  function stepGrubs(dt) {\n    for (const g of grubs) {\n      if (g.dead && (g.drowned || !g.grave)) { if (g.sunk) g.sunk += dt; continue; }\n      const was = g.x, landed = land.walk(g, dt, { gravity: G_GRUB, climb: 4, h: 9 });\n      if (landed) { if (g.fly || g.jump) { g.vx = 0; g.fly = g.jump = false; } if (landed > 230 && !g.dead) { stats.falls++; hurt(g, Math.round((landed - 230) / 4)); A.sfx('land'); } }\n      if (!g.dead && g.y < water - 2) drown(g);\n      g.still = g.vx && Math.abs(g.x - was) < 1e-3 ? g.still + dt : 0;\n      g.shown += (g.hp - g.shown) * Math.min(1, dt * 5); g.hurt = Math.max(0, g.hurt - dt);\n    }\n  }\n  // the end of a turn: everyone at rest; the beaten blow up one by one (what they throw settles first); a team left wins\n  function settle() {\n    if (phT < .7 || !grubs.every(g => g.dead || g.ground)) return;\n    const dying = grubs.find(g => !g.dead && g.hp <= 0);\n    if (dying) { dying.dead = dying.grave = true; stats.kills++; blast(dying.x, dying.y + 4, 12, 8); phT = .2; return; }\n    const alive = [0, 1].map(i => grubs.some(g => g.team === i && !g.dead));\n    if (!alive[0] || !alive[1] || turnNo >= 60) { over(alive[0] && !alive[1] ? 0 : alive[1] && !alive[0] ? 1 : -1); return; }\n    startTurn();\n  }\n  function over(w) { winner = w; mode = 'over'; modeT = 0; menuI = 0; cur = null; A.music(null); A.sfx(w >= 0 ? 'oneup' : 'cancel'); }\n\n  /* ---- 3. A TURN: the player's hands (keys, a mouse's pull, a finger's), or the CPU's: it tries every shot in simulation,\n   * a few each step, then turns, aims and charges to the one it chose ---- */\n  function turn(dt, I) {\n    const g = cur; phT += dt; if (banner && (banner.t -= dt) <= 0) banner = null;\n    if (phase === 'settle') { settle(); return; }\n    if (!g || g.dead) { phase = 'settle'; phT = 0; return; }   // (it walked into the sea)\n    if (phase === 'aim') { turnT -= dt; if (turnT <= 0) { phase = 'settle'; phT = 0; charging = false; power = 0; pull = null; A.sfx('cancel'); return; } if (turnT < 5 && Math.ceil(turnT) !== Math.ceil(turnT + dt)) A.sfx('blip', { pitch: 1.5 }); }\n    const c = cpu ? cpuHands(dt) : hands(I);\n    if (phase === 'fly' && !shots.length) { phase = 'settle'; phT = 0; }\n    if (g.ground && !g.fly && !g.jump) { g.vx = c.walk * 32; if (c.walk) { g.face = c.walk; g.walkT += dt; } else g.walkT = 0; }\n    if (c.jump && g.ground) { g.vy = 150; g.vx = g.face * 70; g.ground = false; g.jump = true; g.goto = null; A.sfx('jump'); }\n    if (phase !== 'aim') return;   // (after a shot: the grub may only walk away, a grenade's retreat)\n    if (c.aim) g.aim = clamp(g.aim + c.aim * 1.4 * dt, -AIM, AIM);\n    if (c.pick >= 0) pickWeapon(c.pick); else if (c.weapon) pickWeapon((teams[g.team].weapon + 1) % 3);\n    if (c.shot) { fire(g, c.shot[0], c.shot[1]); return; }\n    if (c.charge) { if (!charging) A.sfx('charge', { vol: .3 }); charging = true; power = Math.min(1, power + dt / 1.4); }\n    if (charging && (!c.charge || power >= 1)) fire(g, aimAngle(g), power);\n  }\n  const aimAngle = g => g.face > 0 ? g.aim : Math.PI - g.aim;\n  // a world point under a screen point (the view is whole pixels: x across, y up)\n  const toWorld = p => [p[0] + game.screen.ix, -(p[1] + game.screen.iy)];\n  function hands(I) {\n    const g = cur, c = { walk: (I.down('walkR') ? 1 : 0) - (I.down('walkL') ? 1 : 0), aim: (I.down('aimUp') ? 1 : 0) - (I.down('aimDown') ? 1 : 0), jump: I.pressed('jump'), weapon: I.pressed('weapon'), pick: ['w1', 'w2', 'w3'].findIndex(a => I.pressed(a)), charge: I.down('fire'), shot: null };\n    // a pull: a mouse's left drag (input.box) or a finger anywhere (the touch stick in drag mode, input.drag()); the shot\n    // goes the other way, its power the pull's length\n    const B = I.box(), d = I.drag();\n    if (B) pull = { dx: B.from[0] - B.to[0], dy: B.from[1] - B.to[1], done: B.done };\n    else if (I.stickOn) { pull = pull && !pull.done ? pull : { dx: 0, dy: 0 }; if (d) { pull.dx -= d[0]; pull.dy -= d[1]; } }\n    else if (pull && !pull.done) pull.done = true;\n    if (pull) {\n      const l = Math.hypot(pull.dx, pull.dy);\n      if (l > 12) { const ang = Math.atan2(-pull.dy, pull.dx); g.face = Math.cos(ang) >= 0 ? 1 : -1; g.aim = clamp(g.face > 0 ? ang : Math.atan2(-pull.dy, -pull.dx), -AIM, AIM); power = Math.min(1, l / PULL); }\n      if (pull.done) { if (l > 12 && phase === 'aim') c.shot = [aimAngle(g), Math.min(1, l / PULL)]; pull = null; if (!c.shot) power = 0; }\n    }\n    // a click or a tap on the island walks there (the keys take over)\n    const ck = I.clicked(); if (ck && !pull) { const w = toWorld(ck); g.goto = w[0]; }\n    if (c.walk) g.goto = null;\n    else if (g.goto !== null) { const dx = g.goto - g.x; if (Math.abs(dx) < 1.5 || g.still > .3) g.goto = null; else c.walk = Math.sign(dx); }\n    return c;\n  }\n  const POWERS = [.3, .4, .5, .6, .7, .8, .9, 1], AIM = 1.45;   // (the aim: up to 1.45 radians above level, or below)\n  function cpuHands(dt) {\n    const g = cur, c = { walk: 0, aim: 0, jump: false, weapon: 0, pick: -1, charge: false, shot: null }, k = cpu; k.t += dt;\n    if (phase !== 'aim') return c;\n    if (k.phase === 'think') {\n      if (!k.cands) { k.cands = []; const t = teams[g.team]; for (let w = 0; w < 3; w++) if (t.ammo[w] > 0) for (const f of [1, -1]) for (let a = -.2; a <= AIM + 1e-6; a += .075) for (const p of POWERS) k.cands.push([w, f, Math.min(a, AIM), p]); }\n      for (let n = 0; n < 6 && k.i < k.cands.length; n++, k.i++) { const [w, f, a, pw] = k.cands[k.i], s = score(sim(w, g, f > 0 ? a : Math.PI - a, pw), g); if (!k.best || s > k.best.s) k.best = { w, f, a, pw, s }; }\n      if (k.i >= k.cands.length && k.t > .8) {   // chosen: an unsteady hand, then turn to it\n        const b = k.best; k.face = b.f; k.aim = clamp(b.a + (Math.random() - .5) * .05, -AIM, AIM); b.pw = clamp(b.pw * (1 + (Math.random() - .5) * .05), .15, 1); k.phase = 'aim'; c.pick = b.w;\n      }\n      return c;\n    }\n    g.face = k.face; const da = k.aim - g.aim;\n    if (k.phase === 'aim') { if (Math.abs(da) <= 1.4 * dt) { g.aim = k.aim; k.phase = 'charge'; } else c.aim = Math.sign(da); return c; }\n    if (power + dt / 1.4 < k.best.pw) c.charge = true; else c.shot = [aimAngle(g), k.best.pw];\n    return c;\n  }\n  // a shot as it would go, on the island as it is: the blasts it would make ([[x, y, r, dmg]]), or null (the sea, away)\n  function sim(w, g, ang, pw) {\n    const W = WEAPONS[w], [x, y, vx, vy] = muzzle(g, ang, pw, W); if (land.solid(x, y)) return null;\n    if (W.id === 'grenade') { const pw2 = new E.Physics(PHYS); pw2.add(land.collider()); const b = pw2.circle(x, y, 2.5, GREN); b.vx = vx; b.vy = vy; for (let i = 0; i < FUSE_N; i++) { pw2.step(DT); if (b.y < water) return null; } return [[b.x, b.y, W.r, W.dmg]]; }\n    const s = { w: W, x, y, vx, vy, t: 0 }; let e; while (!(e = fly(s, DT, g))) { /* flying */ } if (e !== 'hit') return null;\n    const out = [[s.x, s.y, W.r, W.dmg]];\n    if (W.bits) for (const b of bits(s.x, s.y)) { let f; while (!(f = fly(b, DT, null))) { /* flying */ } if (f === 'hit') out.push([b.x, b.y, BIT.r, BIT.dmg]); }\n    return out;\n  }\n  // what a shot is worth: the foes' hurt (a kill more), less its own side's (its own grub's most), and, hitting none, nearer\n  function score(pts, me) {\n    if (!pts) return -1e4;\n    let s = 0, near = 1e9;\n    for (const [x, y, r, dmg] of pts) for (const g of grubs) {\n      if (g.dead) continue; const d = Math.hypot(g.x - x, g.y + 5 - y), foe = g.team !== me.team; if (foe) near = Math.min(near, d); if (d >= r + 6) continue;\n      const hit = dmg * (1 - d / (r + 6)), kill = hit >= g.hp; s += foe ? hit + (kill ? 40 : 0) + (g.y - y < 30 && g.y - water < 30 ? 8 : 0) : -(hit * (g === me ? 2 : 1.5) + (kill ? 80 : 0));\n    }\n    return s - near * .05;\n  }\n\n  /* ---- 4. THE SCENE: the choice of players over the island, the match, its end ---- */\n  const CHOICES = [['ONE PLAYER', 'AGAINST THE CPU', 'cpu'], ['TWO PLAYERS', 'ON ONE SCREEN, IN TURN', 'two'], ['TWO CPUS', 'WATCH THEM PLAY', 'demo']];\n  const AFTER = [['PLAY AGAIN', 'A NEW ISLAND'], ['PLAYERS', 'CHOOSE AGAIN'], ['TITLE', '']];\n  function start(data) {\n    shots = []; cur = null; banner = null; winner = -1; menuI = 0; water = 34; island(7); mode = 'menu'; modeT = 0;\n    game.input.touchEnabled = true; game.input.steer = 'drag'; game.input.zones = null; L.enabled = false; game.follow(null); A.music(null);\n    game.cam.bounds = () => ({ x0: -40, y0: -SKY, x1: WW + 40, y1: 12 }); game.cam.align = 'bottom'; game.focus(WW / 2, 0, 160); game.cam.snap = true;\n    if (data && data.part === 'cpu') begin('demo');\n  }\n  // the buttons of a menu: a thumb's height on a touch screen\n  function buttons(list, W, H) {\n    const k = game.screen.dpr / game.screen.S, h = Math.max(24, Math.ceil(46 * k)), w = Math.min(W - 24, 200), gap = 6, y0 = Math.round(Math.max(H * .42, H - (h + gap) * list.length - 34));\n    return list.map((b, i) => ({ x: Math.round((W - w) / 2), y: y0 + i * (h + gap), w, h, label: b[0], sub: b[1], i }));\n  }\n  function menu(I, list, pick) {\n    const B = buttons(list, game.W, game.H), ck = I.clicked(), hit = ck && B.find(b => ck[0] >= b.x && ck[0] < b.x + b.w && ck[1] >= b.y && ck[1] < b.y + b.h);\n    if (I.pressed('up')) { menuI = (menuI + list.length - 1) % list.length; A.sfx('select'); }\n    if (I.pressed('down')) { menuI = (menuI + 1) % list.length; A.sfx('select'); }\n    if (hit || I.pressed('confirm') || I.pressed('start')) { if (hit) menuI = hit.i; A.sfx('confirm'); I.consumeAll(); pick(menuI); }\n  }\n  function update(dt) {\n    const I = game.input, human = mode === 'play' && cur && !cpu && (phase === 'aim' || phase === 'fly'); modeT += dt;\n    I.touchSet('jump', null, human); I.touchSet('weapon', human ? weapon().name : null, human && phase === 'aim');   // (the buttons only on a player's turn)\n    stepGrubs(dt); stepShots(dt);\n    if (mode === 'menu') { menu(I, CHOICES, i => begin(CHOICES[i][2])); game.focus(WW / 2 + Math.sin(modeT * .1) * 160, 0, 160); return; }\n    if (mode === 'over') { if (modeT > 1.2) menu(I, AFTER, i => i === 0 ? begin(play) : i === 1 ? start() : game.go('title')); return; }\n    if (play === 'demo' && modeT > .5 && (I.anyPressed() || I.clicked())) { I.consumeAll(); start(); return; }\n    // a look away: a click or a tap on the minimap, or the mouse's right button dragged, moves the camera for a while\n    const ck = I.clicked(), mb = miniBox(game.W), pn = I.pan();\n    if (ck && ck[0] >= mb.x && ck[0] < mb.x + mb.w && ck[1] >= mb.y && ck[1] < mb.y + mb.h + 6) { const f0 = cur || { x: WW / 2, y: 100 }; look = { x: -40 + (ck[0] - mb.x) / mb.w * (WW + 80) - f0.x, y: 0, t: 3 }; I.consumeAll(); }\n    else if (pn && !I.stickOn) { look.x -= pn[0]; look.y += pn[1]; look.t = 3; }\n    if ((look.t -= dt) <= 0) { look.x *= 1 - Math.min(1, dt * 4); look.y *= 1 - Math.min(1, dt * 4); }\n    turn(dt, I);\n    // the camera: on a shot, else on whoever falls, else the grub whose turn it is, led along its aim as it charges\n    const s = shots[0], m = !s && phase === 'settle' && grubs.find(g => !g.dead && !g.ground), f = s || m || cur, lead = cur && f === cur && phase === 'aim' ? power * 110 : 0;\n    if (f) game.focus(f.x + look.x + (lead && Math.cos(aimAngle(cur)) * lead), 0, f.y + 24 + look.y + (lead && Math.sin(aimAngle(cur)) * lead));\n  }\n\n  /* ---- 5. DRAWING: the sky, far hills and clouds blown by the wind, the island (the terrain's own chunks), the grubs, the\n   * shots, the sea; the turn, its clock, the wind, the teams' health, the weapon ---- */\n  function draw(r) {\n    const W = r.W, H = r.H, S = game.screen, t = game.time, h = E.hash2;\n    r.sky(['#3a7ac8', '#8ac8f0', '#d8f0ff']);\n    r.decal(g => {   // the sun, two ranges of far hills moving slower than the island, clouds drifting with the wind\n      const wy = y => -y - S.iy;\n      px.ddisc(g, W * .78, wy(380) * .5 + H * .2, 46, '#fff4c0', .5); px.disc(g, W * .78, wy(380) * .5 + H * .2, 16, '#fff8e0');\n      for (const [k, c, base, amp] of [[.25, '#8ab0d0', 70, 60], [.5, '#6a96b8', 52, 44]]) { const ox = S.ix * k, sy = wy(0) + base * (1 - k); for (let x = 0; x < W; x += 2) { const X = x + ox, top = sy - base - amp * (.5 + .3 * Math.sin(X / 90 + k * 9) + .2 * Math.sin(X / 37 + k * 3)); px.rect(g, x, top, 2, H - top, c); } }\n      for (let i = 0; i < 7; i++) { const cx = ((h(i, 3) * 1400 + t * (6 + wind * 24) - S.ix * .6) % 1400 + 1400) % 1400 - 200, cy = wy(260 + h(i, 4) * 220) * .7 + H * .1; for (let j = 0; j < 4; j++) px.ell(g, cx + j * 12 - 18, cy + (j % 2) * 3, 16 - Math.abs(j - 1.5) * 3, 6, '#f4faff'); }\n    });\n    r.decal(g => { const [x, y] = r.w(0, 0, WH); g.drawImage(back, Math.round(x), Math.round(y)); });\n    land.draw(r);\n    r.decal(g => {\n      for (const o of grubs) if (o.grave && !o.drowned) grave(g, r, o);\n      for (const o of grubs) if (!o.dead || (o.drowned && o.sunk < 1.2)) grubArt(g, r, o);\n      if (cur && !cur.dead && mode === 'play' && phase === 'aim') aimArt(g, r, cur);\n      for (const s of shots) shotArt(g, r, s);\n      // the sea: over all that sinks in it, its waves moving\n      const [, sy] = r.w(0, 0, water); px.blend(g, .78, 'normal', () => px.rect(g, 0, sy, W, H - sy, '#1a5aa0'));\n      for (let x = 0; x < W; x += 2) { const X = x + S.ix, y = sy + Math.round(Math.sin(X / 9 + t * 2.4) * 1.2 + Math.sin(X / 23 - t * 1.3)); px.rect(g, x, y - 1, 2, 2, '#9ad0ff'); if (h(X >> 1, Math.floor(t * 3)) < .04) px.dot(g, x, y + 3, '#ffffff'); }\n    });\n    hud(r);\n  }\n  function grubArt(g, r, o) {\n    const T = TEAMS[o.team], f = o.face, [sx, sy0] = r.w(o.x, 0, o.y - (o.sunk ? o.sunk * 8 : 0)), sy = Math.round(sy0), bob = o.ground ? Math.round(Math.sin(game.time * 3 + o.x)) * .5 : 0, sq = o.walkT ? Math.sin(o.walkT * 16) * .7 : 0;\n    const tint = o.hurt > 0 && Math.floor(o.hurt * 20) % 2 ? '#ffffff' : null;\n    // an outline, then the tail, the body and the head, the team's headband, the eyes looking where it faces\n    px.ell(g, sx - f * 4, sy - 2, 4.5, 3.5, '#3a1420'); px.ell(g, sx, sy - 4, 5.5 + sq, 5, '#3a1420'); px.disc(g, sx + f, sy - 9 + bob, 5, '#3a1420');\n    px.ell(g, sx - f * 4, sy - 2, 3.5, 2.5, tint || '#cc6a7a'); px.ell(g, sx, sy - 4, 4.5 + sq, 4, tint || '#e88a98'); px.disc(g, sx + f, sy - 9 + bob, 4, tint || '#f6a6b2');\n    px.rect(g, sx + f - 4, sy - 12 + bob, 9, 2, T.color); px.dot(g, sx - f * 4, sy - 11 + bob, T.color); px.dot(g, sx - f * 5, sy - 10 + bob, T.dark);\n    px.dot(g, sx + f * 2, sy - 9 + bob, '#ffffff'); px.dot(g, sx + f * 3, sy - 9 + bob, '#ffffff'); px.dot(g, sx + f * 3, sy - 9 + bob + (o.fly ? -1 : 0), '#101018');\n    px.dot(g, sx + f * 3, sy - 6 + bob, '#8a2a3a');\n    if (o.dead) return;\n    // its name and health above it, in its team's color\n    E.font.text(g, o.name, sx, sy - 32, T.color, { align: 'center', shadow: '#000', outline: false });\n    E.font.text(g, String(Math.round(o.shown)), sx, sy - 22, '#ffffff', { align: 'center', font: 'tiny', shadow: T.dark, outline: false });\n    if (o === cur && mode === 'play' && phase === 'aim' && Math.floor(game.time * 3) % 2) px.poly(g, [[sx - 3, sy - 38], [sx + 3, sy - 38], [sx, sy - 34]], '#ffffff');\n    if (o === cur && cpu && cpu.phase === 'think') E.font.text(g, '?'.repeat(1 + Math.floor(game.time * 3) % 3), sx + 8, sy - 20, '#ffffff', { font: 'tiny', shadow: '#000', outline: false });\n  }\n  function grave(g, r, o) { const [sx, sy] = r.w(o.x, 0, o.y).map(Math.round); px.rect(g, sx - 4, sy - 10, 8, 10, '#3a3a44'); px.rect(g, sx - 3, sy - 9, 6, 9, '#9a9aa8'); px.rect(g, sx - 1, sy - 8, 2, 6, '#5a5a68'); px.rect(g, sx - 3, sy - 6, 6, 2, '#5a5a68'); }\n  // the weapon in its hands along the aim, the crosshair, the power (dots from yellow to red)\n  function aimArt(g, r, o) {\n    const a = aimAngle(o), c = Math.cos(a), s = -Math.sin(a), [sx, sy] = r.w(o.x, 0, o.y + 6), W = weapon();\n    if (W.id === 'rocket') { px.line(g, sx - c * 3, sy - s * 3, sx + c * 7, sy + s * 7, '#2a4a2a', 3); px.line(g, sx - c * 3, sy - s * 3, sx + c * 7, sy + s * 7, '#5a8a4a', 1); }\n    else px.disc(g, sx + c * 5, sy + s * 5, 2.5, W.id === 'grenade' ? '#3a6a2a' : '#c03a2a');\n    const cx = sx + c * 26, cy = sy + s * 26; px.line(g, cx - 3, cy, cx + 3, cy, '#ff3a3a'); px.line(g, cx, cy - 3, cx, cy + 3, '#ff3a3a'); px.dot(g, cx, cy, '#ffffff');\n    for (let i = 0; i < 12 && i < power * 12; i++) { const d = 9 + i * 2.2; px.disc(g, sx + c * d, sy + s * d, 1 + i * .12, E.mix('#ffe040', '#ff2a1a', i / 11)); }\n  }\n  function shotArt(g, r, s) {\n    const [x, y] = r.w(s.x, 0, s.y);\n    if (s.body) { px.disc(g, x, y, 3, '#1a2a14'); px.disc(g, x, y, 2, '#4a7a3a'); px.dot(g, x - 1, y - 1, '#9ad08a'); E.font.text(g, String(Math.ceil((FUSE_N - s.n) * DT)), x, y - 12, '#ffffff', { align: 'center', font: 'tiny', shadow: '#000', outline: false }); return; }\n    if (s.w === BIT) { px.disc(g, x, y, 1.5, '#2a1a1a'); return; }\n    const l = Math.hypot(s.vx, s.vy) || 1, c = s.vx / l, d = -s.vy / l;\n    if (s.w.id === 'cluster') { px.disc(g, x, y, 3, '#3a1010'); px.disc(g, x, y, 2, '#d04a2a'); return; }\n    px.line(g, x - c * 5, y - d * 5, x + c * 3, y + d * 3, '#3a3a3a', 3); px.line(g, x - c * 4, y - d * 4, x + c * 3, y + d * 3, '#c8c8c8'); px.dot(g, x + c * 3, y + d * 3, '#ff3a2a'); px.dot(g, x - c * 6, y - d * 6, '#ffd040');\n  }\n  function hud(r) {\n    r.overlay(g => {\n      const W = r.W, H = r.H, touch = game.input.lastDevice === 'touch', ta = touch && game.input.touchArea(), right = Math.min(W, cornerX());\n      if (mode === 'menu' || mode === 'over') {\n        g.fillStyle = 'rgba(8,12,30,.35)'; g.fillRect(0, 0, r.bw, r.bh); px.reset(g);\n        if (mode === 'menu') { E.font.title(g, 'BLAST', W / 2, 14, { align: 'center', scale: 3, colors: ['#fff0c0', '#ffb040', '#c04a1a'], depth: 3 }); E.font.title(g, 'ISLAND', W / 2, 44, { align: 'center', scale: 3, colors: ['#e0f8ff', '#6ac0ff', '#2a5ac0'], depth: 3 }); E.font.text(g, 'TWO TEAMS OF THREE, TURN BY TURN', W / 2, 76, '#ffffff', { align: 'center', shadow: '#000', outline: false }); }\n        else { const T = TEAMS[winner]; E.font.title(g, winner < 0 ? 'A DRAW' : T.short + ' WINS', W / 2, 20, { align: 'center', scale: 3, colors: winner < 0 ? ['#ffffff', '#c8c8d8', '#6a6a7a'] : ['#ffffff', T.color, T.dark], depth: 3 }); E.font.text(g, turnNo + ' TURNS, ' + stats.shots + ' SHOTS, ' + stats.kills + ' DOWN, ' + stats.drowned + ' DROWNED', W / 2, 54, '#ffffff', { align: 'center', shadow: '#000', outline: false }); }\n        if (mode === 'menu' || modeT > 1.2) for (const b of buttons(mode === 'menu' ? CHOICES : AFTER, W, H)) {\n          const on = b.i === menuI; E.ui.box(g, b.x, b.y, b.w, b.h, { bg: on ? '#3a2a6a' : '#141a3a', border: on ? '#ffd36a' : '#8a8ab0' });\n          E.font.text(g, b.label, b.x + b.w / 2, b.y + b.h / 2 - (b.sub ? 9 : 4), on ? '#ffd36a' : '#ffffff', { align: 'center', outline: false, shadow: '#000' });\n          if (b.sub) E.font.text(g, b.sub, b.x + b.w / 2, b.y + b.h / 2 + 1, '#a8b0d8', { align: 'center', outline: false });\n        }\n        return;\n      }\n      // the turn: whose, its clock; the wind\n      if (cur) { const T = TEAMS[cur.team], s = Math.max(0, Math.ceil(turnT)); E.ui.box(g, 4, 4, 74, 24, { bg: '#101428', border: T.color, gradient: false }); E.font.text(g, cur.name, 9, 8, T.color, { outline: false }); E.font.text(g, play === 'two' ? 'PLAYER ' + (cur.team + 1) : teams[cur.team].human ? 'YOU' : 'CPU', 9, 18, '#a8b0d8', { font: 'tiny', outline: false }); E.font.text(g, phase === 'aim' ? String(s) : '-', 72, 9, s <= 5 && phase === 'aim' ? '#ff5a4a' : '#ffffff', { align: 'right', scale: 2, outline: false }); }\n      E.ui.box(g, 82, 4, 86, 14, { bg: '#101428', border: '#8a8ab0', gradient: false }); E.font.text(g, 'WIND', 86, 8, '#ffffff', { outline: false });\n      const wl = Math.round(Math.abs(wind) * 20); px.rect(g, 142, 7, 1, 8, '#ffffff'); if (wl) px.rect(g, wind > 0 ? 143 : 142 - wl, 9, wl, 4, Math.abs(wind) > .6 ? '#ff7a4a' : '#7ad0ff');\n      minimap(g, W);\n      // the teams' health\n      const bx = 6, bw = Math.min(96, (ta ? ta.x0 : W) - 50), by = H - 22;\n      TEAMS.forEach((T, i) => { const hp = grubs.filter(o => o.team === i).reduce((a, o) => a + Math.max(0, o.shown), 0), y = by + i * 9; E.font.text(g, T.short, bx, y, T.color, { font: 'tiny', shadow: '#000', outline: false }); px.rect(g, bx + 22, y, bw, 6, '#101428'); px.rect(g, bx + 23, y + 1, Math.round((bw - 2) * hp / (HP * 3)), 4, T.color); });\n      // the weapon, and what to press\n      if (cur && mode === 'play' && !cpu) {\n        const Wp = weapon(), t = teams[cur.team], n = t.ammo[t.weapon], wy = by - 14; E.font.text(g, Wp.name + (n !== Infinity ? ' x' + n : ''), bx, wy, '#ffe7a8', { shadow: '#000', outline: false });\n        if (phase === 'aim' && turnNo <= 2) E.font.text(g, touch ? 'DRAG BACK TO FIRE, TAP TO WALK' : 'ARROWS WALK, AIM  SPACE FIRES  Q WEAPON', bx, wy - 11, '#d8e0ff', { shadow: '#000', outline: false });\n      }\n      if (banner) { const T = TEAMS[banner.team], a = Math.min(1, banner.t * 3); px.blend(g, a, 'normal', () => { E.font.title(g, banner.s, W / 2, H * .3, { align: 'center', scale: 2, colors: T ? ['#ffffff', T.color, T.dark] : ['#ffffff', '#6ac0ff', '#1a4a8a'], depth: 2 }); E.font.text(g, banner.sub, W / 2, H * .3 + 22, '#ffffff', { align: 'center', shadow: '#000', outline: false }); }); }\n    });\n  }\n\n  // the minimap: the island's line, the sea, the grubs, the shots and the screen's part of it (on a narrow screen, under\n  // the turn's box)\n  const miniBox = W => { const wide = Math.min(W, cornerX()) - 176 >= 150; return wide ? { x: 176, y: 4, w: Math.min(220, Math.min(W, cornerX()) - 184), h: 22 } : { x: 4, y: 32, w: Math.min(220, W - 8), h: 22 }; };\n  function minimap(g, W) {\n    const B = miniBox(W), sx = x => B.x + (x + 40) / (WW + 80) * B.w, sy = y => B.y + B.h - Math.min(B.h, y / 240 * B.h);\n    if (!profile || profile.length !== B.w) { profile = []; for (let i = 0; i < B.w; i++) profile.push(land.ground(-40 + (i + .5) / B.w * (WW + 80), WH) || 0); }\n    px.rect(g, B.x - 1, B.y - 1, B.w + 2, B.h + 2, '#8a8ab0'); px.rect(g, B.x, B.y, B.w, B.h, '#2a5a90');\n    for (let i = 0; i < B.w; i++) if (profile[i] > 0) { const y = Math.round(sy(profile[i])); px.rect(g, B.x + i, y, 1, B.y + B.h - y, '#8a6a3a'); px.dot(g, B.x + i, y, '#6ad04a'); }\n    const wy = Math.round(sy(water)); px.blend(g, .7, 'normal', () => px.rect(g, B.x, wy, B.w, B.y + B.h - wy, '#1a4a90'));\n    for (const o of grubs) if (!o.dead && (o !== cur || Math.floor(game.time * 4) % 2)) px.rect(g, Math.round(sx(o.x)) - 1, Math.round(sy(o.y + 4)) - 1, 3, 3, TEAMS[o.team].color);\n    for (const s of shots) px.dot(g, Math.round(sx(s.x)), Math.round(sy(s.y)), '#ffffff');\n    const S = game.screen, v0 = Math.max(B.x, sx(S.ix)), v1 = Math.min(B.x + B.w, sx(S.ix + W)); px.rect(g, v0, B.y, v1 - v0, 1, '#ffffff'); px.rect(g, v0, B.y + B.h - 1, v1 - v0, 1, '#ffffff'); px.rect(g, v0, B.y, 1, B.h, '#ffffff'); px.rect(g, v1 - 1, B.y, 1, B.h, '#ffffff');\n  }\n\n  /* ---- 6. THE BOT: two CPUs play a match to its end, twice; how it went (tools/kits-test.mjs) ---- */\n  const hashLand = () => { let h = 0; const C = land.cells; for (let i = 0; i < C.length; i += 5) h = (Math.imul(h, 31) + C[i]) | 0; return h; };\n  function botRun(o = {}) { const a = botMatch(o), b = botMatch(o); a.repeat = a.hash === b.hash && a.turns === b.turns && a.winner === b.winner; return a; }\n  function botMatch(o) {\n    const was = Math.random;\n    try {\n      Math.random = E.rng(o.seed || 11);\n      game.time = 0; game.timeScale = 1; game.go('artillery', null, { fade: 0 }); game.advance(1 / 120);\n      begin('demo', o.seed || 11); let t = 0;\n      while (mode !== 'over' && t < (o.seconds || 1200)) { game.advance(1 / 60); t += 1 / 60; }\n      return { over: mode === 'over', winner, turns: turnNo, shots: stats.shots, used: stats.used, kills: stats.kills, drowned: stats.drowned, falls: stats.falls, carved: stats.carved, damage: stats.damage, time: Math.round(t), hash: hashLand() ^ grubs.reduce((h, g) => Math.imul(h, 31) + Math.round(g.x * 10) + g.hp | 0, 0), errors: game.errors.length };\n    } finally { Math.random = was; }\n  }\n\n  return { view: 'artillery', views: ['artillery'], res: 'ps1', pausable: true, touch: ['jump', 'weapon'], camera: { zoom: false }, input: KEYS,\n    enter: start, update, draw, bot: botRun,\n    exit() { game.input.steer = 'stick'; game.cam.bounds = null; game.cam.align = null; A.music(null); },\n    back() { if (mode === 'menu') return false; start(); return true; },\n    /** for tests: the island, the grubs, the turn, the shots, where a world point is on the screen; begin(how, seed) starts a match */\n    state: () => ({ land, grubs, cur, phase, mode, turnNo, wind, water, shots, power, teams, stats, winner, weapon: cur ? weapon().id : null, at: (x, y) => { const q = game.view.p(x, 0, y); return [q[0] - game.screen.ix, q[1] - game.screen.iy]; }, buttons: () => buttons(mode === 'menu' ? CHOICES : AFTER, game.W, game.H) }),\n    /** begin(how, seed): a match ('cpu': one player against the CPU, 'two': two players, 'demo': two CPUs) on the island of\n     *  that seed (else a new one) */\n    begin,\n    /** the proof: a match against the CPU on a seeded island; the player aims up and fires, then the CPU's turn; the\n     *  island's cells, the grubs, the turn */\n    run: (n = 1200) => proof('artillery', n, (i, k) => {\n      if (i === 2) begin('cpu', 3);\n      if (i === 200) k.hold('aimUp'); if (i === 240) k.up('aimUp');\n      if (i === 300) k.hold('fire'); if (i === 400) k.up('fire');\n    }, () => [hashLand(), grubs.map(g => [Math.round(g.x * 10), Math.round(g.y * 10), g.hp, g.dead]), turnNo, phase, wind, water, stats.shots]) };\n})();\nscenes.artillery = ARTILLERY;\n\n/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n// a genre kit file holds one slice: the menu lists only the slices in this file\nfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\ntitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\nconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\ngame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\nwindow.__game = { game, scenes, titleMenu };   // for tests\n})();\n/* =============================== GAME END =============================== */\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'cat vendor/engine/dist/handoff/docs/ASSETS.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'cat vendor/engine/dist/handoff/docs/ASSETS.md'","aggregated_output":"# Objects and materials as data\n\nThe full engine draws still objects (barrels, tables, trees, wells) from a few lines of data, in every view and facing,\nwith the house shading and outline, and gives every surface (floors, wall faces, wall tops, platform tiles, the objects'\nown faces) a material from one open registry. An object costs one to a few hundred tokens of data (the core's median is\n125); you check it headless with one command. Read this card whole before you write one. (The agent edition keeps the\nregistries and ignores the calls: `E.addAssets` returns empty lists, the others null.)\n\n## Use one\n\n```js\n// in draw(r): feet on the point, depth sorted like an actor; its front toward facing\nr.shape('barrel', x, y, 0, { facing: Math.PI / 2 });\n// once, before the updates: bodies stop at it, a body coming down lands on it, one wholly below passes under\nmap.solid('table', 120, 80, 0, { facing: 0 });\n// a sprite of it, for an inventory or a HUD (r.sprite, px.sprite)\nconst icon = E.shapeSprite('chest', { view: 'iso' });\n```\n\n- **r.shape options:** facing (radians, where the front points: 0 east, π/2 south, as written), scale, mats ({ slot:\n  material }), flip (mirrors it x to -x, collision too), params (a generator's: { h: 30 }), bias, hides (default true),\n  light (adds its lights to game.lights), shadow (default true).\n- **map.solid** takes the same id and placement, so one object can feed both calls. Bodies span z to z + h (E.Body's h, 32).\n- **In 3D** the 3D engine draws the same entries, materials and boxes: `world.shape(id, x, y, z, o)` (its header).\n- **Steep views** (top-down) draw shapes from the characters' lower angle, as rigs are drawn. The light comes from the\n  viewer's upper left in every view.\n- **Glow and fire:** a material with glow: 1 ignores the light and stays bright in the dark; an entry's flames ([[x, y, z,\n  w, h]]) draw the engine's animated flame (r.shape only: a sprite has none). Anything else that moves stays a prop\n  (r.prop) or your own code.\n- **Dressing a generated level:** a scene is a few entries as [id, across, forward] from an anchor (a wall spot, forward\n  into the room); place it whole or not at all, each part on free floor, after the level's own random picks and from a\n  seeded stream of its own, so the level stays as its seed builds it (Emberdeep's `src/emberdeep/53-scenes.js`).\n\n## The core library\n\n**Shapes** (sized for a 26-unit hero; generators take params): barrel, crate, chest, table, chair, stool, bench, bed,\nbookcase, shelf, pot, jar, sack, cart, well, sign, lamppost, anvil; fence { len: 16 }, pine { h: 41, tiers: 4 },\ntree { h: 40, seed: 1 }, bush { r: 7 }, grass { h: 6, n: 6 }, rock { r: 7.5, seed: 2 }, crystal { h: 18, seed: 1 }.\n`r.shape('pine', x, y, 0, { params: { h: 30 } })`; `E.SHAPES.barrel.about` says what each is.\n\n**Materials:** woods oak walnut birch crate plank planks wood; stones stone cobble marble granite sandstone slate rock\nbrick flagstone ruin; metals iron steel gold copper bronze metal rusted; clay glazed porcelain; cloth linen burlap wool velvet leather;\nplants bark needles leaves shrub moss straw hedge grass; ground dirt sand snow mud; water ice crystal flame bone shingle;\nwalls timber plaster; tops speckle plain tiles slab; tiles block bonus ground pipe checker.\n\n## Materials on surfaces\n\n```js\nE.MATERIALS.mossy = { color: '#6a7a5a', pattern: 'stones', size: 6 };   // or the shorthand '#6a7a5a stones size=6'\nconst types = { 1: { h: 32, top: '#6a6280', side: '#4a4360', face: 'cobble', roof: 'slate' } };   // TileMap walls\nconst map = new E.TileMap({ rows, legend, types, floorMat: 'flagstone', floorMats: { water: 'water' } });   // floors\nconst level = new E.PlatformMap({ rows, legend, types: { 1: { kind: 'solid', style: 'block', mat: 'mossy' } } });\n```\n\nfloorMats is keyed by the floor tags of the legend ('~': { floor: 'water' }); either stands in for floorTex.\n\nA material is `{ color, pattern, ...the pattern's numbers, ramp, glow, over }`. Its five tones come from `E.tones(color)`\n(or its own `ramp` of five, dark to light); the light picks a band, the pattern moves it a step, so a material works on\nevery surface and in every palette and recolors with one hex. An unknown name warns with the list of names.\nOverlays, the last on top, each in its own color's tones: `over: [['moss', '#5f7a3a', { up: .6 }], ['cracks']]`; moss on\nwhat looks up, cracks (the material a step darker), dirt near the ground (h 6), rust; each takes amount and size.\n\n| Pattern | Numbers | What |\n| --- | --- | --- |\n| none | | the light alone |\n| planks | bw 3, len 14, dir | boards with joints; staves on round parts; dir: 'v' turns them |\n| crate | frame 2, bw 3 | a framed, braced side; planks on its lid |\n| bricks | bw 6, bh 3, mortar | running bond |\n| stones | size 5 | irregular stones (Voronoi), dark joints, a lit rim |\n| tiles | size 4 | square tiles, grout |\n| speck, noise | amount .08; scale 4 | specks; soft patches |\n| foliage | size 3.5 | leaf clumps lit on top |\n| bark | | fissures; rings on a cut end |\n| metal | rivet | a shine where lit; rivets |\n| cloth | fold .9 | weave and folds |\n| glaze | | a glossy shine |\n| thatch, shingles | course; bw | straw courses; roof tiles |\n\nYour own pattern: `E.PATTERNS.waves = (s, m) => Math.sin(s.u / (m.size || 3)) > .8 ? 1 : 0` (s.u, s.v: world units\nacross and up the surface; s.lid, s.curved, s.lit, s.W, s.H; return a step, -1 to +2). A material may also paint one kind\nof surface its own way, per pixel: `face(wx, z, tones, type, cx, cy, fi, nh, h)` or `roof(wx, wy, tones, type)` returning\na color or null, `floor(x, y, tag, view)` returning [r, g, b].\n\n## Write one\n\nUnits: 16 = 1 m = one tile; x east, y south, z up. The origin is the middle of the footprint on the ground; write it\nfacing south (+y). Use whole or half units: a pixel at game size is about 0.7 units.\n\n```js\nE.SHAPES.stool = { about: 'round three-legged stool', tags: 'furniture tavern', mats: { w: 'oak', l: 'walnut' },\n  parts: [['cyl','w',[0,0,8],5,1.5], ['ring',3,3,['box','l',[0,0,0],[1.5,1.5,8],{rot:[0,-8,0]}]]] };\n```\n\nAn entry: `about`, `tags`, `mats` (slot to material; a slot name that is not in mats is a material itself), and `parts`, or\n`make(params)` returning parts with `params` its defaults. Optional: `scale` (times the placement's), `foot: [x0, y0,\nx1, y1]` (the footprint for collision, and for sorting when it stands raised; the bounds by default), `lights: [[x, y,\nz, color, radius]]`, `flames: [[x, y, z, w, h]]`.\n\n| Part | Form | Notes |\n| --- | --- | --- |\n| box | `['box', m, at, [w, d, h], { rot }]` | at: the bottom middle |\n| cyl | `['cyl', m, at, r, h, { r2, seg, sq }]` | r2: top radius (0: a cone); sq squashes y; seg: 6 for a hexagon |\n| lathe | `['lathe', m, at, [[r, z], ...], { seg }]` | a profile turned about z, bottom to top; [0, z] closes an end |\n| ball | `['ball', m, at, r, { sz }]` | at: its centre; sz below 1 flattens it |\n| prism | `['prism', m, at, [[a, b], ...], h, { axis }]` | an outline pushed h: up z (outline x, y), or centred along y (outline x, z) or x (outline y, z) |\n| wedge | `['wedge', m, at, [w, d, h]]` | h tall at the back, down to the floor at the front |\n| rock | `['rock', m, at, r, { sz, seed, rough }]` | a lumpy, faceted ball; below the floor is not drawn |\n| use | `['use', id, at, { rot, scale, mats, ...params }]` | another shape inside this one |\n| mirror | `['mirror', 'x' \\| 'y' \\| 'xy', part]` | the part and its mirror copies |\n| ring, row | `['ring', n, radius, part]`, `['row', n, [dx, dy, dz], part]` | n copies round z (the part moved out to radius); n copies in a line, centred |\n| group | `['group', at, rot, [parts]]` | parts moved and turned together |\n\nEvery part takes `{ rot }`: a yaw in degrees, or [x, y, z] degrees. Write arrays densely (`[0,0,8]`, not `[0, 0, 8]`):\nspaces cost a third more tokens.\n\n### Worked entries\n\n```js\nbarrel: { about: 'oak barrel, two iron hoops', tags: 'container wood', mats: { w: 'oak', h: 'iron' },\n  parts: [['lathe','w',[0,0,0],[[0,0],[5,0],[6,3],[6.5,8],[6,13],[5,16],[0,16]]], ['row',2,[0,0,9],['cyl','h',[0,0,7.5],6.5,1.5]]] },\ncrate: { about: 'wooden crate, framed and braced', tags: 'container wood', mats: { c: 'crate' }, parts: [['box','c',[0,0,0],[15,15,14]]] },\ntable: { about: 'plank table, four legs', tags: 'furniture tavern', mats: { t: 'oak', l: 'walnut' },\n  parts: [['box','t',[0,0,10],[24,14,2]], ['mirror','xy',['box','l',[10,5,0],[2,2,10]]]] },\nchest: { about: 'oak chest, round lid, iron bands', tags: 'container treasure', mats: { w: 'oak', b: 'iron', l: 'gold' },\n  parts: [['box','w',[0,0,0],[16,10,8]], ['prism','w',[0,0,8],[[-5,0],[5,0],[4,3],[0,5],[-4,3]],16,{axis:'x'}],\n    ['mirror','x',['box','b',[5.5,0,0],[1.5,11,8.5]]], ['box','l',[0,5,5],[3,1,3]]] },\nlamppost: { about: 'iron street lamp, glowing head', tags: 'town light', mats: { m: 'iron', g: 'flame' }, lights: [[0,0,40,'#ffd070',70]],\n  parts: [['cyl','m',[0,0,0],2.5,3], ['cyl','m',[0,0,3],1,34], ['box','g',[0,0,37],[4,4,5]], ['cyl','m',[0,0,42],3.5,3,{r2:0,seg:4}]] },\nfence: { about: 'rail fence, len long (16)', tags: 'village farm', mats: { w: 'oak' }, params: { len: 16 },\n  make: p => [['mirror','x',['box','w',[p.len / 2 - 1,0,0],[2,2,12]]], ['row',2,[0,0,5],['box','w',[0,0,6],[p.len - 2,1,1.5]]]] },\n```\n\nA generator seeds its noise from its params (`E.rng(seed)`), never `Math.random`, so it draws the same pixels everywhere.\n\n## Make one: the recipe\n\n1. **Read this card whole.**\n2. **Find** the nearest entry: `node tools/asset-find.mjs \"tavern table\"` searches the core library and the store's sets\n   (`src/assets/sets/`, about a thousand objects, materials and sprites converted from CC0 libraries, each with where it\n   came from) and `--show set:id` prints one; the Asset Lab (`/asset-lab`) shows them all.\n3. **Copy** it and change its names, parts and materials, or write a new one from the parts above. Give the cue a player\n   knows it by parts of its own (a skep's coils as stacked rings, an anvil's horn, a barrow's open tub dark inside), and\n   keep small parts plain ('none', 'glaze'): a busy pattern on a part a few pixels wide reads as speckle.\n4. **Look:** `node tools/asset-sheet.mjs mine.js#stool` (a file that sets `E.SHAPES.stool`, or a store set; a core id\n   alone works too: `node tools/asset-sheet.mjs barrel`). It draws `check-output/asset-sheet/stool.png`: every view and\n   four facings, beside the hero, on a light and a dark floor. It lints what reads badly: too small from above, a part\n   under a pixel, too few tones, low contrast with the floor, its tokens. Read the picture, fix, repeat.\n5. **Use** it: `E.SHAPES.stool = {...}` and `r.shape('stool', ...)`; or a set file\n   (`(window.ASSETS = window.ASSETS || {}).MINE = { set: 'MINE', format: 1, materials, shapes }`) and\n   `E.addAssets(window.ASSETS.MINE)`, which names its entries 'MINE:stool' so they never collide, and returns the names.\n   A store set loads the same way (its script, then `E.addAssets(window.ASSETS['kenney-furniture'])`);\n   `node tools/asset-set.mjs <sets> --ids a,b --name mine --out mine.js` cuts the few a game uses, with what they need\n   (Emberdeep's set dressing loads `src/assets/sets/emberdeep.js`, cut so).\n\n## Limits\n\n- Still objects. Lids that open, swinging signs and held weapons are code (or props) for now.\n- A shape sorts by one point, as props do; a long one (a bed, a cart) may cross a body walking right beside it.\n- Collision is the footprint's box, turned with the shape, and the bounds' height: a table is solid under its top too.\n- Bigger than about 240 pixels on screen, a shape skips the actors' effects (flash, x-ray).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"wc -l vendor/hub/lib/hub/README.md vendor/engine/dist/handoff/kits/artillery.js && sed -n '1,225p' vendor/hub/lib/hub/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"wc -l vendor/hub/lib/hub/README.md vendor/engine/dist/handoff/kits/artillery.js && sed -n '1,225p' vendor/hub/lib/hub/README.md\"","aggregated_output":"  412 vendor/hub/lib/hub/README.md\n  572 vendor/engine/dist/handoff/kits/artillery.js\n  984 total\n# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card, longer if one asks for more time: what\n   the game is, how to win, the controls. The card is the hub's, from the\n   game's tags, or the game's own (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. A player can ask for more time, which adds\nten seconds; while more than half of them are asking, the countdown holds.\nBy default the hub shows its own card over the game. A game can make the\ncard its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '225,430p' vendor/hub/lib/hub/README.md && cat vendor/hub/lib/hub/examples/arena.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '225,430p' vendor/hub/lib/hub/README.md && cat vendor/hub/lib/hub/examples/arena.html\"","aggregated_output":"\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n| `hub:session-goal` | how to win, shown on the hub's card |\n| `hub:session-howto` | the controls, shown on the hub's card |\n| `hub:session-minutes` | optional: how many minutes a round takes |\n| `hub:webgpu` | optional: `required` when the game cannot run without WebGPU |\n\n### API\n\n| | |\n|---|---|\n| `AIHub.active` | `true` in a session, from the first line |\n| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n| `AIHub.ready()` | once, when the round can start |\n| `AIHub.answer('ready' \\| 'more')` | on the game's own card, before `start` |\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\nread them.\n\n| Event | Arguments |\n|---|---|\n| `card` | `{ left, paused, starting, ready, asking, asked }`, with the game's own card |\n| `start` | `{ in }`: milliseconds until play begins |\n| `message` | `data, from` |\n| `leave` | `{ id, reason }` |\n| `time-up` | `{ graceMs }` |\n| `end` | `{ reason, standings }` |\n\nEvents that arrive before a handler is attached are kept, and delivered in\norder when the first handler is attached. Fields and events a newer hub adds\nreach the game through the client unchanged.\n\n### Versions\n\nThis is protocol **1**, client **1.4.0**. Changes within version 1 only add:\ngames on older clients keep working. A change that would break a game becomes\nprotocol 2, with its own `hub:session` value.\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Star Arena — AI Hub session example (shared world)</title>\n<meta name=\"description\" content=\"A minimal shared-world game for the AI Hub Session Protocol: every copy moves its own player, the host runs the stars and the scores, first to ten wins.\">\n<meta name=\"theme-color\" content=\"#1b1530\">\n<meta name=\"hub:type\" content=\"Tech demo\">\n<meta name=\"hub:players\" content=\"1\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"2-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-minutes\" content=\"2\">\n<meta name=\"hub:session-goal\" content=\"First to ten stars wins\">\n<meta name=\"hub:session-howto\" content=\"Move: arrows, WASD or a stick · sprint: Space or Cross · or hold a finger\">\n<style>\n  html, body { margin: 0; height: 100%; background: #1b1530; color: #f3eef7; font: 16px system-ui, sans-serif; overflow: hidden; }\n  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n</style>\n<script>\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n        return k in data || k in t;\n      },\n      deleteProperty: function (t, k) {\n        delete data[k];\n        return true;\n      },\n      ownKeys: function () {\n        return Object.keys(data);\n      },\n      getOwnPropertyDescriptor: function (t, k) {\n        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n      },\n    });\n  }\n\n  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n  function generator(a) {\n    return function () {\n      a = (a + 0x6d2b79f5) >>> 0;\n      var t = a;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  // A fair start: in a session the game gets an empty storage of its own, so\n  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n  // and nothing the round saves touches the player's own saves.\n  if (hub.active) {\n    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n      try {\n        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n      } catch (e) {\n        warn('could not give the game a fresh ' + stores[s]);\n      }\n    }\n  }\n\n  // Side by side: before any of the game's own scripts run, Math.random becomes\n  // a generator seeded by the hub, so every copy builds the same start.\n  var realRandom = Math.random;\n  var seededRandom = null;\n  if (hub.active && seedArg) {\n    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n    hub.seeded = true;\n  }\n\n  // In a session the hub owns fullscreen: a game that asks for it gets the\n  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n  // hub says when its page goes in and out, so the game's own toggle and its\n  // fullscreenchange listeners work as they always did.\n  var fullscreenOn = false;\n  if (hub.active && root.Element && root.document) {\n    var asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n    };\n    var proto = root.Element.prototype;\n    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n    var shown = function () {\n      return fullscreenOn ? root.document.documentElement || null : null;\n    };\n    try {\n      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n    } catch (e) {}\n  }\n\n  /**\n   * No hub after all: play on, with Math.random the page's own again. The\n   * empty storage stays: the game has read it already, and what it writes\n   * must never land on the player's real saves.\n   */\n  function standAlone() {\n    hub.active = false;\n    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n    hub.seeded = false;\n  }\n\n  var origin = '*';\n  var welcomed = false;\n  var ended = false;\n  var connecting = null;\n  var goAt = null;\n  var sentReady = false;\n  var reported = false;\n  var handlers = {};\n  var pending = {};\n  var tokens = limits.burst;\n  var refilled = now();\n  var probeFn = null;\n  var lastProgress = -Infinity;\n  var nextProgress = null;\n  var progressTimer = null;\n\n  function now() {\n    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n  }\n\n  function warn(text) {\n    if (root.console) root.console.warn('[AIHub] ' + text);\n  }\n\n  function own(o, k) {\n    return Object.prototype.hasOwnProperty.call(o, k);\n  }\n\n  /** This client's own fields, which no welcome may overwrite. */\n  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n\n  /** A plain JSON copy, or undefined when it is not JSON. */\n  function json(value) {\n    try {\n      var text = JSON.stringify(value);\n      return text === undefined ? undefined : JSON.parse(text);\n    } catch (e) {\n      return undefined;\n    }\n  }\n\n  function post(type, fields) {\n    var msg = { aihub: 1, type: type };\n    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n    try {\n      root.parent.postMessage(msg, origin);\n    } catch (e) {\n      warn('could not reach the hub: ' + e.message);\n    }\n  }\n\n  function emit(type, args) {\n    var list = handlers[type];\n    if (!list || !list.length || pending[type]) {\n      (pending[type] = pending[type] || []).push(args);\n      return;\n    }\n    for (var i = 0; i < list.length; i++) {\n      try {\n        list[i].apply(null, args);\n      } catch (e) {\n        setTimeout(function () {\n          throw e;\n        });\n      }\n    }\n  }\n\n  function onMessage(event) {\n    if (event.source !== root.parent) return;\n    var m = event.data;\n    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n    if (m.type === 'welcome') {\n      if (welcomed) return;\n      welcomed = true;\n      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n      for (var key in m) {\n        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n        hub[key] = m[key];\n      }\n      hub.players = (m.players || []).slice();\n      hub.seed = m.seed >>> 0;\n      hub.isHost = m.me === m.host;\n      hub.splash = m.splash === true;\n      if (m.limits) {\n        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n        tokens = limits.burst;\n      }\n      if (connecting) connecting.resolve(info());\n      return;\n    }\n    if (m.type === 'fullscreen') {\n      fullscreenOn = m.on === true;\n      try {\n        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n      } catch (e) {}\n      return;\n    }\n    if (!welcomed || ended) return;\n    if (m.type === 'start') {\n      goAt = now() + Number(m.in || 0);\n      emit('start', [{ in: Number(m.in || 0) }]);\n    } else if (m.type === 'message') {\n      emit('message', [m.data, m.from]);\n    } else if (m.type === 'leave') {\n      hub.players = hub.players.filter(function (p) {\n        return p.id !== m.id;\n      });\n      emit('leave', [{ id: m.id, reason: m.reason }]);\n    } else if (m.type === 'time-up') {\n      emit('time-up', [{ graceMs: m.graceMs }]);\n    } else if (m.type === 'end') {\n      ended = true;\n      if (progressTimer) clearTimeout(progressTimer);\n      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n    } else {\n      // An event this client has never heard of: hand it on as it came.\n      var detail = {};\n      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n      emit(m.type, [detail]);\n    }\n  }\n\n  function info() {\n    var out = {};\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n    out.players = hub.players.slice();\n    return out;\n  }\n\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n  hub.connect = function (opts) {\n    if (connecting) return connecting.promise;\n    var done;\n    var promise = new Promise(function (resolve) {\n      done = resolve;\n    });\n    connecting = { promise: promise, resolve: done };\n    if (!hub.active) {\n      done(null);\n      return promise;\n    }\n    opts = opts || {};\n    root.addEventListener('message', onMessage);\n    var started = now();\n    var hello = function () {\n      if (welcomed) return;\n      if (now() - started > HELLO_TIMEOUT_MS) {\n        standAlone();\n        warn('no hub answered; playing normally');\n        done(null);\n        return;\n      }\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n      setTimeout(hello, HELLO_EVERY_MS);\n    };\n    hello();\n    return promise;\n  };\n\n  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n  hub.ready = function () {\n    if (!welcomed || sentReady || ended) return;\n    sentReady = true;\n    post('ready', {});\n  };\n\n  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n  hub.answer = function (what) {\n    if (!welcomed || ended || goAt !== null) return;\n    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n    post('answer', { answer: what });\n  };\n\n  hub.on = function (type, fn) {\n    (handlers[type] = handlers[type] || []).push(fn);\n    if (pending[type] && !pending[type].flushing) {\n      pending[type].flushing = true;\n      setTimeout(function () {\n        var queued = pending[type];\n        delete pending[type];\n        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n      });\n    }\n    return function () {\n      var list = handlers[type] || [];\n      var at = list.indexOf(fn);\n      if (at !== -1) list.splice(at, 1);\n    };\n  };\n\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n      h ^= s.charCodeAt(i);\n      h = Math.imul(h, 16777619);\n    }\n    return generator((hub.seed ^ h) >>> 0);\n  };\n\n  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n  function finite(v) {\n    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n  hub.fail = function (message) {\n    if (!hub.active) return;\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n  };\n\n  root.AIHub = hub;\n})(typeof window !== 'undefined' ? window : globalThis);\n</script>\n</head>\n<body>\n<canvas id=\"c\" aria-label=\"Star Arena\"></canvas>\n<script>\n'use strict';\n// Star Arena: the smallest honest shared-world game, the plain form of \"Shared\n// world\" (lib/hub/README.md): the host runs the world. Every copy moves its own\n// player from its own stick, at once, and never waits for the network to do\n// it. The host's copy runs only what is shared, the star and the scores:\n//   me     each other copy → the host, ~15 a second, unreliable: where my player is\n//   s      the host → everyone, ~15 a second, unreliable: every player, its score, the star\n//   claim  a copy → the host, reliable, once a star: my player touched star n\n//   pick   the host → everyone, reliable: player id took star n\n// The host takes each player where it says it is, and a claim scores unless\n// someone else got there first. A last snapshot, reliable, ends the round.\n// The host may be a server, a copy with no player of its own (AIHub.server):\n// it runs the same host code, moves nobody and draws nothing.\n// First to TARGET stars wins.\nconst W = 800, H = 600, R = 18, SPEED = 260, TARGET = 10;\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nconst keys = new Set();\nlet pointer = null;\nlet audio = null;\n\naddEventListener('keydown', (e) => {\n  if (e.key === 'Escape') return toggleMenu();\n  if (menu.open) return menuKey(e.key);\n  keys.add(e.key.toLowerCase());\n  gesture();\n});\naddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\ncanvas.addEventListener('pointerdown', (e) => { pointer = e; gesture(); });\ncanvas.addEventListener('pointermove', (e) => { if (pointer) pointer = e; });\naddEventListener('pointerup', () => { pointer = null; });\n\nfunction beep(freq) {\n  if (!audio || muted) return;\n  const o = audio.createOscillator(), g = audio.createGain();\n  o.frequency.value = freq; g.gain.value = 0.05;\n  o.connect(g).connect(audio.destination);\n  o.start(); o.stop(audio.currentTime + 0.08);\n}\n\n// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n// Cross 0, Circle 1, Triangle 3, Create 8, Options 9, D-pad 12-15, left stick\n// axes 0 and 1). Buttons count on the frame they go down.\nconst PAD = { cross: 0, circle: 1, triangle: 3, create: 8, options: 9, up: 12, down: 13 };\nlet pad = null, padNow = [], padWas = [];\nfunction readPad() {\n  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n  padWas = padNow;\n  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n  if (menu.open) {\n    if (pressed(PAD.up)) menuKey('ArrowUp');\n    if (pressed(PAD.down)) menuKey('ArrowDown');\n    if (pressed(PAD.cross)) menuKey('Enter');\n    if (pressed(PAD.circle)) toggleMenu();\n  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n}\nconst pressed = (b) => !!padNow[b] && !padWas[b];\n\n// ---- the settings menu: Esc or Options, over the running game. It never\n// pauses anything; while it is open your player simply stands still.\nlet muted = false;\nconst menu = {\n  open: false,\n  at: 0,\n  items: [\n    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n    { label: () => 'Back to the game', act: () => toggleMenu() },\n  ],\n};\nfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\nfunction menuKey(key) {\n  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n}\n\n/** The local stick: keys, the first gamepad, or a held pointer. Still while the menu is open. */\nfunction stick(me) {\n  if (menu.open) return { x: 0, y: 0, sprint: false };\n  let x = 0, y = 0;\n  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n  if (keys.has('arrowright') || keys.has('d')) x += 1;\n  if (keys.has('arrowup') || keys.has('w')) y -= 1;\n  if (keys.has('arrowdown') || keys.has('s')) y += 1;\n  if (pad) {\n    if (Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n    if (Math.abs(pad.axes[1]) > 0.2) y = pad.axes[1];\n    if (padNow[12]) y = -1;\n    if (padNow[13]) y = 1;\n    if (padNow[14]) x = -1;\n    if (padNow[15]) x = 1;\n  }\n  if (pointer && me) {\n    const p = toWorld(pointer);\n    const dx = p.x - me.x, dy = p.y - me.y, d = Math.hypot(dx, dy);\n    if (d > 8) { x = dx / d; y = dy / d; }\n  }\n  const sprint = keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7];\n  const len = Math.hypot(x, y);\n  return len > 1 ? { x: x / len, y: y / len, sprint } : { x, y, sprint };\n}\n\nfunction toWorld(e) {\n  const r = canvas.getBoundingClientRect(), s = Math.min(r.width / W, r.height / H);\n  return { x: (e.clientX - r.left - (r.width - W * s) / 2) / s, y: (e.clientY - r.top - (r.height - H * s) / 2) / s };\n}\n\n// ---- state shared by both modes\nconst game = {\n  phase: 'title',            // title | waiting | playing | over\n  players: [],               // {id, name, color, x, y, score, gone}, drawn at x, y\n  star: { x: W / 2, y: H / 2, n: 0 },   // n numbers the stars, so a claim names the one it touched\n  rng: Math.random,\n  message: '',\n  standings: null,\n};\nlet felt = { x: 0, y: 0, sprint: false };   // the local stick as last read\n\nfunction place(players) {\n  players.forEach((p, i) => {\n    const a = (i / Math.max(players.length, 1)) * Math.PI * 2;\n    p.tx = p.x = W / 2 + Math.cos(a) * 200; p.ty = p.y = H / 2 + Math.sin(a) * 180;\n  });\n}\nfunction newStar() {\n  game.star = { x: 40 + game.rng() * (W - 80), y: 40 + game.rng() * (H - 80), n: game.star.n + 1 };\n}\n\n/** Your own player, from your own stick. Every copy moves its own, every frame, host or not. */\nfunction move(p, s, dt) {\n  const speed = SPEED * (s.sprint ? 1.5 : 1);\n  p.x = Math.max(R, Math.min(W - R, p.x + s.x * speed * dt));\n  p.y = Math.max(R, Math.min(H - R, p.y + s.y * speed * dt));\n}\nconst touching = (p) => Math.hypot(p.x - game.star.x, p.y - game.star.y) < R + 12;\n\n// ---- solo: the game as it plays on its own\nfunction solo() {\n  game.players = [{ id: 0, name: 'You', color: '#f5b700', x: W / 2, y: H / 2, score: 0 }];\n  game.phase = 'title';\n  game.message = 'Star Arena — press any key or tap to play';\n}\nlet soloEnds = 0;\n\n// ---- hub mode. Every other player also has tx, ty: where it last said it is\n// (and on the host, at: when). It is drawn easing toward there; your own player\n// is drawn where you put it.\nlet hub = null;\nlet lastSent = 0;\nlet lastSnap = -Infinity;    // the newest snapshot taken, by its AIHub.time()\nlet claimed = -1;            // the star this copy claimed last: one claim a star\n\nasync function connect() {\n  const info = await AIHub.connect({ mode: 'shared-world', seats: [2, 4] });\n  if (!info) return solo();\n  hub = info;\n  game.rng = AIHub.rng('stars');\n  game.players = info.players.map((p) => ({ ...p, x: 0, y: 0, score: 0, gone: false, at: -Infinity }));\n  place(game.players);\n  newStar();                 // the first star comes from the seed: the same on every copy\n  // The hub's card collects everyone's ready: ready up as soon as the arena is built.\n  game.phase = 'waiting';\n  game.message = 'Get ready…';\n  AIHub.ready();\n  AIHub.on('start', () => { game.phase = 'playing'; unlockAudio(); });\n  AIHub.on('message', (data, from) => {\n    if (hub.isHost && data.t === 'me') heard(from, data);\n    if (hub.isHost && data.t === 'claim') take(from, data.n);\n    if (from === hub.host && data.t === 's') applySnapshot(data);\n    if (from === hub.host && data.t === 'pick' && data.id !== hub.me) beep(330);   // your own cheered at the claim\n  });\n  AIHub.on('leave', ({ id }) => {\n    const p = game.players.find((q) => q.id === id);\n    if (p) p.gone = true;\n    if (hub.isHost && game.phase === 'playing' && game.players.filter((q) => !q.gone).length < 2) finish();\n  });\n  AIHub.on('time-up', () => { if (hub.isHost) finish(); });\n  AIHub.on('end', ({ reason, standings }) => {\n    game.phase = 'over';\n    game.standings = standings;\n    game.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n  });\n}\nconst inside = (v, max) => Math.max(R, Math.min(max - R, Number(v) || 0));\n\n/** Host: a player says where it is, and there it is, unless an older report arrived late. */\nfunction heard(id, m) {\n  const p = game.players.find((q) => q.id === id);\n  if (!p || !(m.at > p.at)) return;\n  p.at = m.at; p.tx = inside(m.x, W); p.ty = inside(m.y, H);\n}\n\n/** Host: player id touched star n. It scores, unless someone else got there first. */\nfunction take(id, n) {\n  const p = game.players.find((q) => q.id === id);\n  if (game.phase !== 'playing' || !p || p.gone || n !== game.star.n) return;\n  p.score++;\n  newStar();\n  beep(id === hub.me ? 660 : 330);\n  AIHub.send({ t: 'pick', id, n });\n  if (p.score >= TARGET) finish();\n}\n\n/** Host: one snapshot for everyone: every player still here with its score, and the star. */\nfunction snapshot() {\n  const spot = (p) => (p.id === hub.me ? [p.x, p.y] : [p.tx, p.ty]);   // the others: where they said\n  return {\n    t: 's',\n    at: Math.round(AIHub.time()),\n    p: game.players.filter((p) => !p.gone).map((p) => [p.id, ...spot(p).map(Math.round), p.score]),\n    s: [Math.round(game.star.x), Math.round(game.star.y), game.star.n],\n  };\n}\n\n/** Not the host: take the scores, the star and the other players from the snapshot, never your own player. */\nfunction applySnapshot(s) {\n  if (s.at < lastSnap) return;   // unreliable: an older one that arrived late\n  lastSnap = s.at;\n  for (const [id, x, y, score] of s.p) {\n    const p = game.players.find((q) => q.id === id);\n    if (!p) continue;\n    p.score = score;\n    if (id !== hub.me) { p.tx = x; p.ty = y; }\n  }\n  game.star = { x: s.s[0], y: s.s[1], n: s.s[2] };\n  if (s.over) { game.phase = 'over'; game.message = 'Round over'; }\n}\n\n/** Host: standings by score, ties together, best first. A last snapshot, reliable, ends every copy on the same scores. */\nfunction finish() {\n  if (game.phase === 'over') return;\n  AIHub.send({ ...snapshot(), over: 1 });\n  const live = game.players.filter((p) => !p.gone).sort((a, b) => b.score - a.score);\n  const standings = [];\n  for (const p of live) {\n    const last = standings[standings.length - 1];\n    if (last && last.score === p.score) last.ids.push(p.id);\n    else standings.push({ score: p.score, ids: [p.id] });\n  }\n  const scores = Object.fromEntries(game.players.map((p) => [p.id, p.score]));\n  AIHub.finish({ standings: standings.map((g) => g.ids), scores });\n  game.phase = 'over';\n  game.message = 'Round over';\n}\n\nfunction unlockAudio() {\n  if (!audio) {\n    try { audio = new AudioContext(); } catch { audio = null; }\n  }\n  audio?.resume?.().catch(() => {});\n}\n\nfunction gesture() {\n  unlockAudio();\n  if (!hub && (game.phase === 'title' || game.phase === 'over')) {\n    solo();\n    game.phase = 'playing';\n    soloEnds = performance.now() + 60_000;\n  }\n}\n\n// ---- the loop: advance by elapsed time, never pause\nlet last = performance.now();\nfunction frame(now) {\n  const dt = Math.min((now - last) / 1000, 0.25);\n  last = now;\n  readPad();\n  const me = game.players.find((p) => p.id === (hub ? hub.me : 0));\n  felt = stick(me);\n  if (game.phase === 'playing' && (!hub || AIHub.time() >= 0)) {\n    if (me) move(me, felt, dt);   // now, on every copy: your controls never wait for the network\n    if (hub) play(now, dt, me);\n    else {\n      if (touching(me)) { me.score++; newStar(); beep(660); }\n      if (now > soloEnds) { game.phase = 'over'; game.message = `Time! ${me.score} stars — press to play again`; }\n    }\n  }\n  if (!hub?.server) draw(now);   // a server runs the world and needs no picture of it\n  requestAnimationFrame(frame);\n}\n\n/** A session frame, after your own move: the star, what this copy sends, and the others eased toward where they are. */\nfunction play(now, dt, me) {\n  if (me && touching(me)) {\n    if (hub.isHost) take(hub.me, game.star.n);\n    else if (claimed !== game.star.n) {\n      // Predict the contact: claim the star once, hide it and cheer now. The host decides the point.\n      claimed = game.star.n;\n      AIHub.send({ t: 'claim', n: claimed }, { to: hub.host });\n      beep(660);\n    }\n  }\n  if (game.phase === 'playing' && now - lastSent > 66) {\n    lastSent = now;\n    if (hub.isHost) AIHub.send(snapshot(), { reliable: false });\n    else AIHub.send({ t: 'me', at: Math.round(AIHub.time()), x: Math.round(me.x), y: Math.round(me.y) }, { to: hub.host, reliable: false });\n  }\n  const k = 1 - Math.pow(0.001, dt);\n  for (const p of game.players) if (p !== me) { p.x += (p.tx - p.x) * k; p.y += (p.ty - p.y) * k; }\n}\n\nfunction draw(now) {\n  const r = canvas.getBoundingClientRect();\n  const dpr = devicePixelRatio || 1;\n  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n  }\n  const s = Math.min(canvas.width / W, canvas.height / H);\n  ctx.setTransform(1, 0, 0, 1, 0, 0);\n  ctx.fillStyle = '#120e22'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n  ctx.fillStyle = '#1b1530'; ctx.fillRect(0, 0, W, H);\n\n  if (game.star.n !== claimed) {   // a star you claimed is gone here until the host's next one arrives\n    ctx.fillStyle = '#ffd34d';\n    ctx.beginPath(); ctx.arc(game.star.x, game.star.y, 10 + Math.sin(now / 150) * 2, 0, Math.PI * 2); ctx.fill();\n  }\n\n  ctx.textAlign = 'center';\n  for (const p of game.players) {\n    if (p.gone) continue;\n    ctx.fillStyle = p.color;\n    ctx.beginPath(); ctx.arc(p.x, p.y, R, 0, Math.PI * 2); ctx.fill();\n    ctx.fillStyle = '#f3eef7'; ctx.font = '14px system-ui';\n    ctx.fillText(`${p.name} ${p.score}`, p.x, p.y - R - 8);\n  }\n\n  ctx.font = '22px system-ui';\n  ctx.fillStyle = '#f3eef7';\n  if (hub && game.phase === 'playing' && AIHub.time() < 0) {\n    ctx.font = 'bold 96px system-ui';\n    ctx.fillText(String(Math.ceil(-AIHub.time() / 1000)), W / 2, H / 2 + 32);\n  } else if (game.phase !== 'playing') {\n    ctx.fillStyle = 'rgba(0,0,0,.55)'; ctx.fillRect(0, H / 2 - 120, W, 240);\n    ctx.fillStyle = '#f3eef7';\n    ctx.fillText(game.message, W / 2, H / 2 - 70);\n    const rows = game.standings\n      ? game.standings.flatMap((ids, place) => ids.map((id) => [place + 1, game.players.find((p) => p.id === id)]))\n      : game.players.map((p) => [null, p]);\n    ctx.font = '18px system-ui';\n    rows.slice(0, 4).forEach(([place, p], i) => {\n      if (!p) return;\n      ctx.fillStyle = p.color;\n      ctx.fillText(`${place ? place + '. ' : ''}${p.name}${hub && p.id === hub.me ? ' (you)' : ''} — ${p.score}`, W / 2, H / 2 - 30 + i * 28);\n    });\n  }\n  if (menu.open) drawMenu();\n}\n\nfunction drawMenu() {\n  ctx.fillStyle = 'rgba(10,8,20,.82)'; ctx.fillRect(W / 2 - 170, 150, 340, 70 + menu.items.length * 40);\n  ctx.textAlign = 'center';\n  ctx.fillStyle = '#f3eef7'; ctx.font = 'bold 22px system-ui';\n  ctx.fillText('Settings', W / 2, 186);\n  ctx.font = '18px system-ui';\n  menu.items.forEach((item, i) => {\n    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#f3eef7';\n    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 226 + i * 40);\n  });\n}\n\nconnect();\nrequestAnimationFrame(frame);\n</script>\n</body>\n</html>\n","exit_code":0,"status":"completed"}}
