iew.arc=false;view.debug=false;\n app.ais=mode==='\"'local'?[null,null]:[null,createAI(mode==='tour'?RIVALS[bout]:RIVALS[{Rookie:0,Sporting:4,Royal:9}[game.settings.difficulty]])];\n app.lessonShot=app.world.coverage.launch[0];app.lessonBaseline=app.world.coverage.castle;\n app.setSeats(mode==='local'?game.settings.seats:'Solo');\n app.caption=mode==='local'?'Two players. One clock. No taking turns.':(mode==='tour'?RIVALS[bout].quote:app.world.courtDef.boast);app.captionUntil=game.real+5;\n shell.hide();game.go('combat',null,{fade:0});audio.music(court);app.resultCount=0;return app.world;\n };\n app.setSeats=kind=>{if(game.players.length>1)game.removePlayer(2);game.input.use(INPUT);game.input.pad='any';game.input.keysTo=null;\n if(kind==='Solo')return;\n const p2=game.addPlayer({pad:kind==='Two pads'?1:kind==='Keyboard + pad'?0:undefined});\n p2.use({...INPUT,fire:kind==='Two keyboards'?['ShiftRight']:['Pad0'],previous:kind==='Two keyboards'?['KeyU']:['Pad4'],next:kind==='Two keyboards'?['KeyO']:['Pad5'],abort:kind==='Two keyboards'?['KeyI']:['Pad1'],fire2:[],previous2:[],next2:[]});\n p2.pad=kind==='Two keyboards'?null:kind==='Two pads'?1:0;\n game.input.pad=kind==='Two pads'?0:null;\n if(kind==='Two pads')game.input.use({...INPUT,fire:['Pad0'],previous:['Pad4'],next:['Pad5'],abort:['Pad1']});\n game.input.keysTo=kind==='Two keyboards'?[p2]:null;\n p2.names={fire:'P2 hold / release',previous:'P2 previous stone',next:'P2 next stone',abort:'P2 cancel',fire2:false,previous2:false,next2:false};\n clearInputs();};\n app.title=()=>{if(app.online)return;app.fresh();app.mode='title';app.tour=null;app.idleTicks=0;app.setSeats('Solo');app.world=createWorld({mode:'title',court:0});view.reset(app.world);game.go('title',null,{fade:0});audio.music(0);app.showTitle();};\n app.showTitle=()=>{const save=loadTour(app.storage);shell.hide();shell.show('title',{kicker:'THE ROYAL DEMOLITION SOCIETY PRESENTS',name:'SMITHEREENS\\\\nUNDER SIEGE',subtitle:'A right royal demolition derby',te