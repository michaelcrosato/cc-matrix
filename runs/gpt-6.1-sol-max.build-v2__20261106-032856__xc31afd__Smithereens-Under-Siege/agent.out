{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cat > tests/network.test.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport { OnlineMatch } from '../src/online.js';\nimport { pack,health } from '../src/sim.js';\nexport async function run(check){\n await check('Hub authority without local seat, jitter/loss/reorder, passive ACK and rejected command retry',async()=>{\n let ms=-3000,packet=0,reject=2,finished=0,deliveries=[],all=[],lastDue=new Map();const records=[],sent=[],players=[{id:0,name:'Teal'},{id:1,name:'Coral'}];\n function hub(me,server){const handlers=new Map(),h={active:true,me,server,players,host:2,isHost:me===2,seed:71,limitMs:180000,\n connect:async()=>({me,server,players,host:2,isHost:me===2,seed:71,limitMs:180000}),\n on:(event,fn)=>{handlers.set(event,fn);return()=>handlers.delete(event);},ready(){},time:()=>ms,\n send(data,opts={}){if(data.t==='c'&&reject-->0)return false;const k=++packet,reliable=opts.reliable\"'!==false;if(!reliable&&k%7===0)return true;\n const delay=me===1?data.t==='\"'c'&&data.c.kind==='begin'?220:80:130+(k%5-2)*25;\n let due=ms+delay;if(reliable){const key=me+':'+opts.to;due=Math.max(due,(lastDue.get(key)||-Infinity)+1);lastDue.set(key,due);}\n deliveries.push({due,me,data:structuredClone(data),to:opts.to});sent.push({ms,me,bytes:JSON.stringify(data).length,type:data.t});return true;},\n finish(data){finished++;records.push(data);for(const h of all)deliveries.push({due:ms+400,ending:true,h});},emit:(ev,...args)=>handlers.get(ev)?.(...args)};return h;}\n const hubs=[hub(2,true),hub(0,false),hub(1,false)];all=hubs;\n const nets=hubs.map(h=>new OnlineMatch(h));for(const n of nets){n.transport.clock=()=>ms;n.transport.refill=ms;await n.connect();}\n hubs.forEach(h=>h.emit('start'));\n let launched=[];nets[0].onEvent=e=>{if(e.type==='launch')launched.push(e);};\n for(ms=-3000;ms<10500;ms+=10){\n  if(ms===1000)nets[2].intent('begin');if(ms===1900)nets[2].intent('release');\n  for(const a of deliveries.filter(a=>a.due<=ms)){if(a.ending)a.h.emit('end',{reason:'finished'});else for(const h of hubs)if(h.me\"'!==a.me&&(a.to===undefined||a.to===h.me))h.emit('\"'message',a.data,a.me);}\n  deliveries=deliveries.filter(a=>a.due>ms);\n  for(const n of nets)n.update();\n  if(ms===9000)hubs[0].emit('time-up',{graceMs:5000});\n }\n assert.equal(nets[0].seat,null);assert.equal(nets[0].world.coverage.launch[0],1);assert.equal(launched.length,1);assert.ok(Math.abs(launched[0].power-.9/1.4)<.025);\n assert.ok(nets[0].ack>=0);assert.ok(nets[1].transport.metrics.sent>0&&nets[2].transport.metrics.sent>0);assert.ok(nets[2].transport.metrics.retries>=2);\n assert.equal(finished,1);assert.deepEqual(records[0].standings.flat().sort(),[0,1]);assert.ok(nets.every(n=>n.ended&&n.transport.stopped));assert.ok(nets.every(n=>n.transport.metrics.maxBytes<=16000&&n.transport.metrics.maxSnapshot<=1200));\n assert.deepEqual(nets[0].world.castles.map(bs=>bs.map(b=>b.hp>0)),nets[2].world.castles.map(bs=>bs.map(b=>b.hp>0)));\n const after=sent.length;for(const n of nets){n.intent('begin');n.update();}assert.equal(sent.length,after);\n });\n await check('stale baseline is acknowledged even when a later snapshot already arrived',async()=>{\n const send=[],hub={connect:async()=>({me:1,server:false,players:[{id:0},{id:1}],host:0,isHost:false,seed:71}),on(){return()=>{};},ready(){},time:()=>1000,send(d){send.push(d);return true;}};\n const n=new OnlineMatch(hub);await n.connect();n.lastSeq=10;n.message({...pack(n.world,3),t:'b'},0);n.transport.flush();assert.ok(send.some(s=>s.t==='ack'&&s.n===3));const old=n.world.tick;n.message({...pack(n.world,20),k:500},99);assert.equal(n.world.tick,old);\n });\n}\nEOF\npython3 - <<'PY'\np='scripts/verify.mjs';s=open(p).read().replace(\\\"await (await import('../tests/sim.test.mjs')).run(check);\\\", \\\"await (await import('../tests/sim.test.mjs')).run(check);await (await import('../tests/network.test.mjs')).run(check);\\\");open(p,'w').write(s)\nPY\nnode --input-type=module <<'JS'\nimport {run} from './tests/network.test.mjs';let n=0,f=0;await run(async(name,fn)=>{n++;try{await fn();}catch(e){f++;console.log('FAIL',name,e.stack);}});console.log(\"'`${n} checks, ${f} failures`);\nJS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cat > tests/network.test.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport { OnlineMatch } from '../src/online.js';\nimport { pack,health } from '../src/sim.js';\nexport async function run(check){\n await check('Hub authority without local seat, jitter/loss/reorder, passive ACK and rejected command retry',async()=>{\n let ms=-3000,packet=0,reject=2,finished=0,deliveries=[],all=[],lastDue=new Map();const records=[],sent=[],players=[{id:0,name:'Teal'},{id:1,name:'Coral'}];\n function hub(me,server){const handlers=new Map(),h={active:true,me,server,players,host:2,isHost:me===2,seed:71,limitMs:180000,\n connect:async()=>({me,server,players,host:2,isHost:me===2,seed:71,limitMs:180000}),\n on:(event,fn)=>{handlers.set(event,fn);return()=>handlers.delete(event);},ready(){},time:()=>ms,\n send(data,opts={}){if(data.t==='c'&&reject-->0)return false;const k=++packet,reliable=opts.reliable\"'!==false;if(!reliable&&k%7===0)return true;\n const delay=me===1?data.t==='\"'c'&&data.c.kind==='begin'?220:80:130+(k%5-2)*25;\n let due=ms+delay;if(reliable){const key=me+':'+opts.to;due=Math.max(due,(lastDue.get(key)||-Infinity)+1);lastDue.set(key,due);}\n deliveries.push({due,me,data:structuredClone(data),to:opts.to});sent.push({ms,me,bytes:JSON.stringify(data).length,type:data.t});return true;},\n finish(data){finished++;records.push(data);for(const h of all)deliveries.push({due:ms+400,ending:true,h});},emit:(ev,...args)=>handlers.get(ev)?.(...args)};return h;}\n const hubs=[hub(2,true),hub(0,false),hub(1,false)];all=hubs;\n const nets=hubs.map(h=>new OnlineMatch(h));for(const n of nets){n.transport.clock=()=>ms;n.transport.refill=ms;await n.connect();}\n hubs.forEach(h=>h.emit('start'));\n let launched=[];nets[0].onEvent=e=>{if(e.type==='launch')launched.push(e);};\n for(ms=-3000;ms<10500;ms+=10){\n  if(ms===1000)nets[2].intent('begin');if(ms===1900)nets[2].intent('release');\n  for(const a of deliveries.filter(a=>a.due<=ms)){if(a.ending)a.h.emit('end',{reason:'finished'});else for(const h of hubs)if(h.me\"'!==a.me&&(a.to===undefined||a.to===h.me))h.emit('\"'message',a.data,a.me);}\n  deliveries=deliveries.filter(a=>a.due>ms);\n  for(const n of nets)n.update();\n  if(ms===9000)hubs[0].emit('time-up',{graceMs:5000});\n }\n assert.equal(nets[0].seat,null);assert.equal(nets[0].world.coverage.launch[0],1);assert.equal(launched.length,1);assert.ok(Math.abs(launched[0].power-.9/1.4)<.025);\n assert.ok(nets[0].ack>=0);assert.ok(nets[1].transport.metrics.sent>0&&nets[2].transport.metrics.sent>0);assert.ok(nets[2].transport.metrics.retries>=2);\n assert.equal(finished,1);assert.deepEqual(records[0].standings.flat().sort(),[0,1]);assert.ok(nets.every(n=>n.ended&&n.transport.stopped));assert.ok(nets.every(n=>n.transport.metrics.maxBytes<=16000&&n.transport.metrics.maxSnapshot<=1200));\n assert.deepEqual(nets[0].world.castles.map(bs=>bs.map(b=>b.hp>0)),nets[2].world.castles.map(bs=>bs.map(b=>b.hp>0)));\n const after=sent.length;for(const n of nets){n.intent('begin');n.update();}assert.equal(sent.length,after);\n });\n await check('stale baseline is acknowledged even when a later snapshot already arrived',async()=>{\n const send=[],hub={connect:async()=>({me:1,server:false,players:[{id:0},{id:1}],host:0,isHost:false,seed:71}),on(){return()=>{};},ready(){},time:()=>1000,send(d){send.push(d);return true;}};\n const n=new OnlineMatch(hub);await n.connect();n.lastSeq=10;n.message({...pack(n.world,3),t:'b'},0);n.transport.flush();assert.ok(send.some(s=>s.t==='ack'&&s.n===3));const old=n.world.tick;n.message({...pack(n.world,20),k:500},99);assert.equal(n.world.tick,old);\n });\n}\nEOF\npython3 - <<'PY'\np='scripts/verify.mjs';s=open(p).read().replace(\\\"await (await import('../tests/sim.test.mjs')).run(check);\\\", \\\"await (await import('../tests/sim.test.mjs')).run(check);await (await import('../tests/network.test.mjs')).run(check);\\\");open(p,'w').write(s)\nPY\nnode --input-type=module <<'JS'\nimport {run} from './tests/network.test.mjs';let n=0,f=0;await run(async(name,fn)=>{n++;try{await fn();}catch(e){f++;console.log('FAIL',name,e.stack);}});console.log(\"'`${n} checks, ${f} failures`);\nJS'","aggregated_output":"2 checks, 0 failures\n","exit_code":0,"status":"completed"}}
