{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"rg -n 'draw\\\\(r\\\\)|stroke|outline|debug|chunk' vendor/engine/dist/handoff/modules/terrain.js | tail -24 && sed -n '190,245p' vendor/engine/dist/handoff/modules/terrain.js && sed -n '80,95p' src/app.js\"","aggregated_output":"2:my-3D2dge module TERRAIN v0.89.1: destructible ground in the side plane: carved and added, walked on, drawn in chunks\n10:  false (true: never carved) }, ...], chunk: 64 }). A material's id is its place in the list plus one.\n22:- land.draw(r) draws the chunks on screen as decals (under the bodies), each redrawn only after a change touches it\n44: * and drawing in chunks redrawn only where it changed\n49:  /** new E.Terrain({ w, h, x, y, materials, chunk }): see the manual */\n51:    /** w, h: its size in cells (world units); x, y: its bottom left corner; chunk: the drawn squares' size */\n52:    this.w = o.w || 320; this.h = o.h || 200; this.x = o.x || 0; this.y = o.y || 0; this.chunk = o.chunk || 64;\n55:    /** cells: the mask, row by row from the top (0: air); drawn: how many chunks the last draw painted again */\n70:  // the chunks a cell range touches (and their neighbours' edges) need drawing again\n71:  _touch(c0, r0, c1, r1) { const k = this.chunk; for (let cy = Math.floor((r0 - 4) / k); cy <= Math.floor((r1 + 4) / k); cy++) for (let cx = Math.floor((c0 - 1) / k); cx <= Math.floor((c1 + 1) / k); c [... omitted end of long line]\n139:  /** draw it as decals under the bodies, in the side view (its y is the engine's z); only changed chunks are redrawn */\n140:  draw(r) {\n141:    const k = this.chunk, v = r.game.view, s = v.scale, W = r.game.W, H = r.game.H; this.drawn = 0;\n150:  // one chunk's picture: each cell its material's color, varied a little; the lit top (air above), a dark rim elsewhere\n152:    const k = this.chunk; cv = cv || E.mkCanvas(k, k); const g = E.ctx2d(cv), img = g.createImageData(k, k), D = img.data, W = this.w, C = this.cells;\n app.tools=()=>shell.show('tools',{kicker:'LOCAL TOOLS · RESULTS ARE MARKED',title:'The useful mischief',text:()=>`Tick ${app.world.tick} · ${app.stepOnly?'manual stepping':'normal simulation'} · AI seats ${app.ais.map(a=>a?'AI':'human').join(' / ')}`,actions:[\n ['Restore both castles',()=>{app.world.castles=createWorld({court:app.world.court,customCourt:app.customCourt,config:app.world.config}).castles;app.world.revision++;app.world.cheated=true;shell.toast('Castles restored');}],\n ['Clear airborne stones',()=>{app.world.shots=[];app.world.cheated=true;}],['Skip teaching',()=>{app.lessonDone=true;shell.tutorial(null);}],\n ['Toggle teal AI / human',()=>{app.ais[0]=app.ais[0]?null:createAI({...RIVALS[8],error:0});app.world.cheated=true;app.tools();}],\n ['Toggle coral AI / human',()=>{app.ais[1]=app.ais[1]?null:createAI(RIVALS[8]);app.world.cheated=true;app.tools();}],\n ['Pause / resume simulation',()=>{app.stepOnly=!app.stepOnly;app.tools();}],\n ['Step one fixed tick',()=>{step(app.world);drain();view.update(DT);app.tools();}],\n ['Force teal ceremony',()=>{app.world.cheated=true;finish(app.world,'developer inspection',0);drain();shell.hide();app.resultAt=game.real-2;}],\n ['Force coral ceremony',()=>{app.world.cheated=true;finish(app.world,'developer inspection',1);drain();shell.hide();app.resultAt=game.real-2;}],['Back',()=>shell.back()]]});\n app.editorBlock=()=>{const b=(app.customCourt||app.world.courtDef).blocks;app.editorIndex=clamp(app.editorIndex,0,b.length-1);return b[app.editorIndex];};\n app.editor=(page=0)=>{if(app.online)return;if(!app.customCourt)app.customCourt=JSON.parse(exportCourt(app.world.courtDef)).court;const c=app.customCourt,b=app.editorBlock();view.selection=b;\n for(const [k,v]of [['editorX',b.x],['editorZ',b.z],['editorMaterial',MATERIAL[b.material].name],['editorFoundation',b.foundation]])game.settings.set(k,v);\n const change=delta=>{app.applyEditor();app.editorIndex=(app.editorIndex+delta+c.blocks.length)%c.blocks.length;app.editor(page);};\n const support=c.blocks[(app.editorSupport||0)%c.blocks.length];\n shell.show('editor',{kicker:`COURT WORKSHOP · BLOCK ${b.id} · ${page+1} / 2`,title:page?'Supports & sharing':'Carve your own calamity',text:`${c.name}. Select with the buttons, edit with arrows or pointer, then Apply. Symmetry is automatic. ${b.foundation?'Foundation — not an objective.':'Objective — '+b.support.length+' support links.'}`,rows:page?[]:['editorX','editorZ','editorMaterial','editorFoundation'],actions:page?[\n [`Support target: block ${support.id}`,()=>{app.editorSupport=((app.editorSupport||0)+1)%c.blocks.length;app.editor(1);}],\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/app.js'\ns=open(p).read().replace(\\\"root.id='combat-hud';root.innerHTML\\\", \\\"root.id='combat-hud';root.hidden=true;root.innerHTML\\\")\ns=s.replace(\\\"if(Math.abs(e.movementX)+Math.abs(e.movementY)>1)app.idleTicks=0;\\\", \\\"if(Math.abs(e.movementX)+Math.abs(e.movementY)>1){app.idleTicks=0;if(app.mode==='attract')app.exitAttract();}\\\")\ns=s.replace(\\\"shot=w.coverage.launch.reduce((a,b)=>a+b,0)\\\",\\\"shot=w.coverage.launch.reduce((a,b)=>a+b,0)\\\")\ns=s.replace(\\\"if(app.lesson===0&&shot>app.lessonShot)\\\",\\\"if(app.lesson===0&&w.players[0].launchTick>=0)\\\")\n# Only one active touch per seat, so local multitouch works independently.\ns=s.replace(\\\"if(app.pointers.size)return;e.preventDefault();canvas.setPointerCapture(e.pointerId);const seat=\\\", \\\"e.preventDefault();const seat=\\\")\ns=s.replace(\\\"if(seat===null)return;\\\\n app.pointers.set\\\", \\\"if(seat===null||[...app.pointers.values()].includes(seat))return;canvas.setPointerCapture(e.pointerId);\\\\n app.pointers.set\\\")\n# Direct pointer guidance may highlight the referenced block.\ns=s.replace(\\\"||null;}}});\\\", \\\"||null;view.hover=app.hover;}}});\\\")\nopen(p,'w').write(s)\np='src/style.css';s=open(p).read();s+='\\\\n.esh-ttl>div{margin-left:3vw\"'!important}.esh-ttl h1{font-size:48px!important}.esh-ttl>div:before{font-size:28px;margin-bottom:10px}.esh-ttl .esh-btns{margin-top:12px!important}.esh-ttl .esh-btns button{min-height:34px!important;padding:6px 14px!important}.esh-ttl .esh-sub{margin:12px 0!important}.esh-ttl .esh-m{margin-top:8px!important}'\"\\\\n@media(max-width:800px){.esh-ttl h1{font-size:34px\"'!important}.esh-ttl>div{margin-left:5vw!important}.esh-ttl .esh-btns button{min-height:34px!important}}'\"\\\\n'\nopen(p,'w').write(s)\np='src/view.js';s=open(p).read().replace('h:70,y:-34','h:440,y:-404')\ns=s.replace(\\\"const [,,]=[0,0];\\\",'')\ns=s.replace(\\\"const a=.35-y/400,col=\\\", \\\"const col=\\\")\ns=s.replace(\\\"if(this.selection?.id===b.id&&seat===0)\\\",\\\"if((this.selection?.id===b.id&&seat===0)||this.hover?.id===b.id&&this.hover?.x===b.x)\\\")\nopen(p,'w').write(s)\np='src/sim.js';s=open(p).read().replace(\\\"if(profile.kind==='broad'&&h.stone===2)value+=3;\\\",\\\"if(profile.kind==='broad'&&h.stone===2)value+=3;if(profile.kind==='mason'&&h.stone===1)value+=6;\\\")\nopen(p,'w').write(s)\nPY\nnode scripts/build.mjs\ncat > tests/sim.test.mjs <<'EOF'\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nimport {DT,DEFAULTS,ARENA,STONES,tickOf} from '../src/config.js';\nimport {COURTS,RIVALS,validateCourt,exportCourt,connected,castleBlocks} from '../src/content.js';\nimport {createWorld,command,step,advance,planShot,predict,projectile,stepProjectile,resolveImpact,collapse,remaining,finish,createAI,aiStep,health,pack,unpack,applyTuning,powerOf,readyAt,sweep} from '../src/sim.js';\nimport {boot} from '../src/app.js';\nimport {loadTour,saveTour,eraseTour,SAVE_KEY}from '../src/persistence.js';\nimport {Transport,OnlineMatch}from '../src/online.js';\nexport async function run(check){\n const test=(name,fn)=>check(name,fn),eq=(a,b)=>assert.deepEqual(a,b);\n for(const c of COURTS){test(\"'`court ${c.id}: valid definition and round trip`,()=>{assert.ok(validateCourt({version:1,court:c}).ok);eq(JSON.parse(exportCourt(c)).court,c);});test(`court ${c.id}: mirrored fair objectives and support graph`,()=>{const w=createWorld({court:c.id});eq(w.castles[0].map(b=>[b.hp,b.max,b.z,b.support]),w.castles[1].map(b=>[b.hp,b.max,b.z,b.support]));assert.ok(w.castles[0].every((b,i)=>b.x+w.castles[1][i].x+b.w===960));assert.ok(w.castles.every(bs=>connected(bs).size===bs.length));});}\n test('\"'invalid court data rejects malformed roles / dimensions',()=>{assert.equal(validateCourt({version:3}).ok,false);const c=JSON.parse(exportCourt(COURTS[0]));c.court.blocks[9].x=Infinity;assert.equal(validateCourt(c).ok,false);});\n test('full charge holds without wrapping or auto-fire',()=>{const w=createWorld();command(w,0,{kind:'begin'});advance(w,3);eq(w.coverage.launch,[0,0,0]);eq(powerOf(w,w.players[0]),1);command(w,0,{kind:'release'});eq(w.coverage.launch,[1,0,0]);assert.equal(w.shots.length,1);});\n test('short release cancels; cancel never emits a shot',()=>{const w=createWorld();command(w,0,{kind:'begin'});advance(w,.025);command(w,0,{kind:'release'});eq(w.coverage.launch,[0,0,0]);command(w,0,{kind:'begin'});advance(w,.5);command(w,0,{kind:'cancel'});advance(w,1);eq(w.coverage.launch,[0,0,0]);});\n test('medium holds produce useful shots and max overshoots',()=>{const w=createWorld();assert.ok(predict(w,0,0,.7).hits.some(h=>['crew','launcher','castle'].includes(h.kind)));assert.equal(predict(w,0,0,1).hits[0].kind,'away');});\n test('buffered press starts on ready; early release clears buffer',()=>{const w=createWorld();w.players[0].ready=120;command(w,0,{kind:'begin'});advance(w,.5);assert.equal(w.players[0].charge,-1);command(w,0,{kind:'release'});advance(w,.6);assert.equal(w.players[0].charge,-1);w.players[0].ready=w.tick+30;command(w,0,{kind:'begin'});advance(w,.3);assert.ok(w.players[0].charge>=0);});\n test('stone locked while charging; selection after cancel',()=>{const w=createWorld();command(w,0,{kind:'begin'});assert.equal(command(w,0,{kind:'stone',stone:1}),false);command(w,0,{kind:'cancel'});assert.equal(command(w,0,{kind:'stone',stone:1}),true);});\n test('independent simultaneous holds released in opposite order',()=>{const w=createWorld();command(w,0,{kind:'begin'});advance(w,.2);command(w,1,{kind:'begin'});advance(w,.6);command(w,1,{kind:'release'});assert.ok(w.players[0].held);command(w,0,{kind:'release'});assert.equal(w.shots.length,2);assert.ok(w.shots[0].vx<0&&w.shots[1].vx>0);});\n test('duplicate/stale commands cannot launch twice',()=>{const w=createWorld();command(w,0,{kind:'begin',seq:1});advance(w,.9);command(w,0,{kind:'release',seq:2});assert.equal(command(w,0,{kind:'release',seq:2}),false);assert.equal(command(w,0,{kind:'begin',seq:0}),false);eq(w.coverage.launch,[1,0,0]);});\n for(let stone=0;stone<3;stone++)for(let seat=0;seat<2;seat++)test(\"'`prediction/live agreement stone ${stone} seat ${seat}`,()=>{const w=createWorld(),power=.70;command(w,seat,{kind:'\"'stone',stone});const hold=Math.round(power*w.config.chargeTime/DT)*DT;const pred=predict(w,seat,stone,hold/w.config.chargeTime).hits;command(w,seat,{kind:'begin'});advance(w,hold);command(w,seat,{kind:'release'});advance(w,4);const actual=w.players[seat].last[stone];assert.ok(actual);assert.ok(pred.some(h=>h.kind===actual.kind&&Math.abs(h.x-actual.x)<.01&&Math.abs(h.z-actual.z)<.01));assert.ok(w.shots.every(s=>Number.isFinite(s.x+s.z+s.vx+s.vz)));if(stone===2)eq(w.coverage.split,1);});\n test('sweep catches a fast thin target before terrain',()=>{eq(sweep(0,50,1000,50,{x:500,z:40,w:1,h:20}),.5);const w=createWorld(),s={...projectile(w,0,0,.9),x:100,z:50,vx:100000,vz:0};const hit=stepProjectile(w,s,DT,[{x:500,z:40,w:1,h:20,key:'thin',kind:'castle'}]);assert.equal(hit.kind,'castle');assert.ok(s.x<501);});\n test('water is first contact on undershoot',()=>{const w=createWorld();assert.equal(predict(w,0,0,.4).hits[0].kind,'water');});\n for(let c=0;c<5;c++)for(let stone=0;stone<3;stone++)test(\"'`court ${c}: launcher, crew and elevated masonry reachable stone ${stone}`,()=>{const w=createWorld({court:c}),seen=new Set();for(let p=.1;p<1;p+=.003)for(const h of predict(w,0,stone,p).hits)seen.add(h.kind);for(const kind of ['\"'launcher','crew','castle'])assert.ok(seen.has(kind),kind);});\n for(let c=0;c<5;c++)test(\"'`court ${c}: every last objective finishable`,()=>{const w=createWorld({court:c});w.players[1].crewUntil=1e6;w.players[1].launcherUntil=1e6;const all=w.castles[1].filter(b=>!b.foundation);for(const b of all){for(const q of all)q.hp=q===b?q.max:0;let found=false;for(let p=.1;p<1;p+=.002)if(predict(w,0,0,p).hits.some(h=>h.kind==='\"'castle'&&h.id===b.id)){found=true;break;}assert.ok(found,\"'`block ${b.id}`);}});\n test('\"'removal changes collider and cascade scores no extra points',()=>{const w=createWorld(),bs=w.castles[1],support=bs.find(b=>\"'!b.foundation),upper=bs.find(b=>!b.foundation&&b.z>support.z&&b.x===support.x);for(const b of bs)if(!b.foundation&&b!==support&&b!==upper)b.hp=0;upper.support=[support.id];support.support=[bs.find(b=>b.foundation&&b.x===support.x).id];const s=projectile(w,0,1,.7);resolveImpact(w,s,{...support,kind:'\"'castle',seat:1,key:\"'`b1:${support.id}`});eq(w.players[0].score,3);eq(support.hp,0);eq(upper.hp,0);assert.ok(w.coverage.collapse>0);assert.ok(bs.filter(b=>b.foundation).every(b=>b.hp===0));});\n test('\"'split throw cannot score one target repeatedly',()=>{const w=createWorld(),s=projectile(w,0,2,.7),h={kind:'crew',seat:1,key:'c1',x:752,z:50};resolveImpact(w,s,h);const end=w.players[1].crewUntil;resolveImpact(w,{...s,id:111,fragment:true},h);eq(w.players[0].score,7);eq(w.players[1].crewUntil,end);});\n for(const kind of ['crew','launcher'])test(\"'`${kind} interruption cancels charge, recovery protects and requires fresh input`,()=>{const w=createWorld();command(w,1,{kind:'\"'begin'});advance(w,.5);const s=projectile(w,0,0,.7),h={kind,seat:1,key:kind==='crew'?'c1':'l1',x:752,z:50};resolveImpact(w,s,h);assert.equal(w.players[1].held,false);const end=readyAt(w.players[1]);advance(w,(end-w.tick)*DT);assert.equal(w.players[1].charge,-1);eq(w.coverage.recovery,1);resolveImpact(w,{...s,throw:999},h);eq(readyAt(w.players[1]),end);advance(w,w.config.protection+.1);resolveImpact(w,{...s,throw:1000},h);assert.ok(readyAt(w.players[1])>w.tick);});\n test('overlapping interruptions use latest endpoint, never additive',()=>{const w=createWorld(),s=projectile(w,0,0,.7);resolveImpact(w,s,{kind:'crew',seat:1,key:'c1',x:752,z:50});advance(w,.5);resolveImpact(w,{...s,throw:2},{kind:'launcher',seat:1,key:'l1',x:715,z:50});eq(readyAt(w.players[1]),w.tick+tickOf(2.6));});\n test('same-tick mutual destruction draws exactly once',()=>{const w=createWorld();w.castles=w.castles.map(bs=>bs.filter(b=>b.foundation||b.id===8));for(let seat=0;seat<2;seat++){const b=w.castles[1-seat].find(b=>\"'!b.foundation);b.hp=1;w.shots.push({...projectile(w,seat,0,.7),id:seat+1,throw:seat+1,x:b.x-8,z:b.z+10,vx:2000,vz:0});}step(w);eq(w.outcome.winner,-1);const out=w.outcome;advance(w,2);assert.equal(w.outcome,out);eq(w.coverage.results,1);});\n test('\"'timeout compares health %, then direct score, then draw',()=>{const a=createWorld();a.players[1].score=13;eq(finish(a).winner,1);const b=createWorld();eq(finish(b).winner,-1);const c=createWorld();c.castles[1].find(b=>\"'!b.foundation).hp=1;c.players[1].score=1000;eq(finish(c).winner,0);});\n test('\"'health tuning preserves fraction; bad tuning never introduces NaN',()=>{const w=createWorld(),b=w.castles[0].find(b=>\"'!b.foundation);b.hp=b.max*.5;applyTuning(w,{healthScale:2,gravity:NaN,crewDisable:-99});eq(b.hp/b.max,.5);assert.ok(w.config.gravity>0&&w.config.crewDisable>0);});\n test('\"'compact full snapshot round trip repairs dropped states',()=>{const w=createWorld({court:4});command(w,0,{kind:'begin'});advance(w,1);command(w,0,{kind:'release'});advance(w,.4);const s=pack(w,4),copy=createWorld({court:4});assert.ok(JSON.stringify(s).length<=1200);assert.ok(unpack(copy,s));eq(pack(copy,4),s);assert.equal(unpack(copy,{...s,k:0}),false);});\n test('saves validate corruption/version/denied storage and round trip',()=>{const data=new Map(),store={getItem:k=>data.get(k),setItem:(k,v)=>data.set(k,v),removeItem:k=>data.delete(k)};for(const bad of ['bad','{}','{\\\"version\\\":2,\\\"next\\\":1}']){data.set(SAVE_KEY,bad);eq(loadTour(store),null);}const s={version:1,next:1,seed:7,totals:[13,0],results:[{}]};assert.ok(saveTour(store,s));eq(loadTour(store),s);eraseTour(store);eq(loadTour(store),null);eq(saveTour({setItem(){throw Error('denied');}},s),false);eq(loadTour({getItem(){throw Error('denied');}}),null);});\n test('protected targets have no high-value AI interruption',()=>{const w=createWorld();w.players[1].protectUntil=100000;const plan=planShot(w,0,{...RIVALS[9],harass:100});assert.ok(plan.hits.some(h=>h.kind==='castle'));});\n await test('complete tour through real entry, lessons, all five courts, scoring, replay',()=>{\n  if(\"'!globalThis.My3D2dge)vm.runInThisContext(fs.readFileSync(new URL('\"'../vendor/engine/dist/handoff/my-3d2dge.js',import.meta.url),'utf8'));\n  const data=new Map(),storage={getItem:k=>data.get(k),setItem:(k,v)=>data.set(k,v),removeItem:k=>data.delete(k)};\n  const app=boot(globalThis.My3D2dge,{headless:true,loop:false,storage}),g=app.game;g.advance(DT);app.startTour(false);g.advance(DT);\n  const coverage={stones:new Set(),courts:new Set(),crew:0,launcher:0,collapse:0,lesson:false};let duration=0;\n  for(let bout=0;bout<10;bout++){\n   assert.equal(app.world.bout,bout);coverage.courts.add(app.world.court);let bot=createAI({...RIVALS[8],reaction:.15,error:0,harass:.8}),n=0;\n   while(\"'!app.world.outcome&&n++<10900){\n    // Test bot chooses a real temporary target early, and then uses the same legal hold/release layer.\n    const w=app.world;bot.goal=n<750?'\"'launcher':n<1600?'crew':null;\n    aiStep(w,0,bot);g.advance(DT);\n   }\n   assert.ok(app.world.outcome,\"'`bout ${bout}`);assert.ok(n>120,'\"'not an instantaneous outcome');duration+=app.world.tick*DT;\n   for(let i=0;i<3;i++)if(app.world.coverage.launch[i])coverage.stones.add(i);\n   coverage.crew+=app.world.coverage.crew;coverage.launcher+=app.world.coverage.launcher;coverage.collapse+=app.world.coverage.collapse;coverage.lesson||=app.lesson>=2;\n   g.advance(2);assert.equal(app.shell.screen,'results');assert.equal(app.tour.next,bout+1);\n   if(bout<9){const actions=app.shell._stack.at(-1).s.actions;actions.find(a=>a[0]==='Next bout')[1]();g.advance(DT);}\n  }\n  eq(coverage.stones.size,3);eq(coverage.courts.size,5);assert.ok(coverage.crew>0&&coverage.launcher>0&&coverage.collapse>0&&coverage.lesson);\n  eq(app.tour.totals,app.tour.results.reduce((a,r)=>a.map((n,i)=>n+r.banked[i]),[0,0]));eq(loadTour(storage),null);assert.ok(duration>500&&duration<=900);\n  const actions=app.shell._stack.at(-1).s.actions;actions.find(a=>a[0]==='Play the tour again')[1]();g.advance(DT);eq(app.world.bout,0);eq(app.tour.totals,[0,0]);eq(g.errors,[]);g.dispose();\n });\n test('native draw and exact attract threshold; exit does not launch/select',()=>{\n  const E=globalThis.My3D2dge;const app=boot(E,{headless:true,draw:true,loop:false});app.game.advance(1199*DT);eq(app.mode,'title');app.game.advance(DT);eq(app.mode,'attract');app.game.input.tap('confirm');app.game.advance(DT);eq(app.mode,'title');eq(app.shell.screen,'title');eq(app.world.coverage.launch,[0,0,0]);eq(app.game.errors,[]);app.game.dispose();\n });\n test('attract loops through three courts without save writes',()=>{let writes=0;const app=boot(globalThis.My3D2dge,{headless:true,loop:false,storage:{getItem(){return null;},setItem(){writes++;},removeItem(){writes++;}}});app.game.advance(10);const courts=new Set();for(let i=0;i<92;i++){app.game.advance(1);courts.add(app.world.court);}assert.ok(courts.size>=3);eq(writes,0);eq(app.tour,null);app.game.dispose();});\n test('reliable queue retries rejected sends in order, bounds sizes and clears',()=>{let now=0,accept=false;const sent=[],hub={send(d){if(\"'!accept)return false;sent.push(d);return true;}},t=new Transport(hub,()=>now);t.enqueue({t:'\"'c',n:1});t.enqueue({t:'c',n:2});t.flush();eq(sent.length,0);accept=true;now=100;t.flush();eq(sent.map(a=>a.n),[1,2]);assert.ok(t.metrics.retries>0);assert.equal(t.enqueue({x:'x'.repeat(17000)}),false);t.stop();assert.equal(t.enqueue({n:3}),false);});\n test('authoritative command duration tolerates delay but rejects implausible state',()=>{const h={send(){return true;},time:()=>1000},net=new OnlineMatch(h);net.info={isHost:true,players:[{id:10},{id:20}]};net.started=true;net.world=createWorld();advance(net.world,.1);assert.equal(net.receiveIntent({kind:'begin',seq:1,at:.8},99),false);assert.ok(net.receiveIntent({kind:'begin',seq:1,at:.8},20));advance(net.world,.6);assert.ok(net.receiveIntent({kind:'release',seq:2,at:.9,duration:.65},20));eq(net.world.coverage.launch,[1,0,0]);assert.equal(net.receiveIntent({kind:'begin',seq:3,at:100},20),false);});\n}\nEOF\ncat > scripts/verify.mjs <<'EOF'\nimport {spawnSync}from 'node:child_process';\nimport process from 'node:process';\nprocess.chdir(new URL('..',import.meta.url));\nlet count=0,failures=0;const pending=[];\nfunction check(name,fn){count++;try{const r=fn();if(r&&typeof r.then==='function'){const p=r.catch(e=>{failures++;console.log(\"'`FAIL ${name}: ${e.stack||e}`);});pending.push(p);return p;}}catch(e){failures++;console.log(`FAIL ${name}: ${e.stack||e}`);}}\nconst group=process.argv[2]||'\"'all';\nif(group==='all'||group==='sim'){try{await (await import('../tests/sim.test.mjs')).run(check);}catch(e){failures++;console.log(\"'`FAIL simulation runner: ${e.stack}`);}}\nawait Promise.all(pending);\nif(group==='\"'all'||group==='browser'){const r=spawnSync('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/browser_verify.py'],{encoding:'utf8',maxBuffer:8e6});if(r.stdout){for(const line of r.stdout.trim().split('\\\\n')){try{const d=JSON.parse(line);if(d.checks\"'!==undefined){count+=d.checks;failures+=d.failures;}else console.log(line);}catch{console.log(line);}}}if(r.status!==0){failures++;console.log(`FAIL browser runner: ${r.stderr||r.error||r.status}`);}}\nconsole.log(`${count} checks, ${failures} failures`);process.exitCode=failures?1:0;\nEOF\nnpm run verify:sim --silent'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/app.js'\ns=open(p).read().replace(\\\"root.id='combat-hud';root.innerHTML\\\", \\\"root.id='combat-hud';root.hidden=true;root.innerHTML\\\")\ns=s.replace(\\\"if(Math.abs(e.movementX)+Math.abs(e.movementY)>1)app.idleTicks=0;\\\", \\\"if(Math.abs(e.movementX)+Math.abs(e.movementY)>1){app.idleTicks=0;if(app.mode==='attract')app.exitAttract();}\\\")\ns=s.replace(\\\"shot=w.coverage.launch.reduce((a,b)=>a+b,0)\\\",\\\"shot=w.coverage.launch.reduce((a,b)=>a+b,0)\\\")\ns=s.replace(\\\"if(app.lesson===0&&shot>app.lessonShot)\\\",\\\"if(app.lesson===0&&w.players[0].launchTick>=0)\\\")\n# Only one active touch per seat, so local multitouch works independently.\ns=s.replace(\\\"if(app.pointers.size)return;e.preventDefault();canvas.setPointerCapture(e.pointerId);const seat=\\\", \\\"e.preventDefault();const seat=\\\")\ns=s.replace(\\\"if(seat===null)return;\\\\n app.pointers.set\\\", \\\"if(seat===null||[...app.pointers.values()].includes(seat))return;canvas.setPointerCapture(e.pointerId);\\\\n app.pointers.set\\\")\n# Direct pointer guidance may highlight the referenced block.\ns=s.replace(\\\"||null;}}});\\\", \\\"||null;view.hover=app.hover;}}});\\\")\nopen(p,'w').write(s)\np='src/style.css';s=open(p).read();s+='\\\\n.esh-ttl>div{margin-left:3vw\"'!important}.esh-ttl h1{font-size:48px!important}.esh-ttl>div:before{font-size:28px;margin-bottom:10px}.esh-ttl .esh-btns{margin-top:12px!important}.esh-ttl .esh-btns button{min-height:34px!important;padding:6px 14px!important}.esh-ttl .esh-sub{margin:12px 0!important}.esh-ttl .esh-m{margin-top:8px!important}'\"\\\\n@media(max-width:800px){.esh-ttl h1{font-size:34px\"'!important}.esh-ttl>div{margin-left:5vw!important}.esh-ttl .esh-btns button{min-height:34px!important}}'\"\\\\n'\nopen(p,'w').write(s)\np='src/view.js';s=open(p).read().replace('h:70,y:-34','h:440,y:-404')\ns=s.replace(\\\"const [,,]=[0,0];\\\",'')\ns=s.replace(\\\"const a=.35-y/400,col=\\\", \\\"const col=\\\")\ns=s.replace(\\\"if(this.selection?.id===b.id&&seat===0)\\\",\\\"if((this.selection?.id===b.id&&seat===0)||this.hover?.id===b.id&&this.hover?.x===b.x)\\\")\nopen(p,'w').write(s)\np='src/sim.js';s=open(p).read().replace(\\\"if(profile.kind==='broad'&&h.stone===2)value+=3;\\\",\\\"if(profile.kind==='broad'&&h.stone===2)value+=3;if(profile.kind==='mason'&&h.stone===1)value+=6;\\\")\nopen(p,'w').write(s)\nPY\nnode scripts/build.mjs\ncat > tests/sim.test.mjs <<'EOF'\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport assert from 'node:assert/strict';\nimport {DT,DEFAULTS,ARENA,STONES,tickOf} from '../src/config.js';\nimport {COURTS,RIVALS,validateCourt,exportCourt,connected,castleBlocks} from '../src/content.js';\nimport {createWorld,command,step,advance,planShot,predict,projectile,stepProjectile,resolveImpact,collapse,remaining,finish,createAI,aiStep,health,pack,unpack,applyTuning,powerOf,readyAt,sweep} from '../src/sim.js';\nimport {boot} from '../src/app.js';\nimport {loadTour,saveTour,eraseTour,SAVE_KEY}from '../src/persistence.js';\nimport {Transport,OnlineMatch}from '../src/online.js';\nexport async function run(check){\n const test=(name,fn)=>check(name,fn),eq=(a,b)=>assert.deepEqual(a,b);\n for(const c of COURTS){test(\"'`court ${c.id}: valid definition and round trip`,()=>{assert.ok(validateCourt({version:1,court:c}).ok);eq(JSON.parse(exportCourt(c)).court,c);});test(`court ${c.id}: mirrored fair objectives and support graph`,()=>{const w=createWorld({court:c.id});eq(w.castles[0].map(b=>[b.hp,b.max,b.z,b.support]),w.castles[1].map(b=>[b.hp,b.max,b.z,b.support]));assert.ok(w.castles[0].every((b,i)=>b.x+w.castles[1][i].x+b.w===960));assert.ok(w.castles.every(bs=>connected(bs).size===bs.length));});}\n test('\"'invalid court data rejects malformed roles / dimensions',()=>{assert.equal(validateCourt({version:3}).ok,false);const c=JSON.parse(exportCourt(COURTS[0]));c.court.blocks[9].x=Infinity;assert.equal(validateCourt(c).ok,false);});\n test('full charge holds without wrapping or auto-fire',()=>{const w=createWorld();command(w,0,{kind:'begin'});advance(w,3);eq(w.coverage.launch,[0,0,0]);eq(powerOf(w,w.players[0]),1);command(w,0,{kind:'release'});eq(w.coverage.launch,[1,0,0]);assert.equal(w.shots.length,1);});\n test('short release cancels; cancel never emits a shot',()=>{const w=createWorld();command(w,0,{kind:'begin'});advance(w,.025);command(w,0,{kind:'release'});eq(w.coverage.launch,[0,0,0]);command(w,0,{kind:'begin'});advance(w,.5);command(w,0,{kind:'cancel'});advance(w,1);eq(w.coverage.launch,[0,0,0]);});\n test('medium holds produce useful shots and max overshoots',()=>{const w=createWorld();assert.ok(predict(w,0,0,.7).hits.some(h=>['crew','launcher','castle'].includes(h.kind)));assert.equal(predict(w,0,0,1).hits[0].kind,'away');});\n test('buffered press starts on ready; early release clears buffer',()=>{const w=createWorld();w.players[0].ready=120;command(w,0,{kind:'begin'});advance(w,.5);assert.equal(w.players[0].charge,-1);command(w,0,{kind:'release'});advance(w,.6);assert.equal(w.players[0].charge,-1);w.players[0].ready=w.tick+30;command(w,0,{kind:'begin'});advance(w,.3);assert.ok(w.players[0].charge>=0);});\n test('stone locked while charging; selection after cancel',()=>{const w=createWorld();command(w,0,{kind:'begin'});assert.equal(command(w,0,{kind:'stone',stone:1}),false);command(w,0,{kind:'cancel'});assert.equal(command(w,0,{kind:'stone',stone:1}),true);});\n test('independent simultaneous holds released in opposite order',()=>{const w=createWorld();command(w,0,{kind:'begin'});advance(w,.2);command(w,1,{kind:'begin'});advance(w,.6);command(w,1,{kind:'release'});assert.ok(w.players[0].held);command(w,0,{kind:'release'});assert.equal(w.shots.length,2);assert.ok(w.shots[0].vx<0&&w.shots[1].vx>0);});\n test('duplicate/stale commands cannot launch twice',()=>{const w=createWorld();command(w,0,{kind:'begin',seq:1});advance(w,.9);command(w,0,{kind:'release',seq:2});assert.equal(command(w,0,{kind:'release',seq:2}),false);assert.equal(command(w,0,{kind:'begin',seq:0}),false);eq(w.coverage.launch,[1,0,0]);});\n for(let stone=0;stone<3;stone++)for(let seat=0;seat<2;seat++)test(\"'`prediction/live agreement stone ${stone} seat ${seat}`,()=>{const w=createWorld(),power=.70;command(w,seat,{kind:'\"'stone',stone});const hold=Math.round(power*w.config.chargeTime/DT)*DT;const pred=predict(w,seat,stone,hold/w.config.chargeTime).hits;command(w,seat,{kind:'begin'});advance(w,hold);command(w,seat,{kind:'release'});advance(w,4);const actual=w.players[seat].last[stone];assert.ok(actual);assert.ok(pred.some(h=>h.kind===actual.kind&&Math.abs(h.x-actual.x)<.01&&Math.abs(h.z-actual.z)<.01));assert.ok(w.shots.every(s=>Number.isFinite(s.x+s.z+s.vx+s.vz)));if(stone===2)eq(w.coverage.split,1);});\n test('sweep catches a fast thin target before terrain',()=>{eq(sweep(0,50,1000,50,{x:500,z:40,w:1,h:20}),.5);const w=createWorld(),s={...projectile(w,0,0,.9),x:100,z:50,vx:100000,vz:0};const hit=stepProjectile(w,s,DT,[{x:500,z:40,w:1,h:20,key:'thin',kind:'castle'}]);assert.equal(hit.kind,'castle');assert.ok(s.x<501);});\n test('water is first contact on undershoot',()=>{const w=createWorld();assert.equal(predict(w,0,0,.4).hits[0].kind,'water');});\n for(let c=0;c<5;c++)for(let stone=0;stone<3;stone++)test(\"'`court ${c}: launcher, crew and elevated masonry reachable stone ${stone}`,()=>{const w=createWorld({court:c}),seen=new Set();for(let p=.1;p<1;p+=.003)for(const h of predict(w,0,stone,p).hits)seen.add(h.kind);for(const kind of ['\"'launcher','crew','castle'])assert.ok(seen.has(kind),kind);});\n for(let c=0;c<5;c++)test(\"'`court ${c}: every last objective finishable`,()=>{const w=createWorld({court:c});w.players[1].crewUntil=1e6;w.players[1].launcherUntil=1e6;const all=w.castles[1].filter(b=>!b.foundation);for(const b of all){for(const q of all)q.hp=q===b?q.max:0;let found=false;for(let p=.1;p<1;p+=.002)if(predict(w,0,0,p).hits.some(h=>h.kind==='\"'castle'&&h.id===b.id)){found=true;break;}assert.ok(found,\"'`block ${b.id}`);}});\n test('\"'removal changes collider and cascade scores no extra points',()=>{const w=createWorld(),bs=w.castles[1],support=bs.find(b=>\"'!b.foundation),upper=bs.find(b=>!b.foundation&&b.z>support.z&&b.x===support.x);for(const b of bs)if(!b.foundation&&b!==support&&b!==upper)b.hp=0;upper.support=[support.id];support.support=[bs.find(b=>b.foundation&&b.x===support.x).id];const s=projectile(w,0,1,.7);resolveImpact(w,s,{...support,kind:'\"'castle',seat:1,key:\"'`b1:${support.id}`});eq(w.players[0].score,3);eq(support.hp,0);eq(upper.hp,0);assert.ok(w.coverage.collapse>0);assert.ok(bs.filter(b=>b.foundation).every(b=>b.hp===0));});\n test('\"'split throw cannot score one target repeatedly',()=>{const w=createWorld(),s=projectile(w,0,2,.7),h={kind:'crew',seat:1,key:'c1',x:752,z:50};resolveImpact(w,s,h);const end=w.players[1].crewUntil;resolveImpact(w,{...s,id:111,fragment:true},h);eq(w.players[0].score,7);eq(w.players[1].crewUntil,end);});\n for(const kind of ['crew','launcher'])test(\"'`${kind} interruption cancels charge, recovery protects and requires fresh input`,()=>{const w=createWorld();command(w,1,{kind:'\"'begin'});advance(w,.5);const s=projectile(w,0,0,.7),h={kind,seat:1,key:kind==='crew'?'c1':'l1',x:752,z:50};resolveImpact(w,s,h);assert.equal(w.players[1].held,false);const end=readyAt(w.players[1]);advance(w,(end-w.tick)*DT);assert.equal(w.players[1].charge,-1);eq(w.coverage.recovery,1);resolveImpact(w,{...s,throw:999},h);eq(readyAt(w.players[1]),end);advance(w,w.config.protection+.1);resolveImpact(w,{...s,throw:1000},h);assert.ok(readyAt(w.players[1])>w.tick);});\n test('overlapping interruptions use latest endpoint, never additive',()=>{const w=createWorld(),s=projectile(w,0,0,.7);resolveImpact(w,s,{kind:'crew',seat:1,key:'c1',x:752,z:50});advance(w,.5);resolveImpact(w,{...s,throw:2},{kind:'launcher',seat:1,key:'l1',x:715,z:50});eq(readyAt(w.players[1]),w.tick+tickOf(2.6));});\n test('same-tick mutual destruction draws exactly once',()=>{const w=createWorld();w.castles=w.castles.map(bs=>bs.filter(b=>b.foundation||b.id===8));for(let seat=0;seat<2;seat++){const b=w.castles[1-seat].find(b=>\"'!b.foundation);b.hp=1;w.shots.push({...projectile(w,seat,0,.7),id:seat+1,throw:seat+1,x:b.x-8,z:b.z+10,vx:2000,vz:0});}step(w);eq(w.outcome.winner,-1);const out=w.outcome;advance(w,2);assert.equal(w.outcome,out);eq(w.coverage.results,1);});\n test('\"'timeout compares health %, then direct score, then draw',()=>{const a=createWorld();a.players[1].score=13;eq(finish(a).winner,1);const b=createWorld();eq(finish(b).winner,-1);const c=createWorld();c.castles[1].find(b=>\"'!b.foundation).hp=1;c.players[1].score=1000;eq(finish(c).winner,0);});\n test('\"'health tuning preserves fraction; bad tuning never introduces NaN',()=>{const w=createWorld(),b=w.castles[0].find(b=>\"'!b.foundation);b.hp=b.max*.5;applyTuning(w,{healthScale:2,gravity:NaN,crewDisable:-99});eq(b.hp/b.max,.5);assert.ok(w.config.gravity>0&&w.config.crewDisable>0);});\n test('\"'compact full snapshot round trip repairs dropped states',()=>{const w=createWorld({court:4});command(w,0,{kind:'begin'});advance(w,1);command(w,0,{kind:'release'});advance(w,.4);const s=pack(w,4),copy=createWorld({court:4});assert.ok(JSON.stringify(s).length<=1200);assert.ok(unpack(copy,s));eq(pack(copy,4),s);assert.equal(unpack(copy,{...s,k:0}),false);});\n test('saves validate corruption/version/denied storage and round trip',()=>{const data=new Map(),store={getItem:k=>data.get(k),setItem:(k,v)=>data.set(k,v),removeItem:k=>data.delete(k)};for(const bad of ['bad','{}','{\\\"version\\\":2,\\\"next\\\":1}']){data.set(SAVE_KEY,bad);eq(loadTour(store),null);}const s={version:1,next:1,seed:7,totals:[13,0],results:[{}]};assert.ok(saveTour(store,s));eq(loadTour(store),s);eraseTour(store);eq(loadTour(store),null);eq(saveTour({setItem(){throw Error('denied');}},s),false);eq(loadTour({getItem(){throw Error('denied');}}),null);});\n test('protected targets have no high-value AI interruption',()=>{const w=createWorld();w.players[1].protectUntil=100000;const plan=planShot(w,0,{...RIVALS[9],harass:100});assert.ok(plan.hits.some(h=>h.kind==='castle'));});\n await test('complete tour through real entry, lessons, all five courts, scoring, replay',()=>{\n  if(\"'!globalThis.My3D2dge)vm.runInThisContext(fs.readFileSync(new URL('\"'../vendor/engine/dist/handoff/my-3d2dge.js',import.meta.url),'utf8'));\n  const data=new Map(),storage={getItem:k=>data.get(k),setItem:(k,v)=>data.set(k,v),removeItem:k=>data.delete(k)};\n  const app=boot(globalThis.My3D2dge,{headless:true,loop:false,storage}),g=app.game;g.advance(DT);app.startTour(false);g.advance(DT);\n  const coverage={stones:new Set(),courts:new Set(),crew:0,launcher:0,collapse:0,lesson:false};let duration=0;\n  for(let bout=0;bout<10;bout++){\n   assert.equal(app.world.bout,bout);coverage.courts.add(app.world.court);let bot=createAI({...RIVALS[8],reaction:.15,error:0,harass:.8}),n=0;\n   while(\"'!app.world.outcome&&n++<10900){\n    // Test bot chooses a real temporary target early, and then uses the same legal hold/release layer.\n    const w=app.world;bot.goal=n<750?'\"'launcher':n<1600?'crew':null;\n    aiStep(w,0,bot);g.advance(DT);\n   }\n   assert.ok(app.world.outcome,\"'`bout ${bout}`);assert.ok(n>120,'\"'not an instantaneous outcome');duration+=app.world.tick*DT;\n   for(let i=0;i<3;i++)if(app.world.coverage.launch[i])coverage.stones.add(i);\n   coverage.crew+=app.world.coverage.crew;coverage.launcher+=app.world.coverage.launcher;coverage.collapse+=app.world.coverage.collapse;coverage.lesson||=app.lesson>=2;\n   g.advance(2);assert.equal(app.shell.screen,'results');assert.equal(app.tour.next,bout+1);\n   if(bout<9){const actions=app.shell._stack.at(-1).s.actions;actions.find(a=>a[0]==='Next bout')[1]();g.advance(DT);}\n  }\n  eq(coverage.stones.size,3);eq(coverage.courts.size,5);assert.ok(coverage.crew>0&&coverage.launcher>0&&coverage.collapse>0&&coverage.lesson);\n  eq(app.tour.totals,app.tour.results.reduce((a,r)=>a.map((n,i)=>n+r.banked[i]),[0,0]));eq(loadTour(storage),null);assert.ok(duration>500&&duration<=900);\n  const actions=app.shell._stack.at(-1).s.actions;actions.find(a=>a[0]==='Play the tour again')[1]();g.advance(DT);eq(app.world.bout,0);eq(app.tour.totals,[0,0]);eq(g.errors,[]);g.dispose();\n });\n test('native draw and exact attract threshold; exit does not launch/select',()=>{\n  const E=globalThis.My3D2dge;const app=boot(E,{headless:true,draw:true,loop:false});app.game.advance(1199*DT);eq(app.mode,'title');app.game.advance(DT);eq(app.mode,'attract');app.game.input.tap('confirm');app.game.advance(DT);eq(app.mode,'title');eq(app.shell.screen,'title');eq(app.world.coverage.launch,[0,0,0]);eq(app.game.errors,[]);app.game.dispose();\n });\n test('attract loops through three courts without save writes',()=>{let writes=0;const app=boot(globalThis.My3D2dge,{headless:true,loop:false,storage:{getItem(){return null;},setItem(){writes++;},removeItem(){writes++;}}});app.game.advance(10);const courts=new Set();for(let i=0;i<92;i++){app.game.advance(1);courts.add(app.world.court);}assert.ok(courts.size>=3);eq(writes,0);eq(app.tour,null);app.game.dispose();});\n test('reliable queue retries rejected sends in order, bounds sizes and clears',()=>{let now=0,accept=false;const sent=[],hub={send(d){if(\"'!accept)return false;sent.push(d);return true;}},t=new Transport(hub,()=>now);t.enqueue({t:'\"'c',n:1});t.enqueue({t:'c',n:2});t.flush();eq(sent.length,0);accept=true;now=100;t.flush();eq(sent.map(a=>a.n),[1,2]);assert.ok(t.metrics.retries>0);assert.equal(t.enqueue({x:'x'.repeat(17000)}),false);t.stop();assert.equal(t.enqueue({n:3}),false);});\n test('authoritative command duration tolerates delay but rejects implausible state',()=>{const h={send(){return true;},time:()=>1000},net=new OnlineMatch(h);net.info={isHost:true,players:[{id:10},{id:20}]};net.started=true;net.world=createWorld();advance(net.world,.1);assert.equal(net.receiveIntent({kind:'begin',seq:1,at:.8},99),false);assert.ok(net.receiveIntent({kind:'begin',seq:1,at:.8},20));advance(net.world,.6);assert.ok(net.receiveIntent({kind:'release',seq:2,at:.9,duration:.65},20));eq(net.world.coverage.launch,[1,0,0]);assert.equal(net.receiveIntent({kind:'begin',seq:3,at:100},20),false);});\n}\nEOF\ncat > scripts/verify.mjs <<'EOF'\nimport {spawnSync}from 'node:child_process';\nimport process from 'node:process';\nprocess.chdir(new URL('..',import.meta.url));\nlet count=0,failures=0;const pending=[];\nfunction check(name,fn){count++;try{const r=fn();if(r&&typeof r.then==='function'){const p=r.catch(e=>{failures++;console.log(\"'`FAIL ${name}: ${e.stack||e}`);});pending.push(p);return p;}}catch(e){failures++;console.log(`FAIL ${name}: ${e.stack||e}`);}}\nconst group=process.argv[2]||'\"'all';\nif(group==='all'||group==='sim'){try{await (await import('../tests/sim.test.mjs')).run(check);}catch(e){failures++;console.log(\"'`FAIL simulation runner: ${e.stack}`);}}\nawait Promise.all(pending);\nif(group==='\"'all'||group==='browser'){const r=spawnSync('/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/browser_verify.py'],{encoding:'utf8',maxBuffer:8e6});if(r.stdout){for(const line of r.stdout.trim().split('\\\\n')){try{const d=JSON.parse(line);if(d.checks\"'!==undefined){count+=d.checks;failures+=d.failures;}else console.log(line);}catch{console.log(line);}}}if(r.status!==0){failures++;console.log(`FAIL browser runner: ${r.stderr||r.error||r.status}`);}}\nconsole.log(`${count} checks, ${failures} failures`);process.exitCode=failures?1:0;\nEOF\nnpm run verify:sim --silent'","aggregated_output":"node:internal/bootstrap/switches/does_own_process_state:127\n  validateString(directory, 'directory');\n  ^\n\nTypeError [ERR_INVALID_ARG_TYPE]: The \"directory\" argument must be of type string. Received an instance of URL\n    at process.wrappedChdir [as chdir] (node:internal/bootstrap/switches/does_own_process_state:127:3)\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-032856__xc31afd/work/Smithereens-Under-Siege-Stone-Sling-Smithereens-1980-gpt-6.1-sol-max-20261106-032856/scripts/verify.mjs:3:9\n    at ModuleJob.run (node:internal/modules/esm/module_job:561:25)\n    at process.processTicksAndRejections (node:internal/process/task_queues:104:5)\n    at async node:internal/modules/esm/loader:647:26\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5) {\n  code: 'ERR_INVALID_ARG_TYPE'\n}\n\nNode.js v24.21.0\n","exit_code":1,"status":"failed"}}
