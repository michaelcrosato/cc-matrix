{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cat > tests/inspect.py <<'EOF'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport json\nroot=Path(__file__).resolve().parents[1]\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True)\n page=browser.new_page(viewport={\\\"width\\\":1920,\\\"height\\\":1080})\n errors=[]\n page.on('pageerror',lambda e: errors.append(str(e)))\n page.goto((root/'artifacts/game.html').as_uri())\n page.wait_for_function('window.__SIEGE?.app?.world')\n page.wait_for_timeout(750)\n print(json.dumps({'errors':errors,'state':page.evaluate('__SIEGE.app.snapshot()'),'buffer':page.evaluate('Object.keys(__SIEGE.game.screen)')},default=str))\n page.screenshot(path=str(root/'artifacts/title.png'))\n page.get_by_role('button',name='Quick duel',exact=True).click()\n page.get_by_role('button',name='To the battlements',exact=True).click()\n page.wait_for_timeout(900)\n page.keyboard.down('Space')\n page.wait_for_timeout(850)\n page.screenshot(path=str(root/'artifacts/charge.png'))\n page.keyboard.up('Space')\n page.wait_for_timeout(3600)\n print(json.dumps({'errors':errors,'state':page.evaluate('__SIEGE.app.snapshot()')}))\n browser.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/inspect.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
