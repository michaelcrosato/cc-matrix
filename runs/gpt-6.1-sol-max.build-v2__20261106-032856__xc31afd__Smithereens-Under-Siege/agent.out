{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/app.js';s=open(p).read()\ns=s.replace(\\\"{key:'music',value:.1},{key:'glyphs',value:'playstation'},\\\", \\\"{key:'music',value:.1},{key:'glyphs',value:'playstation'},{key:'voiceLevel',label:'Voices',type:'slider',min:0,max:1,step:.05,value:.8,group:'Sound',apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},\\\")\ns=s.replace(\\\"if(key==='uiSize'&&typeof document\"'!=='\"'undefined')document.documentElement.style.setProperty('--ui-scale',game.settings.uiSize);\\\", \\\"if(key==='uiSize')applyUIScale();if((key==='tension'||key==='timingAssist')&&app.world&&\"'!app.online)app.world.config.chargeTime=app.config().chargeTime;\")\nneedle=\" function clearInputs()\"\ns=s.replace(needle,\" function applyUIScale(){if(!shell.root||typeof innerWidth==='\"'undefined')return;const k=Math.max(18,Math.min(30,innerWidth*.016))/14*game.settings.uiSize;Object.assign(shell.root.style,{transform:\"'`scale(${k})`,width:`${100/k}vw`,height:`${100/k}vh`});}'\"\\\\n applyUIScale();if(typeof addEventListener\"'!=='\"'undefined')addEventListener('resize',applyUIScale);\\\\n function clearInputs()\\\")\ns=s.replace(\\\"if(app.tour){app.tour.results.push\\\", \\\"if(app.tour){app.tour.cheated=\"'!!app.tour.cheated||w.cheated;app.tour.results.push\")\ns=s.replace(\"${w.cheated?'\"' · DEVELOPER RUN':''}\\\",\\\"\"'${w.cheated||app.tour?.cheated?'\"' · DEVELOPER RUN':''}\\\")\nopen(p,'w').write(s)\nPY\ncat > src/persistence.js <<'EOF'\nexport const SAVE_KEY='smithereens-under-siege:tour:v1';\nexport function loadTour(storage){try{\n const s=JSON.parse(storage.getItem(SAVE_KEY));\n if(s?.version\"'!==1||!Number.isInteger(s.next)||s.next<1||s.next>=10||!Number.isInteger(s.seed)||s.seed<0||s.seed>0xffffffff)return null;\n if(!Array.isArray(s.totals)||s.totals.length!==2||!s.totals.every(n=>Number.isSafeInteger(n)&&n>=0&&n<1e7)||!Array.isArray(s.results)||s.results