,hi); return out; }\nexport function rngStep(w) { let a = w.rng = (w.rng + 0x6d2b79f5) >>> 0; a = Math.imul(a \"'^ a >>> 15, a | 1); a ''^= a + Math.imul(a ''^ a >>> 7, a | 61); return ((a ''^ a >>> 14) >>> 0) / 4294967296; }\nEOF\ncat > src/content.js <<'\"'EOF'\nimport { ARENA, clamp } from './config.js';\nconst specs = [\n {name:'The Village Exhibition',short:'VILLAGE',subtitle:'A most uncivil afternoon',mood:'day',stone:'#b5b3a2',grass:'#6f8855',rows:['SS.SS.SS','SS.SS.SS','WW.WW.WW'],boast:'A fine day to lower the neighbourhood\"'!'\"',hint:'Hold, watch the landing diamond, release.',music:0},\n {name:'The Quarry Meet',short:'QUARRY',subtitle:'Mind the load-bearing bits',mood:'desert',stone:'#d6bd95',grass:'#999262',rows:['.R..R..R','SSSSSSSS','SSSSSSSS','W.WW.W.W'],boast:'My columns have impeccable manners.',hint:'Masonry stones break a support in one hit.',music:1},\n {name:'The High Keep',short:'HIGH KEEP',subtitle:'Lofty ideas. Loose masonry.',mood:'dusk',stone:'#a3a6bb',grass:'#7b827a',rows:['SS..SS.S','SS..SS.S','SS..SS.S','RS..SS.R','WW..WW.W','W....W.W'],boast:'Try not to miss the entire building.',hint:'Split stones fan out at their apex. Finish small pieces with roundstone.',music:2},\n {name:'Lakeside After Dark',short:'LAKESIDE',subtitle:'Torchlight and terrible decisions',mood:'castle-night',stone:'#878ca7',grass:'#576b70',rows:['SS..SSSS','WS..WWSS','WW..SSWW','.W..W.WW','....W..W.W'],boast:'A protected return\"'! How terribly sporting.'\"',hint:'Gold shields protect returning crew and launchers.',music:3},\n {name:'The Royal Final',short:'ROYAL FINAL',subtitle:'By appointment to His Rubbleness',mood:'dusk',stone:'#c7bdac',grass:'#74826a',rows:['RR..RRSS','SSSSSSSS','SS.SS.SS','WS.WS.SW','WW.WW.WW','W..WW..W'],boast:'There is only room for one royal ruin.',hint:'Read the surviving silhouette. Every support is an opportunity.',music:4}\n];\nexport const MATERIAL = {W:{name:'timber',hp:24},S:{name:'masonry',hp:38},R:{name:'reinforced',hp:72}};\nexport function layout(rows) {\n const b=[],w=19,h=18,x0=42,gap=1;\n for(let col=0;col<8;col++) b.push({id:b.length,x:x0+col*(w+gap),z:ARENA.ground-9,w,h:9,material:'S',foundation:true,support:[]});\n rows.forEach((row,r)=>[...row].forEach((m,c)=>{if(\"'!MATERIAL[m])return; b.push({id:b.length,x:x0+c*(w+gap),z:ARENA.ground+r*h,w,h,material:m,foundation:false,support:[]});}));\n for(const a of b.filter(a=>!a.foundation)) a.support=b.filter(q=>q.id!==a.id && (Math.abs(q.z+q.h-a.z)<.1 && Math.abs(q.x-a.x)<w+2 || q.z===a.z && Math.abs(q.x-a.x)<=w+gap+.1)).map(q=>q.id);\n return b;\n}\nexport const COURTS = specs.map((c,id)=>({...c,id,blocks:layout(c.rows)}));\nexport const RIVALS = [\n {name:'\"'Sir Crumb',title:'The enthusiastic amateur',kind:'rookie',reaction:2.4,error:.075,harass:.15,quote:'I practised on a very small shed.'},\n {name:'Dame Pebble',title:'The cheerful nuisance',kind:'harasser',reaction:1.6,error:.045,harass:.65,quote:'Your winch looks unusually hittable.'},\n {name:'Baron Bedrock',title:'The careful mason',kind:'mason',reaction:1.5,error:.025,harass:.12,quote:'A wall is only as good as its bottom.'},\n {name:'Lady Clatter',title:'The winch inspector',kind:'harasser',reaction:1.15,error:.028,harass:.8,quote:'Do take your time repairing that.'},\n {name:'Abbot Rubble',title:'The lofty demolisher',kind:'broad',reaction:1.25,error:.024,harass:.08,quote:'Bless this mess.'},\n {name:'Count Topple',title:'The patient finisher',kind:'mason',reaction:1.05,error:.022,harass:.22,quote:'A smaller target is still a target.'},\n {name:'Duchess Aftershock',title:'The night owl',kind:'adaptive',reaction:1,error:.025,harass:.55,quote:'Your return is most illuminating.'},\n {name:'Sir Plonk',title:'The relentless rumbler',kind:'adaptive',reaction:.85,error:.019,harass:.4,quote:'A moment of peace? Not on my watch.'},\n {name:'Queen Quarry',title:'Her Falling Majesty',kind:'final',reaction:.8,error:.015,harass:.35,quote:'I hereby declare your castle optional.'},\n {name:'Queen Quarry',title:'The royal rematch',kind:'final',reaction:.65,error:.012,harass:.5,quote:'Once more, with considerably less castle.'}\n];\nexport function castleBlocks(court,seat,scale=1) {return court.blocks.map(b=>({...b,x:seat?ARENA.width-b.x-b.w:b.x,support:[...b.support],hp:b.foundation?0:MATERIAL[b.material].hp*scale,max:b.foundation?0:MATERIAL[b.material].hp*scale}));}\nexport function connected(blocks,omit=new Set()) {\n const alive=new Set(blocks.filter(b=>(b.foundation||b.hp>0)&&\"'!omit.has(b.id)).map(b=>b.id));\n const seen=new Set(blocks.filter(b=>b.foundation).map(b=>b.id)),queue=[...seen],edges=new Map(blocks.map(b=>[b.id,[]]));\n for(const b of blocks)for(const id of b.support)if(edges.has(id)){edges.get(b.id).push(id);edges.get(id).push(b.id);}\n while(queue.length){for(const id of edges.get(queue.shift())||[])if(alive.has(id)&&!seen.has(id)){seen.add(id);queue.push(id);}}\n return seen;\n}\nexport function validateCourt(raw) {\n const errors=[];\n if(!raw||raw.version!==1||!raw.court||!Array.isArray(raw.court.blocks))return {ok:false,errors:['\"'Expected a version 1 court definition.']};\n const c=raw.court,b=c.blocks,ids=new Set();\n if(b.length<2||b.length>70)errors.push('Use 2–70 blocks.');\n for(const a of b){if(\"'!Number.isInteger(a.id)||ids.has(a.id))errors.push('\"'Block IDs must be unique integers.');ids.add(a.id);\n if(\"'![a.x,a.z,a.w,a.h].every(Number.isFinite)||a.x<20||a.x+a.w>205||a.z<20||a.z+a.h>180||a.w<6||a.w>60||a.h<5||a.h>40)errors.push('\"'Block dimensions outside the castle stage.');\n if(\"'!MATERIAL[a.material]||!Array.isArray(a.support)||typeof a.foundation!=='\"'boolean')errors.push('Invalid material, foundation or support role.');}\n for(const a of b)if(Array.isArray(a.support)&&a.support.some(id=>\"'!ids.has(id)||id===a.id))errors.push('\"'Support references must name another block.');\n if(\"'!b.some(a=>a.foundation)||!b.some(a=>!a.foundation))errors.push('\"'A court needs a foundation and objective blocks.');\n if(\"'!errors.length){const con=connected(b.map(a=>({...a,hp:1})));if(b.some(a=>!a.foundation&&!con.has(a.id)))errors.push('\"'An objective block is not connected to a foundation.');}\n return {ok:\"'!errors.length,errors:[...new Set(errors)],court:errors.length?null:{...COURTS[0],...c,id:clamp(Number(c.id)||0,0,4)}};\n}\nexport function exportCourt(court){return JSON.stringify({version:1,court:{...court,blocks:court.blocks.map(b=>({...b}))}},null,2);}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > src/config.js <<'EOF'\nexport const TITLE = 'Smithereens Under Siege';\nexport const VERSION = 1;\nexport const DT = 1 / 120;\nexport const ARENA = { width: 960, ground: 36, water: 16, launch: [245, 715], crew: [208, 752], angle: 50 * Math.PI / 180 };\nexport const STONES = [\n  { id: 0, name: 'Roundstone', short: 'ROUND', role: 'Pinpoint hits • quickest reload', color: '#d3e4e8', damage: 38, radius: 3.5, reload: .9 },\n  { id: 1, name: 'Masonry stone', short: 'MASONRY', role: 'Break supports • heavy damage', color: '#e7b976', damage: 79, radius: 5.5, reload: 1.55 },\n  { id: 2, name: 'Split stone', short: 'SPLIT', role: 'Three fragments • broad coverage', color: '#c3a4f5', damage: 28, radius: 3, reload: 2.1 }\n];\nexport const DEFAULTS = { chargeTime: 1.4, speed: 530, gravity: 260, roundReload: .9, heavyReload: 1.55, splitReload: 2.1, damage: 1, healthScale: 1, crewDisable: 1.8, launcherDisable: 2.6, protection: 1.25, aiError: 1, aiReaction: 1, assist: .35 };\nexport const TUNING = [\n  ['chargeTime','Charge to full (s)',.5,2.5,.05],['speed','Launch speed (u/s)',450,650,5],['gravity','Gravity (u/s²)',190,340,5],\n  ['roundReload','Round reload (s)',.3,2,.05],['heavyReload','Masonry reload (s)',.5,3,.05],['splitReload','Split reload (s)',.5,4,.05],\n  ['damage','Damage multiplier',.3,3,.1],['healthScale','Block health multiplier',.5,3,.1],['crewDisable','Crew retreat (s)',.5,4,.1],\n  ['launcherDisable','Launcher repair (s)',.5,5,.1],['protection','Return protection (s)',.5,3,.05],['aiError','AI range error',0,3,.1],['aiReaction','AI reaction multiplier',.25,3,.05],['assist','Timing assist',0,1,.05]\n];\nexport const clamp = (v,a,b) => Math.min(b,Math.max(a,v));\nexport const tickOf = s => Math.round(s / DT);\nexport function tuning(input = {}) { const out = {...DEFAULTS}; for (const [k,,lo,hi] of TUNING) if (Number.isFinite(input[k])) out[k] = clamp(input[k],lo,hi); return out; }\nexport function rngStep(w) { let a = w.rng = (w.rng + 0x6d2b79f5) >>> 0; a = Math.imul(a \"'^ a >>> 15, a | 1); a ''^= a + Math.imul(a ''^ a >>> 7, a | 61); return ((a ''^ a >>> 14) >>> 0) / 4294967296; }\nEOF\ncat > src/content.js <<'\"'EOF'\nimport { ARENA, clamp } from './config.js';\nconst specs = [\n {name:'The Village Exhibition',short:'VILLAGE',subtitle:'A most uncivil afternoon',mood:'day',stone:'#b5b3a2',grass:'#6f8855',rows:['SS.SS.SS','SS.SS.SS','WW.WW.WW'],boast:'A fine day to lower the neighbourhood\"'!'\"',hint:'Hold, watch the landing diamond, release.',music:0},\n {name:'The Quarry Meet',short:'QUARRY',subtitle:'Mind the load-bearing bits',mood:'desert',stone:'#d6bd95',grass:'#999262',rows:['.R..R..R','SSSSSSSS','SSSSSSSS','W.WW.W.W'],boast:'My columns have impeccable manners.',hint:'Masonry stones break a support in one hit.',music:1},\n {name:'The High Keep',short:'HIGH KEEP',subtitle:'Lofty ideas. Loose masonry.',mood:'dusk',stone:'#a3a6bb',grass:'#7b827a',rows:['SS..SS.S','SS..SS.S','SS..SS.S','RS..SS.R','WW..WW.W','W....W.W'],boast:'Try not to miss the entire building.',hint:'Split stones fan out at their apex. Finish small pieces with roundstone.',music:2},\n {name:'Lakeside After Dark',short:'LAKESIDE',subtitle:'Torchlight and terrible decisions',mood:'castle-night',stone:'#878ca7',grass:'#576b70',rows:['SS..SSSS','WS..WWSS','WW..SSWW','.W..W.WW','....W..W.W'],boast:'A protected return\"'! How terribly sporting.'\"',hint:'Gold shields protect returning crew and launchers.',music:3},\n {name:'The Royal Final',short:'ROYAL FINAL',subtitle:'By appointment to His Rubbleness',mood:'dusk',stone:'#c7bdac',grass:'#74826a',rows:['RR..RRSS','SSSSSSSS','SS.SS.SS','WS.WS.SW','WW.WW.WW','W..WW..W'],boast:'There is only room for one royal ruin.',hint:'Read the surviving silhouette. Every support is an opportunity.',music:4}\n];\nexport const MATERIAL = {W:{name:'timber',hp:24},S:{name:'masonry',hp:38},R:{name:'reinforced',hp:72}};\nexport function layout(rows) {\n const b=[],w=19,h=18,x0=42,gap=1;\n for(let col=0;col<8;col++) b.push({id:b.length,x:x0+col*(w+gap),z:ARENA.ground-9,w,h:9,material:'S',foundation:true,support:[]});\n rows.forEach((row,r)=>[...row].forEach((m,c)=>{if(\"'!MATERIAL[m])return; b.push({id:b.length,x:x0+c*(w+gap),z:ARENA.ground+r*h,w,h,material:m,foundation:false,support:[]});}));\n for(const a of b.filter(a=>!a.foundation)) a.support=b.filter(q=>q.id!==a.id && (Math.abs(q.z+q.h-a.z)<.1 && Math.abs(q.x-a.x)<w+2 || q.z===a.z && Math.abs(q.x-a.x)<=w+gap+.1)).map(q=>q.id);\n return b;\n}\nexport const COURTS = specs.map((c,id)=>({...c,id,blocks:layout(c.rows)}));\nexport const RIVALS = [\n {name:'\"'Sir Crumb',title:'The enthusiastic amateur',kind:'rookie',reaction:2.4,error:.075,harass:.15,quote:'I practised on a very small shed.'},\n {name:'Dame Pebble',title:'The cheerful nuisance',kind:'harasser',reaction:1.6,error:.045,harass:.65,quote:'Your winch looks unusually hittable.'},\n {name:'Baron Bedrock',title:'The careful mason',kind:'mason',reaction:1.5,error:.025,harass:.12,quote:'A wall is only as good as its bottom.'},\n {name:'Lady Clatter',title:'The winch inspector',kind:'harasser',reaction:1.15,error:.028,harass:.8,quote:'Do take your time repairing that.'},\n {name:'Abbot Rubble',title:'The lofty demolisher',kind:'broad',reaction:1.25,error:.024,harass:.08,quote:'Bless this mess.'},\n {name:'Count Topple',title:'The patient finisher',kind:'mason',reaction:1.05,error:.022,harass:.22,quote:'A smaller target is still a target.'},\n {name:'Duchess Aftershock',title:'The night owl',kind:'adaptive',reaction:1,error:.025,harass:.55,quote:'Your return is most illuminating.'},\n {name:'Sir Plonk',title:'The relentless rumbler',kind:'adaptive',reaction:.85,error:.019,harass:.4,quote:'A moment of peace? Not on my watch.'},\n {name:'Queen Quarry',title:'Her Falling Majesty',kind:'final',reaction:.8,error:.015,harass:.35,quote:'I hereby declare your castle optional.'},\n {name:'Queen Quarry',title:'The royal rematch',kind:'final',reaction:.65,error:.012,harass:.5,quote:'Once more, with considerably less castle.'}\n];\nexport function castleBlocks(court,seat,scale=1) {return court.blocks.map(b=>({...b,x:seat?ARENA.width-b.x-b.w:b.x,support:[...b.support],hp:b.foundation?0:MATERIAL[b.material].hp*scale,max:b.foundation?0:MATERIAL[b.material].hp*scale}));}\nexport function connected(blocks,omit=new Set()) {\n const alive=new Set(blocks.filter(b=>(b.foundation||b.hp>0)&&\"'!omit.has(b.id)).map(b=>b.id));\n const seen=new Set(blocks.filter(b=>b.foundation).map(b=>b.id)),queue=[...seen],edges=new Map(blocks.map(b=>[b.id,[]]));\n for(const b of blocks)for(const id of b.support)if(edges.has(id)){edges.get(b.id).push(id);edges.get(id).push(b.id);}\n while(queue.length){for(const id of edges.get(queue.shift())||[])if(alive.has(id)&&!seen.has(id)){seen.add(id);queue.push(id);}}\n return seen;\n}\nexport function validateCourt(raw) {\n const errors=[];\n if(!raw||raw.version!==1||!raw.court||!Array.isArray(raw.court.blocks))return {ok:false,errors:['\"'Expected a version 1 court definition.']};\n const c=raw.court,b=c.blocks,ids=new Set();\n if(b.length<2||b.length>70)errors.push('Use 2–70 blocks.');\n for(const a of b){if(\"'!Number.isInteger(a.id)||ids.has(a.id))errors.push('\"'Block IDs must be unique integers.');ids.add(a.id);\n if(\"'![a.x,a.z,a.w,a.h].every(Number.isFinite)||a.x<20||a.x+a.w>205||a.z<20||a.z+a.h>180||a.w<6||a.w>60||a.h<5||a.h>40)errors.push('\"'Block dimensions outside the castle stage.');\n if(\"'!MATERIAL[a.material]||!Array.isArray(a.support)||typeof a.foundation!=='\"'boolean')errors.push('Invalid material, foundation or support role.');}\n for(const a of b)if(Array.isArray(a.support)&&a.support.some(id=>\"'!ids.has(id)||id===a.id))errors.push('\"'Support references must name another block.');\n if(\"'!b.some(a=>a.foundation)||!b.some(a=>!a.foundation))errors.push('\"'A court needs a foundation and objective blocks.');\n if(\"'!errors.length){const con=connected(b.map(a=>({...a,hp:1})));if(b.some(a=>!a.foundation&&!con.has(a.id)))errors.push('\"'An objective block is not connected to a foundation.');}\n return {ok:\"'!errors.length,errors:[...new Set(errors)],court:errors.length?null:{...COURTS[0],...c,id:clamp(Number(c.id)||0,0,4)}};\n}\nexport function exportCourt(court){return JSON.stringify({version:1,court:{...court,blocks:court.blocks.map(b=>({...b}))}},null,2);}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"agent_message","text":"The shared combat model is taking shape around a fixed 120 Hz simulation, swept projectile collisions, and authored support graphs. I’m keeping it independent of rendering so solo, local versus, AI, and Hub play can use the same rules and tests.\n"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim.js <<'EOF'\nimport { ARENA, STONES, DEFAULTS, DT, clamp, tickOf, tuning, rngStep } from './config.js';\nimport { COURTS, RIVALS, castleBlocks, connected } from './content.js';\n\nexport function createWorld(o={}) {\n const court=o.customCourt||COURTS[o.court??Math.floor((o.bout||0)/2)%5];\n return {version:1,tick:0,seed:o.seed||71,rng:o.seed||71,mode:o.mode||'quick',court:court.id,courtDef:court,bout:o.bout||0,phase:'playing',deadline:tickOf(o.duration||90),config:tuning(o.config),allowed:o.allowed||[0,1,2],\n players:[0,1].map(seat=>({seat,stone:0,held:false,charge:-1,chargeTime:1.4,ready:0,crewUntil:0,launcherUntil:0,protectUntil:0,seq:-1,score:0,last:[null,null,null],launchTick:-1000,returnTick:-1000})),\n castles:[castleBlocks(court,0,o.config?.healthScale||1),castleBlocks(court,1,o.config?.healthScale||1)],shots:[],throws:{},nextShot:1,events:[],coverage:{launch:[0,0,0],castle:0,crew:0,launcher:0,collapse:0,split:0,recovery:0,cancel:0,results:0},revision:0,outcome:null,cheated:false,invulnerable:false};\n}\nexport function emit(w,type,fields={}) {w.events.push({type,tick:w.tick,...fields});if(w.events.length>160)w.events.splice(0,w.events.length-160);}\nexport function readyAt(p){return Math.max(p.ready,p.crewUntil,p.launcherUntil);}\nexport function canAct(w,p){return w.phase==='playing'&&w.tick>=readyAt(p);}\nexport function powerOf(w,p){return p.charge<0?0:clamp((w.tick-p.charge)*DT/p.chargeTime,0,1);}\nexport function cancel(w,seat,feedback=true){const p=w.players[seat];if(\"'!p)return;p.held=false;p.charge=-1;if(feedback){w.coverage.cancel++;emit(w,'\"'cancel',{seat});}}\nexport function command(w,seat,c) {\n const p=w.players[seat];if(\"'!p||!c||w.phase!=='\"'playing')return false;\n if(c.seq\"'!==undefined){if(!Number.isSafeInteger(c.seq)||c.seq<=p.seq)return false;p.seq=c.seq;}\n if(c.kind==='\"'cancel'){cancel(w,seat);return true;}\n if(c.kind==='stone'){if(p.charge>=0||\"'!w.allowed.includes(c.stone)||!Number.isInteger(c.stone))return false;p.stone=c.stone;return true;}\n if(c.kind==='\"'begin'){if(p.held||w.tick<p.crewUntil||w.tick<p.launcherUntil)return false;p.held=true;if(canAct(w,p))begin(w,p);return true;}\n if(c.kind==='release'){\n  const active=p.held&&p.charge>=0; p.held=false;\n  if(\"'!active){p.charge=-1;return false;}\n  let power=powerOf(w,p);\n  if(Number.isFinite(c.duration)) { // Host-validated local hold duration; authority still owns availability and begin.\n   const elapsed=(w.tick-p.charge)*DT;\n   power=clamp(clamp(c.duration,Math.max(0,elapsed-.32),elapsed+.32)/p.chargeTime,0,1);\n  }\n  p.charge=-1;\n  if(power<.065){w.coverage.cancel++;emit(w,'\"'cancel',{seat,short:true});return true;}\n  launch(w,seat,power);return true;\n }\n return false;\n}\nfunction begin(w,p){p.charge=w.tick;p.chargeTime=w.config.chargeTime;emit(w,'wind',{seat:p.seat});}\nexport function projectile(w,seat,stone,power) {\n const dir=seat?-1:1,speed=100+(w.config.speed-100)*clamp(power,0,1);\n return {id:w.nextShot,throw:w.nextShot,seat,stone,x:ARENA.launch[seat]+dir*12,z:ARENA.ground+24,vx:dir*Math.cos(ARENA.angle)*speed,vz:Math.sin(ARENA.angle)*speed,g:w.config.gravity,age:0,fragment:false};\n}\nfunction launch(w,seat,power){\n const p=w.players[seat],s=projectile(w,seat,p.stone,power);w.nextShot++;\n w.shots.push(s);w.throws[s.throw]={targets:[],tick:w.tick};p.launchTick=w.tick;\n p.ready=w.tick+tickOf([w.config.roundReload,w.config.heavyReload,w.config.splitReload][p.stone]);\n w.coverage.launch[p.stone]++;emit(w,'launch',{seat,stone:p.stone,power,x:s.x,z:s.z,id:s.throw});\n}\n// Slab intersection of the complete step against a radius-expanded target.\nexport function sweep(x,z,nx,nz,b,r=0){\n let lo=0,hi=1;for(const [a,d,min,max]of[[x,nx-x,b.x-r,b.x+b.w+r],[z,nz-z,b.z-r,b.z+b.h+r]]){\n  if(Math.abs(d)<1e-10){if(a<min||a>max)return null;continue;}\n  let a0=(min-a)/d,a1=(max-a)/d;if(a0>a1)[a0,a1]=[a1,a0];lo=Math.max(lo,a0);hi=Math.min(hi,a1);if(lo>hi)return null;\n }return lo;\n}\nexport function targets(w,seat){const p=w.players[seat],out=w.castles[seat].filter(b=>\"'!b.foundation&&b.hp>0).map(b=>({...b,kind:'\"'castle',seat,key:\"'`b${seat}:${b.id}`}));\n if(w.tick>=p.crewUntil)out.push({x:ARENA.crew[seat]-7,z:ARENA.ground,w:14,h:29,kind:'\"'crew',seat,key:\"'`c${seat}`});\n if(w.tick>=p.launcherUntil)out.push({x:ARENA.launch[seat]-18,z:ARENA.ground,w:36,h:24,kind:'\"'launcher',seat,key:\"'`l${seat}`});\n return out;\n}\nexport function stepProjectile(w,s,dt=DT,list=targets(w,1-s.seat)){\n const nx=s.x+s.vx*dt,nz=s.z+s.vz*dt-.5*s.g*dt*dt;let best=null;\n const r=s.fragment?2:STONES[s.stone].radius;\n for(const b of list){const t=sweep(s.x,s.z,nx,nz,b,r);if(t!==null&&(!best||t<best.t-1e-9||Math.abs(t-best.t)<1e-9&&b.key<best.target.key))best={t,target:b};}\n const surface=(s.x+nx)/2>300&&(s.x+nx)/2<660?ARENA.water:ARENA.ground-1;\n if(nz<=surface){const t=clamp((s.z-surface)/(s.z-nz||1),0,1);if(!best||t<best.t)best={t,target:{kind:surface===ARENA.water?'\"'water':'ground',key:'~ground'}};}\n s.x+= (nx-s.x)*(best?best.t:1);s.z+=(nz-s.z)*(best?best.t:1);s.vz-=s.g*dt;s.age+=dt;\n if(best)return {...best.target,x:s.x,z:s.z,time:s.age};\n if(s.x< -60||s.x>1020||s.age>8)return {kind:'away',x:s.x,z:s.z,time:s.age};\n return null;\n}\nexport function fragments(s){return [-1,0,1].map((k,i)=>({...s,id:s.id*10+i+1,vx:s.vx*(1+k*.075),vz:10+k*9,fragment:true,age:s.age}));}\nexport function predict(w,seat,stone,power,{path=false}={}){\n const s=projectile(w,seat,stone,power),todo=[s],hits=[],points=[],list=targets(w,1-seat);let n=0;\n while(todo.length&&n++<5000){const a=todo.shift();let hit=null;\n  for(let i=0;i<1100;i++){\n   hit=stepProjectile(w,a,DT,list);if(path&&i%8===0)points.push([a.x,a.z]);\n   if(hit){hits.push({...hit,stone,fragment:a.fragment});break;}\n   if(stone===2&&\"'!a.fragment&&a.vz<=0){todo.push(...fragments(a));break;}\n  }\n }\n return {hits,points};\n}\nexport function health(w,seat){const b=w.castles[seat];return b.reduce((s,a)=>s+a.hp,0)/(b.reduce((s,a)=>s+a.max,0)||1);}\nexport function remaining(w,seat){return w.castles[seat].filter(b=>!b.foundation&&b.hp>0).length;}\nexport function collapse(w,seat){const b=w.castles[seat],seen=connected(b),lost=b.filter(a=>!a.foundation&&a.hp>0&&!seen.has(a.id));\n for(const a of lost){a.hp=0;emit(w,'\"'fall',{seat,id:a.id,x:a.x,z:a.z,w:a.w,h:a.h,material:a.material});}\n if(lost.length){w.coverage.collapse+=lost.length;w.revision++;emit(w,'collapse',{seat,count:lost.length});}return lost.length;\n}\nexport function resolveImpact(w,s,hit){\n const p=w.players[s.seat],enemy=w.players[1-s.seat],tr=w.throws[s.throw]||(w.throws[s.throw]={targets:[],tick:w.tick});\n p.last[s.stone]={x:hit.x,z:hit.z,kind:hit.kind,tick:w.tick};\n if(hit.kind==='castle'){\n  const b=w.castles[hit.seat].find(a=>a.id===hit.id);if(\"'!b||b.hp<=0)return;\n  if(!tr.targets.includes(hit.key)){p.score+=3;tr.targets.push(hit.key);}\n  if(!w.invulnerable)b.hp=Math.max(0,b.hp-STONES[s.stone].damage*w.config.damage*(s.fragment?.8:1));\n  w.coverage.castle++;w.revision++;\n  emit(w,'\"'hit',{seat:hit.seat,by:s.seat,kind:'castle',x:hit.x,z:hit.z,stone:s.stone,id:b.id});\n  if(b.hp===0)emit(w,'fall',{seat:hit.seat,id:b.id,x:b.x,z:b.z,w:b.w,h:b.h,material:b.material});\n  // A heavy stone chips its immediate neighbours, without extra direct-hit score.\n  if(s.stone===1&&\"'!w.invulnerable)for(const a of w.castles[hit.seat])if(a.id!==b.id&&!a.foundation&&a.hp>0&&Math.hypot(a.x-b.x,a.z-b.z)<23){const hp=a.hp;a.hp=Math.max(0,a.hp-20*w.config.damage);if(hp>0&&a.hp===0)emit(w,'\"'fall',{seat:hit.seat,id:a.id,x:a.x,z:a.z,w:a.w,h:a.h,material:a.material});}\n  collapse(w,hit.seat);\n } else if(hit.kind==='crew'||hit.kind==='launcher'){\n  const until=Math.max(enemy.crewUntil,enemy.launcherUntil);\n  if(tr.targets.includes(hit.key)||w.tick<enemy[hit.kind==='crew'?'crewUntil':'launcherUntil']||w.tick>=until&&w.tick<enemy.protectUntil){emit(w,'shield',{seat:hit.seat,x:hit.x,z:hit.z});return;}\n  tr.targets.push(hit.key);p.score+=hit.kind==='crew'?7:13;\n  enemy[hit.kind==='crew'?'crewUntil':'launcherUntil']=w.tick+tickOf(hit.kind==='crew'?w.config.crewDisable:w.config.launcherDisable);\n  enemy.protectUntil=Math.max(enemy.crewUntil,enemy.launcherUntil)+tickOf(w.config.protection);cancel(w,hit.seat,false);\n  w.coverage[hit.kind]++;emit(w,'hit',{seat:hit.seat,by:s.seat,kind:hit.kind,x:hit.x,z:hit.z,stone:s.stone});\n }else if(hit.kind\"'!=='\"'away')emit(w,hit.kind,{x:hit.x,z:hit.z,seat:s.seat});\n}\nexport function finish(w,reason='timeout',forced){\n if(w.outcome)return w.outcome;\n let winner=forced;\n if(winner===undefined){const a=remaining(w,0),b=remaining(w,1);if(\"'!a||!b)winner=!a&&!b?-1:a?0:1;\n else {const delta=health(w,0)-health(w,1);winner=Math.abs(delta)>1e-9?delta>0?0:1:w.players[0].score===w.players[1].score?-1:w.players[0].score>w.players[1].score?0:1;}}\n w.phase='\"'ceremony';w.outcome={winner,reason,tick:w.tick,direct:w.players.map(p=>p.score),banked:w.players.map((p,i)=>i===winner?p.score*(w.bout+1):0),health:[health(w,0),health(w,1)]};\n w.players.forEach(p=>cancel(w,p.seat,false));w.shots=[];w.coverage.results++;emit(w,'outcome',w.outcome);return w.outcome;\n}\nexport function step(w){if(w.phase\"'!=='\"'playing')return;w.tick++;\n for(const p of w.players){\n  if(p.held&&p.charge<0&&canAct(w,p))begin(w,p);\n  const end=Math.max(p.crewUntil,p.launcherUntil);if(end>0&&end===w.tick){p.returnTick=w.tick;w.coverage.recovery++;emit(w,'recovery',{seat:p.seat});}\n }\n const impacts=[],next=[];\n for(const s of w.shots){const hit=stepProjectile(w,s);if(hit)impacts.push([s,hit]);else if(s.stone===2&&\"'!s.fragment&&s.vz<=0){next.push(...fragments(s));w.coverage.split++;emit(w,'\"'split',{x:s.x,z:s.z,seat:s.seat});}else next.push(s);}\n w.shots=next;for(const [s,h] of impacts)resolveImpact(w,s,h);\n if(\"'!remaining(w,0)||!remaining(w,1))finish(w,'\"'demolition');else if(w.tick>=w.deadline)finish(w,'timeout');\n for(const id in w.throws)if(w.tick-w.throws[id].tick>tickOf(12))delete w.throws[id];\n}\nexport function advance(w,seconds){for(let i=0;i<Math.round(seconds/DT);i++)step(w);return w;}\nexport function applyTuning(w,changes){const old=w.config;w.config=tuning({...old,...changes});if(old.healthScale\"'!==w.config.healthScale){for(const blocks of w.castles)for(const b of blocks)if(!b.foundation){const f=b.hp/b.max;b.max=b.max/old.healthScale*w.config.healthScale;b.hp=b.max*f;}}w.cheated=true;}\nexport function shotValue(w,seat,result,profile){\n let value=-5;const seen=new Set();for(const h of result.hits){if(h.kind==='\"'castle'){\n  if(seen.has(h.key))continue;seen.add(h.key);const b=w.castles[1-seat].find(a=>a.id===h.id);if(\"'!b)continue;\n  const dmg=STONES[h.stone].damage*(h.fragment?.8:1)*w.config.damage;value+=Math.min(b.hp,dmg)*.16+3;\n  if(dmg>=b.hp){const after=connected(w.castles[1-seat],new Set([b.id]));value+=w.castles[1-seat].filter(a=>!a.foundation&&a.hp>0&&!after.has(a.id)).length*7;}\n  if(profile.kind==='\"'broad'&&h.stone===2)value+=3;\n }else if(h.kind==='crew'||h.kind==='launcher'){\n  const p=w.players[1-seat],at=w.tick+tickOf(h.time);if(at>=p.protectUntil&&at>=readyAt(p))value+=(h.kind==='launcher'?13:8)*profile.harass+(p.charge>=0?4:0);\n }}return value;\n}\nexport function planShot(w,seat,profile=RIVALS[8],goal=null){\n let best=null;const choices=[];\n const powers=[];for(let p=.12;p<=.991;p+=profile.kind==='rookie'?.018:.009)powers.push(p);\n for(const stone of w.allowed)for(const power of powers){const pred=predict(w,seat,stone,power);let v=shotValue(w,seat,pred,profile)-[0,1,2][stone]*.9;\n  if(goal){v=pred.hits.some(h=>h.kind===goal)?50+v:goal==='castle'?v:-100;}\n  if(\"'!best||v>best.value){best={stone,power,value:v,hits:pred.hits};}if(v>0)choices.push({stone,power,value:v,hits:pred.hits});}\n return best||{stone:0,power:.7,value:0,hits:[]};\n}\nexport function createAI(profile=RIVALS[0]){return {profile,at:0,plan:null,goal:null,seen:-1,release:0,shots:0};}\nexport function aiStep(w,seat,ai){\n if(w.phase!=='\"'playing')return;const p=w.players[seat];\n if(p.charge>=0){if(w.tick>=ai.release)command(w,seat,{kind:'release'});return;}\n if(\"'!canAct(w,p)||p.held){ai.plan=null;return;}\n if(w.tick<ai.at)return;\n if(!ai.plan){\n  ai.plan=planShot(w,seat,ai.profile,ai.goal);const error=(rngStep(w)-.5)*2*ai.profile.error*w.config.aiError;\n  ai.plan.power=clamp(ai.plan.power+error,.09,.97);ai.at=w.tick+tickOf(ai.profile.reaction*w.config.aiReaction*(.8+rngStep(w)*.4));ai.seen=w.revision;return;\n }\n if(ai.seen!==w.revision){ai.plan=planShot(w,seat,ai.profile,ai.goal);ai.seen=w.revision;}\n command(w,seat,{kind:'\"'stone',stone:ai.plan.stone});command(w,seat,{kind:'begin'});\n ai.release=w.tick+tickOf(ai.plan.power*p.chargeTime);ai.plan=null;ai.shots++;ai.at=w.tick+tickOf(ai.profile.reaction*w.config.aiReaction);\n}\n// Compact full-state packets repair any lost prior snapshot; all geometry is regenerated from the court ID.\nexport function pack(w,seq=0){return {t:'s',v:1,n:seq,k:w.tick,c:w.court,b:w.bout,d:w.deadline,r:w.rng,i:w.nextShot,f:w.phase==='playing'?0:1,\n p:w.players.map(p=>[p.stone,+p.held,p.charge,Math.round(p.chargeTime*1000),p.ready,p.crewUntil,p.launcherUntil,p.protectUntil,p.seq,p.score,p.launchTick]),\n h:w.castles.map(bs=>bs.filter(b=>\"'!b.foundation).map(b=>Math.round(b.hp/b.max*255).toString(16).padStart(2,'\"'0')).join('')),\n s:w.shots.map(s=>[s.id,s.throw,s.seat,s.stone,...[s.x,s.z,s.vx,s.vz].map(v=>Math.round(v*10)),Math.round(s.g),+s.fragment,Math.round(s.age*100)]),o:w.outcome? [w.outcome.winner,w.outcome.reason,w.outcome.tick,...w.outcome.direct]:null};}\nexport function unpack(w,s){\n if(\"'!s||s.v!==1||!Number.isInteger(s.k)||s.k<w.tick||s.c!==w.court||!Array.isArray(s.p)||s.p.length!==2||!Array.isArray(s.h)||!Array.isArray(s.s))return false;\n w.tick=s.k;w.deadline=s.d;w.rng=s.r;w.nextShot=s.i;w.phase=s.f?'\"'ceremony':'playing';\n for(let i=0;i<2;i++){const a=s.p[i],p=w.players[i];[p.stone,p.held,p.charge,p.chargeTime,p.ready,p.crewUntil,p.launcherUntil,p.protectUntil,p.seq,p.score,p.launchTick]=a;p.chargeTime/=1000;p.held=\"'!!p.held;\n let j=0;for(const b of w.castles[i])if(!b.foundation){b.hp=parseInt(s.h[i].slice(j,j+2),16)/255*b.max;j+=2;}}\n w.shots=s.s.map(a=>({id:a[0],throw:a[1],seat:a[2],stone:a[3],x:a[4]/10,z:a[5]/10,vx:a[6]/10,vz:a[7]/10,g:a[8],fragment:!!a[9],age:a[10]/100}));\n if(s.o){const a=s.o;w.outcome={winner:a[0],reason:a[1],tick:a[2],direct:[a[3],a[4]],banked:[0,0],health:[health(w,0),health(w,1)]};}return true;\n}\nEOF\nnode --input-type=module <<'\"'JS'\nimport { COURTS,validateCourt } from './src/content.js';\nimport {createWorld,planShot} from './src/sim.js';\nconsole.log(COURTS.map(c=>[c.short,c.blocks.length,validateCourt({version:1,court:c}).errors]));console.log(planShot(createWorld(),0));\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim.js <<'EOF'\nimport { ARENA, STONES, DEFAULTS, DT, clamp, tickOf, tuning, rngStep } from './config.js';\nimport { COURTS, RIVALS, castleBlocks, connected } from './content.js';\n\nexport function createWorld(o={}) {\n const court=o.customCourt||COURTS[o.court??Math.floor((o.bout||0)/2)%5];\n return {version:1,tick:0,seed:o.seed||71,rng:o.seed||71,mode:o.mode||'quick',court:court.id,courtDef:court,bout:o.bout||0,phase:'playing',deadline:tickOf(o.duration||90),config:tuning(o.config),allowed:o.allowed||[0,1,2],\n players:[0,1].map(seat=>({seat,stone:0,held:false,charge:-1,chargeTime:1.4,ready:0,crewUntil:0,launcherUntil:0,protectUntil:0,seq:-1,score:0,last:[null,null,null],launchTick:-1000,returnTick:-1000})),\n castles:[castleBlocks(court,0,o.config?.healthScale||1),castleBlocks(court,1,o.config?.healthScale||1)],shots:[],throws:{},nextShot:1,events:[],coverage:{launch:[0,0,0],castle:0,crew:0,launcher:0,collapse:0,split:0,recovery:0,cancel:0,results:0},revision:0,outcome:null,cheated:false,invulnerable:false};\n}\nexport function emit(w,type,fields={}) {w.events.push({type,tick:w.tick,...fields});if(w.events.length>160)w.events.splice(0,w.events.length-160);}\nexport function readyAt(p){return Math.max(p.ready,p.crewUntil,p.launcherUntil);}\nexport function canAct(w,p){return w.phase==='playing'&&w.tick>=readyAt(p);}\nexport function powerOf(w,p){return p.charge<0?0:clamp((w.tick-p.charge)*DT/p.chargeTime,0,1);}\nexport function cancel(w,seat,feedback=true){const p=w.players[seat];if(\"'!p)return;p.held=false;p.charge=-1;if(feedback){w.coverage.cancel++;emit(w,'\"'cancel',{seat});}}\nexport function command(w,seat,c) {\n const p=w.players[seat];if(\"'!p||!c||w.phase!=='\"'playing')return false;\n if(c.seq\"'!==undefined){if(!Number.isSafeInteger(c.seq)||c.seq<=p.seq)return false;p.seq=c.seq;}\n if(c.kind==='\"'cancel'){cancel(w,seat);return true;}\n if(c.kind==='stone'){if(p.charge>=0||\"'!w.allowed.includes(c.stone)||!Number.isInteger(c.stone))return false;p.stone=c.stone;return true;}\n if(c.kind==='\"'begin'){if(p.held||w.tick<p.crewUntil||w.tick<p.launcherUntil)return false;p.held=true;if(canAct(w,p))begin(w,p);return true;}\n if(c.kind==='release'){\n  const active=p.held&&p.charge>=0; p.held=false;\n  if(\"'!active){p.charge=-1;return false;}\n  let power=powerOf(w,p);\n  if(Number.isFinite(c.duration)) { // Host-validated local hold duration; authority still owns availability and begin.\n   const elapsed=(w.tick-p.charge)*DT;\n   power=clamp(clamp(c.duration,Math.max(0,elapsed-.32),elapsed+.32)/p.chargeTime,0,1);\n  }\n  p.charge=-1;\n  if(power<.065){w.coverage.cancel++;emit(w,'\"'cancel',{seat,short:true});return true;}\n  launch(w,seat,power);return true;\n }\n return false;\n}\nfunction begin(w,p){p.charge=w.tick;p.chargeTime=w.config.chargeTime;emit(w,'wind',{seat:p.seat});}\nexport function projectile(w,seat,stone,power) {\n const dir=seat?-1:1,speed=100+(w.config.speed-100)*clamp(power,0,1);\n return {id:w.nextShot,throw:w.nextShot,seat,stone,x:ARENA.launch[seat]+dir*12,z:ARENA.ground+24,vx:dir*Math.cos(ARENA.angle)*speed,vz:Math.sin(ARENA.angle)*speed,g:w.config.gravity,age:0,fragment:false};\n}\nfunction launch(w,seat,power){\n const p=w.players[seat],s=projectile(w,seat,p.stone,power);w.nextShot++;\n w.shots.push(s);w.throws[s.throw]={targets:[],tick:w.tick};p.launchTick=w.tick;\n p.ready=w.tick+tickOf([w.config.roundReload,w.config.heavyReload,w.config.splitReload][p.stone]);\n w.coverage.launch[p.stone]++;emit(w,'launch',{seat,stone:p.stone,power,x:s.x,z:s.z,id:s.throw});\n}\n// Slab intersection of the complete step against a radius-expanded target.\nexport function sweep(x,z,nx,nz,b,r=0){\n let lo=0,hi=1;for(const [a,d,min,max]of[[x,nx-x,b.x-r,b.x+b.w+r],[z,nz-z,b.z-r,b.z+b.h+r]]){\n  if(Math.abs(d)<1e-10){if(a<min||a>max)return null;continue;}\n  let a0=(min-a)/d,a1=(max-a)/d;if(a0>a1)[a0,a1]=[a1,a0];lo=Math.max(lo,a0);hi=Math.min(hi,a1);if(lo>hi)return null;\n }return lo;\n}\nexport function targets(w,seat){const p=w.players[seat],out=w.castles[seat].filter(b=>\"'!b.foundation&&b.hp>0).map(b=>({...b,kind:'\"'castle',seat,key:\"'`b${seat}:${b.id}`}));\n if(w.tick>=p.crewUntil)out.push({x:ARENA.crew[seat]-7,z:ARENA.ground,w:14,h:29,kind:'\"'crew',seat,key:\"'`c${seat}`});\n if(w.tick>=p.launcherUntil)out.push({x:ARENA.launch[seat]-18,z:ARENA.ground,w:36,h:24,kind:'\"'launcher',seat,key:\"'`l${seat}`});\n return out;\n}\nexport function stepProjectile(w,s,dt=DT,list=targets(w,1-s.seat)){\n const nx=s.x+s.vx*dt,nz=s.z+s.vz*dt-.5*s.g*dt*dt;let best=null;\n const r=s.fragment?2:STONES[s.stone].radius;\n for(const b of list){const t=sweep(s.x,s.z,nx,nz,b,r);if(t!==null&&(!best||t<best.t-1e-9||Math.abs(t-best.t)<1e-9&&b.key<best.target.key))best={t,target:b};}\n const surface=(s.x+nx)/2>300&&(s.x+nx)/2<660?ARENA.water:ARENA.ground-1;\n if(nz<=surface){const t=clamp((s.z-surface)/(s.z-nz||1),0,1);if(!best||t<best.t)best={t,target:{kind:surface===ARENA.water?'\"'water':'ground',key:'~ground'}};}\n s.x+= (nx-s.x)*(best?best.t:1);s.z+=(nz-s.z)*(best?best.t:1);s.vz-=s.g*dt;s.age+=dt;\n if(best)return {...best.target,x:s.x,z:s.z,time:s.age};\n if(s.x< -60||s.x>1020||s.age>8)return {kind:'away',x:s.x,z:s.z,time:s.age};\n return null;\n}\nexport function fragments(s){return [-1,0,1].map((k,i)=>({...s,id:s.id*10+i+1,vx:s.vx*(1+k*.075),vz:10+k*9,fragment:true,age:s.age}));}\nexport function predict(w,seat,stone,power,{path=false}={}){\n const s=projectile(w,seat,stone,power),todo=[s],hits=[],points=[],list=targets(w,1-seat);let n=0;\n while(todo.length&&n++<5000){const a=todo.shift();let hit=null;\n  for(let i=0;i<1100;i++){\n   hit=stepProjectile(w,a,DT,list);if(path&&i%8===0)points.push([a.x,a.z]);\n   if(hit){hits.push({...hit,stone,fragment:a.fragment});break;}\n   if(stone===2&&\"'!a.fragment&&a.vz<=0){todo.push(...fragments(a));break;}\n  }\n }\n return {hits,points};\n}\nexport function health(w,seat){const b=w.castles[seat];return b.reduce((s,a)=>s+a.hp,0)/(b.reduce((s,a)=>s+a.max,0)||1);}\nexport function remaining(w,seat){return w.castles[seat].filter(b=>!b.foundation&&b.hp>0).length;}\nexport function collapse(w,seat){const b=w.castles[seat],seen=connected(b),lost=b.filter(a=>!a.foundation&&a.hp>0&&!seen.has(a.id));\n for(const a of lost){a.hp=0;emit(w,'\"'fall',{seat,id:a.id,x:a.x,z:a.z,w:a.w,h:a.h,material:a.material});}\n if(lost.length){w.coverage.collapse+=lost.length;w.revision++;emit(w,'collapse',{seat,count:lost.length});}return lost.length;\n}\nexport function resolveImpact(w,s,hit){\n const p=w.players[s.seat],enemy=w.players[1-s.seat],tr=w.throws[s.throw]||(w.throws[s.throw]={targets:[],tick:w.tick});\n p.last[s.stone]={x:hit.x,z:hit.z,kind:hit.kind,tick:w.tick};\n if(hit.kind==='castle'){\n  const b=w.castles[hit.seat].find(a=>a.id===hit.id);if(\"'!b||b.hp<=0)return;\n  if(!tr.targets.includes(hit.key)){p.score+=3;tr.targets.push(hit.key);}\n  if(!w.invulnerable)b.hp=Math.max(0,b.hp-STONES[s.stone].damage*w.config.damage*(s.fragment?.8:1));\n  w.coverage.castle++;w.revision++;\n  emit(w,'\"'hit',{seat:hit.seat,by:s.seat,kind:'castle',x:hit.x,z:hit.z,stone:s.stone,id:b.id});\n  if(b.hp===0)emit(w,'fall',{seat:hit.seat,id:b.id,x:b.x,z:b.z,w:b.w,h:b.h,material:b.material});\n  // A heavy stone chips its immediate neighbours, without extra direct-hit score.\n  if(s.stone===1&&\"'!w.invulnerable)for(const a of w.castles[hit.seat])if(a.id!==b.id&&!a.foundation&&a.hp>0&&Math.hypot(a.x-b.x,a.z-b.z)<23){const hp=a.hp;a.hp=Math.max(0,a.hp-20*w.config.damage);if(hp>0&&a.hp===0)emit(w,'\"'fall',{seat:hit.seat,id:a.id,x:a.x,z:a.z,w:a.w,h:a.h,material:a.material});}\n  collapse(w,hit.seat);\n } else if(hit.kind==='crew'||hit.kind==='launcher'){\n  const until=Math.max(enemy.crewUntil,enemy.launcherUntil);\n  if(tr.targets.includes(hit.key)||w.tick<enemy[hit.kind==='crew'?'crewUntil':'launcherUntil']||w.tick>=until&&w.tick<enemy.protectUntil){emit(w,'shield',{seat:hit.seat,x:hit.x,z:hit.z});return;}\n  tr.targets.push(hit.key);p.score+=hit.kind==='crew'?7:13;\n  enemy[hit.kind==='crew'?'crewUntil':'launcherUntil']=w.tick+tickOf(hit.kind==='crew'?w.config.crewDisable:w.config.launcherDisable);\n  enemy.protectUntil=Math.max(enemy.crewUntil,enemy.launcherUntil)+tickOf(w.config.protection);cancel(w,hit.seat,false);\n  w.coverage[hit.kind]++;emit(w,'hit',{seat:hit.seat,by:s.seat,kind:hit.kind,x:hit.x,z:hit.z,stone:s.stone});\n }else if(hit.kind\"'!=='\"'away')emit(w,hit.kind,{x:hit.x,z:hit.z,seat:s.seat});\n}\nexport function finish(w,reason='timeout',forced){\n if(w.outcome)return w.outcome;\n let winner=forced;\n if(winner===undefined){const a=remaining(w,0),b=remaining(w,1);if(\"'!a||!b)winner=!a&&!b?-1:a?0:1;\n else {const delta=health(w,0)-health(w,1);winner=Math.abs(delta)>1e-9?delta>0?0:1:w.players[0].score===w.players[1].score?-1:w.players[0].score>w.players[1].score?0:1;}}\n w.phase='\"'ceremony';w.outcome={winner,reason,tick:w.tick,direct:w.players.map(p=>p.score),banked:w.players.map((p,i)=>i===winner?p.score*(w.bout+1):0),health:[health(w,0),health(w,1)]};\n w.players.forEach(p=>cancel(w,p.seat,false));w.shots=[];w.coverage.results++;emit(w,'outcome',w.outcome);return w.outcome;\n}\nexport function step(w){if(w.phase\"'!=='\"'playing')return;w.tick++;\n for(const p of w.players){\n  if(p.held&&p.charge<0&&canAct(w,p))begin(w,p);\n  const end=Math.max(p.crewUntil,p.launcherUntil);if(end>0&&end===w.tick){p.returnTick=w.tick;w.coverage.recovery++;emit(w,'recovery',{seat:p.seat});}\n }\n const impacts=[],next=[];\n for(const s of w.shots){const hit=stepProjectile(w,s);if(hit)impacts.push([s,hit]);else if(s.stone===2&&\"'!s.fragment&&s.vz<=0){next.push(...fragments(s));w.coverage.split++;emit(w,'\"'split',{x:s.x,z:s.z,seat:s.seat});}else next.push(s);}\n w.shots=next;for(const [s,h] of impacts)resolveImpact(w,s,h);\n if(\"'!remaining(w,0)||!remaining(w,1))finish(w,'\"'demolition');else if(w.tick>=w.deadline)finish(w,'timeout');\n for(const id in w.throws)if(w.tick-w.throws[id].tick>tickOf(12))delete w.throws[id];\n}\nexport function advance(w,seconds){for(let i=0;i<Math.round(seconds/DT);i++)step(w);return w;}\nexport function applyTuning(w,changes){const old=w.config;w.config=tuning({...old,...changes});if(old.healthScale\"'!==w.config.healthScale){for(const blocks of w.castles)for(const b of blocks)if(!b.foundation){const f=b.hp/b.max;b.max=b.max/old.healthScale*w.config.healthScale;b.hp=b.max*f;}}w.cheated=true;}\nexport function shotValue(w,seat,result,profile){\n let value=-5;const seen=new Set();for(const h of result.hits){if(h.kind==='\"'castle'){\n  if(seen.has(h.key))continue;seen.add(h.key);const b=w.castles[1-seat].find(a=>a.id===h.id);if(\"'!b)continue;\n  const dmg=STONES[h.stone].damage*(h.fragment?.8:1)*w.config.damage;value+=Math.min(b.hp,dmg)*.16+3;\n  if(dmg>=b.hp){const after=connected(w.castles[1-seat],new Set([b.id]));value+=w.castles[1-seat].filter(a=>!a.foundation&&a.hp>0&&!after.has(a.id)).length*7;}\n  if(profile.kind==='\"'broad'&&h.stone===2)value+=3;\n }else if(h.kind==='crew'||h.kind==='launcher'){\n  const p=w.players[1-seat],at=w.tick+tickOf(h.time);if(at>=p.protectUntil&&at>=readyAt(p))value+=(h.kind==='launcher'?13:8)*profile.harass+(p.charge>=0?4:0);\n }}return value;\n}\nexport function planShot(w,seat,profile=RIVALS[8],goal=null){\n let best=null;const choices=[];\n const powers=[];for(let p=.12;p<=.991;p+=profile.kind==='rookie'?.018:.009)powers.push(p);\n for(const stone of w.allowed)for(const power of powers){const pred=predict(w,seat,stone,power);let v=shotValue(w,seat,pred,profile)-[0,1,2][stone]*.9;\n  if(goal){v=pred.hits.some(h=>h.kind===goal)?50+v:goal==='castle'?v:-100;}\n  if(\"'!best||v>best.value){best={stone,power,value:v,hits:pred.hits};}if(v>0)choices.push({stone,power,value:v,hits:pred.hits});}\n return best||{stone:0,power:.7,value:0,hits:[]};\n}\nexport function createAI(profile=RIVALS[0]){return {profile,at:0,plan:null,goal:null,seen:-1,release:0,shots:0};}\nexport function aiStep(w,seat,ai){\n if(w.phase!=='\"'playing')return;const p=w.players[seat];\n if(p.charge>=0){if(w.tick>=ai.release)command(w,seat,{kind:'release'});return;}\n if(\"'!canAct(w,p)||p.held){ai.plan=null;return;}\n if(w.tick<ai.at)return;\n if(!ai.plan){\n  ai.plan=planShot(w,seat,ai.profile,ai.goal);const error=(rngStep(w)-.5)*2*ai.profile.error*w.config.aiError;\n  ai.plan.power=clamp(ai.plan.power+error,.09,.97);ai.at=w.tick+tickOf(ai.profile.reaction*w.config.aiReaction*(.8+rngStep(w)*.4));ai.seen=w.revision;return;\n }\n if(ai.seen!==w.revision){ai.plan=planShot(w,seat,ai.profile,ai.goal);ai.seen=w.revision;}\n command(w,seat,{kind:'\"'stone',stone:ai.plan.stone});command(w,seat,{kind:'begin'});\n ai.release=w.tick+tickOf(ai.plan.power*p.chargeTime);ai.plan=null;ai.shots++;ai.at=w.tick+tickOf(ai.profile.reaction*w.config.aiReaction);\n}\n// Compact full-state packets repair any lost prior snapshot; all geometry is regenerated from the court ID.\nexport function pack(w,seq=0){return {t:'s',v:1,n:seq,k:w.tick,c:w.court,b:w.bout,d:w.deadline,r:w.rng,i:w.nextShot,f:w.phase==='playing'?0:1,\n p:w.players.map(p=>[p.stone,+p.held,p.charge,Math.round(p.chargeTime*1000),p.ready,p.crewUntil,p.launcherUntil,p.protectUntil,p.seq,p.score,p.launchTick]),\n h:w.castles.map(bs=>bs.filter(b=>\"'!b.foundation).map(b=>Math.round(b.hp/b.max*255).toString(16).padStart(2,'\"'0')).join('')),\n s:w.shots.map(s=>[s.id,s.throw,s.seat,s.stone,...[s.x,s.z,s.vx,s.vz].map(v=>Math.round(v*10)),Math.round(s.g),+s.fragment,Math.round(s.age*100)]),o:w.outcome? [w.outcome.winner,w.outcome.reason,w.outcome.tick,...w.outcome.direct]:null};}\nexport function unpack(w,s){\n if(\"'!s||s.v!==1||!Number.isInteger(s.k)||s.k<w.tick||s.c!==w.court||!Array.isArray(s.p)||s.p.length!==2||!Array.isArray(s.h)||!Array.isArray(s.s))return false;\n w.tick=s.k;w.deadline=s.d;w.rng=s.r;w.nextShot=s.i;w.phase=s.f?'\"'ceremony':'playing';\n for(let i=0;i<2;i++){const a=s.p[i],p=w.players[i];[p.stone,p.held,p.charge,p.chargeTime,p.ready,p.crewUntil,p.launcherUntil,p.protectUntil,p.seq,p.score,p.launchTick]=a;p.chargeTime/=1000;p.held=\"'!!p.held;\n let j=0;for(const b of w.castles[i])if(!b.foundation){b.hp=parseInt(s.h[i].slice(j,j+2),16)/255*b.max;j+=2;}}\n w.shots=s.s.map(a=>({id:a[0],throw:a[1],seat:a[2],stone:a[3],x:a[4]/10,z:a[5]/10,vx:a[6]/10,vz:a[7]/10,g:a[8],fragment:!!a[9],age:a[10]/100}));\n if(s.o){const a=s.o;w.outcome={winner:a[0],reason:a[1],tick:a[2],direct:[a[3],a[4]],banked:[0,0],health:[health(w,0),health(w,1)]};}return true;\n}\nEOF\nnode --input-type=module <<'\"'JS'\nimport { COURTS,validateCourt } from './src/content.js';\nimport {createWorld,planShot} from './src/sim.js';\nconsole.log(COURTS.map(c=>[c.short,c.blocks.length,validateCourt({version:1,court:c}).errors]));console.log(planShot(createWorld(),0));\nJS\"","aggregated_output":"[\n  [ 'VILLAGE', 26, [] ],\n  [ 'QUARRY', 32, [] ],\n  [ 'HIGH KEEP', 36, [] ],\n  [ 'LAKESIDE', 33, [ 'Block dimensions outside the castle stage.' ] ],\n  [ 'ROYAL FINAL', 44, [] ]\n]\n{\n  stone: 2,\n  power: 0.6330000000000005,\n  value: 12.952000000000002,\n  hits: [\n    {\n      id: 19,\n      x: 757,\n      z: 68.49358257437241,\n      w: 19,\n      h: 18,\n      material: 'S',\n      foundation: false,\n      support: [Array],\n      hp: 38,\n      max: 38,\n      kind: 'castle',\n      seat: 1,\n      key: 'b1:19',\n      time: 2.174999999999995,\n      stone: 2,\n      fragment: true\n    },\n    {\n      id: 25,\n      x: 763.5044109597452,\n      z: 92,\n      w: 19,\n      h: 18,\n      material: 'W',\n      foundation: false,\n      support: [Array],\n      hp: 24,\n      max: 24,\n      kind: 'castle',\n      seat: 1,\n      key: 'b1:25',\n      time: 2.124999999999995,\n      stone: 2,\n      fragment: true\n    },\n    {\n      id: 24,\n      x: 791.1624993515582,\n      z: 92,\n      w: 19,\n      h: 18,\n      material: