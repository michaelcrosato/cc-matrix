his.keysTo) for (const q of this.keysTo) f(q); };\n    on(window, 'keyup', e => all(q => q.release(e.code)));\n    on(window, 'blur', () => all(q => q.clear()));\n    on(document, 'visibilitychange', () => { if (document.hidden) all(q => q.clear()); });\n    on(el, 'contextmenu', e => e.preventDefault());\n    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { if (this.lastDevice !== 'mouse' && this.lastDevice !== 'keyboard' && Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 3) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });\n      \"name\": \"no errors, dialogs, popups or sockets\",\n      \"pass\": true,\n      \"detail\": \"\"\n    }\n  ],\n  \"log\": [\n    \"   0.05  round 1: 2 players, seed 670614236, limit 18 s, mode shared-world\",\n    \"   0.22  p1 \\u2192 hub: hello\",\n    \"   0.23  p0 \\u2192 hub: hello\",\n    \"   0.27  hub \\u2192 p1: welcome\",\n    \"   0.49  hub \\u2192 p0: welcome\",\n    \"   0.49  p1 \\u2192 hub: ready\",\n    \"   0.89  p0 \\u2192 hub: ready\",\n    \"   1.04  splash over: the round starts once every game has loaded\",\n    \"   1.20  hub \\u2192 p0: start in 2847 ms\",\n    \"   1.20  hub \\u2192 p1: start in 2846 ms\",\n    \"   7.62  hub \\u2192 p1: time-up\",\n    \"   7.62  hub \\u2192 p0: time-up\",\n    \"   7.94  p0 \\u2192 hub: finish [[0,1]]\",\n    \"   7.94  round 1 played: finished \\u2014 standings [[0,1]]\",\n    \"   8.11  hub \\u2192 p1: end finished\",\n    \"   8.11  hub \\u2192 p0: end finished\",\n    \"   8.50  conformance: PASS\"\n  ]\n}","exit_code":0,"status":"completed"}}
