   throw: a[1],\n    seat: a[2],\n    stone: a[3],\n    x: a[4] / 10,\n    z: a[5] / 10,\n    vx: a[6] / 10,\n    vz: a[7] / 10,\n    g: a[8],\n    fragment: !!a[9],\n    age: a[10] / 100,\n  }));\n  if (s.o) {\n    const a = s.o;\n    w.outcome = {\n      winner: a[0],\n      reason: a[1],\n      tick: a[2],\n      direct: [a[3], a[4]],\n      banked: [0, 0],\n      health: [health(w, 0), health(w, 1)],\n    };\n36 checks, 0 failures\n","exit_code":0,"status":"completed"}}
