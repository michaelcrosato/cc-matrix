 if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n    return c;\n  }\n  const POWERS = [.3, .4, .5, .6, .7, .8, .9, 1], AIM = 1.45;   // (the aim: up to 1.45 radians above level, or below)\n  function cpuHands(dt) {\n    const g = cur, c = { walk: 0, aim: 0, jump: false, weapon: 0, pick: -1, charge: false, shot: null }, k = cpu; k.t += dt;\n    if (phase !== 'aim') return c;\n    if (k.phase === 'think') {\n      if (!k.cands) { k.cands = []; const t = teams[g.team]; for (let w = 0; w < 3; w++) if (t.ammo[w] > 0) for (const f of [1, -1]) for (let a = -.2; a <= AIM + 1e-6; a += .075) for (const p of POWERS) k.cands.push([w, f, Math.min(a, AIM), p]); }\n      for (let n = 0; n < 6 && k.i < k.cands.length; n++, k.i++) { const [w, f, a, pw] = k.cands[k.i], s = score(sim(w, g, f > 0 ? a : Math.PI - a, pw), g); if (!k.best || s > k.best.s) k.best = { w, f, a, pw, s }; }\n      if (k.i >= k.cands.length && k.t > .8) {   // chosen: an unsteady hand, then turn to it\n        const b = k.best; k.face = b.f; k.aim = clamp(b.a + (Math.random() - .5) * .05, -AIM, AIM); b.pw = clamp(b.pw * (1 + (Math.random() - .5) * .05), .15, 1); k.phase = 'aim'; c.pick = b.w;\n      }\n      return c;\n    }\n    g.face = k.face; const da = k.aim - g.aim;\n    if (k.phase === 'aim') { if (Math.abs(da) <= 1.4 * dt) { g.aim = k.aim; k.phase = 'charge'; } else c.aim = Math.sign(da); return c; }\n    if (power + dt / 1.4 < k.best.pw) c.charge = true; else c.shot = [aimAngle(g), k.best.pw];\n    return c;\n  }\n  // a shot as it would go, on the island as it is: the blasts it would make ([[x, y, r, dmg]]), or null (the sea, away)\n  function sim(w, g, ang, pw) {\n    const W = WEAPONS[w], [x, y, vx, vy] = muzzle(g, ang, pw, W); if (land.solid(x, y)) return null;\n    if (W.id === 'grenade') { const pw2 = new E.Physics(PHYS); pw2.add(land.collider()); const b = pw2.circle(x, y, 2.5, GREN); b.vx = vx; b.vy = vy; for (let i = 0; i < FUSE_N; i++) { pw2.step(DT); if (b.y < water) return null; } return [[b.x, b.y, W.r, W.dmg]]; }\n    const s = { w: W, x, y, vx, vy, t: 0 }; let e; while (!(e = fly(s, DT, g))) { /* flying */ } if (e !== 'hit') return null;\n    const out = [[s.x, s.y, W.r, W.dmg]];\n    if (W.bits) for (const b of bits(s.x, s.y)) { let f; while (!(f = fly(b, DT, null))) { /* flying */ } if (f === 'hit') out.push([b.x, b.y, BIT.r, BIT.dmg]); }\n    return out;\n  }\n  // what a shot is worth: the foes' hurt (a kill more), less its own side's (its own grub's most), and, hitting none, nearer\n  function score(pts, me) {\n    if (!pts) return -1e4;\n    let s = 0, near = 1e9;\n    for (const [x, y, r, dmg] of pts) for (const g of grubs) {\n      if (g.dead) continue; const d = Math.hypot(g.x - x, g.y + 5 - y), foe = g.team !== me.team; if (foe) near = Math.min(near, d); if (d >= r + 6) continue;\n      const hit = dmg * (1 - d / (r + 6)), kill = hit >= g.hp; s += foe ? hit + (kill ? 40 : 0) + (g.y - y < 30 && g.y - water < 30 ? 8 : 0) : -(hit * (g === me ? 2 : 1.5) + (kill ? 80 : 0));\n    }\n    return s - near * .05;\n  }\n\n  /* ---- 4. THE SCENE: the choice of players over the island, the match, its end ---- */\n  const CHOICES = [['ONE PLAYER', 'AGAINST THE CPU', 'cpu'], ['TWO PLAYERS', 'ON ONE SCREEN, IN TURN', 'two'], ['TWO CPUS', 'WATCH THEM PLAY', 'demo']];\n  const AFTER = [['PLAY AGAIN', 'A NEW ISLAND'], ['PLAYERS', 'CHOOSE AGAIN'], ['TITLE', '']];\n  function start(data) {\n    shots = []; cur = null; banner = null; winner = -1; menuI = 0; water = 34; island(7); mode = 'menu'; modeT = 0;\n    game.input.touchEnabled = true; game.input.steer = 'drag'; game.input.zones = null; L.enabled = false; game.follow(null); A.music(null);\n    game.cam.bounds = () => ({ x0: -40, y0: -SKY, x1: WW + 40, y1: 12 }); game.cam.align = 'bottom'; game.focus(WW / 2, 0, 160); game.cam.snap = true;\n    if (data && data.part === 'cpu') begin('demo');\n  }\n  // the buttons of a menu: a thumb's height on a touch screen\n  function buttons(list, W, H) {\n    const k = game.screen.dpr / game.screen.S, h = Math.max(24, Math.ceil(46 * k)), w = Math.min(W - 24, 200), gap = 6, y0 = Math.round(Math.max(H * .42, H - (h + gap) * list.length - 34));\n    return list.map((b, i) => ({ x: Math.round((W - w) / 2), y: y0 + i * (h + gap), w, h, label: b[0], sub: b[1], i }));\n  }\n  function menu(I, list, pick) {\n    const B = buttons(list, game.W, game.H), ck = I.clicked(), hit = ck && B.find(b => ck[0] >= b.x && ck[0] < b.x + b.w && ck[1] >= b.y && ck[1] < b.y + b.h);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > package.json <<'EOF'\n{\\\"name\\\":\\\"smithereens-under-siege\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node scripts/build.mjs\\\",\\\"verify\\\":\\\"node scripts/verify.mjs\\\",\\\"verify:sim\\\":\\\"node scripts/verify.mjs sim\\\",\\\"verify:browser\\\":\\\"node scripts/verify.mjs browser\\\"},\\\"engines\\\":{\\\"node\\\":\\\">=24\\\"}}\nEOF\nnpm install --package-lock-only --ignore-scripts --no-audit --no-fund\ncat > src/config.js <<'EOF'\nexport const TITLE = 'Smithereens Under Siege';\nexport const VERSION = 1;\nexport const DT = 1 / 120;\nexport const ARENA = { width: 960, ground: 36, water: 16, launch: [245, 715], crew: [208, 752], angle: 50 * Math.PI / 180 };\nexport const STONES = [\n  { id: 0, name: 'Roundstone', short: 'ROUND', role: 'Pinpoint hits • quickest reload', color: '#d3e4e8', damage: 38, radius: 3.5, reload: .9 },\n  { id: 1, name: 'Masonry stone', short: 'MASONRY', role: 'Break supports • heavy damage', color: '#e7b976', damage: 79, radius: 5.5, reload: 1.55 },\n  { id: 2, name: 'Split stone', short: 'SPLIT', role: 'Three fragments • broad coverage', color: '#c3a4f5', damage: 28, radius: 3, reload: 2.1 }\n];\nexport const DEFAULTS = { chargeTime: 1.4, speed: 530, gravity: 260, roundReload: .9, heavyReload: 1.55, splitReload: 2.1, damage: 1, healthScale: 1, crewDisable: 1.8, launcherDisable: 2.6, protection: 1.25, aiError: 1, aiReaction: 1, assist: .35 };\nexport const TUNING = [\n  ['chargeTime','Charge to full (s)',.5,2.5,.05],['speed','Launch speed (u/s)',450,650,5],['gravity','Gravity (u/s²)',190,340,5],\n  ['roundReload','Round reload (s)',.3,2,.05],['heavyReload','Masonry reload (s)',.5,3,.05],['splitReload','Split reload (s)',.5,4,.05],\n  ['damage','Damage multiplier',.3,3,.1],['healthScale','Block health multiplier',.5,3,.1],['crewDisable','Crew retreat (s)',.5,4,.1],\n  ['launcherDisable','Launcher repair (s)',.5,5,.1],['protection','Return protection (s)',.5,3,.05],['aiError','AI range error',0,3,.1],['aiReaction','AI reaction multiplier',.25,3,.05],['assist','Timing assist',0,1,.05]\n];\nexport const clamp = (v,a,b) => Math.min(b,Math.max(a,v));\nexport const tickOf = s => Math.round(s / DT);\nexport function tuning(input = {}) { const out = {...DEFAULTS}; for (const [k,,lo,hi] of TUNING) if (Number.isFinite(input[k])) out[k] = clamp(input[k],lo,hi); return out; }\nexport function rngStep(w) { let a = w.rng = (w.rng + 0x6d2b79f5) >>> 0; a = Math.imul(a \"'^ a >>> 15, a | 1); a ''^= a + Math.imul(a ''^ a >>> 7, a | 61); return ((a ''^ a >>> 14) >>> 0) / 4294967296; }\nEOF\ncat > src/content.js <<'\"'EOF'\nimport { ARENA, clamp } from './config.js';\nconst specs = [\n {name:'The Village Exhibition',short:'VILLAGE',subtitle:'A most uncivil afternoon',mood:'day',stone:'#b5b3a2',grass:'#6f8855',rows:['SS.SS.SS','SS.SS.SS','WW.WW.WW'],boast:'A fine day to lower the neighbourhood\"'!'\"',hint:'Hold, watch the landing diamond, release.',music:0},\n {name:'The Quarry Meet',short:'QUARRY',subtitle:'Mind the load-bearing bits',mood:'desert',stone:'#d6bd95',grass:'#999262',rows:['.R..R..R','SSSSSSSS','SSSSSSSS','W.WW.W.W'],boast:'My columns have impeccable manners.',hint:'Masonry stones break a support in one hit.',music:1},\n {name:'The High Keep',short:'HIGH KEEP',subtitle:'Lofty ideas. Loose masonry.',mood:'dusk',stone:'#a3a6bb',grass:'#7b827a',rows:['SS..SS.S','SS..SS.S','SS..SS.S','RS..SS.R','WW..WW.W','W....W.W'],boast:'Try not to miss the entire building.',hint:'Split stones fan out at their apex. Finish small pieces with roundstone.',music:2},\n {name:'Lakeside After Dark',short:'LAKESIDE',subtitle:'Torchlight and terrible decisions',mood:'castle-night',stone:'#878ca7',grass:'#576b70',rows:['SS..SSSS','WS..WWSS','WW..SSWW','.W..W.WW','....W..W'],boast:'A protected return\"'! How terribly sporting.'\"',hint:'Gold shields protect returning crew and launchers.',music:3},\n {name:'The Royal Final',short:'ROYAL FINAL',subtitle:'By appointment to His Rubbleness',mood:'dusk',stone:'#c7bdac',grass:'#74826a',rows:['RR..RRSS','SSSSSSSS','SS.SS.SS','WS.WS.SW','WW.WW.WW','W..WW..W'],boast:'There is only room for one royal ruin.',hint:'Read the surviving silhouette. Every support is an opportunity.',music:4}\n];\nexport const MATERIAL = {W:{name:'timber',hp:24},S:{name:'masonry',hp:38},R:{name:'reinforced',hp:72}};\nexport function layout(rows) {\n const b=[],w=19,h=18,x0=42,gap=1;\n for(let col=0;col<8;col++) b.push({id:b.length,x:x0+col*(w+gap),z:ARENA.ground-9,w,h:9,material:'S',foundation:true,support:[]});\n rows.forEach((row,r)=>[...row].forEach((m,c)=>{if(\"'!MATERIAL[m])return; b.push({id:b.length,x:x0+c*(w+gap),z:ARENA.ground+r*h,w,h,material:m,foundation:false,support:[]});}));\n for(const a of b.filter(a=>!a.foundation)) {\n  a.support=b.filter(q=>q.id!==a.id && (Math.abs(q.z+q.h-a.z)<.1 && Math.abs(q.x-a.x)<w+2 || q.z===a.z && Math.abs(q.x-a.x)<=w+gap+.1)).map(q=>q.id);\n }\n return b;\n}\nexport const COURTS = specs.map((c,id)=>({...c,id,blocks:layout(c.rows)}));\nexport const RIVALS = [\n {name:'\"'Sir Crumb',title:'The enthusiastic amateur',kind:'rookie',reaction:2.4,error:.075,harass:.15,quote:'I practised on a very small shed.'},\n {name:'Dame Pebble',title:'The cheerful nuisance',kind:'harasser',reaction:1.6,error:.045,harass:.65,quote:'Your winch looks unusually hittable.'},\n {name:'Baron Bedrock',title:'The careful mason',kind:'mason',reaction:1.5,error:.025,harass:.12,quote:'A wall is only as good as its bottom.'},\n {name:'Lady Clatter',title:'The winch inspector',kind:'harasser',reaction:1.15,error:.028,harass:.8,quote:'Do take your time repairing that.'},\n {name:'Abbot Rubble',title:'The lofty demolisher',kind:'broad',reaction:1.25,error:.024,harass:.08,quote:'Bless this mess.'},\n {name:'Count Topple',title:'The patient finisher',kind:'mason',reaction:1.05,error:.022,harass:.22,quote:'A smaller target is still a target.'},\n {name:'Duchess Aftershock',title:'The night owl',kind:'adaptive',reaction:1,error:.025,harass:.55,quote:'Your return is most illuminating.'},\n {name:'Sir Plonk',title:'The relentless rumbler',kind:'adaptive',reaction:.85,error:.019,harass:.4,quote:'A moment of peace? Not on my watch.'},\n {name:'Queen Quarry',title:'Her Falling Majesty',kind:'final',reaction:.8,error:.015,harass:.35,quote:'I hereby declare your castle optional.'},\n {name:'Queen Quarry',title:'The royal rematch',kind:'final',reaction:.65,error:.012,harass:.5,quote:'Once more, with considerably less castle.'}\n];\nexport function castleBlocks(court,seat,scale=1) {return court.blocks.map(b=>({...b,x:seat?ARENA.width-b.x-b.w:b.x,support:[...b.support],hp:b.foundation?0:MATERIAL[b.material].hp*scale,max:b.foundation?0:MATERIAL[b.material].hp*scale}));}\nexport function connected(blocks,omit=new Set()) {\n const alive=new Set(blocks.filter(b=>(b.foundation||b.hp>0)&&\"'!omit.has(b.id)).map(b=>b.id));\n const seen=new Set(blocks.filter(b=>b.foundation).map(b=>b.id)),queue=[...seen];\n const edges=new Map(blocks.map(b=>[b.id,[]]));\n for(const b of blocks)for(const id of b.support)if(edges.has(id)){edges.get(b.id).push(id);edges.get(id).push(b.id);}\n while(queue.length){for(const id of edges.get(queue.shift())||[])if(alive.has(id)&&!seen.has(id)){seen.add(id);queue.push(id);}}\n return seen;\n}\nexport function validateCourt(raw) {\n const errors=[];\n if(!raw||raw.version!==1||!raw.court||!Array.isArray(raw.court.blocks))return {ok:false,errors:['\"'Expected a version 1 court definition.']};\n const c=raw.court,b=c.blocks,ids=new Set();\n if(b.length<2||b.length>70)errors.push('Use 2–70 blocks.');\n for(const a of b){if(\"'!Number.isInteger(a.id)||ids.has(a.id))errors.push('\"'Block IDs must be unique integers.');ids.add(a.id);\n if(\"'![a.x,a.z,a.w,a.h].every(Number.isFinite)||a.x<20||a.x+a.w>205||a.z<20||a.z+a.h>180||a.w<6||a.w>60||a.h<5||a.h>40)errors.push('\"'Block dimensions outside the castle stage.');\n if(\"'!MATERIAL[a.material]||!Array.isArray(a.support)||typeof a.foundation!=='\"'boolean')errors.push('Invalid material, foundation or support role.');}\n for(const a of b)if(Array.isArray(a.support)&&a.support.some(id=>\"'!ids.has(id)||id===a.id))errors.push('\"'Support references must name another block.');\n if(\"'!b.some(a=>a.foundation)||!b.some(a=>!a.foundation))errors.push('\"'A court needs a foundation and objective blocks.');\n if(\"'!errors.length){const con=connected(b.map(a=>({...a,hp:1})));if(b.some(a=>!a.foundation&&!con.has(a.id)))errors.push('\"'An objective block is not connected to a foundation.');}\n return {ok:\"'!errors.length,errors:[...new Set(errors)],court:errors.length?null:{...COURTS[0],...c,id:clamp(Number(c.id)||0,0,4)}};\n}\nexport function exportCourt(court){return JSON.stringify({version:1,court:{...court,blocks:court.blocks.map(b=>({...b}))}},null,2);}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > package.json <<'EOF'\n{\\\"name\\\":\\\"smithereens-under-siege\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node scripts/build.mjs\\\",\\\"verify\\\":\\\"node scripts/verify.mjs\\\",\\\"verify:sim\\\":\\\"node scripts/verify.mjs sim\\\",\\\"verify:browser\\\":\\\"node scripts/verify.mjs browser\\\"},\\\"engines\\\":{\\\"node\\\":\\\">=24\\\"}}\nEOF\nnpm install --package-lock-only --ignore-scripts --no-audit --no-fund\ncat > src/config.js <<'EOF'\nexport const TITLE = 'Smithereens Under Siege';\nexport const VERSION = 1;\nexport const DT = 1 / 120;\nexport const ARENA = { width: 960, ground: 36, water: 16, launch: [245, 715], crew: [208, 752], angle: 50 * Math.PI / 180 };\nexport const STONES = [\n  { id: 0, name: 'Roundstone', short: 'ROUND', role: 'Pinpoint hits • quickest reload', color: '#d3e4e8', damage: 38, radius: 3.5, reload: .9 },\n  { id: 1, name: 'Masonry stone', short: 'MASONRY', role: 'Break supports • heavy damage', color: '#e7b976', damage: 79, radius: 5.5, reload: 1.55 },\n  { id: 2, name: 'Split stone', short: 'SPLIT', role: 'Three fragments • broad coverage', color: '#c3a4f5', damage: 28, radius: 3, reload: 2.1 }\n];\nexport const DEFAULTS = { chargeTime: 1.4, speed: 530, gravity: 260, roundReload: .9, heavyReload: 1.55, splitReload: 2.1, damage: 1, healthScale: 1, crewDisable: 1.8, launcherDisable: 2.6, protection: 1.25, aiError: 1, aiReaction: 1, assist: .35 };\nexport const TUNING = [\n  ['chargeTime','Charge to full (s)',.5,2.5,.05],['speed','Launch speed (u/s)',450,650,5],['gravity','Gravity (u/s²)',190,340,5],\n  ['roundReload','Round reload (s)',.3,2,.05],['heavyReload','Masonry reload (s)',.5,3,.05],['splitReload','Split reload (s)',.5,4,.05],\n  ['damage','Damage multiplier',.3,3,.1],['healthScale','Block health multiplier',.5,3,.1],['crewDisable','Crew retreat (s)',.5,4,.1],\n  ['launcherDisable','Launcher repair (s)',.5,5,.1],['protection','Return protection (s)',.5,3,.05],['aiError','AI range error',0,3,.1],['aiReaction','AI reaction multiplier',.25,3,.05],['assist','Timing assist',0,1,.05]\n];\nexport const clamp = (v,a,b) => Math.min(b,Math.max(a,v));\nexport const tickOf = s => Math.round(s / DT);\nexport function tuning(input = {}) { const out = {...DEFAULTS}; for (const [k,,lo,hi] of TUNING) if (Number.isFinite(input[k])) out[k] = clamp(input[k],lo,hi); return out; }\nexport function rngStep(w) { let a = w.rng = (w.rng + 0x6d2b79f5) >>> 0; a = Math.imul(a \"'^ a >>> 15, a | 1); a ''^= a + Math.imul(a ''^ a >>> 7, a | 61); return ((a ''^ a >>> 14) >>> 0) / 4294967296; }\nEOF\ncat > src/content.js <<'\"'EOF'\nimport { ARENA, clamp } from './config.js';\nconst specs = [\n {name:'The Village Exhibition',short:'VILLAGE',subtitle:'A most uncivil afternoon',mood:'day',stone:'#b5b3a2',grass:'#6f8855',rows:['SS.SS.SS','SS.SS.SS','WW.WW.WW'],boast:'A fine day to lower the neighbourhood\"'!'\"',hint:'Hold, watch the landing diamond, release.',music:0},\n {name:'The Quarry Meet',short:'QUARRY',subtitle:'Mind the load-bearing bits',mood:'desert',stone:'#d6bd95',grass:'#999262',rows:['.R..R..R','SSSSSSSS','SSSSSSSS','W.WW.W.W'],boast:'My columns have impeccable manners.',hint:'Masonry stones break a support in one hit.',music:1},\n {name:'The High Keep',short:'HIGH KEEP',subtitle:'Lofty ideas. Loose masonry.',mood:'dusk',stone:'#a3a6bb',grass:'#7b827a',rows:['SS..SS.S','SS..SS.S','SS..SS.S','RS..SS.R','WW..WW.W','W....W.W'],boast:'Try not to miss the entire building.',hint:'Split stones fan out at their apex. Finish small pieces with roundstone.',music:2},\n {name:'Lakeside After Dark',short:'LAKESIDE',subtitle:'Torchlight and terrible decisions',mood:'castle-night',stone:'#878ca7',grass:'#576b70',rows:['SS..SSSS','WS..WWSS','WW..SSWW','.W..W.WW','....W..W'],boast:'A protected return\"'! How terribly sporting.'\"',hint:'Gold shields protect returning crew and launchers.',music:3},\n {name:'The Royal Final',short:'ROYAL FINAL',subtitle:'By appointment to His Rubbleness',mood:'dusk',stone:'#c7bdac',grass:'#74826a',rows:['RR..RRSS','SSSSSSSS','SS.SS.SS','WS.WS.SW','WW.WW.WW','W..WW..W'],boast:'There is only room for one royal ruin.',hint:'Read the surviving silhouette. Every support is an opportunity.',music:4}\n];\nexport const MATERIAL = {W:{name:'timber',hp:24},S:{name:'masonry',hp:38},R:{name:'reinforced',hp:72}};\nexport function layout(rows) {\n const b=[],w=19,h=18,x0=42,gap=1;\n for(let col=0;col<8;col++) b.push({id:b.length,x:x0+col*(w+gap),z:ARENA.ground-9,w,h:9,material:'S',foundation:true,support:[]});\n rows.forEach((row,r)=>[...row].forEach((m,c)=>{if(\"'!MATERIAL[m])return; b.push({id:b.length,x:x0+c*(w+gap),z:ARENA.ground+r*h,w,h,material:m,foundation:false,support:[]});}));\n for(const a of b.filter(a=>!a.foundation)) {\n  a.support=b.filter(q=>q.id!==a.id && (Math.abs(q.z+q.h-a.z)<.1 && Math.abs(q.x-a.x)<w+2 || q.z===a.z && Math.abs(q.x-a.x)<=w+gap+.1)).map(q=>q.id);\n }\n return b;\n}\nexport const COURTS = specs.map((c,id)=>({...c,id,blocks:layout(c.rows)}));\nexport const RIVALS = [\n {name:'\"'Sir Crumb',title:'The enthusiastic amateur',kind:'rookie',reaction:2.4,error:.075,harass:.15,quote:'I practised on a very small shed.'},\n {name:'Dame Pebble',title:'The cheerful nuisance',kind:'harasser',reaction:1.6,error:.045,harass:.65,quote:'Your winch looks unusually hittable.'},\n {name:'Baron Bedrock',title:'The careful mason',kind:'mason',reaction:1.5,error:.025,harass:.12,quote:'A wall is only as good as its bottom.'},\n {name:'Lady Clatter',title:'The winch inspector',kind:'harasser',reaction:1.15,error:.028,harass:.8,quote:'Do take your time repairing that.'},\n {name:'Abbot Rubble',title:'The lofty demolisher',kind:'broad',reaction:1.25,error:.024,harass:.08,quote:'Bless this mess.'},\n {name:'Count Topple',title:'The patient finisher',kind:'mason',reaction:1.05,error:.022,harass:.22,quote:'A smaller target is still a target.'},\n {name:'Duchess Aftershock',title:'The night owl',kind:'adaptive',reaction:1,error:.025,harass:.55,quote:'Your return is most illuminating.'},\n {name:'Sir Plonk',title:'The relentless rumbler',kind:'adaptive',reaction:.85,error:.019,harass:.4,quote:'A moment of peace? Not on my watch.'},\n {name:'Queen Quarry',title:'Her Falling Majesty',kind:'final',reaction:.8,error:.015,harass:.35,quote:'I hereby declare your castle optional.'},\n {name:'Queen Quarry',title:'The royal rematch',kind:'final',reaction:.65,error:.012,harass:.5,quote:'Once more, with considerably less castle.'}\n];\nexport function castleBlocks(court,seat,scale=1) {return court.blocks.map(b=>({...b,x:seat?ARENA.width-b.x-b.w:b.x,support:[...b.support],hp:b.foundation?0:MATERIAL[b.material].hp*scale,max:b.foundation?0:MATERIAL[b.material].hp*scale}));}\nexport function connected(blocks,omit=new Set()) {\n const alive=new Set(blocks.filter(b=>(b.foundation||b.hp>0)&&\"'!omit.has(b.id)).map(b=>b.id));\n const seen=new Set(blocks.filter(b=>b.foundation).map(b=>b.id)),queue=[...seen];\n const edges=new Map(blocks.map(b=>[b.id,[]]));\n for(const b of blocks)for(const id of b.support)if(edges.has(id)){edges.get(b.id).push(id);edges.get(id).push(b.id);}\n while(queue.length){for(const id of edges.get(queue.shift())||[])if(alive.has(id)&&!seen.has(id)){seen.add(id);queue.push(id);}}\n return seen;\n}\nexport function validateCourt(raw) {\n const errors=[];\n if(!raw||raw.version!==1||!raw.court||!Array.isArray(raw.court.blocks))return {ok:false,errors:['\"'Expected a version 1 court definition.']};\n const c=raw.court,b=c.blocks,ids=new Set();\n if(b.length<2||b.length>70)errors.push('Use 2–70 blocks.');\n for(const a of b){if(\"'!Number.isInteger(a.id)||ids.has(a.id))errors.push('\"'Block IDs must be unique integers.');ids.add(a.id);\n if(\"'![a.x,a.z,a.w,a.h].every(Number.isFinite)||a.x<20||a.x+a.w>205||a.z<20||a.z+a.h>180||a.w<6||a.w>60||a.h<5||a.h>40)errors.push('\"'Block dimensions outside the castle stage.');\n if(\"'!MATERIAL[a.material]||!Array.isArray(a.support)||typeof a.foundation!=='\"'boolean')errors.push('Invalid material, foundation or support role.');}\n for(const a of b)if(Array.isArray(a.support)&&a.support.some(id=>\"'!ids.has(id)||id===a.id))errors.push('\"'Support references must name another block.');\n if(\"'!b.some(a=>a.foundation)||!b.some(a=>!a.foundation))errors.push('\"'A court needs a foundation and objective blocks.');\n if(\"'!errors.length){const con=connected(b.map(a=>({...a,hp:1})));if(b.some(a=>!a.foundation&&!con.has(a.id)))errors.push('\"'An objective block is not connected to a foundation.');}\n return {ok:\"'!errors.length,errors:[...new Set(errors)],court:errors.length?null:{...COURTS[0],...c,id:clamp(Number(c.id)||0,0,4)}};\n}\nexport function exportCourt(court){return JSON.stringify({version:1,court:{...court,blocks:court.blocks.map(b=>({...b}))}},null,2);}\nEOF'","aggregated_output":"\nup to date in 630ms\n/bin/bash: line 5: src/config.js: No such file or directory\n/bin/bash: line 27: src/content.js: No such file or directory\n","exit_code":1,"status":"failed"}}
