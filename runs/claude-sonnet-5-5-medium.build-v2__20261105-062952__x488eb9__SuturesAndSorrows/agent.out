r;\n  G.drawBust(g, c, { expr: e, blink: o.blink ? 1 : (expr === 'tired' ? 1 : 0), talk: o.talk ? 1 : 0, maskUp: !!o.maskUp, look: o.look || 0 });\n  if (expr === 'cry') { E.px.rect(g, 38, 66, 2, 9, '#9fd8f0'); E.px.rect(g, 72, 66, 2, 9, '#9fd8f0'); }\n  if (expr === 'smirk') { E.px.line(g, 62, 72, 66, 70, '#00000040', 1); }\n  if (E.px.reset) E.px.reset(cv); cache.set(key, cv); return cv;\n};\nG.EXPRS = ['neutral', 'smile', 'angry', 'sad', 'shock', 'shout', 'smirk', 'tired', 'cry'];\nG.hasCast = id => !!CAST[id] || (typeof id === 'string' && id.startsWith('pt:'));\n})();\nEOF\npython3 - <<'EOF'\nimport json\np='src/manifest.json'; m=json.load(open(p))\ng=m['game']\nm['game']=g[:g.index('data/cases.js')]+['data/cases.js']+['art/tissue.js','art/sites.js','art/bust0.js','art/bust.js','audio/audio.js','audio/music.js']+g[g.index('bot/autosurgeon.js'):]\njson.dump(m,open(p,'w'),indent=1)\nprint(m['game'])\nEOF"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3086,"cache_read_input_tokens":284804,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3086},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"73cf9888-9422-42e0-82aa-d7becfd7d585","uuid":"3de63277-a124-4458-aee6-820d5ce2f001","timestamp":"2026-11-05T13:50:48.469Z","request_id":"req_011CgjtWm3PocfciKrhg6QFv","wire_tool_inputs":{"toolu_01WKZoqzdP68HF5XDqjzSuC6":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-062952__x488eb9/work/SuturesAndSorrows*/ && mv src/art/bust0.js src/art/bust0.js.tmp && mv src/art/bust0.js.tmp src/art/bust0.js && cat > src/art/bust.js <<'EOF'\n// The cast: four leads from Appendix C plus four more and a patient kit. Busts are cached per expression.\n(() => {\ncon