ame.timeScale = D.cheats.slow || 1; };\nG.devUpdate = (dt, scene) => { const I = G.game.input, R = rows(); apply(); if (I.pressed('toolNext') || I.pressed('toolPrev')) { D.tab = (D.tab + (I.pressed('toolNext') ? 1 : 3)) % 4; D.row = 0; } if (I.pressed('up')) D.row = (D.row + R.length - 1) % R.length; if (I.pressed('down')) D.row = (D.row + 1) % R.length; D.row = Math.min(D.row, R.length - 1); const r = R[D.row]; if (I.pressed('cancel')) { D.open = false; G.game.timeScale = D.cheats.slow || 1; return; }\n  const ptr = I.pointer(); if (ptr && I.lastDevice === 'mouse' && ptr[0] < G.game.W / 3) { const k = Math.floor((ptr[1] - 28) / 14); if (k >= 0 && k < R.length) { D.row = k; if (I.clicked()) { const rr = R[k]; if (rr.t === 'slider') { const x0 = 100, w = G.game.W / 3 - 110; if (ptr[0] >= x0) { const v = rr.mn + (rr.mx - rr.mn) * E.clamp((ptr[0] - x0) / w, 0, 1); G.TUNING[rr.k] = Math.round(v / rr.st) * rr.st; save(); } } else this.act(rr, 1); } } }\n  this.act = this.act || ((rr, dir) => { }); const act = (rr, dir) => { if (rr.t === 'slider') { G.TUNING[rr.k] = E.clamp(Math.round((G.TUNING[rr.k] + dir * rr.st) / rr.st) * rr.st, rr.mn, rr.mx); save(); } else if (rr.t === 'toggle') { D.cheats[rr.k] = !D.cheats[rr.k]; if (rr.k === 'oneHit') G.TUNING.strainHealth = D.cheats.oneHit ? .1 : 1; save(); } else if (rr.t === 'cycle') { const i = rr.opts.indexOf(D[rr.k] != null ? D[rr.k] : (rr.k === 'slow' ? D.cheats.slow : rr.opts[0])); const v = rr.opts[(i + (dir || 1) + rr.opts.length) % rr.opts.length]; if (rr.k === 'slow') D.cheats.slow = v; else D[rr.k] = v; } else if (rr.t === 'act') rr.fn(); else if (rr.t === 'page') { D.page += dir || 1; D.row = 0; } };\n  if (r) { const rep = (a) => I.repeat(a, .35, 18); if (rep('left')) act(r, -1); if (rep('right')) act(r, 1); if (I.pressed('confirm') || I.pressed('interact')) act(r, 1); } D.act = act; };\nG.devDraw = (g, W, H, scene) => { const R = rows(), w = Math.floor(W / 3); U.panel(g, 0, 0, w, H, { bg: '#06161af0' }); U.text(g, 