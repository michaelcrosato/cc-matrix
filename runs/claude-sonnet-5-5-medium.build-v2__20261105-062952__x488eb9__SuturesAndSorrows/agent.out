b8b0'); if (r.t === 'slider') { const v = G.TUNING[r.k], d = G.DEFAULTS[r.k], x0 = 100, bw = w - 110, k = (v - r.mn) / (r.mx - r.mn); px.rect(g, x0, y + 3, bw, 3, '#2a4a50'); px.rect(g, x0, y + 3, bw * k, 3, '#5ff0e0'); px.rect(g, x0 + bw * (d - r.mn) / (r.mx - r.mn), y, 1, 9, '#ffd35a'); U.text(g, String(Math.round(v * 100) / 100), x0 + bw - 18, y - 8 + 0, '#ffffff'); } else if (r.t === 'toggle') U.text(g, D.cheats[r.k] ? 'ON' : 'off', w - 30, y, D.cheats[r.k] ? '#6affb0' : '#6a8a90'); else if (r.t === 'cycle') U.text(g, String(r.k === 'slow' ? D.cheats.slow : (D[r.k] != null ? D[r.k] : r.opts[0])), w - 50, y, '#ffd35a'); });\n  U.capText(g, G.game, 'cancel', 'Close', 6, H - 14); };\n})();\nEOF\nnode -e \"const fs=require('fs');new Function(fs.readFileSync('src/ui/dev.js','utf8'));console.log('ok')\""}}}
