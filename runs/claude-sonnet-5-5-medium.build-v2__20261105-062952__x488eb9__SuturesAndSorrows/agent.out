1), (w - 1) * 2, 2, '#f4f0e8'); }\n1207\t  else if (expr === 'smile') { px.line(g, ...f(-7, my - 1), ...f(-3, my + 2), skin.deep, 1); px.line(g, ...f(-3, my + 2), ...f(3, my + 2), skin.deep, 1); px.line(g, ...f(3, my + 2), ...f(7, my - 1), skin.deep, 1); }\n1208\t  else if (expr === 'sad' || expr === 'angry') { px.line(g, ...f(-5, my + 2), ...f(0, my), skin.deep, 1); px.line(g, ...f(0, my), ...f(5, my + 2), skin.deep, 1); }\n1209\t  else px.line(g, ...f(-4, my), ...f(4, my), skin.deep, 1);\n1210\t  if (c.moustache) { P([f(-13, 50), f(-6, 46), f(0, 48), f(6, 46), f(13, 50), f(8, 52), f(0, 50), f(-8, 52)], c.moustache); px.line(g, ...f(-6, 47), ...f(6, 47), E.tones(c.moustache).lt, 1); }\n1211\t  // front hair\n1212\t  if (c.frontHair) for (const [s, tone] of c.frontHair) P(s.map(([x, y]) => f(x, y)), hair[tone || 'base']);\n1213\t  if (c.hairGlint) for (const s of c.hairGlint) P(s.map(([x, y]) => f(x, y)), hair.hi);\n1214\t  // cap\n1215\t  if (c.cap) { const k = T(c.cap); P([f(-29, 16), f(-27, 2), f(-14, -9), f(14, -9), f(27, 2), f(29, 16), f(16, 11), f(-16, 11)], k.base); P([f(-29, 16), f(-27, 2), f(-14, -9), f(-6, -9), f(-14, 11), f(-16, 11)], k.sh); P([f(6, -8), f(14, -9), f(22, -3), f(14, -3)], k.lt); P([f(-29, 16), f(-16, 11), f(16, 11), f(29, 16), f(27, 18), f(16, 14), f(-16, 14), f(-27, 18)], k.deep); }\n1216\t  // lowered mask, glasses\n1217\t  if (c.mask && !o.maskUp) { const k = T(c.mask); P([f(-20, 62), f(20, 62), f(25, 76), f(0, 84), f(-25, 76)], k.base); P([f(-20, 62), f(-25, 76), f(0, 84), f(-6, 74)], k.sh); px.line(g, ...f(-20, 62), ...f(-28, 50), k.lt, 1); px.line(g, ...f(20, 62), ...f(28, 50), k.lt, 1); }\n1218\t  if (c.glasses) { const m = c.glasses; for (const sx of [-1, 1]) { const x = sx * 13; px.line(g, ...f(x - 9, 25), ...f(x + 9, 25), m, 1); px.line(g, ...f(x - 9, 25), ...f(x - 8, 33), m, 1); px.line(g, ...f(x + 9, 25), ...f(x + 8, 33), m, 1); px.line(g, ...f(x - 8, 34), ...f(x + 8, 34), m, 1); } px.line(g, ...f(-4, 27), ...f(4, 27), m, 1); }