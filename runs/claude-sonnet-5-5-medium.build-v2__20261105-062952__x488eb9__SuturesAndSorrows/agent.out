 + Math.cos(a) * R, o.y + Math.sin(a) * R]); } }\n    o.len = geo.polyLen(o.pts); o.prog = 0; o.cut = false; if (sp.hidden) o.hid = true; }, tools: (S, o, t) => t === 'scalpel' && !o.cut, pt: (S, o) => geo.polyAt(o.pts, o.prog) });\ndef('mass', { drain: .2, label: 'mass', init(S, o, sp) { axis(S, o, sp); o.depth = sp.depth || 36; o.par = 4; o.cut = false; o.R = sp.r || 20; const ring = Op.add(S, 'incision', { x: o.x, y: o.y, ring: true, r: o.R }); o.ringId = ring.id; o.reveals = sp.reveals; o.heal = sp.heal !== false; },\n  tick(S, o) { if (!o.cut) { const r = Op.byId(S, o.ringId); if (!r || r.cut) { o.cut = true; ev(S, 'massfree', o.x, o.y); } } }, grip: (S, o) => o.cut, tools: (S, o, t) => t === 'forceps' && o.cut, pt: (S, o) => [o.x0, o.y0],\n  onDone(S, o) { if (o.reveals) Op.add(S, o.reveals, { x: o.x0, y: o.y0, ph: S.ph }); if (o.heal) Op.add(S, 'wound', { x: o.x0, y: o.y0 + 4, n: 3, ph: S.ph }); } });\ndef('clot', { drain: .3, label: 'clot', init(S, o, sp) { axis(S, o, sp); o.depth = sp.depth || 38; o.par = 3; o.sedated = false; }, sed: (S, o) => !o.sedated, dose(S, o, p, grade, e) { o.sedated = true; ev(S, 'sedated', o.x, o.y); Op.award(S, p, o.x, o.y, grade, 60); }, grip: (S, o) => o.sedated, tools: (S, o, t) => (t === 'syringe' && !o.sedated) || (t === 'forceps' && o.sedated), pt: (S, o) => [o.x0, o.y0] });\ndef('screw', { drain: .05, label: 'screw', init(S, o, sp) { o.turns = sp.turns || 3; o.prog = 0; o.depth = 1; o.par = 4; o.free = false; o.spin = 0; }, grip: () => true, rot: true, catchAnywhere: true, tools: sameTool('forceps'), release(S, o, p, g) { o.done = true; Op.award(S, p, o.x, o.y, S.rt - g.t0 < o.turns * 1.6 ? 'Textbook' : 'Clean', 90); ev(S, 'caught', o.x, o.y, 'screw'); } });\ndef('retractorHandle', { req: false, label: 'retractor', init(S, o, sp) { o.prog = 0; o.depth = 1e9; o.held = true; o.window = sp.window || 0; o.maxSpeed = 1e9; }, grip: () => true, tools: sameTool('forceps'), letgo() {}, pulling() {}, tick(S, o, dt) { const holding =