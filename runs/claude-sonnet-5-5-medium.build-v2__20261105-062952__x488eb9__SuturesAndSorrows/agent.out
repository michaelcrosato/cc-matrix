F\npython3 tests/shots.py op1 \"GAME.run={bonus:{clock:0,steady:0},caseId:'c1',fails:0,easy:false};GAME.game.go('op',{id:'c1',cheat:false})\" 3500 story \"GAME.game.go('story',{id:'c1pre',next:()=>{}})\" 2500"}}}
