{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgjuKBWavqXC6kKeLMvyJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PB8bHSUuW3b6FKiYwGmH2p","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-062952__x488eb9/work/SuturesAndSorrows*/ && python3 - <<'EOF'\n# small sim/view patches for the net layer\np='src/core/tools.js'; s=open(p).read()\ns=s.replace(\"o.sc = (o.sc || 0) + 1; o.gsum\",\"p.st = (p.st || 0) + 1; o.sc = (o.sc || 0) + 1; o.gsum\")\ns=s.replace(\"Op.award(S, p, o.x, o.y, grade, o.pts || 90); ev(S, 'burned', o.x, o.y, o.type);\",\"p.burn = (p.burn || 0) + 1; Op.award(S, p, o.x, o.y, grade, o.pts || 90); ev(S, 'burned', o.x, o.y, o.type);\")\nopen(p,'w').write(s)\np='src/scenes/opview.js'; s=open(p).read()\ns=s.replace(\"for (let i = 0; i < S.np; i++) this.ctl.push({\",\"for (let i = 0; i < S.np; i++) if (!o.local || o.local.includes(i)) this.ctl.push({\")\ns=s.replace(\"const p0 = S.pl[this.o.seat || 0] || S.pl[0], A = G.Audio;\",\"const p0 = S.pl[this.o.seat || 0] || S.pl[0], A = G.Audio; if (this.o.net && this.o.net.beforeDrain) this.o.net.beforeDrain(S);\")\ns=s.replace(\"for (const c of this.ctl) {\\n      const p = S.pl[c.i]; if (p.gone) continue; const x = Math.round(c.cur.x + OX), y = Math.round(c.cur.y + OY);\",\"for (const p of S.pl) {\\n      const c = this.ctl.find(q => q.i === p.i) || { i: p.i, cur: { x: p.rx != null ? p.rx : p.x, y: p.ry != null ? p.ry : p.y, loupe: false }, wheelT: 0, tool: p.tool, kind: 'remote' }; if (p.gone) continue; const x = Math.round(c.cur.x + OX), y = Math.round(c.cur.y + OY);\")\ns=s.replace(\"const c0 = (this.ctl[this.o.seat || 0] || this.ctl[0] || {}).cur\",\"const c0 = (this.ctl.find(q => q.i === (this.o.seat || 0)) || this.ctl[0] || {}).cur\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"const p0 = S.pl\\[this.o.seat\" src/scenes/opview.js | cut -c1-120; cat > src/net/hub.js <<'EOF'\n// AI Hub Session Protocol v1, shared world. The host's copy runs the sim; the others mirror it and send their own hands.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), px = E.px, U = G.UI, Op = G.Op, SC = G.scenes;\nconst HUB = window.AIHub, TOOLS = G.TOOLS;\nG.inSession = !!(HUB && HUB.active);\nconst H = G.Hub = { info: null, card: null, phase: 'wait', over: false, S: null, view: null, seq: 0, heard: 0, inN: 0, acc: 0, evAcc: 0, remote: {}, sentIds: new Set(), pendingEv: [], t: 0, rot: 0 };\nconst idxOf = id => H.info.players.findIndex(q => q.id === id);\nconst flags = o => (o.cut ? 1 : 0) | (o.open ? 2 : 0) | (o.dead ? 4 : 0) | (o.free ? 8 : 0) | (o.sedated || o.sedd ? 16 : 0) | (o.hid ? 32 : 0) | (o.clamped ? 64 : 0);\nconst dynOf = o => (o.vol != null ? o.vol : o.sc != null ? o.sc : o.prog != null ? o.prog : o.amp != null ? o.amp : 0);\nconst applyDyn = (o, f, v, bp) => { if (o.type === 'pool') { o.vol = v; o.r = Math.sqrt(Math.max(0, v)) * 1.15; } else if (o.st) { o.sc = v; o.st.forEach((s, i) => { s.done = i < v; }); } else if (o.type === 'tremolo') o.amp = v; else if (o.prog != null || o.type === 'incision') o.prog = v; o.bp = bp; o.cut = !!(f & 1); o.open = !!(f & 2); o.dead = !!(f & 4); o.free = !!(f & 8); if (o.sedated != null) o.sedated = !!(f & 16); o.clamped = !!(f & 64); };\nH.connect = async () => { try { H.info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); } catch (e) { H.info = null; } if (!H.info) return null;\n  HUB.on('card', c => { H.card = c; }); HUB.on('start', () => { H.phase = 'count'; });\n  HUB.on('message', (d, from) => H.onMsg(d, from)); HUB.on('leave', ({ id }) => { const i = idxOf(id); if (H.S && H.S.pl[i]) H.S.pl[i].gone = true; });\n  HUB.on('time-up', () => { if (H.info.isHost) H.finish(false); }); HUB.on('end', () => { H.phase = 'over'; H.over = true; try { G.game.audio.music(null); G.game.audio.mute(true); G.Audio.silence(); } catch (e) {} });\n  H.build(); HUB.ready(); return H.info; };\nH.build = () => { const n = H.info.players.length, def = G.grandRounds(n); G.CASES.gr = def; const seed = Math.floor(HUB.rng('sim')() * 2147483647) || 7; const S = H.S = Op.create(def, { seed, difficulty: 'Resident', players: n }); H.info.players.forEach((q, i) => { S.pl[i].color = q.color; S.pl[i].name = q.name; }); S.noRewind = true; const me = idxOf(H.info.me), server = H.info.server === true || me < 0;\n  const g = G.game; H.view = new G.OpView(g, S, { local: server ? [] : [me], seat: me < 0 ? 0 : me, hostSim: H.info.isHost, net: H, noRumble: false }); H.view.objective = def.phases[0].obj; H.me = me; H.server = server; for (const o of S.objs) H.sentIds.add(o.id); G.music('op'); };\n// ---- host: remote hands\nH.remote_ = (S, inputs) => { for (let i = 0; i < S.np; i++) { if (inputs[i]) continue; const r = H.remote[i]; if (!r || S.pl[i].gone) { inputs[i] = { x: S.pl[i].x, y: S.pl[i].y, trig: 0, tool: S.pl[i].tool }; continue; } const q = r.q && r.q.length > 1 ? r.q.shift() : r.last; inputs[i] = { x: q[0], y: q[1], trig: q[2], tool: TOOLS[r.tool] || 'forceps', fine: r.fine, gift: r.gift ? 1 : 0 }; r.gift = 0; } };\nH.remote = {}; H.remote_fn = H.remote_;\nObject.defineProperty(H, 'remote', { get() { return H._r || (H._r = {}); }, set(v) { H._r = v; } });\nH.onMsg = (d, from) => { const S = H.S; if (!S) return; if (H.info.isHost) { const i = idxOf(from); if (i < 0) return; if (d.t === 'i') { const r = H._r[i] || (H._r[i] = { n: 0, q: [], last: [S.pl[i].x, S.pl[i].y, 0] }); if (d.n > r.n) { r.n = d.n; r.tool = d.k; r.fine = d.f; const arr = d.r || [[d.x, d.y, d.g]]; for (const s of arr) r.q.push([s[0], s[1], s[2]]); if (r.q.length > 12) r.q.splice(0, r.q.length - 12); r.last = r.q[r.q.length - 1]; S.pl[i].rx = r.last[0]; S.pl[i].ry = r.last[1]; } } else if (d.t === 'p') { const r = H._r[i] || (H._r[i] = { n: 0, q: [], last: [S.pl[i].x, S.pl[i].y, 0] }); r.gift = 1; } }\n  else if (from === H.info.host) { if (d.t === 's' && d.n > H.heard) { H.heard = d.n; S.clock = d.c / 1000; S.vitals = d.v; S.steady = d.st; S.lb = !!d.lb; S.score = d.sc; if (d.ph !== S.ph) { S.ph = d.ph; H.view.objective = G.CASES.gr.phases[d.ph] ? G.CASES.gr.phases[d.ph].obj : ''; } for (const q of d.p) { const p = S.pl[q[0]]; if (!p) continue; if (q[0] !== H.me) { p.rx = q[1]; p.ry = q[2]; p.x = q[1]; p.y = q[2]; p.tool = TOOLS[q[3]]; p.trig = q[4]; } p.score = q[5]; }\n      const alive = new Set(d.a.split(',').filter(Boolean).map(Number)); S.objs = S.objs.filter(o => alive.has(o.id)); for (const a of d.d) { const o = S.objs.find(x => x.id === a[0]); if (o) { o.x = a[1]; o.y = a[2]; applyDyn(o, a[5], a[3], a[4]); } } S.rt += 1 / 12; S.hb = d.hb; S.wf = d.lb ? .25 : 1; }\n    else if (d.t === 'e') { for (const o of d.n || []) if (!S.objs.some(x => x.id === o.id)) S.objs.push(o); for (const e of d.ev || []) S.ev.push(e); } else if (d.t === 'over') { H.over = true; } } };\n// ---- host: events captured before the view drains them\nH.beforeDrain = S => { if (!H.info.isHost) return; for (const e of S.ev) if (['grade', 'slip', 'stitch', 'caught', 'burned', 'healed', 'cutdone', 'phase', 'beat', 'tear', 'iv', 'codeblue', 'revive', 'lb'].includes(e[0]) && H.pendingEv.length < 30) H.pendingEv.push(e); };\nH.remote = H.remote;\nH.finish = won => { const S = H.S; if (H.over && H.sent) return; H.over = true; H.sent = true; const live = H.info.players.filter(q => !(S.pl[idxOf(q.id)] || {}).gone), scoreOf = q => (S.pl[idxOf(q.id)] || {}).score | 0; const sorted = live.slice().sort((a, b) => scoreOf(b) - scoreOf(a)), standings = []; for (const q of sorted) { const last = standings[standings.length - 1]; if (last && scoreOf(H.info.players.find(z => z.id === last[0])) === scoreOf(q)) last.push(q.id); else standings.push([q.id]); }\n  const scores = Object.fromEntries(H.info.players.map(q => [q.id, scoreOf(q)])); const best = (key, title, fmt) => { let b = null, bv = 0; for (const q of live) { const v = S.pl[idxOf(q.id)][key] || 0; if (v > bv) { bv = v; b = q; } } return b ? { id: b.id, title, detail: fmt(bv) } : null; };\n  const awards = [best('tb', 'Steadiest Hand', v => v + ' Textbook'), best('st', 'Needlework', v => v + ' stitches'), best('suc', 'Hoover', v => Math.round(v) + ' suctioned'), best('burn', 'Firebrand', v => v + ' burns')].filter(Boolean);\n  const stats = { slips: S.stats.slips, clock: Math.round(S.clock) }; try { HUB.send({ t: 'over', w: won ? 1 : 0 }); } catch (e) {} HUB.finish({ standings, scores, won: !!(won || S.over === 'won'), stats, awards }); };\n// ---- the scene\nSC.hubround = { camera: { zoom: false, wheel: false }, pausable: true, view: 'overhead',\n  enter() { G.game.input.consumeAll(); this.t = 0; if (!H.S && H.info) H.build(); },\n  update(dt) { const g = G.game, I = g.input; g.focus(g.W / 2, g.H / 2, 0); H.t += dt; if (!H.info || H.over && H.phase === 'over') return; const S = H.S; if (!S) return;\n    if (H.phase === 'wait') { if (!H.server) { if (I.pressed('confirm') || I.pressed('start')) HUB.answer('ready'); if (I.pressed('more') || I.pressed('gift')) HUB.answer('more'); const c = I.clicked(); if (c) HUB.answer(c[1] > g.H * .75 ? 'more' : 'ready'); } return; }\n    if (H.phase === 'count') { if (HUB.time() >= 0) H.phase = 'play'; return; }\n    if (H.phase !== 'play' || H.over) return; const v = H.view;\n    // wire remote hands in, step, send\n    if (H.info.isHost) v.o.net.remote = (SS, inputs) => H.remote_(SS, inputs); else v.o.net.remote = null;\n    if (!H.info.isHost && H.me >= 0) { /* clients keep their own cursor local and mirror the rest */ }\n    v.step(dt); if (!H.server && H.me >= 0) { const c = v.ctl[0], p = S.pl[H.me]; p.x = c.cur.x; p.y = c.cur.y; p.tool = c.tool; p.trig = c.trigV; c.hist = c.hist || []; c.hist.push([c.cur.x | 0, c.cur.y | 0, c.trigV > .3 ? 1 : 0]); if (c.hist.length > 6) c.hist.shift(); }\n    H.acc += dt; if (H.acc >= 1 / 15) { H.acc = 0; if (!H.server && H.me >= 0 && !H.info.isHost) { const c = v.ctl[0]; HUB.send({ t: 'i', n: ++H.inN, k: TOOLS.indexOf(c.tool), f: c.cur.fine ? 1 : 0, r: c.hist.slice() }, { to: H.info.host, reliable: false }); } }\n    if (H.pGift && !H.info.isHost) { H.pGift = false; HUB.send({ t: 'p' }, { to: H.info.host, reliable: true }); }\n    if (!H.info.isHost && !H.server && H.me >= 0 && v.ctl[0].input.pressed('gift')) HUB.send({ t: 'p' }, { to: H.info.host, reliable: true });\n    if (H.info.isHost) { H.sacc = (H.sacc || 0) + dt; if (H.sacc >= 1 / 12) { H.sacc = 0; H.snap(); } H.evAcc += dt; if (H.evAcc >= .25) { H.evAcc = 0; H.flushEv(); }\n      if (S.over || S.clock <= 0) H.finish(S.over === 'won'); } },\n  draw(r) { if (!H.info || H.info.server === true && H.phase !== 'wait') { return; } if (H.phase === 'wait' || H.phase === 'count') { this.card(r); return; } if (H.view && H.S) H.view.draw(r); if (H.over) r.overlay(g => U.center(g, 'ROUND OVER', r.W / 2, r.H / 2, '#ffffff', { scale: 3 })); },\n  card(r) { const W = r.W, H_ = r.H, c = H.card || {}, me = H.info; G.stage('theatre', null, 0, 0, 0); r.overlay(g => { G.stage('theatre', g, W, H_, H.t); px.rect(g, 0, 0, W, H_, '#000a'); const x = W / 2 - 170; px.rect(g, x - 6, 10, 352, H_ - 20, '#d8e4e8'); px.rect(g, x, 16, 340, H_ - 32, '#f4f8f8'); U.center(g, G.GAME_TITLE.toUpperCase(), W / 2, 22, '#0b3a40', { scale: 2, shadow: null }); me.players.forEach((q, i) => { const rd = (c.ready || []).includes(q.id); px.disc(g, x + 20 + i * 80, 52, 6, q.color); U.text(g, (rd ? '✓ ' : '') + (q.id === me.me ? 'YOU' : 'P' + (i + 1)), x + 30 + i * 80, 49, '#0b3a40', { shadow: null }); });\n      U.text(g, 'HOW TO WIN', x + 12, 70, '#a02020', { shadow: null }); U.wrap(G.HUB_TAGS.goal, 316).forEach((l, i) => U.text(g, l, x + 12, 82 + i * 9, '#202030', { shadow: null })); U.text(g, 'CONTROLS', x + 12, 106, '#a02020', { shadow: null }); const I = G.game.input; ['Aim: ' + (I.lastDevice === 'gamepad' ? 'right stick' : 'mouse or WASD'), 'Use tool: ' + I.label('useTool'), 'Pick tool: ' + (I.lastDevice === 'gamepad' ? 'left stick' : '1 to 8'), 'The Steady: ' + I.label('gift')].forEach((l, i) => U.text(g, l, x + 12, 118 + i * 10, '#202030', { shadow: null }));\n      const left = H.phase === 'count' ? Math.max(0, Math.ceil(-HUB.time() / 1000)) : (c.left != null ? Math.ceil(c.left / 1000) : '-'); U.center(g, H.phase === 'count' ? 'STARTING ' + left : 'STARTS IN ' + left, W / 2, H_ - 70, '#0b3a40', { scale: 2, shadow: null }); if (!H.server) { U.capText(g, G.game, 'confirm', 'Ready', x + 12, H_ - 44, '#202030'); U.capText(g, G.game, 'more', 'More time', x + 100, H_ - 44, '#202030'); } }); } };\nH.snap = () => { const S = H.S, ids = S.objs.map(o => o.id); const n = S.objs.length, per = 18; const out = []; for (let k = 0; k < Math.min(per, n); k++) { const o = S.objs[(H.rot + k) % n]; out.push([o.id, o.x | 0, o.y | 0, Math.round(dynOf(o) * 10) / 10, Math.round((o.bp || 0) * 100) / 100, flags(o)]); } H.rot = (H.rot + per) % Math.max(1, n);\n  const p = S.pl.filter(q => !q.gone).map(q => [q.i, q.x | 0, q.y | 0, TOOLS.indexOf(q.tool), q.trig > .3 ? 1 : 0, q.score | 0]); HUB.send({ t: 's', n: ++H.seq, c: Math.round(S.clock * 1000), v: Math.round(S.vitals), ph: S.ph, st: Math.round(S.steady), lb: S.lb ? 1 : 0, sc: S.score | 0, hb: Math.round(S.hb * 100) / 100, p, d: out, a: ids.join(',') }, { reliable: false }); };\nH.flushEv = () => { const S = H.S; const fresh = S.objs.filter(o => !H.sentIds.has(o.id)); fresh.forEach(o => H.sentIds.add(o.id)); const ev = H.pendingEv.splice(0); if (fresh.length || ev.length) HUB.send({ t: 'e', n: fresh.map(o => JSON.parse(JSON.stringify(o))), ev }, { reliable: true }); };\n})();\nEOF\nnode -e \"const fs=require('fs');new Function(fs.readFileSync('src/net/hub.js','utf8'));console.log('ok')\""},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4009,"cache_read_input_tokens":384430,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4009},"output_tokens":30,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"73cf9888-9422-42e0-82aa-d7becfd7d585","uuid":"f5e5d58e-ab40-4722-a57a-cfe21b6c9cd8","timestamp":"2026-11-05T14:01:33.085Z","request_id":"req_011CgjuKBETppYscK7qKKcqi","wire_tool_inputs":{"toolu_01PB8bHSUuW3b6FKiYwGmH2p":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-062952__x488eb9/work/SuturesAndSorrows*/ && python3 - <<'EOF'\n# small sim/view patches for the net layer\np='src/core/tools.js'; s=open(p).read()\ns=s.replace(\"o.sc = (o.sc || 0) + 1; o.gsum\",\"p.st = (p.st || 0) + 1; o.sc = (o.sc || 0) + 1; o.gsum\")\ns=s.replace(\"Op.award(S, p, o.x, o.y, grade, o.pts || 90); ev(S, 'burned', o.x, o.y, o.type);\",\"p.burn = (p.burn || 0) + 1; Op.award(S, p, o.x, o.y, grade, o.pts || 90); ev(S, 'burned', o.x, o.y, o.type);\")\nopen(p,'w').write(s)\np='src/scenes/opview.js'; s=open(p).read()\ns=s.replace(\"for (let i = 0; i < S.np; i++) this.ctl.push({\",\"for (let i = 0; i < S.np; i++) if (!o.local || o.local.includes(i)) this.ctl.push({\")\ns=s.replace(\"const p0 = S.pl[this.o.seat || 0] || S.pl[0], A = G.Audio;\",\"const p0 = S.pl[this.o.seat || 0] || S.pl[0], A = G.Audio; if (this.o.net && this.o.net.beforeDrain) this.o.net.beforeDrain(S);\")\ns=s.replace(\"for (const c of this.ctl) {\\n      const p = S.pl[c.i]; if (p.gone) continue; const x = Math.round(c.cur.x + OX), y = Math.round(c.cur.y + OY);\",\"for (const p of S.pl) {\\n      const c = this.ctl.find(q => q.i === p.i) || { i: p.i, cur: { x: p.rx != null ? p.rx : p.x, y: p.ry != null ? p.ry : p.y, loupe: false }, wheelT: 0, tool: p.tool, kind: 'remote' }; if (p.gone) continue; const x = Math.round(c.cur.x + OX), y = Math.round(c.cur.y + OY);\")\ns=s.replace(\"const c0 = (this.ctl[this.o.seat || 0] || this.ctl[0] || {}).cur\",\"const c0 = (this.ctl.find(q => q.i === (this.o.seat || 0)) || this.ctl[0] || {}).cur\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"const p0 = S.pl\\[this.o.seat\" src/scenes/opview.js | cut -c1-120; cat > src/net/hub.js <<'EOF'\n// AI Hub Session Protocol v1, shared world. The host's copy runs the sim; the others mirror it and send their own hands.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), px = E.px, U = G.UI, Op = G.Op, SC = G.scenes;\nconst HUB = window.AIHub, TOOLS = G.TOOLS;\nG.inSession = !!(HUB && HUB.active);\nconst H = G.Hub = { info: null, card: null, phase: 'wait', over: false, S: null, view: null, seq: 0, heard: 0, inN: 0, acc: 0, evAcc: 0, remote: {}, sentIds: new Set(), pendingEv: [], t: 0, rot: 0 };\nconst idxOf = id => H.info.players.findIndex(q => q.id === id);\nconst flags = o => (o.cut ? 1 : 0) | (o.open ? 2 : 0) | (o.dead ? 4 : 0) | (o.free ? 8 : 0) | (o.sedated || o.sedd ? 16 : 0) | (o.hid ? 32 : 0) | (o.clamped ? 64 : 0);\nconst dynOf = o => (o.vol != null ? o.vol : o.sc != null ? o.sc : o.prog != null ? o.prog : o.amp != null ? o.amp : 0);\nconst applyDyn = (o, f, v, bp) => { if (o.type === 'pool') { o.vol = v; o.r = Math.sqrt(Math.max(0, v)) * 1.15; } else if (o.st) { o.sc = v; o.st.forEach((s, i) => { s.done = i < v; }); } else if (o.type === 'tremolo') o.amp = v; else if (o.prog != null || o.type === 'incision') o.prog = v; o.bp = bp; o.cut = !!(f & 1); o.open = !!(f & 2); o.dead = !!(f & 4); o.free = !!(f & 8); if (o.sedated != null) o.sedated = !!(f & 16); o.clamped = !!(f & 64); };\nH.connect = async () => { try { H.info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); } catch (e) { H.info = null; } if (!H.info) return null;\n  HUB.on('card', c => { H.card = c; }); HUB.on('start', () => { H.phase = 'count'; });\n  HUB.on('message', (d, from) => H.onMsg(d, from)); HUB.on('leave', ({ id }) => { const i = idxOf(id); if (H.S && H.S.pl[i]) H.S.pl[i].gone = true; });\n  HUB.on('time-up', () => { if (H.info.isHost) H.finish(false); }); HUB.on('end', () => { H.phase = 'over'; H.over = true; try { G.game.audio.music(null); G.game.audio.mute(true); G.Audio.silence(); } catch (e) {} });\n  H.build(); HUB.ready(); return H.info; };\nH.build = () => { const n = H.info.players.length, def = G.grandRounds(n); G.CASES.gr = def; const seed = Math.floor(HUB.rng('sim')() * 2147483647) || 7; const S = H.S = Op.create(def, { seed, difficulty: 'Resident', players: n }); H.info.players.forEach((q, i) => { S.pl[i].color = q.color; S.pl[i].name = q.name; }); S.noRewind = true; const me = idxOf(H.info.me), server = H.info.server === true || me < 0;\n  const g = G.game; H.view = new G.OpView(g, S, { local: server ? [] : [me], seat: me < 0 ? 0 : me, hostSim: H.info.isHost, net: H, noRumble: false }); H.view.objective = def.phases[0].obj; H.me = me; H.server = server; for (const o of S.objs) H.sentIds.add(o.id); G.music('op'); };\n// ---- host: remote hands\nH.remote_ = (S, inputs) => { for (let i = 0; i < S.np; i++) { if (inputs[i]) continue; const r = H.remote[i]; if (!r || S.pl[i].gone) { inputs[i] = { x: S.pl[i].x, y: S.pl[i].y, trig: 0, tool: S.pl[i].tool }; continue; } const q = r.q && r.q.length > 1 ? r.q.shift() : r.last; inputs[i] = { x: q[0], y: q[1], trig: q[2], tool: TOOLS[r.tool] || 'forceps', fine: r.fine, gift: r.gift ? 1 : 0 }; r.gift = 0; } };\nH.remote = {}; H.remote_fn = H.remote_;\nObject.defineProperty(H, 'remote', { get() { return H._r || (H._r = {}); }, set(v) { H._r = v; } });\nH.onMsg = (d, from) => { const S = H.S; if (!S) return; if (H.info.isHost) { const i = idxOf(from); if (i < 0) return; if (d.t === 'i') { const r = H._r[i] || (H._r[i] = { n: 0, q: [], last: [S.pl[i].x, S.pl[i].y, 0] }); if (d.n > r.n) { r.n = d.n; r.tool = d.k; r.fine = d.f; const arr = d.r || [[d.x, d.y, d.g]]; for (const s of arr) r.q.push([s[0], s[1], s[2]]); if (r.q.length > 12) r.q.splice(0, r.q.length - 12); r.last = r.q[r.q.length - 1]; S.pl[i].rx = r.last[0]; S.pl[i].ry = r.last[1]; } } else if (d.t === 'p') { const r = H._r[i] || (H._r[i] = { n: 0, q: [], last: [S.pl[i].x, S.pl[i].y, 0] }); r.gift = 1; } }\n  else if (from === H.info.host) { if (d.t === 's' && d.n > H.heard) { H.heard = d.n; S.clock = d.c / 1000; S.vitals = d.v; S.steady = d.st; S.lb = !!d.lb; S.score = d.sc; if (d.ph !== S.ph) { S.ph = d.ph; H.view.objective = G.CASES.gr.phases[d.ph] ? G.CASES.gr.phases[d.ph].obj : ''; } for (const q of d.p) { const p = S.pl[q[0]]; if (!p) continue; if (q[0] !== H.me) { p.rx = q[1]; p.ry = q[2]; p.x = q[1]; p.y = q[2]; p.tool = TOOLS[q[3]]; p.trig = q[4]; } p.score = q[5]; }\n      const alive = new Set(d.a.split(',').filter(Boolean).map(Number)); S.objs = S.objs.filter(o => alive.has(o.id)); for (const a of d.d) { const o = S.objs.find(x => x.id === a[0]); if (o) { o.x = a[1]; o.y = a[2]; applyDyn(o, a[5], a[3], a[4]); } } S.rt += 1 / 12; S.hb = d.hb; S.wf = d.lb ? .25 : 1; }\n    else if (d.t === 'e') { for (const o of d.n || []) if (!S.objs.some(x => x.id === o.id)) S.objs.push(o); for (const e of d.ev || []) S.ev.push(e); } else if (d.t === 'over') { H.over = true; } } };\n// ---- host: events captured before the view drains them\nH.beforeDrain = S => { if (!H.info.isHost) return; for (const e of S.ev) if (['grade', 'slip', 'stitch', 'caught', 'burned', 'healed', 'cutdone', 'phase', 'beat', 'tear', 'iv', 'codeblue', 'revive', 'lb'].includes(e[0]) && H.pendingEv.length < 30) H.pendingEv.push(e); };\nH.remote = H.remote;\nH.finish = won => { const S = H.S; if (H.over && H.sent) return; H.over = true; H.sent = true; const live = H.info.players.filter(q => !(S.pl[idxOf(q.id)] || {}).gone), scoreOf = q => (S.pl[idxOf(q.id)] || {}).score | 0; const sorted = live.slice().sort((a, b) => scoreOf(b) - scoreOf(a)), standings = []; for (const q of sorted) { const last = standings[standings.length - 1]; if (last && scoreOf(H.info.players.find(z => z.id === last[0])) === scoreOf(q)) last.push(q.id); else standings.push([q.id]); }\n  const scores = Object.fromEntries(H.info.players.map(q => [q.id, scoreOf(q)])); const best = (key, title, fmt) => { let b = null, bv = 0; for (const q of live) { const v = S.pl[idxOf(q.id)][key] || 0; if (v > bv) { bv = v; b = q; } } return b ? { id: b.id, title, detail: fmt(bv) } : null; };\n  const awards = [best('tb', 'Steadiest Hand', v => v + ' Textbook'), best('st', 'Needlework', v => v + ' stitches'), best('suc', 'Hoover', v => Math.round(v) + ' suctioned'), best('burn', 'Firebrand', v => v + ' burns')].filter(Boolean);\n  const stats = { slips: S.stats.slips, clock: Math.round(S.clock) }; try { HUB.send({ t: 'over', w: won ? 1 : 0 }); } catch (e) {} HUB.finish({ standings, scores, won: !!(won || S.over === 'won'), stats, awards }); };\n// ---- the scene\nSC.hubround = { camera: { zoom: false, wheel: false }, pausable: true, view: 'overhead',\n  enter() { G.game.input.consumeAll(); this.t = 0; if (!H.S && H.info) H.build(); },\n  update(dt) { const g = G.game, I = g.input; g.focus(g.W / 2, g.H / 2, 0); H.t += dt; if (!H.info || H.over && H.phase === 'over') return; const S = H.S; if (!S) return;\n    if (H.phase === 'wait') { if (!H.server) { if (I.pressed('confirm') || I.pressed('start')) HUB.answer('ready'); if (I.pressed('more') || I.pressed('gift')) HUB.answer('more'); const c = I.clicked(); if (c) HUB.answer(c[1] > g.H * .75 ? 'more' : 'ready'); } return; }\n    if (H.phase === 'count') { if (HUB.time() >= 0) H.phase = 'play'; return; }\n    if (H.phase !== 'play' || H.over) return; const v = H.view;\n    // wire remote hands in, step, send\n    if (H.info.isHost) v.o.net.remote = (SS, inputs) => H.remote_(SS, inputs); else v.o.net.remote = null;\n    if (!H.info.isHost && H.me >= 0) { /* clients keep their own cursor local and mirror the rest */ }\n    v.step(dt); if (!H.server && H.me >= 0) { const c = v.ctl[0], p = S.pl[H.me]; p.x = c.cur.x; p.y = c.cur.y; p.tool = c.tool; p.trig = c.trigV; c.hist = c.hist || []; c.hist.push([c.cur.x | 0, c.cur.y | 0, c.trigV > .3 ? 1 : 0]); if (c.hist.length > 6) c.hist.shift(); }\n    H.acc += dt; if (H.acc >= 1 / 15) { H.acc = 0; if (!H.server && H.me >= 0 && !H.info.isHost) { const c = v.ctl[0]; HUB.send({ t: 'i', n: ++H.inN, k: TOOLS.indexOf(c.tool), f: c.cur.fine ? 1 : 0, r: c.hist.slice() }, { to: H.info.host, reliable: false }); } }\n    if (H.pGift && !H.info.isHost) { H.pGift = false; HUB.send({ t: 'p' }, { to: H.info.host, reliable: true }); }\n    if (!H.info.isHost && !H.server && H.me >= 0 && v.ctl[0].input.pressed('gift')) HUB.send({ t: 'p' }, { to: H.info.host, reliable: true });\n    if (H.info.isHost) { H.sacc = (H.sacc || 0) + dt; if (H.sacc >= 1 / 12) { H.sacc = 0; H.snap(); } H.evAcc += dt; if (H.evAcc >= .25) { H.evAcc = 0; H.flushEv(); }\n      if (S.over || S.clock <= 0) H.finish(S.over === 'won'); } },\n  draw(r) { if (!H.info || H.info.server === true && H.phase !== 'wait') { return; } if (H.phase === 'wait' || H.phase === 'count') { this.card(r); return; } if (H.view && H.S) H.view.draw(r); if (H.over) r.overlay(g => U.center(g, 'ROUND OVER', r.W / 2, r.H / 2, '#ffffff', { scale: 3 })); },\n  card(r) { const W = r.W, H_ = r.H, c = H.card || {}, me = H.info; G.stage('theatre', null, 0, 0, 0); r.overlay(g => { G.stage('theatre', g, W, H_, H.t); px.rect(g, 0, 0, W, H_, '#000a'); const x = W / 2 - 170; px.rect(g, x - 6, 10, 352, H_ - 20, '#d8e4e8'); px.rect(g, x, 16, 340, H_ - 32, '#f4f8f8'); U.center(g, G.GAME_TITLE.toUpperCase(), W / 2, 22, '#0b3a40', { scale: 2, shadow: null }); me.players.forEach((q, i) => { const rd = (c.ready || []).includes(q.id); px.disc(g, x + 20 + i * 80, 52, 6, q.color); U.text(g, (rd ? '✓ ' : '') + (q.id === me.me ? 'YOU' : 'P' + (i + 1)), x + 30 + i * 80, 49, '#0b3a40', { shadow: null }); });\n      U.text(g, 'HOW TO WIN', x + 12, 70, '#a02020', { shadow: null }); U.wrap(G.HUB_TAGS.goal, 316).forEach((l, i) => U.text(g, l, x + 12, 82 + i * 9, '#202030', { shadow: null })); U.text(g, 'CONTROLS', x + 12, 106, '#a02020', { shadow: null }); const I = G.game.input; ['Aim: ' + (I.lastDevice === 'gamepad' ? 'right stick' : 'mouse or WASD'), 'Use tool: ' + I.label('useTool'), 'Pick tool: ' + (I.lastDevice === 'gamepad' ? 'left stick' : '1 to 8'), 'The Steady: ' + I.label('gift')].forEach((l, i) => U.text(g, l, x + 12, 118 + i * 10, '#202030', { shadow: null }));\n      const left = H.phase === 'count' ? Math.max(0, Math.ceil(-HUB.time() / 1000)) : (c.left != null ? Math.ceil(c.left / 1000) : '-'); U.center(g, H.phase === 'count' ? 'STARTING ' + left : 'STARTS IN ' + left, W / 2, H_ - 70, '#0b3a40', { scale: 2, shadow: null }); if (!H.server) { U.capText(g, G.game, 'confirm', 'Ready', x + 12, H_ - 44, '#202030'); U.capText(g, G.game, 'more', 'More time', x + 100, H_ - 44, '#202030'); } }); } };\nH.snap = () => { const S = H.S, ids = S.objs.map(o => o.id); const n = S.objs.length, per = 18; const out = []; for (let k = 0; k < Math.min(per, n); k++) { const o = S.objs[(H.rot + k) % n]; out.push([o.id, o.x | 0, o.y | 0, Math.round(dynOf(o) * 10) / 10, Math.round((o.bp || 0) * 100) / 100, flags(o)]); } H.rot = (H.rot + per) % Math.max(1, n);\n  const p = S.pl.filter(q => !q.gone).map(q => [q.i, q.x | 0, q.y | 0, TOOLS.indexOf(q.tool), q.trig > .3 ? 1 : 0, q.score | 0]); HUB.send({ t: 's', n: ++H.seq, c: Math.round(S.clock * 1000), v: Math.round(S.vitals), ph: S.ph, st: Math.round(S.steady), lb: S.lb ? 1 : 0, sc: S.score | 0, hb: Math.round(S.hb * 100) / 100, p, d: out, a: ids.join(',') }, { reliable: false }); };\nH.flushEv = () => { const S = H.S; const fresh = S.objs.filter(o => !H.sentIds.has(o.id)); fresh.forEach(o => H.sentIds.add(o.id)); const ev = H.pendingEv.splice(0); if (fresh.length || ev.length) HUB.send({ t: 'e', n: fresh.map(o => JSON.parse(JSON.stringify(o))), ev }, { reliable: true }); };\n})();\nEOF\nnode -e \"const fs=require('fs');new Function(fs.readFileSync('src/net/hub.js','utf8'));console.log('ok')\""}}}
