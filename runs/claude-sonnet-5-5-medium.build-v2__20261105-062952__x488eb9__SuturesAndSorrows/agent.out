forbid."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4263,"cache_read_input_tokens":736715,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4263},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"73cf9888-9422-42e0-82aa-d7becfd7d585","uuid":"6a922053-c2f5-40e4-96da-4d6812319e70","timestamp":"2026-11-05T15:34:32.187Z","request_id":"req_011Cgk2T449v5wMSgsT1wo85"}
