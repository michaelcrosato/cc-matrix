 update(dt) { const g = G.game; this.t += dt; if (g.input.pressed('confirm') || g.input.pressed('start') || g.input.clicked()) { g.input.consumeAll(); G.Audio.sfx('select'); g.go('menu'); } },\n  draw(r) { const W = r.W, H = r.H, t = this.t; stageDraw('harbor', r, W, H, t); r.overlay(g => { const cx = W / 2; E.font.title(g, G.GAME_TITLE.toUpperCase(), cx, 28, { scale: Math.max(2, Math.min(4, Math.floor(W / 160))), colors: ['#ffffff', '#5ff0e0'], align: 'center', depth: 2, depthColor: '#06303a' });\n    const y = 86, n = 140; let prev = null; for (let i = 0; i < n; i++) { const hb = ((i / 36) + t * .8) % 1, k = Math.min(1, (t * 40) / n); if (i / n > k + .02) break; const yy = y - U.ecgY(hb) * 12; if (prev) px.line(g, cx - 70 + i - 1, prev, cx - 70 + i, yy, '#6affb0', 1); prev = yy; }\n    if (Math.floor(t * 2) % 2 === 0) U.center(g, 'PRESS ' + (G.game.input.label('confirm') || 'START'), cx, H - 40, '#ffffff', { scale: 2 });\n    U.text(g, 'v' + G.VERSION, 6, H - 12, '#5a7a80'); }); }, };\n// ---------------- main menu\nSC.menu = { enter() { const g = G.game; G.music('title'); this.t = 0; this.build(); }, build() { const g = G.game, p = G.prog; const has = p.next > 0 || g.saves && g.saves.latest && g.saves.latest();\n    this.items = [{ label: 'CONTINUE', disabled: !has }, 'NEW GAME', 'CASE FILES', 'GRAND ROUNDS', 'SETTINGS', 'ABOUT']; this.menu = new E.Menu(g, this.items, { x: 'center', y: Math.max(80, (g.H >> 1) - 20), scale: 2, rows: 6, onPick: (i, it) => this.pick(i), onCancel: () => g.go('title') }); if (!has) this.menu.index = 1; },\n  pick(i) { const g = G.game; G.Audio.sfx('select'); g.input.consumeAll(); if (i === 0) { G.continueGame(); } else if (i === 1) { g.go('difficulty', { fresh: true }); } else if (i === 2) g.go('casefiles'); else if (i === 3) g.go('lobby'); else if (i === 4) g.menu('settings'); else if (i === 5) g.go('about'); },\n  update(dt) { this.t += dt; this.menu.update(dt); }, draw(r) { stageDraw('harbor', r, r.W, r.H, this.t); r.overlay(g => { px.blend(g, .55, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#000')); U.center(g, G.GAME_TITLE.toUpperCase(), r.W / 2, 22, '#5ff0e0', { scale: 3 }); }); this.menu.draw(r); } };\nG.continueGame = () => { const g = G.game, p = G.prog; G.run.caseId = G.CASE_ORDER[Math.min(p.next, 10)]; if (g.saves && g.saves.latest && g.saves.latest()) { try { g.saves.load('auto'); } catch (e) {} } g.go('ward', { arrive: true }); };\n// ---------------- difficulty\nSC.difficulty = { enter(d) { this.d = d || {}; this.i = 1; this.t = 0; }, names: ['Intern', 'Resident', 'Attending'], quote: ['\"Drains softer, clock longer, hints on. You are among friends.\"', '\"The baseline. I will say nothing and observe.\"', '\"No Code Blue. A star for the flawless. I am told this is fun.\"'],\n  update(dt) { const g = G.game, I = g.input; this.t += dt; if (I.pressed('left')) { this.i = (this.i + 2) % 3; G.Audio.sfx('select'); } if (I.pressed('right')) { this.i = (this.i + 1) % 3; G.Audio.sfx('select'); }\n    const ptr = I.pointer(); if (ptr && I.lastDevice === 'mouse') { const W = g.W, cw = 130, gap = 12, x0 = (W - (cw * 3 + gap * 2)) / 2; for (let k = 0; k < 3; k++) { const x = x0 + k * (cw + gap); if (ptr[0] > x && ptr[0] < x + cw && ptr[1] > 50 && ptr[1] < 170) this.i = k; } }\n    const c = I.clicked(); if (I.pressed('confirm') || c) { I.consumeAll(); G.prog.diff = this.names[this.i]; G.Audio.sfx('confirm'); if (this.d.fresh) { G.prog = { diff: G.prog.diff, next: 0, ranks: G.prog.ranks || {}, star: G.prog.star || {}, flags: {}, ending: false, seen: {} }; g.go('story', { id: 'intro', next: () => g.go('story', { id: 'c1pre', next: () => G.startCase('c1') }) }); } else g.back && g.go('menu'); } if (I.pressed('cancel')) g.go('menu'); },\n  draw(r) { stageDraw('corridor', r, r.W, r.H, this.t); r.overlay(g => { px.blend(g, .5, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#000')); U.center(g, 'CHOOSE YOUR SHIFT', r.W / 2, 24, '#ffffff', { scale: 2 }); const cw = 130, gap = 12, x0 = Math.floor((r.W - (cw * 3 + gap * 2)) / 2); for (let k = 0; k < 3; k++) { const x = x0 + k * (cw + gap), sel = k === this.i; U.panel(g, x, sel ? 46 : 54, cw, sel ? 128 : 112, { line: sel ? '#5ff0e0' : '#2a5a60', bg: sel ? '#0b3a40ee' : '#06161aee' }); U.center(g, this.names[k].toUpperCase(), x + cw / 2, 62, sel ? '#ffd35a' : '#aacccc', { scale: 2 }); const lines = U.wrap(this.quote[k], cw - 14); lines.forEach((l, j) => U.text(g, l, x + 8, 92 + j * 9, '#e8fbf6')); }\n      U.capText(g, G.game, 'confirm', 'Choose', r.W / 2 - 40, r.H - 24); }); } };\n// ---------------- story\nconst SPEED = { Slow: 24, Normal: 40, Fast: 80, Instant: 400 };\nSC.story = { enter(d) { this.d = d; const sc = G.STORY[d.id]; this.sc = sc; this.i = -1; this.t = 0; this.chars = 0; this.log = []; this.showLog = false; this.card = sc.card ? 2.2 : 0; this.cine = sc.cine ? 4.5 : 0; this.cineT = 0; this.sp = {}; G.music(sc.ending ? 'piano' : sc.bg === 'ward3' ? 'ward' : 'tension'); this.game.weather = { kind: 'rain', amount: .5 }; this.adv(); }, adv() { this.i++; this.chars = 0; this.acc = 0; if (this.i >= this.sc.lines.length) { this.done = true; const n = this.d.next; this.d.next = null; G.game.input.consumeAll(); if (n) n(); else G.game.go('menu'); return; } const L = this.sc.lines[this.i]; this.log.push(L); if (L[0]) this.sp[L[0]] = { side: Object.keys(this.sp).length % 2 ? 1 : -1, t: 0 }; if (L[2]) G.Audio.speak(G.WHO(L[0]) || 'narr', L[2].slice(0, 6), {}); },\n  update(dt) { if (this.done) return; const g = G.game, I = g.input; this.t += dt; if (this.card > 0) { this.card -= dt; if (I.pressed('confirm')) this.card = 0; return; } if (this.cine > 0) { this.cine -= dt; this.cineT += dt; if (I.pressed('confirm') || I.pressed('cancel') || I.clicked()) { this.cine = 0; I.consumeAll(); } return; }\n    if (I.pressed('log')) this.showLog = !this.showLog; if (this.showLog) { if (I.pressed('cancel') || I.pressed('confirm')) this.showLog = false; return; }\n    const L = this.sc.lines[this.i]; if (!L) return; const speed = SPEED[g.settings.textSpeed || 'Normal'] || 40, skip = I.down('skip'); const before = Math.floor(this.chars); this.chars += dt * (skip ? 400 : speed); const now = Math.floor(this.chars); for (let k = before; k < now && k < L[2].length; k++) if (L[0]) G.Audio.dialogVoice(L[2][k], k, { speaker: G.WHO(L[0]) });\n    const full = this.chars >= L[2].length; const adv = I.pressed('confirm') || I.clicked() || (skip && full); if (adv) { I.consumeAll(); if (!full) this.chars = L[2].length; else this.adv(); } if (I.pressed('cancel') && I.down('skip')) { /* skip scene */ } },\n  draw(r) { const W = r.W, H = r.H; stageDraw(this.sc.bg, r, W, H, this.t); const g_ = this; r.overlay(g => {\n      if (this.cine > 0) { G.cine(this.sc.cine, g, W, H, this.cineT); U.text(g, '', 0, 0); U.capText(g, G.game, 'confirm', 'Skip', W - 56, H - 16); return; }\n      if (this.card > 0) { px.rect(g, 0, 0, W, H, '#000c'); U.center(g, this.sc.card, W / 2, H / 2 - 10, '#ffd35a', { scale: 2 }); return; }\n      const L = this.sc.lines[this.i]; if (!L) return;\n      for (const id in this.sp) { if (!G.hasCast(id)) continue; const s = this.sp[id], speaking = id === L[0]; s.t = Math.min(1, s.t + .06); const bx = s.side < 0 ? 20 : W - 132, by = H - 128 - 52, bob = speaking ? Math.round(Math.sin(this.t * 14) * 1) : 0; const cv = G.bust(id, speaking ? L[1] : 'neutral', { talk: speaking && Math.floor(this.chars / 2) % 2 === 0 && this.chars < L[2].length, blink: Math.floor(this.t * 2.2) % 9 === 0 }); if (!speaking) px.blend(g, .55, 'normal', () => g.drawImage(cv, bx, by + 6)); else g.drawImage(cv, Math.round(bx), by + bob); }\n      U.panel(g, 12, H - 56, W - 24, 48, { line: '#5ff0e0' }); if (L[0]) { const nm = G.WHO(L[0]); px.rect(g, 18, H - 66, font.width(nm) + 12, 12, '#0b3a40'); U.text(g, nm, 24, H - 63, '#5ff0e0'); }\n      const txt = L[2].slice(0, Math.floor(this.chars)); U.wrap(txt, W - 52).slice(0, 3).forEach((ln, j) => U.text(g, ln, 22, H - 48 + j * 10, L[0] ? '#e8fbf6' : '#aacccc'));\n      if (this.chars >= L[2].length && Math.floor(this.t * 3) % 2) px.poly(g, [[W - 26, H - 20], [W - 18, H - 20], [W - 22, H - 14]], '#5ff0e0');\n      U.capText(g, G.game, 'log', 'Log', W - 100, 6); U.capText(g, G.game, 'skip', 'Fast', W - 56, 6);\n      if (this.showLog) { px.rect(g, 0, 0, W, H, '#000d'); const last = this.log.slice(-9); last.forEach((l, j) => U.text(g, (G.WHO(l[0]) ? G.WHO(l[0]) + ': ' : '') + l[2].slice(0, 70), 12, 14 + j * 14, '#e8fbf6')); }\n    }); } };\nG.cine = (id, g, W, H, t) => { G.stage({ gurney: 'corridor', gala: 'gala', storm: 'harbor', final: 'er' }[id] || 'corridor', g, W, H, t); const k = t / 4.5; if (id === 'gurney') { const x = -60 + k * (W + 120); px.rect(g, x, H * .62, 50, 6, '#d8e4e8'); px.disc(g, x + 6, H * .62 - 5, 6, '#c88a6a'); px.rect(g, x + 14, H * .62 - 8, 28, 10, '#7a9ac8'); px.disc(g, x + 8, H * .62 + 10, 4, '#222'); px.disc(g, x + 42, H * .62 + 10, 4, '#222'); const rx = x - 14; px.rect(g, rx, H * .62 - 22, 8, 26, '#2f9c8e'); px.disc(g, rx + 4, H * .62 - 26, 5, '#f6d0b2'); px.rect(g, rx + 1, H * .62 - 31, 7, 3, '#c9562a'); U.center(g, 'GURNEY!', W / 2, 40, '#ff6a5a', { scale: 2 }); } else if (id === 'gala') { const cx = W / 2; px.line(g, cx + 20 + k * 40, H * .5 + k * 24, cx + 36 + k * 60, H * .5 + 30 + k * 6, '#caa860', 2); px.rect(g, cx - 4, H * .5 + (k > .4 ? 22 : 0), 10, k > .4 ? 12 : 34, '#ece7da'); px.disc(g, cx + 1, H * .5 - 5 + (k > .4 ? 28 : 0), 6, '#7c4a2e'); } else if (id === 'storm') { const sway = Math.sin(t * 1.6) * .12; px.poly(g, [[W * .2, H * .72 + Math.sin(t * 1.6) * 6], [W * .8, H * .72 - Math.sin(t * 1.6) * 6], [W * .72, H * .8], [W * .28, H * .8]], '#3a3a44'); px.rect(g, W * .44, H * .5, 40, 22, '#caa860'); px.rect(g, W * .5, H * .38, 4, 24, '#8a8a70'); U.center(g, 'FORCE NINE', W / 2, 30, '#ffffff', { scale: 2 }); } else { U.center(g, 'EVERYONE IS HERE', W / 2, 36, '#5ff0e0', { scale: 2 }); px.rect(g, W / 2 - 40, H * .6, 80, 6, '#d8e4e8'); for (let i = 0; i < 6; i++) { const a = i / 6 * 6.28 + t * .3; px.disc(g, W / 2 + Math.cos(a) * 50, H * .6 + Math.sin(a) * 18 - 14, 6, ['#2f9c8e', '#3d62a6', '#ece7da', '#6b7a48', '#e6e8f2', '#c4803c'][i]); } } };\n// ---------------- chart (+ lightbox)\nG.startCase = (id, o = {}) => { const g = G.game; G.run = { bonus: { clock: 0, steady: 0 }, caseId: id, fails: 0, easy: false, replay: !!o.replay, skills: !!o.skills }; g.go('chart', { id }); };\nSC.chart = { enter(d) { this.id = d.id; this.def = G.CASES[d.id]; this.t = 0; this.read = false; G.music('tension'); this.lb = this.def.lightbox && !G.run.lbDone; this.sub = 'clip'; G.Audio.speak('Nurse Quill', 'Patient, ' + this.def.patient, {}); this.lbState = { tries: 0, found: false, msg: '', cur: [213, 120] }; },\n  update(dt) { const g = G.game, I = g.input; this.t += dt; if (this.sub === 'clip') { if (I.pressed('confirm') || I.clicked()) { I.consumeAll(); if (this.lb) this.sub = 'lightbox'; else g.go('op', { id: this.id }); } if (I.pressed('cancel')) g.go(G.run.replay ? 'casefiles' : 'ward', {}); return; }\n    // lightbox: point and press\n    const L = this.lbState, d = this.def.lightbox, sp = 150 * dt, kb = I.padAim || I.padMove || [0, 0]; L.cur[0] = E.clamp(L.cur[0] + kb[0] * sp * 2 + ((I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0)) * sp, 10, 416); L.cur[1] = E.clamp(L.cur[1] + kb[1] * sp * 2 + ((I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0)) * sp, 10, 230); const ptr = I.pointer(); if (ptr && I.lastDevice === 'mouse') { L.cur[0] = ptr[0] - ((g.W - 426) >> 1); L.cur[1] = ptr[1] - ((g.H - 240) >> 1); }\n    if ((I.pressed('useTool') || I.pressed('confirm') || I.clicked()) && !L.found) { I.consumeAll(); const hit = Math.hypot(L.cur[0] - d.truth[0], L.cur[1] - d.truth[1]) < 14 + 10; L.tries++; if (hit) { L.found = true; L.msg = 'Second opinion confirmed. +20 s, +20 Steady.'; G.run.bonus.clock += 20; G.run.bonus.steady += 20; G.run.marker = d.truth; G.Audio.sfx('chime'); } else { L.msg = L.tries >= 3 ? 'Out of tries. Quill points it out.' : 'Wrong. -10 s. Percy smirks.'; G.run.bonus.clock -= 10; G.Audio.sfx('thud'); if (L.tries >= 3) { L.found = true; L.cur = d.truth.slice(); G.run.bonus.clock += 10; } } L.t = 0; }\n    else if (L.found && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); G.run.lbDone = true; g.go('op', { id: this.id }); } L.t = (L.t || 0) + dt; },\n  draw(r) { const W = r.W, H = r.H; stageDraw(this.sub === 'clip' ? 'office' : 'radiology', r, W, H, this.t); r.overlay(g => { const OX = (W - 426) >> 1, OY = (H - 240) >> 1; px.blend(g, .4, 'normal', () => px.rect(g, 0, 0, W, H, '#000'));\n      if (this.sub === 'clip') { const cw = 220, x = (W - cw) / 2, y = 20; px.rect(g, x - 4, y - 4, cw + 8, 190, '#6a4a2a'); px.rect(g, x, y, cw, 182, '#f4efe0'); px.rect(g, x + cw / 2 - 20, y - 8, 40, 10, '#9aaab8'); U.text(g, 'CHART', x + 10, y + 8, '#a02020', { scale: 2 }); U.text(g, 'Case ' + this.def.n + ': ' + this.def.name, x + 10, y + 28, '#202030'); U.text(g, 'Patient: ' + this.def.patient, x + 10, y + 40, '#202030'); U.wrap(G.CHART[this.id] || '', cw - 20).forEach((l, i) => U.text(g, l, x + 10, y + 58 + i * 10, '#303040', { shadow: null })); if (this.def.lightbox) { px.rect(g, x + 10, y + 120, 130, 34, '#fff3a0'); U.wrap('First opinion: ' + this.def.lightbox.opinion, 120).forEach((l, i) => U.text(g, l, x + 14, y + 124 + i * 9, '#403000', { shadow: null })); } U.capText(g, G.game, 'confirm', this.lb ? 'To the lightbox' : 'Scrub in', x + 10, y + 166, '#202030'); return; }\n      const d = this.def.lightbox, L = this.lbState; px.rect(g, OX + 40, OY + 20, 346, 196, '#d8f0ff'); px.rect(g, OX + 44, OY + 24, 338, 188, '#0a1420'); G.film(g, OX + 44, OY + 24, 338, 188, d.film, d.truth, this.t, L.found); const tx = OX + d.truth[0], ty = OY + d.truth[1];\n      if (L.found) { Dr_ring(g, tx, ty, 18, '#ffd35a'); } const cx = OX + L.cur[0], cy = OY + L.cur[1]; px.line(g, cx - 8, cy, cx + 8, cy, '#ffffff', 1); px.line(g, cx, cy - 8, cx, cy + 8, '#ffffff', 1); Dr_ring(g, cx, cy, 14, '#5ff0e0');\n      const od = G.bust('odalys', L.found ? 'smile' : 'shock'); g.drawImage(od, 0, 0, 112, 128, 4, H - 100, 84, 96); U.text(g, 'Mark what is really wrong. ' + (3 - L.tries) + ' tries.', OX + 50, OY + 4, '#ffffff'); U.text(g, L.msg || '', OX + 50, OY + 218, L.found ? '#6affb0' : '#ff9a8a'); px.rect(g, OX + 330, OY + 190, 52, 22, '#fff3a0'); U.text(g, d.opinion.slice(0, 10), OX + 333, OY + 194, '#403000', { shadow: null }); U.capText(g, G.game, 'useTool', L.found ? 'Continue' : 'Mark here', OX + 50, OY + 232 - 6 + (H > 240 ? 0 : 0)); }); } };\nconst Dr_ring = (g, x, y, r, c) => G.Draw.ring(g, x, y, r, c, 24);\nG.film = (g, x, y, w, h, kind, truth, t, show) => { const hash = i => { const s = Math.sin(i * 12.9898) * 43758.5453; return s - Math.floor(s); }; const bone = '#a8b8c4';\n  for (let i = 0; i < 300; i++) px.dot(g, x + hash(i) * w, y + hash(i, 2) * h, '#1a2a38'); px.blend(g, .3, 'normal', () => { px.disc(g, x + w / 2, y + h / 2, 70, '#3a5a74'); px.disc(g, x + w / 2 - 50, y + h / 2 + 10, 40, '#3a5a74'); });\n  if (kind === 'skull') { px.ell(g, x + w / 2, y + h / 2 - 6, 80, 76, bone); px.ell(g, x + w / 2, y + h / 2 - 6, 72, 68, '#18242e'); px.ell(g, x + w / 2 - 28, y + h / 2 - 10, 12, 10, '#0a1018'); px.ell(g, x + w / 2 + 28, y + h / 2 - 10, 12, 10, '#0a1018'); } else { px.rect(g, x + w / 2 - 4, y + 4, 8, h - 8, bone); for (let i = 0; i < 7; i++) { const yy = y + 20 + i * 24; px.line(g, x + w / 2 - 6, yy, x + w / 2 - 90 + i * 4, yy + 30, bone, 2); px.line(g, x + w / 2 + 6, yy, x + w / 2 + 90 - i * 4, yy + 30, bone, 2); } }\n  const hum = .6 + .4 * Math.sin(t * 6); px.blend(g, .5 * hum, 'add', () => px.disc(g, x + truth[0] - 44 + 44 * 0, y + truth[1] - 24 + 0, 5, '#5ff0e0')); if (show) px.blend(g, .5, 'add', () => px.disc(g, x + truth[0] - 44, y + truth[1] - 24, 10, '#5ff0e0')); };\n// ---------------- op\nSC.op = { pausable: true, camera: { zoom: false, wheel: false }, view: 'overhead',\n  enter(d) { const g = G.game; this.id = d.id || G.run.caseId; let def = G.CASES[this.id]; this.def = def; this.cheat = !!d.cheat; const diff = G.run.easy ? 'Intern' : G.prog.diff; const seed = d.seed || (def.n * 7919 + (G.run.fails * 13) + 5); const S = Op.create(def, { seed, difficulty: diff, players: d.players || 1 }); S.clock += G.run.bonus.clock; S.clock0 = S.clock; S.steady = Math.min(100, S.steady + G.run.bonus.steady); if (G.run.skills) { S.cheatLock = true; S.cheatFreezeClock = true; } this.S = S; this.view = new G.OpView(g, S, { bots: d.bots, cheat: this.cheat, seat: 0 }); this.view.objective = def.phases[0].obj; this.view.say(def.phases[0].bark || 'Hands, Doctor.', false); this.ended = 0; g.weather = null; g.cam && (g.cam.offset = [0, 0]); G.music(def.finale ? 'final' : def.phases.some(p => p.spawn && p.spawn.some(s => ['tremolo', 'fermata', 'dacapo', 'cantor'].includes(s.t))) ? 'boss' : 'op'); G.dev.tagged = false; this.mouseHidden = true; G.Audio.sfx('select'); this.scrub = 1.4; if (def.ship) g.weather = { kind: 'rain', amount: .8 }; },\n  exit() { G.Audio.silence(); G.game.audio.duck && G.game.audio.duck(false); G.game.weather = null; },\n  update(dt) { const g = G.game, S = this.S, v = this.view; g.focus(g.W / 2, g.H / 2, 0); if (this.scrub > 0) { this.scrub -= dt; return; } if (g.paused) return;\n    if (S.over || this.ended) { this.ended += dt; if (this.ended > .6 && !this.went) { this.went = true; if (S.over === 'won') { g.go('results', { S, id: this.id, def: this.def }); } else g.go('lost', { S, id: this.id, def: this.def, why: S.why }); } return; }\n    if (G.dev.open) G.devUpdate(dt, this); v.step(dt); if (G.dev.slow) {} if (G.dev.autoSurgeon && !v.ctl[0].bot) { v.ctl[0].kind = 'bot'; v.ctl[0].bot = new G.Bot({ cheat: false }); } if (!G.dev.autoSurgeon && v.ctl[0].kind === 'bot' && !this.cheat) { v.ctl[0].kind = 'human'; v.ctl[0].bot = null; }\n    if (g.input.pressed('pause')) {} },\n  draw(r) { if (this.scrub > 0) { const k = this.scrub / 1.4; r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#0b1c22'); U.center(g, 'SCRUB IN', r.W / 2, r.H / 2 - 16, '#5ff0e0', { scale: 3 }); U.center(g, 'Case ' + this.def.n + ': ' + this.def.name, r.W / 2, r.H / 2 + 14, '#ffffff'); }); return; } this.view.draw(r); r.overlay(g => { if (G.dev.open) G.devDraw(g, r.W, r.H, this); if (this.S.hush && this.S.static) {} }); } };\n// ---------------- lost\nSC.lost = { enter(d) { this.d = d; this.t = 0; G.run.fails++; G.Audio.silence(); G.game.audio.music(null); G.game.audio.sting(G.STINGS.lost); this.line = d.S.why === 'time' ? 'Time of death, oh-four-twelve.' : d.S.why === 'device' ? 'The device went off.' : G.BARKS.lost[Math.floor(Math.random() * G.BARKS.lost.length)]; const g = G.game; const items = ['RETRY FROM THIS PHASE', 'RESTART CASE']; if (G.run.fails >= 2 && !G.run.easy) items.push('LOWER DIFFICULTY FOR THIS CASE'); items.push('QUIT TO MENU'); this.items = items; this.menu = new E.Menu(g, items, { x: 'center', y: Math.max(110, g.H - 100), scale: 1, rows: 4, onPick: i => this.pick(i), onCancel: () => {} }); },\n  pick(i) { const g = G.game, it = this.items[i], d = this.d; G.Audio.sfx('select'); if (it.startsWith('RETRY')) { G.run.retry = true; g.go('op', { id: d.id, retry: d.S }); } else if (it.startsWith('RESTART')) { g.go('op', { id: d.id }); } else if (it.startsWith('LOWER')) { G.run.easy = true; g.go('op', { id: d.id }); } else g.go('menu'); },\n  update(dt) { this.t += dt; this.menu.update(dt); },\n  draw(r) { r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#05080c'); const y = 60; for (let i = 0; i < r.W; i++) px.dot(g, i, y + (i > r.W - 60 - this.t * 20 ? Math.sin(i * .6) * 8 : 0), '#ff6a5a'); U.center(g, 'FLATLINE', r.W / 2, 90, '#ff6a5a', { scale: 3 }); U.center(g, this.line, r.W / 2, 124, '#e8fbf6'); }); this.menu.draw(r); } };\nconst origOp = SC.op.enter; SC.op.enter = function (d) { origOp.call(this, d); if (d.retry) { const S = this.S, ch = d.retry.chk; if (ch) { const keep = { buf: [], ev: [] }; Op.restore(S, ch); S.chk = ch; Op.retry(S); S.over = null; this.view.ecg = []; this.view.objective = this.def.phases[S.ph].obj; } } };\n// ---------------- results\nSC.results = { enter(d) { this.d = d; const S = d.S, def = d.def; this.rank = G.rankOf(S, def); this.star = S.diff === 'Attending' && this.rank === 'S' && S.stats.slips === 0; this.dev = G.dev.tagged; this.t = 0; this.tile = 0; const st = S.stats; this.tiles = [['TIME LEFT', G.fmtTime(S.clock)], ['PULSE HELD', Math.round(S.vitals) + ''], ['TECHNIQUE', Math.round(100 * st.clean / Math.max(1, st.n)) + '%'], ['BEST FLOW', 'x' + Math.min(2, 1 + st.bestChain * .05).toFixed(1)]]; G.music('ward'); G.game.audio.sting(G.STINGS.closed);\n    if (!this.dev && !G.run.skills) { const p = G.prog; (p.ranks[d.id] ||= {}); const order = 'DCBAS'; const cur = p.ranks[d.id][S.diff]; if (!cur || order.indexOf(this.rank) > order.indexOf(cur)) p.ranks[d.id][S.diff] = this.rank; if (this.star) (p.star[d.id] ||= {})[S.diff] = true; const idx = G.CASE_ORDER.indexOf(d.id); if (!G.run.replay) p.next = Math.max(p.next, idx + 1); G.saveProg(); } },\n  update(dt) { const g = G.game, I = g.input; this.t += dt; this.tile = Math.min(4, Math.floor(this.t / .9)); if (this.t > 4.2 && !this.sfxRank) { this.sfxRank = true; G.Audio.sfx('stamp'); g.shake(4); } if ((I.pressed('confirm') || I.clicked()) && this.t > 1) { I.consumeAll(); if (this.t < 4.6) { this.t = 4.7; this.sfxRank = true; return; } this.leave(); } },\n  leave() { const g = G.game, id = this.d.id; if (G.run.skills) return g.go('casefiles'); if (G.run.replay) return g.go('casefiles'); const st = G.CASE_STORY[id]; const idx = G.CASE_ORDER.indexOf(id); const after = () => { if (id === 'c11') { G.prog.ending = true; G.saveProg(); g.go('credits'); } else g.go('ward', { arrive: true }); }; g.go('story', { id: st[1], next: after }); },\n  draw(r) { stageDraw('scrub', r, r.W, r.H, this.t); r.overlay(g => { const W = r.W, H = r.H; px.rect(g, 0, 0, W, H, '#000b'); U.center(g, 'CASE CLOSED', W / 2, 18, '#ff6a5a', { scale: 3 }); if (this.dev) U.center(g, 'DEV', W / 2 + 90, 22, '#ffd35a'); U.center(g, 'Case ' + this.d.def.n + ': ' + this.d.def.name, W / 2, 46, '#e8fbf6');\n      for (let i = 0; i < 4; i++) { const x = W / 2 - 170 + i * 87, y = 72; if (i < this.tile) { U.panel(g, x, y, 80, 46); U.center(g, this.tiles[i][0], x + 40, y + 8, '#8fb8b0'); U.center(g, this.tiles[i][1], x + 40, y + 22, '#ffffff', { scale: 2 }); U.text(g, '✓', x + 68, y + 4, '#6affb0'); } else px.rect(g, x, y, 80, 46, '#ffffff10'); }\n      if (this.t > 4.2) { const k = Math.min(1, (this.t - 4.2) * 3); U.center(g, this.rank, W / 2, 128 - (1 - k) * 20, ({ S: '#ffd35a', A: '#6affb0', B: '#7ae0ff', C: '#e8fbf6', D: '#ff9a8a' })[this.rank], { scale: 8 }); if (this.star) U.center(g, '★ TEXTBOOK', W / 2, 190, '#ffd35a', { scale: 2 }); U.center(g, G.RANK_LINES[this.rank], W / 2, 206, '#e8fbf6'); U.capText(g, G.game, 'confirm', 'Continue', W / 2 - 36, H - 20); } }); } };\n})();\nEOF\nnode -e \"const fs=require('fs');new Function(fs.readFileSync('src/scenes/core.js','utf8'));console.log('ok')\""},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12356,"cache_read_input_tokens":325775,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12356},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"73cf9888-9422-42e0-82aa-d7becfd7d585","uuid":"116f7e40-43c2-4c7e-be23-4acad48a179a","timestamp":"2026-11-05T13:57:28.034Z","request_id":"req_011CgjtvuMdDEqrKHrCxhP2e","wire_tool_inputs":{"toolu_01PCMgk6L4fN4d19vUqtfjzJ":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-062952__x488eb9/work/SuturesAndSorrows*/ && cat >> ../PROGRESS.md <<'EOF'\n- [x] written: art/stages.js ui/ui.js scenes/opview.js (G.OpView: ctl/dev/step/draw/overlay/hud). manifest still must list: art/draw.js art/stages.js data/story.js ui/ui.js scenes/*.js net/hub.js ui/dev.js main.js\n- NEXT: scenes/core.js (title,menu,difficulty,story,chart+lightbox,op,lost,results) -> scenes/extra.js (ward,casefiles,lobby,about,credits,attract) -> net/hub.js -> ui/dev.js -> main.js -> build.mjs -> browser check\nEOF\ncat > src/scenes/core.js <<'EOF'\n// Scenes: title, menu, difficulty, story, chart (+ lightbox), op, lost, results.\n(() => {\nconst E = My3D2dge, G = (window.GAME ||= {}), px = E.px, font = E.font, U = G.UI, Op = G.Op;\nconst SC = G.scenes = {};\nconst rank = (S, def) => { const par = def.par || 4000, r = S.score / par; let k = r >= .95 ? 'S' : r >= .8 ? 'A' : r >= .6 ? 'B' : r >= .4 ? 'C' : 'D'; if (S.capped && 'SA'.includes(k)) k = 'B'; return k; };\nG.rankOf = rank;\n// ---------------- progress\nG.prog = { diff: 'Resident', next: 0, ranks: {}, star: {}, flags: {}, ending: false, seen: {} };\nG.loadProg = () => { try { const v = E.store.get(G.GAME_TITLE + ':prog', null); if (v) G.prog = { ...G.prog, ...v }; } catch (e) {} };\nG.saveProg = () => { try { E.store.set(G.GAME_TITLE + ':prog', G.prog); } catch (e) {} };\nG.run = { bonus: { clock: 0, steady: 0 }, caseId: 'c1', fails: 0, easy: false, replay: false };\nconst idleReset = () => { G.idle = 0; };\nconst stageDraw = (id, r, W, H, t) => r.overlay(g => G.stage(id, g, W, H, t));\n// ---------------- title\nSC.title = { enter(d) { G.music('title'); this.t = 0; this.game.weather = null; G.UI.popups = []; }, update(dt) { const g = G.game; this.t += dt; if (g.input.pressed('confirm') || g.input.pressed('start') || g.input.clicked()) { g.input.consumeAll(); G.Audio.sfx('select'); g.go('menu'); } },\n  draw(r) { const W = r.W, H = r.H, t = this.t; stageDraw('harbor', r, W, H, t); r.overlay(g => { const cx = W / 2; E.font.title(g, G.GAME_TITLE.toUpperCase(), cx, 28, { scale: Math.max(2, Math.min(4, Math.floor(W / 160))), colors: ['#ffffff', '#5ff0e0'], align: 'center', depth: 2, depthColor: '#06303a' });\n    const y = 86, n = 140; let prev = null; for (let i = 0; i < n; i++) { const hb = ((i / 36) + t * .8) % 1, k = Math.min(1, (t * 40) / n); if (i / n > k + .02) break; const yy = y - U.ecgY(hb) * 12; if (prev) px.line(g, cx - 70 + i - 1, prev, cx - 70 + i, yy, '#6affb0', 1); prev = yy; }\n    if (Math.floor(t * 2) % 2 === 0) U.center(g, 'PRESS ' + (G.game.input.label('confirm') || 'START'), cx, H - 40, '#ffffff', { scale: 2 });\n    U.text(g, 'v' + G.VERSION, 6, H - 12, '#5a7a80'); }); }, };\n// ---------------- main menu\nSC.menu = { enter() { const g = G.game; G.music('title'); this.t = 0; this.build(); }, build() { const g = G.game, p = G.prog; const has = p.next > 0 || g.saves && g.saves.latest && g.saves.latest();\n    this.items = [{ label: 'CONTINUE', disabled: !has }, 'NEW GAME', 'CASE FILES', 'GRAND ROUNDS', 'SETTINGS', 'ABOUT']; this.menu = new E.Menu(g, this.items, { x: 'center', y: Math.max(80, (g.H >> 1) - 20), scale: 2, rows: 6, onPick: (i, it) => this.pick(i), onCancel: () => g.go('title') }); if (!has) this.menu.index = 1; },\n  pick(i) { const g = G.game; G.Audio.sfx('select'); g.input.consumeAll(); if (i === 0) { G.continueGame(); } else if (i === 1) { g.go('difficulty', { fresh: true }); } else if (i === 2) g.go('casefiles'); else if (i === 3) g.go('lobby'); else if (i === 4) g.menu('settings'); else if (i === 5) g.go('about'); },\n  update(dt) { this.t += dt; this.menu.update(dt); }, draw(r) { stageDraw('harbor', r, r.W, r.H, this.t); r.overlay(g => { px.blend(g, .55, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#000')); U.center(g, G.GAME_TITLE.toUpperCase(), r.W / 2, 22, '#5ff0e0', { scale: 3 }); }); this.menu.draw(r); } };\nG.continueGame = () => { const g = G.game, p = G.prog; G.run.caseId = G.CASE_ORDER[Math.min(p.next, 10)]; if (g.saves && g.saves.latest && g.saves.latest()) { try { g.saves.load('auto'); } catch (e) {} } g.go('ward', { arrive: true }); };\n// ---------------- difficulty\nSC.difficulty = { enter(d) { this.d = d || {}; this.i = 1; this.t = 0; }, names: ['Intern', 'Resident', 'Attending'], quote: ['\"Drains softer, clock longer, hints on. You are among friends.\"', '\"The baseline. I will say nothing and observe.\"', '\"No Code Blue. A star for the flawless. I am told this is fun.\"'],\n  update(dt) { const g = G.game, I = g.input; this.t += dt; if (I.pressed('left')) { this.i = (this.i + 2) % 3; G.Audio.sfx('select'); } if (I.pressed('right')) { this.i = (this.i + 1) % 3; G.Audio.sfx('select'); }\n    const ptr = I.pointer(); if (ptr && I.lastDevice === 'mouse') { const W = g.W, cw = 130, gap = 12, x0 = (W - (cw * 3 + gap * 2)) / 2; for (let k = 0; k < 3; k++) { const x = x0 + k * (cw + gap); if (ptr[0] > x && ptr[0] < x + cw && ptr[1] > 50 && ptr[1] < 170) this.i = k; } }\n    const c = I.clicked(); if (I.pressed('confirm') || c) { I.consumeAll(); G.prog.diff = this.names[this.i]; G.Audio.sfx('confirm'); if (this.d.fresh) { G.prog = { diff: G.prog.diff, next: 0, ranks: G.prog.ranks || {}, star: G.prog.star || {}, flags: {}, ending: false, seen: {} }; g.go('story', { id: 'intro', next: () => g.go('story', { id: 'c1pre', next: () => G.startCase('c1') }) }); } else g.back && g.go('menu'); } if (I.pressed('cancel')) g.go('menu'); },\n  draw(r) { stageDraw('corridor', r, r.W, r.H, this.t); r.overlay(g => { px.blend(g, .5, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#000')); U.center(g, 'CHOOSE YOUR SHIFT', r.W / 2, 24, '#ffffff', { scale: 2 }); const cw = 130, gap = 12, x0 = Math.floor((r.W - (cw * 3 + gap * 2)) / 2); for (let k = 0; k < 3; k++) { const x = x0 + k * (cw + gap), sel = k === this.i; U.panel(g, x, sel ? 46 : 54, cw, sel ? 128 : 112, { line: sel ? '#5ff0e0' : '#2a5a60', bg: sel ? '#0b3a40ee' : '#06161aee' }); U.center(g, this.names[k].toUpperCase(), x + cw / 2, 62, sel ? '#ffd35a' : '#aacccc', { scale: 2 }); const lines = U.wrap(this.quote[k], cw - 14); lines.forEach((l, j) => U.text(g, l, x + 8, 92 + j * 9, '#e8fbf6')); }\n      U.capText(g, G.game, 'confirm', 'Choose', r.W / 2 - 40, r.H - 24); }); } };\n// ---------------- story\nconst SPEED = { Slow: 24, Normal: 40, Fast: 80, Instant: 400 };\nSC.story = { enter(d) { this.d = d; const sc = G.STORY[d.id]; this.sc = sc; this.i = -1; this.t = 0; this.chars = 0; this.log = []; this.showLog = false; this.card = sc.card ? 2.2 : 0; this.cine = sc.cine ? 4.5 : 0; this.cineT = 0; this.sp = {}; G.music(sc.ending ? 'piano' : sc.bg === 'ward3' ? 'ward' : 'tension'); this.game.weather = { kind: 'rain', amount: .5 }; this.adv(); }, adv() { this.i++; this.chars = 0; this.acc = 0; if (this.i >= this.sc.lines.length) { this.done = true; const n = this.d.next; this.d.next = null; G.game.input.consumeAll(); if (n) n(); else G.game.go('menu'); return; } const L = this.sc.lines[this.i]; this.log.push(L); if (L[0]) this.sp[L[0]] = { side: Object.keys(this.sp).length % 2 ? 1 : -1, t: 0 }; if (L[2]) G.Audio.speak(G.WHO(L[0]) || 'narr', L[2].slice(0, 6), {}); },\n  update(dt) { if (this.done) return; const g = G.game, I = g.input; this.t += dt; if (this.card > 0) { this.card -= dt; if (I.pressed('confirm')) this.card = 0; return; } if (this.cine > 0) { this.cine -= dt; this.cineT += dt; if (I.pressed('confirm') || I.pressed('cancel') || I.clicked()) { this.cine = 0; I.consumeAll(); } return; }\n    if (I.pressed('log')) this.showLog = !this.showLog; if (this.showLog) { if (I.pressed('cancel') || I.pressed('confirm')) this.showLog = false; return; }\n    const L = this.sc.lines[this.i]; if (!L) return; const speed = SPEED[g.settings.textSpeed || 'Normal'] || 40, skip = I.down('skip'); const before = Math.floor(this.chars); this.chars += dt * (skip ? 400 : speed); const now = Math.floor(this.chars); for (let k = before; k < now && k < L[2].length; k++) if (L[0]) G.Audio.dialogVoice(L[2][k], k, { speaker: G.WHO(L[0]) });\n    const full = this.chars >= L[2].length; const adv = I.pressed('confirm') || I.clicked() || (skip && full); if (adv) { I.consumeAll(); if (!full) this.chars = L[2].length; else this.adv(); } if (I.pressed('cancel') && I.down('skip')) { /* skip scene */ } },\n  draw(r) { const W = r.W, H = r.H; stageDraw(this.sc.bg, r, W, H, this.t); const g_ = this; r.overlay(g => {\n      if (this.cine > 0) { G.cine(this.sc.cine, g, W, H, this.cineT); U.text(g, '', 0, 0); U.capText(g, G.game, 'confirm', 'Skip', W - 56, H - 16); return; }\n      if (this.card > 0) { px.rect(g, 0, 0, W, H, '#000c'); U.center(g, this.sc.card, W / 2, H / 2 - 10, '#ffd35a', { scale: 2 }); return; }\n      const L = this.sc.lines[this.i]; if (!L) return;\n      for (const id in this.sp) { if (!G.hasCast(id)) continue; const s = this.sp[id], speaking = id === L[0]; s.t = Math.min(1, s.t + .06); const bx = s.side < 0 ? 20 : W - 132, by = H - 128 - 52, bob = speaking ? Math.round(Math.sin(this.t * 14) * 1) : 0; const cv = G.bust(id, speaking ? L[1] : 'neutral', { talk: speaking && Math.floor(this.chars / 2) % 2 === 0 && this.chars < L[2].length, blink: Math.floor(this.t * 2.2) % 9 === 0 }); if (!speaking) px.blend(g, .55, 'normal', () => g.drawImage(cv, bx, by + 6)); else g.drawImage(cv, Math.round(bx), by + bob); }\n      U.panel(g, 12, H - 56, W - 24, 48, { line: '#5ff0e0' }); if (L[0]) { const nm = G.WHO(L[0]); px.rect(g, 18, H - 66, font.width(nm) + 12, 12, '#0b3a40'); U.text(g, nm, 24, H - 63, '#5ff0e0'); }\n      const txt = L[2].slice(0, Math.floor(this.chars)); U.wrap(txt, W - 52).slice(0, 3).forEach((ln, j) => U.text(g, ln, 22, H - 48 + j * 10, L[0] ? '#e8fbf6' : '#aacccc'));\n      if (this.chars >= L[2].length && Math.floor(this.t * 3) % 2) px.poly(g, [[W - 26, H - 20], [W - 18, H - 20], [W - 22, H - 14]], '#5ff0e0');\n      U.capText(g, G.game, 'log', 'Log', W - 100, 6); U.capText(g, G.game, 'skip', 'Fast', W - 56, 6);\n      if (this.showLog) { px.rect(g, 0, 0, W, H, '#000d'); const last = this.log.slice(-9); last.forEach((l, j) => U.text(g, (G.WHO(l[0]) ? G.WHO(l[0]) + ': ' : '') + l[2].slice(0, 70), 12, 14 + j * 14, '#e8fbf6')); }\n    }); } };\nG.cine = (id, g, W, H, t) => { G.stage({ gurney: 'corridor', gala: 'gala', storm: 'harbor', final: 'er' }[id] || 'corridor', g, W, H, t); const k = t / 4.5; if (id === 'gurney') { const x = -60 + k * (W + 120); px.rect(g, x, H * .62, 50, 6, '#d8e4e8'); px.disc(g, x + 6, H * .62 - 5, 6, '#c88a6a'); px.rect(g, x + 14, H * .62 - 8, 28, 10, '#7a9ac8'); px.disc(g, x + 8, H * .62 + 10, 4, '#222'); px.disc(g, x + 42, H * .62 + 10, 4, '#222'); const rx = x - 14; px.rect(g, rx, H * .62 - 22, 8, 26, '#2f9c8e'); px.disc(g, rx + 4, H * .62 - 26, 5, '#f6d0b2'); px.rect(g, rx + 1, H * .62 - 31, 7, 3, '#c9562a'); U.center(g, 'GURNEY!', W / 2, 40, '#ff6a5a', { scale: 2 }); } else if (id === 'gala') { const cx = W / 2; px.line(g, cx + 20 + k * 40, H * .5 + k * 24, cx + 36 + k * 60, H * .5 + 30 + k * 6, '#caa860', 2); px.rect(g, cx - 4, H * .5 + (k > .4 ? 22 : 0), 10, k > .4 ? 12 : 34, '#ece7da'); px.disc(g, cx + 1, H * .5 - 5 + (k > .4 ? 28 : 0), 6, '#7c4a2e'); } else if (id === 'storm') { const sway = Math.sin(t * 1.6) * .12; px.poly(g, [[W * .2, H * .72 + Math.sin(t * 1.6) * 6], [W * .8, H * .72 - Math.sin(t * 1.6) * 6], [W * .72, H * .8], [W * .28, H * .8]], '#3a3a44'); px.rect(g, W * .44, H * .5, 40, 22, '#caa860'); px.rect(g, W * .5, H * .38, 4, 24, '#8a8a70'); U.center(g, 'FORCE NINE', W / 2, 30, '#ffffff', { scale: 2 }); } else { U.center(g, 'EVERYONE IS HERE', W / 2, 36, '#5ff0e0', { scale: 2 }); px.rect(g, W / 2 - 40, H * .6, 80, 6, '#d8e4e8'); for (let i = 0; i < 6; i++) { const a = i / 6 * 6.28 + t * .3; px.disc(g, W / 2 + Math.cos(a) * 50, H * .6 + Math.sin(a) * 18 - 14, 6, ['#2f9c8e', '#3d62a6', '#ece7da', '#6b7a48', '#e6e8f2', '#c4803c'][i]); } } };\n// ---------------- chart (+ lightbox)\nG.startCase = (id, o = {}) => { const g = G.game; G.run = { bonus: { clock: 0, steady: 0 }, caseId: id, fails: 0, easy: false, replay: !!o.replay, skills: !!o.skills }; g.go('chart', { id }); };\nSC.chart = { enter(d) { this.id = d.id; this.def = G.CASES[d.id]; this.t = 0; this.read = false; G.music('tension'); this.lb = this.def.lightbox && !G.run.lbDone; this.sub = 'clip'; G.Audio.speak('Nurse Quill', 'Patient, ' + this.def.patient, {}); this.lbState = { tries: 0, found: false, msg: '', cur: [213, 120] }; },\n  update(dt) { const g = G.game, I = g.input; this.t += dt; if (this.sub === 'clip') { if (I.pressed('confirm') || I.clicked()) { I.consumeAll(); if (this.lb) this.sub = 'lightbox'; else g.go('op', { id: this.id }); } if (I.pressed('cancel')) g.go(G.run.replay ? 'casefiles' : 'ward', {}); return; }\n    // lightbox: point and press\n    const L = this.lbState, d = this.def.lightbox, sp = 150 * dt, kb = I.padAim || I.padMove || [0, 0]; L.cur[0] = E.clamp(L.cur[0] + kb[0] * sp * 2 + ((I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0)) * sp, 10, 416); L.cur[1] = E.clamp(L.cur[1] + kb[1] * sp * 2 + ((I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0)) * sp, 10, 230); const ptr = I.pointer(); if (ptr && I.lastDevice === 'mouse') { L.cur[0] = ptr[0] - ((g.W - 426) >> 1); L.cur[1] = ptr[1] - ((g.H - 240) >> 1); }\n    if ((I.pressed('useTool') || I.pressed('confirm') || I.clicked()) && !L.found) { I.consumeAll(); const hit = Math.hypot(L.cur[0] - d.truth[0], L.cur[1] - d.truth[1]) < 14 + 10; L.tries++; if (hit) { L.found = true; L.msg = 'Second opinion confirmed. +20 s, +20 Steady.'; G.run.bonus.clock += 20; G.run.bonus.steady += 20; G.run.marker = d.truth; G.Audio.sfx('chime'); } else { L.msg = L.tries >= 3 ? 'Out of tries. Quill points it out.' : 'Wrong. -10 s. Percy smirks.'; G.run.bonus.clock -= 10; G.Audio.sfx('thud'); if (L.tries >= 3) { L.found = true; L.cur = d.truth.slice(); G.run.bonus.clock += 10; } } L.t = 0; }\n    else if (L.found && (I.pressed('confirm') || I.clicked())) { I.consumeAll(); G.run.lbDone = true; g.go('op', { id: this.id }); } L.t = (L.t || 0) + dt; },\n  draw(r) { const W = r.W, H = r.H; stageDraw(this.sub === 'clip' ? 'office' : 'radiology', r, W, H, this.t); r.overlay(g => { const OX = (W - 426) >> 1, OY = (H - 240) >> 1; px.blend(g, .4, 'normal', () => px.rect(g, 0, 0, W, H, '#000'));\n      if (this.sub === 'clip') { const cw = 220, x = (W - cw) / 2, y = 20; px.rect(g, x - 4, y - 4, cw + 8, 190, '#6a4a2a'); px.rect(g, x, y, cw, 182, '#f4efe0'); px.rect(g, x + cw / 2 - 20, y - 8, 40, 10, '#9aaab8'); U.text(g, 'CHART', x + 10, y + 8, '#a02020', { scale: 2 }); U.text(g, 'Case ' + this.def.n + ': ' + this.def.name, x + 10, y + 28, '#202030'); U.text(g, 'Patient: ' + this.def.patient, x + 10, y + 40, '#202030'); U.wrap(G.CHART[this.id] || '', cw - 20).forEach((l, i) => U.text(g, l, x + 10, y + 58 + i * 10, '#303040', { shadow: null })); if (this.def.lightbox) { px.rect(g, x + 10, y + 120, 130, 34, '#fff3a0'); U.wrap('First opinion: ' + this.def.lightbox.opinion, 120).forEach((l, i) => U.text(g, l, x + 14, y + 124 + i * 9, '#403000', { shadow: null })); } U.capText(g, G.game, 'confirm', this.lb ? 'To the lightbox' : 'Scrub in', x + 10, y + 166, '#202030'); return; }\n      const d = this.def.lightbox, L = this.lbState; px.rect(g, OX + 40, OY + 20, 346, 196, '#d8f0ff'); px.rect(g, OX + 44, OY + 24, 338, 188, '#0a1420'); G.film(g, OX + 44, OY + 24, 338, 188, d.film, d.truth, this.t, L.found); const tx = OX + d.truth[0], ty = OY + d.truth[1];\n      if (L.found) { Dr_ring(g, tx, ty, 18, '#ffd35a'); } const cx = OX + L.cur[0], cy = OY + L.cur[1]; px.line(g, cx - 8, cy, cx + 8, cy, '#ffffff', 1); px.line(g, cx, cy - 8, cx, cy + 8, '#ffffff', 1); Dr_ring(g, cx, cy, 14, '#5ff0e0');\n      const od = G.bust('odalys', L.found ? 'smile' : 'shock'); g.drawImage(od, 0, 0, 112, 128, 4, H - 100, 84, 96); U.text(g, 'Mark what is really wrong. ' + (3 - L.tries) + ' tries.', OX + 50, OY + 4, '#ffffff'); U.text(g, L.msg || '', OX + 50, OY + 218, L.found ? '#6affb0' : '#ff9a8a'); px.rect(g, OX + 330, OY + 190, 52, 22, '#fff3a0'); U.text(g, d.opinion.slice(0, 10), OX + 333, OY + 194, '#403000', { shadow: null }); U.capText(g, G.game, 'useTool', L.found ? 'Continue' : 'Mark here', OX + 50, OY + 232 - 6 + (H > 240 ? 0 : 0)); }); } };\nconst Dr_ring = (g, x, y, r, c) => G.Draw.ring(g, x, y, r, c, 24);\nG.film = (g, x, y, w, h, kind, truth, t, show) => { const hash = i => { const s = Math.sin(i * 12.9898) * 43758.5453; return s - Math.floor(s); }; const bone = '#a8b8c4';\n  for (let i = 0; i < 300; i++) px.dot(g, x + hash(i) * w, y + hash(i, 2) * h, '#1a2a38'); px.blend(g, .3, 'normal', () => { px.disc(g, x + w / 2, y + h / 2, 70, '#3a5a74'); px.disc(g, x + w / 2 - 50, y + h / 2 + 10, 40, '#3a5a74'); });\n  if (kind === 'skull') { px.ell(g, x + w / 2, y + h / 2 - 6, 80, 76, bone); px.ell(g, x + w / 2, y + h / 2 - 6, 72, 68, '#18242e'); px.ell(g, x + w / 2 - 28, y + h / 2 - 10, 12, 10, '#0a1018'); px.ell(g, x + w / 2 + 28, y + h / 2 - 10, 12, 10, '#0a1018'); } else { px.rect(g, x + w / 2 - 4, y + 4, 8, h - 8, bone); for (let i = 0; i < 7; i++) { const yy = y + 20 + i * 24; px.line(g, x + w / 2 - 6, yy, x + w / 2 - 90 + i * 4, yy + 30, bone, 2); px.line(g, x + w / 2 + 6, yy, x + w / 2 + 90 - i * 4, yy + 30, bone, 2); } }\n  const hum = .6 + .4 * Math.sin(t * 6); px.blend(g, .5 * hum, 'add', () => px.disc(g, x + truth[0] - 44 + 44 * 0, y + truth[1] - 24 + 0, 5, '#5ff0e0')); if (show) px.blend(g, .5, 'add', () => px.disc(g, x + truth[0] - 44, y + truth[1] - 24, 10, '#5ff0e0')); };\n// ---------------- op\nSC.op = { pausable: true, camera: { zoom: false, wheel: false }, view: 'overhead',\n  enter(d) { const g = G.game; this.id = d.id || G.run.caseId; let def = G.CASES[this.id]; this.def = def; this.cheat = !!d.cheat; const diff = G.run.easy ? 'Intern' : G.prog.diff; const seed = d.seed || (def.n * 7919 + (G.run.fails * 13) + 5); const S = Op.create(def, { seed, difficulty: diff, players: d.players || 1 }); S.clock += G.run.bonus.clock; S.clock0 = S.clock; S.steady = Math.min(100, S.steady + G.run.bonus.steady); if (G.run.skills) { S.cheatLock = true; S.cheatFreezeClock = true; } this.S = S; this.view = new G.OpView(g, S, { bots: d.bots, cheat: this.cheat, seat: 0 }); this.view.objective = def.phases[0].obj; this.view.say(def.phases[0].bark || 'Hands, Doctor.', false); this.ended = 0; g.weather = null; g.cam && (g.cam.offset = [0, 0]); G.music(def.finale ? 'final' : def.phases.some(p => p.spawn && p.spawn.some(s => ['tremolo', 'fermata', 'dacapo', 'cantor'].includes(s.t))) ? 'boss' : 'op'); G.dev.tagged = false; this.mouseHidden = true; G.Audio.sfx('select'); this.scrub = 1.4; if (def.ship) g.weather = { kind: 'rain', amount: .8 }; },\n  exit() { G.Audio.silence(); G.game.audio.duck && G.game.audio.duck(false); G.game.weather = null; },\n  update(dt) { const g = G.game, S = this.S, v = this.view; g.focus(g.W / 2, g.H / 2, 0); if (this.scrub > 0) { this.scrub -= dt; return; } if (g.paused) return;\n    if (S.over || this.ended) { this.ended += dt; if (this.ended > .6 && !this.went) { this.went = true; if (S.over === 'won') { g.go('results', { S, id: this.id, def: this.def }); } else g.go('lost', { S, id: this.id, def: this.def, why: S.why }); } return; }\n    if (G.dev.open) G.devUpdate(dt, this); v.step(dt); if (G.dev.slow) {} if (G.dev.autoSurgeon && !v.ctl[0].bot) { v.ctl[0].kind = 'bot'; v.ctl[0].bot = new G.Bot({ cheat: false }); } if (!G.dev.autoSurgeon && v.ctl[0].kind === 'bot' && !this.cheat) { v.ctl[0].kind = 'human'; v.ctl[0].bot = null; }\n    if (g.input.pressed('pause')) {} },\n  draw(r) { if (this.scrub > 0) { const k = this.scrub / 1.4; r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#0b1c22'); U.center(g, 'SCRUB IN', r.W / 2, r.H / 2 - 16, '#5ff0e0', { scale: 3 }); U.center(g, 'Case ' + this.def.n + ': ' + this.def.name, r.W / 2, r.H / 2 + 14, '#ffffff'); }); return; } this.view.draw(r); r.overlay(g => { if (G.dev.open) G.devDraw(g, r.W, r.H, this); if (this.S.hush && this.S.static) {} }); } };\n// ---------------- lost\nSC.lost = { enter(d) { this.d = d; this.t = 0; G.run.fails++; G.Audio.silence(); G.game.audio.music(null); G.game.audio.sting(G.STINGS.lost); this.line = d.S.why === 'time' ? 'Time of death, oh-four-twelve.' : d.S.why === 'device' ? 'The device went off.' : G.BARKS.lost[Math.floor(Math.random() * G.BARKS.lost.length)]; const g = G.game; const items = ['RETRY FROM THIS PHASE', 'RESTART CASE']; if (G.run.fails >= 2 && !G.run.easy) items.push('LOWER DIFFICULTY FOR THIS CASE'); items.push('QUIT TO MENU'); this.items = items; this.menu = new E.Menu(g, items, { x: 'center', y: Math.max(110, g.H - 100), scale: 1, rows: 4, onPick: i => this.pick(i), onCancel: () => {} }); },\n  pick(i) { const g = G.game, it = this.items[i], d = this.d; G.Audio.sfx('select'); if (it.startsWith('RETRY')) { G.run.retry = true; g.go('op', { id: d.id, retry: d.S }); } else if (it.startsWith('RESTART')) { g.go('op', { id: d.id }); } else if (it.startsWith('LOWER')) { G.run.easy = true; g.go('op', { id: d.id }); } else g.go('menu'); },\n  update(dt) { this.t += dt; this.menu.update(dt); },\n  draw(r) { r.overlay(g => { px.rect(g, 0, 0, r.W, r.H, '#05080c'); const y = 60; for (let i = 0; i < r.W; i++) px.dot(g, i, y + (i > r.W - 60 - this.t * 20 ? Math.sin(i * .6) * 8 : 0), '#ff6a5a'); U.center(g, 'FLATLINE', r.W / 2, 90, '#ff6a5a', { scale: 3 }); U.center(g, this.line, r.W / 2, 124, '#e8fbf6'); }); this.menu.draw(r); } };\nconst origOp = SC.op.enter; SC.op.enter = function (d) { origOp.call(this, d); if (d.retry) { const S = this.S, ch = d.retry.chk; if (ch) { const keep = { buf: [], ev: [] }; Op.restore(S, ch); S.chk = ch; Op.retry(S); S.over = null; this.view.ecg = []; this.view.objective = this.def.phases[S.ph].obj; } } };\n// ---------------- results\nSC.results = { enter(d) { this.d = d; const S = d.S, def = d.def; this.rank = G.rankOf(S, def); this.star = S.diff === 'Attending' && this.rank === 'S' && S.stats.slips === 0; this.dev = G.dev.tagged; this.t = 0; this.tile = 0; const st = S.stats; this.tiles = [['TIME LEFT', G.fmtTime(S.clock)], ['PULSE HELD', Math.round(S.vitals) + ''], ['TECHNIQUE', Math.round(100 * st.clean / Math.max(1, st.n)) + '%'], ['BEST FLOW', 'x' + Math.min(2, 1 + st.bestChain * .05).toFixed(1)]]; G.music('ward'); G.game.audio.sting(G.STINGS.closed);\n    if (!this.dev && !G.run.skills) { const p = G.prog; (p.ranks[d.id] ||= {}); const order = 'DCBAS'; const cur = p.ranks[d.id][S.diff]; if (!cur || order.indexOf(this.rank) > order.indexOf(cur)) p.ranks[d.id][S.diff] = this.rank; if (this.star) (p.star[d.id] ||= {})[S.diff] = true; const idx = G.CASE_ORDER.indexOf(d.id); if (!G.run.replay) p.next = Math.max(p.next, idx + 1); G.saveProg(); } },\n  update(dt) { const g = G.game, I = g.input; this.t += dt; this.tile = Math.min(4, Math.floor(this.t / .9)); if (this.t > 4.2 && !this.sfxRank) { this.sfxRank = true; G.Audio.sfx('stamp'); g.shake(4); } if ((I.pressed('confirm') || I.clicked()) && this.t > 1) { I.consumeAll(); if (this.t < 4.6) { this.t = 4.7; this.sfxRank = true; return; } this.leave(); } },\n  leave() { const g = G.game, id = this.d.id; if (G.run.skills) return g.go('casefiles'); if (G.run.replay) return g.go('casefiles'); const st = G.CASE_STORY[id]; const idx = G.CASE_ORDER.indexOf(id); const after = () => { if (id === 'c11') { G.prog.ending = true; G.saveProg(); g.go('credits'); } else g.go('ward', { arrive: true }); }; g.go('story', { id: st[1], next: after }); },\n  draw(r) { stageDraw('scrub', r, r.W, r.H, this.t); r.overlay(g => { const W = r.W, H = r.H; px.rect(g, 0, 0, W, H, '#000b'); U.center(g, 'CASE CLOSED', W / 2, 18, '#ff6a5a', { scale: 3 }); if (this.dev) U.center(g, 'DEV', W / 2 + 90, 22, '#ffd35a'); U.center(g, 'Case ' + this.d.def.n + ': ' + this.d.def.name, W / 2, 46, '#e8fbf6');\n      for (let i = 0; i < 4; i++) { const x = W / 2 - 170 + i * 87, y = 72; if (i < this.tile) { U.panel(g, x, y, 80, 46); U.center(g, this.tiles[i][0], x + 40, y + 8, '#8fb8b0'); U.center(g, this.tiles[i][1], x + 40, y + 22, '#ffffff', { scale: 2 }); U.text(g, '✓', x + 68, y + 4, '#6affb0'); } else px.rect(g, x, y, 80, 46, '#ffffff10'); }\n      if (this.t > 4.2) { const k = Math.min(1, (this.t - 4.2) * 3); U.center(g, this.rank, W / 2, 128 - (1 - k) * 20, ({ S: '#ffd35a', A: '#6affb0', B: '#7ae0ff', C: '#e8fbf6', D: '#ff9a8a' })[this.rank], { scale: 8 }); if (this.star) U.center(g, '★ TEXTBOOK', W / 2, 190, '#ffd35a', { scale: 2 }); U.center(g, G.RANK_LINES[this.rank], W / 2, 206, '#e8fbf6'); U.capText(g, G.game, 'confirm', 'Continue', W / 2 - 36, H - 20); } }); } };\n})();\nEOF\nnode -e \"const fs=require('fs');new Function(fs.readFileSync('src/scenes/core.js','utf8'));console.log('ok')\""}}}
