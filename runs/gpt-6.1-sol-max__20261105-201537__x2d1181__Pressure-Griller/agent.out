{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > gpu-minimal.mjs <<'JS'\nimport {build} from 'esbuild';\nimport {writeFile} from 'node:fs/promises';\nconst source=\"'`import * as T from '\"'three/webgpu';\nconst q=new URLSearchParams(location.search);const r=new T.WebGPURenderer({antialias:true});r.setSize(900,600);document.body.append(r.domElement);window.r=r;\nawait r.init();const s=new T.Scene();s.background=new T.Color('#f1e7d4');const c=new T.PerspectiveCamera(45,1.5,.1,100);c.position.set(4,5,8);c.lookAt(0,0,0);\nconst d=new T.DirectionalLight(0xffffff,3);d.position.set(3,6,4);s.add(d);s.add(new T.HemisphereLight(0xffffff,0x555555,2));\nif(q.has('shadow')){r.shadowMap.enabled=true;r.shadowMap.type=T.PCFSoftShadowMap;d.castShadow=true;}\nconst gradient = new T.DataTexture(new Uint8Array([100,165,218,255]),4,1,T.RedFormat);gradient.minFilter=gradient.magFilter=T.NearestFilter;gradient.needsUpdate=true;\nconst box=new T.Mesh(new T.BoxGeometry(2,2,2),new T.MeshToonMaterial({color:'#d95534',gradientMap:q.has('gradient')?gradient:null}));box.castShadow=true;box.receiveShadow=true;s.add(box);\nconst floor=new T.Mesh(new T.BoxGeometry(10,.1,10),new T.MeshToonMaterial({color:'#e8d6b9'}));floor.position.y=-1.5;floor.receiveShadow=true;s.add(floor);\nif(q.has('outline')){const outline=new T.Mesh(box.geometry,new T.MeshBasicMaterial({color:'#263733',side:T.BackSide}));outline.scale.setScalar(1.03);box.add(outline);}\nfunction frame(){r.render(s,c);window.gpuState={lost:r._isDeviceLost,calls:r.info.render.drawCalls};requestAnimationFrame(frame)}frame();\"'`;\nconst result=await build({stdin:{contents:source,resolveDir:process.cwd()},bundle:true,format:'\"'esm',write:false,minify:true});\nawait writeFile('gpu-minimal.html','<\"'!doctype html><title>GPU isolated</title><script type=\"module\">'\"'+result.outputFiles[0].text+'</script>');\nJS\nnode gpu-minimal.mjs\ncat > minimal_check.py <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n for flags in ['', '?gradient&outline', '?gradient&outline&shadow']:\n  q=b.new_page();q.on('console',lambda m:print(m.type,m.text[:500],flush=True));q.on('pageerror',lambda e:print('error',e,flush=True))\n  q.goto((Path.cwd()/'gpu-minimal.html').as_uri()+flags);q.wait_for_function('window.gpuState',timeout=30000);q.wait_for_timeout(1000)\n  print(flags,q.evaluate('gpuState'),flush=True);q.close()\n b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python minimal_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
