(s)\nPY\ncat > tests/artifact.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nexport function runArtifact(){\n const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..'),project=JSON.parse(fs.readFileSync(path.join(root,'project.json'),'utf8'));\n const html=fs.readFileSync(path.join(root,'..',project.basename+'.html'),'utf8'),client=fs.readFileSync(path.join(root,'vendor/hub/session.js'),'utf8');let checks=0;const failures=[];const ok=(v,m)=>{checks++;if(\"'!v)failures.push(m);};\n ok(html.startsWith('\"'<\"'!doctype html>'\"'),'single-file HTML doctype');ok(html.includes('<meta charset=\\\"utf-8\\\"><script>'+client+'</script>'),'released Hub client first script verbatim after charset');ok(html.includes('name=\\\"hub:session\\\" content=\\\"1\\\"'),'Hub protocol declaration');ok(html.includes('name=\\\"hub:session-players\\\" content=\\\"2-2\\\"'),'exactly two Hub seats');ok(html.includes('name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"'),'Hub shared-world declaration');ok(html.includes('name=\\\"hub:session-minutes\\\" content=\\\"3\\\"'),'three-minute Hub declaration');ok(\"'!/<(?:script|img|audio|link|video|source)[''^>]+(?:src|href)'\"\\\\s*=/i.test(html),'no external runtime dependencies');ok(\"'!html.includes('\"'/home/micha/'),'no absolute workstation runtime paths');ok((html.match(/<script>/g)||[]).length===3,'exactly client, engine, and game inline scripts');ok((html.match(/<\\\\/script>/g)||[]).length===3,'safe embedded script delimiters');ok(html===fs.readFileSync(path.join(root,'index.html'),'utf8'),'development and published artifact identical');\n const metadata=JSON.parse(fs.readFileSync(path.join(root,'..','exit-interview.json'),'utf8'));const src=JSON.parse(fs.readFileSync(path.join(root,'metadata.json'),'utf8'));ok(JSON.stringify(metadata)===JSON.stringify(src),'metadata sole source matches published interview');ok(Object.keys(metadata).join(',')==='sourceInformation,testingFeedback,engineFeedback,promptFeedback,aiHub','interview top-level shape and order');\n const keys=['date','source','plan','genre','perspective','tech','artDirection','animation','audio','online','testing','research','environment','model','usage'];ok(Object.keys(metadata.sourceInformation).join(',')===keys.join(','),'all source information fields in order');for(const key of keys)ok(typeof metadata.sourceInformation[key]==='string'&&metadata.sourceInformation[key].length>0,'source field '+key+' filled');\n ok(metadata.sourceInformation.usage==='added on import','usage exact value');ok(metadata.sourceInformation.plan==='PLAN.md','plan attribution');ok(metadata.sourceInformation.date==='2026-11-06 03:30:00','brief date exact');ok(metadata.sourceInformation.environment==='Codex CLI (headless); Linux','brief environment exact');ok(metadata.sourceInformation.model==='OpenAI, gpt-6.1-sol, reasoning effort ultra','brief model exact');\n for(const [key,n]of[['testingFeedback',4],['engineFeedback',6],['promptFeedback',4]])ok(Array.isArray(metadata[key])&&metadata[key].length===n&&metadata[key].every(v=>typeof v==='string'&&v.length>0),key+' complete answers');\n const cat=['name','tagline','description','type','genre','source','series','players','controls','tags'];ok(Object.keys(metadata.aiHub).join(',')===cat.join(','),'catalogue exact object keys/order');ok(metadata.aiHub.name===project.title,'catalogue/title agreement');ok(metadata.aiHub.players==='1–2','catalogue player count');ok(metadata.aiHub.source===metadata.sourceInformation.source,'catalogue source agreement');ok(Array.isArray(metadata.aiHub.tags)&&metadata.aiHub.tags.length>=3&&metadata.aiHub.tags.length<=6&&metadata.aiHub.tags.every(x=>x===x.toLowerCase()),'catalogue tag schema');\n for(const file of fs.readdirSync(path.join(root,'src')))if(file.endsWith('.js')){const txt=fs.readFileSync(path.join(root,'src',file),'utf8');ok(\"'!/'\"\\\\bTODO\\\\b|\\\\bFIXME\\\\b/.test(txt),file+' no unfinished feature markers');}\n return {checks,failures,evidence:{bytes:Buffer.byteLength(html),artifact:project.basename+'.html'}};\n}\nEOF\ncat > tests/verify.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nimport {runSimulation} from './simulation.mjs';\nimport {runHubUnit} from './hub-unit.mjs';\nimport {runArtifact} from './artifact.mjs';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');process.chdir(root);\nconst results=[];\nfor(const [name,run]of[['simulation',runSimulation],['Hub authority',runHubUnit],['artifact',runArtifact]]){\n try{const r=await run();results.push({name,...r});fs.writeFileSync(path.join(root,'artifacts',name.replaceAll(' ','-')+'.json'),JSON.stringify(r,null,2)+'\\\\n');}catch(e){results.push({name,checks:1,failures:[e.stack]});}\n}\nconst python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfor(const [name,script,args]of[['UI and devices','tests/ui-input.py',[]],['Hub browser','tests/hub-browser.py',[path.join(root,'..',JSON.parse(fs.readFileSync('project.json')).basename+'.html')]],['Browser and audio','tests/browser.py',[]]]){\n if(\"'!fs.existsSync(script)){results.push({name,checks:1,failures:['\"'Missing required runner '+script]});continue;}\n const r=spawnSync(python,[script,...args],{cwd:root,encoding:'utf8',timeout:300000,maxBuffer:1048576});const output=(r.stdout||'')+'\\\\n'+(r.stderr||'');const match=[...output.matchAll(/(\\\\d+) checks, (\\\\d+) failures/g)].at(-1);const failures=[];if(r.status\"'!==0||!match||Number(match[2])>0)failures.push(output.trim()||String(r.error||'\"'Browser runner failed'));results.push({name,checks:match?Number(match[1]):1,failures});\n}\nconst count=results.reduce((n,r)=>n+r.checks,0),failures=results.flatMap(r=>r.failures.map(message=>({suite:r.name,message})));for(const f of failures)console.error(\"'`FAIL [${f.suite}] ${f.message}`);console.log(`${c