{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat artifacts/simulation.json | tail -n 24 && sed -n '180,240p' src/ui.js && sed -n '300,380p' src/ui.js && sed -n '250,325p' src/view.js\"","aggregated_output":"          \"collapses\": 10,\n          \"crew\": 17,\n          \"launcher\": 16,\n          \"recoveries\": 15,\n          \"damage\": 66.4,\n          \"cancels\": 0\n        }\n      }\n    ],\n    \"issues\": [],\n    \"coverage\": {\n      \"stones\": [\n        0,\n        1,\n        2\n      ],\n      \"crew\": 129,\n      \"launcher\": 175,\n      \"collapse\": 61,\n      \"teaching\": true,\n      \"loss\": true\n    }\n  }\n}    return [action('Previous page', () => { controlPage = 0; refresh(); }) , action('Next page', () => { controlPage = (controlPage + 1) % 3; refresh(); }), action('Replay the lesson', () => { app.playLesson(); }), action('Rebind controls', () => { settingPage = 2; open('settings'); }), action('Back', back)];\n  }\n  function aboutText() {\n    const m = app.metadata || {};\n    if (aboutPage === 0) {\n      const si = m.sourceInformation || {};\n      return Object.entries(si).map(([k, v]) => `${k.replace(/([A-Z])/g, ' $1').replace(/^./, c => c.toUpperCase())}: ${v}`).join('\\n\\n') || 'Source information is being loaded.';\n    }\n    const keys = ['testingFeedback', 'engineFeedback', 'promptFeedback'];\n    const questions = [\n      ['Issues caught', 'Critical / game-breaking', 'Most helpful test', 'Least helpful test'],\n      ['Best part of the engine', 'Wrong guesses', 'Most important custom system', 'Hardest engine integration', 'Engine changes', 'Desired engine improvement'],\n      ['Best part of the prompt', 'Confusing part', 'Hardest task', 'Suggested change'],\n    ];\n    const answers = m[keys[aboutPage - 1]] || [];\n    return questions[aboutPage - 1].map((q, i) => `${q}\\n${answers[i] || 'unknown'}`).join('\\n\\n');\n  }\n  function pauseItems() {\n    const list = [action('Return to the tournament', () => app.resume()), action('Settings', () => { settingPage = 0; open('settings'); }), action('Controls', () => { controlPage = 0; open('controls'); }), action('Developer tools', () => { devPage = 0; open('developer'); })];\n    if (app.mode !== 'hub') list.push(action('Restart this bout', () => open('restart-bout')), action('Return to title', () => open('leave-match')));\n    return list;\n  }\n  function developerItems() {\n    const w = current();\n    if (app.mode === 'hub') return [action('Back to match', () => app.resume()), action('Back', back)];\n    const names = ['Scenario', 'Simulation', 'Launch tuning', 'Damage & recovery', 'AI & assist'];\n    const list = [action(`Page: ${names[devPage]}  →`, () => { devPage = (devPage + 1) % names.length; app.focus = 0; refresh(); })];\n    if (!w) return list.concat(action('Back', back));\n    if (devPage === 0) {\n      list.push(action('Restart current bout', () => restart()));\n      app.devCourt ??= w.court; app.devBout ??= w.bout;\n      list.push(choice('Court for restart', app, 'devCourt', [0, 1, 2, 3, 4], v => COURT_NAMES[v]));\n      list.push(slider('Bout for restart', app, 'devBout', 1, 10, 1));\n      list.push(action('Apply court & bout', () => restart({ court: app.devCourt, bout: app.devBout })));\n      list.push(action('Restore both castles', () => { cheat(); Sim.resetCastles(w); status = 'Castles restored.'; refresh(); }));\n      list.push(action('Clear airborne stones', () => { cheat(); w.projectiles.length = 0; status = 'Projectiles cleared.'; refresh(); }));\n      list.push(action('Skip teaching', () => { app.skipTeaching?.(); app.lesson = null; app.teaching = false; app.lessonStage = 99; status = 'Teaching skipped.'; refresh(); }));\n      list.push(action('Inspect left victory', () => force(0)));\n      list.push(action('Inspect right victory', () => force(1)));\n      list.push(action('Inspect draw ceremony', () => force(-1)));\n      list.push(action('Court authoring', () => { editor = structuredClone(w.blocks); selected = 0; authorPage = 0; open('author'); }));\n    } else if (devPage === 1) {\n      list.push(toggle('Simulation paused', app.dev, 'paused', cheat));\n      list.push(action('Advance one fixed tick', () => { cheat(); app.dev.paused = true; app.dev.step = true; status = `Step requested at tick ${w.tick}.`; refresh(); }));\n      list.push(slider('Simulation speed', app.dev, 'speed', .1, 4, .1, '×', cheat));\n      list.push(toggle('Invulnerable castles', app.dev, 'invulnerable', value => { cheat(); w.config.invulnerable = value; }));\n      list.push(toggle('Show collision shapes', app.dev, 'collision'));\n      list.push(toggle('Show support links', app.dev, 'support'));\n      list.push(toggle('Show predicted arc', app.dev, 'prediction'));\n      list.push(action(`Left seat: ${w.players[0].ai ? 'AI' : 'Human'}`, () => { cheat(); w.players[0].ai = w.players[0].ai ? null : { reaction: .8, error: .015, kind: 'adaptive' }; refresh(); }));\n      list.push(action(`Right seat: ${w.players[1].ai ? 'AI' : 'Human'}`, () => { cheat(); w.players[1].ai = w.players[1].ai ? null : { reaction: .8, error: .015, kind: 'adaptive' }; refresh(); }));\n    } else for (const [key, label, min, max, step, unit] of TUNING[devPage - 2]) {\n      list.push(slider(label, w.config, key, min, max, step, unit, (value, old) => {\n        cheat();\n        if (key === 'healthScale' && old > 0) for (const block of w.blocks) { const frac = block.maxHp > 0 ? block.hp / block.maxHp : 0; block.maxHp *= value / old; block.hp = block.maxHp * frac; }\n      }));\n    }\n    list.push(action('Reset tuning to defaults', () => { cheat(); app.resetTuning(); status = 'Defaults restored. Timing applies to the next action; health preserves its fraction.'; refresh(); }));\n    list.push(action('Back', back)); return list;\n  }\n  function authorBlock() { return editor?.[clamp(selected, 0, (editor?.length || 1) - 1)] || null; }\n          const parsed = JSON.parse(app.authorJSON || ''); if (parsed.version !== 1 || !Array.isArray(parsed.blocks)) throw new Error('Expected version 1 and a blocks array.');\n          const old = editor; editor = parsed.blocks; const check = authorResult(); if (!check.valid) { editor = old; throw new Error(check.errors.join('\\n')); }\n          selected = 0; status = `Imported ${editor.length} validated blocks.`; refresh();\n        } catch (error) { status = error.message; refresh(); }\n      }));\n    }\n    list.push(action('Apply validated court', commitEditor)); list.push(action('Back', back)); return list;\n  }\n  function resultItems() {\n    const multi = app.mode === 'solo' || (app.mode === 'local' && (app._options?.war || app.war));\n    const list = [action(multi ? (current()?.bout >= 10 ? 'Crown the champion' : 'Next bout') : 'Rematch', () => app.advance())];\n    if (!multi) list.push(action('Change court', () => { app.setupMode = app.mode === 'local' ? 'local' : 'quick'; open('setup'); }));\n    list.push(action('About / Credits', () => { aboutPage = 0; open('about'); }), action('Return to title', home));\n    return list;\n  }\n\n  function build() {\n    const s = app.screen, w = current(); let title = '', kicker = '', text = '', menu = [], footer = '';\n    if (s === 'title') {\n      title = TITLE; kicker = 'The Royal Demolition League';\n      text = 'Hold to wind. Release to ruin.\\nA little precision. A great deal of rubble.';\n      menu = titleItems(); footer = 'Online versus is available when hosted in AI Hub. · 1–2 players';\n    } else if (s === 'setup') {\n      title = app.setupMode === 'local' ? 'Bring a worthy rival' : 'Choose your court'; kicker = 'Exhibition match';\n      text = app.setupMode === 'local' ? `Both castles fire together. Keyboard seats use ${keyName(app.settings.fire1)} and ${keyName(app.settings.fire2)}. Mouse belongs to the left keyboard seat.` : 'Practice any court with all three stones. There are no turns to wait for.';\n      menu = setupItems();\n    } else if (s === 'settings') {\n      title = 'Make yourself comfortable'; kicker = ['Sound', 'Play & display', 'Bindings'][settingPage];\n      text = settingPage === 0 ? 'Separate music, stonework, and sporting nonsense.' : settingPage === 1 ? 'Tension changes timing, never the maximum distance. Timing assist slows the charge.' : 'Select an action, then press a key. Conflicting bindings are rejected.';\n      menu = settingsItems();\n    } else if (s === 'controls') {\n      title = ['Hold. Watch. Release.', 'Choose your indignity', 'Know the tournament'][controlPage]; kicker = 'How to play';\n      if (controlPage === 0) text = app.device === 'pad' ? `${app.settings.glyphs === 'Xbox' ? 'A' : 'Cross'}: hold to wind, release to throw.\\n${app.settings.glyphs === 'Xbox' ? 'LB / RB' : 'L1 / R1'}: change stone. ${app.settings.glyphs === 'Xbox' ? 'B' : 'Circle'}: cancel. Options: menu.\\nLook for the landing diamond; full tension overshoots. A new press is needed after any interruption.` : app.device === 'touch' ? 'Hold anywhere in your friendly half to wind. Release to throw.\\nThe small stone chips change your stone. The menu button pauses.\\nThe landing diamond shows what your current tension will strike.' : `${keyName(app.settings.fire1)} or left mouse: hold to wind, release to throw.\\nQ / E or wheel: change stone. C or right mouse: cancel. Escape: pause.\\nLeft / right arrows move your target reference. Right seat: ${keyName(app.settings.fire2)}, U / O.\\nFull tension overshoots. Watch the landing diamond.`;\n      else if (controlPage === 1) text = 'Roundstone · precise, quick to reload.\\nMasonry · crush a support or reinforced wall.\\nSplit · three fragments spread near the apex.\\n\\nCastle hits remove real blocks. Unsupported sections fall. Crew hits buy an opening; launcher hits buy a longer one. Gold shields mean returning targets are protected.';\n      else text = 'Castle: 3 points. Crew: 7. Launcher: 13.\\nA structural cascade wins ground, without extra hit points.\\nThe winner banks direct-hit score × bout number. The loser banks zero.\\nA tour has ten bouts and advances after a defeat.\\nAt 90 seconds, remaining castle health %, then direct hits decide. A tie is a draw. Hub rounds last at most three minutes.';\n      menu = controlsItems();\n    } else if (s === 'about') {\n      kicker = 'Made for a most improper sport'; title = ['Source Information', 'Testing Feedback', 'Engine Feedback', 'Prompt Feedback'][aboutPage];\n      text = aboutText(); menu = [action('Next credits page', () => { aboutPage = (aboutPage + 1) % 4; refresh(); }), action('Back', back)];\n    } else if (s === 'pause') {\n      kicker = app.mode === 'hub' ? 'The match continues online' : 'The trumpets can wait'; title = 'A brief royal recess';\n      text = app.disconnectMessage || (app.mode === 'hub' ? 'Your castle remains in play. Close this menu to return.' : 'The battlefield is paused. Any held charge was safely cancelled.'); menu = pauseItems();\n    } else if (s === 'developer') {\n      kicker = app.mode === 'hub' ? 'Read-only match diagnostics' : 'Royal workshop · marks the run as assisted'; title = 'Developer tools';\n      const p = w?.players || [];\n      text = `Seed ${w?.seed ?? '—'} · tick ${w?.tick ?? 0} · ${w?.time?.toFixed(2) || '0'} s\\nCourt ${1 + (w?.court || 0)} · bout ${w?.bout || 1} · ${w?.blocks?.filter(b => b.alive && !b.foundation).length || 0} objective blocks · ${w?.projectiles?.length || 0} airborne\\nScores ${p[0]?.score || 0} : ${p[1]?.score || 0}`;\n      if (app.mode === 'hub') text += `\\n${JSON.stringify(app.online?.diagnostics?.() || {})}`;\n      else text += '\\nTiming affects the next action. Health scaling preserves damage fractions.';\n      menu = developerItems();\n    } else if (s === 'author') {\n      kicker = 'Court authoring · version 1'; title = 'Carve the next court';\n      const b = authorBlock(); text = b ? `Block #${b.id} · ${b.material} · owner ${b.seat + 1}\\n(${b.x}, ${b.z}) · ${b.w} × ${b.h} · ${b.foundation ? 'foundation' : 'objective'}\\nSupports: ${b.supports?.join(', ') || 'none'}\\nUse the focused controls with pad or keys; click a visible block to select it.` : 'Add a foundation to begin.';\n      menu = authorItems();\n    } else if (s === 'result') {\n      const o = w?.outcome; const winner = o?.winner ?? -1; title = winner < 0 ? 'Honours even!' : `${winner === 0 ? 'Rose' : 'Azure'} takes the bout!`; kicker = `Bout ${w?.bout || 1} · ${COURT_NAMES[w?.court || 0]}`;\n      const scores = o?.scores || pScores(w), banked = o?.banked || [0, 0];\n      text = `${o?.reason === 'time' ? 'Time! Remaining castle health, then direct-hit score decide.' : winner < 0 ? 'The court declares a draw. No points are banked.' : 'Lower the losing flag. Sound the thoroughly excessive trumpets.'}\\n\\nDirect-hit score: Rose ${scores[0]} · Azure ${scores[1]}\\n${winner < 0 ? 'Draw: 0 banked for each side.' : `${winner === 0 ? 'Rose' : 'Azure'} banks ${scores[winner]} × ${w?.bout || 1} = ${banked[winner]} · loser banks 0.`}${app.tour ? `\\nTournament total: ${app.tour.totals[0]} : ${app.tour.totals[1]}` : ''}`;\n      menu = resultItems();\n    } else if (s === 'championship') {\n      const totals = app.tour?.totals || [0, 0]; title = totals[0] === totals[1] ? 'A shared, rather awkward crown!' : `${totals[0] > totals[1] ? 'Rose' : 'Azure'} wears the crumbly crown!`; kicker = 'The ten-bout war is complete';\n      text = `Final weighted total\\nRose ${totals[0]}  ·  Azure ${totals[1]}\\n\\nFive courts. Ten bouts. An appalling bill for masonry.${app.tour?.cheated || app.cheated ? '\\nThis run used developer assistance.' : ''}`;\n      menu = [action('Another royal tour', () => app.start('solo', { teaching: false })), action('Quick Duel', () => { app.setupMode = 'quick'; open('setup'); }), action('Credits', () => { aboutPage = 0; open('about'); }), action('Title', home)];\n    } else if (s === 'restart-tour') { title = 'A fresh campaign?'; kicker = 'Your previous tour will be replaced'; text = details; menu = [action('Keep the saved tour', back), action('Restart the ten-bout tour', () => app.start('solo', { teaching: true, restart: true }))]; }\n    else if (s === 'restart-bout') { title = 'Replay this bout?'; text = 'The current battle will start again. This marks the run as assisted.'; menu = [action('Keep playing', () => app.resume()), action('Restart the bout', () => restart())]; }\n    else if (s === 'leave-match') { title = 'Leave the court?'; text = app.mode === 'solo' ? 'Your completed bouts are saved. This unfinished bout will begin again on Resume.' : 'The current battle will be left behind.'; menu = [action('Return to the battle', () => app.resume()), action('Return to title', home)]; }\n    return { title, kicker, text, menu, footer };\n  }\n  function pScores(w) { return w?.players?.map(p => p.score) || [0, 0]; }\n  function textValue(item) {\n    const v = item.value;\n    return item.format ? item.format(v) : typeof v === 'boolean' ? (v ? 'On' : 'Off') : String(v ?? '');\n  }\n  function refresh() {\n    if (app.screen === 'play' || app.mode === 'attract' || (app.online?.ended || app.hubEnded)) {\n      if (shell.screen) shell.hide(); app.menu = []; if (root) root.hidden = !!(app.online?.ended || app.hubEnded); return;\n    }\n    if (root) root.hidden = false;\n    const spec = build(); app.menu = spec.menu;\n    app.focus = clamp(Number.isInteger(app.focus) ? app.focus : 0, 0, Math.max(0, spec.menu.length - 1));\n    if (!root) return;\n    shell._stack.length = 0;\n  function aiming(r,app) {\n    const w=app.world;if(!w)return;const S=r.ppu;\n    r.overlay(g=>{\n      for(let seat=0;seat<2;seat++){\n        const p=w.players[seat],T=TEAMS[seat],last=p.last?.[p.stone];if(last){const [x,y]=r.w(last.x,0,last.z);px.line(g,x-4,y-4,x+4,y+4,T.color);px.line(g,x+4,y-4,x-4,y+4,T.color);E.font.text(g,'LAST',x,y+7,T.bright,{align:'center',font:'tiny',outline:false,shadow:'#242632'});}\n      }\n      if(cachedPrediction){const seat=app.online?.seat??0,T=TEAMS[seat],points=cachedPrediction.points||[];if(app.settings.prediction||app.showPrediction||app.dev?.prediction){for(let i=0;i<points.length;i+=5){const p=points[i],[x,y]=r.w(p[0],0,p[1]);px.disc(g,x,y,1,T.bright);}}\n        for(const hit of cachedPrediction.impacts||[]){const [x,y]=r.w(hit.x,0,hit.z);const radius=6+Math.sin(clock*7);px.line(g,x-radius,y,x-3,y,T.bright);px.line(g,x+3,y,x+radius,y,T.bright);px.line(g,x,y-radius,x,y-3,T.bright);px.line(g,x,y+3,x,y+radius,T.bright);px.dot(g,x,y,'#fff2ce');}\n      }\n      const q=app.pointerWorld;if(q&&app.screen==='play'&&app.mode!=='attract'){const [x,y]=r.w(q.x,0,q.z);px.line(g,x-5,y,x+5,y,'#e6daba');px.line(g,x,y-5,x,y+5,'#e6daba');const b=w.blocks.find(b=>b.alive&&q.x>=b.x&&q.x<=b.x+b.w&&q.z>=b.z&&q.z<=b.z+b.h);if(b){const [bx,by]=r.w(b.x,0,b.z+b.h),bw=b.w*S,bh=b.h*S;px.line(g,bx,by,bx+bw,by,'#fff0aa',2);px.line(g,bx,by,bx,by+bh,'#fff0aa',2);px.line(g,bx+bw,by,bx+bw,by+bh,'#fff0aa',2);px.line(g,bx,by+bh,bx+bw,by+bh,'#fff0aa',2);E.font.text(g,b.material.toUpperCase(),x,y-15,'#fff1bf',{align:'center',outline:false,shadow:'#242632',font:'tiny'});}}\n    });\n  }\n  function hud(r,app) {\n    if(!['play','pause','developer','author'].includes(app.screen)&&app.mode!=='attract')return;\n    const w=app.world;if(!w)return;const W=r.W,H=r.H,touch=app.device==='touch',phone=H>W*1.2;\n    r.overlay(g=>{\n      const boxW=Math.min(201,(W-116)/2),margin=14,y=14;\n      for(let seat=0;seat<2;seat++){\n        const p=w.players[seat],T=TEAMS[seat],x=seat?W-margin-boxW:margin;\n        E.ui.box(g,x,y,boxW,42,{bg:['#1f273b','#151c2c'],border:T.dark,alpha:.9});px.rect(g,x,y,4,42,T.color);\n        E.font.text(g,(seat?'II  ':'I  ')+(app.mode==='hub'?(app.online?.names?.[seat]||('PLAYER '+(seat+1))):seat?(p.ai?'THE CHALLENGER':'PLAYER TWO'):'YOUR COURT'),x+10,y+6,T.bright,{outline:false,font:'tiny'});\n        const frac=health(w,seat);E.ui.bar(g,x+10,y+18,boxW-49,6,frac,T.color);E.font.text(g,Math.round(frac*100)+'%',x+boxW-8,y+18,'#f3e5cc',{align:'right',font:'tiny',outline:false});\n        E.font.text(g,'HITS '+p.score+(app.mode==='solo'||app.war?'   BANK '+(app.tour?.totals?.[seat]||0):''),x+10,y+30,'#b9c6ca',{outline:false,font:'tiny'});\n      }\n      const remaining=Math.max(0,Math.ceil(w.limit-w.time)),timeText=Math.floor(remaining/60)+':'+String(remaining%60).padStart(2,'0');\n      E.font.text(g,timeText,W/2,y+3,remaining<=15?'#ffad88':'#f6e3bd',{align:'center',scale:2,outline:false,shadow:'#222333'});E.font.text(g,app.mode==='solo'||app.war?'BOUT '+w.bout+'/10':app.mode==='hub'?'HUB DUEL':'DUEL',W/2,y+25,'#c7c5b8',{align:'center',font:'tiny',outline:false});\n      // Both human tensions remain independent; a single meter per seat reads from one command state.\n      const meterY=H-(phone?118:48),meterW=Math.min(228,(W-68)/2);\n      for(let seat=0;seat<2;seat++){\n        const p=w.players[seat],T=TEAMS[seat],x=seat?W-18-meterW:18,q=p.charge?.power||0;\n        E.ui.box(g,x,meterY,meterW,31,{bg:'#1b2332',border:q>.98?'#ffd16f':T.dark,alpha:.9});px.rect(g,x+5,meterY+18,meterW-10,7,'#3c3e48');\n        if(q>0)px.rect(g,x+6,meterY+19,(meterW-12)*q,5,q>.98?'#f7b574':T.color);\n        for(const tick of [.25,.5,.75])px.rect(g,x+6+(meterW-12)*tick,meterY+18,1,7,'#6f6d69');\n        const text=p.charge?Math.round(q*100)+'% TENSION':p.reloadUntil>w.time?'RELOADING':Math.max(p.crewUntil,p.launcherUntil)>w.time?'INTERRUPTED':p.buffer?'BUFFERED':'HOLD TO WIND';\n        E.font.text(g,STONE_NAMES[p.stone],x+7,meterY+5,T.bright,{outline:false,font:'tiny'});E.font.text(g,text,x+meterW-7,meterY+5,q>.98?'#ffd49b':'#cdd2cc',{align:'right',outline:false,font:'tiny'});\n      }\n      if(app.mode==='attract'){E.ui.box(g,W/2-122,H-88,244,26,{bg:'#172033',border:'#c8a66d',alpha:.9});E.font.text(g,'THE ROYAL EXHIBITION',W/2,H-81,'#ffe0a1',{align:'center',outline:false});E.font.text(g,'ANY INPUT RETURNS TO COURT',W/2,H-70,'#c4d6d5',{align:'center',outline:false,font:'tiny'});}\n      else if(!touch){const pad=app.device==='pad',xb=app.settings.glyphs==='Xbox',fire=pad?(xb?'A':'Cross'):(app.settings.fire1||'Space').replace('Key','').replace('ShiftRight','RShift'),switcher=pad?'L1 / R1':'Q / E';const msg=`HOLD ${fire} · RELEASE TO THROW    ${switcher} STONE    ${pad?'Options':'Esc'} MENU`;E.font.text(g,msg,W/2,H-12,'#c8cec9',{align:'center',font:'tiny',outline:false,shadow:'#222432'});}\n      else if(phone){E.font.text(g,'HOLD YOUR HALF · RELEASE TO THROW',W/2,H-66,'#e6d6ba',{align:'center',outline:false});E.font.text(g,'Tap a stone chip to change your throw',W/2,H-49,'#b7c6ca',{align:'center',outline:false,font:'tiny'});}\n      if(app.caption){const text=String(app.caption);E.font.text(g,text,W/2,phone?85:69,'#ffe1ac',{align:'center',outline:false,shadow:'#272636',wrap:W-44});}\n      if(app.cheated||app.tour?.cheated)E.font.text(g,'PRACTICE · DEV TUNING',W/2,phone?110:84,'#d8b6c9',{align:'center',font:'tiny',outline:false});\n      if(phone){E.font.text(g,COURT_LOOKS[w.court]?.name||'',W/2,H*.5-180,'#d7d7c4',{align:'center',outline:false});}\n      if(touch&&app.screen==='play'){\n        for(const chip of touchLayouts){const T=TEAMS[chip.seat];E.ui.box(g,chip.x,chip.y,chip.w,chip.h,{bg:'#1d293a',border:T.color,alpha:.9});E.font.text(g,chip.delta<0?'←':'→',chip.x+chip.w/2,chip.y+9,T.bright,{align:'center',scale:2,outline:false});}\n        if(touchLayouts.length){const seats=[...new Set(touchLayouts.map(c=>c.seat))];for(const seat of seats){const center=app.mode==='local'?(seat?W*.77:W*.23):W*.5;E.font.text(g,STONE_NAMES[w.players[seat].stone],center,touchLayouts.find(c=>c.seat===seat).y+11,TEAMS[seat].bright,{align:'center',outline:false,font:'tiny'});}}\n        if(app.touchPoint){const canvas=game.screen.canvas,rect=canvas?.getBoundingClientRect();if(rect){const s=game.screen,x=((app.touchPoint.x-rect.left)*canvas.width/rect.width-s.OX)/s.S,y=((app.touchPoint.y-rect.top)*canvas.height/