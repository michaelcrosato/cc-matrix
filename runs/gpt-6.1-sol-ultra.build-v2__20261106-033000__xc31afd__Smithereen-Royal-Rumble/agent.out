{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"sed -n '240,310p' src/ui.js && sed -n '130,168p' src/input.js && node -e \\\"let r=require('./artifacts/simulation.json');console.log(r.evidence.tour.map(x=>({bout:x.bout,time:x.time,reason:x.outcome.reason})));console.log('total seconds',r.evidence.tour.reduce((n,x)=>n+x.time,0))\\\"\"","aggregated_output":"  function authorBlock() { return editor?.[clamp(selected, 0, (editor?.length || 1) - 1)] || null; }\n  function authorResult() {\n    if (!editor?.length) return { valid: false, errors: ['No blocks.'] };\n    try {\n      const result = Sim.validateCourt({ version: 1, name: 'Authored court', blocks: editor });\n      if (result && typeof result === 'object' && !Array.isArray(result)) return { valid: result.valid ?? result.ok ?? !result.errors?.length, errors: result.errors || [] };\n      return { valid: result === true || result?.length === 0, errors: Array.isArray(result) ? result : result ? [] : ['Court validation failed.'] };\n    } catch (error) { return { valid: false, errors: [error.message] }; }\n  }\n  function commitEditor() {\n    const check = authorResult();\n    if (!check.valid) { status = check.errors.join('\\n'); refresh(); return; }\n    cheat();\n    const w = current(); w.blocks = structuredClone(editor); w.revision++; w.projectiles.length = 0;\n    w.maxHealth = [0, 1].map(seat => w.blocks.filter(b => b.seat === seat && !b.foundation).reduce((sum, b) => sum + b.maxHp, 0));\n    status = 'Validated court applied. Preview it by returning to play.'; refresh();\n  }\n  function authorItems() {\n    editor ||= structuredClone(current()?.blocks || []);\n    if (!editor.length) editor.push({ id: 0, seat: 0, x: 50, z: 40, w: 20, h: 18, hp: 1, maxHp: 1, material: 'stone', foundation: true, supports: [], alive: true });\n    selected = clamp(selected, 0, editor.length - 1);\n    const b = authorBlock();\n    const list = [action(`Page: ${['Blocks', 'Position & size', 'Support graph', 'Import / export'][authorPage]}  →`, () => { authorPage = (authorPage + 1) % 4; app.focus = 0; refresh(); })];\n    if (authorPage === 0) {\n      list.push(action(`Selected: #${b.id} · ${b.seat === 0 ? 'Rose' : 'Azure'}`, () => { selected = (selected + 1) % editor.length; refresh(); }));\n      list.push(action('Previous block', () => { selected = (selected + editor.length - 1) % editor.length; refresh(); }));\n      list.push(choice('Material', b, 'material', MATERIALS, v => v, value => { const hp = ({ wood: 1, stone: 2, reinforced: 4 })[value]; b.hp = b.maxHp = hp; }));\n      list.push(toggle('Foundation / excluded objective', b, 'foundation'));\n      list.push(choice('Owner', b, 'seat', [0, 1], v => v === 0 ? 'Rose / left' : 'Azure / right'));\n      list.push(action('Add adjacent block', () => { const copy = structuredClone(b); copy.id = Math.max(...editor.map(x => x.id)) + 1; copy.x = clamp(copy.x + copy.w, 0, 620); copy.foundation = b.foundation && copy.z <= 40; copy.supports = copy.foundation ? [] : [b.id]; copy.alive = true; copy.hp = copy.maxHp; editor.push(copy); selected = editor.length - 1; status = `Added block #${copy.id}.`; refresh(); }));\n      list.push(action('Remove selected block', () => { const id = b.id; editor.splice(selected, 1); for (const block of editor) block.supports = block.supports.filter(s => s !== id); selected = Math.max(0, selected - 1); status = `Removed block #${id}.`; refresh(); }));\n    } else if (authorPage === 1) {\n      for (const [key, label, min, max, step] of [['x', 'East position', 0, 620, 1], ['z', 'Height / up', 40, 240, 1], ['w', 'Width', 4, 80, 1], ['h', 'Height', 4, 80, 1]]) list.push(slider(label, b, key, min, max, step, 'u'));\n      list.push(action('Mirror selected block', () => { const copy = structuredClone(b); copy.id = Math.max(...editor.map(x => x.id)) + 1; copy.x = 640 - b.x - b.w; copy.seat = 1 - b.seat; copy.supports = []; copy.foundation = copy.z <= 40; editor.push(copy); selected = editor.length - 1; refresh(); }));\n    } else if (authorPage === 2) {\n      app.authorSupport ??= 0;\n      const candidates = editor.filter(x => x.id !== b.id && x.seat === b.seat).map(x => x.id);\n      if (!candidates.includes(app.authorSupport)) app.authorSupport = candidates[0] ?? b.id;\n      list.push(choice('Support block', app, 'authorSupport', candidates.length ? candidates : [b.id], v => `#${v}`));\n      list.push(action('Add support link', () => { if (app.authorSupport !== b.id && !b.supports.includes(app.authorSupport)) b.supports.push(app.authorSupport); status = `#${b.id} supports: ${b.supports.join(', ') || 'none'}`; refresh(); }));\n      list.push(action('Remove selected support link', () => { b.supports = b.supports.filter(id => id !== app.authorSupport); status = `#${b.id} supports: ${b.supports.join(', ') || 'none'}`; refresh(); }));\n      list.push(action('Validate connectivity & reachability', () => { const check = authorResult(); status = check.valid ? 'Valid: connected foundations, legal shapes, reachable objective footprint.' : check.errors.join('\\n'); refresh(); }));\n      list.push(action('Preview selected support collapse', () => {\n        cheat(); current().blocks = structuredClone(editor); const target = current().blocks.find(x => x.id === b.id); target.hp = 0; target.alive = false;\n        const connected = new Set(current().blocks.filter(x => x.foundation && x.alive).map(x => x.id)); let changed = true;\n        while (changed) { changed = false; for (const block of current().blocks) if (block.alive && !connected.has(block.id) && block.supports.some(id => connected.has(id))) { connected.add(block.id); changed = true; } }\n        let removed = 0; for (const block of current().blocks) if (block.alive && !block.foundation && !connected.has(block.id)) { block.alive = false; block.hp = 0; removed++; }\n        current().revision++; status = `Removing #${b.id} disconnects ${removed} objective block${removed === 1 ? '' : 's'}.`; refresh();\n      }));\n    } else {\n      list.push(action('Export court as JSON', () => {\n        const text = JSON.stringify({ version: 1, name: 'Authored court', blocks: editor }, null, 2); app.authorJSON = text; status = 'JSON shown below. Select it to copy, or use Download.'; refresh();\n      }));\n      list.push(action('Download JSON', () => {\n        if (typeof document === 'undefined') return;\n        const url = URL.createObjectURL(new Blob([JSON.stringify({ version: 1, name: 'Authored court', blocks: editor }, null, 2)], { type: 'application/json' }));\n        const a = document.createElement('a'); a.href = url; a.download = 'royal-rumble-court.json'; a.click(); setTimeout(() => URL.revokeObjectURL(url), 0);\n      }));\n      list.push(action('Import pasted JSON', () => {\n        try {\n          const parsed = JSON.parse(app.authorJSON || ''); if (parsed.version !== 1 || !Array.isArray(parsed.blocks)) throw new Error('Expected version 1 and a blocks array.');\n          const old = editor; editor = parsed.blocks; const check = authorResult(); if (!check.valid) { editor = old; throw new Error(check.errors.join('\\n')); }\n          selected = 0; status = `Imported ${editor.length} validated blocks.`; refresh();\n        } catch (error) { status = error.message; refresh(); }\n      }));\n    }\n    list.push(action('Apply validated court', commitEditor)); list.push(action('Back', back)); return list;\n  }\n  function resultItems() {\n    const multi = app.mode === 'solo' || (app.mode === 'local' && (app._options?.war || app.war));\n    const list = [action(multi ? (current()?.bout >= 10 ? 'Crown the champion' : 'Next bout') : 'Rematch', () => app.advance())];\n      else if (target === 1 ? point.x < 320 && e.clientY < innerHeight * .75 : point.x > 320 && e.clientY < innerHeight * .75) return;\n      // Context stone chips are drawn at the lower left / right of the battlefield.\n      const chip = touchChip(e.clientX, e.clientY);\n      if (chip) { stone(chip.seat, chip.delta); return; }\n      if (app.mode === 'local' && !keySeat(seat)) return;\n    } else if (!keySeat(0)) return;\n    const source = 'pointer:' + e.pointerId;\n    pointers.set(e.pointerId, { seat, source });\n    try { canvas.setPointerCapture(e.pointerId); } catch {}\n    begin(seat, source);\n    app.touchPoint = device === 'touch' ? { x: e.clientX, y: e.clientY, seat } : null;\n  }\n  function touchChip(x, y) {\n    const chips = app.touchChips || [];\n    return chips.find(chip => x >= chip.x && x <= chip.x + chip.w && y >= chip.y && y <= chip.y + chip.h) || null;\n  }\n  function pointerup(e) {\n    const info = pointers.get(e.pointerId); pointers.delete(e.pointerId);\n    if (info) release(info.seat, info.source);\n    try { canvas?.releasePointerCapture(e.pointerId); } catch {}\n    if (!pointers.size) app.touchPoint = null;\n  }\n  function pointercancel(e) {\n    const info = pointers.get(e.pointerId); pointers.delete(e.pointerId);\n    if (info) cancel(info.seat);\n    app.touchPoint = null;\n  }\n  function pointermove(e) {\n    if (ended()) return;\n    if (!lastPointer || Math.hypot(e.clientX - lastPointer.x, e.clientY - lastPointer.y) >= 3) {\n      if (absorbAttract(e.pointerType === 'touch' ? 'touch' : 'mouse', e)) { lastPointer = { x: e.clientX, y: e.clientY }; return; }\n      feedback(e.pointerType === 'touch' ? 'touch' : 'mouse'); lastPointer = { x: e.clientX, y: e.clientY };\n    }\n    if (e.target === canvas) app.pointerWorld = worldPoint(e);\n  }\n  function wheel(e) {\n    if (ended()) return;\n    if (absorbAttract('mouse', e)) return;\n    feedback('mouse');\n[\n  { bout: 1, time: 90, reason: 'time' },\n  { bout: 2, time: 90, reason: 'time' },\n  { bout: 3, time: 41.391666666666666, reason: 'demolition' },\n  { bout: 4, time: 56.25833333333333, reason: 'demolition' },\n  { bout: 5, time: 54.24166666666667, reason: 'demolition' },\n  { bout: 6, time: 61.608333333333334, reason: 'demolition' },\n  