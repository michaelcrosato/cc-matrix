{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' src/ui.js && sed -n '1,130p' src/input.js\"","aggregated_output":"import * as Sim from './sim.js';\n\nconst TITLE = 'Smithereen Royal Rumble';\nconst COURT_NAMES = ['Village exhibition', 'Quarry meet', 'High keep', 'Lakeside night court', 'Royal final'];\nconst MATERIALS = ['wood', 'stone', 'reinforced'];\nconst TUNING = [\n  [\n    ['chargeTime', 'Time to full tension', .4, 3, .05, 's'],\n    ['maxSpeed', 'Maximum launch speed', 180, 420, 5, 'u/s'],\n    ['gravity', 'Gravity', 60, 220, 5, 'u/s²'],\n    ['reload', 'Roundstone reload', .2, 3, .05, 's'],\n    ['heavyReload', 'Masonry reload', .3, 4, .05, 's'],\n    ['splitReload', 'Split reload', .3, 5, .05, 's'],\n  ],\n  [\n    ['damage', 'Masonry damage scale', .25, 4, .05, '×'],\n    ['healthScale', 'Block health scale', .25, 4, .05, '×'],\n    ['crewDisable', 'Crew retreat', .2, 6, .1, 's'],\n    ['launcherDisable', 'Launcher repair', .2, 8, .1, 's'],\n    ['protection', 'Return protection', .2, 4, .05, 's'],\n  ],\n  [\n    ['aiError', 'AI range error', 0, .15, .005, 'power'],\n    ['aiReaction', 'AI reaction delay', .1, 4, .1, 's'],\n    ['assist', 'Timing assistance', 0, 1, .05, ''],\n  ],\n];\nconst clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));\nconst rounded = (v, step) => Math.round(v / step) * step;\nconst keyName = code => ({ Space: 'Space', ShiftRight: 'Right Shift', ShiftLeft: 'Left Shift', Enter: 'Enter' }[code] || code?.replace(/^Key/, '').replace(/^Digit/, '') || 'unknown');\n\nexport function createUI(E, game, app) {\n  const shell = new E.Shell(game, {\n    tv: true, standard: false, screens: { pause: false },\n    theme: { accent: '#f4cf78', paper: 'rgba(11,27,38,.96)', ink: '#fff4d8', muted: '#b7c9c7', line: 'rgba(244,207,120,.32)', titleFont: 'Georgia, serif', font: 'system-ui, sans-serif', scale: () => clamp((globalThis.innerWidth || 1280) * .016, 17, 29) / 14 * (app.settings.uiScale || 1) },\n  });\n  // The game has independent simultaneous seats. Its adapter supplies focus and confirm once.\n  shell._step = () => {};\n  app.dev ||= { speed: 1, paused: false, step: false, collision: false, support: false, prediction: false, invulnerable: false };\n  let lastScreen = '', lastVersion = '', history = [], details = '', aboutPage = 0, settingPage = 0, devPage = 0, authorPage = 0;\n  let editor = null, selected = 0, status = '', controlPage = 0, lastDrawMenu = null;\n  const root = shell.root;\n  const style = typeof document !== 'undefined' ? document.createElement('style') : null;\n  if (style) {\n    style.textContent = `.rumble-ui .esh-sh{background:linear-gradient(120deg,#031722e8,#061a29ce);backdrop-filter:blur(2px)}\n.rumble-ui .esh-ttl{background:linear-gradient(90deg,#041924f5,#061a28c9 47%,#061a2800 88%);backdrop-filter:none}\n.rumble-ui .esh-ttl h1{font-size:clamp(40px,6vw,66px);letter-spacing:-.045em;max-width:510px;text-shadow:0 4px #07121a}\n.rumble-ui .esh-ttl>div{max-width:min(550px,94vw);padding-left:4vw}\n.rumble-ui .esh-mod{width:min(600px,100%);border-radius:2px;border-top:3px solid #f4cf78;box-shadow:0 20px 80px #0009;padding:22px 25px}\n.rumble-ui .esh-sh h2{font-size:31px}.rumble-ui .esh-k{letter-spacing:.18em;font-size:10px}\n.rumble-ui .esh-sh button{border-radius:2px;letter-spacing:.045em;font-size:14px;line-height:1.2;min-height:43px;transition:background .1s,border-color .1s}\n.rumble-ui .esh-btns{gap:6px;margin-top:17px}.rumble-ui button.rumble-focus{border-color:#f4cf78;box-shadow:inset 4px 0 #f4cf78;background:#f4cf7820;outline:2px solid #f4cf78;outline-offset:1px}\n.rumble-ui button.pri.rumble-focus{background:#f4cf78;color:#10222d}.rumble-ui .esh-sub{font-size:18px}\n.rumble-ui .rumble-description{font-size:12px;white-space:pre-line;margin:13px 0;color:#c6d7d1;line-height:1.55}\n.rumble-ui .rumble-item-value{float:right;margin-left:16px;color:#f4cf78}.rumble-ui .rumble-item-sub{display:block;font-size:10px;line-height:1.4;font-weight:400;text-transform:none;letter-spacing:0;color:#b7c9c7;margin-top:4px}\n.rumble-ui button.pri .rumble-item-sub{color:#263a39}.rumble-ui .rumble-range{display:block;width:100%!important;height:25px;margin-top:5px;accent-color:#f4cf78;cursor:ew-resize}\n.rumble-ui .rumble-meta{font-size:11px;line-height:1.65;color:#c7d6d1;white-space:pre-wrap;overflow-wrap:anywhere}\n.rumble-ui .rumble-status{color:#f4cf78;font-size:11px;min-height:16px;margin-top:9px;white-space:pre-wrap}\n.rumble-ui textarea{display:block;width:100%;height:115px;background:#06151e;color:#e8f0d4;border:1px solid #f4cf7855;padding:9px;font:10px/1.45 monospace;resize:vertical;user-select:text}\n.rumble-menu-button{position:fixed;right:max(12px,env(safe-area-inset-right));top:max(12px,env(safe-area-inset-top));z-index:15;width:48px;height:44px;border:1px solid #e5c98788;border-radius:5px;background:#061c29de;color:#fff1c4;font:23px Georgia;touch-action:manipulation}\n.rumble-ui .esh-nav{display:none}.rumble-ui .esh-sh{padding-top:max(20px,env(safe-area-inset-top));padding-bottom:max(16px,env(safe-area-inset-bottom))}\n@media(max-width:680px){.rumble-ui .esh-ttl>div{padding-left:0}.rumble-ui .esh-ttl{background:#061b27da;place-items:center}.rumble-ui .esh-ttl h1{font-size:36px;line-height:1.04}.rumble-ui .esh-mod{padding:17px 15px}.rumble-ui .esh-sh h2{font-size:25px}.rumble-ui .esh-btns{gap:5px;margin-top:12px}.rumble-ui .esh-sh button{font-size:12px;min-height:38px;padding:9px 11px}.rumble-ui .rumble-description{font-size:11px}.rumble-ui .esh-sh{padding-left:10px;padding-right:10px}}\n@media(prefers-reduced-motion:reduce){.rumble-ui *{transition:none!important}}`;\n    document.head.appendChild(style);\n    root?.classList.add('rumble-ui');\n  }\n  const menuButton = typeof document !== 'undefined' ? document.createElement('button') : null;\n  if (menuButton) {\n    menuButton.className = 'rumble-menu-button'; menuButton.textContent = 'Ⅱ'; menuButton.ariaLabel = 'Pause / menu';\n    menuButton.onclick = e => { e.stopPropagation(); e.preventDefault(); app.idle = 0; app.pause(); };\n    document.body.appendChild(menuButton);\n  }\n\n  const action = (label, fn, sub = '') => ({ label, action: fn, sub });\n  const current = () => app.world;\n  const home = () => { history = []; app.title(); };\n  const open = (screen, keep = false) => {\n    if (!keep && app.screen !== screen) history.push(app.screen);\n    app.input?.clear(); app.setScreen(screen); app.focus = 0; refresh();\n  };\n  const changed = () => { app.saveSettings?.(); app.audio?.setVolumes?.(app.settings); game.reduceMotion = !!app.settings.reducedMotion; refresh(); };\n  const choice = (label, object, key, choices, format = x => String(x), onChange) => ({\n    label, kind: 'choice', value: object[key], choices, format,\n    change(value) { object[key] = value; onChange?.(value); changed(); },\n    action() { const i = choices.indexOf(object[key]); this.change(choices[(i + 1) % choices.length]); },\n  });\n  const toggle = (label, object, key, onChange) => choice(label, object, key, [false, true], v => v ? 'On' : 'Off', onChange);\n  const slider = (label, object, key, min, max, step, unit = '', onChange) => ({\n    label, kind: 'slider', value: object[key], min, max, step, unit,\n    format: value => `${Number(value.toFixed(step < .01 ? 3 : step < 1 ? 2 : 0))}${unit ? ' ' + unit : ''}`,\n    change(value) { if (!Number.isFinite(value)) return; const v = clamp(rounded(value, step), min, max); const old = object[key]; object[key] = v; onChange?.(v, old); changed(); },\n    action() { this.change(object[key] + step); },\n  });\n  const cheat = () => { app.cheated = true; if (app.tour) app.tour.cheated = true; };\n  const restart = (opts = {}) => {\n    if (app.mode === 'hub') return;\n    cheat();\n    app.start(app.mode === 'attract' ? 'quick' : app.mode || 'quick', {\n      court: current()?.court || 0, bout: current()?.bout || 1, seed: current()?.seed || 17,\n      war: app.war || false, difficulty: app.difficulty || 'normal', ...opts,\n    });\n  };\n  const force = winner => {\n    if (app.mode === 'hub') return;\n    cheat();\n    if (app.forceResult) app.forceResult(winner);\n    else if (current()) {\n      const w = current(); const scores = w.players.map(p => p.score);\n      w.phase = 'over'; w.outcome = { winner, reason: 'developer', scores, banked: scores.map((v, s) => s === winner ? v * w.bout : 0) };\n    }\n    app.resume();\n  };\n\n  function titleItems() {\n    const items = [];\n    if (app.savedTour && app.savedTour.next <= 10) items.push(action(`Resume tour · bout ${app.savedTour.next}`, () => app.start('solo', { resume: true }), 'Continue your saved ten-bout war'));\n    items.push(action('Solo Tour', () => {\n      if (app.savedTour && app.savedTour.next <= 10) { details = 'Restarting replaces the saved tour. Your settings stay with you.'; open('restart-tour'); }\n      else app.start('solo', { teaching: true });\n    }, 'Ten bouts. Five courts. One questionable crown.'));\n    items.push(action('Quick Duel', () => { app.setupMode = 'quick'; open('setup'); }, 'Choose a court and a worthy opponent'));\n    items.push(action('Local Versus', () => { app.setupMode = 'local'; open('setup'); }, 'Two people, one screen, simultaneous fire'));\n    items.push(action('Settings', () => { settingPage = 0; open('settings'); }));\n    items.push(action('Controls', () => { controlPage = 0; open('controls'); }));\n    items.push(action('About / Credits', () => { aboutPage = 0; open('about'); }));\n    return items;\n  }\n  function setupItems() {\n    app.setup ||= { court: 0, difficulty: 'normal', war: false };\n    const s = app.setup, local = app.setupMode === 'local';\n    const list = [action(local ? 'Begin the duel' : 'Let the stones fly', () => {\n      if (local && app.settings.seat1 === app.settings.seat2 && app.settings.seat1 !== 'keyboard') { status = 'Each castle needs a different controller. Choose distinct seats.'; refresh(); return; }\n      if (local) {\n        const pads = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads() : [];\n        for (const assignment of [app.settings.seat1, app.settings.seat2]) if (assignment.startsWith('pad') && !pads[Number(assignment.slice(3))]?.connected) { status = `${assignment === 'pad0' ? 'Controller 1' : 'Controller 2'} is disconnected. Connect it or select keyboard.`; refresh(); return; }\n      }\n      app.start(local ? 'local' : 'quick', { court: s.court, difficulty: s.difficulty, war: local && s.war });\n    })];\n    list.push(choice('Court', s, 'court', [0, 1, 2, 3, 4], v => COURT_NAMES[v]));\n    if (local) {\n      list.push(choice('Format', s, 'war', [false, true], v => v ? 'Ten-bout war' : 'Single bout'));\n      list.push(choice('Rose / left seat', app.settings, 'seat1', ['keyboard', 'pad0', 'pad1'], v => ({ keyboard: 'Keyboard + mouse', pad0: 'Controller 1', pad1: 'Controller 2' }[v])));\n      list.push(choice('Azure / right seat', app.settings, 'seat2', ['keyboard', 'pad1', 'pad0'], v => ({ keyboard: 'Keyboard · Right Shift', pad0: 'Controller 1', pad1: 'Controller 2' }[v])));\n    } else list.push(choice('Rival strength', s, 'difficulty', ['easy', 'normal', 'hard'], v => ({ easy: 'Exhibition', normal: 'Tournament', hard: 'Royal champion' }[v])));\n    list.push(choice('Tension', app.settings, 'tension', [1.4, 1, .7], v => ({ '1.4': 'Forgiving · 1.4 s', '1': 'Lively · 1.0 s', '.7': 'Royal · 0.7 s', '0.7': 'Royal · 0.7 s' }[v] || v + ' s')));\n    list.push(action('Back', back));\n    return list;\n  }\n  function settingsItems() {\n    const s = app.settings;\n    const tabs = ['Sound', 'Play & display', 'Bindings'];\n    const list = [action(`Page: ${tabs[settingPage]}  →`, () => { settingPage = (settingPage + 1) % 3; app.focus = 0; refresh(); })];\n    if (settingPage === 0) {\n      list.push(slider('Music', s, 'music', 0, 1, .05, '', () => app.audio?.setVolumes?.(s)));\n      list.push(slider('Effects', s, 'effects', 0, 1, .05, '', () => app.audio?.setVolumes?.(s)));\n      list.push(slider('Gibberish voices', s, 'voice', 0, 1, .05, '', () => app.audio?.setVolumes?.(s)));\n      s.mute ||= false;\n      list.push(toggle('Mute all', s, 'mute'));\n    } else if (settingPage === 1) {\n      list.push(choice('Button symbols', s, 'glyphs', ['PlayStation', 'Xbox']));\n      list.push(choice('Tension', s, 'tension', [1.4, 1, .7], v => `${v.toFixed(1)} s to full`, value => { if (current() && app.mode !== 'hub') current().config.chargeTime = value; }));\n      list.push(toggle('Full predicted arc', s, 'prediction'));\n      list.push(toggle('Reduced motion', s, 'reducedMotion'));\n      list.push(slider('TV text size', s, 'uiScale', .85, 1.3, .05, '×'));\n      s.touchAssist ||= 0;\n      list.push(slider('Timing assist', s, 'touchAssist', 0, 1, .1, '', value => { if (current() && app.mode !== 'hub') current().config.assist = value; }));\n    } else {\n      list.push(action(`Left fire: ${keyName(s.fire1)}`, () => { app.rebinding = 'fire1'; status = 'Press a keyboard key for the left castle. Escape cancels.'; refresh(); }));\n      list.push(action(`Right fire: ${keyName(s.fire2)}`, () => { app.rebinding = 'fire2'; status = 'Press a keyboard key for the right castle. Escape cancels.'; refresh(); }));\n      for (const [key, label, def] of [['prev1', 'Left previous stone', 'KeyQ'], ['next1', 'Left next stone', 'KeyE'], ['prev2', 'Right previous stone', 'KeyU'], ['next2', 'Right next stone', 'KeyO']]) {\n        s[key] ||= def;\n        list.push(action(`${label}: ${keyName(s[key])}`, () => { app.rebinding = key; status = 'Press a new key. Escape cancels. Existing bindings are protected.'; refresh(); }));\n      }\n      list.push(action('Restore default bindings', () => { Object.assign(s, { fire1: 'Space', fire2: 'ShiftRight', prev1: 'KeyQ', next1: 'KeyE', prev2: 'KeyU', next2: 'KeyO' }); status = 'Default bindings restored.'; changed(); }));\n    }\n    list.push(action('Back', back)); return list;\n  }\n  function controlsItems() {\n    return [action('Previous page', () => { controlPage = 0; refresh(); }) , action('Next page', () => { controlPage = (controlPage + 1) % 3; refresh(); }), action('Replay the lesson', () => { app.start('quick', { court: 0, difficulty: 'easy', teaching: true }); }), action('Rebind controls', () => { settingPage = 2; open('settings'); }), action('Back', back)];\n  }\nconst DEAD_ZONE = .55;\nconst MENU_REPEAT_DELAY = .32;\nconst MENU_REPEAT_RATE = .12;\nconst keyDefaults = { fire1: 'Space', fire2: 'ShiftRight', prev1: 'KeyQ', next1: 'KeyE', prev2: 'KeyU', next2: 'KeyO' };\nconst formTarget = target => target?.closest?.('input,textarea,select');\n\nexport function createInput(E, game, app, ui, view) {\n  const abort = new AbortController();\n  const signal = abort.signal;\n  const held = [null, null];\n  const keyboard = new Set();\n  const pointers = new Map();\n  const pads = new Map();\n  const blockedPadButtons = new Set();\n  let lastScreen = app.screen, lastPointer = null, meaningfulPad = null;\n  const canvas = game.screen?.canvas || (typeof document !== 'undefined' ? document.querySelector('canvas') : null);\n  const now = () => game.real || performance.now() / 1000;\n  const ended = () => !!(app.hubEnded || app.online?.ended);\n  const menu = () => app.screen !== 'play';\n  const settings = () => Object.assign({}, keyDefaults, app.settings);\n  const living = () => !ended() && app.world?.phase === 'play';\n  const play = () => !menu() && living() && app.mode !== 'attract';\n  const feedback = device => {\n    app.device = device; app.idle = 0;\n    if (game.input) game.input.lastDevice = device === 'pad' ? 'gamepad' : device;\n  };\n  const absorbAttract = (device, e) => {\n    if (app.mode !== 'attract') return false;\n    feedback(device); clear(); app.title();\n    e?.preventDefault?.(); e?.stopImmediatePropagation?.();\n    return true;\n  };\n  const keySeat = seat => app.mode !== 'local' ? seat === 0 : app.settings[`seat${seat + 1}`] === 'keyboard';\n  const localSeat = seat => app.mode === 'hub' ? app.hubSeat : seat;\n  const eligible = seat => seat != null && seat >= 0 && seat < 2 && living() && !app.world.players[seat]?.ai;\n  const command = (seat, cmd) => {\n    const target = localSeat(seat); if (!eligible(target)) return false;\n    return app.command(target, cmd);\n  };\n  function begin(seat, source) {\n    if (!play() || !eligible(localSeat(seat)) || held[seat]) return;\n    held[seat] = source; command(seat, { type: 'begin' });\n  }\n  function release(seat, source) {\n    if (held[seat] !== source) return;\n    held[seat] = null;\n    if (play()) command(seat, { type: 'release' });\n    else command(seat, { type: 'cancel' });\n  }\n  function cancel(seat) {\n    held[seat] = null; command(seat, { type: 'cancel' });\n  }\n  function stone(seat, delta) {\n    if (!play()) return;\n    const p = app.world.players[localSeat(seat)]; if (!p) return;\n    command(seat, { type: 'stone', stone: (p.stone + delta + 3) % 3 });\n  }\n  function clear() {\n    // A lost input cancels; it must never count as a release.\n    for (let seat = 0; seat < 2; seat++) {\n      if (held[seat] || app.world?.players?.[localSeat(seat)]?.charge || app.world?.players?.[localSeat(seat)]?.buffer) cancel(seat);\n      held[seat] = null;\n    }\n    for (const id of pointers.keys()) { try { canvas?.releasePointerCapture(id); } catch {} }\n    pointers.clear(); keyboard.clear();\n    for (const [id, p] of pads) p.buttons.forEach((down, button) => { if (down) blockedPadButtons.add(`${id}:${button}`); });\n  }\n  function keydown(e) {\n    if (ended()) { e.preventDefault(); e.stopImmediatePropagation(); return; }\n    if (formTarget(e.target) && !app.rebinding) return;\n    if (absorbAttract('keyboard', e)) return;\n    feedback('keyboard');\n    app.audio?.unlock?.();\n    if (app.rebinding) { if (!e.repeat) ui.rebind(e.code); e.preventDefault(); e.stopImmediatePropagation(); return; }\n    const already = keyboard.has(e.code); keyboard.add(e.code);\n    const s = settings();\n    const consumed = new Set(['Space', 'Escape', 'Enter', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyC', ...Object.values(s).filter(v => typeof v === 'string' && /^(Key|Shift|Space)/.test(v))]);\n    if (consumed.has(e.code)) { e.preventDefault(); e.stopImmediatePropagation(); }\n    if (menu()) {\n      if (already && !['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'KeyW', 'KeyA', 'KeyS', 'KeyD'].includes(e.code)) return;\n      if (e.code === 'Escape' || e.code === 'KeyC') ui.back();\n      else if (e.code === 'Enter' || e.code === 'Space') ui.confirm();\n      else if (e.code === 'ArrowUp' || e.code === 'KeyW') ui.navigate(-1);\n      else if (e.code === 'ArrowDown' || e.code === 'KeyS') ui.navigate(1);\n      else if (e.code === 'ArrowLeft' || e.code === 'KeyA') ui.adjust(-1);\n      else if (e.code === 'ArrowRight' || e.code === 'KeyD') ui.adjust(1);\n      return;\n    }\n    if (e.code === 'Escape') { clear(); app.pause(); return; }\n    if (e.code === 'KeyC') { cancel(0); return; }\n    if (!play() || already) return;\n    if (e.code === s.fire1 && keySeat(0)) begin(0, 'key:' + e.code);\n    else if (e.code === s.fire2 && app.mode === 'local' && keySeat(1)) begin(1, 'key:' + e.code);\n    else if (e.code === s.prev1 && keySeat(0)) stone(0, -1);\n    else if (e.code === s.next1 && keySeat(0)) stone(0, 1);\n    else if (e.code === s.prev2 && app.mode === 'local' && keySeat(1)) stone(1, -1);\n    else if (e.code === s.next2 && app.mode === 'local' && keySeat(1)) stone(1, 1);\n    else if (e.code === 'ArrowLeft' || e.code === 'ArrowRight') {\n      app.pointerWorld ||= { x: app.mode === 'hub' && app.hubSeat === 1 ? 95 : 545, z: 85 };\n      app.pointerWorld.x = Math.max(0, Math.min(640, app.pointerWorld.x + (e.code === 'ArrowLeft' ? -8 : 8)));\n    }\n  }\n  function keyup(e) {\n    const s = settings(); keyboard.delete(e.code);\n    if (ended()) return;\n    if (e.code === s.fire1) release(0, 'key:' + e.code);\n    if (e.code === s.fire2) release(1, 'key:' + e.code);\n  }\n  const worldPoint = e => {\n    const p = view.worldPoint?.(e.clientX, e.clientY);\n    if (Array.isArray(p)) return { x: p[0], z: p[1] };\n    return p || { x: e.clientX / Math.max(1, innerWidth) * 640, z: 80 };\n  };\n  function pointerdown(e) {\n    if (ended()) { e.preventDefault(); return; }\n    const device = e.pointerType === 'touch' ? 'touch' : 'mouse';\n    if (absorbAttract(device, e)) return;\n    feedback(device); app.audio?.unlock?.();\n    if (formTarget(e.target)) return;\n    if (menu()) return; // native Shell buttons own pointer picks\n    if (!canvas || e.target !== canvas) return;\n    e.preventDefault();\n    const point = worldPoint(e); app.pointerWorld = point;\n    if (e.button === 2) { cancel(0); return; }\n    if (e.button !== 0 && device === 'mouse') return;\n    let seat = 0;\n    if (device === 'touch') {\n      const target = localSeat(0);\n      if (app.mode === 'local') seat = point.x < 320 ? 0 : 1;\n      else if (target === 1 ? point.x < 320 && e.clientY < innerHeight * .75 : point.x > 320 && e.clientY < innerHeight * .75) return;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"o.difficulty==='Easy'\\\",\\\"String(o.difficulty).toLowerCase()==='easy'\\\").replace(\\\"o.difficulty==='Hard'\\\",\\\"String(o.difficulty).toLowerCase()==='hard'\\\")\ns=s.replace(\\\"app.lesson=mode==='solo'&&bout===1&&\"'!app.teachingSkipped?{phase:0}:null;\", \"app.lesson=((mode==='\"'solo'&&bout===1)||o.teaching)&&\"'!app.teachingSkipped?{phase:0}:null;\")\ns=s.replace(\"if(app.lesson&&app.mode==='\"'solo')\\\", \\\"if(app.lesson&&app.mode\"'!=='\"'hub')\\\")\ns=s.replace(\\\"app._options={...o,court,bout,seed,war:mode==='local'&&\"'!!app.tour};\", \"app.war=mode==='\"'local'&&\"'!!app.tour;app._options={...o,court,bout,seed,war:app.war};\")\ns=s.replace(\"const count=app.dev.step?1:Math.max(1,Math.round(app.dev.speed||1));for(let i=0;i<count&&app.world.phase==='\"'play';i++)step(app.world,DT);app.dev.step=false;\\\", \\\"app._speedCarry=(app._speedCarry||0)+(app.dev.step?1:Math.max(.1,app.dev.speed||1));const count=Math.floor(app._speedCarry+1e-8);app._speedCarry-=count;for(let i=0;i<count&&app.world.phase==='play';i++)step(app.world,DT);app.dev.step=false;\\\")\ns=s.replace(\\\"app.world=createWorld({mode,court,bout,seed:seed+bout*7919,ai,config,available:\\\", \\\"config.assist=app.settings.touchAssist||0;app.world=createWorld({mode,court,bout,seed:seed+bout*7919,ai,config,available:\\\")\ns=s.replace(\\\"w.config={...DEFAULTS,chargeTime:app.settings.tension};w.cheated=true;\\\", \\\"const oldScale=w.config.healthScale;for(const b of w.blocks)if(\"'!b.foundation){const fraction=b.hp/b.maxHp;b.maxHp=b.maxHp/oldScale;b.hp=b.maxHp*fraction;}w.maxHealth=[0,1].map(seat=>w.blocks.filter(b=>b.seat===seat&&!b.foundation).reduce((n,b)=>n+b.maxHp,0));w.config={...DEFAULTS,chargeTime:app.settings.tension};w.cheated=true;\")\nopen(p,'\"'w').write(s)\np='src/persistence.js';s=open(p).read().replace(\\\"seat2:'keyboard'\\\", \\\"seat2:'keyboard',prev1:'KeyQ',next1:'KeyE',prev2:'KeyU',next2:'KeyO',touchAssist:0\\\")\ns=s.replace(\\\"if([.85,1,1.15,1.3].includes(raw.settings.uiScale))settings.uiScale=raw.settings.uiScale;\\\", \\\"if(Number.isFinite(raw.settings.uiScale)&&raw.settings.uiScale>=.85&&raw.settings.uiScale<=1.3)settings.uiScale=raw.settings.uiScale;if(Number.isFinite(raw.settings.touchAssist))settings.touchAssist=Math.max(0,Math.min(1,raw.settings.touchAssist));\\\")\ns=s.replace(\\\"['fire1','fire2']\\\", \\\"['fire1','fire2','prev1','next1','prev2','next2']\\\").replace(\\\"Space|ShiftRight|Key\\\", \\\"Space|ShiftRight|ShiftLeft|Key\\\").replace(\\\"['keyboard','pad1','pad2','mouse']\\\", \\\"['keyboard','pad0','pad1']\\\")\nopen(p,'w').write(s)\nPY\nnode --input-type=module <<'JS'\nimport './vendor/engine/my-3d2dge.js';\nimport {createRuntime} from './src/main.js';\nconst app=createRuntime({headless:true,loop:false,storage:{getItem:()=>null,setItem:()=>{}}});app.start('solo',{seed:8});app.game.advance(1);console.log(app.snapshot());app.dispose();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"o.difficulty==='Easy'\\\",\\\"String(o.difficulty).toLowerCase()==='easy'\\\").replace(\\\"o.difficulty==='Hard'\\\",\\\"String(o.difficulty).toLowerCase()==='hard'\\\")\ns=s.replace(\\\"app.lesson=mode==='solo'&&bout===1&&\"'!app.teachingSkipped?{phase:0}:null;\", \"app.lesson=((mode==='\"'solo'&&bout===1)||o.teaching)&&\"'!app.teachingSkipped?{phase:0}:null;\")\ns=s.replace(\"if(app.lesson&&app.mode==='\"'solo')\\\", \\\"if(app.lesson&&app.mode\"'!=='\"'hub')\\\")\ns=s.replace(\\\"app._options={...o,court,bout,seed,war:mode==='local'&&\"'!!app.tour};\", \"app.war=mode==='\"'local'&&\"'!!app.tour;app._options={...o,court,bout,seed,war:app.war};\")\ns=s.replace(\"const count=app.dev.step?1:Math.max(1,Math.round(app.dev.speed||1));for(let i=0;i<count&&app.world.phase==='\"'play';i++)step(app.world,DT);app.dev.step=false;\\\", \\\"app._speedCarry=(app._speedCarry||0)+(app.dev.step?1:Math.max(.1,app.dev.speed||1));const count=Math.floor(app._speedCarry+1e-8);app._speedCarry-=count;for(let i=0;i<count&&app.world.phase==='play';i++)step(app.world,DT);app.dev.step=false;\\\")\ns=s.replace(\\\"app.world=createWorld({mode,court,bout,seed:seed+bout*7919,ai,config,available:\\\", \\\"config.assist=app.settings.touchAssist||0;app.world=createWorld({mode,court,bout,seed:seed+bout*7919,ai,config,available:\\\")\ns=s.replace(\\\"w.config={...DEFAULTS,chargeTime:app.settings.tension};w.cheated=true;\\\", \\\"const oldScale=w.config.healthScale;for(const b of w.blocks)if(\"'!b.foundation){const fraction=b.hp/b.maxHp;b.maxHp=b.maxHp/oldScale;b.hp=b.maxHp*fraction;}w.maxHealth=[0,1].map(seat=>w.blocks.filter(b=>b.seat===seat&&!b.foundation).reduce((n,b)=>n+b.maxHp,0));w.config={...DEFAULTS,chargeTime:app.settings.tension};w.cheated=true;\")\nopen(p,'\"'w').write(s)\np='src/persistence.js';s=open(p).read().replace(\\\"seat2:'keyboard'\\\", \\\"seat2:'keyboard',prev1:'KeyQ',next1:'KeyE',prev2:'KeyU',next2:'KeyO',touchAssist:0\\\")\ns=s.replace(\\\"if([.85,1,1.15,1.3].includes(raw.settings.uiScale))settings.uiScale=raw.settings.uiScale;\\\", \\\"if(Number.isFinite(raw.settings.uiScale)&&raw.settings.uiScale>=.85&&raw.settings.uiScale<=1.3)settings.uiScale=raw.settings.uiScale;if(Number.isFinite(raw.settings.touchAssist))settings.touchAssist=Math.max(0,Math.min(1,raw.settings.touchAssist));\\\")\ns=s.replace(\\\"['fire1','fire2']\\\", \\\"['fire1','fire2','prev1','next1','prev2','next2']\\\").replace(\\\"Space|ShiftRight|Key\\\", \\\"Space|ShiftRight|ShiftLeft|Key\\\").replace(\\\"['keyboard','pad1','pad2','mouse']\\\", \\\"['keyboard','pad0','pad1']\\\")\nopen(p,'w').write(s)\nPY\nnode --input-type=module <<'JS'\nimport './vendor/engine/my-3d2dge.js';\nimport {createRuntime} from './src/main.js';\nconst app=createRuntime({headless:true,loop:false,storage:{getItem:()=>null,setItem:()=>{}}});app.start('solo',{seed:8});app.game.advance(1);console.log(app.snapshot());app.dispose();\nJS\"","aggregated_output":"{\n  screen: 'play',\n  mode: 'solo',\n  world: {\n    tick: 120,\n    time: 1,\n    court: 0,\n    bout: 1,\n    phase: 'play',\n    health: [ 1, 1 ],\n    scores: [ 0, 0 ],\n    shots: [ 0, 0 ],\n    outcome: null\n  },\n  tour: { next: 1, totals: [ 0, 0 ], seed: 8, cheated: false },\n  lesson: { phase: 0 },\n  device: 'keyboard',\n  errors: [],\n  online: undefined\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > tests/simulation.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {createWorld,command,step,predict,planShot,health,collapse,finish,timeout,resetCastles,validateCourt,segmentBox,DEFAULTS,STONES,COURTS,RIVALS,DT,pack,unpack} from '../src/sim.js';\nimport {load,save,NAMESPACE} from '../src/persistence.js';\nimport '../vendor/engine/my-3d2dge.js';\nimport {createRuntime} from '../src/main.js';\nexport async function runSimulation(){\n let checks=0;const failures=[];const evidence={tour:[],courts:[],issues:[]};\n const ok=(value,message)=>{checks++;try{assert.ok(value,message);}catch(e){failures.push(message);}};\n const equal=(a,b,message)=>{checks++;try{assert.deepEqual(a,b,message);}catch(e){failures.push(message+': '+JSON.stringify({actual:a,expected:b}));}};\n const advance=(w,seconds)=>{for(let i=0;i<Math.round(seconds/DT);i++)step(w);};\n const shot=(w,power,type=0,seat=0)=>{command(w,seat,{type:'stone',stone:type});command(w,seat,{type:'begin'});advance(w,Math.round(power*w.config.chargeTime/DT)*DT);const q=w.players[seat].charge?.power;command(w,seat,{type:'release'});return q;};\n // Predictor and production integration, every stone from both ends.\n for(let type=0;type<3;type++)for(let seat=0;seat<2;seat++){\n  const w=createWorld();const n=108,power=n*DT/w.config.chargeTime;const predicted=predict(w,seat,power,type);command(w,seat,{type:'stone',stone:type});command(w,seat,{type:'begin'});for(let i=0;i<n;i++)step(w);command(w,seat,{type:'release'});advance(w,7);\n  const impacts=w.events.filter(e=>e.type==='impact'&&e.seat===seat);equal(impacts.length,predicted.impacts.length,\"'`stone${type} seat${seat} impact count`);\n  ok(impacts.every((e,i)=>Math.hypot(e.x-predicted.impacts[i].x,e.z-predicted.impacts[i].z)<.001),`stone${type} seat${seat} prediction/live agreement`);\n  ok(w.events.filter(e=>e.type==='\"'split').length===(type===2?1:0),\"'`stone${type} deterministic apex split`);\n }\n const sweep=segmentBox(0,100,900,100,{x:430,z:95,w:4,h:10},3);ok(sweep>0&&sweep<1,'\"'fast projectile sweeps thin block');\n // Charge stops full, cancellation and buffer semantics.\n {const w=createWorld();shot(w,.03);equal(w.stats.shots,[0,0],'short hold cancels safely');command(w,0,{type:'begin'});advance(w,2);equal(w.players[0].charge.power,1,'charge stops at full');command(w,0,{type:'stone',stone:1});equal(w.players[0].stone,0,'stone locked while charging');command(w,0,{type:'cancel'});equal(w.players[0].charge,null,'cancel charge');shot(w,.6);command(w,0,{type:'begin'});ok(w.players[0].buffer,'reload press buffered');command(w,0,{type:'release'});advance(w,2);equal(w.stats.shots[0],1,'released buffer never fires');command(w,0,{type:'begin'});advance(w,.4);command(w,0,{type:'release'});ok(w.stats.shots[0]===2,'fresh charge after reload');}\n {const w=createWorld();command(w,0,{type:'begin'});command(w,1,{type:'begin'});advance(w,.7);command(w,1,{type:'release'});advance(w,.2);command(w,0,{type:'release'});equal(w.stats.shots,[1,1],'simultaneous independent holds opposite release order');}\n // Every objective is reachable when exposed, all five authored layouts connect.\n for(let court=0;court<5;court++){\n  const base=createWorld({court});ok(validateCourt({version:1,layout:COURTS[court].layout}).valid,\"'`court${court} valid supports`);\n  for(let seat=0;seat<2;seat++){\n   let all=true;for(const b of base.blocks.filter(b=>b.seat===1-seat&&!b.foundation)){\n    const w=pack(base);for(const x of w.blocks)if(x.seat===b.seat&&!x.foundation&&x.id!==b.id)x.alive=false;\n    let hit=false;for(let i=15;i<=100&&!hit;i++){const p=predict(w,seat,i/100,0);hit=p.impacts.some(h=>h.target==='\"'block'&&h.id===b.id);}if(\"'!hit)all=false;\n   }ok(all,`court${court} seat${seat} every last fragment reachable`);\n  }\n }\n const find=(w,target,seat=0,type=0)=>{for(let i=100;i<1000;i++){const pr=predict(w,seat,i/1000,type);if(pr.impacts.some(h=>h.target===target))return i/1000;}return null;};\n for(const target of ['\"'crew','launcher']){\n  const w=createWorld();const power=find(w,target);ok(power\"'!==null,target+'\"' reachable');shot(w,power);advance(w,5);\n  const hits=w.events.filter(e=>e.type===target);equal(hits.length,1,target+' interruption occurs');ok(w.stats.recoveries>=1,target+' returns');equal(w.players[0].score,target==='crew'?7:13,target+' weighted direct score');\n }\n // Direct fixture places a real swept projectile at a target; tests recovery state transitions without bypassing damage resolution.\n const near=(w,target,seat=0,id=91)=>{const p=w.players[1-seat],x=target==='crew'?p.crewX:p.x;w.throws[id]={hit:[],disabled:[]};w.projectiles.push({id,throwId:id,seat,type:0,x:x-20*(seat?-1:1),z:55,vx:600*(seat?-1:1),vz:0,age:0,fragment:false,power:.5,gravity:120});};\n {const w=createWorld();command(w,1,{type:'begin'});near(w,'crew');advance(w,.1);ok(w.players[1].crewUntil>w.time,'crew retreats');equal(w.players[1].charge,null,'interrupt cancels charge');ok(\"'!command(w,1,{type:'\"'begin'}),'absent crew cannot charge');near(w,'launcher',0,92);advance(w,.1);ok(w.players[1].launcherUntil>w.players[1].crewUntil,'overlap uses later repair endpoint');const end=Math.max(w.players[1].crewUntil,w.players[1].launcherUntil);advance(w,end-w.time+.02);ok(w.players[1].protectUntil>w.time,'return protected');equal(w.players[1].held,false,'no returning queued shot');const score=w.players[0].score;near(w,'crew',0,93);advance(w,.08);equal(w.players[0].score,score,'protected hit no repeat score');ok(w.players[1].crewUntil< w.time,'protected hit no re-disable');}\n {const w=createWorld();near(w,'crew',0,97);near(w,'crew',0,97);advance(w,.1);equal(w.stats.crew,1,'same split/throw cannot multiply crew duration');equal(w.players[0].score,7,'same throw cannot farm crew score');}\n {const w=createWorld();const victim=w.blocks.find(b=>b.seat===1&&\"'!b.foundation&&b.z===40);victim.alive=false;victim.hp=0;const score=w.players[0].score;const ids=collapse(w);ok(ids.length>0,'\"'removing support cascades');equal(w.players[0].score,score,'cascade gives no direct score');ok(w.blocks.filter(b=>b.foundation).every(b=>b.alive),'foundations remain stable');ok(w.blocks.filter(b=>ids.includes(b.id)).every(b=>\"'!b.alive&&b.hp===0),'\"'collapse removed from collision/objective state');}\n {const w=createWorld({bout:7});w.players[0].score=13;finish(w,0);equal(w.outcome.banked,[91,0],'one-based weighted score banks winner only');ok(\"'!finish(w,1),'\"'outcome exactly once');equal(w.projectiles,[],'old shots cleared on outcome');}\n {const w=createWorld();for(const b of w.blocks)if(\"'!b.foundation)b.alive=false;step(w);equal(w.outcome.winner,-1,'\"'mutual objective loss same tick is draw');}\n {const w=createWorld({limit:.01});step(w);step(w);equal(w.outcome.winner,-1,'equal timeout is draw');equal(w.outcome.reason,'time','visible deadline');}\n {const w=createWorld();w.players[0].score=7;timeout(w);equal(w.outcome.winner,0,'timeout tied health uses direct score');}\n {const w=createWorld();w.blocks.find(b=>b.seat===0&&\"'!b.foundation).hp-=1;w.players[0].score=100;timeout(w);equal(w.outcome.winner,1,'\"'timeout health percentage precedes score');}\n {const w=createWorld({config:{gravity:NaN,reload:-30,maxSpeed:999}});ok(Number.isFinite(w.config.gravity)&&w.config.reload>0&&w.config.maxSpeed<=390,'tuning validates finite ranges');equal(unpack(pack(w)),w,'serializable complete world round trip');}\n // Persistence denial and corrupt/old data.\n const memory={data:null,getItem(){return this.data;},setItem(k,v){this.data=v;}};\n for(const value of ['{',JSON.stringify({version:0,settings:{music:.9},tour:{next:9}})]){memory.data=value;const l=load(memory);equal(l.settings.music,.1,'corrupt/old settings safe defaults');equal(l.tour,null,'corrupt/old tour rejected');}\n {const denied={getItem(){throw Error('denied');},setItem(){throw Error('denied');}};equal(load(denied).settings.music,.1,'denied storage boot');ok(\"'!save({},null,denied),'\"'denied storage write nonfatal');}\n {const s=load(memory).settings;s.fire1='KeyF';s.prev1='KeyA';s.uiScale=1.1;s.seat1='pad0';const t={next:4,totals:[10,30],seed:52,cheated:false};save(s,t,memory);const v=load(memory);equal(v.tour,t,'tour between-bout save restores');equal([v.settings.fire1,v.settings.prev1,v.settings.uiScale,v.settings.seat1],['KeyF','KeyA',1.1,'pad0'],'bindings/scale/seat settings retained');}\n {ok(\"'!validateCourt({version:1,layout:[[0,40,20,20,'\"'stone']]}).valid,'unsupported author court rejected');const w=createWorld();ok(validateCourt({version:1,blocks:w.blocks}).valid,'block author export/import validates');const bad=pack(w).blocks;bad[4].supports=[9999];ok(\"'!validateCourt({version:1,blocks:bad}).valid,'\"'missing author support rejected');}\n // Human-paced entry path through runtime; pause cancels and freezes; slow speed and one-step dev paths.\n {const app=createRuntime({headless:true,loop:false,storage:{getItem:()=>null,setItem(){}}});app.start('quick',{teaching:true,difficulty:'easy',seed:17});app.command(0,{type:'begin'});app.game.advance(.75);ok(app.world.players[0].charge.power>.5&&app.world.players[0].charge.power<.6,'human-paced .75s hold yields understandable tension');app.pause();const t=app.world.tick;app.game.advance(1);equal(app.world.tick,t,'standalone pause freezes simulation');equal(app.world.players[0].charge,null,'pause cancels pending charge');app.resume();app.game.advance(1);equal(app.world.stats.shots[0],0,'resume does not fire held input');app.dev.speed=.5;const tick=app.world.tick;app.game.advance(1);equal(app.world.tick-tick,60,'developer half-speed works');app.dev.paused=true;app.dev.step=true;const before=app.world.tick;app.game.advance(DT);equal(app.world.tick,before+1,'developer exact one-step works');app.dispose();}\n // Exact idle threshold, consumed exit handled in browser adapter tests.\n {const app=createRuntime({headless:true,loop:false,storage:{getItem:()=>null,setItem(){}}});app.game.advance(10-DT);equal(app.mode,'title','no attract before ten seconds');app.game.advance(DT);equal(app.mode,'attract','attract at exactly ten seconds');app.game.advance(30);ok(app.world.stats.shots.reduce((a,b)=>a+b,0)>0,'attract runs real legal simulation');equal(app.savedTour,null,'attract never writes tour');app.title();equal(app.world.stats.shots,[0,0],'attract exit clears simulation state');app.dispose();}\n // All authored rival/court combinations finish through legal AI, bounded duration.\n for(let court=0;court<5;court++){\n  const w=createWorld({court,seed:81+court,ai:[{style:'mason',perfect:true,reaction:.8,breadth:81},RIVALS[court*2+1]]});while(w.phase==='play')step(w);ok(w.outcome&&w.time<=90,\"'`court${court} rival completes`);ok(w.stats.shots.every(n=>n>0),`court${court} both AI use legal shots`);ok(w.blocks.every(b=>Number.isFinite(b.hp))&&w.projectiles.every(s=>Number.isFinite(s.x)),`court${court} no NaN`);evidence.courts.push({court,time:w.time,outcome:w.outcome,stats:w.stats});\n }\n // Complete tour via real runtime entry, one skilled test driver sending only legal commands.\n {memory.data=null;const app=createRuntime({headless:true,loop:false,storage:memory});app.start('\"'solo',{seed:88417});let guard=0;let drive=null;let runShots=0;const coverage={stones:new Set(),crew:0,launcher:0,collapse:0,teaching:false,loss:false};\n  while(app.screen\"'!=='\"'championship'&&guard<130000){guard++;\n   const w=app.world,p=w.players[0];\n   if(app.screen==='play'&&w.phase==='play'){\n    if(\"'!drive&&!p.charge&&p.reloadUntil<=w.time&&Math.max(p.crewUntil,p.launcherUntil)<=w.time){let type=w.available[runShots%w.available.length];let q;\n     if(w.bout===1&&runShots<2){q=find(w,runShots===0?'\"'crew':'launcher');type=0;}\n     const aim=q?{power:q,type}:planShot({...w,available:[type]},0,{style:'mason',breadth:81});\n     command(w,0,{type:'stone',stone:type});if(command(w,0,{type:'begin'}))drive={release:w.time+aim.power*w.config.chargeTime*(1+w.config.assist*.5)};\n    }else if(drive){if(\"'!p.charge){drive=null;}else if(w.time>=drive.release){command(w,0,{type:'\"'release'});runShots++;drive=null;}}\n   }\n   app.game.advance(DT);\n   if(app.lesson?.phase===2)coverage.teaching=true;\n   if(app.screen==='result'){\n    coverage.crew+=w.stats.crew;coverage.launcher+=w.stats.launcher;coverage.collapse+=w.stats.collapses;for(const s of w.stats.used[0])coverage.stones.add(s);coverage.loss ||= w.outcome.winner===1;evidence.tour.push({bout:w.bout,court:w.court,time:w.time,outcome:w.outcome,stats:w.stats});app.advance();drive=null;\n   }\n  }\n  equal(evidence.tour.length,10,'full tour plays all ten bouts');equal([...new Set(evidence.tour.map(r=>r.court))],[0,1,2,3,4],'full tour visits five courts');equal(app.screen,'championship','tour reaches championship ceremony');ok(coverage.teaching,'teaching requires shot and actual hit');equal([...coverage.stones].sort(),[0,1,2],'tour demonstrates all three stones');ok(coverage.crew>0&&coverage.launcher>0,'tour demonstrates both tactical interruptions');ok(coverage.collapse>0,'tour demonstrates support collapse');equal(app.savedTour,null,'completed tour clears resumable save');ok(app._tourHistory.length===10,'tour results bank exactly once');const sum=[0,1].map(s=>evidence.tour.reduce((n,b)=>n+b.outcome.banked[s],0));equal(app.tour.totals,sum,'tour weighted totals reconcile');app.start('solo',{seed:999});equal(app.world.bout,1,'championship replay starts fresh run');ok(\"'!app.world.invulnerable&&app.dev.speed===1,'\"'cheat and attract assistance do not leak into fresh play');app.dispose();evidence.coverage={...coverage,stones:[...coverage.stones]};\n }\n return {checks,failures,evidence};\n}\nif(process.argv[1]?.endsWith('simulation.mjs')){const r=await runSimulation();for(const f of r.failures)console.error('FAIL '+f);console.log(\"'`${r.checks} checks, ${r.failures.length} failures`);const fs=await import('\"'node:fs');fs.writeFileSync(new URL('../artifacts/simulation.json',import.meta.url),JSON.stringify(r,null,2));process.exitCode=r.failures.length?1:0;}\nEOF\nnode tests/simulation.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"agent_message","text":"All four official Hub harness cases passed, including adverse network conditions and a host with no local player. The extra firing test found a remote-input problem that is being fixed. Visual review also caught a clipped TV menu and an inherited touch overlay; those are being corrected before final verification.\n"}}
