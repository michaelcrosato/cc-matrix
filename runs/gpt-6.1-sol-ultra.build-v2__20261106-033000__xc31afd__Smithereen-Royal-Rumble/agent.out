{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/sim.js';s=open(p).read()\ns=s.replace(\\\"if(ids.has(b.id))errors.push('Block IDs must be unique.');\\\", \\\"if(\"'!Number.isInteger(b.id)||b.id<0||ids.has(b.id))errors.push('\"'Block IDs must be unique nonnegative integers.');\\\")\ns=s.replace(\\\"b.w<4||b.h<4||b.x<30||b.x+b.w>610\\\", \\\"b.maxHp<=0||b.hp<0||b.hp>b.maxHp||b.w<4||b.h<4||b.x<30||b.x+b.w>610\\\")\ns=s.replace(\\\"for(const b of data.blocks)if(b.supports?.some(id=>\"'!ids.has(id)))errors.push('\"'Support ID is missing.');\\\", \\\"for(const b of data.blocks){if(b.seat===0&&(b.x<30||b.x+b.w>140)||b.seat===1&&(b.x<500||b.x+b.w>610))errors.push('Keep Rose blocks in x30–140 and Azure blocks in x500–610.');if(b.supports?.some(id=>\"'!ids.has(id)))errors.push('\"'Support ID is missing.');if(b.supports?.some(id=>data.blocks.find(a=>a.id===id)?.seat\"'!==b.seat))errors.push('\"'Support must belong to the same castle.');}for(const seat of [0,1])if(\"'!data.blocks.some(b=>b.seat===seat&&b.foundation&&b.alive)||!data.blocks.some(b=>b.seat===seat&&!b.foundation&&b.alive))errors.push('\"'Each castle needs a living foundation and objective.');\\\")\nopen(p,'w').write(s)\np='tests/simulation.mjs';s=open(p).read();s=s.replace(\\\"ok(\"'!validateCourt({version:1,blocks:bad}).valid,'\"'missing author support rejected');\\\", \\\"ok(\"'!validateCourt({version:1,blocks:bad}).valid,'\"'missing author support rejected');const foreign=pack(w).blocks;foreign[4].supports=[foreign.find(b=>b.seat===1&&b.foundation).id];ok(\"'!validateCourt({version:1,blocks:foreign}).valid,'\"'foreign-castle support rejected');const outside=pack(w).blocks;outside[4].x=320;ok(\"'!validateCourt({version:1,blocks:outside}).valid,'\"'author keeps blocks inside supported collision court footprint');\\\")\nopen(p,'w').write(s)\nPY\nnpm run build && npm run verify\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
