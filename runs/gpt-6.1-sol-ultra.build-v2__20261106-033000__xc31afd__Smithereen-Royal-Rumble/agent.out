 this.pause(reason); }\n2543:   * o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when\n2559:    on(window, 'blur', () => this._autoPause('focus'));\n2560:    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its soun [... omitted end of long line]\n2561:    on(window, 'pagehide', () => this._autoPause('focus'));\n2905:    this.scene = s; this.sceneName = name; this.paused = false; if (old) prune(this._timers, t => !t.keep); this.hitstop = 0;   // (timers made before the first scene live into it)\n2938:    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTR [... omitted end of long line]\n2943:    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n2950:    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n3190:    b.addEventListener('click', e => { e.stopPropagation(); b.blur(); fn(); });   // (blurred, so a later Space or Enter is the game's)\n3826:    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n3827:    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.co [... omitted end of long line]\n10413:    click: 'mouse', dblclick: 'mouse', contextmenu: 'mouse', input: 'value', change: 'value', resize: 'resize', visibilitychange: 'hidden',\n10414:    fullscreenchange: 'fullscreen', webkitfullscreenchange: 'fullscreen', gotpointercapture: 'capture', lostpointercapture: 'capture', blur: 'plain', focus: 'plain', cancel: 'plain' };\n10415:  const ON_DOC = ['visibilitychange', 'fullscreenchange', 'webkitfullscreenchange'];\n10486:  const wanted = e => KIND[e.type] && e.isTrusted && ((e.type !== 'blur' && e.type !== 'focus') || e.target === window);\n10565:    const base = { bubbles: !['blur', 'focus', 'cancel'].includes(type), cancelable: true, composed: true };\n10578:    else t.dispatchEvent(type === 'blur' || type === 'focus' ? new FocusEvent(type) : new Event(type, base));\n10633:if (cab.p.score !== 600 || cab.p.lives !== 3) throw new Error('extra life');\n10672:    this.players = Array.from({ length: Math.max(1, Math.min(2, players)) }, (_, i) => ({ n: i + 1, score: 0, lives: this.o.lives, save: null, next: this.o.every || (this.o.extra[0] === undefined ? In [... omitted end of long line]\n10683:      p.lives++; const every = this.o.every, more = this.o.extra.find(s => s > p.next); p.next = every ? p.next + every : more === undefined ? Infinity : more;\n10691:    p.lives = Math.max(0, p.lives - 1);\n10694:      const q = this.players[(i + k) % n]; if (q.lives <= 0) continue;\n10770:        this._cont = null; for (const p of this.players) p.lives = this.o.lives;\n10785:        for (let i = 0; i < Math.min(6, this.p.lives - 1); i++) { E.px.disc(g, X + 9 + i * 9, Y + H - 7, 3, col[2]); E.px.dot(g, X + 8 + i * 9, Y + H - 8, '#ffffff'); }\n/* AI Hub v1 shared-world adapter. Only host advances the production simulation. */\nimport { createWorld, command as simCommand, step, health } from './sim.js';\n\nconst STEP = 1 / 120;\nconst PROTOCOL = 1;\nconst MAX_BYTES = 16000;\nconst CLOCK_TOLERANCE = 0.65;\nconst HOLD_TOLERANCE = 0.4;\nconst clamp = (n, a, b) => Math.max(a, Math.min(b, n));\nconst q = (n) => Number(Number(n || 0).toFixed(3));\nconst bytes = (v) => new TextEncoder().encode(JSON.stringify(v)).length;\nconst safeNumber = (v) => typeof v === 'number' && Number.isFinite(v);\n\n/** Exported for deterministic transport/lifecycle tests with an injected Hub. */\nexport function createOnlineAdapter(app, hub, info) {\n  const ids = info.players.map((p) => p.id);\n  const seats = new Map(ids.map((id, seat) => [id, seat]));\n  const isHost = !!info.isHost;\n  const localSeat = info.server ? null : seats.get(info.me) ?? null;\n  const pending = [];\n  const unsub = [];\n  const acceptedSeq = new Map();\n  const receivedBegin = new Map();\n  const lastAck = new Map();\n  const gone = new Set();\n  const diagnostics = {\n    sent: 0, rejected: 0, retries: 0, received: 0, malformed: 0,\n    duplicateCommands: 0, blockedCommands: 0, commands: 0,\n    baselineAcks: 0, maxBytes: 0, maxSnapshotBytes: 0,\n    maxOneSecond: 0, queuePeak: 0, finishCalls: 0, hostTicks: 0,\n    started: false, ended: false, server: !!info.server,\n  };\n  const sentTimes = [];\n  let ended = false;\n  let started = false;\n  let finished = false;\n  let seq = 0;\n  let snapshotSeq = 0;\n  let appliedSeq = -1;\n  let baselineVersion = 0;\n  let lastBaseline = -Infinity;\n  let lastSnapshot = -Infinity;\n  let lastEventsAt = -Infinity;\n  let lastEventId = 0;\n  let receivedEventId = 0;\n  let lastAckAt = -Infinity;\n  let tokens = 28;\n  let tokenAt = 0;\n  let localBegin = null;\n  let localChoice = null;\n  let localReleasePending = false;\n  let releaseSequence = 0;\n  let choiceSequence = 0;\n  let endAfterFlush = false;\n  let finishPayload = null;\n  let ackPending = false;\n  let waitingSnapshot = null;\n  const clock = () => Math.max(0, hub.time() / 1000);\n\n  app.mode = 'hub';\n  app.screen = 'play';\n  app.hubSeat = localSeat;\n  app.hubNames = info.players.map((p) => String(p.name || `Player ${seats.get(p.id) + 1}`));\n  app.hubServer = !!info.server;\n  app.hubEnded = false;\n  app.caption = 'The court is assembling. Hold Fire, release to throw.';\n  const seed = Number.isFinite(info.seed) ? info.seed : 1;\n  app.world = createWorld({ mode: 'hub', court: Math.abs(seed) % 5, seed, limit: 180 });\n  app.world.limit = 180;\n  app.world.players.forEach((p) => { p.ai = null; });\n\n  function enqueue(data, { to, reliable = true, critical = false } = {}) {\n    if (ended) return false;\n    let size;\n    try { size = bytes(data); } catch { diagnostics.malformed++; return false; }\n    if (size > MAX_BYTES) { diagnostics.malformed++; return false; }\n    // State packets supersede older state; intentions/cancels preserve FIFO order.\n    if (!reliable) {\n      const previous = pending.findIndex((p) => !p.options.reliable && p.data.t === data.t && p.options.to === to);\n      if (previous >= 0) pending.splice(previous, 1);\n    }\n    if (pending.length >= 96) {\n      const expendable = pending.findIndex((p) => !p.options.reliable);\n      if (expendable >= 0) pending.splice(expendable, 1);\n      else { diagnostics.blockedCommands++; return false; }\n    }\n    pending.push({ data, size, options: { ...(to === undefined ? {} : { to }), reliable }, critical, attempts: 0 });\n    diagnostics.queuePeak = Math.max(diagnostics.queuePeak, pending.length);\n    flush();\n    return true;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '130,176p' vendor/engine/API.md && rg -n 'requestAnimationFrame|_frame\\\\(|_step\\\\(' vendor/engine/my-3d2dge.js | tail -n 25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '130,176p' vendor/engine/API.md && rg -n 'requestAnimationFrame|_frame\\\\(|_step\\\\(' vendor/engine/my-3d2dge.js | tail -n 25\"","aggregated_output":"- Weather: `game.weather = { kind: 'rain' | 'snow' | 'ash' | 'leaves' | 'sand', amount: .8, wind: .3, lightning: .2 }` (null: clear) falls through the world in every view, settles or splashes, flashes and thunders; cosmetic only (its own random stream), and it ends with the scene: set it in `enter`.\n- Wrap-around (Asteroids): `x = E.wrap(x, 0, W)`, `E.wrapDiff(a, b, W)` (the short way across the seam), and `wrap: [W, H]` on `r.sprite` or `r.actor` draws a copy across each edge.\n\n## Standard features (every game has them: don't build your own)\nWith no code: a **pause menu** on pausable scenes (Resume, Settings, Controls, Full screen, Quit to title; keys, mouse, gamepad and touch), **settings** saved per game (`game.settings`: volume, music, effects, mute, reduce motion, shake and flashes, pixel scaling, a screen filter, the frame rate and its readout), **controls** the player rebinds (conflicts said first; dead zone, invert aim and move, button symbols, vibration; touch button side, size, opacity), **full screen** (a phone's first tap, a top-right button, the menu; turning it off is remembered), a **menu button** at the top right (on a touch screen it stays in play: it is the touch START), a **way out** of every menu screen, the **back gesture** stepping back in the game (`game.back()`) before it leaves the page, **pausing** when the page is hidden or the controller unplugs, and a page set up for phones (safe areas, no scrolling, zooming or pull to refresh on the canvas).\n- Adjust: `new E.Game({ menu: { items: [['Restart', fn]], settings: [{ key: 'hints', label: 'Hints', value: true }, { key: 'difficulty', options: ['Easy', 'Normal', 'Hard'], value: 'Normal' }], controls: { attack: 'Sword', skill: false }, quit: 'title' } })`, then read `game.settings.hints`. Leave parts out: `menu: false` (your own pause), `fullscreen: 'button' | false`, `corner: false`, `backGesture: false`, `autoPause: false`, `touch: 'never'` (a phone is told a controller or keyboard is needed). `game.cornerArea()`: where the corner's buttons cover the screen (or null): keep a HUD clear of it.\n- Save slots (`game.saves`): three slots and an autosave, each with its place, level and time played. `game.saves.write = () => ({ data, place, level })` and `read = save => {...}`; then `save(slot)` (0, 1, 2 or `'auto'`), `load(slot)`, `copy(a, b)`, `erase(slot)`, `autosave()`, `list()`, `latest()` (a title's Continue). `menu: { saves: true }` (or `{ slots, version, migrate(data, from) }`) puts Save (while `saves.canSave`: a save point) and Load in the pause menu, and `saves.show('save' | 'load')` opens the screen from your own menu. Blocked storage keeps them for the visit.\n- Prompts: `game.input.label('jump')` is that action's key or button on the player's device, after rebinding ('Space', 'A', '✕'). PlayStation symbols by default: `settings: [{ key: 'glyphs', value: 'playstation' }]` (a standard key without a label sets its default). A canvas title's OPTIONS: `game.menu('settings')`. From code: `game.settings.set(key, v)`, `game.fullscreen.toggle()` (from a key, click or tap), `game.pause(reason)`, `game.resume()`. `live: true` (or `game.menu(name, { pause: false })`): menus over a world that keeps stepping (online play).\n- **Boot**: heavy setup in steps behind a boot screen, and a report for any error before play: `game.start({ scenes, scene, boot: { title, steps: [['Building the city', () => { map = build(); }]] } })` (`AI_GUIDE.md`, Boot).\n\n## Input: `game.input`\n- Actions in every preset: `up down left right` (WASD, arrows, d-pad), `start` (Enter, Start), `pause` (Escape, P, Start), `confirm` (Enter, Space, J, Z, pad A), `cancel` (Escape, Backspace, X, K, pad B).\n- DEFAULT adds `attack` (J, X, click), `dash` (Space, Shift, K), `skill` (L, E, right click), `jump` (Z). PLATFORMER: `jump` (Space, Z, K, pad A), `attack` (X, J, click), `dash` (Shift, C, L), `skill`. SHMUP: `fire` (Space, Z, J, click), `bomb` (X, K). THIRDPERSON: `sprint` (Shift), `jump` (Space), `crouch` (C, Ctrl), `interact` (E, F), `attack` (J), `block` (K), `dodge` (L), `use` (Q), `map` (M, Tab).\n- `down(a)`, `pressed(a)`, `released(a)`, `repeat(a, delay, rate)` (menus), `buffered(a, win)` + `consume(a)`, `consumeAll()`, `anyPressed()`, `move()` (screen direction `[x, y]`, length up to 1), `use(preset)`, `touchButtons(['jump', 'attack'])`, `touchSet('confirm', 'TALK', near)` (a context button: relabel it, or hide it while it has nothing to do).\n- Moves: `input.motion('236', 'attack', { facing })` is true on the step a quarter circle forward and punch ends (numpad notation, mirrored when `facing` is -1: `'623'`, `'41236'`); `input.sequence(['up', 'up', 'down', 'down+right', 'attack'], { window: .5 })` any run of inputs (a cheat code); `input.history` the last second of them (`{ t, dir, pressed }`, for an input display).\n- Players (two to four on one machine): `game.players` is `[game.input, ...]`, each an input with this API, its `player` number, `name` (`'P2'`), `color` (`E.PLAYER_COLORS`) and device. `game.allowJoin({ max: 2, onJoin: (input, n) => {} })` lets them in: Start on a free gamepad, or 2 on the keyboard (player 2 takes its right half: arrows, `.` `/` `,` and the numpad; player 1 keeps WASD with F G H; a preset's `halves: { left: { pass: ['KeyR'] }, right: {...} }` its own); `game.addPlayer({ pad: 0 })` or `({ keys: 'right' })`, `game.removePlayer(p)`. Prompts, the pause (P2 PAUSED), a lost controller and the Controls screen are per player. One screen: `cam.frame(heroes)`. Split: `game.splitScreen(2, { follow: [h1, h2], layout: 'auto' })` (`'columns'`, `'rows'`, `'grid'`; up to 4) draws the scene once per viewport (`r.viewport` is `{ i, x, y, w, h }`), then `scene.hud(r)` once over the whole screen; `game.viewports[i].follow(t)` or `.focus(x, y)`.\n- `clear()` releases held inputs, pending presses, virtual sticks and touch buttons; focus loss does this automatically. `suppress(a)` blocks an action for the current tick; `suppressCode('Mouse0')` lets a HUD widget consume that mouse button while other devices bound to the action still work.\n- Controller settings: `deadzone` (default `.18`, radial and rescaled), `invertAimY`, `lastDevice` (the index has the rest). The left stick and the touch stick, pushed past halfway, press `up` / `down` / `left` / `right` as the d-pad does (menus, dialog choices, ladders); bind `PadAxisUp/Down/Left/Right` to your own menu actions for the same; the right stick is `PadRAxisUp/Down/Left/Right`, the wheel `WheelUp`/`WheelDown`; `value(a)`: 0 to 1 (a trigger's travel, a stick's push). Options while Create is held is no press (the AI Hub's chord).\n- Touch settings: `touchEnabled`, `stickSide` (`'left'` or `'right'`), `stickRadius` (CSS pixels), `touchFilter(event)` (return false to reserve a canvas tap for UI). `touchArea()`: where the touch buttons cover the screen (`{ x0, y0, x1, y1 }`, or null): keep a prompt clear of it. `clicked()`: where a click or tap on the canvas landed (`[x, y]` in screen pixels) the step after it, else null; `pointer()`: the mouse in screen pixels; `drag()`: how far the stick's finger moved this step (`[dx, dy]`, or null), to steer one to one; `steer = 'drag'`: a finger anywhere steers, no stick drawn (`stickOn`: a finger is on it). `zones = [{ x0, y0, x1, y1, act }]` (fractions of the canvas): a finger in one holds its act until it lifts (a pinball's halves). Gestures (a mouse or one finger, screen pixels): `box()` → `{ x0, y0, x1, y1, done }` (a left drag; on touch a long press, then a drag), `longPress()`, `doubleTap()`, `pan()` → `[dx, dy]` (a finger's drag on open ground, a middle or right drag), `zoomPoint()`; `feed('down' | 'move' | 'up', x, y, { touch, button, id })` plays a pointer in a test. `bindButtons(root)` wires `[data-act]` elements.\n\n## Drawing: `r` in `draw(r)`\n- Background: `r.sky(['#top', '#mid', '#bottom'])`, `r.starfield({ count, speed, dir: 'down' | 'left' })`.\n- Depth sorted: `r.actor(x, y, z, (g, ox, oy) => rig.draw(g, ox, oy, r.view), { flash: '#ffffff', flashMix: .75, alpha, xray, outline, ghost, emissive, every, key })` (the flash tints over the sprite so shading shows: `flashMix` .5 by default, 1 solid; `every: 2, key: npc` redraws a background character every other frame; actors up to about 250 px tall), `r.sprite(x, y, z, sprite, { flip, anchor: 'bottom' | 'center', glow, flash })`, `r.queue(x, y, z, g => {...}, { bias })` (sorted by that one point: a long wall by `r.queueSpan(a, b, z, h, fn)`), `r.actorNow(...)` (as `r.actor`, drawn at once over what is drawn so far), `r.box(g, x0, y0, z0, x1, y1, z1, top, side)` (inside a queue function). `{ pick: unit }` on any of them (and `r.shape`), then `r.pick(sx, sy)` → what the last frame drew under a screen point, front to back.\n- Floor marks: `r.shadow(x, y, radius, alpha, color, surfaceZ)`, `r.decal(g => r.groundArc(...))`, `r.groundDisc`, `r.groundRing`, `r.groundPts(x, y, rad, n, z)`.\n- On top, unlit, screen pixels: `r.text(str, x, y, color, { align, scale, outline })`, `r.textAt(x, y, z, str, color)`, `r.overlay(g => {...})`.\n- `r.w(x, y, z)` = buffer pixel of a world point. `r.W`, `r.H`, `r.ix`, `r.iy` (pass to dither functions), `r.view`, `r.visible(x, y, z)`.\n- X-ray: `r.actor(..., { xray: true })` shows the actor's hidden part, a translucent tint with a 1-px outline (a checker in `E.style.trans = 'dither'`), wherever a wall, a prop or shape at least chest high (22; `hides: true | false` says otherwise) or anything queued with `{ hides: true }` is drawn in front of it; not by one rising less than 8 above its feet (the roof it stands on, a cut-down wall). `xray: { color, outline (false: none), actors: true }`: with `actors` other bodies in front hide it too (a hero stays findable in a crowd). Afterimages: `ghost: { color, life, alpha, owner }`; `owner` (the actor's `{x, y, z}`) keeps a trail left nearer the camera sorted behind the live body.\n- Glowing things you draw yourself: `r.queue(x, y, z, fn, { emissive: true })` is drawn again after lighting so darkness never dims it (flames, lasers, magic, neon). It still hides behind whatever stands in front of it: walls and `r.actor` bodies do this on their own, and any other queued draw can join them with `{ solid: true }`. (Canvas lighting builds a depth-ordered mask for this; `game.r.glowMask = false` skips it on slow machines.)\n\n## Pixels, sprites, text, UI\n- `px.rect(g, x, y, w, h, c)`, `dot`, `line(g, x0, y0, x1, y1, c, width)`, `disc(g, x, y, r, c)`, `ell`, `poly(g, pts, c)`, `polyDither(g, pts, c, 0..1, r.ix, r.iy)`, `ddisc`, `sprite(g, spr, x, y, flip)` (or `{ flip, rot, scale }`), `glow(g, 0..1)` (GPU glow for what follows).\n- Sprites from strings (for coins, bullets, ships, icons, NES-style enemies): `const COIN = E.sprite(['.yy.', 'yYYy', '.yy.'], { y: '#f0b020', Y: '#fff0a0' }, scale)`. `.` and space are transparent. Frames: `const walk = E.anim([f1, f2, f3], 8, { pingpong })` (or one sheet: `E.anim(sheet, 8, { frames: 4 })`), drawn with `r.sprite(x, y, z, walk, { t })`. `r.sprite(..., { rot: angle, scale })` turns and scales in whole pixels (cached in 16 steps a turn; `steps: 32`); `E.recolor(spr, { '#3a8a4a': '#8a3a4a' })` swaps a palette.\n- Font (5x7 proportional with lower case: ASCII, the face buttons, arrows, ★ ♥ ♪ ✓ … ° € £, the accented Latin letters; any other is `?`; `font: 'tiny'` for 3x5): `E.font.text(g, str, x, y, color, { outline, shadow, gradient, scale, align, wrap, font })`, `E.font.title(g, str, x, y, { scale, colors, outline, depth, depthColor, align })`, `E.font.width(str, opts)`, `E.font.lineHeight(opts)`, `E.font.wrap(str, maxW, opts)`. Glyphs: ASCII plus `♥ ★ ← → ↑ ↓ • × ♪ ▸ ©`.\n- UI (inside `r.overlay(g => ...)`): `E.ui.box(g, x, y, w, h, { bg, border, gradient, alpha })` (a gradient window like Final Fantasy; `bg` can be `[top, bottom]`, `gradient: false` for flat, `alpha: .6` for a see-through HUD panel), `E.ui.bar(g, x, y, w, h, 0..1, color)`, `E.ui.hearts(g, x, y, hp, max)` (half hearts allowed), `rig.drawPortrait(g, x, y, size, { zoom: 3, turn: .6, bg, frame, cape: false, weapon: false, tint: '#808080' })` (character close-up; it stays upright while the rig kneels or lies down; `tint` greys out a KO'd hero).\n- Dialog: `const talk = new E.Dialog(game)`; `talk.say(['Line one.', 'Page two.'], { name: 'ELDER', portrait: elderRig, onDone, choices: ['YES', 'NO'], onChoice(i) })` (choices show on the last page: the keys, or a tap or click on one, pick); in update `if (talk.update(dt)) return;` (true while a modal box is open: play waits); in draw `talk.draw(r)`. `portrait` takes a Humanoid (live close-up; `portraitSize: 40`, `portraitOpts: { zoom, turn }`) or a function `(g, x, y, size) => {...}`. Radio chatter during play: `talk.say('Enemy fighters ahead!', { name, portrait, auto: 2.5, modal: false })` turns its pages and closes by itself while the game keeps running. Per line: `place: 'top' | 'middle' | 'bottom'`, `y` (pixels) and `alpha` (see-through box). `new E.Dialog(game, { speed, lines, color, nameColor, voice, width, bg, border, vars })` (`voice`: a sound, or `(ch, i, talk) => {}` per letter); `talk.close()`, `talk.open`. Markup in the text: `{c=#ffd36a}gold{/c}` a color, `{w=.5}` a pause, `{s=12}slowly{/s}` letters a second, `{shake}..{/shake}`, `{wave}..{/wave}`, `{$name}` a value from `say(text, { vars })` or `talk.vars`.\n- Menu: `const menu = new E.Menu(game, ['START', { label: 'LOAD', disabled: true }], { x: 'center', y: 100, title, onPick(i, item), onCancel, scale: 2, rows: 6 })` (rows: it scrolls); `menu.update(dt)`; `menu.draw(r)`. Keys, d-pad and sticks move it; a click or tap on an entry picks it (so a phone can leave a title), and the mouse over one moves the cursor. A tap on a dialog box turns its page as confirm does.\n- HTML screens and HUD: `const ui = new E.Shell(game, { theme: { scale: 2 } (a TV; or `tv: true`), settings, screens: { pause, help, dev: { rows: ['glyphs'] } } })`; `ui.show('title' | 'results' | 'map' | ..., spec)`; each step `ui.hud({ objective, status, bars, prompt, minimap })` (`minimap: { map, fog, camera: true, markers, onClick(x, y) }`); `ui.toast(title, text)`.\n\n## Sound: `game.audio` (chip synth, no files, starts after the first key press)\n- `sfx(name, { vol, pitch, pan, loop })` → `{ stop(), set({ pan, vol }) }` (a loop sounds on: an engine, rain). Presets: `jump jump2 land step coin pickup key powerup oneup heal hit hurt stomp bump swing whoosh punch kick shoot laser charge explode boom door secret warp die select confirm cancel pause text blip`.\n- Custom: `sfx({ wave: 'square' | 'pulse' | 'pulse12' | 'triangle' | 'saw' | 'sine' | 'noise', freq: 440 or 'A4', to: 880, dur: .2, vol: .3, arp: [0, 4, 7], step: .05, vib: [8, .03] })`, or `audio.define('zap', voice)`; `audio.instrument('pluck', (ctx, bus, time, freq, dur, vol) => ...)` is a `wave` too.\n- Music: `music('title' | 'adventure' | 'dungeon' | 'boss' | 'victory')` (built in; any other name warns and plays nothing), or your own `{ bpm: 120, steps: 4, tracks: [{ wave: 'square', vol: .15, notes: 'C5 - E5 - G5 . . . | ...' }, { wave: 'triangle', notes: '...' }, { wave: 'drums', notes: 'k . h . s . h .' }] }`. Tokens: a note (`C4`, `F#3`, `Bb2`), `-` holds, `.` rests, `|` is ignored; drums `k s h o c t`. `music(null)` stops. `mute()`, `setVolume(0..1)` (or set `audio.musicVolume`, `sfxVolume`, then `audio.applyVolume()`), `duck(on)` (quieter music under your own pause or map screen). Your own Web Audio connects to `audio.bus('sfx' | 'music' | 'voice')`, under the volume and mute.\n- The music clock (the full engine): a song's place is game time, headless too, and the sound follows it. `music(song, { sync: true })` pauses with the game (else it plays on); `audio.pos` → `{ t, step, beat, bar, at, loop, bpm, layers, playing }`; `at(step, fn)`, `onBeat(fn)` (on the update step); `tempo(bpm)`; `layer(name or index, vol, fade)` (a track's `name`, `on: false` starts it silent: the chase's drums in by layers); `music(song, { fade: 1 })` crossfades; `sting(song, { at: 'bar' })` over the music; `sfx(voice, { step })` on a step of the music. `settings.audioOffset` (ms, Settings, Sound: Calibrate) sets `audio.offset`; `audio.calibrate()` → `{ tap(), result, done, stop() }`.\n\n## Levels\n**TileMap** (top-down, isometric, brawler): walls stand on the ground plane.\n- `new E.TileMap({ rows, legend, types, floorTex, block: ['water', 'lava'], ao: 5, outside })` (`ao` = width of the contact shadow along wall bases, 0 = none; `outside`: the ground past the map, a color, or `false` for none). `types[id] = { h, top, side, line, course, cut: true, cutH, face, roof, beam }` (`cut` lowers walls that block the camera, those `map.isFront(cx, cy, view)` says; a map may replace it; `face`: `'brick'` (default) `'stone' 'rock' 'plank' 'timber' 'plaster' 'hedge' 'none'`; `roof`: `'speckle'` (default) `'plain' 'tiles' 'slab' 'leaves' 'grass'`; `beam` = timber color). `floorTex(x, y, floorTag, view)` returns `[r, g, b]` (or `[r, g, b, glow]`); ready-made: `E.tex.flagstone`, `grass`, `dirt`, `water`, `planks`, `checker`, `plain`. A map of more than 128 x 128 cells bakes its floor in squares as the camera comes to them and lets the far ones go (`chunks: true | false` to choose; `map.floorBytes()` what it holds), so a 256 x 256 world map costs what the screen shows.\n2803:        if (live) BOOT._step(i, n, label);\n2806:        if (r && typeof r.then === 'function') { r.then(() => { ok(); live ? requestAnimationFrame(next) : next(); }, e => fail(label, e)); return; }\n2807:        ok(); if (live) { requestAnimationFrame(next); return; }   // one step a frame: the screen shows each\n2809:      if (live && o.min && now() - t0 < o.min * 1000) { requestAnimationFrame(next); return; }\n2810:      if (live) BOOT._step(n + 1, n + 1, 'Warming up');\n2837:   * run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and\n2846:    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n2866:        for (let i = 0; i < k; i++, n++) this._step(h);\n2868:      if (!n && !this._stepped) { n++; this._step(0); }   // the first frame updates before it draws, even when its time is short\n2932:  _step(dt) {\n2939:    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n2992:  _frame() {\n3319:  _step(k, n, label) {\n3372:  const n = J.length; for (let i = 0; i < n; i++) if (!J[i].done) J[i]._step(dt);\n3388:  _step(dt) {\n3435:  _step(dt) { if (!this._w || this._w(dt)) this._go(); }\n8009:  _frame(perf) {\n9805:  _step() {\n10403:  if (typeof window === 'undefined' || typeof requestAnimationFrame !== 'function') return S;\n10416:  const realNow = performance.now.bind(performance), realDate = Date.now, realRAF = requestAnimationFrame.bind(window);\n10496:  // the frame loop: requestAnimationFrame callbacks run with the frame's time, the same way in both\n10498:  window.requestAnimationFrame = cb => { const id = ++ids; queue.push([id, cb]); if (!R && !pending) { pending = true; realRAF(tick); } return id; };\n12270:  _step(a, b, o, end) {\n12288:        if (!this._step(c, n, o, key(n) === goal)) continue;\n12305:        if (!this._step(c, n, o)) continue;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"ls src && sed -n '2930,2965p' vendor/engine/my-3d2dge.js && sed -n '260,350p' src/online.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"ls src && sed -n '2930,2965p' vendor/engine/my-3d2dge.js && sed -n '260,350p' src/online.js\"","aggregated_output":"content.js\nonline.js\npersistence.js\nsim.js\nview.js\n    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n    if (c.type === 'stone') choiceSequence = seq;\n    if (!isHost && (c.type === 'release' || c.type === 'cancel')) {\n      const p = app.world.players[localSeat]; p.charge = null; p.held = false; p.buffer = false;\n    }\n    if (isHost) validateCommand(data, info.me);\n    else enqueue(data, { to: info.host, critical: c.type === 'release' || c.type === 'cancel' });\n    return true;\n  }\n\n  function publishEvents() {\n    const all = (app.world.events || []).filter((e) => e.id > lastEventId);\n    if (!all.length) return;\n    const ev = all.slice(-48).map((e) => {\n      const out = { id: e.id, type: e.type };\n      for (const key of ['seat', 'x', 'z', 'target', 'count', 'stone', 'throwId', 'reason', 'winner']) if (e[key] !== undefined) out[key] = typeof e[key] === 'number' ? q(e[key]) : e[key];\n      return out;\n    });\n    lastEventId = all[all.length - 1].id;\n    enqueue({ t: 'ev', v: PROTOCOL, e: ev }, { reliable: true });\n    lastEventsAt = clock();\n  }\n\n  function chooseTimeout() {\n    const w = app.world;\n    if (w.outcome) return;\n    const a = health(w, 0), b = health(w, 1);\n    const winner = Math.abs(a - b) > 1e-8 ? (a > b ? 0 : 1) : w.players[0].score === w.players[1].score ? -1 : w.players[0].score > w.players[1].score ? 0 : 1;\n    w.outcome = { winner, reason: 'time', scores: w.players.map((p) => p.score), banked: w.players.map((p, i) => i === winner ? p.score * w.bout : 0) };\n    w.phase = 'over';\n  }\n\n  function finish() {\n    if (!isHost || finished || ended) return;\n    finished = true;\n    app.world.players.forEach((_, seat) => simCommand(app.world, seat, { type: 'cancel' }));\n    receivedBegin.clear(); localBegin = null;\n    const w = app.world;\n    const present = ids.filter((id) => !gone.has(id));\n    const winId = w.outcome?.winner >= 0 ? ids[w.outcome.winner] : null;\n    const standings = winId === null || !present.includes(winId) ? [present] : [[winId], present.filter((id) => id !== winId)].filter((g) => g.length);\n    finishPayload = { standings, scores: Object.fromEntries(ids.map((id, i) => [id, w.players[i].score])) };\n    publishEvents();\n    enqueue(makeSnapshot(), { reliable: true, critical: true });\n    endAfterFlush = true;\n    flush();\n    app.screen = 'result';\n  }\n\n  function finishNow() {\n    if (!endAfterFlush || ended || !finishPayload) return;\n    endAfterFlush = false;\n    diagnostics.finishCalls++;\n    hub.finish(finishPayload);\n  }\n\n  function end(reason) {\n    if (ended) return;\n    ended = true; diagnostics.ended = true;\n    pending.length = 0; localBegin = null; localChoice = null; receivedBegin.clear();\n    app.hubEnded = true; app.hubEndReason = reason || 'finished';\n    app.world.players.forEach((p) => { p.charge = null; p.held = false; p.buffer = false; });\n    app.caption = reason === 'host-left' ? 'The host departed. The court is void.' : 'The round has ended.';\n    app.audio?.stop?.(); app.input?.clear?.();\n  }\n\n  unsub.push(hub.on('start', () => {\n    if (ended) return;\n    started = true; diagnostics.started = true;\n    app.caption = 'Hold Fire to wind. Release to throw. Break the opposing castle!';\n    if (isHost) publishBaseline();\n  }));\n  unsub.push(hub.on('message', (data, from) => {\n    if (ended || !data || typeof data !== 'object') return;\n    diagnostics.received++;\n    if (isHost && data.t === 'c') validateCommand(data, from);\n    else if (isHost && data.t === 'ack' && seats.has(from)) {\n      lastAck.set(from, { bv: data.bv, n: data.n }); diagnostics.baselineAcks++;\n    } else if (!isHost && from === info.host) {\n      if (data.t === 'base') receiveBaseline(data);\n      else if (data.t === 's') applySnapshot(data);\n      else if (data.t === 'ev' && data.v === PROTOCOL && Array.isArray(data.e)) {\n        const fresh = data.e.filter((e) => Number.isInteger(e.id) && e.id > receivedEventId).slice(-48);\n        if (fresh.length) {\n          receivedEventId = fresh[fresh.length - 1].id;\n          app.world.events = [...(app.world.events || []), ...fresh].slice(-200);\n        }\n      }\n    }\n  }));\n  unsub.push(hub.on('leave', ({ id }) => {\n    if (ended) return;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\nimport {createWorld,command,step,finish,resetCastles,DEFAULTS,DT,health,planShot} from './sim.js';\nimport {COURTS,RIVALS} from './content.js';\nimport {load,save} from './persistence.js';\nimport {createView} from './view.js';\nimport {createAudio} from './audio.js';\nimport {createUI} from './ui.js';\nimport {createInput} from './input.js';\nimport {connectOnline} from './online.js';\nimport metadata from '../metadata.json' with {type:'json'};\nexport function createRuntime(options={}){\n const E=globalThis.My3D2dge;const headless=\"'!!options.headless;\n const initial=load(options.storage);\n const game=new E.Game({canvas:'\"'screen',res:[640,360],expand:true,view:'side',input:{},menu:false,corner:false,autoPause:false,backGesture:false,fullscreen:false,live:true,headless,draw:headless?\"'!!options.draw:undefined,loop:options.loop===false?false:undefined,id:'\"'smithereen-royal-rumble'});\n game.input.touchEnabled=false;game.input.touchButtons([]);game.settings.set('glyphs','playstation');game.settings.set('music',.1);game.cam.smooth=0;game.fadeTime=0;\n const app={game,metadata,world:createWorld({mode:'title',court:4}),screen:'title',mode:'title',focus:0,menu:[],settings:initial.settings,savedTour:initial.tour,tour:null,idle:0,device:'keyboard',caption:'',captionUntil:0,online:null,hubEnded:false,dev:{speed:1,step:false,paused:false,collision:false,support:false,prediction:false,invulnerable:false},lesson:null,teachingSkipped:false,_accounted:null,_resultAt:null,_lastEvent:0,_attractStage:0,_attractSince:0,_tourHistory:[],_headless:headless,storage:options.storage};\n app.message=(text,seconds=4)=>{app.caption=String(text);app.captionUntil=game.real+seconds;};\n app.saveSettings=()=>{save(app.settings,app.savedTour,app.storage);app.audio?.setVolumes(app.settings);game.settings.set('glyphs',app.settings.glyphs==='Xbox'?'xbox':'playstation');game.settings.set('reduceMotion',app.settings.reducedMotion);};\n app.setScreen=name=>{if(app.hubEnded)return;app.screen=name;app.focus=0;app.idle=0;app.ui?.refresh();};\n app.command=(seat,c)=>{if(app.hubEnded)return false;if(app.mode==='hub')return app.online?.command(seat,c)||false;if(app.screen\"'!=='\"'play'&&app.mode\"'!=='\"'attract')return false;return command(app.world,seat,c);};\n const cancelAll=()=>{app.input?.clear();for(let s=0;s<2;s++){if(app.mode==='hub')app.online?.command(s,{type:'cancel'});else command(app.world,s,{type:'cancel'});}};\n app.title=()=>{if(app.mode==='hub')return;cancelAll();app.audio?.stop();app.view?.clear();app.mode='title';app.world=createWorld({court:4,mode:'title'});app.caption='';app.idle=0;app.dev.speed=1;app.dev.paused=false;app.tour=null;app.setScreen('title');app._lastEvent=0;};\n app.start=(mode='quick',o={})=>{\n  if(app.mode==='hub'&&\"'!o.hosted)return;\n  cancelAll();app.audio?.stop();app.view?.clear();app.game.paused=false;app.mode=mode;app.hubEnded=false;app.dev={...app.dev,speed:1,step:false,paused:false,invulnerable:false};\n  let bout=Number(o.bout)||1,court=Number(o.court)||0,seed=Number(o.seed)||Math.floor(Math.random()*2147483646)+1;\n  if(mode==='\"'solo'){\n   if(o.resume&&app.savedTour){app.tour=JSON.parse(JSON.stringify(app.savedTour));bout=app.tour.next;seed=app.tour.seed;}\n   else if(o.continue&&app.tour){bout=app.tour.next;seed=app.tour.seed;}\n   else{app.tour={next:bout,totals:[0,0],seed,cheated:false};app._tourHistory=[];}\n   court=Math.floor((bout-1)/2);\n  }else if(mode==='local'&&o.war){if(o.continue&&app.tour){bout=app.tour.next;seed=app.tour.seed;}else app.tour={next:bout,totals:[0,0],seed,local:true,cheated:false};court=Math.floor((bout-1)/2);}\n  const ai=mode==='local'?[null,null]:mode==='attract'?[{style:'mason',reaction:.5,error:.005},{style:'harasser',reaction:1.15,error:.02}]:[null,mode==='solo'?RIVALS[bout-1]:o.difficulty==='Easy'?{style:'mason',reaction:2.2,error:.06}:o.difficulty==='Hard'?{style:'adaptive',reaction:.9,error:.018}:{style:'adaptive',reaction:1.5,error:.035}];\n  const config={...DEFAULTS,chargeTime:app.settings.tension};app.world=createWorld({mode,court,bout,seed:seed+bout*7919,ai,config,available:mode==='solo'&&bout<=2?[0]:mode==='solo'&&bout<=4?[0,1]:[0,1,2]});\n  app._options={...o,court,bout,seed,war:mode==='local'&&\"'!!app.tour};app._accounted=null;app._resultAt=null;app._lastEvent=0;app.lesson=mode==='\"'solo'&&bout===1&&\"'!app.teachingSkipped?{phase:0}:null;app.setScreen('\"'play');\n  if(mode==='solo'){app.savedTour={...app.tour};save(app.settings,app.savedTour,app.storage);app.message(RIVALS[bout-1].name+': “'+RIVALS[bout-1].boast+'”',4);}\n  else if(mode==='attract'){app._attractSince=game.real;app._attractStage=0;app.message('EXHIBITION • Any input returns to the court menu',100);}\n  else app.message(COURTS[court].subtitle,3);\n };\n app.pause=()=>{if(app.hubEnded||app.mode==='attract')return;if(app.screen==='play'){cancelAll();app.setScreen('pause');app.message(app.mode==='hub'?'The shared court keeps playing.':'A brief sporting intermission.');}else app.ui?.back();};\n app.resume=()=>{if(app.hubEnded)return;cancelAll();app.game.paused=false;app.setScreen('play');};\n app.advance=()=>{\n  if(app.mode==='hub'||\"'!app.world.outcome)return;\n  if(app.tour){if(app.tour.next>10){app.setScreen('\"'championship');return;}const mode=app.mode;app.start(mode,{...app._options,continue:true,bout:app.tour.next,war:mode==='local'});}\n  else app.start(app.mode,{...app._options,seed:undefined});\n };\n app.restart=()=>{if(app.mode==='hub')return;const t=app.tour;const prior=app._options;app.start(app.mode,{...prior,continue:\"'!!t,bout:app.world.bout});if(t){app.tour=t;app.tour.next=app.world.bout;app.world.cheated=true;app.tour.cheated=true;}};\n app.restore=()=>{if(app.mode==='\"'hub')return;resetCastles(app.world);app.world.phase='play';app.world.outcome=null;app._accounted=null;app._resultAt=null;};\n app.forceResult=winner=>{if(app.mode==='hub')return;app.world.cheated=true;finish(app.world,winner,'forfeit');};\n app.resetTuning=()=>{if(app.mode==='hub')return;const w=app.world;w.config={...DEFAULTS,chargeTime:app.settings.tension};w.cheated=true;};\n app.skipTeaching=()=>{app.teachingSkipped=true;app.lesson=null;app.message('Lesson skipped. Lower their skyline\"'!'\"');};\n app.playLesson=()=>{app.teachingSkipped=false;app.start('solo',{bout:1,seed:88417});};\n app.snapshot=()=>({screen:app.screen,mode:app.mode,world:{tick:app.world.tick,time:app.world.time,court:app.world.court,bout:app.world.bout,phase:app.world.phase,health:[health(app.world,0),health(app.world,1)],scores:app.world.players.map(p=>p.score),shots:app.world.stats.shots,outcome:app.world.outcome},tour:app.tour,lesson:app.lesson,device:app.device,errors:game.errors,online:app.online?.diagnostics()});\n app.update=(dt)=>{\n  if(app.hubEnded){app.audio?.stop();return;}\n  app.input?.update(dt);\n  if(app.mode==='hub'){app.online?.update(dt);}\n  else if(app.mode==='attract'){\n   if(app.world.phase==='play')step(app.world,dt);const age=game.real-app._attractSince;\n   const p=app.world.players[0];if(age>8&&age<17&&app._attractStage===0){command(app.world,0,{type:'cancel'});p.ai={style:'broad',reaction:.5,error:0,next:app.world.time+.2};app.world.available=[2];app._attractStage=1;}\n   if(age>17&&app._attractStage===1){app.world.available=[0,1,2];p.ai={style:'harasser',reaction:.5,error:0,next:app.world.time+.2};app._attractStage=2;}\n   if(app.world.phase==='over'&&age>6){if(\"'!app._resultAt)app._resultAt=game.real;if(game.real-app._resultAt>3){const court=(app.world.court+1)%5;app.start('\"'attract',{court,seed:88417+court});}}\n   if(age>=90)app.start('attract',{court:(app.world.court+1)%5,seed:88417});\n  }else if(app.screen==='play'&&app.world.phase==='play'){\n   app.world.invulnerable=\"'!!app.dev.invulnerable;if(!app.dev.paused||app.dev.step){const count=app.dev.step?1:Math.max(1,Math.round(app.dev.speed||1));for(let i=0;i<count&&app.world.phase==='\"'play';i++)step(app.world,DT);app.dev.step=false;}\n  }else if(app.dev.step&&app.mode\"'!=='\"'title'&&app.world.phase==='play'){step(app.world,DT);app.dev.step=false;}\n  if(app.lesson&&app.mode==='solo'){\n   if(app.lesson.phase===0&&app.world.stats.shots[0]>0){app.lesson.phase=1;app.message('A fine fling\"'! Land an actual hit on the opposing castle.'\"',6);}\n   if(app.lesson.phase<2&&app.world.players[0].score>0){app.lesson.phase=2;app.message('A sporting hit\"'! Follow the changing silhouette. The last pennant remembers your range.'\"',6);}\n  }\n  if(app.mode\"'!=='\"'hub'&&app.mode\"'!=='\"'attract'&&app.mode\"'!=='\"'title'&&app.world.phase==='over'){\n   if(app._accounted\"'!==app.world){app._accounted=app.world;app._resultAt=game.real;cancelAll();if(app.tour){const out=app.world.outcome;app.tour.totals=app.tour.totals.map((n,s)=>n+out.banked[s]);app.tour.next=app.world.bout+1;app.tour.cheated ||= app.world.cheated;app._tourHistory.push({bout:app.world.bout,court:app.world.court,...out,stats:JSON.parse(JSON.stringify(app.world.stats))});if(app.mode==='\"'solo'){app.savedTour=app.tour.next<=10?JSON.parse(JSON.stringify(app.tour)):null;save(app.settings,app.savedTour,app.storage);}}}\n   if(app.screen==='play'&&game.real-app._resultAt>=1.7)app.setScreen('result');\n  }\n  if(['title','setup','settings','controls','about'].includes(app.screen)&&app.mode==='title'&&\"'!app.online){app.idle+=dt;if(app.idle>=10-1e-8)app.start('\"'attract',{court:0,seed:88417});}\n  if(app.captionUntil&&game.real>app.captionUntil&&app.mode\"'!=='\"'attract')app.caption='';\n  app.view?.update(dt,app);app.audio?.update(dt,app);app.ui?.update(dt);\n };\n if(\"'!headless){app.view=createView(E,game);app.audio=createAudio(E,game);app.ui=createUI(E,game,app);app.input=createInput(E,game,app,app.ui,app.view);app.saveSettings();}\n game.debug={snapshot:app.snapshot};\n game.start({scene:'\"'rumble',scenes:{rumble:{view:'side',res:[640,360],expand:true,pausable:false,camera:{zoom:false},update:app.update,draw(r){app.view?.draw(r,app);app.ui?.draw(r);}}}});\n app.dispose=()=>{app.online?.dispose();app.input?.dispose();app.audio?.stop();app.ui?.dispose?.();game.dispose();};\n return app;\n}\nexport async function boot(){const app=createRuntime();globalThis.__rumble=app;globalThis.__game={game:app.game};\n if(globalThis.AIHub?.active){app.online=await connectOnline(app);if(\"'!app.online)app.title();}\n else app.title();\n app.ui?.refresh();return app;\n}\nif(typeof document!=='\"'undefined')boot().catch(error=>{console.error(error);const el=document.getElementById('boot-error');if(el){el.hidden=false;el.textContent='The court could not open: '+error.message;}});\nEOF\ncat > scripts/build.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nimport {build} from 'esbuild';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nconst project=JSON.parse(fs.readFileSync(path.join(root,'project.json'),'utf8'));\nconst bundle=await build({entryPoints:[path.join(root,'src/main.js')],bundle:true,format:'iife',target:'es2022',write:false,legalComments:'none',minify:false});\nconst engine=fs.readFileSync(path.join(root,'vendor/engine/my-3d2dge.js'),'utf8');\nconst hub=fs.readFileSync(path.join(root,'vendor/hub/session.js'),'utf8');\nif(/<\\\\/script/i.test(hub))throw new Error('Released client contains unsafe script terminator');\nconst safe=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst html=\"'`<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<meta name=\"hub:protocol\" content=\"1\"><meta name=\"hub:session-players\" content=\"2-2\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:mode\" content=\"shared-world\"><meta name=\"hub:round-duration\" content=\"180\"><meta name=\"hub:round\" content=\"180\"><meta name=\"hub:goal\" content=\"Demolish the opposing castle. At three minutes: castle health percentage, then direct score.\"><meta name=\"hub:howto\" content=\"Hold Cross or Space to wind, release to throw. L1/R1 or Q/E choose stones. Interrupt crew or launcher; break supports.\">\n<title>${project.title}</title><style>html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#141d28;color:#f7e7bd;font-family:Georgia,serif;touch-action:none;overscroll-behavior:none}canvas#screen{display:block;width:100%;height:100%;image-rendering:pixelated;outline:none}#boot-error{position:fixed;inset:20%;z-index:999;background:#231d30;padding:32px;font-size:24px}button,input,select{font:inherit}*:focus-visible{outline:3px solid #f5ca6b;outline-offset:3px}</style></head><body><canvas id=\"screen\" tabindex=\"0\" aria-label=\"Smithereen Royal Rumble battlefield\"></canvas><p id=\"boot-error\" hidden></p><script>${safe(engine)}</script><script>${safe(bundle.outputFiles[0].text)}</script></body></html>`;\nfs.writeFileSync(path.join(root,'\"'index.html'),html);\nconst output=path.join(root,'..',project.basename+'.html');fs.writeFileSync(output,html);\nfs.copyFileSync(path.join(root,'metadata.json'),path.join(root,'..','exit-interview.json'));\nfs.writeFileSync(path.join(root,'artifacts/build.json'),JSON.stringify({title:project.title,output:path.basename(output),bytes:Buffer.byteLength(html),engine:'0.89.1',hub:'1.4.0'},null,2)+'\\\\n');\nconsole.log(\"'`Built ${path.basename(output)} (${Buffer.byteLength(html)} bytes)`);\nEOF\npython3 - <<'\"'PY'\np='src/persistence.js';s=open(p).read().replace('readStorage(storage=globalThis.localStorage){try{','readStorage(storage){try{storage??=globalThis.localStorage;').replace('save(settings,tour,storage=globalThis.localStorage){try{','save(settings,tour,storage){try{storage??=globalThis.localStorage;');open(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":null