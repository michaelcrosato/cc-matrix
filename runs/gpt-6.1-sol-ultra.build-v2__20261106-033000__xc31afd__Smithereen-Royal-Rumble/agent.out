.material==='wood'){px.line(g,x+2*S,y+bh-3*S,x+bw-2*S,y+2*S,'#d6ac6f',Math.max(1,Math.round(S*2)));px.dot(g,x+3*S,y+3*S,'#4b4146');px.dot(g,x+bw-4*S,y+bh-4*S,'#4b4146');}\n        if(frac<.75){px.line(g,x+bw*.53,y+1,x+bw*.42,y+bh*.42,'#554a4e');px.line(g,x+bw*.42,y+bh*.42,x+bw*.65,y+bh*.7,'#554a4e');if(frac<.4){px.line(g,x+bw*.42,y+bh*.42,x+bw*.2,y+bh*.6,'#4d444b',2);px.line(g,x+bw*.65,y+bh*.7,x+bw*.51,y+bh,'#4d444b',2);}}\n        if(b.z<=60&&b.id%3===0){const T=TEAMS[b.seat];px.rect(g,x+bw*.35,y+2*S,Math.max(2,bw*.3),Math.max(3,bh-4*S),T.dark);px.rect(g,x+bw*.43,y+2*S,Math.max(1,bw*.12),Math.max(2,bh-5*S),T.color);}\n      },{bias:.01});\n    }\n    for(let seat=0;seat<2;seat++) {\n      const blocks=w.blocks.filter(b=>b.alive&&b.seat===seat&&!b.foundation),top=blocks.reduce((n,b)=>Math.max(n,b.z+b.h),70),x=seat?596:44;\n      r.queue(x,-1,40,g=>flag(g,r,x,Math.max(85,top-4),seat,w.phase==='over'&&w.outcome?.winner!==seat),{bias:-.02});\n    }\n    if(app.debugCollision||app.showCollision||app.dev?.collision||app.dev?.support)r.overlay(g=>{\n      for(const b of w.blocks)if(b.alive){const [x,y]=r.w(b.x,0,b.z+b.h),W=b.w*S,H=b.h*S,c=b.foundation?'#e6cb7b':'#86e7bc';px.line(g,x,y,x+W,y,c);px.line(g,x,y,x,y+H,c);px.line(g,x+W,y,x+W,y+H,c);px.line(g,x,y+H,x+W,y+H,c);for(const id of b.supports||[]){const q=w.blocks.find(s=>s.id===id);if(q?.alive)lineWorld(g,r,b.x+b.w/2,b.z+b.h/2,q.x+q.w/2,q.z+q.h/2,'#efb1ef');}}\n    });\n    if(app.editorBlocks)r.overlay(g=>{\n      for(const b of app.editorBlocks){if(!b.alive)continue;const [x,y]=r.w(b.x,0,b.z+b.h),bw=b.w*S,bh=b.h*S,selected=b.id===app.editorSelection,C=selected?'#fff1a2':'#91b2bd';px.blend(g,selected?.35:.12,'normal',()=>px.rect(g,x,y,bw,bh,C));px.line(g,x,y,x+bw,y,C,selected?2:1);px.line(g,x,y,x,y+bh,C,selected?2:1);px.line(g,x+bw,y,x+bw,y+bh,C,selected?2:1);px.line(g,x,y+bh,x+bw,y+bh,C,selected?2:1);if(selected){E.font.text(g,'#'+b.id,x+bw/2,y-11,C,{align:'center',outline:false,shadow:'#26313d'});for(const id of b.supports||[]){const q=app.editorBlocks.find(s=>s.id===id);if(q)lineWorld(g,r,b.x+b.w/2,b.z+b.h/2,q.x+q.w/2,q.z+q.h/2,'#efb1ef',2);}}}\n    });\n  }\n  function draw(r) {\n    if (app.mode === 'attract') r.overlay(g => {\n      E.ui.box(g, r.W / 2 - 126, 18, 252, 29, { bg: '#081c2b', border: '#f4cf78' });\n      E.font.text(g, 'THE ROYAL EXHIBITION', r.W / 2, 24, '#f4cf78', { align: 'center', outline: false });\n      E.font.text(g, 'ANY INPUT TO TAKE THE FIELD', r.W / 2, 35, '#fff4d8', { align: 'center', outline: false });\n    });\n    if (app.screen === 'author' && editor) {\n      const b = authorBlock(); app.editorSelection = b?.id; app.editorBlocks = editor;\n    } else { app.editorSelection = null; app.editorBlocks = null; }\n    lastDrawMenu = app.menu;\n  }\n  function dispose() { shell.dispose(); style?.remove(); menuButton?.remove(); }\n  const api = { shell, update, draw, refresh, back, open, navigate, confirm: () => activate(), adjust, pointer, rebind, selectWorldBlock, dispose, keyName };\n  app.openScreen = open;\n  refresh();\n  return api;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_82","type":"agent_message","text":"The last visual review caught a rendering error when leaving the court editor. A queued overlay was reading editor data after the next screen cleared it. I’m fixing that transition and adding an assertion against the engine’s captured errors, which ordinary browser-error checks had missed.\n"}}
