{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/ui.js';s=open(p).read()\ns=s.replace(\\\"Q / E or wheel: change stone. C or right mouse: cancel.\\\", \\\"\"'${keyName(app.settings.prev1 || '\"'KeyQ')} / \"'${keyName(app.settings.next1 || '\"'KeyE')} or wheel: change stone. C or right mouse: cancel.\\\")\ns=s.replace(\\\"Right seat: \"'${keyName(app.settings.fire2)}, U / O.\", \"Right seat: ${keyName(app.settings.fire2)}, ${keyName(app.settings.prev2 || '\"'KeyU')} / \"'${keyName(app.settings.next2 || '\"'KeyO')}.\\\")\ns=s.replace(\\\"const reserved = ['Escape', 'Enter', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'];\\\", \\\"const reserved = ['Escape', 'Enter', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'KeyC'];if(\"'!/''^(Space|ShiftLeft|ShiftRight|ControlLeft|ControlRight|Key[A-Z]|Digit[0-9]|Numpad[0-9])$/.test(code)){status='\"'Choose a letter, number, Space, Shift, or Control key.';refresh();return true;}\\\")\nopen(p,'w').write(s)\np='src/persistence.js';s=open(p).read().replace(\\\"ShiftLeft|Key[A-Z]|Digit[0-9]|Enter|ControlRight\\\", \\\"ShiftLeft|Key[A-Z]|Digit[0-9]|Numpad[0-9]|ControlLeft|ControlRight\\\")\ns=s.replace(\\\"if(settings.fire1===settings.fire2)settings.fire2=settings.fire1==='ShiftRight'?'Space':'ShiftRight';\\\", \\\"const used=new Set(['KeyC']);for(const key of ['fire1','fire2','prev1','next1','prev2','next2']){if(used.has(settings[key]))settings[key]=[SETTING_DEFAULTS[key],'Space','ShiftRight','KeyF','KeyG','KeyH','KeyJ','KeyK','KeyL'].find(code=>\"'!used.has(code));used.add(settings[key]);}\")\nopen(p,'\"'w').write(s)\np='tests/verify.mjs';s=open(p).read().replace(\\\"import {runViewChecks} from './view-browser.mjs';\\\", \\\"import {runViewChecks} from './view-browser.mjs';\\\\nimport {runViewHeadlessChecks} from './view-headless.mjs';\\\")\ns=s.replace(\\\"['simulation',runSimulation],\\\", \\\"['simulation',runSimulation],['native draw',async()=>{const r=await runViewHeadlessChecks();return {checks:r.count,failures:r.failures};}],\\\")\nopen(p,'w').write(s)\nPY\nnode --check src/ui.js && node --check src/main.js && node --check tests/verify.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
