t.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]});page.wait_for_timeout(100)\n check(page.evaluate('window.__rumble.world.stats.shots[0]')==1,'touch release fires once')\n page.wait_for_timeout(1000)\n page.evaluate('''() => {const c=window.__rumble.game.screen.canvas; c.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,pointerId:42,pointerType:'touch',clientX:80,clientY:650,button:0})); c.dispatchEvent(new PointerEvent('pointercancel',{bubbles:true,pointerId:42,pointerType:'touch'})); c.dispatchEvent(new PointerEvent('pointerup',{bubbles:true,pointerId:42,pointerType:'touch',button:0}));}''')\n page.wait_for_timeout(100)\n check(page.evaluate('window.__rumble.world.stats.shots[0]')==1,'pointer cancellation emits no shot')\n page.touchscreen.tap(380,30);page.wait_for_timeout(80)\n phone.close();browser.close()\nif failures:\n for error in failures: print('FAIL:',error)\nprint(f'{checks} checks, {len(failures)} failures')\nsys.exit(bool(failures))\nconst python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfor(const [name,script,args]of[['UI and devices','tests/ui-input.py',[]],['Hub browser','tests/hub-browser.py',[path.join(root,'..',JSON.parse(fs.readFileSync('project.json')).basename+'.html')]],['Browser and audio','tests/browser.py',[]]]){\n if(!fs.existsSync(script)){results.push({name,checks:1,failures:['Missing required runner '+script]});continue;}\n const r=spawnSync(python,[script,...args],{cwd:root,encoding:'utf8',timeout:300000,maxBuffer:1048576});const output=(r.stdout||'')+'\\n'+(r.stderr||'');const match=[...output.matchAll(/(\\d+) checks, (\\d+) failures/g)].at(-1);const failures=[];if(r.status!==0||!match||Number(match[2])>0)failures.push(output.trim()||String(r.error||'Browser runner failed'));results.push({name,checks:match?Number(match[1]):1,failures});\n}\ntry{const r=await runViewChecks();results.push({name:'Native presentation',checks:r.count,failures:r.failures});}catch(e){results.push({name:'Native presenta