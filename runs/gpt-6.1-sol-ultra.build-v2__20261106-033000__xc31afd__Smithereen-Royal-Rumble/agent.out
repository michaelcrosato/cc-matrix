{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"rg -n 'resultItems|championship|developerItems|Author|next:' src/ui.js | head -n 50 && rg -n 'halo|HUD|caption|lesson|protect|charges' src/view.js | tail -n 35 && cat artifacts/view-check.mjs | head -n 35\"","aggregated_output":"202:  function developerItems() {\n244:      const result = Sim.validateCourt({ version: 1, name: 'Authored court', blocks: editor });\n291:        const text = JSON.stringify({ version: 1, name: 'Authored court', blocks: editor }, null, 2); app.authorJSON = text; status = 'JSON shown below. Select it to copy, or use Download.'; refresh() [... omitted end of long line]\n295:        const url = URL.createObjectURL(new Blob([JSON.stringify({ version: 1, name: 'Authored court', blocks: editor }, null, 2)], { type: 'application/json' }));\n308:  function resultItems() {\n348:      menu = developerItems();\n357:      menu = resultItems();\n358:    } else if (s === 'championship') {\n199:    const S=r.ppu,f=seat?-1:1,T=TEAMS[seat],repair=p.launcherUntil>w.time,absence=Math.max(p.launcherUntil,p.crewUntil)>w.time,protectedNow=p.protectUntil>w.time;\n219:      if(protectedNow&&!app.settings.reducedMotion){px.ddisc(g,ox,Y(20),33*S,'#8ff2dc',.2);for(let i=0;i<8;i++){const aa=clock*1.4+i*Math.PI/4;px.disc(g,ox+Math.cos(aa)*31*S,Y(23)+Math.sin(aa)*26*S,1. [... omitted end of long line]\n221:    // Crew return/repair stays visible; their protection is marked above the rig.\n228:      else if(protectedNow){text='PROTECTED';color='#b5f4d8';}\n289:      if(app.caption){const text=String(app.caption);E.font.text(g,text,W/2,phone?85:69,'#ffe1ac',{align:'center',outline:false,shadow:'#272636',wrap:W-44});}\nimport '../vendor/engine/my-3d2dge.js';\nimport {createWorld,command,step} from '../src/sim.js';\nimport {createView} from '../src/view.js';\nimport {createAudio} from '../src/audio.js';\nconst E=globalThis.My3D2dge;\nconst game=new E.Game({headless:true,draw:true,loop:false,res:[640,360],expand:true,view:'side',input:{},menu:false,corner:false,autoPause:false});\nlet world=createWorld({court:0});\nconst app={world,game,screen:'play',mode:'quick',settings:{music:.1,effects:.7,voice:.45,reducedMotion:false,glyphs:'PlayStation',fire1:'Space'},device:'keyboard',dev:{},caption:'HOLD TO WIND · RELEASE TO THROW'};\nconst view=createView(E,game),audio=createAudio(E,game);\ngame.start({update(dt){step(app.world,dt);view.update(dt,app);audio.update(dt,app);},draw:r=>view.draw(r,app)});\nfor(let court=0;court<5;court++){\n app.world=createWorld({court});view.clear();game.advance(1/30,{draw:true});command(app.world,0,{type:'begin'});game.advance(.8,{draw:true});command(app.world,0,{type:'release'});game.advance(3,{draw:true});\n}\nconsole.log(JSON.stringify({errors:game.errors,view:view.diagnostics(),audio:audio.diagnostics()}));game.dispose();\n","exit_code":0,"status":"completed"}}
