on',checks:r.count,failures:r.failures});}catch(e){results.push({name:'Native presentation',checks:1,failures:[e.stack]});}\\\\nconst count=results.reduce\\\")\nopen(p,'w').write(s)\np='tests/simulation.mjs';s=open(p).read();anchor=\\\" // Exact idle threshold, consumed exit handled in browser adapter tests.\\\"\naddition=\\\"\\\"\\\" // Practice and same-device play must never mutate the saved solo tour.\n {const storage={data:null,getItem(){return this.data;},setItem(k,v){this.data=v;}};const app=createRuntime({headless:true,loop:false,storage});app.start('solo',{seed:83});const before=JSON.stringify(app.savedTour);app.playLesson();equal(app.mode,'quick','lesson replay uses independent practice duel');equal(app.tour,null,'quick lesson has no active solo score bank');equal(JSON.stringify(app.savedTour),before,'lesson replay preserves saved tour');const w=app.world;w.players[0].score=13;finish(w,0);app.game.advance(2);equal(JSON.stringify(app.savedTour),before,'practice result never overwrites saved tour');app.start('local',{war:true});app.start('local',{war:false});equal(app.tour,null,'single local duel clears prior local war ledger');app.dispose();}\n\\\"\\\"\\\"\ns=s.replace(anchor,addition+anchor)\nopen(p,'w').write(s)\nPY\nnpm run build && npm run verify\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
