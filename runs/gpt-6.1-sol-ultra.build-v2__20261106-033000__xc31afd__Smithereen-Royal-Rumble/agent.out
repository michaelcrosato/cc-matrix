h the complete tour');\\\")\ns=s.replace(\\\"app.game.advance(10-DT);equal(app.mode\\\", \\\"app.setScreen('settings');app.focus=3;app.game.advance(10-DT);equal(app.mode\\\")\ns=s.replace(\\\"app.title();equal(app.world.stats.shots,[0,0],'attract exit clears simulation state');app.dispose();\\\", \\\"app.game.advance(60);ok(app._attractHistory?.length>=2,'attract showcase cycles two court moods');ok(app._attractHistory.every(x=>x.outcome),'attract leaves time for actual outcome ceremony');app.title();equal(app.world.stats.shots,[0,0],'attract exit clears simulation state');equal([app.screen,app.focus],['settings',3],'attract restores prior menu focus');app.dispose();\\\")\nopen(p,'w').write(s)\nPY\ncat > .npmrc <<'EOF'\nloglevel=error\nEOF\ncat > artifacts/issues.json <<'EOF'\n[\n {\\\"id\\\":1,\\\"severity\\\":\\\"medium\\\",\\\"issue\\\":\\\"TV title actions extended below safe area\\\",\\\"fix\\\":\\\"Compact native title composition\\\",\\\"evidence\\\":\\\"ui-input.py TV final action bounds and ui-tv-title.png\\\"},\n {\\\"id\\\":2,\\\"severity\\\":\\\"low\\\",\\\"issue\\\":\\\"Inherited touch START overlapped custom menu\\\",\\\"fix\\\":\\\"Native touch setting off with custom gesture filter\\\",\\\"evidence\\\":\\\"ui-input.py and browser.py no native menu element\\\"},\n {\\\"id\\\":3,\\\"severity\\\":\\\"medium\\\",\\\"issue\\\":\\\"Hub countdown iframe blur opened a remote pause overlay\\\",\\\"fix\\\":\\\"Clear prestart input without opening live overlay\\\",\\\"evidence\\\":\\\"Official harness plus game-specific simultaneous Fire regression\\\"},\n {\\\"id\\\":4,\\\"severity\\\":\\\"critical\\\",\\\"issue\\\":\\\"Portrait native minimum scale cropped remote castle\\\",\\\"fix\\\":\\\"Compact native buffer/custom side projection and target inset\\\",\\\"evidence\\\":\\\"view-browser physical client-space bounds; phone captures\\\"},\n {\\\"id\\\":5,\\\"severity\\\":\\\"critical\\\",\\\"issue\\\":\\\"Attempted touch-never fix blocked touch-only play\\\",\\\"fix\\\":\\\"Use public touch off setting instead of refusing touch\\\",\\\"evidence\\\":\\\"view-browser and WebKit unsupported-overlay absence plus real touch Fire\\\"},\n {\\\"id\\\":6,\\\"severity\\\":\\\"medium\\\",\\\"issue\\\":\\\"Live slider rebuilt its DOM during pointer drag\\\",\\\"fix\\\":\\\"Apply live value without replacing control until change finishes\\\",\\\"evidence\\\":\\\"UI input range interaction and health-fraction/reset checks\\\"},\n {\\\"id\\\":7,\\\"severity\\\":\\\"critical\\\",\\\"issue\\\":\\\"Network pending-begin latch survived crew interruption and blocked future Fire\\\",\\\"fix\\\":\\\"Retire begin when authoritative charge/hold/buffer cleared\\\",\\\"evidence\\\":\\\"hub-unit real production crew interruption: two regression failures before fix, zero after\\\"},\n {\\\"id\\\":8,\\\"severity\\\":\\\"medium\\\",\\\"issue\\\":\\\"Lesson replay could replace saved solo tour and practice could retain score ledger\\\",\\\"fix\\\":\\\"Independent quick teaching mode, clear active tour outside war modes, preserve saved tour\\\",\\\"evidence\\\":\\\"simulation practice-result and saved-tour separation regressions\\\"},\n {\\\"id\\\":9,\\\"severity\\\":\\\"medium\\\",\\\"issue\\\":\\\"Long credits auto-focus scrolled source heading offscreen\\\",\\\"fix\\\":\\\"Paged controller-readable credits and stable heading visibility\\\",\\\"evidence\\\":\\\"Focused Credits viewport regression and final-credits screenshot\\\"}\n]\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
