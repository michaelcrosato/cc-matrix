te(\\\"__wire.scenes.corner.subjects().filter(s=>s.active()&&!s.optional&&!__wire.CASE.has(s.id)).map(s=>s.id)\\\")\\n        need_h2h = len([x for x in st['photos'] if x.startswith('h2h')]) < 3\\n        live = [l for l in live if need_h2h or not l.startswith('h2h')]\\n        if live:\\n            p.evaluate(\\\"\\\"\\\"(id)=>{const sc=__wire.scenes.corner, s=sc.subjects().find(s=>s.id===id); const pts=s.pts(); let x=0,y=0; for(const q of pts){x+=q.x;y+=q.y;} x/=pts.length; y/=pts.length; const d=sc.dets()[0]; d.hero.x=x; d.hero.y=y+40; window.__lens=[x,y];}\\\"\\\"\\\", live[0])\\n            p.wait_for_timeout(100); p.keyboard.down('KeyQ'); p.wait_for_timeout(150)\\n            p.evaluate(\\\"(()=>{const d=__wire.scenes.corner.dets()[0]; d.lens.x=__lens[0]; d.lens.y=__lens[1];})()\\\")\\n            p.keyboard.press('Space'); p.wait_for_timeout(150); p.keyboard.up('KeyQ'); p.wait_for_timeout(150)\\n            continue\\n        if st['burnerState'] == 3 and 'burner' not in st['photos']:\\n            p.evaluate(\\\"(()=>{const d=__wire.scenes.corner.dets()[0]; d.hero.x=19.4*16+8; d.hero.y=19.6*16;})()\\\"); p.wait_for_timeout(100)\\n            p.keyboard.press('KeyE'); p.wait_for_timeout(2200); continue\\n        if all(k in st['photos'] for k in ['stash','smoke','burner']) and len([x for x in st['photos'] if x.startswith('h2h')]) >= 3:\\n            p.evaluate(\\\"(()=>{const d=__wire.scenes.corner.dets()[0]; d.hero.x=12*16; d.hero.y=18.6*16;})()\\\"); p.wait_for_timeout(150)\\n            p.keyboard.press('KeyE'); p.wait_for_timeout(300); break\\n        p.wait_for_timeout(500)\\n    print('corner photos', p.evaluate(\\\"__wire.CASE.photos.map(p=>p.id)\\\"), 'heat', p.evaluate(\\\"__wire.CASE.heat\\\"), round(time.time()-t0), 's')\\n    wait_scene(p, 'chapter'); print('-> chapter 2'); wait_scene(p, 'wire')\\n    until(p, \\\"__wire.scenes.wire.state().phase==='pager' && !__wire.scenes.wire.talk().open\\\", tries=120)\\n    for num in ['4105553','4107281','4108600']:\\n        for d in num: p.keyboard.press('Digit'+d); p.wait_for_timeout(70)\\n        until(p, \\\"!__wire.scenes.wire.talk().open\\\", tries=60)\\n    until(p, \\\"__wire.scenes.wire.state().phase==='calls'\\\", presses='Shift')\\n    # flag pertinent lines on calls 1 and 3, minimize call 2 early\\n    for i in range(1200):\\n        s = p.evaluate(\\\"__wire.scenes.wire.state()\\\")\\n        if s['phase'] != 'calls': break\\n        info = p.evaluate(\\\"(()=>{const s=__wire.scenes.wire.state(); return s})()\\\")\\n        if s['call'] == 1 and s['line'] >= 1: p.keyboard.press('KeyM')\\n        elif s['call'] in (0,2) and s['line'] in (2,4): p.keyboard.press('KeyE')\\n        p.wait_for_timeout(120)\\n    until(p, \\\"__wire.scenes.wire.talk().open && __wire.scenes.wire.talk().choices\\\", tries=80, presses='Shift')\\n    until(p, \\\"__wire.scenes.wire.talk().choices && !__wire.scenes.wire.talk().typing\\\", tries=40, presses='Shift')\\n    p.keyboard.press('Enter'); p.wait_for_timeout(300)   # pier\\n    until(p, \\\"__wire.scenes.wire.talk().choices && !__wire.scenes.wire.talk().typing\\\", tries=80)\\n    p.keyboard.press('ArrowDown'); p.wait_for_timeout(100); p.keyboard.press('Enter')  # eight\\n    print('wire log', p.evaluate(\\\"JSON.stringify(__wire.CASE.wire)\\\"))\\n    wait_scene(p, 'chapter'); print('-> chapter 3'); wait_scene(p, 'board')\\n    until(p, \\\"__wire.scenes.board.state().phase==='pin' && !__wire.scenes.board.talk().open\\\", tries=120)\\n    for k in range(6):\\n        p.keyboard.press('KeyE'); p.wait_for_timeout(150)\\n        s = p.evaluate(\\\"__wire.scenes.board.state()\\\")\\n        key = ['dante','smoke','kev','tater','stash','burner','lookout'][s['cur']]\\n        for i in range(s['cards'].index(key)): p.keyboard.press('ArrowRight'); p.wait_for_timeout(60)\\n        p.keyboard.press('KeyE'); p.wait_for_timeout(350)\\n    print('board', p.evaluate(\\\"JSON.stringify(__wire.scenes.board.state().pinned)\\\"), 'score', p.evaluate(\\\"__wire.CASE.board\\\"))\\n    until(p, \\\"__wire.scenes.board.talk().choices && !__wire.scenes.board.talk().typing\\\", tries=120)\\n    p.keyboard.press('Enter')\\n    wait_scene(p, 'chapter'); print('-> chapter 4'); wait_scene(p, 'meet')\\n    until(p, \\\"!__wire.scenes.meet.talk().open\\\", tries=120)\\n    p.keyboard.down('KeyA'); p.wait_for_timeout(700); p.keyboard.up('KeyA'); p.keyboard.down('KeyW'); p.wait_for_timeout(1800); p.keyboard.up('KeyW')\\n    print('meet state', p.evaluate(\\\"JSON.stringify(__wire.scenes.meet.state())\\\"))\\n    for i in range(120):\\n        if p.evaluate(\\\"__wire.scenes.meet.state().phase==='talk'\\\"): break\\n        p.wait_for_timeout(500)\\n    # crouch behind the container row north of the yard, in range of the clock, then shoot both subjects\\n    p.keyboard.press('KeyC')\\n    for sid in ['meet','plate']:\\n        p.evaluate(\\\"\\\"\\\"(id)=>{const pts=id==='meet'?[{x:19.8*16+10,y:9.6*16},{x:19.8*16-8,y:9.6*16}]:null; window.__sid=id;}\\\"\\\"\\\", sid)\\n        ok = p.evaluate(\\\"\\\"\\\"(id)=>{const s=__wire.scenes.meet; return true}\\\"\\\"\\\", sid)\\n    # use the engine's own subject list via the detective's snap: position the detective south of the clock with sight\\n    p.evaluate(\\\"(()=>{window.__d=null;})()\\\")\\n    p.evaluate(\\\"(()=>{})()\\\")\\n    res = p.evaluate(\\\"\\\"\\\"(()=>{const g=__wire.game; return g.sceneName})()\\\"\\\"\\\")\\n    for sid, lx, ly in [('meet', 19.8*16+1, 9.6*16), ('plate', 23.5*16+14+18, 9.2*16)]:\\n        p.evaluate(f\\\"(()=>{{const d=__wire.scenes.meet.dets ? null : null;}})()\\\")\\n    print('meet phase', p.evaluate(\\\"__wire.scenes.meet.state().phase\\\"))\\nrun(URL, f)\\nEOF\\necho written\",\"description\":\"Draft full playthrough script\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":4,\"cache_creation_input_tokens\":3343,\"cache_read_input_t