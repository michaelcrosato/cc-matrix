 p.evaluate(`(() => { const G = My3D2dge.current, D = G.debug; ${js}; })()`); } catch (e) { errs.push(n + ': ' + e.message); } await p.waitForTimeout(wait); await p.screenshot({ path: `${out}/${tag}-${n}.png` }); }\\n  console.log(tag, 'errors:', errs.slice(0, 8).join(' | ')); await b.close();\\n};\\nawait run(chromium, { viewport: { width: 1280, height: 720 } }, [\\n  ['a-pad', `D.newGame(3); setTimeout(() => { G.input.lastDevice = 'gamepad'; }, 1600)`, 2600],\\n  ['b-xbox', `G.settings.set('glyphs', 'xbox'); G.input.lastDevice = 'gamepad'`, 600],\\n  ['c-log', `G.settings.set('glyphs', 'playstation'); G.input.lastDevice = 'keyboard'; G.input.tap('log')`, 800],\\n  ['d-fight', `G.input.tap('log'); D.teleport(24*16, 33*16); const s = D.state(); for (const [k,dx,dy] of [['thug',40,0],['bruiser',-40,10],['gunner',60,40]]) {} ; D.setStep('collect')`, 300],\\n  ['e-fight2', `G.input.hold('attack'); setTimeout(()=>G.input.hold('attack', false), 900)`, 1000],\\n  ['f-panic', `D.state().stress = 99.5; G.debug.state().stress = 100;`, 300],\\n  ['g-pause', ``, 900, 'Escape'],\\n  ['h-controls', `G.menu('controls')`, 900],\\n  ['i-settings', `G.menu('settings')`, 900],\\n], 'cr');\\nawait run(chromium, { viewport: { width: 1280, height: 720 } }, [['attract', ``, 14000], ['attract2', ``, 14000], ['attract3', ``, 14000]], 'at');\\nawait run(webkit, { ...devices['iPhone 15'] }, [['touch-title', ``, 500], ['touch-attract', ``, 12000]], 'ios');\\nEOF\\ncd /tmp/x96eb17 && rm -rf s2 && mkdir s2 && node shots2.mjs \\\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181316__x96eb17/work/TheSopraniacs-TheSopranos-claude-opus-5-5-medium-20261102-181316.html\\\" /tmp/x96eb17/s2 2>&1 | tail; node sheet.mjs s2 sheet3.png 0; node sheet.mjs s2 sheet4.png 9\",\"description\":\"Screenshot glyphs, log, fight, pause, attract and touch-only title\",\"timeout\":300000},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\"