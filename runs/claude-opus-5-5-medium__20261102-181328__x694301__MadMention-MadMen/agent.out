his.cool = Math.max(0, this.cool - dt); this.shotCool = Math.max(0, this.shotCool - dt);\\n    const dx = hero.x - this.x, dy = hero.y - this.y, d = Math.hypot(dx, dy);\\n    const sees = !hero.dead && this.kind !== 'civ' && d < this.sight && ctx.map.sight(this, hero) && E.inArc(this, this.facing, hero, this.sight, 1.9);\\n    if (this.kind === 'civ') return this.civStep(dt, ctx, d);\\n    if (sees || (this.alert > 0 && d < this.sight * .6)) this.alert = 6;\\n    if (sees) ctx.world.spotted(this, dt);\\n    this.alert = Math.max(0, this.alert - (sees ? 0 : dt));\\n    if (this.atk) {\\n      this.atk.update(dt);\\n      this.atk.hits([hero], t => E.dist(this, t) < this.reach + 6, t => ctx.world.hurtHero(this.dmg * (this.boss ? 1 : 1), this));\\n      this.facing = Math.atan2(dy, dx);\\n      if (!this.atk.busy) this.atk = null;\\n      this.vx = this.vy = 0;\\n    } else if (this.alert > 0) {\\n      const aware = this.alert;\\n      this.facing = Math.atan2(dy, dx);\\n      if (this.shoots && d > 60 && d < 170 && this.shotCool <= 0 && ctx.map.sight(this, hero)) {\\n        this.shotCool = 1.8 + Math.random() * .8;\\n        ctx.shots.fire({ x: this.x, y: this.y, z: 16, vx: dx / d * 150, vy: dy / d * 150, vz: 0, r: 2, team: 'enemy', color: '#ffe08a', life: 2, dmg: this.dmg });\\n        ctx.world.sfx('shoot');\\n        this.vx = this.vy = 0;\\n      } else if (d > this.reach - 4 && !this.shoots || (this.shoots && d > 110)) {\\n        const v = ctx.flow.dir(this.x, this.y, hero.x, hero.y);\\n        const sp = this.speed * (this.phase2 ? 1.25 : 1) * (aware > 0 ? 1 : .5);\\n        this.vx = v[0] * sp; this.vy = v[1] * sp;\\n      } else {\\n        this.vx = this.vy = 0;\\n        if (this.cool <= 0 && this.reach > 0 && d < this.reach + 2 && !this.atk) this.startAttack();\\n      }\\n      if (!this.atk && this.shoots && d < 110 && this.shotCool <= 0.1) { /* the fed keeps its distance; shoots above */ }\\n    } else {\",\"new_string\":\"    this.boss = kind === 'boss'; this.phase2 = false; this.flee = 0;\\n  }\\n  get alive() { return !this.dead; }\\n\\n  // one step: look, attack, shoot or walk. ctx = { hero, map, flow, shots, world }\\n  step(dt, ctx) {\\n    const hero = ctx.hero;\\n    this.flash = Math.max(0, this.flash - dt); this.hurtT = Math.max(0, this.hurtT - dt);\\n    if (this.dead) { this.dieT += dt; this.vx = this.vy = 0; this.rig.update(dt, this.rigState('die')); return; }\\n    this.cool = Math.max(0, this.cool - dt); this.shotCool = Math.max(0, this.shotCool - dt);\\n    const dx = hero.x - this.x, dy = hero.y - this.y, d = Math.hypot(dx, dy);\\n    if (this.kind === 'civ') return this.civStep(dt, ctx, d);\\n    const sees = !hero.dead && d < this.sight && ctx.map.sight(this, hero) && E.inArc(this, this.facing, hero, this.sight, 1.9);\\n    if (sees) { this.alert = 6; ctx.world.spotted(this, dt); } else this.alert = Math.max(0, this.alert - dt);\\n    if (this.atk) {\\n      this.atk.update(dt);\\n      this.atk.hits([hero], t => E.dist(this, t) < this.reach + 6, () => ctx.world.hurtHero(this.dmg, this));\\n      this.facing = Math.atan2(dy, dx);\\n      if (!this.atk.busy) this.atk = null;\\n      this.vx = this.vy = 0;\\n    } else if (this.alert > 0) {\\n      this.facing = Math.atan2(dy, dx);\\n      if (this.shoots && d > 60 && d < 170 && this.shotCool <= 0 && sees) {\\n        this.shotCool = 1.8 + Math.random() * .8;\\n        ctx.shots.fire({ x: this.x, y: this.y, z: 16, vx: dx / d * 150, vy: dy / d * 150, vz: 0, r: 2, team: 'enemy', color: '#ffe08a', life: 2, dmg: this.dmg });\\n        ctx.world.sfx('shoot');\\n        this.vx = this.vy = 0;\\n      } else if (this.shoots ? d > 110 : d > this.reach - 4) {\\n        const v = ctx.flow.dir(this.x, this.y, hero.x, hero.y);\\n        const sp = this.speed * (this.phase2 ? 1.25 : 1);\\n        this.vx = v[0] * sp; this.vy = v[1] * sp;\\n      } else {\\n        this.vx = this.vy = 0;\\n        if (this.cool <= 0 && this.reach > 0 && d < this.reach + 2) t