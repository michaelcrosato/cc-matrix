pin:  plunge:  twohand:  jab:  cross:  hook:  uppercut:  haymaker:  elbow:  kick:  roundhouse:  sweep:  flyingkick:  knee:  axekick:  cast:  throw:  bash:  claw:\n5093:    this.light = o.light || null; this.version = 0; this.outside = o.outside;\n12459:    g.fillStyle = o.outside; g.fillRect(vp.x, top, vp.w, bot - top);\n12470:      const oh = E.hex(o.outside), oc = ((255 << 24) | (oh[2] << 16) | (oh[1] << 8) | oh[0]) >>> 0;\n7864:class Backdrop {\n389:- `game.particles.dust(x, y, z, n, o = {})`: n puffs of dust from (x, y, z) that drift and fade. o: { speed: 30, color, size }\n390:- `game.particles.explosion(x, y, z, size = 1, o = {})`: a full explosion in one call: fireball, smoke, sparks, debris, shockwave ring, screen shake and flash, sound. explosion(x, y, z, size = 1, \n391:- `game.particles.fire(x, y, z, n = 6, o = {})`: fireball puffs for explosions and fire breath\n392:- `game.particles.glints(x, y, z, n = 5, color = '#fff6c0', spread = 10)`: twinkling star glints for magic, treasure and pickups\n394:- `game.particles.ring(x, y, r0, r1, color, dur = .35, z = 0)`: a ring on the ground growing from radius r0 to r1 over dur seconds (shockwaves, landings)\n395:- `game.particles.smoke(x, y, z, n = 4, o = {})`: rising smoke puffs: smoke(x, y, z, n, { size, color, dark, light })\n396:- `game.particles.sparks(x, y, z, n, dir = null, o = {})`: n bright sparks thrown from (x, y, z), every way or around angle dir (radians). o: { color, speed }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FRTUFiyeaUqMXZxCSWtZyZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
