{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CghxJY9d558eS6Uh7DpDS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013qxrzBGBjxAGuvisQJSgwY","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-061612__x5a4f79/work/Basket*; sed -n 1,50p handoff/kits/test.mjs | cut -c1-240; cat handoff/game/index.html | head -30; ls handoff/tools"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1691,"cache_read_input_tokens":114524,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1691},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"213edd46-9651-46f8-a282-da1d89430eab","uuid":"173f8cd6-da3b-4011-bfc9-a5a8b136ae77","timestamp":"2026-11-04T13:20:23.376Z","request_id":"req_011CghxJXrkq5QuaWTXTrpKc","wire_tool_inputs":{"toolu_013qxrzBGBjxAGuvisQJSgwY":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-061612__x5a4f79/work/Basket*; sed -n 1,50p handoff/kits/test.mjs | cut -c1-240; cat handoff/game/index.html | head -30; ls handoff/tools"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013qxrzBGBjxAGuvisQJSgwY","type":"tool_result","content":"// A headless test of the genre kits: each kit's game runs in Node with no screen (new E.Game is headless where there is no\n// DOM) after the scripts its page loads before it (the engine, an asset set), starts its slice (the page's deep link,\n// #<id>), plays two seconds, then runs the slice's proof twice: run(600), scripted play from a seed, gives a hash of how\n// it went, the same every time. Run it: node kits/test.mjs [id ...] (every kit without one; exit code 1 on a failure).\n// A game copied from a kit tests the same way: a kit's code reads three of the page's globals, given stand-ins here\n// (window, addEventListener, location); drive it with game.advance and input.tap / hold, as game/test.mjs does.\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync } from 'node:fs';\n\nconst here = new URL('./', import.meta.url), read = f => readFileSync(new URL(f, here), 'utf8');\nconst ids = process.argv.slice(2).length ? process.argv.slice(2) : readdirSync(here).filter(f => f.endsWith('.html')).map(f => f.slice(0, -5)).sort();\nlet failed = 0;\nfor (const id of ids) {\n  const ctx = { console: { log() {}, info() {}, warn() {}, error: console.error }, addEventListener() {}, location: { hash: '#' + id } };\n  ctx.window = ctx; vm.createContext(ctx);\n  try {\n    // the page's scripts, in its order: ../my-3d2dge.js, any asset set, then the kit's game\n    for (const [, src] of read(id + '.html').matchAll(/<script src=\"([^\"]+)\"><\\/script>/g)) vm.runInContext(read(src), ctx, { filename: src });\n    const game = ctx.My3D2dge.current, slice = ctx.__game.scenes[id];\n    game.advance(2);\n    const scene = game.sceneName, a = slice.run(600), b = slice.run(600), errors = game.errors.map(e => e.message), ok = a === b && !errors.length;\n    console.log((ok ? 'ok   ' : 'FAIL ') + id + ': ' + scene + ' plays; its proof twice ' + (a === b ? 'the same (' + a + ')' : a + ', then ' + b) + (errors.length ? '; errors: ' + errors.join(' | ') : ''));\n    if (!ok) failed++;\n  } catch (e) { console.log('FAIL ' + id + ': ' + (e && e.stack || e).toString().split('\\n').slice(0, 3).join(' / ')); failed++; }\n}\nconsole.log(failed ? `${failed} of ${ids.length} kit(s) failed` : `all ${ids.length} kit(s) passed`);\nprocess.exit(failed ? 1 : 0);\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.85.2</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>\nasset-find.mjs\nasset-lib.mjs\nasset-set.mjs\nasset-sheet.mjs\ncheck.mjs\nfilmstrip.mjs\nreplay.mjs","is_error":false}]},"parent_tool_use_id":null,"session_id":"213edd46-9651-46f8-a282-da1d89430eab","uuid":"1d6690ad-5fa3-4678-824f-dc37143de070","timestamp":"2026-11-04T13:20:23.408Z","tool_use_result":{"stdout":"// A headless test of the genre kits: each kit's game runs in Node with no screen (new E.Game is headless where there is no\n// DOM) after the scripts its page loads before it (the engine, an asset set), starts its slice (the page's deep link,\n// #<id>), plays two seconds, then runs the slice's proof twice: run(600), scripted play from a seed, gives a hash of how\n// it went, the same every time. Run it: node kits/test.mjs [id ...] (every kit without one; exit code 1 on a failure).\n// A game copied from a kit tests the same way: a kit's code reads three of the page's globals, given stand-ins here\n// (window, addEventListener, location); drive it with game.advance and input.tap / hold, as game/test.mjs does.\nimport vm from 'node:vm';\nimport { readFileSync, readdirSync } from 'node:fs';\n\nconst here = new URL('./', import.meta.url), read = f => readFileSync(new URL(f, here), 'utf8');\nconst ids = process.argv.slice(2).length ? process.argv.slice(2) : readdirSync(here).filter(f => f.endsWith('.html')).map(f => f.slice(0, -5)).sort();\nlet failed = 0;\nfor (const id of ids) {\n  const ctx = { console: { log() {}, info() {}, warn() {}, error: console.error }, addEventListener() {}, location: { hash: '#' + id } };\n  ctx.window = ctx; vm.createContext(ctx);\n  try {\n    // the page's scripts, in its order: ../my-3d2dge.js, any asset set, then the kit's game\n    for (const [, src] of read(id + '.html').matchAll(/<script src=\"([^\"]+)\"><\\/script>/g)) vm.runInContext(read(src), ctx, { filename: src });\n    const game = ctx.My3D2dge.current, slice = ctx.__game.scenes[id];\n    game.advance(2);\n    const scene = game.sceneName, a = slice.run(600), b = slice.run(600), errors = game.errors.map(e => e.message), ok = a === b && !errors.length;\n    console.log((ok ? 'ok   ' : 'FAIL ') + id + ': ' + scene + ' plays; its proof twice ' + (a === b ? 'the same (' + a + ')' : a + ', then ' + b) + (errors.length ? '; errors: ' + errors.join(' | ') : ''));\n    if (!ok) failed++;\n  } catch (e) { console.log('FAIL ' + id + ': ' + (e && e.stack || e).toString().split('\\n').slice(0, 3).join(' / ')); failed++; }\n}\nconsole.log(failed ? `${failed} of ${ids.length} kit(s) failed` : `all ${ids.length} kit(s) passed`);\nprocess.exit(failed ? 1 : 0);\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacity:1}}</style><b style=\"color:#f4f0ff;font-size:16px;letter-spacing:.08em\">ROOFTOP</b><span>Starting · my-3D2dge v0.85.2</span><span style=\"display:block;height:4px;max-width:440px;overflow:hidden;background:#ffffff14\"><span style=\"display:block;width:30%;height:100%;background:#d9b77c;animation:e3-run 1.2s ease-in-out infinite\"></span></span><span style=\"opacity:0;animation:e3-late .3s 12s forwards\">Still starting. If this stays, the game's script did not run: reload, or open the browser's console.</span></div>\n<canvas id=\"screen\"></canvas>\n<script src=\"../my-3d2dge.js\"></script>\n<script src=\"game.js\"></script>\n</body>\n</html>\nasset-find.mjs\nasset-lib.mjs\nasset-set.mjs\nasset-sheet.mjs\ncheck.mjs\nfilmstrip.mjs\nreplay.mjs","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013qxrzBGBjxAGuvisQJSgwY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CghxRHAfkxncrz4EC1uGs","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11792,"cache_read_input_tokens":116215,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11792},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"213edd46-9651-46f8-a282-da1d89430eab","uuid":"da89f006-6b63-41cd-bf51-8c491bbf5700","timestamp":"2026-11-04T13:20:28.139Z","request_id":"req_011CghxRGt3UiP1FAtCBKXKb","thinking_duration_ms":998,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CghxRHAfkxncrz4EC1uGs","type":"message","role":"assistant","content":[{"type":"text","text":"Status: reading is done, and I'm now writing the game source in modules (core, data, audio, simulation, AI, rendering, screens, AI Hub). I'll start with the core and data files."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11792,"cache_read_input_tokens":116215,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11792},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"213edd46-9651-46f8-a282-da1d89430eab","uuid":"878ceeb0-0a57-46b0-a7c9-3f1e32f39a3f","timestamp":"2026-11-04T13:20:28.141Z","request_id":"req_011CghxRGt3UiP1FAtCBKXKb"}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CghxRHAfkxncrz4EC1uGs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CEm8KvEvpavHi4kHDwTXQQ","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-061612__x5a4f79/work/Basketblam-Basketball-claude-sonnet-5-5-medium-20261104-061612/src/00-core.js","content":"/* BASKETBLAM — core: constants, tuning, settings, shared state, event bus */\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach } = E;\nconst PI = Math.PI, TAU = PI * 2;\nconst HAS_WIN = typeof window !== 'undefined';\nconst HUB = !!(HAS_WIN && window.AIHub && window.AIHub.active);\nconst NOW = () => (typeof performance !== 'undefined' ? performance.now() : Date.now());\n\n/* ---- geometry (world units; one tile = 16; z up). World = court-local + (OX, OY) ---- */\nconst OX = 64, OY = 112, CW = 640, CH = 288;\nconst COURT = { x0: OX, x1: OX + CW, y0: OY, y1: OY + CH, cx: OX + CW / 2, cy: OY + CH / 2 };\nconst RIM_Z = 80, RIM_R = 9, BALL_R = 4.5;\nconst HOOPS = [{ x: OX + 52, y: OY + 144, dir: 1, side: 0 }, { x: OX + CW - 52, y: OY + 144, dir: -1, side: 1 }];\n// team 0 (HOME) attacks the RIGHT hoop (index 1); team 1 attacks the LEFT hoop (index 0)\nconst attackHoop = team => HOOPS[team === 0 ? 1 : 0];\nconst defendHoop = team => HOOPS[team === 0 ? 0 : 1];\nconst THREE_R = 136;\n\nconst BROADCAST = new E.View('broadcast', 'Broadcast', 0, 30, 1, 1);\nE.VIEWS.broadcast = BROADCAST;\n\n/* ---- controls ---- */\nconst KEYS = Object.assign({}, E.Input.DEFAULT, {\n  shoot: ['Space', 'KeyJ', 'Mouse0', 'Pad2'], pass: ['KeyE', 'KeyK', 'Mouse2', 'Pad0'],\n  turbo: ['ShiftLeft', 'ShiftRight', 'Pad7', 'Pad5'], shove: ['KeyQ', 'KeyL', 'Pad1'],\n  oop: ['KeyF', 'KeyI', 'Pad3'], taunt: ['KeyR', 'KeyU', 'Pad4']\n});\nfor (const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\nconst CONTROL_NAMES = { shoot: 'Shoot / Block', pass: 'Pass / Steal', turbo: 'Turbo', shove: 'Shove / Spin', oop: 'Alley-oop / Call', taunt: 'Taunt' };\n\n/* ---- tuning: the single home of the important numbers (live dev sliders) ---- */\nconst TUNING = {};\nconst TUNE_DEFS = [\n  // key, label, def, min, max, step, group, help\n  ['runSpeed', 'Run speed', 92, 50, 160, 1, 'MOVEMENT', 'Top speed on foot'],\n  ['accel', 'Acceleration', 900, 300, 2000, 25, 'MOVEMENT', 'How fast players change speed'],\n  ['turboMult', 'Turbo speed', 1.5, 1, 2.4, .05, 'MOVEMENT', 'Speed multiplier while turbo is held'],\n  ['turboDrain', 'Turbo drain /s', .30, 0, 1.5, .05, 'MOVEMENT', 'Turbo used per second while sprinting'],\n  ['turboRefill', 'Turbo refill /s', .20, 0, 1.5, .05, 'MOVEMENT', 'Turbo regained per second'],\n  ['playerGravity', 'Player gravity', 900, 400, 1800, 20, 'MOVEMENT', 'How hard players fall'],\n  ['jumpShotVz', 'Jump power', 250, 150, 420, 5, 'MOVEMENT', 'Takeoff speed of a jump shot or block'],\n  ['ballGravity', 'Ball gravity', 760, 300, 1500, 20, 'BALL', 'How hard the ball falls'],\n  ['ballBounce', 'Floor bounce', .62, .3, .9, .01, 'BALL', 'Floor restitution'],\n  ['rimBounce', 'Rim bounce', .45, .2, .8, .01, 'BALL', 'Rim restitution'],\n  ['shotBase', 'Shot accuracy', 1, .5, 1.4, .02, 'SHOOTING', 'Scales every make chance'],\n  ['contestPenalty', 'Contest penalty', .35, 0, .8, .01, 'SHOOTING', 'Make chance lost to a tight defender'],\n  ['perfectBonus', 'Perfect release', 1.15, 1, 1.5, .01, 'SHOOTING', 'Make chance multiplier on a green release'],\n  ['threeBonus', 'Three-point worth', 3, 2, 5, 1, 'SHOOTING', 'Points for a shot from beyond the arc'],\n  ['dunkRange', 'Dunk range', 72, 30, 140, 1, 'DUNKS', 'Distance a dunk can start from'],\n  ['dunkReject', 'Dunk block chance', .5, 0, 1, .01, 'DUNKS', 'Chance a airborne defender rejects a dunk'],\n  ['stealChance', 'Steal chance', .34, 0, .9, .01, 'DEFENSE', 'Base chance a swipe takes the ball'],\n  ['shoveForce', 'Shove force', 150, 60, 320, 5, 'DEFENSE', 'How far a shove flings a player'],\n  ['knockdownTime', 'Knockdown time', .75, .2, 2, .05, 'DEFENSE', 'Seconds a shoved player stays down'],\n  ['blockChance', 'Block chance', .78, 0, 1, .01, 'DEFENSE', 'Chance a well-timed jump swats the shot'],\n  ['novaStreak', 'Supernova streak', 3, 1, 6, 1, 'FLOW', 'Straight baskets before a team goes SUPERNOVA'],\n  ['shotClock', 'Shot clock', 20, 8, 40, 1, 'FLOW', 'Seconds to get a shot up'],\n  ['powerupEvery', 'Power-up every', 18, 5, 60, 1, 'FLOW', 'Seconds between power-up drops'],\n  ['cpuSkill', 'CPU skill', 1, .4, 1.6, .02, 'CPU', 'How sharp the CPU is (reflexes, shots)'],\n  ['comeback', 'Comeback help', .5, 0, 1, .05, 'CPU', 'How much the trailing side is helped'],\n  ['gameSpeed', 'Game speed', 1, .4, 1.6, .05, 'FLOW', 'Time scale of the whole game']\n];\nfor (const [key, label, def, min, max, step, group, help] of TUNE_DEFS) TUNING[key] = { key, label, v: def, def, min, max, step, group, help };\nconst tune = k => TUNING[k].v;\nconst resetTuning = () => { for (const k in TUNING) TUNING[k].v = TUNING[k].def; };\nconst saveTuning = () => { const o = {}; for (const k in TUNING) o[k] = TUNING[k].v; E.store.set('bb:tuning', o); return o; };\nconst loadTuning = () => { const o = E.store.get('bb:tuning', null); if (o) for (const k in o) if (TUNING[k]) TUNING[k].v = clamp(+o[k] || TUNING[k].def, TUNING[k].min, TUNING[k].max); };\n\n/* ---- the game ---- */\nconst GAME_SETTINGS = [\n  { key: 'glyphs', label: 'Button prompts', options: ['PlayStation', 'Xbox'], value: 'PlayStation' },\n  { key: 'quarter', label: 'Quarter length', options: ['1:00', '1:30', '2:00', '3:00'], value: '1:30' },\n  { key: 'difficulty', label: 'CPU difficulty', options: ['Rookie', 'Pro', 'All-Star', 'Legend'], value: 'Pro' },\n  { key: 'camera', label: 'Camera', options: ['Broadcast', 'High'], value: 'Broadcast' },\n  { key: 'announcer', label: 'Announcers', options: ['On', 'Off'], value: 'On' },\n  { key: 'rumble2', label: 'Controller rumble on slams', options: ['On', 'Off'], value: 'On' }\n];\nconst S = {\n  scene: 'title', mode: 'exhibition', court: 'alley', teams: [0, 1], humans: {}, // slot -> input\n  players: [], ball: null, match: null, rng: E.rng(1), fxRng: E.rng(2), events: [], powerups: [], twist: {}, cheats: { infTurbo: false, big: false, noClock: false, autopilot: false },\n  progress: null, dev: { open: false, tab: 0, row: 0, overlay: false }, camera: { x: COURT.cx, zoom: 1 }, hub: null, lastInput: NOW(), padSeen: false, keySeen: false,\n  fx: { banners: [], shake: 0, flash: 0, slow: 0, slowT: 0, zoomPunch: 0, shatter: 0, cam: 0 }, announcerQueue: []\n};\nconst bus = {};\nconst on = (t, fn) => (bus[t] = bus[t] || []).push(fn);\nconst emit = (type, data = {}) => {\n  data.type = type; data.t = S.match ? S.match.time : 0;\n  S.events.push(data); if (S.events.length > 64) S.events.shift();\n  for (const fn of bus[type] || []) { try { fn(data); } catch (e) { if (game) game.fail('event ' + type, e); } }\n};\nconst dist2 = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\nconst rnd = () => S.rng();\nconst frnd = () => S.fxRng();\nconst pick = (arr, r = frnd) => arr[Math.floor(r() * arr.length) % arr.length];\nconst mmss = s => { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };\nconst hashStr = s => { let h = 2166136261; for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };\nconst QUARTER_LEN = { '1:00': 60, '1:30': 90, '2:00': 120, '3:00': 180 };\nconst DIFF = { 'Rookie': .65, 'Pro': 1, 'All-Star': 1.25, 'Legend': 1.5 };\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11792,"cache_read_input_tokens":116215,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11792},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"213edd46-9651-46f8-a282-da1d89430eab","uuid":"c93646c8-e990-4368-8def-21aaebb1ab24","timestamp":"2026-11-04T13:20:49.352Z","request_id":"req_011CghxRGt3UiP1FAtCBKXKb","wire_tool_inputs":{"toolu_01CEm8KvEvpavHi4kHDwTXQQ":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-061612__x5a4f79/work/Basketblam-Basketball-claude-sonnet-5-5-medium-20261104-061612/src/00-core.js","content":"/* BASKETBLAM — core: constants, tuning, settings, shared state, event bus */\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach } = E;\nconst PI = Math.PI, TAU = PI * 2;\nconst HAS_WIN = typeof window !== 'undefined';\nconst HUB = !!(HAS_WIN && window.AIHub && window.AIHub.active);\nconst NOW = () => (typeof performance !== 'undefined' ? performance.now() : Date.now());\n\n/* ---- geometry (world units; one tile = 16; z up). World = court-local + (OX, OY) ---- */\nconst OX = 64, OY = 112, CW = 640, CH = 288;\nconst COURT = { x0: OX, x1: OX + CW, y0: OY, y1: OY + CH, cx: OX + CW / 2, cy: OY + CH / 2 };\nconst RIM_Z = 80, RIM_R = 9, BALL_R = 4.5;\nconst HOOPS = [{ x: OX + 52, y: OY + 144, dir: 1, side: 0 }, { x: OX + CW - 52, y: OY + 144, dir: -1, side: 1 }];\n// team 0 (HOME) attacks the RIGHT hoop (index 1); team 1 attacks the LEFT hoop (index 0)\nconst attackHoop = team => HOOPS[team === 0 ? 1 : 0];\nconst defendHoop = team => HOOPS[team === 0 ? 0 : 1];\nconst THREE_R = 136;\n\nconst BROADCAST = new E.View('broadcast', 'Broadcast', 0, 30, 1, 1);\nE.VIEWS.broadcast = BROADCAST;\n\n/* ---- controls ---- */\nconst KEYS = Object.assign({}, E.Input.DEFAULT, {\n  shoot: ['Space', 'KeyJ', 'Mouse0', 'Pad2'], pass: ['KeyE', 'KeyK', 'Mouse2', 'Pad0'],\n  turbo: ['ShiftLeft', 'ShiftRight', 'Pad7', 'Pad5'], shove: ['KeyQ', 'KeyL', 'Pad1'],\n  oop: ['KeyF', 'KeyI', 'Pad3'], taunt: ['KeyR', 'KeyU', 'Pad4']\n});\nfor (const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\nconst CONTROL_NAMES = { shoot: 'Shoot / Block', pass: 'Pass / Steal', turbo: 'Turbo', shove: 'Shove / Spin', oop: 'Alley-oop / Call', taunt: 'Taunt' };\n\n/* ---- tuning: the single home of the important numbers (live dev sliders) ---- */\nconst TUNING = {};\nconst TUNE_DEFS = [\n  // key, label, def, min, max, step, group, help\n  ['runSpeed', 'Run speed', 92, 50, 160, 1, 'MOVEMENT', 'Top speed on foot'],\n  ['accel', 'Acceleration', 900, 300, 2000, 25, 'MOVEMENT', 'How fast players change speed'],\n  ['turboMult', 'Turbo speed', 1.5, 1, 2.4, .05, 'MOVEMENT', 'Speed multiplier while turbo is held'],\n  ['turboDrain', 'Turbo drain /s', .30, 0, 1.5, .05, 'MOVEMENT', 'Turbo used per second while sprinting'],\n  ['turboRefill', 'Turbo refill /s', .20, 0, 1.5, .05, 'MOVEMENT', 'Turbo regained per second'],\n  ['playerGravity', 'Player gravity', 900, 400, 1800, 20, 'MOVEMENT', 'How hard players fall'],\n  ['jumpShotVz', 'Jump power', 250, 150, 420, 5, 'MOVEMENT', 'Takeoff speed of a jump shot or block'],\n  ['ballGravity', 'Ball gravity', 760, 300, 1500, 20, 'BALL', 'How hard the ball falls'],\n  ['ballBounce', 'Floor bounce', .62, .3, .9, .01, 'BALL', 'Floor restitution'],\n  ['rimBounce', 'Rim bounce', .45, .2, .8, .01, 'BALL', 'Rim restitution'],\n  ['shotBase', 'Shot accuracy', 1, .5, 1.4, .02, 'SHOOTING', 'Scales every make chance'],\n  ['contestPenalty', 'Contest penalty', .35, 0, .8, .01, 'SHOOTING', 'Make chance lost to a tight defender'],\n  ['perfectBonus', 'Perfect release', 1.15, 1, 1.5, .01, 'SHOOTING', 'Make chance multiplier on a green release'],\n  ['threeBonus', 'Three-point worth', 3, 2, 5, 1, 'SHOOTING', 'Points for a shot from beyond the arc'],\n  ['dunkRange', 'Dunk range', 72, 30, 140, 1, 'DUNKS', 'Distance a dunk can start from'],\n  ['dunkReject', 'Dunk block chance', .5, 0, 1, .01, 'DUNKS', 'Chance a airborne defender rejects a dunk'],\n  ['stealChance', 'Steal chance', .34, 0, .9, .01, 'DEFENSE', 'Base chance a swipe takes the ball'],\n  ['shoveForce', 'Shove force', 150, 60, 320, 5, 'DEFENSE', 'How far a shove flings a player'],\n  ['knockdownTime', 'Knockdown time', .75, .2, 2, .05, 'DEFENSE', 'Seconds a shoved player stays down'],\n  ['blockChance', 'Block chance', .78, 0, 1, .01, 'DEFENSE', 'Chance a well-timed jump swats the shot'],\n  ['novaStreak', 'Supernova streak', 3, 1, 6, 1, 'FLOW', 'Straight baskets before a team goes SUPERNOVA'],\n  ['shotClock', 'Shot clock', 20, 8, 40, 1, 'FLOW', 'Seconds to get a shot up'],\n  ['powerupEvery', 'Power-up every', 18, 5, 60, 1, 'FLOW', 'Seconds between power-up drops'],\n  ['cpuSkill', 'CPU skill', 1, .4, 1.6, .02, 'CPU', 'How sharp the CPU is (reflexes, shots)'],\n  ['comeback', 'Comeback help', .5, 0, 1, .05, 'CPU', 'How much the trailing side is helped'],\n  ['gameSpeed', 'Game speed', 1, .4, 1.6, .05, 'FLOW', 'Time scale of the whole game']\n];\nfor (const [key, label, def, min, max, step, group, help] of TUNE_DEFS) TUNING[key] = { key, label, v: def, def, min, max, step, group, help };\nconst tune = k => TUNING[k].v;\nconst resetTuning = () => { for (const k in TUNING) TUNING[k].v = TUNING[k].def; };\nconst saveTuning = () => { const o = {}; for (const k in TUNING) o[k] = TUNING[k].v; E.store.set('bb:tuning', o); return o; };\nconst loadTuning = () => { const o = E.store.get('bb:tuning', null); if (o) for (const k in o) if (TUNING[k]) TUNING[k].v = clamp(+o[k] || TUNING[k].def, TUNING[k].min, TUNING[k].max); };\n\n/* ---- the game ---- */\nconst GAME_SETTINGS = [\n  { key: 'glyphs', label: 'Button prompts', options: ['PlayStation', 'Xbox'], value: 'PlayStation' },\n  { key: 'quarter', label: 'Quarter length', options: ['1:00', '1:30', '2:00', '3:00'], value: '1:30' },\n  { key: 'difficulty', label: 'CPU difficulty', options: ['Rookie', 'Pro', 'All-Star', 'Legend'], value: 'Pro' },\n  { key: 'camera', label: 'Camera', options: ['Broadcast', 'High'], value: 'Broadcast' },\n  { key: 'announcer', label: 'Announcers', options: ['On', 'Off'], value: 'On' },\n  { key: 'rumble2', label: 'Controller rumble on slams', options: ['On', 'Off'], value: 'On' }\n];\nconst S = {\n  scene: 'title', mode: 'exhibition', court: 'alley', teams: [0, 1], humans: {}, // slot -> input\n  players: [], ball: null, match: null, rng: E.rng(1), fxRng: E.rng(2), events: [], powerups: [], twist: {}, cheats: { infTurbo: false, big: false, noClock: false, autopilot: false },\n  progress: null, dev: { open: false, tab: 0, row: 0, overlay: false }, camera: { x: COURT.cx, zoom: 1 }, hub: null, lastInput: NOW(), padSeen: false, keySeen: false,\n  fx: { banners: [], shake: 0, flash: 0, slow: 0, slowT: 0, zoomPunch: 0, shatter: 0, cam: 0 }, announcerQueue: []\n};\nconst bus = {};\nconst on = (t, fn) => (bus[t] = bus[t] || []).push(fn);\nconst emit = (type, data = {}) => {\n  data.type = type; data.t = S.match ? S.match.time : 0;\n  S.events.push(data); if (S.events.length > 64) S.events.shift();\n  for (const fn of bus[type] || []) { try { fn(data); } catch (e) { if (game) game.fail('event ' + type, e); } }\n};\nconst dist2 = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\nconst rnd = () => S.rng();\nconst frnd = () => S.fxRng();\nconst pick = (arr, r = frnd) => arr[Math.floor(r() * arr.length) % arr.length];\nconst mmss = s => { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };\nconst hashStr = s => { let h = 2166136261; for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };\nconst QUARTER_LEN = { '1:00': 60, '1:30': 90, '2:00': 120, '3:00': 180 };\nconst DIFF = { 'Rookie': .65, 'Pro': 1, 'All-Star': 1.25, 'Legend': 1.5 };\n"}}}
