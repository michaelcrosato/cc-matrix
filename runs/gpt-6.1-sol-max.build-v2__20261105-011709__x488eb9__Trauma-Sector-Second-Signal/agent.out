{"type":"item.started","item":{"id":"item_141","type":"command_execution","command":"/bin/bash -lc \"node tools/build.mjs && node --input-type=module <<'JS'\nimport fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {chromium} from 'playwright';import {pathToFileURL} from 'node:url';const m=JSON.parse(fs.readFileSync('build-meta.json')),exit=JSON.parse(fs.readFileSync('../exit-interview.json')),about=JSON.parse(fs.readFileSync('src/about-data.json')),html=fs.readFileSync('../'+m.html,'utf8'),session=fs.readFileSync('vendor/hub/session.js','utf8');let count=0;const check=(v,msg)=>{assert(v,msg);count++;};check(JSON.stringify(exit)===JSON.stringify(about),'Interview matches the in-game data source');check(Object.keys(exit).join(',')==='sourceInformation,testingFeedback,engineFeedback,promptFeedback,aiHub','Exact interview shape');check(exit.testingFeedback.length===4&&exit.engineFeedback.length===6&&exit.promptFeedback.length===4,'Feedback answer counts');check(exit.sourceInformation.usage==='added on import','Usage is exact');check(html.includes('<meta charset=\\\"utf-8\\\"><script>'+session+'</script>'),'Unmodified Hub client is the first head script');check(\"'!/<script[''^>]+src=/.test(html),'\"'No external scripts');check(html.includes('Permission is hereby granted'),'Native engine license included');const b=await chromium.launch(),p=await b.newPage({viewport:{width:1280,height:720}});const errs=[];p.on('pageerror',e=>errs.push(String(e)));await p.goto(pathToFileURL(path.resolve('..',m.html)).href);await p.waitForFunction(()=>window.GAME?.game.sceneName==='title');check(await p.title()===m.title,'Final title');const browserAbout=await p.evaluate(()=>GAME.ABOUT);check(JSON.stringify(browserAbout)===JSON.stringify(exit),'Final embedded About equals interview');await p.evaluate(()=>GAME.game.go('about'));await p.waitForTimeout(350);check(await p.evaluate(()=>GAME.game.sceneName==='about'&&GAME.game.errors.length===0)&&errs.length===0,'Final About draws without errors');await b.close();console.log(count+' package checks, 0 failed');\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
