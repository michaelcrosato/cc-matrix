   if (ax) { const [i, s] = push[ax[2].toLowerCase()], q = ax[1] ? this.padAim || [0, 0] : mv; v = Math.max(v, clamp(q[i] * s, 0, 1)); }\n    else if (this.held.has(c)) v = Math.max(v, k && pv > 0 ? pv : 1);\n  }\n  if (push[a]) { const [i, s] = push[a]; v = Math.max(v, clamp(st[i] * s, 0, 1)); }\n  return v;\n};\n/** a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input\n *  is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an\n *  attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it */\nGame.prototype.hook = function (kind, fn) {\n  const L = (this._own || (this._own = { input: [], step: [], enter: [] }))[kind];\n  if (!L) throw new Error('game.hook(\"' + kind + '\"): the hooks are input, step and enter');\n  L.push(fn); return () => { const i = L.indexOf(fn); if (i >= 0) L.splice(i, 1); };\n};\n/** touch: 'never' on a device with touch alone: \"Controller or keyboard required\", with Settings, until a controller\n *  is connected or a key pressed */\nGame.prototype._needSync = function () {\n  const fine = window.matchMedia && matchMedia('(any-pointer: fine)').matches, coarse = window.matchMedia && matchMedia('(pointer: coarse)').matches;\n  const need = coarse && !fine && !this._keyed && this.input.padIndex === null, el = this._needEl;\n  if (!need) { if (el) el.style.display = 'none'; return; }\n  if (!el) {\n    const d = this._needEl = document.createElement('div'); d.setAttribute('data-sys', 'need'); d.setAttribute('role', 'alert');\n    d.style.cssText = 'position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;background:rgba(5,3,12,.88);color:#f4f0ff;font:600 17px/1.45 system-ui,sans-serif';\n    d.innerHTML = '<div><div style=\"font-size:21px;margin-bottom:8px\">Controller or keyboard required</div><div style=\"opacity:.8;margin-bottom:18px\">This game plays with a controller or a keyboard. Connect one, then press any button.</div><button type=\"button\" style=\"font\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"rg -n '\"'^E'\"\\\\.Story|story\\\\.|new E\\\\.Story|Humanoid.hat|Humanoid.pose|Shell\\\\(' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API-INDEX.md' | head -70 && sed -n '1,75p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/modules/story.js'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"rg -n '\"'^E'\"\\\\.Story|story\\\\.|new E\\\\.Story|Humanoid.hat|Humanoid.pose|Shell\\\\(' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API-INDEX.md' | head -70 && sed -n '1,75p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/modules/story.js'\"","aggregated_output":"104:- 1669 Module story: dialogue as data, flags and values, a quest log and emote balloons (engine/modules/story.js); E.Story: story\n676:- `new E.Humanoid(o = {}) → rig`: new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style, color }; E.Humanoid.hat adds one); weapon: 'sword' | 'gun' | 'staff' (E.Humanoid.weapon adds one); hood: true (drawn in colors.hair); draw: { under(g, Q, rig), over(g, Q, rig) } the game's own drawing before and after the body (Q: the joints on screen, [x, y, depth]: outfits, accessories); seed: its own random stream (blinks, its clock)\n677:- `E.Humanoid.hat(id, draw)` †: a hat of the game's own: draw(h) with h.at(forward, right, up) a point round the head on screen, h.r its radius there, h.c its color (o.hat.color), h.dk a darker one, h.g, h.rig\n678:- `E.Humanoid.hats` †: the hats a Humanoid may wear, by id: the built-ins (cap, band, crown, helmet, pointed) and a game's own\n679:- `E.Humanoid.pose(id, fn)` †: a held pose of the game's own: fn(J, w, rig) moves the joints (the rig's frame: forward, right, up) toward the pose by w, 0..1, which eases in and out as state.pose names it or not (blended over the rig's solve)\n680:- `E.Humanoid.poses` †: the held poses of a game's own, by id (the built-in poses are the rig's own solve: state.pose names either)\n693:- `rig.update(dt, s = {})`: s: { x, y, z, vx, vy, facing, dash, hurt, attack, air, point } air: true while jumping or falling (legs tuck), point: true to hold the weapon hand forward (aiming a gun) attack: { spec, phase: 'wind' | 'active' | 'recover', u: 0..1 }. spec.kick = true swings the right foot instead of the hand also aim (radians up), crouch, sprint, climb, hang (hangZ: the top it hangs from, above the feet), flip: 0..1 (a roll), pose: 'cheer' | 'cast' | 'guard' | 'kneel' | 'crouch' | 'wave' | 'hips' | 'down' | 'die' | 'block' or one of E.Humanoid.pose's, tilt (radians: the whole body forward about the feet, a dive) and roll (sideways), stance: 'guard' | 'ready', down: 0..1, vz (with climb: the climbing speed), land: k (a heavy landing), expr: 'smile' | 'shout' | 'angry' | 'wince', run: 0..1 (run in place)\n1186:- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n1187:- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30 at 1,875)\n1188:- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n1189:- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\n1190:- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\n1191:- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\n1669:## Module story: dialogue as data, flags and values, a quest log and emote balloons (engine/modules/story.js)\n1671:- `new E.Story(game, o = {}) → story`: new E.Story(game, { people, nodes, vars, on, dialog }): the talk of a game (the manual above)\n1672:- `story.done(id)`: finish a quest (taken now if it wasn't)\n1673:- `story.draw(r)`: draw the balloons over their targets and the box (anywhere in draw: both go to the overlay)\n1674:- `story.emote(target, kind = '!', seconds = 1.5)`: a balloon over target (x, y, z; h: its height) for seconds: '!', '?', 'heart', 'dots', 'note'\n1675:- `story.get(key)`: a flag or value (key may be a dotted path into vars)\n1676:- `story.quest(id, title = id, text = '')`: take a quest (or change its title and text): it joins the log\n1677:- `story.restore(s)`: put back what state() gave (a load)\n1678:- `story.resume()`: after an event with wait: true, go on (to the choice's goto, or the next step)\n1679:- `story.run(id, o = {})`: start node id (stopping any other); o.onDone(story) when it ends\n1680:- `story.set(key, value = true)`: set a flag (value true) or a value\n1681:- `story.state()`: its vars and quests, as JSON (for a save)\n1682:- `story.stop()`: stop the node running (its box closes; onDone isn't called)\n1683:- `story.test(c)`: does a condition hold? (the manual's conditions)\n1684:- `story.update(dt)`: run the talk and the balloons; true while a node runs (play waits)\n1685:- `story.auto = 0`: seconds a page shows before it turns by itself (0: it waits for the player)\n1686:- `story.game`: its game\n1687:- `story.log = []`: what was said and chosen, oldest first ({ who, name, text }, the last 200: a visual novel's backlog)\n1688:- `story.node = null`: its id\n1689:- `story.nodes`: the conversations by id (lists of steps)\n1690:- `story.on`: the game's event handlers by name\n1691:- `story.people`: who speaks, by id ({ name, portrait, at })\n1692:- `story.quests = []`: the quest log, in the order taken ({ id, title, text, done })\n1693:- `story.running = false`: a node runs\n1694:- `story.skip = false`: pages type at once and turn at once (choices still wait)\n1695:- `story.talk`: the E.Dialog it speaks through\n1696:- `story.vars`: every flag and value (a line's {$name} reads them)\n/*!\nmy-3D2dge module STORY v0.89.1: dialogue as data, flags and values, a quest log and emote balloons\nhttps://github.com/michaelcrosato/my-3d2dge (MIT License)\nLoads after: the full engine or the agent edition. Needs: no other module.\n\nA JRPG's or an adventure's talk (Dragon Quest, Chrono Trigger, Zelda): conversations written as data and run through an\nE.Dialog (its markup and portraits), remembering what was said and done.\n- const story = new E.Story(game, { people: { elder: { name: 'ELDER', portrait: rig, at: npc } }, nodes, vars, on:\n  { gift(story, step) {...} }, dialog }). people: who speaks (portrait, full engine: a Humanoid or a function (g, x, y, size); at:\n  anything with x, y, z, and h its height, a balloon floats over); dialog: the E.Dialog it talks through (else its own:\n  story.talk); on: the game's handlers for events.\n- nodes: { id: [step, ...] }: the steps run in order, and a step with if runs only when its condition holds.\n  - { who, say: 'text' | [pages], choices: [{ text, if, goto, ...actions }] }: a line in the box (markup, {$name}\n    from vars); a choice's actions run when it is picked, then its goto, else the next step.\n  - { goto: 'id' } jumps; { end: true } stops; { wait: seconds } pauses.\n  - actions, on any step or choice: set: 'flag' | { key: value }; add: { gold: -50 }; quest: [id, title, text]; done:\n    id; emote: '!' | '?' | 'heart' | 'dots' | 'note' (over who's at); event: 'name' (calls on[name](story, step), after\n    the line on a step that speaks; with wait: true the story holds until story.resume(): the game's scene, a shop).\n  - conditions: 'flag' (set and truthy), '!flag', 'gold >= 50' (== != < <= > >=, a number or a word), 'quest:id'\n    (taken), 'done:id' (finished), an array (all of them), or a function (story) => true or false.\n- story.run(id, { onDone }) starts a node (stopping any other). In update: if (story.update(dt)) return; (true while it\n  runs: play waits); in draw: story.draw(r) (the box and the balloons). story.running; story.node: the node's id.\n- story.vars: every flag and value ({$name} in a line reads them); story.set(key, value = true), get(key) (a dotted\n  path), test(condition).\n- Quests: story.quest(id, title, text), story.done(id); story.quests: [{ id, title, text, done }] in the order taken.\n- story.emote(target, kind, seconds = 1.5): a balloon over anything with x, y, z (h: its height).\n- A visual novel: story.log (what was said and chosen: { who, name, text }, for a backlog), story.auto (seconds a page\n  stays before it turns), story.skip (pages type and turn at once; choices wait).\n- story.state() and story.restore(state): its vars and quests as JSON, for a save (game.saves' data, full engine).\n\n```js story\nconst E = My3D2dge, game = new E.Game({ headless: true });\nconst story = new E.Story(game, { vars: { gold: 30, hero: 'ROWAN' }, nodes: {\n  elder: [{ if: 'helping', goto: 'thanks' }, { who: 'elder', say: 'Will you help us, {$hero}?', choices: [\n    { text: 'Yes', set: 'helping', quest: ['cave', 'The cave', 'Clear the cave north of town'] }, { text: 'No', goto: 'bye' }] },\n    { add: { gold: 20 } }],\n  thanks: [{ say: 'Thank you!' }, { if: 'gold >= 50', done: 'cave' }],\n  bye: [{ say: 'Farewell.' }] } });\ngame.start({ update(dt) { story.update(dt); }, draw(r) { story.draw(r); } });\nconst press = n => { for (let i = 0; i < n; i++) { game.input.tap('confirm'); game.advance(.5); } };\nstory.run('elder'); press(2);   // the line types out, then the first choice: Yes\nif (!story.get('helping') || story.get('gold') !== 50 || story.quests[0].id !== 'cave' || story.running) throw new Error('the quest taken');\nstory.run('elder'); press(2);\nif (!story.quests[0].done || !story.test('done:cave')) throw new Error('the quest done');\n```\nRules: keep the nodes as data (a game's script is an event); put story.state() in the game's save and restore it on a\nload; one story per game, its talk the only box on screen.\n*/\n(function (E) {\n'use strict';\nif (!E) throw new Error('my-3D2dge module STORY: load engine/my-3d2dge.js (or the agent edition) first');\n\n/* =============================================================================\n * STORY  conversations as data run through a Dialog, flags and values, quests, emote balloons\n * ========================================================================== */\nconst { px } = E;\nconst HEART = E.sprite(['.R.R.', 'RRRRR', 'RRRRR', '.RRR.', '..R..'], { R: '#e8384a' });\nclass Story {\n  /** new E.Story(game, { people, nodes, vars, on, dialog }): the talk of a game (the manual above) */\n  constructor(game, o = {}) {\n    /** game: its game; people: who speaks, by id ({ name, portrait, at }); nodes: the conversations by id (lists of\n     *  steps); on: the game's event handlers by name */\n    this.game = game; this.people = o.people || {}; this.nodes = o.nodes || {}; this.on = Object.assign({}, o.on);\n    /** vars: every flag and value (a line's {$name} reads them) */\n    this.vars = Object.assign({}, o.vars);\n    /** talk: the E.Dialog it speaks through */\n    this.talk = o.dialog || new E.Dialog(game); this.talk.vars = this.vars;\n    /** quests: the quest log, in the order taken ({ id, title, text, done }) */\n    this.quests = [];\n    /** log: what was said and chosen, oldest first ({ who, name, text }, the last 200: a visual novel's backlog) */\n    this.log = [];\n    /** auto: seconds a page shows before it turns by itself (0: it waits for the player); skip: pages type at once and\n     *  turn at once (choices still wait) */\n    this.auto = 0; this.skip = false;\n    /** running: a node runs; node: its id */\n","exit_code":0,"status":"completed"}}
