{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport fs from 'node:fs';import vm from 'node:vm';const ctx={console,performance,structuredClone,setTimeout,clearTimeout};ctx.window=ctx;vm.createContext(ctx);for(const file of ['vendor/my-3d2dge/dist/handoff/my-3d2dge.js',...JSON.parse(fs.readFileSync('src/manifest.json')).map(f=>'src/'+f)])vm.runInContext(fs.readFileSync(file,'utf8'),ctx,{filename:file});const g=ctx.GAME.game;g.fadeTime=0;g.advance(.1);console.log(g.debug.snapshot());for(const scene of ['menu','difficulty','story','chart','op','ward','casefiles','lobby','about','cinematic','attract']){g.go(scene);g.advance(.2,{draw:true});console.log(scene,g.errors.map(e=>e.message||e));}g.dispose();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
