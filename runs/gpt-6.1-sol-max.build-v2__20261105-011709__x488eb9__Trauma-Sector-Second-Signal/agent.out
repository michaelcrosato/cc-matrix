ovement, attacks and state, then projects through any view.\n *    Attack specs (angles relative to facing, + = toward the right hand):\n *      { a0, a1, z0, z1, reach, blade, spin }   e.g. horizontal slash a0: 1.7 -> a1: -1.9\n *    Drive with rig.update(dt, { x, y, z, vx, vy, facing, dash, hurt, attack:{ spec, phase, u } })\n *    where phase is 'wind' | 'active' | 'recover' and u is 0..1 progress in that phase.\n * ============================================================================= */\nconst HUMAN_COLORS = {\n  skin: '#f1c7a0', hair: '#3b2a2f', cloth: '#2f8f86', pants: '#3b3552', boot: '#6a4128', belt: '#e0a84a',\n  cape: '#c8452f', capeIn: '#7a2622', metal: '#dce8f1', metalDk: '#7f93ab', hilt: '#e8b04e', eye: '#1a1320'\n};\nconst JOINT_KEYS = ['hipL', 'hipR', 'kneeL', 'kneeR', 'footL', 'footR', 'hipC', 'shC', 'shL', 'shR', 'head', 'elbowL', 'elbowR', 'handL', 'handR'];\n/** body proportions: 'chibi' (default, big head, Secret of Mana), 'heroic' (tall, Symphony of the Night), 'bulky' (brawlers, bosses) */\nconst BUILDS = {\n  chibi: {},\nclass Menu {\n  constructor(game, items, o = {}) {\n    /** game: its game; items: the entries (strings, or { label, disabled }); i: the one under the cursor; active:\n     *  false stops it reading input */\n    this.game = game; this.items = items || []; this.i = 0; this.active = true;\n    /** x, y: where it sits, 'center' or pixels; title: a heading, or null; box: draw a window round it; color: the\n     *  entries' color; pick: the color of the one under the cursor; dim: disabled entries' color; bg, border: the\n     *  window's colors; onPick: called (i, item) on confirm; onCancel: called on cancel; onMove: called (i, item)\n     *  when the cursor moves; sound: false silences it; input: the one input it reads (default: every player's, so\n     *  any player moves and picks; the mouse and taps are player 1's); scale: its text and rows that many times (2, 3:\n     *  across a room on a TV); rows: at most that many entries shown, the list scrolling under its cursor (0: all) */\n    Object.assign(this, { x: 'center', y: 'center', title: null, box: true, color: '#ffffff', pick: '#ffd36a', dim: '#6a6488', bg: '#141a3a', border: '#e8e4ff', onPick: null, onCancel: null, onMove: null, sound: true, input: null, scale: 1, rows: 0 }, o);\n    this._skip(1);\n  }\n  _label(it) { return typeof it === 'string' ? it : it.label; }\n  _off(it) { return typeof it === 'object' && it.disabled; }\n  _skip(dir) { for (let k = 0; k < this.items.length && this._off(this.items[this.i]); k++) this.i = (this.i + dir + this.items.length) % this.items.length; }\n  /** the entry under the cursor */\n  get selected() { return this.items[this.i]; }\n  // where it sits, from its items and the screen's size (update and draw both: a click picks an entry with no draw yet)\n  _layout() {\n    const S = this.game.screen, k = Math.max(1, Math.round(this.scale || 1)), fo = { scale: k }, labels = this.items.map(it => this._label(it)), n = labels.length;\n    const w = Math.max(E.font.width(this.title || '', fo), ...labels.map(l => E.font.width(l, fo))) + 22 * k, rowH = E.font.lineHeight(fo) + 2 * k, vis = this.rows > 0 ? Math.min(n, this.rows) : n;\n    let first = clamp(this._first || 0, 0, Math.max(0, n - vis)); if (this.i < first) first = this.i; else if (this.i >= first + vis) first = this.i - vis + 1; this._first = first;   // (the cursor's row in view)\n    const h = vis * rowH + (this.title ? rowH + 3 * k : 0) + 8 * k, x = this.x === 'center' ? Math.round((S.W - w) / 2) : this.x, y = this.y === 'center' ? Math.round((S.H - h) / 2) : this.y;\n    const top = y + 5 * k + (this.title ? rowH + 3 * k : 0); this._box = { x: x + 3 * k, y: top - 2 * k, w: w - 6 * k, rowH, first, vis };   // (where the entries are, for a click or tap)\n    return { labels, w, h, x, y, top, rowH, k, fo, first, vis };\n  }\n  /** entry i's box on the screen, [x, y, w, h] in screen pixels: where a click or tap picks it (a test's feed('down') and\n   *  feed('up') there); null while it is scrolled out of view */\n  rowAt(i) { this._layout(); const b = this._box; return i < b.first || i >= b.first + b.vis ? null : [b.x, b.y + (i - b.first) * b.rowH, b.w, b.rowH]; }\n  /** move the cursor (up, down; held keys repeat; the mouse over an entry) and pick (confirm, or a click or tap on an\n   *  entry) or cancel; returns true when it picked or cancelled */\n  update() {\n    if (!this.active || !this.items.length) return false;\n    this._layout();\n    const P = this.input ? [this.input] : this.game._players || [this.game.input], inp = P[0], any = f => P.some(f), n = this.items.length, old = this.i, b = this._box;\n    const row = p => { if (!b || !p || p[0] < b.x || p[0] >= b.x + b.w) return -1; const r = Math.floor((p[1] - b.y) / b.rowH), k = b.first + r; return r >= 0 && r < b.vis && k < n && !this._off(this.items[k]) ? k : -1; };\n    if (any(I => I.repeat('up'))) { this.i = (this.i + n - 1) % n; this._skip(-1); }\n    if (any(I => I.repeat('down'))) { this.i = (this.i + 1) % n; this._skip(1); }\n    if (inp.mouse.t !== this._mt) { this._mt = inp.mouse.t; const k = row(inp.pointer()); if (k >= 0) this.i = k; }   // the mouse moved over an entry\n    const tap = row(inp.clicked());   // a click or tap on an entry picks it\n    if (tap >= 0) this.i = tap;\n    if (this.i !== old) { if (this.sound) this.game.audio.sfx('select'); if (this.onMove) this.onMove(this.i, this.items[this.i]); }\n    if ((any(I => I.pressed('confirm')) || tap >= 0) && !this._off(this.items[this.i])) { if (this.sound) this.game.audio.sfx('confirm'); P.forEach(I => I.consumeAll()); if (this.onPick) this.onPick(this.i, this.items[this.i]); return true; }\n    if (any(I => I.pressed('cancel')) && this.onCancel) { if (this.sound) this.game.audio.sfx('cancel'); P.forEach(I => I.consumeAll()); this.onCancel(); return true; }\n    return false;\n  }\n  /** draw it to the overlay */\n  draw(r) {\n    r.overlay(g => {\n      const { labels, w, h, x, y, top: yy, rowH, k: K, first, vis } = this._layout(), T = { outline: false, shadow: '#05040a', scale: K };\n      if (this.box) E.ui.box(g, x, y, w, h, { bg: this.bg, border: this.border });\n      if (this.title) E.font.text(g, this.title, x + w / 2, y + 5 * K, this.pick, { align: 'center', outline: false, shadow: '#05040a', scale: K });\n      const blink = Math.floor(this.game.real * 3) % 2 === 0;\n      labels.slice(first, first + vis).forEach((l, r) => {\n        const k = first + r, sel = k === this.i && this.active, off = this._off(this.items[k]);\n        if (sel) px.rect(g, x + 3 * K, yy + r * rowH - 2 * K, w - 6 * K, rowH, shade(Array.isArray(this.bg) ? this.bg[0] : this.bg, .22));\n        E.font.text(g, l, x + 14 * K, yy + r * rowH, off ? this.dim : sel ? this.pick : this.color, T);\n        if (sel && blink) E.font.text(g, '▸', x + 6 * K, yy + r * rowH, this.pick, { scale: K, outline: false });\n      });\n      if (first > 0) E.font.text(g, '▲', x + w - 9 * K, yy, this.dim, T);   // (more above and below)\n      if (first + vis < labels.length) E.font.text(g, '▼', x + w - 9 * K, yy + (vis - 1) * rowH, this.dim, T);\n    });\n  }\n}\nE.Menu = Menu;\n\n/* =============================================================================\n * 21d. SHELL  an HTML interface over the game, built from data: the screens (title, pause, settings, help, results, map)\nnode:fs:483\n    return binding.readFileUtf8(path, stringToFlags(options.flag));\n                   ^\n\nError: ENOENT: no such file or directory, open '/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-011709__x488eb9/work/Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/kenney-furniture'\n    at readFileSync (node:fs:483:20)\n    at readSet (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-011709__x488eb9/work/Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-m