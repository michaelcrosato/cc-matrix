& this.choices && !this.typing;\n    if (this.auto && !this.choices && !this.typing && (this._wait += dt) >= this.auto) {   // pages turn and the box closes by itself\n      this._wait = 0;\n      if (last) { this.open = false; if (this.onDone) this.onDone(); } else { this.i++; this.shown = 0; this._held = -1; }\n      return this.modal && this.open;\n    }\n    if (!this.modal) return false;\n    const c = inp.clicked(), d = (c || asking) && this._dims(), tapped = !!c && c[0] >= d.x && c[0] < d.x + d.w && c[1] >= d.y && c[1] < d.y + d.h;   // a tap on the box, as confirm\n    let chose = false;\n    if (asking) {\n      if (inp.repeat('up') || inp.repeat('left')) { this.choice = (this.choice + this.choices.length - 1) % this.choices.length; this.game.audio.sfx('select'); }\n      if (inp.repeat('down') || inp.repeat('right')) { this.choice = (this.choice + 1) % this.choices.length; this.game.audio.sfx('select'); }\n      // a tap or click on a choice picks it; the mouse moved over one moves the cursor there\n      const b = this._cbox(d), row = q => q && q[0] >= b.x && q[0] < b.x + b.w && q[1] >= b.y && q[1] < b.y + b.h ? clamp(Math.floor((q[1] - b.y - 3) / d.lh), 0, this.choices.length - 1) : -1;\n      const p = inp.lastDevice === 'mouse' && inp.pointer(), hv = p && (!this._hp || p[0] !== this._hp[0] || p[1] !== this._hp[1]) ? row(p) : -1; this._hp = p ? p.slice() : null;\n      if (hv >= 0 && hv !== this.choice) { this.choice = hv; this.game.audio.sfx('select'); }\n      const tc = row(c); if (tc >= 0) { this.choice = tc; chose = true; }\n    }\n    if (inp.pressed('confirm') || tapped || chose) {\n      if (this.typing) { this.shown = len; this._hold = 0; }\n      else if (!last) { this.i++; this.shown = 0; this._held = -1; }\n      else { this.close(); this.game.audio.sfx('confirm'); if (this.choices && this.onChoice) this.onChoice(this.choice, this.choices[this.choice]); if (this.onDone) this.onDone(); }\n    } else if (asking && inp.pressed('cancel')) { this.choice = this.choices.length - 1; }\n    return true;\n  }\n  /** draw it (anywhere in draw: it goes to the overlay) */\n  draw(r) {\n    if (!this.open) return;\n    r.overlay(g => {\n      const d = this._dims(), ui = E.ui;\n      ui.box(g, d.x, d.y, d.w, d.h, { bg: this.bg, border: this.border, alpha: this._alpha });\n      if (this.portrait) {\n        const px0 = d.x + 5, py0 = d.y + Math.round((d.h - d.P) / 2);\n        if (typeof this.portrait === 'function') this.portrait(g, px0, py0, d.P);\n        else { this.portrait._talk = this.typing; this.portrait.drawPortrait(g, px0, py0, d.P, Object.assign({ bg: shade(Array.isArray(this.bg) ? this.bg[0] : this.bg, .12), border: this.border, shadow: false }, this._pOpts)); this.portrait._talk = false; }   // the mouth moves while the text types\n      }\n      if (this.name) { const nw = E.font.width(this.name) + 12, nx = d.x + (this.portrait ? d.tx - 6 : 4); ui.box(g, nx, d.y - 12, nw, 14, { bg: this.bg, border: this.border }); E.font.text(g, this.name, nx + 6, d.y - 9, this.nameColor, { outline: false, shadow: '#05040a' }); }\n      let left = Math.floor(this.shown);\n      const mk = this._fx && this._fx[this.i], o = { outline: false, shadow: '#05040a' };\n      if (!mk) this._page.forEach((line, k) => { const s = line.slice(0, Math.max(0, left)); left -= line.length; if (s) E.font.text(g, s, d.x + d.tx, d.y + 5 + k * d.lh, this.color, o); });\n      else {   // markup: runs of one look drawn together, trembling and bobbing letters one by one\n        let n0 = 0; const t = this.game.real;\n        this._page.forEach((line, k) => {\n          const shown = Math.min(line.length, Math.max(0, left)), y = d.y + 5 + k * d.lh; left -= line.length;\n          for (let j = 0; j < shown;) {\n            const f = mk.fx[n0 + j] || {}, one = f.shake || f.wave; let e = j + 1;\n            if (!one) while (e < shown && mk.fx[n0 + e] === f) e++;\n            const n = n0 + j, x = d.x + d.tx + (j ? E.font.width(line.slice(0, j))